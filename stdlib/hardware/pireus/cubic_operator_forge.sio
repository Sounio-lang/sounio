fn cof_digest_lineage(
    lineage: &PireusCubicForgeLineage,
) -> PireusCubicForgeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = cof_digest_add_words(state, &lineage.parent_source_sha256)
    state = cof_digest_add_words(state, &lineage.parent_semantics_sha256)
    state = cof_digest_add_words(state, &lineage.parent_freeze_sha256)
    state = cof_digest_add_words(state, &lineage.parent_transcript_sha256)
    state = cof_digest_add_words(state, &lineage.parent_parity_receipt_sha256)
    state = cof_digest_add_bool(state, lineage.parent_live_match)
    state = cof_digest_add_bool(state, lineage.parent_digest_match)
    state = cof_digest_add_bool(state, lineage.parent_scope_match)
    state = cof_digest_add_bool(state, lineage.complete)
    cof_digest_finish(state)
}

fn cof_digest_grammar(
    population: &PireusCubicMutationPopulation,
) -> PireusCubicForgeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = cof_digest_add_i64(state, PIREUS_CUBIC_FORGE_SCHEMA)
    state = cof_digest_add_i64(state, population.mutation_count)
    var mutation: i64 = 0
    while mutation < population.mutation_count {
        state = cof_digest_add_i64(state, population.kinds[mutation])
        state = cof_digest_add_i64(state, population.r_coordinates[mutation])
        state = cof_digest_add_i64(state, population.s_coordinates[mutation])
        state = cof_digest_add_i64(state, population.t_coordinates[mutation])
        state = cof_digest_add_i64(state, population.support_counts[mutation])
        state = cof_digest_add_i64(state, population.witness_i[mutation])
        state = cof_digest_add_i64(state, population.witness_j[mutation])
        state = cof_digest_add_i64(state, population.witness_k[mutation])
        state = cof_digest_add_i64(state, population.witness_values[mutation])
        mutation = mutation + 1
    }
    state = cof_digest_add_i64(state, population.descriptor_checks)
    state = cof_digest_add_i64(state, population.descriptor_failures)
    state = cof_digest_add_i64(state, population.support_checks)
    state = cof_digest_add_i64(state, population.support_failures)
    state = cof_digest_add_i64(state, population.witness_checks)
    state = cof_digest_add_i64(state, population.witness_failures)
    state = cof_digest_add_i64(state, population.bilinear_witness_checks)
    state = cof_digest_add_i64(state, population.bilinear_witness_failures)
    state = cof_digest_add_i64(state, population.pairwise_checks)
    state = cof_digest_add_i64(state, population.pairwise_failures)
    cof_digest_finish(state)
}

fn cof_digest_population(
    population: &PireusCubicMutationPopulation,
) -> PireusCubicForgeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    let parent_semantics = cof_parent_semantics_hash()
    state = cof_digest_add_words(state, &parent_semantics)
    var mutation: i64 = 0
    while mutation < population.mutation_count {
        var word: i64 = 0
        while word < 8 {
            state = cof_digest_add_i64(
                state, population.child_digest_words[mutation * 8 + word])
            state = cof_digest_add_i64(
                state,
                population.child_lineage_digest_words[mutation * 8 + word])
            word = word + 1
        }
        mutation = mutation + 1
    }
    state = cof_digest_add_i64(state, population.group_total)
    state = cof_digest_add_i64(
        state, population.unresolved_obligation_total)
    state = cof_digest_add_i64(state, population.selected_child)
    state = cof_digest_add_bool(state, population.ranking_present)
    state = cof_digest_add_bool(state, population.complete)
    cof_digest_finish(state)
}

fn cof_digest_receipt(
    receipt: &PireusCubicForgeReceipt,
) -> PireusCubicForgeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = cof_digest_add_i64(state, receipt.schema)
    state = cof_digest_add_i64(state, receipt.producer_language)
    state = cof_digest_add_i64(state, receipt.producer_role)
    state = cof_digest_add_i64(state, receipt.stage)
    state = cof_digest_add_bool(state, receipt.parent_lineage_bound)
    state = cof_digest_add_bool(state, receipt.mixed_cubic_population_complete)
    state = cof_digest_add_bool(state, receipt.noncocycle_witness_complete)
    state = cof_digest_add_bool(
        state, receipt.relative_bilinear_grammar_novelty)
    state = cof_digest_add_bool(state, receipt.executable_child_genomes)
    state = cof_digest_add_bool(state, receipt.immutable_lineage)
    state = cof_digest_add_bool(state, receipt.no_child_selected)
    state = cof_digest_add_bool(state, receipt.target_envelopes_unresolved)
    state = cof_digest_add_bool(state, receipt.declared_coordinate_scope)
    state = cof_digest_add_bool(
        state, receipt.structural_counts_are_child_diagnostics)
    state = cof_digest_add_bool(state, receipt.fixture_is_smoke_only)
    state = cof_digest_add_bool(
        state, receipt.declared_gl4_gauge_inequivalence)
    state = cof_digest_add_bool(state, receipt.relative_algebraic_novelty)
    state = cof_digest_add_bool(state, receipt.algebra_isomorphism_complete)
    state = cof_digest_add_bool(state, receipt.algorithmic_novelty)
    state = cof_digest_add_bool(state, receipt.material_novelty)
    state = cof_digest_add_bool(state, receipt.scientific_novelty)
    state = cof_digest_add_bool(state, receipt.global_novelty)
    state = cof_digest_add_bool(state, receipt.historical_novelty)
    state = cof_digest_add_bool(state, receipt.priority_claim)
    state = cof_digest_add_bool(state, receipt.external_prior_art_complete)
    state = cof_digest_add_bool(state, receipt.semantics_frozen)
    state = cof_digest_add_bool(state, receipt.formal_parity_open)
    state = cof_digest_add_bool(state, receipt.effect_parity_open)
    state = cof_digest_add_bool(state, receipt.material_parity_open)
    state = cof_digest_add_bool(state, receipt.target_lowering_admitted)
    state = cof_digest_add_bool(state, receipt.target_cost_admitted)
    state = cof_digest_add_bool(state, receipt.target_performance_admitted)
    state = cof_digest_add_bool(state, receipt.claim_ready)
    cof_digest_finish(state)
}

fn cof_digest_forge(
    lineage: &PireusCubicForgeDigest,
    grammar: &PireusCubicForgeDigest,
    population: &PireusCubicForgeDigest,
    receipt: &PireusCubicForgeDigest,
) -> PireusCubicForgeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = cof_digest_add_digest(state, lineage)
    state = cof_digest_add_digest(state, grammar)
    state = cof_digest_add_digest(state, population)
    state = cof_digest_add_digest(state, receipt)
    cof_digest_finish(state)
}

pub fn pireus_cubic_operator_forge_evaluate(
    request: &PireusCubicForgeRequest,
) -> PireusCubicForgeResult with Mut, Panic, Div, Epistemic {
    let error = cof_request_error(request)
    let parent_request = pireus_operator_genome_request()
    let parent = pireus_operator_genome_evaluate(&parent_request)
    let lineage = cof_build_lineage(&parent, request)
    let population = cof_build_population(&parent)
    let receipt = cof_build_receipt(&lineage, &population)
    let negatives = cof_exercise_negatives()
    let lineage_digest = cof_digest_lineage(&lineage)
    let grammar_digest = cof_digest_grammar(&population)
    let population_digest = cof_digest_population(&population)
    let receipt_digest = cof_digest_receipt(&receipt)
    let forge_digest = cof_digest_forge(
        &lineage_digest, &grammar_digest, &population_digest, &receipt_digest)

    var failures: i64 = 0
    if error != PIREUS_CUBIC_FORGE_OK { failures = failures + 1 }
    if !lineage.complete || !population.complete {
        failures = failures + 1
    }
    if negatives.passed != negatives.total { failures = failures + 1 }
    if !receipt.parent_lineage_bound ||
        !receipt.mixed_cubic_population_complete ||
        !receipt.noncocycle_witness_complete ||
        !receipt.relative_bilinear_grammar_novelty ||
        !receipt.executable_child_genomes || !receipt.immutable_lineage ||
        !receipt.no_child_selected || !receipt.target_envelopes_unresolved ||
        !receipt.declared_coordinate_scope ||
        !receipt.structural_counts_are_child_diagnostics ||
        !receipt.fixture_is_smoke_only ||
        receipt.declared_gl4_gauge_inequivalence ||
        receipt.relative_algebraic_novelty ||
        receipt.algebra_isomorphism_complete ||
        receipt.algorithmic_novelty || receipt.material_novelty ||
        receipt.scientific_novelty || receipt.global_novelty ||
        receipt.historical_novelty || receipt.priority_claim ||
        receipt.external_prior_art_complete || receipt.semantics_frozen ||
        receipt.formal_parity_open || receipt.effect_parity_open ||
        receipt.material_parity_open || receipt.target_lowering_admitted ||
        receipt.target_cost_admitted ||
        receipt.target_performance_admitted || receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_cubic_forge_digest_nonzero(&lineage_digest) ||
        !pireus_cubic_forge_digest_nonzero(&grammar_digest) ||
        !pireus_cubic_forge_digest_nonzero(&population_digest) ||
        !pireus_cubic_forge_digest_nonzero(&receipt_digest) ||
        !pireus_cubic_forge_digest_nonzero(&forge_digest) {
        failures = failures + 1
    }

    PireusCubicForgeResult {
        valid: failures == 0,
        error: error,
        lineage: lineage,
        population: population,
        receipt: receipt,
        negatives: negatives,
        lineage_digest: lineage_digest,
        grammar_digest: grammar_digest,
        population_digest: population_digest,
        receipt_digest: receipt_digest,
        forge_digest: forge_digest,
        failures: failures,
    }
}

fn cof_digest_matches_frozen(
    digest: &PireusCubicForgeDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    cof_words_equal(&digest.words, expected)
}

/// Exact v4 population admitted only after matcher-free commit 35e33f2b43 and
/// first Sounio authority transcript commit 04a6672356 existed.
pub fn pireus_cubic_operator_forge_frozen_mismatch_code(
    result: &PireusCubicForgeResult,
) -> i64 with Mut, Panic, Div, Epistemic {
    if !result.valid || result.error != PIREUS_CUBIC_FORGE_OK ||
        result.failures != 0 { return 1 }

    let parent_source = cof_parent_source_hash()
    let parent_semantics = cof_parent_semantics_hash()
    let parent_freeze = cof_parent_freeze_hash()
    let parent_transcript = cof_parent_transcript_hash()
    let parent_parity = cof_parent_parity_receipt_hash()
    if !result.lineage.complete || !result.lineage.parent_live_match ||
        !result.lineage.parent_digest_match ||
        !result.lineage.parent_scope_match ||
        !cof_words_equal(
            &result.lineage.parent_source_sha256, &parent_source) ||
        !cof_words_equal(
            &result.lineage.parent_semantics_sha256, &parent_semantics) ||
        !cof_words_equal(
            &result.lineage.parent_freeze_sha256, &parent_freeze) ||
        !cof_words_equal(
            &result.lineage.parent_transcript_sha256, &parent_transcript) ||
        !cof_words_equal(
            &result.lineage.parent_parity_receipt_sha256, &parent_parity) {
        return 2
    }

    let population = &result.population
    if !population.complete ||
        population.mutation_count != PIREUS_CUBIC_FORGE_MUTATION_COUNT ||
        population.descriptor_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT ||
        population.descriptor_failures != 0 ||
        population.support_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT ||
        population.support_failures != 0 ||
        population.witness_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT ||
        population.witness_failures != 0 ||
        population.bilinear_witness_checks !=
            PIREUS_CUBIC_FORGE_MUTATION_COUNT *
                PIREUS_CUBIC_FORGE_BILINEAR_COUNT ||
        population.bilinear_witness_failures != 0 ||
        population.pairwise_checks != PIREUS_CUBIC_FORGE_PAIR_COUNT ||
        population.pairwise_failures != 0 ||
        population.sign_range_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT ||
        population.sign_range_failures != 0 ||
        population.parent_delta_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT ||
        population.parent_delta_failures != 0 ||
        population.semantic_cell_checks !=
            PIREUS_CUBIC_FORGE_MUTATION_COUNT *
                PIREUS_CUBIC_FORGE_CELL_COUNT ||
        population.semantic_cell_failures != 0 ||
        population.fixture_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_DIMENSION ||
        population.fixture_failures != 0 ||
        population.group_total != PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_GROUP_COUNT ||
        population.unresolved_obligation_total !=
            PIREUS_CUBIC_FORGE_MUTATION_COUNT *
                PIREUS_CUBIC_FORGE_TARGET_COUNT *
                PIREUS_CUBIC_FORGE_OBLIGATION_COUNT ||
        population.target_observations != 0 ||
        population.target_discharges != 0 ||
        population.material_receipts != 0 ||
        population.target_lowerings != 0 ||
        population.target_cost_records != 0 ||
        population.target_performance_records != 0 ||
        population.selected_child != -1 || population.ranking_present {
        return 3
    }

    // Full-child diagnostics admitted from the first transcript. They are
    // execution goldens, not mutation-only invariants or novelty ranks.
    let negative_counts: [i64; 48] = [
        96, 96, 96, 92, 96, 96, 96, 92,
        100, 100, 100, 104, 88, 96, 96, 88,
        100, 104, 108, 104, 100, 108, 104, 104,
        96, 96, 96, 100, 96, 96, 96, 100,
        96, 104, 104, 104, 100, 96, 96, 104,
        104, 104, 104, 104, 108, 108, 112, 112
    ]
    let square_negative_counts: [i64; 48] = [
        5, 5, 5, 3, 5, 5, 5, 3,
        3, 3, 3, 3, 5, 7, 7, 5,
        3, 5, 5, 5, 3, 5, 5, 5,
        5, 5, 3, 5, 3, 3, 5, 5,
        3, 7, 5, 5, 5, 5, 3, 7,
        5, 5, 3, 3, 3, 5, 5, 5
    ]
    let commutator_defects: [i64; 48] = [
        90, 90, 90, 90, 90, 90, 90, 90,
        98, 90, 90, 98, 90, 98, 98, 90,
        90, 90, 90, 90, 90, 90, 90, 90,
        90, 90, 98, 90, 90, 90, 90, 90,
        90, 98, 90, 90, 90, 90, 90, 98,
        90, 90, 90, 90, 98, 90, 90, 90
    ]
    let associator_defects: [i64; 48] = [
        1848, 1848, 1848, 1752, 1848, 1848, 1848, 1752,
        1752, 1704, 1704, 1656, 1848, 1848, 1848, 1752,
        1704, 1752, 1704, 1656, 1704, 1704, 1752, 1656,
        1848, 1848, 1752, 1848, 1704, 1704, 1848, 1848,
        1704, 1848, 1752, 1704, 1848, 1848, 1704, 1848,
        1704, 1752, 1752, 1752, 1656, 1752, 1656, 1656
    ]

    let parent_request = pireus_operator_genome_request()
    let parent = pireus_operator_genome_evaluate(&parent_request)
    if !pireus_operator_genome_matches_frozen_semantics(&parent) { return 4 }

    var mutation: i64 = 0
    while mutation < PIREUS_CUBIC_FORGE_MUTATION_COUNT {
        let descriptor = cof_descriptor(mutation)
        if !descriptor.valid ||
            population.kinds[mutation] != descriptor.kind ||
            population.r_coordinates[mutation] != descriptor.r ||
            population.s_coordinates[mutation] != descriptor.s ||
            population.t_coordinates[mutation] != descriptor.t ||
            population.support_counts[mutation] !=
                PIREUS_CUBIC_FORGE_EXPECTED_SUPPORT ||
            population.witness_i[mutation] != (1 << descriptor.r) ||
            population.witness_j[mutation] != (1 << descriptor.s) ||
            population.witness_k[mutation] != (1 << descriptor.t) ||
            population.witness_values[mutation] != 1 ||
            population.negative_counts[mutation] !=
                negative_counts[mutation] ||
            population.square_negative_counts[mutation] !=
                square_negative_counts[mutation] ||
            population.commutator_defects[mutation] !=
                commutator_defects[mutation] ||
            population.associator_defects[mutation] !=
                associator_defects[mutation] ||
            population.group_counts[mutation] !=
                PIREUS_CUBIC_FORGE_GROUP_COUNT ||
            population.unresolved_obligations[mutation] !=
                PIREUS_CUBIC_FORGE_TARGET_COUNT *
                    PIREUS_CUBIC_FORGE_OBLIGATION_COUNT {
            return 5
        }

        var left: i64 = 0
        while left < PIREUS_CUBIC_FORGE_DIMENSION {
            var right: i64 = 0
            while right < PIREUS_CUBIC_FORGE_DIMENSION {
                let cell = left * PIREUS_CUBIC_FORGE_DIMENSION + right
                let flat = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT + cell
                let expected = parent.genotype.sign_bits[cell] ^
                    cof_mutation_bit(&descriptor, left, right)
                if population.sign_bits[flat] != expected { return 6 }
                right = right + 1
            }
            left = left + 1
        }

        var d: i64 = 0
        while d < PIREUS_CUBIC_FORGE_DIMENSION {
            var chunk: i64 = 0
            while chunk < 2 {
                var mask: i64 = 0
                var lane: i64 = 0
                while lane < PIREUS_CUBIC_FORGE_GROUP_LANES {
                    let source = chunk * PIREUS_CUBIC_FORGE_GROUP_LANES + lane
                    let partner = source ^ d
                    let sign_cell = mutation * PIREUS_CUBIC_FORGE_CELL_COUNT +
                        source * PIREUS_CUBIC_FORGE_DIMENSION + partner
                    if population.sign_bits[sign_cell] != 0 {
                        mask = mask | (1 << lane)
                    }
                    lane = lane + 1
                }
                if population.group_negative_masks[
                        mutation * PIREUS_CUBIC_FORGE_GROUP_COUNT +
                            d * 2 + chunk] != mask { return 7 }
                chunk = chunk + 1
            }

            // The fixture is smoke-only and repeats the original strict fold.
            var direct: f64 = 0.0
            var source: i64 = 0
            while source < PIREUS_CUBIC_FORGE_DIMENSION {
                let partner = source ^ d
                var term = parent.evaluation.lhs[source] *
                    parent.evaluation.rhs[partner]
                let sign = population.sign_bits[
                    mutation * PIREUS_CUBIC_FORGE_CELL_COUNT +
                        source * PIREUS_CUBIC_FORGE_DIMENSION + partner]
                if sign != 0 { term = 0.0 - term }
                direct = direct + term
                source = source + 1
            }
            if population.fixture_output_bits[
                    mutation * PIREUS_CUBIC_FORGE_DIMENSION + d] !=
                        f64_to_bits(direct) { return 8 }
            d = d + 1
        }

        let child = cof_child_digest(
            mutation, &descriptor, &population.sign_bits,
            &population.group_negative_masks, &population.fixture_output_bits,
            population.support_counts[mutation],
            population.witness_values[mutation],
            population.negative_counts[mutation],
            population.square_negative_counts[mutation],
            population.commutator_defects[mutation],
            population.associator_defects[mutation])
        let child_lineage = cof_child_lineage_digest(
            mutation, &descriptor, &child)
        var word: i64 = 0
        while word < 8 {
            if population.child_digest_words[mutation * 8 + word] !=
                    child.words[word] ||
                population.child_lineage_digest_words[mutation * 8 + word] !=
                    child_lineage.words[word] { return 9 }
            word = word + 1
        }
        mutation = mutation + 1
    }

    let receipt = &result.receipt
    if receipt.schema != PIREUS_CUBIC_FORGE_SCHEMA ||
        receipt.producer_language != PIREUS_CUBIC_FORGE_LANGUAGE_SOUNIO ||
        receipt.producer_role !=
            PIREUS_CUBIC_FORGE_ROLE_SEMANTIC_AUTHORITY ||
        receipt.stage != PIREUS_CUBIC_FORGE_STAGE_SOUNIO_EXECUTABLE ||
        !receipt.parent_lineage_bound ||
        !receipt.mixed_cubic_population_complete ||
        !receipt.noncocycle_witness_complete ||
        !receipt.relative_bilinear_grammar_novelty ||
        !receipt.executable_child_genomes || !receipt.immutable_lineage ||
        !receipt.no_child_selected || !receipt.target_envelopes_unresolved ||
        !receipt.declared_coordinate_scope ||
        !receipt.structural_counts_are_child_diagnostics ||
        !receipt.fixture_is_smoke_only ||
        receipt.declared_gl4_gauge_inequivalence ||
        receipt.relative_algebraic_novelty ||
        receipt.algebra_isomorphism_complete || receipt.algorithmic_novelty ||
        receipt.material_novelty || receipt.scientific_novelty ||
        receipt.global_novelty || receipt.historical_novelty ||
        receipt.priority_claim || receipt.external_prior_art_complete ||
        receipt.semantics_frozen || receipt.formal_parity_open ||
        receipt.effect_parity_open || receipt.material_parity_open ||
        receipt.target_lowering_admitted || receipt.target_cost_admitted ||
        receipt.target_performance_admitted || receipt.claim_ready {
        return 10
    }

    let negatives = &result.negatives
    if negatives.passed != 35 || negatives.total != 35 ||
        !negatives.python_oracle || !negatives.rust_oracle ||
        !negatives.cpp_authority || !negatives.llm_authority ||
        !negatives.missing_parent || !negatives.unfrozen_parent ||
        !negatives.unbound_parent || !negatives.wrong_mutation_count ||
        !negatives.reordered_descriptors || !negatives.malformed_descriptor ||
        !negatives.pure_side_mutation || !negatives.bilinear_equality ||
        !negatives.child_collision || !negatives.selected_child ||
        !negatives.ranking_objective || !negatives.missing_target ||
        !negatives.material_without_receipt || !negatives.changed_partner ||
        !negatives.changed_destination || !negatives.changed_ordinal ||
        !negatives.reassociated_reduction ||
        !negatives.fixture_proof_promotion ||
        !negatives.diagnostic_scope_promotion ||
        !negatives.parity_prefreeze || !negatives.gl4_gauge_promotion ||
        !negatives.algebraic_promotion || !negatives.algorithmic_promotion ||
        !negatives.material_promotion || !negatives.scientific_promotion ||
        !negatives.global_promotion || !negatives.historical_promotion ||
        !negatives.priority_promotion || !negatives.claim_ready_promotion ||
        !negatives.review_promotion || !negatives.invalid_waiver { return 11 }

    let lineage_digest = cof_digest_lineage(&result.lineage)
    let grammar_digest = cof_digest_grammar(population)
    let population_digest = cof_digest_population(population)
    let receipt_digest = cof_digest_receipt(receipt)
    let forge_digest = cof_digest_forge(
        &lineage_digest, &grammar_digest, &population_digest, &receipt_digest)
    if !cof_words_equal(&result.lineage_digest.words, &lineage_digest.words) ||
        !cof_words_equal(&result.grammar_digest.words, &grammar_digest.words) ||
        !cof_words_equal(
            &result.population_digest.words, &population_digest.words) ||
        !cof_words_equal(&result.receipt_digest.words, &receipt_digest.words) ||
        !cof_words_equal(&result.forge_digest.words, &forge_digest.words) {
        return 12
    }

    let frozen_lineage: [i64; 8] = [
        3860775034, 468693642, 4231564859, 3844680611,
        1704020110, 2708836985, 1832380429, 1008382543
    ]
    let frozen_grammar: [i64; 8] = [
        468361402, 4092662617, 267961812, 2036168244,
        3130940124, 1411579302, 2341517714, 3651052910
    ]
    let frozen_population: [i64; 8] = [
        200736808, 2571418695, 4053756919, 4054863849,
        1453848311, 575648672, 3871090767, 1270285793
    ]
    let frozen_receipt: [i64; 8] = [
        1626115308, 1125613225, 1142836651, 1304349769,
        3111449751, 586680959, 1563479825, 3599353596
    ]
    let frozen_forge: [i64; 8] = [
        3894840050, 124836850, 2465937913, 663992248,
        2635485618, 3900806112, 3413043045, 3754029567
    ]
    if !cof_digest_matches_frozen(
            &result.lineage_digest, &frozen_lineage) ||
        !cof_digest_matches_frozen(&result.grammar_digest, &frozen_grammar) ||
        !cof_digest_matches_frozen(
            &result.population_digest, &frozen_population) ||
        !cof_digest_matches_frozen(&result.receipt_digest, &frozen_receipt) ||
        !cof_digest_matches_frozen(&result.forge_digest, &frozen_forge) {
        return 13
    }
    0
}

pub fn pireus_cubic_operator_forge_matches_frozen_semantics(
    result: &PireusCubicForgeResult,
) -> bool with Mut, Panic, Div, Epistemic {
    pireus_cubic_operator_forge_frozen_mismatch_code(result) == 0
}
