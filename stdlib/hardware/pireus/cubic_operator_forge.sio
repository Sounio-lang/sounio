fn cof_words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < 8 {
        if left[index] != right[index] { return false }
        index = index + 1
    }
    true
}

fn cof_parent_digest_matches(
    digest: &PireusOperatorGenomeDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    cof_words_equal(&digest.words, expected)
}

fn cof_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn cof_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    cof_digest_add_i64(state, if value { 1 } else { 0 })
}

fn cof_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div {
    var next = state
    var index: i64 = 0
    while index < 8 {
        next = cof_digest_add_i64(next, words[index])
        index = index + 1
    }
    next
}

fn cof_digest_add_digest(
    state: SHA256State,
    digest: &PireusCubicForgeDigest,
) -> SHA256State with Mut, Panic, Div {
    cof_digest_add_words(state, &digest.words)
}

fn cof_digest_finish(state: SHA256State) -> PireusCubicForgeDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusCubicForgeDigest { words: words }
}

pub fn pireus_cubic_forge_digest_nonzero(
    digest: &PireusCubicForgeDigest,
) -> bool with Mut {
    var index: i64 = 0
    while index < 8 {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

