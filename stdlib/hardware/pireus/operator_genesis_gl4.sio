fn parity4(value: i64) -> i64 with Mut {
    var parity: i64 = 0
    var bit: i64 = 0
    while bit < 4 {
        if (value & (1 << bit)) != 0 { parity = parity ^ 1 }
        bit = bit + 1
    }
    parity
}

fn highest_basis_bit(value: i64) -> i64 with Mut {
    var selected: i64 = 0
    var bit: i64 = 0
    while bit < 4 {
        let basis = 1 << bit
        if (value & basis) != 0 { selected = basis }
        bit = bit + 1
    }
    selected
}

fn is_basis_vector(value: i64) -> bool {
    value == 1 || value == 2 || value == 4 || value == 8
}

fn sign_to_bit(sign: i64) -> i64 {
    if sign < 0 { 1 } else { 0 }
}

fn bit_to_sign(bit: i64) -> i64 {
    if bit == 0 { 1 } else { 0 - 1 }
}

fn candidate_bit(mask: i64, i: i64, j: i64) -> i64
with Mut, Panic, Div {
    let base = cd_sigma(i as i32, j as i32, 4) as i64
    let phase = parity4(mask & i & j)
    sign_to_bit(if phase == 0 { base } else { 0 - base })
}

fn corpus_bit(corpus_id: i64, i: i64, j: i64) -> i64
with Mut, Panic, Div {
    if corpus_id == PIREUS_GL4_CORPUS_UNTWISTED_XOR { return 0 }
    if corpus_id == PIREUS_GL4_CORPUS_CAYLEY_DICKSON_16 {
        return sign_to_bit(cd_sigma(i as i32, j as i32, 4) as i64)
    }
    parity4(i & j)
}

fn candidate_table(mask: i64) -> GL4SignTable with Mut, Panic, Div {
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = candidate_bit(mask, i, j)
            j = j + 1
        }
        i = i + 1
    }
    GL4SignTable { cells: cells }
}

fn corpus_table(corpus_id: i64) -> GL4SignTable with Mut, Panic, Div {
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = corpus_bit(corpus_id, i, j)
            j = j + 1
        }
        i = i + 1
    }
    GL4SignTable { cells: cells }
}

fn matrix_row(code: i64, row: i64) -> i64 {
    (code >> (row * 4)) & 15
}

fn matrix_apply(code: i64, vector: i64) -> i64 with Mut {
    var result: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if parity4(matrix_row(code, row) & vector) == 1 {
            result = result | (1 << row)
        }
        row = row + 1
    }
    result
}

fn matrix_invertible(code: i64) -> bool with Mut, Panic {
    var seen: [bool; 16] = [false; 16]
    var vector: i64 = 0
    while vector < 16 {
        let image = matrix_apply(code, vector)
        if seen[image] { return false }
        seen[image] = true
        vector = vector + 1
    }
    true
}

fn matrix_compose(left: i64, right: i64) -> i64 with Mut {
    var code: i64 = 0
    var row: i64 = 0
    while row < 4 {
        let selector = matrix_row(left, row)
        var composed_row: i64 = 0
        var source_row: i64 = 0
        while source_row < 4 {
            if (selector & (1 << source_row)) != 0 {
                composed_row = composed_row ^ matrix_row(right, source_row)
            }
            source_row = source_row + 1
        }
        code = code | (composed_row << (row * 4))
        row = row + 1
    }
    code
}

fn generator_code(index: i64) -> i64 {
    if index == 0 { return 33810 } // swap rows 0 and 1
    if index == 1 { return 33345 } // swap rows 1 and 2
    if index == 2 { return 18465 } // swap rows 2 and 3
    33827                         // row 0 <- row 0 + row 1
}

fn build_matrix_universe() -> GL4MatrixUniverse with Mut, Panic {
    var codes: [i64; 20160] = [0; 20160]
    var count: i64 = 0
    var code: i64 = 0
    var identity_present: bool = false
    var sorted_unique: bool = true
    while code < PIREUS_GL4_MATRIX_ENCODINGS {
        if matrix_invertible(code) {
            if count >= PIREUS_GL4_MATRIX_COUNT {
                sorted_unique = false
            } else {
                if count > 0 && codes[count - 1] >= code {
                    sorted_unique = false
                }
                codes[count] = code
                if code == 33825 { identity_present = true }
                count = count + 1
            }
        }
        code = code + 1
    }

    var visited: [bool; 65536] = [false; 65536]
    var queue: [i64; 20160] = [0; 20160]
    var head: i64 = 0
    var tail: i64 = 1
    var overflow: bool = false
    var noninvertible: i64 = 0
    queue[0] = 33825
    visited[33825] = true
    while head < tail {
        let current = queue[head]
        var generator: i64 = 0
        while generator < 4 {
            let next = matrix_compose(generator_code(generator), current)
            if !visited[next] {
                if tail >= PIREUS_GL4_MATRIX_COUNT {
                    overflow = true
                } else {
                    visited[next] = true
                    queue[tail] = next
                    tail = tail + 1
                    if !matrix_invertible(next) {
                        noninvertible = noninvertible + 1
                    }
                }
            }
            generator = generator + 1
        }
        head = head + 1
    }

    var mismatches: i64 = 0
    code = 0
    while code < PIREUS_GL4_MATRIX_ENCODINGS {
        if visited[code] != matrix_invertible(code) {
            mismatches = mismatches + 1
        }
        code = code + 1
    }
    GL4MatrixUniverse {
        codes: codes,
        encodings_scanned: PIREUS_GL4_MATRIX_ENCODINGS,
        matrix_count: count,
        bfs_count: tail,
        set_mismatches: mismatches,
        bfs_noninvertible: noninvertible,
        bfs_overflow: overflow,
        identity_present: identity_present,
        sorted_unique: sorted_unique,
    }
}

fn group_certificate(universe: &GL4MatrixUniverse) -> GL4GroupCertificate {
    let complete = universe.encodings_scanned == PIREUS_GL4_MATRIX_ENCODINGS &&
        universe.matrix_count == PIREUS_GL4_MATRIX_COUNT &&
        universe.bfs_count == PIREUS_GL4_MATRIX_COUNT &&
        universe.set_mismatches == 0 && universe.bfs_noninvertible == 0 &&
        !universe.bfs_overflow && universe.identity_present &&
        universe.sorted_unique
    GL4GroupCertificate {
        encodings_scanned: universe.encodings_scanned,
        matrix_count: universe.matrix_count,
        bfs_count: universe.bfs_count,
        set_mismatches: universe.set_mismatches,
        bfs_noninvertible: universe.bfs_noninvertible,
        bfs_overflow: universe.bfs_overflow,
        identity_present: universe.identity_present,
        sorted_unique: universe.sorted_unique,
        operand_orders: PIREUS_GL4_SWAP_COUNT,
        linear_swap_actions: PIREUS_GL4_LINEAR_SWAP_ACTIONS,
        complete: complete,
    }
}

fn gauge_value(mask: i64, index: i64) -> i64 {
    if index == 0 { 0 } else { (mask >> (index - 1)) & 1 }
}

fn gauge_is_kernel(mask: i64) -> bool with Mut {
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            if (gauge_value(mask, i) ^ gauge_value(mask, j) ^
                gauge_value(mask, i ^ j)) != 0 {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    true
}

fn gauge_certificate() -> GL4GaugeCertificate with Mut, Div {
    var kernel: i64 = 0
    var mask: i64 = 0
    while mask < PIREUS_GL4_GAUGE_COUNT {
        if gauge_is_kernel(mask) { kernel = kernel + 1 }
        mask = mask + 1
    }
    let actions = if kernel > 0 { PIREUS_GL4_GAUGE_COUNT / kernel } else { 0 }
    GL4GaugeCertificate {
        gauge_functions: PIREUS_GL4_GAUGE_COUNT,
        kernel_count: kernel,
        distinct_actions: actions,
        tree_edges: 11,
        quotient_exact: kernel == PIREUS_GL4_GAUGE_KERNEL_COUNT &&
            actions == PIREUS_GL4_GAUGE_ACTION_COUNT,
    }
}

fn apply_gauge(table: &GL4SignTable, mask: i64) -> GL4SignTable
with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = table.cells[i * 16 + j] ^
                gauge_value(mask, i) ^ gauge_value(mask, j) ^
                gauge_value(mask, i ^ j)
            j = j + 1
        }
        i = i + 1
    }
    GL4SignTable { cells: cells }
}

fn normalize_gauge(table: &GL4SignTable) -> GL4SignTable with Mut, Panic {
    var q: [i64; 16] = [0; 16]
    var x: i64 = 1
    while x < 16 {
        if !is_basis_vector(x) {
            let edge = highest_basis_bit(x)
            let parent = x ^ edge
            q[x] = table.cells[parent * 16 + edge] ^ q[parent]
        }
        x = x + 1
    }
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = table.cells[i * 16 + j] ^
                q[i] ^ q[j] ^ q[i ^ j]
            j = j + 1
        }
        i = i + 1
    }
    GL4SignTable { cells: cells }
}

fn tree_cells_zero(table: &GL4SignTable) -> bool with Mut, Panic {
    var x: i64 = 1
    while x < 16 {
        if !is_basis_vector(x) {
            let edge = highest_basis_bit(x)
            let parent = x ^ edge
            if table.cells[parent * 16 + edge] != 0 { return false }
        }
        x = x + 1
    }
    true
}

fn tables_equal(left: &GL4SignTable, right: &GL4SignTable) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < 256 {
        if left.cells[index] != right.cells[index] { return false }
        index = index + 1
    }
    true
}

fn table_less(left: &GL4SignTable, right: &GL4SignTable) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < 256 {
        if left.cells[index] < right.cells[index] { return true }
        if left.cells[index] > right.cells[index] { return false }
        index = index + 1
    }
    false
}

fn transformed_bit(
    table: &GL4SignTable,
    matrix: i64,
    swap: bool,
    i: i64,
    j: i64,
) -> i64 with Mut, Panic {
    let mapped_i = matrix_apply(matrix, i)
    let mapped_j = matrix_apply(matrix, j)
    if swap {
        table.cells[mapped_j * 16 + mapped_i]
    } else {
        table.cells[mapped_i * 16 + mapped_j]
    }
}

fn transform_table(
    table: &GL4SignTable,
    matrix: i64,
    swap: bool,
) -> GL4SignTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = transformed_bit(table, matrix, swap, i, j)
            j = j + 1
        }
        i = i + 1
    }
    GL4SignTable { cells: cells }
}

fn diagonal_compare(
    table: &GL4SignTable,
    matrix: i64,
    best: &[i64; 16],
) -> i64 with Mut, Panic {
    var i: i64 = 0
    while i < 16 {
        let cell = transformed_bit(table, matrix, false, i, i)
        if cell < best[i] { return 0 - 1 }
        if cell > best[i] { return 1 }
        i = i + 1
    }
    0
}

fn fill_diagonal(
    table: &GL4SignTable,
    matrix: i64,
) -> [i64; 16] with Mut, Panic {
    var diagonal: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < 16 {
        diagonal[i] = transformed_bit(table, matrix, false, i, i)
        i = i + 1
    }
    diagonal
}

fn commutator_cell(
    table: &GL4SignTable,
    matrix: i64,
    i: i64,
    j: i64,
) -> i64 with Mut, Panic {
    transformed_bit(table, matrix, false, i, j) ^
        transformed_bit(table, matrix, false, j, i)
}

fn commutator_compare(
    table: &GL4SignTable,
    matrix: i64,
    best: &[i64; 256],
) -> i64 with Mut, Panic {
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            let index = i * 16 + j
            let cell = commutator_cell(table, matrix, i, j)
            if cell < best[index] { return 0 - 1 }
            if cell > best[index] { return 1 }
            j = j + 1
        }
        i = i + 1
    }
    0
}

fn fill_commutator(
    table: &GL4SignTable,
    matrix: i64,
) -> [i64; 256] with Mut, Panic {
    var commutator: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            commutator[i * 16 + j] = commutator_cell(table, matrix, i, j)
            j = j + 1
        }
        i = i + 1
    }
    commutator
}

fn canonicalize(
    table: &GL4SignTable,
    universe: &GL4MatrixUniverse,
) -> GL4CanonicalKey with Mut, Panic {
    var best_diagonal: [i64; 16] = [0; 16]
    var has_diagonal: bool = false
    var matrix_index: i64 = 0
    while matrix_index < universe.matrix_count {
        let matrix = universe.codes[matrix_index]
        if !has_diagonal || diagonal_compare(table, matrix, &best_diagonal) < 0 {
            best_diagonal = fill_diagonal(table, matrix)
            has_diagonal = true
        }
        matrix_index = matrix_index + 1
    }

    var diagonal_finalists: i64 = 0
    var best_commutator: [i64; 256] = [0; 256]
    var has_commutator: bool = false
    matrix_index = 0
    while matrix_index < universe.matrix_count {
        let matrix = universe.codes[matrix_index]
        if diagonal_compare(table, matrix, &best_diagonal) == 0 {
            diagonal_finalists = diagonal_finalists + 1
            if !has_commutator ||
                commutator_compare(table, matrix, &best_commutator) < 0 {
                best_commutator = fill_commutator(table, matrix)
                has_commutator = true
            }
        }
        matrix_index = matrix_index + 1
    }

    var commutator_finalists: i64 = 0
    var normalized_actions: i64 = 0
    var best_table = GL4SignTable { cells: [0; 256] }
    var best_matrix: i64 = 0 - 1
    var best_swap: bool = false
    var has_table: bool = false
    matrix_index = 0
    while matrix_index < universe.matrix_count {
        let matrix = universe.codes[matrix_index]
        if diagonal_compare(table, matrix, &best_diagonal) == 0 &&
            commutator_compare(table, matrix, &best_commutator) == 0 {
            commutator_finalists = commutator_finalists + 1
            var swap_index: i64 = 0
            while swap_index < 2 {
                let transformed = transform_table(table, matrix, swap_index == 1)
                let normalized = normalize_gauge(&transformed)
                normalized_actions = normalized_actions + 1
                if !has_table || table_less(&normalized, &best_table) {
                    best_table = normalized
                    best_matrix = matrix
                    best_swap = swap_index == 1
                    has_table = true
                }
                swap_index = swap_index + 1
            }
        }
        matrix_index = matrix_index + 1
    }
    GL4CanonicalKey {
        valid: has_diagonal && has_commutator && has_table &&
            tree_cells_zero(&best_table),
        matrix_code: best_matrix,
        swap_operands: best_swap,
        actions_considered: universe.matrix_count * 2,
        diagonal_finalists: diagonal_finalists,
        commutator_finalists: commutator_finalists,
        normalized_actions: normalized_actions,
        diagonal: best_diagonal,
        commutator: best_commutator,
        table: best_table.cells,
    }
}

fn canonical_keys_equal(left: &GL4CanonicalKey, right: &GL4CanonicalKey)
    -> bool with Mut, Panic {
    var i: i64 = 0
    while i < 16 {
        if left.diagonal[i] != right.diagonal[i] { return false }
        i = i + 1
    }
    i = 0
    while i < 256 {
        if left.commutator[i] != right.commutator[i] ||
            left.table[i] != right.table[i] { return false }
        i = i + 1
    }
    true
}

fn canonical_distance(left: &GL4CanonicalKey, right: &GL4CanonicalKey)
    -> i64 with Mut, Panic {
    var distance: i64 = 0
    var index: i64 = 0
    while index < 256 {
        if left.table[index] != right.table[index] {
            distance = distance + 1
        }
        index = index + 1
    }
    distance
}

struct GL4CorpusKeys {
    untwisted: GL4CanonicalKey,
    cayley_dickson: GL4CanonicalKey,
    diagonal: GL4CanonicalKey,
}

struct GL4SearchWork {
    search: GL4SearchCertificate,
    selected_raw: GL4SignTable,
    selected_key: GL4CanonicalKey,
    corpus: GL4CorpusKeys,
}

fn empty_canonical_key() -> GL4CanonicalKey {
    GL4CanonicalKey {
        valid: false,
        matrix_code: 0 - 1,
        swap_operands: false,
        actions_considered: 0,
        diagonal_finalists: 0,
        commutator_finalists: 0,
        normalized_actions: 0,
        diagonal: [0; 16],
        commutator: [0; 256],
        table: [0; 256],
    }
}

fn empty_candidate() -> GL4GeneratedCandidate {
    GL4GeneratedCandidate {
        generation_ordinal: 0 - 1,
        phase_mask: 0 - 1,
        canonical_matrix: 0 - 1,
        canonical_swap: false,
        canonical_quotient_distance: 0 - 1,
        nearest_corpus_id: 0,
        equivalent_to_corpus: false,
        declared_gl4_gauge_inequivalence: false,
    }
}

fn corpus_key_by_id(corpus: &GL4CorpusKeys, corpus_id: i64)
    -> GL4CanonicalKey {
    if corpus_id == PIREUS_GL4_CORPUS_UNTWISTED_XOR {
        return corpus.untwisted
    }
    if corpus_id == PIREUS_GL4_CORPUS_CAYLEY_DICKSON_16 {
        return corpus.cayley_dickson
    }
    corpus.diagonal
}

fn build_corpus_keys(universe: &GL4MatrixUniverse) -> GL4CorpusKeys
with Mut, Panic, Div {
    let untwisted_raw = corpus_table(PIREUS_GL4_CORPUS_UNTWISTED_XOR)
    let cayley_raw = corpus_table(PIREUS_GL4_CORPUS_CAYLEY_DICKSON_16)
    let diagonal_raw = corpus_table(PIREUS_GL4_CORPUS_DIAGONAL_BICHARACTER)
    GL4CorpusKeys {
        untwisted: canonicalize(&untwisted_raw, universe),
        cayley_dickson: canonicalize(&cayley_raw, universe),
        diagonal: canonicalize(&diagonal_raw, universe),
    }
}

fn run_search(universe: &GL4MatrixUniverse) -> GL4SearchWork
with Mut, Panic, Div, Epistemic {
    let corpus = build_corpus_keys(universe)
    var masks: [i64; 16] = [0; 16]
    var distances: [i64; 16] = [0; 16]
    var matrices: [i64; 16] = [0; 16]
    var swaps: [bool; 16] = [false; 16]
    var nearest_corpus: [i64; 16] = [0; 16]
    var equivalents: [bool; 16] = [false; 16]
    var declared_equivalence_classes: [i64; 16] = [0; 16]
    var declared_equivalence_class_count: i64 = 0
    var canonical_diagonals: [i64; 256] = [0; 256]
    var canonical_commutators: [i64; 4096] = [0; 4096]
    var canonical_tables: [i64; 4096] = [0; 4096]
    var candidate_digest_words: [i64; 128] = [0; 128]
    var corpus_digest_words: [i64; 24] = [0; 24]
    var corpus_id: i64 = 1
    while corpus_id <= PIREUS_GL4_CORPUS_COUNT {
        let corpus_key = corpus_key_by_id(&corpus, corpus_id)
        let corpus_key_digest = digest_canonical(&corpus_key)
        var word: i64 = 0
        while word < 8 {
            corpus_digest_words[(corpus_id - 1) * 8 + word] =
                corpus_key_digest.words[word]
            word = word + 1
        }
        corpus_id = corpus_id + 1
    }
    var selected = empty_candidate()
    var selected_raw = GL4SignTable { cells: [0; 256] }
    var selected_key = empty_canonical_key()
    var ordinal: i64 = 0
    while ordinal < PIREUS_GL4_CANDIDATE_COUNT {
        let mask = (ordinal + PIREUS_GL4_SEED) % PIREUS_GL4_CANDIDATE_COUNT
        let raw = candidate_table(mask)
        let key = canonicalize(&raw, universe)
        let d1 = canonical_distance(&key, &corpus.untwisted)
        let d2 = canonical_distance(&key, &corpus.cayley_dickson)
        let d3 = canonical_distance(&key, &corpus.diagonal)
        var score = d1
        var nearest = PIREUS_GL4_CORPUS_UNTWISTED_XOR
        if d2 < score {
            score = d2
            nearest = PIREUS_GL4_CORPUS_CAYLEY_DICKSON_16
        }
        if d3 < score {
            score = d3
            nearest = PIREUS_GL4_CORPUS_DIAGONAL_BICHARACTER
        }
        let equivalent = canonical_keys_equal(&key, &corpus.untwisted) ||
            canonical_keys_equal(&key, &corpus.cayley_dickson) ||
            canonical_keys_equal(&key, &corpus.diagonal)
        let candidate = GL4GeneratedCandidate {
            generation_ordinal: ordinal,
            phase_mask: mask,
            canonical_matrix: key.matrix_code,
            canonical_swap: key.swap_operands,
            canonical_quotient_distance: score,
            nearest_corpus_id: nearest,
            equivalent_to_corpus: equivalent,
            declared_gl4_gauge_inequivalence: !equivalent && score > 0,
        }
        var declared_equivalence_class: i64 = 0 - 1
        var prior: i64 = 0
        while prior < ordinal && declared_equivalence_class < 0 {
            var same: bool = true
            var diagonal_cell: i64 = 0
            while diagonal_cell < 16 && same {
                if key.diagonal[diagonal_cell] !=
                    canonical_diagonals[prior * 16 + diagonal_cell] {
                    same = false
                }
                diagonal_cell = diagonal_cell + 1
            }
            var cell: i64 = 0
            while cell < 256 && same {
                if key.commutator[cell] !=
                        canonical_commutators[prior * 256 + cell] ||
                    key.table[cell] != canonical_tables[prior * 256 + cell] {
                    same = false
                }
                cell = cell + 1
            }
            if same {
                declared_equivalence_class = declared_equivalence_classes[prior]
            }
            prior = prior + 1
        }
        if declared_equivalence_class < 0 {
            declared_equivalence_class = declared_equivalence_class_count
            declared_equivalence_class_count =
                declared_equivalence_class_count + 1
        }
        declared_equivalence_classes[ordinal] = declared_equivalence_class
        var diagonal_cell: i64 = 0
        while diagonal_cell < 16 {
            canonical_diagonals[ordinal * 16 + diagonal_cell] =
                key.diagonal[diagonal_cell]
            diagonal_cell = diagonal_cell + 1
        }
        var cell: i64 = 0
        while cell < 256 {
            canonical_commutators[ordinal * 256 + cell] = key.commutator[cell]
            canonical_tables[ordinal * 256 + cell] = key.table[cell]
            cell = cell + 1
        }
        let key_digest = digest_canonical(&key)
        var word: i64 = 0
        while word < 8 {
            candidate_digest_words[ordinal * 8 + word] = key_digest.words[word]
            word = word + 1
        }
        masks[ordinal] = mask
        distances[ordinal] = score
        matrices[ordinal] = key.matrix_code
        swaps[ordinal] = key.swap_operands
        nearest_corpus[ordinal] = nearest
        equivalents[ordinal] = equivalent
        if selected.generation_ordinal < 0 ||
            candidate.canonical_quotient_distance >
                selected.canonical_quotient_distance {
            selected = candidate
            selected_raw = raw
            selected_key = key
        }
        ordinal = ordinal + 1
    }
    GL4SearchWork {
        search: GL4SearchCertificate {
            candidates_evaluated: PIREUS_GL4_CANDIDATE_COUNT,
            corpus_canonicalized: PIREUS_GL4_CORPUS_COUNT,
            matrices_per_table: universe.matrix_count,
            linear_swap_actions_per_table: universe.matrix_count * 2,
            candidate_masks: masks,
            candidate_distances: distances,
            candidate_matrices: matrices,
            candidate_swaps: swaps,
            candidate_nearest_corpus: nearest_corpus,
            candidate_equivalent: equivalents,
            candidate_equivalence_classes: declared_equivalence_classes,
            candidate_equivalence_class_count: declared_equivalence_class_count,
            candidate_canonical_digest_words: candidate_digest_words,
            corpus_canonical_digest_words: corpus_digest_words,
            selected: selected,
        },
        selected_raw: selected_raw,
        selected_key: selected_key,
        corpus: corpus,
    }
}

fn exhaustive_gauge_invariance_failures(table: &GL4SignTable)
    -> i64 with Mut, Panic {
    let expected = normalize_gauge(table)
    var failures: i64 = 0
    var mask: i64 = 0
    while mask < PIREUS_GL4_GAUGE_COUNT {
        let gauged = apply_gauge(table, mask)
        let normalized = normalize_gauge(&gauged)
        if !tables_equal(&expected, &normalized) ||
            !tree_cells_zero(&normalized) {
            failures = failures + 1
        }
        mask = mask + 1
    }
    failures
}

fn generator_invariance_failures(
    table: &GL4SignTable,
    expected: &GL4CanonicalKey,
    universe: &GL4MatrixUniverse,
) -> i64 with Mut, Panic {
    var failures: i64 = 0
    var generator: i64 = 0
    while generator < 4 {
        let transformed = transform_table(table, generator_code(generator), false)
        let key = canonicalize(&transformed, universe)
        if !canonical_keys_equal(expected, &key) {
            failures = failures + 1
        }
        generator = generator + 1
    }
    let swapped = transform_table(table, 33825, true)
    let swap_key = canonicalize(&swapped, universe)
    if !canonical_keys_equal(expected, &swap_key) {
        failures = failures + 1
    }
    failures
}

fn build_witness(work: &GL4SearchWork) -> GL4InequivalenceWitness
with Mut, Panic {
    let corpus_key = corpus_key_by_id(
        &work.corpus, work.search.selected.nearest_corpus_id)
    var index: i64 = 0
    while index < 256 {
        if work.selected_key.table[index] != corpus_key.table[index] {
            return GL4InequivalenceWitness {
                present: true,
                corpus_id: work.search.selected.nearest_corpus_id,
                i: index / 16,
                j: index % 16,
                candidate_sign: bit_to_sign(work.selected_key.table[index]),
                corpus_sign: bit_to_sign(corpus_key.table[index]),
                canonical_quotient_distance:
                    work.search.selected.canonical_quotient_distance,
            }
        }
        index = index + 1
    }
    GL4InequivalenceWitness {
        present: false,
        corpus_id: work.search.selected.nearest_corpus_id,
        i: 0 - 1,
        j: 0 - 1,
        candidate_sign: 0,
        corpus_sign: 0,
        canonical_quotient_distance:
            work.search.selected.canonical_quotient_distance,
    }
}

fn fingerprint(key: &GL4CanonicalKey) -> GL4OperatorFingerprint
with Mut, Panic {
    var positive: i64 = 0
    var negative: i64 = 0
    var commutator_defects: i64 = 0
    var associator_defects: i64 = 0
    var displacement: [i64; 16] = [0; 16]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            let bit = key.table[i * 16 + j]
            if bit == 0 { positive = positive + 1 }
            else {
                negative = negative + 1
                displacement[i ^ j] = displacement[i ^ j] + 1
            }
            if bit != key.table[j * 16 + i] {
                commutator_defects = commutator_defects + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            var k: i64 = 0
            while k < 16 {
                let lhs = key.table[i * 16 + j] ^
                    key.table[(i ^ j) * 16 + k]
                let rhs = key.table[j * 16 + k] ^
                    key.table[i * 16 + (j ^ k)]
                if lhs != rhs { associator_defects = associator_defects + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    GL4OperatorFingerprint {
        positive_count: positive,
        negative_count: negative,
        commutator_defects: commutator_defects,
        associator_defects: associator_defects,
        displacement_negative_counts: displacement,
    }
}

pub fn pireus_operator_genesis_gl4_request() -> GL4AuthorityRequest {
    GL4AuthorityRequest {
        producer_language: PIREUS_GL4_LANGUAGE_SOUNIO,
        producer_role: PIREUS_GL4_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_GL4_STAGE_SOUNIO_EXECUTABLE,
        policy_present: true,
        grammar_present: true,
        corpus_present: true,
        matrix_universe_present: true,
        gauge_quotient_present: true,
        declared_candidates: PIREUS_GL4_CANDIDATE_COUNT,
        declared_matrix_encodings: PIREUS_GL4_MATRIX_ENCODINGS,
        declared_matrices: PIREUS_GL4_MATRIX_COUNT,
        declared_gauges: PIREUS_GL4_GAUGE_COUNT,
        declared_gauge_kernel: PIREUS_GL4_GAUGE_KERNEL_COUNT,
        declared_gauge_actions: PIREUS_GL4_GAUGE_ACTION_COUNT,
        declared_action_universe: PIREUS_GL4_DECLARED_ACTION_UNIVERSE,
        semantics_frozen: false,
        parity_requested: false,
        orbit_hamming_claimed: false,
        relative_algebraic_novelty_requested: false,
        global_novelty_requested: false,
        historical_novelty_requested: false,
        priority_requested: false,
        algorithmic_novelty_requested: false,
        material_novelty_requested: false,
        scientific_novelty_requested: false,
        claim_ready_requested: false,
        external_review_promoted: false,
        fingerprint_only_proof: false,
        waiver_present: false,
        waiver_founder: false,
        waiver_scoped: false,
        waiver_purpose_bound: false,
        waiver_live: false,
    }
}

fn request_error(request: &GL4AuthorityRequest) -> i64 {
    if request.producer_language != PIREUS_GL4_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_GL4_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_GL4_ERR_AUTHORITY
    }
    if request.stage != PIREUS_GL4_STAGE_SOUNIO_EXECUTABLE ||
        request.semantics_frozen || request.parity_requested {
        return PIREUS_GL4_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_GL4_ERR_POLICY }
    if !request.grammar_present || !request.corpus_present ||
        !request.matrix_universe_present || !request.gauge_quotient_present ||
        request.declared_candidates != PIREUS_GL4_CANDIDATE_COUNT ||
        request.declared_matrix_encodings != PIREUS_GL4_MATRIX_ENCODINGS ||
        request.declared_matrices != PIREUS_GL4_MATRIX_COUNT ||
        request.declared_gauges != PIREUS_GL4_GAUGE_COUNT ||
        request.declared_gauge_kernel != PIREUS_GL4_GAUGE_KERNEL_COUNT ||
        request.declared_gauge_actions != PIREUS_GL4_GAUGE_ACTION_COUNT ||
        request.declared_action_universe !=
            PIREUS_GL4_DECLARED_ACTION_UNIVERSE {
        return PIREUS_GL4_ERR_SPACE
    }
    if request.orbit_hamming_claimed ||
        request.relative_algebraic_novelty_requested ||
        request.global_novelty_requested ||
        request.historical_novelty_requested || request.priority_requested ||
        request.algorithmic_novelty_requested ||
        request.material_novelty_requested ||
        request.scientific_novelty_requested ||
        request.claim_ready_requested || request.external_review_promoted ||
        request.fingerprint_only_proof {
        return PIREUS_GL4_ERR_CLAIM_SCOPE
    }
    if request.waiver_present && !(request.waiver_founder &&
        request.waiver_scoped && request.waiver_purpose_bound &&
        request.waiver_live) {
        return PIREUS_GL4_ERR_WAIVER
    }
    PIREUS_GL4_OK
}

fn request_refused(request: &GL4AuthorityRequest) -> bool {
    request_error(request) != PIREUS_GL4_OK
}

fn novelty_claim_valid(distance: i64, equivalent: bool, complete: bool) -> bool {
    distance > 0 && !equivalent && complete
}

