    request.producer_role = PIREUS_GL4_ROLE_REVIEW_ONLY
    let llm_authority = request_refused(&request)

    request = pireus_operator_genesis_gl4_request()
    request.parity_requested = true
    let parity_prefreeze = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.orbit_hamming_claimed = true
    let orbit_hamming = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.relative_algebraic_novelty_requested = true
    let algebraic = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.global_novelty_requested = true
    let global = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.historical_novelty_requested = true
    let historical = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.priority_requested = true
    let priority = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.algorithmic_novelty_requested = true
    let algorithmic = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.material_novelty_requested = true
    let material = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.scientific_novelty_requested = true
    let scientific = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.claim_ready_requested = true
    let claim_ready = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.external_review_promoted = true
    let review = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.fingerprint_only_proof = true
    let fingerprint_only = request_refused(&request)
    request = pireus_operator_genesis_gl4_request()
    request.waiver_present = true
    request.waiver_founder = true
    request.waiver_scoped = false
    request.waiver_purpose_bound = true
    request.waiver_live = true
    let invalid_waiver = request_refused(&request)
    let zero_distance = !novelty_claim_valid(0, false, true)

    var passed: i64 = 0
    if missing_policy { passed = passed + 1 }
    if missing_grammar { passed = passed + 1 }
    if missing_corpus { passed = passed + 1 }
    if missing_matrix { passed = passed + 1 }
    if missing_gauge { passed = passed + 1 }
    if incomplete_candidates { passed = passed + 1 }
    if incomplete_matrix_scan { passed = passed + 1 }
    if incomplete_gl4 { passed = passed + 1 }
    if incomplete_gauges { passed = passed + 1 }
    if wrong_kernel { passed = passed + 1 }
    if wrong_gauge_actions { passed = passed + 1 }
    if wrong_action_universe { passed = passed + 1 }
    if python_oracle { passed = passed + 1 }
    if rust_oracle { passed = passed + 1 }
    if cpp_authority { passed = passed + 1 }
    if llm_authority { passed = passed + 1 }
    if parity_prefreeze { passed = passed + 1 }
    if orbit_hamming { passed = passed + 1 }
    if algebraic { passed = passed + 1 }
    if global { passed = passed + 1 }
    if historical { passed = passed + 1 }
    if priority { passed = passed + 1 }
    if algorithmic { passed = passed + 1 }
    if material { passed = passed + 1 }
    if scientific { passed = passed + 1 }
    if claim_ready { passed = passed + 1 }
    if review { passed = passed + 1 }
    if fingerprint_only { passed = passed + 1 }
    if invalid_waiver { passed = passed + 1 }
    if zero_distance { passed = passed + 1 }
    GL4GenesisNegatives {
        missing_policy: missing_policy,
        missing_grammar: missing_grammar,
        missing_corpus: missing_corpus,
        missing_matrix_universe: missing_matrix,
        missing_gauge_quotient: missing_gauge,
        incomplete_candidates: incomplete_candidates,
        incomplete_matrix_scan: incomplete_matrix_scan,
        incomplete_gl4: incomplete_gl4,
        incomplete_gauges: incomplete_gauges,
        wrong_gauge_kernel: wrong_kernel,
        wrong_gauge_actions: wrong_gauge_actions,
        wrong_action_universe: wrong_action_universe,
        python_oracle: python_oracle,
        rust_oracle: rust_oracle,
        cpp_authority: cpp_authority,
        llm_authority: llm_authority,
        parity_prefreeze: parity_prefreeze,
        orbit_hamming_promotion: orbit_hamming,
        algebraic_promotion: algebraic,
        global_promotion: global,
        historical_promotion: historical,
        priority_promotion: priority,
        algorithmic_promotion: algorithmic,
        material_promotion: material,
        scientific_promotion: scientific,
        claim_ready_promotion: claim_ready,
        review_promotion: review,
        fingerprint_promotion: fingerprint_only,
        invalid_waiver: invalid_waiver,
        zero_distance_promotion: zero_distance,
        passed: passed,
        total: 30,
    }
}

fn digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> (56 - index * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    digest_add_i64(state, if value { 1 } else { 0 })
}

fn digest_add_digest(state: SHA256State, digest: &GL4GenesisDigest)
    -> SHA256State with Mut, Panic, Div {
    var next = state
    var index: i64 = 0
    while index < 8 {
        next = digest_add_i64(next, digest.words[index])
        index = index + 1
    }
    next
}

fn digest_finish(state: SHA256State) -> GL4GenesisDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    GL4GenesisDigest { words: words }
}

fn digest_add_key(state: SHA256State, key: &GL4CanonicalKey)
    -> SHA256State with Mut, Panic, Div {
    var next = digest_add_bool(state, key.valid)
    next = digest_add_i64(next, key.matrix_code)
    next = digest_add_bool(next, key.swap_operands)
    next = digest_add_i64(next, key.actions_considered)
    next = digest_add_i64(next, key.diagonal_finalists)
    next = digest_add_i64(next, key.commutator_finalists)
    next = digest_add_i64(next, key.normalized_actions)
    var index: i64 = 0
    while index < 16 {
        next = digest_add_i64(next, key.diagonal[index])
        index = index + 1
    }
    index = 0
    while index < 256 {
        next = digest_add_i64(next, key.commutator[index])
        next = digest_add_i64(next, key.table[index])
        index = index + 1
    }
    next
}

fn digest_add_semantic_key(state: SHA256State, key: &GL4CanonicalKey)
    -> SHA256State with Mut, Panic, Div {
    var next = state
    var index: i64 = 0
    while index < 16 {
        next = digest_add_i64(next, key.diagonal[index])
        index = index + 1
    }
    index = 0
    while index < 256 {
        next = digest_add_i64(next, key.commutator[index])
        next = digest_add_i64(next, key.table[index])
        index = index + 1
    }
    next
}

fn digest_grammar() -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, PIREUS_GL4_CANDIDATE_COUNT)
    state = digest_add_i64(state, PIREUS_GL4_SEED)
    var ordinal: i64 = 0
    while ordinal < PIREUS_GL4_CANDIDATE_COUNT {
        let mask = (ordinal + PIREUS_GL4_SEED) % PIREUS_GL4_CANDIDATE_COUNT
        state = digest_add_i64(state, mask)
        var i: i64 = 0
        while i < 16 {
            var j: i64 = 0
            while j < 16 {
                state = digest_add_i64(state, candidate_bit(mask, i, j))
                j = j + 1
            }
            i = i + 1
        }
        ordinal = ordinal + 1
    }
    digest_finish(state)
}

fn digest_matrix_universe(universe: &GL4MatrixUniverse)
    -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, universe.encodings_scanned)
    state = digest_add_i64(state, universe.matrix_count)
    state = digest_add_i64(state, universe.bfs_count)
    state = digest_add_i64(state, universe.set_mismatches)
    state = digest_add_i64(state, universe.bfs_noninvertible)
    state = digest_add_bool(state, universe.bfs_overflow)
    state = digest_add_bool(state, universe.identity_present)
    state = digest_add_bool(state, universe.sorted_unique)
    var index: i64 = 0
    while index < universe.matrix_count {
        state = digest_add_i64(state, universe.codes[index])
        index = index + 1
    }
    digest_finish(state)
}

fn digest_gauge(gauge: &GL4GaugeCertificate)
    -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, gauge.gauge_functions)
    state = digest_add_i64(state, gauge.kernel_count)
    state = digest_add_i64(state, gauge.distinct_actions)
    state = digest_add_i64(state, gauge.tree_edges)
    state = digest_add_bool(state, gauge.quotient_exact)
    var mask: i64 = 0
    while mask < PIREUS_GL4_GAUGE_COUNT {
        state = digest_add_i64(state, mask)
        state = digest_add_bool(state, gauge_is_kernel(mask))
        mask = mask + 1
    }
    digest_finish(state)
}

fn digest_corpus(corpus: &GL4CorpusKeys)
    -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    var corpus_id: i64 = 1
    while corpus_id <= PIREUS_GL4_CORPUS_COUNT {
        state = digest_add_i64(state, corpus_id)
        var i: i64 = 0
        while i < 16 {
            var j: i64 = 0
            while j < 16 {
                state = digest_add_i64(state, corpus_bit(corpus_id, i, j))
                j = j + 1
            }
            i = i + 1
        }
        let key = corpus_key_by_id(corpus, corpus_id)
        state = digest_add_key(state, &key)
        corpus_id = corpus_id + 1
    }
    digest_finish(state)
}

fn digest_search(search: &GL4SearchCertificate)
    -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, search.candidates_evaluated)
    state = digest_add_i64(state, search.corpus_canonicalized)
    state = digest_add_i64(state, search.matrices_per_table)
    state = digest_add_i64(state, search.linear_swap_actions_per_table)
    var ordinal: i64 = 0
    while ordinal < PIREUS_GL4_CANDIDATE_COUNT {
        state = digest_add_i64(state, ordinal)
        state = digest_add_i64(state, search.candidate_masks[ordinal])
        state = digest_add_i64(state, search.candidate_distances[ordinal])
        state = digest_add_i64(state, search.candidate_matrices[ordinal])
        state = digest_add_bool(state, search.candidate_swaps[ordinal])
        state = digest_add_i64(state, search.candidate_nearest_corpus[ordinal])
        state = digest_add_bool(state, search.candidate_equivalent[ordinal])
        state = digest_add_i64(
            state, search.candidate_equivalence_classes[ordinal])
        var word: i64 = 0
        while word < 8 {
            state = digest_add_i64(
                state, search.candidate_canonical_digest_words[ordinal * 8 + word])
            word = word + 1
        }
        ordinal = ordinal + 1
    }
    state = digest_add_i64(state, search.candidate_equivalence_class_count)
    var corpus_word: i64 = 0
    while corpus_word < 24 {
        state = digest_add_i64(
            state, search.corpus_canonical_digest_words[corpus_word])
        corpus_word = corpus_word + 1
    }
    state = digest_add_i64(state, search.selected.generation_ordinal)
    state = digest_add_i64(state, search.selected.phase_mask)
    state = digest_add_i64(state, search.selected.canonical_matrix)
    state = digest_add_bool(state, search.selected.canonical_swap)
    state = digest_add_i64(
        state, search.selected.canonical_quotient_distance)
    state = digest_add_i64(state, search.selected.nearest_corpus_id)
    state = digest_add_bool(state, search.selected.equivalent_to_corpus)
    state = digest_add_bool(
        state, search.selected.declared_gl4_gauge_inequivalence)
    digest_finish(state)
}

fn digest_candidate(candidate: &GL4GeneratedCandidate, raw: &GL4SignTable)
    -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, candidate.generation_ordinal)
    state = digest_add_i64(state, candidate.phase_mask)
    state = digest_add_i64(state, candidate.canonical_matrix)
    state = digest_add_bool(state, candidate.canonical_swap)
    state = digest_add_i64(state, candidate.canonical_quotient_distance)
    state = digest_add_i64(state, candidate.nearest_corpus_id)
    state = digest_add_bool(state, candidate.equivalent_to_corpus)
    state = digest_add_bool(
        state, candidate.declared_gl4_gauge_inequivalence)
    var index: i64 = 0
    while index < 256 {
        state = digest_add_i64(state, raw.cells[index])
        index = index + 1
    }
    digest_finish(state)
}

fn digest_canonical(key: &GL4CanonicalKey)
    -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    digest_finish(digest_add_semantic_key(sha256_init(), key))
}

fn digest_witness(witness: &GL4InequivalenceWitness)
    -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_bool(state, witness.present)
    state = digest_add_i64(state, witness.corpus_id)
    state = digest_add_i64(state, witness.i)
    state = digest_add_i64(state, witness.j)
    state = digest_add_i64(state, witness.candidate_sign)
    state = digest_add_i64(state, witness.corpus_sign)
    state = digest_add_i64(state, witness.canonical_quotient_distance)
    digest_finish(state)
}

fn create_receipt(
    request: &GL4AuthorityRequest,
    group: &GL4GroupCertificate,
    gauge: &GL4GaugeCertificate,
    search: &GL4SearchCertificate,
    gauge_failures: i64,
    generator_failures: i64,
) -> GL4NoveltyReceipt {
    let witnessed = group.complete && gauge.quotient_exact &&
        search.candidates_evaluated == PIREUS_GL4_CANDIDATE_COUNT &&
        search.corpus_canonicalized == PIREUS_GL4_CORPUS_COUNT &&
        gauge_failures == 0 && generator_failures == 0 &&
        search.selected.declared_gl4_gauge_inequivalence
    GL4NoveltyReceipt {
        schema: PIREUS_GL4_GENESIS_SCHEMA,
        producer_language: request.producer_language,
        producer_role: request.producer_role,
        stage: request.stage,
        grammar_hash_bound: true,
        matrix_hash_bound: true,
        gauge_hash_bound: true,
        corpus_hash_bound: true,
        declared_corpus_only: true,
        declared_grammar_exhaustive: true,
        all_sign_tables_exhausted: false,
        base_twist_assumed: true,
        exhaustive_search: witnessed,
        relative_semantic_novelty: witnessed,
        declared_gl4_gauge_inequivalence: witnessed,
        relative_monomial_gauge_novelty: witnessed,
        relative_algebraic_novelty: false,
        algebra_isomorphism_complete: false,
        quotient_distance_not_orbit_hamming: true,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        external_prior_art_complete: false,
        source_hash_bound: false,
        semantics_hash_bound: false,
        receipt_frozen: false,
        receipt_admitted: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_count: 0,
        parity_open: false,
        claim_ready: false,
    }
}

fn digest_receipt(
    receipt: &GL4NoveltyReceipt,
    grammar_digest: &GL4GenesisDigest,
    matrix_digest: &GL4GenesisDigest,
    gauge_digest: &GL4GenesisDigest,
    corpus_digest: &GL4GenesisDigest,
    search_digest: &GL4GenesisDigest,
    candidate_digest: &GL4GenesisDigest,
    canonical_digest: &GL4GenesisDigest,
    witness_digest: &GL4GenesisDigest,
) -> GL4GenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, receipt.schema)
    state = digest_add_i64(state, receipt.producer_language)
    state = digest_add_i64(state, receipt.producer_role)
    state = digest_add_i64(state, receipt.stage)
    state = digest_add_bool(state, receipt.grammar_hash_bound)
    state = digest_add_bool(state, receipt.matrix_hash_bound)
    state = digest_add_bool(state, receipt.gauge_hash_bound)
    state = digest_add_bool(state, receipt.corpus_hash_bound)
    state = digest_add_bool(state, receipt.declared_corpus_only)
    state = digest_add_bool(state, receipt.declared_grammar_exhaustive)
    state = digest_add_bool(state, receipt.all_sign_tables_exhausted)
    state = digest_add_bool(state, receipt.base_twist_assumed)
    state = digest_add_bool(state, receipt.exhaustive_search)
    state = digest_add_bool(state, receipt.relative_semantic_novelty)
    state = digest_add_bool(
        state, receipt.declared_gl4_gauge_inequivalence)
    state = digest_add_bool(state, receipt.relative_monomial_gauge_novelty)
    state = digest_add_bool(state, receipt.relative_algebraic_novelty)
    state = digest_add_bool(state, receipt.algebra_isomorphism_complete)
    state = digest_add_bool(
        state, receipt.quotient_distance_not_orbit_hamming)
    state = digest_add_bool(state, receipt.algorithmic_novelty)
    state = digest_add_bool(state, receipt.material_novelty)
    state = digest_add_bool(state, receipt.scientific_novelty)
    state = digest_add_bool(state, receipt.global_novelty)
    state = digest_add_bool(state, receipt.historical_novelty)
    state = digest_add_bool(state, receipt.priority_claim)
    state = digest_add_bool(state, receipt.external_prior_art_complete)
    state = digest_add_bool(state, receipt.source_hash_bound)
    state = digest_add_bool(state, receipt.semantics_hash_bound)
    state = digest_add_bool(state, receipt.receipt_frozen)
    state = digest_add_bool(state, receipt.receipt_admitted)
    state = digest_add_bool(state, receipt.formal_parity_open)
    state = digest_add_bool(state, receipt.effect_parity_open)
    state = digest_add_i64(state, receipt.material_parity_count)
    state = digest_add_bool(state, receipt.parity_open)
    state = digest_add_bool(state, receipt.claim_ready)
    state = digest_add_digest(state, grammar_digest)
    state = digest_add_digest(state, matrix_digest)
    state = digest_add_digest(state, gauge_digest)
    state = digest_add_digest(state, corpus_digest)
    state = digest_add_digest(state, search_digest)
    state = digest_add_digest(state, candidate_digest)
    state = digest_add_digest(state, canonical_digest)
    state = digest_add_digest(state, witness_digest)
    digest_finish(state)
}

pub fn pireus_gl4_genesis_digest_nonzero(digest: &GL4GenesisDigest) -> bool
with Mut {
    var index: i64 = 0
    while index < 8 {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

pub fn pireus_operator_genesis_gl4_evaluate(
    request: &GL4AuthorityRequest,
) -> GL4GenesisResult with Mut, Panic, Div, Epistemic {
    let error = request_error(request)
    let universe = build_matrix_universe()
    let group = group_certificate(&universe)
    let gauge = gauge_certificate()
    let work = run_search(&universe)
    let gauge_failures = exhaustive_gauge_invariance_failures(&work.selected_raw)
    let generator_failures = generator_invariance_failures(
        &work.selected_raw, &work.selected_key, &universe)
    let witness = build_witness(&work)
    let selected_fingerprint = fingerprint(&work.selected_key)
    let negatives = exercise_negatives()
    let receipt = create_receipt(
        request, &group, &gauge, &work.search,
        gauge_failures, generator_failures)

    let grammar_digest = digest_grammar()
    let matrix_digest = digest_matrix_universe(&universe)
    let gauge_digest = digest_gauge(&gauge)
    let corpus_digest = digest_corpus(&work.corpus)
    let search_digest = digest_search(&work.search)
    let candidate_digest = digest_candidate(
        &work.search.selected, &work.selected_raw)
    let canonical_digest = digest_canonical(&work.selected_key)
    let witness_digest = digest_witness(&witness)
    let receipt_digest = digest_receipt(
        &receipt, &grammar_digest, &matrix_digest, &gauge_digest,
        &corpus_digest, &search_digest, &candidate_digest,
        &canonical_digest, &witness_digest)

    var failures: i64 = 0
    if error != PIREUS_GL4_OK { failures = failures + 1 }
    if !group.complete || !gauge.quotient_exact {
        failures = failures + 1
    }
    if work.search.candidates_evaluated != PIREUS_GL4_CANDIDATE_COUNT ||
        work.search.corpus_canonicalized != PIREUS_GL4_CORPUS_COUNT ||
        work.search.matrices_per_table != PIREUS_GL4_MATRIX_COUNT ||
        work.search.linear_swap_actions_per_table !=
            PIREUS_GL4_LINEAR_SWAP_ACTIONS || !work.selected_key.valid {
        failures = failures + 1
    }
    if work.search.candidate_equivalence_class_count <= 0 ||
        work.search.candidate_equivalence_class_count >
            PIREUS_GL4_CANDIDATE_COUNT {
        failures = failures + 1
    }
    if gauge_failures != 0 || generator_failures != 0 {
        failures = failures + 1
    }
    if work.search.selected.equivalent_to_corpus ||
        !work.search.selected.declared_gl4_gauge_inequivalence ||
        work.search.selected.canonical_quotient_distance <= 0 ||
        !witness.present {
        failures = failures + 1
    }
    if selected_fingerprint.positive_count +
        selected_fingerprint.negative_count != 256 {
        failures = failures + 1
    }
    if negatives.passed != negatives.total { failures = failures + 1 }
    if !receipt.relative_semantic_novelty ||
        !receipt.declared_gl4_gauge_inequivalence ||
        !receipt.relative_monomial_gauge_novelty ||
        !receipt.declared_corpus_only ||
        !receipt.declared_grammar_exhaustive ||
        receipt.all_sign_tables_exhausted || !receipt.base_twist_assumed ||
        receipt.relative_algebraic_novelty ||
        receipt.algebra_isomorphism_complete ||
        !receipt.quotient_distance_not_orbit_hamming ||
        receipt.algorithmic_novelty || receipt.material_novelty ||
        receipt.scientific_novelty || receipt.global_novelty ||
        receipt.historical_novelty || receipt.priority_claim ||
        receipt.source_hash_bound || receipt.semantics_hash_bound ||
        receipt.receipt_frozen || receipt.receipt_admitted ||
        receipt.parity_open || receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_gl4_genesis_digest_nonzero(&grammar_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&matrix_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&gauge_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&corpus_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&search_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&candidate_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&canonical_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&witness_digest) ||
        !pireus_gl4_genesis_digest_nonzero(&receipt_digest) {
        failures = failures + 1
    }
    GL4GenesisResult {
        valid: failures == 0,
        error: error,
        group: group,
        gauge: gauge,
        search: work.search,
        selected_key: work.selected_key,
        witness: witness,
        fingerprint: selected_fingerprint,
        gauge_invariance_checks: PIREUS_GL4_GAUGE_COUNT,
        gauge_invariance_failures: gauge_failures,
        generator_invariance_checks: 5,
        generator_invariance_failures: generator_failures,
        negatives: negatives,
        receipt: receipt,
        grammar_digest: grammar_digest,
        matrix_digest: matrix_digest,
        gauge_digest: gauge_digest,
        corpus_digest: corpus_digest,
        search_digest: search_digest,
        candidate_digest: candidate_digest,
        canonical_digest: canonical_digest,
        witness_digest: witness_digest,
        receipt_digest: receipt_digest,
        failures: failures,
    }
}

fn gl4_digest_matches(
    digest: &GL4GenesisDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if digest.words[word] != expected[word] { return false }
        word = word + 1
    }
    true
}

fn gl4_expected_class_digest_word(class_id: i64, word: i64)
    -> i64 with Panic {
    let class_0: [i64; 8] = [
        2760106619, 4068173581, 1397156592, 4034672790,
        965532095, 702338662, 855013530, 3853629388
    ]
    let class_1: [i64; 8] = [
        3232950120, 1045321158, 2021165847, 1956050805,
        478117551, 1477496824, 4208277146, 2012443260
    ]
    let class_2: [i64; 8] = [
        1182811649, 3849587124, 3518287297, 2077484926,
        2890069610, 716080654, 1746029927, 2292003081
    ]
    let class_3: [i64; 8] = [
        4064601639, 2277203810, 2831905647, 1610215288,
        2814312291, 2238388768, 124481399, 1587165752
    ]
    if class_id == 0 { return class_0[word] }
    if class_id == 1 { return class_1[word] }
    if class_id == 2 { return class_2[word] }
    class_3[word]
}

fn gl4_expected_corpus_digest_word(corpus_id: i64, word: i64)
    -> i64 with Panic {
    let corpus_1: [i64; 8] = [
        225535035, 4204842351, 280377562, 2703759856,
        437217875, 2692232683, 290663237, 3985678916
    ]
    let corpus_2: [i64; 8] = [
        3232950120, 1045321158, 2021165847, 1956050805,
        478117551, 1477496824, 4208277146, 2012443260
    ]
    let corpus_3: [i64; 8] = [
        4162798415, 1820772647, 1381549159, 1894276970,
        3726495408, 772145684, 2399744598, 3749214944
    ]
    if corpus_id == 1 { return corpus_1[word] }
    if corpus_id == 2 { return corpus_2[word] }
    corpus_3[word]
}

/// Exact v1 result admitted only after Sounio produced the first transcript.
pub fn pireus_operator_genesis_gl4_frozen_mismatch_code(
    result: &GL4GenesisResult,
) -> i64 with Mut, Panic {
    if !result.valid || result.error != PIREUS_GL4_OK ||
        result.failures != 0 ||
        result.group.encodings_scanned != PIREUS_GL4_MATRIX_ENCODINGS ||
        result.group.matrix_count != PIREUS_GL4_MATRIX_COUNT ||
        result.group.bfs_count != PIREUS_GL4_MATRIX_COUNT ||
        result.group.set_mismatches != 0 ||
        result.group.bfs_noninvertible != 0 || result.group.bfs_overflow ||
        !result.group.identity_present || !result.group.sorted_unique ||
        result.group.operand_orders != PIREUS_GL4_SWAP_COUNT ||
        result.group.linear_swap_actions != PIREUS_GL4_LINEAR_SWAP_ACTIONS ||
        PIREUS_GL4_DECLARED_ACTION_UNIVERSE != 82575360 ||
        !result.group.complete {
        return 1
    }
    if result.gauge.gauge_functions != PIREUS_GL4_GAUGE_COUNT ||
        result.gauge.kernel_count != PIREUS_GL4_GAUGE_KERNEL_COUNT ||
        result.gauge.distinct_actions != PIREUS_GL4_GAUGE_ACTION_COUNT ||
        result.gauge.tree_edges != 11 || !result.gauge.quotient_exact ||
        result.gauge_invariance_checks != PIREUS_GL4_GAUGE_COUNT ||
        result.gauge_invariance_failures != 0 ||
        result.generator_invariance_checks != 5 ||
        result.generator_invariance_failures != 0 {
        return 2
    }

    let expected_masks: [i64; 16] = [
        9, 10, 11, 12, 13, 14, 15, 0,
        1, 2, 3, 4, 5, 6, 7, 8
    ]
    let expected_distances: [i64; 16] = [
        96, 96, 96, 96, 96, 96, 96, 0,
        96, 96, 96, 96, 96, 96, 96, 112
    ]
    let expected_matrices: [i64; 16] = [
        59041, 58906, 59051, 57706, 59047, 59002, 59053, 4953,
        58207, 58357, 58202, 61237, 58204, 58309, 58201, 62024
    ]
    let expected_classes: [i64; 16] = [
        0, 0, 0, 0, 0, 0, 0, 1,
        2, 2, 2, 2, 2, 2, 2, 3
    ]
    if result.search.candidates_evaluated != PIREUS_GL4_CANDIDATE_COUNT ||
        result.search.corpus_canonicalized != PIREUS_GL4_CORPUS_COUNT ||
        result.search.matrices_per_table != PIREUS_GL4_MATRIX_COUNT ||
        result.search.linear_swap_actions_per_table !=
            PIREUS_GL4_LINEAR_SWAP_ACTIONS ||
        result.search.candidate_equivalence_class_count != 4 {
        return 3
    }
    var ordinal: i64 = 0
    while ordinal < 16 {
        let expected_class = expected_classes[ordinal]
        if result.search.candidate_masks[ordinal] != expected_masks[ordinal] ||
            result.search.candidate_distances[ordinal] !=
                expected_distances[ordinal] ||
            result.search.candidate_matrices[ordinal] !=
                expected_matrices[ordinal] ||
            result.search.candidate_swaps[ordinal] ||
            result.search.candidate_nearest_corpus[ordinal] !=
                (if ordinal == 15 { 1 } else { 2 }) ||
            result.search.candidate_equivalent[ordinal] != (ordinal == 7) ||
            result.search.candidate_equivalence_classes[ordinal] !=
                expected_class {
            return 4
        }
        var word: i64 = 0
        while word < 8 {
            if result.search.candidate_canonical_digest_words[
                    ordinal * 8 + word] !=
                gl4_expected_class_digest_word(expected_class, word) {
                return 5
            }
            word = word + 1
        }
        ordinal = ordinal + 1
    }
    var corpus_id: i64 = 1
    while corpus_id <= PIREUS_GL4_CORPUS_COUNT {
        var word: i64 = 0
        while word < 8 {
            if result.search.corpus_canonical_digest_words[
                    (corpus_id - 1) * 8 + word] !=
                gl4_expected_corpus_digest_word(corpus_id, word) {
                return 6
            }
            word = word + 1
        }
        corpus_id = corpus_id + 1
    }

    let selected = &result.search.selected
    if selected.generation_ordinal != 15 || selected.phase_mask != 8 ||
        selected.canonical_matrix != 62024 || selected.canonical_swap ||
        selected.canonical_quotient_distance != 112 ||
        selected.nearest_corpus_id != PIREUS_GL4_CORPUS_UNTWISTED_XOR ||
        selected.equivalent_to_corpus ||
        !selected.declared_gl4_gauge_inequivalence ||
        !result.selected_key.valid ||
        result.selected_key.matrix_code != 62024 ||
        result.selected_key.swap_operands ||
        result.selected_key.actions_considered !=
            PIREUS_GL4_LINEAR_SWAP_ACTIONS ||
        result.selected_key.diagonal_finalists != 1344 ||
        result.selected_key.commutator_finalists != 1344 ||
        result.selected_key.normalized_actions != 2688 {
        return 7
    }
    if !result.witness.present ||
        result.witness.corpus_id != PIREUS_GL4_CORPUS_UNTWISTED_XOR ||
        result.witness.i != 1 || result.witness.j != 6 ||
        result.witness.candidate_sign != 0 - 1 ||
        result.witness.corpus_sign != 1 ||
        result.witness.canonical_quotient_distance != 112 {
        return 8
    }
    if result.fingerprint.positive_count != 144 ||
        result.fingerprint.negative_count != 112 ||
        result.fingerprint.commutator_defects != 210 ||
        result.fingerprint.associator_defects != 1848 {
        return 9
    }
    var displacement: i64 = 0
    while displacement < 16 {
        if result.fingerprint.displacement_negative_counts[displacement] != 7 {
            return 10
        }
        displacement = displacement + 1
    }
    if result.negatives.passed != 30 || result.negatives.total != 30 ||
        !result.receipt.grammar_hash_bound ||
        !result.receipt.matrix_hash_bound ||
        !result.receipt.gauge_hash_bound ||
        !result.receipt.corpus_hash_bound ||
        !result.receipt.declared_corpus_only ||
        !result.receipt.declared_grammar_exhaustive ||
        result.receipt.all_sign_tables_exhausted ||
        !result.receipt.base_twist_assumed ||
        !result.receipt.exhaustive_search ||
        !result.receipt.relative_semantic_novelty ||
        !result.receipt.declared_gl4_gauge_inequivalence ||
        !result.receipt.relative_monomial_gauge_novelty ||
        result.receipt.relative_algebraic_novelty ||
        result.receipt.algebra_isomorphism_complete ||
        !result.receipt.quotient_distance_not_orbit_hamming ||
        result.receipt.algorithmic_novelty || result.receipt.material_novelty ||
        result.receipt.scientific_novelty || result.receipt.global_novelty ||
        result.receipt.historical_novelty || result.receipt.priority_claim ||
        result.receipt.external_prior_art_complete ||
        result.receipt.source_hash_bound || result.receipt.semantics_hash_bound ||
        result.receipt.receipt_frozen || result.receipt.receipt_admitted ||
        result.receipt.formal_parity_open || result.receipt.effect_parity_open ||
        result.receipt.material_parity_count != 0 ||
        result.receipt.parity_open || result.receipt.claim_ready {
        return 11
    }

    let expected_grammar: [i64; 8] = [
        1793770414, 3596605389, 3846498539, 3166589795,
        2873959943, 2944342869, 2969302947, 3062170044
    ]
    let expected_matrix: [i64; 8] = [
        755398037, 1851778121, 3568868165, 1717633248,
        1648359748, 313491211, 758581877, 4044503720
    ]
    let expected_gauge: [i64; 8] = [
        1111855660, 609659236, 1573782502, 1340697759,
        3221543783, 647377610, 199249447, 3451558743
    ]
    let expected_corpus: [i64; 8] = [
        955706987, 2711967393, 3947352345, 122002224,
        691029401, 3222860357, 943311825, 1012422981
    ]
    let expected_search: [i64; 8] = [
        2268389035, 570170058, 2806865214, 2789628812,
        373044869, 3367679257, 642183977, 2960017993
    ]
    let expected_candidate: [i64; 8] = [
        1354854286, 3393898007, 1657056276, 2167064108,
        3276458198, 1018008441, 1362534267, 3409201966
    ]
    let expected_canonical: [i64; 8] = [
        4064601639, 2277203810, 2831905647, 1610215288,
        2814312291, 2238388768, 124481399, 1587165752
    ]
    let expected_witness: [i64; 8] = [
        4231779539, 1525680881, 1473941873, 1998826445,
        2694657053, 2729760164, 1847567857, 3755186688
    ]
    let expected_receipt: [i64; 8] = [
        3435816126, 2853659979, 2568270999, 1766970935,
        2202081304, 3446974603, 511952213, 1138119276
    ]
    if !gl4_digest_matches(&result.grammar_digest, &expected_grammar) {
        return 12
    }
    if !gl4_digest_matches(&result.matrix_digest, &expected_matrix) { return 13 }
    if !gl4_digest_matches(&result.gauge_digest, &expected_gauge) { return 14 }
    if !gl4_digest_matches(&result.corpus_digest, &expected_corpus) { return 15 }
    if !gl4_digest_matches(&result.search_digest, &expected_search) { return 16 }
    if !gl4_digest_matches(&result.candidate_digest, &expected_candidate) {
        return 17
    }
    if !gl4_digest_matches(&result.canonical_digest, &expected_canonical) {
        return 18
    }
    if !gl4_digest_matches(&result.witness_digest, &expected_witness) { return 19 }
    if !gl4_digest_matches(&result.receipt_digest, &expected_receipt) { return 20 }
    0
}

pub fn pireus_operator_genesis_gl4_matches_frozen_semantics(
    result: &GL4GenesisResult,
) -> bool with Mut, Panic {
    pireus_operator_genesis_gl4_frozen_mismatch_code(result) == 0
}
