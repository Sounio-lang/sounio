//! Sounio authority for Operator Genesis under GL(4,2), sign gauges, and swap.
//!
//! Commit fd2ff88871 preserves the first executable with no frozen winner or
//! digest. This source now also carries the subsequently admitted v1 matcher.
//! The search itself remains exhaustive and emits only bounded monomial-gauge
//! novelty.

use algebra::cayley_dickson::cd_sigma
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

