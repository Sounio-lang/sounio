// Observed V14 plan matchers added only after the first Sounio transcript.

use hardware::pireus::multiprobe_block_certification::{
    PIREUS_MBC_OK,
    PIREUS_MBC_PROBES,
    PIREUS_MBC_ACTIONS,
    PIREUS_MBC_BLOCKS,
    PIREUS_MBC_LOGICAL_JOBS,
    PireusMbcDigest,
    PireusMbcSummary,
}

fn mbc_frozen_strategy_words() -> [i64; 8] {
    [823527488, 2102981964, 689417732, 3282026123,
     3002666996, 863528254, 1687391336, 293118144]
}

fn mbc_frozen_probe_set_words() -> [i64; 8] {
    [1774524413, 149207873, 748228234, 2614766479,
     1124825516, 2995799475, 1914376638, 1899240382]
}

fn mbc_frozen_partition_words() -> [i64; 8] {
    [3004289488, 1518364575, 1511802147, 2506712061,
     719249879, 3023923581, 158707131, 1756449447]
}

fn mbc_frozen_plan_words() -> [i64; 8] {
    [2542543081, 3697468395, 2402255633, 2739480764,
     3031823209, 3121778106, 2475718516, 1038926426]
}

fn mbc_frozen_first_address_words() -> [i64; 8] {
    [2213758423, 1767173016, 1790269097, 2268840738,
     2523897194, 1929821822, 3019705322, 2557260308]
}

fn mbc_frozen_last_address_words() -> [i64; 8] {
    [1279126273, 1683467199, 297386197, 535961805,
     872525931, 1829574328, 3372892569, 1348708610]
}

fn mbc_frozen_digest_matches(
    actual: &PireusMbcDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if actual.words[word] != expected[word] { return false }
        word = word + 1
    }
    true
}

fn mbc_frozen_false_boundaries(result: &PireusMbcSummary) -> bool {
    result.completed_blocks == 0 && result.reuse_hits == 0 &&
    result.expected_result_digests == 0 &&
    !result.actual_block_execution_complete && !result.any_block_reused &&
    !result.all_v13_probes_certified &&
    !result.deterministic_purity_formally_proved &&
    !result.material_bound_profile_instantiated &&
    !result.collision_free_semantic_identity &&
    !result.formal_parity_open && !result.effect_parity_open &&
    !result.material_parity_open && !result.denotational_parity_open &&
    !result.performance_measured && !result.speedup_admitted &&
    !result.cache_hit_rate_admitted && !result.algorithmic_novelty &&
    !result.material_novelty && !result.scientific_novelty &&
    !result.global_novelty && !result.historical_novelty &&
    !result.priority_claim && !result.claim_ready
}

pub fn pireus_mbc_frozen_mismatch_code(
    result: &PireusMbcSummary,
) -> i64 with Mut, Panic {
    if !result.valid || result.error != PIREUS_MBC_OK { return 1 }
    if !result.garden_match || !result.contract_match ||
        !result.parent_transcript_match { return 2 }
    if result.parent_records != PIREUS_MBC_PROBES ||
        result.parent_canonical_cells != PIREUS_MBC_PROBES * 256 ||
        result.parent_duplicate_contents != 0 ||
        result.parent_parse_failures != 0 ||
        result.partition_blocks != PIREUS_MBC_BLOCKS ||
        result.partition_views != PIREUS_MBC_ACTIONS ||
        result.partition_failures != 0 ||
        result.work_domains != PIREUS_MBC_LOGICAL_JOBS ||
        result.work_addresses != PIREUS_MBC_LOGICAL_JOBS ||
        result.domain_validation_failures != 0 ||
        result.address_recomputations != PIREUS_MBC_LOGICAL_JOBS ||
        result.address_recomputation_failures != 0 { return 3 }
    if result.negative_cases_passed != 56 ||
        result.negative_cases_total != 56 { return 4 }
    let strategy = mbc_frozen_strategy_words()
    let probe_set = mbc_frozen_probe_set_words()
    let partition = mbc_frozen_partition_words()
    let plan = mbc_frozen_plan_words()
    let first_address = mbc_frozen_first_address_words()
    let last_address = mbc_frozen_last_address_words()
    if !mbc_frozen_digest_matches(&result.strategy_digest, &strategy) ||
        !mbc_frozen_digest_matches(&result.probe_set_digest, &probe_set) ||
        !mbc_frozen_digest_matches(&result.partition_digest, &partition) ||
        !mbc_frozen_digest_matches(&result.plan_digest, &plan) ||
        !mbc_frozen_digest_matches(
            &result.first_work_address, &first_address) ||
        !mbc_frozen_digest_matches(
            &result.last_work_address, &last_address) { return 5 }
    if !mbc_frozen_false_boundaries(result) { return 6 }
    0
}

pub fn pireus_mbc_matches_frozen_v14(
    result: &PireusMbcSummary,
) -> bool with Mut, Panic {
    pireus_mbc_frozen_mismatch_code(result) == 0
}

pub fn pireus_mbc_frozen_matcher_self_test() -> bool with Mut, Panic {
    let expected = mbc_frozen_strategy_words()
    let actual = PireusMbcDigest { words: expected }
    if !mbc_frozen_digest_matches(&actual, &expected) { return false }
    var sabotaged_words = expected
    sabotaged_words[0] = sabotaged_words[0] + 1
    let sabotaged = PireusMbcDigest { words: sabotaged_words }
    !mbc_frozen_digest_matches(&sabotaged, &expected)
}
