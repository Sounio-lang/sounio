//! Grammar-bounded importer for Apple's pinned MTLGPUFamily DocC JSON.
//!
//! Sounio validates the complete JSON stream, rejects duplicate object keys,
//! selects exact MTLGPUFamily reference objects, and projects vendor enum cases
//! without turning the catalog into a device-support observation.

use crypto::sha256::{
    SHA256State, SHA256Digest,
    sha256_init, sha256_update, sha256_finalize,
}
use hardware::pireus::model::{
    PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS,
    PIREUS_CLASS_EVIDENCE_ROLE, PIREUS_HAS_EVIDENCE_ROLE,
}
use hardware::pireus::execution_engine::{
    pireus_execution_engine_store,
    PIREUS_BLUEPRINT_APPLE_GPU,
}
use ontology::query::{
    TripleStore, SparqlResult,
    triple_store_add, triple_iri,
    sparql_new, sparql_select, sparql_add_pattern, sparql_execute,
    triple_pattern_new, queryterm_variable, queryterm_iri,
}

