//! Pireus semantic operation graph for the frozen bits=4 XorConvolution.
//!
//! This module binds two frozen parents and names the material-neutral DAG a
//! later target lowering must realize. It selects no instruction and records
//! no hardware observation, cost, or performance result.

use algebra::xor_convolution::{
    XorDigest, XorConvolutionResult,
    xor_convolution_evaluate, xor_convolution_matches_frozen_semantics,
}
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}
pub const PIREUS_XOR_OPERATION_BITS: i64 = 4
pub const PIREUS_XOR_OPERATION_DIMENSION: i64 = 16
pub const PIREUS_XOR_OVERLAY_GRAPH_ID: i64 = 7
pub const PIREUS_XOR_OVERLAY_OWNER_ID: i64 = 9

pub const PIREUS_XOR_NODE_XOR_PERMUTE: i64 = 1
pub const PIREUS_XOR_NODE_TWIST_APPLY: i64 = 2
pub const PIREUS_XOR_NODE_MULTIPLY: i64 = 3
pub const PIREUS_XOR_NODE_HORIZONTAL_REDUCE: i64 = 4
pub const PIREUS_XOR_NODE_OUTPUT_LANE: i64 = 5

pub const PIREUS_XOR_CAP_LANE_XOR_PERMUTE: i64 = 1
pub const PIREUS_XOR_CAP_PER_TERM_SIGN: i64 = 2
pub const PIREUS_XOR_CAP_FLOAT_MULTIPLY: i64 = 3
pub const PIREUS_XOR_CAP_FIXED_ORDER_REDUCE: i64 = 4
pub const PIREUS_XOR_CAP_OUTPUT_MATERIALIZE: i64 = 5

pub const PIREUS_XOR_TARGET_DARWIN_XEON: i64 = 1
pub const PIREUS_XOR_TARGET_APPLE_SILICON: i64 = 2
pub const PIREUS_XOR_TARGET_DGX: i64 = 3

pub const PIREUS_XOR_ACCUMULATION_ASCENDING_I: i64 = 1
pub const PIREUS_XOR_EVIDENCE_DECLARED_CANONICAL: i64 = 1
pub const PIREUS_XOR_EVIDENCE_MATERIAL_OBSERVATION: i64 = 2

pub const PIREUS_XOR_OPERATION_OK: i64 = 0
pub const PIREUS_XOR_OPERATION_ERR_PARENT: i64 = 1
pub const PIREUS_XOR_OPERATION_ERR_BITS: i64 = 2
pub const PIREUS_XOR_OPERATION_ERR_GRAPH: i64 = 3
pub const PIREUS_XOR_OPERATION_ERR_CAPABILITY: i64 = 4
pub const PIREUS_XOR_OPERATION_ERR_CLASSIFICATION: i64 = 5
pub const PIREUS_XOR_OPERATION_ERR_TARGET: i64 = 6
pub const PIREUS_XOR_OPERATION_ERR_MATERIAL: i64 = 7
pub const PIREUS_XOR_OPERATION_ERR_AUTHORITY: i64 = 8

pub struct PireusXorOperationDigest {
    pub words: [i64; 8],
}

pub struct PireusXorGraphParentReceipt {
    pub identity_module_sha256: [i64; 8],
    pub semantics_sha256: [i64; 8],
    pub authority_stream_sha256: [i64; 8],
    pub registry_digest: [i64; 8],
    pub dependency_digest: [i64; 8],
    pub lifted_graph_digest: [i64; 8],
    pub occurrence_digest: [i64; 8],
    pub collision_digest: [i64; 8],
    pub provenance_digest: [i64; 8],
    pub valid: bool,
}

pub struct PireusXorOperationGraph {
    pub overlay_graph_id: i64,
    pub overlay_owner_id: i64,
    pub node_count: i64,
    pub node_kinds: [i64; 5],
    pub node_capabilities: [i64; 5],
    pub node_fixed_order: [bool; 5],
    pub node_nonassociative_barrier: [bool; 5],
    pub edge_count: i64,
    pub edge_sources: [i64; 4],
    pub edge_targets: [i64; 4],
}

pub struct PireusXorTargetDeclarations {
    pub count: i64,
    pub target_ids: [i64; 3],
    pub canonical: [bool; 3],
    pub observed: [bool; 3],
    pub evidence_roles: [i64; 3],
    pub material_receipt_count: i64,
}

pub struct PireusXorOperationNegatives {
    pub absent_xor_parent: bool,
    pub absent_graph_parent: bool,
    pub mismatched_xor_parent: bool,
    pub mismatched_graph_parent: bool,
    pub invalid_bits: bool,
    pub topology_corruption: bool,
    pub missing_capability: bool,
    pub accumulation_order_change: bool,
    pub displacement_promotion: bool,
    pub separability_promotion: bool,
    pub cocycle_promotion: bool,
    pub associativity_promotion: bool,
    pub wht_promotion: bool,
    pub missing_darwin_xeon: bool,
    pub missing_apple_silicon: bool,
    pub missing_dgx: bool,
    pub target_observation_without_receipt: bool,
    pub material_claim_without_receipt: bool,
    pub parity_before_freeze: bool,
    pub claim_before_parity: bool,
    pub passed: i64,
    pub total: i64,
}

pub struct PireusXorOperationResult {
    pub valid: bool,
    pub error: i64,
    pub bits: i64,
    pub dimension: i64,
    pub xor_parent_frozen: bool,
    pub graph_parent_frozen: bool,
    pub xor_parent_match: bool,
    pub graph_parent_receipt_valid: bool,
    pub graph_parent: PireusXorGraphParentReceipt,
    pub graph: PireusXorOperationGraph,
    pub targets: PireusXorTargetDeclarations,
    pub output_bits: [i64; 64],
    pub output_matches_parent: bool,
    pub zero_free: bool,
    pub normalized: bool,
    pub displacement_only: bool,
    pub rank_one_separable: bool,
    pub left_square: bool,
    pub group_two_cocycle: bool,
    pub associator_defect_count: i64,
    pub nonassociative_barrier_count: i64,
    pub wht_rewrite_authorized: bool,
    pub material_observation_count: i64,
    pub lowering_count: i64,
    pub cost_record_count: i64,
    pub parent_digest: PireusXorOperationDigest,
    pub graph_digest: PireusXorOperationDigest,
    pub capability_digest: PireusXorOperationDigest,
    pub target_digest: PireusXorOperationDigest,
    pub result_digest: PireusXorOperationDigest,
    pub witness_digest: PireusXorOperationDigest,
    pub negatives: PireusXorOperationNegatives,
    pub parity_open: bool,
    pub claim_ready: bool,
    pub failures: i64,
}

pub fn pireus_xor_parent_semantics_hash() -> [i64; 8] {
    let value: [i64; 8] = [
        0xda782da9, 0x38ee5f9e, 0x0a49cb1f, 0x95dfbb6a,
        0xcac8aa70, 0x6c9eb6d7, 0x11565adc, 0xb9031502
    ]
    value
}

