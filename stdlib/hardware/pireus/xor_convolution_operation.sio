    let value: [i64; 8] = [
        0x8dc9c6c9, 0x0d4f21b1, 0x3c07d8ec, 0x3e914839,
        0xb9f3bfaa, 0x1e32f222, 0xa25bdcb2, 0x67c943cb
    ]
    value
}

