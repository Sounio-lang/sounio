//! Pireus v0 material-ontology model.
//!
//! Pireus reuses Sounio's ontology::query triple store. This first model
//! contains only synthetic capabilities used to establish the vocabulary and
//! exact-query semantics. It asserts no real processor instruction.

use ontology::query::{
    TripleStore, SparqlResult,
    triple_store_new, triple_store_add, triple_iri, triple_literal,
    sparql_new, sparql_select, sparql_add_pattern, sparql_execute,
    triple_pattern_new, queryterm_variable, queryterm_iri, queryterm_literal,
    solution_row_get,
}

// Core ontology vocabulary.
pub const PIREUS_RDF_TYPE: i64 = 1

pub const PIREUS_CLASS_ONTOLOGY_CLASS: i64 = 700000
pub const PIREUS_CLASS_CAPABILITY: i64 = 700001
pub const PIREUS_CLASS_ARCHITECTURE: i64 = 700002
pub const PIREUS_CLASS_OPERATION: i64 = 700003
pub const PIREUS_CLASS_LANE_SCOPE: i64 = 700004
pub const PIREUS_CLASS_EVIDENCE_ROLE: i64 = 700005

pub const PIREUS_HAS_ARCHITECTURE: i64 = 700101
pub const PIREUS_HAS_OPERATION: i64 = 700102
pub const PIREUS_HAS_ELEMENT_BITS: i64 = 700103
pub const PIREUS_HAS_LANES: i64 = 700104
pub const PIREUS_HAS_SOURCE_COUNT: i64 = 700105
pub const PIREUS_HAS_LANE_SCOPE: i64 = 700106
pub const PIREUS_HAS_EVIDENCE_ROLE: i64 = 700107

pub const PIREUS_ARCH_SYNTHETIC: i64 = 700201
pub const PIREUS_OP_LANE_PERMUTE: i64 = 700202
pub const PIREUS_SCOPE_INTRACHUNK: i64 = 700203
pub const PIREUS_EVIDENCE_SYNTHETIC_SOUNIO: i64 = 700204

// Literal identifiers are distinct from their numeric values. The current
// ontology query kernel matches literal identifiers exactly.
pub const PIREUS_LITERAL_1: i64 = 700301
pub const PIREUS_LITERAL_2: i64 = 700302
pub const PIREUS_LITERAL_8: i64 = 700303
pub const PIREUS_LITERAL_16: i64 = 700304
pub const PIREUS_LITERAL_64: i64 = 700305

pub const PIREUS_CAP_SYNTHETIC_F64X8_ONE_SOURCE: i64 = 700401
pub const PIREUS_CAP_SYNTHETIC_F64X8_TWO_SOURCE: i64 = 700402

fn add_capability(
    store: &TripleStore,
    capability: i64,
    source_count_literal: i64,
    source_count_value: f64,
) {
    triple_store_add(store, triple_iri(
        capability, PIREUS_RDF_TYPE, PIREUS_CLASS_CAPABILITY))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_ARCHITECTURE, PIREUS_ARCH_SYNTHETIC))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_OPERATION, PIREUS_OP_LANE_PERMUTE))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_ELEMENT_BITS, PIREUS_LITERAL_64, 64.0))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_LANES, PIREUS_LITERAL_8, 8.0))
    triple_store_add(store, triple_literal(
        capability, PIREUS_HAS_SOURCE_COUNT,
        source_count_literal, source_count_value))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_LANE_SCOPE, PIREUS_SCOPE_INTRACHUNK))
    triple_store_add(store, triple_iri(
        capability, PIREUS_HAS_EVIDENCE_ROLE,
        PIREUS_EVIDENCE_SYNTHETIC_SOUNIO))
}

/// Build the first Pireus store. Every capability is explicitly synthetic.
pub fn pireus_v0_store() -> TripleStore with Mut {
    var store = triple_store_new()

    triple_store_add(&store, triple_iri(
        PIREUS_CLASS_CAPABILITY, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS))
    triple_store_add(&store, triple_iri(
        PIREUS_CLASS_ARCHITECTURE, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS))
    triple_store_add(&store, triple_iri(
        PIREUS_CLASS_OPERATION, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS))
    triple_store_add(&store, triple_iri(
        PIREUS_CLASS_LANE_SCOPE, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS))
    triple_store_add(&store, triple_iri(
        PIREUS_CLASS_EVIDENCE_ROLE, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ONTOLOGY_CLASS))

    triple_store_add(&store, triple_iri(
        PIREUS_ARCH_SYNTHETIC, PIREUS_RDF_TYPE,
        PIREUS_CLASS_ARCHITECTURE))
    triple_store_add(&store, triple_iri(
        PIREUS_OP_LANE_PERMUTE, PIREUS_RDF_TYPE,
        PIREUS_CLASS_OPERATION))
    triple_store_add(&store, triple_iri(
        PIREUS_SCOPE_INTRACHUNK, PIREUS_RDF_TYPE,
        PIREUS_CLASS_LANE_SCOPE))
    triple_store_add(&store, triple_iri(
        PIREUS_EVIDENCE_SYNTHETIC_SOUNIO, PIREUS_RDF_TYPE,
        PIREUS_CLASS_EVIDENCE_ROLE))

    add_capability(
        &store,
        PIREUS_CAP_SYNTHETIC_F64X8_ONE_SOURCE,
        PIREUS_LITERAL_1,
        1.0,
    )
    add_capability(
        &store,
        PIREUS_CAP_SYNTHETIC_F64X8_TWO_SOURCE,
        PIREUS_LITERAL_2,
        2.0,
    )
    store
}

/// Query an exact lane-permutation capability requirement.
pub fn pireus_query_permutation(
    store: &TripleStore,
    element_bits_literal: i64,
    element_bits_value: f64,
    lanes_literal: i64,
    lanes_value: f64,
    source_count_literal: i64,
    source_count_value: f64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(PIREUS_CLASS_CAPABILITY),
    ))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_OPERATION),
        queryterm_iri(PIREUS_OP_LANE_PERMUTE),
    ))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_ELEMENT_BITS),
        queryterm_literal(element_bits_literal, element_bits_value),
    ))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_LANES),
        queryterm_literal(lanes_literal, lanes_value),
    ))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_SOURCE_COUNT),
        queryterm_literal(source_count_literal, source_count_value),
    ))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_LANE_SCOPE),
        queryterm_iri(PIREUS_SCOPE_INTRACHUNK),
    ))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0),
        queryterm_iri(PIREUS_HAS_EVIDENCE_ROLE),
        queryterm_iri(PIREUS_EVIDENCE_SYNTHETIC_SOUNIO),
    ))
    sparql_execute(store, &query)
}

pub fn pireus_result_contains(
    result: &SparqlResult,
    capability: i64,
) -> bool with Epistemic {
    let n = result.solutions.len().unwrap("pireus result length")
    for i in 0..n {
        if solution_row_get(&result.solutions[i], 0) == capability {
            return true
        }
    }
    false
}
