fn paif_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if left[i as usize] != right[i as usize] { return false }
        i = i + 1
    }
    true
}

fn paif_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var i: i64 = 0
    while i < 8 {
        bytes[i as usize] = ((value >> ((7 - i) * 8)) & 255) as u8
        i = i + 1
    }
    sha256_update(state, bytes, 8)
}

fn paif_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    paif_digest_add_i64(state, if value { 1 } else { 0 })
}

fn paif_digest_add_string(state: SHA256State, value: string) -> SHA256State
with Mut, Panic, Div {
    let size = str_len(value)
    var next = paif_digest_add_i64(state, size)
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var byte = str_char_at(value, pos + i) as i64
            if byte < 0 { byte = byte + 256 }
            window[i as usize] = byte as u8
            i = i + 1
        }
        next = sha256_update(next, window, count as i32)
        pos = pos + count
    }
    next
}

fn paif_digest_add_words(
    state: SHA256State, words: &[i64; 8],
) -> SHA256State with Mut, Panic, Div {
    var next = state
    var i: i64 = 0
    while i < 8 {
        next = paif_digest_add_i64(next, words[i as usize])
        i = i + 1
    }
    next
}

fn paif_digest_finish(state: SHA256State) -> PireusAppleInterfaceDigest
with Mut, Panic, Div {
    let finalized = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var i: i64 = 0
    while i < 8 {
        var word: i64 = 0
        var j: i64 = 0
        while j < 4 {
            word = word * 256 + sha256_digest_byte(finalized, i * 4 + j)
            j = j + 1
        }
        words[i as usize] = word
        i = i + 1
    }
    PireusAppleInterfaceDigest { words: words }
}

fn paif_file_hash(path: string) -> PireusAppleInterfaceDigest
with IO, Mut, Panic, Div, Alloc {
    let size = file_size(path)
    if size <= 0 || size >= 1048576 {
        return PireusAppleInterfaceDigest { words: [0; 8] }
    }
    let raw = read_file(path)
    var state = sha256_init()
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var byte = raw[(pos + i) as usize] as i64
            if byte < 0 { byte = byte + 256 }
            window[i as usize] = byte as u8
            i = i + 1
        }
        state = sha256_update(state, window, count as i32)
        pos = pos + count
    }
    paif_digest_finish(state)
}

fn paif_expected_parent_hash(index: i64) -> [i64; 8] {
    if index == 0 { return [0x19482cbc, 0xeb1bf7f3, 0xf7236446, 0xebeff8b7, 0xd46c7b99, 0x249ba591, 0x0ece145f, 0xad641dd7] }
    if index == 1 { return [0x3a92553a, 0xae0c4a96, 0x06f4964e, 0x1613a314, 0x52b7fb4d, 0x197b128d, 0xbb73cc24, 0xb87b550e] }
    if index == 2 { return [0x9bd767db, 0x814e47bf, 0xc087e07c, 0x0f9ff33b, 0x65faea5b, 0x885ae0f8, 0xed3a6e64, 0x6c015e6d] }
    if index == 3 { return [0x0ee12f35, 0x02efb260, 0x56bdbcf8, 0x50360c0a, 0x5df72762, 0x7a3c6749, 0x9d363744, 0xf7c73272] }
    if index == 4 { return [0xcf445569, 0x0426038c, 0xc7477b67, 0x3bcf763e, 0x9755e814, 0x7f1ff55e, 0x88208682, 0x6626482b] }
    [0; 8]
}

fn paif_parent_path(
    paths: &PireusAppleInterfaceParentPaths, index: i64,
) -> string {
    if index == 0 { return paths.garden }
    if index == 1 { return paths.request_source }
    if index == 2 { return paths.request_semantics }
    if index == 3 { return paths.request_receipt }
    paths.request_evidence
}

fn paif_parent_match_mask(paths: &PireusAppleInterfaceParentPaths) -> i64
with IO, Mut, Panic, Div, Alloc {
    var mask: i64 = 0
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT {
        let actual = paif_file_hash(paif_parent_path(paths, i))
        let expected = paif_expected_parent_hash(i)
        if paif_hash_equal(&actual.words, &expected) {
            mask = mask | (1 << i)
        }
        i = i + 1
    }
    mask
}

pub fn pireus_apple_interface_parent_file_matches(
    mask: i64, index: i64,
) -> bool {
    index >= 0 && index < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT &&
        (mask & (1 << index)) != 0
}

fn paif_all_parents_match(mask: i64) -> bool {
    mask == (1 << PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT) - 1
}

fn paif_all_parent_drifts_detected(mask: i64) -> bool with Mut {
    if !paif_all_parents_match(mask) { return false }
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT {
        if paif_all_parents_match(mask ^ (1 << i)) { return false }
        i = i + 1
    }
    true
}

fn paif_parent_manifest_digest(
    paths: &PireusAppleInterfaceParentPaths,
) -> PireusAppleInterfaceDigest with IO, Mut, Panic, Div, Alloc {
    var state = sha256_init()
    state = paif_digest_add_string(
        state, "pireus.apple-cpu-interface-feasibility.parents.v0")
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT {
        let actual = paif_file_hash(paif_parent_path(paths, i))
        state = paif_digest_add_i64(state, i)
        state = paif_digest_add_words(state, &actual.words)
        i = i + 1
    }
    paif_digest_finish(state)
}

fn paif_request_ref(
    parent: &PireusAppleCpuLatencyRequestResult,
) -> PireusAppleCpuLatencyRequestRef {
    PireusAppleCpuLatencyRequestRef {
        request_id: parent.binding.template_request_id,
        target_id: parent.binding.target_id,
        machine_id: parent.binding.machine_id,
        engine_id: parent.binding.engine_id,
        engine_kind: parent.binding.engine_kind,
        isa_id: parent.binding.isa_id,
        subject_kind: parent.request.subject_kind,
        subject_node: parent.request.subject_node,
        quantity: parent.request.quantity,
        unit: parent.request.unit,
        scope: parent.request.scope,
        statistic: parent.request.statistic,
        requested_samples: parent.request.requested_sample_count,
        requested_warmups: parent.request.requested_warmup_count,
        required_environment_mask: parent.request.required_environment_mask,
    }
}

pub fn pireus_apple_interface_request_ref_valid(
    request: &PireusAppleCpuLatencyRequestRef, parent_live: bool,
) -> bool {
    parent_live &&
        request.request_id == PIREUS_APPLE_CPU_LATENCY_REQUEST_ID &&
        request.target_id == PIREUS_TARGET_APPLE_SILICON &&
        request.machine_id == PIREUS_MACHINE_APPLE_MAC17_7 &&
        request.engine_id == PIREUS_ENGINE_CPU_APPLE_M5_MAX &&
        request.engine_kind == PIREUS_ENGINE_KIND_CPU &&
        request.isa_id == PIREUS_ENGINE_ISA_AARCH64 &&
        request.subject_kind == PIREUS_COST_SUBJECT_LOWERING_NODE &&
        request.subject_node == 0 &&
        request.quantity == PIREUS_COST_DEPENDENCY_LATENCY &&
        request.unit == PIREUS_COST_UNIT_CYCLE &&
        request.scope == PIREUS_COST_SCOPE_DEPENDENCY_CHAIN &&
        request.statistic == PIREUS_COST_STAT_MEDIAN &&
        request.requested_samples == 1001 &&
        request.requested_warmups == 128 &&
        request.required_environment_mask == 2047
}

fn paif_requirement(
    request: &PireusAppleCpuLatencyRequestRef,
) -> PireusMeasurementInterfaceRequirement {
    PireusMeasurementInterfaceRequirement {
        request: PireusAppleCpuLatencyRequestRef {
            request_id: request.request_id,
            target_id: request.target_id,
            machine_id: request.machine_id,
            engine_id: request.engine_id,
            engine_kind: request.engine_kind,
            isa_id: request.isa_id,
            subject_kind: request.subject_kind,
            subject_node: request.subject_node,
            quantity: request.quantity,
            unit: request.unit,
            scope: request.scope,
            statistic: request.statistic,
            requested_samples: request.requested_samples,
            requested_warmups: request.requested_warmups,
            required_environment_mask: request.required_environment_mask,
        },
        required_native_unit: PIREUS_COST_UNIT_CYCLE,
        required_counter_domain:
            PIREUS_INTERFACE_COUNTER_DOMAIN_EXECUTING_CPU_CORE,
        required_read_boundary:
            PIREUS_INTERFACE_READ_SERIALIZED_BEFORE_AFTER,
        required_multiplexing: PIREUS_INTERFACE_MULTIPLEXING_DISALLOWED,
        required_core_binding:
            PIREUS_INTERFACE_CORE_MIGRATION_DETECTED_REJECTED,
        required_counter_width_evidenced: true,
        required_wrap_rule_evidenced: true,
        required_privilege_evidenced: true,
        required_event_semantics_evidenced: true,
        required_binary_hash_bound: true,
        required_command_hash_bound: true,
        required_environment_supplement: true,
    }
}

pub fn pireus_apple_interface_requirement_valid(
    requirement: &PireusMeasurementInterfaceRequirement,
    parent_live: bool,
) -> bool {
    pireus_apple_interface_request_ref_valid(&requirement.request, parent_live) &&
        requirement.required_native_unit == PIREUS_COST_UNIT_CYCLE &&
        requirement.required_counter_domain ==
            PIREUS_INTERFACE_COUNTER_DOMAIN_EXECUTING_CPU_CORE &&
        requirement.required_read_boundary ==
            PIREUS_INTERFACE_READ_SERIALIZED_BEFORE_AFTER &&
        requirement.required_multiplexing ==
            PIREUS_INTERFACE_MULTIPLEXING_DISALLOWED &&
        requirement.required_core_binding ==
            PIREUS_INTERFACE_CORE_MIGRATION_DETECTED_REJECTED &&
        requirement.required_counter_width_evidenced &&
        requirement.required_wrap_rule_evidenced &&
        requirement.required_privilege_evidenced &&
        requirement.required_event_semantics_evidenced &&
        requirement.required_binary_hash_bound &&
        requirement.required_command_hash_bound &&
        requirement.required_environment_supplement
}

fn paif_manifest() -> PireusInterfaceCandidateManifest {
    PireusInterfaceCandidateManifest {
        families: [
            PIREUS_INTERFACE_FAMILY_CORE_CYCLE_COUNTER,
            PIREUS_INTERFACE_FAMILY_PROCESS_PMU_CYCLE_EVENT,
            PIREUS_INTERFACE_FAMILY_SYSTEM_TRACE_CYCLE_EVENT,
            PIREUS_INTERFACE_FAMILY_ARCHITECTURAL_TIMER_TICK,
            PIREUS_INTERFACE_FAMILY_OS_MONOTONIC_TIME,
            PIREUS_INTERFACE_FAMILY_FREQUENCY_DERIVED_ESTIMATE
        ],
        family_count: PIREUS_APPLE_INTERFACE_FAMILY_COUNT,
        closed: false,
    }
}

pub fn pireus_apple_interface_family_valid(family: i64) -> bool {
    family == PIREUS_INTERFACE_FAMILY_CORE_CYCLE_COUNTER ||
        family == PIREUS_INTERFACE_FAMILY_PROCESS_PMU_CYCLE_EVENT ||
        family == PIREUS_INTERFACE_FAMILY_SYSTEM_TRACE_CYCLE_EVENT ||
        family == PIREUS_INTERFACE_FAMILY_ARCHITECTURAL_TIMER_TICK ||
        family == PIREUS_INTERFACE_FAMILY_OS_MONOTONIC_TIME ||
        family == PIREUS_INTERFACE_FAMILY_FREQUENCY_DERIVED_ESTIMATE
}

pub fn pireus_apple_interface_manifest_valid(
    manifest: &PireusInterfaceCandidateManifest,
) -> bool with Mut, Panic {
    let expected: [i64; 6] = [
        PIREUS_INTERFACE_FAMILY_CORE_CYCLE_COUNTER,
        PIREUS_INTERFACE_FAMILY_PROCESS_PMU_CYCLE_EVENT,
        PIREUS_INTERFACE_FAMILY_SYSTEM_TRACE_CYCLE_EVENT,
        PIREUS_INTERFACE_FAMILY_ARCHITECTURAL_TIMER_TICK,
        PIREUS_INTERFACE_FAMILY_OS_MONOTONIC_TIME,
        PIREUS_INTERFACE_FAMILY_FREQUENCY_DERIVED_ESTIMATE
    ]
    if manifest.family_count != PIREUS_APPLE_INTERFACE_FAMILY_COUNT ||
        manifest.closed {
        return false
    }
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_FAMILY_COUNT {
        if manifest.families[i as usize] != expected[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

fn paif_assessment(
    request: &PireusAppleCpuLatencyRequestRef,
    manifest: &PireusInterfaceCandidateManifest,
) -> PireusInterfaceAssessmentRequest {
    PireusInterfaceAssessmentRequest {
        request_id: request.request_id,
        machine_id: request.machine_id,
        engine_id: request.engine_id,
        family_count: manifest.family_count,
        material_candidate_count: 0,
        execution_authorization_id: 0,
        value_present: false,
    }
}

pub fn pireus_apple_interface_assessment_valid(
    assessment: &PireusInterfaceAssessmentRequest,
    requirement: &PireusMeasurementInterfaceRequirement,
    manifest: &PireusInterfaceCandidateManifest,
    parent_live: bool,
) -> bool with Mut, Panic {
    pireus_apple_interface_requirement_valid(requirement, parent_live) &&
        pireus_apple_interface_manifest_valid(manifest) &&
        assessment.request_id == requirement.request.request_id &&
        assessment.machine_id == requirement.request.machine_id &&
        assessment.engine_id == requirement.request.engine_id &&
        assessment.family_count == manifest.family_count &&
        assessment.material_candidate_count == 0 &&
        assessment.execution_authorization_id == 0 &&
        !assessment.value_present
}

fn paif_empty_candidate() -> PireusMeasurementInterfaceCandidate {
    PireusMeasurementInterfaceCandidate {
        candidate_id: 0, request_id: 0, target_id: 0, machine_id: 0,
        engine_id: 0, subject_kind: 0, subject_node: 0, quantity: 0,
        scope: 0, family: 0, concrete_interface_id: 0, access_path: 0,
        counter_source: 0, native_unit: 0, counter_domain: 0,
        event_identity: 0,
        event_semantics_evidence: PIREUS_INTERFACE_EVIDENCE_ABSENT,
        read_privilege: PIREUS_INTERFACE_PRIVILEGE_UNKNOWN,
        availability_state: PIREUS_INTERFACE_AVAILABILITY_UNKNOWN,
        read_serialization_contract: 0, core_binding_contract: 0,
        migration_observable: false,
        migration_evidence: PIREUS_INTERFACE_MIGRATION_ABSENT,
        multiplexing_state: PIREUS_INTERFACE_MULTIPLEXING_UNKNOWN,
        counter_width_bits: 0, wrap_rule: 0, read_overhead_contract: 0,
        toolchain_identity: 0, binary_identity: 0, command_identity: 0,
        material_receipt_ref: 0, material_evidence_ref: 0,
        producer_language: 0, producer_role: 0, evidence_origin_count: 0,
        transport_locator_ref: 0, refusal_reason: 0,
        refusal_predicate: 0,
    }
}

fn paif_empty_observation() -> PireusMaterialInterfaceObservation {
    PireusMaterialInterfaceObservation {
        present: false,
        candidate: paif_empty_candidate(),
        sounio_source_ref: 0,
        sounio_semantics_ref: 0,
        candidate_manifest_ref: 0,
        hardware_identity_ref: 0,
        host_key_identity_ref: 0,
        environment_record_ref: 0,
        raw_result_ref: 0,
    }
}

fn paif_empty_observation_set() -> PireusMaterialInterfaceObservationSet {
    PireusMaterialInterfaceObservationSet {
        evidence_received: false,
        classification_requested: false,
        candidate_manifest_ref: 0,
        declared_candidate_count: 0,
        manifest_closed: false,
        closure_evidence_ref: 0,
        transport_failure: false,
        o0: paif_empty_observation(), o1: paif_empty_observation(),
        o2: paif_empty_observation(), o3: paif_empty_observation(),
        o4: paif_empty_observation(), o5: paif_empty_observation(),
    }
}

fn paif_evidence_positive(value: i64) -> bool {
    value == PIREUS_INTERFACE_EVIDENCE_PRIMARY_AND_ON_DEVICE ||
        value == PIREUS_INTERFACE_EVIDENCE_ON_DEVICE_CONFIGURATION
}

fn paif_privilege_evidenced(value: i64) -> bool {
    value == PIREUS_INTERFACE_PRIVILEGE_USER_EVIDENCED ||
        value == PIREUS_INTERFACE_PRIVILEGE_ELEVATED_EVIDENCED ||
        value == PIREUS_INTERFACE_PRIVILEGE_ENTITLEMENT_EVIDENCED
}

fn paif_cycle_native_family(value: i64) -> bool {
    value == PIREUS_INTERFACE_FAMILY_CORE_CYCLE_COUNTER ||
        value == PIREUS_INTERFACE_FAMILY_PROCESS_PMU_CYCLE_EVENT ||
        value == PIREUS_INTERFACE_FAMILY_SYSTEM_TRACE_CYCLE_EVENT
}

fn paif_native_unit_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_COST_UNIT_CYCLE ||
        value == PIREUS_COST_UNIT_NANOSECOND ||
        value == PIREUS_INTERFACE_UNIT_TIMER_TICK
}

fn paif_counter_domain_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_INTERFACE_COUNTER_DOMAIN_EXECUTING_CPU_CORE ||
        value == PIREUS_INTERFACE_COUNTER_DOMAIN_PROCESS ||
        value == PIREUS_INTERFACE_COUNTER_DOMAIN_SYSTEM ||
        value == PIREUS_INTERFACE_COUNTER_DOMAIN_ARCHITECTURAL_TIMER ||
        value == PIREUS_INTERFACE_COUNTER_DOMAIN_OS_TIME ||
        value == PIREUS_INTERFACE_COUNTER_DOMAIN_DERIVED
}

fn paif_event_evidence_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_EVIDENCE_PRIMARY_AND_ON_DEVICE ||
        value == PIREUS_INTERFACE_EVIDENCE_ON_DEVICE_CONFIGURATION ||
        value == PIREUS_INTERFACE_EVIDENCE_NAME_OR_HEADER_ONLY ||
        value == PIREUS_INTERFACE_EVIDENCE_DERIVED_OR_INFERRED ||
        value == PIREUS_INTERFACE_EVIDENCE_ABSENT ||
        value == PIREUS_INTERFACE_EVIDENCE_CONFLICTING
}

fn paif_privilege_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_INTERFACE_PRIVILEGE_USER_EVIDENCED ||
        value == PIREUS_INTERFACE_PRIVILEGE_ELEVATED_EVIDENCED ||
        value == PIREUS_INTERFACE_PRIVILEGE_ENTITLEMENT_EVIDENCED ||
        value == PIREUS_INTERFACE_PRIVILEGE_UNKNOWN ||
        value == PIREUS_INTERFACE_PRIVILEGE_DENIED_EVIDENCED
}

fn paif_availability_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_AVAILABILITY_AVAILABLE ||
        value == PIREUS_INTERFACE_AVAILABILITY_UNAVAILABLE ||
        value == PIREUS_INTERFACE_AVAILABILITY_UNKNOWN
}

fn paif_serialization_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_INTERFACE_READ_SERIALIZED_BEFORE_AFTER ||
        value == PIREUS_INTERFACE_READ_UNSERIALIZED
}

fn paif_core_binding_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_INTERFACE_CORE_MIGRATION_DETECTED_REJECTED ||
        value == PIREUS_INTERFACE_CORE_AFFINITY_ADVISORY ||
        value == PIREUS_INTERFACE_CORE_BINDING_UNKNOWN
}

fn paif_migration_evidence_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_MIGRATION_DETECTED_REJECTED ||
        value == PIREUS_INTERFACE_MIGRATION_INCAPABLE ||
        value == PIREUS_INTERFACE_MIGRATION_UNKNOWN ||
        value == PIREUS_INTERFACE_MIGRATION_CONFLICTING ||
        value == PIREUS_INTERFACE_MIGRATION_ABSENT
}

fn paif_multiplexing_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_INTERFACE_MULTIPLEXING_DISALLOWED ||
        value == PIREUS_INTERFACE_MULTIPLEXING_ACTIVE ||
        value == PIREUS_INTERFACE_MULTIPLEXING_UNKNOWN
}

fn paif_wrap_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_INTERFACE_WRAP_MODULO_WIDTH
}

fn paif_overhead_valid(value: i64) -> bool {
    value == PIREUS_INTERFACE_OPTION_ABSENT ||
        value == PIREUS_INTERFACE_OVERHEAD_BASELINES_REQUIRED
}

fn paif_refusal_valid(reason: i64, predicate: i64) -> bool {
    (reason == PIREUS_INTERFACE_REFUSAL_PRIVILEGE_DENIED &&
        predicate == PIREUS_INTERFACE_PREDICATE_PRIVILEGE) ||
        (reason == PIREUS_INTERFACE_REFUSAL_MIGRATION_UNSAFE &&
            predicate == PIREUS_INTERFACE_PREDICATE_CORE_MIGRATION) ||
        (reason == PIREUS_INTERFACE_REFUSAL_CYCLE_INELIGIBLE &&
            (predicate == PIREUS_INTERFACE_PREDICATE_NATIVE_UNIT ||
             predicate == PIREUS_INTERFACE_PREDICATE_COUNTER_DOMAIN)) ||
        (reason == PIREUS_INTERFACE_REFUSAL_UNAVAILABLE &&
            predicate == PIREUS_INTERFACE_PREDICATE_AVAILABILITY)
}

pub fn pireus_apple_interface_candidate_record_valid(
    candidate: &PireusMeasurementInterfaceCandidate,
) -> bool {
    candidate.candidate_id != 0 &&
        candidate.request_id == PIREUS_APPLE_CPU_LATENCY_REQUEST_ID &&
        candidate.target_id == PIREUS_TARGET_APPLE_SILICON &&
        candidate.machine_id == PIREUS_MACHINE_APPLE_MAC17_7 &&
        candidate.engine_id == PIREUS_ENGINE_CPU_APPLE_M5_MAX &&
        candidate.subject_kind == PIREUS_COST_SUBJECT_LOWERING_NODE &&
        candidate.subject_node == 0 &&
        candidate.quantity == PIREUS_COST_DEPENDENCY_LATENCY &&
        candidate.scope == PIREUS_COST_SCOPE_DEPENDENCY_CHAIN &&
        pireus_apple_interface_family_valid(candidate.family) &&
        paif_native_unit_valid(candidate.native_unit) &&
        paif_counter_domain_valid(candidate.counter_domain) &&
        paif_event_evidence_valid(candidate.event_semantics_evidence) &&
        paif_privilege_valid(candidate.read_privilege) &&
        paif_availability_valid(candidate.availability_state) &&
        paif_serialization_valid(candidate.read_serialization_contract) &&
        paif_core_binding_valid(candidate.core_binding_contract) &&
        paif_migration_evidence_valid(candidate.migration_evidence) &&
        paif_multiplexing_valid(candidate.multiplexing_state) &&
        candidate.counter_width_bits >= 0 &&
        candidate.counter_width_bits <= 64 &&
        paif_wrap_valid(candidate.wrap_rule) &&
        paif_overhead_valid(candidate.read_overhead_contract) &&
        candidate.concrete_interface_id != 0 && candidate.access_path != 0 &&
        candidate.toolchain_identity != 0 && candidate.binary_identity != 0 &&
        candidate.command_identity != 0 &&
        candidate.material_receipt_ref != 0 &&
        candidate.material_evidence_ref != 0 &&
        candidate.producer_language == PIREUS_COST_LANGUAGE_CPP &&
        candidate.producer_role == PIREUS_COST_ROLE_MATERIAL_PARITY &&
        candidate.evidence_origin_count == 1 &&
        candidate.transport_locator_ref == 0 &&
        ((candidate.refusal_reason == PIREUS_INTERFACE_REFUSAL_NONE &&
          candidate.refusal_predicate == PIREUS_INTERFACE_PREDICATE_NONE) ||
         paif_refusal_valid(
            candidate.refusal_reason, candidate.refusal_predicate))
}

pub fn pireus_apple_interface_candidate_satisfies(
    candidate: &PireusMeasurementInterfaceCandidate,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> bool {
    pireus_apple_interface_candidate_record_valid(candidate) &&
        candidate.request_id == requirement.request.request_id &&
        candidate.target_id == requirement.request.target_id &&
        candidate.machine_id == requirement.request.machine_id &&
        candidate.engine_id == requirement.request.engine_id &&
        candidate.subject_kind == requirement.request.subject_kind &&
        candidate.subject_node == requirement.request.subject_node &&
        candidate.quantity == requirement.request.quantity &&
        candidate.scope == requirement.request.scope &&
        paif_cycle_native_family(candidate.family) &&
        candidate.native_unit == requirement.required_native_unit &&
        candidate.counter_domain == requirement.required_counter_domain &&
        candidate.counter_source != 0 && candidate.event_identity != 0 &&
        paif_evidence_positive(candidate.event_semantics_evidence) &&
        paif_privilege_evidenced(candidate.read_privilege) &&
        candidate.availability_state ==
            PIREUS_INTERFACE_AVAILABILITY_AVAILABLE &&
        candidate.read_serialization_contract ==
            requirement.required_read_boundary &&
        candidate.core_binding_contract == requirement.required_core_binding &&
        candidate.migration_observable &&
        candidate.migration_evidence ==
            PIREUS_INTERFACE_MIGRATION_DETECTED_REJECTED &&
        candidate.multiplexing_state == requirement.required_multiplexing &&
        candidate.counter_width_bits > 0 && candidate.counter_width_bits <= 64 &&
        candidate.wrap_rule == PIREUS_INTERFACE_WRAP_MODULO_WIDTH &&
        candidate.read_overhead_contract ==
            PIREUS_INTERFACE_OVERHEAD_BASELINES_REQUIRED &&
        candidate.refusal_reason == PIREUS_INTERFACE_REFUSAL_NONE &&
        candidate.refusal_predicate == PIREUS_INTERFACE_PREDICATE_NONE
}

pub fn pireus_apple_interface_candidate_terminal_refusal(
    candidate: &PireusMeasurementInterfaceCandidate,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> bool {
    if !pireus_apple_interface_candidate_record_valid(candidate) ||
        candidate.request_id != requirement.request.request_id ||
        candidate.target_id != requirement.request.target_id ||
        candidate.machine_id != requirement.request.machine_id ||
        candidate.engine_id != requirement.request.engine_id {
        return false
    }
    let unavailable =
        candidate.availability_state ==
            PIREUS_INTERFACE_AVAILABILITY_UNAVAILABLE &&
        ((candidate.refusal_reason ==
            PIREUS_INTERFACE_REFUSAL_PRIVILEGE_DENIED &&
          candidate.refusal_predicate ==
            PIREUS_INTERFACE_PREDICATE_PRIVILEGE &&
          candidate.read_privilege ==
            PIREUS_INTERFACE_PRIVILEGE_DENIED_EVIDENCED) ||
         (candidate.refusal_reason ==
            PIREUS_INTERFACE_REFUSAL_UNAVAILABLE &&
          candidate.refusal_predicate ==
            PIREUS_INTERFACE_PREDICATE_AVAILABILITY &&
          candidate.read_privilege == PIREUS_INTERFACE_OPTION_ABSENT)) &&
        candidate.counter_source == PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.native_unit == PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.counter_domain == PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.event_identity == PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.event_semantics_evidence ==
            PIREUS_INTERFACE_EVIDENCE_ABSENT &&
        candidate.read_serialization_contract ==
            PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.core_binding_contract == PIREUS_INTERFACE_OPTION_ABSENT &&
        !candidate.migration_observable &&
        candidate.migration_evidence ==
            PIREUS_INTERFACE_MIGRATION_ABSENT &&
        candidate.multiplexing_state == PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.counter_width_bits == 0 &&
        candidate.wrap_rule == PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.read_overhead_contract == PIREUS_INTERFACE_OPTION_ABSENT
    let migration_unsafe =
        candidate.availability_state ==
            PIREUS_INTERFACE_AVAILABILITY_AVAILABLE &&
        candidate.refusal_reason ==
            PIREUS_INTERFACE_REFUSAL_MIGRATION_UNSAFE &&
        candidate.refusal_predicate ==
            PIREUS_INTERFACE_PREDICATE_CORE_MIGRATION &&
        paif_cycle_native_family(candidate.family) &&
        candidate.counter_source != 0 && candidate.event_identity != 0 &&
        candidate.native_unit == requirement.required_native_unit &&
        candidate.counter_domain == requirement.required_counter_domain &&
        paif_evidence_positive(candidate.event_semantics_evidence) &&
        paif_privilege_evidenced(candidate.read_privilege) &&
        candidate.read_serialization_contract ==
            requirement.required_read_boundary &&
        candidate.core_binding_contract != requirement.required_core_binding &&
        !candidate.migration_observable &&
        candidate.migration_evidence ==
            PIREUS_INTERFACE_MIGRATION_INCAPABLE &&
        candidate.multiplexing_state == requirement.required_multiplexing &&
        candidate.counter_width_bits > 0 &&
        candidate.wrap_rule == PIREUS_INTERFACE_WRAP_MODULO_WIDTH &&
        candidate.read_overhead_contract ==
            PIREUS_INTERFACE_OVERHEAD_BASELINES_REQUIRED
    unavailable || migration_unsafe
}

pub fn pireus_apple_interface_candidate_cycle_ineligible(
    candidate: &PireusMeasurementInterfaceCandidate,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> bool {
    pireus_apple_interface_candidate_record_valid(candidate) &&
        candidate.request_id == requirement.request.request_id &&
        candidate.target_id == requirement.request.target_id &&
        candidate.machine_id == requirement.request.machine_id &&
        candidate.engine_id == requirement.request.engine_id &&
        candidate.availability_state ==
            PIREUS_INTERFACE_AVAILABILITY_AVAILABLE &&
        candidate.counter_source != 0 && candidate.event_identity != 0 &&
        candidate.native_unit != PIREUS_INTERFACE_OPTION_ABSENT &&
        candidate.counter_domain != PIREUS_INTERFACE_OPTION_ABSENT &&
        paif_evidence_positive(candidate.event_semantics_evidence) &&
        paif_privilege_evidenced(candidate.read_privilege) &&
        candidate.refusal_reason ==
            PIREUS_INTERFACE_REFUSAL_CYCLE_INELIGIBLE &&
        (candidate.native_unit != PIREUS_COST_UNIT_CYCLE ||
         candidate.counter_domain !=
            PIREUS_INTERFACE_COUNTER_DOMAIN_EXECUTING_CPU_CORE)
}

fn paif_candidate_terminal(
    candidate: &PireusMeasurementInterfaceCandidate,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> bool {
    pireus_apple_interface_candidate_satisfies(candidate, requirement) ||
        pireus_apple_interface_candidate_terminal_refusal(
            candidate, requirement) ||
        pireus_apple_interface_candidate_cycle_ineligible(
            candidate, requirement)
}

fn paif_candidate_refused(
    candidate: &PireusMeasurementInterfaceCandidate,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> bool {
    pireus_apple_interface_candidate_terminal_refusal(candidate, requirement)
}

pub fn pireus_apple_interface_observation_valid(
    observation: &PireusMaterialInterfaceObservation,
) -> bool {
    if !observation.present {
        return observation.candidate.candidate_id == 0 &&
            observation.sounio_source_ref == 0 &&
            observation.sounio_semantics_ref == 0 &&
            observation.candidate_manifest_ref == 0 &&
            observation.hardware_identity_ref == 0 &&
            observation.host_key_identity_ref == 0 &&
            observation.environment_record_ref == 0 &&
            observation.raw_result_ref == 0
    }
    pireus_apple_interface_candidate_record_valid(&observation.candidate) &&
        observation.sounio_source_ref != 0 &&
        observation.sounio_semantics_ref != 0 &&
        observation.candidate_manifest_ref != 0 &&
        observation.hardware_identity_ref != 0 &&
        observation.host_key_identity_ref != 0 &&
        observation.environment_record_ref != 0 &&
        observation.raw_result_ref != 0
}

fn paif_observation_count(
    observations: &PireusMaterialInterfaceObservationSet,
) -> i64 {
    (if observations.o0.present { 1 } else { 0 }) +
        (if observations.o1.present { 1 } else { 0 }) +
        (if observations.o2.present { 1 } else { 0 }) +
        (if observations.o3.present { 1 } else { 0 }) +
        (if observations.o4.present { 1 } else { 0 }) +
        (if observations.o5.present { 1 } else { 0 })
}

fn paif_observation_ids_distinct(
    left: &PireusMaterialInterfaceObservation,
    right: &PireusMaterialInterfaceObservation,
) -> bool {
    !left.present || !right.present ||
        left.candidate.candidate_id != right.candidate.candidate_id
}

fn paif_observation_manifest_matches(
    observation: &PireusMaterialInterfaceObservation,
    manifest_ref: i64,
) -> bool {
    !observation.present || observation.candidate_manifest_ref == manifest_ref
}

fn paif_observation_ids_unique(
    observations: &PireusMaterialInterfaceObservationSet,
) -> bool {
    paif_observation_ids_distinct(&observations.o0, &observations.o1) &&
    paif_observation_ids_distinct(&observations.o0, &observations.o2) &&
    paif_observation_ids_distinct(&observations.o0, &observations.o3) &&
    paif_observation_ids_distinct(&observations.o0, &observations.o4) &&
    paif_observation_ids_distinct(&observations.o0, &observations.o5) &&
    paif_observation_ids_distinct(&observations.o1, &observations.o2) &&
    paif_observation_ids_distinct(&observations.o1, &observations.o3) &&
    paif_observation_ids_distinct(&observations.o1, &observations.o4) &&
    paif_observation_ids_distinct(&observations.o1, &observations.o5) &&
    paif_observation_ids_distinct(&observations.o2, &observations.o3) &&
    paif_observation_ids_distinct(&observations.o2, &observations.o4) &&
    paif_observation_ids_distinct(&observations.o2, &observations.o5) &&
    paif_observation_ids_distinct(&observations.o3, &observations.o4) &&
    paif_observation_ids_distinct(&observations.o3, &observations.o5) &&
    paif_observation_ids_distinct(&observations.o4, &observations.o5)
}

pub fn pireus_apple_interface_observation_set_valid(
    observations: &PireusMaterialInterfaceObservationSet,
) -> bool {
    if !pireus_apple_interface_observation_valid(&observations.o0) ||
        !pireus_apple_interface_observation_valid(&observations.o1) ||
        !pireus_apple_interface_observation_valid(&observations.o2) ||
        !pireus_apple_interface_observation_valid(&observations.o3) ||
        !pireus_apple_interface_observation_valid(&observations.o4) ||
        !pireus_apple_interface_observation_valid(&observations.o5) ||
        !paif_observation_ids_unique(observations) {
        return false
    }
    let count = paif_observation_count(observations)
    if !observations.evidence_received {
        return count == 0 && !observations.classification_requested &&
            observations.candidate_manifest_ref == 0 &&
            observations.declared_candidate_count == 0 &&
            !observations.manifest_closed &&
            observations.closure_evidence_ref == 0 &&
            !observations.transport_failure
    }
    if count == 0 {
        if observations.candidate_manifest_ref != 0 ||
            observations.declared_candidate_count != 0 {
            return false
        }
    } else if observations.candidate_manifest_ref == 0 ||
        !paif_observation_manifest_matches(
            &observations.o0, observations.candidate_manifest_ref) ||
        !paif_observation_manifest_matches(
            &observations.o1, observations.candidate_manifest_ref) ||
        !paif_observation_manifest_matches(
            &observations.o2, observations.candidate_manifest_ref) ||
        !paif_observation_manifest_matches(
            &observations.o3, observations.candidate_manifest_ref) ||
        !paif_observation_manifest_matches(
            &observations.o4, observations.candidate_manifest_ref) ||
        !paif_observation_manifest_matches(
            &observations.o5, observations.candidate_manifest_ref) {
        return false
    }
    if observations.classification_requested && count == 0 &&
        !observations.transport_failure {
        return false
    }
    if observations.manifest_closed {
        return observations.closure_evidence_ref != 0 && count > 0 &&
            observations.declared_candidate_count == count
    }
    observations.closure_evidence_ref == 0 &&
        observations.declared_candidate_count == 0
}

fn paif_feasible_count(
    observations: &PireusMaterialInterfaceObservationSet,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> i64 {
    (if observations.o0.present &&
        pireus_apple_interface_candidate_satisfies(
            &observations.o0.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o1.present &&
        pireus_apple_interface_candidate_satisfies(
            &observations.o1.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o2.present &&
        pireus_apple_interface_candidate_satisfies(
            &observations.o2.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o3.present &&
        pireus_apple_interface_candidate_satisfies(
            &observations.o3.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o4.present &&
        pireus_apple_interface_candidate_satisfies(
            &observations.o4.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o5.present &&
        pireus_apple_interface_candidate_satisfies(
            &observations.o5.candidate, requirement) { 1 } else { 0 })
}

fn paif_terminal_count(
    observations: &PireusMaterialInterfaceObservationSet,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> i64 {
    (if observations.o0.present && paif_candidate_terminal(
        &observations.o0.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o1.present && paif_candidate_terminal(
        &observations.o1.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o2.present && paif_candidate_terminal(
        &observations.o2.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o3.present && paif_candidate_terminal(
        &observations.o3.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o4.present && paif_candidate_terminal(
        &observations.o4.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o5.present && paif_candidate_terminal(
        &observations.o5.candidate, requirement) { 1 } else { 0 })
}

fn paif_refusal_count(
    observations: &PireusMaterialInterfaceObservationSet,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> i64 {
    (if observations.o0.present && paif_candidate_refused(
        &observations.o0.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o1.present && paif_candidate_refused(
        &observations.o1.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o2.present && paif_candidate_refused(
        &observations.o2.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o3.present && paif_candidate_refused(
        &observations.o3.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o4.present && paif_candidate_refused(
        &observations.o4.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o5.present && paif_candidate_refused(
        &observations.o5.candidate, requirement) { 1 } else { 0 })
}

fn paif_ineligible_count(
    observations: &PireusMaterialInterfaceObservationSet,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> i64 {
    (if observations.o0.present &&
        pireus_apple_interface_candidate_cycle_ineligible(
            &observations.o0.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o1.present &&
        pireus_apple_interface_candidate_cycle_ineligible(
            &observations.o1.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o2.present &&
        pireus_apple_interface_candidate_cycle_ineligible(
            &observations.o2.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o3.present &&
        pireus_apple_interface_candidate_cycle_ineligible(
            &observations.o3.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o4.present &&
        pireus_apple_interface_candidate_cycle_ineligible(
            &observations.o4.candidate, requirement) { 1 } else { 0 }) +
    (if observations.o5.present &&
        pireus_apple_interface_candidate_cycle_ineligible(
            &observations.o5.candidate, requirement) { 1 } else { 0 })
}

fn paif_first_feasible_id(
    observations: &PireusMaterialInterfaceObservationSet,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> i64 {
    if observations.o0.present && pireus_apple_interface_candidate_satisfies(
        &observations.o0.candidate, requirement) {
        return observations.o0.candidate.candidate_id
    }
    if observations.o1.present && pireus_apple_interface_candidate_satisfies(
        &observations.o1.candidate, requirement) {
        return observations.o1.candidate.candidate_id
    }
    if observations.o2.present && pireus_apple_interface_candidate_satisfies(
        &observations.o2.candidate, requirement) {
        return observations.o2.candidate.candidate_id
    }
    if observations.o3.present && pireus_apple_interface_candidate_satisfies(
        &observations.o3.candidate, requirement) {
        return observations.o3.candidate.candidate_id
    }
    if observations.o4.present && pireus_apple_interface_candidate_satisfies(
        &observations.o4.candidate, requirement) {
        return observations.o4.candidate.candidate_id
    }
    if observations.o5.present && pireus_apple_interface_candidate_satisfies(
        &observations.o5.candidate, requirement) {
        return observations.o5.candidate.candidate_id
    }
    0
}

pub fn pireus_apple_interface_classify(
    observations: &PireusMaterialInterfaceObservationSet,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> PireusInterfaceFeasibilityDecision with Mut, Panic {
    let count = paif_observation_count(observations)
    let feasible = paif_feasible_count(observations, requirement)
    let terminal = paif_terminal_count(observations, requirement)
    let refusals = paif_refusal_count(observations, requirement)
    let ineligible = paif_ineligible_count(observations, requirement)
    var stage = PIREUS_INTERFACE_STAGE_ASSESSMENT_REQUESTED
    var verdict = PIREUS_INTERFACE_VERDICT_UNASSESSED
    if observations.evidence_received {
        stage = PIREUS_INTERFACE_STAGE_MATERIAL_EVIDENCE_RECEIVED
    }
    if observations.evidence_received && observations.classification_requested {
        stage = PIREUS_INTERFACE_STAGE_CLASSIFIED
        if !pireus_apple_interface_observation_set_valid(observations) {
            verdict = PIREUS_INTERFACE_VERDICT_INDETERMINATE
        } else if feasible > 0 {
            verdict = PIREUS_INTERFACE_VERDICT_FEASIBLE_CYCLE_NATIVE
        } else if !observations.transport_failure &&
            observations.manifest_closed && count > 0 && terminal == count &&
            refusals + ineligible == count {
            verdict = PIREUS_INTERFACE_VERDICT_FALSIFIED_FROZEN_SET
        } else {
            verdict = PIREUS_INTERFACE_VERDICT_INDETERMINATE
        }
    }
    PireusInterfaceFeasibilityDecision {
        stage: stage,
        verdict: verdict,
        candidate_count: count,
        complete_terminal_count: terminal,
        feasible_count: feasible,
        refusal_count: refusals,
        cycle_ineligible_count: ineligible,
        feasible_candidate_id:
            paif_first_feasible_id(observations, requirement),
        manifest_closed: observations.manifest_closed,
    }
}

pub fn pireus_apple_interface_decision_matches_inputs(
    decision: &PireusInterfaceFeasibilityDecision,
    observations: &PireusMaterialInterfaceObservationSet,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> bool with Mut, Panic {
    let expected = pireus_apple_interface_classify(observations, requirement)
    decision.stage == expected.stage && decision.verdict == expected.verdict &&
        decision.candidate_count == expected.candidate_count &&
        decision.complete_terminal_count == expected.complete_terminal_count &&
        decision.feasible_count == expected.feasible_count &&
        decision.refusal_count == expected.refusal_count &&
        decision.cycle_ineligible_count == expected.cycle_ineligible_count &&
        decision.feasible_candidate_id == expected.feasible_candidate_id &&
        decision.manifest_closed == expected.manifest_closed
}

fn paif_query_class(store: &TripleStore, class_id: i64) -> SparqlResult
with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(class_id)))
    sparql_execute(store, &query)
}

fn paif_query_relation(
    store: &TripleStore, subject: i64, predicate: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_iri(subject), queryterm_iri(predicate),
        queryterm_variable(0)))
    sparql_execute(store, &query)
}

fn paif_ontology_add(
    store: &TripleStore, state: SHA256State,
    subject: i64, predicate: i64, object: i64,
) -> SHA256State with Mut, Panic, Div {
    triple_store_add(store, triple_iri(subject, predicate, object))
    var next = paif_digest_add_i64(state, subject)
    next = paif_digest_add_i64(next, predicate)
    paif_digest_add_i64(next, object)
}

fn paif_ontology_projection(
    requirement: &PireusMeasurementInterfaceRequirement,
    manifest: &PireusInterfaceCandidateManifest,
    decision: &PireusInterfaceFeasibilityDecision,
    output: &![i64; 9],
) -> bool with Mut, Panic, Div, Epistemic {
    var store = triple_store_new()
    var state = sha256_init()
    state = paif_digest_add_string(
        state, "pireus.apple-cpu-interface-feasibility.ontology.v0")
    let classes: [i64; 6] = [
        PIREUS_CLASS_INTERFACE_REQUEST_REF,
        PIREUS_CLASS_INTERFACE_REQUIREMENT,
        PIREUS_CLASS_INTERFACE_FAMILY_MANIFEST,
        PIREUS_CLASS_INTERFACE_ASSESSMENT,
        PIREUS_CLASS_INTERFACE_STAGE,
        PIREUS_CLASS_INTERFACE_VERDICT
    ]
    var i: i64 = 0
    while i < 6 {
        state = paif_ontology_add(&store, state,
            classes[i as usize], PIREUS_RDF_TYPE,
            PIREUS_CLASS_ONTOLOGY_CLASS)
        i = i + 1
    }
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_REQUEST_IRI, PIREUS_RDF_TYPE,
        PIREUS_CLASS_INTERFACE_REQUEST_REF)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_REQUIREMENT_IRI, PIREUS_RDF_TYPE,
        PIREUS_CLASS_INTERFACE_REQUIREMENT)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_MANIFEST_IRI, PIREUS_RDF_TYPE,
        PIREUS_CLASS_INTERFACE_FAMILY_MANIFEST)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI, PIREUS_RDF_TYPE,
        PIREUS_CLASS_INTERFACE_ASSESSMENT)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI,
        PIREUS_INTERFACE_HAS_REQUEST, PIREUS_INTERFACE_REQUEST_IRI)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI,
        PIREUS_INTERFACE_HAS_REQUIREMENT, PIREUS_INTERFACE_REQUIREMENT_IRI)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI,
        PIREUS_INTERFACE_HAS_MANIFEST, PIREUS_INTERFACE_MANIFEST_IRI)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI,
        PIREUS_INTERFACE_HAS_MACHINE, requirement.request.machine_id)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI,
        PIREUS_INTERFACE_HAS_ENGINE, requirement.request.engine_id)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_REQUIREMENT_IRI,
        PIREUS_INTERFACE_HAS_UNIT, requirement.required_native_unit)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_REQUIREMENT_IRI,
        PIREUS_INTERFACE_HAS_DOMAIN, requirement.required_counter_domain)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI,
        PIREUS_INTERFACE_HAS_STAGE, decision.stage)
    state = paif_ontology_add(&store, state,
        PIREUS_INTERFACE_ASSESSMENT_IRI,
        PIREUS_INTERFACE_HAS_VERDICT, decision.verdict)
    i = 0
    while i < manifest.family_count {
        state = paif_ontology_add(&store, state,
            PIREUS_INTERFACE_MANIFEST_IRI, PIREUS_INTERFACE_HAS_FAMILY,
            manifest.families[i as usize])
        i = i + 1
    }
    let requests = paif_query_class(&store,
        PIREUS_CLASS_INTERFACE_REQUEST_REF)
    let requirements = paif_query_class(&store,
        PIREUS_CLASS_INTERFACE_REQUIREMENT)
    let assessments = paif_query_class(&store,
        PIREUS_CLASS_INTERFACE_ASSESSMENT)
    let families = paif_query_relation(&store,
        PIREUS_INTERFACE_MANIFEST_IRI, PIREUS_INTERFACE_HAS_FAMILY)
    let stages = paif_query_relation(&store,
        PIREUS_INTERFACE_ASSESSMENT_IRI, PIREUS_INTERFACE_HAS_STAGE)
    let verdicts = paif_query_relation(&store,
        PIREUS_INTERFACE_ASSESSMENT_IRI, PIREUS_INTERFACE_HAS_VERDICT)
    let valid = sparql_result_count(&requests) == 1 &&
        sparql_result_count(&requirements) == 1 &&
        sparql_result_count(&assessments) == 1 &&
        sparql_result_count(&families) == manifest.family_count &&
        sparql_result_count(&stages) == 1 &&
        sparql_result_count(&verdicts) == 1
    let digest = paif_digest_finish(state)
    output[0] = triple_store_count(&store)
    i = 0
    while i < 8 {
        output[(i + 1) as usize] = digest.words[i as usize]
        i = i + 1
    }
    valid
}

fn paif_test_candidate(
    requirement: &PireusMeasurementInterfaceRequirement,
) -> PireusMeasurementInterfaceCandidate {
    PireusMeasurementInterfaceCandidate {
        candidate_id: 799001,
        request_id: requirement.request.request_id,
        target_id: requirement.request.target_id,
        machine_id: requirement.request.machine_id,
        engine_id: requirement.request.engine_id,
        subject_kind: requirement.request.subject_kind,
        subject_node: requirement.request.subject_node,
        quantity: requirement.request.quantity,
        scope: requirement.request.scope,
        family: PIREUS_INTERFACE_FAMILY_CORE_CYCLE_COUNTER,
        concrete_interface_id: 799002,
        access_path: 799003,
        counter_source: 799004,
        native_unit: PIREUS_COST_UNIT_CYCLE,
        counter_domain: PIREUS_INTERFACE_COUNTER_DOMAIN_EXECUTING_CPU_CORE,
        event_identity: 799005,
        event_semantics_evidence:
            PIREUS_INTERFACE_EVIDENCE_ON_DEVICE_CONFIGURATION,
        read_privilege: PIREUS_INTERFACE_PRIVILEGE_USER_EVIDENCED,
        availability_state: PIREUS_INTERFACE_AVAILABILITY_AVAILABLE,
        read_serialization_contract:
            PIREUS_INTERFACE_READ_SERIALIZED_BEFORE_AFTER,
        core_binding_contract:
            PIREUS_INTERFACE_CORE_MIGRATION_DETECTED_REJECTED,
        migration_observable: true,
        migration_evidence: PIREUS_INTERFACE_MIGRATION_DETECTED_REJECTED,
        multiplexing_state: PIREUS_INTERFACE_MULTIPLEXING_DISALLOWED,
        counter_width_bits: 64,
        wrap_rule: PIREUS_INTERFACE_WRAP_MODULO_WIDTH,
        read_overhead_contract: PIREUS_INTERFACE_OVERHEAD_BASELINES_REQUIRED,
        toolchain_identity: 799006,
        binary_identity: 799007,
        command_identity: 799008,
        material_receipt_ref: 799009,
        material_evidence_ref: 799010,
        producer_language: PIREUS_COST_LANGUAGE_CPP,
        producer_role: PIREUS_COST_ROLE_MATERIAL_PARITY,
        evidence_origin_count: 1,
        transport_locator_ref: 0,
        refusal_reason: PIREUS_INTERFACE_REFUSAL_NONE,
        refusal_predicate: PIREUS_INTERFACE_PREDICATE_NONE,
    }
}

fn paif_test_observation(
    candidate: PireusMeasurementInterfaceCandidate,
) -> PireusMaterialInterfaceObservation {
    PireusMaterialInterfaceObservation {
        present: true,
        candidate: candidate,
        sounio_source_ref: 799101,
        sounio_semantics_ref: 799102,
        candidate_manifest_ref: 799103,
        hardware_identity_ref: 799104,
        host_key_identity_ref: 799105,
        environment_record_ref: 799106,
        raw_result_ref: 799107,
    }
}

fn paif_test_set(
    observation: PireusMaterialInterfaceObservation,
) -> PireusMaterialInterfaceObservationSet {
    PireusMaterialInterfaceObservationSet {
        evidence_received: true,
        classification_requested: true,
        candidate_manifest_ref: 799103,
        declared_candidate_count: 0,
        manifest_closed: false,
        closure_evidence_ref: 0,
        transport_failure: false,
        o0: observation,
        o1: paif_empty_observation(), o2: paif_empty_observation(),
        o3: paif_empty_observation(), o4: paif_empty_observation(),
        o5: paif_empty_observation(),
    }
}

fn paif_role_allowed(language: i64, role: i64) -> bool {
    language == PIREUS_COST_LANGUAGE_CPP &&
        role == PIREUS_COST_ROLE_MATERIAL_PARITY
}

fn paif_launch_boundaries_valid(
    interface_ready: bool, environment_bound: bool,
    harness_frozen: bool, measurand_validated: bool,
    execution_authorized: bool, value_present: bool,
    parity_open: bool, claim_ready: bool,
) -> bool {
    !interface_ready && !environment_bound && !harness_frozen &&
        !measurand_validated && !execution_authorized && !value_present &&
        !parity_open && !claim_ready
}

fn paif_exercise_negatives(
    parent_mask: i64,
    requirement: &PireusMeasurementInterfaceRequirement,
) -> PireusAppleInterfaceNegatives with Mut, Panic {
    let positive = paif_test_candidate(requirement)
    let positive_observation = paif_test_observation(positive)
    let positive_set = paif_test_set(positive_observation)
    let positive_decision = pireus_apple_interface_classify(
        &positive_set, requirement)

    var request_id = paif_test_candidate(requirement)
    request_id.request_id = request_id.request_id + 1
    var material = paif_test_candidate(requirement)
    material.machine_id = material.machine_id + 1
    var foreign = paif_test_candidate(requirement)
    foreign.target_id = foreign.target_id + 1
    var subject = paif_test_candidate(requirement)
    subject.subject_kind = subject.subject_kind + 1
    var contract = paif_test_candidate(requirement)
    contract.scope = contract.scope + 1
    var ticks = paif_test_candidate(requirement)
    ticks.native_unit = PIREUS_INTERFACE_UNIT_TIMER_TICK
    var nanos = paif_test_candidate(requirement)
    nanos.native_unit = PIREUS_COST_UNIT_NANOSECOND
    var frequency = paif_test_candidate(requirement)
    frequency.family = PIREUS_INTERFACE_FAMILY_FREQUENCY_DERIVED_ESTIMATE
    frequency.event_semantics_evidence =
        PIREUS_INTERFACE_EVIDENCE_DERIVED_OR_INFERRED
    var name_only = paif_test_candidate(requirement)
    name_only.event_semantics_evidence =
        PIREUS_INTERFACE_EVIDENCE_NAME_OR_HEADER_ONLY
    var absent_domain = paif_test_candidate(requirement)
    absent_domain.counter_source = 0
    var privilege = paif_test_candidate(requirement)
    privilege.read_privilege = PIREUS_INTERFACE_PRIVILEGE_UNKNOWN
    var multiplexed = paif_test_candidate(requirement)
    multiplexed.multiplexing_state = PIREUS_INTERFACE_MULTIPLEXING_ACTIVE
    var width = paif_test_candidate(requirement)
    width.counter_width_bits = 0
    var serialization = paif_test_candidate(requirement)
    serialization.read_serialization_contract =
        PIREUS_INTERFACE_READ_UNSERIALIZED
    var migration = paif_test_candidate(requirement)
    migration.migration_observable = false
    migration.migration_evidence = PIREUS_INTERFACE_MIGRATION_UNKNOWN
    var advisory = paif_test_candidate(requirement)
    advisory.core_binding_contract = PIREUS_INTERFACE_CORE_AFFINITY_ADVISORY
    var merged = paif_test_candidate(requirement)
    merged.evidence_origin_count = 2
    var duplicate_set = paif_test_set(paif_test_observation(
        paif_test_candidate(requirement)))
    duplicate_set.o1 = paif_test_observation(paif_test_candidate(requirement))
    var locator = paif_test_candidate(requirement)
    locator.transport_locator_ref = 799999
    var cpp_authority = paif_test_candidate(requirement)
    cpp_authority.producer_role = PIREUS_COST_ROLE_SEMANTIC_AUTHORITY
    var llm = paif_test_candidate(requirement)
    llm.producer_language = PIREUS_COST_LANGUAGE_EXTERNAL_LLM
    llm.producer_role = PIREUS_COST_ROLE_REVIEW_ONLY
    var python = paif_test_candidate(requirement)
    python.producer_language = PIREUS_COST_LANGUAGE_PYTHON
    var rust = paif_test_candidate(requirement)
    rust.producer_language = PIREUS_COST_LANGUAGE_RUST
    var sibling = paif_test_candidate(requirement)
    sibling.engine_id = sibling.engine_id + 1

    var closure = paif_test_set(paif_test_observation(
        paif_test_candidate(requirement)))
    closure.manifest_closed = true
    closure.closure_evidence_ref = 0

    var refused = paif_test_candidate(requirement)
    refused.availability_state = PIREUS_INTERFACE_AVAILABILITY_UNAVAILABLE
    refused.counter_source = PIREUS_INTERFACE_OPTION_ABSENT
    refused.native_unit = PIREUS_INTERFACE_OPTION_ABSENT
    refused.counter_domain = PIREUS_INTERFACE_OPTION_ABSENT
    refused.event_identity = PIREUS_INTERFACE_OPTION_ABSENT
    refused.event_semantics_evidence = PIREUS_INTERFACE_EVIDENCE_ABSENT
    refused.read_privilege = PIREUS_INTERFACE_PRIVILEGE_DENIED_EVIDENCED
    refused.read_serialization_contract = PIREUS_INTERFACE_OPTION_ABSENT
    refused.core_binding_contract = PIREUS_INTERFACE_OPTION_ABSENT
    refused.migration_observable = false
    refused.migration_evidence = PIREUS_INTERFACE_MIGRATION_ABSENT
    refused.multiplexing_state = PIREUS_INTERFACE_OPTION_ABSENT
    refused.counter_width_bits = 0
    refused.wrap_rule = PIREUS_INTERFACE_OPTION_ABSENT
    refused.read_overhead_contract = PIREUS_INTERFACE_OPTION_ABSENT
    refused.refusal_reason = PIREUS_INTERFACE_REFUSAL_PRIVILEGE_DENIED
    refused.refusal_predicate = PIREUS_INTERFACE_PREDICATE_PRIVILEGE
    var refused_set = paif_test_set(paif_test_observation(refused))
    refused_set.manifest_closed = false
    let refused_decision = pireus_apple_interface_classify(
        &refused_set, requirement)
    var falsified_set = paif_test_set(paif_test_observation(refused))
    falsified_set.manifest_closed = true
    falsified_set.declared_candidate_count = 1
    falsified_set.closure_evidence_ref = 799108
    let falsified_decision = pireus_apple_interface_classify(
        &falsified_set, requirement)

    var migration_refused = paif_test_candidate(requirement)
    migration_refused.core_binding_contract =
        PIREUS_INTERFACE_CORE_AFFINITY_ADVISORY
    migration_refused.migration_observable = false
    migration_refused.migration_evidence =
        PIREUS_INTERFACE_MIGRATION_INCAPABLE
    migration_refused.refusal_reason =
        PIREUS_INTERFACE_REFUSAL_MIGRATION_UNSAFE
    migration_refused.refusal_predicate =
        PIREUS_INTERFACE_PREDICATE_CORE_MIGRATION
    var migration_refused_set = paif_test_set(
        paif_test_observation(migration_refused))
    migration_refused_set.manifest_closed = true
    migration_refused_set.declared_candidate_count = 1
    migration_refused_set.closure_evidence_ref = 799108
    let migration_refused_decision = pireus_apple_interface_classify(
        &migration_refused_set, requirement)

    var cycle_ineligible = paif_test_candidate(requirement)
    cycle_ineligible.native_unit = PIREUS_INTERFACE_UNIT_TIMER_TICK
    cycle_ineligible.counter_domain =
        PIREUS_INTERFACE_COUNTER_DOMAIN_ARCHITECTURAL_TIMER
    cycle_ineligible.refusal_reason =
        PIREUS_INTERFACE_REFUSAL_CYCLE_INELIGIBLE
    cycle_ineligible.refusal_predicate =
        PIREUS_INTERFACE_PREDICATE_NATIVE_UNIT
    var cycle_ineligible_set = paif_test_set(
        paif_test_observation(cycle_ineligible))
    cycle_ineligible_set.manifest_closed = true
    cycle_ineligible_set.declared_candidate_count = 1
    cycle_ineligible_set.closure_evidence_ref = 799108
    let cycle_ineligible_decision = pireus_apple_interface_classify(
        &cycle_ineligible_set, requirement)

    var conflicting = paif_test_candidate(requirement)
    conflicting.event_semantics_evidence =
        PIREUS_INTERFACE_EVIDENCE_CONFLICTING
    conflicting.availability_state = PIREUS_INTERFACE_AVAILABILITY_UNKNOWN
    let conflict_set = paif_test_set(paif_test_observation(conflicting))
    let conflict_decision = pireus_apple_interface_classify(
        &conflict_set, requirement)

    var transport = paif_empty_observation_set()
    transport.evidence_received = true
    transport.classification_requested = true
    transport.transport_failure = true
    let transport_decision = pireus_apple_interface_classify(
        &transport, requirement)

    let positive_baseline_valid =
        pireus_apple_interface_observation_set_valid(&positive_set) &&
        positive_decision.stage == PIREUS_INTERFACE_STAGE_CLASSIFIED &&
        positive_decision.verdict ==
            PIREUS_INTERFACE_VERDICT_FEASIBLE_CYCLE_NATIVE &&
        positive_decision.feasible_count == 1 &&
        pireus_apple_interface_observation_set_valid(&falsified_set) &&
        falsified_decision.stage == PIREUS_INTERFACE_STAGE_CLASSIFIED &&
        falsified_decision.verdict ==
            PIREUS_INTERFACE_VERDICT_FALSIFIED_FROZEN_SET &&
        falsified_decision.complete_terminal_count == 1 &&
        pireus_apple_interface_observation_set_valid(
            &migration_refused_set) &&
        migration_refused_decision.verdict ==
            PIREUS_INTERFACE_VERDICT_FALSIFIED_FROZEN_SET &&
        migration_refused_decision.refusal_count == 1 &&
        pireus_apple_interface_observation_set_valid(
            &cycle_ineligible_set) &&
        cycle_ineligible_decision.verdict ==
            PIREUS_INTERFACE_VERDICT_FALSIFIED_FROZEN_SET &&
        cycle_ineligible_decision.cycle_ineligible_count == 1

    let values: [bool; 32] = [
        paif_all_parent_drifts_detected(parent_mask),
        !pireus_apple_interface_request_ref_valid(&requirement.request, false),
        !pireus_apple_interface_candidate_satisfies(&request_id, requirement),
        !pireus_apple_interface_candidate_satisfies(&material, requirement),
        !pireus_apple_interface_candidate_satisfies(&foreign, requirement),
        !pireus_apple_interface_candidate_satisfies(&subject, requirement),
        !pireus_apple_interface_candidate_satisfies(&contract, requirement),
        !pireus_apple_interface_candidate_satisfies(&ticks, requirement),
        !pireus_apple_interface_candidate_satisfies(&nanos, requirement),
        !pireus_apple_interface_candidate_satisfies(&frequency, requirement),
        !pireus_apple_interface_candidate_satisfies(&name_only, requirement),
        !pireus_apple_interface_candidate_satisfies(
            &absent_domain, requirement),
        !pireus_apple_interface_candidate_satisfies(&privilege, requirement),
        !pireus_apple_interface_candidate_satisfies(
            &multiplexed, requirement),
        !pireus_apple_interface_candidate_satisfies(&width, requirement),
        !pireus_apple_interface_candidate_satisfies(
            &serialization, requirement),
        !pireus_apple_interface_candidate_satisfies(&migration, requirement),
        !pireus_apple_interface_candidate_satisfies(&advisory, requirement),
        !pireus_apple_interface_candidate_satisfies(&merged, requirement) &&
            !pireus_apple_interface_observation_set_valid(&duplicate_set),
        !pireus_apple_interface_observation_set_valid(&closure),
        refused_decision.verdict == PIREUS_INTERFACE_VERDICT_INDETERMINATE,
        conflict_decision.verdict == PIREUS_INTERFACE_VERDICT_INDETERMINATE,
        !pireus_apple_interface_candidate_satisfies(&locator, requirement),
        transport_decision.verdict == PIREUS_INTERFACE_VERDICT_INDETERMINATE,
        !paif_launch_boundaries_valid(false, true, false, false,
            false, false, false, false),
        !paif_launch_boundaries_valid(false, false, false, false,
            true, false, false, false),
        !paif_launch_boundaries_valid(false, false, false, false,
            false, true, false, false),
        !paif_role_allowed(
            cpp_authority.producer_language, cpp_authority.producer_role),
        !paif_role_allowed(llm.producer_language, llm.producer_role),
        !paif_role_allowed(python.producer_language, python.producer_role) &&
            !paif_role_allowed(rust.producer_language, rust.producer_role),
        !paif_launch_boundaries_valid(false, false, false, false,
            false, false, true, true),
        !pireus_apple_interface_candidate_satisfies(&sibling, requirement)
    ]
    var passed: i64 = 0
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_NEGATIVE_COUNT {
        if values[i as usize] { passed = passed + 1 }
        i = i + 1
    }
    if !positive_baseline_valid { passed = 0 }
    PireusAppleInterfaceNegatives {
        direct_parent_drift: values[0],
        parent_semantics_not_live: values[1],
        request_id_drift: values[2],
        material_identity_drift: values[3],
        foreign_target_or_engine: values[4],
        subject_widened: values[5],
        request_contract_drift: values[6],
        timer_ticks_as_cycles: values[7],
        nanoseconds_as_cycles: values[8],
        frequency_estimate_as_native: values[9],
        name_only_event_semantics: values[10],
        absent_source_or_domain: values[11],
        privilege_unknown_as_available: values[12],
        multiplexed_as_native: values[13],
        width_or_wrap_absent: values[14],
        unserialized_reads: values[15],
        migration_unsafe_as_native: values[16],
        advisory_affinity_as_enforced: values[17],
        merged_candidate_evidence: values[18],
        manifest_closed_without_evidence: values[19],
        one_refusal_as_universal: values[20],
        conflicting_evidence_silenced: values[21],
        locator_as_interface_evidence: values[22],
        transport_failure_as_falsification: values[23],
        environment_inferred: values[24],
        authorization_inferred: values[25],
        value_or_summary_inserted: values[26],
        cpp_as_semantic_authority: values[27],
        external_review_as_material: values[28],
        forbidden_python_or_rust: values[29],
        premature_parity_or_claim: values[30],
        sibling_machine_inference: values[31],
        passed: passed,
        total: PIREUS_APPLE_INTERFACE_NEGATIVE_COUNT,
    }
}

fn paif_digest_request_ref(
    state: SHA256State, value: &PireusAppleCpuLatencyRequestRef,
) -> SHA256State with Mut, Panic, Div {
    var next = paif_digest_add_i64(state, value.request_id)
    next = paif_digest_add_i64(next, value.target_id)
    next = paif_digest_add_i64(next, value.machine_id)
    next = paif_digest_add_i64(next, value.engine_id)
    next = paif_digest_add_i64(next, value.engine_kind)
    next = paif_digest_add_i64(next, value.isa_id)
    next = paif_digest_add_i64(next, value.subject_kind)
    next = paif_digest_add_i64(next, value.subject_node)
    next = paif_digest_add_i64(next, value.quantity)
    next = paif_digest_add_i64(next, value.unit)
    next = paif_digest_add_i64(next, value.scope)
    next = paif_digest_add_i64(next, value.statistic)
    next = paif_digest_add_i64(next, value.requested_samples)
    next = paif_digest_add_i64(next, value.requested_warmups)
    paif_digest_add_i64(next, value.required_environment_mask)
}

fn paif_digest_requirement(
    state: SHA256State, value: &PireusMeasurementInterfaceRequirement,
) -> SHA256State with Mut, Panic, Div {
    var next = paif_digest_request_ref(state, &value.request)
    next = paif_digest_add_i64(next, value.required_native_unit)
    next = paif_digest_add_i64(next, value.required_counter_domain)
    next = paif_digest_add_i64(next, value.required_read_boundary)
    next = paif_digest_add_i64(next, value.required_multiplexing)
    next = paif_digest_add_i64(next, value.required_core_binding)
    let values: [bool; 7] = [
        value.required_counter_width_evidenced,
        value.required_wrap_rule_evidenced,
        value.required_privilege_evidenced,
        value.required_event_semantics_evidenced,
        value.required_binary_hash_bound,
        value.required_command_hash_bound,
        value.required_environment_supplement
    ]
    var i: i64 = 0
    while i < 7 {
        next = paif_digest_add_bool(next, values[i as usize])
        i = i + 1
    }
    next
}

fn paif_digest_candidate(
    state: SHA256State, value: &PireusMeasurementInterfaceCandidate,
) -> SHA256State with Mut, Panic, Div {
    let fields: [i64; 36] = [
        value.candidate_id, value.request_id, value.target_id,
        value.machine_id, value.engine_id, value.subject_kind,
        value.subject_node, value.quantity, value.scope, value.family,
        value.concrete_interface_id, value.access_path, value.counter_source,
        value.native_unit, value.counter_domain, value.event_identity,
        value.event_semantics_evidence, value.read_privilege,
        value.availability_state, value.read_serialization_contract,
        value.core_binding_contract, value.migration_evidence,
        value.multiplexing_state,
        value.counter_width_bits, value.wrap_rule,
        value.read_overhead_contract, value.toolchain_identity,
        value.binary_identity, value.command_identity,
        value.material_receipt_ref, value.material_evidence_ref,
        value.producer_language, value.producer_role,
        value.evidence_origin_count, value.transport_locator_ref,
        value.refusal_reason
    ]
    var next = state
    var i: i64 = 0
    while i < 36 {
        next = paif_digest_add_i64(next, fields[i as usize])
        i = i + 1
    }
    next = paif_digest_add_i64(next, value.refusal_predicate)
    paif_digest_add_bool(next, value.migration_observable)
}

fn paif_digest_observation(
    state: SHA256State, value: &PireusMaterialInterfaceObservation,
) -> SHA256State with Mut, Panic, Div {
    var next = paif_digest_add_bool(state, value.present)
    next = paif_digest_candidate(next, &value.candidate)
    next = paif_digest_add_i64(next, value.sounio_source_ref)
    next = paif_digest_add_i64(next, value.sounio_semantics_ref)
    next = paif_digest_add_i64(next, value.candidate_manifest_ref)
    next = paif_digest_add_i64(next, value.hardware_identity_ref)
    next = paif_digest_add_i64(next, value.host_key_identity_ref)
    next = paif_digest_add_i64(next, value.environment_record_ref)
    paif_digest_add_i64(next, value.raw_result_ref)
}

fn paif_digest_negatives(
    state: SHA256State, value: &PireusAppleInterfaceNegatives,
) -> SHA256State with Mut, Panic, Div {
    let values: [bool; 32] = [
        value.direct_parent_drift, value.parent_semantics_not_live,
        value.request_id_drift, value.material_identity_drift,
        value.foreign_target_or_engine, value.subject_widened,
        value.request_contract_drift, value.timer_ticks_as_cycles,
        value.nanoseconds_as_cycles, value.frequency_estimate_as_native,
        value.name_only_event_semantics, value.absent_source_or_domain,
        value.privilege_unknown_as_available, value.multiplexed_as_native,
        value.width_or_wrap_absent, value.unserialized_reads,
        value.migration_unsafe_as_native,
        value.advisory_affinity_as_enforced,
        value.merged_candidate_evidence,
        value.manifest_closed_without_evidence,
        value.one_refusal_as_universal,
        value.conflicting_evidence_silenced,
        value.locator_as_interface_evidence,
        value.transport_failure_as_falsification,
        value.environment_inferred, value.authorization_inferred,
        value.value_or_summary_inserted, value.cpp_as_semantic_authority,
        value.external_review_as_material, value.forbidden_python_or_rust,
        value.premature_parity_or_claim, value.sibling_machine_inference
    ]
    var next = state
    var i: i64 = 0
    while i < 32 {
        next = paif_digest_add_bool(next, values[i as usize])
        i = i + 1
    }
    next = paif_digest_add_i64(next, value.passed)
    paif_digest_add_i64(next, value.total)
}

fn paif_result_digest(
    parent_mask: i64,
    parent_manifest: &PireusAppleInterfaceDigest,
    parent: &PireusAppleCpuLatencyRequestResult,
    requirement: &PireusMeasurementInterfaceRequirement,
    manifest: &PireusInterfaceCandidateManifest,
    assessment: &PireusInterfaceAssessmentRequest,
    observations: &PireusMaterialInterfaceObservationSet,
    decision: &PireusInterfaceFeasibilityDecision,
    authorization: &PireusExecutionAuthorizationRef,
    cost: &PireusCostObservation,
    ontology_count: i64,
    ontology_digest: &PireusAppleInterfaceDigest,
    boundaries: &[bool; 15],
    negatives: &PireusAppleInterfaceNegatives,
) -> PireusAppleInterfaceDigest with Mut, Panic, Div {
    var state = sha256_init()
    state = paif_digest_add_string(state,
        "SOUNIO-PIREUS-APPLE-CPU-DEPENDENCY-LATENCY-INTERFACE-FEASIBILITY")
    state = paif_digest_add_string(state,
        "pireus.apple-cpu-interface-feasibility.v0")
    state = paif_digest_add_i64(state, parent_mask)
    state = paif_digest_add_words(state, &parent_manifest.words)
    state = paif_digest_add_words(state, &parent.result_digest.words)
    state = paif_digest_requirement(state, requirement)
    state = paif_digest_add_i64(state, manifest.family_count)
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_FAMILY_COUNT {
        state = paif_digest_add_i64(state, manifest.families[i as usize])
        i = i + 1
    }
    state = paif_digest_add_bool(state, manifest.closed)
    state = paif_digest_add_i64(state, assessment.request_id)
    state = paif_digest_add_i64(state, assessment.machine_id)
    state = paif_digest_add_i64(state, assessment.engine_id)
    state = paif_digest_add_i64(state, assessment.family_count)
    state = paif_digest_add_i64(state, assessment.material_candidate_count)
    state = paif_digest_add_i64(state,
        assessment.execution_authorization_id)
    state = paif_digest_add_bool(state, assessment.value_present)
    state = paif_digest_add_bool(state, observations.evidence_received)
    state = paif_digest_add_bool(state, observations.classification_requested)
    state = paif_digest_add_i64(state, observations.candidate_manifest_ref)
    state = paif_digest_add_i64(state, observations.declared_candidate_count)
    state = paif_digest_add_bool(state, observations.manifest_closed)
    state = paif_digest_add_i64(state, observations.closure_evidence_ref)
    state = paif_digest_add_bool(state, observations.transport_failure)
    state = paif_digest_observation(state, &observations.o0)
    state = paif_digest_observation(state, &observations.o1)
    state = paif_digest_observation(state, &observations.o2)
    state = paif_digest_observation(state, &observations.o3)
    state = paif_digest_observation(state, &observations.o4)
    state = paif_digest_observation(state, &observations.o5)
    let decision_fields: [i64; 8] = [
        decision.stage, decision.verdict, decision.candidate_count,
        decision.complete_terminal_count, decision.feasible_count,
        decision.refusal_count, decision.cycle_ineligible_count,
        decision.feasible_candidate_id
    ]
    i = 0
    while i < 8 {
        state = paif_digest_add_i64(state, decision_fields[i as usize])
        i = i + 1
    }
    state = paif_digest_add_bool(state, decision.manifest_closed)
    state = paif_digest_add_bool(state, authorization.present)
    state = paif_digest_add_i64(state, authorization.authorization_id)
    state = paif_digest_add_bool(state, cost.present)
    state = paif_digest_add_i64(state, cost.unit)
    state = paif_digest_add_i64(state, cost.sample_count)
    state = paif_digest_add_i64(state, cost.estimate_numerator)
    state = paif_digest_add_i64(state, cost.estimate_denominator)
    state = paif_digest_add_i64(state, cost.raw_result_ref)
    i = 0
    while i < 15 {
        state = paif_digest_add_bool(state, boundaries[i as usize])
        i = i + 1
    }
    state = paif_digest_add_i64(state, ontology_count)
    state = paif_digest_add_words(state, &ontology_digest.words)
    state = paif_digest_negatives(state, negatives)
    paif_digest_finish(state)
}

pub fn pireus_apple_cpu_dependency_latency_interface_feasibility_evaluate(
    pdf_path: string,
    xed_path: string,
    material_files: &PireusXorMaterialFilePaths,
    parent_paths: &PireusAppleInterfaceParentPaths,
) -> PireusAppleInterfaceFeasibilityResult
with IO, Mut, Panic, Div, Alloc, Epistemic {
    let parent_mask = paif_parent_match_mask(parent_paths)
    var parent_count: i64 = 0
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT {
        if pireus_apple_interface_parent_file_matches(parent_mask, i) {
            parent_count = parent_count + 1
        }
        i = i + 1
    }
    let parent_files_valid = paif_all_parents_match(parent_mask)
    let parent_manifest = paif_parent_manifest_digest(parent_paths)
    let parent = pireus_apple_cpu_dependency_latency_request_evaluate(
        pdf_path, xed_path, material_files, &parent_paths.request_parents)
    let parent_live =
        pireus_apple_cpu_dependency_latency_request_matches_frozen_semantics(
            &parent)
    let request_ref = paif_request_ref(&parent)
    let requirement = paif_requirement(&request_ref)
    let manifest = paif_manifest()
    let assessment = paif_assessment(&request_ref, &manifest)
    let observations = paif_empty_observation_set()
    let decision = pireus_apple_interface_classify(&observations, &requirement)
    let authorization = PireusExecutionAuthorizationRef {
        present: false, authorization_id: 0,
    }
    let cost = PireusCostObservation {
        present: false, unit: PIREUS_COST_UNIT_CYCLE, sample_count: 0,
        estimate_numerator: 0, estimate_denominator: 0, raw_result_ref: 0,
    }
    let requirement_valid = pireus_apple_interface_requirement_valid(
        &requirement, parent_live)
    let manifest_valid = pireus_apple_interface_manifest_valid(&manifest)
    let assessment_valid = pireus_apple_interface_assessment_valid(
        &assessment, &requirement, &manifest, parent_live)
    let observations_valid =
        pireus_apple_interface_observation_set_valid(&observations)
    let decision_valid = pireus_apple_interface_decision_matches_inputs(
        &decision, &observations, &requirement)
    let remote_execution = false
    let environment_bound = false
    let harness_frozen = false
    let measurand_validated = false
    let parity_open = false
    let claim_ready = false

    var ontology_output: [i64; 9] = [0; 9]
    let ontology_valid = paif_ontology_projection(
        &requirement, &manifest, &decision, &!ontology_output)
    let ontology_count = ontology_output[0]
    var ontology_words: [i64; 8] = [0; 8]
    i = 0
    while i < 8 {
        ontology_words[i as usize] = ontology_output[(i + 1) as usize]
        i = i + 1
    }
    let ontology_digest = PireusAppleInterfaceDigest {
        words: ontology_words,
    }
    let negatives = paif_exercise_negatives(parent_mask, &requirement)
    let boundaries: [bool; 15] = [
        parent_files_valid, parent_live, requirement_valid, manifest_valid,
        assessment_valid, observations_valid, decision_valid,
        remote_execution, environment_bound, harness_frozen,
        measurand_validated, authorization.present, cost.present,
        parity_open, claim_ready
    ]
    var error = PIREUS_APPLE_INTERFACE_OK
    if !parent_files_valid || !parent_live {
        error = PIREUS_APPLE_INTERFACE_ERR_PARENT
    } else if !requirement_valid || !manifest_valid {
        error = PIREUS_APPLE_INTERFACE_ERR_REQUIREMENT
    } else if !assessment_valid || !observations_valid {
        error = PIREUS_APPLE_INTERFACE_ERR_ASSESSMENT
    } else if !decision_valid ||
        decision.stage != PIREUS_INTERFACE_STAGE_ASSESSMENT_REQUESTED ||
        decision.verdict != PIREUS_INTERFACE_VERDICT_UNASSESSED ||
        decision.candidate_count != 0 {
        error = PIREUS_APPLE_INTERFACE_ERR_CLASSIFIER
    } else if remote_execution || environment_bound || harness_frozen ||
        measurand_validated || authorization.present || cost.present ||
        parity_open || claim_ready ||
        negatives.passed != negatives.total {
        error = PIREUS_APPLE_INTERFACE_ERR_AUTHORITY
    } else if !ontology_valid || ontology_count <= 0 {
        error = PIREUS_APPLE_INTERFACE_ERR_ONTOLOGY
    }
    let failures = if error == PIREUS_APPLE_INTERFACE_OK { 0 } else { 1 }
    let digest = paif_result_digest(
        parent_mask, &parent_manifest, &parent, &requirement, &manifest,
        &assessment, &observations, &decision, &authorization, &cost,
        ontology_count,
        &ontology_digest, &boundaries, &negatives)

    PireusAppleInterfaceFeasibilityResult {
        valid: error == PIREUS_APPLE_INTERFACE_OK && failures == 0,
        error: error,
        parent_file_match_mask: parent_mask,
        parent_file_match_count: parent_count,
        parent_files_valid: parent_files_valid,
        request_parent_live: parent_live,
        parent: parent,
        request_ref: request_ref,
        requirement: requirement,
        manifest: manifest,
        assessment: assessment,
        observations: observations,
        decision: decision,
        authorization: authorization,
        cost: cost,
        requirement_valid: requirement_valid,
        manifest_valid: manifest_valid,
        assessment_valid: assessment_valid,
        observations_valid: observations_valid,
        decision_valid: decision_valid,
        remote_execution: remote_execution,
        environment_bound: environment_bound,
        harness_frozen: harness_frozen,
        measurand_validated: measurand_validated,
        parity_open: parity_open,
        claim_ready: claim_ready,
        ontology_triple_count: ontology_count,
        ontology_valid: ontology_valid,
        parent_manifest_digest: parent_manifest,
        ontology_digest: ontology_digest,
        result_digest: digest,
        negatives: negatives,
        failures: failures,
    }
}

pub fn pireus_apple_cpu_dependency_latency_interface_feasibility_matches_frozen_semantics(
    result: &PireusAppleInterfaceFeasibilityResult,
) -> bool with Mut, Panic {
    if !result.valid || result.error != PIREUS_APPLE_INTERFACE_OK ||
        result.failures != 0 || !result.parent_files_valid ||
        result.parent_file_match_count !=
            PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT ||
        !result.request_parent_live {
        return false
    }
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT {
        if !pireus_apple_interface_parent_file_matches(
            result.parent_file_match_mask, i) {
            return false
        }
        i = i + 1
    }
    if result.request_ref.request_id != PIREUS_APPLE_CPU_LATENCY_REQUEST_ID ||
        result.request_ref.target_id != PIREUS_TARGET_APPLE_SILICON ||
        result.request_ref.machine_id != PIREUS_MACHINE_APPLE_MAC17_7 ||
        result.request_ref.engine_id != PIREUS_ENGINE_CPU_APPLE_M5_MAX ||
        result.request_ref.engine_kind != PIREUS_ENGINE_KIND_CPU ||
        result.request_ref.isa_id != PIREUS_ENGINE_ISA_AARCH64 ||
        result.request_ref.subject_kind != PIREUS_COST_SUBJECT_LOWERING_NODE ||
        result.request_ref.subject_node != 0 ||
        result.request_ref.quantity != PIREUS_COST_DEPENDENCY_LATENCY ||
        result.request_ref.unit != PIREUS_COST_UNIT_CYCLE ||
        result.request_ref.scope != PIREUS_COST_SCOPE_DEPENDENCY_CHAIN ||
        result.request_ref.statistic != PIREUS_COST_STAT_MEDIAN ||
        result.request_ref.requested_samples != 1001 ||
        result.request_ref.requested_warmups != 128 ||
        result.request_ref.required_environment_mask != 2047 {
        return false
    }
    if !result.requirement_valid ||
        result.requirement.required_native_unit != PIREUS_COST_UNIT_CYCLE ||
        result.requirement.required_counter_domain !=
            PIREUS_INTERFACE_COUNTER_DOMAIN_EXECUTING_CPU_CORE ||
        result.requirement.required_read_boundary !=
            PIREUS_INTERFACE_READ_SERIALIZED_BEFORE_AFTER ||
        result.requirement.required_multiplexing !=
            PIREUS_INTERFACE_MULTIPLEXING_DISALLOWED ||
        result.requirement.required_core_binding !=
            PIREUS_INTERFACE_CORE_MIGRATION_DETECTED_REJECTED ||
        !result.requirement.required_counter_width_evidenced ||
        !result.requirement.required_wrap_rule_evidenced ||
        !result.requirement.required_privilege_evidenced ||
        !result.requirement.required_event_semantics_evidenced ||
        !result.requirement.required_binary_hash_bound ||
        !result.requirement.required_command_hash_bound ||
        !result.requirement.required_environment_supplement {
        return false
    }
    let expected_families: [i64; 6] = [
        PIREUS_INTERFACE_FAMILY_CORE_CYCLE_COUNTER,
        PIREUS_INTERFACE_FAMILY_PROCESS_PMU_CYCLE_EVENT,
        PIREUS_INTERFACE_FAMILY_SYSTEM_TRACE_CYCLE_EVENT,
        PIREUS_INTERFACE_FAMILY_ARCHITECTURAL_TIMER_TICK,
        PIREUS_INTERFACE_FAMILY_OS_MONOTONIC_TIME,
        PIREUS_INTERFACE_FAMILY_FREQUENCY_DERIVED_ESTIMATE
    ]
    if !result.manifest_valid ||
        result.manifest.family_count != PIREUS_APPLE_INTERFACE_FAMILY_COUNT ||
        result.manifest.closed {
        return false
    }
    i = 0
    while i < PIREUS_APPLE_INTERFACE_FAMILY_COUNT {
        if result.manifest.families[i as usize] !=
            expected_families[i as usize] {
            return false
        }
        i = i + 1
    }
    if !result.assessment_valid ||
        result.assessment.request_id != PIREUS_APPLE_CPU_LATENCY_REQUEST_ID ||
        result.assessment.machine_id != PIREUS_MACHINE_APPLE_MAC17_7 ||
        result.assessment.engine_id != PIREUS_ENGINE_CPU_APPLE_M5_MAX ||
        result.assessment.family_count != PIREUS_APPLE_INTERFACE_FAMILY_COUNT ||
        result.assessment.material_candidate_count != 0 ||
        result.assessment.execution_authorization_id != 0 ||
        result.assessment.value_present {
        return false
    }
    if !result.observations_valid ||
        result.observations.evidence_received ||
        result.observations.classification_requested ||
        result.observations.candidate_manifest_ref != 0 ||
        result.observations.declared_candidate_count != 0 ||
        result.observations.manifest_closed ||
        result.observations.closure_evidence_ref != 0 ||
        result.observations.transport_failure ||
        result.observations.o0.present || result.observations.o1.present ||
        result.observations.o2.present || result.observations.o3.present ||
        result.observations.o4.present || result.observations.o5.present {
        return false
    }
    if !result.decision_valid ||
        result.decision.stage != PIREUS_INTERFACE_STAGE_ASSESSMENT_REQUESTED ||
        result.decision.verdict != PIREUS_INTERFACE_VERDICT_UNASSESSED ||
        result.decision.candidate_count != 0 ||
        result.decision.complete_terminal_count != 0 ||
        result.decision.feasible_count != 0 ||
        result.decision.refusal_count != 0 ||
        result.decision.cycle_ineligible_count != 0 ||
        result.decision.feasible_candidate_id != 0 ||
        result.decision.manifest_closed {
        return false
    }
    if result.authorization.present ||
        result.authorization.authorization_id != 0 ||
        result.cost.present || result.cost.unit != PIREUS_COST_UNIT_CYCLE ||
        result.cost.sample_count != 0 ||
        result.cost.estimate_numerator != 0 ||
        result.cost.estimate_denominator != 0 ||
        result.cost.raw_result_ref != 0 || result.remote_execution ||
        result.environment_bound || result.harness_frozen ||
        result.measurand_validated || result.parity_open ||
        result.claim_ready || result.ontology_triple_count != 25 ||
        !result.ontology_valid {
        return false
    }
    if result.negatives.passed != PIREUS_APPLE_INTERFACE_NEGATIVE_COUNT ||
        result.negatives.total != PIREUS_APPLE_INTERFACE_NEGATIVE_COUNT ||
        !result.negatives.direct_parent_drift ||
        !result.negatives.parent_semantics_not_live ||
        !result.negatives.request_id_drift ||
        !result.negatives.material_identity_drift ||
        !result.negatives.foreign_target_or_engine ||
        !result.negatives.subject_widened ||
        !result.negatives.request_contract_drift ||
        !result.negatives.timer_ticks_as_cycles ||
        !result.negatives.nanoseconds_as_cycles ||
        !result.negatives.frequency_estimate_as_native ||
        !result.negatives.name_only_event_semantics ||
        !result.negatives.absent_source_or_domain ||
        !result.negatives.privilege_unknown_as_available ||
        !result.negatives.multiplexed_as_native ||
        !result.negatives.width_or_wrap_absent ||
        !result.negatives.unserialized_reads ||
        !result.negatives.migration_unsafe_as_native ||
        !result.negatives.advisory_affinity_as_enforced ||
        !result.negatives.merged_candidate_evidence ||
        !result.negatives.manifest_closed_without_evidence ||
        !result.negatives.one_refusal_as_universal ||
        !result.negatives.conflicting_evidence_silenced ||
        !result.negatives.locator_as_interface_evidence ||
        !result.negatives.transport_failure_as_falsification ||
        !result.negatives.environment_inferred ||
        !result.negatives.authorization_inferred ||
        !result.negatives.value_or_summary_inserted ||
        !result.negatives.cpp_as_semantic_authority ||
        !result.negatives.external_review_as_material ||
        !result.negatives.forbidden_python_or_rust ||
        !result.negatives.premature_parity_or_claim ||
        !result.negatives.sibling_machine_inference {
        return false
    }
    let expected_parent_manifest: [i64; 8] = [
        3519613688, 585074947, 3796294859, 195503079,
        3757313902, 1414521947, 791258454, 3618061202
    ]
    let expected_ontology: [i64; 8] = [
        19739672, 3332345842, 2129057504, 398490585,
        1926487274, 3200654896, 4045422321, 2496634919
    ]
    let expected_result: [i64; 8] = [
        175669911, 1759239310, 3072997883, 3130912607,
        2026014757, 2084589116, 1191266368, 4096324446
    ]
    paif_hash_equal(
        &result.parent_manifest_digest.words, &expected_parent_manifest) &&
        paif_hash_equal(&result.ontology_digest.words, &expected_ontology) &&
        paif_hash_equal(&result.result_digest.words, &expected_result)
}
