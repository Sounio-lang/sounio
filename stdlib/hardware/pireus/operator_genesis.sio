//! Sounio authority for bounded generation of operator novelty candidates.
//!
//! v0 exhausts a 16-member TwistedXor16 grammar, canonicalizes each sign
//! table under 48 declared actions, and measures exact Hamming distance to a
//! three-operator frozen internal corpus. Novelty remains corpus- and
//! group-relative; no historical, material, or scientific novelty is emitted.

use algebra::cayley_dickson::cd_sigma
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

pub const PIREUS_GENESIS_SCHEMA: i64 = 720000
pub const PIREUS_GENESIS_BITS: i64 = 4
pub const PIREUS_GENESIS_DIMENSION: i64 = 16
pub const PIREUS_GENESIS_CANDIDATE_COUNT: i64 = 16
pub const PIREUS_GENESIS_PERMUTATION_COUNT: i64 = 24
pub const PIREUS_GENESIS_ACTION_COUNT: i64 = 48
pub const PIREUS_GENESIS_CORPUS_COUNT: i64 = 3
pub const PIREUS_GENESIS_COMPARISONS_PER_CANDIDATE: i64 = 144
pub const PIREUS_GENESIS_SEED: i64 = 9

pub const PIREUS_GENESIS_LANGUAGE_SOUNIO: i64 = 1
pub const PIREUS_GENESIS_LANGUAGE_LEAN: i64 = 2
pub const PIREUS_GENESIS_LANGUAGE_KOKA: i64 = 3
