pub const PIREUS_GENESIS_ROLE_MATERIAL_PARITY: i64 = 4
pub const PIREUS_GENESIS_ROLE_DENOTATIONAL_BASELINE: i64 = 5
pub const PIREUS_GENESIS_ROLE_REVIEW_ONLY: i64 = 6
pub const PIREUS_GENESIS_ROLE_FORBIDDEN_ORACLE: i64 = 7

pub const PIREUS_GENESIS_STAGE_GARDEN: i64 = 1
pub const PIREUS_GENESIS_STAGE_SOUNIO_EXECUTABLE: i64 = 2
pub const PIREUS_GENESIS_STAGE_SEMANTICS_FROZEN: i64 = 3
pub const PIREUS_GENESIS_STAGE_PARITY_OPEN: i64 = 4
pub const PIREUS_GENESIS_STAGE_CLAIM_READY: i64 = 5

pub const PIREUS_GENESIS_CORPUS_UNTWISTED_XOR: i64 = 1
pub const PIREUS_GENESIS_CORPUS_CAYLEY_DICKSON_16: i64 = 2
