fn olf_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn olf_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div, Epistemic {
    olf_digest_add_i64(state, if value { 1 } else { 0 })
}

fn olf_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var next = state
    var index: i64 = 0
    while index < 8 {
        next = olf_digest_add_i64(next, words[index])
        index = index + 1
    }
    next
}

fn olf_digest_finish(state: SHA256State) -> PireusOlfDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOlfDigest { words: words }
}

pub fn pireus_olf_digest_nonzero(digest: &PireusOlfDigest) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < 8 {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

pub fn pireus_operator_lowering_request() -> PireusOlfRequest {
    PireusOlfRequest {
        producer_language: PIREUS_OLF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_OLF_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_OLF_STAGE_SOUNIO_EXECUTABLE,
        policy_present: true,
        parent_present: true,
        parent_semantics_frozen: true,
        parent_source_bound: true,
        parent_semantics_bound: true,
        parent_freeze_bound: true,
        parent_transcript_bound: true,
        parent_parity_receipt_bound: true,
        declared_node_count: PIREUS_OLF_NODE_COUNT,
        declared_pack_count: PIREUS_OLF_PACK_COUNT,
        declared_route_count: PIREUS_OLF_ROUTE_COUNT,
        declared_serialization_count: PIREUS_OLF_SERIALIZATION_COUNT,
        declared_target_count: PIREUS_OLF_TARGET_COUNT,
        declared_obligation_count: PIREUS_OLF_OBLIGATION_COUNT,
        expected_candidate_count_present: false,
        expected_program_classes_present: false,
        expected_residual_present: false,
        expected_seed_present: false,
        expected_digest_present: false,
        selection_requested: false,
        ranking_present: false,
        target_observation_count: 0,
        material_receipt_count: 0,
        admitted_lowering_count: 0,
        cost_record_count: 0,
        performance_record_count: 0,
        semantic_write_from_parity: false,
        expected_result_write_from_parity: false,
        external_review_promoted: false,
        algorithmic_novelty_requested: false,
        material_novelty_requested: false,
        historical_novelty_requested: false,
        priority_requested: false,
        semantics_frozen: false,
        parity_requested: false,
        claim_ready_requested: false,
        waiver_present: false,
        waiver_founder: false,
        waiver_scoped: false,
        waiver_purpose_bound: false,
        waiver_live: false,
    }
}

fn olf_request_error(request: &PireusOlfRequest) -> i64 {
    if request.producer_language != PIREUS_OLF_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_OLF_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_OLF_ERR_AUTHORITY
    }
    if request.stage != PIREUS_OLF_STAGE_SOUNIO_EXECUTABLE ||
        request.semantics_frozen || request.parity_requested {
        return PIREUS_OLF_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_OLF_ERR_POLICY }
    if !request.parent_present || !request.parent_semantics_frozen ||
        !request.parent_source_bound || !request.parent_semantics_bound ||
        !request.parent_freeze_bound || !request.parent_transcript_bound ||
        !request.parent_parity_receipt_bound {
        return PIREUS_OLF_ERR_PARENT
    }
    if request.declared_node_count != PIREUS_OLF_NODE_COUNT ||
        request.declared_pack_count != PIREUS_OLF_PACK_COUNT ||
        request.declared_route_count != PIREUS_OLF_ROUTE_COUNT ||
        request.declared_serialization_count !=
            PIREUS_OLF_SERIALIZATION_COUNT ||
        request.declared_target_count != PIREUS_OLF_TARGET_COUNT ||
        request.declared_obligation_count != PIREUS_OLF_OBLIGATION_COUNT {
        return PIREUS_OLF_ERR_GRAMMAR
    }
    if request.expected_candidate_count_present ||
        request.expected_program_classes_present ||
        request.expected_residual_present || request.expected_seed_present ||
        request.expected_digest_present {
        return PIREUS_OLF_ERR_RESULT_INJECTION
    }
    if request.selection_requested || request.ranking_present {
        return PIREUS_OLF_ERR_SELECTION
    }
    if request.target_observation_count != 0 ||
        request.material_receipt_count != 0 ||
        request.admitted_lowering_count != 0 ||
        request.cost_record_count != 0 ||
        request.performance_record_count != 0 {
        return PIREUS_OLF_ERR_MATERIAL
    }
    if request.semantic_write_from_parity ||
        request.expected_result_write_from_parity ||
        request.external_review_promoted ||
        request.algorithmic_novelty_requested ||
        request.material_novelty_requested ||
        request.historical_novelty_requested || request.priority_requested ||
        request.claim_ready_requested {
        return PIREUS_OLF_ERR_CLAIM
    }
    if request.waiver_present && !(request.waiver_founder &&
        request.waiver_scoped && request.waiver_purpose_bound &&
        request.waiver_live) {
        return PIREUS_OLF_ERR_WAIVER
    }
    PIREUS_OLF_OK
}

fn olf_copy_parent_digest(digest: &PireusQuotientDigest) -> [i64; 8]
with Mut, Panic {
    var words: [i64; 8] = [0; 8]
    var index: i64 = 0
    while index < 8 {
        words[index] = digest.words[index]
        index = index + 1
    }
    words
}

fn olf_build_lineage(parent: &PireusQuotientResult)
    -> PireusOlfLineage with Mut, Panic, Div, Epistemic {
    let parent_live_match =
        pireus_quotient_novelty_matches_frozen_semantics(parent)
    let parent_operator_classes =
        parent.atlas.class_counts[PIREUS_QUOTIENT_PROFILE_PARENT]
    let parent_selected_child = -1
    let parent_ranking_present = false
    let complete = parent.valid && parent_live_match &&
        parent.receipt.no_child_selected && parent_operator_classes > 0
    PireusOlfLineage {
        parent_forge_digest: olf_copy_parent_digest(&parent.forge_digest),
        parent_live_match: parent_live_match,
        parent_valid: parent.valid,
        parent_semantics_frozen: parent_live_match,
        parent_operator_classes: parent_operator_classes,
        parent_selected_child: parent_selected_child,
        parent_ranking_present: parent_ranking_present,
        complete: complete,
    }
}

fn olf_build_grammar() -> PireusOlfGraphGrammar
with Mut, Panic, Div {
    let node_kinds: [i64; 9] = [
        PIREUS_OLF_NODE_SOURCE_LOAD,
        PIREUS_OLF_NODE_XOR_PARTNER,
        PIREUS_OLF_NODE_SIGN_MAP,
        PIREUS_OLF_NODE_ORDERED_PRODUCT,
        PIREUS_OLF_NODE_ORDERED_FOLD,
        PIREUS_OLF_NODE_DESTINATION_STORE,
        PIREUS_OLF_NODE_LANE_PACK,
        PIREUS_OLF_NODE_LANE_UNPACK,
        PIREUS_OLF_NODE_TARGET_PRIMITIVE
    ]
    let pack_widths: [i64; 5] = [1, 2, 4, 8, 16]
    let route_kinds: [i64; 2] = [
        PIREUS_OLF_ROUTE_DIRECT, PIREUS_OLF_ROUTE_COMPOSED
    ]
    let serialization_kinds: [i64; 2] = [
        PIREUS_OLF_SERIALIZATION_CANONICAL,
        PIREUS_OLF_SERIALIZATION_ALTERNATE
    ]

    var node_checks: i64 = 0
    var node_failures: i64 = 0
    var i: i64 = 0
    while i < PIREUS_OLF_NODE_COUNT {
        node_checks = node_checks + 1
        if node_kinds[i] <= 0 { node_failures = node_failures + 1 }
        var j: i64 = i + 1
        while j < PIREUS_OLF_NODE_COUNT {
            node_checks = node_checks + 1
            if node_kinds[i] == node_kinds[j] {
                node_failures = node_failures + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    var pack_checks: i64 = 0
    var pack_failures: i64 = 0
    i = 0
    while i < PIREUS_OLF_PACK_COUNT {
        pack_checks = pack_checks + 1
        let width = pack_widths[i]
        if width <= 0 || (PIREUS_OLF_DIMENSION / width) * width !=
            PIREUS_OLF_DIMENSION {
            pack_failures = pack_failures + 1
        }
        if i > 0 {
            pack_checks = pack_checks + 1
            if pack_widths[i - 1] >= width {
                pack_failures = pack_failures + 1
            }
        }
        i = i + 1
    }

    var route_checks: i64 = 0
    var route_failures: i64 = 0
    i = 0
    while i < PIREUS_OLF_ROUTE_COUNT {
        route_checks = route_checks + 1
        if route_kinds[i] <= 0 { route_failures = route_failures + 1 }
        i = i + 1
    }

    var serialization_checks: i64 = 0
    var serialization_failures: i64 = 0
    i = 0
    while i < PIREUS_OLF_SERIALIZATION_COUNT {
        serialization_checks = serialization_checks + 1
        if serialization_kinds[i] <= 0 {
            serialization_failures = serialization_failures + 1
        }
        i = i + 1
    }

    var shape_checks: i64 = 2
    var shape_failures: i64 = 0
    if PIREUS_OLF_DIMENSION != (1 << PIREUS_OLF_BITS) {
        shape_failures = shape_failures + 1
    }
    if PIREUS_OLF_CELL_COUNT !=
        PIREUS_OLF_DIMENSION * PIREUS_OLF_DIMENSION {
        shape_failures = shape_failures + 1
    }

    PireusOlfGraphGrammar {
        node_kinds: node_kinds,
        pack_widths: pack_widths,
        route_kinds: route_kinds,
        serialization_kinds: serialization_kinds,
        node_checks: node_checks,
        node_failures: node_failures,
        pack_checks: pack_checks,
        pack_failures: pack_failures,
        route_checks: route_checks,
        route_failures: route_failures,
        serialization_checks: serialization_checks,
        serialization_failures: serialization_failures,
        shape_checks: shape_checks,
        shape_failures: shape_failures,
        complete: node_failures == 0 && pack_failures == 0 &&
            route_failures == 0 && serialization_failures == 0 &&
            shape_checks == 2 && shape_failures == 0,
    }
}

fn olf_build_targets() -> PireusOlfTargetAtlas with Mut, Panic {
    let target_ids: [i64; 4] = [
        PIREUS_OLF_TARGET_XEON, PIREUS_OLF_TARGET_APPLE,
        PIREUS_OLF_TARGET_DGX, PIREUS_OLF_TARGET_U250
    ]
    let endpoint_requirements: [i64; 4] = [1, 1, 2, 2]
    let observed_endpoints: [i64; 4] = [0; 4]
    let material_receipts: [i64; 4] = [0; 4]
    let primitive_candidates: [i64; 4] = [
        PIREUS_OLF_PRIMITIVE_XEON_SELECTOR,
        PIREUS_OLF_PRIMITIVE_APPLE_TABLE,
        PIREUS_OLF_PRIMITIVE_DGX_SUBGROUP_XOR,
        PIREUS_OLF_PRIMITIVE_U250_FABRIC
    ]
    let candidate_only: [bool; 4] = [true; 4]

    var checks: i64 = 0
    var failures: i64 = 0
    var required: i64 = 0
    var observed: i64 = 0
    var target: i64 = 0
    while target < PIREUS_OLF_TARGET_COUNT {
        checks = checks + 1
        if target_ids[target] <= 0 || endpoint_requirements[target] <= 0 ||
            primitive_candidates[target] <= 0 || !candidate_only[target] ||
            observed_endpoints[target] != 0 ||
            material_receipts[target] != 0 {
            failures = failures + 1
        }
        var other: i64 = target + 1
        while other < PIREUS_OLF_TARGET_COUNT {
            checks = checks + 1
            if target_ids[target] == target_ids[other] {
                failures = failures + 1
            }
            other = other + 1
        }
        required = required + endpoint_requirements[target]
        observed = observed + observed_endpoints[target]
        target = target + 1
    }

    PireusOlfTargetAtlas {
        target_ids: target_ids,
        endpoint_requirements: endpoint_requirements,
        observed_endpoints: observed_endpoints,
        material_receipts: material_receipts,
        primitive_candidates: primitive_candidates,
        candidate_only: candidate_only,
        target_checks: checks,
        target_failures: failures,
        required_endpoints: required,
        observed_endpoint_total: observed,
        unresolved_endpoints: required - observed,
        complete: failures == 0 && required > 0 && observed == 0,
    }
}

fn olf_table_bit(parent: &PireusQuotientResult, child: i64, cell: i64)
    -> i64 with Panic, Div {
    let word = cell / 32
    let bit = cell - word * 32
    (parent.atlas.raw_table_words[child * 8 + word] >> bit) & 1
}

fn olf_build_semantics(parent: &PireusQuotientResult)
    -> PireusOlfSemanticCertificate with Mut, Panic, Div {
    let parent_classes =
        parent.atlas.class_counts[PIREUS_QUOTIENT_PROFILE_PARENT]
    let classes = if PIREUS_QUOTIENT_CHILD_COUNT == 48 &&
        parent_classes >= 0 && parent_classes <= 48 {
        parent_classes
    } else { 0 }
    var representatives: [i64; 48] = [-1; 48]
    var representative_checks: i64 = 0
    var representative_failures: i64 = 0
    var parent_relation_checks: i64 = 0
    var parent_relation_failures: i64 = 0
    var partner_checks: i64 = 0
    var partner_failures: i64 = 0
    var sign_checks: i64 = 0
    var sign_failures: i64 = 0
    var roundtrip_word_checks: i64 = 0
    var roundtrip_word_failures: i64 = 0
    var order_checks: i64 = 0
    var order_failures: i64 = 0
    var destination_checks: i64 = 0
    var destination_failures: i64 = 0

    var class_id: i64 = 0
    while class_id < classes {
        let slot = PIREUS_QUOTIENT_PROFILE_PARENT *
            PIREUS_QUOTIENT_CHILD_COUNT + class_id
        let child = parent.atlas.class_representatives[slot]
        representatives[class_id] = child
        representative_checks = representative_checks + 1
        if child < 0 || child >= PIREUS_QUOTIENT_CHILD_COUNT {
            representative_failures = representative_failures + 1
        } else {
            let child_slot = PIREUS_QUOTIENT_PROFILE_PARENT *
                PIREUS_QUOTIENT_CHILD_COUNT + child
            parent_relation_checks = parent_relation_checks + 2
            if parent.atlas.child_class_ids[child_slot] != class_id {
                parent_relation_failures = parent_relation_failures + 1
            }
            if parent.atlas.child_representatives[child_slot] != child {
                parent_relation_failures = parent_relation_failures + 1
            }
            var reconstructed_words: [i64; 8] = [0; 8]
            var source_word: i64 = 0
            while source_word < 8 {
                let raw = parent.atlas.raw_table_words[
                    child * 8 + source_word]
                sign_checks = sign_checks + 1
                if raw < 0 || raw > 4294967295 {
                    sign_failures = sign_failures + 1
                }
                source_word = source_word + 1
            }
            var destination: i64 = 0
            while destination < PIREUS_OLF_DIMENSION {
                var source: i64 = 0
                var previous: i64 = -1
                while source < PIREUS_OLF_DIMENSION {
                    let partner = source ^ destination
                    partner_checks = partner_checks + 1
                    if partner < 0 || partner >= PIREUS_OLF_DIMENSION {
                        partner_failures = partner_failures + 1
                    }
                    destination_checks = destination_checks + 1
                    if (source ^ partner) != destination {
                        destination_failures = destination_failures + 1
                    }
                    let sign = olf_table_bit(
                        parent, child, source * PIREUS_OLF_DIMENSION + partner)
                    if sign == 1 {
                        let cell = source * PIREUS_OLF_DIMENSION + partner
                        let word = cell / 32
                        let bit = cell - word * 32
                        reconstructed_words[word] =
                            reconstructed_words[word] | (1 << bit)
                    }
                    order_checks = order_checks + 1
                    if source != previous + 1 {
                        order_failures = order_failures + 1
                    }
                    previous = source
                    source = source + 1
                }
                destination = destination + 1
            }
            source_word = 0
            while source_word < 8 {
                roundtrip_word_checks = roundtrip_word_checks + 1
                if reconstructed_words[source_word] !=
                    parent.atlas.raw_table_words[child * 8 + source_word] {
                    roundtrip_word_failures = roundtrip_word_failures + 1
                }
                source_word = source_word + 1
            }
        }
        class_id = class_id + 1
    }

    PireusOlfSemanticCertificate {
        operator_classes: classes,
        representatives: representatives,
        representative_checks: representative_checks,
        representative_failures: representative_failures,
        parent_relation_checks: parent_relation_checks,
        parent_relation_failures: parent_relation_failures,
        partner_checks: partner_checks,
        partner_failures: partner_failures,
        sign_checks: sign_checks,
        sign_failures: sign_failures,
        roundtrip_word_checks: roundtrip_word_checks,
        roundtrip_word_failures: roundtrip_word_failures,
        order_checks: order_checks,
        order_failures: order_failures,
        destination_checks: destination_checks,
        destination_failures: destination_failures,
        definitional_reconstruction: roundtrip_word_checks == classes * 8 &&
            roundtrip_word_failures == 0,
        complete: PIREUS_QUOTIENT_CHILD_COUNT == 48 &&
            parent_classes == classes && classes > 0 &&
            representative_checks == classes &&
            representative_failures == 0 &&
            parent_relation_checks == classes * 2 &&
            parent_relation_failures == 0 &&
            partner_checks == classes * PIREUS_OLF_CELL_COUNT &&
            partner_failures == 0 && sign_checks == classes * 8 &&
            sign_failures == 0 &&
            roundtrip_word_checks == classes * 8 &&
            roundtrip_word_failures == 0 &&
            order_checks == classes * PIREUS_OLF_CELL_COUNT &&
            order_failures == 0 &&
            destination_checks == classes * PIREUS_OLF_CELL_COUNT &&
            destination_failures == 0,
    }
}

fn olf_candidate_program_equal(
    atlas: &PireusOlfCandidateAtlas,
    left: i64,
    right: i64,
) -> bool with Panic {
    atlas.operator_class_ids[left] == atlas.operator_class_ids[right] &&
        atlas.target_ids[left] == atlas.target_ids[right] &&
        atlas.pack_widths[left] == atlas.pack_widths[right] &&
        atlas.route_kinds[left] == atlas.route_kinds[right] &&
        atlas.order_kinds[left] == atlas.order_kinds[right] &&
        atlas.primitive_kinds[left] == atlas.primitive_kinds[right]
}

fn olf_program_key_equal(
    left_operator_class: i64,
    right_operator_class: i64,
    left_target: i64,
    right_target: i64,
    left_pack: i64,
    right_pack: i64,
    left_route: i64,
    right_route: i64,
    left_order: i64,
    right_order: i64,
    left_primitive: i64,
    right_primitive: i64,
) -> bool {
    left_operator_class >= 0 && right_operator_class >= 0 &&
        left_target > 0 && right_target > 0 && left_pack > 0 &&
        right_pack > 0 && left_route > 0 && right_route > 0 &&
        left_primitive > 0 && right_primitive > 0 &&
        left_operator_class == right_operator_class &&
        left_target == right_target && left_pack == right_pack &&
        left_route == right_route && left_order == right_order &&
        left_primitive == right_primitive
}

fn olf_residual_mask(target: i64, route: i64) -> i64 {
    var mask = PIREUS_OLF_RESIDUAL_TARGET_DENOTATION |
        PIREUS_OLF_RESIDUAL_COMPOSITION |
        PIREUS_OLF_RESIDUAL_PRECISION |
        PIREUS_OLF_RESIDUAL_ORDERING |
        PIREUS_OLF_RESIDUAL_EFFECTS |
        PIREUS_OLF_RESIDUAL_CAPABILITY |
        PIREUS_OLF_RESIDUAL_EMISSION |
        PIREUS_OLF_RESIDUAL_MATERIAL |
        PIREUS_OLF_RESIDUAL_COST |
        PIREUS_OLF_RESIDUAL_PERFORMANCE
    if target == PIREUS_OLF_TARGET_XEON &&
        route == PIREUS_OLF_ROUTE_DIRECT {
        mask = mask | PIREUS_OLF_RESIDUAL_SOURCE_ARITY
    }
    if target == PIREUS_OLF_TARGET_U250 {
        mask = mask | PIREUS_OLF_RESIDUAL_FABRIC_REALIZATION
    }
    mask
}

fn olf_seed_kind(target: i64, route: i64) -> i64 {
    if route == PIREUS_OLF_ROUTE_COMPOSED {
        return PIREUS_OLF_SEED_LOWERING
    }
    if target == PIREUS_OLF_TARGET_U250 {
        return PIREUS_OLF_SEED_FABRIC
    }
    PIREUS_OLF_SEED_PRIMITIVE
}

fn olf_discharged_obligation_mask() -> i64 {
    (1 << PIREUS_OLF_OBLIGATION_SEMANTIC_DECOMPOSITION) |
        (1 << PIREUS_OLF_OBLIGATION_PROGRAM_QUOTIENT) |
        (1 << PIREUS_OLF_OBLIGATION_MACHINE_ENVELOPE)
}

fn olf_unresolved_obligation_mask() -> i64 with Mut {
    var mask: i64 = 0
    var obligation: i64 = PIREUS_OLF_OBLIGATION_TARGET_DENOTATION
    while obligation < PIREUS_OLF_OBLIGATION_COUNT {
        mask = mask | (1 << obligation)
        obligation = obligation + 1
    }
    mask
}

fn olf_popcount(value: i64, bits: i64) -> i64 with Mut {
    var count: i64 = 0
    var bit: i64 = 0
    while bit < bits {
        if (value & (1 << bit)) != 0 { count = count + 1 }
        bit = bit + 1
    }
    count
}

fn olf_build_atlas(
    grammar: &PireusOlfGraphGrammar,
    targets: &PireusOlfTargetAtlas,
    semantics: &PireusOlfSemanticCertificate,
) -> PireusOlfCandidateAtlas with Mut, Panic {
    var atlas = PireusOlfCandidateAtlas {
        candidate_count: 0,
        generation_attempts: 0,
        capacity_overflows: 0,
        operator_class_ids: [-1; 4096],
        operator_representatives: [-1; 4096],
        target_ids: [0; 4096],
        pack_widths: [0; 4096],
        route_kinds: [0; 4096],
        serialization_kinds: [0; 4096],
        order_kinds: [0; 4096],
        primitive_kinds: [0; 4096],
        program_class_ids: [-1; 4096],
        program_representatives: [-1; 4096],
        machine_class_ids: [-1; 4096],
        residual_masks: [0; 4096],
        seed_kinds: [0; 4096],
        discharged_obligation_masks: [0; 4096],
        unresolved_obligation_masks: [0; 4096],
        program_class_count: 0,
        machine_class_count: 0,
        program_equivalence_checks: 0,
        program_equivalence_failures: 0,
        program_separation_checks: 0,
        program_separation_failures: 0,
        machine_equivalence_checks: 0,
        machine_equivalence_failures: 0,
        serialization_collapse_checks: 0,
        serialization_collapse_failures: 0,
        order_separation_checks: 0,
        order_separation_failures: 0,
        residual_count: 0,
        lowering_seed_count: 0,
        primitive_seed_count: 0,
        fabric_seed_count: 0,
        operator_seed_count: 0,
        discharged_obligations: 0,
        unresolved_obligations: 0,
        refuted_obligations: 0,
        admitted_lowerings: 0,
        selected_candidate: -1,
        ranking_present: false,
        complete: false,
    }

    let discharged_mask = olf_discharged_obligation_mask()
    let unresolved_mask = olf_unresolved_obligation_mask()
    var operator_class: i64 = 0
    while operator_class < semantics.operator_classes {
        var target_index: i64 = 0
        while target_index < PIREUS_OLF_TARGET_COUNT {
            var pack_index: i64 = 0
            while pack_index < PIREUS_OLF_PACK_COUNT {
                var route_index: i64 = 0
                while route_index < PIREUS_OLF_ROUTE_COUNT {
                    var serialization_index: i64 = 0
                    while serialization_index <
                        PIREUS_OLF_SERIALIZATION_COUNT {
                        atlas.generation_attempts =
                            atlas.generation_attempts + 1
                        if atlas.candidate_count >=
                            PIREUS_OLF_CANDIDATE_CAPACITY {
                            atlas.capacity_overflows =
                                atlas.capacity_overflows + 1
                        } else {
                            let index = atlas.candidate_count
                            atlas.operator_class_ids[index] = operator_class
                            atlas.operator_representatives[index] =
                                semantics.representatives[operator_class]
                            atlas.target_ids[index] =
                                targets.target_ids[target_index]
                            atlas.pack_widths[index] =
                                grammar.pack_widths[pack_index]
                            atlas.route_kinds[index] =
                                grammar.route_kinds[route_index]
                            atlas.serialization_kinds[index] =
                                grammar.serialization_kinds[
                                    serialization_index]
                            atlas.order_kinds[index] =
                                PIREUS_OLF_ORDER_ASCENDING_I
                            atlas.primitive_kinds[index] =
                                targets.primitive_candidates[target_index]
                            atlas.machine_class_ids[index] = target_index
                            atlas.residual_masks[index] = olf_residual_mask(
                                atlas.target_ids[index],
                                atlas.route_kinds[index])
                            atlas.seed_kinds[index] = olf_seed_kind(
                                atlas.target_ids[index],
                                atlas.route_kinds[index])
                            atlas.discharged_obligation_masks[index] =
                                discharged_mask
                            atlas.unresolved_obligation_masks[index] =
                                unresolved_mask

                            var representative: i64 = -1
                            var prior: i64 = 0
                            while prior < index && representative < 0 {
                                if olf_candidate_program_equal(
                                    &atlas, prior, index) {
                                    representative = prior
                                }
                                prior = prior + 1
                            }
                            if representative < 0 {
                                representative = index
                                atlas.program_class_ids[index] =
                                    atlas.program_class_count
                                atlas.program_class_count =
                                    atlas.program_class_count + 1
                            } else {
                                atlas.program_class_ids[index] =
                                    atlas.program_class_ids[representative]
                            }
                            atlas.program_representatives[index] =
                                representative

                            atlas.residual_count = atlas.residual_count + 1
                            if atlas.seed_kinds[index] ==
                                PIREUS_OLF_SEED_LOWERING {
                                atlas.lowering_seed_count =
                                    atlas.lowering_seed_count + 1
                            } else if atlas.seed_kinds[index] ==
                                PIREUS_OLF_SEED_PRIMITIVE {
                                atlas.primitive_seed_count =
                                    atlas.primitive_seed_count + 1
                            } else if atlas.seed_kinds[index] ==
                                PIREUS_OLF_SEED_FABRIC {
                                atlas.fabric_seed_count =
                                    atlas.fabric_seed_count + 1
                            } else if atlas.seed_kinds[index] ==
                                PIREUS_OLF_SEED_OPERATOR {
                                atlas.operator_seed_count =
                                    atlas.operator_seed_count + 1
                            }
                            atlas.discharged_obligations =
                                atlas.discharged_obligations +
                                    olf_popcount(
                                        discharged_mask,
                                        PIREUS_OLF_OBLIGATION_COUNT)
                            atlas.unresolved_obligations =
                                atlas.unresolved_obligations +
                                    olf_popcount(
                                        unresolved_mask,
                                        PIREUS_OLF_OBLIGATION_COUNT)
                            if unresolved_mask == 0 {
                                atlas.admitted_lowerings =
                                    atlas.admitted_lowerings + 1
                            }
                            atlas.candidate_count =
                                atlas.candidate_count + 1
                        }
                        serialization_index = serialization_index + 1
                    }
                    route_index = route_index + 1
                }
                pack_index = pack_index + 1
            }
            target_index = target_index + 1
        }
        operator_class = operator_class + 1
    }
    atlas.machine_class_count = PIREUS_OLF_TARGET_COUNT

    var candidate: i64 = 0
    while candidate < atlas.candidate_count {
        let representative = atlas.program_representatives[candidate]
        atlas.program_equivalence_checks =
            atlas.program_equivalence_checks + 1
        if representative < 0 || representative >= atlas.candidate_count ||
            !olf_candidate_program_equal(&atlas, candidate, representative) ||
            atlas.program_class_ids[candidate] !=
                atlas.program_class_ids[representative] {
            atlas.program_equivalence_failures =
                atlas.program_equivalence_failures + 1
        }
        atlas.machine_equivalence_checks =
            atlas.machine_equivalence_checks + 1
        if atlas.machine_class_ids[candidate] < 0 ||
            atlas.machine_class_ids[candidate] >= PIREUS_OLF_TARGET_COUNT ||
            atlas.target_ids[candidate] !=
                targets.target_ids[atlas.machine_class_ids[candidate]] {
            atlas.machine_equivalence_failures =
                atlas.machine_equivalence_failures + 1
        }
        if atlas.serialization_kinds[candidate] ==
            PIREUS_OLF_SERIALIZATION_ALTERNATE {
            atlas.serialization_collapse_checks =
                atlas.serialization_collapse_checks + 1
            if representative == candidate ||
                atlas.serialization_kinds[representative] !=
                    PIREUS_OLF_SERIALIZATION_CANONICAL {
                atlas.serialization_collapse_failures =
                    atlas.serialization_collapse_failures + 1
            }
        }
        atlas.order_separation_checks = atlas.order_separation_checks + 1
        if olf_program_key_equal(
            atlas.operator_class_ids[candidate],
            atlas.operator_class_ids[candidate],
            atlas.target_ids[candidate], atlas.target_ids[candidate],
            atlas.pack_widths[candidate], atlas.pack_widths[candidate],
            atlas.route_kinds[candidate], atlas.route_kinds[candidate],
            atlas.order_kinds[candidate], PIREUS_OLF_ORDER_TREE,
            atlas.primitive_kinds[candidate],
            atlas.primitive_kinds[candidate]) {
            atlas.order_separation_failures =
                atlas.order_separation_failures + 1
        }
        candidate = candidate + 1
    }

    var left: i64 = 0
    while left < atlas.candidate_count {
        var right: i64 = left + 1
        while right < atlas.candidate_count {
            if atlas.program_class_ids[left] !=
                atlas.program_class_ids[right] {
                atlas.program_separation_checks =
                    atlas.program_separation_checks + 1
                if olf_candidate_program_equal(&atlas, left, right) {
                    atlas.program_separation_failures =
                        atlas.program_separation_failures + 1
                }
            }
            right = right + 1
        }
        left = left + 1
    }

    atlas.complete = grammar.complete && targets.complete &&
        semantics.complete && atlas.candidate_count > 0 &&
        atlas.generation_attempts == atlas.candidate_count &&
        atlas.capacity_overflows == 0 && atlas.program_class_count > 0 &&
        atlas.program_class_count <= PIREUS_OLF_PROGRAM_CLASS_CAPACITY &&
        atlas.machine_class_count == PIREUS_OLF_TARGET_COUNT &&
        atlas.program_equivalence_failures == 0 &&
        atlas.program_separation_failures == 0 &&
        atlas.machine_equivalence_failures == 0 &&
        atlas.serialization_collapse_failures == 0 &&
        atlas.order_separation_failures == 0 &&
        atlas.residual_count == atlas.candidate_count &&
        atlas.operator_seed_count == 0 && atlas.refuted_obligations == 0 &&
        atlas.admitted_lowerings == 0 && atlas.selected_candidate == -1 &&
        !atlas.ranking_present
    atlas
}

fn olf_build_receipt(
    lineage: &PireusOlfLineage,
    grammar: &PireusOlfGraphGrammar,
    targets: &PireusOlfTargetAtlas,
    semantics: &PireusOlfSemanticCertificate,
    atlas: &PireusOlfCandidateAtlas,
) -> PireusOlfReceipt {
    PireusOlfReceipt {
        schema: PIREUS_OLF_SCHEMA,
        producer_language: PIREUS_OLF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_OLF_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_OLF_STAGE_SOUNIO_EXECUTABLE,
        parent_lineage_bound: lineage.complete,
        graph_grammar_complete: grammar.complete,
        semantic_decomposition_complete: semantics.complete,
        semantic_decomposition_definitional:
            semantics.definitional_reconstruction,
        target_envelopes_complete: targets.complete,
        operator_quotient_inherited: lineage.parent_operator_classes ==
            semantics.operator_classes,
        declared_program_quotient_complete: atlas.complete,
        declared_machine_envelope_quotient_complete: atlas.complete,
        material_machine_quotient_complete: false,
        typed_residuals_complete: atlas.residual_count ==
            atlas.candidate_count,
        typed_seed_taxonomy_complete: atlas.lowering_seed_count +
            atlas.primitive_seed_count + atlas.fabric_seed_count +
            atlas.operator_seed_count == atlas.candidate_count,
        lowering_novelty_typed: atlas.program_class_count > 0 &&
            atlas.program_equivalence_failures == 0 &&
            atlas.program_separation_failures == 0,
        primitive_novelty_typed: atlas.residual_count ==
            atlas.candidate_count && atlas.primitive_seed_count > 0,
        embodiment_novelty_typed: targets.complete &&
            atlas.machine_class_count == PIREUS_OLF_TARGET_COUNT &&
            targets.observed_endpoint_total == 0,
        operator_seed_generated: atlas.operator_seed_count > 0,
        target_observations_admitted: false,
        target_lowerings_admitted: false,
        target_costs_admitted: false,
        target_performance_admitted: false,
        no_candidate_selected: atlas.selected_candidate == -1 &&
            !atlas.ranking_present,
        semantics_frozen: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        algorithmic_novelty: false,
        material_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
}

fn olf_build_negatives() -> PireusOlfNegatives with Mut {
    let canonical = pireus_operator_lowering_request()
    var bad = canonical
    bad.producer_language = PIREUS_OLF_LANGUAGE_PYTHON
    let python_oracle = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.producer_language = PIREUS_OLF_LANGUAGE_RUST
    let rust_oracle = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.producer_language = PIREUS_OLF_LANGUAGE_CPP
    bad.producer_role = PIREUS_OLF_ROLE_MATERIAL_PARITY
    let cpp_authority = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.producer_language = PIREUS_OLF_LANGUAGE_LLM
    bad.producer_role = PIREUS_OLF_ROLE_REVIEW_ONLY
    let llm_authority = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.policy_present = false
    let missing_policy = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.parent_present = false
    let missing_parent = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.parent_semantics_frozen = false
    let unfrozen_parent = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.parent_source_bound = false
    let unbound_parent = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.declared_node_count = PIREUS_OLF_NODE_COUNT - 1
    let wrong_grammar = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.expected_candidate_count_present = true
    let result_injection = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.selection_requested = true
    let selection = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.ranking_present = true
    let ranking = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.material_receipt_count = 1
    let material_prefreeze = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.parity_requested = true
    let parity_prefreeze = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.claim_ready_requested = true
    let claim_promotion = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.external_review_promoted = true
    let review_promotion = olf_request_error(&bad) != PIREUS_OLF_OK
    bad = canonical
    bad.waiver_present = true
    bad.waiver_founder = true
    bad.waiver_scoped = false
    bad.waiver_purpose_bound = true
    bad.waiver_live = true
    let invalid_waiver = olf_request_error(&bad) != PIREUS_OLF_OK

    let same_graph_collapsed = olf_program_key_equal(
        0, 0, PIREUS_OLF_TARGET_XEON, PIREUS_OLF_TARGET_XEON,
        1, 1, PIREUS_OLF_ROUTE_DIRECT, PIREUS_OLF_ROUTE_DIRECT,
        PIREUS_OLF_ORDER_ASCENDING_I, PIREUS_OLF_ORDER_ASCENDING_I,
        PIREUS_OLF_PRIMITIVE_XEON_SELECTOR,
        PIREUS_OLF_PRIMITIVE_XEON_SELECTOR)
    let different_order_separated = !olf_program_key_equal(
        0, 0, PIREUS_OLF_TARGET_XEON, PIREUS_OLF_TARGET_XEON,
        1, 1, PIREUS_OLF_ROUTE_DIRECT, PIREUS_OLF_ROUTE_DIRECT,
        PIREUS_OLF_ORDER_ASCENDING_I, PIREUS_OLF_ORDER_TREE,
        PIREUS_OLF_PRIMITIVE_XEON_SELECTOR,
        PIREUS_OLF_PRIMITIVE_XEON_SELECTOR)
    let targets = olf_build_targets()
    let endpoint_erasure_refused = targets.required_endpoints ==
        targets.unresolved_endpoints && targets.observed_endpoint_total == 0
    let residual_fallback_refused = (olf_residual_mask(
        PIREUS_OLF_TARGET_U250, PIREUS_OLF_ROUTE_DIRECT) &
        PIREUS_OLF_RESIDUAL_FABRIC_REALIZATION) != 0

    var passed: i64 = 0
    if python_oracle { passed = passed + 1 }
    if rust_oracle { passed = passed + 1 }
    if cpp_authority { passed = passed + 1 }
    if llm_authority { passed = passed + 1 }
    if missing_policy { passed = passed + 1 }
    if missing_parent { passed = passed + 1 }
    if unfrozen_parent { passed = passed + 1 }
    if unbound_parent { passed = passed + 1 }
    if wrong_grammar { passed = passed + 1 }
    if result_injection { passed = passed + 1 }
    if selection { passed = passed + 1 }
    if ranking { passed = passed + 1 }
    if material_prefreeze { passed = passed + 1 }
    if parity_prefreeze { passed = passed + 1 }
    if claim_promotion { passed = passed + 1 }
    if review_promotion { passed = passed + 1 }
    if invalid_waiver { passed = passed + 1 }
    if same_graph_collapsed { passed = passed + 1 }
    if different_order_separated { passed = passed + 1 }
    if endpoint_erasure_refused { passed = passed + 1 }
    if residual_fallback_refused { passed = passed + 1 }

    PireusOlfNegatives {
        passed: passed,
        total: 21,
        python_oracle: python_oracle,
        rust_oracle: rust_oracle,
        cpp_authority: cpp_authority,
        llm_authority: llm_authority,
        missing_policy: missing_policy,
        missing_parent: missing_parent,
        unfrozen_parent: unfrozen_parent,
        unbound_parent: unbound_parent,
        wrong_grammar: wrong_grammar,
        result_injection: result_injection,
        selection: selection,
        ranking: ranking,
        material_prefreeze: material_prefreeze,
        parity_prefreeze: parity_prefreeze,
        claim_promotion: claim_promotion,
        review_promotion: review_promotion,
        invalid_waiver: invalid_waiver,
        same_graph_collapsed: same_graph_collapsed,
        different_order_separated: different_order_separated,
        endpoint_erasure_refused: endpoint_erasure_refused,
        residual_fallback_refused: residual_fallback_refused,
    }
}

fn olf_digest_lineage(lineage: &PireusOlfLineage) -> PireusOlfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = olf_digest_add_words(state, &lineage.parent_forge_digest)
    state = olf_digest_add_bool(state, lineage.parent_live_match)
    state = olf_digest_add_bool(state, lineage.parent_valid)
    state = olf_digest_add_bool(state, lineage.parent_semantics_frozen)
    state = olf_digest_add_i64(state, lineage.parent_operator_classes)
    state = olf_digest_add_i64(state, lineage.parent_selected_child)
    state = olf_digest_add_bool(state, lineage.parent_ranking_present)
    state = olf_digest_add_bool(state, lineage.complete)
    olf_digest_finish(state)
}

fn olf_digest_grammar(grammar: &PireusOlfGraphGrammar) -> PireusOlfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    var index: i64 = 0
    while index < PIREUS_OLF_NODE_COUNT {
        state = olf_digest_add_i64(state, grammar.node_kinds[index])
        index = index + 1
    }
    index = 0
    while index < PIREUS_OLF_PACK_COUNT {
        state = olf_digest_add_i64(state, grammar.pack_widths[index])
        index = index + 1
    }
    index = 0
    while index < PIREUS_OLF_ROUTE_COUNT {
        state = olf_digest_add_i64(state, grammar.route_kinds[index])
        index = index + 1
    }
    index = 0
    while index < PIREUS_OLF_SERIALIZATION_COUNT {
        state = olf_digest_add_i64(state, grammar.serialization_kinds[index])
        index = index + 1
    }
    state = olf_digest_add_i64(state, grammar.node_checks)
    state = olf_digest_add_i64(state, grammar.node_failures)
    state = olf_digest_add_i64(state, grammar.pack_checks)
    state = olf_digest_add_i64(state, grammar.pack_failures)
    state = olf_digest_add_i64(state, grammar.route_checks)
    state = olf_digest_add_i64(state, grammar.route_failures)
    state = olf_digest_add_i64(state, grammar.serialization_checks)
    state = olf_digest_add_i64(state, grammar.serialization_failures)
    state = olf_digest_add_i64(state, grammar.shape_checks)
    state = olf_digest_add_i64(state, grammar.shape_failures)
    state = olf_digest_add_bool(state, grammar.complete)
    olf_digest_finish(state)
}

fn olf_digest_targets(targets: &PireusOlfTargetAtlas) -> PireusOlfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    var target: i64 = 0
    while target < PIREUS_OLF_TARGET_COUNT {
        state = olf_digest_add_i64(state, targets.target_ids[target])
        state = olf_digest_add_i64(
            state, targets.endpoint_requirements[target])
        state = olf_digest_add_i64(state, targets.observed_endpoints[target])
        state = olf_digest_add_i64(state, targets.material_receipts[target])
        state = olf_digest_add_i64(
            state, targets.primitive_candidates[target])
        state = olf_digest_add_bool(state, targets.candidate_only[target])
        target = target + 1
    }
    state = olf_digest_add_i64(state, targets.target_checks)
    state = olf_digest_add_i64(state, targets.target_failures)
    state = olf_digest_add_i64(state, targets.required_endpoints)
    state = olf_digest_add_i64(state, targets.observed_endpoint_total)
    state = olf_digest_add_i64(state, targets.unresolved_endpoints)
    state = olf_digest_add_bool(state, targets.complete)
    olf_digest_finish(state)
}

fn olf_digest_semantics(semantics: &PireusOlfSemanticCertificate)
    -> PireusOlfDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = olf_digest_add_i64(state, semantics.operator_classes)
    var class_id: i64 = 0
    while class_id < semantics.operator_classes {
        state = olf_digest_add_i64(
            state, semantics.representatives[class_id])
        class_id = class_id + 1
    }
    state = olf_digest_add_i64(state, semantics.representative_checks)
    state = olf_digest_add_i64(state, semantics.representative_failures)
    state = olf_digest_add_i64(state, semantics.parent_relation_checks)
    state = olf_digest_add_i64(state, semantics.parent_relation_failures)
    state = olf_digest_add_i64(state, semantics.partner_checks)
    state = olf_digest_add_i64(state, semantics.partner_failures)
    state = olf_digest_add_i64(state, semantics.sign_checks)
    state = olf_digest_add_i64(state, semantics.sign_failures)
    state = olf_digest_add_i64(state, semantics.roundtrip_word_checks)
    state = olf_digest_add_i64(state, semantics.roundtrip_word_failures)
    state = olf_digest_add_i64(state, semantics.order_checks)
    state = olf_digest_add_i64(state, semantics.order_failures)
    state = olf_digest_add_i64(state, semantics.destination_checks)
    state = olf_digest_add_i64(state, semantics.destination_failures)
    state = olf_digest_add_bool(
        state, semantics.definitional_reconstruction)
    state = olf_digest_add_bool(state, semantics.complete)
    olf_digest_finish(state)
}

fn olf_digest_atlas(atlas: &PireusOlfCandidateAtlas) -> PireusOlfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = olf_digest_add_i64(state, atlas.candidate_count)
    state = olf_digest_add_i64(state, atlas.generation_attempts)
    state = olf_digest_add_i64(state, atlas.capacity_overflows)
    var index: i64 = 0
    while index < atlas.candidate_count {
        state = olf_digest_add_i64(state, atlas.operator_class_ids[index])
        state = olf_digest_add_i64(
            state, atlas.operator_representatives[index])
        state = olf_digest_add_i64(state, atlas.target_ids[index])
        state = olf_digest_add_i64(state, atlas.pack_widths[index])
        state = olf_digest_add_i64(state, atlas.route_kinds[index])
        state = olf_digest_add_i64(state, atlas.serialization_kinds[index])
        state = olf_digest_add_i64(state, atlas.order_kinds[index])
        state = olf_digest_add_i64(state, atlas.primitive_kinds[index])
        state = olf_digest_add_i64(state, atlas.program_class_ids[index])
        state = olf_digest_add_i64(
            state, atlas.program_representatives[index])
        state = olf_digest_add_i64(state, atlas.machine_class_ids[index])
        state = olf_digest_add_i64(state, atlas.residual_masks[index])
        state = olf_digest_add_i64(state, atlas.seed_kinds[index])
        state = olf_digest_add_i64(
            state, atlas.discharged_obligation_masks[index])
        state = olf_digest_add_i64(
            state, atlas.unresolved_obligation_masks[index])
        index = index + 1
    }
    state = olf_digest_add_i64(state, atlas.program_class_count)
    state = olf_digest_add_i64(state, atlas.machine_class_count)
    state = olf_digest_add_i64(state, atlas.program_equivalence_checks)
    state = olf_digest_add_i64(state, atlas.program_equivalence_failures)
    state = olf_digest_add_i64(state, atlas.program_separation_checks)
    state = olf_digest_add_i64(state, atlas.program_separation_failures)
    state = olf_digest_add_i64(state, atlas.machine_equivalence_checks)
    state = olf_digest_add_i64(state, atlas.machine_equivalence_failures)
    state = olf_digest_add_i64(state, atlas.serialization_collapse_checks)
    state = olf_digest_add_i64(state, atlas.serialization_collapse_failures)
    state = olf_digest_add_i64(state, atlas.order_separation_checks)
    state = olf_digest_add_i64(state, atlas.order_separation_failures)
    state = olf_digest_add_i64(state, atlas.residual_count)
    state = olf_digest_add_i64(state, atlas.lowering_seed_count)
    state = olf_digest_add_i64(state, atlas.primitive_seed_count)
    state = olf_digest_add_i64(state, atlas.fabric_seed_count)
    state = olf_digest_add_i64(state, atlas.operator_seed_count)
    state = olf_digest_add_i64(state, atlas.discharged_obligations)
    state = olf_digest_add_i64(state, atlas.unresolved_obligations)
    state = olf_digest_add_i64(state, atlas.refuted_obligations)
    state = olf_digest_add_i64(state, atlas.admitted_lowerings)
    state = olf_digest_add_i64(state, atlas.selected_candidate)
    state = olf_digest_add_bool(state, atlas.ranking_present)
    state = olf_digest_add_bool(state, atlas.complete)
    olf_digest_finish(state)
}

fn olf_digest_receipt(receipt: &PireusOlfReceipt) -> PireusOlfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = olf_digest_add_i64(state, receipt.schema)
    state = olf_digest_add_i64(state, receipt.producer_language)
    state = olf_digest_add_i64(state, receipt.producer_role)
    state = olf_digest_add_i64(state, receipt.stage)
    state = olf_digest_add_bool(state, receipt.parent_lineage_bound)
    state = olf_digest_add_bool(state, receipt.graph_grammar_complete)
    state = olf_digest_add_bool(
        state, receipt.semantic_decomposition_complete)
    state = olf_digest_add_bool(
        state, receipt.semantic_decomposition_definitional)
    state = olf_digest_add_bool(state, receipt.target_envelopes_complete)
    state = olf_digest_add_bool(state, receipt.operator_quotient_inherited)
    state = olf_digest_add_bool(
        state, receipt.declared_program_quotient_complete)
    state = olf_digest_add_bool(
        state, receipt.declared_machine_envelope_quotient_complete)
    state = olf_digest_add_bool(
        state, receipt.material_machine_quotient_complete)
    state = olf_digest_add_bool(state, receipt.typed_residuals_complete)
    state = olf_digest_add_bool(state, receipt.typed_seed_taxonomy_complete)
    state = olf_digest_add_bool(state, receipt.lowering_novelty_typed)
    state = olf_digest_add_bool(state, receipt.primitive_novelty_typed)
    state = olf_digest_add_bool(state, receipt.embodiment_novelty_typed)
    state = olf_digest_add_bool(state, receipt.operator_seed_generated)
    state = olf_digest_add_bool(
        state, receipt.target_observations_admitted)
    state = olf_digest_add_bool(state, receipt.target_lowerings_admitted)
    state = olf_digest_add_bool(state, receipt.target_costs_admitted)
    state = olf_digest_add_bool(state, receipt.target_performance_admitted)
    state = olf_digest_add_bool(state, receipt.no_candidate_selected)
    state = olf_digest_add_bool(state, receipt.semantics_frozen)
    state = olf_digest_add_bool(state, receipt.formal_parity_open)
    state = olf_digest_add_bool(state, receipt.effect_parity_open)
    state = olf_digest_add_bool(state, receipt.material_parity_open)
    state = olf_digest_add_bool(state, receipt.algorithmic_novelty)
    state = olf_digest_add_bool(state, receipt.material_novelty)
    state = olf_digest_add_bool(state, receipt.historical_novelty)
    state = olf_digest_add_bool(state, receipt.priority_claim)
    state = olf_digest_add_bool(state, receipt.claim_ready)
    olf_digest_finish(state)
}

fn olf_digest_forge(
    lineage: &PireusOlfDigest,
    grammar: &PireusOlfDigest,
    target: &PireusOlfDigest,
    semantic: &PireusOlfDigest,
    atlas: &PireusOlfDigest,
    receipt: &PireusOlfDigest,
) -> PireusOlfDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = olf_digest_add_words(state, &lineage.words)
    state = olf_digest_add_words(state, &grammar.words)
    state = olf_digest_add_words(state, &target.words)
    state = olf_digest_add_words(state, &semantic.words)
    state = olf_digest_add_words(state, &atlas.words)
    state = olf_digest_add_words(state, &receipt.words)
    olf_digest_finish(state)
}

pub fn pireus_operator_lowering_evaluate(request: &PireusOlfRequest)
    -> PireusOlfResult with Mut, Panic, Div, Epistemic {
    let error = olf_request_error(request)
    let parent_request = pireus_quotient_novelty_request()
    let parent = pireus_quotient_novelty_evaluate(&parent_request)
    let lineage = olf_build_lineage(&parent)
    let grammar = olf_build_grammar()
    let targets = olf_build_targets()
    let semantics = olf_build_semantics(&parent)
    let atlas = olf_build_atlas(&grammar, &targets, &semantics)
    let receipt = olf_build_receipt(
        &lineage, &grammar, &targets, &semantics, &atlas)
    let negatives = olf_build_negatives()
    let lineage_digest = olf_digest_lineage(&lineage)
    let grammar_digest = olf_digest_grammar(&grammar)
    let target_digest = olf_digest_targets(&targets)
    let semantic_digest = olf_digest_semantics(&semantics)
    let atlas_digest = olf_digest_atlas(&atlas)
    let receipt_digest = olf_digest_receipt(&receipt)
    let forge_digest = olf_digest_forge(
        &lineage_digest, &grammar_digest, &target_digest, &semantic_digest,
        &atlas_digest, &receipt_digest)

    var failures: i64 = 0
    if error != PIREUS_OLF_OK { failures = failures + 1 }
    if !lineage.complete || !grammar.complete || !targets.complete ||
        !semantics.complete || !atlas.complete {
        failures = failures + 1
    }
    if negatives.passed != negatives.total { failures = failures + 1 }
    if !receipt.parent_lineage_bound || !receipt.graph_grammar_complete ||
        !receipt.semantic_decomposition_complete ||
        !receipt.semantic_decomposition_definitional ||
        !receipt.target_envelopes_complete ||
        !receipt.operator_quotient_inherited ||
        !receipt.declared_program_quotient_complete ||
        !receipt.declared_machine_envelope_quotient_complete ||
        receipt.material_machine_quotient_complete ||
        !receipt.typed_residuals_complete ||
        !receipt.typed_seed_taxonomy_complete ||
        !receipt.lowering_novelty_typed ||
        !receipt.primitive_novelty_typed ||
        !receipt.embodiment_novelty_typed ||
        receipt.operator_seed_generated ||
        receipt.target_observations_admitted ||
        receipt.target_lowerings_admitted ||
        receipt.target_costs_admitted ||
        receipt.target_performance_admitted ||
        !receipt.no_candidate_selected || receipt.semantics_frozen ||
        receipt.formal_parity_open || receipt.effect_parity_open ||
        receipt.material_parity_open || receipt.algorithmic_novelty ||
        receipt.material_novelty || receipt.historical_novelty ||
        receipt.priority_claim || receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_olf_digest_nonzero(&lineage_digest) ||
        !pireus_olf_digest_nonzero(&grammar_digest) ||
        !pireus_olf_digest_nonzero(&target_digest) ||
        !pireus_olf_digest_nonzero(&semantic_digest) ||
        !pireus_olf_digest_nonzero(&atlas_digest) ||
        !pireus_olf_digest_nonzero(&receipt_digest) ||
        !pireus_olf_digest_nonzero(&forge_digest) {
        failures = failures + 1
    }

    PireusOlfResult {
        valid: failures == 0,
        error: error,
        lineage: lineage,
        grammar: grammar,
        targets: targets,
        semantics: semantics,
        atlas: atlas,
        receipt: receipt,
        negatives: negatives,
        lineage_digest: lineage_digest,
        grammar_digest: grammar_digest,
        target_digest: target_digest,
        semantic_digest: semantic_digest,
        atlas_digest: atlas_digest,
        receipt_digest: receipt_digest,
        forge_digest: forge_digest,
        failures: failures,
    }
}

fn olf_digest_matches(
    digest: &PireusOlfDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if digest.words[word] != expected[word] { return false }
        word = word + 1
    }
    true
}

/// Exact v6 matcher admitted only after Garden commit 92232819d5,
/// matcher-free executable commit 66dd1e871a, and first Sounio transcript
/// commit 6d303318bf existed in that order. It freezes the declared finite
/// grammar and envelope quotient, not a material-machine quotient or a public
/// novelty claim.
pub fn pireus_operator_lowering_frozen_mismatch_code(
    result: &PireusOlfResult,
) -> i64 with Mut, Panic {
    if !result.valid || result.error != PIREUS_OLF_OK ||
        result.failures != 0 {
        return 1
    }
    if !result.lineage.parent_live_match || !result.lineage.parent_valid ||
        !result.lineage.parent_semantics_frozen ||
        result.lineage.parent_operator_classes != 14 ||
        result.lineage.parent_selected_child != -1 ||
        result.lineage.parent_ranking_present || !result.lineage.complete {
        return 2
    }
    if !result.grammar.complete || result.grammar.node_checks != 45 ||
        result.grammar.node_failures != 0 ||
        result.grammar.pack_checks != 9 ||
        result.grammar.pack_failures != 0 ||
        result.grammar.route_checks != 2 ||
        result.grammar.route_failures != 0 ||
        result.grammar.serialization_checks != 2 ||
        result.grammar.serialization_failures != 0 ||
        result.grammar.shape_checks != 2 ||
        result.grammar.shape_failures != 0 {
        return 3
    }
    let expected_nodes: [i64; 9] = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    let expected_packs: [i64; 5] = [1, 2, 4, 8, 16]
    var index: i64 = 0
    while index < PIREUS_OLF_NODE_COUNT {
        if result.grammar.node_kinds[index] != expected_nodes[index] {
            return 3
        }
        index = index + 1
    }
    index = 0
    while index < PIREUS_OLF_PACK_COUNT {
        if result.grammar.pack_widths[index] != expected_packs[index] {
            return 3
        }
        index = index + 1
    }
    if result.grammar.route_kinds[0] != PIREUS_OLF_ROUTE_DIRECT ||
        result.grammar.route_kinds[1] != PIREUS_OLF_ROUTE_COMPOSED ||
        result.grammar.serialization_kinds[0] !=
            PIREUS_OLF_SERIALIZATION_CANONICAL ||
        result.grammar.serialization_kinds[1] !=
            PIREUS_OLF_SERIALIZATION_ALTERNATE {
        return 3
    }
    let expected_targets: [i64; 4] = [
        726101, 726102, 726103, 726104
    ]
    let expected_endpoints: [i64; 4] = [1, 1, 2, 2]
    let expected_primitives: [i64; 4] = [1, 2, 3, 4]
    index = 0
    while index < PIREUS_OLF_TARGET_COUNT {
        if result.targets.target_ids[index] != expected_targets[index] ||
            result.targets.endpoint_requirements[index] !=
                expected_endpoints[index] ||
            result.targets.observed_endpoints[index] != 0 ||
            result.targets.material_receipts[index] != 0 ||
            result.targets.primitive_candidates[index] !=
                expected_primitives[index] ||
            !result.targets.candidate_only[index] {
            return 4
        }
        index = index + 1
    }
    if !result.targets.complete || result.targets.target_checks != 10 ||
        result.targets.target_failures != 0 ||
        result.targets.required_endpoints != 6 ||
        result.targets.observed_endpoint_total != 0 ||
        result.targets.unresolved_endpoints != 6 {
        return 4
    }
    let expected_representatives: [i64; 14] = [
        0, 1, 2, 3, 8, 9, 11, 12, 13, 15, 16, 17, 18, 19
    ]
    if !result.semantics.complete ||
        !result.semantics.definitional_reconstruction ||
        result.semantics.operator_classes != 14 ||
        result.semantics.representative_checks != 14 ||
        result.semantics.representative_failures != 0 ||
        result.semantics.parent_relation_checks != 28 ||
        result.semantics.parent_relation_failures != 0 ||
        result.semantics.partner_checks != 3584 ||
        result.semantics.partner_failures != 0 ||
        result.semantics.sign_checks != 112 ||
        result.semantics.sign_failures != 0 ||
        result.semantics.roundtrip_word_checks != 112 ||
        result.semantics.roundtrip_word_failures != 0 ||
        result.semantics.order_checks != 3584 ||
        result.semantics.order_failures != 0 ||
        result.semantics.destination_checks != 3584 ||
        result.semantics.destination_failures != 0 {
        return 5
    }
    index = 0
    while index < 14 {
        if result.semantics.representatives[index] !=
            expected_representatives[index] {
            return 5
        }
        index = index + 1
    }
    if !result.atlas.complete || result.atlas.candidate_count != 1120 ||
        result.atlas.generation_attempts != 1120 ||
        result.atlas.capacity_overflows != 0 ||
        result.atlas.program_class_count != 560 ||
        result.atlas.machine_class_count != 4 ||
        result.atlas.program_equivalence_checks != 1120 ||
        result.atlas.program_equivalence_failures != 0 ||
        result.atlas.program_separation_checks != 626080 ||
        result.atlas.program_separation_failures != 0 ||
        result.atlas.machine_equivalence_checks != 1120 ||
        result.atlas.machine_equivalence_failures != 0 ||
        result.atlas.serialization_collapse_checks != 560 ||
        result.atlas.serialization_collapse_failures != 0 ||
        result.atlas.order_separation_checks != 1120 ||
        result.atlas.order_separation_failures != 0 ||
        result.atlas.residual_count != 1120 ||
        result.atlas.lowering_seed_count != 560 ||
        result.atlas.primitive_seed_count != 420 ||
        result.atlas.fabric_seed_count != 140 ||
        result.atlas.operator_seed_count != 0 ||
        result.atlas.discharged_obligations != 3360 ||
        result.atlas.unresolved_obligations != 10080 ||
        result.atlas.refuted_obligations != 0 ||
        result.atlas.admitted_lowerings != 0 ||
        result.atlas.selected_candidate != -1 ||
        result.atlas.ranking_present {
        return 6
    }
    if !result.receipt.parent_lineage_bound ||
        !result.receipt.graph_grammar_complete ||
        !result.receipt.semantic_decomposition_complete ||
        !result.receipt.semantic_decomposition_definitional ||
        !result.receipt.target_envelopes_complete ||
        !result.receipt.operator_quotient_inherited ||
        !result.receipt.declared_program_quotient_complete ||
        !result.receipt.declared_machine_envelope_quotient_complete ||
        result.receipt.material_machine_quotient_complete ||
        !result.receipt.typed_residuals_complete ||
        !result.receipt.typed_seed_taxonomy_complete ||
        !result.receipt.lowering_novelty_typed ||
        !result.receipt.primitive_novelty_typed ||
        !result.receipt.embodiment_novelty_typed ||
        result.receipt.operator_seed_generated ||
        result.receipt.target_observations_admitted ||
        result.receipt.target_lowerings_admitted ||
        result.receipt.target_costs_admitted ||
        result.receipt.target_performance_admitted ||
        !result.receipt.no_candidate_selected ||
        result.receipt.semantics_frozen ||
        result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open ||
        result.receipt.material_parity_open ||
        result.receipt.algorithmic_novelty ||
        result.receipt.material_novelty ||
        result.receipt.historical_novelty ||
        result.receipt.priority_claim || result.receipt.claim_ready {
        return 7
    }
    if result.negatives.passed != 21 || result.negatives.total != 21 ||
        !result.negatives.python_oracle || !result.negatives.rust_oracle ||
        !result.negatives.cpp_authority || !result.negatives.llm_authority ||
        !result.negatives.missing_policy || !result.negatives.missing_parent ||
        !result.negatives.unfrozen_parent ||
        !result.negatives.unbound_parent || !result.negatives.wrong_grammar ||
        !result.negatives.result_injection || !result.negatives.selection ||
        !result.negatives.ranking || !result.negatives.material_prefreeze ||
        !result.negatives.parity_prefreeze ||
        !result.negatives.claim_promotion ||
        !result.negatives.review_promotion ||
        !result.negatives.invalid_waiver ||
        !result.negatives.same_graph_collapsed ||
        !result.negatives.different_order_separated ||
        !result.negatives.endpoint_erasure_refused ||
        !result.negatives.residual_fallback_refused {
        return 8
    }
    let expected_lineage: [i64; 8] = [
        1362486852, 1199191553, 3136252067, 3927939706,
        743362006, 2548388592, 367445655, 294740523
    ]
    let expected_grammar: [i64; 8] = [
        1741576844, 3511803475, 4114603717, 1484560359,
        983396196, 1362631209, 2090336790, 2466145555
    ]
    let expected_targets_digest: [i64; 8] = [
        1178030270, 2553538819, 3882705700, 3211727400,
        3843654613, 275317601, 1148804265, 1162831727
    ]
    let expected_semantics: [i64; 8] = [
        284432857, 519474153, 1234600921, 2759907709,
        1151458261, 3046043008, 3035575678, 2657662517
    ]
    let expected_atlas: [i64; 8] = [
        1550165084, 3733282509, 3323663250, 871519586,
        3948427729, 1163695456, 1069774959, 2729693357
    ]
    let expected_receipt: [i64; 8] = [
        1431375457, 687484805, 1164180164, 195578933,
        3568044397, 441466530, 1518228999, 2908285955
    ]
    let expected_forge: [i64; 8] = [
        2539393129, 4020369131, 3147403558, 2306440881,
        94983304, 453189920, 2257839762, 3786373918
    ]
    if !olf_digest_matches(&result.lineage_digest, &expected_lineage) ||
        !olf_digest_matches(&result.grammar_digest, &expected_grammar) ||
        !olf_digest_matches(&result.target_digest, &expected_targets_digest) ||
        !olf_digest_matches(&result.semantic_digest, &expected_semantics) ||
        !olf_digest_matches(&result.atlas_digest, &expected_atlas) ||
        !olf_digest_matches(&result.receipt_digest, &expected_receipt) ||
        !olf_digest_matches(&result.forge_digest, &expected_forge) {
        return 9
    }
    0
}

pub fn pireus_operator_lowering_matches_frozen_semantics(
    result: &PireusOlfResult,
) -> bool with Mut, Panic {
    pireus_operator_lowering_frozen_mismatch_code(result) == 0
}
