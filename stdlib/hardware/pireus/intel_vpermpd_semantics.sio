    pub oversized_output_font: bool,
    pub oversized_output_content_candidate: bool,
    pub flate_decode_failures: i64,
    pub decoded_bytes: i64,
    pub decoded_vpermpd_count: i64,
    pub decoded_vpermi2pd_count: i64,
    pub decoded_vpermt2pd_count: i64,
    pub first_vpermpd_stream_offset: i64,
    pub vpermpd_streams: i64,
    pub operation_streams: i64,
    pub first_operation_stream_offset: i64,
    pub description_page_matches: i64,
    pub vector_form_matches: i64,
    pub description_selector_rule_matches: i64,
    pub operation_page_matches: i64,
