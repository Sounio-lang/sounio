//@ module hardware::pireus::intel_vpermpd_semantics
//! Bounded Sounio-owned probe for the pinned Intel SDM Volume 2C bytes.

use crypto::sha256::{
    SHA256Digest, sha256_init, sha256_update, sha256_finalize,
}
use compress::inflate::{
    SounioInflateInput, SounioInflateResult,
    SOUNIO_INFLATE_OK,
    SOUNIO_INFLATE_ERR_OUTPUT_CAPACITY,
    SOUNIO_INFLATE_INPUT_CAPACITY,
    sounio_inflate_zlib,
}
use hardware::pireus::xor_material_matching::{
    pireus_xor_material_evaluate,
    pireus_xor_material_matches_frozen_semantics,
}

pub const PIREUS_INTEL_PDF_OK: i64 = 0
pub const PIREUS_INTEL_PDF_ERR_FILE: i64 = 1
pub const PIREUS_INTEL_PDF_ERR_LENGTH: i64 = 2
pub const PIREUS_INTEL_PDF_ERR_HASH: i64 = 3
pub const PIREUS_INTEL_PDF_ERR_HEADER: i64 = 4
pub const PIREUS_INTEL_PDF_ERR_EOF: i64 = 5
pub const PIREUS_INTEL_PDF_ERR_STARTXREF: i64 = 6
pub const PIREUS_INTEL_PDF_ERR_SEMANTIC_ANCHOR: i64 = 7
pub const PIREUS_INTEL_PDF_ERR_PARENT: i64 = 8
pub const PIREUS_INTEL_PDF_ERR_SELECTOR_MATCH: i64 = 9

pub const PIREUS_INTEL_PDF_EXPECTED_BYTES: i64 = 3298744
pub const PIREUS_INTEL_PDF_FILE_CAPACITY: i64 = 3400000

const PIREUS_INTEL_PDF_FILE_WORDS: i64 = 425000

var PIREUS_INTEL_PDF_WORDS: [i64; 425000]
var PIREUS_INTEL_ANCHOR_STREAM: [i64; 262144]
var PIREUS_INTEL_ANCHOR_STREAM_LEN: i64 = 0
var PIREUS_INTEL_ANCHOR_TEXT: [i64; 131072]
var PIREUS_INTEL_ANCHOR_TEXT_LEN: i64 = 0

