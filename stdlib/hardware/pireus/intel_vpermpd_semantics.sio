    pub raw_vpermi2pd_count: i64,
    pub raw_vpermt2pd_count: i64,
    pub stream_markers: i64,
    pub direct_length_streams: i64,
    pub indirect_or_unknown_length_streams: i64,
    pub flate_streams: i64,
    pub decodable_flate_streams: i64,
    pub decoded_flate_streams: i64,
    pub oversized_flate_inputs: i64,
    pub oversized_flate_outputs: i64,
