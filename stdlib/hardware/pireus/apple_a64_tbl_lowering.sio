const AX_TAG_PS: i64 = 6
const AX_TAG_PSTEXT: i64 = 7

const AX_NAME_NONE: i64 = 0
const AX_NAME_Q: i64 = 1
const AX_NAME_LEN: i64 = 2
const AX_NAME_TBL_ICLASS: i64 = 3

const AX_KEY_NONE: i64 = 0
const AX_KEY_INSTR_CLASS: i64 = 1
const AX_KEY_ISA: i64 = 2
const AX_KEY_MNEMONIC: i64 = 3

const AX_VALUE_NONE: i64 = 0
