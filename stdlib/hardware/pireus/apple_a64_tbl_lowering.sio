fn ax_zero_digest() -> PireusAppleDigest {
    PireusAppleDigest { words: [0; 8] }
}

fn ax_hash_words(digest: &SHA256Digest) -> [i64; 8]
with Mut, Panic {
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                (sha256_digest_byte(digest, (word * 4 + byte) as i32) as i64)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    words
}

fn ax_file_digest(path: string) -> AppleFileDigest
with IO, Mut, Panic, Div, Alloc {
    let size = file_size(path)
    if size < 0 || size >= 1048576 {
        return AppleFileDigest { valid: false, bytes: size, words: [0; 8] }
    }
    let raw = read_file(path)
    var state = sha256_init()
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var b = raw[(pos + i) as usize] as i64
            if b < 0 { b = b + 256 }
            window[i as usize] = b as u8
            i = i + 1
        }
        state = sha256_update(state, window, count as i32)
        pos = pos + count
    }
    let digest = sha256_finalize(state)
    AppleFileDigest { valid: true, bytes: size, words: ax_hash_words(&digest) }
}

fn ax_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if left[i] != right[i] { return false }
        i = i + 1
    }
    true
}

