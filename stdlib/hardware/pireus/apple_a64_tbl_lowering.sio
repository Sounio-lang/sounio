fn ax_ascii_string_eq(left: string, right: string) -> bool with Mut, Panic {
    let n = str_len(left)
    if n != str_len(right) { return false }
    var i: i64 = 0
    while i < n {
        if str_char_at(left, i) != str_char_at(right, i) { return false }
        i = i + 1
    }
    true
}

fn ax_parent_bindings(
    garden_path: string,
    lowering_source_path: string,
    lowering_semantics_path: string,
    lowering_receipt_path: string,
    aarchmrs_source_path: string,
    aarchmrs_semantics_path: string,
    aarchmrs_receipt_path: string,
    tbl_path: string,
    tbx_path: string,
    notice_path: string,
) -> PireusAppleParentBindings with IO, Mut, Panic, Div, Alloc {
    let garden = ax_file_digest(garden_path)
    let lowering_source = ax_file_digest(lowering_source_path)
    let lowering_semantics = ax_file_digest(lowering_semantics_path)
    let lowering_receipt = ax_file_digest(lowering_receipt_path)
    let aarchmrs_source = ax_file_digest(aarchmrs_source_path)
    let aarchmrs_semantics = ax_file_digest(aarchmrs_semantics_path)
    let aarchmrs_receipt = ax_file_digest(aarchmrs_receipt_path)
    let tbl = ax_file_digest(tbl_path)
    let tbx = ax_file_digest(tbx_path)
    let notice = ax_file_digest(notice_path)
    let expected_garden = ax_expected_garden_hash()
    let expected_lowering_source = ax_expected_lowering_source_hash()
    let expected_lowering_semantics = ax_expected_lowering_semantics_hash()
    let expected_lowering_receipt = ax_expected_lowering_receipt_hash()
    let expected_aarchmrs_source = ax_expected_aarchmrs_source_hash()
    let expected_aarchmrs_semantics = ax_expected_aarchmrs_semantics_hash()
    let expected_aarchmrs_receipt = ax_expected_aarchmrs_receipt_hash()
    let expected_tbl = ax_expected_tbl_hash()
    let expected_tbx = ax_expected_tbx_hash()
    let expected_notice = ax_expected_notice_hash()
    let expected_archive = ax_expected_archive_hash()
    let garden_match = garden.valid && garden.bytes == 10528 &&
        ax_hash_equal(&garden.words, &expected_garden)
    let lowering_source_match = lowering_source.valid &&
        ax_hash_equal(&lowering_source.words, &expected_lowering_source)
    let lowering_semantics_match = lowering_semantics.valid &&
        ax_hash_equal(&lowering_semantics.words, &expected_lowering_semantics)
    let lowering_receipt_match = lowering_receipt.valid &&
        ax_hash_equal(&lowering_receipt.words, &expected_lowering_receipt)
    let aarchmrs_source_match = aarchmrs_source.valid &&
        ax_hash_equal(&aarchmrs_source.words, &expected_aarchmrs_source)
    let aarchmrs_semantics_match = aarchmrs_semantics.valid &&
        ax_hash_equal(&aarchmrs_semantics.words, &expected_aarchmrs_semantics)
    let aarchmrs_receipt_match = aarchmrs_receipt.valid &&
        ax_hash_equal(&aarchmrs_receipt.words, &expected_aarchmrs_receipt)
    let corpus_binding = ax_ascii_string_eq(
        pireus_aarchmrs_expected_sha256(),
        "bedf5f8fc142d6232f15caaa170b9fab996a732db0b04bf4604e91fb10c3244b")
    let tbl_match = tbl.valid && tbl.bytes == 14897 &&
        ax_hash_equal(&tbl.words, &expected_tbl)
    let tbx_match = tbx.valid && tbx.bytes == 14962 &&
        ax_hash_equal(&tbx.words, &expected_tbx)
    let notice_match = notice.valid && notice.bytes == 5212 &&
        ax_hash_equal(&notice.words, &expected_notice)
    let valid = garden_match && lowering_source_match &&
        lowering_semantics_match && lowering_receipt_match &&
        aarchmrs_source_match && aarchmrs_semantics_match &&
        aarchmrs_receipt_match && corpus_binding && tbl_match && tbx_match &&
        notice_match
    PireusAppleParentBindings {
        garden_match: garden_match,
        lowering_source_match: lowering_source_match,
        lowering_semantics_match: lowering_semantics_match,
        lowering_receipt_match: lowering_receipt_match,
        aarchmrs_source_match: aarchmrs_source_match,
        aarchmrs_semantics_match: aarchmrs_semantics_match,
        aarchmrs_receipt_match: aarchmrs_receipt_match,
        aarchmrs_corpus_binding_match: corpus_binding,
        tbl_xml_match: tbl_match,
        tbx_xml_match: tbx_match,
        notice_xml_match: notice_match,
        archive_sha256: expected_archive,
        valid: valid,
    }
}

