pub const PIREUS_APPLE_A64_ERR_FILE: i64 = 1
pub const PIREUS_APPLE_A64_ERR_HASH: i64 = 2
pub const PIREUS_APPLE_A64_ERR_XML: i64 = 3
pub const PIREUS_APPLE_A64_ERR_SHAPE: i64 = 4
pub const PIREUS_APPLE_A64_ERR_PARENT: i64 = 5
pub const PIREUS_APPLE_A64_ERR_CANDIDATE: i64 = 6
pub const PIREUS_APPLE_A64_ERR_AUTHORITY: i64 = 7

