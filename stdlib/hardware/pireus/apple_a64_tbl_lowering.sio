//! Sounio-first Apple Silicon CPU candidate for the frozen XOR selector.
//!
//! The importer verifies the committed Garden and frozen parent artifacts,
//! parses the pinned A64 TBL XML structurally, recognizes the bounded ASL
//! rules, and derives a finite selector candidate. A64 architectural semantics
//! remain distinct from Apple material support and compiler emission.

use crypto::sha256::{
    SHA256State, SHA256Digest,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}
use hardware::pireus::xor_lowering_legality::{
    PIREUS_XOR_LOWERING_BITS,
    PIREUS_XOR_LOWERING_DIMENSION,
}
use hardware::pireus::aarchmrs_import::{
    pireus_aarchmrs_expected_sha256,
}

