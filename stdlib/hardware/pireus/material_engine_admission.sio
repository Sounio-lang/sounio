fn pmea_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if left[i] != right[i] { return false }
        i = i + 1
    }
    true
}

fn pmea_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 8] = [0; 8]
    var i: i64 = 0
    while i < 8 {
        bytes[i as usize] = ((value >> ((7 - i) * 8)) & 255) as u8
        i = i + 1
    }
    sha256_update(state, bytes, 8)
}

fn pmea_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    pmea_digest_add_i64(state, if value { 1 } else { 0 })
}

fn pmea_digest_finish(state: SHA256State) -> PireusMaterialEngineDigest
with Mut, Panic, Div {
    let finalized = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var i: i64 = 0
    while i < 8 {
        var word: i64 = 0
        var j: i64 = 0
        while j < 4 {
            word = word * 256 + sha256_digest_byte(finalized, i * 4 + j)
            j = j + 1
        }
        words[i as usize] = word
        i = i + 1
    }
    PireusMaterialEngineDigest { words: words }
}

fn pmea_file_hash(path: string) -> PireusMaterialEngineDigest
with IO, Mut, Panic, Div, Alloc {
    let size = file_size(path)
    if size <= 0 || size >= 1048576 {
        return PireusMaterialEngineDigest { words: [0; 8] }
    }
    let raw = read_file(path)
    var state = sha256_init()
    var pos: i64 = 0
    while pos < size {
        var window: [u8; 256] = [0; 256]
        var count = size - pos
        if count > 256 { count = 256 }
        var i: i64 = 0
        while i < count {
            var byte = raw[(pos + i) as usize] as i64
            if byte < 0 { byte = byte + 256 }
            window[i as usize] = byte as u8
            i = i + 1
        }
        state = sha256_update(state, window, count as i32)
        pos = pos + count
    }
    pmea_digest_finish(state)
}

fn pmea_expected_parent_hash(index: i64) -> [i64; 8] {
    if index == 0 { return [0x08d6bd31, 0x93db9a2c, 0xe0cd849d, 0xb4b1197d, 0x38904932, 0x2be3be29, 0x86bd9f95, 0x5257b21e] }
    if index == 1 { return [0x8b5063f0, 0xe9a39650, 0xfb0b60e8, 0xb70b315f, 0x33972369, 0x0e06050c, 0x2bebacec, 0xe888e37e] }
    if index == 2 { return [0xc47668a0, 0x8ad25f39, 0xbebe9d8b, 0xef90b66e, 0xb2ad7119, 0x063c19ab, 0x8319fa4f, 0xab265233] }
    if index == 3 { return [0x9da8ca53, 0xc3cb0e66, 0x31c92e55, 0xa8e82387, 0xaed2bd53, 0x863ffa9d, 0x64671980, 0x6eec4ffd] }
    if index == 4 { return [0x7ea2815c, 0x112b8547, 0x6fc6ac4d, 0x8bb9388e, 0xe0320628, 0x22c69054, 0x85c2084e, 0xe416d6bc] }
    if index == 5 { return [0x0a899be7, 0xcd25375c, 0x8c444b9e, 0x1f0a71dd, 0x102ca895, 0x8072a429, 0x0073ae21, 0xc926a199] }
    if index == 6 { return [0xb7577c78, 0x2a82431e, 0xb5431213, 0x7a52c181, 0x1f14316d, 0x5e5a5fb9, 0xe7aa9581, 0xf1c304ca] }
    if index == 7 { return [0x06f21108, 0xddc89c8c, 0x468097b7, 0xcefec6a7, 0x66bda065, 0x918fd579, 0x7be19487, 0x8371577b] }
    if index == 8 { return [0xc00a3d4e, 0x55668882, 0x9efadbbf, 0x640ea858, 0xcfe9520d, 0xc04103fa, 0x745cf1a8, 0x101f7840] }
    if index == 9 { return [0x2877bfd4, 0x63b4d28d, 0xc3311b75, 0xc69bec2a, 0xa1c62b43, 0x0d083149, 0x89187d44, 0xb32a781e] }
    if index == 10 { return [0x3c10882e, 0xff43d3b1, 0x97428839, 0x996c7a04, 0xc009c8f5, 0x37d0c145, 0x1bdf3e8a, 0x13e2f385] }
    if index == 11 { return [0x2c6b6e44, 0x8265a556, 0x6d17df9a, 0x674246ea, 0x62c05210, 0xe432e48e, 0x418d1635, 0x8496853b] }
    [0; 8]
}

fn pmea_parent_path(paths: &PireusMaterialEngineParentPaths, index: i64) -> string {
    if index == 0 { return paths.garden }
    if index == 1 { return paths.engine_source }
    if index == 2 { return paths.engine_semantics }
    if index == 3 { return paths.engine_receipt }
    if index == 4 { return paths.cost_source }
    if index == 5 { return paths.cost_semantics }
    if index == 6 { return paths.cost_receipt }
    if index == 7 { return paths.cost_evidence }
    if index == 8 { return paths.apple_receipt }
    if index == 9 { return paths.apple_evidence }
    if index == 10 { return paths.dgx_receipt }
    paths.dgx_evidence
}

fn pmea_parent_match_mask(paths: &PireusMaterialEngineParentPaths) -> i64
with IO, Mut, Panic, Div, Alloc {
    var mask: i64 = 0
    var i: i64 = 0
    while i < PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT {
        let actual = pmea_file_hash(pmea_parent_path(paths, i))
        let expected = pmea_expected_parent_hash(i)
        if pmea_hash_equal(&actual.words, &expected) {
            mask = mask | (1 << i)
        }
        i = i + 1
    }
    mask
}

pub fn pireus_material_engine_parent_file_matches(mask: i64, index: i64) -> bool {
    index >= 0 && index < PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT &&
        (mask & (1 << index)) != 0
}

fn pmea_all_parents_match(mask: i64) -> bool {
    mask == (1 << PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT) - 1
}

pub fn pireus_material_engine_parent_error(mask: i64) -> i64 {
    if !pireus_material_engine_parent_file_matches(mask, 0) {
        return PIREUS_MATERIAL_PARENT_ERR_GARDEN
    }
    var i: i64 = 1
    while i < 8 {
        if !pireus_material_engine_parent_file_matches(mask, i) {
            return PIREUS_MATERIAL_PARENT_ERR_CONTROL
        }
        i = i + 1
    }
    if !pireus_material_engine_parent_file_matches(mask, 8) {
        return PIREUS_MATERIAL_PARENT_ERR_APPLE_RECEIPT
    }
    if !pireus_material_engine_parent_file_matches(mask, 9) {
        return PIREUS_MATERIAL_PARENT_ERR_APPLE_EVIDENCE
    }
    if !pireus_material_engine_parent_file_matches(mask, 10) {
        return PIREUS_MATERIAL_PARENT_ERR_DGX_RECEIPT
    }
    if !pireus_material_engine_parent_file_matches(mask, 11) {
        return PIREUS_MATERIAL_PARENT_ERR_DGX_EVIDENCE
    }
    PIREUS_MATERIAL_PARENT_OK
}

