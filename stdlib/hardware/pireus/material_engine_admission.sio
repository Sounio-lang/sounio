    PireusMaterialEngineCandidate {
        target_id: PIREUS_TARGET_APPLE_SILICON,
        locator_id: PIREUS_LOCATOR_APPLE_TAILNET,
        machine_id: PIREUS_MACHINE_APPLE_MAC17_7,
