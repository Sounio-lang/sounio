        engine_kind: PIREUS_ENGINE_KIND_CPU,
        isa_id: PIREUS_ENGINE_ISA_AARCH64,
        interface_id: 0,
        receipt_id: PIREUS_RECEIPT_APPLE_A64_TBL,
        evidence_id: PIREUS_EVIDENCE_APPLE_A64_TBL,
        hardware_id: PIREUS_HARDWARE_APPLE_MAC17_7,
        material_operation_id: PIREUS_MATERIAL_OPERATION_APPLE_A64_TBL,
        producer_language: PIREUS_MATERIAL_LANGUAGE_CPP,
        producer_role: PIREUS_MATERIAL_ROLE_MATERIAL_PARITY,
        semantic_authority_language: PIREUS_MATERIAL_LANGUAGE_SOUNIO,
        parity_receipt_valid: true,
        material_execution_observed: true,
        blueprint_only: false,
        selector_covered: true,
        whole_operation_covered: false,
        cost_value_present: false,
        comparison_promoted: false,
        review_promoted: false,
        parity_open: false,
        claim_ready: false,
    }
}

