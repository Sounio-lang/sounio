fn pom_empty_digest() -> PireusPomDigest {
    PireusPomDigest { words: [0; 8] }
}

fn pom_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn pom_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div {
    var next = state
    var index: i64 = 0
    while index < 8 {
        next = pom_digest_add_i64(next, words[index])
        index = index + 1
    }
    next
}

fn pom_digest_finish(state: SHA256State) -> PireusPomDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusPomDigest { words: words }
}

pub fn pireus_pom_digest_nonzero(digest: &PireusPomDigest) -> bool with Mut {
    var index: i64 = 0
    while index < 8 {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

pub fn pireus_operator_morphogenesis_request() -> PireusPomRequest {
    PireusPomRequest {
        producer_language: PIREUS_POM_LANGUAGE_SOUNIO,
        producer_role: PIREUS_POM_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_POM_STAGE_SOUNIO_EXECUTABLE,
        policy_ready: true,
        garden_bound: true,
        contract_bound: true,
        cubic_source_bound: true,
        cubic_semantics_bound: true,
        cubic_freeze_bound: true,
        cubic_parity_bound: true,
        frontier_semantics_bound: true,
        frontier_material_bound: true,
        declared_epochs: PIREUS_POM_EPOCHS,
        complete_archive_required: true,
        witness_reuse_requested: false,
        witness_agreement_requested: false,
        omit_action_image_requested: false,
        break_unit_requested: false,
        break_xor_route_requested: false,
        reassociate_requested: false,
        expected_archive_count_present: false,
        expected_sign_present: false,
        expected_digest_present: false,
        incomplete_comparison_requested: false,
        candidate_selection_requested: false,
        ranking_requested: false,
        parity_process_requested: false,
        semantic_write_from_parity: false,
        expected_result_write_from_parity: false,
        review_promoted_to_authority: false,
        material_result_requested: false,
        historical_claim_requested: false,
        claim_ready_requested: false,
        raw_elf_requested: false,
    }
}

fn pom_request_error(request: &PireusPomRequest) -> i64 {
    if request.producer_language != PIREUS_POM_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_POM_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_POM_ERR_AUTHORITY
    }
    if request.stage != PIREUS_POM_STAGE_SOUNIO_EXECUTABLE {
        return PIREUS_POM_ERR_STAGE
    }
    if !request.policy_ready { return PIREUS_POM_ERR_POLICY }
    if !request.garden_bound || !request.contract_bound ||
        !request.cubic_source_bound || !request.cubic_semantics_bound ||
        !request.cubic_freeze_bound || !request.cubic_parity_bound ||
        !request.frontier_semantics_bound ||
        !request.frontier_material_bound {
        return PIREUS_POM_ERR_LINEAGE
    }
    if request.declared_epochs != PIREUS_POM_EPOCHS ||
        !request.complete_archive_required || request.witness_reuse_requested ||
        request.witness_agreement_requested ||
        request.omit_action_image_requested || request.break_unit_requested ||
        request.break_xor_route_requested || request.reassociate_requested ||
        request.incomplete_comparison_requested {
        return PIREUS_POM_ERR_GRAMMAR
    }
    if request.expected_archive_count_present ||
        request.expected_sign_present || request.expected_digest_present {
        return PIREUS_POM_ERR_RESULT_INJECTION
    }
    if request.parity_process_requested || request.semantic_write_from_parity ||
        request.expected_result_write_from_parity ||
        request.review_promoted_to_authority {
        return PIREUS_POM_ERR_PARITY
    }
    if request.material_result_requested { return PIREUS_POM_ERR_MATERIAL }
    if request.candidate_selection_requested || request.ranking_requested ||
        request.historical_claim_requested || request.claim_ready_requested {
        return PIREUS_POM_ERR_CLAIM
    }
    if request.raw_elf_requested { return PIREUS_POM_ERR_RAW_ELF }
    PIREUS_POM_OK
}

fn pom_action_lane(value: i64) -> i64 {
    (value & 12) | ((value & 1) << 1) | ((value >> 1) & 1)
}

fn pom_action_cell(cell: i64) -> i64 {
    let left = cell / PIREUS_POM_LANES
    let right = cell - left * PIREUS_POM_LANES
    pom_action_lane(left) * PIREUS_POM_LANES + pom_action_lane(right)
}

fn pom_interior_cell(rank: i64) -> i64 with Mut {
    var current: i64 = 0
    var destination: i64 = 0
    while destination < PIREUS_POM_LANES {
        var left: i64 = 1
        while left < PIREUS_POM_LANES {
            let right = left ^ destination
            if right > 0 {
                if current == rank {
                    return left * PIREUS_POM_LANES + right
                }
                current = current + 1
            }
            left = left + 1
        }
        destination = destination + 1
    }
    -1
}

fn pom_phase_index(left: i64, right: i64) -> i64 {
    if left <= 0 || right <= 0 || left >= PIREUS_POM_LANES ||
        right >= PIREUS_POM_LANES { return -1 }
    (left - 1) * 15 + (right - 1)
}

fn pom_cd_bit(left: i64, right: i64) -> i64 with Mut, Panic, Div {
    if cd_sigma(left as i32, right as i32, PIREUS_POM_BITS as i32) < 0 {
        1
    } else { 0 }
}

fn pom_rows_equal(left: &[i64; 256], right: &[i64; 256]) -> bool
with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_POM_SIGN_CELLS {
        if left[cell] != right[cell] { return false }
        cell = cell + 1
    }
    true
}

fn pom_row_less(left: &[i64; 256], right: &[i64; 256]) -> bool
with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_POM_SIGN_CELLS {
        if left[cell] < right[cell] { return true }
        if left[cell] > right[cell] { return false }
        cell = cell + 1
    }
    false
}

fn pom_archive_equals_row(
    archive: &[i64; 32768], index: i64, row: &[i64; 256],
) -> bool with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_POM_SIGN_CELLS {
        if archive[index * PIREUS_POM_SIGN_CELLS + cell] != row[cell] {
            return false
        }
        cell = cell + 1
    }
    true
}

fn pom_archive_find(
    archive: &[i64; 32768], count: i64, row: &[i64; 256],
) -> i64 with Mut, Panic {
    var index: i64 = 0
    while index < count {
        if pom_archive_equals_row(archive, index, row) { return index }
        index = index + 1
    }
    -1
}

fn pom_archive_action_partner(
    archive: &[i64; 32768], count: i64, source: i64,
) -> i64 with Mut, Panic {
    var target: i64 = 0
    while target < count {
        var equal = true
        var cell: i64 = 0
        while cell < PIREUS_POM_SIGN_CELLS {
            if archive[target * PIREUS_POM_SIGN_CELLS + cell] !=
                archive[source * PIREUS_POM_SIGN_CELLS +
                    pom_action_cell(cell)] {
                equal = false
            }
            cell = cell + 1
        }
        if equal { return target }
        target = target + 1
    }
    -1
}

fn pom_archive_digest(archive: &[i64; 32768], count: i64)
-> PireusPomDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pom_digest_add_i64(state, PIREUS_POM_SCHEMA)
    state = pom_digest_add_i64(state, count)
    var index: i64 = 0
    while index < count {
        var cell: i64 = 0
        while cell < PIREUS_POM_SIGN_CELLS {
            state = pom_digest_add_i64(
                state, archive[index * PIREUS_POM_SIGN_CELLS + cell])
            cell = cell + 1
        }
        index = index + 1
    }
    pom_digest_finish(state)
}

fn pom_build_lineage(parent: &PireusCubicForgeResult)
-> PireusPomLineage with Mut, Panic, Div, Epistemic {
    let live = parent.valid && parent.failures == 0
    let frozen = pireus_cubic_operator_forge_matches_frozen_semantics(parent)
    PireusPomLineage {
        garden_sha256: pom_garden_hash(),
        contract_sha256: pom_contract_hash(),
        cubic_source_sha256: pom_cubic_source_hash(),
        cubic_semantics_sha256: pom_cubic_semantics_hash(),
        cubic_freeze_sha256: pom_cubic_freeze_hash(),
        cubic_parity_sha256: pom_cubic_parity_hash(),
        frontier_semantics_sha256: pom_frontier_semantics_hash(),
        frontier_material_sha256: pom_frontier_material_hash(),
        cubic_live_valid: live,
        cubic_frozen_match: frozen,
        complete: live && frozen,
    }
}

fn pom_epoch_digest(
    epoch: i64,
    parent_digest: &PireusPomDigest,
    signs: &[i64; 256],
    phase: &[i64; 225],
    anf: &[i64; 225],
    certificate_start: i64,
    certificate_end: i64,
    certificate_kinds: &[i64; 4096],
    certificate_archive_indices: &[i64; 4096],
    certificate_partner_indices: &[i64; 4096],
    certificate_cells: &[i64; 4096],
    certificate_generated_bits: &[i64; 4096],
    certificate_archived_bits: &[i64; 4096],
    orbit_kind: i64,
    negatives: i64,
    squares: i64,
    commutators: i64,
    associators: i64,
    probes: &[i64; 16],
    output_archive_digest: &PireusPomDigest,
) -> PireusPomDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pom_digest_add_i64(state, PIREUS_POM_SCHEMA)
    state = pom_digest_add_i64(state, epoch)
    state = pom_digest_add_words(state, &parent_digest.words)
    var cell: i64 = 0
    while cell < PIREUS_POM_SIGN_CELLS {
        state = pom_digest_add_i64(state, signs[cell])
        cell = cell + 1
    }
    var interior: i64 = 0
    while interior < PIREUS_POM_INTERIOR_CELLS {
        state = pom_digest_add_i64(state, phase[interior])
        state = pom_digest_add_i64(state, anf[interior])
        interior = interior + 1
    }
    var certificate = certificate_start
    while certificate < certificate_end {
        state = pom_digest_add_i64(state, certificate_kinds[certificate])
        state = pom_digest_add_i64(
            state, certificate_archive_indices[certificate])
        state = pom_digest_add_i64(
            state, certificate_partner_indices[certificate])
        state = pom_digest_add_i64(state, certificate_cells[certificate])
        state = pom_digest_add_i64(
            state, certificate_generated_bits[certificate])
        state = pom_digest_add_i64(
            state, certificate_archived_bits[certificate])
        certificate = certificate + 1
    }
    state = pom_digest_add_i64(state, orbit_kind)
    state = pom_digest_add_i64(state, negatives)
    state = pom_digest_add_i64(state, squares)
    state = pom_digest_add_i64(state, commutators)
    state = pom_digest_add_i64(state, associators)
    var lane: i64 = 0
    while lane < PIREUS_POM_LANES {
        state = pom_digest_add_i64(state, probes[lane])
        lane = lane + 1
    }
    state = pom_digest_add_words(state, &output_archive_digest.words)
    pom_digest_finish(state)
}

fn pom_build_population(parent: &PireusCubicForgeResult)
-> PireusPomPopulation with Mut, Panic, Div, Epistemic {
    var archive: [i64; 32768] = [0; 32768]
    var archive_count: i64 = 0
    var archive_closure_checks: i64 = 0
    var archive_closure_failures: i64 = 0
    var archive_dedup_checks: i64 = 0
    var archive_capacity_failures: i64 = 0
    var cd_sign_checks: i64 = 0
    var cd_sign_failures: i64 = 0
    var cd_axis_checks: i64 = 0
    var cd_axis_failures: i64 = 0
    var phase_checks: i64 = 0
    var phase_failures: i64 = 0
    var anf_coefficient_checks: i64 = 0
    var anf_reconstruction_checks: i64 = 0
    var anf_reconstruction_failures: i64 = 0
    var certificate_count: i64 = 0
    var certificate_checks: i64 = 0
    var certificate_failures: i64 = 0
    var direct_comparison_checks: i64 = 0
    var direct_collision_failures: i64 = 0
    var unit_checks: i64 = 0
    var unit_failures: i64 = 0
    var microprogram_checks: i64 = 0
    var microprogram_failures: i64 = 0
    var capacity_refusals: i64 = 0
    var negative_sign_counts: [i64; 16] = [0; 16]
    var square_negative_counts: [i64; 16] = [0; 16]
    var commutator_defects: [i64; 16] = [0; 16]
    var associator_defects: [i64; 16] = [0; 16]
    var archive_before: [i64; 16] = [0; 16]
    var archive_after: [i64; 16] = [0; 16]
    var orbit_kinds: [i64; 16] = [0; 16]
    var generated_sign_bits: [i64; 4096] = [0; 4096]
    var generated_phase_bits: [i64; 3600] = [0; 3600]
    var generated_anf_bits: [i64; 3600] = [0; 3600]
    var microprogram_destinations: [i64; 4096] = [0; 4096]
    var microprogram_left_inputs: [i64; 4096] = [0; 4096]
    var microprogram_right_inputs: [i64; 4096] = [0; 4096]
    var microprogram_ordinals: [i64; 4096] = [0; 4096]
    var microprogram_sign_bits: [i64; 4096] = [0; 4096]
    var probe_outputs: [i64; 256] = [0; 256]
    var certificate_kinds: [i64; 4096] = [0; 4096]
    var certificate_epochs: [i64; 4096] = [0; 4096]
    var certificate_archive_indices: [i64; 4096] = [0; 4096]
    var certificate_partner_indices: [i64; 4096] = [0; 4096]
    var certificate_cells: [i64; 4096] = [0; 4096]
    var certificate_generated_bits: [i64; 4096] = [0; 4096]
    var certificate_archived_bits: [i64; 4096] = [0; 4096]
    var parent_archive_digest_words: [i64; 128] = [0; 128]
    var epoch_digest_words: [i64; 128] = [0; 128]

    var lane: i64 = 0
    while lane < PIREUS_POM_LANES {
        let left_axis = cd_sigma(0, lane as i32, PIREUS_POM_BITS as i32)
        let right_axis = cd_sigma(lane as i32, 0, PIREUS_POM_BITS as i32)
        cd_axis_checks = cd_axis_checks + 2
        if left_axis != 1 { cd_axis_failures = cd_axis_failures + 1 }
        if right_axis != 1 { cd_axis_failures = cd_axis_failures + 1 }
        lane = lane + 1
    }

    var child: i64 = 0
    while child < PIREUS_CUBIC_FORGE_MUTATION_COUNT {
        var direct: [i64; 256] = [0; 256]
        var action: [i64; 256] = [0; 256]
        var cell: i64 = 0
        while cell < PIREUS_POM_SIGN_CELLS {
            direct[cell] = parent.population.sign_bits[
                child * PIREUS_POM_SIGN_CELLS + cell]
            action[cell] = parent.population.sign_bits[
                child * PIREUS_POM_SIGN_CELLS + pom_action_cell(cell)]
            if direct[cell] < 0 || direct[cell] > 1 ||
                action[cell] < 0 || action[cell] > 1 {
                cd_sign_failures = cd_sign_failures + 1
            }
            cd_sign_checks = cd_sign_checks + 2
            cell = cell + 1
        }
        var first = direct
        var second = action
        if pom_row_less(&action, &direct) {
            first = action
            second = direct
        }
        archive_dedup_checks = archive_dedup_checks + archive_count
        if pom_archive_find(&archive, archive_count, &first) < 0 {
            if archive_count >= PIREUS_POM_ARCHIVE_CAPACITY {
                archive_capacity_failures = archive_capacity_failures + 1
            } else {
                cell = 0
                while cell < PIREUS_POM_SIGN_CELLS {
                    archive[archive_count * PIREUS_POM_SIGN_CELLS + cell] =
                        first[cell]
                    cell = cell + 1
                }
                archive_count = archive_count + 1
            }
        }
        if !pom_rows_equal(&first, &second) {
            archive_dedup_checks = archive_dedup_checks + archive_count
            if pom_archive_find(&archive, archive_count, &second) < 0 {
                if archive_count >= PIREUS_POM_ARCHIVE_CAPACITY {
                    archive_capacity_failures = archive_capacity_failures + 1
                } else {
                    cell = 0
                    while cell < PIREUS_POM_SIGN_CELLS {
                        archive[archive_count * PIREUS_POM_SIGN_CELLS + cell] =
                            second[cell]
                        cell = cell + 1
                    }
                    archive_count = archive_count + 1
                }
            }
        }
        child = child + 1
    }

    let initial_archive_count = archive_count
    var initial_index: i64 = 0
    while initial_index < initial_archive_count {
        archive_closure_checks = archive_closure_checks + 1
        if pom_archive_action_partner(
                &archive, initial_archive_count, initial_index) < 0 {
            archive_closure_failures = archive_closure_failures + 1
        }
        initial_index = initial_index + 1
    }

    var generated_epochs: i64 = 0
    var orbit_fixed: i64 = 0
    var orbit_pairs: i64 = 0
    var epoch: i64 = 0
    while epoch < PIREUS_POM_EPOCHS {
        let current_archive_count = archive_count
        archive_before[epoch] = current_archive_count
        if current_archive_count > PIREUS_POM_INTERIOR_CELLS ||
            current_archive_count <= 0 {
            capacity_refusals = capacity_refusals + 1
            break
        }

        var partners: [i64; 128] = [-1; 128]
        var archive_index: i64 = 0
        while archive_index < current_archive_count {
            let partner = pom_archive_action_partner(
                &archive, current_archive_count, archive_index)
            partners[archive_index] = partner
            archive_closure_checks = archive_closure_checks + 1
            if partner < 0 { archive_closure_failures = archive_closure_failures + 1 }
            archive_index = archive_index + 1
        }

        let parent_archive_digest = pom_archive_digest(
            &archive, current_archive_count)
        var word: i64 = 0
        while word < 8 {
            parent_archive_digest_words[epoch * 8 + word] =
                parent_archive_digest.words[word]
            word = word + 1
        }

        var phase: [i64; 225] = [0; 225]
        archive_index = 0
        while archive_index < current_archive_count {
            let witness = pom_interior_cell(archive_index)
            let left = witness / PIREUS_POM_LANES
            let right = witness - left * PIREUS_POM_LANES
            let phase_index = pom_phase_index(left, right)
            let archived_sign = archive[
                archive_index * PIREUS_POM_SIGN_CELLS + witness]
            let archived_phase = archived_sign ^ pom_cd_bit(left, right)
            phase[phase_index] = archived_phase ^ 1
            phase_checks = phase_checks + 1
            if phase[phase_index] == archived_phase {
                phase_failures = phase_failures + 1
            }
            archive_index = archive_index + 1
        }

        var anf: [i64; 225] = [0; 225]
        var left_mask: i64 = 1
        while left_mask < PIREUS_POM_LANES {
            var right_mask: i64 = 1
            while right_mask < PIREUS_POM_LANES {
                var coefficient: i64 = 0
                var left_value = left_mask
                while true {
                    var right_value = right_mask
                    while true {
                        if left_value > 0 && right_value > 0 {
                            coefficient = coefficient ^ phase[
                                pom_phase_index(left_value, right_value)]
                        }
                        if right_value == 0 { break }
                        right_value = (right_value - 1) & right_mask
                    }
                    if left_value == 0 { break }
                    left_value = (left_value - 1) & left_mask
                }
                anf[pom_phase_index(left_mask, right_mask)] = coefficient
                anf_coefficient_checks = anf_coefficient_checks + 1
                right_mask = right_mask + 1
            }
            left_mask = left_mask + 1
        }

        var left: i64 = 1
        while left < PIREUS_POM_LANES {
            var right: i64 = 1
            while right < PIREUS_POM_LANES {
                var reconstructed: i64 = 0
                var a = left
                while a > 0 {
                    var b = right
                    while b > 0 {
                        reconstructed = reconstructed ^
                            anf[pom_phase_index(a, b)]
                        b = (b - 1) & right
                    }
                    a = (a - 1) & left
                }
                anf_reconstruction_checks = anf_reconstruction_checks + 1
                if reconstructed != phase[pom_phase_index(left, right)] {
                    anf_reconstruction_failures =
                        anf_reconstruction_failures + 1
                }
                right = right + 1
            }
            left = left + 1
        }

        var candidate: [i64; 256] = [0; 256]
        var action_candidate: [i64; 256] = [0; 256]
        var negative_count: i64 = 0
        var square_count: i64 = 0
        var cell: i64 = 0
        while cell < PIREUS_POM_SIGN_CELLS {
            left = cell / PIREUS_POM_LANES
            right = cell - left * PIREUS_POM_LANES
            let phase_bit = if left == 0 || right == 0 { 0 }
                else { phase[pom_phase_index(left, right)] }
            let base_bit = pom_cd_bit(left, right)
            candidate[cell] = base_bit ^ phase_bit
            cd_sign_checks = cd_sign_checks + 1
            if candidate[cell] < 0 || candidate[cell] > 1 {
                cd_sign_failures = cd_sign_failures + 1
            }
            if candidate[cell] != 0 { negative_count = negative_count + 1 }
            if left == right && candidate[cell] != 0 {
                square_count = square_count + 1
            }
            if left == 0 || right == 0 {
                unit_checks = unit_checks + 1
                if phase_bit != 0 || candidate[cell] != base_bit ||
                    base_bit != 0 { unit_failures = unit_failures + 1 }
            }
            generated_sign_bits[epoch * PIREUS_POM_SIGN_CELLS + cell] =
                candidate[cell]
            cell = cell + 1
        }
        cell = 0
        while cell < PIREUS_POM_SIGN_CELLS {
            action_candidate[cell] = candidate[pom_action_cell(cell)]
            cell = cell + 1
        }
        var interior: i64 = 0
        while interior < PIREUS_POM_INTERIOR_CELLS {
            generated_phase_bits[epoch * PIREUS_POM_INTERIOR_CELLS + interior] =
                phase[interior]
            generated_anf_bits[epoch * PIREUS_POM_INTERIOR_CELLS + interior] =
                anf[interior]
            interior = interior + 1
        }

        var entry: i64 = 0
        while entry < PIREUS_POM_SIGN_CELLS {
            let program_destination = entry / PIREUS_POM_LANES
            let program_ordinal = entry -
                program_destination * PIREUS_POM_LANES
            let program_left = program_ordinal
            let program_right = program_left ^ program_destination
            let program_sign = candidate[
                program_left * PIREUS_POM_LANES + program_right]
            let flat_entry = epoch * PIREUS_POM_SIGN_CELLS + entry
            microprogram_destinations[flat_entry] = program_destination
            microprogram_left_inputs[flat_entry] = program_left
            microprogram_right_inputs[flat_entry] = program_right
            microprogram_ordinals[flat_entry] = program_ordinal
            microprogram_sign_bits[flat_entry] = program_sign
            microprogram_checks = microprogram_checks + 1
            if program_destination < 0 ||
                program_destination >= PIREUS_POM_LANES ||
                program_left != program_ordinal || program_right < 0 ||
                program_right >= PIREUS_POM_LANES ||
                (program_left ^ program_right) != program_destination ||
                program_sign != candidate[
                    program_left * PIREUS_POM_LANES + program_right] ||
                (entry > 0 && entry / PIREUS_POM_LANES ==
                    (entry - 1) / PIREUS_POM_LANES &&
                    program_ordinal != microprogram_ordinals[flat_entry - 1] + 1) {
                microprogram_failures = microprogram_failures + 1
            }
            entry = entry + 1
        }

        let certificate_start = certificate_count
        archive_index = 0
        while archive_index < current_archive_count {
            let witness = pom_interior_cell(archive_index)
            left = witness / PIREUS_POM_LANES
            right = witness - left * PIREUS_POM_LANES
            let generated_phase = phase[pom_phase_index(left, right)]
            let archived_phase = archive[
                archive_index * PIREUS_POM_SIGN_CELLS + witness] ^
                pom_cd_bit(left, right)
            if certificate_count >= PIREUS_POM_CERTIFICATE_CAPACITY {
                archive_capacity_failures = archive_capacity_failures + 1
            } else {
                certificate_kinds[certificate_count] = 0
                certificate_epochs[certificate_count] = epoch
                certificate_archive_indices[certificate_count] = archive_index
                certificate_partner_indices[certificate_count] = archive_index
                certificate_cells[certificate_count] = witness
                certificate_generated_bits[certificate_count] = generated_phase
                certificate_archived_bits[certificate_count] = archived_phase
                certificate_count = certificate_count + 1
            }
            certificate_checks = certificate_checks + 1
            if generated_phase == archived_phase {
                certificate_failures = certificate_failures + 1
            }
            archive_index = archive_index + 1
        }

        archive_index = 0
        while archive_index < current_archive_count {
            let partner = partners[archive_index]
            if partner < 0 {
                certificate_failures = certificate_failures + 1
            } else {
                let original_witness = pom_interior_cell(partner)
                let transported_witness = pom_action_cell(original_witness)
                let generated_sign = action_candidate[transported_witness]
                let archived_sign = archive[
                    archive_index * PIREUS_POM_SIGN_CELLS +
                        transported_witness]
                if certificate_count >= PIREUS_POM_CERTIFICATE_CAPACITY {
                    archive_capacity_failures = archive_capacity_failures + 1
                } else {
                    certificate_kinds[certificate_count] = 1
                    certificate_epochs[certificate_count] = epoch
                    certificate_archive_indices[certificate_count] = archive_index
                    certificate_partner_indices[certificate_count] = partner
                    certificate_cells[certificate_count] = transported_witness
                    certificate_generated_bits[certificate_count] = generated_sign
                    certificate_archived_bits[certificate_count] = archived_sign
                    certificate_count = certificate_count + 1
                }
                certificate_checks = certificate_checks + 1
                if generated_sign == archived_sign {
                    certificate_failures = certificate_failures + 1
                }
            }
            archive_index = archive_index + 1
        }

        archive_index = 0
        while archive_index < current_archive_count {
            direct_comparison_checks = direct_comparison_checks + 2
            if pom_archive_equals_row(&archive, archive_index, &candidate) {
                direct_collision_failures = direct_collision_failures + 1
            }
            if pom_archive_equals_row(
                    &archive, archive_index, &action_candidate) {
                direct_collision_failures = direct_collision_failures + 1
            }
            archive_index = archive_index + 1
        }

        var commutators: i64 = 0
        left = 0
        while left < PIREUS_POM_LANES {
            var right2: i64 = 0
            while right2 < PIREUS_POM_LANES {
                if candidate[left * PIREUS_POM_LANES + right2] !=
                    candidate[right2 * PIREUS_POM_LANES + left] {
                    commutators = commutators + 1
                }
                right2 = right2 + 1
            }
            left = left + 1
        }
        var associators: i64 = 0
        var i: i64 = 0
        while i < PIREUS_POM_LANES {
            var j: i64 = 0
            while j < PIREUS_POM_LANES {
                var k: i64 = 0
                while k < PIREUS_POM_LANES {
                    let defect = candidate[i * PIREUS_POM_LANES + j] ^
                        candidate[(i ^ j) * PIREUS_POM_LANES + k] ^
                        candidate[j * PIREUS_POM_LANES + k] ^
                        candidate[i * PIREUS_POM_LANES + (j ^ k)]
                    if defect != 0 { associators = associators + 1 }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }

        var probes: [i64; 16] = [0; 16]
        var destination: i64 = 0
        while destination < PIREUS_POM_LANES {
            var sum: i64 = 0
            i = 0
            while i < PIREUS_POM_LANES {
                let partner = i ^ destination
                let sign = if candidate[
                    i * PIREUS_POM_LANES + partner] == 0 { 1 } else { -1 }
                sum = sum + sign * (i + 1) *
                    (PIREUS_POM_LANES + 1 - partner)
                i = i + 1
            }
            probes[destination] = sum
            probe_outputs[epoch * PIREUS_POM_LANES + destination] = sum
            destination = destination + 1
        }

        negative_sign_counts[epoch] = negative_count
        square_negative_counts[epoch] = square_count
        commutator_defects[epoch] = commutators
        associator_defects[epoch] = associators

        let fixed = pom_rows_equal(&candidate, &action_candidate)
        let orbit_kind = if fixed { 1 } else { 2 }
        orbit_kinds[epoch] = orbit_kind
        if fixed { orbit_fixed = orbit_fixed + 1 }
        else { orbit_pairs = orbit_pairs + 1 }

        var first = candidate
        var second = action_candidate
        if pom_row_less(&action_candidate, &candidate) {
            first = action_candidate
            second = candidate
        }
        if pom_archive_find(&archive, archive_count, &first) >= 0 {
            direct_collision_failures = direct_collision_failures + 1
        } else if archive_count >= PIREUS_POM_ARCHIVE_CAPACITY {
            archive_capacity_failures = archive_capacity_failures + 1
        } else {
            cell = 0
            while cell < PIREUS_POM_SIGN_CELLS {
                archive[archive_count * PIREUS_POM_SIGN_CELLS + cell] =
                    first[cell]
                cell = cell + 1
            }
            archive_count = archive_count + 1
        }
        if !fixed {
            if pom_archive_find(&archive, archive_count, &second) >= 0 {
                direct_collision_failures = direct_collision_failures + 1
            } else if archive_count >= PIREUS_POM_ARCHIVE_CAPACITY {
                archive_capacity_failures = archive_capacity_failures + 1
            } else {
                cell = 0
                while cell < PIREUS_POM_SIGN_CELLS {
                    archive[archive_count * PIREUS_POM_SIGN_CELLS + cell] =
                        second[cell]
                    cell = cell + 1
                }
                archive_count = archive_count + 1
            }
        }
        archive_after[epoch] = archive_count

        archive_index = 0
        while archive_index < archive_count {
            archive_closure_checks = archive_closure_checks + 1
            if pom_archive_action_partner(&archive, archive_count, archive_index) < 0 {
                archive_closure_failures = archive_closure_failures + 1
            }
            archive_index = archive_index + 1
        }

        let output_archive_digest = pom_archive_digest(&archive, archive_count)
        let epoch_digest = pom_epoch_digest(
            epoch, &parent_archive_digest, &candidate, &phase, &anf,
            certificate_start, certificate_count, &certificate_kinds,
            &certificate_archive_indices, &certificate_partner_indices,
            &certificate_cells, &certificate_generated_bits,
            &certificate_archived_bits, orbit_kind, negative_count,
            square_count, commutators, associators, &probes,
            &output_archive_digest)
        word = 0
        while word < 8 {
            epoch_digest_words[epoch * 8 + word] = epoch_digest.words[word]
            word = word + 1
        }
        generated_epochs = generated_epochs + 1
        epoch = epoch + 1
    }

    let final_archive_digest = pom_archive_digest(&archive, archive_count)
    var run_state = sha256_init()
    run_state = pom_digest_add_i64(run_state, PIREUS_POM_SCHEMA)
    run_state = pom_digest_add_i64(run_state, initial_archive_count)
    run_state = pom_digest_add_i64(run_state, archive_count)
    run_state = pom_digest_add_i64(run_state, generated_epochs)
    var epoch_word: i64 = 0
    while epoch_word < generated_epochs * 8 {
        run_state = pom_digest_add_i64(
            run_state, epoch_digest_words[epoch_word])
        epoch_word = epoch_word + 1
    }
    run_state = pom_digest_add_words(run_state, &final_archive_digest.words)
    let run_digest = pom_digest_finish(run_state)

    let complete = generated_epochs == PIREUS_POM_EPOCHS &&
        orbit_fixed + orbit_pairs == generated_epochs &&
        archive_count == initial_archive_count + orbit_fixed + 2 * orbit_pairs &&
        archive_closure_failures == 0 && archive_capacity_failures == 0 &&
        cd_sign_failures == 0 && cd_axis_failures == 0 && phase_failures == 0 &&
        anf_reconstruction_failures == 0 && certificate_failures == 0 &&
        direct_collision_failures == 0 && unit_failures == 0 &&
        microprogram_failures == 0 && capacity_refusals == 0 &&
        certificate_count <= PIREUS_POM_CERTIFICATE_CAPACITY &&
        archive_count <= PIREUS_POM_ARCHIVE_CAPACITY

    PireusPomPopulation {
        initial_archive_count: initial_archive_count,
        final_archive_count: archive_count,
        generated_epochs: generated_epochs,
        orbit_fixed: orbit_fixed,
        orbit_pairs: orbit_pairs,
        archive_closure_checks: archive_closure_checks,
        archive_closure_failures: archive_closure_failures,
        archive_dedup_checks: archive_dedup_checks,
        archive_capacity_failures: archive_capacity_failures,
        cd_sign_checks: cd_sign_checks,
        cd_sign_failures: cd_sign_failures,
        cd_axis_checks: cd_axis_checks,
        cd_axis_failures: cd_axis_failures,
        phase_checks: phase_checks,
        phase_failures: phase_failures,
        anf_coefficient_checks: anf_coefficient_checks,
        anf_reconstruction_checks: anf_reconstruction_checks,
        anf_reconstruction_failures: anf_reconstruction_failures,
        certificate_count: certificate_count,
        certificate_checks: certificate_checks,
        certificate_failures: certificate_failures,
        direct_comparison_checks: direct_comparison_checks,
        direct_collision_failures: direct_collision_failures,
        unit_checks: unit_checks,
        unit_failures: unit_failures,
        microprogram_checks: microprogram_checks,
        microprogram_failures: microprogram_failures,
        capacity_refusals: capacity_refusals,
        negative_sign_counts: negative_sign_counts,
        square_negative_counts: square_negative_counts,
        commutator_defects: commutator_defects,
        associator_defects: associator_defects,
        archive_before: archive_before,
        archive_after: archive_after,
        orbit_kinds: orbit_kinds,
        generated_sign_bits: generated_sign_bits,
        generated_phase_bits: generated_phase_bits,
        generated_anf_bits: generated_anf_bits,
        microprogram_destinations: microprogram_destinations,
        microprogram_left_inputs: microprogram_left_inputs,
        microprogram_right_inputs: microprogram_right_inputs,
        microprogram_ordinals: microprogram_ordinals,
        microprogram_sign_bits: microprogram_sign_bits,
        probe_outputs: probe_outputs,
        certificate_kinds: certificate_kinds,
        certificate_epochs: certificate_epochs,
        certificate_archive_indices: certificate_archive_indices,
        certificate_partner_indices: certificate_partner_indices,
        certificate_cells: certificate_cells,
        certificate_generated_bits: certificate_generated_bits,
        certificate_archived_bits: certificate_archived_bits,
        parent_archive_digest_words: parent_archive_digest_words,
        epoch_digest_words: epoch_digest_words,
        final_archive_digest: final_archive_digest,
        run_digest: run_digest,
        complete: complete,
    }
}

fn pom_exercise_negatives() -> PireusPomNegatives with Mut {
    let canonical = pireus_operator_morphogenesis_request()
    var bad = canonical
    bad.producer_language = PIREUS_POM_LANGUAGE_PYTHON
    let python_oracle = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.producer_language = PIREUS_POM_LANGUAGE_RUST
    let rust_oracle = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.producer_language = PIREUS_POM_LANGUAGE_CPP
    bad.producer_role = PIREUS_POM_ROLE_MATERIAL_PARITY
    let cpp_authority = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.producer_language = PIREUS_POM_LANGUAGE_LLM
    bad.producer_role = PIREUS_POM_ROLE_REVIEW_ONLY
    let llm_authority = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.stage = 1
    let wrong_stage = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.policy_ready = false
    let missing_policy = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.garden_bound = false
    let missing_garden = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.contract_bound = false
    let missing_contract = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.cubic_semantics_bound = false
    let unfrozen_cubic = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.frontier_material_bound = false
    let unbound_frontier = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.declared_epochs = 15
    let wrong_epoch_budget = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.complete_archive_required = false
    let incomplete_archive = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.witness_reuse_requested = true
    let witness_reuse = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.witness_agreement_requested = true
    let witness_agreement = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.omit_action_image_requested = true
    let omitted_action_image = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.break_unit_requested = true
    let broken_unit = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.break_xor_route_requested = true
    let broken_xor_route = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.reassociate_requested = true
    let reassociated_reduction = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.expected_digest_present = true
    let injected_result = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.incomplete_comparison_requested = true
    let incomplete_comparison = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.candidate_selection_requested = true
    let selected_candidate = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.parity_process_requested = true
    let parity_prefreeze = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.review_promoted_to_authority = true
    let review_promotion = pom_request_error(&bad) != PIREUS_POM_OK
    bad = canonical
    bad.claim_ready_requested = true
    let claim_promotion = pom_request_error(&bad) != PIREUS_POM_OK

    var passed: i64 = 0
    if python_oracle { passed = passed + 1 }
    if rust_oracle { passed = passed + 1 }
    if cpp_authority { passed = passed + 1 }
    if llm_authority { passed = passed + 1 }
    if wrong_stage { passed = passed + 1 }
    if missing_policy { passed = passed + 1 }
    if missing_garden { passed = passed + 1 }
    if missing_contract { passed = passed + 1 }
    if unfrozen_cubic { passed = passed + 1 }
    if unbound_frontier { passed = passed + 1 }
    if wrong_epoch_budget { passed = passed + 1 }
    if incomplete_archive { passed = passed + 1 }
    if witness_reuse { passed = passed + 1 }
    if witness_agreement { passed = passed + 1 }
    if omitted_action_image { passed = passed + 1 }
    if broken_unit { passed = passed + 1 }
    if broken_xor_route { passed = passed + 1 }
    if reassociated_reduction { passed = passed + 1 }
    if injected_result { passed = passed + 1 }
    if incomplete_comparison { passed = passed + 1 }
    if selected_candidate { passed = passed + 1 }
    if parity_prefreeze { passed = passed + 1 }
    if review_promotion { passed = passed + 1 }
    if claim_promotion { passed = passed + 1 }

    PireusPomNegatives {
        passed: passed,
        total: PIREUS_POM_NEGATIVE_CASES,
        python_oracle: python_oracle,
        rust_oracle: rust_oracle,
        cpp_authority: cpp_authority,
        llm_authority: llm_authority,
        wrong_stage: wrong_stage,
        missing_policy: missing_policy,
        missing_garden: missing_garden,
        missing_contract: missing_contract,
        unfrozen_cubic: unfrozen_cubic,
        unbound_frontier: unbound_frontier,
        wrong_epoch_budget: wrong_epoch_budget,
        incomplete_archive: incomplete_archive,
        witness_reuse: witness_reuse,
        witness_agreement: witness_agreement,
        omitted_action_image: omitted_action_image,
        broken_unit: broken_unit,
        broken_xor_route: broken_xor_route,
        reassociated_reduction: reassociated_reduction,
        injected_result: injected_result,
        incomplete_comparison: incomplete_comparison,
        selected_candidate: selected_candidate,
        parity_prefreeze: parity_prefreeze,
        review_promotion: review_promotion,
        claim_promotion: claim_promotion,
    }
}

pub fn pireus_operator_morphogenesis_evaluate(request: &PireusPomRequest)
-> PireusPomResult with Mut, Panic, Div, Epistemic {
    let error = pom_request_error(request)
    let parent_request = pireus_cubic_forge_request()
    let parent = pireus_cubic_operator_forge_evaluate(&parent_request)
    let lineage = pom_build_lineage(&parent)
    let population = pom_build_population(&parent)
    let negatives = pom_exercise_negatives()
    var structural_failures: i64 = 0
    if error != PIREUS_POM_OK { structural_failures = structural_failures + 1 }
    if !lineage.complete { structural_failures = structural_failures + 1 }
    if !population.complete { structural_failures = structural_failures + 1 }
    if negatives.passed != negatives.total {
        structural_failures = structural_failures + 1
    }
    if !pireus_pom_digest_nonzero(&population.final_archive_digest) ||
        !pireus_pom_digest_nonzero(&population.run_digest) {
        structural_failures = structural_failures + 1
    }
    let generation_complete = structural_failures == 0 &&
        population.generated_epochs == PIREUS_POM_EPOCHS
    PireusPomResult {
        valid: generation_complete,
        error: error,
        lineage: lineage,
        population: population,
        negatives: negatives,
        structural_failures: structural_failures,
        proof_carrying_generation_complete: generation_complete,
        constructive_bounded_relative_novelty: generation_complete,
        candidate_selected: false,
        ranking_present: false,
        full_space_exhausted: false,
        full_gl_gauge_inequivalence: false,
        algebraic_novelty: false,
        algorithmic_novelty: false,
        material_novelty: false,
        performance_novelty: false,
        scientific_novelty: false,
        historical_novelty: false,
        global_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
}

fn pom_words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if left[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn pom_expected_final_archive_digest() -> [i64; 8] {
    [0x43163022, 0x51609224, 0xdd5cb651, 0x3b01fb98,
     0x2d8a9e4a, 0xd5004bd8, 0x229119f5, 0x13790a82]
}

fn pom_expected_run_digest() -> [i64; 8] {
    [0xfd07d80e, 0x500bb620, 0xf1a63ddf, 0xd0293b27,
     0xf90ed43d, 0x5b76d824, 0xb46cecd9, 0xe7c8aae6]
}

pub fn pireus_operator_morphogenesis_frozen_mismatch_code(
    result: &PireusPomResult,
) -> i64 with Mut, Panic {
    if !result.valid || result.error != PIREUS_POM_OK ||
        result.structural_failures != 0 || !result.lineage.complete ||
        !result.lineage.cubic_live_valid || !result.lineage.cubic_frozen_match {
        return 1
    }
    let population = &result.population
    if !population.complete || population.initial_archive_count != 96 ||
        population.final_archive_count != 128 ||
        population.generated_epochs != 16 || population.orbit_fixed != 0 ||
        population.orbit_pairs != 16 { return 2 }
    if population.archive_closure_checks != 3680 ||
        population.archive_closure_failures != 0 ||
        population.archive_dedup_checks != 4560 ||
        population.archive_capacity_failures != 0 ||
        population.capacity_refusals != 0 ||
        population.cd_sign_checks != 28672 ||
        population.cd_sign_failures != 0 ||
        population.cd_axis_checks != 32 || population.cd_axis_failures != 0 {
        return 3
    }
    if population.phase_checks != 1776 || population.phase_failures != 0 ||
        population.anf_coefficient_checks != 3600 ||
        population.anf_reconstruction_checks != 3600 ||
        population.anf_reconstruction_failures != 0 ||
        population.certificate_count != 3552 ||
        population.certificate_checks != 3552 ||
        population.certificate_failures != 0 ||
        population.direct_comparison_checks != 3552 ||
        population.direct_collision_failures != 0 ||
        population.unit_checks != 496 || population.unit_failures != 0 ||
        population.microprogram_checks != 4096 ||
        population.microprogram_failures != 0 { return 4 }
    var epoch: i64 = 0
    while epoch < PIREUS_POM_EPOCHS {
        if population.archive_before[epoch] != 96 + 2 * epoch ||
            population.archive_after[epoch] != 98 + 2 * epoch ||
            population.orbit_kinds[epoch] != 2 { return 5 }
        epoch = epoch + 1
    }
    let expected_archive = pom_expected_final_archive_digest()
    let expected_run = pom_expected_run_digest()
    if !pom_words_equal(
            &population.final_archive_digest.words, &expected_archive) ||
        !pom_words_equal(&population.run_digest.words, &expected_run) {
        return 6
    }
    if result.negatives.passed != 24 || result.negatives.total != 24 ||
        !result.proof_carrying_generation_complete ||
        !result.constructive_bounded_relative_novelty ||
        result.candidate_selected || result.ranking_present ||
        result.full_space_exhausted || result.full_gl_gauge_inequivalence ||
        result.algebraic_novelty || result.algorithmic_novelty ||
        result.material_novelty || result.performance_novelty ||
        result.scientific_novelty || result.historical_novelty ||
        result.global_novelty || result.priority_claim || result.claim_ready {
        return 7
    }
    0
}

pub fn pireus_operator_morphogenesis_matches_frozen_semantics(
    result: &PireusPomResult,
) -> bool with Mut, Panic {
    pireus_operator_morphogenesis_frozen_mismatch_code(result) == 0
}
