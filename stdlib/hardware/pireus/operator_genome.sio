//! Sounio semantic authority for Pireus Operator Genome v3.
//!
//! This first executable derives the selected v2 operator into a target-neutral
//! microprogram. It intentionally contains no expected v3 masks, output vector,
//! counts discovered from those masks, or digest matcher.

use algebra::cayley_dickson::cd_sigma
use hardware::pireus::operator_genesis_bilinear::{
    BilinearGenesisDigest, BilinearGenesisResult,
    pireus_operator_genesis_bilinear_request,
    pireus_operator_genesis_bilinear_evaluate,
    pireus_operator_genesis_bilinear_matches_frozen_semantics,
}
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

