fn pog_words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < 8 {
        if left[index] != right[index] { return false }
        index = index + 1
    }
    true
}

fn pog_bilinear_digest_matches(
    digest: &BilinearGenesisDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    pog_words_equal(&digest.words, expected)
}

fn pog_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn pog_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    pog_digest_add_i64(state, if value { 1 } else { 0 })
}

fn pog_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div {
    var next = state
    var index: i64 = 0
    while index < 8 {
        next = pog_digest_add_i64(next, words[index])
        index = index + 1
    }
    next
}

fn pog_digest_add_digest(
    state: SHA256State,
    digest: &PireusOperatorGenomeDigest,
) -> SHA256State with Mut, Panic, Div {
    pog_digest_add_words(state, &digest.words)
}

fn pog_digest_finish(state: SHA256State) -> PireusOperatorGenomeDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOperatorGenomeDigest { words: words }
}

pub fn pireus_operator_genome_digest_nonzero(
    digest: &PireusOperatorGenomeDigest,
) -> bool with Mut {
    var index: i64 = 0
    while index < 8 {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

pub fn pireus_operator_genome_request() -> PireusOperatorGenomeRequest {
    PireusOperatorGenomeRequest {
        producer_language: PIREUS_GENOME_LANGUAGE_SOUNIO,
        producer_role: PIREUS_GENOME_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_GENOME_STAGE_SOUNIO_EXECUTABLE,
        policy_present: true,
        parent_present: true,
        parent_semantics_frozen: true,
        parent_source_bound: true,
        parent_semantics_bound: true,
        selected_matrix_override: -1,
        exact_order_required: true,
        target_count: PIREUS_GENOME_TARGET_COUNT,
        target_ids: [
            PIREUS_GENOME_TARGET_DARWIN_XEON,
            PIREUS_GENOME_TARGET_APPLE_SILICON,
            PIREUS_GENOME_TARGET_DGX_SPARK,
            PIREUS_GENOME_TARGET_AMD_ALVEO_U250
        ],
        u250_card_count: 2,
        semantics_frozen: false,
        parity_requested: false,
        target_observation_count: 0,
        material_receipt_count: 0,
        lowering_count: 0,
        cost_record_count: 0,
        target_changes_partner: false,
        target_changes_sign: false,
        target_drops_cell: false,
        target_duplicates_cell: false,
        target_reassociates: false,
        algorithmic_novelty_requested: false,
        material_novelty_requested: false,
        scientific_novelty_requested: false,
        global_novelty_requested: false,
        historical_novelty_requested: false,
        priority_requested: false,
        claim_ready_requested: false,
        external_review_promoted: false,
        waiver_present: false,
        waiver_founder: false,
        waiver_scoped: false,
        waiver_purpose_bound: false,
        waiver_live: false,
    }
}

fn pog_request_error(request: &PireusOperatorGenomeRequest) -> i64
with Mut, Panic {
    if request.producer_language != PIREUS_GENOME_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_GENOME_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_GENOME_ERR_AUTHORITY
    }
    if request.stage != PIREUS_GENOME_STAGE_SOUNIO_EXECUTABLE ||
        request.semantics_frozen || request.parity_requested {
        return PIREUS_GENOME_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_GENOME_ERR_POLICY }
    if !request.parent_present || !request.parent_semantics_frozen ||
        !request.parent_source_bound || !request.parent_semantics_bound {
        return PIREUS_GENOME_ERR_PARENT
    }
    if request.selected_matrix_override != -1 ||
        !request.exact_order_required || request.target_changes_partner ||
        request.target_changes_sign || request.target_drops_cell ||
        request.target_duplicates_cell || request.target_reassociates {
        return PIREUS_GENOME_ERR_GENOTYPE
    }
    if request.target_count != PIREUS_GENOME_TARGET_COUNT ||
        request.target_ids[0] != PIREUS_GENOME_TARGET_DARWIN_XEON ||
        request.target_ids[1] != PIREUS_GENOME_TARGET_APPLE_SILICON ||
        request.target_ids[2] != PIREUS_GENOME_TARGET_DGX_SPARK ||
        request.target_ids[3] != PIREUS_GENOME_TARGET_AMD_ALVEO_U250 ||
        request.u250_card_count != 2 {
        return PIREUS_GENOME_ERR_TARGET
    }
    if request.target_observation_count != 0 ||
        request.material_receipt_count != 0 || request.lowering_count != 0 ||
        request.cost_record_count != 0 {
        return PIREUS_GENOME_ERR_MATERIAL
    }
    if request.algorithmic_novelty_requested ||
        request.material_novelty_requested ||
        request.scientific_novelty_requested ||
        request.global_novelty_requested ||
        request.historical_novelty_requested || request.priority_requested ||
        request.claim_ready_requested || request.external_review_promoted {
        return PIREUS_GENOME_ERR_CLAIM
    }
    if request.waiver_present && !(request.waiver_founder &&
        request.waiver_scoped && request.waiver_purpose_bound &&
        request.waiver_live) {
        return PIREUS_GENOME_ERR_WAIVER
    }
    PIREUS_GENOME_OK
}

fn pog_exercise_negatives() -> PireusOperatorGenomeNegatives
with Mut, Panic {
    let canonical = pireus_operator_genome_request()
    var bad = canonical
    bad.producer_language = PIREUS_GENOME_LANGUAGE_PYTHON
    let python_oracle = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.producer_language = PIREUS_GENOME_LANGUAGE_RUST
    let rust_oracle = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.producer_language = PIREUS_GENOME_LANGUAGE_CPP
    bad.producer_role = PIREUS_GENOME_ROLE_MATERIAL_PARITY
    let cpp_authority = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.producer_language = PIREUS_GENOME_LANGUAGE_LLM
    bad.producer_role = PIREUS_GENOME_ROLE_REVIEW_ONLY
    let llm_authority = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.parent_present = false
    let missing_parent = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.parent_semantics_frozen = false
    let unfrozen_parent = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.selected_matrix_override = PIREUS_GENOME_SELECTED_MATRIX + 1
    let matrix_override = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.parity_requested = true
    let parity_prefreeze = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.target_count = PIREUS_GENOME_TARGET_COUNT - 1
    let missing_target = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.target_observation_count = 1
    let observation_without_receipt =
        pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.target_changes_partner = true
    let changed_partner = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.target_changes_sign = true
    let changed_sign = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.target_drops_cell = true
    let dropped_cell = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.target_duplicates_cell = true
    let duplicated_cell = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.target_reassociates = true
    let reassociated_reduction = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.u250_card_count = 1
    let wrong_u250_card_count = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.algorithmic_novelty_requested = true
    let algorithmic_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.material_novelty_requested = true
    let material_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.scientific_novelty_requested = true
    let scientific_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.global_novelty_requested = true
    let global_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.historical_novelty_requested = true
    let historical_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.priority_requested = true
    let priority_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.claim_ready_requested = true
    let claim_ready_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.external_review_promoted = true
    let review_promotion = pog_request_error(&bad) != PIREUS_GENOME_OK
    bad = canonical
    bad.waiver_present = true
    let invalid_waiver = pog_request_error(&bad) != PIREUS_GENOME_OK

    var passed: i64 = 0
    if python_oracle { passed = passed + 1 }
    if rust_oracle { passed = passed + 1 }
    if cpp_authority { passed = passed + 1 }
    if llm_authority { passed = passed + 1 }
    if missing_parent { passed = passed + 1 }
    if unfrozen_parent { passed = passed + 1 }
    if matrix_override { passed = passed + 1 }
    if parity_prefreeze { passed = passed + 1 }
    if missing_target { passed = passed + 1 }
    if observation_without_receipt { passed = passed + 1 }
    if changed_partner { passed = passed + 1 }
    if changed_sign { passed = passed + 1 }
    if dropped_cell { passed = passed + 1 }
    if duplicated_cell { passed = passed + 1 }
    if reassociated_reduction { passed = passed + 1 }
    if wrong_u250_card_count { passed = passed + 1 }
    if algorithmic_promotion { passed = passed + 1 }
    if material_promotion { passed = passed + 1 }
    if scientific_promotion { passed = passed + 1 }
    if global_promotion { passed = passed + 1 }
    if historical_promotion { passed = passed + 1 }
    if priority_promotion { passed = passed + 1 }
    if claim_ready_promotion { passed = passed + 1 }
    if review_promotion { passed = passed + 1 }
    if invalid_waiver { passed = passed + 1 }

    PireusOperatorGenomeNegatives {
        python_oracle: python_oracle,
        rust_oracle: rust_oracle,
        cpp_authority: cpp_authority,
        llm_authority: llm_authority,
        missing_parent: missing_parent,
        unfrozen_parent: unfrozen_parent,
        matrix_override: matrix_override,
        parity_prefreeze: parity_prefreeze,
        missing_target: missing_target,
        observation_without_receipt: observation_without_receipt,
        changed_partner: changed_partner,
        changed_sign: changed_sign,
        dropped_cell: dropped_cell,
        duplicated_cell: duplicated_cell,
        reassociated_reduction: reassociated_reduction,
        wrong_u250_card_count: wrong_u250_card_count,
        algorithmic_promotion: algorithmic_promotion,
        material_promotion: material_promotion,
        scientific_promotion: scientific_promotion,
        global_promotion: global_promotion,
        historical_promotion: historical_promotion,
        priority_promotion: priority_promotion,
        claim_ready_promotion: claim_ready_promotion,
        review_promotion: review_promotion,
        invalid_waiver: invalid_waiver,
        passed: passed,
        total: 25,
    }
}

fn pog_bilinear_bit(matrix: i64, left: i64, right: i64) -> i64
with Mut {
    var value: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if ((left >> row) & 1) != 0 {
            var column: i64 = 0
            while column < 4 {
                if ((right >> column) & 1) != 0 &&
                    ((matrix >> (4 * row + column)) & 1) != 0 {
                    value = value ^ 1
                }
                column = column + 1
            }
        }
        row = row + 1
    }
    value
}

fn pog_sign_bit(matrix: i64, left: i64, right: i64) -> i64
with Mut, Panic, Div {
    let base = cd_sigma(left as i32, right as i32, 4)
    let phase = pog_bilinear_bit(matrix, left, right)
    (if base < 0 { 1 } else { 0 }) ^ phase
}

fn pog_build_lineage(
    parent: &BilinearGenesisResult,
) -> PireusOperatorGenomeLineage with Mut, Panic {
    let expected_selected = pog_parent_selected_hash()
    let parent_live_match =
        pireus_operator_genesis_bilinear_matches_frozen_semantics(parent)
    let parent_selected_match = parent.selected.present &&
        parent.selected.class_id == PIREUS_GENOME_SELECTED_CLASS &&
        parent.selected.quadratic_code ==
            PIREUS_GENOME_SELECTED_QUADRATIC_CODE &&
        parent.selected.bilinear_matrix == PIREUS_GENOME_SELECTED_MATRIX &&
        pog_bilinear_digest_matches(
            &parent.selected_digest, &expected_selected)
    let parent_receipt_scope_match =
        parent.receipt.relative_semantic_novelty &&
        parent.receipt.relative_grammar_extension_novelty &&
        !parent.receipt.relative_algebraic_novelty &&
        !parent.receipt.algorithmic_novelty &&
        !parent.receipt.material_novelty && !parent.receipt.global_novelty &&
        !parent.receipt.historical_novelty && !parent.receipt.priority_claim &&
        !parent.receipt.claim_ready
    PireusOperatorGenomeLineage {
        parent_source_sha256: pog_parent_source_hash(),
        parent_semantics_sha256: pog_parent_semantics_hash(),
        parent_transcript_sha256: pog_parent_transcript_hash(),
        parent_selected_sha256: expected_selected,
        parent_contract_sha256: pog_parent_contract_hash(),
        parent_freeze_sha256: pog_parent_freeze_hash(),
        cd_sigma_source_sha256: pog_cd_sigma_source_hash(),
        xor_operation_source_sha256: pog_xor_operation_source_hash(),
        xor_legality_source_sha256: pog_xor_legality_source_hash(),
        parent_live_match: parent_live_match,
        parent_selected_match: parent_selected_match,
        parent_receipt_scope_match: parent_receipt_scope_match,
        complete: parent_live_match && parent_selected_match &&
            parent_receipt_scope_match,
    }
}

fn pog_build_genotype(matrix: i64) -> PireusOperatorGenotype
with Mut, Panic, Div {
    var rows: [i64; 4] = [0; 4]
    var row: i64 = 0
    while row < 4 {
        rows[row] = (matrix >> (4 * row)) & 15
        row = row + 1
    }
    var signs: [i64; 256] = [0; 256]
    var checks: i64 = 0
    var failures: i64 = 0
    var negatives: i64 = 0
    var left: i64 = 0
    while left < 16 {
        var right: i64 = 0
        while right < 16 {
            let base = cd_sigma(left as i32, right as i32, 4)
            checks = checks + 1
            if base != -1 && base != 1 { failures = failures + 1 }
            let sign = (if base < 0 { 1 } else { 0 }) ^
                pog_bilinear_bit(matrix, left, right)
            signs[left * 16 + right] = sign
            if sign != 0 { negatives = negatives + 1 }
            right = right + 1
        }
        left = left + 1
    }
    var recount: i64 = 0
    var cell: i64 = 0
    while cell < 256 {
        if signs[cell] != 0 { recount = recount + 1 }
        cell = cell + 1
    }
    let recount_failures = if recount == negatives { 0 } else { 1 }
    PireusOperatorGenotype {
        bits: PIREUS_GENOME_BITS,
        dimension: PIREUS_GENOME_DIMENSION,
        class_id: PIREUS_GENOME_SELECTED_CLASS,
        quadratic_code: PIREUS_GENOME_SELECTED_QUADRATIC_CODE,
        packed_matrix: matrix,
        matrix_rows: rows,
        sign_bits: signs,
        base_range_checks: checks,
        base_range_failures: failures,
        negative_count: negatives,
        negative_recount: recount,
        negative_recount_failures: recount_failures,
        complete: checks == PIREUS_GENOME_CELL_COUNT && failures == 0 &&
            recount_failures == 0,
    }
}

fn pog_build_microprogram(
    genotype: &PireusOperatorGenotype,
) -> PireusOperatorMicroProgram with Mut, Panic, Div {
    var destinations: [i64; 256] = [0; 256]
    var lhs_indices: [i64; 256] = [0; 256]
    var rhs_indices: [i64; 256] = [0; 256]
    var sign_bits: [i64; 256] = [0; 256]
    var ordinals: [i64; 256] = [0; 256]
    var group_displacements: [i64; 32] = [0; 32]
    var group_source_chunks: [i64; 32] = [0; 32]
    var group_rhs_chunks: [i64; 32] = [0; 32]
    var group_negative_masks: [i64; 32] = [0; 32]
    var group_first_ordinals: [i64; 32] = [0; 32]
    var group_last_ordinals: [i64; 32] = [0; 32]
    var group_cross_chunk: [bool; 32] = [false; 32]
    var same_groups: i64 = 0
    var cross_groups: i64 = 0
    var permutation_checks: i64 = 0
    var permutation_failures: i64 = 0
    var coverage_checks: i64 = 0
    var coverage_failures: i64 = 0

    var d: i64 = 0
    while d < 16 {
        var seen: [i64; 16] = [0; 16]
        var i: i64 = 0
        while i < 16 {
            let cell = d * 16 + i
            let partner = i ^ d
            let sign = genotype.sign_bits[i * 16 + partner]
            destinations[cell] = d
            lhs_indices[cell] = i
            rhs_indices[cell] = partner
            sign_bits[cell] = sign
            ordinals[cell] = i
            seen[partner] = seen[partner] + 1
            coverage_checks = coverage_checks + 1
            if partner < 0 || partner >= 16 || sign < 0 || sign > 1 ||
                destinations[cell] != d || lhs_indices[cell] != i ||
                ordinals[cell] != i {
                coverage_failures = coverage_failures + 1
            }
            i = i + 1
        }
        i = 0
        while i < 16 {
            permutation_checks = permutation_checks + 1
            if seen[i] != 1 { permutation_failures = permutation_failures + 1 }
            i = i + 1
        }

        var chunk: i64 = 0
        while chunk < 2 {
            let group = d * 2 + chunk
            var mask: i64 = 0
            var rhs_chunk: i64 = -1
            var lane: i64 = 0
            while lane < 8 {
                let source = chunk * 8 + lane
                let cell = d * 16 + source
                let partner = rhs_indices[cell]
                if lane == 0 { rhs_chunk = partner / 8 }
                if partner / 8 != rhs_chunk {
                    coverage_failures = coverage_failures + 1
                }
                if sign_bits[cell] != 0 { mask = mask | (1 << lane) }
                lane = lane + 1
            }
            let crosses = rhs_chunk != chunk
            group_displacements[group] = d
            group_source_chunks[group] = chunk
            group_rhs_chunks[group] = rhs_chunk
            group_negative_masks[group] = mask
            group_first_ordinals[group] = chunk * 8
            group_last_ordinals[group] = chunk * 8 + 7
            group_cross_chunk[group] = crosses
            if crosses { cross_groups = cross_groups + 1 }
            else { same_groups = same_groups + 1 }
            if crosses != (d >= 8) {
                coverage_failures = coverage_failures + 1
            }
            chunk = chunk + 1
        }
        d = d + 1
    }

    PireusOperatorMicroProgram {
        cell_count: PIREUS_GENOME_CELL_COUNT,
        destinations: destinations,
        lhs_indices: lhs_indices,
        rhs_indices: rhs_indices,
        sign_bits: sign_bits,
        ordinals: ordinals,
        group_count: PIREUS_GENOME_GROUP_COUNT,
        group_displacements: group_displacements,
        group_source_chunks: group_source_chunks,
        group_rhs_chunks: group_rhs_chunks,
        group_negative_masks: group_negative_masks,
        group_first_ordinals: group_first_ordinals,
        group_last_ordinals: group_last_ordinals,
        group_cross_chunk: group_cross_chunk,
        same_chunk_groups: same_groups,
        cross_chunk_groups: cross_groups,
        partner_permutation_checks: permutation_checks,
        partner_permutation_failures: permutation_failures,
        coverage_checks: coverage_checks,
        coverage_failures: coverage_failures,
        complete: permutation_checks == PIREUS_GENOME_CELL_COUNT &&
            permutation_failures == 0 &&
            coverage_checks == PIREUS_GENOME_CELL_COUNT &&
            coverage_failures == 0 &&
            same_groups == 16 && cross_groups == 16 &&
            same_groups + cross_groups == PIREUS_GENOME_GROUP_COUNT,
    }
}

fn pog_fixture_lhs(index: i64) -> f64 { (index + 1) as f64 }

fn pog_fixture_rhs(index: i64) -> f64 {
    (((index * 3 + 2) % 17) + 1) as f64
}

fn pog_build_evaluation(
    genotype: &PireusOperatorGenotype,
    microprogram: &PireusOperatorMicroProgram,
) -> PireusOperatorGenomeEvaluation with Mut, Panic, Div {
    var lhs: [f64; 16] = [0.0; 16]
    var rhs: [f64; 16] = [0.0; 16]
    var index: i64 = 0
    while index < 16 {
        lhs[index] = pog_fixture_lhs(index)
        rhs[index] = pog_fixture_rhs(index)
        index = index + 1
    }

    var direct_bits: [i64; 16] = [0; 16]
    var micro_bits: [i64; 16] = [0; 16]
    var checks: i64 = 0
    var failures: i64 = 0
    var d: i64 = 0
    while d < 16 {
        var direct: f64 = 0.0
        var micro: f64 = 0.0
        var i: i64 = 0
        while i < 16 {
            let partner = i ^ d
            let direct_sign = pog_sign_bit(
                genotype.packed_matrix, i, partner)
            let direct_product = lhs[i] * rhs[partner]
            let direct_term = if direct_sign == 0 {
                direct_product
            } else { 0.0 - direct_product }

            let cell = d * 16 + i
            let micro_product = lhs[microprogram.lhs_indices[cell]] *
                rhs[microprogram.rhs_indices[cell]]
            let micro_term = if microprogram.sign_bits[cell] == 0 {
                micro_product
            } else { 0.0 - micro_product }

            if i == 0 {
                direct = direct_term
                micro = micro_term
            } else {
                direct = direct + direct_term
                micro = micro + micro_term
            }
            i = i + 1
        }
        direct_bits[d] = f64_to_bits(direct)
        micro_bits[d] = f64_to_bits(micro)
        checks = checks + 1
        if direct_bits[d] != micro_bits[d] { failures = failures + 1 }
        d = d + 1
    }
    PireusOperatorGenomeEvaluation {
        lhs: lhs,
        rhs: rhs,
        direct_output_bits: direct_bits,
        microprogram_output_bits: micro_bits,
        output_checks: checks,
        output_failures: failures,
        fixture_bit_exact: checks == PIREUS_GENOME_DIMENSION && failures == 0,
    }
}

fn pog_build_targets() -> PireusOperatorMaterializationEnvelope
with Mut {
    let target_ids: [i64; 4] = [
        PIREUS_GENOME_TARGET_DARWIN_XEON,
        PIREUS_GENOME_TARGET_APPLE_SILICON,
        PIREUS_GENOME_TARGET_DGX_SPARK,
        PIREUS_GENOME_TARGET_AMD_ALVEO_U250
    ]
    let canonical: [bool; 4] = [true; 4]
    let observed: [bool; 4] = [false; 4]
    let obligations: [i64; 4] = [PIREUS_GENOME_OBLIGATION_COUNT; 4]
    let zeros: [i64; 4] = [0; 4]
    let strict: [bool; 4] = [true; 4]
    var unresolved: i64 = 0
    var target: i64 = 0
    while target < 4 {
        unresolved = unresolved + obligations[target]
        target = target + 1
    }
    PireusOperatorMaterializationEnvelope {
        target_count: PIREUS_GENOME_TARGET_COUNT,
        target_ids: target_ids,
        canonical: canonical,
        observed: observed,
        obligation_counts: obligations,
        discharged_counts: zeros,
        material_receipt_counts: zeros,
        lowering_counts: zeros,
        cost_record_counts: zeros,
        strict_order_required: strict,
        u250_required_cards: 2,
        u250_declared_engine_slots: 2,
        target_profile_source_sha256: pog_target_profile_source_hash(),
        u250_admission_source_sha256: pog_u250_admission_source_hash(),
        unresolved_obligations: unresolved,
        complete: unresolved ==
            PIREUS_GENOME_TARGET_COUNT * PIREUS_GENOME_OBLIGATION_COUNT,
    }
}

fn pog_build_receipt(
    lineage: &PireusOperatorGenomeLineage,
    genotype: &PireusOperatorGenotype,
    microprogram: &PireusOperatorMicroProgram,
    evaluation: &PireusOperatorGenomeEvaluation,
    targets: &PireusOperatorMaterializationEnvelope,
) -> PireusOperatorGenomeReceipt {
    let no_material_path = targets.unresolved_obligations ==
            PIREUS_GENOME_TARGET_COUNT * PIREUS_GENOME_OBLIGATION_COUNT &&
        targets.discharged_counts[0] == 0 &&
        targets.discharged_counts[1] == 0 &&
        targets.discharged_counts[2] == 0 &&
        targets.discharged_counts[3] == 0 &&
        targets.material_receipt_counts[0] == 0 &&
        targets.material_receipt_counts[1] == 0 &&
        targets.material_receipt_counts[2] == 0 &&
        targets.material_receipt_counts[3] == 0 &&
        targets.lowering_counts[0] == 0 && targets.lowering_counts[1] == 0 &&
        targets.lowering_counts[2] == 0 && targets.lowering_counts[3] == 0 &&
        targets.cost_record_counts[0] == 0 &&
        targets.cost_record_counts[1] == 0 &&
        targets.cost_record_counts[2] == 0 &&
        targets.cost_record_counts[3] == 0
    PireusOperatorGenomeReceipt {
        schema: PIREUS_GENOME_SCHEMA,
        producer_language: PIREUS_GENOME_LANGUAGE_SOUNIO,
        producer_role: PIREUS_GENOME_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_GENOME_STAGE_SOUNIO_EXECUTABLE,
        parent_lineage_bound: lineage.complete,
        genotype_derived: genotype.complete,
        canonical_cells_complete: microprogram.complete,
        comparison_groups_complete: microprogram.group_count ==
            PIREUS_GENOME_GROUP_COUNT,
        fixture_evaluators_agree: evaluation.fixture_bit_exact,
        target_envelopes_emitted: targets.complete,
        hardware_semantics_mutation_absent: no_material_path,
        parent_receipt_relative_semantic_novelty: lineage.complete,
        executable_genome_derivation: lineage.complete && genotype.complete &&
            microprogram.complete && evaluation.fixture_bit_exact &&
            targets.complete && no_material_path,
        semantics_frozen: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        target_lowering_admitted: false,
        target_cost_admitted: false,
        target_performance_admitted: false,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
}

fn pog_digest_lineage(
    lineage: &PireusOperatorGenomeLineage,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pog_digest_add_words(state, &lineage.parent_source_sha256)
    state = pog_digest_add_words(state, &lineage.parent_semantics_sha256)
    state = pog_digest_add_words(state, &lineage.parent_transcript_sha256)
    state = pog_digest_add_words(state, &lineage.parent_selected_sha256)
    state = pog_digest_add_words(state, &lineage.parent_contract_sha256)
    state = pog_digest_add_words(state, &lineage.parent_freeze_sha256)
    state = pog_digest_add_words(state, &lineage.cd_sigma_source_sha256)
    state = pog_digest_add_words(state, &lineage.xor_operation_source_sha256)
    state = pog_digest_add_words(state, &lineage.xor_legality_source_sha256)
    state = pog_digest_add_bool(state, lineage.parent_live_match)
    state = pog_digest_add_bool(state, lineage.parent_selected_match)
    state = pog_digest_add_bool(state, lineage.parent_receipt_scope_match)
    state = pog_digest_add_bool(state, lineage.complete)
    pog_digest_finish(state)
}

fn pog_digest_genotype(
    genotype: &PireusOperatorGenotype,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pog_digest_add_i64(state, genotype.bits)
    state = pog_digest_add_i64(state, genotype.dimension)
    state = pog_digest_add_i64(state, genotype.class_id)
    state = pog_digest_add_i64(state, genotype.quadratic_code)
    state = pog_digest_add_i64(state, genotype.packed_matrix)
    var index: i64 = 0
    while index < 4 {
        state = pog_digest_add_i64(state, genotype.matrix_rows[index])
        index = index + 1
    }
    index = 0
    while index < 256 {
        state = pog_digest_add_i64(state, genotype.sign_bits[index])
        index = index + 1
    }
    state = pog_digest_add_i64(state, genotype.base_range_checks)
    state = pog_digest_add_i64(state, genotype.base_range_failures)
    state = pog_digest_add_i64(state, genotype.negative_count)
    state = pog_digest_add_i64(state, genotype.negative_recount)
    state = pog_digest_add_i64(state, genotype.negative_recount_failures)
    state = pog_digest_add_bool(state, genotype.complete)
    pog_digest_finish(state)
}

fn pog_digest_microprogram(
    micro: &PireusOperatorMicroProgram,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pog_digest_add_i64(state, micro.cell_count)
    var cell: i64 = 0
    while cell < 256 {
        state = pog_digest_add_i64(state, micro.destinations[cell])
        state = pog_digest_add_i64(state, micro.lhs_indices[cell])
        state = pog_digest_add_i64(state, micro.rhs_indices[cell])
        state = pog_digest_add_i64(state, micro.sign_bits[cell])
        state = pog_digest_add_i64(state, micro.ordinals[cell])
        cell = cell + 1
    }
    state = pog_digest_add_i64(state, micro.partner_permutation_checks)
    state = pog_digest_add_i64(state, micro.partner_permutation_failures)
    state = pog_digest_add_i64(state, micro.coverage_checks)
    state = pog_digest_add_i64(state, micro.coverage_failures)
    state = pog_digest_add_bool(state, micro.complete)
    pog_digest_finish(state)
}

fn pog_digest_groups(
    micro: &PireusOperatorMicroProgram,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pog_digest_add_i64(state, micro.group_count)
    var group: i64 = 0
    while group < 32 {
        state = pog_digest_add_i64(state, micro.group_displacements[group])
        state = pog_digest_add_i64(state, micro.group_source_chunks[group])
        state = pog_digest_add_i64(state, micro.group_rhs_chunks[group])
        state = pog_digest_add_i64(state, micro.group_negative_masks[group])
        state = pog_digest_add_i64(state, micro.group_first_ordinals[group])
        state = pog_digest_add_i64(state, micro.group_last_ordinals[group])
        state = pog_digest_add_bool(state, micro.group_cross_chunk[group])
        group = group + 1
    }
    state = pog_digest_add_i64(state, micro.same_chunk_groups)
    state = pog_digest_add_i64(state, micro.cross_chunk_groups)
    pog_digest_finish(state)
}

fn pog_digest_evaluation(
    evaluation: &PireusOperatorGenomeEvaluation,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    var index: i64 = 0
    while index < 16 {
        state = pog_digest_add_i64(state, f64_to_bits(evaluation.lhs[index]))
        state = pog_digest_add_i64(state, f64_to_bits(evaluation.rhs[index]))
        state = pog_digest_add_i64(
            state, evaluation.direct_output_bits[index])
        state = pog_digest_add_i64(
            state, evaluation.microprogram_output_bits[index])
        index = index + 1
    }
    state = pog_digest_add_i64(state, evaluation.output_checks)
    state = pog_digest_add_i64(state, evaluation.output_failures)
    state = pog_digest_add_bool(state, evaluation.fixture_bit_exact)
    pog_digest_finish(state)
}

fn pog_digest_targets(
    targets: &PireusOperatorMaterializationEnvelope,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pog_digest_add_i64(state, targets.target_count)
    var target: i64 = 0
    while target < 4 {
        state = pog_digest_add_i64(state, targets.target_ids[target])
        state = pog_digest_add_bool(state, targets.canonical[target])
        state = pog_digest_add_bool(state, targets.observed[target])
        state = pog_digest_add_i64(state, targets.obligation_counts[target])
        state = pog_digest_add_i64(state, targets.discharged_counts[target])
        state = pog_digest_add_i64(
            state, targets.material_receipt_counts[target])
        state = pog_digest_add_i64(state, targets.lowering_counts[target])
        state = pog_digest_add_i64(state, targets.cost_record_counts[target])
        state = pog_digest_add_bool(state, targets.strict_order_required[target])
        target = target + 1
    }
    state = pog_digest_add_i64(state, targets.u250_required_cards)
    state = pog_digest_add_i64(state, targets.u250_declared_engine_slots)
    state = pog_digest_add_words(
        state, &targets.target_profile_source_sha256)
    state = pog_digest_add_words(state, &targets.u250_admission_source_sha256)
    state = pog_digest_add_i64(state, targets.unresolved_obligations)
    state = pog_digest_add_bool(state, targets.complete)
    pog_digest_finish(state)
}

fn pog_digest_receipt(
    receipt: &PireusOperatorGenomeReceipt,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pog_digest_add_i64(state, receipt.schema)
    state = pog_digest_add_i64(state, receipt.producer_language)
    state = pog_digest_add_i64(state, receipt.producer_role)
    state = pog_digest_add_i64(state, receipt.stage)
    state = pog_digest_add_bool(state, receipt.parent_lineage_bound)
    state = pog_digest_add_bool(state, receipt.genotype_derived)
    state = pog_digest_add_bool(state, receipt.canonical_cells_complete)
    state = pog_digest_add_bool(state, receipt.comparison_groups_complete)
    state = pog_digest_add_bool(state, receipt.fixture_evaluators_agree)
    state = pog_digest_add_bool(state, receipt.target_envelopes_emitted)
    state = pog_digest_add_bool(
        state, receipt.hardware_semantics_mutation_absent)
    state = pog_digest_add_bool(
        state, receipt.parent_receipt_relative_semantic_novelty)
    state = pog_digest_add_bool(state, receipt.executable_genome_derivation)
    state = pog_digest_add_bool(state, receipt.semantics_frozen)
    state = pog_digest_add_bool(state, receipt.formal_parity_open)
    state = pog_digest_add_bool(state, receipt.effect_parity_open)
    state = pog_digest_add_bool(state, receipt.material_parity_open)
    state = pog_digest_add_bool(state, receipt.target_lowering_admitted)
    state = pog_digest_add_bool(state, receipt.target_cost_admitted)
    state = pog_digest_add_bool(state, receipt.target_performance_admitted)
    state = pog_digest_add_bool(state, receipt.algorithmic_novelty)
    state = pog_digest_add_bool(state, receipt.material_novelty)
    state = pog_digest_add_bool(state, receipt.scientific_novelty)
    state = pog_digest_add_bool(state, receipt.global_novelty)
    state = pog_digest_add_bool(state, receipt.historical_novelty)
    state = pog_digest_add_bool(state, receipt.priority_claim)
    state = pog_digest_add_bool(state, receipt.claim_ready)
    pog_digest_finish(state)
}

fn pog_digest_genome(
    lineage: &PireusOperatorGenomeDigest,
    genotype: &PireusOperatorGenomeDigest,
    microprogram: &PireusOperatorGenomeDigest,
    group: &PireusOperatorGenomeDigest,
    evaluation: &PireusOperatorGenomeDigest,
    targets: &PireusOperatorGenomeDigest,
    receipt: &PireusOperatorGenomeDigest,
) -> PireusOperatorGenomeDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = pog_digest_add_digest(state, lineage)
    state = pog_digest_add_digest(state, genotype)
    state = pog_digest_add_digest(state, microprogram)
    state = pog_digest_add_digest(state, group)
    state = pog_digest_add_digest(state, evaluation)
    state = pog_digest_add_digest(state, targets)
    state = pog_digest_add_digest(state, receipt)
    pog_digest_finish(state)
}

pub fn pireus_operator_genome_evaluate(
    request: &PireusOperatorGenomeRequest,
) -> PireusOperatorGenomeResult with Mut, Panic, Div, Epistemic {
    let error = pog_request_error(request)
    let parent_request = pireus_operator_genesis_bilinear_request()
    let parent = pireus_operator_genesis_bilinear_evaluate(&parent_request)
    let lineage = pog_build_lineage(&parent)
    let genotype = pog_build_genotype(parent.selected.bilinear_matrix)
    let microprogram = pog_build_microprogram(&genotype)
    let evaluation = pog_build_evaluation(&genotype, &microprogram)
    let targets = pog_build_targets()
    let receipt = pog_build_receipt(
        &lineage, &genotype, &microprogram, &evaluation, &targets)
    let negatives = pog_exercise_negatives()
    let lineage_digest = pog_digest_lineage(&lineage)
    let genotype_digest = pog_digest_genotype(&genotype)
    let microprogram_digest = pog_digest_microprogram(&microprogram)
    let group_digest = pog_digest_groups(&microprogram)
    let evaluation_digest = pog_digest_evaluation(&evaluation)
    let target_digest = pog_digest_targets(&targets)
    let receipt_digest = pog_digest_receipt(&receipt)
    let genome_digest = pog_digest_genome(
        &lineage_digest, &genotype_digest, &microprogram_digest,
        &group_digest, &evaluation_digest, &target_digest, &receipt_digest)

    var failures: i64 = 0
    if error != PIREUS_GENOME_OK { failures = failures + 1 }
    if !lineage.complete || !genotype.complete || !microprogram.complete ||
        !evaluation.fixture_bit_exact || !targets.complete {
        failures = failures + 1
    }
    if negatives.passed != negatives.total { failures = failures + 1 }
    if !receipt.parent_lineage_bound || !receipt.genotype_derived ||
        !receipt.canonical_cells_complete ||
        !receipt.comparison_groups_complete ||
        !receipt.fixture_evaluators_agree ||
        !receipt.target_envelopes_emitted ||
        !receipt.hardware_semantics_mutation_absent ||
        !receipt.parent_receipt_relative_semantic_novelty ||
        !receipt.executable_genome_derivation || receipt.semantics_frozen ||
        receipt.formal_parity_open || receipt.effect_parity_open ||
        receipt.material_parity_open || receipt.target_lowering_admitted ||
        receipt.target_cost_admitted ||
        receipt.target_performance_admitted || receipt.algorithmic_novelty ||
        receipt.material_novelty || receipt.scientific_novelty ||
        receipt.global_novelty || receipt.historical_novelty ||
        receipt.priority_claim || receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_operator_genome_digest_nonzero(&lineage_digest) ||
        !pireus_operator_genome_digest_nonzero(&genotype_digest) ||
        !pireus_operator_genome_digest_nonzero(&microprogram_digest) ||
        !pireus_operator_genome_digest_nonzero(&group_digest) ||
        !pireus_operator_genome_digest_nonzero(&evaluation_digest) ||
        !pireus_operator_genome_digest_nonzero(&target_digest) ||
        !pireus_operator_genome_digest_nonzero(&receipt_digest) ||
        !pireus_operator_genome_digest_nonzero(&genome_digest) {
        failures = failures + 1
    }

    PireusOperatorGenomeResult {
        valid: failures == 0,
        error: error,
        lineage: lineage,
        genotype: genotype,
        microprogram: microprogram,
        evaluation: evaluation,
        targets: targets,
        receipt: receipt,
        negatives: negatives,
        lineage_digest: lineage_digest,
        genotype_digest: genotype_digest,
        microprogram_digest: microprogram_digest,
        group_digest: group_digest,
        evaluation_digest: evaluation_digest,
        target_digest: target_digest,
        receipt_digest: receipt_digest,
        genome_digest: genome_digest,
        failures: failures,
    }
}

fn pog_digest_matches_frozen(
    digest: &PireusOperatorGenomeDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    pog_words_equal(&digest.words, expected)
}

/// Exact v3 result admitted only after matcher-free commit 37c7a1192c and
/// first Sounio authority transcript commit 52a60403ca existed.
pub fn pireus_operator_genome_frozen_mismatch_code(
    result: &PireusOperatorGenomeResult,
) -> i64 with Mut, Panic, Div {
    if !result.valid || result.error != PIREUS_GENOME_OK ||
        result.failures != 0 { return 1 }

    let source_hash = pog_parent_source_hash()
    let semantics_hash = pog_parent_semantics_hash()
    let transcript_hash = pog_parent_transcript_hash()
    let selected_hash = pog_parent_selected_hash()
    let contract_hash = pog_parent_contract_hash()
    let freeze_hash = pog_parent_freeze_hash()
    let cd_hash = pog_cd_sigma_source_hash()
    let operation_hash = pog_xor_operation_source_hash()
    let legality_hash = pog_xor_legality_source_hash()
    if !result.lineage.complete || !result.lineage.parent_live_match ||
        !result.lineage.parent_selected_match ||
        !result.lineage.parent_receipt_scope_match ||
        !pog_words_equal(&result.lineage.parent_source_sha256, &source_hash) ||
        !pog_words_equal(
            &result.lineage.parent_semantics_sha256, &semantics_hash) ||
        !pog_words_equal(
            &result.lineage.parent_transcript_sha256, &transcript_hash) ||
        !pog_words_equal(
            &result.lineage.parent_selected_sha256, &selected_hash) ||
        !pog_words_equal(
            &result.lineage.parent_contract_sha256, &contract_hash) ||
        !pog_words_equal(&result.lineage.parent_freeze_sha256, &freeze_hash) ||
        !pog_words_equal(&result.lineage.cd_sigma_source_sha256, &cd_hash) ||
        !pog_words_equal(
            &result.lineage.xor_operation_source_sha256, &operation_hash) ||
        !pog_words_equal(
            &result.lineage.xor_legality_source_sha256, &legality_hash) {
        return 2
    }

    if !result.genotype.complete || result.genotype.bits != 4 ||
        result.genotype.dimension != 16 || result.genotype.class_id != 26 ||
        result.genotype.quadratic_code != 198 ||
        result.genotype.packed_matrix != 1128 ||
        result.genotype.matrix_rows[0] != 8 ||
        result.genotype.matrix_rows[1] != 6 ||
        result.genotype.matrix_rows[2] != 4 ||
        result.genotype.matrix_rows[3] != 0 ||
        result.genotype.base_range_checks != 256 ||
        result.genotype.base_range_failures != 0 ||
        result.genotype.negative_count != 104 ||
        result.genotype.negative_recount != 104 ||
        result.genotype.negative_recount_failures != 0 {
        return 3
    }

    if !result.microprogram.complete || result.microprogram.cell_count != 256 ||
        result.microprogram.group_count != 32 ||
        result.microprogram.same_chunk_groups != 16 ||
        result.microprogram.cross_chunk_groups != 16 ||
        result.microprogram.partner_permutation_checks != 256 ||
        result.microprogram.partner_permutation_failures != 0 ||
        result.microprogram.coverage_checks != 256 ||
        result.microprogram.coverage_failures != 0 { return 4 }

    let masks: [i64; 32] = [
        2, 169, 148, 192, 242, 166, 148, 192,
        206, 154, 148, 192, 148, 192, 62, 106,
        168, 252, 194, 105, 162, 9, 200, 99,
        138, 33, 224, 75, 128, 43, 234, 65
    ]
    var group: i64 = 0
    while group < 32 {
        let d = group / 2
        let chunk = group - d * 2
        let rhs_chunk = if d < 8 { chunk } else { 1 - chunk }
        if result.microprogram.group_displacements[group] != d ||
            result.microprogram.group_source_chunks[group] != chunk ||
            result.microprogram.group_rhs_chunks[group] != rhs_chunk ||
            result.microprogram.group_negative_masks[group] != masks[group] ||
            result.microprogram.group_first_ordinals[group] != chunk * 8 ||
            result.microprogram.group_last_ordinals[group] != chunk * 8 + 7 ||
            result.microprogram.group_cross_chunk[group] != (d >= 8) {
            return 5
        }
        group = group + 1
    }

    var d: i64 = 0
    while d < 16 {
        var i: i64 = 0
        while i < 16 {
            let cell = d * 16 + i
            let partner = i ^ d
            let group_index = d * 2 + i / 8
            let lane = i - (i / 8) * 8
            let expected_sign =
                (masks[group_index] >> lane) & 1
            if result.microprogram.destinations[cell] != d ||
                result.microprogram.lhs_indices[cell] != i ||
                result.microprogram.rhs_indices[cell] != partner ||
                result.microprogram.sign_bits[cell] != expected_sign ||
                result.microprogram.ordinals[cell] != i ||
                result.genotype.sign_bits[i * 16 + partner] != expected_sign {
                return 6
            }
            i = i + 1
        }
        d = d + 1
    }

    let output_bits: [i64; 16] = [
        4644284339167690752, 4644565814144401408,
        -4587127326709383168, 4647099088934797312,
        4631248529308778496, 4646747245213908992,
        4642824187726004224, -4579369172663795712,
        -4575595648757268480, -4579545094524239872,
        4646219479632576512, 4642542712749293568,
        4647063904562708480, -4588112489127870464,
        4643651020470091776, 4639376119261298688
    ]
    if !result.evaluation.fixture_bit_exact ||
        result.evaluation.output_checks != 16 ||
        result.evaluation.output_failures != 0 { return 7 }
    var lane: i64 = 0
    while lane < 16 {
        if f64_to_bits(result.evaluation.lhs[lane]) !=
                f64_to_bits(pog_fixture_lhs(lane)) ||
            f64_to_bits(result.evaluation.rhs[lane]) !=
                f64_to_bits(pog_fixture_rhs(lane)) ||
            result.evaluation.direct_output_bits[lane] != output_bits[lane] ||
            result.evaluation.microprogram_output_bits[lane] !=
                output_bits[lane] { return 8 }
        lane = lane + 1
    }

    let target_profile_hash = pog_target_profile_source_hash()
    let u250_hash = pog_u250_admission_source_hash()
    let target_ids: [i64; 4] = [701200, 701201, 701202, 711001]
    if !result.targets.complete || result.targets.target_count != 4 ||
        result.targets.u250_required_cards != 2 ||
        result.targets.u250_declared_engine_slots != 2 ||
        result.targets.unresolved_obligations != 40 ||
        !pog_words_equal(
            &result.targets.target_profile_source_sha256,
            &target_profile_hash) ||
        !pog_words_equal(
            &result.targets.u250_admission_source_sha256, &u250_hash) {
        return 9
    }
    var target: i64 = 0
    while target < 4 {
        if result.targets.target_ids[target] != target_ids[target] ||
            !result.targets.canonical[target] ||
            result.targets.observed[target] ||
            result.targets.obligation_counts[target] != 10 ||
            result.targets.discharged_counts[target] != 0 ||
            result.targets.material_receipt_counts[target] != 0 ||
            result.targets.lowering_counts[target] != 0 ||
            result.targets.cost_record_counts[target] != 0 ||
            !result.targets.strict_order_required[target] { return 10 }
        target = target + 1
    }

    if result.receipt.schema != PIREUS_GENOME_SCHEMA ||
        result.receipt.producer_language != PIREUS_GENOME_LANGUAGE_SOUNIO ||
        result.receipt.producer_role !=
            PIREUS_GENOME_ROLE_SEMANTIC_AUTHORITY ||
        result.receipt.stage != PIREUS_GENOME_STAGE_SOUNIO_EXECUTABLE ||
        !result.receipt.parent_lineage_bound ||
        !result.receipt.genotype_derived ||
        !result.receipt.canonical_cells_complete ||
        !result.receipt.comparison_groups_complete ||
        !result.receipt.fixture_evaluators_agree ||
        !result.receipt.target_envelopes_emitted ||
        !result.receipt.hardware_semantics_mutation_absent ||
        !result.receipt.parent_receipt_relative_semantic_novelty ||
        !result.receipt.executable_genome_derivation ||
        result.receipt.semantics_frozen || result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open ||
        result.receipt.material_parity_open ||
        result.receipt.target_lowering_admitted ||
        result.receipt.target_cost_admitted ||
        result.receipt.target_performance_admitted ||
        result.receipt.algorithmic_novelty ||
        result.receipt.material_novelty ||
        result.receipt.scientific_novelty ||
        result.receipt.global_novelty ||
        result.receipt.historical_novelty || result.receipt.priority_claim ||
        result.receipt.claim_ready { return 11 }

    let negatives = &result.negatives
    if negatives.passed != 25 || negatives.total != 25 ||
        !negatives.python_oracle || !negatives.rust_oracle ||
        !negatives.cpp_authority || !negatives.llm_authority ||
        !negatives.missing_parent || !negatives.unfrozen_parent ||
        !negatives.matrix_override || !negatives.parity_prefreeze ||
        !negatives.missing_target ||
        !negatives.observation_without_receipt ||
        !negatives.changed_partner || !negatives.changed_sign ||
        !negatives.dropped_cell || !negatives.duplicated_cell ||
        !negatives.reassociated_reduction ||
        !negatives.wrong_u250_card_count ||
        !negatives.algorithmic_promotion || !negatives.material_promotion ||
        !negatives.scientific_promotion || !negatives.global_promotion ||
        !negatives.historical_promotion || !negatives.priority_promotion ||
        !negatives.claim_ready_promotion || !negatives.review_promotion ||
        !negatives.invalid_waiver { return 12 }

    let lineage_digest: [i64; 8] = [
        1477657856, 1761609078, 2093879568, 2391856996,
        1385895386, 1923287049, 3321140157, 1312771979
    ]
    let genotype_digest: [i64; 8] = [
        2930445485, 727096950, 2255703800, 2718701738,
        2701915375, 1690588116, 3139632451, 261017552
    ]
    let microprogram_digest: [i64; 8] = [
        3739868849, 2453095864, 278454853, 3270200325,
        169857116, 813163955, 627980311, 1485930535
    ]
    let group_digest: [i64; 8] = [
        1142592276, 3921361854, 1559546825, 4231537129,
        667777901, 1006036195, 1609908091, 1644120281
    ]
    let evaluation_digest: [i64; 8] = [
        2994867187, 3941298044, 3417186574, 1968767660,
        2663686048, 100665727, 3778687092, 1065368050
    ]
    let target_digest: [i64; 8] = [
        589852986, 1891385367, 2175989611, 3989540439,
        1674372524, 2864498863, 2936963990, 1618728370
    ]
    let receipt_digest: [i64; 8] = [
        4165106527, 504840893, 3604397070, 250762361,
        1914994530, 924979438, 2284147311, 2608861419
    ]
    let genome_digest: [i64; 8] = [
        2580931393, 1968221503, 2072126386, 2670048216,
        3630262980, 634675548, 935850740, 40274214
    ]
    if !pog_digest_matches_frozen(
            &result.lineage_digest, &lineage_digest) ||
        !pog_digest_matches_frozen(
            &result.genotype_digest, &genotype_digest) ||
        !pog_digest_matches_frozen(
            &result.microprogram_digest, &microprogram_digest) ||
        !pog_digest_matches_frozen(&result.group_digest, &group_digest) ||
        !pog_digest_matches_frozen(
            &result.evaluation_digest, &evaluation_digest) ||
        !pog_digest_matches_frozen(&result.target_digest, &target_digest) ||
        !pog_digest_matches_frozen(&result.receipt_digest, &receipt_digest) ||
        !pog_digest_matches_frozen(&result.genome_digest, &genome_digest) {
        return 13
    }
    0
}

pub fn pireus_operator_genome_matches_frozen_semantics(
    result: &PireusOperatorGenomeResult,
) -> bool with Mut, Panic, Div {
    pireus_operator_genome_frozen_mismatch_code(result) == 0
}
