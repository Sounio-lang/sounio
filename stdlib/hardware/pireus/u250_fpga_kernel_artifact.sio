pub struct PireusU250FpgaKernelArtifactRequest {
    pub producer_language: i64,
    pub producer_role: i64,
    pub engine: i64,
    pub kernel_symbol: i64,
    pub artifact_format: i64,
    pub platform: i64,
    pub target_frequency_mhz: i64,
    pub abi_argument_count: i64,
    pub input_buffer_count: i64,
    pub scalar_input_count: i64,
    pub output_buffer_count: i64,
    pub m_axi_argument_count: i64,
    pub s_axilite_argument_count: i64,
    pub checked_source_present: bool,
    pub build_recipe_present: bool,
    pub source_implies_bits: bool,
    pub build_recipe_implies_bits: bool,
    pub bitstream_present: bool,
    pub bitstream_digest_present: bool,
    pub material_receipt_present: bool,
    pub abi_parity_requested: bool,
    pub kernel_execution_observed: bool,
    pub legacy_python_golden_promoted: bool,
    pub xrt_as_isa: bool,
    pub artifact_as_operation: bool,
    pub kernel_correctness_requested: bool,
    pub operation_capability_count: i64,
    pub lowering_requested: bool,
    pub performance_present: bool,
    pub semantics_frozen: bool,
    pub parity_open_requested: bool,
    pub claim_ready_requested: bool,
}

pub struct PireusU250FpgaKernelArtifactResult {
    pub valid: bool,
    pub status: i64,
    pub schema: i64,
    pub engine: i64,
    pub kernel_symbol: i64,
    pub artifact_format: i64,
    pub platform: i64,
    pub target_frequency_mhz: i64,
    pub parent_engine_known: bool,
    pub kernel_blueprint_count: i64,
    pub abi_argument_count: i64,
    pub input_buffer_count: i64,
    pub scalar_input_count: i64,
    pub output_buffer_count: i64,
    pub m_axi_argument_count: i64,
    pub s_axilite_argument_count: i64,
    pub checked_source_present: bool,
    pub build_recipe_present: bool,
    pub bitstream_present: bool,
    pub bitstream_digest_present: bool,
    pub abi_parity_open: bool,
    pub kernel_execution_observed: bool,
    pub kernel_correctness_present: bool,
    pub operation_capability_count: i64,
    pub lowering_authorized: bool,
    pub performance_present: bool,
    pub artifact_parity_open: bool,
    pub claim_ready: bool,
    pub authority_refused: bool,
    pub abi_refused: bool,
    pub material_refused: bool,
    pub capability_refused: bool,
    pub failures: i64,
}

pub fn pireus_u250_fpga_kernel_artifact_request(
) -> PireusU250FpgaKernelArtifactRequest {
    PireusU250FpgaKernelArtifactRequest {
        producer_language: PIREUS_U250_LANGUAGE_SOUNIO,
        producer_role: PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
        engine: PIREUS_U250_ENGINE_SLOT_0,
        kernel_symbol: PIREUS_KERNEL_SYMBOL_KRNL_SAN_SCAN,
        artifact_format: PIREUS_ARTIFACT_FORMAT_XCLBIN,
        platform: PIREUS_PLATFORM_U250_XDMA_4_1_202210_1,
        target_frequency_mhz: 250,
        abi_argument_count: 8,
        input_buffer_count: 2,
        scalar_input_count: 3,
        output_buffer_count: 3,
        m_axi_argument_count: 5,
        s_axilite_argument_count: 3,
        checked_source_present: true,
        build_recipe_present: true,
        source_implies_bits: false,
        build_recipe_implies_bits: false,
        bitstream_present: false,
        bitstream_digest_present: false,
        material_receipt_present: false,
        abi_parity_requested: false,
        kernel_execution_observed: false,
        legacy_python_golden_promoted: false,
        xrt_as_isa: false,
        artifact_as_operation: false,
        kernel_correctness_requested: false,
        operation_capability_count: 0,
        lowering_requested: false,
        performance_present: false,
        semantics_frozen: false,
        parity_open_requested: false,
        claim_ready_requested: false,
    }
}

fn u250ka_authority_valid(
    request: &PireusU250FpgaKernelArtifactRequest,
) -> bool {
    request.producer_language == PIREUS_U250_LANGUAGE_SOUNIO &&
        request.producer_role == PIREUS_U250_ROLE_SEMANTIC_AUTHORITY &&
        !request.legacy_python_golden_promoted
}

fn u250ka_abi_valid(request: &PireusU250FpgaKernelArtifactRequest) -> bool {
    request.engine == PIREUS_U250_ENGINE_SLOT_0 &&
        request.kernel_symbol == PIREUS_KERNEL_SYMBOL_KRNL_SAN_SCAN &&
        request.artifact_format == PIREUS_ARTIFACT_FORMAT_XCLBIN &&
        request.platform == PIREUS_PLATFORM_U250_XDMA_4_1_202210_1 &&
        request.target_frequency_mhz == 250 &&
        request.abi_argument_count == 8 &&
        request.input_buffer_count == 2 &&
        request.scalar_input_count == 3 &&
        request.output_buffer_count == 3 &&
        request.m_axi_argument_count == 5 &&
        request.s_axilite_argument_count == 3 &&
        request.checked_source_present && request.build_recipe_present
}

fn u250ka_material_clean(
    request: &PireusU250FpgaKernelArtifactRequest,
) -> bool {
    !request.source_implies_bits && !request.build_recipe_implies_bits &&
        !request.bitstream_present && !request.bitstream_digest_present &&
        !request.material_receipt_present && !request.kernel_execution_observed
}

fn u250ka_capability_clean(
    request: &PireusU250FpgaKernelArtifactRequest,
) -> bool {
    !request.xrt_as_isa && !request.artifact_as_operation &&
        !request.kernel_correctness_requested &&
        request.operation_capability_count == 0 &&
        !request.lowering_requested && !request.performance_present
}

pub fn pireus_u250_fpga_kernel_artifact_project(
    parent: &PireusU250ExecutionEngineResult,
    request: &PireusU250FpgaKernelArtifactRequest,
) -> PireusU250FpgaKernelArtifactResult with Mut {
    let parent_valid = pireus_u250_execution_engine_matches_expected(parent)
    let authority_valid = u250ka_authority_valid(request)
    let abi_valid = u250ka_abi_valid(request)
    let material_clean = u250ka_material_clean(request)
    let capability_clean = u250ka_capability_clean(request)
    let outline_selected = request.kernel_symbol ==
        PIREUS_KERNEL_SYMBOL_KRNL_CENSUS_OUTLINE
    let parity_without_ingestor = request.parity_open_requested ||
        request.abi_parity_requested

    var failures: i64 = 0
    if !parent_valid { failures = failures + 1 }
    if !authority_valid { failures = failures + 1 }
    if !abi_valid { failures = failures + 1 }
    if !material_clean { failures = failures + 1 }
    if !capability_clean { failures = failures + 1 }
    if outline_selected { failures = failures + 1 }
    if parity_without_ingestor { failures = failures + 1 }
    if request.claim_ready_requested { failures = failures + 1 }

    var status = PIREUS_U250_KERNEL_STATUS_BLUEPRINT_ONLY
    if request.claim_ready_requested {
        status = PIREUS_U250_KERNEL_STATUS_CLAIM_REFUSED
    }
    if parity_without_ingestor {
        status = PIREUS_U250_KERNEL_STATUS_PARITY_REFUSED
    }
    if !capability_clean {
        status = PIREUS_U250_KERNEL_STATUS_CAPABILITY_REFUSED
    }
    if !material_clean {
        status = PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED
    }
    if !abi_valid {
        status = PIREUS_U250_KERNEL_STATUS_ABI_REFUSED
    }
    if outline_selected {
        status = PIREUS_U250_KERNEL_STATUS_OUTLINE_REFUSED
    }
    if !authority_valid {
        status = PIREUS_U250_KERNEL_STATUS_AUTHORITY_REFUSED
    }
    if !parent_valid {
        status = PIREUS_U250_KERNEL_STATUS_PARENT_REFUSED
    }

    PireusU250FpgaKernelArtifactResult {
        valid: failures == 0,
        status: status,
        schema: PIREUS_U250_KERNEL_ARTIFACT_SCHEMA,
        engine: request.engine,
        kernel_symbol: request.kernel_symbol,
        artifact_format: request.artifact_format,
        platform: request.platform,
        target_frequency_mhz: request.target_frequency_mhz,
        parent_engine_known: parent_valid,
        kernel_blueprint_count: if parent_valid && abi_valid { 1 } else { 0 },
        abi_argument_count: request.abi_argument_count,
        input_buffer_count: request.input_buffer_count,
        scalar_input_count: request.scalar_input_count,
        output_buffer_count: request.output_buffer_count,
        m_axi_argument_count: request.m_axi_argument_count,
        s_axilite_argument_count: request.s_axilite_argument_count,
        checked_source_present: request.checked_source_present,
        build_recipe_present: request.build_recipe_present,
        bitstream_present: request.bitstream_present,
        bitstream_digest_present: request.bitstream_digest_present,
        abi_parity_open: false,
        kernel_execution_observed: request.kernel_execution_observed,
        kernel_correctness_present: request.kernel_correctness_requested,
        operation_capability_count: request.operation_capability_count,
        lowering_authorized: false,
        performance_present: request.performance_present,
        artifact_parity_open: false,
        claim_ready: false,
        authority_refused: !authority_valid,
        abi_refused: !abi_valid,
        material_refused: !material_clean,
        capability_refused: !capability_clean,
        failures: failures,
    }
}

pub fn pireus_u250_fpga_kernel_artifact_matches_expected(
    result: &PireusU250FpgaKernelArtifactResult,
) -> bool {
    result.valid &&
        result.status == PIREUS_U250_KERNEL_STATUS_BLUEPRINT_ONLY &&
        result.schema == PIREUS_U250_KERNEL_ARTIFACT_SCHEMA &&
        result.engine == PIREUS_U250_ENGINE_SLOT_0 &&
        result.kernel_symbol == PIREUS_KERNEL_SYMBOL_KRNL_SAN_SCAN &&
        result.artifact_format == PIREUS_ARTIFACT_FORMAT_XCLBIN &&
        result.platform == PIREUS_PLATFORM_U250_XDMA_4_1_202210_1 &&
        result.target_frequency_mhz == 250 && result.parent_engine_known &&
        result.kernel_blueprint_count == 1 &&
        result.abi_argument_count == 8 &&
        result.input_buffer_count == 2 && result.scalar_input_count == 3 &&
        result.output_buffer_count == 3 && result.m_axi_argument_count == 5 &&
        result.s_axilite_argument_count == 3 &&
        result.checked_source_present && result.build_recipe_present &&
        !result.bitstream_present && !result.bitstream_digest_present &&
        !result.abi_parity_open && !result.kernel_execution_observed &&
        !result.kernel_correctness_present &&
        result.operation_capability_count == 0 &&
        !result.lowering_authorized && !result.performance_present &&
        !result.artifact_parity_open && !result.claim_ready &&
        !result.authority_refused && !result.abi_refused &&
        !result.material_refused && !result.capability_refused &&
        result.failures == 0
}

fn u250ka_add_class(store: &TripleStore, class_id: i64) {
    triple_store_add(store, triple_iri(
        class_id, PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS))
}

fn u250ka_add_typed(store: &TripleStore, subject: i64, class_id: i64) {
    triple_store_add(store, triple_iri(subject, PIREUS_RDF_TYPE, class_id))
}

fn u250ka_add_argument(
    store: &TripleStore,
    argument: i64,
    position_literal: i64,
    position: i64,
    name: i64,
    direction: i64,
    width_literal: i64,
    width: i64,
    interface: i64,
) {
    u250ka_add_typed(store, argument, PIREUS_CLASS_KERNEL_ARGUMENT)
    triple_store_add(store, triple_iri(
        PIREUS_U250_KERNEL_ABI_SAN_SCAN_V0,
        PIREUS_ABI_DECLARES_ARGUMENT, argument))
    triple_store_add(store, triple_literal(
        argument, PIREUS_ARGUMENT_POSITION, position_literal,
        position as f64))
    triple_store_add(store, triple_iri(
        argument, PIREUS_ARGUMENT_HAS_NAME, name))
    triple_store_add(store, triple_iri(
        argument, PIREUS_ARGUMENT_HAS_DIRECTION, direction))
    triple_store_add(store, triple_literal(
        argument, PIREUS_ARGUMENT_WIDTH_BITS, width_literal, width as f64))
    triple_store_add(store, triple_iri(
        argument, PIREUS_ARGUMENT_HAS_INTERFACE, interface))
}

pub fn pireus_u250_fpga_kernel_artifact_store(
    parent: &PireusU250ExecutionEngineResult,
    result: &PireusU250FpgaKernelArtifactResult,
) -> TripleStore with Mut {
    var store = pireus_u250_execution_engine_store(parent)
    if !pireus_u250_fpga_kernel_artifact_matches_expected(result) {
        return store
    }

    u250ka_add_class(&store, PIREUS_CLASS_FPGA_KERNEL_ARTIFACT)
    u250ka_add_class(&store, PIREUS_CLASS_KERNEL_ABI)
    u250ka_add_class(&store, PIREUS_CLASS_KERNEL_ARGUMENT)
    u250ka_add_class(&store, PIREUS_CLASS_ARTIFACT_FORMAT)
    u250ka_add_class(&store, PIREUS_CLASS_ARTIFACT_BLUEPRINT)
    u250ka_add_class(&store, PIREUS_CLASS_KERNEL_SYMBOL)
    u250ka_add_class(&store, PIREUS_CLASS_ARTIFACT_PLATFORM)
    u250ka_add_class(&store, PIREUS_CLASS_ARGUMENT_DIRECTION)
    u250ka_add_class(&store, PIREUS_CLASS_KERNEL_INTERFACE_BINDING)
    u250ka_add_class(&store, PIREUS_CLASS_ABI_ARGUMENT_NAME)

    u250ka_add_typed(&store, PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_CLASS_FPGA_KERNEL_ARTIFACT)
    u250ka_add_typed(&store, PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_CLASS_ARTIFACT_BLUEPRINT)
    u250ka_add_typed(&store, PIREUS_U250_KERNEL_ABI_SAN_SCAN_V0,
        PIREUS_CLASS_KERNEL_ABI)
    u250ka_add_typed(&store, PIREUS_KERNEL_SYMBOL_KRNL_SAN_SCAN,
        PIREUS_CLASS_KERNEL_SYMBOL)
    u250ka_add_typed(&store, PIREUS_ARTIFACT_FORMAT_XCLBIN,
        PIREUS_CLASS_ARTIFACT_FORMAT)
    u250ka_add_typed(&store, PIREUS_PLATFORM_U250_XDMA_4_1_202210_1,
        PIREUS_CLASS_ARTIFACT_PLATFORM)

    u250ka_add_typed(&store, PIREUS_ARGUMENT_DIRECTION_INPUT_BUFFER,
        PIREUS_CLASS_ARGUMENT_DIRECTION)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_DIRECTION_SCALAR_INPUT,
        PIREUS_CLASS_ARGUMENT_DIRECTION)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_DIRECTION_OUTPUT_BUFFER,
        PIREUS_CLASS_ARGUMENT_DIRECTION)
    u250ka_add_typed(&store, PIREUS_INTERFACE_M_AXI_GMEM0,
        PIREUS_CLASS_KERNEL_INTERFACE_BINDING)
    u250ka_add_typed(&store, PIREUS_INTERFACE_M_AXI_GMEM1,
        PIREUS_CLASS_KERNEL_INTERFACE_BINDING)
    u250ka_add_typed(&store, PIREUS_INTERFACE_S_AXILITE,
        PIREUS_CLASS_KERNEL_INTERFACE_BINDING)

    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_SAMPLES,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_LUT,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_Q_DELTA,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_N_POINTS,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_N_SAMPLES,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_HIST_OUT,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_CATASTROPHE_OUT,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)
    u250ka_add_typed(&store, PIREUS_ARGUMENT_NAME_FLOPS_OUT,
        PIREUS_CLASS_ABI_ARGUMENT_NAME)

    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_SLOT_0, PIREUS_ENGINE_DECLARES_KERNEL_ARTIFACT,
        PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN, PIREUS_ARTIFACT_HAS_ABI,
        PIREUS_U250_KERNEL_ABI_SAN_SCAN_V0))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN, PIREUS_ARTIFACT_HAS_FORMAT,
        PIREUS_ARTIFACT_FORMAT_XCLBIN))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_ARTIFACT_HAS_KERNEL_SYMBOL,
        PIREUS_KERNEL_SYMBOL_KRNL_SAN_SCAN))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_ARTIFACT_TARGETS_PLATFORM,
        PIREUS_PLATFORM_U250_XDMA_4_1_202210_1))
    triple_store_add(&store, triple_literal(
        PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_ARTIFACT_TARGET_FREQUENCY_MHZ,
        PIREUS_LITERAL_250, 250.0))
    triple_store_add(&store, triple_literal(
        PIREUS_U250_KERNEL_ABI_SAN_SCAN_V0,
        PIREUS_ABI_ARGUMENT_COUNT, PIREUS_LITERAL_8, 8.0))
    triple_store_add(&store, triple_literal(
        PIREUS_U250_KERNEL_ARTIFACT_SAN_SCAN,
        PIREUS_ARTIFACT_HAS_C_ENTRY, PIREUS_LITERAL_1, 1.0))

    u250ka_add_argument(&store, PIREUS_ARGUMENT_SAMPLES,
        PIREUS_LITERAL_0, 0, PIREUS_ARGUMENT_NAME_SAMPLES,
        PIREUS_ARGUMENT_DIRECTION_INPUT_BUFFER, PIREUS_LITERAL_512, 512,
        PIREUS_INTERFACE_M_AXI_GMEM0)
    u250ka_add_argument(&store, PIREUS_ARGUMENT_LUT,
        PIREUS_LITERAL_1, 1, PIREUS_ARGUMENT_NAME_LUT,
        PIREUS_ARGUMENT_DIRECTION_INPUT_BUFFER, PIREUS_LITERAL_64, 64,
        PIREUS_INTERFACE_M_AXI_GMEM1)
    u250ka_add_argument(&store, PIREUS_ARGUMENT_Q_DELTA,
        PIREUS_LITERAL_2, 2, PIREUS_ARGUMENT_NAME_Q_DELTA,
        PIREUS_ARGUMENT_DIRECTION_SCALAR_INPUT, PIREUS_LITERAL_15, 15,
        PIREUS_INTERFACE_S_AXILITE)
    u250ka_add_argument(&store, PIREUS_ARGUMENT_N_POINTS,
        PIREUS_LITERAL_3, 3, PIREUS_ARGUMENT_NAME_N_POINTS,
        PIREUS_ARGUMENT_DIRECTION_SCALAR_INPUT, PIREUS_LITERAL_32, 32,
        PIREUS_INTERFACE_S_AXILITE)
    u250ka_add_argument(&store, PIREUS_ARGUMENT_N_SAMPLES,
        PIREUS_LITERAL_4, 4, PIREUS_ARGUMENT_NAME_N_SAMPLES,
        PIREUS_ARGUMENT_DIRECTION_SCALAR_INPUT, PIREUS_LITERAL_32, 32,
        PIREUS_INTERFACE_S_AXILITE)
    u250ka_add_argument(&store, PIREUS_ARGUMENT_HIST_OUT,
        PIREUS_LITERAL_5, 5, PIREUS_ARGUMENT_NAME_HIST_OUT,
        PIREUS_ARGUMENT_DIRECTION_OUTPUT_BUFFER, PIREUS_LITERAL_32, 32,
        PIREUS_INTERFACE_M_AXI_GMEM1)
    u250ka_add_argument(&store, PIREUS_ARGUMENT_CATASTROPHE_OUT,
        PIREUS_LITERAL_6, 6, PIREUS_ARGUMENT_NAME_CATASTROPHE_OUT,
        PIREUS_ARGUMENT_DIRECTION_OUTPUT_BUFFER, PIREUS_LITERAL_32, 32,
        PIREUS_INTERFACE_M_AXI_GMEM1)
    u250ka_add_argument(&store, PIREUS_ARGUMENT_FLOPS_OUT,
        PIREUS_LITERAL_7, 7, PIREUS_ARGUMENT_NAME_FLOPS_OUT,
        PIREUS_ARGUMENT_DIRECTION_OUTPUT_BUFFER, PIREUS_LITERAL_64, 64,
        PIREUS_INTERFACE_M_AXI_GMEM1)
    store
}

fn u250ka_query_object(
    store: &TripleStore, subject: i64, predicate: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_iri(subject), queryterm_iri(predicate),
        queryterm_variable(0)))
    sparql_execute(store, &query)
}

pub fn pireus_u250_query_kernel_artifacts(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ka_query_object(store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_ENGINE_DECLARES_KERNEL_ARTIFACT)
}

pub fn pireus_u250_query_kernel_arguments(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ka_query_object(store, PIREUS_U250_KERNEL_ABI_SAN_SCAN_V0,
        PIREUS_ABI_DECLARES_ARGUMENT)
}

