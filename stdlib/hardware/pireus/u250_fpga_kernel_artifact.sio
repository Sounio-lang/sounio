//! Sounio-first U250 FPGA kernel-artifact ontology.
//!
//! This v0 surface freezes a kernel symbol and ordered ABI blueprint. It does
//! not admit a bitstream, an execution result, an operation, or a lowering.

use hardware::pireus::model::{
    PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS, PIREUS_HAS_OPERATION,
}
use hardware::pireus::execution_engine::{PIREUS_ENGINE_IMPLEMENTS_ISA}
use hardware::pireus::u250_dual_card_admission::{
    PIREUS_U250_LANGUAGE_SOUNIO,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
}
use hardware::pireus::u250_execution_engine::{
    PireusU250ExecutionEngineResult,
    PIREUS_U250_ENGINE_SLOT_0,
    pireus_u250_execution_engine_matches_expected,
    pireus_u250_execution_engine_store,
}
use ontology::query::{
    TripleStore, SparqlResult,
    triple_store_add, triple_iri, triple_literal,
    sparql_new, sparql_select, sparql_add_pattern, sparql_execute,
    triple_pattern_new, queryterm_variable, queryterm_iri,
}

