//! Pireus target-shaped selector plan for the frozen bits=4 XOR permutation.
//!
//! This module realizes only the abstract XOR_PERMUTE node. It does not assign
//! an ISA instruction, establish selector behavior, lower the remaining
//! operation graph, record a hardware observation, or estimate a cost.

use hardware::pireus::xor_convolution_operation::{
    PIREUS_XOR_TARGET_DARWIN_XEON,
    PIREUS_XOR_TARGET_APPLE_SILICON,
    PIREUS_XOR_TARGET_DGX,
    pireus_xor_operation_evaluate,
    pireus_xor_operation_matches_frozen_semantics,
}
use hardware::pireus::xed_import::{
    pireus_xed_load, pireus_xed_parse, pireus_xed_digest_matches,
    pireus_xed_inventory_store, pireus_xed_query_forms_by,
    PIREUS_XED_HAS_CORPUS, PIREUS_XED_HAS_ICLASS,
    PIREUS_XED_CORPUS_AVX512F_2026_08_23,
    PIREUS_XED_ICLASS_VPERMI2PD, PIREUS_XED_ICLASS_VPERMPD,
    PIREUS_XED_ICLASS_VPERMT2PD,
}
use ontology::query::sparql_result_count
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

pub const PIREUS_XOR_MATERIAL_BITS: i64 = 4
pub const PIREUS_XOR_MATERIAL_DIMENSION: i64 = 16
pub const PIREUS_XOR_MATERIAL_ELEMENT_BITS: i64 = 64
pub const PIREUS_XOR_MATERIAL_CHUNK_LANES: i64 = 8
pub const PIREUS_XOR_MATERIAL_CHUNK_COUNT: i64 = 2
pub const PIREUS_XOR_MATERIAL_CELL_COUNT: i64 = 256
pub const PIREUS_XOR_MATERIAL_GROUP_COUNT: i64 = 32

pub const PIREUS_XOR_PLAN_UNRESOLVED: i64 = 0
pub const PIREUS_XOR_PLAN_TWO_F64X8_CHUNKS: i64 = 1

pub const PIREUS_XOR_MATERIAL_OK: i64 = 0
pub const PIREUS_XOR_MATERIAL_ERR_PARENT: i64 = 1
pub const PIREUS_XOR_MATERIAL_ERR_SHAPE: i64 = 2
pub const PIREUS_XOR_MATERIAL_ERR_SELECTOR: i64 = 3
pub const PIREUS_XOR_MATERIAL_ERR_XED_EVIDENCE: i64 = 4
pub const PIREUS_XOR_MATERIAL_ERR_TARGET: i64 = 5
pub const PIREUS_XOR_MATERIAL_ERR_AUTHORITY: i64 = 6

pub struct PireusXorMaterialDigest {
    pub words: [i64; 8],
}

pub struct PireusXorSelectorTable {
    pub count: i64,
    pub displacements: [i64; 256],
    pub output_chunks: [i64; 256],
    pub output_lanes: [i64; 256],
    pub global_indices: [i64; 256],
    pub partner_indices: [i64; 256],
    pub source_chunks: [i64; 256],
    pub source_lanes: [i64; 256],
    pub reconstructed: [bool; 256],
}

pub struct PireusXorXedEvidence {
    pub frozen_content_sha256: [i64; 8],
    pub current_envelope_sha256: [i64; 8],
    pub current_receipt_sha256: [i64; 8],
    pub total_forms: i64,
    pub vpermpd_forms: i64,
    pub vpermi2pd_forms: i64,
    pub vpermt2pd_forms: i64,
    pub frozen_receipt_reference_present: bool,
    pub vendor_corpus_digest_match: bool,
    pub counts_from_digest_matched_vendor_bytes: bool,
    pub counts_match_receipt_record: bool,
    pub candidate_family_present: bool,
    pub selector_behavior_derived_from_form_presence: bool,
    pub selector_semantics_receipt_present: bool,
    pub instruction_match_authorized: bool,
    pub immediate_sufficiency_authorized: bool,
    pub two_source_necessity_authorized: bool,
    pub valid: bool,
}

pub struct PireusXorMaterialTargets {
    pub count: i64,
    pub target_ids: [i64; 3],
    pub canonical: [bool; 3],
    pub observed: [bool; 3],
    pub candidate_plans: [i64; 3],
    pub unresolved: [bool; 3],
    pub material_receipts: [bool; 3],
}

pub struct PireusXorMaterialNegatives {
    pub missing_operation_parent_hash: bool,
    pub mismatched_operation_parent_hash: bool,
    pub missing_operation_receipt: bool,
    pub mismatched_operation_receipt: bool,
    pub wrong_logical_bit_width: bool,
    pub wrong_dimension: bool,
    pub wrong_element_width: bool,
    pub wrong_chunk_width: bool,
    pub displacement_out_of_range: bool,
    pub output_chunk_out_of_range: bool,
    pub output_lane_out_of_range: bool,
    pub corrupted_source_chunk: bool,
    pub corrupted_source_lane: bool,
    pub layout_to_two_source_necessity: bool,
    pub imm8_without_vendor_semantics: bool,
    pub form_presence_to_behavior: bool,
    pub capability_to_emitted_use: bool,
    pub target_observation_without_receipt: bool,
    pub cost_without_material_receipt: bool,
    pub parity_or_claim_before_transition: bool,
    pub prohibited_oracle_language: bool,
    pub passed: i64,
    pub total: i64,
}

pub struct PireusXorMaterialResult {
    pub valid: bool,
    pub error: i64,
    pub bits: i64,
    pub dimension: i64,
    pub element_bits: i64,
    pub chunk_lanes: i64,
    pub chunk_count: i64,
    pub operation_parent_live_match: bool,
    pub operation_result_digest: [i64; 8],
    pub operation_result_digest_match: bool,
    pub operation_semantics_sha256: [i64; 8],
    pub operation_receipt_sha256: [i64; 8],
    pub operation_parent_binding_valid: bool,
    pub selector: PireusXorSelectorTable,
    pub reconstructed_cells: i64,
    pub one_source_groups: i64,
    pub layout_one_source_per_group: bool,
    pub xed: PireusXorXedEvidence,
    pub targets: PireusXorMaterialTargets,
    pub material_observation_count: i64,
    pub instruction_match_count: i64,
    pub lowering_count: i64,
    pub cost_record_count: i64,
    pub loom_guardian_external_required: bool,
    pub selector_digest: PireusXorMaterialDigest,
    pub evidence_digest: PireusXorMaterialDigest,
    pub target_digest: PireusXorMaterialDigest,
    pub witness_digest: PireusXorMaterialDigest,
    pub negatives: PireusXorMaterialNegatives,
    pub parity_open: bool,
    pub claim_ready: bool,
    pub failures: i64,
}

