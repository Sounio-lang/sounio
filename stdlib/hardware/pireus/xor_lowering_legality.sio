    pub target_digest: PireusXorLoweringDigest,
    pub witness_digest: PireusXorLoweringDigest,
    pub material_observation_count: i64,
    pub compiler_emission_count: i64,
    pub cost_record_count: i64,
    pub numerical_refinement_receipt_count: i64,
    pub parity_open: bool,
    pub claim_ready: bool,
    pub negatives: PireusXorLoweringNegatives,
    pub failures: i64,
}

