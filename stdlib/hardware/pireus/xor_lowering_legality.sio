    let value: [i64; 8] = [
        0xbc039d5d, 0xb9f195b9, 0x4fbeb08f, 0x22f9c961,
        0x64a174c2, 0xcea67573, 0x9e901a07, 0xfdf54db8
    ]
    value
}

