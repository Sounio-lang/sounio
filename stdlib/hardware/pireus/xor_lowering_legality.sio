//! Pireus target-independent lowering legality for bits=4 XorConvolution.
//!
//! The complete five-node semantic schedule is kept distinct from material
//! instruction candidates. In particular, the ascending-i f64 fold is never
//! reassociated and an Intel selector match is not whole-operation lowering.

use algebra::cayley_dickson::cd_sigma
use algebra::xor_convolution::xor_convolution_generate_inputs
use hardware::pireus::xor_convolution_operation::{
    PIREUS_XOR_NODE_XOR_PERMUTE,
    PIREUS_XOR_NODE_TWIST_APPLY,
    PIREUS_XOR_NODE_MULTIPLY,
    PIREUS_XOR_NODE_HORIZONTAL_REDUCE,
    PIREUS_XOR_NODE_OUTPUT_LANE,
    PIREUS_XOR_CAP_LANE_XOR_PERMUTE,
    PIREUS_XOR_CAP_PER_TERM_SIGN,
    PIREUS_XOR_CAP_FLOAT_MULTIPLY,
    PIREUS_XOR_CAP_FIXED_ORDER_REDUCE,
    PIREUS_XOR_CAP_OUTPUT_MATERIALIZE,
    PIREUS_XOR_ACCUMULATION_ASCENDING_I,
    PIREUS_XOR_TARGET_DARWIN_XEON,
    PIREUS_XOR_TARGET_APPLE_SILICON,
    PIREUS_XOR_TARGET_DGX,
    pireus_xor_operation_evaluate,
    pireus_xor_operation_matches_frozen_semantics,
}
use hardware::pireus::xor_material_matching::{
    pireus_xor_material_evaluate,
    pireus_xor_material_matches_frozen_semantics,
}
use hardware::pireus::intel_vpermpd_semantics::{
    PIREUS_INTEL_PDF_OK,
    pireus_intel_vpermpd_evaluate,
}
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

pub const PIREUS_XOR_LOWERING_BITS: i64 = 4
pub const PIREUS_XOR_LOWERING_DIMENSION: i64 = 16
pub const PIREUS_XOR_LOWERING_NODE_CAPACITY: i64 = 5
pub const PIREUS_XOR_LOWERING_GROUP_CAPACITY: i64 = 32

pub const PIREUS_XOR_SEMANTIC_FORM_UNRESOLVED: i64 = 0
pub const PIREUS_XOR_SEMANTIC_FORM_INDEXED_CHUNK_MAP: i64 = 1
pub const PIREUS_XOR_SEMANTIC_FORM_COEFFICIENT_SIGN_MAP: i64 = 2
pub const PIREUS_XOR_SEMANTIC_FORM_ORDERED_F64_PRODUCT: i64 = 3
pub const PIREUS_XOR_SEMANTIC_FORM_ASCENDING_I_FOLD: i64 = 4
pub const PIREUS_XOR_SEMANTIC_FORM_OUTPUT_LANE_STORE: i64 = 5

pub const PIREUS_XOR_MATERIAL_FORM_UNRESOLVED: i64 = 0
pub const PIREUS_XOR_MATERIAL_FORM_INTEL_VPERMPD_VECTOR_CONTROL: i64 = 1

pub const PIREUS_XOR_REFUSAL_NONE: i64 = 0
pub const PIREUS_XOR_REFUSAL_TARGET_OBSERVATION_MISSING: i64 = 1
pub const PIREUS_XOR_REFUSAL_MATERIAL_SEMANTICS_MISSING: i64 = 2

pub const PIREUS_XOR_LOWERING_OK: i64 = 0
pub const PIREUS_XOR_LOWERING_ERR_PARENT: i64 = 1
pub const PIREUS_XOR_LOWERING_ERR_PLAN: i64 = 2
pub const PIREUS_XOR_LOWERING_ERR_SIGN: i64 = 3
pub const PIREUS_XOR_LOWERING_ERR_EXECUTION: i64 = 4
pub const PIREUS_XOR_LOWERING_ERR_TARGET: i64 = 5
pub const PIREUS_XOR_LOWERING_ERR_AUTHORITY: i64 = 6

