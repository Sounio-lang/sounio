    [0xde23274b, 0xd1b1a88c, 0x37e539d8, 0xd39bbece,
     0xb2fec1cd, 0x95ccc8e4, 0x7abb5f78, 0xaff79b3e]
}

fn poc_v12_semantics_hash() -> [i64; 8] {
    [0x999c6e7a, 0x0051f702, 0xcf40bb2a, 0xdab7dc91,
     0xc4f02623, 0x08300963, 0x77525005, 0x067c2f4f]
}

fn poc_v5_semantics_hash() -> [i64; 8] {
