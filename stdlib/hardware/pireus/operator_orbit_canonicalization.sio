     0x02f5a1d5, 0xfacf909e, 0x39292283, 0xed65bb21]
}

fn poc_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn poc_digest_finish(state: SHA256State) -> PireusPocDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusPocDigest { words: words }
}

pub fn pireus_poc_digest_nonzero(digest: &PireusPocDigest) -> bool with Mut {
    var word: i64 = 0
    while word < 8 {
        if digest.words[word] != 0 { return true }
        word = word + 1
    }
    false
}

pub fn pireus_operator_orbit_canonicalization_request() -> PireusPocRequest {
    PireusPocRequest {
        producer_language: PIREUS_POC_LANGUAGE_SOUNIO,
        producer_role: PIREUS_POC_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_POC_STAGE_SOUNIO_EXECUTABLE,
        policy_ready: true,
        garden_bound: true,
        contract_bound: true,
        v12_source_bound: true,
        v12_semantics_bound: true,
        v12_freeze_bound: true,
        v5_source_bound: true,
        v5_semantics_bound: true,
        v5_freeze_bound: true,
        complete_parent_replay_required: true,
        declared_matrix_codes: PIREUS_POC_MATRIX_CODES,
        declared_gl4_count: PIREUS_POC_GL4_COUNT,
        declared_swap_count: PIREUS_POC_SWAP_COUNT,
        declared_gauge_bits: PIREUS_POC_GAUGE_BITS,
        declared_v12_images: PIREUS_POC_V12_IMAGES,
        declared_mutation_requests: PIREUS_POC_MUTATION_REQUESTS,
        declared_quota: PIREUS_POC_ADMISSION_QUOTA,
        incomplete_matrix_scan_requested: false,
        omit_swap_requested: false,
        broken_gauge_pivot_requested: false,
        integer_word_order_requested: false,
        early_action_stop_requested: false,
        digest_equality_requested: false,
        expected_class_count_present: false,
        expected_candidate_present: false,
        expected_witness_present: false,
        expected_digest_present: false,
        ranking_requested: false,
        parity_process_requested: false,
        semantic_write_from_parity: false,
        expected_result_write_from_parity: false,
        review_promoted_to_authority: false,
        material_result_requested: false,
        historical_claim_requested: false,
        claim_ready_requested: false,
        raw_elf_requested: false,
    }
}

fn poc_request_error(request: &PireusPocRequest) -> i64 {
    if request.producer_language != PIREUS_POC_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_POC_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_POC_ERR_AUTHORITY
    }
    if request.stage != PIREUS_POC_STAGE_SOUNIO_EXECUTABLE {
        return PIREUS_POC_ERR_STAGE
    }
    if !request.policy_ready { return PIREUS_POC_ERR_POLICY }
    if !request.garden_bound || !request.contract_bound ||
        !request.v12_source_bound || !request.v12_semantics_bound ||
        !request.v12_freeze_bound || !request.v5_source_bound ||
        !request.v5_semantics_bound || !request.v5_freeze_bound ||
        !request.complete_parent_replay_required {
        return PIREUS_POC_ERR_LINEAGE
    }
    if request.declared_matrix_codes != PIREUS_POC_MATRIX_CODES ||
        request.declared_gl4_count != PIREUS_POC_GL4_COUNT ||
        request.declared_swap_count != PIREUS_POC_SWAP_COUNT ||
        request.declared_gauge_bits != PIREUS_POC_GAUGE_BITS ||
        request.declared_v12_images != PIREUS_POC_V12_IMAGES ||
        request.declared_mutation_requests != PIREUS_POC_MUTATION_REQUESTS ||
        request.declared_quota != PIREUS_POC_ADMISSION_QUOTA ||
        request.incomplete_matrix_scan_requested || request.omit_swap_requested ||
        request.broken_gauge_pivot_requested ||
        request.integer_word_order_requested ||
        request.early_action_stop_requested || request.digest_equality_requested {
        return PIREUS_POC_ERR_UNIVERSE
    }
    if request.expected_class_count_present ||
        request.expected_candidate_present || request.expected_witness_present ||
        request.expected_digest_present {
        return PIREUS_POC_ERR_RESULT_INJECTION
    }
    if request.parity_process_requested || request.semantic_write_from_parity ||
        request.expected_result_write_from_parity ||
        request.review_promoted_to_authority {
        return PIREUS_POC_ERR_PARITY
    }
    if request.ranking_requested || request.material_result_requested ||
        request.historical_claim_requested || request.claim_ready_requested {
        return PIREUS_POC_ERR_CLAIM
    }
    if request.raw_elf_requested { return PIREUS_POC_ERR_RAW_ELF }
    PIREUS_POC_OK
}

fn poc_parity4(value: i64) -> i64 with Mut {
    var x = value
    var parity: i64 = 0
    while x != 0 {
        parity = parity ^ (x & 1)
        x = x >> 1
    }
    parity
}

fn poc_matrix_row(code: i64, row: i64) -> i64 {
    (code >> (row * 4)) & 15
}

fn poc_matrix_apply(code: i64, vector: i64) -> i64 with Mut {
    var result: i64 = 0
    var row: i64 = 0
    while row < PIREUS_POC_BITS {
        if poc_parity4(poc_matrix_row(code, row) & vector) != 0 {
            result = result | (1 << row)
        }
        row = row + 1
    }
    result
}

fn poc_matrix_invertible(code: i64) -> bool with Mut, Panic {
    var seen: [bool; 16] = [false; 16]
    var vector: i64 = 0
    while vector < PIREUS_POC_LANES {
        let image = poc_matrix_apply(code, vector)
        if seen[image] { return false }
        seen[image] = true
        vector = vector + 1
    }
    true
}

fn poc_matrix_inverse(code: i64) -> i64 with Mut {
    var inverse: i64 = 0
    var column: i64 = 0
    while column < PIREUS_POC_BITS {
        let target = 1 << column
        var preimage: i64 = 0
        while preimage < PIREUS_POC_LANES &&
            poc_matrix_apply(code, preimage) != target {
            preimage = preimage + 1
        }
        var row: i64 = 0
        while row < PIREUS_POC_BITS {
            if (preimage & (1 << row)) != 0 {
                inverse = inverse | (1 << (row * 4 + column))
            }
            row = row + 1
        }
        column = column + 1
    }
    inverse
}

fn poc_build_matrix_universe() -> PocMatrixUniverse with Mut, Panic {
    var codes: [i64; 20160] = [0; 20160]
    var count: i64 = 0
    var code: i64 = 0
    while code < PIREUS_POC_MATRIX_CODES {
        if poc_matrix_invertible(code) {
            if count < PIREUS_POC_GL4_COUNT { codes[count] = code }
            count = count + 1
        }
        code = code + 1
    }
    var inverse_checks: i64 = 0
    var inverse_failures: i64 = 0
    var index: i64 = 0
    while index < count && index < PIREUS_POC_GL4_COUNT {
        let inverse = poc_matrix_inverse(codes[index])
        var vector: i64 = 0
        while vector < PIREUS_POC_LANES {
            inverse_checks = inverse_checks + 2
            if poc_matrix_apply(inverse, poc_matrix_apply(codes[index], vector)) !=
                vector { inverse_failures = inverse_failures + 1 }
            if poc_matrix_apply(codes[index], poc_matrix_apply(inverse, vector)) !=
                vector { inverse_failures = inverse_failures + 1 }
            vector = vector + 1
        }
        index = index + 1
    }
    PocMatrixUniverse {
        codes: codes,
        scanned: PIREUS_POC_MATRIX_CODES,
        count: count,
        inverse_checks: inverse_checks,
        inverse_failures: inverse_failures,
        complete: count == PIREUS_POC_GL4_COUNT && inverse_failures == 0,
    }
}

fn poc_is_basis(value: i64) -> bool {
    value == 1 || value == 2 || value == 4 || value == 8
}

fn poc_highest_basis(value: i64) -> i64 with Mut {
    var bit: i64 = 3
    while bit > 0 {
        if (value & (1 << bit)) != 0 { return 1 << bit }
        bit = bit - 1
    }
    1
}

fn poc_gauge_index(vector: i64) -> i64 with Mut {
    var index: i64 = 0
    var value: i64 = 1
    while value < vector {
        if !poc_is_basis(value) { index = index + 1 }
        value = value + 1
    }
    index
}

fn poc_gauge_value(word: i64, vector: i64) -> i64 with Mut {
    if vector == 0 || poc_is_basis(vector) { return 0 }
    (word >> poc_gauge_index(vector)) & 1
}

fn poc_coboundary(word: i64, left: i64, right: i64) -> i64 with Mut {
    poc_gauge_value(word, left) ^ poc_gauge_value(word, right) ^
        poc_gauge_value(word, left ^ right)
}

fn poc_direct_section(table: &[i64; 256]) -> PocGaugeSection
with Mut, Panic {
    var q: [i64; 16] = [0; 16]
    var word: i64 = 0
    var vector: i64 = 1
    while vector < PIREUS_POC_LANES {
        if !poc_is_basis(vector) {
            let edge = poc_highest_basis(vector)
            let parent = vector ^ edge
            q[vector] = table[parent * PIREUS_POC_LANES + edge] ^ q[parent]
            if q[vector] != 0 {
                word = word | (1 << poc_gauge_index(vector))
            }
        }
        vector = vector + 1
    }
    PocGaugeSection { values: q, word: word }
}

fn poc_build_gauge_certificate() -> PocGaugeCertificate
with Mut, Panic, Div {
    var pivot_checks: i64 = 0
    var pivot_failures: i64 = 0
    var basis: i64 = 0
    while basis < PIREUS_POC_GAUGE_BITS {
        let word = 1 << basis
        var table: [i64; 256] = [0; 256]
        var left: i64 = 0
        while left < PIREUS_POC_LANES {
            var right: i64 = 0
            while right < PIREUS_POC_LANES {
                table[left * PIREUS_POC_LANES + right] =
                    poc_coboundary(word, left, right)
                right = right + 1
            }
            left = left + 1
        }
        let section = poc_direct_section(&table)
        var coordinate: i64 = 0
        while coordinate < PIREUS_POC_GAUGE_BITS {
            pivot_checks = pivot_checks + 1
            if ((section.word >> coordinate) & 1) !=
                (if coordinate == basis { 1 } else { 0 }) {
                pivot_failures = pivot_failures + 1
            }
            coordinate = coordinate + 1
        }
        basis = basis + 1
    }

    var roundtrip_words: i64 = 0
    var roundtrip_cell_checks: i64 = 0
    var roundtrip_failures: i64 = 0
    var word: i64 = 0
    while word < PIREUS_POC_GAUGE_WORDS {
        var table: [i64; 256] = [0; 256]
        var left: i64 = 0
        while left < PIREUS_POC_LANES {
            var right: i64 = 0
            while right < PIREUS_POC_LANES {
                table[left * PIREUS_POC_LANES + right] =
                    poc_coboundary(word, left, right)
                right = right + 1
            }
            left = left + 1
        }
        let section = poc_direct_section(&table)
        if section.word != word { roundtrip_failures = roundtrip_failures + 1 }
        left = 0
        while left < PIREUS_POC_LANES {
            var right: i64 = 0
            while right < PIREUS_POC_LANES {
                let cell = left * PIREUS_POC_LANES + right
                let normalized = table[cell] ^ section.values[left] ^
                    section.values[right] ^ section.values[left ^ right]
                roundtrip_cell_checks = roundtrip_cell_checks + 1
                if normalized != 0 { roundtrip_failures = roundtrip_failures + 1 }
                right = right + 1
            }
            left = left + 1
        }
        roundtrip_words = roundtrip_words + 1
        word = word + 1
    }
    PocGaugeCertificate {
        pivot_checks: pivot_checks,
        pivot_failures: pivot_failures,
        roundtrip_words: roundtrip_words,
        roundtrip_cell_checks: roundtrip_cell_checks,
        roundtrip_failures: roundtrip_failures,
        complete: pivot_checks == PIREUS_POC_GAUGE_BITS *
                PIREUS_POC_GAUGE_BITS && pivot_failures == 0 &&
            roundtrip_words == PIREUS_POC_GAUGE_WORDS &&
            roundtrip_cell_checks == PIREUS_POC_GAUGE_WORDS *
                PIREUS_POC_CELLS && roundtrip_failures == 0,
    }
}

fn poc_action_value(
    table: &[i64; 256], matrix: i64, swap: i64,
    left: i64, right: i64,
) -> i64 with Mut, Panic {
    let mapped_left = poc_matrix_apply(matrix, left)
    let mapped_right = poc_matrix_apply(matrix, right)
    if swap == 0 {
        table[mapped_left * PIREUS_POC_LANES + mapped_right]
    } else {
        table[mapped_right * PIREUS_POC_LANES + mapped_left]
    }
}

fn poc_action_section(
    table: &[i64; 256], matrix: i64, swap: i64,
) -> PocGaugeSection with Mut, Panic {
    var q: [i64; 16] = [0; 16]
    var word: i64 = 0
    var vector: i64 = 1
    while vector < PIREUS_POC_LANES {
        if !poc_is_basis(vector) {
            let edge = poc_highest_basis(vector)
            let parent = vector ^ edge
            q[vector] = poc_action_value(
                table, matrix, swap, parent, edge) ^ q[parent]
            if q[vector] != 0 {
                word = word | (1 << poc_gauge_index(vector))
            }
        }
        vector = vector + 1
    }
    PocGaugeSection { values: q, word: word }
}

fn poc_normalized_action_value(
    table: &[i64; 256], matrix: i64, swap: i64,
    section: &PocGaugeSection, left: i64, right: i64,
) -> i64 with Mut, Panic {
    poc_action_value(table, matrix, swap, left, right) ^
        section.values[left] ^ section.values[right] ^
        section.values[left ^ right]
}

fn poc_pack_table(table: &[i64; 256]) -> [i64; 8]
with Mut, Panic, Div {
    var words: [i64; 8] = [0; 8]
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        if table[cell] != 0 {
            let word = cell / 32
            let bit = cell - word * 32
            words[word] = words[word] | (1 << bit)
        }
        cell = cell + 1
    }
    words
}

fn poc_canonicalize(
    table: &[i64; 256], matrices: &PocMatrixUniverse,
) -> PocCanonical with Mut, Panic, Div {
    var best: [i64; 256] = [0; 256]
    var have_best = false
    var best_matrix: i64 = 0
    var best_swap: i64 = 0
    var best_gauge: i64 = 0
    var action_views: i64 = 0
    var pivot_checks: i64 = 0
    var pivot_failures: i64 = 0
    var comparisons: i64 = 0
    var replacements: i64 = 0
    var index: i64 = 0
    while index < matrices.count && index < PIREUS_POC_GL4_COUNT {
        let matrix = matrices.codes[index]
        var swap: i64 = 0
        while swap < PIREUS_POC_SWAP_COUNT {
            let section = poc_action_section(table, matrix, swap)
            action_views = action_views + 1
            var vector: i64 = 1
            while vector < PIREUS_POC_LANES {
                if !poc_is_basis(vector) {
                    let edge = poc_highest_basis(vector)
                    let parent = vector ^ edge
                    pivot_checks = pivot_checks + 1
                    if poc_normalized_action_value(
                            table, matrix, swap, &section, parent, edge) != 0 {
                        pivot_failures = pivot_failures + 1
                    }
                }
                vector = vector + 1
            }

            var smaller = !have_best
            if have_best {
                var cell: i64 = 0
                while cell < PIREUS_POC_CELLS {
                    let left = cell / PIREUS_POC_LANES
                    let right = cell - left * PIREUS_POC_LANES
                    let value = poc_normalized_action_value(
                        table, matrix, swap, &section, left, right)
                    comparisons = comparisons + 1
                    if value < best[cell] { smaller = true; break }
                    if value > best[cell] { break }
                    cell = cell + 1
                }
            }
            if smaller {
                var cell: i64 = 0
                while cell < PIREUS_POC_CELLS {
                    let left = cell / PIREUS_POC_LANES
                    let right = cell - left * PIREUS_POC_LANES
                    best[cell] = poc_normalized_action_value(
                        table, matrix, swap, &section, left, right)
                    cell = cell + 1
                }
                best_matrix = matrix
                best_swap = swap
                best_gauge = section.word
                replacements = replacements + 1
                have_best = true
            }
            swap = swap + 1
        }
        index = index + 1
    }

    let winning_section = poc_action_section(
        table, best_matrix, best_swap)
    var replay_checks: i64 = 0
    var replay_failures: i64 = 0
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        let left = cell / PIREUS_POC_LANES
        let right = cell - left * PIREUS_POC_LANES
        let value = poc_normalized_action_value(
            table, best_matrix, best_swap, &winning_section, left, right)
        replay_checks = replay_checks + 1
        if value != best[cell] { replay_failures = replay_failures + 1 }
        cell = cell + 1
    }
    let words = poc_pack_table(&best)
    PocCanonical {
        cells: best,
        words: words,
        matrix: best_matrix,
        swap: best_swap,
        gauge: best_gauge,
        action_views: action_views,
        pivot_checks: pivot_checks,
        pivot_failures: pivot_failures,
        cell_comparisons: comparisons,
        replacements: replacements,
        replay_checks: replay_checks,
        replay_failures: replay_failures,
        complete: have_best && matrices.complete &&
            action_views == PIREUS_POC_ACTIONS && pivot_failures == 0 &&
            replay_checks == PIREUS_POC_CELLS && replay_failures == 0,
    }
}

fn poc_rows_equal(left: &[i64; 256], right: &[i64; 256]) -> bool
with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        if left[cell] != right[cell] { return false }
        cell = cell + 1
    }
    true
}

fn poc_row_less(left: &[i64; 256], right: &[i64; 256]) -> bool
with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        if left[cell] < right[cell] { return true }
        if left[cell] > right[cell] { return false }
        cell = cell + 1
    }
    false
}

fn poc_archive_equals(
    archive: &[i64; 32768], index: i64, row: &[i64; 256],
) -> bool with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        if archive[index * PIREUS_POC_CELLS + cell] != row[cell] {
            return false
        }
        cell = cell + 1
    }
    true
}

fn poc_archive_find(
    archive: &[i64; 32768], count: i64, row: &[i64; 256],
) -> i64 with Mut, Panic {
    var index: i64 = 0
    while index < count {
        if poc_archive_equals(archive, index, row) { return index }
        index = index + 1
    }
    -1
}

fn poc_archive_append(
    archive: &![i64; 32768], count: i64, row: &[i64; 256],
) -> i64 with Mut, Panic {
    if poc_archive_find(archive, count, row) >= 0 { return count }
    if count >= PIREUS_POC_V12_IMAGES { return count }
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        archive[count * PIREUS_POC_CELLS + cell] = row[cell]
        cell = cell + 1
    }
    count + 1
}

fn poc_v12_action_lane(value: i64) -> i64 {
    (value & 12) | ((value & 1) << 1) | ((value >> 1) & 1)
}

fn poc_v12_action_cell(cell: i64) -> i64 with Div {
    let left = cell / PIREUS_POC_LANES
    let right = cell - left * PIREUS_POC_LANES
    poc_v12_action_lane(left) * PIREUS_POC_LANES +
        poc_v12_action_lane(right)
}

fn poc_v12_archive_digest(
    archive: &[i64; 32768], count: i64,
) -> PireusPocDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = poc_digest_add_i64(state, 732000)
    state = poc_digest_add_i64(state, count)
    var index: i64 = 0
    while index < count {
        var cell: i64 = 0
        while cell < PIREUS_POC_CELLS {
            state = poc_digest_add_i64(
                state, archive[index * PIREUS_POC_CELLS + cell])
            cell = cell + 1
        }
        index = index + 1
    }
    poc_digest_finish(state)
}

fn poc_digest_equal(left: &PireusPocDigest, right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if left.words[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn poc_class_find(
    classes: &[i64; 1280], count: i64, words: &[i64; 8],
) -> i64 with Mut, Panic {
    var class_id: i64 = 0
    while class_id < count {
        var equal = true
        var word: i64 = 0
        while word < PIREUS_POC_CLASS_WORDS {
            if classes[class_id * PIREUS_POC_CLASS_WORDS + word] !=
                words[word] { equal = false }
            word = word + 1
        }
        if equal { return class_id }
        class_id = class_id + 1
    }
    -1
}

fn poc_class_append(
    classes: &![i64; 1280], count: i64, words: &[i64; 8],
) -> i64 with Mut, Panic {
    if count >= PIREUS_POC_CLASS_CAPACITY { return count }
    var word: i64 = 0
    while word < PIREUS_POC_CLASS_WORDS {
        classes[count * PIREUS_POC_CLASS_WORDS + word] = words[word]
        word = word + 1
    }
    count + 1
}

fn poc_class_bit(
    classes: &[i64; 1280], class_id: i64, cell: i64,
) -> i64 with Panic, Div {
    let word = cell / 32
    let bit = cell - word * 32
    (classes[class_id * PIREUS_POC_CLASS_WORDS + word] >> bit) & 1
}

fn poc_phase_index(left: i64, right: i64) -> i64 {
    (left - 1) * 15 + (right - 1)
}

fn poc_cd_bit(left: i64, right: i64) -> i64 with Mut, Panic, Div {
    if cd_sigma(left as i32, right as i32, PIREUS_POC_BITS as i32) < 0 {
        1
    } else { 0 }
}

fn poc_anf_to_phase(anf: &[i64; 225]) -> [i64; 225]
with Mut, Panic {
    var phase: [i64; 225] = [0; 225]
    var left: i64 = 1
    while left < PIREUS_POC_LANES {
        var right: i64 = 1
        while right < PIREUS_POC_LANES {
            var value: i64 = 0
            var a = left
            while a > 0 {
                var b = right
                while b > 0 {
                    value = value ^ anf[poc_phase_index(a, b)]
                    b = (b - 1) & right
                }
                a = (a - 1) & left
            }
            phase[poc_phase_index(left, right)] = value
            right = right + 1
        }
        left = left + 1
    }
    phase
}

fn poc_phase_to_anf(phase: &[i64; 225]) -> [i64; 225]
with Mut, Panic {
    var anf: [i64; 225] = [0; 225]
    var left_mask: i64 = 1
    while left_mask < PIREUS_POC_LANES {
        var right_mask: i64 = 1
        while right_mask < PIREUS_POC_LANES {
            var coefficient: i64 = 0
            var left_value = left_mask
            while true {
                var right_value = right_mask
                while true {
                    if left_value > 0 && right_value > 0 {
                        coefficient = coefficient ^
                            phase[poc_phase_index(left_value, right_value)]
                    }
                    if right_value == 0 { break }
                    right_value = (right_value - 1) & right_mask
                }
                if left_value == 0 { break }
                left_value = (left_value - 1) & left_mask
            }
            anf[poc_phase_index(left_mask, right_mask)] = coefficient
            right_mask = right_mask + 1
        }
        left_mask = left_mask + 1
    }
    anf
}

fn poc_build_signs(phase: &[i64; 225]) -> [i64; 256]
with Mut, Panic, Div {
    var signs: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        let left = cell / PIREUS_POC_LANES
        let right = cell - left * PIREUS_POC_LANES
        let phase_bit = if left == 0 || right == 0 { 0 }
            else { phase[poc_phase_index(left, right)] }
        signs[cell] = poc_cd_bit(left, right) ^ phase_bit
        cell = cell + 1
    }
    signs
}

fn poc_build_microprogram(signs: &[i64; 256]) -> PocMicroprogram
with Mut, Panic {
    var left_inputs: [i64; 256] = [0; 256]
    var right_inputs: [i64; 256] = [0; 256]
    var destinations: [i64; 256] = [0; 256]
    var ordinals: [i64; 256] = [0; 256]
    var sign_bits: [i64; 256] = [0; 256]
    var destination: i64 = 0
    while destination < PIREUS_POC_LANES {
        var ordinal: i64 = 0
        while ordinal < PIREUS_POC_LANES {
            let entry = destination * PIREUS_POC_LANES + ordinal
            let partner = ordinal ^ destination
            left_inputs[entry] = ordinal
            right_inputs[entry] = partner
            destinations[entry] = destination
            ordinals[entry] = ordinal
            sign_bits[entry] = signs[
                ordinal * PIREUS_POC_LANES + partner]
            ordinal = ordinal + 1
        }
        destination = destination + 1
    }
    PocMicroprogram {
        left_inputs: left_inputs,
        right_inputs: right_inputs,
        destinations: destinations,
        ordinals: ordinals,
        sign_bits: sign_bits,
    }
}

fn poc_signs_to_phase(signs: &[i64; 256]) -> [i64; 225]
with Mut, Panic, Div {
    var phase: [i64; 225] = [0; 225]
    var left: i64 = 1
    while left < PIREUS_POC_LANES {
        var right: i64 = 1
        while right < PIREUS_POC_LANES {
            phase[poc_phase_index(left, right)] =
                signs[left * PIREUS_POC_LANES + right] ^
                poc_cd_bit(left, right)
            right = right + 1
        }
        left = left + 1
    }
    phase
}

fn poc_digest_raw(
    parent_epoch: i64, coefficient: i64,
    raw_phase: &[i64; 225], raw_anf: &[i64; 225],
    raw_signs: &[i64; 256],
) -> PireusPocDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = poc_digest_add_i64(state, PIREUS_POC_SCHEMA)
    state = poc_digest_add_i64(state, 733101)
    state = poc_digest_add_i64(state, parent_epoch)
    state = poc_digest_add_i64(state, coefficient)
    var index: i64 = 0
    while index < PIREUS_POC_INTERIOR {
        state = poc_digest_add_i64(state, raw_phase[index])
        state = poc_digest_add_i64(state, raw_anf[index])
        index = index + 1
    }
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        state = poc_digest_add_i64(state, raw_signs[cell])
        cell = cell + 1
    }
    poc_digest_finish(state)
}

fn poc_digest_canonical(
    canonical: &PocCanonical, canonical_phase: &[i64; 225],
    canonical_anf: &[i64; 225],
) -> PireusPocDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = poc_digest_add_i64(state, PIREUS_POC_SCHEMA)
    state = poc_digest_add_i64(state, 733102)
    state = poc_digest_add_i64(state, canonical.matrix)
    state = poc_digest_add_i64(state, canonical.swap)
    state = poc_digest_add_i64(state, canonical.gauge)
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        state = poc_digest_add_i64(state, canonical.cells[cell])
        cell = cell + 1
    }
    var index: i64 = 0
    while index < PIREUS_POC_INTERIOR {
        state = poc_digest_add_i64(state, canonical_phase[index])
        state = poc_digest_add_i64(state, canonical_anf[index])
        index = index + 1
    }
    poc_digest_finish(state)
}

fn poc_digest_certificate(
    canonical: &PocCanonical, separators: &PireusPocDigest,
) -> PireusPocDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = poc_digest_add_i64(state, PIREUS_POC_SCHEMA)
    state = poc_digest_add_i64(state, 733103)
    state = poc_digest_add_i64(state, canonical.matrix)
    state = poc_digest_add_i64(state, canonical.swap)
    state = poc_digest_add_i64(state, canonical.gauge)
    state = poc_digest_add_i64(state, canonical.action_views)
    state = poc_digest_add_i64(state, canonical.pivot_checks)
    state = poc_digest_add_i64(state, canonical.pivot_failures)
    state = poc_digest_add_i64(state, canonical.cell_comparisons)
    state = poc_digest_add_i64(state, canonical.replacements)
    state = poc_digest_add_i64(state, canonical.replay_checks)
    state = poc_digest_add_i64(state, canonical.replay_failures)
    var word: i64 = 0
    while word < 8 {
        state = poc_digest_add_i64(state, separators.words[word])
        word = word + 1
    }
    poc_digest_finish(state)
}

fn poc_digest_epoch(
    parent_epoch: i64, coefficient: i64,
    raw_digest: &PireusPocDigest,
    canonical_digest: &PireusPocDigest,
    certificate_digest: &PireusPocDigest,
    negatives: i64, squares: i64,
    ordered_commutator_defects: i64, associators: i64,
    probes: &[i64; 16],
) -> PireusPocDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = poc_digest_add_i64(state, PIREUS_POC_SCHEMA)
    state = poc_digest_add_i64(state, 733104)
    state = poc_digest_add_i64(state, parent_epoch)
    state = poc_digest_add_i64(state, coefficient)
    state = poc_digest_add_i64(state, negatives)
    state = poc_digest_add_i64(state, squares)
    state = poc_digest_add_i64(state, ordered_commutator_defects)
    state = poc_digest_add_i64(state, associators)
    var word: i64 = 0
    while word < 8 {
        state = poc_digest_add_i64(state, raw_digest.words[word])
        state = poc_digest_add_i64(state, canonical_digest.words[word])
        state = poc_digest_add_i64(state, certificate_digest.words[word])
        word = word + 1
    }
    var lane: i64 = 0
    while lane < PIREUS_POC_LANES {
        state = poc_digest_add_i64(state, probes[lane])
        lane = lane + 1
    }
    poc_digest_finish(state)
}

fn poc_digest_classes(
    classes: &[i64; 1280], count: i64,
) -> PireusPocDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = poc_digest_add_i64(state, PIREUS_POC_SCHEMA)
    state = poc_digest_add_i64(state, count)
    var index: i64 = 0
    while index < count * PIREUS_POC_CLASS_WORDS {
        state = poc_digest_add_i64(state, classes[index])
        index = index + 1
    }
    poc_digest_finish(state)
}

fn poc_emit_bits(
    admitted: i64, canonical_kind: bool, bits: &[i64; 256],
) with IO, Mut, Panic {
    if canonical_kind { print("PIREUS_POC_CANON_BITS admitted=") }
    else { print("PIREUS_POC_RAW_BITS admitted=") }
    print_int(admitted)
    print(" bits=")
    var cell: i64 = 0
    while cell < PIREUS_POC_CELLS {
        if cell > 0 { print(":") }
        print_int(bits[cell])
        cell = cell + 1
    }
    print("\n")
}

fn poc_emit_phase(
    admitted: i64, canonical_kind: bool, phase: &[i64; 225],
) with IO, Mut, Panic {
    if canonical_kind { print("PIREUS_POC_CANON_PHASE admitted=") }
    else { print("PIREUS_POC_RAW_PHASE admitted=") }
    print_int(admitted)
    print(" bits=")
    var index: i64 = 0
    while index < PIREUS_POC_INTERIOR {
        if index > 0 { print(":") }
        print_int(phase[index])
        index = index + 1
    }
    print("\n")
}

fn poc_emit_anf(
    admitted: i64, canonical_kind: bool, anf: &[i64; 225],
) with IO, Mut, Panic {
    if canonical_kind { print("PIREUS_POC_CANON_ANF admitted=") }
    else { print("PIREUS_POC_RAW_ANF admitted=") }
    print_int(admitted)
    print(" bits=")
    var index: i64 = 0
    while index < PIREUS_POC_INTERIOR {
        if index > 0 { print(":") }
        print_int(anf[index])
        index = index + 1
    }
    print("\n")
}

fn poc_emit_microprogram(
    admitted: i64, canonical_kind: bool, program: &PocMicroprogram,
) with IO, Mut, Panic {
    if canonical_kind { print("PIREUS_POC_CANON_MICROPROGRAM admitted=") }
    else { print("PIREUS_POC_RAW_MICROPROGRAM admitted=") }
    print_int(admitted)
    print(" entries=")
    var destination: i64 = 0
    while destination < PIREUS_POC_LANES {
        var left: i64 = 0
        while left < PIREUS_POC_LANES {
            let entry = destination * PIREUS_POC_LANES + left
            if destination > 0 || left > 0 { print(";") }
            print_int(program.destinations[entry]); print(":")
            print_int(program.left_inputs[entry]); print(":")
            print_int(program.right_inputs[entry]); print(":")
            print_int(program.ordinals[entry]); print(":")
            print_int(if program.sign_bits[entry] == 0 {
                1
            } else { -1 })
            left = left + 1
        }
        destination = destination + 1
    }
    print("\n")
}

fn poc_emit_digest(digest: &PireusPocDigest) with IO, Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
}

fn poc_negative_count() -> i64 with Mut {
    let canonical = pireus_operator_orbit_canonicalization_request()
    var bad = canonical
    var passed: i64 = 0
    bad.producer_language = PIREUS_POC_LANGUAGE_PYTHON
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.producer_language = PIREUS_POC_LANGUAGE_RUST
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.producer_language = PIREUS_POC_LANGUAGE_CPP
    bad.producer_role = PIREUS_POC_ROLE_MATERIAL_PARITY
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.producer_language = PIREUS_POC_LANGUAGE_LLM
    bad.producer_role = PIREUS_POC_ROLE_REVIEW_ONLY
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.stage = 1
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.policy_ready = false
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.garden_bound = false
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.v12_semantics_bound = false
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.v5_semantics_bound = false
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.incomplete_matrix_scan_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.omit_swap_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.broken_gauge_pivot_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.integer_word_order_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.early_action_stop_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.digest_equality_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.expected_class_count_present = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.expected_candidate_present = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.ranking_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.parity_process_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.semantic_write_from_parity = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.review_promoted_to_authority = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.material_result_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.claim_ready_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    bad = canonical; bad.raw_elf_requested = true
    if poc_request_error(&bad) != PIREUS_POC_OK { passed = passed + 1 }
    passed
}

pub fn pireus_operator_orbit_canonicalization_run(
    request: &PireusPocRequest, emit: bool,
) -> PireusPocSummary with IO, Mut, Panic, Div, Epistemic {
    let request_error = poc_request_error(request)
    let cubic_request = pireus_cubic_forge_request()
    let cubic = pireus_cubic_operator_forge_evaluate(&cubic_request)
    let morph_request = pireus_operator_morphogenesis_request()
    let morph = pireus_operator_morphogenesis_evaluate(&morph_request)
    let quotient_request = pireus_quotient_novelty_request()
    let quotient = pireus_quotient_novelty_evaluate(&quotient_request)
    let cubic_match = cubic.valid &&
        pireus_cubic_operator_forge_matches_frozen_semantics(&cubic)
    let morph_match = morph.valid &&
        pireus_operator_morphogenesis_matches_frozen_semantics(&morph)
    let quotient_match = quotient.valid &&
        pireus_quotient_novelty_matches_frozen_semantics(&quotient)

    let matrices = poc_build_matrix_universe()
    let gauge = poc_build_gauge_certificate()

    var archive: [i64; 32768] = [0; 32768]
    var archive_count: i64 = 0
    var reconstruction_failures: i64 = 0
    var child: i64 = 0
    while child < PIREUS_CUBIC_FORGE_MUTATION_COUNT {
        var direct: [i64; 256] = [0; 256]
        var action: [i64; 256] = [0; 256]
        var cell: i64 = 0
        while cell < PIREUS_POC_CELLS {
            direct[cell] = cubic.population.sign_bits[
                child * PIREUS_POC_CELLS + cell]
            action[cell] = cubic.population.sign_bits[
                child * PIREUS_POC_CELLS + poc_v12_action_cell(cell)]
            cell = cell + 1
        }
        var first = direct
        var second = action
        if poc_row_less(&action, &direct) { first = action; second = direct }
        archive_count = poc_archive_append(&!archive, archive_count, &first)
        if !poc_rows_equal(&first, &second) {
            archive_count = poc_archive_append(&!archive, archive_count, &second)
        }
        child = child + 1
    }
    var epoch: i64 = 0
    while epoch < PIREUS_POM_EPOCHS {
        var direct: [i64; 256] = [0; 256]
        var action: [i64; 256] = [0; 256]
        var cell: i64 = 0
        while cell < PIREUS_POC_CELLS {
            direct[cell] = morph.population.generated_sign_bits[
                epoch * PIREUS_POC_CELLS + cell]
            action[cell] = morph.population.generated_sign_bits[
                epoch * PIREUS_POC_CELLS + poc_v12_action_cell(cell)]
            cell = cell + 1
        }
        var first = direct
        var second = action
        if poc_row_less(&action, &direct) { first = action; second = direct }
        archive_count = poc_archive_append(&!archive, archive_count, &first)
        if !poc_rows_equal(&first, &second) {
            archive_count = poc_archive_append(&!archive, archive_count, &second)
        }
        epoch = epoch + 1
    }
    if archive_count != PIREUS_POC_V12_IMAGES {
        reconstruction_failures = reconstruction_failures + 1
    }
    let v12_archive_digest = poc_v12_archive_digest(&archive, archive_count)
    let baseline_digest_match = poc_digest_equal(
        &v12_archive_digest, &morph.population.final_archive_digest.words)
    if !baseline_digest_match { reconstruction_failures = reconstruction_failures + 1 }

    var classes: [i64; 1280] = [0; 1280]
    var class_count: i64 = 0
    var class_origin_kind: [i64; 160] = [0; 160]
    var class_origin_source: [i64; 160] = [0; 160]
    var class_origin_matrix: [i64; 160] = [0; 160]
    var class_origin_swap: [i64; 160] = [0; 160]
    var class_origin_gauge: [i64; 160] = [0; 160]
    var baseline_state = sha256_init()
    baseline_state = poc_digest_add_i64(baseline_state, PIREUS_POC_SCHEMA)
    baseline_state = poc_digest_add_i64(baseline_state, 733010)
    baseline_state = poc_digest_add_i64(baseline_state, archive_count)
    var archive_word: i64 = 0
    while archive_word < 8 {
        baseline_state = poc_digest_add_i64(
            baseline_state, v12_archive_digest.words[archive_word])
        archive_word = archive_word + 1
    }
    var canonicalizations: i64 = 0
    var action_views: i64 = 0
    var action_pivot_checks: i64 = 0
    var action_pivot_failures: i64 = 0
    var canonical_cell_comparisons: i64 = 0
    var canonical_replacements: i64 = 0
    var canonical_replay_checks: i64 = 0
    var canonical_replay_failures: i64 = 0
    var image: i64 = 0
    while image < archive_count {
        var row: [i64; 256] = [0; 256]
        var cell: i64 = 0
        while cell < PIREUS_POC_CELLS {
            row[cell] = archive[image * PIREUS_POC_CELLS + cell]
            cell = cell + 1
        }
        let canonical = poc_canonicalize(&row, &matrices)
        canonicalizations = canonicalizations + 1
        action_views = action_views + canonical.action_views
        action_pivot_checks = action_pivot_checks + canonical.pivot_checks
        action_pivot_failures = action_pivot_failures + canonical.pivot_failures
        canonical_cell_comparisons = canonical_cell_comparisons +
            canonical.cell_comparisons
        canonical_replacements = canonical_replacements + canonical.replacements
        canonical_replay_checks = canonical_replay_checks + canonical.replay_checks
        canonical_replay_failures = canonical_replay_failures +
            canonical.replay_failures
        if !canonical.complete { reconstruction_failures = reconstruction_failures + 1 }
        var class_id = poc_class_find(&classes, class_count, &canonical.words)
        let new_class = class_id < 0
        if new_class {
            class_id = class_count
            class_count = poc_class_append(&!classes, class_count, &canonical.words)
            class_origin_kind[class_id] = 1
            class_origin_source[class_id] = image
            class_origin_matrix[class_id] = canonical.matrix
            class_origin_swap[class_id] = canonical.swap
            class_origin_gauge[class_id] = canonical.gauge
        }
        baseline_state = poc_digest_add_i64(baseline_state, image)
        baseline_state = poc_digest_add_i64(baseline_state, class_id)
        baseline_state = poc_digest_add_i64(baseline_state, canonical.matrix)
        baseline_state = poc_digest_add_i64(baseline_state, canonical.swap)
        baseline_state = poc_digest_add_i64(baseline_state, canonical.gauge)
        cell = 0
        while cell < PIREUS_POC_CELLS {
            baseline_state = poc_digest_add_i64(baseline_state, row[cell])
            baseline_state = poc_digest_add_i64(
                baseline_state, canonical.cells[cell])
            cell = cell + 1
        }
        if emit {
            print("PIREUS_POC_BASELINE image="); print_int(image)
            print(" class="); print_int(class_id)
            print(" matrix="); print_int(canonical.matrix)
            print(" swap="); print_int(canonical.swap)
            print(" gauge="); print_int(canonical.gauge)
            print(" actions="); print_int(canonical.action_views)
            print(" replay_failures="); print_int(canonical.replay_failures)
            print(" words=")
            var word: i64 = 0
            while word < PIREUS_POC_CLASS_WORDS {
                if word > 0 { print(":") }
                print_int(canonical.words[word])
                word = word + 1
            }
            print("\n")
        }
        image = image + 1
    }
    let baseline_class_count = class_count
    let baseline_class_digest = poc_digest_classes(
        &classes, baseline_class_count)
    var baseline_word: i64 = 0
    while baseline_word < 8 {
        baseline_state = poc_digest_add_i64(
            baseline_state, baseline_class_digest.words[baseline_word])
        baseline_word = baseline_word + 1
    }
    let baseline_digest = poc_digest_finish(baseline_state)
    if emit {
        print("PIREUS_POC_BASELINE_RECEIPT images="); print_int(archive_count)
        print(" classes="); print_int(baseline_class_count)
        print(" v12_archive_digest="); poc_emit_digest(&v12_archive_digest)
        print(" class_digest="); poc_emit_digest(&baseline_class_digest)
        print(" proof_digest="); poc_emit_digest(&baseline_digest)
        print("\n")
    }

    var accepted_parent_epochs: [i64; 32] = [0; 32]
    var accepted_coefficients: [i64; 32] = [0; 32]
    var accepted_matrices: [i64; 32] = [0; 32]
    var accepted_swaps: [i64; 32] = [0; 32]
    var accepted_gauges: [i64; 32] = [0; 32]
    var accepted_digest_words: [i64; 256] = [0; 256]
    var mutation_attempts: i64 = 0
    var equivalent_collapses: i64 = 0
    var admitted: i64 = 0
    var separator_certificates: i64 = 0
    var separator_checks: i64 = 0
    var separator_failures: i64 = 0
    var mutation_checks: i64 = 0
    var mutation_failures: i64 = 0
    var phase_checks: i64 = 0
    var phase_failures: i64 = 0
    var anf_checks: i64 = 0
    var anf_failures: i64 = 0
    var unit_checks: i64 = 0
    var unit_failures: i64 = 0
    var microprogram_checks: i64 = 0
    var microprogram_failures: i64 = 0
    var diagnostic_checks: i64 = 0
    var run_state = sha256_init()
    run_state = poc_digest_add_i64(run_state, PIREUS_POC_SCHEMA)
    var attempt: i64 = 0
    while attempt < PIREUS_POC_MUTATION_REQUESTS &&
        admitted < PIREUS_POC_ADMISSION_QUOTA {
        let parent_epoch = attempt / PIREUS_POC_INTERIOR
        let coefficient = attempt - parent_epoch * PIREUS_POC_INTERIOR
        var raw_anf: [i64; 225] = [0; 225]
        var index: i64 = 0
        var changed: i64 = 0
        while index < PIREUS_POC_INTERIOR {
            let parent_value = morph.population.generated_anf_bits[
                parent_epoch * PIREUS_POC_INTERIOR + index]
            raw_anf[index] = if index == coefficient {
                parent_value ^ 1
            } else { parent_value }
            mutation_checks = mutation_checks + 1
            if raw_anf[index] != parent_value { changed = changed + 1 }
            index = index + 1
        }
        if changed != 1 { mutation_failures = mutation_failures + 1 }
        let raw_phase = poc_anf_to_phase(&raw_anf)
        let raw_signs = poc_build_signs(&raw_phase)
        let canonical = poc_canonicalize(&raw_signs, &matrices)
        canonicalizations = canonicalizations + 1
        action_views = action_views + canonical.action_views
        action_pivot_checks = action_pivot_checks + canonical.pivot_checks
        action_pivot_failures = action_pivot_failures + canonical.pivot_failures
        canonical_cell_comparisons = canonical_cell_comparisons +
            canonical.cell_comparisons
        canonical_replacements = canonical_replacements + canonical.replacements
        canonical_replay_checks = canonical_replay_checks + canonical.replay_checks
        canonical_replay_failures = canonical_replay_failures +
            canonical.replay_failures

        let raw_recovered_anf = poc_phase_to_anf(&raw_phase)
        let canonical_phase = poc_signs_to_phase(&canonical.cells)
        let canonical_anf = poc_phase_to_anf(&canonical_phase)
        let raw_digest = poc_digest_raw(
            parent_epoch, coefficient, &raw_phase, &raw_anf, &raw_signs)
        let canonical_digest = poc_digest_canonical(
            &canonical, &canonical_phase, &canonical_anf)
        let existing_class = poc_class_find(
            &classes, class_count, &canonical.words)
        mutation_attempts = mutation_attempts + 1
        run_state = poc_digest_add_i64(run_state, attempt)
        run_state = poc_digest_add_i64(run_state, parent_epoch)
        run_state = poc_digest_add_i64(run_state, coefficient)
        run_state = poc_digest_add_i64(run_state, existing_class)
        var attempt_word: i64 = 0
        while attempt_word < 8 {
            run_state = poc_digest_add_i64(
                run_state, raw_digest.words[attempt_word])
            run_state = poc_digest_add_i64(
                run_state, canonical_digest.words[attempt_word])
            attempt_word = attempt_word + 1
        }
        if emit {
            print("PIREUS_POC_ATTEMPT attempt="); print_int(attempt)
            print(" parent_epoch="); print_int(parent_epoch)
            print(" coefficient="); print_int(coefficient)
            print(" existing_class="); print_int(existing_class)
            print(" canonical_complete=");
            print_int(if canonical.complete { 1 } else { 0 })
            print(" candidate_matrix="); print_int(canonical.matrix)
            print(" candidate_swap="); print_int(canonical.swap)
            print(" candidate_gauge="); print_int(canonical.gauge)
            if existing_class >= 0 {
                print(" origin_kind="); print_int(class_origin_kind[existing_class])
                print(" origin_source="); print_int(
                    class_origin_source[existing_class])
                print(" origin_matrix="); print_int(
                    class_origin_matrix[existing_class])
                print(" origin_swap="); print_int(class_origin_swap[existing_class])
                print(" origin_gauge="); print_int(
                    class_origin_gauge[existing_class])
            }
            print(" raw_digest="); poc_emit_digest(&raw_digest)
            print(" canonical_digest="); poc_emit_digest(&canonical_digest)
            print("\n")
        }
        if existing_class >= 0 {
            equivalent_collapses = equivalent_collapses + 1
            run_state = poc_digest_add_i64(
                run_state, class_origin_kind[existing_class])
            run_state = poc_digest_add_i64(
                run_state, class_origin_source[existing_class])
            run_state = poc_digest_add_i64(
                run_state, class_origin_matrix[existing_class])
            run_state = poc_digest_add_i64(
                run_state, class_origin_swap[existing_class])
            run_state = poc_digest_add_i64(
                run_state, class_origin_gauge[existing_class])
        } else if canonical.complete && class_count < PIREUS_POC_CLASS_CAPACITY {
            var separator_state = sha256_init()
            separator_state = poc_digest_add_i64(
                separator_state, PIREUS_POC_SCHEMA)
            separator_state = poc_digest_add_i64(separator_state, 733103)
            separator_state = poc_digest_add_i64(separator_state, admitted)
            separator_state = poc_digest_add_i64(separator_state, class_count)
            var prior: i64 = 0
            while prior < class_count {
                var witness: i64 = -1
                var cell: i64 = 0
                while cell < PIREUS_POC_CELLS && witness < 0 {
                    let prior_bit = poc_class_bit(&classes, prior, cell)
                    separator_checks = separator_checks + 1
                    if prior_bit != canonical.cells[cell] { witness = cell }
                    cell = cell + 1
                }
                if witness < 0 { separator_failures = separator_failures + 1 }
                separator_certificates = separator_certificates + 1
                separator_state = poc_digest_add_i64(separator_state, prior)
                separator_state = poc_digest_add_i64(separator_state, witness)
                if witness >= 0 {
                    separator_state = poc_digest_add_i64(
                        separator_state, canonical.cells[witness])
                    separator_state = poc_digest_add_i64(
                        separator_state,
                        poc_class_bit(&classes, prior, witness))
                }
                if emit {
                    print("PIREUS_POC_SEPARATOR admitted="); print_int(admitted)
                    print(" prior_class="); print_int(prior)
                    print(" cell="); print_int(witness)
                    if witness >= 0 {
                        print(" generated="); print_int(canonical.cells[witness])
                        print(" prior="); print_int(
                            poc_class_bit(&classes, prior, witness))
                    }
                    print("\n")
                }
                prior = prior + 1
            }

            let separator_digest = poc_digest_finish(separator_state)
            let reconstructed_phase = poc_anf_to_phase(&canonical_anf)
            var index: i64 = 0
            while index < PIREUS_POC_INTERIOR {
                phase_checks = phase_checks + 2
                anf_checks = anf_checks + 2
                if (raw_phase[index] != 0 && raw_phase[index] != 1) ||
                    (canonical_phase[index] != 0 &&
                     canonical_phase[index] != 1) {
                    phase_failures = phase_failures + 1
                }
                if raw_recovered_anf[index] != raw_anf[index] {
                    anf_failures = anf_failures + 1
                }
                if reconstructed_phase[index] != canonical_phase[index] {
                    anf_failures = anf_failures + 1
                }
                index = index + 1
            }
            let raw_microprogram = poc_build_microprogram(&raw_signs)
            let canonical_microprogram = poc_build_microprogram(&canonical.cells)
            var cell: i64 = 0
            while cell < PIREUS_POC_CELLS {
                let left = cell / PIREUS_POC_LANES
                let right = cell - left * PIREUS_POC_LANES
                phase_checks = phase_checks + 2
                if (raw_signs[cell] != 0 && raw_signs[cell] != 1) ||
                    (canonical.cells[cell] != 0 &&
                     canonical.cells[cell] != 1) {
                    phase_failures = phase_failures + 1
                }
                if left == 0 || right == 0 {
                    unit_checks = unit_checks + 2
                    if raw_signs[cell] != 0 { unit_failures = unit_failures + 1 }
                    if canonical.cells[cell] != 0 { unit_failures = unit_failures + 1 }
                }
                cell = cell + 1
            }
            var destination: i64 = 0
            while destination < PIREUS_POC_LANES {
                var ordinal: i64 = 0
                while ordinal < PIREUS_POC_LANES {
                    let entry = destination * PIREUS_POC_LANES + ordinal
                    let partner = ordinal ^ destination
                    microprogram_checks = microprogram_checks + 2
                    if raw_microprogram.destinations[entry] != destination ||
                        raw_microprogram.ordinals[entry] != ordinal ||
                        raw_microprogram.left_inputs[entry] != ordinal ||
                        raw_microprogram.right_inputs[entry] != partner ||
                        raw_microprogram.sign_bits[entry] != raw_signs[
                            ordinal * PIREUS_POC_LANES + partner] {
                        microprogram_failures = microprogram_failures + 1
                    }
                    if canonical_microprogram.destinations[entry] != destination ||
                        canonical_microprogram.ordinals[entry] != ordinal ||
                        canonical_microprogram.left_inputs[entry] != ordinal ||
                        canonical_microprogram.right_inputs[entry] != partner ||
                        canonical_microprogram.sign_bits[entry] != canonical.cells[
                            ordinal * PIREUS_POC_LANES + partner] {
                        microprogram_failures = microprogram_failures + 1
                    }
                    ordinal = ordinal + 1
                }
                destination = destination + 1
            }

            var negatives: i64 = 0
            var squares: i64 = 0
            var ordered_commutator_defects: i64 = 0
            var left: i64 = 0
            while left < PIREUS_POC_LANES {
                var right: i64 = 0
                while right < PIREUS_POC_LANES {
                    let bit = canonical.cells[left * PIREUS_POC_LANES + right]
                    if bit != 0 { negatives = negatives + 1 }
                    if left == right && bit != 0 { squares = squares + 1 }
                    if bit != canonical.cells[right * PIREUS_POC_LANES + left] {
                        ordered_commutator_defects =
                            ordered_commutator_defects + 1
                    }
                    diagnostic_checks = diagnostic_checks + 3
                    right = right + 1
                }
                left = left + 1
            }
            var associators: i64 = 0
            var i: i64 = 0
            while i < PIREUS_POC_LANES {
                var j: i64 = 0
                while j < PIREUS_POC_LANES {
                    var k: i64 = 0
                    while k < PIREUS_POC_LANES {
                        let defect =
                            canonical.cells[i * PIREUS_POC_LANES + j] ^
                            canonical.cells[(i ^ j) * PIREUS_POC_LANES + k] ^
                            canonical.cells[j * PIREUS_POC_LANES + k] ^
                            canonical.cells[i * PIREUS_POC_LANES + (j ^ k)]
                        if defect != 0 { associators = associators + 1 }
                        diagnostic_checks = diagnostic_checks + 1
                        k = k + 1
                    }
                    j = j + 1
                }
                i = i + 1
            }
            var probes: [i64; 16] = [0; 16]
            var destination: i64 = 0
            while destination < PIREUS_POC_LANES {
                var sum: i64 = 0
                i = 0
                while i < PIREUS_POC_LANES {
                    let partner = i ^ destination
                    let sign = if canonical.cells[
                        i * PIREUS_POC_LANES + partner] == 0 { 1 } else { -1 }
                    sum = sum + sign * (i + 1) *
                        (PIREUS_POC_LANES + 1 - partner)
                    i = i + 1
                }
                probes[destination] = sum
                destination = destination + 1
            }

            let certificate_digest = poc_digest_certificate(
                &canonical, &separator_digest)
            let epoch_digest = poc_digest_epoch(
                parent_epoch, coefficient, &raw_digest, &canonical_digest,
                &certificate_digest, negatives, squares,
                ordered_commutator_defects,
                associators, &probes)
            accepted_parent_epochs[admitted] = parent_epoch
            accepted_coefficients[admitted] = coefficient
            accepted_matrices[admitted] = canonical.matrix
            accepted_swaps[admitted] = canonical.swap
            accepted_gauges[admitted] = canonical.gauge
            var word: i64 = 0
            while word < 8 {
                accepted_digest_words[admitted * 8 + word] =
                    epoch_digest.words[word]
                run_state = poc_digest_add_i64(
                    run_state, epoch_digest.words[word])
                word = word + 1
            }
            let cumulative_archive_digest = poc_digest_finish(run_state)
            let admitted_class_id = class_count
            class_count = poc_class_append(
                &!classes, class_count, &canonical.words)
            class_origin_kind[admitted_class_id] = 2
            class_origin_source[admitted_class_id] = admitted
            class_origin_matrix[admitted_class_id] = canonical.matrix
            class_origin_swap[admitted_class_id] = canonical.swap
            class_origin_gauge[admitted_class_id] = canonical.gauge
            if emit {
                print("PIREUS_POC_ADMITTED admitted="); print_int(admitted)
                print(" parent_epoch="); print_int(parent_epoch)
                print(" coefficient="); print_int(coefficient)
                print(" matrix="); print_int(canonical.matrix)
                print(" swap="); print_int(canonical.swap)
                print(" gauge="); print_int(canonical.gauge)
                print(" prior_classes="); print_int(class_count - 1)
                print(" negatives="); print_int(negatives)
                print(" squares="); print_int(squares)
                print(" ordered_commutator_defects=")
                print_int(ordered_commutator_defects)
                print(" associators="); print_int(associators)
                print(" probes=")
                var lane: i64 = 0
                while lane < PIREUS_POC_LANES {
                    if lane > 0 { print(":") }
                    print_int(probes[lane]); lane = lane + 1
                }
                print(" raw_digest="); poc_emit_digest(&raw_digest)
                print(" canonical_digest="); poc_emit_digest(&canonical_digest)
                print(" certificate_digest=");
                poc_emit_digest(&certificate_digest)
                print(" epoch_digest="); poc_emit_digest(&epoch_digest)
                print(" archive_digest=");
                poc_emit_digest(&cumulative_archive_digest)
                print("\n")
                poc_emit_phase(admitted, false, &raw_phase)
                poc_emit_anf(admitted, false, &raw_anf)
                poc_emit_bits(admitted, false, &raw_signs)
                poc_emit_microprogram(admitted, false, &raw_microprogram)
                poc_emit_phase(admitted, true, &canonical_phase)
                poc_emit_anf(admitted, true, &canonical_anf)
                poc_emit_bits(admitted, true, &canonical.cells)
                poc_emit_microprogram(admitted, true, &canonical_microprogram)
            }
            admitted = admitted + 1
        }
        attempt = attempt + 1
    }

    let negative_cases_passed = poc_negative_count()
    let final_class_digest = poc_digest_classes(&classes, class_count)
    var word: i64 = 0
    while word < 8 {
        run_state = poc_digest_add_i64(run_state, baseline_digest.words[word])
        run_state = poc_digest_add_i64(run_state, final_class_digest.words[word])
        word = word + 1
    }
    run_state = poc_digest_add_i64(run_state, mutation_attempts)
    run_state = poc_digest_add_i64(run_state, equivalent_collapses)
    run_state = poc_digest_add_i64(run_state, admitted)
    let run_digest = poc_digest_finish(run_state)
    let expected_separator_certificates =
        admitted * baseline_class_count + admitted * (admitted - 1) / 2

    var error = request_error
    if error == PIREUS_POC_OK &&
        (!cubic_match || !morph_match || !quotient_match) {
        error = PIREUS_POC_ERR_LINEAGE
    }
    if error == PIREUS_POC_OK &&
        (!matrices.complete || !gauge.complete || reconstruction_failures != 0) {
        error = PIREUS_POC_ERR_UNIVERSE
    }
    if error == PIREUS_POC_OK &&
        (action_pivot_failures != 0 || canonical_replay_failures != 0 ||
         separator_failures != 0 || mutation_failures != 0 ||
         phase_failures != 0 || anf_failures != 0 || unit_failures != 0 ||
         microprogram_failures != 0 ||
         class_count != baseline_class_count + admitted ||
         separator_certificates != expected_separator_certificates) {
        error = PIREUS_POC_ERR_CANONICALIZATION
    }
    if error == PIREUS_POC_OK && admitted != PIREUS_POC_ADMISSION_QUOTA {
        error = PIREUS_POC_ERR_QUOTA
    }
    if error == PIREUS_POC_OK &&
        negative_cases_passed != PIREUS_POC_NEGATIVE_CASES {
        error = PIREUS_POC_ERR_UNIVERSE
    }
    let valid = error == PIREUS_POC_OK &&
        pireus_poc_digest_nonzero(&baseline_digest) &&
        pireus_poc_digest_nonzero(&run_digest)
    let relative_novelty_proven = valid &&
        class_count == baseline_class_count + admitted &&
        separator_certificates == expected_separator_certificates &&
        separator_failures == 0
    let exact_orbit_canonicalization_complete =
        matrices.complete && gauge.complete && canonicalizations > 0 &&
        action_views == canonicalizations * PIREUS_POC_ACTIONS &&
        action_pivot_checks == action_views * PIREUS_POC_GAUGE_BITS &&
        action_pivot_failures == 0 &&
        canonical_replay_checks == canonicalizations * PIREUS_POC_CELLS &&
        canonical_replay_failures == 0

    if emit {
        print("PIREUS_POC_RESULT valid="); print_int(if valid { 1 } else { 0 })
        print(" error="); print_int(error)
        print(" baseline_images="); print_int(archive_count)
        print(" baseline_classes="); print_int(baseline_class_count)
        print(" attempts="); print_int(mutation_attempts)
        print(" collapses="); print_int(equivalent_collapses)
        print(" admitted="); print_int(admitted)
        print(" final_classes="); print_int(class_count)
        print(" baseline_digest="); poc_emit_digest(&baseline_digest)
        print(" run_digest="); poc_emit_digest(&run_digest)
        print("\n")
    }

    PireusPocSummary {
        valid: valid,
        error: error,
        garden_sha256: poc_garden_hash(),
        contract_sha256: poc_contract_hash(),
        v12_semantics_sha256: poc_v12_semantics_hash(),
        v5_semantics_sha256: poc_v5_semantics_hash(),
        cubic_parent_match: cubic_match,
        v12_parent_match: morph_match,
        v5_parent_match: quotient_match,
        matrix_codes_scanned: matrices.scanned,
        invertible_matrices: matrices.count,
        matrix_inverse_checks: matrices.inverse_checks,
        matrix_inverse_failures: matrices.inverse_failures,
        gauge_pivot_checks: gauge.pivot_checks,
        gauge_pivot_failures: gauge.pivot_failures,
        gauge_roundtrip_words: gauge.roundtrip_words,
        gauge_roundtrip_cell_checks: gauge.roundtrip_cell_checks,
        gauge_roundtrip_failures: gauge.roundtrip_failures,
        baseline_images: archive_count,
        baseline_reconstruction_failures: reconstruction_failures,
        baseline_digest_match: baseline_digest_match,
        baseline_classes: baseline_class_count,
        canonicalizations: canonicalizations,
        action_views: action_views,
        action_pivot_checks: action_pivot_checks,
        action_pivot_failures: action_pivot_failures,
        canonical_cell_comparisons: canonical_cell_comparisons,
        canonical_replacements: canonical_replacements,
        canonical_replay_checks: canonical_replay_checks,
        canonical_replay_failures: canonical_replay_failures,
        mutation_attempts: mutation_attempts,
        equivalent_collapses: equivalent_collapses,
        admitted_classes: admitted,
        separator_certificates: separator_certificates,
        separator_checks: separator_checks,
        separator_failures: separator_failures,
        mutation_checks: mutation_checks,
        mutation_failures: mutation_failures,
        phase_checks: phase_checks,
        phase_failures: phase_failures,
        anf_checks: anf_checks,
        anf_failures: anf_failures,
        unit_checks: unit_checks,
        unit_failures: unit_failures,
        microprogram_checks: microprogram_checks,
        microprogram_failures: microprogram_failures,
        diagnostic_checks: diagnostic_checks,
        negative_cases_passed: negative_cases_passed,
        negative_cases_total: PIREUS_POC_NEGATIVE_CASES,
        accepted_parent_epochs: accepted_parent_epochs,
        accepted_coefficients: accepted_coefficients,
        accepted_matrices: accepted_matrices,
        accepted_swaps: accepted_swaps,
        accepted_gauges: accepted_gauges,
        accepted_digest_words: accepted_digest_words,
        baseline_digest: baseline_digest,
        run_digest: run_digest,
        exact_declared_orbit_canonicalization_complete:
            exact_orbit_canonicalization_complete,
        bounded_relative_linear_swap_gauge_novelty: relative_novelty_proven,
        full_2_pow_225_space_exhausted: false,
        nonlinear_permutation_quotient_complete: false,
        isotopy_quotient_complete: false,
        unrestricted_algebra_isomorphism_complete: false,
        algebraic_novelty: false,
        algorithmic_novelty: false,
        material_novelty: false,
        performance_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        target_lowering_admitted: false,
        target_cost_admitted: false,
        target_performance_admitted: false,
        claim_ready: false,
    }
}

fn poc_frozen_baseline_digest() -> [i64; 8] {
    [1619739330, 509959256, 1829541199, 4004458776,
     3154457165, 2978536556, 2568791052, 3021525291]
}

fn poc_frozen_run_digest() -> [i64; 8] {
    [1693503312, 191400551, 3569810787, 2535055422,
     3072308315, 3334613886, 2129959844, 1662793680]
}

pub fn pireus_operator_orbit_canonicalization_frozen_mismatch_code(
    result: &PireusPocSummary,
) -> i64 with Mut, Panic {
    if !result.valid || result.error != PIREUS_POC_OK { return 1 }
    if !result.cubic_parent_match || !result.v12_parent_match ||
        !result.v5_parent_match { return 2 }
    if result.matrix_codes_scanned != PIREUS_POC_MATRIX_CODES ||
        result.invertible_matrices != PIREUS_POC_GL4_COUNT ||
        result.matrix_inverse_checks != PIREUS_POC_GL4_COUNT * 32 ||
        result.matrix_inverse_failures != 0 ||
        result.gauge_pivot_checks !=
            PIREUS_POC_GAUGE_BITS * PIREUS_POC_GAUGE_BITS ||
        result.gauge_pivot_failures != 0 ||
        result.gauge_roundtrip_words != PIREUS_POC_GAUGE_WORDS ||
        result.gauge_roundtrip_cell_checks !=
            PIREUS_POC_GAUGE_WORDS * PIREUS_POC_CELLS ||
        result.gauge_roundtrip_failures != 0 { return 3 }
    if result.baseline_images != PIREUS_POC_V12_IMAGES ||
        result.baseline_reconstruction_failures != 0 ||
        !result.baseline_digest_match ||
        result.baseline_classes != PIREUS_POC_FROZEN_BASELINE_CLASSES {
        return 4
    }
    let frozen_canonicalizations = PIREUS_POC_V12_IMAGES +
        PIREUS_POC_FROZEN_MUTATION_ATTEMPTS
    if result.canonicalizations != frozen_canonicalizations ||
        result.action_views != frozen_canonicalizations * PIREUS_POC_ACTIONS ||
        result.action_pivot_checks != result.action_views *
            PIREUS_POC_GAUGE_BITS || result.action_pivot_failures != 0 ||
        result.canonical_replay_checks !=
            frozen_canonicalizations * PIREUS_POC_CELLS ||
        result.canonical_replay_failures != 0 ||
        result.canonical_replacements < frozen_canonicalizations ||
        result.canonical_cell_comparisons <= 0 { return 5 }
    if result.mutation_attempts != PIREUS_POC_FROZEN_MUTATION_ATTEMPTS ||
        result.equivalent_collapses !=
            PIREUS_POC_FROZEN_EQUIVALENT_COLLAPSES ||
        result.admitted_classes != PIREUS_POC_ADMISSION_QUOTA ||
        result.baseline_classes + result.admitted_classes !=
            PIREUS_POC_FROZEN_FINAL_CLASSES ||
        result.separator_certificates != 1456 ||
        result.separator_checks < result.separator_certificates ||
        result.separator_failures != 0 ||
        result.mutation_checks !=
            PIREUS_POC_FROZEN_MUTATION_ATTEMPTS * PIREUS_POC_INTERIOR ||
        result.mutation_failures != 0 { return 6 }
    if result.phase_checks != 30784 || result.phase_failures != 0 ||
        result.anf_checks != 14400 || result.anf_failures != 0 ||
        result.unit_checks != 1984 || result.unit_failures != 0 ||
        result.microprogram_checks != 16384 ||
        result.microprogram_failures != 0 ||
        result.diagnostic_checks != 155648 ||
        result.negative_cases_passed != PIREUS_POC_NEGATIVE_CASES ||
        result.negative_cases_total != PIREUS_POC_NEGATIVE_CASES { return 7 }
    let frozen_baseline_digest = poc_frozen_baseline_digest()
    let frozen_run_digest = poc_frozen_run_digest()
    if !poc_digest_equal(&result.baseline_digest, &frozen_baseline_digest) ||
        !poc_digest_equal(&result.run_digest, &frozen_run_digest) {
        return 8
    }
    if !result.exact_declared_orbit_canonicalization_complete ||
        !result.bounded_relative_linear_swap_gauge_novelty ||
        result.full_2_pow_225_space_exhausted ||
        result.nonlinear_permutation_quotient_complete ||
        result.isotopy_quotient_complete ||
        result.unrestricted_algebra_isomorphism_complete ||
        result.algebraic_novelty || result.algorithmic_novelty ||
        result.material_novelty || result.performance_novelty ||
        result.scientific_novelty || result.global_novelty ||
        result.historical_novelty || result.priority_claim ||
        result.target_lowering_admitted || result.target_cost_admitted ||
        result.target_performance_admitted || result.claim_ready { return 9 }
    0
}

pub fn pireus_operator_orbit_canonicalization_matches_frozen_semantics(
    result: &PireusPocSummary,
) -> bool with Mut, Panic {
    pireus_operator_orbit_canonicalization_frozen_mismatch_code(result) == 0
}
