fn onf_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn onf_digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div, Epistemic {
    onf_digest_add_i64(state, if value { 1 } else { 0 })
}

fn onf_digest_add_words(state: SHA256State, words: &[i64; 8]) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var next = state
    var index: i64 = 0
    while index < 8 {
        next = onf_digest_add_i64(next, words[index])
        index = index + 1
    }
    next
}

fn onf_digest_finish(state: SHA256State) -> PireusOnfDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOnfDigest { words: words }
}

pub fn pireus_onf_digest_nonzero(digest: &PireusOnfDigest) -> bool
with Mut, Panic {
    var index: i64 = 0
    while index < 8 {
        if digest.words[index] != 0 { return true }
        index = index + 1
    }
    false
}

pub fn pireus_operator_novelty_feedback_request() -> PireusOnfRequest {
    PireusOnfRequest {
        producer_language: PIREUS_ONF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE,
        policy_present: true,
        quotient_parent_present: true,
        quotient_parent_frozen: true,
        quotient_parent_source_bound: true,
        quotient_parent_semantics_bound: true,
        quotient_parent_freeze_bound: true,
        lowering_parent_present: true,
        lowering_parent_frozen: true,
        lowering_parent_source_bound: true,
        lowering_parent_semantics_bound: true,
        lowering_parent_freeze_bound: true,
        challenge_lineage_present: true,
        challenge_source_bound: true,
        challenge_semantics_bound: true,
        challenge_receipt_bound: true,
        declared_bits: PIREUS_ONF_BITS,
        declared_dimension: PIREUS_ONF_DIMENSION,
        declared_cells: PIREUS_ONF_CELL_COUNT,
        declared_matrix_encodings: PIREUS_QUOTIENT_MATRIX_ENCODINGS,
        declared_gl4_count: PIREUS_QUOTIENT_GL4_COUNT,
        declared_action_count: PIREUS_QUOTIENT_ACTION_COUNT,
        declared_gauge_bits: PIREUS_QUOTIENT_GAUGE_BITS,
        declared_gauge_words: PIREUS_QUOTIENT_GAUGE_WORD_COUNT,
        expected_outcome_present: false,
        expected_class_present: false,
        expected_action_present: false,
        expected_gauge_present: false,
        expected_residual_present: false,
        expected_digest_present: false,
        expected_transcript_present: false,
        semantic_write_from_parity: false,
        expected_result_write_from_parity: false,
        external_review_promoted: false,
        material_result_present: false,
        target_cost_present: false,
        target_performance_present: false,
        broad_novelty_requested: false,
        historical_novelty_requested: false,
        priority_requested: false,
        semantics_frozen: false,
        parity_requested: false,
        claim_ready_requested: false,
        waiver_present: false,
        waiver_founder: false,
        waiver_scoped: false,
        waiver_purpose_bound: false,
        waiver_live: false,
    }
}

fn onf_request_error(request: &PireusOnfRequest) -> i64 {
    if request.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_ONF_ERR_AUTHORITY
    }
    if request.stage != PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE ||
        request.semantics_frozen || request.parity_requested {
        return PIREUS_ONF_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_ONF_ERR_POLICY }
    if !request.quotient_parent_present || !request.quotient_parent_frozen ||
        !request.quotient_parent_source_bound ||
        !request.quotient_parent_semantics_bound ||
        !request.quotient_parent_freeze_bound ||
        !request.lowering_parent_present || !request.lowering_parent_frozen ||
        !request.lowering_parent_source_bound ||
        !request.lowering_parent_semantics_bound ||
        !request.lowering_parent_freeze_bound ||
        !request.challenge_lineage_present ||
        !request.challenge_source_bound ||
        !request.challenge_semantics_bound ||
        !request.challenge_receipt_bound {
        return PIREUS_ONF_ERR_LINEAGE
    }
    if request.declared_bits != PIREUS_ONF_BITS ||
        request.declared_dimension != PIREUS_ONF_DIMENSION ||
        request.declared_cells != PIREUS_ONF_CELL_COUNT ||
        request.declared_matrix_encodings != PIREUS_QUOTIENT_MATRIX_ENCODINGS ||
        request.declared_gl4_count != PIREUS_QUOTIENT_GL4_COUNT ||
        request.declared_action_count != PIREUS_QUOTIENT_ACTION_COUNT ||
        request.declared_gauge_bits != PIREUS_QUOTIENT_GAUGE_BITS ||
        request.declared_gauge_words != PIREUS_QUOTIENT_GAUGE_WORD_COUNT {
        return PIREUS_ONF_ERR_UNIVERSE
    }
    if request.expected_outcome_present || request.expected_class_present ||
        request.expected_action_present || request.expected_gauge_present ||
        request.expected_residual_present || request.expected_digest_present ||
        request.expected_transcript_present ||
        request.semantic_write_from_parity ||
        request.expected_result_write_from_parity ||
        request.external_review_promoted {
        return PIREUS_ONF_ERR_RESULT_INJECTION
    }
    if request.material_result_present || request.target_cost_present ||
        request.target_performance_present {
        return PIREUS_ONF_ERR_MATERIAL
    }
    if request.broad_novelty_requested ||
        request.historical_novelty_requested || request.priority_requested ||
        request.claim_ready_requested {
        return PIREUS_ONF_ERR_CLAIM
    }
    if request.waiver_present && (!request.waiver_founder ||
        !request.waiver_scoped || !request.waiver_purpose_bound ||
        !request.waiver_live) {
        return PIREUS_ONF_ERR_WAIVER
    }
    PIREUS_ONF_OK
}

fn onf_is_basis(value: i64) -> bool {
    value == 1 || value == 2 || value == 4 || value == 8
}

fn onf_highest_basis(value: i64) -> i64 with Mut {
    var bit: i64 = 3
    while bit > 0 {
        if (value & (1 << bit)) != 0 { return 1 << bit }
        bit = bit - 1
    }
    1
}

fn onf_gauge_index(vector: i64) -> i64 with Mut {
    var index: i64 = 0
    var value: i64 = 1
    while value < vector {
        if !onf_is_basis(value) { index = index + 1 }
        value = value + 1
    }
    index
}

fn onf_gauge_value(word: i64, vector: i64) -> i64 with Mut {
    if vector == 0 || onf_is_basis(vector) { return 0 }
    (word >> onf_gauge_index(vector)) & 1
}

fn onf_coboundary(word: i64, left: i64, right: i64) -> i64 with Mut {
    onf_gauge_value(word, left) ^ onf_gauge_value(word, right) ^
        onf_gauge_value(word, left ^ right)
}

fn onf_words_zero(words: &[i64; 8]) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_ONF_TABLE_WORDS {
        if words[word] != 0 { return false }
        word = word + 1
    }
    true
}

fn onf_table_bit(words: &[i64; 8], cell: i64) -> i64 with Panic, Div {
    let word = cell / PIREUS_ONF_WORD_BITS
    let bit = cell - word * PIREUS_ONF_WORD_BITS
    (words[word] >> bit) & 1
}

fn onf_pack_table(cells: &[i64; 256]) -> [i64; 8]
with Mut, Panic, Div {
    var words: [i64; 8] = [0; 8]
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        if cells[cell] == 1 {
            let word = cell / PIREUS_ONF_WORD_BITS
            let bit = cell - word * PIREUS_ONF_WORD_BITS
            words[word] = words[word] | (1 << bit)
        }
        cell = cell + 1
    }
    words
}

fn onf_normalize(table: &[i64; 256]) -> OnfNormalization
with Mut, Panic, Div {
    var q: [i64; 16] = [0; 16]
    var gauge_word: i64 = 0
    var vector: i64 = 1
    while vector < PIREUS_ONF_DIMENSION {
        if !onf_is_basis(vector) {
            let edge = onf_highest_basis(vector)
            let parent = vector ^ edge
            q[vector] = table[parent * PIREUS_ONF_DIMENSION + edge] ^
                q[parent]
            if q[vector] != 0 {
                gauge_word = gauge_word |
                    (1 << onf_gauge_index(vector))
            }
        }
        vector = vector + 1
    }

    var words: [i64; 8] = [0; 8]
    var nonzero: i64 = 0
    var left: i64 = 0
    while left < PIREUS_ONF_DIMENSION {
        var right: i64 = 0
        while right < PIREUS_ONF_DIMENSION {
            let cell = left * PIREUS_ONF_DIMENSION + right
            let remainder = table[cell] ^
                q[left] ^ q[right] ^ q[left ^ right]
            if remainder != 0 {
                let word = cell / PIREUS_ONF_WORD_BITS
                let bit = cell - word * PIREUS_ONF_WORD_BITS
                words[word] = words[word] | (1 << bit)
                nonzero = nonzero + 1
            }
            right = right + 1
        }
        left = left + 1
    }
    OnfNormalization {
        words: words,
        gauge_word: gauge_word,
        nonzero_cells: nonzero,
    }
}

fn onf_parity4(value: i64) -> i64 with Mut {
    var parity: i64 = 0
    var bit: i64 = 0
    while bit < 4 {
        if (value & (1 << bit)) != 0 { parity = parity ^ 1 }
        bit = bit + 1
    }
    parity
}

fn onf_matrix_row(code: i64, row: i64) -> i64 {
    (code >> (row * 4)) & 15
}

fn onf_matrix_apply(code: i64, vector: i64) -> i64 with Mut {
    var result: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if onf_parity4(onf_matrix_row(code, row) & vector) == 1 {
            result = result | (1 << row)
        }
        row = row + 1
    }
    result
}

fn onf_matrix_invertible(code: i64) -> bool with Mut, Panic {
    var seen: [bool; 16] = [false; 16]
    var vector: i64 = 0
    while vector < PIREUS_ONF_DIMENSION {
        let image = onf_matrix_apply(code, vector)
        if seen[image] { return false }
        seen[image] = true
        vector = vector + 1
    }
    true
}

fn onf_matrix_compose(left: i64, right: i64) -> i64 with Mut {
    var code: i64 = 0
    var row: i64 = 0
    while row < 4 {
        let selector = onf_matrix_row(left, row)
        var composed_row: i64 = 0
        var source_row: i64 = 0
        while source_row < 4 {
            if (selector & (1 << source_row)) != 0 {
                composed_row = composed_row ^
                    onf_matrix_row(right, source_row)
            }
            source_row = source_row + 1
        }
        code = code | (composed_row << (row * 4))
        row = row + 1
    }
    code
}

fn onf_matrix_inverse(code: i64) -> i64 with Mut {
    var inverse: i64 = 0
    var column: i64 = 0
    while column < 4 {
        let target = 1 << column
        var preimage: i64 = 0
        while preimage < PIREUS_ONF_DIMENSION &&
            onf_matrix_apply(code, preimage) != target {
            preimage = preimage + 1
        }
        var row: i64 = 0
        while row < 4 {
            if (preimage & (1 << row)) != 0 {
                inverse = inverse | (1 << (row * 4 + column))
            }
            row = row + 1
        }
        column = column + 1
    }
    inverse
}

fn onf_action_code(matrix: i64, swap: i64) -> i64 {
    matrix * PIREUS_ONF_SWAP_COUNT + swap
}

fn onf_action_matrix(code: i64) -> i64 with Div {
    code / PIREUS_ONF_SWAP_COUNT
}

fn onf_action_swap(code: i64) -> i64 with Div {
    code - onf_action_matrix(code) * PIREUS_ONF_SWAP_COUNT
}

fn onf_action_table(
    source: &[i64; 256],
    matrix: i64,
    swap: i64,
) -> OnfTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var left: i64 = 0
    while left < PIREUS_ONF_DIMENSION {
        let mapped_left = onf_matrix_apply(matrix, left)
        var right: i64 = 0
        while right < PIREUS_ONF_DIMENSION {
            let mapped_right = onf_matrix_apply(matrix, right)
            let source_cell = if swap == 1 {
                mapped_right * PIREUS_ONF_DIMENSION + mapped_left
            } else {
                mapped_left * PIREUS_ONF_DIMENSION + mapped_right
            }
            cells[left * PIREUS_ONF_DIMENSION + right] = source[source_cell]
            right = right + 1
        }
        left = left + 1
    }
    OnfTable { cells: cells }
}

fn onf_parent_action_admitted(
    parent: &[i64; 256],
    matrix: i64,
    swap: i64,
) -> bool with Mut, Panic, Div {
    if !onf_matrix_invertible(matrix) || swap < 0 || swap >= 2 {
        return false
    }
    let transformed = onf_action_table(parent, matrix, swap)
    var difference: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        difference[cell] = transformed.cells[cell] ^ parent[cell]
        cell = cell + 1
    }
    let normalized = onf_normalize(&difference)
    normalized.nonzero_cells == 0 && onf_words_zero(&normalized.words)
}

pub fn pireus_operator_novelty_cd16_challenge() -> PireusOnfChallenge
with Mut, Panic, Div {
    var cells: [i64; 256] = [0; 256]
    var schedule_cells: [i64; 256] = [0; 256]
    var schedule_seen: [bool; 256] = [false; 256]
    var sign_checks: i64 = 0
    var sign_failures: i64 = 0
    var address_checks: i64 = 0
    var address_failures: i64 = 0
    var positive: i64 = 0
    var negative: i64 = 0
    var left: i64 = 0
    while left < PIREUS_ONF_DIMENSION {
        var right: i64 = 0
        while right < PIREUS_ONF_DIMENSION {
            let coefficient =
                cd_sigma(left as i32, right as i32, PIREUS_ONF_BITS as i32)
                    as i64
            let cell = left * PIREUS_ONF_DIMENSION + right
            sign_checks = sign_checks + 1
            if coefficient == 1 {
                cells[cell] = 0
                positive = positive + 1
            } else if coefficient == -1 {
                cells[cell] = 1
                negative = negative + 1
            } else {
                sign_failures = sign_failures + 1
            }
            right = right + 1
        }
        left = left + 1
    }
    var displacement: i64 = 0
    while displacement < PIREUS_ONF_DIMENSION {
        var source: i64 = 0
        while source < PIREUS_ONF_DIMENSION {
            let partner = source ^ displacement
            let cell = source * PIREUS_ONF_DIMENSION + partner
            let coefficient = cd_sigma(
                source as i32, partner as i32, PIREUS_ONF_BITS as i32) as i64
            var schedule_bit: i64 = 0
            if coefficient == -1 { schedule_bit = 1 }
            else if coefficient != 1 { address_failures = address_failures + 1 }
            schedule_cells[cell] = schedule_bit
            address_checks = address_checks + 1
            if schedule_seen[cell] { address_failures = address_failures + 1 }
            schedule_seen[cell] = true
            address_checks = address_checks + 1
            if (source ^ partner) != displacement {
                address_failures = address_failures + 1
            }
            address_checks = address_checks + 1
            if schedule_cells[cell] != cells[cell] {
                address_failures = address_failures + 1
            }
            source = source + 1
        }
        displacement = displacement + 1
    }
    var recovered_cell: i64 = 0
    while recovered_cell < PIREUS_ONF_CELL_COUNT {
        address_checks = address_checks + 1
        if !schedule_seen[recovered_cell] ||
            schedule_cells[recovered_cell] != cells[recovered_cell] {
            address_failures = address_failures + 1
        }
        recovered_cell = recovered_cell + 1
    }
    let words = onf_pack_table(&cells)
    PireusOnfChallenge {
        kind: PIREUS_ONF_CHALLENGE_CD16,
        producer_language: PIREUS_ONF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
        bits: PIREUS_ONF_BITS,
        dimension: PIREUS_ONF_DIMENSION,
        cell_count: PIREUS_ONF_CELL_COUNT,
        cells: cells,
        table_words: words,
        sign_checks: sign_checks,
        sign_failures: sign_failures,
        address_checks: address_checks,
        address_failures: address_failures,
        positive_cells: positive,
        negative_cells: negative,
        complete: sign_checks == PIREUS_ONF_CELL_COUNT &&
            sign_failures == 0 &&
            address_checks == PIREUS_ONF_CELL_COUNT * 4 &&
            address_failures == 0 &&
            positive + negative == PIREUS_ONF_CELL_COUNT,
    }
}

fn onf_challenge_valid(challenge: &PireusOnfChallenge)
    -> bool with Mut, Panic, Div {
    if challenge.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        challenge.producer_role != PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY ||
        challenge.bits != PIREUS_ONF_BITS ||
        challenge.dimension != PIREUS_ONF_DIMENSION ||
        challenge.cell_count != PIREUS_ONF_CELL_COUNT ||
        !challenge.complete {
        return false
    }
    let packed = onf_pack_table(&challenge.cells)
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        if challenge.cells[cell] < 0 || challenge.cells[cell] > 1 {
            return false
        }
        cell = cell + 1
    }
    var word: i64 = 0
    while word < PIREUS_ONF_TABLE_WORDS {
        if packed[word] != challenge.table_words[word] { return false }
        word = word + 1
    }
    true
}

fn onf_build_lineage(
    quotient: &PireusQuotientResult,
    lowering_valid: bool,
    lowering_live: bool,
    lowering_classes: i64,
    lowering_representatives: &[i64; 48],
    challenge_valid: bool,
    challenge_live: bool,
) -> PireusOnfLineage with Mut, Panic, Div, Epistemic {
    let quotient_live =
        pireus_quotient_novelty_matches_frozen_semantics(quotient)
    let quotient_classes =
        quotient.atlas.class_counts[PIREUS_QUOTIENT_PROFILE_PARENT]
    var checks: i64 = 0
    var failures: i64 = 0
    var class_id: i64 = 0
    while class_id < quotient_classes &&
        class_id < PIREUS_ONF_CLASS_CAPACITY {
        let slot = PIREUS_QUOTIENT_PROFILE_PARENT *
            PIREUS_QUOTIENT_CHILD_COUNT + class_id
        checks = checks + 1
        if quotient.atlas.class_representatives[slot] !=
            lowering_representatives[class_id] {
            failures = failures + 1
        }
        class_id = class_id + 1
    }
    let class_match = quotient_classes == lowering_classes &&
        quotient_classes > 0 && failures == 0
    PireusOnfLineage {
        quotient_source_sha256: onf_quotient_source_hash(),
        quotient_semantics_sha256: onf_quotient_semantics_hash(),
        quotient_freeze_sha256: onf_quotient_freeze_hash(),
        lowering_source_sha256: onf_lowering_source_hash(),
        lowering_semantics_sha256: onf_lowering_semantics_hash(),
        lowering_freeze_sha256: onf_lowering_freeze_hash(),
        challenge_source_sha256: onf_challenge_source_hash(),
        challenge_semantics_sha256: onf_challenge_semantics_hash(),
        challenge_receipt_sha256: onf_challenge_receipt_hash(),
        quotient_live_match: quotient_live,
        lowering_live_match: lowering_live,
        challenge_live_match: challenge_live,
        quotient_valid: quotient.valid,
        lowering_valid: lowering_valid,
        challenge_valid: challenge_valid,
        class_count_match: class_match,
        representative_checks: checks,
        representative_failures: failures,
        complete: quotient.valid && quotient_live && lowering_valid &&
            lowering_live && challenge_valid && challenge_live && class_match &&
            checks == quotient_classes,
    }
}

fn onf_build_normalizer_certificate(
    parent: &PireusQuotientResult,
) -> PireusOnfNormalizerCertificate with Mut, Panic, Div {
    var pivot_checks: i64 = 0
    var pivot_failures: i64 = 0
    var basis: i64 = 0
    while basis < PIREUS_QUOTIENT_GAUGE_BITS {
        var cells: [i64; 256] = [0; 256]
        var left: i64 = 0
        while left < PIREUS_ONF_DIMENSION {
            var right: i64 = 0
            while right < PIREUS_ONF_DIMENSION {
                cells[left * PIREUS_ONF_DIMENSION + right] =
                    onf_coboundary(1 << basis, left, right)
                right = right + 1
            }
            left = left + 1
        }
        let normalized = onf_normalize(&cells)
        var row: i64 = 0
        while row < PIREUS_QUOTIENT_GAUGE_BITS {
            pivot_checks = pivot_checks + 1
            let observed = (normalized.gauge_word >> row) & 1
            let expected = if row == basis { 1 } else { 0 }
            if observed != expected { pivot_failures = pivot_failures + 1 }
            row = row + 1
        }
        basis = basis + 1
    }

    var roundtrip_words: i64 = 0
    var roundtrip_cell_checks: i64 = 0
    var roundtrip_failures: i64 = 0
    var uniqueness_failures: i64 = 0
    var gauge_word: i64 = 0
    while gauge_word < PIREUS_QUOTIENT_GAUGE_WORD_COUNT {
        var cells: [i64; 256] = [0; 256]
        var left: i64 = 0
        while left < PIREUS_ONF_DIMENSION {
            var right: i64 = 0
            while right < PIREUS_ONF_DIMENSION {
                cells[left * PIREUS_ONF_DIMENSION + right] =
                    onf_coboundary(gauge_word, left, right)
                right = right + 1
            }
            left = left + 1
        }
        let normalized = onf_normalize(&cells)
        roundtrip_words = roundtrip_words + 1
        var cell: i64 = 0
        while cell < PIREUS_ONF_CELL_COUNT {
            let cell_left = cell / PIREUS_ONF_DIMENSION
            let cell_right = cell - cell_left * PIREUS_ONF_DIMENSION
            roundtrip_cell_checks = roundtrip_cell_checks + 1
            if cells[cell] != onf_coboundary(
                normalized.gauge_word, cell_left, cell_right) {
                roundtrip_failures = roundtrip_failures + 1
            }
            cell = cell + 1
        }
        if !onf_words_zero(&normalized.words) ||
            normalized.nonzero_cells != 0 {
            roundtrip_failures = roundtrip_failures + 1
        }
        if normalized.gauge_word != gauge_word {
            uniqueness_failures = uniqueness_failures + 1
        }
        gauge_word = gauge_word + 1
    }

    var parent_checks: i64 = 0
    var parent_failures: i64 = 0
    parent_checks = parent_checks + 9
    if parent.normalizer.gauge_bits != PIREUS_QUOTIENT_GAUGE_BITS {
        parent_failures = parent_failures + 1
    }
    if parent.normalizer.canonical_words !=
        PIREUS_QUOTIENT_GAUGE_WORD_COUNT {
        parent_failures = parent_failures + 1
    }
    if parent.normalizer.pivot_checks != pivot_checks {
        parent_failures = parent_failures + 1
    }
    if parent.normalizer.pivot_failures != pivot_failures {
        parent_failures = parent_failures + 1
    }
    if parent.normalizer.roundtrip_words != roundtrip_words {
        parent_failures = parent_failures + 1
    }
    if parent.normalizer.roundtrip_cell_checks != roundtrip_cell_checks {
        parent_failures = parent_failures + 1
    }
    if parent.normalizer.roundtrip_failures != roundtrip_failures {
        parent_failures = parent_failures + 1
    }
    if parent.normalizer.unique_failures != uniqueness_failures {
        parent_failures = parent_failures + 1
    }
    if !parent.normalizer.complete { parent_failures = parent_failures + 1 }

    PireusOnfNormalizerCertificate {
        gauge_bits: PIREUS_QUOTIENT_GAUGE_BITS,
        gauge_words: PIREUS_QUOTIENT_GAUGE_WORD_COUNT,
        pivot_checks: pivot_checks,
        pivot_failures: pivot_failures,
        roundtrip_words: roundtrip_words,
        roundtrip_cell_checks: roundtrip_cell_checks,
        roundtrip_failures: roundtrip_failures,
        uniqueness_failures: uniqueness_failures,
        parent_pivot_checks: parent_checks,
        parent_pivot_failures: parent_failures,
        complete: PIREUS_QUOTIENT_GAUGE_WORD_COUNT ==
                (1 << PIREUS_QUOTIENT_GAUGE_BITS) &&
            pivot_failures == 0 &&
            roundtrip_words == PIREUS_QUOTIENT_GAUGE_WORD_COUNT &&
            roundtrip_failures == 0 && uniqueness_failures == 0 &&
            parent_failures == 0,
    }
}

fn onf_parent_table(parent: &PireusQuotientResult) -> OnfTable
with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        cells[cell] = parent.parent.cells[cell]
        cell = cell + 1
    }
    OnfTable { cells: cells }
}

fn onf_child_table(parent: &PireusQuotientResult, child: i64)
    -> OnfTable with Mut, Panic, Div {
    var cells: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        let word = cell / PIREUS_ONF_WORD_BITS
        let bit = cell - word * PIREUS_ONF_WORD_BITS
        cells[cell] = (parent.atlas.raw_table_words[
            child * PIREUS_ONF_TABLE_WORDS + word] >> bit) & 1
        cell = cell + 1
    }
    OnfTable { cells: cells }
}

fn onf_relation_bit(parent: &PireusQuotientResult, left: i64, right: i64)
    -> i64 with Panic {
    let profile_offset = PIREUS_QUOTIENT_PROFILE_PARENT *
        PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CHILD_COUNT
    parent.atlas.relation_bits[
        profile_offset + left * PIREUS_QUOTIENT_CHILD_COUNT + right]
}

fn onf_relation_holds(
    left: &[i64; 256],
    right: &[i64; 256],
    actions: &PireusOnfActionSet,
) -> bool with Mut, Panic, Div {
    var action: i64 = 0
    while action < actions.admitted_actions {
        let code = actions.action_codes[action]
        let transformed = onf_action_table(
            left, onf_action_matrix(code), onf_action_swap(code))
        var difference: [i64; 256] = [0; 256]
        var cell: i64 = 0
        while cell < PIREUS_ONF_CELL_COUNT {
            difference[cell] = transformed.cells[cell] ^ right[cell]
            cell = cell + 1
        }
        let normalized = onf_normalize(&difference)
        if normalized.nonzero_cells == 0 &&
            onf_words_zero(&normalized.words) {
            return true
        }
        action = action + 1
    }
    false
}

fn onf_build_actions(parent: &PireusQuotientResult)
    -> PireusOnfActionSet with Mut, Panic, Div {
    let base = onf_parent_table(parent)
    var codes: [i64; 40320] = [0; 40320]
    var gauges: [i64; 40320] = [0; 40320]
    var matrix_encodings: i64 = 0
    var invertible: i64 = 0
    var considered: i64 = 0
    var admitted: i64 = 0
    var no_swap: i64 = 0
    var swap_count: i64 = 0
    var identity_present: bool = false
    var cell_checks: i64 = 0
    var replay_failures: i64 = 0
    var matrix: i64 = 0
    while matrix < PIREUS_QUOTIENT_MATRIX_ENCODINGS {
        matrix_encodings = matrix_encodings + 1
        if onf_matrix_invertible(matrix) {
            invertible = invertible + 1
            var swap: i64 = 0
            while swap < PIREUS_ONF_SWAP_COUNT {
                considered = considered + 1
                let transformed = onf_action_table(&base.cells, matrix, swap)
                var difference: [i64; 256] = [0; 256]
                var cell: i64 = 0
                while cell < PIREUS_ONF_CELL_COUNT {
                    difference[cell] = transformed.cells[cell] ^
                        base.cells[cell]
                    cell = cell + 1
                }
                let normalized = onf_normalize(&difference)
                if normalized.nonzero_cells == 0 &&
                    onf_words_zero(&normalized.words) {
                    if admitted < PIREUS_ONF_ACTION_CAPACITY {
                        codes[admitted] = onf_action_code(matrix, swap)
                        gauges[admitted] = normalized.gauge_word
                        admitted = admitted + 1
                    }
                    if swap == 0 { no_swap = no_swap + 1 }
                    else { swap_count = swap_count + 1 }
                    if matrix == PIREUS_QUOTIENT_IDENTITY_MATRIX &&
                        swap == 0 && normalized.gauge_word == 0 {
                        identity_present = true
                    }
                    cell = 0
                    while cell < PIREUS_ONF_CELL_COUNT {
                        let left = cell / PIREUS_ONF_DIMENSION
                        let right = cell - left * PIREUS_ONF_DIMENSION
                        cell_checks = cell_checks + 1
                        if difference[cell] != onf_coboundary(
                            normalized.gauge_word, left, right) {
                            replay_failures = replay_failures + 1
                        }
                        cell = cell + 1
                    }
                }
                swap = swap + 1
            }
        }
        matrix = matrix + 1
    }

    var inverse_checks: i64 = 0
    var inverse_failures: i64 = 0
    var closure_checks: i64 = 0
    var closure_failures: i64 = 0
    var action: i64 = 0
    while action < admitted {
        let code = codes[action]
        let inverse = onf_matrix_inverse(onf_action_matrix(code))
        inverse_checks = inverse_checks + 1
        if !onf_parent_action_admitted(
            &base.cells, inverse, onf_action_swap(code)) {
            inverse_failures = inverse_failures + 1
        }
        var right_action: i64 = 0
        while right_action < admitted {
            let right_code = codes[right_action]
            let composed = onf_matrix_compose(
                onf_action_matrix(code), onf_action_matrix(right_code))
            let composed_swap =
                onf_action_swap(code) ^ onf_action_swap(right_code)
            closure_checks = closure_checks + 1
            if !onf_parent_action_admitted(
                &base.cells, composed, composed_swap) {
                closure_failures = closure_failures + 1
            }
            right_action = right_action + 1
        }
        action = action + 1
    }

    var certificate_checks: i64 = 0
    var certificate_failures: i64 = 0
    certificate_checks = certificate_checks + 14
    if parent.actions.matrix_encodings_scanned != matrix_encodings {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.invertible_matrices != invertible {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.actions_considered != considered {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.admitted_actions != admitted {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.admitted_no_swap != no_swap {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.admitted_swap != swap_count {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.identity_present != identity_present {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.parent_cell_checks != cell_checks {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.parent_replay_failures != replay_failures {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.inverse_checks != inverse_checks {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.inverse_failures != inverse_failures {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.closure_checks != closure_checks {
        certificate_failures = certificate_failures + 1
    }
    if parent.actions.closure_failures != closure_failures {
        certificate_failures = certificate_failures + 1
    }
    if !parent.actions.complete { certificate_failures = certificate_failures + 1 }

    var relation_checks: i64 = 0
    var relation_failures: i64 = 0
    var temporary = PireusOnfActionSet {
        matrix_encodings_scanned: matrix_encodings,
        invertible_matrices: invertible,
        actions_considered: considered,
        admitted_actions: admitted,
        admitted_no_swap: no_swap,
        admitted_swap: swap_count,
        action_codes: codes,
        parent_gauges: gauges,
        identity_present: identity_present,
        parent_cell_checks: cell_checks,
        parent_replay_failures: replay_failures,
        inverse_checks: inverse_checks,
        inverse_failures: inverse_failures,
        closure_checks: closure_checks,
        closure_failures: closure_failures,
        v5_certificate_checks: certificate_checks,
        v5_certificate_failures: certificate_failures,
        v5_relation_checks: 0,
        v5_relation_failures: 0,
        complete: false,
    }
    var left_child: i64 = 0
    while left_child < PIREUS_QUOTIENT_CHILD_COUNT {
        let left_table = onf_child_table(parent, left_child)
        var right_child: i64 = 0
        while right_child < PIREUS_QUOTIENT_CHILD_COUNT {
            let right_table = onf_child_table(parent, right_child)
            let observed = onf_relation_holds(
                &left_table.cells, &right_table.cells, &temporary)
            let expected = onf_relation_bit(parent, left_child, right_child) == 1
            relation_checks = relation_checks + 1
            if observed != expected { relation_failures = relation_failures + 1 }
            right_child = right_child + 1
        }
        left_child = left_child + 1
    }
    temporary.v5_relation_checks = relation_checks
    temporary.v5_relation_failures = relation_failures
    temporary.complete = matrix_encodings == PIREUS_QUOTIENT_MATRIX_ENCODINGS &&
        invertible == PIREUS_QUOTIENT_GL4_COUNT &&
        considered == PIREUS_QUOTIENT_ACTION_COUNT &&
        admitted > 0 && admitted <= PIREUS_ONF_ACTION_CAPACITY &&
        identity_present && replay_failures == 0 &&
        inverse_failures == 0 && closure_failures == 0 &&
        certificate_failures == 0 &&
        relation_checks == PIREUS_QUOTIENT_CHILD_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT && relation_failures == 0
    temporary
}

fn onf_atlas_representative_table(
    atlas: &PireusOnfAtlas,
    class_id: i64,
) -> OnfTable with Mut, Panic, Div {
    var cells: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        let word = cell / PIREUS_ONF_WORD_BITS
        let bit = cell - word * PIREUS_ONF_WORD_BITS
        cells[cell] = (atlas.representative_words[
            class_id * PIREUS_ONF_TABLE_WORDS + word] >> bit) & 1
        cell = cell + 1
    }
    OnfTable { cells: cells }
}

pub fn pireus_operator_novelty_pair_witness(
    challenge: &PireusOnfChallenge,
    actions: &PireusOnfActionSet,
    atlas: &PireusOnfAtlas,
    class_id: i64,
    action_index: i64,
) -> PireusOnfPairWitness with Mut, Panic, Div {
    var residual_words: [i64; 8] = [0; 8]
    var residual_cells: [i64; 256] = [0; 256]
    if class_id < 0 || class_id >= atlas.class_count ||
        action_index < 0 || action_index >= actions.admitted_actions {
        return PireusOnfPairWitness {
            class_id: class_id, representative_child: -1,
            action_index: action_index, action_code: -1,
            matrix_code: -1, swap: -1, parent_gauge: -1,
            challenge_gauge: -1, residual_words: residual_words,
            residual_cells: residual_cells, residual_nonzero_cells: -1,
            replay_checks: 0, replay_failures: 1, valid: false,
        }
    }
    let representative = onf_atlas_representative_table(atlas, class_id)
    let code = actions.action_codes[action_index]
    let matrix = onf_action_matrix(code)
    let swap = onf_action_swap(code)
    let transformed = onf_action_table(&representative.cells, matrix, swap)
    var difference: [i64; 256] = [0; 256]
    var cell: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        difference[cell] = challenge.cells[cell] ^ transformed.cells[cell]
        cell = cell + 1
    }
    let normalized = onf_normalize(&difference)
    residual_words = normalized.words
    cell = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        residual_cells[cell] = onf_table_bit(&normalized.words, cell)
        cell = cell + 1
    }
    var replay_checks: i64 = 0
    var replay_failures: i64 = 0
    cell = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        let left = cell / PIREUS_ONF_DIMENSION
        let right = cell - left * PIREUS_ONF_DIMENSION
        let replay = transformed.cells[cell] ^
            onf_coboundary(normalized.gauge_word, left, right) ^
            residual_cells[cell]
        replay_checks = replay_checks + 1
        if replay != challenge.cells[cell] {
            replay_failures = replay_failures + 1
        }
        cell = cell + 1
    }
    PireusOnfPairWitness {
        class_id: class_id,
        representative_child: atlas.representatives[class_id],
        action_index: action_index,
        action_code: code,
        matrix_code: matrix,
        swap: swap,
        parent_gauge: actions.parent_gauges[action_index],
        challenge_gauge: normalized.gauge_word,
        residual_words: residual_words,
        residual_cells: residual_cells,
        residual_nonzero_cells: normalized.nonzero_cells,
        replay_checks: replay_checks,
        replay_failures: replay_failures,
        valid: replay_checks == PIREUS_ONF_CELL_COUNT &&
            replay_failures == 0,
    }
}

fn onf_words_less(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_ONF_TABLE_WORDS {
        if left[word] < right[word] { return true }
        if left[word] > right[word] { return false }
        word = word + 1
    }
    false
}

fn onf_words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_ONF_TABLE_WORDS {
        if left[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn onf_pair_less(left: &PireusOnfPairWitness, right: &PireusOnfPairWitness)
    -> bool with Mut, Panic {
    if left.residual_nonzero_cells < right.residual_nonzero_cells { return true }
    if left.residual_nonzero_cells > right.residual_nonzero_cells { return false }
    if onf_words_less(&left.residual_words, &right.residual_words) { return true }
    if !onf_words_equal(&left.residual_words, &right.residual_words) {
        return false
    }
    if left.class_id < right.class_id { return true }
    if left.class_id > right.class_id { return false }
    if left.representative_child < right.representative_child { return true }
    if left.representative_child > right.representative_child { return false }
    if left.matrix_code < right.matrix_code { return true }
    if left.matrix_code > right.matrix_code { return false }
    if left.swap < right.swap { return true }
    if left.swap > right.swap { return false }
    left.challenge_gauge < right.challenge_gauge
}

fn onf_digest_pair(state: SHA256State, pair: &PireusOnfPairWitness)
    -> SHA256State with Mut, Panic, Div, Epistemic {
    var next = state
    next = onf_digest_add_i64(next, pair.class_id)
    next = onf_digest_add_i64(next, pair.representative_child)
    next = onf_digest_add_i64(next, pair.action_index)
    next = onf_digest_add_i64(next, pair.action_code)
    next = onf_digest_add_i64(next, pair.parent_gauge)
    next = onf_digest_add_i64(next, pair.challenge_gauge)
    next = onf_digest_add_i64(next, pair.residual_nonzero_cells)
    next = onf_digest_add_words(next, &pair.residual_words)
    next = onf_digest_add_i64(next, pair.replay_checks)
    next = onf_digest_add_i64(next, pair.replay_failures)
    onf_digest_add_bool(next, pair.valid)
}

fn onf_build_atlas(
    parent: &PireusQuotientResult,
    challenge: &PireusOnfChallenge,
    actions: &PireusOnfActionSet,
) -> OnfAtlasWork with Mut, Panic, Div, Epistemic {
    let classes = parent.atlas.class_counts[PIREUS_QUOTIENT_PROFILE_PARENT]
    var representatives: [i64; 48] = [-1; 48]
    var representative_words: [i64; 384] = [0; 384]
    var representative_checks: i64 = 0
    var representative_failures: i64 = 0
    var class_id: i64 = 0
    while class_id < classes && class_id < PIREUS_ONF_CLASS_CAPACITY {
        let slot = PIREUS_QUOTIENT_PROFILE_PARENT *
            PIREUS_QUOTIENT_CHILD_COUNT + class_id
        let child = parent.atlas.class_representatives[slot]
        representatives[class_id] = child
        representative_checks = representative_checks + 1
        if child < 0 || child >= PIREUS_QUOTIENT_CHILD_COUNT {
            representative_failures = representative_failures + 1
        } else {
            var word: i64 = 0
            while word < PIREUS_ONF_TABLE_WORDS {
                representative_words[class_id * PIREUS_ONF_TABLE_WORDS + word] =
                    parent.atlas.raw_table_words[
                        child * PIREUS_ONF_TABLE_WORDS + word]
                word = word + 1
            }
        }
        class_id = class_id + 1
    }

    var atlas = PireusOnfAtlas {
        class_count: classes,
        representatives: representatives,
        representative_words: representative_words,
        representative_checks: representative_checks,
        representative_failures: representative_failures,
        pair_count: 0,
        pair_checks: 0,
        pair_failures: 0,
        nonmembership_checks: 0,
        nonmembership_failures: 0,
        zero_residual_hits: 0,
        best_present: false,
        best_class_id: -1,
        best_representative_child: -1,
        best_action_index: -1,
        best_action_code: -1,
        best_matrix_code: -1,
        best_swap: -1,
        best_parent_gauge: -1,
        best_challenge_gauge: -1,
        best_residual_words: [0; 8],
        best_residual_cells: [0; 256],
        best_residual_nonzero_cells: -1,
        outcome_kind: PIREUS_ONF_OUTCOME_NONE,
        existing_class_bridge: false,
        operator_seed_generated: false,
        exhaustive_separation: false,
        chosen_replay_checks: 0,
        chosen_replay_failures: 0,
        complete: false,
    }
    var state = sha256_init()
    state = onf_digest_add_i64(state, classes)
    class_id = 0
    while class_id < classes {
        state = onf_digest_add_i64(state, representatives[class_id])
        var action: i64 = 0
        while action < actions.admitted_actions {
            let pair = pireus_operator_novelty_pair_witness(
                challenge, actions, &atlas, class_id, action)
            atlas.pair_count = atlas.pair_count + 1
            atlas.pair_checks = atlas.pair_checks + 1
            if !pair.valid { atlas.pair_failures = atlas.pair_failures + 1 }
            atlas.nonmembership_checks = atlas.nonmembership_checks + 1
            if pair.residual_nonzero_cells == 0 {
                atlas.zero_residual_hits = atlas.zero_residual_hits + 1
                atlas.nonmembership_failures =
                    atlas.nonmembership_failures + 1
            }
            if !atlas.best_present {
                atlas.best_present = true
                atlas.best_class_id = pair.class_id
                atlas.best_representative_child = pair.representative_child
                atlas.best_action_index = pair.action_index
                atlas.best_action_code = pair.action_code
                atlas.best_matrix_code = pair.matrix_code
                atlas.best_swap = pair.swap
                atlas.best_parent_gauge = pair.parent_gauge
                atlas.best_challenge_gauge = pair.challenge_gauge
                atlas.best_residual_words = pair.residual_words
                atlas.best_residual_cells = pair.residual_cells
                atlas.best_residual_nonzero_cells = pair.residual_nonzero_cells
                atlas.chosen_replay_checks = pair.replay_checks
                atlas.chosen_replay_failures = pair.replay_failures
            } else {
                var current = PireusOnfPairWitness {
                    class_id: atlas.best_class_id,
                    representative_child: atlas.best_representative_child,
                    action_index: atlas.best_action_index,
                    action_code: atlas.best_action_code,
                    matrix_code: atlas.best_matrix_code,
                    swap: atlas.best_swap,
                    parent_gauge: atlas.best_parent_gauge,
                    challenge_gauge: atlas.best_challenge_gauge,
                    residual_words: atlas.best_residual_words,
                    residual_cells: atlas.best_residual_cells,
                    residual_nonzero_cells: atlas.best_residual_nonzero_cells,
                    replay_checks: atlas.chosen_replay_checks,
                    replay_failures: atlas.chosen_replay_failures,
                    valid: atlas.chosen_replay_failures == 0,
                }
                if onf_pair_less(&pair, &current) {
                    atlas.best_class_id = pair.class_id
                    atlas.best_representative_child = pair.representative_child
                    atlas.best_action_index = pair.action_index
                    atlas.best_action_code = pair.action_code
                    atlas.best_matrix_code = pair.matrix_code
                    atlas.best_swap = pair.swap
                    atlas.best_parent_gauge = pair.parent_gauge
                    atlas.best_challenge_gauge = pair.challenge_gauge
                    atlas.best_residual_words = pair.residual_words
                    atlas.best_residual_cells = pair.residual_cells
                    atlas.best_residual_nonzero_cells = pair.residual_nonzero_cells
                    atlas.chosen_replay_checks = pair.replay_checks
                    atlas.chosen_replay_failures = pair.replay_failures
                }
            }
            state = onf_digest_pair(state, &pair)
            action = action + 1
        }
        class_id = class_id + 1
    }
    atlas.existing_class_bridge = atlas.best_present &&
        atlas.zero_residual_hits > 0 &&
        atlas.best_residual_nonzero_cells == 0
    atlas.operator_seed_generated = atlas.best_present &&
        atlas.zero_residual_hits == 0 &&
        atlas.best_residual_nonzero_cells > 0
    atlas.exhaustive_separation = atlas.operator_seed_generated &&
        atlas.pair_count == classes * actions.admitted_actions &&
        atlas.nonmembership_checks == atlas.pair_count &&
        atlas.nonmembership_failures == 0
    if atlas.existing_class_bridge {
        atlas.outcome_kind = PIREUS_ONF_OUTCOME_EXISTING_CLASS_BRIDGE
    } else if atlas.operator_seed_generated {
        atlas.outcome_kind = PIREUS_ONF_OUTCOME_OPERATOR_SEED
    }
    let exclusive = (atlas.existing_class_bridge &&
        !atlas.operator_seed_generated) ||
        (!atlas.existing_class_bridge && atlas.operator_seed_generated)
    atlas.complete = classes > 0 && classes <= PIREUS_ONF_CLASS_CAPACITY &&
        representative_checks == classes && representative_failures == 0 &&
        atlas.pair_count == classes * actions.admitted_actions &&
        atlas.pair_checks == atlas.pair_count && atlas.pair_failures == 0 &&
        atlas.best_present && exclusive &&
        atlas.chosen_replay_checks == PIREUS_ONF_CELL_COUNT &&
        atlas.chosen_replay_failures == 0
    state = onf_digest_add_i64(state, atlas.pair_count)
    state = onf_digest_add_i64(state, atlas.nonmembership_checks)
    state = onf_digest_add_i64(state, atlas.nonmembership_failures)
    state = onf_digest_add_i64(state, atlas.zero_residual_hits)
    state = onf_digest_add_i64(state, atlas.outcome_kind)
    state = onf_digest_add_i64(state, atlas.best_class_id)
    state = onf_digest_add_i64(state, atlas.best_action_code)
    state = onf_digest_add_i64(state, atlas.best_challenge_gauge)
    state = onf_digest_add_i64(state, atlas.best_residual_nonzero_cells)
    state = onf_digest_add_words(state, &atlas.best_residual_words)
    state = onf_digest_add_bool(state, atlas.complete)
    OnfAtlasWork { atlas: atlas, digest: onf_digest_finish(state) }
}

fn onf_outcome_consistent(atlas: &PireusOnfAtlas) -> bool {
    if atlas.outcome_kind == PIREUS_ONF_OUTCOME_EXISTING_CLASS_BRIDGE {
        return atlas.existing_class_bridge && !atlas.operator_seed_generated &&
            atlas.zero_residual_hits > 0 &&
            atlas.best_residual_nonzero_cells == 0
    }
    if atlas.outcome_kind == PIREUS_ONF_OUTCOME_OPERATOR_SEED {
        return !atlas.existing_class_bridge && atlas.operator_seed_generated &&
            atlas.zero_residual_hits == 0 &&
            atlas.best_residual_nonzero_cells > 0 &&
            atlas.exhaustive_separation
    }
    false
}

fn onf_build_receipt(
    lineage: &PireusOnfLineage,
    challenge: &PireusOnfChallenge,
    normalizer: &PireusOnfNormalizerCertificate,
    actions: &PireusOnfActionSet,
    atlas: &PireusOnfAtlas,
) -> PireusOnfReceipt {
    PireusOnfReceipt {
        schema: PIREUS_ONF_SCHEMA,
        producer_language: PIREUS_ONF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE,
        quotient_lineage_bound: lineage.quotient_live_match,
        lowering_lineage_bound: lineage.lowering_live_match,
        challenge_lineage_bound: lineage.challenge_live_match,
        challenge_complete: challenge.complete,
        action_universe_complete: actions.complete,
        gauge_normalizer_exact: normalizer.complete,
        frozen_q2_replayed: actions.v5_relation_failures == 0,
        outcome_exclusive: onf_outcome_consistent(atlas),
        existing_class_bridge: atlas.existing_class_bridge,
        operator_seed_generated: atlas.operator_seed_generated,
        exhaustive_separation: atlas.exhaustive_separation,
        cellwise_replay_complete: atlas.chosen_replay_failures == 0 &&
            atlas.chosen_replay_checks == PIREUS_ONF_CELL_COUNT,
        target_evidence_used: false,
        material_evidence_used: false,
        target_cost_used: false,
        target_performance_used: false,
        semantics_frozen: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_open: false,
        broad_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        claim_ready: false,
    }
}

fn onf_build_negatives() -> PireusOnfNegatives
with Mut, Panic, Div {
    let good = pireus_operator_novelty_feedback_request()
    var bad = good
    bad.producer_language = PIREUS_ONF_LANGUAGE_PYTHON
    let python = onf_request_error(&bad) == PIREUS_ONF_ERR_AUTHORITY
    bad = good
    bad.producer_language = PIREUS_ONF_LANGUAGE_RUST
    let rust = onf_request_error(&bad) == PIREUS_ONF_ERR_AUTHORITY
    bad = good
    bad.producer_language = PIREUS_ONF_LANGUAGE_CPP
    bad.producer_role = PIREUS_ONF_ROLE_MATERIAL_PARITY
    let cpp = onf_request_error(&bad) == PIREUS_ONF_ERR_AUTHORITY
    bad = good
    bad.producer_language = PIREUS_ONF_LANGUAGE_LLM
    bad.producer_role = PIREUS_ONF_ROLE_REVIEW_ONLY
    let llm = onf_request_error(&bad) == PIREUS_ONF_ERR_AUTHORITY
    bad = good
    bad.policy_present = false
    let missing_policy = onf_request_error(&bad) == PIREUS_ONF_ERR_POLICY
    bad = good
    bad.quotient_parent_present = false
    let missing_q = onf_request_error(&bad) == PIREUS_ONF_ERR_LINEAGE
    bad = good
    bad.lowering_parent_present = false
    let missing_l = onf_request_error(&bad) == PIREUS_ONF_ERR_LINEAGE
    bad = good
    bad.challenge_lineage_present = false
    let missing_c = onf_request_error(&bad) == PIREUS_ONF_ERR_LINEAGE
    bad = good
    bad.quotient_parent_frozen = false
    let unfrozen = onf_request_error(&bad) == PIREUS_ONF_ERR_LINEAGE
    bad = good
    bad.challenge_semantics_bound = false
    let unbound = onf_request_error(&bad) == PIREUS_ONF_ERR_LINEAGE
    bad = good
    bad.declared_action_count = PIREUS_QUOTIENT_ACTION_COUNT - 1
    let universe = onf_request_error(&bad) == PIREUS_ONF_ERR_UNIVERSE
    bad = good
    bad.expected_outcome_present = true
    let injection = onf_request_error(&bad) == PIREUS_ONF_ERR_RESULT_INJECTION
    bad = good
    bad.semantic_write_from_parity = true
    let semantic_write =
        onf_request_error(&bad) == PIREUS_ONF_ERR_RESULT_INJECTION
    bad = good
    bad.expected_result_write_from_parity = true
    let expected_write =
        onf_request_error(&bad) == PIREUS_ONF_ERR_RESULT_INJECTION
    bad = good
    bad.external_review_promoted = true
    let review = onf_request_error(&bad) == PIREUS_ONF_ERR_RESULT_INJECTION
    bad = good
    bad.material_result_present = true
    let material = onf_request_error(&bad) == PIREUS_ONF_ERR_MATERIAL
    bad = good
    bad.target_cost_present = true
    let cost = onf_request_error(&bad) == PIREUS_ONF_ERR_MATERIAL
    bad = good
    bad.target_performance_present = true
    let performance = onf_request_error(&bad) == PIREUS_ONF_ERR_MATERIAL
    bad = good
    bad.broad_novelty_requested = true
    let broad = onf_request_error(&bad) == PIREUS_ONF_ERR_CLAIM
    bad = good
    bad.parity_requested = true
    let parity = onf_request_error(&bad) == PIREUS_ONF_ERR_STAGE
    bad = good
    bad.claim_ready_requested = true
    let claim = onf_request_error(&bad) == PIREUS_ONF_ERR_CLAIM
    bad = good
    bad.waiver_present = true
    let waiver = onf_request_error(&bad) == PIREUS_ONF_ERR_WAIVER

    let challenge = pireus_operator_novelty_cd16_challenge()
    var bad_challenge = challenge
    bad_challenge.cell_count = PIREUS_ONF_CELL_COUNT - 1
    let short = !onf_challenge_valid(&bad_challenge)
    bad_challenge = challenge
    bad_challenge.cells[0] = 2
    let invalid_cell = !onf_challenge_valid(&bad_challenge)

    var synthetic = PireusOnfAtlas {
        class_count: 1, representatives: [0; 48],
        representative_words: [0; 384], representative_checks: 1,
        representative_failures: 0, pair_count: 1, pair_checks: 1,
        pair_failures: 0, nonmembership_checks: 1,
        nonmembership_failures: 1,
        zero_residual_hits: 1, best_present: true,
        best_class_id: 0, best_representative_child: 0,
        best_action_index: 0, best_action_code: 0, best_matrix_code: 0,
        best_swap: 0, best_parent_gauge: 0, best_challenge_gauge: 0,
        best_residual_words: [0; 8], best_residual_cells: [0; 256],
        best_residual_nonzero_cells: 0,
        outcome_kind: PIREUS_ONF_OUTCOME_EXISTING_CLASS_BRIDGE,
        existing_class_bridge: true, operator_seed_generated: false,
        exhaustive_separation: false, chosen_replay_checks: 256,
        chosen_replay_failures: 0, complete: true,
    }
    let exclusive = onf_outcome_consistent(&synthetic)
    synthetic.outcome_kind = PIREUS_ONF_OUTCOME_OPERATOR_SEED
    synthetic.existing_class_bridge = false
    synthetic.operator_seed_generated = true
    synthetic.exhaustive_separation = true
    let zero_seed = !onf_outcome_consistent(&synthetic)
    synthetic.outcome_kind = PIREUS_ONF_OUTCOME_EXISTING_CLASS_BRIDGE
    synthetic.existing_class_bridge = true
    synthetic.operator_seed_generated = false
    synthetic.zero_residual_hits = 0
    synthetic.best_residual_nonzero_cells = 1
    let nonzero_bridge = !onf_outcome_consistent(&synthetic)
    synthetic.zero_residual_hits = 1
    synthetic.best_residual_nonzero_cells = 0
    synthetic.chosen_replay_failures = 1
    let replay_corruption = synthetic.chosen_replay_failures != 0

    let values: [bool; 28] = [
        python, rust, cpp, llm, missing_policy, missing_q, missing_l,
        missing_c, unfrozen, unbound, universe, injection, semantic_write,
        expected_write, review, material, cost, performance, broad, parity,
        claim, waiver, short, invalid_cell, exclusive, zero_seed,
        nonzero_bridge, replay_corruption
    ]
    var passed: i64 = 0
    var index: i64 = 0
    while index < 28 {
        if values[index] { passed = passed + 1 }
        index = index + 1
    }
    PireusOnfNegatives {
        passed: passed, total: 28,
        python_oracle: python, rust_oracle: rust,
        cpp_authority: cpp, llm_authority: llm,
        missing_policy: missing_policy,
        missing_quotient_parent: missing_q,
        missing_lowering_parent: missing_l,
        missing_challenge_lineage: missing_c,
        unfrozen_parent: unfrozen, unbound_parent: unbound,
        wrong_universe: universe, result_injection: injection,
        semantic_write_from_parity: semantic_write,
        expected_write_from_parity: expected_write,
        review_promotion: review, material_promotion: material,
        cost_promotion: cost, performance_promotion: performance,
        broad_novelty_promotion: broad, parity_prefreeze: parity,
        claim_promotion: claim, invalid_waiver: waiver,
        short_challenge: short, invalid_challenge_cell: invalid_cell,
        bridge_seed_exclusive: exclusive, zero_seed_refused: zero_seed,
        nonzero_bridge_refused: nonzero_bridge,
        replay_corruption_refused: replay_corruption,
    }
}

fn onf_digest_lineage(lineage: &PireusOnfLineage) -> PireusOnfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_words(state, &lineage.quotient_source_sha256)
    state = onf_digest_add_words(state, &lineage.quotient_semantics_sha256)
    state = onf_digest_add_words(state, &lineage.quotient_freeze_sha256)
    state = onf_digest_add_words(state, &lineage.lowering_source_sha256)
    state = onf_digest_add_words(state, &lineage.lowering_semantics_sha256)
    state = onf_digest_add_words(state, &lineage.lowering_freeze_sha256)
    state = onf_digest_add_words(state, &lineage.challenge_source_sha256)
    state = onf_digest_add_words(state, &lineage.challenge_semantics_sha256)
    state = onf_digest_add_words(state, &lineage.challenge_receipt_sha256)
    state = onf_digest_add_bool(state, lineage.quotient_live_match)
    state = onf_digest_add_bool(state, lineage.lowering_live_match)
    state = onf_digest_add_bool(state, lineage.challenge_live_match)
    state = onf_digest_add_i64(state, lineage.representative_checks)
    state = onf_digest_add_i64(state, lineage.representative_failures)
    state = onf_digest_add_bool(state, lineage.complete)
    onf_digest_finish(state)
}

fn onf_digest_challenge(challenge: &PireusOnfChallenge) -> PireusOnfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_i64(state, challenge.kind)
    state = onf_digest_add_i64(state, challenge.bits)
    state = onf_digest_add_i64(state, challenge.dimension)
    state = onf_digest_add_i64(state, challenge.cell_count)
    state = onf_digest_add_words(state, &challenge.table_words)
    state = onf_digest_add_i64(state, challenge.sign_checks)
    state = onf_digest_add_i64(state, challenge.sign_failures)
    state = onf_digest_add_i64(state, challenge.address_checks)
    state = onf_digest_add_i64(state, challenge.address_failures)
    state = onf_digest_add_i64(state, challenge.positive_cells)
    state = onf_digest_add_i64(state, challenge.negative_cells)
    state = onf_digest_add_bool(state, challenge.complete)
    onf_digest_finish(state)
}

fn onf_digest_normalizer(certificate: &PireusOnfNormalizerCertificate)
    -> PireusOnfDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_i64(state, certificate.gauge_bits)
    state = onf_digest_add_i64(state, certificate.gauge_words)
    state = onf_digest_add_i64(state, certificate.pivot_checks)
    state = onf_digest_add_i64(state, certificate.pivot_failures)
    state = onf_digest_add_i64(state, certificate.roundtrip_words)
    state = onf_digest_add_i64(state, certificate.roundtrip_cell_checks)
    state = onf_digest_add_i64(state, certificate.roundtrip_failures)
    state = onf_digest_add_i64(state, certificate.uniqueness_failures)
    state = onf_digest_add_i64(state, certificate.parent_pivot_checks)
    state = onf_digest_add_i64(state, certificate.parent_pivot_failures)
    state = onf_digest_add_bool(state, certificate.complete)
    onf_digest_finish(state)
}

fn onf_digest_actions(actions: &PireusOnfActionSet) -> PireusOnfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_i64(state, actions.matrix_encodings_scanned)
    state = onf_digest_add_i64(state, actions.invertible_matrices)
    state = onf_digest_add_i64(state, actions.actions_considered)
    state = onf_digest_add_i64(state, actions.admitted_actions)
    var action: i64 = 0
    while action < actions.admitted_actions {
        state = onf_digest_add_i64(state, actions.action_codes[action])
        state = onf_digest_add_i64(state, actions.parent_gauges[action])
        action = action + 1
    }
    state = onf_digest_add_i64(state, actions.parent_cell_checks)
    state = onf_digest_add_i64(state, actions.parent_replay_failures)
    state = onf_digest_add_i64(state, actions.inverse_checks)
    state = onf_digest_add_i64(state, actions.inverse_failures)
    state = onf_digest_add_i64(state, actions.closure_checks)
    state = onf_digest_add_i64(state, actions.closure_failures)
    state = onf_digest_add_i64(state, actions.v5_relation_checks)
    state = onf_digest_add_i64(state, actions.v5_relation_failures)
    state = onf_digest_add_bool(state, actions.complete)
    onf_digest_finish(state)
}

fn onf_digest_receipt(receipt: &PireusOnfReceipt) -> PireusOnfDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_i64(state, receipt.schema)
    state = onf_digest_add_i64(state, receipt.producer_language)
    state = onf_digest_add_i64(state, receipt.producer_role)
    state = onf_digest_add_i64(state, receipt.stage)
    state = onf_digest_add_bool(state, receipt.quotient_lineage_bound)
    state = onf_digest_add_bool(state, receipt.lowering_lineage_bound)
    state = onf_digest_add_bool(state, receipt.challenge_lineage_bound)
    state = onf_digest_add_bool(state, receipt.challenge_complete)
    state = onf_digest_add_bool(state, receipt.action_universe_complete)
    state = onf_digest_add_bool(state, receipt.gauge_normalizer_exact)
    state = onf_digest_add_bool(state, receipt.frozen_q2_replayed)
    state = onf_digest_add_bool(state, receipt.outcome_exclusive)
    state = onf_digest_add_bool(state, receipt.existing_class_bridge)
    state = onf_digest_add_bool(state, receipt.operator_seed_generated)
    state = onf_digest_add_bool(state, receipt.exhaustive_separation)
    state = onf_digest_add_bool(state, receipt.cellwise_replay_complete)
    state = onf_digest_add_bool(state, receipt.target_evidence_used)
    state = onf_digest_add_bool(state, receipt.material_evidence_used)
    state = onf_digest_add_bool(state, receipt.target_cost_used)
    state = onf_digest_add_bool(state, receipt.target_performance_used)
    state = onf_digest_add_bool(state, receipt.semantics_frozen)
    state = onf_digest_add_bool(state, receipt.formal_parity_open)
    state = onf_digest_add_bool(state, receipt.effect_parity_open)
    state = onf_digest_add_bool(state, receipt.material_parity_open)
    state = onf_digest_add_bool(state, receipt.broad_novelty)
    state = onf_digest_add_bool(state, receipt.historical_novelty)
    state = onf_digest_add_bool(state, receipt.priority_claim)
    state = onf_digest_add_bool(state, receipt.claim_ready)
    onf_digest_finish(state)
}

fn onf_digest_forge(
    lineage: &PireusOnfDigest,
    challenge: &PireusOnfDigest,
    normalizer: &PireusOnfDigest,
    actions: &PireusOnfDigest,
    atlas: &PireusOnfDigest,
    receipt: &PireusOnfDigest,
) -> PireusOnfDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = onf_digest_add_words(state, &lineage.words)
    state = onf_digest_add_words(state, &challenge.words)
    state = onf_digest_add_words(state, &normalizer.words)
    state = onf_digest_add_words(state, &actions.words)
    state = onf_digest_add_words(state, &atlas.words)
    state = onf_digest_add_words(state, &receipt.words)
    onf_digest_finish(state)
}

pub fn pireus_operator_novelty_feedback_evaluate(
    request: &PireusOnfRequest,
    challenge: &PireusOnfChallenge,
) -> PireusOnfResult with Mut, Panic, Div, Epistemic {
    let request_error = onf_request_error(request)
    let quotient_request = pireus_quotient_novelty_request()
    let quotient = pireus_quotient_novelty_evaluate(&quotient_request)
    let lowering_request = pireus_operator_lowering_request()
    let lowering = pireus_operator_lowering_evaluate(&lowering_request)
    let lowering_live =
        pireus_operator_lowering_matches_frozen_semantics(&lowering)
    let challenge_live = onf_challenge_valid(challenge)
    let lineage = onf_build_lineage(
        &quotient, lowering.valid, lowering_live,
        lowering.semantics.operator_classes,
        &lowering.semantics.representatives,
        challenge_live, challenge_live)
    let normalizer = onf_build_normalizer_certificate(&quotient)
    let actions = onf_build_actions(&quotient)
    let atlas_work = onf_build_atlas(&quotient, challenge, &actions)
    let receipt = onf_build_receipt(
        &lineage, challenge, &normalizer, &actions, &atlas_work.atlas)
    let negatives = onf_build_negatives()
    let lineage_digest = onf_digest_lineage(&lineage)
    let challenge_digest = onf_digest_challenge(challenge)
    let normalizer_digest = onf_digest_normalizer(&normalizer)
    let action_digest = onf_digest_actions(&actions)
    let receipt_digest = onf_digest_receipt(&receipt)
    let forge_digest = onf_digest_forge(
        &lineage_digest, &challenge_digest, &normalizer_digest,
        &action_digest, &atlas_work.digest, &receipt_digest)
    var failures: i64 = 0
    if request_error != PIREUS_ONF_OK { failures = failures + 1 }
    if !onf_challenge_valid(challenge) { failures = failures + 1 }
    if !lineage.complete || !normalizer.complete || !actions.complete ||
        !atlas_work.atlas.complete || !onf_outcome_consistent(&atlas_work.atlas) {
        failures = failures + 1
    }
    if negatives.passed != negatives.total { failures = failures + 1 }
    if !receipt.quotient_lineage_bound || !receipt.lowering_lineage_bound ||
        !receipt.challenge_lineage_bound || !receipt.challenge_complete ||
        !receipt.action_universe_complete || !receipt.gauge_normalizer_exact ||
        !receipt.frozen_q2_replayed || !receipt.outcome_exclusive ||
        !receipt.cellwise_replay_complete || receipt.target_evidence_used ||
        receipt.material_evidence_used || receipt.target_cost_used ||
        receipt.target_performance_used || receipt.semantics_frozen ||
        receipt.formal_parity_open || receipt.effect_parity_open ||
        receipt.material_parity_open || receipt.broad_novelty ||
        receipt.historical_novelty || receipt.priority_claim ||
        receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_onf_digest_nonzero(&lineage_digest) ||
        !pireus_onf_digest_nonzero(&challenge_digest) ||
        !pireus_onf_digest_nonzero(&normalizer_digest) ||
        !pireus_onf_digest_nonzero(&action_digest) ||
        !pireus_onf_digest_nonzero(&atlas_work.digest) ||
        !pireus_onf_digest_nonzero(&receipt_digest) ||
        !pireus_onf_digest_nonzero(&forge_digest) {
        failures = failures + 1
    }
    PireusOnfResult {
        valid: failures == 0,
        error: if failures == 0 { PIREUS_ONF_OK }
            else if request_error != PIREUS_ONF_OK { request_error }
            else if !onf_challenge_valid(challenge) {
                PIREUS_ONF_ERR_CHALLENGE
            } else { PIREUS_ONF_ERR_UNIVERSE },
        lineage: lineage,
        challenge: *challenge,
        normalizer: normalizer,
        actions: actions,
        atlas: atlas_work.atlas,
        receipt: receipt,
        negatives: negatives,
        lineage_digest: lineage_digest,
        challenge_digest: challenge_digest,
        normalizer_digest: normalizer_digest,
        action_digest: action_digest,
        atlas_digest: atlas_work.digest,
        receipt_digest: receipt_digest,
        forge_digest: forge_digest,
        failures: failures,
    }
}

fn onf_frozen_words_match(
    actual: &[i64; 8],
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < PIREUS_ONF_TABLE_WORDS {
        if actual[word] != expected[word] { return false }
        word = word + 1
    }
    true
}

/// Exact v7 matcher admitted only after Garden commit 0d725b9574,
/// matcher-free executable commit f4942de085, and first Sounio transcript
/// commit d2391bcc4d existed in that order. It freezes one finite
/// bridge-or-seed decision relative to the hash-bound quotient parents. It
/// requires the broad, historical, priority, material, and claim flags of
/// this receipt to remain false.
pub fn pireus_operator_novelty_feedback_frozen_mismatch_code(
    result: &PireusOnfResult,
) -> i64 with Mut, Panic, Div {
    if !result.valid || result.error != PIREUS_ONF_OK ||
        result.failures != 0 {
        return 1
    }

    if !result.lineage.quotient_live_match ||
        !result.lineage.lowering_live_match ||
        !result.lineage.challenge_live_match ||
        !result.lineage.quotient_valid ||
        !result.lineage.lowering_valid ||
        !result.lineage.challenge_valid ||
        !result.lineage.class_count_match ||
        result.lineage.representative_checks != 14 ||
        result.lineage.representative_failures != 0 ||
        !result.lineage.complete {
        return 2
    }
    let quotient_source: [i64; 8] = [
        2031977940, 3006715988, 3337435950, 1714327305,
        2959051375, 1830667456, 940034161, 1349850727
    ]
    let quotient_semantics: [i64; 8] = [
        2648584313, 916204688, 4134012353, 2327810979,
        49652181, 4207474953, 3818033704, 1054235570
    ]
    let quotient_freeze: [i64; 8] = [
        1678386971, 3189335715, 2571006654, 2413828529,
        354758711, 754662073, 517902849, 470796487
    ]
    let lowering_source: [i64; 8] = [
        394683306, 1690059923, 2331764872, 1948683648,
        2028870998, 3809652185, 1708214027, 3014929120
    ]
    let lowering_semantics: [i64; 8] = [
        3177828824, 2421190335, 2432636158, 1581198181,
        1029067193, 1758657703, 4270782761, 2316052161
    ]
    let lowering_freeze: [i64; 8] = [
        2537382415, 808678264, 3076565528, 1574693257,
        2078114510, 418291233, 660010265, 3521999233
    ]
    let challenge_source: [i64; 8] = [
        1887921306, 1560130586, 2286594466, 3786454603,
        3190629850, 1017367837, 1423292164, 696602331
    ]
    let challenge_semantics: [i64; 8] = [
        2660430422, 3260708681, 2040639532, 2970443065,
        2712563756, 3468927603, 72323475, 251898224
    ]
    let challenge_receipt: [i64; 8] = [
        3673129774, 3862367077, 1855172228, 3345721041,
        2090380021, 2904414310, 1960764027, 2700624710
    ]
    if !onf_frozen_words_match(
            &result.lineage.quotient_source_sha256, &quotient_source) ||
        !onf_frozen_words_match(
            &result.lineage.quotient_semantics_sha256,
            &quotient_semantics) ||
        !onf_frozen_words_match(
            &result.lineage.quotient_freeze_sha256, &quotient_freeze) ||
        !onf_frozen_words_match(
            &result.lineage.lowering_source_sha256, &lowering_source) ||
        !onf_frozen_words_match(
            &result.lineage.lowering_semantics_sha256,
            &lowering_semantics) ||
        !onf_frozen_words_match(
            &result.lineage.lowering_freeze_sha256, &lowering_freeze) ||
        !onf_frozen_words_match(
            &result.lineage.challenge_source_sha256, &challenge_source) ||
        !onf_frozen_words_match(
            &result.lineage.challenge_semantics_sha256,
            &challenge_semantics) ||
        !onf_frozen_words_match(
            &result.lineage.challenge_receipt_sha256, &challenge_receipt) {
        return 2
    }

    let challenge_words: [i64; 8] = [
        2523529216, 1521237190, 2859790366, 3434243800,
        2543059454, 1532116280, 2878009824, 3444336422
    ]
    if result.challenge.kind != PIREUS_ONF_CHALLENGE_CD16 ||
        result.challenge.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        result.challenge.producer_role !=
            PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY ||
        result.challenge.bits != PIREUS_ONF_BITS ||
        result.challenge.dimension != PIREUS_ONF_DIMENSION ||
        result.challenge.cell_count != PIREUS_ONF_CELL_COUNT ||
        result.challenge.positive_cells != 136 ||
        result.challenge.negative_cells != 120 ||
        result.challenge.sign_checks != 256 ||
        result.challenge.sign_failures != 0 ||
        result.challenge.address_checks != 1024 ||
        result.challenge.address_failures != 0 ||
        !result.challenge.complete ||
        !onf_frozen_words_match(
            &result.challenge.table_words, &challenge_words) {
        return 3
    }
    var cell: i64 = 0
    var challenge_negative: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        if result.challenge.cells[cell] !=
            onf_table_bit(&challenge_words, cell) {
            return 3
        }
        challenge_negative = challenge_negative +
            result.challenge.cells[cell]
        cell = cell + 1
    }
    if challenge_negative != 120 ||
        PIREUS_ONF_CELL_COUNT - challenge_negative != 136 {
        return 3
    }

    if result.normalizer.gauge_bits != 11 ||
        result.normalizer.gauge_words != 2048 ||
        result.normalizer.pivot_checks != 121 ||
        result.normalizer.pivot_failures != 0 ||
        result.normalizer.roundtrip_words != 2048 ||
        result.normalizer.roundtrip_cell_checks != 524288 ||
        result.normalizer.roundtrip_failures != 0 ||
        result.normalizer.uniqueness_failures != 0 ||
        result.normalizer.parent_pivot_checks != 9 ||
        result.normalizer.parent_pivot_failures != 0 ||
        !result.normalizer.complete {
        return 4
    }

    let action_codes: [i64; 12] = [
        66690, 66691, 66754, 66755, 67650, 67651,
        67778, 67779, 68674, 68675, 68738, 68739
    ]
    let parent_gauges: [i64; 12] = [
        0, 2027, 1097, 930, 0, 2027, 1290, 737,
        1097, 930, 1290, 737
    ]
    if result.actions.matrix_encodings_scanned != 65536 ||
        result.actions.invertible_matrices != 20160 ||
        result.actions.actions_considered != 40320 ||
        result.actions.admitted_actions != 12 ||
        result.actions.admitted_no_swap != 6 ||
        result.actions.admitted_swap != 6 ||
        !result.actions.identity_present ||
        result.actions.parent_cell_checks != 3072 ||
        result.actions.parent_replay_failures != 0 ||
        result.actions.inverse_checks != 12 ||
        result.actions.inverse_failures != 0 ||
        result.actions.closure_checks != 144 ||
        result.actions.closure_failures != 0 ||
        result.actions.v5_certificate_checks != 14 ||
        result.actions.v5_certificate_failures != 0 ||
        result.actions.v5_relation_checks != 2304 ||
        result.actions.v5_relation_failures != 0 ||
        !result.actions.complete {
        return 5
    }
    var action: i64 = 0
    while action < 12 {
        if result.actions.action_codes[action] != action_codes[action] ||
            result.actions.parent_gauges[action] !=
                parent_gauges[action] {
            return 5
        }
        action = action + 1
    }

    let representatives: [i64; 14] = [
        0, 1, 2, 3, 8, 9, 11, 12, 13, 15, 16, 17, 18, 19
    ]
    if result.atlas.class_count != 14 ||
        result.atlas.representative_checks != 14 ||
        result.atlas.representative_failures != 0 ||
        result.atlas.pair_count != 168 ||
        result.atlas.pair_checks != 168 ||
        result.atlas.pair_failures != 0 ||
        result.atlas.nonmembership_checks != 168 ||
        result.atlas.nonmembership_failures != 0 ||
        result.atlas.zero_residual_hits != 0 ||
        !result.atlas.best_present || !result.atlas.complete {
        return 6
    }
    var class_id: i64 = 0
    while class_id < 14 {
        if result.atlas.representatives[class_id] !=
            representatives[class_id] {
            return 6
        }
        class_id = class_id + 1
    }

    let residual_words: [i64; 8] = [
        0, 0, 1010580540, 4042322160,
        2863311530, 2863311530, 2526451350, 1515870810
    ]
    if result.atlas.outcome_kind != PIREUS_ONF_OUTCOME_OPERATOR_SEED ||
        result.atlas.existing_class_bridge ||
        !result.atlas.operator_seed_generated ||
        !result.atlas.exhaustive_separation ||
        result.atlas.best_class_id != 8 ||
        result.atlas.best_representative_child != 13 ||
        result.atlas.best_action_index != 8 ||
        result.atlas.best_action_code != 68674 ||
        result.atlas.best_matrix_code != 34337 ||
        result.atlas.best_swap != 0 ||
        result.atlas.best_parent_gauge != 1097 ||
        result.atlas.best_challenge_gauge != 1813 ||
        result.atlas.best_residual_nonzero_cells != 96 ||
        result.atlas.chosen_replay_checks != 256 ||
        result.atlas.chosen_replay_failures != 0 ||
        !onf_frozen_words_match(
            &result.atlas.best_residual_words, &residual_words) {
        return 7
    }
    cell = 0
    var residual_nonzero: i64 = 0
    while cell < PIREUS_ONF_CELL_COUNT {
        if result.atlas.best_residual_cells[cell] !=
            onf_table_bit(&residual_words, cell) {
            return 7
        }
        residual_nonzero = residual_nonzero +
            result.atlas.best_residual_cells[cell]
        cell = cell + 1
    }
    if residual_nonzero != 96 { return 7 }

    if result.receipt.schema != PIREUS_ONF_SCHEMA ||
        result.receipt.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        result.receipt.producer_role !=
            PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY ||
        result.receipt.stage != PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE ||
        !result.receipt.quotient_lineage_bound ||
        !result.receipt.lowering_lineage_bound ||
        !result.receipt.challenge_lineage_bound ||
        !result.receipt.challenge_complete ||
        !result.receipt.action_universe_complete ||
        !result.receipt.gauge_normalizer_exact ||
        !result.receipt.frozen_q2_replayed ||
        !result.receipt.outcome_exclusive ||
        result.receipt.existing_class_bridge ||
        !result.receipt.operator_seed_generated ||
        !result.receipt.exhaustive_separation ||
        !result.receipt.cellwise_replay_complete ||
        result.receipt.target_evidence_used ||
        result.receipt.material_evidence_used ||
        result.receipt.target_cost_used ||
        result.receipt.target_performance_used ||
        result.receipt.semantics_frozen ||
        result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open ||
        result.receipt.material_parity_open ||
        result.receipt.broad_novelty ||
        result.receipt.historical_novelty ||
        result.receipt.priority_claim || result.receipt.claim_ready {
        return 8
    }
    if result.negatives.passed != 28 || result.negatives.total != 28 ||
        !result.negatives.python_oracle || !result.negatives.rust_oracle ||
        !result.negatives.cpp_authority || !result.negatives.llm_authority ||
        !result.negatives.missing_policy ||
        !result.negatives.missing_quotient_parent ||
        !result.negatives.missing_lowering_parent ||
        !result.negatives.missing_challenge_lineage ||
        !result.negatives.unfrozen_parent ||
        !result.negatives.unbound_parent ||
        !result.negatives.wrong_universe ||
        !result.negatives.result_injection ||
        !result.negatives.semantic_write_from_parity ||
        !result.negatives.expected_write_from_parity ||
        !result.negatives.review_promotion ||
        !result.negatives.material_promotion ||
        !result.negatives.cost_promotion ||
        !result.negatives.performance_promotion ||
        !result.negatives.broad_novelty_promotion ||
        !result.negatives.parity_prefreeze ||
        !result.negatives.claim_promotion ||
        !result.negatives.invalid_waiver ||
        !result.negatives.short_challenge ||
        !result.negatives.invalid_challenge_cell ||
        !result.negatives.bridge_seed_exclusive ||
        !result.negatives.zero_seed_refused ||
        !result.negatives.nonzero_bridge_refused ||
        !result.negatives.replay_corruption_refused {
        return 8
    }

    let lineage_digest: [i64; 8] = [
        4196448352, 3994589461, 855461767, 2852001139,
        4161600665, 1037453531, 3211070695, 348490507
    ]
    let challenge_digest: [i64; 8] = [
        2147654204, 3866639356, 1146713700, 1451194930,
        2683317223, 4210752596, 2425991083, 1868985711
    ]
    let normalizer_digest: [i64; 8] = [
        1782237024, 2043250808, 625257484, 500507947,
        1333589750, 1453056736, 3715839731, 2017765879
    ]
    let action_digest: [i64; 8] = [
        1734853327, 2139099277, 4139523630, 2160821316,
        3070444380, 516944601, 1583347298, 74640176
    ]
    let atlas_digest: [i64; 8] = [
        2142926888, 2083211840, 3441743308, 2526027326,
        1604660399, 4067631041, 712263639, 2588591335
    ]
    let receipt_digest: [i64; 8] = [
        1884502537, 2310270590, 29882212, 3964671491,
        634098640, 757948081, 761431257, 786011411
    ]
    let forge_digest: [i64; 8] = [
        2024183784, 2544298388, 1593048018, 287379041,
        219866591, 4108390960, 1594301583, 1652437146
    ]
    if !onf_frozen_words_match(
            &result.lineage_digest.words, &lineage_digest) ||
        !onf_frozen_words_match(
            &result.challenge_digest.words, &challenge_digest) ||
        !onf_frozen_words_match(
            &result.normalizer_digest.words, &normalizer_digest) ||
        !onf_frozen_words_match(
            &result.action_digest.words, &action_digest) ||
        !onf_frozen_words_match(
            &result.atlas_digest.words, &atlas_digest) ||
        !onf_frozen_words_match(
            &result.receipt_digest.words, &receipt_digest) ||
        !onf_frozen_words_match(
            &result.forge_digest.words, &forge_digest) {
        return 9
    }
    0
}

pub fn pireus_operator_novelty_feedback_matches_frozen_semantics(
    result: &PireusOnfResult,
) -> bool with Mut, Panic, Div {
    pireus_operator_novelty_feedback_frozen_mismatch_code(result) == 0
}
