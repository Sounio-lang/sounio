fn digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn digest_add_bool(state: SHA256State, value: bool) -> SHA256State
with Mut, Panic, Div {
    digest_add_i64(state, if value { 1 } else { 0 })
}

fn digest_add_digest(state: SHA256State, digest: &BilinearGenesisDigest)
    -> SHA256State with Mut, Panic, Div {
    var next = state
    var word: i64 = 0
    while word < 8 {
        next = digest_add_i64(next, digest.words[word])
        word = word + 1
    }
    next
}

fn digest_finish(state: SHA256State) -> BilinearGenesisDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    BilinearGenesisDigest { words: words }
}

pub fn pireus_bilinear_digest_nonzero(digest: &BilinearGenesisDigest) -> bool
with Mut {
    var word: i64 = 0
    while word < 8 {
        if digest.words[word] != 0 { return true }
        word = word + 1
    }
    false
}

fn parity4(value: i64) -> i64 with Mut {
    var result: i64 = 0
    var bit: i64 = 0
    while bit < 4 {
        if (value & (1 << bit)) != 0 { result = result ^ 1 }
        bit = bit + 1
    }
    result
}

fn highest_basis_bit(value: i64) -> i64 with Mut {
    var selected: i64 = 0
    var bit: i64 = 0
    while bit < 4 {
        let basis = 1 << bit
        if (value & basis) != 0 { selected = basis }
        bit = bit + 1
    }
    selected
}

fn is_basis_vector(value: i64) -> bool {
    value == 1 || value == 2 || value == 4 || value == 8
}

fn matrix_row(code: i64, row: i64) -> i64 {
    (code >> (row * 4)) & 15
}

fn matrix_apply(code: i64, vector: i64) -> i64 with Mut {
    var result: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if parity4(matrix_row(code, row) & vector) == 1 {
            result = result | (1 << row)
        }
        row = row + 1
    }
    result
}

fn matrix_invertible(code: i64) -> bool with Mut, Panic {
    var seen: [bool; 16] = [false; 16]
    var vector: i64 = 0
    while vector < 16 {
        let image = matrix_apply(code, vector)
        if seen[image] { return false }
        seen[image] = true
        vector = vector + 1
    }
    true
}

fn matrix_compose(left: i64, right: i64) -> i64 with Mut {
    var code: i64 = 0
    var row: i64 = 0
    while row < 4 {
        let selector = matrix_row(left, row)
        var composed_row: i64 = 0
        var source_row: i64 = 0
        while source_row < 4 {
            if (selector & (1 << source_row)) != 0 {
                composed_row = composed_row ^ matrix_row(right, source_row)
            }
            source_row = source_row + 1
        }
        code = code | (composed_row << (row * 4))
        row = row + 1
    }
    code
}

fn matrix_inverse(code: i64) -> i64 with Mut {
    var inverse: i64 = 0
    var column: i64 = 0
    while column < 4 {
        let target = 1 << column
        var preimage: i64 = 0
        while preimage < 16 && matrix_apply(code, preimage) != target {
            preimage = preimage + 1
        }
        var row: i64 = 0
        while row < 4 {
            if (preimage & (1 << row)) != 0 {
                inverse = inverse | (1 << (row * 4 + column))
            }
            row = row + 1
        }
        column = column + 1
    }
    inverse
}

fn generator_code(index: i64) -> i64 {
    if index == 0 { return 33810 }
    if index == 1 { return 33345 }
    if index == 2 { return 18465 }
    33827
}

fn build_matrix_universe() -> BilinearMatrixUniverse with Mut, Panic {
    var codes: [i64; 20160] = [0; 20160]
    var count: i64 = 0
    var code: i64 = 0
    var identity_present: bool = false
    var sorted_unique: bool = true
    while code < PIREUS_BILINEAR_MATRIX_ENCODINGS {
        if matrix_invertible(code) {
            if count >= PIREUS_BILINEAR_GL4_COUNT {
                sorted_unique = false
            } else {
                if count > 0 && codes[count - 1] >= code {
                    sorted_unique = false
                }
                codes[count] = code
                if code == 33825 { identity_present = true }
                count = count + 1
            }
        }
        code = code + 1
    }

    var visited: [bool; 65536] = [false; 65536]
    var queue: [i64; 20160] = [0; 20160]
    var head: i64 = 0
    var tail: i64 = 1
    var overflow: bool = false
    var noninvertible: i64 = 0
    queue[0] = 33825
    visited[33825] = true
    while head < tail {
        let current = queue[head]
        var generator: i64 = 0
        while generator < 4 {
            let next = matrix_compose(generator_code(generator), current)
            if !visited[next] {
                if tail >= PIREUS_BILINEAR_GL4_COUNT {
                    overflow = true
                } else {
                    visited[next] = true
                    queue[tail] = next
                    tail = tail + 1
                    if !matrix_invertible(next) {
                        noninvertible = noninvertible + 1
                    }
                }
            }
            generator = generator + 1
        }
        head = head + 1
    }
    var mismatches: i64 = 0
    code = 0
    while code < PIREUS_BILINEAR_MATRIX_ENCODINGS {
        if visited[code] != matrix_invertible(code) {
            mismatches = mismatches + 1
        }
        code = code + 1
    }
    BilinearMatrixUniverse {
        codes: codes,
        encodings_scanned: PIREUS_BILINEAR_MATRIX_ENCODINGS,
        matrix_count: count,
        bfs_count: tail,
        set_mismatches: mismatches,
        bfs_noninvertible: noninvertible,
        bfs_overflow: overflow,
        identity_present: identity_present,
        sorted_unique: sorted_unique,
    }
}

fn group_certificate(universe: &BilinearMatrixUniverse)
    -> BilinearGroupCertificate {
    let complete = universe.encodings_scanned ==
            PIREUS_BILINEAR_MATRIX_ENCODINGS &&
        universe.matrix_count == PIREUS_BILINEAR_GL4_COUNT &&
        universe.bfs_count == PIREUS_BILINEAR_GL4_COUNT &&
        universe.set_mismatches == 0 && universe.bfs_noninvertible == 0 &&
        !universe.bfs_overflow && universe.identity_present &&
        universe.sorted_unique
    BilinearGroupCertificate {
        encodings_scanned: universe.encodings_scanned,
        matrix_count: universe.matrix_count,
        bfs_count: universe.bfs_count,
        set_mismatches: universe.set_mismatches,
        bfs_noninvertible: universe.bfs_noninvertible,
        bfs_overflow: universe.bfs_overflow,
        identity_present: universe.identity_present,
        sorted_unique: universe.sorted_unique,
        operand_orders: PIREUS_BILINEAR_SWAP_COUNT,
        actions_considered: universe.matrix_count * 2,
        complete: complete,
    }
}

fn bilinear_bit(matrix: i64, i: i64, j: i64) -> i64 with Mut {
    parity4(i & matrix_apply(matrix, j))
}

fn base_bit(i: i64, j: i64) -> i64 with Mut, Panic, Div {
    if cd_sigma(i as i32, j as i32, 4) < 0 { 1 } else { 0 }
}

fn base_table() -> BilinearSignTable with Mut, Panic, Div {
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = base_bit(i, j)
            j = j + 1
        }
        i = i + 1
    }
    BilinearSignTable { cells: cells }
}

fn bilinear_table(matrix: i64) -> BilinearSignTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = bilinear_bit(matrix, i, j)
            j = j + 1
        }
        i = i + 1
    }
    BilinearSignTable { cells: cells }
}

fn family_table(base: &BilinearSignTable, matrix: i64)
    -> BilinearSignTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var index: i64 = 0
    while index < 256 {
        let i = index / 16
        let j = index % 16
        cells[index] = base.cells[index] ^ bilinear_bit(matrix, i, j)
        index = index + 1
    }
    BilinearSignTable { cells: cells }
}

fn corpus_table(corpus_id: i64, base: &BilinearSignTable)
    -> BilinearSignTable with Mut, Panic {
    if corpus_id == PIREUS_BILINEAR_CORPUS_CAYLEY_DICKSON_16 {
        return BilinearSignTable { cells: base.cells }
    }
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            if corpus_id == PIREUS_BILINEAR_CORPUS_UNTWISTED_XOR {
                cells[i * 16 + j] = 0
            } else {
                cells[i * 16 + j] = parity4(i & j)
            }
            j = j + 1
        }
        i = i + 1
    }
    BilinearSignTable { cells: cells }
}

fn pair_code_bit(left: i64, right: i64) -> i64 {
    if left == 0 && right == 1 { return 4 }
    if left == 0 && right == 2 { return 5 }
    if left == 0 && right == 3 { return 6 }
    if left == 1 && right == 2 { return 7 }
    if left == 1 && right == 3 { return 8 }
    9
}

fn quadratic_eval(code: i64, vector: i64) -> i64 with Mut {
    var value: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if ((code >> row) & 1) != 0 && (vector & (1 << row)) != 0 {
            value = value ^ 1
        }
        var column: i64 = row + 1
        while column < 4 {
            let coefficient = pair_code_bit(row, column)
            if ((code >> coefficient) & 1) != 0 &&
                (vector & (1 << row)) != 0 &&
                (vector & (1 << column)) != 0 {
                value = value ^ 1
            }
            column = column + 1
        }
        row = row + 1
    }
    value
}

fn quadratic_code_from_values(values: &[i64; 16]) -> i64 with Mut, Panic {
    var code: i64 = 0
    var row: i64 = 0
    while row < 4 {
        let basis = 1 << row
        if values[basis] != 0 { code = code | (1 << row) }
        var column: i64 = row + 1
        while column < 4 {
            let other = 1 << column
            let coefficient = values[basis ^ other] ^
                values[basis] ^ values[other]
            if coefficient != 0 {
                code = code | (1 << pair_code_bit(row, column))
            }
            column = column + 1
        }
        row = row + 1
    }
    code
}

fn quadratic_code_from_matrix(matrix: i64) -> i64 with Mut, Panic {
    var values: [i64; 16] = [0; 16]
    var vector: i64 = 0
    while vector < 16 {
        values[vector] = bilinear_bit(matrix, vector, vector)
        vector = vector + 1
    }
    quadratic_code_from_values(&values)
}

fn quadratic_code_from_table(table: &BilinearSignTable)
    -> i64 with Mut, Panic {
    var values: [i64; 16] = [0; 16]
    var vector: i64 = 0
    while vector < 16 {
        values[vector] = table.cells[vector * 16 + vector]
        vector = vector + 1
    }
    quadratic_code_from_values(&values)
}

fn representative_matrix(code: i64) -> i64 with Mut {
    var matrix: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if ((code >> row) & 1) != 0 {
            matrix = matrix | (1 << (row * 4 + row))
        }
        var column: i64 = row + 1
        while column < 4 {
            if ((code >> pair_code_bit(row, column)) & 1) != 0 {
                matrix = matrix | (1 << (row * 4 + column))
            }
            column = column + 1
        }
        row = row + 1
    }
    matrix
}

fn diagonal_phase_matrix(mask: i64) -> i64 with Mut {
    var matrix: i64 = 0
    var row: i64 = 0
    while row < 4 {
        if (mask & (1 << row)) != 0 {
            matrix = matrix | (1 << (row * 4 + row))
        }
        row = row + 1
    }
    matrix
}

fn quadratic_pullback(code: i64, matrix: i64) -> i64 with Mut, Panic {
    var values: [i64; 16] = [0; 16]
    var vector: i64 = 0
    while vector < 16 {
        values[vector] = quadratic_eval(code, matrix_apply(matrix, vector))
        vector = vector + 1
    }
    quadratic_code_from_values(&values)
}

fn gauge_normalize(table: &BilinearSignTable)
    -> BilinearSignTable with Mut, Panic {
    var q: [i64; 16] = [0; 16]
    var x: i64 = 1
    while x < 16 {
        if !is_basis_vector(x) {
            let edge = highest_basis_bit(x)
            let parent = x ^ edge
            q[x] = table.cells[parent * 16 + edge] ^ q[parent]
        }
        x = x + 1
    }
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            cells[i * 16 + j] = table.cells[i * 16 + j] ^
                q[i] ^ q[j] ^ q[i ^ j]
            j = j + 1
        }
        i = i + 1
    }
    BilinearSignTable { cells: cells }
}

fn zero_count(table: &BilinearSignTable) -> i64 with Mut, Panic {
    var nonzero: i64 = 0
    var index: i64 = 0
    while index < 256 {
        if table.cells[index] != 0 { nonzero = nonzero + 1 }
        index = index + 1
    }
    nonzero
}

fn family_delta(table: &BilinearSignTable)
    -> BilinearFamilyDelta with Mut, Panic {
    let code = quadratic_code_from_table(table)
    let representative = bilinear_table(representative_matrix(code))
    var residual_cells: [i64; 256] = [0; 256]
    var index: i64 = 0
    while index < 256 {
        residual_cells[index] = table.cells[index] ^ representative.cells[index]
        index = index + 1
    }
    let residual = BilinearSignTable { cells: residual_cells }
    let normalized = gauge_normalize(&residual)
    let nonzero = zero_count(&normalized)
    BilinearFamilyDelta {
        valid: nonzero == 0,
        quadratic_code: code,
        normalized_nonzero: nonzero,
    }
}

fn action_displacement(
    base: &BilinearSignTable,
    target: &BilinearSignTable,
    matrix: i64,
    swap: bool,
) -> BilinearSignTable with Mut, Panic {
    var cells: [i64; 256] = [0; 256]
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            let mapped_i = matrix_apply(matrix, i)
            let mapped_j = matrix_apply(matrix, j)
            let transformed = if swap {
                base.cells[mapped_j * 16 + mapped_i]
            } else {
                base.cells[mapped_i * 16 + mapped_j]
            }
            cells[i * 16 + j] = transformed ^ target.cells[i * 16 + j]
            j = j + 1
        }
        i = i + 1
    }
    BilinearSignTable { cells: cells }
}

fn affine_apply(code: i64, matrix: i64, delta: i64)
    -> i64 with Mut, Panic {
    quadratic_pullback(code, matrix) ^ delta
}

fn bilinear_cocycle_failures(matrix: i64) -> i64 with Mut {
    var failures: i64 = 0
    var i: i64 = 0
    while i < 16 {
        var j: i64 = 0
        while j < 16 {
            var k: i64 = 0
            while k < 16 {
                let value = bilinear_bit(matrix, i, j) ^
                    bilinear_bit(matrix, i ^ j, k) ^
                    bilinear_bit(matrix, j, k) ^
                    bilinear_bit(matrix, i, j ^ k)
                if value != 0 { failures = failures + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    failures
}

fn build_grammar_certificate() -> BilinearGrammarCertificate
with Mut, Panic {
    var bucket_counts: [i64; 1024] = [0; 1024]
    var minimum_matrix: [i64; 1024] = [0; 1024]
    var code: i64 = 0
    while code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        minimum_matrix[code] = PIREUS_BILINEAR_RAW_COUNT
        code = code + 1
    }
    var matrix: i64 = 0
    while matrix < PIREUS_BILINEAR_RAW_COUNT {
        let q_code = quadratic_code_from_matrix(matrix)
        bucket_counts[q_code] = bucket_counts[q_code] + 1
        if matrix < minimum_matrix[q_code] {
            minimum_matrix[q_code] = matrix
        }
        matrix = matrix + 1
    }

    var minimum_bucket: i64 = PIREUS_BILINEAR_RAW_COUNT
    var maximum_bucket: i64 = 0
    var bucket_failures: i64 = 0
    var reconstruction_failures: i64 = 0
    var gauge_fiber_failures: i64 = 0
    var cocycle_failures: i64 = 0
    matrix = 0
    while matrix < PIREUS_BILINEAR_RAW_COUNT {
        let table = bilinear_table(matrix)
        let delta = family_delta(&table)
        if !delta.valid || delta.quadratic_code !=
            quadratic_code_from_matrix(matrix) {
            gauge_fiber_failures = gauge_fiber_failures + 1
        }
        matrix = matrix + 1
    }
    code = 0
    while code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        if bucket_counts[code] < minimum_bucket {
            minimum_bucket = bucket_counts[code]
        }
        if bucket_counts[code] > maximum_bucket {
            maximum_bucket = bucket_counts[code]
        }
        if bucket_counts[code] != PIREUS_BILINEAR_BUCKET_SIZE {
            bucket_failures = bucket_failures + 1
        }
        let representative = representative_matrix(code)
        if quadratic_code_from_matrix(representative) != code {
            reconstruction_failures = reconstruction_failures + 1
        }
        cocycle_failures = cocycle_failures +
            bilinear_cocycle_failures(representative)
        code = code + 1
    }
    BilinearGrammarCertificate {
        matrices_scanned: PIREUS_BILINEAR_RAW_COUNT,
        quadratic_codes: PIREUS_BILINEAR_QUADRATIC_COUNT,
        expected_bucket_size: PIREUS_BILINEAR_BUCKET_SIZE,
        minimum_bucket_size: minimum_bucket,
        maximum_bucket_size: maximum_bucket,
        bucket_failures: bucket_failures,
        reconstruction_checks: PIREUS_BILINEAR_QUADRATIC_COUNT,
        reconstruction_failures: reconstruction_failures,
        gauge_fiber_checks: PIREUS_BILINEAR_RAW_COUNT,
        gauge_fiber_failures: gauge_fiber_failures,
        cocycle_checks: PIREUS_BILINEAR_QUADRATIC_COUNT * 4096,
        cocycle_failures: cocycle_failures,
        bucket_counts: bucket_counts,
        minimum_matrix_by_code: minimum_matrix,
        complete: bucket_failures == 0 && reconstruction_failures == 0 &&
            gauge_fiber_failures == 0 && cocycle_failures == 0,
    }
}

fn build_stabilizer(
    base: &BilinearSignTable,
    universe: &BilinearMatrixUniverse,
) -> BilinearStabilizerWork with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, PIREUS_BILINEAR_ACTION_COUNT)
    var admitted: i64 = 0
    var no_swap: i64 = 0
    var with_swap: i64 = 0
    var identity_present: bool = false
    var inverse_checks: i64 = 0
    var inverse_failures: i64 = 0
    var affine_checks: i64 = 0
    var affine_failures: i64 = 0
    var matrix_index: i64 = 0
    while matrix_index < universe.matrix_count {
        let matrix = universe.codes[matrix_index]
        let inverse = matrix_inverse(matrix)
        var swap_index: i64 = 0
        while swap_index < 2 {
            let swap = swap_index == 1
            let displacement = action_displacement(base, base, matrix, swap)
            let delta = family_delta(&displacement)
            if delta.valid {
                admitted = admitted + 1
                if swap { with_swap = with_swap + 1 }
                else { no_swap = no_swap + 1 }
                if matrix == 33825 && !swap && delta.quadratic_code == 0 {
                    identity_present = true
                }
                state = digest_add_i64(state, matrix * 2 + swap_index)
                state = digest_add_i64(state, delta.quadratic_code)
                let inverse_displacement =
                    action_displacement(base, base, inverse, swap)
                let inverse_delta = family_delta(&inverse_displacement)
                inverse_checks = inverse_checks + 1
                if !inverse_delta.valid ||
                    matrix_compose(matrix, inverse) != 33825 ||
                    matrix_compose(inverse, matrix) != 33825 {
                    inverse_failures = inverse_failures + 1
                } else {
                    var q_code: i64 = 0
                    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
                        let forward = affine_apply(
                            q_code, matrix, delta.quadratic_code)
                        let restored = affine_apply(
                            forward, inverse, inverse_delta.quadratic_code)
                        affine_checks = affine_checks + 1
                        if restored != q_code {
                            affine_failures = affine_failures + 1
                        }
                        q_code = q_code + 1
                    }
                }
            }
            swap_index = swap_index + 1
        }
        matrix_index = matrix_index + 1
    }
    state = digest_add_i64(state, admitted)
    state = digest_add_i64(state, no_swap)
    state = digest_add_i64(state, with_swap)
    state = digest_add_bool(state, identity_present)
    state = digest_add_i64(state, inverse_checks)
    state = digest_add_i64(state, inverse_failures)
    state = digest_add_i64(state, affine_checks)
    state = digest_add_i64(state, affine_failures)
    let complete = admitted > 0 && admitted == no_swap + with_swap &&
        identity_present && inverse_checks == admitted &&
        inverse_failures == 0 && affine_checks == admitted * 1024 &&
        affine_failures == 0
    BilinearStabilizerWork {
        certificate: BilinearStabilizerCertificate {
            actions_considered: universe.matrix_count * 2,
            admitted_actions: admitted,
            admitted_no_swap: no_swap,
            admitted_swap: with_swap,
            rejected_actions: universe.matrix_count * 2 - admitted,
            identity_present: identity_present,
            inverse_admission_checks: inverse_checks,
            inverse_admission_failures: inverse_failures,
            affine_inverse_checks: affine_checks,
            affine_inverse_failures: affine_failures,
            complete: complete,
        },
        digest: digest_finish(state),
    }
}

fn structural_signature(table: &BilinearSignTable)
    -> BilinearSignature with Mut, Panic {
    var square_negatives: i64 = 0
    var commutator_defects: i64 = 0
    var associator_defects: i64 = 0
    var i: i64 = 0
    while i < PIREUS_BILINEAR_DIMENSION {
        if table.cells[i * 16 + i] != 0 {
            square_negatives = square_negatives + 1
        }
        var j: i64 = 0
        while j < PIREUS_BILINEAR_DIMENSION {
            if table.cells[i * 16 + j] != table.cells[j * 16 + i] {
                commutator_defects = commutator_defects + 1
            }
            var k: i64 = 0
            while k < PIREUS_BILINEAR_DIMENSION {
                let left = table.cells[i * 16 + j] ^
                    table.cells[(i ^ j) * 16 + k]
                let right = table.cells[j * 16 + k] ^
                    table.cells[i * 16 + (j ^ k)]
                if left != right {
                    associator_defects = associator_defects + 1
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    BilinearSignature {
        square_negatives: square_negatives,
        commutator_defects: commutator_defects,
        associator_defects: associator_defects,
    }
}

fn build_partition(
    base: &BilinearSignTable,
    universe: &BilinearMatrixUniverse,
    grammar: &BilinearGrammarCertificate,
    stabilizer: &BilinearStabilizerCertificate,
) -> BilinearPartitionWork with Mut, Panic, Div, Epistemic {
    var orbit_minimum: [i64; 1024] = [0; 1024]
    var q_code: i64 = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        orbit_minimum[q_code] = q_code
        q_code = q_code + 1
    }

    var equivalence_edges: i64 = 0
    var stabilizer_recount: i64 = 0
    var matrix_index: i64 = 0
    while matrix_index < universe.matrix_count {
        let matrix = universe.codes[matrix_index]
        var swap_index: i64 = 0
        while swap_index < 2 {
            let displacement = action_displacement(
                base, base, matrix, swap_index == 1)
            let delta = family_delta(&displacement)
            if delta.valid {
                stabilizer_recount = stabilizer_recount + 1
                q_code = 0
                while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
                    let image = affine_apply(
                        q_code, matrix, delta.quadratic_code)
                    equivalence_edges = equivalence_edges + 1
                    if image < orbit_minimum[q_code] {
                        orbit_minimum[q_code] = image
                    }
                    q_code = q_code + 1
                }
            }
            swap_index = swap_index + 1
        }
        matrix_index = matrix_index + 1
    }

    var representative_to_class: [i64; 1024] = [-1; 1024]
    var q_class_ids: [i64; 1024] = [-1; 1024]
    var class_representative_q: [i64; 1024] = [-1; 1024]
    var class_minimum_matrix: [i64; 1024] = [65536; 1024]
    var class_quadratic_sizes: [i64; 1024] = [0; 1024]
    var class_raw_sizes: [i64; 1024] = [0; 1024]
    var class_square_negatives: [i64; 1024] = [-1; 1024]
    var class_commutator_defects: [i64; 1024] = [-1; 1024]
    var class_associator_defects: [i64; 1024] = [-1; 1024]
    var class_v1_represented: [bool; 1024] = [false; 1024]
    var class_corpus_masks: [i64; 1024] = [0; 1024]
    var class_count: i64 = 0
    var orbit_failures: i64 = 0
    q_code = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        let representative = orbit_minimum[q_code]
        if representative < 0 || representative >= 1024 ||
            orbit_minimum[representative] != representative {
            orbit_failures = orbit_failures + 1
        }
        if representative == q_code {
            representative_to_class[q_code] = class_count
            class_representative_q[class_count] = q_code
            class_count = class_count + 1
        }
        q_code = q_code + 1
    }

    var quadratic_total: i64 = 0
    var raw_total: i64 = 0
    q_code = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        let class_id = representative_to_class[orbit_minimum[q_code]]
        q_class_ids[q_code] = class_id
        if class_id < 0 || class_id >= class_count {
            orbit_failures = orbit_failures + 1
        } else {
            class_quadratic_sizes[class_id] =
                class_quadratic_sizes[class_id] + 1
            class_raw_sizes[class_id] = class_raw_sizes[class_id] +
                grammar.bucket_counts[q_code]
            if grammar.minimum_matrix_by_code[q_code] <
                class_minimum_matrix[class_id] {
                class_minimum_matrix[class_id] =
                    grammar.minimum_matrix_by_code[q_code]
            }
            quadratic_total = quadratic_total + 1
            raw_total = raw_total + grammar.bucket_counts[q_code]
        }
        q_code = q_code + 1
    }

    let base_signature = structural_signature(base)
    var signature_checks: i64 = 0
    var signature_failures: i64 = 0
    var associator_checks: i64 = 0
    var associator_failures: i64 = 0
    q_code = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        let class_id = q_class_ids[q_code]
        let table = family_table(
            base, grammar.minimum_matrix_by_code[q_code])
        let signature = structural_signature(&table)
        signature_checks = signature_checks + 1
        associator_checks = associator_checks + 1
        if signature.associator_defects != base_signature.associator_defects {
            associator_failures = associator_failures + 1
        }
        if class_square_negatives[class_id] < 0 {
            class_square_negatives[class_id] = signature.square_negatives
            class_commutator_defects[class_id] =
                signature.commutator_defects
            class_associator_defects[class_id] =
                signature.associator_defects
        } else if class_square_negatives[class_id] !=
                signature.square_negatives ||
            class_commutator_defects[class_id] !=
                signature.commutator_defects ||
            class_associator_defects[class_id] !=
                signature.associator_defects {
            signature_failures = signature_failures + 1
        }
        q_code = q_code + 1
    }

    var v1_classes: i64 = 0
    var mask: i64 = 0
    while mask < PIREUS_BILINEAR_V1_COUNT {
        let diagonal_q = quadratic_code_from_matrix(
            diagonal_phase_matrix(mask))
        let class_id = q_class_ids[diagonal_q]
        if !class_v1_represented[class_id] {
            class_v1_represented[class_id] = true
            v1_classes = v1_classes + 1
        }
        mask = mask + 1
    }

    var state = sha256_init()
    state = digest_add_i64(state, class_count)
    q_code = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        state = digest_add_i64(state, q_code)
        state = digest_add_i64(state, q_class_ids[q_code])
        q_code = q_code + 1
    }
    var class_id: i64 = 0
    while class_id < class_count {
        state = digest_add_i64(state, class_representative_q[class_id])
        state = digest_add_i64(state, class_minimum_matrix[class_id])
        state = digest_add_i64(state, class_quadratic_sizes[class_id])
        state = digest_add_i64(state, class_raw_sizes[class_id])
        state = digest_add_i64(state, class_square_negatives[class_id])
        state = digest_add_i64(state, class_commutator_defects[class_id])
        state = digest_add_i64(state, class_associator_defects[class_id])
        state = digest_add_bool(state, class_v1_represented[class_id])
        class_id = class_id + 1
    }
    state = digest_add_i64(state, equivalence_edges)
    state = digest_add_i64(state, stabilizer_recount)
    state = digest_add_i64(state, signature_checks)
    state = digest_add_i64(state, signature_failures)
    state = digest_add_i64(state, associator_checks)
    state = digest_add_i64(state, associator_failures)

    let complete = class_count > 0 && orbit_failures == 0 &&
        quadratic_total == PIREUS_BILINEAR_QUADRATIC_COUNT &&
        raw_total == PIREUS_BILINEAR_RAW_COUNT &&
        equivalence_edges == stabilizer.admitted_actions * 1024 &&
        stabilizer_recount == stabilizer.admitted_actions &&
        signature_checks == PIREUS_BILINEAR_QUADRATIC_COUNT &&
        signature_failures == 0 &&
        associator_checks == PIREUS_BILINEAR_QUADRATIC_COUNT &&
        associator_failures == 0
    BilinearPartitionWork {
        certificate: BilinearClassCertificate {
            class_count: class_count,
            q_class_ids: q_class_ids,
            class_representative_q: class_representative_q,
            class_minimum_matrix: class_minimum_matrix,
            class_quadratic_sizes: class_quadratic_sizes,
            class_raw_sizes: class_raw_sizes,
            class_square_negatives: class_square_negatives,
            class_commutator_defects: class_commutator_defects,
            class_associator_defects: class_associator_defects,
            class_v1_represented: class_v1_represented,
            class_corpus_masks: class_corpus_masks,
            quadratic_total: quadratic_total,
            raw_total: raw_total,
            equivalence_edges: equivalence_edges,
            stabilizer_recount: stabilizer_recount,
            signature_consistency_checks: signature_checks,
            signature_consistency_failures: signature_failures,
            associator_base_checks: associator_checks,
            associator_base_failures: associator_failures,
            v1_classes: v1_classes,
            corpus_incidence_failures: 0,
            complete: complete,
        },
        digest: digest_finish(state),
    }
}

fn build_corpus(
    base: &BilinearSignTable,
    universe: &BilinearMatrixUniverse,
    classes: &BilinearClassCertificate,
) -> BilinearCorpusWork with Mut, Panic, Div, Epistemic {
    var q_masks: [i64; 1024] = [0; 1024]
    var class_masks: [i64; 1024] = [0; 1024]
    var membership_hits: [i64; 3] = [0; 3]
    var incident_quadratic_codes: [i64; 3] = [0; 3]
    var incident_classes: [i64; 3] = [0; 3]
    var square_negatives: [i64; 3] = [0; 3]
    var commutator_defects: [i64; 3] = [0; 3]
    var associator_defects: [i64; 3] = [0; 3]
    var action_checks: i64 = 0
    var corpus_id: i64 = 1
    while corpus_id <= PIREUS_BILINEAR_CORPUS_COUNT {
        let target = corpus_table(corpus_id, base)
        let signature = structural_signature(&target)
        square_negatives[corpus_id - 1] = signature.square_negatives
        commutator_defects[corpus_id - 1] = signature.commutator_defects
        associator_defects[corpus_id - 1] = signature.associator_defects
        var matrix_index: i64 = 0
        while matrix_index < universe.matrix_count {
            let matrix = universe.codes[matrix_index]
            let inverse = matrix_inverse(matrix)
            var swap_index: i64 = 0
            while swap_index < 2 {
                let displacement = action_displacement(
                    base, &target, matrix, swap_index == 1)
                let delta = family_delta(&displacement)
                action_checks = action_checks + 1
                if delta.valid {
                    membership_hits[corpus_id - 1] =
                        membership_hits[corpus_id - 1] + 1
                    let required_q = quadratic_pullback(
                        delta.quadratic_code, inverse)
                    q_masks[required_q] = q_masks[required_q] |
                        (1 << (corpus_id - 1))
                }
                swap_index = swap_index + 1
            }
            matrix_index = matrix_index + 1
        }
        corpus_id = corpus_id + 1
    }

    var q_code: i64 = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        let class_id = classes.q_class_ids[q_code]
        class_masks[class_id] = class_masks[class_id] | q_masks[q_code]
        corpus_id = 1
        while corpus_id <= PIREUS_BILINEAR_CORPUS_COUNT {
            if (q_masks[q_code] & (1 << (corpus_id - 1))) != 0 {
                incident_quadratic_codes[corpus_id - 1] =
                    incident_quadratic_codes[corpus_id - 1] + 1
            }
            corpus_id = corpus_id + 1
        }
        q_code = q_code + 1
    }

    var class_id: i64 = 0
    while class_id < classes.class_count {
        corpus_id = 1
        while corpus_id <= PIREUS_BILINEAR_CORPUS_COUNT {
            if (class_masks[class_id] & (1 << (corpus_id - 1))) != 0 {
                incident_classes[corpus_id - 1] =
                    incident_classes[corpus_id - 1] + 1
            }
            corpus_id = corpus_id + 1
        }
        class_id = class_id + 1
    }

    var incidence_failures: i64 = 0
    q_code = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        if q_masks[q_code] != class_masks[classes.q_class_ids[q_code]] {
            incidence_failures = incidence_failures + 1
        }
        q_code = q_code + 1
    }

    var state = sha256_init()
    state = digest_add_i64(state, action_checks)
    q_code = 0
    while q_code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        state = digest_add_i64(state, q_code)
        state = digest_add_i64(state, q_masks[q_code])
        q_code = q_code + 1
    }
    corpus_id = 1
    while corpus_id <= PIREUS_BILINEAR_CORPUS_COUNT {
        state = digest_add_i64(state, membership_hits[corpus_id - 1])
        state = digest_add_i64(
            state, incident_quadratic_codes[corpus_id - 1])
        state = digest_add_i64(state, incident_classes[corpus_id - 1])
        state = digest_add_i64(state, square_negatives[corpus_id - 1])
        state = digest_add_i64(
            state, commutator_defects[corpus_id - 1])
        state = digest_add_i64(
            state, associator_defects[corpus_id - 1])
        corpus_id = corpus_id + 1
    }
    state = digest_add_i64(state, incidence_failures)
    let complete = action_checks == PIREUS_BILINEAR_CORPUS_COUNT *
        PIREUS_BILINEAR_ACTION_COUNT && incidence_failures == 0
    BilinearCorpusWork {
        certificate: BilinearCorpusCertificate {
            action_checks: action_checks,
            membership_hits: membership_hits,
            incident_quadratic_codes: incident_quadratic_codes,
            incident_classes: incident_classes,
            square_negatives: square_negatives,
            commutator_defects: commutator_defects,
            associator_defects: associator_defects,
            incidence_failures: incidence_failures,
            complete: complete,
        },
        q_masks: q_masks,
        class_masks: class_masks,
        digest: digest_finish(state),
    }
}

fn classes_with_corpus(
    classes: &BilinearClassCertificate,
    corpus: &BilinearCorpusWork,
) -> BilinearClassCertificate {
    BilinearClassCertificate {
        class_count: classes.class_count,
        q_class_ids: classes.q_class_ids,
        class_representative_q: classes.class_representative_q,
        class_minimum_matrix: classes.class_minimum_matrix,
        class_quadratic_sizes: classes.class_quadratic_sizes,
        class_raw_sizes: classes.class_raw_sizes,
        class_square_negatives: classes.class_square_negatives,
        class_commutator_defects: classes.class_commutator_defects,
        class_associator_defects: classes.class_associator_defects,
        class_v1_represented: classes.class_v1_represented,
        class_corpus_masks: corpus.class_masks,
        quadratic_total: classes.quadratic_total,
        raw_total: classes.raw_total,
        equivalence_edges: classes.equivalence_edges,
        stabilizer_recount: classes.stabilizer_recount,
        signature_consistency_checks:
            classes.signature_consistency_checks,
        signature_consistency_failures:
            classes.signature_consistency_failures,
        associator_base_checks: classes.associator_base_checks,
        associator_base_failures: classes.associator_base_failures,
        v1_classes: classes.v1_classes,
        corpus_incidence_failures: corpus.certificate.incidence_failures,
        complete: classes.complete && corpus.certificate.complete &&
            corpus.certificate.incidence_failures == 0,
    }
}

fn absolute_delta(left: i64, right: i64) -> i64 {
    if left >= right { left - right } else { right - left }
}

fn tuple_less(
    assoc_left: i64, comm_left: i64, square_left: i64,
    assoc_right: i64, comm_right: i64, square_right: i64,
) -> bool {
    assoc_left < assoc_right ||
        (assoc_left == assoc_right && comm_left < comm_right) ||
        (assoc_left == assoc_right && comm_left == comm_right &&
            square_left < square_right)
}

fn tuple_greater(
    assoc_left: i64, comm_left: i64, square_left: i64,
    assoc_right: i64, comm_right: i64, square_right: i64,
) -> bool {
    assoc_left > assoc_right ||
        (assoc_left == assoc_right && comm_left > comm_right) ||
        (assoc_left == assoc_right && comm_left == comm_right &&
            square_left > square_right)
}

fn run_search(
    classes: &BilinearClassCertificate,
    corpus: &BilinearCorpusCertificate,
) -> BilinearSearchWork with Mut, Panic, Div, Epistemic {
    var selected_class: i64 = -1
    var selected_corpus: i64 = 0
    var selected_assoc: i64 = -1
    var selected_comm: i64 = -1
    var selected_square: i64 = -1
    var candidates: i64 = 0
    var class_id: i64 = 0
    while class_id < classes.class_count {
        if classes.class_corpus_masks[class_id] == 0 &&
            !classes.class_v1_represented[class_id] {
            candidates = candidates + 1
            var nearest_corpus: i64 = 1
            var nearest_assoc: i64 = 5000
            var nearest_comm: i64 = 5000
            var nearest_square: i64 = 5000
            var corpus_id: i64 = 1
            while corpus_id <= PIREUS_BILINEAR_CORPUS_COUNT {
                let assoc_delta = absolute_delta(
                    classes.class_associator_defects[class_id],
                    corpus.associator_defects[corpus_id - 1])
                let comm_delta = absolute_delta(
                    classes.class_commutator_defects[class_id],
                    corpus.commutator_defects[corpus_id - 1])
                let square_delta = absolute_delta(
                    classes.class_square_negatives[class_id],
                    corpus.square_negatives[corpus_id - 1])
                if tuple_less(
                    assoc_delta, comm_delta, square_delta,
                    nearest_assoc, nearest_comm, nearest_square) {
                    nearest_corpus = corpus_id
                    nearest_assoc = assoc_delta
                    nearest_comm = comm_delta
                    nearest_square = square_delta
                }
                corpus_id = corpus_id + 1
            }
            if selected_class < 0 || tuple_greater(
                    nearest_assoc, nearest_comm, nearest_square,
                    selected_assoc, selected_comm, selected_square) ||
                (nearest_assoc == selected_assoc &&
                    nearest_comm == selected_comm &&
                    nearest_square == selected_square &&
                    classes.class_minimum_matrix[class_id] <
                        classes.class_minimum_matrix[selected_class]) {
                selected_class = class_id
                selected_corpus = nearest_corpus
                selected_assoc = nearest_assoc
                selected_comm = nearest_comm
                selected_square = nearest_square
            }
        }
        class_id = class_id + 1
    }

    let present = selected_class >= 0
    let matrix = if present {
        classes.class_minimum_matrix[selected_class]
    } else { -1 }
    let q_code = if present {
        quadratic_code_from_matrix(matrix)
    } else { -1 }
    let selected = BilinearSelectedOperator {
        present: present,
        class_id: selected_class,
        quadratic_code: q_code,
        bilinear_matrix: matrix,
        class_quadratic_size: if present {
            classes.class_quadratic_sizes[selected_class]
        } else { 0 },
        class_raw_size: if present {
            classes.class_raw_sizes[selected_class]
        } else { 0 },
        square_negatives: if present {
            classes.class_square_negatives[selected_class]
        } else { -1 },
        commutator_defects: if present {
            classes.class_commutator_defects[selected_class]
        } else { -1 },
        associator_defects: if present {
            classes.class_associator_defects[selected_class]
        } else { -1 },
        nearest_corpus_id: selected_corpus,
        associator_delta: selected_assoc,
        commutator_delta: selected_comm,
        square_delta: selected_square,
        represented_in_v1: if present {
            classes.class_v1_represented[selected_class]
        } else { false },
        equivalent_to_corpus: if present {
            classes.class_corpus_masks[selected_class] != 0
        } else { false },
    }

    let component = if selected_assoc != 0 {
        PIREUS_BILINEAR_WITNESS_ASSOCIATOR
    } else if selected_comm != 0 {
        PIREUS_BILINEAR_WITNESS_COMMUTATOR
    } else {
        PIREUS_BILINEAR_WITNESS_SQUARE
    }
    let candidate_value = if component ==
        PIREUS_BILINEAR_WITNESS_ASSOCIATOR {
        selected.associator_defects
    } else if component == PIREUS_BILINEAR_WITNESS_COMMUTATOR {
        selected.commutator_defects
    } else { selected.square_negatives }
    let corpus_value = if component ==
        PIREUS_BILINEAR_WITNESS_ASSOCIATOR {
        corpus.associator_defects[selected_corpus - 1]
    } else if component == PIREUS_BILINEAR_WITNESS_COMMUTATOR {
        corpus.commutator_defects[selected_corpus - 1]
    } else { corpus.square_negatives[selected_corpus - 1] }
    let witness = BilinearStructuralWitness {
        present: present &&
            (selected_assoc != 0 || selected_comm != 0 ||
                selected_square != 0),
        corpus_id: selected_corpus,
        component: component,
        candidate_value: candidate_value,
        corpus_value: corpus_value,
    }

    var search_state = sha256_init()
    search_state = digest_add_i64(search_state, candidates)
    class_id = 0
    while class_id < classes.class_count {
        if classes.class_corpus_masks[class_id] == 0 &&
            !classes.class_v1_represented[class_id] {
            search_state = digest_add_i64(search_state, class_id)
            search_state = digest_add_i64(
                search_state, classes.class_minimum_matrix[class_id])
            search_state = digest_add_i64(
                search_state, classes.class_square_negatives[class_id])
            search_state = digest_add_i64(
                search_state, classes.class_commutator_defects[class_id])
            search_state = digest_add_i64(
                search_state, classes.class_associator_defects[class_id])
        }
        class_id = class_id + 1
    }
    var selected_state = sha256_init()
    selected_state = digest_add_bool(selected_state, selected.present)
    selected_state = digest_add_i64(selected_state, selected.class_id)
    selected_state = digest_add_i64(selected_state, selected.quadratic_code)
    selected_state = digest_add_i64(selected_state, selected.bilinear_matrix)
    selected_state = digest_add_i64(
        selected_state, selected.class_quadratic_size)
    selected_state = digest_add_i64(selected_state, selected.class_raw_size)
    selected_state = digest_add_i64(
        selected_state, selected.square_negatives)
    selected_state = digest_add_i64(
        selected_state, selected.commutator_defects)
    selected_state = digest_add_i64(
        selected_state, selected.associator_defects)
    selected_state = digest_add_i64(
        selected_state, selected.nearest_corpus_id)
    selected_state = digest_add_i64(
        selected_state, selected.associator_delta)
    selected_state = digest_add_i64(selected_state, selected.commutator_delta)
    selected_state = digest_add_i64(selected_state, selected.square_delta)
    selected_state = digest_add_bool(
        selected_state, selected.represented_in_v1)
    selected_state = digest_add_bool(
        selected_state, selected.equivalent_to_corpus)
    selected_state = digest_add_bool(selected_state, witness.present)
    selected_state = digest_add_i64(selected_state, witness.corpus_id)
    selected_state = digest_add_i64(selected_state, witness.component)
    selected_state = digest_add_i64(selected_state, witness.candidate_value)
    selected_state = digest_add_i64(selected_state, witness.corpus_value)
    BilinearSearchWork {
        selected: selected,
        witness: witness,
        search_digest: digest_finish(search_state),
        selected_digest: digest_finish(selected_state),
    }
}

pub fn pireus_operator_genesis_bilinear_request()
    -> BilinearAuthorityRequest {
    BilinearAuthorityRequest {
        producer_language: PIREUS_BILINEAR_LANGUAGE_SOUNIO,
        producer_role: PIREUS_BILINEAR_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_BILINEAR_STAGE_SOUNIO_EXECUTABLE,
        policy_present: true,
        grammar_present: true,
        quotient_present: true,
        stabilizer_present: true,
        corpus_present: true,
        declared_raw_candidates: PIREUS_BILINEAR_RAW_COUNT,
        declared_quadratic_codes: PIREUS_BILINEAR_QUADRATIC_COUNT,
        declared_bucket_size: PIREUS_BILINEAR_BUCKET_SIZE,
        declared_gl4_matrices: PIREUS_BILINEAR_GL4_COUNT,
        declared_actions: PIREUS_BILINEAR_ACTION_COUNT,
        semantics_frozen: false,
        parity_requested: false,
        orbit_hamming_claimed: false,
        algebraic_novelty_requested: false,
        algorithmic_novelty_requested: false,
        material_novelty_requested: false,
        scientific_novelty_requested: false,
        global_novelty_requested: false,
        historical_novelty_requested: false,
        priority_requested: false,
        claim_ready_requested: false,
        external_review_promoted: false,
        fingerprint_only_proof: false,
        waiver_present: false,
        waiver_founder: false,
        waiver_scoped: false,
        waiver_purpose_bound: false,
        waiver_live: false,
    }
}

fn request_error(request: &BilinearAuthorityRequest) -> i64 {
    if request.producer_language != PIREUS_BILINEAR_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_BILINEAR_ROLE_SEMANTIC_AUTHORITY {
        return PIREUS_BILINEAR_ERR_AUTHORITY
    }
    if request.stage != PIREUS_BILINEAR_STAGE_SOUNIO_EXECUTABLE ||
        request.semantics_frozen || request.parity_requested {
        return PIREUS_BILINEAR_ERR_STAGE
    }
    if !request.policy_present { return PIREUS_BILINEAR_ERR_POLICY }
    if !request.grammar_present || !request.quotient_present ||
        !request.stabilizer_present || !request.corpus_present ||
        request.declared_raw_candidates != PIREUS_BILINEAR_RAW_COUNT ||
        request.declared_quadratic_codes !=
            PIREUS_BILINEAR_QUADRATIC_COUNT ||
        request.declared_bucket_size != PIREUS_BILINEAR_BUCKET_SIZE ||
        request.declared_gl4_matrices != PIREUS_BILINEAR_GL4_COUNT ||
        request.declared_actions != PIREUS_BILINEAR_ACTION_COUNT {
        return PIREUS_BILINEAR_ERR_SPACE
    }
    if request.orbit_hamming_claimed ||
        request.algebraic_novelty_requested ||
        request.algorithmic_novelty_requested ||
        request.material_novelty_requested ||
        request.scientific_novelty_requested ||
        request.global_novelty_requested ||
        request.historical_novelty_requested ||
        request.priority_requested || request.claim_ready_requested ||
        request.external_review_promoted || request.fingerprint_only_proof {
        return PIREUS_BILINEAR_ERR_CLAIM_SCOPE
    }
    if request.waiver_present && !(request.waiver_founder &&
        request.waiver_scoped && request.waiver_purpose_bound &&
        request.waiver_live) {
        return PIREUS_BILINEAR_ERR_WAIVER
    }
    PIREUS_BILINEAR_OK
}

fn request_refused(request: &BilinearAuthorityRequest) -> bool {
    request_error(request) != PIREUS_BILINEAR_OK
}

fn exercise_negatives() -> BilinearNegativeCertificate with Mut {
    var request = pireus_operator_genesis_bilinear_request()
    request.producer_language = PIREUS_BILINEAR_LANGUAGE_PYTHON
    request.producer_role = PIREUS_BILINEAR_ROLE_FORBIDDEN_ORACLE
    let python_oracle = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.producer_language = PIREUS_BILINEAR_LANGUAGE_RUST
    request.producer_role = PIREUS_BILINEAR_ROLE_FORBIDDEN_ORACLE
    let rust_oracle = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.producer_language = PIREUS_BILINEAR_LANGUAGE_CPP
    request.producer_role = PIREUS_BILINEAR_ROLE_MATERIAL_PARITY
    let cpp_authority = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.producer_language = PIREUS_BILINEAR_LANGUAGE_LLM
    request.producer_role = PIREUS_BILINEAR_ROLE_REVIEW_ONLY
    let llm_authority = request_refused(&request)

    request = pireus_operator_genesis_bilinear_request()
    request.parity_requested = true
    let parity_prefreeze = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.grammar_present = false
    let incomplete_grammar = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.quotient_present = false
    let incomplete_quotient = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.stabilizer_present = false
    let incomplete_stabilizer = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.corpus_present = false
    let incomplete_corpus = request_refused(&request)

    request = pireus_operator_genesis_bilinear_request()
    request.orbit_hamming_claimed = true
    let orbit_hamming_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.algebraic_novelty_requested = true
    let algebraic_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.algorithmic_novelty_requested = true
    let algorithmic_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.material_novelty_requested = true
    let material_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.scientific_novelty_requested = true
    let scientific_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.global_novelty_requested = true
    let global_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.historical_novelty_requested = true
    let historical_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.priority_requested = true
    let priority_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.claim_ready_requested = true
    let claim_ready_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.external_review_promoted = true
    let review_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.fingerprint_only_proof = true
    let fingerprint_promotion = request_refused(&request)
    request = pireus_operator_genesis_bilinear_request()
    request.waiver_present = true
    let invalid_waiver = request_refused(&request)

    var passed: i64 = 0
    if python_oracle { passed = passed + 1 }
    if rust_oracle { passed = passed + 1 }
    if cpp_authority { passed = passed + 1 }
    if llm_authority { passed = passed + 1 }
    if parity_prefreeze { passed = passed + 1 }
    if incomplete_grammar { passed = passed + 1 }
    if incomplete_quotient { passed = passed + 1 }
    if incomplete_stabilizer { passed = passed + 1 }
    if incomplete_corpus { passed = passed + 1 }
    if orbit_hamming_promotion { passed = passed + 1 }
    if algebraic_promotion { passed = passed + 1 }
    if algorithmic_promotion { passed = passed + 1 }
    if material_promotion { passed = passed + 1 }
    if scientific_promotion { passed = passed + 1 }
    if global_promotion { passed = passed + 1 }
    if historical_promotion { passed = passed + 1 }
    if priority_promotion { passed = passed + 1 }
    if claim_ready_promotion { passed = passed + 1 }
    if review_promotion { passed = passed + 1 }
    if fingerprint_promotion { passed = passed + 1 }
    if invalid_waiver { passed = passed + 1 }
    BilinearNegativeCertificate {
        passed: passed,
        total: 21,
        python_oracle: python_oracle,
        rust_oracle: rust_oracle,
        cpp_authority: cpp_authority,
        llm_authority: llm_authority,
        parity_prefreeze: parity_prefreeze,
        incomplete_grammar: incomplete_grammar,
        incomplete_quotient: incomplete_quotient,
        incomplete_stabilizer: incomplete_stabilizer,
        incomplete_corpus: incomplete_corpus,
        orbit_hamming_promotion: orbit_hamming_promotion,
        algebraic_promotion: algebraic_promotion,
        algorithmic_promotion: algorithmic_promotion,
        material_promotion: material_promotion,
        scientific_promotion: scientific_promotion,
        global_promotion: global_promotion,
        historical_promotion: historical_promotion,
        priority_promotion: priority_promotion,
        claim_ready_promotion: claim_ready_promotion,
        review_promotion: review_promotion,
        fingerprint_promotion: fingerprint_promotion,
        invalid_waiver: invalid_waiver,
    }
}

fn create_receipt(
    request: &BilinearAuthorityRequest,
    grammar: &BilinearGrammarCertificate,
    stabilizer: &BilinearStabilizerCertificate,
    classes: &BilinearClassCertificate,
    corpus: &BilinearCorpusCertificate,
    selected: &BilinearSelectedOperator,
    witness: &BilinearStructuralWitness,
) -> BilinearNoveltyReceipt {
    let exact = grammar.complete && stabilizer.complete &&
        classes.complete && corpus.complete
    let relative = exact && selected.present && witness.present &&
        !selected.equivalent_to_corpus
    let extension = relative && !selected.represented_in_v1
    BilinearNoveltyReceipt {
        schema: PIREUS_BILINEAR_SCHEMA,
        producer_language: request.producer_language,
        producer_role: request.producer_role,
        stage: request.stage,
        expanded_bilinear_grammar_exhausted: grammar.complete,
        bilinear_gauge_quotient_exact: grammar.complete &&
            grammar.quadratic_codes == PIREUS_BILINEAR_QUADRATIC_COUNT,
        declared_family_equivalence_exact: stabilizer.complete &&
            classes.complete,
        corpus_incidence_exact: corpus.complete,
        v1_incidence_exact: classes.v1_classes > 0,
        invariant_signature_verified:
            classes.signature_consistency_failures == 0 &&
            classes.associator_base_failures == 0,
        relative_semantic_novelty: relative,
        relative_grammar_extension_novelty: extension,
        relative_algebraic_novelty: false,
        algebra_isomorphism_complete: false,
        all_sign_tables_exhausted: false,
        base_twist_assumed: true,
        orbit_hamming_distance: false,
        algorithmic_novelty: false,
        material_novelty: false,
        scientific_novelty: false,
        global_novelty: false,
        historical_novelty: false,
        priority_claim: false,
        external_prior_art_complete: false,
        source_hash_bound: false,
        semantics_hash_bound: false,
        receipt_frozen: false,
        receipt_admitted: false,
        formal_parity_open: false,
        effect_parity_open: false,
        material_parity_count: 0,
        parity_open: false,
        claim_ready: false,
    }
}

fn digest_grammar(grammar: &BilinearGrammarCertificate)
    -> BilinearGenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, grammar.matrices_scanned)
    var matrix: i64 = 0
    while matrix < PIREUS_BILINEAR_RAW_COUNT {
        state = digest_add_i64(state, matrix)
        state = digest_add_i64(
            state, quadratic_code_from_matrix(matrix))
        matrix = matrix + 1
    }
    state = digest_add_i64(state, grammar.quadratic_codes)
    state = digest_add_i64(state, grammar.expected_bucket_size)
    state = digest_add_i64(state, grammar.minimum_bucket_size)
    state = digest_add_i64(state, grammar.maximum_bucket_size)
    state = digest_add_i64(state, grammar.bucket_failures)
    state = digest_add_i64(state, grammar.reconstruction_failures)
    state = digest_add_i64(state, grammar.gauge_fiber_checks)
    state = digest_add_i64(state, grammar.gauge_fiber_failures)
    state = digest_add_i64(state, grammar.cocycle_failures)
    state = digest_add_bool(state, grammar.complete)
    digest_finish(state)
}

fn digest_quotient(grammar: &BilinearGrammarCertificate)
    -> BilinearGenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, PIREUS_BILINEAR_GAUGE_COUNT)
    state = digest_add_i64(state, PIREUS_BILINEAR_GAUGE_KERNEL)
    state = digest_add_i64(state, PIREUS_BILINEAR_GAUGE_ACTIONS)
    state = digest_add_i64(state, PIREUS_BILINEAR_QUADRATIC_COUNT)
    var code: i64 = 0
    while code < PIREUS_BILINEAR_QUADRATIC_COUNT {
        state = digest_add_i64(state, code)
        state = digest_add_i64(state, grammar.bucket_counts[code])
        state = digest_add_i64(
            state, grammar.minimum_matrix_by_code[code])
        state = digest_add_i64(state, representative_matrix(code))
        code = code + 1
    }
    digest_finish(state)
}

fn digest_matrix_universe(
    universe: &BilinearMatrixUniverse,
    group: &BilinearGroupCertificate,
) -> BilinearGenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, universe.encodings_scanned)
    state = digest_add_i64(state, universe.matrix_count)
    var index: i64 = 0
    while index < universe.matrix_count {
        state = digest_add_i64(state, universe.codes[index])
        index = index + 1
    }
    state = digest_add_i64(state, group.bfs_count)
    state = digest_add_i64(state, group.set_mismatches)
    state = digest_add_i64(state, group.bfs_noninvertible)
    state = digest_add_bool(state, group.bfs_overflow)
    state = digest_add_bool(state, group.identity_present)
    state = digest_add_bool(state, group.sorted_unique)
    state = digest_add_bool(state, group.complete)
    digest_finish(state)
}

fn digest_final_partition(
    classes: &BilinearClassCertificate,
    initial: &BilinearGenesisDigest,
) -> BilinearGenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_digest(state, initial)
    state = digest_add_i64(state, classes.class_count)
    var class_id: i64 = 0
    while class_id < classes.class_count {
        state = digest_add_i64(state, class_id)
        state = digest_add_i64(
            state, classes.class_corpus_masks[class_id])
        class_id = class_id + 1
    }
    state = digest_add_i64(state, classes.corpus_incidence_failures)
    state = digest_add_bool(state, classes.complete)
    digest_finish(state)
}

fn digest_receipt(
    receipt: &BilinearNoveltyReceipt,
    grammar_digest: &BilinearGenesisDigest,
    quotient_digest: &BilinearGenesisDigest,
    matrix_digest: &BilinearGenesisDigest,
    stabilizer_digest: &BilinearGenesisDigest,
    partition_digest: &BilinearGenesisDigest,
    corpus_digest: &BilinearGenesisDigest,
    search_digest: &BilinearGenesisDigest,
    selected_digest: &BilinearGenesisDigest,
) -> BilinearGenesisDigest with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = digest_add_i64(state, receipt.schema)
    state = digest_add_i64(state, receipt.producer_language)
    state = digest_add_i64(state, receipt.producer_role)
    state = digest_add_i64(state, receipt.stage)
    state = digest_add_bool(
        state, receipt.expanded_bilinear_grammar_exhausted)
    state = digest_add_bool(
        state, receipt.bilinear_gauge_quotient_exact)
    state = digest_add_bool(
        state, receipt.declared_family_equivalence_exact)
    state = digest_add_bool(state, receipt.corpus_incidence_exact)
    state = digest_add_bool(state, receipt.v1_incidence_exact)
    state = digest_add_bool(
        state, receipt.invariant_signature_verified)
    state = digest_add_bool(state, receipt.relative_semantic_novelty)
    state = digest_add_bool(
        state, receipt.relative_grammar_extension_novelty)
    state = digest_add_bool(state, receipt.relative_algebraic_novelty)
    state = digest_add_bool(state, receipt.algebra_isomorphism_complete)
    state = digest_add_bool(state, receipt.all_sign_tables_exhausted)
    state = digest_add_bool(state, receipt.base_twist_assumed)
    state = digest_add_bool(state, receipt.orbit_hamming_distance)
    state = digest_add_bool(state, receipt.algorithmic_novelty)
    state = digest_add_bool(state, receipt.material_novelty)
    state = digest_add_bool(state, receipt.scientific_novelty)
    state = digest_add_bool(state, receipt.global_novelty)
    state = digest_add_bool(state, receipt.historical_novelty)
    state = digest_add_bool(state, receipt.priority_claim)
    state = digest_add_bool(state, receipt.external_prior_art_complete)
    state = digest_add_bool(state, receipt.source_hash_bound)
    state = digest_add_bool(state, receipt.semantics_hash_bound)
    state = digest_add_bool(state, receipt.receipt_frozen)
    state = digest_add_bool(state, receipt.receipt_admitted)
    state = digest_add_bool(state, receipt.formal_parity_open)
    state = digest_add_bool(state, receipt.effect_parity_open)
    state = digest_add_i64(state, receipt.material_parity_count)
    state = digest_add_bool(state, receipt.parity_open)
    state = digest_add_bool(state, receipt.claim_ready)
    state = digest_add_digest(state, grammar_digest)
    state = digest_add_digest(state, quotient_digest)
    state = digest_add_digest(state, matrix_digest)
    state = digest_add_digest(state, stabilizer_digest)
    state = digest_add_digest(state, partition_digest)
    state = digest_add_digest(state, corpus_digest)
    state = digest_add_digest(state, search_digest)
    state = digest_add_digest(state, selected_digest)
    digest_finish(state)
}

pub fn pireus_operator_genesis_bilinear_evaluate(
    request: &BilinearAuthorityRequest,
) -> BilinearGenesisResult with Mut, Panic, Div, Epistemic {
    let error = request_error(request)
    let base = base_table()
    let grammar = build_grammar_certificate()
    let universe = build_matrix_universe()
    let group = group_certificate(&universe)
    let stabilizer_work = build_stabilizer(&base, &universe)
    let partition_work = build_partition(
        &base, &universe, &grammar, &stabilizer_work.certificate)
    let corpus_work = build_corpus(
        &base, &universe, &partition_work.certificate)
    let classes = classes_with_corpus(
        &partition_work.certificate, &corpus_work)
    let search = run_search(&classes, &corpus_work.certificate)
    let negatives = exercise_negatives()
    let receipt = create_receipt(
        request, &grammar, &stabilizer_work.certificate, &classes,
        &corpus_work.certificate, &search.selected, &search.witness)

    let grammar_digest = digest_grammar(&grammar)
    let quotient_digest = digest_quotient(&grammar)
    let matrix_digest = digest_matrix_universe(&universe, &group)
    let partition_digest = digest_final_partition(
        &classes, &partition_work.digest)
    let receipt_digest = digest_receipt(
        &receipt, &grammar_digest, &quotient_digest, &matrix_digest,
        &stabilizer_work.digest, &partition_digest, &corpus_work.digest,
        &search.search_digest, &search.selected_digest)

    var failures: i64 = 0
    if error != PIREUS_BILINEAR_OK { failures = failures + 1 }
    if !grammar.complete || !group.complete ||
        !stabilizer_work.certificate.complete || !classes.complete ||
        !corpus_work.certificate.complete {
        failures = failures + 1
    }
    if !search.selected.present || search.selected.equivalent_to_corpus ||
        search.selected.represented_in_v1 || !search.witness.present {
        failures = failures + 1
    }
    if negatives.passed != negatives.total { failures = failures + 1 }
    if !receipt.expanded_bilinear_grammar_exhausted ||
        !receipt.bilinear_gauge_quotient_exact ||
        !receipt.declared_family_equivalence_exact ||
        !receipt.corpus_incidence_exact || !receipt.v1_incidence_exact ||
        !receipt.invariant_signature_verified ||
        !receipt.relative_semantic_novelty ||
        !receipt.relative_grammar_extension_novelty ||
        receipt.relative_algebraic_novelty ||
        receipt.algebra_isomorphism_complete ||
        receipt.all_sign_tables_exhausted ||
        !receipt.base_twist_assumed || receipt.orbit_hamming_distance ||
        receipt.algorithmic_novelty || receipt.material_novelty ||
        receipt.scientific_novelty || receipt.global_novelty ||
        receipt.historical_novelty || receipt.priority_claim ||
        receipt.external_prior_art_complete || receipt.source_hash_bound ||
        receipt.semantics_hash_bound || receipt.receipt_frozen ||
        receipt.receipt_admitted || receipt.formal_parity_open ||
        receipt.effect_parity_open || receipt.material_parity_count != 0 ||
        receipt.parity_open || receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_bilinear_digest_nonzero(&grammar_digest) ||
        !pireus_bilinear_digest_nonzero(&quotient_digest) ||
        !pireus_bilinear_digest_nonzero(&matrix_digest) ||
        !pireus_bilinear_digest_nonzero(&stabilizer_work.digest) ||
        !pireus_bilinear_digest_nonzero(&partition_digest) ||
        !pireus_bilinear_digest_nonzero(&corpus_work.digest) ||
        !pireus_bilinear_digest_nonzero(&search.search_digest) ||
        !pireus_bilinear_digest_nonzero(&search.selected_digest) ||
        !pireus_bilinear_digest_nonzero(&receipt_digest) {
        failures = failures + 1
    }
    BilinearGenesisResult {
        valid: failures == 0,
        error: error,
        grammar: grammar,
        group: group,
        stabilizer: stabilizer_work.certificate,
        classes: classes,
        corpus: corpus_work.certificate,
        selected: search.selected,
        witness: search.witness,
        receipt: receipt,
        negatives: negatives,
        grammar_digest: grammar_digest,
        quotient_digest: quotient_digest,
        matrix_digest: matrix_digest,
        stabilizer_digest: stabilizer_work.digest,
        partition_digest: partition_digest,
        corpus_digest: corpus_work.digest,
        search_digest: search.search_digest,
        selected_digest: search.selected_digest,
        receipt_digest: receipt_digest,
        failures: failures,
    }
}

fn bilinear_digest_matches(
    digest: &BilinearGenesisDigest,
    expected: &[i64; 8],
) -> bool with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if digest.words[word] != expected[word] { return false }
        word = word + 1
    }
    true
}

/// Exact v2 result admitted only after commit 34619031a9 existed and Sounio
/// produced the first matcher-free transcript.
pub fn pireus_operator_genesis_bilinear_frozen_mismatch_code(
    result: &BilinearGenesisResult,
) -> i64 with Mut, Panic {
    if !result.valid || result.error != PIREUS_BILINEAR_OK ||
        result.failures != 0 || !result.grammar.complete ||
        result.grammar.matrices_scanned != 65536 ||
        result.grammar.quadratic_codes != 1024 ||
        result.grammar.expected_bucket_size != 64 ||
        result.grammar.minimum_bucket_size != 64 ||
        result.grammar.maximum_bucket_size != 64 ||
        result.grammar.bucket_failures != 0 ||
        result.grammar.reconstruction_checks != 1024 ||
        result.grammar.reconstruction_failures != 0 ||
        result.grammar.gauge_fiber_checks != 65536 ||
        result.grammar.gauge_fiber_failures != 0 ||
        result.grammar.cocycle_checks != 4194304 ||
        result.grammar.cocycle_failures != 0 {
        return 1
    }
    if !result.group.complete || result.group.encodings_scanned != 65536 ||
        result.group.matrix_count != 20160 ||
        result.group.bfs_count != 20160 || result.group.set_mismatches != 0 ||
        result.group.bfs_noninvertible != 0 || result.group.bfs_overflow ||
        !result.group.identity_present || !result.group.sorted_unique ||
        result.group.operand_orders != 2 ||
        result.group.actions_considered != 40320 {
        return 2
    }
    if !result.stabilizer.complete ||
        result.stabilizer.actions_considered != 40320 ||
        result.stabilizer.admitted_actions != 336 ||
        result.stabilizer.admitted_no_swap != 168 ||
        result.stabilizer.admitted_swap != 168 ||
        result.stabilizer.rejected_actions != 39984 ||
        !result.stabilizer.identity_present ||
        result.stabilizer.inverse_admission_checks != 336 ||
        result.stabilizer.inverse_admission_failures != 0 ||
        result.stabilizer.affine_inverse_checks != 344064 ||
        result.stabilizer.affine_inverse_failures != 0 {
        return 3
    }
    if !result.classes.complete || result.classes.class_count != 32 ||
        result.classes.quadratic_total != 1024 ||
        result.classes.raw_total != 65536 ||
        result.classes.equivalence_edges != 344064 ||
        result.classes.stabilizer_recount != 336 ||
        result.classes.signature_consistency_checks != 1024 ||
        result.classes.signature_consistency_failures != 0 ||
        result.classes.associator_base_checks != 1024 ||
        result.classes.associator_base_failures != 0 ||
        result.classes.v1_classes != 4 ||
        result.classes.corpus_incidence_failures != 0 {
        return 4
    }

    let representatives: [i64; 32] = [
        0, 1, 8, 9, 16, 19, 20, 24,
        27, 28, 64, 65, 66, 72, 73, 74,
        80, 82, 83, 84, 88, 90, 91, 92,
        192, 193, 198, 199, 200, 201, 206, 207
    ]
    let minimum_matrices: [i64; 32] = [
        0, 1, 32768, 32769, 2, 35, 36, 32770,
        32803, 32804, 8, 9, 40, 32776, 32777, 32808,
        10, 42, 43, 44, 32778, 32810, 32811, 32812,
        72, 73, 1128, 1129, 32840, 32841, 33896, 33897
    ]
    let quadratic_sizes: [i64; 32] = [
        1, 7, 1, 7, 21, 7, 28, 21,
        7, 28, 7, 7, 42, 7, 7, 42,
        42, 21, 21, 84, 42, 21, 21, 84,
        84, 84, 28, 28, 84, 84, 28, 28
    ]
    let square_negatives: [i64; 32] = [
        15, 7, 7, 7, 11, 3, 7, 7,
        7, 7, 11, 11, 7, 11, 3, 7,
        11, 7, 7, 7, 7, 11, 3, 7,
        9, 9, 5, 5, 9, 5, 5, 9
    ]
    let commutator_defects: [i64; 32] = [
        210, 210, 210, 210,
        114, 114, 114, 114, 114, 114, 114, 114,
        114, 114, 114, 114, 114, 114, 114, 114,
        114, 114, 114, 114,
        90, 90, 90, 90, 90, 90, 90, 90
    ]
    var class_id: i64 = 0
    while class_id < 32 {
        if result.classes.class_representative_q[class_id] !=
                representatives[class_id] ||
            result.classes.class_minimum_matrix[class_id] !=
                minimum_matrices[class_id] ||
            result.classes.class_quadratic_sizes[class_id] !=
                quadratic_sizes[class_id] ||
            result.classes.class_raw_sizes[class_id] !=
                quadratic_sizes[class_id] * 64 ||
            result.classes.class_square_negatives[class_id] !=
                square_negatives[class_id] ||
            result.classes.class_commutator_defects[class_id] !=
                commutator_defects[class_id] ||
            result.classes.class_associator_defects[class_id] != 1848 ||
            result.classes.class_v1_represented[class_id] != (class_id < 4) ||
            result.classes.class_corpus_masks[class_id] !=
                (if class_id == 0 { 2 } else { 0 }) {
            return 5
        }
        class_id = class_id + 1
    }

    if !result.corpus.complete || result.corpus.action_checks != 120960 ||
        result.corpus.membership_hits[0] != 0 ||
        result.corpus.membership_hits[1] != 336 ||
        result.corpus.membership_hits[2] != 0 ||
        result.corpus.incident_quadratic_codes[0] != 0 ||
        result.corpus.incident_quadratic_codes[1] != 1 ||
        result.corpus.incident_quadratic_codes[2] != 0 ||
        result.corpus.incident_classes[0] != 0 ||
        result.corpus.incident_classes[1] != 1 ||
        result.corpus.incident_classes[2] != 0 ||
        result.corpus.square_negatives[0] != 0 ||
        result.corpus.square_negatives[1] != 15 ||
        result.corpus.square_negatives[2] != 8 ||
        result.corpus.commutator_defects[0] != 0 ||
        result.corpus.commutator_defects[1] != 210 ||
        result.corpus.commutator_defects[2] != 0 ||
        result.corpus.associator_defects[0] != 0 ||
        result.corpus.associator_defects[1] != 1848 ||
        result.corpus.associator_defects[2] != 0 ||
        result.corpus.incidence_failures != 0 {
        return 6
    }
    if !result.selected.present || result.selected.class_id != 26 ||
        result.selected.quadratic_code != 198 ||
        result.selected.bilinear_matrix != 1128 ||
        result.selected.class_quadratic_size != 28 ||
        result.selected.class_raw_size != 1792 ||
        result.selected.square_negatives != 5 ||
        result.selected.commutator_defects != 90 ||
        result.selected.associator_defects != 1848 ||
        result.selected.nearest_corpus_id != 2 ||
        result.selected.associator_delta != 0 ||
        result.selected.commutator_delta != 120 ||
        result.selected.square_delta != 10 ||
        result.selected.represented_in_v1 ||
        result.selected.equivalent_to_corpus {
        return 7
    }
    if !result.witness.present || result.witness.corpus_id != 2 ||
        result.witness.component != PIREUS_BILINEAR_WITNESS_COMMUTATOR ||
        result.witness.candidate_value != 90 ||
        result.witness.corpus_value != 210 {
        return 8
    }
    if result.negatives.passed != 21 || result.negatives.total != 21 ||
        !result.receipt.expanded_bilinear_grammar_exhausted ||
        !result.receipt.bilinear_gauge_quotient_exact ||
        !result.receipt.declared_family_equivalence_exact ||
        !result.receipt.corpus_incidence_exact ||
        !result.receipt.v1_incidence_exact ||
        !result.receipt.invariant_signature_verified ||
        !result.receipt.relative_semantic_novelty ||
        !result.receipt.relative_grammar_extension_novelty ||
        result.receipt.relative_algebraic_novelty ||
        result.receipt.algebra_isomorphism_complete ||
        result.receipt.all_sign_tables_exhausted ||
        !result.receipt.base_twist_assumed ||
        result.receipt.orbit_hamming_distance ||
        result.receipt.algorithmic_novelty ||
        result.receipt.material_novelty ||
        result.receipt.scientific_novelty ||
        result.receipt.global_novelty ||
        result.receipt.historical_novelty ||
        result.receipt.priority_claim ||
        result.receipt.external_prior_art_complete ||
        result.receipt.source_hash_bound ||
        result.receipt.semantics_hash_bound ||
        result.receipt.receipt_frozen || result.receipt.receipt_admitted ||
        result.receipt.formal_parity_open || result.receipt.effect_parity_open ||
        result.receipt.material_parity_count != 0 ||
        result.receipt.parity_open || result.receipt.claim_ready {
        return 9
    }

    let grammar_digest: [i64; 8] = [
        570589085, 749041945, 1329301930, 611170904,
        1532229507, 1021317887, 2775891225, 947790935
    ]
    let quotient_digest: [i64; 8] = [
        564541249, 3228076062, 390461363, 2943539866,
        4124273702, 1250105957, 3266402662, 3769658761
    ]
    let matrix_digest: [i64; 8] = [
        597824381, 2446138857, 4268899718, 3240081078,
        4187815540, 2679896491, 2063654928, 3473651008
    ]
    let stabilizer_digest: [i64; 8] = [
        587826867, 3314038832, 3950713773, 138975832,
        3516783452, 3668238948, 618408049, 3993562003
    ]
    let partition_digest: [i64; 8] = [
        1217026754, 2992853042, 3737542512, 3243683287,
        2594304599, 2266024791, 2334691961, 4189063699
    ]
    let corpus_digest: [i64; 8] = [
        2730630797, 260362047, 1012481507, 3846759765,
        1689394689, 1767006049, 3724679134, 1349344679
    ]
    let search_digest: [i64; 8] = [
        2004349264, 4068757965, 2595656473, 2168852577,
        3523993758, 311145912, 2847911171, 989610072
    ]
    let selected_digest: [i64; 8] = [
        2724519677, 2053830740, 3438943425, 2804128848,
        1543252928, 3935170195, 2977812633, 1389978691
    ]
    let receipt_digest: [i64; 8] = [
        1299106405, 2815801561, 177212000, 630360302,
        4199709074, 1122314024, 3296376085, 327108787
    ]
    if !bilinear_digest_matches(&result.grammar_digest, &grammar_digest) ||
        !bilinear_digest_matches(&result.quotient_digest, &quotient_digest) ||
        !bilinear_digest_matches(&result.matrix_digest, &matrix_digest) ||
        !bilinear_digest_matches(
            &result.stabilizer_digest, &stabilizer_digest) ||
        !bilinear_digest_matches(
            &result.partition_digest, &partition_digest) ||
        !bilinear_digest_matches(&result.corpus_digest, &corpus_digest) ||
        !bilinear_digest_matches(&result.search_digest, &search_digest) ||
        !bilinear_digest_matches(&result.selected_digest, &selected_digest) ||
        !bilinear_digest_matches(&result.receipt_digest, &receipt_digest) {
        return 10
    }
    0
}

pub fn pireus_operator_genesis_bilinear_matches_frozen_semantics(
    result: &BilinearGenesisResult,
) -> bool with Mut, Panic {
    pireus_operator_genesis_bilinear_frozen_mismatch_code(result) == 0
}
