//! Sounio semantic authority for the full bilinear Operator Genesis grammar.
//!
//! This first executable intentionally contains no frozen stabilizer size,
//! class count, selected operator, signature, witness, or digest.

use algebra::cayley_dickson::cd_sigma
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
}

