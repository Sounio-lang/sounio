fn ode_digest_add_i64(state: SHA256State, value: i64) -> SHA256State
with Mut, Panic, Div, Epistemic {
    var bytes: [u8; 256] = [0; 256]
    var index: i64 = 0
    while index < 8 {
        bytes[index] = ((value >> ((7 - index) * 8)) & 255) as u8
        index = index + 1
    }
    sha256_update(state, bytes, 8)
}

fn ode_digest_finish(state: SHA256State) -> PireusOdeDigest
with Mut, Panic, Div, Epistemic {
    let digest = sha256_finalize(state)
    var words: [i64; 8] = [0; 8]
    var word: i64 = 0
    while word < 8 {
        var value: i64 = 0
        var byte: i64 = 0
        while byte < 4 {
            value = (value << 8) |
                sha256_digest_byte(&digest, (word * 4 + byte) as i32)
            byte = byte + 1
        }
        words[word] = value
        word = word + 1
    }
    PireusOdeDigest { words: words }
}

fn ode_hash_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var word: i64 = 0
    while word < 8 {
        if left[word] != right[word] { return false }
        word = word + 1
    }
    true
}

fn ode_text_sha256_matches(raw: string, expected: &[i64; 8]) -> bool
with Mut, Panic, Div, Epistemic {
    let size = str_len(raw)
    var state: [i64; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]
    var pos: i64 = 0
    while size - pos >= 64 {
        var block: [u8; 64] = [0; 64]
        var index: i64 = 0
        while index < 64 {
            var byte = str_char_at(raw, pos + index) as i64
            if byte < 0 { byte = byte + 256 }
            block[index] = byte as u8
            index = index + 1
        }
        state = sha256_compress(state, block)
        pos = pos + 64
    }

    var tail: [u8; 64] = [0; 64]
    let remaining = size - pos
    var index: i64 = 0
    while index < remaining {
        var byte = str_char_at(raw, pos + index) as i64
        if byte < 0 { byte = byte + 256 }
        tail[index] = byte as u8
        index = index + 1
    }
    tail[remaining] = 0x80 as u8
    if remaining > 55 {
        state = sha256_compress(state, tail)
        var clear: i64 = 0
        while clear < 64 {
            tail[clear] = 0
            clear = clear + 1
        }
    }

    let bit_length = size * 8
    tail[56] = ((bit_length >> 56) & 255) as u8
    tail[57] = ((bit_length >> 48) & 255) as u8
    tail[58] = ((bit_length >> 40) & 255) as u8
    tail[59] = ((bit_length >> 32) & 255) as u8
    tail[60] = ((bit_length >> 24) & 255) as u8
    tail[61] = ((bit_length >> 16) & 255) as u8
    tail[62] = ((bit_length >> 8) & 255) as u8
    tail[63] = (bit_length & 255) as u8
    state = sha256_compress(state, tail)
    ode_hash_equal(&state, expected)
}

fn ode_span_eq(raw: string, start: i64, end: i64, expected: string) -> bool
with Mut, Panic {
    if end - start != str_len(expected) { return false }
    var index: i64 = 0
    while index < str_len(expected) {
        if str_char_at(raw, start + index) != str_char_at(expected, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn ode_span_has_prefix(
    raw: string, start: i64, end: i64, prefix: string,
) -> bool with Mut, Panic {
    if end - start < str_len(prefix) { return false }
    var index: i64 = 0
    while index < str_len(prefix) {
        if str_char_at(raw, start + index) != str_char_at(prefix, index) {
            return false
        }
        index = index + 1
    }
    true
}

fn ode_parse_uint(raw: string, start: i64, end: i64) -> i64
with Mut, Panic {
    if start >= end { return -1 }
    var value: i64 = 0
    var pos = start
    while pos < end {
        let code = str_char_at(raw, pos)
        if code < 48 || code > 57 { return -1 }
        value = value * 10 + code - 48
        pos = pos + 1
    }
    value
}

fn ode_parse_int(raw: string, start: i64, end: i64) -> [i64; 2]
with Mut, Panic {
    if start >= end { return [0, 0] }
    var sign: i64 = 1
    var digits = start
    if str_char_at(raw, digits) == 45 {
        sign = -1
        digits = digits + 1
    }
    let magnitude = ode_parse_uint(raw, digits, end)
    if magnitude < 0 { [0, 0] } else { [1, sign * magnitude] }
}

fn ode_parse_field_uint(
    raw: string, start: i64, end: i64, field: string,
) -> i64 with Mut, Panic {
    let field_len = str_len(field)
    var pos = start
    while pos + field_len <= end {
        var matches = true
        var index: i64 = 0
        while index < field_len {
            if str_char_at(raw, pos + index) != str_char_at(field, index) {
                matches = false
            }
            index = index + 1
        }
        if matches {
            var value_end = pos + field_len
            while value_end < end {
                let code = str_char_at(raw, value_end)
                if code < 48 || code > 57 { break }
                value_end = value_end + 1
            }
            return ode_parse_uint(raw, pos + field_len, value_end)
        }
        pos = pos + 1
    }
    -1
}

fn ode_parse_field_int(
    raw: string, start: i64, end: i64, field: string,
) -> [i64; 2] with Mut, Panic {
    let field_len = str_len(field)
    var pos = start
    while pos + field_len <= end {
        var matches = true
        var index: i64 = 0
        while index < field_len {
            if str_char_at(raw, pos + index) != str_char_at(field, index) {
                matches = false
            }
            index = index + 1
        }
        if matches {
            var value_end = pos + field_len
            if value_end < end && str_char_at(raw, value_end) == 45 {
                value_end = value_end + 1
            }
            while value_end < end {
                let code = str_char_at(raw, value_end)
                if code < 48 || code > 57 { break }
                value_end = value_end + 1
            }
            return ode_parse_int(raw, pos + field_len, value_end)
        }
        pos = pos + 1
    }
    [0, 0]
}

fn ode_line_count(raw: string, expected: string) -> i64
with Mut, Panic {
    var count: i64 = 0
    var start: i64 = 0
    while start < str_len(raw) {
        var end = start
        while end < str_len(raw) && str_char_at(raw, end) != 10 {
            end = end + 1
        }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if ode_span_eq(raw, start, line_end, expected) { count = count + 1 }
        start = end + 1
    }
    count
}

fn ode_empty_tensor() -> PireusOdeTensor {
    PireusOdeTensor { coefficient: [0; 4096] }
}

fn ode_tensor_index(output: i64, input_0: i64, input_1: i64) -> i64 {
    (input_0 * PIREUS_ODE_LANES + input_1) * PIREUS_ODE_LANES +
        output
}

fn ode_parse_parent_basis(raw: string) -> PireusOdeAdmission
with Mut, Panic {
    var parent = ode_empty_tensor()
    var affine_address = ode_empty_tensor()
    var coefficient_lift = ode_empty_tensor()
    var seen: [i64; 768] = [0; 768]
    var pending = false
    var pending_genome: i64 = -1
    var pending_i: i64 = -1
    var pending_j: i64 = -1
    var pending_destination: i64 = -1
    var basis_cells: i64 = 0
    var failures: i64 = 0
    var start: i64 = 0
    while start < str_len(raw) {
        var end = start
        while end < str_len(raw) && str_char_at(raw, end) != 10 {
            end = end + 1
        }
        var line_end = end
        if line_end > start && str_char_at(raw, line_end - 1) == 13 {
            line_end = line_end - 1
        }
        if ode_span_has_prefix(
            raw, start, line_end, "PIREUS_OAG_BASIS genome=") {
            if pending { failures = failures + 1 }
            pending_genome = ode_parse_field_uint(
                raw, start, line_end, "genome=")
            pending = pending_genome == 0 || pending_genome == 2 ||
                pending_genome == 3
            pending_i = -1
            pending_j = -1
            pending_destination = -1
        } else if pending && ode_span_has_prefix(raw, start, line_end,
            " arity=2 i=") {
            pending_i = ode_parse_field_uint(raw, start, line_end, "i=")
        } else if pending && ode_span_has_prefix(raw, start, line_end, " j=") {
            pending_j = ode_parse_field_uint(raw, start, line_end, "j=")
        } else if pending && ode_span_has_prefix(
            raw, start, line_end, " destination=") {
            pending_destination = ode_parse_field_uint(
                raw, start, line_end, "destination=")
        } else if pending && ode_span_has_prefix(
            raw, start, line_end, " coefficient=") {
            let parsed_coefficient = ode_parse_field_int(
                raw, start, line_end, "coefficient=")
            let coefficient = parsed_coefficient[1]
            if pending_i < 0 || pending_i >= PIREUS_ODE_LANES ||
                pending_j < 0 || pending_j >= PIREUS_ODE_LANES ||
                pending_destination < 0 ||
                pending_destination >= PIREUS_ODE_LANES ||
                parsed_coefficient[0] != 1 || coefficient == 0 {
                failures = failures + 1
            } else {
                let cell = pending_i * PIREUS_ODE_LANES + pending_j
                let tensor_cell = ode_tensor_index(
                    pending_destination, pending_i, pending_j)
                let atlas_slot = if pending_genome == 0 { 0 }
                    else if pending_genome == 2 { 1 } else { 2 }
                let seen_cell = atlas_slot * PIREUS_ODE_BASIS_CELLS + cell
                if seen[seen_cell] != 0 { failures = failures + 1 }
                else {
                    seen[seen_cell] = 1
                    if atlas_slot == 0 {
                        parent.coefficient[tensor_cell] = coefficient
                    } else if atlas_slot == 1 {
                        affine_address.coefficient[tensor_cell] = coefficient
                    } else {
                        coefficient_lift.coefficient[tensor_cell] = coefficient
                    }
                    basis_cells = basis_cells + 1
                }
            }
            pending = false
        }
        start = end + 1
    }
    if pending { failures = failures + 1 }
    PireusOdeAdmission {
        parent: parent,
        affine_address: affine_address,
        coefficient_lift: coefficient_lift,
        garden_match: false,
        contract_match: false,
        parent_source_match: false,
        parent_freeze_match: false,
        parent_parity_match: false,
        parent_evidence_match: false,
        parent_evidence_hash_delegated: false,
        atlas_reconstruction_match: false,
        parent_semantics_match: false,
        parent_residual_match: false,
        basis_cells: basis_cells,
        basis_failures: failures,
        complete: basis_cells ==
            PIREUS_ODE_ATLAS_CLASSES * PIREUS_ODE_BASIS_CELLS &&
            failures == 0,
    }
}

fn ode_rotl4(value: i64) -> i64 {
    ((value << 1) & 15) | ((value >> 3) & 1)
}

fn ode_reconstruct_v9_bilinear_atlas(
    parent: &PireusOdeTensor,
    parsed_affine: &PireusOdeTensor,
    parsed_lift: &PireusOdeTensor,
) -> PireusOdeAtlasReconstruction with Mut, Panic {
    var affine_address = ode_empty_tensor()
    var coefficient_lift = ode_empty_tensor()
    var pair_counts: [i64; 256] = [0; 256]
    var associator_failures: i64 = 0
    var commutator_failures: i64 = 0
    var first_i: i64 = -1
    var first_j: i64 = -1
    var first_k: i64 = -1
    var failures: i64 = 0
    var i: i64 = 0
    while i < PIREUS_ODE_LANES {
        var j: i64 = 0
        while j < PIREUS_ODE_LANES {
            var support: i64 = 0
            var output: i64 = 0
            while output < PIREUS_ODE_LANES {
                if parent.coefficient[ode_tensor_index(output, i, j)] != 0 {
                    support = support + 1
                }
                output = output + 1
            }
            if support != 1 { failures = failures + 1 }
            let cij = parent.coefficient[ode_tensor_index(i ^ j, i, j)]
            let cji = parent.coefficient[ode_tensor_index(i ^ j, j, i)]
            if cij == 0 { failures = failures + 1 }
            if cij != cji {
                commutator_failures = commutator_failures + 1
            }
            var k: i64 = 0
            while k < PIREUS_ODE_LANES {
                let left = cij * parent.coefficient[ode_tensor_index(
                    (i ^ j) ^ k, i ^ j, k)]
                let cjk = parent.coefficient[ode_tensor_index(j ^ k, j, k)]
                let right = cjk * parent.coefficient[ode_tensor_index(
                    i ^ (j ^ k), i, j ^ k)]
                if left != right {
                    associator_failures = associator_failures + 1
                    pair_counts[i * PIREUS_ODE_LANES + j] =
                        pair_counts[i * PIREUS_ODE_LANES + j] + 1
                    if first_i < 0 {
                        first_i = i
                        first_j = j
                        first_k = k
                    }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    let residual_shape_match = associator_failures == 768 &&
        commutator_failures == 112 && first_i == 2 && first_j == 4 &&
        first_k == 2
    if !residual_shape_match {
        failures = failures + 1
    } else {
        i = 0
        while i < PIREUS_ODE_LANES {
            var j: i64 = 0
            while j < PIREUS_ODE_LANES {
                let parent_coefficient =
                    parent.coefficient[ode_tensor_index(i ^ j, i, j)]
                let affine_destination = ode_rotl4(i) ^ j ^ first_k
                affine_address.coefficient[ode_tensor_index(
                    affine_destination, i, j)] = parent_coefficient
                coefficient_lift.coefficient[ode_tensor_index(i ^ j, i, j)] =
                    parent_coefficient *
                    (1 + pair_counts[i * PIREUS_ODE_LANES + j])
                j = j + 1
            }
            i = i + 1
        }
    }
    var parsed_lift_nonzero: i64 = 0
    var cell: i64 = 0
    while cell < PIREUS_ODE_TENSOR_CELLS {
        if parsed_affine.coefficient[cell] !=
            affine_address.coefficient[cell] {
            failures = failures + 1
        }
        if parsed_lift.coefficient[cell] != 0 {
            parsed_lift_nonzero = parsed_lift_nonzero + 1
            if parsed_lift.coefficient[cell] !=
                coefficient_lift.coefficient[cell] {
                failures = failures + 1
            }
        }
        cell = cell + 1
    }
    if parsed_lift_nonzero != 256 {
        failures = failures + 1
    }
    PireusOdeAtlasReconstruction {
        affine_address: affine_address,
        coefficient_lift: coefficient_lift,
        associator_failures: associator_failures,
        commutator_failures: commutator_failures,
        first_i: first_i,
        first_j: first_j,
        first_k: first_k,
        failures: failures,
        complete: failures == 0 && residual_shape_match,
    }
}

pub fn pireus_operator_discovery_engine_request() -> PireusOdeRequest {
    PireusOdeRequest {
        producer_language: PIREUS_ONF_LANGUAGE_SOUNIO,
        producer_role: PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
        stage: PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE,
        policy_state: PIREUS_ODE_POLICY_READY,
        parent_present: true,
        parent_frozen: true,
        parent_source_bound: true,
        parent_semantics_bound: true,
        parent_freeze_bound: true,
        parent_evidence_bound: true,
        parent_parity_open_bound: true,
        garden_bound: true,
        contract_bound: true,
        atlas_hash_present: true,
        equivalence_hash_present: true,
        grammar_hash_present: true,
        intent_hash_present: true,
        complete_separator_required: true,
        expected_candidate_present: false,
        expected_collision_present: false,
        expected_separator_present: false,
        expected_digest_present: false,
        semantic_write_from_parity: false,
        expected_result_write_from_parity: false,
        review_promoted_to_authority: false,
        collision_promoted_to_novelty: false,
        incomplete_promoted_to_novelty: false,
        target_instruction_present: false,
        target_cost_present: false,
        target_performance_present: false,
        historical_novelty_requested: false,
        priority_requested: false,
        claim_ready_requested: false,
        raw_elf_requested: false,
        founder_waiver_present: false,
    }
}

pub fn pireus_operator_discovery_engine_paths() -> PireusOdePaths {
    PireusOdePaths {
        garden: "tools/pireus/GARDEN_PIREUS_OPERATOR_DISCOVERY_ENGINE_V10.md",
        contract:
            "tools/pireus/PIREUS_OPERATOR_DISCOVERY_ENGINE_CONTRACT_V10.md",
        parent_source: "stdlib/hardware/pireus/operator_autogenesis.sio",
        parent_freeze: "tools/pireus/operator_autogenesis.freeze.v9",
        parent_parity_open:
            "tools/pireus/operator_autogenesis.parity-open.v9",
        parent_evidence:
            "tools/pireus/evidence/operator_autogenesis_v9.frozen.txt",
    }
}

fn ode_request_error(request: &PireusOdeRequest) -> i64 {
    if request.producer_language != PIREUS_ONF_LANGUAGE_SOUNIO ||
        request.producer_role != PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY ||
        request.semantic_write_from_parity ||
        request.expected_result_write_from_parity ||
        request.review_promoted_to_authority {
        return PIREUS_ODE_ERR_AUTHORITY
    }
    if request.stage != PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE {
        return PIREUS_ODE_ERR_STAGE
    }
    if request.policy_state != PIREUS_ODE_POLICY_READY {
        return PIREUS_ODE_ERR_POLICY
    }
    if !request.parent_present || !request.parent_frozen ||
        !request.parent_source_bound || !request.parent_semantics_bound ||
        !request.parent_freeze_bound || !request.parent_evidence_bound ||
        !request.parent_parity_open_bound || !request.garden_bound ||
        !request.contract_bound {
        return PIREUS_ODE_ERR_LINEAGE
    }
    if !request.atlas_hash_present { return PIREUS_ODE_ERR_ATLAS }
    if !request.equivalence_hash_present {
        return PIREUS_ODE_ERR_EQUIVALENCE
    }
    if !request.grammar_hash_present || !request.intent_hash_present ||
        !request.complete_separator_required {
        return PIREUS_ODE_ERR_GRAMMAR
    }
    if request.expected_candidate_present ||
        request.expected_collision_present ||
        request.expected_separator_present || request.expected_digest_present ||
        request.collision_promoted_to_novelty ||
        request.incomplete_promoted_to_novelty {
        return PIREUS_ODE_ERR_RESULT_INJECTION
    }
    if request.target_instruction_present || request.target_cost_present ||
        request.target_performance_present {
        return PIREUS_ODE_ERR_MATERIAL
    }
    if request.historical_novelty_requested || request.priority_requested ||
        request.claim_ready_requested || request.founder_waiver_present {
        return PIREUS_ODE_ERR_CLAIM
    }
    if request.raw_elf_requested { return PIREUS_ODE_ERR_RAW_ELF }
    PIREUS_ODE_OK
}

fn ode_invalid_admission() -> PireusOdeAdmission with Mut, Panic {
    let parsed = ode_parse_parent_basis("")
    parsed
}

fn ode_build_admission(paths: &PireusOdePaths) -> PireusOdeAdmission
with IO, Mut, Panic, Div, Alloc, Epistemic {
    if file_size(paths.garden) <= 0 || file_size(paths.contract) <= 0 ||
        file_size(paths.parent_source) <= 0 ||
        file_size(paths.parent_freeze) <= 0 ||
        file_size(paths.parent_parity_open) <= 0 ||
        file_size(paths.parent_evidence) != 1270431 {
        return ode_invalid_admission()
    }
    let garden_raw = read_file(paths.garden)
    let contract_raw = read_file(paths.contract)
    let parent_source_raw = read_file(paths.parent_source)
    let parent_freeze_raw = read_file(paths.parent_freeze)
    let parent_parity_raw = read_file(paths.parent_parity_open)
    let parent_evidence_raw = read_file(paths.parent_evidence)
    var admission = ode_parse_parent_basis(parent_evidence_raw)
    let reconstruction = ode_reconstruct_v9_bilinear_atlas(
        &admission.parent, &admission.affine_address,
        &admission.coefficient_lift)
    let garden_hash = ode_garden_hash()
    let contract_hash = ode_contract_hash()
    let parent_source_hash = ode_parent_source_hash()
    let parent_freeze_hash = ode_parent_freeze_hash()
    let parent_parity_hash = ode_parent_parity_hash()
    let parent_evidence_hash = ode_parent_evidence_hash()
    admission.garden_match = ode_text_sha256_matches(garden_raw, &garden_hash)
    admission.contract_match = ode_text_sha256_matches(
        contract_raw, &contract_hash)
    admission.parent_source_match = ode_text_sha256_matches(
        parent_source_raw, &parent_source_hash)
    admission.parent_freeze_match = ode_text_sha256_matches(
        parent_freeze_raw, &parent_freeze_hash)
    admission.parent_parity_match = ode_text_sha256_matches(
        parent_parity_raw, &parent_parity_hash)
    admission.parent_evidence_match = ode_text_sha256_matches(
        parent_evidence_raw, &parent_evidence_hash)
    admission.parent_evidence_hash_delegated = false
    admission.atlas_reconstruction_match = reconstruction.complete
    admission.affine_address = reconstruction.affine_address
    admission.coefficient_lift = reconstruction.coefficient_lift
    admission.parent_semantics_match = ode_line_count(parent_freeze_raw,
        "semantics_sha256=8fad13c09d2b17ea1adcce0a6b89612964e80ddb4a7a576916c2c1da30286df6") == 1
    admission.parent_residual_match = ode_line_count(parent_freeze_raw,
        "residual_first_witness=2:4:2") == 1 &&
        ode_line_count(parent_evidence_raw,
            "PIREUS_OAG_FROZEN match=1") == 1 &&
        ode_line_count(parent_evidence_raw, " mismatch_code=0") == 1
    admission.complete = admission.complete && admission.garden_match &&
        admission.contract_match && admission.parent_source_match &&
        admission.parent_freeze_match && admission.parent_parity_match &&
        admission.parent_evidence_match &&
        admission.atlas_reconstruction_match &&
        admission.parent_semantics_match && admission.parent_residual_match
    admission
}

fn ode_permute(action: i64, value: i64) -> i64 {
    if action == 0 { value }
    else if action == 1 && value == 0 { 1 }
    else if action == 1 && value == 1 { 0 }
    else if action == 1 { value }
    else { -1 }
}

fn ode_sign(action: i64, value: i64) -> i64 {
    if (action == 0 || action == 1) &&
        value >= 0 && value < PIREUS_ODE_LANES { 1 }
    else { 0 }
}

fn ode_group_multiply(left: i64, right: i64) -> i64 {
    if left < 0 || left >= PIREUS_ODE_GROUP_ORDER ||
        right < 0 || right >= PIREUS_ODE_GROUP_ORDER { -1 }
    else { left ^ right }
}

fn ode_apply_action(table: &PireusOdeTensor, action: i64) -> PireusOdeTensor
with Mut, Panic {
    var result = ode_empty_tensor()
    var i: i64 = 0
    while i < PIREUS_ODE_LANES {
        var j: i64 = 0
        while j < PIREUS_ODE_LANES {
            var output: i64 = 0
            while output < PIREUS_ODE_LANES {
                let source_i = ode_permute(action, i)
                let source_j = ode_permute(action, j)
                let source_output = ode_permute(action, output)
                let source_cell = ode_tensor_index(
                    source_output, source_i, source_j)
                let cell = ode_tensor_index(output, i, j)
                result.coefficient[cell] = ode_sign(action, output) *
                    ode_sign(action, i) * ode_sign(action, j) *
                    table.coefficient[source_cell]
                output = output + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    result
}

fn ode_compare_tensors(left: &PireusOdeTensor, right: &PireusOdeTensor)
-> [i64; 2] with Mut, Panic {
    var first_witness: i64 = -1
    var cell: i64 = 0
    while cell < PIREUS_ODE_TENSOR_CELLS {
        if first_witness < 0 && left.coefficient[cell] !=
            right.coefficient[cell] {
            first_witness = cell
        }
        cell = cell + 1
    }
    if first_witness < 0 { [1, -1] } else { [0, first_witness] }
}

fn ode_group_certificate(
    parent: &PireusOdeTensor,
    affine_address: &PireusOdeTensor,
    coefficient_lift: &PireusOdeTensor,
) -> PireusOdeGroupCertificate
with Mut, Panic {
    var permutation_checks: i64 = 0
    var multiplication_checks: i64 = 0
    var law_checks: i64 = 0
    var action_checks: i64 = 0
    var failures: i64 = 0
    var action: i64 = 0
    while action < PIREUS_ODE_GROUP_ORDER {
        var seen: [i64; 16] = [0; 16]
        var value: i64 = 0
        while value < PIREUS_ODE_LANES {
            let mapped = ode_permute(action, value)
            permutation_checks = permutation_checks + 1
            if mapped < 0 || mapped >= PIREUS_ODE_LANES ||
                ode_sign(action, value) != 1 ||
                ode_permute(action, mapped) != value {
                failures = failures + 1
            } else { seen[mapped] = seen[mapped] + 1 }
            value = value + 1
        }
        value = 0
        while value < PIREUS_ODE_LANES {
            if seen[value] != 1 { failures = failures + 1 }
            value = value + 1
        }
        action = action + 1
    }
    var left: i64 = 0
    while left < PIREUS_ODE_GROUP_ORDER {
        var right: i64 = 0
        while right < PIREUS_ODE_GROUP_ORDER {
            let product = ode_group_multiply(left, right)
            multiplication_checks = multiplication_checks + 1
            if product < 0 || product >= PIREUS_ODE_GROUP_ORDER {
                failures = failures + 1
            }
            if ode_group_multiply(0, left) != left ||
                ode_group_multiply(left, 0) != left {
                failures = failures + 1
            }
            law_checks = law_checks + 2
            var atlas_class: i64 = 0
            while atlas_class < PIREUS_ODE_ATLAS_CLASSES {
                let atlas = if atlas_class == 0 {
                    ode_apply_action(parent, 0)
                } else if atlas_class == 1 {
                    ode_apply_action(affine_address, 0)
                } else { ode_apply_action(coefficient_lift, 0) }
                let first = ode_apply_action(&atlas, right)
                let sequential = ode_apply_action(&first, left)
                let direct = ode_apply_action(&atlas, product)
                let comparison = ode_compare_tensors(&sequential, &direct)
                action_checks = action_checks + PIREUS_ODE_TENSOR_CELLS
                if comparison[0] != 1 { failures = failures + 1 }
                atlas_class = atlas_class + 1
            }
            right = right + 1
        }
        if ode_group_multiply(left, left) != 0 { failures = failures + 1 }
        law_checks = law_checks + 1
        left = left + 1
    }
    var a: i64 = 0
    while a < PIREUS_ODE_GROUP_ORDER {
        var b: i64 = 0
        while b < PIREUS_ODE_GROUP_ORDER {
            var c: i64 = 0
            while c < PIREUS_ODE_GROUP_ORDER {
                law_checks = law_checks + 1
                if ode_group_multiply(ode_group_multiply(a, b), c) !=
                    ode_group_multiply(a, ode_group_multiply(b, c)) {
                    failures = failures + 1
                }
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    PireusOdeGroupCertificate {
        permutation_checks: permutation_checks,
        multiplication_checks: multiplication_checks,
        law_checks: law_checks,
        action_checks: action_checks,
        failures: failures,
        complete: permutation_checks == 32 &&
            multiplication_checks == 4 && law_checks == 18 &&
            action_checks == 49152 && failures == 0,
    }
}

fn ode_control_genome() -> PireusOdeGenome {
    PireusOdeGenome {
        id: -1, parent_id: 0, opcode: PIREUS_ODE_OPCODE_GROUP_IMAGE,
        parameter: 1, coefficient_delta: 0, arity: 2,
        linear_slot_0: true, linear_slot_1: true,
        slot_0_uses: 1, slot_1_uses: 1,
        operand_independent_coefficients: true, target_neutral: true,
    }
}

fn ode_candidate_genome(id: i64) -> PireusOdeGenome {
    let coordinate = id / 2
    let output = coordinate -
        (coordinate / PIREUS_ODE_LANES) * PIREUS_ODE_LANES
    let pair = coordinate / PIREUS_ODE_LANES
    let input_1 = pair - (pair / 15) * 15 + 1
    let input_0 = pair / 15 + 1
    PireusOdeGenome {
        id: id, parent_id: 0,
        opcode: PIREUS_ODE_OPCODE_ENUMERATED_COEFFICIENT_DELTA,
        parameter: ode_tensor_index(output, input_0, input_1),
        coefficient_delta: if id - (id / 2) * 2 == 0 { 1 } else { -1 },
        arity: 2, linear_slot_0: true, linear_slot_1: true,
        slot_0_uses: 1, slot_1_uses: 1,
        operand_independent_coefficients: true, target_neutral: true,
    }
}

fn ode_rejected_genome() -> PireusOdeGenome {
    PireusOdeGenome {
        id: PIREUS_ODE_GRAMMAR_CARDINALITY, parent_id: 0,
        opcode: PIREUS_ODE_OPCODE_DUPLICATE_LINEAR_SLOT,
        parameter: 0, coefficient_delta: 1, arity: 2,
        linear_slot_0: true, linear_slot_1: true,
        slot_0_uses: 2, slot_1_uses: 1,
        operand_independent_coefficients: true, target_neutral: true,
    }
}

fn ode_validate_genome(genome: &PireusOdeGenome) -> i64 {
    if genome.arity != 2 || !genome.linear_slot_0 ||
        !genome.linear_slot_1 || !genome.operand_independent_coefficients ||
        !genome.target_neutral {
        return PIREUS_ODE_ERR_GRAMMAR
    }
    if genome.slot_0_uses != 1 || genome.slot_1_uses != 1 {
        return PIREUS_ODE_ERR_GRAMMAR
    }
    if genome.opcode == PIREUS_ODE_OPCODE_GROUP_IMAGE {
        if genome.parameter != 1 || genome.coefficient_delta != 0 {
            return PIREUS_ODE_ERR_GRAMMAR
        }
    } else if genome.opcode ==
        PIREUS_ODE_OPCODE_ENUMERATED_COEFFICIENT_DELTA {
        let expected = ode_candidate_genome(genome.id)
        if genome.id < 0 || genome.id >= PIREUS_ODE_GRAMMAR_CARDINALITY ||
            genome.parameter != expected.parameter ||
            genome.coefficient_delta != expected.coefficient_delta ||
            genome.parameter < 0 ||
            genome.parameter >= PIREUS_ODE_TENSOR_CELLS ||
            (genome.coefficient_delta != 1 &&
             genome.coefficient_delta != -1) {
            return PIREUS_ODE_ERR_GRAMMAR
        }
    } else { return PIREUS_ODE_ERR_GRAMMAR }
    PIREUS_ODE_OK
}

fn ode_generate_tensor(
    genome: &PireusOdeGenome, parent: &PireusOdeTensor,
) -> PireusOdeTensor with Mut, Panic {
    if genome.opcode == PIREUS_ODE_OPCODE_GROUP_IMAGE {
        return ode_apply_action(parent, genome.parameter)
    }
    var result = ode_apply_action(parent, 0)
    if genome.opcode == PIREUS_ODE_OPCODE_ENUMERATED_COEFFICIENT_DELTA &&
        genome.parameter >= 0 &&
        genome.parameter < PIREUS_ODE_TENSOR_CELLS {
        result.coefficient[genome.parameter] =
            result.coefficient[genome.parameter] + genome.coefficient_delta
    }
    result
}

fn ode_preserves_e0_unit(table: &PireusOdeTensor) -> bool
with Mut, Panic {
    var input: i64 = 0
    while input < PIREUS_ODE_LANES {
        var output: i64 = 0
        while output < PIREUS_ODE_LANES {
            let expected = if output == input { 1 } else { 0 }
            if table.coefficient[ode_tensor_index(output, 0, input)] !=
                expected ||
                table.coefficient[ode_tensor_index(output, input, 0)] !=
                expected {
                return false
            }
            output = output + 1
        }
        input = input + 1
    }
    true
}

fn ode_atlas_tensor(
    atlas_class: i64,
    parent: &PireusOdeTensor,
    affine_address: &PireusOdeTensor,
    coefficient_lift: &PireusOdeTensor,
) -> PireusOdeTensor with Mut, Panic {
    if atlas_class == 0 { ode_apply_action(parent, 0) }
    else if atlas_class == 1 { ode_apply_action(affine_address, 0) }
    else { ode_apply_action(coefficient_lift, 0) }
}

fn ode_discover(
    candidate: &PireusOdeTensor,
    atlas_parent: &PireusOdeTensor,
    atlas_affine_address: &PireusOdeTensor,
    atlas_coefficient_lift: &PireusOdeTensor,
    budget: i64,
) -> PireusOdeSearchResult with Mut, Panic {
    var separators: [i64; 6] = [-1; 6]
    var comparisons_completed: i64 = 0
    var atlas_class: i64 = 0
    while atlas_class < PIREUS_ODE_ATLAS_CLASSES &&
        comparisons_completed < budget {
        let atlas = ode_atlas_tensor(
            atlas_class, atlas_parent, atlas_affine_address,
            atlas_coefficient_lift)
        var action: i64 = 0
        while action < PIREUS_ODE_GROUP_ORDER &&
            comparisons_completed < budget {
            let representative = ode_apply_action(&atlas, action)
            let comparison = ode_compare_tensors(candidate, &representative)
            let separator_slot = atlas_class * PIREUS_ODE_GROUP_ORDER + action
            comparisons_completed = comparisons_completed + 1
            if comparison[0] == 1 {
                return PireusOdeSearchResult {
                    outcome: PIREUS_ODE_OUTCOME_QUOTIENT_COLLISION,
                    comparisons_required: PIREUS_ODE_SEPARATOR_CAPACITY,
                    comparisons_completed: comparisons_completed,
                    matched_class: atlas_class,
                    matched_action: action,
                    separators: separators,
                    separator_count: comparisons_completed - 1,
                    complete: true,
                }
            }
            separators[separator_slot] = comparison[1]
            action = action + 1
        }
        atlas_class = atlas_class + 1
    }
    if comparisons_completed != PIREUS_ODE_SEPARATOR_CAPACITY {
        return PireusOdeSearchResult {
            outcome: PIREUS_ODE_OUTCOME_SEARCH_INCOMPLETE,
            comparisons_required: PIREUS_ODE_SEPARATOR_CAPACITY,
            comparisons_completed: comparisons_completed,
            matched_class: -1,
            matched_action: -1,
            separators: separators,
            separator_count: comparisons_completed,
            complete: false,
        }
    }
    PireusOdeSearchResult {
        outcome: PIREUS_ODE_OUTCOME_N2_RELATIVE_NOVELTY,
        comparisons_required: PIREUS_ODE_SEPARATOR_CAPACITY,
        comparisons_completed: comparisons_completed,
        matched_class: -1,
        matched_action: -1,
        separators: separators,
        separator_count: PIREUS_ODE_SEPARATOR_CAPACITY,
        complete: separators[0] >= 0 && separators[1] >= 0 &&
            separators[2] >= 0 && separators[3] >= 0 &&
            separators[4] >= 0 && separators[5] >= 0,
    }
}

fn ode_incomplete_search() -> PireusOdeSearchResult {
    PireusOdeSearchResult {
        outcome: PIREUS_ODE_OUTCOME_SEARCH_INCOMPLETE,
        comparisons_required: PIREUS_ODE_SEPARATOR_CAPACITY,
        comparisons_completed: 0,
        matched_class: -1,
        matched_action: -1,
        separators: [-1; 6],
        separator_count: 0,
        complete: false,
    }
}

fn ode_run_forge(
    admission: &PireusOdeAdmission,
    candidate_budget: i64,
    emit_transcript: bool,
) -> PireusOdeForgeRun with IO, Mut, Panic {
    var selected = ode_apply_action(&admission.parent, 0)
    var selected_search = ode_incomplete_search()
    var generated: i64 = 0
    var typed_admitted: i64 = 0
    var quotient_collisions: i64 = 0
    var n2_relative_novelty: i64 = 0
    var selected_candidate_id: i64 = -1
    var separators: i64 = 0
    var candidate_id: i64 = 0
    while candidate_id < candidate_budget &&
        candidate_id < PIREUS_ODE_GRAMMAR_CARDINALITY &&
        selected_candidate_id < 0 {
        let genome = ode_candidate_genome(candidate_id)
        let validation = ode_validate_genome(&genome)
        generated = generated + 1
        var outcome = PIREUS_ODE_OUTCOME_TYPED_REJECTION
        var matched_class: i64 = -1
        var matched_action: i64 = -1
        if validation == PIREUS_ODE_OK {
            let candidate = ode_generate_tensor(&genome, &admission.parent)
            if ode_preserves_e0_unit(&candidate) {
                typed_admitted = typed_admitted + 1
                let search = ode_discover(
                    &candidate, &admission.parent, &admission.affine_address,
                    &admission.coefficient_lift,
                    PIREUS_ODE_SEPARATOR_CAPACITY)
                outcome = search.outcome
                matched_class = search.matched_class
                matched_action = search.matched_action
                if search.outcome == PIREUS_ODE_OUTCOME_QUOTIENT_COLLISION {
                    quotient_collisions = quotient_collisions + 1
                } else if search.outcome ==
                    PIREUS_ODE_OUTCOME_N2_RELATIVE_NOVELTY &&
                    search.complete && search.separator_count ==
                    PIREUS_ODE_SEPARATOR_CAPACITY {
                    n2_relative_novelty = n2_relative_novelty + 1
                    selected_candidate_id = candidate_id
                    selected = candidate
                    selected_search = search
                    separators = search.separator_count
                }
            }
        }
        if emit_transcript {
            print("PIREUS_ODE_CANDIDATE candidate_id=")
            print_int(candidate_id)
            print(" parent_candidate_id=0 mutation_opcode=")
            print_int(genome.opcode)
            print(" tensor_index="); print_int(genome.parameter)
            print(" coefficient_delta="); print_int(genome.coefficient_delta)
            print(" admission_result="); print_int(validation)
            print(" unit_preserved=")
            print_int(if validation == PIREUS_ODE_OK { 1 } else { 0 })
            print(" outcome="); print_int(outcome)
            print(" matched_atlas_class="); print_int(matched_class)
            print(" matched_action="); print_int(matched_action)
            print("\n")
        }
        candidate_id = candidate_id + 1
    }
    PireusOdeForgeRun {
        selected: selected,
        selected_search: selected_search,
        generated: generated,
        typed_admitted: typed_admitted,
        quotient_collisions: quotient_collisions,
        n2_relative_novelty: n2_relative_novelty,
        selected_candidate_id: selected_candidate_id,
        separators: separators,
        search_incomplete: selected_candidate_id < 0,
    }
}

fn ode_tensor_less(left: &PireusOdeTensor, right: &PireusOdeTensor) -> bool
with Mut, Panic {
    var cell: i64 = 0
    while cell < PIREUS_ODE_TENSOR_CELLS {
        if left.coefficient[cell] < right.coefficient[cell] { return true }
        if left.coefficient[cell] > right.coefficient[cell] { return false }
        cell = cell + 1
    }
    false
}

fn ode_canonical_action(table: &PireusOdeTensor) -> i64
with Mut, Panic {
    let identity = ode_apply_action(table, 0)
    let swapped = ode_apply_action(table, 1)
    if ode_tensor_less(&swapped, &identity) { 1 } else { 0 }
}

fn ode_law_spectrum(table: &PireusOdeTensor) -> PireusOdeLawSpectrum
with Mut, Panic {
    var commutator_failures: i64 = 0
    var associator_failures: i64 = 0
    var commutator_checks: i64 = 0
    var associator_checks: i64 = 0
    var i: i64 = 0
    while i < PIREUS_ODE_LANES {
        var j: i64 = 0
        while j < PIREUS_ODE_LANES {
            var output: i64 = 0
            while output < PIREUS_ODE_LANES {
                commutator_checks = commutator_checks + 1
                if table.coefficient[ode_tensor_index(output, i, j)] !=
                    table.coefficient[ode_tensor_index(output, j, i)] {
                    commutator_failures = commutator_failures + 1
                }
                output = output + 1
            }
            var k: i64 = 0
            while k < PIREUS_ODE_LANES {
                output = 0
                while output < PIREUS_ODE_LANES {
                    var left_sum: i64 = 0
                    var right_sum: i64 = 0
                    var middle: i64 = 0
                    while middle < PIREUS_ODE_LANES {
                        left_sum = left_sum +
                            table.coefficient[ode_tensor_index(
                                middle, i, j)] *
                            table.coefficient[ode_tensor_index(
                                output, middle, k)]
                        right_sum = right_sum +
                            table.coefficient[ode_tensor_index(
                                middle, j, k)] *
                            table.coefficient[ode_tensor_index(
                                output, i, middle)]
                        middle = middle + 1
                    }
                    associator_checks = associator_checks + 1
                    if left_sum != right_sum {
                        associator_failures = associator_failures + 1
                    }
                    output = output + 1
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    PireusOdeLawSpectrum {
        commutator_failures: commutator_failures,
        associator_failures: associator_failures,
        commutator_checks: commutator_checks,
        associator_checks: associator_checks,
    }
}

fn ode_negative_cases() -> [bool; 17] with Mut {
    var cases: [bool; 17] = [false; 17]
    var request = pireus_operator_discovery_engine_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_PYTHON
    cases[0] = ode_request_error(&request) == PIREUS_ODE_ERR_AUTHORITY
    request = pireus_operator_discovery_engine_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_RUST
    cases[1] = ode_request_error(&request) == PIREUS_ODE_ERR_AUTHORITY
    request = pireus_operator_discovery_engine_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_LLM
    request.producer_role = PIREUS_ONF_ROLE_REVIEW_ONLY
    request.review_promoted_to_authority = true
    cases[2] = ode_request_error(&request) == PIREUS_ODE_ERR_AUTHORITY
    request = pireus_operator_discovery_engine_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_LEAN
    request.producer_role = PIREUS_ONF_ROLE_FORMAL_PARITY
    request.semantic_write_from_parity = true
    cases[3] = ode_request_error(&request) == PIREUS_ODE_ERR_AUTHORITY
    request = pireus_operator_discovery_engine_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_KOKA
    request.producer_role = PIREUS_ONF_ROLE_EFFECT_PARITY
    request.expected_result_write_from_parity = true
    cases[4] = ode_request_error(&request) == PIREUS_ODE_ERR_AUTHORITY
    request = pireus_operator_discovery_engine_request()
    request.producer_language = PIREUS_ONF_LANGUAGE_CPP
    request.producer_role = PIREUS_ONF_ROLE_MATERIAL_PARITY
    request.semantic_write_from_parity = true
    cases[5] = ode_request_error(&request) == PIREUS_ODE_ERR_AUTHORITY
    request = pireus_operator_discovery_engine_request()
    request.policy_state = PIREUS_ODE_POLICY_MISSING
    cases[6] = ode_request_error(&request) == PIREUS_ODE_ERR_POLICY
    request = pireus_operator_discovery_engine_request()
    request.policy_state = PIREUS_ODE_POLICY_TIMEOUT
    cases[7] = ode_request_error(&request) == PIREUS_ODE_ERR_POLICY
    request = pireus_operator_discovery_engine_request()
    request.policy_state = PIREUS_ODE_POLICY_ERROR
    cases[8] = ode_request_error(&request) == PIREUS_ODE_ERR_POLICY
    request = pireus_operator_discovery_engine_request()
    request.parent_semantics_bound = false
    cases[9] = ode_request_error(&request) == PIREUS_ODE_ERR_LINEAGE
    request = pireus_operator_discovery_engine_request()
    request.atlas_hash_present = false
    cases[10] = ode_request_error(&request) == PIREUS_ODE_ERR_ATLAS
    request = pireus_operator_discovery_engine_request()
    request.equivalence_hash_present = false
    cases[11] = ode_request_error(&request) == PIREUS_ODE_ERR_EQUIVALENCE
    request = pireus_operator_discovery_engine_request()
    request.complete_separator_required = false
    cases[12] = ode_request_error(&request) == PIREUS_ODE_ERR_GRAMMAR
    request = pireus_operator_discovery_engine_request()
    request.collision_promoted_to_novelty = true
    cases[13] = ode_request_error(&request) ==
        PIREUS_ODE_ERR_RESULT_INJECTION
    request = pireus_operator_discovery_engine_request()
    request.incomplete_promoted_to_novelty = true
    cases[14] = ode_request_error(&request) ==
        PIREUS_ODE_ERR_RESULT_INJECTION
    request = pireus_operator_discovery_engine_request()
    request.historical_novelty_requested = true
    cases[15] = ode_request_error(&request) == PIREUS_ODE_ERR_CLAIM
    request = pireus_operator_discovery_engine_request()
    request.raw_elf_requested = true
    cases[16] = ode_request_error(&request) == PIREUS_ODE_ERR_RAW_ELF
    cases
}

fn ode_tensor_digest(table: &PireusOdeTensor) -> PireusOdeDigest
with Mut, Panic, Div, Epistemic {
    var state = sha256_init()
    state = ode_digest_add_i64(state, PIREUS_ODE_SCHEMA)
    state = ode_digest_add_i64(state, PIREUS_ODE_TENSOR_CELLS)
    var cell: i64 = 0
    while cell < PIREUS_ODE_TENSOR_CELLS {
        state = ode_digest_add_i64(state, table.coefficient[cell])
        cell = cell + 1
    }
    ode_digest_finish(state)
}

fn ode_tensor_nonzero(table: &PireusOdeTensor) -> i64 with Mut, Panic {
    var count: i64 = 0
    var cell: i64 = 0
    while cell < PIREUS_ODE_TENSOR_CELLS {
        if table.coefficient[cell] != 0 { count = count + 1 }
        cell = cell + 1
    }
    count
}

fn ode_emit_tensor(candidate: i64, table: &PireusOdeTensor)
with IO, Mut, Panic, Div, Epistemic {
    let digest = ode_tensor_digest(table)
    print("PIREUS_ODE_TENSOR candidate="); print_int(candidate)
    print(" cells=4096 nonzero="); print_int(ode_tensor_nonzero(table))
    print(" digest_words=")
    var word: i64 = 0
    while word < 8 {
        if word > 0 { print(":") }
        print_int(digest.words[word])
        word = word + 1
    }
    print("\n")
}

fn ode_emit_search(
    candidate: i64,
    result: &PireusOdeSearchResult,
    canonical_action: i64,
) with IO, Mut, Panic {
    print("PIREUS_ODE_DISCOVERY candidate="); print_int(candidate)
    print(" outcome="); print_int(result.outcome)
    print(" comparisons_required="); print_int(result.comparisons_required)
    print(" comparisons_completed="); print_int(result.comparisons_completed)
    print(" matched_class="); print_int(result.matched_class)
    print(" matched_action="); print_int(result.matched_action)
    print(" separator_count="); print_int(result.separator_count)
    print(" canonical_action="); print_int(canonical_action)
    print(" complete="); print_int(if result.complete { 1 } else { 0 })
    print("\n")
    var slot: i64 = 0
    while slot < PIREUS_ODE_SEPARATOR_CAPACITY {
        print("PIREUS_ODE_SEPARATOR candidate="); print_int(candidate)
        print(" atlas_class="); print_int(slot / PIREUS_ODE_GROUP_ORDER)
        print(" action="); print_int(slot -
            (slot / PIREUS_ODE_GROUP_ORDER) * PIREUS_ODE_GROUP_ORDER)
        print(" witness="); print_int(result.separators[slot])
        if result.separators[slot] >= 0 {
            let pair = result.separators[slot] / PIREUS_ODE_LANES
            print(" output=")
            print_int(result.separators[slot] -
                pair * PIREUS_ODE_LANES)
            print(" input_0="); print_int(pair / PIREUS_ODE_LANES)
            print(" input_1=")
            print_int(pair - (pair / PIREUS_ODE_LANES) *
                PIREUS_ODE_LANES)
        }
        print("\n")
        slot = slot + 1
    }
}

pub fn pireus_operator_discovery_engine_execute(
    request: &PireusOdeRequest,
    paths: &PireusOdePaths,
    emit_transcript: bool,
) -> PireusOdeSummary with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request_error = ode_request_error(request)
    let admission = ode_build_admission(paths)
    let group = ode_group_certificate(
        &admission.parent, &admission.affine_address,
        &admission.coefficient_lift)
    let control_genome = ode_control_genome()
    let first_candidate_genome = ode_candidate_genome(0)
    let rejected_genome = ode_rejected_genome()
    let control_validation = ode_validate_genome(&control_genome)
    let first_candidate_validation = ode_validate_genome(
        &first_candidate_genome)
    let rejected_validation = ode_validate_genome(&rejected_genome)
    let control_tensor = ode_generate_tensor(
        &control_genome, &admission.parent)
    let first_candidate_tensor = ode_generate_tensor(
        &first_candidate_genome, &admission.parent)
    let control_search = ode_discover(
        &control_tensor, &admission.parent, &admission.affine_address,
        &admission.coefficient_lift, PIREUS_ODE_SEPARATOR_CAPACITY)
    let forge = ode_run_forge(
        &admission, PIREUS_ODE_CANDIDATE_BUDGET, emit_transcript)
    let incomplete_search = ode_discover(
        &first_candidate_tensor, &admission.parent,
        &admission.affine_address,
        &admission.coefficient_lift, 1)
    let control_canonical = ode_canonical_action(&control_tensor)
    let selected_canonical = ode_canonical_action(&forge.selected)
    let law = ode_law_spectrum(&forge.selected)
    let negative_cases = ode_negative_cases()
    var negative_passed: i64 = 0
    var negative: i64 = 0
    while negative < PIREUS_ODE_NEGATIVE_CASES {
        if negative_cases[negative] { negative_passed = negative_passed + 1 }
        negative = negative + 1
    }
    let negative_failures = PIREUS_ODE_NEGATIVE_CASES - negative_passed
    var structural_failures: i64 = 0
    if !admission.complete { structural_failures = structural_failures + 1 }
    if !group.complete { structural_failures = structural_failures + 1 }
    if control_validation != PIREUS_ODE_OK ||
        first_candidate_validation != PIREUS_ODE_OK ||
        rejected_validation == PIREUS_ODE_OK {
        structural_failures = structural_failures + 1
    }
    if control_search.outcome !=
        PIREUS_ODE_OUTCOME_QUOTIENT_COLLISION ||
        !control_search.complete {
        structural_failures = structural_failures + 1
    }
    if forge.generated <= 0 || forge.generated >
        PIREUS_ODE_CANDIDATE_BUDGET ||
        forge.typed_admitted != forge.generated ||
        forge.quotient_collisions + forge.n2_relative_novelty >
        forge.typed_admitted {
        structural_failures = structural_failures + 1
    }
    if forge.n2_relative_novelty > 0 {
        if forge.selected_candidate_id < 0 ||
            forge.selected_search.outcome !=
                PIREUS_ODE_OUTCOME_N2_RELATIVE_NOVELTY ||
            !forge.selected_search.complete ||
            forge.selected_search.separator_count !=
                PIREUS_ODE_SEPARATOR_CAPACITY ||
            !ode_preserves_e0_unit(&forge.selected) {
            structural_failures = structural_failures + 1
        }
    } else if !forge.search_incomplete || forge.selected_candidate_id >= 0 ||
        forge.separators != 0 {
        structural_failures = structural_failures + 1
    }
    if incomplete_search.outcome !=
        PIREUS_ODE_OUTCOME_SEARCH_INCOMPLETE || incomplete_search.complete ||
        incomplete_search.comparisons_completed != 1 {
        structural_failures = structural_failures + 1
    }
    if law.commutator_checks != 4096 || law.associator_checks != 65536 {
        structural_failures = structural_failures + 1
    }
    if emit_transcript {
        print("PIREUS_ODE_LINEAGE garden_match=")
        print_int(if admission.garden_match { 1 } else { 0 })
        print(" contract_match=")
        print_int(if admission.contract_match { 1 } else { 0 })
        print(" parent_source_match=")
        print_int(if admission.parent_source_match { 1 } else { 0 })
        print(" parent_freeze_match=")
        print_int(if admission.parent_freeze_match { 1 } else { 0 })
        print(" parent_parity_match=")
        print_int(if admission.parent_parity_match { 1 } else { 0 })
        print(" parent_evidence_match=")
        print_int(if admission.parent_evidence_match { 1 } else { 0 })
        print(" parent_evidence_hash_delegated=")
        print_int(if admission.parent_evidence_hash_delegated { 1 } else { 0 })
        print(" atlas_reconstruction_match=")
        print_int(if admission.atlas_reconstruction_match { 1 } else { 0 })
        print(" parent_semantics_match=")
        print_int(if admission.parent_semantics_match { 1 } else { 0 })
        print(" residual_witness_match=")
        print_int(if admission.parent_residual_match { 1 } else { 0 })
        print(" atlas_classes=3 atlas_signature_arity=2")
        print(" excluded_typed_arity3_classes=2 basis_cells=")
        print_int(admission.basis_cells)
        print(" tensor_cells_per_class=4096")
        print(" evidence_hash_mode=SOUNIO_DIRECT_SHA256")
        print(" basis_failures="); print_int(admission.basis_failures)
        print(" complete="); print_int(if admission.complete { 1 } else { 0 })
        print("\n")
        print("PIREUS_ODE_GROUP kind=C2_diag unsigned_lane_swap=1 order=2")
        print(" permutation_checks="); print_int(group.permutation_checks)
        print(" multiplication_checks="); print_int(group.multiplication_checks)
        print(" law_checks="); print_int(group.law_checks)
        print(" action_checks="); print_int(group.action_checks)
        print(" failures="); print_int(group.failures)
        print(" complete="); print_int(if group.complete { 1 } else { 0 })
        print("\n")
        print("PIREUS_ODE_GRAMMAR family=enumerated_coefficient_delta")
        print(" grammar_cardinality=7200 candidate_budget=64 generated=")
        print_int(forge.generated)
        print(" typed_admitted="); print_int(forge.typed_admitted)
        print(" typed_rejected=1 e0_unit_preserved_by_construction=1")
        print(" operand_independent_coefficients=1 slot_linearity=1\n")
        ode_emit_tensor(-10, &admission.parent)
        ode_emit_tensor(-11, &admission.affine_address)
        ode_emit_tensor(-12, &admission.coefficient_lift)
        ode_emit_tensor(-1, &control_tensor)
        ode_emit_tensor(0, &first_candidate_tensor)
        if forge.n2_relative_novelty > 0 {
            ode_emit_tensor(forge.selected_candidate_id, &forge.selected)
        }
        ode_emit_search(-1, &control_search, control_canonical)
        if forge.n2_relative_novelty > 0 {
            ode_emit_search(forge.selected_candidate_id,
                &forge.selected_search, selected_canonical)
        }
        ode_emit_search(-2, &incomplete_search,
            ode_canonical_action(&first_candidate_tensor))
        print("PIREUS_ODE_LAW candidate=")
        print_int(forge.selected_candidate_id)
        print(" commutator_checks=")
        print_int(law.commutator_checks)
        print(" commutator_failures="); print_int(law.commutator_failures)
        print(" associator_checks="); print_int(law.associator_checks)
        print(" associator_failures="); print_int(law.associator_failures)
        print(" full_tensor_residuals=1 n3_novelty=0\n")
        negative = 0
        while negative < PIREUS_ODE_NEGATIVE_CASES {
            print("PIREUS_ODE_NEGATIVE id="); print_int(negative)
            print(" pass="); print_int(if negative_cases[negative] { 1 } else { 0 })
            print(" process_launched=0\n")
            negative = negative + 1
        }
        print("PIREUS_ODE_RESULT valid=")
        print_int(if request_error == PIREUS_ODE_OK &&
            structural_failures == 0 && negative_failures == 0 { 1 } else { 0 })
        print(" error="); print_int(request_error)
        print(" structural_failures="); print_int(structural_failures)
        print(" generated="); print_int(forge.generated)
        print(" typed_admitted="); print_int(forge.typed_admitted)
        print(" typed_rejected=1 quotient_collisions=")
        print_int(forge.quotient_collisions +
            if control_search.outcome ==
                PIREUS_ODE_OUTCOME_QUOTIENT_COLLISION { 1 } else { 0 })
        print(" n2_relative_novelty=")
        print_int(forge.n2_relative_novelty)
        print(" incomplete_searches=")
        print_int(1 + if forge.search_incomplete { 1 } else { 0 })
        print(" separators="); print_int(forge.separators)
        print(" negative_failures=")
        print_int(negative_failures)
        print(" n3_novelty=0 n4_novelty=0 historical_novelty=0")
        print(" priority_claim=0 claim_ready=0\n")
    }
    PireusOdeSummary {
        valid: request_error == PIREUS_ODE_OK && admission.complete &&
            group.complete && structural_failures == 0 &&
            negative_failures == 0,
        error: request_error,
        structural_failures: structural_failures,
        group_failures: group.failures,
        generated: forge.generated,
        typed_admitted: forge.typed_admitted,
        typed_rejected: 1,
        quotient_collisions: forge.quotient_collisions +
            if control_search.outcome ==
                PIREUS_ODE_OUTCOME_QUOTIENT_COLLISION { 1 } else { 0 },
        n2_relative_novelty: forge.n2_relative_novelty,
        incomplete_searches: (if incomplete_search.outcome ==
            PIREUS_ODE_OUTCOME_SEARCH_INCOMPLETE { 1 } else { 0 }) +
            (if forge.search_incomplete { 1 } else { 0 }),
        separators: forge.separators,
        negative_failures: negative_failures,
        n3_novelty: false,
        n4_novelty: false,
        historical_novelty: false,
        claim_ready: false,
    }
}
