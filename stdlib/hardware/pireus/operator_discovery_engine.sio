//! Sounio semantic authority for Pireus Operator Discovery Engine v10.
//!
//! The first executable uses the frozen unsigned C2_diag lane-swap group, the
//! three hash-bound bilinear V9 atlas classes expanded into complete 4096-cell
//! structure tensors, an independently enumerated coefficient-program grammar,
//! complete per-class/action separators, and an explicit incomplete-search
//! refusal. The two ternary V9 classes are excluded by the arity-indexed
//! signature. Historical, material, priority, and claim-ready novelty remain
//! false.

use hardware::pireus::operator_novelty_feedback::{
    PIREUS_ONF_LANGUAGE_SOUNIO,
    PIREUS_ONF_LANGUAGE_LEAN,
    PIREUS_ONF_LANGUAGE_KOKA,
    PIREUS_ONF_LANGUAGE_CPP,
    PIREUS_ONF_LANGUAGE_LLM,
    PIREUS_ONF_LANGUAGE_PYTHON,
    PIREUS_ONF_LANGUAGE_RUST,
    PIREUS_ONF_ROLE_SEMANTIC_AUTHORITY,
    PIREUS_ONF_ROLE_FORMAL_PARITY,
    PIREUS_ONF_ROLE_EFFECT_PARITY,
    PIREUS_ONF_ROLE_MATERIAL_PARITY,
    PIREUS_ONF_ROLE_REVIEW_ONLY,
    PIREUS_ONF_STAGE_SOUNIO_EXECUTABLE,
}
use crypto::sha256::{
    SHA256State,
    sha256_init, sha256_update, sha256_finalize, sha256_digest_byte,
    sha256_compress,
}

