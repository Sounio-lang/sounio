//! U250 specialization of the existing Pireus execution-engine ontology.
//!
//! A sealed material receipt may establish an observed FPGA engine. It does
//! not establish an ISA, operation capability, legal lowering, or cost.

use hardware::pireus::model::{
    PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS,
    PIREUS_CLASS_EVIDENCE_ROLE, PIREUS_HAS_OPERATION,
    PIREUS_HAS_EVIDENCE_ROLE,
}
use hardware::pireus::target_profile::{
    PIREUS_CLASS_TARGET, PIREUS_HAS_TARGET, PIREUS_MACHINE_DL380,
}
use hardware::pireus::execution_engine::{
    pireus_execution_engine_store,
    PIREUS_CLASS_EXECUTION_ENGINE,
    PIREUS_CLASS_OBSERVED_EXECUTION_ENGINE,
    PIREUS_CLASS_ENGINE_KIND,
    PIREUS_CLASS_EXECUTION_INTERFACE,
    PIREUS_CLASS_ENGINE_BLUEPRINT,
    PIREUS_MACHINE_HAS_ENGINE,
    PIREUS_ENGINE_HAS_KIND,
    PIREUS_ENGINE_IMPLEMENTS_ISA,
    PIREUS_ENGINE_SUPPORTS_INTERFACE,
    PIREUS_TARGET_DECLARES_BLUEPRINT,
}
use hardware::pireus::u250_dual_card_admission::{
    PIREUS_TARGET_AMD_ALVEO_U250,
    PIREUS_ENGINE_KIND_FPGA,
    PIREUS_FABRIC_XCU250,
    PIREUS_INTERFACE_XRT_XDMA,
    PIREUS_U250_LANGUAGE_SOUNIO,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
    PIREUS_U250_REQUIRED_CARD_COUNT,
    PIREUS_U250_REQUIRED_DDR_BANK_COUNT,
    PIREUS_U250_REQUIRED_DDR_BYTES,
}
use hardware::pireus::u250_material_ingestion::{
    PireusU250MaterialIngestionResult,
    pireus_u250_material_ingestion_matches_expected,
}
use ontology::query::{
    TripleStore, SparqlResult,
    triple_store_add, triple_iri, triple_literal,
    sparql_new, sparql_select, sparql_add_pattern, sparql_execute,
    triple_pattern_new, queryterm_variable, queryterm_iri,
}

pub const PIREUS_U250_ENGINE_SCHEMA: i64 = 712000

pub const PIREUS_CLASS_FPGA_EXECUTION_ENGINE: i64 = 712001
pub const PIREUS_CLASS_FPGA_FABRIC: i64 = 712002
pub const PIREUS_CLASS_ENGINE_SLOT: i64 = 712003
pub const PIREUS_CLASS_MATERIALIZED_ENGINE_SLOT: i64 = 712004
pub const PIREUS_CLASS_UNRESOLVED_ENGINE_SLOT: i64 = 712005
pub const PIREUS_CLASS_EXTERNAL_MEMORY_PROFILE: i64 = 712006

pub const PIREUS_ENGINE_HAS_FABRIC: i64 = 712100
pub const PIREUS_BLUEPRINT_DECLARES_SLOT: i64 = 712101
pub const PIREUS_ENGINE_HAS_MEMORY_PROFILE: i64 = 712102
pub const PIREUS_MEMORY_HAS_BANK_COUNT: i64 = 712103
pub const PIREUS_MEMORY_HAS_BYTE_CAPACITY: i64 = 712104
pub const PIREUS_MATERIAL_MACHINE_MAPS_TO: i64 = 712105

pub const PIREUS_U250_ENGINE_BLUEPRINT: i64 = 712200
pub const PIREUS_U250_ENGINE_SLOT_0: i64 = 712201
pub const PIREUS_U250_ENGINE_SLOT_1: i64 = 712202
pub const PIREUS_U250_MEMORY_PROFILE_4X_DDR_64GIB: i64 = 712203
pub const PIREUS_U250_EVIDENCE_SEALED_MATERIAL_RECEIPT: i64 = 712204

// Frozen parent identifier bridged to target_profile::PIREUS_MACHINE_DL380.
pub const PIREUS_U250_MATERIAL_MACHINE_DL380: i64 = 711005

pub const PIREUS_U250_LITERAL_4: i64 = 712300
pub const PIREUS_U250_LITERAL_64_GIB: i64 = 712301

pub const PIREUS_U250_ENGINE_STATUS_INVALID: i64 = 712090
pub const PIREUS_U250_ENGINE_STATUS_INVENTORY_PARTIAL: i64 = 712091
pub const PIREUS_U250_ENGINE_STATUS_PARENT_REFUSED: i64 = 712092
pub const PIREUS_U250_ENGINE_STATUS_AUTHORITY_REFUSED: i64 = 712093
pub const PIREUS_U250_ENGINE_STATUS_PROJECTION_REFUSED: i64 = 712094
pub const PIREUS_U250_ENGINE_STATUS_CAPABILITY_REFUSED: i64 = 712095
pub const PIREUS_U250_ENGINE_STATUS_PRE_FREEZE_REFUSED: i64 = 712096
pub const PIREUS_U250_ENGINE_STATUS_CLAIM_REFUSED: i64 = 712097
pub const PIREUS_U250_ENGINE_STATUS_PARITY_REFUSED: i64 = 712098

pub struct PireusU250ExecutionEngineRequest {
    pub producer_language: i64,
    pub producer_role: i64,
    pub target_family: i64,
    pub engine_kind: i64,
    pub fabric: i64,
    pub interface: i64,
    pub semantics_frozen: bool,
    pub parity_open_requested: bool,
    pub claim_ready_requested: bool,
    pub xrt_as_isa: bool,
    pub fabric_as_operation: bool,
    pub shell_implies_kernel_correctness: bool,
    pub memory_implies_lowering: bool,
    pub operation_capability_count: i64,
    pub cost_present: bool,
}

pub struct PireusU250ExecutionEngineResult {
    pub valid: bool,
    pub status: i64,
    pub schema: i64,
    pub target_family: i64,
    pub engine_kind: i64,
    pub fabric: i64,
    pub interface: i64,
    pub canonical_target: bool,
    pub parent_material_parity_open: bool,
    pub declared_engine_count: i64,
    pub observed_engine_count: i64,
    pub unresolved_engine_count: i64,
    pub memory_profile_count: i64,
    pub operation_capability_count: i64,
    pub xrt_as_isa: bool,
    pub fabric_as_operation: bool,
    pub inventory_complete: bool,
    pub lowering_authorized: bool,
    pub cost_present: bool,
    pub kernel_correctness_present: bool,
    pub execution_engine_parity_open: bool,
    pub claim_ready: bool,
    pub authority_refused: bool,
    pub projection_refused: bool,
    pub capability_refused: bool,
    pub failures: i64,
}

pub fn pireus_u250_execution_engine_request(
) -> PireusU250ExecutionEngineRequest {
    PireusU250ExecutionEngineRequest {
        producer_language: PIREUS_U250_LANGUAGE_SOUNIO,
        producer_role: PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
        target_family: PIREUS_TARGET_AMD_ALVEO_U250,
        engine_kind: PIREUS_ENGINE_KIND_FPGA,
        fabric: PIREUS_FABRIC_XCU250,
        interface: PIREUS_INTERFACE_XRT_XDMA,
        semantics_frozen: false,
        parity_open_requested: false,
        claim_ready_requested: false,
        xrt_as_isa: false,
        fabric_as_operation: false,
        shell_implies_kernel_correctness: false,
        memory_implies_lowering: false,
        operation_capability_count: 0,
        cost_present: false,
    }
}

fn u250ee_authority_valid(request: &PireusU250ExecutionEngineRequest) -> bool {
    request.producer_language == PIREUS_U250_LANGUAGE_SOUNIO &&
        request.producer_role == PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
}

fn u250ee_projection_valid(request: &PireusU250ExecutionEngineRequest) -> bool {
    request.target_family == PIREUS_TARGET_AMD_ALVEO_U250 &&
        request.engine_kind == PIREUS_ENGINE_KIND_FPGA &&
        request.fabric == PIREUS_FABRIC_XCU250 &&
        request.interface == PIREUS_INTERFACE_XRT_XDMA &&
        !request.xrt_as_isa && !request.fabric_as_operation
}

fn u250ee_capability_clean(request: &PireusU250ExecutionEngineRequest) -> bool {
    !request.shell_implies_kernel_correctness &&
        !request.memory_implies_lowering &&
        request.operation_capability_count == 0 && !request.cost_present
}

pub fn pireus_u250_execution_engine_project(
    parent: &PireusU250MaterialIngestionResult,
    request: &PireusU250ExecutionEngineRequest,
) -> PireusU250ExecutionEngineResult with Mut {
    let parent_valid = pireus_u250_material_ingestion_matches_expected(parent)
    let authority_valid = u250ee_authority_valid(request)
    let projection_valid = u250ee_projection_valid(request)
    let capability_clean = u250ee_capability_clean(request)
    // No engine-parity receipt ingestor exists in v1. The parent material
    // receipt proves card presence only and cannot open this projection.
    let parity_without_receipt = request.parity_open_requested

    var failures: i64 = 0
    if !parent_valid { failures = failures + 1 }
    if !authority_valid { failures = failures + 1 }
    if !projection_valid { failures = failures + 1 }
    if !capability_clean { failures = failures + 1 }
    if parity_without_receipt { failures = failures + 1 }
    if request.claim_ready_requested { failures = failures + 1 }

    var status = PIREUS_U250_ENGINE_STATUS_INVENTORY_PARTIAL
    if request.claim_ready_requested {
        status = PIREUS_U250_ENGINE_STATUS_CLAIM_REFUSED
    }
    if parity_without_receipt {
        status = PIREUS_U250_ENGINE_STATUS_PARITY_REFUSED
    }
    if !capability_clean {
        status = PIREUS_U250_ENGINE_STATUS_CAPABILITY_REFUSED
    }
    if !projection_valid {
        status = PIREUS_U250_ENGINE_STATUS_PROJECTION_REFUSED
    }
    if !authority_valid {
        status = PIREUS_U250_ENGINE_STATUS_AUTHORITY_REFUSED
    }
    if !parent_valid {
        status = PIREUS_U250_ENGINE_STATUS_PARENT_REFUSED
    }

    PireusU250ExecutionEngineResult {
        valid: failures == 0,
        status: status,
        schema: PIREUS_U250_ENGINE_SCHEMA,
        target_family: request.target_family,
        engine_kind: request.engine_kind,
        fabric: request.fabric,
        interface: request.interface,
        canonical_target: projection_valid,
        parent_material_parity_open: parent_valid && parent.parity_open,
        declared_engine_count: if parent_valid {
            parent.declared_card_count
        } else { 0 },
        observed_engine_count: if parent_valid {
            parent.admitted_card_count
        } else { 0 },
        unresolved_engine_count: if parent_valid {
            parent.missing_card_count
        } else { 0 },
        memory_profile_count: if parent_valid {
            parent.admitted_card_count
        } else { 0 },
        operation_capability_count: request.operation_capability_count,
        xrt_as_isa: request.xrt_as_isa,
        fabric_as_operation: request.fabric_as_operation,
        inventory_complete: if parent_valid {
            parent.inventory_complete
        } else { false },
        lowering_authorized: false,
        cost_present: request.cost_present,
        kernel_correctness_present:
            request.shell_implies_kernel_correctness,
        execution_engine_parity_open: false,
        claim_ready: false,
        authority_refused: !authority_valid,
        projection_refused: !projection_valid,
        capability_refused: !capability_clean,
        failures: failures,
    }
}

pub fn pireus_u250_execution_engine_matches_expected(
    result: &PireusU250ExecutionEngineResult,
) -> bool {
    result.valid &&
        result.status == PIREUS_U250_ENGINE_STATUS_INVENTORY_PARTIAL &&
        result.schema == PIREUS_U250_ENGINE_SCHEMA &&
        result.target_family == PIREUS_TARGET_AMD_ALVEO_U250 &&
        result.engine_kind == PIREUS_ENGINE_KIND_FPGA &&
        result.fabric == PIREUS_FABRIC_XCU250 &&
        result.interface == PIREUS_INTERFACE_XRT_XDMA &&
        result.canonical_target && result.parent_material_parity_open &&
        result.declared_engine_count == PIREUS_U250_REQUIRED_CARD_COUNT &&
        result.observed_engine_count == 1 &&
        result.unresolved_engine_count == 1 &&
        result.memory_profile_count == 1 &&
        result.operation_capability_count == 0 &&
        !result.xrt_as_isa && !result.fabric_as_operation &&
        !result.inventory_complete && !result.lowering_authorized &&
        !result.cost_present && !result.kernel_correctness_present &&
        !result.execution_engine_parity_open && !result.claim_ready &&
        !result.authority_refused && !result.projection_refused &&
        !result.capability_refused && result.failures == 0
}

fn u250ee_add_class(store: &TripleStore, class_id: i64) {
    triple_store_add(store, triple_iri(
        class_id, PIREUS_RDF_TYPE, PIREUS_CLASS_ONTOLOGY_CLASS))
}

fn u250ee_add_typed(store: &TripleStore, subject: i64, class_id: i64) {
    triple_store_add(store, triple_iri(subject, PIREUS_RDF_TYPE, class_id))
}

pub fn pireus_u250_execution_engine_store(
    result: &PireusU250ExecutionEngineResult,
) -> TripleStore with Mut {
    var store = pireus_execution_engine_store()
    if !pireus_u250_execution_engine_matches_expected(result) {
        return store
    }

    u250ee_add_class(&store, PIREUS_CLASS_FPGA_EXECUTION_ENGINE)
    u250ee_add_class(&store, PIREUS_CLASS_FPGA_FABRIC)
    u250ee_add_class(&store, PIREUS_CLASS_ENGINE_SLOT)
    u250ee_add_class(&store, PIREUS_CLASS_MATERIALIZED_ENGINE_SLOT)
    u250ee_add_class(&store, PIREUS_CLASS_UNRESOLVED_ENGINE_SLOT)
    u250ee_add_class(&store, PIREUS_CLASS_EXTERNAL_MEMORY_PROFILE)

    u250ee_add_typed(&store, PIREUS_TARGET_AMD_ALVEO_U250,
        PIREUS_CLASS_TARGET)
    u250ee_add_typed(&store, PIREUS_ENGINE_KIND_FPGA,
        PIREUS_CLASS_ENGINE_KIND)
    u250ee_add_typed(&store, PIREUS_FABRIC_XCU250,
        PIREUS_CLASS_FPGA_FABRIC)
    u250ee_add_typed(&store, PIREUS_INTERFACE_XRT_XDMA,
        PIREUS_CLASS_EXECUTION_INTERFACE)
    u250ee_add_typed(&store, PIREUS_U250_EVIDENCE_SEALED_MATERIAL_RECEIPT,
        PIREUS_CLASS_EVIDENCE_ROLE)

    u250ee_add_typed(&store, PIREUS_U250_ENGINE_BLUEPRINT,
        PIREUS_CLASS_ENGINE_BLUEPRINT)
    triple_store_add(&store, triple_iri(
        PIREUS_TARGET_AMD_ALVEO_U250,
        PIREUS_TARGET_DECLARES_BLUEPRINT,
        PIREUS_U250_ENGINE_BLUEPRINT))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_BLUEPRINT,
        PIREUS_ENGINE_HAS_KIND, PIREUS_ENGINE_KIND_FPGA))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_BLUEPRINT,
        PIREUS_ENGINE_HAS_FABRIC, PIREUS_FABRIC_XCU250))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_BLUEPRINT,
        PIREUS_ENGINE_SUPPORTS_INTERFACE, PIREUS_INTERFACE_XRT_XDMA))

    u250ee_add_typed(&store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_CLASS_ENGINE_SLOT)
    u250ee_add_typed(&store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_CLASS_MATERIALIZED_ENGINE_SLOT)
    u250ee_add_typed(&store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_CLASS_EXECUTION_ENGINE)
    u250ee_add_typed(&store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_CLASS_OBSERVED_EXECUTION_ENGINE)
    u250ee_add_typed(&store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_CLASS_FPGA_EXECUTION_ENGINE)
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_BLUEPRINT, PIREUS_BLUEPRINT_DECLARES_SLOT,
        PIREUS_U250_ENGINE_SLOT_0))
    triple_store_add(&store, triple_iri(
        PIREUS_MACHINE_DL380, PIREUS_MACHINE_HAS_ENGINE,
        PIREUS_U250_ENGINE_SLOT_0))
    triple_store_add(&store, triple_iri(
        PIREUS_MACHINE_DL380, PIREUS_HAS_TARGET,
        PIREUS_TARGET_AMD_ALVEO_U250))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_ENGINE_HAS_KIND, PIREUS_ENGINE_KIND_FPGA))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_ENGINE_HAS_FABRIC, PIREUS_FABRIC_XCU250))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_ENGINE_SUPPORTS_INTERFACE, PIREUS_INTERFACE_XRT_XDMA))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_SLOT_0, PIREUS_HAS_EVIDENCE_ROLE,
        PIREUS_U250_EVIDENCE_SEALED_MATERIAL_RECEIPT))

    u250ee_add_typed(&store, PIREUS_U250_ENGINE_SLOT_1,
        PIREUS_CLASS_ENGINE_SLOT)
    u250ee_add_typed(&store, PIREUS_U250_ENGINE_SLOT_1,
        PIREUS_CLASS_UNRESOLVED_ENGINE_SLOT)
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_BLUEPRINT, PIREUS_BLUEPRINT_DECLARES_SLOT,
        PIREUS_U250_ENGINE_SLOT_1))

    u250ee_add_typed(&store, PIREUS_U250_MEMORY_PROFILE_4X_DDR_64GIB,
        PIREUS_CLASS_EXTERNAL_MEMORY_PROFILE)
    triple_store_add(&store, triple_literal(
        PIREUS_U250_MEMORY_PROFILE_4X_DDR_64GIB,
        PIREUS_MEMORY_HAS_BANK_COUNT, PIREUS_U250_LITERAL_4,
        PIREUS_U250_REQUIRED_DDR_BANK_COUNT as f64))
    triple_store_add(&store, triple_literal(
        PIREUS_U250_MEMORY_PROFILE_4X_DDR_64GIB,
        PIREUS_MEMORY_HAS_BYTE_CAPACITY, PIREUS_U250_LITERAL_64_GIB,
        PIREUS_U250_REQUIRED_DDR_BYTES as f64))
    triple_store_add(&store, triple_iri(
        PIREUS_U250_ENGINE_SLOT_0, PIREUS_ENGINE_HAS_MEMORY_PROFILE,
        PIREUS_U250_MEMORY_PROFILE_4X_DDR_64GIB))

    triple_store_add(&store, triple_iri(
        PIREUS_U250_MATERIAL_MACHINE_DL380,
        PIREUS_MATERIAL_MACHINE_MAPS_TO, PIREUS_MACHINE_DL380))
    store
}

fn u250ee_query_type(store: &TripleStore, class_id: i64) -> SparqlResult
with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(class_id)))
    sparql_execute(store, &query)
}

fn u250ee_query_object(
    store: &TripleStore, subject: i64, predicate: i64,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_iri(subject), queryterm_iri(predicate),
        queryterm_variable(0)))
    sparql_execute(store, &query)
}

pub fn pireus_u250_query_observed_engines(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    var query = sparql_new()
    sparql_select(&query, 0)
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_RDF_TYPE),
        queryterm_iri(PIREUS_CLASS_OBSERVED_EXECUTION_ENGINE)))
    sparql_add_pattern(&query, triple_pattern_new(
        queryterm_variable(0), queryterm_iri(PIREUS_ENGINE_HAS_FABRIC),
        queryterm_iri(PIREUS_FABRIC_XCU250)))
    sparql_execute(store, &query)
}

pub fn pireus_u250_query_unresolved_slots(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ee_query_type(store, PIREUS_CLASS_UNRESOLVED_ENGINE_SLOT)
}

pub fn pireus_u250_query_memory_profiles(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ee_query_type(store, PIREUS_CLASS_EXTERNAL_MEMORY_PROFILE)
}

pub fn pireus_u250_query_blueprint_slots(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ee_query_object(store, PIREUS_U250_ENGINE_BLUEPRINT,
        PIREUS_BLUEPRINT_DECLARES_SLOT)
}

pub fn pireus_u250_query_engine_isa(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ee_query_object(store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_ENGINE_IMPLEMENTS_ISA)
}

pub fn pireus_u250_query_engine_operations(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ee_query_object(store, PIREUS_U250_ENGINE_SLOT_0,
        PIREUS_HAS_OPERATION)
}

pub fn pireus_u250_query_machine_bridge(
    store: &TripleStore,
) -> SparqlResult with Mut, Epistemic {
    u250ee_query_object(store, PIREUS_U250_MATERIAL_MACHINE_DL380,
        PIREUS_MATERIAL_MACHINE_MAPS_TO)
}
