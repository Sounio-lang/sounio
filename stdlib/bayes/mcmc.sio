// stdlib/bayes/mcmc.sio — Metropolis-Hastings MCMC Sampler
//
// Bayesian posterior sampling with epistemic uncertainty tracking.
// Bridges posterior distributions to GUM-compliant measurement uncertainty.
//
// References:
// - Metropolis et al. (1953): "Equation of state calculations by fast computing machines"
// - Hastings (1970): "Monte Carlo sampling methods using Markov chains and their applications"
// - Gelman et al. (2013): "Bayesian Data Analysis", 3rd ed.
// - JCGM 100:2008 (GUM): Guide to the Expression of Uncertainty in Measurement

use epistemic::gum::{GUMResult, gum_simple}

extern "C" {
    fn log(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn sqrt(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
}

// ============================================================================
// Math helpers
// ============================================================================

fn mcmc_pi() -> f64 { 3.14159265358979323846 }

fn mcmc_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

fn mcmc_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// Cosine approximation — maps x to [0, 2π] then applies a Chebyshev-style approx
// by folding to [-π, π] and computing cos via higher-order Taylor or section.
// Accurate enough for Box-Muller (we only need |cos| ≤ 1).
fn mcmc_cos(x: f64) -> f64 {
    // Reduce to [0, 2π]
    var t = x
    let two_pi = 2.0 * mcmc_pi()
    let pi = mcmc_pi()
    while t < 0.0 { t = t + two_pi }
    while t >= two_pi { t = t - two_pi }
    // Fold to [0, π], flip sign for second half
    var sign = 1.0
    if t > pi {
        t = two_pi - t
        // cos(2π - t) = cos(t), so no sign change here
    }
    // Further fold to [0, π/2], cos is even around π/2
    let half_pi = pi * 0.5
    if t > half_pi {
        t = pi - t
        sign = 0.0 - sign
    }
    // Now t in [0, π/2], use higher-order Taylor for accuracy
    // cos(t) = 1 - t²/2! + t⁴/4! - t⁶/6! + t⁸/8! - t¹⁰/10!
    let t2 = t * t
    let t4 = t2 * t2
    let t6 = t4 * t2
    let t8 = t4 * t4
    let t10 = t8 * t2
    let c = 1.0 - t2 / 2.0 + t4 / 24.0 - t6 / 720.0 + t8 / 40320.0 - t10 / 3628800.0
    sign * c
}

// ============================================================================
// MCMC CONFIGURATION
// ============================================================================

pub struct MCMCConfig {
    pub n_samples: i32,     // Number of posterior samples to collect
    pub n_burnin: i32,      // Burn-in (warmup) samples to discard
    pub step_size: f64,     // Proposal step size (std dev of normal proposal)
    pub model_id: i32,      // 0=normal_mean, 1=normal_variance, 2=linear_slope
}

pub fn mcmc_config_default(model_id: i32) -> MCMCConfig {
    MCMCConfig {
        n_samples: 1000,
        n_burnin: 200,
        step_size: 0.1,
        model_id: model_id,
    }
}

// ============================================================================
// MCMC RESULT
// ============================================================================

pub struct MCMCResult {
    pub samples: [f64; 1024],   // Posterior samples (up to 1024)
    pub n_samples: i32,          // Actual number of samples collected
    pub acceptance_rate: f64,    // Fraction of proposals accepted
    pub mean: f64,               // Posterior mean
    pub std_dev: f64,            // Posterior standard deviation
    pub as_gum: GUMResult,       // Epistemic bridge: posterior -> GUMResult
}

// ============================================================================
// PSEUDO-RANDOM NUMBER GENERATION (LCG)
// ============================================================================
// LCG parameters from Numerical Recipes: a=1664525, c=1013904223, m=2^32
// Returns updated state for pure functional threading of random state.

pub struct LCGResult {
    pub value: f64,
    pub state: i64,
}

pub fn lcg_next(state: i64) -> i64 {
    let a: i64 = 1664525
    let c: i64 = 1013904223
    let m: i64 = 4294967296
    (a * state + c) % m
}

// Returns LCGResult{value=uniform[0,1], state=new_state}
pub fn lcg_uniform(state: i64) -> LCGResult {
    let next = lcg_next(state)
    let m: i64 = 4294967296
    let u = (next as f64) / (m as f64)
    LCGResult { value: u, state: next }
}

// Returns LCGResult{value=standard_normal, state=new_state} via Box-Muller transform
pub fn lcg_normal(state: i64) -> LCGResult with Div, Panic {
    let r1 = lcg_uniform(state)
    var u1 = r1.value
    let s1 = r1.state
    if u1 < 1.0e-10 { u1 = 1.0e-10 }
    let r2 = lcg_uniform(s1)
    let u2 = r2.value
    let s2 = r2.state
    let z = mcmc_sqrt(0.0 - 2.0 * log(u1)) * mcmc_cos(2.0 * mcmc_pi() * u2)
    LCGResult { value: z, state: s2 }
}

// ============================================================================
// LOG-LIKELIHOOD FUNCTIONS
// ============================================================================

// model_id=0: Normal mean inference, known variance=1
// log p(data | theta) = -0.5 * sum((x_i - theta)^2) (omitting constants)
fn log_lik_normal_mean(theta: f64, data: &[f64; 256], n_data: i32) -> f64 {
    var lsum = 0.0
    var i: i32 = 0
    while i < n_data {
        let d = data[i as usize] - theta
        lsum = lsum - 0.5 * d * d
        i = i + 1
    }
    lsum
}

// model_id=1: Normal variance inference, known mean=0
// log p(data | theta) = -n/2*log(theta) - sum(x_i^2)/(2*theta), theta>0
fn log_lik_normal_var(theta: f64, data: &[f64; 256], n_data: i32) -> f64 {
    if theta <= 0.0 { return 0.0 - 1.0e30 }
    var lsum = 0.0 - (n_data as f64) * 0.5 * log(theta)
    var i: i32 = 0
    while i < n_data {
        lsum = lsum - data[i as usize] * data[i as usize] / (2.0 * theta)
        i = i + 1
    }
    lsum
}

// model_id=2: Linear slope inference, y = theta*x + noise (variance=1)
// log p(y | theta, x) = -0.5 * sum((y_i - theta*x_i)^2)
fn log_lik_linear_slope(theta: f64, x_data: &[f64; 256], y_data: &[f64; 256], n_data: i32) -> f64 {
    var lsum = 0.0
    var i: i32 = 0
    while i < n_data {
        let resid = y_data[i as usize] - theta * x_data[i as usize]
        lsum = lsum - 0.5 * resid * resid
        i = i + 1
    }
    lsum
}

// Compute log-likelihood for normal_mean or normal_var models (single data array)
fn dispatch_log_lik(model_id: i32, theta: f64, data: &[f64; 256], n_data: i32) -> f64 {
    if model_id == 0 {
        return log_lik_normal_mean(theta, data, n_data)
    }
    if model_id == 1 {
        return log_lik_normal_var(theta, data, n_data)
    }
    // model_id=2 handled separately (needs x_data and y_data)
    log_lik_normal_mean(theta, data, n_data)
}

// ============================================================================
// POSTERIOR SUMMARY COMPUTATION
// ============================================================================

fn compute_posterior_mean(samples: &[f64; 1024], n: i32) -> f64 {
    if n == 0 { return 0.0 }
    var s = 0.0
    var i: i32 = 0
    while i < n {
        s = s + samples[i as usize]
        i = i + 1
    }
    s / (n as f64)
}

fn compute_posterior_std(samples: &[f64; 1024], n: i32, mean: f64) -> f64 {
    if n <= 1 { return 0.0 }
    var ss = 0.0
    var i: i32 = 0
    while i < n {
        let d = samples[i as usize] - mean
        ss = ss + d * d
        i = i + 1
    }
    mcmc_sqrt(ss / ((n - 1) as f64))
}

// ============================================================================
// METROPOLIS-HASTINGS SAMPLER — single data array (model 0 or 1)
// ============================================================================

pub fn mcmc_run(config: MCMCConfig, data: &[f64; 256], n_data: i32, seed: i64) -> MCMCResult {
    var samples: [f64; 1024] = [0.0; 1024]

    // Initialize theta at data mean (faster convergence than starting at 0)
    var init_sum = 0.0
    var ii: i32 = 0
    while ii < n_data {
        init_sum = init_sum + data[ii as usize]
        ii = ii + 1
    }
    var rng_state = seed
    var theta = if n_data > 0 { init_sum / (n_data as f64) } else { 0.0 }
    var log_lik_cur = dispatch_log_lik(config.model_id, theta, data, n_data)

    var n_accepted: i32 = 0
    var n_total: i32 = 0

    // Burn-in phase
    var bi: i32 = 0
    while bi < config.n_burnin {
        let prop_r = lcg_normal(rng_state)
        let z = prop_r.value
        rng_state = prop_r.state

        let theta_new = theta + config.step_size * z
        let log_lik_new = dispatch_log_lik(config.model_id, theta_new, data, n_data)
        let log_alpha = log_lik_new - log_lik_cur

        let u_r = lcg_uniform(rng_state)
        let u = u_r.value
        rng_state = u_r.state

        let log_u = log(if u < 1.0e-30 { 1.0e-30 } else { u })
        if log_u < log_alpha {
            theta = theta_new
            log_lik_cur = log_lik_new
        }
        bi = bi + 1
    }

    // Collection phase
    let max_store: i32 = 1024
    var sample_idx: i32 = 0
    let to_collect = if config.n_samples < max_store { config.n_samples } else { max_store }

    var si: i32 = 0
    while si < to_collect {
        let prop_r = lcg_normal(rng_state)
        let z = prop_r.value
        rng_state = prop_r.state

        let theta_new = theta + config.step_size * z
        let log_lik_new = dispatch_log_lik(config.model_id, theta_new, data, n_data)
        let log_alpha = log_lik_new - log_lik_cur

        let u_r = lcg_uniform(rng_state)
        let u = u_r.value
        rng_state = u_r.state

        let log_u = log(if u < 1.0e-30 { 1.0e-30 } else { u })
        if log_u < log_alpha {
            theta = theta_new
            log_lik_cur = log_lik_new
            n_accepted = n_accepted + 1
        }
        n_total = n_total + 1

        samples[sample_idx as usize] = theta
        sample_idx = sample_idx + 1
        si = si + 1
    }

    let n_collected = sample_idx
    let acc_rate = if n_total > 0 { (n_accepted as f64) / (n_total as f64) } else { 0.0 }
    let post_mean = compute_posterior_mean(&samples, n_collected)
    let post_std = compute_posterior_std(&samples, n_collected, post_mean)
    let gum = gum_simple(post_mean, post_std)

    MCMCResult {
        samples: samples,
        n_samples: n_collected,
        acceptance_rate: acc_rate,
        mean: post_mean,
        std_dev: post_std,
        as_gum: gum,
    }
}

// ============================================================================
// METROPOLIS-HASTINGS SAMPLER — linear slope model (model 2)
// ============================================================================

pub fn mcmc_run_linear(config: MCMCConfig, x_data: &[f64; 256], y_data: &[f64; 256], n_data: i32, seed: i64) -> MCMCResult {
    var samples: [f64; 1024] = [0.0; 1024]

    // Initialize theta at OLS slope estimate: sum(x*y) / sum(x^2)
    var sum_xy = 0.0
    var sum_xx = 0.0
    var li: i32 = 0
    while li < n_data {
        sum_xy = sum_xy + x_data[li as usize] * y_data[li as usize]
        sum_xx = sum_xx + x_data[li as usize] * x_data[li as usize]
        li = li + 1
    }
    var rng_state = seed
    var theta = if sum_xx > 1.0e-15 { sum_xy / sum_xx } else { 0.0 }
    var log_lik_cur = log_lik_linear_slope(theta, x_data, y_data, n_data)

    var n_accepted: i32 = 0
    var n_total: i32 = 0

    // Burn-in phase
    var bi: i32 = 0
    while bi < config.n_burnin {
        let prop_r = lcg_normal(rng_state)
        let z = prop_r.value
        rng_state = prop_r.state

        let theta_new = theta + config.step_size * z
        let log_lik_new = log_lik_linear_slope(theta_new, x_data, y_data, n_data)
        let log_alpha = log_lik_new - log_lik_cur

        let u_r = lcg_uniform(rng_state)
        let u = u_r.value
        rng_state = u_r.state

        let log_u = log(if u < 1.0e-30 { 1.0e-30 } else { u })
        if log_u < log_alpha {
            theta = theta_new
            log_lik_cur = log_lik_new
        }
        bi = bi + 1
    }

    // Collection phase
    let max_store: i32 = 1024
    var sample_idx: i32 = 0
    let to_collect = if config.n_samples < max_store { config.n_samples } else { max_store }

    var si: i32 = 0
    while si < to_collect {
        let prop_r = lcg_normal(rng_state)
        let z = prop_r.value
        rng_state = prop_r.state

        let theta_new = theta + config.step_size * z
        let log_lik_new = log_lik_linear_slope(theta_new, x_data, y_data, n_data)
        let log_alpha = log_lik_new - log_lik_cur

        let u_r = lcg_uniform(rng_state)
        let u = u_r.value
        rng_state = u_r.state

        let log_u = log(if u < 1.0e-30 { 1.0e-30 } else { u })
        if log_u < log_alpha {
            theta = theta_new
            log_lik_cur = log_lik_new
            n_accepted = n_accepted + 1
        }
        n_total = n_total + 1

        samples[sample_idx as usize] = theta
        sample_idx = sample_idx + 1
        si = si + 1
    }

    let n_collected = sample_idx
    let acc_rate = if n_total > 0 { (n_accepted as f64) / (n_total as f64) } else { 0.0 }
    let post_mean = compute_posterior_mean(&samples, n_collected)
    let post_std = compute_posterior_std(&samples, n_collected, post_mean)
    let gum = gum_simple(post_mean, post_std)

    MCMCResult {
        samples: samples,
        n_samples: n_collected,
        acceptance_rate: acc_rate,
        mean: post_mean,
        std_dev: post_std,
        as_gum: gum,
    }
}
