// bayes/vi.sio — Variational Inference (Mean-Field Gaussian)
//
// ELBO maximization for approximate Bayesian inference.
// Uses mean-field Gaussian approximation with reparameterization trick.
//
// References:
// - Blei, Kucukelbir, McAuliffe (2017): "Variational Inference: A Review"
// - Kingma & Welling (2014): "Auto-Encoding Variational Bayes"
// - Kucukelbir et al. (2017): "Automatic Differentiation Variational Inference"

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
}

fn vi_pi() -> f64 { 3.14159265358979323846 }

fn vi_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn vi_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

// ============================================================================
// VI PARAMETERS — Mean-field Gaussian q(theta) = N(mu, sigma^2)
// ============================================================================

pub struct VIParams {
    mu: [f64; 16],       // Variational means
    sigma: [f64; 16],    // Variational standard deviations (>0)
    n_params: i32,       // Number of active parameters (max 16)
}

pub fn vi_params_new(n: i32) -> VIParams {
    var mu: [f64; 16] = [0.0; 16]
    var sigma: [f64; 16] = [1.0; 16]
    VIParams { mu: mu, sigma: sigma, n_params: n }
}

// ============================================================================
// PSEUDO-RANDOM (LCG)
// ============================================================================

fn vi_lcg_next(state: i64) -> i64 {
    let a: i64 = 1664525
    let c: i64 = 1013904223
    let m: i64 = 4294967296
    (a * state + c) % m
}

fn vi_lcg_uniform(state: i64) -> (f64, i64) {
    let next = vi_lcg_next(state)
    let m: i64 = 4294967296
    let u = (next as f64) / (m as f64)
    (u, next)
}

// ============================================================================
// EVIDENCE LOWER BOUND (ELBO)
// ============================================================================
// ELBO = E_q[log p(data|theta)] - KL(q || prior)
//
// For mean-field Gaussian q and standard normal prior:
//   KL = sum_j [ -0.5 - log(sigma_j) + 0.5*(mu_j^2 + sigma_j^2) ]
//
// We approximate E_q[log p(data|theta)] using the variational mean.
// Assumes normal likelihood: data ~ N(theta[0], 1) for simplicity.

pub fn vi_elbo(params: VIParams, data: &[f64; 256], n_data: i32) -> f64 {
    // Expected log-likelihood at variational mean (plug-in approximation)
    // Assumes: data[i] ~ N(params.mu[0], 1)
    var ll = 0.0
    var i: i32 = 0
    while i < n_data {
        let d = data[i as usize] - params.mu[0]
        ll = ll - 0.5 * d * d
        i = i + 1
    }

    // KL divergence from q to standard normal prior N(0, 1)
    var kl = 0.0
    var j: i32 = 0
    while j < params.n_params {
        let mu_j = params.mu[j as usize]
        var sig_j = params.sigma[j as usize]
        if sig_j < 1.0e-10 { sig_j = 1.0e-10 }
        kl = kl + 0.0 - 0.5 - log(sig_j) + 0.5 * (mu_j * mu_j + sig_j * sig_j)
        j = j + 1
    }

    ll - kl
}

// ============================================================================
// VARIATIONAL GRADIENT STEP
// ============================================================================
// Gradient of ELBO w.r.t. mu and sigma (analytical for Gaussian case).
//
// d ELBO / d mu[0] = sum_i (data[i] - mu[0]) - mu[0]  (likelihood gradient + prior gradient)
// d ELBO / d sigma[j] = 1/sigma[j] - sigma[j]  (entropy gradient + KL gradient)

pub fn vi_step(params: VIParams, data: &[f64; 256], n_data: i32, lr: f64) -> VIParams {
    var new_mu: [f64; 16] = [0.0; 16]
    var new_sigma: [f64; 16] = [0.0; 16]

    // Copy current values
    var k: i32 = 0
    while k < 16 {
        new_mu[k as usize] = params.mu[k as usize]
        new_sigma[k as usize] = params.sigma[k as usize]
        k = k + 1
    }

    // Gradient for mu[0] (the mean parameter)
    var grad_mu0 = 0.0
    var i: i32 = 0
    while i < n_data {
        grad_mu0 = grad_mu0 + (data[i as usize] - params.mu[0])
        i = i + 1
    }
    // Prior gradient: d/dmu[-0.5 * mu^2] = -mu
    grad_mu0 = grad_mu0 - params.mu[0]
    new_mu[0] = params.mu[0] + lr * grad_mu0

    // Gradient for sigma (entropy + KL)
    var j: i32 = 0
    while j < params.n_params {
        var sig_j = params.sigma[j as usize]
        if sig_j < 1.0e-10 { sig_j = 1.0e-10 }
        // d ELBO / d sigma = 1/sigma - sigma
        let grad_sig = 1.0 / sig_j - sig_j
        var new_sig = sig_j + lr * grad_sig
        // Enforce positivity
        if new_sig < 1.0e-6 { new_sig = 1.0e-6 }
        new_sigma[j as usize] = new_sig
        j = j + 1
    }

    VIParams { mu: new_mu, sigma: new_sigma, n_params: params.n_params }
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_vi_params_new() -> i32 {
    let p = vi_params_new(3)
    if p.n_params != 3 { return 1 }
    if vi_abs(p.mu[0]) > 0.001 { return 2 }
    if vi_abs(p.sigma[0] - 1.0) > 0.001 { return 3 }
    0
}

//@ run-pass
fn test_vi_elbo_computes() -> i32 {
    let p = vi_params_new(1)
    var data: [f64; 256] = [0.0; 256]
    data[0] = 1.0
    data[1] = 2.0
    data[2] = 1.5
    let elbo = vi_elbo(p, &data, 3)
    // ELBO should be finite and negative
    if elbo > 0.0 { return 1 }
    0
}

//@ run-pass
fn test_vi_step_moves_toward_data() -> i32 {
    var p = vi_params_new(1)
    var data: [f64; 256] = [0.0; 256]
    // All data at 5.0
    var i: i32 = 0
    while i < 10 {
        data[i as usize] = 5.0
        i = i + 1
    }
    // After a step, mu[0] should move toward 5.0
    let p2 = vi_step(p, &data, 10, 0.01)
    if p2.mu[0] <= 0.0 { return 1 }  // should be positive, moving toward 5
    0
}
