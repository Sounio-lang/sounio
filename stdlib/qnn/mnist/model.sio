// stdlib/qnn/mnist/model.sio — MNIST quaternion classifier model
//
// Two-layer feedforward: conv features -> fc -> 10 classes.

// ============================================================================
// TYPES
// ============================================================================

struct QMnistModel {
    conv: [f64; 1024],      // convolution weights
    fc: [f64; 4096],        // fully-connected weights
    n_classes: i32
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

fn qmnist_model_new(n_classes: i32) -> QMnistModel {
    QMnistModel {
        conv: [0.0; 1024],
        fc: [0.0; 4096],
        n_classes: n_classes
    }
}

fn qmnist_model_default() -> QMnistModel {
    qmnist_model_new(10)
}

// Initialize with deterministic pseudo-random weights
fn qmnist_model_init(n_classes: i32, seed: i32) -> QMnistModel {
    var model = qmnist_model_new(n_classes)
    var rng = seed

    // Init conv weights
    var i: i32 = 0
    while i < 1024 {
        rng = rng * 1103515245 + 12345
        var val = rng
        if val < 0 { val = 0 - val }
        let cv = ((val % 1000) - 500) as f64
        model.conv[i] = cv / 5000.0
        i = i + 1
    }

    // Init fc weights
    i = 0
    while i < 4096 {
        rng = rng * 1103515245 + 12345
        var val = rng
        if val < 0 { val = 0 - val }
        let fv = ((val % 1000) - 500) as f64
        model.fc[i] = fv / 5000.0
        i = i + 1
    }
    model
}

// ============================================================================
// TESTS
// ============================================================================

fn test_model_new() -> bool {
    let m = qmnist_model_default()
    m.n_classes == 10
}

fn test_model_init() -> bool {
    let m = qmnist_model_init(10, 42)
    m.n_classes == 10
}
