// stdlib/qnn/mnist/metrics.sio — MNIST evaluation metrics
//
// Accuracy computation for digit classification.

// ============================================================================
// HELPERS
// ============================================================================

fn qmet_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn qmet_i32_to_f64(n: i32) -> f64 {
    var r = 0.0
    var i: i32 = 0
    if n > 0 {
        while i < n {
            r = r + 1.0
            i = i + 1
        }
    }
    r
}

// ============================================================================
// METRICS
// ============================================================================

// Compute accuracy: fraction of correct predictions.
fn qmnist_accuracy(predictions: &[i32; 64], labels: &[i32; 64], n: i32) -> f64 {
    if n < 1 { return 0.0 }
    var correct: i32 = 0
    var i: i32 = 0
    while i < n {
        if i < 64 {
            if predictions[i] == labels[i] {
                correct = correct + 1
            }
        }
        i = i + 1
    }
    let cf = qmet_i32_to_f64(correct)
    let nf = qmet_i32_to_f64(n)
    if nf < 1.0 { return 0.0 }
    cf / nf
}

// Per-class accuracy: compute accuracy for a single target class.
fn qmnist_class_accuracy(predictions: &[i32; 64], labels: &[i32; 64], n: i32, target_class: i32) -> f64 {
    if n < 1 { return 0.0 }
    var correct: i32 = 0
    var total: i32 = 0
    var i: i32 = 0
    while i < n {
        if i < 64 {
            if labels[i] == target_class {
                total = total + 1
                if predictions[i] == target_class {
                    correct = correct + 1
                }
            }
        }
        i = i + 1
    }
    if total < 1 { return 0.0 }
    let cf = qmet_i32_to_f64(correct)
    let tf = qmet_i32_to_f64(total)
    cf / tf
}

// ============================================================================
// TESTS
// ============================================================================

fn test_accuracy_perfect() -> bool {
    var preds = [0; 64]
    var labels = [0; 64]
    preds[0] = 1
    preds[1] = 2
    preds[2] = 3
    labels[0] = 1
    labels[1] = 2
    labels[2] = 3
    let acc = qmnist_accuracy(&preds, &labels, 3)
    qmet_abs(acc - 1.0) < 0.001
}

fn test_accuracy_half() -> bool {
    var preds = [0; 64]
    var labels = [0; 64]
    preds[0] = 1
    preds[1] = 2
    labels[0] = 1
    labels[1] = 9
    let acc = qmnist_accuracy(&preds, &labels, 2)
    qmet_abs(acc - 0.5) < 0.001
}

fn test_accuracy_zero() -> bool {
    var preds = [0; 64]
    var labels = [1; 64]
    let acc = qmnist_accuracy(&preds, &labels, 4)
    qmet_abs(acc) < 0.001
}
