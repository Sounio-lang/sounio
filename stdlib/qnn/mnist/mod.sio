//! stdlib/qnn/mnist/mod.sio - MNIST QNN Module
//!
//! Complete Quaternion Neural Network implementation for MNIST classification.
//! Demonstrates 4 optimizations: INT8 quantization, SIMD, memory layout, fused kernels.
//!
//! ## Architecture
//! ```
//! Input: 784 pixels → 196 quaternions (4 pixels per quaternion)
//!        ↓
//! QuatLinear(196 → 64) + QuatReLU
//!        ↓
//! QuatLinear(64 → 32) + QuatReLU
//!        ↓
//! QuatLinear(32 → 10)
//!        ↓
//! QuatMagnitude → Softmax → CrossEntropy
//! ```
//!
//! ## Usage
//! ```sio
//! use qnn::mnist::*
//!
//! fn main() with IO {
//!     let train_data = mnist_load_train("./data/mnist")
//!     let test_data = mnist_load_test("./data/mnist")
//!
//!     let config = default_config()
//!     let train_cfg = default_training_config()
//!
//!     let state = train(&train_data, &test_data, &train_cfg, &config, 42)
//!
//!     // INT8 quantization
//!     let quantized = quantize_model(&state.model)
//!     let int8_acc = evaluate_accuracy_int8(&quantized, &test_data, &config)
//! }
//! ```

// MNIST QNN Module
//
// Import submodules directly in your code using:
//   use qnn::mnist::data_loader::*
//   use qnn::mnist::model::*
//   use qnn::mnist::training::*
//   use qnn::mnist::metrics::*
//   use qnn::mnist::inference::*
//
// Example:
//   use qnn::mnist::data_loader::{mnist_load_train, mnist_load_test}
//   use qnn::mnist::training::{train, default_config}
