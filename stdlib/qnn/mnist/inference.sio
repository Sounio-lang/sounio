//! stdlib/qnn/mnist/inference.sio - INT8 Quantized Inference
//!
//! Provides post-training quantization for QNN MNIST model.
//! Achieves 4x memory reduction with <2% accuracy degradation.
//!
//! Quantization scheme: Per-quaternion symmetric INT8
//! scale = max(|w|, |x|, |y|, |z|) / 127

use qnn::mnist::model::*
use qnn::mnist::data_loader::*

// INT8 quaternion representation
struct QuatI8 {
    w: i8,
    x: i8,
    y: i8,
    z: i8,
}

// Quantized model with per-quaternion scales
struct QnnMnistQuantized {
    // Layer 1
    layer1_weights_q: [QuatI8],
    layer1_scales: [f32],
    layer1_bias: [Quat],  // Keep biases in FP32
    // Layer 2
    layer2_weights_q: [QuatI8],
    layer2_scales: [f32],
    layer2_bias: [Quat],
    // Layer 3
    layer3_weights_q: [QuatI8],
    layer3_scales: [f32],
    layer3_bias: [Quat],
}

// Return type for quantize_array (avoids tuple destructuring)
struct QuantizeArrayResult {
    quantized: [QuatI8],
    scales: [f32],
}

// ============================================================================
// Quantization Functions
// ============================================================================

// Compute scale for a quaternion (symmetric quantization)
fn compute_quat_scale(q: Quat) -> f32 {
    let abs_w = if q.w >= 0.0 { q.w } else { -q.w }
    let abs_x = if q.x >= 0.0 { q.x } else { -q.x }
    let abs_y = if q.y >= 0.0 { q.y } else { -q.y }
    let abs_z = if q.z >= 0.0 { q.z } else { -q.z }

    var max_val = abs_w
    if abs_x > max_val { max_val = abs_x }
    if abs_y > max_val { max_val = abs_y }
    if abs_z > max_val { max_val = abs_z }

    // Avoid division by zero
    if max_val < 1e-7 { max_val = 1e-7 }
    max_val / 127.0
}

// Clamp floating point value to [-127, 127] signed byte range
fn clamp_i8(val: f32) -> i8 {
    let rounded = round_f32(val)
    if rounded > 127.0 { 127 }
    else if rounded < -127.0 { -127 }
    else { rounded as i8 }
}

// Quantize a single quaternion to INT8
fn quantize_quat(q: Quat, scale: f32) -> QuatI8 {
    let inv_scale = 1.0 / scale

    QuatI8 {
        w: clamp_i8(q.w * inv_scale),
        x: clamp_i8(q.x * inv_scale),
        y: clamp_i8(q.y * inv_scale),
        z: clamp_i8(q.z * inv_scale),
    }
}

// Dequantize INT8 quaternion back to FP32
fn dequantize_quat(q: QuatI8, scale: f32) -> Quat {
    Quat {
        w: (q.w as f32) * scale,
        x: (q.x as f32) * scale,
        y: (q.y as f32) * scale,
        z: (q.z as f32) * scale,
    }
}

// Quantize array of quaternions
fn quantize_array(quats: &[Quat], num_quats: i32) -> QuantizeArrayResult {
    var quantized: [QuatI8]
    var scales: [f32]

    var i: i32 = 0
    while i < num_quats {
        let scale = compute_quat_scale(quats[i])
        scales = scales ++ [scale]
        quantized = quantized ++ [quantize_quat(quats[i], scale)]
        i = i + 1
    }

    QuantizeArrayResult {
        quantized: quantized,
        scales: scales,
    }
}

// Dequantize array back to FP32
fn dequantize_array(quats: &[QuatI8], scales: &[f32], num_quats: i32) -> [Quat] {
    var result: [Quat]
    var i: i32 = 0
    while i < num_quats {
        result = result ++ [dequantize_quat(quats[i], scales[i])]
        i = i + 1
    }
    result
}

// ============================================================================
// Model Quantization
// ============================================================================

// Quantize full model (post-training quantization)
fn quantize_model(model: &QnnMnistModel, config: &QnnMnistConfig) -> QnnMnistQuantized {
    let l1_size = config.input_dim * config.hidden1
    let l1_result = quantize_array(&model.layer1_weights, l1_size)
    let l1_wq = l1_result.quantized
    let l1_s = l1_result.scales

    let l2_size = config.hidden1 * config.hidden2
    let l2_result = quantize_array(&model.layer2_weights, l2_size)
    let l2_wq = l2_result.quantized
    let l2_s = l2_result.scales

    let l3_size = config.hidden2 * config.output_dim
    let l3_result = quantize_array(&model.layer3_weights, l3_size)
    let l3_wq = l3_result.quantized
    let l3_s = l3_result.scales

    // Copy biases (no .clone() method, copy manually)
    var l1_bias: [Quat]
    var i: i32 = 0
    while i < config.hidden1 {
        l1_bias = l1_bias ++ [model.layer1_bias[i]]
        i = i + 1
    }

    var l2_bias: [Quat]
    i = 0
    while i < config.hidden2 {
        l2_bias = l2_bias ++ [model.layer2_bias[i]]
        i = i + 1
    }

    var l3_bias: [Quat]
    i = 0
    while i < config.output_dim {
        l3_bias = l3_bias ++ [model.layer3_bias[i]]
        i = i + 1
    }

    QnnMnistQuantized {
        layer1_weights_q: l1_wq,
        layer1_scales: l1_s,
        layer1_bias: l1_bias,
        layer2_weights_q: l2_wq,
        layer2_scales: l2_s,
        layer2_bias: l2_bias,
        layer3_weights_q: l3_wq,
        layer3_scales: l3_s,
        layer3_bias: l3_bias,
    }
}

// ============================================================================
// INT8 Inference
// ============================================================================

// INT8 linear layer forward (dequantize-compute)
fn quat_linear_forward_int8(
    input: &[Quat],
    weights_q: &[QuatI8],
    scales: &[f32],
    bias: &[Quat],
    in_dim: i32,
    out_dim: i32
) -> [Quat] {
    var output: [Quat]
    var j: i32 = 0
    while j < out_dim {
        var sum = bias[j]
        var i: i32 = 0
        while i < in_dim {
            let w_idx = i * out_dim + j
            // Dequantize weight on-the-fly
            let weight = dequantize_quat(weights_q[w_idx], scales[w_idx])
            let prod = quat_mul(input[i], weight)
            sum = quat_add(sum, prod)
            i = i + 1
        }
        output = output ++ [sum]
        j = j + 1
    }
    output
}

// INT8 forward pass
fn qnn_mnist_forward_int8(
    model: &QnnMnistQuantized,
    input: &[Quat],
    config: &QnnMnistConfig
) -> QnnActivations {
    // Layer 1
    let h1_pre = quat_linear_forward_int8(input, &model.layer1_weights_q, &model.layer1_scales,
                                           &model.layer1_bias, config.input_dim, config.hidden1)
    var h1_post: [Quat]
    var i: i32 = 0
    while i < config.hidden1 {
        h1_post = h1_post ++ [quat_relu(h1_pre[i])]
        i = i + 1
    }

    // Layer 2
    let h2_pre = quat_linear_forward_int8(&h1_post, &model.layer2_weights_q, &model.layer2_scales,
                                           &model.layer2_bias, config.hidden1, config.hidden2)
    var h2_post: [Quat]
    i = 0
    while i < config.hidden2 {
        h2_post = h2_post ++ [quat_relu(h2_pre[i])]
        i = i + 1
    }

    // Layer 3
    let out = quat_linear_forward_int8(&h2_post, &model.layer3_weights_q, &model.layer3_scales,
                                        &model.layer3_bias, config.hidden2, config.output_dim)

    // Logits and softmax
    let logits = quat_to_logits(&out)
    let probs = softmax(&logits)

    // Copy input array
    var input_copy: [Quat]
    var i: i32 = 0
    while i < config.input_dim {
        input_copy = input_copy ++ [input[i]]
        i = i + 1
    }

    QnnActivations {
        input: input_copy,
        hidden1_pre: h1_pre,
        hidden1_post: h1_post,
        hidden2_pre: h2_pre,
        hidden2_post: h2_post,
        output: out,
        logits: logits,
        probs: probs,
    }
}

// Predict class using INT8 model
fn predict_int8(
    model: &QnnMnistQuantized,
    input: &[Quat],
    config: &QnnMnistConfig
) -> i32 {
    let activations = qnn_mnist_forward_int8(model, input, config)
    predict_class(&activations)
}

// ============================================================================
// Evaluation Functions
// ============================================================================

// Evaluate INT8 model accuracy
fn evaluate_accuracy_int8(
    model: &QnnMnistQuantized,
    dataset: &MnistDataset,
    config: &QnnMnistConfig
) -> f32 {
    var correct: i32 = 0
    var i: i32 = 0

    while i < dataset.num_samples {
        let input = image_to_quaternions(&dataset.images[i])
        let predicted = predict_int8(model, &input, config)

        if predicted == dataset.labels[i] {
            correct = correct + 1
        }
        i = i + 1
    }

    (correct as f32) / (dataset.num_samples as f32)
}

// Compare FP32 vs INT8 accuracy
fn compare_fp32_int8(
    fp32_model: &QnnMnistModel,
    dataset: &MnistDataset,
    config: &QnnMnistConfig
) with IO {
    println("Comparing FP32 vs INT8 inference...")

    // Quantize model
    let int8_model = quantize_model(fp32_model, config)

    // Evaluate FP32
    let fp32_acc = compute_accuracy(fp32_model, dataset, config)
    println("  FP32 Accuracy: " ++ ((fp32_acc * 100.0) as string) ++ "%")

    // Evaluate INT8
    let int8_acc = evaluate_accuracy_int8(&int8_model, dataset, config)
    println("  INT8 Accuracy: " ++ ((int8_acc * 100.0) as string) ++ "%")

    // Accuracy drop
    let acc_drop = (fp32_acc - int8_acc) * 100.0
    println("  Accuracy Drop: " ++ (acc_drop as string) ++ "%")

    // Memory savings
    let fp32_size = count_parameters(config) * 4 * 4  // 4 components * 4 bytes
    let int8_size = count_parameters(config) * 4 * 1  // 4 components * 1 byte (+ scales overhead)
    println("  FP32 Model Size: ~" ++ ((fp32_size / 1024) as string) ++ " KB")
    println("  INT8 Model Size: ~" ++ ((int8_size / 1024) as string) ++ " KB")
    println("  Memory Reduction: " ++ ((fp32_size / int8_size) as string) ++ "x")
}

// ============================================================================
// Utility Functions
// ============================================================================

// Compute quantization error (MSE between original and dequantized)
fn quantization_error(quats: &[Quat], num_quats: i32) -> f32 {
    let result = quantize_array(quats, num_quats)
    let quantized = result.quantized
    let scales = result.scales
    let dequantized = dequantize_array(&quantized, &scales, num_quats)

    var mse: f32 = 0.0
    var i: i32 = 0
    while i < num_quats {
        let diff = quat_sub(quats[i], dequantized[i])
        mse = mse + quat_magnitude_sq(diff)
        i = i + 1
    }

    mse / (num_quats as f32)
}

// Signal-to-noise ratio for quantization
fn quantization_snr(quats: &[Quat], num_quats: i32) -> f32 {
    let result = quantize_array(quats, num_quats)
    let quantized = result.quantized
    let scales = result.scales
    let dequantized = dequantize_array(&quantized, &scales, num_quats)

    var signal_power: f32 = 0.0
    var noise_power: f32 = 0.0

    var i: i32 = 0
    while i < num_quats {
        signal_power = signal_power + quat_magnitude_sq(quats[i])
        let diff = quat_sub(quats[i], dequantized[i])
        noise_power = noise_power + quat_magnitude_sq(diff)
        i = i + 1
    }

    // SNR in dB
    if noise_power < 1e-10 { 100.0 }  // Near-perfect quantization
    else { 10.0 * log10_f32(signal_power / noise_power) }
}
