// stdlib/qnn/mnist/inference.sio — MNIST inference (prediction)
//
// Argmax-based prediction from model logits.

// ============================================================================
// TYPES (duplicated for standalone check)
// ============================================================================

struct QMnistModel {
    conv: [f64; 1024],
    fc: [f64; 4096],
    n_classes: i32
}

// ============================================================================
// INFERENCE
// ============================================================================

// Predict digit class for a single 784-pixel image (uses first 64 features).
// Returns class index with highest logit.
fn qmnist_predict(model: &QMnistModel, image: &[f64; 784]) -> i32 {
    let nc = model.n_classes
    if nc < 1 { return 0 }

    var best_class: i32 = 0
    var best_logit = 0.0 - 1.0e10

    var c: i32 = 0
    while c < nc {
        if c >= 10 { return best_class }
        var logit = 0.0
        var j: i32 = 0
        while j < 64 {
            let fc_idx = c * 64 + j
            if fc_idx < 4096 {
                if j < 784 {
                    logit = logit + model.fc[fc_idx] * image[j]
                }
            }
            j = j + 1
        }
        if logit > best_logit {
            best_logit = logit
            best_class = c
        }
        c = c + 1
    }
    best_class
}

// Predict and return logits for all classes
fn qmnist_predict_logits(model: &QMnistModel, image: &[f64; 784], logits: &![f64; 64]) with Mut, Div, Panic {
    let nc = model.n_classes
    if nc < 1 { return }

    var c: i32 = 0
    while c < nc {
        if c >= 64 { return }
        var logit = 0.0
        var j: i32 = 0
        while j < 64 {
            let fc_idx = c * 64 + j
            if fc_idx < 4096 {
                if j < 784 {
                    logit = logit + model.fc[fc_idx] * image[j]
                }
            }
            j = j + 1
        }
        logits[c] = logit
        c = c + 1
    }
}

// ============================================================================
// TESTS
// ============================================================================

fn test_predict_zero_model() -> bool {
    let model = QMnistModel { conv: [0.0; 1024], fc: [0.0; 4096], n_classes: 10 }
    var img = [0.0; 784]
    let pred = qmnist_predict(&model, &img)
    // All logits are 0, should return class 0
    pred == 0
}

fn test_predict_returns_valid() -> bool {
    let model = QMnistModel { conv: [0.0; 1024], fc: [0.0; 4096], n_classes: 10 }
    var img = [0.0; 784]
    img[0] = 1.0
    let pred = qmnist_predict(&model, &img)
    pred >= 0
}
