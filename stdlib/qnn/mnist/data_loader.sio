// Load MNIST training set (60,000 samples)
// Uses synthetic data for now - pass data_dir for future real MNIST loading
fn mnist_load_train(data_dir: string) -> MnistDataset {
    // For real MNIST: mnist_load(data_dir ++ "/train-images-idx3-ubyte", data_dir ++ "/train-labels-idx1-ubyte")
    mnist_generate_synthetic(1000, 42)  // Reduced for faster testing
}

// Load MNIST test set (10,000 samples)
// Uses synthetic data for now - pass data_dir for future real MNIST loading
fn mnist_load_test(data_dir: string) -> MnistDataset {
    // For real MNIST: mnist_load(data_dir ++ "/t10k-images-idx3-ubyte", data_dir ++ "/t10k-labels-idx1-ubyte")
    mnist_generate_synthetic(200, 12345)  // Different seed for test set
}

// Create mini-batch from dataset
fn create_batch(dataset: &MnistDataset, indices: &[i32], start: i32, batch_size: i32) -> MnistBatch {
    // Calculate actual batch size (handle end of dataset)
    let remaining = dataset.num_samples - start
    let actual_size = if batch_size < remaining { batch_size } else { remaining }

    var inputs: [[Quat]]
    var batch_labels: [i32]

    var i: i32 = 0
    while i < actual_size {
        let idx = indices[start + i]
        let quat_img = image_to_quaternions(&dataset.images[idx])
        inputs = inputs ++ [quat_img]
        batch_labels = batch_labels ++ [dataset.labels[idx]]
        i = i + 1
    }

    MnistBatch {
        inputs: inputs,
        labels: batch_labels,
        batch_size: actual_size,
    }
}

// Create sequential batch (no shuffling)
fn create_batch_sequential(dataset: &MnistDataset, start: i32, batch_size: i32) -> MnistBatch {
    let remaining = dataset.num_samples - start
    let actual_size = if batch_size < remaining { batch_size } else { remaining }

    var inputs: [[Quat]]
    var batch_labels: [i32]

    var i: i32 = 0
    while i < actual_size {
        let idx = start + i
        let quat_img = image_to_quaternions(&dataset.images[idx])
        inputs = inputs ++ [quat_img]
        batch_labels = batch_labels ++ [dataset.labels[idx]]
        i = i + 1
    }

    MnistBatch {
        inputs: inputs,
        labels: batch_labels,
        batch_size: actual_size,
    }
}

// Generate shuffled indices [0, n) using Fisher-Yates algorithm
// Uses Linear Congruential Generator for reproducible randomness
fn shuffle_indices(n: i32, seed: i32) -> [i32] with Div, Panic {
    // Initialize sequential indices
    var indices: [i32]
    var i: i32 = 0
    while i < n {
        indices = indices ++ [i]
        i = i + 1
    }

    // LCG parameters (same as glibc)
    let mult: i64 = 1103515245
    let incr: i64 = 12345
    let modulus: i64 = 2147483648  // 2^31

    // Fisher-Yates shuffle
    var state: i64 = seed as i64
    var j: i32 = n - 1
    while j > 0 {
        // Update PRNG state (without modulo operator)
        let temp_state = ((state * mult) + incr)
        var result = temp_state
        while result >= modulus {
            result = result - modulus
        }
        state = result

        // Generate random index in [0, j]
        let m = (j + 1) as i64
        let rand_idx = ((state * m) / modulus) as i32

        // Swap indices[j] and indices[rand_idx]
        let temp = indices[j]
        indices[j] = indices[rand_idx]
        indices[rand_idx] = temp

        j = j - 1
    }

    indices
}

// Get number of batches for given batch size
fn num_batches(dataset: &MnistDataset, batch_size: i32) -> i32 {
    (dataset.num_samples + batch_size - 1) / batch_size
}
