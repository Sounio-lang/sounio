// stdlib/qnn/mnist/data_loader.sio — MNIST data loading and batch structure
//
// Provides MnistBatch struct and deterministic mock data for testing.

// ============================================================================
// TYPES
// ============================================================================

struct MnistBatch {
    images: [f64; 4096],   // flattened: batch_size * (some features)
    labels: [i32; 64],
    batch_size: i32
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

fn mnist_batch_new() -> MnistBatch {
    MnistBatch {
        images: [0.0; 4096],
        labels: [0; 64],
        batch_size: 0
    }
}

// Create a mock batch with deterministic pseudo-random data for testing.
// Each "image" is 64 features (not full 784 for memory reasons).
fn mnist_mock_batch(batch_size: i32, seed: i32) -> MnistBatch {
    var batch = mnist_batch_new()
    var bs = batch_size
    if bs > 64 { bs = 64 }
    batch.batch_size = bs

    var rng = seed
    var i: i32 = 0
    while i < bs {
        // Generate 64 features per sample
        var j: i32 = 0
        while j < 64 {
            rng = rng * 1103515245 + 12345
            var val = rng
            if val < 0 { val = 0 - val }
            let idx = i * 64 + j
            if idx < 4096 {
                // Normalize to [0, 1]
                // Convert val%256 to f64 manually
                let rem = val % 256
                var fval = 0.0
                var ri: i32 = 0
                while ri < rem {
                    fval = fval + 1.0
                    ri = ri + 1
                }
                batch.images[idx] = fval / 255.0
            }
            j = j + 1
        }
        // Assign label (digit 0-9)
        rng = rng * 1103515245 + 12345
        var lbl = rng
        if lbl < 0 { lbl = 0 - lbl }
        batch.labels[i] = lbl % 10
        i = i + 1
    }
    batch
}

// ============================================================================
// TESTS
// ============================================================================

fn test_batch_new() -> bool {
    let b = mnist_batch_new()
    b.batch_size == 0
}

fn test_mock_batch() -> bool {
    let b = mnist_mock_batch(8, 42)
    b.batch_size == 8
}

fn test_mock_labels_range() -> bool {
    let b = mnist_mock_batch(16, 123)
    // All labels should be 0..9
    var ok = true
    var i: i32 = 0
    while i < 16 {
        if b.labels[i] < 0 { ok = false }
        if b.labels[i] > 9 { ok = false }
        i = i + 1
    }
    ok
}
