//! stdlib/qnn/mnist/data_loader.sio - MNIST Dataset Loading
//!
//! Loads MNIST handwritten digit dataset in IDX binary format
//! and converts images to quaternion representation for QNN training.
//!
//! IDX Format:
//! - Images: magic=2051, num_images, rows, cols, pixel_data
//! - Labels: magic=2049, num_items, label_data
//!
//! NOTE: Real MNIST loading requires `read_bytes(path: string) -> [u8]`.
//! For testing without real MNIST files, use `mnist_generate_synthetic()`.

use qnn::mnist::model::*

// MNIST dataset container
struct MnistDataset {
    images: [[f32]],      // [num_samples][784] flattened images
    labels: [i32],        // [num_samples] digit labels 0-9
    num_samples: i32,
}

// Mini-batch for training
struct MnistBatch {
    inputs: [[Quat]],     // [batch_size][196] quaternion inputs
    labels: [i32],        // [batch_size] labels
    batch_size: i32,
}

// ============================================================================
// Synthetic Data Generation (for testing without real MNIST files)
// ============================================================================

// Simple LCG random number generator (without modulo operator)
fn lcg_rand(state: &!i64) -> f32 with Div, Panic {
    let mult: i64 = 1103515245
    let incr: i64 = 12345
    let modulus: i64 = 2147483648
    let temp = (*state * mult) + incr
    // Simulate modulo by repeatedly subtracting modulus until < modulus
    var result = temp
    while result >= modulus {
        result = result - modulus
    }
    *state = result
    (result as f32) / (modulus as f32)
}

// Generate synthetic MNIST-like dataset for testing
// Creates random images with labels based on image statistics
fn mnist_generate_synthetic(num_samples: i32, seed: i32) -> MnistDataset with Div, Panic {
    var state: i64 = seed as i64
    var images: [[f32]]
    var labels: [i32]

    var n: i32 = 0
    while n < num_samples {
        // Generate random 784-pixel image
        var img: [f32]
        var sum: f32 = 0.0
        var i: i32 = 0
        while i < 784 {
            let pixel = lcg_rand(&!state)
            img = img ++ [pixel]
            sum = sum + pixel
            i = i + 1
        }
        images = images ++ [img]

        // Label based on average intensity (simple pattern for testing)
        let avg = sum / 784.0
        let label_raw = ((avg * 10.0) as i32)
        let label = if label_raw >= 10 { label_raw - 10 } else { label_raw }
        labels = labels ++ [label]

        n = n + 1
    }

    MnistDataset {
        images: images,
        labels: labels,
        num_samples: num_samples,
    }
}

// ============================================================================
// IDX File Parsing (requires read_bytes intrinsic)
// ============================================================================

// Read big-endian 32-bit integer from byte array
fn read_u32_be(bytes: &[u8], offset: i32) -> i32 {
    let b0 = bytes[offset] as i32
    let b1 = bytes[offset + 1] as i32
    let b2 = bytes[offset + 2] as i32
    let b3 = bytes[offset + 3] as i32
    (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3
}

// Convert 784-pixel image to 196 quaternions
// Groups 4 consecutive pixels into one quaternion: (p0, p1, p2, p3)
// Pixels are normalized from [0,255] to [0,1]
fn image_to_quaternions(pixels: &[f32]) -> [Quat] with Panic {
    var quats: [Quat]
    var i: i32 = 0
    while i < 196 {
        let base = i * 4
        let q = Quat {
            w: pixels[base],
            x: pixels[base + 1],
            y: pixels[base + 2],
            z: pixels[base + 3],
        }
        quats = quats ++ [q]
        i = i + 1
    }
    quats
}

// Convert raw byte pixels to normalized f32 array
fn bytes_to_floats(bytes: &[u8], offset: i32, count: i32) -> [f32] {
    var floats: [f32]
    var i: i32 = 0
    while i < count {
        let byte_val = bytes[offset + i] as f32
        floats = floats ++ [byte_val / 255.0]
        i = i + 1
    }
    floats
}

