//! Advanced loss functions for quaternion neural networks
//!
//! This module provides production-ready loss functions for QNN training:
//! - Mean Squared Error (MSE) with quaternion norm
//! - Quaternion Frobenius norm loss
//! - Geodesic distance loss for rotation quaternions
//! - Cross-entropy-inspired loss for classification
//!
//! References:
//! - Deep Quaternion Networks: arXiv:1705.07944
//! - Quaternion Loss: Parcollet et al. (2016)
//! - Geodesic Distance: Davis et al. (1982)

// Core quaternion type
type Quat = struct {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
}

// Loss statistics structure
type LossStats = struct {
    value: f32,
    gradient_norm: f32,
}

// ============================================================================
// Quaternion Utilities (minimal set for loss functions)
// ============================================================================

fn quat_zero() -> Quat {
    Quat { w: 0.0, x: 0.0, y: 0.0, z: 0.0 }
}

fn quat_dot(q1: Quat, q2: Quat) -> f32 {
    q1.w * q2.w + q1.x * q2.x + q1.y * q2.y + q1.z * q2.z
}

fn quat_norm(q: Quat) -> f32 {
    (q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z).sqrt()
}

fn quat_norm_sq(q: Quat) -> f32 {
    q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z
}

fn quat_normalize(q: Quat) -> Quat {
    let norm = quat_norm(q)
    if norm > 1e-7 {
        Quat {
            w: q.w / norm,
            x: q.x / norm,
            y: q.y / norm,
            z: q.z / norm,
        }
    } else {
        Quat { w: 1.0, x: 0.0, y: 0.0, z: 0.0 }
    }
}

fn quat_scale(q: Quat, s: f32) -> Quat {
    Quat {
        w: q.w * s,
        x: q.x * s,
        y: q.y * s,
        z: q.z * s,
    }
}

fn quat_add(q1: Quat, q2: Quat) -> Quat {
    Quat {
        w: q1.w + q2.w,
        x: q1.x + q2.x,
        y: q1.y + q2.y,
        z: q1.z + q2.z,
    }
}

fn quat_sub(q1: Quat, q2: Quat) -> Quat {
    Quat {
        w: q1.w - q2.w,
        x: q1.x - q2.x,
        y: q1.y - q2.y,
        z: q1.z - q2.z,
    }
}

fn quat_mul(q1: Quat, q2: Quat) -> Quat {
    Quat {
        w: q1.w * q2.w - q1.x * q2.x - q1.y * q2.y - q1.z * q2.z,
        x: q1.w * q2.x + q1.x * q2.w + q1.y * q2.z - q1.z * q2.y,
        y: q1.w * q2.y - q1.x * q2.z + q1.y * q2.w + q1.z * q2.x,
        z: q1.w * q2.z + q1.x * q2.y - q1.y * q2.x + q1.z * q2.w,
    }
}

fn quat_conjugate(q: Quat) -> Quat {
    Quat { w: q.w, x: -q.x, y: -q.y, z: -q.z }
}

// ============================================================================
// Loss Functions
// ============================================================================

//! MSE Loss for Quaternions
//! Treats quaternions as 4D vectors and computes ||prediction - target||^2
//! Commonly used for regression on quaternion representations (e.g., rotations, orientations)
//! Formula: L = (1/N) * sum_i ||p_i - t_i||^2
fn quat_mse_loss(predictions: &[Quat], targets: &[Quat]) -> f32 {
    let n = predictions.len()
    if n == 0 { return 0.0 }

    var total_loss: f32 = 0.0
    for i in 0..n {
        let diff = quat_sub(predictions[i], targets[i])
        let norm_sq = quat_norm_sq(diff)
        total_loss = total_loss + norm_sq
    }

    total_loss / (n as f32)
}

//! Quaternion Frobenius Norm Loss
//! For quaternion matrices (e.g., layer weights), computes Frobenius norm
//! Formula: L = sqrt(sum_ij (||Q_ij||^2))
fn quat_frobenius_loss(quat_matrix: &[[Quat]]) -> f32 {
    var total_sq: f32 = 0.0
    for row in quat_matrix {
        for q in row {
            let norm_sq = quat_norm_sq(*q)
            total_sq = total_sq + norm_sq
        }
    }
    total_sq.sqrt()
}

//! Geodesic Distance Loss for Unit Quaternions
//! Treats quaternions as points on the unit 3-sphere (S^3) and computes geodesic distance
//! For unit quaternions q1, q2: dist = arccos(|<q1, q2>|)
//! Clamped to [0, pi] to handle numerical errors
//! Used for rotation regression where quaternion magnitude is normalized
fn quat_geodesic_loss(predictions: &[Quat], targets: &[Quat]) -> f32 {
    let n = predictions.len()
    if n == 0 { return 0.0 }

    var total_loss: f32 = 0.0
    for i in 0..n {
        let p_norm = quat_normalize(predictions[i])
        let t_norm = quat_normalize(targets[i])

        // Compute inner product
        let inner = quat_dot(p_norm, t_norm)

        // Clamp to avoid numerical errors in arccos
        let clamped = if inner > 1.0 { 1.0 }
                      else if inner < -1.0 { -1.0 }
                      else { inner }

        // Geodesic distance is arccos of absolute value (accounts for double-cover)
        let abs_inner = if clamped < 0.0 { -clamped } else { clamped }
        let angle = abs_inner.acos()

        total_loss = total_loss + angle * angle  // Square for emphasis on larger errors
    }

    total_loss / (n as f32)
}

//! Quaternion Regression Loss (Combined)
//! Blends MSE and geodesic distance for mixed regression/orientation tasks
//! Loss = alpha * MSE + (1-alpha) * geodesic
fn quat_combined_loss(
    predictions: &[Quat],
    targets: &[Quat],
    alpha: f32,
) -> f32 {
    let mse = quat_mse_loss(predictions, targets)
    let geo = quat_geodesic_loss(predictions, targets)
    alpha * mse + (1.0 - alpha) * geo
}

//! Quaternion Cross-Entropy Loss for Classification
//! For K quaternion classes, treats predictions as logits and targets as probabilities
//! Computes average cross-entropy per quaternion component
//! Softmax is applied component-wise (epistemic caveat: assumes independence)
fn quat_cross_entropy_loss(logits: &[Quat], labels: &[Quat]) -> f32 {
    let n = logits.len()
    if n == 0 { return 0.0 }

    var total_loss: f32 = 0.0

    for i in 0..n {
        // For each quaternion, compute softmax-like normalization
        let l = logits[i]
        let lbl = labels[i]

        // Softmax on quaternion components (component-wise)
        let max_logit = if l.w >= l.x { l.w } else { l.x }
        let max_logit = if max_logit >= l.y { max_logit } else { l.y }
        let max_logit = if max_logit >= l.z { max_logit } else { l.z }
        let exp_w = (l.w - max_logit).exp()
        let exp_x = (l.x - max_logit).exp()
        let exp_y = (l.y - max_logit).exp()
        let exp_z = (l.z - max_logit).exp()
        let sum_exp = exp_w + exp_x + exp_y + exp_z

        // Avoid division by zero
        if sum_exp < 1e-7 { continue }

        let prob_w = exp_w / sum_exp
        let prob_x = exp_x / sum_exp
        let prob_y = exp_y / sum_exp
        let prob_z = exp_z / sum_exp

        // Cross-entropy: -sum(label * log(prob))
        let eps = 1e-7
        total_loss = total_loss - (lbl.w * (prob_w + eps).ln())
        total_loss = total_loss - (lbl.x * (prob_x + eps).ln())
        total_loss = total_loss - (lbl.y * (prob_y + eps).ln())
        total_loss = total_loss - (lbl.z * (prob_z + eps).ln())
    }

    total_loss / (n as f32)
}

//! Hamiltonian Loss for Quaternion Neural Networks
//! Encourages learned quaternion representations to follow Hamilton product structure
//! For batch of (input, weight) pairs and outputs, verifies: output ≈ input ⊗ weight
//! Formula: L = (1/N) * sum_i ||output_i - (input_i ⊗ weight_i)||^2
fn quat_hamiltonian_structure_loss(
    inputs: &[Quat],
    weights: &[Quat],
    outputs: &[Quat],
) -> f32 {
    let n = inputs.len()
    if n == 0 { return 0.0 }
    if weights.len() != n || outputs.len() != n { return 0.0 }

    var total_loss: f32 = 0.0
    for i in 0..n {
        let expected = quat_mul(inputs[i], weights[i])
        let diff = quat_sub(outputs[i], expected)
        let norm_sq = quat_norm_sq(diff)
        total_loss = total_loss + norm_sq
    }

    total_loss / (n as f32)
}

// ============================================================================
// Loss Derivatives and Gradient Utilities
// ============================================================================

//! Compute MSE loss gradient w.r.t predictions
//! dL/dpred = (2/N) * (pred - target)
fn quat_mse_gradient(predictions: &[Quat], targets: &[Quat]) -> [Quat] {
    let n = predictions.len()
    var grads: [Quat] = []

    for i in 0..n {
        let diff = quat_sub(predictions[i], targets[i])
        let grad = quat_scale(diff, 2.0 / (n as f32))
        grads.push(grad)
    }

    grads
}

//! Compute geodesic loss gradient (numerical approximation)
//! Uses finite differences: dL/dpred_j ≈ (L(pred + eps*e_j) - L(pred - eps*e_j)) / (2*eps)
fn quat_geodesic_gradient_approx(
    predictions: &[Quat],
    targets: &[Quat],
    eps: f32,
) -> [Quat] {
    let n = predictions.len()
    var grads: [Quat] = []
    let baseline_loss = quat_geodesic_loss(predictions, targets)

    for i in 0..n {
        let mut perturbed_pred = predictions.clone()

        // Perturb w component
        var grad_w = 0.0
        perturbed_pred[i].w = perturbed_pred[i].w + eps
        let loss_plus = quat_geodesic_loss(&perturbed_pred, targets)
        grad_w = (loss_plus - baseline_loss) / eps

        // Perturb x component
        var grad_x = 0.0
        perturbed_pred[i].w = predictions[i].w
        perturbed_pred[i].x = perturbed_pred[i].x + eps
        let loss_plus_x = quat_geodesic_loss(&perturbed_pred, targets)
        grad_x = (loss_plus_x - baseline_loss) / eps

        // Perturb y component
        var grad_y = 0.0
        perturbed_pred[i].x = predictions[i].x
        perturbed_pred[i].y = perturbed_pred[i].y + eps
        let loss_plus_y = quat_geodesic_loss(&perturbed_pred, targets)
        grad_y = (loss_plus_y - baseline_loss) / eps

        // Perturb z component
        var grad_z = 0.0
        perturbed_pred[i].y = predictions[i].y
        perturbed_pred[i].z = perturbed_pred[i].z + eps
        let loss_plus_z = quat_geodesic_loss(&perturbed_pred, targets)
        grad_z = (loss_plus_z - baseline_loss) / eps

        grads.push(Quat { w: grad_w, x: grad_x, y: grad_y, z: grad_z })
    }

    grads
}

//! Compute regularization loss (L2 norm of quaternion weights)
//! Used for weight decay: L_reg = (lambda / 2) * sum ||w_i||^2
fn quat_l2_regularization(weights: &[Quat], lambda: f32) -> f32 {
    var reg_loss: f32 = 0.0
    for w in weights {
        let norm_sq = quat_norm_sq(*w)
        reg_loss = reg_loss + norm_sq
    }
    (lambda / 2.0) * reg_loss
}
