//! stdlib/qnn/linear.sio - QuatLinear Layer
//!
//! Quaternionic linear transformation layer for neural networks.
//! Performs: y = W ⊗ x + b where ⊗ is the Hamilton product

// QuatLinearLayer represents a fully connected quaternion layer
// Input: batch of quaternion vectors
// Output: transformed quaternion vectors via Hamilton product
struct QuatLinearLayer {
    input_features: i32,
    output_features: i32,
}

// Creates a new quaternionic linear layer
fn quat_linear_new(input: i32, output: i32) -> QuatLinearLayer {
    QuatLinearLayer {
        input_features: input,
        output_features: output,
    }
}

// Performs forward pass through the quaternionic linear layer
// Uses Hamilton product for weight-input multiplication
// Calls intrinsic quat_linear_fwd(layer, weights, input, bias)
fn quat_linear_forward(
    layer: &QuatLinearLayer,
    weights: &[Quat],
    input: &[Quat],
    bias: &[Quat]
) -> [Quat] {
    quat_linear_fwd(layer, weights, input, bias)
}

// Performs backward pass through the quaternionic linear layer
// Computes gradients with respect to inputs
// Calls intrinsic quat_linear_bwd(layer, weights, grad_output)
fn quat_linear_backward(
    layer: &QuatLinearLayer,
    weights: &[Quat],
    grad_output: &[Quat]
) -> [Quat] {
    quat_linear_bwd(layer, weights, grad_output)
}

// Initializes quaternionic weights using Xavier/Glorot initialization
// Adapted for quaternion algebra: scale = sqrt(2 / (fan_in + fan_out))
// Returns array of size: fan_in * fan_out quaternions
fn quat_xavier_init(fan_in: i32, fan_out: i32, seed: i32) -> [Quat] {
    quat_init_xavier(fan_in, fan_out, seed)
}

// Initializes quaternionic weights using He initialization
// Adapted for quaternion algebra: scale = sqrt(2 / fan_in)
// Preferred for ReLU activations
// Returns array of size: fan_in * fan_out quaternions
fn quat_he_init(fan_in: i32, fan_out: i32, seed: i32) -> [Quat] {
    quat_init_he(fan_in, fan_out, seed)
}

// Initializes quaternionic weights as unit quaternions
// All weights are pure rotations (norm = 1)
// Returns array of size: fan_in * fan_out quaternions
fn quat_unit_init(fan_in: i32, fan_out: i32, seed: i32) -> [Quat] {
    quat_init_unit(fan_in, fan_out, seed)
}
