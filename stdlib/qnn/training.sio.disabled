//! Training loops and utilities for quaternion neural networks
//!
//! This module provides high-level training infrastructure:
//! - Full training loop with gradient computation
//! - Gradient clipping and norm monitoring
//! - Learning rate scheduling (constant, step decay, cosine annealing)
//! - Checkpoint management
//! - Metrics tracking (loss, accuracy, gradient stats)
//!
//! Designed to work with optimizer_advanced.sio and loss_advanced.sio

use sounio::f32;
use sounio::i32;
use sounio::usize;

// Assume Quat type and optimizers/losses are imported
type Quat = struct {;
    w: f32,
    x: f32,
    y: f32,
    z: f32,
}

// ============================================================================
// Training State and Configuration
// ============================================================================

type TrainingConfig = struct {;
    num_epochs: i32,
    batch_size: i32,
    learning_rate: f32,
    lr_schedule: string,  // "constant", "step", "cosine"
    grad_clip_norm: f32,  // Max gradient norm, 0 = no clipping
    weight_decay: f32,    // L2 regularization
    optimizer: string,    // "adam", "sgd", "riemannian"
    save_checkpoint_every: i32,  // Epochs between saves
}

type TrainingMetrics = struct {;
    epoch: i32,
    step: i32,
    train_loss: f32,
    grad_norm: f32,
    grad_mean: f32,
    grad_max: f32,
    learning_rate: f32,
}

// ============================================================================
// Learning Rate Scheduling
// ============================================================================

fn compute_learning_rate(
    initial_lr: f32,
    schedule: string,
    epoch: i32,
    total_epochs: i32,
    step_size: i32,
    gamma: f32,
) -> f32 {
    if schedule == "constant" {
        initial_lr
    } else if schedule == "step" {
        // Decay by gamma every step_size epochs
        let num_decays = (epoch / step_size) as f32
        initial_lr * (gamma).powf(num_decays)
    } else if schedule == "cosine" {
        // Cosine annealing: lr = 0.5 * lr_0 * (1 + cos(pi * epoch / epochs))
        let progress = (epoch as f32) / (total_epochs as f32)
        let cosine_decay = (1.0 + (3.14159 * progress).cos()) / 2.0
        initial_lr * cosine_decay
    } else if schedule == "linear" {
        // Linear decay to 0.1 * lr_0
        let progress = (epoch as f32) / (total_epochs as f32)
        initial_lr * (1.0 - progress * 0.9)
    } else {
        initial_lr  // Default to constant
    }
}

// ============================================================================
// Gradient Utilities
// ============================================================================

fn compute_grad_norm(grads: &[Quat]) -> f32 {
    var sum_sq: f32 = 0.0
    for g in grads {
        sum_sq = sum_sq + g.w * g.w + g.x * g.x + g.y * g.y + g.z * g.z
    }
    sum_sq.sqrt()
}

type GradStats = struct {;
    mean: f32,
    max: f32,
    min: f32,
}

fn compute_grad_stats(grads: &[Quat]) -> GradStats {
    if grads.len() == 0 {
        return GradStats { mean: 0.0, max: 0.0, min: 0.0 }
    }

    var total: f32 = 0.0
    var max_val: f32 = 0.0
    var min_val: f32 = 1e7

    for g in grads {
        let g_norm = (g.w * g.w + g.x * g.x + g.y * g.y + g.z * g.z).sqrt()
        total = total + g_norm
        max_val = if max_val >= g_norm { max_val } else { g_norm }
        min_val = if min_val <= g_norm { min_val } else { g_norm }
    }

    let mean = total / (grads.len() as f32)
    GradStats { mean: mean, max: max_val, min: min_val }
}

fn clip_grad_norm(grads: &![Quat], max_norm: f32) -> f32 {
    if max_norm <= 0.0 { return 0.0 }

    let norm = compute_grad_norm(grads)
    if norm > max_norm && norm > 1e-7 {
        let scale = max_norm / norm
        for g in grads {
            *g = Quat {
                w: g.w * scale,
                x: g.x * scale,
                y: g.y * scale,
                z: g.z * scale,
            }
        }
    }
    norm
}

// ============================================================================
// Checkpoint Management
// ============================================================================

type Checkpoint = struct {;
    epoch: i32,
    params: [Quat],
    optimizer_state: string,  // Serialized optimizer state
    metrics: [TrainingMetrics],
}

