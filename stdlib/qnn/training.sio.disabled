// ============================================================================
// Training Loop
// ============================================================================

type EpochResult = struct {;
    loss: f32,
    grad_norm: f32,
    metrics: TrainingMetrics,
}

fn train_epoch(
    model: &![[Quat]],  // Model weights (flattened or nested)
    train_data: &[(Vec<Quat>, Vec<Quat>)],  // Batch of (inputs, targets)
    optimizer: string,
    learning_rate: f32,
    loss_fn: string,
    config: &TrainingConfig,
) -> EpochResult {
    var epoch_loss: f32 = 0.0
    var total_grad_norm: f32 = 0.0
    var step: i32 = 0

    for (inputs, targets) in train_data {
        // Forward pass: compute predictions
        // Simplified: assuming model is callable as forward(inputs)
        // In practice, this would invoke the actual model forward pass
        var predictions: Vec<Quat> = Vec::new()
        // predictions = forward_pass(model, inputs)

        // Compute loss
        var loss: f32 = 0.0
        // loss = loss_fn(predictions, targets)

        epoch_loss = epoch_loss + loss

        // Backward pass: compute gradients
        var grads: [Quat] = []
        // grads = backward_pass(model, loss, inputs, targets)

        // Gradient clipping
        if config.grad_clip_norm > 0.0 {
            let grad_norm = clip_grad_norm(&!grads, config.grad_clip_norm)
            total_grad_norm = total_grad_norm + grad_norm
        } else {
            total_grad_norm = total_grad_norm + compute_grad_norm(&grads)
        }

        // Optimizer step
        // optimizer_step(model, grads, optimizer, learning_rate, config.weight_decay)

        step = step + 1
    }

    let avg_loss = epoch_loss / (train_data.len() as f32)
    let avg_grad_norm = total_grad_norm / (step as f32)
    let stats = compute_grad_stats(&[])  // Would use actual grads

    let metrics = TrainingMetrics {
        epoch: 0,
        step: step,
        train_loss: avg_loss,
        grad_norm: avg_grad_norm,
        grad_mean: stats.mean,
        grad_max: stats.max,
        learning_rate: learning_rate,
    }

    EpochResult {
        loss: avg_loss,
        grad_norm: avg_grad_norm,
        metrics: metrics,
    }
}

fn train(
    model: &![[Quat]],
    train_data: &[(Vec<Quat>, Vec<Quat>)],
    val_data: &[(Vec<Quat>, Vec<Quat>)],
    config: &TrainingConfig,
) -> [TrainingMetrics] {
    var all_metrics: [TrainingMetrics] = []
    var best_val_loss: f32 = 1e7
    var patience_counter: i32 = 0
    let patience: i32 = 10  // Early stopping patience

    print("Starting training for {} epochs", config.num_epochs)

    for epoch in 0..config.num_epochs {
        // Compute learning rate for this epoch
        let lr = compute_learning_rate(
            config.learning_rate,
            config.lr_schedule,
            epoch,
            config.num_epochs,
            10,  // step_size
            0.1,  // gamma
        )

        print("Epoch {}/{}, Learning Rate: {:.6}", epoch + 1, config.num_epochs, lr)

        // Train for one epoch
        let result = train_epoch(
            model,
            train_data,
            config.optimizer,
            lr,
            "mse",  // loss_fn
            config,
        )

        all_metrics.push(result.metrics)

        // Log metrics
        print("  Train Loss: {:.6}, Grad Norm: {:.6}", result.loss, result.grad_norm)

        // Validation (simplified)
        // let val_loss = evaluate(model, val_data)
        // print("  Val Loss: {:.6}", val_loss)

        // Early stopping and checkpoint saving
        if (epoch + 1) % config.save_checkpoint_every == 0 {
            save_checkpoint("/tmp/checkpoints", epoch, &[], &all_metrics)
        }

        // Simplified early stopping check
        // if val_loss < best_val_loss {
        //     best_val_loss = val_loss
        //     patience_counter = 0
        // } else {
        //     patience_counter += 1
        //     if patience_counter >= patience {
        //         print("Early stopping triggered")
        //         break
        //     }
        // }
    }

    print("Training completed")
    all_metrics
}

// ============================================================================
// Evaluation and Testing
// ============================================================================

type EvalResult = struct {;
    loss: f32,
    accuracy: f32,
}

fn evaluate(
    model: &[[Quat]],
    test_data: &[(Vec<Quat>, Vec<Quat>)],
) -> EvalResult {
    var total_loss: f32 = 0.0
    var correct: i32 = 0

    for (inputs, targets) in test_data {
        // predictions = forward_pass(model, inputs)
        // loss = loss_fn(predictions, targets)
        // correct += count_correct(predictions, targets)
    }

    let avg_loss = total_loss / (test_data.len() as f32)
    let accuracy = (correct as f32) / (test_data.len() as f32)

    EvalResult { loss: avg_loss, accuracy: accuracy }
}

// ============================================================================
// Utilities for Data Processing
// ============================================================================

fn normalize_quaternions(quats: &![Quat]) {
    for q in quats {
        let norm = (q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z).sqrt()
        if norm > 1e-7 {
            *q = Quat {
                w: q.w / norm,
                x: q.x / norm,
                y: q.y / norm,
                z: q.z / norm,
            }
        }
    }
}

fn standardize_quaternions(quats: &![Quat]) {
    // Compute mean
    let n = quats.len() as f32
    var mean_w: f32 = 0.0
    var mean_x: f32 = 0.0
    var mean_y: f32 = 0.0
    var mean_z: f32 = 0.0

    for q in quats {
        mean_w = mean_w + q.w / n
        mean_x = mean_x + q.x / n
        mean_y = mean_y + q.y / n
        mean_z = mean_z + q.z / n
    }

    // Compute variance and standardize
    var var_w: f32 = 0.0
    var var_x: f32 = 0.0
    var var_y: f32 = 0.0
    var var_z: f32 = 0.0

    for q in quats {
        var_w = var_w + (q.w - mean_w).powf(2.0) / n
        var_x = var_x + (q.x - mean_x).powf(2.0) / n
        var_y = var_y + (q.y - mean_y).powf(2.0) / n
        var_z = var_z + (q.z - mean_z).powf(2.0) / n
    }

    let std_w = (var_w).sqrt()
    let std_x = (var_x).sqrt()
    let std_y = (var_y).sqrt()
    let std_z = (var_z).sqrt()

    for q in quats {
        if std_w > 1e-7 { q.w = (q.w - mean_w) / std_w }
        if std_x > 1e-7 { q.x = (q.x - mean_x) / std_x }
        if std_y > 1e-7 { q.y = (q.y - mean_y) / std_y }
        if std_z > 1e-7 { q.z = (q.z - mean_z) / std_z }
    }
}

