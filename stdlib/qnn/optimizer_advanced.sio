// stdlib/qnn/optimizer_advanced.sio — AdamW optimizer for QNN
//
// Adam with decoupled weight decay (Loshchilov & Hutter 2019).
// Tracks first and second moment estimates per parameter.

// ============================================================================
// HELPERS
// ============================================================================

fn qopt_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn qopt_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

// ============================================================================
// TYPES
// ============================================================================

struct QAdamW {
    lr: f64,
    beta1: f64,
    beta2: f64,
    wd: f64,             // weight decay
    m: [f64; 4096],      // first moment
    v: [f64; 4096],      // second moment
    t: i32               // timestep
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

fn qadamw_new(lr: f64, beta1: f64, beta2: f64, wd: f64) -> QAdamW {
    QAdamW {
        lr: lr,
        beta1: beta1,
        beta2: beta2,
        wd: wd,
        m: [0.0; 4096],
        v: [0.0; 4096],
        t: 0
    }
}

fn qadamw_default() -> QAdamW {
    qadamw_new(0.001, 0.9, 0.999, 0.01)
}

// ============================================================================
// UPDATE STEP
// ============================================================================

// AdamW update:
//   m_t = beta1 * m_{t-1} + (1-beta1) * g
//   v_t = beta2 * v_{t-1} + (1-beta2) * g^2
//   m_hat = m_t / (1 - beta1^t)
//   v_hat = v_t / (1 - beta2^t)
//   param -= lr * (m_hat / (sqrt(v_hat) + eps) + wd * param)
fn qadamw_step(opt: QAdamW, params: &![f64; 4096], grads: &[f64; 4096], n: i32) -> QAdamW with Mut, Div, Panic {
    var result = opt
    result.t = result.t + 1
    let t = result.t

    if n < 1 { return result }
    if n > 4096 { return result }

    let b1 = result.beta1
    let b2 = result.beta2
    let lr = result.lr
    let wd = result.wd
    let eps = 1.0e-8

    // Compute bias correction factors: (1-beta^t)
    // beta^t via repeated multiplication
    var b1_pow = 1.0
    var b2_pow = 1.0
    var pi: i32 = 0
    while pi < t {
        b1_pow = b1_pow * b1
        b2_pow = b2_pow * b2
        pi = pi + 1
    }
    let b1_corr = 1.0 - b1_pow
    let b2_corr = 1.0 - b2_pow

    if qopt_abs(b1_corr) < 1.0e-15 { return result }
    if qopt_abs(b2_corr) < 1.0e-15 { return result }

    var i: i32 = 0
    while i < n {
        let g = grads[i]

        // Update moments
        result.m[i] = b1 * result.m[i] + (1.0 - b1) * g
        result.v[i] = b2 * result.v[i] + (1.0 - b2) * g * g

        // Bias-corrected estimates
        let m_hat = result.m[i] / b1_corr
        let v_hat = result.v[i] / b2_corr

        // Update parameter with weight decay
        let update = m_hat / (qopt_sqrt(v_hat) + eps) + wd * params[i]
        params[i] = params[i] - lr * update

        i = i + 1
    }
    result
}

// ============================================================================
// TESTS
// ============================================================================

fn test_adamw_new() -> bool {
    let opt = qadamw_default()
    qopt_abs(opt.lr - 0.001) < 0.0001
}

fn test_adamw_timestep() -> bool {
    let opt = qadamw_default()
    opt.t == 0
}
