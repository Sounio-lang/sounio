//! Advanced optimizers for quaternion neural networks
//!
//! This module provides production-ready optimizers for quaternion parameters:
//! - Adam (component-wise, arXiv:1412.6980)
//! - Momentum SGD with weight decay
//! - Riemannian SGD for unit quaternion manifold (S^3)
//!
//! Epistemic note: Adam assumes uncorrelated component noise; Riemannian variant
//! preserves quaternion manifold structure but requires smaller learning rates.
//! References: Kingma & Ba (1412.6980), Bonnabel et al. (arXiv:1310.5957)

// Core quaternion type and operations
type Quat = struct {
    w: f32,
    x: f32,
    y: f32,
    z: f32,
}

// ============================================================================
// Quaternion Utilities
// ============================================================================

fn quat_zero() -> Quat {
    Quat { w: 0.0, x: 0.0, y: 0.0, z: 0.0 }
}

fn quat_identity() -> Quat {
    Quat { w: 1.0, x: 0.0, y: 0.0, z: 0.0 }
}

fn quat_dot(q1: Quat, q2: Quat) -> f32 {
    q1.w * q2.w + q1.x * q2.x + q1.y * q2.y + q1.z * q2.z
}

fn quat_norm(q: Quat) -> f32 {
    (q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z).sqrt()
}

fn quat_normalize(q: Quat) -> Quat {
    let norm = quat_norm(q)
    if norm > 1e-7 {
        Quat {
            w: q.w / norm,
            x: q.x / norm,
            y: q.y / norm,
            z: q.z / norm,
        }
    } else {
        Quat { w: 1.0, x: 0.0, y: 0.0, z: 0.0 }
    }
}

fn quat_scale(q: Quat, s: f32) -> Quat {
    Quat {
        w: q.w * s,
        x: q.x * s,
        y: q.y * s,
        z: q.z * s,
    }
}

fn quat_add(q1: Quat, q2: Quat) -> Quat {
    Quat {
        w: q1.w + q2.w,
        x: q1.x + q2.x,
        y: q1.y + q2.y,
        z: q1.z + q2.z,
    }
}

fn quat_sub(q1: Quat, q2: Quat) -> Quat {
    Quat {
        w: q1.w - q2.w,
        x: q1.x - q2.x,
        y: q1.y - q2.y,
        z: q1.z - q2.z,
    }
}

// Hamilton product: q1 ⊗ q2
fn quat_mul(q1: Quat, q2: Quat) -> Quat {
    Quat {
        w: q1.w * q2.w - q1.x * q2.x - q1.y * q2.y - q1.z * q2.z,
        x: q1.w * q2.x + q1.x * q2.w + q1.y * q2.z - q1.z * q2.y,
        y: q1.w * q2.y - q1.x * q2.z + q1.y * q2.w + q1.z * q2.x,
        z: q1.w * q2.z + q1.x * q2.y - q1.y * q2.x + q1.z * q2.w,
    }
}

fn quat_conjugate(q: Quat) -> Quat {
    Quat { w: q.w, x: -q.x, y: -q.y, z: -q.z }
}

// Quaternion exponential: exp(q) = e^w * (cos(||v||) + (v/||v||) sin(||v||))
// where v = [x, y, z], used for manifold retraction
fn quat_exp(q: Quat) -> Quat {
    let v_norm = (q.x * q.x + q.y * q.y + q.z * q.z).sqrt()
    if v_norm < 1e-7 {
        Quat {
            w: q.w.exp(),
            x: 0.0,
            y: 0.0,
            z: 0.0,
        }
    } else {
        let scalar = q.w.exp()
        let theta = v_norm
        let cos_theta = theta.cos()
        let sin_theta = theta.sin()
        let ux = q.x / v_norm * sin_theta
        let uy = q.y / v_norm * sin_theta
        let uz = q.z / v_norm * sin_theta
        Quat {
            w: scalar * cos_theta,
            x: scalar * ux,
            y: scalar * uy,
            z: scalar * uz,
        }
    }
}

// Gradient statistics structure
type GradStats = struct {
    norm: f32,
    mean: f32,
    max: f32,
}

fn quat_grad_norm(grads: &[Quat]) -> f32 {
    var sum_sq: f32 = 0.0
    for g in grads {
        sum_sq = sum_sq + g.w * g.w + g.x * g.x + g.y * g.y + g.z * g.z
    }
    sum_sq.sqrt()
}

// ============================================================================
// Adam Optimizer State
// ============================================================================

type QuatAdamState = struct {
    m: [Quat],      // First moment (momentum)
    v: [Quat],      // Second moment (RMSprop)
    t: i32,         // Timestep
    beta1: f32,     // Momentum decay (default 0.9)
    beta2: f32,     // RMSprop decay (default 0.999)
    eps: f32,       // Numerical stability (default 1e-8)
}

fn quat_adam_new(num_params: i32) -> QuatAdamState {
    var zero_quat = quat_zero()
    QuatAdamState {
        m: [zero_quat; num_params],
        v: [zero_quat; num_params],
        t: 0,
        beta1: 0.9,
        beta2: 0.999,
        eps: 1e-8,
    }
}

fn quat_adam_update(
    params: &![Quat],
    grads: &[Quat],
    state: &!QuatAdamState,
    lr: f32,
) {
    // Increment timestep
    state.t = state.t + 1
    let t_f = (state.t as f32)

    // Bias-corrected learning rate
    let bias_corr_m = 1.0 - state.beta1.powf(t_f)
    let bias_corr_v = 1.0 - state.beta2.powf(t_f)
    let lr_t = lr * (bias_corr_v.sqrt()) / bias_corr_m

    // Update each quaternion parameter
    for i in 0..params.len() {
        // Update biased first moment (momentum)
        state.m[i] = quat_add(
            quat_scale(state.m[i], state.beta1),
            quat_scale(grads[i], 1.0 - state.beta1),
        )

        // Update biased second moment (RMSprop)
        let g_sq = quat_mul(grads[i], grads[i])  // Element-wise square
        state.v[i] = quat_add(
            quat_scale(state.v[i], state.beta2),
            quat_scale(g_sq, 1.0 - state.beta2),
        )

        // Bias-corrected estimates
        let m_hat = quat_scale(state.m[i], 1.0 / bias_corr_m)
        let v_hat = quat_scale(state.v[i], 1.0 / bias_corr_v)

        // Adaptive learning rate update
        let v_sqrt = quat_scale(v_hat, 1.0 / (state.eps + quat_norm(v_hat)))
        let update = quat_mul(m_hat, v_sqrt)
        let update_scaled = quat_scale(update, -lr_t)

        params[i] = quat_add(params[i], update_scaled)
    }
}

// ============================================================================
// Momentum SGD Optimizer
// ============================================================================

type QuatSGDState = struct {
    velocity: [Quat],
    momentum: f32,    // Default 0.9
    weight_decay: f32, // L2 regularization coefficient
}

fn quat_sgd_new(num_params: i32) -> QuatSGDState {
    var zero_quat = quat_zero()
    QuatSGDState {
        velocity: [zero_quat; num_params],
        momentum: 0.9,
        weight_decay: 0.0,
    }
}

fn quat_sgd_update(
    params: &![Quat],
    grads: &[Quat],
    state: &!QuatSGDState,
    lr: f32,
) {
    for i in 0..params.len() {
        // Gradient with weight decay
        var g_eff = grads[i]
        if state.weight_decay > 0.0 {
            let l2_term = quat_scale(params[i], state.weight_decay)
            g_eff = quat_add(g_eff, l2_term)
        }

        // Velocity update: v = momentum * v - lr * g
        state.velocity[i] = quat_add(
            quat_scale(state.velocity[i], state.momentum),
            quat_scale(g_eff, -lr),
        )

        // Parameter update: p = p + v
        params[i] = quat_add(params[i], state.velocity[i])
    }
}

fn quat_sgd_nesterov_update(
    params: &![Quat],
    grads: &[Quat],
    state: &!QuatSGDState,
    lr: f32,
) {
    for i in 0..params.len() {
        // Gradient with weight decay
        var g_eff = grads[i]
        if state.weight_decay > 0.0 {
            let l2_term = quat_scale(params[i], state.weight_decay)
            g_eff = quat_add(g_eff, l2_term)
        }

        // Nesterov update: v = momentum * v - lr * g
        state.velocity[i] = quat_add(
            quat_scale(state.velocity[i], state.momentum),
            quat_scale(g_eff, -lr),
        )

        // Look-ahead: p = p + momentum * v - lr * g
        let lookahead = quat_add(
            quat_scale(state.velocity[i], state.momentum),
            quat_scale(g_eff, -lr),
        )
        params[i] = quat_add(params[i], lookahead)
    }
}

// ============================================================================
// Riemannian SGD for Unit Quaternions (Manifold Optimization)
// ============================================================================

// Project gradient to tangent space at quaternion q
fn quat_project_tangent(grad: Quat, q: Quat) -> Quat {
    let inner_prod = quat_dot(grad, q)
    let proj = quat_scale(q, inner_prod)
    quat_sub(grad, proj)
}

fn quat_riemannian_sgd_update(
    params: &![Quat],
    grads: &[Quat],
    lr: f32,
) {
    for i in 0..params.len() {
        // Project gradient to tangent space at q
        let grad_tangent = quat_project_tangent(grads[i], params[i])

        // Normalize quaternion to stay on S^3
        let q_norm = quat_norm(params[i])
        if q_norm > 1e-7 {
            params[i] = quat_scale(params[i], 1.0 / q_norm)
        }

        // Retract using exponential map
        let update = quat_scale(grad_tangent, -lr)
        let q_exp = quat_exp(update)
        let new_param = quat_mul(q_exp, params[i])

        // Normalize result
        let new_norm = quat_norm(new_param)
        if new_norm > 1e-7 {
            params[i] = quat_scale(new_param, 1.0 / new_norm)
        } else {
            params[i] = quat_identity()
        }
    }
}

// ============================================================================
// Unified Optimizer Interface
// ============================================================================

type QuatOptimizer = enum {
    Adam(QuatAdamState),
    SGD(QuatSGDState),
    Riemannian,
}

fn quat_optimizer_update(
    params: &![Quat],
    grads: &[Quat],
    opt: &!QuatOptimizer,
    lr: f32,
) {
    match opt {
        QuatOptimizer::Adam(state) => {
            quat_adam_update(params, grads, &!state, lr)
        },
        QuatOptimizer::SGD(state) => {
            quat_sgd_update(params, grads, &!state, lr)
        },
        QuatOptimizer::Riemannian => {
            quat_riemannian_sgd_update(params, grads, lr)
        },
    }
}

// ============================================================================
// Gradient Clipping and Diagnostics
// ============================================================================

fn quat_clip_grad_norm(grads: &![Quat], max_norm: f32) {
    let norm = quat_grad_norm(grads)
    if norm > max_norm && norm > 1e-7 {
        let scale = max_norm / norm
        for g in grads {
            *g = quat_scale(*g, scale)
        }
    }
}

fn quat_compute_grad_stats(grads: &[Quat]) -> GradStats {
    let norm = quat_grad_norm(grads)
    var max_val: f32 = 0.0
    var sum_val: f32 = 0.0
    var count: i32 = 0

    for g in grads {
        let g_norm = quat_norm(*g)
        max_val = max_val.max(g_norm)
        sum_val = sum_val + g_norm
        count = count + 1
    }

    let mean = if count > 0 { sum_val / (count as f32) } else { 0.0 }

    GradStats { mean: mean, max: max_val, norm: norm }
}
