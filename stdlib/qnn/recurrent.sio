//! stdlib/qnn/recurrent.sio - Quaternionic Recurrent Layers
//!
//! LSTM and GRU layers with quaternion-valued hidden states and gates.
//!
//! Reference: "Quaternion Recurrent Neural Networks" (arXiv:1903.08478)

// Quaternionic LSTM layer
// Maintains quaternion-valued hidden state and cell state
struct QuatLSTMLayer {
    input_size: i32,
    hidden_size: i32,
}

// Quaternionic GRU layer
// Maintains quaternion-valued hidden state
struct QuatGRULayer {
    input_size: i32,
    hidden_size: i32,
}

// Create a new quaternionic LSTM layer
fn quat_lstm_new(input_size: i32, hidden_size: i32) -> QuatLSTMLayer {
    QuatLSTMLayer {
        input_size,
        hidden_size,
    }
}

// Create a new quaternionic GRU layer
fn quat_gru_new(input_size: i32, hidden_size: i32) -> QuatGRULayer {
    QuatGRULayer {
        input_size,
        hidden_size,
    }
}

// Single LSTM timestep using Hamilton product for gate operations
// Wraps quat_lstm_cell intrinsic
// Inputs: input_t, (h_prev, c_prev)
// Outputs: (h_next, c_next)
fn quat_lstm_cell_wrapper(
    gate: &QuatGate,
    input_t: &[Quat],
    hidden_state: &[Quat]
) -> ([Quat], [Quat]) {
    quat_lstm_cell(gate, input_t, hidden_state)
}

// Full LSTM sequence processing
// Input: [seq_len, batch, input_size] quats
// Output: [seq_len, batch, hidden_size] quats
fn quat_lstm_forward(
    layer: &QuatLSTMLayer,
    gate: &QuatGate,
    input_seq: &[[Quat]],
    initial_state: &[Quat]
) -> [[Quat]] {
    let seq_len = input_seq.len() as i32
    var hidden_state = initial_state
    var outputs: [[Quat]]

    let t: i32 = 0
    while t < seq_len {
        let (new_state, output) = quat_lstm_cell(gate, input_seq[t], hidden_state)
        hidden_state = new_state
        outputs[t] = output
        t = t + 1
    }

    outputs
}

// Single GRU timestep using Hamilton product for gate operations
// Wraps quat_gru_cell intrinsic
fn quat_gru_cell_wrapper(
    gate: &QuatGate,
    input_t: &[Quat],
    hidden_state: &[Quat]
) -> [Quat] {
    quat_gru_cell(gate, input_t, hidden_state)
}

// Full GRU sequence processing
// Input: [seq_len, batch, input_size] quats
// Output: [seq_len, batch, hidden_size] quats
fn quat_gru_forward(
    layer: &QuatGRULayer,
    gate: &QuatGate,
    input_seq: &[[Quat]],
    initial_state: &[Quat]
) -> [[Quat]] {
    let seq_len = input_seq.len() as i32
    var hidden_state = initial_state
    var outputs: [[Quat]]

    let t: i32 = 0
    while t < seq_len {
        hidden_state = quat_gru_cell(gate, input_seq[t], hidden_state)
        outputs[t] = hidden_state
        t = t + 1
    }

    outputs
}
