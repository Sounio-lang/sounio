//! stdlib/qnn/attention.sio - Quaternionic Multi-Head Attention
//!
//! Multi-head attention mechanism for quaternion-valued sequences.
//! Benefits: Captures 3D rotational symmetries and spatial relationships naturally.

// Multi-head attention for quaternion-valued sequences
struct QuatMultiHeadAttention {
    num_heads: i32,
    head_dim: i32,   // Quaternions per head
    embed_dim: i32,  // Total embedding dimension
}

// Create a new multi-head attention layer
fn quat_attention_new(num_heads: i32, head_dim: i32, embed_dim: i32) -> QuatMultiHeadAttention {
    QuatMultiHeadAttention {
        num_heads,
        head_dim,
        embed_dim,
    }
}

// Compute multi-head attention forward pass
// Wraps quat_attention intrinsic
// Inputs: query, key, value [seq_len, batch, embed_dim] quats
// Output: attended values [seq_len, batch, embed_dim] quats
// Uses quaternion dot product for attention scores
fn quat_attention_forward(
    layer: &QuatMultiHeadAttention,
    query: &[Quat],
    key: &[Quat],
    value: &[Quat]
) -> ([Quat], [[f32]]) {
    quat_attention(query, key, value)
}

// Core quaternion scaled dot-product attention
// Uses quaternion dot product for similarity
// Component-wise softmax after quaternion scoring
fn quat_scaled_dot_product_attention(
    query: &[Quat],
    key: &[Quat],
    value: &[Quat],
    scale: f32
) -> [Quat] {
    let seq_len = query.len() as i32
    var attention_weights: [[f32]]
    var output: [Quat]

    // Compute attention scores: Q · K^T
    let i: i32 = 0
    while i < seq_len {
        let j: i32 = 0
        var scores: [f32]
        while j < seq_len {
            // Quaternion dot product
            let score = query[i].w * key[j].w +
                       query[i].x * key[j].x +
                       query[i].y * key[j].y +
                       query[i].z * key[j].z
            scores[j] = score * scale
            j = j + 1
        }

        // Softmax over scores
        var exp_sum: f32 = 0.0
        let k: i32 = 0
        while k < seq_len {
            let exp_val = scores[k].exp()
            scores[k] = exp_val
            exp_sum = exp_sum + exp_val
            k = k + 1
        }

        let k: i32 = 0
        while k < seq_len {
            attention_weights[i][k] = scores[k] / exp_sum
            k = k + 1
        }

        i = i + 1
    }

    // Apply attention to values
    let i: i32 = 0
    while i < seq_len {
        var attended = quat(0.0, 0.0, 0.0, 0.0)
        let j: i32 = 0
        while j < seq_len {
            let weight = attention_weights[i][j]
            attended = quat_add(attended, quat_scale(value[j], weight))
            j = j + 1
        }
        output[i] = attended
        i = i + 1
    }

    output
}

// Helper: Scale quaternion by scalar
fn quat_scale(q: Quat, s: f32) -> Quat {
    quat(q.w * s, q.x * s, q.y * s, q.z * s)
}

// Helper: Add two quaternions
fn quat_add(a: Quat, b: Quat) -> Quat {
    quat(a.w + b.w, a.x + b.x, a.y + b.y, a.z + b.z)
}
