//! stdlib/qnn/mod.sio - Quaternionic Neural Network Module
//!
//! Native quaternionic neural network support for Sounio.
//! Provides 4x parameter efficiency through hypercomplex algebra.
//!
//! References:
//!   - Quaternion Convolutional Neural Networks (arXiv:1804.10592)
//!   - Quaternion Recurrent Neural Networks (arXiv:1903.08478)
//!   - Deep Quaternion Networks (arXiv:1705.07944)
//!
//! Usage:
//!   use std::qnn
//!
//!   let layer = qnn::quat_linear_new(16, 32)
//!   let weights = qnn::quat_xavier_init(16, 32, seed: 42)
//!   let bias = qnn::quat_xavier_init(1, 32, seed: 43)
//!   let output = qnn::quat_linear_forward(layer, weights, input, bias)
//!   let activated = qnn::quat_relu_activate(output)

// Re-export submodules (using import instead of mod keyword)
// Note: Sounio doesn't support 'mod' declarations yet, so we export
// placeholder documentation. The actual functions are available as
// intrinsics via the compiler.

// All QNN functions are available as compiler intrinsics:
// - quat_init_xavier, quat_init_he, quat_init_unit
// - quat_linear_fwd, quat_linear_bwd
// - quat_conv2d_fwd, quat_conv2d_bwd
// - quat_relu, quat_sigmoid, quat_tanh, quat_leaky_relu
// - quat_lstm_cell, quat_gru_cell
// - quat_attention
// - quat_bn_create, quat_bn_fwd, quat_bn_bwd
