//! stdlib/qnn/loss.sio - Loss Functions for Quaternion Neural Networks
//!
//! Loss functions adapted for quaternion-valued outputs.
//! Losses can be computed component-wise or use quaternion-specific metrics.
//!
//! Usage Guidelines:
//!   - quat_mse_loss: Regression tasks with arbitrary quaternion targets
//!   - quat_mae_loss: Robust regression with quaternion distance
//!   - quat_cosine_similarity_loss: Orientation/rotation prediction tasks

/// Mean Squared Error for quaternions
/// Computes sum of squared quaternion distances: Σ||pred[i] - target[i]||²
fn quat_mse_loss(pred: &[Quat], target: &[Quat]) -> f32 {
    let n = pred.len() as i32
    var total_loss: f32 = 0.0

    let i: i32 = 0
    while i < n {
        let diff = quat_sub(pred[i], target[i])
        let norm_sq = diff.w * diff.w + diff.x * diff.x + diff.y * diff.y + diff.z * diff.z
        total_loss = total_loss + norm_sq
        i = i + 1
    }

    total_loss / (n as f32)
}

/// Mean Absolute Error using quaternion norms
/// Computes sum of quaternion distances: Σ||pred[i] - target[i]||
fn quat_mae_loss(pred: &[Quat], target: &[Quat]) -> f32 {
    let n = pred.len() as i32
    var total_loss: f32 = 0.0

    let i: i32 = 0
    while i < n {
        let diff = quat_sub(pred[i], target[i])
        let norm_sq = diff.w * diff.w + diff.x * diff.x + diff.y * diff.y + diff.z * diff.z
        let norm = norm_sq.sqrt()
        total_loss = total_loss + norm
        i = i + 1
    }

    total_loss / (n as f32)
}

/// Cosine Similarity Loss for quaternions
/// Uses normalized quaternion dot products to measure orientation similarity
/// Formula: Σ(1 - (pred[i]·target[i]) / (||pred[i]|| ||target[i]||))
/// Ideal for rotation prediction tasks (invariant to scaling and sign)
fn quat_cosine_similarity_loss(pred: &[Quat], target: &[Quat]) -> f32 {
    let n = pred.len() as i32
    var total_loss: f32 = 0.0

    let i: i32 = 0
    while i < n {
        // Compute norms
        let pred_norm_sq = pred[i].w * pred[i].w + pred[i].x * pred[i].x +
                          pred[i].y * pred[i].y + pred[i].z * pred[i].z
        let target_norm_sq = target[i].w * target[i].w + target[i].x * target[i].x +
                            target[i].y * target[i].y + target[i].z * target[i].z

        let pred_norm = pred_norm_sq.sqrt()
        let target_norm = target_norm_sq.sqrt()

        // Compute dot product
        let dot = pred[i].w * target[i].w + pred[i].x * target[i].x +
                 pred[i].y * target[i].y + pred[i].z * target[i].z

        // Cosine similarity with numerical stability
        let epsilon: f32 = 1e-8
        let cos_sim = dot / ((pred_norm + epsilon) * (target_norm + epsilon))

        // Clamp to [-1, 1] for numerical stability
        let cos_sim_clamped = if cos_sim > 1.0 { 1.0 } else if cos_sim < -1.0 { -1.0 } else { cos_sim }

        total_loss = total_loss + (1.0 - cos_sim_clamped)
        i = i + 1
    }

    total_loss / (n as f32)
}

/// Helper: Quaternion subtraction
fn quat_sub(a: Quat, b: Quat) -> Quat {
    quat(a.w - b.w, a.x - b.x, a.y - b.y, a.z - b.z)
}

/// Helper: Quaternion addition
fn quat_add(a: Quat, b: Quat) -> Quat {
    quat(a.w + b.w, a.x + b.x, a.y + b.y, a.z + b.z)
}
