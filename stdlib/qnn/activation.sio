//! stdlib/qnn/activation.sio - Quaternionic Activation Functions
//!
//! Quaternion-aware activation functions for neural networks.
//! Activations are applied component-wise to each quaternion (w, x, y, z):
//!   activate(quat) = (activate(w), activate(x), activate(y), activate(z))
//!
//! Example:
//!   let q = quat(1.0, -2.0, 3.0, -4.0)
//!   let activated = quat_relu(q)  // => quat(1.0, 0.0, 3.0, 0.0)

// Applies ReLU activation component-wise to a quaternion
// ReLU(x) = max(0, x) applied to each of (w, x, y, z)
// Intrinsic: quat_relu
fn quat_relu_activate(q: Quat) -> Quat {
    quat_relu(q)
}

// Applies sigmoid activation component-wise to a quaternion
// Sigmoid(x) = 1 / (1 + exp(-x)) applied to each of (w, x, y, z)
// Intrinsic: quat_sigmoid
fn quat_sigmoid_activate(q: Quat) -> Quat {
    quat_sigmoid(q)
}

// Applies tanh activation component-wise to a quaternion
// Tanh(x) = (exp(x) - exp(-x)) / (exp(x) + exp(-x))
// Intrinsic: quat_tanh
fn quat_tanh_activate(q: Quat) -> Quat {
    quat_tanh(q)
}

// Applies leaky ReLU activation component-wise to a quaternion
// LeakyReLU(x) = x if x > 0, else alpha * x
// Intrinsic: quat_leaky_relu
fn quat_leaky_relu_activate(q: Quat, alpha: f32) -> Quat {
    quat_leaky_relu(q, alpha)
}

// Applies ReLU to a batch of quaternions
fn quat_relu_batch(input: &[Quat], output: &![Quat]) {
    let i: i32 = 0
    let n = input.len() as i32
    while i < n {
        output[i] = quat_relu(input[i])
        i = i + 1
    }
}

// Applies sigmoid to a batch of quaternions
fn quat_sigmoid_batch(input: &[Quat], output: &![Quat]) {
    let i: i32 = 0
    let n = input.len() as i32
    while i < n {
        output[i] = quat_sigmoid(input[i])
        i = i + 1
    }
}

// Applies tanh to a batch of quaternions
fn quat_tanh_batch(input: &[Quat], output: &![Quat]) {
    let i: i32 = 0
    let n = input.len() as i32
    while i < n {
        output[i] = quat_tanh(input[i])
        i = i + 1
    }
}

// Applies leaky ReLU to a batch of quaternions
fn quat_leaky_relu_batch(input: &[Quat], output: &![Quat], alpha: f32) {
    let i: i32 = 0
    let n = input.len() as i32
    while i < n {
        output[i] = quat_leaky_relu(input[i], alpha)
        i = i + 1
    }
}
