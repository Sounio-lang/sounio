// ANSI Color and Styling Utilities
//
// Provides terminal color output using ANSI escape codes.
// All functions use print() and affect subsequent output until reset.
//
// Supports:
// - 16 standard colors (foreground + background)
// - Text styles (bold, dim, italic, underline)
// - 256-color mode via index
// - RGB true color via components

// ============================================================================
// RESET
// ============================================================================

fn reset() with IO {
    print("\x1b[0m")
}

fn reset_str() -> string {
    "\x1b[0m"
}

// ============================================================================
// TEXT STYLES
// ============================================================================

fn bold() with IO {
    print("\x1b[1m")
}

fn dim() with IO {
    print("\x1b[2m")
}

fn italic() with IO {
    print("\x1b[3m")
}

fn underline() with IO {
    print("\x1b[4m")
}

fn bold_str() -> string { "\x1b[1m" }
fn dim_str() -> string { "\x1b[2m" }

// ============================================================================
// FOREGROUND COLORS
// ============================================================================

fn black() with IO { print("\x1b[30m") }
fn red() with IO { print("\x1b[31m") }
fn green() with IO { print("\x1b[32m") }
fn yellow() with IO { print("\x1b[33m") }
fn blue() with IO { print("\x1b[34m") }
fn magenta() with IO { print("\x1b[35m") }
fn cyan() with IO { print("\x1b[36m") }
fn white() with IO { print("\x1b[37m") }

fn bright_black() with IO { print("\x1b[90m") }
fn bright_red() with IO { print("\x1b[91m") }
fn bright_green() with IO { print("\x1b[92m") }
fn bright_yellow() with IO { print("\x1b[93m") }
fn bright_blue() with IO { print("\x1b[94m") }
fn bright_magenta() with IO { print("\x1b[95m") }
fn bright_cyan() with IO { print("\x1b[96m") }
fn bright_white() with IO { print("\x1b[97m") }

// String-returning variants for embedding in formatted strings
fn red_str() -> string { "\x1b[31m" }
fn green_str() -> string { "\x1b[32m" }
fn yellow_str() -> string { "\x1b[33m" }
fn blue_str() -> string { "\x1b[34m" }
fn magenta_str() -> string { "\x1b[35m" }
fn cyan_str() -> string { "\x1b[36m" }
fn white_str() -> string { "\x1b[37m" }

// ============================================================================
// BACKGROUND COLORS
// ============================================================================

fn bg_black() with IO { print("\x1b[40m") }
fn bg_red() with IO { print("\x1b[41m") }
fn bg_green() with IO { print("\x1b[42m") }
fn bg_yellow() with IO { print("\x1b[43m") }
fn bg_blue() with IO { print("\x1b[44m") }
fn bg_magenta() with IO { print("\x1b[45m") }
fn bg_cyan() with IO { print("\x1b[46m") }
fn bg_white() with IO { print("\x1b[47m") }

// ============================================================================
// COLOR MAPPING: Value → Color
// ============================================================================

// Map a normalized value [0.0, 1.0] to a traffic-light color
// 0.0 = green (good), 0.5 = yellow (caution), 1.0 = red (danger)
fn traffic_color(normalized: f64) with IO {
    if normalized < 0.3 {
        green()
    }
    if normalized >= 0.3 && normalized < 0.6 {
        yellow()
    }
    if normalized >= 0.6 {
        red()
    }
}

// Map a normalized value [0.0, 1.0] to a blue-red gradient
// 0.0 = blue (cold), 0.5 = white, 1.0 = red (hot)
fn heatmap_color(normalized: f64) with IO {
    if normalized < 0.25 {
        blue()
    }
    if normalized >= 0.25 && normalized < 0.5 {
        cyan()
    }
    if normalized >= 0.5 && normalized < 0.75 {
        yellow()
    }
    if normalized >= 0.75 {
        red()
    }
}

// Map a normalized value [0.0, 1.0] to a background heatmap color
fn heatmap_bg(normalized: f64) with IO {
    if normalized < 0.25 {
        bg_blue()
    }
    if normalized >= 0.25 && normalized < 0.5 {
        bg_cyan()
    }
    if normalized >= 0.5 && normalized < 0.75 {
        bg_yellow()
    }
    if normalized >= 0.75 {
        bg_red()
    }
}

// Map confidence level to color (epistemic)
// High confidence = green, low = red
fn confidence_color(confidence: f64) with IO {
    if confidence >= 0.95 {
        bright_green()
    }
    if confidence >= 0.8 && confidence < 0.95 {
        green()
    }
    if confidence >= 0.5 && confidence < 0.8 {
        yellow()
    }
    if confidence < 0.5 {
        red()
    }
}

// Map uncertainty to background intensity
fn uncertainty_bg(uncertainty: f64, max_uncertainty: f64) with IO, Panic {
    let normalized = uncertainty / max_uncertainty
    if normalized < 0.3 {
        bg_green()
    }
    if normalized >= 0.3 && normalized < 0.6 {
        bg_yellow()
    }
    if normalized >= 0.6 {
        bg_red()
    }
}
