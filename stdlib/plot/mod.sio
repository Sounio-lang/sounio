// - canvas: Text-based drawing canvas
// - bar: Bar chart rendering
// - line: Line plot rendering
// - scatter: Scatter plot rendering
// - heatmap: 2D heatmap rendering
// - epistemic: Uncertainty and confidence visualization

pub mod color;
pub mod canvas;
pub mod bar;
pub mod line;
pub mod scatter;
pub mod heatmap;
pub mod epistemic;
