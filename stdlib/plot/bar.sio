// Bar Chart Rendering
//
// Horizontal and vertical bar charts with:
// - Automatic scaling
// - Color support
// - Label formatting
// - Optional error bars (for Knowledge<T> integration)

// ============================================================================
// BAR CHART TYPES
// ============================================================================

struct BarEntry {
    label: string,
    value: f64,
    color_code: string,  // ANSI escape or empty
}

struct BarChartConfig {
    title: string,
    width: i64,           // max bar width in characters
    show_values: bool,    // show numeric values
    show_border: bool,    // draw border around chart
    fill_char: string,    // character for bar fill
    empty_char: string,   // character for empty space
}

fn bar_entry_new(label: string, value: f64) -> BarEntry {
    BarEntry {
        label: label,
        value: value,
        color_code: "",
    }
}

fn bar_entry_colored(label: string, value: f64, color: string) -> BarEntry {
    BarEntry {
        label: label,
        value: value,
        color_code: color,
    }
}

fn bar_config_default() -> BarChartConfig {
    BarChartConfig {
        title: "",
        width: 40,
        show_values: true,
        show_border: true,
        fill_char: "█",
        empty_char: " ",
    }
}

fn bar_config_new(title: string, width: i64) -> BarChartConfig {
    BarChartConfig {
        title: title,
        width: width,
        show_values: true,
        show_border: true,
        fill_char: "█",
        empty_char: " ",
    }
}

// ============================================================================
// HORIZONTAL BAR CHART
// ============================================================================

// Render a horizontal bar chart
// entries: array of BarEntry
// n: number of entries
// config: chart configuration
fn bar_chart_horizontal(entries: &[BarEntry], n: i64, config: &BarChartConfig) with IO {
    if n <= 0 { return }

    // Find max value for scaling
    var max_val = 0.0
    var max_label_len: i64 = 0
    var i: i64 = 0
    while i < n {
        if entries[i as usize].value > max_val {
            max_val = entries[i as usize].value
        }
        let label_len = entries[i as usize].label.len() as i64
        if label_len > max_label_len {
            max_label_len = label_len
        }
        i = i + 1
    }
    if max_val <= 0.0 { max_val = 1.0 }

    let reset = "\x1b[0m"

    // Title
    if config.title.len() > 0 {
        print("\x1b[1m")
        println(config.title)
        print(reset)
        println("")
    }

    // Top border
    if config.show_border {
        print("  ")
        var pad: i64 = 0
        while pad < max_label_len {
            print(" ")
            pad = pad + 1
        }
        print("┌")
        var j: i64 = 0
        while j < config.width + 2 {
            print("─")
            j = j + 1
        }
        println("┐")
    }

    // Bars
    i = 0
    while i < n {
        let entry = entries[i as usize]
        let bar_len = (entry.value / max_val * config.width as f64) as i64

        // Label with padding
        print("  ")
        let padding = max_label_len - entry.label.len() as i64
        var p: i64 = 0
        while p < padding {
            print(" ")
            p = p + 1
        }
        print(entry.label)

        if config.show_border { print("│") }
        print(" ")

        // Bar
        if entry.color_code.len() > 0 {
            print(entry.color_code)
        }
        var b: i64 = 0
        while b < bar_len {
            print(config.fill_char)
            b = b + 1
        }
        if entry.color_code.len() > 0 {
            print(reset)
        }

        // Value
        if config.show_values {
            print(" ")
            print_f64(entry.value, 2)
        }

        println("")
        i = i + 1
    }

    // Bottom border
    if config.show_border {
        print("  ")
        var pad: i64 = 0
        while pad < max_label_len {
            print(" ")
            pad = pad + 1
        }
        print("└")
        var j: i64 = 0
        while j < config.width + 2 {
            print("─")
            j = j + 1
        }
        println("┘")
    }
}

// ============================================================================
// SIMPLE BAR CHART (convenience)
// ============================================================================

// Quick horizontal bar chart from labels and values
fn bar_chart(labels: &[string], values: &[f64], n: i64, title: string) with IO {
    var entries: [BarEntry; 64] = [bar_entry_new("", 0.0); 64]
    var i: i64 = 0
    while i < n && i < 64 {
        entries[i as usize] = bar_entry_new(labels[i as usize], values[i as usize])
        i = i + 1
    }

    let config = bar_config_new(title, 40)
    bar_chart_horizontal(&entries, n, &config)
}

// Quick colored bar chart with traffic-light colors based on value
fn bar_chart_colored(labels: &[string], values: &[f64], n: i64, title: string) with IO {
    if n <= 0 { return }

    // Find max for normalization
    var max_val = 0.0
    var i: i64 = 0
    while i < n {
        if values[i as usize] > max_val {
            max_val = values[i as usize]
        }
        i = i + 1
    }
    if max_val <= 0.0 { max_val = 1.0 }

    var entries: [BarEntry; 64] = [bar_entry_new("", 0.0); 64]
    i = 0
    while i < n && i < 64 {
        let normalized = values[i as usize] / max_val
        var color = "\x1b[32m"  // green
        if normalized >= 0.3 && normalized < 0.6 {
            color = "\x1b[33m"  // yellow
        }
        if normalized >= 0.6 {
            color = "\x1b[31m"  // red
        }
        entries[i as usize] = bar_entry_colored(labels[i as usize], values[i as usize], color)
        i = i + 1
    }

    let config = bar_config_new(title, 40)
    bar_chart_horizontal(&entries, n, &config)
}

// ============================================================================
// STACKED BAR (two-value comparison)
// ============================================================================

// Print a single comparison bar showing value vs reference
fn comparison_bar(label: string, value: f64, reference: f64, width: i64) with IO {
    let max_val = if value > reference { value } else { reference }
    if max_val <= 0.0 { return }

    let val_len = (value / max_val * width as f64) as i64
    let ref_len = (reference / max_val * width as f64) as i64
    let reset = "\x1b[0m"

    print("  ")
    print(label)
    print(": ")

    // Value bar (green/cyan)
    print("\x1b[36m")
    var i: i64 = 0
    while i < val_len {
        print("█")
        i = i + 1
    }
    print(reset)

    // Reference line
    if ref_len > val_len {
        var j: i64 = val_len
        while j < ref_len {
            print("░")
            j = j + 1
        }
    }

    print(" ")
    print_f64(value, 2)
    print(" (ref: ")
    print_f64(reference, 2)
    print(")")
    println("")
}

// ============================================================================
// HELPERS
// ============================================================================

fn print_f64(value: f64, decimals: i64) with IO {
    // Simple float printing with fixed decimal places
    let int_part = value as i64
    let frac = value - int_part as f64
    let frac_abs = if frac < 0.0 { -frac } else { frac }

    if value < 0.0 && int_part == 0 {
        print("-")
    }
    print_i64(int_part)
    print(".")

    var d: i64 = 0
    var remaining = frac_abs
    while d < decimals {
        remaining = remaining * 10.0
        let digit = remaining as i64
        print_i64(digit)
        remaining = remaining - digit as f64
        d = d + 1
    }
}

fn print_i64(value: i64) with IO {
    // Placeholder: actual implementation depends on runtime
    // In practice, print() handles integer formatting
    print(value)
}
