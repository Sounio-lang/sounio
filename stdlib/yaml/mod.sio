//! stdlib/yaml/mod.sio - YAML Parser and Emitter
//!
//! This module provides parsing and serialization of YAML 1.2 (Core schema).
//! Supports a common subset suitable for configuration files and data exchange.
//!
//! # Supported Features
//! - Scalars: strings, integers, floats, booleans, null
//! - Sequences (arrays)
//! - Mappings (objects)
//! - Flow and block styles
//! - Comments (ignored during parsing)
//! - Multi-line strings (literal |, folded >)
//!
//! # Not Supported
//! - Anchors and aliases (&, *)
//! - Tags (!tag)
//! - Multiple documents (---)
//!
//! # Examples
//! ```sio
//! let yaml_str = "
//! name: John
//! age: 30
//! tags:
//!   - developer
//!   - rust
//! "
//!
//! match parse_yaml(yaml_str) {
//!     Ok(value) => {
//!         let name = yaml_get(&value, "name")
//!         print("Name: " ++ yaml_as_str(name).unwrap_or("unknown"))
//!     },
//!     Err(e) => print("Parse error: " ++ yaml_error_message(&e)),
//! }
//! ```

// =============================================================================
// YAML Value Types
// =============================================================================

/// Represents a YAML value
pub enum YamlValue {
    /// Null value (null, ~, or empty)
    Null,
    /// Boolean value (true/false, yes/no, on/off)
    Bool(bool),
    /// Integer value
    Int(i64),
    /// Floating point value
    Float(f64),
    /// String value
    String(string),
    /// Sequence (array)
    Sequence(Vec<YamlValue>),
    /// Mapping (object)
    Mapping(Vec<YamlEntry>)
}

/// A key-value entry in a mapping
pub struct YamlEntry {
    pub key: string,
    pub value: YamlValue
}

/// Parse errors
pub enum YamlError {
    /// Unexpected character at position
    UnexpectedChar { line: usize, col: usize, ch: char },
    /// Unexpected end of input
    UnexpectedEof { context: string },
    /// Invalid indentation
    InvalidIndentation { line: usize, expected: usize, found: usize },
    /// Invalid escape sequence
    InvalidEscape { line: usize, col: usize },
    /// Duplicate key in mapping
    DuplicateKey { key: string, line: usize },
    /// Invalid number format
    InvalidNumber { line: usize, text: string },
    /// Tab used for indentation (not allowed)
    TabIndentation { line: usize },
    /// Unsupported feature
    Unsupported { feature: string, line: usize }
}

/// Returns an error message for the error
pub fn yaml_error_message(err: &YamlError) -> string {
    match err {
        YamlError::UnexpectedChar { line, col, ch } =>
            "Unexpected character '" ++ ch.to_string() ++ "' at line " ++ line.to_string() ++ ", col " ++ col.to_string(),
        YamlError::UnexpectedEof { context } =>
            "Unexpected end of input " ++ *context,
        YamlError::InvalidIndentation { line, expected, found } =>
            "Invalid indentation at line " ++ line.to_string() ++ ": expected " ++ expected.to_string() ++ ", found " ++ found.to_string(),
        YamlError::InvalidEscape { line, col } =>
            "Invalid escape sequence at line " ++ line.to_string() ++ ", col " ++ col.to_string(),
        YamlError::DuplicateKey { key, line } =>
            "Duplicate key '" ++ *key ++ "' at line " ++ line.to_string(),
        YamlError::InvalidNumber { line, text } =>
            "Invalid number '" ++ *text ++ "' at line " ++ line.to_string(),
        YamlError::TabIndentation { line } =>
            "Tab used for indentation at line " ++ line.to_string() ++ " (use spaces)",
        YamlError::Unsupported { feature, line } =>
            "Unsupported feature '" ++ *feature ++ "' at line " ++ line.to_string()
    }
}

// =============================================================================
// Parser State
// =============================================================================

struct Parser {
    input: string,
    pos: usize,
    line: usize,
    col: usize,
    len: usize
}

fn parser_new(input: &str) -> Parser {
    Parser {
        input: input.to_string(),
        pos: 0,
        line: 1,
        col: 1,
        len: input.len()
    }
}

fn parser_peek(p: &Parser) -> Option<char> {
    if p.pos >= p.len {
        None
    } else {
        Some(p.input.char_at(p.pos))
    }
}

fn parser_advance(p: &!Parser) -> Option<char> {
    if p.pos >= p.len {
        None
    } else {
        let ch = p.input.char_at(p.pos);
        p.pos = p.pos + 1;
        if ch == '\n' {
            p.line = p.line + 1;
            p.col = 1;
        } else {
            p.col = p.col + 1;
        }
        Some(ch)
    }
}

fn parser_eof(p: &Parser) -> bool {
    p.pos >= p.len
}

// =============================================================================
// Parsing Functions
// =============================================================================

/// Parses a YAML string into a YamlValue.
///
/// # Example
/// ```sio
/// let value = parse_yaml("key: value").unwrap()
/// ```
pub fn parse_yaml(input: &str) -> Result<YamlValue, YamlError> with Alloc {
    var p = parser_new(input);

    skip_whitespace_and_comments(&!p);

    if parser_eof(&p) {
        return Ok(YamlValue::Null)
    }

    parse_value(&!p, 0)
}

fn parse_value(p: &!Parser, indent: usize) -> Result<YamlValue, YamlError> with Alloc {
    skip_whitespace_and_comments(p);

    if parser_eof(p) {
        return Ok(YamlValue::Null)
    }

    match parser_peek(p) {
        Some(ch) => {
            if ch == '-' && is_sequence_indicator(p) {
                parse_block_sequence(p, indent)
            } else if ch == '[' {
                parse_flow_sequence(p)
            } else if ch == '{' {
                parse_flow_mapping(p)
            } else if ch == '"' {
                parse_double_quoted_string(p).map(|s| YamlValue::String(s))
            } else if ch == '\'' {
                parse_single_quoted_string(p).map(|s| YamlValue::String(s))
            } else if ch == '|' || ch == '>' {
                parse_block_scalar(p)
            } else if ch == '&' || ch == '*' {
                Err(YamlError::Unsupported { feature: "anchors/aliases".to_string(), line: p.line })
            } else if ch == '!' {
                Err(YamlError::Unsupported { feature: "tags".to_string(), line: p.line })
            } else {
                // Could be mapping or plain scalar
                parse_block_mapping_or_scalar(p, indent)
            }
        },
        None => Ok(YamlValue::Null)
    }
}

fn is_sequence_indicator(p: &Parser) -> bool {
    if parser_peek(p) != Some('-') {
        return false
    }
    // Check if followed by space or newline
    if p.pos + 1 < p.len {
        let next = p.input.char_at(p.pos + 1);
        next == ' ' || next == '\n' || next == '\r'
    } else {
        true
    }
}

fn parse_block_sequence(p: &!Parser, base_indent: usize) -> Result<YamlValue, YamlError> with Alloc {
    var items: Vec<YamlValue> = Vec::new();
    let seq_indent = p.col - 1;

    while !parser_eof(p) {
        let current_indent = count_indent(p);

        if current_indent < seq_indent {
            break
        }

        if parser_peek(p) != Some('-') || !is_sequence_indicator(p) {
            break
        }

        // Consume '-'
        parser_advance(p);
        skip_space(p);

        // Parse the item value
        let item = parse_value(p, current_indent + 2)?;
        items.push(item);

        skip_to_next_content(p);
    }

    Ok(YamlValue::Sequence(items))
}

fn parse_flow_sequence(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc {
    parser_advance(p);  // consume '['
    skip_whitespace_and_comments(p);

    var items: Vec<YamlValue> = Vec::new();

    while !parser_eof(p) {
        match parser_peek(p) {
            Some(']') => {
                parser_advance(p);
                return Ok(YamlValue::Sequence(items))
            },
            Some(',') => {
                parser_advance(p);
                skip_whitespace_and_comments(p);
            },
            _ => {
                let item = parse_flow_value(p)?;
                items.push(item);
                skip_whitespace_and_comments(p);
            }
        }
    }

    Err(YamlError::UnexpectedEof { context: "in flow sequence".to_string() })
}

fn parse_flow_mapping(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc {
    parser_advance(p);  // consume '{'
    skip_whitespace_and_comments(p);

    var entries: Vec<YamlEntry> = Vec::new();

    while !parser_eof(p) {
        match parser_peek(p) {
            Some('}') => {
                parser_advance(p);
                return Ok(YamlValue::Mapping(entries))
            },
            Some(',') => {
                parser_advance(p);
                skip_whitespace_and_comments(p);
            },
            _ => {
                let key = parse_flow_key(p)?;
                skip_whitespace_and_comments(p);

                // Expect ':'
                if parser_peek(p) != Some(':') {
                    return Err(YamlError::UnexpectedChar { line: p.line, col: p.col, ch: parser_peek(p).unwrap_or('\0') })
                }
                parser_advance(p);
                skip_whitespace_and_comments(p);

                let value = parse_flow_value(p)?;
                entries.push(YamlEntry { key: key, value: value });
                skip_whitespace_and_comments(p);
            }
        }
    }

    Err(YamlError::UnexpectedEof { context: "in flow mapping".to_string() })
}

fn parse_flow_value(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc {
    skip_whitespace_and_comments(p);

    match parser_peek(p) {
        Some('[') => parse_flow_sequence(p),
        Some('{') => parse_flow_mapping(p),
        Some('"') => parse_double_quoted_string(p).map(|s| YamlValue::String(s)),
        Some('\'') => parse_single_quoted_string(p).map(|s| YamlValue::String(s)),
        _ => parse_plain_scalar_flow(p)
    }
}

fn parse_flow_key(p: &!Parser) -> Result<string, YamlError> with Alloc {
    match parser_peek(p) {
        Some('"') => parse_double_quoted_string(p),
        Some('\'') => parse_single_quoted_string(p),
        _ => parse_plain_key_flow(p)
    }
}

fn parse_plain_key_flow(p: &!Parser) -> Result<string, YamlError> with Alloc {
    var result = String::new();

    while !parser_eof(p) {
        match parser_peek(p) {
            Some(':') | Some(',') | Some('}') | Some(']') | Some('\n') | Some('\r') => break,
            Some(ch) => {
                result.push(ch);
                parser_advance(p);
            },
            None => break
        }
    }

    Ok(result.trim().to_string())
}

fn parse_plain_scalar_flow(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc {
    var result = String::new();

    while !parser_eof(p) {
        match parser_peek(p) {
            Some(',') | Some('}') | Some(']') | Some('\n') | Some('\r') | Some(':') => break,
            Some(ch) => {
                result.push(ch);
                parser_advance(p);
            },
            None => break
        }
    }

    let trimmed = result.trim();
    Ok(parse_scalar_value(trimmed))
}

fn parse_block_mapping_or_scalar(p: &!Parser, base_indent: usize) -> Result<YamlValue, YamlError> with Alloc {
    // Look ahead to see if this is a mapping (has ':')
    let start_pos = p.pos;
    let start_line = p.line;
    let start_col = p.col;

    // Read until we find ':' or end of line
    var key_chars = String::new();
    var found_colon = false;

    while !parser_eof(p) {
        match parser_peek(p) {
            Some(':') => {
                // Check if followed by space or newline (valid mapping key)
                if p.pos + 1 < p.len {
                    let next = p.input.char_at(p.pos + 1);
                    if next == ' ' || next == '\n' || next == '\r' {
                        found_colon = true;
                        break
                    }
                } else {
                    found_colon = true;
                    break
                }
                key_chars.push(':');
                parser_advance(p);
            },
            Some('\n') | Some('\r') => break,
            Some(ch) => {
                key_chars.push(ch);
                parser_advance(p);
            },
            None => break
        }
    }

    if found_colon {
        // It's a mapping - reset and parse properly
        p.pos = start_pos;
        p.line = start_line;
        p.col = start_col;
        parse_block_mapping(p, base_indent)
    } else {
        // It's a scalar - reset and parse
        p.pos = start_pos;
        p.line = start_line;
        p.col = start_col;
        parse_plain_scalar_block(p)
    }
}

fn parse_block_mapping(p: &!Parser, base_indent: usize) -> Result<YamlValue, YamlError> with Alloc {
    var entries: Vec<YamlEntry> = Vec::new();
    let map_indent = p.col - 1;

    while !parser_eof(p) {
        let current_indent = count_indent(p);

        if current_indent < map_indent {
            break
        }

        // Parse key
        let key = parse_block_key(p)?;
        skip_space(p);

        // Expect ':'
        if parser_peek(p) != Some(':') {
            break
        }
        parser_advance(p);  // consume ':'
        skip_space(p);

        // Parse value
        let value = if parser_peek(p) == Some('\n') || parser_peek(p) == Some('\r') {
            // Value on next line
            skip_to_next_content(p);
            parse_value(p, current_indent + 2)?
        } else {
            // Value on same line
            parse_value(p, current_indent + 2)?
        };

        entries.push(YamlEntry { key: key, value: value });
        skip_to_next_content(p);
    }

    Ok(YamlValue::Mapping(entries))
}

fn parse_block_key(p: &!Parser) -> Result<string, YamlError> with Alloc {
    match parser_peek(p) {
        Some('"') => parse_double_quoted_string(p),
        Some('\'') => parse_single_quoted_string(p),
        _ => {
            var result = String::new();
            while !parser_eof(p) {
                match parser_peek(p) {
                    Some(':') => break,
                    Some('\n') | Some('\r') => break,
                    Some(ch) => {
                        result.push(ch);
                        parser_advance(p);
                    },
                    None => break
                }
            }
            Ok(result.trim().to_string())
        }
    }
}

fn parse_plain_scalar_block(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc {
    var result = String::new();

    while !parser_eof(p) {
        match parser_peek(p) {
            Some('\n') | Some('\r') => break,
            Some(ch) => {
                result.push(ch);
                parser_advance(p);
            },
            None => break
        }
    }

    let trimmed = result.trim();
    Ok(parse_scalar_value(trimmed))
}

fn parse_scalar_value(s: &str) -> YamlValue {
    // Null
    if s == "" || s == "null" || s == "Null" || s == "NULL" || s == "~" {
        return YamlValue::Null
    }

    // Boolean
    if s == "true" || s == "True" || s == "TRUE" || s == "yes" || s == "Yes" || s == "YES" || s == "on" || s == "On" || s == "ON" {
        return YamlValue::Bool(true)
    }
    if s == "false" || s == "False" || s == "FALSE" || s == "no" || s == "No" || s == "NO" || s == "off" || s == "Off" || s == "OFF" {
        return YamlValue::Bool(false)
    }

    // Integer (decimal, hex, octal)
    if let Some(i) = try_parse_int(s) {
        return YamlValue::Int(i)
    }

    // Float
    if let Some(f) = try_parse_float(s) {
        return YamlValue::Float(f)
    }

    // String
    YamlValue::String(s.to_string())
}

fn try_parse_int(s: &str) -> Option<i64> {
    if s.len() == 0 {
        return None
    }

    // Handle sign
    var start: usize = 0;
    var negative = false;
    if s.char_at(0) == '-' {
        negative = true;
        start = 1;
    } else if s.char_at(0) == '+' {
        start = 1;
    }

    if start >= s.len() {
        return None
    }

    // Hex
    if s.len() > start + 2 && s.char_at(start) == '0' && (s.char_at(start + 1) == 'x' || s.char_at(start + 1) == 'X') {
        return parse_hex_int(&s[start + 2..], negative)
    }

    // Octal
    if s.len() > start + 2 && s.char_at(start) == '0' && (s.char_at(start + 1) == 'o' || s.char_at(start + 1) == 'O') {
        return parse_octal_int(&s[start + 2..], negative)
    }

    // Decimal
    parse_decimal_int(&s[start..], negative)
}

fn parse_decimal_int(s: &str, negative: bool) -> Option<i64> {
    var result: i64 = 0;
    var i: usize = 0;

    while i < s.len() {
        let ch = s.char_at(i);
        if ch >= '0' && ch <= '9' {
            result = result * 10 + (ch as i64 - '0' as i64);
        } else if ch == '_' {
            // Ignore underscores (numeric separators)
        } else {
            return None
        }
        i = i + 1;
    }

    if negative {
        Some(-result)
    } else {
        Some(result)
    }
}

fn parse_hex_int(s: &str, negative: bool) -> Option<i64> {
    var result: i64 = 0;
    var i: usize = 0;

    while i < s.len() {
        let ch = s.char_at(i);
        if ch >= '0' && ch <= '9' {
            result = result * 16 + (ch as i64 - '0' as i64);
        } else if ch >= 'a' && ch <= 'f' {
            result = result * 16 + (ch as i64 - 'a' as i64 + 10);
        } else if ch >= 'A' && ch <= 'F' {
            result = result * 16 + (ch as i64 - 'A' as i64 + 10);
        } else if ch == '_' {
            // Ignore
        } else {
            return None
        }
        i = i + 1;
    }

    if negative {
        Some(-result)
    } else {
        Some(result)
    }
}

fn parse_octal_int(s: &str, negative: bool) -> Option<i64> {
    var result: i64 = 0;
    var i: usize = 0;

    while i < s.len() {
        let ch = s.char_at(i);
        if ch >= '0' && ch <= '7' {
            result = result * 8 + (ch as i64 - '0' as i64);
        } else if ch == '_' {
            // Ignore
        } else {
            return None
        }
        i = i + 1;
    }

    if negative {
        Some(-result)
    } else {
        Some(result)
    }
}

fn try_parse_float(s: &str) -> Option<f64> {
    // Special values
    if s == ".inf" || s == ".Inf" || s == ".INF" {
        return Some(f64::INFINITY)
    }
    if s == "-.inf" || s == "-.Inf" || s == "-.INF" {
        return Some(f64::NEG_INFINITY)
    }
    if s == ".nan" || s == ".NaN" || s == ".NAN" {
        return Some(f64::NAN)
    }

    // Try standard float parsing
    s.parse_f64().ok()
}

fn parse_double_quoted_string(p: &!Parser) -> Result<string, YamlError> with Alloc {
    parser_advance(p);  // consume opening '"'
    var result = String::new();

    while !parser_eof(p) {
        match parser_peek(p) {
            Some('"') => {
                parser_advance(p);
                return Ok(result)
            },
            Some('\\') => {
                parser_advance(p);
                match parser_peek(p) {
                    Some('n') => { result.push('\n'); parser_advance(p); },
                    Some('r') => { result.push('\r'); parser_advance(p); },
                    Some('t') => { result.push('\t'); parser_advance(p); },
                    Some('\\') => { result.push('\\'); parser_advance(p); },
                    Some('"') => { result.push('"'); parser_advance(p); },
                    Some('/') => { result.push('/'); parser_advance(p); },
                    Some('0') => { result.push('\0'); parser_advance(p); },
                    Some(_) => return Err(YamlError::InvalidEscape { line: p.line, col: p.col }),
                    None => return Err(YamlError::UnexpectedEof { context: "in escape sequence".to_string() })
                }
            },
            Some(ch) => {
                result.push(ch);
                parser_advance(p);
            },
            None => return Err(YamlError::UnexpectedEof { context: "in double-quoted string".to_string() })
        }
    }

    Err(YamlError::UnexpectedEof { context: "in double-quoted string".to_string() })
}

fn parse_single_quoted_string(p: &!Parser) -> Result<string, YamlError> with Alloc {
    parser_advance(p);  // consume opening '\''
    var result = String::new();

    while !parser_eof(p) {
        match parser_peek(p) {
            Some('\'') => {
                parser_advance(p);
                // Check for escaped quote ('')
                if parser_peek(p) == Some('\'') {
                    result.push('\'');
                    parser_advance(p);
                } else {
                    return Ok(result)
                }
            },
            Some(ch) => {
                result.push(ch);
                parser_advance(p);
            },
            None => return Err(YamlError::UnexpectedEof { context: "in single-quoted string".to_string() })
        }
    }

    Err(YamlError::UnexpectedEof { context: "in single-quoted string".to_string() })
}

fn parse_block_scalar(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc {
    let indicator = parser_advance(p).unwrap();  // '|' or '>'
    let literal = indicator == '|';

    // Skip to end of line
    while !parser_eof(p) && parser_peek(p) != Some('\n') && parser_peek(p) != Some('\r') {
        parser_advance(p);
    }
    skip_newline(p);

    // Determine indentation of content
    let content_indent = count_indent(p);
    if content_indent == 0 {
        return Ok(YamlValue::String("".to_string()))
    }

    var result = String::new();
    var first_line = true;

    while !parser_eof(p) {
        let line_indent = count_indent(p);

        if line_indent < content_indent && !is_blank_line(p) {
            break
        }

        // Skip indentation
        var i: usize = 0;
        while i < content_indent && !parser_eof(p) && parser_peek(p) == Some(' ') {
            parser_advance(p);
            i = i + 1;
        }

        // Read line content
        if !first_line {
            if literal {
                result.push('\n');
            } else {
                result.push(' ');
            }
        }
        first_line = false;

        while !parser_eof(p) && parser_peek(p) != Some('\n') && parser_peek(p) != Some('\r') {
            result.push(parser_advance(p).unwrap());
        }
        skip_newline(p);
    }

    Ok(YamlValue::String(result))
}

// =============================================================================
// Helper Functions
// =============================================================================

fn skip_space(p: &!Parser) {
    while !parser_eof(p) {
        match parser_peek(p) {
            Some(' ') | Some('\t') => { parser_advance(p); },
            _ => break
        }
    }
}

fn skip_newline(p: &!Parser) {
    if parser_peek(p) == Some('\r') {
        parser_advance(p);
    }
    if parser_peek(p) == Some('\n') {
        parser_advance(p);
    }
}

fn skip_whitespace_and_comments(p: &!Parser) {
    while !parser_eof(p) {
        match parser_peek(p) {
            Some(' ') | Some('\t') | Some('\n') | Some('\r') => {
                parser_advance(p);
            },
            Some('#') => {
                // Skip comment to end of line
                while !parser_eof(p) && parser_peek(p) != Some('\n') && parser_peek(p) != Some('\r') {
                    parser_advance(p);
                }
            },
            _ => break
        }
    }
}

fn skip_to_next_content(p: &!Parser) {
    // Skip to end of line
    while !parser_eof(p) && parser_peek(p) != Some('\n') && parser_peek(p) != Some('\r') {
        if parser_peek(p) == Some('#') {
            // Comment - skip rest of line
            break
        }
        parser_advance(p);
    }
    skip_newline(p);
    skip_whitespace_and_comments(p);
}

fn count_indent(p: &Parser) -> usize {
    var count: usize = 0;
    var pos = p.pos;

    while pos < p.len {
        let ch = p.input.char_at(pos);
        if ch == ' ' {
            count = count + 1;
            pos = pos + 1;
        } else {
            break
        }
    }

    count
}

fn is_blank_line(p: &Parser) -> bool {
    var pos = p.pos;
    while pos < p.len {
        let ch = p.input.char_at(pos);
        if ch == '\n' || ch == '\r' {
            return true
        }
        if ch != ' ' && ch != '\t' {
            return false
        }
        pos = pos + 1;
    }
    true
}

// =============================================================================
// Serialization
// =============================================================================

/// Converts a YamlValue to a YAML string.
pub fn yaml_to_string(value: &YamlValue) -> string with Alloc {
    yaml_to_string_indent(value, 0)
}

fn yaml_to_string_indent(value: &YamlValue, indent: usize) -> string with Alloc {
    match value {
        YamlValue::Null => "null".to_string(),
        YamlValue::Bool(b) => if *b { "true".to_string() } else { "false".to_string() },
        YamlValue::Int(i) => i.to_string(),
        YamlValue::Float(f) => {
            if f.is_nan() {
                ".nan".to_string()
            } else if f.is_infinite() {
                if *f > 0.0 { ".inf".to_string() } else { "-.inf".to_string() }
            } else {
                f.to_string()
            }
        },
        YamlValue::String(s) => escape_yaml_string(s),
        YamlValue::Sequence(items) => {
            if items.len() == 0 {
                return "[]".to_string()
            }

            var result = String::new();
            let item_indent = indent + 2;
            let spaces = " ".repeat(indent);

            var first = true;
            for item in items {
                if !first {
                    result.push('\n');
                }
                first = false;

                result.push_str(&spaces);
                result.push_str("- ");

                let item_str = yaml_to_string_indent(item, item_indent);
                // For nested collections, put on next line
                match item {
                    YamlValue::Sequence(_) | YamlValue::Mapping(_) => {
                        result.push('\n');
                        result.push_str(&item_str);
                    },
                    _ => {
                        result.push_str(&item_str);
                    }
                }
            }

            result
        },
        YamlValue::Mapping(entries) => {
            if entries.len() == 0 {
                return "{}".to_string()
            }

            var result = String::new();
            let spaces = " ".repeat(indent);

            var first = true;
            for entry in entries {
                if !first {
                    result.push('\n');
                }
                first = false;

                result.push_str(&spaces);
                result.push_str(&escape_yaml_key(&entry.key));
                result.push(':');

                let value_str = yaml_to_string_indent(&entry.value, indent + 2);
                match &entry.value {
                    YamlValue::Sequence(_) | YamlValue::Mapping(_) => {
                        result.push('\n');
                        result.push_str(&value_str);
                    },
                    _ => {
                        result.push(' ');
                        result.push_str(&value_str);
                    }
                }
            }

            result
        }
    }
}

fn escape_yaml_string(s: &str) -> string with Alloc {
    // Check if string needs quoting
    let needs_quote = s.len() == 0 ||
        s.contains(':') || s.contains('#') ||
        s.contains('\n') || s.contains('\r') ||
        s.starts_with(' ') || s.ends_with(' ') ||
        s.starts_with('-') || s.starts_with('[') || s.starts_with('{') ||
        s == "true" || s == "false" || s == "null" ||
        s == "yes" || s == "no" || s == "on" || s == "off";

    if !needs_quote {
        return s.to_string()
    }

    var result = String::new();
    result.push('"');

    for ch in s.chars() {
        match ch {
            '"' => result.push_str("\\\""),
            '\\' => result.push_str("\\\\"),
            '\n' => result.push_str("\\n"),
            '\r' => result.push_str("\\r"),
            '\t' => result.push_str("\\t"),
            _ => result.push(ch)
        }
    }

    result.push('"');
    result
}

fn escape_yaml_key(s: &str) -> string with Alloc {
    // Keys with special chars need quoting
    if s.contains(':') || s.contains(' ') || s.contains('#') {
        var result = String::new();
        result.push('"');
        result.push_str(s);
        result.push('"');
        result
    } else {
        s.to_string()
    }
}

// =============================================================================
// Value Access Functions
// =============================================================================

/// Gets a value from a mapping by key
pub fn yaml_get<'a>(value: &'a YamlValue, key: &str) -> Option<&'a YamlValue> {
    match value {
        YamlValue::Mapping(entries) => {
            for entry in entries {
                if entry.key == key {
                    return Some(&entry.value)
                }
            }
            None
        },
        _ => None
    }
}

/// Gets a value from a sequence by index
pub fn yaml_at<'a>(value: &'a YamlValue, index: usize) -> Option<&'a YamlValue> {
    match value {
        YamlValue::Sequence(items) => {
            if index < items.len() {
                Some(&items[index])
            } else {
                None
            }
        },
        _ => None
    }
}

/// Returns true if the value is null
pub fn yaml_is_null(value: &YamlValue) -> bool {
    match value {
        YamlValue::Null => true,
        _ => false
    }
}

/// Returns the boolean value if it is a Bool
pub fn yaml_as_bool(value: &YamlValue) -> Option<bool> {
    match value {
        YamlValue::Bool(b) => Some(*b),
        _ => None
    }
}

/// Returns the integer value if it is an Int
pub fn yaml_as_i64(value: &YamlValue) -> Option<i64> {
    match value {
        YamlValue::Int(i) => Some(*i),
        _ => None
    }
}

/// Returns the float value if it is a Float
pub fn yaml_as_f64(value: &YamlValue) -> Option<f64> {
    match value {
        YamlValue::Float(f) => Some(*f),
        YamlValue::Int(i) => Some(*i as f64),
        _ => None
    }
}

/// Returns the string value if it is a String
pub fn yaml_as_str<'a>(value: &'a YamlValue) -> Option<&'a str> {
    match value {
        YamlValue::String(s) => Some(s),
        _ => None
    }
}

/// Returns the sequence if it is a Sequence
pub fn yaml_as_sequence<'a>(value: &'a YamlValue) -> Option<&'a Vec<YamlValue>> {
    match value {
        YamlValue::Sequence(s) => Some(s),
        _ => None
    }
}

/// Returns the mapping if it is a Mapping
pub fn yaml_as_mapping<'a>(value: &'a YamlValue) -> Option<&'a Vec<YamlEntry>> {
    match value {
        YamlValue::Mapping(m) => Some(m),
        _ => None
    }
}

/// Returns the number of elements in a sequence or mapping
pub fn yaml_len(value: &YamlValue) -> usize {
    match value {
        YamlValue::Sequence(s) => s.len(),
        YamlValue::Mapping(m) => m.len(),
        _ => 0
    }
}

/// Returns the keys of a mapping
pub fn yaml_keys(value: &YamlValue) -> Vec<string> with Alloc {
    match value {
        YamlValue::Mapping(entries) => {
            var keys: Vec<string> = Vec::with_capacity(entries.len());
            for entry in entries {
                keys.push(entry.key.clone());
            }
            keys
        },
        _ => Vec::new()
    }
}
