//! stdlib/yaml/mod.sio - YAML Parser and Emitter
//!
//! This module provides parsing and serialization of YAML 1.2 (Core schema).
//! Supports a common subset suitable for configuration files and data exchange.
//!
//! # Supported Features
//! - Scalars: strings, integers, floats, booleans, null
//! - Sequences (arrays)
//! - Mappings (objects)
//! - Flow and block styles
//! - Comments (ignored during parsing)
//! - Multi-line strings (literal |, folded >)
//!
//! # Not Supported
//! - Anchors and aliases (&, *)
//! - Tags (!tag)
//! - Multiple documents (---)

// =============================================================================
// Tag Constants for YamlValue
// =============================================================================

const TAG_NULL: i32 = 0
const TAG_BOOL: i32 = 1
const TAG_INT: i32 = 2
const TAG_FLOAT: i32 = 3
const TAG_STRING: i32 = 4
const TAG_SEQUENCE: i32 = 5
const TAG_MAPPING: i32 = 6

// Tag constants for YamlError
const ERR_UNEXPECTED_CHAR: i32 = 0
const ERR_UNEXPECTED_EOF: i32 = 1
const ERR_INVALID_INDENT: i32 = 2
const ERR_INVALID_ESCAPE: i32 = 3
const ERR_DUPLICATE_KEY: i32 = 4
const ERR_INVALID_NUMBER: i32 = 5
const ERR_TAB_INDENT: i32 = 6
const ERR_UNSUPPORTED: i32 = 7

// =============================================================================
// YAML Value Types (Tag-based struct)
// =============================================================================

// Represents a YAML value using a tag-based struct approach
pub struct YamlValue {
    pub tag: i32,
    pub bool_val: bool,
    pub int_val: i64,
    pub float_val: f64,
    pub string_val: string,
    pub seq_val: Vec<YamlValue>,
    pub map_val: Vec<YamlEntry>
}

// A key-value entry in a mapping
pub struct YamlEntry {
    pub key: string,
    pub value: YamlValue
}

// Parse errors (tag-based struct)
pub struct YamlError {
    pub tag: i32,
    pub line: usize,
    pub col: usize,
    pub ch: char,
    pub context: string,
    pub expected: usize,
    pub found: usize,
    pub key: string,
    pub text: string,
    pub feature: string
}

// =============================================================================
// Value Constructors
// =============================================================================

pub fn yaml_null() -> YamlValue with Alloc {
    YamlValue {
        tag: TAG_NULL,
        bool_val: false,
        int_val: 0,
        float_val: 0.0,
        string_val: "",
        seq_val: vec![],
        map_val: vec![]
    }
}

pub fn yaml_bool(b: bool) -> YamlValue with Alloc {
    YamlValue {
        tag: TAG_BOOL,
        bool_val: b,
        int_val: 0,
        float_val: 0.0,
        string_val: "",
        seq_val: vec![],
        map_val: vec![]
    }
}

pub fn yaml_int(i: i64) -> YamlValue with Alloc {
    YamlValue {
        tag: TAG_INT,
        bool_val: false,
        int_val: i,
        float_val: 0.0,
        string_val: "",
        seq_val: vec![],
        map_val: vec![]
    }
}

pub fn yaml_float(f: f64) -> YamlValue with Alloc {
    YamlValue {
        tag: TAG_FLOAT,
        bool_val: false,
        int_val: 0,
        float_val: f,
        string_val: "",
        seq_val: vec![],
        map_val: vec![]
    }
}

pub fn yaml_string(s: string) -> YamlValue with Alloc {
    YamlValue {
        tag: TAG_STRING,
        bool_val: false,
        int_val: 0,
        float_val: 0.0,
        string_val: s,
        seq_val: vec![],
        map_val: vec![]
    }
}

pub fn yaml_sequence(items: Vec<YamlValue>) -> YamlValue with Alloc {
    YamlValue {
        tag: TAG_SEQUENCE,
        bool_val: false,
        int_val: 0,
        float_val: 0.0,
        string_val: "",
        seq_val: items,
        map_val: vec![]
    }
}

pub fn yaml_mapping(entries: Vec<YamlEntry>) -> YamlValue with Alloc {
    YamlValue {
        tag: TAG_MAPPING,
        bool_val: false,
        int_val: 0,
        float_val: 0.0,
        string_val: "",
        seq_val: vec![],
        map_val: entries
    }
}

// =============================================================================
// Error Constructors
// =============================================================================

fn error_unexpected_char(line: usize, col: usize, ch: char) -> YamlError {
    YamlError {
        tag: ERR_UNEXPECTED_CHAR,
        line: line,
        col: col,
        ch: ch,
        context: "",
        expected: 0,
        found: 0,
        key: "",
        text: "",
        feature: ""
    }
}

fn error_unexpected_eof(context: string) -> YamlError {
    YamlError {
        tag: ERR_UNEXPECTED_EOF,
        line: 0,
        col: 0,
        ch: '\0',
        context: context,
        expected: 0,
        found: 0,
        key: "",
        text: "",
        feature: ""
    }
}

fn error_invalid_escape(line: usize, col: usize) -> YamlError {
    YamlError {
        tag: ERR_INVALID_ESCAPE,
        line: line,
        col: col,
        ch: '\0',
        context: "",
        expected: 0,
        found: 0,
        key: "",
        text: "",
        feature: ""
    }
}

fn error_unsupported(feature: string, line: usize) -> YamlError {
    YamlError {
        tag: ERR_UNSUPPORTED,
        line: line,
        col: 0,
        ch: '\0',
        context: "",
        expected: 0,
        found: 0,
        key: "",
        text: "",
        feature: feature
    }
}

// Returns an error message for the error
pub fn yaml_error_message(err: &YamlError) -> string {
    if err.tag == ERR_UNEXPECTED_CHAR {
        "Unexpected character '" ++ err.ch.to_string() ++ "' at line " ++ err.line.to_string() ++ ", col " ++ err.col.to_string()
    } else if err.tag == ERR_UNEXPECTED_EOF {
        "Unexpected end of input " ++ err.context
    } else if err.tag == ERR_INVALID_INDENT {
        "Invalid indentation at line " ++ err.line.to_string() ++ ": expected " ++ err.expected.to_string() ++ ", found " ++ err.found.to_string()
    } else if err.tag == ERR_INVALID_ESCAPE {
        "Invalid escape sequence at line " ++ err.line.to_string() ++ ", col " ++ err.col.to_string()
    } else if err.tag == ERR_DUPLICATE_KEY {
        "Duplicate key '" ++ err.key ++ "' at line " ++ err.line.to_string()
    } else if err.tag == ERR_INVALID_NUMBER {
        "Invalid number '" ++ err.text ++ "' at line " ++ err.line.to_string()
    } else if err.tag == ERR_TAB_INDENT {
        "Tab used for indentation at line " ++ err.line.to_string() ++ " (use spaces)"
    } else if err.tag == ERR_UNSUPPORTED {
        "Unsupported feature '" ++ err.feature ++ "' at line " ++ err.line.to_string()
    } else {
        "Unknown error"
    }
}

// =============================================================================
// Parser State
// =============================================================================

struct Parser {
    input: string,
    pos: usize,
    line: usize,
    col: usize,
    len: usize
}

fn parser_new(input: &str) -> Parser {
    Parser {
        input: input.to_string(),
        pos: 0,
        line: 1,
        col: 1,
        len: input.len()
    }
}

fn parser_peek(p: &Parser) -> Option<char> with Panic {
    if p.pos >= p.len {
        return None
    }
    return Some(p.input.char_at(p.pos))
}

fn parser_advance(p: &!Parser) -> Option<char> with Mut {
    if p.pos >= p.len {
        return None
    }
    let ch = p.input.char_at(p.pos);
    p.pos = p.pos + 1;
    if ch == '\n' {
        p.line = p.line + 1;
        p.col = 1;
    } else {
        p.col = p.col + 1;
    }
    return Some(ch)
}

fn parser_eof(p: &Parser) -> bool {
    p.pos >= p.len
}

fn parser_peek_is(p: &Parser, c: char) -> bool with Panic {
    let opt = parser_peek(p);
    if opt.is_some() {
        opt.unwrap() == c
    } else {
        false
    }
}

fn parser_peek_is_newline(p: &Parser) -> bool with Panic {
    let opt = parser_peek(p);
    if opt.is_some() {
        let ch = opt.unwrap();
        ch == '\n' || ch == '\r'
    } else {
        false
    }
}

// =============================================================================
// Parsing Functions
// =============================================================================

pub fn parse_yaml(input: &str) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    var p = parser_new(input);
    skip_whitespace_and_comments(&!p);

    if parser_eof(&p) {
        return Ok(yaml_null())
    }

    parse_value(&!p, 0)
}

fn parse_value(p: &!Parser, indent: usize) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    skip_whitespace_and_comments(p);

    if parser_eof(p) {
        return Ok(yaml_null())
    }

    let opt = parser_peek(p);
    if opt.is_none() {
        return Ok(yaml_null())
    }

    let ch = opt.unwrap();
    if ch == '-' && is_sequence_indicator(p) {
        parse_block_sequence(p, indent)
    } else if ch == '[' {
        parse_flow_sequence(p)
    } else if ch == '{' {
        parse_flow_mapping(p)
    } else if ch == '"' {
        let str_result = parse_double_quoted_string(p);
        if str_result.is_ok() {
            Ok(yaml_string(str_result.unwrap()))
        } else {
            Err(str_result.unwrap_err())
        }
    } else if ch == '\'' {
        let str_result = parse_single_quoted_string(p);
        if str_result.is_ok() {
            Ok(yaml_string(str_result.unwrap()))
        } else {
            Err(str_result.unwrap_err())
        }
    } else if ch == '|' || ch == '>' {
        parse_block_scalar(p)
    } else if ch == '&' || ch == '*' {
        Err(error_unsupported("anchors/aliases".to_string(), p.line))
    } else if ch == '!' {
        Err(error_unsupported("tags".to_string(), p.line))
    } else {
        parse_block_mapping_or_scalar(p, indent)
    }
}

fn is_sequence_indicator(p: &Parser) -> bool with Panic {
    if !parser_peek_is(p, '-') {
        return false
    }
    if p.pos + 1 < p.len {
        let next = p.input.char_at(p.pos + 1);
        next == ' ' || next == '\n' || next == '\r'
    } else {
        true
    }
}

fn parse_block_sequence(p: &!Parser, base_indent: usize) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    var items: Vec<YamlValue> = vec![];
    let seq_indent = p.col - 1;

    while !parser_eof(p) {
        let current_indent = count_indent(p);

        if current_indent < seq_indent {
            break
        }

        if !parser_peek_is(p, '-') || !is_sequence_indicator(p) {
            break
        }

        parser_advance(p);
        skip_space(p);

        let item = parse_value(p, current_indent + 2)?;
        items.push(item);

        skip_to_next_content(p);
    }

    Ok(yaml_sequence(items))
}

fn parse_flow_sequence(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    parser_advance(p);
    skip_whitespace_and_comments(p);

    var items: Vec<YamlValue> = vec![];

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == ']' {
            parser_advance(p);
            return Ok(yaml_sequence(items))
        } else if ch == ',' {
            parser_advance(p);
            skip_whitespace_and_comments(p);
        } else {
            let item = parse_flow_value(p)?;
            items.push(item);
            skip_whitespace_and_comments(p);
        }
    }

    Err(error_unexpected_eof("in flow sequence".to_string()))
}

fn parse_flow_mapping(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    parser_advance(p);
    skip_whitespace_and_comments(p);

    var entries: Vec<YamlEntry> = vec![];

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == '}' {
            parser_advance(p);
            return Ok(yaml_mapping(entries))
        } else if ch == ',' {
            parser_advance(p);
            skip_whitespace_and_comments(p);
        } else {
            let key = parse_flow_key(p)?;
            skip_whitespace_and_comments(p);

            if !parser_peek_is(p, ':') {
                let err_opt = parser_peek(p);
                let err_ch = if err_opt.is_some() { err_opt.unwrap() } else { '\0' };
                return Err(error_unexpected_char(p.line, p.col, err_ch))
            }
            parser_advance(p);
            skip_whitespace_and_comments(p);

            let value = parse_flow_value(p)?;
            entries.push(YamlEntry { key: key, value: value });
            skip_whitespace_and_comments(p);
        }
    }

    Err(error_unexpected_eof("in flow mapping".to_string()))
}

fn parse_flow_value(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    skip_whitespace_and_comments(p);

    let opt = parser_peek(p);
    if opt.is_none() {
        return parse_plain_scalar_flow(p)
    }

    let ch = opt.unwrap();
    if ch == '[' {
        parse_flow_sequence(p)
    } else if ch == '{' {
        parse_flow_mapping(p)
    } else if ch == '"' {
        let str_result = parse_double_quoted_string(p);
        if str_result.is_ok() {
            Ok(yaml_string(str_result.unwrap()))
        } else {
            Err(str_result.unwrap_err())
        }
    } else if ch == '\'' {
        let str_result = parse_single_quoted_string(p);
        if str_result.is_ok() {
            Ok(yaml_string(str_result.unwrap()))
        } else {
            Err(str_result.unwrap_err())
        }
    } else {
        parse_plain_scalar_flow(p)
    }
}

fn parse_flow_key(p: &!Parser) -> Result<string, YamlError> with Alloc, Mut, Panic, Div {
    let opt = parser_peek(p);
    if opt.is_none() {
        return parse_plain_key_flow(p)
    }

    let ch = opt.unwrap();
    if ch == '"' {
        parse_double_quoted_string(p)
    } else if ch == '\'' {
        parse_single_quoted_string(p)
    } else {
        parse_plain_key_flow(p)
    }
}

fn parse_plain_key_flow(p: &!Parser) -> Result<string, YamlError> with Alloc, Mut, Panic, Div {
    var result = "";

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == ':' || ch == ',' || ch == '}' || ch == ']' || ch == '\n' || ch == '\r' {
            break
        }
        result = result ++ ch.to_string();
        parser_advance(p);
    }

    Ok(result.trim().to_string())
}

fn parse_plain_scalar_flow(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    var result = "";

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == ',' || ch == '}' || ch == ']' || ch == '\n' || ch == '\r' || ch == ':' {
            break
        }
        result = result ++ ch.to_string();
        parser_advance(p);
    }

    let trimmed = result.trim();
    Ok(parse_scalar_value(trimmed))
}

fn parse_block_mapping_or_scalar(p: &!Parser, base_indent: usize) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    let start_pos = p.pos;
    let start_line = p.line;
    let start_col = p.col;

    var found_colon = false;

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == ':' {
            if p.pos + 1 < p.len {
                let next = p.input.char_at(p.pos + 1);
                if next == ' ' || next == '\n' || next == '\r' {
                    found_colon = true;
                    break
                }
            } else {
                found_colon = true;
                break
            }
            parser_advance(p);
        } else if ch == '\n' || ch == '\r' {
            break
        } else {
            parser_advance(p);
        }
    }

    p.pos = start_pos;
    p.line = start_line;
    p.col = start_col;

    if found_colon {
        parse_block_mapping(p, base_indent)
    } else {
        parse_plain_scalar_block(p)
    }
}

fn parse_block_mapping(p: &!Parser, base_indent: usize) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    var entries: Vec<YamlEntry> = vec![];
    let map_indent = p.col - 1;

    while !parser_eof(p) {
        let current_indent = count_indent(p);

        if current_indent < map_indent {
            break
        }

        let key = parse_block_key(p)?;
        skip_space(p);

        if !parser_peek_is(p, ':') {
            break
        }
        parser_advance(p);
        skip_space(p);

        let value = if parser_peek_is_newline(p) {
            skip_to_next_content(p);
            parse_value(p, current_indent + 2)?
        } else {
            parse_value(p, current_indent + 2)?
        };

        entries.push(YamlEntry { key: key, value: value });
        skip_to_next_content(p);
    }

    Ok(yaml_mapping(entries))
}

fn parse_block_key(p: &!Parser) -> Result<string, YamlError> with Alloc, Mut, Panic, Div {
    let opt = parser_peek(p);
    if opt.is_none() {
        return Ok("".to_string())
    }

    let ch = opt.unwrap();
    if ch == '"' {
        parse_double_quoted_string(p)
    } else if ch == '\'' {
        parse_single_quoted_string(p)
    } else {
        var result = "";
        while !parser_eof(p) {
            let inner_opt = parser_peek(p);
            if inner_opt.is_none() {
                break
            }
            let c = inner_opt.unwrap();
            if c == ':' || c == '\n' || c == '\r' {
                break
            }
            result = result ++ c.to_string();
            parser_advance(p);
        }
        Ok(result.trim().to_string())
    }
}

fn parse_plain_scalar_block(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc, Mut, Panic, Div {
    var result = "";

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == '\n' || ch == '\r' {
            break
        }
        result = result ++ ch.to_string();
        parser_advance(p);
    }

    let trimmed = result.trim();
    Ok(parse_scalar_value(trimmed))
}

fn parse_scalar_value(s: &str) -> YamlValue with Alloc, Mut, Panic, Div {
    if s == "" || s == "null" || s == "Null" || s == "NULL" || s == "~" {
        return yaml_null()
    }

    if s == "true" || s == "True" || s == "TRUE" || s == "yes" || s == "Yes" || s == "YES" || s == "on" || s == "On" || s == "ON" {
        return yaml_bool(true)
    }
    if s == "false" || s == "False" || s == "FALSE" || s == "no" || s == "No" || s == "NO" || s == "off" || s == "Off" || s == "OFF" {
        return yaml_bool(false)
    }

    let int_opt = try_parse_int(s);
    if int_opt.is_some() {
        return yaml_int(int_opt.unwrap())
    }

    let float_opt = try_parse_float(s);
    if float_opt.is_some() {
        return yaml_float(float_opt.unwrap())
    }

    yaml_string(s.to_string())
}

fn try_parse_int(s: &str) -> Option<i64> with Mut, Panic, Div {
    if s.len() == 0 {
        return None
    }

    var start: usize = 0;
    var negative = false;
    if s.char_at(0) == '-' {
        negative = true;
        start = 1;
    } else if s.char_at(0) == '+' {
        start = 1;
    }

    if start >= s.len() {
        return None
    }

    parse_decimal_int(&s[start..], negative)
}

fn parse_decimal_int(s: &str, negative: bool) -> Option<i64> with Mut, Div {
    var result: i64 = 0;
    var i: usize = 0;

    while i < s.len() {
        let ch = s.char_at(i);
        if ch >= '0' && ch <= '9' {
            result = result * 10 + (ch as i64 - '0' as i64);
        } else if ch == '_' {
            // Ignore underscores
        } else {
            return None
        }
        i = i + 1;
    }

    if negative {
        return Some(-result)
    }
    return Some(result)
}

fn try_parse_float(s: &str) -> Option<f64> with Panic {
    if s == ".inf" || s == ".Inf" || s == ".INF" {
        return Some(1.0 / 0.0)
    }
    if s == "-.inf" || s == "-.Inf" || s == "-.INF" {
        return Some(-1.0 / 0.0)
    }
    if s == ".nan" || s == ".NaN" || s == ".NAN" {
        return Some(0.0 / 0.0)
    }

    s.parse_f64().ok()
}

fn parse_double_quoted_string(p: &!Parser) -> Result<string, YamlError> with Alloc, Mut, Div, Panic {
    parser_advance(p);
    var result = "";

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            return Err(error_unexpected_eof("in double-quoted string".to_string()))
        }
        let ch = opt.unwrap();
        if ch == '"' {
            parser_advance(p);
            return Ok(result)
        } else if ch == '\\' {
            parser_advance(p);
            let esc_opt = parser_peek(p);
            if esc_opt.is_none() {
                return Err(error_unexpected_eof("in escape sequence".to_string()))
            }
            let esc = esc_opt.unwrap();
            if esc == 'n' { result = result ++ "\n"; parser_advance(p); }
            else if esc == 'r' { result = result ++ "\r"; parser_advance(p); }
            else if esc == 't' { result = result ++ "\t"; parser_advance(p); }
            else if esc == '\\' { result = result ++ "\\"; parser_advance(p); }
            else if esc == '"' { result = result ++ "\""; parser_advance(p); }
            else if esc == '/' { result = result ++ "/"; parser_advance(p); }
            else { return Err(error_invalid_escape(p.line, p.col)) }
        } else {
            result = result ++ ch.to_string();
            parser_advance(p);
        }
    }

    Err(error_unexpected_eof("in double-quoted string".to_string()))
}

fn parse_single_quoted_string(p: &!Parser) -> Result<string, YamlError> with Alloc, Mut, Div, Panic {
    parser_advance(p);
    var result = "";

    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            return Err(error_unexpected_eof("in single-quoted string".to_string()))
        }
        let ch = opt.unwrap();
        if ch == '\'' {
            parser_advance(p);
            if parser_peek_is(p, '\'') {
                result = result ++ "'";
                parser_advance(p);
            } else {
                return Ok(result)
            }
        } else {
            result = result ++ ch.to_string();
            parser_advance(p);
        }
    }

    Err(error_unexpected_eof("in single-quoted string".to_string()))
}

fn parse_block_scalar(p: &!Parser) -> Result<YamlValue, YamlError> with Alloc, Mut, Div, Panic {
    let indicator_opt = parser_advance(p);
    let indicator = indicator_opt.unwrap();
    let literal = indicator == '|';

    while !parser_eof(p) && !parser_peek_is_newline(p) {
        parser_advance(p);
    }
    skip_newline(p);

    let content_indent = count_indent(p);
    if content_indent == 0 {
        return Ok(yaml_string("".to_string()))
    }

    var result = "";
    var first_line = true;

    while !parser_eof(p) {
        let line_indent = count_indent(p);

        if line_indent < content_indent && !is_blank_line(p) {
            break
        }

        var i: usize = 0;
        while i < content_indent && !parser_eof(p) && parser_peek_is(p, ' ') {
            parser_advance(p);
            i = i + 1;
        }

        if !first_line {
            if literal {
                result = result ++ "\n";
            } else {
                result = result ++ " ";
            }
        }
        first_line = false;

        while !parser_eof(p) && !parser_peek_is_newline(p) {
            let ch_opt = parser_advance(p);
            if ch_opt.is_some() {
                result = result ++ ch_opt.unwrap().to_string();
            }
        }
        skip_newline(p);
    }

    Ok(yaml_string(result))
}

// =============================================================================
// Helper Functions
// =============================================================================

fn skip_space(p: &!Parser) with Mut, Panic, Div {
    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == ' ' || ch == '\t' {
            parser_advance(p);
        } else {
            break
        }
    }
}

fn skip_newline(p: &!Parser) with Mut, Panic {
    if parser_peek_is(p, '\r') {
        parser_advance(p);
    }
    if parser_peek_is(p, '\n') {
        parser_advance(p);
    }
}

fn skip_whitespace_and_comments(p: &!Parser) with Mut, Panic, Div {
    while !parser_eof(p) {
        let opt = parser_peek(p);
        if opt.is_none() {
            break
        }
        let ch = opt.unwrap();
        if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r' {
            parser_advance(p);
        } else if ch == '#' {
            while !parser_eof(p) && !parser_peek_is_newline(p) {
                parser_advance(p);
            }
        } else {
            break
        }
    }
}

fn skip_to_next_content(p: &!Parser) with Mut, Panic, Div {
    while !parser_eof(p) && !parser_peek_is_newline(p) {
        if parser_peek_is(p, '#') {
            break
        }
        parser_advance(p);
    }
    skip_newline(p);
    skip_whitespace_and_comments(p);
}

fn count_indent(p: &Parser) -> usize with Mut, Div {
    var count: usize = 0;
    var pos = p.pos;

    while pos < p.len {
        let ch = p.input.char_at(pos);
        if ch == ' ' {
            count = count + 1;
            pos = pos + 1;
        } else {
            break
        }
    }

    count
}

fn is_blank_line(p: &Parser) -> bool with Mut, Div {
    var pos = p.pos;
    while pos < p.len {
        let ch = p.input.char_at(pos);
        if ch == '\n' || ch == '\r' {
            return true
        }
        if ch != ' ' && ch != '\t' {
            return false
        }
        pos = pos + 1;
    }
    true
}

// =============================================================================
// Serialization
// =============================================================================

fn yaml_is_collection(value: &YamlValue) -> bool {
    value.tag == TAG_SEQUENCE || value.tag == TAG_MAPPING
}

pub fn yaml_to_string(value: &YamlValue) -> string with Alloc, Mut, Panic, Div {
    yaml_to_string_indent(value, 0)
}

fn yaml_to_string_indent(value: &YamlValue, indent: usize) -> string with Alloc, Mut, Panic, Div {
    if value.tag == TAG_NULL {
        "null".to_string()
    } else if value.tag == TAG_BOOL {
        if value.bool_val { "true".to_string() } else { "false".to_string() }
    } else if value.tag == TAG_INT {
        value.int_val.to_string()
    } else if value.tag == TAG_FLOAT {
        let f = value.float_val;
        if f != f {  // NaN check
            ".nan".to_string()
        } else if f > 1.0e308 {
            ".inf".to_string()
        } else if f < -1.0e308 {
            "-.inf".to_string()
        } else {
            f.to_string()
        }
    } else if value.tag == TAG_STRING {
        escape_yaml_string(&value.string_val)
    } else if value.tag == TAG_SEQUENCE {
        if value.seq_val.len() == 0 {
            "[]".to_string()
        } else {
            var result = "";
            let item_indent = indent + 2;
            let spaces = " ".repeat(indent);

            var first = true;
            var i: usize = 0;
            while i < value.seq_val.len() {
                let item = &value.seq_val[i];
                if !first {
                    result = result ++ "\n";
                }
                first = false;

                result = result ++ spaces ++ "- ";

                let item_str = yaml_to_string_indent(item, item_indent);
                if yaml_is_collection(item) {
                    result = result ++ "\n" ++ item_str;
                } else {
                    result = result ++ item_str;
                }
                i = i + 1;
            }

            result
        }
    } else if value.tag == TAG_MAPPING {
        if value.map_val.len() == 0 {
            "{}".to_string()
        } else {
            var result = "";
            let spaces = " ".repeat(indent);

            var first = true;
            var i: usize = 0;
            while i < value.map_val.len() {
                let entry = &value.map_val[i];
                if !first {
                    result = result ++ "\n";
                }
                first = false;

                result = result ++ spaces ++ escape_yaml_key(&entry.key) ++ ":";

                let value_str = yaml_to_string_indent(&entry.value, indent + 2);
                if yaml_is_collection(&entry.value) {
                    result = result ++ "\n" ++ value_str;
                } else {
                    result = result ++ " " ++ value_str;
                }
                i = i + 1;
            }

            result
        }
    } else {
        "".to_string()
    }
}

fn escape_yaml_string(s: &str) -> string with Alloc, Mut, Div {
    let needs_quote = s.len() == 0 ||
        s.char_at(0) == ' ' ||
        s.char_at(s.len() - 1) == ' ' ||
        s.char_at(0) == '-' ||
        s.char_at(0) == '[' ||
        s.char_at(0) == '{' ||
        s == "true" || s == "false" || s == "null" ||
        s == "yes" || s == "no" || s == "on" || s == "off";

    // Check for special characters
    var has_special = false;
    var i: usize = 0;
    while i < s.len() && !has_special {
        let ch = s.char_at(i);
        if ch == ':' || ch == '#' || ch == '\n' || ch == '\r' {
            has_special = true;
        }
        i = i + 1;
    }

    if !needs_quote && !has_special {
        return s.to_string()
    }

    var result = "\"";
    i = 0;
    while i < s.len() {
        let ch = s.char_at(i);
        if ch == '"' {
            result = result ++ "\\\"";
        } else if ch == '\\' {
            result = result ++ "\\\\";
        } else if ch == '\n' {
            result = result ++ "\\n";
        } else if ch == '\r' {
            result = result ++ "\\r";
        } else if ch == '\t' {
            result = result ++ "\\t";
        } else {
            result = result ++ ch.to_string();
        }
        i = i + 1;
    }
    result = result ++ "\"";
    result
}

fn escape_yaml_key(s: &str) -> string with Alloc, Mut, Div {
    var has_special = false;
    var i: usize = 0;
    while i < s.len() && !has_special {
        let ch = s.char_at(i);
        if ch == ':' || ch == ' ' || ch == '#' {
            has_special = true;
        }
        i = i + 1;
    }

    if has_special {
        "\"" ++ s ++ "\""
    } else {
        s.to_string()
    }
}

// =============================================================================
// Value Access Functions
// =============================================================================

pub fn yaml_get(value: &YamlValue, key: &str) -> Option<&YamlValue> with Mut, Div, Panic {
    if value.tag != TAG_MAPPING {
        return None
    }

    var i: usize = 0;
    while i < value.map_val.len() {
        let entry = &value.map_val[i];
        if entry.key == key {
            return Some(&entry.value)
        }
        i = i + 1;
    }
    return None
}

pub fn yaml_at(value: &YamlValue, index: usize) -> Option<&YamlValue> with Panic {
    if value.tag != TAG_SEQUENCE {
        return None
    }

    if index < value.seq_val.len() {
        return Some(&value.seq_val[index])
    }
    return None
}

pub fn yaml_is_null(value: &YamlValue) -> bool {
    value.tag == TAG_NULL
}

pub fn yaml_as_bool(value: &YamlValue) -> Option<bool> {
    if value.tag == TAG_BOOL {
        return Some(value.bool_val)
    }
    return None
}

pub fn yaml_as_i64(value: &YamlValue) -> Option<i64> {
    if value.tag == TAG_INT {
        return Some(value.int_val)
    }
    return None
}

pub fn yaml_as_f64(value: &YamlValue) -> Option<f64> {
    if value.tag == TAG_FLOAT {
        return Some(value.float_val)
    }
    if value.tag == TAG_INT {
        return Some(value.int_val as f64)
    }
    return None
}

pub fn yaml_as_str(value: &YamlValue) -> Option<&str> {
    if value.tag == TAG_STRING {
        return Some(&value.string_val)
    }
    return None
}

pub fn yaml_as_sequence(value: &YamlValue) -> Option<&Vec<YamlValue>> {
    if value.tag == TAG_SEQUENCE {
        return Some(&value.seq_val)
    }
    return None
}

pub fn yaml_as_mapping(value: &YamlValue) -> Option<&Vec<YamlEntry>> {
    if value.tag == TAG_MAPPING {
        return Some(&value.map_val)
    }
    return None
}

pub fn yaml_len(value: &YamlValue) -> usize {
    if value.tag == TAG_SEQUENCE {
        value.seq_val.len()
    } else if value.tag == TAG_MAPPING {
        value.map_val.len()
    } else {
        0
    }
}

pub fn yaml_keys(value: &YamlValue) -> Vec<string> with Alloc, Mut, Div, Panic {
    if value.tag != TAG_MAPPING {
        return vec![]
    }

    var keys: Vec<string> = vec![];
    var i: usize = 0;
    while i < value.map_val.len() {
        keys.push(value.map_val[i].key.clone());
        i = i + 1;
    }
    keys
}
