//! stdlib/yaml - YAML Parser
//!
//! Flat key-value YAML parsing (no nesting, no sequences).

module yaml

pub fn yaml_module_ready() -> i32 { 1 }

pub use yaml::parser::{
    YAML_BOOL,
    YAML_NULL,
    YAML_NUMBER,
    YAML_STRING,
    YamlDoc,
    yaml_doc_count,
    yaml_doc_new,
    yaml_get_bool,
    yaml_get_number,
    yaml_get_string,
    yaml_parse,
    yaml_self_test,
}