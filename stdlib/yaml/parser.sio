// stdlib/yaml/parser.sio — Minimal YAML parser

module yaml::parser

fn yaml_neg_one() -> i32 {
    let z: i32 = 0
    z - 1
}
//
// Represents YAML as a flat key-value document (up to 32 entries).
// No heap allocation — all storage is fixed-size arrays.
// Supports flat "key: value" lines only (no nesting, no sequences).
// Value types: string (quoted or bare), number, bool, null.
//
// Recognised bool literals (case-insensitive matching via lowercase-first byte):
//   true, yes  → 1
//   false, no  → 0
// Recognised null: null, ~  → type=3 (YAML_NULL)
//
// JIT note: only &!Struct field mutations propagate to callers.
// Standalone &!array and &!scalar do NOT propagate in JIT mode.
//
// # Limits
//   - Up to 32 key-value pairs per document
//   - Keys up to 63 bytes (null-terminated in 64-byte slot)
//   - String values up to 127 bytes (null-terminated in 128-byte slot)
//   - Parse input up to 4095 bytes

// ============================================================================
// YAML VALUE TYPES
// ============================================================================

pub fn YAML_STRING() -> i32 { 0 }
pub fn YAML_NUMBER() -> i32 { 1 }
pub fn YAML_BOOL()   -> i32 { 2 }
pub fn YAML_NULL()   -> i32 { 3 }

// ============================================================================
// YamlDoc — flat key→value store, up to 32 entries
// ============================================================================

pub struct YamlDoc {
    pub keys:     [[u8; 64]; 32],
    pub key_lens: [i32; 32],
    pub str_vals: [[u8; 128]; 32],
    pub str_lens: [i32; 32],
    pub num_vals: [f64; 32],
    pub types:    [i32; 32],
    pub count:    i32,
}

// ============================================================================
// Internal result types
// ============================================================================

// Result from parsing a quoted string body (after opening '"').
struct YStrResult {
    data:    [u8; 128],
    str_len: i32,
    new_pos: i32,   // -1 on error
}

// Result from parsing a number token.
struct YNumResult {
    value:   f64,
    new_pos: i32,
}

// ============================================================================
// YamlDoc constructor
// ============================================================================

pub fn yaml_doc_new() -> YamlDoc {
    YamlDoc {
        keys:     [[(0 as u8); 64]; 32],
        key_lens: [0; 32],
        str_vals: [[(0 as u8); 128]; 32],
        str_lens: [0; 32],
        num_vals: [0.0; 32],
        types:    [0; 32],
        count:    0,
    }
}

// ============================================================================
// Internal helpers (must precede callers)
// ============================================================================

// Skip spaces and tabs (but not newlines). Returns new position.
fn yaml_skip_ws(input: &[u8; 4096], pos: i32, len: i32) -> i32 with Mut, Div, Panic {
    var p: i32 = pos
    while p < len {
        let c = input[p as usize]
        if c == (32 as u8) || c == (9 as u8) {
            p = p + 1
        } else {
            return p
        }
    }
    p
}

// Skip to end of current line (past '\n'). Returns new position.
fn yaml_skip_line(input: &[u8; 4096], pos: i32, len: i32) -> i32 with Mut, Div, Panic {
    var p: i32 = pos
    while p < len {
        let c = input[p as usize]
        p = p + 1
        if c == (10 as u8) {
            return p
        }
    }
    p
}

// Parse a quoted YAML double-quoted string body (after opening '"').
// Returns YStrResult; new_pos=-1 on error.
fn yaml_parse_quoted(input: &[u8; 4096], start: i32, len: i32) -> YStrResult with Mut, Div, Panic {
    var r = YStrResult {
        data:    [0; 128],
        str_len: 0,
        new_pos: yaml_neg_one(),
    }
    var p: i32 = start
    var wpos: i32 = 0
    var done: i32 = 0
    while p < len && done == 0 {
        let c = input[p as usize]
        if c == (34 as u8) {
            // closing '"'
            p = p + 1
            done = 1
        } else if c == (92 as u8) {
            // escape
            p = p + 1
            if p >= len { return r }
            let esc = input[p as usize]
            if esc == (34 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (34 as u8); wpos = wpos + 1 }
            } else if esc == (92 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (92 as u8); wpos = wpos + 1 }
            } else if esc == (110 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (10 as u8); wpos = wpos + 1 }
            } else if esc == (116 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (9 as u8); wpos = wpos + 1 }
            } else {
                if wpos < 127 { r.data[wpos as usize] = esc; wpos = wpos + 1 }
            }
            p = p + 1
        } else if c == (10 as u8) || c == (13 as u8) {
            return r
        } else {
            if wpos < 127 { r.data[wpos as usize] = c; wpos = wpos + 1 }
            p = p + 1
        }
    }
    if done == 0 { return r }
    r.str_len = wpos
    r.new_pos = p
    r
}

// Parse a bare (unquoted) value token until whitespace, '#', or end-of-line.
// Returns number of bytes written into data and the new position.
struct YBareResult {
    data:    [u8; 128],
    str_len: i32,
    new_pos: i32,
}

fn yaml_parse_bare(input: &[u8; 4096], start: i32, len: i32) -> YBareResult with Mut, Div, Panic {
    var r = YBareResult {
        data:    [0; 128],
        str_len: 0,
        new_pos: start,
    }
    var p: i32 = start
    var wpos: i32 = 0
    var done: i32 = 0
    while p < len && done == 0 {
        let c = input[p as usize]
        if c == (10 as u8) || c == (13 as u8) || c == (35 as u8) {
            done = 1
        } else {
            if wpos < 127 { r.data[wpos as usize] = c; wpos = wpos + 1 }
            p = p + 1
        }
    }
    // Trim trailing spaces from bare value.
    while wpos > 0 && r.data[(wpos - 1) as usize] == (32 as u8) {
        wpos = wpos - 1
    }
    r.str_len = wpos
    r.new_pos = p
    r
}

// Parse a number from a YBareResult data buffer (len bytes).
fn yaml_number_from_bare(data: &[u8; 128], data_len: i32) -> YNumResult with Mut, Div, Panic {
    var p: i32 = 0
    var negative: i32 = 0
    if p < data_len && data[p as usize] == (45 as u8) {
        negative = 1
        p = p + 1
    }
    var int_part: f64 = 0.0
    var int_done: i32 = 0
    while p < data_len && int_done == 0 {
        let c = data[p as usize]
        if c >= (48 as u8) && c <= (57 as u8) {
            int_part = int_part * 10.0 + (c - (48 as u8)) as f64
            p = p + 1
        } else {
            int_done = 1
        }
    }
    var frac: f64 = 0.0
    var frac_div: f64 = 1.0
    if p < data_len && data[p as usize] == (46 as u8) {
        p = p + 1
        var frac_done: i32 = 0
        while p < data_len && frac_done == 0 {
            let c = data[p as usize]
            if c >= (48 as u8) && c <= (57 as u8) {
                frac = frac * 10.0 + (c - (48 as u8)) as f64
                frac_div = frac_div * 10.0
                p = p + 1
            } else {
                frac_done = 1
            }
        }
    }
    var result = int_part + frac / frac_div
    if negative == 1 { result = 0.0 - result }
    YNumResult { value: result, new_pos: p }
}

// Lowercase a byte (A-Z → a-z). Other bytes unchanged.
fn yaml_to_lower(c: u8) -> u8 {
    if c >= (65 as u8) && c <= (90 as u8) {
        (c + (32 as u8)) as u8
    } else {
        c
    }
}

// Check if bare data matches "true" (case-insensitive). 1=yes, 0=no.
fn yaml_is_true(data: &[u8; 128], data_len: i32) -> i32 with Mut, Div, Panic {
    if data_len != 4 { return 0 }
    if yaml_to_lower(data[0]) != (116 as u8) { return 0 }  // t
    if yaml_to_lower(data[1]) != (114 as u8) { return 0 }  // r
    if yaml_to_lower(data[2]) != (117 as u8) { return 0 }  // u
    if yaml_to_lower(data[3]) != (101 as u8) { return 0 }  // e
    1
}

// Check if bare data matches "false" (case-insensitive). 1=yes, 0=no.
fn yaml_is_false(data: &[u8; 128], data_len: i32) -> i32 with Mut, Div, Panic {
    if data_len != 5 { return 0 }
    if yaml_to_lower(data[0]) != (102 as u8) { return 0 }  // f
    if yaml_to_lower(data[1]) != (97 as u8)  { return 0 }  // a
    if yaml_to_lower(data[2]) != (108 as u8) { return 0 }  // l
    if yaml_to_lower(data[3]) != (115 as u8) { return 0 }  // s
    if yaml_to_lower(data[4]) != (101 as u8) { return 0 }  // e
    1
}

// Check if bare data matches "yes" (case-insensitive). 1=yes, 0=no.
fn yaml_is_yes(data: &[u8; 128], data_len: i32) -> i32 with Mut, Div, Panic {
    if data_len != 3 { return 0 }
    if yaml_to_lower(data[0]) != (121 as u8) { return 0 }  // y
    if yaml_to_lower(data[1]) != (101 as u8) { return 0 }  // e
    if yaml_to_lower(data[2]) != (115 as u8) { return 0 }  // s
    1
}

// Check if bare data matches "no" (case-insensitive). 1=yes, 0=no.
fn yaml_is_no(data: &[u8; 128], data_len: i32) -> i32 with Mut, Div, Panic {
    if data_len != 2 { return 0 }
    if yaml_to_lower(data[0]) != (110 as u8) { return 0 }  // n
    if yaml_to_lower(data[1]) != (111 as u8) { return 0 }  // o
    1
}

// Check if bare data matches "null" (case-insensitive) or "~". 1=yes, 0=no.
fn yaml_is_null(data: &[u8; 128], data_len: i32) -> i32 with Mut, Div, Panic {
    if data_len == 1 && data[0] == (126 as u8) { return 1 }  // '~'
    if data_len != 4 { return 0 }
    if yaml_to_lower(data[0]) != (110 as u8) { return 0 }  // n
    if yaml_to_lower(data[1]) != (117 as u8) { return 0 }  // u
    if yaml_to_lower(data[2]) != (108 as u8) { return 0 }  // l
    if yaml_to_lower(data[3]) != (108 as u8) { return 0 }  // l
    1
}

// Returns 1 if byte is a decimal digit or '-' (start of number).
fn yaml_is_number_start(c: u8) -> i32 {
    if c >= (48 as u8) && c <= (57 as u8) { return 1 }
    if c == (45 as u8) { return 1 }
    0
}

// Compare a key slot in doc against provided key. Returns 1 if equal.
fn yaml_keys_equal(doc: &YamlDoc, slot: i32, key: &[u8; 64], key_len: i32) -> i32 with Mut, Div, Panic {
    if doc.key_lens[slot as usize] != key_len { return 0 }
    var i: i32 = 0
    while i < key_len {
        if doc.keys[slot as usize][i as usize] != key[i as usize] { return 0 }
        i = i + 1
    }
    1
}

// Find slot index for a key. Returns index or -1.
fn yaml_find_key(doc: &YamlDoc, key: &[u8; 64], key_len: i32) -> i32 with Mut, Div, Panic {
    var i: i32 = 0
    while i < doc.count {
        if yaml_keys_equal(doc, i, key, key_len) == 1 {
            return i
        }
        i = i + 1
    }
    yaml_neg_one()
}

// ============================================================================
// yaml_parse — main parse entry point
// ============================================================================

// Parse a flat YAML document from input bytes.
// Handles: key: value pairs, # comments, blank lines.
// Value detection: quoted strings, numbers, bool (true/false/yes/no),
//                  null/~, and bare strings.
// Returns 0 on success, -1 on error.
pub fn yaml_parse(input: &[u8; 4096], len: i32, doc: &!YamlDoc) -> i32 with Mut, Div, Panic {
    var p: i32 = 0
    while p < len {
        // Skip leading spaces/tabs.
        p = yaml_skip_ws(input, p, len)
        if p >= len { return 0 }

        let c0 = input[p as usize]

        if c0 == (10 as u8) || c0 == (13 as u8) {
            // Blank line.
            p = p + 1
            if c0 == (13 as u8) && p < len && input[p as usize] == (10 as u8) {
                p = p + 1
            }
        } else if c0 == (35 as u8) {
            // '#' comment
            p = yaml_skip_line(input, p, len)
        } else if c0 == (45 as u8) && p + 2 < len && input[(p+1) as usize] == (45 as u8) && input[(p+2) as usize] == (45 as u8) {
            // '---' document marker — skip line
            p = yaml_skip_line(input, p, len)
        } else {
            // Parse key — bare key chars: alphanumeric, '-', '_', '.', ' ' before ':'
            // Keys end at ':'
            var key64: [u8; 64] = [0; 64]
            var klen: i32 = 0
            var key_done: i32 = 0
            while p < len && key_done == 0 {
                let kc = input[p as usize]
                if kc == (58 as u8) {
                    // ':' — end of key
                    key_done = 1
                } else if kc == (10 as u8) || kc == (13 as u8) {
                    key_done = 1
                } else {
                    if klen < 63 {
                        key64[klen as usize] = kc
                        klen = klen + 1
                    }
                    p = p + 1
                }
            }
            // Trim trailing spaces from key.
            while klen > 0 && key64[(klen - 1) as usize] == (32 as u8) {
                klen = klen - 1
            }

            if klen == 0 || p >= len {
                // No valid key or no ':' found — skip line.
                p = yaml_skip_line(input, p, len)
            } else {
                // Consume the ':'.
                p = p + 1
                // Skip whitespace after ':'.
                p = yaml_skip_ws(input, p, len)

                if doc.count < 32 {
                    let slot = doc.count
                    // Copy key into slot.
                    var ki: i32 = 0
                    while ki < klen {
                        doc.keys[slot as usize][ki as usize] = key64[ki as usize]
                        ki = ki + 1
                    }
                    doc.key_lens[slot as usize] = klen

                    if p >= len || input[p as usize] == (10 as u8) || input[p as usize] == (13 as u8) {
                        // Null value (empty after colon).
                        doc.types[slot as usize] = 3
                        doc.count = doc.count + 1
                    } else {
                        let vc = input[p as usize]

                        if vc == (34 as u8) {
                            // Quoted string.
                            p = p + 1
                            let qr = yaml_parse_quoted(input, p, len)
                            if qr.new_pos < 0 { return yaml_neg_one() }
                            p = qr.new_pos
                            doc.types[slot as usize] = 0
                            doc.str_lens[slot as usize] = qr.str_len
                            var si: i32 = 0
                            while si < qr.str_len {
                                doc.str_vals[slot as usize][si as usize] = qr.data[si as usize]
                                si = si + 1
                            }
                            doc.count = doc.count + 1

                        } else {
                            // Bare value — read until end of line / comment.
                            let br = yaml_parse_bare(input, p, len)
                            p = br.new_pos

                            if yaml_is_null(&br.data, br.str_len) == 1 {
                                doc.types[slot as usize] = 3
                                doc.count = doc.count + 1

                            } else if yaml_is_true(&br.data, br.str_len) == 1 || yaml_is_yes(&br.data, br.str_len) == 1 {
                                doc.types[slot as usize] = 2
                                doc.num_vals[slot as usize] = 1.0
                                doc.count = doc.count + 1

                            } else if yaml_is_false(&br.data, br.str_len) == 1 || yaml_is_no(&br.data, br.str_len) == 1 {
                                doc.types[slot as usize] = 2
                                doc.num_vals[slot as usize] = 0.0
                                doc.count = doc.count + 1

                            } else if br.str_len > 0 && yaml_is_number_start(br.data[0]) == 1 {
                                // Attempt numeric parse.
                                let nr = yaml_number_from_bare(&br.data, br.str_len)
                                doc.types[slot as usize] = 1
                                doc.num_vals[slot as usize] = nr.value
                                doc.count = doc.count + 1

                            } else if br.str_len > 0 {
                                // Bare string value.
                                doc.types[slot as usize] = 0
                                doc.str_lens[slot as usize] = br.str_len
                                var bsi: i32 = 0
                                while bsi < br.str_len {
                                    doc.str_vals[slot as usize][bsi as usize] = br.data[bsi as usize]
                                    bsi = bsi + 1
                                }
                                doc.count = doc.count + 1

                            } else {
                                // Empty bare value → null.
                                doc.types[slot as usize] = 3
                                doc.count = doc.count + 1
                            }
                        }
                    }
                }

                // Skip trailing comment or EOL.
                p = yaml_skip_ws(input, p, len)
                if p < len {
                    let trail = input[p as usize]
                    if trail == (35 as u8) {
                        p = yaml_skip_line(input, p, len)
                    } else if trail == (10 as u8) || trail == (13 as u8) {
                        p = p + 1
                        if trail == (13 as u8) && p < len && input[p as usize] == (10 as u8) {
                            p = p + 1
                        }
                    }
                }
            }
        }
    }
    0
}

// ============================================================================
// Accessor functions
// ============================================================================

// Returns string length; -1 if not found or not a string.
// NOTE: &![u8;128] mutations do NOT propagate in JIT — use doc.str_vals[slot] directly.
pub fn yaml_get_string(doc: &YamlDoc, key: &[u8; 64], key_len: i32, out: &![u8; 128]) -> i32 with Mut, Div, Panic {
    let idx = yaml_find_key(doc, key, key_len)
    if idx < 0 { return yaml_neg_one() }
    if doc.types[idx as usize] != 0 { return yaml_neg_one() }
    let slen = doc.str_lens[idx as usize]
    var i: i32 = 0
    while i < slen {
        out[i as usize] = doc.str_vals[idx as usize][i as usize]
        i = i + 1
    }
    slen
}

// Returns number value, or 0.0 if not found / not numeric.
pub fn yaml_get_number(doc: &YamlDoc, key: &[u8; 64], key_len: i32) -> f64 with Mut, Div, Panic {
    let idx = yaml_find_key(doc, key, key_len)
    if idx < 0 { return 0.0 }
    if doc.types[idx as usize] != 1 { return 0.0 }
    doc.num_vals[idx as usize]
}

// Returns 0 or 1 for bool, -1 if not found / not a bool.
pub fn yaml_get_bool(doc: &YamlDoc, key: &[u8; 64], key_len: i32) -> i32 with Mut, Div, Panic {
    let idx = yaml_find_key(doc, key, key_len)
    if idx < 0 { return yaml_neg_one() }
    if doc.types[idx as usize] != 2 { return yaml_neg_one() }
    if doc.num_vals[idx as usize] > 0.5 { return 1 }
    0
}

// Returns total number of key-value pairs in document.
pub fn yaml_doc_count(doc: &YamlDoc) -> i32 {
    doc.count
}

// ============================================================================
// Self-tests
// ============================================================================

pub fn yaml_self_test() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    // T1: empty doc
    var doc = yaml_doc_new()
    if doc.count != 0 { fail = fail + 1 }

    // T2: parse integer  "count: 42\n"
    var raw: [u8; 4096] = [0; 4096]
    raw[0]  = (99 as u8)   // c
    raw[1]  = (111 as u8)  // o
    raw[2]  = (117 as u8)  // u
    raw[3]  = (110 as u8)  // n
    raw[4]  = (116 as u8)  // t
    raw[5]  = (58 as u8)   // :
    raw[6]  = (32 as u8)   // space
    raw[7]  = (52 as u8)   // 4
    raw[8]  = (50 as u8)   // 2
    raw[9]  = (10 as u8)   // \n
    let r1 = yaml_parse(&raw, 10, &!doc)
    if r1 != 0 { fail = fail + 1 }
    if doc.count != 1 { fail = fail + 1 }
    if doc.types[0] != 1 { fail = fail + 1 }
    let vd = doc.num_vals[0] - 42.0
    let avd = if vd < 0.0 { 0.0 - vd } else { vd }
    if avd > 0.0001 { fail = fail + 1 }

    // T3: parse bool  "active: true\n"
    var doc2 = yaml_doc_new()
    var raw2: [u8; 4096] = [0; 4096]
    raw2[0]  = (97 as u8)   // a
    raw2[1]  = (99 as u8)   // c
    raw2[2]  = (116 as u8)  // t
    raw2[3]  = (105 as u8)  // i
    raw2[4]  = (118 as u8)  // v
    raw2[5]  = (101 as u8)  // e
    raw2[6]  = (58 as u8)   // :
    raw2[7]  = (32 as u8)   // space
    raw2[8]  = (116 as u8)  // t
    raw2[9]  = (114 as u8)  // r
    raw2[10] = (117 as u8)  // u
    raw2[11] = (101 as u8)  // e
    raw2[12] = (10 as u8)   // \n
    let r2 = yaml_parse(&raw2, 13, &!doc2)
    if r2 != 0 { fail = fail + 1 }
    if doc2.count != 1 { fail = fail + 1 }
    if doc2.types[0] != 2 { fail = fail + 1 }
    let bv = doc2.num_vals[0]
    if bv < 0.5 { fail = fail + 1 }

    // T4: doc.count (direct field access — avoids borrow conflict after &!doc)
    if doc.count != 1 { fail = fail + 1 }

    fail
}
