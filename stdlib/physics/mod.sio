// stdlib/physics/mod.sio — Public exports for the physics module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files
// (phonon.sio, phonon_quantity.sio, pbpk_phonon.sio, pbpk_phonon_q.sio).
//
// The physics module provides 1D-lattice phonon models for hepatic
// microcirculation, in two parallel API generations:
//   - legacy flat-array API (phonon.sio, pbpk_phonon.sio) — DEPRECATED
//   - Quantity-typed API     (phonon_quantity.sio, pbpk_phonon_q.sio) — preferred
//
// New code should `use physics::phonon_quantity::*` and
// `use physics::pbpk_phonon_q::*`. The legacy API is kept for parity
// regression detection and backward compatibility only.

pub use physics::phonon::{
    PhononState,
    phonon_state_zero,
    phonon_rk4_step,
    phonon_simulate,
    rapamycin_phonon_params,
}

pub use physics::phonon_quantity::{
    PhononParams,
    Lattice64,
    rapamycin_phonon_params_q,
    pulsatile_input_q,
    cfl_dt_q,
    phonon_rhs_q,
    phonon_rk4_step_q,
    phonon_simulate_q,
    lattice64_init,
    lattice64_zero,
    lattice64_spatial_average,
    lattice64_spatial_variance,
    lattice64_outflow_concentration,
    lattice64_outflow_variance,
    lattice64_mean_variance,
}

pub use physics::pbpk_phonon::{
    phonon_liver_cycle,
    phonon_init_uniform,
}

pub use physics::pbpk_phonon_q::{
    phonon_liver_cycle_q,
    phonon_liver_cycle_variance_q,
    phonon_correction_q,
    phonon_init_uniform_q,
}
