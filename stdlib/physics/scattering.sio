// Compton wavelength shift for a free electron, angle in radians.
// Angular standard-uncertainty contribution only; mass uncertainty is separate.
// Uses canonical physical constants and cancellation-resistant 2*sin(theta/2)^2.
use math::pure::{sin, is_finite}
use constants::physical::{planck_constant_approx, electron_mass_approx, speed_of_light_approx}
pub let COMPTON_OK: i64 = 0
pub let COMPTON_INVALID_INPUT: i64 = 1
pub let COMPTON_NUMERIC_FAILURE: i64 = 2
pub struct ComptonShift {
    pub shift_m: f64,
    pub angular_standard_uncertainty_m: f64,
    pub status: i64,
}
pub fn electron_compton_shift(theta: f64, angular_standard_uncertainty: f64) -> ComptonShift with Mut, Div, Panic {
    var r = ComptonShift { shift_m: 0.0, angular_standard_uncertainty_m: 0.0, status: COMPTON_INVALID_INPUT }
    if !is_finite(theta) || !is_finite(angular_standard_uncertainty) { return r }
    if theta < 0.0 || theta > 3.14159265358979323846 || angular_standard_uncertainty < 0.0 { return r }
    let wavelength = planck_constant_approx() / (electron_mass_approx() * speed_of_light_approx())
    let half_sine = sin(theta / 2.0)
    r.shift_m = 2.0 * wavelength * half_sine * half_sine
    let derivative = sin(theta)
    let magnitude = if derivative < 0.0 { 0.0 - derivative } else { derivative }
    r.angular_standard_uncertainty_m = wavelength * magnitude * angular_standard_uncertainty
    r.status = COMPTON_OK
    if !is_finite(r.shift_m) || !is_finite(r.angular_standard_uncertainty_m) { r.status = COMPTON_NUMERIC_FAILURE }
    r
}
