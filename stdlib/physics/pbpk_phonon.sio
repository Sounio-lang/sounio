// Cycle averaging over the checked SI lattice. The same latent factor basis is
// integrated through every nominal RK4 stage, preserving covariance across time.
// This kernel makes no blood/plasma calibration or compartment-partition choice.
use physics::phonon_factor::{PhononState,phonon_state_status,phonon_state_n,phonon_state_rank,phonon_state_time,phonon_parameters,phonon_concentration,phonon_factor_entry,phonon_time_limit,phonon_step_checked}
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_status,numeric_buffer_len,numeric_buffer_at,numeric_buffer_set}
use math::pure::{is_finite,sqrt}
pub struct PhononCycleResult {pub status:i64,pub mean:f64,pub standard_uncertainty:f64,pub variance:f64,pub duration:f64,pub steps:i64,pub uncertainty_model:i64,pub first_order:bool}
fn pc_empty(status:i64)->PhononCycleResult {PhononCycleResult{status:status,mean:0.0,standard_uncertainty:0.0,variance:0.0,duration:0.0,steps:0,uncertainty_model:2,first_order:true}}
fn pc_abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn pc_min(a:f64,b:f64)->f64 {if a<b {a}else{b}}
fn pc_previous(s:&PhononState,average:&!NumericBuffer)->i64 with Mut,Div,Panic {
 let n:i64=phonon_state_n(s)
 let k:i64=phonon_state_rank(s)
 let width:i64=k+1
 let x=phonon_concentration(s,n-1)
 if x.status!=0 {return x.status}
 numeric_buffer_set(average,width,x.value)
 var col:i64=0
 while col<k {
  let f=phonon_factor_entry(s,n-1,col)
  if f.status!=0 {return f.status}
  numeric_buffer_set(average,width+col+1,f.value);col=col+1
 }
 0
}
// Augmented RK4 quadrature: integral'=outflow (and each outflow sensitivity).
// The successful lattice step leaves k1..k4 in its caller-owned scratch.
fn pc_accumulate(scratch:&NumericBuffer,average:&!NumericBuffer,n:i64,k:i64,h:f64)->i64 with Mut,Div,Panic {
 let width:i64=k+1
 let length:i64=n*width
 let outlet:i64=(n-1)*width
 var col:i64=0
 while col<width {
  let ia:i64=outlet+col
  let ib:i64=length+ia
  let ic:i64=2*length+ia
  let ip:i64=width+col
  let before=numeric_buffer_at(average,ip)
  let a=numeric_buffer_at(scratch,ia)
  let b=numeric_buffer_at(scratch,ib)
  let c=numeric_buffer_at(scratch,ic)
  let increment=h*(before+(h/6.0)*(a+b+c))
  let previous=numeric_buffer_at(average,col)
  let value=previous+increment
  if !is_finite(increment)||!is_finite(value) {return 4}
  numeric_buffer_set(average,col,value);col=col+1
 }
 0
}
fn pc_finish(s:&PhononState,average:&!NumericBuffer,k:i64,duration:f64)->PhononCycleResult with Mut,Div,Panic {
 var out=pc_empty(0)
 let n:i64=phonon_state_n(s)
 let width:i64=k+1
 let parameters=phonon_parameters(s)
 let endpoint=phonon_concentration(s,n-1)
 if endpoint.status!=0 {return pc_empty(endpoint.status)}
 let raw_mean=numeric_buffer_at(average,0)
 out.mean=raw_mean/duration
 if !is_finite(out.mean) {return pc_empty(4)}
 numeric_buffer_set(average,0,out.mean)
 // Leibniz endpoint and normalization derivative for T=1/f_heart.
 let boundary=(endpoint.value-out.mean)/duration
 if !is_finite(boundary) {return pc_empty(4)}
 var scale:f64=0.0
 var sum:f64=1.0
 var col:i64=1
 while col<width {
  let raw=numeric_buffer_at(average,col)
  let source=phonon_factor_entry(s,n+8,col-1)
  if source.status!=0 {return pc_empty(source.status)}
  let dT=(0.0-source.value/parameters.f_heart)/parameters.f_heart
  if !is_finite(dT)||(source.value!=0.0&&dT==0.0) {return pc_empty(4)}
  let value=raw/duration+boundary*dT
  if !is_finite(value) {return pc_empty(4)}
  numeric_buffer_set(average,col,value)
  let x=pc_abs(value)
  if x>0.0 {if x>scale {let r=scale/x;sum=1.0+sum*r*r;scale=x}else{let r=x/scale;sum=sum+r*r}}
  col=col+1
 }
 let u=scale*sqrt(sum)
 let variance=u*u
 if !is_finite(u)||!is_finite(variance)||(u!=0.0&&variance==0.0) {return pc_empty(4)}
 out.standard_uncertainty=u;out.variance=variance;out.duration=duration;out
}
// average length>=2*(k+1). On success first row is (mean, mean-factor columns).
// A nonzero process-noise model is not inferred: this is deterministic forcing
// with a fixed declared joint initial/parameter factor.
pub fn phonon_liver_cycle_checked(s:&!PhononState,scratch:&!NumericBuffer,average:&!NumericBuffer,max_step:f64,max_steps:i64)->PhononCycleResult with Mut,Div,Panic {
 var out=pc_empty(phonon_state_status(s))
 if out.status!=0 {return out}
 let n:i64=phonon_state_n(s)
 let k:i64=phonon_state_rank(s)
 let width:i64=k+1
 if !is_finite(max_step) {out.status=1;return out}
 if max_step<=0.0||max_steps<1||max_steps>1000000 {out.status=2;return out}
 if numeric_buffer_status(average)!=0||numeric_buffer_len(average)<2*width {out.status=3;return out}
 let p=phonon_parameters(s)
 if p.f_heart<=0.0 {out.status=2;return out}
 let requested_duration=1.0/p.f_heart
 let start=phonon_state_time(s)
 let target=start+requested_duration
 if !is_finite(requested_duration)||!is_finite(target) {out.status=4;return out}
 if target<=start {out.status=6;return out}
 let duration=target-start
 if !is_finite(duration) {out.status=4;return out}
 // A rounded deterministic window is reported and normalized as integrated.
 // An uncertain period needs a representable nominal period for its derivative.
 if duration!=requested_duration {
  var source:i64=0
  while source<k {
   let frequency=phonon_factor_entry(s,n+8,source)
   if frequency.status!=0 {out.status=frequency.status;return out}
   if frequency.value!=0.0 {out.status=6;return out}
   source=source+1
  }
 }
 let limit=phonon_time_limit(s)
 if limit.status!=0 {out.status=limit.status;return out}
 var col:i64=0
 while col<2*width {numeric_buffer_set(average,col,0.0);col=col+1}
 while phonon_state_time(s)<target && out.steps<max_steps {
  let before_time=phonon_state_time(s)
  let remaining=target-before_time
  var h=pc_min(remaining,pc_min(max_step,limit.value))
  let candidate=before_time+h
  if candidate<target && remaining<=limit.value {
   let trailing_midpoint=candidate+0.5*(target-candidate)
   let full_target=before_time+remaining
   let full_span=full_target-before_time
   let full_midpoint=before_time+0.5*full_span
   if (trailing_midpoint<=candidate||trailing_midpoint>=target) && full_target==target && full_midpoint>before_time && full_midpoint<full_target && full_span<=limit.value {h=remaining}
  }
  let next=before_time+h
  if next<=before_time||next>target {out.status=6;return out}
  let prior=pc_previous(s,average)
  if prior!=0 {out.status=prior;return out}
  let step=phonon_step_checked(s,scratch,h)
  out.duration=phonon_state_time(s)-start
  if step.status!=0 {out.status=step.status;return out}
  let used_h=phonon_state_time(s)-before_time
  let code=pc_accumulate(scratch,average,n,k,used_h)
  if code!=0 {out.status=code;return out}
  out.steps=out.steps+1
 }
 if phonon_state_time(s)<target {out.status=5;return out}
 let complete=pc_finish(s,average,k,duration)
 if complete.status!=0 {out.status=complete.status;return out}
 out.mean=complete.mean;out.standard_uncertainty=complete.standard_uncertainty;out.variance=complete.variance
 out.duration=duration;out.status=0;out
}
// Compatibility names now require the protected factor state and reusable work.
pub fn phonon_liver_cycle(s:&!PhononState,scratch:&!NumericBuffer,average:&!NumericBuffer,max_step:f64,max_steps:i64)->PhononCycleResult with Mut,Div,Panic {phonon_liver_cycle_checked(s,scratch,average,max_step,max_steps)}
