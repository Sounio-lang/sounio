// stdlib/physics/mechanics.sio
//
// Quantity-typed Newtonian mechanics primitives. Demonstrates the
// `units::lib` dimensional-analysis + GUM-uncertainty layer through
// five first-principles laws:
//
//   - kinetic_energy_q       (E = ½ m v²)
//   - gravitational_force_q  (F = G m₁ m₂ / r²,  CODATA 2018)
//   - hookean_force_q        (F = k x, linear spring magnitude)
//   - work_done_q            (W = F · d)
//   - power_q                (P = W / t)
//
// All inputs and outputs are `Quantity` (value + GUM u + dim). GUM
// uncertainty propagates automatically through `quantity_mul` /
// `quantity_div` per JCGM 100:2008 §5.1 (combined standard uncertainty
// for products and quotients combines relative uncertainties in
// quadrature).
//
// References:
//   Newton, "Philosophiæ Naturalis Principia Mathematica" (1687).
//   Hooke, "De Potentia Restitutiva" (1678).
//   Tiesinga et al., "CODATA recommended values of the fundamental
//     physical constants: 2018", Rev. Mod. Phys. 93, 025010 (2021).
//     https://doi.org/10.1103/RevModPhys.93.025010
//   JCGM 100:2008 — "Evaluation of measurement data — Guide to the
//     expression of uncertainty in measurement" (GUM 2008).
//     https://www.bipm.org/documents/20126/2071204/JCGM_100_2008_E.pdf

use units::lib::*

// ============================================================================
// Derived-dimension helpers (kept local — does NOT extend units::lib)
// ============================================================================
//
// `units::lib` does not export spring-constant or gravitational-constant
// dimension constructors, so we build them inline from the public
// `UnitDim` struct fields.
//
//   k [N/m]   =  kg / s²      →  (mass: 1, length: 0, time: -2)
//   G [N·m²/kg²] = m³ / (kg·s²) →  (mass: -1, length: 3, time: -2)

/// Dimension of a linear spring constant (N/m = kg·s⁻²).
pub fn dim_spring_constant() -> UnitDim {
    UnitDim { mass: 1, length: 0, time: 0 - 2, temperature: 0, amount: 0, current: 0, luminosity: 0 }
}

/// Dimension of the gravitational constant (N·m²·kg⁻² = m³·kg⁻¹·s⁻²).
pub fn dim_gravitational_constant() -> UnitDim {
    UnitDim { mass: 0 - 1, length: 3, time: 0 - 2, temperature: 0, amount: 0, current: 0, luminosity: 0 }
}

// ============================================================================
// Kinetic energy
// ============================================================================

/// Computes the classical (non-relativistic) kinetic energy `E = ½ m v²`.
///
/// # Parâmetros
/// - `m`: Body mass (Quantity, dim_mass).
/// - `v`: Body velocity (Quantity, dim_velocity).
///
/// # Retorno
/// `Quantity` with dim_energy. Combined standard uncertainty `u(E)` is
/// computed via JCGM 100:2008 §5.1.5 from the relative uncertainties of
/// `m` and `v`:
///
///     u(E) / E = sqrt( (u_m / m)² + (2 u_v / v)² )
///
/// # Complexidade
/// O(1)
///
/// # Exemplo
/// ```sio
/// let ke = kinetic_energy_q(q_mass(2.0, 0.0), q_velocity(3.0, 0.0));
/// // ke.value == 9.0  (J)
/// ```
///
/// # Referências
/// - Newton, Principia (1687), Definitions II–III.
/// - JCGM 100:2008 (GUM) §5.1.5.
pub fn kinetic_energy_q(m: Quantity, v: Quantity) -> Quantity with Panic, Mut, Div {
    assert(dim_eq(m.dim, dim_mass()))
    assert(dim_eq(v.dim, dim_velocity()))
    let half = q_dimensionless(0.5, 0.0)
    let mv  = quantity_mul(m, v)
    let mv2 = quantity_mul(mv, v)
    let result = quantity_mul(half, mv2)
    assert(dim_eq(result.dim, dim_energy()))
    result
}

// ============================================================================
// Gravitational force (Newton's law of universal gravitation)
// ============================================================================
//
// CODATA 2018 (Tiesinga et al. 2021):
//   G = 6.67430(15) × 10⁻¹¹  N·m²/kg²
//   relative standard uncertainty 2.2 × 10⁻⁵
//
// We carry the central value as a `Quantity` with dim_gravitational_constant()
// and zero uncertainty (the relative u of G propagates into F as an extra
// relative-uncertainty term in quadrature; the tests below use this
// zero-u G for clean numerical checks). Callers who need the CODATA
// relative-uncertainty budget should inject u_G = 1.5e-15 explicitly.

/// Computes the Newtonian gravitational force `F = G m₁ m₂ / r²`.
///
/// # Parâmetros
/// - `m1`: First body mass (Quantity, dim_mass).
/// - `m2`: Second body mass (Quantity, dim_mass).
/// - `r`: Centre-to-centre separation (Quantity, dim_length, must be > 0).
///
/// # Retorno
/// `Quantity` with dim_force. Uses the CODATA 2018 central value of G
/// (`6.67430e-11`) with zero uncertainty here; propagate G's own
/// relative uncertainty via the input `Quantity` uncertainties if needed.
///
/// # Complexidade
/// O(1)
///
/// # Exemplo
/// ```sio
/// // 1 kg test mass at Earth's surface
/// let f = gravitational_force_q(
///     q_mass(1.0, 0.0),
///     q_mass(5.972e24, 0.0),
///     q_length(6.371e6, 0.0)
/// );
/// // f.value ≈ 9.82  (N)
/// ```
///
/// # Referências
/// - Newton (1687); Halliday, Resnick & Walker, "Fundamentals of
///   Physics" ch.13.
/// - Tiesinga et al., "CODATA 2018", Rev. Mod. Phys. 93, 025010 (2021).
///   https://doi.org/10.1103/RevModPhys.93.025010
pub fn gravitational_force_q(
    m1: Quantity,
    m2: Quantity,
    r:  Quantity
) -> Quantity with Panic, Mut, Div {
    assert(dim_eq(m1.dim, dim_mass()))
    assert(dim_eq(m2.dim, dim_mass()))
    assert(dim_eq(r.dim,  dim_length()))
    let g  = quantity_new(6.67430e-11, 0.0, dim_gravitational_constant())
    let r2 = quantity_mul(r, r)
    let gm1    = quantity_mul(g,  m1)
    let gm1m2  = quantity_mul(gm1, m2)
    let result = quantity_div(gm1m2, r2)
    assert(dim_eq(result.dim, dim_force()))
    result
}

// ============================================================================
// Hookean spring force
// ============================================================================

/// Computes the magnitude of the Hookean restoring force `|F| = k · |x|`
/// in 1D. The sign (restoring direction) is dropped — callers track it
/// from the geometry of the system.
///
/// # Parâmetros
/// - `k`: Spring constant (Quantity, dim_spring_constant = N/m = kg·s⁻²).
/// - `x`: Displacement magnitude (Quantity, dim_length).
///
/// # Retorno
/// `Quantity` with dim_force. GUM uncertainty combines multiplicatively
/// for the product `k · x`.
///
/// # Complexidade
/// O(1)
///
/// # Exemplo
/// ```sio
/// let k = quantity_new(100.0, 0.0, dim_spring_constant());
/// let f = hookean_force_q(k, q_length(0.5, 0.0));
/// // f.value == 50.0  (N)
/// ```
///
/// # Referências
/// - Hooke (1678), "De Potentia Restitutiva".
/// - https://en.wikipedia.org/wiki/Hooke%27s_law
pub fn hookean_force_q(k: Quantity, x: Quantity) -> Quantity with Panic, Mut, Div {
    assert(dim_eq(k.dim, dim_spring_constant()))
    assert(dim_eq(x.dim, dim_length()))
    let result = quantity_mul(k, x)
    assert(dim_eq(result.dim, dim_force()))
    result
}

// ============================================================================
// Work
// ============================================================================

/// Computes mechanical work `W = F · d` assuming the force and
/// displacement vectors are parallel (the dot product reduces to the
/// scalar product of magnitudes).
///
/// # Parâmetros
/// - `f`: Force (Quantity, dim_force).
/// - `d`: Displacement (Quantity, dim_length).
///
/// # Retorno
/// `Quantity` with dim_energy. Sign of `d` carries the sign of W.
///
/// # Complexidade
/// O(1)
///
/// # Exemplo
/// ```sio
/// let w = work_done_q(q_force(10.0, 0.0), q_length(5.0, 0.0));
/// // w.value == 50.0  (J)
/// ```
///
/// # Referências
/// - Goldstein, Poole & Safko, "Classical Mechanics" 3rd ed., ch.1.
pub fn work_done_q(f: Quantity, d: Quantity) -> Quantity with Panic, Mut, Div {
    assert(dim_eq(f.dim, dim_force()))
    assert(dim_eq(d.dim, dim_length()))
    let result = quantity_mul(f, d)
    assert(dim_eq(result.dim, dim_energy()))
    result
}

// ============================================================================
// Power
// ============================================================================

/// Computes average power `P = W / t`.
///
/// # Parâmetros
/// - `w`: Work done (Quantity, dim_energy).
/// - `t`: Elapsed time (Quantity, dim_time, must be > 0).
///
/// # Retorno
/// `Quantity` with dim_power = dim_energy / dim_time. GUM uncertainty
/// on `P` follows §5.1.5 for a quotient (relative uncertainties combine
/// in quadrature).
///
/// # Complexidade
/// O(1)
///
/// # Exemplo
/// ```sio
/// let p = power_q(q_energy(100.0, 0.0), q_time(2.0, 0.0));
/// // p.value == 50.0  (W)
/// ```
///
/// # Referências
/// - JCGM 100:2008 (GUM) §5.1.5 — combined uncertainty for a quotient.
pub fn power_q(w: Quantity, t: Quantity) -> Quantity with Panic, Mut, Div {
    assert(dim_eq(w.dim, dim_energy()))
    assert(dim_eq(t.dim, dim_time()))
    let result = quantity_div(w, t)
    assert(dim_eq(result.dim, dim_power()))
    result
}

// ============================================================================
// Inline tests (CONVENTIONS §5)
// ============================================================================

fn assert_close(got: f64, expected: f64, tol: f64) with Panic {
    let d = got - expected
    let ad = if d < 0.0 { 0.0 - d } else { d }
    if ad > tol {
        panic()
    }
}

fn test_kinetic_energy_1kg_10mps() with Mut, Div, Panic {
    // ½ · 1 · 10² = 50 J
    let ke = kinetic_energy_q(q_mass(1.0, 0.0), q_velocity(10.0, 0.0))
    assert(dim_eq(ke.dim, dim_energy()))
    assert_close(ke.value, 50.0, 1.0e-9)
}

fn test_hookean_force_k100_x0p5() with Mut, Div, Panic {
    // 100 N/m × 0.5 m = 50 N
    let k = quantity_new(100.0, 0.0, dim_spring_constant())
    let f = hookean_force_q(k, q_length(0.5, 0.0))
    assert(dim_eq(f.dim, dim_force()))
    assert_close(f.value, 50.0, 1.0e-9)
}

fn test_work_force10_dist5() with Mut, Div, Panic {
    // 10 N × 5 m = 50 J
    let w = work_done_q(q_force(10.0, 0.0), q_length(5.0, 0.0))
    assert(dim_eq(w.dim, dim_energy()))
    assert_close(w.value, 50.0, 1.0e-9)
}

fn test_power_energy100_time2() with Mut, Div, Panic {
    // 100 J / 2 s = 50 W
    let p = power_q(q_energy(100.0, 0.0), q_time(2.0, 0.0))
    assert(dim_eq(p.dim, dim_power()))
    assert_close(p.value, 50.0, 1.0e-9)
}

fn test_grav_force_earth_surface() with Mut, Div, Panic {
    // 1 kg test mass at Earth's mean surface:
    //   F = 6.67430e-11 · 1 · 5.972e24 / (6.371e6)² ≈ 9.82 N
    // We allow 0.5 N tolerance to absorb mean-radius vs equator choice.
    let f = gravitational_force_q(
        q_mass(1.0, 0.0),
        q_mass(5.972e24, 0.0),
        q_length(6.371e6, 0.0)
    )
    assert(dim_eq(f.dim, dim_force()))
    let d  = f.value - 9.82
    let ad = if d < 0.0 { 0.0 - d } else { d }
    assert(ad < 0.5)
}

fn test_uncertainty_propagation() with Mut, Div, Panic {
    // KE = ½ · 2 · 3² = 9 J. With non-zero u_m, u_v, GUM propagation
    // through `quantity_mul` must yield a strictly positive u_KE.
    let ke = kinetic_energy_q(q_mass(2.0, 0.1), q_velocity(3.0, 0.1))
    assert(dim_eq(ke.dim, dim_energy()))
    assert_close(ke.value, 9.0, 1.0e-9)
    assert(ke.uncertainty > 0.0)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    test_kinetic_energy_1kg_10mps()
    test_hookean_force_k100_x0p5()
    test_work_force10_dist5()
    test_power_energy100_time2()
    test_grav_force_earth_surface()
    test_uncertainty_propagation()
    0
}
