// Public compatibility bridge to checked SI lattice transport.
// The former private marginal-variance RK4 kernel is replaced by the protected
// joint-factor state. No marginal-only state can enter an integration call.
pub use physics::phonon_factor::{PhononParams,PhononState,PhononShape,PhononValue,PhononResult,phonon_workspace,phonon_default_si_params,phonon_params_status,phonon_from_factor,phonon_from_independent_initial,phonon_state_status,phonon_state_n,phonon_state_rank,phonon_state_time,phonon_concentration,phonon_factor_entry,phonon_covariance,phonon_standard_uncertainty,phonon_parameters,phonon_time_limit,phonon_rhs_jacobian_checked,phonon_step_checked,phonon_simulate_checked,phonon_close,phonon_legacy_parameters,phonon_legacy_parameters_status,phonon_from_legacy_factor,PhononBalance,phonon_balance_checked}
use collections::numeric_buffer::{NumericBuffer}
// Supplied time must match the protected state; parameters are constructor-bound.
pub fn phonon_rk4_step(t:f64,state:&!PhononState,scratch:&!NumericBuffer,dt:f64)->PhononResult with Mut,Div,Panic {
 assert(t==phonon_state_time(state))
 phonon_step_checked(state,scratch,dt)
}
pub fn phonon_simulate(state:&!PhononState,scratch:&!NumericBuffer,t_start:f64,t_end:f64,dt:f64,max_steps:i64)->PhononResult with Mut,Div,Panic {
 assert(t_start==phonon_state_time(state))
 phonon_simulate_checked(state,scratch,t_end,dt,max_steps,0)
}
// Historical flat layout retained for explicit, correlation-preserving import.
pub fn rapamycin_phonon_params()->[f64;64] with Mut,Panic {
 var p:[f64;64]=[0.0;64]
 p[0]=1e-9;p[1]=3.9e-6;p[2]=0.1;p[3]=0.003;p[4]=0.075;p[5]=5.0
 p[6]=10.0;p[7]=8.0;p[8]=1.2;p[9]=0.05;p[10]=0.30;p[11]=0.785
 p[12]=2.0;p[13]=3e-4;p[14]=1.0;p
}
