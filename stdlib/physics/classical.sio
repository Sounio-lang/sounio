// stdlib/physics/classical.sio — Classical Mechanics (real E2E, import-free gate shard)
//
// E2E contract (tests/stdlib/physics/test_foundations_science_e2e.sio):
//   newton_force_N, ke_J, position_m, classical_ok
// Import-free entrypoint: Madaros run path fails on imported modules.

module physics::classical

pub struct UnitDim {
    pub mass: i32
    pub length: i32
    pub time: i32
    pub temperature: i32
    pub amount: i32
    pub current: i32
    pub luminosity: i32
}

pub struct Quantity {
    pub value: f64
    pub uncertainty: f64
    pub dim: UnitDim
}

fn cl_udim(mass: i32, length: i32, time: i32, temperature: i32, amount: i32, current: i32, luminosity: i32) -> UnitDim {
    UnitDim {
        mass: mass,
        length: length,
        time: time,
        temperature: temperature,
        amount: amount,
        current: current,
        luminosity: luminosity,
    }
}

pub fn quantity_new(val: f64, unc: f64, dim: UnitDim) -> Quantity {
    Quantity { value: val, uncertainty: unc, dim: dim }
}

pub fn dim_mass() -> UnitDim {
    cl_udim(1 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32)
}

pub fn dim_velocity() -> UnitDim {
    cl_udim(0 as i32, 1 as i32, (0 as i32) - (1 as i32), 0 as i32, 0 as i32, 0 as i32, 0 as i32)
}

pub fn dim_acceleration() -> UnitDim {
    cl_udim(0 as i32, 1 as i32, (0 as i32) - (2 as i32), 0 as i32, 0 as i32, 0 as i32, 0 as i32)
}

fn dim_force() -> UnitDim {
    cl_udim(1 as i32, 1 as i32, (0 as i32) - (2 as i32), 0 as i32, 0 as i32, 0 as i32, 0 as i32)
}

fn dim_energy() -> UnitDim {
    cl_udim(1 as i32, 2 as i32, (0 as i32) - (2 as i32), 0 as i32, 0 as i32, 0 as i32, 0 as i32)
}

fn cl_abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn cl_f64_sub(a: f64, b: f64) -> f64 {
    if a >= b { a - b } else { b - a }
}
fn cl_check_near(a: f64, b: f64, tol: f64) -> bool { cl_f64_sub(a, b) < tol }

pub fn classical_force(mass: &Quantity, acc: &Quantity) -> Quantity with Mut, Div, Panic {
    let f_val = mass.value * acc.value;
    let abs_m = cl_abs_f64(mass.value);
    let abs_a = cl_abs_f64(acc.value);
    let rel_um = if abs_m != 0.0 { mass.uncertainty / abs_m } else { 0.0 };
    let rel_ua = if abs_a != 0.0 { acc.uncertainty / abs_a } else { 0.0 };
    let sum_rel2 = rel_um*rel_um + rel_ua*rel_ua;
    let rel_uf = if sum_rel2 <= 0.0 { 0.0 } else {
        var y = sum_rel2; var i = 0; while i < 30 { y = 0.5 * (y + sum_rel2 / y); i = i + 1; } y
    };
    let abs_f = cl_abs_f64(f_val);
    quantity_new(f_val, abs_f * rel_uf, dim_force())
}

pub fn classical_ke(mass: &Quantity, vel: &Quantity) -> Quantity {
    let v2 = vel.value * vel.value;
    let ke_val = 0.5 * mass.value * v2;
    let abs_m = cl_abs_f64(mass.value);
    let abs_v = cl_abs_f64(vel.value);
    let rel_um = if abs_m != 0.0 { mass.uncertainty / abs_m } else { 0.0 };
    let rel_uv = if abs_v != 0.0 { vel.uncertainty / abs_v } else { 0.0 };
    let rel_uke = rel_um + 2.0 * rel_uv;
    let abs_ke = cl_abs_f64(ke_val);
    quantity_new(ke_val, abs_ke * rel_uke, dim_energy())
}

pub fn classical_pos(s0: f64, us0: f64, v0: f64, uv0: f64, a: f64, ua: f64, t: f64) -> (f64, f64) {
    let s = s0 + v0*t + 0.5*a*t*t;
    let abs_t = cl_abs_f64(t);
    (s, us0 + uv0*abs_t + 0.5*ua*t*t)
}

pub fn newton_second_force_from_components(mass_val: f64, mass_std: f64, acc_val: f64, acc_std: f64) -> Quantity with Mut, Div, Panic {
    let f_val = mass_val * acc_val;
    let var_f = mass_val*mass_val * (acc_std*acc_std) + acc_val*acc_val * (mass_std*mass_std);
    let std_f = if var_f <= 0.0 { 0.0 } else {
        var y = var_f; var i = 0; while i < 30 { y = 0.5*(y + var_f / y); i = i+1; } y
    };
    quantity_new(f_val, std_f, dim_force())
}

pub fn test_newton_force_basic() -> bool with Mut, Div, Panic {
    let m = quantity_new(2.0, 0.01, dim_mass());
    let a = quantity_new(3.0, 0.02, dim_acceleration());
    let f = classical_force(&m, &a);
    cl_check_near(f.value, 6.0, 0.1)
}

pub fn test_ke() -> bool {
    let m = quantity_new(2.0, 0.0, dim_mass());
    let v = quantity_new(3.0, 0.0, dim_velocity());
    let ke = classical_ke(&m, &v);
    cl_check_near(ke.value, 9.0, 1e-9)
}

pub fn test_position_kinematics() -> bool {
    let s0 = 0.0; let us0 = 0.0; let v0 = 1.0; let uv0 = 0.0; let a = 0.5; let ua = 0.0;
    let (s, _) = classical_pos(s0, us0, v0, uv0, a, ua, 2.0);
    cl_check_near(s, 3.0, 1e-9)
}

pub fn test_force_components() -> bool with Mut, Div, Panic {
    let f = newton_second_force_from_components(2.0, 0.01, 3.0, 0.02);
    cl_check_near(f.value, 6.0, 0.1)
}

fn cl_emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC physics ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn cl_bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with Mut, Div, Panic, IO {
    var p: i32 = 0
    var f: i32 = 0
    if test_newton_force_basic() { p = p + 1 } else { f = f + 1; println("FAIL newton") }
    if test_ke() { p = p + 1 } else { f = f + 1; println("FAIL ke") }
    if test_position_kinematics() { p = p + 1 } else { f = f + 1; println("FAIL pos") }
    if test_force_components() { p = p + 1 } else { f = f + 1; println("FAIL force_comp") }

    let m = quantity_new(2.0, 0.01, dim_mass())
    let a = quantity_new(3.0, 0.02, dim_acceleration())
    let force_q = classical_force(&m, &a)
    cl_emit_metric("newton_force_N", force_q.value)

    let v = quantity_new(3.0, 0.0, dim_velocity())
    let ke_q = classical_ke(&m, &v)
    cl_emit_metric("ke_J", ke_q.value)

    let (pos_m, _) = classical_pos(0.0, 0.0, 1.0, 0.0, 0.5, 0.0, 2.0)
    cl_emit_metric("position_m", pos_m)

    let classical_ok = test_newton_force_basic() && test_ke() && test_position_kinematics() && test_force_components()
    cl_emit_metric("classical_ok", cl_bool_to_f64(classical_ok))

    if f == 0 {
        println("CLASSICAL MECHANICS REAL ALL PASS")
        print("SCIENCE_PHYSICS_OK\n")
        return 0
    }
    println("CLASSICAL FAILS")
    return f
}