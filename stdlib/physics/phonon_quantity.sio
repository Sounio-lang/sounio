// stdlib/physics/phonon_quantity.sio - Quantity-typed 64-site phonon lattice

use units::lib::{Quantity, UnitDim, quantity_new}

pub const PHONON_Q_N: i64 = 64
pub const PHONON_Q_PI: f64 = 3.14159265358979

pub struct Lattice64 {
    pub values: [f64; 64],
    pub variances: [f64; 64],
    pub n: i64,
}

pub struct PhononParams {
    pub d_eff: Quantity,
    pub dx: Quantity,
    pub k_release: Quantity,
    pub cl_site: Quantity,
    pub fu: Quantity,
    pub kp: Quantity,
    pub c_portal: Quantity,
    pub c_ha: Quantity,
    pub f_heart: Quantity,
    pub a_portal: Quantity,
    pub a_ha: Quantity,
    pub phi_ha: Quantity,
    pub c_tissue: Quantity,
    pub v_blood: Quantity,
    pub zonation: Quantity,
}

pub fn dim_rate() -> UnitDim {
    UnitDim { mass: 0, length: 0, time: 0 - 1, temperature: 0, amount: 0, current: 0, luminosity: 0 }
}

pub fn dim_diffusion() -> UnitDim {
    UnitDim { mass: 0, length: 2, time: 0 - 1, temperature: 0, amount: 0, current: 0, luminosity: 0 }
}

pub fn dim_concentration() -> UnitDim {
    UnitDim { mass: 1, length: 0 - 3, time: 0, temperature: 0, amount: 0, current: 0, luminosity: 0 }
}

pub fn q_dimensionless(value: f64, uncertainty: f64) -> Quantity {
    quantity_new(value, uncertainty, UnitDim { mass: 0, length: 0, time: 0, temperature: 0, amount: 0, current: 0, luminosity: 0 })
}

pub fn q_rate(value: f64, uncertainty: f64) -> Quantity {
    quantity_new(value, uncertainty, dim_rate())
}

pub fn q_diffusion(value: f64, uncertainty: f64) -> Quantity {
    quantity_new(value, uncertainty, dim_diffusion())
}

pub fn q_length(value: f64, uncertainty: f64) -> Quantity {
    quantity_new(value, uncertainty, UnitDim { mass: 0, length: 1, time: 0, temperature: 0, amount: 0, current: 0, luminosity: 0 })
}

pub fn q_velocity(value: f64, uncertainty: f64) -> Quantity {
    quantity_new(value, uncertainty, UnitDim { mass: 0, length: 1, time: 0 - 1, temperature: 0, amount: 0, current: 0, luminosity: 0 })
}

pub fn q_concentration_mass(value: f64, uncertainty: f64) -> Quantity {
    quantity_new(value, uncertainty, dim_concentration())
}

pub fn lattice64_zero() -> Lattice64 {
    Lattice64 { values: [0.0; 64], variances: [0.0; 64], n: PHONON_Q_N }
}

pub fn lattice64_init(value: f64, variance: f64) -> Lattice64 with Mut {
    var s = lattice64_zero()
    phonon_init_uniform_q(&!s, value, variance)
    s
}

pub fn phonon_init_uniform_q(state: &!Lattice64, value: f64, variance: f64) with Mut {
    var i: i64 = 0
    while i < PHONON_Q_N {
        state.values[i as usize] = value
        state.variances[i as usize] = variance
        i = i + 1
    }
    state.n = PHONON_Q_N
}

pub fn lattice64_spatial_average(state: &Lattice64) -> f64 with Mut, Div {
    if state.n <= 0 { return 0.0 }
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < state.n && i < PHONON_Q_N {
        sum = sum + state.values[i as usize]
        i = i + 1
    }
    sum / (state.n as f64)
}

pub fn lattice64_outflow_concentration(state: &Lattice64) -> f64 {
    if state.n <= 0 { return 0.0 }
    state.values[(state.n - 1) as usize]
}

pub fn lattice64_outflow_variance(state: &Lattice64) -> f64 {
    if state.n <= 0 { return 0.0 }
    state.variances[(state.n - 1) as usize]
}

fn phonon_q_sin(x: f64) -> f64 with Mut, Div {
    var a = x
    while a > PHONON_Q_PI { a = a - 2.0 * PHONON_Q_PI }
    while a < 0.0 - PHONON_Q_PI { a = a + 2.0 * PHONON_Q_PI }
    let num = 16.0 * a * (PHONON_Q_PI - a)
    let den = 5.0 * PHONON_Q_PI * PHONON_Q_PI - 4.0 * a * (PHONON_Q_PI - a)
    if den == 0.0 { return 0.0 }
    num / den
}

fn phonon_q_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i64 = 0
    while i < 24 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

pub fn rapamycin_phonon_params_q() -> PhononParams {
    PhononParams {
        d_eff: q_diffusion(1.0e-9, 1.0e-10),
        dx: q_length(3.9e-6, 0.1e-6),
        k_release: q_rate(0.1, 0.02),
        cl_site: q_rate(0.003, 0.0006),
        fu: q_dimensionless(0.075, 0.015),
        kp: q_dimensionless(5.0, 1.0),
        c_portal: q_concentration_mass(10.0e-6, 1.0e-6),
        c_ha: q_concentration_mass(8.0e-6, 0.8e-6),
        f_heart: q_rate(1.2, 0.1),
        a_portal: q_dimensionless(0.05, 0.01),
        a_ha: q_dimensionless(0.30, 0.06),
        phi_ha: q_dimensionless(0.785, 0.05),
        c_tissue: q_concentration_mass(2.0e-6, 0.2e-6),
        v_blood: q_velocity(3.0e-4, 0.5e-4),
        zonation: q_dimensionless(1.0, 0.0),
    }
}

pub fn pulsatile_input_q(t: f64, p: &PhononParams) -> Quantity with Mut, Div {
    let omega = 2.0 * PHONON_Q_PI * p.f_heart.value
    let portal_wave = p.c_portal.value * (1.0 + p.a_portal.value * phonon_q_sin(omega * t))
    let artery_wave = p.c_ha.value * (1.0 + p.a_ha.value * phonon_q_sin(omega * t + p.phi_ha.value))
    let value = 0.75 * portal_wave + 0.25 * artery_wave
    let up = 0.75 * p.c_portal.uncertainty
    let ua = 0.25 * p.c_ha.uncertainty
    q_concentration_mass(value, phonon_q_sqrt(up * up + ua * ua))
}

fn pulsatile_input_variance_q(t: f64, p: &PhononParams) -> f64 with Mut, Div {
    let q = pulsatile_input_q(t, p)
    let cv = 0.10
    q.uncertainty * q.uncertainty + q.value * q.value * cv * cv
}

pub fn cfl_dt_q(p: &PhononParams) -> f64 with Div {
    let dx = p.dx.value
    let d_eff = p.d_eff.value
    let v = p.v_blood.value
    let dt_diff = if d_eff > 0.0 { 0.4 * dx * dx / d_eff } else { 1.0e-4 }
    let dt_adv = if v > 0.0 { 0.8 * dx / v } else { 1.0e-4 }
    let dt_cfl = if dt_diff < dt_adv { dt_diff } else { dt_adv }
    if dt_cfl < 1.0e-4 { dt_cfl } else { 1.0e-4 }
}

fn phonon_rhs_q(t: f64, state: &Lattice64, p: &PhononParams, out: &!Lattice64) with Mut, Div {
    let n = state.n
    if n <= 0 { return }
    let dx = p.dx.value
    let dx2 = dx * dx
    if dx2 == 0.0 { return }
    let diff_coeff = p.d_eff.value / dx2
    let c_input_q = pulsatile_input_q(t, p)
    let c_input = c_input_q.value
    var i: i64 = 0
    while i < n && i < PHONON_Q_N {
        let c_i = state.values[i as usize]
        var advection: f64 = 0.0
        if p.v_blood.value > 0.0 {
            let c_upstream = if i == 0 { c_input } else { state.values[(i - 1) as usize] }
            advection = 0.0 - p.v_blood.value * (c_i - c_upstream) / dx
        }

        var diffusion: f64 = 0.0
        if i == 0 {
            let c_right = if i + 1 < n { state.values[(i + 1) as usize] } else { c_i }
            diffusion = diff_coeff * (c_input - 2.0 * c_i + c_right)
        } else if i == n - 1 {
            let c_left = state.values[(i - 1) as usize]
            diffusion = diff_coeff * (c_left - c_i)
        } else {
            let c_left = state.values[(i - 1) as usize]
            let c_right = state.values[(i + 1) as usize]
            diffusion = diff_coeff * (c_left - 2.0 * c_i + c_right)
        }

        let release = 0.0 - p.k_release.value * (c_i - p.c_tissue.value / p.kp.value)
        let cl_factor = if p.zonation.value > 1.01 {
            let frac = (i as f64) / ((n - 1) as f64)
            2.0 / (p.zonation.value + 1.0) * (1.0 + (p.zonation.value - 1.0) * frac)
        } else {
            1.0
        }
        let metabolism = 0.0 - p.cl_site.value * cl_factor * p.fu.value * c_i
        out.values[i as usize] = advection + diffusion + release + metabolism

        let var_i = state.variances[i as usize]
        var var_advect: f64 = 0.0
        if p.v_blood.value > 0.0 {
            let adv_c = p.v_blood.value / dx
            let var_up = if i == 0 { pulsatile_input_variance_q(t, p) } else { state.variances[(i - 1) as usize] }
            var_advect = adv_c * adv_c * (var_i + var_up)
        }
        var var_diff: f64 = 0.0
        if i == 0 {
            let var_right = if i + 1 < n { state.variances[(i + 1) as usize] } else { var_i }
            var_diff = diff_coeff * diff_coeff * (pulsatile_input_variance_q(t, p) + 4.0 * var_i + var_right)
        } else if i == n - 1 {
            var_diff = diff_coeff * diff_coeff * (state.variances[(i - 1) as usize] + var_i)
        } else {
            var_diff = diff_coeff * diff_coeff * (state.variances[(i - 1) as usize] + 4.0 * var_i + state.variances[(i + 1) as usize])
        }
        let var_release = p.k_release.value * p.k_release.value * var_i
        let cl_z = p.cl_site.value * cl_factor * p.fu.value
        let var_metab = cl_z * cl_z * var_i
        out.variances[i as usize] = var_advect + var_diff + var_release + var_metab
        i = i + 1
    }
    out.n = n
}

pub fn phonon_rk4_step_q(t: f64, state: &!Lattice64, p: &PhononParams, dt: f64) with Mut, Div {
    var k1 = lattice64_zero()
    var k2 = lattice64_zero()
    var k3 = lattice64_zero()
    var k4 = lattice64_zero()
    var tmp = lattice64_zero()
    let n = state.n
    phonon_rhs_q(t, state, p, &!k1)
    var i: i64 = 0
    while i < n && i < PHONON_Q_N {
        tmp.values[i as usize] = state.values[i as usize] + 0.5 * dt * k1.values[i as usize]
        tmp.variances[i as usize] = state.variances[i as usize] + 0.5 * dt * k1.variances[i as usize]
        i = i + 1
    }
    tmp.n = n
    phonon_rhs_q(t + 0.5 * dt, &tmp, p, &!k2)
    i = 0
    while i < n && i < PHONON_Q_N {
        tmp.values[i as usize] = state.values[i as usize] + 0.5 * dt * k2.values[i as usize]
        tmp.variances[i as usize] = state.variances[i as usize] + 0.5 * dt * k2.variances[i as usize]
        i = i + 1
    }
    phonon_rhs_q(t + 0.5 * dt, &tmp, p, &!k3)
    i = 0
    while i < n && i < PHONON_Q_N {
        tmp.values[i as usize] = state.values[i as usize] + dt * k3.values[i as usize]
        tmp.variances[i as usize] = state.variances[i as usize] + dt * k3.variances[i as usize]
        i = i + 1
    }
    phonon_rhs_q(t + dt, &tmp, p, &!k4)
    i = 0
    while i < n && i < PHONON_Q_N {
        state.values[i as usize] = state.values[i as usize] + (dt / 6.0) * (
            k1.values[i as usize] + 2.0 * k2.values[i as usize] + 2.0 * k3.values[i as usize] + k4.values[i as usize]
        )
        state.variances[i as usize] = state.variances[i as usize] + (dt / 6.0) * (
            k1.variances[i as usize] + 2.0 * k2.variances[i as usize] + 2.0 * k3.variances[i as usize] + k4.variances[i as usize]
        )
        if state.values[i as usize] < 0.0 { state.values[i as usize] = 0.0 }
        if state.variances[i as usize] < 0.0 { state.variances[i as usize] = 0.0 }
        i = i + 1
    }
}

pub fn phonon_simulate_q(state: &!Lattice64, p: &PhononParams, t_start: f64, t_end: f64) -> i64 with Mut, Div {
    var t = t_start
    var steps: i64 = 0
    let dt = cfl_dt_q(p)
    while t < t_end {
        let step_dt = if t + dt > t_end { t_end - t } else { dt }
        phonon_rk4_step_q(t, state, p, step_dt)
        t = t + step_dt
        steps = steps + 1
    }
    steps
}
