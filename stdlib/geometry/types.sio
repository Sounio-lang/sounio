// stdlib/geometry/types.sio
//
// Basic geometry types with f64 coordinates.

struct Point2D {
    x: f64,
    y: f64,
}

fn point2d_new(x: f64, y: f64) -> Point2D {
    Point2D { x: x, y: y }
}

fn point2d_add(a: Point2D, b: Point2D) -> Point2D {
    Point2D { x: a.x + b.x, y: a.y + b.y }
}

fn point2d_sub(a: Point2D, b: Point2D) -> Point2D {
    Point2D { x: a.x - b.x, y: a.y - b.y }
}

fn point2d_dot(a: Point2D, b: Point2D) -> f64 {
    a.x * b.x + a.y * b.y
}

struct Point3D {
    x: f64,
    y: f64,
    z: f64,
}

fn point3d_new(x: f64, y: f64, z: f64) -> Point3D {
    Point3D { x: x, y: y, z: z }
}

fn point3d_add(a: Point3D, b: Point3D) -> Point3D {
    Point3D { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

fn point3d_sub(a: Point3D, b: Point3D) -> Point3D {
    Point3D { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
}

fn point3d_dot(a: Point3D, b: Point3D) -> f64 {
    a.x * b.x + a.y * b.y + a.z * b.z
}

fn point3d_cross(a: Point3D, b: Point3D) -> Point3D {
    Point3D {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x,
    }
}

// 3x3 matrix stored as 9 f64 fields
struct Matrix3 {
    m00: f64, m01: f64, m02: f64,
    m10: f64, m11: f64, m12: f64,
    m20: f64, m21: f64, m22: f64,
}

fn matrix3_identity() -> Matrix3 {
    Matrix3 {
        m00: 1.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0,
    }
}

fn matrix3_mul_vec(m: Matrix3, v: Point3D) -> Point3D {
    Point3D {
        x: m.m00 * v.x + m.m01 * v.y + m.m02 * v.z,
        y: m.m10 * v.x + m.m11 * v.y + m.m12 * v.z,
        z: m.m20 * v.x + m.m21 * v.y + m.m22 * v.z,
    }
}
