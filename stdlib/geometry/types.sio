//! stdlib/geometry/types
//!
//! Tipos básicos de geometria com coordenadas epistêmicas (Knowledge<f64>).

import epistemic::Knowledge;

pub type Coord = Knowledge<f64>;

// Point2D
pub struct Point2D {
    pub x: Coord,
    pub y: Coord,
}

impl Point2D {
    pub fn new(x: f64, y: f64) -> Self {
        Self {
            x: Knowledge::known(x),
            y: Knowledge::known(y),
        }
    }

    pub fn add(self, other: Self) -> Self {
        Self {
            x: self.x + other.x,
            y: self.y + other.y,
        }
    }

    pub fn sub(self, other: Self) -> Self {
        Self {
            x: self.x - other.x,
            y: self.y - other.y,
        }
    }

    pub fn dot(self, other: Self) -> Coord {
        self.x * other.x + self.y * other.y
    }
}

// Vec2
pub struct Vec2 {
    pub x: Coord,
    pub y: Coord,
}

impl Vec2 {
    pub fn new(x: f64, y: f64) -> Self {
        Self {
            x: Knowledge::known(x),
            y: Knowledge::known(y),
        }
    }

    pub fn add(self, other: Self) -> Self {
        Self {
            x: self.x + other.x,
            y: self.y + other.y,
        }
    }

    pub fn sub(self, other: Self) -> Self {
        Self {
            x: self.x - other.x,
            y: self.y - other.y,
        }
    }

    pub fn dot(self, other: Self) -> Coord {
        self.x * other.x + self.y * other.y
    }
}

// Point3D
pub struct Point3D {
    pub x: Coord,
    pub y: Coord,
    pub z: Coord,
}

impl Point3D {
    pub fn new(x: f64, y: f64, z: f64) -> Self {
        Self {
            x: Knowledge::known(x),
            y: Knowledge::known(y),
            z: Knowledge::known(z),
        }
    }

    pub fn add(self, other: Self) -> Self {
        Self {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
        }
    }

    pub fn sub(self, other: Self) -> Self {
        Self {
            x: self.x - other.x,
            y: self.y - other.y,
            z: self.z - other.z,
        }
    }

    pub fn dot(self, other: Self) -> Coord {
        self.x * other.x + self.y * other.y + self.z * other.z
    }
}

// Vec3
pub struct Vec3 {
    pub x: Coord,
    pub y: Coord,
    pub z: Coord,
}

impl Vec3 {
    pub fn new(x: f64, y: f64, z: f64) -> Self {
        Self {
            x: Knowledge::known(x),
            y: Knowledge::known(y),
            z: Knowledge::known(z),
        }
    }

    pub fn add(self, other: Self) -> Self {
        Self {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
        }
    }

    pub fn sub(self, other: Self) -> Self {
        Self {
            x: self.x - other.x,
            y: self.y - other.y,
            z: self.z - other.z,
        }
    }

    pub fn dot(self, other: Self) -> Coord {
        self.x * other.x + self.y * other.y + self.z * other.z
    }

    pub fn cross(self, other: Self) -> Self {
        Self {
            x: self.y * other.z - self.z * other.y,
            y: self.z * other.x - self.x * other.z,
            z: self.x * other.y - self.y * other.x,
        }
    }
}

// Matrix3
pub struct Matrix3 {
    pub m00: Coord,
    pub m01: Coord,
    pub m02: Coord,
    pub m10: Coord,
    pub m11: Coord,
    pub m12: Coord,
    pub m20: Coord,
    pub m21: Coord,
    pub m22: Coord,
}

impl Matrix3 {
    pub fn identity() -> Self {
        Self {
            m00: Knowledge::known(1.0), m01: Knowledge::known(0.0), m02: Knowledge::known(0.0),
            m10: Knowledge::known(0.0), m11: Knowledge::known(1.0), m12: Knowledge::known(0.0),
            m20: Knowledge::known(0.0), m21: Knowledge::known(0.0), m22: Knowledge::known(1.0),
        }
    }
}
