//! stdlib/test/assert.sio — Rich assertion utilities
//!
//! Provides panicking assertions for i32, i64, f64, and bool types.
//! Each assertion function declares `with Panic` and aborts on failure.

// ============================================================================
// Helper
// ============================================================================

fn assert_abs_val(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// ============================================================================
// Assertions
// ============================================================================

fn assert_eq_i32(a: i32, b: i32) with Panic {
    if a != b {
        panic("assert_eq_i32 failed")
    }
}

fn assert_eq_i64(a: i64, b: i64) with Panic {
    if a != b {
        panic("assert_eq_i64 failed")
    }
}

fn assert_eq_f64(a: f64, b: f64, tol: f64) with Panic {
    let diff = assert_abs_val(a - b)
    if diff > tol {
        panic("assert_eq_f64 failed: difference exceeds tolerance")
    }
}

fn assert_true(v: bool) with Panic {
    if !v {
        panic("assert_true failed")
    }
}

fn assert_false(v: bool) with Panic {
    if v {
        panic("assert_false failed")
    }
}

// ============================================================================
// Additional assertions
// ============================================================================

fn assert_ne_i32(a: i32, b: i32) with Panic {
    if a == b {
        panic("assert_ne_i32 failed")
    }
}

fn assert_ne_i64(a: i64, b: i64) with Panic {
    if a == b {
        panic("assert_ne_i64 failed")
    }
}

fn assert_gt_i64(a: i64, b: i64) with Panic {
    if a <= b {
        panic("assert_gt_i64 failed")
    }
}

fn assert_ge_i64(a: i64, b: i64) with Panic {
    if a < b {
        panic("assert_ge_i64 failed")
    }
}

fn assert_lt_i64(a: i64, b: i64) with Panic {
    if a >= b {
        panic("assert_lt_i64 failed")
    }
}

fn assert_le_i64(a: i64, b: i64) with Panic {
    if a > b {
        panic("assert_le_i64 failed")
    }
}

fn assert_in_range_i64(x: i64, lo: i64, hi: i64) with Panic {
    if x < lo {
        panic("assert_in_range_i64 failed: below lower bound")
    }
    if x > hi {
        panic("assert_in_range_i64 failed: above upper bound")
    }
}

fn assert_in_range_f64(x: f64, lo: f64, hi: f64) with Panic {
    if x < lo {
        panic("assert_in_range_f64 failed: below lower bound")
    }
    if x > hi {
        panic("assert_in_range_f64 failed: above upper bound")
    }
}

// ============================================================================
// TEST — all assertion types
// ============================================================================

fn assert_test_all() -> i32 with Panic {
    // i32 equality
    assert_eq_i32(5, 5)
    assert_ne_i32(3, 4)

    // i64 equality
    assert_eq_i64(100, 100)
    assert_ne_i64(100, 200)

    // i64 comparisons
    assert_gt_i64(10, 5)
    assert_ge_i64(10, 10)
    assert_lt_i64(5, 10)
    assert_le_i64(10, 10)
    assert_in_range_i64(5, 1, 10)

    // f64 approximate equality
    assert_eq_f64(3.14, 3.14, 0.001)
    assert_eq_f64(1.0, 1.0000001, 0.001)
    assert_in_range_f64(5.5, 5.0, 6.0)

    // bool
    assert_true(true)
    assert_false(false)
    assert_true(5 > 3)
    assert_false(3 > 5)

    return 0
}
