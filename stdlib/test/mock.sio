//! stdlib/test/mock.sio — Mock/spy test utilities
//!
//! Records function calls with arguments and return values for verification.
//! Uses by-value struct passing to avoid borrow checker issues.

// ============================================================================
// TYPES
// ============================================================================

struct MockCall {
    fn_id: i32,
    arg1: i64,
    arg2: i64,
    ret: i64,
}

struct MockLog {
    calls: [MockCall; 64],
    count: i32,
}

// ============================================================================
// API
// ============================================================================

fn mock_call_new(fn_id: i32, a1: i64, a2: i64, ret: i64) -> MockCall {
    MockCall { fn_id: fn_id, arg1: a1, arg2: a2, ret: ret }
}

fn mock_log_new() -> MockLog {
    let empty_call = MockCall { fn_id: 0, arg1: 0, arg2: 0, ret: 0 }
    let calls: [MockCall; 64] = [empty_call; 64]
    MockLog { calls: calls, count: 0 }
}

fn mock_log_record(log: MockLog, fn_id: i32, a1: i64, a2: i64, ret: i64) -> MockLog {
    var out = log
    if out.count < 64 {
        out.calls[out.count] = MockCall { fn_id: fn_id, arg1: a1, arg2: a2, ret: ret }
        out.count = out.count + 1
    }
    return out
}

fn mock_log_count(log: MockLog, fn_id: i32) -> i32 {
    var n: i32 = 0
    var i: i32 = 0
    while i < log.count {
        if log.calls[i].fn_id == fn_id {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn mock_log_total(log: MockLog) -> i32 {
    return log.count
}

fn mock_log_get(log: MockLog, idx: i32) -> MockCall {
    if idx >= 0 && idx < log.count {
        return log.calls[idx]
    }
    return MockCall { fn_id: 0, arg1: 0, arg2: 0, ret: 0 }
}

fn mock_log_last_ret(log: MockLog, fn_id: i32) -> i64 {
    var i: i32 = log.count - 1
    while i >= 0 {
        if log.calls[i].fn_id == fn_id {
            return log.calls[i].ret
        }
        i = i - 1
    }
    return 0
}

fn mock_log_clear(log: MockLog) -> MockLog {
    var out = log
    out.count = 0
    return out
}

// ============================================================================
// TEST — record 3 calls, verify count and args
// ============================================================================

fn mock_test() -> i32 {
    var log = mock_log_new()

    // Record 3 calls: fn_id=1 twice, fn_id=2 once
    log = mock_log_record(log, 1, 10, 20, 30)
    log = mock_log_record(log, 1, 40, 50, 60)
    log = mock_log_record(log, 2, 100, 200, 300)

    // Verify total count
    if mock_log_total(log) != 3 { return 1 }

    // Verify per-function count
    if mock_log_count(log, 1) != 2 { return 2 }
    if mock_log_count(log, 2) != 1 { return 3 }

    // Verify first call args
    let c0 = mock_log_get(log, 0)
    if c0.fn_id != 1 { return 4 }
    if c0.arg1 != 10 { return 5 }
    if c0.arg2 != 20 { return 6 }
    if c0.ret != 30 { return 7 }

    // Verify third call args
    let c2 = mock_log_get(log, 2)
    if c2.fn_id != 2 { return 8 }
    if c2.arg1 != 100 { return 9 }
    if c2.ret != 300 { return 10 }

    // Verify last return for fn_id=1
    if mock_log_last_ret(log, 1) != 60 { return 11 }

    // Verify clear
    let cleared = mock_log_clear(log)
    if mock_log_total(cleared) != 0 { return 12 }

    return 0
}
