//! stdlib/test/helpers.sio - Simple test helpers for numerical comparisons
//!
//! This module provides simple helper functions for test files that work
//! with the current Sounio compiler without requiring advanced features.
//!
//! # Usage
//!
//! ```sio
//! use test::helpers::*
//!
//! fn run_tests() -> i32 {
//!     var pass = 0
//!     var fail = 0
//!
//!     if check_near(compute(), expected, 1e-6) {
//!         pass = pass + 1
//!     } else {
//!         fail = fail + 1
//!     }
//!
//!     if fail > 0 { return 1 }
//!     return 0
//! }
//! ```

// ============================================================================
// Floating-point comparison helpers (f64)
// ============================================================================

/// Check if two f64 values are within tolerance (absolute difference)
pub fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

/// Check if two f64 values are within relative tolerance
pub fn check_near_relative(a: f64, b: f64, rtol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    let max_abs = if a > b { a } else { b }
    if max_abs < 1e-300 {
        ad < rtol
    } else {
        ad < rtol * max_abs
    }
}

/// Check if two f64 values are approximately equal (default tolerance 1e-9)
pub fn check_approx(a: f64, b: f64) -> bool {
    check_near(a, b, 1e-9)
}

/// Check if an f64 value is close to zero
pub fn check_near_zero(x: f64, tol: f64) -> bool {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    ax < tol
}

/// Check if an f64 value is NaN-like (NaN or very large)
pub fn check_nan_like(x: f64) -> bool {
    x != x
}

// ============================================================================
// Floating-point comparison helpers (f32)
// ============================================================================

/// Check if two f32 values are within tolerance (absolute difference)
pub fn check_near_f32(a: f32, b: f32, tol: f32) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

/// Check if two f32 values are approximately equal (default tolerance 1e-5)
pub fn check_approx_f32(a: f32, b: f32) -> bool {
    check_near_f32(a, b, 1e-5)
}

// ============================================================================
// Integer comparison helpers
// ============================================================================

/// Check if two i64 values are equal
pub fn check_eq_i64(a: i64, b: i64) -> bool {
    a == b
}

/// Check if two i32 values are equal
pub fn check_eq_i32(a: i32, b: i32) -> bool {
    a == b
}

/// Check if an i64 value is within a range (inclusive)
pub fn check_in_range_i64(x: i64, lo: i64, hi: i64) -> bool {
    x >= lo && x <= hi
}

// ============================================================================
// Test runner helpers
// ============================================================================

/// Simple test result accumulator
pub struct TestResult {
    pub pass: i32,
    pub fail: i32,
}

/// Create a new test result
pub fn test_result_new() -> TestResult {
    TestResult { pass: 0, fail: 0 }
}

/// Record a passing test
pub fn test_pass(r: &!TestResult) {
    r.pass = r.pass + 1
}

/// Record a failing test
pub fn test_fail(r: &!TestResult) {
    r.fail = r.fail + 1
}

/// Check if all tests passed
pub fn test_all_passed(r: &TestResult) -> bool {
    r.fail == 0
}

/// Get exit code (0 for pass, 1 for fail)
pub fn test_exit_code(r: &TestResult) -> i32 {
    if r.fail > 0 { 1 } else { 0 }
}

/// Print test summary
pub fn test_print_summary(r: &TestResult) with IO {
    print("Passed: ")
    print(r.pass)
    print(" Failed: ")
    print(r.fail)
    print("\n")
}

// ============================================================================
// Assertion helpers (return bool instead of panicking)
// ============================================================================

/// Assert-like helper that returns bool for use in test accumulator pattern
pub fn assert_near(a: f64, b: f64, tol: f64, name: string) -> bool with IO {
    if check_near(a, b, tol) {
        print("PASS: ")
        print(name)
        print("\n")
        true
    } else {
        print("FAIL: ")
        print(name)
        print(" (expected ~")
        print(b)
        print(", got ")
        print(a)
        print(")\n")
        false
    }
}

/// Assert-like helper for exact equality
pub fn assert_eq_i64(a: i64, b: i64, name: string) -> bool with IO {
    if a == b {
        print("PASS: ")
        print(name)
        print("\n")
        true
    } else {
        print("FAIL: ")
        print(name)
        print(" (expected ")
        print(b)
        print(", got ")
        print(a)
        print(")\n")
        false
    }
}
