// stdlib/test/assert_advanced.sio — Advanced Assertion Utilities
//
// Provides:
//   - SoftAssertions: collect deferred failures, report at end
//   - AsserterF64: fluent assertions for f64 values
//   - AsserterI64: fluent assertions for i64 values
//   - AsserterBool: fluent assertions for bool values
//
// Design: no panics — all functions return bool (true=pass) or i64 (0=pass).
// Callers inspect return values or use soft_assert_all to bulk-check.

// ============================================================================
// Math helpers
// ============================================================================

fn assert_abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// ============================================================================
// SoftAssertions — collect up to 64 deferred failures
// ============================================================================

struct SoftAssertions {
    messages: [string; 64],
    count: i64,
    label: string
}

/// Create a new empty SoftAssertions collector.
pub fn soft_assertions_new() -> SoftAssertions {
    SoftAssertions {
        messages: [""; 64],
        count: 0,
        label: ""
    }
}

/// Create a labeled SoftAssertions collector.
pub fn soft_assertions_labeled(label: string) -> SoftAssertions {
    SoftAssertions {
        messages: [""; 64],
        count: 0,
        label: label
    }
}

/// Assert that |got - expected| <= tol. Records failure if not.
pub fn soft_assert_near_f64(sa: &!SoftAssertions, got: f64, expected: f64, tol: f64, msg: string) with Mut, Panic {
    let diff = assert_abs_f64(got - expected)
    if diff <= tol { return }
    if sa.count < 64 {
        sa.messages[sa.count as usize] = msg
        sa.count = sa.count + 1
    }
}

/// Assert that got == expected (i64). Records failure if not.
pub fn soft_assert_eq_i64(sa: &!SoftAssertions, got: i64, expected: i64, msg: string) with Mut, Panic {
    if got == expected { return }
    if sa.count < 64 {
        sa.messages[sa.count as usize] = msg
        sa.count = sa.count + 1
    }
}

/// Assert that cond is true. Records failure if not.
pub fn soft_assert_true(sa: &!SoftAssertions, cond: bool, msg: string) with Mut, Panic {
    if cond { return }
    if sa.count < 64 {
        sa.messages[sa.count as usize] = msg
        sa.count = sa.count + 1
    }
}

/// Assert that cond is false. Records failure if not.
pub fn soft_assert_false(sa: &!SoftAssertions, cond: bool, msg: string) with Mut, Panic {
    if !cond { return }
    if sa.count < 64 {
        sa.messages[sa.count as usize] = msg
        sa.count = sa.count + 1
    }
}

/// Assert that lo <= x <= hi. Records failure if not.
pub fn soft_assert_in_range_f64(sa: &!SoftAssertions, x: f64, lo: f64, hi: f64, msg: string) with Mut, Panic {
    if x >= lo && x <= hi { return }
    if sa.count < 64 {
        sa.messages[sa.count as usize] = msg
        sa.count = sa.count + 1
    }
}

/// Assert that x > 0.0. Records failure if not.
pub fn soft_assert_positive(sa: &!SoftAssertions, x: f64, msg: string) with Mut, Panic {
    if x > 0.0 { return }
    if sa.count < 64 {
        sa.messages[sa.count as usize] = msg
        sa.count = sa.count + 1
    }
}

/// Assert that x >= 0.0. Records failure if not.
pub fn soft_assert_non_negative(sa: &!SoftAssertions, x: f64, msg: string) with Mut, Panic {
    if x >= 0.0 { return }
    if sa.count < 64 {
        sa.messages[sa.count as usize] = msg
        sa.count = sa.count + 1
    }
}

/// Returns the number of recorded failures.
pub fn soft_assert_count(sa: SoftAssertions) -> i64 {
    sa.count
}

/// Print all failures and return 0 if all passed, failure count otherwise.
pub fn soft_assert_all(sa: SoftAssertions) -> i64 with IO, Mut, Div, Panic {
    if sa.count == 0 { return 0 }
    if sa.label != "" {
        println("SoftAssertions [", sa.label, "]: ", sa.count, " failure(s)")
    } else {
        println("SoftAssertions: ", sa.count, " failure(s)")
    }
    var i: i64 = 0
    while i < sa.count && i < 64 {
        println("  FAIL[", i, "]: ", sa.messages[i as usize])
        i = i + 1
    }
    sa.count
}

// ============================================================================
// AsserterF64 — fluent asserter for f64
// ============================================================================

struct AsserterF64 { value: f64, description: string }

/// Create an f64 asserter for the given value.
pub fn asserter_f64(x: f64) -> AsserterF64 {
    AsserterF64 { value: x, description: "" }
}

/// Set a description for this asserter (returned in failure messages).
pub fn asserter_f64_described_as(a: AsserterF64, desc: string) -> AsserterF64 {
    AsserterF64 { value: a.value, description: desc }
}

/// Assert that value == expected (exact equality). Returns true if passed.
pub fn asserter_f64_is_equal_to(a: AsserterF64, expected: f64) -> bool with IO {
    if a.value == expected { return true }
    println("FAIL: [", a.description, "] expected ", expected, " but got ", a.value)
    false
}

/// Assert that |value - expected| <= tol. Returns true if passed.
pub fn asserter_f64_is_near(a: AsserterF64, expected: f64, tol: f64) -> bool with IO {
    let diff = assert_abs_f64(a.value - expected)
    if diff <= tol { return true }
    println("FAIL: [", a.description, "] expected near ", expected, " (tol=", tol, ") but got ", a.value, " (diff=", diff, ")")
    false
}

/// Assert that value > bound. Returns true if passed.
pub fn asserter_f64_is_greater_than(a: AsserterF64, bound: f64) -> bool with IO {
    if a.value > bound { return true }
    println("FAIL: [", a.description, "] expected > ", bound, " but got ", a.value)
    false
}

/// Assert that value < bound. Returns true if passed.
pub fn asserter_f64_is_less_than(a: AsserterF64, bound: f64) -> bool with IO {
    if a.value < bound { return true }
    println("FAIL: [", a.description, "] expected < ", bound, " but got ", a.value)
    false
}

/// Assert that lo <= value <= hi. Returns true if passed.
pub fn asserter_f64_is_in_range(a: AsserterF64, lo: f64, hi: f64) -> bool with IO {
    if a.value >= lo && a.value <= hi { return true }
    println("FAIL: [", a.description, "] expected in [", lo, ", ", hi, "] but got ", a.value)
    false
}

/// Assert that value > 0.0. Returns true if passed.
pub fn asserter_f64_is_positive(a: AsserterF64) -> bool with IO {
    if a.value > 0.0 { return true }
    println("FAIL: [", a.description, "] expected positive but got ", a.value)
    false
}

/// Assert that value >= 0.0. Returns true if passed.
pub fn asserter_f64_is_non_negative(a: AsserterF64) -> bool with IO {
    if a.value >= 0.0 { return true }
    println("FAIL: [", a.description, "] expected non-negative but got ", a.value)
    false
}

// ============================================================================
// AsserterI64 — fluent asserter for i64
// ============================================================================

struct AsserterI64 { value: i64, description: string }

/// Create an i64 asserter for the given value.
pub fn asserter_i64(x: i64) -> AsserterI64 {
    AsserterI64 { value: x, description: "" }
}

/// Set a description for this asserter.
pub fn asserter_i64_described_as(a: AsserterI64, desc: string) -> AsserterI64 {
    AsserterI64 { value: a.value, description: desc }
}

/// Assert that value == expected. Returns true if passed.
pub fn asserter_i64_is_equal_to(a: AsserterI64, expected: i64) -> bool with IO {
    if a.value == expected { return true }
    println("FAIL: [", a.description, "] expected ", expected, " but got ", a.value)
    false
}

/// Assert that value > bound. Returns true if passed.
pub fn asserter_i64_is_greater_than(a: AsserterI64, bound: i64) -> bool with IO {
    if a.value > bound { return true }
    println("FAIL: [", a.description, "] expected > ", bound, " but got ", a.value)
    false
}

/// Assert that value < bound. Returns true if passed.
pub fn asserter_i64_is_less_than(a: AsserterI64, bound: i64) -> bool with IO {
    if a.value < bound { return true }
    println("FAIL: [", a.description, "] expected < ", bound, " but got ", a.value)
    false
}

/// Assert that lo <= value <= hi. Returns true if passed.
pub fn asserter_i64_is_in_range(a: AsserterI64, lo: i64, hi: i64) -> bool with IO {
    if a.value >= lo && a.value <= hi { return true }
    println("FAIL: [", a.description, "] expected in [", lo, ", ", hi, "] but got ", a.value)
    false
}

/// Assert that value >= 0. Returns true if passed.
pub fn asserter_i64_is_non_negative(a: AsserterI64) -> bool with IO {
    if a.value >= 0 { return true }
    println("FAIL: [", a.description, "] expected non-negative but got ", a.value)
    false
}

// ============================================================================
// AsserterBool — fluent asserter for bool
// ============================================================================

struct AsserterBool { value: bool, description: string }

/// Create a bool asserter for the given value.
pub fn asserter_bool(x: bool) -> AsserterBool {
    AsserterBool { value: x, description: "" }
}

/// Set a description for this asserter.
pub fn asserter_bool_described_as(a: AsserterBool, desc: string) -> AsserterBool {
    AsserterBool { value: a.value, description: desc }
}

/// Assert that value is true. Returns true if passed.
pub fn asserter_bool_is_true(a: AsserterBool) -> bool with IO {
    if a.value { return true }
    println("FAIL: [", a.description, "] expected true but got false")
    false
}

/// Assert that value is false. Returns true if passed.
pub fn asserter_bool_is_false(a: AsserterBool) -> bool with IO {
    if !a.value { return true }
    println("FAIL: [", a.description, "] expected false but got true")
    false
}
