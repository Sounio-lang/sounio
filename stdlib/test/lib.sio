// test — Testing utilities and assertion framework
//
// Rich assertions (panicking and soft/deferred), fluent asserters for f64/i64/bool,
// numerical comparison helpers, mock/spy utilities, and property-based testing.
//
// Submodules:
//   assert          — Panicking assertions: assert_eq_i32, assert_eq_i64, assert_eq_f64, assert_true, assert_false
//   assert_advanced — Soft assertions (deferred), fluent AsserterF64/AsserterI64/AsserterBool
//   helpers         — Numerical comparison: check_near, check_approx, check_eq_i64, TestResult
//   mock            — Mock/spy call recording: MockCall, MockLog
//   prop            — Property-based testing with LCG PRNG: PropRng, prop_range_value

pub use helpers::{
    check_near, check_near_relative, check_approx, check_near_zero,
    check_nan_like, check_near_f32, check_approx_f32,
    check_eq_i64, check_eq_i32, check_in_range_i64,
    TestResult, test_result_new, test_pass, test_fail,
    test_all_passed, test_exit_code, test_print_summary,
    assert_near, assert_eq_i64,
}

pub use assert_advanced::{
    SoftAssertions,
    soft_assertions_new, soft_assertions_labeled,
    soft_assert_near_f64, soft_assert_eq_i64,
    soft_assert_true, soft_assert_false,
    soft_assert_in_range_f64, soft_assert_positive, soft_assert_non_negative,
    soft_assert_count, soft_assert_all,
    asserter_f64, asserter_f64_described_as,
    asserter_f64_is_equal_to, asserter_f64_is_near,
    asserter_f64_is_greater_than, asserter_f64_is_less_than,
    asserter_f64_is_in_range, asserter_f64_is_positive, asserter_f64_is_non_negative,
    asserter_i64, asserter_i64_described_as,
    asserter_i64_is_equal_to, asserter_i64_is_greater_than,
    asserter_i64_is_less_than, asserter_i64_is_in_range, asserter_i64_is_non_negative,
    asserter_bool, asserter_bool_described_as,
    asserter_bool_is_true, asserter_bool_is_false,
}
