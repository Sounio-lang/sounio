// Sounio MedLang: Three-Compartment PK Models
//
// Extension of the two-compartment model with a deep tissue (second peripheral)
// compartment. Commonly used for drugs exhibiting tri-exponential disposition
// kinetics (e.g., aminoglycosides, thiopental, methotrexate).
//
// Reference:
//   Gabrielsson & Weiner (2000), "Pharmacokinetic and Pharmacodynamic Data Analysis"
//   Rowland & Tozer (2011), "Clinical Pharmacokinetics and Pharmacodynamics"

// Three-compartment IV bolus model
//
// Compartments:
//   Central      — plasma / highly perfused tissues (V1)
//   Peripheral1  — rapidly equilibrating tissue (V2)
//   Peripheral2  — slowly equilibrating deep tissue (V3)
//
// Micro-rate constants:
//   k10 = CL / V1      (elimination from central)
//   k12 = Q2 / V1       (central → peripheral1)
//   k21 = Q2 / V2       (peripheral1 → central)
//   k13 = Q3 / V1       (central → peripheral2)
//   k31 = Q3 / V3       (peripheral2 → central)
model ThreeCompartmentIV {
    // Parameters with inter-individual variability
    param CL: Knowledge<L/h> ~ LogNormal(mean: 5.0 L/h, omega: 0.30)
    param V1: Knowledge<L> ~ LogNormal(mean: 10.0 L, omega: 0.25)
    param V2: Knowledge<L> ~ LogNormal(mean: 20.0 L, omega: 0.35)
    param V3: Knowledge<L> ~ LogNormal(mean: 200.0 L, omega: 0.40)
    param Q2: Knowledge<L/h> ~ LogNormal(mean: 10.0 L/h, omega: 0.30)
    param Q3: Knowledge<L/h> ~ LogNormal(mean: 2.0 L/h, omega: 0.50)

    // Compartments
    compartment Central {
        volume: V1
    }

    compartment Peripheral1 {
        volume: V2
    }

    compartment Peripheral2 {
        volume: V3
    }

    // Flows
    flow Central -> Elimination {
        rate: CL
    }

    flow Central <-> Peripheral1 {
        rate: Q2
    }

    flow Central <-> Peripheral2 {
        rate: Q3
    }

    // IV bolus into Central
    dose IV {
        into: Central
    }

    // Observable: central compartment concentration
    observe Cp: Concentration = Central.concentration
}

// Three-compartment model with first-order oral absorption
//
// Adds a Gut (depot) compartment with absorption rate constant ka
// and bioavailability F. Drug enters Gut -> Central -> disposition.
model ThreeCompartmentOral {
    param ka: Knowledge<1/h> ~ LogNormal(mean: 1.5 1/h, omega: 0.40)
    param CL: Knowledge<L/h> ~ LogNormal(mean: 5.0 L/h, omega: 0.30)
    param V1: Knowledge<L> ~ LogNormal(mean: 10.0 L, omega: 0.25)
    param V2: Knowledge<L> ~ LogNormal(mean: 20.0 L, omega: 0.35)
    param V3: Knowledge<L> ~ LogNormal(mean: 200.0 L, omega: 0.40)
    param Q2: Knowledge<L/h> ~ LogNormal(mean: 10.0 L/h, omega: 0.30)
    param Q3: Knowledge<L/h> ~ LogNormal(mean: 2.0 L/h, omega: 0.50)
    param F: Knowledge<fraction> ~ Beta(mean: 0.75, alpha: 2.0, beta: 0.67)

    compartment Gut {
        transit_time: 1.0 / ka
    }

    compartment Central {
        volume: V1
    }

    compartment Peripheral1 {
        volume: V2
    }

    compartment Peripheral2 {
        volume: V3
    }

    // Flows
    flow Gut -> Central {
        rate: ka * F
    }

    flow Central -> Elimination {
        rate: CL
    }

    flow Central <-> Peripheral1 {
        rate: Q2
    }

    flow Central <-> Peripheral2 {
        rate: Q3
    }

    dose Oral {
        into: Gut
    }

    observe Cp: Concentration = Central.concentration
}
