// stdlib/medlang/pk/three_compartment.sio
//
// Three-compartment pharmacokinetic model — Sounio
//
// Tri-exponential: C(t) = A*exp(-alpha*t) + B*exp(-beta*t) + G*exp(-gamma*t)
// Eigenvalues from cubic characteristic equation of micro-constant matrix

// ============================================================================
// Helpers
// ============================================================================

fn pk3_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn pk3_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn pk3_exp(x: f64) -> f64 with Mut, Div, Panic {
    var xc = x
    if xc > 20.0 { xc = 20.0 }
    if xc < -20.0 { xc = -20.0 }
    var result = 1.0
    var term = 1.0
    var i = 1
    while i <= 30 {
        term = term * xc / i as f64
        result = result + term
        i = i + 1
    }
    if result < 1.0e-15 { result = 1.0e-15 }
    result
}

fn pk3_cos(x: f64) -> f64 with Mut, Div, Panic {
    // cos via Taylor series
    var xc = x
    // Reduce to [-pi, pi]
    while xc > 3.14159265358979 { xc = xc - 6.28318530717959 }
    while xc < -3.14159265358979 { xc = xc + 6.28318530717959 }
    var result = 1.0
    var term = 1.0
    var i = 1
    while i <= 15 {
        term = 0.0 - term * xc * xc / ((2 * i - 1) as f64 * (2 * i) as f64)
        result = result + term
        i = i + 1
    }
    result
}

fn pk3_cbrt(x: f64) -> f64 with Mut, Div, Panic {
    // Cube root via Newton's method: y^3 = x => y = y - (y^3 - x)/(3*y^2)
    if pk3_abs(x) < 1.0e-30 { return 0.0 }
    var sign = 1.0
    var v = x
    if v < 0.0 {
        sign = -1.0
        v = 0.0 - v
    }
    var y = v
    if y > 1.0 { y = y / 3.0 }
    var i = 0
    while i < 30 {
        let y2 = y * y
        if y2 < 1.0e-30 { return 0.0 }
        y = y - (y * y2 - v) / (3.0 * y2)
        if y < 1.0e-30 { y = 1.0e-30 }
        i = i + 1
    }
    sign * y
}

fn pk3_acos(x: f64) -> f64 with Mut, Div, Panic {
    // acos approximation
    var xc = x
    if xc > 1.0 { xc = 1.0 }
    if xc < -1.0 { xc = -1.0 }
    // acos(x) ≈ pi/2 - asin(x), asin via series
    let x2 = xc * xc
    var term = xc
    var sum = xc
    var n = 1
    while n <= 15 {
        term = term * x2 * (2 * n - 1) as f64 * (2 * n - 1) as f64 / ((2 * n) as f64 * (2 * n + 1) as f64)
        sum = sum + term
        n = n + 1
    }
    1.5707963267948966 - sum
}

// ============================================================================
// Three-compartment parameters
// ============================================================================

struct ThreeCompParams {
    k10: f64,   // elimination from central
    k12: f64,   // central -> shallow peripheral
    k21: f64,   // shallow peripheral -> central
    k13: f64,   // central -> deep peripheral
    k31: f64,   // deep peripheral -> central
    v1: f64,    // volume of central compartment
    dose: f64,  // IV bolus dose
}

fn three_comp_params_new(k10: f64, k12: f64, k21: f64, k13: f64, k31: f64, v1: f64, dose: f64) -> ThreeCompParams {
    ThreeCompParams {
        k10: k10,
        k12: k12,
        k21: k21,
        k13: k13,
        k31: k31,
        v1: v1,
        dose: dose,
    }
}

// ============================================================================
// Eigenvalues via Cardano's formula for the cubic
// Characteristic equation: lambda^3 - a1*lambda^2 + a2*lambda - a3 = 0
// a1 = k10 + k12 + k21 + k13 + k31
// a2 = k10*k21 + k10*k31 + k12*k31 + k13*k21 + k21*k31
// a3 = k10*k21*k31
// ============================================================================

struct TripleEigen {
    alpha: f64,
    beta: f64,
    gamma: f64,
}

fn three_comp_eigenvalues(p: ThreeCompParams) -> TripleEigen with Mut, Div, Panic {
    let a1 = p.k10 + p.k12 + p.k21 + p.k13 + p.k31
    let a2 = p.k10 * p.k21 + p.k10 * p.k31 + p.k12 * p.k31 + p.k13 * p.k21 + p.k21 * p.k31
    let a3 = p.k10 * p.k21 * p.k31

    // Depressed cubic via substitution lambda = t + a1/3
    let q = (3.0 * a2 - a1 * a1) / 9.0
    let r = (9.0 * a1 * a2 - 27.0 * a3 - 2.0 * a1 * a1 * a1) / 54.0

    let q3 = q * q * q
    let disc = q3 + r * r

    var l1 = 0.0
    var l2 = 0.0
    var l3 = 0.0

    if disc < 0.0 {
        // Three real roots (trigonometric solution)
        let rho = pk3_sqrt(0.0 - q3)
        if rho < 1.0e-30 {
            l1 = a1 / 3.0
            l2 = a1 / 3.0
            l3 = a1 / 3.0
        } else {
            // Use cbrt for rho^(1/3)
            let rho_third = pk3_cbrt(rho)
            let cos_arg = r / rho
            let theta = pk3_acos(cos_arg) / 3.0
            let shift = a1 / 3.0
            let two_rho = 2.0 * rho_third
            l1 = two_rho * pk3_cos(theta) + shift
            l2 = two_rho * pk3_cos(theta - 2.0943951023931953) + shift
            l3 = two_rho * pk3_cos(theta + 2.0943951023931953) + shift
        }
    } else {
        // One or two real roots (use Cardano directly)
        let sq_disc = pk3_sqrt(disc)
        let s = pk3_cbrt(r + sq_disc)
        let tt = pk3_cbrt(r - sq_disc)
        l1 = s + tt + a1 / 3.0
        l2 = 0.0 - 0.5 * (s + tt) + a1 / 3.0
        l3 = l2
    }

    // Sort: alpha > beta > gamma
    var ea = l1
    var eb = l2
    var eg = l3
    if eb > ea { let tmp = ea; ea = eb; eb = tmp }
    if eg > ea { let tmp = ea; ea = eg; eg = tmp }
    if eg > eb { let tmp = eb; eb = eg; eg = tmp }

    TripleEigen {
        alpha: ea,
        beta: eb,
        gamma: eg,
    }
}

// ============================================================================
// Tri-exponential coefficients
// A = (dose/V1) * (alpha-k21)*(alpha-k31) / ((alpha-beta)*(alpha-gamma))
// B = (dose/V1) * (beta-k21)*(beta-k31)  / ((beta-alpha)*(beta-gamma))
// G = (dose/V1) * (gamma-k21)*(gamma-k31) / ((gamma-alpha)*(gamma-beta))
// ============================================================================

struct TriExpCoeff {
    a_coeff: f64,
    b_coeff: f64,
    g_coeff: f64,
    alpha: f64,
    beta: f64,
    gamma: f64,
}

fn three_comp_coefficients(p: ThreeCompParams) -> TriExpCoeff with Mut, Div, Panic {
    let e = three_comp_eigenvalues(p)
    var a_c = 0.0
    var b_c = 0.0
    var g_c = 0.0

    if p.v1 > 1.0e-15 {
        let c0 = p.dose / p.v1
        let ab = e.alpha - e.beta
        let ag = e.alpha - e.gamma
        let bg = e.beta - e.gamma

        if pk3_abs(ab) > 1.0e-15 && pk3_abs(ag) > 1.0e-15 {
            a_c = c0 * (e.alpha - p.k21) * (e.alpha - p.k31) / (ab * ag)
        }
        if pk3_abs(ab) > 1.0e-15 && pk3_abs(bg) > 1.0e-15 {
            b_c = c0 * (e.beta - p.k21) * (e.beta - p.k31) / ((0.0 - ab) * bg)
        }
        if pk3_abs(ag) > 1.0e-15 && pk3_abs(bg) > 1.0e-15 {
            g_c = c0 * (e.gamma - p.k21) * (e.gamma - p.k31) / ((0.0 - ag) * (0.0 - bg))
        }
    }

    TriExpCoeff {
        a_coeff: a_c,
        b_coeff: b_c,
        g_coeff: g_c,
        alpha: e.alpha,
        beta: e.beta,
        gamma: e.gamma,
    }
}

// ============================================================================
// Concentration: C(t) = A*exp(-alpha*t) + B*exp(-beta*t) + G*exp(-gamma*t)
// ============================================================================

fn three_comp_conc(p: ThreeCompParams, t: f64) -> f64 with Mut, Div, Panic {
    let c = three_comp_coefficients(p)
    c.a_coeff * pk3_exp(0.0 - c.alpha * t) +
        c.b_coeff * pk3_exp(0.0 - c.beta * t) +
        c.g_coeff * pk3_exp(0.0 - c.gamma * t)
}

// ============================================================================
// AUC (0->inf) = A/alpha + B/beta + G/gamma
// ============================================================================

fn three_comp_auc(p: ThreeCompParams) -> f64 with Mut, Div, Panic {
    let c = three_comp_coefficients(p)
    var auc = 0.0
    if c.alpha > 1.0e-15 { auc = auc + c.a_coeff / c.alpha }
    if c.beta > 1.0e-15 { auc = auc + c.b_coeff / c.beta }
    if c.gamma > 1.0e-15 { auc = auc + c.g_coeff / c.gamma }
    auc
}

// ============================================================================
// Concentration profile
// ============================================================================

fn three_comp_profile(p: ThreeCompParams, dt: f64, n: i32, out: &![f64; 256]) -> i32 with Mut, Div, Panic {
    var i = 0
    var count = n
    if count > 256 { count = 256 }
    while i < count {
        let t = i as f64 * dt
        out[i] = three_comp_conc(p, t)
        i = i + 1
    }
    count
}

// ============================================================================
// Tests
// ============================================================================

fn test_three_comp_at_zero() -> bool with Mut, Div, Panic {
    // At t=0, C = dose/V1 = 100/10 = 10
    let p = three_comp_params_new(0.3, 0.2, 0.1, 0.15, 0.05, 10.0, 100.0)
    let c0 = three_comp_conc(p, 0.0)
    pk3_abs(c0 - 10.0) < 0.5
}

fn test_three_comp_decay() -> bool with Mut, Div, Panic {
    let p = three_comp_params_new(0.3, 0.2, 0.1, 0.15, 0.05, 10.0, 100.0)
    let c0 = three_comp_conc(p, 0.0)
    let c10 = three_comp_conc(p, 10.0)
    let c50 = three_comp_conc(p, 50.0)
    c0 > c10 && c10 > c50
}

fn test_three_comp_eigenvalues_positive() -> bool with Mut, Div, Panic {
    let p = three_comp_params_new(0.3, 0.2, 0.1, 0.15, 0.05, 10.0, 100.0)
    let e = three_comp_eigenvalues(p)
    e.alpha > 0.0 && e.beta > 0.0 && e.gamma > 0.0
}

fn test_three_comp_auc_positive() -> bool with Mut, Div, Panic {
    let p = three_comp_params_new(0.3, 0.2, 0.1, 0.15, 0.05, 10.0, 100.0)
    let auc = three_comp_auc(p)
    auc > 0.0
}
