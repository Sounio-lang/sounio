// medlang/dose/mod.sio — Dosing Schedules
//
// Dose event generation for pharmacokinetic simulation.
// Supports IV, oral, and subcutaneous routes with QD/BID schedules.
//
// Reference: Gabrielsson & Weiner (2016), "PK/PD Data Analysis"

// ============================================================================
// DOSE EVENT
// ============================================================================

pub struct DoseEvent {
    amount: f64,    // Dose amount (mg)
    time: f64,      // Time of administration (h)
    route: i32,     // Route: 0=IV, 1=Oral, 2=SC
}

fn dose_event_zero() -> DoseEvent {
    DoseEvent { amount: 0.0, time: 0.0, route: 0 }
}

// ============================================================================
// ROUTE CONSTANTS
// ============================================================================

pub fn ROUTE_IV() -> i32 { 0 }
pub fn ROUTE_ORAL() -> i32 { 1 }
pub fn ROUTE_SC() -> i32 { 2 }

// ============================================================================
// QD (ONCE DAILY) SCHEDULE
// ============================================================================
// Generates n_doses events, one every 24 hours starting at `start`.
// Returns number of events written.

pub fn dose_schedule_qd(amount: f64, start: f64, n_doses: i32, events: &![DoseEvent; 64]) -> i32 with Mut, Panic, Div {
    var count: i32 = 0
    var i: i32 = 0
    while i < n_doses {
        if count >= 64 {
            return count
        }
        events[count as usize] = DoseEvent {
            amount: amount,
            time: start + (i as f64) * 24.0,
            route: ROUTE_ORAL(),
        }
        count = count + 1
        i = i + 1
    }
    count
}

// ============================================================================
// BID (TWICE DAILY) SCHEDULE
// ============================================================================
// Generates n_doses * 2 events, every 12 hours starting at `start`.
// Returns number of events written.

pub fn dose_schedule_bid(amount: f64, start: f64, n_doses: i32, events: &![DoseEvent; 64]) -> i32 with Mut, Panic, Div {
    var count: i32 = 0
    var i: i32 = 0
    while i < n_doses {
        // Morning dose
        if count >= 64 { return count }
        events[count as usize] = DoseEvent {
            amount: amount,
            time: start + (i as f64) * 24.0,
            route: ROUTE_ORAL(),
        }
        count = count + 1

        // Evening dose (12h later)
        if count >= 64 { return count }
        events[count as usize] = DoseEvent {
            amount: amount,
            time: start + (i as f64) * 24.0 + 12.0,
            route: ROUTE_ORAL(),
        }
        count = count + 1

        i = i + 1
    }
    count
}

// ============================================================================
// IV BOLUS SCHEDULE
// ============================================================================

pub fn dose_schedule_iv_bolus(amount: f64, time: f64, events: &![DoseEvent; 64], offset: i32) -> i32 with Mut, Panic {
    if offset >= 64 {
        return offset
    }
    events[offset as usize] = DoseEvent {
        amount: amount,
        time: time,
        route: ROUTE_IV(),
    }
    offset + 1
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_route_constants() -> i32 {
    if ROUTE_IV() != 0 { return 1 }
    if ROUTE_ORAL() != 1 { return 2 }
    if ROUTE_SC() != 2 { return 3 }
    0
}

//@ run-pass
fn test_qd_schedule() -> i32 {
    var events: [DoseEvent; 64] = [dose_event_zero(); 64]
    let n = dose_schedule_qd(500.0, 0.0, 3, &!events)
    if n != 3 { return 1 }
    // First dose at t=0
    if events[0].time != 0.0 { return 2 }
    if events[0].amount != 500.0 { return 3 }
    // Second dose at t=24
    if events[1].time != 24.0 { return 4 }
    // Third dose at t=48
    if events[2].time != 48.0 { return 5 }
    0
}

//@ run-pass
fn test_bid_schedule() -> i32 {
    var events: [DoseEvent; 64] = [dose_event_zero(); 64]
    let n = dose_schedule_bid(250.0, 0.0, 2, &!events)
    // 2 days * 2 doses/day = 4 events
    if n != 4 { return 1 }
    // Day 1 morning
    if events[0].time != 0.0 { return 2 }
    // Day 1 evening
    if events[1].time != 12.0 { return 3 }
    // Day 2 morning
    if events[2].time != 24.0 { return 4 }
    // Day 2 evening
    if events[3].time != 36.0 { return 5 }
    0
}
