// stdlib/logic/lib.sio — Propositional logic operations
//
// Truth values are i32: 0 = false, 1 = true.
// PropTable stores truth values for up to 256 propositions.
//
// All binary connectives are computed by classical two-valued logic.
// op_id for truth_table_2 / tautology / contradiction checks:
//   0 = and
//   1 = or
//   2 = xor
//   3 = implies
//   4 = iff

pub struct PropTable {
    pub values: [i32; 256],
    pub n: i32,
}

// ============================================================================
// BASIC CONNECTIVES
// ============================================================================

pub fn prop_and(a: i32, b: i32) -> i32 {
    if a == 1 && b == 1 { return 1 }
    0
}

pub fn prop_or(a: i32, b: i32) -> i32 {
    if a == 1 || b == 1 { return 1 }
    0
}

pub fn prop_not(a: i32) -> i32 {
    if a == 0 { return 1 }
    0
}

// Implication: a -> b = not(a) or b
pub fn prop_implies(a: i32, b: i32) -> i32 {
    prop_or(prop_not(a), b)
}

// Biconditional: a <-> b = (a -> b) and (b -> a)
pub fn prop_iff(a: i32, b: i32) -> i32 {
    prop_and(prop_implies(a, b), prop_implies(b, a))
}

// Exclusive or
pub fn prop_xor(a: i32, b: i32) -> i32 {
    if a == b { return 0 }
    1
}

// NAND: not(a and b)
pub fn prop_nand(a: i32, b: i32) -> i32 {
    prop_not(prop_and(a, b))
}

// NOR: not(a or b)
pub fn prop_nor(a: i32, b: i32) -> i32 {
    prop_not(prop_or(a, b))
}

// ============================================================================
// DISPATCH HELPER
// ============================================================================

// Apply binary op_id to (a, b)
fn apply_op2(op_id: i32, a: i32, b: i32) -> i32 {
    if op_id == 0 { return prop_and(a, b) }
    if op_id == 1 { return prop_or(a, b) }
    if op_id == 2 { return prop_xor(a, b) }
    if op_id == 3 { return prop_implies(a, b) }
    if op_id == 4 { return prop_iff(a, b) }
    0
}

// ============================================================================
// TRUTH TABLE GENERATION (2-input)
// ============================================================================

// Returns a 4-element truth table for a 2-input operator:
//   index 0 -> (0, 0)
//   index 1 -> (0, 1)
//   index 2 -> (1, 0)
//   index 3 -> (1, 1)
pub fn truth_table_2(op_id: i32) -> [i32; 4] {
    var tbl: [i32; 4] = [0; 4]
    tbl[0] = apply_op2(op_id, 0, 0)
    tbl[1] = apply_op2(op_id, 0, 1)
    tbl[2] = apply_op2(op_id, 1, 0)
    tbl[3] = apply_op2(op_id, 1, 1)
    tbl
}

// ============================================================================
// TAUTOLOGY / CONTRADICTION CHECK (2-input)
// ============================================================================

// Returns true if all four outputs of a 2-input op are 1
pub fn is_tautology_2(op_id: i32) -> bool {
    let tbl = truth_table_2(op_id)
    if tbl[0] == 1 && tbl[1] == 1 && tbl[2] == 1 && tbl[3] == 1 {
        return true
    }
    false
}

// Returns true if all four outputs of a 2-input op are 0
pub fn is_contradiction_2(op_id: i32) -> bool {
    let tbl = truth_table_2(op_id)
    if tbl[0] == 0 && tbl[1] == 0 && tbl[2] == 0 && tbl[3] == 0 {
        return true
    }
    false
}

// ============================================================================
// DE MORGAN VERIFICATION
// ============================================================================

// De Morgan AND: not(a and b) = not(a) or not(b)
// Returns 1 if the identity holds for these inputs, 0 if violated
pub fn de_morgan_and(a: i32, b: i32) -> i32 {
    let lhs = prop_not(prop_and(a, b))
    let rhs = prop_or(prop_not(a), prop_not(b))
    if lhs == rhs { return 1 }
    0
}

// ============================================================================
// PROP TABLE OPERATIONS
// ============================================================================

pub fn prop_table_new() -> PropTable {
    PropTable { values: [0; 256], n: 0 }
}

pub fn prop_table_set(tbl: PropTable, idx: i32, val: i32) -> PropTable with Panic, Mut {
    var out = tbl
    if idx >= 0 && idx < 256 {
        out.values[idx] = val
        if idx >= out.n { out.n = idx + 1 }
    }
    out
}

pub fn prop_table_get(tbl: &PropTable, idx: i32) -> i32 with Panic {
    if idx < 0 || idx >= tbl.n { return 0 }
    tbl.values[idx]
}

// Count how many truth values in the table equal 1
pub fn prop_table_count_true(tbl: &PropTable) -> i32 with Panic, Div, Mut {
    var count: i32 = 0
    var i: i32 = 0
    while i < tbl.n {
        if tbl.values[i] == 1 { count = count + 1 }
        i = i + 1
    }
    count
}
