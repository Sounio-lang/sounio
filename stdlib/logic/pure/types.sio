// stdlib/logic/pure/types.sio — Logic/Propositional Types

pub enum Proposition {
    True,
    False,
    Var(string),
    Not(Box<Proposition>),
    And(Box<Proposition>, Box<Proposition>),
    Or(Box<Proposition>, Box<Proposition>),
    Imp(Box<Proposition>, Box<Proposition>),
}

pub struct TruthAssignment {
    pub vars: [string; 64],
    pub values: [bool; 64],
    pub n_vars: i32,
}

pub fn assignment_new() -> TruthAssignment {
    TruthAssignment { vars: [""; 64], values: [false; 64], n_vars: 0 }
}

pub fn assignment_set(a: &! TruthAssignment, v: string, val: bool) with Mut {
    var i = 0
    while i < a.n_vars {
        if a.vars[i as usize] == v {
            a.values[i as usize] = val
            return
        }
        i = i + 1
    }
    if a.n_vars < 64 {
        let idx = a.n_vars as usize
        a.vars[idx] = v
        a.values[idx] = val
        a.n_vars = a.n_vars + 1
    }
}

pub fn assignment_get(a: &TruthAssignment, v: string) -> bool {
    var i = 0
    while i < a.n_vars {
        if a.vars[i as usize] == v {
            return a.values[i as usize]
        }
        i = i + 1
    }
    false
}

pub fn proposition_evaluate(p: &Proposition, a: &TruthAssignment) -> bool {
    match p {
        Proposition::True => true,
        Proposition::False => false,
        Proposition::Var(name) => assignment_get(a, name),
        Proposition::Not(q) => !proposition_evaluate(q, a),
        Proposition::And(q1, q2) => proposition_evaluate(q1, a) && proposition_evaluate(q2, a),
        Proposition::Or(q1, q2) => proposition_evaluate(q1, a) || proposition_evaluate(q2, a),
        Proposition::Imp(q1, q2) => !proposition_evaluate(q1, a) || proposition_evaluate(q2, a),
    }
}