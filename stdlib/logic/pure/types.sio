// stdlib/logic/pure/types.sio — Logic/Propositional Types

pub enum Proposition {
    True,
    False,
    Var(string),
    Not(Box<Proposition>),
    And(Box<Proposition>, Box<Proposition>),
    Or(Box<Proposition>, Box<Proposition>),
    Imp(Box<Proposition>, Box<Proposition>),
}

pub struct TruthAssignment {
    pub vars: [string; 64],
    pub values: [bool; 64],
    pub n_vars: i32,
}

pub fn assignment_new() -> TruthAssignment {
    TruthAssignment { vars: [""; 64], values: [false; 64], n_vars: 0 }
}

pub fn assignment_set(a: &! TruthAssignment, v: string, val: bool) with Mut {
    var i = 0
    while i < a.n_vars {
        if a.vars[i as usize] == v {
            a.values[i as usize] = val
            return
        }
        i = i + 1
    }
    if a.n_vars < 64 {
        let idx = a.n_vars as usize
        a.vars[idx] = v
        a.values[idx] = val
        a.n_vars = a.n_vars + 1
    }
}

pub fn assignment_get(a: &TruthAssignment, v: string) -> bool {
    var i = 0
    while i < a.n_vars {
        if a.vars[i as usize] == v {
            return a.values[i as usize]
        }
        i = i + 1
    }
    false
}

pub fn proposition_evaluate(p: &Proposition, a: &TruthAssignment) -> bool {
    match p {
        Proposition::True => true,
        Proposition::False => false,
        Proposition::Var(name) => assignment_get(a, name),
        Proposition::Not(q) => !proposition_evaluate(q, a),
        Proposition::And(q1, q2) => proposition_evaluate(q1, a) && proposition_evaluate(q2, a),
        Proposition::Or(q1, q2) => proposition_evaluate(q1, a) || proposition_evaluate(q2, a),
        Proposition::Imp(q1, q2) => !proposition_evaluate(q1, a) || proposition_evaluate(q2, a),
    }
}

// =============================================================================
// Boolean logic primitives (i64-encoded 0/1 truth values)
// =============================================================================

pub fn prop_and(a: i64, b: i64) -> i64 { if a != 0 && b != 0 { 1 } else { 0 } }
pub fn prop_or(a: i64, b: i64) -> i64 { if a != 0 || b != 0 { 1 } else { 0 } }
pub fn prop_not(a: i64) -> i64 { if a == 0 { 1 } else { 0 } }
pub fn prop_implies(a: i64, b: i64) -> i64 { if a != 0 && b == 0 { 0 } else { 1 } }
pub fn prop_iff(a: i64, b: i64) -> i64 { if (a != 0) == (b != 0) { 1 } else { 0 } }
pub fn prop_xor(a: i64, b: i64) -> i64 { if (a != 0) != (b != 0) { 1 } else { 0 } }
pub fn prop_nand(a: i64, b: i64) -> i64 { prop_not(prop_and(a, b)) }
pub fn prop_nor(a: i64, b: i64) -> i64 { prop_not(prop_or(a, b)) }

pub fn truth_table_2(op: i64) -> [i64; 4] {
    // op: 0=AND, 1=OR, 2=XOR, 3=IMPLIES, 4=IFF
    if op == 0 {
        [0, 0, 0, 1]
    } else if op == 1 {
        [0, 1, 1, 1]
    } else if op == 2 {
        [0, 1, 1, 0]
    } else if op == 3 {
        [1, 1, 0, 1]
    } else if op == 4 {
        [1, 0, 0, 1]
    } else {
        [0, 0, 0, 0]
    }
}

pub fn is_tautology_2(op: i64) -> bool {
    let tbl = truth_table_2(op)
    tbl[0] == 1 && tbl[1] == 1 && tbl[2] == 1 && tbl[3] == 1
}

pub fn is_contradiction_2(op: i64) -> bool {
    let tbl = truth_table_2(op)
    tbl[0] == 0 && tbl[1] == 0 && tbl[2] == 0 && tbl[3] == 0
}

pub fn de_morgan_and(a: i64, b: i64) -> i64 {
    // not(a and b) == (not a) or (not b)
    let lhs = prop_not(prop_and(a, b))
    let rhs = prop_or(prop_not(a), prop_not(b))
    prop_iff(lhs, rhs)
}