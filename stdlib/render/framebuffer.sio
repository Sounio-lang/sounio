// Software framebuffer for PPM rendering
//
// Uses flat [i64; 196608] arrays for R, G, B channels (256x256 max).
// Each pixel stores 0-255 integer color value.
// Output via PPM P3 text format to stdout.

// Max framebuffer size: 256x256 = 65536 pixels
// Each channel is a separate array to avoid struct-of-arrays complexity

struct Framebuffer {
    width: i64,
    height: i64,
    r: [i64; 65536],
    g: [i64; 65536],
    b: [i64; 65536],
    depth: [f64; 65536],
}

fn fb_new(w: i64, h: i64) -> Framebuffer {
    Framebuffer {
        width: w,
        height: h,
        r: [0; 65536],
        g: [0; 65536],
        b: [0; 65536],
        depth: [1000000.0; 65536],
    }
}

fn fb_set_pixel(fb: &!Framebuffer, x: i64, y: i64, r: i64, g: i64, b: i64) with Mut, Panic {
    if x >= 0 && x < (*fb).width && y >= 0 && y < (*fb).height {
        let idx = y * (*fb).width + x
        (*fb).r[idx] = r
        (*fb).g[idx] = g
        (*fb).b[idx] = b
    }
}

fn fb_set_pixel_depth(fb: &!Framebuffer, x: i64, y: i64, z: f64, r: i64, g: i64, b: i64) with Mut, Panic {
    if x >= 0 && x < (*fb).width && y >= 0 && y < (*fb).height {
        let idx = y * (*fb).width + x
        if z < (*fb).depth[idx] {
            (*fb).r[idx] = r
            (*fb).g[idx] = g
            (*fb).b[idx] = b
            (*fb).depth[idx] = z
        }
    }
}

fn fb_clear(fb: &!Framebuffer, r: i64, g: i64, b: i64) with Mut, Panic, Div {
    var i: i64 = 0
    let total = (*fb).width * (*fb).height
    while i < total {
        (*fb).r[i] = r
        (*fb).g[i] = g
        (*fb).b[i] = b
        (*fb).depth[i] = 1000000.0
        i = i + 1
    }
}

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    v
}

fn float_to_byte(f: f64) -> i64 {
    let v = (f * 255.0) as i64
    clamp_byte(v)
}

// Emit PPM P3 header + pixels to stdout
fn fb_emit_ppm(fb: &Framebuffer) with IO, Mut, Div, Panic {
    print("P3\n")
    print_int((*fb).width)
    print(" ")
    print_int((*fb).height)
    print("\n255\n")

    var y: i64 = 0
    while y < (*fb).height {
        var x: i64 = 0
        while x < (*fb).width {
            let idx = y * (*fb).width + x
            print_int(clamp_byte((*fb).r[idx]))
            print(" ")
            print_int(clamp_byte((*fb).g[idx]))
            print(" ")
            print_int(clamp_byte((*fb).b[idx]))
            print("\n")
            x = x + 1
        }
        y = y + 1
    }
}

fn main() -> i32 with IO {
    0
}
