// Render type primitives for Sounio's GPU pixel rendering pipeline
//
// These types form the foundation of the 4-backend rendering system:
// PPM (software), SPIR-V (Vulkan), Metal, WGSL (WebGPU).

struct Color {
    r: f64,
    g: f64,
    b: f64,
    a: f64,
}

fn color_rgb(r: f64, g: f64, b: f64) -> Color {
    Color { r: r, g: g, b: b, a: 1.0 }
}

fn color_rgba(r: f64, g: f64, b: f64, a: f64) -> Color {
    Color { r: r, g: g, b: b, a: a }
}

fn color_white() -> Color { Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 } }
fn color_black() -> Color { Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 } }
fn color_red() -> Color { Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 } }
fn color_green() -> Color { Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 } }
fn color_blue() -> Color { Color { r: 0.0, g: 0.0, b: 1.0, a: 1.0 } }

struct Vec2 {
    x: f64,
    y: f64,
}

struct Vec3 {
    x: f64,
    y: f64,
    z: f64,
}

struct Vec4 {
    x: f64,
    y: f64,
    z: f64,
    w: f64,
}

fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    Vec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}

fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 {
    Vec3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
}

fn vec3_scale(v: Vec3, s: f64) -> Vec3 {
    Vec3 { x: v.x * s, y: v.y * s, z: v.z * s }
}

fn vec3_dot(a: Vec3, b: Vec3) -> f64 {
    a.x * b.x + a.y * b.y + a.z * b.z
}

fn vec3_cross(a: Vec3, b: Vec3) -> Vec3 {
    Vec3 {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x,
    }
}

fn vec3_length_sq(v: Vec3) -> f64 {
    v.x * v.x + v.y * v.y + v.z * v.z
}

struct Vertex {
    position: Vec3,
    color: Color,
    normal: Vec3,
    uv: Vec2,
}

fn vertex_new(pos: Vec3, col: Color) -> Vertex {
    Vertex {
        position: pos,
        color: col,
        normal: Vec3 { x: 0.0, y: 0.0, z: 1.0 },
        uv: Vec2 { x: 0.0, y: 0.0 },
    }
}

struct Triangle {
    v0: Vertex,
    v1: Vertex,
    v2: Vertex,
}

struct Canvas {
    width: i64,
    height: i64,
}

fn canvas_new(w: i64, h: i64) -> Canvas {
    Canvas { width: w, height: h }
}

fn main() -> i32 with IO {
    0
}
