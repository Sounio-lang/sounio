// Scene graph types for Sounio rendering pipeline

struct Camera {
    pos_x: f64,
    pos_y: f64,
    pos_z: f64,
    target_x: f64,
    target_y: f64,
    target_z: f64,
    up_x: f64,
    up_y: f64,
    up_z: f64,
    fov: f64,
    near: f64,
    far: f64,
}

fn camera_default() -> Camera {
    Camera {
        pos_x: 0.0, pos_y: 0.0, pos_z: 5.0,
        target_x: 0.0, target_y: 0.0, target_z: 0.0,
        up_x: 0.0, up_y: 1.0, up_z: 0.0,
        fov: 60.0,
        near: 0.1,
        far: 100.0,
    }
}

struct Light {
    pos_x: f64,
    pos_y: f64,
    pos_z: f64,
    color_r: f64,
    color_g: f64,
    color_b: f64,
    intensity: f64,
}

fn light_point(x: f64, y: f64, z: f64, intensity: f64) -> Light {
    Light {
        pos_x: x, pos_y: y, pos_z: z,
        color_r: 1.0, color_g: 1.0, color_b: 1.0,
        intensity: intensity,
    }
}

struct Scene {
    triangle_count: i64,
    light_count: i64,
    camera: Camera,
}

fn scene_new() -> Scene {
    Scene {
        triangle_count: 0,
        light_count: 0,
        camera: camera_default(),
    }
}

struct ScreenPt { sx: i64, sy: i64, depth: f64 }

fn project_point3d(
    wx: f64, wy: f64, wz: f64,
    focal: f64, z_offset: f64,
    fb_w: i64, fb_h: i64
) -> ScreenPt with Div, Panic {
    let z_cam = wz + z_offset
    let scale = focal / z_cam
    ScreenPt {
        sx: (wx * scale + ((fb_w as f64) * 0.5)) as i64,
        sy: ((0.0 - wy) * scale + ((fb_h as f64) * 0.5)) as i64,
        depth: z_cam,
    }
}

fn main() -> i32 with IO {
    0
}
