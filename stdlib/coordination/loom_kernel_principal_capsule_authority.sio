    lease_target_state: i64,
    preexec_barrier_closed: i64,
    journal_transition_uncommitted: i64,
) -> LoomKernelPrincipalCapsuleOrder {
    LoomKernelPrincipalCapsuleOrder {
        operation: operation,
        parent_9026_allow: parent_9026_allow,
        parent_9027_allow: parent_9027_allow,
        lease_start_state: lease_start_state,
        lease_target_state: lease_target_state,
        preexec_barrier_closed: preexec_barrier_closed,
        journal_transition_uncommitted: journal_transition_uncommitted,
    }
}

