//! Sounio-first authority for non-bearer LOOM kernel PrincipalCapsules.
//!
//! Action 9028 makes a lane process non-denotable as a bare PID or numeric
//! pidfd and binds mint/recovery custody to frozen actions 9026 and 9027.

struct LoomKernelPrincipalCapsuleDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomKernelPrincipalCapsuleOrder {
    operation: i64,
    parent_9026_allow: i64,
    parent_9027_allow: i64,
    lease_start_state: i64,
    lease_target_state: i64,
    preexec_barrier_closed: i64,
    journal_transition_uncommitted: i64,
}

struct LoomKernelPrincipalCapsuleIdentity {
    host_pid: i64,
    start_time: i64,
    pidfd_identity: i64,
    broker_epoch: i64,
    lease_generation: i64,
    custody_generation: i64,
    pidfd_peer_matches: i64,
    start_time_matches: i64,
    vector_complete: i64,
}

struct LoomKernelPrincipalCapsuleIsolation {
    namespaces_distinct: i64,
    maps_exact: i64,
    maps_disjoint: i64,
    cgroup_exact: i64,
    resources_enforced: i64,
    descendants_contained: i64,
    cgroup_escape_denied: i64,
}

struct LoomKernelPrincipalCapsulePrivilege {
    ids_exact: i64,
    supplementary_groups_empty: i64,
    capabilities_empty: i64,
    no_new_privileges: i64,
    seccomp_installed: i64,
    nondumpable: i64,
    setid_path_absent: i64,
    broker_descriptors_absent: i64,
}

struct LoomKernelPrincipalCapsuleCustody {
    broker_holds_pidfd: i64,
    pidfd_cloexec: i64,
    lane_holds_pidfd: i64,
    resident_holds_pidfd: i64,
    raw_pid_authority_exported: i64,
    raw_pidfd_authority_exported: i64,
    broker_lookup_required: i64,
}

struct LoomKernelPrincipalCapsuleGrant {
    capsule_non_authorizing: i64,
    execgrant_bound: i64,
    single_use: i64,
    unconsumed: i64,
    peer_bound: i64,
    ancestry_bound: i64,
    effect_bound: i64,
    command_bound: i64,
    review_only_enforced: i64,
}

struct LoomKernelPrincipalCapsuleRecovery {
    recovery_mode: i64,
    previous_broker_epoch: i64,
    current_broker_epoch: i64,
    previous_custody_generation: i64,
    current_custody_generation: i64,
    lineage_equal: i64,
    prior_grants_revoked: i64,
    old_custody_extinct: i64,
    remains_quarantined: i64,
    barrier_release_denied: i64,
}

struct LoomKernelPrincipalCapsuleEvidence {
    sabotage_count: i64,
    sabotage_required: i64,
    receipt_bound: i64,
}

struct LoomKernelPrincipalCapsuleBindings {
    parent_9026_manifest_hash: LoomKernelPrincipalCapsuleDigest256,
    parent_9027_manifest_hash: LoomKernelPrincipalCapsuleDigest256,
    launch_receipt_hash: LoomKernelPrincipalCapsuleDigest256,
    custody_receipt_hash: LoomKernelPrincipalCapsuleDigest256,
    grant_receipt_hash: LoomKernelPrincipalCapsuleDigest256,
    recovery_receipt_hash: LoomKernelPrincipalCapsuleDigest256,
    capsule_hash: LoomKernelPrincipalCapsuleDigest256,
    source_hash: LoomKernelPrincipalCapsuleDigest256,
    semantics_hash: LoomKernelPrincipalCapsuleDigest256,
    toolchain_hash: LoomKernelPrincipalCapsuleDigest256,
    hardware_hash: LoomKernelPrincipalCapsuleDigest256,
    command_hash: LoomKernelPrincipalCapsuleDigest256,
    result_hash: LoomKernelPrincipalCapsuleDigest256,
}

pub fn admit_loom_kernel_principal_capsule_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> LoomKernelPrincipalCapsuleDigest256 {
    LoomKernelPrincipalCapsuleDigest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
}

