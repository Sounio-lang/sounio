//! Nominal algebra for bounded robust contingent experiment policies.
//!
//! OCaml owns graph parsing, exact backward induction, frontier construction,
//! replay, target references, and exact resource identities. Frame 9011 checks
//! closed nominal outcome partitions, root policy dominance, and observed
//! branch routing before host decisions enter the journal.

pub effect LoomContingentHostTrust {}

struct ContingentDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

linear struct ContingentBudget {
    tokens: i64,
    wall: i64,
    gpu: i64,
    quota: i64,
}

linear struct LiveContingentPolicy {
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_resource_token: i64,
    owner_token: i64,
    generation_token: i64,
    policy_digest: ContingentDigest256,
}

linear struct CompletedContingentPolicy {
    policy_token: i64,
    selected_policy_token: i64,
    outcome_digest: ContingentDigest256,
}

linear struct HostContingentDecisionReceipt {
    receipt_id: i64,
    transition_kind: i64,
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    owner_token: i64,
    generation_token: i64,
    outcome_digest: ContingentDigest256,
}

pub fn admit_contingent_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> ContingentDigest256 {
    ContingentDigest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
}

fn contingent_digest_is_canonical(digest: ContingentDigest256) -> bool {
    digest.limb0 >= 0 && digest.limb0 <= 4294967295 &&
    digest.limb1 >= 0 && digest.limb1 <= 4294967295 &&
    digest.limb2 >= 0 && digest.limb2 <= 4294967295 &&
    digest.limb3 >= 0 && digest.limb3 <= 4294967295 &&
    digest.limb4 >= 0 && digest.limb4 <= 4294967295 &&
    digest.limb5 >= 0 && digest.limb5 <= 4294967295 &&
    digest.limb6 >= 0 && digest.limb6 <= 4294967295 &&
    digest.limb7 >= 0 && digest.limb7 <= 4294967295
}

fn contingent_digest_is_nonzero(digest: ContingentDigest256) -> bool {
    digest.limb0 != 0 || digest.limb1 != 0 || digest.limb2 != 0 ||
    digest.limb3 != 0 || digest.limb4 != 0 || digest.limb5 != 0 ||
    digest.limb6 != 0 || digest.limb7 != 0
}

fn contingent_digest_is_zero(digest: ContingentDigest256) -> bool {
    !contingent_digest_is_nonzero(digest)
}

fn contingent_benefit_is_bounded(value: i64) -> bool {
    value >= 1 && value <= 18000
}

fn contingent_burden_is_bounded(value: i64) -> bool {
    value >= 0 && value <= 18000000
}

fn information_policy_precedes_or_ties(
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
) -> bool {
    si > ri ||
    (si == ri && (sf > rf ||
     (sf == rf && (sd > rd ||
      (sd == rd && (sr < rr ||
       (sr == rr && (st < rt ||
        (st == rt && (sw < rw ||
         (sw == rw && (sg < rg ||
          (sg == rg && sq <= rq)))))))))))))
}

fn falsification_policy_precedes_or_ties(
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
) -> bool {
    sf > rf ||
    (sf == rf && (si > ri ||
     (si == ri && (sd > rd ||
      (sd == rd && (sr < rr ||
       (sr == rr && (st < rt ||
        (st == rt && (sw < rw ||
         (sw == rw && (sg < rg ||
          (sg == rg && sq <= rq)))))))))))))
}

fn counterfactual_policy_precedes_or_ties(
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
) -> bool {
    sd > rd ||
    (sd == rd && (sf > rf ||
     (sf == rf && (si > ri ||
      (si == ri && (sr < rr ||
       (sr == rr && (st < rt ||
        (st == rt && (sw < rw ||
         (sw == rw && (sg < rg ||
          (sg == rg && sq <= rq)))))))))))))
}

fn contingent_policy_selected_not_dominated(
    policy: i64,
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
) -> bool {
    if policy == 1 {
        return information_policy_precedes_or_ties(
            si, sf, sd, sr, st, sw, sg, sq,
            ri, rf, rd, rr, rt, rw, rg, rq,
        )
    }
    if policy == 2 {
        return falsification_policy_precedes_or_ties(
            si, sf, sd, sr, st, sw, sg, sq,
            ri, rf, rd, rr, rt, rw, rg, rq,
        )
    }
    if policy == 3 {
        return counterfactual_policy_precedes_or_ties(
            si, sf, sd, sr, st, sw, sg, sq,
            ri, rf, rd, rr, rt, rw, rg, rq,
        )
    }
    false
}

fn contingent_outcome_partition_is_total(
    variant_count: i64,
    observed_count: i64,
    index0_plus_one: i64,
    index1_plus_one: i64,
    index2_plus_one: i64,
) -> bool {
    (variant_count == 1 && observed_count == 1 &&
     index0_plus_one == 1 && index1_plus_one == 0 && index2_plus_one == 0) ||
    (variant_count == 2 && observed_count == 2 &&
     index0_plus_one == 1 && index1_plus_one == 2 && index2_plus_one == 0) ||
    (variant_count == 3 && observed_count == 3 &&
     index0_plus_one == 1 && index1_plus_one == 2 && index2_plus_one == 3)
}

fn contingent_transition_matches_branch(
    terminal: i64,
    outcome_token: i64,
    expected_next_action_token: i64,
    claimed_next_action_token: i64,
) -> bool {
    outcome_token > 0 &&
    ((terminal == 1 && expected_next_action_token == 0 &&
      claimed_next_action_token == 0) ||
     (terminal == 0 && expected_next_action_token > 0 &&
      claimed_next_action_token == expected_next_action_token))
}

fn contingent_compile_shape_is_canonical(
    policy: i64,
    terminal: i64,
    token_budget: i64,
    wall_budget: i64,
    gpu_budget: i64,
    quota_budget: i64,
    policy_token: i64,
    selected_policy_token: i64,
    rival_policy_token: i64,
    current_action_token: i64,
    outcome_token: i64,
    expected_next_action_token: i64,
    claimed_next_action_token: i64,
    owner_token: i64,
    generation_token: i64,
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
    action_set: ContingentDigest256,
    outcome_set: ContingentDigest256,
    frontier: ContingentDigest256,
    selected_policy: ContingentDigest256,
    evidence: ContingentDigest256,
    falsifier: ContingentDigest256,
    branch: ContingentDigest256,
    outcome: ContingentDigest256,
) -> bool {
    policy >= 1 && policy <= 3 && terminal == 0 &&
    token_budget > 0 && wall_budget > 0 && gpu_budget >= 0 && quota_budget >= 0 &&
    policy_token > 0 && selected_policy_token > 0 && rival_policy_token > 0 &&
    current_action_token > 0 && outcome_token == 0 &&
    expected_next_action_token == 0 && claimed_next_action_token == 0 &&
    owner_token > 0 && generation_token > 0 &&
    contingent_benefit_is_bounded(si) &&
    contingent_benefit_is_bounded(sf) &&
    contingent_benefit_is_bounded(sd) &&
    contingent_burden_is_bounded(sr) &&
    st > 0 && st <= token_budget && sw > 0 && sw <= wall_budget &&
    sg >= 0 && sg <= gpu_budget && sq >= 0 && sq <= quota_budget &&
    contingent_benefit_is_bounded(ri) &&
    contingent_benefit_is_bounded(rf) &&
    contingent_benefit_is_bounded(rd) &&
    contingent_burden_is_bounded(rr) &&
    rt > 0 && rt <= token_budget && rw > 0 && rw <= wall_budget &&
    rg >= 0 && rg <= gpu_budget && rq >= 0 && rq <= quota_budget &&
    contingent_digest_is_canonical(action_set) &&
    contingent_digest_is_canonical(outcome_set) &&
    contingent_digest_is_canonical(frontier) &&
    contingent_digest_is_canonical(selected_policy) &&
    contingent_digest_is_canonical(evidence) &&
    contingent_digest_is_canonical(falsifier) &&
    contingent_digest_is_canonical(branch) &&
    contingent_digest_is_nonzero(action_set) &&
    contingent_digest_is_nonzero(outcome_set) &&
    contingent_digest_is_nonzero(frontier) &&
    contingent_digest_is_nonzero(selected_policy) &&
    contingent_digest_is_nonzero(evidence) &&
    contingent_digest_is_nonzero(falsifier) &&
    contingent_digest_is_nonzero(branch) &&
    contingent_digest_is_zero(outcome) &&
    contingent_policy_selected_not_dominated(
        policy, si, sf, sd, sr, st, sw, sg, sq,
        ri, rf, rd, rr, rt, rw, rg, rq,
    )
}

fn contingent_partition_shape_is_canonical(
    policy: i64,
    terminal: i64,
    token_budget: i64,
    wall_budget: i64,
    gpu_budget: i64,
    quota_budget: i64,
    policy_token: i64,
    selected_policy_token: i64,
    rival_policy_token: i64,
    current_action_token: i64,
    outcome_token: i64,
    expected_next_action_token: i64,
    claimed_next_action_token: i64,
    owner_token: i64,
    generation_token: i64,
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
    action_set: ContingentDigest256,
    outcome_set: ContingentDigest256,
    frontier: ContingentDigest256,
    selected_policy: ContingentDigest256,
    evidence: ContingentDigest256,
    falsifier: ContingentDigest256,
    branch: ContingentDigest256,
    outcome: ContingentDigest256,
) -> bool {
    policy == 0 && terminal == 0 && token_budget == 0 && wall_budget == 0 &&
    gpu_budget == 0 && quota_budget == 0 && policy_token > 0 &&
    selected_policy_token == 0 && rival_policy_token == 0 &&
    current_action_token > 0 && outcome_token == 0 &&
    expected_next_action_token == 0 && claimed_next_action_token == 0 &&
    owner_token > 0 && generation_token > 0 &&
    contingent_outcome_partition_is_total(si, sf, sd, sr, st) &&
    sw == 0 && sg == 0 && sq == 0 &&
    ri == 0 && rf == 0 && rd == 0 && rr == 0 &&
    rt == 0 && rw == 0 && rg == 0 && rq == 0 &&
    contingent_digest_is_zero(action_set) &&
    contingent_digest_is_canonical(outcome_set) &&
    contingent_digest_is_nonzero(outcome_set) &&
    contingent_digest_is_zero(frontier) &&
    contingent_digest_is_zero(selected_policy) &&
    contingent_digest_is_zero(evidence) &&
    contingent_digest_is_zero(falsifier) &&
    contingent_digest_is_canonical(branch) &&
    contingent_digest_is_nonzero(branch) &&
    contingent_digest_is_zero(outcome)
}

fn contingent_transition_shape_is_canonical(
    policy: i64,
    terminal: i64,
    token_budget: i64,
    wall_budget: i64,
    gpu_budget: i64,
    quota_budget: i64,
    policy_token: i64,
    selected_policy_token: i64,
    rival_policy_token: i64,
    current_action_token: i64,
    outcome_token: i64,
    expected_next_action_token: i64,
    claimed_next_action_token: i64,
    owner_token: i64,
    generation_token: i64,
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
    action_set: ContingentDigest256,
    outcome_set: ContingentDigest256,
    frontier: ContingentDigest256,
    selected_policy: ContingentDigest256,
    evidence: ContingentDigest256,
    falsifier: ContingentDigest256,
    branch: ContingentDigest256,
    outcome: ContingentDigest256,
) -> bool {
    policy == 0 && (terminal == 0 || terminal == 1) &&
    token_budget == 0 && wall_budget == 0 && gpu_budget == 0 && quota_budget == 0 &&
    policy_token > 0 && selected_policy_token > 0 && rival_policy_token == 0 &&
    current_action_token > 0 && owner_token > 0 && generation_token > 0 &&
    contingent_transition_matches_branch(
        terminal, outcome_token, expected_next_action_token,
        claimed_next_action_token,
    ) &&
    si == 0 && sf == 0 && sd == 0 && sr == 0 &&
    st == 0 && sw == 0 && sg == 0 && sq == 0 &&
    ri == 0 && rf == 0 && rd == 0 && rr == 0 &&
    rt == 0 && rw == 0 && rg == 0 && rq == 0 &&
    contingent_digest_is_zero(action_set) &&
    contingent_digest_is_zero(outcome_set) &&
    contingent_digest_is_zero(frontier) &&
    contingent_digest_is_canonical(selected_policy) &&
    contingent_digest_is_nonzero(selected_policy) &&
    contingent_digest_is_zero(evidence) &&
    contingent_digest_is_zero(falsifier) &&
    contingent_digest_is_canonical(branch) &&
    contingent_digest_is_nonzero(branch) &&
    contingent_digest_is_canonical(outcome) &&
    contingent_digest_is_nonzero(outcome)
}

pub fn host_contingent_frame_accepts(
    kind: i64,
    policy: i64,
    terminal: i64,
    token_budget: i64,
    wall_budget: i64,
    gpu_budget: i64,
    quota_budget: i64,
    policy_token: i64,
    selected_policy_token: i64,
    rival_policy_token: i64,
    current_action_token: i64,
    outcome_token: i64,
    expected_next_action_token: i64,
    claimed_next_action_token: i64,
    owner_token: i64,
    generation_token: i64,
    si: i64, sf: i64, sd: i64, sr: i64,
    st: i64, sw: i64, sg: i64, sq: i64,
    ri: i64, rf: i64, rd: i64, rr: i64,
    rt: i64, rw: i64, rg: i64, rq: i64,
    action_set: ContingentDigest256,
    outcome_set: ContingentDigest256,
    frontier: ContingentDigest256,
    selected_policy: ContingentDigest256,
    evidence: ContingentDigest256,
    falsifier: ContingentDigest256,
    branch: ContingentDigest256,
    outcome: ContingentDigest256,
) -> bool with LoomContingentHostTrust {
    (kind == 1 && contingent_compile_shape_is_canonical(
        policy, terminal, token_budget, wall_budget, gpu_budget, quota_budget,
        policy_token, selected_policy_token, rival_policy_token,
        current_action_token, outcome_token, expected_next_action_token,
        claimed_next_action_token, owner_token, generation_token,
        si, sf, sd, sr, st, sw, sg, sq,
        ri, rf, rd, rr, rt, rw, rg, rq,
        action_set, outcome_set, frontier, selected_policy,
        evidence, falsifier, branch, outcome,
    )) ||
    (kind == 2 && contingent_transition_shape_is_canonical(
        policy, terminal, token_budget, wall_budget, gpu_budget, quota_budget,
        policy_token, selected_policy_token, rival_policy_token,
        current_action_token, outcome_token, expected_next_action_token,
        claimed_next_action_token, owner_token, generation_token,
        si, sf, sd, sr, st, sw, sg, sq,
        ri, rf, rd, rr, rt, rw, rg, rq,
        action_set, outcome_set, frontier, selected_policy,
        evidence, falsifier, branch, outcome,
    )) ||
    (kind == 3 && contingent_partition_shape_is_canonical(
        policy, terminal, token_budget, wall_budget, gpu_budget, quota_budget,
        policy_token, selected_policy_token, rival_policy_token,
        current_action_token, outcome_token, expected_next_action_token,
        claimed_next_action_token, owner_token, generation_token,
        si, sf, sd, sr, st, sw, sg, sq,
        ri, rf, rd, rr, rt, rw, rg, rq,
        action_set, outcome_set, frontier, selected_policy,
        evidence, falsifier, branch, outcome,
    ))
}

pub fn acquire_contingent_budget(
    tokens: i64,
    wall: i64,
    gpu: i64,
    quota: i64,
) -> ContingentBudget with Panic {
    if tokens <= 0 || wall <= 0 || gpu < 0 || quota < 0 {
        panic("contingent budget is not canonical")
    }
    ContingentBudget { tokens: tokens, wall: wall, gpu: gpu, quota: quota }
}

pub fn compile_contingent_policy(
    budget: ContingentBudget,
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_resource_token: i64,
    owner_token: i64,
    generation_token: i64,
    token_cost: i64,
    wall_cost: i64,
    gpu_cost: i64,
    quota_cost: i64,
    policy_digest: ContingentDigest256,
) -> (ContingentBudget, LiveContingentPolicy) with Panic {
    let ContingentBudget { tokens, wall, gpu, quota } = budget
    if policy_token <= 0 || selected_policy_token <= 0 ||
        current_action_token <= 0 || current_resource_token <= 0 ||
        owner_token <= 0 || generation_token <= 0 ||
        token_cost <= 0 || wall_cost <= 0 || gpu_cost < 0 || quota_cost < 0 ||
        token_cost > tokens || wall_cost > wall || gpu_cost > gpu ||
        quota_cost > quota || !contingent_digest_is_nonzero(policy_digest) {
        panic("compiled contingent policy is not canonical")
    }
    (
        ContingentBudget {
            tokens: tokens - token_cost,
            wall: wall - wall_cost,
            gpu: gpu - gpu_cost,
            quota: quota - quota_cost,
        },
        LiveContingentPolicy {
            policy_token: policy_token,
            selected_policy_token: selected_policy_token,
            current_action_token: current_action_token,
            current_resource_token: current_resource_token,
            owner_token: owner_token,
            generation_token: generation_token,
            policy_digest: policy_digest,
        },
    )
}

pub fn advance_contingent_policy(
    policy: LiveContingentPolicy,
    next_action_token: i64,
    next_resource_token: i64,
    branch_digest: ContingentDigest256,
    outcome_digest: ContingentDigest256,
) -> LiveContingentPolicy with Panic {
    let LiveContingentPolicy {
        policy_token, selected_policy_token, current_action_token: _,
        current_resource_token: _, owner_token, generation_token,
        policy_digest,
    } = policy
    if next_action_token <= 0 || next_resource_token <= 0 ||
        !contingent_digest_is_nonzero(branch_digest) ||
        !contingent_digest_is_nonzero(outcome_digest) {
        panic("contingent advance is not canonical")
    }
    LiveContingentPolicy {
        policy_token: policy_token,
        selected_policy_token: selected_policy_token,
        current_action_token: next_action_token,
        current_resource_token: next_resource_token,
        owner_token: owner_token,
        generation_token: generation_token,
        policy_digest: policy_digest,
    }
}

pub fn complete_contingent_policy(
    policy: LiveContingentPolicy,
    branch_digest: ContingentDigest256,
    outcome_digest: ContingentDigest256,
) -> CompletedContingentPolicy with Panic {
    let LiveContingentPolicy {
        policy_token, selected_policy_token, current_action_token: _,
        current_resource_token: _, owner_token: _, generation_token: _,
        policy_digest: _,
    } = policy
    if !contingent_digest_is_nonzero(branch_digest) ||
        !contingent_digest_is_nonzero(outcome_digest) {
        panic("contingent completion is not canonical")
    }
    CompletedContingentPolicy {
        policy_token: policy_token,
        selected_policy_token: selected_policy_token,
        outcome_digest: outcome_digest,
    }
}

pub fn close_contingent_budget(budget: ContingentBudget) -> i64 {
    let ContingentBudget { tokens, wall, gpu, quota } = budget
    tokens + wall + gpu + quota
}

pub fn close_live_contingent_policy(policy: LiveContingentPolicy) -> i64 {
    let LiveContingentPolicy {
        policy_token, selected_policy_token, current_action_token,
        current_resource_token, owner_token: _, generation_token: _,
        policy_digest: _,
    } = policy
    policy_token + selected_policy_token + current_action_token +
        current_resource_token
}

pub fn close_completed_contingent_policy(
    policy: CompletedContingentPolicy,
) -> i64 {
    let CompletedContingentPolicy {
        policy_token, selected_policy_token, outcome_digest: _,
    } = policy
    policy_token + selected_policy_token
}
