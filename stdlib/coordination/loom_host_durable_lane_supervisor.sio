//! LOOM action 9032: semantic authority for host-durable lane continuity.
//!
//! Same-physical reattach and lineage resurrection are intentionally distinct.

struct LoomHostDurableLaneObservation {
    stage: i64,
    preregistered: i64,
    producer_sounio: i64,
    expected_result_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    transport_replaced: i64,
    predecessor_transport_extinct: i64,
    state_root_bound: i64,
    state_root_equal: i64,
    guardian_live: i64,
    guardian_pid_equal: i64,
    guardian_start_equal: i64,
    guardian_instance_equal: i64,
    harness_live: i64,
    harness_pid_equal: i64,
    harness_start_equal: i64,
    command_equal: i64,
    boot_id_equal: i64,
    output_prefix_preserved: i64,
    semantic_journal_verified: i64,
    guardian_journal_verified: i64,
    kernel_recovered: i64,
    new_generation: i64,
    predecessor_receipt_verified: i64,
    lineage_verified: i64,
    predecessor_heads_bound: i64,
    no_same_pty_claim_after_loss: i64,
    material_observation_joined: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

pub fn loom_host_durable_lane_observation(
    stage: i64, preregistered: i64,
    producer_sounio: i64, expected_result_sounio: i64,
    python_absent: i64, rust_absent: i64,
    transport_replaced: i64, predecessor_transport_extinct: i64,
    state_root_bound: i64, state_root_equal: i64,
    guardian_live: i64, guardian_pid_equal: i64,
    guardian_start_equal: i64, guardian_instance_equal: i64,
    harness_live: i64, harness_pid_equal: i64,
    harness_start_equal: i64, command_equal: i64,
    boot_id_equal: i64, output_prefix_preserved: i64,
    semantic_journal_verified: i64, guardian_journal_verified: i64,
    kernel_recovered: i64, new_generation: i64,
    predecessor_receipt_verified: i64, lineage_verified: i64,
    predecessor_heads_bound: i64, no_same_pty_claim_after_loss: i64,
    material_observation_joined: i64,
    sabotage_count: i64, sabotage_required: i64,
) -> LoomHostDurableLaneObservation {
    LoomHostDurableLaneObservation {
        stage: stage, preregistered: preregistered,
        producer_sounio: producer_sounio,
        expected_result_sounio: expected_result_sounio,
        python_absent: python_absent, rust_absent: rust_absent,
        transport_replaced: transport_replaced,
        predecessor_transport_extinct: predecessor_transport_extinct,
        state_root_bound: state_root_bound, state_root_equal: state_root_equal,
        guardian_live: guardian_live, guardian_pid_equal: guardian_pid_equal,
        guardian_start_equal: guardian_start_equal,
        guardian_instance_equal: guardian_instance_equal,
        harness_live: harness_live, harness_pid_equal: harness_pid_equal,
        harness_start_equal: harness_start_equal, command_equal: command_equal,
        boot_id_equal: boot_id_equal,
        output_prefix_preserved: output_prefix_preserved,
        semantic_journal_verified: semantic_journal_verified,
        guardian_journal_verified: guardian_journal_verified,
        kernel_recovered: kernel_recovered, new_generation: new_generation,
        predecessor_receipt_verified: predecessor_receipt_verified,
        lineage_verified: lineage_verified,
        predecessor_heads_bound: predecessor_heads_bound,
        no_same_pty_claim_after_loss: no_same_pty_claim_after_loss,
        material_observation_joined: material_observation_joined,
        sabotage_count: sabotage_count, sabotage_required: sabotage_required,
    }
}

// 1 = SAME_PHYSICAL_REATTACH, 2 = LINEAGE_RESURRECTION.
// Other values are refusal codes owned by Sounio.
pub fn judge_loom_host_durable_lane(
    observation: LoomHostDurableLaneObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 {
        return 405
    }
    if observation.producer_sounio != 1 ||
        observation.expected_result_sounio != 1 ||
        observation.python_absent != 1 || observation.rust_absent != 1 {
        return 522
    }
    if observation.state_root_bound != 1 ||
        observation.material_observation_joined != 1 ||
        observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required {
        return 523
    }
    if observation.guardian_live == 1 {
        if observation.transport_replaced != 1 ||
            observation.predecessor_transport_extinct != 1 ||
            observation.new_generation != 0 {
            return 524
        }
        if observation.state_root_equal != 1 {
            return 525
        }
        if observation.guardian_pid_equal != 1 ||
            observation.guardian_start_equal != 1 ||
            observation.guardian_instance_equal != 1 {
            return 526
        }
        if observation.harness_live != 1 ||
            observation.harness_pid_equal != 1 ||
            observation.harness_start_equal != 1 ||
            observation.command_equal != 1 || observation.boot_id_equal != 1 {
            return 527
        }
        if observation.output_prefix_preserved != 1 ||
            observation.semantic_journal_verified != 1 ||
            observation.guardian_journal_verified != 1 ||
            observation.kernel_recovered != 1 {
            return 528
        }
        return 1
    }
    if observation.new_generation != 1 {
        return 529
    }
    if observation.no_same_pty_claim_after_loss != 1 {
        return 530
    }
    if observation.transport_replaced != 1 ||
        observation.predecessor_transport_extinct != 1 ||
        observation.state_root_equal != 1 || observation.command_equal != 1 ||
        observation.semantic_journal_verified != 1 ||
        observation.guardian_journal_verified != 1 ||
        observation.predecessor_receipt_verified != 1 ||
        observation.lineage_verified != 1 ||
        observation.predecessor_heads_bound != 1 {
        return 531
    }
    2
}

fn loom_host_durable_lane_case(case_index: i64) -> i64 {
    let lineage = case_index == 2 || case_index == 9
    let observation = loom_host_durable_lane_observation(
        3, 1,
        if case_index == 3 { 0 } else { 1 }, 1,
        1, 1,
        if case_index == 4 { 0 } else { 1 }, 1,
        1, if case_index == 5 { 0 } else { 1 },
        if lineage { 0 } else { 1 }, 1,
        if case_index == 6 { 0 } else { 1 }, 1,
        1, 1, 1, 1, 1,
        if case_index == 7 { 0 } else { 1 },
        1, 1, if lineage { 0 } else { 1 },
        if lineage { 1 } else { 0 },
        if lineage { 1 } else { 0 },
        if lineage { 1 } else { 0 },
        if lineage { 1 } else { 0 },
        if case_index == 9 { 0 } else { 1 },
        1,
        if case_index == 10 { 0 } else { 1 }, 1,
    )
    judge_loom_host_durable_lane(observation)
}

pub fn loom_host_durable_lane_selftest() -> i64 {
    if loom_host_durable_lane_case(1) != 1 { return 1 }
    if loom_host_durable_lane_case(2) != 2 { return 2 }
    if loom_host_durable_lane_case(3) != 522 { return 3 }
    if loom_host_durable_lane_case(4) != 524 { return 4 }
    if loom_host_durable_lane_case(5) != 525 { return 5 }
    if loom_host_durable_lane_case(6) != 526 { return 6 }
    if loom_host_durable_lane_case(7) != 528 { return 7 }
    if loom_host_durable_lane_case(8) != 1 { return 8 }
    if loom_host_durable_lane_case(9) != 530 { return 9 }
    if loom_host_durable_lane_case(10) != 523 { return 10 }
    0
}
