fn loom_kernel_exec_grant_cell_test_digest(kind: i64) -> LoomKernelExecGrantCellDigest256 {
    if kind == 1 {
        return admit_loom_kernel_exec_grant_cell_digest256(1, 1, 1, 1, 1, 1, 1, 1)
    }
    admit_loom_kernel_exec_grant_cell_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn loom_kernel_exec_grant_cell_test_case(
    stage: i64, preregistered: i64, operation: i64,
    parents_ok: i64, identity_ok: i64, peer_ok: i64, shape_ok: i64,
    consumption_ok: i64, revocation_ok: i64, extinction_ok: i64,
    outcome_ok: i64, authority_ok: i64, provenance_ok: i64,
    sabotage_count: i64, parent_hashes_ok: i64,
) -> i64 {
    let ordinary = loom_kernel_exec_grant_cell_test_digest(provenance_ok)
    let parent_9029 = if parent_hashes_ok == 1 {
        loom_kernel_exec_grant_cell_parent_9029()
    } else { ordinary }
    let parent_9021 = if parent_hashes_ok == 1 {
        loom_kernel_exec_grant_cell_parent_9021()
    } else { ordinary }
    let parent_9022 = if parent_hashes_ok == 1 {
        loom_kernel_exec_grant_cell_parent_9022()
    } else { ordinary }
    let current_state = if operation == 1 { 0 } else if operation == 2 { 1 } else if operation == 3 { 3 } else { 1 }
    let next_state = if operation == 1 { 1 } else if operation == 2 { 3 } else if operation == 3 { 4 } else { 5 }
    let terminal = operation == 3 || operation == 4
    loom_kernel_exec_grant_cell_authority_decide(
        stage,
        preregistered,
        admit_loom_kernel_exec_grant_cell_transition(
            operation, current_state, next_state, 2, 3, 4, 5, 6, 7, 100, 50,
        ),
        admit_loom_kernel_exec_grant_cell_parents(
            1,
            parents_ok,
            if operation == 2 || operation == 3 { parents_ok } else { 0 },
            if operation == 3 { parents_ok } else { 0 },
            if operation == 4 { parents_ok } else { 0 },
            parents_ok,
            if operation == 2 || operation == 3 { parents_ok } else { 0 },
            if operation == 3 { parents_ok } else { 0 },
        ),
        admit_loom_kernel_exec_grant_cell_identity(
            identity_ok, identity_ok, identity_ok, identity_ok,
            identity_ok, identity_ok, identity_ok, identity_ok,
        ),
        admit_loom_kernel_exec_grant_cell_peer(
            peer_ok, peer_ok, peer_ok, peer_ok, peer_ok,
            peer_ok, peer_ok, peer_ok, peer_ok,
        ),
        admit_loom_kernel_exec_grant_cell_write_shape(
            shape_ok, shape_ok, shape_ok, shape_ok,
            shape_ok, shape_ok, shape_ok, shape_ok,
        ),
        admit_loom_kernel_exec_grant_cell_consumption(
            consumption_ok, consumption_ok, consumption_ok, consumption_ok,
            consumption_ok, consumption_ok, consumption_ok,
        ),
        admit_loom_kernel_exec_grant_cell_revocation(
            revocation_ok, revocation_ok, revocation_ok, revocation_ok,
            revocation_ok, revocation_ok, revocation_ok,
        ),
        admit_loom_kernel_exec_grant_cell_extinction(
            if terminal { extinction_ok } else { 0 },
