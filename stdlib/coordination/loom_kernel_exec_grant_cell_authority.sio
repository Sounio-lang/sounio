        2708941890, 3284947684, 758124027, 2068177262,
    )
}

pub fn loom_kernel_exec_grant_cell_authority_decide(
    stage: i64,
    action_9030_preregistered: i64,
    transition: LoomKernelExecGrantCellTransition,
    parents: LoomKernelExecGrantCellParents,
    identity: LoomKernelExecGrantCellIdentity,
    peer: LoomKernelExecGrantCellPeer,
    shape: LoomKernelExecGrantCellWriteShape,
    consumption: LoomKernelExecGrantCellConsumption,
    revocation: LoomKernelExecGrantCellRevocation,
    extinction: LoomKernelExecGrantCellExtinction,
    outcome: LoomKernelExecGrantCellOutcome,
    authority: LoomKernelExecGrantCellAuthority,
    evidence: LoomKernelExecGrantCellEvidence,
    bindings: LoomKernelExecGrantCellBindings,
) -> i64 {
    if stage < 1 || stage > 7 ||
        !loom_kernel_exec_grant_cell_flag(action_9030_preregistered) ||
        transition.operation < 1 || transition.operation > 4 ||
        transition.current_state < 0 || transition.current_state > 6 ||
        transition.next_state < 0 || transition.next_state > 6 ||
        transition.broker_epoch < 0 || transition.lease_generation < 0 ||
        transition.custody_generation < 0 ||
        transition.invocation_generation < 0 ||
        transition.grant_generation < 0 || transition.event_sequence < 0 ||
        transition.deadline_tick < 0 || transition.budget_remaining < 0 ||
        !loom_kernel_exec_grant_cell_flag(parents.manifests_bound) ||
        !loom_kernel_exec_grant_cell_flag(parents.action_9029_prepare_allow) ||
        !loom_kernel_exec_grant_cell_flag(parents.action_9029_admit_allow) ||
        !loom_kernel_exec_grant_cell_flag(parents.action_9029_close_allow) ||
        !loom_kernel_exec_grant_cell_flag(parents.action_9029_abort_allow) ||
        !loom_kernel_exec_grant_cell_flag(parents.action_9021_issue_allow) ||
        !loom_kernel_exec_grant_cell_flag(parents.action_9021_recheck_allow) ||
        !loom_kernel_exec_grant_cell_flag(parents.action_9022_outcome_allow) ||
        !loom_kernel_exec_grant_cell_flag(identity.capsule_bound) ||
        !loom_kernel_exec_grant_cell_flag(identity.invocation_cell_bound) ||
        !loom_kernel_exec_grant_cell_flag(identity.command_equal) ||
        !loom_kernel_exec_grant_cell_flag(identity.environment_equal) ||
        !loom_kernel_exec_grant_cell_flag(identity.principal_equal) ||
        !loom_kernel_exec_grant_cell_flag(identity.generation_vector_bound) ||
        !loom_kernel_exec_grant_cell_flag(identity.generation_vector_equal) ||
        !loom_kernel_exec_grant_cell_flag(identity.material_observation_joined) ||
        !loom_kernel_exec_grant_cell_flag(peer.so_peercred_bound) ||
        !loom_kernel_exec_grant_cell_flag(peer.pidfd_bound) ||
        !loom_kernel_exec_grant_cell_flag(peer.start_tick_bound) ||
        !loom_kernel_exec_grant_cell_flag(peer.boot_namespace_bound) ||
        !loom_kernel_exec_grant_cell_flag(peer.harness_ancestry_bound) ||
        !loom_kernel_exec_grant_cell_flag(peer.worktree_cgroup_bound) ||
        !loom_kernel_exec_grant_cell_flag(peer.kernel_principal_distinct) ||
        !loom_kernel_exec_grant_cell_flag(peer.anti_injection_attested) ||
        !loom_kernel_exec_grant_cell_flag(peer.peer_operation_equal) ||
        !loom_kernel_exec_grant_cell_flag(shape.prewrite_validated) ||
        !loom_kernel_exec_grant_cell_flag(shape.closed_domain) ||
        !loom_kernel_exec_grant_cell_flag(shape.legal_transition) ||
        !loom_kernel_exec_grant_cell_flag(shape.generations_monotonic) ||
        !loom_kernel_exec_grant_cell_flag(shape.all_hashes_bound) ||
        !loom_kernel_exec_grant_cell_flag(shape.old_state_receipt_bound) ||
        !loom_kernel_exec_grant_cell_flag(shape.proposed_receipt_bound) ||
        !loom_kernel_exec_grant_cell_flag(shape.no_mutation_on_deny) ||
        !loom_kernel_exec_grant_cell_flag(consumption.handle_lookup_only) ||
        !loom_kernel_exec_grant_cell_flag(consumption.authenticated_before_lookup) ||
        !loom_kernel_exec_grant_cell_flag(consumption.single_writer) ||
        !loom_kernel_exec_grant_cell_flag(consumption.atomic_consume) ||
        !loom_kernel_exec_grant_cell_flag(consumption.barrier_custody) ||
        !loom_kernel_exec_grant_cell_flag(consumption.replay_isolated) ||
        !loom_kernel_exec_grant_cell_flag(consumption.filesystem_authority_absent) ||
        !loom_kernel_exec_grant_cell_flag(revocation.deadline_bound) ||
        !loom_kernel_exec_grant_cell_flag(revocation.deadline_live) ||
        !loom_kernel_exec_grant_cell_flag(revocation.policy_failure_closed) ||
        !loom_kernel_exec_grant_cell_flag(revocation.broker_loss_revokes) ||
        !loom_kernel_exec_grant_cell_flag(revocation.kernel_loss_revokes) ||
        !loom_kernel_exec_grant_cell_flag(revocation.guardian_loss_revokes) ||
        !loom_kernel_exec_grant_cell_flag(revocation.quarantine_on_uncertainty) ||
        !loom_kernel_exec_grant_cell_flag(extinction.state_absence_observed) ||
        !loom_kernel_exec_grant_cell_flag(extinction.generation_retired) ||
        !loom_kernel_exec_grant_cell_flag(extinction.authority_revoked) ||
        !loom_kernel_exec_grant_cell_flag(extinction.terminal_receipt_bound) ||
        !loom_kernel_exec_grant_cell_flag(extinction.silence_rejected) ||
        !loom_kernel_exec_grant_cell_flag(outcome.obligation_bound) ||
        !loom_kernel_exec_grant_cell_flag(outcome.outcome_complete) ||
        !loom_kernel_exec_grant_cell_flag(outcome.tree_quiescent) ||
        !loom_kernel_exec_grant_cell_flag(outcome.open_effects_zero) ||
        !loom_kernel_exec_grant_cell_flag(outcome.terminal_receipts_complete) ||
        !loom_kernel_exec_grant_cell_flag(outcome.journal_committed_before_remove) ||
        !loom_kernel_exec_grant_cell_flag(outcome.incomplete_materialized) ||
        !loom_kernel_exec_grant_cell_flag(outcome.success_absent) ||
        !loom_kernel_exec_grant_cell_flag(authority.producer_sounio) ||
        !loom_kernel_exec_grant_cell_flag(authority.expected_result_sounio) ||
        !loom_kernel_exec_grant_cell_flag(authority.python_absent) ||
        !loom_kernel_exec_grant_cell_flag(authority.rust_absent) ||
        !loom_kernel_exec_grant_cell_flag(authority.review_unpromoted) ||
        !loom_kernel_exec_grant_cell_flag(authority.parity_unpromoted) ||
        !loom_kernel_exec_grant_cell_flag(authority.bearer_authority_absent) ||
        !loom_kernel_exec_grant_cell_flag(evidence.provenance_complete) ||
        !loom_kernel_exec_grant_cell_flag(evidence.receipt_bound) ||
        evidence.sabotage_count < 0 || evidence.sabotage_count > 11 ||
        evidence.sabotage_required < 0 || evidence.sabotage_required > 11 {
        return 424
    }

    if stage < 3 || action_9030_preregistered != 1 ||
        parents.manifests_bound != 1 ||
        !loom_kernel_exec_grant_cell_digest_equal(
            bindings.parent_9029_manifest_hash,
            loom_kernel_exec_grant_cell_parent_9029(),
        ) ||
        !loom_kernel_exec_grant_cell_digest_equal(
            bindings.parent_9021_manifest_hash,
            loom_kernel_exec_grant_cell_parent_9021(),
        ) ||
        !loom_kernel_exec_grant_cell_digest_equal(
            bindings.parent_9022_manifest_hash,
            loom_kernel_exec_grant_cell_parent_9022(),
        ) {
        return 405
    }

    // Causal control: removing only this line admits a grant without the exact Sounio parent decisions for its operation.
