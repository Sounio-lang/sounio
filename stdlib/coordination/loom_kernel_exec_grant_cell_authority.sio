fn loom_kernel_exec_grant_cell_flag(value: i64) -> bool {
    value == 0 || value == 1
}

fn loom_kernel_exec_grant_cell_digest_nonzero(
    value: LoomKernelExecGrantCellDigest256,
) -> bool {
    value.limb0 != 0 || value.limb1 != 0 || value.limb2 != 0 ||
        value.limb3 != 0 || value.limb4 != 0 || value.limb5 != 0 ||
        value.limb6 != 0 || value.limb7 != 0
}

fn loom_kernel_exec_grant_cell_digest_equal(
    left: LoomKernelExecGrantCellDigest256,
    right: LoomKernelExecGrantCellDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
        left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
        left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
        left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn loom_kernel_exec_grant_cell_parent_9029() -> LoomKernelExecGrantCellDigest256 {
    admit_loom_kernel_exec_grant_cell_digest256(
        1636926980, 3205986131, 3323207532, 3505413428,
        706242987, 2411760920, 1929815169, 3727939342,
    )
}

