//! LOOM action 9030: Sounio semantic authority for one ExecGrantCell.
//!
//! A handle is only a lookup coordinate. Authority remains a conjunction of
//! frozen parents, kernel-derived peer identity, pre-write shape validation,
//! atomic one-shot custody, and affirmative extinction.

struct LoomKernelExecGrantCellDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomKernelExecGrantCellTransition {
    operation: i64,
    current_state: i64,
    next_state: i64,
    broker_epoch: i64,
    lease_generation: i64,
    custody_generation: i64,
    invocation_generation: i64,
    grant_generation: i64,
    event_sequence: i64,
    deadline_tick: i64,
    budget_remaining: i64,
}

struct LoomKernelExecGrantCellParents {
    manifests_bound: i64,
    action_9029_prepare_allow: i64,
    action_9029_admit_allow: i64,
    action_9029_close_allow: i64,
    action_9029_abort_allow: i64,
    action_9021_issue_allow: i64,
    action_9021_recheck_allow: i64,
    action_9022_outcome_allow: i64,
}

struct LoomKernelExecGrantCellIdentity {
    capsule_bound: i64,
    invocation_cell_bound: i64,
    command_equal: i64,
    environment_equal: i64,
    principal_equal: i64,
    generation_vector_bound: i64,
    generation_vector_equal: i64,
    material_observation_joined: i64,
}

struct LoomKernelExecGrantCellPeer {
    so_peercred_bound: i64,
    pidfd_bound: i64,
    start_tick_bound: i64,
    boot_namespace_bound: i64,
    harness_ancestry_bound: i64,
    worktree_cgroup_bound: i64,
    kernel_principal_distinct: i64,
    anti_injection_attested: i64,
    peer_operation_equal: i64,
}

struct LoomKernelExecGrantCellWriteShape {
    prewrite_validated: i64,
    closed_domain: i64,
    legal_transition: i64,
    generations_monotonic: i64,
    all_hashes_bound: i64,
    old_state_receipt_bound: i64,
    proposed_receipt_bound: i64,
    no_mutation_on_deny: i64,
}

struct LoomKernelExecGrantCellConsumption {
    handle_lookup_only: i64,
    authenticated_before_lookup: i64,
    single_writer: i64,
    atomic_consume: i64,
    barrier_custody: i64,
    replay_isolated: i64,
    filesystem_authority_absent: i64,
}

struct LoomKernelExecGrantCellRevocation {
    deadline_bound: i64,
    deadline_live: i64,
    policy_failure_closed: i64,
    broker_loss_revokes: i64,
    kernel_loss_revokes: i64,
    guardian_loss_revokes: i64,
    quarantine_on_uncertainty: i64,
}

struct LoomKernelExecGrantCellExtinction {
    state_absence_observed: i64,
    generation_retired: i64,
    authority_revoked: i64,
    terminal_receipt_bound: i64,
    silence_rejected: i64,
}

struct LoomKernelExecGrantCellOutcome {
    obligation_bound: i64,
    outcome_complete: i64,
    tree_quiescent: i64,
    open_effects_zero: i64,
    terminal_receipts_complete: i64,
    journal_committed_before_remove: i64,
    incomplete_materialized: i64,
    success_absent: i64,
}

struct LoomKernelExecGrantCellAuthority {
    producer_sounio: i64,
    expected_result_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    review_unpromoted: i64,
    parity_unpromoted: i64,
    bearer_authority_absent: i64,
}

struct LoomKernelExecGrantCellEvidence {
    provenance_complete: i64,
    receipt_bound: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

struct LoomKernelExecGrantCellBindings {
    parent_9029_manifest_hash: LoomKernelExecGrantCellDigest256,
    parent_9021_manifest_hash: LoomKernelExecGrantCellDigest256,
    parent_9022_manifest_hash: LoomKernelExecGrantCellDigest256,
    grant_identity_hash: LoomKernelExecGrantCellDigest256,
    command_environment_hash: LoomKernelExecGrantCellDigest256,
    peer_vector_hash: LoomKernelExecGrantCellDigest256,
    transition_journal_hash: LoomKernelExecGrantCellDigest256,
    source_semantics_toolchain_hash: LoomKernelExecGrantCellDigest256,
    result_receipt_hash: LoomKernelExecGrantCellDigest256,
}

