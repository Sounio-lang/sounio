        admit_loom_kernel_exec_grant_cell_outcome(
            if operation == 3 { outcome_ok } else { 0 },
            if operation == 3 { outcome_ok } else { 0 },
            if operation == 3 { outcome_ok } else { 0 },
            if operation == 3 { outcome_ok } else { 0 },
            if operation == 3 { outcome_ok } else { 0 },
            if terminal { outcome_ok } else { 0 },
            if operation == 4 { outcome_ok } else { 0 },
            if operation == 4 { outcome_ok } else { 0 },
        ),
        admit_loom_kernel_exec_grant_cell_authority(
            authority_ok, authority_ok, authority_ok, authority_ok,
            authority_ok, authority_ok, authority_ok,
        ),
        admit_loom_kernel_exec_grant_cell_evidence(
            provenance_ok, provenance_ok, sabotage_count, 11,
        ),
        admit_loom_kernel_exec_grant_cell_bindings(
            parent_9029, parent_9021, parent_9022,
