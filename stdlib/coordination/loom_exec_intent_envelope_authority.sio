//! LOOM action 9034: semantic authority for one typed ExecIntent envelope.
//!
//! V1 is closed over the frozen calibration command. Raw provider JSON is
//! evidence, not semantic identity.

struct LoomExecIntentDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomExecIntentObservation {
    stage: i64,
    preregistered: i64,
    operation: i64,
    parent_9031_manifest_sha256: LoomExecIntentDigest256,
    parent_9033_manifest_sha256: LoomExecIntentDigest256,
    canonical_schema: i64,
    ordered_fields: i64,
    domain_separated: i64,
    agent_identity_present: i64,
    lane_identity_present: i64,
    session_identity_present: i64,
    cwd_identity_present: i64,
    provider_hook_event: i64,
    execution_tool: i64,
    semantic_event_sha256: LoomExecIntentDigest256,
    command_sha256: LoomExecIntentDigest256,
    descriptor_inherited: i64,
    descriptor_peer_authenticated: i64,
    lane_principal_bound: i64,
    descriptor_one_shot: i64,
    pathname_not_authority: i64,
    producer_sounio: i64,
    expected_result_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    review_unpromoted: i64,
    parity_unpromoted: i64,
    disposable_oracle_absent: i64,
    provenance_complete: i64,
    raw_event_digest_audited: i64,
    raw_event_separate: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

pub fn loom_exec_intent_digest256(
    limb0: i64, limb1: i64, limb2: i64, limb3: i64,
    limb4: i64, limb5: i64, limb6: i64, limb7: i64,
) -> LoomExecIntentDigest256 {
    LoomExecIntentDigest256 {
        limb0: limb0, limb1: limb1, limb2: limb2, limb3: limb3,
        limb4: limb4, limb5: limb5, limb6: limb6, limb7: limb7,
    }
}

fn loom_exec_intent_equal(
    left: LoomExecIntentDigest256,
    right: LoomExecIntentDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn loom_exec_intent_zero() -> LoomExecIntentDigest256 {
    loom_exec_intent_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn loom_exec_intent_parent_9031() -> LoomExecIntentDigest256 {
    loom_exec_intent_digest256(
        4074394899, 2345657768, 2730909373, 2042750260,
        4048728890, 4123446333, 522931891, 3031395966,
    )
}

fn loom_exec_intent_parent_9033() -> LoomExecIntentDigest256 {
    loom_exec_intent_digest256(
        2082034985, 2670407820, 857170038, 1277729638,
        395380041, 3051341500, 1290901140, 1462790741,
    )
}

fn loom_exec_intent_fixture_event() -> LoomExecIntentDigest256 {
    loom_exec_intent_digest256(
        289083261, 706706140, 1533585710, 4084982632,
        2597125707, 3137391438, 2350251066, 3082223635,
    )
}

fn loom_exec_intent_fixture_command() -> LoomExecIntentDigest256 {
    loom_exec_intent_digest256(
        134198296, 1998023264, 2957593053, 2026443539,
        2504906585, 1497309287, 2048602063, 4003666528,
    )
}

fn loom_exec_intent_command_binding_rule(
    command_sha256: LoomExecIntentDigest256,
) -> bool {
    loom_exec_intent_equal(command_sha256, loom_exec_intent_fixture_command())
}

// 1 = PROJECT. All other values are fail-closed refusal codes.
pub fn judge_loom_exec_intent_envelope(
    observation: LoomExecIntentObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 ||
        observation.operation != 1 {
        return 405
    }
    if observation.producer_sounio != 1 ||
        observation.expected_result_sounio != 1 ||
        observation.python_absent != 1 || observation.rust_absent != 1 ||
        observation.review_unpromoted != 1 ||
        observation.parity_unpromoted != 1 ||
        observation.disposable_oracle_absent != 1 {
        return 550
    }
    if !loom_exec_intent_equal(
            observation.parent_9031_manifest_sha256,
            loom_exec_intent_parent_9031()) ||
        !loom_exec_intent_equal(
            observation.parent_9033_manifest_sha256,
            loom_exec_intent_parent_9033()) {
        return 551
    }
    if observation.canonical_schema != 1 ||
        observation.ordered_fields != 1 ||
        observation.domain_separated != 1 {
        return 552
    }
    if observation.agent_identity_present != 1 ||
        observation.lane_identity_present != 1 ||
        observation.session_identity_present != 1 ||
        observation.cwd_identity_present != 1 ||
        observation.provider_hook_event != 1 ||
        observation.execution_tool != 1 {
        return 553
    }
    if !loom_exec_intent_equal(
            observation.semantic_event_sha256,
            loom_exec_intent_fixture_event()) {
        return 554
    }
    // Causal control: deleting only this rule must admit the unchanged
    // wrong-command witness.
    if !loom_exec_intent_command_binding_rule(observation.command_sha256) {
        return 555
    }
    if observation.descriptor_inherited != 1 ||
        observation.descriptor_peer_authenticated != 1 ||
        observation.lane_principal_bound != 1 ||
        observation.descriptor_one_shot != 1 ||
        observation.pathname_not_authority != 1 {
        return 556
    }
    if observation.provenance_complete != 1 ||
        observation.raw_event_digest_audited != 1 ||
        observation.raw_event_separate != 1 ||
        observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required {
        return 557
    }
    1
}

fn loom_exec_intent_v1_bit(mask: i64, divisor: i64) -> i64 with Div {
    (mask / divisor) % 2
}

pub fn judge_loom_exec_intent_envelope_v1_words(
    word0: i64,
    word1: i64,
) -> i64 with Div {
    let parent_mask = (word0 >> 4) & 3
    let shape_mask = (word0 >> 6) & 7
    let identity_mask = (word0 >> 9) & 63
    let binding_mask = (word0 >> 15) & 3
    let descriptor_mask = (word0 >> 17) & 31
    let authority_mask = word1 & 127
    let evidence_mask = (word1 >> 7) & 7
    let sabotage_count = (word1 >> 10) & 255
    let sabotage_required = (word1 >> 18) & 255
    let observation = LoomExecIntentObservation {
        stage: word0 & 3,
        preregistered: (word0 >> 2) & 1,
        operation: (word0 >> 3) & 1,
        parent_9031_manifest_sha256:
            if loom_exec_intent_v1_bit(parent_mask, 1) == 1 {
                loom_exec_intent_parent_9031()
            } else { loom_exec_intent_zero() },
        parent_9033_manifest_sha256:
            if loom_exec_intent_v1_bit(parent_mask, 2) == 1 {
                loom_exec_intent_parent_9033()
            } else { loom_exec_intent_zero() },
        canonical_schema: loom_exec_intent_v1_bit(shape_mask, 1),
        ordered_fields: loom_exec_intent_v1_bit(shape_mask, 2),
        domain_separated: loom_exec_intent_v1_bit(shape_mask, 4),
        agent_identity_present: loom_exec_intent_v1_bit(identity_mask, 1),
        lane_identity_present: loom_exec_intent_v1_bit(identity_mask, 2),
        session_identity_present: loom_exec_intent_v1_bit(identity_mask, 4),
        cwd_identity_present: loom_exec_intent_v1_bit(identity_mask, 8),
        provider_hook_event: loom_exec_intent_v1_bit(identity_mask, 16),
        execution_tool: loom_exec_intent_v1_bit(identity_mask, 32),
        semantic_event_sha256:
            if loom_exec_intent_v1_bit(binding_mask, 1) == 1 {
                loom_exec_intent_fixture_event()
            } else { loom_exec_intent_zero() },
        command_sha256:
            if loom_exec_intent_v1_bit(binding_mask, 2) == 1 {
                loom_exec_intent_fixture_command()
            } else { loom_exec_intent_zero() },
        descriptor_inherited: loom_exec_intent_v1_bit(descriptor_mask, 1),
        descriptor_peer_authenticated: loom_exec_intent_v1_bit(descriptor_mask, 2),
        lane_principal_bound: loom_exec_intent_v1_bit(descriptor_mask, 4),
        descriptor_one_shot: loom_exec_intent_v1_bit(descriptor_mask, 8),
        pathname_not_authority: loom_exec_intent_v1_bit(descriptor_mask, 16),
        producer_sounio: loom_exec_intent_v1_bit(authority_mask, 1),
        expected_result_sounio: loom_exec_intent_v1_bit(authority_mask, 2),
        python_absent: loom_exec_intent_v1_bit(authority_mask, 4),
        rust_absent: loom_exec_intent_v1_bit(authority_mask, 8),
        review_unpromoted: loom_exec_intent_v1_bit(authority_mask, 16),
        parity_unpromoted: loom_exec_intent_v1_bit(authority_mask, 32),
        disposable_oracle_absent: loom_exec_intent_v1_bit(authority_mask, 64),
        provenance_complete: loom_exec_intent_v1_bit(evidence_mask, 1),
        raw_event_digest_audited: loom_exec_intent_v1_bit(evidence_mask, 2),
        raw_event_separate: loom_exec_intent_v1_bit(evidence_mask, 4),
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
    judge_loom_exec_intent_envelope(observation)
}

fn loom_exec_intent_case(case_index: i64) -> i64 with Div {
    let word0: i64 = 4194303
    let word1: i64 = 264191
    if case_index == 1 {
        return judge_loom_exec_intent_envelope_v1_words(word0, word1)
    }
    if case_index == 2 { return judge_loom_exec_intent_envelope_v1_words(word0 - 1, word1) }
    if case_index == 3 { return judge_loom_exec_intent_envelope_v1_words(word0, word1 - 1) }
    if case_index == 4 { return judge_loom_exec_intent_envelope_v1_words(word0 - 16, word1) }
    if case_index == 5 { return judge_loom_exec_intent_envelope_v1_words(word0 - 64, word1) }
    if case_index == 6 { return judge_loom_exec_intent_envelope_v1_words(word0 - 512, word1) }
    if case_index == 7 { return judge_loom_exec_intent_envelope_v1_words(word0 - 32768, word1) }
    if case_index == 8 { return judge_loom_exec_intent_envelope_v1_words(word0 - 65536, word1) }
    if case_index == 9 { return judge_loom_exec_intent_envelope_v1_words(word0 - 131072, word1) }
    if case_index == 10 { return judge_loom_exec_intent_envelope_v1_words(word0, word1 - 128) }
    if case_index == 11 {
        return judge_loom_exec_intent_envelope_v1_words(word0, word1 - 1024)
    }
    424
}

pub fn loom_exec_intent_envelope_selftest() -> i64 with Div {
    if loom_exec_intent_case(1) != 1 { return 1 }
    if loom_exec_intent_case(2) != 405 { return 2 }
    if loom_exec_intent_case(3) != 550 { return 3 }
    if loom_exec_intent_case(4) != 551 { return 4 }
    if loom_exec_intent_case(5) != 552 { return 5 }
    if loom_exec_intent_case(6) != 553 { return 6 }
    if loom_exec_intent_case(7) != 554 { return 7 }
    if loom_exec_intent_case(8) != 555 { return 8 }
    if loom_exec_intent_case(9) != 556 { return 9 }
    if loom_exec_intent_case(10) != 557 { return 10 }
    if loom_exec_intent_case(11) != 557 { return 11 }
    if judge_loom_exec_intent_envelope_v1_words(4194303, 264191) != 1 {
        return 12
    }
    0
}
