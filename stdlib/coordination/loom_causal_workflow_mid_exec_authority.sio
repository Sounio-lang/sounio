//! Subordinate action-9037 semantic authority for mid-EXEC transport loss.

struct LoomCausalWorkflowMidExecObservation {
    exec_started_witness_present: i64,
    guardian_generation_equal: i64,
    unit_invocation_id_equal: i64,
    material_pid_equal: i64,
    material_start_tick_equal: i64,
    material_cgroup_equal: i64,
    run_grant_generation_equal: i64,
    barrier_nonce_equal: i64,
    successor_bound: i64,
    predecessor_witness_equal: i64,
    transport_loss_observed: i64,
    completion_observed: i64,
    compile_count: i64,
    ticket_count: i64,
    launch_count: i64,
    result_count: i64,
    attestation_count: i64,
    duplicate_launch_absent: i64,
}

fn judge_loom_causal_workflow_mid_exec_identity(
    observation: LoomCausalWorkflowMidExecObservation,
) -> i64 {
    if observation.exec_started_witness_present != 1 { return 590 }
    if observation.guardian_generation_equal != 1 { return 591 }
    if observation.unit_invocation_id_equal != 1 { return 592 }
    // Load-bearing identity rule: PID equality without the start tick is not
    // a process identity, so a replacement PID is refused here.
    if observation.material_pid_equal != 1 { return 593 }
    if observation.material_start_tick_equal != 1 { return 594 }
    if observation.material_cgroup_equal != 1 { return 595 }
    if observation.run_grant_generation_equal != 1 { return 596 }
    // The barrier nonce is digest-bound to this EXEC_STARTED witness. It
    // prevents a successor from observing a completion through a stale barrier.
    if observation.barrier_nonce_equal != 1 { return 600 }
    if observation.successor_bound != 1 ||
        observation.predecessor_witness_equal != 1 { return 597 }
    if observation.transport_loss_observed != 1 { return 598 }
    1
}

fn loom_causal_workflow_mid_exec_observation(
    word0: i64,
    word1: i64,
) -> LoomCausalWorkflowMidExecObservation {
    LoomCausalWorkflowMidExecObservation {
        exec_started_witness_present: word0 & 1,
        guardian_generation_equal: (word0 >> 1) & 1,
        unit_invocation_id_equal: (word0 >> 2) & 1,
        material_pid_equal: (word0 >> 3) & 1,
        material_start_tick_equal: (word0 >> 4) & 1,
        material_cgroup_equal: (word0 >> 5) & 1,
        run_grant_generation_equal: (word0 >> 6) & 1,
        barrier_nonce_equal: (word0 >> 11) & 1,
        successor_bound: (word0 >> 7) & 1,
        predecessor_witness_equal: (word0 >> 8) & 1,
        transport_loss_observed: (word0 >> 9) & 1,
        completion_observed: (word0 >> 10) & 1,
        compile_count: word1 & 3,
        ticket_count: (word1 >> 2) & 3,
        launch_count: (word1 >> 4) & 3,
        result_count: (word1 >> 6) & 3,
        attestation_count: (word1 >> 8) & 3,
        duplicate_launch_absent: (word1 >> 10) & 1,
    }
}

pub fn judge_loom_causal_workflow_mid_exec_release_v1_words(
    word0: i64,
    word1: i64,
) -> i64 {
    let observation = loom_causal_workflow_mid_exec_observation(word0, word1)
    let identity = judge_loom_causal_workflow_mid_exec_identity(observation)
    if identity != 1 { return identity }
    if observation.completion_observed != 0 { return 601 }
    if observation.compile_count != 1 || observation.ticket_count != 1 ||
        observation.launch_count != 1 || observation.result_count != 0 ||
        observation.attestation_count != 0 ||
        observation.duplicate_launch_absent != 1 { return 599 }
    1
}

pub fn judge_loom_causal_workflow_mid_exec_claim_v1_words(
    word0: i64,
    word1: i64,
) -> i64 {
    let observation = loom_causal_workflow_mid_exec_observation(word0, word1)
    let identity = judge_loom_causal_workflow_mid_exec_identity(observation)
    if identity != 1 { return identity }
    if observation.completion_observed != 1 { return 598 }
    if observation.compile_count != 1 || observation.ticket_count != 1 ||
        observation.launch_count != 1 || observation.result_count != 1 ||
        observation.attestation_count != 1 ||
        observation.duplicate_launch_absent != 1 { return 599 }
    1
}

pub fn loom_causal_workflow_mid_exec_case(case_index: i64) -> i64 {
    let release_word0: i64 = 3071
    let release_word1: i64 = 1045
    let claim_word0: i64 = 4095
    let claim_word1: i64 = 1365
    if case_index == 1 {
        return judge_loom_causal_workflow_mid_exec_release_v1_words(
            release_word0, release_word1)
    }
    if case_index == 2 {
        return judge_loom_causal_workflow_mid_exec_claim_v1_words(
            claim_word0, claim_word1)
    }
    if case_index == 3 {
        return judge_loom_causal_workflow_mid_exec_release_v1_words(3063, release_word1)
    }
    if case_index == 4 {
        return judge_loom_causal_workflow_mid_exec_claim_v1_words(4087, claim_word1)
    }
    if case_index == 5 {
        return judge_loom_causal_workflow_mid_exec_release_v1_words(4095, release_word1)
    }
    if case_index == 6 {
        return judge_loom_causal_workflow_mid_exec_claim_v1_words(3071, claim_word1)
    }
    if case_index == 7 {
        return judge_loom_causal_workflow_mid_exec_release_v1_words(2943, release_word1)
    }
    if case_index == 8 {
        return judge_loom_causal_workflow_mid_exec_release_v1_words(3071, 21)
    }
    if case_index == 9 {
        return judge_loom_causal_workflow_mid_exec_claim_v1_words(4095, 341)
    }
    if case_index == 10 {
        return judge_loom_causal_workflow_mid_exec_claim_v1_words(2047, claim_word1)
    }
    if case_index == 11 {
        return judge_loom_causal_workflow_mid_exec_claim_v1_words(4095, 1349)
    }
    424
}

pub fn loom_causal_workflow_mid_exec_selftest() -> i64 {
    if loom_causal_workflow_mid_exec_case(1) != 1 { return 1 }
    if loom_causal_workflow_mid_exec_case(2) != 1 { return 2 }
    if loom_causal_workflow_mid_exec_case(3) != 593 { return 3 }
    if loom_causal_workflow_mid_exec_case(4) != 593 { return 4 }
    if loom_causal_workflow_mid_exec_case(5) != 601 { return 5 }
    if loom_causal_workflow_mid_exec_case(6) != 598 { return 6 }
    if loom_causal_workflow_mid_exec_case(7) != 597 { return 7 }
    if loom_causal_workflow_mid_exec_case(8) != 599 { return 8 }
    if loom_causal_workflow_mid_exec_case(9) != 599 { return 9 }
    if loom_causal_workflow_mid_exec_case(10) != 600 { return 10 }
    if loom_causal_workflow_mid_exec_case(11) != 599 { return 11 }
    0
}
