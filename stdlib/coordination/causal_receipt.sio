//! Nominal typestates for falsification-carrying development.
//!
//! The host coordination runtime remains responsible for Git ancestry,
//! canonical JSON, SHA-256 replay, and file ownership. This kernel consumes
//! opaque tokens only after that verification and prevents downstream Sounio
//! code from confusing observed, supported, falsified, and inconclusive states.

struct PreregisteredExperiment {
    experiment_token: i64,
    prereg_digest_token: i64,
    prereg_commit_token: i64,
}

struct ObservedExperiment {
    experiment_token: i64,
    prereg_digest_token: i64,
    prereg_commit_token: i64,
    subject_commit_token: i64,
    treatment_artifact_token: i64,
    control_artifact_token: i64,
    treatment_digest_token: i64,
    control_digest_token: i64,
    treatment_pass: bool,
    control_pass: bool,
}

struct SupportedExperiment {
    experiment_token: i64,
    prereg_digest_token: i64,
    subject_commit_token: i64,
    treatment_digest_token: i64,
    control_digest_token: i64,
}

struct FalsifiedExperiment {
    experiment_token: i64,
    subject_commit_token: i64,
    treatment_digest_token: i64,
    control_digest_token: i64,
}

struct InconclusiveExperiment {
    experiment_token: i64,
    subject_commit_token: i64,
    treatment_digest_token: i64,
    control_digest_token: i64,
}

// Option is intentional here: a sentinel SupportedExperiment would itself be
// a value that callers could pass to the promotion boundary after a refusal.
pub fn preregister_experiment(
    experiment_token: i64,
    prereg_digest_token: i64,
    prereg_commit_token: i64,
) -> Option<PreregisteredExperiment> {
    if experiment_token == 0 { return None }
    if prereg_digest_token == 0 { return None }
    if prereg_commit_token == 0 { return None }
    Some(PreregisteredExperiment {
        experiment_token: experiment_token,
        prereg_digest_token: prereg_digest_token,
        prereg_commit_token: prereg_commit_token,
    })
}

pub fn observe_experiment(
    prereg: PreregisteredExperiment,
    subject_commit_token: i64,
    ancestry_verified: bool,
    treatment_artifact_token: i64,
    treatment_digest_token: i64,
    treatment_pass: bool,
    control_artifact_token: i64,
    control_digest_token: i64,
    control_pass: bool,
) -> Option<ObservedExperiment> {
    if !ancestry_verified { return None }
    if subject_commit_token == 0 { return None }
    if subject_commit_token == prereg.prereg_commit_token { return None }
    if treatment_artifact_token == 0 { return None }
    if control_artifact_token == 0 { return None }
    if treatment_artifact_token == control_artifact_token { return None }
    if treatment_digest_token == 0 { return None }
    if control_digest_token == 0 { return None }
    Some(ObservedExperiment {
        experiment_token: prereg.experiment_token,
        prereg_digest_token: prereg.prereg_digest_token,
        prereg_commit_token: prereg.prereg_commit_token,
        subject_commit_token: subject_commit_token,
        treatment_artifact_token: treatment_artifact_token,
        control_artifact_token: control_artifact_token,
        treatment_digest_token: treatment_digest_token,
        control_digest_token: control_digest_token,
        treatment_pass: treatment_pass,
        control_pass: control_pass,
    })
}

pub fn support_observation(
    observed: ObservedExperiment,
) -> Option<SupportedExperiment> {
    if !observed.treatment_pass { return None }
    if observed.control_pass == false { return None }
    Some(SupportedExperiment {
        experiment_token: observed.experiment_token,
        prereg_digest_token: observed.prereg_digest_token,
        subject_commit_token: observed.subject_commit_token,
        treatment_digest_token: observed.treatment_digest_token,
        control_digest_token: observed.control_digest_token,
    })
}

pub fn retain_falsified(
    observed: ObservedExperiment,
) -> Option<FalsifiedExperiment> {
    if observed.treatment_pass { return None }
    if !observed.control_pass { return None }
    Some(FalsifiedExperiment {
        experiment_token: observed.experiment_token,
        subject_commit_token: observed.subject_commit_token,
        treatment_digest_token: observed.treatment_digest_token,
        control_digest_token: observed.control_digest_token,
    })
}

pub fn retain_inconclusive(
    observed: ObservedExperiment,
) -> Option<InconclusiveExperiment> {
    if observed.control_pass { return None }
    Some(InconclusiveExperiment {
        experiment_token: observed.experiment_token,
        subject_commit_token: observed.subject_commit_token,
        treatment_digest_token: observed.treatment_digest_token,
        control_digest_token: observed.control_digest_token,
    })
}

pub fn promote_supported(experiment: SupportedExperiment) -> i64 {
    experiment.experiment_token
}

pub fn supported_subject_commit(experiment: SupportedExperiment) -> i64 {
    experiment.subject_commit_token
}

pub fn supported_prereg_digest(experiment: SupportedExperiment) -> i64 {
    experiment.prereg_digest_token
}

pub fn falsified_experiment_token(experiment: FalsifiedExperiment) -> i64 {
    experiment.experiment_token
}

pub fn inconclusive_experiment_token(experiment: InconclusiveExperiment) -> i64 {
    experiment.experiment_token
}
