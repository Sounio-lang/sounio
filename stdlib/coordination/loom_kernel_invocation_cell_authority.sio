fn loom_kernel_invocation_cell_flag(value: i64) -> bool {
    value == 0 || value == 1
}

fn loom_kernel_invocation_cell_digest_nonzero(
    value: LoomKernelInvocationCellDigest256,
) -> bool {
    value.limb0 != 0 || value.limb1 != 0 || value.limb2 != 0 ||
        value.limb3 != 0 || value.limb4 != 0 || value.limb5 != 0 ||
        value.limb6 != 0 || value.limb7 != 0
}

fn loom_kernel_invocation_cell_digest_equal(
    left: LoomKernelInvocationCellDigest256,
    right: LoomKernelInvocationCellDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
        left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
        left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
        left.limb6 == right.limb6 && left.limb7 == right.limb7
}

