//! Linear evidence algebra for verifiable fleet transactions.
//!
//! `HostTrust` is the trusted-computing boundary: it admits a complete runtime
//! assertion after the host performs its SQLite, process, hash, signature, and
//! recipient checks. A private linear seal prevents ordinary consumers from
//! laundering caller-chosen integers into host receipts merely by declaring
//! the effect. Outside that sealed adapter, imports consume assertions without
//! accepting parallel payloads, and safe promotions preserve one transaction
//! and monotone receipt chain.
//! The executable refinement lives in `scripts/dev/sounio_coord_fleetd.py`;
//! the bounded safety model lives in `formal/tla/SounioFleet.tla`.

pub effect HostTrust {}

linear struct HostTrustSeal {
    transaction_id: i64,
    receipt_chain_id: i64,
    next_receipt_id: i64,
}

linear struct HostRuntimeReceipt {
    transaction_id: i64,
    receipt_id: i64,
    receipt_chain_id: i64,
    receipt_kind: i64,
    capability_id: i64,
    slot_id: i64,
    argv_digest_id: i64,
    checkpoint_id: i64,
    evidence_set_id: i64,
    handoff_id: i64,
    recipient_id: i64,
    prepared_seq: i64,
    anchor_receipt_id: i64,
    anchored_through_seq: i64,
}

linear struct IssuedStartCapability {
    transaction_id: i64,
    receipt_chain_id: i64,
    last_receipt_id: i64,
    capability_id: i64,
    slot_id: i64,
}

