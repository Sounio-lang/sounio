pub fn consume_start_capability(
    capability: IssuedStartCapability,
) -> ConsumedStartCapability {
    let IssuedStartCapability {
        transaction_id, receipt_chain_id, last_receipt_id,
        capability_id, slot_id,
    } = capability
    ConsumedStartCapability {
        transaction_id: transaction_id,
        receipt_chain_id: receipt_chain_id,
        last_receipt_id: last_receipt_id,
        capability_id: capability_id,
        slot_id: slot_id,
    }
}

pub fn attest_started_argv(
    capability: ConsumedStartCapability,
    attestation: HostArgvAttestation,
) -> AttestedActiveSlot with Panic {
    let ConsumedStartCapability {
        transaction_id, receipt_chain_id, last_receipt_id,
        capability_id, slot_id,
    } = capability
    let expected_transaction_id = transaction_id
    let expected_chain_id = receipt_chain_id
    let expected_capability_id = capability_id
    let expected_slot_id = slot_id
    let HostArgvAttestation {
        transaction_id, receipt_chain_id, receipt_id,
        capability_id, slot_id, argv_digest_id,
    } = attestation
    if expected_transaction_id != transaction_id ||
        expected_chain_id != receipt_chain_id ||
        expected_capability_id != capability_id ||
        expected_slot_id != slot_id || receipt_id != last_receipt_id + 1 {
        panic("argv attestation does not match consumed start authority")
    }
    AttestedActiveSlot {
        transaction_id: expected_transaction_id,
        receipt_chain_id: expected_chain_id,
        last_receipt_id: receipt_id,
        slot_id: expected_slot_id,
        argv_digest_id: argv_digest_id,
    }
}

pub fn draft_checkpoint(
    slot: AttestedActiveSlot,
    draft: HostCheckpointDraft,
) -> DraftCheckpoint with Panic {
    let AttestedActiveSlot {
        transaction_id, receipt_chain_id, last_receipt_id,
        slot_id, argv_digest_id,
    } = slot
    let expected_transaction_id = transaction_id
    let expected_chain_id = receipt_chain_id
    let expected_slot_id = slot_id
    let expected_argv_digest_id = argv_digest_id
    let HostCheckpointDraft {
        transaction_id, receipt_chain_id, receipt_id, slot_id,
        argv_digest_id, checkpoint_id, evidence_set_id,
    } = draft
    if expected_transaction_id != transaction_id ||
        expected_chain_id != receipt_chain_id ||
        expected_slot_id != slot_id ||
        expected_argv_digest_id != argv_digest_id ||
        receipt_id != last_receipt_id + 1 {
        panic("checkpoint draft does not match argv-attested slot")
    }
    DraftCheckpoint {
        transaction_id: expected_transaction_id,
        receipt_chain_id: expected_chain_id,
        last_receipt_id: receipt_id,
        slot_id: expected_slot_id,
        argv_digest_id: expected_argv_digest_id,
        checkpoint_id: checkpoint_id,
        evidence_set_id: evidence_set_id,
    }
}

pub fn verify_checkpoint(
    checkpoint: DraftCheckpoint,
    verification: HostEvidenceVerification,
) -> VerifiedCheckpoint with Panic {
    let DraftCheckpoint {
        transaction_id, receipt_chain_id, last_receipt_id, slot_id,
        argv_digest_id, checkpoint_id, evidence_set_id,
    } = checkpoint
    let expected_transaction_id = transaction_id
    let expected_chain_id = receipt_chain_id
    let expected_checkpoint_id = checkpoint_id
    let expected_evidence_set_id = evidence_set_id
    let HostEvidenceVerification {
        transaction_id, receipt_chain_id, receipt_id,
        checkpoint_id, evidence_set_id,
    } = verification
    if expected_transaction_id != transaction_id ||
        expected_chain_id != receipt_chain_id ||
        expected_checkpoint_id != checkpoint_id ||
        expected_evidence_set_id != evidence_set_id ||
        receipt_id != last_receipt_id + 1 {
        panic("evidence verification does not match checkpoint draft")
    }
    VerifiedCheckpoint {
        transaction_id: expected_transaction_id,
        receipt_chain_id: expected_chain_id,
        last_receipt_id: receipt_id,
        slot_id: slot_id,
        argv_digest_id: argv_digest_id,
        checkpoint_id: expected_checkpoint_id,
        evidence_set_id: expected_evidence_set_id,
    }
}

pub fn prepare_handoff(
    checkpoint: VerifiedCheckpoint,
    preparation: HostHandoffPreparation,
) -> PreparedHandoff with Panic {
    let VerifiedCheckpoint {
        transaction_id, receipt_chain_id, last_receipt_id, slot_id,
        argv_digest_id, checkpoint_id, evidence_set_id,
    } = checkpoint
    let expected_transaction_id = transaction_id
    let expected_chain_id = receipt_chain_id
    let expected_checkpoint_id = checkpoint_id
    let expected_evidence_set_id = evidence_set_id
    let HostHandoffPreparation {
        transaction_id, receipt_chain_id, receipt_id, checkpoint_id,
        evidence_set_id, handoff_id, recipient_id, prepared_seq,
    } = preparation
    if expected_transaction_id != transaction_id ||
        expected_chain_id != receipt_chain_id ||
        expected_checkpoint_id != checkpoint_id ||
        expected_evidence_set_id != evidence_set_id ||
        receipt_id != last_receipt_id + 1 {
        panic("handoff preparation does not match verified checkpoint")
    }
    PreparedHandoff {
        transaction_id: expected_transaction_id,
        receipt_chain_id: expected_chain_id,
        last_receipt_id: receipt_id,
        slot_id: slot_id,
        argv_digest_id: argv_digest_id,
        checkpoint_id: expected_checkpoint_id,
        evidence_set_id: expected_evidence_set_id,
        handoff_id: handoff_id,
        recipient_id: recipient_id,
        prepared_seq: prepared_seq,
    }
}

pub fn accept_anchored_handoff(
    handoff: PreparedHandoff,
    verification: HostAnchorRecipientVerification,
) -> AcceptedHandoff with Panic {
    let PreparedHandoff {
        transaction_id, receipt_chain_id, last_receipt_id, slot_id,
        argv_digest_id, checkpoint_id, evidence_set_id, handoff_id,
        recipient_id, prepared_seq,
    } = handoff
    let expected_transaction_id = transaction_id
    let expected_chain_id = receipt_chain_id
    let expected_handoff_id = handoff_id
    let expected_recipient_id = recipient_id
    let HostAnchorRecipientVerification {
        transaction_id, receipt_chain_id, receipt_id, handoff_id,
        recipient_id, anchor_receipt_id, anchored_through_seq,
    } = verification
    if expected_transaction_id != transaction_id ||
        expected_chain_id != receipt_chain_id ||
        expected_handoff_id != handoff_id ||
        expected_recipient_id != recipient_id ||
        receipt_id != last_receipt_id + 1 ||
        anchored_through_seq < prepared_seq {
        panic("anchor or recipient verification does not match prepared handoff")
    }
    AcceptedHandoff {
        transaction_id: expected_transaction_id,
        receipt_chain_id: expected_chain_id,
        last_receipt_id: receipt_id,
        slot_id: slot_id,
        argv_digest_id: argv_digest_id,
        checkpoint_id: checkpoint_id,
        evidence_set_id: evidence_set_id,
        handoff_id: expected_handoff_id,
        recipient_id: expected_recipient_id,
        prepared_seq: prepared_seq,
        anchor_receipt_id: anchor_receipt_id,
        anchored_through_seq: anchored_through_seq,
    }
}

pub fn finalize_accepted_handoff(
    handoff: AcceptedHandoff,
) -> FinalizedHandoffReceipt {
    let AcceptedHandoff {
        transaction_id, receipt_chain_id, last_receipt_id, slot_id,
        argv_digest_id, checkpoint_id, evidence_set_id, handoff_id,
        recipient_id, prepared_seq, anchor_receipt_id, anchored_through_seq,
    } = handoff
    FinalizedHandoffReceipt {
        transaction_id: transaction_id,
        receipt_chain_id: receipt_chain_id,
        last_receipt_id: last_receipt_id,
        slot_id: slot_id,
        argv_digest_id: argv_digest_id,
        checkpoint_id: checkpoint_id,
        evidence_set_id: evidence_set_id,
        handoff_id: handoff_id,
        recipient_id: recipient_id,
        prepared_seq: prepared_seq,
        anchor_receipt_id: anchor_receipt_id,
        anchored_through_seq: anchored_through_seq,
    }
}

pub fn finalized_receipt_matches(
    receipt: FinalizedHandoffReceipt,
    transaction_id: i64,
    receipt_chain_id: i64,
    last_receipt_id: i64,
    slot_id: i64,
    argv_digest_id: i64,
    checkpoint_id: i64,
    evidence_set_id: i64,
    handoff_id: i64,
    recipient_id: i64,
    prepared_seq: i64,
    anchor_receipt_id: i64,
    anchored_through_seq: i64,
) -> bool {
    let expected_transaction_id = transaction_id
    let expected_receipt_chain_id = receipt_chain_id
    let expected_last_receipt_id = last_receipt_id
    let expected_slot_id = slot_id
    let expected_argv_digest_id = argv_digest_id
    let expected_checkpoint_id = checkpoint_id
    let expected_evidence_set_id = evidence_set_id
    let expected_handoff_id = handoff_id
    let expected_recipient_id = recipient_id
    let expected_prepared_seq = prepared_seq
    let expected_anchor_receipt_id = anchor_receipt_id
    let expected_anchored_through_seq = anchored_through_seq
    let FinalizedHandoffReceipt {
        transaction_id, receipt_chain_id, last_receipt_id, slot_id,
        argv_digest_id, checkpoint_id, evidence_set_id, handoff_id,
        recipient_id, prepared_seq, anchor_receipt_id, anchored_through_seq,
    } = receipt
    expected_transaction_id == transaction_id &&
        expected_receipt_chain_id == receipt_chain_id &&
        expected_last_receipt_id == last_receipt_id &&
        expected_slot_id == slot_id &&
        expected_argv_digest_id == argv_digest_id &&
        expected_checkpoint_id == checkpoint_id &&
        expected_evidence_set_id == evidence_set_id &&
        expected_handoff_id == handoff_id &&
        expected_recipient_id == recipient_id &&
        expected_prepared_seq == prepared_seq &&
        expected_anchor_receipt_id == anchor_receipt_id &&
        expected_anchored_through_seq == anchored_through_seq
}
