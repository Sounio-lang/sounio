// This constructor is deliberately private. The native host adapter is the
// only production caller; single-module gates exercise it as the TCB witness.
fn open_host_trust_bridge(
    transaction_id: i64,
    receipt_chain_id: i64,
) -> HostTrustSeal with HostTrust, Panic {
    if transaction_id <= 0 || receipt_chain_id <= 0 {
        panic("host trust bridge identity must be positive")
    }
    HostTrustSeal {
        transaction_id: transaction_id,
        receipt_chain_id: receipt_chain_id,
        next_receipt_id: 1,
    }
}

// Receipt kinds: 1 issued, 2 argv, 3 draft, 4 evidence, 5 preparation,
// 6 anchor-recipient verification. All payload fields are in-band. Admission
// consumes and returns the private seal, so receipt identities cannot fork.
fn admit_runtime_receipt(
    seal: HostTrustSeal,
    receipt_transaction_id: i64,
    receipt_id: i64,
    receipt_chain: i64,
    receipt_kind: i64,
    capability_id: i64,
    slot_id: i64,
    argv_digest_id: i64,
    checkpoint_id: i64,
    evidence_set_id: i64,
    handoff_id: i64,
    recipient_id: i64,
    prepared_seq: i64,
    anchor_receipt_id: i64,
    anchored_through_seq: i64,
) -> (HostTrustSeal, HostRuntimeReceipt) with HostTrust, Panic {
    let HostTrustSeal {
        transaction_id,
        receipt_chain_id,
        next_receipt_id,
    } = seal
    let kind_valid =
        (receipt_kind == 1 && capability_id > 0 && slot_id > 0 &&
            argv_digest_id == 0 && checkpoint_id == 0 && evidence_set_id == 0 &&
            handoff_id == 0 && recipient_id == 0 && prepared_seq == 0 &&
            anchor_receipt_id == 0 && anchored_through_seq == 0) ||
        (receipt_kind == 2 && capability_id > 0 && slot_id > 0 &&
            argv_digest_id > 0 && checkpoint_id == 0 && evidence_set_id == 0 &&
            handoff_id == 0 && recipient_id == 0 && prepared_seq == 0 &&
            anchor_receipt_id == 0 && anchored_through_seq == 0) ||
        (receipt_kind == 3 && capability_id > 0 && slot_id > 0 &&
            argv_digest_id > 0 && checkpoint_id > 0 && evidence_set_id > 0 &&
            handoff_id == 0 && recipient_id == 0 && prepared_seq == 0 &&
            anchor_receipt_id == 0 && anchored_through_seq == 0) ||
        (receipt_kind == 4 && capability_id > 0 && slot_id > 0 &&
            argv_digest_id > 0 && checkpoint_id > 0 && evidence_set_id > 0 &&
            handoff_id == 0 && recipient_id == 0 && prepared_seq == 0 &&
            anchor_receipt_id == 0 && anchored_through_seq == 0) ||
        (receipt_kind == 5 && capability_id > 0 && slot_id > 0 &&
            argv_digest_id > 0 && checkpoint_id > 0 && evidence_set_id > 0 &&
            handoff_id > 0 && recipient_id > 0 && prepared_seq > 0 &&
            anchor_receipt_id == 0 && anchored_through_seq == 0) ||
        (receipt_kind == 6 && capability_id > 0 && slot_id > 0 &&
            argv_digest_id > 0 && checkpoint_id > 0 && evidence_set_id > 0 &&
            handoff_id > 0 && recipient_id > 0 && prepared_seq > 0 &&
            anchor_receipt_id > 0 && anchored_through_seq >= prepared_seq)
    if receipt_transaction_id != transaction_id ||
        receipt_chain != receipt_chain_id ||
        receipt_id != next_receipt_id || !kind_valid {
        panic("runtime receipt payload is not canonical for its kind")
    }
    let next_seal = HostTrustSeal {
        transaction_id: transaction_id,
        receipt_chain_id: receipt_chain_id,
        next_receipt_id: next_receipt_id + 1,
    }
    let receipt = HostRuntimeReceipt {
        transaction_id: receipt_transaction_id,
        receipt_id: receipt_id,
        receipt_chain_id: receipt_chain,
        receipt_kind: receipt_kind,
        capability_id: capability_id,
        slot_id: slot_id,
        argv_digest_id: argv_digest_id,
        checkpoint_id: checkpoint_id,
        evidence_set_id: evidence_set_id,
        handoff_id: handoff_id,
        recipient_id: recipient_id,
        prepared_seq: prepared_seq,
        anchor_receipt_id: anchor_receipt_id,
        anchored_through_seq: anchored_through_seq,
    }
    (next_seal, receipt)
}

fn close_host_trust_bridge(seal: HostTrustSeal) with Panic {
    let HostTrustSeal {
        transaction_id,
        receipt_chain_id,
        next_receipt_id,
    } = seal
    if transaction_id <= 0 || receipt_chain_id <= 0 || next_receipt_id <= 1 {
        panic("host trust bridge closed without an admitted receipt")
    }
}

pub fn import_issued_start_capability(
    receipt: HostRuntimeReceipt,
) -> IssuedStartCapability with Panic {
    let HostRuntimeReceipt {
        transaction_id, receipt_id, receipt_chain_id, receipt_kind,
        capability_id, slot_id, argv_digest_id, checkpoint_id,
        evidence_set_id, handoff_id, recipient_id, prepared_seq,
        anchor_receipt_id, anchored_through_seq,
    } = receipt
    if receipt_kind != 1 || receipt_id <= 0 || receipt_chain_id <= 0 {
        panic("issued capability receipt has invalid provenance")
    }
    IssuedStartCapability {
        transaction_id: transaction_id,
        receipt_chain_id: receipt_chain_id,
        last_receipt_id: receipt_id,
        capability_id: capability_id,
        slot_id: slot_id,
    }
}

pub fn import_host_argv_attestation(
    receipt: HostRuntimeReceipt,
) -> HostArgvAttestation with Panic {
    let HostRuntimeReceipt {
        transaction_id, receipt_id, receipt_chain_id, receipt_kind,
        capability_id, slot_id, argv_digest_id, checkpoint_id,
        evidence_set_id, handoff_id, recipient_id, prepared_seq,
        anchor_receipt_id, anchored_through_seq,
    } = receipt
    if receipt_kind != 2 || receipt_id <= 0 || receipt_chain_id <= 0 {
        panic("argv receipt has invalid provenance")
    }
    HostArgvAttestation {
        transaction_id: transaction_id,
        receipt_chain_id: receipt_chain_id,
        receipt_id: receipt_id,
        capability_id: capability_id,
        slot_id: slot_id,
        argv_digest_id: argv_digest_id,
    }
}

