//! LOOM action 9042: sovereign execution-kernel semantic authority.
//!
//! This joins frozen actions 9025, 9030, and 9031 without redefining them.

struct LoomSovereignExecutionObservation {
    mode: i64,
    stage: i64,
    preregistered: i64,
    parent_9025_frozen: i64,
    parent_9030_frozen: i64,
    parent_9031_frozen: i64,
    parent_hashes_bound: i64,
    producer_sounio: i64,
    expected_result_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    grant_resident_memory: i64,
    grant_non_bearer: i64,
    grant_single_use: i64,
    consume_atomic: i64,
    exported_token_absent: i64,
    exported_handle_absent: i64,
    descriptor_non_authorizing: i64,
    so_peercred_bound: i64,
    pidfd_bound: i64,
    start_tick_bound: i64,
    harness_ancestry_bound: i64,
    executable_bound: i64,
    operation_bound: i64,
    guardian_sole_release: i64,
    gui_release_zero: i64,
    tui_release_zero: i64,
    cli_release_zero: i64,
    pod_release_zero: i64,
    tmux_release_zero: i64,
    transport_dead: i64,
    gui_dead: i64,
    coordinator_dead: i64,
    witness_continued: i64,
    hostile_same_uid: i64,
    spoof_attempted: i64,
    spoof_refused_pre_exec: i64,
    spoof_material_started: i64,
    guardian_alive: i64,
    guardian_pidfd_bound: i64,
    pdeathsig_armed: i64,
    grant_revoked: i64,
    material_extinct: i64,
    release_absent: i64,
    material_observation_joined: i64,
    same_uid_peer_isolation: i64,
    production_activation_requested: i64,
    treatment_material_started: i64,
    treatment_material_completed: i64,
    treatment_exactly_once: i64,
    production_gate_configured: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

fn loom_sovereign_fact(word: i64, offset: i64) -> i64 {
    (word >> offset) & 1
}

pub fn loom_sovereign_execution_observation_from_words(
    mode: i64,
    stage: i64,
    word: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> LoomSovereignExecutionObservation {
    LoomSovereignExecutionObservation {
        mode: mode,
        stage: stage,
        preregistered: loom_sovereign_fact(word, 0),
        parent_9025_frozen: loom_sovereign_fact(word, 1),
        parent_9030_frozen: loom_sovereign_fact(word, 2),
        parent_9031_frozen: loom_sovereign_fact(word, 3),
        parent_hashes_bound: loom_sovereign_fact(word, 4),
        producer_sounio: loom_sovereign_fact(word, 5),
        expected_result_sounio: loom_sovereign_fact(word, 6),
        python_absent: loom_sovereign_fact(word, 7),
        rust_absent: loom_sovereign_fact(word, 8),
        grant_resident_memory: loom_sovereign_fact(word, 9),
        grant_non_bearer: loom_sovereign_fact(word, 10),
        grant_single_use: loom_sovereign_fact(word, 11),
        consume_atomic: loom_sovereign_fact(word, 12),
        exported_token_absent: loom_sovereign_fact(word, 13),
        exported_handle_absent: loom_sovereign_fact(word, 14),
        descriptor_non_authorizing: loom_sovereign_fact(word, 15),
        so_peercred_bound: loom_sovereign_fact(word, 16),
        pidfd_bound: loom_sovereign_fact(word, 17),
        start_tick_bound: loom_sovereign_fact(word, 18),
        harness_ancestry_bound: loom_sovereign_fact(word, 19),
        executable_bound: loom_sovereign_fact(word, 20),
        operation_bound: loom_sovereign_fact(word, 21),
        guardian_sole_release: loom_sovereign_fact(word, 22),
        gui_release_zero: loom_sovereign_fact(word, 23),
        tui_release_zero: loom_sovereign_fact(word, 24),
        cli_release_zero: loom_sovereign_fact(word, 25),
        pod_release_zero: loom_sovereign_fact(word, 26),
        tmux_release_zero: loom_sovereign_fact(word, 27),
        transport_dead: loom_sovereign_fact(word, 28),
        gui_dead: loom_sovereign_fact(word, 29),
        coordinator_dead: loom_sovereign_fact(word, 30),
        witness_continued: loom_sovereign_fact(word, 31),
        hostile_same_uid: loom_sovereign_fact(word, 32),
        spoof_attempted: loom_sovereign_fact(word, 33),
        spoof_refused_pre_exec: loom_sovereign_fact(word, 34),
        spoof_material_started: loom_sovereign_fact(word, 35),
        guardian_alive: loom_sovereign_fact(word, 36),
        guardian_pidfd_bound: loom_sovereign_fact(word, 37),
        pdeathsig_armed: loom_sovereign_fact(word, 38),
        grant_revoked: loom_sovereign_fact(word, 39),
        material_extinct: loom_sovereign_fact(word, 40),
        release_absent: loom_sovereign_fact(word, 41),
        material_observation_joined: loom_sovereign_fact(word, 42),
        same_uid_peer_isolation: loom_sovereign_fact(word, 43),
        production_activation_requested: loom_sovereign_fact(word, 44),
        treatment_material_started: loom_sovereign_fact(word, 45),
        treatment_material_completed: loom_sovereign_fact(word, 46),
        treatment_exactly_once: loom_sovereign_fact(word, 47),
        production_gate_configured: loom_sovereign_fact(word, 48),
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
}

// 1 = EXEC_ADMIT, 2 = GUARDIAN_REVOKE, 3 = PRODUCTION_GATE_READY.
pub fn judge_loom_sovereign_execution_kernel(
    observation: LoomSovereignExecutionObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 {
        return 602
    }
    if observation.parent_9025_frozen != 1 ||
        observation.parent_9030_frozen != 1 ||
        observation.parent_9031_frozen != 1 ||
        observation.parent_hashes_bound != 1 {
        return 603
    }
    if observation.producer_sounio != 1 ||
        observation.expected_result_sounio != 1 ||
        observation.python_absent != 1 || observation.rust_absent != 1 {
        return 604
    }
    if observation.grant_resident_memory != 1 ||
        observation.grant_non_bearer != 1 ||
        observation.grant_single_use != 1 ||
        observation.consume_atomic != 1 ||
        observation.exported_token_absent != 1 ||
        observation.exported_handle_absent != 1 ||
        observation.descriptor_non_authorizing != 1 {
        return 605
    }
    if observation.so_peercred_bound != 1 ||
        observation.pidfd_bound != 1 ||
        observation.start_tick_bound != 1 ||
        observation.harness_ancestry_bound != 1 ||
        observation.executable_bound != 1 ||
        observation.operation_bound != 1 {
        return 606
    }
    if observation.guardian_sole_release != 1 ||
        observation.gui_release_zero != 1 ||
        observation.tui_release_zero != 1 ||
        observation.cli_release_zero != 1 ||
        observation.pod_release_zero != 1 ||
        observation.tmux_release_zero != 1 {
        return 607
    }
    if observation.hostile_same_uid != 1 ||
        observation.spoof_attempted != 1 ||
        observation.spoof_refused_pre_exec != 1 ||
        observation.spoof_material_started != 0 {
        return 609
    }
    if observation.material_observation_joined != 1 ||
        observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required {
        return 611
    }
    if observation.mode == 2 {
        if observation.transport_dead != 1 || observation.gui_dead != 1 ||
            observation.coordinator_dead != 1 ||
            observation.witness_continued != 0 ||
            observation.guardian_alive != 0 ||
            observation.guardian_pidfd_bound != 1 ||
            observation.pdeathsig_armed != 1 ||
            observation.grant_revoked != 1 ||
            observation.material_extinct != 1 ||
            observation.release_absent != 1 ||
            observation.treatment_material_started != 0 ||
            observation.treatment_material_completed != 0 ||
            observation.treatment_exactly_once != 0 {
            return 610
        }
        return 2
    }
    if observation.mode != 1 && observation.mode != 3 {
        return 608
    }
    if observation.transport_dead != 1 || observation.gui_dead != 1 ||
        observation.coordinator_dead != 1 ||
        observation.witness_continued != 1 ||
        observation.guardian_alive != 1 ||
        observation.guardian_pidfd_bound != 1 ||
        observation.pdeathsig_armed != 1 ||
        observation.grant_revoked != 0 ||
        observation.material_extinct != 0 ||
        observation.release_absent != 1 ||
        observation.treatment_material_started != 1 ||
        observation.treatment_material_completed != 1 ||
        observation.treatment_exactly_once != 1 {
        return 608
    }
    if observation.production_gate_configured != 1 {
        return 612
    }
    if observation.mode == 3 {
        if observation.production_activation_requested != 1 ||
            observation.same_uid_peer_isolation != 1 {
            return 612
        }
        return 3
    }
    if observation.production_activation_requested != 0 {
        return 612
    }
    if observation.same_uid_peer_isolation != 1 {
        return 609
    }
    1
}

pub fn judge_loom_sovereign_execution_kernel_words(
    mode: i64,
    stage: i64,
    word: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> i64 {
    judge_loom_sovereign_execution_kernel(
        loom_sovereign_execution_observation_from_words(
            mode, stage, word, sabotage_count, sabotage_required,
        ),
    )
}

pub fn loom_sovereign_execution_kernel_selftest() -> i64 {
    let all = (1 << 49) - 1
    let treatment = all ^ (1 << 35) ^ (1 << 39) ^ (1 << 40) ^ (1 << 44)
    let guardian_death = treatment ^ (1 << 31) ^ (1 << 36) ^
        (1 << 39) ^ (1 << 40) ^ (1 << 45) ^ (1 << 46) ^ (1 << 47)
    let production = treatment ^ (1 << 44)
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment, 9, 9) != 1 { return 1 }
    if judge_loom_sovereign_execution_kernel_words(2, 3, guardian_death, 9, 9) != 2 { return 2 }
    if judge_loom_sovereign_execution_kernel_words(3, 3, production, 9, 9) != 3 { return 3 }
    if judge_loom_sovereign_execution_kernel_words(1, 2, treatment, 9, 9) != 602 { return 4 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 1), 9, 9) != 603 { return 5 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 5), 9, 9) != 604 { return 6 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 12), 9, 9) != 605 { return 7 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 16), 9, 9) != 606 { return 8 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 23), 9, 9) != 607 { return 9 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 29), 9, 9) != 608 { return 10 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 34), 9, 9) != 609 { return 11 }
    if judge_loom_sovereign_execution_kernel_words(2, 3, guardian_death ^ (1 << 39), 9, 9) != 610 { return 12 }
    if judge_loom_sovereign_execution_kernel_words(1, 3, treatment ^ (1 << 42), 9, 9) != 611 { return 13 }
    if judge_loom_sovereign_execution_kernel_words(3, 3, production ^ (1 << 43), 9, 9) != 612 { return 14 }
    0
}
