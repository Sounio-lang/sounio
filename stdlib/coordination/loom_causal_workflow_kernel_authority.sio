fn loom_causal_workflow_level(current_state: i64, next_state: i64) -> i64 {
    if current_state > next_state { current_state } else { next_state }
}

fn loom_causal_workflow_legal_edge(
    transition: i64,
    current_state: i64,
    next_state: i64,
) -> bool {
    if transition >= 1 && transition <= 10 {
        return current_state == transition - 1 && next_state == transition
    }
    if transition == 11 {
        return current_state >= 3 && current_state <= 10 &&
            next_state == current_state
    }
    false
}

// 1 = ADVANCE or RECOVER. All other values are fail-closed refusal codes.
pub fn judge_loom_causal_workflow(
    observation: LoomCausalWorkflowObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 ||
        observation.graph_closed != 1 {
        return 580
    }
    if observation.semantic_authority_sounio != 1 ||
        observation.result_authority_sounio != 1 ||
        observation.expected_result_absent_from_material != 1 ||
        observation.review_unpromoted != 1 ||
        observation.parity_unpromoted != 1 ||
        !loom_causal_workflow_digest_equal(
            observation.workflow_schema_sha256, loom_causal_workflow_schema()) ||
        !loom_causal_workflow_digest_equal(
            observation.graph_sha256, loom_causal_workflow_graph()) ||
        !loom_causal_workflow_digest_equal(
            observation.source_sha256, loom_causal_workflow_source()) ||
        !loom_causal_workflow_digest_equal(
            observation.compiler_sha256, loom_causal_workflow_compiler()) ||
        !loom_causal_workflow_digest_equal(
            observation.artifact_sha256, loom_causal_workflow_artifact()) ||
        !loom_causal_workflow_digest_equal(
            observation.expected_result_schema_sha256,
            loom_causal_workflow_expected_result()) ||
        !loom_causal_workflow_digest_equal(
            observation.empty_output_sha256,
            loom_causal_workflow_empty_output()) ||
        !loom_causal_workflow_digest_equal(
            observation.parent_9030_sha256,
            loom_causal_workflow_parent_9030()) ||
        !loom_causal_workflow_digest_equal(
            observation.parent_9031_sha256,
            loom_causal_workflow_parent_9031()) ||
        !loom_causal_workflow_digest_equal(
            observation.parent_9032_sha256,
            loom_causal_workflow_parent_9032()) ||
        !loom_causal_workflow_digest_equal(
            observation.parent_9033_sha256,
            loom_causal_workflow_parent_9033()) ||
        !loom_causal_workflow_digest_equal(
            observation.parent_9034_sha256,
            loom_causal_workflow_parent_9034()) ||
        !loom_causal_workflow_digest_equal(
            observation.parent_9035_sha256,
            loom_causal_workflow_parent_9035()) ||
        !loom_causal_workflow_digest_equal(
            observation.parent_9036_sha256,
            loom_causal_workflow_parent_9036()) {
        return 581
    }
    if !loom_causal_workflow_legal_edge(
        observation.transition,
        observation.current_state,
        observation.next_state) {
        return 582
    }
    let level = loom_causal_workflow_level(
        observation.current_state, observation.next_state)
    if observation.source_identity_present != 1 ||
        observation.workflow_generation_present != 1 {
        return 583
    }
    if level >= 3 &&
        (observation.compile_receipt_present != 1 ||
         observation.artifact_record_present != 1 ||
         observation.artifact_handle_present != 1 ||
         observation.artifact_handle_non_bearer != 1 ||
         observation.artifact_handle_not_execution_authority != 1 ||
         observation.artifact_path_absent != 1 ||
         observation.artifact_resolves_to_record != 1) {
        return 583
    }
    if level >= 6 &&
        (observation.result_record_present != 1 ||
         observation.result_handle_present != 1 ||
         observation.result_handle_non_bearer != 1 ||
         observation.result_handle_not_execution_authority != 1 ||
         observation.result_resolves_to_record != 1) {
        return 583
    }
    if level >= 10 &&
        (observation.attestation_record_present != 1 ||
         observation.attestation_handle_present != 1 ||
         observation.attestation_handle_non_bearer != 1 ||
         observation.attestation_binds_lineage != 1) {
        return 583
    }
    if level >= 3 &&
        (observation.compile_count != 1 ||
         observation.compile_requested != 0 ||
         observation.no_recompile_after_close != 1 ||
         observation.compile_grant_extinct != 1 ||
         observation.compile_capsule_extinct != 1) {
        return 584
    }
    if level >= 4 {
        if observation.run_ticket_present != 1 ||
            observation.run_ticket_count != 1 ||
            observation.run_grant_9030_present != 1 ||
            observation.run_ticket_grant_bound != 1 ||
            observation.run_ticket_commit_before_launch != 1 ||
            observation.run_grant_generation_equal != 1 ||
            observation.run_ticket_identity_stable != 1 ||
            observation.action_9030_sole_launch_authority != 1 {
            return 585
        }
    } else if observation.run_ticket_present != 0 ||
        observation.run_ticket_count != 0 ||
        observation.run_grant_9030_present != 0 {
        return 585
    }
    if level < 5 {
        if observation.run_launch_requested != 0 ||
            observation.run_launch_count != 0 ||
            observation.run_start_receipt_pidfd_bound != 0 {
            return 586
        }
    } else {
        if observation.run_launch_count != 1 ||
            observation.run_start_receipt_pidfd_bound != 1 {
            return 586
        }
        if observation.transition == 5 {
            if observation.run_launch_requested != 1 { return 586 }
        } else if observation.run_launch_requested != 0 {
            return 586
        }
    }
    if observation.transition == 11 {
        if observation.controller_or_pod_loss != 1 ||
            observation.successor_controller != 1 ||
            observation.predecessor_controller_extinct != 1 ||
            observation.guardian_live != 1 ||
            observation.same_guardian_generation != 1 ||
            observation.same_journal != 1 ||
            observation.same_store != 1 {
            return 587
        }
        if observation.current_state >= 4 &&
            observation.run_ticket_state_preserved != 1 { return 587 }
        if observation.current_state >= 5 &&
            observation.run_launch_state_preserved != 1 { return 587 }
        if observation.current_state >= 6 &&
            observation.run_result_state_preserved != 1 { return 587 }
        if observation.current_state >= 8 &&
            observation.attestation_state_preserved != 1 { return 587 }
    } else if observation.controller_or_pod_loss != 0 ||
        observation.successor_controller != 0 ||
        observation.predecessor_controller_extinct != 0 ||
        observation.guardian_live != 0 ||
        observation.same_guardian_generation != 0 ||
        observation.same_journal != 0 || observation.same_store != 0 ||
        observation.run_ticket_state_preserved != 0 ||
        observation.run_launch_state_preserved != 0 ||
        observation.run_result_state_preserved != 0 ||
        observation.attestation_state_preserved != 0 {
        return 587
    }
    if observation.journal_append_complete != 1 ||
        observation.journal_fsync_complete != 1 ||
        observation.receipts_immutable != 1 ||
        observation.provenance_complete != 1 ||
        observation.toolchain_bound != 1 ||
        observation.hardware_bound != 1 ||
        observation.sandbox_bound != 1 ||
        observation.dynamic_users_distinct != 1 ||
        observation.shell_absent != 1 ||
        observation.python_absent != 1 || observation.rust_absent != 1 ||
        observation.network_absent != 1 ||
        observation.predecessor_receipt_present != 1 ||
        observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required {
        return 588
    }
    if level >= 6 &&
        (observation.run_result_sealed != 1 ||
         observation.expected_exit_equal != 1 ||
         observation.expected_stdout_equal != 1 ||
         observation.expected_stderr_equal != 1) {
        return 588
    }
    if level >= 7 &&
        (observation.run_authority_extinct != 1 ||
         observation.run_pid_extinct != 1 ||
         observation.run_descendants_extinct != 1 ||
         observation.run_cgroup_unit_extinct != 1 ||
         observation.run_grant_extinct != 1 ||
         observation.run_capsule_extinct != 1) {
        return 588
    }
    if level >= 10 && observation.attestation_complete != 1 { return 588 }
    // Causal control: deleting only this comparison must admit the unchanged
    // predecessor-substitution witness.
    if observation.predecessor_receipt_equal != 1 {
        return 589
    }
    1
}

fn loom_causal_workflow_bit(mask: i64, offset: i64) -> i64 {
    (mask >> offset) & 1
}

fn loom_causal_workflow_selected(
    bit: i64,
    exact: LoomCausalWorkflowDigest256,
) -> LoomCausalWorkflowDigest256 {
    if bit == 1 { exact } else { loom_causal_workflow_zero() }
}

pub fn judge_loom_causal_workflow_v1_words(word0: i64, word1: i64) -> i64 {
    let observation = LoomCausalWorkflowObservation {
        stage: word0 & 3,
        preregistered: loom_causal_workflow_bit(word0, 2),
        graph_closed: loom_causal_workflow_bit(word0, 3),
        semantic_authority_sounio: loom_causal_workflow_bit(word0, 4),
        result_authority_sounio: loom_causal_workflow_bit(word0, 5),
        expected_result_absent_from_material:
            loom_causal_workflow_bit(word0, 6),
        review_unpromoted: loom_causal_workflow_bit(word0, 7),
        parity_unpromoted: loom_causal_workflow_bit(word0, 8),
        workflow_schema_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 9), loom_causal_workflow_schema()),
        graph_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 10), loom_causal_workflow_graph()),
        source_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 11), loom_causal_workflow_source()),
        compiler_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word1, 49), loom_causal_workflow_compiler()),
        artifact_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word1, 50), loom_causal_workflow_artifact()),
        expected_result_schema_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 12),
            loom_causal_workflow_expected_result()),
        empty_output_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word1, 51),
            loom_causal_workflow_empty_output()),
        parent_9030_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 13),
            loom_causal_workflow_parent_9030()),
        parent_9031_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 14),
            loom_causal_workflow_parent_9031()),
        parent_9032_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 15),
            loom_causal_workflow_parent_9032()),
        parent_9033_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 16),
            loom_causal_workflow_parent_9033()),
        parent_9034_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 17),
            loom_causal_workflow_parent_9034()),
        parent_9035_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 18),
            loom_causal_workflow_parent_9035()),
        parent_9036_sha256: loom_causal_workflow_selected(
            loom_causal_workflow_bit(word0, 19),
            loom_causal_workflow_parent_9036()),
        transition: (word0 >> 20) & 15,
        current_state: (word0 >> 24) & 15,
        next_state: (word0 >> 28) & 15,
        source_identity_present: loom_causal_workflow_bit(word0, 32),
        compile_receipt_present: loom_causal_workflow_bit(word0, 33),
        artifact_record_present: loom_causal_workflow_bit(word0, 34),
        artifact_handle_present: loom_causal_workflow_bit(word0, 35),
        artifact_handle_non_bearer: loom_causal_workflow_bit(word0, 36),
        artifact_path_absent: loom_causal_workflow_bit(word0, 37),
        result_record_present: loom_causal_workflow_bit(word0, 38),
        result_handle_present: loom_causal_workflow_bit(word0, 39),
        result_handle_non_bearer: loom_causal_workflow_bit(word0, 40),
        attestation_record_present: loom_causal_workflow_bit(word0, 41),
        attestation_handle_present: loom_causal_workflow_bit(word0, 42),
        attestation_handle_non_bearer: loom_causal_workflow_bit(word0, 43),
        workflow_generation_present: loom_causal_workflow_bit(word0, 44),
        journal_append_complete: loom_causal_workflow_bit(word0, 45),
        journal_fsync_complete: loom_causal_workflow_bit(word0, 46),
        receipts_immutable: loom_causal_workflow_bit(word0, 47),
        provenance_complete: loom_causal_workflow_bit(word0, 48),
        toolchain_bound: loom_causal_workflow_bit(word0, 49),
        hardware_bound: loom_causal_workflow_bit(word0, 50),
        sandbox_bound: loom_causal_workflow_bit(word0, 51),
        dynamic_users_distinct: loom_causal_workflow_bit(word0, 52),
        shell_absent: loom_causal_workflow_bit(word0, 53),
        python_absent: loom_causal_workflow_bit(word0, 54),
        rust_absent: loom_causal_workflow_bit(word0, 55),
        network_absent: loom_causal_workflow_bit(word0, 56),
        expected_exit_equal: loom_causal_workflow_bit(word0, 57),
        expected_stdout_equal: loom_causal_workflow_bit(word0, 58),
        expected_stderr_equal: loom_causal_workflow_bit(word0, 59),
        run_authority_extinct: loom_causal_workflow_bit(word0, 60),
        attestation_complete: loom_causal_workflow_bit(word0, 61),
        compile_count: word1 & 3,
        compile_requested: loom_causal_workflow_bit(word1, 2),
        no_recompile_after_close: loom_causal_workflow_bit(word1, 3),
        compile_grant_extinct: loom_causal_workflow_bit(word1, 4),
        compile_capsule_extinct: loom_causal_workflow_bit(word1, 5),
        run_ticket_present: loom_causal_workflow_bit(word1, 6),
        run_ticket_count: (word1 >> 7) & 3,
        run_grant_9030_present: loom_causal_workflow_bit(word1, 9),
        run_ticket_grant_bound: loom_causal_workflow_bit(word1, 10),
        run_ticket_commit_before_launch: loom_causal_workflow_bit(word1, 11),
        run_launch_requested: loom_causal_workflow_bit(word1, 12),
        run_launch_count: (word1 >> 13) & 3,
        run_start_receipt_pidfd_bound: loom_causal_workflow_bit(word1, 15),
        run_result_sealed: loom_causal_workflow_bit(word1, 16),
        run_pid_extinct: loom_causal_workflow_bit(word1, 17),
        run_descendants_extinct: loom_causal_workflow_bit(word1, 18),
        run_cgroup_unit_extinct: loom_causal_workflow_bit(word1, 19),
        run_grant_extinct: loom_causal_workflow_bit(word1, 20),
        run_capsule_extinct: loom_causal_workflow_bit(word1, 21),
        controller_or_pod_loss: loom_causal_workflow_bit(word1, 22),
        successor_controller: loom_causal_workflow_bit(word1, 23),
        predecessor_controller_extinct: loom_causal_workflow_bit(word1, 24),
        guardian_live: loom_causal_workflow_bit(word1, 25),
        same_guardian_generation: loom_causal_workflow_bit(word1, 26),
        same_journal: loom_causal_workflow_bit(word1, 27),
        same_store: loom_causal_workflow_bit(word1, 28),
        run_ticket_state_preserved: loom_causal_workflow_bit(word1, 29),
        run_launch_state_preserved: loom_causal_workflow_bit(word1, 30),
        run_result_state_preserved: loom_causal_workflow_bit(word1, 31),
        attestation_state_preserved: loom_causal_workflow_bit(word1, 32),
        predecessor_receipt_present: loom_causal_workflow_bit(word1, 33),
        predecessor_receipt_equal: loom_causal_workflow_bit(word1, 34),
        sabotage_count: (word1 >> 35) & 7,
        sabotage_required: (word1 >> 38) & 7,
        run_grant_generation_equal: loom_causal_workflow_bit(word1, 41),
        run_ticket_identity_stable: loom_causal_workflow_bit(word1, 42),
        result_handle_not_execution_authority:
            loom_causal_workflow_bit(word1, 43),
        artifact_handle_not_execution_authority:
            loom_causal_workflow_bit(word1, 44),
        action_9030_sole_launch_authority:
            loom_causal_workflow_bit(word1, 45),
        artifact_resolves_to_record: loom_causal_workflow_bit(word1, 46),
        result_resolves_to_record: loom_causal_workflow_bit(word1, 47),
        attestation_binds_lineage: loom_causal_workflow_bit(word1, 48),
    }
    judge_loom_causal_workflow(observation)
}

fn loom_causal_workflow_case(case_index: i64) -> i64 {
    let final_word0: i64 = 4611686016979304447
    let recovery_word0: i64 = 144097867340972031
    let final_word1: i64 = 4503591041609465
    let recovery_word1: i64 = 4065985942257721
    if case_index == 1 {
