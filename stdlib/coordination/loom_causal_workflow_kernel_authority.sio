    action_9030_sole_launch_authority: i64,
    artifact_resolves_to_record: i64,
    result_resolves_to_record: i64,
    attestation_binds_lineage: i64,
}

pub fn loom_causal_workflow_digest256(
    limb0: i64, limb1: i64, limb2: i64, limb3: i64,
    limb4: i64, limb5: i64, limb6: i64, limb7: i64,
) -> LoomCausalWorkflowDigest256 {
    LoomCausalWorkflowDigest256 {
        limb0: limb0, limb1: limb1, limb2: limb2, limb3: limb3,
        limb4: limb4, limb5: limb5, limb6: limb6, limb7: limb7,
    }
}

fn loom_causal_workflow_digest_equal(
    left: LoomCausalWorkflowDigest256,
    right: LoomCausalWorkflowDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn loom_causal_workflow_zero() -> LoomCausalWorkflowDigest256 {
    loom_causal_workflow_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

