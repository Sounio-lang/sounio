//! LOOM action 9037: Sounio semantic authority for the causal workflow kernel.

struct LoomCausalWorkflowDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

