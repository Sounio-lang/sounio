    run_cgroup_unit_extinct: i64,
    run_grant_extinct: i64,
    run_capsule_extinct: i64,
    controller_or_pod_loss: i64,
    successor_controller: i64,
    predecessor_controller_extinct: i64,
    guardian_live: i64,
    same_guardian_generation: i64,
    same_journal: i64,
    same_store: i64,
    run_ticket_state_preserved: i64,
