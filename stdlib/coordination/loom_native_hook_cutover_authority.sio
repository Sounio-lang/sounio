//! LOOM action 9045: native provider hook cutover semantic authority.

pub struct LoomNativeHookCutoverObservation {
    pub mode: i64,
    pub stage: i64,
    pub provider: i64,
    pub dialect: i64,
    pub event: i64,
    pub parent_9044_frozen: i64,
    pub source_hash_bound: i64,
    pub freeze_hash_bound: i64,
    pub ocaml_hash_bound: i64,
    pub config_hash_bound: i64,
    pub provider_identity_bound: i64,
    pub dialect_raw_bound: i64,
    pub event_normalized: i64,
    pub raw_payload_hash_bound: i64,
    pub session_bound: i64,
    pub cwd_bound: i64,
    pub agent_lane_bound: i64,
    pub pre_execution: i64,
    pub tool_name_bound: i64,
    pub tool_input_bound: i64,
    pub fail_closed: i64,
    pub decision_receipt_complete: i64,
    pub python_bridge_absent: i64,
    pub rust_bridge_absent: i64,
    pub disposable_oracle_absent: i64,
    pub provider_config_native: i64,
    pub process_authority_attached: i64,
    pub hook_capability_attached: i64,
    pub provider_live_canary: i64,
    pub four_provider_configs: i64,
    pub four_provider_canaries: i64,
    pub claim_ready_requested: i64,
    pub parity_open: i64,
    pub canary_mask: i64,
    pub semantic_hash0: i64,
    pub semantic_hash1: i64,
    pub ocaml_hash: i64,
    pub config_hash: i64,
    pub sabotage_count: i64,
    pub sabotage_required: i64,
}

fn hook_fact(word: i64, shift: i64) -> i64 {
    (word >> shift) & 1
}

pub fn loom_native_hook_cutover_observation_from_words(
    mode: i64,
    stage: i64,
    provider: i64,
    dialect: i64,
    event: i64,
    word: i64,
    canary_mask: i64,
    semantic_hash0: i64,
    semantic_hash1: i64,
    ocaml_hash: i64,
    config_hash: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> LoomNativeHookCutoverObservation {
    LoomNativeHookCutoverObservation {
        mode: mode,
        stage: stage,
        provider: provider,
        dialect: dialect,
        event: event,
        parent_9044_frozen: hook_fact(word, 0),
        source_hash_bound: hook_fact(word, 1),
        freeze_hash_bound: hook_fact(word, 2),
        ocaml_hash_bound: hook_fact(word, 3),
        config_hash_bound: hook_fact(word, 4),
        provider_identity_bound: hook_fact(word, 5),
        dialect_raw_bound: hook_fact(word, 6),
        event_normalized: hook_fact(word, 7),
        raw_payload_hash_bound: hook_fact(word, 8),
        session_bound: hook_fact(word, 9),
        cwd_bound: hook_fact(word, 10),
        agent_lane_bound: hook_fact(word, 11),
        pre_execution: hook_fact(word, 12),
        tool_name_bound: hook_fact(word, 13),
        tool_input_bound: hook_fact(word, 14),
        fail_closed: hook_fact(word, 15),
        decision_receipt_complete: hook_fact(word, 16),
        python_bridge_absent: hook_fact(word, 17),
        rust_bridge_absent: hook_fact(word, 18),
        disposable_oracle_absent: hook_fact(word, 19),
        provider_config_native: hook_fact(word, 20),
        process_authority_attached: hook_fact(word, 21),
        hook_capability_attached: hook_fact(word, 22),
        provider_live_canary: hook_fact(word, 23),
        four_provider_configs: hook_fact(word, 24),
        four_provider_canaries: hook_fact(word, 25),
        claim_ready_requested: hook_fact(word, 26),
        parity_open: hook_fact(word, 27),
        canary_mask: canary_mask,
        semantic_hash0: semantic_hash0,
        semantic_hash1: semantic_hash1,
        ocaml_hash: ocaml_hash,
        config_hash: config_hash,
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
}

fn hook_provider_dialect_exact(provider: i64, dialect: i64) -> bool {
    if provider == 1 { return dialect == 1 }
    if provider == 2 { return dialect == 1 }
    if provider == 3 { return dialect == 2 }
    if provider == 4 { return dialect == 3 }
    false
}

fn hook_provider_canary_mask(provider: i64) -> i64 {
    if provider == 1 { return 1 }
    if provider == 2 { return 2 }
    if provider == 3 { return 4 }
    if provider == 4 { return 8 }
    0
}

fn hook_future_than_event(o: LoomNativeHookCutoverObservation) -> bool {
    o.provider_live_canary == 1 || o.four_provider_configs == 1 ||
    o.four_provider_canaries == 1 || o.claim_ready_requested == 1 ||
    o.parity_open == 1
}

fn hook_future_than_canary(o: LoomNativeHookCutoverObservation) -> bool {
    o.four_provider_configs == 1 || o.four_provider_canaries == 1 ||
    o.claim_ready_requested == 1 || o.parity_open == 1
}

// 1 = HOOK_EVENT_ADMIT, 2 = PROVIDER_CANARY_ADMIT, 3 = CLAIM_READY.
pub fn judge_loom_native_hook_cutover(
    o: LoomNativeHookCutoverObservation,
) -> i64 {
    if o.stage != 3 || o.parent_9044_frozen != 1 { return 651 }
    if o.source_hash_bound != 1 || o.freeze_hash_bound != 1 ||
        o.ocaml_hash_bound != 1 || o.config_hash_bound != 1 ||
        (o.semantic_hash0 == 0 && o.semantic_hash1 == 0) ||
        o.ocaml_hash == 0 || o.config_hash == 0 { return 652 }
    if o.provider_identity_bound != 1 || o.dialect_raw_bound != 1 ||
        o.event_normalized != 1 || o.raw_payload_hash_bound != 1 ||
        o.session_bound != 1 || o.cwd_bound != 1 ||
        o.agent_lane_bound != 1 || o.fail_closed != 1 ||
        o.decision_receipt_complete != 1 ||
        o.provider_config_native != 1 ||
        o.process_authority_attached != 1 ||
        o.hook_capability_attached != 1 { return 653 }
    if o.python_bridge_absent != 1 || o.rust_bridge_absent != 1 ||
        o.disposable_oracle_absent != 1 { return 654 }
    if o.sabotage_required < 4 ||
        o.sabotage_count < o.sabotage_required { return 660 }

    if o.mode == 3 {
        if o.provider != 0 || o.dialect != 0 || o.event != 0 ||
            o.pre_execution != 0 || o.tool_name_bound != 0 ||
            o.tool_input_bound != 0 || o.provider_live_canary != 1 ||
            o.four_provider_configs != 1 ||
            o.four_provider_canaries != 1 ||
            o.claim_ready_requested != 1 || o.parity_open != 1 ||
            o.canary_mask != 15 { return 659 }
        return 3
    }

    if !hook_provider_dialect_exact(o.provider, o.dialect) { return 655 }
    if o.event < 1 || o.event > 6 { return 656 }
    if o.event == 3 {
        if o.pre_execution != 1 || o.tool_name_bound != 1 ||
            o.tool_input_bound != 1 { return 657 }
    } else if o.pre_execution != 0 || o.tool_name_bound != 0 ||
        o.tool_input_bound != 0 { return 657 }

    if o.mode == 1 {
        if hook_future_than_event(o) || o.canary_mask != 0 { return 657 }
        return 1
    }
    if o.mode == 2 {
        if o.provider_live_canary != 1 || hook_future_than_canary(o) ||
            o.canary_mask != hook_provider_canary_mask(o.provider) { return 658 }
        return 2
    }
    661
}

pub fn judge_loom_native_hook_cutover_words(
    mode: i64,
    stage: i64,
    provider: i64,
    dialect: i64,
    event: i64,
    word: i64,
    canary_mask: i64,
    semantic_hash0: i64,
    semantic_hash1: i64,
    ocaml_hash: i64,
    config_hash: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> i64 {
    judge_loom_native_hook_cutover(
        loom_native_hook_cutover_observation_from_words(
            mode, stage, provider, dialect, event, word, canary_mask,
            semantic_hash0, semantic_hash1, ocaml_hash, config_hash,
            sabotage_count, sabotage_required,
        ),
    )
}

pub fn loom_native_hook_cutover_selftest() -> i64 with Mut {
    var failed: i64 = 0
    if judge_loom_native_hook_cutover_words(
        1, 3, 1, 1, 3, 8388607, 0, 1, 2, 3, 4, 4, 4,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        1, 3, 2, 1, 1, 8359935, 0, 1, 2, 3, 4, 4, 4,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        1, 3, 3, 2, 1, 8359935, 0, 1, 2, 3, 4, 4, 4,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        1, 3, 4, 3, 1, 8359935, 0, 1, 2, 3, 4, 4, 4,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        2, 3, 3, 2, 1, 16748543, 4, 1, 2, 3, 4, 4, 4,
    ) != 2 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        3, 3, 0, 0, 0, 268406783, 15, 1, 2, 3, 4, 4, 4,
    ) != 3 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        1, 3, 3, 1, 1, 8359935, 0, 1, 2, 3, 4, 4, 4,
    ) != 655 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        1, 3, 1, 1, 3, 8359935, 0, 1, 2, 3, 4, 4, 4,
    ) != 657 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        1, 3, 1, 1, 1, 8228863, 0, 1, 2, 3, 4, 4, 4,
    ) != 654 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        2, 3, 3, 2, 1, 16748543, 8, 1, 2, 3, 4, 4, 4,
    ) != 658 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        3, 3, 0, 0, 0, 268406783, 14, 1, 2, 3, 4, 4, 4,
    ) != 659 { failed = failed + 1 }
    if judge_loom_native_hook_cutover_words(
        1, 3, 1, 1, 1, 8359935, 0, 1, 2, 3, 4, 3, 4,
    ) != 660 { failed = failed + 1 }
    failed
}
