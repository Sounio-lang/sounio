//! LOOM action 9035: semantic authority for a typed execution catalog.
//!
//! V1 admits calibration and a read-only, worktree-relative Sounio check.
//! It does not admit arbitrary shell execution.

struct LoomExecCatalogDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomExecCatalogObservation {
    stage: i64,
    preregistered: i64,
    operation: i64,
    catalog_sha256: LoomExecCatalogDigest256,
    command_template_sha256: LoomExecCatalogDigest256,
    argument_schema_valid: i64,
    input_digest_present: i64,
    workspace_relative: i64,
    extension_sio: i64,
    path_traversal_absent: i64,
    shell_metacharacters_absent: i64,
    network_absent: i64,
    write_effect_absent: i64,
    descriptor_inherited: i64,
    descriptor_peer_authenticated: i64,
    lane_principal_bound: i64,
    descriptor_one_shot: i64,
    pathname_not_authority: i64,
    producer_sounio: i64,
    result_schema_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    review_unpromoted: i64,
    parity_unpromoted: i64,
    disposable_oracle_absent: i64,
    provenance_complete: i64,
    raw_event_separate: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

pub fn loom_exec_catalog_digest256(
    limb0: i64, limb1: i64, limb2: i64, limb3: i64,
    limb4: i64, limb5: i64, limb6: i64, limb7: i64,
) -> LoomExecCatalogDigest256 {
    LoomExecCatalogDigest256 {
        limb0: limb0, limb1: limb1, limb2: limb2, limb3: limb3,
        limb4: limb4, limb5: limb5, limb6: limb6, limb7: limb7,
    }
}

fn loom_exec_catalog_equal(
    left: LoomExecCatalogDigest256,
    right: LoomExecCatalogDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn loom_exec_catalog_zero() -> LoomExecCatalogDigest256 {
    loom_exec_catalog_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn loom_exec_catalog_v1_digest() -> LoomExecCatalogDigest256 {
    loom_exec_catalog_digest256(
        822648121, 1762430464, 2379737755, 4274978174,
        1373906300, 3647867167, 2142540482, 1089287212,
    )
}

fn loom_exec_catalog_calibration_template() -> LoomExecCatalogDigest256 {
    loom_exec_catalog_digest256(
        134198296, 1998023264, 2957593053, 2026443539,
        2504906585, 1497309287, 2048602063, 4003666528,
    )
}

fn loom_exec_catalog_sounio_check_template() -> LoomExecCatalogDigest256 {
    loom_exec_catalog_digest256(
        991517312, 809917369, 1648690064, 1408979614,
        3409571123, 233665663, 3587641736, 4266434777,
    )
}

fn loom_exec_catalog_operation_known(operation: i64) -> bool {
    operation == 1 || operation == 2
}

fn loom_exec_catalog_template_binding_rule(
    operation: i64,
    command_template_sha256: LoomExecCatalogDigest256,
) -> bool {
    if operation == 1 {
        return loom_exec_catalog_equal(
            command_template_sha256,
            loom_exec_catalog_calibration_template())
    }
    if operation == 2 {
        return loom_exec_catalog_equal(
            command_template_sha256,
            loom_exec_catalog_sounio_check_template())
    }
    false
}

// 1 = PROJECT. All other values are fail-closed refusal codes.
pub fn judge_loom_exec_operation_catalog(
    observation: LoomExecCatalogObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 {
        return 405
    }
    if observation.producer_sounio != 1 ||
        observation.result_schema_sounio != 1 ||
        observation.python_absent != 1 || observation.rust_absent != 1 ||
        observation.review_unpromoted != 1 ||
        observation.parity_unpromoted != 1 ||
        observation.disposable_oracle_absent != 1 {
        return 560
    }
    if !loom_exec_catalog_equal(
            observation.catalog_sha256,
            loom_exec_catalog_v1_digest()) {
        return 561
    }
    if !loom_exec_catalog_operation_known(observation.operation) {
        return 562
    }
    if observation.operation == 2 &&
        (observation.argument_schema_valid != 1 ||
         observation.input_digest_present != 1 ||
         observation.workspace_relative != 1 ||
         observation.extension_sio != 1 ||
         observation.path_traversal_absent != 1 ||
         observation.shell_metacharacters_absent != 1) {
        return 563
    }
    if observation.network_absent != 1 ||
        observation.write_effect_absent != 1 {
        return 564
    }
    if observation.descriptor_inherited != 1 ||
        observation.descriptor_peer_authenticated != 1 ||
        observation.lane_principal_bound != 1 ||
        observation.descriptor_one_shot != 1 ||
        observation.pathname_not_authority != 1 {
        return 565
    }
    if observation.provenance_complete != 1 ||
        observation.raw_event_separate != 1 ||
        observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required {
        return 566
    }
    // Causal control: deleting only this comparison must admit the unchanged
    // template-mismatch witness.
    if !loom_exec_catalog_template_binding_rule(
            observation.operation,
            observation.command_template_sha256) {
        return 567
    }
    1
}

fn loom_exec_catalog_bit(mask: i64, divisor: i64) -> i64 with Div {
    (mask / divisor) % 2
}

pub fn judge_loom_exec_operation_catalog_v1_words(
    word0: i64,
    word1: i64,
) -> i64 with Div {
    let operation = (word0 >> 3) & 3
    let observation = LoomExecCatalogObservation {
        stage: word0 & 3,
        preregistered: (word0 >> 2) & 1,
        operation: operation,
        catalog_sha256:
            if loom_exec_catalog_bit(word0, 32) == 1 {
                loom_exec_catalog_v1_digest()
            } else { loom_exec_catalog_zero() },
        command_template_sha256:
            if loom_exec_catalog_bit(word0, 64) == 1 {
                if operation == 1 {
                    loom_exec_catalog_calibration_template()
                } else {
                    loom_exec_catalog_sounio_check_template()
                }
            } else { loom_exec_catalog_zero() },
        argument_schema_valid: loom_exec_catalog_bit(word0, 128),
        input_digest_present: loom_exec_catalog_bit(word0, 256),
        workspace_relative: loom_exec_catalog_bit(word0, 512),
        extension_sio: loom_exec_catalog_bit(word0, 1024),
        path_traversal_absent: loom_exec_catalog_bit(word0, 2048),
        shell_metacharacters_absent: loom_exec_catalog_bit(word0, 4096),
        network_absent: loom_exec_catalog_bit(word0, 8192),
        write_effect_absent: loom_exec_catalog_bit(word0, 16384),
        descriptor_inherited: loom_exec_catalog_bit(word0, 32768),
        descriptor_peer_authenticated: loom_exec_catalog_bit(word0, 65536),
        lane_principal_bound: loom_exec_catalog_bit(word0, 131072),
        descriptor_one_shot: loom_exec_catalog_bit(word0, 262144),
        pathname_not_authority: loom_exec_catalog_bit(word0, 524288),
        producer_sounio: loom_exec_catalog_bit(word0, 1048576),
        result_schema_sounio: loom_exec_catalog_bit(word0, 2097152),
        python_absent: loom_exec_catalog_bit(word0, 4194304),
        rust_absent: loom_exec_catalog_bit(word0, 8388608),
        review_unpromoted: loom_exec_catalog_bit(word0, 16777216),
        parity_unpromoted: loom_exec_catalog_bit(word0, 33554432),
        disposable_oracle_absent: loom_exec_catalog_bit(word0, 67108864),
        provenance_complete: loom_exec_catalog_bit(word0, 134217728),
        raw_event_separate: loom_exec_catalog_bit(word0, 268435456),
        sabotage_count: word1 & 255,
        sabotage_required: (word1 >> 8) & 255,
    }
    judge_loom_exec_operation_catalog(observation)
}

fn loom_exec_catalog_case(case_index: i64) -> i64 with Div {
    let calibration: i64 = 536870895
    let sounio_check: i64 = 536870903
    let evidence: i64 = 1028
    if case_index == 1 {
        return judge_loom_exec_operation_catalog_v1_words(
            calibration, evidence)
    }
    if case_index == 2 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check, evidence)
    }
    if case_index == 3 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 1, evidence)
    }
    if case_index == 4 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 1048576, evidence)
    }
    if case_index == 5 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 32, evidence)
    }
    if case_index == 6 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 16, evidence)
    }
    if case_index == 7 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 512, evidence)
    }
    if case_index == 8 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 16384, evidence)
    }
    if case_index == 9 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 32768, evidence)
    }
    if case_index == 10 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check, evidence - 4)
    }
    if case_index == 11 {
        return judge_loom_exec_operation_catalog_v1_words(
            sounio_check - 64, evidence)
    }
    424
}

pub fn loom_exec_operation_catalog_selftest() -> i64 with Div {
    if loom_exec_catalog_case(1) != 1 { return 1 }
    if loom_exec_catalog_case(2) != 1 { return 2 }
    if loom_exec_catalog_case(3) != 405 { return 3 }
    if loom_exec_catalog_case(4) != 560 { return 4 }
    if loom_exec_catalog_case(5) != 561 { return 5 }
    if loom_exec_catalog_case(6) != 562 { return 6 }
    if loom_exec_catalog_case(7) != 563 { return 7 }
    if loom_exec_catalog_case(8) != 564 { return 8 }
    if loom_exec_catalog_case(9) != 565 { return 9 }
    if loom_exec_catalog_case(10) != 566 { return 10 }
    if loom_exec_catalog_case(11) != 567 { return 11 }
    0
}
