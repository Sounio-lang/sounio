//! Effect-free content-addressed restore capsule authority for the Spark pair.
//!
//! Frame 9027 binds evidence identities only. It performs no capture, replay,
//! restore, scheduler operation, host access, network access, or material
//! dispatch and has no bridge into frames 9025 or 9026.

pub struct SparkPairRestoreDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

pub struct SparkPairRestoreAuthorityFacts {
    canonical: bool,
    policy_present: bool,
    policy_error: bool,
    operation_timed_out: bool,
    parent_9026_freeze_exact: bool,
    canonical_pair_identity_exact: bool,
    prior_decision_receipt_exact: bool,
    hash_algorithm_sha256: bool,
    canonical_serialization_exact: bool,
    digest_domains_distinct: bool,
}

pub struct SparkPairRestoreSnapshotFacts {
    canonical: bool,
    pair_manifest_digest_matches_bytes: bool,
    node0_digest_matches_bytes: bool,
    node1_digest_matches_bytes: bool,
    manifest_binds_ordered_node_digests: bool,
    exactly_two_nodes: bool,
    canonical_nodes_distinct: bool,
    preinstall_provenance_exact: bool,
    service_enablement_exact: bool,
    restart_policy_exact: bool,
    container_identity_exact: bool,
    nodeset_identity_exact: bool,
    device_plugin_identity_exact: bool,
    taints_exact: bool,
    labels_exact: bool,
    boot_identity_recorded_exact: bool,
    protected_paths_exact: bool,
    toolchain_hardware_commands_recorded: bool,
    capture_read_only_receipt_exact: bool,
    no_unknown_or_implicit_fields: bool,
    snapshot_binding_receipt_exact: bool,
}

pub struct SparkPairRestoreReplayFacts {
    canonical: bool,
    witness_digest_matches_bytes: bool,
    witness_binds_snapshot_digest: bool,
    witness_binds_parent_9026_freeze: bool,
    sandbox_filesystem_root_exact: bool,
    network_absent: bool,
    cluster_credentials_absent: bool,
    source_host_mounts_absent: bool,
    privileged_effects_absent: bool,
    exactly_two_replay_nodes: bool,
    replay_node_identity_exact: bool,
    service_restart_container_match: bool,
    scheduler_surface_match: bool,
    taints_labels_boot_metadata_match: bool,
    replay_output_pair_digest_matches: bool,
    deterministic_repeat_digest_matches: bool,
    toolchain_hardware_commands_recorded: bool,
    no_unresolved_or_skipped_checks: bool,
    replay_binding_receipt_exact: bool,
}

pub struct SparkPairRestoreDecision {
    allowed: bool,
    current_state: i64,
    next_state: i64,
    reason: i64,
}

fn restore_bit_is_canonical(value: i64) -> bool {
    value == 0 || value == 1
}

fn restore_bool(value: i64) -> bool {
    value == 1
}

pub fn admit_spark_pair_restore_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> SparkPairRestoreDigest256 {
    SparkPairRestoreDigest256 {
        limb0: limb0, limb1: limb1, limb2: limb2, limb3: limb3,
        limb4: limb4, limb5: limb5, limb6: limb6, limb7: limb7,
    }
}

fn restore_digest_is_canonical(digest: SparkPairRestoreDigest256) -> bool {
    digest.limb0 >= 0 && digest.limb0 <= 4294967295 &&
    digest.limb1 >= 0 && digest.limb1 <= 4294967295 &&
    digest.limb2 >= 0 && digest.limb2 <= 4294967295 &&
    digest.limb3 >= 0 && digest.limb3 <= 4294967295 &&
    digest.limb4 >= 0 && digest.limb4 <= 4294967295 &&
    digest.limb5 >= 0 && digest.limb5 <= 4294967295 &&
    digest.limb6 >= 0 && digest.limb6 <= 4294967295 &&
    digest.limb7 >= 0 && digest.limb7 <= 4294967295
}

fn restore_digest_is_nonzero(digest: SparkPairRestoreDigest256) -> bool {
    digest.limb0 != 0 || digest.limb1 != 0 || digest.limb2 != 0 ||
    digest.limb3 != 0 || digest.limb4 != 0 || digest.limb5 != 0 ||
    digest.limb6 != 0 || digest.limb7 != 0
}

fn restore_digest_equal(
    left: SparkPairRestoreDigest256,
    right: SparkPairRestoreDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn restore_parent_9026_digest_is_exact(digest: SparkPairRestoreDigest256) -> bool {
    digest.limb0 == 2011030821 && digest.limb1 == 1636765562 &&
    digest.limb2 == 1748692508 && digest.limb3 == 121902653 &&
    digest.limb4 == 3091400404 && digest.limb5 == 2700016043 &&
    digest.limb6 == 1171519388 && digest.limb7 == 3790294414
}

pub fn admit_spark_pair_restore_authority_facts(
    policy_present: i64,
    policy_error: i64,
    operation_timed_out: i64,
    parent_9026_freeze_exact: i64,
    canonical_pair_identity_exact: i64,
    prior_decision_receipt_exact: i64,
    hash_algorithm_sha256: i64,
    canonical_serialization_exact: i64,
    digest_domains_distinct: i64,
) -> SparkPairRestoreAuthorityFacts {
    SparkPairRestoreAuthorityFacts {
        canonical: restore_bit_is_canonical(policy_present) &&
            restore_bit_is_canonical(policy_error) &&
            restore_bit_is_canonical(operation_timed_out) &&
            restore_bit_is_canonical(parent_9026_freeze_exact) &&
            restore_bit_is_canonical(canonical_pair_identity_exact) &&
            restore_bit_is_canonical(prior_decision_receipt_exact) &&
            restore_bit_is_canonical(hash_algorithm_sha256) &&
            restore_bit_is_canonical(canonical_serialization_exact) &&
            restore_bit_is_canonical(digest_domains_distinct),
        policy_present: restore_bool(policy_present),
        policy_error: restore_bool(policy_error),
        operation_timed_out: restore_bool(operation_timed_out),
        parent_9026_freeze_exact: restore_bool(parent_9026_freeze_exact),
        canonical_pair_identity_exact: restore_bool(canonical_pair_identity_exact),
        prior_decision_receipt_exact: restore_bool(prior_decision_receipt_exact),
        hash_algorithm_sha256: restore_bool(hash_algorithm_sha256),
        canonical_serialization_exact: restore_bool(canonical_serialization_exact),
        digest_domains_distinct: restore_bool(digest_domains_distinct),
    }
}

pub fn admit_spark_pair_restore_snapshot_facts(
    pair_manifest_digest_matches_bytes: i64,
    node0_digest_matches_bytes: i64,
    node1_digest_matches_bytes: i64,
    manifest_binds_ordered_node_digests: i64,
    exactly_two_nodes: i64,
    canonical_nodes_distinct: i64,
    preinstall_provenance_exact: i64,
    service_enablement_exact: i64,
    restart_policy_exact: i64,
    container_identity_exact: i64,
    nodeset_identity_exact: i64,
    device_plugin_identity_exact: i64,
    taints_exact: i64,
    labels_exact: i64,
    boot_identity_recorded_exact: i64,
    protected_paths_exact: i64,
    toolchain_hardware_commands_recorded: i64,
    capture_read_only_receipt_exact: i64,
    no_unknown_or_implicit_fields: i64,
    snapshot_binding_receipt_exact: i64,
) -> SparkPairRestoreSnapshotFacts {
    SparkPairRestoreSnapshotFacts {
        canonical:
            restore_bit_is_canonical(pair_manifest_digest_matches_bytes) &&
            restore_bit_is_canonical(node0_digest_matches_bytes) &&
            restore_bit_is_canonical(node1_digest_matches_bytes) &&
            restore_bit_is_canonical(manifest_binds_ordered_node_digests) &&
            restore_bit_is_canonical(exactly_two_nodes) &&
            restore_bit_is_canonical(canonical_nodes_distinct) &&
            restore_bit_is_canonical(preinstall_provenance_exact) &&
            restore_bit_is_canonical(service_enablement_exact) &&
            restore_bit_is_canonical(restart_policy_exact) &&
            restore_bit_is_canonical(container_identity_exact) &&
            restore_bit_is_canonical(nodeset_identity_exact) &&
            restore_bit_is_canonical(device_plugin_identity_exact) &&
            restore_bit_is_canonical(taints_exact) &&
            restore_bit_is_canonical(labels_exact) &&
            restore_bit_is_canonical(boot_identity_recorded_exact) &&
            restore_bit_is_canonical(protected_paths_exact) &&
            restore_bit_is_canonical(toolchain_hardware_commands_recorded) &&
            restore_bit_is_canonical(capture_read_only_receipt_exact) &&
            restore_bit_is_canonical(no_unknown_or_implicit_fields) &&
            restore_bit_is_canonical(snapshot_binding_receipt_exact),
        pair_manifest_digest_matches_bytes: restore_bool(pair_manifest_digest_matches_bytes),
        node0_digest_matches_bytes: restore_bool(node0_digest_matches_bytes),
        node1_digest_matches_bytes: restore_bool(node1_digest_matches_bytes),
        manifest_binds_ordered_node_digests: restore_bool(manifest_binds_ordered_node_digests),
        exactly_two_nodes: restore_bool(exactly_two_nodes),
        canonical_nodes_distinct: restore_bool(canonical_nodes_distinct),
        preinstall_provenance_exact: restore_bool(preinstall_provenance_exact),
        service_enablement_exact: restore_bool(service_enablement_exact),
        restart_policy_exact: restore_bool(restart_policy_exact),
        container_identity_exact: restore_bool(container_identity_exact),
        nodeset_identity_exact: restore_bool(nodeset_identity_exact),
        device_plugin_identity_exact: restore_bool(device_plugin_identity_exact),
        taints_exact: restore_bool(taints_exact),
        labels_exact: restore_bool(labels_exact),
        boot_identity_recorded_exact: restore_bool(boot_identity_recorded_exact),
        protected_paths_exact: restore_bool(protected_paths_exact),
        toolchain_hardware_commands_recorded: restore_bool(toolchain_hardware_commands_recorded),
        capture_read_only_receipt_exact: restore_bool(capture_read_only_receipt_exact),
        no_unknown_or_implicit_fields: restore_bool(no_unknown_or_implicit_fields),
        snapshot_binding_receipt_exact: restore_bool(snapshot_binding_receipt_exact),
    }
}

pub fn admit_spark_pair_restore_replay_facts(
    witness_digest_matches_bytes: i64,
    witness_binds_snapshot_digest: i64,
    witness_binds_parent_9026_freeze: i64,
    sandbox_filesystem_root_exact: i64,
    network_absent: i64,
    cluster_credentials_absent: i64,
    source_host_mounts_absent: i64,
    privileged_effects_absent: i64,
    exactly_two_replay_nodes: i64,
    replay_node_identity_exact: i64,
    service_restart_container_match: i64,
    scheduler_surface_match: i64,
    taints_labels_boot_metadata_match: i64,
    replay_output_pair_digest_matches: i64,
    deterministic_repeat_digest_matches: i64,
    toolchain_hardware_commands_recorded: i64,
    no_unresolved_or_skipped_checks: i64,
    replay_binding_receipt_exact: i64,
) -> SparkPairRestoreReplayFacts {
    SparkPairRestoreReplayFacts {
        canonical:
            restore_bit_is_canonical(witness_digest_matches_bytes) &&
            restore_bit_is_canonical(witness_binds_snapshot_digest) &&
            restore_bit_is_canonical(witness_binds_parent_9026_freeze) &&
            restore_bit_is_canonical(sandbox_filesystem_root_exact) &&
            restore_bit_is_canonical(network_absent) &&
            restore_bit_is_canonical(cluster_credentials_absent) &&
            restore_bit_is_canonical(source_host_mounts_absent) &&
            restore_bit_is_canonical(privileged_effects_absent) &&
            restore_bit_is_canonical(exactly_two_replay_nodes) &&
            restore_bit_is_canonical(replay_node_identity_exact) &&
            restore_bit_is_canonical(service_restart_container_match) &&
            restore_bit_is_canonical(scheduler_surface_match) &&
            restore_bit_is_canonical(taints_labels_boot_metadata_match) &&
            restore_bit_is_canonical(replay_output_pair_digest_matches) &&
            restore_bit_is_canonical(deterministic_repeat_digest_matches) &&
            restore_bit_is_canonical(toolchain_hardware_commands_recorded) &&
            restore_bit_is_canonical(no_unresolved_or_skipped_checks) &&
            restore_bit_is_canonical(replay_binding_receipt_exact),
        witness_digest_matches_bytes: restore_bool(witness_digest_matches_bytes),
        witness_binds_snapshot_digest: restore_bool(witness_binds_snapshot_digest),
        witness_binds_parent_9026_freeze: restore_bool(witness_binds_parent_9026_freeze),
        sandbox_filesystem_root_exact: restore_bool(sandbox_filesystem_root_exact),
        network_absent: restore_bool(network_absent),
        cluster_credentials_absent: restore_bool(cluster_credentials_absent),
        source_host_mounts_absent: restore_bool(source_host_mounts_absent),
        privileged_effects_absent: restore_bool(privileged_effects_absent),
        exactly_two_replay_nodes: restore_bool(exactly_two_replay_nodes),
        replay_node_identity_exact: restore_bool(replay_node_identity_exact),
        service_restart_container_match: restore_bool(service_restart_container_match),
        scheduler_surface_match: restore_bool(scheduler_surface_match),
        taints_labels_boot_metadata_match: restore_bool(taints_labels_boot_metadata_match),
        replay_output_pair_digest_matches: restore_bool(replay_output_pair_digest_matches),
        deterministic_repeat_digest_matches: restore_bool(deterministic_repeat_digest_matches),
        toolchain_hardware_commands_recorded: restore_bool(toolchain_hardware_commands_recorded),
        no_unresolved_or_skipped_checks: restore_bool(no_unresolved_or_skipped_checks),
        replay_binding_receipt_exact: restore_bool(replay_binding_receipt_exact),
    }
}

fn restore_allow(current_state: i64, next_state: i64) -> SparkPairRestoreDecision {
    SparkPairRestoreDecision {
        allowed: true, current_state: current_state, next_state: next_state, reason: 0,
    }
}

fn restore_refuse(current_state: i64, reason: i64) -> SparkPairRestoreDecision {
    SparkPairRestoreDecision {
        allowed: false, current_state: current_state, next_state: current_state, reason: reason,
    }
}

fn restore_state_is_known(state: i64) -> bool {
    state >= 20 && state <= 23
}

fn restore_authority_reason(authority: SparkPairRestoreAuthorityFacts) -> i64 {
    if !authority.policy_present { return 301 }
    if authority.policy_error { return 302 }
    if authority.operation_timed_out { return 303 }
    if !authority.parent_9026_freeze_exact { return 307 }
    if !authority.canonical_pair_identity_exact { return 308 }
    if !authority.hash_algorithm_sha256 || !authority.digest_domains_distinct { return 309 }
    if !authority.canonical_serialization_exact { return 310 }
    0
}

fn restore_snapshot_all_absent(snapshot: SparkPairRestoreSnapshotFacts) -> bool {
    !snapshot.pair_manifest_digest_matches_bytes &&
    !snapshot.node0_digest_matches_bytes && !snapshot.node1_digest_matches_bytes &&
    !snapshot.manifest_binds_ordered_node_digests && !snapshot.exactly_two_nodes &&
    !snapshot.canonical_nodes_distinct && !snapshot.preinstall_provenance_exact &&
    !snapshot.service_enablement_exact && !snapshot.restart_policy_exact &&
    !snapshot.container_identity_exact && !snapshot.nodeset_identity_exact &&
    !snapshot.device_plugin_identity_exact && !snapshot.taints_exact &&
    !snapshot.labels_exact && !snapshot.boot_identity_recorded_exact &&
    !snapshot.protected_paths_exact && !snapshot.toolchain_hardware_commands_recorded &&
    !snapshot.capture_read_only_receipt_exact && !snapshot.no_unknown_or_implicit_fields &&
    !snapshot.snapshot_binding_receipt_exact
}

fn restore_replay_all_absent(replay: SparkPairRestoreReplayFacts) -> bool {
    !replay.witness_digest_matches_bytes && !replay.witness_binds_snapshot_digest &&
    !replay.witness_binds_parent_9026_freeze && !replay.sandbox_filesystem_root_exact &&
    !replay.network_absent && !replay.cluster_credentials_absent &&
    !replay.source_host_mounts_absent && !replay.privileged_effects_absent &&
    !replay.exactly_two_replay_nodes && !replay.replay_node_identity_exact &&
    !replay.service_restart_container_match && !replay.scheduler_surface_match &&
    !replay.taints_labels_boot_metadata_match && !replay.replay_output_pair_digest_matches &&
    !replay.deterministic_repeat_digest_matches &&
    !replay.toolchain_hardware_commands_recorded &&
    !replay.no_unresolved_or_skipped_checks && !replay.replay_binding_receipt_exact
}

fn restore_snapshot_reason(
    snapshot: SparkPairRestoreSnapshotFacts,
    receipt_required: bool,
) -> i64 {
    if !snapshot.pair_manifest_digest_matches_bytes { return 311 }
    if !snapshot.node0_digest_matches_bytes || !snapshot.node1_digest_matches_bytes { return 312 }
    if !snapshot.manifest_binds_ordered_node_digests { return 313 }
    if !snapshot.exactly_two_nodes || !snapshot.canonical_nodes_distinct { return 314 }
    if !snapshot.preinstall_provenance_exact { return 315 }
    if !snapshot.service_enablement_exact || !snapshot.restart_policy_exact { return 316 }
    if !snapshot.container_identity_exact { return 317 }
    if !snapshot.nodeset_identity_exact || !snapshot.device_plugin_identity_exact { return 318 }
    if !snapshot.taints_exact || !snapshot.labels_exact ||
        !snapshot.boot_identity_recorded_exact { return 319 }
    if !snapshot.protected_paths_exact { return 320 }
    if !snapshot.toolchain_hardware_commands_recorded { return 321 }
    if !snapshot.capture_read_only_receipt_exact { return 322 }
    if !snapshot.no_unknown_or_implicit_fields { return 323 }
    if snapshot.snapshot_binding_receipt_exact != receipt_required { return 324 }
    0
}

fn restore_replay_reason(
    replay: SparkPairRestoreReplayFacts,
    receipt_required: bool,
) -> i64 {
    if !replay.witness_digest_matches_bytes { return 325 }
    if !replay.witness_binds_snapshot_digest ||
        !replay.witness_binds_parent_9026_freeze { return 326 }
    if !replay.sandbox_filesystem_root_exact || !replay.network_absent { return 327 }
    if !replay.cluster_credentials_absent || !replay.source_host_mounts_absent { return 328 }
    if !replay.privileged_effects_absent { return 329 }
    if !replay.exactly_two_replay_nodes || !replay.replay_node_identity_exact { return 330 }
    if !replay.service_restart_container_match || !replay.scheduler_surface_match ||
        !replay.taints_labels_boot_metadata_match { return 331 }
    if !replay.replay_output_pair_digest_matches { return 332 }
    if !replay.deterministic_repeat_digest_matches { return 333 }
    if !replay.toolchain_hardware_commands_recorded { return 334 }
    if !replay.no_unresolved_or_skipped_checks ||
        replay.replay_binding_receipt_exact != receipt_required { return 335 }
    0
}

fn restore_snapshot_digest_reason(
    snapshot_digest: SparkPairRestoreDigest256,
    node0_digest: SparkPairRestoreDigest256,
    node1_digest: SparkPairRestoreDigest256,
) -> i64 {
    if !restore_digest_is_nonzero(snapshot_digest) ||
        !restore_digest_is_nonzero(node0_digest) ||
        !restore_digest_is_nonzero(node1_digest) { return 309 }
    if restore_digest_equal(node0_digest, node1_digest) { return 314 }
    if restore_digest_equal(snapshot_digest, node0_digest) ||
        restore_digest_equal(snapshot_digest, node1_digest) { return 309 }
    0
}

fn restore_replay_digest_reason(
    snapshot_digest: SparkPairRestoreDigest256,
    node0_digest: SparkPairRestoreDigest256,
    node1_digest: SparkPairRestoreDigest256,
    replay_digest: SparkPairRestoreDigest256,
) -> i64 {
    if !restore_digest_is_nonzero(replay_digest) { return 325 }
    if restore_digest_equal(replay_digest, snapshot_digest) ||
        restore_digest_equal(replay_digest, node0_digest) ||
        restore_digest_equal(replay_digest, node1_digest) { return 309 }
    0
}

fn restore_prior_receipt_reason(
    authority: SparkPairRestoreAuthorityFacts,
    parent_digest: SparkPairRestoreDigest256,
    snapshot_digest: SparkPairRestoreDigest256,
    node0_digest: SparkPairRestoreDigest256,
    node1_digest: SparkPairRestoreDigest256,
    replay_digest: SparkPairRestoreDigest256,
    prior_receipt_digest: SparkPairRestoreDigest256,
    receipt_required: bool,
) -> i64 {
    let receipt_present = restore_digest_is_nonzero(prior_receipt_digest)
    if authority.prior_decision_receipt_exact != receipt_required ||
        receipt_present != receipt_required { return 324 }
    if receipt_present && (
        restore_digest_equal(prior_receipt_digest, parent_digest) ||
        restore_digest_equal(prior_receipt_digest, snapshot_digest) ||
        restore_digest_equal(prior_receipt_digest, node0_digest) ||
        restore_digest_equal(prior_receipt_digest, node1_digest) ||
        restore_digest_equal(prior_receipt_digest, replay_digest)
    ) { return 309 }
    0
}

pub fn decide_spark_pair_restore_capsule_plan(
    action: i64,
    current_state: i64,
    snapshot_digest: SparkPairRestoreDigest256,
    node0_digest: SparkPairRestoreDigest256,
    node1_digest: SparkPairRestoreDigest256,
    replay_digest: SparkPairRestoreDigest256,
    parent_9026_digest: SparkPairRestoreDigest256,
    prior_receipt_digest: SparkPairRestoreDigest256,
    authority: SparkPairRestoreAuthorityFacts,
    snapshot: SparkPairRestoreSnapshotFacts,
    replay: SparkPairRestoreReplayFacts,
) -> SparkPairRestoreDecision {
    if !authority.canonical || !snapshot.canonical || !replay.canonical ||
        !restore_digest_is_canonical(snapshot_digest) ||
        !restore_digest_is_canonical(node0_digest) ||
        !restore_digest_is_canonical(node1_digest) ||
        !restore_digest_is_canonical(replay_digest) ||
        !restore_digest_is_canonical(parent_9026_digest) ||
        !restore_digest_is_canonical(prior_receipt_digest) {
        return restore_refuse(current_state, 304)
    }
    if !restore_state_is_known(current_state) { return restore_refuse(current_state, 305) }
    if action < 50 || action > 53 { return restore_refuse(current_state, 306) }

    let authority_reason = restore_authority_reason(authority)
    if authority_reason != 0 { return restore_refuse(current_state, authority_reason) }
    if !restore_parent_9026_digest_is_exact(parent_9026_digest) {
        return restore_refuse(current_state, 307)
    }
    if restore_digest_equal(parent_9026_digest, snapshot_digest) ||
        restore_digest_equal(parent_9026_digest, node0_digest) ||
        restore_digest_equal(parent_9026_digest, node1_digest) ||
        restore_digest_equal(parent_9026_digest, replay_digest) {
        return restore_refuse(current_state, 309)
    }

    if action == 50 {
        if current_state == 20 {
            let receipt_reason = restore_prior_receipt_reason(
                authority, parent_9026_digest, snapshot_digest, node0_digest,
                node1_digest, replay_digest, prior_receipt_digest, false,
            )
            if receipt_reason != 0 { return restore_refuse(current_state, receipt_reason) }
            if restore_digest_is_nonzero(snapshot_digest) ||
                restore_digest_is_nonzero(node0_digest) ||
                restore_digest_is_nonzero(node1_digest) ||
                restore_digest_is_nonzero(replay_digest) { return restore_refuse(current_state, 309) }
            if !restore_snapshot_all_absent(snapshot) ||
                !restore_replay_all_absent(replay) { return restore_refuse(current_state, 304) }
            return restore_allow(current_state, current_state)
        }
        let receipt_reason = restore_prior_receipt_reason(
            authority, parent_9026_digest, snapshot_digest, node0_digest,
            node1_digest, replay_digest, prior_receipt_digest, true,
        )
        if receipt_reason != 0 { return restore_refuse(current_state, receipt_reason) }
        let digest_reason = restore_snapshot_digest_reason(
            snapshot_digest, node0_digest, node1_digest,
        )
        if digest_reason != 0 { return restore_refuse(current_state, digest_reason) }
        let snapshot_reason = restore_snapshot_reason(snapshot, true)
        if snapshot_reason != 0 { return restore_refuse(current_state, snapshot_reason) }
        if current_state == 21 {
            if restore_digest_is_nonzero(replay_digest) ||
                !restore_replay_all_absent(replay) { return restore_refuse(current_state, 304) }
            return restore_allow(current_state, current_state)
        }
        let replay_digest_reason = restore_replay_digest_reason(
            snapshot_digest, node0_digest, node1_digest, replay_digest,
        )
        if replay_digest_reason != 0 { return restore_refuse(current_state, replay_digest_reason) }
        let replay_reason = restore_replay_reason(replay, true)
        if replay_reason != 0 { return restore_refuse(current_state, replay_reason) }
        return restore_allow(current_state, current_state)
    }

    if action == 51 {
        if current_state != 20 { return restore_refuse(current_state, 305) }
        let receipt_reason = restore_prior_receipt_reason(
            authority, parent_9026_digest, snapshot_digest, node0_digest,
            node1_digest, replay_digest, prior_receipt_digest, false,
        )
        if receipt_reason != 0 { return restore_refuse(current_state, receipt_reason) }
        if restore_digest_is_nonzero(replay_digest) || !restore_replay_all_absent(replay) {
            return restore_refuse(current_state, 304)
        }
        let digest_reason = restore_snapshot_digest_reason(
            snapshot_digest, node0_digest, node1_digest,
        )
        if digest_reason != 0 { return restore_refuse(current_state, digest_reason) }
        let snapshot_reason = restore_snapshot_reason(snapshot, false)
        if snapshot_reason != 0 { return restore_refuse(current_state, snapshot_reason) }
        return restore_allow(current_state, 21)
    }

    if action == 52 {
        if current_state != 21 { return restore_refuse(current_state, 305) }
        let receipt_reason = restore_prior_receipt_reason(
            authority, parent_9026_digest, snapshot_digest, node0_digest,
            node1_digest, replay_digest, prior_receipt_digest, true,
        )
        if receipt_reason != 0 { return restore_refuse(current_state, receipt_reason) }
        let digest_reason = restore_snapshot_digest_reason(
            snapshot_digest, node0_digest, node1_digest,
        )
        if digest_reason != 0 { return restore_refuse(current_state, digest_reason) }
        let snapshot_reason = restore_snapshot_reason(snapshot, true)
        if snapshot_reason != 0 { return restore_refuse(current_state, snapshot_reason) }
        let replay_digest_reason = restore_replay_digest_reason(
            snapshot_digest, node0_digest, node1_digest, replay_digest,
        )
        if replay_digest_reason != 0 { return restore_refuse(current_state, replay_digest_reason) }
        let replay_reason = restore_replay_reason(replay, false)
        if replay_reason != 0 { return restore_refuse(current_state, replay_reason) }
        return restore_allow(current_state, 22)
    }

    if current_state != 22 && current_state != 23 {
        return restore_refuse(current_state, 305)
    }
    let receipt_reason = restore_prior_receipt_reason(
        authority, parent_9026_digest, snapshot_digest, node0_digest,
        node1_digest, replay_digest, prior_receipt_digest, true,
    )
    if receipt_reason != 0 { return restore_refuse(current_state, receipt_reason) }
    let digest_reason = restore_snapshot_digest_reason(
        snapshot_digest, node0_digest, node1_digest,
    )
    if digest_reason != 0 { return restore_refuse(current_state, digest_reason) }
    let snapshot_reason = restore_snapshot_reason(snapshot, true)
    if snapshot_reason != 0 { return restore_refuse(current_state, snapshot_reason) }
    let replay_digest_reason = restore_replay_digest_reason(
        snapshot_digest, node0_digest, node1_digest, replay_digest,
    )
    if replay_digest_reason != 0 { return restore_refuse(current_state, replay_digest_reason) }
    let replay_reason = restore_replay_reason(replay, true)
    if replay_reason != 0 { return restore_refuse(current_state, replay_reason) }
    restore_allow(current_state, 23)
}

pub fn spark_pair_restore_decision_allowed(decision: SparkPairRestoreDecision) -> bool {
    decision.allowed
}

pub fn spark_pair_restore_decision_current_state(decision: SparkPairRestoreDecision) -> i64 {
    decision.current_state
}

pub fn spark_pair_restore_decision_next_state(decision: SparkPairRestoreDecision) -> i64 {
    decision.next_state
}

pub fn spark_pair_restore_decision_reason(decision: SparkPairRestoreDecision) -> i64 {
    decision.reason
}
