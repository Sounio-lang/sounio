//! Sounio-only reversible decommission plan for the Spark Pair Arbiter.
//!
//! This authority extends frame 9025 without changing it. Frame 9026 emits
//! decisions with effect=NONE; no material controller dispatches these actions.

pub struct SparkPairDecommissionFacts {
    canonical: bool,
    active_steps_zero: bool,
    restore_snapshot_pair_exact: bool,
    restore_snapshot_replay_verified: bool,
    both_device_plugins_absent: bool,
    k8s_gpu_capacity_zero: bool,
    legacy_prepare_pair_exact: bool,
    legacy_commit_pair_exact: bool,
    legacy_services_restored_exact: bool,
    legacy_consumer_identity_exact: bool,
    legacy_restart_policy_exact: bool,
    decommission_tombstone_durable: bool,
    arbiter_retirement_order_exact: bool,
    recommission_intent_pair_exact: bool,
    phase1_surfaces_restored_exact: bool,
    phase1_slurm_receipt_exact: bool,
    legacy_owner_receipt_exact: bool,
    arbiter_surfaces_absent_exact: bool,
}

pub fn admit_spark_pair_decommission_facts(
    active_steps_zero: i64,
    restore_snapshot_pair_exact: i64,
    restore_snapshot_replay_verified: i64,
    both_device_plugins_absent: i64,
    k8s_gpu_capacity_zero: i64,
    legacy_prepare_pair_exact: i64,
    legacy_commit_pair_exact: i64,
    legacy_services_restored_exact: i64,
    legacy_consumer_identity_exact: i64,
    legacy_restart_policy_exact: i64,
    decommission_tombstone_durable: i64,
    arbiter_retirement_order_exact: i64,
    recommission_intent_pair_exact: i64,
    phase1_surfaces_restored_exact: i64,
    phase1_slurm_receipt_exact: i64,
    legacy_owner_receipt_exact: i64,
    arbiter_surfaces_absent_exact: i64,
) -> SparkPairDecommissionFacts {
    SparkPairDecommissionFacts {
        canonical:
            pair_bit_is_canonical(active_steps_zero) &&
            pair_bit_is_canonical(restore_snapshot_pair_exact) &&
            pair_bit_is_canonical(restore_snapshot_replay_verified) &&
            pair_bit_is_canonical(both_device_plugins_absent) &&
            pair_bit_is_canonical(k8s_gpu_capacity_zero) &&
            pair_bit_is_canonical(legacy_prepare_pair_exact) &&
            pair_bit_is_canonical(legacy_commit_pair_exact) &&
            pair_bit_is_canonical(legacy_services_restored_exact) &&
            pair_bit_is_canonical(legacy_consumer_identity_exact) &&
            pair_bit_is_canonical(legacy_restart_policy_exact) &&
            pair_bit_is_canonical(decommission_tombstone_durable) &&
            pair_bit_is_canonical(arbiter_retirement_order_exact) &&
            pair_bit_is_canonical(recommission_intent_pair_exact) &&
            pair_bit_is_canonical(phase1_surfaces_restored_exact) &&
            pair_bit_is_canonical(phase1_slurm_receipt_exact) &&
            pair_bit_is_canonical(legacy_owner_receipt_exact) &&
            pair_bit_is_canonical(arbiter_surfaces_absent_exact),
        active_steps_zero: pair_bool(active_steps_zero),
        restore_snapshot_pair_exact: pair_bool(restore_snapshot_pair_exact),
        restore_snapshot_replay_verified: pair_bool(restore_snapshot_replay_verified),
        both_device_plugins_absent: pair_bool(both_device_plugins_absent),
        k8s_gpu_capacity_zero: pair_bool(k8s_gpu_capacity_zero),
        legacy_prepare_pair_exact: pair_bool(legacy_prepare_pair_exact),
        legacy_commit_pair_exact: pair_bool(legacy_commit_pair_exact),
        legacy_services_restored_exact: pair_bool(legacy_services_restored_exact),
        legacy_consumer_identity_exact: pair_bool(legacy_consumer_identity_exact),
        legacy_restart_policy_exact: pair_bool(legacy_restart_policy_exact),
        decommission_tombstone_durable: pair_bool(decommission_tombstone_durable),
        arbiter_retirement_order_exact: pair_bool(arbiter_retirement_order_exact),
        recommission_intent_pair_exact: pair_bool(recommission_intent_pair_exact),
        phase1_surfaces_restored_exact: pair_bool(phase1_surfaces_restored_exact),
        phase1_slurm_receipt_exact: pair_bool(phase1_slurm_receipt_exact),
        legacy_owner_receipt_exact: pair_bool(legacy_owner_receipt_exact),
        arbiter_surfaces_absent_exact: pair_bool(arbiter_surfaces_absent_exact),
    }
}

fn pair_decommission_state_is_known(state: i64) -> bool {
    state == 1 || (state >= 11 && state <= 19)
}

fn pair_decommission_custody_is_exact(custody: i64) -> bool {
    custody >= 1 && custody <= 4
}

fn pair_decommission_zero_reason(
    slurm: SparkPairSlurmFacts,
    k8s: SparkPairK8sFacts,
    decommission: SparkPairDecommissionFacts,
) -> i64 {
    if !slurm.active_jobs_zero { return 115 }
    if !decommission.active_steps_zero { return 147 }
    if !slurm.allocations_zero { return 116 }
    if !k8s.reservation_count_zero { return 119 }
    if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero { return 121 }
    if !k8s.unexpected_k8s_gpu_consumers_zero { return 127 }
    0
}

fn pair_decommission_snapshot_reason(decommission: SparkPairDecommissionFacts) -> i64 {
    if !decommission.restore_snapshot_pair_exact { return 148 }
    if !decommission.restore_snapshot_replay_verified { return 149 }
    0
}

fn pair_decommission_withdrawn_reason(
    slurm: SparkPairSlurmFacts,
    decommission: SparkPairDecommissionFacts,
) -> i64 {
    if !slurm.both_slurmd_absent { return 117 }
    if !decommission.both_device_plugins_absent { return 150 }
    if !decommission.k8s_gpu_capacity_zero { return 151 }
    0
}

fn pair_decommission_current_phase1_reason(
    authority: SparkPairAuthorityFacts,
    slurm: SparkPairSlurmFacts,
    k8s: SparkPairK8sFacts,
    host: SparkPairHostFacts,
) -> i64 {
    if !authority.nodeset_generation_matches { return 110 }
    if !slurm.slurmd_gpu_request_exact { return 111 }
    if !authority.device_plugin_exclusive { return 112 }
    if !authority.admission_fail_closed { return 125 }
    if !authority.pair_taint_exact { return 126 }
    if !slurm.slurm_controller_ready { return 113 }
    if !slurm.both_slurmd_gpu_bound { return 117 }
    if !k8s.both_gpu_capacity_one { return 118 }
    if !slurm.resume_verified { return 123 }
    let host_reason = pair_host_handoff_reason(host)
    if host_reason != 0 { return host_reason }
    0
}

pub fn decide_spark_pair_decommission_plan(
    action: i64,
    current_state: i64,
    epoch: i64,
    observed_epoch: i64,
    observed_custody: i64,
    authority: SparkPairAuthorityFacts,
    slurm: SparkPairSlurmFacts,
    k8s: SparkPairK8sFacts,
    host: SparkPairHostFacts,
    decommission: SparkPairDecommissionFacts,
) -> SparkPairDecision {
    if !authority.canonical || !slurm.canonical || !k8s.canonical ||
        !host.canonical || !decommission.canonical {
        return pair_refuse(current_state, 104)
    }
    if k8s.reservations_two && k8s.reservation_count_zero {
        return pair_refuse(current_state, 104)
    }
    if !pair_decommission_state_is_known(current_state) {
        return pair_refuse(current_state, 217)
    }
    if !authority.policy_present { return pair_refuse(current_state, 101) }
    if authority.policy_error { return pair_refuse(current_state, 102) }
    if authority.operation_timed_out { return pair_refuse(current_state, 103) }
    if !authority.pair_identity_exact { return pair_refuse(current_state, 109) }
    if epoch <= 0 { return pair_refuse(current_state, 107) }

    // Recovery grants no owner and remains admissible after Lease, epoch, or
    // custody drift. It cannot be used from a stable owner state.
    if action == 47 {
        if (current_state >= 11 && current_state <= 14) ||
            (current_state >= 16 && current_state <= 18) {
            return pair_allow(current_state, 19)
        }
        return pair_refuse(current_state, 217)
    }

    if !pair_decommission_custody_is_exact(observed_custody) {
        return pair_refuse(current_state, 145)
    }

    // Status is observational. Recovery state deliberately does not infer an
    // owner from a missing or stale scheduler control surface.
    if action == 33 {
        if current_state == 19 { return pair_allow(current_state, current_state) }
        if current_state == 1 && observed_custody != 2 {
            return pair_refuse(current_state, 146)
        }
        if current_state == 11 && observed_custody != 1 && observed_custody != 2 {
            return pair_refuse(current_state, 146)
        }
        if (current_state == 12 || current_state == 13 || current_state == 17 ||
            current_state == 18) && observed_custody != 1 {
            return pair_refuse(current_state, 146)
        }
        if (current_state == 14 || current_state == 15) &&
            observed_custody != 4 {
            return pair_refuse(current_state, 146)
        }
        if current_state == 16 && observed_custody != 1 && observed_custody != 4 {
            return pair_refuse(current_state, 146)
        }
        return pair_allow(current_state, current_state)
    }

    // Terminal confirmation is observational and may run after the active Lease
    // has been retired. Absence alone never suffices: the exact ordered removal
    // and its pair-wide tombstone must already be durable.
    if action == 49 {
        if current_state != 14 { return pair_refuse(current_state, 217) }
        if observed_custody != 4 { return pair_refuse(current_state, 146) }
        if observed_epoch != epoch { return pair_refuse(current_state, 107) }
        let snapshot_reason = pair_decommission_snapshot_reason(decommission)
        if snapshot_reason != 0 { return pair_refuse(current_state, snapshot_reason) }
        if !decommission.legacy_commit_pair_exact { return pair_refuse(current_state, 153) }
        if !decommission.legacy_owner_receipt_exact { return pair_refuse(current_state, 161) }
        if !decommission.legacy_services_restored_exact ||
            !decommission.legacy_consumer_identity_exact {
            return pair_refuse(current_state, 154)
        }
        if !decommission.legacy_restart_policy_exact { return pair_refuse(current_state, 155) }
        if !decommission.decommission_tombstone_durable { return pair_refuse(current_state, 156) }
        if !decommission.arbiter_retirement_order_exact { return pair_refuse(current_state, 157) }
        if !decommission.arbiter_surfaces_absent_exact { return pair_refuse(current_state, 162) }
        return pair_allow(current_state, 15)
    }

    // Recommission is the only post-tombstone bootstrap. It binds a new epoch
    // to the durable legacy-owner receipt and does not assume a surviving Lease.
    if action == 42 {
        if current_state != 15 { return pair_refuse(current_state, 217) }
        if observed_custody != 4 { return pair_refuse(current_state, 146) }
        if epoch <= observed_epoch { return pair_refuse(current_state, 107) }
        let snapshot_reason = pair_decommission_snapshot_reason(decommission)
        if snapshot_reason != 0 { return pair_refuse(current_state, snapshot_reason) }
        if !decommission.decommission_tombstone_durable { return pair_refuse(current_state, 156) }
        if !decommission.legacy_services_restored_exact ||
            !decommission.legacy_consumer_identity_exact {
            return pair_refuse(current_state, 154)
        }
        if !decommission.legacy_restart_policy_exact { return pair_refuse(current_state, 155) }
        if !decommission.legacy_owner_receipt_exact { return pair_refuse(current_state, 161) }
        if !decommission.legacy_commit_pair_exact { return pair_refuse(current_state, 153) }
        if !decommission.arbiter_retirement_order_exact { return pair_refuse(current_state, 157) }
        if !decommission.arbiter_surfaces_absent_exact { return pair_refuse(current_state, 162) }
        if !decommission.recommission_intent_pair_exact { return pair_refuse(current_state, 158) }
        return pair_allow(current_state, 16)
    }

    if observed_epoch != epoch { return pair_refuse(current_state, 107) }
    if !authority.holder_matches { return pair_refuse(current_state, 106) }
    if !authority.lease_live { return pair_refuse(current_state, 108) }

    if action == 34 {
        if current_state != 1 { return pair_refuse(current_state, 217) }
        if observed_custody != 2 { return pair_refuse(current_state, 146) }
        let snapshot_reason = pair_decommission_snapshot_reason(decommission)
        if snapshot_reason != 0 { return pair_refuse(current_state, snapshot_reason) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let phase1_reason = pair_decommission_current_phase1_reason(authority, slurm, k8s, host)
        if phase1_reason != 0 { return pair_refuse(current_state, phase1_reason) }
        return pair_allow(current_state, 11)
    }

    if action == 35 {
        if current_state != 11 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        if !slurm.both_slurm_drained { return pair_refuse(current_state, 114) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 12)
    }

    if action == 36 {
        if current_state != 12 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        if !slurm.both_slurm_drained { return pair_refuse(current_state, 114) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 12)
    }

    if action == 37 {
        if current_state != 12 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        if !slurm.both_slurm_drained { return pair_refuse(current_state, 114) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let withdrawn_reason = pair_decommission_withdrawn_reason(slurm, decommission)
        if withdrawn_reason != 0 { return pair_refuse(current_state, withdrawn_reason) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 13)
    }

    if action == 38 {
        if current_state != 13 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        let snapshot_reason = pair_decommission_snapshot_reason(decommission)
        if snapshot_reason != 0 { return pair_refuse(current_state, snapshot_reason) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let withdrawn_reason = pair_decommission_withdrawn_reason(slurm, decommission)
        if withdrawn_reason != 0 { return pair_refuse(current_state, withdrawn_reason) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 13)
    }

    if action == 39 {
        if current_state != 13 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        if !decommission.legacy_prepare_pair_exact { return pair_refuse(current_state, 152) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let withdrawn_reason = pair_decommission_withdrawn_reason(slurm, decommission)
        if withdrawn_reason != 0 { return pair_refuse(current_state, withdrawn_reason) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 14)
    }

    if action == 40 {
        if current_state != 14 { return pair_refuse(current_state, 217) }
        if observed_custody != 4 { return pair_refuse(current_state, 146) }
        if !decommission.legacy_commit_pair_exact { return pair_refuse(current_state, 153) }
        if !decommission.legacy_owner_receipt_exact { return pair_refuse(current_state, 161) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let withdrawn_reason = pair_decommission_withdrawn_reason(slurm, decommission)
        if withdrawn_reason != 0 { return pair_refuse(current_state, withdrawn_reason) }
        return pair_allow(current_state, 14)
    }

    if action == 41 {
        if current_state != 14 { return pair_refuse(current_state, 217) }
        if observed_custody != 4 { return pair_refuse(current_state, 146) }
        if !decommission.legacy_commit_pair_exact { return pair_refuse(current_state, 153) }
        if !decommission.legacy_owner_receipt_exact { return pair_refuse(current_state, 161) }
        if !decommission.legacy_services_restored_exact ||
            !decommission.legacy_consumer_identity_exact {
            return pair_refuse(current_state, 154)
        }
        if !decommission.legacy_restart_policy_exact { return pair_refuse(current_state, 155) }
        if !decommission.decommission_tombstone_durable { return pair_refuse(current_state, 156) }
        if !decommission.arbiter_retirement_order_exact { return pair_refuse(current_state, 157) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let withdrawn_reason = pair_decommission_withdrawn_reason(slurm, decommission)
        if withdrawn_reason != 0 { return pair_refuse(current_state, withdrawn_reason) }
        return pair_allow(current_state, 14)
    }

    if action == 43 {
        if current_state != 16 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        if !decommission.recommission_intent_pair_exact { return pair_refuse(current_state, 158) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 17)
    }

    if action == 44 {
        if current_state != 17 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        let snapshot_reason = pair_decommission_snapshot_reason(decommission)
        if snapshot_reason != 0 { return pair_refuse(current_state, snapshot_reason) }
        if !decommission.recommission_intent_pair_exact { return pair_refuse(current_state, 158) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 17)
    }

    if action == 45 {
        if current_state != 17 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        if !decommission.recommission_intent_pair_exact { return pair_refuse(current_state, 158) }
        if !decommission.phase1_surfaces_restored_exact { return pair_refuse(current_state, 159) }
        if !authority.nodeset_generation_matches { return pair_refuse(current_state, 110) }
        if !authority.device_plugin_exclusive { return pair_refuse(current_state, 112) }
        if !authority.admission_fail_closed { return pair_refuse(current_state, 125) }
        if !authority.pair_taint_exact { return pair_refuse(current_state, 126) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !k8s.both_gpu_capacity_one { return pair_refuse(current_state, 118) }
        return pair_allow(current_state, 18)
    }

    if action == 46 {
        if current_state != 18 { return pair_refuse(current_state, 217) }
        if observed_custody != 2 { return pair_refuse(current_state, 146) }
        if !decommission.recommission_intent_pair_exact { return pair_refuse(current_state, 158) }
        if !decommission.phase1_slurm_receipt_exact { return pair_refuse(current_state, 160) }
        let phase1_reason = pair_decommission_current_phase1_reason(authority, slurm, k8s, host)
        if phase1_reason != 0 { return pair_refuse(current_state, phase1_reason) }
        return pair_allow(current_state, 1)
    }

    if action == 48 {
        if current_state != 19 { return pair_refuse(current_state, 217) }
        if observed_custody != 1 { return pair_refuse(current_state, 146) }
        let zero_reason = pair_decommission_zero_reason(slurm, k8s, decommission)
        if zero_reason != 0 { return pair_refuse(current_state, zero_reason) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 12)
    }

    pair_refuse(current_state, 124)
}
