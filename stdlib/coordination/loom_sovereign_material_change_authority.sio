//! LOOM action 9044: material change-descriptor semantic authority.

pub struct LoomSovereignMaterialChangeObservation {
    pub mode: i64,
    pub stage: i64,
    pub parent_9043_frozen: i64,
    pub parent_hash_bound: i64,
    pub provider_root_readonly: i64,
    pub staging_outside_root: i64,
    pub tool_call_bound: i64,
    pub patch_bound: i64,
    pub path_set_bound: i64,
    pub preimage_bound: i64,
    pub head_bound: i64,
    pub index_bound: i64,
    pub peer_bound: i64,
    pub grant_resident_memory: i64,
    pub grant_non_bearer: i64,
    pub grant_single_use: i64,
    pub grant_not_exported: i64,
    pub stage_prepared: i64,
    pub original_unchanged: i64,
    pub staged_image_exact: i64,
    pub kernel_materialized: i64,
    pub postimage_exact: i64,
    pub commit_tree_exact: i64,
    pub commit_parent_exact: i64,
    pub commit_message_bound: i64,
    pub commit_receipt_issued: i64,
    pub ci_commit_exact: i64,
    pub ci_receipt_exact: i64,
    pub ci_semantics_exact: i64,
    pub ci_consumes_not_reinterprets: i64,
    pub mutation_tools_attached: i64,
    pub commit_attached: i64,
    pub ci_attached: i64,
    pub claim_ready_requested: i64,
    pub descriptor0: i64,
    pub descriptor1: i64,
    pub descriptor2: i64,
    pub descriptor3: i64,
    pub sabotage_count: i64,
    pub sabotage_required: i64,
}

fn material_fact(word: i64, shift: i64) -> i64 {
    (word >> shift) & 1
}

pub fn loom_sovereign_material_change_observation_from_words(
    mode: i64,
    stage: i64,
    word: i64,
    descriptor0: i64,
    descriptor1: i64,
    descriptor2: i64,
    descriptor3: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> LoomSovereignMaterialChangeObservation {
    LoomSovereignMaterialChangeObservation {
        mode: mode,
        stage: stage,
        parent_9043_frozen: material_fact(word, 0),
        parent_hash_bound: material_fact(word, 1),
        provider_root_readonly: material_fact(word, 2),
        staging_outside_root: material_fact(word, 3),
        tool_call_bound: material_fact(word, 4),
        patch_bound: material_fact(word, 5),
        path_set_bound: material_fact(word, 6),
        preimage_bound: material_fact(word, 7),
        head_bound: material_fact(word, 8),
        index_bound: material_fact(word, 9),
        peer_bound: material_fact(word, 10),
        grant_resident_memory: material_fact(word, 11),
        grant_non_bearer: material_fact(word, 12),
        grant_single_use: material_fact(word, 13),
        grant_not_exported: material_fact(word, 14),
        stage_prepared: material_fact(word, 15),
        original_unchanged: material_fact(word, 16),
        staged_image_exact: material_fact(word, 17),
        kernel_materialized: material_fact(word, 18),
        postimage_exact: material_fact(word, 19),
        commit_tree_exact: material_fact(word, 20),
        commit_parent_exact: material_fact(word, 21),
        commit_message_bound: material_fact(word, 22),
        commit_receipt_issued: material_fact(word, 23),
        ci_commit_exact: material_fact(word, 24),
        ci_receipt_exact: material_fact(word, 25),
        ci_semantics_exact: material_fact(word, 26),
        ci_consumes_not_reinterprets: material_fact(word, 27),
        mutation_tools_attached: material_fact(word, 28),
        commit_attached: material_fact(word, 29),
        ci_attached: material_fact(word, 30),
        claim_ready_requested: material_fact(word, 31),
        descriptor0: descriptor0,
        descriptor1: descriptor1,
        descriptor2: descriptor2,
        descriptor3: descriptor3,
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
}

fn material_later_than_prepare(o: LoomSovereignMaterialChangeObservation) -> bool {
    o.original_unchanged == 1 || o.staged_image_exact == 1 ||
    o.kernel_materialized == 1 || o.postimage_exact == 1 ||
    material_later_than_consume(o)
}

fn material_later_than_consume(o: LoomSovereignMaterialChangeObservation) -> bool {
    o.commit_tree_exact == 1 || o.commit_parent_exact == 1 ||
    o.commit_message_bound == 1 || o.commit_receipt_issued == 1 ||
    material_later_than_commit(o)
}

fn material_later_than_commit(o: LoomSovereignMaterialChangeObservation) -> bool {
    o.ci_commit_exact == 1 || o.ci_receipt_exact == 1 ||
    o.ci_semantics_exact == 1 || o.ci_consumes_not_reinterprets == 1 ||
    material_later_than_ci(o)
}

fn material_later_than_ci(o: LoomSovereignMaterialChangeObservation) -> bool {
    o.mutation_tools_attached == 1 || o.commit_attached == 1 ||
    o.ci_attached == 1 || o.claim_ready_requested == 1
}

// 1 = MATERIAL_PREPARED, 2 = MATERIAL_CONSUMED, 3 = COMMIT_ADMIT,
// 4 = CI_ADMIT, 5 = CLAIM_READY.
pub fn judge_loom_sovereign_material_change(
    o: LoomSovereignMaterialChangeObservation,
) -> i64 {
    if o.stage != 4 || o.parent_9043_frozen != 1 ||
        o.parent_hash_bound != 1 { return 631 }
    if o.provider_root_readonly != 1 || o.staging_outside_root != 1 { return 632 }
    if o.tool_call_bound != 1 || o.patch_bound != 1 ||
        o.path_set_bound != 1 || o.preimage_bound != 1 ||
        o.head_bound != 1 || o.index_bound != 1 || o.peer_bound != 1 { return 633 }
    if o.grant_resident_memory != 1 || o.grant_non_bearer != 1 ||
        o.grant_single_use != 1 || o.grant_not_exported != 1 ||
        o.stage_prepared != 1 { return 634 }
    if o.descriptor0 == 0 && o.descriptor1 == 0 &&
        o.descriptor2 == 0 && o.descriptor3 == 0 { return 635 }
    if o.sabotage_required <= 0 ||
        o.sabotage_count < o.sabotage_required { return 636 }
    if o.mode == 1 {
        if material_later_than_prepare(o) { return 637 }
        return 1
    }
    if o.original_unchanged != 1 || o.staged_image_exact != 1 ||
        o.kernel_materialized != 1 || o.postimage_exact != 1 { return 638 }
    if o.mode == 2 {
        if material_later_than_consume(o) { return 637 }
        return 2
    }
    if o.commit_tree_exact != 1 || o.commit_parent_exact != 1 ||
        o.commit_message_bound != 1 || o.commit_receipt_issued != 1 { return 639 }
    if o.mode == 3 {
        if material_later_than_commit(o) { return 637 }
        return 3
    }
    if o.ci_commit_exact != 1 || o.ci_receipt_exact != 1 ||
        o.ci_semantics_exact != 1 || o.ci_consumes_not_reinterprets != 1 { return 640 }
    if o.mode == 4 {
        if material_later_than_ci(o) { return 637 }
        return 4
    }
    if o.mode == 5 && o.mutation_tools_attached == 1 &&
        o.commit_attached == 1 && o.ci_attached == 1 &&
        o.claim_ready_requested == 1 { return 5 }
    641
}

pub fn judge_loom_sovereign_material_change_words(
    mode: i64,
    stage: i64,
    word: i64,
    descriptor0: i64,
    descriptor1: i64,
    descriptor2: i64,
    descriptor3: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> i64 {
    judge_loom_sovereign_material_change(
        loom_sovereign_material_change_observation_from_words(
            mode, stage, word, descriptor0, descriptor1, descriptor2,
            descriptor3, sabotage_count, sabotage_required,
        ),
    )
}

pub fn loom_sovereign_material_change_selftest() -> i64 with Mut {
    var failed: i64 = 0
    if judge_loom_sovereign_material_change_words(
        1, 4, 65535, 1, 2, 3, 4, 9, 9,
    ) != 1 { failed = failed + 1 }
    if judge_loom_sovereign_material_change_words(
        2, 4, 1048575, 1, 2, 3, 4, 9, 9,
    ) != 2 { failed = failed + 1 }
    if judge_loom_sovereign_material_change_words(
        3, 4, 16777215, 1, 2, 3, 4, 9, 9,
    ) != 3 { failed = failed + 1 }
    if judge_loom_sovereign_material_change_words(
        4, 4, 268435455, 1, 2, 3, 4, 9, 9,
    ) != 4 { failed = failed + 1 }
    if judge_loom_sovereign_material_change_words(
        5, 4, 4294967295, 1, 2, 3, 4, 9, 9,
    ) != 5 { failed = failed + 1 }
    if judge_loom_sovereign_material_change_words(
        1, 4, 65531, 1, 2, 3, 4, 9, 9,
    ) != 632 { failed = failed + 1 }
    if judge_loom_sovereign_material_change_words(
        1, 4, 65535, 0, 0, 0, 0, 9, 9,
    ) != 635 { failed = failed + 1 }
    if judge_loom_sovereign_material_change_words(
        1, 4, 65535, 1, 2, 3, 4, 8, 9,
    ) != 636 { failed = failed + 1 }
    failed
}
