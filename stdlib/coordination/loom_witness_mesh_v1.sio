//! Linear 3-of-4 quorum algebra for Loom Witness Mesh v1 checkpoints.
//!
//! OCaml verifies Ed25519 signatures, canonical receipts, and transmitted raw
//! journal segments. Frame 9014 checks four-member separation, a 3-of-4
//! quorum, common checkpoint coordinates, and monotonic advance. Any two
//! 3-subsets of four members intersect in at least two members, so at most one
//! dishonest member cannot occupy the entire intersection.

pub effect LoomWitnessMeshV1HostTrust {}

struct WitnessMeshV1Digest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

linear struct VerifiedWitnessMeshV1Share {
    member_token: i64,
    domain_token: i64,
    anchor_sequence: i64,
    event_count: i64,
    journal_head: WitnessMeshV1Digest256,
}

linear struct VerifiedWitnessMeshV1Checkpoint {
    domain_token: i64,
    anchor_sequence: i64,
    event_count: i64,
    journal_head: WitnessMeshV1Digest256,
}

linear struct HostWitnessMeshV1Receipt {
    domain_token: i64,
    anchor_sequence: i64,
    event_count: i64,
    journal_head: WitnessMeshV1Digest256,
}

pub fn admit_witness_mesh_v1_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> WitnessMeshV1Digest256 {
    WitnessMeshV1Digest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
}

fn witness_mesh_v1_digest_is_canonical(digest: WitnessMeshV1Digest256) -> bool {
    digest.limb0 >= 0 && digest.limb0 <= 4294967295 &&
    digest.limb1 >= 0 && digest.limb1 <= 4294967295 &&
    digest.limb2 >= 0 && digest.limb2 <= 4294967295 &&
    digest.limb3 >= 0 && digest.limb3 <= 4294967295 &&
    digest.limb4 >= 0 && digest.limb4 <= 4294967295 &&
    digest.limb5 >= 0 && digest.limb5 <= 4294967295 &&
    digest.limb6 >= 0 && digest.limb6 <= 4294967295 &&
    digest.limb7 >= 0 && digest.limb7 <= 4294967295
}

fn witness_mesh_v1_digest_is_zero(digest: WitnessMeshV1Digest256) -> bool {
    digest.limb0 == 0 && digest.limb1 == 0 && digest.limb2 == 0 &&
    digest.limb3 == 0 && digest.limb4 == 0 && digest.limb5 == 0 &&
    digest.limb6 == 0 && digest.limb7 == 0
}

fn witness_mesh_v1_digest_equal(
    left: WitnessMeshV1Digest256,
    right: WitnessMeshV1Digest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn witness_mesh_v1_members_are_separated(
    member1: i64,
    member2: i64,
    member3: i64,
    member4: i64,
) -> bool {
    member1 > 0 && member2 > 0 && member3 > 0 && member4 > 0 &&
    member1 != member2 && member1 != member3 && member1 != member4 &&
    member2 != member3 && member2 != member4 && member3 != member4
}

fn witness_mesh_v1_quorum_is_satisfied(
    required_quorum: i64,
    signature1: i64,
    signature2: i64,
    signature3: i64,
    signature4: i64,
) -> bool {
    let flags_are_canonical =
        (signature1 == 0 || signature1 == 1) &&
        (signature2 == 0 || signature2 == 1) &&
        (signature3 == 0 || signature3 == 1) &&
        (signature4 == 0 || signature4 == 1)
    required_quorum == 3 && flags_are_canonical &&
    signature1 + signature2 + signature3 + signature4 >= required_quorum
}

fn witness_mesh_v1_membership_slot_accepts(
    signature_verified: i64,
    member_token: i64,
    receipt_member_token: i64,
    expected_membership: WitnessMeshV1Digest256,
    receipt_membership: WitnessMeshV1Digest256,
) -> bool {
    if signature_verified == 1 {
        member_token == receipt_member_token &&
        witness_mesh_v1_digest_equal(expected_membership, receipt_membership)
    } else {
        receipt_member_token == 0 &&
        witness_mesh_v1_digest_is_zero(receipt_membership)
    }
}

fn witness_mesh_v1_receipts_match_membership(
    signature1: i64,
    signature2: i64,
    signature3: i64,
    signature4: i64,
    member1: i64,
    member2: i64,
    member3: i64,
    member4: i64,
    receipt_member1: i64,
    receipt_member2: i64,
    receipt_member3: i64,
    receipt_member4: i64,
    expected_membership: WitnessMeshV1Digest256,
    receipt_membership1: WitnessMeshV1Digest256,
    receipt_membership2: WitnessMeshV1Digest256,
    receipt_membership3: WitnessMeshV1Digest256,
    receipt_membership4: WitnessMeshV1Digest256,
) -> bool {
    witness_mesh_v1_digest_is_canonical(expected_membership) &&
    !witness_mesh_v1_digest_is_zero(expected_membership) &&
    witness_mesh_v1_membership_slot_accepts(
        signature1, member1, receipt_member1,
        expected_membership, receipt_membership1,
    ) &&
    witness_mesh_v1_membership_slot_accepts(
        signature2, member2, receipt_member2,
        expected_membership, receipt_membership2,
    ) &&
    witness_mesh_v1_membership_slot_accepts(
        signature3, member3, receipt_member3,
        expected_membership, receipt_membership3,
    ) &&
    witness_mesh_v1_membership_slot_accepts(
        signature4, member4, receipt_member4,
        expected_membership, receipt_membership4,
    )
}

fn witness_mesh_v1_checkpoint_slot_accepts(
    signature_verified: i64,
    expected_domain: i64,
    receipt_domain: i64,
    expected_anchor_sequence: i64,
    receipt_anchor_sequence: i64,
    expected_event_count: i64,
    receipt_event_count: i64,
    expected_head: WitnessMeshV1Digest256,
    receipt_head: WitnessMeshV1Digest256,
) -> bool {
    if signature_verified == 1 {
        expected_domain == receipt_domain &&
        expected_anchor_sequence == receipt_anchor_sequence &&
        expected_event_count == receipt_event_count &&
        witness_mesh_v1_digest_equal(expected_head, receipt_head)
    } else {
        receipt_domain == 0 && receipt_anchor_sequence == 0 &&
        receipt_event_count == 0 && witness_mesh_v1_digest_is_zero(receipt_head)
    }
}

fn witness_mesh_v1_checkpoint_agrees(
    signature1: i64,
    signature2: i64,
    signature3: i64,
    signature4: i64,
    expected_domain: i64,
    receipt_domain1: i64,
    receipt_domain2: i64,
    receipt_domain3: i64,
    receipt_domain4: i64,
    expected_anchor_sequence: i64,
    receipt_anchor_sequence1: i64,
    receipt_anchor_sequence2: i64,
    receipt_anchor_sequence3: i64,
    receipt_anchor_sequence4: i64,
    expected_event_count: i64,
    receipt_event_count1: i64,
    receipt_event_count2: i64,
    receipt_event_count3: i64,
    receipt_event_count4: i64,
    expected_head: WitnessMeshV1Digest256,
    receipt_head1: WitnessMeshV1Digest256,
    receipt_head2: WitnessMeshV1Digest256,
    receipt_head3: WitnessMeshV1Digest256,
    receipt_head4: WitnessMeshV1Digest256,
) -> bool {
    expected_domain > 0 &&
    witness_mesh_v1_digest_is_canonical(expected_head) &&
    !witness_mesh_v1_digest_is_zero(expected_head) &&
    witness_mesh_v1_checkpoint_slot_accepts(
        signature1, expected_domain, receipt_domain1,
        expected_anchor_sequence, receipt_anchor_sequence1,
        expected_event_count, receipt_event_count1, expected_head, receipt_head1,
    ) &&
    witness_mesh_v1_checkpoint_slot_accepts(
        signature2, expected_domain, receipt_domain2,
        expected_anchor_sequence, receipt_anchor_sequence2,
        expected_event_count, receipt_event_count2, expected_head, receipt_head2,
    ) &&
    witness_mesh_v1_checkpoint_slot_accepts(
        signature3, expected_domain, receipt_domain3,
        expected_anchor_sequence, receipt_anchor_sequence3,
        expected_event_count, receipt_event_count3, expected_head, receipt_head3,
    ) &&
    witness_mesh_v1_checkpoint_slot_accepts(
        signature4, expected_domain, receipt_domain4,
        expected_anchor_sequence, receipt_anchor_sequence4,
        expected_event_count, receipt_event_count4, expected_head, receipt_head4,
    )
}

fn witness_mesh_v1_checkpoint_advances(
    previous_anchor_sequence: i64,
    anchor_sequence: i64,
    previous_event_count: i64,
    event_count: i64,
) -> bool {
    previous_anchor_sequence >= 0 && previous_event_count >= 0 &&
    anchor_sequence > previous_anchor_sequence &&
    event_count > previous_event_count
}

pub fn host_witness_mesh_v1_frame_accepts(
    required_quorum: i64,
    signature1: i64,
    signature2: i64,
    signature3: i64,
    signature4: i64,
    member1: i64,
    member2: i64,
    member3: i64,
    member4: i64,
    receipt_member1: i64,
    receipt_member2: i64,
    receipt_member3: i64,
    receipt_member4: i64,
    expected_domain: i64,
    receipt_domain1: i64,
    receipt_domain2: i64,
    receipt_domain3: i64,
    receipt_domain4: i64,
    previous_anchor_sequence: i64,
    anchor_sequence: i64,
    receipt_anchor_sequence1: i64,
    receipt_anchor_sequence2: i64,
    receipt_anchor_sequence3: i64,
    receipt_anchor_sequence4: i64,
    previous_event_count: i64,
    event_count: i64,
    receipt_event_count1: i64,
    receipt_event_count2: i64,
    receipt_event_count3: i64,
    receipt_event_count4: i64,
    expected_membership: WitnessMeshV1Digest256,
    receipt_membership1: WitnessMeshV1Digest256,
    receipt_membership2: WitnessMeshV1Digest256,
    receipt_membership3: WitnessMeshV1Digest256,
    receipt_membership4: WitnessMeshV1Digest256,
    expected_head: WitnessMeshV1Digest256,
    receipt_head1: WitnessMeshV1Digest256,
    receipt_head2: WitnessMeshV1Digest256,
    receipt_head3: WitnessMeshV1Digest256,
    receipt_head4: WitnessMeshV1Digest256,
) -> bool with LoomWitnessMeshV1HostTrust {
    witness_mesh_v1_members_are_separated(member1, member2, member3, member4) &&
    witness_mesh_v1_quorum_is_satisfied(
        required_quorum, signature1, signature2, signature3, signature4,
    ) &&
    witness_mesh_v1_receipts_match_membership(
        signature1, signature2, signature3, signature4,
        member1, member2, member3, member4,
        receipt_member1, receipt_member2, receipt_member3, receipt_member4,
        expected_membership,
        receipt_membership1, receipt_membership2,
        receipt_membership3, receipt_membership4,
    ) &&
    witness_mesh_v1_checkpoint_agrees(
        signature1, signature2, signature3, signature4,
        expected_domain,
        receipt_domain1, receipt_domain2, receipt_domain3, receipt_domain4,
        anchor_sequence,
        receipt_anchor_sequence1, receipt_anchor_sequence2,
        receipt_anchor_sequence3, receipt_anchor_sequence4,
        event_count,
        receipt_event_count1, receipt_event_count2,
        receipt_event_count3, receipt_event_count4,
        expected_head,
        receipt_head1, receipt_head2, receipt_head3, receipt_head4,
    ) &&
    witness_mesh_v1_checkpoint_advances(
        previous_anchor_sequence, anchor_sequence,
        previous_event_count, event_count,
    )
}

pub fn admit_verified_witness_mesh_v1_share(
    member_token: i64,
    domain_token: i64,
    anchor_sequence: i64,
    event_count: i64,
    journal_head: WitnessMeshV1Digest256,
) -> VerifiedWitnessMeshV1Share with LoomWitnessMeshV1HostTrust, Panic {
    if member_token <= 0 || domain_token <= 0 || anchor_sequence <= 0 ||
        event_count <= 0 || witness_mesh_v1_digest_is_zero(journal_head) {
        panic("verified v1 witness share is not canonical")
    }
    VerifiedWitnessMeshV1Share {
        member_token: member_token,
        domain_token: domain_token,
        anchor_sequence: anchor_sequence,
        event_count: event_count,
        journal_head: journal_head,
    }
}

pub fn combine_verified_witness_mesh_v1_shares(
    first: VerifiedWitnessMeshV1Share,
    second: VerifiedWitnessMeshV1Share,
    third: VerifiedWitnessMeshV1Share,
) -> VerifiedWitnessMeshV1Checkpoint with LoomWitnessMeshV1HostTrust, Panic {
    let VerifiedWitnessMeshV1Share {
        member_token, domain_token, anchor_sequence, event_count, journal_head,
    } = first
    let first_member = member_token
    let first_domain = domain_token
    let first_sequence = anchor_sequence
    let first_count = event_count
    let first_head = journal_head
    let VerifiedWitnessMeshV1Share {
        member_token, domain_token, anchor_sequence, event_count, journal_head,
    } = second
    let second_member = member_token
    if first_member == second_member || first_domain != domain_token ||
        first_sequence != anchor_sequence || first_count != event_count ||
        !witness_mesh_v1_digest_equal(first_head, journal_head) {
        panic("first two v1 witness shares do not agree")
    }
    let VerifiedWitnessMeshV1Share {
        member_token, domain_token, anchor_sequence, event_count, journal_head,
    } = third
    if member_token == first_member || member_token == second_member ||
        domain_token != first_domain || anchor_sequence != first_sequence ||
        event_count != first_count ||
        !witness_mesh_v1_digest_equal(journal_head, first_head) {
        panic("three v1 witness shares do not form a checkpoint quorum")
    }
    VerifiedWitnessMeshV1Checkpoint {
        domain_token: first_domain,
        anchor_sequence: first_sequence,
        event_count: first_count,
        journal_head: first_head,
    }
}

pub fn consume_verified_witness_mesh_v1_checkpoint(
    checkpoint: VerifiedWitnessMeshV1Checkpoint,
) -> HostWitnessMeshV1Receipt {
    let VerifiedWitnessMeshV1Checkpoint {
        domain_token, anchor_sequence, event_count, journal_head,
    } = checkpoint
    HostWitnessMeshV1Receipt {
        domain_token: domain_token,
        anchor_sequence: anchor_sequence,
        event_count: event_count,
        journal_head: journal_head,
    }
}

pub fn close_host_witness_mesh_v1_receipt(
    receipt: HostWitnessMeshV1Receipt,
) -> i64 {
    let HostWitnessMeshV1Receipt {
        domain_token, anchor_sequence, event_count, journal_head: _,
    } = receipt
    domain_token + anchor_sequence + event_count
}
