        source_semantics_toolchain_result_hash: source_semantics_toolchain_result_hash,
    }
}

fn loom_kernel_peer_activation_flag(value: i64) -> bool {
    value == 0 || value == 1
}

fn loom_kernel_peer_activation_digest_nonzero(
    value: LoomKernelPeerActivationDigest256,
) -> bool {
    value.limb0 != 0 || value.limb1 != 0 || value.limb2 != 0 ||
        value.limb3 != 0 || value.limb4 != 0 || value.limb5 != 0 ||
        value.limb6 != 0 || value.limb7 != 0
}

fn loom_kernel_peer_activation_digest_equal(
    left: LoomKernelPeerActivationDigest256,
    right: LoomKernelPeerActivationDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
        left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
        left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
        left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn loom_kernel_peer_activation_parent_9025() -> LoomKernelPeerActivationDigest256 {
    admit_loom_kernel_peer_activation_digest256(
        4155355085, 477705803, 1978393739, 1721343682,
        3619170834, 3602441309, 2619130979, 2051844554,
    )
}

fn loom_kernel_peer_activation_parent_9030() -> LoomKernelPeerActivationDigest256 {
    admit_loom_kernel_peer_activation_digest256(
        2257049737, 3767494937, 229307341, 3202361153,
        3454258786, 4046895715, 3743394242, 3434139729,
    )
}

pub fn loom_kernel_peer_activation_capsule_authority_decide(
    stage: i64,
    action_9031_preregistered: i64,
    transition: LoomKernelPeerActivationTransition,
    parents: LoomKernelPeerActivationParents,
    kernel: LoomKernelPeerActivationKernel,
    principal: LoomKernelPeerActivationPrincipal,
    shape: LoomKernelPeerActivationShape,
    custody: LoomKernelPeerActivationCustody,
    terminal: LoomKernelPeerActivationTerminal,
    authority: LoomKernelPeerActivationAuthority,
    evidence: LoomKernelPeerActivationEvidence,
    bindings: LoomKernelPeerActivationBindings,
) -> i64 {
    if stage < 1 || stage > 7 ||
        !loom_kernel_peer_activation_flag(action_9031_preregistered) ||
        transition.operation < 1 || transition.operation > 4 ||
        transition.current_state < 0 || transition.current_state > 4 ||
        transition.next_state < 0 || transition.next_state > 4 ||
        transition.broker_epoch < 0 || transition.lease_generation < 0 ||
        transition.custody_generation < 0 || transition.capsule_generation < 0 ||
        transition.grant_generation < 0 || transition.request_sequence < 0 ||
        transition.deadline_tick < 0 || transition.budget_remaining < 0 ||
        !loom_kernel_peer_activation_flag(parents.manifests_bound) ||
        !loom_kernel_peer_activation_flag(parents.action_9025_allow) ||
        !loom_kernel_peer_activation_flag(parents.action_9025_same_uid_peer_isolation) ||
        !loom_kernel_peer_activation_flag(parents.action_9025_material_execution) ||
        !loom_kernel_peer_activation_flag(parents.action_9030_issue_allow) ||
        !loom_kernel_peer_activation_flag(parents.action_9030_consume_allow) ||
        !loom_kernel_peer_activation_flag(parents.action_9030_close_allow) ||
        !loom_kernel_peer_activation_flag(parents.action_9030_revoke_allow) ||
        !loom_kernel_peer_activation_flag(kernel.boot_id_bound) ||
        !loom_kernel_peer_activation_flag(kernel.bpf_object_bound) ||
        !loom_kernel_peer_activation_flag(kernel.bpf_programs_bound) ||
        !loom_kernel_peer_activation_flag(kernel.bpf_links_active) ||
        !loom_kernel_peer_activation_flag(kernel.bpf_maps_bound) ||
        !loom_kernel_peer_activation_flag(kernel.bpf_epoch_equal) ||
        !loom_kernel_peer_activation_flag(kernel.resident_sounio_bound) ||
        !loom_kernel_peer_activation_flag(kernel.guardian_executable_bound) ||
        kernel.mediation_hooks_attached < 0 || kernel.mediation_hooks_attached > 3 ||
        !loom_kernel_peer_activation_flag(principal.so_peercred_bound) ||
        !loom_kernel_peer_activation_flag(principal.pidfd_bound) ||
        !loom_kernel_peer_activation_flag(principal.start_tick_bound) ||
        !loom_kernel_peer_activation_flag(principal.namespaces_bound) ||
        !loom_kernel_peer_activation_flag(principal.cgroup_bound) ||
        !loom_kernel_peer_activation_flag(principal.harness_ancestry_bound) ||
        !loom_kernel_peer_activation_flag(principal.command_environment_worktree_bound) ||
        !loom_kernel_peer_activation_flag(principal.operation_equal) ||
        !loom_kernel_peer_activation_flag(shape.prewrite_validated) ||
        !loom_kernel_peer_activation_flag(shape.closed_domain) ||
        !loom_kernel_peer_activation_flag(shape.legal_transition) ||
        !loom_kernel_peer_activation_flag(shape.generations_monotonic) ||
        !loom_kernel_peer_activation_flag(shape.old_state_receipt_bound) ||
        !loom_kernel_peer_activation_flag(shape.proposed_receipt_bound) ||
        !loom_kernel_peer_activation_flag(shape.future_terminal_obligation_bound) ||
        !loom_kernel_peer_activation_flag(shape.no_mutation_on_deny) ||
        !loom_kernel_peer_activation_flag(custody.handle_lookup_only) ||
        !loom_kernel_peer_activation_flag(custody.authenticated_before_lookup) ||
        !loom_kernel_peer_activation_flag(custody.single_writer) ||
        !loom_kernel_peer_activation_flag(custody.atomic_compare_exchange) ||
        !loom_kernel_peer_activation_flag(custody.in_memory_only) ||
        !loom_kernel_peer_activation_flag(custody.capsule_non_authorizing) ||
        !loom_kernel_peer_activation_flag(custody.generation_fresh) ||
        !loom_kernel_peer_activation_flag(custody.replay_isolated) ||
        !loom_kernel_peer_activation_flag(terminal.policy_failure_closed) ||
        !loom_kernel_peer_activation_flag(terminal.boot_loss_poison) ||
        !loom_kernel_peer_activation_flag(terminal.bpf_loss_poison) ||
        !loom_kernel_peer_activation_flag(terminal.guardian_loss_poison) ||
        !loom_kernel_peer_activation_flag(terminal.timeout_poison) ||
        !loom_kernel_peer_activation_flag(terminal.effect_closure_bound) ||
        !loom_kernel_peer_activation_flag(terminal.action_9030_terminal_bound) ||
        !loom_kernel_peer_activation_flag(terminal.registry_absent) ||
        !loom_kernel_peer_activation_flag(terminal.kernel_extinct) ||
        !loom_kernel_peer_activation_flag(terminal.replay_refused) ||
        !loom_kernel_peer_activation_flag(terminal.silence_rejected) ||
        !loom_kernel_peer_activation_flag(authority.producer_sounio) ||
        !loom_kernel_peer_activation_flag(authority.expected_result_sounio) ||
        !loom_kernel_peer_activation_flag(authority.python_absent) ||
        !loom_kernel_peer_activation_flag(authority.rust_absent) ||
        !loom_kernel_peer_activation_flag(authority.review_unpromoted) ||
        !loom_kernel_peer_activation_flag(authority.parity_unpromoted) ||
        !loom_kernel_peer_activation_flag(authority.disposable_oracle_absent) ||
        !loom_kernel_peer_activation_flag(evidence.provenance_complete) ||
        !loom_kernel_peer_activation_flag(evidence.receipt_bound) ||
        evidence.sabotage_count < 0 || evidence.sabotage_count > 9 ||
        evidence.sabotage_required < 0 || evidence.sabotage_required > 9 {
        return 424
    }

    if stage < 3 || action_9031_preregistered != 1 || parents.manifests_bound != 1 || !loom_kernel_peer_activation_digest_equal(bindings.parent_9025_judgment_hash, loom_kernel_peer_activation_parent_9025()) || !loom_kernel_peer_activation_digest_equal(bindings.parent_9030_authority_hash, loom_kernel_peer_activation_parent_9030()) { return 405 }

    // Causal control: removing only this rule admits a capsule without the operation-specific Sounio 9025/9030 parent decisions.
    if parents.action_9025_allow != 1 || parents.action_9025_same_uid_peer_isolation != 1 || parents.action_9025_material_execution != 1 || (transition.operation == 1 && (parents.action_9030_issue_allow != 1 || parents.action_9030_consume_allow != 0 || parents.action_9030_close_allow != 0 || parents.action_9030_revoke_allow != 0)) || (transition.operation == 2 && (parents.action_9030_issue_allow != 1 || parents.action_9030_consume_allow != 1 || parents.action_9030_close_allow != 0 || parents.action_9030_revoke_allow != 0)) || (transition.operation == 3 && (parents.action_9030_issue_allow != 1 || parents.action_9030_consume_allow != 1 || parents.action_9030_close_allow != 1 || parents.action_9030_revoke_allow != 0)) || (transition.operation == 4 && (parents.action_9030_issue_allow != 1 || parents.action_9030_close_allow != 0 || parents.action_9030_revoke_allow != 1 || (transition.current_state == 1 && parents.action_9030_consume_allow != 0) || (transition.current_state == 2 && parents.action_9030_consume_allow != 1))) { return 502 }

    // Causal control: removing only this rule admits boot, BPF, resident, or guardian drift.
    if kernel.boot_id_bound != 1 || kernel.bpf_object_bound != 1 || kernel.bpf_programs_bound != 1 || kernel.bpf_links_active != 1 || kernel.bpf_maps_bound != 1 || kernel.bpf_epoch_equal != 1 || kernel.resident_sounio_bound != 1 || kernel.guardian_executable_bound != 1 || kernel.mediation_hooks_attached != 3 || !loom_kernel_peer_activation_digest_nonzero(bindings.kernel_anchor_hash) { return 503 }

    // Causal control: removing only this rule admits a substituted same-UID principal, command, worktree, or operation.
    if principal.so_peercred_bound != 1 || principal.pidfd_bound != 1 || principal.start_tick_bound != 1 || principal.namespaces_bound != 1 || principal.cgroup_bound != 1 || principal.harness_ancestry_bound != 1 || principal.command_environment_worktree_bound != 1 || principal.operation_equal != 1 || !loom_kernel_peer_activation_digest_nonzero(bindings.principal_anchor_hash) { return 504 }

    // Causal control: removing only this rule admits an illegal, post-write, or nonmonotonic state edge.
    if shape.prewrite_validated != 1 || shape.closed_domain != 1 || shape.legal_transition != 1 || shape.generations_monotonic != 1 || shape.old_state_receipt_bound != 1 || shape.proposed_receipt_bound != 1 || shape.future_terminal_obligation_bound != 1 || shape.no_mutation_on_deny != 1 || transition.broker_epoch <= 0 || transition.lease_generation <= 0 || transition.custody_generation <= 0 || transition.capsule_generation <= 0 || transition.grant_generation <= 0 || transition.request_sequence <= 0 || transition.deadline_tick <= 0 || transition.budget_remaining <= 0 || (transition.operation == 1 && (transition.current_state != 0 || transition.next_state != 1)) || (transition.operation == 2 && (transition.current_state != 1 || transition.next_state != 2)) || (transition.operation == 3 && (transition.current_state != 2 || transition.next_state != 3)) || (transition.operation == 4 && ((transition.current_state != 1 && transition.current_state != 2) || transition.next_state != 4)) || !loom_kernel_peer_activation_digest_nonzero(bindings.proposed_transition_hash) { return 505 }

    // Causal control: removing only this rule turns serialized bytes or a reusable generation into authority.
    if custody.handle_lookup_only != 1 || custody.authenticated_before_lookup != 1 || custody.single_writer != 1 || custody.atomic_compare_exchange != 1 || custody.in_memory_only != 1 || custody.capsule_non_authorizing != 1 || custody.generation_fresh != 1 || custody.replay_isolated != 1 || !loom_kernel_peer_activation_digest_nonzero(bindings.capsule_identity_hash) { return 506 }

    // Causal control: removing only this rule promotes silence or incomplete extinction into affirmative absence.
