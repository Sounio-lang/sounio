//! LOOM action 9031: Sounio semantic authority for one affine ActivationCapsule.
//!
//! Serialized capsule bytes are non-authorizing. Authority is the live join of
//! frozen actions 9025 and 9030, a kernel/BPF anchor, an authenticated
//! principal, single-writer custody, and an unconsumed generation.

struct LoomKernelPeerActivationDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomKernelPeerActivationTransition {
    operation: i64,
    current_state: i64,
    next_state: i64,
    broker_epoch: i64,
    lease_generation: i64,
    custody_generation: i64,
    capsule_generation: i64,
    grant_generation: i64,
    request_sequence: i64,
    deadline_tick: i64,
    budget_remaining: i64,
}

struct LoomKernelPeerActivationParents {
    manifests_bound: i64,
    action_9025_allow: i64,
    action_9025_same_uid_peer_isolation: i64,
    action_9025_material_execution: i64,
    action_9030_issue_allow: i64,
    action_9030_consume_allow: i64,
    action_9030_close_allow: i64,
    action_9030_revoke_allow: i64,
}

struct LoomKernelPeerActivationKernel {
    boot_id_bound: i64,
    bpf_object_bound: i64,
    bpf_programs_bound: i64,
    bpf_links_active: i64,
    bpf_maps_bound: i64,
    bpf_epoch_equal: i64,
    resident_sounio_bound: i64,
    guardian_executable_bound: i64,
    mediation_hooks_attached: i64,
}

struct LoomKernelPeerActivationPrincipal {
    so_peercred_bound: i64,
    pidfd_bound: i64,
    start_tick_bound: i64,
    namespaces_bound: i64,
    cgroup_bound: i64,
    harness_ancestry_bound: i64,
    command_environment_worktree_bound: i64,
    operation_equal: i64,
}

struct LoomKernelPeerActivationShape {
    prewrite_validated: i64,
    closed_domain: i64,
    legal_transition: i64,
    generations_monotonic: i64,
    old_state_receipt_bound: i64,
    proposed_receipt_bound: i64,
    future_terminal_obligation_bound: i64,
    no_mutation_on_deny: i64,
}

struct LoomKernelPeerActivationCustody {
    handle_lookup_only: i64,
    authenticated_before_lookup: i64,
    single_writer: i64,
    atomic_compare_exchange: i64,
    in_memory_only: i64,
    capsule_non_authorizing: i64,
    generation_fresh: i64,
    replay_isolated: i64,
}

struct LoomKernelPeerActivationTerminal {
    policy_failure_closed: i64,
    boot_loss_poison: i64,
    bpf_loss_poison: i64,
    guardian_loss_poison: i64,
    timeout_poison: i64,
    effect_closure_bound: i64,
    action_9030_terminal_bound: i64,
    registry_absent: i64,
    kernel_extinct: i64,
    replay_refused: i64,
    silence_rejected: i64,
}

struct LoomKernelPeerActivationAuthority {
    producer_sounio: i64,
    expected_result_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    review_unpromoted: i64,
    parity_unpromoted: i64,
    disposable_oracle_absent: i64,
}

struct LoomKernelPeerActivationEvidence {
    provenance_complete: i64,
    receipt_bound: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

struct LoomKernelPeerActivationBindings {
    parent_9025_judgment_hash: LoomKernelPeerActivationDigest256,
    parent_9030_authority_hash: LoomKernelPeerActivationDigest256,
    kernel_anchor_hash: LoomKernelPeerActivationDigest256,
    principal_anchor_hash: LoomKernelPeerActivationDigest256,
    capsule_identity_hash: LoomKernelPeerActivationDigest256,
    proposed_transition_hash: LoomKernelPeerActivationDigest256,
    source_semantics_toolchain_result_hash: LoomKernelPeerActivationDigest256,
}

