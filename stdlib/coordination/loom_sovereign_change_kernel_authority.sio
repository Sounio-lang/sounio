//! LOOM action 9043: sovereign change-kernel semantic authority.

pub struct LoomSovereignChangeObservation {
    pub mode: i64,
    pub stage: i64,
    pub preregistered: i64,
    pub parent_9042_frozen: i64,
    pub parent_9042_production: i64,
    pub parent_hash_bound: i64,
    pub producer_sounio: i64,
    pub expected_result_sounio: i64,
    pub python_absent: i64,
    pub rust_absent: i64,
    pub change_intent_schema_exact: i64,
    pub operation_supported: i64,
    pub raw_event_hash_bound: i64,
    pub patch_hash_bound: i64,
    pub patch_bytes_nonempty: i64,
    pub worktree_identity_bound: i64,
    pub pre_head_bound: i64,
    pub pre_index_bound: i64,
    pub pre_worktree_bound: i64,
    pub file_set_canonical: i64,
    pub file_set_nonempty: i64,
    pub file_set_hash_bound: i64,
    pub so_peercred_bound: i64,
    pub pidfd_bound: i64,
    pub start_tick_bound: i64,
    pub harness_ancestry_bound: i64,
    pub executable_bound: i64,
    pub operation_bound: i64,
    pub grant_resident_memory: i64,
    pub grant_non_bearer: i64,
    pub grant_single_use: i64,
    pub grant_atomic_consume: i64,
    pub grant_not_exported: i64,
    pub grant_issued: i64,
    pub post_image_computed: i64,
    pub post_image_hash_bound: i64,
    pub post_worktree_matches: i64,
    pub no_ungranted_path_changed: i64,
    pub change_applied_exactly_once: i64,
    pub commit_tree_bound: i64,
    pub commit_parent_bound: i64,
    pub commit_message_bound: i64,
    pub commit_index_matches: i64,
    pub commit_receipt_issued: i64,
    pub receipt_source_bound: i64,
    pub receipt_semantics_bound: i64,
    pub receipt_toolchain_bound: i64,
    pub receipt_hardware_bound: i64,
    pub receipt_command_bound: i64,
    pub receipt_result_bound: i64,
    pub receipt_change_bound: i64,
    pub receipt_commit_bound: i64,
    pub receipt_authority_bound: i64,
    pub ci_commit_matches: i64,
    pub ci_tree_matches: i64,
    pub ci_receipt_hash_matches: i64,
    pub ci_semantic_hash_matches: i64,
    pub ci_decision_consumed_not_reinterpreted: i64,
    pub write_attached: i64,
    pub edit_attached: i64,
    pub apply_patch_attached: i64,
    pub commit_attached: i64,
    pub ci_attached: i64,
    pub claim_ready_requested: i64,
    pub sabotage_count: i64,
    pub sabotage_required: i64,
}

fn loom_change_fact(word: i64, shift: i64) -> i64 {
    (word >> shift) & 1
}

pub fn loom_sovereign_change_observation_from_words(
    mode: i64,
    stage: i64,
    word: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> LoomSovereignChangeObservation {
    LoomSovereignChangeObservation {
        mode: mode,
        stage: stage,
        preregistered: loom_change_fact(word, 0),
        parent_9042_frozen: loom_change_fact(word, 1),
        parent_9042_production: loom_change_fact(word, 2),
        parent_hash_bound: loom_change_fact(word, 3),
        producer_sounio: loom_change_fact(word, 4),
        expected_result_sounio: loom_change_fact(word, 5),
        python_absent: loom_change_fact(word, 6),
        rust_absent: loom_change_fact(word, 7),
        change_intent_schema_exact: loom_change_fact(word, 8),
        operation_supported: loom_change_fact(word, 9),
        raw_event_hash_bound: loom_change_fact(word, 10),
        patch_hash_bound: loom_change_fact(word, 11),
        patch_bytes_nonempty: loom_change_fact(word, 12),
        worktree_identity_bound: loom_change_fact(word, 13),
        pre_head_bound: loom_change_fact(word, 14),
        pre_index_bound: loom_change_fact(word, 15),
        pre_worktree_bound: loom_change_fact(word, 16),
        file_set_canonical: loom_change_fact(word, 17),
        file_set_nonempty: loom_change_fact(word, 18),
        file_set_hash_bound: loom_change_fact(word, 19),
        so_peercred_bound: loom_change_fact(word, 20),
        pidfd_bound: loom_change_fact(word, 21),
        start_tick_bound: loom_change_fact(word, 22),
        harness_ancestry_bound: loom_change_fact(word, 23),
        executable_bound: loom_change_fact(word, 24),
        operation_bound: loom_change_fact(word, 25),
        grant_resident_memory: loom_change_fact(word, 26),
        grant_non_bearer: loom_change_fact(word, 27),
        grant_single_use: loom_change_fact(word, 28),
        grant_atomic_consume: loom_change_fact(word, 29),
        grant_not_exported: loom_change_fact(word, 30),
        grant_issued: loom_change_fact(word, 31),
        post_image_computed: loom_change_fact(word, 32),
        post_image_hash_bound: loom_change_fact(word, 33),
        post_worktree_matches: loom_change_fact(word, 34),
        no_ungranted_path_changed: loom_change_fact(word, 35),
        change_applied_exactly_once: loom_change_fact(word, 36),
        commit_tree_bound: loom_change_fact(word, 37),
        commit_parent_bound: loom_change_fact(word, 38),
        commit_message_bound: loom_change_fact(word, 39),
        commit_index_matches: loom_change_fact(word, 40),
        commit_receipt_issued: loom_change_fact(word, 41),
        receipt_source_bound: loom_change_fact(word, 42),
        receipt_semantics_bound: loom_change_fact(word, 43),
        receipt_toolchain_bound: loom_change_fact(word, 44),
        receipt_hardware_bound: loom_change_fact(word, 45),
        receipt_command_bound: loom_change_fact(word, 46),
        receipt_result_bound: loom_change_fact(word, 47),
        receipt_change_bound: loom_change_fact(word, 48),
        receipt_commit_bound: loom_change_fact(word, 49),
        receipt_authority_bound: loom_change_fact(word, 50),
        ci_commit_matches: loom_change_fact(word, 51),
        ci_tree_matches: loom_change_fact(word, 52),
        ci_receipt_hash_matches: loom_change_fact(word, 53),
        ci_semantic_hash_matches: loom_change_fact(word, 54),
        ci_decision_consumed_not_reinterpreted: loom_change_fact(word, 55),
        write_attached: loom_change_fact(word, 56),
        edit_attached: loom_change_fact(word, 57),
        apply_patch_attached: loom_change_fact(word, 58),
        commit_attached: loom_change_fact(word, 59),
        ci_attached: loom_change_fact(word, 60),
        claim_ready_requested: loom_change_fact(word, 61),
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
}

fn loom_change_later_than_prepare(observation: LoomSovereignChangeObservation) -> bool {
    observation.post_image_computed == 1 ||
    observation.post_image_hash_bound == 1 ||
    observation.post_worktree_matches == 1 ||
    observation.no_ungranted_path_changed == 1 ||
    observation.change_applied_exactly_once == 1 ||
    loom_change_later_than_consume(observation)
}

fn loom_change_later_than_consume(observation: LoomSovereignChangeObservation) -> bool {
    observation.commit_tree_bound == 1 ||
    observation.commit_parent_bound == 1 ||
    observation.commit_message_bound == 1 ||
    observation.commit_index_matches == 1 ||
    observation.commit_receipt_issued == 1 ||
    loom_change_later_than_commit(observation)
}

fn loom_change_later_than_commit(observation: LoomSovereignChangeObservation) -> bool {
    observation.receipt_source_bound == 1 ||
    observation.receipt_semantics_bound == 1 ||
    observation.receipt_toolchain_bound == 1 ||
    observation.receipt_hardware_bound == 1 ||
    observation.receipt_command_bound == 1 ||
    observation.receipt_result_bound == 1 ||
    observation.receipt_change_bound == 1 ||
    observation.receipt_commit_bound == 1 ||
    observation.receipt_authority_bound == 1 ||
    loom_change_later_than_receipt(observation)
}

fn loom_change_later_than_receipt(observation: LoomSovereignChangeObservation) -> bool {
    observation.ci_commit_matches == 1 ||
    observation.ci_tree_matches == 1 ||
    observation.ci_receipt_hash_matches == 1 ||
    observation.ci_semantic_hash_matches == 1 ||
    observation.ci_decision_consumed_not_reinterpreted == 1 ||
    loom_change_attachment_claimed(observation)
}

fn loom_change_attachment_claimed(observation: LoomSovereignChangeObservation) -> bool {
    observation.write_attached == 1 || observation.edit_attached == 1 ||
    observation.apply_patch_attached == 1 || observation.commit_attached == 1 ||
    observation.ci_attached == 1 || observation.claim_ready_requested == 1
}

// 1 = CHANGE_PREPARED, 2 = CHANGE_CONSUMED, 3 = COMMIT_ADMIT,
// 4 = CI_ADMIT, 5 = PRODUCTION_GATE_READY.
pub fn judge_loom_sovereign_change_kernel(
    observation: LoomSovereignChangeObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 { return 613 }
    if observation.parent_9042_frozen != 1 ||
        observation.parent_9042_production != 1 ||
        observation.parent_hash_bound != 1 { return 614 }
    if observation.producer_sounio != 1 ||
        observation.expected_result_sounio != 1 ||
        observation.python_absent != 1 || observation.rust_absent != 1 {
        return 615
    }
    if observation.change_intent_schema_exact != 1 ||
        observation.operation_supported != 1 ||
        observation.raw_event_hash_bound != 1 ||
        observation.patch_hash_bound != 1 ||
        observation.patch_bytes_nonempty != 1 ||
        observation.worktree_identity_bound != 1 { return 616 }
    if observation.pre_head_bound != 1 || observation.pre_index_bound != 1 ||
        observation.pre_worktree_bound != 1 ||
        observation.file_set_canonical != 1 ||
        observation.file_set_nonempty != 1 ||
        observation.file_set_hash_bound != 1 { return 617 }
    if observation.so_peercred_bound != 1 || observation.pidfd_bound != 1 ||
        observation.start_tick_bound != 1 ||
        observation.harness_ancestry_bound != 1 ||
        observation.executable_bound != 1 ||
        observation.operation_bound != 1 { return 618 }
    if observation.grant_resident_memory != 1 ||
        observation.grant_non_bearer != 1 ||
        observation.grant_single_use != 1 ||
        observation.grant_atomic_consume != 1 ||
        observation.grant_not_exported != 1 ||
        observation.grant_issued != 1 { return 619 }
    if observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required { return 628 }

    if observation.mode == 1 {
        if loom_change_later_than_prepare(observation) { return 620 }
        return 1
    }
    if observation.post_image_computed != 1 ||
        observation.post_image_hash_bound != 1 ||
        observation.post_worktree_matches != 1 { return 621 }
    if observation.no_ungranted_path_changed != 1 ||
        observation.change_applied_exactly_once != 1 { return 622 }
    if observation.mode == 2 {
        if loom_change_later_than_consume(observation) { return 620 }
        return 2
    }
    if observation.commit_tree_bound != 1 ||
        observation.commit_parent_bound != 1 ||
        observation.commit_message_bound != 1 ||
        observation.commit_index_matches != 1 ||
        observation.commit_receipt_issued != 1 { return 623 }
    if observation.receipt_source_bound != 1 ||
        observation.receipt_semantics_bound != 1 ||
        observation.receipt_toolchain_bound != 1 ||
        observation.receipt_hardware_bound != 1 ||
        observation.receipt_command_bound != 1 ||
        observation.receipt_result_bound != 1 ||
        observation.receipt_change_bound != 1 ||
        observation.receipt_commit_bound != 1 ||
        observation.receipt_authority_bound != 1 { return 624 }
    if observation.mode == 3 {
        if loom_change_later_than_receipt(observation) { return 620 }
        return 3
    }
    if observation.ci_commit_matches != 1 ||
        observation.ci_tree_matches != 1 ||
        observation.ci_receipt_hash_matches != 1 ||
        observation.ci_semantic_hash_matches != 1 ||
        observation.ci_decision_consumed_not_reinterpreted != 1 { return 625 }
    if observation.mode == 4 {
        if loom_change_attachment_claimed(observation) { return 620 }
        return 4
    }
    if observation.mode != 5 { return 620 }
    if observation.write_attached != 1 || observation.edit_attached != 1 ||
        observation.apply_patch_attached != 1 ||
        observation.commit_attached != 1 || observation.ci_attached != 1 {
        return 626
    }
    if observation.claim_ready_requested != 1 { return 627 }
    5
}

pub fn judge_loom_sovereign_change_kernel_words(
    mode: i64,
    stage: i64,
    word: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> i64 {
    judge_loom_sovereign_change_kernel(
        loom_sovereign_change_observation_from_words(
            mode, stage, word, sabotage_count, sabotage_required,
        ),
    )
}

pub fn loom_sovereign_change_kernel_selftest() -> i64 {
    let prepare = (1 << 32) - 1
    let consume = (1 << 37) - 1
    let commit = (1 << 51) - 1
    let ci = (1 << 56) - 1
    let production = (1 << 62) - 1
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare, 12, 12) != 1 { return 1 }
    if judge_loom_sovereign_change_kernel_words(2, 3, consume, 12, 12) != 2 { return 2 }
    if judge_loom_sovereign_change_kernel_words(3, 3, commit, 12, 12) != 3 { return 3 }
    if judge_loom_sovereign_change_kernel_words(4, 3, ci, 12, 12) != 4 { return 4 }
    if judge_loom_sovereign_change_kernel_words(5, 3, production, 12, 12) != 5 { return 5 }
    if judge_loom_sovereign_change_kernel_words(1, 2, prepare, 12, 12) != 613 { return 6 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare ^ (1 << 1), 12, 12) != 614 { return 7 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare ^ (1 << 4), 12, 12) != 615 { return 8 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare ^ (1 << 8), 12, 12) != 616 { return 9 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare ^ (1 << 14), 12, 12) != 617 { return 10 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare ^ (1 << 20), 12, 12) != 618 { return 11 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare ^ (1 << 26), 12, 12) != 619 { return 12 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare ^ (1 << 32), 12, 12) != 620 { return 13 }
    if judge_loom_sovereign_change_kernel_words(2, 3, consume ^ (1 << 32), 12, 12) != 621 { return 14 }
    if judge_loom_sovereign_change_kernel_words(2, 3, consume ^ (1 << 35), 12, 12) != 622 { return 15 }
    if judge_loom_sovereign_change_kernel_words(3, 3, commit ^ (1 << 37), 12, 12) != 623 { return 16 }
    if judge_loom_sovereign_change_kernel_words(3, 3, commit ^ (1 << 42), 12, 12) != 624 { return 17 }
    if judge_loom_sovereign_change_kernel_words(4, 3, ci ^ (1 << 55), 12, 12) != 625 { return 18 }
    if judge_loom_sovereign_change_kernel_words(5, 3, production ^ (1 << 56), 12, 12) != 626 { return 19 }
    if judge_loom_sovereign_change_kernel_words(5, 3, production ^ (1 << 61), 12, 12) != 627 { return 20 }
    if judge_loom_sovereign_change_kernel_words(1, 3, prepare, 11, 12) != 628 { return 21 }
    0
}
