//! Nominal epistemic-machine algebra for Sounio Loom worldlines.
//!
//! The OCaml host owns journal replay, references, and exact-resource locking.
//! This module owns the nominal transition shapes admitted through frame 9008.

pub effect LoomEpistemicHostTrust {}

struct EpistemicDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

linear struct LoomEpistemicHostSeal {
    world_token: i64,
    next_receipt_id: i64,
}

linear struct HostEpistemicTransitionReceipt {
    receipt_id: i64,
    transition_kind: i64,
    previous_state: i64,
    next_state: i64,
    world_token: i64,
    parent_token: i64,
    subject_token: i64,
    related_token: i64,
    owner_token: i64,
    generation_token: i64,
    value_digest: EpistemicDigest256,
    error_digest: EpistemicDigest256,
    uncertainty_digest: EpistemicDigest256,
    confidence_digest: EpistemicDigest256,
    provenance_digest: EpistemicDigest256,
    evidence_digest: EpistemicDigest256,
    falsifier_digest: EpistemicDigest256,
}

linear struct EpistemicWorld {
    world_token: i64,
}

linear struct ObservedKnowledge {
    world_token: i64,
    knowledge_token: i64,
    value_digest: EpistemicDigest256,
    error_digest: EpistemicDigest256,
    uncertainty_digest: EpistemicDigest256,
    confidence_digest: EpistemicDigest256,
    provenance_digest: EpistemicDigest256,
}

linear struct OpenEpistemicClaim {
    world_token: i64,
    claim_token: i64,
    knowledge_token: i64,
    evidence_digest: EpistemicDigest256,
}

linear struct ChallengedEpistemicClaim {
    world_token: i64,
    claim_token: i64,
    challenge_token: i64,
    falsifier_digest: EpistemicDigest256,
}

linear struct LinearWriteCapability {
    world_token: i64,
    capability_token: i64,
    resource_token: i64,
    owner_token: i64,
    generation_token: i64,
}

linear struct ForkedEpistemicWorld {
    world_token: i64,
    parent_token: i64,
    parent_head: EpistemicDigest256,
    hypothesis_digest: EpistemicDigest256,
}

pub fn admit_epistemic_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> EpistemicDigest256 {
    EpistemicDigest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
}

fn epistemic_digest_is_canonical(digest: EpistemicDigest256) -> bool {
    digest.limb0 >= 0 && digest.limb0 <= 4294967295 &&
    digest.limb1 >= 0 && digest.limb1 <= 4294967295 &&
    digest.limb2 >= 0 && digest.limb2 <= 4294967295 &&
    digest.limb3 >= 0 && digest.limb3 <= 4294967295 &&
    digest.limb4 >= 0 && digest.limb4 <= 4294967295 &&
    digest.limb5 >= 0 && digest.limb5 <= 4294967295 &&
    digest.limb6 >= 0 && digest.limb6 <= 4294967295 &&
    digest.limb7 >= 0 && digest.limb7 <= 4294967295
}

fn epistemic_digest_is_nonzero(digest: EpistemicDigest256) -> bool {
    digest.limb0 != 0 || digest.limb1 != 0 || digest.limb2 != 0 ||
    digest.limb3 != 0 || digest.limb4 != 0 || digest.limb5 != 0 ||
    digest.limb6 != 0 || digest.limb7 != 0
}

fn epistemic_digest_is_zero(digest: EpistemicDigest256) -> bool {
    !epistemic_digest_is_nonzero(digest)
}

fn epistemic_digest_equal(
    left: EpistemicDigest256,
    right: EpistemicDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn epistemic_digests_are_distinct(
    value: EpistemicDigest256,
    error: EpistemicDigest256,
    uncertainty: EpistemicDigest256,
    confidence: EpistemicDigest256,
    provenance: EpistemicDigest256,
) -> bool {
    !epistemic_digest_equal(value, error) &&
    !epistemic_digest_equal(value, uncertainty) &&
    !epistemic_digest_equal(value, confidence) &&
    !epistemic_digest_equal(value, provenance) &&
    !epistemic_digest_equal(error, uncertainty) &&
    !epistemic_digest_equal(error, confidence) &&
    !epistemic_digest_equal(error, provenance) &&
    !epistemic_digest_equal(uncertainty, confidence) &&
    !epistemic_digest_equal(uncertainty, provenance) &&
    !epistemic_digest_equal(confidence, provenance)
}

fn knowledge_axes_are_bound(
    value: EpistemicDigest256,
    error: EpistemicDigest256,
    uncertainty: EpistemicDigest256,
    confidence: EpistemicDigest256,
    provenance: EpistemicDigest256,
) -> bool {
    epistemic_digest_is_canonical(value) &&
    epistemic_digest_is_canonical(error) &&
    epistemic_digest_is_canonical(uncertainty) &&
    epistemic_digest_is_canonical(confidence) &&
    epistemic_digest_is_canonical(provenance) &&
    epistemic_digest_is_nonzero(value) &&
    epistemic_digest_is_nonzero(error) &&
    epistemic_digest_is_nonzero(uncertainty) &&
    epistemic_digest_is_nonzero(confidence) &&
    epistemic_digest_is_nonzero(provenance) &&
    epistemic_digests_are_distinct(
        value, error, uncertainty, confidence, provenance,
    )
}

fn all_epistemic_digests_are_zero(
    value: EpistemicDigest256,
    error: EpistemicDigest256,
    uncertainty: EpistemicDigest256,
    confidence: EpistemicDigest256,
    provenance: EpistemicDigest256,
    evidence: EpistemicDigest256,
    falsifier: EpistemicDigest256,
) -> bool {
    epistemic_digest_is_zero(value) && epistemic_digest_is_zero(error) &&
    epistemic_digest_is_zero(uncertainty) &&
    epistemic_digest_is_zero(confidence) &&
    epistemic_digest_is_zero(provenance) &&
    epistemic_digest_is_zero(evidence) &&
    epistemic_digest_is_zero(falsifier)
}

fn epistemic_transition_shape_is_canonical(
    kind: i64,
    previous_state: i64,
    next_state: i64,
    world_token: i64,
    parent_token: i64,
    subject_token: i64,
    related_token: i64,
    owner_token: i64,
    generation_token: i64,
    value: EpistemicDigest256,
    error: EpistemicDigest256,
    uncertainty: EpistemicDigest256,
    confidence: EpistemicDigest256,
    provenance: EpistemicDigest256,
    evidence: EpistemicDigest256,
    falsifier: EpistemicDigest256,
) -> bool {
    let all_zero = all_epistemic_digests_are_zero(
        value, error, uncertainty, confidence, provenance, evidence, falsifier,
    )
    let observation = kind == 2 && previous_state == 1 && next_state == 1 &&
        parent_token == 0 && subject_token > 0 && related_token == 0 &&
        owner_token == 0 && generation_token == 0 &&
        epistemic_digest_is_zero(evidence) &&
        epistemic_digest_is_zero(falsifier) &&
        knowledge_axes_are_bound(value, error, uncertainty, confidence, provenance)
    let claim = kind == 3 && previous_state == 1 && next_state == 1 &&
        parent_token == 0 && subject_token > 0 && related_token > 0 &&
        owner_token == 0 && generation_token == 0 &&
        epistemic_digest_is_zero(value) && epistemic_digest_is_zero(error) &&
        epistemic_digest_is_zero(uncertainty) &&
        epistemic_digest_is_zero(confidence) &&
        epistemic_digest_is_zero(provenance) &&
        epistemic_digest_is_nonzero(evidence) &&
        epistemic_digest_is_zero(falsifier)
    let challenge = kind == 4 && previous_state == 1 && next_state == 1 &&
        parent_token == 0 && subject_token > 0 && related_token > 0 &&
        owner_token == 0 && generation_token == 0 &&
        epistemic_digest_is_zero(value) && epistemic_digest_is_zero(error) &&
        epistemic_digest_is_zero(uncertainty) &&
        epistemic_digest_is_zero(confidence) &&
        epistemic_digest_is_zero(provenance) &&
        epistemic_digest_is_zero(evidence) &&
        epistemic_digest_is_nonzero(falsifier)
    let capability = (kind == 5 || kind == 6) && previous_state == 1 &&
        next_state == 1 && parent_token == 0 && subject_token > 0 &&
        related_token > 0 && owner_token > 0 && generation_token > 0 && all_zero
    let fork = kind == 7 && previous_state == 0 && next_state == 1 &&
        parent_token > 0 && subject_token > 0 && related_token == 0 &&
        owner_token == 0 && generation_token == 0 &&
        epistemic_digest_is_zero(value) && epistemic_digest_is_zero(error) &&
        epistemic_digest_is_zero(uncertainty) &&
        epistemic_digest_is_zero(confidence) &&
        epistemic_digest_is_nonzero(provenance) &&
        epistemic_digest_is_nonzero(evidence) &&
        epistemic_digest_is_zero(falsifier)
    world_token > 0 &&
    ((kind == 1 && previous_state == 0 && next_state == 1 &&
      parent_token == 0 && subject_token == 0 && related_token == 0 &&
      owner_token == 0 && generation_token == 0 && all_zero) ||
     observation || claim || challenge || capability || fork)
}

pub fn host_epistemic_transition_accepts(
    kind: i64,
    previous_state: i64,
    next_state: i64,
    world_token: i64,
    parent_token: i64,
    subject_token: i64,
    related_token: i64,
    owner_token: i64,
    generation_token: i64,
    value: EpistemicDigest256,
    error: EpistemicDigest256,
    uncertainty: EpistemicDigest256,
    confidence: EpistemicDigest256,
    provenance: EpistemicDigest256,
    evidence: EpistemicDigest256,
    falsifier: EpistemicDigest256,
) -> bool with LoomEpistemicHostTrust {
    epistemic_transition_shape_is_canonical(
        kind, previous_state, next_state, world_token, parent_token,
        subject_token, related_token, owner_token, generation_token,
        value, error, uncertainty, confidence, provenance, evidence, falsifier,
    )
}

fn open_epistemic_host_bridge(
    world_token: i64,
) -> LoomEpistemicHostSeal with LoomEpistemicHostTrust, Panic {
    if world_token <= 0 { panic("epistemic world identity is not canonical") }
    LoomEpistemicHostSeal { world_token: world_token, next_receipt_id: 1 }
}

fn admit_host_epistemic_transition(
    seal: LoomEpistemicHostSeal,
    kind: i64,
    previous_state: i64,
    next_state: i64,
    receipt_world_token: i64,
    parent_token: i64,
    subject_token: i64,
    related_token: i64,
    owner_token: i64,
    generation_token: i64,
    value: EpistemicDigest256,
    error: EpistemicDigest256,
    uncertainty: EpistemicDigest256,
    confidence: EpistemicDigest256,
    provenance: EpistemicDigest256,
    evidence: EpistemicDigest256,
    falsifier: EpistemicDigest256,
) -> (LoomEpistemicHostSeal, HostEpistemicTransitionReceipt) with LoomEpistemicHostTrust, Panic {
    let LoomEpistemicHostSeal { world_token, next_receipt_id } = seal
    if receipt_world_token != world_token || !epistemic_transition_shape_is_canonical(
        kind, previous_state, next_state, receipt_world_token, parent_token,
        subject_token, related_token, owner_token, generation_token,
        value, error, uncertainty, confidence, provenance, evidence, falsifier,
    ) {
        panic("host epistemic transition is not canonical")
    }
    let next_seal = LoomEpistemicHostSeal {
        world_token: world_token,
        next_receipt_id: next_receipt_id + 1,
    }
    let receipt = HostEpistemicTransitionReceipt {
        receipt_id: next_receipt_id,
        transition_kind: kind,
        previous_state: previous_state,
        next_state: next_state,
        world_token: receipt_world_token,
        parent_token: parent_token,
        subject_token: subject_token,
        related_token: related_token,
        owner_token: owner_token,
        generation_token: generation_token,
        value_digest: value,
        error_digest: error,
        uncertainty_digest: uncertainty,
        confidence_digest: confidence,
        provenance_digest: provenance,
        evidence_digest: evidence,
        falsifier_digest: falsifier,
    }
    (next_seal, receipt)
}

fn close_epistemic_host_bridge(
    seal: LoomEpistemicHostSeal,
) with Panic {
    let LoomEpistemicHostSeal { world_token, next_receipt_id } = seal
    if world_token <= 0 || next_receipt_id <= 1 {
        panic("epistemic host bridge closed without an admitted transition")
    }
}

pub fn import_epistemic_world(
    receipt: HostEpistemicTransitionReceipt,
) -> Option<EpistemicWorld> {
    let HostEpistemicTransitionReceipt {
        receipt_id: _, transition_kind, previous_state, next_state,
        world_token, parent_token, subject_token: _, related_token: _,
        owner_token: _, generation_token: _, value_digest: _, error_digest: _,
        uncertainty_digest: _, confidence_digest: _, provenance_digest: _,
        evidence_digest: _, falsifier_digest: _,
    } = receipt
    if transition_kind != 1 || previous_state != 0 || next_state != 1 ||
        parent_token != 0 {
        return None
    }
    Some(EpistemicWorld { world_token: world_token })
}

pub fn observe_epistemic_knowledge(
    world: EpistemicWorld,
    knowledge_token: i64,
    value: EpistemicDigest256,
    error: EpistemicDigest256,
    uncertainty: EpistemicDigest256,
    confidence: EpistemicDigest256,
    provenance: EpistemicDigest256,
) -> Option<(EpistemicWorld, ObservedKnowledge)> {
    let EpistemicWorld { world_token } = world
    if knowledge_token <= 0 || !knowledge_axes_are_bound(
        value, error, uncertainty, confidence, provenance,
    ) {
        return None
    }
    Some((
        EpistemicWorld { world_token: world_token },
        ObservedKnowledge {
            world_token: world_token,
            knowledge_token: knowledge_token,
            value_digest: value,
            error_digest: error,
            uncertainty_digest: uncertainty,
            confidence_digest: confidence,
            provenance_digest: provenance,
        },
    ))
}

pub fn open_epistemic_claim(
    knowledge: ObservedKnowledge,
    claim_token: i64,
    evidence: EpistemicDigest256,
) -> Option<OpenEpistemicClaim> {
    let ObservedKnowledge {
        world_token, knowledge_token, value_digest: _, error_digest: _,
        uncertainty_digest: _, confidence_digest: _, provenance_digest: _,
    } = knowledge
    if claim_token <= 0 || !epistemic_digest_is_nonzero(evidence) {
        return None
    }
    Some(OpenEpistemicClaim {
        world_token: world_token,
        claim_token: claim_token,
        knowledge_token: knowledge_token,
        evidence_digest: evidence,
    })
}

pub fn challenge_epistemic_claim(
    claim: OpenEpistemicClaim,
    challenge_token: i64,
    falsifier: EpistemicDigest256,
) -> Option<ChallengedEpistemicClaim> {
    let OpenEpistemicClaim {
        world_token, claim_token, knowledge_token: _, evidence_digest: _,
    } = claim
    if challenge_token <= 0 || !epistemic_digest_is_nonzero(falsifier) {
        return None
    }
    Some(ChallengedEpistemicClaim {
        world_token: world_token,
        claim_token: claim_token,
        challenge_token: challenge_token,
        falsifier_digest: falsifier,
    })
}

pub fn acquire_linear_write_capability(
    world: EpistemicWorld,
    capability_token: i64,
    resource_token: i64,
    owner_token: i64,
    generation_token: i64,
) -> Option<(EpistemicWorld, LinearWriteCapability)> {
    let EpistemicWorld { world_token } = world
    if capability_token <= 0 || resource_token <= 0 || owner_token <= 0 ||
        generation_token <= 0 {
        return None
    }
    Some((
        EpistemicWorld { world_token: world_token },
        LinearWriteCapability {
            world_token: world_token,
            capability_token: capability_token,
            resource_token: resource_token,
            owner_token: owner_token,
            generation_token: generation_token,
        },
    ))
}

pub fn release_linear_write_capability(
    capability: LinearWriteCapability,
) -> i64 {
    let LinearWriteCapability {
        world_token: _, capability_token, resource_token: _, owner_token: _,
        generation_token: _,
    } = capability
    capability_token
}

pub fn fork_epistemic_world(
    parent: EpistemicWorld,
    child_token: i64,
    parent_head: EpistemicDigest256,
    hypothesis_digest: EpistemicDigest256,
) -> Option<(EpistemicWorld, ForkedEpistemicWorld)> {
    let EpistemicWorld { world_token } = parent
    if child_token <= 0 || child_token == world_token ||
        !epistemic_digest_is_nonzero(parent_head) ||
        !epistemic_digest_is_nonzero(hypothesis_digest) {
        return None
    }
    Some((
        EpistemicWorld { world_token: world_token },
        ForkedEpistemicWorld {
            world_token: child_token,
            parent_token: world_token,
            parent_head: parent_head,
            hypothesis_digest: hypothesis_digest,
        },
    ))
}

pub fn challenged_claim_token(claim: ChallengedEpistemicClaim) -> i64 {
    let ChallengedEpistemicClaim {
        world_token: _, claim_token, challenge_token: _, falsifier_digest: _,
    } = claim
    claim_token
}

pub fn forked_world_token(world: ForkedEpistemicWorld) -> i64 {
    let ForkedEpistemicWorld {
        world_token, parent_token: _, parent_head: _, hypothesis_digest: _,
    } = world
    world_token
}
