//! LOOM action 9041: semantic authority for host boot reconciliation.
//!
//! v1 can recover a surviving physical lane, but never opens a successor
//! generation after Guardian loss.

struct LoomHostBootObservation {
    stage: i64,
    preregistered: i64,
    producer_sounio: i64,
    expected_result_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    policy_present: i64,
    semantics_hash_bound: i64,
    runtime_hash_bound: i64,
    desired_catalog_bound: i64,
    service_enabled: i64,
    current_boot_observed: i64,
    state_root_bound: i64,
    lane_enrolled: i64,
    kernel_live: i64,
    guardian_live: i64,
    guardian_pid_verified: i64,
    guardian_start_verified: i64,
    guardian_instance_verified: i64,
    harness_live: i64,
    harness_pid_verified: i64,
    harness_start_verified: i64,
    command_bound: i64,
    boot_equal: i64,
    journals_verified: i64,
    output_prefix_preserved: i64,
    no_same_pty_claim_after_loss: i64,
    material_observation_joined: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

pub fn loom_host_boot_observation(
    stage: i64, preregistered: i64,
    producer_sounio: i64, expected_result_sounio: i64,
    python_absent: i64, rust_absent: i64,
    policy_present: i64, semantics_hash_bound: i64,
    runtime_hash_bound: i64, desired_catalog_bound: i64,
    service_enabled: i64, current_boot_observed: i64,
    state_root_bound: i64, lane_enrolled: i64,
    kernel_live: i64, guardian_live: i64,
    guardian_pid_verified: i64, guardian_start_verified: i64,
    guardian_instance_verified: i64, harness_live: i64,
    harness_pid_verified: i64, harness_start_verified: i64,
    command_bound: i64, boot_equal: i64,
    journals_verified: i64, output_prefix_preserved: i64,
    no_same_pty_claim_after_loss: i64,
    material_observation_joined: i64,
    sabotage_count: i64, sabotage_required: i64,
) -> LoomHostBootObservation {
    LoomHostBootObservation {
        stage: stage, preregistered: preregistered,
        producer_sounio: producer_sounio,
        expected_result_sounio: expected_result_sounio,
        python_absent: python_absent, rust_absent: rust_absent,
        policy_present: policy_present,
        semantics_hash_bound: semantics_hash_bound,
        runtime_hash_bound: runtime_hash_bound,
        desired_catalog_bound: desired_catalog_bound,
        service_enabled: service_enabled,
        current_boot_observed: current_boot_observed,
        state_root_bound: state_root_bound, lane_enrolled: lane_enrolled,
        kernel_live: kernel_live, guardian_live: guardian_live,
        guardian_pid_verified: guardian_pid_verified,
        guardian_start_verified: guardian_start_verified,
        guardian_instance_verified: guardian_instance_verified,
        harness_live: harness_live,
        harness_pid_verified: harness_pid_verified,
        harness_start_verified: harness_start_verified,
        command_bound: command_bound, boot_equal: boot_equal,
        journals_verified: journals_verified,
        output_prefix_preserved: output_prefix_preserved,
        no_same_pty_claim_after_loss: no_same_pty_claim_after_loss,
        material_observation_joined: material_observation_joined,
        sabotage_count: sabotage_count, sabotage_required: sabotage_required,
    }
}

// 1 = NOOP_ACTIVE, 2 = RECOVER_SAME_PHYSICAL,
// 3 = HOLD_LINEAGE_REQUIRED, 4 = HOLD_DISABLED, 5 = HOLD_UNENROLLED.
pub fn judge_loom_host_boot(observation: LoomHostBootObservation) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 {
        return 541
    }
    if observation.producer_sounio != 1 ||
        observation.expected_result_sounio != 1 ||
        observation.python_absent != 1 || observation.rust_absent != 1 {
        return 542
    }
    if observation.policy_present != 1 ||
        observation.semantics_hash_bound != 1 ||
        observation.runtime_hash_bound != 1 ||
        observation.desired_catalog_bound != 1 ||
        observation.current_boot_observed != 1 ||
        observation.state_root_bound != 1 {
        return 543
    }
    if observation.material_observation_joined != 1 ||
        observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required {
        return 544
    }
    if observation.service_enabled != 1 { return 4 }
    if observation.lane_enrolled != 1 { return 5 }
    if observation.guardian_live == 1 {
        if observation.guardian_pid_verified != 1 ||
            observation.guardian_start_verified != 1 ||
            observation.guardian_instance_verified != 1 {
            return 545
        }
        if observation.harness_live != 1 ||
            observation.harness_pid_verified != 1 ||
            observation.harness_start_verified != 1 ||
            observation.command_bound != 1 || observation.boot_equal != 1 {
            return 546
        }
        if observation.journals_verified != 1 ||
            observation.output_prefix_preserved != 1 {
            return 547
        }
        if observation.kernel_live == 1 { return 1 }
        return 2
    }
    if observation.kernel_live == 1 { return 548 }
    if observation.no_same_pty_claim_after_loss != 1 { return 549 }
    3
}

fn loom_host_boot_case(case_index: i64) -> i64 {
    let guardian = case_index != 3 && case_index != 12 && case_index != 13
    let kernel = case_index == 1 || case_index == 12
    let observation = loom_host_boot_observation(
        if case_index == 6 { 2 } else { 3 }, 1,
        if case_index == 7 { 0 } else { 1 }, 1, 1, 1,
        1, if case_index == 8 { 0 } else { 1 }, 1, 1,
        if case_index == 4 { 0 } else { 1 }, 1, 1,
        if case_index == 5 { 0 } else { 1 },
        if kernel { 1 } else { 0 }, if guardian { 1 } else { 0 },
        1, if case_index == 9 { 0 } else { 1 }, 1,
        1, 1, if case_index == 10 { 0 } else { 1 },
        1, if guardian { 1 } else { 0 },
        if case_index == 11 { 0 } else { 1 }, 1,
        if case_index == 13 { 0 } else { 1 },
        1, if case_index == 14 { 0 } else { 1 }, 1,
    )
    judge_loom_host_boot(observation)
}

pub fn loom_host_boot_reconciler_selftest() -> i64 {
    if loom_host_boot_case(1) != 1 { return 1 }
    if loom_host_boot_case(2) != 2 { return 2 }
    if loom_host_boot_case(3) != 3 { return 3 }
    if loom_host_boot_case(4) != 4 { return 4 }
    if loom_host_boot_case(5) != 5 { return 5 }
    if loom_host_boot_case(6) != 541 { return 6 }
    if loom_host_boot_case(7) != 542 { return 7 }
    if loom_host_boot_case(8) != 543 { return 8 }
    if loom_host_boot_case(9) != 545 { return 9 }
    if loom_host_boot_case(10) != 546 { return 10 }
    if loom_host_boot_case(11) != 547 { return 11 }
    if loom_host_boot_case(12) != 548 { return 12 }
    if loom_host_boot_case(13) != 549 { return 13 }
    if loom_host_boot_case(14) != 544 { return 14 }
    0
}
