//! LOOM action 9046: native hook generation-drain semantic authority.
//!
//! Absence is affirmative only when the inventory is fresh and complete, every
//! live process generation is classified, and all non-native counts are zero.

pub struct LoomNativeHookGenerationDrainObservation {
    pub mode: i64,
    pub stage: i64,
    pub parent_9045_frozen: i64,
    pub old_runtime_bound: i64,
    pub candidate_runtime_bound: i64,
    pub candidate_config_bound: i64,
    pub final_config_bound: i64,
    pub inventory_epoch_bound: i64,
    pub inventory_fresh: i64,
    pub inventory_complete: i64,
    pub classification_complete: i64,
    pub process_generation_bound: i64,
    pub hook_capability_bound: i64,
    pub four_provider_canaries: i64,
    pub rollback_pair_tested: i64,
    pub fail_closed: i64,
    pub decision_receipt_complete: i64,
    pub python_oracle_absent: i64,
    pub rust_oracle_absent: i64,
    pub disposable_oracle_absent: i64,
    pub activation_requested: i64,
    pub native_entry_open: i64,
    pub bridge_free_candidate: i64,
    pub current_legacy_bridge: i64,
    pub zero_legacy_claimed: i64,
    pub total: i64,
    pub classified: i64,
    pub native: i64,
    pub legacy: i64,
    pub unknown: i64,
    pub unresponsive: i64,
    pub canary_mask: i64,
    pub inventory_hash0: i64,
    pub inventory_hash1: i64,
    pub old_runtime_hash: i64,
    pub candidate_runtime_hash: i64,
    pub config_pair_hash: i64,
    pub sabotage_count: i64,
    pub sabotage_required: i64,
}

fn drain_fact(word: i64, shift: i64) -> i64 {
    (word >> shift) & 1
}

pub fn loom_native_hook_generation_drain_observation_from_words(
    mode: i64,
    stage: i64,
    word: i64,
    total: i64,
    classified: i64,
    native: i64,
    legacy: i64,
    unknown: i64,
    unresponsive: i64,
    canary_mask: i64,
    inventory_hash0: i64,
    inventory_hash1: i64,
    old_runtime_hash: i64,
    candidate_runtime_hash: i64,
    config_pair_hash: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> LoomNativeHookGenerationDrainObservation {
    LoomNativeHookGenerationDrainObservation {
        mode: mode,
        stage: stage,
        parent_9045_frozen: drain_fact(word, 0),
        old_runtime_bound: drain_fact(word, 1),
        candidate_runtime_bound: drain_fact(word, 2),
        candidate_config_bound: drain_fact(word, 3),
        final_config_bound: drain_fact(word, 4),
        inventory_epoch_bound: drain_fact(word, 5),
        inventory_fresh: drain_fact(word, 6),
        inventory_complete: drain_fact(word, 7),
        classification_complete: drain_fact(word, 8),
        process_generation_bound: drain_fact(word, 9),
        hook_capability_bound: drain_fact(word, 10),
        four_provider_canaries: drain_fact(word, 11),
        rollback_pair_tested: drain_fact(word, 12),
        fail_closed: drain_fact(word, 13),
        decision_receipt_complete: drain_fact(word, 14),
        python_oracle_absent: drain_fact(word, 15),
        rust_oracle_absent: drain_fact(word, 16),
        disposable_oracle_absent: drain_fact(word, 17),
        activation_requested: drain_fact(word, 18),
        native_entry_open: drain_fact(word, 19),
        bridge_free_candidate: drain_fact(word, 20),
        current_legacy_bridge: drain_fact(word, 21),
        zero_legacy_claimed: drain_fact(word, 22),
        total: total,
        classified: classified,
        native: native,
        legacy: legacy,
        unknown: unknown,
        unresponsive: unresponsive,
        canary_mask: canary_mask,
        inventory_hash0: inventory_hash0,
        inventory_hash1: inventory_hash1,
        old_runtime_hash: old_runtime_hash,
        candidate_runtime_hash: candidate_runtime_hash,
        config_pair_hash: config_pair_hash,
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
}

// 1 = DRAINING, 2 = CUTOVER_READY.
pub fn judge_loom_native_hook_generation_drain(
    o: LoomNativeHookGenerationDrainObservation,
) -> i64 {
    if o.stage != 3 || o.parent_9045_frozen != 1 { return 671 }
    if o.old_runtime_bound != 1 || o.candidate_runtime_bound != 1 ||
        o.candidate_config_bound != 1 || o.final_config_bound != 1 ||
        (o.inventory_hash0 == 0 && o.inventory_hash1 == 0) ||
        o.old_runtime_hash == 0 || o.candidate_runtime_hash == 0 ||
        o.config_pair_hash == 0 { return 672 }
    if o.inventory_epoch_bound != 1 || o.inventory_fresh != 1 ||
        o.inventory_complete != 1 || o.classification_complete != 1 {
        return 673
    }
    if o.total < 0 || o.classified < 0 || o.native < 0 ||
        o.legacy < 0 || o.unknown < 0 || o.unresponsive < 0 ||
        o.classified != o.total ||
        o.native + o.legacy + o.unknown + o.unresponsive != o.total {
        return 674
    }
    if o.process_generation_bound != 1 || o.hook_capability_bound != 1 {
        return 675
    }
    if o.python_oracle_absent != 1 || o.rust_oracle_absent != 1 ||
        o.disposable_oracle_absent != 1 { return 676 }
    if o.sabotage_required < 6 || o.sabotage_count < o.sabotage_required {
        return 677
    }
    if o.four_provider_canaries != 1 || o.canary_mask != 15 ||
        o.rollback_pair_tested != 1 || o.fail_closed != 1 ||
        o.decision_receipt_complete != 1 || o.native_entry_open != 1 ||
        o.bridge_free_candidate != 1 || o.current_legacy_bridge != 1 {
        return 678
    }

    if o.mode == 1 {
        if o.activation_requested != 0 || o.zero_legacy_claimed != 0 ||
            o.legacy + o.unknown + o.unresponsive <= 0 { return 679 }
        return 1
    }
    if o.mode == 2 {
        if o.activation_requested != 1 || o.zero_legacy_claimed != 1 ||
            o.total <= 0 || o.native != o.total || o.legacy != 0 ||
            o.unknown != 0 || o.unresponsive != 0 { return 680 }
        return 2
    }
    681
}

pub fn judge_loom_native_hook_generation_drain_words(
    mode: i64,
    stage: i64,
    word: i64,
    total: i64,
    classified: i64,
    native: i64,
    legacy: i64,
    unknown: i64,
    unresponsive: i64,
    canary_mask: i64,
    inventory_hash0: i64,
    inventory_hash1: i64,
    old_runtime_hash: i64,
    candidate_runtime_hash: i64,
    config_pair_hash: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> i64 {
    judge_loom_native_hook_generation_drain(
        loom_native_hook_generation_drain_observation_from_words(
            mode, stage, word, total, classified, native, legacy, unknown,
            unresponsive, canary_mask, inventory_hash0, inventory_hash1,
            old_runtime_hash, candidate_runtime_hash, config_pair_hash,
            sabotage_count, sabotage_required,
        ),
    )
}

pub fn loom_native_hook_generation_drain_selftest() -> i64 with Mut {
    var failed: i64 = 0
    if judge_loom_native_hook_generation_drain_words(
        1, 3, 3932159, 5, 5, 2, 2, 1, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        1, 3, 3932159, 3, 3, 1, 0, 0, 2, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388607, 4, 4, 4, 0, 0, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 2 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388479, 4, 4, 4, 0, 0, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 673 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388607, 5, 4, 4, 0, 0, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 674 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388095, 4, 4, 4, 0, 0, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 675 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8355839, 4, 4, 4, 0, 0, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 676 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388607, 4, 4, 4, 0, 0, 0, 15, 1, 2, 3, 4, 5, 5, 6,
    ) != 677 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388607, 4, 4, 4, 0, 0, 0, 14, 1, 2, 3, 4, 5, 6, 6,
    ) != 678 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        1, 3, 4194303, 5, 5, 2, 2, 1, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 679 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388607, 4, 4, 3, 1, 0, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 680 { failed = failed + 1 }
    if judge_loom_native_hook_generation_drain_words(
        2, 3, 8388607, 0, 0, 0, 0, 0, 0, 15, 1, 2, 3, 4, 5, 6, 6,
    ) != 680 { failed = failed + 1 }
    failed
}
