//! LOOM action 9036: semantic authority for dynamic execution result records.

struct LoomExecResultRecordDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomExecResultRecordObservation {
    stage: i64,
    preregistered: i64,
    operation: i64,
    catalog_sha256: LoomExecResultRecordDigest256,
    catalog_result_schema_sha256: LoomExecResultRecordDigest256,
    record_schema_sha256: LoomExecResultRecordDigest256,
    operation_projected: i64,
    source_digest_present: i64,
    compiler_digest_present: i64,
    argv_digest_present: i64,
    exit_success: i64,
    artifact_digest_present: i64,
    artifact_bytes_positive: i64,
    diagnostic_digests_present: i64,
    generation_digest_present: i64,
    event_digest_present: i64,
    command_digest_present: i64,
    sandbox_digest_present: i64,
    dynamic_user: i64,
    grant_consumed: i64,
    descriptor_bound: i64,
    principal_distinct: i64,
    direct_exec: i64,
    shell_absent: i64,
    python_absent: i64,
    rust_absent: i64,
    artifact_bound_to_record: i64,
    semantic_authority_sounio: i64,
    result_schema_sounio: i64,
    record_immutable: i64,
    record_read_only: i64,
    handle_non_bearer: i64,
    handle_not_execution_authority: i64,
    provenance_complete: i64,
    raw_event_separate: i64,
    expected_result_absent_from_material: i64,
    review_unpromoted: i64,
    parity_unpromoted: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

pub fn loom_exec_result_record_digest256(
    limb0: i64, limb1: i64, limb2: i64, limb3: i64,
    limb4: i64, limb5: i64, limb6: i64, limb7: i64,
) -> LoomExecResultRecordDigest256 {
    LoomExecResultRecordDigest256 {
        limb0: limb0, limb1: limb1, limb2: limb2, limb3: limb3,
        limb4: limb4, limb5: limb5, limb6: limb6, limb7: limb7,
    }
}

fn loom_exec_result_record_equal(
    left: LoomExecResultRecordDigest256,
    right: LoomExecResultRecordDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn loom_exec_result_record_zero() -> LoomExecResultRecordDigest256 {
    loom_exec_result_record_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn loom_exec_result_record_catalog() -> LoomExecResultRecordDigest256 {
    loom_exec_result_record_digest256(
        822648121, 1762430464, 2379737755, 4274978174,
        1373906300, 3647867167, 2142540482, 1089287212)
}

fn loom_exec_result_record_catalog_schema() -> LoomExecResultRecordDigest256 {
    loom_exec_result_record_digest256(
        3605337063, 2241949863, 3465337072, 2053563698,
        1463222239, 567250742, 1837286645, 4014937551)
}

fn loom_exec_result_record_schema() -> LoomExecResultRecordDigest256 {
    loom_exec_result_record_digest256(
        2130623751, 3346722305, 3017406900, 2923745653,
        3139295492, 1422232841, 3563126059, 4136393196)
}

// 1 = ISSUE. All other values are fail-closed refusal codes.
pub fn judge_loom_exec_result_record(
    observation: LoomExecResultRecordObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 {
        return 570
    }
    if observation.semantic_authority_sounio != 1 ||
        observation.result_schema_sounio != 1 ||
        observation.expected_result_absent_from_material != 1 ||
        observation.review_unpromoted != 1 ||
        observation.parity_unpromoted != 1 {
        return 571
    }
    if observation.operation != 2 ||
        !loom_exec_result_record_equal(
            observation.catalog_sha256,
            loom_exec_result_record_catalog()) ||
        !loom_exec_result_record_equal(
            observation.catalog_result_schema_sha256,
            loom_exec_result_record_catalog_schema()) ||
        !loom_exec_result_record_equal(
            observation.record_schema_sha256,
            loom_exec_result_record_schema()) {
        return 572
    }
    if observation.operation_projected != 1 ||
        observation.source_digest_present != 1 ||
        observation.compiler_digest_present != 1 ||
        observation.argv_digest_present != 1 ||
        observation.exit_success != 1 ||
        observation.artifact_digest_present != 1 ||
        observation.artifact_bytes_positive != 1 ||
        observation.diagnostic_digests_present != 1 {
        return 573
    }
    if observation.generation_digest_present != 1 ||
        observation.event_digest_present != 1 ||
        observation.command_digest_present != 1 ||
        observation.sandbox_digest_present != 1 ||
        observation.dynamic_user != 1 || observation.grant_consumed != 1 ||
        observation.descriptor_bound != 1 ||
        observation.principal_distinct != 1 || observation.direct_exec != 1 {
        return 574
    }
    if observation.shell_absent != 1 || observation.python_absent != 1 ||
        observation.rust_absent != 1 {
        return 575
    }
    if observation.record_immutable != 1 || observation.record_read_only != 1 ||
        observation.handle_non_bearer != 1 ||
        observation.handle_not_execution_authority != 1 ||
        observation.provenance_complete != 1 ||
        observation.raw_event_separate != 1 ||
        observation.sabotage_required <= 0 ||
        observation.sabotage_count < observation.sabotage_required {
        return 576
    }
    // Causal control: deleting only this comparison must admit the unchanged
    // artifact-binding mismatch witness.
    if observation.artifact_bound_to_record != 1 {
        return 577
    }
    1
}

fn loom_exec_result_record_bit(mask: i64, divisor: i64) -> i64 with Div {
    (mask / divisor) % 2
}

pub fn judge_loom_exec_result_record_v1_words(
    word0: i64,
    word1: i64,
) -> i64 with Div {
    let observation = LoomExecResultRecordObservation {
        stage: word0 & 3,
        preregistered: (word0 >> 2) & 1,
        operation: (word0 >> 3) & 3,
        catalog_sha256: if loom_exec_result_record_bit(word0, 32) == 1 {
            loom_exec_result_record_catalog()
        } else { loom_exec_result_record_zero() },
        catalog_result_schema_sha256:
            if loom_exec_result_record_bit(word0, 64) == 1 {
                loom_exec_result_record_catalog_schema()
            } else { loom_exec_result_record_zero() },
        record_schema_sha256:
            if loom_exec_result_record_bit(word0, 128) == 1 {
                loom_exec_result_record_schema()
            } else { loom_exec_result_record_zero() },
        operation_projected: loom_exec_result_record_bit(word0, 256),
        source_digest_present: loom_exec_result_record_bit(word0, 512),
        compiler_digest_present: loom_exec_result_record_bit(word0, 1024),
        argv_digest_present: loom_exec_result_record_bit(word0, 2048),
        exit_success: loom_exec_result_record_bit(word0, 4096),
        artifact_digest_present: loom_exec_result_record_bit(word0, 8192),
        artifact_bytes_positive: loom_exec_result_record_bit(word0, 16384),
        diagnostic_digests_present: loom_exec_result_record_bit(word0, 32768),
        generation_digest_present: loom_exec_result_record_bit(word0, 65536),
        event_digest_present: loom_exec_result_record_bit(word0, 131072),
        command_digest_present: loom_exec_result_record_bit(word0, 262144),
        sandbox_digest_present: loom_exec_result_record_bit(word0, 524288),
        dynamic_user: loom_exec_result_record_bit(word0, 1048576),
        grant_consumed: loom_exec_result_record_bit(word0, 2097152),
        descriptor_bound: loom_exec_result_record_bit(word0, 4194304),
        principal_distinct: loom_exec_result_record_bit(word0, 8388608),
        direct_exec: loom_exec_result_record_bit(word0, 16777216),
        shell_absent: loom_exec_result_record_bit(word0, 33554432),
        python_absent: loom_exec_result_record_bit(word0, 67108864),
        rust_absent: loom_exec_result_record_bit(word0, 134217728),
        artifact_bound_to_record: loom_exec_result_record_bit(word0, 268435456),
        semantic_authority_sounio: loom_exec_result_record_bit(word1, 1),
        result_schema_sounio: loom_exec_result_record_bit(word1, 2),
        record_immutable: loom_exec_result_record_bit(word1, 4),
        record_read_only: loom_exec_result_record_bit(word1, 8),
        handle_non_bearer: loom_exec_result_record_bit(word1, 16),
        handle_not_execution_authority: loom_exec_result_record_bit(word1, 32),
        provenance_complete: loom_exec_result_record_bit(word1, 64),
        raw_event_separate: loom_exec_result_record_bit(word1, 128),
        expected_result_absent_from_material:
            loom_exec_result_record_bit(word1, 256),
        review_unpromoted: loom_exec_result_record_bit(word1, 512),
        parity_unpromoted: loom_exec_result_record_bit(word1, 1024),
        sabotage_count: (word1 >> 11) & 7,
        sabotage_required: (word1 >> 14) & 7,
    }
    judge_loom_exec_result_record(observation)
}

fn loom_exec_result_record_case(case_index: i64) -> i64 with Div {
    let positive: i64 = 1073741815
    let evidence: i64 = 75775
    if case_index == 1 {
        return judge_loom_exec_result_record_v1_words(positive, evidence)
    }
    if case_index == 2 {
        return judge_loom_exec_result_record_v1_words(positive - 1, evidence)
    }
    if case_index == 3 {
        return judge_loom_exec_result_record_v1_words(positive, evidence - 1)
    }
    if case_index == 4 {
        return judge_loom_exec_result_record_v1_words(positive - 64, evidence)
    }
    if case_index == 5 {
        return judge_loom_exec_result_record_v1_words(positive - 8192, evidence)
    }
    if case_index == 6 {
        return judge_loom_exec_result_record_v1_words(positive - 2097152, evidence)
    }
    if case_index == 7 {
        return judge_loom_exec_result_record_v1_words(positive - 33554432, evidence)
    }
    if case_index == 8 {
        return judge_loom_exec_result_record_v1_words(positive, evidence - 4)
    }
    if case_index == 9 {
        return judge_loom_exec_result_record_v1_words(
            positive - 268435456, evidence)
    }
    424
}

pub fn loom_exec_result_record_selftest() -> i64 with Div {
    if loom_exec_result_record_case(1) != 1 { return 1 }
    if loom_exec_result_record_case(2) != 570 { return 2 }
    if loom_exec_result_record_case(3) != 571 { return 3 }
    if loom_exec_result_record_case(4) != 572 { return 4 }
    if loom_exec_result_record_case(5) != 573 { return 5 }
    if loom_exec_result_record_case(6) != 574 { return 6 }
    if loom_exec_result_record_case(7) != 575 { return 7 }
    if loom_exec_result_record_case(8) != 576 { return 8 }
    if loom_exec_result_record_case(9) != 577 { return 9 }
    0
}
