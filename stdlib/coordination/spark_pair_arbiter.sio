//! Sounio authority for the Spark Pair Arbiter transition policy.
//!
//! Kubernetes, Slurm, Slinky, and NVML are host observation surfaces. They do
//! not define expected transitions. A host adapter submits a complete fact
//! frame; this module alone admits or refuses the next pair state.

pub struct SparkPairAuthorityFacts {
    canonical: bool,
    policy_present: bool,
    policy_error: bool,
    operation_timed_out: bool,
    holder_matches: bool,
    lease_live: bool,
    pair_identity_exact: bool,
    nodeset_generation_matches: bool,
    device_plugin_exclusive: bool,
    admission_fail_closed: bool,
    pair_taint_exact: bool,
}

pub struct SparkPairSlurmFacts {
    canonical: bool,
    slurmd_gpu_request_exact: bool,
    slurm_controller_ready: bool,
    both_slurm_drained: bool,
    active_jobs_zero: bool,
    allocations_zero: bool,
    both_slurmd_absent: bool,
    both_slurmd_gpu_bound: bool,
    resume_verified: bool,
}

pub struct SparkPairK8sFacts {
    canonical: bool,
    both_gpu_capacity_one: bool,
    reservations_two: bool,
    reservation_count_zero: bool,
    reservations_distinct_nodes: bool,
    reservation_epoch_matches: bool,
    both_nvml_clean: bool,
    workload_count_zero: bool,
    stale_epoch_workload_zero: bool,
    heartbeat_fresh: bool,
    unexpected_k8s_gpu_consumers_zero: bool,
}

pub struct SparkPairHostFacts {
    canonical: bool,
    fence_pair_exact: bool,
    boot_pair_bound: bool,
    epoch_relation_valid: bool,
    owner_relation_valid: bool,
    deadman_armed: bool,
    runtime_gpu_gate_fail_closed: bool,
    legacy_gpu_inventory_exact: bool,
    managed_gpu_services_quiesced: bool,
    managed_gpu_restarts_blocked: bool,
    active_docker_gpu_claims_zero: bool,
    gpu_consumer_set_exact: bool,
    managed_gpu_cgroups_empty: bool,
    live_memory_floor_met: bool,
    protected_resources_unchanged: bool,
    host_receipts_two: bool,
    host_heartbeat_fresh: bool,
    device_barrier_relation_valid: bool,
}

pub struct SparkPairDecision {
    allowed: bool,
    current_state: i64,
    next_state: i64,
    reason: i64,
}

fn pair_bit_is_canonical(value: i64) -> bool {
    value >= 0 && value <= 1
}

fn pair_bool(value: i64) -> bool {
    value == 1
}

pub fn admit_spark_pair_authority_facts(
    policy_present: i64,
    policy_error: i64,
    operation_timed_out: i64,
    holder_matches: i64,
    lease_live: i64,
    pair_identity_exact: i64,
    nodeset_generation_matches: i64,
    device_plugin_exclusive: i64,
    admission_fail_closed: i64,
    pair_taint_exact: i64,
) -> SparkPairAuthorityFacts {
    SparkPairAuthorityFacts {
        canonical:
            pair_bit_is_canonical(policy_present) &&
            pair_bit_is_canonical(policy_error) &&
            pair_bit_is_canonical(operation_timed_out) &&
            pair_bit_is_canonical(holder_matches) &&
            pair_bit_is_canonical(lease_live) &&
            pair_bit_is_canonical(pair_identity_exact) &&
            pair_bit_is_canonical(nodeset_generation_matches) &&
            pair_bit_is_canonical(device_plugin_exclusive) &&
            pair_bit_is_canonical(admission_fail_closed) &&
            pair_bit_is_canonical(pair_taint_exact),
        policy_present: pair_bool(policy_present),
        policy_error: pair_bool(policy_error),
        operation_timed_out: pair_bool(operation_timed_out),
        holder_matches: pair_bool(holder_matches),
        lease_live: pair_bool(lease_live),
        pair_identity_exact: pair_bool(pair_identity_exact),
        nodeset_generation_matches: pair_bool(nodeset_generation_matches),
        device_plugin_exclusive: pair_bool(device_plugin_exclusive),
        admission_fail_closed: pair_bool(admission_fail_closed),
        pair_taint_exact: pair_bool(pair_taint_exact),
    }
}

pub fn admit_spark_pair_slurm_facts(
    slurmd_gpu_request_exact: i64,
    slurm_controller_ready: i64,
    both_slurm_drained: i64,
    active_jobs_zero: i64,
    allocations_zero: i64,
    both_slurmd_absent: i64,
    both_slurmd_gpu_bound: i64,
    resume_verified: i64,
) -> SparkPairSlurmFacts {
    SparkPairSlurmFacts {
        canonical:
            pair_bit_is_canonical(slurmd_gpu_request_exact) &&
            pair_bit_is_canonical(slurm_controller_ready) &&
            pair_bit_is_canonical(both_slurm_drained) &&
            pair_bit_is_canonical(active_jobs_zero) &&
            pair_bit_is_canonical(allocations_zero) &&
            pair_bit_is_canonical(both_slurmd_absent) &&
            pair_bit_is_canonical(both_slurmd_gpu_bound) &&
            pair_bit_is_canonical(resume_verified),
        slurmd_gpu_request_exact: pair_bool(slurmd_gpu_request_exact),
        slurm_controller_ready: pair_bool(slurm_controller_ready),
        both_slurm_drained: pair_bool(both_slurm_drained),
        active_jobs_zero: pair_bool(active_jobs_zero),
        allocations_zero: pair_bool(allocations_zero),
        both_slurmd_absent: pair_bool(both_slurmd_absent),
        both_slurmd_gpu_bound: pair_bool(both_slurmd_gpu_bound),
        resume_verified: pair_bool(resume_verified),
    }
}

pub fn admit_spark_pair_k8s_facts(
    both_gpu_capacity_one: i64,
    reservations_two: i64,
    reservation_count_zero: i64,
    reservations_distinct_nodes: i64,
    reservation_epoch_matches: i64,
    both_nvml_clean: i64,
    workload_count_zero: i64,
    stale_epoch_workload_zero: i64,
    heartbeat_fresh: i64,
    unexpected_k8s_gpu_consumers_zero: i64,
) -> SparkPairK8sFacts {
    SparkPairK8sFacts {
        canonical:
            pair_bit_is_canonical(both_gpu_capacity_one) &&
            pair_bit_is_canonical(reservations_two) &&
            pair_bit_is_canonical(reservation_count_zero) &&
            pair_bit_is_canonical(reservations_distinct_nodes) &&
            pair_bit_is_canonical(reservation_epoch_matches) &&
            pair_bit_is_canonical(both_nvml_clean) &&
            pair_bit_is_canonical(workload_count_zero) &&
            pair_bit_is_canonical(stale_epoch_workload_zero) &&
            pair_bit_is_canonical(heartbeat_fresh) &&
            pair_bit_is_canonical(unexpected_k8s_gpu_consumers_zero),
        both_gpu_capacity_one: pair_bool(both_gpu_capacity_one),
        reservations_two: pair_bool(reservations_two),
        reservation_count_zero: pair_bool(reservation_count_zero),
        reservations_distinct_nodes: pair_bool(reservations_distinct_nodes),
        reservation_epoch_matches: pair_bool(reservation_epoch_matches),
        both_nvml_clean: pair_bool(both_nvml_clean),
        workload_count_zero: pair_bool(workload_count_zero),
        stale_epoch_workload_zero: pair_bool(stale_epoch_workload_zero),
        heartbeat_fresh: pair_bool(heartbeat_fresh),
        unexpected_k8s_gpu_consumers_zero: pair_bool(unexpected_k8s_gpu_consumers_zero),
    }
}

pub fn admit_spark_pair_host_facts(
    fence_pair_exact: i64,
    boot_pair_bound: i64,
    epoch_relation_valid: i64,
    owner_relation_valid: i64,
    deadman_armed: i64,
    runtime_gpu_gate_fail_closed: i64,
    legacy_gpu_inventory_exact: i64,
    managed_gpu_services_quiesced: i64,
    managed_gpu_restarts_blocked: i64,
    active_docker_gpu_claims_zero: i64,
    gpu_consumer_set_exact: i64,
    managed_gpu_cgroups_empty: i64,
    live_memory_floor_met: i64,
    protected_resources_unchanged: i64,
    host_receipts_two: i64,
    host_heartbeat_fresh: i64,
    device_barrier_relation_valid: i64,
) -> SparkPairHostFacts {
    SparkPairHostFacts {
        canonical:
            pair_bit_is_canonical(fence_pair_exact) &&
            pair_bit_is_canonical(boot_pair_bound) &&
            pair_bit_is_canonical(epoch_relation_valid) &&
            pair_bit_is_canonical(owner_relation_valid) &&
            pair_bit_is_canonical(deadman_armed) &&
            pair_bit_is_canonical(runtime_gpu_gate_fail_closed) &&
            pair_bit_is_canonical(legacy_gpu_inventory_exact) &&
            pair_bit_is_canonical(managed_gpu_services_quiesced) &&
            pair_bit_is_canonical(managed_gpu_restarts_blocked) &&
            pair_bit_is_canonical(active_docker_gpu_claims_zero) &&
            pair_bit_is_canonical(gpu_consumer_set_exact) &&
            pair_bit_is_canonical(managed_gpu_cgroups_empty) &&
            pair_bit_is_canonical(live_memory_floor_met) &&
            pair_bit_is_canonical(protected_resources_unchanged) &&
            pair_bit_is_canonical(host_receipts_two) &&
            pair_bit_is_canonical(host_heartbeat_fresh) &&
            pair_bit_is_canonical(device_barrier_relation_valid),
        fence_pair_exact: pair_bool(fence_pair_exact),
        boot_pair_bound: pair_bool(boot_pair_bound),
        epoch_relation_valid: pair_bool(epoch_relation_valid),
        owner_relation_valid: pair_bool(owner_relation_valid),
        deadman_armed: pair_bool(deadman_armed),
        runtime_gpu_gate_fail_closed: pair_bool(runtime_gpu_gate_fail_closed),
        legacy_gpu_inventory_exact: pair_bool(legacy_gpu_inventory_exact),
        managed_gpu_services_quiesced: pair_bool(managed_gpu_services_quiesced),
        managed_gpu_restarts_blocked: pair_bool(managed_gpu_restarts_blocked),
        active_docker_gpu_claims_zero: pair_bool(active_docker_gpu_claims_zero),
        gpu_consumer_set_exact: pair_bool(gpu_consumer_set_exact),
        managed_gpu_cgroups_empty: pair_bool(managed_gpu_cgroups_empty),
        live_memory_floor_met: pair_bool(live_memory_floor_met),
        protected_resources_unchanged: pair_bool(protected_resources_unchanged),
        host_receipts_two: pair_bool(host_receipts_two),
        host_heartbeat_fresh: pair_bool(host_heartbeat_fresh),
        device_barrier_relation_valid: pair_bool(device_barrier_relation_valid),
    }
}

fn pair_allow(current_state: i64, next_state: i64) -> SparkPairDecision {
    SparkPairDecision {
        allowed: true,
        current_state: current_state,
        next_state: next_state,
        reason: 0,
    }
}

fn pair_refuse(current_state: i64, reason: i64) -> SparkPairDecision {
    SparkPairDecision {
        allowed: false,
        current_state: current_state,
        next_state: current_state,
        reason: reason,
    }
}

fn pair_host_exclusion_reason(host: SparkPairHostFacts) -> i64 {
    if !host.fence_pair_exact { return 128 }
    if !host.boot_pair_bound { return 129 }
    if !host.epoch_relation_valid { return 130 }
    if !host.owner_relation_valid { return 131 }
    if !host.deadman_armed { return 132 }
    if !host.runtime_gpu_gate_fail_closed { return 133 }
    if !host.legacy_gpu_inventory_exact { return 134 }
    if !host.managed_gpu_services_quiesced { return 135 }
    if !host.managed_gpu_restarts_blocked { return 136 }
    if !host.active_docker_gpu_claims_zero { return 137 }
    if !host.gpu_consumer_set_exact { return 138 }
    if !host.managed_gpu_cgroups_empty { return 139 }
    if !host.live_memory_floor_met { return 140 }
    if !host.protected_resources_unchanged { return 141 }
    if !host.host_receipts_two { return 142 }
    if !host.host_heartbeat_fresh { return 143 }
    if !host.device_barrier_relation_valid { return 144 }
    0
}

fn pair_host_handoff_reason(host: SparkPairHostFacts) -> i64 {
    pair_host_exclusion_reason(host)
}

fn pair_host_control_reason(host: SparkPairHostFacts) -> i64 {
    if !host.fence_pair_exact { return 128 }
    if !host.boot_pair_bound { return 129 }
    if !host.deadman_armed { return 132 }
    if !host.runtime_gpu_gate_fail_closed { return 133 }
    if !host.legacy_gpu_inventory_exact { return 134 }
    if !host.protected_resources_unchanged { return 141 }
    if !host.host_receipts_two { return 142 }
    if !host.device_barrier_relation_valid { return 144 }
    0
}

fn pair_state_is_known(state: i64) -> bool {
    state >= 0 && state <= 10
}

pub fn decide_spark_pair_transition(
    action: i64,
    current_state: i64,
    epoch: i64,
    observed_epoch: i64,
    authority: SparkPairAuthorityFacts,
    slurm: SparkPairSlurmFacts,
    k8s: SparkPairK8sFacts,
    host: SparkPairHostFacts,
) -> SparkPairDecision {
    if !authority.canonical || !slurm.canonical || !k8s.canonical || !host.canonical {
        return pair_refuse(current_state, 104)
    }
    if k8s.reservations_two && k8s.reservation_count_zero {
        return pair_refuse(current_state, 104)
    }
    if !pair_state_is_known(current_state) { return pair_refuse(current_state, 105) }
    if !authority.policy_present { return pair_refuse(current_state, 101) }
    if authority.policy_error { return pair_refuse(current_state, 102) }
    if authority.operation_timed_out { return pair_refuse(current_state, 103) }
    if !authority.pair_identity_exact { return pair_refuse(current_state, 109) }
    if epoch <= 0 { return pair_refuse(current_state, 107) }

    // Entering recovery is the only transition that remains admissible after
    // Lease loss. It authorizes no user work and cannot resume Slurm.
    if action == 11 {
        if current_state >= 1 && current_state <= 10 {
            return pair_allow(current_state, 10)
        }
        return pair_refuse(current_state, 105)
    }

    // A failed installation stays UNINITIALIZED. After Lease expiry, only
    // this action may take over that journaled bootstrap and retry its steps.
    if action == 27 {
        if current_state == 0 { return pair_allow(current_state, 0) }
        return pair_refuse(current_state, 105)
    }

    // Initial materialization has no Lease yet. It may create only the
    // UNINITIALIZED Lease/journal after the pair is exact and idle.
    if action == 28 {
        if current_state != 0 { return pair_refuse(current_state, 105) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.active_jobs_zero { return pair_refuse(current_state, 115) }
        if !slurm.allocations_zero { return pair_refuse(current_state, 116) }
        if !k8s.unexpected_k8s_gpu_consumers_zero { return pair_refuse(current_state, 127) }
        return pair_allow(current_state, 0)
    }

    if observed_epoch != epoch { return pair_refuse(current_state, 107) }

    // Status is read-only. It reports the frozen policy decision surface even
    // when the caller is not the current Lease holder.
    if action == 14 {
        return pair_allow(current_state, current_state)
    }

    if !authority.holder_matches { return pair_refuse(current_state, 106) }
    if !authority.lease_live { return pair_refuse(current_state, 108) }

    if action == 1 {
        if current_state != 0 { return pair_refuse(current_state, 105) }
        if !authority.nodeset_generation_matches { return pair_refuse(current_state, 110) }
        if !slurm.slurmd_gpu_request_exact { return pair_refuse(current_state, 111) }
        if !authority.device_plugin_exclusive { return pair_refuse(current_state, 112) }
        if !authority.admission_fail_closed { return pair_refuse(current_state, 125) }
        if !authority.pair_taint_exact { return pair_refuse(current_state, 126) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.both_slurmd_gpu_bound { return pair_refuse(current_state, 117) }
        if !k8s.both_gpu_capacity_one { return pair_refuse(current_state, 118) }
        if !slurm.resume_verified { return pair_refuse(current_state, 123) }
        if !k8s.unexpected_k8s_gpu_consumers_zero { return pair_refuse(current_state, 127) }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 1)
    }

    // Bootstrap effects are admitted one at a time while the Lease remains
    // UNINITIALIZED. None of these actions authorizes a user workload.
    if action == 23 {
        if current_state != 0 { return pair_refuse(current_state, 105) }
        if !authority.nodeset_generation_matches { return pair_refuse(current_state, 110) }
        if !authority.admission_fail_closed { return pair_refuse(current_state, 125) }
        if !authority.pair_taint_exact { return pair_refuse(current_state, 126) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !k8s.unexpected_k8s_gpu_consumers_zero { return pair_refuse(current_state, 127) }
        let host_reason = pair_host_control_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 0)
    }

    if action == 24 {
        if current_state != 0 { return pair_refuse(current_state, 105) }
        if !authority.nodeset_generation_matches { return pair_refuse(current_state, 110) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.active_jobs_zero { return pair_refuse(current_state, 115) }
        if !slurm.allocations_zero { return pair_refuse(current_state, 116) }
        if !k8s.unexpected_k8s_gpu_consumers_zero { return pair_refuse(current_state, 127) }
        return pair_allow(current_state, 0)
    }

    if action == 25 {
        if current_state != 0 { return pair_refuse(current_state, 105) }
        if !authority.admission_fail_closed { return pair_refuse(current_state, 125) }
        if !authority.pair_taint_exact { return pair_refuse(current_state, 126) }
        if !authority.device_plugin_exclusive { return pair_refuse(current_state, 112) }
        if !slurm.both_slurm_drained { return pair_refuse(current_state, 114) }
        if !slurm.active_jobs_zero { return pair_refuse(current_state, 115) }
        if !slurm.allocations_zero { return pair_refuse(current_state, 116) }
        if !k8s.unexpected_k8s_gpu_consumers_zero { return pair_refuse(current_state, 127) }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 0)
    }

    if action == 26 {
        if current_state != 0 { return pair_refuse(current_state, 105) }
        if !authority.admission_fail_closed { return pair_refuse(current_state, 125) }
        if !authority.pair_taint_exact { return pair_refuse(current_state, 126) }
        if !slurm.slurmd_gpu_request_exact { return pair_refuse(current_state, 111) }
        if !slurm.both_slurmd_gpu_bound { return pair_refuse(current_state, 117) }
        if !k8s.reservation_count_zero { return pair_refuse(current_state, 119) }
        if !k8s.unexpected_k8s_gpu_consumers_zero { return pair_refuse(current_state, 127) }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 0)
    }

    if action == 2 {
        if current_state != 1 { return pair_refuse(current_state, 105) }
        if !authority.nodeset_generation_matches { return pair_refuse(current_state, 110) }
        if !slurm.slurmd_gpu_request_exact { return pair_refuse(current_state, 111) }
        if !authority.device_plugin_exclusive { return pair_refuse(current_state, 112) }
        if !authority.admission_fail_closed { return pair_refuse(current_state, 125) }
        if !authority.pair_taint_exact { return pair_refuse(current_state, 126) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.both_slurmd_gpu_bound { return pair_refuse(current_state, 117) }
        if !k8s.both_gpu_capacity_one { return pair_refuse(current_state, 118) }
        if !k8s.unexpected_k8s_gpu_consumers_zero { return pair_refuse(current_state, 127) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 2)
    }

    if action == 3 {
        if current_state != 2 { return pair_refuse(current_state, 105) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.both_slurm_drained { return pair_refuse(current_state, 114) }
        if !slurm.active_jobs_zero { return pair_refuse(current_state, 115) }
        if !slurm.allocations_zero { return pair_refuse(current_state, 116) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 3)
    }

    if action == 4 {
        if current_state != 3 { return pair_refuse(current_state, 105) }
        if !slurm.both_slurm_drained { return pair_refuse(current_state, 114) }
        if !slurm.active_jobs_zero { return pair_refuse(current_state, 115) }
        if !slurm.allocations_zero { return pair_refuse(current_state, 116) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 4)
    }

    if action == 5 {
        if current_state != 4 { return pair_refuse(current_state, 105) }
        if !slurm.both_slurmd_absent { return pair_refuse(current_state, 117) }
        if !k8s.both_gpu_capacity_one { return pair_refuse(current_state, 118) }
        if !authority.device_plugin_exclusive { return pair_refuse(current_state, 112) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 5)
    }

    if action == 6 {
        if current_state != 5 { return pair_refuse(current_state, 105) }
        if !slurm.both_slurmd_absent { return pair_refuse(current_state, 117) }
        if !k8s.both_gpu_capacity_one { return pair_refuse(current_state, 118) }
        if !authority.device_plugin_exclusive { return pair_refuse(current_state, 112) }
        if !k8s.reservations_two || !k8s.reservations_distinct_nodes ||
            !k8s.reservation_epoch_matches {
            return pair_refuse(current_state, 119)
        }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 6)
    }

    if action == 7 {
        if current_state != 6 { return pair_refuse(current_state, 105) }
        if !k8s.heartbeat_fresh { return pair_refuse(current_state, 122) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 6)
    }

    if action == 8 {
        if current_state != 6 { return pair_refuse(current_state, 105) }
        return pair_allow(current_state, 7)
    }

    if action == 9 {
        if current_state != 7 { return pair_refuse(current_state, 105) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        if !k8s.reservations_two || !k8s.reservations_distinct_nodes ||
            !k8s.reservation_epoch_matches {
            return pair_refuse(current_state, 119)
        }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 8)
    }

    if action == 10 {
        if current_state != 8 { return pair_refuse(current_state, 105) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 9)
    }

    if action == 12 {
        if current_state != 9 { return pair_refuse(current_state, 105) }
        if !k8s.reservation_count_zero { return pair_refuse(current_state, 119) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.slurmd_gpu_request_exact { return pair_refuse(current_state, 111) }
        if !slurm.both_slurmd_gpu_bound { return pair_refuse(current_state, 117) }
        if !k8s.both_gpu_capacity_one { return pair_refuse(current_state, 118) }
        if !slurm.active_jobs_zero { return pair_refuse(current_state, 115) }
        if !slurm.allocations_zero { return pair_refuse(current_state, 116) }
        if !slurm.resume_verified { return pair_refuse(current_state, 123) }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 1)
    }

    if action == 13 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        if !k8s.reservation_count_zero { return pair_refuse(current_state, 119) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.slurmd_gpu_request_exact { return pair_refuse(current_state, 111) }
        if !slurm.both_slurmd_gpu_bound { return pair_refuse(current_state, 117) }
        if !slurm.resume_verified { return pair_refuse(current_state, 123) }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 1)
    }

    if action == 15 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        return pair_allow(current_state, 10)
    }

    if action == 16 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        if !k8s.reservations_two || !k8s.reservations_distinct_nodes ||
            !k8s.reservation_epoch_matches {
            return pair_refuse(current_state, 119)
        }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 10)
    }

    if action == 17 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        if !k8s.reservations_two || !k8s.reservations_distinct_nodes ||
            !k8s.reservation_epoch_matches {
            return pair_refuse(current_state, 119)
        }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 10)
    }

    if action == 18 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        if !k8s.reservation_count_zero { return pair_refuse(current_state, 119) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 10)
    }

    if action == 19 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        if !k8s.reservation_count_zero { return pair_refuse(current_state, 119) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.slurmd_gpu_request_exact { return pair_refuse(current_state, 111) }
        if !slurm.both_slurmd_gpu_bound { return pair_refuse(current_state, 117) }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 10)
    }

    if action == 20 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        if !slurm.both_slurm_drained { return pair_refuse(current_state, 114) }
        if !slurm.active_jobs_zero { return pair_refuse(current_state, 115) }
        if !slurm.allocations_zero { return pair_refuse(current_state, 116) }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 10)
    }

    if action == 21 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !slurm.both_slurmd_absent { return pair_refuse(current_state, 117) }
        if !k8s.both_gpu_capacity_one { return pair_refuse(current_state, 118) }
        if !authority.device_plugin_exclusive { return pair_refuse(current_state, 112) }
        if !k8s.reservation_count_zero { return pair_refuse(current_state, 119) }
        if !k8s.workload_count_zero || !k8s.stale_epoch_workload_zero {
            return pair_refuse(current_state, 121)
        }
        let host_reason = pair_host_exclusion_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 10)
    }

    if action == 22 {
        if current_state != 10 { return pair_refuse(current_state, 105) }
        if !slurm.slurm_controller_ready { return pair_refuse(current_state, 113) }
        let host_reason = pair_host_control_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, 10)
    }

    // Bootstrap and recovery may install or repair the host fence before any
    // scheduler is handed the pair. This action authorizes no workload.
    if action == 29 {
        if current_state == 0 || current_state == 10 {
            return pair_allow(current_state, current_state)
        }
        return pair_refuse(current_state, 105)
    }

    // Fencing is an idempotent fail-closed effect. It may run only in states
    // where neither scheduler is being granted new work.
    if action == 30 {
        if current_state != 0 && current_state != 1 && current_state != 2 && current_state != 3 &&
            current_state != 7 && current_state != 8 && current_state != 10 {
            return pair_refuse(current_state, 105)
        }
        if !slurm.active_jobs_zero || !slurm.allocations_zero {
            return pair_refuse(current_state, 115)
        }
        if (current_state == 7 || current_state == 8) &&
            (!k8s.workload_count_zero || !k8s.stale_epoch_workload_zero) {
            return pair_refuse(current_state, 121)
        }
        let host_reason = pair_host_control_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, current_state)
    }

    // Grants are same-state material effects. Scheduler transitions remain
    // separate, so a partial pair grant cannot be mistaken for ownership.
    if action == 31 {
        if current_state != 0 && current_state != 9 && current_state != 10 {
            return pair_refuse(current_state, 105)
        }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, current_state)
    }

    if action == 32 {
        if current_state != 3 && current_state != 4 && current_state != 5 &&
            current_state != 6 {
            return pair_refuse(current_state, 105)
        }
        let host_reason = pair_host_handoff_reason(host)
        if host_reason != 0 { return pair_refuse(current_state, host_reason) }
        return pair_allow(current_state, current_state)
    }

    pair_refuse(current_state, 124)
}

pub fn spark_pair_decision_allowed(decision: SparkPairDecision) -> bool {
    decision.allowed
}

pub fn spark_pair_decision_current_state(decision: SparkPairDecision) -> i64 {
    decision.current_state
}

pub fn spark_pair_decision_next_state(decision: SparkPairDecision) -> i64 {
    decision.next_state
}

pub fn spark_pair_decision_reason(decision: SparkPairDecision) -> i64 {
    decision.reason
}
