//! LOOM action 9048: generation-pinned native-hook cutover authority.

pub struct LoomGenerationPinnedCutoverObservation {
    pub mode: i64,
    pub stage: i64,
    pub parent_9046_frozen: i64,
    pub parent_9047_frozen: i64,
    pub generation_identity_bound: i64,
    pub kernel_identity_bound: i64,
    pub runtime_installed_bound: i64,
    pub runtime_manifest_bound: i64,
    pub runtime_executables_bound: i64,
    pub state_lock_held: i64,
    pub install_lock_held: i64,
    pub inventory_complete: i64,
    pub selectors_bound: i64,
    pub source_presence_bound: i64,
    pub pin_destination_new: i64,
    pub pin_existing_exact: i64,
    pub decision_receipt_ready: i64,
    pub fail_closed: i64,
    pub python_oracle_absent: i64,
    pub rust_oracle_absent: i64,
    pub disposable_oracle_absent: i64,
    pub pre_cutover: i64,
    pub current_is_recorded_old: i64,
    pub candidate_not_current: i64,
    pub one_hop: i64,
    pub all_pins_probed: i64,
    pub sealed_observations_unchanged: i64,
    pub identity_hash0: i64,
    pub identity_hash1: i64,
    pub runtime_hash0: i64,
    pub runtime_hash1: i64,
    pub transaction_hash: i64,
    pub sabotage_count: i64,
    pub sabotage_required: i64,
}

fn pin_fact(word: i64, shift: i64) -> i64 { (word >> shift) & 1 }

pub fn loom_generation_pinned_cutover_observation_from_words(
    mode: i64, stage: i64, word: i64,
    identity_hash0: i64, identity_hash1: i64,
    runtime_hash0: i64, runtime_hash1: i64, transaction_hash: i64,
    sabotage_count: i64, sabotage_required: i64,
) -> LoomGenerationPinnedCutoverObservation {
    LoomGenerationPinnedCutoverObservation {
        mode: mode, stage: stage,
        parent_9046_frozen: pin_fact(word, 0),
        parent_9047_frozen: pin_fact(word, 1),
        generation_identity_bound: pin_fact(word, 2),
        kernel_identity_bound: pin_fact(word, 3),
        runtime_installed_bound: pin_fact(word, 4),
        runtime_manifest_bound: pin_fact(word, 5),
        runtime_executables_bound: pin_fact(word, 6),
        state_lock_held: pin_fact(word, 7),
        install_lock_held: pin_fact(word, 8),
        inventory_complete: pin_fact(word, 9),
        selectors_bound: pin_fact(word, 10),
        source_presence_bound: pin_fact(word, 11),
        pin_destination_new: pin_fact(word, 12),
        pin_existing_exact: pin_fact(word, 13),
        decision_receipt_ready: pin_fact(word, 14),
        fail_closed: pin_fact(word, 15),
        python_oracle_absent: pin_fact(word, 16),
        rust_oracle_absent: pin_fact(word, 17),
        disposable_oracle_absent: pin_fact(word, 18),
        pre_cutover: pin_fact(word, 19),
        current_is_recorded_old: pin_fact(word, 20),
        candidate_not_current: pin_fact(word, 21),
        one_hop: pin_fact(word, 22),
        all_pins_probed: pin_fact(word, 23),
        sealed_observations_unchanged: pin_fact(word, 24),
        identity_hash0: identity_hash0, identity_hash1: identity_hash1,
        runtime_hash0: runtime_hash0, runtime_hash1: runtime_hash1,
        transaction_hash: transaction_hash,
        sabotage_count: sabotage_count, sabotage_required: sabotage_required,
    }
}

fn pin_base_bound(o: LoomGenerationPinnedCutoverObservation) -> bool {
    o.parent_9046_frozen == 1 && o.parent_9047_frozen == 1 &&
    o.generation_identity_bound == 1 && o.source_presence_bound == 1 &&
    (o.identity_hash0 != 0 || o.identity_hash1 != 0)
}

fn pin_runtime_bound(o: LoomGenerationPinnedCutoverObservation) -> bool {
    o.runtime_installed_bound == 1 && o.runtime_manifest_bound == 1 &&
    o.runtime_executables_bound == 1 &&
    (o.runtime_hash0 != 0 || o.runtime_hash1 != 0)
}

fn pin_oracles_absent(o: LoomGenerationPinnedCutoverObservation) -> bool {
    o.python_oracle_absent == 1 && o.rust_oracle_absent == 1 &&
    o.disposable_oracle_absent == 1 && o.sabotage_required >= 14 &&
    o.sabotage_count >= o.sabotage_required
}

// 1 SEALED_CAPABILITY, 2 SEALED_LEGACY, 3 CONTINUE, 4 FORWARD,
// 5 BIRTH_PINNED, 6 CUTOVER_READY.
pub fn judge_loom_generation_pinned_cutover(
    o: LoomGenerationPinnedCutoverObservation,
) -> i64 {
    if o.stage != 3 || o.parent_9046_frozen != 1 ||
        o.parent_9047_frozen != 1 { return 691 }
    if !pin_base_bound(o) { return 692 }
    if o.kernel_identity_bound != 1 || !pin_runtime_bound(o) { return 693 }
    if o.fail_closed != 1 || !pin_oracles_absent(o) { return 696 }

    if o.mode == 1 || o.mode == 2 || o.mode == 5 {
        if o.state_lock_held != 1 || o.inventory_complete != 1 ||
            o.selectors_bound != 1 { return 694 }
        if o.pin_destination_new != 1 || o.pin_existing_exact != 0 ||
            o.decision_receipt_ready != 1 || o.transaction_hash == 0 {
            return 695
        }
    }
    if o.mode == 1 { return 1 }
    if o.mode == 2 {
        if o.install_lock_held != 1 || o.pre_cutover != 1 ||
            o.current_is_recorded_old != 1 || o.candidate_not_current != 1 {
            return 697
        }
        return 2
    }
    if o.mode == 3 || o.mode == 4 {
        if o.pin_existing_exact != 1 || o.pin_destination_new != 0 ||
            o.one_hop != 1 { return 698 }
        if o.mode == 3 { return 3 }
        return 4
    }
    if o.mode == 5 {
        if o.pre_cutover != 0 { return 697 }
        return 5
    }
    if o.mode == 6 {
        if o.install_lock_held != 1 || o.inventory_complete != 1 ||
            o.selectors_bound != 1 || o.pin_existing_exact != 1 ||
            o.all_pins_probed != 1 || o.sealed_observations_unchanged != 1 ||
            o.decision_receipt_ready != 1 || o.transaction_hash == 0 {
            return 699
        }
        return 6
    }
    700
}

pub fn judge_loom_generation_pinned_cutover_words(
    mode: i64, stage: i64, word: i64,
    identity_hash0: i64, identity_hash1: i64,
    runtime_hash0: i64, runtime_hash1: i64, transaction_hash: i64,
    sabotage_count: i64, sabotage_required: i64,
) -> i64 {
    judge_loom_generation_pinned_cutover(
        loom_generation_pinned_cutover_observation_from_words(
            mode, stage, word, identity_hash0, identity_hash1,
            runtime_hash0, runtime_hash1, transaction_hash,
            sabotage_count, sabotage_required,
        ),
    )
}

pub fn loom_generation_pinned_cutover_selftest() -> i64 with Mut {
    var failed: i64 = 0
    // Full evidence permits each positive transition.
    if judge_loom_generation_pinned_cutover_words(1, 3, 33546239, 1, 2, 3, 4, 5, 14, 14) != 1 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(2, 3, 33546239, 1, 2, 3, 4, 5, 14, 14) != 2 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(3, 3, 33550335, 1, 2, 3, 4, 5, 14, 14) != 3 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(4, 3, 33550335, 1, 2, 3, 4, 5, 14, 14) != 4 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(5, 3, 33021951, 1, 2, 3, 4, 5, 14, 14) != 5 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(6, 3, 33554431, 1, 2, 3, 4, 5, 14, 14) != 6 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(1, 2, 33546239, 1, 2, 3, 4, 5, 14, 14) != 691 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(1, 3, 33546235, 1, 2, 3, 4, 5, 14, 14) != 692 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(1, 3, 33546231, 1, 2, 3, 4, 5, 14, 14) != 693 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(1, 3, 33545727, 1, 2, 3, 4, 5, 14, 14) != 694 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(1, 3, 33542143, 1, 2, 3, 4, 5, 14, 14) != 695 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(1, 3, 33480703, 1, 2, 3, 4, 5, 14, 14) != 696 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(2, 3, 33021951, 1, 2, 3, 4, 5, 14, 14) != 697 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(3, 3, 29356031, 1, 2, 3, 4, 5, 14, 14) != 698 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(6, 3, 25165823, 1, 2, 3, 4, 5, 14, 14) != 699 { failed = failed + 1 }
    if judge_loom_generation_pinned_cutover_words(7, 3, 33554431, 1, 2, 3, 4, 5, 14, 14) != 700 { failed = failed + 1 }
    failed
}
