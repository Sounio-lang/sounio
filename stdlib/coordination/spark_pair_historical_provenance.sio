//! Effect-free historical provenance authority for the canonical Spark pair.
//!
//! Frame 9028 decides whether an immutable source may support the pre-install
//! provenance fact consumed by frame 9027. It performs no capture, extraction,
//! replay, restore, cluster access, or material dispatch.

pub struct SparkPairHistoricalDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

pub struct SparkPairHistoricalAuthorityFacts {
    canonical: bool,
    policy_present: bool,
    policy_error: bool,
    operation_timed_out: bool,
    parent_9027_freeze_exact: bool,
    canonical_pair_identity_exact: bool,
    prior_decision_receipt_exact: bool,
    hash_algorithm_sha256: bool,
    canonical_serialization_exact: bool,
    digest_domains_distinct: bool,
    prior_receipt_digest_matches_bytes: bool,
    prior_receipt_is_allowed_bind_30_to_31: bool,
    prior_receipt_candidate_identity_exact: bool,
}

pub struct SparkPairHistoricalOrderingFacts {
    canonical: bool,
    historical_source_present: bool,
    first_install_anchor_exact: bool,
    source_digest_anchored_before_install: bool,
    capture_window_ends_before_install: bool,
    append_only_or_signed_sequence_exact: bool,
    source_immutable_since_anchor: bool,
    ordering_not_clock_only: bool,
    no_retrospective_reconstruction: bool,
}

pub struct SparkPairHistoricalCustodyFacts {
    canonical: bool,
    source_authority_exact: bool,
    producer_identity_exact: bool,
    source_custody_chain_exact: bool,
    source_storage_identity_exact: bool,
    source_access_receipt_exact: bool,
    producer_language_role_exact: bool,
    external_llm_review_only: bool,
    source_custody_conflict_zero: bool,
}

pub struct SparkPairHistoricalCompletenessFacts {
    canonical: bool,
    exactly_two_nodes: bool,
    ordered_node_pair_exact: bool,
    pair_manifest_binds_node_sources: bool,
    service_enablement_exact: bool,
    restart_linger_exact: bool,
    container_recreate_identity_exact: bool,
    nodeset_identity_exact: bool,
    device_plugin_identity_exact: bool,
    taints_exact: bool,
    labels_exact: bool,
    boot_identity_recorded_as_provenance: bool,
    protected_path_payloads_complete: bool,
    toolchain_hardware_commands_exact: bool,
    artifact_availability_exact: bool,
    ephemeral_fields_observation_only: bool,
    restore_targets_separated_from_observations: bool,
    no_unknown_or_implicit_fields: bool,
    source_conflicts_zero: bool,
    coverage_closure_exact: bool,
}

pub struct SparkPairHistoricalDecision {
    allowed: bool,
    current_state: i64,
    next_state: i64,
    reason: i64,
}

fn historical_bit_is_canonical(value: i64) -> bool {
    value == 0 || value == 1
}

fn historical_bool(value: i64) -> bool {
    value == 1
}

pub fn admit_spark_pair_historical_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> SparkPairHistoricalDigest256 {
    SparkPairHistoricalDigest256 {
        limb0: limb0, limb1: limb1, limb2: limb2, limb3: limb3,
        limb4: limb4, limb5: limb5, limb6: limb6, limb7: limb7,
    }
}

fn historical_digest_is_canonical(digest: SparkPairHistoricalDigest256) -> bool {
    digest.limb0 >= 0 && digest.limb0 <= 4294967295 &&
    digest.limb1 >= 0 && digest.limb1 <= 4294967295 &&
    digest.limb2 >= 0 && digest.limb2 <= 4294967295 &&
    digest.limb3 >= 0 && digest.limb3 <= 4294967295 &&
    digest.limb4 >= 0 && digest.limb4 <= 4294967295 &&
    digest.limb5 >= 0 && digest.limb5 <= 4294967295 &&
    digest.limb6 >= 0 && digest.limb6 <= 4294967295 &&
    digest.limb7 >= 0 && digest.limb7 <= 4294967295
}

fn historical_digest_is_nonzero(digest: SparkPairHistoricalDigest256) -> bool {
    digest.limb0 != 0 || digest.limb1 != 0 || digest.limb2 != 0 ||
    digest.limb3 != 0 || digest.limb4 != 0 || digest.limb5 != 0 ||
    digest.limb6 != 0 || digest.limb7 != 0
}

fn historical_digest_equal(
    left: SparkPairHistoricalDigest256,
    right: SparkPairHistoricalDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn historical_parent_9027_digest_is_exact(digest: SparkPairHistoricalDigest256) -> bool {
    digest.limb0 == 3520492115 && digest.limb1 == 895214558 &&
    digest.limb2 == 2869641135 && digest.limb3 == 100349012 &&
    digest.limb4 == 2545011085 && digest.limb5 == 4229296409 &&
    digest.limb6 == 1266186288 && digest.limb7 == 3862100816
}

pub fn admit_spark_pair_historical_authority_facts(
    policy_present: i64,
    policy_error: i64,
    operation_timed_out: i64,
    parent_9027_freeze_exact: i64,
    canonical_pair_identity_exact: i64,
    prior_decision_receipt_exact: i64,
    hash_algorithm_sha256: i64,
    canonical_serialization_exact: i64,
    digest_domains_distinct: i64,
    prior_receipt_digest_matches_bytes: i64,
    prior_receipt_is_allowed_bind_30_to_31: i64,
    prior_receipt_candidate_identity_exact: i64,
) -> SparkPairHistoricalAuthorityFacts {
    SparkPairHistoricalAuthorityFacts {
        canonical: historical_bit_is_canonical(policy_present) &&
            historical_bit_is_canonical(policy_error) &&
            historical_bit_is_canonical(operation_timed_out) &&
            historical_bit_is_canonical(parent_9027_freeze_exact) &&
            historical_bit_is_canonical(canonical_pair_identity_exact) &&
            historical_bit_is_canonical(prior_decision_receipt_exact) &&
            historical_bit_is_canonical(hash_algorithm_sha256) &&
            historical_bit_is_canonical(canonical_serialization_exact) &&
            historical_bit_is_canonical(digest_domains_distinct) &&
            historical_bit_is_canonical(prior_receipt_digest_matches_bytes) &&
            historical_bit_is_canonical(prior_receipt_is_allowed_bind_30_to_31) &&
            historical_bit_is_canonical(prior_receipt_candidate_identity_exact),
        policy_present: historical_bool(policy_present),
        policy_error: historical_bool(policy_error),
        operation_timed_out: historical_bool(operation_timed_out),
        parent_9027_freeze_exact: historical_bool(parent_9027_freeze_exact),
        canonical_pair_identity_exact: historical_bool(canonical_pair_identity_exact),
        prior_decision_receipt_exact: historical_bool(prior_decision_receipt_exact),
        hash_algorithm_sha256: historical_bool(hash_algorithm_sha256),
        canonical_serialization_exact: historical_bool(canonical_serialization_exact),
        digest_domains_distinct: historical_bool(digest_domains_distinct),
        prior_receipt_digest_matches_bytes: historical_bool(prior_receipt_digest_matches_bytes),
        prior_receipt_is_allowed_bind_30_to_31: historical_bool(prior_receipt_is_allowed_bind_30_to_31),
        prior_receipt_candidate_identity_exact: historical_bool(prior_receipt_candidate_identity_exact),
    }
}

pub fn admit_spark_pair_historical_ordering_facts(
    historical_source_present: i64,
    first_install_anchor_exact: i64,
    source_digest_anchored_before_install: i64,
    capture_window_ends_before_install: i64,
    append_only_or_signed_sequence_exact: i64,
    source_immutable_since_anchor: i64,
    ordering_not_clock_only: i64,
    no_retrospective_reconstruction: i64,
) -> SparkPairHistoricalOrderingFacts {
    SparkPairHistoricalOrderingFacts {
        canonical: historical_bit_is_canonical(historical_source_present) &&
            historical_bit_is_canonical(first_install_anchor_exact) &&
            historical_bit_is_canonical(source_digest_anchored_before_install) &&
            historical_bit_is_canonical(capture_window_ends_before_install) &&
            historical_bit_is_canonical(append_only_or_signed_sequence_exact) &&
            historical_bit_is_canonical(source_immutable_since_anchor) &&
            historical_bit_is_canonical(ordering_not_clock_only) &&
            historical_bit_is_canonical(no_retrospective_reconstruction),
        historical_source_present: historical_bool(historical_source_present),
        first_install_anchor_exact: historical_bool(first_install_anchor_exact),
        source_digest_anchored_before_install: historical_bool(source_digest_anchored_before_install),
        capture_window_ends_before_install: historical_bool(capture_window_ends_before_install),
        append_only_or_signed_sequence_exact: historical_bool(append_only_or_signed_sequence_exact),
        source_immutable_since_anchor: historical_bool(source_immutable_since_anchor),
        ordering_not_clock_only: historical_bool(ordering_not_clock_only),
        no_retrospective_reconstruction: historical_bool(no_retrospective_reconstruction),
    }
}

pub fn admit_spark_pair_historical_custody_facts(
    source_authority_exact: i64,
    producer_identity_exact: i64,
    source_custody_chain_exact: i64,
    source_storage_identity_exact: i64,
    source_access_receipt_exact: i64,
    producer_language_role_exact: i64,
    external_llm_review_only: i64,
    source_custody_conflict_zero: i64,
) -> SparkPairHistoricalCustodyFacts {
    SparkPairHistoricalCustodyFacts {
        canonical: historical_bit_is_canonical(source_authority_exact) &&
            historical_bit_is_canonical(producer_identity_exact) &&
            historical_bit_is_canonical(source_custody_chain_exact) &&
            historical_bit_is_canonical(source_storage_identity_exact) &&
            historical_bit_is_canonical(source_access_receipt_exact) &&
            historical_bit_is_canonical(producer_language_role_exact) &&
            historical_bit_is_canonical(external_llm_review_only) &&
            historical_bit_is_canonical(source_custody_conflict_zero),
        source_authority_exact: historical_bool(source_authority_exact),
        producer_identity_exact: historical_bool(producer_identity_exact),
        source_custody_chain_exact: historical_bool(source_custody_chain_exact),
        source_storage_identity_exact: historical_bool(source_storage_identity_exact),
        source_access_receipt_exact: historical_bool(source_access_receipt_exact),
        producer_language_role_exact: historical_bool(producer_language_role_exact),
        external_llm_review_only: historical_bool(external_llm_review_only),
        source_custody_conflict_zero: historical_bool(source_custody_conflict_zero),
    }
}

pub fn admit_spark_pair_historical_completeness_facts(
    exactly_two_nodes: i64,
    ordered_node_pair_exact: i64,
    pair_manifest_binds_node_sources: i64,
    service_enablement_exact: i64,
    restart_linger_exact: i64,
    container_recreate_identity_exact: i64,
    nodeset_identity_exact: i64,
    device_plugin_identity_exact: i64,
    taints_exact: i64,
    labels_exact: i64,
    boot_identity_recorded_as_provenance: i64,
    protected_path_payloads_complete: i64,
    toolchain_hardware_commands_exact: i64,
    artifact_availability_exact: i64,
    ephemeral_fields_observation_only: i64,
    restore_targets_separated_from_observations: i64,
    no_unknown_or_implicit_fields: i64,
    source_conflicts_zero: i64,
    coverage_closure_exact: i64,
) -> SparkPairHistoricalCompletenessFacts {
    SparkPairHistoricalCompletenessFacts {
        canonical: historical_bit_is_canonical(exactly_two_nodes) &&
            historical_bit_is_canonical(ordered_node_pair_exact) &&
            historical_bit_is_canonical(pair_manifest_binds_node_sources) &&
            historical_bit_is_canonical(service_enablement_exact) &&
            historical_bit_is_canonical(restart_linger_exact) &&
            historical_bit_is_canonical(container_recreate_identity_exact) &&
            historical_bit_is_canonical(nodeset_identity_exact) &&
            historical_bit_is_canonical(device_plugin_identity_exact) &&
            historical_bit_is_canonical(taints_exact) &&
            historical_bit_is_canonical(labels_exact) &&
            historical_bit_is_canonical(boot_identity_recorded_as_provenance) &&
            historical_bit_is_canonical(protected_path_payloads_complete) &&
            historical_bit_is_canonical(toolchain_hardware_commands_exact) &&
            historical_bit_is_canonical(artifact_availability_exact) &&
            historical_bit_is_canonical(ephemeral_fields_observation_only) &&
            historical_bit_is_canonical(restore_targets_separated_from_observations) &&
            historical_bit_is_canonical(no_unknown_or_implicit_fields) &&
            historical_bit_is_canonical(source_conflicts_zero) &&
            historical_bit_is_canonical(coverage_closure_exact),
        exactly_two_nodes: historical_bool(exactly_two_nodes),
        ordered_node_pair_exact: historical_bool(ordered_node_pair_exact),
        pair_manifest_binds_node_sources: historical_bool(pair_manifest_binds_node_sources),
        service_enablement_exact: historical_bool(service_enablement_exact),
        restart_linger_exact: historical_bool(restart_linger_exact),
        container_recreate_identity_exact: historical_bool(container_recreate_identity_exact),
        nodeset_identity_exact: historical_bool(nodeset_identity_exact),
        device_plugin_identity_exact: historical_bool(device_plugin_identity_exact),
        taints_exact: historical_bool(taints_exact),
        labels_exact: historical_bool(labels_exact),
        boot_identity_recorded_as_provenance: historical_bool(boot_identity_recorded_as_provenance),
        protected_path_payloads_complete: historical_bool(protected_path_payloads_complete),
        toolchain_hardware_commands_exact: historical_bool(toolchain_hardware_commands_exact),
        artifact_availability_exact: historical_bool(artifact_availability_exact),
        ephemeral_fields_observation_only: historical_bool(ephemeral_fields_observation_only),
        restore_targets_separated_from_observations: historical_bool(restore_targets_separated_from_observations),
        no_unknown_or_implicit_fields: historical_bool(no_unknown_or_implicit_fields),
        source_conflicts_zero: historical_bool(source_conflicts_zero),
        coverage_closure_exact: historical_bool(coverage_closure_exact),
    }
}

fn historical_allow(current_state: i64, next_state: i64) -> SparkPairHistoricalDecision {
    SparkPairHistoricalDecision {
        allowed: true, current_state: current_state, next_state: next_state, reason: 0,
    }
}

fn historical_refuse(current_state: i64, reason: i64) -> SparkPairHistoricalDecision {
    SparkPairHistoricalDecision {
        allowed: false, current_state: current_state, next_state: current_state, reason: reason,
    }
}

fn historical_authority_reason(authority: SparkPairHistoricalAuthorityFacts) -> i64 {
    if !authority.policy_present { return 339 }
    if authority.policy_error { return 340 }
    if authority.operation_timed_out { return 341 }
    if !authority.parent_9027_freeze_exact { return 342 }
    if !authority.canonical_pair_identity_exact { return 348 }
    if !authority.hash_algorithm_sha256 || !authority.digest_domains_distinct { return 345 }
    if !authority.canonical_serialization_exact { return 371 }
    0
}

fn historical_ordering_reason(ordering: SparkPairHistoricalOrderingFacts) -> i64 {
    if !ordering.historical_source_present { return 343 }
    if !ordering.first_install_anchor_exact { return 349 }
    if !ordering.source_digest_anchored_before_install ||
        !ordering.capture_window_ends_before_install ||
        !ordering.append_only_or_signed_sequence_exact { return 350 }
    if !ordering.ordering_not_clock_only { return 351 }
    if !ordering.source_immutable_since_anchor { return 352 }
    if !ordering.no_retrospective_reconstruction { return 353 }
    0
}

fn historical_custody_reason(custody: SparkPairHistoricalCustodyFacts) -> i64 {
    if !custody.source_authority_exact || !custody.producer_identity_exact ||
        !custody.source_custody_chain_exact || !custody.source_storage_identity_exact ||
        !custody.source_access_receipt_exact { return 355 }
    if !custody.producer_language_role_exact ||
        !custody.external_llm_review_only { return 364 }
    if !custody.source_custody_conflict_zero { return 356 }
    0
}

fn historical_completeness_reason(
    completeness: SparkPairHistoricalCompletenessFacts,
) -> i64 {
    if !completeness.exactly_two_nodes || !completeness.ordered_node_pair_exact ||
        !completeness.pair_manifest_binds_node_sources { return 358 }
    if !completeness.service_enablement_exact || !completeness.restart_linger_exact { return 359 }
    if !completeness.container_recreate_identity_exact { return 360 }
    if !completeness.nodeset_identity_exact || !completeness.device_plugin_identity_exact { return 361 }
    if !completeness.taints_exact || !completeness.labels_exact ||
        !completeness.boot_identity_recorded_as_provenance { return 362 }
    if !completeness.protected_path_payloads_complete { return 363 }
    if !completeness.toolchain_hardware_commands_exact { return 372 }
    if !completeness.artifact_availability_exact { return 365 }
    if !completeness.ephemeral_fields_observation_only ||
        !completeness.restore_targets_separated_from_observations { return 366 }
    if !completeness.no_unknown_or_implicit_fields { return 367 }
    if !completeness.source_conflicts_zero { return 368 }
    if !completeness.coverage_closure_exact { return 369 }
    0
}

fn historical_all_candidate_digests_zero(
    source_digest: SparkPairHistoricalDigest256,
    node0_digest: SparkPairHistoricalDigest256,
    node1_digest: SparkPairHistoricalDigest256,
    pair_digest: SparkPairHistoricalDigest256,
    install_anchor_digest: SparkPairHistoricalDigest256,
    prior_receipt_digest: SparkPairHistoricalDigest256,
) -> bool {
    !historical_digest_is_nonzero(source_digest) &&
    !historical_digest_is_nonzero(node0_digest) &&
    !historical_digest_is_nonzero(node1_digest) &&
    !historical_digest_is_nonzero(pair_digest) &&
    !historical_digest_is_nonzero(install_anchor_digest) &&
    !historical_digest_is_nonzero(prior_receipt_digest)
}

fn historical_ordering_all_absent(ordering: SparkPairHistoricalOrderingFacts) -> bool {
    !ordering.historical_source_present && !ordering.first_install_anchor_exact &&
    !ordering.source_digest_anchored_before_install &&
    !ordering.capture_window_ends_before_install &&
    !ordering.append_only_or_signed_sequence_exact &&
    !ordering.source_immutable_since_anchor && !ordering.ordering_not_clock_only &&
    !ordering.no_retrospective_reconstruction
}

fn historical_custody_all_absent(custody: SparkPairHistoricalCustodyFacts) -> bool {
    !custody.source_authority_exact && !custody.producer_identity_exact &&
    !custody.source_custody_chain_exact && !custody.source_storage_identity_exact &&
    !custody.source_access_receipt_exact && !custody.producer_language_role_exact &&
    !custody.external_llm_review_only && !custody.source_custody_conflict_zero
}

fn historical_completeness_all_absent(
    completeness: SparkPairHistoricalCompletenessFacts,
) -> bool {
    !completeness.exactly_two_nodes && !completeness.ordered_node_pair_exact &&
    !completeness.pair_manifest_binds_node_sources && !completeness.service_enablement_exact &&
    !completeness.restart_linger_exact && !completeness.container_recreate_identity_exact &&
    !completeness.nodeset_identity_exact && !completeness.device_plugin_identity_exact &&
    !completeness.taints_exact && !completeness.labels_exact &&
    !completeness.boot_identity_recorded_as_provenance &&
    !completeness.protected_path_payloads_complete &&
    !completeness.toolchain_hardware_commands_exact &&
    !completeness.artifact_availability_exact &&
    !completeness.ephemeral_fields_observation_only &&
    !completeness.restore_targets_separated_from_observations &&
    !completeness.no_unknown_or_implicit_fields && !completeness.source_conflicts_zero &&
    !completeness.coverage_closure_exact
}

fn historical_candidate_digest_reason(
    source_digest: SparkPairHistoricalDigest256,
    node0_digest: SparkPairHistoricalDigest256,
    node1_digest: SparkPairHistoricalDigest256,
    pair_digest: SparkPairHistoricalDigest256,
    install_anchor_digest: SparkPairHistoricalDigest256,
    parent_digest: SparkPairHistoricalDigest256,
) -> i64 {
    if !historical_digest_is_nonzero(source_digest) { return 345 }
    if !historical_digest_is_nonzero(node0_digest) ||
        !historical_digest_is_nonzero(node1_digest) { return 346 }
    if !historical_digest_is_nonzero(pair_digest) { return 347 }
    if !historical_digest_is_nonzero(install_anchor_digest) { return 349 }
    if historical_digest_equal(node0_digest, node1_digest) { return 358 }
    if historical_digest_equal(source_digest, node0_digest) ||
        historical_digest_equal(source_digest, node1_digest) ||
        historical_digest_equal(source_digest, pair_digest) ||
        historical_digest_equal(source_digest, install_anchor_digest) ||
        historical_digest_equal(pair_digest, node0_digest) ||
        historical_digest_equal(pair_digest, node1_digest) ||
        historical_digest_equal(install_anchor_digest, node0_digest) ||
        historical_digest_equal(install_anchor_digest, node1_digest) ||
        historical_digest_equal(install_anchor_digest, pair_digest) ||
        historical_digest_equal(parent_digest, source_digest) ||
        historical_digest_equal(parent_digest, node0_digest) ||
        historical_digest_equal(parent_digest, node1_digest) ||
        historical_digest_equal(parent_digest, pair_digest) ||
        historical_digest_equal(parent_digest, install_anchor_digest) { return 345 }
    0
}

fn historical_prior_receipt_reason(
    authority: SparkPairHistoricalAuthorityFacts,
    source_digest: SparkPairHistoricalDigest256,
    node0_digest: SparkPairHistoricalDigest256,
    node1_digest: SparkPairHistoricalDigest256,
    pair_digest: SparkPairHistoricalDigest256,
    install_anchor_digest: SparkPairHistoricalDigest256,
    parent_digest: SparkPairHistoricalDigest256,
    prior_receipt_digest: SparkPairHistoricalDigest256,
    receipt_required: bool,
) -> i64 {
    let receipt_present = historical_digest_is_nonzero(prior_receipt_digest)
    let receipt_transcript_exact = authority.prior_decision_receipt_exact &&
        authority.prior_receipt_digest_matches_bytes &&
        authority.prior_receipt_is_allowed_bind_30_to_31 &&
        authority.prior_receipt_candidate_identity_exact
    let any_receipt_claim = authority.prior_decision_receipt_exact ||
        authority.prior_receipt_digest_matches_bytes ||
        authority.prior_receipt_is_allowed_bind_30_to_31 ||
        authority.prior_receipt_candidate_identity_exact
    if receipt_required && (!receipt_present || !receipt_transcript_exact) { return 370 }
    if !receipt_required && (receipt_present || any_receipt_claim) { return 370 }
    if receipt_present && (
        historical_digest_equal(prior_receipt_digest, source_digest) ||
        historical_digest_equal(prior_receipt_digest, node0_digest) ||
        historical_digest_equal(prior_receipt_digest, node1_digest) ||
        historical_digest_equal(prior_receipt_digest, pair_digest) ||
        historical_digest_equal(prior_receipt_digest, install_anchor_digest) ||
        historical_digest_equal(prior_receipt_digest, parent_digest)
    ) { return 345 }
    0
}

fn historical_authority_has_any_receipt_claim(
    authority: SparkPairHistoricalAuthorityFacts,
) -> bool {
    authority.prior_decision_receipt_exact ||
    authority.prior_receipt_digest_matches_bytes ||
    authority.prior_receipt_is_allowed_bind_30_to_31 ||
    authority.prior_receipt_candidate_identity_exact
}

fn historical_source_class_reason(source_class: i64) -> i64 {
    if source_class == 6 { return 354 }
    if source_class < 1 || source_class > 5 { return 344 }
    0
}

pub fn decide_spark_pair_historical_provenance_plan(
    action: i64,
    current_state: i64,
    source_class: i64,
    source_digest: SparkPairHistoricalDigest256,
    node0_digest: SparkPairHistoricalDigest256,
    node1_digest: SparkPairHistoricalDigest256,
    pair_digest: SparkPairHistoricalDigest256,
    install_anchor_digest: SparkPairHistoricalDigest256,
    parent_9027_digest: SparkPairHistoricalDigest256,
    prior_receipt_digest: SparkPairHistoricalDigest256,
    authority: SparkPairHistoricalAuthorityFacts,
    ordering: SparkPairHistoricalOrderingFacts,
    custody: SparkPairHistoricalCustodyFacts,
    completeness: SparkPairHistoricalCompletenessFacts,
) -> SparkPairHistoricalDecision {
    if !authority.canonical || !ordering.canonical || !custody.canonical ||
        !completeness.canonical || !historical_digest_is_canonical(source_digest) ||
        !historical_digest_is_canonical(node0_digest) ||
        !historical_digest_is_canonical(node1_digest) ||
        !historical_digest_is_canonical(pair_digest) ||
        !historical_digest_is_canonical(install_anchor_digest) ||
        !historical_digest_is_canonical(parent_9027_digest) ||
        !historical_digest_is_canonical(prior_receipt_digest) {
        return historical_refuse(current_state, 336)
    }
    if current_state < 30 || current_state > 32 { return historical_refuse(current_state, 337) }
    if action < 54 || action > 56 { return historical_refuse(current_state, 338) }

    let authority_reason = historical_authority_reason(authority)
    if authority_reason != 0 { return historical_refuse(current_state, authority_reason) }
    if !historical_parent_9027_digest_is_exact(parent_9027_digest) {
        return historical_refuse(current_state, 342)
    }

    if action == 54 && current_state == 30 {
        if historical_digest_is_nonzero(prior_receipt_digest) ||
            historical_authority_has_any_receipt_claim(authority) {
            return historical_refuse(current_state, 370)
        }
        if source_class != 0 || !historical_all_candidate_digests_zero(
            source_digest, node0_digest, node1_digest, pair_digest,
            install_anchor_digest, prior_receipt_digest,
        ) ||
            !historical_ordering_all_absent(ordering) ||
            !historical_custody_all_absent(custody) ||
            !historical_completeness_all_absent(completeness) {
            return historical_refuse(current_state, 336)
        }
        return historical_allow(current_state, current_state)
    }

    if current_state == 30 && action != 55 { return historical_refuse(current_state, 337) }
    if current_state == 31 && action == 55 { return historical_refuse(current_state, 337) }
    if current_state == 32 && action == 55 { return historical_refuse(current_state, 337) }

    let class_reason = historical_source_class_reason(source_class)
    if class_reason != 0 { return historical_refuse(current_state, class_reason) }
    if !ordering.historical_source_present {
        return historical_refuse(current_state, 343)
    }
    let digest_reason = historical_candidate_digest_reason(
        source_digest, node0_digest, node1_digest, pair_digest,
        install_anchor_digest, parent_9027_digest,
    )
    if digest_reason != 0 { return historical_refuse(current_state, digest_reason) }

    let receipt_required = current_state != 30
    let receipt_reason = historical_prior_receipt_reason(
        authority, source_digest, node0_digest, node1_digest, pair_digest,
        install_anchor_digest, parent_9027_digest, prior_receipt_digest,
        receipt_required,
    )
    if receipt_reason != 0 { return historical_refuse(current_state, receipt_reason) }

    let ordering_reason = historical_ordering_reason(ordering)
    if ordering_reason != 0 { return historical_refuse(current_state, ordering_reason) }

    if action == 55 { return historical_allow(current_state, 31) }

    if action == 54 && current_state == 31 {
        return historical_allow(current_state, current_state)
    }

    if source_class == 5 { return historical_refuse(current_state, 357) }
    let custody_reason = historical_custody_reason(custody)
    if custody_reason != 0 { return historical_refuse(current_state, custody_reason) }
    let completeness_reason = historical_completeness_reason(completeness)
    if completeness_reason != 0 { return historical_refuse(current_state, completeness_reason) }

    if action == 54 { return historical_allow(current_state, current_state) }
    if action == 56 { return historical_allow(current_state, 32) }
    historical_refuse(current_state, 338)
}

pub fn spark_pair_historical_decision_allowed(decision: SparkPairHistoricalDecision) -> bool {
    decision.allowed
}

pub fn spark_pair_historical_decision_current_state(decision: SparkPairHistoricalDecision) -> i64 {
    decision.current_state
}

pub fn spark_pair_historical_decision_next_state(decision: SparkPairHistoricalDecision) -> i64 {
    decision.next_state
}

pub fn spark_pair_historical_decision_reason(decision: SparkPairHistoricalDecision) -> i64 {
    decision.reason
}
