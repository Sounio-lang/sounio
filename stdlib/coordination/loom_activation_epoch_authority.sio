//! LOOM action 9049: append-only native activation epoch authority.

pub struct LoomActivationEpochObservation {
    pub mode: i64,
    pub stage: i64,
    pub word: i64,
    pub predecessor_hash: i64,
    pub next_runtime_hash: i64,
    pub pin_inventory_hash: i64,
    pub transaction_hash: i64,
    pub epoch: i64,
    pub previous_epoch: i64,
}

fn epoch_fact(word: i64, shift: i64) -> i64 { (word >> shift) & 1 }

// Bits: parent9048, state-lock, install-lock, predecessor-bound,
// predecessor-archived, current-matches-predecessor, next-runtime-bound,
// next-native, pins-complete, pins-unchanged, next-head-ready,
// epoch-receipt-ready, decision-receipt-ready, fail-closed,
// python-absent, rust-absent, disposable-absent, selector-bound.
pub fn judge_loom_activation_epoch(o: LoomActivationEpochObservation) -> i64 {
    if o.stage != 3 || epoch_fact(o.word, 0) != 1 { return 711 }
    if epoch_fact(o.word, 1) != 1 || epoch_fact(o.word, 2) != 1 { return 712 }
    if epoch_fact(o.word, 3) != 1 || o.predecessor_hash == 0 { return 713 }
    if epoch_fact(o.word, 4) != 1 || epoch_fact(o.word, 5) != 1 { return 714 }
    if epoch_fact(o.word, 6) != 1 || epoch_fact(o.word, 7) != 1 ||
       o.next_runtime_hash == 0 { return 715 }
    if epoch_fact(o.word, 8) != 1 || epoch_fact(o.word, 9) != 1 ||
       o.pin_inventory_hash == 0 { return 716 }
    if epoch_fact(o.word, 13) != 1 || epoch_fact(o.word, 14) != 1 ||
       epoch_fact(o.word, 15) != 1 || epoch_fact(o.word, 16) != 1 { return 717 }
    if epoch_fact(o.word, 17) != 1 { return 718 }
    if o.epoch <= 0 || o.epoch != o.previous_epoch + 1 { return 719 }
    if o.transaction_hash == 0 { return 720 }
    if o.mode == 1 {
        if epoch_fact(o.word, 10) != 1 || epoch_fact(o.word, 11) != 1 ||
           epoch_fact(o.word, 12) != 1 { return 720 }
        return 1
    }
    if o.mode == 2 {
        if epoch_fact(o.word, 10) != 1 || epoch_fact(o.word, 11) != 1 ||
           epoch_fact(o.word, 12) != 1 { return 720 }
        return 2
    }
    721
}

pub fn judge_loom_activation_epoch_words(
    mode: i64, stage: i64, word: i64, predecessor_hash: i64,
    next_runtime_hash: i64, pin_inventory_hash: i64, transaction_hash: i64,
    epoch: i64, previous_epoch: i64,
) -> i64 {
    judge_loom_activation_epoch(LoomActivationEpochObservation {
        mode: mode, stage: stage, word: word,
        predecessor_hash: predecessor_hash,
        next_runtime_hash: next_runtime_hash,
        pin_inventory_hash: pin_inventory_hash,
        transaction_hash: transaction_hash,
        epoch: epoch, previous_epoch: previous_epoch,
    })
}

pub fn loom_activation_epoch_selftest() -> i64 with Mut {
    var failed: i64 = 0
    let full: i64 = 262143
    if judge_loom_activation_epoch_words(1, 3, full, 1, 2, 3, 4, 1, 0) != 1 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(2, 3, full, 1, 2, 3, 4, 9, 8) != 2 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 2, full, 1, 2, 3, 4, 1, 0) != 711 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full - 2, 1, 2, 3, 4, 1, 0) != 712 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full - 8, 1, 2, 3, 4, 1, 0) != 713 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full - 16, 1, 2, 3, 4, 1, 0) != 714 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full - 64, 1, 2, 3, 4, 1, 0) != 715 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full - 256, 1, 2, 3, 4, 1, 0) != 716 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full - 16384, 1, 2, 3, 4, 1, 0) != 717 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full - 131072, 1, 2, 3, 4, 1, 0) != 718 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full, 1, 2, 3, 4, 3, 1) != 719 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(1, 3, full, 1, 2, 3, 0, 1, 0) != 720 { failed = failed + 1 }
    if judge_loom_activation_epoch_words(3, 3, full, 1, 2, 3, 4, 1, 0) != 721 { failed = failed + 1 }
    failed
}
