//! LOOM action 9047: causal hook-generation reconciliation authority.
//!
//! A heartbeat timeout never proves absence. Quarantine requires a bound
//! record, a bound kernel observation, and one exact causal absence reason.

pub struct LoomNativeHookGenerationReconcileObservation {
    pub mode: i64,
    pub stage: i64,
    pub parent_9046_frozen: i64,
    pub record_regular: i64,
    pub record_readable: i64,
    pub filename_identity_bound: i64,
    pub record_identity_bound: i64,
    pub inventory_digest_bound: i64,
    pub state_lock_held: i64,
    pub kernel_boot_bound: i64,
    pub pid_namespace_bound: i64,
    pub pid_bound: i64,
    pub start_tick_bound: i64,
    pub boot_changed: i64,
    pub namespace_changed: i64,
    pub pid_absent: i64,
    pub pid_reused: i64,
    pub heartbeat_expired: i64,
    pub related_artifacts_bound: i64,
    pub quarantine_destination_new: i64,
    pub wal_ready: i64,
    pub decision_receipt_complete: i64,
    pub fail_closed: i64,
    pub python_oracle_absent: i64,
    pub rust_oracle_absent: i64,
    pub disposable_oracle_absent: i64,
    pub related_total: i64,
    pub related_bound: i64,
    pub absence_reason: i64,
    pub record_hash0: i64,
    pub record_hash1: i64,
    pub kernel_hash: i64,
    pub transaction_hash: i64,
    pub sabotage_count: i64,
    pub sabotage_required: i64,
}

fn reconcile_fact(word: i64, shift: i64) -> i64 {
    (word >> shift) & 1
}

pub fn loom_native_hook_generation_reconcile_observation_from_words(
    mode: i64,
    stage: i64,
    word: i64,
    related_total: i64,
    related_bound: i64,
    absence_reason: i64,
    record_hash0: i64,
    record_hash1: i64,
    kernel_hash: i64,
    transaction_hash: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> LoomNativeHookGenerationReconcileObservation {
    LoomNativeHookGenerationReconcileObservation {
        mode: mode,
        stage: stage,
        parent_9046_frozen: reconcile_fact(word, 0),
        record_regular: reconcile_fact(word, 1),
        record_readable: reconcile_fact(word, 2),
        filename_identity_bound: reconcile_fact(word, 3),
        record_identity_bound: reconcile_fact(word, 4),
        inventory_digest_bound: reconcile_fact(word, 5),
        state_lock_held: reconcile_fact(word, 6),
        kernel_boot_bound: reconcile_fact(word, 7),
        pid_namespace_bound: reconcile_fact(word, 8),
        pid_bound: reconcile_fact(word, 9),
        start_tick_bound: reconcile_fact(word, 10),
        boot_changed: reconcile_fact(word, 11),
        namespace_changed: reconcile_fact(word, 12),
        pid_absent: reconcile_fact(word, 13),
        pid_reused: reconcile_fact(word, 14),
        heartbeat_expired: reconcile_fact(word, 15),
        related_artifacts_bound: reconcile_fact(word, 16),
        quarantine_destination_new: reconcile_fact(word, 17),
        wal_ready: reconcile_fact(word, 18),
        decision_receipt_complete: reconcile_fact(word, 19),
        fail_closed: reconcile_fact(word, 20),
        python_oracle_absent: reconcile_fact(word, 21),
        rust_oracle_absent: reconcile_fact(word, 22),
        disposable_oracle_absent: reconcile_fact(word, 23),
        related_total: related_total,
        related_bound: related_bound,
        absence_reason: absence_reason,
        record_hash0: record_hash0,
        record_hash1: record_hash1,
        kernel_hash: kernel_hash,
        transaction_hash: transaction_hash,
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
}

fn reconcile_absence_count(o: LoomNativeHookGenerationReconcileObservation) -> i64 {
    o.boot_changed + o.namespace_changed + o.pid_absent + o.pid_reused
}

fn reconcile_absence_reason_matches(
    o: LoomNativeHookGenerationReconcileObservation,
) -> bool {
    if o.absence_reason == 1 { return o.boot_changed == 1 }
    if o.absence_reason == 2 { return o.namespace_changed == 1 }
    if o.absence_reason == 3 { return o.pid_absent == 1 }
    if o.absence_reason == 4 { return o.pid_reused == 1 }
    false
}

// 1 = KEEP, 2 = QUARANTINE_ELIGIBLE, 3 = QUARANTINE_READY.
pub fn judge_loom_native_hook_generation_reconcile(
    o: LoomNativeHookGenerationReconcileObservation,
) -> i64 {
    if o.stage != 3 || o.parent_9046_frozen != 1 { return 682 }
    if o.record_regular != 1 || o.record_readable != 1 { return 683 }
    if o.filename_identity_bound != 1 || o.record_identity_bound != 1 ||
        o.inventory_digest_bound != 1 ||
        (o.record_hash0 == 0 && o.record_hash1 == 0) { return 684 }
    if o.kernel_boot_bound != 1 || o.pid_namespace_bound != 1 ||
        o.pid_bound != 1 || o.start_tick_bound != 1 || o.kernel_hash == 0 {
        return 685
    }
    if o.related_total < 0 || o.related_bound < 0 ||
        o.related_total != o.related_bound || o.related_artifacts_bound != 1 {
        return 686
    }
    if o.python_oracle_absent != 1 || o.rust_oracle_absent != 1 ||
        o.disposable_oracle_absent != 1 || o.sabotage_required < 8 ||
        o.sabotage_count < o.sabotage_required { return 687 }

    let absence_count = reconcile_absence_count(o)
    if absence_count == 0 {
        if o.absence_reason != 0 { return 688 }
        if o.mode == 1 || o.mode == 2 { return 1 }
        return 690
    }
    if absence_count != 1 || !reconcile_absence_reason_matches(o) { return 688 }

    if o.mode == 1 { return 2 }
    if o.mode == 2 {
        if o.state_lock_held != 1 || o.quarantine_destination_new != 1 ||
            o.wal_ready != 1 || o.decision_receipt_complete != 1 ||
            o.fail_closed != 1 || o.transaction_hash == 0 { return 689 }
        return 3
    }
    690
}

pub fn judge_loom_native_hook_generation_reconcile_words(
    mode: i64,
    stage: i64,
    word: i64,
    related_total: i64,
    related_bound: i64,
    absence_reason: i64,
    record_hash0: i64,
    record_hash1: i64,
    kernel_hash: i64,
    transaction_hash: i64,
    sabotage_count: i64,
    sabotage_required: i64,
) -> i64 {
    judge_loom_native_hook_generation_reconcile(
        loom_native_hook_generation_reconcile_observation_from_words(
            mode, stage, word, related_total, related_bound, absence_reason,
            record_hash0, record_hash1, kernel_hash, transaction_hash,
            sabotage_count, sabotage_required,
        ),
    )
}

pub fn loom_native_hook_generation_reconcile_selftest() -> i64 with Mut {
    var failed: i64 = 0
    if judge_loom_native_hook_generation_reconcile_words(
        1, 3, 16713727, 0, 0, 0, 1, 2, 3, 4, 8, 8,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        1, 3, 16746495, 0, 0, 0, 1, 2, 3, 4, 8, 8,
    ) != 1 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        1, 3, 16721919, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 2 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 16721919, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 3 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 16721917, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 683 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 16721903, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 684 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 16720895, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 685 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 16656383, 2, 1, 3, 1, 2, 3, 4, 8, 8,
    ) != 686 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 12527615, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 687 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 14624767, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 687 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 16713727, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 688 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        2, 3, 14755839, 2, 2, 3, 1, 2, 3, 4, 8, 8,
    ) != 689 { failed = failed + 1 }
    if judge_loom_native_hook_generation_reconcile_words(
        7, 3, 16713727, 0, 0, 0, 1, 2, 3, 4, 8, 8,
    ) != 690 { failed = failed + 1 }
    failed
}
