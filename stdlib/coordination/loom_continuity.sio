//! Linear host-admission algebra for Sounio Loom continuity receipts.
//!
//! `LoomHostTrust` is the trusted host boundary. The OCaml runtime verifies
//! process identities, journal hashes, lineage, and the evidence set before
//! admitting a receipt. A private linear seal prevents ordinary Sounio code
//! from laundering caller-chosen booleans into a verified continuity state.

pub effect LoomHostTrust {}

linear struct LoomHostTrustSeal {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    next_receipt_id: i64,
}

linear struct HostRuntimeContinuityReceipt {
    receipt_id: i64,
    evidence_set_token: i64,
    receipt_chain_token: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    semantic_journal_head_token: i64,
    guardian_journal_head_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    predecessor_semantic_head_token: i64,
    predecessor_guardian_head_token: i64,
    predecessor_receipt_token: i64,
    authenticity_mode: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    transition_kind: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
    loom_authority_verified: bool,
    journal_verified: bool,
    lineage_verified: bool,
}

struct ObservedContinuity {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    semantic_journal_head_token: i64,
    guardian_journal_head_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    predecessor_semantic_head_token: i64,
    predecessor_guardian_head_token: i64,
    predecessor_receipt_token: i64,
    authenticity_mode: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    transition_kind: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
    loom_authority_verified: bool,
    journal_verified: bool,
    lineage_verified: bool,
}

struct VerifiedInitialGeneration {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
}

struct VerifiedCleanRespawn {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
}

struct VerifiedPodResurrection {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
}

struct VerifiedSignedInitialGeneration {
    verified: VerifiedInitialGeneration,
}

struct VerifiedSignedCleanRespawn {
    verified: VerifiedCleanRespawn,
    predecessor_receipt_token: i64,
}

struct VerifiedSignedPodResurrection {
    verified: VerifiedPodResurrection,
    predecessor_receipt_token: i64,
}

// The three private proof terms keep role evidence distinct even before
// principal identities are compared. A predecessor decision cannot be used as
// an independent observation, and caller code cannot forge the disjointness
// witness that joins them.
struct VerifiedPredecessorDecision {
    signed: VerifiedSignedPodResurrection,
    signer_authority_token: i64,
    predecessor_receipt_token: i64,
}

struct VerifiedIndependentPredecessorObservation {
    observer_authority_token: i64,
    predecessor_receipt_token: i64,
    independent_observation_token: i64,
}

struct VerifiedDisjointPrincipals {
    signer_authority_token: i64,
    observer_authority_token: i64,
}

struct VerifiedIndependentlySignedCleanRespawn {
    signed: VerifiedSignedCleanRespawn,
    observation: VerifiedIndependentPredecessorObservation,
    principals: VerifiedDisjointPrincipals,
}

struct VerifiedIndependentlySignedPodResurrection {
    decision: VerifiedPredecessorDecision,
    observation: VerifiedIndependentPredecessorObservation,
    principals: VerifiedDisjointPrincipals,
}

struct ObservedPreSpawnPrincipalEvidence {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
}

struct VerifiedPreSpawnDecision {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
}

struct VerifiedPreSpawnObservation {
    predecessor_receipt_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
}

struct VerifiedIndependentPreSpawnAdmission {
    decision: VerifiedPreSpawnDecision,
    observation: VerifiedPreSpawnObservation,
    principals: VerifiedDisjointPrincipals,
}

struct ObservedPreSpawnMeasurementEvidence {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
}

struct VerifiedPreSpawnDecisionFacts {
    generation_token: i64,
    fingerprint_token: i64,
    semantic_head_token: i64,
    guardian_head_token: i64,
}

struct VerifiedPreSpawnMeasuredFacts {
    generation_token: i64,
    fingerprint_token: i64,
    semantic_head_token: i64,
    guardian_head_token: i64,
}

struct VerifiedMeasurementAgreement {
    generation_token: i64,
    fingerprint_token: i64,
    semantic_head_token: i64,
    guardian_head_token: i64,
}

struct VerifiedIndependentPreSpawnMeasurementAdmission {
    decision: VerifiedPreSpawnDecision,
    observation: VerifiedPreSpawnObservation,
    principals: VerifiedDisjointPrincipals,
    decision_facts: VerifiedPreSpawnDecisionFacts,
    measured_facts: VerifiedPreSpawnMeasuredFacts,
    agreement: VerifiedMeasurementAgreement,
}

fn principal_tokens_are_disjoint(
    signer_authority_token: i64,
    observer_authority_token: i64,
) -> bool {
    if signer_authority_token == observer_authority_token { return false }
    true
}

fn measurement_tokens_agree(
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
) -> bool {
    decision_generation_token == measured_generation_token &&
        decision_fingerprint_token == measured_fingerprint_token &&
        decision_semantic_head_token == measured_semantic_head_token &&
        decision_guardian_head_token == measured_guardian_head_token
}

fn admit_pre_spawn_principal_evidence(
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
) -> ObservedPreSpawnPrincipalEvidence with LoomHostTrust, Panic {
    if predecessor_receipt_token <= 0 || signer_authority_token <= 0 ||
        observer_authority_token <= 0 || independent_observation_token <= 0 {
        panic("pre-spawn principal evidence is not canonical")
    }
    ObservedPreSpawnPrincipalEvidence {
        predecessor_receipt_token: predecessor_receipt_token,
        signer_authority_token: signer_authority_token,
        observer_authority_token: observer_authority_token,
        independent_observation_token: independent_observation_token,
    }
}

fn admit_pre_spawn_measurement_evidence(
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
) -> ObservedPreSpawnMeasurementEvidence with LoomHostTrust, Panic {
    if predecessor_receipt_token <= 0 || signer_authority_token <= 0 ||
        observer_authority_token <= 0 || independent_observation_token <= 0 ||
        decision_generation_token <= 0 || decision_fingerprint_token <= 0 ||
        decision_semantic_head_token <= 0 || decision_guardian_head_token <= 0 ||
        measured_generation_token <= 0 || measured_fingerprint_token <= 0 ||
        measured_semantic_head_token <= 0 || measured_guardian_head_token <= 0 {
        panic("pre-spawn measurement evidence is not canonical")
    }
    ObservedPreSpawnMeasurementEvidence {
        predecessor_receipt_token: predecessor_receipt_token,
        signer_authority_token: signer_authority_token,
        observer_authority_token: observer_authority_token,
        independent_observation_token: independent_observation_token,
        decision_generation_token: decision_generation_token,
        decision_fingerprint_token: decision_fingerprint_token,
        decision_semantic_head_token: decision_semantic_head_token,
        decision_guardian_head_token: decision_guardian_head_token,
        measured_generation_token: measured_generation_token,
        measured_fingerprint_token: measured_fingerprint_token,
        measured_semantic_head_token: measured_semantic_head_token,
        measured_guardian_head_token: measured_guardian_head_token,
    }
}

pub fn verify_pre_spawn_decision(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedPreSpawnDecision> {
    if observed.predecessor_receipt_token <= 0 || observed.signer_authority_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnDecision {
        predecessor_receipt_token: observed.predecessor_receipt_token,
        signer_authority_token: observed.signer_authority_token,
    })
}

pub fn verify_pre_spawn_observation(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedPreSpawnObservation> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnObservation {
        predecessor_receipt_token: observed.predecessor_receipt_token,
        observer_authority_token: observed.observer_authority_token,
        independent_observation_token: observed.independent_observation_token,
    })
}

pub fn verify_pre_spawn_disjoint_principals(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedDisjointPrincipals> {
    if !principal_tokens_are_disjoint(
        observed.signer_authority_token,
        observed.observer_authority_token,
    ) {
        return None
    }
    Some(VerifiedDisjointPrincipals {
        signer_authority_token: observed.signer_authority_token,
        observer_authority_token: observed.observer_authority_token,
    })
}

pub fn pre_spawn_roles_are_nominally_distinct(
    decision: VerifiedPreSpawnDecision,
    observation: VerifiedPreSpawnObservation,
) -> bool {
    true
}

pub fn verify_independent_pre_spawn_admission(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedIndependentPreSpawnAdmission> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.signer_authority_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        !principal_tokens_are_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
        ) {
        return None
    }
    Some(VerifiedIndependentPreSpawnAdmission {
        decision: VerifiedPreSpawnDecision {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            signer_authority_token: observed.signer_authority_token,
        },
        observation: VerifiedPreSpawnObservation {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            observer_authority_token: observed.observer_authority_token,
            independent_observation_token: observed.independent_observation_token,
        },
        principals: VerifiedDisjointPrincipals {
            signer_authority_token: observed.signer_authority_token,
            observer_authority_token: observed.observer_authority_token,
        },
    })
}

pub fn promote_independent_pre_spawn_admission(
    receipt: VerifiedIndependentPreSpawnAdmission,
) -> i64 {
    let VerifiedIndependentPreSpawnAdmission {
        decision,
        observation,
        principals,
    } = receipt
    let VerifiedPreSpawnDecision {
        predecessor_receipt_token,
        signer_authority_token,
    } = decision
    predecessor_receipt_token
}

pub fn pre_spawn_measurement_roles_are_nominally_distinct(
    decision: VerifiedPreSpawnDecisionFacts,
    measurement: VerifiedPreSpawnMeasuredFacts,
) -> bool {
    true
}

pub fn verify_pre_spawn_decision_facts(
    observed: ObservedPreSpawnMeasurementEvidence,
) -> Option<VerifiedPreSpawnDecisionFacts> {
    if observed.decision_generation_token <= 0 ||
        observed.decision_fingerprint_token <= 0 ||
        observed.decision_semantic_head_token <= 0 ||
        observed.decision_guardian_head_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnDecisionFacts {
        generation_token: observed.decision_generation_token,
        fingerprint_token: observed.decision_fingerprint_token,
        semantic_head_token: observed.decision_semantic_head_token,
        guardian_head_token: observed.decision_guardian_head_token,
    })
}

pub fn verify_pre_spawn_measured_facts(
    observed: ObservedPreSpawnMeasurementEvidence,
) -> Option<VerifiedPreSpawnMeasuredFacts> {
    if observed.measured_generation_token <= 0 ||
        observed.measured_fingerprint_token <= 0 ||
        observed.measured_semantic_head_token <= 0 ||
        observed.measured_guardian_head_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnMeasuredFacts {
        generation_token: observed.measured_generation_token,
        fingerprint_token: observed.measured_fingerprint_token,
        semantic_head_token: observed.measured_semantic_head_token,
        guardian_head_token: observed.measured_guardian_head_token,
    })
}

pub fn verify_independent_pre_spawn_measurement_admission(
    observed: ObservedPreSpawnMeasurementEvidence,
) -> Option<VerifiedIndependentPreSpawnMeasurementAdmission> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.signer_authority_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        !principal_tokens_are_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
        ) ||
        !measurement_tokens_agree(
            observed.decision_generation_token,
            observed.decision_fingerprint_token,
            observed.decision_semantic_head_token,
            observed.decision_guardian_head_token,
            observed.measured_generation_token,
            observed.measured_fingerprint_token,
            observed.measured_semantic_head_token,
            observed.measured_guardian_head_token,
        ) {
        return None
    }
    Some(VerifiedIndependentPreSpawnMeasurementAdmission {
        decision: VerifiedPreSpawnDecision {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            signer_authority_token: observed.signer_authority_token,
        },
        observation: VerifiedPreSpawnObservation {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            observer_authority_token: observed.observer_authority_token,
            independent_observation_token: observed.independent_observation_token,
        },
        principals: VerifiedDisjointPrincipals {
            signer_authority_token: observed.signer_authority_token,
            observer_authority_token: observed.observer_authority_token,
        },
        decision_facts: VerifiedPreSpawnDecisionFacts {
            generation_token: observed.decision_generation_token,
            fingerprint_token: observed.decision_fingerprint_token,
            semantic_head_token: observed.decision_semantic_head_token,
            guardian_head_token: observed.decision_guardian_head_token,
        },
        measured_facts: VerifiedPreSpawnMeasuredFacts {
            generation_token: observed.measured_generation_token,
            fingerprint_token: observed.measured_fingerprint_token,
            semantic_head_token: observed.measured_semantic_head_token,
            guardian_head_token: observed.measured_guardian_head_token,
        },
        agreement: VerifiedMeasurementAgreement {
            generation_token: observed.measured_generation_token,
            fingerprint_token: observed.measured_fingerprint_token,
            semantic_head_token: observed.measured_semantic_head_token,
            guardian_head_token: observed.measured_guardian_head_token,
        },
    })
}

pub fn promote_independent_pre_spawn_measurement_admission(
    receipt: VerifiedIndependentPreSpawnMeasurementAdmission,
) -> i64 {
    let VerifiedIndependentPreSpawnMeasurementAdmission {
        decision,
        observation,
        principals,
        decision_facts,
        measured_facts,
        agreement,
    } = receipt
    let VerifiedPreSpawnDecision {
        predecessor_receipt_token,
        signer_authority_token,
    } = decision
    predecessor_receipt_token
}

// This constructor is deliberately private. The native host adapter is the
// production caller; the single-module gate exercises it as the TCB witness.
fn open_host_trust_bridge(
    evidence_set_token: i64,
    receipt_chain_token: i64,
) -> LoomHostTrustSeal with LoomHostTrust, Panic {
    if evidence_set_token <= 0 || receipt_chain_token <= 0 {
        panic("Loom host trust identity must be positive")
    }
    LoomHostTrustSeal {
        evidence_set_token: evidence_set_token,
        receipt_chain_token: receipt_chain_token,
        next_receipt_id: 1,
    }
}

// Transition kinds are closed: 1 initial, 2 clean respawn, 3 Pod
// resurrection. Admission checks the host envelope and linear receipt chain;
// transition-specific proof rules remain in the public verifiers below.
fn admit_runtime_continuity(
    seal: LoomHostTrustSeal,
    receipt_id: i64,
    receipt_evidence_set_token: i64,
    receipt_chain: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    semantic_journal_head_token: i64,
    guardian_journal_head_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    predecessor_semantic_head_token: i64,
    predecessor_guardian_head_token: i64,
    predecessor_receipt_token: i64,
    authenticity_mode: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    transition_kind: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
    loom_authority_verified: bool,
    journal_verified: bool,
    lineage_verified: bool,
) -> (LoomHostTrustSeal, HostRuntimeContinuityReceipt) with LoomHostTrust, Panic {
    let LoomHostTrustSeal {
        evidence_set_token,
        receipt_chain_token,
        next_receipt_id,
    } = seal
    let envelope_valid =
        current_generation_token > 0 &&
        generation_fingerprint_token > 0 &&
        semantic_journal_head_token > 0 &&
        guardian_journal_head_token > 0 &&
        lineage_head_token >= 0 &&
        predecessor_generation_token >= 0 &&
        predecessor_semantic_head_token >= 0 &&
        predecessor_guardian_head_token >= 0 &&
        predecessor_receipt_token >= 0 &&
        authenticity_mode >= 0 && authenticity_mode <= 2 &&
        signer_authority_token >= 0 && observer_authority_token >= 0 &&
        independent_observation_token >= 0 &&
        transition_kind >= 1 && transition_kind <= 3 &&
        transition_count >= 0 && pod_resurrection_count >= 0
    if receipt_id != next_receipt_id ||
        receipt_evidence_set_token != evidence_set_token ||
        receipt_chain != receipt_chain_token || !envelope_valid {
        panic("runtime continuity receipt is not canonical")
    }
    let next_seal = LoomHostTrustSeal {
        evidence_set_token: evidence_set_token,
        receipt_chain_token: receipt_chain_token,
        next_receipt_id: next_receipt_id + 1,
    }
    let receipt = HostRuntimeContinuityReceipt {
        receipt_id: receipt_id,
        evidence_set_token: receipt_evidence_set_token,
        receipt_chain_token: receipt_chain,
        current_generation_token: current_generation_token,
        generation_fingerprint_token: generation_fingerprint_token,
        semantic_journal_head_token: semantic_journal_head_token,
        guardian_journal_head_token: guardian_journal_head_token,
        lineage_head_token: lineage_head_token,
        predecessor_generation_token: predecessor_generation_token,
        predecessor_semantic_head_token: predecessor_semantic_head_token,
        predecessor_guardian_head_token: predecessor_guardian_head_token,
        predecessor_receipt_token: predecessor_receipt_token,
        authenticity_mode: authenticity_mode,
        signer_authority_token: signer_authority_token,
        observer_authority_token: observer_authority_token,
        independent_observation_token: independent_observation_token,
        transition_kind: transition_kind,
        transition_count: transition_count,
        pod_resurrection_count: pod_resurrection_count,
        loom_authority_verified: loom_authority_verified,
        journal_verified: journal_verified,
        lineage_verified: lineage_verified,
    }
    (next_seal, receipt)
}

fn close_host_trust_bridge(seal: LoomHostTrustSeal) with Panic {
    let LoomHostTrustSeal {
        evidence_set_token,
        receipt_chain_token,
        next_receipt_id,
    } = seal
    if evidence_set_token <= 0 || receipt_chain_token <= 0 || next_receipt_id <= 1 {
        panic("Loom host trust bridge closed without an admitted receipt")
    }
}

pub fn import_host_continuity(
    receipt: HostRuntimeContinuityReceipt,
) -> ObservedContinuity {
    let HostRuntimeContinuityReceipt {
        receipt_id,
        evidence_set_token,
        receipt_chain_token,
        current_generation_token,
        generation_fingerprint_token,
        semantic_journal_head_token,
        guardian_journal_head_token,
        lineage_head_token,
        predecessor_generation_token,
        predecessor_semantic_head_token,
        predecessor_guardian_head_token,
        predecessor_receipt_token,
        authenticity_mode,
        signer_authority_token,
        observer_authority_token,
        independent_observation_token,
        transition_kind,
        transition_count,
        pod_resurrection_count,
        loom_authority_verified,
        journal_verified,
        lineage_verified,
    } = receipt
    ObservedContinuity {
        evidence_set_token: evidence_set_token,
        receipt_chain_token: receipt_chain_token,
        receipt_id: receipt_id,
        current_generation_token: current_generation_token,
        generation_fingerprint_token: generation_fingerprint_token,
        semantic_journal_head_token: semantic_journal_head_token,
        guardian_journal_head_token: guardian_journal_head_token,
        lineage_head_token: lineage_head_token,
        predecessor_generation_token: predecessor_generation_token,
        predecessor_semantic_head_token: predecessor_semantic_head_token,
        predecessor_guardian_head_token: predecessor_guardian_head_token,
        predecessor_receipt_token: predecessor_receipt_token,
        authenticity_mode: authenticity_mode,
        signer_authority_token: signer_authority_token,
        observer_authority_token: observer_authority_token,
        independent_observation_token: independent_observation_token,
        transition_kind: transition_kind,
        transition_count: transition_count,
        pod_resurrection_count: pod_resurrection_count,
        loom_authority_verified: loom_authority_verified,
        journal_verified: journal_verified,
        lineage_verified: lineage_verified,
    }
}

pub fn verify_initial_generation(
    observed: ObservedContinuity,
) -> Option<VerifiedInitialGeneration> {
    if !observed.loom_authority_verified || !observed.journal_verified ||
        !observed.lineage_verified {
        return None
    }
    if observed.transition_kind != 1 || observed.transition_count != 0 ||
        observed.pod_resurrection_count != 0 {
        return None
    }
    if observed.lineage_head_token != 0 || observed.predecessor_generation_token != 0 ||
        observed.predecessor_semantic_head_token != 0 ||
        observed.predecessor_guardian_head_token != 0 ||
        observed.predecessor_receipt_token != 0 {
        return None
    }
    Some(VerifiedInitialGeneration {
        evidence_set_token: observed.evidence_set_token,
        receipt_chain_token: observed.receipt_chain_token,
        receipt_id: observed.receipt_id,
        current_generation_token: observed.current_generation_token,
        generation_fingerprint_token: observed.generation_fingerprint_token,
    })
}

pub fn verify_clean_respawn(
    observed: ObservedContinuity,
) -> Option<VerifiedCleanRespawn> {
    if !observed.loom_authority_verified || !observed.journal_verified ||
        !observed.lineage_verified {
        return None
    }
    if observed.transition_kind != 2 || observed.transition_count < 1 ||
        observed.pod_resurrection_count >= observed.transition_count {
        return None
    }
    if observed.lineage_head_token <= 0 || observed.predecessor_generation_token <= 0 ||
        observed.predecessor_semantic_head_token <= 0 ||
        observed.predecessor_guardian_head_token <= 0 {
        return None
    }
    Some(VerifiedCleanRespawn {
        evidence_set_token: observed.evidence_set_token,
        receipt_chain_token: observed.receipt_chain_token,
        receipt_id: observed.receipt_id,
        current_generation_token: observed.current_generation_token,
        generation_fingerprint_token: observed.generation_fingerprint_token,
        lineage_head_token: observed.lineage_head_token,
        predecessor_generation_token: observed.predecessor_generation_token,
        transition_count: observed.transition_count,
        pod_resurrection_count: observed.pod_resurrection_count,
    })
}

pub fn verify_pod_resurrection(
    observed: ObservedContinuity,
) -> Option<VerifiedPodResurrection> {
    if !observed.loom_authority_verified || !observed.journal_verified ||
        !observed.lineage_verified {
        return None
    }
    if observed.transition_kind != 3 || observed.transition_count < 1 ||
        observed.pod_resurrection_count < 1 ||
        observed.pod_resurrection_count > observed.transition_count {
        return None
    }
    if observed.lineage_head_token <= 0 || observed.predecessor_generation_token <= 0 {
        return None
    }
    if observed.predecessor_semantic_head_token == 0 { return None }
    if observed.predecessor_guardian_head_token <= 0 { return None }
    Some(VerifiedPodResurrection {
        evidence_set_token: observed.evidence_set_token,
        receipt_chain_token: observed.receipt_chain_token,
        receipt_id: observed.receipt_id,
        current_generation_token: observed.current_generation_token,
        generation_fingerprint_token: observed.generation_fingerprint_token,
        lineage_head_token: observed.lineage_head_token,
        predecessor_generation_token: observed.predecessor_generation_token,
        transition_count: observed.transition_count,
        pod_resurrection_count: observed.pod_resurrection_count,
    })
}

pub fn verify_signed_initial_generation(
    observed: ObservedContinuity,
) -> Option<VerifiedSignedInitialGeneration> {
    if observed.authenticity_mode != 1 || observed.predecessor_receipt_token != 0 {
        return None
    }
    match verify_initial_generation(observed) {
        Some(verified) => Some(VerifiedSignedInitialGeneration {
            verified: verified,
        }),
        None => None,
    }
}

pub fn verify_signed_clean_respawn(
    observed: ObservedContinuity,
) -> Option<VerifiedSignedCleanRespawn> {
    if (observed.authenticity_mode != 1 && observed.authenticity_mode != 2) || observed.predecessor_receipt_token <= 0 {
        return None
    }
    let predecessor_receipt_token = observed.predecessor_receipt_token
    match verify_clean_respawn(observed) {
        Some(verified) => Some(VerifiedSignedCleanRespawn {
            verified: verified,
            predecessor_receipt_token: predecessor_receipt_token,
        }),
        None => None,
    }
}

pub fn verify_signed_pod_resurrection(
    observed: ObservedContinuity,
) -> Option<VerifiedSignedPodResurrection> {
    if (observed.authenticity_mode != 1 && observed.authenticity_mode != 2) || observed.predecessor_receipt_token <= 0 {
        return None
    }
    let predecessor_receipt_token = observed.predecessor_receipt_token
    match verify_pod_resurrection(observed) {
        Some(verified) => Some(VerifiedSignedPodResurrection {
            verified: verified,
            predecessor_receipt_token: predecessor_receipt_token,
        }),
        None => None,
    }
}

pub fn verify_predecessor_decision(
    observed: ObservedContinuity,
) -> Option<VerifiedPredecessorDecision> {
    if observed.authenticity_mode != 2 || observed.signer_authority_token <= 0 {
        return None
    }
    let signer_authority_token = observed.signer_authority_token
    let predecessor_receipt_token = observed.predecessor_receipt_token
    match verify_signed_pod_resurrection(observed) {
        Some(signed) => Some(VerifiedPredecessorDecision {
            signed: signed,
            signer_authority_token: signer_authority_token,
            predecessor_receipt_token: predecessor_receipt_token,
        }),
        None => None,
    }
}

pub fn verify_independent_predecessor_observation(
    observed: ObservedContinuity,
) -> Option<VerifiedIndependentPredecessorObservation> {
    if observed.authenticity_mode != 2 ||
        observed.predecessor_receipt_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 {
        return None
    }
    Some(VerifiedIndependentPredecessorObservation {
        observer_authority_token: observed.observer_authority_token,
        predecessor_receipt_token: observed.predecessor_receipt_token,
        independent_observation_token: observed.independent_observation_token,
    })
}

pub fn verify_disjoint_principals(
    observed: ObservedContinuity,
) -> Option<VerifiedDisjointPrincipals> {
    if observed.authenticity_mode != 2 ||
        observed.signer_authority_token <= 0 ||
        observed.observer_authority_token <= 0 {
        return None
    }
    if !principal_tokens_are_disjoint(
        observed.signer_authority_token,
        observed.observer_authority_token,
    ) {
        return None
    }
    Some(VerifiedDisjointPrincipals {
        signer_authority_token: observed.signer_authority_token,
        observer_authority_token: observed.observer_authority_token,
    })
}

pub fn independent_roles_are_nominally_distinct(
    decision: VerifiedPredecessorDecision,
    observation: VerifiedIndependentPredecessorObservation,
) -> bool {
    true
}

pub fn verify_independently_signed_pod_resurrection(
    observed: ObservedContinuity,
) -> Option<VerifiedIndependentlySignedPodResurrection> {
    if observed.authenticity_mode != 2 ||
        observed.predecessor_receipt_token <= 0 ||
        observed.signer_authority_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        !principal_tokens_are_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
        ) {
        return None
    }
    let predecessor_receipt_token = observed.predecessor_receipt_token
    let signer_authority_token = observed.signer_authority_token
    let observer_authority_token = observed.observer_authority_token
    let independent_observation_token = observed.independent_observation_token
    match verify_pod_resurrection(observed) {
        Some(verified) => Some(VerifiedIndependentlySignedPodResurrection {
            decision: VerifiedPredecessorDecision {
                signed: VerifiedSignedPodResurrection {
                    verified: verified,
                    predecessor_receipt_token: predecessor_receipt_token,
                },
                signer_authority_token: signer_authority_token,
                predecessor_receipt_token: predecessor_receipt_token,
            },
            observation: VerifiedIndependentPredecessorObservation {
                observer_authority_token: observer_authority_token,
                predecessor_receipt_token: predecessor_receipt_token,
                independent_observation_token: independent_observation_token,
            },
            principals: VerifiedDisjointPrincipals {
                signer_authority_token: signer_authority_token,
                observer_authority_token: observer_authority_token,
            },
        }),
        None => None,
    }
}

pub fn verify_independently_signed_clean_respawn(
    observed: ObservedContinuity,
) -> Option<VerifiedIndependentlySignedCleanRespawn> {
    if observed.authenticity_mode != 2 ||
        observed.predecessor_receipt_token <= 0 ||
        observed.signer_authority_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        !principal_tokens_are_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
        ) {
        return None
    }
    let predecessor_receipt_token = observed.predecessor_receipt_token
    let observer_authority_token = observed.observer_authority_token
    let signer_authority_token = observed.signer_authority_token
    let independent_observation_token = observed.independent_observation_token
    match verify_clean_respawn(observed) {
        Some(verified) => Some(VerifiedIndependentlySignedCleanRespawn {
            signed: VerifiedSignedCleanRespawn {
                verified: verified,
                predecessor_receipt_token: predecessor_receipt_token,
            },
            observation: VerifiedIndependentPredecessorObservation {
                observer_authority_token: observer_authority_token,
                predecessor_receipt_token: predecessor_receipt_token,
                independent_observation_token: independent_observation_token,
            },
            principals: VerifiedDisjointPrincipals {
                signer_authority_token: signer_authority_token,
                observer_authority_token: observer_authority_token,
            },
        }),
        None => None,
    }
}

pub fn promote_initial_generation(receipt: VerifiedInitialGeneration) -> i64 {
    let VerifiedInitialGeneration {
        evidence_set_token, receipt_chain_token, receipt_id,
        current_generation_token, generation_fingerprint_token,
    } = receipt
    current_generation_token
}

pub fn promote_clean_respawn(receipt: VerifiedCleanRespawn) -> i64 {
    let VerifiedCleanRespawn {
        evidence_set_token, receipt_chain_token, receipt_id,
        current_generation_token, generation_fingerprint_token,
        lineage_head_token, predecessor_generation_token,
        transition_count, pod_resurrection_count,
    } = receipt
    current_generation_token
}

pub fn promote_pod_resurrection(
    receipt: VerifiedPodResurrection,
) -> (i64, i64, i64, i64, i64, i64) {
    let VerifiedPodResurrection {
        evidence_set_token, receipt_chain_token, receipt_id,
        current_generation_token, generation_fingerprint_token,
        lineage_head_token, predecessor_generation_token,
        transition_count, pod_resurrection_count,
    } = receipt
    (
        current_generation_token,
        evidence_set_token,
        lineage_head_token,
        predecessor_generation_token,
        transition_count,
        pod_resurrection_count,
    )
}

pub fn promote_signed_initial_generation(
    receipt: VerifiedSignedInitialGeneration,
) -> i64 {
    let VerifiedSignedInitialGeneration { verified } = receipt
    promote_initial_generation(verified)
}

pub fn promote_signed_clean_respawn(
    receipt: VerifiedSignedCleanRespawn,
) -> i64 {
    let VerifiedSignedCleanRespawn {
        verified,
        predecessor_receipt_token,
    } = receipt
    promote_clean_respawn(verified)
}

pub fn promote_signed_pod_resurrection(
    receipt: VerifiedSignedPodResurrection,
) -> (i64, i64, i64, i64, i64, i64) {
    let VerifiedSignedPodResurrection {
        verified,
        predecessor_receipt_token,
    } = receipt
    promote_pod_resurrection(verified)
}

pub fn promote_independently_signed_clean_respawn(
    receipt: VerifiedIndependentlySignedCleanRespawn,
) -> i64 {
    let VerifiedIndependentlySignedCleanRespawn {
        signed,
        observation,
        principals,
    } = receipt
    promote_signed_clean_respawn(signed)
}

pub fn promote_independently_signed_pod_resurrection(
    receipt: VerifiedIndependentlySignedPodResurrection,
) -> (i64, i64, i64, i64, i64, i64) {
    let VerifiedIndependentlySignedPodResurrection {
        decision,
        observation,
        principals,
    } = receipt
    let VerifiedPredecessorDecision {
        signed,
        signer_authority_token,
        predecessor_receipt_token,
    } = decision
    promote_signed_pod_resurrection(signed)
}
