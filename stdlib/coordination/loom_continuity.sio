            min_valid_signatures: observed.journal_min_valid_signatures,
            epoch: observed.journal_epoch,
            checkpoint_token: observed.journal_checkpoint_token,
        },
        authorities: VerifiedFiveWayDisjointAuthorities {
            signer_authority_token: observed.signer_authority_token,
            observer_authority_token: observed.observer_authority_token,
            journal_authority_token_a: observed.journal_authority_token_a,
            journal_authority_token_b: observed.journal_authority_token_b,
            journal_authority_token_c: observed.journal_authority_token_c,
        },
        agreement: VerifiedFullDigestAgreement {
