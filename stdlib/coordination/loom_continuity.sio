        ) ||
        !full_digest_vectors_agree(
            observed.decision_generation_digest,
            observed.decision_fingerprint_digest,
            observed.decision_semantic_head_digest,
            observed.decision_guardian_head_digest,
            observed.measured_generation_digest,
            observed.measured_fingerprint_digest,
            observed.measured_semantic_head_digest,
            observed.measured_guardian_head_digest,
        ) {
        return None
    }
    Some(VerifiedObservationAuthorityQuorumAdmission {
        decision: VerifiedFullDigestDecisionFacts {
            generation_digest: observed.decision_generation_digest,
            fingerprint_digest: observed.decision_fingerprint_digest,
            semantic_head_digest: observed.decision_semantic_head_digest,
            guardian_head_digest: observed.decision_guardian_head_digest,
        },
        measurement: VerifiedFullDigestMeasuredFacts {
            generation_digest: observed.measured_generation_digest,
            fingerprint_digest: observed.measured_fingerprint_digest,
            semantic_head_digest: observed.measured_semantic_head_digest,
