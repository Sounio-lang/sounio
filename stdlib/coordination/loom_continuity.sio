//! Linear host-admission algebra for Sounio Loom continuity receipts.
//!
//! `LoomHostTrust` is the trusted host boundary. The OCaml runtime verifies
//! process identities, journal hashes, lineage, and the evidence set before
//! admitting a receipt. A private linear seal prevents ordinary Sounio code
//! from laundering caller-chosen booleans into a verified continuity state.

pub effect LoomHostTrust {}

linear struct LoomHostTrustSeal {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    next_receipt_id: i64,
}

linear struct HostRuntimeContinuityReceipt {
    receipt_id: i64,
    evidence_set_token: i64,
    receipt_chain_token: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    semantic_journal_head_token: i64,
    guardian_journal_head_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    predecessor_semantic_head_token: i64,
    predecessor_guardian_head_token: i64,
    predecessor_receipt_token: i64,
    authenticity_mode: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    transition_kind: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
    loom_authority_verified: bool,
    journal_verified: bool,
    lineage_verified: bool,
}

struct ObservedContinuity {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    semantic_journal_head_token: i64,
    guardian_journal_head_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    predecessor_semantic_head_token: i64,
    predecessor_guardian_head_token: i64,
    predecessor_receipt_token: i64,
    authenticity_mode: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    transition_kind: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
    loom_authority_verified: bool,
    journal_verified: bool,
    lineage_verified: bool,
}

struct VerifiedInitialGeneration {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
}

struct VerifiedCleanRespawn {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
}

struct VerifiedPodResurrection {
    evidence_set_token: i64,
    receipt_chain_token: i64,
    receipt_id: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
}

struct VerifiedSignedInitialGeneration {
    verified: VerifiedInitialGeneration,
}

struct VerifiedSignedCleanRespawn {
    verified: VerifiedCleanRespawn,
    predecessor_receipt_token: i64,
}

struct VerifiedSignedPodResurrection {
    verified: VerifiedPodResurrection,
    predecessor_receipt_token: i64,
}

// The three private proof terms keep role evidence distinct even before
// principal identities are compared. A predecessor decision cannot be used as
// an independent observation, and caller code cannot forge the disjointness
// witness that joins them.
struct VerifiedPredecessorDecision {
    signed: VerifiedSignedPodResurrection,
    signer_authority_token: i64,
    predecessor_receipt_token: i64,
}

struct VerifiedIndependentPredecessorObservation {
    observer_authority_token: i64,
    predecessor_receipt_token: i64,
    independent_observation_token: i64,
}

struct VerifiedDisjointPrincipals {
    signer_authority_token: i64,
    observer_authority_token: i64,
}

struct VerifiedIndependentlySignedCleanRespawn {
    signed: VerifiedSignedCleanRespawn,
    observation: VerifiedIndependentPredecessorObservation,
    principals: VerifiedDisjointPrincipals,
}

struct VerifiedIndependentlySignedPodResurrection {
    decision: VerifiedPredecessorDecision,
    observation: VerifiedIndependentPredecessorObservation,
    principals: VerifiedDisjointPrincipals,
}

struct ObservedPreSpawnPrincipalEvidence {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
}

struct VerifiedPreSpawnDecision {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
}

struct VerifiedPreSpawnObservation {
    predecessor_receipt_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
}

struct VerifiedIndependentPreSpawnAdmission {
    decision: VerifiedPreSpawnDecision,
    observation: VerifiedPreSpawnObservation,
    principals: VerifiedDisjointPrincipals,
}

struct ObservedPreSpawnMeasurementEvidence {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
}

struct VerifiedPreSpawnDecisionFacts {
    generation_token: i64,
    fingerprint_token: i64,
    semantic_head_token: i64,
    guardian_head_token: i64,
}

struct VerifiedPreSpawnMeasuredFacts {
    generation_token: i64,
    fingerprint_token: i64,
    semantic_head_token: i64,
    guardian_head_token: i64,
}

struct VerifiedMeasurementAgreement {
    generation_token: i64,
    fingerprint_token: i64,
    semantic_head_token: i64,
    guardian_head_token: i64,
}

struct VerifiedIndependentPreSpawnMeasurementAdmission {
    decision: VerifiedPreSpawnDecision,
    observation: VerifiedPreSpawnObservation,
    principals: VerifiedDisjointPrincipals,
    decision_facts: VerifiedPreSpawnDecisionFacts,
    measured_facts: VerifiedPreSpawnMeasuredFacts,
    agreement: VerifiedMeasurementAgreement,
}

struct Digest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct ObservedPreSpawnObservationAuthorityEvidence {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    journal_authority_token: i64,
    independent_observation_token: i64,
    journal_checkpoint_token: i64,
    journal_epoch: i64,
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
    decision_generation_digest: Digest256,
    decision_fingerprint_digest: Digest256,
    decision_semantic_head_digest: Digest256,
    decision_guardian_head_digest: Digest256,
    measured_generation_digest: Digest256,
    measured_fingerprint_digest: Digest256,
    measured_semantic_head_digest: Digest256,
    measured_guardian_head_digest: Digest256,
}

struct VerifiedFullDigestDecisionFacts {
    generation_digest: Digest256,
    fingerprint_digest: Digest256,
    semantic_head_digest: Digest256,
    guardian_head_digest: Digest256,
}

struct VerifiedFullDigestMeasuredFacts {
    generation_digest: Digest256,
    fingerprint_digest: Digest256,
    semantic_head_digest: Digest256,
    guardian_head_digest: Digest256,
}

struct VerifiedJournalAuthority {
    authority_token: i64,
    epoch: i64,
    checkpoint_token: i64,
}

struct VerifiedThreeWayDisjointAuthorities {
    signer_authority_token: i64,
    observer_authority_token: i64,
    journal_authority_token: i64,
}

struct VerifiedFullDigestAgreement {
    generation_digest: Digest256,
    fingerprint_digest: Digest256,
    semantic_head_digest: Digest256,
    guardian_head_digest: Digest256,
}

struct VerifiedObservationAuthorityAdmission {
    decision: VerifiedFullDigestDecisionFacts,
    measurement: VerifiedFullDigestMeasuredFacts,
    journal: VerifiedJournalAuthority,
    authorities: VerifiedThreeWayDisjointAuthorities,
    agreement: VerifiedFullDigestAgreement,
    predecessor_receipt_token: i64,
}

// Journal-quorum admission is a separate proof family from the legacy
// single-authority proof. The host verifies every event signature, then gives
// Sounio the configured principal set and the minimum valid share count seen
// anywhere in the retained journals. Ordinary code cannot construct either
// the observed envelope or the verified quorum proof.
struct ObservedPreSpawnJournalQuorumEvidence {
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    journal_authority_token_a: i64,
    journal_authority_token_b: i64,
    journal_authority_token_c: i64,
    journal_required_quorum: i64,
    journal_min_valid_signatures: i64,
    independent_observation_token: i64,
    journal_checkpoint_token: i64,
    journal_epoch: i64,
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
    decision_generation_digest: Digest256,
    decision_fingerprint_digest: Digest256,
    decision_semantic_head_digest: Digest256,
    decision_guardian_head_digest: Digest256,
    measured_generation_digest: Digest256,
    measured_fingerprint_digest: Digest256,
    measured_semantic_head_digest: Digest256,
    measured_guardian_head_digest: Digest256,
}

struct VerifiedJournalAuthorityQuorum {
    authority_token_a: i64,
    authority_token_b: i64,
    authority_token_c: i64,
    required_quorum: i64,
    min_valid_signatures: i64,
    epoch: i64,
    checkpoint_token: i64,
}

struct VerifiedFiveWayDisjointAuthorities {
    signer_authority_token: i64,
    observer_authority_token: i64,
    journal_authority_token_a: i64,
    journal_authority_token_b: i64,
    journal_authority_token_c: i64,
}

struct VerifiedObservationAuthorityQuorumAdmission {
    decision: VerifiedFullDigestDecisionFacts,
    measurement: VerifiedFullDigestMeasuredFacts,
    journal: VerifiedJournalAuthorityQuorum,
    authorities: VerifiedFiveWayDisjointAuthorities,
    agreement: VerifiedFullDigestAgreement,
    predecessor_receipt_token: i64,
}

fn principal_tokens_are_disjoint(
    signer_authority_token: i64,
    observer_authority_token: i64,
) -> bool {
    if signer_authority_token == observer_authority_token { return false }
    true
}

fn measurement_tokens_agree(
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
) -> bool {
    decision_generation_token == measured_generation_token &&
        decision_fingerprint_token == measured_fingerprint_token &&
        decision_semantic_head_token == measured_semantic_head_token &&
        decision_guardian_head_token == measured_guardian_head_token
}

fn digest256_agrees(left: Digest256, right: Digest256) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
        left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
        left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
        left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn full_digest_vectors_agree(
    decision_generation_digest: Digest256,
    decision_fingerprint_digest: Digest256,
    decision_semantic_head_digest: Digest256,
    decision_guardian_head_digest: Digest256,
    measured_generation_digest: Digest256,
    measured_fingerprint_digest: Digest256,
    measured_semantic_head_digest: Digest256,
    measured_guardian_head_digest: Digest256,
) -> bool {
    digest256_agrees(decision_generation_digest, measured_generation_digest) &&
        digest256_agrees(decision_fingerprint_digest, measured_fingerprint_digest) &&
        digest256_agrees(decision_semantic_head_digest, measured_semantic_head_digest) &&
        digest256_agrees(decision_guardian_head_digest, measured_guardian_head_digest)
}

fn authority_principals_are_pairwise_disjoint(
    signer_authority_token: i64,
    observer_authority_token: i64,
    journal_authority_token: i64,
) -> bool {
    signer_authority_token != observer_authority_token &&
        signer_authority_token != journal_authority_token &&
        observer_authority_token != journal_authority_token
}

fn journal_quorum_principals_are_pairwise_disjoint(
    signer_authority_token: i64,
    observer_authority_token: i64,
    journal_authority_token_a: i64,
    journal_authority_token_b: i64,
    journal_authority_token_c: i64,
) -> bool {
    signer_authority_token > 0 && observer_authority_token > 0 &&
        journal_authority_token_a > 0 && journal_authority_token_b > 0 &&
        journal_authority_token_c > 0 &&
        signer_authority_token != observer_authority_token &&
        signer_authority_token != journal_authority_token_a &&
        signer_authority_token != journal_authority_token_b &&
        signer_authority_token != journal_authority_token_c &&
        observer_authority_token != journal_authority_token_a &&
        observer_authority_token != journal_authority_token_b &&
        observer_authority_token != journal_authority_token_c &&
        journal_authority_token_a != journal_authority_token_b &&
        journal_authority_token_a != journal_authority_token_c &&
        journal_authority_token_b != journal_authority_token_c
}

fn journal_quorum_is_satisfied(
    required_quorum: i64,
    min_valid_signatures: i64,
) -> bool {
    required_quorum == 2 && min_valid_signatures >= required_quorum &&
        min_valid_signatures <= 3
}

fn digest256_is_canonical(value: Digest256) -> bool {
    value.limb0 >= 0 && value.limb0 <= 4294967295 &&
        value.limb1 >= 0 && value.limb1 <= 4294967295 &&
        value.limb2 >= 0 && value.limb2 <= 4294967295 &&
        value.limb3 >= 0 && value.limb3 <= 4294967295 &&
        value.limb4 >= 0 && value.limb4 <= 4294967295 &&
        value.limb5 >= 0 && value.limb5 <= 4294967295 &&
        value.limb6 >= 0 && value.limb6 <= 4294967295 &&
        value.limb7 >= 0 && value.limb7 <= 4294967295
}

fn admit_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> Digest256 with Panic {
    let value = Digest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
    if !digest256_is_canonical(value) {
        panic("SHA-256 limb is not canonical")
    }
    value
}

fn admit_pre_spawn_principal_evidence(
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
) -> ObservedPreSpawnPrincipalEvidence with LoomHostTrust, Panic {
    if predecessor_receipt_token <= 0 || signer_authority_token <= 0 ||
        observer_authority_token <= 0 || independent_observation_token <= 0 {
        panic("pre-spawn principal evidence is not canonical")
    }
    ObservedPreSpawnPrincipalEvidence {
        predecessor_receipt_token: predecessor_receipt_token,
        signer_authority_token: signer_authority_token,
        observer_authority_token: observer_authority_token,
        independent_observation_token: independent_observation_token,
    }
}

fn admit_pre_spawn_measurement_evidence(
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    independent_observation_token: i64,
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
) -> ObservedPreSpawnMeasurementEvidence with LoomHostTrust, Panic {
    if predecessor_receipt_token <= 0 || signer_authority_token <= 0 ||
        observer_authority_token <= 0 || independent_observation_token <= 0 ||
        decision_generation_token <= 0 || decision_fingerprint_token <= 0 ||
        decision_semantic_head_token <= 0 || decision_guardian_head_token <= 0 ||
        measured_generation_token <= 0 || measured_fingerprint_token <= 0 ||
        measured_semantic_head_token <= 0 || measured_guardian_head_token <= 0 {
        panic("pre-spawn measurement evidence is not canonical")
    }
    ObservedPreSpawnMeasurementEvidence {
        predecessor_receipt_token: predecessor_receipt_token,
        signer_authority_token: signer_authority_token,
        observer_authority_token: observer_authority_token,
        independent_observation_token: independent_observation_token,
        decision_generation_token: decision_generation_token,
        decision_fingerprint_token: decision_fingerprint_token,
        decision_semantic_head_token: decision_semantic_head_token,
        decision_guardian_head_token: decision_guardian_head_token,
        measured_generation_token: measured_generation_token,
        measured_fingerprint_token: measured_fingerprint_token,
        measured_semantic_head_token: measured_semantic_head_token,
        measured_guardian_head_token: measured_guardian_head_token,
    }
}

pub fn verify_pre_spawn_decision(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedPreSpawnDecision> {
    if observed.predecessor_receipt_token <= 0 || observed.signer_authority_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnDecision {
        predecessor_receipt_token: observed.predecessor_receipt_token,
        signer_authority_token: observed.signer_authority_token,
    })
}

pub fn verify_pre_spawn_observation(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedPreSpawnObservation> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnObservation {
        predecessor_receipt_token: observed.predecessor_receipt_token,
        observer_authority_token: observed.observer_authority_token,
        independent_observation_token: observed.independent_observation_token,
    })
}

pub fn verify_pre_spawn_disjoint_principals(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedDisjointPrincipals> {
    if !principal_tokens_are_disjoint(
        observed.signer_authority_token,
        observed.observer_authority_token,
    ) {
        return None
    }
    Some(VerifiedDisjointPrincipals {
        signer_authority_token: observed.signer_authority_token,
        observer_authority_token: observed.observer_authority_token,
    })
}

pub fn pre_spawn_roles_are_nominally_distinct(
    decision: VerifiedPreSpawnDecision,
    observation: VerifiedPreSpawnObservation,
) -> bool {
    true
}

pub fn verify_independent_pre_spawn_admission(
    observed: ObservedPreSpawnPrincipalEvidence,
) -> Option<VerifiedIndependentPreSpawnAdmission> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.signer_authority_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        !principal_tokens_are_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
        ) {
        return None
    }
    Some(VerifiedIndependentPreSpawnAdmission {
        decision: VerifiedPreSpawnDecision {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            signer_authority_token: observed.signer_authority_token,
        },
        observation: VerifiedPreSpawnObservation {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            observer_authority_token: observed.observer_authority_token,
            independent_observation_token: observed.independent_observation_token,
        },
        principals: VerifiedDisjointPrincipals {
            signer_authority_token: observed.signer_authority_token,
            observer_authority_token: observed.observer_authority_token,
        },
    })
}

pub fn promote_independent_pre_spawn_admission(
    receipt: VerifiedIndependentPreSpawnAdmission,
) -> i64 {
    let VerifiedIndependentPreSpawnAdmission {
        decision,
        observation,
        principals,
    } = receipt
    let VerifiedPreSpawnDecision {
        predecessor_receipt_token,
        signer_authority_token,
    } = decision
    predecessor_receipt_token
}

pub fn pre_spawn_measurement_roles_are_nominally_distinct(
    decision: VerifiedPreSpawnDecisionFacts,
    measurement: VerifiedPreSpawnMeasuredFacts,
) -> bool {
    true
}

pub fn verify_pre_spawn_decision_facts(
    observed: ObservedPreSpawnMeasurementEvidence,
) -> Option<VerifiedPreSpawnDecisionFacts> {
    if observed.decision_generation_token <= 0 ||
        observed.decision_fingerprint_token <= 0 ||
        observed.decision_semantic_head_token <= 0 ||
        observed.decision_guardian_head_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnDecisionFacts {
        generation_token: observed.decision_generation_token,
        fingerprint_token: observed.decision_fingerprint_token,
        semantic_head_token: observed.decision_semantic_head_token,
        guardian_head_token: observed.decision_guardian_head_token,
    })
}

pub fn verify_pre_spawn_measured_facts(
    observed: ObservedPreSpawnMeasurementEvidence,
) -> Option<VerifiedPreSpawnMeasuredFacts> {
    if observed.measured_generation_token <= 0 ||
        observed.measured_fingerprint_token <= 0 ||
        observed.measured_semantic_head_token <= 0 ||
        observed.measured_guardian_head_token <= 0 {
        return None
    }
    Some(VerifiedPreSpawnMeasuredFacts {
        generation_token: observed.measured_generation_token,
        fingerprint_token: observed.measured_fingerprint_token,
        semantic_head_token: observed.measured_semantic_head_token,
        guardian_head_token: observed.measured_guardian_head_token,
    })
}

pub fn verify_independent_pre_spawn_measurement_admission(
    observed: ObservedPreSpawnMeasurementEvidence,
) -> Option<VerifiedIndependentPreSpawnMeasurementAdmission> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.signer_authority_token <= 0 ||
        observed.observer_authority_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        !principal_tokens_are_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
        ) ||
        !measurement_tokens_agree(
            observed.decision_generation_token,
            observed.decision_fingerprint_token,
            observed.decision_semantic_head_token,
            observed.decision_guardian_head_token,
            observed.measured_generation_token,
            observed.measured_fingerprint_token,
            observed.measured_semantic_head_token,
            observed.measured_guardian_head_token,
        ) {
        return None
    }
    Some(VerifiedIndependentPreSpawnMeasurementAdmission {
        decision: VerifiedPreSpawnDecision {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            signer_authority_token: observed.signer_authority_token,
        },
        observation: VerifiedPreSpawnObservation {
            predecessor_receipt_token: observed.predecessor_receipt_token,
            observer_authority_token: observed.observer_authority_token,
            independent_observation_token: observed.independent_observation_token,
        },
        principals: VerifiedDisjointPrincipals {
            signer_authority_token: observed.signer_authority_token,
            observer_authority_token: observed.observer_authority_token,
        },
        decision_facts: VerifiedPreSpawnDecisionFacts {
            generation_token: observed.decision_generation_token,
            fingerprint_token: observed.decision_fingerprint_token,
            semantic_head_token: observed.decision_semantic_head_token,
            guardian_head_token: observed.decision_guardian_head_token,
        },
        measured_facts: VerifiedPreSpawnMeasuredFacts {
            generation_token: observed.measured_generation_token,
            fingerprint_token: observed.measured_fingerprint_token,
            semantic_head_token: observed.measured_semantic_head_token,
            guardian_head_token: observed.measured_guardian_head_token,
        },
        agreement: VerifiedMeasurementAgreement {
            generation_token: observed.measured_generation_token,
            fingerprint_token: observed.measured_fingerprint_token,
            semantic_head_token: observed.measured_semantic_head_token,
            guardian_head_token: observed.measured_guardian_head_token,
        },
    })
}

pub fn promote_independent_pre_spawn_measurement_admission(
    receipt: VerifiedIndependentPreSpawnMeasurementAdmission,
) -> i64 {
    let VerifiedIndependentPreSpawnMeasurementAdmission {
        decision,
        observation,
        principals,
        decision_facts,
        measured_facts,
        agreement,
    } = receipt
    let VerifiedPreSpawnDecision {
        predecessor_receipt_token,
        signer_authority_token,
    } = decision
    predecessor_receipt_token
}

fn admit_pre_spawn_observation_authority_evidence(
    predecessor_receipt_token: i64,
    signer_authority_token: i64,
    observer_authority_token: i64,
    journal_authority_token: i64,
    independent_observation_token: i64,
    journal_checkpoint_token: i64,
    journal_epoch: i64,
    decision_generation_token: i64,
    decision_fingerprint_token: i64,
    decision_semantic_head_token: i64,
    decision_guardian_head_token: i64,
    measured_generation_token: i64,
    measured_fingerprint_token: i64,
    measured_semantic_head_token: i64,
    measured_guardian_head_token: i64,
    decision_generation_digest: Digest256,
    decision_fingerprint_digest: Digest256,
    decision_semantic_head_digest: Digest256,
    decision_guardian_head_digest: Digest256,
    measured_generation_digest: Digest256,
    measured_fingerprint_digest: Digest256,
    measured_semantic_head_digest: Digest256,
    measured_guardian_head_digest: Digest256,
) -> ObservedPreSpawnObservationAuthorityEvidence with LoomHostTrust, Panic {
    if predecessor_receipt_token <= 0 || signer_authority_token <= 0 ||
        observer_authority_token <= 0 || journal_authority_token <= 0 ||
        independent_observation_token <= 0 || journal_checkpoint_token <= 0 ||
        journal_epoch <= 0 || decision_generation_token <= 0 ||
        decision_fingerprint_token <= 0 || decision_semantic_head_token <= 0 ||
        decision_guardian_head_token <= 0 || measured_generation_token <= 0 ||
        measured_fingerprint_token <= 0 || measured_semantic_head_token <= 0 ||
        measured_guardian_head_token <= 0 ||
        !digest256_is_canonical(decision_generation_digest) ||
        !digest256_is_canonical(decision_fingerprint_digest) ||
        !digest256_is_canonical(decision_semantic_head_digest) ||
        !digest256_is_canonical(decision_guardian_head_digest) ||
        !digest256_is_canonical(measured_generation_digest) ||
        !digest256_is_canonical(measured_fingerprint_digest) ||
        !digest256_is_canonical(measured_semantic_head_digest) ||
        !digest256_is_canonical(measured_guardian_head_digest) {
        panic("observation-authority evidence is not canonical")
    }
    ObservedPreSpawnObservationAuthorityEvidence {
        predecessor_receipt_token: predecessor_receipt_token,
        signer_authority_token: signer_authority_token,
        observer_authority_token: observer_authority_token,
        journal_authority_token: journal_authority_token,
        independent_observation_token: independent_observation_token,
        journal_checkpoint_token: journal_checkpoint_token,
        journal_epoch: journal_epoch,
        decision_generation_token: decision_generation_token,
        decision_fingerprint_token: decision_fingerprint_token,
        decision_semantic_head_token: decision_semantic_head_token,
        decision_guardian_head_token: decision_guardian_head_token,
        measured_generation_token: measured_generation_token,
        measured_fingerprint_token: measured_fingerprint_token,
        measured_semantic_head_token: measured_semantic_head_token,
        measured_guardian_head_token: measured_guardian_head_token,
        decision_generation_digest: decision_generation_digest,
        decision_fingerprint_digest: decision_fingerprint_digest,
        decision_semantic_head_digest: decision_semantic_head_digest,
        decision_guardian_head_digest: decision_guardian_head_digest,
        measured_generation_digest: measured_generation_digest,
        measured_fingerprint_digest: measured_fingerprint_digest,
        measured_semantic_head_digest: measured_semantic_head_digest,
        measured_guardian_head_digest: measured_guardian_head_digest,
    }
}

pub fn verify_observation_authority_decision_facts(
    observed: ObservedPreSpawnObservationAuthorityEvidence,
) -> Option<VerifiedFullDigestDecisionFacts> {
    if !digest256_is_canonical(observed.decision_generation_digest) ||
        !digest256_is_canonical(observed.decision_fingerprint_digest) ||
        !digest256_is_canonical(observed.decision_semantic_head_digest) ||
        !digest256_is_canonical(observed.decision_guardian_head_digest) {
        return None
    }
    Some(VerifiedFullDigestDecisionFacts {
        generation_digest: observed.decision_generation_digest,
        fingerprint_digest: observed.decision_fingerprint_digest,
        semantic_head_digest: observed.decision_semantic_head_digest,
        guardian_head_digest: observed.decision_guardian_head_digest,
    })
}

pub fn verify_observation_authority_measured_facts(
    observed: ObservedPreSpawnObservationAuthorityEvidence,
