pub fn verify_journal_authority_quorum(
    observed: ObservedPreSpawnJournalQuorumEvidence,
) -> Option<VerifiedJournalAuthorityQuorum> {
    if !journal_quorum_is_satisfied(
        observed.journal_required_quorum,
        observed.journal_min_valid_signatures,
    ) {
        return None
    }
    Some(VerifiedJournalAuthorityQuorum {
        authority_token_a: observed.journal_authority_token_a,
        authority_token_b: observed.journal_authority_token_b,
        authority_token_c: observed.journal_authority_token_c,
        required_quorum: observed.journal_required_quorum,
        min_valid_signatures: observed.journal_min_valid_signatures,
        epoch: observed.journal_epoch,
        checkpoint_token: observed.journal_checkpoint_token,
    })
}

pub fn journal_quorum_roles_are_nominally_distinct(
    decision: VerifiedFullDigestDecisionFacts,
    measurement: VerifiedFullDigestMeasuredFacts,
    journal: VerifiedJournalAuthorityQuorum,
) -> bool {
    digest256_agrees(decision.generation_digest, measurement.generation_digest) &&
        digest256_agrees(decision.fingerprint_digest, measurement.fingerprint_digest) &&
        digest256_agrees(decision.semantic_head_digest, measurement.semantic_head_digest) &&
        digest256_agrees(decision.guardian_head_digest, measurement.guardian_head_digest) &&
        journal.authority_token_a > 0 && journal.authority_token_b > 0 &&
        journal.authority_token_c > 0 &&
        journal.authority_token_a != journal.authority_token_b &&
        journal.authority_token_a != journal.authority_token_c &&
        journal.authority_token_b != journal.authority_token_c &&
        journal_quorum_is_satisfied(
            journal.required_quorum,
            journal.min_valid_signatures,
        ) && journal.epoch > 0 && journal.checkpoint_token > 0
}

pub fn verify_observation_authority_quorum_admission(
    observed: ObservedPreSpawnJournalQuorumEvidence,
) -> Option<VerifiedObservationAuthorityQuorumAdmission> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        observed.journal_checkpoint_token <= 0 || observed.journal_epoch <= 0 ||
        !journal_quorum_principals_are_pairwise_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
            observed.journal_authority_token_a,
            observed.journal_authority_token_b,
            observed.journal_authority_token_c,
        ) ||
        !journal_quorum_is_satisfied(
            observed.journal_required_quorum,
            observed.journal_min_valid_signatures,
        ) ||
        !measurement_tokens_agree(
            observed.decision_generation_token,
            observed.decision_fingerprint_token,
            observed.decision_semantic_head_token,
            observed.decision_guardian_head_token,
            observed.measured_generation_token,
            observed.measured_fingerprint_token,
