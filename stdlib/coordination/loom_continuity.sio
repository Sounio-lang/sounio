//! Nominal continuity receipts for the Sounio Loom runtime.
//!
//! The host remains responsible for verifying SHA-256 journals, process birth
//! identities, source commits, and the evidence set. This kernel preserves the
//! distinction between an observation and three promotion-safe transitions.

struct ObservedContinuity {
    evidence_set_token: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    semantic_journal_head_token: i64,
    guardian_journal_head_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    predecessor_semantic_head_token: i64,
    predecessor_guardian_head_token: i64,
    transition_kind: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
    loom_authority_verified: bool,
    journal_verified: bool,
    lineage_verified: bool,
}

struct VerifiedInitialGeneration {
    evidence_set_token: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
}

struct VerifiedCleanRespawn {
    evidence_set_token: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
}

struct VerifiedPodResurrection {
    evidence_set_token: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
}

// Transition kinds are intentionally closed: 1 initial, 2 clean respawn,
// 3 Pod resurrection. Opaque tokens cross the host-trust boundary only after
// the runtime has bound them to the corresponding durable evidence.
pub fn observe_continuity(
    evidence_set_token: i64,
    current_generation_token: i64,
    generation_fingerprint_token: i64,
    semantic_journal_head_token: i64,
    guardian_journal_head_token: i64,
    lineage_head_token: i64,
    predecessor_generation_token: i64,
    predecessor_semantic_head_token: i64,
    predecessor_guardian_head_token: i64,
    transition_kind: i64,
    transition_count: i64,
    pod_resurrection_count: i64,
    loom_authority_verified: bool,
    journal_verified: bool,
    lineage_verified: bool,
) -> Option<ObservedContinuity> {
    if evidence_set_token <= 0 { return None }
    if current_generation_token <= 0 { return None }
    if generation_fingerprint_token <= 0 { return None }
    if semantic_journal_head_token <= 0 { return None }
    if guardian_journal_head_token <= 0 { return None }
    if lineage_head_token < 0 { return None }
    if predecessor_generation_token < 0 { return None }
    if predecessor_semantic_head_token < 0 { return None }
    if predecessor_guardian_head_token < 0 { return None }
    if transition_kind < 1 || transition_kind > 3 { return None }
    if transition_count < 0 { return None }
    if pod_resurrection_count < 0 { return None }
    Some(ObservedContinuity {
        evidence_set_token: evidence_set_token,
        current_generation_token: current_generation_token,
        generation_fingerprint_token: generation_fingerprint_token,
        semantic_journal_head_token: semantic_journal_head_token,
        guardian_journal_head_token: guardian_journal_head_token,
        lineage_head_token: lineage_head_token,
        predecessor_generation_token: predecessor_generation_token,
        predecessor_semantic_head_token: predecessor_semantic_head_token,
        predecessor_guardian_head_token: predecessor_guardian_head_token,
        transition_kind: transition_kind,
        transition_count: transition_count,
        pod_resurrection_count: pod_resurrection_count,
        loom_authority_verified: loom_authority_verified,
        journal_verified: journal_verified,
        lineage_verified: lineage_verified,
    })
}

fn common_proofs_verify(observed: ObservedContinuity) -> bool {
    observed.loom_authority_verified &&
    observed.journal_verified &&
    observed.lineage_verified
}

pub fn verify_initial_generation(
    observed: ObservedContinuity,
) -> Option<VerifiedInitialGeneration> {
    if !common_proofs_verify(observed) { return None }
    if observed.transition_kind != 1 { return None }
    if observed.transition_count != 0 { return None }
    if observed.pod_resurrection_count != 0 { return None }
    if observed.lineage_head_token != 0 { return None }
    if observed.predecessor_generation_token != 0 { return None }
    if observed.predecessor_semantic_head_token != 0 { return None }
    if observed.predecessor_guardian_head_token != 0 { return None }
    Some(VerifiedInitialGeneration {
        evidence_set_token: observed.evidence_set_token,
        current_generation_token: observed.current_generation_token,
        generation_fingerprint_token: observed.generation_fingerprint_token,
    })
}

pub fn verify_clean_respawn(
    observed: ObservedContinuity,
) -> Option<VerifiedCleanRespawn> {
    if !common_proofs_verify(observed) { return None }
    if observed.transition_kind != 2 { return None }
    if observed.transition_count < 1 { return None }
    if observed.pod_resurrection_count >= observed.transition_count { return None }
    if observed.lineage_head_token <= 0 { return None }
    if observed.predecessor_generation_token <= 0 { return None }
    if observed.predecessor_semantic_head_token <= 0 { return None }
    if observed.predecessor_guardian_head_token <= 0 { return None }
    Some(VerifiedCleanRespawn {
        evidence_set_token: observed.evidence_set_token,
        current_generation_token: observed.current_generation_token,
        generation_fingerprint_token: observed.generation_fingerprint_token,
        lineage_head_token: observed.lineage_head_token,
        predecessor_generation_token: observed.predecessor_generation_token,
        transition_count: observed.transition_count,
        pod_resurrection_count: observed.pod_resurrection_count,
    })
}

pub fn verify_pod_resurrection(
    observed: ObservedContinuity,
) -> Option<VerifiedPodResurrection> {
    if !common_proofs_verify(observed) { return None }
    if observed.transition_kind != 3 { return None }
    if observed.transition_count < 1 { return None }
    if observed.pod_resurrection_count < 1 { return None }
    if observed.pod_resurrection_count > observed.transition_count { return None }
    if observed.lineage_head_token <= 0 { return None }
    if observed.predecessor_generation_token <= 0 { return None }
    if observed.predecessor_semantic_head_token == 0 { return None }
    if observed.predecessor_guardian_head_token <= 0 { return None }
    Some(VerifiedPodResurrection {
        evidence_set_token: observed.evidence_set_token,
        current_generation_token: observed.current_generation_token,
        generation_fingerprint_token: observed.generation_fingerprint_token,
        lineage_head_token: observed.lineage_head_token,
        predecessor_generation_token: observed.predecessor_generation_token,
        transition_count: observed.transition_count,
        pod_resurrection_count: observed.pod_resurrection_count,
    })
}

pub fn promote_initial_generation(receipt: VerifiedInitialGeneration) -> i64 {
    receipt.current_generation_token
}

pub fn promote_clean_respawn(receipt: VerifiedCleanRespawn) -> i64 {
    receipt.current_generation_token
}

pub fn promote_pod_resurrection(receipt: VerifiedPodResurrection) -> i64 {
    receipt.current_generation_token
}

pub fn pod_resurrection_evidence_set(receipt: VerifiedPodResurrection) -> i64 {
    receipt.evidence_set_token
}

pub fn pod_resurrection_lineage_head(receipt: VerifiedPodResurrection) -> i64 {
    receipt.lineage_head_token
}

pub fn pod_resurrection_predecessor(receipt: VerifiedPodResurrection) -> i64 {
    receipt.predecessor_generation_token
}

pub fn pod_resurrection_count(receipt: VerifiedPodResurrection) -> i64 {
    receipt.pod_resurrection_count
}
