}

pub fn verify_journal_authority(
    observed: ObservedPreSpawnObservationAuthorityEvidence,
) -> Option<VerifiedJournalAuthority> {
    if observed.journal_authority_token <= 0 || observed.journal_epoch <= 0 ||
        observed.journal_checkpoint_token <= 0 {
        return None
    }
    Some(VerifiedJournalAuthority {
        authority_token: observed.journal_authority_token,
        epoch: observed.journal_epoch,
        checkpoint_token: observed.journal_checkpoint_token,
    })
}

pub fn observation_authority_roles_are_nominally_distinct(
    decision: VerifiedFullDigestDecisionFacts,
    measurement: VerifiedFullDigestMeasuredFacts,
    journal: VerifiedJournalAuthority,
) -> bool {
    true
}

pub fn verify_observation_authority_admission(
    observed: ObservedPreSpawnObservationAuthorityEvidence,
) -> Option<VerifiedObservationAuthorityAdmission> {
    if observed.predecessor_receipt_token <= 0 ||
        observed.independent_observation_token <= 0 ||
        observed.journal_checkpoint_token <= 0 || observed.journal_epoch <= 0 ||
        !authority_principals_are_pairwise_disjoint(
            observed.signer_authority_token,
            observed.observer_authority_token,
            observed.journal_authority_token,
        ) ||
        !measurement_tokens_agree(
            observed.decision_generation_token,
            observed.decision_fingerprint_token,
            observed.decision_semantic_head_token,
            observed.decision_guardian_head_token,
            observed.measured_generation_token,
            observed.measured_fingerprint_token,
            observed.measured_semantic_head_token,
            observed.measured_guardian_head_token,
        ) ||
        !full_digest_vectors_agree(
            observed.decision_generation_digest,
            observed.decision_fingerprint_digest,
            observed.decision_semantic_head_digest,
            observed.decision_guardian_head_digest,
            observed.measured_generation_digest,
            observed.measured_fingerprint_digest,
            observed.measured_semantic_head_digest,
            observed.measured_guardian_head_digest,
        ) {
        return None
    }
    Some(VerifiedObservationAuthorityAdmission {
        decision: VerifiedFullDigestDecisionFacts {
            generation_digest: observed.decision_generation_digest,
            fingerprint_digest: observed.decision_fingerprint_digest,
            semantic_head_digest: observed.decision_semantic_head_digest,
            guardian_head_digest: observed.decision_guardian_head_digest,
        },
        measurement: VerifiedFullDigestMeasuredFacts {
            generation_digest: observed.measured_generation_digest,
            fingerprint_digest: observed.measured_fingerprint_digest,
            semantic_head_digest: observed.measured_semantic_head_digest,
            guardian_head_digest: observed.measured_guardian_head_digest,
        },
        journal: VerifiedJournalAuthority {
            authority_token: observed.journal_authority_token,
            epoch: observed.journal_epoch,
            checkpoint_token: observed.journal_checkpoint_token,
        },
        authorities: VerifiedThreeWayDisjointAuthorities {
            signer_authority_token: observed.signer_authority_token,
            observer_authority_token: observed.observer_authority_token,
            journal_authority_token: observed.journal_authority_token,
        },
        agreement: VerifiedFullDigestAgreement {
            generation_digest: observed.measured_generation_digest,
            fingerprint_digest: observed.measured_fingerprint_digest,
            semantic_head_digest: observed.measured_semantic_head_digest,
            guardian_head_digest: observed.measured_guardian_head_digest,
        },
        predecessor_receipt_token: observed.predecessor_receipt_token,
    })
}

pub fn promote_observation_authority_admission(
    receipt: VerifiedObservationAuthorityAdmission,
) -> i64 {
    let VerifiedObservationAuthorityAdmission {
        decision,
        measurement,
        journal,
        authorities,
        agreement,
        predecessor_receipt_token,
    } = receipt
    predecessor_receipt_token
}

