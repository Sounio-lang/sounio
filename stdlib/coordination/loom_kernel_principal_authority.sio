//! Sounio-first authority for LOOM kernel-principal extrusion certificates.
//!
//! Action 9026 decides whether a lane that began under a shared outer Unix
//! identity was materially extruded into a distinct, attack-tested principal.

struct LoomKernelPrincipalDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomKernelPrincipalSubstrate {
    linux: i64,
    x86_64: i64,
    user_namespace: i64,
    pid_namespace: i64,
    mount_namespace: i64,
    cgroup_v2: i64,
}

struct LoomKernelPrincipalMapping {
    allocation_ready: i64,
    uid_map_exact: i64,
    gid_map_exact: i64,
    setgroups_denied_first: i64,
    ranges_disjoint: i64,
    outer_uid: i64,
    principal_uid: i64,
    sibling_uid: i64,
    outer_gid: i64,
    principal_gid: i64,
    sibling_gid: i64,
}

struct LoomKernelPrincipalPeer {
    so_peercred_bound: i64,
    pidfd_bound: i64,
    start_tick_bound: i64,
    boot_identity_bound: i64,
    executable_bound: i64,
    ancestry_bound: i64,
    worktree_bound: i64,
    cgroup_bound: i64,
}

struct LoomKernelPrincipalIsolation {
    non_dumpable: i64,
    no_new_privileges: i64,
    cap_sys_ptrace_absent: i64,
    ptrace_denied: i64,
    proc_mem_denied: i64,
    cross_principal_signal_denied: i64,
}

struct LoomKernelPrincipalGrant {
    memory_only: i64,
    atomic_transition: i64,
    one_shot: i64,
    unauthorized_refusal_nonburning: i64,
    crash_revokes: i64,
    sabotage_count: i64,
    sabotage_required: i64,
    receipt_bound: i64,
}

struct LoomKernelPrincipalBindings {
    parent_9025_manifest_hash: LoomKernelPrincipalDigest256,
    allocation_hash: LoomKernelPrincipalDigest256,
    uid_map_hash: LoomKernelPrincipalDigest256,
    gid_map_hash: LoomKernelPrincipalDigest256,
    peer_measurement_hash: LoomKernelPrincipalDigest256,
    attack_observation_hash: LoomKernelPrincipalDigest256,
    source_hash: LoomKernelPrincipalDigest256,
    semantics_hash: LoomKernelPrincipalDigest256,
    toolchain_hash: LoomKernelPrincipalDigest256,
    hardware_hash: LoomKernelPrincipalDigest256,
    command_hash: LoomKernelPrincipalDigest256,
    result_hash: LoomKernelPrincipalDigest256,
}

pub fn admit_loom_kernel_principal_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> LoomKernelPrincipalDigest256 {
    LoomKernelPrincipalDigest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
}

pub fn admit_loom_kernel_principal_substrate(
    linux: i64,
    x86_64: i64,
    user_namespace: i64,
    pid_namespace: i64,
    mount_namespace: i64,
    cgroup_v2: i64,
) -> LoomKernelPrincipalSubstrate {
    LoomKernelPrincipalSubstrate {
        linux: linux,
        x86_64: x86_64,
        user_namespace: user_namespace,
        pid_namespace: pid_namespace,
        mount_namespace: mount_namespace,
        cgroup_v2: cgroup_v2,
    }
}

pub fn admit_loom_kernel_principal_mapping(
    allocation_ready: i64,
    uid_map_exact: i64,
    gid_map_exact: i64,
    setgroups_denied_first: i64,
    ranges_disjoint: i64,
    outer_uid: i64,
    principal_uid: i64,
    sibling_uid: i64,
    outer_gid: i64,
    principal_gid: i64,
    sibling_gid: i64,
) -> LoomKernelPrincipalMapping {
    LoomKernelPrincipalMapping {
        allocation_ready: allocation_ready,
        uid_map_exact: uid_map_exact,
        gid_map_exact: gid_map_exact,
        setgroups_denied_first: setgroups_denied_first,
        ranges_disjoint: ranges_disjoint,
        outer_uid: outer_uid,
        principal_uid: principal_uid,
        sibling_uid: sibling_uid,
        outer_gid: outer_gid,
        principal_gid: principal_gid,
        sibling_gid: sibling_gid,
    }
}

pub fn admit_loom_kernel_principal_peer(
    so_peercred_bound: i64,
    pidfd_bound: i64,
    start_tick_bound: i64,
    boot_identity_bound: i64,
    executable_bound: i64,
    ancestry_bound: i64,
    worktree_bound: i64,
    cgroup_bound: i64,
) -> LoomKernelPrincipalPeer {
    LoomKernelPrincipalPeer {
        so_peercred_bound: so_peercred_bound,
        pidfd_bound: pidfd_bound,
        start_tick_bound: start_tick_bound,
        boot_identity_bound: boot_identity_bound,
        executable_bound: executable_bound,
        ancestry_bound: ancestry_bound,
        worktree_bound: worktree_bound,
        cgroup_bound: cgroup_bound,
    }
}

pub fn admit_loom_kernel_principal_isolation(
    non_dumpable: i64,
    no_new_privileges: i64,
    cap_sys_ptrace_absent: i64,
    ptrace_denied: i64,
    proc_mem_denied: i64,
    cross_principal_signal_denied: i64,
) -> LoomKernelPrincipalIsolation {
    LoomKernelPrincipalIsolation {
        non_dumpable: non_dumpable,
        no_new_privileges: no_new_privileges,
        cap_sys_ptrace_absent: cap_sys_ptrace_absent,
        ptrace_denied: ptrace_denied,
        proc_mem_denied: proc_mem_denied,
        cross_principal_signal_denied: cross_principal_signal_denied,
    }
}

pub fn admit_loom_kernel_principal_grant(
    memory_only: i64,
    atomic_transition: i64,
    one_shot: i64,
    unauthorized_refusal_nonburning: i64,
    crash_revokes: i64,
    sabotage_count: i64,
    sabotage_required: i64,
    receipt_bound: i64,
) -> LoomKernelPrincipalGrant {
    LoomKernelPrincipalGrant {
        memory_only: memory_only,
        atomic_transition: atomic_transition,
        one_shot: one_shot,
        unauthorized_refusal_nonburning: unauthorized_refusal_nonburning,
        crash_revokes: crash_revokes,
        sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
        receipt_bound: receipt_bound,
    }
}

pub fn admit_loom_kernel_principal_bindings(
    parent_9025_manifest_hash: LoomKernelPrincipalDigest256,
    allocation_hash: LoomKernelPrincipalDigest256,
    uid_map_hash: LoomKernelPrincipalDigest256,
    gid_map_hash: LoomKernelPrincipalDigest256,
    peer_measurement_hash: LoomKernelPrincipalDigest256,
    attack_observation_hash: LoomKernelPrincipalDigest256,
    source_hash: LoomKernelPrincipalDigest256,
    semantics_hash: LoomKernelPrincipalDigest256,
    toolchain_hash: LoomKernelPrincipalDigest256,
    hardware_hash: LoomKernelPrincipalDigest256,
    command_hash: LoomKernelPrincipalDigest256,
    result_hash: LoomKernelPrincipalDigest256,
) -> LoomKernelPrincipalBindings {
    LoomKernelPrincipalBindings {
        parent_9025_manifest_hash: parent_9025_manifest_hash,
        allocation_hash: allocation_hash,
        uid_map_hash: uid_map_hash,
        gid_map_hash: gid_map_hash,
        peer_measurement_hash: peer_measurement_hash,
        attack_observation_hash: attack_observation_hash,
        source_hash: source_hash,
        semantics_hash: semantics_hash,
        toolchain_hash: toolchain_hash,
        hardware_hash: hardware_hash,
        command_hash: command_hash,
        result_hash: result_hash,
    }
}

fn loom_kernel_principal_flag(value: i64) -> bool {
    value == 0 || value == 1
}

fn loom_kernel_principal_digest_nonzero(value: LoomKernelPrincipalDigest256) -> bool {
    value.limb0 != 0 || value.limb1 != 0 || value.limb2 != 0 ||
        value.limb3 != 0 || value.limb4 != 0 || value.limb5 != 0 ||
        value.limb6 != 0 || value.limb7 != 0
}

pub fn loom_kernel_principal_authority_decide(
    stage: i64,
    parent_9025_frozen: i64,
    substrate: LoomKernelPrincipalSubstrate,
    mapping: LoomKernelPrincipalMapping,
    peer: LoomKernelPrincipalPeer,
    isolation: LoomKernelPrincipalIsolation,
    grant: LoomKernelPrincipalGrant,
    bindings: LoomKernelPrincipalBindings,
) -> i64 {
    if stage < 1 || stage > 7 ||
        !loom_kernel_principal_flag(parent_9025_frozen) ||
        !loom_kernel_principal_flag(substrate.linux) ||
        !loom_kernel_principal_flag(substrate.x86_64) ||
        !loom_kernel_principal_flag(substrate.user_namespace) ||
        !loom_kernel_principal_flag(substrate.pid_namespace) ||
        !loom_kernel_principal_flag(substrate.mount_namespace) ||
        !loom_kernel_principal_flag(substrate.cgroup_v2) ||
        !loom_kernel_principal_flag(mapping.allocation_ready) ||
        !loom_kernel_principal_flag(mapping.uid_map_exact) ||
        !loom_kernel_principal_flag(mapping.gid_map_exact) ||
        !loom_kernel_principal_flag(mapping.setgroups_denied_first) ||
        !loom_kernel_principal_flag(mapping.ranges_disjoint) ||
        mapping.outer_uid < 0 || mapping.principal_uid < 0 ||
        mapping.sibling_uid < 0 || mapping.outer_gid < 0 ||
        mapping.principal_gid < 0 || mapping.sibling_gid < 0 ||
        !loom_kernel_principal_flag(peer.so_peercred_bound) ||
        !loom_kernel_principal_flag(peer.pidfd_bound) ||
        !loom_kernel_principal_flag(peer.start_tick_bound) ||
        !loom_kernel_principal_flag(peer.boot_identity_bound) ||
        !loom_kernel_principal_flag(peer.executable_bound) ||
        !loom_kernel_principal_flag(peer.ancestry_bound) ||
        !loom_kernel_principal_flag(peer.worktree_bound) ||
        !loom_kernel_principal_flag(peer.cgroup_bound) ||
        !loom_kernel_principal_flag(isolation.non_dumpable) ||
        !loom_kernel_principal_flag(isolation.no_new_privileges) ||
        !loom_kernel_principal_flag(isolation.cap_sys_ptrace_absent) ||
        !loom_kernel_principal_flag(isolation.ptrace_denied) ||
        !loom_kernel_principal_flag(isolation.proc_mem_denied) ||
        !loom_kernel_principal_flag(isolation.cross_principal_signal_denied) ||
        !loom_kernel_principal_flag(grant.memory_only) ||
        !loom_kernel_principal_flag(grant.atomic_transition) ||
        !loom_kernel_principal_flag(grant.one_shot) ||
        !loom_kernel_principal_flag(grant.unauthorized_refusal_nonburning) ||
        !loom_kernel_principal_flag(grant.crash_revokes) ||
        grant.sabotage_count < 0 || grant.sabotage_count > 5 ||
        grant.sabotage_required < 0 || grant.sabotage_required > 5 ||
        !loom_kernel_principal_flag(grant.receipt_bound) {
        return 424
    }
    if stage < 3 || parent_9025_frozen != 1 ||
        !loom_kernel_principal_digest_nonzero(bindings.parent_9025_manifest_hash) {
        return 405
    }
    if substrate.linux != 1 || substrate.x86_64 != 1 ||
        substrate.user_namespace != 1 || substrate.pid_namespace != 1 ||
        substrate.mount_namespace != 1 || substrate.cgroup_v2 != 1 {
        return 454
    }
    if mapping.allocation_ready != 1 || mapping.ranges_disjoint != 1 { return 455 }
    if mapping.uid_map_exact != 1 || mapping.gid_map_exact != 1 ||
        mapping.setgroups_denied_first != 1 { return 456 }

    // Causal control: removing only this line admits equal kernel principals.
    if mapping.outer_uid == mapping.principal_uid || mapping.outer_uid == mapping.sibling_uid || mapping.principal_uid == mapping.sibling_uid || mapping.outer_gid == mapping.principal_gid || mapping.outer_gid == mapping.sibling_gid || mapping.principal_gid == mapping.sibling_gid { return 457 }

    if peer.so_peercred_bound != 1 || peer.pidfd_bound != 1 ||
        peer.start_tick_bound != 1 || peer.boot_identity_bound != 1 ||
        peer.executable_bound != 1 || peer.ancestry_bound != 1 ||
        peer.worktree_bound != 1 || peer.cgroup_bound != 1 { return 458 }

    // Causal control: removing only this line admits a process-injectable lane.
    if isolation.non_dumpable != 1 || isolation.no_new_privileges != 1 || isolation.cap_sys_ptrace_absent != 1 || isolation.ptrace_denied != 1 || isolation.proc_mem_denied != 1 || isolation.cross_principal_signal_denied != 1 { return 459 }

    if grant.memory_only != 1 || grant.atomic_transition != 1 ||
        grant.one_shot != 1 { return 460 }

    // Causal control: removing only this line lets an outsider burn the grant.
    if grant.unauthorized_refusal_nonburning != 1 { return 460 }

    // Causal control: removing only this line lets a grant survive kernel loss.
    if grant.crash_revokes != 1 { return 460 }

    // Causal control: removing only this line admits incomplete attack evidence.
    if grant.sabotage_count != 5 || grant.sabotage_required != 5 { return 461 }

    if grant.receipt_bound != 1 ||
        !loom_kernel_principal_digest_nonzero(bindings.allocation_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.uid_map_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.gid_map_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.peer_measurement_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.attack_observation_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.source_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.semantics_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.toolchain_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.hardware_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.command_hash) ||
        !loom_kernel_principal_digest_nonzero(bindings.result_hash) { return 462 }
    0
}

fn loom_kernel_principal_test_digest(kind: i64) -> LoomKernelPrincipalDigest256 {
    if kind == 1 {
        return admit_loom_kernel_principal_digest256(1, 1, 1, 1, 1, 1, 1, 1)
    }
    admit_loom_kernel_principal_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn loom_kernel_principal_test_case(
    stage: i64,
    parent: i64,
    substrate: i64,
    allocation: i64,
    mapping: i64,
    outer_uid: i64,
    principal_uid: i64,
    sibling_uid: i64,
    outer_gid: i64,
    principal_gid: i64,
    sibling_gid: i64,
    peer: i64,
    isolation: i64,
    grant: i64,
    nonburning: i64,
    revokes: i64,
    sabotage_count: i64,
    receipt: i64,
    parent_digest: i64,
    provenance_digest: i64,
) -> i64 {
    let digest = loom_kernel_principal_test_digest(provenance_digest)
    loom_kernel_principal_authority_decide(
        stage,
        parent,
        admit_loom_kernel_principal_substrate(
            substrate, substrate, substrate, substrate, substrate, substrate,
        ),
        admit_loom_kernel_principal_mapping(
            allocation, mapping, mapping, mapping, allocation,
            outer_uid, principal_uid, sibling_uid,
            outer_gid, principal_gid, sibling_gid,
        ),
        admit_loom_kernel_principal_peer(
            peer, peer, peer, peer, peer, peer, peer, peer,
        ),
        admit_loom_kernel_principal_isolation(
            isolation, isolation, isolation, isolation, isolation, isolation,
        ),
        admit_loom_kernel_principal_grant(
            grant, grant, grant, nonburning, revokes, sabotage_count, 5, receipt,
        ),
        admit_loom_kernel_principal_bindings(
            loom_kernel_principal_test_digest(parent_digest),
            digest, digest, digest, digest, digest, digest, digest,
            digest, digest, digest, digest,
        ),
    )
}

pub fn loom_kernel_principal_authority_selftest() -> i64 {
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 1) != 0 { return 1 }
    if loom_kernel_principal_test_case(2, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 1) != 405 { return 2 }
    if loom_kernel_principal_test_case(3, 0, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 1) != 405 { return 3 }
    if loom_kernel_principal_test_case(3, 1, 0, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 1) != 454 { return 4 }
    if loom_kernel_principal_test_case(3, 1, 1, 0, 0, 1000, 1000, 1000, 1000, 1000, 1000, 1, 1, 1, 1, 1, 0, 0, 1, 0) != 455 { return 5 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 0, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 1) != 456 { return 6 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 1000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 1) != 457 { return 7 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 0, 1, 1, 1, 1, 5, 1, 1, 1) != 458 { return 8 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 0, 1, 1, 1, 5, 1, 1, 1) != 459 { return 9 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 0, 1, 1, 5, 1, 1, 1) != 460 { return 10 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 0, 1, 5, 1, 1, 1) != 460 { return 11 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 0, 5, 1, 1, 1) != 460 { return 12 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 4, 1, 1, 1) != 461 { return 13 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 0, 1, 1) != 462 { return 14 }
    if loom_kernel_principal_test_case(3, 1, 2, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 1) != 424 { return 15 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 0, 1) != 405 { return 16 }
    if loom_kernel_principal_test_case(3, 1, 1, 1, 1, 1000, 100000, 100001, 1000, 100000, 100001, 1, 1, 1, 1, 1, 5, 1, 1, 0) != 462 { return 17 }
    0
}
