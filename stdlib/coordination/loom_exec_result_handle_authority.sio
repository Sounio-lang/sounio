//! LOOM action 9033: semantic authority for an event-bound ExecCell result.
//!
//! A result handle is a public, immutable lookup identity. It is never an
//! ExecGrant, ActivationCapsule, bearer token, or proof of material execution.

struct LoomExecResultDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomExecResultParents {
    action_9030_manifest_sha256: LoomExecResultDigest256,
    action_9031_manifest_sha256: LoomExecResultDigest256,
    action_9030_close_allow: i64,
    action_9031_extinguish_allow: i64,
    grant_generation: i64,
}

struct LoomExecResultBindings {
    event_sha256: LoomExecResultDigest256,
    command_sha256: LoomExecResultDigest256,
    result_receipt_sha256: LoomExecResultDigest256,
}

struct LoomExecResultTerminal {
    outcome_done: i64,
    exit_status_bound: i64,
    stdout_sha256_bound: i64,
    stderr_sha256_bound: i64,
    exec_pid_extinct: i64,
    descendants_extinct: i64,
    cgroup_empty: i64,
    transient_unit_inactive: i64,
    grant_authority_extinct: i64,
    activation_capsule_extinct: i64,
}

struct LoomExecResultStorage {
    result_receipt_immutable: i64,
    result_receipt_content_addressed: i64,
    result_receipt_hash_verified: i64,
    handle_prewrite_absent: i64,
    atomic_commit_ready: i64,
    handle_commit_verified: i64,
}

struct LoomExecResultAccess {
    reader_read_only: i64,
    handle_lookup_only: i64,
    handle_not_authority: i64,
    handle_cannot_issue: i64,
    handle_cannot_consume: i64,
    handle_cannot_execute: i64,
    handle_cannot_replay: i64,
}

struct LoomExecResultAuthority {
    producer_sounio: i64,
    expected_result_sounio: i64,
    python_absent: i64,
    rust_absent: i64,
    review_unpromoted: i64,
    parity_unpromoted: i64,
    disposable_oracle_absent: i64,
}

struct LoomExecResultEvidence {
    provenance_complete: i64,
    material_observation_joined: i64,
    receipt_bound: i64,
    sabotage_count: i64,
    sabotage_required: i64,
}

struct LoomExecResultObservation {
    stage: i64,
    preregistered: i64,
    operation: i64,
    parents: LoomExecResultParents,
    bindings: LoomExecResultBindings,
    terminal: LoomExecResultTerminal,
    storage: LoomExecResultStorage,
    access: LoomExecResultAccess,
    authority: LoomExecResultAuthority,
    evidence: LoomExecResultEvidence,
}

pub fn loom_exec_result_digest256(
    limb0: i64, limb1: i64, limb2: i64, limb3: i64,
    limb4: i64, limb5: i64, limb6: i64, limb7: i64,
) -> LoomExecResultDigest256 {
    LoomExecResultDigest256 {
        limb0: limb0, limb1: limb1, limb2: limb2, limb3: limb3,
        limb4: limb4, limb5: limb5, limb6: limb6, limb7: limb7,
    }
}

pub fn loom_exec_result_parents(
    action_9030_manifest_sha256: LoomExecResultDigest256,
    action_9031_manifest_sha256: LoomExecResultDigest256,
    action_9030_close_allow: i64,
    action_9031_extinguish_allow: i64,
    grant_generation: i64,
) -> LoomExecResultParents {
    LoomExecResultParents {
        action_9030_manifest_sha256: action_9030_manifest_sha256,
        action_9031_manifest_sha256: action_9031_manifest_sha256,
        action_9030_close_allow: action_9030_close_allow,
        action_9031_extinguish_allow: action_9031_extinguish_allow,
        grant_generation: grant_generation,
    }
}

pub fn loom_exec_result_bindings(
    event_sha256: LoomExecResultDigest256,
    command_sha256: LoomExecResultDigest256,
    result_receipt_sha256: LoomExecResultDigest256,
) -> LoomExecResultBindings {
    LoomExecResultBindings {
        event_sha256: event_sha256,
        command_sha256: command_sha256,
        result_receipt_sha256: result_receipt_sha256,
    }
}

pub fn loom_exec_result_terminal(
    outcome_done: i64, exit_status_bound: i64,
    stdout_sha256_bound: i64, stderr_sha256_bound: i64,
    exec_pid_extinct: i64, descendants_extinct: i64,
    cgroup_empty: i64, transient_unit_inactive: i64,
    grant_authority_extinct: i64, activation_capsule_extinct: i64,
) -> LoomExecResultTerminal {
    LoomExecResultTerminal {
        outcome_done: outcome_done, exit_status_bound: exit_status_bound,
        stdout_sha256_bound: stdout_sha256_bound,
        stderr_sha256_bound: stderr_sha256_bound,
        exec_pid_extinct: exec_pid_extinct,
        descendants_extinct: descendants_extinct,
        cgroup_empty: cgroup_empty,
        transient_unit_inactive: transient_unit_inactive,
        grant_authority_extinct: grant_authority_extinct,
        activation_capsule_extinct: activation_capsule_extinct,
    }
}

pub fn loom_exec_result_storage(
    result_receipt_immutable: i64,
    result_receipt_content_addressed: i64,
    result_receipt_hash_verified: i64,
    handle_prewrite_absent: i64,
    atomic_commit_ready: i64,
    handle_commit_verified: i64,
) -> LoomExecResultStorage {
    LoomExecResultStorage {
        result_receipt_immutable: result_receipt_immutable,
        result_receipt_content_addressed: result_receipt_content_addressed,
        result_receipt_hash_verified: result_receipt_hash_verified,
        handle_prewrite_absent: handle_prewrite_absent,
        atomic_commit_ready: atomic_commit_ready,
        handle_commit_verified: handle_commit_verified,
    }
}

pub fn loom_exec_result_access(
    reader_read_only: i64, handle_lookup_only: i64,
    handle_not_authority: i64, handle_cannot_issue: i64,
    handle_cannot_consume: i64, handle_cannot_execute: i64,
    handle_cannot_replay: i64,
) -> LoomExecResultAccess {
    LoomExecResultAccess {
        reader_read_only: reader_read_only,
        handle_lookup_only: handle_lookup_only,
        handle_not_authority: handle_not_authority,
        handle_cannot_issue: handle_cannot_issue,
        handle_cannot_consume: handle_cannot_consume,
        handle_cannot_execute: handle_cannot_execute,
        handle_cannot_replay: handle_cannot_replay,
    }
}

pub fn loom_exec_result_authority(
    producer_sounio: i64, expected_result_sounio: i64,
    python_absent: i64, rust_absent: i64,
    review_unpromoted: i64, parity_unpromoted: i64,
    disposable_oracle_absent: i64,
) -> LoomExecResultAuthority {
    LoomExecResultAuthority {
        producer_sounio: producer_sounio,
        expected_result_sounio: expected_result_sounio,
        python_absent: python_absent, rust_absent: rust_absent,
        review_unpromoted: review_unpromoted,
        parity_unpromoted: parity_unpromoted,
        disposable_oracle_absent: disposable_oracle_absent,
    }
}

pub fn loom_exec_result_evidence(
    provenance_complete: i64, material_observation_joined: i64,
    receipt_bound: i64, sabotage_count: i64, sabotage_required: i64,
) -> LoomExecResultEvidence {
    LoomExecResultEvidence {
        provenance_complete: provenance_complete,
        material_observation_joined: material_observation_joined,
        receipt_bound: receipt_bound, sabotage_count: sabotage_count,
        sabotage_required: sabotage_required,
    }
}

pub fn loom_exec_result_observation(
    stage: i64, preregistered: i64, operation: i64,
    parents: LoomExecResultParents,
    bindings: LoomExecResultBindings,
    terminal: LoomExecResultTerminal,
    storage: LoomExecResultStorage,
    access: LoomExecResultAccess,
    authority: LoomExecResultAuthority,
    evidence: LoomExecResultEvidence,
) -> LoomExecResultObservation {
    LoomExecResultObservation {
        stage: stage, preregistered: preregistered, operation: operation,
        parents: parents, bindings: bindings, terminal: terminal,
        storage: storage, access: access, authority: authority,
        evidence: evidence,
    }
}

fn loom_exec_result_digest_equal(
    left: LoomExecResultDigest256,
    right: LoomExecResultDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn loom_exec_result_zero() -> LoomExecResultDigest256 {
    loom_exec_result_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn loom_exec_result_parent_9030() -> LoomExecResultDigest256 {
    loom_exec_result_digest256(
        2257049737, 3767494937, 229307341, 3202361153,
        3454258786, 4046895715, 3743394242, 3434139729,
    )
}

fn loom_exec_result_parent_9031() -> LoomExecResultDigest256 {
    loom_exec_result_digest256(
        4074394899, 2345657768, 2730909373, 2042750260,
        4048728890, 4123446333, 522931891, 3031395966,
    )
}

fn loom_exec_result_fixture_event() -> LoomExecResultDigest256 {
    loom_exec_result_digest256(
        289083261, 706706140, 1533585710, 4084982632,
        2597125707, 3137391438, 2350251066, 3082223635,
    )
}

fn loom_exec_result_fixture_command() -> LoomExecResultDigest256 {
    loom_exec_result_digest256(
        134198296, 1998023264, 2957593053, 2026443539,
        2504906585, 1497309287, 2048602063, 4003666528,
    )
}

fn loom_exec_result_fixture_receipt() -> LoomExecResultDigest256 {
    loom_exec_result_digest256(
        1476781655, 2607030458, 232166355, 2238798147,
        2505903721, 3864523854, 2497854752, 2718771153,
    )
}

fn loom_exec_result_command_binding_rule(
    command_sha256: LoomExecResultDigest256,
) -> bool {
    loom_exec_result_digest_equal(
        command_sha256,
        loom_exec_result_fixture_command(),
    )
}

// 1 = PUBLISH, 2 = RESOLVE. Other values are fail-closed refusal codes.
pub fn judge_loom_exec_result_handle(
    observation: LoomExecResultObservation,
) -> i64 {
    if observation.stage != 3 || observation.preregistered != 1 ||
        (observation.operation != 1 && observation.operation != 2) {
        return 405
    }
    if observation.authority.producer_sounio != 1 ||
        observation.authority.expected_result_sounio != 1 ||
        observation.authority.python_absent != 1 ||
        observation.authority.rust_absent != 1 ||
        observation.authority.review_unpromoted != 1 ||
        observation.authority.parity_unpromoted != 1 ||
        observation.authority.disposable_oracle_absent != 1 {
        return 532
    }
    if !loom_exec_result_digest_equal(
            observation.parents.action_9030_manifest_sha256,
            loom_exec_result_parent_9030()) ||
        !loom_exec_result_digest_equal(
            observation.parents.action_9031_manifest_sha256,
            loom_exec_result_parent_9031()) ||
        observation.parents.action_9030_close_allow != 1 ||
        observation.parents.action_9031_extinguish_allow != 1 ||
        observation.parents.grant_generation != 1 {
        return 533
    }
    if !loom_exec_result_digest_equal(
            observation.bindings.event_sha256,
            loom_exec_result_fixture_event()) {
        return 534
    }
    // Causal control: deleting only this command-binding rule must admit the
    // unchanged wrong-command witness.
    if !loom_exec_result_command_binding_rule(
            observation.bindings.command_sha256) {
        return 534
    }
    if !loom_exec_result_digest_equal(
            observation.bindings.result_receipt_sha256,
            loom_exec_result_fixture_receipt()) {
        return 534
    }
    if observation.terminal.outcome_done != 1 ||
        observation.terminal.exit_status_bound != 1 ||
        observation.terminal.stdout_sha256_bound != 1 ||
        observation.terminal.stderr_sha256_bound != 1 {
        return 535
    }
    if observation.terminal.exec_pid_extinct != 1 ||
        observation.terminal.descendants_extinct != 1 ||
        observation.terminal.cgroup_empty != 1 ||
        observation.terminal.transient_unit_inactive != 1 ||
        observation.terminal.grant_authority_extinct != 1 ||
        observation.terminal.activation_capsule_extinct != 1 {
        return 536
    }
    if observation.storage.result_receipt_immutable != 1 ||
        observation.storage.result_receipt_content_addressed != 1 ||
        observation.storage.result_receipt_hash_verified != 1 {
        return 537
    }
    if observation.access.reader_read_only != 1 ||
        observation.access.handle_lookup_only != 1 ||
        observation.access.handle_not_authority != 1 ||
        observation.access.handle_cannot_issue != 1 ||
        observation.access.handle_cannot_consume != 1 ||
        observation.access.handle_cannot_execute != 1 ||
        observation.access.handle_cannot_replay != 1 {
        return 538
    }
    if observation.evidence.provenance_complete != 1 ||
        observation.evidence.material_observation_joined != 1 ||
        observation.evidence.receipt_bound != 1 {
        return 539
    }
    if observation.evidence.sabotage_required <= 0 ||
        observation.evidence.sabotage_count < observation.evidence.sabotage_required {
        return 540
    }
    if observation.operation == 1 {
        if observation.storage.handle_prewrite_absent != 1 ||
            observation.storage.atomic_commit_ready != 1 ||
            observation.storage.handle_commit_verified != 0 {
            return 537
        }
        return 1
    }
    if observation.storage.handle_prewrite_absent != 0 ||
        observation.storage.atomic_commit_ready != 0 ||
        observation.storage.handle_commit_verified != 1 {
        return 537
    }
    2
}

fn loom_exec_result_v1_bit(mask: i64, divisor: i64) -> i64 with Div {
    (mask / divisor) % 2
}

// Closed scalar projection for the exact frozen V1 fixture. Every selected
// digest is still materialized and compared by the semantic judgment above.
pub fn judge_loom_exec_result_handle_v1_frame(
    stage: i64, preregistered: i64, operation: i64,
    binding_mask: i64, terminal_mask: i64, storage_mask: i64,
    access_mask: i64, authority_mask: i64, evidence_mask: i64,
    sabotage_count: i64, sabotage_required: i64,
) -> i64 with Div {
    let parents = loom_exec_result_parents(
        if loom_exec_result_v1_bit(binding_mask, 1) == 1 {
            loom_exec_result_parent_9030()
        } else { loom_exec_result_zero() },
        if loom_exec_result_v1_bit(binding_mask, 2) == 1 {
            loom_exec_result_parent_9031()
        } else { loom_exec_result_zero() },
        loom_exec_result_v1_bit(binding_mask, 4),
        loom_exec_result_v1_bit(binding_mask, 8),
        loom_exec_result_v1_bit(binding_mask, 16),
    )
    let bindings = loom_exec_result_bindings(
        if loom_exec_result_v1_bit(binding_mask, 32) == 1 {
            loom_exec_result_fixture_event()
        } else { loom_exec_result_zero() },
        if loom_exec_result_v1_bit(binding_mask, 64) == 1 {
            loom_exec_result_fixture_command()
        } else { loom_exec_result_zero() },
        if loom_exec_result_v1_bit(binding_mask, 128) == 1 {
            loom_exec_result_fixture_receipt()
        } else { loom_exec_result_zero() },
    )
    let terminal = loom_exec_result_terminal(
        loom_exec_result_v1_bit(terminal_mask, 1),
        loom_exec_result_v1_bit(terminal_mask, 2),
        loom_exec_result_v1_bit(terminal_mask, 4),
        loom_exec_result_v1_bit(terminal_mask, 8),
        loom_exec_result_v1_bit(terminal_mask, 16),
        loom_exec_result_v1_bit(terminal_mask, 32),
        loom_exec_result_v1_bit(terminal_mask, 64),
        loom_exec_result_v1_bit(terminal_mask, 128),
        loom_exec_result_v1_bit(terminal_mask, 256),
        loom_exec_result_v1_bit(terminal_mask, 512),
    )
    let storage = loom_exec_result_storage(
        loom_exec_result_v1_bit(storage_mask, 1),
        loom_exec_result_v1_bit(storage_mask, 2),
        loom_exec_result_v1_bit(storage_mask, 4),
        loom_exec_result_v1_bit(storage_mask, 8),
        loom_exec_result_v1_bit(storage_mask, 16),
        loom_exec_result_v1_bit(storage_mask, 32),
    )
    let access = loom_exec_result_access(
        loom_exec_result_v1_bit(access_mask, 1),
        loom_exec_result_v1_bit(access_mask, 2),
        loom_exec_result_v1_bit(access_mask, 4),
        loom_exec_result_v1_bit(access_mask, 8),
        loom_exec_result_v1_bit(access_mask, 16),
        loom_exec_result_v1_bit(access_mask, 32),
        loom_exec_result_v1_bit(access_mask, 64),
    )
    let authority = loom_exec_result_authority(
        loom_exec_result_v1_bit(authority_mask, 1),
        loom_exec_result_v1_bit(authority_mask, 2),
        loom_exec_result_v1_bit(authority_mask, 4),
        loom_exec_result_v1_bit(authority_mask, 8),
        loom_exec_result_v1_bit(authority_mask, 16),
        loom_exec_result_v1_bit(authority_mask, 32),
        loom_exec_result_v1_bit(authority_mask, 64),
    )
    let evidence = loom_exec_result_evidence(
        loom_exec_result_v1_bit(evidence_mask, 1),
        loom_exec_result_v1_bit(evidence_mask, 2),
        loom_exec_result_v1_bit(evidence_mask, 4),
        sabotage_count, sabotage_required,
    )
    judge_loom_exec_result_handle(loom_exec_result_observation(
        stage, preregistered, operation, parents, bindings, terminal,
        storage, access, authority, evidence,
    ))
}

// Three bounded words avoid the current lean_single stdin path's large-decimal
// ABI defect while preserving the same i64 semantic fields.
pub fn judge_loom_exec_result_handle_v1_words(
    word0: i64,
    word1: i64,
    word2: i64,
) -> i64 with Div {
    let stage = word0 & 3
    let preregistered = (word0 >> 2) & 1
    let operation = (word0 >> 3) & 3
    let binding_mask = (word0 >> 5) & 255
    let terminal_mask = (word0 >> 13) & 1023
    let storage_mask = (word0 >> 23) & 63
    let access_mask = word1 & 127
    let authority_mask = (word1 >> 7) & 127
    let evidence_mask = (word1 >> 14) & 7
    let sabotage_count = (word1 >> 17) & 255
    let sabotage_required = word2 & 255
    judge_loom_exec_result_handle_v1_frame(
        stage, preregistered, operation, binding_mask, terminal_mask,
        storage_mask, access_mask, authority_mask, evidence_mask,
        sabotage_count, sabotage_required,
    )
}

fn loom_exec_result_case(case_index: i64) -> i64 {
    let resolve = case_index == 2
    let parents = loom_exec_result_parents(
        if case_index == 5 { loom_exec_result_zero() } else { loom_exec_result_parent_9030() },
        loom_exec_result_parent_9031(), 1, 1, 1,
    )
    let bindings = loom_exec_result_bindings(
        if case_index == 6 { loom_exec_result_zero() } else { loom_exec_result_fixture_event() },
        if case_index == 7 { loom_exec_result_zero() } else { loom_exec_result_fixture_command() },
        if case_index == 8 { loom_exec_result_zero() } else { loom_exec_result_fixture_receipt() },
    )
    let terminal = loom_exec_result_terminal(
        if case_index == 9 { 0 } else { 1 }, 1, 1, 1,
        if case_index == 10 { 0 } else { 1 }, 1, 1, 1, 1, 1,
    )
    let storage = loom_exec_result_storage(
        1, 1, 1,
        if resolve || case_index == 11 { 0 } else { 1 },
        if resolve { 0 } else { 1 },
        if resolve { 1 } else { 0 },
    )
    let access = loom_exec_result_access(
        1, 1, if case_index == 12 { 0 } else { 1 }, 1, 1, 1, 1,
    )
    let authority = loom_exec_result_authority(
        if case_index == 4 { 0 } else { 1 }, 1, 1, 1, 1, 1, 1,
    )
    let evidence = loom_exec_result_evidence(
        if case_index == 13 { 0 } else { 1 }, 1, 1,
        if case_index == 14 { 0 } else { 1 }, 1,
    )
    let observation = loom_exec_result_observation(
        if case_index == 3 { 2 } else { 3 }, 1,
        if resolve { 2 } else { 1 }, parents, bindings, terminal,
        storage, access, authority, evidence,
    )
    judge_loom_exec_result_handle(observation)
}

pub fn loom_exec_result_handle_selftest() -> i64 with Div {
    if loom_exec_result_case(1) != 1 { return 1 }
    if loom_exec_result_case(2) != 2 { return 2 }
    if loom_exec_result_case(3) != 405 { return 3 }
    if loom_exec_result_case(4) != 532 { return 4 }
    if loom_exec_result_case(5) != 533 { return 5 }
    if loom_exec_result_case(6) != 534 { return 6 }
    if loom_exec_result_case(7) != 534 { return 7 }
    if loom_exec_result_case(8) != 534 { return 8 }
    if loom_exec_result_case(9) != 535 { return 9 }
    if loom_exec_result_case(10) != 536 { return 10 }
    if loom_exec_result_case(11) != 537 { return 11 }
    if loom_exec_result_case(12) != 538 { return 12 }
    if loom_exec_result_case(13) != 539 { return 13 }
    if loom_exec_result_case(14) != 540 { return 14 }
    if judge_loom_exec_result_handle_v1_frame(
            3, 1, 1, 255, 1023, 31, 127, 127, 7, 1, 1) != 1 {
        return 15
    }
    if judge_loom_exec_result_handle_v1_words(
            268435439, 262143, 1) != 1 {
        return 16
    }
    0
}
