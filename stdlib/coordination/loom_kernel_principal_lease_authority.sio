//! Sounio-first authority for crash-safe LOOM kernel-principal leases.
//!
//! Action 9027 decides whether a host-owned broker may launch or recycle a
//! generation-fenced kernel principal without inferring extinction from silence.

struct LoomKernelPrincipalLeaseDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

struct LoomKernelPrincipalLeaseBroker {
    host_owned: i64,
    service_manager_supervised: i64,
    root_owned_socket: i64,
    user_invocation_denied: i64,
    policy_only: i64,
    frozen_policy_bound: i64,
}

struct LoomKernelPrincipalLeaseAllocator {
    single_writer_lock: i64,
    durable_journal: i64,
    monotonic_epoch: i64,
    ranges_disjoint: i64,
    broker_selected_ids: i64,
    unique_generation: i64,
    previous_epoch: i64,
    current_epoch: i64,
    previous_generation: i64,
    current_generation: i64,
}

struct LoomKernelPrincipalLeaseLifecycle {
    operation: i64,
    start_state: i64,
    end_state: i64,
    free_to_reserved: i64,
    reserved_to_mapped: i64,
    mapped_to_launched: i64,
    launched_to_draining: i64,
    draining_to_quarantined: i64,
    quarantined_to_free: i64,
}

struct LoomKernelPrincipalLeaseLaunch {
    parent_9026_allow: i64,
    exact_maps_ready: i64,
    cgroup_ready: i64,
    namespaces_ready: i64,
    pidfd_ready: i64,
    pre_exec_gate: i64,
}

struct LoomKernelPrincipalLeasePrivilege {
    irreversible_drop: i64,
    no_new_privileges: i64,
    privilege_regain_denied: i64,
    lane_setuid_absent: i64,
    capabilities_empty: i64,
    broker_descriptors_closed: i64,
}

struct LoomKernelPrincipalLeaseRecovery {
    broker_crash_fail_closed: i64,
    orphan_scan_complete: i64,
    generation_fenced: i64,
    grants_revoked: i64,
    incomplete_outcomes_materialized: i64,
    forced_quarantine: i64,
}

struct LoomKernelPrincipalLeaseExtinction {
    reuse_mode: i64,
    never_used_receipt: i64,
    process_extinct: i64,
    namespace_extinct: i64,
    authority_extinct: i64,
    quarantine_receipt: i64,
    receipt_bound: i64,
}

struct LoomKernelPrincipalLeaseEvidence {
    sabotage_count: i64,
    sabotage_required: i64,
    receipt_bound: i64,
}

struct LoomKernelPrincipalLeaseBindings {
    parent_9026_manifest_hash: LoomKernelPrincipalLeaseDigest256,
    journal_hash: LoomKernelPrincipalLeaseDigest256,
    allocation_hash: LoomKernelPrincipalLeaseDigest256,
    lifecycle_hash: LoomKernelPrincipalLeaseDigest256,
    extinction_hash: LoomKernelPrincipalLeaseDigest256,
    source_hash: LoomKernelPrincipalLeaseDigest256,
    semantics_hash: LoomKernelPrincipalLeaseDigest256,
    toolchain_hash: LoomKernelPrincipalLeaseDigest256,
    hardware_hash: LoomKernelPrincipalLeaseDigest256,
    command_hash: LoomKernelPrincipalLeaseDigest256,
    result_hash: LoomKernelPrincipalLeaseDigest256,
}

pub fn admit_loom_kernel_principal_lease_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> LoomKernelPrincipalLeaseDigest256 {
    LoomKernelPrincipalLeaseDigest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
}

