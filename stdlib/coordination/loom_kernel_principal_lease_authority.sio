        end_state: end_state,
        free_to_reserved: free_to_reserved,
        reserved_to_mapped: reserved_to_mapped,
        mapped_to_launched: mapped_to_launched,
        launched_to_draining: launched_to_draining,
        draining_to_quarantined: draining_to_quarantined,
        quarantined_to_free: quarantined_to_free,
    }
}

