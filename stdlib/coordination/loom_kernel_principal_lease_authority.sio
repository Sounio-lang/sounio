    LoomKernelPrincipalLeaseAllocator {
        single_writer_lock: single_writer_lock,
        durable_journal: durable_journal,
        monotonic_epoch: monotonic_epoch,
        ranges_disjoint: ranges_disjoint,
        broker_selected_ids: broker_selected_ids,
        unique_generation: unique_generation,
        previous_epoch: previous_epoch,
        current_epoch: current_epoch,
        previous_generation: previous_generation,
        current_generation: current_generation,
    }
}

