    LoomKernelPrincipalLeaseBroker {
        host_owned: host_owned,
        service_manager_supervised: service_manager_supervised,
        root_owned_socket: root_owned_socket,
        user_invocation_denied: user_invocation_denied,
        policy_only: policy_only,
        frozen_policy_bound: frozen_policy_bound,
    }
}

