//! Linear authority algebra for contingent-policy outcome evidence.
//!
//! OCaml verifies Ed25519 signatures and canonical receipt bytes. Frame 9012
//! checks that the verified measurement and classification facts are bound to
//! the exact live policy cursor, closed outcome partition, classifier spec,
//! and pairwise-separated principals before producing a one-use proof.

pub effect LoomOutcomeAuthorityHostTrust {}

struct OutcomeAuthorityDigest256 {
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
}

linear struct VerifiedMeasurementReceipt {
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_path_token: i64,
    generation_token: i64,
    journal_head_token: i64,
    nonce_token: i64,
    measurement_receipt_digest: OutcomeAuthorityDigest256,
}

linear struct VerifiedOutcomeEvidence {
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_path_token: i64,
    outcome_token: i64,
    generation_token: i64,
    journal_head_token: i64,
    nonce_token: i64,
    classification_receipt_digest: OutcomeAuthorityDigest256,
}

linear struct HostOutcomeAuthorityReceipt {
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_path_token: i64,
    outcome_token: i64,
    generation_token: i64,
    journal_head_token: i64,
    classification_receipt_digest: OutcomeAuthorityDigest256,
}

pub fn admit_outcome_authority_digest256(
    limb0: i64,
    limb1: i64,
    limb2: i64,
    limb3: i64,
    limb4: i64,
    limb5: i64,
    limb6: i64,
    limb7: i64,
) -> OutcomeAuthorityDigest256 {
    OutcomeAuthorityDigest256 {
        limb0: limb0,
        limb1: limb1,
        limb2: limb2,
        limb3: limb3,
        limb4: limb4,
        limb5: limb5,
        limb6: limb6,
        limb7: limb7,
    }
}

fn outcome_authority_digest_is_canonical(
    digest: OutcomeAuthorityDigest256,
) -> bool {
    digest.limb0 >= 0 && digest.limb0 <= 4294967295 &&
    digest.limb1 >= 0 && digest.limb1 <= 4294967295 &&
    digest.limb2 >= 0 && digest.limb2 <= 4294967295 &&
    digest.limb3 >= 0 && digest.limb3 <= 4294967295 &&
    digest.limb4 >= 0 && digest.limb4 <= 4294967295 &&
    digest.limb5 >= 0 && digest.limb5 <= 4294967295 &&
    digest.limb6 >= 0 && digest.limb6 <= 4294967295 &&
    digest.limb7 >= 0 && digest.limb7 <= 4294967295
}

fn outcome_authority_digest_is_nonzero(
    digest: OutcomeAuthorityDigest256,
) -> bool {
    digest.limb0 != 0 || digest.limb1 != 0 || digest.limb2 != 0 ||
    digest.limb3 != 0 || digest.limb4 != 0 || digest.limb5 != 0 ||
    digest.limb6 != 0 || digest.limb7 != 0
}

fn outcome_authority_digest_equal(
    left: OutcomeAuthorityDigest256,
    right: OutcomeAuthorityDigest256,
) -> bool {
    left.limb0 == right.limb0 && left.limb1 == right.limb1 &&
    left.limb2 == right.limb2 && left.limb3 == right.limb3 &&
    left.limb4 == right.limb4 && left.limb5 == right.limb5 &&
    left.limb6 == right.limb6 && left.limb7 == right.limb7
}

fn outcome_authority_roles_are_separated(
    owner_token: i64,
    measurement_principal_token: i64,
    classifier_principal_token: i64,
    measurement_key_token: i64,
    classifier_key_token: i64,
) -> bool {
    owner_token > 0 && measurement_principal_token > 0 &&
    classifier_principal_token > 0 && measurement_key_token > 0 &&
    classifier_key_token > 0 &&
    owner_token != measurement_principal_token &&
    owner_token != classifier_principal_token &&
    measurement_principal_token != classifier_principal_token &&
    measurement_key_token != classifier_key_token
}

fn outcome_measurement_receipt_is_bound(
    signature_verified: i64,
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_path_token: i64,
    generation_token: i64,
    journal_head_token: i64,
    measurement_policy_token: i64,
    measurement_selected_policy_token: i64,
    measurement_action_token: i64,
    measurement_path_token: i64,
    measurement_generation_token: i64,
    measurement_journal_head_token: i64,
    measurement_nonce_token: i64,
    measurement_digest: OutcomeAuthorityDigest256,
    measurement_receipt_digest: OutcomeAuthorityDigest256,
) -> bool {
    signature_verified == 1 && policy_token > 0 && selected_policy_token > 0 &&
    current_action_token > 0 && current_path_token > 0 &&
    generation_token > 0 && journal_head_token > 0 &&
    measurement_nonce_token > 0 &&
    policy_token == measurement_policy_token &&
    selected_policy_token == measurement_selected_policy_token &&
    current_action_token == measurement_action_token &&
    current_path_token == measurement_path_token &&
    generation_token == measurement_generation_token &&
    journal_head_token == measurement_journal_head_token &&
    outcome_authority_digest_is_canonical(measurement_digest) &&
    outcome_authority_digest_is_nonzero(measurement_digest) &&
    outcome_authority_digest_is_canonical(measurement_receipt_digest) &&
    outcome_authority_digest_is_nonzero(measurement_receipt_digest)
}

fn outcome_classifier_receipt_is_bound(
    signature_verified: i64,
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_path_token: i64,
    outcome_token: i64,
    generation_token: i64,
    journal_head_token: i64,
    classification_policy_token: i64,
    classification_selected_policy_token: i64,
    classification_action_token: i64,
    classification_path_token: i64,
    classification_outcome_token: i64,
    classification_generation_token: i64,
    classification_journal_head_token: i64,
    measurement_receipt_digest: OutcomeAuthorityDigest256,
    classifier_measurement_receipt_digest: OutcomeAuthorityDigest256,
    classifier_spec_digest: OutcomeAuthorityDigest256,
    claimed_classifier_spec_digest: OutcomeAuthorityDigest256,
    partition_digest: OutcomeAuthorityDigest256,
    claimed_partition_digest: OutcomeAuthorityDigest256,
    classification_receipt_digest: OutcomeAuthorityDigest256,
) -> bool {
    signature_verified == 1 && outcome_token > 0 &&
    policy_token == classification_policy_token &&
    selected_policy_token == classification_selected_policy_token &&
    current_action_token == classification_action_token &&
    current_path_token == classification_path_token &&
    outcome_token == classification_outcome_token &&
    generation_token == classification_generation_token &&
    journal_head_token == classification_journal_head_token &&
    outcome_authority_digest_equal(
        measurement_receipt_digest,
        classifier_measurement_receipt_digest,
    ) &&
    outcome_authority_digest_equal(
        classifier_spec_digest,
        claimed_classifier_spec_digest,
    ) &&
    outcome_authority_digest_equal(partition_digest, claimed_partition_digest) &&
    outcome_authority_digest_is_nonzero(classifier_spec_digest) &&
    outcome_authority_digest_is_nonzero(partition_digest) &&
    outcome_authority_digest_is_canonical(classification_receipt_digest) &&
    outcome_authority_digest_is_nonzero(classification_receipt_digest)
}

fn outcome_authority_receipt_is_fresh(
    measurement_nonce_token: i64,
    classification_nonce_token: i64,
) -> bool {
    measurement_nonce_token > 0 &&
    measurement_nonce_token == classification_nonce_token
}

pub fn host_outcome_authority_frame_accepts(
    measurement_signature_verified: i64,
    classification_signature_verified: i64,
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_path_token: i64,
    outcome_token: i64,
    owner_token: i64,
    generation_token: i64,
    journal_head_token: i64,
    measurement_principal_token: i64,
    classifier_principal_token: i64,
    measurement_key_token: i64,
    classifier_key_token: i64,
    measurement_policy_token: i64,
    measurement_selected_policy_token: i64,
    measurement_action_token: i64,
    measurement_path_token: i64,
    measurement_generation_token: i64,
    measurement_journal_head_token: i64,
    measurement_nonce_token: i64,
    classification_policy_token: i64,
    classification_selected_policy_token: i64,
    classification_action_token: i64,
    classification_path_token: i64,
    classification_outcome_token: i64,
    classification_generation_token: i64,
    classification_journal_head_token: i64,
    classification_nonce_token: i64,
    measurement_digest: OutcomeAuthorityDigest256,
    measurement_receipt_digest: OutcomeAuthorityDigest256,
    classifier_measurement_receipt_digest: OutcomeAuthorityDigest256,
    classifier_spec_digest: OutcomeAuthorityDigest256,
    claimed_classifier_spec_digest: OutcomeAuthorityDigest256,
    partition_digest: OutcomeAuthorityDigest256,
    claimed_partition_digest: OutcomeAuthorityDigest256,
    classification_receipt_digest: OutcomeAuthorityDigest256,
) -> bool with LoomOutcomeAuthorityHostTrust {
    outcome_authority_roles_are_separated(
        owner_token,
        measurement_principal_token,
        classifier_principal_token,
        measurement_key_token,
        classifier_key_token,
    ) &&
    outcome_measurement_receipt_is_bound(
        measurement_signature_verified,
        policy_token,
        selected_policy_token,
        current_action_token,
        current_path_token,
        generation_token,
        journal_head_token,
        measurement_policy_token,
        measurement_selected_policy_token,
        measurement_action_token,
        measurement_path_token,
        measurement_generation_token,
        measurement_journal_head_token,
        measurement_nonce_token,
        measurement_digest,
        measurement_receipt_digest,
    ) &&
    outcome_classifier_receipt_is_bound(
        classification_signature_verified,
        policy_token,
        selected_policy_token,
        current_action_token,
        current_path_token,
        outcome_token,
        generation_token,
        journal_head_token,
        classification_policy_token,
        classification_selected_policy_token,
        classification_action_token,
        classification_path_token,
        classification_outcome_token,
        classification_generation_token,
        classification_journal_head_token,
        measurement_receipt_digest,
        classifier_measurement_receipt_digest,
        classifier_spec_digest,
        claimed_classifier_spec_digest,
        partition_digest,
        claimed_partition_digest,
        classification_receipt_digest,
    ) &&
    outcome_authority_receipt_is_fresh(
        measurement_nonce_token,
        classification_nonce_token,
    )
}

pub fn admit_verified_measurement_receipt(
    policy_token: i64,
    selected_policy_token: i64,
    current_action_token: i64,
    current_path_token: i64,
    generation_token: i64,
    journal_head_token: i64,
    nonce_token: i64,
    measurement_receipt_digest: OutcomeAuthorityDigest256,
) -> VerifiedMeasurementReceipt with LoomOutcomeAuthorityHostTrust, Panic {
    if policy_token <= 0 || selected_policy_token <= 0 ||
        current_action_token <= 0 || current_path_token <= 0 ||
        generation_token <= 0 || journal_head_token <= 0 || nonce_token <= 0 ||
        !outcome_authority_digest_is_nonzero(measurement_receipt_digest) {
        panic("verified measurement receipt is not canonical")
    }
    VerifiedMeasurementReceipt {
        policy_token: policy_token,
        selected_policy_token: selected_policy_token,
        current_action_token: current_action_token,
        current_path_token: current_path_token,
        generation_token: generation_token,
        journal_head_token: journal_head_token,
        nonce_token: nonce_token,
        measurement_receipt_digest: measurement_receipt_digest,
    }
}

pub fn classify_verified_measurement(
    measurement: VerifiedMeasurementReceipt,
    outcome_token: i64,
    classification_receipt_digest: OutcomeAuthorityDigest256,
) -> VerifiedOutcomeEvidence with LoomOutcomeAuthorityHostTrust, Panic {
    let VerifiedMeasurementReceipt {
        policy_token, selected_policy_token, current_action_token,
        current_path_token, generation_token, journal_head_token, nonce_token,
        measurement_receipt_digest: _,
    } = measurement
    if outcome_token <= 0 ||
        !outcome_authority_digest_is_nonzero(classification_receipt_digest) {
        panic("verified outcome classification is not canonical")
    }
    VerifiedOutcomeEvidence {
        policy_token: policy_token,
        selected_policy_token: selected_policy_token,
        current_action_token: current_action_token,
        current_path_token: current_path_token,
        outcome_token: outcome_token,
        generation_token: generation_token,
        journal_head_token: journal_head_token,
        nonce_token: nonce_token,
        classification_receipt_digest: classification_receipt_digest,
    }
}

pub fn consume_verified_outcome(
    evidence: VerifiedOutcomeEvidence,
) -> HostOutcomeAuthorityReceipt {
    let VerifiedOutcomeEvidence {
        policy_token, selected_policy_token, current_action_token,
        current_path_token, outcome_token, generation_token,
        journal_head_token, nonce_token: _,
        classification_receipt_digest,
    } = evidence
    HostOutcomeAuthorityReceipt {
        policy_token: policy_token,
        selected_policy_token: selected_policy_token,
        current_action_token: current_action_token,
        current_path_token: current_path_token,
        outcome_token: outcome_token,
        generation_token: generation_token,
        journal_head_token: journal_head_token,
        classification_receipt_digest: classification_receipt_digest,
    }
}

pub fn close_host_outcome_authority_receipt(
    receipt: HostOutcomeAuthorityReceipt,
) -> i64 {
    let HostOutcomeAuthorityReceipt {
        policy_token, selected_policy_token, current_action_token,
        current_path_token, outcome_token, generation_token,
        journal_head_token,
        classification_receipt_digest: _,
    } = receipt
    policy_token + selected_policy_token + current_action_token +
        current_path_token + outcome_token + generation_token + journal_head_token
}
