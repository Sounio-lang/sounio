// stdlib/queue/pure/types.sio — Queue Types

module queue::pure::types

fn queue_neg_one() -> i64 {
    let z: i64 = 0
    z - 1
}

pub struct Queue {
    pub n_items: i32,
    pub data: [i64; 256],
    pub head: i32,
    pub tail: i32,
}

pub fn queue_new() -> Queue {
    Queue { n_items: 0, data: [0; 256], head: 0, tail: 0 }
}

pub fn queue_push(q: &! Queue, v: i64) with Mut {
    if q.n_items < 256 {
        q.data[q.tail as usize] = v
        q.tail = (q.tail + 1) % 256
        q.n_items = q.n_items + 1
    }
}

pub fn queue_pop(q: &! Queue) -> i64 with Mut {
    if q.n_items == 0 { return queue_neg_one() }
    let v = q.data[q.head as usize]
    q.head = (q.head + 1) % 256
    q.n_items = q.n_items - 1
    v
}

pub fn queue_size(q: &Queue) -> i32 { q.n_items }

pub fn queue_is_empty(q: &Queue) -> bool { q.n_items == 0 }