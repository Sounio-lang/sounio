/// NCBI genomics typed data protocol
/// Typed session for gene expression queries against NCBI databases

struct GeneQuery {
    gene_id: [i8; 32],
    gene_id_len: i64,
    organism_id: i64,   // 0=human, 1=mouse, 2=rat
    database: i64,      // 0=gene, 1=nucleotide, 2=protein
}

struct GeneExpression {
    gene_id: [i8; 32],
    gene_id_len: i64,
    expression_level: f64,
    std_dev: f64,        // standard deviation = epistemic uncertainty
    sample_count: i64,
    tissue_id: i64,
}

/// Build a human gene query
fn query_human_gene(gene_id: [i8; 32], len: i64) -> GeneQuery {
    GeneQuery {
        gene_id: gene_id,
        gene_id_len: len,
        organism_id: 0,
        database: 0,
    }
}

/// Uncertainty of a gene expression measurement
/// Based on sample count and std_dev: higher samples -> lower uncertainty
fn expression_uncertainty(expr: GeneExpression) -> f64 with Div, Panic {
    if expr.sample_count <= 0 {
        1.0
    } else {
        let base = expr.std_dev / (expr.expression_level + 0.001)
        let n_factor = 1.0 / (expr.sample_count as f64)
        if base * n_factor > 1.0 { 1.0 } else { base * n_factor }
    }
}

/// Check if expression is reliably measured (uncertainty < threshold)
fn expression_reliable(expr: GeneExpression, threshold: f64) -> bool with Div, Panic {
    expression_uncertainty(expr) < threshold
}
