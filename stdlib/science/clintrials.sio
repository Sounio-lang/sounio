/// ClinicalTrials.gov typed data protocol
/// Typed session for clinical trial data with epistemic quality tracking

struct TrialQuery {
    nct_id: [i8; 16],       // NCT ID e.g. "NCT01234567"
    nct_id_len: i64,
    phase: i64,             // 1=Phase I, 2=Phase II, 3=Phase III, 4=Phase IV
}

struct TrialOutcome {
    nct_id: [i8; 16],
    nct_id_len: i64,
    primary_outcome_met: bool,
    p_value: f64,
    effect_size: f64,
    confidence_lower: f64,
    confidence_upper: f64,
    sample_size: i64,
    phase: i64,
}

/// Evidence quality score for a trial outcome [0.0, 1.0]
/// Phase III + large sample + p<0.05 -> high quality
fn trial_evidence_quality(outcome: TrialOutcome) -> f64 {
    var score = 0.0
    if outcome.phase >= 3 { score = score + 0.4 }
    if outcome.p_value < 0.05 { score = score + 0.3 }
    if outcome.sample_size >= 100 { score = score + 0.2 }
    if outcome.effect_size > 0.3 { score = score + 0.1 }
    score
}

/// Uncertainty of the trial evidence
fn trial_uncertainty(outcome: TrialOutcome) -> f64 {
    1.0 - trial_evidence_quality(outcome)
}
