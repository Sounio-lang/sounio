// stdlib/gpu/smooth.sio — Signal smoothing and filtering
//
// Gaussian smoothing, moving average, and bilateral filtering for 1D signals.
// All operations on fixed-size f64 arrays.
//
// Reference: Paris & Durand, "A fast approximation of the bilateral filter
//            using a signal processing approach" ECCV 2006

// =============================================================================
// Math Helpers
// =============================================================================

fn smooth_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn smooth_exp(x: f64) -> f64 {
    if x > 20.0 { return smooth_exp(x / 2.0) * smooth_exp(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / smooth_exp(0.0 - x) }

    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 15 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    return sum
}

fn smooth_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 10 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

// =============================================================================
// Gaussian Smoothing
// =============================================================================

// 1D Gaussian smoothing with given sigma.
// Kernel radius = min(3*sigma, 32) to keep window bounded.
fn smooth_gaussian_1d(input: &[f64; 256], output: &![f64; 256], n: i32, sigma: f64) with Mut, Div, Panic {
    if n <= 0 { return }
    if sigma <= 0.0 {
        // Copy input to output
        var i = 0
        while i < n {
            if i < 256 { output[i] = input[i] }
            i = i + 1
        }
        return
    }

    // Compute kernel radius
    var radius = (sigma * 3.0) as i32
    if radius > 32 { radius = 32 }
    if radius < 1 { radius = 1 }

    let inv_2sigma2 = 0.0 - 1.0 / (2.0 * sigma * sigma)

    var i = 0
    while i < n {
        var acc = 0.0
        var weight_sum = 0.0

        var k = 0 - radius
        while k <= radius {
            let j = i + k
            if j >= 0 && j < n && j < 256 {
                let dist2 = (k as f64) * (k as f64)
                let w = smooth_exp(dist2 * inv_2sigma2)
                acc = acc + w * input[j]
                weight_sum = weight_sum + w
            }
            k = k + 1
        }

        if i < 256 {
            if weight_sum > 1.0e-15 {
                output[i] = acc / weight_sum
            } else {
                output[i] = input[i]
            }
        }
        i = i + 1
    }
}

// =============================================================================
// Moving Average
// =============================================================================

// Simple moving average with given window size (centered).
fn smooth_moving_avg(input: &[f64; 256], output: &![f64; 256], n: i32, window: i32) with Mut, Div, Panic {
    if n <= 0 { return }
    var win = window
    if win < 1 { win = 1 }

    let half = win / 2

    var i = 0
    while i < n {
        var acc = 0.0
        var count = 0

        var k = 0 - half
        while k <= half {
            let j = i + k
            if j >= 0 && j < n && j < 256 {
                acc = acc + input[j]
                count = count + 1
            }
            k = k + 1
        }

        if i < 256 {
            if count > 0 {
                output[i] = acc / (count as f64)
            } else {
                output[i] = input[i]
            }
        }
        i = i + 1
    }
}

// =============================================================================
// Bilateral Filter
// =============================================================================

// 1D bilateral filter: preserves edges by weighting both spatial distance
// and intensity difference.
// sigma_s: spatial sigma, sigma_r: range (intensity) sigma
fn smooth_bilateral_1d(input: &[f64; 256], output: &![f64; 256], n: i32, sigma_s: f64, sigma_r: f64) with Mut, Div, Panic {
    if n <= 0 { return }
    if sigma_s <= 0.0 || sigma_r <= 0.0 {
        var i = 0
        while i < n {
            if i < 256 { output[i] = input[i] }
            i = i + 1
        }
        return
    }

    var radius = (sigma_s * 3.0) as i32
    if radius > 32 { radius = 32 }
    if radius < 1 { radius = 1 }

    let inv_2ss = 0.0 - 1.0 / (2.0 * sigma_s * sigma_s)
    let inv_2sr = 0.0 - 1.0 / (2.0 * sigma_r * sigma_r)

    var i = 0
    while i < n {
        if i < 256 {
            var acc = 0.0
            var weight_sum = 0.0
            let center_val = input[i]

            var k = 0 - radius
            while k <= radius {
                let j = i + k
                if j >= 0 && j < n && j < 256 {
                    let spatial_d2 = (k as f64) * (k as f64)
                    let range_d = input[j] - center_val
                    let range_d2 = range_d * range_d

                    let w = smooth_exp(spatial_d2 * inv_2ss + range_d2 * inv_2sr)
                    acc = acc + w * input[j]
                    weight_sum = weight_sum + w
                }
                k = k + 1
            }

            if weight_sum > 1.0e-15 {
                output[i] = acc / weight_sum
            } else {
                output[i] = center_val
            }
        }
        i = i + 1
    }
}

// =============================================================================
// Exponential Moving Average (causal)
// =============================================================================

fn smooth_ema(input: &[f64; 256], output: &![f64; 256], n: i32, alpha: f64) with Mut, Div, Panic {
    if n <= 0 { return }
    if n > 256 { return }

    output[0] = input[0]
    var i = 1
    while i < n {
        if i < 256 {
            output[i] = alpha * input[i] + (1.0 - alpha) * output[i - 1]
        }
        i = i + 1
    }
}

// =============================================================================
// Tests
// =============================================================================

fn test_gaussian_constant() -> i32 {
    // Smoothing a constant signal should return the same constant
    var input = [0.0; 256]
    var output = [0.0; 256]
    var i = 0
    while i < 10 {
        input[i] = 5.0
        i = i + 1
    }

    smooth_gaussian_1d(&input, &!output, 10, 2.0)

    // Middle values should be ~5.0
    if smooth_abs(output[5] - 5.0) > 0.01 { return 1 }
    return 0
}

fn test_moving_avg_constant() -> i32 {
    var input = [0.0; 256]
    var output = [0.0; 256]
    var i = 0
    while i < 10 {
        input[i] = 3.0
        i = i + 1
    }

    smooth_moving_avg(&input, &!output, 10, 5)

    if smooth_abs(output[5] - 3.0) > 0.01 { return 1 }
    return 0
}

fn test_bilateral_constant() -> i32 {
    var input = [0.0; 256]
    var output = [0.0; 256]
    var i = 0
    while i < 8 {
        input[i] = 7.0
        i = i + 1
    }

    smooth_bilateral_1d(&input, &!output, 8, 2.0, 1.0)

    if smooth_abs(output[4] - 7.0) > 0.01 { return 1 }
    return 0
}

fn test_ema_step() -> i32 {
    var input = [0.0; 256]
    var output = [0.0; 256]
    // Step function
    input[0] = 0.0
    input[1] = 0.0
    input[2] = 1.0
    input[3] = 1.0
    input[4] = 1.0

    smooth_ema(&input, &!output, 5, 0.5)

    // output[0] = 0, output[2] = 0.5*1 + 0.5*output[1]
    if smooth_abs(output[0]) > 0.01 { return 1 }
    // output should be monotonically increasing after step
    if output[4] < output[2] { return 2 }
    return 0
}
