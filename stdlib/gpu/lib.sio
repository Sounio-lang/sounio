// gpu — GPU compute kernels and data-parallel utilities
//
// GPU-accelerated operations: Clifford algebra geometric product,
// FFT, signal smoothing, statistical reductions, and tile-based scheduling.
//
// Submodules:
//   clifford_kernel — GPU geometric product for Cl(p,q), sign table in shared memory
//   fft             — Radix-2 Cooley-Tukey FFT on fixed-size complex arrays
//   smooth          — Gaussian, moving average, and bilateral 1D smoothing
//   stats           — Sum, mean, variance, min, max, histogram reductions
//   tilelang        — Dataflow/scheduling separation for GPU kernel tuning

pub use clifford_kernel::{
    ClKernelCtx,
    cl_kernel_init,
    cl_gpu_mul_batch,
    cd_gpu_count_tk,
}
