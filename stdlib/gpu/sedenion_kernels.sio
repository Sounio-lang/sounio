// ============================================================================
// §5. GPU KERNELS — Metal MSL emission targets
//
//     Kernel body uses XOR-based flat arithmetic:
//       a[m] = h[m^I] * S[m^I, I]             (h * e_I, component m)
//       (p*q)[m] = Σ_i p[i] * q[m^i] * S[i, m^i]
//       assoc[m] = abc1[m] - abc2[m]
//     No structs in kernel body — avoids SRET in GPU context.
// ============================================================================

/// F₃ GPU kernel: L¹ sedenion associator mass over O_168 orbit.
///
/// Each thread tid computes F₃ for sedenion state at states_buf[tid*16..].
/// sign_tbl[256]: e_i*e_j = sign_tbl[i*16+j] * e_{i^j} (XOR index rule).
/// triples[504]:  flattened 168×3 (I, J, K) O_168 orbit indices.
/// out_buf[n]:    per-state F₃ output (mean L¹ associator mass).
kernel fn sed_f3_l1_mass_kernel(
    n: i64,
    states_buf: &[f64],
    sign_tbl: &[i64],
    triples: &[i64],
    n_triples: i64,
    out_buf: &![f64],
) with GPU, Div {
    let tid = gpu_thread_id_x()
    if tid < n {
        let base = tid * 16
        var total: f64 = 0.0
        var t: i64 = 0
        while t < n_triples {
            let II = triples[(t * 3) as usize]
            let JJ = triples[(t * 3 + 1) as usize]
            let KK = triples[(t * 3 + 2) as usize]
            // Compute L¹ norm of associator [(h*eI), (h*eJ), (h*eK)]
            // a[m] = h[m^I]*S[m^I,I],  b[m] = h[m^J]*S[m^J,J],  c[m] = h[m^K]*S[m^K,K]
            // abc1[m] = ((a*b)*c)[m] = Σ_i (Σ_j a[j]*b[j^i]*S[j,j^i]) * c[i^m]*S[i,i^m]
            // abc2[m] = (a*(b*c))[m] = Σ_i a[i]*S[i,i^m] * (Σ_k b[k]*c[k^(i^m)]*S[k,k^(i^m)])
            var l1: f64 = 0.0
            var m: i64 = 0
            while m < 16 {
                var abc1_m: f64 = 0.0
                var i: i64 = 0
                while i < 16 {
                    var ab_i: f64 = 0.0
                    var j: i64 = 0
                    while j < 16 {
                        let ji = j ^ i
                        let jI = j ^ II
                        let jiJ = ji ^ JJ
                        let a_j = states_buf[(base + jI) as usize] * (sign_tbl[(jI * 16 + II) as usize] as f64)
                        let b_ji = states_buf[(base + jiJ) as usize] * (sign_tbl[(jiJ * 16 + JJ) as usize] as f64)
                        let s_j_ji = sign_tbl[(j * 16 + ji) as usize] as f64
                        ab_i = ab_i + a_j * b_ji * s_j_ji
                        j = j + 1
                    }
                    let im = i ^ m
                    let imK = im ^ KK
                    let c_im = states_buf[(base + imK) as usize] * (sign_tbl[(imK * 16 + KK) as usize] as f64)
                    let s_i_im = sign_tbl[(i * 16 + im) as usize] as f64
                    abc1_m = abc1_m + ab_i * c_im * s_i_im
                    i = i + 1
                }
                var abc2_m: f64 = 0.0
                i = 0
                while i < 16 {
                    let iI = i ^ II
                    let a_i = states_buf[(base + iI) as usize] * (sign_tbl[(iI * 16 + II) as usize] as f64)
                    let im = i ^ m
                    var bc_im: f64 = 0.0
                    var k: i64 = 0
                    while k < 16 {
                        let kJ = k ^ JJ
                        let kim = k ^ im
                        let kimK = kim ^ KK
                        let b_k = states_buf[(base + kJ) as usize] * (sign_tbl[(kJ * 16 + JJ) as usize] as f64)
                        let c_kim = states_buf[(base + kimK) as usize] * (sign_tbl[(kimK * 16 + KK) as usize] as f64)
                        let s_k_kim = sign_tbl[(k * 16 + kim) as usize] as f64
                        bc_im = bc_im + b_k * c_kim * s_k_kim
                        k = k + 1
                    }
                    let s_i_im = sign_tbl[(i * 16 + im) as usize] as f64
                    abc2_m = abc2_m + a_i * bc_im * s_i_im
                    i = i + 1
                }
                let assoc_m = abc1_m - abc2_m
                l1 = l1 + if assoc_m < 0.0 { 0.0 - assoc_m } else { assoc_m }
                m = m + 1
            }
            total = total + l1
            t = t + 1
        }
        out_buf[tid as usize] = total / (n_triples as f64)
    }
}

// ============================================================================
// §6. CPU DISPATCH — GPU.launch wrapper
//
//     Dispatches sed_f3_l1_mass_kernel over N states.
//     Caller provides flat buffers; sign_tbl and triples from SedKernelCtx.
// ============================================================================

/// Batch F₃ over N sedenion states. Dispatches to Metal GPU kernel.
/// states[n*16]: flat buffer, states_buf[s*16+k] = component k of state s.
/// out[n]:       output F₃ per state.
pub fn sed_f3_batch(
    n: i64,
    states: &[f64],
    sign_tbl: &[i64],
    triples_buf: &[i64],
    n_triples: i64,
    out: &![f64],
) with GPU, Mut, IO, Panic, Div {
    let grid  = ((n + 63) / 64, 1, 1)
    let block = (64, 1, 1)
    perform GPU.launch(sed_f3_l1_mass_kernel, grid, block)(
        n, states, sign_tbl, triples_buf, n_triples, out
    )
    perform GPU.sync()
}

// ============================================================================
// §7. CPU FALLBACK — exact F₃ over all 168 O_168 triples
//
//     Verifiable CPU path used in testing and non-GPU environments.
//     168 inline calls match Python O_168_sedenion_triples() ordering exactly.
//     Expected: F₃(seed-20260421 state) ≈ 85.4749812048 / 168 ≈ 0.509 per triple.
// ============================================================================

/// F₃ for a single sedenion state: (1/168) * Σ_{(I,J,K)∈O_168} ||[h̃·eI, h̃·eJ, h̃·eK]||_{L¹}.
/// Bit-compatible with Python f3_v3_l1_associator_mass() in ossm_168_dryrun/sedenion.py.
pub fn sed_f3_single(h: Sedenion) -> f64 with Mut, Div {
    var total: f64 = 0.0
    total = total + sed_triple_l1(h, 1, 10, 4)
    total = total + sed_triple_l1(h, 1, 10, 5)
    total = total + sed_triple_l1(h, 1, 10, 6)
    total = total + sed_triple_l1(h, 1, 10, 7)
    total = total + sed_triple_l1(h, 1, 11, 4)
    total = total + sed_triple_l1(h, 1, 11, 5)
