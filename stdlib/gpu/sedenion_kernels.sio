//! stdlib/gpu/sedenion_kernels.sio
//!
//! GPU Metal kernels for ossm_168 hypothesis features F₁/F₂/F₃.
//!
//! Three feature kernels matching the pre-registration v3 spec:
//!   F₁ — Orbit-of-168 octonion associator mass (rumination proxy)
//!   F₂ — Proximity to sedenion zero-divisor manifold (anhedonia proxy)
//!   F₃ — L¹ sedenion associator mass over O_168 orbit (valence proxy)
//!
//! GPU emission path: Sounio → HLIR → GpuKernelIr → metal.sio → MSL
//! CPU dispatch (CPU fallback / test path): sed_f3_single / sed_f3_batch
//!
//! Each thread = one (subject × epoch) sedenion state.
//! Parallelism: N threads for N states — embarrassingly parallel.
//!
//! Kernel body uses XOR-based flat arithmetic, no structs in GPU context:
//!   a[m]      = h[m^I] * S[m^I, I]           (h * e_I, component m)
//!   (p*q)[m]  = Σ_i p[i] * q[m^i] * S[i, m^i]  (full sedenion product)
//!   assoc[m]  = ((h*eI)*(h*eJ))*(h*eK))[m] - (h*eI)*((h*eJ)*(h*eK))[m]
//!   F₃        = (1/168) * Σ_{(I,J,K)∈O_168} Σ_m |assoc[m]|
//!
//! Reference: pre-registration v3 `docs/papers/preregistrations/2026-04-21_ossm_168_depression_v3.md`
//! Python mirror: `scripts/research/ossm_168_dryrun/sedenion.py`

use math::sedenion::{Sedenion, sed, sed_zero, sed_basis, sed_mul, sed_sub, sed_add};

// ============================================================================
// §1. L¹ NORM — sum of absolute values of all 16 components
// ============================================================================

fn f64_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

/// L¹ norm of a sedenion: sum of absolute component values.
/// Non-zero on generic states; vanishes only in associative subalgebras.
pub fn sed_l1_norm(s: Sedenion) -> f64 {
    f64_abs(s.e0)  + f64_abs(s.e1)  + f64_abs(s.e2)  + f64_abs(s.e3) +
    f64_abs(s.e4)  + f64_abs(s.e5)  + f64_abs(s.e6)  + f64_abs(s.e7) +
    f64_abs(s.e8)  + f64_abs(s.e9)  + f64_abs(s.e10) + f64_abs(s.e11) +
    f64_abs(s.e12) + f64_abs(s.e13) + f64_abs(s.e14) + f64_abs(s.e15)
}

// ============================================================================
// §2. SEDENION ASSOCIATOR — [a, b, c] = (a*b)*c - a*(b*c)
// ============================================================================

/// Sedenion associator. Non-zero for non-associative triples.
/// CD flexibility: [x, y, x] = 0 for all x, y (confirmed in Python dry-run).
pub fn sed_associator(a: Sedenion, b: Sedenion, c: Sedenion) -> Sedenion {
    let ab = sed_mul(a, b)
    let bc = sed_mul(b, c)
    sed_sub(sed_mul(ab, c), sed_mul(a, bc))
}

// ============================================================================
// §3. PER-TRIPLE L¹ CONTRIBUTION
//     Each triple (I, J, K) with I,K ∈ {1..7}, J ∈ {9..15}
//     Contribution: ||[h̃·eI, h̃·eJ, h̃·eK]||_{L¹}
// ============================================================================

pub fn sed_triple_l1(h: Sedenion, I: i64, J: i64, K: i64) -> f64 with Mut {
    let a = sed_mul(h, sed_basis(I, 1.0))
    let b = sed_mul(h, sed_basis(J, 1.0))
    let c = sed_mul(h, sed_basis(K, 1.0))
    sed_l1_norm(sed_associator(a, b, c))
}

// ============================================================================
// §4. KERNEL CONTEXT
//     Precomputed on CPU, passed as GPU buffers.
//     sign_table[256]: e_i * e_j = sign_table[i*16+j] * e_{i XOR j}
//     triples[504]:    168 × 3 (I, J, K) O_168 orbit indices, flattened
// ============================================================================

/// Context for sedenion GPU kernels. Created on CPU once, passed to dispatch.
pub struct SedKernelCtx {
    n_triples: i64,
    sign_table: [i64; 256],
    triples: [i64; 504],
}

/// Initialize kernel context. Fills sign table from Cayley-Dickson construction
