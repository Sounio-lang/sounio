// stdlib/serial/pure/types.sio — Serial Communication Types

module serial::pure::types

pub struct SerialConfig {
    pub baud_rate: i32,
    pub data_bits: i32,
    pub stop_bits: i32,
    pub parity: Parity,
}

pub enum Parity {
    None,
    Even,
    Odd,
}

pub struct SerialBuffer {
    pub rx_buf: [u8; 256],
    pub tx_buf: [u8; 256],
    pub rx_len: i32,
    pub tx_len: i32,
}

pub fn serial_config_new(rate: i32) -> SerialConfig {
    SerialConfig { baud_rate: rate, data_bits: 8, stop_bits: 1, parity: Parity::None }
}

pub fn serial_buffer_new() -> SerialBuffer {
    SerialBuffer { rx_buf: [0; 256], tx_buf: [0; 256], rx_len: 0, tx_len: 0 }
}

pub fn serial_buffer_push_rx(b: &!SerialBuffer, byte: u8) with Mut {
    if b.rx_len < 256 as i32 {
        b.rx_buf[b.rx_len as usize] = byte
        b.rx_len = b.rx_len + 1
    }
}

pub fn serial_buffer_pop_tx(b: &!SerialBuffer) -> u8 with Mut {
    if b.tx_len == 0 { return 0 }
    let byte = b.tx_buf[0]
    var i: i32 = 0
    while i < b.tx_len - 1 {
        b.tx_buf[i as usize] = b.tx_buf[(i + 1) as usize]
        i = i + 1
    }
    b.tx_len = b.tx_len - 1
    byte
}