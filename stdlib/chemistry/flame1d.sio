// ---------------- grid/frame constants (base grid; the fine/coarse
// dx-convergence grids run in the Python replica only, see
// benchmarks/chemistry/README.md) --------------------------------------

fn fl1d_nc() -> i64 { 200 as i64 }       // L = 8 mm at dx = 40 um
fn fl1d_dx() -> f64 { 4.0e-05 }
fn fl1d_dt_m() -> f64 { 5.0e-07 }        // 0.55 of the FTCS bound dx^2/(2 D_max)
fn fl1d_steps() -> i64 { 800 as i64 }    // t_end = 0.4 ms
fn fl1d_x0() -> f64 { 1.0e-03 }          // flame anchor (profile T=1500 K point)
fn fl1d_t_chem() -> f64 { 1200.0 }
fn fl1d_t_fast() -> f64 { 2200.0 }
fn fl1d_s_l_g() -> f64 { 1.6543 }        // Cantera unity-Lewis phi=1 guess
fn fl1d_y_h2o_eq() -> f64 { 2.406933e-01 } // HP-equilibrium Y_H2O (Cantera)
fn fl1d_t_plateau() -> f64 { 2350.0 }    // mask only near-equilibrium gas
fn fl1d_pin_s() -> f64 { 0.0 - 6.0e-4 }  // pinned burned reservoir: s <= -0.6 mm
// 1 when cell j sits inside the pinned hot-bath zone (frozen at the
// profile state): emulates the semi-infinite burned reservoir of the
// free flame. Without it the ~1 mm of hot gas behind the anchor drains
// out the left boundary at |u| ~ 11 m/s in ~90 us, the plateau cools,
// and the front is flushed downstream (replica smoke v6: drift -1.4 m/s).
fn fl1d_pinned(j: i64) -> i64 {
    let s = (j as f64 + 0.5) * fl1d_dx() - fl1d_x0();
    if s <= fl1d_pin_s() { 1 as i64 } else { 0 as i64 }
}

// ---------------- integer-scaled printing (values are scaled INSIDE the
// print helpers; lean_single has no float formatting) ----------------

pub fn fl1d_digit(d: i64) with IO, Mut, Div, Panic {
    if d == 0 { print("0") } else if d == 1 { print("1") } else if d == 2 { print("2") } else if d == 3 { print("3") } else if d == 4 { print("4") } else if d == 5 { print("5") } else if d == 6 { print("6") } else if d == 7 { print("7") } else if d == 8 { print("8") } else { print("9") }
}
pub fn fl1d_pi64a(x: i64) with IO, Mut, Div, Panic {
    if x >= 10 { fl1d_pi64a(x / 10); fl1d_digit(x % 10) } else { fl1d_digit(x) }
}
pub fn fl1d_pi64(x: i64) with IO, Mut, Div, Panic {
    if x < 0 { print("-"); fl1d_pi64a(0 - x) } else { fl1d_pi64a(x) }
}

fn fl1d_print_progress(t: f64, tmax: f64, xf: f64, active: i64) with IO, Mut, Div, Panic {
    print("  t=");
    fl1d_pi64((t * 1.0e6) as i64);
    print("us T_max=");
    fl1d_pi64(tmax as i64);
    print("K x_f=");
    fl1d_pi64((xf * 1.0e6) as i64);
    print("um active=");
    fl1d_pi64(active);
    println("")
}

fn fl1d_print_final(sl: f64, sl_int: f64, drift: f64, tmax: f64) with IO, Mut, Div, Panic {
    print("drift=");
    fl1d_pi64((drift * 1.0e4) as i64);
    print("1e-4m/s  S_L(slope)=");
    fl1d_pi64((sl * 1.0e4) as i64);
    print("1e-4m/s  S_L(integral)=");
    fl1d_pi64((sl_int * 1.0e4) as i64);
    print("1e-4m/s  T_max=");
    fl1d_pi64(tmax as i64);
    println("K")
}

// ---------------- one transport macro-step (FTCS Euler) ----------------
// Diffusion (zero-flux) + enthalpy-flux correction + upwind advection with
// the prescribed uniform mass flux rhou (< 0: right-to-left, fresh inflow
// through the right boundary, burned outflow on the left), then the state
// update with mass-fraction clip/renorm.

fn fl1d_transport_step(t: &![f64; 200], y: &![f64; 2000], rhou: f64) with Mut, Div, Panic {
    let nc = fl1d_nc();
    let dx = fl1d_dx();
    let dt_m = fl1d_dt_m();
    let mw = fl1d_mw();
    let y_u = fl1d_y_u();
    var rho: [f64; 200] = [0.0; 200];
    var cp: [f64; 200] = [0.0; 200];
    var dd: [f64; 200] = [0.0; 200];
    var lam: [f64; 200] = [0.0; 200];
    var rdf: [f64; 199] = [0.0; 199];
    var lamf: [f64; 199] = [0.0; 199];
    var rt: [f64; 200] = [0.0; 200];
    var ry: [f64; 2000] = [0.0; 2000];
    var yj: [f64; 10] = [0.0; 10];
    var i: i64 = 0;
    var j: i64 = 0;
    while j < nc {
        i = 0
        while i < 10 { yj[i] = y[j * 10 + i]; i = i + 1 }
        rho[j] = fl1d_rho_of(t[j], &yj);
        cp[j] = fl1d_cp_of(t[j], &yj);
        dd[j] = fl1d_d_of(t[j]);
        lam[j] = rho[j] * cp[j] * dd[j];
        j = j + 1
    }
    var f: i64 = 0;
    while f < nc - 1 {
        rdf[f] = 0.5 * (rho[f] * dd[f] + rho[f + 1] * dd[f + 1]);
        lamf[f] = 0.5 * (lam[f] + lam[f + 1]);
        f = f + 1
    }
    // diffusion (zero-flux boundaries)
    f = 0
    while f < nc - 1 {
        let dtx = (t[f + 1] - t[f]) / dx;
        let q = 0.0 - lamf[f] * dtx;
        rt[f] = rt[f] - q / (rho[f] * cp[f] * dx);
        rt[f + 1] = rt[f + 1] + q / (rho[f + 1] * cp[f + 1] * dx);
        i = 0
        while i < 10 {
            let jy = 0.0 - rdf[f] * (y[(f + 1) * 10 + i] - y[f * 10 + i]) / dx;
            ry[f * 10 + i] = ry[f * 10 + i] - jy / (rho[f] * dx);
            ry[(f + 1) * 10 + i] = ry[(f + 1) * 10 + i] + jy / (rho[f + 1] * dx);
            i = i + 1
        }
        f = f + 1
    }
    // enthalpy-flux correction -sum(j_k cp_k) dT/dx at cell centers
    j = 0
    while j < nc {
        let jm = if j > 0 { j - 1 } else { 0 };
        let jp = if j < nc - 1 { j + 1 } else { nc - 1 };
        let span = ((jp - jm) as f64) * dx;
        let dtx = (t[jp] - t[jm]) / span;
        var s = 0.0;
        i = 0
        while i < 10 {
            let jyc = 0.0 - rho[j] * dd[j] * (y[jp * 10 + i] - y[jm * 10 + i]) / span;
            s = s + jyc * (g30_cp_r(i, t[j]) * fl1d_r() / (mw[i] * 1.0e-3));
            i = i + 1
        }
        rt[j] = rt[j] - s * dtx / (rho[j] * cp[j]);
        j = j + 1
    }
    // advection (upwind) with the prescribed uniform mass flux:
    // interior species face fluxes
    f = 0
    while f < nc - 1 {
        let up = if rhou >= 0.0 { f } else { f + 1 };
        i = 0
        while i < 10 {
            let fl = rhou * y[up * 10 + i];
            ry[f * 10 + i] = ry[f * 10 + i] - fl / (rho[f] * dx);
            ry[(f + 1) * 10 + i] = ry[(f + 1) * 10 + i] + fl / (rho[f + 1] * dx);
            i = i + 1
        }
        f = f + 1
    }
    // boundary faces: fresh inflow on the right, burned outflow on the left
    i = 0
    while i < 10 {
        ry[(nc - 1) * 10 + i] = ry[(nc - 1) * 10 + i] - rhou * y_u[i] / (rho[(nc - 1) as usize] * dx);
        ry[i] = ry[i] + rhou * y[i] / (rho[0] * dx);
        i = i + 1
    }
    // T advection, cell-centered upwind; fresh ghost cell T_u on the right
    j = 0
    while j < nc {
        let u = rhou / rho[j];
        if u >= 0.0 {
            let jb = if j > 0 { j - 1 } else { 0 };
            rt[j] = rt[j] - u * (t[j] - t[jb]) / dx
        } else {
            if j < nc - 1 {
                rt[j] = rt[j] - u * (t[j + 1] - t[j]) / dx
            } else {
                rt[j] = rt[j] - u * (300.0 - t[j]) / dx
            }
        }
        j = j + 1
    }
    // state update with mass-fraction clip + renormalization
    // (pinned reservoir cells are frozen: skip their update)
    j = 0
    while j < nc {
        if fl1d_pinned(j) == 0 {
            t[j] = t[j] + dt_m * rt[j];
            var ys = 0.0;
            i = 0
            while i < 10 {
                var v = y[j * 10 + i] + dt_m * ry[j * 10 + i];
                if v < 0.0 { v = 0.0 }
                if v > 1.0 { v = 1.0 }
                y[j * 10 + i] = v;
                ys = ys + v;
                i = i + 1
            }
            if ys > 0.0 {
                i = 0
                while i < 10 { y[j * 10 + i] = y[j * 10 + i] / ys; i = i + 1 }
            }
        }
        j = j + 1
    }
}

// ---------------- the flame driver ----------------
// Runs the base grid for t_end = 0.4 ms in the flame frame (prescribed
// mass flux rho_u * S_L_G) and returns (S_L slope, S_L integral, drift)
// in m/s: S_L = S_L_G + dx_f/dt. Prints a progress line every `every`
// macro-steps when every > 0.

pub fn fl1d_run(every: i64) -> (f64, f64, f64) with Mut, Div, Panic, IO {
    let nc = fl1d_nc();
    let dx = fl1d_dx();
    let dt_m = fl1d_dt_m();
    let y_u = fl1d_y_u();
    let rho_u = fl1d_rho_of(300.0, &y_u);
    let rhou = 0.0 - rho_u * fl1d_s_l_g();
    let pn = fl1d_prof_n();
    let pt = fl1d_prof_t();
    let py = fl1d_prof_y();
    // activity mask: skip chemistry ONLY for gas essentially at HP
    // equilibrium (T > 2350 K AND Y_H2O >= 0.99*Y_H2O,eq). Masking the
    // 2000-2350 K recombination tail freezes its heat release and flushes
    // the front downstream (replica smoke v5: drift ~ -1.4 m/s).
    let y_h2o_mask = 0.99 * fl1d_y_h2o_eq();
    let t_plateau = fl1d_t_plateau();
    var t: [f64; 200] = [0.0; 200];
    var y: [f64; 2000] = [0.0; 2000];
    var yj: [f64; 10] = [0.0; 10];
    var yin: [f64; 10] = [0.0; 10];
    // initial condition: profile anchored with its x=0 (T=1500 K) at x0
    var j: i64 = 0;
    var i: i64 = 0;
    while j < nc {
        let s = (j as f64 + 0.5) * dx - fl1d_x0();
        if s <= 0.0 - 1.0e-3 {
            t[j] = pt[0];
            i = 0
            while i < 10 { y[j * 10 + i] = py[i]; i = i + 1 }
        } else if s >= 5.0e-3 {
            t[j] = 300.0;
            i = 0
            while i < 10 { y[j * 10 + i] = y_u[i]; i = i + 1 }
        } else {
            let u = (s + 1.0e-3) / 2.0e-5;
            let k = u as i64;
            let fr = u - (k as f64);
            t[j] = pt[k] * (1.0 - fr) + pt[k + 1] * fr;
            i = 0
            while i < 10 {
                y[j * 10 + i] = py[k * 10 + i] * (1.0 - fr) + py[(k + 1) * 10 + i] * fr;
                i = i + 1
            }
        }
        j = j + 1
    }
    // least-squares drift accumulators (last 60% of the run)
    let t_win = 0.4 * dt_m * (fl1d_steps() as f64);
    var nw = 0.0;
    var swt = 0.0;
    var swx = 0.0;
    var swtx = 0.0;
    var swtt = 0.0;
    var tm = 0.0;
    var step: i64 = 0;
    var xf = 0.0;
    var tmax = 0.0;
    while step < fl1d_steps() {
        // (1) chemistry on reactive cells: hot gas (T > t_chem), or cold
        // gas carrying a radical pool (H+O+OH+HO2 > 1e-8). A pure T cutoff
        // starves the radical-seeded 700-1200 K preheat foot and the flame
        // blows off (replica smokes v6/v7: front collapse, drift -1.5 m/s).
        // Pinned reservoir cells and near-equilibrium burned gas skip.
        // Adaptive substepping: slow cells (T <= 2200 K) take 4x larger steps
        var n_active: i64 = 0;
        j = 0
        while j < nc {
            if fl1d_pinned(j) == 0 {
                if !(t[j] > t_plateau && y[j * 10 + 5] >= y_h2o_mask) {
                    if t[j] > fl1d_t_chem() || y[j * 10 + 1] + y[j * 10 + 2] + y[j * 10 + 4] + y[j * 10 + 6] > 1.0e-8 {
                        i = 0
                        while i < 10 { yj[i] = y[j * 10 + i]; i = i + 1 }
                        let ns = if t[j] > fl1d_t_fast() { 50 as i64 } else { 12 as i64 };
                        // separate in/out arrays: madaros E038 forbids &yj + &!yj
                        i = 0
                        while i < 10 { yin[i] = yj[i]; i = i + 1 }
                        t[j] = fl1d_chem_substep(t[j], &yin, &!yj, dt_m / (ns as f64), ns);
                        i = 0
                        while i < 10 { y[j * 10 + i] = yj[i]; i = i + 1 }
                        n_active = n_active + 1
                    }
                }
            }
            j = j + 1
        }
        // (2) transport
        fl1d_transport_step(&!t, &!y, rhou);
        tm = tm + dt_m;
        step = step + 1;
        // tracked front: centroid of (max(-dT/dx,0))^2
        var wsum = 0.0;
        var xsum = 0.0;
        var f: i64 = 0;
        tmax = 0.0;
        while f < nc - 1 {
            let g = (t[f] - t[f + 1]) / dx;
            if g > 0.0 {
                let w = g * g;
                wsum = wsum + w;
                xsum = xsum + ((f + 1) as f64) * dx * w
            }
            if t[f] > tmax { tmax = t[f] }
            f = f + 1
        }
        if t[nc - 1] > tmax { tmax = t[nc - 1] }
        xf = xsum / wsum;
        if tm >= t_win {
            nw = nw + 1.0;
            swt = swt + tm;
            swx = swx + xf;
            swtx = swtx + tm * xf;
            swtt = swtt + tm * tm
        }
        if every > 0 {
            if step % every == 0 {
                fl1d_print_progress(tm, tmax, xf, n_active)
            }
        }
    }
    let den = swtt - swt * swt / nw;
    let drift = (swtx - swt * swx / nw) / den;
    let sl = fl1d_s_l_g() + drift;
    // mass-flux integral cross-check on the final state
    var acc = 0.0;
    j = 0
    while j < nc {
        if t[j] > 600.0 {
            i = 0
            while i < 10 { yj[i] = y[j * 10 + i]; i = i + 1 }
            let rho_j = fl1d_rho_of(t[j], &yj);
            let c = fl1d_cell_c(rho_j, &yj);
            let (_dtd, dc) = g30_cp_rhs(t[j], &c);
            acc = acc + (0.0 - dc[0]) * 1.0e6 * 2.016e-3 * dx
        }
        j = j + 1
    }
    let sl_int = acc / (rho_u * y_u[0]);
    fl1d_print_final(sl, sl_int, drift, tmax);
    (sl, sl_int, drift)
}

// ---------------- suite-test pins (values from the independent Python
// replica benchmarks/chemistry/flame1d_replica.py) ----------------

fn fl1d_check_near(x: f64, expect: f64, tol: f64) -> bool {
    let d = x - expect;
    let ad = if d < 0.0 { 0.0 - d } else { d };
    ad <= tol
}

fn fl1d_check_rel(x: f64, expect: f64, rel: f64) -> bool {
    let scale = if expect < 0.0 { 0.0 - expect } else { expect };
    let tol = if scale > 0.0 { rel * scale } else { 1.0e-30 };
    fl1d_check_near(x, expect, tol)
}

pub fn test_fl1d_transport() -> bool with Mut, Div, Panic {
    // replica: D_of(1000)=2.81540699e-4  D_of(2300)=9.36905205e-4
    //          rho_of(1500,Y_U)=0.16989442  cp_of(1500,Y_U)=1641.18159757
    //          rho_of(300,Y_U)=0.84947211
    let y_u = fl1d_y_u();
    fl1d_check_near(fl1d_d_of(1000.0), 2.81540699e-04, 1.0e-08) &&
    fl1d_check_near(fl1d_d_of(2300.0), 9.36905205e-04, 1.0e-08) &&
    fl1d_check_near(fl1d_rho_of(1500.0, &y_u), 0.16989442, 1.0e-06) &&
    fl1d_check_near(fl1d_cp_of(1500.0, &y_u), 1641.18159757, 1.0e-02) &&
    fl1d_check_near(fl1d_rho_of(300.0, &y_u), 0.84947211, 1.0e-06)
}

pub fn test_fl1d_substep() -> bool with Mut, Div, Panic {
    // Cantera 3.2.0 / gri30.yaml, filtered 10-species/29-reaction mechanism,
    // 1 atm, clamped fixed-step RK4 using Cantera net production rates and
    // NASA-7 enthalpy/cp in the same isobaric energy balance as this solver:
    //   (2000 K, Y_U, 50 x 1e-8 s): T=1999.914517435 Y_H2=2.851953220147e-2
    //                               Y_H2O=9.283770958722e-6
    //   (1600 K, Y_U, 12 x 1e-8 s): T=1599.999285870 Y_H2=2.852237706773e-2
    //                               Y_H2O=2.043821953259e-9
    let y_u = fl1d_y_u();
    var y1: [f64; 10] = [0.0; 10];
    var y2: [f64; 10] = [0.0; 10];
    let t1 = fl1d_chem_substep(2000.0, &y_u, &!y1, 1.0e-8, 50 as i64);
    let t2 = fl1d_chem_substep(1600.0, &y_u, &!y2, 1.0e-8, 12 as i64);
    fl1d_check_rel(t1, 1999.914517435, 1.0e-8) &&
    fl1d_check_rel(y1[0], 2.851953220147e-02, 1.0e-6) &&
    fl1d_check_rel(y1[5], 9.283770958722e-06, 1.0e-6) &&
    fl1d_check_rel(t2, 1599.999285870, 1.0e-8) &&
    fl1d_check_rel(y2[0], 2.852237706773e-02, 1.0e-6) &&
    fl1d_check_rel(y2[5], 2.043821953259e-09, 1.0e-6)
}
