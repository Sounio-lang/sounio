// ============================================================================
// flame1d.sio — 1-D premixed freely-propagating H2/air laminar flame (phi=1)
// ============================================================================
// Third leg of the combustion trilogy (isothermal kinetics -> adiabatic
// shock tube -> laminar flame speed). Low-Mach 1-D premixed flame at
// p = 1 atm, unburned phi=1 H2/air (H2:O2:N2 = 2:1:3.76) at T_u = 300 K.
//
// TRANSPORT DECISION (documented in benchmarks/chemistry/README.md):
//   unity Lewis number — one shared diffusivity D(T) for heat and ALL
//   species, D(T) = D0 (T/300)^n fit to Cantera's operative lambda/(rho cp)
//   along its own unity-Lewis free-flame solution (29-reaction H/O
//   sub-mechanism; see benchmarks/chemistry/flame1d_cantera.py). The
//   mixture-averaged flame speed (~2.33 m/s at phi=1, preferential H2
//   diffusion) is CONTEXT ONLY and is never the match target. The match
//   target is the same-transport Cantera unity-Lewis value
//   S_L = 1.6543 m/s.
//
// Model equations (identical to benchmarks/chemistry/flame1d_replica.py):
//   Godunov operator split per macro-step dt_m:
//     (1) chemistry: isobaric batch per REACTIVE cell — T > 1200 K, or any
//         cell carrying a radical pool (H+O+OH+HO2 > 1e-8) — excluding the
//         near-equilibrium burned plateau and the pinned reservoir (below).
//         The radical-pool clause is REQUIRED: a pure T cutoff masks the
//         radical-seeded heat release of the 700-1200 K preheat foot that
//         the Cantera profile carries, and the flame blows off (replica
//         smokes v6/v7: foot dies, front collapses, drift ~ -1.5 m/s).
//         Stage-clamped explicit RK4 substeps at dt_c ~ 1e-8 s. Clamping
//         (Y <- max(Y,0) on every RK stage state and the final update) is
//         REQUIRED: unclamped RK4 and Euler/RK2 blow up above ~2400 K
//         through HO2/H2O2 stage negativity (0-D probed).
//         dT/dt = -T sum(h_rt omega)/sum(c cp_r) (isobaric; NOT the
//         shock-tube constant-volume form), dc/dt from gri30_h2.
//     (2) transport: explicit FTCS Euler over all cells — species/heat
//         diffusion with the enthalpy-flux correction -sum(j_k cp_k) dT/dx,
//         and upwind advection with the PRESCRIBED uniform mass flux
//         rho*u = -rho_u S_L_G (flame frame: fresh inflow through the right
//         boundary, burned outflow on the left; for the steady equations
//         d(rho u)/dx = 0 is exact). dt_m limited by the FTCS bound
//         dx^2/(2 D_max) (dt_m = 5e-7 s at dx = 40 um is 0.55 of the bound).
//
// Pinned hot-bath zone: cells more than 0.6 mm behind the flame anchor
// (s <= -0.6 mm) are FROZEN at the initial profile state (Dirichlet burned
// reservoir; both chemistry and transport updates skip them). Required
// because the domain holds only ~1 mm of burned gas: unpinned, it drains
// out the left boundary at |u| ~ 11 m/s in ~90 us, the plateau cools, and
// the front loses its thermal anchor (replica smoke v6: drift -1.4 m/s).
// The exported Cantera profile is also truncated on the burned side (its
// hot end is 2102 K, not T_ad = 2384.7 K — the recombination tail burns
// for ~cm beyond the export window); the integral cross-check is biased
// ~10% low by the missing tail (documented, never the match target).
//
// Initial condition: the CONVERGED Cantera unity-Lewis phi=1 free-flame
// profile (tables below), anchored with its T = 1500 K point at x = 1 mm.
// The solver's own slab-ignition transient takes ~1 ms to reach the steady
// flame (probed in the replica: a hot-products slab collapses diffusively
// and the front re-establishes through a ~3.5 m/s transient), and a
// lab-frame run needs a similar time for the continuity-induced velocity
// field to build; both would blow the lean_single runtime budget. Starting
// at the converged profile in the flame frame turns the benchmark into a
// pure propagation-speed (eigenvalue) measurement: operator-splitting
// inconsistencies show up as front drift, not as a startup transient.
//
// Speed extraction: with the inflow at S_L_G, the front drifts at
// dx_f/dt = S_L - S_L_G, so S_L = S_L_G + least-squares slope of x_f(t)
// over the last 60% of the run (front position = centroid of
// (max(-dT/dx,0))^2). Cross-check: mass-flux integral
// S_L = integral(-omega_H2 W_H2) dx / (rho_u Y_H2,u), exact for a steady
// flame in any frame.
// ============================================================================

use chemistry::gri30_h2::*;

// ---------------- physical/model constants ----------------

fn fl1d_r() -> f64 { 8.31446261815324 }
fn fl1d_p0() -> f64 { 101325.0 }

fn fl1d_mw() -> [f64; 10] {
    // g/mol, Cantera gri30.yaml species order H2 H O O2 OH H2O HO2 H2O2 N2 AR
    [2.016, 1.008, 15.999, 31.998, 17.007, 18.015, 33.006, 34.014, 28.014, 39.95]
}

pub fn fl1d_y_u() -> [f64; 10] {
    // unburned mass fractions, phi=1 H2/air (H2:O2:N2 = 2:1:3.76 by mole)
    [2.852239e-02, 0.0, 0.0, 2.263540e-01, 0.0, 0.0, 0.0, 0.0, 7.451236e-01, 0.0]
}

// unity-Lewis diffusivity power law, fit to Cantera's lambda/(rho cp)
// samples along the 29-reaction unity-Lewis phi=1 free flame (fit error
// within +/-9% over 300-2300 K; see benchmarks/chemistry/README.md)
fn fl1d_d0() -> f64 { 4.951824e-05 }
fn fl1d_dn() -> f64 { 1.443501 }

pub fn fl1d_d_of(t: f64) -> f64 with Mut, Div, Panic {
    fl1d_d0() * g30_pow(t / 300.0, fl1d_dn())
}

// ---------------- mixture helpers ----------------

pub fn fl1d_rho_of(t: f64, y: &[f64; 10]) -> f64 {
    // rho = p / (R_s T), R_s = R sum Y_i/W_i
    let mw = fl1d_mw();
    var rs = 0.0;
    var i: i64 = 0;
    while i < 10 { rs = rs + y[i] / (mw[i] * 1.0e-3); i = i + 1 }
    fl1d_p0() / (fl1d_r() * rs * t)
}

pub fn fl1d_cp_of(t: f64, y: &[f64; 10]) -> f64 with Mut, Div, Panic {
    // mixture isobaric heat capacity, J/kg/K
    let mw = fl1d_mw();
    var cp = 0.0;
    var i: i64 = 0;
    while i < 10 {
        cp = cp + y[i] * (g30_cp_r(i, t) * fl1d_r() / (mw[i] * 1.0e-3));
        i = i + 1
    }
    cp
}

pub fn fl1d_cell_c(rho: f64, y: &[f64; 10]) -> [f64; 10] {
    // mol/cm^3 from rho [kg/m3] and mass fractions
    let mw = fl1d_mw();
    var c: [f64; 10] = [0.0; 10];
    var i: i64 = 0;
    while i < 10 { c[i] = rho * y[i] / (mw[i] * 1.0e-3) / 1.0e6; i = i + 1 }
    c
}

// ---------------- isobaric chemistry substep ----------------

// One stage-clamped RK4 evaluation helper: isobaric (T,Y) right-hand side.
fn fl1d_cp_rhs(t: f64, y: &[f64; 10], dy: &![f64; 10]) -> f64 with Mut, Div, Panic {
    let mw = fl1d_mw();
    let rho = fl1d_rho_of(t, y);
    let c = fl1d_cell_c(rho, y);
    var dc: [f64; 10] = [0.0; 10];
    // out-param RHS form: the tuple-array destructure inside the RK4 stage
    // loop miscompiles on madaros (documented engine class)
    let dtdt = g30_cp_rhs_out(t, &c, &!dc);
    var i: i64 = 0;
    while i < 10 { dy[i] = dc[i] * mw[i] * 1.0e3 / rho; i = i + 1 }
    dtdt
}

pub fn fl1d_chem_substep(t0: f64, y0: &[f64; 10], yn: &![f64; 10], dt_sub: f64, n_sub: i64) -> f64 with Mut, Div, Panic {
    // Stage-clamped explicit RK4: every RK stage state and the final update
    // clamps Y to >= 0; without the clamp the HO2/H2O2 stages go negative
    // above ~2400 K and the detailed-balance exp() overflows. The updated
    // composition is written to yn (out-param, not a tuple-array return:
    // two simultaneously-held tuple-array results alias on lean_single).
    var t = t0;
    var y: [f64; 10] = [0.0; 10];
    var i: i64 = 0;
    while i < 10 { y[i] = if y0[i] < 0.0 { 0.0 } else { y0[i] }; i = i + 1 }
    var k1y: [f64; 10] = [0.0; 10];
    var k2y: [f64; 10] = [0.0; 10];
    var k3y: [f64; 10] = [0.0; 10];
    var k4y: [f64; 10] = [0.0; 10];
    var ys: [f64; 10] = [0.0; 10];
    var s: i64 = 0;
    while s < n_sub {
        let k1t = fl1d_cp_rhs(t, &y, &!k1y);
        i = 0
        while i < 10 {
            let v = y[i] + 0.5 * dt_sub * k1y[i];
            ys[i] = if v < 0.0 { 0.0 } else { v };
            i = i + 1
        }
        let k2t = fl1d_cp_rhs(t + 0.5 * dt_sub * k1t, &ys, &!k2y);
        i = 0
        while i < 10 {
            let v = y[i] + 0.5 * dt_sub * k2y[i];
            ys[i] = if v < 0.0 { 0.0 } else { v };
            i = i + 1
        }
        let k3t = fl1d_cp_rhs(t + 0.5 * dt_sub * k2t, &ys, &!k3y);
        i = 0
        while i < 10 {
            let v = y[i] + dt_sub * k3y[i];
            ys[i] = if v < 0.0 { 0.0 } else { v };
            i = i + 1
        }
        let k4t = fl1d_cp_rhs(t + dt_sub * k3t, &ys, &!k4y);
        t = t + dt_sub / 6.0 * (k1t + 2.0 * k2t + 2.0 * k3t + k4t);
        i = 0
        while i < 10 {
            let v = y[i] + dt_sub / 6.0 * (k1y[i] + 2.0 * k2y[i] + 2.0 * k3y[i] + k4y[i]);
            y[i] = if v < 0.0 { 0.0 } else { v };
            i = i + 1
        }
        s = s + 1
    }
    i = 0
    while i < 10 { yn[i] = y[i]; i = i + 1 }
    t
}

