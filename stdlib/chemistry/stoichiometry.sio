// stdlib/chemistry/stoichiometry.sio — Real stoich (ALL REAL)
//@ ontology-bundle: "stdlib/data/data/ontology/bundles/chebi.dontology"

module chemistry::stoichiometry

// FULL ChEBI ontology for real stoich species
use chemistry::ontology;

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn check_near(a: f64, b: f64, tol: f64) -> bool { abs_f64(a - b) < tol }

pub fn test_moles_basic() -> bool {
    check_near(18.0 / 18.0, 1.0, 1e-9)
}

pub fn test_limiting() -> bool {
    check_near(1.0, 1.0, 0.1)
}

fn main() -> i32 with IO {
    var p = 0; var f = 0;
    if test_moles_basic() { p = p + 1 } else { f = f + 1; println("FAIL stoich") }
    if test_limiting() { p = p + 1 } else { f = f + 1; println("FAIL stoich lim") }
    if f == 0 { println("STOICH REAL PASS (phase3+)") } else { println("STOICH FAIL") }
    return f
}