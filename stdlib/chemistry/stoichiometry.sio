// stdlib/chemistry/stoichiometry.sio — Real stoichiometry foundations (import-free, check-green)
//
// E2E contract (tests/stdlib/chemistry/test_kinetics_foundations_e2e.sio):
//   moles_from_mass, limiting_extent, percent_yield
//   Gate metrics: h2o_moles_18g, limiting_extent, percent_yield_90
//@ ontology-bundle: "stdlib/data/data/ontology/bundles/chebi.dontology"

module chemistry::stoichiometry

fn stoi_abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn stoi_f64_sub(a: f64, b: f64) -> f64 {
    if a >= b { a - b } else { b - a }
}
fn stoi_check_near(a: f64, b: f64, tol: f64) -> bool { stoi_f64_sub(a, b) < tol }

// Moles = mass (g) / molar mass (g/mol).
pub fn moles_from_mass(mass_g: f64, molar_mass: f64) -> f64 with Div, Panic {
    if molar_mass <= 0.0 { return 0.0 }
    mass_g / molar_mass
}

// Mass (g) from moles and molar mass.
pub fn mass_from_moles(moles: f64, molar_mass: f64) -> f64 with Mut, Panic {
    moles * molar_mass
}

// Extent limited by stoichiometric ratios n_i / coeff_i (minimum positive extent).
pub fn limiting_extent(n_a: f64, coeff_a: f64, n_b: f64, coeff_b: f64) -> f64 with Div, Panic {
    if coeff_a <= 0.0 || coeff_b <= 0.0 { return 0.0 }
    let extent_a = n_a / coeff_a
    let extent_b = n_b / coeff_b
    if extent_a <= extent_b { extent_a } else { extent_b }
}

// Percent yield = 100 * actual / theoretical.
pub fn percent_yield(actual: f64, theoretical: f64) -> f64 with Div, Panic {
    if theoretical <= 0.0 { return 0.0 }
    100.0 * actual / theoretical
}

// Mole fraction of component i in a binary mixture.
pub fn mole_fraction(n_i: f64, n_total: f64) -> f64 with Div, Panic {
    if n_total <= 0.0 { return 0.0 }
    n_i / n_total
}

pub fn test_moles_basic() -> bool with Div, Panic {
    stoi_check_near(moles_from_mass(18.0, 18.0), 1.0, 1e-9)
}

pub fn test_mass_from_moles() -> bool with Mut, Panic {
    stoi_check_near(mass_from_moles(2.0, 18.0), 36.0, 1e-9)
}

pub fn test_limiting() -> bool with Div, Panic {
    // 2 H2 + O2 -> 2 H2O: 3 mol H2, 1 mol O2 => O2 limits at extent 1
    stoi_check_near(limiting_extent(3.0, 2.0, 1.0, 1.0), 1.0, 1e-9)
}

pub fn test_percent_yield() -> bool with Div, Panic {
    stoi_check_near(percent_yield(9.0, 10.0), 90.0, 1e-9)
}

pub fn test_mole_fraction() -> bool with Div, Panic {
    stoi_check_near(mole_fraction(1.0, 4.0), 0.25, 1e-9)
}

fn stoi_emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC chemistry ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn stoi_bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Div, Panic, Mut {
    var p: i32 = 0
    var f: i32 = 0
    if test_moles_basic() { p = p + 1 } else { f = f + 1; println("FAIL stoich moles") }
    if test_mass_from_moles() { p = p + 1 } else { f = f + 1; println("FAIL stoich mass") }
    if test_limiting() { p = p + 1 } else { f = f + 1; println("FAIL stoich lim") }
    if test_percent_yield() { p = p + 1 } else { f = f + 1; println("FAIL stoich yield") }
    if test_mole_fraction() { p = p + 1 } else { f = f + 1; println("FAIL stoich x") }

    stoi_emit_metric("h2o_moles_18g", moles_from_mass(18.0, 18.0))
    stoi_emit_metric("limiting_extent", limiting_extent(3.0, 2.0, 1.0, 1.0))
    stoi_emit_metric("percent_yield_90", percent_yield(9.0, 10.0))
    stoi_emit_metric("stoichiometry_ok", stoi_bool_to_f64(f == 0))
    stoi_emit_metric("tests_passed", p as f64)

    if f == 0 {
        println("STOICH FOUNDATIONS REAL PASS (phase3+)")
        print("SCIENCE_CHEMISTRY_OK\n")
        return 0
    }
    println("STOICH FAIL")
    return f
}