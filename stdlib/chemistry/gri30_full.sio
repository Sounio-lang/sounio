// ---------------- thermochemistry (NASA7) ----------------

// Per-invocation storage for the full mechanism. Keeping the immutable tables
// and all hot-loop scratch in one workspace avoids native-v2 arena growth while
// preserving reentrancy between independent simulations.
struct G30FWorkspace {
    nasa_low: [f64; 371],
    nasa_high: [f64; 371],
    rxn_a: [f64; 325],
    rxn_b: [f64; 325],
    rxn_ea: [f64; 325],
    rxn_type: [i64; 325],
    reversible: [i64; 325],
    low_a: [f64; 325],
    low_b: [f64; 325],
    low_ea: [f64; 325],
    troe_a: [f64; 325],
    troe_t3: [f64; 325],
    troe_t1: [f64; 325],
    troe_t2: [f64; 325],
    has_troe: [i64; 325],
    reac: [f64; 17225],
    prod: [f64; 17225],
    nu: [f64; 17225],
    eff: [f64; 17225],
    urel: [f64; 325],
    kc: [f64; 325],
    rates: [f64; 650],
    state: [f64; 583],
    jac: [f64; 2809],
    sens: [f64; 69324],
}

fn g30f_ws_init(ws: &!G30FWorkspace) with Mut, Panic {
    ws.nasa_low = g30f_nasa_low();
    ws.nasa_high = g30f_nasa_high();
    ws.rxn_a = g30f_rxn_a();
    ws.rxn_b = g30f_rxn_b();
    ws.rxn_ea = g30f_rxn_ea();
    ws.rxn_type = g30f_rxn_type();
    ws.reversible = g30f_reversible();
    ws.low_a = g30f_low_a();
    ws.low_b = g30f_low_b();
    ws.low_ea = g30f_low_ea();
    ws.troe_a = g30f_troe_a();
    ws.troe_t3 = g30f_troe_t3();
    ws.troe_t1 = g30f_troe_t1();
    ws.troe_t2 = g30f_troe_t2();
    ws.has_troe = g30f_has_troe();
    // Populate the persistent workspace in place. Returning these 17,225-slot
    // tables creates large temporary aggregates in native-v2 and needlessly
    // consumes arena lifetime in every reactor and UQ entry point.
    g30f_reac_init(&!ws.reac);
    g30f_prod_init(&!ws.prod);
    g30f_nu_init(&!ws.nu);
    g30f_eff_init(&!ws.eff);
    ws.urel = g30f_urel();
    ws.kc = [0.0; 325];
    ws.rates = [0.0; 650];
    ws.state = [0.0; 583];
    ws.jac = [0.0; 2809];
    ws.sens = [0.0; 69324];
}

fn g30f_ws_g_rt(ws: &!G30FWorkspace, sp: i64, t: f64) -> f64 with Mut, Div, Panic {
    let base = if t <= 1000.0 { sp * 7 } else { 10000 + sp * 7 };
    var a0 = 0.0; var a1 = 0.0; var a2 = 0.0; var a3 = 0.0; var a4 = 0.0; var a5 = 0.0; var a6 = 0.0;
    if base >= 10000 {
        let bb = base - 10000;
        a0 = ws.nasa_high[bb]; a1 = ws.nasa_high[bb+1]; a2 = ws.nasa_high[bb+2]; a3 = ws.nasa_high[bb+3];
        a4 = ws.nasa_high[bb+4]; a5 = ws.nasa_high[bb+5]; a6 = ws.nasa_high[bb+6];
    } else {
        a0 = ws.nasa_low[base]; a1 = ws.nasa_low[base+1]; a2 = ws.nasa_low[base+2]; a3 = ws.nasa_low[base+3];
        a4 = ws.nasa_low[base+4]; a5 = ws.nasa_low[base+5]; a6 = ws.nasa_low[base+6];
    }
    let h_rt = a0 + a1*t/2.0 + a2*t*t/3.0 + a3*t*t*t/4.0 + a4*t*t*t*t/5.0 + a5/t;
    let s_r = a0*g30f_ln(t) + a1*t + a2*t*t/2.0 + a3*t*t*t/3.0 + a4*t*t*t*t/4.0 + a6;
    h_rt - s_r
}

fn g30f_ws_fill_kc(ws: &!G30FWorkspace, t: f64) with Mut, Div, Panic {
    let c0cm = 101325.0 / (8.31446261815324 * t) * 1.0e-6;
    var r: i64 = 0;
    while r < 325 {
        var dg = 0.0;
        var dn = 0.0;
        var s: i64 = 0;
        while s < 53 {
            let n = ws.nu[r*53+s];
            dg = dg + n * g30f_ws_g_rt(ws, s, t);
            dn = dn + n;
            s = s + 1;
        }
        ws.kc[r] = g30f_exp(0.0 - dg) * g30f_pow(c0cm, dn);
        r = r + 1;
    }
}

// standard Gibbs free energy G0/(R T) for species sp at temperature t
// (table refs passed in: hot paths build the NASA tables once)
fn g30f_g_rt_t(sp: i64, t: f64, lo: &[f64; 371], hi: &[f64; 371]) -> f64 with Mut, Div, Panic {
    let base = if t <= 1000.0 { sp * 7 } else { 10000 + sp * 7 };  // 10000 marks high set
    var a0 = 0.0; var a1 = 0.0; var a2 = 0.0; var a3 = 0.0; var a4 = 0.0; var a5 = 0.0; var a6 = 0.0;
    if base >= 10000 {
        let bb = base - 10000;
        a0 = hi[bb]; a1 = hi[bb+1]; a2 = hi[bb+2]; a3 = hi[bb+3]; a4 = hi[bb+4]; a5 = hi[bb+5]; a6 = hi[bb+6];
    } else {
        a0 = lo[base]; a1 = lo[base+1]; a2 = lo[base+2]; a3 = lo[base+3]; a4 = lo[base+4]; a5 = lo[base+5]; a6 = lo[base+6];
    }
    let h_rt = a0 + a1*t/2.0 + a2*t*t/3.0 + a3*t*t*t/4.0 + a4*t*t*t*t/5.0 + a5/t;
    let s_r = a0*g30f_ln(t) + a1*t + a2*t*t/2.0 + a3*t*t*t/3.0 + a4*t*t*t*t/4.0 + a6;
    h_rt - s_r
}

// Kp (dimensionless, CHEMKIN/GRI standard state 1 atm = 101325 Pa) for reaction r at t
pub fn g30f_kp(r: i64, t: f64) -> f64 with Mut, Div, Panic {
    let nu = g30f_nu();
    let lo = g30f_nasa_low();
    let hi = g30f_nasa_high();
    var dg = 0.0;
    var s: i64 = 0;
    while s < 53 { dg = dg + nu[r*53+s] * g30f_g_rt_t(s, t, &lo, &hi); s = s + 1; }
    g30f_exp(0.0 - dg)
}

// Kc in (mol/cm^3)^dn units: CHEMKIN/GRI standard state is 1 atm.
// Kc = Kp * (c0 * 1e-6)^dn, c0 = P0/(R T) mol/m^3.
pub fn g30f_kc(r: i64, t: f64) -> f64 with Mut, Div, Panic {
    let dn = g30f_dn();
    let c0cm = 101325.0 / (8.31446261815324 * t) * 1.0e-6;
    g30f_kp(r, t) * g30f_pow(c0cm, dn[r])
}

// all equilibrium constants at t (Kc depends on T only — precompute per simulation)
pub fn g30f_kc_all(t: f64) -> [f64; 325] with Mut, Div, Panic {
    let nu = g30f_nu();
    let dn = g30f_dn();
    let lo = g30f_nasa_low();
    let hi = g30f_nasa_high();
    let c0cm = 101325.0 / (8.31446261815324 * t) * 1.0e-6;
    var kc: [f64; 325] = [0.0; 325];
    var r: i64 = 0;
    while r < 325 {
        var dg = 0.0;
        var s: i64 = 0;
        while s < 53 { dg = dg + nu[r*53+s] * g30f_g_rt_t(s, t, &lo, &hi); s = s + 1; }
        kc[r] = g30f_exp(0.0 - dg) * g30f_pow(c0cm, dn[r]);
        r = r + 1;
    }
    kc
}

// ---------------- rates ----------------

// effective forward rate constant for reaction r at t with effective
// third-body concentration m_eff (includes [M] factor for three-body and the
// Troe/Lindemann falloff correction; Arrhenius reactions return plain k).
// Single-reaction convenience wrapper (builds tables; NOT for hot loops).
pub fn g30f_kfwd_eff(r: i64, t: f64, m_eff: f64) -> f64 with Mut, Div, Panic {
    let aa = g30f_rxn_a(); let bb = g30f_rxn_b(); let ee = g30f_rxn_ea();
    let ty = g30f_rxn_type();
    let la = g30f_low_a(); let lb = g30f_low_b(); let le = g30f_low_ea();
    let ta = g30f_troe_a(); let t3 = g30f_troe_t3(); let t1 = g30f_troe_t1(); let t2 = g30f_troe_t2();
    let ht = g30f_has_troe();
    var kf = aa[r] * g30f_pow(t, bb[r]) * g30f_exp(0.0 - ee[r] / (1.9872042586408316 * t));
    if ty[r] == 1 { return kf * m_eff }
    if ty[r] == 2 {
        let k0 = la[r] * g30f_pow(t, lb[r]) * g30f_exp(0.0 - le[r] / (1.9872042586408316 * t));
        let pr = k0 * m_eff / kf;
        if pr <= 0.0 { return 0.0 }
        if ht[r] == 1 {
            let fcent = (1.0 - ta[r]) * g30f_exp(0.0 - t / t3[r])
                      + ta[r] * g30f_exp(0.0 - t / t1[r])
                      + g30f_exp(0.0 - t2[r] / t);
            let lfc = g30f_ln(fcent) / 2.302585092994046;
            let cc = 0.0 - 0.4 - 0.67 * lfc;
            let nn = 0.75 - 1.27 * lfc;
            let lpr = g30f_ln(pr) / 2.302585092994046;
            let xx = (lpr + cc) / (nn - 0.14 * (lpr + cc));
            let logf = lfc / (1.0 + xx * xx);
            return kf * (pr / (1.0 + pr)) * g30f_pow(10.0, logf)
        }
        return kf * pr / (1.0 + pr)
    }
    kf
}

pub fn g30f_m_eff(r: i64, c: &[f64; 53]) -> f64 with Mut, Div, Panic {
    let eff = g30f_eff();
    var m = 0.0;
    var s: i64 = 0;
    while s < 53 { m = m + eff[r*53+s] * c[s]; s = s + 1; }
    m
}

// forward and reverse rates for every reaction; table refs passed in so the
// hot paths build the tables once. m_eff is computed only for type != 0.
pub fn g30f_rates_fb_t(t: f64, c: &[f64; 53], kc: &[f64; 325],
                   reac: &[f64; 17225], prod: &[f64; 17225], eff: &[f64; 17225],
                   aa: &[f64; 325], bb: &[f64; 325], ee: &[f64; 325],
                   ty: &[i64; 325], rvf: &[i64; 325],
                   la: &[f64; 325], lb: &[f64; 325], le: &[f64; 325],
                   ta: &[f64; 325], t3: &[f64; 325], t1: &[f64; 325], t2: &[f64; 325],
                   ht: &[i64; 325],
                   fwd: &![f64; 325], rev: &![f64; 325]) with Mut, Div, Panic {
    var r: i64 = 0;
    while r < 325 {
        var kf = aa[r] * g30f_pow(t, bb[r]) * g30f_exp(0.0 - ee[r] / (1.9872042586408316 * t));
        if ty[r] != 0 {
            var me = 0.0;
            var s: i64 = 0;
            while s < 53 { me = me + eff[r*53+s] * c[s]; s = s + 1; }
            if ty[r] == 1 { kf = kf * me; }
            if ty[r] == 2 {
                let k0 = la[r] * g30f_pow(t, lb[r]) * g30f_exp(0.0 - le[r] / (1.9872042586408316 * t));
                let pr = k0 * me / kf;
                if pr <= 0.0 { kf = 0.0; }
                if pr > 0.0 {
                    if ht[r] == 1 {
                        let fcent = (1.0 - ta[r]) * g30f_exp(0.0 - t / t3[r])
                                  + ta[r] * g30f_exp(0.0 - t / t1[r])
                                  + g30f_exp(0.0 - t2[r] / t);
                        let lfc = g30f_ln(fcent) / 2.302585092994046;
                        let cc = 0.0 - 0.4 - 0.67 * lfc;
                        let nn = 0.75 - 1.27 * lfc;
                        let lpr = g30f_ln(pr) / 2.302585092994046;
                        let xx = (lpr + cc) / (nn - 0.14 * (lpr + cc));
                        let logf = lfc / (1.0 + xx * xx);
                        kf = kf * (pr / (1.0 + pr)) * g30f_pow(10.0, logf);
                    }
                    if ht[r] == 0 { kf = kf * pr / (1.0 + pr); }
                }
            }
        }
        var f = kf;
        var s: i64 = 0;
        while s < 53 {
            let o = reac[r*53+s];
            if o == 2.0 { f = f * c[s] * c[s]; }
            if o == 1.0 { f = f * c[s]; }
            s = s + 1;
        }
        var rv = 0.0;
        if rvf[r] == 1 {
            if kc[r] > 0.0 {
                rv = kf / kc[r];
                s = 0;
                while s < 53 {
                    let o = prod[r*53+s];
                    if o == 2.0 { rv = rv * c[s] * c[s]; }
                    if o == 1.0 { rv = rv * c[s]; }
                    s = s + 1;
                }
            }
        }
        fwd[r] = f;
        rev[r] = rv;
        r = r + 1;
    }
}

// Workspace rate offsets: forward 0, reverse 325.
fn g30f_ws_rates(ws: &!G30FWorkspace, t: f64, c_base: i64) with Mut, Div, Panic {
    var r: i64 = 0;
    while r < 325 {
        // The bootstrap compiler needs indexed workspace fields bound before
        // they participate in a chained product; current Madaros accepts both.
        let rxn_a = ws.rxn_a[r];
        let rxn_b = ws.rxn_b[r];
        let rxn_ea = ws.rxn_ea[r];
        let kf_power = g30f_pow(t, rxn_b);
        let kf_exponential = g30f_exp(0.0 - rxn_ea / (1.9872042586408316 * t));
        var kf = rxn_a * kf_power * kf_exponential;
        if ws.rxn_type[r] != 0 {
            var me = 0.0;
            var s: i64 = 0;
            while s < 53 { me = me + ws.eff[r*53+s] * ws.state[c_base+s]; s = s + 1; }
            if ws.rxn_type[r] == 1 { kf = kf * me; }
            if ws.rxn_type[r] == 2 {
                let low_a = ws.low_a[r];
                let low_b = ws.low_b[r];
                let low_ea = ws.low_ea[r];
                let low_power = g30f_pow(t, low_b);
                let low_exponential = g30f_exp(0.0 - low_ea / (1.9872042586408316 * t));
                let k0 = low_a * low_power * low_exponential;
                let pr = k0 * me / kf;
                if pr <= 0.0 { kf = 0.0; }
                if pr > 0.0 {
                    if ws.has_troe[r] == 1 {
                        let fcent = (1.0 - ws.troe_a[r]) * g30f_exp(0.0 - t / ws.troe_t3[r])
                                  + ws.troe_a[r] * g30f_exp(0.0 - t / ws.troe_t1[r])
                                  + g30f_exp(0.0 - ws.troe_t2[r] / t);
                        let lfc = g30f_ln(fcent) / 2.302585092994046;
                        let cc = 0.0 - 0.4 - 0.67 * lfc;
                        let nn = 0.75 - 1.27 * lfc;
                        let lpr = g30f_ln(pr) / 2.302585092994046;
                        let xx = (lpr + cc) / (nn - 0.14 * (lpr + cc));
                        let logf = lfc / (1.0 + xx * xx);
                        kf = kf * (pr / (1.0 + pr)) * g30f_pow(10.0, logf);
                    }
                    if ws.has_troe[r] == 0 { kf = kf * pr / (1.0 + pr); }
                }
            }
        }

        var f = kf;
        var s: i64 = 0;
        while s < 53 {
            let o = ws.reac[r*53+s];
            if o == 2.0 { f = f * ws.state[c_base+s] * ws.state[c_base+s]; }
            if o == 1.0 { f = f * ws.state[c_base+s]; }
            s = s + 1;
        }

        var rv = 0.0;
        if ws.reversible[r] == 1 {
            if ws.kc[r] > 0.0 {
                rv = kf / ws.kc[r];
                s = 0;
                while s < 53 {
                    let o = ws.prod[r*53+s];
                    if o == 2.0 { rv = rv * ws.state[c_base+s] * ws.state[c_base+s]; }
                    if o == 1.0 { rv = rv * ws.state[c_base+s]; }
                    s = s + 1;
                }
            }
        }
        ws.rates[r] = f;
        ws.rates[325+r] = rv;
        r = r + 1;
    }
}

fn g30f_ws_rhs(ws: &!G30FWorkspace, t: f64, c_base: i64, out_base: i64) with Mut, Div, Panic {
    g30f_ws_rates(ws, t, c_base);
    var i: i64 = 0;
    while i < 53 {
        var acc = 0.0;
        var r: i64 = 0;
        while r < 325 {
            acc = acc + ws.nu[r*53+i] * (ws.rates[r] - ws.rates[325+r]);
            r = r + 1;
        }
        ws.state[out_base+i] = acc;
        i = i + 1;
    }
}

// Forward sensitivities: 325 persistent ln(k) columns plus H2/O2 initial
// condition columns. The latter are already scaled by their 1% uncertainties.
// State offsets: Y=0, YT=53, K1=106, K2=159, K3=212, K4=265,
// CP=318, CM=371, DCP=424, DCM=477, U=530.
fn g30f_ws_jacobian(ws: &!G30FWorkspace, t: f64, c_base: i64) with Mut, Div, Panic {
    let eps = 1.0e-12;
    var s: i64 = 0;
    while s < 53 {
        var i: i64 = 0;
        while i < 53 {
            ws.state[318+i] = ws.state[c_base+i];
            ws.state[371+i] = ws.state[c_base+i];
            i = i + 1;
        }
        ws.state[318+s] = ws.state[318+s] + eps;
        ws.state[371+s] = ws.state[371+s] - eps;
        g30f_ws_rhs(ws, t, 318, 424);
        g30f_ws_rhs(ws, t, 371, 477);
        i = 0;
        while i < 53 {
            ws.jac[i*53+s] = (ws.state[424+i] - ws.state[477+i]) / (2.0 * eps);
            i = i + 1;
        }
        s = s + 1;
    }
}

// Sensitivity offsets: SENS=0, SRHS1=17331, SRHS2=34662, SPRED=51993.
fn g30f_ws_sens_rhs(ws: &!G30FWorkspace, t: f64, c_base: i64,
                    sens_base: i64, out_base: i64) with Mut, Div, Panic {
    g30f_ws_jacobian(ws, t, c_base);
    g30f_ws_rates(ws, t, c_base);
    var p: i64 = 0;
    while p < 327 {
        var i: i64 = 0;
        while i < 53 {
            var acc = 0.0;
            var j: i64 = 0;
            while j < 53 {
                acc = acc + ws.jac[i*53+j] * ws.sens[sens_base+j*327+p];
                j = j + 1;
            }
            if p < 325 {
                acc = acc + ws.nu[p*53+i] * (ws.rates[p] - ws.rates[325+p]);
            }
            ws.sens[out_base+i*327+p] = acc;
            i = i + 1;
        }
        p = p + 1;
    }
}

pub fn g30f_dc_kc(t: f64, c: &[f64; 53], kc: &[f64; 325]) -> [f64; 53] with Mut, Div, Panic {
    // Native-v2 requires aggregate locals to have concrete storage. Do not
    // replace this complete literal with an uninitialized `var ws` declaration.
    var ws = G30FWorkspace {
        nasa_low: [0.0; 371], nasa_high: [0.0; 371],
        rxn_a: [0.0; 325], rxn_b: [0.0; 325], rxn_ea: [0.0; 325],
        rxn_type: [0; 325], reversible: [0; 325],
        low_a: [0.0; 325], low_b: [0.0; 325], low_ea: [0.0; 325],
        troe_a: [0.0; 325], troe_t3: [0.0; 325], troe_t1: [0.0; 325], troe_t2: [0.0; 325],
        has_troe: [0; 325],
        reac: [0.0; 17225], prod: [0.0; 17225], nu: [0.0; 17225], eff: [0.0; 17225],
        urel: [0.0; 325], kc: [0.0; 325], rates: [0.0; 650],
        state: [0.0; 583], jac: [0.0; 2809], sens: [0.0; 69324],
    };
    g30f_ws_init(&!ws);
    var i: i64 = 0;
    while i < 325 { ws.kc[i] = kc[i]; i = i + 1; }
    i = 0;
    while i < 53 { ws.state[i] = c[i]; i = i + 1; }
    g30f_ws_rhs(&!ws, t, 0, 106);
    var out: [f64; 53] = [0.0; 53];
    i = 0;
    while i < 53 { out[i] = ws.state[106+i]; i = i + 1; }
    out
}

pub fn g30f_dc(t: f64, c: &[f64; 53]) -> [f64; 53] with Mut, Div, Panic {
    let kc = g30f_kc_all(t);
    g30f_dc_kc(t, c, &kc)
}

// ---------------- deterministic simulator (RK4, isothermal) ----------------

pub fn simulate_gri30_full(init: &[f64; 53], t_k: f64, dt: f64, steps: i64) -> [f64; 53] with Mut, Div, Panic {
    var ws = G30FWorkspace {
        nasa_low: [0.0; 371], nasa_high: [0.0; 371],
        rxn_a: [0.0; 325], rxn_b: [0.0; 325], rxn_ea: [0.0; 325],
        rxn_type: [0; 325], reversible: [0; 325],
        low_a: [0.0; 325], low_b: [0.0; 325], low_ea: [0.0; 325],
        troe_a: [0.0; 325], troe_t3: [0.0; 325], troe_t1: [0.0; 325], troe_t2: [0.0; 325],
        has_troe: [0; 325],
        reac: [0.0; 17225], prod: [0.0; 17225], nu: [0.0; 17225], eff: [0.0; 17225],
        urel: [0.0; 325], kc: [0.0; 325], rates: [0.0; 650],
        state: [0.0; 583], jac: [0.0; 2809], sens: [0.0; 69324],
    };
    g30f_ws_init(&!ws);
    g30f_ws_fill_kc(&!ws, t_k);
    var i: i64 = 0;
    while i < 53 { ws.state[i] = init[i]; i = i + 1; }
    var s: i64 = 0;
    while s < steps {
        g30f_ws_rhs(&!ws, t_k, 0, 106);
        i = 0;
        while i < 53 { ws.state[53+i] = ws.state[i] + 0.5 * dt * ws.state[106+i]; i = i + 1; }
        g30f_ws_rhs(&!ws, t_k, 53, 159);
        i = 0;
        while i < 53 { ws.state[53+i] = ws.state[i] + 0.5 * dt * ws.state[159+i]; i = i + 1; }
        g30f_ws_rhs(&!ws, t_k, 53, 212);
        i = 0;
        while i < 53 { ws.state[53+i] = ws.state[i] + dt * ws.state[212+i]; i = i + 1; }
        g30f_ws_rhs(&!ws, t_k, 53, 265);
        i = 0;
        while i < 53 {
            ws.state[i] = ws.state[i] + (dt / 6.0) * (ws.state[106+i] + 2.0 * ws.state[159+i]
                         + 2.0 * ws.state[212+i] + ws.state[265+i]);
            i = i + 1;
        }
        s = s + 1;
    }
    var out: [f64; 53] = [0.0; 53];
    i = 0;
    while i < 53 { out[i] = ws.state[i]; i = i + 1; }
    out
}

// ---------------- epistemic layer (forward sensitivity GUM) ----------------

pub fn simulate_gri30_full_epistemic(init: &[f64; 53], inits: &[f64; 53], t_k: f64, dt: f64, steps: i64) -> ([f64; 53], [f64; 53]) with Mut, Div, Panic {
    var ws = G30FWorkspace {
        nasa_low: [0.0; 371], nasa_high: [0.0; 371],
        rxn_a: [0.0; 325], rxn_b: [0.0; 325], rxn_ea: [0.0; 325],
        rxn_type: [0; 325], reversible: [0; 325],
        low_a: [0.0; 325], low_b: [0.0; 325], low_ea: [0.0; 325],
        troe_a: [0.0; 325], troe_t3: [0.0; 325], troe_t1: [0.0; 325], troe_t2: [0.0; 325],
        has_troe: [0; 325],
        reac: [0.0; 17225], prod: [0.0; 17225], nu: [0.0; 17225], eff: [0.0; 17225],
        urel: [0.0; 325], kc: [0.0; 325], rates: [0.0; 650],
        state: [0.0; 583], jac: [0.0; 2809], sens: [0.0; 69324],
    };
    g30f_ws_init(&!ws);
    g30f_ws_fill_kc(&!ws, t_k);
    var i: i64 = 0;
    while i < 53 { ws.state[i] = init[i]; i = i + 1; }
    ws.sens[0*327+325] = inits[0];
    ws.sens[3*327+326] = inits[3];

    var s: i64 = 0;
    while s < steps {
        g30f_ws_sens_rhs(&!ws, t_k, 0, 0, 17331);
        g30f_ws_rhs(&!ws, t_k, 0, 106);
        i = 0;
        while i < 53 { ws.state[53+i] = ws.state[i] + 0.5 * dt * ws.state[106+i]; i = i + 1; }
        g30f_ws_rhs(&!ws, t_k, 53, 159);
        i = 0;
        while i < 53 { ws.state[53+i] = ws.state[i] + 0.5 * dt * ws.state[159+i]; i = i + 1; }
        g30f_ws_rhs(&!ws, t_k, 53, 212);
        i = 0;
        while i < 53 { ws.state[53+i] = ws.state[i] + dt * ws.state[212+i]; i = i + 1; }
        g30f_ws_rhs(&!ws, t_k, 53, 265);
        i = 0;
        while i < 53 {
            ws.state[i] = ws.state[i] + (dt / 6.0) * (ws.state[106+i] + 2.0 * ws.state[159+i]
                         + 2.0 * ws.state[212+i] + ws.state[265+i]);
            i = i + 1;
        }
        i = 0;
        while i < 17331 {
            ws.sens[51993+i] = ws.sens[i] + dt * ws.sens[17331+i];
            i = i + 1;
        }
        g30f_ws_sens_rhs(&!ws, t_k, 0, 51993, 34662);
        i = 0;
        while i < 17331 {
            ws.sens[i] = ws.sens[i] + 0.5 * dt * (ws.sens[17331+i] + ws.sens[34662+i]);
            i = i + 1;
        }
        s = s + 1;
    }

    i = 0;
    while i < 53 {
        var v = ws.sens[i*327+325] * ws.sens[i*327+325]
              + ws.sens[i*327+326] * ws.sens[i*327+326];
        var r: i64 = 0;
        while r < 325 {
            let z = ws.sens[i*327+r] * ws.urel[r];
            v = v + z * z;
            r = r + 1;
        }
        ws.state[530+i] = g30f_sqrt(v);
        i = i + 1;
    }

    var y: [f64; 53] = [0.0; 53];
    var u: [f64; 53] = [0.0; 53];
    i = 0;
    while i < 53 { y[i] = ws.state[i]; u[i] = ws.state[530+i]; i = i + 1; }
    (y, u)
}


// ---------------- tests ----------------

fn g30f_check_near(a: f64, b: f64, tol: f64) -> bool { g30f_abs(a - b) < tol }
fn g30f_check_rel(a: f64, b: f64, rel: f64) -> bool { g30f_abs(a - b) < rel * g30f_abs(b) }

pub fn test_g30f_stoich_tables() -> bool with Mut, Panic {
    let reac = g30f_reac();
    let prod = g30f_prod();
    let nu = g30f_nu();
    let eff = g30f_eff();
    var reac_nonzero: i64 = 0;
    var prod_nonzero: i64 = 0;
    var nu_nonzero: i64 = 0;
    var eff_nondefault: i64 = 0;
    var i: i64 = 0;
    while i < 17225 {
        if reac[i] != 0.0 { reac_nonzero = reac_nonzero + 1; }
        if prod[i] != 0.0 { prod_nonzero = prod_nonzero + 1; }
        if nu[i] != 0.0 { nu_nonzero = nu_nonzero + 1; }
        if eff[i] != 1.0 { eff_nondefault = eff_nondefault + 1; }
        if nu[i] != prod[i] - reac[i] { return false }
        i = i + 1;
    }
    reac_nonzero == 634 && prod_nonzero == 627 && nu_nonzero == 1227 && eff_nondefault == 117
}

pub fn test_g30f_rates() -> bool with Mut, Div, Panic {
    // Python cross-check at T=1200K, [M]=1/(82.057*1200) mol/cm^3, air-like bath
    // (N2 idx 47 at 0.79[M], O2 idx 3 at 0.21[M]):
    //   k002(O+H2)=5.7733e11, k037(H+O2)=1.7968e11, k097(OH+CH4)=2.2828e12,
    //   k000(2O+M, three-body, air m_eff)=1.0156e9,
    //   k157(2CH3(+M), Troe, air m_eff)=5.2826e12,
    //   k011(O+CO(+M), Lindemann F=1, air m_eff)=2.3160e9
    // (k032 H+O2+M<=HO2+M is exactly 0 in an air bath: GRI-Mech gives N2/O2
    // zero efficiency on the generic-M reaction and carries them as separate
    // specific-collider reactions 34-36)
    let t = 1200.0;
    let m = 101325.0 / (8.31446261815324 * t) * 1.0e-6;
    var c_air: [f64; 53] = [0.0; 53];
    c_air[47] = m * 0.79;
    c_air[3] = m * 0.21;
    let m_troe = g30f_m_eff(157 as i64, &c_air);
    let m_lind = g30f_m_eff(11 as i64, &c_air);
    let m_o2m = g30f_m_eff(0 as i64, &c_air);
    g30f_check_near(g30f_kfwd_eff(2 as i64, t, m), 5.773264e11, 1.1546528e10) &&
    g30f_check_near(g30f_kfwd_eff(37 as i64, t, m), 1.796847e11, 3.593694e09) &&
    g30f_check_near(g30f_kfwd_eff(97 as i64, t, m), 2.28282e12, 4.56564e10) &&
    g30f_check_near(g30f_kfwd_eff(0 as i64, t, m_o2m), 1.015554e09, 2.031108e07) &&
    g30f_check_near(g30f_kfwd_eff(157 as i64, t, m_troe), 5.2826e12, 1.05652e11) &&
    g30f_check_near(g30f_kfwd_eff(11 as i64, t, m_lind), 2.315984e09, 4.631968e07)
}

pub fn test_g30f_thermo() -> bool with Mut, Div, Panic {
    // NASA7 equilibrium constants at T=1200K (Python replica):
    //   kc037(H+O2<=>O+OH)=1.575e-2, kc097(OH+CH4)=2.387e3,
    //   kc042(H+OH+M<=>H2O+M)=3.208e20
    let t = 1200.0;
    g30f_check_near(g30f_kc(37 as i64, t), 1.57492e-02, 3.14984e-04) &&
    g30f_check_near(g30f_kc(97 as i64, t), 2.38747e03, 4.77494e01) &&
    g30f_check_near(g30f_kc(42 as i64, t), 3.20783e20, 6.41566e18)
}

fn g30f_demo_init(t: f64) -> [f64; 53] with Mut, Div, Panic {
    // 2% H2 / 1% O2 / 97% N2 at 1 atm, H-atom seed 1e-11 (chain initiation)
    let m = 101325.0 / (8.31446261815324 * t) * 1.0e-6;
    var c0: [f64; 53] = [0.0; 53];
    c0[0] = m * 0.02;
    c0[3] = m * 0.01;
    c0[47] = m * 0.97;
    c0[1] = 1.0e-11;
    c0
}

pub fn test_g30f_sim() -> bool with Mut, Div, Panic {
    // Cantera 3.2.0 / gri30.yaml reference: IdealGasReactor, energy="off",
    // constant density, T=1500 K, 2% H2 / 1% O2 / 97% N2 at 1 atm,
    // [H]=1e-11 mol/cm3, rtol=1e-12, atol=1e-22, advanced to t=4e-6 s.
    // H2O2 gets 1e-2 relative tolerance; all other species get 1e-4.
    // (dt=2e-9, not the H/O module's 1e-8: NNH<=>N2+H has k=3.3e8/s at 1500K,
    // k*dt>4 at dt=1e-8 is explicitly unstable and the trajectory diverges;
    // dt=2e-9 matches dt=1e-9/5e-10 to every printed digit. Cross-check vs the
    // 29-reaction H/O sub-mechanism Python replica at the same t: H2 agrees to
    // 7 digits, H2O drifts 0.16% — N-chemistry negligible pre-front, as expected)
    let t = 1500.0;
    let c0 = g30f_demo_init(t);
    let y = simulate_gri30_full(&c0, t, 2.0e-9, 2000 as i64);
    g30f_check_rel(y[0], 1.624850347163e-7, 1.0e-4) &&
    g30f_check_rel(y[1], 1.055303917243e-11, 1.0e-4) &&
    g30f_check_rel(y[2], 1.242991359322e-12, 1.0e-4) &&
    g30f_check_rel(y[3], 8.124167024858e-8, 1.0e-4) &&
    g30f_check_rel(y[4], 1.093673297574e-12, 1.0e-4) &&
    g30f_check_rel(y[5], 1.833104446868e-12, 1.0e-4) &&
    g30f_check_rel(y[6], 1.204922532044e-13, 1.0e-4) &&
    g30f_check_rel(y[7], 2.043756391817e-16, 1.0e-2) &&
    g30f_check_rel(y[34], 1.576746e-17, 1.0e-5)
}

pub fn test_g30f_epistemic_smoke() -> bool with Mut, Div, Panic {
    // Cantera 3.2.0 / gri30.yaml coherent-sensitivity reference at t=4e-7 s:
    // IdealGasReactor, energy="off", constant density, T=1500 K, exact Sounio
    // initial concentrations, rtol=1e-12, atol=1e-22. The 325 ln(m_r) columns
    // use exp(+-1e-3) central differences; initial H2/O2 columns carry 1%.
    // Regenerate with benchmarks/chemistry/gri30_full_cantera_uq_reference.py.
    // All sigma values use 1e-4 relative tolerance.
    let t = 1500.0;
    let c0 = g30f_demo_init(t);
    var u0: [f64; 53] = [0.0; 53];
    u0[0] = 0.01 * c0[0];
    u0[3] = 0.01 * c0[3];
    let (y, u) = simulate_gri30_full_epistemic(&c0, &u0, t, 2.0e-9, 200 as i64);
    g30f_check_rel(y[0], 1.624886332731066e-7, 1.0e-4) &&
    g30f_check_rel(u[0], 1.624886621846326e-9, 1.0e-4) &&
    g30f_check_rel(u[1], 1.728153747753403e-14, 1.0e-4) &&
    g30f_check_rel(u[2], 1.962035152319852e-14, 1.0e-4) &&
    g30f_check_rel(u[3], 8.124413369241644e-10, 1.0e-4) &&
    g30f_check_rel(u[4], 1.935251605949693e-14, 1.0e-4) &&
    g30f_check_rel(u[5], 3.727791931739965e-15, 1.0e-4) &&
    g30f_check_rel(u[6], 2.605446150229169e-15, 1.0e-4) &&
    g30f_check_rel(u[7], 9.167378486142805e-19, 1.0e-4)
}

// Named entrypoint avoids colliding with a test harness main when imported.
pub fn g30f_module_main() -> i32 with Mut, Div, Panic, IO {
    var f: i32 = 0;
    if test_g30f_stoich_tables() { println("PASS g30f stoich tables") } else { f = f + 1; println("FAIL g30f stoich tables") }
    if test_g30f_rates() { println("PASS g30f rates") } else { f = f + 1; println("FAIL g30f rates") }
    if test_g30f_thermo() { println("PASS g30f thermo") } else { f = f + 1; println("FAIL g30f thermo") }
    if test_g30f_sim() { println("PASS g30f sim") } else { f = f + 1; println("FAIL g30f sim") }
    if test_g30f_epistemic_smoke() { println("PASS g30f epistemic smoke") } else { f = f + 1; println("FAIL g30f epistemic smoke") }
    if f == 0 { println("GRI30_FULL 53-SPECIES 325-REACTION MECHANISM + NASA THERMO + EPISTEMIC UQ PASS") } else { println("GRI30_FULL FAIL") }
    f
}
