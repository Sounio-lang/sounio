// ---------------- thermochemistry (NASA7) ----------------

// standard Gibbs free energy G0/(R T) for species sp at temperature t
// (table refs passed in: hot paths build the NASA tables once)
fn g30f_g_rt_t(sp: i64, t: f64, lo: &[f64; 371], hi: &[f64; 371]) -> f64 with Mut, Div, Panic {
    let base = if t <= 1000.0 { sp * 7 } else { 10000 + sp * 7 };  // 10000 marks high set
    var a0 = 0.0; var a1 = 0.0; var a2 = 0.0; var a3 = 0.0; var a4 = 0.0; var a5 = 0.0; var a6 = 0.0;
    if base >= 10000 {
        let bb = base - 10000;
        a0 = hi[bb]; a1 = hi[bb+1]; a2 = hi[bb+2]; a3 = hi[bb+3]; a4 = hi[bb+4]; a5 = hi[bb+5]; a6 = hi[bb+6];
    } else {
        a0 = lo[base]; a1 = lo[base+1]; a2 = lo[base+2]; a3 = lo[base+3]; a4 = lo[base+4]; a5 = lo[base+5]; a6 = lo[base+6];
    }
    let h_rt = a0 + a1*t/2.0 + a2*t*t/3.0 + a3*t*t*t/4.0 + a4*t*t*t*t/5.0 + a5/t;
    let s_r = a0*g30f_ln(t) + a1*t + a2*t*t/2.0 + a3*t*t*t/3.0 + a4*t*t*t*t/4.0 + a6;
    h_rt - s_r
}

// Kp (dimensionless, standard state 1e5 Pa) for reaction r at t
pub fn g30f_kp(r: i64, t: f64) -> f64 with Mut, Div, Panic {
    let nu = g30f_nu();
    let lo = g30f_nasa_low();
    let hi = g30f_nasa_high();
    var dg = 0.0;
    var s: i64 = 0;
    while s < 53 { dg = dg + nu[r*53+s] * g30f_g_rt_t(s, t, &lo, &hi); s = s + 1; }
    g30f_exp(0.0 - dg)
}

// Kc in (mol/cm^3)^dn units: CHEMKIN/GRI standard state is 1 atm.
// Kc = Kp * (c0 * 1e-6)^dn, c0 = P0/(R T) mol/m^3.
pub fn g30f_kc(r: i64, t: f64) -> f64 with Mut, Div, Panic {
    let dn = g30f_dn();
    let c0cm = 101325.0 / (8.314462618 * t) * 1.0e-6;
    g30f_kp(r, t) * g30f_pow(c0cm, dn[r])
}

// all equilibrium constants at t (Kc depends on T only — precompute per simulation)
pub fn g30f_kc_all(t: f64) -> [f64; 325] with Mut, Div, Panic {
    let nu = g30f_nu();
    let dn = g30f_dn();
    let lo = g30f_nasa_low();
    let hi = g30f_nasa_high();
    let c0cm = 101325.0 / (8.314462618 * t) * 1.0e-6;
    var kc: [f64; 325] = [0.0; 325];
    var r: i64 = 0;
    while r < 325 {
        var dg = 0.0;
        var s: i64 = 0;
        while s < 53 { dg = dg + nu[r*53+s] * g30f_g_rt_t(s, t, &lo, &hi); s = s + 1; }
        kc[r] = g30f_exp(0.0 - dg) * g30f_pow(c0cm, dn[r]);
        r = r + 1;
    }
    kc
}

// ---------------- rates ----------------

// effective forward rate constant for reaction r at t with effective
// third-body concentration m_eff (includes [M] factor for three-body and the
// Troe/Lindemann falloff correction; Arrhenius reactions return plain k).
// Single-reaction convenience wrapper (builds tables; NOT for hot loops).
pub fn g30f_kfwd_eff(r: i64, t: f64, m_eff: f64) -> f64 with Mut, Div, Panic {
    let aa = g30f_rxn_a(); let bb = g30f_rxn_b(); let ee = g30f_rxn_ea();
    let ty = g30f_rxn_type();
    let la = g30f_low_a(); let lb = g30f_low_b(); let le = g30f_low_ea();
    let ta = g30f_troe_a(); let t3 = g30f_troe_t3(); let t1 = g30f_troe_t1(); let t2 = g30f_troe_t2();
    let ht = g30f_has_troe();
    var kf = aa[r] * g30f_pow(t, bb[r]) * g30f_exp(0.0 - ee[r] / (1.9872041 * t));
    if ty[r] == 1 { return kf * m_eff }
    if ty[r] == 2 {
        let k0 = la[r] * g30f_pow(t, lb[r]) * g30f_exp(0.0 - le[r] / (1.9872041 * t));
        let pr = k0 * m_eff / kf;
        if pr <= 0.0 { return 0.0 }
        if ht[r] == 1 {
            let fcent = (1.0 - ta[r]) * g30f_exp(0.0 - t / t3[r])
                      + ta[r] * g30f_exp(0.0 - t / t1[r])
                      + g30f_exp(0.0 - t2[r] / t);
            let lfc = g30f_ln(fcent) / 2.302585092994046;
            let cc = 0.0 - 0.4 - 0.67 * lfc;
            let nn = 0.75 - 1.27 * lfc;
            let lpr = g30f_ln(pr) / 2.302585092994046;
            let xx = (lpr + cc) / (nn - 0.14 * (lpr + cc));
            let logf = lfc / (1.0 + xx * xx);
            return kf * (pr / (1.0 + pr)) * g30f_pow(10.0, logf)
        }
        return kf * pr / (1.0 + pr)
    }
    kf
}

pub fn g30f_m_eff(r: i64, c: &[f64; 53]) -> f64 with Mut, Div, Panic {
    let eff = g30f_eff();
    var m = 0.0;
    var s: i64 = 0;
    while s < 53 { m = m + eff[r*53+s] * c[s]; s = s + 1; }
    m
}

// forward and reverse rates for every reaction; table refs passed in so the
// hot paths build the tables once. m_eff is computed only for type != 0.
pub fn g30f_rates_fb_t(t: f64, c: &[f64; 53], kc: &[f64; 325],
                   reac: &[f64; 17225], prod: &[f64; 17225], eff: &[f64; 17225],
                   aa: &[f64; 325], bb: &[f64; 325], ee: &[f64; 325],
                   ty: &[i64; 325], rvf: &[i64; 325],
                   la: &[f64; 325], lb: &[f64; 325], le: &[f64; 325],
                   ta: &[f64; 325], t3: &[f64; 325], t1: &[f64; 325], t2: &[f64; 325],
                   ht: &[i64; 325],
                   fwd: &![f64; 325], rev: &![f64; 325]) with Mut, Div, Panic {
    var r: i64 = 0;
    while r < 325 {
        var kf = aa[r] * g30f_pow(t, bb[r]) * g30f_exp(0.0 - ee[r] / (1.9872041 * t));
        if ty[r] != 0 {
            var me = 0.0;
            var s: i64 = 0;
            while s < 53 { me = me + eff[r*53+s] * c[s]; s = s + 1; }
            if ty[r] == 1 { kf = kf * me; }
            if ty[r] == 2 {
                let k0 = la[r] * g30f_pow(t, lb[r]) * g30f_exp(0.0 - le[r] / (1.9872041 * t));
                let pr = k0 * me / kf;
                if pr <= 0.0 { kf = 0.0; }
                if pr > 0.0 {
                    if ht[r] == 1 {
                        let fcent = (1.0 - ta[r]) * g30f_exp(0.0 - t / t3[r])
                                  + ta[r] * g30f_exp(0.0 - t / t1[r])
                                  + g30f_exp(0.0 - t2[r] / t);
                        let lfc = g30f_ln(fcent) / 2.302585092994046;
                        let cc = 0.0 - 0.4 - 0.67 * lfc;
                        let nn = 0.75 - 1.27 * lfc;
                        let lpr = g30f_ln(pr) / 2.302585092994046;
                        let xx = (lpr + cc) / (nn - 0.14 * (lpr + cc));
                        let logf = lfc / (1.0 + xx * xx);
                        kf = kf * (pr / (1.0 + pr)) * g30f_pow(10.0, logf);
                    }
                    if ht[r] == 0 { kf = kf * pr / (1.0 + pr); }
                }
            }
        }
        var f = kf;
        var s: i64 = 0;
        while s < 53 {
            let o = reac[r*53+s];
            if o == 2.0 { f = f * c[s] * c[s]; }
            if o == 1.0 { f = f * c[s]; }
            s = s + 1;
        }
        var rv = 0.0;
        if rvf[r] == 1 {
            if kc[r] > 0.0 {
                rv = kf / kc[r];
                s = 0;
                while s < 53 {
                    let o = prod[r*53+s];
                    if o == 2.0 { rv = rv * c[s] * c[s]; }
                    if o == 1.0 { rv = rv * c[s]; }
                    s = s + 1;
                }
            }
        }
        fwd[r] = f;
        rev[r] = rv;
        r = r + 1;
    }
}

// dc_i/dt with precomputed Kc table and precomputed data tables
fn g30f_dc_t(t: f64, c: &[f64; 53], kc: &[f64; 325],
             reac: &[f64; 17225], prod: &[f64; 17225], nu: &[f64; 17225], eff: &[f64; 17225],
             aa: &[f64; 325], bb: &[f64; 325], ee: &[f64; 325],
             ty: &[i64; 325], rvf: &[i64; 325],
             la: &[f64; 325], lb: &[f64; 325], le: &[f64; 325],
             ta: &[f64; 325], t3: &[f64; 325], t1: &[f64; 325], t2: &[f64; 325],
             ht: &[i64; 325]) -> [f64; 53] with Mut, Div, Panic {
    var fwd: [f64; 325] = [0.0; 325];
    var rev: [f64; 325] = [0.0; 325];
    g30f_rates_fb_t(t, c, kc, reac, prod, eff, aa, bb, ee, ty, rvf, la, lb, le, ta, t3, t1, t2, ht, &!fwd, &!rev);
    var dc: [f64; 53] = [0.0; 53];
    var i: i64 = 0;
    while i < 53 {
        var acc = 0.0;
        var r: i64 = 0;
        while r < 325 { acc = acc + nu[r*53+i] * (fwd[r] - rev[r]); r = r + 1; }
        dc[i] = acc;
        i = i + 1;
    }
    dc
}

// dc_i/dt with precomputed Kc table (convenience: rebuilds data tables per call)
pub fn g30f_dc_kc(t: f64, c: &[f64; 53], kc: &[f64; 325]) -> [f64; 53] with Mut, Div, Panic {
    let reac = g30f_reac(); let prod = g30f_prod(); let nu = g30f_nu(); let eff = g30f_eff();
    let aa = g30f_rxn_a(); let bb = g30f_rxn_b(); let ee = g30f_rxn_ea();
    let ty = g30f_rxn_type(); let rvf = g30f_reversible();
    let la = g30f_low_a(); let lb = g30f_low_b(); let le = g30f_low_ea();
    let ta = g30f_troe_a(); let t3 = g30f_troe_t3(); let t1 = g30f_troe_t1(); let t2 = g30f_troe_t2();
    let ht = g30f_has_troe();
    g30f_dc_t(t, c, kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht)
}

// dc_i/dt for the full mechanism (convenience: recomputes Kc each call)
pub fn g30f_dc(t: f64, c: &[f64; 53]) -> [f64; 53] with Mut, Div, Panic {
    let kc = g30f_kc_all(t);
    g30f_dc_kc(t, c, &kc)
}

// ---------------- deterministic simulator (RK4, isothermal) ----------------

pub fn simulate_gri30_full(init: &[f64; 53], t_k: f64, dt: f64, steps: i64) -> [f64; 53] with Mut, Div, Panic {
    let kc = g30f_kc_all(t_k);
    let reac = g30f_reac(); let prod = g30f_prod(); let nu = g30f_nu(); let eff = g30f_eff();
    let aa = g30f_rxn_a(); let bb = g30f_rxn_b(); let ee = g30f_rxn_ea();
    let ty = g30f_rxn_type(); let rvf = g30f_reversible();
    let la = g30f_low_a(); let lb = g30f_low_b(); let le = g30f_low_ea();
    let ta = g30f_troe_a(); let t3 = g30f_troe_t3(); let t1 = g30f_troe_t1(); let t2 = g30f_troe_t2();
    let ht = g30f_has_troe();
    var y: [f64; 53] = [0.0; 53];
    var i: i64 = 0;
    while i < 53 { y[i] = init[i]; i = i + 1; }
    var yt: [f64; 53] = [0.0; 53];
    var s: i64 = 0;
    while s < steps {
        let k1 = g30f_dc_t(t_k, &y, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { yt[i] = y[i] + 0.5 * dt * k1[i]; i = i + 1; }
        let k2 = g30f_dc_t(t_k, &yt, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { yt[i] = y[i] + 0.5 * dt * k2[i]; i = i + 1; }
        let k3 = g30f_dc_t(t_k, &yt, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { yt[i] = y[i] + dt * k3[i]; i = i + 1; }
        let k4 = g30f_dc_t(t_k, &yt, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { y[i] = y[i] + (dt / 6.0) * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]); i = i + 1; }
        s = s + 1;
    }
    y
}

// ---------------- epistemic layer (GUM delta method on rate uncertainties) ----------------

fn g30f_jacobian_t(t: f64, c: &[f64; 53], kc: &[f64; 325],
                   reac: &[f64; 17225], prod: &[f64; 17225], nu: &[f64; 17225], eff: &[f64; 17225],
                   aa: &[f64; 325], bb: &[f64; 325], ee: &[f64; 325],
                   ty: &[i64; 325], rvf: &[i64; 325],
                   la: &[f64; 325], lb: &[f64; 325], le: &[f64; 325],
                   ta: &[f64; 325], t3: &[f64; 325], t1: &[f64; 325], t2: &[f64; 325],
                   ht: &[i64; 325],
                   eps: f64, jac: &![f64; 2809]) with Mut, Div, Panic {
    var s: i64 = 0;
    while s < 53 {
        var cp: [f64; 53] = [0.0; 53];
        var cm: [f64; 53] = [0.0; 53];
        var i: i64 = 0;
        while i < 53 { cp[i] = c[i]; cm[i] = c[i]; i = i + 1; }
        cp[s] = cp[s] + eps;
        cm[s] = cm[s] - eps;
        let dcp = g30f_dc_t(t, &cp, kc, reac, prod, nu, eff, aa, bb, ee, ty, rvf, la, lb, le, ta, t3, t1, t2, ht);
        let dcm = g30f_dc_t(t, &cm, kc, reac, prod, nu, eff, aa, bb, ee, ty, rvf, la, lb, le, ta, t3, t1, t2, ht);
        i = 0;
        while i < 53 {
            jac[i*53+s] = (dcp[i] - dcm[i]) / (2.0 * eps);
            i = i + 1;
        }
        s = s + 1;
    }
}

// Forward sensitivities: 325 persistent ln(k) columns plus H2/O2 initial
// condition columns. The latter are already scaled by their 1% uncertainties.
fn g30f_sens_rhs_t(t: f64, c: &[f64; 53], kc: &[f64; 325], sens: &[f64; 17331],
                   reac: &[f64; 17225], prod: &[f64; 17225], nu: &[f64; 17225], eff: &[f64; 17225],
                   aa: &[f64; 325], bb: &[f64; 325], ee: &[f64; 325],
                   ty: &[i64; 325], rvf: &[i64; 325],
                   la: &[f64; 325], lb: &[f64; 325], le: &[f64; 325],
                   ta: &[f64; 325], t3: &[f64; 325], t1: &[f64; 325], t2: &[f64; 325],
                   ht: &[i64; 325]) -> [f64; 17331] with Mut, Div, Panic {
    var jac: [f64; 2809] = [0.0; 2809];
    g30f_jacobian_t(t, c, kc, reac, prod, nu, eff, aa, bb, ee, ty, rvf, la, lb, le, ta, t3, t1, t2, ht, 1.0e-12, &!jac);
    var fwd: [f64; 325] = [0.0; 325];
    var rev: [f64; 325] = [0.0; 325];
    g30f_rates_fb_t(t, c, kc, reac, prod, eff, aa, bb, ee, ty, rvf, la, lb, le, ta, t3, t1, t2, ht, &!fwd, &!rev);
    var out: [f64; 17331] = [0.0; 17331];
    var p: i64 = 0;
    while p < 327 {
        var i: i64 = 0;
        while i < 53 {
            var acc = 0.0;
            var j: i64 = 0;
            while j < 53 { acc = acc + jac[i*53+j] * sens[j*327+p]; j = j + 1; }
            if p < 325 { acc = acc + nu[p*53+i] * (fwd[p] - rev[p]); }
            out[i*327+p] = acc;
            i = i + 1;
        }
        p = p + 1;
    }
    out
}

// epistemic simulation: values + 1-sigma uncertainties per species
pub fn simulate_gri30_full_epistemic(init: &[f64; 53], inits: &[f64; 53], t_k: f64, dt: f64, steps: i64) -> ([f64; 53], [f64; 53]) with Mut, Div, Panic {
    let kc = g30f_kc_all(t_k);
    let reac = g30f_reac(); let prod = g30f_prod(); let nu = g30f_nu(); let eff = g30f_eff();
    let aa = g30f_rxn_a(); let bb = g30f_rxn_b(); let ee = g30f_rxn_ea();
    let ty = g30f_rxn_type(); let rvf = g30f_reversible();
    let la = g30f_low_a(); let lb = g30f_low_b(); let le = g30f_low_ea();
    let ta = g30f_troe_a(); let t3 = g30f_troe_t3(); let t1 = g30f_troe_t1(); let t2 = g30f_troe_t2();
    let ht = g30f_has_troe();
    let urel = g30f_urel();
    var y: [f64; 53] = [0.0; 53];
    var i: i64 = 0;
    while i < 53 { y[i] = init[i]; i = i + 1; }
    var sens: [f64; 17331] = [0.0; 17331];
    sens[0*327+325] = inits[0];
    sens[3*327+326] = inits[3];
    var yt: [f64; 53] = [0.0; 53];
    var srhs1: [f64; 17331] = [0.0; 17331];
    var srhs2: [f64; 17331] = [0.0; 17331];
    var spred: [f64; 17331] = [0.0; 17331];
    var s: i64 = 0;
    while s < steps {
        srhs1 = g30f_sens_rhs_t(t_k, &y, &kc, &sens, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        let k1 = g30f_dc_t(t_k, &y, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { yt[i] = y[i] + 0.5 * dt * k1[i]; i = i + 1; }
        let k2 = g30f_dc_t(t_k, &yt, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { yt[i] = y[i] + 0.5 * dt * k2[i]; i = i + 1; }
        let k3 = g30f_dc_t(t_k, &yt, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { yt[i] = y[i] + dt * k3[i]; i = i + 1; }
        let k4 = g30f_dc_t(t_k, &yt, &kc, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0;
        while i < 53 { y[i] = y[i] + (dt / 6.0) * (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]); i = i + 1; }
        i = 0; while i < 17331 { spred[i] = sens[i] + dt * srhs1[i]; i = i + 1; }
        srhs2 = g30f_sens_rhs_t(t_k, &y, &kc, &spred, &reac, &prod, &nu, &eff, &aa, &bb, &ee, &ty, &rvf, &la, &lb, &le, &ta, &t3, &t1, &t2, &ht);
        i = 0; while i < 17331 { sens[i] = sens[i] + 0.5 * dt * (srhs1[i] + srhs2[i]); i = i + 1; }
        s = s + 1;
    }
    var u: [f64; 53] = [0.0; 53];
    i = 0;
    while i < 53 {
        var v = sens[i*327+325] * sens[i*327+325] + sens[i*327+326] * sens[i*327+326];
        var r: i64 = 0;
        while r < 325 { let z = sens[i*327+r] * urel[r]; v = v + z * z; r = r + 1; }
        u[i] = g30f_sqrt(v);
        i = i + 1;
    }
    (y, u)
}


// ---------------- tests (all expectations from the independent Python replica) ----------------

fn g30f_check_near(a: f64, b: f64, tol: f64) -> bool { g30f_abs(a - b) < tol }
fn g30f_check_rel(a: f64, b: f64, rel: f64) -> bool { g30f_abs(a - b) < rel * g30f_abs(b) }

pub fn test_g30f_rates() -> bool with Mut, Div, Panic {
    // Python cross-check at T=1200K, [M]=1/(82.057*1200) mol/cm^3, air-like bath
    // (N2 idx 47 at 0.79[M], O2 idx 3 at 0.21[M]):
    //   k002(O+H2)=5.7733e11, k037(H+O2)=1.7968e11, k097(OH+CH4)=2.2828e12,
    //   k000(2O+M, three-body, air m_eff)=1.0156e9,
    //   k157(2CH3(+M), Troe, air m_eff)=5.2826e12,
    //   k011(O+CO(+M), Lindemann F=1, air m_eff)=2.3160e9
    // (k032 H+O2+M<=HO2+M is exactly 0 in an air bath: GRI-Mech gives N2/O2
    // zero efficiency on the generic-M reaction and carries them as separate
    // specific-collider reactions 34-36)
    let t = 1200.0;
    let m = 1.0 / (82.057 * t);
    var c_air: [f64; 53] = [0.0; 53];
    c_air[47] = m * 0.79;
    c_air[3] = m * 0.21;
    let m_troe = g30f_m_eff(157 as i64, &c_air);
    let m_lind = g30f_m_eff(11 as i64, &c_air);
    let m_o2m = g30f_m_eff(0 as i64, &c_air);
    g30f_check_near(g30f_kfwd_eff(2 as i64, t, m), 5.773264e11, 1.1546528e10) &&
    g30f_check_near(g30f_kfwd_eff(37 as i64, t, m), 1.796847e11, 3.593694e09) &&
    g30f_check_near(g30f_kfwd_eff(97 as i64, t, m), 2.28282e12, 4.56564e10) &&
    g30f_check_near(g30f_kfwd_eff(0 as i64, t, m_o2m), 1.015554e09, 2.031108e07) &&
    g30f_check_near(g30f_kfwd_eff(157 as i64, t, m_troe), 5.2826e12, 1.05652e11) &&
    g30f_check_near(g30f_kfwd_eff(11 as i64, t, m_lind), 2.315984e09, 4.631968e07)
}

pub fn test_g30f_thermo() -> bool with Mut, Div, Panic {
    // NASA7 equilibrium constants at T=1200K (Python replica):
    //   kc037(H+O2<=>O+OH)=1.575e-2, kc097(OH+CH4)=2.387e3,
    //   kc042(H+OH+M<=>H2O+M)=3.208e20
    let t = 1200.0;
    g30f_check_near(g30f_kc(37 as i64, t), 1.57492e-02, 3.14984e-04) &&
    g30f_check_near(g30f_kc(97 as i64, t), 2.38747e03, 4.77494e01) &&
    g30f_check_near(g30f_kc(42 as i64, t), 3.20783e20, 6.41566e18)
}

fn g30f_demo_init(t: f64) -> [f64; 53] with Mut, Div, Panic {
    // 2% H2 / 1% O2 / 97% N2 at 1 atm, H-atom seed 1e-11 (chain initiation)
    let m = 1.0 / (82.057 * t);
    var c0: [f64; 53] = [0.0; 53];
    c0[0] = m * 0.02;
    c0[3] = m * 0.01;
    c0[47] = m * 0.97;
    c0[1] = 1.0e-11;
    c0
}

pub fn test_g30f_sim() -> bool with Mut, Div, Panic {
    // Cantera 3.2.0 / gri30.yaml reference: IdealGasReactor, energy="off",
    // constant density, T=1500 K, 2% H2 / 1% O2 / 97% N2 at 1 atm,
    // [H]=1e-11 mol/cm3, rtol=1e-12, atol=1e-22, advanced to t=4e-6 s.
    // H2O2 gets 1e-2 relative tolerance; all other species get 1e-4.
    // (dt=2e-9, not the H/O module's 1e-8: NNH<=>N2+H has k=3.3e8/s at 1500K,
    // k*dt>4 at dt=1e-8 is explicitly unstable and the trajectory diverges;
    // dt=2e-9 matches dt=1e-9/5e-10 to every printed digit. Cross-check vs the
    // 29-reaction H/O sub-mechanism Python replica at the same t: H2 agrees to
    // 7 digits, H2O drifts 0.16% — N-chemistry negligible pre-front, as expected)
    let t = 1500.0;
    let c0 = g30f_demo_init(t);
    let y = simulate_gri30_full(&c0, t, 2.0e-9, 2000 as i64);
    g30f_check_rel(y[0], 1.624850347163e-7, 1.0e-4) &&
    g30f_check_rel(y[1], 1.055303917243e-11, 1.0e-4) &&
    g30f_check_rel(y[2], 1.242991359322e-12, 1.0e-4) &&
    g30f_check_rel(y[3], 8.124167024858e-8, 1.0e-4) &&
    g30f_check_rel(y[4], 1.093673297574e-12, 1.0e-4) &&
    g30f_check_rel(y[5], 1.833104446868e-12, 1.0e-4) &&
    g30f_check_rel(y[6], 1.204922532044e-13, 1.0e-4) &&
    g30f_check_rel(y[7], 2.043756391817e-16, 1.0e-2)
}

pub fn test_g30f_epistemic_smoke() -> bool with Mut, Div, Panic {
    // same ignition + 1% standard uncertainty on initial H2/O2 and the
    // per-reaction rate uncertainties; Python replica at t=4e-7 s (200 steps;
    // smoke test only — the full 2000-step GUM run is too slow for a test):
    //   y(H2)=1.6249e-7  u(H2)=1.6249e-9  u(H2O)=2.2534e-16
    //   u(OH)=1.3179e-15  u(H)=1.4972e-15  (dt=2e-9, 200 steps, t=4e-7 s)
    let t = 1500.0;
    let c0 = g30f_demo_init(t);
    var u0: [f64; 53] = [0.0; 53];
    u0[0] = 0.01 * c0[0];
    u0[3] = 0.01 * c0[3];
    let (y, u) = simulate_gri30_full_epistemic(&c0, &u0, t, 2.0e-9, 200 as i64);
    g30f_check_near(y[0], 1.624886e-07, 8.12443e-09) &&
    g30f_check_near(u[0], 1.624886e-09, 8.12443e-11) &&
    g30f_check_near(u[5], 2.253439e-16, 2.253439e-17) &&
    g30f_check_near(u[4], 1.317881e-15, 1.317881e-16) &&
    g30f_check_near(u[1], 1.497205e-15, 1.497205e-16)
}

// Named entrypoint avoids colliding with a test harness main when imported.
pub fn g30f_module_main() -> i32 with Mut, Div, Panic, IO {
    var f: i32 = 0;
    if test_g30f_rates() { println("PASS g30f rates") } else { f = f + 1; println("FAIL g30f rates") }
    if test_g30f_thermo() { println("PASS g30f thermo") } else { f = f + 1; println("FAIL g30f thermo") }
    if test_g30f_sim() { println("PASS g30f sim") } else { f = f + 1; println("FAIL g30f sim") }
    if test_g30f_epistemic_smoke() { println("PASS g30f epistemic smoke") } else { f = f + 1; println("FAIL g30f epistemic smoke") }
    if f == 0 { println("GRI30_FULL 53-SPECIES 325-REACTION MECHANISM + NASA THERMO + EPISTEMIC UQ PASS") } else { println("GRI30_FULL FAIL") }
    f
}
