// ============================================================================
// gri30_full.sio — FULL GRI-Mech 3.0 mechanism (53 species, 325 reactions)
// ============================================================================
// Data: extracted verbatim from Cantera's gri30.yaml (ck2yaml of the original
// grimech30.dat + gri30_thermo.dat, GRI-Mech Version 3.0 7/30/99,
// http://combustion.berkeley.edu/gri-mech/).
//   - 53 species in GRI-Mech order: H2 H O O2 OH H2O HO2 H2O2 C CH CH2 CH2(S)
//     CH3 CH4 CO CO2 HCO CH2O CH2OH CH3O CH3OH C2H C2H2 C2H3 C2H4 C2H5 C2H6
//     HCCO CH2CO HCCOH N NH NH2 NH3 NNH NO NO2 N2O HNO CN HCN H2CN HCNN HCNO
//     HOCN HNCO NCO N2 AR C3H7 C3H8 CH2CHO CH3CHO (index order, N2=47 AR=48)
//   - 325 reactions: 284 modified Arrhenius, 12 three-body, 29 falloff
//     (26 Troe + 3 Lindemann with broadening factor F = 1), including
//     third-body efficiencies and the specific-collider H+O2+X series;
//     16 reactions are irreversible in GRI-Mech 3.0 (reverse rate exactly 0)
//   - NASA7 polynomials (200-1000-3500 K) per species for thermochemistry
//
// Rates: forward modified Arrhenius k = A T^b exp(-Ea/(R_cal T)) exactly as in
// grimech30.dat (cm^3/mol/s units, Ea in cal/mol, R_cal = 1.9872041).
// Reverse rates are NOT hardcoded: k_rev = k_fwd / Kc(T), with Kc from the
// NASA7 Gibbs free energies (Kp -> Kc with CHEMKIN standard-state 1 atm). This makes
// every reversible reaction satisfy detailed balance by construction.
//
// Epistemic layer ("ligada"): each reaction carries a representative 1-sigma
// relative uncertainty on its rate (order-of-magnitude fidelity to the
// evaluated-data compilations: Baulch et al. 2005, Konnov 2008, Hong et al.
// 2011). Uncertainty propagates through persistent forward sensitivities
// S'_r = J S_r + nu_r * net_rate_r, with V = sum_r S_r^2 u_r^2 plus
// initial-condition sensitivities. This treats rate uncertainty as systematic
// over the trajectory rather than independent per-step noise. The resulting
// symmetric +/- sigma band is only a second-moment summary: parametric samples
// at this checkpoint are skewed, so quantiles are preferable when available.
// (d(net)/dk_r = nu*net/k_r exactly for Arrhenius/three-body — reverse scales
// with k_fwd through Kc; linearization is approximate for the falloff rxns.)
//
// Units: concentrations in mol/cm^3, time in s, T in K.
// Validation: all test expectations cross-checked against an independent
// Python replication of the identical math
// (benchmarks/chemistry/gri30_full_python_replica.py).
//
// Performance note: the hot paths (simulators, Jacobian, GUM propagate) build
// the data tables ONCE and pass them by reference to internal workers —
// rebuilding a [f64; 17225] table per RHS evaluation would dominate runtime.
// m_eff (the 53-species third-body dot product) is evaluated only for the 41
// three-body/falloff reactions, never for plain Arrhenius reactions.

fn g30f_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e300 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 36 {
        term = term * t2
        sum = sum + term / ((2 * k + 1) as f64)
        k = k + 1
    }
    return 2.0 * sum + (e as f64) * 0.6931471805599453
}

fn g30f_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 709.0 { return 1.0e300 }
    if x < 0.0 - 709.0 { return 0.0 }
    let ln2 = 0.6931471805599453
    var kf = x / ln2
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 32 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k >= 0 {
        var i = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    return result
}

fn g30f_pow(base: f64, n: f64) -> f64 with Mut, Div, Panic {
    if base <= 0.0 { return 0.0 }
    g30f_exp(n * g30f_ln(base))
}

fn g30f_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn g30f_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var g = x
    if g > 1.0 { g = x * 0.5 }
    // Stop on relative convergence so the iteration remains valid as the
    // uncertainty scale changes; the cap is only a runaway guard.
    var i = 0
    var done = false
    while i < 120 && !done {
        let next = 0.5 * (g + x / g)
        done = g30f_abs(next - g) <= 1.0e-14 * next
        g = next
        i = i + 1
    }
    g
}

// ---------------- data tables (generated, do not hand-edit) ----------------

