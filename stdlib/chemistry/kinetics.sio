pub fn bench_epistemic_pinn_crn(iters: i64) -> f64 with Mut, Div, Panic {
    // run the PINN fitting loop, return final k (convergence metric)
    var k = 0.12; var uk = 0.02;
    var i = 0; while i < iters {
        let sim = exp_approx(0.0 - k * 10.0);
        let dloss_dk = 2.0 * (sim - 0.3679) * ( (exp_approx(0.0 - (k+0.001)*10.0) - sim) / 0.001 );
        k = k - 0.1 * dloss_dk;
        uk = uk * 0.9;
        i = i + 1;
    }
    k
}

pub fn test_bench_pinn() -> bool with Mut, Div, Panic {
    let m = bench_epistemic_pinn_crn(5);
    check_near(m, 0.1, 0.01)
}

pub fn bench_crn_effect_handlers(n_samples: i64) -> f64 with Mut, Div, Panic {
    // MC handler cost proxy
    var sum = 0.0; var s = 0; while s < n_samples {
        let ks = 0.1 + (0.01 * (s as f64 / n_samples as f64 - 0.5));
        sum = sum + exp_approx(0.0 - ks * 5.0);
        s = s + 1;
    }
    sum / (n_samples as f64)
}

pub fn test_bench_handlers() -> bool with Mut, Div, Panic {
    let m = bench_crn_effect_handlers(20);
    check_near(m, 0.6, 0.1)
}

