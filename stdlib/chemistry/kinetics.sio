// Deeper: stoich matrix mul for dc/dt = Nu * rates (using array, linalg note)
pub fn dc_dt_stoich(c: &[f64; 4], ks: &[f64; 3]) -> [f64; 4] {
    // stoich Nu 4x3 , rates [3]
    // example rates from mass action
    let r0 = ks[0] * c[0];
    let r1 = ks[1] * c[1];
    let r2 = ks[2] * c[0] * c[1];
    let rates = [r0, r1, r2];
    // Nu * rates , Nu = [[-1,0,-1], [1,-1,-1], [0,1,0], [0,0,1]]
    [
        -1.0 * rates[0] + 0.0 * rates[1] -1.0 * rates[2],
        1.0 * rates[0] -1.0 * rates[1] -1.0 * rates[2],
        0.0 * rates[0] +1.0 * rates[1] + 0.0 * rates[2],
        0.0 * rates[0] +0.0 * rates[1] +1.0 * rates[2]
    ]
}

pub fn test_stoich_matrix() -> bool with Mut, Div, Panic {
    let c = [1.0, 0.5, 0.0, 0.0];
    let ks = [0.1, 0.05, 0.2];
    let dc = dc_dt_stoich(&c, &ks);
    check_near(dc[0], -0.2, 0.1) // rough
}

