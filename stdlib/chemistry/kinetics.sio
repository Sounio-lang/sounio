// module-level `let` initialized from a function call fails to propagate its f64
// type to later arithmetic (lean_single checker bug) — use a fn instead of a let.
fn r_const() -> f64 { gas_constant_approx() }

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn pos_or_one(x: f64) -> f64 { if x > 0.0 { x } else { 1.0 } }
fn check_near(a: f64, b: f64, tol: f64) -> bool { abs_f64(a - b) < tol }

// Newton's method starting from y0 = x converges to sqrt(x) in a fixed 20 iterations only when x
// is within a few orders of magnitude of 1: away from x=1 each iteration roughly HALVES y until
// y ~ sqrt(x), so for x = 1e-20 (sqrt = 1e-10) 20 halvings from y0 ~ 0.5 only reach ~1e-6 -- off by
// four orders of magnitude (measured; x = 1e-100 is off by 43). Both checked chemistry simulators
// call this on a propagated variance, which can legitimately be this small. Normalize first:
// x = m * 4^k with m in [1, 4), so sqrt(x) = sqrt(m) * 2^k, and Newton on m (already within a
// factor of 4 of 1) converges in the same 20 iterations regardless of how small or large x is.
fn sqrt_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0; }
    // +inf stays +inf under repeated division by 4 (inf / 4.0 == inf), so the normalization loop
    // below never terminates on it; NaN is likewise never < 4.0 or >= 4.0 in a way that shrinks it.
    // Neither is normalizable: return the input as-is (mathematically sqrt(+inf) = +inf; NaN stays
    // NaN either way), same as any downstream finiteness check would treat both.
    if !((x - x) == 0.0) { return x }
    var m = x; var k = 0
    while m >= 4.0 { m = m / 4.0; k = k + 1 }
    while m < 1.0 { m = m * 4.0; k = k - 1 }
    var y = m; var i=0; while i<20 { y = 0.5*(y + m/y); i=i+1; }
    var scale = 1.0
    if k >= 0 { var j = 0; while j < k { scale = scale * 2.0; j = j + 1 } }
    else { var j = 0; while j < (0 - k) { scale = scale / 2.0; j = j + 1 } }
    y * scale
}

fn dual_const(val: f64) -> Dual {
    Dual { val: val, dot: 0.0 }
}

fn dual_var(val: f64) -> Dual {
    Dual { val: val, dot: 1.0 }
}

fn dual_mul(a: Dual, b: Dual) -> Dual with Mut, Div, Panic {
    Dual { val: a.val * b.val, dot: a.dot * b.val + b.dot * a.val }
}

fn dual_exp(a: Dual) -> Dual with Mut, Div, Panic {
    let e = exp_approx(a.val);
    Dual { val: e, dot: a.dot * e }
}

fn exp_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x < -50.0 { return 0.0; }
    if x > 50.0 { return 5.184705528587072e21 * exp_approx(x - 50.0); }  // exp(50)
    if x < 0.0 { return 1.0 / exp_approx(0.0 - x); }
    // range reduction: exp(x) = exp(x/64)^64, Taylor is accurate for |u| <= 0.78
    let u = x / 64.0;
    var sumv = 1.0; var term = 1.0; var k = 1;
    while k < 25 {
        term = term * u / (k as f64);
        sumv = sumv + term;
        k = k + 1;
    }
    var r = sumv;
    r = r * r; r = r * r; r = r * r; r = r * r; r = r * r; r = r * r;
    r
}

// Real Arrhenius full GUM
pub fn arrhenius(a: f64, ua: f64, ea: f64, uea: f64, t: f64, ut: f64) -> (f64, f64) with Mut, Div, Panic {
    if t <= 0.0 { return (0.0, 0.0); }
    let rt = r_const() * t;
    let expo = exp_approx(0.0 - ea / rt);
    let k = a * expo;
    let rel = (if a != 0.0 { ua / abs_f64(a) } else { 0.0 }) + (ea / rt) * ((if ea != 0.0 { uea / abs_f64(ea) } else { 0.0 }) + (if t != 0.0 { ut / abs_f64(t) } else { 0.0 }));
    (k, abs_f64(k) * rel)
}

