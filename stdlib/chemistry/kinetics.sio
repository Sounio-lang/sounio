    var nu2 = matnm_new(3 as i64, 2 as i64); nu2 = matnm_set(nu2, 0 as i64, 0 as i64, -1.0); nu2 = matnm_set(nu2, 1 as i64, 0 as i64, 1.0); nu2 = matnm_set(nu2, 0 as i64, 1 as i64, -0.5); nu2 = matnm_set(nu2, 2 as i64, 1 as i64, 0.5);
    let nus_arr: [MatNM; 2] = [nu1, nu2];
