    let m = bench_pbpk_submodels(24.0);
    // The liver submodel is linear in its input, gut_v = fractional_decay_ml(..), whose standard
    // uncertainty is 5% of it (gut_u = 0.05 gut_v). Per unit of input, from the closed form of
    // the linear chain (t = 24, k = [0.05, 0.02, 0.01], u_k = [0.004, 0.002, 0.0015]):
    //   sigma(M1) = sqrt( (M1_unit * 0.05)^2 + sum_k (dM1/dk_k * u_k)^2 ) = 0.032248621
    // (independent evaluation). The old target 0.05 +- 0.03 had no derivation; it passed only
    // because the initial uncertainty used to be fed to the solver as a variance, unsquared.
    let gut_v = fractional_decay_ml(1.0, 0.8, 24.0, 0.8);
    let want = gut_v * 0.032248621;
    check_near(m, want, 0.001 * want)
}

