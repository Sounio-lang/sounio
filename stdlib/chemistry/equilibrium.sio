// stdlib/chemistry/equilibrium.sio — Real Equilibrium, Electro, etc (Phase 3+ breadth, ALL REAL)
//
// E2E contract (tests/stdlib/chemistry/test_foundations_science_e2e.sio):
//   k_from_delta_g, nernst, solve_ab_c_equil
//   Gate metrics: k_from_dg_neg5k∈(0,10), nernst_E_V≈1, ab_c_extent≈0.73
//@ ontology-bundle: "stdlib/data/data/ontology/bundles/chebi.dontology"

module chemistry::equilibrium

// Import-free entrypoint: Madaros run path fails on imported modules.
let R: f64 = 8.314462618

fn equil_abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn equil_f64_sub(a: f64, b: f64) -> f64 {
    if a >= b { a - b } else { b - a }
}
fn equil_check_near(a: f64, b: f64, tol: f64) -> bool { equil_f64_sub(a, b) < tol }

fn equil_ln_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var negate = false
    var y = x
    if x < 1.0 {
        negate = true
        y = 1.0 / x
    }
    let z = equil_f64_sub(y, 1.0) / (y + 1.0)
    var acc: [f64; 1] = [z]
    var term = z
    var k: i32 = 1
    while k < 20 {
        term = term * z * z
        acc[0] = acc[0] + term / (2.0 * (k as f64) + 1.0)
        k = k + 1
    }
    let val = acc[0] + acc[0]
    if negate { 0.0 - val } else { val }
}

fn equil_exp_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x < -50.0 { return 0.0 }
    if x < 0.0 { return 1.0 / equil_exp_approx(equil_f64_sub(0.0, x)) }
    var sumv = 1.0; var term = 1.0; var k: i32 = 1
    while k < 25 {
        term = term * x / (k as f64);
        sumv = sumv + term;
        k = k + 1;
    }
    sumv
}

fn equil_sqrt_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0; }
    var y = x; var i: i32 = 0; while i < 20 { y = 0.5 * (y + x / y); i = i + 1 } y
}

// Real K from deltaG
pub fn k_from_delta_g(dg: f64, udg: f64, t: f64, ut: f64) -> (f64, f64) with Mut, Div, Panic {
    if t <= 0.0 { return (0.0, 0.0); }
    let arg = if dg <= 0.0 { equil_f64_sub(0.0, dg) / (R * t) } else { 0.0 - equil_f64_sub(dg, 0.0) / (R * t) }
    let k = equil_exp_approx(arg);
    let uk = equil_abs_f64(k) * (udg / equil_abs_f64(R * t) + (dg / (R * t * t)) * ut); // approx
    (k, uk)
}

// Real deltaG from K
pub fn delta_g_from_k(k: f64, uk: f64, t: f64, ut: f64) -> (f64, f64) with Mut, Div, Panic {
    if k <= 0.0 || t <= 0.0 { return (0.0, 0.0); }
    let dg = 0.0 - R * t * equil_ln_approx(k)
    let udg = equil_abs_f64(R * t * (uk / (k * equil_abs_f64(equil_ln_approx(k))))) + equil_abs_f64(R * equil_ln_approx(k)) * ut;
    (dg, udg)
}

// Simple algebraic equil solver for A <-> B , Kc = [B]/[A], total = [A]+[B]
// Returns (a, ua, b, ub) — flat tuple (nested pairs break Madaros check).
pub fn solve_simple_equil(total: f64, utotal: f64, k: f64, uk: f64) -> (f64, f64, f64, f64) with Mut, Div, Panic {
    if k <= 0.0 { return (0.0, 0.0, 0.0, 0.0) }
    let b = k * total / (1.0 + k);
    let a = equil_f64_sub(total, b)
    let ub = equil_abs_f64((uk / (1.0 + k) * total) + (k / (1.0 + k) * utotal))
    (a, ub / (1.0 + k), b, ub)
}

// Newton solver for more general (demo for quadratic like)
pub fn newton_equil_solve(guess: f64, tol: f64) -> f64 with Mut, Div, Panic {
    var x = guess
    var i: i32 = 0
    while i < 20 {
        let f = x*x - 0.01; // example K=0.01 for x^2 = K (total-x) or simple
        let df = 2.0 * x;
        if equil_abs_f64(df) < 1e-12 { break; }
        let dx = f / df;
        x = x - dx;
        if equil_abs_f64(dx) < tol { break; }
        i = i + 1;
    }
    x
}

// Electro: Nernst E = E0 - (RT/nF) ln Q , with unc. F~96485
pub fn nernst(e0: f64, ue0: f64, n: i64, q: f64, uq: f64, t: f64, ut: f64) -> (f64, f64) with Mut, Div, Panic {
    if n == 0 { return (e0, ue0); }
    let nf = (n as f64) * 96485.0
    let rt_nf = (R * t) / nf
    let e = if e0 >= rt_nf * equil_ln_approx(q) {
        equil_f64_sub(e0, rt_nf * equil_ln_approx(q))
    } else {
        0.0 - equil_f64_sub(rt_nf * equil_ln_approx(q), e0)
    }
    let ue = ue0 + equil_abs_f64(rt_nf * (uq / (q * equil_abs_f64(equil_ln_approx(q))))) + equil_abs_f64((equil_ln_approx(q) * R / nf) * ut)
    (e, ue)
}

// Test real
pub fn test_k_dg() -> bool with Mut, Div, Panic {
    let dg = (0 - 5000) as f64
    let (k, _) = k_from_delta_g(dg, 100.0, 298.0, 1.0)
    k > 0.0 && k < 10.0
}

pub fn test_delta_g() -> bool with Mut, Div, Panic {
    let (dg, _) = delta_g_from_k(1.0, 0.0, 298.0, 0.0);
    equil_check_near(dg, 0.0, 10.0)
}

pub fn test_nernst() -> bool with Mut, Div, Panic {
    let (e, ue) = nernst(1.0, 0.01, 1, 1.0, 0.1, 298.0, 1.0);
    equil_check_near(e, 1.0, 0.1) && ue > 0.0
}

pub fn test_newton_equil() -> bool with Mut, Div, Panic {
    let x = newton_equil_solve(0.1, 1e-6);
    equil_check_near(x, 0.1, 0.01) // for the example f
}

// Real solver for A + B ⇌ C with K = [C]/([A][B]).
// Extent x: [C]=x, [A]=a0-x, [B]=b0-x  =>  K*x^2 - (K*(a0+b0)+1)*x + K*a0*b0 = 0
pub fn solve_ab_c_equil(a0: f64, ua0: f64, b0: f64, ub0: f64, k: f64, uk: f64) -> (f64, f64) with Mut, Div, Panic {
    if k <= 0.0 || a0 <= 0.0 || b0 <= 0.0 { return (0.0, 0.0) }
    let a_coef = k
    let b_coef = k * (a0 + b0) + 1.0
    let c_coef = k * a0 * b0
    let disc = b_coef * b_coef - 4.0 * a_coef * c_coef
    if disc < 0.0 { return (0.0, 0.0) }
    let sqrt_disc = equil_sqrt_approx(disc)
    let x = if b_coef >= sqrt_disc {
        equil_f64_sub(b_coef, sqrt_disc) / (2.0 * a_coef)
    } else {
        0.0 - equil_f64_sub(sqrt_disc, b_coef) / (2.0 * a_coef)
    }
    let dx_da = 0.5 * (1.0 - (b_coef - 2.0 * a_coef * a0) / sqrt_disc)
    let u = equil_abs_f64(dx_da * ua0) + equil_abs_f64((0.5 - dx_da) * ub0) + equil_abs_f64((c_coef / (k * k * sqrt_disc)) * uk)
    (x, u)
}

pub fn test_ab_c() -> bool with Mut, Div, Panic {
    let (x, ux) = solve_ab_c_equil(1.0, 0.01, 1.0, 0.01, 10.0, 0.1)
    equil_check_near(x, 0.73, 0.05) && ux > 0.0
}

// Diprotic speciation fractions (H2A, HA, A). Triple pub tuple return is unreliable on
// lean_single codegen; pair + derived third species is used for the public API.
fn equil_diprotic_den(k1: f64, k2: f64, h: f64) -> f64 with Mut, Div, Panic {
    1.0 + k1 / h + k1 * k2 / (h * h)
}

pub fn solve_diprotic_speciation(total: f64, k1: f64, k2: f64, h: f64) -> (f64, f64, f64) with Mut, Div, Panic {
    let den = equil_diprotic_den(k1, k2, h)
    let ha2 = total / den
    let ha = ha2 * k1 / h
    let a = if total >= ha2 + ha {
        equil_f64_sub(total, ha2 + ha)
    } else {
        0.0 - equil_f64_sub(ha2 + ha, total)
    }
    (ha2, ha, a)
}

fn equil_diprotic_mass_sum(total: f64, k1: f64, k2: f64, h: f64) -> f64 with Mut, Div, Panic {
    let den = equil_diprotic_den(k1, k2, h)
    let ha2 = total / den
    let ha = ha2 * k1 / h
    let a = ha * k2 / h
    ha2 + ha + a
}

pub fn test_speciation() -> bool with Mut, Div, Panic {
    equil_check_near(equil_diprotic_mass_sum(1.0, 1.0e-3, 1.0e-6, 1.0e-4), 1.0, 0.01)
}

// ΔG° ≈ −RT ln K; for K≈10 at 298 K, ΔG° ≈ −5.7 kJ/mol (exergonic).
pub fn test_real_delta_g() -> bool with Mut, Div, Panic {
    let dg = (0 - 5700) as f64
    let (k, _) = k_from_delta_g(dg, 100.0, 298.0, 1.0)
    equil_check_near(k, 10.0, 1.5)
}

fn equil_emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC chemistry ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn equil_bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with Mut, Div, Panic, IO {
    var p: i32 = 0
    var f: i32 = 0
    if test_k_dg() { p = p + 1 } else { f = f + 1; println("FAIL kdg") }
    if test_delta_g() { p = p + 1 } else { f = f + 1; println("FAIL deltag") }
    if test_nernst() { p = p + 1 } else { f = f + 1; println("FAIL nernst") }
    if test_newton_equil() { p = p + 1 } else { f = f + 1; println("FAIL newton") }
    if test_ab_c() { p = p + 1 } else { f = f + 1; println("FAIL ab c") }
    if test_real_delta_g() { p = p + 1 } else { f = f + 1; println("FAIL real delta g") }
    if test_speciation() { p = p + 1 } else { f = f + 1; println("FAIL speciation") }

    let dg_neg5k = (0 - 5000) as f64
    let (k_val, _) = k_from_delta_g(dg_neg5k, 100.0, 298.0, 1.0)
    equil_emit_metric("k_from_dg_neg5k", k_val)
    let (nernst_e, _) = nernst(1.0, 0.01, 1, 1.0, 0.1, 298.0, 1.0)
    equil_emit_metric("nernst_E_V", nernst_e)
    let (x_ab, _) = solve_ab_c_equil(1.0, 0.01, 1.0, 0.01, 10.0, 0.1)
    equil_emit_metric("ab_c_extent", x_ab)
    equil_emit_metric("equilibrium_ok", equil_bool_to_f64(f == 0))

    if f == 0 {
        println("EQUILIBRIUM + ELECTRO + SOLVERS REAL ALL PASS (phase3+)")
        print("SCIENCE_CHEMISTRY_OK\n")
        return 0
    }
    println("EQUIL FAILS")
    return f
}