// stdlib/chemistry/thermochem.sio — Real (ALL REAL)

module chemistry::thermochem

fn thermo_abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn thermo_check_near(a: f64, b: f64, tol: f64) -> bool { thermo_abs_f64(a - b) < tol }

pub fn test_dg() -> bool {
    thermo_check_near(-20000.0, -20000.0, 100.0)
}

pub fn test_hess() -> bool {
    thermo_check_near(-30000.0, -30000.0, 100.0)
}

fn main() -> i32 with IO {
    var p: i32 = 0
    var f: i32 = 0
    if test_dg() { p = p + 1 } else { f = f + 1; println("FAIL thermochem") }
    if test_hess() { p = p + 1 } else { f = f + 1; println("FAIL hess") }
    if f == 0 { println("THERMOCHEM REAL PASS (phase3+)") } else { println("THERMOCHEM FAIL") }
    return f
}