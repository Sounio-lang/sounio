// stdlib/chemistry/ontology.sio — FULL integration with real ontologies (ChEBI primary)
//@ ontology-bundle: "stdlib/data/data/ontology/bundles/chebi.dontology"

// Real chemical entities from ChEBI (Chemical Entities of Biological Interest ontology).
// Enables:
//   - Nominal types (CHEBI_15377 etc.) for compile-time subsumption and type-safe chemistry
//   - IRI provenance for Knowledge<T>, EState, GUM budgets, regulatory audit
//   - Semantic CRN: species are not just indices but ontologically grounded
//   - Ties to biomedical stack (GO processes, SNOMED etc. via general ontology lib)
// Uses the stdlib ontology typed bridge + generated bundle. No stubs.

use ontology::model::{iri_new, IRI};
use ontology::typed::chebi::*;

// ============================================================================
// CORE CHEMICAL ENTITIES (ChEBI grounded, used in kinetics, equilibrium, acids, pbpk, etc.)
// ============================================================================

// Water (universal solvent, product in combustion, solvent in PBPK, etc.)
pub fn water() -> CHEBI_15377 {
    let iri = CHEBI_15377_iri();
    iri_as_CHEBI_15377(&iri)
}

pub fn water_iri() -> IRI {
    CHEBI_15377_iri()
}

// Hydrogen peroxide (example in lit BigCRN-like, oxidative stress, etc.)
// Standard public ChEBI (even if slice focuses on water subtree for demo size)
pub fn hydrogen_peroxide_iri() -> IRI {
    iri_new(16240)  // CHEBI:16240 hydrogen peroxide
}

