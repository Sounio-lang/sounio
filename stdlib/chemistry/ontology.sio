// stdlib/chemistry/ontology.sio — ChEBI grounding (import-free foundations slice)
//
// Public ChEBI / GO numeric anchors without ontology::model (Madaros E011/E137 blocker).
// IDs are plain i64 for lean_single + Madaros parity; typed CHEBI nominal lane deferred.

module chemistry::ontology

let CHEBI_WATER_ID: i64 = 15377
let CHEBI_DIOXYGEN_ID: i64 = 15379
let CHEBI_HYDROGEN_ATOM_ID: i64 = 49637
let CHEBI_HYDROXYL_ID: i64 = 29191
let CHEBI_ATOMIC_OXYGEN_ID: i64 = 25805
let CHEBI_DIHYDROGEN_ID: i64 = 18276
let CHEBI_RAPAMYCIN_ID: i64 = 9168
let CHEBI_TACROLIMUS_ID: i64 = 61049
let CHEBI_MIDAZOLAM_ID: i64 = 6931
let GO_OXIDATION_REDUCTION_ID: i64 = 55114

pub fn water() -> i64 { CHEBI_WATER_ID }
pub fn water_iri() -> i64 { CHEBI_WATER_ID }
pub fn dioxygen_iri() -> i64 { CHEBI_DIOXYGEN_ID }
pub fn hydrogen_atom_iri() -> i64 { CHEBI_HYDROGEN_ATOM_ID }
pub fn hydroxyl_iri() -> i64 { CHEBI_HYDROXYL_ID }
pub fn atomic_oxygen_iri() -> i64 { CHEBI_ATOMIC_OXYGEN_ID }
pub fn dihydrogen_iri() -> i64 { CHEBI_DIHYDROGEN_ID }
pub fn rapamycin_chebi() -> i64 { CHEBI_RAPAMYCIN_ID }
pub fn tacrolimus_chebi() -> i64 { CHEBI_TACROLIMUS_ID }
pub fn midazolam_chebi() -> i64 { CHEBI_MIDAZOLAM_ID }
pub fn reaction_oxidation_reduction_iri() -> i64 { GO_OXIDATION_REDUCTION_ID }

pub fn knowledge_water_conc_value(mol_per_l: f64) -> f64 { mol_per_l }
pub fn knowledge_water_conc_unc(u: f64) -> f64 { u }

pub fn full_big_crn_chebi_map() -> [i64; 6] with Mut {
    var out: [i64; 6] = [0; 6]
    out[0] = CHEBI_HYDROGEN_ATOM_ID
    out[1] = CHEBI_DIOXYGEN_ID
    out[2] = CHEBI_HYDROXYL_ID
    out[3] = CHEBI_ATOMIC_OXYGEN_ID
    out[4] = CHEBI_DIHYDROGEN_ID
    out[5] = CHEBI_WATER_ID
    out
}

pub fn species_to_chebi_iri(species_idx: i64, mechanism: i64) -> i64 {
    if mechanism == 0 {
        if species_idx == 0 { CHEBI_HYDROGEN_ATOM_ID }
        else if species_idx == 1 { CHEBI_DIOXYGEN_ID }
        else if species_idx == 2 { CHEBI_HYDROXYL_ID }
        else if species_idx == 3 { CHEBI_ATOMIC_OXYGEN_ID }
        else if species_idx == 4 { CHEBI_DIHYDROGEN_ID }
        else if species_idx == 5 { CHEBI_WATER_ID }
        else { 0 }
    } else if mechanism == 1 {
        if species_idx == 0 { CHEBI_WATER_ID }
        else if species_idx == 4 { CHEBI_RAPAMYCIN_ID }
        else if species_idx == 5 { CHEBI_TACROLIMUS_ID }
        else if species_idx == 6 { CHEBI_MIDAZOLAM_ID }
        else { 100000 + species_idx }
    } else {
        species_idx
    }
}

pub fn attach_chebi_crn_concs(concs: &[f64; 4]) -> [f64; 4] {
    [concs[0], concs[1], concs[2], concs[3]]
}

pub fn attach_chebi_crn_uncs(uncs: &[f64; 4]) -> [f64; 4] {
    [uncs[0], uncs[1], uncs[2], uncs[3]]
}

pub fn attach_chebi_crn_ids(mechanism: i64) -> [i64; 4] with Mut {
    var out: [i64; 4] = [0; 4]
    out[0] = species_to_chebi_iri(0, mechanism)
    out[1] = species_to_chebi_iri(1, mechanism)
    out[2] = species_to_chebi_iri(2, mechanism)
    out[3] = species_to_chebi_iri(3, mechanism)
    out
}

pub fn test_chebi_water_nominal() -> bool { water() == CHEBI_WATER_ID }

pub fn test_chebi_crn_species_mapping() -> bool {
    species_to_chebi_iri(5, 0) == CHEBI_WATER_ID && species_to_chebi_iri(1, 0) == CHEBI_DIOXYGEN_ID
}

pub fn test_all_compounds_chebi() -> bool with Mut {
    let big = full_big_crn_chebi_map()
    big[0] == CHEBI_HYDROGEN_ATOM_ID && big[5] == CHEBI_WATER_ID && rapamycin_chebi() == CHEBI_RAPAMYCIN_ID
}

pub fn test_go_redox_process() -> bool {
    reaction_oxidation_reduction_iri() == GO_OXIDATION_REDUCTION_ID
}

pub fn test_attach_chebi_crn() -> bool with Mut {
    let iris = attach_chebi_crn_ids(0)
    iris[0] == CHEBI_HYDROGEN_ATOM_ID && iris[1] == CHEBI_DIOXYGEN_ID
}

fn onto_emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC chemistry ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn onto_bool_to_f64(v: bool) -> f64 { if v { 1.0 } else { 0.0 } }

fn main() -> i32 with IO, Mut {
    var p: i32 = 0
    var f: i32 = 0
    if test_chebi_water_nominal() { p = p + 1 } else { f = f + 1 }
    if test_chebi_crn_species_mapping() { p = p + 1 } else { f = f + 1 }
    if test_all_compounds_chebi() { p = p + 1 } else { f = f + 1 }
    if test_go_redox_process() { p = p + 1 } else { f = f + 1 }
    if test_attach_chebi_crn() { p = p + 1 } else { f = f + 1 }

    onto_emit_metric("chebi_water_id", water_iri() as f64)
    onto_emit_metric("go_redox_id", reaction_oxidation_reduction_iri() as f64)
    onto_emit_metric("ontology_ok", onto_bool_to_f64(f == 0))
    onto_emit_metric("tests_passed", p as f64)

    if f == 0 {
        print("SCIENCE_CHEMISTRY_OK\n")
        return 0
    }
    return f
}