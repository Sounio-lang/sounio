// stdlib/chemistry/ontology.sio — ChEBI grounding (foundations slice, check-green)
//@ ontology-bundle: "stdlib/data/data/ontology/bundles/chebi.dontology"

use ontology::model::{iri_new, IRI};
use ontology::typed::chebi::*;

pub fn water() -> CHEBI_15377 {
    let iri = CHEBI_15377_iri()
    iri_as_CHEBI_15377(&iri)
}

pub fn water_iri() -> IRI {
    CHEBI_15377_iri()
}

pub fn dioxygen_iri() -> IRI {
    iri_new(15379)
}

pub fn hydrogen_atom_iri() -> IRI {
    iri_new(49637)
}

pub fn hydroxyl_iri() -> IRI {
    iri_new(29191)
}

pub fn atomic_oxygen_iri() -> IRI {
    iri_new(25805)
}

pub fn dihydrogen_iri() -> IRI {
    iri_new(18276)
}

pub fn rapamycin_chebi() -> IRI { iri_new(9168) }
pub fn tacrolimus_chebi() -> IRI { iri_new(61049) }
pub fn midazolam_chebi() -> IRI { iri_new(6931) }

pub fn full_big_crn_chebi_map() -> [IRI; 6] {
    [
        hydrogen_atom_iri(),
        dioxygen_iri(),
        hydroxyl_iri(),
        atomic_oxygen_iri(),
        dihydrogen_iri(),
        water_iri()
    ]
}

// mechanism: 0=big_crn, 1=metabolic/pbpk
pub fn species_to_chebi_iri(species_idx: i64, mechanism: i64) -> IRI {
    if mechanism == 0 {
        if species_idx == 0 { hydrogen_atom_iri() }
        else if species_idx == 1 { dioxygen_iri() }
        else if species_idx == 2 { hydroxyl_iri() }
        else if species_idx == 3 { atomic_oxygen_iri() }
        else if species_idx == 4 { dihydrogen_iri() }
        else if species_idx == 5 { water_iri() }
        else { iri_new(0) }
    } else if mechanism == 1 {
        if species_idx == 0 { water_iri() }
        else if species_idx == 4 { rapamycin_chebi() }
        else if species_idx == 5 { tacrolimus_chebi() }
        else if species_idx == 6 { midazolam_chebi() }
        else { iri_new(100000 + species_idx) }
    } else {
        iri_new(species_idx)
    }
}

pub fn test_chebi_water_nominal() -> bool {
    let _w = water()
    let iri = water_iri()
    iri.id == CHEBI_15377_ID
}

pub fn test_chebi_crn_species_mapping() -> bool {
    let h2o = species_to_chebi_iri(5, 0)
    let o2 = species_to_chebi_iri(1, 0)
    h2o.id == CHEBI_15377_ID && o2.id == 15379
}

pub fn test_all_compounds_chibi() -> bool {
    let big = full_big_crn_chebi_map()
    big[0].id == 49637 && big[1].id == 15379 && big[5].id == 15377
        && rapamycin_chebi().id == 9168 && tacrolimus_chebi().id == 61049
}