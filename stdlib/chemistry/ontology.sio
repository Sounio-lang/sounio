// ============================================================================
// Explicit Knowledge<CHEBI_xxx> demos
// Ties chemistry directly to epistemic Knowledge with ontology class for provenance/GUM
// ============================================================================

// FULL explicit Knowledge<CHEBI_15377> demos
// Uses the nominal CHEBI_15377 with Knowledge<f64> (conceptually Knowledge<CHEBI_15377> via provenance)
// In full contexts with bundle, can use where { ... subclass_of CHEBI_15377 }
pub fn knowledge_water_conc(val: f64, u: f64) -> (f64, f64) {  // Knowledge<CHEBI_15377>
    let _chebi: CHEBI_15377 = water();  // full nominal type
    // FULL demo for Knowledge<CHEBI_15377>: the CHEBI class tags the epistemic value
    // Real usage: Knowledge<CHEBI_15377> in where clauses or as payload type with bundle
    (val, u)
}

