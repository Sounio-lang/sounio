// stdlib/http — HTTP request/response types (pure data structures)

let HTTP_GET: i64 = 1
let HTTP_POST: i64 = 2
let HTTP_PUT: i64 = 3
let HTTP_DELETE: i64 = 4
let HTTP_PATCH: i64 = 5

struct HttpRequest {
    method: i64,
    path_hash: i64,
    header_count: i64,
    headers_name: [i64; 32],
    headers_value: [i64; 32],
    body_len: i64,
}

fn http_request_new(method: i64) -> HttpRequest {
    HttpRequest {
        method: method,
        path_hash: 0,
        header_count: 0,
        headers_name: [0; 32],
        headers_value: [0; 32],
        body_len: 0,
    }
}

impl HttpRequest {
    fn is_get(self: &HttpRequest) -> bool { self.method == HTTP_GET }
    fn is_post(self: &HttpRequest) -> bool { self.method == HTTP_POST }

    fn add_header(self: &! HttpRequest, name_hash: i64, value_hash: i64) {
        if self.header_count >= 32 { return }
        let i = self.header_count
        self.headers_name[i] = name_hash
        self.headers_value[i] = value_hash
        self.header_count = self.header_count + 1
    }
}

struct HttpResponse {
    status: i64,
    header_count: i64,
    headers_name: [i64; 32],
    headers_value: [i64; 32],
    body_len: i64,
}

fn http_response_new(status: i64) -> HttpResponse {
    HttpResponse {
        status: status,
        header_count: 0,
        headers_name: [0; 32],
        headers_value: [0; 32],
        body_len: 0,
    }
}

impl HttpResponse {
    fn is_ok(self: &HttpResponse) -> bool {
        self.status >= 200 && self.status < 300
    }

    fn is_error(self: &HttpResponse) -> bool {
        self.status >= 400
    }

    fn add_header(self: &! HttpResponse, name_hash: i64, value_hash: i64) {
        if self.header_count >= 32 { return }
        let i = self.header_count
        self.headers_name[i] = name_hash
        self.headers_value[i] = value_hash
        self.header_count = self.header_count + 1
    }
}
