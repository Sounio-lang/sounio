// http/mod.sio — HTTP Request/Response Types
//
// Data structures for HTTP protocol representation.
// No networking; these are pure data types for use by transport layers.

// ============================================================================
// HTTP METHOD CONSTANTS
// ============================================================================

pub fn HTTP_GET() -> i32 { 0 }
pub fn HTTP_POST() -> i32 { 1 }
pub fn HTTP_PUT() -> i32 { 2 }
pub fn HTTP_DELETE() -> i32 { 3 }
pub fn HTTP_PATCH() -> i32 { 4 }
pub fn HTTP_HEAD() -> i32 { 5 }
pub fn HTTP_OPTIONS() -> i32 { 6 }

// ============================================================================
// HTTP REQUEST
// ============================================================================

pub struct HttpRequest {
    method: i32,            // HTTP_GET, HTTP_POST, etc.
    path: [u8; 256],        // URL path bytes
    path_len: i32,          // Length of path
    body: [u8; 1024],       // Request body bytes
    body_len: i32,          // Length of body
}

pub fn http_request_new(method: i32) -> HttpRequest {
    HttpRequest {
        method: method,
        path: [0; 256],
        path_len: 0,
        body: [0; 1024],
        body_len: 0,
    }
}

// ============================================================================
// HTTP RESPONSE
// ============================================================================

pub struct HttpResponse {
    status: i32,            // HTTP status code (200, 404, etc.)
    body: [u8; 1024],       // Response body bytes
    body_len: i32,          // Length of body
}

pub fn http_response_new(status: i32) -> HttpResponse {
    HttpResponse {
        status: status,
        body: [0; 1024],
        body_len: 0,
    }
}

// ============================================================================
// STATUS CODE HELPERS
// ============================================================================

pub fn http_is_success(status: i32) -> bool {
    status >= 200 && status < 300
}

pub fn http_is_redirect(status: i32) -> bool {
    status >= 300 && status < 400
}

pub fn http_is_client_error(status: i32) -> bool {
    status >= 400 && status < 500
}

pub fn http_is_server_error(status: i32) -> bool {
    status >= 500 && status < 600
}

// ============================================================================
// INLINE TESTS
// ============================================================================

//@ run-pass
fn test_http_methods() -> i32 {
    if HTTP_GET() != 0 { return 1 }
    if HTTP_POST() != 1 { return 2 }
    if HTTP_DELETE() != 3 { return 3 }
    0
}

//@ run-pass
fn test_http_request_new() -> i32 {
    let req = http_request_new(HTTP_GET())
    if req.method != 0 { return 1 }
    if req.path_len != 0 { return 2 }
    if req.body_len != 0 { return 3 }
    0
}

//@ run-pass
fn test_http_response_new() -> i32 {
    let resp = http_response_new(200)
    if resp.status != 200 { return 1 }
    if resp.body_len != 0 { return 2 }
    0
}

//@ run-pass
fn test_http_status_helpers() -> i32 {
    if !http_is_success(200) { return 1 }
    if !http_is_success(201) { return 2 }
    if http_is_success(404) { return 3 }
    if !http_is_client_error(404) { return 4 }
    if !http_is_server_error(500) { return 5 }
    if !http_is_redirect(301) { return 6 }
    0
}
