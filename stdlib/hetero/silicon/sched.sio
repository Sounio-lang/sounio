// stdlib/hetero/silicon/sched.sio
//
// Schedule the stamp kernel speaks. One description, three machines.
// An opcode with no measured row on a machine is refused by that encoder.

module hetero::silicon::sched

pub fn arch_sm89() -> i64 { 1 }
pub fn arch_rdna() -> i64 { 2 }
pub fn arch_agx() -> i64 { 3 }

pub fn op_mov_u32() -> i64 { 1 }
pub fn op_stg32() -> i64 { 2 }
pub fn op_fma_f32() -> i64 { 3 }
pub fn op_add_u32() -> i64 { 4 }
pub fn op_bar_sync() -> i64 { 5 }
pub fn op_shfl_down() -> i64 { 6 }
pub fn op_ldg128() -> i64 { 7 }
pub fn op_exit() -> i64 { 8 }

pub struct SiOp {
    pub op: i64,
    pub dst: i64,
    pub a: i64,
    pub b: i64,
    pub c: i64,
}
