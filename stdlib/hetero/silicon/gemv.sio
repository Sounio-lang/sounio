// Checked launcher for the experimental packed sm_89 grid image.
// The caller must keep the allocation alive and not change the current CUDA
// context during this synchronous call. No PTX fallback is performed.
module hetero::silicon::gemv

extern "C" {
    fn dlsym(handle: *mut u8, symbol: *mut u8) -> *mut u8
}

use hetero::cuda_exec::{CudaExec}
use hetero::probe_cuda::{pb_cstr}
use hetero::silicon::image::{si_gemv_grid_sm89}

// Returns payload bytes for supported dimensions, otherwise zero.
pub fn sg_payload(n: i64, k: i64) -> i64 {
    if n < 1 || n > 65535 || k < 1 || k > 4096 { return 0 }
    let span = if n > k { n } else { k }
    (2 * n + span + n * k) * 4
}

// Pure arithmetic check only: capacity must be established separately by
// querying the CUDA driver, never trusted as proof of allocation ownership.
pub fn sg_layout_ok(base: i64, capacity: i64, n: i64, k: i64) -> bool with Div {
    let payload = sg_payload(n, k)
    if payload == 0 || base <= 0 || capacity < payload || base % 4 != 0 { return false }
    // The last live thread increments its weight pointer even after its
    // final load. This computed address must also remain in the same region.
    let last = payload + 4 * n - 4
    if base > 9223372036854775807 - last { return false }
    if (base & 4294967295) + last > 4294967295 { return false }
    true
}

fn sg_sym(exec: &CudaExec, name: string) -> *mut u8 with Alloc, Mut {
    let c = pb_cstr(name)
    let raw = dlsym(exec.cuda, c)
    heap_free(c as *mut i8)
    raw
}

// Scratch is owned and freed by the outer wrapper. Status: 0 success;
// 1 invalid layout, 2 context/device/allocation refusal, 3 missing symbol;
// 4 module/function failure, 5 launch/sync/unload failure (writes possible).
fn sg_launch_inner(exec: &CudaExec, base: i64, n: i64, k: i64, scratch: *mut u8) -> i64 with Alloc, Mut, Div, Panic {
    let raw_ctx = sg_sym(exec, "cuCtxGetDevice")
    let raw_attr = sg_sym(exec, "cuDeviceGetAttribute")
    let raw_range = sg_sym(exec, "cuMemGetAddressRange_v2")
    let raw_load = sg_sym(exec, "cuModuleLoadData")
    let raw_func = sg_sym(exec, "cuModuleGetFunction")
    let raw_launch = sg_sym(exec, "cuLaunchKernel")
    let raw_sync = sg_sym(exec, "cuCtxSynchronize")
    let raw_unload = sg_sym(exec, "cuModuleUnload")
    if (raw_ctx as i64) == 0 || (raw_attr as i64) == 0 || (raw_range as i64) == 0 ||
       (raw_load as i64) == 0 || (raw_func as i64) == 0 || (raw_launch as i64) == 0 ||
       (raw_sync as i64) == 0 || (raw_unload as i64) == 0 { return 3 }
    let ctx = raw_ctx as fn(*mut u8) -> i32
    let attr = raw_attr as fn(*mut u8, i32, i32) -> i32
    let range = raw_range as fn(*mut u8, *mut u8, i64) -> i32
    write_i64(scratch as *mut i64, 0, 0)
    if ctx(scratch) != 0 { return 2 }
    let device = (read_i64(scratch as *mut i64, 0) & 4294967295) as i32
    write_i64(scratch as *mut i64, 0, 0)
    if attr(scratch, 75, device) != 0 || read_i64(scratch as *mut i64, 0) != 8 { return 2 }
    write_i64(scratch as *mut i64, 0, 0)
    if attr(scratch, 76, device) != 0 || read_i64(scratch as *mut i64, 0) != 9 { return 2 }
    let sizeptr = ((scratch as i64) + 8) as *mut u8
    write_i64(scratch as *mut i64, 0, 0)
    write_i64(scratch as *mut i64, 1, 0)
    if range(scratch, sizeptr, base) != 0 { return 2 }
    let allocation = read_i64(scratch as *mut i64, 0)
    let size = read_i64(scratch as *mut i64, 1)
    if allocation <= 0 || base < allocation || size <= 0 { return 2 }
    let offset = base - allocation
    if offset >= size { return 2 }
    if !sg_layout_ok(base, size - offset, n, k) { return 1 }

    let image = si_gemv_grid_sm89(n, k)
    if !image.ok || (image.ptr as i64) == 0 { return 4 }
    let load = raw_load as fn(*mut u8, *mut u8) -> i32
    write_i64(scratch as *mut i64, 0, 0)
    let load_status = load(scratch, image.ptr)
    heap_free(image.ptr as *mut i8)
    if load_status != 0 { return 4 }
    let module = read_i64(scratch as *mut i64, 0)
    let unload = raw_unload as fn(i64) -> i32
    let get_func = raw_func as fn(*mut u8, i64, *mut u8) -> i32
    let name = pb_cstr("stamp")
    write_i64(scratch as *mut i64, 1, 0)
    let func_status = get_func(sizeptr, module, name)
    heap_free(name as *mut i8)
    if func_status != 0 {
        if unload(module) != 0 { return 5 }
        return 4
    }
    let function = read_i64(scratch as *mut i64, 1)
    let arg = ((scratch as i64) + 16) as *mut u8
    let params = ((scratch as i64) + 24) as *mut u8
    write_i64(scratch as *mut i64, 2, base)
    write_i64(scratch as *mut i64, 3, arg as i64)
    let launch = raw_launch as fn(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i32
    let sync = raw_sync as fn() -> i32
    let launch_status = launch(function, (n + 127) / 128, 1, 1, 128, 1, 1, 0, 0, params as i64, 0)
    var sync_status: i32 = 0
    if launch_status == 0 { sync_status = sync() }
    let unload_status = unload(module)
    if launch_status != 0 || sync_status != 0 || unload_status != 0 { return 5 }
    0
}

// Validates dimensions and arithmetic before any CUDA query, then validates
// the actual allocation and current device before loading or launching.
pub fn sg_launch_sm89(exec: &CudaExec, base: i64, n: i64, k: i64) -> i64 with Alloc, Mut, Div, Panic {
    let payload = sg_payload(n, k)
    if !sg_layout_ok(base, payload, n, k) { return 1 }
    if !exec.ok || (exec.cuda as i64) == 0 { return 2 }
    let scratch = heap_alloc(32)
    if (scratch as i64) == 0 { return 2 }
    let status = sg_launch_inner(exec, base, n, k, scratch)
    heap_free(scratch as *mut i8)
    status
}
