// stdlib/hetero/silicon/nvidia/atlas.sio
//
// sm_89 assembly atlas. 1328 instructions, 43 cubins, nvdisasm 12.8.55.
// Bytes 0 and 1 are the opcode. Bytes 13 and 14 move inside one opcode
// and are the schedule, kept from the slot being replaced.
// A register number is the register itself. 255 is RZ.
//
// opcode          b0  b1   fields, byte index
// MOV rr          02  72   dst 2, src 4
// MOV imm         02  78   dst 2, imm u32 at 4
// IMAD.MOV imm    24  74   dst 2, imm u32 at 4, byte 3 = 255
// IMAD.MOV c[]    24  76   dst 2, c_offset/4 at 5
// LDG.E           81  79   dst 2, addr 3, disp 5, byte 4 = 4
// STG.E           86  79   addr 3, data 4, disp 5
// IADD3 rr        10  72   dst 2, src0 3, src1 4, negate-src1 at 7 (128)
// IADD3 imm       10  78   dst 2, src 3, imm at 4
// IADD3.X         10  72   dst 2, src 3, fixed tail
// SHFL.BFLY       89  7f   dst 2, src 3, delta<<5 at 6
// BAR.SYNC        1d  7b   id<<6 at 6
// S2R tid         19  79   dst 2
// EXIT            4d  79   schedule only
//
// Device-checked before this atlas existed, as single-byte patches:
// IADD3 dst, src1, negate pair, disp; STG data and addr; LDG disp;
// FFMA dst and addend; MOV/IMAD imm; SHFL delta; BAR id.

module hetero::silicon::nvidia::atlas

pub fn op_iadd3_rr_b0() -> i64 { 16 }
pub fn op_iadd3_rr_b1() -> i64 { 114 }
pub fn fld_dst() -> i64 { 2 }
pub fn fld_src0() -> i64 { 3 }
pub fn fld_src1() -> i64 { 4 }

// Low 8 bytes of IADD3 dst, src0, src1, RZ. neg must be 0: the negate
// bit is bit 63 and is not formed here.
pub fn atlas_iadd3_lo(dst: i64, src0: i64, src1: i64, neg: i64) -> i64 {
    if neg != 0 { return 0 }
    16 + 114 * 256 + dst * 65536 + src0 * 16777216 + src1 * 4294967296
}

pub fn atlas_stg_lo(addr: i64, data: i64) -> i64 {
    134 + 121 * 256 + addr * 16777216 + data * 4294967296
}

pub fn atlas_ldg_lo(dst: i64, addr: i64, disp: i64) -> i64 {
    129 + 121 * 256 + dst * 65536 + addr * 16777216 + 4 * 4294967296 + disp * 1099511627776
}
