fn fma_word(i: i64) -> i64 {
    if i < 86 { return fma_word_0(i) }
    if i < 172 { return fma_word_1(i) }
    if i < 258 { return fma_word_2(i) }
    if i < 341 { return fma_word_3(i) }
    return 0
}

pub fn sm89_fma_image(addend_bits: i64) -> *mut u8 with Alloc, Mut, Div {
    let buf = heap_alloc(2728)
    var i: i64 = 0
    while i < 341 {
        var w = fma_word(i)
        if i == 188 { w = patch_high_u32(w, addend_bits) }
        write_i64(buf as *mut i64, i, w)
        i = i + 1
    }
    buf
}

pub fn sm89_fma_dest0_image(addend_bits: i64) -> *mut u8 with Alloc, Mut, Div {
    let buf = heap_alloc(2728)
    var i: i64 = 0
    while i < 341 {
        var w = fma_word(i)
        if i == 188 {
            w = patch_high_u32(w, addend_bits)
            w = patch_byte(w, 16, 0)
        }
        write_i64(buf as *mut i64, i, w)
        i = i + 1
    }
    buf
}
