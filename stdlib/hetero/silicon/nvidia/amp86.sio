fn movk_w(i: i64) -> i64 {
    if i < 82 { return movk_w_0(i) }
    if i < 164 { return movk_w_1(i) }
    if i < 246 { return movk_w_2(i) }
    return movk_w_3(i)
}

pub fn sm86_movk_image() -> *mut u8 with Alloc, Mut, Div {
    let buf = heap_alloc(2600)
    var i: i64 = 0
    while i < 325 {
        var w = movk_w(i)
        if i == 178 { w = atlas_imad_mov_lo(5, 42) }
        write_i64(buf as *mut i64, i, w)
        i = i + 1
    }
    buf
}

