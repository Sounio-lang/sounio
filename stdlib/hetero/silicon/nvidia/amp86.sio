    if i < 164 { return dmul_w_1(i) }
    if i < 246 { return dmul_w_2(i) }
    if i < 328 { return dmul_w_3(i) }
    return dmul_w_4(i)
}

pub fn sm86_dmul_image() -> *mut u8 with Alloc, Mut, Div {
    let buf = heap_alloc(2984)
    var i: i64 = 0
    while i < 373 {
        var w = dmul_w(i)
        if i == 182 { w = atlas_mov_imm_lo(2, 2576980378) }
        if i == 184 { w = atlas_mov_imm_lo(3, 1072798105) }
        if i == 186 { w = atlas_mov_imm_lo(4, 1717986918) }
        if i == 188 { w = atlas_mov_imm_lo(5, 1073899110) }
        if i == 190 { w = atlas_dmul_lo(4, 4, 4) }
        write_i64(buf as *mut i64, i, w)
        i = i + 1
    }
    buf
}
