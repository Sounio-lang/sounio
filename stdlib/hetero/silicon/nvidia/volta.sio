}

pub fn sm70_movk_image() -> *mut u8 with Alloc, Mut {
    let buf = heap_alloc(2472)
    var i: i64 = 0
    while i < 309 {
        write_i64(buf as *mut i64, i, vol_w(i))
        i = i + 1
    }
    buf
}
