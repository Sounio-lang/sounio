fn own_word(i: i64) -> i64 {
    if i < 82 { return own_word_a(i) }
    if i < 164 { return own_word_b(i) }
    if i < 246 { return own_word_c(i) }
    return own_word_d(i)
}


// Padding after EXIT. The working image carries one BRA and eight NOPs
// so the 256-byte text section is full. These are not the stored result.
fn own_bra_lo() -> i64 { 9223371968135330119 - 9223372036854775808 }
fn own_bra_hi() -> i64 { 4433230942175231 }
fn own_nop_lo() -> i64 { 31000 }
fn own_nop_hi() -> i64 { 4433230883192832 }

fn own_stg_disp(addr: i64, data: i64, disp: i64) -> i64 {
    atlas_stg_lo(addr, data) + disp * 1099511627776
}

fn put_insn(buf: *mut u8, slot: i64, lo: i64, hi: i64) with Mut {
    write_i64(buf as *mut i64, 176 + slot * 2, lo)
    write_i64(buf as *mut i64, 177 + slot * 2, hi)
}

pub fn sm89_own_image() -> *mut u8 with Alloc, Mut, Div {
    let buf = heap_alloc(2600)
    var i: i64 = 0
    while i < 325 {
        write_i64(buf as *mut i64, i, own_word(i))
        i = i + 1
    }
    put_insn(buf, 0, atlas_imad_c_lo(1, 10), atlas_imad_c_hi(2))
    put_insn(buf, 1, atlas_mov_c_lo(2, 88), atlas_mov_c_hi(1))
    put_insn(buf, 2, atlas_mov_c_lo(3, 89), atlas_mov_c_hi(5))
    put_insn(buf, 3, atlas_uldc_lo(4, 70), 2560 + atlas_sched(1, 1, 7, 7, 0))
    put_insn(buf, 4, atlas_ldg_lo(4, 2, 0) + 2 * 4294967296, 203299072 + atlas_sched(1, 1, 2, 7, 0))
    put_insn(buf, 5, atlas_ldg_lo(6, 2, 4) + 2 * 4294967296, 203299072 + atlas_sched(1, 1, 3, 7, 0))
    put_insn(buf, 6, atlas_ldg_lo(8, 2, 8) + 2 * 4294967296, 203299072 + atlas_sched(1, 1, 4, 7, 0))
    put_insn(buf, 7, atlas_ldg_lo(9, 2, 12) + 2 * 4294967296, 203299072 + atlas_sched(1, 1, 5, 7, 0))
    put_insn(buf, 8, 35 + 114 * 256 + 4 * 16777216 + 6 * 4294967296, 255 + atlas_sched(5, 0, 7, 7, 12))
    put_insn(buf, 9, atlas_ldg_lo(4, 2, 16) + 2 * 4294967296, 203299072 + atlas_sched(1, 1, 2, 7, 0))
    put_insn(buf, 10, atlas_ldg_lo(6, 2, 20) + 2 * 4294967296, 203299072 + atlas_sched(1, 1, 3, 7, 0))
    put_insn(buf, 11, 35 + 114 * 256 + 8 * 16777216 + 9 * 4294967296, atlas_sched(5, 0, 7, 7, 48))
    put_insn(buf, 12, 35 + 114 * 256 + 4 * 16777216 + 6 * 4294967296, atlas_sched(5, 0, 7, 7, 12))
    put_insn(buf, 13, own_stg_disp(2, 0, 24), atlas_stg_hi())
    put_insn(buf, 14, atlas_exit_lo(), atlas_exit_hi())
    put_insn(buf, 15, own_nop_lo(), own_nop_hi())
    write_i64(buf as *mut i64, 102, own_regcount_word(12))
    write_i64(buf as *mut i64, 301, own_shi_word(12))
    write_i64(buf as *mut i64, 111, 269316 + 224 * 4294967296)
    buf
}

