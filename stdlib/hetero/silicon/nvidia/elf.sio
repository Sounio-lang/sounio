// stdlib/hetero/silicon/nvidia/elf.sio
//
// sm_89 ELF written by Sounio. No cubin is read.
// The container (header, strings, symbols, .nv.info, constant bank,
// section and program headers) is the measured layout of a one-parameter
// stamp image: 2600 bytes, e_machine 190, e_flags 0x590559, .text at 0x580.
// The instruction words are atlas output, not that image's .text.
//
// Body, file 0x580, 16 bytes each. Job 18279 stored 1073741824
// (the bits of 2.0) from the previous order, which put the immediate
// move after the pointer load and padded with EXIT. This order is the
// one whose words the atlas already matches to a kernel that stored 42.
//   0x00 IMAD.MOV R1, c[0][0x28]
//   0x10 IMAD.MOV R5, RZ, RZ, 42
//   0x20 MOV R2, c[0][0x160]
//   0x30 ULDC.64 UR4, c[0][0x118]  stall 1, yield 1
//   0x40 MOV R3, c[0][0x164]
//   0x50 STG.E [R2], R5
//   0x60 EXIT
//   0x70 BRA, then NOP through 0xf0. Padding after EXIT, not a result.
// SHI_REGISTERS 8: .nv.info byte 0x330 and .text sh_info at file 0x96f.

module hetero::silicon::nvidia::elf

use hetero::silicon::nvidia::atlas::{
    atlas_exit_hi, atlas_exit_lo, atlas_iadd3_hi, atlas_iadd3_lo, atlas_imad_c_hi, atlas_imad_c_lo, atlas_imad_mov_hi,
    atlas_imad_mov_lo, atlas_ldg_hi, atlas_ldg_lo, atlas_mov_c_hi, atlas_mov_c_lo, atlas_sched, atlas_shi_info,
    atlas_stg_hi, atlas_stg_lo, atlas_uldc_lo,
}

pub fn sm89_own_nbytes() -> i64 { 2600 }

// .text sh_info word. Low 32 bits are the link to .symtab (section 3).
// High 32 bits are atlas_shi_info: low byte 6, register count in bits 24..31.
pub fn own_shi_word(nregs: i64) -> i64 {
    3 + atlas_shi_info(nregs) * 4294967296
}

// .nv.info EIATTR_REGCOUNT. The count is the low byte. The rest of the
// word is the following EIATTR_FRAME_SIZE header, which stays put.
pub fn own_regcount_word(nregs: i64) -> i64 {
    nregs + 528644 * 4294967296
}


