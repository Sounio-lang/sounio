// stdlib/hetero/silicon/nvidia/fields.sio
//
// Measured sm_89 fields. A row exists only where two or more cubins
// differed in that field and the bytes were the value itself.
//
// FFMA addend, file offset 1508: raw f32 bits. Specimens 3.0 and 4.0
// differed by that one u32 (0x40400000, 0x40800000).
//
// SHFL.BFLY delta, file offset 1478, byte = delta << 5.
// Specimens delta 1, 2 and 4 wrote 0x20, 0x40 and 0x80. Nothing else moved.
//
// BAR.SYNC id, file offset 1430, byte = id << 6, for id 0, 1, 2, 3
// (bytes 0x00, 0x40, 0x80, 0xc0). A second byte at file offset 2506,
// outside the text, is (id + 1) << 4. Ids above 3 are not measured.
//
// IADD3 displacement, file offset 1652: raw u32. Specimens 16 and 32.
// The vector load itself stays LDG.E.EF.128. The displacement is added
// before that load. opt-level 0 folded a zero displacement away, so the
// +0 cubin is not the same container.
//
// LDG cache mode, byte at file offset 1754, same registers R0 and [R2]:
// cs (LDG.E.EF) 0x0e, lu (LDG.E.LU) 0x3e. ca and cg also change the
// previous byte (0x19 -> 0xb9 and 0xf9). No formula past those four rows.

module hetero::silicon::nvidia::fields

pub fn ffma_addend_off() -> i64 { 1508 }
pub fn shfl_delta_off() -> i64 { 1478 }
pub fn bar_id_off() -> i64 { 1430 }
pub fn bar_meta_off() -> i64 { 2506 }
pub fn iadd3_disp_off() -> i64 { 1652 }
pub fn ldg_cache_off() -> i64 { 1754 }
pub fn ldg_cache_lu() -> i64 { 62 }

pub fn patch_high_u32(w: i64, imm: i64) -> i64 with Div {
    let low = w & 4294967295
    let u = imm & 4294967295
    let lo = u & 65535
    let hi = u / 65536
    var high: i64 = 0
    if hi < 32768 {
        high = hi * 281474976710656
    } else {
        high = (hi - 65536) * 281474976710656
    }
    low + lo * 4294967296 + high
}

fn shift_unit(sh: i64) -> i64 {
    if sh == 0 { return 1 }
    if sh == 8 { return 256 }
    if sh == 16 { return 65536 }
    if sh == 24 { return 16777216 }
    if sh == 32 { return 4294967296 }
    if sh == 40 { return 1099511627776 }
    if sh == 48 { return 281474976710656 }
    return 0
}

pub fn patch_byte(w: i64, sh: i64, b: i64) -> i64 {
    let m = shift_unit(sh)
    let mask = 255 * m
    let cleared = w - (w & mask)
    cleared + (b & 255) * m
}
