// stdlib/hetero/silicon/image.sio
//
// Build a device image from a measured encoder. RDNA and AGX stay closed
// until their labs return a row. A closed image has ok=false and is not loaded.

module hetero::silicon::image

use hetero::silicon::sched::{arch_agx, arch_rdna, arch_sm89}
use hetero::silicon::nvidia::sm89::{sm89_stamp_image, sm89_stamp_nbytes}
use hetero::silicon::amd::rdna::{rdna_stamp_nbytes}
use hetero::silicon::apple::agx::{agx_stamp_nbytes}

pub struct SiImage {
    pub ptr: *mut u8,
    pub nbytes: i64,
    pub ok: bool,
}

pub fn si_stamp(arch: i64, imm: i64) -> SiImage with Alloc, Mut, Div {
    if arch == arch_sm89() {
        return SiImage { ptr: sm89_stamp_image(imm), nbytes: sm89_stamp_nbytes(), ok: true }
    }
    if arch == arch_rdna() {
        return SiImage { ptr: 0 as *mut u8, nbytes: rdna_stamp_nbytes(), ok: false }
    }
    if arch == arch_agx() {
        return SiImage { ptr: 0 as *mut u8, nbytes: agx_stamp_nbytes(), ok: false }
    }
    SiImage { ptr: 0 as *mut u8, nbytes: 0, ok: false }
}
