// stdlib/hetero/silicon/image.sio
//
// Build a device image from a measured encoder. RDNA and AGX stay closed
// until their labs return a row. A closed image has ok=false and is not loaded.

module hetero::silicon::image

use hetero::silicon::sched::{arch_agx, arch_rdna, arch_sm89}
use hetero::silicon::nvidia::sm89::{sm89_stamp_image, sm89_stamp_nbytes}
use hetero::silicon::nvidia::fma::{sm89_fma_dest0_image, sm89_fma_image, sm89_fma_nbytes, sm89_fma_src_image}
use hetero::silicon::nvidia::shfl::{sm89_shfl_image, sm89_shfl_nbytes}
use hetero::silicon::nvidia::bar::{sm89_bar_image, sm89_bar_nbytes}
use hetero::silicon::nvidia::ldg::{sm89_ldg_image, sm89_ldg_nbytes}
use hetero::silicon::nvidia::cache::{sm89_cache_image, sm89_cache_nbytes}
use hetero::silicon::nvidia::reg::{sm89_sub_image, sm89_sub_nbytes}
use hetero::silicon::nvidia::movk::{sm89_movk_image, sm89_movk_nbytes}
use hetero::silicon::nvidia::amp86::{sm86_dmul_image, sm86_dmul_nbytes, sm86_movk_image, sm86_movk_nbytes}
use hetero::silicon::nvidia::volta::{sm70_movk_image, sm70_movk_nbytes}
use hetero::silicon::nvidia::elf::{sm89_gemv_image, sm89_grid_image, sm89_grid_nbytes, sm89_own_image, sm89_own_nbytes}
use hetero::silicon::amd::rdna::{rdna_stamp_nbytes}
use hetero::silicon::apple::agx::{agx_stamp_nbytes}

pub struct SiImage {
    pub ptr: *mut u8,
    pub nbytes: i64,
    pub ok: bool,
}

pub fn si_stamp(arch: i64, imm: i64) -> SiImage with Alloc, Mut, Div {
    if arch == arch_sm89() {
        return SiImage { ptr: sm89_stamp_image(imm), nbytes: sm89_stamp_nbytes(), ok: true }
    }
    if arch == arch_rdna() {
        return SiImage { ptr: 0 as *mut u8, nbytes: rdna_stamp_nbytes(), ok: false }
    }
    if arch == arch_agx() {
        return SiImage { ptr: 0 as *mut u8, nbytes: agx_stamp_nbytes(), ok: false }
    }
    SiImage { ptr: 0 as *mut u8, nbytes: 0, ok: false }
}

pub fn si_fma(arch: i64, addend_bits: i64) -> SiImage with Alloc, Mut, Div {
    if arch == arch_sm89() {
        return SiImage { ptr: sm89_fma_image(addend_bits), nbytes: sm89_fma_nbytes(), ok: true }
