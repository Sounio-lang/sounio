// Resident Llama forward. One launch, M = 1..8.
// Column owners walk K so each B element is read once and reused
// across the M rows. Grid barriers are sense-reversing atomics;
// the launch grid must stay resident on the L4.
.version 7.8
.target sm_80
.address_size 64

.visible .global .align 4 .u32 g_pos;
.visible .global .align 4 .u32 g_bar_count;
.visible .global .align 4 .u32 g_bar_sense;

.func gemv(
    .param .b64 pa,
    .param .b64 pb,
    .param .b64 pc,
    .param .b32 pm,
    .param .b32 pn,
    .param .b32 pk
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<10>;
    .reg .f32 %a;
    .reg .f32 %b<16>;
    .reg .f32 %c<32>;

    ld.param.b64 %rd0, [pa];
    ld.param.b64 %rd1, [pb];
    ld.param.b64 %rd2, [pc];
    ld.param.b32 %r5, [pm];
    ld.param.b32 %r6, [pn];
    ld.param.b32 %r7, [pk];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %nctaid.x;
    mad.lo.u32 %r4, %r1, %r2, %r0;
    mul.lo.u32 %r4, %r4, 4;
    mul.lo.u32 %r8, %r3, %r2;
    mul.lo.u32 %r8, %r8, 4;
COL:
    setp.ge.u32 %p0, %r4, %r6;
    @%p0 bra COLDONE;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mov.f32 %c4, 0f00000000;
    mov.f32 %c5, 0f00000000;
    mov.f32 %c6, 0f00000000;
    mov.f32 %c7, 0f00000000;
    mov.f32 %c8, 0f00000000;
    mov.f32 %c9, 0f00000000;
    mov.f32 %c10, 0f00000000;
    mov.f32 %c11, 0f00000000;
    mov.f32 %c12, 0f00000000;
    mov.f32 %c13, 0f00000000;
    mov.f32 %c14, 0f00000000;
    mov.f32 %c15, 0f00000000;
    mov.f32 %c16, 0f00000000;
    mov.f32 %c17, 0f00000000;
    mov.f32 %c18, 0f00000000;
    mov.f32 %c19, 0f00000000;
    mov.f32 %c20, 0f00000000;
    mov.f32 %c21, 0f00000000;
    mov.f32 %c22, 0f00000000;
    mov.f32 %c23, 0f00000000;
    mov.f32 %c24, 0f00000000;
    mov.f32 %c25, 0f00000000;
    mov.f32 %c26, 0f00000000;
    mov.f32 %c27, 0f00000000;
    mov.f32 %c28, 0f00000000;
    mov.f32 %c29, 0f00000000;
    mov.f32 %c30, 0f00000000;
    mov.f32 %c31, 0f00000000;
    mov.u32 %r9, 0;
KLOOP:
    setp.ge.u32 %p1, %r9, %r7;
    @%p1 bra KDONE;
    mul.lo.u32 %r10, %r9, %r6;
    add.u32 %r10, %r10, %r4;
    cvt.u64.u32 %rd3, %r10;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd1, %rd3;
    cvt.u64.u32 %rd5, %r6;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd6, %rd3, %rd5;
    add.u64 %rd7, %rd6, %rd5;
    add.u64 %rd8, %rd7, %rd5;
    ld.global.cs.v4.f32 {%b0, %b1, %b2, %b3}, [%rd3];
    ld.global.cs.v4.f32 {%b4, %b5, %b6, %b7}, [%rd6];
    ld.global.cs.v4.f32 {%b8, %b9, %b10, %b11}, [%rd7];
    ld.global.cs.v4.f32 {%b12, %b13, %b14, %b15}, [%rd8];
    cvt.u64.u32 %rd5, %r7;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u32 %r10, %r9, 0;
    cvt.u64.u32 %rd4, %r10;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd4, %rd0, %rd4;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c0, %a, %b0, %c0;
    fma.rn.f32 %c1, %a, %b1, %c1;
    fma.rn.f32 %c2, %a, %b2, %c2;
    fma.rn.f32 %c3, %a, %b3, %c3;
    setp.le.u32 %p2, %r5, 1;
    @%p2 bra K0;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c4, %a, %b0, %c4;
    fma.rn.f32 %c5, %a, %b1, %c5;
    fma.rn.f32 %c6, %a, %b2, %c6;
    fma.rn.f32 %c7, %a, %b3, %c7;
    setp.le.u32 %p2, %r5, 2;
    @%p2 bra K0;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c8, %a, %b0, %c8;
    fma.rn.f32 %c9, %a, %b1, %c9;
    fma.rn.f32 %c10, %a, %b2, %c10;
    fma.rn.f32 %c11, %a, %b3, %c11;
    setp.le.u32 %p2, %r5, 3;
    @%p2 bra K0;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c12, %a, %b0, %c12;
    fma.rn.f32 %c13, %a, %b1, %c13;
    fma.rn.f32 %c14, %a, %b2, %c14;
    fma.rn.f32 %c15, %a, %b3, %c15;
    setp.le.u32 %p2, %r5, 4;
    @%p2 bra K0;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c16, %a, %b0, %c16;
    fma.rn.f32 %c17, %a, %b1, %c17;
    fma.rn.f32 %c18, %a, %b2, %c18;
    fma.rn.f32 %c19, %a, %b3, %c19;
    setp.le.u32 %p2, %r5, 5;
    @%p2 bra K0;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c20, %a, %b0, %c20;
    fma.rn.f32 %c21, %a, %b1, %c21;
    fma.rn.f32 %c22, %a, %b2, %c22;
    fma.rn.f32 %c23, %a, %b3, %c23;
    setp.le.u32 %p2, %r5, 6;
    @%p2 bra K0;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c24, %a, %b0, %c24;
    fma.rn.f32 %c25, %a, %b1, %c25;
    fma.rn.f32 %c26, %a, %b2, %c26;
    fma.rn.f32 %c27, %a, %b3, %c27;
    setp.le.u32 %p2, %r5, 7;
    @%p2 bra K0;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c28, %a, %b0, %c28;
    fma.rn.f32 %c29, %a, %b1, %c29;
    fma.rn.f32 %c30, %a, %b2, %c30;
    fma.rn.f32 %c31, %a, %b3, %c31;
K0:
    add.u32 %r10, %r9, 1;
    cvt.u64.u32 %rd4, %r10;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd4, %rd0, %rd4;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c0, %a, %b4, %c0;
    fma.rn.f32 %c1, %a, %b5, %c1;
    fma.rn.f32 %c2, %a, %b6, %c2;
    fma.rn.f32 %c3, %a, %b7, %c3;
    setp.le.u32 %p2, %r5, 1;
    @%p2 bra K1;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c4, %a, %b4, %c4;
    fma.rn.f32 %c5, %a, %b5, %c5;
    fma.rn.f32 %c6, %a, %b6, %c6;
    fma.rn.f32 %c7, %a, %b7, %c7;
    setp.le.u32 %p2, %r5, 2;
    @%p2 bra K1;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c8, %a, %b4, %c8;
    fma.rn.f32 %c9, %a, %b5, %c9;
    fma.rn.f32 %c10, %a, %b6, %c10;
    fma.rn.f32 %c11, %a, %b7, %c11;
    setp.le.u32 %p2, %r5, 3;
    @%p2 bra K1;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c12, %a, %b4, %c12;
    fma.rn.f32 %c13, %a, %b5, %c13;
    fma.rn.f32 %c14, %a, %b6, %c14;
    fma.rn.f32 %c15, %a, %b7, %c15;
    setp.le.u32 %p2, %r5, 4;
    @%p2 bra K1;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c16, %a, %b4, %c16;
    fma.rn.f32 %c17, %a, %b5, %c17;
    fma.rn.f32 %c18, %a, %b6, %c18;
    fma.rn.f32 %c19, %a, %b7, %c19;
    setp.le.u32 %p2, %r5, 5;
    @%p2 bra K1;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c20, %a, %b4, %c20;
    fma.rn.f32 %c21, %a, %b5, %c21;
    fma.rn.f32 %c22, %a, %b6, %c22;
    fma.rn.f32 %c23, %a, %b7, %c23;
    setp.le.u32 %p2, %r5, 6;
    @%p2 bra K1;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c24, %a, %b4, %c24;
    fma.rn.f32 %c25, %a, %b5, %c25;
    fma.rn.f32 %c26, %a, %b6, %c26;
    fma.rn.f32 %c27, %a, %b7, %c27;
    setp.le.u32 %p2, %r5, 7;
    @%p2 bra K1;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c28, %a, %b4, %c28;
    fma.rn.f32 %c29, %a, %b5, %c29;
    fma.rn.f32 %c30, %a, %b6, %c30;
    fma.rn.f32 %c31, %a, %b7, %c31;
K1:
    add.u32 %r10, %r9, 2;
    cvt.u64.u32 %rd4, %r10;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd4, %rd0, %rd4;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c0, %a, %b8, %c0;
    fma.rn.f32 %c1, %a, %b9, %c1;
    fma.rn.f32 %c2, %a, %b10, %c2;
    fma.rn.f32 %c3, %a, %b11, %c3;
    setp.le.u32 %p2, %r5, 1;
    @%p2 bra K2;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c4, %a, %b8, %c4;
    fma.rn.f32 %c5, %a, %b9, %c5;
    fma.rn.f32 %c6, %a, %b10, %c6;
    fma.rn.f32 %c7, %a, %b11, %c7;
    setp.le.u32 %p2, %r5, 2;
    @%p2 bra K2;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c8, %a, %b8, %c8;
    fma.rn.f32 %c9, %a, %b9, %c9;
    fma.rn.f32 %c10, %a, %b10, %c10;
    fma.rn.f32 %c11, %a, %b11, %c11;
    setp.le.u32 %p2, %r5, 3;
    @%p2 bra K2;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c12, %a, %b8, %c12;
    fma.rn.f32 %c13, %a, %b9, %c13;
    fma.rn.f32 %c14, %a, %b10, %c14;
    fma.rn.f32 %c15, %a, %b11, %c15;
    setp.le.u32 %p2, %r5, 4;
    @%p2 bra K2;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c16, %a, %b8, %c16;
    fma.rn.f32 %c17, %a, %b9, %c17;
    fma.rn.f32 %c18, %a, %b10, %c18;
    fma.rn.f32 %c19, %a, %b11, %c19;
    setp.le.u32 %p2, %r5, 5;
    @%p2 bra K2;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c20, %a, %b8, %c20;
    fma.rn.f32 %c21, %a, %b9, %c21;
    fma.rn.f32 %c22, %a, %b10, %c22;
    fma.rn.f32 %c23, %a, %b11, %c23;
    setp.le.u32 %p2, %r5, 6;
    @%p2 bra K2;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c24, %a, %b8, %c24;
    fma.rn.f32 %c25, %a, %b9, %c25;
    fma.rn.f32 %c26, %a, %b10, %c26;
    fma.rn.f32 %c27, %a, %b11, %c27;
    setp.le.u32 %p2, %r5, 7;
    @%p2 bra K2;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c28, %a, %b8, %c28;
    fma.rn.f32 %c29, %a, %b9, %c29;
    fma.rn.f32 %c30, %a, %b10, %c30;
    fma.rn.f32 %c31, %a, %b11, %c31;
K2:
    add.u32 %r10, %r9, 3;
    cvt.u64.u32 %rd4, %r10;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd4, %rd0, %rd4;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c0, %a, %b12, %c0;
    fma.rn.f32 %c1, %a, %b13, %c1;
    fma.rn.f32 %c2, %a, %b14, %c2;
    fma.rn.f32 %c3, %a, %b15, %c3;
    setp.le.u32 %p2, %r5, 1;
    @%p2 bra K3;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c4, %a, %b12, %c4;
    fma.rn.f32 %c5, %a, %b13, %c5;
    fma.rn.f32 %c6, %a, %b14, %c6;
    fma.rn.f32 %c7, %a, %b15, %c7;
    setp.le.u32 %p2, %r5, 2;
    @%p2 bra K3;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c8, %a, %b12, %c8;
    fma.rn.f32 %c9, %a, %b13, %c9;
    fma.rn.f32 %c10, %a, %b14, %c10;
    fma.rn.f32 %c11, %a, %b15, %c11;
    setp.le.u32 %p2, %r5, 3;
    @%p2 bra K3;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c12, %a, %b12, %c12;
    fma.rn.f32 %c13, %a, %b13, %c13;
    fma.rn.f32 %c14, %a, %b14, %c14;
    fma.rn.f32 %c15, %a, %b15, %c15;
    setp.le.u32 %p2, %r5, 4;
    @%p2 bra K3;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c16, %a, %b12, %c16;
    fma.rn.f32 %c17, %a, %b13, %c17;
    fma.rn.f32 %c18, %a, %b14, %c18;
    fma.rn.f32 %c19, %a, %b15, %c19;
    setp.le.u32 %p2, %r5, 5;
    @%p2 bra K3;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c20, %a, %b12, %c20;
    fma.rn.f32 %c21, %a, %b13, %c21;
    fma.rn.f32 %c22, %a, %b14, %c22;
    fma.rn.f32 %c23, %a, %b15, %c23;
    setp.le.u32 %p2, %r5, 6;
    @%p2 bra K3;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c24, %a, %b12, %c24;
    fma.rn.f32 %c25, %a, %b13, %c25;
    fma.rn.f32 %c26, %a, %b14, %c26;
    fma.rn.f32 %c27, %a, %b15, %c27;
    setp.le.u32 %p2, %r5, 7;
    @%p2 bra K3;
    add.u64 %rd4, %rd4, %rd5;
    ld.global.ca.f32 %a, [%rd4];
    fma.rn.f32 %c28, %a, %b12, %c28;
    fma.rn.f32 %c29, %a, %b13, %c29;
    fma.rn.f32 %c30, %a, %b14, %c30;
    fma.rn.f32 %c31, %a, %b15, %c31;
K3:
    add.u32 %r9, %r9, 4;
    bra KLOOP;
KDONE:
    cvt.u64.u32 %rd3, %r4;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd2, %rd3;
    st.global.v4.f32 [%rd3], {%c0, %c1, %c2, %c3};
    setp.le.u32 %p2, %r5, 1;
    @%p2 bra CNEXT;
    cvt.u64.u32 %rd4, %r6;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd3, %rd3, %rd4;
    st.global.v4.f32 [%rd3], {%c4, %c5, %c6, %c7};
    setp.le.u32 %p2, %r5, 2;
    @%p2 bra CNEXT;
    add.u64 %rd3, %rd3, %rd4;
    st.global.v4.f32 [%rd3], {%c8, %c9, %c10, %c11};
    setp.le.u32 %p2, %r5, 3;
    @%p2 bra CNEXT;
    add.u64 %rd3, %rd3, %rd4;
    st.global.v4.f32 [%rd3], {%c12, %c13, %c14, %c15};
    setp.le.u32 %p2, %r5, 4;
    @%p2 bra CNEXT;
    add.u64 %rd3, %rd3, %rd4;
    st.global.v4.f32 [%rd3], {%c16, %c17, %c18, %c19};
    setp.le.u32 %p2, %r5, 5;
    @%p2 bra CNEXT;
    add.u64 %rd3, %rd3, %rd4;
    st.global.v4.f32 [%rd3], {%c20, %c21, %c22, %c23};
    setp.le.u32 %p2, %r5, 6;
    @%p2 bra CNEXT;
    add.u64 %rd3, %rd3, %rd4;
    st.global.v4.f32 [%rd3], {%c24, %c25, %c26, %c27};
    setp.le.u32 %p2, %r5, 7;
    @%p2 bra CNEXT;
    add.u64 %rd3, %rd3, %rd4;
    st.global.v4.f32 [%rd3], {%c28, %c29, %c30, %c31};
CNEXT:
    add.u32 %r4, %r4, %r8;
    bra COL;
COLDONE:
    ret;
}



.visible .entry fwd_resident(
    .param .u64 p_tab,
    .param .u64 p_x,
    .param .u64 p_h,
    .param .u64 p_q,
    .param .u64 p_k,
    .param .u64 p_v,
    .param .u64 p_att,
    .param .u64 p_o,
    .param .u64 p_g,
    .param .u64 p_u,
    .param .u64 p_act,
    .param .u64 p_logf,
    .param .u64 p_logd,
    .param .u64 p_ids,
    .param .s32 p_M,
    .param .s32 p_hidden,
    .param .s32 p_inter,
    .param .s32 p_qdim,
    .param .s32 p_kvdim,
    .param .s32 p_heads,
    .param .s32 p_kvh,
    .param .s32 p_dh,
    .param .s32 p_layers,
    .param .s32 p_vocab,
    .param .f32 p_eps,
    .param .f32 p_scale
)
{
    .shared .align 4 .u32 lsense;
    .shared .align 4 .b8 red[1024];
    .reg .pred %p<6>;
