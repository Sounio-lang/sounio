// One lean launch per Llama layer, M = 1.
// GEMV is four coalesced columns and four accumulators.
// Eight K addresses are ready before those loads.
// The grid is the resident occupancy reported by the driver.
// Block size is 128. A larger grid deadlocks the barrier.
.version 7.8
.target sm_80
.address_size 64

.visible .global .align 4 .u32 g_pos;
.visible .global .align 4 .u32 g_bar_count;
.visible .global .align 4 .u32 g_bar_sense;

.func gemv1(
    .param .b64 pa,
    .param .b64 pb,
    .param .b64 pc,
    .param .b32 pn,
    .param .b32 pk
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<12>;
    .reg .f32 %a;
    .reg .f32 %b<32>;
    .reg .f32 %c<4>;
    ld.param.b64 %rd0, [pa];
    ld.param.b64 %rd1, [pb];
    ld.param.b64 %rd2, [pc];
    ld.param.b32 %r6, [pn];
    ld.param.b32 %r7, [pk];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %nctaid.x;
    mad.lo.u32 %r4, %r1, %r2, %r0;
    mul.lo.u32 %r4, %r4, 4;
    mul.lo.u32 %r8, %r3, %r2;
    mul.lo.u32 %r8, %r8, 4;
COL:
    setp.ge.u32 %p0, %r4, %r6;
    @%p0 bra COLDONE;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mov.u32 %r9, 0;
KLOOP:
    setp.ge.u32 %p0, %r9, %r7;
    @%p0 bra KDONE;
    add.u32 %r10, %r9, 0;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd3, %r11;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd1, %rd3;
    add.u32 %r10, %r9, 1;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd4, %r11;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd4, %rd1, %rd4;
    add.u32 %r10, %r9, 2;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd5, %r11;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd1, %rd5;
    add.u32 %r10, %r9, 3;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd6, %r11;
    mul.lo.u64 %rd6, %rd6, 4;
    add.u64 %rd6, %rd1, %rd6;
    add.u32 %r10, %r9, 4;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd7, %r11;
    mul.lo.u64 %rd7, %rd7, 4;
    add.u64 %rd7, %rd1, %rd7;
    add.u32 %r10, %r9, 5;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd8, %r11;
    mul.lo.u64 %rd8, %rd8, 4;
    add.u64 %rd8, %rd1, %rd8;
    add.u32 %r10, %r9, 6;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd9, %r11;
    mul.lo.u64 %rd9, %rd9, 4;
    add.u64 %rd9, %rd1, %rd9;
    add.u32 %r10, %r9, 7;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd10, %r11;
    mul.lo.u64 %rd10, %rd10, 4;
    add.u64 %rd10, %rd1, %rd10;
    ld.global.cs.v4.f32 {%b0, %b1, %b2, %b3}, [%rd3];
    ld.global.cs.v4.f32 {%b4, %b5, %b6, %b7}, [%rd4];
    ld.global.cs.v4.f32 {%b8, %b9, %b10, %b11}, [%rd5];
    ld.global.cs.v4.f32 {%b12, %b13, %b14, %b15}, [%rd6];
    ld.global.cs.v4.f32 {%b16, %b17, %b18, %b19}, [%rd7];
    ld.global.cs.v4.f32 {%b20, %b21, %b22, %b23}, [%rd8];
    ld.global.cs.v4.f32 {%b24, %b25, %b26, %b27}, [%rd9];
    ld.global.cs.v4.f32 {%b28, %b29, %b30, %b31}, [%rd10];
    cvt.u64.u32 %rd3, %r9;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd0, %rd3;
    ld.global.ca.f32 %a, [%rd3+0];
    fma.rn.f32 %c0, %a, %b0, %c0;
    fma.rn.f32 %c1, %a, %b1, %c1;
    fma.rn.f32 %c2, %a, %b2, %c2;
    fma.rn.f32 %c3, %a, %b3, %c3;
    ld.global.ca.f32 %a, [%rd3+4];
    fma.rn.f32 %c0, %a, %b4, %c0;
    fma.rn.f32 %c1, %a, %b5, %c1;
    fma.rn.f32 %c2, %a, %b6, %c2;
    fma.rn.f32 %c3, %a, %b7, %c3;
    ld.global.ca.f32 %a, [%rd3+8];
    fma.rn.f32 %c0, %a, %b8, %c0;
    fma.rn.f32 %c1, %a, %b9, %c1;
    fma.rn.f32 %c2, %a, %b10, %c2;
    fma.rn.f32 %c3, %a, %b11, %c3;
    ld.global.ca.f32 %a, [%rd3+12];
    fma.rn.f32 %c0, %a, %b12, %c0;
    fma.rn.f32 %c1, %a, %b13, %c1;
    fma.rn.f32 %c2, %a, %b14, %c2;
    fma.rn.f32 %c3, %a, %b15, %c3;
    ld.global.ca.f32 %a, [%rd3+16];
    fma.rn.f32 %c0, %a, %b16, %c0;
    fma.rn.f32 %c1, %a, %b17, %c1;
    fma.rn.f32 %c2, %a, %b18, %c2;
    fma.rn.f32 %c3, %a, %b19, %c3;
    ld.global.ca.f32 %a, [%rd3+20];
    fma.rn.f32 %c0, %a, %b20, %c0;
    fma.rn.f32 %c1, %a, %b21, %c1;
    fma.rn.f32 %c2, %a, %b22, %c2;
    fma.rn.f32 %c3, %a, %b23, %c3;
    ld.global.ca.f32 %a, [%rd3+24];
    fma.rn.f32 %c0, %a, %b24, %c0;
    fma.rn.f32 %c1, %a, %b25, %c1;
    fma.rn.f32 %c2, %a, %b26, %c2;
    fma.rn.f32 %c3, %a, %b27, %c3;
    ld.global.ca.f32 %a, [%rd3+28];
    fma.rn.f32 %c0, %a, %b28, %c0;
    fma.rn.f32 %c1, %a, %b29, %c1;
    fma.rn.f32 %c2, %a, %b30, %c2;
    fma.rn.f32 %c3, %a, %b31, %c3;
    add.u32 %r9, %r9, 8;
    bra KLOOP;
KDONE:
    cvt.u64.u32 %rd3, %r4;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd2, %rd3;
    st.global.v4.f32 [%rd3], {%c0, %c1, %c2, %c3};
    add.u32 %r4, %r4, %r8;
    bra COL;
COLDONE:
    ret;
}

.func gemv1_f64(
    .param .b64 pa,
    .param .b64 pb,
    .param .b64 pc,
    .param .b32 pn,
    .param .b32 pk
)
{
    .reg .pred %p<2>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<12>;
    .reg .f32 %a;
    .reg .f32 %b<32>;
    .reg .f32 %c<4>;
    .reg .f64 %fd<1>;
    ld.param.b64 %rd0, [pa];
    ld.param.b64 %rd1, [pb];
    ld.param.b64 %rd2, [pc];
    ld.param.b32 %r6, [pn];
    ld.param.b32 %r7, [pk];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %nctaid.x;
    mad.lo.u32 %r4, %r1, %r2, %r0;
    mul.lo.u32 %r4, %r4, 4;
    mul.lo.u32 %r8, %r3, %r2;
    mul.lo.u32 %r8, %r8, 4;
COL:
    setp.ge.u32 %p0, %r4, %r6;
    @%p0 bra COLDONE;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mov.u32 %r9, 0;
KLOOP:
    setp.ge.u32 %p0, %r9, %r7;
    @%p0 bra KDONE;
    add.u32 %r10, %r9, 0;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd3, %r11;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd1, %rd3;
    add.u32 %r10, %r9, 1;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd4, %r11;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd4, %rd1, %rd4;
    add.u32 %r10, %r9, 2;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd5, %r11;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd1, %rd5;
    add.u32 %r10, %r9, 3;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd6, %r11;
    mul.lo.u64 %rd6, %rd6, 4;
    add.u64 %rd6, %rd1, %rd6;
    add.u32 %r10, %r9, 4;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd7, %r11;
    mul.lo.u64 %rd7, %rd7, 4;
    add.u64 %rd7, %rd1, %rd7;
    add.u32 %r10, %r9, 5;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd8, %r11;
    mul.lo.u64 %rd8, %rd8, 4;
    add.u64 %rd8, %rd1, %rd8;
    add.u32 %r10, %r9, 6;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd9, %r11;
    mul.lo.u64 %rd9, %rd9, 4;
    add.u64 %rd9, %rd1, %rd9;
    add.u32 %r10, %r9, 7;
    mul.lo.u32 %r11, %r10, %r6;
    add.u32 %r11, %r11, %r4;
    cvt.u64.u32 %rd10, %r11;
    mul.lo.u64 %rd10, %rd10, 4;
    add.u64 %rd10, %rd1, %rd10;
    ld.global.cs.v4.f32 {%b0, %b1, %b2, %b3}, [%rd3];
    ld.global.cs.v4.f32 {%b4, %b5, %b6, %b7}, [%rd4];
    ld.global.cs.v4.f32 {%b8, %b9, %b10, %b11}, [%rd5];
    ld.global.cs.v4.f32 {%b12, %b13, %b14, %b15}, [%rd6];
    ld.global.cs.v4.f32 {%b16, %b17, %b18, %b19}, [%rd7];
    ld.global.cs.v4.f32 {%b20, %b21, %b22, %b23}, [%rd8];
    ld.global.cs.v4.f32 {%b24, %b25, %b26, %b27}, [%rd9];
    ld.global.cs.v4.f32 {%b28, %b29, %b30, %b31}, [%rd10];
    cvt.u64.u32 %rd3, %r9;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd0, %rd3;
    ld.global.ca.f32 %a, [%rd3+0];
    fma.rn.f32 %c0, %a, %b0, %c0;
    fma.rn.f32 %c1, %a, %b1, %c1;
    fma.rn.f32 %c2, %a, %b2, %c2;
    fma.rn.f32 %c3, %a, %b3, %c3;
    ld.global.ca.f32 %a, [%rd3+4];
    fma.rn.f32 %c0, %a, %b4, %c0;
    fma.rn.f32 %c1, %a, %b5, %c1;
    fma.rn.f32 %c2, %a, %b6, %c2;
    fma.rn.f32 %c3, %a, %b7, %c3;
    ld.global.ca.f32 %a, [%rd3+8];
    fma.rn.f32 %c0, %a, %b8, %c0;
    fma.rn.f32 %c1, %a, %b9, %c1;
    fma.rn.f32 %c2, %a, %b10, %c2;
    fma.rn.f32 %c3, %a, %b11, %c3;
    ld.global.ca.f32 %a, [%rd3+12];
    fma.rn.f32 %c0, %a, %b12, %c0;
    fma.rn.f32 %c1, %a, %b13, %c1;
    fma.rn.f32 %c2, %a, %b14, %c2;
    fma.rn.f32 %c3, %a, %b15, %c3;
    ld.global.ca.f32 %a, [%rd3+16];
    fma.rn.f32 %c0, %a, %b16, %c0;
    fma.rn.f32 %c1, %a, %b17, %c1;
    fma.rn.f32 %c2, %a, %b18, %c2;
    fma.rn.f32 %c3, %a, %b19, %c3;
    ld.global.ca.f32 %a, [%rd3+20];
    fma.rn.f32 %c0, %a, %b20, %c0;
    fma.rn.f32 %c1, %a, %b21, %c1;
    fma.rn.f32 %c2, %a, %b22, %c2;
    fma.rn.f32 %c3, %a, %b23, %c3;
    ld.global.ca.f32 %a, [%rd3+24];
    fma.rn.f32 %c0, %a, %b24, %c0;
    fma.rn.f32 %c1, %a, %b25, %c1;
    fma.rn.f32 %c2, %a, %b26, %c2;
    fma.rn.f32 %c3, %a, %b27, %c3;
    ld.global.ca.f32 %a, [%rd3+28];
    fma.rn.f32 %c0, %a, %b28, %c0;
    fma.rn.f32 %c1, %a, %b29, %c1;
    fma.rn.f32 %c2, %a, %b30, %c2;
    fma.rn.f32 %c3, %a, %b31, %c3;
    add.u32 %r9, %r9, 8;
    bra KLOOP;
KDONE:
    cvt.u64.u32 %rd3, %r4;
    mul.lo.u64 %rd3, %rd3, 8;
    add.u64 %rd3, %rd2, %rd3;
    cvt.f64.f32 %fd0, %c0;
    st.global.f64 [%rd3+0], %fd0;
    cvt.f64.f32 %fd0, %c1;
    st.global.f64 [%rd3+8], %fd0;
    cvt.f64.f32 %fd0, %c2;
    st.global.f64 [%rd3+16], %fd0;
    cvt.f64.f32 %fd0, %c3;
    st.global.f64 [%rd3+24], %fd0;
    add.u32 %r4, %r4, %r8;
    bra COL;
COLDONE:
    ret;
}


.visible .entry layer_m1(
    .param .u64 p_x,
    .param .u64 p_h,
    .param .u64 p_q,
    .param .u64 p_k,
    .param .u64 p_v,
    .param .u64 p_att,
    .param .u64 p_o,
    .param .u64 p_g,
    .param .u64 p_u,
    .param .u64 p_act,
    .param .u64 p_wq,
    .param .u64 p_wk,
    .param .u64 p_wv,
    .param .u64 p_wo,
    .param .u64 p_gate,
    .param .u64 p_up,
    .param .u64 p_down,
    .param .u64 p_inn,
    .param .u64 p_post,
    .param .u64 p_kc,
    .param .u64 p_vc,
    .param .u64 p_cos,
    .param .u64 p_sin,
    .param .u64 p_embed,
    .param .u64 p_ids,
    .param .s32 p_embed_on,
    .param .s32 p_hidden,
    .param .s32 p_inter,
    .param .s32 p_qdim,
    .param .s32 p_kvdim,
    .param .s32 p_heads,
    .param .s32 p_kvh,
    .param .s32 p_dh,
    .param .f32 p_eps,
    .param .f32 p_scale
)
{
    .shared .align 4 .u32 lsense;
    .shared .align 4 .b8 red[512];
    .param .b64 _pa;
    .param .b64 _pb;
    .param .b64 _pc;
    .param .b32 _pn;
    .param .b32 _pk;
    .reg .pred %p<6>;
    .reg .b32 %r<40>;
    .reg .b64 %rd<32>;
    .reg .f32 %f<12>;
    .reg .f64 %fd<2>;

    ld.param.u64 %rd20, [p_x];
    ld.param.u64 %rd21, [p_h];
    ld.param.u64 %rd22, [p_q];
    ld.param.u64 %rd23, [p_k];
    ld.param.u64 %rd24, [p_v];
    ld.param.u64 %rd25, [p_att];
    ld.param.u64 %rd26, [p_o];
    ld.param.u64 %rd27, [p_g];
    ld.param.u64 %rd28, [p_u];
    ld.param.u64 %rd29, [p_act];
    ld.param.u64 %rd30, [p_cos];
    ld.param.u64 %rd31, [p_sin];
    ld.param.s32 %r1, [p_hidden];
    ld.param.s32 %r2, [p_inter];
    ld.param.s32 %r3, [p_qdim];
    ld.param.s32 %r4, [p_kvdim];
    ld.param.s32 %r5, [p_heads];
    ld.param.s32 %r6, [p_kvh];
    ld.param.s32 %r7, [p_dh];
    ld.param.f32 %f6, [p_eps];
    ld.param.f32 %f7, [p_scale];
    mov.u32 %r10, %tid.x;
    mov.u32 %r11, %ctaid.x;
    mov.u32 %r12, %ntid.x;
    mov.u32 %r13, red;
    setp.ne.u32 %p0, %r10, 0;
    @%p0 bra SINIT;
    mov.u32 %r14, 1;
    st.shared.u32 [lsense], %r14;
SINIT:
    bar.sync 0;

    ld.param.s32 %r15, [p_embed_on];
    setp.eq.s32 %p0, %r15, 0;
    @%p0 bra EMBSKIP;
    ld.param.u64 %rd16, [p_ids];
    ld.global.f64 %fd0, [%rd16];
    cvt.rzi.s32.f64 %r18, %fd0;
    mul.lo.u32 %r18, %r18, %r1;
    ld.param.u64 %rd17, [p_embed];
    mad.lo.u32 %r23, %r11, %r12, %r10;
    mov.u32 %r24, %nctaid.x;
    mul.lo.u32 %r24, %r24, %r12;
EMB:
    setp.ge.u32 %p1, %r23, %r1;
    @%p1 bra EMBSKIP;
    add.u32 %r19, %r18, %r23;
    cvt.u64.u32 %rd15, %r19;
    mul.lo.u64 %rd15, %rd15, 4;
    add.u64 %rd15, %rd17, %rd15;
    ld.global.f32 %f0, [%rd15];
    cvt.u64.u32 %rd15, %r23;
    mul.lo.u64 %rd15, %rd15, 4;
    add.u64 %rd15, %rd20, %rd15;
    st.global.f32 [%rd15], %f0;
    add.u32 %r23, %r23, %r24;
    bra EMB;
EMBSKIP:
    membar.gl;
    bar.sync 0;
    mov.u32 %r28, %tid.x;
    setp.ne.u32 %p0, %r28, 0;
    @%p0 bra $gs1;
    ld.shared.u32 %r28, [lsense];
    mov.u64 %rd14, g_bar_count;
    atom.global.add.u32 %r31, [%rd14], 1;
    mov.u32 %r29, %nctaid.x;
    sub.u32 %r29, %r29, 1;
    setp.ne.u32 %p1, %r31, %r29;
    @%p1 bra $gw1;
    mov.u32 %r30, 0;
    st.global.u32 [g_bar_count], %r30;
    membar.gl;
    st.global.u32 [g_bar_sense], %r28;
    bra $gd1;
$gw1:
    ld.volatile.global.u32 %r30, [g_bar_sense];
    setp.ne.u32 %p1, %r30, %r28;
    @%p1 bra $gw1;
$gd1:
    xor.b32 %r28, %r28, 1;
    st.shared.u32 [lsense], %r28;
$gs1:
    bar.sync 0;

    setp.ne.u32 %p0, %r11, 0;
    @%p0 bra RMS1S;
    ld.param.u64 %rd19, [p_inn];
    mov.f32 %f0, 0f00000000;
    mov.u32 %r23, %r10;
$na:
    setp.ge.u32 %p2, %r23, %r1;
    @%p2 bra $nda;
