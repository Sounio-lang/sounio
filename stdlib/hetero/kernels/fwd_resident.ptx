// One launch per token. Grid is 58 blocks of 256 threads, one per SM.
// Each block owns a slice of K and writes a partial. After the grid
// barrier the blocks reduce their column stripes. No .maxnreg.
.version 7.8
.target sm_80
.address_size 64

.visible .global .align 4 .u32 g_pos;
.visible .global .align 4 .u32 g_bar_count;
.visible .global .align 4 .u32 g_bar_sense;

.func gemv_split(
    .param .b64 pa,
    .param .b64 pb,
    .param .b64 pp,
    .param .b32 pn,
    .param .b32 pk,
    .param .b32 ps
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<6>;
    .reg .f32 %a;
    .reg .f32 %b<4>;
    .reg .f32 %c<4>;
    ld.param.b64 %rd0, [pa];
    ld.param.b64 %rd1, [pb];
    ld.param.b64 %rd2, [pp];
    ld.param.b32 %r5, [pn];
    ld.param.b32 %r6, [pk];
    ld.param.b32 %r7, [ps];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %nctaid.x;
    add.u32 %r8, %r6, %r3;
    sub.u32 %r8, %r8, 1;
    div.u32 %r8, %r8, %r3;
    mul.lo.u32 %r9, %r1, %r8;
    add.u32 %r10, %r9, %r8;
    setp.gt.u32 %p0, %r10, %r6;
    @%p0 mov.u32 %r10, %r6;
    mul.lo.u32 %r4, %r0, 4;
    mul.lo.u32 %r11, %r2, 4;
    cvt.u64.u32 %rd3, %r1;
    cvt.u64.u32 %rd4, %r7;
    mul.lo.u64 %rd3, %rd3, %rd4;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd2, %rd3;
COL:
    setp.ge.u32 %p0, %r4, %r5;
    @%p0 bra COLDONE;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mov.u32 %r12, %r9;
K:
    setp.ge.u32 %p1, %r12, %r10;
    @%p1 bra ST;
    cvt.u64.u32 %rd5, %r12;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd0, %rd5;
    ld.global.ca.f32 %a, [%rd5];
    mul.lo.u32 %r13, %r12, %r5;
    add.u32 %r13, %r13, %r4;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd1, %rd5;
    ld.global.cs.v4.f32 {%b0, %b1, %b2, %b3}, [%rd5];
    fma.rn.f32 %c0, %a, %b0, %c0;
    fma.rn.f32 %c1, %a, %b1, %c1;
    fma.rn.f32 %c2, %a, %b2, %c2;
    fma.rn.f32 %c3, %a, %b3, %c3;
    add.u32 %r12, %r12, 1;
    bra K;
ST:
    cvt.u64.u32 %rd5, %r4;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd3, %rd5;
    st.global.v4.f32 [%rd5], {%c0, %c1, %c2, %c3};
    add.u32 %r4, %r4, %r11;
    bra COL;
COLDONE:
    ret;
}

.func gemv_reduce(
    .param .b64 pp,
    .param .b64 pc,
    .param .b32 pn,
    .param .b32 ps
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<6>;
    .reg .f32 %b<4>;
    .reg .f32 %c<4>;
    ld.param.b64 %rd0, [pp];
    ld.param.b64 %rd1, [pc];
    ld.param.b32 %r5, [pn];
    ld.param.b32 %r6, [ps];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %nctaid.x;
    mad.lo.u32 %r4, %r1, %r2, %r0;
    mul.lo.u32 %r4, %r4, 4;
    mul.lo.u32 %r7, %r3, %r2;
    mul.lo.u32 %r7, %r7, 4;
COL:
    setp.ge.u32 %p0, %r4, %r5;
    @%p0 bra DONE;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mov.u32 %r8, 0;
B:
    setp.ge.u32 %p1, %r8, %r3;
    @%p1 bra ST;
    cvt.u64.u32 %rd2, %r8;
    cvt.u64.u32 %rd3, %r6;
    mul.lo.u64 %rd2, %rd2, %rd3;
    cvt.u64.u32 %rd3, %r4;
    add.u64 %rd2, %rd2, %rd3;
    mul.lo.u64 %rd2, %rd2, 4;
    add.u64 %rd2, %rd0, %rd2;
    ld.global.f32 %b0, [%rd2];
    ld.global.f32 %b1, [%rd2+4];
    ld.global.f32 %b2, [%rd2+8];
    ld.global.f32 %b3, [%rd2+12];
    add.f32 %c0, %c0, %b0;
    add.f32 %c1, %c1, %b1;
    add.f32 %c2, %c2, %b2;
    add.f32 %c3, %c3, %b3;
    add.u32 %r8, %r8, 1;
    bra B;
ST:
    cvt.u64.u32 %rd2, %r4;
    mul.lo.u64 %rd2, %rd2, 4;
    add.u64 %rd2, %rd1, %rd2;
    st.global.v4.f32 [%rd2], {%c0, %c1, %c2, %c3};
    add.u32 %r4, %r4, %r7;
    bra COL;
DONE:
    ret;
}

.func gemv_reduce_f64(
    .param .b64 pp,
    .param .b64 pc,
    .param .b32 pn,
    .param .b32 ps
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<6>;
    .reg .f32 %b<4>;
    .reg .f32 %c<4>;
    .reg .f64 %fd<1>;
    ld.param.b64 %rd0, [pp];
    ld.param.b64 %rd1, [pc];
    ld.param.b32 %r5, [pn];
    ld.param.b32 %r6, [ps];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %nctaid.x;
    mad.lo.u32 %r4, %r1, %r2, %r0;
    mul.lo.u32 %r4, %r4, 4;
    mul.lo.u32 %r7, %r3, %r2;
    mul.lo.u32 %r7, %r7, 4;
COL:
    setp.ge.u32 %p0, %r4, %r5;
    @%p0 bra DONE;
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mov.u32 %r8, 0;
B:
    setp.ge.u32 %p1, %r8, %r3;
    @%p1 bra ST;
    cvt.u64.u32 %rd2, %r8;
    cvt.u64.u32 %rd3, %r6;
    mul.lo.u64 %rd2, %rd2, %rd3;
    cvt.u64.u32 %rd3, %r4;
    add.u64 %rd2, %rd2, %rd3;
    mul.lo.u64 %rd2, %rd2, 4;
    add.u64 %rd2, %rd0, %rd2;
    ld.global.f32 %b0, [%rd2];
    ld.global.f32 %b1, [%rd2+4];
    ld.global.f32 %b2, [%rd2+8];
    ld.global.f32 %b3, [%rd2+12];
    add.f32 %c0, %c0, %b0;
    add.f32 %c1, %c1, %b1;
    add.f32 %c2, %c2, %b2;
    add.f32 %c3, %c3, %b3;
    add.u32 %r8, %r8, 1;
    bra B;
ST:
    cvt.u64.u32 %rd2, %r4;
    mul.lo.u64 %rd2, %rd2, 8;
    add.u64 %rd2, %rd1, %rd2;
    cvt.f64.f32 %fd0, %c0;
    st.global.f64 [%rd2+0], %fd0;
    cvt.f64.f32 %fd0, %c1;
    st.global.f64 [%rd2+8], %fd0;
    cvt.f64.f32 %fd0, %c2;
    st.global.f64 [%rd2+16], %fd0;
    cvt.f64.f32 %fd0, %c3;
    st.global.f64 [%rd2+24], %fd0;
    add.u32 %r4, %r4, %r7;
    bra COL;
DONE:
    ret;
}


.visible .entry token_m1(
    .param .u64 p_tab,
    .param .u64 p_x,
    .param .u64 p_h,
    .param .u64 p_q,
    .param .u64 p_k,
    .param .u64 p_v,
    .param .u64 p_att,
    .param .u64 p_o,
    .param .u64 p_g,
    .param .u64 p_u,
    .param .u64 p_act,
    .param .u64 p_part,
    .param .u64 p_logd,
    .param .u64 p_ids,
    .param .s32 p_hidden,
    .param .s32 p_inter,
    .param .s32 p_qdim,
    .param .s32 p_kvdim,
    .param .s32 p_heads,
    .param .s32 p_kvh,
    .param .s32 p_dh,
    .param .s32 p_layers,
    .param .s32 p_vocab,
    .param .f32 p_eps,
    .param .f32 p_scale
)
{
    .shared .align 4 .u32 lsense;
    .shared .align 4 .b8 red[1024];
    .param .b64 _pa;
    .param .b64 _pb;
    .param .b64 _pp;
    .param .b64 _pc;
    .param .b32 _pn;
    .param .b32 _pk;
    .param .b32 _ps;
    .reg .pred %p<6>;
    .reg .b32 %r<40>;
    .reg .b64 %rd<32>;
    .reg .f32 %f<12>;
    .reg .f64 %fd<2>;

    ld.param.u64 %rd10, [p_tab];
    ld.param.u64 %rd20, [p_x];
    ld.param.u64 %rd21, [p_h];
    ld.param.u64 %rd22, [p_q];
    ld.param.u64 %rd23, [p_k];
    ld.param.u64 %rd24, [p_v];
    ld.param.u64 %rd25, [p_att];
    ld.param.u64 %rd26, [p_o];
    ld.param.u64 %rd27, [p_g];
    ld.param.u64 %rd28, [p_u];
    ld.param.u64 %rd29, [p_act];
    ld.param.u64 %rd11, [p_part];
    ld.param.u64 %rd12, [p_logd];
    ld.param.s32 %r1, [p_hidden];
    ld.param.s32 %r2, [p_inter];
    ld.param.s32 %r3, [p_qdim];
    ld.param.s32 %r4, [p_kvdim];
    ld.param.s32 %r5, [p_heads];
    ld.param.s32 %r6, [p_kvh];
    ld.param.s32 %r7, [p_dh];
    ld.param.s32 %r8, [p_layers];
    ld.param.s32 %r9, [p_vocab];
    ld.param.f32 %f6, [p_eps];
    ld.param.f32 %f7, [p_scale];
    mov.u32 %r20, 3;
    cvt.u64.u32 %rd16, %r20;
    mul.lo.u64 %rd16, %rd16, 8;
    add.u64 %rd16, %rd10, %rd16;
    ld.global.u64 %rd30, [%rd16];
    mov.u32 %r20, 4;
    cvt.u64.u32 %rd16, %r20;
    mul.lo.u64 %rd16, %rd16, 8;
    add.u64 %rd16, %rd10, %rd16;
    ld.global.u64 %rd31, [%rd16];
    mov.u32 %r10, %tid.x;
    mov.u32 %r11, %ctaid.x;
    mov.u32 %r12, %ntid.x;
    mov.u32 %r13, red;
    setp.ne.u32 %p0, %r10, 0;
    @%p0 bra SINIT;
    mov.u32 %r14, 1;
    st.shared.u32 [lsense], %r14;
SINIT:
    bar.sync 0;
    mov.u32 %r15, 0;
LAYER:
    setp.ge.u32 %p0, %r15, %r8;
    @%p0 bra LAYD;
    setp.ne.u32 %p0, %r15, 0;
    @%p0 bra EMBSKIP;
    ld.param.u64 %rd16, [p_ids];
    ld.global.f64 %fd0, [%rd16];
    cvt.rzi.s32.f64 %r18, %fd0;
    mul.lo.u32 %r18, %r18, %r1;
    mov.u32 %r20, 0;
    cvt.u64.u32 %rd17, %r20;
    mul.lo.u64 %rd17, %rd17, 8;
    add.u64 %rd17, %rd10, %rd17;
    ld.global.u64 %rd17, [%rd17];
    mad.lo.u32 %r23, %r11, %r12, %r10;
    mov.u32 %r24, %nctaid.x;
    mul.lo.u32 %r24, %r24, %r12;
EMB:
    setp.ge.u32 %p1, %r23, %r1;
    @%p1 bra EMBSKIP;
    add.u32 %r19, %r18, %r23;
    cvt.u64.u32 %rd15, %r19;
    mul.lo.u64 %rd15, %rd15, 4;
    add.u64 %rd15, %rd17, %rd15;
    ld.global.f32 %f0, [%rd15];
    cvt.u64.u32 %rd15, %r23;
    mul.lo.u64 %rd15, %rd15, 4;
    add.u64 %rd15, %rd20, %rd15;
    st.global.f32 [%rd15], %f0;
    add.u32 %r23, %r23, %r24;
    bra EMB;
EMBSKIP:
    membar.gl;
    bar.sync 0;
    mov.u32 %r28, %tid.x;
    setp.ne.u32 %p0, %r28, 0;
    @%p0 bra $gs1;
    ld.shared.u32 %r28, [lsense];
    mov.u64 %rd14, g_bar_count;
    atom.global.add.u32 %r31, [%rd14], 1;
    mov.u32 %r29, %nctaid.x;
    sub.u32 %r29, %r29, 1;
    setp.ne.u32 %p1, %r31, %r29;
    @%p1 bra $gw1;
    mov.u32 %r30, 0;
    st.global.u32 [g_bar_count], %r30;
    membar.gl;
    st.global.u32 [g_bar_sense], %r28;
    bra $gd1;
$gw1:
    ld.volatile.global.u32 %r30, [g_bar_sense];
    setp.ne.u32 %p1, %r30, %r28;
    @%p1 bra $gw1;
$gd1:
    xor.b32 %r28, %r28, 1;
    st.shared.u32 [lsense], %r28;
$gs1:
    bar.sync 0;

    setp.ne.u32 %p0, %r11, 0;
    @%p0 bra RMS1S;
    mul.lo.u32 %r20, %r15, 11;
    add.u32 %r20, %r20, 12;
    cvt.u64.u32 %rd16, %r20;
    mul.lo.u64 %rd16, %rd16, 8;
    add.u64 %rd16, %rd10, %rd16;
    ld.global.u64 %rd19, [%rd16];
    mov.f32 %f0, 0f00000000;
    mov.u32 %r23, %r10;
$nsa:
    setp.ge.u32 %p2, %r23, %r1;
    @%p2 bra $nda;
    cvt.u64.u32 %rd16, %r23;
    mul.lo.u64 %rd16, %rd16, 4;
    add.u64 %rd17, %rd20, %rd16;
    ld.global.f32 %f1, [%rd17];
    fma.rn.f32 %f0, %f1, %f1, %f0;
    add.u32 %r23, %r23, 256;
    bra $nsa;
$nda:
    mul.lo.u32 %r24, %r10, 4;
    add.u32 %r24, %r13, %r24;
    st.shared.f32 [%r24], %f0;
    bar.sync 0;
    mov.u32 %r25, 128;
$nra:
    setp.eq.u32 %p2, %r25, 0;
    @%p2 bra $nrda;
    setp.ge.u32 %p3, %r10, %r25;
    @%p3 bra $nrna;
    add.u32 %r26, %r10, %r25;
    mul.lo.u32 %r26, %r26, 4;
    add.u32 %r26, %r13, %r26;
    ld.shared.f32 %f1, [%r24];
    ld.shared.f32 %f2, [%r26];
    add.f32 %f1, %f1, %f2;
    st.shared.f32 [%r24], %f1;
$nrna:
    bar.sync 0;
    shr.u32 %r25, %r25, 1;
    bra $nra;
$nrda:
    setp.ne.u32 %p2, %r10, 0;
    @%p2 bra $nia;
    ld.shared.f32 %f0, [%r13];
    cvt.rn.f32.s32 %f1, %r1;
    div.rn.f32 %f0, %f0, %f1;
    add.f32 %f0, %f0, %f6;
    rsqrt.approx.f32 %f2, %f0;
    mul.f32 %f3, %f2, %f2;
    mul.f32 %f3, %f0, %f3;
    mul.f32 %f3, 0f3f000000, %f3;
    sub.f32 %f3, 0f3fc00000, %f3;
    mul.f32 %f2, %f2, %f3;
    mul.f32 %f3, %f2, %f2;
    mul.f32 %f3, %f0, %f3;
    mul.f32 %f3, 0f3f000000, %f3;
    sub.f32 %f3, 0f3fc00000, %f3;
    mul.f32 %f2, %f2, %f3;
    st.shared.f32 [%r13], %f2;
$nia:
    bar.sync 0;
    ld.shared.f32 %f2, [%r13];
    mov.u32 %r23, %r10;
$nwa:
    setp.ge.u32 %p2, %r23, %r1;
    @%p2 bra $nwda;
    cvt.u64.u32 %rd16, %r23;
    mul.lo.u64 %rd16, %rd16, 4;
    add.u64 %rd17, %rd20, %rd16;
    ld.global.f32 %f0, [%rd17];
    add.u64 %rd18, %rd19, %rd16;
    ld.global.f32 %f1, [%rd18];
    mul.f32 %f0, %f0, %f2;
    mul.f32 %f0, %f0, %f1;
    add.u64 %rd17, %rd21, %rd16;
    st.global.f32 [%rd17], %f0;
    add.u32 %r23, %r23, 256;
    bra $nwa;
$nwda:

RMS1S:
    membar.gl;
    bar.sync 0;
    mov.u32 %r28, %tid.x;
    setp.ne.u32 %p0, %r28, 0;
    @%p0 bra $gs2;
    ld.shared.u32 %r28, [lsense];
    mov.u64 %rd14, g_bar_count;
    atom.global.add.u32 %r31, [%rd14], 1;
    mov.u32 %r29, %nctaid.x;
    sub.u32 %r29, %r29, 1;
    setp.ne.u32 %p1, %r31, %r29;
    @%p1 bra $gw2;
    mov.u32 %r30, 0;
    st.global.u32 [g_bar_count], %r30;
    membar.gl;
    st.global.u32 [g_bar_sense], %r28;
    bra $gd2;
$gw2:
    ld.volatile.global.u32 %r30, [g_bar_sense];
    setp.ne.u32 %p1, %r30, %r28;
    @%p1 bra $gw2;
$gd2:
    xor.b32 %r28, %r28, 1;
    st.shared.u32 [lsense], %r28;
$gs2:
    bar.sync 0;

    mul.lo.u32 %r20, %r15, 11;
    add.u32 %r20, %r20, 5;
    cvt.u64.u32 %rd16, %r20;
    mul.lo.u64 %rd16, %rd16, 8;
    add.u64 %rd16, %rd10, %rd16;
    ld.global.u64 %rd16, [%rd16];
    st.param.b64 [_pa], %rd21;
    st.param.b64 [_pb], %rd16;
    st.param.b64 [_pp], %rd11;
    st.param.b32 [_pn], %r3;
    st.param.b32 [_pk], %r1;
    st.param.b32 [_ps], %r9;
    call gemv_split, (_pa, _pb, _pp, _pn, _pk, _ps);
    membar.gl;
    bar.sync 0;
    mov.u32 %r28, %tid.x;
    setp.ne.u32 %p0, %r28, 0;
    @%p0 bra $gs3;
    ld.shared.u32 %r28, [lsense];
    mov.u64 %rd14, g_bar_count;
    atom.global.add.u32 %r31, [%rd14], 1;
    mov.u32 %r29, %nctaid.x;
    sub.u32 %r29, %r29, 1;
    setp.ne.u32 %p1, %r31, %r29;
    @%p1 bra $gw3;
    mov.u32 %r30, 0;
    st.global.u32 [g_bar_count], %r30;
    membar.gl;
    st.global.u32 [g_bar_sense], %r28;
    bra $gd3;
$gw3:
    ld.volatile.global.u32 %r30, [g_bar_sense];
    setp.ne.u32 %p1, %r30, %r28;
    @%p1 bra $gw3;
$gd3:
    xor.b32 %r28, %r28, 1;
    st.shared.u32 [lsense], %r28;
$gs3:
    bar.sync 0;
    st.param.b64 [_pp], %rd11;
    st.param.b64 [_pc], %rd22;
    st.param.b32 [_pn], %r3;
    st.param.b32 [_ps], %r9;
    call gemv_reduce, (_pp, _pc, _pn, _ps);
    membar.gl;
    bar.sync 0;
    mov.u32 %r28, %tid.x;
    setp.ne.u32 %p0, %r28, 0;
    @%p0 bra $gs4;
    ld.shared.u32 %r28, [lsense];
    mov.u64 %rd14, g_bar_count;
    atom.global.add.u32 %r31, [%rd14], 1;
    mov.u32 %r29, %nctaid.x;
    sub.u32 %r29, %r29, 1;
    setp.ne.u32 %p1, %r31, %r29;
    @%p1 bra $gw4;
    mov.u32 %r30, 0;
    st.global.u32 [g_bar_count], %r30;
    membar.gl;
    st.global.u32 [g_bar_sense], %r28;
    bra $gd4;
