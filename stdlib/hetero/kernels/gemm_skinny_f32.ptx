// Skinny f32 GEMM, row-major C[M,N] = A[M,K] * B[K,N], M <= 16.
// One launch. Each K step stages A[*, k] once; every column reuses it,
// so B is read once.
.version 7.0
.target sm_50
.address_size 64

.visible .entry gemm_skinny_f32(
    .param .u64 param_A,
    .param .u64 param_B,
    .param .u64 param_C,
    .param .s32 param_M,
    .param .s32 param_N,
    .param .s32 param_K
)
{
    .shared .align 4 .b8 As[64];
    .reg .f32 %acc<16>;
    .reg .f32 %f<4>;
    .reg .pred %p<6>;
    .reg .b32 %r<20>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd0, [param_A];
    ld.param.u64 %rd1, [param_B];
    ld.param.u64 %rd2, [param_C];
    ld.param.s32 %r1, [param_M];
    ld.param.s32 %r2, [param_N];
    ld.param.s32 %r3, [param_K];

    mov.u32 %r4, %tid.x;
    mov.u32 %r5, %ctaid.x;
    mov.u32 %r6, %ntid.x;
    mad.lo.u32 %r7, %r5, %r6, %r4;

    mov.f32 %acc0, 0f00000000;
    mov.f32 %acc1, 0f00000000;
    mov.f32 %acc2, 0f00000000;
    mov.f32 %acc3, 0f00000000;
    mov.f32 %acc4, 0f00000000;
    mov.f32 %acc5, 0f00000000;
    mov.f32 %acc6, 0f00000000;
    mov.f32 %acc7, 0f00000000;
    mov.f32 %acc8, 0f00000000;
    mov.f32 %acc9, 0f00000000;
    mov.f32 %acc10, 0f00000000;
    mov.f32 %acc11, 0f00000000;
    mov.f32 %acc12, 0f00000000;
    mov.f32 %acc13, 0f00000000;
    mov.f32 %acc14, 0f00000000;
    mov.f32 %acc15, 0f00000000;

    mov.u32 %r8, 0;
    mov.u32 %r0, As;
KLOOP:
    setp.ge.u32 %p0, %r8, %r3;
    @%p0 bra KDONE;

    setp.ge.u32 %p1, %r4, %r1;
    @%p1 bra NOA;
    mul.lo.u32 %r9, %r4, %r3;
    add.u32 %r9, %r9, %r8;
    cvt.u64.u32 %rd3, %r9;
    mul.lo.u64 %rd3, %rd3, 4;
    add.u64 %rd3, %rd0, %rd3;
    ld.global.f32 %f0, [%rd3];
    mul.lo.u32 %r10, %r4, 4;
    add.u32 %r11, %r0, %r10;
    st.shared.f32 [%r11], %f0;
NOA:
    bar.sync 0;

    setp.ge.u32 %p2, %r7, %r2;
    mov.f32 %f1, 0f00000000;
    @%p2 bra NOB;
    mul.lo.u32 %r12, %r8, %r2;
    add.u32 %r12, %r12, %r7;
    cvt.u64.u32 %rd4, %r12;
    mul.lo.u64 %rd4, %rd4, 4;
    add.u64 %rd4, %rd1, %rd4;
    ld.global.f32 %f1, [%rd4];
NOB:
    mov.u32 %r14, 0;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S1;
    ld.shared.f32 %f2, [%r0];
    fma.rn.f32 %acc0, %f2, %f1, %acc0;
S1:
    mov.u32 %r14, 1;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S2;
    add.u32 %r15, %r0, 4;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc1, %f2, %f1, %acc1;
S2:
    mov.u32 %r14, 2;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S3;
    add.u32 %r15, %r0, 8;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc2, %f2, %f1, %acc2;
S3:
    mov.u32 %r14, 3;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S4;
    add.u32 %r15, %r0, 12;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc3, %f2, %f1, %acc3;
S4:
    mov.u32 %r14, 4;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S5;
    add.u32 %r15, %r0, 16;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc4, %f2, %f1, %acc4;
S5:
    mov.u32 %r14, 5;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S6;
    add.u32 %r15, %r0, 20;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc5, %f2, %f1, %acc5;
S6:
    mov.u32 %r14, 6;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S7;
    add.u32 %r15, %r0, 24;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc6, %f2, %f1, %acc6;
S7:
    mov.u32 %r14, 7;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S8;
    add.u32 %r15, %r0, 28;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc7, %f2, %f1, %acc7;
S8:
    mov.u32 %r14, 8;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S9;
    add.u32 %r15, %r0, 32;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc8, %f2, %f1, %acc8;
S9:
    mov.u32 %r14, 9;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S10;
    add.u32 %r15, %r0, 36;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc9, %f2, %f1, %acc9;
S10:
    mov.u32 %r14, 10;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S11;
    add.u32 %r15, %r0, 40;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc10, %f2, %f1, %acc10;
S11:
    mov.u32 %r14, 11;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S12;
    add.u32 %r15, %r0, 44;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc11, %f2, %f1, %acc11;
S12:
    mov.u32 %r14, 12;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S13;
    add.u32 %r15, %r0, 48;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc12, %f2, %f1, %acc12;
S13:
    mov.u32 %r14, 13;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S14;
    add.u32 %r15, %r0, 52;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc13, %f2, %f1, %acc13;
S14:
    mov.u32 %r14, 14;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S15;
    add.u32 %r15, %r0, 56;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc14, %f2, %f1, %acc14;
S15:
    mov.u32 %r14, 15;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra S16;
    add.u32 %r15, %r0, 60;
    ld.shared.f32 %f2, [%r15];
    fma.rn.f32 %acc15, %f2, %f1, %acc15;
S16:
    bar.sync 0;
    add.u32 %r8, %r8, 1;
    bra KLOOP;

KDONE:
    setp.ge.u32 %p2, %r7, %r2;
    @%p2 bra DONE;

    mov.u32 %r14, 0;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T1;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc0;
T1:
    mov.u32 %r14, 1;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T2;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc1;
T2:
    mov.u32 %r14, 2;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T3;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc2;
T3:
    mov.u32 %r14, 3;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T4;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc3;
T4:
    mov.u32 %r14, 4;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T5;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc4;
T5:
    mov.u32 %r14, 5;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T6;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc5;
T6:
    mov.u32 %r14, 6;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T7;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc6;
T7:
    mov.u32 %r14, 7;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T8;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc7;
T8:
    mov.u32 %r14, 8;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T9;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc8;
T9:
    mov.u32 %r14, 9;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T10;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc9;
T10:
    mov.u32 %r14, 10;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T11;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc10;
T11:
    mov.u32 %r14, 11;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T12;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc11;
T12:
    mov.u32 %r14, 12;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T13;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc12;
T13:
    mov.u32 %r14, 13;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T14;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc13;
T14:
    mov.u32 %r14, 14;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra T15;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc14;
T15:
    mov.u32 %r14, 15;
    setp.ge.u32 %p3, %r14, %r1;
    @%p3 bra DONE;
    mul.lo.u32 %r13, %r14, %r2;
    add.u32 %r13, %r13, %r7;
    cvt.u64.u32 %rd5, %r13;
    mul.lo.u64 %rd5, %rd5, 4;
    add.u64 %rd5, %rd2, %rd5;
    st.global.f32 [%rd5], %acc15;
DONE:
    ret;
}
