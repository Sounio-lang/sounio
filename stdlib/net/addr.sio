// stdlib/net/addr — Network address types

module net::addr

pub struct IPv4Addr {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
}

pub fn ipv4_new(a: i64, b: i64, c: i64, d: i64) -> IPv4Addr {
    IPv4Addr { a: a, b: b, c: c, d: d }
}

pub fn ipv4_loopback() -> IPv4Addr {
    IPv4Addr { a: 127, b: 0, c: 0, d: 1 }
}

pub fn ipv4_any() -> IPv4Addr {
    IPv4Addr { a: 0, b: 0, c: 0, d: 0 }
}

impl IPv4Addr {
    pub fn is_loopback(self: &IPv4Addr) -> bool { self.a == 127 }

    pub fn is_private(self: &IPv4Addr) -> bool {
        if self.a == 10 { return true }
        if self.a == 172 && self.b >= 16 && self.b <= 31 { return true }
        if self.a == 192 && self.b == 168 { return true }
        return false
    }

    pub fn is_any(self: &IPv4Addr) -> bool {
        self.a == 0 && self.b == 0 && self.c == 0 && self.d == 0
    }

    pub fn to_u32(self: &IPv4Addr) -> i64 {
        self.a * 16777216 + self.b * 65536 + self.c * 256 + self.d
    }

    pub fn equals(self: &IPv4Addr, other: &IPv4Addr) -> bool {
        self.a == other.a && self.b == other.b && self.c == other.c && self.d == other.d
    }
}

pub struct SocketAddr {
    ip: IPv4Addr,
    port: i64,
}

pub fn socket_addr_new(ip: IPv4Addr, port: i64) -> SocketAddr {
    SocketAddr { ip: ip, port: port }
}

impl SocketAddr {
    pub fn port(self: &SocketAddr) -> i64 { self.port }
    pub fn is_loopback(self: &SocketAddr) -> bool { self.ip.is_loopback() }
}
