//! stdlib/net/addr.sio - Socket Addresses
//!
//! This module provides socket address types for IPv4 and IPv6.

// =============================================================================
// FFI Declarations
// =============================================================================

extern "C" {
    fn inet_pton(af: i32, src: *const u8, dst: *mut u8) -> i32;
    fn inet_ntop(af: i32, src: *const u8, dst: *mut u8, size: u32) -> *const u8;
    fn htons(hostshort: u16) -> u16;
    fn ntohs(netshort: u16) -> u16;
    fn htonl(hostlong: u32) -> u32;
    fn ntohl(netlong: u32) -> u32;

    fn getaddrinfo(
        node: *const u8,
        service: *const u8,
        hints: *const AddrInfo,
        res: *mut *mut AddrInfo
    ) -> i32;
    fn freeaddrinfo(res: *mut AddrInfo);
    fn gai_strerror(errcode: i32) -> *const u8;
}

// Address families
pub let AF_INET: i32 = 2;
pub let AF_INET6: i32 = 10;
pub let AF_UNSPEC: i32 = 0;

// Socket types
pub let SOCK_STREAM: i32 = 1;
pub let SOCK_DGRAM: i32 = 2;

// =============================================================================
// Address Types
// =============================================================================

// An IPv4 address (4 bytes)
pub struct Ipv4Addr {
    octets: [u8; 4]
}

// An IPv6 address (16 bytes)
pub struct Ipv6Addr {
    octets: [u8; 16]
}

// Either an IPv4 or IPv6 address
pub enum IpAddr {
    V4(Ipv4Addr),
    V6(Ipv6Addr)
}

// A socket address (IP + port)
pub struct SocketAddr {
    ip: IpAddr,
    port: u16
}

// IPv4 socket address for FFI
#[repr(C)]
pub struct SockAddrIn {
    sin_family: u16,
    sin_port: u16,
    sin_addr: u32,
    sin_zero: [u8; 8]
}

// IPv6 socket address for FFI
#[repr(C)]
pub struct SockAddrIn6 {
    sin6_family: u16,
    sin6_port: u16,
    sin6_flowinfo: u32,
    sin6_addr: [u8; 16],
    sin6_scope_id: u32
}

// Address info for DNS resolution
#[repr(C)]
struct AddrInfo {
    ai_flags: i32,
    ai_family: i32,
    ai_socktype: i32,
    ai_protocol: i32,
    ai_addrlen: u32,
    ai_addr: *mut u8,
    ai_canonname: *mut u8,
    ai_next: *mut AddrInfo
}

// =============================================================================
// IPv4 Address
// =============================================================================

// Creates a new IPv4 address from octets.
pub fn ipv4_new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
    Ipv4Addr { octets: [a, b, c, d] }
}

// The localhost address (127.0.0.1)
pub fn ipv4_localhost() -> Ipv4Addr {
    ipv4_new(127, 0, 0, 1)
}

// The unspecified address (0.0.0.0)
pub fn ipv4_unspecified() -> Ipv4Addr {
    ipv4_new(0, 0, 0, 0)
}

// The broadcast address (255.255.255.255)
pub fn ipv4_broadcast() -> Ipv4Addr {
    ipv4_new(255, 255, 255, 255)
}

// Returns the octets of the address.
pub fn ipv4_octets(addr: &Ipv4Addr) -> [u8; 4] {
    addr.octets
}

// Converts to a 32-bit integer (network byte order).
pub fn ipv4_to_u32(addr: &Ipv4Addr) -> u32 {
    ((addr.octets[0] as u32) << 24) |
    ((addr.octets[1] as u32) << 16) |
    ((addr.octets[2] as u32) << 8) |
    (addr.octets[3] as u32)
}

// Creates from a 32-bit integer (network byte order).
pub fn ipv4_from_u32(n: u32) -> Ipv4Addr {
    Ipv4Addr {
        octets: [
            ((n >> 24) & 0xff) as u8,
            ((n >> 16) & 0xff) as u8,
            ((n >> 8) & 0xff) as u8,
            (n & 0xff) as u8
        ]
    }
}

// Returns true if this is a loopback address (127.0.0.0/8).
pub fn ipv4_is_loopback(addr: &Ipv4Addr) -> bool {
    addr.octets[0] == 127
}

// Returns true if this is a private address.
pub fn ipv4_is_private(addr: &Ipv4Addr) -> bool {
    // 10.0.0.0/8
    addr.octets[0] == 10 ||
    // 172.16.0.0/12
    (addr.octets[0] == 172 && addr.octets[1] >= 16 && addr.octets[1] <= 31) ||
    // 192.168.0.0/16
    (addr.octets[0] == 192 && addr.octets[1] == 168)
}

// Returns true if this is the unspecified address.
pub fn ipv4_is_unspecified(addr: &Ipv4Addr) -> bool {
    addr.octets[0] == 0 && addr.octets[1] == 0 &&
    addr.octets[2] == 0 && addr.octets[3] == 0
}

// Returns true if this is a multicast address (224.0.0.0/4).
pub fn ipv4_is_multicast(addr: &Ipv4Addr) -> bool {
    addr.octets[0] >= 224 && addr.octets[0] <= 239
}

// Converts to string representation.
pub fn ipv4_to_string(addr: &Ipv4Addr) -> string with Alloc {
    addr.octets[0].to_string() ++ "." ++
    addr.octets[1].to_string() ++ "." ++
    addr.octets[2].to_string() ++ "." ++
    addr.octets[3].to_string()
}

// Parses an IPv4 address from a string.
pub fn ipv4_parse(s: &str) -> Option<Ipv4Addr> with Alloc {
    let parts: Vec<&str> = s.split('.');
    if parts.len() != 4 {
        return None
    }

    var octets: [u8; 4] = [0u8; 4];
    var i: usize = 0;
    while i < 4 {
        match parts[i].parse_u8() {
            Ok(n) => octets[i] = n,
            Err(_) => return None
        }
        i = i + 1;
    }

    Some(Ipv4Addr { octets })
}

// =============================================================================
// IPv6 Address
// =============================================================================

// Creates a new IPv6 address from 16 bytes.
pub fn ipv6_new(octets: [u8; 16]) -> Ipv6Addr {
    Ipv6Addr { octets }
}

// Creates from eight 16-bit segments.
pub fn ipv6_from_segments(a: u16, b: u16, c: u16, d: u16, e: u16, f: u16, g: u16, h: u16) -> Ipv6Addr {
    Ipv6Addr {
        octets: [
            (a >> 8) as u8, a as u8,
            (b >> 8) as u8, b as u8,
            (c >> 8) as u8, c as u8,
            (d >> 8) as u8, d as u8,
            (e >> 8) as u8, e as u8,
            (f >> 8) as u8, f as u8,
            (g >> 8) as u8, g as u8,
            (h >> 8) as u8, h as u8
        ]
    }
}

// The localhost address (::1)
pub fn ipv6_localhost() -> Ipv6Addr {
    var octets: [u8; 16] = [0u8; 16];
    octets[15] = 1;
    Ipv6Addr { octets }
}

// The unspecified address (::)
pub fn ipv6_unspecified() -> Ipv6Addr {
    Ipv6Addr { octets: [0u8; 16] }
}

// Returns true if this is a loopback address (::1).
pub fn ipv6_is_loopback(addr: &Ipv6Addr) -> bool {
    var i: usize = 0;
    while i < 15 {
        if addr.octets[i] != 0 {
            return false
        }
        i = i + 1;
    }
    addr.octets[15] == 1
}

// Returns true if this is the unspecified address.
pub fn ipv6_is_unspecified(addr: &Ipv6Addr) -> bool {
    var i: usize = 0;
    while i < 16 {
        if addr.octets[i] != 0 {
            return false
        }
        i = i + 1;
    }
    true
}

// Converts an IPv4 address to IPv4-mapped IPv6 (::ffff:a.b.c.d).
pub fn ipv6_from_ipv4(v4: &Ipv4Addr) -> Ipv6Addr {
    var octets: [u8; 16] = [0u8; 16];
    octets[10] = 0xff;
    octets[11] = 0xff;
    octets[12] = v4.octets[0];
    octets[13] = v4.octets[1];
    octets[14] = v4.octets[2];
    octets[15] = v4.octets[3];
    Ipv6Addr { octets }
}

// =============================================================================
// Socket Address
// =============================================================================

// Creates a new socket address.
pub fn socket_addr_new(ip: IpAddr, port: u16) -> SocketAddr {
    SocketAddr { ip, port }
}

// Creates an IPv4 socket address.
pub fn socket_addr_v4(addr: Ipv4Addr, port: u16) -> SocketAddr {
    SocketAddr { ip: IpAddr::V4(addr), port }
}

// Creates an IPv6 socket address.
pub fn socket_addr_v6(addr: Ipv6Addr, port: u16) -> SocketAddr {
    SocketAddr { ip: IpAddr::V6(addr), port }
}

// Returns the IP address.
pub fn socket_addr_ip(addr: &SocketAddr) -> &IpAddr {
    &addr.ip
}

// Returns the port.
pub fn socket_addr_port(addr: &SocketAddr) -> u16 {
    addr.port
}

// Returns true if this is an IPv4 address.
pub fn socket_addr_is_ipv4(addr: &SocketAddr) -> bool {
    match &addr.ip {
        IpAddr::V4(_) => true,
        IpAddr::V6(_) => false
    }
}

// Converts to string representation.
pub fn socket_addr_to_string(addr: &SocketAddr) -> string with Alloc {
    match &addr.ip {
        IpAddr::V4(v4) => ipv4_to_string(v4) ++ ":" ++ addr.port.to_string(),
        IpAddr::V6(v6) => "[" ++ ipv6_to_string(v6) ++ "]:" ++ addr.port.to_string()
    }
}

fn ipv6_to_string(addr: &Ipv6Addr) -> string with Alloc {
    // Simplified - doesn't compress zeros
    var result = String::new();
    var i: usize = 0;
    while i < 16 {
        if i > 0 && i % 2 == 0 {
            result.push(':');
        }
        result.push_str(&format_hex_byte(addr.octets[i]));
        i = i + 1;
    }
    result
}

fn format_hex_byte(b: u8) -> string with Alloc {
    let hex = "0123456789abcdef";
    var result = String::new();
    result.push(hex.char_at((b >> 4) as usize));
    result.push(hex.char_at((b & 0xf) as usize));
    result
}

// Parses a socket address from a string (e.g., "127.0.0.1:8080").
pub fn socket_addr_parse(s: &str) -> Option<SocketAddr> with Alloc {
    // Find last colon (port separator)
    var colon_pos: Option<usize> = None;
    var i: usize = s.len();
    while i > 0 {
        i = i - 1;
        if s.char_at(i) == ':' {
            colon_pos = Some(i);
            break
        }
    }

    let colon = match colon_pos {
        Some(p) => p,
        None => return None
    };

    let ip_str = &s[..colon];
    let port_str = &s[colon + 1..];

    let port = match port_str.parse_u16() {
        Ok(p) => p,
        Err(_) => return None
    };

    // Try IPv4
    if let Some(v4) = ipv4_parse(ip_str) {
        return Some(socket_addr_v4(v4, port))
    }

    // IPv6 would need bracket handling
    None
}

// =============================================================================
// DNS Resolution
// =============================================================================

// Error from DNS resolution
pub enum ResolveError {
    /// Name not found
    NotFound,
    /// Temporary failure
    TryAgain,
    /// Non-recoverable error
    NoRecovery,
    /// No address associated with name
    NoData,
    /// System error
    SystemError { message: string }
}

// Resolves a hostname to a list of IP addresses.
pub fn resolve(hostname: &str) -> Result<Vec<IpAddr>, ResolveError> with IO, Alloc {
    var hints = AddrInfo {
        ai_flags: 0,
        ai_family: AF_UNSPEC,
        ai_socktype: SOCK_STREAM,
        ai_protocol: 0,
        ai_addrlen: 0,
        ai_addr: null,
        ai_canonname: null,
        ai_next: null
    };

    var result: *mut AddrInfo = null;
    let hostname_cstr = hostname.as_ptr();

    let err = getaddrinfo(hostname_cstr, null, &hints, &!result);
    if err != 0 {
        return Err(resolve_error_from_code(err))
    }

    var addrs: Vec<IpAddr> = Vec::new();
    var current = result;

    while current != null {
        let info = unsafe { &*current };

        if info.ai_family == AF_INET && info.ai_addrlen >= 16 {
            let sockaddr = unsafe { &*(info.ai_addr as *const SockAddrIn) };
            let addr = ipv4_from_u32(ntohl(sockaddr.sin_addr));
            addrs.push(IpAddr::V4(addr));
        } else if info.ai_family == AF_INET6 && info.ai_addrlen >= 28 {
            let sockaddr = unsafe { &*(info.ai_addr as *const SockAddrIn6) };
            addrs.push(IpAddr::V6(Ipv6Addr { octets: sockaddr.sin6_addr }));
        }

        current = info.ai_next;
    }

    freeaddrinfo(result);
    Ok(addrs)
}

fn resolve_error_from_code(code: i32) -> ResolveError {
    // EAI_* error codes vary by platform
    match code {
        -2 => ResolveError::NotFound,      // EAI_NONAME
        -3 => ResolveError::TryAgain,      // EAI_AGAIN
        -4 => ResolveError::NoRecovery,    // EAI_FAIL
        -5 => ResolveError::NoData,        // EAI_NODATA
        _ => ResolveError::SystemError { message: "Unknown DNS error".to_string() }
    }
}

// Returns a human-readable error message.
pub fn resolve_error_message(err: &ResolveError) -> string {
    match err {
        ResolveError::NotFound => "Host not found".to_string(),
        ResolveError::TryAgain => "Temporary DNS failure, try again".to_string(),
        ResolveError::NoRecovery => "Non-recoverable DNS error".to_string(),
        ResolveError::NoData => "No address associated with hostname".to_string(),
        ResolveError::SystemError { message } => message.clone()
    }
}
