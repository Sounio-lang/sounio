// stdlib/net/mod.sio — Public exports for the net module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use net::addr::{
    IPv4Addr,
    SocketAddr,
    ipv4_any,
    ipv4_loopback,
    ipv4_new,
    socket_addr_new,
}

pub use net::tcp::{TcpConfig, tcp_config_default}
pub use net::udp::{UdpConfig, udp_config_default}

pub use net::ffi::bindings::{raw_socket_available}
pub use net::ffi::wrapper::{tcp_connect, udp_send}
