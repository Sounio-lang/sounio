// stdlib/net/ffi/wrapper.sio — Net FFI Wrapper
//
// No real OS socket syscalls are wired up yet (see stdlib/net/tcp.sio,
// stdlib/net/udp.sio) — these are stubs that always report failure, mirroring
// stdlib/distributed/ffi/wrapper.sio.
//
// Takes raw IPv4 octets + port rather than a &net::addr::SocketAddr: a real
// syscall boundary would need to unpack the struct into primitives anyway,
// and it sidesteps a lean_single checker bug where a function parameter
// typed as a qualified path (`pkg::mod::Type`) miscounts arity at any call
// site that also has `use pkg::mod::*` in scope (reproduced in isolation;
// see docs/audit/MADAROS_NET_MOD_SIO_STANDALONE_CHECK_SILENT_FAIL_2026-07-01.md).

module net::ffi::wrapper

fn net_stub_err() -> i32 {
    let z: i32 = 0
    z - 1
}

pub fn tcp_connect(ip_a: i64, ip_b: i64, ip_c: i64, ip_d: i64, port: i64) -> i32 { net_stub_err() }
pub fn udp_send(ip_a: i64, ip_b: i64, ip_c: i64, ip_d: i64, port: i64, payload_len: i32) -> bool { false }
