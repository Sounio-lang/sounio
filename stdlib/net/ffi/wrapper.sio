// stdlib/net/ffi/wrapper.sio — Net FFI Wrapper
//
// No real OS socket syscalls are wired up yet (see stdlib/net/tcp.sio,
// stdlib/net/udp.sio) — these are stubs that always report failure, mirroring
// stdlib/distributed/ffi/wrapper.sio.

module net::ffi::wrapper

fn net_stub_err() -> i32 {
    let z: i32 = 0
    z - 1
}

pub fn tcp_connect(addr: &net::addr::SocketAddr) -> i32 { net_stub_err() }
pub fn udp_send(addr: &net::addr::SocketAddr, payload_len: i32) -> bool { false }
