// stdlib/net/tcp — TCP socket types (pure data structures)
//
// TcpConfig: configuration for a TCP connection.
// No actual I/O — that requires FFI to system sockets.

module net::tcp

pub struct TcpConfig {
    port: i64,
    backlog: i64,
    nodelay: i64,
    keepalive: i64,
    timeout_ms: i64,
}

pub fn tcp_config_default() -> TcpConfig {
    TcpConfig {
        port: 8080,
        backlog: 128,
        nodelay: 1,
        keepalive: 1,
        timeout_ms: 30000,
    }
}

impl TcpConfig {
    pub fn with_port(self: TcpConfig, port: i64) -> TcpConfig {
        var cfg = self
        cfg.port = port
        cfg
    }

    pub fn with_timeout(self: TcpConfig, ms: i64) -> TcpConfig {
        var cfg = self
        cfg.timeout_ms = ms
        cfg
    }
}
