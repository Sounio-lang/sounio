//! stdlib/net/tcp.sio - TCP Sockets
//!
//! This module provides TCP stream sockets for reliable, ordered,
//! connection-oriented communication.

use net::addr::*;

// =============================================================================
// FFI Declarations
// =============================================================================

extern "C" {
    fn socket(domain: i32, type_: i32, protocol: i32) -> i32;
    fn bind(sockfd: i32, addr: *const u8, addrlen: u32) -> i32;
    fn listen(sockfd: i32, backlog: i32) -> i32;
    fn accept(sockfd: i32, addr: *mut u8, addrlen: *mut u32) -> i32;
    fn connect(sockfd: i32, addr: *const u8, addrlen: u32) -> i32;
    fn send(sockfd: i32, buf: *const u8, len: usize, flags: i32) -> isize;
    fn recv(sockfd: i32, buf: *mut u8, len: usize, flags: i32) -> isize;
    fn close(fd: i32) -> i32;
    fn shutdown(sockfd: i32, how: i32) -> i32;
    fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: *const u8, optlen: u32) -> i32;
    fn getsockopt(sockfd: i32, level: i32, optname: i32, optval: *mut u8, optlen: *mut u32) -> i32;
    fn fcntl(fd: i32, cmd: i32, arg: i32) -> i32;
    fn getsockname(sockfd: i32, addr: *mut u8, addrlen: *mut u32) -> i32;
    fn getpeername(sockfd: i32, addr: *mut u8, addrlen: *mut u32) -> i32;
}

// Socket options
let SOL_SOCKET: i32 = 1;
let SO_REUSEADDR: i32 = 2;
let SO_KEEPALIVE: i32 = 9;
let SO_RCVBUF: i32 = 8;
let SO_SNDBUF: i32 = 7;
let TCP_NODELAY: i32 = 1;
let IPPROTO_TCP: i32 = 6;

// Shutdown options
let SHUT_RD: i32 = 0;
let SHUT_WR: i32 = 1;
let SHUT_RDWR: i32 = 2;

// fcntl commands
let F_GETFL: i32 = 3;
let F_SETFL: i32 = 4;
let O_NONBLOCK: i32 = 2048;

// =============================================================================
// Error Types
// =============================================================================

// Errors that can occur during TCP operations
pub enum TcpError {
    /// Connection refused by peer
    ConnectionRefused,
    /// Connection reset by peer
    ConnectionReset,
    /// Connection timed out
    TimedOut,
    /// Address already in use
    AddrInUse,
    /// Address not available
    AddrNotAvailable,
    /// Network unreachable
    NetworkUnreachable,
    /// Host unreachable
    HostUnreachable,
    /// Would block (non-blocking mode)
    WouldBlock,
    /// Operation interrupted
    Interrupted,
    /// Invalid argument
    InvalidInput { message: string },
    /// Other error
    Other { code: i32, message: string }
}

// Returns a human-readable error message.
pub fn tcp_error_message(err: &TcpError) -> string {
    match err {
        TcpError::ConnectionRefused => "Connection refused".to_string(),
        TcpError::ConnectionReset => "Connection reset by peer".to_string(),
        TcpError::TimedOut => "Connection timed out".to_string(),
        TcpError::AddrInUse => "Address already in use".to_string(),
        TcpError::AddrNotAvailable => "Address not available".to_string(),
        TcpError::NetworkUnreachable => "Network unreachable".to_string(),
        TcpError::HostUnreachable => "Host unreachable".to_string(),
        TcpError::WouldBlock => "Operation would block".to_string(),
        TcpError::Interrupted => "Operation interrupted".to_string(),
        TcpError::InvalidInput { message } => message.clone(),
        TcpError::Other { code, message } => message.clone() ++ " (code: " ++ code.to_string() ++ ")"
    }
}

fn tcp_error_from_errno(errno: i32) -> TcpError {
    match errno {
        111 => TcpError::ConnectionRefused,  // ECONNREFUSED
        104 => TcpError::ConnectionReset,    // ECONNRESET
        110 => TcpError::TimedOut,           // ETIMEDOUT
        98 => TcpError::AddrInUse,           // EADDRINUSE
        99 => TcpError::AddrNotAvailable,    // EADDRNOTAVAIL
        101 => TcpError::NetworkUnreachable, // ENETUNREACH
        113 => TcpError::HostUnreachable,    // EHOSTUNREACH
        11 | 35 => TcpError::WouldBlock,     // EAGAIN / EWOULDBLOCK
        4 => TcpError::Interrupted,          // EINTR
        _ => TcpError::Other { code: errno, message: "System error".to_string() }
    }
}

extern "C" {
    fn __errno_location() -> *mut i32;
}

fn get_errno() -> i32 with IO {
    unsafe { *__errno_location() }
}

// =============================================================================
// TCP Stream
// =============================================================================

// A TCP stream representing a connection to a remote host.
pub struct TcpStream {
    fd: i32,
    local_addr: Option<SocketAddr>,
    peer_addr: Option<SocketAddr>
}

// Connects to a remote address.
//
// # Example
// ```sio
// let stream = tcp_connect("127.0.0.1:8080")?
// ```
pub fn tcp_connect(addr: &str) -> Result<TcpStream, TcpError> with IO, Alloc {
    let socket_addr = match socket_addr_parse(addr) {
        Some(a) => a,
        None => return Err(TcpError::InvalidInput { message: "Invalid address".to_string() })
    };

    tcp_connect_addr(&socket_addr)
}

// Connects to a socket address.
pub fn tcp_connect_addr(addr: &SocketAddr) -> Result<TcpStream, TcpError> with IO, Alloc {
    let family = if socket_addr_is_ipv4(addr) { AF_INET } else { AF_INET6 };

    let fd = socket(family, SOCK_STREAM, 0);
    if fd < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    // Build sockaddr
    let (sockaddr, sockaddr_len) = build_sockaddr(addr);

    let result = connect(fd, sockaddr.as_ptr(), sockaddr_len);
    if result < 0 {
        close(fd);
        return Err(tcp_error_from_errno(get_errno()))
    }

    Ok(TcpStream {
        fd: fd,
        local_addr: None,
        peer_addr: Some(addr.clone())
    })
}

// Writes data to the stream.
//
// Returns the number of bytes written.
pub fn tcp_write(stream: &TcpStream, data: &[u8]) -> Result<usize, TcpError> with IO {
    let result = send(stream.fd, data.as_ptr(), data.len(), 0);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(result as usize)
    }
}

// Writes all data to the stream, retrying as necessary.
pub fn tcp_write_all(stream: &TcpStream, data: &[u8]) -> Result<(), TcpError> with IO {
    var written: usize = 0;
    while written < data.len() {
        match tcp_write(stream, &data[written..]) {
            Ok(n) => {
                if n == 0 {
                    return Err(TcpError::ConnectionReset)
                }
                written = written + n;
            },
            Err(TcpError::Interrupted) => continue,
            Err(e) => return Err(e)
        }
    }
    Ok(())
}

// Reads data from the stream into a buffer.
//
// Returns the number of bytes read, or 0 if the connection is closed.
pub fn tcp_read(stream: &TcpStream, buf: &![u8]) -> Result<usize, TcpError> with IO {
    let result = recv(stream.fd, buf.as_mut_ptr(), buf.len(), 0);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(result as usize)
    }
}

// Reads all available data from the stream.
pub fn tcp_read_all(stream: &TcpStream) -> Result<Vec<u8>, TcpError> with IO, Alloc {
    var data: Vec<u8> = Vec::new();
    var buf: [u8; 4096] = [0u8; 4096];

    loop {
        match tcp_read(stream, &!buf) {
            Ok(0) => break,
            Ok(n) => {
                var i: usize = 0;
                while i < n {
                    data.push(buf[i]);
                    i = i + 1;
                }
            },
            Err(TcpError::Interrupted) => continue,
            Err(TcpError::WouldBlock) => break,
            Err(e) => return Err(e)
        }
    }

    Ok(data)
}

// Reads exactly `len` bytes from the stream.
pub fn tcp_read_exact(stream: &TcpStream, len: usize) -> Result<Vec<u8>, TcpError> with IO, Alloc {
    var data: Vec<u8> = Vec::with_capacity(len);
    data.resize(len, 0u8);

    var read: usize = 0;
    while read < len {
        match tcp_read(stream, &!data[read..]) {
            Ok(0) => return Err(TcpError::ConnectionReset),
            Ok(n) => read = read + n,
            Err(TcpError::Interrupted) => continue,
            Err(e) => return Err(e)
        }
    }

    Ok(data)
}

// Shuts down the read side, write side, or both.
pub fn tcp_shutdown(stream: &TcpStream, how: i32) -> Result<(), TcpError> with IO {
    let result = shutdown(stream.fd, how);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

// Closes the TCP stream.
pub fn tcp_close(stream: TcpStream) with IO {
    close(stream.fd);
}

// Returns the local address of the stream.
pub fn tcp_local_addr(stream: &TcpStream) -> Option<SocketAddr> with IO, Alloc {
    var buf: [u8; 128] = [0u8; 128];
    var len: u32 = 128;

    let result = getsockname(stream.fd, &!buf[0], &!len);
    if result < 0 {
        return None
    }

    parse_sockaddr(&buf, len)
}

// Returns the peer address of the stream.
pub fn tcp_peer_addr(stream: &TcpStream) -> Option<SocketAddr> with IO, Alloc {
    var buf: [u8; 128] = [0u8; 128];
    var len: u32 = 128;

    let result = getpeername(stream.fd, &!buf[0], &!len);
    if result < 0 {
        return None
    }

    parse_sockaddr(&buf, len)
}

// Sets the TCP_NODELAY option (disable Nagle's algorithm).
pub fn tcp_set_nodelay(stream: &TcpStream, nodelay: bool) -> Result<(), TcpError> with IO {
    let val: i32 = if nodelay { 1 } else { 0 };
    let result = setsockopt(stream.fd, IPPROTO_TCP, TCP_NODELAY, &val, 4);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

// Sets non-blocking mode.
pub fn tcp_set_nonblocking(stream: &TcpStream, nonblocking: bool) -> Result<(), TcpError> with IO {
    let flags = fcntl(stream.fd, F_GETFL, 0);
    if flags < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    let new_flags = if nonblocking {
        flags | O_NONBLOCK
    } else {
        flags & !O_NONBLOCK
    };

    let result = fcntl(stream.fd, F_SETFL, new_flags);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

// =============================================================================
// TCP Listener
// =============================================================================

// A TCP socket server, listening for connections.
pub struct TcpListener {
    fd: i32,
    local_addr: SocketAddr
}

// Creates a TCP listener bound to the given address.
//
// # Example
// ```sio
// let listener = tcp_listen("0.0.0.0:8080")?
// ```
pub fn tcp_listen(addr: &str) -> Result<TcpListener, TcpError> with IO, Alloc {
    let socket_addr = match socket_addr_parse(addr) {
        Some(a) => a,
        None => return Err(TcpError::InvalidInput { message: "Invalid address".to_string() })
    };

    tcp_listen_addr(&socket_addr, 128)
}

// Creates a TCP listener with custom backlog.
pub fn tcp_listen_addr(addr: &SocketAddr, backlog: i32) -> Result<TcpListener, TcpError> with IO, Alloc {
    let family = if socket_addr_is_ipv4(addr) { AF_INET } else { AF_INET6 };

    let fd = socket(family, SOCK_STREAM, 0);
    if fd < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    // Set SO_REUSEADDR
    let val: i32 = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &val, 4);

    // Bind
    let (sockaddr, sockaddr_len) = build_sockaddr(addr);
    let result = bind(fd, sockaddr.as_ptr(), sockaddr_len);
    if result < 0 {
        close(fd);
        return Err(tcp_error_from_errno(get_errno()))
    }

    // Listen
    let result = listen(fd, backlog);
    if result < 0 {
        close(fd);
        return Err(tcp_error_from_errno(get_errno()))
    }

    Ok(TcpListener {
        fd: fd,
        local_addr: addr.clone()
    })
}

// Accepts a new incoming connection.
//
// Returns the stream and the client's address.
pub fn tcp_accept(listener: &TcpListener) -> Result<(TcpStream, SocketAddr), TcpError> with IO, Alloc {
    var buf: [u8; 128] = [0u8; 128];
    var len: u32 = 128;

    let client_fd = accept(listener.fd, &!buf[0], &!len);
    if client_fd < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    let peer_addr = parse_sockaddr(&buf, len);

    Ok((
        TcpStream {
            fd: client_fd,
            local_addr: Some(listener.local_addr.clone()),
            peer_addr: peer_addr.clone()
        },
        peer_addr.unwrap_or(socket_addr_v4(ipv4_unspecified(), 0))
    ))
}

// Returns the local address the listener is bound to.
pub fn tcp_listener_local_addr(listener: &TcpListener) -> &SocketAddr {
    &listener.local_addr
}

// Sets non-blocking mode on the listener.
pub fn tcp_listener_set_nonblocking(listener: &TcpListener, nonblocking: bool) -> Result<(), TcpError> with IO {
    let flags = fcntl(listener.fd, F_GETFL, 0);
    if flags < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    let new_flags = if nonblocking {
        flags | O_NONBLOCK
    } else {
        flags & !O_NONBLOCK
    };

    let result = fcntl(listener.fd, F_SETFL, new_flags);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

// Closes the TCP listener.
pub fn tcp_listener_close(listener: TcpListener) with IO {
    close(listener.fd);
}

// =============================================================================
// Helper Functions
// =============================================================================

fn build_sockaddr(addr: &SocketAddr) -> (Vec<u8>, u32) with Alloc {
    match &addr.ip {
        IpAddr::V4(v4) => {
            var buf: Vec<u8> = Vec::with_capacity(16);
            buf.resize(16, 0u8);

            // sin_family (2 bytes, little endian on most platforms)
            buf[0] = AF_INET as u8;
            buf[1] = 0;

            // sin_port (2 bytes, network byte order = big endian)
            buf[2] = (addr.port >> 8) as u8;
            buf[3] = addr.port as u8;

            // sin_addr (4 bytes)
            buf[4] = v4.octets[0];
            buf[5] = v4.octets[1];
            buf[6] = v4.octets[2];
            buf[7] = v4.octets[3];

            (buf, 16)
        },
        IpAddr::V6(v6) => {
            var buf: Vec<u8> = Vec::with_capacity(28);
            buf.resize(28, 0u8);

            buf[0] = AF_INET6 as u8;
            buf[1] = 0;
            buf[2] = (addr.port >> 8) as u8;
            buf[3] = addr.port as u8;

            // flowinfo (4 bytes)
            // sin6_addr (16 bytes at offset 8)
            var i: usize = 0;
            while i < 16 {
                buf[8 + i] = v6.octets[i];
                i = i + 1;
            }

            (buf, 28)
        }
    }
}

fn parse_sockaddr(buf: &[u8], len: u32) -> Option<SocketAddr> with Alloc {
    if len < 8 {
        return None
    }

    let family = buf[0] as i32;

    if family == AF_INET && len >= 16 {
        let port = ((buf[2] as u16) << 8) | (buf[3] as u16);
        let addr = ipv4_new(buf[4], buf[5], buf[6], buf[7]);
        Some(socket_addr_v4(addr, port))
    } else if family == AF_INET6 && len >= 28 {
        let port = ((buf[2] as u16) << 8) | (buf[3] as u16);
        var octets: [u8; 16] = [0u8; 16];
        var i: usize = 0;
        while i < 16 {
            octets[i] = buf[8 + i];
            i = i + 1;
        }
        Some(socket_addr_v6(Ipv6Addr { octets }, port))
    } else {
        None
    }
}
