//! stdlib/net - Networking Primitives
//!
//! This module provides low-level networking capabilities:
//! - `tcp` - TCP stream sockets (connection-oriented)
//! - `udp` - UDP datagram sockets (connectionless)
//! - `addr` - Socket address types and resolution
//!
//! # Examples
//! ```sio
//! // TCP client
//! let stream = tcp_connect("127.0.0.1:8080")?
//! tcp_write(&!stream, "GET / HTTP/1.0\r\n\r\n".as_bytes())?
//! let response = tcp_read_all(&!stream)?
//! tcp_close(stream)
//!
//! // TCP server
//! let listener = tcp_listen("0.0.0.0:8080")?
//! loop {
//!     let (client, addr) = tcp_accept(&!listener)?
//!     // Handle client...
//! }
//!
//! // UDP
//! let socket = udp_bind("0.0.0.0:0")?
//! udp_send_to(&socket, "hello".as_bytes(), "127.0.0.1:9000")?
//! ```

pub mod tcp;
pub mod udp;
pub mod addr;

pub use tcp::*;
pub use udp::*;
pub use addr::*;
