// stdlib/net/lib.sio — Net module entry point
//
// Public surface lives in stdlib/net/mod.sio (see stdlib/CONVENTIONS.md §2).
// The legacy `mod addr; mod tcp; mod udp;` submodule declarations this file
// used to have are not accepted by the current checker (same gap affects
// stdlib/collections, stdlib/async, stdlib/thread, stdlib/core — flagged,
// not fixed here; out of scope for this networking wave).

pub use net::addr::*;
pub use net::tcp::*;
pub use net::udp::*;

// Historical FFI probes/wrappers remain unavailable stubs.
pub use net::ffi::bindings::{raw_socket_available}
pub use net::ffi::wrapper::{tcp_connect,udp_send}

// Checked Linux IPv4 backend. Distinct names preserve legacy stub semantics.
pub use net::native::{
    NativeSocket, native_socket_status, native_tcp_listen, native_tcp_connect,
    native_tcp_accept, native_udp_bind, native_socket_port, native_socket_send,
    native_socket_receive, native_udp_send_loopback, native_udp_receive, native_socket_shutdown,
    native_socket_close, SocketToken, SocketReady, native_socket_token,
    socket_token_argument, socket_token_from_argument, native_socket_poll, native_tcp_connect_start,
    native_tcp_connect_finish, socket_token_try_receive, socket_token_try_send, native_socket_send_all_until,
    native_socket_read_exact_until, native_udp_set_destination, native_udp_send, UdpSender,
    native_udp_sender, UdpReceive, native_udp_receive_from,
}

pub use net::poll_set::{
    PollSet, PollEvent, poll_set_new, poll_set_status,
    poll_set_register, poll_set_remove, poll_set_wait, poll_set_event,
    poll_set_close,
}
