// stdlib/net/udp — UDP socket types (pure data structures)
//
// UdpConfig: configuration for a UDP socket.

module net::udp

pub struct UdpConfig {
    port: i64,
    broadcast: i64,
    max_packet_size: i64,
}

pub fn udp_config_default() -> UdpConfig {
    UdpConfig {
        port: 0,
        broadcast: 0,
        max_packet_size: 65507,
    }
}

impl UdpConfig {
    pub fn with_port(self: UdpConfig, port: i64) -> UdpConfig {
        var cfg = self
        cfg.port = port
        cfg
    }

    pub fn with_broadcast(self: UdpConfig) -> UdpConfig {
        var cfg = self
        cfg.broadcast = 1
        cfg
    }
}
