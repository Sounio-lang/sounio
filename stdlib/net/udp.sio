//! stdlib/net/udp.sio - UDP Sockets
//!
//! This module provides UDP datagram sockets for connectionless,
//! unreliable communication.

use net::addr::*;
use net::tcp::{get_errno, tcp_error_from_errno, TcpError};

// =============================================================================
// FFI Declarations
// =============================================================================

extern "C" {
    fn socket(domain: i32, type_: i32, protocol: i32) -> i32;
    fn bind(sockfd: i32, addr: *const u8, addrlen: u32) -> i32;
    fn sendto(sockfd: i32, buf: *const u8, len: usize, flags: i32, dest_addr: *const u8, addrlen: u32) -> isize;
    fn recvfrom(sockfd: i32, buf: *mut u8, len: usize, flags: i32, src_addr: *mut u8, addrlen: *mut u32) -> isize;
    fn connect(sockfd: i32, addr: *const u8, addrlen: u32) -> i32;
    fn send(sockfd: i32, buf: *const u8, len: usize, flags: i32) -> isize;
    fn recv(sockfd: i32, buf: *mut u8, len: usize, flags: i32) -> isize;
    fn close(fd: i32) -> i32;
    fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: *const u8, optlen: u32) -> i32;
    fn fcntl(fd: i32, cmd: i32, arg: i32) -> i32;
}

let SOL_SOCKET: i32 = 1;
let SO_BROADCAST: i32 = 6;
let SO_RCVBUF: i32 = 8;
let SO_SNDBUF: i32 = 7;
let IP_MULTICAST_TTL: i32 = 33;
let IP_ADD_MEMBERSHIP: i32 = 35;
let IP_DROP_MEMBERSHIP: i32 = 36;
let F_GETFL: i32 = 3;
let F_SETFL: i32 = 4;
let O_NONBLOCK: i32 = 2048;

// =============================================================================
// UDP Socket
// =============================================================================

/// A UDP socket.
pub struct UdpSocket {
    fd: i32,
    local_addr: SocketAddr
}

/// Creates a UDP socket bound to the given address.
///
/// # Example
/// ```sio
/// // Bind to any available port
/// let socket = udp_bind("0.0.0.0:0")?
///
/// // Bind to specific port
/// let socket = udp_bind("0.0.0.0:9000")?
/// ```
pub fn udp_bind(addr: &str) -> Result<UdpSocket, TcpError> with IO, Alloc {
    let socket_addr = match socket_addr_parse(addr) {
        Some(a) => a,
        None => return Err(TcpError::InvalidInput { message: "Invalid address".to_string() })
    };

    udp_bind_addr(&socket_addr)
}

/// Creates a UDP socket bound to a socket address.
pub fn udp_bind_addr(addr: &SocketAddr) -> Result<UdpSocket, TcpError> with IO, Alloc {
    let family = if socket_addr_is_ipv4(addr) { AF_INET } else { AF_INET6 };

    let fd = socket(family, SOCK_DGRAM, 0);
    if fd < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    let (sockaddr, sockaddr_len) = build_udp_sockaddr(addr);
    let result = bind(fd, sockaddr.as_ptr(), sockaddr_len);
    if result < 0 {
        close(fd);
        return Err(tcp_error_from_errno(get_errno()))
    }

    Ok(UdpSocket {
        fd: fd,
        local_addr: addr.clone()
    })
}

/// Sends data to the specified address.
///
/// Returns the number of bytes sent.
pub fn udp_send_to(socket: &UdpSocket, data: &[u8], addr: &str) -> Result<usize, TcpError> with IO, Alloc {
    let dest = match socket_addr_parse(addr) {
        Some(a) => a,
        None => return Err(TcpError::InvalidInput { message: "Invalid address".to_string() })
    };

    udp_send_to_addr(socket, data, &dest)
}

/// Sends data to a socket address.
pub fn udp_send_to_addr(socket: &UdpSocket, data: &[u8], addr: &SocketAddr) -> Result<usize, TcpError> with IO, Alloc {
    let (sockaddr, sockaddr_len) = build_udp_sockaddr(addr);

    let result = sendto(socket.fd, data.as_ptr(), data.len(), 0, sockaddr.as_ptr(), sockaddr_len);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(result as usize)
    }
}

/// Receives data from any source.
///
/// Returns the data and the source address.
pub fn udp_recv_from(socket: &UdpSocket, buf: &![u8]) -> Result<(usize, SocketAddr), TcpError> with IO, Alloc {
    var addr_buf: [u8; 128] = [0u8; 128];
    var addr_len: u32 = 128;

    let result = recvfrom(socket.fd, buf.as_mut_ptr(), buf.len(), 0, &!addr_buf[0], &!addr_len);
    if result < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    let src_addr = parse_udp_sockaddr(&addr_buf, addr_len)
        .unwrap_or(socket_addr_v4(ipv4_unspecified(), 0));

    Ok((result as usize, src_addr))
}

/// Connects the socket to a remote address.
///
/// After connecting, `udp_send` and `udp_recv` can be used without specifying addresses.
pub fn udp_connect(socket: &UdpSocket, addr: &str) -> Result<(), TcpError> with IO, Alloc {
    let dest = match socket_addr_parse(addr) {
        Some(a) => a,
        None => return Err(TcpError::InvalidInput { message: "Invalid address".to_string() })
    };

    udp_connect_addr(socket, &dest)
}

/// Connects to a socket address.
pub fn udp_connect_addr(socket: &UdpSocket, addr: &SocketAddr) -> Result<(), TcpError> with IO, Alloc {
    let (sockaddr, sockaddr_len) = build_udp_sockaddr(addr);

    let result = connect(socket.fd, sockaddr.as_ptr(), sockaddr_len);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

/// Sends data on a connected socket.
pub fn udp_send(socket: &UdpSocket, data: &[u8]) -> Result<usize, TcpError> with IO {
    let result = send(socket.fd, data.as_ptr(), data.len(), 0);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(result as usize)
    }
}

/// Receives data on a connected socket.
pub fn udp_recv(socket: &UdpSocket, buf: &![u8]) -> Result<usize, TcpError> with IO {
    let result = recv(socket.fd, buf.as_mut_ptr(), buf.len(), 0);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(result as usize)
    }
}

/// Returns the local address the socket is bound to.
pub fn udp_local_addr(socket: &UdpSocket) -> &SocketAddr {
    &socket.local_addr
}

/// Closes the UDP socket.
pub fn udp_close(socket: UdpSocket) with IO {
    close(socket.fd);
}

// =============================================================================
// Socket Options
// =============================================================================

/// Enables broadcast messages on the socket.
pub fn udp_set_broadcast(socket: &UdpSocket, broadcast: bool) -> Result<(), TcpError> with IO {
    let val: i32 = if broadcast { 1 } else { 0 };
    let result = setsockopt(socket.fd, SOL_SOCKET, SO_BROADCAST, &val as *const i32 as *const u8, 4);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

/// Sets the multicast TTL (time-to-live).
pub fn udp_set_multicast_ttl(socket: &UdpSocket, ttl: u8) -> Result<(), TcpError> with IO {
    let val: i32 = ttl as i32;
    let result = setsockopt(socket.fd, 0, IP_MULTICAST_TTL, &val as *const i32 as *const u8, 4);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

/// Joins a multicast group.
pub fn udp_join_multicast(socket: &UdpSocket, multicast_addr: &Ipv4Addr, interface: &Ipv4Addr) -> Result<(), TcpError> with IO {
    // ip_mreq structure
    var mreq: [u8; 8] = [0u8; 8];
    mreq[0] = multicast_addr.octets[0];
    mreq[1] = multicast_addr.octets[1];
    mreq[2] = multicast_addr.octets[2];
    mreq[3] = multicast_addr.octets[3];
    mreq[4] = interface.octets[0];
    mreq[5] = interface.octets[1];
    mreq[6] = interface.octets[2];
    mreq[7] = interface.octets[3];

    let result = setsockopt(socket.fd, 0, IP_ADD_MEMBERSHIP, &mreq[0], 8);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

/// Leaves a multicast group.
pub fn udp_leave_multicast(socket: &UdpSocket, multicast_addr: &Ipv4Addr, interface: &Ipv4Addr) -> Result<(), TcpError> with IO {
    var mreq: [u8; 8] = [0u8; 8];
    mreq[0] = multicast_addr.octets[0];
    mreq[1] = multicast_addr.octets[1];
    mreq[2] = multicast_addr.octets[2];
    mreq[3] = multicast_addr.octets[3];
    mreq[4] = interface.octets[0];
    mreq[5] = interface.octets[1];
    mreq[6] = interface.octets[2];
    mreq[7] = interface.octets[3];

    let result = setsockopt(socket.fd, 0, IP_DROP_MEMBERSHIP, &mreq[0], 8);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

/// Sets non-blocking mode.
pub fn udp_set_nonblocking(socket: &UdpSocket, nonblocking: bool) -> Result<(), TcpError> with IO {
    let flags = fcntl(socket.fd, F_GETFL, 0);
    if flags < 0 {
        return Err(tcp_error_from_errno(get_errno()))
    }

    let new_flags = if nonblocking {
        flags | O_NONBLOCK
    } else {
        flags & !O_NONBLOCK
    };

    let result = fcntl(socket.fd, F_SETFL, new_flags);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

/// Sets the receive buffer size.
pub fn udp_set_recv_buffer_size(socket: &UdpSocket, size: i32) -> Result<(), TcpError> with IO {
    let result = setsockopt(socket.fd, SOL_SOCKET, SO_RCVBUF, &size as *const i32 as *const u8, 4);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

/// Sets the send buffer size.
pub fn udp_set_send_buffer_size(socket: &UdpSocket, size: i32) -> Result<(), TcpError> with IO {
    let result = setsockopt(socket.fd, SOL_SOCKET, SO_SNDBUF, &size as *const i32 as *const u8, 4);
    if result < 0 {
        Err(tcp_error_from_errno(get_errno()))
    } else {
        Ok(())
    }
}

// =============================================================================
// Helper Functions
// =============================================================================

fn build_udp_sockaddr(addr: &SocketAddr) -> (Vec<u8>, u32) with Alloc {
    match &addr.ip {
        IpAddr::V4(v4) => {
            var buf: Vec<u8> = Vec::with_capacity(16);
            buf.resize(16, 0u8);

            buf[0] = AF_INET as u8;
            buf[1] = 0;
            buf[2] = (addr.port >> 8) as u8;
            buf[3] = addr.port as u8;
            buf[4] = v4.octets[0];
            buf[5] = v4.octets[1];
            buf[6] = v4.octets[2];
            buf[7] = v4.octets[3];

            (buf, 16)
        },
        IpAddr::V6(v6) => {
            var buf: Vec<u8> = Vec::with_capacity(28);
            buf.resize(28, 0u8);

            buf[0] = AF_INET6 as u8;
            buf[1] = 0;
            buf[2] = (addr.port >> 8) as u8;
            buf[3] = addr.port as u8;

            var i: usize = 0;
            while i < 16 {
                buf[8 + i] = v6.octets[i];
                i = i + 1;
            }

            (buf, 28)
        }
    }
}

fn parse_udp_sockaddr(buf: &[u8], len: u32) -> Option<SocketAddr> with Alloc {
    if len < 8 {
        return None
    }

    let family = buf[0] as i32;

    if family == AF_INET && len >= 16 {
        let port = ((buf[2] as u16) << 8) | (buf[3] as u16);
        let addr = ipv4_new(buf[4], buf[5], buf[6], buf[7]);
        Some(socket_addr_v4(addr, port))
    } else if family == AF_INET6 && len >= 28 {
        let port = ((buf[2] as u16) << 8) | (buf[3] as u16);
        var octets: [u8; 16] = [0u8; 16];
        var i: usize = 0;
        while i < 16 {
            octets[i] = buf[8 + i];
            i = i + 1;
        }
        Some(socket_addr_v6(Ipv6Addr { octets }, port))
    } else {
        None
    }
}
