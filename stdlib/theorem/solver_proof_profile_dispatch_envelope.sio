//! stdlib/theorem/solver_proof_profile_dispatch_envelope.sio
//!
//! Local dispatch/query envelope (status 91) for the shared solver proof
//! profile. It exposes the profile receipt (artifact 964210753, status 88) to a
//! local solver-router query: a valid query (profile anchors match, accepted
//! profile mask correct, all claim masks zero) returns the profile artifact;
//! mismatches return -1. This is a local router-readiness receipt. The shared
//! profile is cross-family, so this envelope does NOT assert a target integer
//! width (unlike the Lorenz i256 bridges) and makes no native/i256/runtime
//! claim.

use theorem::solver_proof_profile::*

pub fn solver_proof_profile_dispatch_mask(
    profile_artifact_fp: i64,
    accepted_profile_mask: i64,
    rejected_profile_mask: i64,
    profile_status: i64,
    query_scope_ok: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    global_flowpipe_claim_mask: i64) -> i64 {
    var mask = 0
    if profile_artifact_fp == 964210753 { mask = mask + 1 }
    if accepted_profile_mask == 15 { mask = mask + 2 }
    if rejected_profile_mask == 48 { mask = mask + 4 }
    if profile_status == 88 { mask = mask + 8 }
    if query_scope_ok == 1 { mask = mask + 16 }
    if public_claim_mask == 0 {
        if formal_theorem_ready == 0 {
            if global_flowpipe_claim_mask == 0 { mask = mask + 32 }
        }
    }
    return mask
}

pub fn solver_proof_profile_dispatch_query(
    profile_artifact_fp: i64,
    accepted_profile_mask: i64,
    rejected_profile_mask: i64,
    profile_status: i64,
    dispatch_mask: i64,
    query_scope_ok: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    global_flowpipe_claim_mask: i64,
    limb_base: i64) -> i64 {
    if profile_artifact_fp != 964210753 { return 0 - 1 }
    if accepted_profile_mask != 15 { return 0 - 1 }
    if rejected_profile_mask != 48 { return 0 - 1 }
    if profile_status != 88 { return 0 - 1 }
    if dispatch_mask != 63 { return 0 - 1 }
    if query_scope_ok != 1 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return 964210753
}

pub fn solver_proof_profile_dispatch_envelope_fingerprint(
    profile_artifact_fp: i64,
    dispatch_mask: i64,
    accepted_profile_mask: i64,
    profile_status: i64,
    bridge_status: i64,
    limb_base: i64) -> i64 with Div {
    if profile_artifact_fp != 964210753 { return 0 - 1 }
    if dispatch_mask != 63 { return 0 - 1 }
    if accepted_profile_mask != 15 { return 0 - 1 }
    if profile_status != 88 { return 0 - 1 }
    if bridge_status != 123 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    return (profile_artifact_fp + (29 * dispatch_mask) + (31 * accepted_profile_mask) + (37 * profile_status) + (41 * bridge_status)) % limb_base
}

pub fn solver_proof_profile_dispatch_receipt_check(
    profile_anchor_ok: i64,
    dispatch_mask_ok: i64,
    query_ok: i64,
    envelope_fp_ok: i64,
    claim_masks_zero_ok: i64,
    limb_base: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    global_flowpipe_claim_mask: i64,
    bridge_status: i64) -> i64 {
    if profile_anchor_ok != 1 { return 0 - 1 }
    if dispatch_mask_ok != 1 { return 0 - 1 }
    if query_ok != 1 { return 0 - 1 }
    if envelope_fp_ok != 1 { return 0 - 1 }
    if claim_masks_zero_ok != 1 { return 0 - 1 }
    if limb_base != 1000000000 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if bridge_status != 123 { return 0 - 1 }
    return 382940617
}
