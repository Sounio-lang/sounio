//! stdlib/theorem/sat_rup_microkernel.sio
//!
//! Small scalar SAT/RUP proof-checker kernel. This is a bounded microkernel for
//! three clauses over variables 1..3, intended as an executable seed for the
//! SAT/LRAT/FRAT family. It is not a full LRAT parser, not a SAT solver, and not
//! imported/native runtime evidence.

fn sat_abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn sat_lit_var(lit: i64) -> i64 {
    return sat_abs_i64(lit)
}

fn sat_pack(v1: i64, v2: i64, v3: i64) -> i64 {
    if v1 < 0 - 1 { return 0 - 1 }
    if v1 > 1 { return 0 - 1 }
    if v2 < 0 - 1 { return 0 - 1 }
    if v2 > 1 { return 0 - 1 }
    if v3 < 0 - 1 { return 0 - 1 }
    if v3 > 1 { return 0 - 1 }
    return (v1 + 1) + (3 * (v2 + 1)) + (9 * (v3 + 1))
}

fn sat_pack_get(pack: i64, var_id: i64) -> i64 {
    if pack < 0 { return 0 - 2 }
    if var_id == 1 { return (pack % 3) - 1 }
    if var_id == 2 { return ((pack / 3) % 3) - 1 }
    if var_id == 3 { return ((pack / 9) % 3) - 1 }
    return 0 - 2
}

fn sat_pack_set(pack: i64, var_id: i64, val: i64) -> i64 {
    if val < 0 - 1 { return 0 - 1 }
    if val > 1 { return 0 - 1 }
    let old = sat_pack_get(pack, var_id)
    if old == 0 - 2 { return 0 - 1 }
    if old != 0 {
        if old != val { return 0 - 1 }
        return pack
    }
    let v1 = sat_pack_get(pack, 1)
    let v2 = sat_pack_get(pack, 2)
    let v3 = sat_pack_get(pack, 3)
    if var_id == 1 { return sat_pack(val, v2, v3) }
    if var_id == 2 { return sat_pack(v1, val, v3) }
    if var_id == 3 { return sat_pack(v1, v2, val) }
    return 0 - 1
}

fn sat_assign_lit_true(pack: i64, lit: i64) -> i64 {
    let var_id = sat_lit_var(lit)
    if var_id < 1 { return 0 - 1 }
    if var_id > 3 { return 0 - 1 }
    var val: i64 = 1
    if lit < 0 { val = 0 - 1 }
    return sat_pack_set(pack, var_id, val)
}

fn sat_assign_lit_false(pack: i64, lit: i64) -> i64 {
    let var_id = sat_lit_var(lit)
    if var_id < 1 { return 0 - 1 }
    if var_id > 3 { return 0 - 1 }
    var val: i64 = 0 - 1
    if lit < 0 { val = 1 }
    return sat_pack_set(pack, var_id, val)
}

fn sat_lit_value(pack: i64, lit: i64) -> i64 {
    if lit == 0 { return 0 }
    let var_id = sat_lit_var(lit)
    let val = sat_pack_get(pack, var_id)
    if val == 0 - 2 { return 0 - 2 }
    if val == 0 { return 0 }
    if lit > 0 { return val }
    return 0 - val
}

fn sat_clause_tautology3(l1: i64, l2: i64, l3: i64) -> i64 {
    if l1 != 0 {
        if l1 + l2 == 0 { return 1 }
        if l1 + l3 == 0 { return 1 }
    }
    if l2 != 0 {
        if l2 + l3 == 0 { return 1 }
    }
    return 0
}

fn sat_clause_unit_or_conflict3(pack: i64, l1: i64, l2: i64, l3: i64) -> i64 {
    var unknown_count: i64 = 0
    var unit_lit: i64 = 0

    if l1 != 0 {
        let v1 = sat_lit_value(pack, l1)
        if v1 == 1 { return 0 }
        if v1 == 0 { unknown_count = unknown_count + 1; unit_lit = l1 }
        if v1 == 0 - 2 { return 0 - 2 }
    }
    if l2 != 0 {
        let v2 = sat_lit_value(pack, l2)
        if v2 == 1 { return 0 }
        if v2 == 0 { unknown_count = unknown_count + 1; unit_lit = l2 }
        if v2 == 0 - 2 { return 0 - 2 }
    }
    if l3 != 0 {
        let v3 = sat_lit_value(pack, l3)
        if v3 == 1 { return 0 }
        if v3 == 0 { unknown_count = unknown_count + 1; unit_lit = l3 }
        if v3 == 0 - 2 { return 0 - 2 }
    }

    if unknown_count == 0 { return 0 - 999 }
    if unknown_count == 1 { return unit_lit }
    return 0
}

fn sat_rup3_step(pack: i64,
                 c1_l1: i64, c1_l2: i64, c1_l3: i64,
                 c2_l1: i64, c2_l2: i64, c2_l3: i64,
                 c3_l1: i64, c3_l2: i64, c3_l3: i64) -> i64 {
    let u1 = sat_clause_unit_or_conflict3(pack, c1_l1, c1_l2, c1_l3)
    if u1 == 0 - 999 { return 0 - 2 }
    if u1 == 0 - 2 { return 0 - 2 }
    if u1 != 0 { return sat_assign_lit_true(pack, u1) }

    let u2 = sat_clause_unit_or_conflict3(pack, c2_l1, c2_l2, c2_l3)
    if u2 == 0 - 999 { return 0 - 2 }
    if u2 == 0 - 2 { return 0 - 2 }
    if u2 != 0 { return sat_assign_lit_true(pack, u2) }

    let u3 = sat_clause_unit_or_conflict3(pack, c3_l1, c3_l2, c3_l3)
    if u3 == 0 - 999 { return 0 - 2 }
    if u3 == 0 - 2 { return 0 - 2 }
    if u3 != 0 { return sat_assign_lit_true(pack, u3) }

    return pack
}

pub fn sat_rup3_check(
    c1_l1: i64, c1_l2: i64, c1_l3: i64,
    c2_l1: i64, c2_l2: i64, c2_l3: i64,
    c3_l1: i64, c3_l2: i64, c3_l3: i64,
    cand_l1: i64, cand_l2: i64, cand_l3: i64) -> i64 {
    if sat_clause_tautology3(cand_l1, cand_l2, cand_l3) != 0 { return 0 }

    var pack = sat_pack(0, 0, 0)
    if cand_l1 != 0 { pack = sat_assign_lit_false(pack, cand_l1) }
    if pack < 0 { return 0 }
    if cand_l2 != 0 { pack = sat_assign_lit_false(pack, cand_l2) }
    if pack < 0 { return 0 }
    if cand_l3 != 0 { pack = sat_assign_lit_false(pack, cand_l3) }
    if pack < 0 { return 0 }

    var i: i64 = 0
    while i < 8 {
        let next = sat_rup3_step(
            pack,
            c1_l1, c1_l2, c1_l3,
            c2_l1, c2_l2, c2_l3,
            c3_l1, c3_l2, c3_l3)
        if next == 0 - 2 { return 1 }
        if next < 0 { return 0 }
        if next == pack { return 0 }
        pack = next
        i = i + 1
    }
    return 0
}

pub fn sat_rup_microkernel_receipt_check(
    tiny_empty_rup_ok: i64,
    wrong_formula_rejected: i64,
    tautology_candidate_rejected: i64,
    public_claim_mask: i64,
    imported_runtime_evidence_mask: i64,
    microkernel_status: i64) -> i64 {
    if tiny_empty_rup_ok != 1 { return 0 - 1 }
    if wrong_formula_rejected != 1 { return 0 - 1 }
    if tautology_candidate_rejected != 1 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if microkernel_status != 97 { return 0 - 1 }
    return 715284039
}

pub fn sat_rup_microkernel_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    tiny_empty_rup_ok: i64,
    wrong_formula_rejected: i64,
    tautology_candidate_rejected: i64,
    family_mask: i64,
    proof_format_mask: i64,
    current_runtime_family_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    microkernel_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 715284039 { return 0 - 1 }
    if instance_fp != 806157423 { return 0 - 1 }
    if certificate_fp != 129640587 { return 0 - 1 }
    if tiny_empty_rup_ok != 1 { return 0 - 1 }
    if wrong_formula_rejected != 1 { return 0 - 1 }
    if tautology_candidate_rejected != 1 { return 0 - 1 }
    if family_mask != 3 { return 0 - 1 }
    if proof_format_mask != 6 { return 0 - 1 }
    if current_runtime_family_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if microkernel_status != 97 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 304918672
}

pub fn sat_rup_chain_unit_then_empty_check(
    base1_l1: i64, base1_l2: i64, base1_l3: i64,
    base2_l1: i64, base2_l2: i64, base2_l3: i64,
    conflict_l1: i64, conflict_l2: i64, conflict_l3: i64,
    derived_unit_lit: i64) -> i64 {
    if derived_unit_lit == 0 { return 0 }

    let unit_ok = sat_rup3_check(
        base1_l1, base1_l2, base1_l3,
        base2_l1, base2_l2, base2_l3,
        3, 0 - 3, 0,
        derived_unit_lit, 0, 0)
    if unit_ok != 1 { return 0 }

    let empty_ok = sat_rup3_check(
        derived_unit_lit, 0, 0,
        conflict_l1, conflict_l2, conflict_l3,
        3, 0 - 3, 0,
        0, 0, 0)
    if empty_ok != 1 { return 0 }
    return 1
}

pub fn sat_rup_chain_microkernel_receipt_check(
    base_microkernel_fp: i64,
    base_microkernel_audit_fp: i64,
    derived_unit_rup_ok: i64,
    chained_empty_rup_ok: i64,
    wrong_derived_unit_rejected: i64,
    wrong_conflict_clause_rejected: i64,
    public_claim_mask: i64,
    imported_runtime_evidence_mask: i64,
    chain_status: i64) -> i64 {
    if base_microkernel_fp != 715284039 { return 0 - 1 }
    if base_microkernel_audit_fp != 304918672 { return 0 - 1 }
    if derived_unit_rup_ok != 1 { return 0 - 1 }
    if chained_empty_rup_ok != 1 { return 0 - 1 }
    if wrong_derived_unit_rejected != 1 { return 0 - 1 }
    if wrong_conflict_clause_rejected != 1 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if chain_status != 98 { return 0 - 1 }
    return 428619705
}

pub fn sat_rup_chain_microkernel_audit_fingerprint(
    artifact_fp: i64,
    audit_parent_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    base_microkernel_fp: i64,
    base_microkernel_audit_fp: i64,
    derived_unit_rup_ok: i64,
    chained_empty_rup_ok: i64,
    wrong_derived_unit_rejected: i64,
    wrong_conflict_clause_rejected: i64,
    family_mask: i64,
    proof_format_mask: i64,
    current_runtime_family_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    chain_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 428619705 { return 0 - 1 }
    if audit_parent_fp != 304918672 { return 0 - 1 }
    if instance_fp != 572803941 { return 0 - 1 }
    if certificate_fp != 248619370 { return 0 - 1 }
    if base_microkernel_fp != 715284039 { return 0 - 1 }
    if base_microkernel_audit_fp != 304918672 { return 0 - 1 }
    if derived_unit_rup_ok != 1 { return 0 - 1 }
    if chained_empty_rup_ok != 1 { return 0 - 1 }
    if wrong_derived_unit_rejected != 1 { return 0 - 1 }
    if wrong_conflict_clause_rejected != 1 { return 0 - 1 }
    if family_mask != 3 { return 0 - 1 }
    if proof_format_mask != 6 { return 0 - 1 }
    if current_runtime_family_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if chain_status != 98 { return 0 - 1 }
    if ok_mask != 511 { return 0 - 1 }
    return 917264038
}
