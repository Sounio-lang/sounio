// Sounio Proof Kernel — Core Proof Infrastructure
//
// Propositions-as-types, proof witnesses, natural deduction.
// Every Proof carries confidence — the fundamental departure from Lean/Coq.
//
// Mirrors the compiler's dependent/proofs.rs ProofKind (18 constructors)
// at the user level as a composable .sio API.
//
// Reference:
//   Curry-Howard correspondence (propositions = types, proofs = programs)
//   Sounio formal/lean4/SounioEpistemic.lean (confidence lattice)

extern "C" {
    fn sqrt(x: f64) -> f64;
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

// ============================================================================
// PROPOSITION ARENA
// ============================================================================

// Maximum propositions in a single proof context
let PROP_ARENA_CAP: i64 = 4096

// Proposition tags
let PROP_TRUE: i32 = 0
let PROP_FALSE: i32 = 1
let PROP_AND: i32 = 2
let PROP_OR: i32 = 3
let PROP_IMPLIES: i32 = 4
let PROP_NOT: i32 = 5
let PROP_FORALL: i32 = 6
let PROP_EXISTS: i32 = 7
let PROP_EQ: i32 = 8
let PROP_CUSTOM: i32 = 9

// Proposition: tag-encoded logical claim
// Uses integer IDs to reference sub-propositions (arena-style, no recursion)
struct Prop {
    tag: i32,
    left_id: i64,       // sub-proposition (for And, Or, Implies, Not)
    right_id: i64,       // sub-proposition (for And, Or, Implies)
    var_name: i64,       // quantifier variable (for Forall, Exists)
    predicate_id: i64,   // custom predicate (for Eq, Custom)
    eq_lhs: i64,         // equality left (for Eq)
    eq_rhs: i64,         // equality right (for Eq)
}

// Arena: flat storage for propositions
struct PropArena {
    tags: [i32; 4096],
    left_ids: [i64; 4096],
    right_ids: [i64; 4096],
    var_names: [i64; 4096],
    predicate_ids: [i64; 4096],
    eq_lhs_vals: [i64; 4096],
    eq_rhs_vals: [i64; 4096],
    count: i64,
}

fn arena_new() -> PropArena {
    return PropArena {
        tags: [0; 4096],
        left_ids: [0; 4096],
        right_ids: [0; 4096],
        var_names: [0; 4096],
        predicate_ids: [0; 4096],
        eq_lhs_vals: [0; 4096],
        eq_rhs_vals: [0; 4096],
        count: 0,
    }
}

fn arena_alloc(arena: &! PropArena, p: Prop) -> i64 {
    let idx = arena.count
    if idx >= PROP_ARENA_CAP {
        return 0 - 1  // overflow sentinel
    }
    arena.tags[idx] = p.tag
    arena.left_ids[idx] = p.left_id
    arena.right_ids[idx] = p.right_id
    arena.var_names[idx] = p.var_name
    arena.predicate_ids[idx] = p.predicate_id
    arena.eq_lhs_vals[idx] = p.eq_lhs
    arena.eq_rhs_vals[idx] = p.eq_rhs
    arena.count = idx + 1
    return idx
}

fn arena_get(arena: &PropArena, idx: i64) -> Prop {
    if idx < 0 {
        return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
    }
    if idx >= arena.count {
        return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
    }
    return Prop {
        tag: arena.tags[idx],
        left_id: arena.left_ids[idx],
        right_id: arena.right_ids[idx],
        var_name: arena.var_names[idx],
        predicate_id: arena.predicate_ids[idx],
        eq_lhs: arena.eq_lhs_vals[idx],
        eq_rhs: arena.eq_rhs_vals[idx],
    }
}

// ============================================================================
// PROPOSITION CONSTRUCTORS
// ============================================================================

fn prop_true() -> Prop {
    return Prop { tag: PROP_TRUE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_false() -> Prop {
    return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_and(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: PROP_AND, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_or(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: PROP_OR, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_implies(antecedent_id: i64, consequent_id: i64) -> Prop {
    return Prop { tag: PROP_IMPLIES, left_id: antecedent_id, right_id: consequent_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_not(inner_id: i64) -> Prop {
    return Prop { tag: PROP_NOT, left_id: inner_id, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_forall(var_id: i64, body_id: i64) -> Prop {
    return Prop { tag: PROP_FORALL, left_id: body_id, right_id: 0, var_name: var_id, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_exists(var_id: i64, body_id: i64) -> Prop {
    return Prop { tag: PROP_EXISTS, left_id: body_id, right_id: 0, var_name: var_id, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_eq(lhs: i64, rhs: i64) -> Prop {
    return Prop { tag: PROP_EQ, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: lhs, eq_rhs: rhs }
}

// P <-> Q  is  (P -> Q) /\ (Q -> P)
fn prop_iff(p_id: i64, q_id: i64) -> Prop {
    return Prop { tag: PROP_AND, left_id: p_id, right_id: q_id, var_name: 0, predicate_id: 1, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_custom(pred_id: i64) -> Prop {
    return Prop { tag: PROP_CUSTOM, left_id: 0, right_id: 0, var_name: 0, predicate_id: pred_id, eq_lhs: 0, eq_rhs: 0 }
}

// ============================================================================
// PROOF TAGS
// ============================================================================

let PROOF_REFL: i32 = 0
let PROOF_AND_INTRO: i32 = 1
let PROOF_AND_ELIM_L: i32 = 2
let PROOF_AND_ELIM_R: i32 = 3
let PROOF_OR_INTRO_L: i32 = 4
let PROOF_OR_INTRO_R: i32 = 5
let PROOF_OR_ELIM: i32 = 6
let PROOF_IMPL_INTRO: i32 = 7
let PROOF_IMPL_ELIM: i32 = 8
let PROOF_NOT_INTRO: i32 = 9
let PROOF_NOT_ELIM: i32 = 10
let PROOF_FALSE_ELIM: i32 = 11
let PROOF_FORALL_INTRO: i32 = 12
let PROOF_FORALL_ELIM: i32 = 13
let PROOF_EXISTS_INTRO: i32 = 14
let PROOF_EXISTS_ELIM: i32 = 15
let PROOF_SYM: i32 = 16
let PROOF_TRANS: i32 = 17
let PROOF_CONG: i32 = 18
let PROOF_SUBST: i32 = 19
let PROOF_COMPOSE: i32 = 20
let PROOF_WEAKEN: i32 = 21
let PROOF_TRUSTED: i32 = 22
let PROOF_ASSUME: i32 = 23
let PROOF_RUNTIME: i32 = 24
let PROOF_TRUE_INTRO: i32 = 25

// ============================================================================
// PROOF WITNESS
// ============================================================================

// A proof of a proposition. Carries confidence — the Sounio novelty.
// confidence = 1.0 means fully verified (like Lean/Coq).
// confidence < 1.0 means epistemic evidence (unique to Sounio).
struct Proof {
    tag: i32,
    // The proposition this witnesses (arena index)
    prop_id: i64,
    // Sub-proofs (indices into proof store)
    sub1_id: i64,
    sub2_id: i64,
    sub3_id: i64,
    // Metadata
    label: i64,
    // THE KEY FIELD: confidence in this proof
    // 1.0 = verified, < 1.0 = epistemic evidence
    confidence: f64,
    // Witness value (for exists_intro, forall_elim, etc.)
    witness: i64,
}

// Proof store (flat arena, mirrors proposition arena)
struct ProofStore {
    tags: [i32; 4096],
    prop_ids: [i64; 4096],
    sub1_ids: [i64; 4096],
    sub2_ids: [i64; 4096],
    sub3_ids: [i64; 4096],
    labels: [i64; 4096],
    confidences: [f64; 4096],
    witnesses: [i64; 4096],
    count: i64,
}

fn proof_store_new() -> ProofStore {
    return ProofStore {
        tags: [0; 4096],
        prop_ids: [0; 4096],
        sub1_ids: [0; 4096],
        sub2_ids: [0; 4096],
        sub3_ids: [0; 4096],
        labels: [0; 4096],
        confidences: [0.0; 4096],
        witnesses: [0; 4096],
        count: 0,
    }
}

fn proof_store_alloc(store: &! ProofStore, p: Proof) -> i64 {
    let idx = store.count
    if idx >= 4096 {
        return 0 - 1
    }
    store.tags[idx] = p.tag
    store.prop_ids[idx] = p.prop_id
    store.sub1_ids[idx] = p.sub1_id
    store.sub2_ids[idx] = p.sub2_id
    store.sub3_ids[idx] = p.sub3_id
    store.labels[idx] = p.label
    store.confidences[idx] = p.confidence
    store.witnesses[idx] = p.witness
    store.count = idx + 1
    return idx
}

fn proof_store_get(store: &ProofStore, idx: i64) -> Proof {
    if idx < 0 {
        return Proof { tag: 0 - 1, prop_id: 0, sub1_id: 0, sub2_id: 0, sub3_id: 0, label: 0, confidence: 0.0, witness: 0 }
    }
    if idx >= store.count {
        return Proof { tag: 0 - 1, prop_id: 0, sub1_id: 0, sub2_id: 0, sub3_id: 0, label: 0, confidence: 0.0, witness: 0 }
    }
    return Proof {
        tag: store.tags[idx],
        prop_id: store.prop_ids[idx],
        sub1_id: store.sub1_ids[idx],
        sub2_id: store.sub2_ids[idx],
        sub3_id: store.sub3_ids[idx],
        label: store.labels[idx],
        confidence: store.confidences[idx],
        witness: store.witnesses[idx],
    }
}

// ============================================================================
// VERIFICATION RESULT
// ============================================================================

struct VerifyResult {
    is_valid: bool,
    confidence: f64,
    reason: i32,     // 0=ok, 1=tag_mismatch, 2=prop_mismatch, 3=confidence_invalid
}

fn verify_ok(conf: f64) -> VerifyResult {
    return VerifyResult { is_valid: true, confidence: conf, reason: 0 }
}

fn verify_fail(reason: i32) -> VerifyResult {
    return VerifyResult { is_valid: false, confidence: 0.0, reason: reason }
}

// ============================================================================
// PROOF CONTEXT — binds arena + proof store together
// ============================================================================

struct ProofContext {
    arena: PropArena,
    store: ProofStore,
}

fn proof_context_new() -> ProofContext {
    return ProofContext {
        arena: arena_new(),
        store: proof_store_new(),
    }
}

// Allocate a proposition in the context, return its ID
fn ctx_prop(ctx: &! ProofContext, p: Prop) -> i64 {
    return arena_alloc(&! ctx.arena, p)
}

// Allocate a proof in the context, return its ID
fn ctx_proof(ctx: &! ProofContext, p: Proof) -> i64 {
    return proof_store_alloc(&! ctx.store, p)
}

// Retrieve a proposition
fn ctx_get_prop(ctx: &ProofContext, id: i64) -> Prop {
    return arena_get(&ctx.arena, id)
}

// Retrieve a proof
fn ctx_get_proof(ctx: &ProofContext, id: i64) -> Proof {
    return proof_store_get(&ctx.store, id)
}

// ============================================================================
// NATURAL DEDUCTION: INTRODUCTION RULES
// ============================================================================

// True introduction: trivially provable
fn true_intro(ctx: &! ProofContext) -> i64 {
    let p_id = ctx_prop(ctx, prop_true())
    let prf = Proof {
        tag: PROOF_TRUE_INTRO,
        prop_id: p_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 1.0, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// And introduction: from P, Q derive P /\ Q
fn and_intro(ctx: &! ProofContext, p_proof_id: i64, q_proof_id: i64, pq_prop_id: i64) -> i64 {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let conf = min_f64(p_prf.confidence, q_prf.confidence)
    let prf = Proof {
        tag: PROOF_AND_INTRO,
        prop_id: pq_prop_id,
        sub1_id: p_proof_id,
        sub2_id: q_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or introduction left: from P derive P \/ Q
fn or_intro_left(ctx: &! ProofContext, p_proof_id: i64, pq_prop_id: i64) -> i64 {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let prf = Proof {
        tag: PROOF_OR_INTRO_L,
        prop_id: pq_prop_id,
        sub1_id: p_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: p_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or introduction right: from Q derive P \/ Q
fn or_intro_right(ctx: &! ProofContext, q_proof_id: i64, pq_prop_id: i64) -> i64 {
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let prf = Proof {
        tag: PROOF_OR_INTRO_R,
        prop_id: pq_prop_id,
        sub1_id: q_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: q_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Implication introduction: assuming P (sub1), we proved Q (sub2) => P -> Q
fn impl_intro(ctx: &! ProofContext, assume_id: i64, q_proof_id: i64, impl_prop_id: i64) -> i64 {
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let prf = Proof {
        tag: PROOF_IMPL_INTRO,
        prop_id: impl_prop_id,
        sub1_id: assume_id,
        sub2_id: q_proof_id,
        sub3_id: 0,
        label: 0, confidence: q_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Negation introduction: assuming P, derive False => ~P
fn not_intro(ctx: &! ProofContext, assume_id: i64, false_proof_id: i64, not_prop_id: i64) -> i64 {
    let f_prf = ctx_get_proof(ctx, false_proof_id)
    let prf = Proof {
        tag: PROOF_NOT_INTRO,
        prop_id: not_prop_id,
        sub1_id: assume_id,
        sub2_id: false_proof_id,
        sub3_id: 0,
        label: 0, confidence: f_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Universal introduction: for arbitrary x, prove P(x) => forall x. P(x)
fn forall_intro(ctx: &! ProofContext, body_proof_id: i64, forall_prop_id: i64) -> i64 {
    let body = ctx_get_proof(ctx, body_proof_id)
    let prf = Proof {
        tag: PROOF_FORALL_INTRO,
        prop_id: forall_prop_id,
        sub1_id: body_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: body.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Existential introduction: from P(t), derive exists x. P(x)
fn exists_intro(ctx: &! ProofContext, witness_val: i64, body_proof_id: i64, exists_prop_id: i64) -> i64 {
    let body = ctx_get_proof(ctx, body_proof_id)
    let prf = Proof {
        tag: PROOF_EXISTS_INTRO,
        prop_id: exists_prop_id,
        sub1_id: body_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: body.confidence, witness: witness_val,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// NATURAL DEDUCTION: ELIMINATION RULES
// ============================================================================

// And elimination left: from P /\ Q derive P
fn and_elim_left(ctx: &! ProofContext, pq_proof_id: i64, p_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let prf = Proof {
        tag: PROOF_AND_ELIM_L,
        prop_id: p_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// And elimination right: from P /\ Q derive Q
fn and_elim_right(ctx: &! ProofContext, pq_proof_id: i64, q_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let prf = Proof {
        tag: PROOF_AND_ELIM_R,
        prop_id: q_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or elimination: from P \/ Q, P-case proof, Q-case proof => R
fn or_elim(ctx: &! ProofContext, pq_proof_id: i64, p_case_id: i64, q_case_id: i64, r_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let p_case = ctx_get_proof(ctx, p_case_id)
    let q_case = ctx_get_proof(ctx, q_case_id)
    let conf = min_f64(pq.confidence, min_f64(p_case.confidence, q_case.confidence))
    let prf = Proof {
        tag: PROOF_OR_ELIM,
        prop_id: r_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: p_case_id,
        sub3_id: q_case_id,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Modus ponens: from P -> Q, P => Q
fn impl_elim(ctx: &! ProofContext, impl_proof_id: i64, p_proof_id: i64, q_prop_id: i64) -> i64 {
    let impl_prf = ctx_get_proof(ctx, impl_proof_id)
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let conf = min_f64(impl_prf.confidence, p_prf.confidence)
    let prf = Proof {
        tag: PROOF_IMPL_ELIM,
        prop_id: q_prop_id,
        sub1_id: impl_proof_id,
        sub2_id: p_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Negation elimination: from ~P, P => False
fn not_elim(ctx: &! ProofContext, not_p_id: i64, p_proof_id: i64) -> i64 {
    let np = ctx_get_proof(ctx, not_p_id)
    let pp = ctx_get_proof(ctx, p_proof_id)
    let false_prop = ctx_prop(ctx, prop_false())
    let conf = min_f64(np.confidence, pp.confidence)
    let prf = Proof {
        tag: PROOF_NOT_ELIM,
        prop_id: false_prop,
        sub1_id: not_p_id,
        sub2_id: p_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Ex falso quodlibet: from False, derive anything
fn false_elim(ctx: &! ProofContext, false_proof_id: i64, target_prop_id: i64) -> i64 {
    let fp = ctx_get_proof(ctx, false_proof_id)
    let prf = Proof {
        tag: PROOF_FALSE_ELIM,
        prop_id: target_prop_id,
        sub1_id: false_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: fp.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Universal elimination: from forall x. P(x), instantiate at term t => P(t)
fn forall_elim(ctx: &! ProofContext, forall_proof_id: i64, term: i64, result_prop_id: i64) -> i64 {
    let fp = ctx_get_proof(ctx, forall_proof_id)
    let prf = Proof {
        tag: PROOF_FORALL_ELIM,
        prop_id: result_prop_id,
        sub1_id: forall_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: fp.confidence, witness: term,
    }
    return ctx_proof(ctx, prf)
}

// Existential elimination: from (exists x. P(x)), use the witness
fn exists_elim(ctx: &! ProofContext, exists_proof_id: i64, body_proof_id: i64, result_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, exists_proof_id)
    let bp = ctx_get_proof(ctx, body_proof_id)
    let conf = min_f64(ep.confidence, bp.confidence)
    let prf = Proof {
        tag: PROOF_EXISTS_ELIM,
        prop_id: result_prop_id,
        sub1_id: exists_proof_id,
        sub2_id: body_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// EQUALITY
// ============================================================================

// Reflexivity: a = a
fn refl(ctx: &! ProofContext, a: i64) -> i64 {
    let eq_prop = ctx_prop(ctx, prop_eq(a, a))
    let prf = Proof {
        tag: PROOF_REFL,
        prop_id: eq_prop,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 1.0, witness: a,
    }
    return ctx_proof(ctx, prf)
}

// Symmetry: a = b => b = a
fn sym(ctx: &! ProofContext, eq_proof_id: i64, ba_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let prf = Proof {
        tag: PROOF_SYM,
        prop_id: ba_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: ep.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Transitivity: a = b, b = c => a = c
fn trans(ctx: &! ProofContext, ab_proof_id: i64, bc_proof_id: i64, ac_prop_id: i64) -> i64 {
    let ab = ctx_get_proof(ctx, ab_proof_id)
    let bc = ctx_get_proof(ctx, bc_proof_id)
    let conf = min_f64(ab.confidence, bc.confidence)
    let prf = Proof {
        tag: PROOF_TRANS,
        prop_id: ac_prop_id,
        sub1_id: ab_proof_id,
        sub2_id: bc_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Congruence: a = b => f(a) = f(b)
fn cong(ctx: &! ProofContext, f_id: i64, eq_proof_id: i64, result_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let prf = Proof {
        tag: PROOF_CONG,
        prop_id: result_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: f_id, confidence: ep.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Substitution: a = b, P(a) => P(b)
fn subst(ctx: &! ProofContext, eq_proof_id: i64, pa_proof_id: i64, pb_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let pa = ctx_get_proof(ctx, pa_proof_id)
    let conf = min_f64(ep.confidence, pa.confidence)
    let prf = Proof {
        tag: PROOF_SUBST,
        prop_id: pb_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: pa_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// PROOF COMPOSITION
// ============================================================================

// Chain two proofs together
fn compose(ctx: &! ProofContext, p1_id: i64, p2_id: i64, result_prop_id: i64) -> i64 {
    let p1 = ctx_get_proof(ctx, p1_id)
    let p2 = ctx_get_proof(ctx, p2_id)
    let conf = min_f64(p1.confidence, p2.confidence)
    let prf = Proof {
        tag: PROOF_COMPOSE,
        prop_id: result_prop_id,
        sub1_id: p1_id,
        sub2_id: p2_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Weaken: add unused hypothesis (proof still holds, confidence unchanged)
fn weaken(ctx: &! ProofContext, proof_id: i64, extra_prop_id: i64) -> i64 {
    let p = ctx_get_proof(ctx, proof_id)
    let prf = Proof {
        tag: PROOF_WEAKEN,
        prop_id: p.prop_id,
        sub1_id: proof_id,
        sub2_id: extra_prop_id,
        sub3_id: 0,
        label: 0, confidence: p.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// TRUST BOUNDARIES
// ============================================================================

// Trusted: escape hatch. Creates a proof by fiat.
// confidence = 1.0 by default but caller can override.
// Maps to ProofKind::Trusted in the compiler.
fn trusted(ctx: &! ProofContext, reason: i64, prop_id: i64, confidence: f64) -> i64 {
    var conf = confidence
    if conf < 0.0 { conf = 0.0 }
    if conf > 1.0 { conf = 1.0 }
    let prf = Proof {
        tag: PROOF_TRUSTED,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: reason, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Assume: introduce a hypothesis from context.
// Maps to ProofKind::Assume in the compiler.
fn assume(ctx: &! ProofContext, name: i64, prop_id: i64) -> i64 {
    let prf = Proof {
        tag: PROOF_ASSUME,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: name, confidence: 1.0, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Runtime check: defers verification to runtime (gradual typing).
// Confidence is 0.9 — not fully static but likely correct.
// Maps to ProofKind::RuntimeCheck in the compiler.
fn runtime_check(ctx: &! ProofContext, prop_id: i64) -> i64 {
    let prf = Proof {
        tag: PROOF_RUNTIME,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 0.9, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// PROOF INSPECTION
// ============================================================================

// Get the confidence of a proof
fn proof_confidence(ctx: &ProofContext, proof_id: i64) -> f64 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.confidence
}

// Get the proposition a proof witnesses
fn proof_prop_id(ctx: &ProofContext, proof_id: i64) -> i64 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.prop_id
}

// Is this proof fully static (no runtime checks, no trusted, confidence = 1.0)?
fn proof_is_static(ctx: &ProofContext, proof_id: i64) -> bool {
    let p = ctx_get_proof(ctx, proof_id)
    if p.tag == PROOF_TRUSTED { return false }
    if p.tag == PROOF_RUNTIME { return false }
    if p.confidence < 1.0 { return false }
    return true
}

// Get the proof tag (rule used)
fn proof_tag(ctx: &ProofContext, proof_id: i64) -> i32 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.tag
}

// ============================================================================
// VERIFICATION
// ============================================================================

// Verify a proof: check that the proof tag is consistent with its proposition.
// Returns VerifyResult with validity and confidence.
fn verify(ctx: &ProofContext, proof_id: i64) -> VerifyResult {
    let p = ctx_get_proof(ctx, proof_id)

    // Invalid proof ID
    if p.tag < 0 {
        return verify_fail(1)
    }

    // Confidence bounds check
    if p.confidence < 0.0 {
        return verify_fail(3)
    }
    if p.confidence > 1.0 {
        return verify_fail(3)
    }

    let prop = ctx_get_prop(ctx, p.prop_id)

    // Tag-specific validation
    if p.tag == PROOF_TRUE_INTRO {
        if prop.tag == PROP_TRUE {
            return verify_ok(p.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_REFL {
        if prop.tag == PROP_EQ {
            if prop.eq_lhs == prop.eq_rhs {
                return verify_ok(1.0)
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_INTRO {
        if prop.tag == PROP_AND {
            let s1 = ctx_get_proof(ctx, p.sub1_id)
            let s2 = ctx_get_proof(ctx, p.sub2_id)
            if s1.tag >= 0 {
                if s2.tag >= 0 {
                    return verify_ok(min_f64(s1.confidence, s2.confidence))
                }
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_ELIM_L {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_AND {
            return verify_ok(parent.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_ELIM_R {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_AND {
            return verify_ok(parent.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_IMPL_ELIM {
        let impl_prf = ctx_get_proof(ctx, p.sub1_id)
        let impl_prop = ctx_get_prop(ctx, impl_prf.prop_id)
        if impl_prop.tag == PROP_IMPLIES {
            let ante_prf = ctx_get_proof(ctx, p.sub2_id)
            return verify_ok(min_f64(impl_prf.confidence, ante_prf.confidence))
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_SYM {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_EQ {
            if prop.tag == PROP_EQ {
                return verify_ok(parent.confidence)
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_TRANS {
        let ab = ctx_get_proof(ctx, p.sub1_id)
        let bc = ctx_get_proof(ctx, p.sub2_id)
        let ab_prop = ctx_get_prop(ctx, ab.prop_id)
        let bc_prop = ctx_get_prop(ctx, bc.prop_id)
        if ab_prop.tag == PROP_EQ {
            if bc_prop.tag == PROP_EQ {
                return verify_ok(min_f64(ab.confidence, bc.confidence))
            }
        }
        return verify_fail(2)
    }

    // Trust boundaries: always valid by construction
    if p.tag == PROOF_TRUSTED {
        return verify_ok(p.confidence)
    }

    if p.tag == PROOF_ASSUME {
        return verify_ok(p.confidence)
    }

    if p.tag == PROOF_RUNTIME {
        return verify_ok(p.confidence)
    }

    // For other proof tags, validate structurally
    if p.tag == PROOF_OR_INTRO_L { return verify_ok(p.confidence) }
    if p.tag == PROOF_OR_INTRO_R { return verify_ok(p.confidence) }
    if p.tag == PROOF_OR_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_IMPL_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_NOT_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_NOT_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_FALSE_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_FORALL_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_FORALL_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_EXISTS_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_EXISTS_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_CONG { return verify_ok(p.confidence) }
    if p.tag == PROOF_SUBST { return verify_ok(p.confidence) }
    if p.tag == PROOF_COMPOSE { return verify_ok(p.confidence) }
    if p.tag == PROOF_WEAKEN { return verify_ok(p.confidence) }

    return verify_fail(1)
}

// ============================================================================
// PROPOSITION HELPERS
// ============================================================================

// Check if two propositions are structurally equal
fn prop_eq_check(a: Prop, b: Prop) -> bool {
    if a.tag != b.tag { return false }
    if a.left_id != b.left_id { return false }
    if a.right_id != b.right_id { return false }
    if a.var_name != b.var_name { return false }
    if a.predicate_id != b.predicate_id { return false }
    if a.eq_lhs != b.eq_lhs { return false }
    if a.eq_rhs != b.eq_rhs { return false }
    return true
}

// Get the tag name as integer code (for debugging)
fn prop_tag_name(tag: i32) -> i32 {
    return tag
}

// ============================================================================
// CHECKED INFERENCE RULES
//
// Unlike the unchecked constructors above, these functions validate that
// the propositions structurally match before building the proof witness.
// Return proof_id >= 0 on success, -1 on failure.
// ============================================================================

// Result type for checked inference
struct InferResult {
    proof_id: i64,
    ok: bool,
}

fn infer_ok(id: i64) -> InferResult {
    return InferResult { proof_id: id, ok: true }
}

fn infer_fail() -> InferResult {
    return InferResult { proof_id: 0 - 1, ok: false }
}

// --------------------------------------------------------------------------
// 1. Modus Ponens (checked): From proof of P and proof of P -> Q, derive Q
//    Validates: impl_proof proves PROP_IMPLIES, antecedent's prop matches p_proof's prop
// --------------------------------------------------------------------------
fn checked_modus_ponens(ctx: &! ProofContext, p_proof_id: i64, impl_proof_id: i64) -> InferResult {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let impl_prf = ctx_get_proof(ctx, impl_proof_id)

    // impl_proof must be valid
    if impl_prf.tag < 0 { return infer_fail() }
    if p_prf.tag < 0 { return infer_fail() }

    // impl_proof must prove an implication
    let impl_prop = ctx_get_prop(ctx, impl_prf.prop_id)
    if impl_prop.tag != PROP_IMPLIES { return infer_fail() }

    // The antecedent (left_id) must reference the same proposition as p_proof
    let ante_prop = ctx_get_prop(ctx, impl_prop.left_id)
    let p_prop = ctx_get_prop(ctx, p_prf.prop_id)
    if prop_eq_check(ante_prop, p_prop) == false { return infer_fail() }

    // Derive the consequent
    let q_prop_id = impl_prop.right_id
    let conf = min_f64(impl_prf.confidence, p_prf.confidence)
    let prf = Proof {
        tag: PROOF_IMPL_ELIM,
        prop_id: q_prop_id,
        sub1_id: impl_proof_id,
        sub2_id: p_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// --------------------------------------------------------------------------
// 2. Conjunction Introduction (checked): From proofs of P and Q, derive P /\ Q
//    Allocates the conjunction prop and validates both sub-proofs are valid.
// --------------------------------------------------------------------------
fn checked_and_intro(ctx: &! ProofContext, p_proof_id: i64, q_proof_id: i64) -> InferResult {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    if p_prf.tag < 0 { return infer_fail() }
    if q_prf.tag < 0 { return infer_fail() }

    // Build P /\ Q proposition from the sub-proof propositions
    let pq_prop_id = ctx_prop(ctx, prop_and(p_prf.prop_id, q_prf.prop_id))
    if pq_prop_id < 0 { return infer_fail() }

    let conf = min_f64(p_prf.confidence, q_prf.confidence)
    let prf = Proof {
        tag: PROOF_AND_INTRO,
        prop_id: pq_prop_id,
        sub1_id: p_proof_id,
        sub2_id: q_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// --------------------------------------------------------------------------
// 3a. Conjunction Elimination Left (checked): From proof of P /\ Q, derive P
//     Validates: the proof witnesses a PROP_AND.
// --------------------------------------------------------------------------
fn checked_and_elim_left(ctx: &! ProofContext, pq_proof_id: i64) -> InferResult {
    let pq_prf = ctx_get_proof(ctx, pq_proof_id)
    if pq_prf.tag < 0 { return infer_fail() }

    let pq_prop = ctx_get_prop(ctx, pq_prf.prop_id)
    if pq_prop.tag != PROP_AND { return infer_fail() }

    // left_id is the P proposition
    let p_prop_id = pq_prop.left_id
    let prf = Proof {
        tag: PROOF_AND_ELIM_L,
        prop_id: p_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq_prf.confidence, witness: 0,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// --------------------------------------------------------------------------
// 3b. Conjunction Elimination Right (checked): From proof of P /\ Q, derive Q
//     Validates: the proof witnesses a PROP_AND.
// --------------------------------------------------------------------------
fn checked_and_elim_right(ctx: &! ProofContext, pq_proof_id: i64) -> InferResult {
    let pq_prf = ctx_get_proof(ctx, pq_proof_id)
    if pq_prf.tag < 0 { return infer_fail() }

    let pq_prop = ctx_get_prop(ctx, pq_prf.prop_id)
    if pq_prop.tag != PROP_AND { return infer_fail() }

    // right_id is the Q proposition
    let q_prop_id = pq_prop.right_id
    let prf = Proof {
        tag: PROOF_AND_ELIM_R,
        prop_id: q_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq_prf.confidence, witness: 0,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// --------------------------------------------------------------------------
// 4. Reflexivity (checked): For any term a, derive a = a
//    Always succeeds (axiom of equality).
// --------------------------------------------------------------------------
fn checked_refl(ctx: &! ProofContext, a: i64) -> InferResult {
    let eq_prop_id = ctx_prop(ctx, prop_eq(a, a))
    if eq_prop_id < 0 { return infer_fail() }
    let prf = Proof {
        tag: PROOF_REFL,
        prop_id: eq_prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 1.0, witness: a,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// --------------------------------------------------------------------------
// 5. Symmetry (checked): From proof of a = b, derive b = a
//    Validates: the proof witnesses a PROP_EQ.
// --------------------------------------------------------------------------
fn checked_sym(ctx: &! ProofContext, eq_proof_id: i64) -> InferResult {
    let eq_prf = ctx_get_proof(ctx, eq_proof_id)
    if eq_prf.tag < 0 { return infer_fail() }

    let eq_prop = ctx_get_prop(ctx, eq_prf.prop_id)
    if eq_prop.tag != PROP_EQ { return infer_fail() }

    // Build b = a
    let ba_prop_id = ctx_prop(ctx, prop_eq(eq_prop.eq_rhs, eq_prop.eq_lhs))
    if ba_prop_id < 0 { return infer_fail() }

    let prf = Proof {
        tag: PROOF_SYM,
        prop_id: ba_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: eq_prf.confidence, witness: 0,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// --------------------------------------------------------------------------
// 6. Transitivity (checked): From proofs of a = b and b = c, derive a = c
//    Validates: both proofs witness PROP_EQ, and the middle terms match.
// --------------------------------------------------------------------------
fn checked_trans(ctx: &! ProofContext, ab_proof_id: i64, bc_proof_id: i64) -> InferResult {
    let ab_prf = ctx_get_proof(ctx, ab_proof_id)
    let bc_prf = ctx_get_proof(ctx, bc_proof_id)
    if ab_prf.tag < 0 { return infer_fail() }
    if bc_prf.tag < 0 { return infer_fail() }

    let ab_prop = ctx_get_prop(ctx, ab_prf.prop_id)
    let bc_prop = ctx_get_prop(ctx, bc_prf.prop_id)
    if ab_prop.tag != PROP_EQ { return infer_fail() }
    if bc_prop.tag != PROP_EQ { return infer_fail() }

    // Middle terms must match: ab.rhs == bc.lhs
    if ab_prop.eq_rhs != bc_prop.eq_lhs { return infer_fail() }

    // Build a = c
    let ac_prop_id = ctx_prop(ctx, prop_eq(ab_prop.eq_lhs, bc_prop.eq_rhs))
    if ac_prop_id < 0 { return infer_fail() }

    let conf = min_f64(ab_prf.confidence, bc_prf.confidence)
    let prf = Proof {
        tag: PROOF_TRANS,
        prop_id: ac_prop_id,
        sub1_id: ab_proof_id,
        sub2_id: bc_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// --------------------------------------------------------------------------
// 7. Substitution (checked): From proof of a = b and proof of P(a), derive P(b)
//    Validates: eq_proof witnesses PROP_EQ, pa_proof is valid.
//    The caller provides the target proposition P(b) as pb_prop_id.
//    We verify that it exists in the arena.
// --------------------------------------------------------------------------
fn checked_subst(ctx: &! ProofContext, eq_proof_id: i64, pa_proof_id: i64, pb_prop_id: i64) -> InferResult {
    let eq_prf = ctx_get_proof(ctx, eq_proof_id)
    let pa_prf = ctx_get_proof(ctx, pa_proof_id)
    if eq_prf.tag < 0 { return infer_fail() }
    if pa_prf.tag < 0 { return infer_fail() }

    let eq_prop = ctx_get_prop(ctx, eq_prf.prop_id)
    if eq_prop.tag != PROP_EQ { return infer_fail() }

    // Validate pb_prop_id is in range
    if pb_prop_id < 0 { return infer_fail() }
    let pb_prop = ctx_get_prop(ctx, pb_prop_id)
    // Basic sanity: pb_prop must be a real proposition (not a fallback PROP_FALSE from out-of-range)
    if pb_prop_id >= ctx.arena.count { return infer_fail() }

    let conf = min_f64(eq_prf.confidence, pa_prf.confidence)
    let prf = Proof {
        tag: PROOF_SUBST,
        prop_id: pb_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: pa_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    let id = ctx_proof(ctx, prf)
    return infer_ok(id)
}

// ============================================================================
// TESTS — Checked inference rules
// ============================================================================

// Test: checked_refl proves a = a, verified
fn test_checked_refl(ctx: &! ProofContext) -> bool {
    let r = checked_refl(ctx, 42)
    if r.ok == false { return false }
    let v = verify(ctx, r.proof_id)
    if v.is_valid == false { return false }
    if v.confidence < 1.0 { return false }
    // Confirm proposition is 42 = 42
    let prf = ctx_get_proof(ctx, r.proof_id)
    let prop = ctx_get_prop(ctx, prf.prop_id)
    if prop.tag != PROP_EQ { return false }
    if prop.eq_lhs != 42 { return false }
    if prop.eq_rhs != 42 { return false }
    return true
}

// Test: checked_sym flips a = b to b = a
fn test_checked_sym(ctx: &! ProofContext) -> bool {
    // Axiom: 10 = 20
    let eq_id = ctx_prop(ctx, prop_eq(10, 20))
    let ab = trusted(ctx, 1, eq_id, 1.0)

    let r = checked_sym(ctx, ab)
    if r.ok == false { return false }
    let v = verify(ctx, r.proof_id)
    if v.is_valid == false { return false }
    // Confirm proposition is 20 = 10
    let prf = ctx_get_proof(ctx, r.proof_id)
    let prop = ctx_get_prop(ctx, prf.prop_id)
    if prop.tag != PROP_EQ { return false }
    if prop.eq_lhs != 20 { return false }
    if prop.eq_rhs != 10 { return false }
    return true
}

// Test: checked_trans chains a=b, b=c into a=c
fn test_checked_trans(ctx: &! ProofContext) -> bool {
    // a=b: 1=2
    let ab_prop = ctx_prop(ctx, prop_eq(1, 2))
    let ab = trusted(ctx, 1, ab_prop, 1.0)
    // b=c: 2=3
    let bc_prop = ctx_prop(ctx, prop_eq(2, 3))
    let bc = trusted(ctx, 2, bc_prop, 1.0)

    let r = checked_trans(ctx, ab, bc)
    if r.ok == false { return false }
    let v = verify(ctx, r.proof_id)
    if v.is_valid == false { return false }
    // Confirm: 1 = 3
    let prf = ctx_get_proof(ctx, r.proof_id)
    let prop = ctx_get_prop(ctx, prf.prop_id)
    if prop.eq_lhs != 1 { return false }
    if prop.eq_rhs != 3 { return false }
    return true
}

// Test: checked_trans rejects mismatched middle terms
fn test_checked_trans_rejects(ctx: &! ProofContext) -> bool {
    // a=b: 1=2
    let ab_prop = ctx_prop(ctx, prop_eq(1, 2))
    let ab = trusted(ctx, 1, ab_prop, 1.0)
    // c=d: 5=6 (middle doesn't match)
    let cd_prop = ctx_prop(ctx, prop_eq(5, 6))
    let cd = trusted(ctx, 2, cd_prop, 1.0)

    let r = checked_trans(ctx, ab, cd)
    // Must fail: 2 != 5
    if r.ok == true { return false }
    return true
}

// Test: checked_modus_ponens derives Q from P and P->Q
fn test_checked_mp(ctx: &! ProofContext) -> bool {
    // P: custom(100)
    let p_prop_id = ctx_prop(ctx, prop_custom(100))
    let p_prf = trusted(ctx, 1, p_prop_id, 1.0)

    // Q: custom(200)
    let q_prop_id = ctx_prop(ctx, prop_custom(200))

    // P -> Q: implies(p_prop_id, q_prop_id)
    let impl_prop_id = ctx_prop(ctx, prop_implies(p_prop_id, q_prop_id))
    let impl_prf = trusted(ctx, 2, impl_prop_id, 1.0)

    let r = checked_modus_ponens(ctx, p_prf, impl_prf)
    if r.ok == false { return false }
    let v = verify(ctx, r.proof_id)
    if v.is_valid == false { return false }
    // Result should prove q_prop_id
    let result_prf = ctx_get_proof(ctx, r.proof_id)
    if result_prf.prop_id != q_prop_id { return false }
    return true
}

// Test: checked_modus_ponens rejects wrong antecedent
fn test_checked_mp_rejects(ctx: &! ProofContext) -> bool {
    // P: custom(100)
    let p_prop_id = ctx_prop(ctx, prop_custom(100))
    let p_prf = trusted(ctx, 1, p_prop_id, 1.0)

    // R: custom(300) — different from P
    let r_prop_id = ctx_prop(ctx, prop_custom(300))
    let q_prop_id = ctx_prop(ctx, prop_custom(200))

    // R -> Q (not P -> Q)
    let impl_prop_id = ctx_prop(ctx, prop_implies(r_prop_id, q_prop_id))
    let impl_prf = trusted(ctx, 2, impl_prop_id, 1.0)

    let r = checked_modus_ponens(ctx, p_prf, impl_prf)
    // Must fail: P != R
    if r.ok == true { return false }
    return true
}

// Test: checked_and_intro + checked_and_elim round-trip
fn test_checked_and_roundtrip(ctx: &! ProofContext) -> bool {
    // P: custom(10)
    let p_prop_id = ctx_prop(ctx, prop_custom(10))
    let p_prf = trusted(ctx, 1, p_prop_id, 1.0)
    // Q: custom(20)
    let q_prop_id = ctx_prop(ctx, prop_custom(20))
    let q_prf = trusted(ctx, 2, q_prop_id, 1.0)

    // P /\ Q
    let r_and = checked_and_intro(ctx, p_prf, q_prf)
    if r_and.ok == false { return false }

    // Elim left => P
    let r_left = checked_and_elim_left(ctx, r_and.proof_id)
    if r_left.ok == false { return false }
    let left_prf = ctx_get_proof(ctx, r_left.proof_id)
    if left_prf.prop_id != p_prop_id { return false }

    // Elim right => Q
    let r_right = checked_and_elim_right(ctx, r_and.proof_id)
    if r_right.ok == false { return false }
    let right_prf = ctx_get_proof(ctx, r_right.proof_id)
    if right_prf.prop_id != q_prop_id { return false }

    return true
}

// Test: checked_subst applies equality to rewrite
fn test_checked_subst(ctx: &! ProofContext) -> bool {
    // a = b: 10 = 20
    let eq_prop_id = ctx_prop(ctx, prop_eq(10, 20))
    let eq_prf = trusted(ctx, 1, eq_prop_id, 1.0)

    // P(a): custom predicate about a (use custom(10) as stand-in)
    let pa_prop_id = ctx_prop(ctx, prop_custom(10))
    let pa_prf = trusted(ctx, 2, pa_prop_id, 1.0)

    // P(b): custom(20) — the rewritten proposition
    let pb_prop_id = ctx_prop(ctx, prop_custom(20))

    let r = checked_subst(ctx, eq_prf, pa_prf, pb_prop_id)
    if r.ok == false { return false }
    let v = verify(ctx, r.proof_id)
    if v.is_valid == false { return false }
    let result_prf = ctx_get_proof(ctx, r.proof_id)
    if result_prf.prop_id != pb_prop_id { return false }
    return true
}

// Test: confidence propagation through chain
fn test_confidence_chain(ctx: &! ProofContext) -> bool {
    // P at 0.8 confidence
    let p_prop_id = ctx_prop(ctx, prop_custom(100))
    let p_prf = trusted(ctx, 1, p_prop_id, 0.8)
    // Q at 0.9 confidence
    let q_prop_id = ctx_prop(ctx, prop_custom(200))
    let q_prf = trusted(ctx, 2, q_prop_id, 0.9)

    // P /\ Q should get min(0.8, 0.9) = 0.8
    let r = checked_and_intro(ctx, p_prf, q_prf)
    if r.ok == false { return false }
    let v = verify(ctx, r.proof_id)
    if v.is_valid == false { return false }
    // confidence should be 0.8
    let c = proof_confidence(ctx, r.proof_id)
    if c > 0.81 { return false }
    if c < 0.79 { return false }
    return true
}

// Master test runner
fn test_kernel_inference() -> i32 {
    var ctx = proof_context_new()
    var pass = 0
    var fail = 0

    if test_checked_refl(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_checked_sym(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_checked_trans(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_checked_trans_rejects(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_checked_mp(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_checked_mp_rejects(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_checked_and_roundtrip(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_checked_subst(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }
    if test_confidence_chain(&! ctx) { pass = pass + 1 } else { fail = fail + 1 }

    // Return number of failures (0 = all pass)
    return fail
}
