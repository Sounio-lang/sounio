//! stdlib/theorem/pb_highwidth_microkernel.sio
//!
//! Bounded pseudo-Boolean proof-checker seed for the PB/VeriPB family. The
//! executable arithmetic is intentionally tiny and i64-bounded because the
//! current self-hosted compiler does not yet accept i128 value declarations.
//! The receipt therefore records a 128-bit target width with native i128
//! evidence mask zero.

fn pb_bool_or_unknown_ok(v: i64) -> i64 {
    if v == 0 - 1 { return 1 }
    if v == 0 { return 1 }
    if v == 1 { return 1 }
    return 0
}

fn pb_abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn pb_var_value(var_id: i64, x1: i64, x2: i64, x3: i64) -> i64 {
    if var_id == 1 { return x1 }
    if var_id == 2 { return x2 }
    if var_id == 3 { return x3 }
    return 0 - 2
}

fn pb_lit_value_partial(lit: i64, x1: i64, x2: i64, x3: i64) -> i64 {
    if lit == 0 { return 0 }
    let var_id = pb_abs_i64(lit)
    let v = pb_var_value(var_id, x1, x2, x3)
    if v == 0 - 2 { return 0 - 2 }
    if v == 0 - 1 { return 0 - 1 }
    if v != 0 {
        if v != 1 { return 0 - 2 }
    }
    if lit > 0 { return v }
    if v == 0 { return 1 }
    return 0
}

fn pb_lit_value_with_forced_false(
    lit: i64,
    forced_lit: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    if lit == 0 { return 0 }
    if forced_lit == 0 { return 0 - 2 }
    let lit_var = pb_abs_i64(lit)
    let forced_var = pb_abs_i64(forced_lit)
    if lit_var == forced_var {
        var forced_var_value: i64 = 0
        if forced_lit < 0 { forced_var_value = 1 }
        if lit > 0 { return forced_var_value }
        if forced_var_value == 0 { return 1 }
        return 0
    }
    return pb_lit_value_partial(lit, x1, x2, x3)
}

fn pb_term_value(coeff: i64, lit: i64, x1: i64, x2: i64, x3: i64) -> i64 {
    if coeff < 0 { return 0 - 1 }
    if lit == 0 { return 0 }
    let v = pb_lit_value_partial(lit, x1, x2, x3)
    if v < 0 { return 0 - 1 }
    return coeff * v
}

fn pb_term_max_without_forced(
    coeff: i64,
    lit: i64,
    forced_lit: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    if coeff < 0 { return 0 - 1 }
    if lit == 0 { return 0 }
    let v = pb_lit_value_with_forced_false(lit, forced_lit, x1, x2, x3)
    if v == 0 - 2 { return 0 - 1 }
    if v == 0 - 1 { return coeff }
    return coeff * v
}

pub fn pb_row3_sum_i64(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    if pb_bool_or_unknown_ok(x1) != 1 { return 0 - 1 }
    if pb_bool_or_unknown_ok(x2) != 1 { return 0 - 1 }
    if pb_bool_or_unknown_ok(x3) != 1 { return 0 - 1 }

    let t1 = pb_term_value(a1, l1, x1, x2, x3)
    if t1 < 0 { return 0 - 1 }
    let t2 = pb_term_value(a2, l2, x1, x2, x3)
    if t2 < 0 { return 0 - 1 }
    let t3 = pb_term_value(a3, l3, x1, x2, x3)
    if t3 < 0 { return 0 - 1 }
    return t1 + t2 + t3
}

pub fn pb_row3_ge_check(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    rhs: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    if rhs < 0 { return 0 }
    let sum = pb_row3_sum_i64(a1, l1, a2, l2, a3, l3, x1, x2, x3)
    if sum < 0 { return 0 }
    if sum >= rhs { return 1 }
    return 0
}

pub fn pb_row3_conflict_check(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    rhs: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    if rhs < 0 { return 0 }
    let sum = pb_row3_sum_i64(a1, l1, a2, l2, a3, l3, x1, x2, x3)
    if sum < 0 { return 0 }
    if sum < rhs { return 1 }
    return 0
}

pub fn pb_row3_forced_lit_check(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    rhs: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    forced_lit: i64) -> i64 {
    if rhs < 0 { return 0 }
    if forced_lit == 0 { return 0 }
    if pb_bool_or_unknown_ok(x1) != 1 { return 0 }
    if pb_bool_or_unknown_ok(x2) != 1 { return 0 }
    if pb_bool_or_unknown_ok(x3) != 1 { return 0 }

    let t1 = pb_term_max_without_forced(a1, l1, forced_lit, x1, x2, x3)
    if t1 < 0 { return 0 }
    let t2 = pb_term_max_without_forced(a2, l2, forced_lit, x1, x2, x3)
    if t2 < 0 { return 0 }
    let t3 = pb_term_max_without_forced(a3, l3, forced_lit, x1, x2, x3)
    if t3 < 0 { return 0 }

    let max_without_forced = t1 + t2 + t3
    if max_without_forced < rhs { return 1 }
    return 0
}

pub fn pb_highwidth_microkernel_receipt_check(
    row_satisfied_ok: i64,
    forced_lit_ok: i64,
    conflict_ok: i64,
    wrong_forced_rejected: i64,
    wrong_conflict_rejected: i64,
    target_integer_width: i64,
    native_i128_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    microkernel_status: i64) -> i64 {
    if row_satisfied_ok != 1 { return 0 - 1 }
    if forced_lit_ok != 1 { return 0 - 1 }
    if conflict_ok != 1 { return 0 - 1 }
    if wrong_forced_rejected != 1 { return 0 - 1 }
    if wrong_conflict_rejected != 1 { return 0 - 1 }
    if target_integer_width != 128 { return 0 - 1 }
    if native_i128_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if microkernel_status != 99 { return 0 - 1 }
    return 671902843
}

pub fn pb_highwidth_microkernel_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    row_satisfied_ok: i64,
    forced_lit_ok: i64,
    conflict_ok: i64,
    wrong_forced_rejected: i64,
    wrong_conflict_rejected: i64,
    proof_family_mask: i64,
    proof_format_mask: i64,
    target_integer_width: i64,
    native_i128_evidence_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    microkernel_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 671902843 { return 0 - 1 }
    if instance_fp != 914035627 { return 0 - 1 }
    if certificate_fp != 506781239 { return 0 - 1 }
    if row_satisfied_ok != 1 { return 0 - 1 }
    if forced_lit_ok != 1 { return 0 - 1 }
    if conflict_ok != 1 { return 0 - 1 }
    if wrong_forced_rejected != 1 { return 0 - 1 }
    if wrong_conflict_rejected != 1 { return 0 - 1 }
    if proof_family_mask != 4 { return 0 - 1 }
    if proof_format_mask != 4 { return 0 - 1 }
    if target_integer_width != 128 { return 0 - 1 }
    if native_i128_evidence_mask != 0 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if microkernel_status != 99 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 238570416
}
