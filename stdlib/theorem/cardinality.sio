pub fn card_colour_current_unsat_scope_fingerprint(
    scope_code: i64,
    erdos_problem_id: i64,
    vertex_count: i64,
    edge_count: i64,
    colour_count: i64,
    graph_instance_fingerprint: i64,
    unsat_claim_fingerprint: i64,
    unit_distance_graph_flag: i64,
    independent_replay_mask: i64) -> i64 {
    if scope_code != card_colour_scope_k3_not_2_colourable() { return 0 - 1 }
    if erdos_problem_id != 0 { return 0 - 1 }
    if vertex_count != 3 { return 0 - 1 }
    if edge_count != 3 { return 0 - 1 }
    if colour_count != 2 { return 0 - 1 }
    if graph_instance_fingerprint != 77085393 { return 0 - 1 }
    if unsat_claim_fingerprint != 848522370 { return 0 - 1 }
    if unit_distance_graph_flag != 0 { return 0 - 1 }
    if independent_replay_mask != 15 { return 0 - 1 }

    var acc: i64 = 47
    acc = card_colour_graph_mix(acc, scope_code, 479)
    acc = card_colour_graph_mix(acc, erdos_problem_id, 479)
    acc = card_colour_graph_mix(acc, vertex_count, 479)
    acc = card_colour_graph_mix(acc, edge_count, 479)
    acc = card_colour_graph_mix(acc, colour_count, 479)
    acc = card_colour_graph_mix(acc, graph_instance_fingerprint, 479)
    acc = card_colour_graph_mix(acc, unsat_claim_fingerprint, 479)
    acc = card_colour_graph_mix(acc, unit_distance_graph_flag, 479)
    acc = card_colour_graph_mix(acc, independent_replay_mask, 479)
    return acc
}

pub fn card_colour_hadwiger_nelson_chi6_preflight(
    erdos_problem_id: i64,
    claimed_lower_bound: i64,
    vertex_count: i64,
    edge_count: i64,
    colour_count_for_unsat: i64,
    concrete_unit_distance_graph: i64,
    graph_instance_fingerprint: i64,
    unsat_claim_fingerprint: i64,
    independent_replay_mask: i64) -> i64 {
    if erdos_problem_id != card_colour_erdos_hadwiger_nelson_id() { return 0 }
    if claimed_lower_bound != 6 { return 0 }
    if vertex_count <= 0 { return 0 }
    if edge_count <= 0 { return 0 }
    if colour_count_for_unsat != 5 { return 0 }
    if concrete_unit_distance_graph != 1 { return 0 }
    if graph_instance_fingerprint <= 0 { return 0 }
    if unsat_claim_fingerprint <= 0 { return 0 }
    if independent_replay_mask != 31 { return 0 }
    return 1
}
