//! stdlib/theorem/div_witness.sio
//!
//! Tiny quotient/remainder witness helpers.
//!
//! These helpers verify supplied division witnesses by multiplication and
//! comparison:
//!
//!   numerator = quotient * denominator + remainder
//!   denominator > 0
//!   quotient >= 0
//!   0 <= remainder < denominator
//!
//! They deliberately do not invoke source-level division. This makes them a
//! staging proof-checker layer for wide integer certificates while native wide
//! division is still being repaired.

pub fn div_witness_check_i64(numerator: i64, denominator: i64,
                             quotient: i64, remainder: i64) -> i64 {
    if denominator <= 0 { return 0 }
    if quotient < 0 { return 0 }
    if remainder < 0 { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

pub fn div_witness_check_i256(numerator: i256, denominator: i256,
                              quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

pub fn div_witness_all3(ok0: i64, ok1: i64, ok2: i64) -> i64 {
    if ok0 != 1 { return 0 }
    if ok1 != 1 { return 0 }
    if ok2 != 1 { return 0 }
    return 1
}

pub fn div_witness_pack3_fingerprint(tag: i64,
                                     q0: i64, r0: i64,
                                     q1: i64, r1: i64,
                                     q2: i64, r2: i64,
                                     ok0: i64, ok1: i64, ok2: i64) -> i64 with Mod {
    if tag <= 0 { return 0 - 1 }
    if div_witness_all3(ok0, ok1, ok2) == 0 { return 0 - 1 }

    var fp: i64 = 211
    fp = ((fp * 16777619) + tag + 1601) % 1000000007
    fp = ((fp * 16777619) + q0 + 1601) % 1000000007
    fp = ((fp * 16777619) + r0 + 1601) % 1000000007
    fp = ((fp * 16777619) + q1 + 1601) % 1000000007
    fp = ((fp * 16777619) + r1 + 1601) % 1000000007
    fp = ((fp * 16777619) + q2 + 1601) % 1000000007
    fp = ((fp * 16777619) + r2 + 1601) % 1000000007
    fp = ((fp * 16777619) + ok0 + 1601) % 1000000007
    fp = ((fp * 16777619) + ok1 + 1601) % 1000000007
    fp = ((fp * 16777619) + ok2 + 1601) % 1000000007
    return fp
}

pub fn div_witness_projection3_i256_fingerprint(
    tag: i64,
    source_scale: i64,
    target_scale: i64,
    n0: i64, q0: i64, r0: i64,
    n1: i64, q1: i64, r1: i64,
    n2: i64, q2: i64, r2: i64) -> i64 with Mod {
    if tag <= 0 { return 0 - 1 }
    if source_scale <= 0 { return 0 - 1 }
    if target_scale <= 0 { return 0 - 1 }

    let source: i256 = source_scale as i256
    let target: i256 = target_scale as i256
    let ok0 = div_witness_check_i256((n0 as i256) * target, source, q0 as i256, r0 as i256)
    let ok1 = div_witness_check_i256((n1 as i256) * target, source, q1 as i256, r1 as i256)
    let ok2 = div_witness_check_i256((n2 as i256) * target, source, q2 as i256, r2 as i256)
    if div_witness_all3(ok0, ok1, ok2) == 0 { return 0 - 1 }

    var fp: i64 = 223
    fp = ((fp * 16777619) + tag + 1613) % 1000000007
    fp = ((fp * 16777619) + source_scale + 1613) % 1000000007
    fp = ((fp * 16777619) + target_scale + 1613) % 1000000007
    fp = ((fp * 16777619) + n0 + 1613) % 1000000007
    fp = ((fp * 16777619) + q0 + 1613) % 1000000007
    fp = ((fp * 16777619) + r0 + 1613) % 1000000007
    fp = ((fp * 16777619) + n1 + 1613) % 1000000007
    fp = ((fp * 16777619) + q1 + 1613) % 1000000007
    fp = ((fp * 16777619) + r1 + 1613) % 1000000007
    fp = ((fp * 16777619) + n2 + 1613) % 1000000007
    fp = ((fp * 16777619) + q2 + 1613) % 1000000007
    fp = ((fp * 16777619) + r2 + 1613) % 1000000007
    fp = ((fp * 16777619) + ok0 + 1613) % 1000000007
    fp = ((fp * 16777619) + ok1 + 1613) % 1000000007
    fp = ((fp * 16777619) + ok2 + 1613) % 1000000007
    return fp
}

pub fn div_witness_projection3_i256_directed_round_fingerprint(
    tag: i64,
    source_scale: i64,
    target_scale: i64,
    n0: i64, q0: i64, r0: i64, ceil0: i64,
    n1: i64, q1: i64, r1: i64, ceil1: i64,
    n2: i64, q2: i64, r2: i64, ceil2: i64) -> i64 with Mod {
    if tag <= 0 { return 0 - 1 }
    if source_scale <= 0 { return 0 - 1 }
    if target_scale <= 0 { return 0 - 1 }

    let floor_fp = div_witness_projection3_i256_fingerprint(
        tag, source_scale, target_scale,
        n0, q0, r0,
        n1, q1, r1,
        n2, q2, r2)
    if floor_fp <= 0 { return 0 - 1 }

    var up0: i64 = 0
    var up1: i64 = 0
    var up2: i64 = 0
    if r0 > 0 { up0 = 1 }
    if r1 > 0 { up1 = 1 }
    if r2 > 0 { up2 = 1 }
    if ceil0 != q0 + up0 { return 0 - 1 }
    if ceil1 != q1 + up1 { return 0 - 1 }
    if ceil2 != q2 + up2 { return 0 - 1 }

    let round_mask = up0 + (2 * up1) + (4 * up2)

    var fp: i64 = 229
    fp = ((fp * 16777619) + tag + 1627) % 1000000007
    fp = ((fp * 16777619) + source_scale + 1627) % 1000000007
    fp = ((fp * 16777619) + target_scale + 1627) % 1000000007
    fp = ((fp * 16777619) + n0 + 1627) % 1000000007
    fp = ((fp * 16777619) + q0 + 1627) % 1000000007
    fp = ((fp * 16777619) + r0 + 1627) % 1000000007
    fp = ((fp * 16777619) + ceil0 + 1627) % 1000000007
    fp = ((fp * 16777619) + n1 + 1627) % 1000000007
    fp = ((fp * 16777619) + q1 + 1627) % 1000000007
    fp = ((fp * 16777619) + r1 + 1627) % 1000000007
    fp = ((fp * 16777619) + ceil1 + 1627) % 1000000007
    fp = ((fp * 16777619) + n2 + 1627) % 1000000007
    fp = ((fp * 16777619) + q2 + 1627) % 1000000007
    fp = ((fp * 16777619) + r2 + 1627) % 1000000007
    fp = ((fp * 16777619) + ceil2 + 1627) % 1000000007
    fp = ((fp * 16777619) + floor_fp + 1627) % 1000000007
    fp = ((fp * 16777619) + round_mask + 1627) % 1000000007
    return fp
}

pub fn div_witness_projection3_i256_interval_containment_fingerprint(
    tag: i64,
    source_scale: i64,
    target_scale: i64,
    n0: i64, q0: i64, r0: i64, ceil0: i64, lo0: i64, hi0: i64,
    n1: i64, q1: i64, r1: i64, ceil1: i64, lo1: i64, hi1: i64,
    n2: i64, q2: i64, r2: i64, ceil2: i64, lo2: i64, hi2: i64) -> i64 with Mod {
    if tag <= 0 { return 0 - 1 }
    if source_scale <= 0 { return 0 - 1 }
    if target_scale <= 0 { return 0 - 1 }

    let directed_fp = div_witness_projection3_i256_directed_round_fingerprint(
        tag, source_scale, target_scale,
        n0, q0, r0, ceil0,
        n1, q1, r1, ceil1,
        n2, q2, r2, ceil2)
    if directed_fp <= 0 { return 0 - 1 }

    if lo0 > q0 { return 0 - 1 }
    if ceil0 > hi0 { return 0 - 1 }
    if lo1 > q1 { return 0 - 1 }
    if ceil1 > hi1 { return 0 - 1 }
    if lo2 > q2 { return 0 - 1 }
    if ceil2 > hi2 { return 0 - 1 }

    let lower_slack0 = q0 - lo0
    let upper_slack0 = hi0 - ceil0
    let lower_slack1 = q1 - lo1
    let upper_slack1 = hi1 - ceil1
    let lower_slack2 = q2 - lo2
    let upper_slack2 = hi2 - ceil2

    var containment_mask: i64 = 0
    if lower_slack0 >= 0 {
        if upper_slack0 >= 0 { containment_mask = containment_mask + 1 }
    }
    if lower_slack1 >= 0 {
        if upper_slack1 >= 0 { containment_mask = containment_mask + 2 }
    }
    if lower_slack2 >= 0 {
        if upper_slack2 >= 0 { containment_mask = containment_mask + 4 }
    }
    if containment_mask != 7 { return 0 - 1 }

    var min_lower_slack = lower_slack0
    if lower_slack1 < min_lower_slack { min_lower_slack = lower_slack1 }
    if lower_slack2 < min_lower_slack { min_lower_slack = lower_slack2 }
    var min_upper_slack = upper_slack0
    if upper_slack1 < min_upper_slack { min_upper_slack = upper_slack1 }
    if upper_slack2 < min_upper_slack { min_upper_slack = upper_slack2 }

    var fp: i64 = 239
    fp = ((fp * 16777619) + tag + 1637) % 1000000007
    fp = ((fp * 16777619) + source_scale + 1637) % 1000000007
    fp = ((fp * 16777619) + target_scale + 1637) % 1000000007
    fp = ((fp * 16777619) + n0 + 1637) % 1000000007
    fp = ((fp * 16777619) + q0 + 1637) % 1000000007
    fp = ((fp * 16777619) + r0 + 1637) % 1000000007
    fp = ((fp * 16777619) + ceil0 + 1637) % 1000000007
    fp = ((fp * 16777619) + lo0 + 1637) % 1000000007
    fp = ((fp * 16777619) + hi0 + 1637) % 1000000007
    fp = ((fp * 16777619) + lower_slack0 + 1637) % 1000000007
    fp = ((fp * 16777619) + upper_slack0 + 1637) % 1000000007
    fp = ((fp * 16777619) + n1 + 1637) % 1000000007
    fp = ((fp * 16777619) + q1 + 1637) % 1000000007
    fp = ((fp * 16777619) + r1 + 1637) % 1000000007
    fp = ((fp * 16777619) + ceil1 + 1637) % 1000000007
    fp = ((fp * 16777619) + lo1 + 1637) % 1000000007
    fp = ((fp * 16777619) + hi1 + 1637) % 1000000007
    fp = ((fp * 16777619) + lower_slack1 + 1637) % 1000000007
    fp = ((fp * 16777619) + upper_slack1 + 1637) % 1000000007
    fp = ((fp * 16777619) + n2 + 1637) % 1000000007
    fp = ((fp * 16777619) + q2 + 1637) % 1000000007
    fp = ((fp * 16777619) + r2 + 1637) % 1000000007
    fp = ((fp * 16777619) + ceil2 + 1637) % 1000000007
    fp = ((fp * 16777619) + lo2 + 1637) % 1000000007
    fp = ((fp * 16777619) + hi2 + 1637) % 1000000007
    fp = ((fp * 16777619) + lower_slack2 + 1637) % 1000000007
    fp = ((fp * 16777619) + upper_slack2 + 1637) % 1000000007
    fp = ((fp * 16777619) + directed_fp + 1637) % 1000000007
    fp = ((fp * 16777619) + containment_mask + 1637) % 1000000007
    fp = ((fp * 16777619) + min_lower_slack + 1637) % 1000000007
    fp = ((fp * 16777619) + min_upper_slack + 1637) % 1000000007
    return fp
}
