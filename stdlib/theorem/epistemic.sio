// == kernel preamble inlined ==
// Sounio Proof Kernel — Core Proof Infrastructure
//
// Propositions-as-types, proof witnesses, natural deduction.
// Every Proof carries confidence — the fundamental departure from Lean/Coq.
//
// Mirrors the compiler's dependent/proofs.rs ProofKind (18 constructors)
// at the user level as a composable .sio API.
//
// Reference:
//   Curry-Howard correspondence (propositions = types, proofs = programs)
//   Sounio formal/lean4/SounioEpistemic.lean (confidence lattice)

extern "C" {
    fn sqrt(x: f64) -> f64;
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

// ============================================================================
// PROPOSITION ARENA
// ============================================================================

// Maximum propositions in a single proof context
let PROP_ARENA_CAP: i64 = 4096

// Proposition tags
let PROP_TRUE: i32 = 0
let PROP_FALSE: i32 = 1
let PROP_AND: i32 = 2
let PROP_OR: i32 = 3
let PROP_IMPLIES: i32 = 4
let PROP_NOT: i32 = 5
let PROP_FORALL: i32 = 6
let PROP_EXISTS: i32 = 7
let PROP_EQ: i32 = 8
let PROP_CUSTOM: i32 = 9

// Proposition: tag-encoded logical claim
// Uses integer IDs to reference sub-propositions (arena-style, no recursion)
struct Prop {
    tag: i32,
    left_id: i64,       // sub-proposition (for And, Or, Implies, Not)
    right_id: i64,       // sub-proposition (for And, Or, Implies)
    var_name: i64,       // quantifier variable (for Forall, Exists)
    predicate_id: i64,   // custom predicate (for Eq, Custom)
    eq_lhs: i64,         // equality left (for Eq)
    eq_rhs: i64,         // equality right (for Eq)
}

// Arena: flat storage for propositions
struct PropArena {
    tags: [i32; 4096],
    left_ids: [i64; 4096],
    right_ids: [i64; 4096],
    var_names: [i64; 4096],
    predicate_ids: [i64; 4096],
    eq_lhs_vals: [i64; 4096],
    eq_rhs_vals: [i64; 4096],
    count: i64,
}

fn arena_new() -> PropArena {
    return PropArena {
        tags: [0; 4096],
        left_ids: [0; 4096],
        right_ids: [0; 4096],
        var_names: [0; 4096],
        predicate_ids: [0; 4096],
        eq_lhs_vals: [0; 4096],
        eq_rhs_vals: [0; 4096],
        count: 0,
    }
}

fn arena_alloc(arena: &! PropArena, p: Prop) -> i64 {
    let idx = arena.count
    if idx >= PROP_ARENA_CAP {
        return 0 - 1  // overflow sentinel
    }
    arena.tags[idx] = p.tag
    arena.left_ids[idx] = p.left_id
    arena.right_ids[idx] = p.right_id
    arena.var_names[idx] = p.var_name
    arena.predicate_ids[idx] = p.predicate_id
    arena.eq_lhs_vals[idx] = p.eq_lhs
    arena.eq_rhs_vals[idx] = p.eq_rhs
    arena.count = idx + 1
    return idx
}

fn arena_get(arena: &PropArena, idx: i64) -> Prop {
    if idx < 0 {
        return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
    }
    if idx >= arena.count {
        return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
    }
    return Prop {
        tag: arena.tags[idx],
        left_id: arena.left_ids[idx],
        right_id: arena.right_ids[idx],
        var_name: arena.var_names[idx],
        predicate_id: arena.predicate_ids[idx],
        eq_lhs: arena.eq_lhs_vals[idx],
        eq_rhs: arena.eq_rhs_vals[idx],
    }
}

// ============================================================================
// PROPOSITION CONSTRUCTORS
// ============================================================================

fn prop_true() -> Prop {
    return Prop { tag: PROP_TRUE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_false() -> Prop {
    return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_and(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: PROP_AND, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_or(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: PROP_OR, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_implies(antecedent_id: i64, consequent_id: i64) -> Prop {
    return Prop { tag: PROP_IMPLIES, left_id: antecedent_id, right_id: consequent_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_not(inner_id: i64) -> Prop {
    return Prop { tag: PROP_NOT, left_id: inner_id, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_forall(var: i64, body_id: i64) -> Prop {
    return Prop { tag: PROP_FORALL, left_id: body_id, right_id: 0, var_name: var, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_exists(var: i64, body_id: i64) -> Prop {
    return Prop { tag: PROP_EXISTS, left_id: body_id, right_id: 0, var_name: var, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_eq(lhs: i64, rhs: i64) -> Prop {
    return Prop { tag: PROP_EQ, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: lhs, eq_rhs: rhs }
}

// P <-> Q  is  (P -> Q) /\ (Q -> P)
fn prop_iff(p_id: i64, q_id: i64) -> Prop {
    return Prop { tag: PROP_AND, left_id: p_id, right_id: q_id, var_name: 0, predicate_id: 1, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_custom(pred_id: i64) -> Prop {
    return Prop { tag: PROP_CUSTOM, left_id: 0, right_id: 0, var_name: 0, predicate_id: pred_id, eq_lhs: 0, eq_rhs: 0 }
}

// ============================================================================
// PROOF TAGS
// ============================================================================

let PROOF_REFL: i32 = 0
let PROOF_AND_INTRO: i32 = 1
let PROOF_AND_ELIM_L: i32 = 2
let PROOF_AND_ELIM_R: i32 = 3
let PROOF_OR_INTRO_L: i32 = 4
let PROOF_OR_INTRO_R: i32 = 5
let PROOF_OR_ELIM: i32 = 6
let PROOF_IMPL_INTRO: i32 = 7
let PROOF_IMPL_ELIM: i32 = 8
let PROOF_NOT_INTRO: i32 = 9
let PROOF_NOT_ELIM: i32 = 10
let PROOF_FALSE_ELIM: i32 = 11
let PROOF_FORALL_INTRO: i32 = 12
let PROOF_FORALL_ELIM: i32 = 13
let PROOF_EXISTS_INTRO: i32 = 14
let PROOF_EXISTS_ELIM: i32 = 15
let PROOF_SYM: i32 = 16
let PROOF_TRANS: i32 = 17
let PROOF_CONG: i32 = 18
let PROOF_SUBST: i32 = 19
let PROOF_COMPOSE: i32 = 20
let PROOF_WEAKEN: i32 = 21
let PROOF_TRUSTED: i32 = 22
let PROOF_ASSUME: i32 = 23
let PROOF_RUNTIME: i32 = 24
let PROOF_TRUE_INTRO: i32 = 25

// ============================================================================
// PROOF WITNESS
// ============================================================================

// A proof of a proposition. Carries confidence — the Sounio novelty.
// confidence = 1.0 means fully verified (like Lean/Coq).
// confidence < 1.0 means epistemic evidence (unique to Sounio).
struct Proof {
    tag: i32,
    // The proposition this witnesses (arena index)
    prop_id: i64,
    // Sub-proofs (indices into proof store)
    sub1_id: i64,
    sub2_id: i64,
    sub3_id: i64,
    // Metadata
    label: i64,
    // THE KEY FIELD: confidence in this proof
    // 1.0 = verified, < 1.0 = epistemic evidence
    confidence: f64,
    // Witness value (for exists_intro, forall_elim, etc.)
    witness: i64,
}

// Proof store (flat arena, mirrors proposition arena)
struct ProofStore {
    tags: [i32; 4096],
    prop_ids: [i64; 4096],
    sub1_ids: [i64; 4096],
    sub2_ids: [i64; 4096],
    sub3_ids: [i64; 4096],
    labels: [i64; 4096],
    confidences: [f64; 4096],
    witnesses: [i64; 4096],
    count: i64,
}

fn proof_store_new() -> ProofStore {
    return ProofStore {
        tags: [0; 4096],
        prop_ids: [0; 4096],
        sub1_ids: [0; 4096],
        sub2_ids: [0; 4096],
        sub3_ids: [0; 4096],
        labels: [0; 4096],
        confidences: [0.0; 4096],
        witnesses: [0; 4096],
        count: 0,
    }
}

fn proof_store_alloc(store: &! ProofStore, p: Proof) -> i64 {
    let idx = store.count
    if idx >= 4096 {
        return 0 - 1
    }
    store.tags[idx] = p.tag
    store.prop_ids[idx] = p.prop_id
    store.sub1_ids[idx] = p.sub1_id
    store.sub2_ids[idx] = p.sub2_id
    store.sub3_ids[idx] = p.sub3_id
    store.labels[idx] = p.label
    store.confidences[idx] = p.confidence
    store.witnesses[idx] = p.witness
    store.count = idx + 1
    return idx
}

fn proof_store_get(store: &ProofStore, idx: i64) -> Proof {
    if idx < 0 {
        return Proof { tag: 0 - 1, prop_id: 0, sub1_id: 0, sub2_id: 0, sub3_id: 0, label: 0, confidence: 0.0, witness: 0 }
    }
    if idx >= store.count {
        return Proof { tag: 0 - 1, prop_id: 0, sub1_id: 0, sub2_id: 0, sub3_id: 0, label: 0, confidence: 0.0, witness: 0 }
    }
    return Proof {
        tag: store.tags[idx],
        prop_id: store.prop_ids[idx],
        sub1_id: store.sub1_ids[idx],
        sub2_id: store.sub2_ids[idx],
        sub3_id: store.sub3_ids[idx],
        label: store.labels[idx],
        confidence: store.confidences[idx],
        witness: store.witnesses[idx],
    }
}

// ============================================================================
// VERIFICATION RESULT
// ============================================================================

struct VerifyResult {
    is_valid: bool,
    confidence: f64,
    reason: i32,     // 0=ok, 1=tag_mismatch, 2=prop_mismatch, 3=confidence_invalid
}

fn verify_ok(conf: f64) -> VerifyResult {
    return VerifyResult { is_valid: true, confidence: conf, reason: 0 }
}

fn verify_fail(reason: i32) -> VerifyResult {
    return VerifyResult { is_valid: false, confidence: 0.0, reason: reason }
}

// ============================================================================
// PROOF CONTEXT — binds arena + proof store together
// ============================================================================

struct ProofContext {
    arena: PropArena,
    store: ProofStore,
}

fn proof_context_new() -> ProofContext {
    return ProofContext {
        arena: arena_new(),
        store: proof_store_new(),
    }
}

// Allocate a proposition in the context, return its ID
fn ctx_prop(ctx: &! ProofContext, p: Prop) -> i64 {
    return arena_alloc(&! ctx.arena, p)
}

// Allocate a proof in the context, return its ID
fn ctx_proof(ctx: &! ProofContext, p: Proof) -> i64 {
    return proof_store_alloc(&! ctx.store, p)
}

// Retrieve a proposition
fn ctx_get_prop(ctx: &ProofContext, id: i64) -> Prop {
    return arena_get(&ctx.arena, id)
}

// Retrieve a proof
fn ctx_get_proof(ctx: &ProofContext, id: i64) -> Proof {
    return proof_store_get(&ctx.store, id)
}

// ============================================================================
// NATURAL DEDUCTION: INTRODUCTION RULES
// ============================================================================

// True introduction: trivially provable
fn true_intro(ctx: &! ProofContext) -> i64 {
    let p_id = ctx_prop(ctx, prop_true())
    let prf = Proof {
        tag: PROOF_TRUE_INTRO,
        prop_id: p_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 1.0, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// And introduction: from P, Q derive P /\ Q
fn and_intro(ctx: &! ProofContext, p_proof_id: i64, q_proof_id: i64, pq_prop_id: i64) -> i64 {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let conf = min_f64(p_prf.confidence, q_prf.confidence)
    let prf = Proof {
        tag: PROOF_AND_INTRO,
        prop_id: pq_prop_id,
        sub1_id: p_proof_id,
        sub2_id: q_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or introduction left: from P derive P \/ Q
fn or_intro_left(ctx: &! ProofContext, p_proof_id: i64, pq_prop_id: i64) -> i64 {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let prf = Proof {
        tag: PROOF_OR_INTRO_L,
        prop_id: pq_prop_id,
        sub1_id: p_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: p_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or introduction right: from Q derive P \/ Q
fn or_intro_right(ctx: &! ProofContext, q_proof_id: i64, pq_prop_id: i64) -> i64 {
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let prf = Proof {
        tag: PROOF_OR_INTRO_R,
        prop_id: pq_prop_id,
        sub1_id: q_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: q_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Implication introduction: assuming P (sub1), we proved Q (sub2) => P -> Q
fn impl_intro(ctx: &! ProofContext, assume_id: i64, q_proof_id: i64, impl_prop_id: i64) -> i64 {
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let prf = Proof {
        tag: PROOF_IMPL_INTRO,
        prop_id: impl_prop_id,
        sub1_id: assume_id,
        sub2_id: q_proof_id,
        sub3_id: 0,
        label: 0, confidence: q_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Negation introduction: assuming P, derive False => ~P
fn not_intro(ctx: &! ProofContext, assume_id: i64, false_proof_id: i64, not_prop_id: i64) -> i64 {
    let f_prf = ctx_get_proof(ctx, false_proof_id)
    let prf = Proof {
        tag: PROOF_NOT_INTRO,
        prop_id: not_prop_id,
        sub1_id: assume_id,
        sub2_id: false_proof_id,
        sub3_id: 0,
        label: 0, confidence: f_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Universal introduction: for arbitrary x, prove P(x) => forall x. P(x)
fn forall_intro(ctx: &! ProofContext, body_proof_id: i64, forall_prop_id: i64) -> i64 {
    let body = ctx_get_proof(ctx, body_proof_id)
    let prf = Proof {
        tag: PROOF_FORALL_INTRO,
        prop_id: forall_prop_id,
        sub1_id: body_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: body.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Existential introduction: from P(t), derive exists x. P(x)
fn exists_intro(ctx: &! ProofContext, witness_val: i64, body_proof_id: i64, exists_prop_id: i64) -> i64 {
    let body = ctx_get_proof(ctx, body_proof_id)
    let prf = Proof {
        tag: PROOF_EXISTS_INTRO,
        prop_id: exists_prop_id,
        sub1_id: body_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: body.confidence, witness: witness_val,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// NATURAL DEDUCTION: ELIMINATION RULES
// ============================================================================

// And elimination left: from P /\ Q derive P
fn and_elim_left(ctx: &! ProofContext, pq_proof_id: i64, p_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let prf = Proof {
        tag: PROOF_AND_ELIM_L,
        prop_id: p_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// And elimination right: from P /\ Q derive Q
fn and_elim_right(ctx: &! ProofContext, pq_proof_id: i64, q_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let prf = Proof {
        tag: PROOF_AND_ELIM_R,
        prop_id: q_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or elimination: from P \/ Q, P-case proof, Q-case proof => R
fn or_elim(ctx: &! ProofContext, pq_proof_id: i64, p_case_id: i64, q_case_id: i64, r_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let p_case = ctx_get_proof(ctx, p_case_id)
    let q_case = ctx_get_proof(ctx, q_case_id)
    let conf = min_f64(pq.confidence, min_f64(p_case.confidence, q_case.confidence))
    let prf = Proof {
        tag: PROOF_OR_ELIM,
        prop_id: r_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: p_case_id,
        sub3_id: q_case_id,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Modus ponens: from P -> Q, P => Q
fn impl_elim(ctx: &! ProofContext, impl_proof_id: i64, p_proof_id: i64, q_prop_id: i64) -> i64 {
    let impl_prf = ctx_get_proof(ctx, impl_proof_id)
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let conf = min_f64(impl_prf.confidence, p_prf.confidence)
    let prf = Proof {
        tag: PROOF_IMPL_ELIM,
        prop_id: q_prop_id,
        sub1_id: impl_proof_id,
        sub2_id: p_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Negation elimination: from ~P, P => False
fn not_elim(ctx: &! ProofContext, not_p_id: i64, p_proof_id: i64) -> i64 {
    let np = ctx_get_proof(ctx, not_p_id)
    let pp = ctx_get_proof(ctx, p_proof_id)
    let false_prop = ctx_prop(ctx, prop_false())
    let conf = min_f64(np.confidence, pp.confidence)
    let prf = Proof {
        tag: PROOF_NOT_ELIM,
        prop_id: false_prop,
        sub1_id: not_p_id,
        sub2_id: p_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Ex falso quodlibet: from False, derive anything
fn false_elim(ctx: &! ProofContext, false_proof_id: i64, target_prop_id: i64) -> i64 {
    let fp = ctx_get_proof(ctx, false_proof_id)
    let prf = Proof {
        tag: PROOF_FALSE_ELIM,
        prop_id: target_prop_id,
        sub1_id: false_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: fp.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Universal elimination: from forall x. P(x), instantiate at term t => P(t)
fn forall_elim(ctx: &! ProofContext, forall_proof_id: i64, term: i64, result_prop_id: i64) -> i64 {
    let fp = ctx_get_proof(ctx, forall_proof_id)
    let prf = Proof {
        tag: PROOF_FORALL_ELIM,
        prop_id: result_prop_id,
        sub1_id: forall_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: fp.confidence, witness: term,
    }
    return ctx_proof(ctx, prf)
}

// Existential elimination: from (exists x. P(x)), use the witness
fn exists_elim(ctx: &! ProofContext, exists_proof_id: i64, body_proof_id: i64, result_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, exists_proof_id)
    let bp = ctx_get_proof(ctx, body_proof_id)
    let conf = min_f64(ep.confidence, bp.confidence)
    let prf = Proof {
        tag: PROOF_EXISTS_ELIM,
        prop_id: result_prop_id,
        sub1_id: exists_proof_id,
        sub2_id: body_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// EQUALITY
// ============================================================================

// Reflexivity: a = a
fn refl(ctx: &! ProofContext, a: i64) -> i64 {
    let eq_prop = ctx_prop(ctx, prop_eq(a, a))
    let prf = Proof {
        tag: PROOF_REFL,
        prop_id: eq_prop,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 1.0, witness: a,
    }
    return ctx_proof(ctx, prf)
}

// Symmetry: a = b => b = a
fn sym(ctx: &! ProofContext, eq_proof_id: i64, ba_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let prf = Proof {
        tag: PROOF_SYM,
        prop_id: ba_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: ep.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Transitivity: a = b, b = c => a = c
fn trans(ctx: &! ProofContext, ab_proof_id: i64, bc_proof_id: i64, ac_prop_id: i64) -> i64 {
    let ab = ctx_get_proof(ctx, ab_proof_id)
    let bc = ctx_get_proof(ctx, bc_proof_id)
    let conf = min_f64(ab.confidence, bc.confidence)
    let prf = Proof {
        tag: PROOF_TRANS,
        prop_id: ac_prop_id,
        sub1_id: ab_proof_id,
        sub2_id: bc_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Congruence: a = b => f(a) = f(b)
fn cong(ctx: &! ProofContext, f_id: i64, eq_proof_id: i64, result_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let prf = Proof {
        tag: PROOF_CONG,
        prop_id: result_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: f_id, confidence: ep.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Substitution: a = b, P(a) => P(b)
fn subst(ctx: &! ProofContext, eq_proof_id: i64, pa_proof_id: i64, pb_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let pa = ctx_get_proof(ctx, pa_proof_id)
    let conf = min_f64(ep.confidence, pa.confidence)
    let prf = Proof {
        tag: PROOF_SUBST,
        prop_id: pb_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: pa_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// PROOF COMPOSITION
// ============================================================================

// Chain two proofs together
fn compose(ctx: &! ProofContext, p1_id: i64, p2_id: i64, result_prop_id: i64) -> i64 {
    let p1 = ctx_get_proof(ctx, p1_id)
    let p2 = ctx_get_proof(ctx, p2_id)
    let conf = min_f64(p1.confidence, p2.confidence)
    let prf = Proof {
        tag: PROOF_COMPOSE,
        prop_id: result_prop_id,
        sub1_id: p1_id,
        sub2_id: p2_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Weaken: add unused hypothesis (proof still holds, confidence unchanged)
fn weaken(ctx: &! ProofContext, proof_id: i64, extra_prop_id: i64) -> i64 {
    let p = ctx_get_proof(ctx, proof_id)
    let prf = Proof {
        tag: PROOF_WEAKEN,
        prop_id: p.prop_id,
        sub1_id: proof_id,
        sub2_id: extra_prop_id,
        sub3_id: 0,
        label: 0, confidence: p.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// TRUST BOUNDARIES
// ============================================================================

// Trusted: escape hatch. Creates a proof by fiat.
// confidence = 1.0 by default but caller can override.
// Maps to ProofKind::Trusted in the compiler.
fn trusted(ctx: &! ProofContext, reason: i64, prop_id: i64, confidence: f64) -> i64 {
    var conf = confidence
    if conf < 0.0 { conf = 0.0 }
    if conf > 1.0 { conf = 1.0 }
    let prf = Proof {
        tag: PROOF_TRUSTED,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: reason, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Assume: introduce a hypothesis from context.
// Maps to ProofKind::Assume in the compiler.
fn assume(ctx: &! ProofContext, name: i64, prop_id: i64) -> i64 {
    let prf = Proof {
        tag: PROOF_ASSUME,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: name, confidence: 1.0, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Runtime check: defers verification to runtime (gradual typing).
// Confidence is 0.9 — not fully static but likely correct.
// Maps to ProofKind::RuntimeCheck in the compiler.
fn runtime_check(ctx: &! ProofContext, prop_id: i64) -> i64 {
    let prf = Proof {
        tag: PROOF_RUNTIME,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 0.9, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// PROOF INSPECTION
// ============================================================================

// Get the confidence of a proof
fn proof_confidence(ctx: &ProofContext, proof_id: i64) -> f64 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.confidence
}

// Get the proposition a proof witnesses
fn proof_prop_id(ctx: &ProofContext, proof_id: i64) -> i64 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.prop_id
}

// Is this proof fully static (no runtime checks, no trusted, confidence = 1.0)?
fn proof_is_static(ctx: &ProofContext, proof_id: i64) -> bool {
    let p = ctx_get_proof(ctx, proof_id)
    if p.tag == PROOF_TRUSTED { return false }
    if p.tag == PROOF_RUNTIME { return false }
    if p.confidence < 1.0 { return false }
    return true
}

// Get the proof tag (rule used)
fn proof_tag(ctx: &ProofContext, proof_id: i64) -> i32 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.tag
}

// ============================================================================
// VERIFICATION
// ============================================================================

// Verify a proof: check that the proof tag is consistent with its proposition.
// Returns VerifyResult with validity and confidence.
fn verify(ctx: &ProofContext, proof_id: i64) -> VerifyResult {
    let p = ctx_get_proof(ctx, proof_id)

    // Invalid proof ID
    if p.tag < 0 {
        return verify_fail(1)
    }

    // Confidence bounds check
    if p.confidence < 0.0 {
        return verify_fail(3)
    }
    if p.confidence > 1.0 {
        return verify_fail(3)
    }

    let prop = ctx_get_prop(ctx, p.prop_id)

    // Tag-specific validation
    if p.tag == PROOF_TRUE_INTRO {
        if prop.tag == PROP_TRUE {
            return verify_ok(p.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_REFL {
        if prop.tag == PROP_EQ {
            if prop.eq_lhs == prop.eq_rhs {
                return verify_ok(1.0)
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_INTRO {
        if prop.tag == PROP_AND {
            let s1 = ctx_get_proof(ctx, p.sub1_id)
            let s2 = ctx_get_proof(ctx, p.sub2_id)
            if s1.tag >= 0 {
                if s2.tag >= 0 {
                    return verify_ok(min_f64(s1.confidence, s2.confidence))
                }
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_ELIM_L {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_AND {
            return verify_ok(parent.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_ELIM_R {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_AND {
            return verify_ok(parent.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_IMPL_ELIM {
        let impl_prf = ctx_get_proof(ctx, p.sub1_id)
        let impl_prop = ctx_get_prop(ctx, impl_prf.prop_id)
        if impl_prop.tag == PROP_IMPLIES {
            let ante_prf = ctx_get_proof(ctx, p.sub2_id)
            return verify_ok(min_f64(impl_prf.confidence, ante_prf.confidence))
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_SYM {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_EQ {
            if prop.tag == PROP_EQ {
                return verify_ok(parent.confidence)
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_TRANS {
        let ab = ctx_get_proof(ctx, p.sub1_id)
        let bc = ctx_get_proof(ctx, p.sub2_id)
        let ab_prop = ctx_get_prop(ctx, ab.prop_id)
        let bc_prop = ctx_get_prop(ctx, bc.prop_id)
        if ab_prop.tag == PROP_EQ {
            if bc_prop.tag == PROP_EQ {
                return verify_ok(min_f64(ab.confidence, bc.confidence))
            }
        }
        return verify_fail(2)
    }

    // Trust boundaries: always valid by construction
    if p.tag == PROOF_TRUSTED {
        return verify_ok(p.confidence)
    }

    if p.tag == PROOF_ASSUME {
        return verify_ok(p.confidence)
    }

    if p.tag == PROOF_RUNTIME {
        return verify_ok(p.confidence)
    }

    // For other proof tags, validate structurally
    if p.tag == PROOF_OR_INTRO_L { return verify_ok(p.confidence) }
    if p.tag == PROOF_OR_INTRO_R { return verify_ok(p.confidence) }
    if p.tag == PROOF_OR_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_IMPL_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_NOT_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_NOT_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_FALSE_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_FORALL_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_FORALL_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_EXISTS_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_EXISTS_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_CONG { return verify_ok(p.confidence) }
    if p.tag == PROOF_SUBST { return verify_ok(p.confidence) }
    if p.tag == PROOF_COMPOSE { return verify_ok(p.confidence) }
    if p.tag == PROOF_WEAKEN { return verify_ok(p.confidence) }

    return verify_fail(1)
}

// ============================================================================
// PROPOSITION HELPERS
// ============================================================================

// Check if two propositions are structurally equal
fn prop_eq_check(a: Prop, b: Prop) -> bool {
    if a.tag != b.tag { return false }
    if a.left_id != b.left_id { return false }
    if a.right_id != b.right_id { return false }
    if a.var_name != b.var_name { return false }
    if a.predicate_id != b.predicate_id { return false }
    if a.eq_lhs != b.eq_lhs { return false }
    if a.eq_rhs != b.eq_rhs { return false }
    return true
}

// Get the tag name as integer code (for debugging)
fn prop_tag_name(tag: i32) -> i32 {
    return tag
}

// == original file begins ==
// Sounio Theorem Epistemic — Epistemic Proof Theory
//
// THE NOVEL MODULE. Proofs ABOUT and UNDER uncertainty.
// No other proof assistant provides this.
//
// Key insight: In Lean/Coq you prove P or ~P.
// In Sounio you prove:
//   - "P with confidence >= epsilon"
//   - "Confidence(P) propagates correctly through computation f"
//   - "sensor_fusion(a, b) is the BLUE estimator"
//   - "epistemic_decay(conf, lambda, t) >= threshold"
//
// These are EPISTEMIC THEOREMS — a new class of theorem unique to Sounio.
//
// References:
//   JCGM 100:2008 — GUM: Guide to the Expression of Uncertainty in Measurement
//   Dempster (1967), "Upper and Lower Probabilities Induced by a Multivalued Mapping"
//   Shafer (1976), "A Mathematical Theory of Evidence"
//   Gauss-Markov theorem — BLUE optimality of inverse-variance weighting
//   Sounio formal/lean4/SounioEpistemic.lean — confidence lattice formalization

// kernel definitions loaded as sibling — no explicit import needed

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
}

fn sqrt_ep(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    return sqrt(x)
}

fn exp_ep(x: f64) -> f64 {
    return exp(x)
}

fn abs_ep(x: f64) -> f64 {
    return fabs(x)
}

fn min_ep(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn max_ep(a: f64, b: f64) -> f64 {
    if a > b { a } else { b }
}

// ============================================================================
// EPISTEMIC PROPOSITION TYPES
// ============================================================================

// An epistemic proposition: a logical claim with a confidence bound
struct EpistemicProp {
    base_prop_id: i64,    // the underlying logical proposition
    min_confidence: f64,  // lower bound on confidence
    max_confidence: f64,  // upper bound (for interval)
    knightian: bool,      // if true, confidence is undefined (Knightian)
}

fn epistemic_prop(ctx: &! ProofContext, base: i64, min_conf: f64) -> EpistemicProp {
    var lo = min_conf
    if lo < 0.0 { lo = 0.0 }
    if lo > 1.0 { lo = 1.0 }
    return EpistemicProp {
        base_prop_id: base,
        min_confidence: lo,
        max_confidence: 1.0,
        knightian: false,
    }
}

fn epistemic_prop_interval(base: i64, lo: f64, hi: f64) -> EpistemicProp {
    var low = lo
    var high = hi
    if low < 0.0 { low = 0.0 }
    if high > 1.0 { high = 1.0 }
    if low > high { low = high }
    return EpistemicProp {
        base_prop_id: base,
        min_confidence: low,
        max_confidence: high,
        knightian: false,
    }
}

fn epistemic_prop_knightian(base: i64) -> EpistemicProp {
    return EpistemicProp {
        base_prop_id: base,
        min_confidence: 0.0,
        max_confidence: 1.0,
        knightian: true,
    }
}

// ============================================================================
// EPISTEMIC PROOF TYPE
// ============================================================================

// A proof that carries both logical validity AND confidence metadata
struct EpistemicProof {
    prf_id: i64,           // the kernel proof
    confidence: f64,       // computed confidence of this proof
    uncertainty: f64,      // standard uncertainty of the conclusion
    provenance_steps: i32, // number of derivation steps
}

fn epistemic_proof_new(ctx: &! ProofContext, prop_id: i64, confidence: f64, uncertainty: f64) -> EpistemicProof {
    var conf = confidence
    if conf < 0.0 { conf = 0.0 }
    if conf > 1.0 { conf = 1.0 }
    let prf_id = trusted(ctx, 8000, prop_id, conf)
    return EpistemicProof {
        prf_id: prf_id,
        confidence: conf,
        uncertainty: if uncertainty < 0.0 { 0.0 } else { uncertainty },
        provenance_steps: 1,
    }
}

fn epistemic_proof_compose(ctx: &! ProofContext, a: EpistemicProof, b: EpistemicProof, result_prop: i64) -> EpistemicProof {
    let conf = min_ep(a.confidence, b.confidence)
    let unc = sqrt_ep(a.uncertainty * a.uncertainty + b.uncertainty * b.uncertainty)
    let prf_id = compose(ctx, a.prf_id, b.prf_id, result_prop)
    return EpistemicProof {
        prf_id: prf_id,
        confidence: conf,
        uncertainty: unc,
        provenance_steps: a.provenance_steps + b.provenance_steps,
    }
}

// ============================================================================
// PROPAGATION PROOF TYPE
// ============================================================================

// Proof that uncertainty propagates correctly through function f
struct PropagationProof {
    method: i32,              // 0=GUM_linear, 1=GUM_quadrature, 2=MC, 3=Interval
    input_uncertainty: f64,
    output_uncertainty: f64,
    correctness_id: i64,
}

fn propagation_proof_new(ctx: &! ProofContext, method: i32, u_in: f64, u_out: f64, prop_id: i64) -> PropagationProof {
    let prf_id = trusted(ctx, 8010, prop_id, 1.0)
    return PropagationProof {
        method: method,
        input_uncertainty: u_in,
        output_uncertainty: u_out,
        correctness_id: prf_id,
    }
}

// ============================================================================
// CONFIDENCE MONOTONICITY THEOREMS
// ============================================================================
// THE KEY THEOREMS: formalize what formal/lean4/SounioEpistemic.lean proves.
// "Under any pure transformation, confidence never increases."

// conf(a + b) <= min(conf(a), conf(b))
fn confidence_monotone_add(ctx: &! ProofContext, a_conf: f64, b_conf: f64) -> EpistemicProof {
    let combined = min_ep(a_conf, b_conf)
    // This mirrors knowledgeLeq_add from SounioEpistemic.lean:
    //   knowledge_add_leq : K(a+b).eps <= min(K(a).eps, K(b).eps)
    let prop = ctx_prop(ctx, prop_custom(80001))
    let prf_id = trusted(ctx, 8100, prop, 1.0)
    return EpistemicProof {
        prf_id: prf_id,
        confidence: combined,
        uncertainty: 0.0,
        provenance_steps: 1,
    }
}

// conf(a * b) <= min(conf(a), conf(b))
fn confidence_monotone_mul(ctx: &! ProofContext, a_conf: f64, b_conf: f64) -> EpistemicProof {
    let combined = min_ep(a_conf, b_conf)
    // Mirrors ProofKind::MonoMul in the compiler
    let prop = ctx_prop(ctx, prop_custom(80002))
    let prf_id = trusted(ctx, 8101, prop, 1.0)
    return EpistemicProof {
        prf_id: prf_id,
        confidence: combined,
        uncertainty: 0.0,
        provenance_steps: 1,
    }
}

// conf(f ∘ g) <= conf(f) * conf(g)  (pipeline composition)
fn confidence_monotone_compose(ctx: &! ProofContext, f_conf: f64, g_conf: f64) -> EpistemicProof {
    // Pipeline: each stage multiplies confidence
    let combined = f_conf * g_conf
    let prop = ctx_prop(ctx, prop_custom(80003))
    let prf_id = trusted(ctx, 8102, prop, 1.0)
    return EpistemicProof {
        prf_id: prf_id,
        confidence: combined,
        uncertainty: 0.0,
        provenance_steps: 2,
    }
}

// ============================================================================
// GUM UNCERTAINTY PROPAGATION PROOFS
// ============================================================================
// Verifies JCGM 100:2008 formulas used in stdlib/epistemic/core.sio

// u(a + b) = sqrt(u(a)^2 + u(b)^2) for independent inputs
fn gum_add_proof(ctx: &! ProofContext, u_a: f64, u_b: f64) -> PropagationProof {
    let u_out = sqrt_ep(u_a * u_a + u_b * u_b)
    // GUM equation 13: c_i = 1 for addition, so u_out = sqrt(u_a^2 + u_b^2)
    let prop = ctx_prop(ctx, prop_custom(81001))
    return propagation_proof_new(ctx, 1, sqrt_ep(u_a * u_a + u_b * u_b), u_out, prop)
}

// u_rel(a * b) = sqrt(u_rel(a)^2 + u_rel(b)^2) for independent inputs
fn gum_mul_proof(ctx: &! ProofContext, a: f64, u_a: f64, b: f64, u_b: f64) -> PropagationProof {
    var u_rel_a: f64 = 0.0
    var u_rel_b: f64 = 0.0
    if abs_ep(a) > 1e-15 { u_rel_a = u_a / abs_ep(a) }
    if abs_ep(b) > 1e-15 { u_rel_b = u_b / abs_ep(b) }
    let u_rel_out = sqrt_ep(u_rel_a * u_rel_a + u_rel_b * u_rel_b)
    let u_out = u_rel_out * abs_ep(a * b)
    let prop = ctx_prop(ctx, prop_custom(81002))
    return propagation_proof_new(ctx, 1, sqrt_ep(u_a * u_a + u_b * u_b), u_out, prop)
}

// u_rel(a / b) = sqrt(u_rel(a)^2 + u_rel(b)^2) for b != 0
fn gum_div_proof(ctx: &! ProofContext, a: f64, u_a: f64, b: f64, u_b: f64, b_nonzero: i64) -> PropagationProof {
    var u_rel_a: f64 = 0.0
    var u_rel_b: f64 = 0.0
    if abs_ep(a) > 1e-15 { u_rel_a = u_a / abs_ep(a) }
    if abs_ep(b) > 1e-15 { u_rel_b = u_b / abs_ep(b) }
    let u_rel_out = sqrt_ep(u_rel_a * u_rel_a + u_rel_b * u_rel_b)
    let result = if abs_ep(b) > 1e-15 { abs_ep(a) / abs_ep(b) } else { 0.0 }
    let u_out = u_rel_out * result
    let prop = ctx_prop(ctx, prop_custom(81003))
    let b_prf = ctx_get_proof(ctx, b_nonzero)
    let prf_id = trusted(ctx, 8110, prop, b_prf.confidence)
    return PropagationProof {
        method: 1,
        input_uncertainty: sqrt_ep(u_a * u_a + u_b * u_b),
        output_uncertainty: u_out,
        correctness_id: prf_id,
    }
}

// u(f(x)) = |df/dx| * u(x)  (first-order / linear GUM)
fn gum_function_proof(ctx: &! ProofContext, f_derivative: f64, input_uncertainty: f64) -> PropagationProof {
    let u_out = abs_ep(f_derivative) * input_uncertainty
    let prop = ctx_prop(ctx, prop_custom(81004))
    return propagation_proof_new(ctx, 0, input_uncertainty, u_out, prop)
}

// Multivariate: u(f)^2 = sum_i (df/dx_i)^2 * u(x_i)^2
fn gum_multivariate_proof(ctx: &! ProofContext, partials: [f64; 16], uncertainties: [f64; 16], n: i32) -> PropagationProof {
    var sum: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as i64
        let term = partials[idx] * partials[idx] * uncertainties[idx] * uncertainties[idx]
        sum = sum + term
        i = i + 1
    }
    let u_out = sqrt_ep(sum)
    let prop = ctx_prop(ctx, prop_custom(81005))
    return propagation_proof_new(ctx, 1, 0.0, u_out, prop)
}

// ============================================================================
// DEMPSTER-SHAFER COMBINATION PROOFS
// ============================================================================

struct DSProof {
    source1_belief: f64,
    source2_belief: f64,
    combined_belief: f64,
    conflict: f64,
    correctness_id: i64,
}

// Prove correctness of Dempster's combination rule
// m12 = normalize(m1 * m2), K = sum of conflicting masses
fn ds_combine_proof(ctx: &! ProofContext, bel1: f64, bel2: f64) -> DSProof {
    // Simplified Dempster-Shafer for binary frame {H, ~H}
    // m1 = {H: bel1, ~H: 1-bel1}
    // m2 = {H: bel2, ~H: 1-bel2}
    // K = m1(H) * m2(~H) + m1(~H) * m2(H)  (conflict)
    let m1_h = bel1
    let m1_nh = 1.0 - bel1
    let m2_h = bel2
    let m2_nh = 1.0 - bel2
    let conflict = m1_h * m2_nh + m1_nh * m2_h
    let denom = 1.0 - conflict
    var combined: f64 = 0.5  // default if highly conflicted
    if denom > 1e-10 {
        combined = (m1_h * m2_h) / denom
    }
    let prop = ctx_prop(ctx, prop_custom(82001))
    let prf_id = trusted(ctx, 8200, prop, 1.0)
    return DSProof {
        source1_belief: bel1,
        source2_belief: bel2,
        combined_belief: combined,
        conflict: conflict,
        correctness_id: prf_id,
    }
}

// Prove conflict K < max_k
fn ds_conflict_bound(ctx: &! ProofContext, bel1: f64, bel2: f64, max_k: f64) -> EpistemicProof {
    let ds = ds_combine_proof(ctx, bel1, bel2)
    let prop = ctx_prop(ctx, prop_custom(82002))
    if ds.conflict < max_k {
        return epistemic_proof_new(ctx, prop, 1.0, ds.conflict)
    }
    return epistemic_proof_new(ctx, prop, 0.0, ds.conflict)
}

// Combining with vacuous evidence doesn't change belief
fn ds_vacuous_identity(ctx: &! ProofContext, bel: f64) -> EpistemicProof {
    // Vacuous BBA: m_vac = {Theta: 1.0} (all mass on whole frame)
    // DS combination with vacuous: result = original
    // With bel2 = 0.5 (uniform/vacuous), check result ≈ bel1
    let ds = ds_combine_proof(ctx, bel, 0.5)
    let diff = abs_ep(ds.combined_belief - bel)
    let prop = ctx_prop(ctx, prop_custom(82003))
    // For vacuous (bel2=0.5): combined = bel1*0.5 / (1 - (bel1*0.5 + (1-bel1)*0.5))
    // This simplifies: conflict = 0.5*(1-bel1) + 0.5*bel1 = 0.5, denom = 0.5
    // combined = bel1 * 0.5 / 0.5 = bel1  ✓
    if diff < 1e-10 {
        return epistemic_proof_new(ctx, prop, 1.0, 0.0)
    }
    return epistemic_proof_new(ctx, prop, 0.0, diff)
}

// Stronger evidence => higher combined belief
fn ds_monotone(ctx: &! ProofContext, bel1: f64, bel2: f64, bel2_stronger: f64) -> EpistemicProof {
    let ds1 = ds_combine_proof(ctx, bel1, bel2)
    let ds2 = ds_combine_proof(ctx, bel1, bel2_stronger)
    let prop = ctx_prop(ctx, prop_custom(82004))
    if bel2_stronger >= bel2 {
        if ds2.combined_belief >= ds1.combined_belief - 1e-10 {
            return epistemic_proof_new(ctx, prop, 1.0, 0.0)
        }
    }
    return epistemic_proof_new(ctx, prop, 0.0, 0.0)
}

// ============================================================================
// TEMPORAL DECAY PROOFS
// ============================================================================

struct DecayProof {
    initial_confidence: f64,
    lambda: f64,
    t: f64,
    final_confidence: f64,
    bound_id: i64,
}

// Compute epsilon(t) = epsilon_0 * exp(-lambda * t)
fn decay_proof(ctx: &! ProofContext, epsilon_0: f64, lambda: f64, t: f64) -> DecayProof {
    let final_conf = epsilon_0 * exp_ep(0.0 - lambda * t)
    let prop = ctx_prop(ctx, prop_custom(83001))
    let bound_id = trusted(ctx, 8300, prop, 1.0)
    return DecayProof {
        initial_confidence: epsilon_0,
        lambda: lambda,
        t: t,
        final_confidence: final_conf,
        bound_id: bound_id,
    }
}

// Prove epsilon_0 * exp(-lambda * t) >= min_epsilon
// Mirrors ProofKind::DecayBound in the compiler
fn decay_bound_proof(ctx: &! ProofContext, epsilon_0: f64, lambda: f64, t: f64, min_epsilon: f64) -> EpistemicProof {
    let final_conf = epsilon_0 * exp_ep(0.0 - lambda * t)
    let prop = ctx_prop(ctx, prop_custom(83002))
    if final_conf >= min_epsilon - 1e-15 {
        return epistemic_proof_new(ctx, prop, 1.0, abs_ep(final_conf - min_epsilon))
    }
    return epistemic_proof_new(ctx, prop, 0.0, abs_ep(final_conf - min_epsilon))
}

// Prove t_half = ln(2) / lambda
fn decay_half_life(ctx: &! ProofContext, lambda: f64) -> EpistemicProof {
    let prop = ctx_prop(ctx, prop_custom(83003))
    if lambda > 1e-15 {
        // t_half = ln(2)/lambda. At t_half: exp(-lambda * t_half) = exp(-ln(2)) = 0.5
        let t_half = 0.6931471805599453 / lambda  // ln(2) / lambda
        let check = exp_ep(0.0 - lambda * t_half)
        let diff = abs_ep(check - 0.5)
        if diff < 1e-10 {
            return epistemic_proof_new(ctx, prop, 1.0, diff)
        }
    }
    return epistemic_proof_new(ctx, prop, 0.0, 0.0)
}

// Return max time t such that decay(epsilon_0, lambda, t) >= required
fn decay_sufficient_freshness(epsilon_0: f64, lambda: f64, required: f64) -> f64 {
    if lambda <= 0.0 { return 1e18 }  // no decay
    if epsilon_0 <= required { return 0.0 }
    // epsilon_0 * exp(-lambda * t) >= required
    // exp(-lambda * t) >= required / epsilon_0
    // -lambda * t <= ln(required / epsilon_0)
    // t <= -ln(required / epsilon_0) / lambda  (since lambda > 0)
    let ratio = required / epsilon_0
    if ratio <= 0.0 { return 1e18 }
    let ln_ratio = log(ratio)  // negative since ratio < 1
    return (0.0 - ln_ratio) / lambda
}

// ============================================================================
// SENSOR FUSION PROOFS
// ============================================================================

struct FusionProof {
    n_sources: i32,
    fused_value: f64,
    fused_uncertainty: f64,
    optimality_id: i64,
}

// Inverse-variance weighting is BLUE (Best Linear Unbiased Estimator)
// Gauss-Markov theorem: inv-var weighting minimizes variance among linear unbiased estimators
fn inverse_variance_optimal(ctx: &! ProofContext, values: [f64; 16], uncertainties: [f64; 16], n: i32) -> FusionProof {
    var sum_w: f64 = 0.0
    var sum_wx: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as i64
        let u = uncertainties[idx]
        if u > 1e-15 {
            let w = 1.0 / (u * u)
            sum_w = sum_w + w
            sum_wx = sum_wx + w * values[idx]
        }
        i = i + 1
    }
    var fused: f64 = 0.0
    var u_fused: f64 = 0.0
    if sum_w > 1e-15 {
        fused = sum_wx / sum_w
        u_fused = 1.0 / sqrt_ep(sum_w)
    }

    let prop = ctx_prop(ctx, prop_custom(84001))
    // BLUE optimality: proven by Gauss-Markov. Trusted with confidence 1.0.
    let opt_id = trusted(ctx, 8400, prop, 1.0)

    return FusionProof {
        n_sources: n,
        fused_value: fused,
        fused_uncertainty: u_fused,
        optimality_id: opt_id,
    }
}

// Fusion narrows uncertainty: u_fused < min(u_1, u_2) for two independent sources
fn fusion_narrows_uncertainty(ctx: &! ProofContext, u1: f64, u2: f64) -> EpistemicProof {
    // u_fused = 1 / sqrt(1/u1^2 + 1/u2^2)
    var u_fused: f64 = 0.0
    let sum_inv = 1.0 / (u1 * u1) + 1.0 / (u2 * u2)
    if sum_inv > 1e-15 {
        u_fused = 1.0 / sqrt_ep(sum_inv)
    }
    let min_u = min_ep(u1, u2)
    let prop = ctx_prop(ctx, prop_custom(84002))
    if u_fused < min_u + 1e-10 {
        return epistemic_proof_new(ctx, prop, 1.0, u_fused)
    }
    return epistemic_proof_new(ctx, prop, 0.0, u_fused)
}

// Fusion consistency: Birge ratio test
fn fusion_consistency_check(ctx: &! ProofContext, values: [f64; 16], uncertainties: [f64; 16], n: i32, chi2_threshold: f64) -> EpistemicProof {
    let fp = inverse_variance_optimal(ctx, values, uncertainties, n)
    // Compute chi^2 statistic
    var chi2: f64 = 0.0
    var i: i32 = 0
    while i < n {
        let idx = i as i64
        let u = uncertainties[idx]
        if u > 1e-15 {
            let res = values[idx] - fp.fused_value
            chi2 = chi2 + (res * res) / (u * u)
        }
        i = i + 1
    }
    let prop = ctx_prop(ctx, prop_custom(84003))
    let dof = if n > 1 { n - 1 } else { 1 }
    let chi2_per_dof = chi2 / (dof as f64)
    if chi2_per_dof <= chi2_threshold {
        return epistemic_proof_new(ctx, prop, 1.0, chi2_per_dof)
    }
    return epistemic_proof_new(ctx, prop, 0.5, chi2_per_dof)
}

// ============================================================================
// KNIGHTIAN UNCERTAINTY PROOFS
// ============================================================================

// If any input has Knightian uncertainty, the output is Knightian.
// Mirrors KnightianMode::compose in the compiler.
fn knightian_propagates(ctx: &! ProofContext, source: EpistemicProp) -> EpistemicProof {
    let prop = ctx_prop(ctx, prop_custom(85001))
    if source.knightian {
        return epistemic_proof_new(ctx, prop, 1.0, 0.0)
    }
    return epistemic_proof_new(ctx, prop, 0.0, 0.0)
}

// Knightian and Bayesian frameworks are incompatible
// Cannot Bayes-update Knightian uncertainty
fn knightian_not_bayesian(ctx: &! ProofContext, source: EpistemicProp) -> EpistemicProof {
    let prop = ctx_prop(ctx, prop_custom(85002))
    // This is a meta-theorem about the framework
    return epistemic_proof_new(ctx, prop, 1.0, 0.0)
}

// The ONLY operation that converts Knightian -> Defined: model discovery
fn model_discovery_lifts_knightian(ctx: &! ProofContext, prior: EpistemicProp, model_id: i64) -> EpistemicProp {
    if prior.knightian {
        // Model discovery lifts Knightian to Bayesian
        return EpistemicProp {
            base_prop_id: prior.base_prop_id,
            min_confidence: 0.5,  // minimum confidence after model discovery
            max_confidence: 1.0,
            knightian: false,
        }
    }
    return prior
}

// ============================================================================
// EPISTEMIC SUBTYPING PROOFS
// ============================================================================

// Knowledge<T, ε₁> <: Knowledge<T, ε₂> when ε₁ >= ε₂
// Mirrors S-COV rule from crates/souc/src/dependent/subtyping.rs
fn epistemic_subtype(ctx: &! ProofContext, higher_conf: f64, lower_conf: f64) -> i64 {
    let prop = ctx_prop(ctx, prop_custom(86001))
    if higher_conf >= lower_conf - 1e-15 {
        return trusted(ctx, 8600, prop, 1.0)
    }
    return trusted(ctx, 8600, prop, 0.0)
}

// Refinement weakening: {x:T | P(x)} <: T
fn epistemic_refinement_weakening(ctx: &! ProofContext, refined_id: i64) -> i64 {
    let r_prf = ctx_get_proof(ctx, refined_id)
    let prop = ctx_prop(ctx, prop_custom(86002))
    return trusted(ctx, 8601, prop, r_prf.confidence)
}

// ============================================================================
// COMPOSITION THEOREMS
// ============================================================================

// Pipeline confidence = product of stage confidences
// Also: pipeline_confidence <= min(stage_confidences)
fn pipeline_confidence(ctx: &! ProofContext, stages: [f64; 16], n: i32) -> EpistemicProof {
    var product: f64 = 1.0
    var minimum: f64 = 1.0
    var i: i32 = 0
    while i < n {
        let c = stages[i as i64]
        product = product * c
        if c < minimum { minimum = c }
        i = i + 1
    }
    let prop = ctx_prop(ctx, prop_custom(87001))
    // Both properties hold: product <= minimum (since all stages <= 1)
    return epistemic_proof_new(ctx, prop, 1.0, 0.0)
}

// Epistemic triangle inequality: u(a - b) >= ||u(a) - u(b)||
fn epistemic_triangle_ineq(ctx: &! ProofContext, u_a: f64, u_b: f64) -> EpistemicProof {
    let lhs_min = if u_a > u_b { u_a - u_b } else { u_b - u_a }
    // u(a-b) >= |u(a) - u(b)| by triangle inequality applied to uncertainties
    let u_diff = sqrt_ep(u_a * u_a + u_b * u_b)  // GUM for subtraction
    let prop = ctx_prop(ctx, prop_custom(87002))
    if u_diff >= lhs_min - 1e-10 {
        return epistemic_proof_new(ctx, prop, 1.0, lhs_min)
    }
    return epistemic_proof_new(ctx, prop, 0.0, lhs_min)
}

// ============================================================================
// EPISTEMIC VALIDITY CHECK
// ============================================================================

// Check that an epistemic proof is internally consistent
fn epistemic_valid(ctx: &ProofContext, ep: EpistemicProof) -> bool {
    if ep.confidence < 0.0 { return false }
    if ep.confidence > 1.0 { return false }
    if ep.uncertainty < 0.0 { return false }
    let prf = ctx_get_proof(ctx, ep.prf_id)
    let vr = verify(ctx, ep.prf_id)
    return vr.is_valid
}
