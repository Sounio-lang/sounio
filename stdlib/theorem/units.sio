// Sounio Theorem Units — Dimensional Analysis as Theorem Proving
//
// Proofs that unit expressions are equivalent, conversions are correct,
// and physical constants satisfy known dimensional relationships.
//
// Connects to stdlib/units/ and stdlib/epistemic/core.sio.
// Unique: convert_epistemic proves conversions preserve uncertainty.
//
// References:
//   SI brochure (2019) — International System of Units
//   CODATA 2018 — NIST values for physical constants

// kernel definitions loaded as sibling — no explicit import needed

// ============================================================================
// DIMENSION TYPE (SI 7-tuple of exponents)
// ============================================================================

// Dimension vector: exponents of the 7 SI base units
// [length(m), mass(kg), time(s), current(A), temperature(K), amount(mol), luminosity(cd)]
struct Dimension {
    length: i32,
    mass: i32,
    time: i32,
    current: i32,
    temperature: i32,
    amount: i32,
    luminosity: i32,
}

fn dim_dimensionless() -> Dimension {
    return Dimension { length: 0, mass: 0, time: 0, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_length() -> Dimension {
    return Dimension { length: 1, mass: 0, time: 0, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_mass() -> Dimension {
    return Dimension { length: 0, mass: 1, time: 0, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_time_unit() -> Dimension {
    return Dimension { length: 0, mass: 0, time: 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_current() -> Dimension {
    return Dimension { length: 0, mass: 0, time: 0, current: 1, temperature: 0, amount: 0, luminosity: 0 }
}

fn dim_temperature() -> Dimension {
    return Dimension { length: 0, mass: 0, time: 0, current: 0, temperature: 1, amount: 0, luminosity: 0 }
}

fn dim_amount() -> Dimension {
    return Dimension { length: 0, mass: 0, time: 0, current: 0, temperature: 0, amount: 1, luminosity: 0 }
}

// ============================================================================
// DIMENSION ALGEBRA
// ============================================================================

// Product of dimensions: exponents add
fn dim_mul(a: Dimension, b: Dimension) -> Dimension {
    return Dimension {
        length: a.length + b.length,
        mass: a.mass + b.mass,
        time: a.time + b.time,
        current: a.current + b.current,
        temperature: a.temperature + b.temperature,
        amount: a.amount + b.amount,
        luminosity: a.luminosity + b.luminosity,
    }
}

// Division of dimensions: exponents subtract
fn dim_div(a: Dimension, b: Dimension) -> Dimension {
    return Dimension {
        length: a.length - b.length,
        mass: a.mass - b.mass,
        time: a.time - b.time,
        current: a.current - b.current,
        temperature: a.temperature - b.temperature,
        amount: a.amount - b.amount,
        luminosity: a.luminosity - b.luminosity,
    }
}

// Power of dimension: exponents multiply
fn dim_pow(d: Dimension, n: i32) -> Dimension {
    return Dimension {
        length: d.length * n,
        mass: d.mass * n,
        time: d.time * n,
        current: d.current * n,
        temperature: d.temperature * n,
        amount: d.amount * n,
        luminosity: d.luminosity * n,
    }
}

// Check dimensional equality
fn dim_eq(a: Dimension, b: Dimension) -> bool {
    if a.length != b.length { return false }
    if a.mass != b.mass { return false }
    if a.time != b.time { return false }
    if a.current != b.current { return false }
    if a.temperature != b.temperature { return false }
    if a.amount != b.amount { return false }
    if a.luminosity != b.luminosity { return false }
    return true
}

// ============================================================================
// DIMENSION PROOFS
// ============================================================================

// Encode a dimension as a proposition ID (compact hash)
fn dim_encode(d: Dimension) -> i64 {
    // Encode 7 small integers into a single i64
    // Each exponent occupies 8 bits, range -128 to 127
    let l = (d.length + 128) as i64
    let m = (d.mass + 128) as i64
    let t = (d.time + 128) as i64
    let c = (d.current + 128) as i64
    let k = (d.temperature + 128) as i64
    let n = (d.amount + 128) as i64
    let j = (d.luminosity + 128) as i64
    return l + m * 256 + t * 65536 + c * 16777216 + k * 4294967296 + n * 1099511627776 + j * 281474976710656
}

// Prove two dimensions are equal
fn dim_eq_proof(ctx: &! ProofContext, a: Dimension, b: Dimension) -> i64 {
    let enc_a = dim_encode(a)
    let enc_b = dim_encode(b)
    if dim_eq(a, b) {
        return refl(ctx, enc_a)
    }
    let prop = ctx_prop(ctx, prop_custom(70000 + enc_a as i32))
    return trusted(ctx, 7001, prop, 0.0)  // zero confidence: not proven
}

// Prove dimensional consistency (a matches expected)
fn dim_check(ctx: &! ProofContext, actual: Dimension, expected: Dimension) -> i64 {
    return dim_eq_proof(ctx, actual, expected)
}

// ============================================================================
// PROVED UNIT TYPE
// ============================================================================

struct ProvedUnit {
    name_hash: i64,
    dim: Dimension,
    si_factor: f64,        // value in SI base units
    dim_prf_id: i64,       // proof of dimensional correctness
}

fn unit_new(ctx: &! ProofContext, name: i64, dim: Dimension, si: f64) -> ProvedUnit {
    let prf = dim_check(ctx, dim, dim)  // trivially self-consistent
    return ProvedUnit { name_hash: name, dim: dim, si_factor: si, dim_prf_id: prf }
}

// ============================================================================
// UNIT EQUIVALENCE PROOFS
// ============================================================================

// Newton: N = kg * m / s^2
fn newton_is_kgms2(ctx: &! ProofContext) -> i64 {
    // N: force unit, dim = [1, 1, -2, 0, 0, 0, 0]
    let newton = Dimension { length: 1, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let kgms2 = dim_div(dim_mul(dim_mass(), dim_length()), dim_pow(dim_time_unit(), 2))
    let prop = ctx_prop(ctx, prop_custom(71001))
    if dim_eq(newton, kgms2) {
        return trusted(ctx, 7010, prop, 1.0)
    }
    return trusted(ctx, 7010, prop, 0.0)
}

// Joule: J = kg * m^2 / s^2
fn joule_is_kgm2s2(ctx: &! ProofContext) -> i64 {
    let joule = Dimension { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let kgm2s2 = dim_div(dim_mul(dim_mass(), dim_pow(dim_length(), 2)), dim_pow(dim_time_unit(), 2))
    let prop = ctx_prop(ctx, prop_custom(71002))
    if dim_eq(joule, kgm2s2) {
        return trusted(ctx, 7011, prop, 1.0)
    }
    return trusted(ctx, 7011, prop, 0.0)
}

// Watt: W = J / s = kg * m^2 / s^3
fn watt_is_js(ctx: &! ProofContext) -> i64 {
    let watt = Dimension { length: 2, mass: 1, time: 0 - 3, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let joule = Dimension { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let js = dim_div(joule, dim_time_unit())
    let prop = ctx_prop(ctx, prop_custom(71003))
    if dim_eq(watt, js) {
        return trusted(ctx, 7012, prop, 1.0)
    }
    return trusted(ctx, 7012, prop, 0.0)
}

// Pascal: Pa = N / m^2
fn pascal_is_nm2(ctx: &! ProofContext) -> i64 {
    let pascal = Dimension { length: 0 - 1, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let newton = Dimension { length: 1, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let nm2 = dim_div(newton, dim_pow(dim_length(), 2))
    let prop = ctx_prop(ctx, prop_custom(71004))
    if dim_eq(pascal, nm2) {
        return trusted(ctx, 7013, prop, 1.0)
    }
    return trusted(ctx, 7013, prop, 0.0)
}

// Volt: V = W / A
fn volt_is_wattsperamp(ctx: &! ProofContext) -> i64 {
    let volt = Dimension { length: 2, mass: 1, time: 0 - 3, current: 0 - 1, temperature: 0, amount: 0, luminosity: 0 }
    let watt = Dimension { length: 2, mass: 1, time: 0 - 3, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let wa = dim_div(watt, dim_current())
    let prop = ctx_prop(ctx, prop_custom(71005))
    if dim_eq(volt, wa) {
        return trusted(ctx, 7014, prop, 1.0)
    }
    return trusted(ctx, 7014, prop, 0.0)
}

// Coulomb: C = A * s
fn coulomb_is_ampsec(ctx: &! ProofContext) -> i64 {
    let coulomb = Dimension { length: 0, mass: 0, time: 1, current: 1, temperature: 0, amount: 0, luminosity: 0 }
    let as_dim = dim_mul(dim_current(), dim_time_unit())
    let prop = ctx_prop(ctx, prop_custom(71006))
    if dim_eq(coulomb, as_dim) {
        return trusted(ctx, 7015, prop, 1.0)
    }
    return trusted(ctx, 7015, prop, 0.0)
}

// ============================================================================
// PHYSICAL CONSTANTS (CODATA 2018)
// ============================================================================

struct PhysicalConstant {
    name_hash: i64,
    value: f64,
    uncertainty: f64,    // standard uncertainty
    dim: Dimension,
    consistency_id: i64, // proof of dimensional consistency
}

fn speed_of_light(ctx: &! ProofContext) -> PhysicalConstant {
    // c = 299792458 m/s (exact — defined value in SI 2019)
    let dim = Dimension { length: 1, mass: 0, time: 0 - 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let prf = dim_check(ctx, dim, dim)
    return PhysicalConstant { name_hash: 100001, value: 299792458.0, uncertainty: 0.0, dim: dim, consistency_id: prf }
}

fn planck_constant(ctx: &! ProofContext) -> PhysicalConstant {
    // h = 6.62607015e-34 J*s (exact)
    let dim = Dimension { length: 2, mass: 1, time: 0 - 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let prf = dim_check(ctx, dim, dim)
    return PhysicalConstant { name_hash: 100002, value: 6.62607015e-34, uncertainty: 0.0, dim: dim, consistency_id: prf }
}

fn boltzmann_constant(ctx: &! ProofContext) -> PhysicalConstant {
    // k_B = 1.380649e-23 J/K (exact)
    let dim = Dimension { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0 - 1, amount: 0, luminosity: 0 }
    let prf = dim_check(ctx, dim, dim)
    return PhysicalConstant { name_hash: 100003, value: 1.380649e-23, uncertainty: 0.0, dim: dim, consistency_id: prf }
}

fn avogadro_constant(ctx: &! ProofContext) -> PhysicalConstant {
    // N_A = 6.02214076e23 mol^-1 (exact)
    let dim = Dimension { length: 0, mass: 0, time: 0, current: 0, temperature: 0, amount: 0 - 1, luminosity: 0 }
    let prf = dim_check(ctx, dim, dim)
    return PhysicalConstant { name_hash: 100004, value: 6.02214076e23, uncertainty: 0.0, dim: dim, consistency_id: prf }
}

fn gravitational_constant(ctx: &! ProofContext) -> PhysicalConstant {
    // G = 6.67430e-11 m^3/(kg*s^2) — not exact, CODATA 2018 value
    let dim = Dimension { length: 3, mass: 0 - 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let prf = dim_check(ctx, dim, dim)
    // Relative uncertainty 2.2e-5
    return PhysicalConstant { name_hash: 100005, value: 6.67430e-11, uncertainty: 1.5e-15, dim: dim, consistency_id: prf }
}

fn elementary_charge(ctx: &! ProofContext) -> PhysicalConstant {
    // e = 1.602176634e-19 C (exact)
    let dim = Dimension { length: 0, mass: 0, time: 1, current: 1, temperature: 0, amount: 0, luminosity: 0 }
    let prf = dim_check(ctx, dim, dim)
    return PhysicalConstant { name_hash: 100006, value: 1.602176634e-19, uncertainty: 0.0, dim: dim, consistency_id: prf }
}

// ============================================================================
// PHYSICAL RELATIONSHIP PROOFS
// ============================================================================

// E = mc^2: energy = mass * speed^2 => dimension check
fn energy_mass_equiv(ctx: &! ProofContext) -> i64 {
    // E: [2,1,-2,0,0,0,0]  m: [0,1,0,0,0,0,0]  c^2: [2,0,-2,0,0,0,0]
    let e_dim = Dimension { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let m_dim = dim_mass()
    let c_dim = Dimension { length: 1, mass: 0, time: 0 - 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let mc2_dim = dim_mul(m_dim, dim_pow(c_dim, 2))
    let prop = ctx_prop(ctx, prop_custom(72001))
    if dim_eq(e_dim, mc2_dim) {
        return trusted(ctx, 7020, prop, 1.0)
    }
    return trusted(ctx, 7020, prop, 0.0)
}

// PV = nRT: ideal gas law dimensional consistency
fn ideal_gas_law_consistent(ctx: &! ProofContext) -> i64 {
    // P: [−1,1,−2,0,0,0,0]  V: [3,0,0,0,0,0,0]
    // n: mol = [0,0,0,0,0,1,0]  R: J/(mol*K) = [2,1,-2,0,-1,-1,0]  T: K = [0,0,0,0,1,0,0]
    let pv_dim = Dimension { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let r_dim = Dimension { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0 - 1, amount: 0 - 1, luminosity: 0 }
    let nrt_dim = dim_mul(dim_mul(dim_amount(), r_dim), dim_temperature())
    let prop = ctx_prop(ctx, prop_custom(72002))
    if dim_eq(pv_dim, nrt_dim) {
        return trusted(ctx, 7021, prop, 1.0)
    }
    return trusted(ctx, 7021, prop, 0.0)
}

// E = hf: Planck-Einstein dimensional check
fn planck_einstein_relation(ctx: &! ProofContext) -> i64 {
    // E: [2,1,-2,0,0,0,0]  h: [2,1,-1,0,0,0,0]  f: [0,0,-1,0,0,0,0]
    let e_dim = Dimension { length: 2, mass: 1, time: 0 - 2, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let h_dim = Dimension { length: 2, mass: 1, time: 0 - 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let f_dim = Dimension { length: 0, mass: 0, time: 0 - 1, current: 0, temperature: 0, amount: 0, luminosity: 0 }
    let hf_dim = dim_mul(h_dim, f_dim)
    let prop = ctx_prop(ctx, prop_custom(72003))
    if dim_eq(e_dim, hf_dim) {
        return trusted(ctx, 7022, prop, 1.0)
    }
    return trusted(ctx, 7022, prop, 0.0)
}

// ============================================================================
// CONVERSION PROOFS
// ============================================================================

// Prove conversion between two units is valid (dimensions match)
fn conversion_proof(ctx: &! ProofContext, from: ProvedUnit, to: ProvedUnit) -> i64 {
    let prop = ctx_prop(ctx, prop_custom(73001))
    if dim_eq(from.dim, to.dim) {
        return trusted(ctx, 7030, prop, 1.0)
    }
    return trusted(ctx, 7030, prop, 0.0)
}

// Compute SI conversion factor
fn conversion_factor(from: ProvedUnit, to: ProvedUnit) -> f64 {
    if to.si_factor == 0.0 { return 1.0 }
    return from.si_factor / to.si_factor
}

fn convert_value(value: f64, from: ProvedUnit, to: ProvedUnit) -> f64 {
    return value * conversion_factor(from, to)
}

// Convert with uncertainty propagation + proof
// Proves that conversion preserves epistemic uncertainty bounds
fn convert_epistemic(ctx: &! ProofContext, value: f64, uncertainty: f64, confidence: f64,
                     from: ProvedUnit, to: ProvedUnit) -> i64 {
    let prop = ctx_prop(ctx, prop_custom(73002))
    if dim_eq(from.dim, to.dim) {
        // Conversion factor scales both value and uncertainty by same factor
        // => relative uncertainty preserved => confidence preserved
        return trusted(ctx, 7031, prop, confidence)
    }
    return trusted(ctx, 7031, prop, 0.0)
}

// ============================================================================
// UNIT ALGEBRA PROOFS
// ============================================================================

// a * b = b * a dimensionally
fn unit_mul_comm(ctx: &! ProofContext, a: ProvedUnit, b: ProvedUnit) -> i64 {
    let ab = dim_mul(a.dim, b.dim)
    let ba = dim_mul(b.dim, a.dim)
    let prop = ctx_prop(ctx, prop_custom(74001))
    if dim_eq(ab, ba) {
        return trusted(ctx, 7040, prop, 1.0)
    }
    return trusted(ctx, 7040, prop, 0.0)
}

// a / a = dimensionless
fn unit_div_self(ctx: &! ProofContext, a: ProvedUnit) -> i64 {
    let result = dim_div(a.dim, a.dim)
    let dl = dim_dimensionless()
    let prop = ctx_prop(ctx, prop_custom(74002))
    if dim_eq(result, dl) {
        return trusted(ctx, 7041, prop, 1.0)
    }
    return trusted(ctx, 7041, prop, 0.0)
}

// a^m * a^n = a^(m+n)
fn unit_pow_add(ctx: &! ProofContext, a: ProvedUnit, m: i32, n: i32) -> i64 {
    let am = dim_pow(a.dim, m)
    let an = dim_pow(a.dim, n)
    let amn = dim_mul(am, an)
    let amn2 = dim_pow(a.dim, m + n)
    let prop = ctx_prop(ctx, prop_custom(74003))
    if dim_eq(amn, amn2) {
        return trusted(ctx, 7042, prop, 1.0)
    }
    return trusted(ctx, 7042, prop, 0.0)
}
