//! Split from theorem/portfolio.sio — proof-certificate portfolio helpers.
//! Do not re-merge into a single file over the lexer source-byte ceiling (2097152).
//! Parent façade: theorem/portfolio.sio (pub use only).

use theorem::portfolio_kinds::*
use theorem::portfolio_checkers::*
use theorem::portfolio_known_manifests::*


pub fn portfolio_result_unsat() -> i64 { return 0 }
pub fn portfolio_result_validated() -> i64 { return 1 }
pub fn portfolio_result_optimal() -> i64 { return 2 }
pub fn portfolio_result_sat() -> i64 { return 3 }

pub fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

pub fn portfolio_entry_valid(kind: i64, instance_fp: i64, certificate_fp: i64,
                             result_code: i64, checker_code: i64) -> i64 {
    if instance_fp <= 0 { return 0 }
    if certificate_fp <= 0 { return 0 }

    if kind == portfolio_kind_lrat() {
