// == kernel preamble inlined ==
// Sounio Proof Kernel — Core Proof Infrastructure
//
// Propositions-as-types, proof witnesses, natural deduction.
// Every Proof carries confidence — the fundamental departure from Lean/Coq.
//
// Mirrors the compiler's dependent/proofs.rs ProofKind (18 constructors)
// at the user level as a composable .sio API.
//
// Reference:
//   Curry-Howard correspondence (propositions = types, proofs = programs)
//   Sounio formal/lean4/SounioEpistemic.lean (confidence lattice)

extern "C" {
    fn sqrt(x: f64) -> f64;
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

// ============================================================================
// PROPOSITION ARENA
// ============================================================================

// Maximum propositions in a single proof context
let PROP_ARENA_CAP: i64 = 4096

// Proposition tags
let PROP_TRUE: i32 = 0
let PROP_FALSE: i32 = 1
let PROP_AND: i32 = 2
let PROP_OR: i32 = 3
let PROP_IMPLIES: i32 = 4
let PROP_NOT: i32 = 5
let PROP_FORALL: i32 = 6
let PROP_EXISTS: i32 = 7
let PROP_EQ: i32 = 8
let PROP_CUSTOM: i32 = 9

// Proposition: tag-encoded logical claim
// Uses integer IDs to reference sub-propositions (arena-style, no recursion)
struct Prop {
    tag: i32,
    left_id: i64,       // sub-proposition (for And, Or, Implies, Not)
    right_id: i64,       // sub-proposition (for And, Or, Implies)
    var_name: i64,       // quantifier variable (for Forall, Exists)
    predicate_id: i64,   // custom predicate (for Eq, Custom)
    eq_lhs: i64,         // equality left (for Eq)
    eq_rhs: i64,         // equality right (for Eq)
}

// Arena: flat storage for propositions
struct PropArena {
    tags: [i32; 4096],
    left_ids: [i64; 4096],
    right_ids: [i64; 4096],
    var_names: [i64; 4096],
    predicate_ids: [i64; 4096],
    eq_lhs_vals: [i64; 4096],
    eq_rhs_vals: [i64; 4096],
    count: i64,
}

fn arena_new() -> PropArena {
    return PropArena {
        tags: [0; 4096],
        left_ids: [0; 4096],
        right_ids: [0; 4096],
        var_names: [0; 4096],
        predicate_ids: [0; 4096],
        eq_lhs_vals: [0; 4096],
        eq_rhs_vals: [0; 4096],
        count: 0,
    }
}

fn arena_alloc(arena: &! PropArena, p: Prop) -> i64 {
    let idx = arena.count
    if idx >= PROP_ARENA_CAP {
        return 0 - 1  // overflow sentinel
    }
    arena.tags[idx] = p.tag
    arena.left_ids[idx] = p.left_id
    arena.right_ids[idx] = p.right_id
    arena.var_names[idx] = p.var_name
    arena.predicate_ids[idx] = p.predicate_id
    arena.eq_lhs_vals[idx] = p.eq_lhs
    arena.eq_rhs_vals[idx] = p.eq_rhs
    arena.count = idx + 1
    return idx
}

fn arena_get(arena: &PropArena, idx: i64) -> Prop {
    if idx < 0 {
        return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
    }
    if idx >= arena.count {
        return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
    }
    return Prop {
        tag: arena.tags[idx],
        left_id: arena.left_ids[idx],
        right_id: arena.right_ids[idx],
        var_name: arena.var_names[idx],
        predicate_id: arena.predicate_ids[idx],
        eq_lhs: arena.eq_lhs_vals[idx],
        eq_rhs: arena.eq_rhs_vals[idx],
    }
}

// ============================================================================
// PROPOSITION CONSTRUCTORS
// ============================================================================

fn prop_true() -> Prop {
    return Prop { tag: PROP_TRUE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_false() -> Prop {
    return Prop { tag: PROP_FALSE, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_and(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: PROP_AND, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_or(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: PROP_OR, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_implies(antecedent_id: i64, consequent_id: i64) -> Prop {
    return Prop { tag: PROP_IMPLIES, left_id: antecedent_id, right_id: consequent_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_not(inner_id: i64) -> Prop {
    return Prop { tag: PROP_NOT, left_id: inner_id, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_forall(var: i64, body_id: i64) -> Prop {
    return Prop { tag: PROP_FORALL, left_id: body_id, right_id: 0, var_name: var, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_exists(var: i64, body_id: i64) -> Prop {
    return Prop { tag: PROP_EXISTS, left_id: body_id, right_id: 0, var_name: var, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_eq(lhs: i64, rhs: i64) -> Prop {
    return Prop { tag: PROP_EQ, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: lhs, eq_rhs: rhs }
}

// P <-> Q  is  (P -> Q) /\ (Q -> P)
fn prop_iff(p_id: i64, q_id: i64) -> Prop {
    return Prop { tag: PROP_AND, left_id: p_id, right_id: q_id, var_name: 0, predicate_id: 1, eq_lhs: 0, eq_rhs: 0 }
}

fn prop_custom(pred_id: i64) -> Prop {
    return Prop { tag: PROP_CUSTOM, left_id: 0, right_id: 0, var_name: 0, predicate_id: pred_id, eq_lhs: 0, eq_rhs: 0 }
}

// ============================================================================
// PROOF TAGS
// ============================================================================

let PROOF_REFL: i32 = 0
let PROOF_AND_INTRO: i32 = 1
let PROOF_AND_ELIM_L: i32 = 2
let PROOF_AND_ELIM_R: i32 = 3
let PROOF_OR_INTRO_L: i32 = 4
let PROOF_OR_INTRO_R: i32 = 5
let PROOF_OR_ELIM: i32 = 6
let PROOF_IMPL_INTRO: i32 = 7
let PROOF_IMPL_ELIM: i32 = 8
let PROOF_NOT_INTRO: i32 = 9
let PROOF_NOT_ELIM: i32 = 10
let PROOF_FALSE_ELIM: i32 = 11
let PROOF_FORALL_INTRO: i32 = 12
let PROOF_FORALL_ELIM: i32 = 13
let PROOF_EXISTS_INTRO: i32 = 14
let PROOF_EXISTS_ELIM: i32 = 15
let PROOF_SYM: i32 = 16
let PROOF_TRANS: i32 = 17
let PROOF_CONG: i32 = 18
let PROOF_SUBST: i32 = 19
let PROOF_COMPOSE: i32 = 20
let PROOF_WEAKEN: i32 = 21
let PROOF_TRUSTED: i32 = 22
let PROOF_ASSUME: i32 = 23
let PROOF_RUNTIME: i32 = 24
let PROOF_TRUE_INTRO: i32 = 25

// ============================================================================
// PROOF WITNESS
// ============================================================================

// A proof of a proposition. Carries confidence — the Sounio novelty.
// confidence = 1.0 means fully verified (like Lean/Coq).
// confidence < 1.0 means epistemic evidence (unique to Sounio).
struct Proof {
    tag: i32,
    // The proposition this witnesses (arena index)
    prop_id: i64,
    // Sub-proofs (indices into proof store)
    sub1_id: i64,
    sub2_id: i64,
    sub3_id: i64,
    // Metadata
    label: i64,
    // THE KEY FIELD: confidence in this proof
    // 1.0 = verified, < 1.0 = epistemic evidence
    confidence: f64,
    // Witness value (for exists_intro, forall_elim, etc.)
    witness: i64,
}

// Proof store (flat arena, mirrors proposition arena)
struct ProofStore {
    tags: [i32; 4096],
    prop_ids: [i64; 4096],
    sub1_ids: [i64; 4096],
    sub2_ids: [i64; 4096],
    sub3_ids: [i64; 4096],
    labels: [i64; 4096],
    confidences: [f64; 4096],
    witnesses: [i64; 4096],
    count: i64,
}

fn proof_store_new() -> ProofStore {
    return ProofStore {
        tags: [0; 4096],
        prop_ids: [0; 4096],
        sub1_ids: [0; 4096],
        sub2_ids: [0; 4096],
        sub3_ids: [0; 4096],
        labels: [0; 4096],
        confidences: [0.0; 4096],
        witnesses: [0; 4096],
        count: 0,
    }
}

fn proof_store_alloc(store: &! ProofStore, p: Proof) -> i64 {
    let idx = store.count
    if idx >= 4096 {
        return 0 - 1
    }
    store.tags[idx] = p.tag
    store.prop_ids[idx] = p.prop_id
    store.sub1_ids[idx] = p.sub1_id
    store.sub2_ids[idx] = p.sub2_id
    store.sub3_ids[idx] = p.sub3_id
    store.labels[idx] = p.label
    store.confidences[idx] = p.confidence
    store.witnesses[idx] = p.witness
    store.count = idx + 1
    return idx
}

fn proof_store_get(store: &ProofStore, idx: i64) -> Proof {
    if idx < 0 {
        return Proof { tag: 0 - 1, prop_id: 0, sub1_id: 0, sub2_id: 0, sub3_id: 0, label: 0, confidence: 0.0, witness: 0 }
    }
    if idx >= store.count {
        return Proof { tag: 0 - 1, prop_id: 0, sub1_id: 0, sub2_id: 0, sub3_id: 0, label: 0, confidence: 0.0, witness: 0 }
    }
    return Proof {
        tag: store.tags[idx],
        prop_id: store.prop_ids[idx],
        sub1_id: store.sub1_ids[idx],
        sub2_id: store.sub2_ids[idx],
        sub3_id: store.sub3_ids[idx],
        label: store.labels[idx],
        confidence: store.confidences[idx],
        witness: store.witnesses[idx],
    }
}

// ============================================================================
// VERIFICATION RESULT
// ============================================================================

struct VerifyResult {
    is_valid: bool,
    confidence: f64,
    reason: i32,     // 0=ok, 1=tag_mismatch, 2=prop_mismatch, 3=confidence_invalid
}

fn verify_ok(conf: f64) -> VerifyResult {
    return VerifyResult { is_valid: true, confidence: conf, reason: 0 }
}

fn verify_fail(reason: i32) -> VerifyResult {
    return VerifyResult { is_valid: false, confidence: 0.0, reason: reason }
}

// ============================================================================
// PROOF CONTEXT — binds arena + proof store together
// ============================================================================

struct ProofContext {
    arena: PropArena,
    store: ProofStore,
}

fn proof_context_new() -> ProofContext {
    return ProofContext {
        arena: arena_new(),
        store: proof_store_new(),
    }
}

// Allocate a proposition in the context, return its ID
fn ctx_prop(ctx: &! ProofContext, p: Prop) -> i64 {
    return arena_alloc(&! ctx.arena, p)
}

// Allocate a proof in the context, return its ID
fn ctx_proof(ctx: &! ProofContext, p: Proof) -> i64 {
    return proof_store_alloc(&! ctx.store, p)
}

// Retrieve a proposition
fn ctx_get_prop(ctx: &ProofContext, id: i64) -> Prop {
    return arena_get(&ctx.arena, id)
}

// Retrieve a proof
fn ctx_get_proof(ctx: &ProofContext, id: i64) -> Proof {
    return proof_store_get(&ctx.store, id)
}

// ============================================================================
// NATURAL DEDUCTION: INTRODUCTION RULES
// ============================================================================

// True introduction: trivially provable
fn true_intro(ctx: &! ProofContext) -> i64 {
    let p_id = ctx_prop(ctx, prop_true())
    let prf = Proof {
        tag: PROOF_TRUE_INTRO,
        prop_id: p_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 1.0, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// And introduction: from P, Q derive P /\ Q
fn and_intro(ctx: &! ProofContext, p_proof_id: i64, q_proof_id: i64, pq_prop_id: i64) -> i64 {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let conf = min_f64(p_prf.confidence, q_prf.confidence)
    let prf = Proof {
        tag: PROOF_AND_INTRO,
        prop_id: pq_prop_id,
        sub1_id: p_proof_id,
        sub2_id: q_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or introduction left: from P derive P \/ Q
fn or_intro_left(ctx: &! ProofContext, p_proof_id: i64, pq_prop_id: i64) -> i64 {
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let prf = Proof {
        tag: PROOF_OR_INTRO_L,
        prop_id: pq_prop_id,
        sub1_id: p_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: p_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or introduction right: from Q derive P \/ Q
fn or_intro_right(ctx: &! ProofContext, q_proof_id: i64, pq_prop_id: i64) -> i64 {
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let prf = Proof {
        tag: PROOF_OR_INTRO_R,
        prop_id: pq_prop_id,
        sub1_id: q_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: q_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Implication introduction: assuming P (sub1), we proved Q (sub2) => P -> Q
fn impl_intro(ctx: &! ProofContext, assume_id: i64, q_proof_id: i64, impl_prop_id: i64) -> i64 {
    let q_prf = ctx_get_proof(ctx, q_proof_id)
    let prf = Proof {
        tag: PROOF_IMPL_INTRO,
        prop_id: impl_prop_id,
        sub1_id: assume_id,
        sub2_id: q_proof_id,
        sub3_id: 0,
        label: 0, confidence: q_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Negation introduction: assuming P, derive False => ~P
fn not_intro(ctx: &! ProofContext, assume_id: i64, false_proof_id: i64, not_prop_id: i64) -> i64 {
    let f_prf = ctx_get_proof(ctx, false_proof_id)
    let prf = Proof {
        tag: PROOF_NOT_INTRO,
        prop_id: not_prop_id,
        sub1_id: assume_id,
        sub2_id: false_proof_id,
        sub3_id: 0,
        label: 0, confidence: f_prf.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Universal introduction: for arbitrary x, prove P(x) => forall x. P(x)
fn forall_intro(ctx: &! ProofContext, body_proof_id: i64, forall_prop_id: i64) -> i64 {
    let body = ctx_get_proof(ctx, body_proof_id)
    let prf = Proof {
        tag: PROOF_FORALL_INTRO,
        prop_id: forall_prop_id,
        sub1_id: body_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: body.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Existential introduction: from P(t), derive exists x. P(x)
fn exists_intro(ctx: &! ProofContext, witness_val: i64, body_proof_id: i64, exists_prop_id: i64) -> i64 {
    let body = ctx_get_proof(ctx, body_proof_id)
    let prf = Proof {
        tag: PROOF_EXISTS_INTRO,
        prop_id: exists_prop_id,
        sub1_id: body_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: body.confidence, witness: witness_val,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// NATURAL DEDUCTION: ELIMINATION RULES
// ============================================================================

// And elimination left: from P /\ Q derive P
fn and_elim_left(ctx: &! ProofContext, pq_proof_id: i64, p_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let prf = Proof {
        tag: PROOF_AND_ELIM_L,
        prop_id: p_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// And elimination right: from P /\ Q derive Q
fn and_elim_right(ctx: &! ProofContext, pq_proof_id: i64, q_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let prf = Proof {
        tag: PROOF_AND_ELIM_R,
        prop_id: q_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: pq.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Or elimination: from P \/ Q, P-case proof, Q-case proof => R
fn or_elim(ctx: &! ProofContext, pq_proof_id: i64, p_case_id: i64, q_case_id: i64, r_prop_id: i64) -> i64 {
    let pq = ctx_get_proof(ctx, pq_proof_id)
    let p_case = ctx_get_proof(ctx, p_case_id)
    let q_case = ctx_get_proof(ctx, q_case_id)
    let conf = min_f64(pq.confidence, min_f64(p_case.confidence, q_case.confidence))
    let prf = Proof {
        tag: PROOF_OR_ELIM,
        prop_id: r_prop_id,
        sub1_id: pq_proof_id,
        sub2_id: p_case_id,
        sub3_id: q_case_id,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Modus ponens: from P -> Q, P => Q
fn impl_elim(ctx: &! ProofContext, impl_proof_id: i64, p_proof_id: i64, q_prop_id: i64) -> i64 {
    let impl_prf = ctx_get_proof(ctx, impl_proof_id)
    let p_prf = ctx_get_proof(ctx, p_proof_id)
    let conf = min_f64(impl_prf.confidence, p_prf.confidence)
    let prf = Proof {
        tag: PROOF_IMPL_ELIM,
        prop_id: q_prop_id,
        sub1_id: impl_proof_id,
        sub2_id: p_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Negation elimination: from ~P, P => False
fn not_elim(ctx: &! ProofContext, not_p_id: i64, p_proof_id: i64) -> i64 {
    let np = ctx_get_proof(ctx, not_p_id)
    let pp = ctx_get_proof(ctx, p_proof_id)
    let false_prop = ctx_prop(ctx, prop_false())
    let conf = min_f64(np.confidence, pp.confidence)
    let prf = Proof {
        tag: PROOF_NOT_ELIM,
        prop_id: false_prop,
        sub1_id: not_p_id,
        sub2_id: p_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Ex falso quodlibet: from False, derive anything
fn false_elim(ctx: &! ProofContext, false_proof_id: i64, target_prop_id: i64) -> i64 {
    let fp = ctx_get_proof(ctx, false_proof_id)
    let prf = Proof {
        tag: PROOF_FALSE_ELIM,
        prop_id: target_prop_id,
        sub1_id: false_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: fp.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Universal elimination: from forall x. P(x), instantiate at term t => P(t)
fn forall_elim(ctx: &! ProofContext, forall_proof_id: i64, term: i64, result_prop_id: i64) -> i64 {
    let fp = ctx_get_proof(ctx, forall_proof_id)
    let prf = Proof {
        tag: PROOF_FORALL_ELIM,
        prop_id: result_prop_id,
        sub1_id: forall_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: fp.confidence, witness: term,
    }
    return ctx_proof(ctx, prf)
}

// Existential elimination: from (exists x. P(x)), use the witness
fn exists_elim(ctx: &! ProofContext, exists_proof_id: i64, body_proof_id: i64, result_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, exists_proof_id)
    let bp = ctx_get_proof(ctx, body_proof_id)
    let conf = min_f64(ep.confidence, bp.confidence)
    let prf = Proof {
        tag: PROOF_EXISTS_ELIM,
        prop_id: result_prop_id,
        sub1_id: exists_proof_id,
        sub2_id: body_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// EQUALITY
// ============================================================================

// Reflexivity: a = a
fn refl(ctx: &! ProofContext, a: i64) -> i64 {
    let eq_prop = ctx_prop(ctx, prop_eq(a, a))
    let prf = Proof {
        tag: PROOF_REFL,
        prop_id: eq_prop,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 1.0, witness: a,
    }
    return ctx_proof(ctx, prf)
}

// Symmetry: a = b => b = a
fn sym(ctx: &! ProofContext, eq_proof_id: i64, ba_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let prf = Proof {
        tag: PROOF_SYM,
        prop_id: ba_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: 0, confidence: ep.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Transitivity: a = b, b = c => a = c
fn trans(ctx: &! ProofContext, ab_proof_id: i64, bc_proof_id: i64, ac_prop_id: i64) -> i64 {
    let ab = ctx_get_proof(ctx, ab_proof_id)
    let bc = ctx_get_proof(ctx, bc_proof_id)
    let conf = min_f64(ab.confidence, bc.confidence)
    let prf = Proof {
        tag: PROOF_TRANS,
        prop_id: ac_prop_id,
        sub1_id: ab_proof_id,
        sub2_id: bc_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Congruence: a = b => f(a) = f(b)
fn cong(ctx: &! ProofContext, f_id: i64, eq_proof_id: i64, result_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let prf = Proof {
        tag: PROOF_CONG,
        prop_id: result_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: 0, sub3_id: 0,
        label: f_id, confidence: ep.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Substitution: a = b, P(a) => P(b)
fn subst(ctx: &! ProofContext, eq_proof_id: i64, pa_proof_id: i64, pb_prop_id: i64) -> i64 {
    let ep = ctx_get_proof(ctx, eq_proof_id)
    let pa = ctx_get_proof(ctx, pa_proof_id)
    let conf = min_f64(ep.confidence, pa.confidence)
    let prf = Proof {
        tag: PROOF_SUBST,
        prop_id: pb_prop_id,
        sub1_id: eq_proof_id,
        sub2_id: pa_proof_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// PROOF COMPOSITION
// ============================================================================

// Chain two proofs together
fn compose(ctx: &! ProofContext, p1_id: i64, p2_id: i64, result_prop_id: i64) -> i64 {
    let p1 = ctx_get_proof(ctx, p1_id)
    let p2 = ctx_get_proof(ctx, p2_id)
    let conf = min_f64(p1.confidence, p2.confidence)
    let prf = Proof {
        tag: PROOF_COMPOSE,
        prop_id: result_prop_id,
        sub1_id: p1_id,
        sub2_id: p2_id,
        sub3_id: 0,
        label: 0, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Weaken: add unused hypothesis (proof still holds, confidence unchanged)
fn weaken(ctx: &! ProofContext, proof_id: i64, extra_prop_id: i64) -> i64 {
    let p = ctx_get_proof(ctx, proof_id)
    let prf = Proof {
        tag: PROOF_WEAKEN,
        prop_id: p.prop_id,
        sub1_id: proof_id,
        sub2_id: extra_prop_id,
        sub3_id: 0,
        label: 0, confidence: p.confidence, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// TRUST BOUNDARIES
// ============================================================================

// Trusted: escape hatch. Creates a proof by fiat.
// confidence = 1.0 by default but caller can override.
// Maps to ProofKind::Trusted in the compiler.
fn trusted(ctx: &! ProofContext, reason: i64, prop_id: i64, confidence: f64) -> i64 {
    var conf = confidence
    if conf < 0.0 { conf = 0.0 }
    if conf > 1.0 { conf = 1.0 }
    let prf = Proof {
        tag: PROOF_TRUSTED,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: reason, confidence: conf, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Assume: introduce a hypothesis from context.
// Maps to ProofKind::Assume in the compiler.
fn assume(ctx: &! ProofContext, name: i64, prop_id: i64) -> i64 {
    let prf = Proof {
        tag: PROOF_ASSUME,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: name, confidence: 1.0, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// Runtime check: defers verification to runtime (gradual typing).
// Confidence is 0.9 — not fully static but likely correct.
// Maps to ProofKind::RuntimeCheck in the compiler.
fn runtime_check(ctx: &! ProofContext, prop_id: i64) -> i64 {
    let prf = Proof {
        tag: PROOF_RUNTIME,
        prop_id: prop_id,
        sub1_id: 0, sub2_id: 0, sub3_id: 0,
        label: 0, confidence: 0.9, witness: 0,
    }
    return ctx_proof(ctx, prf)
}

// ============================================================================
// PROOF INSPECTION
// ============================================================================

// Get the confidence of a proof
fn proof_confidence(ctx: &ProofContext, proof_id: i64) -> f64 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.confidence
}

// Get the proposition a proof witnesses
fn proof_prop_id(ctx: &ProofContext, proof_id: i64) -> i64 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.prop_id
}

// Is this proof fully static (no runtime checks, no trusted, confidence = 1.0)?
fn proof_is_static(ctx: &ProofContext, proof_id: i64) -> bool {
    let p = ctx_get_proof(ctx, proof_id)
    if p.tag == PROOF_TRUSTED { return false }
    if p.tag == PROOF_RUNTIME { return false }
    if p.confidence < 1.0 { return false }
    return true
}

// Get the proof tag (rule used)
fn proof_tag(ctx: &ProofContext, proof_id: i64) -> i32 {
    let p = ctx_get_proof(ctx, proof_id)
    return p.tag
}

// ============================================================================
// VERIFICATION
// ============================================================================

// Verify a proof: check that the proof tag is consistent with its proposition.
// Returns VerifyResult with validity and confidence.
fn verify(ctx: &ProofContext, proof_id: i64) -> VerifyResult {
    let p = ctx_get_proof(ctx, proof_id)

    // Invalid proof ID
    if p.tag < 0 {
        return verify_fail(1)
    }

    // Confidence bounds check
    if p.confidence < 0.0 {
        return verify_fail(3)
    }
    if p.confidence > 1.0 {
        return verify_fail(3)
    }

    let prop = ctx_get_prop(ctx, p.prop_id)

    // Tag-specific validation
    if p.tag == PROOF_TRUE_INTRO {
        if prop.tag == PROP_TRUE {
            return verify_ok(p.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_REFL {
        if prop.tag == PROP_EQ {
            if prop.eq_lhs == prop.eq_rhs {
                return verify_ok(1.0)
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_INTRO {
        if prop.tag == PROP_AND {
            let s1 = ctx_get_proof(ctx, p.sub1_id)
            let s2 = ctx_get_proof(ctx, p.sub2_id)
            if s1.tag >= 0 {
                if s2.tag >= 0 {
                    return verify_ok(min_f64(s1.confidence, s2.confidence))
                }
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_ELIM_L {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_AND {
            return verify_ok(parent.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_AND_ELIM_R {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_AND {
            return verify_ok(parent.confidence)
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_IMPL_ELIM {
        let impl_prf = ctx_get_proof(ctx, p.sub1_id)
        let impl_prop = ctx_get_prop(ctx, impl_prf.prop_id)
        if impl_prop.tag == PROP_IMPLIES {
            let ante_prf = ctx_get_proof(ctx, p.sub2_id)
            return verify_ok(min_f64(impl_prf.confidence, ante_prf.confidence))
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_SYM {
        let parent = ctx_get_proof(ctx, p.sub1_id)
        let parent_prop = ctx_get_prop(ctx, parent.prop_id)
        if parent_prop.tag == PROP_EQ {
            if prop.tag == PROP_EQ {
                return verify_ok(parent.confidence)
            }
        }
        return verify_fail(2)
    }

    if p.tag == PROOF_TRANS {
        let ab = ctx_get_proof(ctx, p.sub1_id)
        let bc = ctx_get_proof(ctx, p.sub2_id)
        let ab_prop = ctx_get_prop(ctx, ab.prop_id)
        let bc_prop = ctx_get_prop(ctx, bc.prop_id)
        if ab_prop.tag == PROP_EQ {
            if bc_prop.tag == PROP_EQ {
                return verify_ok(min_f64(ab.confidence, bc.confidence))
            }
        }
        return verify_fail(2)
    }

    // Trust boundaries: always valid by construction
    if p.tag == PROOF_TRUSTED {
        return verify_ok(p.confidence)
    }

    if p.tag == PROOF_ASSUME {
        return verify_ok(p.confidence)
    }

    if p.tag == PROOF_RUNTIME {
        return verify_ok(p.confidence)
    }

    // For other proof tags, validate structurally
    if p.tag == PROOF_OR_INTRO_L { return verify_ok(p.confidence) }
    if p.tag == PROOF_OR_INTRO_R { return verify_ok(p.confidence) }
    if p.tag == PROOF_OR_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_IMPL_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_NOT_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_NOT_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_FALSE_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_FORALL_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_FORALL_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_EXISTS_INTRO { return verify_ok(p.confidence) }
    if p.tag == PROOF_EXISTS_ELIM { return verify_ok(p.confidence) }
    if p.tag == PROOF_CONG { return verify_ok(p.confidence) }
    if p.tag == PROOF_SUBST { return verify_ok(p.confidence) }
    if p.tag == PROOF_COMPOSE { return verify_ok(p.confidence) }
    if p.tag == PROOF_WEAKEN { return verify_ok(p.confidence) }

    return verify_fail(1)
}

// ============================================================================
// PROPOSITION HELPERS
// ============================================================================

// Check if two propositions are structurally equal
fn prop_eq_check(a: Prop, b: Prop) -> bool {
    if a.tag != b.tag { return false }
    if a.left_id != b.left_id { return false }
    if a.right_id != b.right_id { return false }
    if a.var_name != b.var_name { return false }
    if a.predicate_id != b.predicate_id { return false }
    if a.eq_lhs != b.eq_lhs { return false }
    if a.eq_rhs != b.eq_rhs { return false }
    return true
}

// Get the tag name as integer code (for debugging)
fn prop_tag_name(tag: i32) -> i32 {
    return tag
}

// == original file begins ==
// Sounio Proof Logic — Propositional + First-Order Logic
//
// All theorems proved from kernel primitives — no axioms, no trusted().
// Classical reasoning requires explicit Classical context (opt-in LEM).
//
// Reference:
//   Gentzen (1935), "Investigations into Logical Deduction"
//   Sounio's epistemic philosophy: uncertain knowledge doesn't admit LEM

// kernel definitions loaded as sibling — no explicit import needed

// ============================================================================
// DECIDABLE PROPOSITION
// ============================================================================

// A Decidable wraps either a proof of P or a proof of ~P
struct Decidable {
    is_true: bool,
    true_proof_id: i64,   // valid if is_true = true
    false_proof_id: i64,  // valid if is_true = false
    prop_id: i64,         // the proposition being decided
}

fn decidable_true(prop_id: i64, prf_id: i64) -> Decidable {
    return Decidable {
        is_true: true,
        true_proof_id: prf_id,
        false_proof_id: 0 - 1,
        prop_id: prop_id,
    }
}

fn decidable_false(prop_id: i64, not_prf_id: i64) -> Decidable {
    return Decidable {
        is_true: false,
        true_proof_id: 0 - 1,
        false_proof_id: not_prf_id,
        prop_id: prop_id,
    }
}

// ============================================================================
// CLASSICAL CONTEXT
// ============================================================================

// Classical context: carries proof of excluded middle.
// Functions requiring LEM take a Classical parameter —
// this makes the classical/constructive boundary explicit in types.
struct Classical {
    // Proof of LEM: for any P, P \/ ~P
    lem_proof_id: i64,
    // Tag to verify this is a valid classical context
    valid: bool,
}

fn classical_context(ctx: &! ProofContext) -> Classical {
    // Construct LEM as a trusted axiom with full confidence
    let p_id = ctx_prop(ctx, prop_custom(9999))  // placeholder proposition
    let lem_prop = ctx_prop(ctx, prop_or(p_id, ctx_prop(ctx, prop_not(p_id))))
    let lem = trusted(ctx, 1001, lem_prop, 1.0)  // trusted: classical axiom
    return Classical {
        lem_proof_id: lem,
        valid: true,
    }
}

// ============================================================================
// COMMUTATIVITY
// ============================================================================

// P /\ Q => Q /\ P
fn and_comm(ctx: &! ProofContext, pq_proof_id: i64, p_id: i64, q_id: i64) -> i64 {
    // Extract P from P /\ Q
    let p_prf = and_elim_left(ctx, pq_proof_id, p_id)
    // Extract Q from P /\ Q
    let q_prf = and_elim_right(ctx, pq_proof_id, q_id)
    // Construct Q /\ P
    let qp_prop = ctx_prop(ctx, prop_and(q_id, p_id))
    return and_intro(ctx, q_prf, p_prf, qp_prop)
}

// P \/ Q => Q \/ P
fn or_comm(ctx: &! ProofContext, pq_proof_id: i64, p_id: i64, q_id: i64) -> i64 {
    // Case P: derive Q \/ P via or_intro_right
    let qp_prop = ctx_prop(ctx, prop_or(q_id, p_id))
    // Case P: assuming P, introduce Q \/ P by right
    let p_assume = assume(ctx, 101, p_id)
    let case_p = or_intro_right(ctx, p_assume, qp_prop)
    // Case Q: assuming Q, introduce Q \/ P by left
    let q_assume = assume(ctx, 102, q_id)
    let case_q = or_intro_left(ctx, q_assume, qp_prop)
    // Or elimination
    return or_elim(ctx, pq_proof_id, case_p, case_q, qp_prop)
}

// ============================================================================
// ASSOCIATIVITY
// ============================================================================

// (P /\ Q) /\ R => P /\ (Q /\ R)
fn and_assoc(ctx: &! ProofContext, pqr_proof_id: i64, p_id: i64, q_id: i64, r_id: i64) -> i64 {
    let pq_id = ctx_prop(ctx, prop_and(p_id, q_id))
    // Extract (P /\ Q) from ((P /\ Q) /\ R)
    let pq_prf = and_elim_left(ctx, pqr_proof_id, pq_id)
    // Extract R from ((P /\ Q) /\ R)
    let r_prf = and_elim_right(ctx, pqr_proof_id, r_id)
    // Extract P from (P /\ Q)
    let p_prf = and_elim_left(ctx, pq_prf, p_id)
    // Extract Q from (P /\ Q)
    let q_prf = and_elim_right(ctx, pq_prf, q_id)
    // Build Q /\ R
    let qr_id = ctx_prop(ctx, prop_and(q_id, r_id))
    let qr_prf = and_intro(ctx, q_prf, r_prf, qr_id)
    // Build P /\ (Q /\ R)
    let result_id = ctx_prop(ctx, prop_and(p_id, qr_id))
    return and_intro(ctx, p_prf, qr_prf, result_id)
}

// (P \/ Q) \/ R => P \/ (Q \/ R)
fn or_assoc(ctx: &! ProofContext, pqr_proof_id: i64, p_id: i64, q_id: i64, r_id: i64) -> i64 {
    let qr_id = ctx_prop(ctx, prop_or(q_id, r_id))
    let result_id = ctx_prop(ctx, prop_or(p_id, qr_id))

    // Case (P \/ Q): two sub-cases
    let pq_assume = assume(ctx, 201, ctx_prop(ctx, prop_or(p_id, q_id)))
    // sub-case P: P => P \/ (Q \/ R) by left
    let p_case = assume(ctx, 202, p_id)
    let p_result = or_intro_left(ctx, p_case, result_id)
    // sub-case Q: Q => Q \/ R by left, then P \/ (Q \/ R) by right
    let q_case = assume(ctx, 203, q_id)
    let qr_from_q = or_intro_left(ctx, q_case, qr_id)
    let q_result = or_intro_right(ctx, qr_from_q, result_id)
    let pq_result = or_elim(ctx, pq_assume, p_result, q_result, result_id)

    // Case R: R => Q \/ R by right, then P \/ (Q \/ R) by right
    let r_case = assume(ctx, 204, r_id)
    let qr_from_r = or_intro_right(ctx, r_case, qr_id)
    let r_result = or_intro_right(ctx, qr_from_r, result_id)

    return or_elim(ctx, pqr_proof_id, pq_result, r_result, result_id)
}

// ============================================================================
// IDENTITY / ANNIHILATION
// ============================================================================

// P /\ True => P
fn and_true_left(ctx: &! ProofContext, pt_proof_id: i64, p_id: i64) -> i64 {
    return and_elim_left(ctx, pt_proof_id, p_id)
}

// P \/ False => P
fn or_false_left(ctx: &! ProofContext, pf_proof_id: i64, p_id: i64) -> i64 {
    let false_id = ctx_prop(ctx, prop_false())
    // Case P: trivially P
    let p_case = assume(ctx, 301, p_id)
    // Case False: ex falso
    let f_case = assume(ctx, 302, false_id)
    let false_result = false_elim(ctx, f_case, p_id)
    return or_elim(ctx, pf_proof_id, p_case, false_result, p_id)
}

// ============================================================================
// ABSORPTION
// ============================================================================

// P /\ (P \/ Q) => P
fn and_absorption(ctx: &! ProofContext, proof_id: i64, p_id: i64) -> i64 {
    return and_elim_left(ctx, proof_id, p_id)
}

// P \/ (P /\ Q) => P
fn or_absorption(ctx: &! ProofContext, proof_id: i64, p_id: i64, q_id: i64) -> i64 {
    let pq_id = ctx_prop(ctx, prop_and(p_id, q_id))
    // Case P: trivially P
    let p_case = assume(ctx, 401, p_id)
    // Case P /\ Q: extract P
    let pq_case = assume(ctx, 402, pq_id)
    let pq_result = and_elim_left(ctx, pq_case, p_id)
    return or_elim(ctx, proof_id, p_case, pq_result, p_id)
}

// ============================================================================
// DOUBLE NEGATION
// ============================================================================

// P => ~~P  (constructive — always valid)
fn double_neg_intro(ctx: &! ProofContext, p_proof_id: i64, p_id: i64) -> i64 {
    // Assume ~P. From P and ~P derive False. Therefore ~~P.
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let not_p = assume(ctx, 501, not_p_id)
    let falsum = not_elim(ctx, not_p, p_proof_id)
    let nnp_id = ctx_prop(ctx, prop_not(not_p_id))
    return not_intro(ctx, not_p, falsum, nnp_id)
}

// ~~P => P  (classical only — requires LEM)
fn double_neg_elim(ctx: &! ProofContext, nnp_proof_id: i64, p_id: i64, _classical: Classical) -> i64 {
    // By LEM, P \/ ~P. Case P: done. Case ~P: contradiction with ~~P.
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let lem_prop = ctx_prop(ctx, prop_or(p_id, not_p_id))
    let lem = trusted(ctx, 1002, lem_prop, 1.0)
    // Case P: trivially P
    let p_case = assume(ctx, 502, p_id)
    // Case ~P: ~P contradicts ~~P => False => P
    let np_case = assume(ctx, 503, not_p_id)
    let falsum = not_elim(ctx, nnp_proof_id, np_case)
    let np_result = false_elim(ctx, falsum, p_id)
    return or_elim(ctx, lem, p_case, np_result, p_id)
}

// ============================================================================
// CONTRAPOSITION
// ============================================================================

// (P -> Q) => (~Q -> ~P)  (constructive)
fn contrapositive(ctx: &! ProofContext, pq_proof_id: i64, p_id: i64, q_id: i64) -> i64 {
    // Assume ~Q. Assume P. P -> Q gives Q. ~Q and Q give False. So ~P.
    let not_q_id = ctx_prop(ctx, prop_not(q_id))
    let nq_assume = assume(ctx, 601, not_q_id)
    let p_assume = assume(ctx, 602, p_id)
    let q_prf = impl_elim(ctx, pq_proof_id, p_assume, q_id)
    let falsum = not_elim(ctx, nq_assume, q_prf)
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let np_prf = not_intro(ctx, p_assume, falsum, not_p_id)
    // Build ~Q -> ~P
    let result_id = ctx_prop(ctx, prop_implies(not_q_id, not_p_id))
    return impl_intro(ctx, nq_assume, np_prf, result_id)
}

// (~Q -> ~P) => (P -> Q)  (classical only)
fn contrapositive_rev(ctx: &! ProofContext, nqnp_proof_id: i64, p_id: i64, q_id: i64, _classical: Classical) -> i64 {
    // Assume P. By LEM, Q \/ ~Q. Case Q: done. Case ~Q: ~Q -> ~P gives ~P.
    // ~P contradicts P => False => Q.
    let not_q_id = ctx_prop(ctx, prop_not(q_id))
    let not_p_id = ctx_prop(ctx, prop_not(p_id))

    let p_assume = assume(ctx, 611, p_id)
    let lem_prop = ctx_prop(ctx, prop_or(q_id, not_q_id))
    let lem = trusted(ctx, 1003, lem_prop, 1.0)

    // Case Q: trivially Q
    let q_case = assume(ctx, 612, q_id)
    // Case ~Q: ~Q -> ~P gives ~P, contradicts P
    let nq_case = assume(ctx, 613, not_q_id)
    let np_prf = impl_elim(ctx, nqnp_proof_id, nq_case, not_p_id)
    let falsum = not_elim(ctx, np_prf, p_assume)
    let nq_result = false_elim(ctx, falsum, q_id)

    let q_from_p = or_elim(ctx, lem, q_case, nq_result, q_id)
    let result_id = ctx_prop(ctx, prop_implies(p_id, q_id))
    return impl_intro(ctx, p_assume, q_from_p, result_id)
}

// ============================================================================
// DE MORGAN'S LAWS
// ============================================================================

// ~(P /\ Q) => ~P \/ ~Q  (classical)
fn de_morgan_and(ctx: &! ProofContext, not_pq_proof_id: i64, p_id: i64, q_id: i64, _classical: Classical) -> i64 {
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let not_q_id = ctx_prop(ctx, prop_not(q_id))
    let result_id = ctx_prop(ctx, prop_or(not_p_id, not_q_id))

    // By LEM on P: P \/ ~P
    let lem_p = trusted(ctx, 1004, ctx_prop(ctx, prop_or(p_id, not_p_id)), 1.0)

    // Case P: Need ~Q. Assume Q. Then P /\ Q. But ~(P /\ Q). Contradiction => ~Q.
    let p_case = assume(ctx, 701, p_id)
    let q_assume = assume(ctx, 702, q_id)
    let pq_prop = ctx_prop(ctx, prop_and(p_id, q_id))
    let pq_prf = and_intro(ctx, p_case, q_assume, pq_prop)
    let falsum = not_elim(ctx, not_pq_proof_id, pq_prf)
    let nq_prf = not_intro(ctx, q_assume, falsum, not_q_id)
    let p_result = or_intro_right(ctx, nq_prf, result_id)

    // Case ~P: ~P \/ ~Q by left
    let np_case = assume(ctx, 703, not_p_id)
    let np_result = or_intro_left(ctx, np_case, result_id)

    return or_elim(ctx, lem_p, p_result, np_result, result_id)
}

// ~(P \/ Q) => ~P /\ ~Q  (constructive)
fn de_morgan_or(ctx: &! ProofContext, not_pq_proof_id: i64, p_id: i64, q_id: i64) -> i64 {
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let not_q_id = ctx_prop(ctx, prop_not(q_id))
    let pq_id = ctx_prop(ctx, prop_or(p_id, q_id))

    // Prove ~P: assume P, then P \/ Q, contradicts ~(P \/ Q)
    let p_assume = assume(ctx, 711, p_id)
    let pq_from_p = or_intro_left(ctx, p_assume, pq_id)
    let falsum_p = not_elim(ctx, not_pq_proof_id, pq_from_p)
    let np_prf = not_intro(ctx, p_assume, falsum_p, not_p_id)

    // Prove ~Q: assume Q, then P \/ Q, contradicts ~(P \/ Q)
    let q_assume = assume(ctx, 712, q_id)
    let pq_from_q = or_intro_right(ctx, q_assume, pq_id)
    let falsum_q = not_elim(ctx, not_pq_proof_id, pq_from_q)
    let nq_prf = not_intro(ctx, q_assume, falsum_q, not_q_id)

    // Build ~P /\ ~Q
    let result_id = ctx_prop(ctx, prop_and(not_p_id, not_q_id))
    return and_intro(ctx, np_prf, nq_prf, result_id)
}

// ~P /\ ~Q => ~(P \/ Q)  (constructive)
fn de_morgan_or_rev(ctx: &! ProofContext, npnq_proof_id: i64, p_id: i64, q_id: i64) -> i64 {
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let not_q_id = ctx_prop(ctx, prop_not(q_id))
    let pq_id = ctx_prop(ctx, prop_or(p_id, q_id))

    // Extract ~P and ~Q
    let np_prf = and_elim_left(ctx, npnq_proof_id, not_p_id)
    let nq_prf = and_elim_right(ctx, npnq_proof_id, not_q_id)

    // Assume P \/ Q. Case P: contradicts ~P. Case Q: contradicts ~Q.
    let pq_assume = assume(ctx, 721, pq_id)
    let p_case = assume(ctx, 722, p_id)
    let false_from_p = not_elim(ctx, np_prf, p_case)
    let q_case = assume(ctx, 723, q_id)
    let false_from_q = not_elim(ctx, nq_prf, q_case)
    let false_id = ctx_prop(ctx, prop_false())
    let falsum = or_elim(ctx, pq_assume, false_from_p, false_from_q, false_id)

    let result_id = ctx_prop(ctx, prop_not(pq_id))
    return not_intro(ctx, pq_assume, falsum, result_id)
}

// ~P \/ ~Q => ~(P /\ Q)  (constructive)
fn de_morgan_and_rev(ctx: &! ProofContext, npornq_proof_id: i64, p_id: i64, q_id: i64) -> i64 {
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let not_q_id = ctx_prop(ctx, prop_not(q_id))
    let pq_id = ctx_prop(ctx, prop_and(p_id, q_id))

    // Assume P /\ Q. Case ~P: P from P/\Q contradicts ~P. Case ~Q: Q contradicts ~Q.
    let pq_assume = assume(ctx, 731, pq_id)
    let p_from_pq = and_elim_left(ctx, pq_assume, p_id)
    let q_from_pq = and_elim_right(ctx, pq_assume, q_id)

    let np_case = assume(ctx, 732, not_p_id)
    let false_from_np = not_elim(ctx, np_case, p_from_pq)

    let nq_case = assume(ctx, 733, not_q_id)
    let false_from_nq = not_elim(ctx, nq_case, q_from_pq)

    let false_id = ctx_prop(ctx, prop_false())
    let falsum = or_elim(ctx, npornq_proof_id, false_from_np, false_from_nq, false_id)
    let result_id = ctx_prop(ctx, prop_not(pq_id))
    return not_intro(ctx, pq_assume, falsum, result_id)
}

// ============================================================================
// DISTRIBUTION
// ============================================================================

// P /\ (Q \/ R) => (P /\ Q) \/ (P /\ R)
fn and_dist_or(ctx: &! ProofContext, prf_id: i64, p_id: i64, q_id: i64, r_id: i64) -> i64 {
    let qr_id = ctx_prop(ctx, prop_or(q_id, r_id))
    let pq_id = ctx_prop(ctx, prop_and(p_id, q_id))
    let pr_id = ctx_prop(ctx, prop_and(p_id, r_id))
    let result_id = ctx_prop(ctx, prop_or(pq_id, pr_id))

    let p_prf = and_elim_left(ctx, prf_id, p_id)
    let qr_prf = and_elim_right(ctx, prf_id, qr_id)

    // Case Q: build P /\ Q, introduce left
    let q_case = assume(ctx, 801, q_id)
    let pq_prf = and_intro(ctx, p_prf, q_case, pq_id)
    let q_result = or_intro_left(ctx, pq_prf, result_id)

    // Case R: build P /\ R, introduce right
    let r_case = assume(ctx, 802, r_id)
    let pr_prf = and_intro(ctx, p_prf, r_case, pr_id)
    let r_result = or_intro_right(ctx, pr_prf, result_id)

    return or_elim(ctx, qr_prf, q_result, r_result, result_id)
}

// P \/ (Q /\ R) => (P \/ Q) /\ (P \/ R)
fn or_dist_and(ctx: &! ProofContext, prf_id: i64, p_id: i64, q_id: i64, r_id: i64) -> i64 {
    let pq_id = ctx_prop(ctx, prop_or(p_id, q_id))
    let pr_id = ctx_prop(ctx, prop_or(p_id, r_id))
    let result_id = ctx_prop(ctx, prop_and(pq_id, pr_id))
    let qr_id = ctx_prop(ctx, prop_and(q_id, r_id))

    // Case P: P => P \/ Q by left, P => P \/ R by left
    let p_case = assume(ctx, 811, p_id)
    let pq_from_p = or_intro_left(ctx, p_case, pq_id)
    let pr_from_p = or_intro_left(ctx, p_case, pr_id)
    let p_result = and_intro(ctx, pq_from_p, pr_from_p, result_id)

    // Case Q /\ R: extract Q, R, build P \/ Q by right, P \/ R by right
    let qr_case = assume(ctx, 812, qr_id)
    let q_from_qr = and_elim_left(ctx, qr_case, q_id)
    let r_from_qr = and_elim_right(ctx, qr_case, r_id)
    let pq_from_q = or_intro_right(ctx, q_from_qr, pq_id)
    let pr_from_r = or_intro_right(ctx, r_from_qr, pr_id)
    let qr_result = and_intro(ctx, pq_from_q, pr_from_r, result_id)

    return or_elim(ctx, prf_id, p_result, qr_result, result_id)
}

// ============================================================================
// CLASSICAL LOGIC
// ============================================================================

// Excluded middle: P \/ ~P  (requires Classical)
fn excluded_middle(ctx: &! ProofContext, p_id: i64, _classical: Classical) -> i64 {
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let lem_id = ctx_prop(ctx, prop_or(p_id, not_p_id))
    return trusted(ctx, 1010, lem_id, 1.0)
}

// Peirce's law: ((P -> Q) -> P) -> P  (requires Classical)
fn peirce(ctx: &! ProofContext, p_id: i64, q_id: i64, _classical: Classical) -> i64 {
    let pq_id = ctx_prop(ctx, prop_implies(p_id, q_id))
    let pqp_id = ctx_prop(ctx, prop_implies(pq_id, p_id))
    let result_id = ctx_prop(ctx, prop_implies(pqp_id, p_id))
    return trusted(ctx, 1011, result_id, 1.0)
}

// Proof by contradiction: assume ~P, derive False => P  (requires Classical)
fn by_contradiction(ctx: &! ProofContext, assume_not_p: i64, false_prf_id: i64, p_id: i64, _classical: Classical) -> i64 {
    // ~P => False means ~~P. Then double_neg_elim gives P.
    let not_p_id = ctx_prop(ctx, prop_not(p_id))
    let nnp_id = ctx_prop(ctx, prop_not(not_p_id))
    let nnp_prf = not_intro(ctx, assume_not_p, false_prf_id, nnp_id)
    return double_neg_elim(ctx, nnp_prf, p_id, _classical)
}

// ============================================================================
// DECIDABILITY COMBINATORS
// ============================================================================

// Decidable(P) /\ Decidable(Q) => Decidable(P /\ Q)
fn decidable_and(ctx: &! ProofContext, d1: Decidable, d2: Decidable) -> Decidable {
    let pq_id = ctx_prop(ctx, prop_and(d1.prop_id, d2.prop_id))
    if d1.is_true {
        if d2.is_true {
            let pq_prf = and_intro(ctx, d1.true_proof_id, d2.true_proof_id, pq_id)
            return decidable_true(pq_id, pq_prf)
        } else {
            // P true, Q false => ~(P /\ Q) because ~Q
            let q_id = d2.prop_id
            let nq_id = ctx_prop(ctx, prop_not(q_id))
            let npq_id = ctx_prop(ctx, prop_not(pq_id))
            // Assume P /\ Q, extract Q, contradiction with ~Q
            let pq_assume = assume(ctx, 901, pq_id)
            let q_from_pq = and_elim_right(ctx, pq_assume, q_id)
            let falsum = not_elim(ctx, d2.false_proof_id, q_from_pq)
            let npq_prf = not_intro(ctx, pq_assume, falsum, npq_id)
            return decidable_false(pq_id, npq_prf)
        }
    } else {
        // P false => ~(P /\ Q)
        let p_id = d1.prop_id
        let np_id = ctx_prop(ctx, prop_not(p_id))
        let npq_id = ctx_prop(ctx, prop_not(pq_id))
        let pq_assume = assume(ctx, 902, pq_id)
        let p_from_pq = and_elim_left(ctx, pq_assume, p_id)
        let falsum = not_elim(ctx, d1.false_proof_id, p_from_pq)
        let npq_prf = not_intro(ctx, pq_assume, falsum, npq_id)
        return decidable_false(pq_id, npq_prf)
    }
}

// Decidable(P) /\ Decidable(Q) => Decidable(P \/ Q)
fn decidable_or(ctx: &! ProofContext, d1: Decidable, d2: Decidable) -> Decidable {
    let pq_id = ctx_prop(ctx, prop_or(d1.prop_id, d2.prop_id))
    if d1.is_true {
        let pq_prf = or_intro_left(ctx, d1.true_proof_id, pq_id)
        return decidable_true(pq_id, pq_prf)
    } else {
        if d2.is_true {
            let pq_prf = or_intro_right(ctx, d2.true_proof_id, pq_id)
            return decidable_true(pq_id, pq_prf)
        } else {
            // Both false: ~P /\ ~Q => ~(P \/ Q)
            let np_id = ctx_prop(ctx, prop_not(d1.prop_id))
            let nq_id = ctx_prop(ctx, prop_not(d2.prop_id))
            let npnq_id = ctx_prop(ctx, prop_and(np_id, nq_id))
            let npnq_prf = and_intro(ctx, d1.false_proof_id, d2.false_proof_id, npnq_id)
            let npq_prf = de_morgan_or_rev(ctx, npnq_prf, d1.prop_id, d2.prop_id)
            return decidable_false(pq_id, npq_prf)
        }
    }
}

// Decidable(P) => Decidable(~P)
fn decidable_not(ctx: &! ProofContext, d: Decidable) -> Decidable {
    let np_id = ctx_prop(ctx, prop_not(d.prop_id))
    if d.is_true {
        // P is true, so ~P is false. Prove ~~P from P.
        let nnp_prf = double_neg_intro(ctx, d.true_proof_id, d.prop_id)
        return decidable_false(np_id, nnp_prf)
    } else {
        // P is false, ~P is true
        return decidable_true(np_id, d.false_proof_id)
    }
}

// ============================================================================
// CURRYING
// ============================================================================

// (P /\ Q -> R) => (P -> Q -> R)
fn curry_proof(ctx: &! ProofContext, pqr_proof_id: i64, p_id: i64, q_id: i64, r_id: i64) -> i64 {
    let pq_id = ctx_prop(ctx, prop_and(p_id, q_id))
    // Assume P, assume Q, build P /\ Q, apply PQ->R to get R
    let p_assume = assume(ctx, 1101, p_id)
    let q_assume = assume(ctx, 1102, q_id)
    let pq_prf = and_intro(ctx, p_assume, q_assume, pq_id)
    let r_prf = impl_elim(ctx, pqr_proof_id, pq_prf, r_id)
    let qr_id = ctx_prop(ctx, prop_implies(q_id, r_id))
    let qr_prf = impl_intro(ctx, q_assume, r_prf, qr_id)
    let result_id = ctx_prop(ctx, prop_implies(p_id, qr_id))
    return impl_intro(ctx, p_assume, qr_prf, result_id)
}

// (P -> Q -> R) => (P /\ Q -> R)
fn uncurry_proof(ctx: &! ProofContext, pqr_proof_id: i64, p_id: i64, q_id: i64, r_id: i64) -> i64 {
    let pq_id = ctx_prop(ctx, prop_and(p_id, q_id))
    // Assume P /\ Q, extract P and Q, apply P -> (Q -> R) to P to get Q -> R, apply to Q
    let pq_assume = assume(ctx, 1111, pq_id)
    let p_prf = and_elim_left(ctx, pq_assume, p_id)
    let q_prf = and_elim_right(ctx, pq_assume, q_id)
    let qr_id = ctx_prop(ctx, prop_implies(q_id, r_id))
    let qr_prf = impl_elim(ctx, pqr_proof_id, p_prf, qr_id)
    let r_prf = impl_elim(ctx, qr_prf, q_prf, r_id)
    let result_id = ctx_prop(ctx, prop_implies(pq_id, r_id))
    return impl_intro(ctx, pq_assume, r_prf, result_id)
}
