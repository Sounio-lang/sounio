//! stdlib/theorem/smt_farkas_microkernel.sio
//!
//! Bounded scalar Farkas proof-checker seed for the SMT/QF_LRA family. This
//! checks a two-inequality, one-variable integer-scaled certificate of the form
//!   a1*x <= b1, a2*x <= b2, y1,y2 >= 0,
//!   y1*a1 + y2*a2 = 0, y1*b1 + y2*b2 < 0.
//! It is not a full SMT proof parser, not Alethe/Carcara, and not a general
//! Fourier-Motzkin proof replay.

pub fn smt_farkas2_lhs_sum(a1: i64, a2: i64, y1: i64, y2: i64) -> i64 {
    if y1 < 0 { return 0 - 9001 }
    if y2 < 0 { return 0 - 9001 }
    return (y1 * a1) + (y2 * a2)
}

pub fn smt_farkas2_rhs_sum(b1: i64, b2: i64, y1: i64, y2: i64) -> i64 {
    if y1 < 0 { return 0 - 9001 }
    if y2 < 0 { return 0 - 9001 }
    return (y1 * b1) + (y2 * b2)
}

pub fn smt_farkas2_unsat_check(
    a1: i64,
    b1: i64,
    a2: i64,
    b2: i64,
    y1: i64,
    y2: i64) -> i64 {
    if y1 < 0 { return 0 }
    if y2 < 0 { return 0 }
    let lhs = smt_farkas2_lhs_sum(a1, a2, y1, y2)
    if lhs != 0 { return 0 }
    let rhs = smt_farkas2_rhs_sum(b1, b2, y1, y2)
    if rhs < 0 { return 1 }
    return 0
}

pub fn smt_farkas_microkernel_receipt_check(
    tiny_unsat_ok: i64,
    wrong_multiplier_rejected: i64,
    nonnegative_rhs_rejected: i64,
    negative_multiplier_rejected: i64,
    zero_lhs_required: i64,
    proof_family_mask: i64,
    proof_format_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    microkernel_status: i64) -> i64 {
    if tiny_unsat_ok != 1 { return 0 - 1 }
    if wrong_multiplier_rejected != 1 { return 0 - 1 }
    if nonnegative_rhs_rejected != 1 { return 0 - 1 }
    if negative_multiplier_rejected != 1 { return 0 - 1 }
    if zero_lhs_required != 1 { return 0 - 1 }
    if proof_family_mask != 3 { return 0 - 1 }
    if proof_format_mask != 5 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if microkernel_status != 100 { return 0 - 1 }
    return 583104927
}

pub fn smt_farkas_microkernel_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    tiny_unsat_ok: i64,
    wrong_multiplier_rejected: i64,
    nonnegative_rhs_rejected: i64,
    negative_multiplier_rejected: i64,
    zero_lhs_required: i64,
    proof_family_mask: i64,
    proof_format_mask: i64,
    imported_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    formal_theorem_ready: i64,
    microkernel_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 583104927 { return 0 - 1 }
    if instance_fp != 284916705 { return 0 - 1 }
    if certificate_fp != 640271893 { return 0 - 1 }
    if tiny_unsat_ok != 1 { return 0 - 1 }
    if wrong_multiplier_rejected != 1 { return 0 - 1 }
    if nonnegative_rhs_rejected != 1 { return 0 - 1 }
    if negative_multiplier_rejected != 1 { return 0 - 1 }
    if zero_lhs_required != 1 { return 0 - 1 }
    if proof_family_mask != 3 { return 0 - 1 }
    if proof_format_mask != 5 { return 0 - 1 }
    if imported_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if microkernel_status != 100 { return 0 - 1 }
    if ok_mask != 1023 { return 0 - 1 }
    return 719460238
}
