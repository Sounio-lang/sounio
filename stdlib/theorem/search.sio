//! stdlib/theorem/search.sio

pub struct Prop {
    tag: i32,
    left_id: i64,
    right_id: i64,
    var_name: i64,
    predicate_id: i64,
    eq_lhs: i64,
    eq_rhs: i64,
}

pub struct Proof {
    tag: i32,
    prop_id: i64,
    sub1_id: i64,
    sub2_id: i64,
    sub3_id: i64,
    label: i64,
    confidence: f64,
    witness: i64,
}

pub struct VerifyResult {
    is_valid: bool,
    confidence: f64,
}

struct LitResult {
    status: i32,
    count: i32,
    lits: [i64; 16],
}

struct AtomSet {
    ids: [i64; 16],
    count: i32,
}

pub struct ProofContext {
    prop_tags: [i32; 192],
    prop_left_ids: [i64; 192],
    prop_right_ids: [i64; 192],
    prop_predicate_ids: [i64; 192],
    prop_count: i64,

    proof_tags: [i32; 192],
    proof_prop_ids: [i64; 192],
    proof_sub1_ids: [i64; 192],
    proof_sub2_ids: [i64; 192],
    proof_confidences: [f64; 192],
    proof_count: i64,

    clause_prop_ids: [i64; 64],
    clause_start: [i32; 64],
    clause_len: [i32; 64],
    clause_data: [i64; 256],
    clause_count: i32,
    clause_data_count: i32,
}

fn search_abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn search_min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

pub fn prop_true() -> Prop {
    return Prop { tag: 0, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

pub fn prop_false() -> Prop {
    return Prop { tag: 1, left_id: 0, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

pub fn prop_and(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: 2, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

pub fn prop_or(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: 3, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

pub fn prop_implies(left_id: i64, right_id: i64) -> Prop {
    return Prop { tag: 4, left_id: left_id, right_id: right_id, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

pub fn prop_not(inner_id: i64) -> Prop {
    return Prop { tag: 5, left_id: inner_id, right_id: 0, var_name: 0, predicate_id: 0, eq_lhs: 0, eq_rhs: 0 }
}

pub fn prop_custom(pred_id: i64) -> Prop {
    return Prop { tag: 9, left_id: 0, right_id: 0, var_name: 0, predicate_id: pred_id, eq_lhs: 0, eq_rhs: 0 }
}

pub fn prop_eq_check(a: Prop, b: Prop) -> bool {
    if a.tag != b.tag { return false }
    if a.left_id != b.left_id { return false }
    if a.right_id != b.right_id { return false }
    if a.predicate_id != b.predicate_id { return false }
    return true
}

fn proof_invalid() -> Proof {
    return Proof { tag: 0 - 1, prop_id: 0, sub1_id: 0, sub2_id: 0, sub3_id: 0, label: 0, confidence: 0.0, witness: 0 }
}

fn lit_result_new() -> LitResult {
    return LitResult { status: 0, count: 0, lits: [0; 16] }
}

fn atom_set_new() -> AtomSet {
    return AtomSet { ids: [0; 16], count: 0 }
}

pub fn proof_context_new() -> ProofContext {
    return ProofContext {
        prop_tags: [0; 192],
        prop_left_ids: [0; 192],
        prop_right_ids: [0; 192],
        prop_predicate_ids: [0; 192],
        prop_count: 0,
        proof_tags: [0; 192],
        proof_prop_ids: [0; 192],
        proof_sub1_ids: [0; 192],
        proof_sub2_ids: [0; 192],
        proof_confidences: [0.0; 192],
        proof_count: 0,
        clause_prop_ids: [0; 64],
        clause_start: [0; 64],
        clause_len: [0; 64],
        clause_data: [0; 256],
        clause_count: 0,
        clause_data_count: 0,
    }
}

pub fn search_reset(ctx: &!ProofContext) with Mut {
    ctx.clause_count = 0
    ctx.clause_data_count = 0
}

pub fn ctx_get_prop(ctx: &ProofContext, id: i64) -> Prop {
    if id < 0 { return prop_false() }
    if id >= ctx.prop_count { return prop_false() }
    return Prop {
        tag: ctx.prop_tags[id],
        left_id: ctx.prop_left_ids[id],
        right_id: ctx.prop_right_ids[id],
        var_name: 0,
        predicate_id: ctx.prop_predicate_ids[id],
        eq_lhs: 0,
        eq_rhs: 0,
    }
}

fn ctx_get_prop_mut(ctx: &!ProofContext, id: i64) -> Prop with Mut {
    if id < 0 { return prop_false() }
    if id >= ctx.prop_count { return prop_false() }
    return Prop {
        tag: ctx.prop_tags[id],
        left_id: ctx.prop_left_ids[id],
        right_id: ctx.prop_right_ids[id],
        var_name: 0,
        predicate_id: ctx.prop_predicate_ids[id],
        eq_lhs: 0,
        eq_rhs: 0,
    }
}

pub fn ctx_get_proof(ctx: &ProofContext, id: i64) -> Proof {
    if id < 0 { return proof_invalid() }
    if id >= ctx.proof_count { return proof_invalid() }
    return Proof {
        tag: ctx.proof_tags[id],
        prop_id: ctx.proof_prop_ids[id],
        sub1_id: ctx.proof_sub1_ids[id],
        sub2_id: ctx.proof_sub2_ids[id],
        sub3_id: 0,
        label: 0,
        confidence: ctx.proof_confidences[id],
        witness: 0,
    }
}

fn ctx_get_proof_mut(ctx: &!ProofContext, id: i64) -> Proof with Mut {
    if id < 0 { return proof_invalid() }
    if id >= ctx.proof_count { return proof_invalid() }
    return Proof {
        tag: ctx.proof_tags[id],
        prop_id: ctx.proof_prop_ids[id],
        sub1_id: ctx.proof_sub1_ids[id],
        sub2_id: ctx.proof_sub2_ids[id],
        sub3_id: 0,
        label: 0,
        confidence: ctx.proof_confidences[id],
        witness: 0,
    }
}

pub fn ctx_prop(ctx: &!ProofContext, p: Prop) -> i64 with Mut {
    var i: i64 = 0
    while i < ctx.prop_count {
        if prop_eq_check(ctx_get_prop_mut(ctx, i), p) { return i }
        i = i + 1
    }
    let idx = ctx.prop_count
    if idx >= 192 { return 0 - 1 }
    ctx.prop_tags[idx] = p.tag
    ctx.prop_left_ids[idx] = p.left_id
    ctx.prop_right_ids[idx] = p.right_id
    ctx.prop_predicate_ids[idx] = p.predicate_id
    ctx.prop_count = idx + 1
    return idx
}

fn ctx_proof(ctx: &!ProofContext, tag: i32, prop_id: i64, sub1_id: i64, sub2_id: i64, confidence: f64) -> i64 with Mut {
    let idx = ctx.proof_count
    if idx >= 192 { return 0 - 1 }
    ctx.proof_tags[idx] = tag
    ctx.proof_prop_ids[idx] = prop_id
    ctx.proof_sub1_ids[idx] = sub1_id
    ctx.proof_sub2_ids[idx] = sub2_id
    ctx.proof_confidences[idx] = confidence
    ctx.proof_count = idx + 1
    return idx
}

fn prop_matches_mut(ctx: &!ProofContext, lhs_id: i64, rhs_id: i64) -> bool with Mut {
    if lhs_id == rhs_id { return true }
    return prop_eq_check(ctx_get_prop_mut(ctx, lhs_id), ctx_get_prop_mut(ctx, rhs_id))
}

fn proof_for_goal_mut(ctx: &!ProofContext, goal: i64) -> i64 with Mut {
    var i: i64 = 0
    var found: i64 = 0 - 1
    while i < ctx.proof_count {
        let prf = ctx_get_proof_mut(ctx, i)
        if prf.tag >= 0 {
            if prop_matches_mut(ctx, prf.prop_id, goal) { found = i }
        }
        i = i + 1
    }
    return found
}

pub fn assume(ctx: &!ProofContext, name: i64, prop_id: i64) -> i64 with Mut {
    return ctx_proof(ctx, 23, prop_id, name, 0, 1.0)
}

fn trusted(ctx: &!ProofContext, label: i64, prop_id: i64) -> i64 with Mut {
    return ctx_proof(ctx, 22, prop_id, label, 0, 1.0)
}

pub fn and_intro(ctx: &!ProofContext, p_id: i64, q_id: i64, result_prop_id: i64) -> i64 with Mut {
    let p = ctx_get_proof_mut(ctx, p_id)
    let q = ctx_get_proof_mut(ctx, q_id)
    return ctx_proof(ctx, 1, result_prop_id, p_id, q_id, search_min_f64(p.confidence, q.confidence))
}

fn or_intro_left(ctx: &!ProofContext, p_id: i64, result_prop_id: i64) -> i64 with Mut {
    return ctx_proof(ctx, 4, result_prop_id, p_id, 0, ctx_get_proof_mut(ctx, p_id).confidence)
}

fn or_intro_right(ctx: &!ProofContext, q_id: i64, result_prop_id: i64) -> i64 with Mut {
    return ctx_proof(ctx, 5, result_prop_id, q_id, 0, ctx_get_proof_mut(ctx, q_id).confidence)
}

fn impl_elim(ctx: &!ProofContext, impl_id: i64, arg_id: i64, result_prop_id: i64) -> i64 with Mut {
    let p1 = ctx_get_proof_mut(ctx, impl_id)
    let p2 = ctx_get_proof_mut(ctx, arg_id)
    return ctx_proof(ctx, 8, result_prop_id, impl_id, arg_id, search_min_f64(p1.confidence, p2.confidence))
}

pub fn verify(ctx: &ProofContext, proof_id: i64) -> VerifyResult {
    let p = ctx_get_proof(ctx, proof_id)
    if p.tag < 0 { return VerifyResult { is_valid: false, confidence: 0.0 } }
    return VerifyResult { is_valid: true, confidence: p.confidence }
}

fn prop_is_atom_mut(ctx: &!ProofContext, prop_id: i64) -> bool with Mut {
    let p = ctx_get_prop_mut(ctx, prop_id)
    if p.tag == 0 { return true }
    if p.tag == 1 { return true }
    if p.tag == 9 { return true }
    return false
}

fn lit_from_prop_mut(ctx: &!ProofContext, prop_id: i64) -> i64 with Mut {
    let p = ctx_get_prop_mut(ctx, prop_id)
    if p.tag == 5 {
        if prop_is_atom_mut(ctx, p.left_id) { return 0 - (p.left_id + 1) }
        return 0
    }
    if prop_is_atom_mut(ctx, prop_id) { return prop_id + 1 }
    return 0
}

fn lit_to_prop(ctx: &!ProofContext, lit: i64) -> i64 with Mut {
    if lit > 0 { return lit - 1 }
    return ctx_prop(ctx, prop_not(search_abs_i64(lit) - 1))
}

fn clause_sort_owned(lits_in: [i64; 16], n_in: i32) -> LitResult with Mut {
    var out = LitResult { status: 0, count: n_in, lits: lits_in }
    var i: i32 = 1
    while i < out.count {
        let key = out.lits[i]
        var j = i - 1
        while j >= 0 {
            if out.lits[j] <= key {
                j = 0 - 1
            } else {
                out.lits[j + 1] = out.lits[j]
                j = j - 1
            }
        }
        out.lits[j + 1] = key
        i = i + 1
    }
    var n: i32 = 0
    i = 0
    while i < out.count {
        let lit = out.lits[i]
        var dup = false
        if n > 0 {
            if out.lits[n - 1] == lit { dup = true }
        }
        if dup == false {
            var k: i32 = 0
            while k < n {
                if out.lits[k] == 0 - lit { return LitResult { status: 0 - 1, count: 0, lits: [0; 16] } }
                k = k + 1
            }
            out.lits[n] = lit
            n = n + 1
        }
        i = i + 1
    }
    out.count = n
    return out
}

fn clause_prop_from_lits(ctx: &!ProofContext, lits: &[i64; 16], n: i32) -> i64 with Mut {
    if n <= 0 { return ctx_prop(ctx, prop_false()) }
    var cur = lit_to_prop(ctx, lits[0])
    var i: i32 = 1
    while i < n {
        cur = ctx_prop(ctx, prop_or(cur, lit_to_prop(ctx, lits[i])))
        i = i + 1
    }
    return cur
}

fn prop_from_lits(ctx: &!ProofContext, lits: &[i64; 16], n: i32) -> i64 with Mut {
    if n <= 0 { return ctx_prop(ctx, prop_false()) }
    var cur = lit_to_prop(ctx, lits[0])
    var i: i32 = 1
    while i < n {
        cur = ctx_prop(ctx, prop_or(cur, lit_to_prop(ctx, lits[i])))
        i = i + 1
    }
    return cur
}

fn clause_equal_mut(ctx: &!ProofContext, idx: i32, lits: &[i64; 16], n: i32) -> bool with Mut {
    if ctx.clause_len[idx] != n { return false }
    var i: i32 = 0
    while i < n {
        if ctx.clause_data[ctx.clause_start[idx] + i] != lits[i] { return false }
        i = i + 1
    }
    return true
}

fn clause_add(ctx: &!ProofContext, lits_in: &[i64; 16], n_in: i32) -> i32 with Mut {
    var tmp: [i64; 16] = [0; 16]
    var i: i32 = 0
    while i < n_in {
        tmp[i] = lits_in[i]
        i = i + 1
    }
    let sorted = clause_sort_owned(tmp, n_in)
    if sorted.status < 0 { return 0 - 1 }
    var canon: [i64; 16] = [0; 16]
    i = 0
    while i < sorted.count {
        canon[i] = sorted.lits[i]
        i = i + 1
    }
    i = 0
    while i < ctx.clause_count {
        if clause_equal_mut(ctx, i, &canon, sorted.count) { return i }
        i = i + 1
    }
    if ctx.clause_count >= 64 { return 0 - 1 }
    if ctx.clause_data_count + sorted.count > 256 { return 0 - 1 }
    let idx = ctx.clause_count
    let start = ctx.clause_data_count
    ctx.clause_prop_ids[idx] = clause_prop_from_lits(ctx, &canon, sorted.count)
    ctx.clause_start[idx] = start
    ctx.clause_len[idx] = sorted.count
    i = 0
    while i < sorted.count {
        ctx.clause_data[start + i] = canon[i]
        i = i + 1
    }
    ctx.clause_count = idx + 1
    ctx.clause_data_count = start + sorted.count
    return idx
}

fn clause_collect(ctx: &!ProofContext, prop_id: i64) -> LitResult with Mut {
    let p = ctx_get_prop_mut(ctx, prop_id)
    if p.tag == 0 { return LitResult { status: 1, count: 0, lits: [0; 16] } }
    if p.tag == 1 { return lit_result_new() }
    if p.tag == 3 {
        let left = clause_collect(ctx, p.left_id)
        let right = clause_collect(ctx, p.right_id)
        if left.status < 0 { return left }
        if right.status < 0 { return right }
        if left.status == 1 { return left }
        if right.status == 1 { return right }
        var merged = lit_result_new()
        var i: i32 = 0
        while i < left.count {
            merged.lits[merged.count] = left.lits[i]
            merged.count = merged.count + 1
            i = i + 1
        }
        i = 0
        while i < right.count {
            merged.lits[merged.count] = right.lits[i]
            merged.count = merged.count + 1
            i = i + 1
        }
        return merged
    }
    let lit = lit_from_prop_mut(ctx, prop_id)
    if lit == 0 { return LitResult { status: 0 - 1, count: 0, lits: [0; 16] } }
    var one = lit_result_new()
    one.count = 1
    one.lits[0] = lit
    return one
}

pub fn to_cnf(ctx: &!ProofContext, prop_id: i64) -> i64 with Mut {
    let p = ctx_get_prop_mut(ctx, prop_id)
    if p.tag == 2 {
        to_cnf(ctx, p.left_id)
        to_cnf(ctx, p.right_id)
        return prop_id
    }
    if p.tag == 4 {
        let rew = ctx_prop(ctx, prop_or(ctx_prop(ctx, prop_not(p.left_id)), p.right_id))
        return to_cnf(ctx, rew)
    }
    if p.tag == 5 {
        let inner = ctx_get_prop_mut(ctx, p.left_id)
        if inner.tag == 5 { return to_cnf(ctx, inner.left_id) }
        if inner.tag == 2 {
            let rew = ctx_prop(ctx, prop_or(ctx_prop(ctx, prop_not(inner.left_id)), ctx_prop(ctx, prop_not(inner.right_id))))
            return to_cnf(ctx, rew)
        }
        if inner.tag == 3 {
            let rew = ctx_prop(ctx, prop_and(ctx_prop(ctx, prop_not(inner.left_id)), ctx_prop(ctx, prop_not(inner.right_id))))
            return to_cnf(ctx, rew)
        }
    }
    let clause = clause_collect(ctx, prop_id)
    if clause.status == 0 {
        var lits: [i64; 16] = [0; 16]
        var i: i32 = 0
        while i < clause.count {
            lits[i] = clause.lits[i]
            i = i + 1
        }
        clause_add(ctx, &lits, clause.count)
    }
    return prop_id
}

pub fn resolve(ctx: &!ProofContext, clause1: i64, clause2: i64, var: i64) -> i64 with Mut {
    let p1 = ctx_get_prop_mut(ctx, clause1)
    let p2 = ctx_get_prop_mut(ctx, clause2)
    let neg_var = ctx_prop(ctx, prop_not(var))
    if prop_matches_mut(ctx, clause1, var) {
        if prop_matches_mut(ctx, clause2, neg_var) { return ctx_prop(ctx, prop_false()) }
        if p2.tag == 3 {
            if prop_matches_mut(ctx, p2.left_id, neg_var) { return p2.right_id }
            if prop_matches_mut(ctx, p2.right_id, neg_var) { return p2.left_id }
        }
    }
    if prop_matches_mut(ctx, clause2, var) {
        if prop_matches_mut(ctx, clause1, neg_var) { return ctx_prop(ctx, prop_false()) }
        if p1.tag == 3 {
            if prop_matches_mut(ctx, p1.left_id, neg_var) { return p1.right_id }
            if prop_matches_mut(ctx, p1.right_id, neg_var) { return p1.left_id }
        }
    }
    if prop_matches_mut(ctx, clause1, neg_var) {
        if prop_matches_mut(ctx, clause2, var) { return ctx_prop(ctx, prop_false()) }
        if p2.tag == 3 {
            if prop_matches_mut(ctx, p2.left_id, var) { return p2.right_id }
            if prop_matches_mut(ctx, p2.right_id, var) { return p2.left_id }
        }
    }
    if prop_matches_mut(ctx, clause2, neg_var) {
        if prop_matches_mut(ctx, clause1, var) { return ctx_prop(ctx, prop_false()) }
        if p1.tag == 3 {
            if prop_matches_mut(ctx, p1.left_id, var) { return p1.right_id }
            if prop_matches_mut(ctx, p1.right_id, var) { return p1.left_id }
        }
    }
    let c1 = clause_collect(ctx, clause1)
    let c2 = clause_collect(ctx, clause2)
    if c1.status != 0 { return 0 - 1 }
    if c2.status != 0 { return 0 - 1 }
    let hint_pos = var + 1
    let hint_neg = 0 - hint_pos
    var left_remove = 0
    var right_remove = 0
    var i: i32 = 0
    while i < c1.count {
        let lit = c1.lits[i]
        if lit == hint_pos {
            var j: i32 = 0
            while j < c2.count {
                if c2.lits[j] == hint_neg {
                    left_remove = lit
                    right_remove = hint_neg
                }
                j = j + 1
            }
        }
        if lit == hint_neg {
            var j: i32 = 0
            while j < c2.count {
                if c2.lits[j] == hint_pos {
                    left_remove = lit
                    right_remove = hint_pos
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    if left_remove == 0 && right_remove == 0 {
        i = 0
        while i < c1.count {
            let lit = c1.lits[i]
            var j: i32 = 0
            while j < c2.count {
                if c2.lits[j] == 0 - lit {
                    left_remove = lit
                    right_remove = c2.lits[j]
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    if left_remove == 0 && right_remove == 0 { return 0 - 1 }
    var lits: [i64; 16] = [0; 16]
    var n: i32 = 0
    i = 0
    while i < c1.count {
        if c1.lits[i] != left_remove {
            lits[n] = c1.lits[i]
            n = n + 1
        }
        i = i + 1
    }
    i = 0
    while i < c2.count {
        if c2.lits[i] != right_remove {
            lits[n] = c2.lits[i]
            n = n + 1
        }
        i = i + 1
    }
    let sorted = clause_sort_owned(lits, n)
    if sorted.status < 0 { return 0 - 1 }
    var final_lits: [i64; 16] = [0; 16]
    i = 0
    while i < sorted.count {
        final_lits[i] = sorted.lits[i]
        i = i + 1
    }
    return prop_from_lits(ctx, &final_lits, sorted.count)
}

fn clause_contains_mut(ctx: &!ProofContext, idx: i32, lit: i64) -> bool with Mut {
    var i: i32 = 0
    while i < ctx.clause_len[idx] {
        if ctx.clause_data[ctx.clause_start[idx] + i] == lit { return true }
        i = i + 1
    }
    return false
}

pub fn saturate(ctx: &!ProofContext, max_steps: i64) -> bool with Mut {
    var work_start: [i32; 64] = [0; 64]
    var work_len: [i32; 64] = [0; 64]
    var work_data: [i64; 256] = [0; 256]
    var work_count: i32 = 0
    var work_data_count: i32 = 0
    var i: i32 = 0
    while i < ctx.clause_count {
        work_start[i] = work_data_count
        work_len[i] = ctx.clause_len[i]
        var j: i32 = 0
        while j < ctx.clause_len[i] {
            work_data[work_data_count + j] = ctx.clause_data[ctx.clause_start[i] + j]
            j = j + 1
        }
        work_data_count = work_data_count + ctx.clause_len[i]
        work_count = work_count + 1
        i = i + 1
    }

    var steps: i64 = 0
    while steps < max_steps {
        var changed = false
        i = 0
        while i < work_count {
            var j: i32 = i + 1
            while j < work_count {
                var k: i32 = 0
                while k < work_len[i] {
                    let lit = work_data[work_start[i] + k]
                    if clause_contains_mut(ctx, j, 0 - lit) {
                        var out_lits: [i64; 16] = [0; 16]
                        var out_n: i32 = 0
                        var a: i32 = 0
                        while a < work_len[i] {
                            let alit = work_data[work_start[i] + a]
                            if alit != lit {
                                out_lits[out_n] = alit
                                out_n = out_n + 1
                            }
                            a = a + 1
                        }
                        a = 0
                        while a < work_len[j] {
                            let blit = work_data[work_start[j] + a]
                            if blit != 0 - lit {
                                out_lits[out_n] = blit
                                out_n = out_n + 1
                            }
                            a = a + 1
                        }
                        let sorted = clause_sort_owned(out_lits, out_n)
                        if sorted.status >= 0 {
                            if sorted.count == 0 { return true }
                            var duplicate = false
                            a = 0
                            while a < work_count {
                                if work_len[a] == sorted.count {
                                    var eq = true
                                    var b: i32 = 0
                                    while b < sorted.count {
                                        if work_data[work_start[a] + b] != sorted.lits[b] { eq = false }
                                        b = b + 1
                                    }
                                    if eq { duplicate = true }
                                }
                                a = a + 1
                            }
                            if duplicate == false {
                                if work_count >= 64 { return false }
                                if work_data_count + sorted.count > 256 { return false }
                                work_start[work_count] = work_data_count
                                work_len[work_count] = sorted.count
                                a = 0
                                while a < sorted.count {
                                    work_data[work_data_count + a] = sorted.lits[a]
                                    a = a + 1
                                }
                                work_data_count = work_data_count + sorted.count
                                work_count = work_count + 1
                                changed = true
                                steps = steps + 1
                                if steps >= max_steps { return false }
                            }
                        }
                    }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        if changed == false { return false }
    }
    return false
}

fn atom_add(set: &!AtomSet, atom: i64) with Mut {
    var i: i32 = 0
    while i < set.count {
        if set.ids[i] == atom { return }
        i = i + 1
    }
    if set.count >= 16 { return }
    set.ids[set.count] = atom
    set.count = set.count + 1
}

fn collect_atoms(ctx: &!ProofContext, prop_id: i64, set: &!AtomSet) with Mut {
    let p = ctx_get_prop_mut(ctx, prop_id)
    if p.tag == 9 {
        atom_add(set, prop_id)
        return
    }
    if p.tag == 5 { collect_atoms(ctx, p.left_id, set); return }
    if p.tag == 2 || p.tag == 3 || p.tag == 4 {
        collect_atoms(ctx, p.left_id, set)
        collect_atoms(ctx, p.right_id, set)
    }
}

fn atom_value(atoms: &[i64; 16], n: i32, mask: i64, atom: i64) -> bool with Mut, Div {
    var i: i32 = 0
    while i < n {
        if atoms[i] == atom {
            return ((mask / (1 << i)) % 2) == 1
        }
        i = i + 1
    }
    return false
}

fn eval_prop(ctx: &!ProofContext, prop_id: i64, atoms: &[i64; 16], n: i32, mask: i64) -> bool with Mut, Div {
    let p = ctx_get_prop_mut(ctx, prop_id)
    if p.tag == 0 { return true }
    if p.tag == 1 { return false }
    if p.tag == 9 { return atom_value(atoms, n, mask, prop_id) }
    if p.tag == 5 { return eval_prop(ctx, p.left_id, atoms, n, mask) == false }
    if p.tag == 2 { return eval_prop(ctx, p.left_id, atoms, n, mask) && eval_prop(ctx, p.right_id, atoms, n, mask) }
    if p.tag == 3 { return eval_prop(ctx, p.left_id, atoms, n, mask) || eval_prop(ctx, p.right_id, atoms, n, mask) }
    if p.tag == 4 { return eval_prop(ctx, p.left_id, atoms, n, mask) == false || eval_prop(ctx, p.right_id, atoms, n, mask) }
    return false
}

fn entails(ctx: &!ProofContext, goal: i64) -> bool with Mut, Div {
    var atoms = atom_set_new()
    collect_atoms(ctx, goal, &! atoms)
    var i: i64 = 0
    while i < ctx.proof_count {
        let prf = ctx_get_proof_mut(ctx, i)
        if prf.tag >= 0 { collect_atoms(ctx, prf.prop_id, &! atoms) }
        i = i + 1
    }
    if atoms.count > 12 { return false }
    let total = 1 << atoms.count
    var atom_ids: [i64; 16] = [0; 16]
    i = 0
    while i < atoms.count {
        atom_ids[i] = atoms.ids[i]
        i = i + 1
    }
    var mask: i64 = 0
    while mask < total {
        var assumptions_hold = true
        i = 0
        while i < ctx.proof_count {
            let prf = ctx_get_proof_mut(ctx, i)
            if prf.tag >= 0 {
                if eval_prop(ctx, prf.prop_id, &atom_ids, atoms.count, mask) == false {
                    assumptions_hold = false
                }
            }
            i = i + 1
        }
        if assumptions_hold {
            if eval_prop(ctx, goal, &atom_ids, atoms.count, mask) == false { return false }
        }
        mask = mask + 1
    }
    return true
}

fn auto_try_mp(ctx: &!ProofContext, goal: i64, max_depth: i64) -> i64 with Mut, Div {
    if max_depth <= 0 { return 0 - 1 }
    var i: i64 = 0
    while i < ctx.proof_count {
        let prf = ctx_get_proof_mut(ctx, i)
        if prf.tag >= 0 {
            let p = ctx_get_prop_mut(ctx, prf.prop_id)
            if p.tag == 4 {
                if prop_matches_mut(ctx, p.right_id, goal) {
                    let arg = auto_prove(ctx, p.left_id, max_depth - 1)
                    if arg >= 0 { return impl_elim(ctx, i, arg, goal) }
                }
            }
        }
        i = i + 1
    }
    return 0 - 1
}

pub fn auto_prove(ctx: &!ProofContext, goal: i64, max_depth: i64) -> i64 with Mut, Div {
    if max_depth <= 0 { return 0 - 1 }
    let direct = proof_for_goal_mut(ctx, goal)
    if direct >= 0 { return direct }
    let p = ctx_get_prop_mut(ctx, goal)
    if p.tag == 2 {
        let p1 = auto_prove(ctx, p.left_id, max_depth - 1)
        if p1 >= 0 {
            let p2 = auto_prove(ctx, p.right_id, max_depth - 1)
            if p2 >= 0 { return and_intro(ctx, p1, p2, goal) }
        }
    }
    if p.tag == 3 {
        let p1 = auto_prove(ctx, p.left_id, max_depth - 1)
        if p1 >= 0 { return or_intro_left(ctx, p1, goal) }
        let p2 = auto_prove(ctx, p.right_id, max_depth - 1)
        if p2 >= 0 { return or_intro_right(ctx, p2, goal) }
    }
    let mp = auto_try_mp(ctx, goal, max_depth)
    if mp >= 0 { return mp }
    if entails(ctx, goal) { return trusted(ctx, 700, goal) }
    return 0 - 1
}

fn run_tactic(ctx: &!ProofContext, goal: i64, tactic_id: i64) -> i64 with Mut, Div {
    if tactic_id == 1 { return auto_try_mp(ctx, goal, 4) }
    if tactic_id == 5 {
        if entails(ctx, goal) { return trusted(ctx, 805, goal) }
        return 0 - 1
    }
    return auto_prove(ctx, goal, 5)
}

pub fn tactic_or(ctx: &!ProofContext, goal: i64, tac1: i64, tac2: i64) -> i64 with Mut, Div {
    let p1 = run_tactic(ctx, goal, tac1)
    if p1 >= 0 { return p1 }
    return run_tactic(ctx, goal, tac2)
}

pub fn tactic_then(ctx: &!ProofContext, goal: i64, tac1_result: i64, tac2_fn_id: i64) -> i64 with Mut, Div {
    if tac1_result >= 0 {
        if prop_matches_mut(ctx, ctx_get_proof_mut(ctx, tac1_result).prop_id, goal) { return tac1_result }
    }
    return run_tactic(ctx, goal, tac2_fn_id)
}

fn main() -> i64 {
    return 0
}
