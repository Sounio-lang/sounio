    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_i256_step5_taylor2_flowpipe_obligation(),
        flowpipe_obligation_receipt_fp,
        flowpipe_obligation_audit_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_i256_step5_taylor2_flowpipe_obligation())
    if entry_fp != 500992858 { return 0 - 1 }

    let manifest_fp = solver_portfolio_manifest_v81_fingerprint(
        81, 85, 414316671, 220149970, 758491585, 797401729, 851175202,
        153536131, 713603491, 22667633, 380734589, entry_fp)
    if known_solver_portfolio_manifest_v81_valid(
        414316671, 220149970, 758491585, 797401729, 851175202, 153536131,
        713603491, 22667633, 380734589, entry_fp, manifest_fp) == 0 {
        return 0 - 1
    }
    return manifest_fp
}

