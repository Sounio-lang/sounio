//! stdlib/theorem/solver_novelty_readiness.sio
//!
//! Executable claim-discipline gate for solver novelty work.
//!
//! This module does not certify SAT/SMT/PB results. It records the minimum
//! evidence shape needed before a solver feature can move from "interesting
//! internal experiment" to "public novelty candidate".

pub fn solver_novelty_private_gate(
    feature_present: i64,
    focused_tests_green: i64,
    proof_profile_green: i64,
    scope_gate_green: i64) -> i64 {
    if feature_present != 1 { return 0 }
    if focused_tests_green != 1 { return 0 }
    if proof_profile_green != 1 { return 0 }
    if scope_gate_green != 1 { return 0 }
    return 1
}

pub fn solver_novelty_public_gate(
    private_gate_ok: i64,
    baseline_ablation_green: i64,
    external_benchmark_green: i64,
    independent_checker_green: i64,
    literature_review_green: i64,
    compiler_path_stable: i64,
    public_claim_mask: i64) -> i64 {
    if private_gate_ok != 1 { return 0 }
    if baseline_ablation_green != 1 { return 0 }
    if external_benchmark_green != 1 { return 0 }
    if independent_checker_green != 1 { return 0 }
    if literature_review_green != 1 { return 0 }
    if compiler_path_stable != 1 { return 0 }
    if public_claim_mask == 0 { return 0 }
    return 1
}

pub fn solver_novelty_level(
    private_gate_ok: i64,
    public_gate_ok: i64,
    external_benchmark_green: i64) -> i64 {
    if public_gate_ok == 1 {
        if external_benchmark_green == 1 { return 3 }
    }
    if private_gate_ok == 1 { return 2 }
    return 1
}

pub fn solver_novelty_readiness_fingerprint(
    private_gate_ok: i64,
    public_gate_ok: i64,
    current_level: i64,
    missing_mask: i64) -> i64 with Mut {
    var fp: i64 = 173
    fp = (fp * 16777619 + private_gate_ok + 11) % 1000000007
    fp = (fp * 16777619 + public_gate_ok + 13) % 1000000007
    fp = (fp * 16777619 + current_level + 17) % 1000000007
    fp = (fp * 16777619 + missing_mask + 19) % 1000000007
    return fp
}
