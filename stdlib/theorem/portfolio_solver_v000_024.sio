        portfolio_kind_lorenz_i256_trajectory(),
        instance_fp,
        trajectory5_manifest_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_i256_trajectory())
    if trajectory5_entry_fp != 626160047 { return 0 - 1 }

    let manifest_fp = solver_portfolio_manifest_v16_fingerprint(
        16, 20,
        53646245, 528026990, 301444501, 258927862,
        388915166, 900589789, 205040674, 580031260,
        973127057, 438043475, 887056435, 769531137,
        579271506, 252932879, 838301653, 755389732,
        521104746, 537394311, lorenz_i256_chain5_entry_fp,
        trajectory5_entry_fp)
    if known_solver_portfolio_manifest_v16_valid(
        53646245, 528026990, 301444501, 258927862,
        388915166, 900589789, 205040674, 580031260,
        973127057, 438043475, 887056435, 769531137,
        579271506, 252932879, 838301653, 755389732,
        521104746, 537394311, lorenz_i256_chain5_entry_fp,
        trajectory5_entry_fp, manifest_fp) == 0 { return 0 - 1 }

    return manifest_fp
}

