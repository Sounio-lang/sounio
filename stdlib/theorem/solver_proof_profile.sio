//! stdlib/theorem/solver_proof_profile.sio
//!
//! Shared proof-profile gates for solver-produced claims. The point is to keep
//! aggressive SAT/SMT/PB/Lorenz producers separate from the small acceptance
//! kernel: a solver result is not enough without an instance digest, proof
//! object, independent checker, kernel replay, and a scope gate.

pub fn solver_proof_format_family(proof_format: i64) -> i64 {
    if proof_format == 1 { return 1 } // DRAT
    if proof_format == 2 { return 1 } // LRAT
    if proof_format == 3 { return 1 } // FRAT
    if proof_format == 4 { return 2 } // VeriPB / CakePB-style PB
    if proof_format == 5 { return 3 } // Farkas / QF_LRA
    if proof_format == 6 { return 4 } // Sounio numeric receipt
    return 0
}

pub fn solver_domain_accepts_proof_format(
    solver_domain: i64,
    proof_format: i64) -> i64 {
    let family = solver_proof_format_family(proof_format)
    if solver_domain == 1 {
        if family == 1 { return 1 }
    }
    if solver_domain == 2 {
        if family == 2 { return 1 }
    }
    if solver_domain == 3 {
        if family == 3 { return 1 }
    }
    if solver_domain == 4 {
        if family == 4 { return 1 }
    }
    if solver_domain == 5 {
        if family > 0 { return 1 }
    }
    return 0
}

pub fn solver_proof_profile_acceptance_gate(
    solver_result: i64,
    solver_domain: i64,
    proof_format: i64,
    instance_digest_ok: i64,
    proof_object_present: i64,
    producer_trace_ok: i64,
    independent_checker_ok: i64,
    kernel_replay_ok: i64,
    scope_gate_ok: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64) -> i64 {
    if solver_result != 0 { return 0 }
    if solver_domain_accepts_proof_format(solver_domain, proof_format) != 1 { return 0 }
    if instance_digest_ok != 1 { return 0 }
    if proof_object_present != 1 { return 0 }
    if producer_trace_ok != 1 { return 0 }
    if independent_checker_ok != 1 { return 0 }
    if kernel_replay_ok != 1 { return 0 }
    if scope_gate_ok != 1 { return 0 }
    if public_claim_mask != 0 {
        if formal_theorem_ready != 1 { return 0 }
    }
    return 1
}

pub fn solver_proof_profile_claim_level(
    acceptance_ok: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64) -> i64 {
    if acceptance_ok != 1 { return 0 }
    if public_claim_mask != 0 {
        if formal_theorem_ready == 1 { return 3 }
        return 0
    }
    return 2
}

pub fn solver_proof_profile_unsat_acceptance(
    solver_domain: i64,
    proof_format: i64,
    instance_digest_ok: i64,
    proof_object_present: i64,
    independent_checker_ok: i64,
    kernel_replay_ok: i64,
    scope_gate_ok: i64) -> i64 {
    return solver_proof_profile_acceptance_gate(
        0,
        solver_domain,
        proof_format,
        instance_digest_ok,
        proof_object_present,
        1,
        independent_checker_ok,
        kernel_replay_ok,
        scope_gate_ok,
        0,
        0)
}

pub fn solver_proof_profile_lorenz_numeric_receipt_gate(
    instance_digest_ok: i64,
    proof_object_present: i64,
    independent_checker_ok: i64,
    kernel_replay_ok: i64,
    scope_gate_ok: i64,
    global_flowpipe_claim_mask: i64) -> i64 {
    return solver_proof_profile_acceptance_gate(
        0,
        4,
        6,
        instance_digest_ok,
        proof_object_present,
        1,
        independent_checker_ok,
        kernel_replay_ok,
        scope_gate_ok,
        0,
        global_flowpipe_claim_mask)
}

pub fn solver_proof_profile_receipt_check(
    sat_lrat_gate: i64,
    smt_farkas_gate: i64,
    pb_veripb_gate: i64,
    lorenz_numeric_gate: i64,
    solver_only_rejected: i64,
    public_without_formal_rejected: i64,
    profile_status: i64) -> i64 {
    if sat_lrat_gate != 1 { return 0 - 1 }
    if smt_farkas_gate != 1 { return 0 - 1 }
    if pb_veripb_gate != 1 { return 0 - 1 }
    if lorenz_numeric_gate != 1 { return 0 - 1 }
    if solver_only_rejected != 1 { return 0 - 1 }
    if public_without_formal_rejected != 1 { return 0 - 1 }
    if profile_status != 88 { return 0 - 1 }
    return 964210753
}

pub fn solver_proof_profile_audit_fingerprint(
    artifact_fp: i64,
    instance_fp: i64,
    certificate_fp: i64,
    sat_lrat_gate: i64,
    smt_farkas_gate: i64,
    pb_veripb_gate: i64,
    lorenz_numeric_gate: i64,
    solver_only_rejected: i64,
    public_without_formal_rejected: i64,
    accepted_profile_mask: i64,
    rejected_profile_mask: i64,
    formal_theorem_ready: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    profile_status: i64,
    ok_mask: i64) -> i64 {
    if artifact_fp != 964210753 { return 0 - 1 }
    if instance_fp != 710284936 { return 0 - 1 }
    if certificate_fp != 295748103 { return 0 - 1 }
    if sat_lrat_gate != 1 { return 0 - 1 }
    if smt_farkas_gate != 1 { return 0 - 1 }
    if pb_veripb_gate != 1 { return 0 - 1 }
    if lorenz_numeric_gate != 1 { return 0 - 1 }
    if solver_only_rejected != 1 { return 0 - 1 }
    if public_without_formal_rejected != 1 { return 0 - 1 }
    if accepted_profile_mask != 15 { return 0 - 1 }
    if rejected_profile_mask != 48 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if profile_status != 88 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    return 526184309
}
