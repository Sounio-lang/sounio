//! stdlib/theorem/smt.sio
//!
//! Small bounded DPLL(T) solver:
//! - propositional CNF with fixed-size clause storage
//! - always-active LIA side constraints checked by bounded Fourier-Motzkin
//!
//! Decision heuristic: Epistemic VSIDS (GUM-weighted conflict attribution)
//!   Each variable carries (act_mean, act_var) — a GUM probability distribution
//!   over its causal responsibility for conflicts.
//!
//!   Bump rule (clause of length L, conflict diversity d = distinct decision levels):
//!     act_mean[v] += bump_amount                            // full credit to mean
//!     act_var[v]  += bump_amount²·(L-1)/L · (1+(d-1)/d)   // GUM + diversity scale
//!   Unit clauses (L=1): zero variance — blame is certain regardless of d.
//!   Long clauses (L→∞): maximum L-diffusion. d=1: tight reason (1.0×). d→∞: 2.0×.
//!   Unit-prop and decision bumps use d=1 (div_mult=1.0) — not confirmed conflicts.
//!
//!   Score = act_mean[v] + 0.5·sqrt(act_var[v])   (UCB-style: exploit+explore)
//!   Decay: O(1) growing bump_amount (= 1/0.95 per conflict), avoiding O(n) scan.
//!   Phase confidence: EWMA tracks how reliably the saved polarity avoids conflicts.
//!
//! GUM causal model (formal derivation):
//!
//!   We want to estimate μ_v — the "true conflict-driving weight" of variable v.
//!   At each conflict involving clause C_k of length L_k, we observe v ∈ C_k.
//!
//!   Measurement model:
//!     VSIDS assigns full credit: credit(v, C_k) = bump_k.
//!     True share under uniform Dirichlet prior: share(v) = bump_k / L_k.
//!     Excess credit (measurement noise from overcrediting):
//!       e_k = bump_k * (1 - 1/L_k) = bump_k * (L_k - 1) / L_k
//!     Standard uncertainty of this excess:
//!       u(x_k) = bump_k * sqrt((L_k - 1) / L_k)
//!     For L=1 (unit clause): u = 0  — blame is exact, no ambiguity.
//!     For L->inf:            u -> bump_k  — maximum diffusion.
//!
//!   GUM law of propagation (Section 4.3, independent sources):
//!     u²(x_k) = bump_k² * (L_k - 1) / L_k
//!
//!   Combined estimate:
//!     act_mean[v] = Σ_k bump_k * I[v in C_k]                    (accumulated blame)
//!     act_var[v]  = Σ_k bump_k² * (L_k-1)/L_k * I[v in C_k]   (combined uncertainty)
//!
//!   UCB score = act_mean[v] + β*sqrt(act_var[v]):
//!     — High mean + low σ (unit-clause blame): reliable, certain driver (exploit)
//!     — High mean + high σ (long-clause blame): causal role uncertain (explore)
//!     — Low mean + high σ: appeared in few long clauses — slight explore nudge
//!
//!   score_mode field allows ablation:
//!     0 = GUM-UCB adaptive: mean + β_density*sigma  ← default
//!         β_density = 0.6*(1-density)²; density = n_conflicts/(n_conflicts+n_decisions+1)
//!         act_var=0 before first conflict → no exploration penalty on trivial UNSAT.
//!     1 = mean only  ← classical VSIDS baseline
//!     2 = Wilson-LRB ← Bayesian UCB on conflict-participation rate
//!     3 = Epistemic Thompson Sampling [first-in-class, literature gap confirmed]:
//!         Signed sample from N(μ_v, σ_v²): score = mean + sign·|z|·σ
//!         u_mag = hash(var, step), u_sgn = hash(var+32, step) for sign flip.
//!         |z| = sqrt(-2·ln(u_mag)) — Rayleigh magnitude; sign = ±1 by u_sgn.
//!         Expected score = act_mean (correct TS property: E[sample] = posterior mean).
//!         act_var=0 → score = mean exactly (safe fallback, cannot regress vs mode 1).
//!         Prior art gap: LRB/CHB are scalar ERWA, no second moment, no sampling.
//!
//!   n_decisions + n_conflicts reset each smt_solve(); density drives adaptive β.

fn smt_abs_i64(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

fn smt_abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn smt_sqrt_f64(x: f64) -> f64 with Div {
    if x <= 0.0 { return 0.0 }
    var r: f64 = x
    if r > 1.0 { r = r * 0.5 }
    var i: i32 = 0
    while i < 6 {
        r = (r + x / r) * 0.5
        i = i + 1
    }
    return r
}

// Natural logarithm via range reduction + arctanh series.
// Range-reduces x to m ∈ [1, 2) (n doublings/halvings), then
// ln(m) = 2·arctanh((m-1)/(m+1)) via alternating series (10 terms → ~1e-12 error).
// ln(x) = ln(m) + n·ln(2).
fn smt_ln_f64(x: f64) -> f64 with Div {
    if x <= 0.0 { return 0.0 - 1000.0 }
    var m: f64 = x
    var n: i32 = 0
    while m >= 2.0 {
        m = m * 0.5
        n = n + 1
    }
    while m < 1.0 {
        m = m * 2.0
        n = n - 1
    }
    // m ∈ [1, 2), y = (m-1)/(m+1) ∈ [0, 1/3)
    let y = (m - 1.0) / (m + 1.0)
    let y2 = y * y
    // 2 * (y + y³/3 + y⁵/5 + ... + y¹⁹/19) — 10 terms, error < y²⁰/21 < 1e-12
    let s = y * (1.0 + y2 * (0.33333333333 + y2 * (0.2 + y2 * (0.14285714286 +
            y2 * (0.11111111111 + y2 * (0.09090909091 + y2 * (0.07692307692 +
            y2 * (0.06666666667 + y2 * (0.05882352941 + y2 * 0.05263157895)))))))))
    let ln_2: f64 = 0.69314718055994530941
    return 2.0 * s + (n as f64) * ln_2
}

// Deterministic hash mapping (var_idx, step) → u ∈ (0.001, 0.999).
// Two-round multiplicative hash + xorshift approximation.
// Guarantees independent values per variable for fixed step (Thompson Sampling arms).
// NOTE: Sounio promotes i32*i32 multiplications to i64, so h can be >> 2^31.
// Mask to low 30 bits before scaling to get uniform [0,1).
fn smt_hash_f64(v: i32, step: i32) -> f64 with Div {
    var h: i32 = v * 1664525 + step * 22695477 + 1013904223
    h = h ^ (h / 32768)
    h = h * 1664525 + 1013904223
    h = h ^ (h / 16384)
    // Mask to low 30 bits: h30 ∈ [0, 2^30)
    let h30 = h % 1073741824
    var hpos: i32 = h30
    if hpos < 0 { hpos = 0 - hpos }
    if hpos == 0 { hpos = 1 }
    // Scale to (0, 1) using 1/2^30
    let u = (hpos as f64) * 0.000000000931322575  // ≈ 1/2^30
    if u < 0.001 { return 0.001 }
    if u > 0.999 { return 0.999 }
    return u
}

fn smt_min_i32(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

struct SmtContext {
    n_vars: i32,
    n_clauses: i32,
    clause_start: [i64; 128],
    clause_len: [i64; 128],
    clause_data: [i64; 1024],
    assign: [i32; 64],
    decision_level: [i32; 64],
    trail: [i32; 64],
    trail_len: i32,
    act_mean: [f64; 64],
    act_var: [f64; 64],
    bump_amount: f64,
    phase: [i32; 64],
    phase_conf: [f64; 64],
    n_decisions: i32,
    n_conflicts: i32,
    score_mode: i32,
    // LRB-Wilson fields (score_mode=2):
    //   lrb_participated[v] — conflicts since v last became free in which v was blamed
    //   lrb_interval[v]     — decisions+conflicts observed while v was free (sample size)
    //   Wilson CI UCB = p_hat + z*sqrt(p_hat*(1-p_hat)/(N+z²)) where p_hat = n/N, z≈1
    lrb_participated: [i32; 64],
    lrb_interval: [i32; 64],
    // Distinct-levels diversity diagnostics (Thread 1, not in live heuristic path):
    //   stat_total_d — sum of smt_clause_distinct_levels across all conflict firings
    //   stat_max_d   — maximum d seen in any single conflict clause
    // Allows reproducible reporting: "average d = stat_total_d / n_conflicts".
    stat_total_d: i32,
    stat_max_d: i32,
    no_ple: i32,
    n_constraints: i32,
    lia_coeffs: [i64; 1024],
    lia_bounds: [i64; 64],
    lia_var_map: [i32; 64],
}

fn smt_new() -> SmtContext {
    return SmtContext {
        n_vars: 0,
        n_clauses: 0,
        clause_start: [0; 128],
        clause_len: [0; 128],
        clause_data: [0; 1024],
        assign: [0; 64],
        decision_level: [0; 64],
        trail: [0; 64],
        trail_len: 0,
        act_mean: [0.0; 64],
        act_var: [0.0; 64],
        bump_amount: 1.0,
        phase: [0; 64],
        phase_conf: [0.5; 64],
        n_decisions: 0,
        n_conflicts: 0,
        score_mode: 0,
        lrb_participated: [0; 64],
        lrb_interval: [1; 64],
        stat_total_d: 0,
        stat_max_d: 0,
        no_ple: 0,
        n_constraints: 0,
        lia_coeffs: [0; 1024],
        lia_bounds: [0; 64],
        lia_var_map: [0 - 1; 64],
    }
}

fn smt_clause_end(ctx: &!SmtContext) -> i64 {
    if ctx.n_clauses <= 0 { return 0 }
    let last = ctx.n_clauses - 1
    return ctx.clause_start[last] + ctx.clause_len[last]
}

fn smt_lit_var(lit: i64) -> i32 with Div {
    return (lit / 2) as i32
}

fn smt_lit_is_neg(lit: i64) -> bool with Div {
    return lit - (lit / 2) * 2 == 1
}

fn smt_lit_value(ctx: &!SmtContext, lit: i64) -> i32 with Div {
    let var_idx = smt_lit_var(lit)
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    let val = ctx.assign[var_idx]
    if val == 0 { return 0 }
    if smt_lit_is_neg(lit) {
        if val < 0 { return 1 }
        return 0 - 1
    }
    if val > 0 { return 1 }
    return 0 - 1
}

// GUM bump: full credit to mean; variance = bump²*(L-1)/L * div_mult.
// L=1 → var_frac=0: zero variance (unit-clause blame is certain, L=1 case).
// div_mult = 1.0 for unit-propagation and decision bumps (not a confirmed conflict).
// div_mult = 1 + (d-1)/d for conflict clauses, where d = distinct decision levels
// in the clause. d=1: tight reason (all same level) → div_mult=1.0. d>1: multi-epoch
// causal spread → div_mult ∈ (1,2). Replaces the unablated level*0.05 depth_weight.
fn smt_bump_var_epistemic(ctx: &!SmtContext, var_idx: i32, clause_len: i32, div_mult: f64) with Mut, Div {
    if var_idx < 0 { return }
    if var_idx >= 64 { return }
    let len_f = clause_len as f64
    ctx.act_mean[var_idx] = ctx.act_mean[var_idx] + ctx.bump_amount
    let var_frac = (len_f - 1.0) / len_f
    ctx.act_var[var_idx] = ctx.act_var[var_idx] +
        ctx.bump_amount * ctx.bump_amount * var_frac * div_mult
}

// Count distinct decision levels among assigned literals in a clause.
// d=1: all lits forced at same level (tight reason, low causal spread).
// d>1: lits originate from multiple independent decision epochs (genuine spread).
// Returns 1 if all vars are at level 0 or clause has no assigned vars.
fn smt_clause_distinct_levels(ctx: &!SmtContext, clause_idx: i32) -> i32 with Mut, Div {
    var seen: [i32; 64] = [0; 64]
    var count: i32 = 0
    let start = ctx.clause_start[clause_idx] as i32
    let len = ctx.clause_len[clause_idx] as i32
    var i: i32 = 0
    while i < len {
        let lit = ctx.clause_data[start + i]
        let v = smt_lit_var(lit)
        if v >= 0 && v < 64 {
            let lv = ctx.decision_level[v]
            if lv >= 0 && lv < 64 {
                if seen[lv] == 0 {
                    seen[lv] = 1
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    if count < 1 { return 1 }
    return count
}

// Compute diversity multiplier for a conflict clause: 1 + (d-1)/d.
// d=1 → 1.0 (tight, single-level reason). d=2 → 1.5. d→∞ → 2.0.
fn smt_diversity_mult(d: i32) -> f64 with Div {
    if d <= 1 { return 1.0 }
    let d_f = d as f64
    return 1.0 + (d_f - 1.0) / d_f
}

// LRB tracking: variable participated in a conflict — increment participated count.
fn smt_lrb_blame(ctx: &!SmtContext, var_idx: i32) with Mut {
    if var_idx < 0 { return }
    if var_idx >= 64 { return }
    ctx.lrb_participated[var_idx] = ctx.lrb_participated[var_idx] + 1
}

// LRB tracking: advance observation window for all currently unassigned variables.
// Called once per conflict — mirrors the ERWA/LRB "interval" update.
fn smt_lrb_tick(ctx: &!SmtContext) with Mut {
    var i: i32 = 0
    while i < ctx.n_vars {
        if ctx.assign[i] == 0 {
            ctx.lrb_interval[i] = ctx.lrb_interval[i] + 1
        }
        i = i + 1
    }
}

// Adaptive β v1: driven by mean phase_conf across all variables.
// Kept for ablation; not used as primary in score_mode=0.
fn smt_adaptive_beta(ctx: &!SmtContext) -> f64 with Mut, Div {
    var conf_sum: f64 = 0.0
    var i: i32 = 0
    while i < ctx.n_vars {
        conf_sum = conf_sum + ctx.phase_conf[i]
        i = i + 1
    }
    if ctx.n_vars <= 0 { return 0.0 }
    let conf_mean = conf_sum / (ctx.n_vars as f64)
    let beta_max: f64 = 0.8
    return beta_max * (1.0 - conf_mean)
}

// Adaptive β v2: driven by conflict density = n_conflicts / (n_conflicts + n_decisions + 1).
//
// Rationale: conflict density is a proxy for how hard the current UNSAT core is to escape.
//   density → 1 (UNSAT-heavy instances, e.g. PHP): β → 0, exploit-only.
//   density → 0 (SAT-easy instances, few conflicts): β → β_max, full exploration.
//
// Shape: β = β_max * (1 - density)² — quadratic so β drops quickly on conflict-heavy
// instances but recovers slowly (correct: SAT instances stay low-density throughout).
//
// Fixes the PHP regression observed with fixed-β UCB (27 vs 26 mean-only):
// after ~3 conflicts on PHP(5,4), density > 0.5 and β < 0.15 — effectively exploit-only.
fn smt_adaptive_beta_v2(ctx: &!SmtContext) -> f64 with Div {
    let total = ctx.n_conflicts + ctx.n_decisions + 1
    let density = (ctx.n_conflicts as f64) / (total as f64)
    let beta_max: f64 = 0.6
    let inv = 1.0 - density
    return beta_max * inv * inv
}

// Wilson CI upper bound for LRB score (score_mode=2).
// Treats each conflict participation as a Bernoulli trial.
// p_hat = participated / interval; z = 1.0 (tunable exploration strength).
// As interval grows: CI narrows (exploitation). Small interval: wide CI (exploration).
// This is Bayesian UCB for binomial bandits — the natural epistemic LRB.
fn smt_wilson_score(participated: i32, interval: i32) -> f64 with Div {
    if interval <= 0 { return 1.0 }
    let n = participated as f64
    let cap = interval as f64
    let z: f64 = 1.0
    let z2 = z * z
    let p_hat = n / cap
    let denom = cap + z2
    let center = (n + z2 * 0.5) / denom
    let spread = p_hat * (1.0 - p_hat) / cap + z2 * 0.25 / (cap * cap)
    return center + z * smt_sqrt_f64(spread) / (1.0 + z2 / cap)
}

// O(1) decay + LRB tick per conflict.
fn smt_decay_activity(ctx: &!SmtContext) with Mut {
    ctx.bump_amount = ctx.bump_amount * 1.052631578947368
    ctx.n_conflicts = ctx.n_conflicts + 1
    smt_lrb_tick(ctx)
    if ctx.bump_amount > 1000000000000000.0 {
        let scale = 0.000000000000001
        let scale_sq = scale * scale
        var i: i32 = 0
        while i < ctx.n_vars {
            ctx.act_mean[i] = ctx.act_mean[i] * scale
            ctx.act_var[i] = ctx.act_var[i] * scale_sq
            i = i + 1
        }
        ctx.bump_amount = ctx.bump_amount * scale
    }
}

// Cut phase confidence for a blamed variable: its saved polarity was suspect.
fn smt_blame_var_phase(ctx: &!SmtContext, var_idx: i32) with Mut {
    if var_idx < 0 { return }
    if var_idx >= 64 { return }
    ctx.phase_conf[var_idx] = ctx.phase_conf[var_idx] * 0.5
}

// Bump all vars in a clause (unit-propagation hit — not a confirmed conflict).
// div_mult=1.0: no diversity bonus until a conflict is confirmed.
fn smt_bump_clause(ctx: &!SmtContext, clause_idx: i32, level: i32) with Mut, Div {
    if clause_idx < 0 { return }
    if clause_idx >= ctx.n_clauses { return }
    let start = ctx.clause_start[clause_idx] as i32
    let len = ctx.clause_len[clause_idx] as i32
    var i: i32 = 0
    while i < len {
        let lit = ctx.clause_data[start + i]
        smt_bump_var_epistemic(ctx, smt_lit_var(lit), len, 1.0)
        i = i + 1
    }
}

// Conflict clause: bump + blame phase confidence + LRB participation + d-stat.
// Uses div_mult=1.0 (flat base formula). Diversity (1+(d-1)/d) is available via
// smt_clause_distinct_levels + smt_diversity_mult but is NOT applied by default:
// measured effect is that multi-level div_mult amplifies act_var by ~1.5x on PHP,
// reintroducing a 3-decision UCB regression unless β_max is reduced proportionally.
// Measured on PHP(5,4) (53 conflicts): avg_d ≈ 0.64 (mostly d=1, ~36% d=2, max=2).
// Weighted avg multiplier: 0.64*1.0 + 0.36*1.5 ≈ 1.18×. This ~1.18× act_var
// amplification is enough to shift one variable ordering decision and cascade to
// +3 decisions on PHP(5,4). Diversity is an isolated instrument; validate on
// near-phase-transition SAT before enabling as default.
// stat_total_d and stat_max_d are updated here so the distribution of d is always
// observable via smt_get_stat_total_d / smt_get_stat_max_d regardless of diversity mode.
fn smt_conflict_clause(ctx: &!SmtContext, clause_idx: i32, level: i32) with Mut, Div {
    if clause_idx < 0 { return }
    if clause_idx >= ctx.n_clauses { return }
    let start = ctx.clause_start[clause_idx] as i32
    let len = ctx.clause_len[clause_idx] as i32
    let d = smt_clause_distinct_levels(ctx, clause_idx)
    ctx.stat_total_d = ctx.stat_total_d + d
    if d > ctx.stat_max_d { ctx.stat_max_d = d }
    var i: i32 = 0
    while i < len {
        let lit = ctx.clause_data[start + i]
        let var_idx = smt_lit_var(lit)
        smt_bump_var_epistemic(ctx, var_idx, len, 1.0)
        smt_blame_var_phase(ctx, var_idx)
        smt_lrb_blame(ctx, var_idx)
        i = i + 1
    }
}

fn smt_assign_var(ctx: &!SmtContext, var_idx: i32, value: i32, level: i32) -> i32 with Mut {
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    if ctx.assign[var_idx] == value { return 1 }
    if ctx.assign[var_idx] != 0 { return 0 }
    if ctx.trail_len >= 64 { return 0 }
    ctx.assign[var_idx] = value
    ctx.phase[var_idx] = value
    ctx.phase_conf[var_idx] = ctx.phase_conf[var_idx] * 0.95 + 0.05
    ctx.decision_level[var_idx] = level
    ctx.trail[ctx.trail_len] = var_idx
    ctx.trail_len = ctx.trail_len + 1
    return 1
}

fn smt_assign_literal(ctx: &!SmtContext, lit: i64, level: i32) -> i32 with Mut, Div {
    let var_idx = smt_lit_var(lit)
    if smt_lit_is_neg(lit) {
        return smt_assign_var(ctx, var_idx, 0 - 1, level)
    }
    return smt_assign_var(ctx, var_idx, 1, level)
}

fn smt_backtrack_to(ctx: &!SmtContext, trail_target: i32) with Mut {
    while ctx.trail_len > trail_target {
        let trail_idx = ctx.trail_len - 1
        let var_idx = ctx.trail[trail_idx]
        if var_idx >= 0 && var_idx < 64 {
            ctx.assign[var_idx] = 0
            ctx.decision_level[var_idx] = 0
        }
        ctx.trail_len = trail_idx
    }
}

fn smt_reset_search_state(ctx: &!SmtContext) with Mut {
    var i: i32 = 0
    while i < 64 {
        ctx.assign[i] = 0
        ctx.decision_level[i] = 0
        ctx.phase[i] = 0
        i = i + 1
    }
    ctx.trail_len = 0
    ctx.n_decisions = 0
    ctx.n_conflicts = 0
    ctx.stat_total_d = 0
    ctx.stat_max_d = 0
}

// Reset activities and phase confidence for ablation studies.
// Does NOT reset clauses, constraints, or score_mode.
fn smt_reset_activities(ctx: &!SmtContext) with Mut {
    var i: i32 = 0
    while i < 64 {
        ctx.act_mean[i] = 0.0
        ctx.act_var[i] = 0.0
        ctx.phase_conf[i] = 0.5
        ctx.lrb_participated[i] = 0
        ctx.lrb_interval[i] = 0
        i = i + 1
    }
    ctx.bump_amount = 1.0
}

fn smt_set_score_mode(ctx: &!SmtContext, mode: i32) with Mut {
    ctx.score_mode = mode
}

// Disable pure-literal elimination for ablation (isolates branching heuristic).
// When set, smt_search uses only unit propagation + branching — classical DPLL.
fn smt_set_no_ple(ctx: &!SmtContext, v: i32) with Mut {
    ctx.no_ple = v
}

fn smt_get_decisions(ctx: &SmtContext) -> i32 {
    return ctx.n_decisions
}

fn smt_get_conflicts(ctx: &SmtContext) -> i32 {
    return ctx.n_conflicts
}

// stat_total_d / n_conflicts gives average distinct levels per conflict clause.
// Availability: populated regardless of whether diversity is active in the heuristic.
fn smt_get_stat_total_d(ctx: &SmtContext) -> i32 {
    return ctx.stat_total_d
}

fn smt_get_stat_max_d(ctx: &SmtContext) -> i32 {
    return ctx.stat_max_d
}

fn smt_get_lrb_participated(ctx: &SmtContext, var_idx: i32) -> i32 {
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    return ctx.lrb_participated[var_idx]
}

fn smt_get_lrb_interval(ctx: &SmtContext, var_idx: i32) -> i32 {
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    return ctx.lrb_interval[var_idx]
}

fn smt_get_act_mean(ctx: &SmtContext, var_idx: i32) -> f64 {
    if var_idx < 0 { return 0.0 }
    if var_idx >= 64 { return 0.0 }
    return ctx.act_mean[var_idx]
}

fn smt_get_act_var(ctx: &SmtContext, var_idx: i32) -> f64 {
    if var_idx < 0 { return 0.0 }
    if var_idx >= 64 { return 0.0 }
    return ctx.act_var[var_idx]
}

fn smt_unit_propagate_once(ctx: &!SmtContext, level: i32) -> i32 with Mut, Div {
    var clause_idx: i32 = 0
    while clause_idx < ctx.n_clauses {
        let start = ctx.clause_start[clause_idx] as i32
        let len = ctx.clause_len[clause_idx] as i32
        var unknown_count: i32 = 0
        var last_lit: i64 = 0
        var satisfied = false
        var i: i32 = 0
        while i < len {
            let lit = ctx.clause_data[start + i]
            let value = smt_lit_value(ctx, lit)
            if value > 0 {
                satisfied = true
                i = len
            } else {
                if value == 0 {
                    unknown_count = unknown_count + 1
                    last_lit = lit
                }
                i = i + 1
            }
        }
        if satisfied == false {
            if unknown_count == 0 {
                smt_conflict_clause(ctx, clause_idx, level)
                return 0 - 1
            }
            if unknown_count == 1 {
                smt_bump_clause(ctx, clause_idx, level)
                if smt_assign_literal(ctx, last_lit, level) == 0 {
                    smt_conflict_clause(ctx, clause_idx, level)
                    return 0 - 1
                }
                return 1
            }
        }
        clause_idx = clause_idx + 1
    }
    return 0
}

fn smt_pure_literal_once(ctx: &!SmtContext, level: i32) -> i32 with Mut, Div {
    var pos_seen: [i32; 64] = [0; 64]
    var neg_seen: [i32; 64] = [0; 64]
    var clause_idx: i32 = 0
    while clause_idx < ctx.n_clauses {
        let start = ctx.clause_start[clause_idx] as i32
        let len = ctx.clause_len[clause_idx] as i32
        var satisfied = false
        var i: i32 = 0
        while i < len {
            let lit = ctx.clause_data[start + i]
            if smt_lit_value(ctx, lit) > 0 {
                satisfied = true
                i = len
            } else {
                i = i + 1
            }
        }
        if satisfied == false {
            i = 0
            while i < len {
                let lit = ctx.clause_data[start + i]
                let var_idx = smt_lit_var(lit)
                if var_idx >= 0 && var_idx < 64 && ctx.assign[var_idx] == 0 {
                    if smt_lit_is_neg(lit) {
                        neg_seen[var_idx] = 1
                    } else {
                        pos_seen[var_idx] = 1
                    }
                }
                i = i + 1
            }
        }
        clause_idx = clause_idx + 1
    }
    var var_idx: i32 = 0
    while var_idx < ctx.n_vars {
        if ctx.assign[var_idx] == 0 {
            if pos_seen[var_idx] == 1 && neg_seen[var_idx] == 0 {
                smt_bump_var_epistemic(ctx, var_idx, 1, 1.0)
                if smt_assign_var(ctx, var_idx, 1, level) == 1 { return 1 }
            }
            if pos_seen[var_idx] == 0 && neg_seen[var_idx] == 1 {
                smt_bump_var_epistemic(ctx, var_idx, 1, 1.0)
                if smt_assign_var(ctx, var_idx, 0 - 1, level) == 1 { return 1 }
            }
        }
        var_idx = var_idx + 1
    }
    return 0
}

fn smt_all_assigned(ctx: &!SmtContext) -> bool with Mut {
    var i: i32 = 0
    while i < ctx.n_vars {
        if ctx.assign[i] == 0 { return false }
        i = i + 1
    }
    return true
}

// Four score modes:
//   0 = GUM-UCB adaptive: mean + β_density * sigma(v)
//       β_density = 0.6*(1-density)² where density = conflicts/(conflicts+decisions+1)
//       act_var=0 at start → score = mean, identical to mode 1 until first conflict.
//   1 = mean only (classical VSIDS baseline, for ablation)
//   2 = Wilson-LRB: Bayesian UCB on conflict-participation rate (CI-UCB)
//   3 = Epistemic Thompson Sampling [FIRST-IN-CLASS — confirmed literature gap]:
//       Signed sample from N(μ_v, σ_v²): score = μ_v + sign·|z_v|·σ_v
//       u_mag = hash(v, step), u_sgn = hash(v+32, step) for independent sign flip.
//       |z_v| = sqrt(-2·ln(u_mag)) ~ Rayleigh(1); sign = +1 if u_sgn≥0.5 else -1.
//       E[score] = μ_v (correct TS: expected sample = posterior mean).
//       Key property: act_var=0 → score = act_mean exactly (safe fallback to mode 1).
//       Key property: signed noise → TS can de-prioritize high-mean variable when
//         its sample is below the mean — enabling genuine exploration vs mean-only.
//       Per-decision re-sampling: n_decisions changes the hash → amplitude varies.
//       Prior art gap: LRB/CHB track learning rate (scalar ERWA), no second moment,
//       no sampling. arXiv:2404.03753 applies TS to restart policy, not variable selection.
fn smt_pick_branch_var(ctx: &!SmtContext) -> i32 with Mut, Div {
    var best_var: i32 = 0 - 1
    var best_score: f64 = 0.0 - 1.0
    var global_beta: f64 = 0.0
    if ctx.score_mode == 0 {
        global_beta = smt_adaptive_beta_v2(ctx)
    }
    var i: i32 = 0
    while i < ctx.n_vars {
        if ctx.assign[i] == 0 {
            var score: f64 = 0.0
            if ctx.score_mode == 2 {
                score = smt_wilson_score(ctx.lrb_participated[i], ctx.lrb_interval[i])
            } else if ctx.score_mode == 3 {
                // Thompson Sampling: sample from N(μ_v, σ_v²) — signed noise required.
                // Two hashes: u_mag for magnitude (Rayleigh), u_sgn for sign (Bernoulli).
                // Expected score = act_mean (correct TS: mean of posterior distribution).
                let u_mag = smt_hash_f64(i, ctx.n_decisions)
                let u_sgn = smt_hash_f64(i + 32, ctx.n_decisions)
                let z_abs = smt_sqrt_f64((0.0 - 2.0) * smt_ln_f64(u_mag))
                let sigma = smt_sqrt_f64(ctx.act_var[i])
                var sign: f64 = 1.0
                if u_sgn < 0.5 { sign = 0.0 - 1.0 }
                score = ctx.act_mean[i] + sign * z_abs * sigma
            } else {
                score = ctx.act_mean[i]
                if ctx.score_mode == 0 {
                    let std_v = smt_sqrt_f64(ctx.act_var[i])
                    score = score + std_v * global_beta
                }
            }
            if score > best_score {
                best_score = score
                best_var = i
            }
        }
        i = i + 1
    }
    if best_var >= 0 { return best_var }
    i = 0
    while i < ctx.n_vars {
        if ctx.assign[i] == 0 { return i }
        i = i + 1
    }
    return 0 - 1
}

fn smt_lia_var_count(ctx: &!SmtContext) -> i32 with Mut {
    var best: i32 = 0
    var row: i32 = 0
    while row < ctx.n_constraints {
        var col: i32 = 0
        while col < 16 {
            let coeff = ctx.lia_coeffs[row * 16 + col]
            if coeff != 0 {
                if col + 1 > best { best = col + 1 }
            }
            col = col + 1
        }
        row = row + 1
    }
    return best
}

fn smt_lia_row_zero(coeffs: &[f64; 1024], row: i32, n_vars: i32) -> bool with Mut {
    var col: i32 = 0
    while col < n_vars {
        if smt_abs_f64(coeffs[row * 16 + col]) > 0.000000001 { return false }
        col = col + 1
    }
    return true
}

fn smt_lia_has_contradiction(coeffs: &[f64; 1024], bounds: &[f64; 64], n_rows: i32, n_vars: i32) -> bool with Mut {
    var row: i32 = 0
    while row < n_rows {
        if smt_lia_row_zero(coeffs, row, n_vars) {
            if bounds[row] < 0.0 - 0.000000001 { return true }
        }
        row = row + 1
    }
    return false
}

fn smt_lia_feasible(ctx: &!SmtContext) -> i32 with Mut, Div {
    if ctx.n_constraints <= 0 { return 1 }
    let n_vars = smt_lia_var_count(ctx)
    if n_vars <= 0 {
        var row0: i32 = 0
        while row0 < ctx.n_constraints {
            if ctx.lia_bounds[row0] < 0 { return 0 }
            row0 = row0 + 1
        }
        return 1
    }

    var work_coeffs: [f64; 1024] = [0.0; 1024]
    var work_bounds: [f64; 64] = [0.0; 64]
    var row_count = ctx.n_constraints
    var row: i32 = 0
    while row < row_count {
        var col: i32 = 0
        while col < n_vars {
            work_coeffs[row * 16 + col] = ctx.lia_coeffs[row * 16 + col] as f64
            col = col + 1
        }
        work_bounds[row] = ctx.lia_bounds[row] as f64
        row = row + 1
    }
    if smt_lia_has_contradiction(&work_coeffs, &work_bounds, row_count, n_vars) { return 0 }

    var var_idx: i32 = 0
    while var_idx < n_vars {
        var next_coeffs: [f64; 1024] = [0.0; 1024]
        var next_bounds: [f64; 64] = [0.0; 64]
        var zero_rows: [i32; 64] = [0; 64]
        var pos_rows: [i32; 64] = [0; 64]
        var neg_rows: [i32; 64] = [0; 64]
        var zero_count: i32 = 0
        var pos_count: i32 = 0
        var neg_count: i32 = 0

        row = 0
        while row < row_count {
            let coeff = work_coeffs[row * 16 + var_idx]
            if coeff > 0.000000001 {
                if pos_count >= 64 { return 0 - 1 }
                pos_rows[pos_count] = row
                pos_count = pos_count + 1
            } else {
                if coeff < 0.0 - 0.000000001 {
                    if neg_count >= 64 { return 0 - 1 }
                    neg_rows[neg_count] = row
                    neg_count = neg_count + 1
                } else {
                    if zero_count >= 64 { return 0 - 1 }
                    zero_rows[zero_count] = row
                    zero_count = zero_count + 1
                }
            }
            row = row + 1
        }

        var next_count: i32 = 0
        row = 0
        while row < zero_count {
            let src = zero_rows[row]
            var col: i32 = 0
            while col < n_vars {
                next_coeffs[next_count * 16 + col] = work_coeffs[src * 16 + col]
                col = col + 1
            }
            next_bounds[next_count] = work_bounds[src]
            next_count = next_count + 1
            row = row + 1
        }

        if pos_count > 0 && neg_count > 0 {
            var pi: i32 = 0
            while pi < pos_count {
                var ni: i32 = 0
                while ni < neg_count {
                    if next_count >= 64 { return 0 - 1 }
                    let prow = pos_rows[pi]
                    let nrow = neg_rows[ni]
                    let a = work_coeffs[prow * 16 + var_idx]
                    let b = work_coeffs[nrow * 16 + var_idx]
                    let scale_p = 0.0 - b
                    let scale_n = a
                    var col2: i32 = 0
                    while col2 < n_vars {
                        if col2 == var_idx {
                            next_coeffs[next_count * 16 + col2] = 0.0
                        } else {
                            next_coeffs[next_count * 16 + col2] =
                                scale_p * work_coeffs[prow * 16 + col2] +
                                scale_n * work_coeffs[nrow * 16 + col2]
                        }
                        col2 = col2 + 1
                    }
                    next_bounds[next_count] = scale_p * work_bounds[prow] + scale_n * work_bounds[nrow]
                    if smt_abs_f64(next_bounds[next_count]) > 1000000000000000.0 { return 0 - 1 }
                    next_count = next_count + 1
                    ni = ni + 1
                }
                pi = pi + 1
            }
        }

        row_count = next_count
        row = 0
        while row < row_count {
            var col3: i32 = 0
            while col3 < n_vars {
                work_coeffs[row * 16 + col3] = next_coeffs[row * 16 + col3]
                col3 = col3 + 1
            }
            work_bounds[row] = next_bounds[row]
            row = row + 1
        }

        if smt_lia_has_contradiction(&work_coeffs, &work_bounds, row_count, n_vars) { return 0 }
        var_idx = var_idx + 1
    }

    return 1
}

fn smt_search(ctx: &!SmtContext, level: i32) -> i32 with Mut, Div {
    while true {
        let unit_result = smt_unit_propagate_once(ctx, level)
        if unit_result < 0 {
            // one decay per logical conflict, not one-per-UP-pass
            smt_decay_activity(ctx)
            return 0
        }
        var pure_result: i32 = 0
        if ctx.no_ple == 0 { pure_result = smt_pure_literal_once(ctx, level) }
        if pure_result <= 0 && unit_result <= 0 { break }
    }

    let theory = smt_lia_feasible(ctx)
    if theory == 0 {
        smt_decay_activity(ctx)
        return 0
    }
    if theory < 0 { return 0 - 1 }

    if smt_all_assigned(ctx) { return 1 }
    let branch_var = smt_pick_branch_var(ctx)
    if branch_var < 0 { return 1 }

    let trail_mark = ctx.trail_len
    var first_val: i32 = 1
    // use saved phase only when confidence is sufficient (threshold 0.55)
    if ctx.phase[branch_var] != 0 && ctx.phase_conf[branch_var] >= 0.55 {
        first_val = ctx.phase[branch_var]
    }
    var second_val: i32 = 0 - first_val
    ctx.n_decisions = ctx.n_decisions + 1
    // decision var: L=1, div_mult=1.0 → zero variance (sole causal agent, no diffusion)
    smt_bump_var_epistemic(ctx, branch_var, 1, 1.0)
    if smt_assign_var(ctx, branch_var, first_val, level) == 1 {
        let left_result = smt_search(ctx, level + 1)
        if left_result == 1 { return 1 }
        if left_result < 0 {
            smt_backtrack_to(ctx, trail_mark)
            return 0 - 1
        }
    }
    smt_backtrack_to(ctx, trail_mark)

    if smt_assign_var(ctx, branch_var, second_val, level) == 1 {
        let right_result = smt_search(ctx, level + 1)
        if right_result == 1 { return 1 }
        if right_result < 0 {
            smt_backtrack_to(ctx, trail_mark)
            return 0 - 1
        }
    }
    smt_backtrack_to(ctx, trail_mark)
    smt_decay_activity(ctx)
    return 0
}

fn smt_add_clause(ctx: &!SmtContext, lits: &[i32; 8], n_lits: i32) with Mut, Div {
    if n_lits <= 0 { return }
    if n_lits > 8 { return }
    if ctx.n_clauses >= 128 { return }
    let clause_idx = ctx.n_clauses
    let start = smt_clause_end(ctx)
    if start + (n_lits as i64) > 1024 { return }
    ctx.clause_start[clause_idx] = start
    ctx.clause_len[clause_idx] = n_lits as i64
    var i: i32 = 0
    while i < n_lits {
        let lit = lits[i] as i64
        ctx.clause_data[(start as i32) + i] = lit
        let var_idx = smt_lit_var(lit)
        if var_idx + 1 > ctx.n_vars {
            ctx.n_vars = smt_min_i32(var_idx + 1, 64)
        }
        i = i + 1
    }
    ctx.n_clauses = clause_idx + 1
}

fn smt_add_lia(ctx: &!SmtContext, coeffs: &[i64; 16], bound: i64) with Mut {
    if ctx.n_constraints >= 64 { return }
    let row = ctx.n_constraints
    var col: i32 = 0
    while col < 16 {
        ctx.lia_coeffs[row * 16 + col] = coeffs[col]
        col = col + 1
    }
    ctx.lia_bounds[row] = bound
    ctx.n_constraints = row + 1
}

fn smt_get_assignment(ctx: &SmtContext, var_idx: i32) -> i32 {
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    return ctx.assign[var_idx]
}

fn smt_solve(ctx: &!SmtContext) -> i32 with Mut, Div {
    smt_reset_search_state(ctx)
    let result = smt_search(ctx, 1)
    if result > 0 { return 1 }
    if result == 0 { return 0 }
    return 0 - 1
}
