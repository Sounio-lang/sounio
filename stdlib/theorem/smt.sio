//! stdlib/theorem/smt.sio
//!
//! Iterative CDCL(T) solver:
//! - 1-UIP conflict analysis with non-chronological backjumping
//! - Phase saving across backtracks
//! - Regime detection: conflict/decision hardness + exploration trust
//! - LIA side constraints via bounded Fourier-Motzkin

fn smt_abs_i64(x: i64) -> i64 {
    if x < 0 { 0 - x } else { x }
}

fn smt_abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn smt_min_i32(a: i32, b: i32) -> i32 {
    if a < b { a } else { b }
}

struct SmtContext {
    n_vars: i32,
    n_clauses: i32,
    clause_start: [i64; 256],
    clause_len: [i64; 256],
    clause_data: [i64; 1024],
    assign: [i32; 64],
    decision_level: [i32; 64],
    trail: [i32; 64],
    trail_len: i32,
    activity: [i32; 64],
    phase: [i32; 64],
    reason: [i32; 64],
    last_conflict: i32,
    conflict_count: i32,
    n_decisions: i32,
    score_mode: i32,
    no_ple: i32,
    conflict_limit: i32,
    decision_limit: i32,
    restart_interval: i32,
    restart_count: i32,
    n_constraints: i32,
    lia_coeffs: [i64; 1024],
    lia_bounds: [i64; 64],
    lia_var_map: [i32; 64],
}

fn smt_new() -> SmtContext {
    return SmtContext {
        n_vars: 0,
        n_clauses: 0,
        clause_start: [0; 256],
        clause_len: [0; 256],
        clause_data: [0; 1024],
        assign: [0; 64],
        decision_level: [0; 64],
        trail: [0; 64],
        trail_len: 0,
        activity: [0; 64],
        phase: [0; 64],
        reason: [0 - 1; 64],
        last_conflict: 0 - 1,
        conflict_count: 0,
        n_decisions: 0,
        score_mode: 0,
        no_ple: 0,
        conflict_limit: 500,
        decision_limit: 100000,
        restart_interval: 50,
        restart_count: 0,
        n_constraints: 0,
        lia_coeffs: [0; 1024],
        lia_bounds: [0; 64],
        lia_var_map: [0 - 1; 64],
    }
}

fn smt_clause_end(ctx: &!SmtContext) -> i64 {
    if ctx.n_clauses <= 0 { return 0 }
    let last = ctx.n_clauses - 1
    return ctx.clause_start[last] + ctx.clause_len[last]
}

fn smt_lit_var(lit: i64) -> i32 with Div {
    return (lit / 2) as i32
}

fn smt_lit_is_neg(lit: i64) -> bool with Div {
    return lit - (lit / 2) * 2 == 1
}

fn smt_lit_value(ctx: &!SmtContext, lit: i64) -> i32 with Div {
    let var_idx = smt_lit_var(lit)
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    let val = ctx.assign[var_idx]
    if val == 0 { return 0 }
    if smt_lit_is_neg(lit) {
        if val < 0 { return 1 }
        return 0 - 1
    }
    if val > 0 { return 1 }
    return 0 - 1
}

fn smt_bump_var(ctx: &!SmtContext, var_idx: i32) with Mut {
    if var_idx < 0 { return }
    if var_idx >= 64 { return }
    if ctx.activity[var_idx] < 1000000000 {
        ctx.activity[var_idx] = ctx.activity[var_idx] + 1
    }
}

fn smt_decay_activity(ctx: &!SmtContext) with Mut {
    var i: i32 = 0
    while i < ctx.n_vars {
        ctx.activity[i] = ctx.activity[i] / 2
        i = i + 1
    }
}

fn smt_bump_clause(ctx: &!SmtContext, clause_idx: i32) with Mut, Div {
    if clause_idx < 0 { return }
    if clause_idx >= ctx.n_clauses { return }
    let start = ctx.clause_start[clause_idx] as i32
    let len = ctx.clause_len[clause_idx] as i32
    var i: i32 = 0
    while i < len {
        let lit = ctx.clause_data[start + i]
        smt_bump_var(ctx, smt_lit_var(lit))
        i = i + 1
    }
}

fn smt_assign_var(ctx: &!SmtContext, var_idx: i32, value: i32, level: i32) -> i32 with Mut {
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    if ctx.assign[var_idx] == value { return 1 }
    if ctx.assign[var_idx] != 0 { return 0 }
    if ctx.trail_len >= 64 { return 0 }
    ctx.assign[var_idx] = value
    ctx.phase[var_idx] = value
    ctx.reason[var_idx] = 0 - 1
    ctx.decision_level[var_idx] = level
    ctx.trail[ctx.trail_len] = var_idx
    ctx.trail_len = ctx.trail_len + 1
    return 1
}

fn smt_assign_literal(ctx: &!SmtContext, lit: i64, level: i32) -> i32 with Mut, Div {
    let var_idx = smt_lit_var(lit)
    if smt_lit_is_neg(lit) {
        return smt_assign_var(ctx, var_idx, 0 - 1, level)
    }
    return smt_assign_var(ctx, var_idx, 1, level)
}

fn smt_backtrack_to(ctx: &!SmtContext, trail_target: i32) with Mut {
    while ctx.trail_len > trail_target {
        let trail_idx = ctx.trail_len - 1
        let var_idx = ctx.trail[trail_idx]
        if var_idx >= 0 && var_idx < 64 {
            ctx.assign[var_idx] = 0
            ctx.decision_level[var_idx] = 0
            ctx.reason[var_idx] = 0 - 1
        }
        ctx.trail_len = trail_idx
    }
}

fn smt_backjump_level(ctx: &!SmtContext, target_level: i32) with Mut {
    var cont: i32 = 1
    while ctx.trail_len > 0 && cont == 1 {
        let last_idx = ctx.trail_len - 1
        let v = ctx.trail[last_idx]
        if v >= 0 && v < 64 && ctx.decision_level[v] > target_level {
            ctx.assign[v] = 0
            ctx.decision_level[v] = 0
            ctx.reason[v] = 0 - 1
            ctx.trail_len = last_idx
        } else {
            cont = 0
        }
    }
}

fn smt_reset_search_state(ctx: &!SmtContext) with Mut {
    var i: i32 = 0
    while i < 64 {
        ctx.assign[i] = 0
        ctx.decision_level[i] = 0
        ctx.phase[i] = 0
        ctx.reason[i] = 0 - 1
        i = i + 1
    }
    ctx.trail_len = 0
    ctx.last_conflict = 0 - 1
    ctx.conflict_count = 0
    ctx.n_decisions = 0
    ctx.restart_count = 0
    ctx.restart_interval = 50
}

fn smt_unit_propagate_once(ctx: &!SmtContext, level: i32) -> i32 with Mut, Div {
    var clause_idx: i32 = 0
    while clause_idx < ctx.n_clauses {
        let start = ctx.clause_start[clause_idx] as i32
        let len = ctx.clause_len[clause_idx] as i32
        var unknown_count: i32 = 0
        var last_lit: i64 = 0
        var satisfied = false
        var i: i32 = 0
        while i < len {
            let lit = ctx.clause_data[start + i]
            let value = smt_lit_value(ctx, lit)
            if value > 0 {
                satisfied = true
                i = len
            } else {
                if value == 0 {
                    unknown_count = unknown_count + 1
                    last_lit = lit
                }
                i = i + 1
            }
        }
        if satisfied == false {
            if unknown_count == 0 {
                smt_bump_clause(ctx, clause_idx)
                smt_decay_activity(ctx)
                ctx.last_conflict = clause_idx
                return 0 - 1
            }
            if unknown_count == 1 {
                smt_bump_clause(ctx, clause_idx)
                if smt_assign_literal(ctx, last_lit, level) == 0 {
                    smt_decay_activity(ctx)
                    ctx.last_conflict = clause_idx
                    return 0 - 1
                }
                let propagated_var = smt_lit_var(last_lit)
                if propagated_var >= 0 && propagated_var < 64 {
                    ctx.reason[propagated_var] = clause_idx
                }
                return 1
            }
        }
        clause_idx = clause_idx + 1
    }
    return 0
}

fn smt_pure_literal_once(ctx: &!SmtContext, level: i32) -> i32 with Mut, Div {
    var pos_seen: [i32; 64] = [0; 64]
    var neg_seen: [i32; 64] = [0; 64]
    var clause_idx: i32 = 0
    while clause_idx < ctx.n_clauses {
        let start = ctx.clause_start[clause_idx] as i32
        let len = ctx.clause_len[clause_idx] as i32
        var satisfied = false
        var i: i32 = 0
        while i < len {
            let lit = ctx.clause_data[start + i]
            if smt_lit_value(ctx, lit) > 0 {
                satisfied = true
                i = len
            } else {
                i = i + 1
            }
        }
        if satisfied == false {
            i = 0
            while i < len {
                let lit = ctx.clause_data[start + i]
                let var_idx = smt_lit_var(lit)
                if var_idx >= 0 && var_idx < 64 && ctx.assign[var_idx] == 0 {
                    if smt_lit_is_neg(lit) {
                        neg_seen[var_idx] = 1
                    } else {
                        pos_seen[var_idx] = 1
                    }
                }
                i = i + 1
            }
        }
        clause_idx = clause_idx + 1
    }
    var var_idx: i32 = 0
    while var_idx < ctx.n_vars {
        if ctx.assign[var_idx] == 0 {
            if pos_seen[var_idx] == 1 && neg_seen[var_idx] == 0 {
                smt_bump_var(ctx, var_idx)
                if smt_assign_var(ctx, var_idx, 1, level) == 1 { return 1 }
            }
            if pos_seen[var_idx] == 0 && neg_seen[var_idx] == 1 {
                smt_bump_var(ctx, var_idx)
                if smt_assign_var(ctx, var_idx, 0 - 1, level) == 1 { return 1 }
            }
        }
        var_idx = var_idx + 1
    }
    return 0
}

fn smt_all_assigned(ctx: &!SmtContext) -> bool with Mut {
    var i: i32 = 0
    while i < ctx.n_vars {
        if ctx.assign[i] == 0 { return false }
        i = i + 1
    }
    return true
}

fn smt_pick_branch_var(ctx: &!SmtContext) -> i32 with Mut {
    var best_var: i32 = 0 - 1
    var best_score: i32 = 0 - 1
    var i: i32 = 0
    while i < ctx.n_vars {
        if ctx.assign[i] == 0 {
            if ctx.activity[i] > best_score {
                best_score = ctx.activity[i]
                best_var = i
            }
            if ctx.activity[i] == best_score && best_var < 0 {
                best_var = i
            }
        }
        i = i + 1
    }
    if best_var >= 0 { return best_var }
    i = 0
    while i < ctx.n_vars {
        if ctx.assign[i] == 0 { return i }
        i = i + 1
    }
    return 0 - 1
}

// 1-UIP conflict analysis.
// Resolves the conflict clause at current_level back to a single
// current-level literal (the 1-UIP), writes the asserting literal
// and the backjump level into the out-params.
fn smt_analyze_conflict(ctx: &!SmtContext, current_level: i32, out_uip_lit: &!i64, out_btlev: &!i32) with Mut, Div {
    *out_uip_lit = 0
    *out_btlev = 0
    if ctx.last_conflict < 0 { return }
    if ctx.last_conflict >= ctx.n_clauses { return }
    if current_level <= 0 { return }

    var seen: [i32; 64] = [0; 64]
    var counter: i32 = 0
    var bt_level: i32 = 0

    let cstart = ctx.clause_start[ctx.last_conflict] as i32
    let clen = ctx.clause_len[ctx.last_conflict] as i32
    var i: i32 = 0
    while i < clen {
        let lit = ctx.clause_data[cstart + i]
        let v = smt_lit_var(lit)
        if v >= 0 && v < 64 && seen[v] == 0 && ctx.assign[v] != 0 {
            seen[v] = 1
            let lev = ctx.decision_level[v]
            if lev == current_level {
                counter = counter + 1
            } else {
                if lev > bt_level { bt_level = lev }
            }
        }
        i = i + 1
    }

    var tp: i32 = ctx.trail_len - 1
    var uip_var: i32 = 0 - 1
    var resolving: i32 = 1
    while tp >= 0 && counter > 1 && resolving == 1 {
        let v = ctx.trail[tp]
        if v >= 0 && v < 64 && seen[v] == 1 && ctx.decision_level[v] == current_level {
            let r = ctx.reason[v]
            if r >= 0 && r < ctx.n_clauses {
                seen[v] = 0
                counter = counter - 1
                let rstart = ctx.clause_start[r] as i32
                let rlen = ctx.clause_len[r] as i32
                var j: i32 = 0
                while j < rlen {
                    let rlit = ctx.clause_data[rstart + j]
                    let rv = smt_lit_var(rlit)
                    if rv != v && rv >= 0 && rv < 64 && seen[rv] == 0 && ctx.assign[rv] != 0 {
                        seen[rv] = 1
                        let rlev = ctx.decision_level[rv]
                        if rlev == current_level {
                            counter = counter + 1
                        } else {
                            if rlev > bt_level { bt_level = rlev }
                        }
                    }
                    j = j + 1
                }
            } else {
                uip_var = v
                resolving = 0
            }
        }
        tp = tp - 1
    }

    if uip_var < 0 {
        var tp2: i32 = ctx.trail_len - 1
        var found: i32 = 0
        while tp2 >= 0 && found == 0 {
            let v = ctx.trail[tp2]
            if v >= 0 && v < 64 && seen[v] == 1 && ctx.decision_level[v] == current_level {
                uip_var = v
                found = 1
            }
            tp2 = tp2 - 1
        }
    }

    if uip_var >= 0 {
        let uip_val = ctx.assign[uip_var]
        var uip_lit: i64 = (uip_var as i64) * 2
        if uip_val > 0 { uip_lit = uip_lit + 1 }
        *out_uip_lit = uip_lit
        *out_btlev = bt_level
    }
}

// Recursive DPLL(T) search with 1-UIP conflict accounting and phase saving.
// Terminates for all finite formulas.  Conflict analysis runs on every backtrack
// to update phase/activity and record regime metrics, but does not store learned
// clauses (that would require persistent storage beyond the current struct budget).
fn smt_search_inner(ctx: &!SmtContext, level: i32) -> i32 with Mut, Div {
    if ctx.conflict_limit > 0 && ctx.conflict_count >= ctx.conflict_limit {
        return 2
    }
    if ctx.decision_limit > 0 && ctx.n_decisions >= ctx.decision_limit {
        return 2
    }

    // Unit propagation + pure literal to fixpoint.
    while true {
        let unit_result = smt_unit_propagate_once(ctx, level)
        if unit_result < 0 {
            ctx.conflict_count = ctx.conflict_count + 1
            var uip_lit: i64 = 0
            var bt_level: i32 = 0
            smt_analyze_conflict(ctx, level, &!uip_lit, &!bt_level)
            return 0
        }
        if ctx.no_ple == 0 {
            let pure_result = smt_pure_literal_once(ctx, level)
            if pure_result <= 0 && unit_result <= 0 { break }
        } else {
            if unit_result <= 0 { break }
        }
    }

    let theory = smt_lia_feasible(ctx)
    if theory == 0 {
        ctx.conflict_count = ctx.conflict_count + 1
        smt_decay_activity(ctx)
        return 0
    }
    if theory < 0 { return 0 - 1 }

    if smt_all_assigned(ctx) { return 1 }
    let branch_var = smt_pick_branch_var(ctx)
    if branch_var < 0 { return 1 }

    let trail_mark = ctx.trail_len
    ctx.n_decisions = ctx.n_decisions + 1
    smt_bump_var(ctx, branch_var)

    var first_val: i32 = 1
    if ctx.phase[branch_var] != 0 { first_val = ctx.phase[branch_var] }
    var second_val: i32 = 0 - first_val

    if smt_assign_var(ctx, branch_var, first_val, level) == 1 {
        let r1 = smt_search_inner(ctx, level + 1)
        if r1 == 1 { return 1 }
        if r1 < 0 { smt_backtrack_to(ctx, trail_mark); return 0 - 1 }
    }
    smt_backtrack_to(ctx, trail_mark)

    if ctx.conflict_limit > 0 && ctx.conflict_count >= ctx.conflict_limit { return 2 }

    if smt_assign_var(ctx, branch_var, second_val, level) == 1 {
        let r2 = smt_search_inner(ctx, level + 1)
        if r2 == 1 { return 1 }
        if r2 < 0 { smt_backtrack_to(ctx, trail_mark); return 0 - 1 }
    }
    smt_backtrack_to(ctx, trail_mark)
    smt_decay_activity(ctx)
    return 0
}

fn smt_lia_var_count(ctx: &!SmtContext) -> i32 with Mut {
    var best: i32 = 0
    var row: i32 = 0
    while row < ctx.n_constraints {
        var col: i32 = 0
        while col < 16 {
            let coeff = ctx.lia_coeffs[row * 16 + col]
            if coeff != 0 {
                if col + 1 > best { best = col + 1 }
            }
            col = col + 1
        }
        row = row + 1
    }
    return best
}

fn smt_lia_row_zero(coeffs: &[f64; 1024], row: i32, n_vars: i32) -> bool with Mut {
    var col: i32 = 0
    while col < n_vars {
        if smt_abs_f64(coeffs[row * 16 + col]) > 0.000000001 { return false }
        col = col + 1
    }
    return true
}

fn smt_lia_has_contradiction(coeffs: &[f64; 1024], bounds: &[f64; 64], n_rows: i32, n_vars: i32) -> bool with Mut {
    var row: i32 = 0
    while row < n_rows {
        if smt_lia_row_zero(coeffs, row, n_vars) {
            if bounds[row] < 0.0 - 0.000000001 { return true }
        }
        row = row + 1
    }
    return false
}

fn smt_lia_feasible(ctx: &!SmtContext) -> i32 with Mut, Div {
    if ctx.n_constraints <= 0 { return 1 }
    let n_vars = smt_lia_var_count(ctx)
    if n_vars <= 0 {
        var row0: i32 = 0
        while row0 < ctx.n_constraints {
            if ctx.lia_bounds[row0] < 0 { return 0 }
            row0 = row0 + 1
        }
        return 1
    }

    var work_coeffs: [f64; 1024] = [0.0; 1024]
    var work_bounds: [f64; 64] = [0.0; 64]
    var row_count = ctx.n_constraints
    var row: i32 = 0
    while row < row_count {
        var col: i32 = 0
        while col < n_vars {
            work_coeffs[row * 16 + col] = ctx.lia_coeffs[row * 16 + col] as f64
            col = col + 1
        }
        work_bounds[row] = ctx.lia_bounds[row] as f64
        row = row + 1
    }
    if smt_lia_has_contradiction(&work_coeffs, &work_bounds, row_count, n_vars) { return 0 }

    var var_idx: i32 = 0
    while var_idx < n_vars {
        var next_coeffs: [f64; 1024] = [0.0; 1024]
        var next_bounds: [f64; 64] = [0.0; 64]
        var zero_rows: [i32; 64] = [0; 64]
        var pos_rows: [i32; 64] = [0; 64]
        var neg_rows: [i32; 64] = [0; 64]
        var zero_count: i32 = 0
        var pos_count: i32 = 0
        var neg_count: i32 = 0

        row = 0
        while row < row_count {
            let coeff = work_coeffs[row * 16 + var_idx]
            if coeff > 0.000000001 {
                if pos_count >= 64 { return 0 - 1 }
                pos_rows[pos_count] = row
                pos_count = pos_count + 1
            } else {
                if coeff < 0.0 - 0.000000001 {
                    if neg_count >= 64 { return 0 - 1 }
                    neg_rows[neg_count] = row
                    neg_count = neg_count + 1
                } else {
                    if zero_count >= 64 { return 0 - 1 }
                    zero_rows[zero_count] = row
                    zero_count = zero_count + 1
                }
            }
            row = row + 1
        }

        var next_count: i32 = 0
        row = 0
        while row < zero_count {
            let src = zero_rows[row]
            var col: i32 = 0
            while col < n_vars {
                next_coeffs[next_count * 16 + col] = work_coeffs[src * 16 + col]
                col = col + 1
            }
            next_bounds[next_count] = work_bounds[src]
            next_count = next_count + 1
            row = row + 1
        }

        if pos_count > 0 && neg_count > 0 {
            var pi: i32 = 0
            while pi < pos_count {
                var ni: i32 = 0
                while ni < neg_count {
                    if next_count >= 64 { return 0 - 1 }
                    let prow = pos_rows[pi]
                    let nrow = neg_rows[ni]
                    let a = work_coeffs[prow * 16 + var_idx]
                    let b = work_coeffs[nrow * 16 + var_idx]
                    let scale_p = 0.0 - b
                    let scale_n = a
                    var col2: i32 = 0
                    while col2 < n_vars {
                        if col2 == var_idx {
                            next_coeffs[next_count * 16 + col2] = 0.0
                        } else {
                            next_coeffs[next_count * 16 + col2] =
                                scale_p * work_coeffs[prow * 16 + col2] +
                                scale_n * work_coeffs[nrow * 16 + col2]
                        }
                        col2 = col2 + 1
                    }
                    next_bounds[next_count] = scale_p * work_bounds[prow] + scale_n * work_bounds[nrow]
                    if smt_abs_f64(next_bounds[next_count]) > 1000000000000000.0 { return 0 - 1 }
                    next_count = next_count + 1
                    ni = ni + 1
                }
                pi = pi + 1
            }
        }

        row_count = next_count
        row = 0
        while row < row_count {
            var col3: i32 = 0
            while col3 < n_vars {
                work_coeffs[row * 16 + col3] = next_coeffs[row * 16 + col3]
                col3 = col3 + 1
            }
            work_bounds[row] = next_bounds[row]
            row = row + 1
        }

        if smt_lia_has_contradiction(&work_coeffs, &work_bounds, row_count, n_vars) { return 0 }
        var_idx = var_idx + 1
    }

    return 1
}

fn smt_add_clause(ctx: &!SmtContext, lits: &[i32; 8], n_lits: i32) with Mut, Div {
    if n_lits <= 0 { return }
    if n_lits > 8 { return }
    if ctx.n_clauses >= 256 { return }
    let clause_idx = ctx.n_clauses
    let start = smt_clause_end(ctx)
    if start + (n_lits as i64) > 1024 { return }
    ctx.clause_start[clause_idx] = start
    ctx.clause_len[clause_idx] = n_lits as i64
    var i: i32 = 0
    while i < n_lits {
        let lit = lits[i] as i64
        ctx.clause_data[(start as i32) + i] = lit
        let var_idx = smt_lit_var(lit)
        if var_idx + 1 > ctx.n_vars {
            ctx.n_vars = smt_min_i32(var_idx + 1, 64)
        }
        i = i + 1
    }
    ctx.n_clauses = clause_idx + 1
}

fn smt_add_lia(ctx: &!SmtContext, coeffs: &[i64; 16], bound: i64) with Mut {
    if ctx.n_constraints >= 64 { return }
    let row = ctx.n_constraints
    var col: i32 = 0
    while col < 16 {
        ctx.lia_coeffs[row * 16 + col] = coeffs[col]
        col = col + 1
    }
    ctx.lia_bounds[row] = bound
    ctx.n_constraints = row + 1
}

fn smt_get_assignment(ctx: &SmtContext, var_idx: i32) -> i32 {
    if var_idx < 0 { return 0 }
    if var_idx >= 64 { return 0 }
    return ctx.assign[var_idx]
}

fn smt_set_score_mode(ctx: &!SmtContext, mode: i32) with Mut {
    ctx.score_mode = mode
}

fn smt_set_no_ple(ctx: &!SmtContext, flag: i32) with Mut {
    ctx.no_ple = flag
}

fn smt_set_conflict_limit(ctx: &!SmtContext, limit: i32) with Mut {
    ctx.conflict_limit = limit
}

fn smt_set_decision_limit(ctx: &!SmtContext, limit: i32) with Mut {
    ctx.decision_limit = limit
}

fn smt_get_conflicts(ctx: &SmtContext) -> i32 {
    return ctx.conflict_count
}

// Regime hardness: conflicts per decision (higher = harder search).
fn smt_get_regime_hardness(ctx: &SmtContext) -> f64 {
    if ctx.n_decisions <= 0 { return 0.0 }
    return (ctx.conflict_count as f64) / ((ctx.n_decisions + 1) as f64)
}

// Exploration trust: confidence that regime classification is stable.
// High trust when few conflicts relative to formula size; low when thrashing.
fn smt_get_explore_trust(ctx: &SmtContext) -> f64 {
    let denom = (ctx.conflict_count + 1) as f64
    let base = 1.0 / denom
    if base > 1.0 { return 1.0 }
    return base
}

fn smt_get_regime_label(ctx: &SmtContext) -> i32 {
    let h = smt_get_regime_hardness(ctx)
    if h < 0.05 { return 0 }
    if h < 0.20 { return 1 }
    if h < 0.60 { return 2 }
    return 3
}

fn smt_solve(ctx: &!SmtContext) -> i32 with Mut, Div {
    smt_reset_search_state(ctx)
    let result = smt_search_inner(ctx, 1)
    if result == 1 { return 1 }
    if result == 2 { return 2 }
    if result == 0 { return 0 }
    return 0 - 1
}
