//! stdlib/toml - TOML Parser
//!
//! Flat key-value TOML parsing (no tables, no arrays).

module toml

pub fn toml_module_ready() -> i32 { 1 }

pub use toml::parser::{
    TOML_BOOL,
    TOML_FLOAT,
    TOML_INTEGER,
    TOML_STRING,
    TomlDoc,
    toml_doc_count,
    toml_doc_new,
    toml_get_bool,
    toml_get_number,
    toml_get_string,
    toml_parse,
    toml_self_test,
}