//! TOML Parser for Sounio
//!
//! Parses and serializes TOML (Tom's Obvious Minimal Language) configuration files.
//! Implements TOML v1.0.0 specification.
//!
//! Note: This is a stub implementation. Pattern matching with variable bindings
//! is not yet fully supported in Sounio, so this module provides the type
//! definitions and basic accessor functions. Full parsing functionality will
//! be implemented when pattern matching support is expanded.
//!
//! # References
//! - TOML v1.0.0: https://toml.io/en/v1.0.0

// =============================================================================
// Error Types
// =============================================================================

// Error type for TOML parsing.
pub enum TomlError {
    // Unexpected character at position.
    UnexpectedChar,
    // Unexpected end of input.
    UnexpectedEof,
    // Invalid key format.
    InvalidKey,
    // Invalid value format.
    InvalidValue,
    // Invalid number format.
    InvalidNumber,
    // Invalid string escape.
    InvalidEscape,
    // Duplicate key in table.
    DuplicateKey,
    // Invalid table header.
    InvalidTable,
    // Mixed array types.
    MixedArrayTypes,
    // Other parse error.
    Other,
}

// Get error message.
pub fn toml_error_message(err: &TomlError) -> string {
    match err {
        TomlError::UnexpectedChar => "Unexpected character",
        TomlError::UnexpectedEof => "Unexpected end of input",
        TomlError::InvalidKey => "Invalid key",
        TomlError::InvalidValue => "Invalid value",
        TomlError::InvalidNumber => "Invalid number",
        TomlError::InvalidEscape => "Invalid escape sequence",
        TomlError::DuplicateKey => "Duplicate key",
        TomlError::InvalidTable => "Invalid table header",
        TomlError::MixedArrayTypes => "Arrays must have homogeneous types",
        TomlError::Other => "Parse error",
    }
}

// =============================================================================
// TOML Value Types
// =============================================================================

// TOML date-time representation.
pub struct TomlDateTime {
    year: i32,
    month: u8,
    day: u8,
    hour: u8,
    minute: u8,
    second: u8,
    nanosecond: u32,
    // Offset from UTC in minutes (None for local time).
    offset_minutes: Option<i16>,
}

// Table entry: a key-value pair
pub struct TomlTableEntry {
    key: string,
    value: TomlValue,
}

// Represents any TOML value.
pub enum TomlValue {
    // String value.
    String(string),
    // Integer value (64-bit signed).
    Integer(i64),
    // Float value (64-bit).
    Float(f64),
    // Boolean value.
    Boolean(bool),
    // Date-time value.
    DateTime(TomlDateTime),
    // Array of values.
    Array([TomlValue]),
    // Table (list of key-value pairs).
    Table([TomlTableEntry]),
}

// Create a date (no time component).
pub fn toml_datetime_date(year: i32, month: u8, day: u8) -> TomlDateTime {
    TomlDateTime {
        year: year, month: month, day: day,
        hour: 0, minute: 0, second: 0, nanosecond: 0,
        offset_minutes: None,
    }
}

// Create a date-time in UTC.
pub fn toml_datetime_utc(year: i32, month: u8, day: u8, hour: u8, minute: u8, second: u8) -> TomlDateTime {
    TomlDateTime {
        year: year, month: month, day: day, hour: hour, minute: minute, second: second, nanosecond: 0,
        offset_minutes: Some(0),
    }
}

// =========================================================================
// TomlValue Constructors
// =========================================================================

// Create a string value.
pub fn toml_value_string(s: string) -> TomlValue {
    return TomlValue::String(s)
}

// Create an integer value.
pub fn toml_value_integer(n: i64) -> TomlValue {
    return TomlValue::Integer(n)
}

// Create a float value.
pub fn toml_value_float(n: f64) -> TomlValue {
    return TomlValue::Float(n)
}

// Create a boolean value.
pub fn toml_value_boolean(b: bool) -> TomlValue {
    return TomlValue::Boolean(b)
}

// Create an empty table.
pub fn toml_value_table() -> TomlValue with Alloc {
    return TomlValue::Table([])
}

// Create an empty array.
pub fn toml_value_array() -> TomlValue with Alloc {
    return TomlValue::Array([])
}

// =========================================================================
// Type Checking
// =========================================================================

// Check if value is a string.
pub fn toml_value_is_string(val: &TomlValue) -> bool {
    match val {
        TomlValue::String(_) => true,
        _ => false,
    }
}

// Check if value is an integer.
pub fn toml_value_is_integer(val: &TomlValue) -> bool {
    match val {
        TomlValue::Integer(_) => true,
        _ => false,
    }
}

// Check if value is a float.
pub fn toml_value_is_float(val: &TomlValue) -> bool {
    match val {
        TomlValue::Float(_) => true,
        _ => false,
    }
}

// Check if value is a boolean.
pub fn toml_value_is_boolean(val: &TomlValue) -> bool {
    match val {
        TomlValue::Boolean(_) => true,
        _ => false,
    }
}

// Check if value is a table.
pub fn toml_value_is_table(val: &TomlValue) -> bool {
    match val {
        TomlValue::Table(_) => true,
        _ => false,
    }
}

// Check if value is an array.
pub fn toml_value_is_array(val: &TomlValue) -> bool {
    match val {
        TomlValue::Array(_) => true,
        _ => false,
    }
}

