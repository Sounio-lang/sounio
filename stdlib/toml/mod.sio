//! TOML Parser for Sounio
//!
//! Parses and serializes TOML (Tom's Obvious Minimal Language) configuration files.
//! Implements TOML v1.0.0 specification.
//!
//! # Examples
//! ```sio
//! let toml_str = "[package]\nname = \"myapp\"\nversion = \"1.0.0\""
//! match parse_toml(toml_str) {
//!     Ok(value) => {
//!         let name = value.get("package").get("name").as_str()
//!         print("Package: " ++ name.unwrap_or("unknown"))
//!     },
//!     Err(e) => print("Parse error: " ++ e.message()),
//! }
//! ```
//!
//! # References
//! - TOML v1.0.0: https://toml.io/en/v1.0.0

// =============================================================================
// Error Types
// =============================================================================

/// Error type for TOML parsing.
pub enum TomlError {
    /// Unexpected character at position.
    UnexpectedChar { line: usize, col: usize, char: char, expected: String },
    /// Unexpected end of input.
    UnexpectedEof { expected: String },
    /// Invalid key format.
    InvalidKey { line: usize, key: String },
    /// Invalid value format.
    InvalidValue { line: usize, value: String },
    /// Invalid number format.
    InvalidNumber { line: usize, value: String },
    /// Invalid string escape.
    InvalidEscape { line: usize, sequence: String },
    /// Duplicate key in table.
    DuplicateKey { line: usize, key: String },
    /// Invalid table header.
    InvalidTable { line: usize, header: String },
    /// Mixed array types (TOML requires homogeneous arrays).
    MixedArrayTypes { line: usize },
    /// Other parse error.
    Other { message: String },
}

impl TomlError {
    /// Get error message.
    pub fn message(self: &TomlError) -> String {
        match self {
            TomlError::UnexpectedChar { line, col, char, expected } =>
                "Line " ++ line.to_string() ++ ":" ++ col.to_string() ++
                ": unexpected '" ++ char.to_string() ++ "', expected " ++ expected,
            TomlError::UnexpectedEof { expected } =>
                "Unexpected end of input, expected " ++ expected,
            TomlError::InvalidKey { line, key } =>
                "Line " ++ line.to_string() ++ ": invalid key '" ++ key ++ "'",
            TomlError::InvalidValue { line, value } =>
                "Line " ++ line.to_string() ++ ": invalid value '" ++ value ++ "'",
            TomlError::InvalidNumber { line, value } =>
                "Line " ++ line.to_string() ++ ": invalid number '" ++ value ++ "'",
            TomlError::InvalidEscape { line, sequence } =>
                "Line " ++ line.to_string() ++ ": invalid escape sequence '" ++ sequence ++ "'",
            TomlError::DuplicateKey { line, key } =>
                "Line " ++ line.to_string() ++ ": duplicate key '" ++ key ++ "'",
            TomlError::InvalidTable { line, header } =>
                "Line " ++ line.to_string() ++ ": invalid table header '" ++ header ++ "'",
            TomlError::MixedArrayTypes { line } =>
                "Line " ++ line.to_string() ++ ": arrays must have homogeneous types",
            TomlError::Other { message } => message,
        }
    }
}

// =============================================================================
// TOML Value Types
// =============================================================================

/// Represents any TOML value.
pub enum TomlValue {
    /// String value.
    String(String),
    /// Integer value (64-bit signed).
    Integer(i64),
    /// Float value (64-bit).
    Float(f64),
    /// Boolean value.
    Boolean(bool),
    /// Date-time value.
    DateTime(TomlDateTime),
    /// Array of values.
    Array(Vec<TomlValue>),
    /// Table (map of string keys to values).
    Table(Map<String, TomlValue>),
}

/// TOML date-time representation.
pub struct TomlDateTime {
    year: i32,
    month: u8,
    day: u8,
    hour: u8,
    minute: u8,
    second: u8,
    nanosecond: u32,
    /// Offset from UTC in minutes (None for local time).
    offset_minutes: Option<i16>,
}

impl TomlDateTime {
    /// Create a date (no time component).
    pub fn date(year: i32, month: u8, day: u8) -> TomlDateTime {
        TomlDateTime {
            year, month, day,
            hour: 0, minute: 0, second: 0, nanosecond: 0,
            offset_minutes: None,
        }
    }

    /// Create a date-time in UTC.
    pub fn utc(year: i32, month: u8, day: u8, hour: u8, minute: u8, second: u8) -> TomlDateTime {
        TomlDateTime {
            year, month, day, hour, minute, second, nanosecond: 0,
            offset_minutes: Some(0),
        }
    }
}

impl TomlValue {
    // =========================================================================
    // Constructors
    // =========================================================================

    /// Create a string value.
    pub fn string(s: String) -> TomlValue {
        TomlValue::String(s)
    }

    /// Create an integer value.
    pub fn integer(n: i64) -> TomlValue {
        TomlValue::Integer(n)
    }

    /// Create a float value.
    pub fn float(n: f64) -> TomlValue {
        TomlValue::Float(n)
    }

    /// Create a boolean value.
    pub fn boolean(b: bool) -> TomlValue {
        TomlValue::Boolean(b)
    }

    /// Create an empty table.
    pub fn table() -> TomlValue {
        TomlValue::Table(Map::new())
    }

    /// Create an empty array.
    pub fn array() -> TomlValue {
        TomlValue::Array(Vec::new())
    }

    // =========================================================================
    // Type Checking
    // =========================================================================

    /// Check if value is a string.
    pub fn is_string(self: &TomlValue) -> bool {
        match self {
            TomlValue::String(_) => true,
            _ => false,
        }
    }

    /// Check if value is an integer.
    pub fn is_integer(self: &TomlValue) -> bool {
        match self {
            TomlValue::Integer(_) => true,
            _ => false,
        }
    }

    /// Check if value is a float.
    pub fn is_float(self: &TomlValue) -> bool {
        match self {
            TomlValue::Float(_) => true,
            _ => false,
        }
    }

    /// Check if value is a boolean.
    pub fn is_boolean(self: &TomlValue) -> bool {
        match self {
            TomlValue::Boolean(_) => true,
            _ => false,
        }
    }

    /// Check if value is a table.
    pub fn is_table(self: &TomlValue) -> bool {
        match self {
            TomlValue::Table(_) => true,
            _ => false,
        }
    }

    /// Check if value is an array.
    pub fn is_array(self: &TomlValue) -> bool {
        match self {
            TomlValue::Array(_) => true,
            _ => false,
        }
    }

    // =========================================================================
    // Value Extraction
    // =========================================================================

    /// Get as string.
    pub fn as_str(self: &TomlValue) -> Option<&String> {
        match self {
            TomlValue::String(s) => Some(s),
            _ => None,
        }
    }

    /// Get as integer.
    pub fn as_i64(self: &TomlValue) -> Option<i64> {
        match self {
            TomlValue::Integer(n) => Some(*n),
            _ => None,
        }
    }

    /// Get as float.
    pub fn as_f64(self: &TomlValue) -> Option<f64> {
        match self {
            TomlValue::Float(n) => Some(*n),
            TomlValue::Integer(n) => Some(*n as f64),
            _ => None,
        }
    }

    /// Get as boolean.
    pub fn as_bool(self: &TomlValue) -> Option<bool> {
        match self {
            TomlValue::Boolean(b) => Some(*b),
            _ => None,
        }
    }

    /// Get as table.
    pub fn as_table(self: &TomlValue) -> Option<&Map<String, TomlValue>> {
        match self {
            TomlValue::Table(t) => Some(t),
            _ => None,
        }
    }

    /// Get as array.
    pub fn as_array(self: &TomlValue) -> Option<&Vec<TomlValue>> {
        match self {
            TomlValue::Array(a) => Some(a),
            _ => None,
        }
    }

    // =========================================================================
    // Table Access
    // =========================================================================

    /// Get a value from a table by key.
    pub fn get(self: &TomlValue, key: &str) -> Option<&TomlValue> {
        match self {
            TomlValue::Table(t) => t.get(key),
            _ => None,
        }
    }

    /// Check if table contains a key.
    pub fn has(self: &TomlValue, key: &str) -> bool {
        match self {
            TomlValue::Table(t) => t.contains_key(key),
            _ => false,
        }
    }

    /// Get nested value using dotted path (e.g., "package.name").
    pub fn path(self: &TomlValue, dotted_key: &str) -> Option<&TomlValue> {
        var current = self

        // Simple split on '.'
        var start: usize = 0
        var i: usize = 0
        let bytes = dotted_key.as_bytes()
        let len = dotted_key.len()

        while i <= len {
            if i == len || bytes[i] == 46 {  // '.'
                if i > start {
                    let key = dotted_key.substring(start, i)
                    match current.get(&key) {
                        Some(v) => current = v,
                        None => return None,
                    }
                }
                start = i + 1
            }
            i = i + 1
        }

        Some(current)
    }

    // =========================================================================
    // Array Access
    // =========================================================================

    /// Get array element by index.
    pub fn at(self: &TomlValue, index: usize) -> Option<&TomlValue> {
        match self {
            TomlValue::Array(a) => {
                if index < a.len() {
                    Some(&a[index])
                } else {
                    None
                }
            },
            _ => None,
        }
    }

    /// Get array length.
    pub fn len(self: &TomlValue) -> usize {
        match self {
            TomlValue::Array(a) => a.len(),
            TomlValue::Table(t) => t.len(),
            _ => 0,
        }
    }
}

// =============================================================================
// Parser
// =============================================================================

/// Parser state.
struct TomlParser {
    input: String,
    pos: usize,
    line: usize,
    col: usize,
}

impl TomlParser {
    fn new(input: String) -> TomlParser {
        TomlParser { input, pos: 0, line: 1, col: 1 }
    }

    fn peek(self: &TomlParser) -> Option<char> {
        if self.pos < self.input.len() {
            Some(self.input.char_at(self.pos))
        } else {
            None
        }
    }

    fn advance(self: &!TomlParser) -> Option<char> {
        if self.pos < self.input.len() {
            let c = self.input.char_at(self.pos)
            self.pos = self.pos + 1
            if c == '\n' {
                self.line = self.line + 1
                self.col = 1
            } else {
                self.col = self.col + 1
            }
            Some(c)
        } else {
            None
        }
    }

    fn skip_whitespace(self: &!TomlParser) {
        while true {
            match self.peek() {
                Some(' ') | Some('\t') => { self.advance(); },
                _ => break,
            }
        }
    }

    fn skip_whitespace_and_newlines(self: &!TomlParser) {
        while true {
            match self.peek() {
                Some(' ') | Some('\t') | Some('\n') | Some('\r') => { self.advance(); },
                Some('#') => {
                    // Skip comment to end of line
                    while true {
                        match self.peek() {
                            Some('\n') | None => break,
                            _ => { self.advance(); },
                        }
                    }
                },
                _ => break,
            }
        }
    }

    fn at_end(self: &TomlParser) -> bool {
        self.pos >= self.input.len()
    }
}

/// Parse a TOML string into a TomlValue (always returns a Table).
pub fn parse_toml(input: &str) -> Result<TomlValue, TomlError> with Alloc {
    var parser = TomlParser::new(input.to_string())
    var root: Map<String, TomlValue> = Map::new()
    var current_table = &!root

    parser.skip_whitespace_and_newlines()

    while !parser.at_end() {
        match parser.peek() {
            Some('[') => {
                // Table header
                parser.advance()
                let is_array = match parser.peek() {
                    Some('[') => { parser.advance(); true },
                    _ => false,
                };

                let key = parse_table_key(&!parser)?
                parser.skip_whitespace()

                // Expect closing bracket(s)
                match parser.peek() {
                    Some(']') => { parser.advance(); },
                    Some(c) => return Err(TomlError::UnexpectedChar {
                        line: parser.line, col: parser.col, char: c, expected: "']'".to_string()
                    }),
                    None => return Err(TomlError::UnexpectedEof { expected: "']'".to_string() }),
                }

                if is_array {
                    match parser.peek() {
                        Some(']') => { parser.advance(); },
                        Some(c) => return Err(TomlError::UnexpectedChar {
                            line: parser.line, col: parser.col, char: c, expected: "']]'".to_string()
                        }),
                        None => return Err(TomlError::UnexpectedEof { expected: "']]'".to_string() }),
                    }
                }

                // Navigate to or create the table
                current_table = navigate_to_table(&!root, &key, is_array, parser.line)?
            },
            Some(_) => {
                // Key-value pair
                let (key, value) = parse_key_value(&!parser)?

                if current_table.contains_key(&key) {
                    return Err(TomlError::DuplicateKey { line: parser.line, key })
                }

                current_table.insert(key, value)
            },
            None => break,
        }

        parser.skip_whitespace_and_newlines()
    }

    Ok(TomlValue::Table(root))
}

fn parse_table_key(parser: &!TomlParser) -> Result<Vec<String>, TomlError> with Alloc {
    var keys = Vec::new()

    parser.skip_whitespace()
    let first = parse_key(parser)?
    keys.push(first)

    while true {
        parser.skip_whitespace()
        match parser.peek() {
            Some('.') => {
                parser.advance()
                parser.skip_whitespace()
                let k = parse_key(parser)?
                keys.push(k)
            },
            _ => break,
        }
    }

    Ok(keys)
}

fn parse_key(parser: &!TomlParser) -> Result<String, TomlError> with Alloc {
    match parser.peek() {
        Some('"') => parse_basic_string(parser),
        Some('\'') => parse_literal_string(parser),
        Some(c) if is_bare_key_char(c) => parse_bare_key(parser),
        Some(c) => Err(TomlError::UnexpectedChar {
            line: parser.line, col: parser.col, char: c, expected: "key".to_string()
        }),
        None => Err(TomlError::UnexpectedEof { expected: "key".to_string() }),
    }
}

fn is_bare_key_char(c: char) -> bool {
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '_' || c == '-'
}

fn parse_bare_key(parser: &!TomlParser) -> Result<String, TomlError> with Alloc {
    var key = String::new()

    while true {
        match parser.peek() {
            Some(c) if is_bare_key_char(c) => {
                key.push(c)
                parser.advance()
            },
            _ => break,
        }
    }

    if key.is_empty() {
        Err(TomlError::InvalidKey { line: parser.line, key: "".to_string() })
    } else {
        Ok(key)
    }
}

fn parse_basic_string(parser: &!TomlParser) -> Result<String, TomlError> with Alloc {
    parser.advance()  // Skip opening "
    var s = String::new()

    while true {
        match parser.peek() {
            Some('"') => {
                parser.advance()
                break
            },
            Some('\\') => {
                parser.advance()
                let escaped = parse_escape(parser)?
                s.push(escaped)
            },
            Some('\n') => return Err(TomlError::InvalidValue {
                line: parser.line, value: "newline in basic string".to_string()
            }),
            Some(c) => {
                s.push(c)
                parser.advance()
            },
            None => return Err(TomlError::UnexpectedEof { expected: "'\"'".to_string() }),
        }
    }

    Ok(s)
}

fn parse_literal_string(parser: &!TomlParser) -> Result<String, TomlError> with Alloc {
    parser.advance()  // Skip opening '
    var s = String::new()

    while true {
        match parser.peek() {
            Some('\'') => {
                parser.advance()
                break
            },
            Some('\n') => return Err(TomlError::InvalidValue {
                line: parser.line, value: "newline in literal string".to_string()
            }),
            Some(c) => {
                s.push(c)
                parser.advance()
            },
            None => return Err(TomlError::UnexpectedEof { expected: "'''".to_string() }),
        }
    }

    Ok(s)
}

fn parse_escape(parser: &!TomlParser) -> Result<char, TomlError> {
    match parser.advance() {
        Some('b') => Ok('\x08'),  // backspace
        Some('t') => Ok('\t'),
        Some('n') => Ok('\n'),
        Some('f') => Ok('\x0c'),  // form feed
        Some('r') => Ok('\r'),
        Some('"') => Ok('"'),
        Some('\\') => Ok('\\'),
        Some(c) => Err(TomlError::InvalidEscape {
            line: parser.line, sequence: "\\" ++ c.to_string()
        }),
        None => Err(TomlError::UnexpectedEof { expected: "escape character".to_string() }),
    }
}

fn parse_key_value(parser: &!TomlParser) -> Result<(String, TomlValue), TomlError> with Alloc {
    let key = parse_key(parser)?

    parser.skip_whitespace()

    // Expect '='
    match parser.peek() {
        Some('=') => { parser.advance(); },
        Some(c) => return Err(TomlError::UnexpectedChar {
            line: parser.line, col: parser.col, char: c, expected: "'='".to_string()
        }),
        None => return Err(TomlError::UnexpectedEof { expected: "'='".to_string() }),
    }

    parser.skip_whitespace()

    let value = parse_value(parser)?

    // Skip to end of line
    parser.skip_whitespace()
    match parser.peek() {
        Some('\n') | Some('\r') | Some('#') | None => {},
        Some(c) => return Err(TomlError::UnexpectedChar {
            line: parser.line, col: parser.col, char: c, expected: "end of line".to_string()
        }),
    }

    Ok((key, value))
}

fn parse_value(parser: &!TomlParser) -> Result<TomlValue, TomlError> with Alloc {
    match parser.peek() {
        Some('"') => {
            let s = parse_basic_string(parser)?
            Ok(TomlValue::String(s))
        },
        Some('\'') => {
            let s = parse_literal_string(parser)?
            Ok(TomlValue::String(s))
        },
        Some('[') => parse_array(parser),
        Some('{') => parse_inline_table(parser),
        Some('t') | Some('f') => parse_bool(parser),
        Some(c) if c == '-' || c == '+' || is_digit(c) => parse_number(parser),
        Some(c) => Err(TomlError::UnexpectedChar {
            line: parser.line, col: parser.col, char: c, expected: "value".to_string()
        }),
        None => Err(TomlError::UnexpectedEof { expected: "value".to_string() }),
    }
}

fn is_digit(c: char) -> bool {
    c >= '0' && c <= '9'
}

fn parse_bool(parser: &!TomlParser) -> Result<TomlValue, TomlError> {
    let start = parser.pos

    // Read word
    while true {
        match parser.peek() {
            Some(c) if c >= 'a' && c <= 'z' => { parser.advance(); },
            _ => break,
        }
    }

    let word = parser.input.substring(start, parser.pos)

    if word == "true" {
        Ok(TomlValue::Boolean(true))
    } else if word == "false" {
        Ok(TomlValue::Boolean(false))
    } else {
        Err(TomlError::InvalidValue { line: parser.line, value: word })
    }
}

fn parse_number(parser: &!TomlParser) -> Result<TomlValue, TomlError> with Alloc {
    let start = parser.pos
    var has_dot = false
    var has_exp = false

    // Sign
    match parser.peek() {
        Some('-') | Some('+') => { parser.advance(); },
        _ => {},
    }

    // Integer part
    while true {
        match parser.peek() {
            Some(c) if is_digit(c) => { parser.advance(); },
            Some('_') => { parser.advance(); },  // TOML allows underscores in numbers
            _ => break,
        }
    }

    // Fractional part
    match parser.peek() {
        Some('.') => {
            has_dot = true
            parser.advance()
            while true {
                match parser.peek() {
                    Some(c) if is_digit(c) => { parser.advance(); },
                    Some('_') => { parser.advance(); },
                    _ => break,
                }
            }
        },
        _ => {},
    }

    // Exponent
    match parser.peek() {
        Some('e') | Some('E') => {
            has_exp = true
            parser.advance()
            match parser.peek() {
                Some('-') | Some('+') => { parser.advance(); },
                _ => {},
            }
            while true {
                match parser.peek() {
                    Some(c) if is_digit(c) => { parser.advance(); },
                    _ => break,
                }
            }
        },
        _ => {},
    }

    let num_str = parser.input.substring(start, parser.pos).replace("_", "")

    if has_dot || has_exp {
        match num_str.parse_f64() {
            Some(f) => Ok(TomlValue::Float(f)),
            None => Err(TomlError::InvalidNumber { line: parser.line, value: num_str }),
        }
    } else {
        match num_str.parse_i64() {
            Some(i) => Ok(TomlValue::Integer(i)),
            None => Err(TomlError::InvalidNumber { line: parser.line, value: num_str }),
        }
    }
}

fn parse_array(parser: &!TomlParser) -> Result<TomlValue, TomlError> with Alloc {
    parser.advance()  // Skip '['
    var arr = Vec::new()

    parser.skip_whitespace_and_newlines()

    while true {
        match parser.peek() {
            Some(']') => {
                parser.advance()
                break
            },
            Some(',') => {
                parser.advance()
                parser.skip_whitespace_and_newlines()
            },
            Some(_) => {
                let value = parse_value(parser)?
                arr.push(value)
                parser.skip_whitespace_and_newlines()
            },
            None => return Err(TomlError::UnexpectedEof { expected: "']'".to_string() }),
        }
    }

    Ok(TomlValue::Array(arr))
}

fn parse_inline_table(parser: &!TomlParser) -> Result<TomlValue, TomlError> with Alloc {
    parser.advance()  // Skip '{'
    var table: Map<String, TomlValue> = Map::new()

    parser.skip_whitespace()

    while true {
        match parser.peek() {
            Some('}') => {
                parser.advance()
                break
            },
            Some(',') => {
                parser.advance()
                parser.skip_whitespace()
            },
            Some(_) => {
                let (key, value) = parse_key_value(parser)?
                if table.contains_key(&key) {
                    return Err(TomlError::DuplicateKey { line: parser.line, key })
                }
                table.insert(key, value)
                parser.skip_whitespace()
            },
            None => return Err(TomlError::UnexpectedEof { expected: "'}'".to_string() }),
        }
    }

    Ok(TomlValue::Table(table))
}

fn navigate_to_table(
    root: &!Map<String, TomlValue>,
    keys: &Vec<String>,
    is_array: bool,
    line: usize
) -> Result<&!Map<String, TomlValue>, TomlError> with Alloc {
    var current = root

    var i: usize = 0
    while i < keys.len() {
        let key = &keys[i]
        let is_last = i == keys.len() - 1

        if !current.contains_key(key) {
            if is_last && is_array {
                current.insert(key.clone(), TomlValue::Array(Vec::new()))
            } else {
                current.insert(key.clone(), TomlValue::Table(Map::new()))
            }
        }

        match current.get_mut(key) {
            Some(TomlValue::Table(t)) => {
                current = t
            },
            Some(TomlValue::Array(arr)) if is_last && is_array => {
                // Add new table to array
                arr.push(TomlValue::Table(Map::new()))
                let idx = arr.len() - 1
                match &!arr[idx] {
                    TomlValue::Table(t) => current = t,
                    _ => return Err(TomlError::InvalidTable { line, header: key.clone() }),
                }
            },
            _ => return Err(TomlError::InvalidTable { line, header: key.clone() }),
        }

        i = i + 1
    }

    Ok(current)
}

// =============================================================================
// Serialization
// =============================================================================

/// Serialize a TomlValue to a TOML string.
pub fn toml_to_string(value: &TomlValue) -> String with Alloc {
    var output = String::new()
    serialize_value(value, &!output, 0, "")
    output
}

fn serialize_value(value: &TomlValue, out: &!String, indent: usize, key_path: &str) {
    match value {
        TomlValue::String(s) => {
            out.push('"')
            serialize_string(s, out)
            out.push('"')
        },
        TomlValue::Integer(n) => {
            out.push_str(&n.to_string())
        },
        TomlValue::Float(n) => {
            out.push_str(&n.to_string())
        },
        TomlValue::Boolean(b) => {
            out.push_str(if *b { "true" } else { "false" })
        },
        TomlValue::DateTime(dt) => {
            serialize_datetime(dt, out)
        },
        TomlValue::Array(arr) => {
            out.push('[')
            var first = true
            var i: usize = 0
            while i < arr.len() {
                if !first {
                    out.push_str(", ")
                }
                first = false
                serialize_value(&arr[i], out, indent, key_path)
                i = i + 1
            }
            out.push(']')
        },
        TomlValue::Table(t) => {
            // For nested tables in inline context
            out.push('{')
            var first = true
            for (k, v) in t.iter() {
                if !first {
                    out.push_str(", ")
                }
                first = false
                serialize_key(k, out)
                out.push_str(" = ")
                serialize_value(v, out, indent, key_path)
            }
            out.push('}')
        },
    }
}

fn serialize_string(s: &String, out: &!String) {
    var i: usize = 0
    while i < s.len() {
        let c = s.char_at(i)
        match c {
            '\n' => out.push_str("\\n"),
            '\t' => out.push_str("\\t"),
            '\r' => out.push_str("\\r"),
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            _ => out.push(c),
        }
        i = i + 1
    }
}

fn serialize_key(key: &String, out: &!String) {
    // Check if bare key is valid
    var needs_quotes = key.is_empty()
    var i: usize = 0
    while i < key.len() && !needs_quotes {
        if !is_bare_key_char(key.char_at(i)) {
            needs_quotes = true
        }
        i = i + 1
    }

    if needs_quotes {
        out.push('"')
        serialize_string(key, out)
        out.push('"')
    } else {
        out.push_str(key)
    }
}

fn serialize_datetime(dt: &TomlDateTime, out: &!String) {
    // Format: YYYY-MM-DDTHH:MM:SS
    out.push_str(&format_padded(dt.year as i64, 4))
    out.push('-')
    out.push_str(&format_padded(dt.month as i64, 2))
    out.push('-')
    out.push_str(&format_padded(dt.day as i64, 2))
    out.push('T')
    out.push_str(&format_padded(dt.hour as i64, 2))
    out.push(':')
    out.push_str(&format_padded(dt.minute as i64, 2))
    out.push(':')
    out.push_str(&format_padded(dt.second as i64, 2))

    match dt.offset_minutes {
        Some(0) => out.push('Z'),
        Some(off) => {
            let sign = if off < 0 { '-' } else { '+' }
            let abs_off = if off < 0 { -off } else { off }
            out.push(sign)
            out.push_str(&format_padded((abs_off / 60) as i64, 2))
            out.push(':')
            out.push_str(&format_padded((abs_off % 60) as i64, 2))
        },
        None => {},
    }
}

fn format_padded(n: i64, width: usize) -> String with Alloc {
    var s = n.to_string()
    while s.len() < width {
        s = "0" ++ s
    }
    s
}

// =============================================================================
// Tests
// =============================================================================

fn test_parse_simple() -> bool {
    let input = "key = \"value\"\nnum = 42"

    match parse_toml(input) {
        Ok(value) => {
            match value.get("key") {
                Some(v) => match v.as_str() {
                    Some(s) => if s != "value" { return false },
                    None => return false,
                },
                None => return false,
            }
            match value.get("num") {
                Some(v) => match v.as_i64() {
                    Some(42) => {},
                    _ => return false,
                },
                None => return false,
            }
            true
        },
        Err(_) => false,
    }
}

fn test_parse_table() -> bool {
    let input = "[package]\nname = \"test\"\nversion = \"1.0.0\""

    match parse_toml(input) {
        Ok(value) => {
            match value.path("package.name") {
                Some(v) => match v.as_str() {
                    Some(s) => s == "test",
                    None => false,
                },
                None => false,
            }
        },
        Err(_) => false,
    }
}

fn test_parse_array() -> bool {
    let input = "arr = [1, 2, 3]"

    match parse_toml(input) {
        Ok(value) => {
            match value.get("arr") {
                Some(v) => match v.as_array() {
                    Some(arr) => arr.len() == 3,
                    None => false,
                },
                None => false,
            }
        },
        Err(_) => false,
    }
}

pub fn run_tests() -> bool {
    test_parse_simple() &&
    test_parse_table() &&
    test_parse_array()
}
