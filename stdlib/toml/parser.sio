// stdlib/toml/parser.sio — Minimal TOML parser

module toml::parser

fn toml_neg_one() -> i32 {
    let z: i32 = 0
    z - 1
}
//
// Represents TOML as a flat key-value document (up to 32 entries).
// No heap allocation — all storage is fixed-size arrays.
// Supports flat key=value only (no tables, no arrays-of-tables).
// Value types: string, integer, float, bool.
// Handles: # comments, blank lines, whitespace around '='.
//
// JIT note: only &!Struct field mutations propagate to callers.
// Standalone &!array and &!scalar do NOT propagate in JIT mode.
// All helpers use struct-wrapping or by-value returns for correctness.
//
// # Limits
//   - Up to 32 key-value pairs per document
//   - Keys up to 63 bytes (null-terminated in 64-byte slot)
//   - String values up to 127 bytes (null-terminated in 128-byte slot)
//   - Parse input up to 4095 bytes

// ============================================================================
// TOML VALUE TYPES
// ============================================================================

pub fn TOML_STRING()  -> i32 { 0 }
pub fn TOML_INTEGER() -> i32 { 1 }
pub fn TOML_FLOAT()   -> i32 { 2 }
pub fn TOML_BOOL()    -> i32 { 3 }

// ============================================================================
// TomlDoc — flat key→value store, up to 32 entries
// ============================================================================

pub struct TomlDoc {
    pub keys:      [[u8; 64]; 32],
    pub key_lens:  [i32; 32],
    pub str_vals:  [[u8; 128]; 32],
    pub str_lens:  [i32; 32],
    pub num_vals:  [f64; 32],
    pub bool_vals: [i32; 32],
    pub types:     [i32; 32],
    pub count:     i32,
}

// ============================================================================
// Internal result types
// ============================================================================

// Result from parsing a quoted string body (after opening '"').
struct TStrResult {
    data:    [u8; 128],
    str_len: i32,
    new_pos: i32,   // -1 on error
}

// Result from parsing a number token.
struct TNumResult {
    value:   f64,
    new_pos: i32,
    is_int:  i32,   // 1 if no decimal point seen
}

// ============================================================================
// TomlDoc constructor
// ============================================================================

pub fn toml_doc_new() -> TomlDoc {
    TomlDoc {
        keys:      [[(0 as u8); 64]; 32],
        key_lens:  [0; 32],
        str_vals:  [[(0 as u8); 128]; 32],
        str_lens:  [0; 32],
        num_vals:  [0.0; 32],
        bool_vals: [0; 32],
        types:     [0; 32],
        count:     0,
    }
}

// ============================================================================
// Internal helpers (must precede callers)
// ============================================================================

// Skip spaces and tabs (but not newlines). Returns new position.
fn toml_skip_ws(input: &[u8; 4096], pos: i32, len: i32) -> i32 with Mut, Div, Panic {
    var p: i32 = pos
    while p < len {
        let c = input[p as usize]
        if c == (32 as u8) || c == (9 as u8) {
            p = p + 1
        } else {
            return p
        }
    }
    p
}

// Skip to end of current line (past '\n'). Returns new position.
fn toml_skip_line(input: &[u8; 4096], pos: i32, len: i32) -> i32 with Mut, Div, Panic {
    var p: i32 = pos
    while p < len {
        let c = input[p as usize]
        p = p + 1
        if c == (10 as u8) {
            return p
        }
    }
    p
}

// Parse a quoted TOML basic string body (after opening '"').
// Returns TStrResult; new_pos=-1 on error.
fn toml_parse_string(input: &[u8; 4096], start: i32, len: i32) -> TStrResult with Mut, Div, Panic {
    var r = TStrResult {
        data:    [0; 128],
        str_len: 0,
        new_pos: toml_neg_one(),
    }
    var p: i32 = start
    var wpos: i32 = 0
    var done: i32 = 0
    while p < len && done == 0 {
        let c = input[p as usize]
        if c == (34 as u8) {
            // closing '"'
            p = p + 1
            done = 1
        } else if c == (92 as u8) {
            // escape sequence
            p = p + 1
            if p >= len { return r }
            let esc = input[p as usize]
            if esc == (34 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (34 as u8); wpos = wpos + 1 }
            } else if esc == (92 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (92 as u8); wpos = wpos + 1 }
            } else if esc == (110 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (10 as u8); wpos = wpos + 1 }
            } else if esc == (116 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (9 as u8); wpos = wpos + 1 }
            } else if esc == (114 as u8) {
                if wpos < 127 { r.data[wpos as usize] = (13 as u8); wpos = wpos + 1 }
            } else {
                if wpos < 127 { r.data[wpos as usize] = esc; wpos = wpos + 1 }
            }
            p = p + 1
        } else if c == (10 as u8) || c == (13 as u8) {
            // unterminated string
            return r
        } else {
            if wpos < 127 { r.data[wpos as usize] = c; wpos = wpos + 1 }
            p = p + 1
        }
    }
    if done == 0 { return r }
    r.str_len = wpos
    r.new_pos = p
    r
}

// Parse a number starting at pos. Handles optional sign, digits, optional '.'.
// Returns TNumResult; is_int=1 when no decimal point seen.
fn toml_parse_number(input: &[u8; 4096], start: i32, len: i32) -> TNumResult with Mut, Div, Panic {
    var p: i32 = start
    var negative: i32 = 0
    if p < len && input[p as usize] == (45 as u8) {
        negative = 1
        p = p + 1
    }
    var int_part: f64 = 0.0
    var int_done: i32 = 0
    while p < len && int_done == 0 {
        let c = input[p as usize]
        if c >= (48 as u8) && c <= (57 as u8) {
            int_part = int_part * 10.0 + (c - (48 as u8)) as f64
            p = p + 1
        } else {
            int_done = 1
        }
    }
    var frac: f64 = 0.0
    var frac_div: f64 = 1.0
    var is_int: i32 = 1
    if p < len && input[p as usize] == (46 as u8) {
        is_int = 0
        p = p + 1
        var frac_done: i32 = 0
        while p < len && frac_done == 0 {
            let c = input[p as usize]
            if c >= (48 as u8) && c <= (57 as u8) {
                frac = frac * 10.0 + (c - (48 as u8)) as f64
                frac_div = frac_div * 10.0
                p = p + 1
            } else {
                frac_done = 1
            }
        }
    }
    var result = int_part + frac / frac_div
    if negative == 1 {
        result = 0.0 - result
    }
    TNumResult { value: result, new_pos: p, is_int: is_int }
}

// Compare a key slot in doc against a provided key. Returns 1 if equal.
fn toml_keys_equal(doc: &TomlDoc, slot: i32, key: &[u8; 64], key_len: i32) -> i32 with Mut, Div, Panic {
    if doc.key_lens[slot as usize] != key_len { return 0 }
    var i: i32 = 0
    while i < key_len {
        if doc.keys[slot as usize][i as usize] != key[i as usize] { return 0 }
        i = i + 1
    }
    1
}

// Find slot index for a key. Returns index or -1.
fn toml_find_key(doc: &TomlDoc, key: &[u8; 64], key_len: i32) -> i32 with Mut, Div, Panic {
    var i: i32 = 0
    while i < doc.count {
        if toml_keys_equal(doc, i, key, key_len) == 1 {
            return i
        }
        i = i + 1
    }
    toml_neg_one()
}

// ============================================================================
// toml_parse — main parse entry point
// ============================================================================

// Parse a flat TOML document from input bytes.
// Handles: key = "string", key = 123, key = 3.14, key = true/false,
//          # comments, blank lines.
// Returns 0 on success, -1 on error.
pub fn toml_parse(input: &[u8; 4096], len: i32, doc: &!TomlDoc) -> i32 with Mut, Div, Panic {
    var p: i32 = 0
    while p < len {
        // Skip leading whitespace on the line.
        p = toml_skip_ws(input, p, len)
        if p >= len { return 0 }

        let c0 = input[p as usize]

        // Blank line or comment — skip to next line.
        if c0 == (10 as u8) || c0 == (13 as u8) {
            p = p + 1
            // skip \r\n pair
            if c0 == (13 as u8) && p < len && input[p as usize] == (10 as u8) {
                p = p + 1
            }
            // Advance p (loop will handle)
        } else if c0 == (35 as u8) {
            // '#' comment
            p = toml_skip_line(input, p, len)
        } else if c0 == (91 as u8) {
            // '[' table header — skip entire line (no table support)
            p = toml_skip_line(input, p, len)
        } else {
            // Parse key (bare key: alphanumeric, '-', '_')
            var key64: [u8; 64] = [0; 64]
            var klen: i32 = 0
            var key_done: i32 = 0
            while p < len && key_done == 0 {
                let kc = input[p as usize]
                // valid bare key chars
                if (kc >= (65 as u8) && kc <= (90 as u8)) ||   // A-Z
                   (kc >= (97 as u8) && kc <= (122 as u8)) ||  // a-z
                   (kc >= (48 as u8) && kc <= (57 as u8)) ||   // 0-9
                   kc == (45 as u8) || kc == (95 as u8) {       // '-', '_'
                    if klen < 63 {
                        key64[klen as usize] = kc
                        klen = klen + 1
                    }
                    p = p + 1
                } else {
                    key_done = 1
                }
            }
            if klen == 0 {
                // Not a valid key start — skip line
                p = toml_skip_line(input, p, len)
            } else {
                // Skip whitespace before '='
                p = toml_skip_ws(input, p, len)
                if p >= len { return toml_neg_one() }
                if input[p as usize] != (61 as u8) {
                    // '=' expected
                    return toml_neg_one()
                }
                p = p + 1
                // Skip whitespace after '='
                p = toml_skip_ws(input, p, len)
                if p >= len { return toml_neg_one() }

                let vc = input[p as usize]

                if doc.count < 32 {
                    let slot = doc.count
                    // Copy key into slot.
                    var ki: i32 = 0
                    while ki < klen {
                        doc.keys[slot as usize][ki as usize] = key64[ki as usize]
                        ki = ki + 1
                    }
                    doc.key_lens[slot as usize] = klen

                    if vc == (34 as u8) {
                        // Quoted string value.
                        p = p + 1
                        let sr = toml_parse_string(input, p, len)
                        if sr.new_pos < 0 { return toml_neg_one() }
                        p = sr.new_pos
                        doc.types[slot as usize] = 0
                        doc.str_lens[slot as usize] = sr.str_len
                        var si: i32 = 0
                        while si < sr.str_len {
                            doc.str_vals[slot as usize][si as usize] = sr.data[si as usize]
                            si = si + 1
                        }
                        doc.count = doc.count + 1

                    } else if vc == (116 as u8) {
                        // 'true'
                        if p + 3 < len &&
                           input[(p+1) as usize] == (114 as u8) &&
                           input[(p+2) as usize] == (117 as u8) &&
                           input[(p+3) as usize] == (101 as u8) {
                            doc.types[slot as usize] = 3
                            doc.bool_vals[slot as usize] = 1
                            p = p + 4
                            doc.count = doc.count + 1
                        } else {
                            return toml_neg_one()
                        }

                    } else if vc == (102 as u8) {
                        // 'false'
                        if p + 4 < len &&
                           input[(p+1) as usize] == (97 as u8)  &&
                           input[(p+2) as usize] == (108 as u8) &&
                           input[(p+3) as usize] == (115 as u8) &&
                           input[(p+4) as usize] == (101 as u8) {
                            doc.types[slot as usize] = 3
                            doc.bool_vals[slot as usize] = 0
                            p = p + 5
                            doc.count = doc.count + 1
                        } else {
                            return toml_neg_one()
                        }

                    } else if (vc >= (48 as u8) && vc <= (57 as u8)) || vc == (45 as u8) {
                        // Number (integer or float).
                        let nr = toml_parse_number(input, p, len)
                        if nr.new_pos <= p { return toml_neg_one() }
                        p = nr.new_pos
                        if nr.is_int == 1 {
                            doc.types[slot as usize] = 1
                        } else {
                            doc.types[slot as usize] = 2
                        }
                        doc.num_vals[slot as usize] = nr.value
                        doc.count = doc.count + 1

                    } else {
                        // Unrecognised value — skip line, don't add entry.
                        p = toml_skip_line(input, p, len)
                    }
                }

                // Skip trailing whitespace and comment on line.
                p = toml_skip_ws(input, p, len)
                if p < len {
                    let trail = input[p as usize]
                    if trail == (35 as u8) {
                        // inline comment
                        p = toml_skip_line(input, p, len)
                    } else if trail == (10 as u8) || trail == (13 as u8) {
                        p = p + 1
                        if trail == (13 as u8) && p < len && input[p as usize] == (10 as u8) {
                            p = p + 1
                        }
                    }
                }
            }
        }
    }
    0
}

// ============================================================================
// Accessor functions
// ============================================================================

// Returns string length into out buffer, or -1 if key not found / not a string.
pub fn toml_get_string(doc: &TomlDoc, key: &[u8; 64], key_len: i32, out: &![u8; 128]) -> i32 with Mut, Div, Panic {
    let idx = toml_find_key(doc, key, key_len)
    if idx < 0 { return toml_neg_one() }
    if doc.types[idx as usize] != 0 { return toml_neg_one() }
    let slen = doc.str_lens[idx as usize]
    // NOTE: &![u8;128] mutations do NOT propagate in JIT — caller must use
    // doc.str_vals[slot] directly after finding the slot via toml_find_key.
    // This function copies to out for API completeness; JIT callers see stale value.
    var i: i32 = 0
    while i < slen {
        out[i as usize] = doc.str_vals[idx as usize][i as usize]
        i = i + 1
    }
    slen
}

// Returns number value, or 0.0 if not found / not numeric.
pub fn toml_get_number(doc: &TomlDoc, key: &[u8; 64], key_len: i32) -> f64 with Mut, Div, Panic {
    let idx = toml_find_key(doc, key, key_len)
    if idx < 0 { return 0.0 }
    let t = doc.types[idx as usize]
    if t == 1 || t == 2 {
        return doc.num_vals[idx as usize]
    }
    0.0
}

// Returns 0 or 1 for bool, -1 if not found / not a bool.
pub fn toml_get_bool(doc: &TomlDoc, key: &[u8; 64], key_len: i32) -> i32 with Mut, Div, Panic {
    let idx = toml_find_key(doc, key, key_len)
    if idx < 0 { return toml_neg_one() }
    if doc.types[idx as usize] != 3 { return toml_neg_one() }
    doc.bool_vals[idx as usize]
}

// Returns total number of key-value pairs in document.
pub fn toml_doc_count(doc: &TomlDoc) -> i32 {
    doc.count
}

// ============================================================================
// Self-tests
// ============================================================================

pub fn toml_self_test() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    // T1: empty doc
    var doc = toml_doc_new()
    if doc.count != 0 { fail = fail + 1 }

    // T2: parse integer
    var raw: [u8; 4096] = [0; 4096]
    // "version = 3\n"
    raw[0]  = (118 as u8)  // v
    raw[1]  = (101 as u8)  // e
    raw[2]  = (114 as u8)  // r
    raw[3]  = (115 as u8)  // s
    raw[4]  = (105 as u8)  // i
    raw[5]  = (111 as u8)  // o
    raw[6]  = (110 as u8)  // n
    raw[7]  = (32 as u8)   // space
    raw[8]  = (61 as u8)   // =
    raw[9]  = (32 as u8)   // space
    raw[10] = (51 as u8)   // 3
    raw[11] = (10 as u8)   // \n
    let r1 = toml_parse(&raw, 12, &!doc)
    if r1 != 0 { fail = fail + 1 }
    if doc.count != 1 { fail = fail + 1 }
    if doc.types[0] != 1 { fail = fail + 1 }
    let vdiff = doc.num_vals[0] - 3.0
    let avdiff = if vdiff < 0.0 { 0.0 - vdiff } else { vdiff }
    if avdiff > 0.0001 { fail = fail + 1 }

    // T3: parse bool
    var doc2 = toml_doc_new()
    var raw2: [u8; 4096] = [0; 4096]
    // "debug = true\n"
    raw2[0]  = (100 as u8)  // d
    raw2[1]  = (101 as u8)  // e
    raw2[2]  = (98 as u8)   // b
    raw2[3]  = (117 as u8)  // u
    raw2[4]  = (103 as u8)  // g
    raw2[5]  = (32 as u8)   // space
    raw2[6]  = (61 as u8)   // =
    raw2[7]  = (32 as u8)   // space
    raw2[8]  = (116 as u8)  // t
    raw2[9]  = (114 as u8)  // r
    raw2[10] = (117 as u8)  // u
    raw2[11] = (101 as u8)  // e
    raw2[12] = (10 as u8)   // \n
    let r2 = toml_parse(&raw2, 13, &!doc2)
    if r2 != 0 { fail = fail + 1 }
    if doc2.count != 1 { fail = fail + 1 }
    if doc2.types[0] != 3 { fail = fail + 1 }
    if doc2.bool_vals[0] != 1 { fail = fail + 1 }

    // T4: doc.count (direct field access — avoids borrow conflict after &!doc)
    if doc.count != 1 { fail = fail + 1 }

    fail
}
