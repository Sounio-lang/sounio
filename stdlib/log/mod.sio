// stdlib/log/mod.sio — Public exports for the log module
//
// Per stdlib/CONVENTIONS.md §2, mod.sio declares only the public surface
// (pub use re-exports). Implementations live in the sibling files.

pub use log::lib::{
    LOG_DEBUG,
    LOG_ERROR,
    LOG_FATAL,
    LOG_INFO,
    LOG_TRACE,
    LOG_WARN,
    LogBuffer,
    log_append,
    log_buffer_new,
    log_clear,
    log_count,
    log_count_level,
    log_filter_level,
    log_last_value,
}

