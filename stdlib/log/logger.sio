// stdlib/log/logger — Hash-based structured logger
//
// Logger stores entries with level, message hash, and timestamp.
// Filters entries below minimum level. Up to 256 entries.
// For the simpler LogBuffer API, see log/lib.sio.

fn LOGLVL_DEBUG() -> i32 { 0 }
fn LOGLVL_INFO() -> i32 { 1 }
fn LOGLVL_WARN() -> i32 { 2 }
fn LOGLVL_ERROR() -> i32 { 3 }

struct HashLogEntry {
    level: i32,
    msg_hash: i64,
    timestamp: i64
}

pub struct Logger {
    entries: [HashLogEntry; 256],
    count: i32,
    min_level: i32
}

fn logger_new(min_level: i32) -> Logger {
    Logger {
        entries: [HashLogEntry { level: 0, msg_hash: 0, timestamp: 0 }; 256],
        count: 0,
        min_level: min_level
    }
}

fn logger_log(l: Logger, level: i32, msg_hash: i64, ts: i64) -> Logger with Mut, Panic, Div {
    if level < l.min_level { return l }
    if l.count >= 256 { return l }
    var result = l
    let idx = result.count
    result.entries[idx] = HashLogEntry { level: level, msg_hash: msg_hash, timestamp: ts }
    result.count = idx + 1
    result
}

fn logger_count_level(l: Logger, level: i32) -> i32 with Mut, Panic, Div {
    var n: i32 = 0
    var i: i32 = 0
    while i < l.count {
        if l.entries[i].level == level { n = n + 1 }
        i = i + 1
    }
    n
}

fn logger_count(l: Logger) -> i32 { l.count }

fn logger_last_hash(l: Logger) -> i64 with Panic, Div {
    if l.count <= 0 { return 0 }
    l.entries[l.count - 1].msg_hash
}

// =============================================================================
// Tests
// =============================================================================

fn test_logger_basic() -> bool with Mut, Panic, Div {
    var log = logger_new(LOGLVL_INFO())
    log = logger_log(log, LOGLVL_INFO(), 100, 1000)
    log = logger_log(log, LOGLVL_ERROR(), 200, 2000)
    log = logger_log(log, LOGLVL_DEBUG(), 300, 3000)
    // DEBUG filtered out (below min_level INFO)
    logger_count(log) == 2
}

fn test_logger_count_level() -> bool with Mut, Panic, Div {
    var log = logger_new(LOGLVL_DEBUG())
    log = logger_log(log, LOGLVL_WARN(), 10, 100)
    log = logger_log(log, LOGLVL_WARN(), 20, 200)
    log = logger_log(log, LOGLVL_ERROR(), 30, 300)
    logger_count_level(log, LOGLVL_WARN()) == 2 && logger_count_level(log, LOGLVL_ERROR()) == 1
}

fn test_logger_last_hash() -> bool with Mut, Panic, Div {
    var log = logger_new(LOGLVL_DEBUG())
    log = logger_log(log, LOGLVL_INFO(), 42, 100)
    log = logger_log(log, LOGLVL_INFO(), 99, 200)
    logger_last_hash(log) == 99
}

fn main() with IO, Mut, Panic, Div {
    if test_logger_basic() { print("logger basic: PASS\n") } else { print("logger basic: FAIL\n") }
    if test_logger_count_level() { print("logger count_level: PASS\n") } else { print("logger count_level: FAIL\n") }
    if test_logger_last_hash() { print("logger last_hash: PASS\n") } else { print("logger last_hash: FAIL\n") }
}
