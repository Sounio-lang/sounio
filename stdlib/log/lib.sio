// stdlib/log/lib.sio — Structured logging with level filtering
//
// LogBuffer: struct-of-arrays layout for compiler compatibility
//   (array-of-structs breaks with current native codegen for large arrays)
//
// Level constants: LOG_TRACE=0 LOG_DEBUG=1 LOG_INFO=2
//                  LOG_WARN=3  LOG_ERROR=4 LOG_FATAL=5

pub struct LogBuffer {
    levels:     [i64; 256],
    codes:      [i64; 256],
    values:     [f64; 256],
    timestamps: [i64; 256],
    count:      i64,
    min_level:  i64,
}

pub fn LOG_TRACE() -> i64 { 0 }
pub fn LOG_DEBUG() -> i64 { 1 }
pub fn LOG_INFO()  -> i64 { 2 }
pub fn LOG_WARN()  -> i64 { 3 }
pub fn LOG_ERROR() -> i64 { 4 }
pub fn LOG_FATAL() -> i64 { 5 }

pub fn log_buffer_new(min_level: i64) -> LogBuffer {
    LogBuffer {
        levels: [0; 256], codes: [0; 256],
        values: [0.0; 256], timestamps: [0; 256],
        count: 0, min_level: min_level
    }
}

pub fn log_append(buf: &! LogBuffer, level: i64, code: i64, value: f64, timestamp: i64) with Mut {
    if level >= buf.min_level && buf.count < 256 {
        let n = buf.count
        buf.levels[n] = level
        buf.codes[n] = code
        buf.values[n] = value
        buf.timestamps[n] = timestamp
        buf.count = n + 1
    }
}

pub fn log_count(buf: &LogBuffer) -> i64 {
    buf.count
}

pub fn log_count_level(buf: &LogBuffer, level: i64) -> i64 with Mut {
    var n: i64 = 0
    var i: i64 = 0
    while i < buf.count {
        if buf.levels[i] == level { n = n + 1 }
        i = i + 1
    }
    n
}

pub fn log_last_value(buf: &LogBuffer) -> f64 {
    if buf.count <= 0 { return 0.0 }
    buf.values[buf.count - 1]
}

pub fn log_clear(buf: &! LogBuffer) with Mut {
    buf.count = 0
}

pub fn log_filter_level(buf: &LogBuffer, level: i64, out: &! LogBuffer) with Mut {
    out.count = 0
    var i: i64 = 0
    while i < buf.count {
        if buf.levels[i] == level && out.count < 256 {
            let n = out.count
            out.levels[n] = buf.levels[i]
            out.codes[n] = buf.codes[i]
            out.values[n] = buf.values[i]
            out.timestamps[n] = buf.timestamps[i]
            out.count = n + 1
        }
        i = i + 1
    }
}
