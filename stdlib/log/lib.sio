// stdlib/log/lib.sio — Structured logging with level filtering
//
// LogEntry:  single log record (level, code, value, timestamp)
// LogBuffer: ring of up to 256 entries with min_level filter
//
// Level constants: LOG_TRACE=0 LOG_DEBUG=1 LOG_INFO=2
//                  LOG_WARN=3  LOG_ERROR=4 LOG_FATAL=5

struct LogEntry {
    level: i32,
    code: i32,
    value: f64,
    timestamp: i64,
}

struct LogBuffer {
    entries: [LogEntry; 256],
    count: i32,
    min_level: i32,
}

fn LOG_TRACE() -> i32 { 0 }
fn LOG_DEBUG() -> i32 { 1 }
fn LOG_INFO()  -> i32 { 2 }
fn LOG_WARN()  -> i32 { 3 }
fn LOG_ERROR() -> i32 { 4 }
fn LOG_FATAL() -> i32 { 5 }

fn log_buffer_new(min_level: i32) -> LogBuffer {
    let e0 = LogEntry { level: 0, code: 0, value: 0.0, timestamp: 0 }
    LogBuffer { entries: [e0; 256], count: 0, min_level: min_level }
}

fn log_append(buf: LogBuffer, level: i32, code: i32, value: f64, timestamp: i64) -> LogBuffer {
    var nb = buf
    if level >= nb.min_level && nb.count < 256 {
        let e = LogEntry { level: level, code: code, value: value, timestamp: timestamp }
        nb.entries[nb.count] = e
        nb.count = nb.count + 1
    }
    nb
}

fn log_count(buf: &LogBuffer) -> i32 {
    buf.count
}

fn log_count_level(buf: &LogBuffer, level: i32) -> i32 {
    var n: i32 = 0
    var i: i32 = 0
    while i < buf.count {
        if buf.entries[i].level == level {
            n = n + 1
        }
        i = i + 1
    }
    n
}

fn log_last_value(buf: &LogBuffer) -> f64 {
    if buf.count <= 0 { return 0.0 }
    buf.entries[buf.count - 1].value
}

fn log_clear(buf: LogBuffer) -> LogBuffer {
    var nb = buf
    nb.count = 0
    nb
}

fn log_filter_level(buf: &LogBuffer, level: i32, out: &! LogBuffer) {
    out.count = 0
    var i: i32 = 0
    while i < buf.count {
        if buf.entries[i].level == level && out.count < 256 {
            out.entries[out.count] = buf.entries[i]
            out.count = out.count + 1
        }
        i = i + 1
    }
}
