module main

use pbpk::rapamycin_population_composite::{
    pwc_cert_n7, pwc_warn_n7, pwc_alarm_n7, pwc_gap_n7,
    pwc_cert_n14, pwc_warn_n14, pwc_alarm_n14, pwc_gap_n14,
    pwc_cert_n28, pwc_warn_n28, pwc_alarm_n28, pwc_gap_n28,
    pwc_gain_n7_to_n14, pwc_gain_n14_to_n28, pwc_total_gain
}
use pbpk::rapamycin_inh_trajectory::{iht_margin_n7, iht_margin_n14, iht_margin_n28}
use pbpk::rapamycin_slow_adjusted::{sa_margin_n7, sa_margin_n14, sa_margin_n28}
use pbpk::rapamycin_std_trajectory::{stt_margin_n7, stt_margin_n14, stt_margin_n28}
use pbpk::rapamycin_fast_adjusted::{fa_margin_n7, fa_margin_n14, fa_margin_n28}
use pbpk::rapamycin_ind_trajectory::{it_margin_n7, it_margin_n14, it_margin_n28}

fn main() with Mut, Div, Panic, IO {
    print("=== Per-stratum margins at monitoring visits ===\n")
    print("inh  N=7: "); print_f64(iht_margin_n7()); print("\n")
    print("slow N=7: "); print_f64(sa_margin_n7()); print("\n")
    print("std  N=7: "); print_f64(stt_margin_n7()); print("\n")
    print("fast N=7: "); print_f64(fa_margin_n7()); print("\n")
    print("ind  N=7: "); print_f64(it_margin_n7()); print("\n")
    print("\n")
    print("inh  N=14: "); print_f64(iht_margin_n14()); print("\n")
    print("slow N=14: "); print_f64(sa_margin_n14()); print("\n")
    print("std  N=14: "); print_f64(stt_margin_n14()); print("\n")
    print("fast N=14: "); print_f64(fa_margin_n14()); print("\n")
    print("ind  N=14: "); print_f64(it_margin_n14()); print("\n")
    print("\n")
    print("inh  N=28: "); print_f64(iht_margin_n28()); print("\n")
    print("slow N=28: "); print_f64(sa_margin_n28()); print("\n")
    print("std  N=28: "); print_f64(stt_margin_n28()); print("\n")
    print("fast N=28: "); print_f64(fa_margin_n28()); print("\n")
    print("ind  N=28: "); print_f64(it_margin_n28()); print("\n")
    print("\n")
    print("=== Population composite ===\n")
    print("N=7  cert: "); print_f64(pwc_cert_n7());  print("\n")
    print("N=7  warn: "); print_f64(pwc_warn_n7());  print("\n")
    print("N=7  alarm:"); print_f64(pwc_alarm_n7()); print("\n")
    print("N=7  gap:  "); print_f64(pwc_gap_n7());   print("\n")
    print("\n")
    print("N=14 cert: "); print_f64(pwc_cert_n14());  print("\n")
    print("N=14 warn: "); print_f64(pwc_warn_n14());  print("\n")
    print("N=14 alarm:"); print_f64(pwc_alarm_n14()); print("\n")
    print("N=14 gap:  "); print_f64(pwc_gap_n14());   print("\n")
    print("\n")
    print("N=28 cert: "); print_f64(pwc_cert_n28());  print("\n")
    print("N=28 warn: "); print_f64(pwc_warn_n28());  print("\n")
    print("N=28 alarm:"); print_f64(pwc_alarm_n28()); print("\n")
    print("N=28 gap:  "); print_f64(pwc_gap_n28());   print("\n")
    print("\n")
    print("=== Convergence ===\n")
    print("gain N=7→14: "); print_f64(pwc_gain_n7_to_n14());  print("\n")
    print("gain N=14→28:"); print_f64(pwc_gain_n14_to_n28()); print("\n")
    print("total gain:  "); print_f64(pwc_total_gain());       print("\n")
}
