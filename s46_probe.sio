// Sprint 46 probe: GUM uncertainty budget decomposition at N_crit
// For each stratum, compute fraction of U_c^2 from each variance channel.
// Verify: u^2_ka + u^2_F + u^2_ke + u^2_k12 + u^2_k21 == u^2_total

module main

use pbpk::rapamycin_expanded_u::{eu_u_c}
use pbpk::rapamycin_oral_budget::{
    ob_ka_var_std, ob_f_var_std, ob_ke_var_std, ob_k12_var_std, ob_k21_var_std,
    ob_ke_var_inh, ob_ke_var_ind
}

// u_c with only one channel active (square = partial variance contribution)
fn uc_ka(d: f64, n: i64, ke: f64, f: f64,
         ka_v: f64) -> f64
    with Mut, Div, Panic {
    eu_u_c(d, n, ke, f, ka_v, 0.0, 0.0, 0.0, 0.0)
}
fn uc_fv(d: f64, n: i64, ke: f64, f: f64,
         f_v: f64) -> f64
    with Mut, Div, Panic {
    eu_u_c(d, n, ke, f, 0.0, f_v, 0.0, 0.0, 0.0)
}
fn uc_ke(d: f64, n: i64, ke: f64, f: f64,
         ke_v: f64) -> f64
    with Mut, Div, Panic {
    eu_u_c(d, n, ke, f, 0.0, 0.0, ke_v, 0.0, 0.0)
}
fn uc_k12(d: f64, n: i64, ke: f64, f: f64,
          k12_v: f64) -> f64
    with Mut, Div, Panic {
    eu_u_c(d, n, ke, f, 0.0, 0.0, 0.0, k12_v, 0.0)
}
fn uc_k21(d: f64, n: i64, ke: f64, f: f64,
          k21_v: f64) -> f64
    with Mut, Div, Panic {
    eu_u_c(d, n, ke, f, 0.0, 0.0, 0.0, 0.0, k21_v)
}

fn main() with Mut, Div, Panic, IO {
    let ka  = ob_ka_var_std()
    let fv  = ob_f_var_std()
    let ke  = ob_ke_var_std()
    let k12 = ob_k12_var_std()
    let k21 = ob_k21_var_std()
    let ke_inh = ob_ke_var_inh()
    let ke_ind = ob_ke_var_ind()

    print("=== Variance components (raw u values per channel) ===\n")
    print("ka_v="); print_f64(ka); print("\n")
    print("f_v=");  print_f64(fv); print("\n")
    print("ke_v="); print_f64(ke); print("\n")
    print("k12_v=");print_f64(k12); print("\n")
    print("k21_v=");print_f64(k21); print("\n")
    print("ke_inh_v=");print_f64(ke_inh); print("\n")
    print("ke_ind_v=");print_f64(ke_ind); print("\n")

    print("\n=== std D=5mg N=6 (N_crit) ===\n")
    let utot_std = eu_u_c(5.0,6,0.01118,0.141, ka,fv,ke,k12,k21)
    let uka_std  = uc_ka(5.0,6,0.01118,0.141, ka)
    let uf_std   = uc_fv(5.0,6,0.01118,0.141, fv)
    let uke_std  = uc_ke(5.0,6,0.01118,0.141, ke)
    let uk12_std = uc_k12(5.0,6,0.01118,0.141, k12)
    let uk21_std = uc_k21(5.0,6,0.01118,0.141, k21)
    print("u_total="); print_f64(utot_std); print("\n")
    print("u_ka="); print_f64(uka_std); print(" frac="); print_f64(uka_std*uka_std/(utot_std*utot_std)); print("\n")
    print("u_F=");  print_f64(uf_std);  print(" frac="); print_f64(uf_std*uf_std/(utot_std*utot_std)); print("\n")
    print("u_ke="); print_f64(uke_std); print(" frac="); print_f64(uke_std*uke_std/(utot_std*utot_std)); print("\n")
    print("u_k12=");print_f64(uk12_std);print(" frac="); print_f64(uk12_std*uk12_std/(utot_std*utot_std)); print("\n")
    print("u_k21=");print_f64(uk21_std);print(" frac="); print_f64(uk21_std*uk21_std/(utot_std*utot_std)); print("\n")
    let sum_sq_std = uka_std*uka_std + uf_std*uf_std + uke_std*uke_std + uk12_std*uk12_std + uk21_std*uk21_std
    print("sum_sq="); print_f64(sum_sq_std); print(" total_sq="); print_f64(utot_std*utot_std); print("\n")

    print("\n=== slow D=5mg N=3 (N_crit) ===\n")
    let utot_slow = eu_u_c(5.0,3,0.00838,0.188, ka,fv,ke,k12,k21)
    let uka_slow  = uc_ka(5.0,3,0.00838,0.188, ka)
    let uf_slow   = uc_fv(5.0,3,0.00838,0.188, fv)
    let uke_slow  = uc_ke(5.0,3,0.00838,0.188, ke)
    let uk12_slow = uc_k12(5.0,3,0.00838,0.188, k12)
    let uk21_slow = uc_k21(5.0,3,0.00838,0.188, k21)
    print("u_total="); print_f64(utot_slow); print("\n")
    print("u_ka="); print_f64(uka_slow); print(" frac="); print_f64(uka_slow*uka_slow/(utot_slow*utot_slow)); print("\n")
    print("u_F=");  print_f64(uf_slow);  print(" frac="); print_f64(uf_slow*uf_slow/(utot_slow*utot_slow)); print("\n")
    print("u_ke="); print_f64(uke_slow); print(" frac="); print_f64(uke_slow*uke_slow/(utot_slow*utot_slow)); print("\n")
    print("u_k12=");print_f64(uk12_slow);print(" frac="); print_f64(uk12_slow*uk12_slow/(utot_slow*utot_slow)); print("\n")
    print("u_k21=");print_f64(uk21_slow);print(" frac="); print_f64(uk21_slow*uk21_slow/(utot_slow*utot_slow)); print("\n")

    print("\n=== fast D=5mg N=15 (N_crit) ===\n")
    let utot_fast = eu_u_c(5.0,15,0.01677,0.094, ka,fv,ke,k12,k21)
    let uka_fast  = uc_ka(5.0,15,0.01677,0.094, ka)
    let uf_fast   = uc_fv(5.0,15,0.01677,0.094, fv)
    let uke_fast  = uc_ke(5.0,15,0.01677,0.094, ke)
    let uk12_fast = uc_k12(5.0,15,0.01677,0.094, k12)
    let uk21_fast = uc_k21(5.0,15,0.01677,0.094, k21)
    print("u_total="); print_f64(utot_fast); print("\n")
    print("u_ka="); print_f64(uka_fast); print(" frac="); print_f64(uka_fast*uka_fast/(utot_fast*utot_fast)); print("\n")
    print("u_F=");  print_f64(uf_fast);  print(" frac="); print_f64(uf_fast*uf_fast/(utot_fast*utot_fast)); print("\n")
    print("u_ke="); print_f64(uke_fast); print(" frac="); print_f64(uke_fast*uke_fast/(utot_fast*utot_fast)); print("\n")
    print("u_k12=");print_f64(uk12_fast);print(" frac="); print_f64(uk12_fast*uk12_fast/(utot_fast*utot_fast)); print("\n")
    print("u_k21=");print_f64(uk21_fast);print(" frac="); print_f64(uk21_fast*uk21_fast/(utot_fast*utot_fast)); print("\n")

    print("\n=== inh D=1.5mg N=7 (N_crit) ===\n")
    let utot_inh = eu_u_c(1.5,7,0.002236,0.282, ka,fv,ke_inh,k12,k21)
    let uka_inh  = uc_ka(1.5,7,0.002236,0.282, ka)
    let uf_inh   = uc_fv(1.5,7,0.002236,0.282, fv)
    let uke_inh  = uc_ke(1.5,7,0.002236,0.282, ke_inh)
    let uk12_inh = uc_k12(1.5,7,0.002236,0.282, k12)
    let uk21_inh = uc_k21(1.5,7,0.002236,0.282, k21)
    print("u_total="); print_f64(utot_inh); print("\n")
    print("u_ka="); print_f64(uka_inh); print(" frac="); print_f64(uka_inh*uka_inh/(utot_inh*utot_inh)); print("\n")
    print("u_F=");  print_f64(uf_inh);  print(" frac="); print_f64(uf_inh*uf_inh/(utot_inh*utot_inh)); print("\n")
    print("u_ke="); print_f64(uke_inh); print(" frac="); print_f64(uke_inh*uke_inh/(utot_inh*utot_inh)); print("\n")
    print("u_k12=");print_f64(uk12_inh);print(" frac="); print_f64(uk12_inh*uk12_inh/(utot_inh*utot_inh)); print("\n")
    print("u_k21=");print_f64(uk21_inh);print(" frac="); print_f64(uk21_inh*uk21_inh/(utot_inh*utot_inh)); print("\n")

    print("\n=== ind D=34mg N=26 (N_crit) ===\n")
    let utot_ind = eu_u_c(34.0,26,0.05590,0.047, ka,fv,ke_ind,k12,k21)
    let uka_ind  = uc_ka(34.0,26,0.05590,0.047, ka)
    let uf_ind   = uc_fv(34.0,26,0.05590,0.047, fv)
    let uke_ind  = uc_ke(34.0,26,0.05590,0.047, ke_ind)
    let uk12_ind = uc_k12(34.0,26,0.05590,0.047, k12)
    let uk21_ind = uc_k21(34.0,26,0.05590,0.047, k21)
    print("u_total="); print_f64(utot_ind); print("\n")
    print("u_ka="); print_f64(uka_ind); print(" frac="); print_f64(uka_ind*uka_ind/(utot_ind*utot_ind)); print("\n")
    print("u_F=");  print_f64(uf_ind);  print(" frac="); print_f64(uf_ind*uf_ind/(utot_ind*utot_ind)); print("\n")
    print("u_ke="); print_f64(uke_ind); print(" frac="); print_f64(uke_ind*uke_ind/(utot_ind*utot_ind)); print("\n")
    print("u_k12=");print_f64(uk12_ind);print(" frac="); print_f64(uk12_ind*uk12_ind/(utot_ind*utot_ind)); print("\n")
    print("u_k21=");print_f64(uk21_ind);print(" frac="); print_f64(uk21_ind*uk21_ind/(utot_ind*utot_ind)); print("\n")

    print("\n=== Budget at N_peak for unimodal strata ===\n")
    print("std N_peak=19:\n")
    let up_tot = eu_u_c(5.0,19,0.01118,0.141, ka,fv,ke,k12,k21)
    let up_ka  = uc_ka(5.0,19,0.01118,0.141, ka)
    let up_fv  = uc_fv(5.0,19,0.01118,0.141, fv)
    print("u_ka frac="); print_f64(up_ka*up_ka/(up_tot*up_tot)); print("\n")
    print("u_F  frac="); print_f64(up_fv*up_fv/(up_tot*up_tot)); print("\n")

    print("inh N_peak=22:\n")
    let up_inh_tot = eu_u_c(1.5,22,0.002236,0.282, ka,fv,ke_inh,k12,k21)
    let up_inh_ka  = uc_ka(1.5,22,0.002236,0.282, ka)
    let up_inh_fv  = uc_fv(1.5,22,0.002236,0.282, fv)
    print("u_ka frac="); print_f64(up_inh_ka*up_inh_ka/(up_inh_tot*up_inh_tot)); print("\n")
    print("u_F  frac="); print_f64(up_inh_fv*up_inh_fv/(up_inh_tot*up_inh_tot)); print("\n")
}
