// Omega Sprint 4.0 Genesis - self-verifying QIR emitter.
//
// Canonical hardware-first emitter that produces deterministic QIR shim,
// quantum controller payload, and gate bootstrap metadata from live
// epistemic telemetry.

use hardware::kaxi::*

let OMEGA_GENESIS_EMITTER_SCHEMA: string = "sounio.omega.genesis-emitter.v1"

fn omega_genesis_policy_fold(policy_id: string, policy_mode: string, target: string) -> i64 {
    let id_len = str_len(policy_id)
    let mode_len = str_len(policy_mode)
    let target_len = str_len(target)
    id_len * 109 + mode_len * 61 + target_len * 31 + 41
}

fn omega_genesis_emit_qir_shim(
    policy_id: string,
    policy_mode: string,
    target: string,
    hw_log_q32_32: i64,
    variance_q32_32: i64,
    poll_overhead_us: i64
) -> string with Alloc {
    let fold = omega_genesis_policy_fold(policy_id, policy_mode, target)
    "{\"schema\":\"" ++ OMEGA_GENESIS_EMITTER_SCHEMA ++
    "\",\"kind\":\"qir_shim\",\"mode\":\"selfhost-emitter\",\"genesis\":true,\"policy_fold\":" ++
    kaxi_i64_to_string(fold) ++
    ",\"hw_log_q32_32\":" ++ kaxi_i64_to_string(hw_log_q32_32) ++
    ",\"variance_q32_32\":" ++ kaxi_i64_to_string(variance_q32_32) ++
    ",\"poll_overhead_us\":" ++ kaxi_i64_to_string(poll_overhead_us) ++ "}"
}

fn omega_genesis_emit_quantum_controller(
    policy_id: string,
    policy_mode: string,
    target: string,
    hybrid_log_q32_32: i64,
    variance_q32_32: i64
) -> string with Alloc {
    let fold = omega_genesis_policy_fold(policy_id, policy_mode, target)
    "{\"schema\":\"" ++ OMEGA_GENESIS_EMITTER_SCHEMA ++
    "\",\"kind\":\"quantum_controller\",\"mode\":\"selfhost-emitter\",\"genesis\":true,\"policy_fold\":" ++
    kaxi_i64_to_string(fold) ++
    ",\"hybrid_log_q32_32\":" ++ kaxi_i64_to_string(hybrid_log_q32_32) ++
    ",\"variance_q32_32\":" ++ kaxi_i64_to_string(variance_q32_32) ++ "}"
}

fn omega_genesis_emit_gate_bootstrap(
    policy_id: string,
    target: string,
    aggregate_hash_l64: i64
) -> string with Alloc {
    "{\"schema\":\"" ++ OMEGA_GENESIS_EMITTER_SCHEMA ++
    "\",\"kind\":\"gate_bootstrap\",\"mode\":\"selfhost-emitter\",\"genesis\":true,\"policy_id\":\"" ++
    policy_id ++
    "\",\"target\":\"" ++ target ++
    "\",\"aggregate_hash_l64\":" ++ kaxi_i64_to_string(aggregate_hash_l64) ++ "}"
}

fn omega_genesis_emit_bundle(
    policy_id: string,
    policy_mode: string,
    target: string,
    hw_log_q32_32: i64,
    hybrid_log_q32_32: i64,
    variance_q32_32: i64,
    poll_overhead_us: i64,
    aggregate_hash_l64: i64
) -> string with Alloc {
    let shim = omega_genesis_emit_qir_shim(
        policy_id,
        policy_mode,
        target,
        hw_log_q32_32,
        variance_q32_32,
        poll_overhead_us
    )
    let controller = omega_genesis_emit_quantum_controller(
        policy_id,
        policy_mode,
        target,
        hybrid_log_q32_32,
        variance_q32_32
    )
    let bootstrap = omega_genesis_emit_gate_bootstrap(
        policy_id,
        target,
        aggregate_hash_l64
    )
    "genesis_mode=selfhost-emitter;" ++ shim ++ ";" ++ controller ++ ";" ++ bootstrap
}

fn omega_genesis_self_check() -> bool with Alloc {
    let bundle = omega_genesis_emit_bundle(
        "sounio-cutover-policy",
        "shadow",
        "linux-x86_64",
        0,
        8388608,
        25165824,
        350,
        1979
    )
    str_len(bundle) > 128 &&
    omega_genesis_policy_fold("sounio-cutover-policy", "shadow", "linux-x86_64") > 0
}

// Compatibility wrappers used by current Sprint 4 gate and souc policy eval.
fn omega_qir_policy_fold(policy_id: string, policy_mode: string, target: string) -> i64 {
    omega_genesis_policy_fold(policy_id, policy_mode, target)
}

fn omega_qir_emit_shim(
    policy_id: string,
    policy_mode: string,
    target: string,
    hw_log_q32_32: i64,
    variance_q32_32: i64,
    poll_overhead_us: i64
) -> string with Alloc {
    omega_genesis_emit_qir_shim(
        policy_id,
        policy_mode,
        target,
        hw_log_q32_32,
        variance_q32_32,
        poll_overhead_us
    )
}

fn omega_qir_emit_quantum_controller(
    policy_id: string,
    policy_mode: string,
    target: string,
    hybrid_log_q32_32: i64,
    variance_q32_32: i64
) -> string with Alloc {
    omega_genesis_emit_quantum_controller(
        policy_id,
        policy_mode,
        target,
        hybrid_log_q32_32,
        variance_q32_32
    )
}

fn omega_qir_emit_bundle(
    policy_id: string,
    policy_mode: string,
    target: string,
    hw_log_q32_32: i64,
    hybrid_log_q32_32: i64,
    variance_q32_32: i64,
    poll_overhead_us: i64
) -> string with Alloc {
    omega_genesis_emit_bundle(
        policy_id,
        policy_mode,
        target,
        hw_log_q32_32,
        hybrid_log_q32_32,
        variance_q32_32,
        poll_overhead_us,
        omega_genesis_policy_fold(policy_id, policy_mode, target)
    )
}

fn omega_qir_full_emitter_self_check() -> bool with Alloc {
    omega_genesis_self_check()
}
