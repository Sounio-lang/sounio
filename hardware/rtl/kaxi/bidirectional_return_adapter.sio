// K-AXI bidirectional return channel adapter (Sprint 3.0 foundation).
//
// Canonical self-hosted helpers for return flag packing/unpacking and replay
// inspection at the compiler<->hardware boundary.

let KAXI_RX_KIND_EPISTEMIC: i64 = 0xA1
let KAXI_RX_STATUS_OK: i64 = 0x01
let KAXI_RX_STATUS_DEGRADED: i64 = 0x02
let KAXI_RX_STATUS_FALLBACK: i64 = 0x03
let KAXI_RX_STATUS_ERROR: i64 = 0x04

// Inlined from kaxi_adapters.sio — required by replay inspect and consumer.
fn kaxi_i64_to_string(n: i64) -> string with Mut, Panic, Div, Alloc {
    if n == 0 { return "0" }
    if n < 0 { return "0" }

    var rev: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    var v = n
    while v > 0 {
        rev[rev_len as usize] = 48 + (v % 10) as i8
        rev_len = rev_len + 1
        v = v / 10
    }

    var out: [i8; 32] = [0; 32]
    var i: i64 = 0
    while i < rev_len {
        out[i as usize] = rev[(rev_len - i - 1) as usize]
        i = i + 1
    }
    str_from_bytes(out, rev_len)
}

// Pack RX header bytes in a single i64 lane for deterministic replay.
// Layout: [flags:8 | op_kind:8 | status:8 | kind:8] in low 32 bits.
fn kaxi_bidir_pack_header(kind: i64, status: i64, op_kind: i64, flags: i64) -> i64 {
    (kind & 0xFF) |
    ((status & 0xFF) << 8) |
    ((op_kind & 0xFF) << 16) |
    ((flags & 0xFF) << 24)
}

fn kaxi_bidir_unpack_kind(header: i64) -> i64 {
    header & 0xFF
}

fn kaxi_bidir_unpack_status(header: i64) -> i64 {
    (header >> 8) & 0xFF
}

fn kaxi_bidir_unpack_op_kind(header: i64) -> i64 {
    (header >> 16) & 0xFF
}

fn kaxi_bidir_unpack_flags(header: i64) -> i64 {
    (header >> 24) & 0xFF
}

fn kaxi_bidir_status_is_terminal(status: i64) -> bool {
    status == KAXI_RX_STATUS_ERROR || status == KAXI_RX_STATUS_FALLBACK
}

fn kaxi_bidir_status_name(status: i64) -> string {
    if status == KAXI_RX_STATUS_OK { return "ok" }
    if status == KAXI_RX_STATUS_DEGRADED { return "degraded" }
    if status == KAXI_RX_STATUS_FALLBACK { return "fallback" }
    if status == KAXI_RX_STATUS_ERROR { return "error" }
    "unknown"
}

fn kaxi_bidir_merkle_root_l64(
    tx_seq: i64,
    header: i64,
    fidelity_inc: i64,
    prov_depth_inc: i64,
    formal_cov_inc: i64,
    epi_log_q32_32: i64
) -> i64 {
    let s0 = (tx_seq << 7) ^ (header >> 3)
    let s1 = (fidelity_inc << 11) ^ (prov_depth_inc >> 5)
    let s2 = (formal_cov_inc << 13) ^ (epi_log_q32_32 >> 9)
    (s0 ^ s1 ^ s2) + 0x4B415849
}

fn kaxi_bidir_merkle_verify_l64(
    expected_root_l64: i64,
    tx_seq: i64,
    header: i64,
    fidelity_inc: i64,
    prov_depth_inc: i64,
    formal_cov_inc: i64,
    epi_log_q32_32: i64
) -> bool {
    expected_root_l64 == kaxi_bidir_merkle_root_l64(
        tx_seq,
        header,
        fidelity_inc,
        prov_depth_inc,
        formal_cov_inc,
        epi_log_q32_32
    )
}

fn kaxi_bidir_replay_inspect(
    tx_seq: i64,
    header: i64,
    fidelity_inc: i64,
    prov_depth_inc: i64,
    formal_cov_inc: i64,
    epi_log_q32_32: i64
) -> string with Mut, Panic, Div, Alloc {
    let kind = kaxi_bidir_unpack_kind(header)
    let status = kaxi_bidir_unpack_status(header)
    let op_kind = kaxi_bidir_unpack_op_kind(header)
    let flags = kaxi_bidir_unpack_flags(header)
    "tx_seq=" ++ kaxi_i64_to_string(tx_seq) ++
    ", kind=" ++ kaxi_i64_to_string(kind) ++
    ", status=" ++ kaxi_bidir_status_name(status) ++
    ", op_kind=" ++ kaxi_i64_to_string(op_kind) ++
    ", flags=" ++ kaxi_i64_to_string(flags) ++
    ", fidelity_inc=" ++ kaxi_i64_to_string(fidelity_inc) ++
    ", prov_depth_inc=" ++ kaxi_i64_to_string(prov_depth_inc) ++
    ", formal_cov_inc=" ++ kaxi_i64_to_string(formal_cov_inc) ++
    ", epi_log_q32_32=" ++ kaxi_i64_to_string(epi_log_q32_32)
}

fn kaxi_bidir_replay_is_epistemic(header: i64) -> bool {
    let kind = kaxi_bidir_unpack_kind(header)
    let op_kind = kaxi_bidir_unpack_op_kind(header)
    kind == KAXI_RX_KIND_EPISTEMIC && op_kind >= 1 && op_kind <= 5
}

fn kaxi_bidir_adapter_self_check() -> bool with Mut, Panic, Div, Alloc {
    let header = kaxi_bidir_pack_header(
        KAXI_RX_KIND_EPISTEMIC,
        KAXI_RX_STATUS_OK,
        4,
        0x5A
    )
    let summary = kaxi_bidir_replay_inspect(7, header, 1, 1, 1, 0)
    let merkle = kaxi_bidir_merkle_root_l64(7, header, 1, 1, 1, 0)
    let merkle_ok = kaxi_bidir_merkle_verify_l64(merkle, 7, header, 1, 1, 1, 0)
    let merkle_fail = kaxi_bidir_merkle_verify_l64(merkle + 1, 7, header, 1, 1, 1, 0)
    kaxi_bidir_unpack_kind(header) == KAXI_RX_KIND_EPISTEMIC &&
    kaxi_bidir_unpack_status(header) == KAXI_RX_STATUS_OK &&
    kaxi_bidir_unpack_op_kind(header) == 4 &&
    kaxi_bidir_unpack_flags(header) == 0x5A &&
    !kaxi_bidir_status_is_terminal(KAXI_RX_STATUS_OK) &&
    kaxi_bidir_status_is_terminal(KAXI_RX_STATUS_ERROR) &&
    kaxi_bidir_replay_is_epistemic(header) &&
    merkle_ok &&
    !merkle_fail &&
    str_len(summary) > 0
}

// ===========================================================================
// Phase 2: K-AXI Replay Consumer
// ===========================================================================

struct KaxiReplayPacket {
    tx_seq: i64,
    header: i64,
    fidelity_inc: i64,
    prov_depth_inc: i64,
    formal_cov_inc: i64,
    epi_log_q32_32: i64,
    merkle_root: i64,
}

struct KaxiReplayConsumer {
    consumed_count: i64,
    verified_count: i64,
    rejected_count: i64,
    last_status: i64,
    total_fidelity: i64,
    total_prov_depth: i64,
    total_formal_cov: i64,
}

// ---------------------------------------------------------------------------
// kaxi_replay_packet_new: auto-computes merkle_root
// ---------------------------------------------------------------------------

fn kaxi_replay_packet_new(
    tx_seq: i64,
    header: i64,
    fidelity_inc: i64,
    prov_depth_inc: i64,
    formal_cov_inc: i64,
    epi_log_q32_32: i64
) -> KaxiReplayPacket {
    let root = kaxi_bidir_merkle_root_l64(
        tx_seq, header, fidelity_inc, prov_depth_inc,
        formal_cov_inc, epi_log_q32_32
    )
    KaxiReplayPacket {
        tx_seq: tx_seq,
        header: header,
        fidelity_inc: fidelity_inc,
        prov_depth_inc: prov_depth_inc,
        formal_cov_inc: formal_cov_inc,
        epi_log_q32_32: epi_log_q32_32,
        merkle_root: root,
    }
}

// ---------------------------------------------------------------------------
// kaxi_replay_consumer_new
// ---------------------------------------------------------------------------

fn kaxi_replay_consumer_new() -> KaxiReplayConsumer {
    KaxiReplayConsumer {
        consumed_count: 0,
        verified_count: 0,
        rejected_count: 0,
        last_status: 0,
        total_fidelity: 0,
        total_prov_depth: 0,
        total_formal_cov: 0,
    }
}

// ---------------------------------------------------------------------------
// kaxi_consume_replay_packet: verify Merkle, update counters, reject if invalid
// ---------------------------------------------------------------------------

fn kaxi_consume_replay_packet(
    consumer: KaxiReplayConsumer,
    packet: KaxiReplayPacket
) -> KaxiReplayConsumer {
    let merkle_ok = kaxi_bidir_merkle_verify_l64(
        packet.merkle_root,
        packet.tx_seq,
        packet.header,
        packet.fidelity_inc,
        packet.prov_depth_inc,
        packet.formal_cov_inc,
        packet.epi_log_q32_32
    )
    let status = kaxi_bidir_unpack_status(packet.header)

    if !merkle_ok {
        // Reject packet with bad Merkle root.
        return KaxiReplayConsumer {
            consumed_count: consumer.consumed_count + 1,
            verified_count: consumer.verified_count,
            rejected_count: consumer.rejected_count + 1,
            last_status: status,
            total_fidelity: consumer.total_fidelity,
            total_prov_depth: consumer.total_prov_depth,
            total_formal_cov: consumer.total_formal_cov,
        }
    }

    // Accept packet and accumulate counters.
    KaxiReplayConsumer {
        consumed_count: consumer.consumed_count + 1,
        verified_count: consumer.verified_count + 1,
        rejected_count: consumer.rejected_count,
        last_status: status,
        total_fidelity: consumer.total_fidelity + packet.fidelity_inc,
        total_prov_depth: consumer.total_prov_depth + packet.prov_depth_inc,
        total_formal_cov: consumer.total_formal_cov + packet.formal_cov_inc,
    }
}

// ---------------------------------------------------------------------------
// kaxi_consumer_is_healthy: rejected_count < 5% of consumed
// ---------------------------------------------------------------------------

fn kaxi_consumer_is_healthy(consumer: KaxiReplayConsumer) -> bool {
    if consumer.consumed_count == 0 {
        return true
    }
    // 5% threshold: rejected * 20 < consumed
    consumer.rejected_count * 20 < consumer.consumed_count
}

// ---------------------------------------------------------------------------
// kaxi_consumer_summary: returns diagnostic string
// ---------------------------------------------------------------------------

fn kaxi_consumer_summary(consumer: KaxiReplayConsumer) -> string with Mut, Panic, Div, Alloc {
    "consumed=" ++ kaxi_i64_to_string(consumer.consumed_count) ++
    " verified=" ++ kaxi_i64_to_string(consumer.verified_count) ++
    " rejected=" ++ kaxi_i64_to_string(consumer.rejected_count) ++
    " fidelity=" ++ kaxi_i64_to_string(consumer.total_fidelity) ++
    " prov_depth=" ++ kaxi_i64_to_string(consumer.total_prov_depth) ++
    " formal_cov=" ++ kaxi_i64_to_string(consumer.total_formal_cov)
}

// ---------------------------------------------------------------------------
// kaxi_replay_consumer_self_check: consume 3 packets, verify 1 bad Merkle rejected
// ---------------------------------------------------------------------------

fn kaxi_replay_consumer_self_check() -> bool with Mut, Panic, Div, Alloc {
    let hdr1 = kaxi_bidir_pack_header(KAXI_RX_KIND_EPISTEMIC, KAXI_RX_STATUS_OK, 1, 0)
    let hdr2 = kaxi_bidir_pack_header(KAXI_RX_KIND_EPISTEMIC, KAXI_RX_STATUS_OK, 2, 0)
    let hdr3 = kaxi_bidir_pack_header(KAXI_RX_KIND_EPISTEMIC, KAXI_RX_STATUS_OK, 4, 0)

    // 3 valid packets.
    let pkt1 = kaxi_replay_packet_new(1, hdr1, 1, 1, 1, 10)
    let pkt2 = kaxi_replay_packet_new(2, hdr2, 2, 2, 2, 20)
    let pkt3 = kaxi_replay_packet_new(3, hdr3, 3, 3, 3, 30)

    // 1 intentionally bad Merkle packet.
    let bad_root = kaxi_bidir_merkle_root_l64(4, hdr1, 1, 1, 1, 0) + 9999
    let pkt_bad = KaxiReplayPacket {
        tx_seq: 4,
        header: hdr1,
        fidelity_inc: 1,
        prov_depth_inc: 1,
        formal_cov_inc: 1,
        epi_log_q32_32: 0,
        merkle_root: bad_root,
    }

    var c = kaxi_replay_consumer_new()
    c = kaxi_consume_replay_packet(c, pkt1)
    c = kaxi_consume_replay_packet(c, pkt2)
    c = kaxi_consume_replay_packet(c, pkt3)
    c = kaxi_consume_replay_packet(c, pkt_bad)

    let summary = kaxi_consumer_summary(c)

    c.consumed_count == 4 &&
    c.verified_count == 3 &&
    c.rejected_count == 1 &&
    c.total_fidelity == 6 &&
    c.total_prov_depth == 6 &&
    c.total_formal_cov == 6 &&
    !kaxi_consumer_is_healthy(c) &&   // 1/4 = 25% > 5%
    str_len(summary) > 0
}

// ===========================================================================
// Phase 2 extensions: tuple-return consume, batch consume, last_valid_seq
// ===========================================================================

// ---------------------------------------------------------------------------
// kaxi_replay_consume: verify Merkle, update counters, return (consumer, accepted)
// ---------------------------------------------------------------------------

fn kaxi_replay_consume(
    consumer: KaxiReplayConsumer,
    packet: KaxiReplayPacket
) -> (KaxiReplayConsumer, bool) {
    let merkle_ok = kaxi_bidir_merkle_verify_l64(
        packet.merkle_root,
        packet.tx_seq,
        packet.header,
        packet.fidelity_inc,
        packet.prov_depth_inc,
        packet.formal_cov_inc,
        packet.epi_log_q32_32
    )
    let status = kaxi_bidir_unpack_status(packet.header)

    if !merkle_ok {
        let rejected = KaxiReplayConsumer {
            consumed_count: consumer.consumed_count + 1,
            verified_count: consumer.verified_count,
            rejected_count: consumer.rejected_count + 1,
            last_status: status,
            total_fidelity: consumer.total_fidelity,
            total_prov_depth: consumer.total_prov_depth,
            total_formal_cov: consumer.total_formal_cov,
        }
        return (rejected, false)
    }

    let accepted = KaxiReplayConsumer {
        consumed_count: consumer.consumed_count + 1,
        verified_count: consumer.verified_count + 1,
        rejected_count: consumer.rejected_count,
        last_status: status,
        total_fidelity: consumer.total_fidelity + packet.fidelity_inc,
        total_prov_depth: consumer.total_prov_depth + packet.prov_depth_inc,
        total_formal_cov: consumer.total_formal_cov + packet.formal_cov_inc,
    }
    (accepted, true)
}

// ---------------------------------------------------------------------------
// kaxi_replay_consume_batch: consume up to count packets from fixed array
// ---------------------------------------------------------------------------

fn kaxi_replay_consume_batch(
    consumer: KaxiReplayConsumer,
    packets: [KaxiReplayPacket; 32],
    count: i64
) -> KaxiReplayConsumer with Mut, Panic, Div {
    var c = consumer
    var i: i64 = 0
    while i < count && i < 32 {
        let pkt = packets[i as usize]
        let (next_c, accepted) = kaxi_replay_consume(c, pkt)
        c = next_c
        i = i + 1
    }
    c
}

// ---------------------------------------------------------------------------
// kaxi_replay_consume_ext_self_check: verify tuple-return and batch consume
// ---------------------------------------------------------------------------

fn kaxi_replay_consume_ext_self_check() -> bool with Mut, Panic, Div, Alloc {
    let hdr1 = kaxi_bidir_pack_header(KAXI_RX_KIND_EPISTEMIC, KAXI_RX_STATUS_OK, 1, 0)
    let hdr2 = kaxi_bidir_pack_header(KAXI_RX_KIND_EPISTEMIC, KAXI_RX_STATUS_OK, 2, 0)

    // Valid packet via tuple-return API.
    let pkt_ok = kaxi_replay_packet_new(10, hdr1, 5, 5, 5, 42)
    var c = kaxi_replay_consumer_new()
    let (c2, ok1) = kaxi_replay_consume(c, pkt_ok)
    c = c2

    // Invalid packet via tuple-return API.
    let bad_root = kaxi_bidir_merkle_root_l64(20, hdr2, 3, 3, 3, 99) + 7777
    let pkt_bad = KaxiReplayPacket {
        tx_seq: 20,
        header: hdr2,
        fidelity_inc: 3,
        prov_depth_inc: 3,
        formal_cov_inc: 3,
        epi_log_q32_32: 99,
        merkle_root: bad_root,
    }
    let (c3, ok2) = kaxi_replay_consume(c, pkt_bad)
    c = c3

    // Batch consume: build array of 32 packets, use first 2.
    let pkt_b1 = kaxi_replay_packet_new(30, hdr1, 1, 1, 1, 10)
    let pkt_b2 = kaxi_replay_packet_new(31, hdr2, 2, 2, 2, 20)
    // Fill remaining with pkt_b1 (only first 2 are consumed).
    let batch: [KaxiReplayPacket; 32] = [
        pkt_b1, pkt_b2, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1,
        pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1,
        pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1,
        pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1, pkt_b1
    ]
    c = kaxi_replay_consume_batch(c, batch, 2)

    // Verify: 1 valid tuple + 1 rejected tuple + 2 batch = 4 consumed, 3 verified, 1 rejected.
    ok1 &&
    !ok2 &&
    c.consumed_count == 4 &&
    c.verified_count == 3 &&
    c.rejected_count == 1 &&
    c.total_fidelity == 8 &&
    c.total_prov_depth == 8 &&
    c.total_formal_cov == 8
}
