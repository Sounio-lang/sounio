# K-AXI Xilinx Artix-7 synthesis — all modules
# Target: XC7A100T (63K LUT6, 240 DSP48E1, 135K FF)

# --- epistemic_mac ---
read_verilog hardware/fpga/epistemic_mac.v
hierarchy -check -top epistemic_mac
synth_xilinx -family xc7 -top epistemic_mac
stat -width
write_json hardware/fpga/epistemic_mac.xc7.netlist.json
design -reset

# --- k_axi_slave_epistemic ---
read_verilog hardware/fpga/k_axi_master.v
read_verilog hardware/fpga/k_axi_slave_epistemic.v
hierarchy -check -top k_axi_slave_epistemic
synth_xilinx -family xc7 -top k_axi_slave_epistemic
stat -width
write_json hardware/fpga/k_axi_slave.xc7.netlist.json
design -reset

# --- k_axi_master ---
read_verilog hardware/fpga/k_axi_master.v
hierarchy -check -top k_axi_master
synth_xilinx -family xc7 -top k_axi_master
stat -width
write_json hardware/fpga/k_axi_master.xc7.netlist.json
design -reset

# --- k_axi_return_mux (+ fifo) ---
read_verilog hardware/fpga/k_axi_return_fifo.v
read_verilog hardware/fpga/k_axi_return_mux.v
hierarchy -check -top k_axi_return_mux
synth_xilinx -family xc7 -top k_axi_return_mux
stat -width
write_json hardware/fpga/k_axi_return.xc7.netlist.json
design -reset

# --- epistemic_power_accumulator ---
read_verilog hardware/fpga/epistemic_power_accumulator.v
hierarchy -check -top epistemic_power_accumulator
synth_xilinx -family xc7 -top epistemic_power_accumulator
stat -width
write_json hardware/fpga/epistemic_power.xc7.netlist.json
design -reset

# --- epistemic_quantum_controller ---
read_verilog hardware/fpga/epistemic_quantum_controller.v
hierarchy -check -top epistemic_quantum_controller
synth_xilinx -family xc7 -top epistemic_quantum_controller
stat -width
write_json hardware/fpga/epistemic_quantum_controller.xc7.netlist.json
