        if obj_nk == 2 {
            let voff = ND_STR_OFF[obj as usize]
            let vlen = ND_STR_LEN[obj as usize]
            let base_slot = find_local(voff, vlen)
            let si2 = LAST_LOCAL_SI
            let is_sptr = LAST_LOCAL_IS_SPTR
            if base_slot >= 0 && si2 >= 0 {
                let fi = find_field_slot_offset(si2, fname_off, fname_len)
                let fld_si = LAST_FIELD_TYPE_SI
                // Propagate FLD_BOX_INNER_SI for Option<Box<T>> fields
                if fld_si < 0 {
                    let raw_fi_check = find_field_b4(si2, fname_off, fname_len)
                    if raw_fi_check >= 0 {
                        let fb_check = ST_FIELD_FIRST[si2 as usize]
                        let bi_check = FLD_BOX_INNER_SI[(fb_check + raw_fi_check) as usize]
                        if bi_check >= 0 {
                            LAST_FIELD_TYPE_SI = bi_check
                        }
                    }
                }
                if fi >= 0 {
                    if is_sptr == 4 {
                        // BSS/heap thin pointer (oversized struct): positive offsets from ptr
                        LAST_FIELD_LAYOUT = 1
                        emit_load_rax(base_slot)
                        let fdisp_o = fi * 8
                        // Use sub-struct test: fld_si >= 0 OR slot_count > 1 (e.g. FLD_TYPE_SI unresolved but still multi-slot)
                        if fld_si >= 0 || LAST_FIELD_SLOT_COUNT > 1 {
                            if fdisp_o > 0 { emit(0x48); emit(0x8D); emit(0x80); emit_u32(fdisp_o) }
                        } else {
                            if fdisp_o == 0 { emit(0x48); emit(0x8B); emit(0x00) }
                            else { emit(0x48); emit(0x8B); emit(0x80); emit_u32(fdisp_o) }
                        }
                    } else if is_sptr == 2 {
                        // Heap pointer (Box): positive offsets
                        LAST_FIELD_LAYOUT = 1
                        emit_load_rax(base_slot)
                        let fdisp_h = fi * 8
                        if fld_si >= 0 || LAST_FIELD_SLOT_COUNT > 1 {
                            if fdisp_h > 0 { emit(0x48); emit(0x8D); emit(0x80); emit_u32(fdisp_h) }
                        } else {
                            if fdisp_h == 0 { emit(0x48); emit(0x8B); emit(0x00) }
                            else { emit(0x48); emit(0x8B); emit(0x80); emit_u32(fdisp_h) }
                        }
                    } else if is_sptr == 1 {
                        // Stack pointer (&T): negative offsets
                        LAST_FIELD_LAYOUT = 0
                        emit_load_rax(base_slot)
                        let fdisp = 0 - (fi * 8)
                        if fld_si >= 0 || LAST_FIELD_SLOT_COUNT > 1 {
                            if fdisp != 0 { emit(0x48); emit(0x8D); emit(0x80); emit_u32(fdisp) }
                        } else {
                            emit(0x48); emit(0x8B); emit(0x80); emit_u32(fdisp)
                        }
                    } else if fld_si >= 0 || LAST_FIELD_SLOT_COUNT > 1 {
                        LAST_FIELD_LAYOUT = 0
                        emit_lea_rax(base_slot + fi)
                    } else {
                        emit_load_rax(base_slot + fi)
                    }
                } else { emit_mov_rax_imm(0) }
            } else { emit_mov_rax_imm(0) }
        } else {
            compile_node(obj)
            let lft_si = LAST_FIELD_TYPE_SI
            let lft_layout = LAST_FIELD_LAYOUT
            LAST_FIELD_TYPE_SI = -1
            if lft_si >= 0 {
                let fi2 = find_field_slot_offset(lft_si, fname_off, fname_len)
                let fld_si2 = LAST_FIELD_TYPE_SI
                let fld_is_agg2 = fld_si2 >= 0 || LAST_FIELD_SLOT_COUNT > 1
                if fi2 >= 0 {
                    let fdisp2 = if lft_layout == 1 { fi2 * 8 } else { 0 - (fi2 * 8) }
