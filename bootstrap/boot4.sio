var ND_EXTRA2: [i64; 262144] = [-1; 262144]
var ND_STR_OFF: [i64; 262144] = [0; 262144]
var ND_STR_LEN: [i64; 262144] = [0; 262144]
var ND_COUNT: i64 = 0

var FN_NAME_OFF: [i64; 2048] = [0; 2048]
