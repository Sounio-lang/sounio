var LOCAL_NAME_OFF: [i64; 8192] = [0; 8192]
var LOCAL_NAME_LEN: [i64; 8192] = [0; 8192]
var LOCAL_SLOT: [i64; 8192] = [0; 8192]
var LOCAL_STRUCT_IDX: [i64; 8192] = [-1; 8192]
var LOCAL_COUNT: i64 = 0
var NEXT_SLOT: i64 = 0
var LAST_LOCAL_SI: i64 = -1

// Global scratch pool for match fixup positions (avoids local array stack direction bug)
// 8 nesting levels x 64 arms = 512 entries
var MFPOOL: [i64; 512] = [0; 512]
var MFDEPTH: i64 = 0

var CODE: [i8; 4194304] = [0; 4194304]
var CODE_LEN: i64 = 0
var PRINT_INT_OFF: i64 = 0

var FN_CODE_OFF: [i64; 2048] = [0; 2048]
var FN_IMPL_SI: [i64; 2048] = [-1; 2048]
var FN_RET_SI: [i64; 2048] = [-1; 2048]
var FN_RET_BOX_INNER_SI: [i64; 2048] = [-1; 2048]  // for fns returning Option<Box<T>>: T's index
var CURRENT_FN_RET_SI: i64 = -1
var CURRENT_IMPL_SI: i64 = -1

var FIX_OFF: [i64; 8192] = [0; 8192]
var FIX_TARGET: [i64; 8192] = [0; 8192]
var FIX_COUNT: i64 = 0

// Sprint 229: LEA fixups for function references (fn as first-class value)
var FN_LEA_FIX_OFF: [i64; 256] = [0; 256]
var FN_LEA_FIX_TARGET: [i64; 256] = [0; 256]
var FN_LEA_FIX_COUNT: i64 = 0

var POS: i64 = 0
var LOOP_TOP: i64 = 0
var BREAK_FIXUP_OFF: [i64; 64] = [0; 64]
var BREAK_FIXUP_COUNT: i64 = 0

var MB_GL_NS: [i64; 1024] = [0; 1024]
var MB_GL_NE: [i64; 1024] = [0; 1024]
var MB_GL_OFF: [i64; 1024] = [0; 1024]
var MB_GL_SZ: [i64; 1024] = [0; 1024]
var MB_GL_COUNT: i64 = 0
var MB_BSS_TOTAL: i64 = 0
var MB_SRC_BUF_GADDR: i64 = 0
var MB_SRC_LEN_GADDR: i64 = 0

var ST_NAME_OFF: [i64; 1024] = [0; 1024]
var ST_NAME_LEN: [i64; 1024] = [0; 1024]
var ST_FIELD_COUNT: [i64; 1024] = [0; 1024]
var ST_FIELD_FIRST: [i64; 1024] = [0; 1024]
var ST_COUNT: i64 = 0

var FLD_NAME_OFF: [i64; 8192] = [0; 8192]
var FLD_NAME_LEN: [i64; 8192] = [0; 8192]
var FLD_TYPE_SI: [i64; 8192] = [-1; 8192]       // struct type index for each field (-1 if scalar)
var FLD_SLOT_COUNT: [i64; 8192] = [0; 8192]     // number of 8-byte slots per field (set during parsing)
var FLD_TYPE_NAME_OFF: [i64; 8192] = [0; 8192]  // pool offset of field type name (for re-resolution)
var FLD_TYPE_NAME_LEN: [i64; 8192] = [0; 8192]  // length of field type name
var FLD_BOX_INNER_SI: [i64; 8192] = [-1; 8192]  // for Option<Box<T>> fields: struct index of T
var FLD_COUNT: i64 = 0

var FN_PARAM_TYPE_SI: [i64; 16384] = [-1; 16384] // struct type index for each fn param
var LOCAL_IS_SPTR: [i64; 8192] = [0; 8192]       // 1 if local is pointer-to-struct
var LOCAL_BOX_INNER_SI: [i64; 8192] = [-1; 8192] // for &Option<Box<T>>: struct index of T
var LAST_LOCAL_IS_SPTR: i64 = 0
var LAST_LOCAL_BOX_INNER: i64 = -1
var LAST_FOUND_SLOT: i64 = -1
var LAST_FIELD_TYPE_SI: i64 = -1

var ELF: [i8; 4194304] = [0; 4194304]
var ELF_LEN: i64 = 0

// Import resolution globals
// IMP_FNAME_BUF: scratch buffer for constructing import file paths (e.g. "self-hosted/lexer/cursor.sio\0")
// IMP_FNAME_PTR: runtime BSS address of IMP_FNAME_BUF (set by init_imp_fname_ptr() builtin)
// IMP_POOL_OFF/LEN: POOL offsets for already-loaded import paths (de-dup)
var IMP_FNAME_BUF: [i8; 512] = [0; 512]
var IMP_FNAME_PTR: i64 = 0
var IMP_POOL_OFF: [i64; 128] = [0; 128]
var IMP_POOL_LEN: [i64; 128] = [0; 128]
var IMP_LOADED_COUNT: i64 = 0

