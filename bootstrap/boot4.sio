var MC_FIX_HIGH_WATER: i64 = 0
var MC_FN_LEA_FIX_HIGH_WATER: i64 = 0
var MC_OVF_FIX: i64 = 0
var MC_OVF_FN_LEA_FIX: i64 = 0
var MC_FIRST_FIX_OVF_FN: i64 = -1
var MC_FIRST_FIX_OVF_MODULE: i64 = -1
var MC_FIRST_FIX_OVF_KIND: i64 = 0
var MC_FIX_COUNT_TOTAL: i64 = 0
var MC_FIX_COUNT_CALL: i64 = 0
var MC_FIX_COUNT_FN_ADDR: i64 = 0
var MC_FIX_COUNT_LOCAL: i64 = 0
var MC_FIX_COUNT_EXTERNAL: i64 = 0
