            emit(0x48); emit(0x31); emit(0xD2)
            emit(0xB8); emit_u32(2)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x31); emit(0xFF)
            emit(0x48); emit(0xBE); emit_u64(src_effective_cap())
            emit(0xBA); emit_u32(3)
            emit(0x41); emit(0xBA); emit_u32(0x22)
            emit(0x49); emit(0xC7); emit(0xC0); emit_u32(0 - 1)
            emit(0x4D); emit(0x31); emit(0xC9)
            emit(0xB8); emit_u32(9)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(8)
            emit(0x48); emit(0x8B); emit(0x74); emit(0x24); emit(0)
            emit(0x48); emit(0xBA); emit_u64(src_effective_cap())
            emit(0xB8); emit_u32(0)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(16)
            emit(0xB8); emit_u32(3)
            emit(0x0F); emit(0x05)
            emit(0x58)
            emit(0x59)
            emit(0x5A)
            emit(0x48); emit(0xBA); emit_u64(MB_SRC_BUF_GADDR)
            emit(0x48); emit(0x89); emit(0x0A)
            emit(0x48); emit(0xBA); emit_u64(MB_SRC_LEN_GADDR)
            emit(0x48); emit(0x89); emit(0x02)
            return 0
        }

        if pool_match(c_off, c_len, "source_byte") && MB_SRC_BUF_GADDR != 0 {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }
            emit(0x48); emit(0xB9); emit_u64(MB_SRC_BUF_GADDR)
            emit(0x48); emit(0x8B); emit(0x09)
            emit(0x48); emit(0x01); emit(0xC1)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)
            return 0
        }

        var argc: i64 = 0
        var arg_node = ND_EXTRA[node as usize]
        var arg_slot0: i64 = 0
        var arg_slot1: i64 = 0
        var arg_slot2: i64 = 0
        var arg_slot3: i64 = 0
        while arg_node != -1 && argc < 4 {
            // For direct struct local args (NK_IDENT), pass address instead of value
            var did_lea: i64 = 0
            if ND_KIND[arg_node as usize] == 2 {
                let av_off = ND_STR_OFF[arg_node as usize]
                let av_len = ND_STR_LEN[arg_node as usize]
                let av_slot = find_local(av_off, av_len)
                if av_slot >= 0 && LAST_LOCAL_SI >= 0 && LAST_LOCAL_IS_SPTR == 0 {
                    emit_lea_rax(av_slot)
                    did_lea = 1
                } else if av_slot >= 0 && LAST_LOCAL_IS_ARR == 1 {
                    // Local array arg: pass by pointer
                    emit_lea_rax(av_slot)
                    did_lea = 1
                } else if av_slot < 0 {
                    // Not a local — check if it's a global array (byte element sz=1)
                    let av_gi = mb_find_global(av_off, av_len)
                    if av_gi >= 0 && MB_GL_SZ[av_gi as usize] == 1 {
                        // Global byte array: pass base address, not first value
                        let ga_addr = 0x700000 + MB_GL_OFF[av_gi as usize]
                        emit(0x48); emit(0xB8); emit_u64(ga_addr)
                        did_lea = 1
                    }
                }
            }
            if did_lea == 0 && ND_KIND[arg_node as usize] == 14 {
                // NK_FIELD arg: if sub-struct of is_sptr=4 parent, copy to stack (negative-offset convention)
                let fa_obj2 = ND_LEFT[arg_node as usize]
                let fa_foff2 = ND_STR_OFF[arg_node as usize]
                let fa_flen2 = ND_STR_LEN[arg_node as usize]
                if ND_KIND[fa_obj2 as usize] == 2 {
                    let fa_ooff2 = ND_STR_OFF[fa_obj2 as usize]
                    let fa_olen2 = ND_STR_LEN[fa_obj2 as usize]
                    let fa_oslot2 = find_local(fa_ooff2, fa_olen2)
                    let fa_osi2 = LAST_LOCAL_SI
                    let fa_osptr2 = LAST_LOCAL_IS_SPTR
                    if fa_oslot2 >= 0 && fa_osi2 >= 0 && fa_osptr2 == 4 {
                        let fa_fi2 = find_field_slot_offset(fa_osi2, fa_foff2, fa_flen2)
                        let fa_fsi2 = LAST_FIELD_TYPE_SI
                        if fa_fi2 >= 0 && fa_fsi2 >= 0 {
                            let fa_fc2 = struct_total_slots(fa_fsi2)
                            if fa_fc2 > 0 && fa_fc2 <= 64 {
                                let cp_base2 = NEXT_SLOT
                                var cpi2: i64 = 0
                                while cpi2 < fa_fc2 { alloc_slot(); cpi2 = cpi2 + 1 }
                                let bss_save2 = alloc_slot()
                                emit_load_rax(fa_oslot2)
                                emit_store_rax(bss_save2)
                                cpi2 = 0
                                while cpi2 < fa_fc2 {
                                    emit_load_rax(bss_save2)
                                    emit(0x48); emit(0x8B); emit(0x80); emit_u32((fa_fi2 + cpi2) * 8)
                                    emit_store_rax(cp_base2 + cpi2)
                                    cpi2 = cpi2 + 1
                                }
                                emit_lea_rax(cp_base2)
                                did_lea = 1
                            }
                        }
                    }
                }
            }
            if did_lea == 0 {
                compile_node(arg_node)
            }
            let s = alloc_slot()
            emit_store_rax(s)
            if argc == 0 { arg_slot0 = s }
            else if argc == 1 { arg_slot1 = s }
            else if argc == 2 { arg_slot2 = s }
            else { arg_slot3 = s }
            argc = argc + 1
            arg_node = ND_EXTRA[arg_node as usize]
        }
        if argc > 0 {
            emit_load_rax(arg_slot0)
            emit(0x48); emit(0x89); emit(0xC7)
        }
        if argc > 1 {
            emit_load_rax(arg_slot1)
            emit(0x48); emit(0x89); emit(0xC6)
        }
        if argc > 2 {
            emit_load_rax(arg_slot2)
            emit(0x48); emit(0x89); emit(0xC2)
        }
        if argc > 3 {
            emit_load_rax(arg_slot3)
            emit(0x48); emit(0x89); emit(0xC1)
        }

        let fn_idx = find_fn_by_name(c_off, c_len)
        if fn_idx >= 0 {
            if mc_should_elide_call_fixup(fn_idx) != 0 {
                let elide_site = CODE_LEN
                mc_note_fixup_elided(elide_site, fn_idx)
                emit_mov_rax_imm(0)
            } else {
                // Direct call — CALL rel32 with fixup
                emit(0xE8)
                let fix_pos = CODE_LEN
                emit_u32(0)
                mc_add_call_fixup(fix_pos, fn_idx)
            }
        } else {
            // Sprint 229: Indirect call — callee is a local variable holding fn pointer
            let callee_slot = find_local(c_off, c_len)
            if callee_slot >= 0 {
                emit_load_rax(callee_slot)
                emit(0xFF); emit(0xD0)  // CALL rax
            } else {
                // Unknown callee — print name bytes
                mc_record_unresolved(c_off, c_len)
                print("WARN_FN '")
                var wi: i64 = 0
                while wi < c_len && wi < 40 {
                    print_int(text_byte(c_off, wi))
                    print(" ")
                    wi = wi + 1
                }
                print("'\n")
                emit(0xE8)
                emit_u32(0)
            }
        }
        return 0
    }
    if kind == 33 {
        var stmt = ND_LEFT[node as usize]
        while stmt != -1 {
            let next_s = ND_RIGHT[stmt as usize]
            // Trailing struct return: last stmt is NK_EXPR_STMT(NK_IDENT of struct local)
            // in a struct-returning function — emit SRET stores instead of normal load
            if next_s == -1 && CURRENT_FN_RET_SI >= 0 && ND_KIND[stmt as usize] == 43 {
                let inner = ND_LEFT[stmt as usize]
                if inner != -1 {
                    let ink = ND_KIND[inner as usize]
                    if ink == 2 {
                        // Trailing NK_IDENT of struct local → SRET stores (or thin ptr return)
                        let soff = ND_STR_OFF[inner as usize]
                        let slen = ND_STR_LEN[inner as usize]
                        let sslot = find_local(soff, slen)
                        let ssi = LAST_LOCAL_SI
                        let ssptr = LAST_LOCAL_IS_SPTR
                        if sslot >= 0 && ssi >= 0 {
                            if ssptr == 4 {
                                // Oversized: return BSS ptr directly in rax
                                emit_load_rax(sslot)
                                return 0
                            }
                            let sfc = struct_total_slots(ssi)
                            emit_stack_to_sret_copy(sslot, sfc)
                            emit_mov_rax_imm(0)
                            return 0
                        }
                    } else if ink == 47 {
                        // Trailing NK_STRUCT_LIT → SRET stores (or BSS ptr for oversized)
                        let sret_fc = if CURRENT_FN_RET_SI >= 0 { struct_total_slots(CURRENT_FN_RET_SI) } else { 0 }
                        if sret_fc > 64 {
                            let bss_addr_r = 0x700000 + MB_BSS_TOTAL + OVERSIZED_BSS_OFF
                            OVERSIZED_BSS_OFF = OVERSIZED_BSS_OFF + sret_fc * 8
                            let ptr_slot_r = alloc_slot()
                            emit_mov_rax_imm(bss_addr_r)
                            emit_store_rax(ptr_slot_r)
                            compile_struct_lit_into_ptr(inner, ptr_slot_r, 0)
                            emit_load_rax(ptr_slot_r)
                            return 0
                        }
                        compile_sret_from_struct_lit(inner, 0)
                        emit_mov_rax_imm(0)
                        return 0
                    } else if ink == 12 || ink == 51 {
                        // Trailing function call returning struct — callee writes SRET_BUF
                        compile_node(stmt)
                        return 0
                    }
                }
            }
            compile_node(stmt)
            stmt = next_s
        }
        return 0
    }
    if kind == 40 || kind == 41 {
        let name_off = ND_STR_OFF[node as usize]
        let name_len = ND_STR_LEN[node as usize]
        let init = ND_LEFT[node as usize]
        var struct_si = ND_IVAL[node as usize]
        let box_inner_hint = ND_EXTRA2[node as usize]  // from &Option<Box<T>> annotation
        // Infer struct type from callee return type when no type annotation
        if struct_si < 0 && init != -1 {
            let init_nk_infer = ND_KIND[init as usize]
            if init_nk_infer == 12 || init_nk_infer == 51 {
                let callee_node = ND_LEFT[init as usize]
                let call_off_infer = ND_STR_OFF[callee_node as usize]
                let call_len_infer = ND_STR_LEN[callee_node as usize]
                let call_fn_infer = find_fn_by_name(call_off_infer, call_len_infer)
                if call_fn_infer >= 0 {
                    let ret_si_infer = FN_RET_SI[call_fn_infer as usize]
                    if ret_si_infer >= 0 {
                        struct_si = ret_si_infer
                    }
                }
            } else if init_nk_infer == 47 {
                // NK_STRUCT_LIT: struct index stored in IVAL
                let slit_si_infer = ND_IVAL[init as usize]
                if slit_si_infer >= 0 {
                    struct_si = slit_si_infer
                }
            }
        }
        if struct_si >= 0 && init != -1 && ND_KIND[init as usize] == 47 {
            let fc2 = struct_total_slots(struct_si)
            let bslot2 = add_local_struct(name_off, name_len, struct_si, fc2)
            if fc2 > 64 {
                // Oversized: claim BSS, store ptr in bslot2, write struct lit fields to BSS
                let bss_addr = 0x700000 + MB_BSS_TOTAL + OVERSIZED_BSS_OFF
                OVERSIZED_BSS_OFF = OVERSIZED_BSS_OFF + fc2 * 8
                emit_mov_rax_imm(bss_addr)
                emit_store_rax(bslot2)
                compile_struct_lit_into_ptr(init, bslot2, 0)
            } else {
                compile_struct_lit_into(init, bslot2)
            }
            return 0
        }
        if init != -1 && ND_KIND[init as usize] == 50 {
            let arr_count = ND_IVAL[init as usize]
            let ptr_slot = add_local(name_off, name_len)
            LOCAL_IS_ARR[(LOCAL_COUNT - 1) as usize] = 1
            LOCAL_ARR_ELEM_SZ[(LOCAL_COUNT - 1) as usize] = 8
            // For large arrays (> 256 elements), use a loop-based init to avoid code bloat
            if arr_count > 256 {
                // Use BSS allocation to avoid ptr_slot corruption by stack data
                // Stack approach put data at slot S+1 while ptr_slot is at S;
                // writing data[8] overwrites ptr_slot (1 slot = 8 bytes offset).
                let arr_bss_addr = 0x700000 + MB_BSS_TOTAL + OVERSIZED_BSS_OFF
                OVERSIZED_BSS_OFF = OVERSIZED_BSS_OFF + arr_count
                // Align OVERSIZED_BSS_OFF to 8 bytes
                let arr_rem = OVERSIZED_BSS_OFF - (OVERSIZED_BSS_OFF / 8) * 8
                if arr_rem != 0 { OVERSIZED_BSS_OFF = OVERSIZED_BSS_OFF + (8 - arr_rem) }
                // Store BSS base address in ptr_slot
                emit_mov_rax_imm(arr_bss_addr)
                emit_store_rax(ptr_slot)
                // BSS is zero-initialized by OS; only emit fill loop for non-zero fill
                let fill_nd2 = ND_LEFT[init as usize]
                let fill_nk2 = ND_KIND[fill_nd2 as usize]
                let fill_v2 = ND_IVAL[fill_nd2 as usize]
                if fill_nk2 != 4 || fill_v2 != 0 {
                    // compile fill value into al (rax low byte)
                    compile_node(fill_nd2)
                    // mov rdi, arr_bss_addr  (48 BF imm64)
                    emit(0x48); emit(0xBF); emit_u64(arr_bss_addr)
                    // xor rcx, rcx
                    emit(0x48); emit(0x31); emit(0xC9)
                    // loop: mov byte [rdi+rcx], al  (88 04 0F)
                    let loop_st2 = CODE_LEN
                    emit(0x88); emit(0x04); emit(0x0F)
                    // inc rcx  (48 FF C1)
                    emit(0x48); emit(0xFF); emit(0xC1)
                    // cmp rcx, arr_count  (48 81 F9 imm32)
                    emit(0x48); emit(0x81); emit(0xF9); emit_u32(arr_count)
                    // jl loop_st2  (7C rel8)
                    let jl_off2 = CODE_LEN
                    let jl_rel2 = loop_st2 - (jl_off2 + 2)
                    emit(0x7C); emit(jl_rel2)
                }
            } else {
                var ai: i64 = 0
                while ai < arr_count {
                    alloc_slot()
                    ai = ai + 1
                }
                let data_disp = 0 - ((ptr_slot + 2) * 8)
                emit(0x48); emit(0x8D); emit(0x85); emit_u32(data_disp)
                emit_store_rax(ptr_slot)
                var zi: i64 = 0
                while zi < arr_count {
                    let zdisp = 0 - ((ptr_slot + 2 + zi) * 8)
                    compile_node(ND_LEFT[init as usize])
                    emit(0x48); emit(0x89); emit(0x85); emit_u32(zdisp)
