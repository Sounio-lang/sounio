                    emit_load_rax(rv_ptr_slot)
                    emit(0x48); emit(0x8B); emit(0x80); emit_u32(rv_i * 8)
                    emit(0x48); emit(0xB9); emit_u64(0x700000 + rv_i * 8)
                    emit(0x48); emit(0x89); emit(0x01)
                    rv_i = rv_i + 1
                }
                emit_mov_rax_imm(0)
                emit_epilogue()
                return 0
            }
        }
        compile_node(val)
        emit_epilogue()
        return 0
    }
    if kind == 30 {
        let cond = ND_LEFT[node as usize]
        let then_body = ND_EXTRA[node as usize]
        let else_body = ND_EXTRA2[node as usize]
        compile_node(cond)
        emit(0x48); emit(0x85); emit(0xC0)
        emit(0x0F); emit(0x84)
        let je_pos = CODE_LEN
        emit_u32(0)
        compile_node(then_body)
        if else_body != -1 {
            emit(0xE9)
            let jmp_pos = CODE_LEN
            emit_u32(0)
            let else_off = CODE_LEN - je_pos - 4
            code_write_u32_at(je_pos, else_off)
            compile_node(else_body)
            let end_off = CODE_LEN - jmp_pos - 4
            code_write_u32_at(jmp_pos, end_off)
        } else {
            let skip_off = CODE_LEN - je_pos - 4
            code_write_u32_at(je_pos, skip_off)
        }
        return 0
    }
    if kind == 31 {
        let cond = ND_LEFT[node as usize]
        let body = ND_EXTRA[node as usize]
        let prev_loop_top = LOOP_TOP
        let prev_break_count = BREAK_FIXUP_COUNT
        let loop_top = CODE_LEN
        LOOP_TOP = loop_top
        compile_node(cond)
        emit(0x48); emit(0x85); emit(0xC0)
        emit(0x0F); emit(0x84)
        let je_pos = CODE_LEN
        emit_u32(0)
        compile_node(body)
        emit(0xE9)
        let jmp_rel = loop_top - (CODE_LEN + 4)
        emit_u32(jmp_rel)
        let loop_exit = CODE_LEN
        let exit_off = loop_exit - je_pos - 4
        code_write_u32_at(je_pos, exit_off)
        var bfi: i64 = prev_break_count
        while bfi < BREAK_FIXUP_COUNT {
            let bpos = BREAK_FIXUP_OFF[bfi as usize]
            let brel = loop_exit - bpos - 4
            code_write_u32_at(bpos, brel)
            bfi = bfi + 1
        }
        BREAK_FIXUP_COUNT = prev_break_count
        LOOP_TOP = prev_loop_top
        return 0
    }
    if kind == 35 {
        emit(0xE9)
        let brk_pos = CODE_LEN
        emit_u32(0)
        let bfi = BREAK_FIXUP_COUNT
        BREAK_FIXUP_OFF[bfi as usize] = brk_pos
        BREAK_FIXUP_COUNT = BREAK_FIXUP_COUNT + 1
        return 0
    }
    if kind == 36 {
        if LOOP_TOP > 0 {
            emit(0xE9)
            let cont_rel = LOOP_TOP - (CODE_LEN + 4)
            emit_u32(cont_rel)
        }
        return 0
    }
    if kind == 44 {
        // Determine Box inner type from scrutinee for Some bindings
        var match_box_si: i64 = -1
        let scr_nd = ND_LEFT[node as usize]
        // Common pattern: match *ptr { Some(x) => ... } where ptr is &Option<Box<T>>
        // Scrutinee is DEREF(ident) → check if ident's struct type has an Option<Box<T>> field
        // OR scrutinee is a field access → check field's FLD_BOX_INNER_SI
        if ND_KIND[scr_nd as usize] == 46 {
            let scr_inner = ND_LEFT[scr_nd as usize]
            if ND_KIND[scr_inner as usize] == 2 {
                let sc_off = ND_STR_OFF[scr_inner as usize]
                let sc_len = ND_STR_LEN[scr_inner as usize]
                find_local(sc_off, sc_len)
                let scr_si = LAST_LOCAL_SI
                // Check LOCAL_BOX_INNER_SI first (from type annotation)
                if LAST_LOCAL_BOX_INNER >= 0 {
                    match_box_si = LAST_LOCAL_BOX_INNER
                } else if scr_si >= 0 && LAST_LOCAL_IS_SPTR == 2 {
                    match_box_si = scr_si
                }
            }
        } else if ND_KIND[scr_nd as usize] == 14 {
            // Field access: check FLD_BOX_INNER_SI
            let f_obj = ND_LEFT[scr_nd as usize]
            let f_off = ND_STR_OFF[scr_nd as usize]
            let f_len = ND_STR_LEN[scr_nd as usize]
            if ND_KIND[f_obj as usize] == 2 {
                let fo_off = ND_STR_OFF[f_obj as usize]
                let fo_len = ND_STR_LEN[f_obj as usize]
                find_local(fo_off, fo_len)
                let fo_si = LAST_LOCAL_SI
                if fo_si >= 0 {
                    let fi_idx = find_field_b4(fo_si, f_off, f_len)
                    if fi_idx >= 0 {
                        let fld_base = ST_FIELD_FIRST[fo_si as usize]
                        match_box_si = FLD_BOX_INNER_SI[(fld_base + fi_idx) as usize]
                    }
                }
            }
        } else if ND_KIND[scr_nd as usize] == 2 {
            // Plain ident: if it's a Box pointer, use its type
            let sc2_off = ND_STR_OFF[scr_nd as usize]
            let sc2_len = ND_STR_LEN[scr_nd as usize]
            find_local(sc2_off, sc2_len)
            if LAST_LOCAL_SI >= 0 && LAST_LOCAL_IS_SPTR == 2 {
                match_box_si = LAST_LOCAL_SI
            }
        }
        // Check if scrutinee is a function/method call with known Box return type
        if match_box_si < 0 {
            let scr_nk = ND_KIND[scr_nd as usize]
            if scr_nk == 12 {
                let scr_callee = ND_LEFT[scr_nd as usize]
                if scr_callee != -1 {
                    let scf_off = ND_STR_OFF[scr_callee as usize]
                    let scf_len = ND_STR_LEN[scr_callee as usize]
                    let scf_fn = find_fn_by_name(scf_off, scf_len)
                    if scf_fn >= 0 {
                        match_box_si = FN_RET_BOX_INNER_SI[scf_fn as usize]
                    }
                }
            } else if scr_nk == 51 {
                let scm_off = ND_STR_OFF[scr_nd as usize]
                let scm_len = ND_STR_LEN[scr_nd as usize]
                var scm_si: i64 = 0
                while scm_si < ST_COUNT && match_box_si < 0 {
                    let scmsn_off = ST_NAME_OFF[scm_si as usize]
                    let scmsn_len = ST_NAME_LEN[scm_si as usize]
                    let scmq_off = pool_concat_colon(scmsn_off, scmsn_len, scm_off, scm_len)
                    let scmq_len = scmsn_len + 2 + scm_len
                    let scm_fn = find_fn_by_name(scmq_off, scmq_len)
                    if scm_fn >= 0 && FN_RET_BOX_INNER_SI[scm_fn as usize] >= 0 {
                        match_box_si = FN_RET_BOX_INNER_SI[scm_fn as usize]
                    }
                    scm_si = scm_si + 1
                }
            }
        }
        compile_node(scr_nd)
        // Also check LAST_FIELD_TYPE_SI set during scrutinee compilation
        if match_box_si < 0 && LAST_FIELD_TYPE_SI >= 0 {
            match_box_si = LAST_FIELD_TYPE_SI
        }
        LAST_FIELD_TYPE_SI = -1
        let scr_slot = alloc_slot()
        emit_store_rax(scr_slot)
        // Use global MFPOOL for fixup positions (avoids local array stack-direction bug)
        let mf_base = MFDEPTH
        MFDEPTH = mf_base + 64
        var efc: i64 = 0
        var arm = ND_EXTRA[node as usize]
        while arm != -1 {
            let arm_type = ND_IVAL[arm as usize]
            let body = ND_EXTRA[arm as usize]
            let next_arm = ND_RIGHT[arm as usize]
            var skip_pos: i64 = -1
            if arm_type == 0 {
                emit_load_rax(scr_slot)
                let pat_val = ND_STR_OFF[arm as usize]
                emit(0x48); emit(0xB9); emit_u64(pat_val)
                emit(0x48); emit(0x39); emit(0xC8)
                emit(0x0F); emit(0x85)
                skip_pos = CODE_LEN; emit_u32(0)
            } else if arm_type == 2 {
                // None (parser assigns 2 to None/tk68): skip if non-zero
                emit_load_rax(scr_slot)
                emit(0x48); emit(0x85); emit(0xC0)   // test rax, rax
                emit(0x0F); emit(0x85)                // JNE skip (skip if non-zero/Some)
                skip_pos = CODE_LEN; emit_u32(0)
            } else if arm_type == 3 {
                // Some (parser assigns 3 to Some/tk67): skip if zero
                emit_load_rax(scr_slot)
                emit(0x48); emit(0x85); emit(0xC0)   // test rax, rax
                emit(0x0F); emit(0x84)                // JE skip (skip if zero/None)
                skip_pos = CODE_LEN; emit_u32(0)
                // Extract Some binding: scrutinee IS the Box pointer
                let boff2 = ND_STR_OFF[arm as usize]
                let blen2 = ND_STR_LEN[arm as usize]
                if blen2 > 0 {
                    emit_load_rax(scr_slot)
                    if match_box_si >= 0 {
                        let bslot2 = add_local_sptr(boff2, blen2, match_box_si)
                        LOCAL_IS_SPTR[LOCAL_COUNT as usize - 1] = 2  // heap pointer
                        emit_store_rax(bslot2)
                    } else {
                        let bslot2 = add_local(boff2, blen2)
                        emit_store_rax(bslot2)
                    }
                }
            } else if arm_type == 4 {
                // Enum variant: compare scrutinee with discriminant value
                emit_load_rax(scr_slot)
                let disc_val = ND_STR_OFF[arm as usize]
                emit(0x48); emit(0xB9); emit_u64(disc_val)
                emit(0x48); emit(0x39); emit(0xC8)   // cmp rax, rcx
                emit(0x0F); emit(0x85)                // JNE skip
                skip_pos = CODE_LEN; emit_u32(0)
            }
            compile_node(body)
            emit(0xE9)
            MFPOOL[(mf_base + efc) as usize] = CODE_LEN
            efc = efc + 1
            emit_u32(0)
            if skip_pos >= 0 {
                let skip_off = CODE_LEN - skip_pos - 4
                code_write_u32_at(skip_pos, skip_off)
            }
            arm = next_arm
        }
        let end_pos = CODE_LEN
        var ei: i64 = 0
        while ei < efc {
            let ep = MFPOOL[(mf_base + ei) as usize]
            let rel = end_pos - ep - 4
            code_write_u32_at(ep, rel)
            ei = ei + 1
        }
        MFDEPTH = mf_base
        return 0
    }
    if kind == 51 {
        // NK_METHOD_CALL: obj.method(args) — dispatch via StructType::method(ptr_to_obj, args)
        let mc_obj = ND_LEFT[node as usize]
        let meth_off = ND_STR_OFF[node as usize]
        let meth_len = ND_STR_LEN[node as usize]
        let mc_obj_nk = ND_KIND[mc_obj as usize]
        var mc_obj_si: i64 = -1
        var mc_self_slot: i64 = -1
        if mc_obj_nk == 2 {
            let mc_voff = ND_STR_OFF[mc_obj as usize]
            let mc_vlen = ND_STR_LEN[mc_obj as usize]
            let mc_base = find_local(mc_voff, mc_vlen)
            mc_obj_si = LAST_LOCAL_SI
            let mc_is_sptr = LAST_LOCAL_IS_SPTR
            if mc_base >= 0 && mc_obj_si >= 0 {
                let mc_fc0 = struct_total_slots(mc_obj_si)
                if mc_is_sptr == 4 && mc_fc0 > 0 && mc_fc0 <= 64 {
                    // Oversized local passed as self: load BSS ptr, copy fields to stack
                    let mc_cp0 = NEXT_SLOT
                    var mc_cpi0: i64 = 0
                    while mc_cpi0 < mc_fc0 { alloc_slot(); mc_cpi0 = mc_cpi0 + 1 }
                    let mc_bss0 = alloc_slot()
                    emit_load_rax(mc_base)
                    emit_store_rax(mc_bss0)
                    mc_cpi0 = 0
                    while mc_cpi0 < mc_fc0 {
                        emit_load_rax(mc_bss0)
                        emit(0x48); emit(0x8B); emit(0x80); emit_u32(mc_cpi0 * 8)
                        emit_store_rax(mc_cp0 + mc_cpi0)
                        mc_cpi0 = mc_cpi0 + 1
                    }
                    mc_self_slot = alloc_slot()
                    emit_lea_rax(mc_cp0)
                    emit_store_rax(mc_self_slot)
                } else {
                    mc_self_slot = alloc_slot()
                    emit_lea_rax(mc_base)
                    emit_store_rax(mc_self_slot)
                }
            }
        } else if mc_obj_nk == 14 {
            // NK_FIELD: check if sub-struct of is_sptr=4 parent → copy to stack
            let mc_fa_obj = ND_LEFT[mc_obj as usize]
            let mc_fa_foff = ND_STR_OFF[mc_obj as usize]
            let mc_fa_flen = ND_STR_LEN[mc_obj as usize]
            var mc_copied: i64 = 0
            if ND_KIND[mc_fa_obj as usize] == 2 {
                let mc_fo_off = ND_STR_OFF[mc_fa_obj as usize]
                let mc_fo_len = ND_STR_LEN[mc_fa_obj as usize]
                let mc_fo_slot = find_local(mc_fo_off, mc_fo_len)
                let mc_fo_si = LAST_LOCAL_SI
                let mc_fo_sptr = LAST_LOCAL_IS_SPTR
                if mc_fo_slot >= 0 && mc_fo_si >= 0 && mc_fo_sptr == 4 {
                    let mc_fi = find_field_slot_offset(mc_fo_si, mc_fa_foff, mc_fa_flen)
                    var mc_fsi = LAST_FIELD_TYPE_SI
                    // FLD_TYPE_SI may be unresolved (-1); infer field type from method name
                    if mc_fi >= 0 && mc_fsi < 0 {
                        var try_si2: i64 = 0
                        while try_si2 < ST_COUNT && mc_fsi < 0 {
                            let try_sn_off2 = ST_NAME_OFF[try_si2 as usize]
                            let try_sn_len2 = ST_NAME_LEN[try_si2 as usize]
                            let try_q_off2 = pool_concat_colon(try_sn_off2, try_sn_len2, meth_off, meth_len)
                            let try_q_len2 = try_sn_len2 + 2 + meth_len
                            if find_fn_by_name(try_q_off2, try_q_len2) >= 0 {
                                mc_fsi = try_si2
                            }
                            try_si2 = try_si2 + 1
                        }
                    }
                    if mc_fi >= 0 && mc_fsi >= 0 {
                        let mc_ffc = struct_total_slots(mc_fsi)
                        if mc_ffc > 0 && mc_ffc <= 64 {
                            let mc_cp_base = NEXT_SLOT
                            var mc_cpi: i64 = 0
                            while mc_cpi < mc_ffc { alloc_slot(); mc_cpi = mc_cpi + 1 }
                            let mc_bss_save = alloc_slot()
                            emit_load_rax(mc_fo_slot)
                            emit_store_rax(mc_bss_save)
                            mc_cpi = 0
                            while mc_cpi < mc_ffc {
                                emit_load_rax(mc_bss_save)
                                emit(0x48); emit(0x8B); emit(0x80); emit_u32((mc_fi + mc_cpi) * 8)
                                emit_store_rax(mc_cp_base + mc_cpi)
                                mc_cpi = mc_cpi + 1
                            }
                            mc_obj_si = mc_fsi
                            mc_self_slot = alloc_slot()
                            emit_lea_rax(mc_cp_base)
                            emit_store_rax(mc_self_slot)
                            mc_copied = 1
                        }
                    }
                }
            }
            if mc_copied == 0 {
                compile_node(mc_obj)
                mc_obj_si = LAST_FIELD_TYPE_SI
                mc_self_slot = alloc_slot()
                emit_store_rax(mc_self_slot)
            }
        } else {
            compile_node(mc_obj)
            mc_obj_si = LAST_FIELD_TYPE_SI
            mc_self_slot = alloc_slot()
            emit_store_rax(mc_self_slot)
        }
        var mc_q_off: i64 = meth_off
        var mc_q_len: i64 = meth_len
        if mc_obj_si >= 0 {
            let mc_sn_off = ST_NAME_OFF[mc_obj_si as usize]
            let mc_sn_len = ST_NAME_LEN[mc_obj_si as usize]
            mc_q_off = pool_concat_colon(mc_sn_off, mc_sn_len, meth_off, meth_len)
            mc_q_len = mc_sn_len + 2 + meth_len
        }
        var mc_argc: i64 = 1
        var mc_as0: i64 = mc_self_slot
        var mc_as1: i64 = -1
        var mc_as2: i64 = -1
        var mc_as3: i64 = -1
        var mc_an = ND_EXTRA[node as usize]
        while mc_an != -1 && mc_argc < 4 {
            compile_node(mc_an)
            let mc_s = alloc_slot()
            emit_store_rax(mc_s)
            if mc_argc == 1 { mc_as1 = mc_s }
            else if mc_argc == 2 { mc_as2 = mc_s }
            else { mc_as3 = mc_s }
            mc_argc = mc_argc + 1
            mc_an = ND_EXTRA[mc_an as usize]
        }
        if mc_as0 >= 0 { emit_load_rax(mc_as0); emit(0x48); emit(0x89); emit(0xC7) }
        if mc_as1 >= 0 { emit_load_rax(mc_as1); emit(0x48); emit(0x89); emit(0xC6) }
        if mc_as2 >= 0 { emit_load_rax(mc_as2); emit(0x48); emit(0x89); emit(0xC2) }
        if mc_as3 >= 0 { emit_load_rax(mc_as3); emit(0x48); emit(0x89); emit(0xC1) }
        var mc_fn_idx = find_fn_by_name(mc_q_off, mc_q_len)
        // Fallback: if method not found, try all structs as potential receivers
        if mc_fn_idx < 0 {
            var try_si: i64 = 0
            while try_si < ST_COUNT && mc_fn_idx < 0 {
                let try_sn_off = ST_NAME_OFF[try_si as usize]
                let try_sn_len = ST_NAME_LEN[try_si as usize]
                let try_q_off = pool_concat_colon(try_sn_off, try_sn_len, meth_off, meth_len)
                let try_q_len = try_sn_len + 2 + meth_len
                mc_fn_idx = find_fn_by_name(try_q_off, try_q_len)
                try_si = try_si + 1
            }
        }
        if mc_fn_idx >= 0 {
            if mc_should_elide_call_fixup(mc_fn_idx) != 0 {
                let mc_elide_site = CODE_LEN
                mc_note_fixup_elided(mc_elide_site, mc_fn_idx)
                emit_mov_rax_imm(0)
            } else {
                emit(0xE8)
                let mc_fix_pos = CODE_LEN
                emit_u32(0)
                mc_add_call_fixup(mc_fix_pos, mc_fn_idx)
            }
        } else {
            emit(0xE8)
            emit_u32(0)
        }
        return 0
    }
    0
}

// Emit a rep movsq copy from SRET_BUF (0x700000) to stack slot bslot, count qwords.
fn emit_sret_to_stack_copy(bslot: i64, count: i64) with Mut, Panic, Div {
    if count <= 64 {
        var i: i64 = 0
        while i < count {
            emit(0x48); emit(0xB9); emit_u64(0x700000 + i * 8)
            emit(0x48); emit(0x8B); emit(0x01)
            emit_store_rax(bslot + i)
            i = i + 1
        }
    } else {
        emit(0x48); emit(0xBE); emit_u64(0x700000)
        let dest_disp = 0 - ((bslot + 1) * 8)
        emit(0x48); emit(0x8D); emit(0xBD); emit_u32(dest_disp)
        emit(0x48); emit(0xB9); emit_u64(count)
        emit(0xF3); emit(0x48); emit(0xA5)
    }
}

// Emit a rep movsq copy from stack slot bslot to SRET_BUF (0x700000), count qwords.
fn emit_stack_to_sret_copy(bslot: i64, count: i64) with Mut, Panic, Div {
    if count <= 64 {
        var i: i64 = 0
        while i < count {
            emit_load_rax(bslot + i)
            emit(0x48); emit(0xB9); emit_u64(0x700000 + i * 8)
            emit(0x48); emit(0x89); emit(0x01)
            i = i + 1
        }
    } else {
        let src_disp = 0 - ((bslot + 1) * 8)
        emit(0x48); emit(0x8D); emit(0xB5); emit_u32(src_disp)
        emit(0x48); emit(0xBF); emit_u64(0x700000)
        emit(0x48); emit(0xB9); emit_u64(count)
        emit(0xF3); emit(0x48); emit(0xA5)
    }
}

fn compile_array_fill_to_stack(fill_node: i64, bslot: i64, count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        compile_node(fill_node)
        emit_store_rax(bslot + i)
        i = i + 1
    }
}

fn compile_array_fill_to_ptr(fill_node: i64, ptr_slot: i64, base_fi: i64, count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        compile_node(fill_node)
        emit_load_rcx(ptr_slot)
        emit(0x48); emit(0x89); emit(0x81); emit_u32((base_fi + i) * 8)
        i = i + 1
    }
}

fn compile_array_fill_to_sret(fill_node: i64, base_fi: i64, count: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        compile_node(fill_node)
        emit(0x48); emit(0xB9); emit_u64(0x700000 + (base_fi + i) * 8)
        emit(0x48); emit(0x89); emit(0x01)
        i = i + 1
    }
}

// Emit SRET stores from a NK_STRUCT_LIT node directly to SRET_BUF (0x700000 + fi*8).
// Used for trailing struct literal expressions in struct-returning functions.
fn compile_sret_from_struct_lit(node: i64, base_fi: i64) with Mut, Panic, Div {
    let slit_si = ND_IVAL[node as usize]
    var fni = ND_EXTRA[node as usize]
    while fni != -1 {
        let fi = ND_IVAL[fni as usize]
        let fval = ND_LEFT[fni as usize]
        if fi >= 0 {
            if ND_KIND[fval as usize] == 47 {
                compile_sret_from_struct_lit(fval, base_fi + fi)
            } else if ND_KIND[fval as usize] == 50 {
                let field_slots = if slit_si >= 0 { field_slot_width_by_offset(slit_si, fi) } else { 1 }
                let arr_count = ND_IVAL[fval as usize]
                let fill_count = if arr_count > 0 && arr_count < field_slots { arr_count } else { field_slots }
                compile_array_fill_to_sret(ND_LEFT[fval as usize], base_fi + fi, fill_count)
            } else {
                compile_node(fval)
                emit(0x48); emit(0xB9); emit_u64(0x700000 + (base_fi + fi) * 8)
                emit(0x48); emit(0x89); emit(0x01)
            }
        }
        fni = ND_RIGHT[fni as usize]
    }
}

// Recursively initialize struct fields from a NK_STRUCT_LIT node into bslot..bslot+n stack slots.
// Handles nested struct literals by recursing rather than calling compile_node.
fn compile_struct_lit_into(node: i64, bslot: i64) with Mut, Panic, Div {
    let slit_si = ND_IVAL[node as usize]
    var fni = ND_EXTRA[node as usize]
    while fni != -1 {
        let fi = ND_IVAL[fni as usize]
        let fval = ND_LEFT[fni as usize]
        if fi >= 0 {
            if ND_KIND[fval as usize] == 47 {
                compile_struct_lit_into(fval, bslot + fi)
            } else if ND_KIND[fval as usize] == 50 {
                let field_slots = if slit_si >= 0 { field_slot_width_by_offset(slit_si, fi) } else { 1 }
                let arr_count = ND_IVAL[fval as usize]
                let fill_count = if arr_count > 0 && arr_count < field_slots { arr_count } else { field_slots }
                compile_array_fill_to_stack(ND_LEFT[fval as usize], bslot + fi, fill_count)
            } else {
                compile_node(fval)
                emit_store_rax(bslot + fi)
            }
        }
        fni = ND_RIGHT[fni as usize]
    }
}

// Emit stores from NK_STRUCT_LIT into a BSS/heap thin pointer (is_sptr=4).
// ptr_slot is a 1-slot local holding the base address.
// base_fi is the cumulative slot offset for nested structs.
fn compile_struct_lit_into_ptr(node: i64, ptr_slot: i64, base_fi: i64) with Mut, Panic, Div {
    let slit_si = ND_IVAL[node as usize]
    var fni = ND_EXTRA[node as usize]
    while fni != -1 {
        let fi = ND_IVAL[fni as usize]
        let fval = ND_LEFT[fni as usize]
        if fi >= 0 {
            let fval_nk = ND_KIND[fval as usize]
            if fval_nk == 47 {
                // Nested struct literal: recurse with adjusted base
                compile_struct_lit_into_ptr(fval, ptr_slot, base_fi + fi)
            } else if fval_nk == 50 {
                let field_slots = if slit_si >= 0 { field_slot_width_by_offset(slit_si, fi) } else { 1 }
                let arr_count = ND_IVAL[fval as usize]
                let fill_count = if arr_count > 0 && arr_count < field_slots { arr_count } else { field_slots }
                compile_array_fill_to_ptr(ND_LEFT[fval as usize], ptr_slot, base_fi + fi, fill_count)
            } else if fval_nk == 12 || fval_nk == 51 {
                // Function call: check if it returns a struct via SRET
                var call_fc: i64 = 0
                let callee_nd2 = ND_LEFT[fval as usize]
                let call_off2 = ND_STR_OFF[callee_nd2 as usize]
                let call_len2 = ND_STR_LEN[callee_nd2 as usize]
                let call_fn2 = find_fn_by_name(call_off2, call_len2)
                if call_fn2 >= 0 {
                    let ret_si2 = FN_RET_SI[call_fn2 as usize]
                    if ret_si2 >= 0 { call_fc = struct_total_slots(ret_si2) }
                }
                compile_node(fval)
                if call_fc > 0 && call_fc <= 64 {
                    // SRET: data is in SRET_BUF; copy fc slots to BSS ptr + field offset
                    var si2: i64 = 0
                    while si2 < call_fc {
                        emit(0x48); emit(0xB9); emit_u64(0x700000 + si2 * 8)
                        emit(0x48); emit(0x8B); emit(0x01)
                        emit_load_rcx(ptr_slot)
                        emit(0x48); emit(0x89); emit(0x81); emit_u32((base_fi + fi + si2) * 8)
                        si2 = si2 + 1
                    }
                } else {
                    // Scalar or oversized return: write rax to field slot
                    emit_load_rcx(ptr_slot)
                    emit(0x48); emit(0x89); emit(0x81); emit_u32((base_fi + fi) * 8)
                }
            } else {
                compile_node(fval)
                // rax = value; rcx = ptr; mov [rcx + (base_fi+fi)*8], rax
                emit_load_rcx(ptr_slot)
                emit(0x48); emit(0x89); emit(0x81); emit_u32((base_fi + fi) * 8)
            }
        }
        fni = ND_RIGHT[fni as usize]
    }
}

fn compile_fn(fn_idx: i64) with Mut, Panic, Div {
    FN_CODE_OFF[fn_idx as usize] = CODE_LEN
    FN_CODE_READY[fn_idx as usize] = 0
    CURRENT_CODEGEN_FN = fn_idx
    code_segment_begin()
    locals_reset()
    LAST_FIELD_TYPE_SI = -1
    LAST_FIELD_SLOT_COUNT = 1
    LAST_FIELD_LAYOUT = 0
    emit_prologue()

    let pcount = FN_PARAM_COUNT[fn_idx as usize]
    let pbase = FN_PARAM_BASE[fn_idx as usize]
    if pcount > 0 {
        let p0si = FN_PARAM_TYPE_SI[pbase as usize]
        var s0: i64 = 0
        if p0si >= 0 {
            s0 = add_local_sptr(FN_PARAM_NAME_OFF[pbase as usize], FN_PARAM_NAME_LEN[pbase as usize], p0si)
            if struct_total_slots(p0si) > 64 { LOCAL_IS_SPTR[(LOCAL_COUNT - 1) as usize] = 4 }
        } else {
            s0 = add_local(FN_PARAM_NAME_OFF[pbase as usize], FN_PARAM_NAME_LEN[pbase as usize])
        }
        emit(0x48); emit(0x89); emit(0xBD)
        emit_u32(0 - ((s0 + 1) * 8))
    }
    if pcount > 1 {
        let p1si = FN_PARAM_TYPE_SI[(pbase + 1) as usize]
        var s1: i64 = 0
        if p1si >= 0 {
            s1 = add_local_sptr(FN_PARAM_NAME_OFF[(pbase + 1) as usize], FN_PARAM_NAME_LEN[(pbase + 1) as usize], p1si)
            if struct_total_slots(p1si) > 64 { LOCAL_IS_SPTR[(LOCAL_COUNT - 1) as usize] = 4 }
        } else {
            s1 = add_local(FN_PARAM_NAME_OFF[(pbase + 1) as usize], FN_PARAM_NAME_LEN[(pbase + 1) as usize])
        }
        emit(0x48); emit(0x89); emit(0xB5)
        emit_u32(0 - ((s1 + 1) * 8))
    }
    if pcount > 2 {
        let p2si = FN_PARAM_TYPE_SI[(pbase + 2) as usize]
        var s2: i64 = 0
        if p2si >= 0 {
            s2 = add_local_sptr(FN_PARAM_NAME_OFF[(pbase + 2) as usize], FN_PARAM_NAME_LEN[(pbase + 2) as usize], p2si)
            if struct_total_slots(p2si) > 64 { LOCAL_IS_SPTR[(LOCAL_COUNT - 1) as usize] = 4 }
        } else {
            s2 = add_local(FN_PARAM_NAME_OFF[(pbase + 2) as usize], FN_PARAM_NAME_LEN[(pbase + 2) as usize])
        }
        emit(0x48); emit(0x89); emit(0x95)
        emit_u32(0 - ((s2 + 1) * 8))
    }
    if pcount > 3 {
        let p3si = FN_PARAM_TYPE_SI[(pbase + 3) as usize]
        var s3: i64 = 0
        if p3si >= 0 {
            s3 = add_local_sptr(FN_PARAM_NAME_OFF[(pbase + 3) as usize], FN_PARAM_NAME_LEN[(pbase + 3) as usize], p3si)
            if struct_total_slots(p3si) > 64 { LOCAL_IS_SPTR[(LOCAL_COUNT - 1) as usize] = 4 }
        } else {
            s3 = add_local(FN_PARAM_NAME_OFF[(pbase + 3) as usize], FN_PARAM_NAME_LEN[(pbase + 3) as usize])
        }
        emit(0x48); emit(0x89); emit(0x8D)
        emit_u32(0 - ((s3 + 1) * 8))
    }
    let body = FN_BODY_NODE[fn_idx as usize]
    let body_state = FN_BODY_STATE[fn_idx as usize]
    CURRENT_FN_RET_SI = FN_RET_SI[fn_idx as usize]
    CURRENT_IMPL_SI = FN_IMPL_SI[fn_idx as usize]
    if body_state == fn_body_state_full() || body_state == fn_body_state_materialized_on_demand() {
        compile_node(body)
    } else {
        mc_note_codegen_ineligible(fn_idx, body_state)
        emit_mov_rax_imm(0)
    }
    CURRENT_FN_RET_SI = -1
    CURRENT_IMPL_SI = -1
    emit_epilogue()
    // Patch prologue frame size: NEXT_SLOT * 8, rounded up to 16-byte alignment
    let frame_bytes = ((NEXT_SLOT + 1) / 2) * 16
    let frame_min = if frame_bytes < 256 { 256 } else { frame_bytes }
    let pp = PROLOGUE_PATCH_OFF
    code_write_u32_at(pp, frame_min)
    code_segment_finish()
    CURRENT_CODEGEN_FN = -1
    FN_CODE_READY[fn_idx as usize] = 1
}

// ============================================================================
// ELF writer
// ============================================================================

fn elf_emit(b: i64) with Mut, Panic {
    if ELF_LEN >= elf_cap() { return }
    ELF[ELF_LEN as usize] = b as i8
    ELF_LEN = ELF_LEN + 1
}

fn elf_emit_u16(v: i64) with Mut, Panic {
    elf_emit(v & 0xFF)
    elf_emit((v >> 8) & 0xFF)
}

fn elf_emit_u32(v: i64) with Mut, Panic {
    elf_emit(v & 0xFF)
    elf_emit((v >> 8) & 0xFF)
    elf_emit((v >> 16) & 0xFF)
    elf_emit((v >> 24) & 0xFF)
}

fn elf_emit_u64(v: i64) with Mut, Panic {
    elf_emit_u32(v)
    elf_emit_u32(v >> 32)
}

fn write_elf(entry_fn: i64) with Mut, Panic, Div {
    let base_addr: i64 = 0x400000
    let text_off: i64 = 4096

    elf_emit(0x7F); elf_emit(0x45); elf_emit(0x4C); elf_emit(0x46)
    elf_emit(2)
    elf_emit(1)
    elf_emit(1)
    elf_emit(0)
    var pi: i64 = 0
    while pi < 8 { elf_emit(0); pi = pi + 1 }
    elf_emit_u16(2)
    elf_emit_u16(0x3E)
    elf_emit_u32(1)
    elf_emit_u64(base_addr + text_off)
    elf_emit_u64(64)
    elf_emit_u64(0)
    elf_emit_u32(0)
    elf_emit_u16(64)
    elf_emit_u16(56)
    elf_emit_u16(2)
    elf_emit_u16(0)
    elf_emit_u16(0)
    elf_emit_u16(0)

    let real_code_len = if CODE_LEN > code_cap() { code_cap() } else { CODE_LEN }
    let total_size = text_off + real_code_len
    elf_emit_u32(1)
    elf_emit_u32(5)
    elf_emit_u64(0)
    elf_emit_u64(base_addr)
    elf_emit_u64(base_addr)
    elf_emit_u64(total_size)
    elf_emit_u64(total_size)
    elf_emit_u64(0x1000)

    let bss_size = if MB_BSS_TOTAL > 0 { MB_BSS_TOTAL + OVERSIZED_BSS_OFF + 4096 } else { OVERSIZED_BSS_OFF + 4096 }
    elf_emit_u32(1)
    elf_emit_u32(6)
    elf_emit_u64(total_size)
    elf_emit_u64(0x700000)
    elf_emit_u64(0x700000)
    elf_emit_u64(0)
    elf_emit_u64(bss_size)
    elf_emit_u64(0x1000)

    while ELF_LEN < text_off {
        elf_emit(0)
    }

    let main_off = FN_CODE_OFF[entry_fn as usize]
    // Trampoline: save rsp, mmap heap, store HEAP_PTR, call main, exit
    // save rsp to [0x700000]
    elf_emit(0x48); elf_emit(0xBA); elf_emit_u64(0x700000)    // movabs rdx, 0x700000
    elf_emit(0x48); elf_emit(0x89); elf_emit(0x22)            // mov [rdx], rsp
    // mmap(NULL, 16MB, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
    elf_emit(0x48); elf_emit(0x31); elf_emit(0xFF)            // xor rdi, rdi
    elf_emit(0x48); elf_emit(0xBE); elf_emit_u64(16777216)    // movabs rsi, 16MB
    elf_emit(0xBA); elf_emit_u32(3)                            // mov edx, 3
    elf_emit(0x49); elf_emit(0xC7); elf_emit(0xC2); elf_emit_u32(0x22) // mov r10d, 0x22
    elf_emit(0x49); elf_emit(0xC7); elf_emit(0xC0); elf_emit_u32(0xFFFFFFFF) // mov r8d, -1
    elf_emit(0x4D); elf_emit(0x31); elf_emit(0xC9)            // xor r9, r9
    elf_emit(0xB8); elf_emit_u32(9)                            // mov eax, SYS_mmap
    elf_emit(0x0F); elf_emit(0x05)                             // syscall
    // store result in HEAP_PTR at BSS offset 512 (0x700000 + 512 = 0x700200)
    elf_emit(0x48); elf_emit(0xB9); elf_emit_u64(0x700200)    // movabs rcx, 0x700200
    elf_emit(0x48); elf_emit(0x89); elf_emit(0x01)            // mov [rcx], rax
    // call main
    let trampoline_pre = 13 + 13 + 5 + 7 + 7 + 3 + 5 + 2 + 10 + 3  // bytes before call
    let trampoline_size = trampoline_pre + 5 + 3 + 7 + 2
    let code_start = trampoline_size
    let main_abs = code_start + main_off
    let actual_call_rel = main_abs - (trampoline_pre + 5)
    elf_emit(0xE8); elf_emit_u32(actual_call_rel)
    elf_emit(0x48); elf_emit(0x89); elf_emit(0xC7)
    elf_emit(0x48); elf_emit(0xC7); elf_emit(0xC0)
    elf_emit_u32(60)
    elf_emit(0x0F); elf_emit(0x05)

    var ci: i64 = 0
    while ci < real_code_len {
        elf_emit(CODE[ci as usize] as i64)
        ci = ci + 1
    }
}

fn patch_calls(trampoline_size: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < FIX_COUNT {
        let fix_off = FIX_OFF[i as usize]
        let target_fn = FIX_TARGET[i as usize]
        if target_fn < 0 || target_fn >= FN_COUNT {
            i = i + 1
            continue
        }
        let target_off = FN_CODE_OFF[target_fn as usize]
        mc_patch_rel32_at(fix_off, target_off)
        let reloc_idx = FIX_RELOC_IDX[i as usize]
        if reloc_idx >= 0 && reloc_idx < REL_COUNT {
            REL_PATCH_STATE[reloc_idx as usize] = reloc_patch_state_patched_late()
            MC_FIX_PATCH_LATE_COUNT = MC_FIX_PATCH_LATE_COUNT + 1
        }
        i = i + 1
    }
    var j: i64 = 0
    while j < FN_LEA_FIX_COUNT {
        let lea_off = FN_LEA_FIX_OFF[j as usize]
        let lea_target = FN_LEA_FIX_TARGET[j as usize]
        if lea_target < 0 || lea_target >= FN_COUNT {
            j = j + 1
            continue
        }
        let target_code_off = FN_CODE_OFF[lea_target as usize]
        mc_patch_rel32_at(lea_off, target_code_off)
        let lea_reloc_idx = FN_LEA_FIX_RELOC_IDX[j as usize]
        if lea_reloc_idx >= 0 && lea_reloc_idx < REL_COUNT {
            REL_PATCH_STATE[lea_reloc_idx as usize] = reloc_patch_state_patched_late()
            MC_FIX_PATCH_LATE_COUNT = MC_FIX_PATCH_LATE_COUNT + 1
        }
        j = j + 1
    }
}

// ============================================================================
// Main
// ============================================================================

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc != 2 && argc != 4 && argc != 6 {
        print("Usage: boot4 <source.sio> <output> [--src-cap-bytes N] [--code-cap-bytes N] [--code-cap-profile baseline|experimental]\n")
        return 1
    }
    let src_path = get_arg(0)
    let out_path = get_arg(1)
    MC_EFFECTIVE_SRC_CAP = src_default_cap()
    MC_EFFECTIVE_CODE_CAP = code_default_cap()
    if argc >= 4 {
        let flag = get_arg(2)
        let value = get_arg(3)
        if str_eq_manual(flag, "--src-cap-bytes") {
            let parsed_cap = parse_decimal_string(value)
            if parsed_cap <= 0 {
                print("error: invalid --src-cap-bytes value\n")
                return 1
            }
            MC_EFFECTIVE_SRC_CAP = parsed_cap
        } else if str_eq_manual(flag, "--code-cap-bytes") {
            let parsed_cap = parse_decimal_string(value)
            if parsed_cap <= 0 {
                print("error: invalid --code-cap-bytes value\n")
                return 1
            }
            MC_EFFECTIVE_CODE_CAP = parsed_cap
        } else if str_eq_manual(flag, "--code-cap-profile") {
            let profile_cap = code_cap_profile_value(value)
            if profile_cap <= 0 {
                print("error: invalid --code-cap-profile value\n")
                return 1
            }
            MC_EFFECTIVE_CODE_CAP = profile_cap
        } else {
            print("error: unknown flag ")
            print(flag)
            print("\n")
            return 1
        }
    }
    if argc == 6 {
        let flag = get_arg(4)
        let value = get_arg(5)
        if str_eq_manual(flag, "--src-cap-bytes") {
            let parsed_cap = parse_decimal_string(value)
            if parsed_cap <= 0 {
                print("error: invalid --src-cap-bytes value\n")
                return 1
            }
            MC_EFFECTIVE_SRC_CAP = parsed_cap
        } else if str_eq_manual(flag, "--code-cap-bytes") {
            let parsed_cap = parse_decimal_string(value)
            if parsed_cap <= 0 {
                print("error: invalid --code-cap-bytes value\n")
                return 1
            }
            MC_EFFECTIVE_CODE_CAP = parsed_cap
        } else if str_eq_manual(flag, "--code-cap-profile") {
            let profile_cap = code_cap_profile_value(value)
            if profile_cap <= 0 {
                print("error: invalid --code-cap-profile value\n")
                return 1
            }
            MC_EFFECTIVE_CODE_CAP = profile_cap
        } else {
            print("error: unknown flag ")
            print(flag)
            print("\n")
            return 1
        }
    }

    mc_reset()
    mc_set_phase(1)
    let size = load_source(src_path)
    SRC_LEN = size
    mc_record_root(src_path, size)
    print("loaded size=")
    print_int(size)
    print("\n")

    print("scanning imports...\n")
    pre_scan_imports()
    mc_freeze_modules_into_code_scratch()
    mc_check_saturation()
    MC_POOL_AFTER_CLOSURE = POOL_POS
    print("total src=")
    print_int(SRC_LEN)
    print("\n")
    print_module_closure_pre()
    print_module_closure_v2_pre()
    if MC_SRC_TRUNCATED == 1 {
        print("error: module closure exceeded configured SRC capacity; inspect CLOSURE_BUNDLE_V1 witness\n")
        return 2
    }

    print("lexing...\n")
    mc_set_phase(2)
    lex()
    mc_compute_token_boundaries()
    mc_scan_decl_frontier()
    mc_check_saturation()
    MC_POOL_AFTER_LEX = POOL_POS
    print("tokens=")
    print_int(TK_COUNT)
    print("\n")

    print("parsing...\n")
    mc_set_phase(3)
    pre_scan_structs()
    mc_check_saturation()
    MC_POOL_AFTER_STRUCT_SCAN = POOL_POS
    mc_set_phase(4)
    pre_scan_enums()
    mc_check_saturation()
    MC_POOL_AFTER_ENUM_SCAN = POOL_POS
    MC_POOL_BEFORE_PARSE = POOL_POS
    mc_set_phase(5)
    parse_program()
    mc_finalize_decl_frontier()
    mc_check_saturation()
    MC_POOL_AFTER_PARSE = POOL_POS
    mc_set_phase(0)
    print("enums=")
    print_int(EN_COUNT)
    print(" variants=")
    print_int(EV_COUNT)
    print("\n")
    print("fns=")
    print_int(FN_COUNT)
    print(" structs=")
    print_int(ST_COUNT)
    print(" enums=")
    print_int(EN_COUNT)
    print(" nodes=")
    print_int(ND_COUNT)
    print("\n")
    print_module_closure_final()
    print_module_closure_v2()

    var main_fn: i64 = -1
    var fi: i64 = 0
    while fi < FN_COUNT {
        let fo = FN_NAME_OFF[fi as usize]
        let fl = FN_NAME_LEN[fi as usize]
        if pool_match(fo, fl, "main") {
            main_fn = fi
        }
        fi = fi + 1
    }

    if main_fn == -1 {
        print("error: no main function found")
        return 1
    }

    // Reserve 512 bytes (64 × 8) at BSS offset 0 as the SRET scratch buffer.
    // Target program struct-returning functions write fields to 0x700000 + 0..511.
    // HEAP_PTR at BSS offset 512, HEAP_END at 520.
    // User globals start at BSS offset 528.
    MB_BSS_TOTAL = 528

    mb_collect_globals()
    mb_resolve_src_globals()
    print("globals=")
    print_int(MB_GL_COUNT)
    print(" bss=")
    print_int(MB_BSS_TOTAL)
    print("\n")

    emit_print_int_helper()

    mc_set_phase(6)
    var ci: i64 = 0
    while ci < FN_COUNT {
        mc_note_codegen_phase(ci)
        print("fn ")
        print_int(ci)
        print(" ")
        compile_fn(ci)
        ci = ci + 1
    }

    mc_finalize_text_truth(main_fn)
    print_codegen_truth_v2()
    print_reloc_truth_v2()
    if MC_OVF_CODE != 0 || MC_FIRST_CODE_OVF_FN >= 0 {
        print("error: code artifact overflow\n")
        return 1
    }
    if MC_OVF_FIX != 0 || MC_OVF_FN_LEA_FIX != 0 {
        print("error: fixup overflow\n")
        return 1
    }

    print("patching...\n")
    mc_set_phase(7)
    patch_calls(17)
    mc_set_phase(0)

    print("patching...")
    print(" FIX_COUNT=")
    print_int(FIX_COUNT)
    print("\n")
    print("writing elf main_fn=")
    print_int(main_fn)
    print(" CODE_LEN=")
    print_int(CODE_LEN)
    print("\n")
    write_elf(main_fn)

    print("ELF_LEN=")
    print_int(ELF_LEN)
    print("\n")
    let wr = write_file(out_path, ELF, ELF_LEN)
    print("ok\n")
    0
}
