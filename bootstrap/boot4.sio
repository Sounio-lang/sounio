            compile_node(rhs)
            let fc_asgn_check = if dst_si2 >= 0 { struct_total_slots(dst_si2) } else { 0 }
            if slot2 >= 0 && dst_si2 >= 0 && fc_asgn_check <= 64 && (rhs_nk2 == 12 || rhs_nk2 == 51) {
