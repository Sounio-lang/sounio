// boot4.sio — Extended single-file Sounio→x86-64 ELF compiler
// Extends micro_bootstrap with: structs, match, pointer deref, use-skip, fat arrow, None/Some

fn load_source(path: string) -> i64 with IO, Mut, Panic, Div {
    let data = read_file(path)
    let sz = file_size(path)
    let cap = src_effective_cap()
    MC_LAST_REQUESTED_BYTES = sz
    MC_TOTAL_REQUESTED_BYTES = sz
    var i: i64 = 0
    while i < sz && i < cap {
        SRC[i as usize] = data[i as usize]
        i = i + 1
    }
    if i < sz { MC_SRC_TRUNCATED = 1 }
    SRC_LEN = i
    i
}

fn source_byte(idx: i64) -> i64 { SRC[idx as usize] as i64 }

fn append_import_from_imp_fname_buf() -> i64 with IO, Mut, Panic, Div {
    let path = &IMP_FNAME_BUF
    let data = read_file(path)
    let sz = file_size(path)
    let cap = src_effective_cap()
    MC_LAST_REQUESTED_BYTES = sz
    MC_TOTAL_REQUESTED_BYTES = MC_TOTAL_REQUESTED_BYTES + sz
    if sz <= 0 { return 0 }
    var copied: i64 = 0
    while copied < sz && SRC_LEN + copied + 1 < cap {
        SRC[(SRC_LEN + copied) as usize] = data[copied as usize]
        copied = copied + 1
    }
    if copied < sz { MC_SRC_TRUNCATED = 1 }
    if SRC_LEN + copied < cap {
        SRC[(SRC_LEN + copied) as usize] = 10 as i8
        SRC_LEN = SRC_LEN + copied + 1
    } else {
        SRC_LEN = SRC_LEN + copied
    }
    copied
}

