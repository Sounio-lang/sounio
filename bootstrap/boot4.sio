// boot4.sio — Extended single-file Sounio→x86-64 ELF compiler
// Extends micro_bootstrap with: structs, match, pointer deref, use-skip, fat arrow, None/Some

fn load_source(path: string) -> i64 with IO, Mut, Panic, Div {
    let data = read_file(path)
    let sz = file_size(path)
    var i: i64 = 0
    while i < sz && i < 2097152 {
        SRC[i as usize] = data[i as usize]
        i = i + 1
    }
    SRC_LEN = sz
    sz
}

fn source_byte(idx: i64) -> i64 { SRC[idx as usize] as i64 }

// ============================================================================
// Global state
// ============================================================================

var SRC: [i8; 2097152] = [0; 2097152]
var SRC_LEN: i64 = 0
var SRC_BUF: i64 = 0

var TK_KIND: [i64; 131072] = [0; 131072]
var TK_START: [i64; 131072] = [0; 131072]
var TK_END: [i64; 131072] = [0; 131072]
var TK_IVAL: [i64; 131072] = [0; 131072]
var TK_COUNT: i64 = 0

var POOL: [i8; 524288] = [0; 524288]
var POOL_POS: i64 = 0

var ND_KIND: [i64; 131072] = [0; 131072]
var ND_IVAL: [i64; 131072] = [0; 131072]
var ND_LEFT: [i64; 131072] = [-1; 131072]
var ND_RIGHT: [i64; 131072] = [-1; 131072]
var ND_EXTRA: [i64; 131072] = [-1; 131072]
var ND_EXTRA2: [i64; 131072] = [-1; 131072]
var ND_STR_OFF: [i64; 131072] = [0; 131072]
var ND_STR_LEN: [i64; 131072] = [0; 131072]
var ND_COUNT: i64 = 0

var FN_NAME_OFF: [i64; 2048] = [0; 2048]
var FN_NAME_LEN: [i64; 2048] = [0; 2048]
var FN_PARAM_COUNT: [i64; 2048] = [0; 2048]
var FN_BODY_NODE: [i64; 2048] = [-1; 2048]
var FN_COUNT: i64 = 0

var FN_PARAM_NAME_OFF: [i64; 16384] = [0; 16384]
var FN_PARAM_NAME_LEN: [i64; 16384] = [0; 16384]
var FN_PARAM_BASE: [i64; 2048] = [0; 2048]

var LOCAL_NAME_OFF: [i64; 8192] = [0; 8192]
var LOCAL_NAME_LEN: [i64; 8192] = [0; 8192]
var LOCAL_SLOT: [i64; 8192] = [0; 8192]
var LOCAL_STRUCT_IDX: [i64; 8192] = [-1; 8192]
var LOCAL_COUNT: i64 = 0
var NEXT_SLOT: i64 = 0
var LAST_LOCAL_SI: i64 = -1

// Global scratch pool for match fixup positions (avoids local array stack direction bug)
// 8 nesting levels x 64 arms = 512 entries
var MFPOOL: [i64; 512] = [0; 512]
var MFDEPTH: i64 = 0

var CODE: [i8; 4194304] = [0; 4194304]
var CODE_LEN: i64 = 0
var PRINT_INT_OFF: i64 = 0

var FN_CODE_OFF: [i64; 2048] = [0; 2048]
var FN_IMPL_SI: [i64; 2048] = [-1; 2048]

var FIX_OFF: [i64; 8192] = [0; 8192]
var FIX_TARGET: [i64; 8192] = [0; 8192]
var FIX_COUNT: i64 = 0

var POS: i64 = 0
var LOOP_TOP: i64 = 0
var BREAK_FIXUP_OFF: [i64; 64] = [0; 64]
var BREAK_FIXUP_COUNT: i64 = 0

var MB_GL_NS: [i64; 1024] = [0; 1024]
var MB_GL_NE: [i64; 1024] = [0; 1024]
var MB_GL_OFF: [i64; 1024] = [0; 1024]
var MB_GL_SZ: [i64; 1024] = [0; 1024]
var MB_GL_COUNT: i64 = 0
var MB_BSS_TOTAL: i64 = 0
var MB_SRC_BUF_GADDR: i64 = 0
var MB_SRC_LEN_GADDR: i64 = 0

var ST_NAME_OFF: [i64; 1024] = [0; 1024]
var ST_NAME_LEN: [i64; 1024] = [0; 1024]
var ST_FIELD_COUNT: [i64; 1024] = [0; 1024]
var ST_FIELD_FIRST: [i64; 1024] = [0; 1024]
var ST_COUNT: i64 = 0

var FLD_NAME_OFF: [i64; 8192] = [0; 8192]
var FLD_NAME_LEN: [i64; 8192] = [0; 8192]
var FLD_COUNT: i64 = 0

var ELF: [i8; 4194304] = [0; 4194304]
var ELF_LEN: i64 = 0

// ============================================================================
// Constants
// ============================================================================

fn TK_EOF() -> i64 { 0 }
fn TK_IDENT() -> i64 { 1 }
fn TK_INT() -> i64 { 2 }
fn TK_STR() -> i64 { 3 }
fn TK_PLUS() -> i64 { 10 }
fn TK_MINUS() -> i64 { 11 }
fn TK_STAR() -> i64 { 12 }
fn TK_SLASH() -> i64 { 13 }
fn TK_PERCENT() -> i64 { 14 }
fn TK_AMP() -> i64 { 15 }
fn TK_PIPE() -> i64 { 16 }
fn TK_CARET() -> i64 { 17 }
fn TK_SHL() -> i64 { 18 }
fn TK_SHR() -> i64 { 19 }
fn TK_AMPAMP() -> i64 { 20 }
fn TK_PIPEPIPE() -> i64 { 21 }
fn TK_BANG() -> i64 { 22 }
fn TK_EQ() -> i64 { 23 }
fn TK_NE() -> i64 { 24 }
fn TK_LT() -> i64 { 25 }
fn TK_LE() -> i64 { 26 }
fn TK_GT() -> i64 { 27 }
fn TK_GE() -> i64 { 28 }
fn TK_ASSIGN() -> i64 { 30 }
fn TK_LPAREN() -> i64 { 31 }
fn TK_RPAREN() -> i64 { 32 }
fn TK_LBRACE() -> i64 { 33 }
fn TK_RBRACE() -> i64 { 34 }
fn TK_LBRACKET() -> i64 { 35 }
fn TK_RBRACKET() -> i64 { 36 }
fn TK_COMMA() -> i64 { 37 }
fn TK_COLON() -> i64 { 38 }
fn TK_SEMI() -> i64 { 39 }
fn TK_DOT() -> i64 { 40 }
fn TK_ARROW() -> i64 { 42 }
fn TK_FN() -> i64 { 50 }
fn TK_LET() -> i64 { 51 }
fn TK_VAR() -> i64 { 52 }
fn TK_IF() -> i64 { 53 }
fn TK_ELSE() -> i64 { 54 }
fn TK_WHILE() -> i64 { 55 }
fn TK_RETURN() -> i64 { 56 }
fn TK_TRUE() -> i64 { 61 }
fn TK_FALSE() -> i64 { 62 }
fn TK_BREAK() -> i64 { 63 }
fn TK_CONTINUE() -> i64 { 64 }
fn TK_AS() -> i64 { 65 }
fn TK_WITH() -> i64 { 66 }
fn TK_SOME() -> i64 { 67 }
fn TK_NONE() -> i64 { 68 }
fn TK_STRUCT() -> i64 { 58 }
fn TK_MATCH() -> i64 { 57 }
fn TK_AMPBANG() -> i64 { 70 }
fn TK_FAT_ARROW() -> i64 { 79 }

fn NK_INT() -> i64 { 1 }
fn NK_IDENT() -> i64 { 2 }
fn NK_STR() -> i64 { 3 }
fn NK_BOOL() -> i64 { 4 }
fn NK_BINOP() -> i64 { 10 }
fn NK_UNARY() -> i64 { 11 }
fn NK_CALL() -> i64 { 12 }
fn NK_INDEX() -> i64 { 13 }
fn NK_FIELD() -> i64 { 14 }
fn NK_CAST() -> i64 { 16 }
fn NK_IF() -> i64 { 30 }
fn NK_WHILE() -> i64 { 31 }
fn NK_BLOCK() -> i64 { 33 }
fn NK_RETURN() -> i64 { 34 }
fn NK_BREAK() -> i64 { 35 }
fn NK_CONTINUE_NODE() -> i64 { 36 }
fn NK_LET() -> i64 { 40 }
fn NK_VAR() -> i64 { 41 }
fn NK_ASSIGN() -> i64 { 42 }
fn NK_EXPR_STMT() -> i64 { 43 }
fn NK_MATCH() -> i64 { 44 }
fn NK_ARM() -> i64 { 45 }
fn NK_DEREF() -> i64 { 46 }
fn NK_STRUCT_LIT() -> i64 { 47 }
fn NK_STRUCT_FI() -> i64 { 48 }
fn NK_ADDR() -> i64 { 49 }
fn NK_ARRAY_LIT() -> i64 { 50 }

fn ARM_INT() -> i64 { 0 }
fn ARM_WILD() -> i64 { 1 }
fn ARM_NONE() -> i64 { 2 }
fn ARM_SOME() -> i64 { 3 }

// ============================================================================
// Lexer helpers
// ============================================================================

fn src_byte(pos: i64) -> i64 with Panic {
    if pos < 0 || pos >= SRC_LEN { return 0 }
    source_byte(pos)
}

fn is_ws(ch: i64) -> bool {
    ch == 32 || ch == 9 || ch == 10 || ch == 13
}

fn is_digit(ch: i64) -> bool {
    ch >= 48 && ch <= 57
}

fn is_alpha(ch: i64) -> bool {
    (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn is_alnum(ch: i64) -> bool {
    is_alpha(ch) || is_digit(ch)
}

fn pool_add(b: i64) with Mut, Panic {
    POOL[POOL_POS as usize] = b as i8
    POOL_POS = POOL_POS + 1
}

fn pool_match(off: i64, len: i64, target: string) -> bool with Mut, Panic, Div {
    if len != str_len(target) { return false }
    var i: i64 = 0
    while i < len {
        let a = POOL[(off + i) as usize] as i64
        let b = str_char_at(target, i) as i64
        if a != b { return false }
        i = i + 1
    }
    true
}

fn classify_keyword(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    if len == 2 {
        if pool_match(off, len, "fn") { return 50 }
        if pool_match(off, len, "if") { return 53 }
        if pool_match(off, len, "as") { return 65 }
    } else if len == 3 {
        if pool_match(off, len, "let") { return 51 }
        if pool_match(off, len, "var") { return 52 }
        if pool_match(off, len, "for") { return 55 }
    } else if len == 4 {
        if pool_match(off, len, "else") { return 54 }
        if pool_match(off, len, "true") { return 61 }
        if pool_match(off, len, "with") { return 66 }
        if pool_match(off, len, "None") { return 68 }
        if pool_match(off, len, "Some") { return 67 }
        if pool_match(off, len, "self") { return 1 }
        if pool_match(off, len, "Self") { return 1 }
        if pool_match(off, len, "type") { return 1 }
        if pool_match(off, len, "impl") { return 60 }
        if pool_match(off, len, "enum") { return 59 }
        if pool_match(off, len, "loop") { return 55 }
    } else if len == 5 {
        if pool_match(off, len, "while") { return 55 }
        if pool_match(off, len, "break") { return 63 }
        if pool_match(off, len, "false") { return 62 }
        if pool_match(off, len, "match") { return 57 }
    } else if len == 6 {
        if pool_match(off, len, "return") { return 56 }
        if pool_match(off, len, "struct") { return 58 }
        if pool_match(off, len, "module") { return 1 }
        if pool_match(off, len, "linear") { return 1 }
    } else if len == 8 {
        if pool_match(off, len, "continue") { return 64 }
    }
    0
}

// ============================================================================
// Lexer
// ============================================================================

fn add_token(kind: i64, start: i64, end: i64, ival: i64) with Mut, Panic {
    let idx = TK_COUNT
    TK_KIND[idx as usize] = kind
    TK_START[idx as usize] = start
    TK_END[idx as usize] = end
    TK_IVAL[idx as usize] = ival
    TK_COUNT = TK_COUNT + 1
}

fn lex() with Mut, Panic, Div {
    var p: i64 = 0
    while p < SRC_LEN {
        let ch = src_byte(p)
        if is_ws(ch) {
            p = p + 1
            continue
        }
        if ch == 47 && src_byte(p + 1) == 47 {
            p = p + 2
            while p < SRC_LEN && src_byte(p) != 10 {
                p = p + 1
            }
            continue
        }
        if is_digit(ch) {
            let start = p
            var val: i64 = 0
            if ch == 48 && p + 1 < SRC_LEN && src_byte(p + 1) == 120 {
                p = p + 2
                while p < SRC_LEN {
                    let hc = src_byte(p)
                    if hc >= 48 && hc <= 57 {
                        val = val * 16 + (hc - 48)
                        p = p + 1
                    } else if hc >= 65 && hc <= 70 {
                        val = val * 16 + (hc - 55)
                        p = p + 1
                    } else if hc >= 97 && hc <= 102 {
                        val = val * 16 + (hc - 87)
                        p = p + 1
                    } else {
                        break
                    }
                }
            } else {
                while p < SRC_LEN && is_digit(src_byte(p)) {
                    val = val * 10 + (src_byte(p) - 48)
                    p = p + 1
                }
            }
            add_token(2, start, p, val)
            continue
        }
        if is_alpha(ch) {
            let start = p
            let pool_start = POOL_POS
            while p < SRC_LEN && is_alnum(src_byte(p)) {
                pool_add(src_byte(p))
                p = p + 1
            }
            let ilen = p - start
            let kw = classify_keyword(pool_start, ilen)
            if kw != 0 {
                add_token(kw, start, p, pool_start)
            } else {
                add_token(1, start, p, pool_start)
            }
            continue
        }
        if ch == 34 {
            p = p + 1
            let start = p
            let pool_start = POOL_POS
            while p < SRC_LEN && src_byte(p) != 34 {
                if src_byte(p) == 92 {
                    p = p + 1
                    let esc = src_byte(p)
                    if esc == 110 { pool_add(10) }
                    else if esc == 116 { pool_add(9) }
                    else if esc == 92 { pool_add(92) }
                    else if esc == 34 { pool_add(34) }
                    else if esc == 48 { pool_add(0) }
                    else { pool_add(esc) }
                } else {
                    pool_add(src_byte(p))
                }
                p = p + 1
            }
            let slen = POOL_POS - pool_start
            p = p + 1
            add_token(3, start, p, pool_start)
            TK_END[(TK_COUNT - 1) as usize] = slen
            continue
        }
        let ch2 = src_byte(p + 1)
        if ch == 38 && ch2 == 38 { add_token(20, p, p + 2, 0); p = p + 2; continue }
        if ch == 124 && ch2 == 124 { add_token(21, p, p + 2, 0); p = p + 2; continue }
        if ch == 61 && ch2 == 61 { add_token(23, p, p + 2, 0); p = p + 2; continue }
        if ch == 33 && ch2 == 61 { add_token(24, p, p + 2, 0); p = p + 2; continue }
        if ch == 60 && ch2 == 61 { add_token(26, p, p + 2, 0); p = p + 2; continue }
        if ch == 62 && ch2 == 61 { add_token(28, p, p + 2, 0); p = p + 2; continue }
        if ch == 60 && ch2 == 60 { add_token(18, p, p + 2, 0); p = p + 2; continue }
        if ch == 62 && ch2 == 62 { add_token(19, p, p + 2, 0); p = p + 2; continue }
        if ch == 45 && ch2 == 62 { add_token(42, p, p + 2, 0); p = p + 2; continue }
        if ch == 38 && ch2 == 33 { add_token(70, p, p + 2, 0); p = p + 2; continue }
        if ch == 58 && ch2 == 58 { add_token(41, p, p + 2, 0); p = p + 2; continue }
        if ch == 46 && ch2 == 46 { add_token(43, p, p + 2, 0); p = p + 2; continue }
        // => fat arrow (must come before single =)
        if ch == 61 && ch2 == 62 { add_token(79, p, p + 2, 0); p = p + 2; continue }
        if ch == 43 { add_token(10, p, p + 1, 0); p = p + 1; continue }
        if ch == 45 { add_token(11, p, p + 1, 0); p = p + 1; continue }
        if ch == 42 { add_token(12, p, p + 1, 0); p = p + 1; continue }
        if ch == 47 { add_token(13, p, p + 1, 0); p = p + 1; continue }
        if ch == 37 { add_token(14, p, p + 1, 0); p = p + 1; continue }
        if ch == 38 { add_token(15, p, p + 1, 0); p = p + 1; continue }
        if ch == 124 { add_token(16, p, p + 1, 0); p = p + 1; continue }
        if ch == 94 { add_token(17, p, p + 1, 0); p = p + 1; continue }
        if ch == 33 { add_token(22, p, p + 1, 0); p = p + 1; continue }
        if ch == 61 { add_token(30, p, p + 1, 0); p = p + 1; continue }
        if ch == 40 { add_token(31, p, p + 1, 0); p = p + 1; continue }
        if ch == 41 { add_token(32, p, p + 1, 0); p = p + 1; continue }
        if ch == 123 { add_token(33, p, p + 1, 0); p = p + 1; continue }
        if ch == 125 { add_token(34, p, p + 1, 0); p = p + 1; continue }
        if ch == 91 { add_token(35, p, p + 1, 0); p = p + 1; continue }
        if ch == 93 { add_token(36, p, p + 1, 0); p = p + 1; continue }
        if ch == 44 { add_token(37, p, p + 1, 0); p = p + 1; continue }
        if ch == 58 { add_token(38, p, p + 1, 0); p = p + 1; continue }
        if ch == 59 { add_token(39, p, p + 1, 0); p = p + 1; continue }
        if ch == 46 { add_token(40, p, p + 1, 0); p = p + 1; continue }
        if ch == 60 { add_token(25, p, p + 1, 0); p = p + 1; continue }
        if ch == 62 { add_token(27, p, p + 1, 0); p = p + 1; continue }
        p = p + 1
    }
    add_token(0, SRC_LEN, SRC_LEN, 0)
}

// ============================================================================
// Parser helpers
// ============================================================================

fn cur_kind() -> i64 with Panic {
    TK_KIND[POS as usize]
}

fn cur_ival() -> i64 with Panic {
    TK_IVAL[POS as usize]
}

fn cur_start() -> i64 with Panic {
    TK_START[POS as usize]
}

fn cur_end() -> i64 with Panic {
    TK_END[POS as usize]
}

fn advance() with Mut, Panic {
    POS = POS + 1
}

fn expect(kind: i64) with Mut, Panic {
    if cur_kind() != kind {
        print("parse error: expected ")
        print_int(kind)
        print(" got ")
        print_int(cur_kind())
        print(" at ")
        print_int(POS)
        print("\n")
    }
    advance()
}

fn new_node(kind: i64, ival: i64) -> i64 with Mut, Panic {
    let idx = ND_COUNT
    if idx >= 131072 {
        print("NODE OVERFLOW idx=")
        print_int(idx)
        print("\n")
    }
    ND_KIND[idx as usize] = kind
    ND_IVAL[idx as usize] = ival
    ND_LEFT[idx as usize] = -1
    ND_RIGHT[idx as usize] = -1
    ND_EXTRA[idx as usize] = -1
    ND_EXTRA2[idx as usize] = -1
    ND_STR_OFF[idx as usize] = 0
    ND_STR_LEN[idx as usize] = 0
    ND_COUNT = ND_COUNT + 1
    idx
}

fn tok_pool_off() -> i64 with Panic {
    TK_IVAL[POS as usize]
}

fn tok_ident_len() -> i64 with Panic {
    TK_END[POS as usize] - TK_START[POS as usize]
}

// ============================================================================
// Struct table helpers
// ============================================================================

fn find_struct_b4(name_off: i64, name_len: i64) -> i64 with Mut, Panic, Div {
    var si: i64 = 0
    while si < ST_COUNT {
        if ST_NAME_LEN[si as usize] == name_len {
            var ok: i64 = 1
            var i: i64 = 0
            while i < name_len {
                if POOL[(ST_NAME_OFF[si as usize] + i) as usize] != POOL[(name_off + i) as usize] {
                    ok = 0
                }
                i = i + 1
            }
            if ok == 1 { return si }
        }
        si = si + 1
    }
    -1
}

fn find_field_b4(si: i64, fname_off: i64, fname_len: i64) -> i64 with Mut, Panic, Div {
    let fi_base = ST_FIELD_FIRST[si as usize]
    let fc = ST_FIELD_COUNT[si as usize]
    var j: i64 = 0
    while j < fc {
        let fj = fi_base + j
        if FLD_NAME_LEN[fj as usize] == fname_len {
            var ok: i64 = 1
            var k: i64 = 0
            while k < fname_len {
                if POOL[(FLD_NAME_OFF[fj as usize] + k) as usize] != POOL[(fname_off + k) as usize] {
                    ok = 0
                }
                k = k + 1
            }
            if ok == 1 { return j }
        }
        j = j + 1
    }
    -1
}

// ============================================================================
// Parser: type skipping
// ============================================================================

fn skip_type_expr() with Mut, Panic, Div {
    if cur_kind() == 15 {
        advance()
        skip_type_expr()
    } else if cur_kind() == 70 {
        advance()
        skip_type_expr()
    } else if cur_kind() == 35 {
        advance()
        skip_type_expr()
        if cur_kind() == 39 { advance() }
        if cur_kind() == 2 { advance() }
        if cur_kind() == 36 { advance() }
    } else if cur_kind() == 31 {
        advance()
        while cur_kind() != 32 && cur_kind() != 0 {
            skip_type_expr()
            if cur_kind() == 37 { advance() }
        }
        if cur_kind() == 32 { advance() }
    } else if cur_kind() == 1 || cur_kind() >= 50 {
        advance()
        // Consume :: path extensions (e.g. TokenKind::Eof, std::vec::Vec)
        while cur_kind() == 41 {
            advance()
            if cur_kind() == 1 { advance() }
        }
        if cur_kind() == 25 {
            advance()
            var depth: i64 = 1
            while depth > 0 && cur_kind() != 0 {
                if cur_kind() == 25 { depth = depth + 1 }
                else if cur_kind() == 27 { depth = depth - 1 }
                else if cur_kind() == 19 { depth = depth - 2 }  // '>>' lexed as SHR = two closing >
                if depth > 0 { advance() }
            }
            if cur_kind() == 27 { advance() }
            else if cur_kind() == 19 { advance() }  // consume '>>' as closing outer >
        }
    } else if cur_kind() == 2 {
        advance()
    }
}

fn skip_type_annotation() with Mut, Panic, Div {
    if cur_kind() == 38 {
        advance()
        skip_type_expr()
    }
}

// ============================================================================
// Parser: expressions
// ============================================================================

fn binop_prec(kind: i64) -> i64 {
    if kind == 21 { 1 }
    else if kind == 20 { 2 }
    else if kind == 16 { 3 }
    else if kind == 17 { 4 }
    else if kind == 15 { 5 }
    else if kind == 23 || kind == 24 { 6 }
    else if kind == 25 || kind == 26 || kind == 27 || kind == 28 { 7 }
    else if kind == 18 || kind == 19 { 8 }
    else if kind == 10 || kind == 11 { 9 }
    else if kind == 12 || kind == 13 || kind == 14 { 10 }
    else { 0 }
}

fn tok_to_binop(kind: i64) -> i64 {
    if kind == 10 { 0 }
    else if kind == 11 { 1 }
    else if kind == 12 { 2 }
    else if kind == 13 { 3 }
    else if kind == 14 { 4 }
    else if kind == 23 { 5 }
    else if kind == 24 { 6 }
    else if kind == 25 { 7 }
    else if kind == 26 { 8 }
    else if kind == 27 { 9 }
    else if kind == 28 { 10 }
    else if kind == 20 { 11 }
    else if kind == 21 { 12 }
    else if kind == 15 { 13 }
    else if kind == 16 { 14 }
    else if kind == 17 { 15 }
    else if kind == 18 { 16 }
    else if kind == 19 { 17 }
    else { -1 }
}

fn parse_block() -> i64 with Mut, Panic, Div {
    expect(33)
    let block_node = new_node(33, 0)
    var first: i64 = -1
    var last: i64 = -1
    while cur_kind() != 34 && cur_kind() != 0 {
        let stmt = parse_stmt()
        if first == -1 {
            first = stmt
        } else {
            ND_RIGHT[last as usize] = stmt
        }
        last = stmt
        if cur_kind() == 39 { advance() }
    }
    expect(34)
    ND_LEFT[block_node as usize] = first
    block_node
}

fn parse_args() -> i64 with Mut, Panic, Div {
    var first: i64 = -1
    var last: i64 = -1
    while cur_kind() != 32 && cur_kind() != 0 {
        let arg = parse_expr(0)
        if first == -1 {
            first = arg
        } else {
            ND_EXTRA[last as usize] = arg
        }
        last = arg
        if cur_kind() == 37 { advance() }
    }
    first
}

fn parse_match_expr() -> i64 with Mut, Panic, Div {
    advance()
    let scr = parse_expr(0)
    let match_node = new_node(44, 0)
    ND_LEFT[match_node as usize] = scr
    if cur_kind() == 33 { advance() }
    var first_arm: i64 = -1
    var last_arm: i64 = -1
    while cur_kind() != 34 && cur_kind() != 0 {
        let arm = new_node(45, 0)
        let pk = cur_kind()
        if pk == 2 {
            ND_IVAL[arm as usize] = 0
            ND_STR_OFF[arm as usize] = cur_ival()
            advance()
        } else if pk == 68 {
            ND_IVAL[arm as usize] = 2
            advance()
        } else if pk == 67 {
            ND_IVAL[arm as usize] = 3
            advance()
            if cur_kind() == 31 {
                advance()
                ND_STR_OFF[arm as usize] = tok_pool_off()
                ND_STR_LEN[arm as usize] = tok_ident_len()
                advance()
                if cur_kind() == 32 { advance() }
            }
        } else if pk == 1 {
            let poff = tok_pool_off()
            let plen = tok_ident_len()
            if pool_match(poff, plen, "_") {
                ND_IVAL[arm as usize] = 1
            } else {
                ND_IVAL[arm as usize] = 1
            }
            advance()
        } else {
            ND_IVAL[arm as usize] = 1
            advance()
        }
        if cur_kind() == 79 { advance() }
        if cur_kind() == 33 {
            let b2 = parse_block()
            ND_EXTRA[arm as usize] = b2
        } else {
            let e2 = parse_expr(0)
            ND_EXTRA[arm as usize] = e2
        }
        if cur_kind() == 37 { advance() }
        if first_arm == -1 {
            first_arm = arm
        } else {
            ND_RIGHT[last_arm as usize] = arm
        }
        last_arm = arm
    }
    if cur_kind() == 34 { advance() }
    ND_EXTRA[match_node as usize] = first_arm
    match_node
}

fn parse_struct_literal(ident_node: i64, si: i64) -> i64 with Mut, Panic, Div {
    if cur_kind() == 33 { advance() }
    let slit = new_node(47, si)
    var first_fi: i64 = -1
    var last_fi: i64 = -1
    while cur_kind() != 34 && cur_kind() != 0 {
        if cur_kind() == 1 {
            let fn_off = tok_pool_off()
            let fn_len = tok_ident_len()
            advance()
            if cur_kind() == 38 { advance() }
            let fval = parse_expr(0)
            let fi_idx = find_field_b4(si, fn_off, fn_len)
            let fnode3 = new_node(48, fi_idx)
            ND_LEFT[fnode3 as usize] = fval
            if first_fi == -1 { first_fi = fnode3 } else { ND_RIGHT[last_fi as usize] = fnode3 }
            last_fi = fnode3
            if cur_kind() == 37 { advance() }
        } else {
            advance()
        }
    }
    if cur_kind() == 34 { advance() }
    ND_EXTRA[slit as usize] = first_fi
    slit
}

fn parse_expr(min_prec: i64) -> i64 with Mut, Panic, Div {
    var left: i64 = -1
    let k = cur_kind()

    if k == 2 {
        left = new_node(1, cur_ival())
        advance()
    } else if k == 3 {
        left = new_node(3, 0)
        ND_STR_OFF[left as usize] = cur_ival()
        ND_STR_LEN[left as usize] = cur_end()
        advance()
    } else if k == 61 {
        left = new_node(4, 1)
        advance()
    } else if k == 62 {
        left = new_node(4, 0)
        advance()
    } else if k == 68 {
        left = new_node(1, 0)
        advance()
    } else if k == 67 {
        advance()
        if cur_kind() == 31 {
            advance()
            left = parse_expr(0)
            if cur_kind() == 32 { advance() }
        } else {
            left = new_node(1, 0)
        }
    } else if k == 1 {
        let off = tok_pool_off()
        let ilen = tok_ident_len()
        left = new_node(2, 0)
        ND_STR_OFF[left as usize] = off
        ND_STR_LEN[left as usize] = ilen
        advance()
        // Consume :: path (enum variant, module path): TokenKind::Eof → value=ident "TokenKind"
        while cur_kind() == 41 {
            advance()  // skip ::
            if cur_kind() == 1 { advance() }  // skip next ident segment
        }
        if cur_kind() == 31 {
            advance()
            let args = parse_args()
            expect(32)
            let call_node = new_node(12, 0)
            ND_LEFT[call_node as usize] = left
            ND_EXTRA[call_node as usize] = args
            left = call_node
        } else if cur_kind() == 33 {
            let si_check = find_struct_b4(off, ilen)
            if si_check >= 0 {
                left = parse_struct_literal(left, si_check)
            }
        }
    } else if k == 31 {
        advance()
        left = parse_expr(0)
        expect(32)
    } else if k == 11 {
        advance()
        let operand = parse_expr(10)
        left = new_node(11, 1)
        ND_LEFT[left as usize] = operand
    } else if k == 22 {
        advance()
        let operand = parse_expr(10)
        left = new_node(11, 0)
        ND_LEFT[left as usize] = operand
    } else if k == 12 {
        advance()
        let operand = parse_expr(11)
        left = new_node(46, 0)
        ND_LEFT[left as usize] = operand
    } else if k == 15 {
        advance()
        let operand = parse_expr(18)
        left = new_node(49, 0)
        ND_LEFT[left as usize] = operand
    } else if k == 57 {
        left = parse_match_expr()
    } else if k == 33 {
        left = parse_block()
    } else if k == 53 {
        left = parse_if_expr()
    } else if k == 55 {
        left = parse_while_expr()
    } else if k == 35 {
        advance()
        let fill_val = parse_expr(0)
        var arr_count: i64 = 1
        if cur_kind() == 39 {
            advance()
            if cur_kind() == 2 {
                arr_count = cur_ival()
                advance()
            }
        }
        if cur_kind() == 36 { advance() }
        left = new_node(50, arr_count)
        ND_LEFT[left as usize] = fill_val
    } else {
        left = new_node(1, 0)
        advance()
    }

    var postfix_done: i64 = 0
    while postfix_done == 0 {
        if cur_kind() == 65 {
            advance()
            if cur_kind() == 1 || cur_kind() >= 50 {
                advance()
            }
        } else if cur_kind() == 35 {
            advance()
            let idx_expr = parse_expr(0)
            if cur_kind() == 36 { advance() }
            let inode = new_node(13, 0)
            ND_LEFT[inode as usize] = left
            ND_RIGHT[inode as usize] = idx_expr
            left = inode
        } else if cur_kind() == 40 {
            advance()
            let fname_off2 = tok_pool_off()
            let fname_len2 = tok_ident_len()
            advance()
            if cur_kind() == 31 {
                advance()
                while cur_kind() != 32 && cur_kind() != 0 { advance() }
                if cur_kind() == 32 { advance() }
            } else {
                let fnode2 = new_node(14, 0)
                ND_LEFT[fnode2 as usize] = left
                ND_STR_OFF[fnode2 as usize] = fname_off2
                ND_STR_LEN[fnode2 as usize] = fname_len2
                left = fnode2
            }
        } else {
            postfix_done = 1
        }
    }

    while true {
        let op_kind = cur_kind()
        let prec = binop_prec(op_kind)
        if prec == 0 || prec < min_prec { break }
        // Don't consume * as binary mul after addr-of or deref: *b on next line is next stmt
        if op_kind == 12 && (ND_KIND[left as usize] == 49 || ND_KIND[left as usize] == 46) { break }
        let binop_code = tok_to_binop(op_kind)
        advance()
        let right = parse_expr(prec + 1)
        let bin_node = new_node(10, binop_code)
        ND_LEFT[bin_node as usize] = left
        ND_RIGHT[bin_node as usize] = right
        left = bin_node
    }

    left
}

fn parse_if_expr() -> i64 with Mut, Panic, Div {
    expect(53)
    let cond = parse_expr(0)
    let then_block = parse_block()
    let if_node = new_node(30, 0)
    ND_LEFT[if_node as usize] = cond
    ND_EXTRA[if_node as usize] = then_block
    if cur_kind() == 54 {
        advance()
        if cur_kind() == 53 {
            let else_part = parse_if_expr()
            ND_EXTRA2[if_node as usize] = else_part
        } else {
            let else_block = parse_block()
            ND_EXTRA2[if_node as usize] = else_block
        }
    }
    if_node
}

fn parse_while_expr() -> i64 with Mut, Panic, Div {
    expect(55)
    let cond = parse_expr(0)
    let body = parse_block()
    let wh_node = new_node(31, 0)
    ND_LEFT[wh_node as usize] = cond
    ND_EXTRA[wh_node as usize] = body
    wh_node
}

// ============================================================================
// Parser: statements
// ============================================================================

fn parse_stmt() -> i64 with Mut, Panic, Div {
    let k = cur_kind()
    if k == 51 || k == 52 {
        let is_var = k == 52
        advance()
        let name_off = tok_pool_off()
        let name_len = tok_ident_len()
        advance()
        var struct_si: i64 = -1
        if cur_kind() == 38 {
            advance()
            if cur_kind() == 1 {
                let toff = tok_pool_off()
                let tlen = tok_ident_len()
                struct_si = find_struct_b4(toff, tlen)
            }
            skip_type_expr()
        }
        expect(30)
        let init = parse_expr(0)
        var node_kind: i64 = 40
        if is_var { node_kind = 41 }
        let node = new_node(node_kind, struct_si)
        ND_STR_OFF[node as usize] = name_off
        ND_STR_LEN[node as usize] = name_len
        ND_LEFT[node as usize] = init
        return node
    }
    if k == 56 {
        advance()
        let val = if cur_kind() != 34 && cur_kind() != 39 { parse_expr(0) } else { -1 }
        let node = new_node(34, 0)
        ND_LEFT[node as usize] = val
        return node
    }
    if k == 63 {
        advance()
        return new_node(35, 0)
    }
    if k == 64 {
        advance()
        return new_node(36, 0)
    }
    if k == 53 {
        return parse_if_expr()
    }
    if k == 55 {
        return parse_while_expr()
    }
    // Special case: *lval = rhs (deref-assign at statement level)
    // Must handle before parse_expr to avoid Pratt loop consuming *lval
    // when &expr on previous line has no statement separator
    if k == 12 {
        advance()
        let lval = parse_expr(18)
        if cur_kind() == 30 {
            advance()
            let rhs2 = parse_expr(0)
            let dn = new_node(46, 0)
            ND_LEFT[dn as usize] = lval
            let asgn2 = new_node(42, 0)
            ND_LEFT[asgn2 as usize] = dn
            ND_EXTRA[asgn2 as usize] = rhs2
            return asgn2
        }
        let dn2 = new_node(46, 0)
        ND_LEFT[dn2 as usize] = lval
        let es2 = new_node(43, 0)
        ND_LEFT[es2 as usize] = dn2
        return es2
    }
    let expr = parse_expr(0)
    if cur_kind() == 30 {
        advance()
        let rhs = parse_expr(0)
        let asgn = new_node(42, 0)
        ND_LEFT[asgn as usize] = expr
        ND_EXTRA[asgn as usize] = rhs
        return asgn
    }
    let es = new_node(43, 0)
    ND_LEFT[es as usize] = expr
    es
}

// ============================================================================
// Parser: top-level
// ============================================================================

fn skip_effects() with Mut, Panic, Div {
    if cur_kind() == 66 {
        advance()
        while cur_kind() == 1 || cur_kind() >= 50 {
            advance()
            if cur_kind() == 37 { advance() }
        }
    }
}

fn skip_return_type() with Mut, Panic, Div {
    if cur_kind() == 42 {
        advance()
        skip_type_expr()
    }
}

fn parse_fn_def() with Mut, Panic, Div {
    expect(50)
    let fn_idx = FN_COUNT
    let name_off = tok_pool_off()
    let name_len = tok_ident_len()
    FN_NAME_OFF[fn_idx as usize] = name_off
    FN_NAME_LEN[fn_idx as usize] = name_len
    advance()

    expect(31)
    var pcount: i64 = 0
    let pbase = fn_idx * 8
    FN_PARAM_BASE[fn_idx as usize] = pbase
    while cur_kind() != 32 && cur_kind() != 0 {
        let poff = tok_pool_off()
        let plen = tok_ident_len()
        FN_PARAM_NAME_OFF[(pbase + pcount) as usize] = poff
        FN_PARAM_NAME_LEN[(pbase + pcount) as usize] = plen
        advance()
        skip_type_annotation()
        pcount = pcount + 1
        if cur_kind() == 37 { advance() }
    }
    expect(32)
    FN_PARAM_COUNT[fn_idx as usize] = pcount

    skip_return_type()
    skip_effects()

    let body = parse_block()
    FN_BODY_NODE[fn_idx as usize] = body
    FN_COUNT = FN_COUNT + 1
}

fn parse_struct_decl() with Mut, Panic, Div {
    advance()
    let si = ST_COUNT
    ST_NAME_OFF[si as usize] = tok_pool_off()
    ST_NAME_LEN[si as usize] = tok_ident_len()
    advance()
    if cur_kind() == 33 { advance() }
    let fi_base = FLD_COUNT
    ST_FIELD_FIRST[si as usize] = fi_base
    var fc: i64 = 0
    while cur_kind() != 34 && cur_kind() != 0 {
        if cur_kind() == 1 {
            FLD_NAME_OFF[(fi_base + fc) as usize] = tok_pool_off()
            FLD_NAME_LEN[(fi_base + fc) as usize] = tok_ident_len()
            fc = fc + 1
            advance()
            skip_type_annotation()
            if cur_kind() == 37 { advance() }
        } else {
            advance()
        }
    }
    if cur_kind() == 34 { advance() }
    ST_FIELD_COUNT[si as usize] = fc
    FLD_COUNT = FLD_COUNT + fc
    ST_COUNT = ST_COUNT + 1
}

fn skip_braces() with Mut, Panic, Div {
    if cur_kind() == 33 {
        advance()
        var depth: i64 = 1
        while depth > 0 && cur_kind() != 0 {
            if cur_kind() == 33 { depth = depth + 1 }
            else if cur_kind() == 34 { depth = depth - 1 }
            if depth > 0 { advance() }
        }
        if cur_kind() == 34 { advance() }
    }
}

fn parse_impl_body() with Mut, Panic, Div {
    // Get struct name from first identifier token
    var si: i64 = -1
    if cur_kind() == 1 {
        let noff = tok_pool_off()
        let nlen = tok_ident_len()
        si = find_struct_b4(noff, nlen)
        advance()
    }
    // Skip generics and 'for Type' clauses until we reach '{'
    while cur_kind() != 33 && cur_kind() != 0 {
        if cur_kind() == 25 {
            advance()
            var d: i64 = 1
            while d > 0 && cur_kind() != 0 {
                if cur_kind() == 25 { d = d + 1 }
                else if cur_kind() == 27 { d = d - 1 }
                else if cur_kind() == 19 { d = d - 2 }  // '>>' = two closing >
                if d > 0 { advance() }
            }
            if cur_kind() == 27 { advance() }
            else if cur_kind() == 19 { advance() }
        } else {
            advance()
        }
    }
    if cur_kind() == 33 { advance() }
    // Parse function definitions inside the impl block
    while cur_kind() != 34 && cur_kind() != 0 {
        if cur_kind() == 50 {
            FN_IMPL_SI[FN_COUNT as usize] = si
            parse_fn_def()
        } else if cur_kind() == 33 {
            skip_braces()
        } else {
            advance()
        }
    }
    if cur_kind() == 34 { advance() }
}

fn skip_to_next_top_level() with Mut, Panic, Div {
    while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 51 && cur_kind() != 52 && cur_kind() != 59 && cur_kind() != 60 {
        if cur_kind() == 33 {
            skip_braces()
        } else {
            advance()
        }
    }
}

fn parse_program() with Mut, Panic, Div {
    while cur_kind() != 0 {
        let k = cur_kind()
        if k == 50 {
            parse_fn_def()
        } else if k == 58 {
            parse_struct_decl()
        } else if k == 59 {
            // enum: skip entire declaration
            advance()
            if cur_kind() == 1 { advance() }
            skip_braces()
        } else if k == 60 {
            // impl: collect fn definitions inside
            advance()
            parse_impl_body()
        } else if k == 51 || k == 52 {
            while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 59 && cur_kind() != 60 {
                advance()
            }
        } else if k == 1 {
            let koff = tok_pool_off()
            let klen = tok_ident_len()
            if pool_match(koff, klen, "use") {
                advance()
                while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 39 {
                    advance()
                }
                if cur_kind() == 39 { advance() }
            } else {
                skip_to_next_top_level()
            }
        } else {
            skip_to_next_top_level()
        }
    }
}

// ============================================================================
// Codegen helpers
// ============================================================================

fn emit(b: i64) with Mut, Panic {
    if CODE_LEN < 0 || CODE_LEN >= 4194304 {
        print("EMIT OVERFLOW CODE_LEN=")
        print_int(CODE_LEN)
        print("\n")
        return
    }
    CODE[CODE_LEN as usize] = b as i8
    CODE_LEN = CODE_LEN + 1
}

fn emit_u32(v: i64) with Mut, Panic {
    emit(v & 0xFF)
    emit((v >> 8) & 0xFF)
    emit((v >> 16) & 0xFF)
    emit((v >> 24) & 0xFF)
}

fn emit_u64(v: i64) with Mut, Panic {
    emit_u32(v)
    emit_u32(v >> 32)
}

fn emit_mov_rax_imm(val: i64) with Mut, Panic {
    emit(0x48); emit(0xB8)
    emit_u64(val)
}

fn emit_store_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x89); emit(0x85)
    emit_u32(disp)
}

fn emit_load_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8B); emit(0x85)
    emit_u32(disp)
}

fn emit_lea_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8D); emit(0x85)
    emit_u32(disp)
}

fn emit_load_rcx(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8B); emit(0x8D)
    emit_u32(disp)
}

fn emit_prologue() with Mut, Panic {
    emit(0x55)
    emit(0x48); emit(0x89); emit(0xE5)
    emit(0x48); emit(0x81); emit(0xEC)
    emit_u32(131072)
}

fn emit_epilogue() with Mut, Panic {
    emit(0x48); emit(0x89); emit(0xEC)
    emit(0x5D)
    emit(0xC3)
}

fn emit_print_int_helper() with Mut, Panic {
    PRINT_INT_OFF = CODE_LEN
    emit(0x55)
    emit(0x48); emit(0x89); emit(0xE5)
    emit(0x48); emit(0x83); emit(0xEC); emit(0x30)
    emit(0x48); emit(0x89); emit(0xF8)
    emit(0x4C); emit(0x8D); emit(0x45); emit(0xFF)
    emit(0x45); emit(0x31); emit(0xC9)
    emit(0x48); emit(0x85); emit(0xC0)
    emit(0x79); emit(0x06)
    emit(0x48); emit(0xF7); emit(0xD8)
    emit(0x41); emit(0xB1); emit(0x01)
    emit(0x48); emit(0x85); emit(0xC0)
    emit(0x75); emit(0x09)
    emit(0x41); emit(0xC6); emit(0x00); emit(0x30)
    emit(0x49); emit(0xFF); emit(0xC8)
    emit(0xEB); emit(0x26)
    emit(0x31); emit(0xD2)
    emit(0x48); emit(0xC7); emit(0xC1); emit(0x0A); emit(0x00); emit(0x00); emit(0x00)
    emit(0x48); emit(0xF7); emit(0xF1)
    emit(0x80); emit(0xC2); emit(0x30)
    emit(0x41); emit(0x88); emit(0x10)
    emit(0x49); emit(0xFF); emit(0xC8)
    emit(0x48); emit(0x85); emit(0xC0)
    emit(0x75); emit(0xE6)
    emit(0x45); emit(0x84); emit(0xC9)
    emit(0x74); emit(0x07)
    emit(0x41); emit(0xC6); emit(0x00); emit(0x2D)
    emit(0x49); emit(0xFF); emit(0xC8)
    emit(0x49); emit(0xFF); emit(0xC0)
    emit(0x4C); emit(0x89); emit(0xC6)
    emit(0x48); emit(0x89); emit(0xEA)
    emit(0x4C); emit(0x29); emit(0xC2)
    emit(0xBF); emit(0x01); emit(0x00); emit(0x00); emit(0x00)
    emit(0xB8); emit(0x01); emit(0x00); emit(0x00); emit(0x00)
    emit(0x0F); emit(0x05)
    emit(0xC9)
    emit(0xC3)
}

// ============================================================================
// Codegen: local variable management
// ============================================================================

fn locals_reset() with Mut {
    LOCAL_COUNT = 0
    NEXT_SLOT = 0
}

fn alloc_slot() -> i64 with Mut {
    let s = NEXT_SLOT
    if s > 16000 {
        print("SLOT OVERFLOW slot=")
        print_int(s)
        print("\n")
    }
    NEXT_SLOT = NEXT_SLOT + 1
    s
}

fn add_local(off: i64, len: i64) -> i64 with Mut, Panic {
    let idx = LOCAL_COUNT
    let slot = alloc_slot()
    LOCAL_NAME_OFF[idx as usize] = off
    LOCAL_NAME_LEN[idx as usize] = len
    LOCAL_SLOT[idx as usize] = slot
    LOCAL_STRUCT_IDX[idx as usize] = -1
    LOCAL_COUNT = LOCAL_COUNT + 1
    slot
}

fn add_local_struct(off: i64, len: i64, si: i64, fc: i64) -> i64 with Mut, Panic {
    let idx = LOCAL_COUNT
    let base = NEXT_SLOT
    LOCAL_NAME_OFF[idx as usize] = off
    LOCAL_NAME_LEN[idx as usize] = len
    LOCAL_SLOT[idx as usize] = base
    LOCAL_STRUCT_IDX[idx as usize] = si
    LOCAL_COUNT = LOCAL_COUNT + 1
    var ai: i64 = 0
    while ai < fc { let ds = alloc_slot(); ai = ai + 1 }
    base
}

fn find_local(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    LAST_LOCAL_SI = -1
    var i: i64 = LOCAL_COUNT - 1
    while i >= 0 {
        let lo = LOCAL_NAME_OFF[i as usize]
        let ll = LOCAL_NAME_LEN[i as usize]
        if ll == len {
            var ok: i64 = 1
            var j: i64 = 0
            while j < len {
                if POOL[(lo + j) as usize] != POOL[(off + j) as usize] { ok = 0 }
                j = j + 1
            }
            if ok == 1 {
                LAST_LOCAL_SI = LOCAL_STRUCT_IDX[i as usize]
                return LOCAL_SLOT[i as usize]
            }
        }
        i = i - 1
    }
    -1
}

fn find_fn_by_name(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < FN_COUNT {
        let fo = FN_NAME_OFF[i as usize]
        let fl = FN_NAME_LEN[i as usize]
        if fl == len {
            var ok: i64 = 1
            var j: i64 = 0
            while j < len {
                if POOL[(fo + j) as usize] != POOL[(off + j) as usize] { ok = 0; break }
                j = j + 1
            }
            if ok == 1 { return i }
        }
        i = i + 1
    }
    -1
}

// ============================================================================
// Global variable collection
// ============================================================================

fn mb_collect_globals() with Mut, Panic, Div {
    var ti: i64 = 0
    var depth: i64 = 0
    while ti < TK_COUNT {
        let k = TK_KIND[ti as usize]
        if k == 0 { break }
        if k == 33 { depth = depth + 1 }
        else if k == 34 { depth = depth - 1 }
        else if k == 52 && depth == 0 {
            ti = ti + 1
            let ns = TK_START[ti as usize]
            let ne = TK_END[ti as usize]
            let gi = MB_GL_COUNT
            MB_GL_NS[gi as usize] = ns
            MB_GL_NE[gi as usize] = ne
            MB_GL_OFF[gi as usize] = MB_BSS_TOTAL
            ti = ti + 1
            var sz: i64 = 8
            var count: i64 = 1
            if TK_KIND[ti as usize] == 38 {
                ti = ti + 1
                if TK_KIND[ti as usize] == 35 {
                    ti = ti + 1
                    if TK_KIND[ti as usize] == 1 {
                        let tns = TK_START[ti as usize]
                        let tne = TK_END[ti as usize]
                        if tne - tns == 2 {
                            let b0 = source_byte(tns)
                            let b1 = source_byte(tns + 1)
                            if b0 == 105 && b1 == 56 { sz = 1 }
                        }
                        ti = ti + 1
                    }
                    if TK_KIND[ti as usize] == 39 { ti = ti + 1 }
                    if TK_KIND[ti as usize] == 2 {
                        count = TK_IVAL[ti as usize]
                        ti = ti + 1
                    }
                    if TK_KIND[ti as usize] == 36 { ti = ti + 1 }
                } else {
                    if TK_KIND[ti as usize] == 1 || TK_KIND[ti as usize] >= 50 { ti = ti + 1 }
                }
            }
            MB_GL_SZ[gi as usize] = sz
            MB_BSS_TOTAL = MB_BSS_TOTAL + count * sz
            let rem = MB_BSS_TOTAL - (MB_BSS_TOTAL / 8) * 8
            if rem != 0 { MB_BSS_TOTAL = MB_BSS_TOTAL + (8 - rem) }
            MB_GL_COUNT = MB_GL_COUNT + 1
        }
        ti = ti + 1
    }
}

fn mb_find_global(pool_off: i64, pool_len: i64) -> i64 with Mut, Panic, Div {
    var gi: i64 = 0
    while gi < MB_GL_COUNT {
        let ns = MB_GL_NS[gi as usize]
        let ne = MB_GL_NE[gi as usize]
        if pool_len == ne - ns {
            var ok: i64 = 1
            var ci: i64 = 0
            while ci < pool_len {
                let pb = POOL[(pool_off + ci) as usize] as i64
                let sb = source_byte(ns + ci)
                if pb != sb { ok = 0 }
                ci = ci + 1
            }
            if ok == 1 { return gi }
        }
        gi = gi + 1
    }
    0 - 1
}

fn mb_resolve_src_globals() with Mut, Panic, Div {
    var gi: i64 = 0
    while gi < MB_GL_COUNT {
        let ns = MB_GL_NS[gi as usize]
        let ne = MB_GL_NE[gi as usize]
        if ne - ns == 7 {
            let b0 = source_byte(ns)
            let b1 = source_byte(ns + 1)
            let b2 = source_byte(ns + 2)
            let b3 = source_byte(ns + 3)
            let b4 = source_byte(ns + 4)
            let b5 = source_byte(ns + 5)
            let b6 = source_byte(ns + 6)
            if b0 == 83 && b1 == 82 && b2 == 67 && b3 == 95 && b4 == 66 && b5 == 85 && b6 == 70 {
                MB_SRC_BUF_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
            }
            if b0 == 83 && b1 == 82 && b2 == 67 && b3 == 95 && b4 == 76 && b5 == 69 && b6 == 78 {
                MB_SRC_LEN_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
            }
        }
        gi = gi + 1
    }
}

// ============================================================================
// Codegen: compile AST nodes
// ============================================================================

fn compile_node(node: i64) -> i64 with Mut, Panic, Div {
    if node == -1 {
        emit_mov_rax_imm(0)
        return 0
    }
    if node < 0 || node >= 131072 {
        print("BAD NODE node=")
        print_int(node)
        print("\n")
        return 0
    }
    let kind = ND_KIND[node as usize]
    let ival = ND_IVAL[node as usize]

    if kind == 1 {
        emit_mov_rax_imm(ival)
        return 0
    }
    if kind == 4 {
        emit_mov_rax_imm(ival)
        return 0
    }
    if kind == 3 {
        let soff = ND_STR_OFF[node as usize]
        let slen = ND_STR_LEN[node as usize]
        emit(0xEB)
        let jmp_pos = CODE_LEN
        emit(0x00)
        let str_addr = CODE_LEN
        var si: i64 = 0
        while si < slen {
            emit(POOL[(soff + si) as usize] as i64)
            si = si + 1
        }
        emit(0)
        let dist = CODE_LEN - jmp_pos - 1
        CODE[jmp_pos as usize] = dist as i8
        emit(0x48); emit(0x8D); emit(0x05)
        let rel = str_addr - (CODE_LEN + 4)
        emit_u32(rel)
        return 0
    }
    if kind == 2 {
        let voff = ND_STR_OFF[node as usize]
        let vlen = ND_STR_LEN[node as usize]
        let slot = find_local(voff, vlen)
        if slot >= 0 {
            emit_load_rax(slot)
        } else {
            let gi = mb_find_global(voff, vlen)
            if gi >= 0 {
                let gaddr = 0x700000 + MB_GL_OFF[gi as usize]
                emit(0x48); emit(0xB9); emit_u64(gaddr)
                if MB_GL_SZ[gi as usize] == 1 {
                    emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)
                } else {
                    emit(0x48); emit(0x8B); emit(0x01)
                }
            } else {
                emit_mov_rax_imm(0)
            }
        }
        return 0
    }
    if kind == 46 {
        compile_node(ND_LEFT[node as usize])
        emit(0x48); emit(0x8B); emit(0x00)
        return 0
    }
    // NK_ADDR: &expr — emit address of inner expression
    // Handles: &local_var → lea rax, [rbp - (slot+1)*8]
    //          &struct.field → lea rax, [rbp - (base_slot+fi+1)*8]
    //          &global → rip-relative lea
    if kind == 49 {
        let inner = ND_LEFT[node as usize]
        let ik = ND_KIND[inner as usize]
        if ik == 2 {
            let voff2 = ND_STR_OFF[inner as usize]
            let vlen2 = ND_STR_LEN[inner as usize]
            let slot2 = find_local(voff2, vlen2)
            if slot2 >= 0 {
                emit_lea_rax(slot2)
            } else {
                let gi2 = mb_find_global(voff2, vlen2)
                if gi2 >= 0 {
                    let gaddr2 = 0x700000 + MB_GL_OFF[gi2 as usize]
                    emit(0x48); emit(0xB8); emit_u64(gaddr2)
                } else {
                    emit_mov_rax_imm(0)
                }
            }
        } else if ik == 14 {
            let obj2 = ND_LEFT[inner as usize]
            let fn2 = ND_STR_OFF[inner as usize]
            let fl2 = ND_STR_LEN[inner as usize]
            let vo2 = ND_STR_OFF[obj2 as usize]
            let vl2 = ND_STR_LEN[obj2 as usize]
            let bs2 = find_local(vo2, vl2)
            let si3 = LAST_LOCAL_SI
            if bs2 >= 0 && si3 >= 0 {
                let fi2 = find_field_b4(si3, fn2, fl2)
                if fi2 >= 0 {
                    emit_lea_rax(bs2 + fi2)
                } else {
                    emit_mov_rax_imm(0)
                }
            } else {
                emit_mov_rax_imm(0)
            }
        } else {
            compile_node(inner)
        }
        return 0
    }
    if kind == 14 {
        let obj = ND_LEFT[node as usize]
        let fname_off = ND_STR_OFF[node as usize]
        let fname_len = ND_STR_LEN[node as usize]
        let voff = ND_STR_OFF[obj as usize]
        let vlen = ND_STR_LEN[obj as usize]
        let base_slot = find_local(voff, vlen)
        let si2 = LAST_LOCAL_SI
        if base_slot >= 0 && si2 >= 0 {
            let fi = find_field_b4(si2, fname_off, fname_len)
            if fi >= 0 {
                emit_load_rax(base_slot + fi)
            } else {
                emit_mov_rax_imm(0)
            }
        } else {
            emit_mov_rax_imm(0)
        }
        return 0
    }
    if kind == 10 {
        let left = ND_LEFT[node as usize]
        let right = ND_RIGHT[node as usize]
        compile_node(right)
        let tmp = alloc_slot()
        emit_store_rax(tmp)
        compile_node(left)
        emit_load_rcx(tmp)
        if ival == 0 { emit(0x48); emit(0x01); emit(0xC8) }
        else if ival == 1 { emit(0x48); emit(0x29); emit(0xC8) }
        else if ival == 2 { emit(0x48); emit(0x0F); emit(0xAF); emit(0xC1) }
        else if ival == 3 {
            emit(0x48); emit(0x99)
            emit(0x48); emit(0xF7); emit(0xF9)
        }
        else if ival == 4 {
            emit(0x48); emit(0x99)
            emit(0x48); emit(0xF7); emit(0xF9)
            emit(0x48); emit(0x89); emit(0xD0)
        }
        else if ival == 5 {
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x94); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 6 {
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x95); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 7 {
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9C); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 8 {
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9E); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 9 {
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9F); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 10 {
            emit(0x48); emit(0x39); emit(0xC8)
            emit(0x0F); emit(0x9D); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 13 { emit(0x48); emit(0x21); emit(0xC8) }
        else if ival == 14 { emit(0x48); emit(0x09); emit(0xC8) }
        else if ival == 15 { emit(0x48); emit(0x31); emit(0xC8) }
        else if ival == 16 {
            emit(0x48); emit(0xD3); emit(0xE0)
        }
        else if ival == 17 {
            emit(0x48); emit(0xD3); emit(0xF8)
        }
        else if ival == 11 {
            emit(0x48); emit(0x85); emit(0xC0)
            emit(0x0F); emit(0x95); emit(0xC0)
            emit(0x48); emit(0x85); emit(0xC9)
            emit(0x0F); emit(0x95); emit(0xC1)
            emit(0x20); emit(0xC8)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        else if ival == 12 {
            emit(0x48); emit(0x09); emit(0xC8)
            emit(0x48); emit(0x85); emit(0xC0)
            emit(0x0F); emit(0x95); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        return 0
    }
    if kind == 11 {
        let operand = ND_LEFT[node as usize]
        compile_node(operand)
        if ival == 1 {
            emit(0x48); emit(0xF7); emit(0xD8)
        } else {
            emit(0x48); emit(0x85); emit(0xC0)
            emit(0x0F); emit(0x94); emit(0xC0)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
        return 0
    }
    if kind == 13 {
        let arr_nd = ND_LEFT[node as usize]
        let idx_nd = ND_RIGHT[node as usize]
        let avoff = ND_STR_OFF[arr_nd as usize]
        let avlen = ND_STR_LEN[arr_nd as usize]
        var asz: i64 = 1
        let aslot = find_local(avoff, avlen)
        if aslot >= 0 {
            let adisp = 0 - ((aslot + 1) * 8)
            emit(0x48); emit(0x8B); emit(0x8D); emit_u32(adisp)
        } else {
            let agi = mb_find_global(avoff, avlen)
            if agi >= 0 {
                let gaaddr = 0x700000 + MB_GL_OFF[agi as usize]
                emit(0x48); emit(0xB9); emit_u64(gaaddr)
                asz = MB_GL_SZ[agi as usize]
            } else {
                emit(0x48); emit(0x31); emit(0xC9)
            }
        }
        let idx_save = alloc_slot()
        emit(0x48); emit(0x89); emit(0x8D); emit_u32(0 - ((idx_save + 1) * 8))
        compile_node(idx_nd)
        emit(0x48); emit(0x8B); emit(0x8D); emit_u32(0 - ((idx_save + 1) * 8))
        if asz == 1 {
            emit(0x48); emit(0x01); emit(0xC1)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)
        } else {
            emit(0x48); emit(0xC1); emit(0xE0); emit(0x03)
            emit(0x48); emit(0x01); emit(0xC1)
            emit(0x48); emit(0x8B); emit(0x01)
        }
        return 0
    }
    if kind == 12 {
        let callee = ND_LEFT[node as usize]
        let c_off = ND_STR_OFF[callee as usize]
        let c_len = ND_STR_LEN[callee as usize]

        if pool_match(c_off, c_len, "str_len") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x48); emit(0x31); emit(0xC9)
            emit(0x80); emit(0x3C); emit(0x0F); emit(0x00)
            emit(0x74); emit(0x05)
            emit(0x48); emit(0xFF); emit(0xC1)
            emit(0xEB); emit(0 - 11)
            emit(0x48); emit(0x89); emit(0xC8)
            return 0
        }

        if pool_match(c_off, c_len, "str_char_at") {
            let arg0 = ND_EXTRA[node as usize]
            var arg1: i64 = -1
            if arg0 != -1 { arg1 = ND_EXTRA[arg0 as usize] }
            let s0 = alloc_slot()
            let s1 = alloc_slot()
            if arg0 != -1 { compile_node(arg0); emit_store_rax(s0) }
            if arg1 != -1 { compile_node(arg1); emit_store_rax(s1) }
            emit_load_rax(s0)
            emit(0x48); emit(0x89); emit(0xC7)
            emit_load_rax(s1)
            emit(0x48); emit(0x89); emit(0xC6)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x04); emit(0x37)
            return 0
        }

        if pool_match(c_off, c_len, "print") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                let slen = ND_STR_LEN[arg as usize]
                compile_node(arg)
                emit(0x48); emit(0x89); emit(0xC6)
                emit(0xBA); emit_u32(slen)
                emit(0xBF); emit_u32(1)
                emit(0xB8); emit_u32(1)
                emit(0x0F); emit(0x05)
            }
            emit_mov_rax_imm(0)
            return 0
        }

        if pool_match(c_off, c_len, "print_int") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                compile_node(arg)
            }
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0xE8)
            let rel = PRINT_INT_OFF - (CODE_LEN + 4)
            emit_u32(rel)
            return 0
        }

        if pool_match(c_off, c_len, "exit") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                compile_node(arg)
            }
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x48); emit(0xC7); emit(0xC0); emit_u32(60)
            emit(0x0F); emit(0x05)
            return 0
        }

        if pool_match(c_off, c_len, "arg_count") {
            emit(0x48); emit(0xB8); emit_u64(0x700000)
            emit(0x48); emit(0x8B); emit(0x00)
            emit(0x48); emit(0x8B); emit(0x00)
            emit(0x48); emit(0xFF); emit(0xC8)
            return 0
        }

        if pool_match(c_off, c_len, "get_arg") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }
            emit(0x48); emit(0x83); emit(0xC0); emit(2)
            emit(0x48); emit(0x89); emit(0xC2)
            emit(0x48); emit(0xB9); emit_u64(0x700000)
            emit(0x48); emit(0x8B); emit(0x09)
            emit(0x48); emit(0x8B); emit(0x04); emit(0xD1)
            return 0
        }

        if pool_match(c_off, c_len, "file_size") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x48); emit(0x31); emit(0xF6)
            emit(0x48); emit(0x31); emit(0xD2)
            emit(0xB8); emit_u32(2)
            emit(0x0F); emit(0x05)
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x48); emit(0x81); emit(0xEC); emit_u32(176)
            emit(0x48); emit(0x89); emit(0xE6)
            emit(0x57)
            emit(0xB8); emit_u32(5)
            emit(0x0F); emit(0x05)
            emit(0x48); emit(0x8B); emit(0x44); emit(0x24); emit(56)
            emit(0x50)
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(8)
            emit(0xB8); emit_u32(3)
            emit(0x0F); emit(0x05)
            emit(0x58)
            emit(0x48); emit(0x81); emit(0xC4); emit_u32(184)
            return 0
        }

        if pool_match(c_off, c_len, "read_file") {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }
            emit(0x50)
            emit(0x48); emit(0x31); emit(0xFF)
            emit(0x48); emit(0xBE); emit_u64(1048576)
            emit(0xBA); emit_u32(3)
            emit(0x41); emit(0xBA); emit_u32(0x22)
            emit(0x49); emit(0xC7); emit(0xC0); emit_u32(0 - 1)
            emit(0x4D); emit(0x31); emit(0xC9)
            emit(0xB8); emit_u32(9)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(8)
            emit(0x48); emit(0x31); emit(0xF6)
            emit(0x48); emit(0x31); emit(0xD2)
            emit(0xB8); emit_u32(2)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x8B); emit(0x3C); emit(0x24)
            emit(0x48); emit(0x8B); emit(0x74); emit(0x24); emit(8)
            emit(0x48); emit(0xBA); emit_u64(1048576)
            emit(0xB8); emit_u32(0)
            emit(0x0F); emit(0x05)
            emit(0x5F)
            emit(0xB8); emit_u32(3)
            emit(0x0F); emit(0x05)
            emit(0x58)
            emit(0x48); emit(0x83); emit(0xC4); emit(8)
            return 0
        }

        if pool_match(c_off, c_len, "write_file") {
            var wf_argc: i64 = 0
            var wf_node = ND_EXTRA[node as usize]
            while wf_node != -1 && wf_argc < 3 {
                if wf_argc == 1 && ND_KIND[wf_node as usize] == 2 {
                    let wf_voff = ND_STR_OFF[wf_node as usize]
                    let wf_vlen = ND_STR_LEN[wf_node as usize]
                    let wf_gi = mb_find_global(wf_voff, wf_vlen)
                    if wf_gi >= 0 {
                        let wf_gaddr = 0x700000 + MB_GL_OFF[wf_gi as usize]
                        emit_mov_rax_imm(wf_gaddr)
                    } else {
                        compile_node(wf_node)
                    }
                } else {
                    compile_node(wf_node)
                }
                emit(0x50)
                wf_argc = wf_argc + 1
                wf_node = ND_EXTRA[wf_node as usize]
            }
            emit(0x59)
            emit(0x5E)
            emit(0x5F)
            emit(0x51); emit(0x56)
            emit(0x48); emit(0xBE); emit_u64(0x241)
            emit(0xBA); emit_u32(420)
            emit(0xB8); emit_u32(2)
            emit(0x0F); emit(0x05)
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x57)
            emit(0x48); emit(0x8B); emit(0x74); emit(0x24); emit(8)
            emit(0x48); emit(0x8B); emit(0x54); emit(0x24); emit(16)
            emit(0xB8); emit_u32(1)
            emit(0x0F); emit(0x05)
            emit(0x5F)
            emit(0xB8); emit_u32(3)
            emit(0x0F); emit(0x05)
            emit(0x48); emit(0x83); emit(0xC4); emit(16)
            emit_mov_rax_imm(0)
            return 0
        }

        if pool_match(c_off, c_len, "load_source") && MB_SRC_BUF_GADDR != 0 {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x48); emit(0x31); emit(0xF6)
            emit(0x48); emit(0x31); emit(0xD2)
            emit(0xB8); emit_u32(2)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x31); emit(0xFF)
            emit(0x48); emit(0xBE); emit_u64(1048576)
            emit(0xBA); emit_u32(3)
            emit(0x41); emit(0xBA); emit_u32(0x22)
            emit(0x49); emit(0xC7); emit(0xC0); emit_u32(0 - 1)
            emit(0x4D); emit(0x31); emit(0xC9)
            emit(0xB8); emit_u32(9)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(8)
            emit(0x48); emit(0x8B); emit(0x74); emit(0x24); emit(0)
            emit(0x48); emit(0xBA); emit_u64(1048576)
            emit(0xB8); emit_u32(0)
            emit(0x0F); emit(0x05)
            emit(0x50)
            emit(0x48); emit(0x8B); emit(0x7C); emit(0x24); emit(16)
            emit(0xB8); emit_u32(3)
            emit(0x0F); emit(0x05)
            emit(0x58)
            emit(0x59)
            emit(0x5A)
            emit(0x48); emit(0xBA); emit_u64(MB_SRC_BUF_GADDR)
            emit(0x48); emit(0x89); emit(0x0A)
            emit(0x48); emit(0xBA); emit_u64(MB_SRC_LEN_GADDR)
            emit(0x48); emit(0x89); emit(0x02)
            return 0
        }

        if pool_match(c_off, c_len, "source_byte") && MB_SRC_BUF_GADDR != 0 {
            let arg0 = ND_EXTRA[node as usize]
            if arg0 != -1 { compile_node(arg0) }
            emit(0x48); emit(0xB9); emit_u64(MB_SRC_BUF_GADDR)
            emit(0x48); emit(0x8B); emit(0x09)
            emit(0x48); emit(0x01); emit(0xC1)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)
            return 0
        }

        var argc: i64 = 0
        var arg_node = ND_EXTRA[node as usize]
        var arg_slot0: i64 = 0
        var arg_slot1: i64 = 0
        var arg_slot2: i64 = 0
        var arg_slot3: i64 = 0
        while arg_node != -1 && argc < 4 {
            compile_node(arg_node)
            let s = alloc_slot()
            emit_store_rax(s)
            if argc == 0 { arg_slot0 = s }
            else if argc == 1 { arg_slot1 = s }
            else if argc == 2 { arg_slot2 = s }
            else { arg_slot3 = s }
            argc = argc + 1
            arg_node = ND_EXTRA[arg_node as usize]
        }
        if argc > 0 {
            emit_load_rax(arg_slot0)
            emit(0x48); emit(0x89); emit(0xC7)
        }
        if argc > 1 {
            emit_load_rax(arg_slot1)
            emit(0x48); emit(0x89); emit(0xC6)
        }
        if argc > 2 {
            emit_load_rax(arg_slot2)
            emit(0x48); emit(0x89); emit(0xC2)
        }
        if argc > 3 {
            emit_load_rax(arg_slot3)
            emit(0x48); emit(0x89); emit(0xC1)
        }

        let fn_idx = find_fn_by_name(c_off, c_len)
        emit(0xE8)
        let fix_pos = CODE_LEN
        emit_u32(0)
        if fn_idx >= 0 {
            FIX_OFF[FIX_COUNT as usize] = fix_pos
            FIX_TARGET[FIX_COUNT as usize] = fn_idx
            FIX_COUNT = FIX_COUNT + 1
        }
        return 0
    }
    if kind == 33 {
        var stmt = ND_LEFT[node as usize]
        while stmt != -1 {
            let next = ND_RIGHT[stmt as usize]
            compile_node(stmt)
            stmt = next
        }
        return 0
    }
    if kind == 40 || kind == 41 {
        let name_off = ND_STR_OFF[node as usize]
        let name_len = ND_STR_LEN[node as usize]
        let init = ND_LEFT[node as usize]
        let struct_si = ND_IVAL[node as usize]
        if struct_si >= 0 && init != -1 && ND_KIND[init as usize] == 47 {
            let fc2 = ST_FIELD_COUNT[struct_si as usize]
            let bslot2 = add_local_struct(name_off, name_len, struct_si, fc2)
            var fni = ND_EXTRA[init as usize]
            while fni != -1 {
                let fi2 = ND_IVAL[fni as usize]
                compile_node(ND_LEFT[fni as usize])
                if fi2 >= 0 {
                    emit_store_rax(bslot2 + fi2)
                }
                fni = ND_RIGHT[fni as usize]
            }
            return 0
        }
        if init != -1 && ND_KIND[init as usize] == 50 {
            let arr_count = ND_IVAL[init as usize]
            let ptr_slot = add_local(name_off, name_len)
            var ai: i64 = 0
            while ai < arr_count {
                alloc_slot()
                ai = ai + 1
            }
            let data_disp = 0 - ((ptr_slot + 2) * 8)
            emit(0x48); emit(0x8D); emit(0x85); emit_u32(data_disp)
            emit_store_rax(ptr_slot)
            var zi: i64 = 0
            while zi < arr_count {
                let zdisp = 0 - ((ptr_slot + 2 + zi) * 8)
                compile_node(ND_LEFT[init as usize])
                emit(0x48); emit(0x89); emit(0x85); emit_u32(zdisp)
                zi = zi + 1
            }
        } else {
            compile_node(init)
            let slot = add_local(name_off, name_len)
            emit_store_rax(slot)
        }
        return 0
    }
    if kind == 42 {
        let target = ND_LEFT[node as usize]
        let rhs = ND_EXTRA[node as usize]
        let tk2 = ND_KIND[target as usize]
        if tk2 == 2 {
            compile_node(rhs)
            let voff2 = ND_STR_OFF[target as usize]
            let vlen2 = ND_STR_LEN[target as usize]
            let slot2 = find_local(voff2, vlen2)
            if slot2 >= 0 {
                emit_store_rax(slot2)
            } else {
                let gi2 = mb_find_global(voff2, vlen2)
                if gi2 >= 0 {
                    let gaddr2 = 0x700000 + MB_GL_OFF[gi2 as usize]
                    let gsave2 = alloc_slot()
                    emit_store_rax(gsave2)
                    emit(0x48); emit(0xB9); emit_u64(gaddr2)
                    emit_load_rax(gsave2)
                    if MB_GL_SZ[gi2 as usize] == 1 {
                        emit(0x88); emit(0x01)
                    } else {
                        emit(0x48); emit(0x89); emit(0x01)
                    }
                }
            }
        } else if tk2 == 13 {
            compile_node(rhs)
            let val_save = alloc_slot()
            emit_store_rax(val_save)
            let arr_nd2 = ND_LEFT[target as usize]
            let idx_nd2 = ND_RIGHT[target as usize]
            let avoff2 = ND_STR_OFF[arr_nd2 as usize]
            let avlen2 = ND_STR_LEN[arr_nd2 as usize]
            var asz2: i64 = 8
            let aslot2 = find_local(avoff2, avlen2)
            if aslot2 >= 0 {
                let adisp2 = 0 - ((aslot2 + 1) * 8)
                emit(0x48); emit(0x8B); emit(0x8D); emit_u32(adisp2)
            } else {
                let agi2 = mb_find_global(avoff2, avlen2)
                if agi2 >= 0 {
                    let gaaddr2 = 0x700000 + MB_GL_OFF[agi2 as usize]
                    emit(0x48); emit(0xB9); emit_u64(gaaddr2)
                    asz2 = MB_GL_SZ[agi2 as usize]
                } else {
                    emit(0x48); emit(0x31); emit(0xC9)
                }
            }
            let base_save = alloc_slot()
            emit(0x48); emit(0x89); emit(0x8D); emit_u32(0 - ((base_save + 1) * 8))
            compile_node(idx_nd2)
            emit(0x48); emit(0x8B); emit(0x8D); emit_u32(0 - ((base_save + 1) * 8))
            if asz2 == 1 {
                emit(0x48); emit(0x01); emit(0xC1)
            } else {
                emit(0x48); emit(0xC1); emit(0xE0); emit(0x03)
                emit(0x48); emit(0x01); emit(0xC1)
            }
            emit(0x48); emit(0x8B); emit(0x95); emit_u32(0 - ((val_save + 1) * 8))
            if asz2 == 1 {
                emit(0x88); emit(0x11)
            } else {
                emit(0x48); emit(0x89); emit(0x11)
            }
        } else if tk2 == 46 {
            // *ptr = value — store through pointer
            compile_node(rhs)
            let vs = alloc_slot()
            emit_store_rax(vs)
            compile_node(ND_LEFT[target as usize])
            emit_load_rcx(vs)
            emit(0x48); emit(0x89); emit(0x08)
        } else if tk2 == 14 {
            compile_node(rhs)
            let val_s = alloc_slot()
            emit_store_rax(val_s)
            let obj_nd = ND_LEFT[target as usize]
            let fn_off2 = ND_STR_OFF[target as usize]
            let fn_len2 = ND_STR_LEN[target as usize]
            let v_off2 = ND_STR_OFF[obj_nd as usize]
            let v_len2 = ND_STR_LEN[obj_nd as usize]
            let bs2 = find_local(v_off2, v_len2)
            let lsi2 = LAST_LOCAL_SI
            if bs2 >= 0 && lsi2 >= 0 {
                let fi3 = find_field_b4(lsi2, fn_off2, fn_len2)
                if fi3 >= 0 {
                    emit_load_rax(val_s)
                    emit_store_rax(bs2 + fi3)
                }
            }
        }
        return 0
    }
    if kind == 43 {
        let expr = ND_LEFT[node as usize]
        compile_node(expr)
        return 0
    }
    if kind == 34 {
        let val = ND_LEFT[node as usize]
        compile_node(val)
        emit_epilogue()
        return 0
    }
    if kind == 30 {
        let cond = ND_LEFT[node as usize]
        let then_body = ND_EXTRA[node as usize]
        let else_body = ND_EXTRA2[node as usize]
        compile_node(cond)
        emit(0x48); emit(0x85); emit(0xC0)
        emit(0x0F); emit(0x84)
        let je_pos = CODE_LEN
        emit_u32(0)
        compile_node(then_body)
        if else_body != -1 {
            emit(0xE9)
            let jmp_pos = CODE_LEN
            emit_u32(0)
            let else_off = CODE_LEN - je_pos - 4
            CODE[je_pos as usize] = (else_off & 0xFF) as i8
            CODE[(je_pos + 1) as usize] = ((else_off >> 8) & 0xFF) as i8
            CODE[(je_pos + 2) as usize] = ((else_off >> 16) & 0xFF) as i8
            CODE[(je_pos + 3) as usize] = ((else_off >> 24) & 0xFF) as i8
            compile_node(else_body)
            let end_off = CODE_LEN - jmp_pos - 4
            CODE[jmp_pos as usize] = (end_off & 0xFF) as i8
            CODE[(jmp_pos + 1) as usize] = ((end_off >> 8) & 0xFF) as i8
            CODE[(jmp_pos + 2) as usize] = ((end_off >> 16) & 0xFF) as i8
            CODE[(jmp_pos + 3) as usize] = ((end_off >> 24) & 0xFF) as i8
        } else {
            let skip_off = CODE_LEN - je_pos - 4
            CODE[je_pos as usize] = (skip_off & 0xFF) as i8
            CODE[(je_pos + 1) as usize] = ((skip_off >> 8) & 0xFF) as i8
            CODE[(je_pos + 2) as usize] = ((skip_off >> 16) & 0xFF) as i8
            CODE[(je_pos + 3) as usize] = ((skip_off >> 24) & 0xFF) as i8
        }
        return 0
    }
    if kind == 31 {
        let cond = ND_LEFT[node as usize]
        let body = ND_EXTRA[node as usize]
        let prev_loop_top = LOOP_TOP
        let prev_break_count = BREAK_FIXUP_COUNT
        let loop_top = CODE_LEN
        LOOP_TOP = loop_top
        compile_node(cond)
        emit(0x48); emit(0x85); emit(0xC0)
        emit(0x0F); emit(0x84)
        let je_pos = CODE_LEN
        emit_u32(0)
        compile_node(body)
        emit(0xE9)
        let jmp_rel = loop_top - (CODE_LEN + 4)
        emit_u32(jmp_rel)
        let loop_exit = CODE_LEN
        let exit_off = loop_exit - je_pos - 4
        CODE[je_pos as usize] = (exit_off & 0xFF) as i8
        CODE[(je_pos + 1) as usize] = ((exit_off >> 8) & 0xFF) as i8
        CODE[(je_pos + 2) as usize] = ((exit_off >> 16) & 0xFF) as i8
        CODE[(je_pos + 3) as usize] = ((exit_off >> 24) & 0xFF) as i8
        var bfi: i64 = prev_break_count
        while bfi < BREAK_FIXUP_COUNT {
            let bpos = BREAK_FIXUP_OFF[bfi as usize]
            let brel = loop_exit - bpos - 4
            CODE[bpos as usize] = (brel & 0xFF) as i8
            CODE[(bpos + 1) as usize] = ((brel >> 8) & 0xFF) as i8
            CODE[(bpos + 2) as usize] = ((brel >> 16) & 0xFF) as i8
            CODE[(bpos + 3) as usize] = ((brel >> 24) & 0xFF) as i8
            bfi = bfi + 1
        }
        BREAK_FIXUP_COUNT = prev_break_count
        LOOP_TOP = prev_loop_top
        return 0
    }
    if kind == 35 {
        emit(0xE9)
        let brk_pos = CODE_LEN
        emit_u32(0)
        let bfi = BREAK_FIXUP_COUNT
        BREAK_FIXUP_OFF[bfi as usize] = brk_pos
        BREAK_FIXUP_COUNT = BREAK_FIXUP_COUNT + 1
        return 0
    }
    if kind == 36 {
        if LOOP_TOP > 0 {
            emit(0xE9)
            let cont_rel = LOOP_TOP - (CODE_LEN + 4)
            emit_u32(cont_rel)
        }
        return 0
    }
    if kind == 44 {
        compile_node(ND_LEFT[node as usize])
        let scr_slot = alloc_slot()
        emit_store_rax(scr_slot)
        // Use global MFPOOL for fixup positions (avoids local array stack-direction bug)
        let mf_base = MFDEPTH
        MFDEPTH = mf_base + 64
        var efc: i64 = 0
        var arm = ND_EXTRA[node as usize]
        while arm != -1 {
            let arm_type = ND_IVAL[arm as usize]
            let body = ND_EXTRA[arm as usize]
            let next_arm = ND_RIGHT[arm as usize]
            var skip_pos: i64 = -1
            if arm_type == 0 {
                emit_load_rax(scr_slot)
                let pat_val = ND_STR_OFF[arm as usize]
                emit(0x48); emit(0xB9); emit_u64(pat_val)
                emit(0x48); emit(0x39); emit(0xC8)
                emit(0x0F); emit(0x85)
                skip_pos = CODE_LEN; emit_u32(0)
            } else if arm_type == 2 {
                emit_load_rax(scr_slot)
                emit(0x48); emit(0x85); emit(0xC0)
                emit(0x0F); emit(0x85)
                skip_pos = CODE_LEN; emit_u32(0)
            } else if arm_type == 3 {
                emit_load_rax(scr_slot)
                emit(0x48); emit(0x85); emit(0xC0)
                emit(0x0F); emit(0x84)
                skip_pos = CODE_LEN; emit_u32(0)
                let boff = ND_STR_OFF[arm as usize]
                let blen = ND_STR_LEN[arm as usize]
                if blen > 0 {
                    emit_load_rax(scr_slot)
                    let bslot = add_local(boff, blen)
                    emit_store_rax(bslot)
                }
            }
            compile_node(body)
            emit(0xE9)
            MFPOOL[(mf_base + efc) as usize] = CODE_LEN
            efc = efc + 1
            emit_u32(0)
            if skip_pos >= 0 {
                let skip_off = CODE_LEN - skip_pos - 4
                CODE[skip_pos as usize] = (skip_off & 0xFF) as i8
                CODE[(skip_pos + 1) as usize] = ((skip_off >> 8) & 0xFF) as i8
                CODE[(skip_pos + 2) as usize] = ((skip_off >> 16) & 0xFF) as i8
                CODE[(skip_pos + 3) as usize] = ((skip_off >> 24) & 0xFF) as i8
            }
            arm = next_arm
        }
        let end_pos = CODE_LEN
        var ei: i64 = 0
        while ei < efc {
            let ep = MFPOOL[(mf_base + ei) as usize]
            let rel = end_pos - ep - 4
            CODE[ep as usize] = (rel & 0xFF) as i8
            CODE[(ep + 1) as usize] = ((rel >> 8) & 0xFF) as i8
            CODE[(ep + 2) as usize] = ((rel >> 16) & 0xFF) as i8
            CODE[(ep + 3) as usize] = ((rel >> 24) & 0xFF) as i8
            ei = ei + 1
        }
        MFDEPTH = mf_base
        return 0
    }
    0
}

fn compile_fn(fn_idx: i64) with Mut, Panic, Div {
    FN_CODE_OFF[fn_idx as usize] = CODE_LEN
    locals_reset()
    emit_prologue()

    let pcount = FN_PARAM_COUNT[fn_idx as usize]
    let pbase = FN_PARAM_BASE[fn_idx as usize]
    if pcount > 0 {
        let s0 = add_local(FN_PARAM_NAME_OFF[pbase as usize], FN_PARAM_NAME_LEN[pbase as usize])
        emit(0x48); emit(0x89); emit(0xBD)
        emit_u32(0 - ((s0 + 1) * 8))
    }
    if pcount > 1 {
        let s1 = add_local(FN_PARAM_NAME_OFF[(pbase + 1) as usize], FN_PARAM_NAME_LEN[(pbase + 1) as usize])
        emit(0x48); emit(0x89); emit(0xB5)
        emit_u32(0 - ((s1 + 1) * 8))
    }
    if pcount > 2 {
        let s2 = add_local(FN_PARAM_NAME_OFF[(pbase + 2) as usize], FN_PARAM_NAME_LEN[(pbase + 2) as usize])
        emit(0x48); emit(0x89); emit(0x95)
        emit_u32(0 - ((s2 + 1) * 8))
    }
    if pcount > 3 {
        let s3 = add_local(FN_PARAM_NAME_OFF[(pbase + 3) as usize], FN_PARAM_NAME_LEN[(pbase + 3) as usize])
        emit(0x48); emit(0x89); emit(0x8D)
        emit_u32(0 - ((s3 + 1) * 8))
    }
    let body = FN_BODY_NODE[fn_idx as usize]
    compile_node(body)
    emit_epilogue()
}

// ============================================================================
// ELF writer
// ============================================================================

fn elf_emit(b: i64) with Mut, Panic {
    ELF[ELF_LEN as usize] = b as i8
    ELF_LEN = ELF_LEN + 1
}

fn elf_emit_u16(v: i64) with Mut, Panic {
    elf_emit(v & 0xFF)
    elf_emit((v >> 8) & 0xFF)
}

fn elf_emit_u32(v: i64) with Mut, Panic {
    elf_emit(v & 0xFF)
    elf_emit((v >> 8) & 0xFF)
    elf_emit((v >> 16) & 0xFF)
    elf_emit((v >> 24) & 0xFF)
}

fn elf_emit_u64(v: i64) with Mut, Panic {
    elf_emit_u32(v)
    elf_emit_u32(v >> 32)
}

fn write_elf(entry_fn: i64) with Mut, Panic, Div {
    let base_addr: i64 = 0x400000
    let text_off: i64 = 4096

    elf_emit(0x7F); elf_emit(0x45); elf_emit(0x4C); elf_emit(0x46)
    elf_emit(2)
    elf_emit(1)
    elf_emit(1)
    elf_emit(0)
    var pi: i64 = 0
    while pi < 8 { elf_emit(0); pi = pi + 1 }
    elf_emit_u16(2)
    elf_emit_u16(0x3E)
    elf_emit_u32(1)
    elf_emit_u64(base_addr + text_off)
    elf_emit_u64(64)
    elf_emit_u64(0)
    elf_emit_u32(0)
    elf_emit_u16(64)
    elf_emit_u16(56)
    elf_emit_u16(2)
    elf_emit_u16(0)
    elf_emit_u16(0)
    elf_emit_u16(0)

    let total_size = text_off + CODE_LEN
    elf_emit_u32(1)
    elf_emit_u32(5)
    elf_emit_u64(0)
    elf_emit_u64(base_addr)
    elf_emit_u64(base_addr)
    elf_emit_u64(total_size)
    elf_emit_u64(total_size)
    elf_emit_u64(0x1000)

    let bss_size = if MB_BSS_TOTAL > 0 { MB_BSS_TOTAL + 4096 } else { 4096 }
    elf_emit_u32(1)
    elf_emit_u32(6)
    elf_emit_u64(total_size)
    elf_emit_u64(0x700000)
    elf_emit_u64(0x700000)
    elf_emit_u64(0)
    elf_emit_u64(bss_size)
    elf_emit_u64(0x1000)

    while ELF_LEN < text_off {
        elf_emit(0)
    }

    let main_off = FN_CODE_OFF[entry_fn as usize]
    let trampoline_size: i64 = 30
    let code_start = trampoline_size
    let main_abs = code_start + main_off
    let actual_call_rel = main_abs - 18
    elf_emit(0x48); elf_emit(0xBA); elf_emit_u64(0x700000)
    elf_emit(0x48); elf_emit(0x89); elf_emit(0x22)
    elf_emit(0xE8); elf_emit_u32(actual_call_rel)
    elf_emit(0x48); elf_emit(0x89); elf_emit(0xC7)
    elf_emit(0x48); elf_emit(0xC7); elf_emit(0xC0)
    elf_emit_u32(60)
    elf_emit(0x0F); elf_emit(0x05)

    var ci: i64 = 0
    while ci < CODE_LEN {
        elf_emit(CODE[ci as usize] as i64)
        ci = ci + 1
    }
}

fn patch_calls(trampoline_size: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < FIX_COUNT {
        let fix_off = FIX_OFF[i as usize]
        let target_fn = FIX_TARGET[i as usize]
        let target_off = FN_CODE_OFF[target_fn as usize]
        let rel = target_off - (fix_off + 4)
        CODE[fix_off as usize] = (rel & 0xFF) as i8
        CODE[(fix_off + 1) as usize] = ((rel >> 8) & 0xFF) as i8
        CODE[(fix_off + 2) as usize] = ((rel >> 16) & 0xFF) as i8
        CODE[(fix_off + 3) as usize] = ((rel >> 24) & 0xFF) as i8
        i = i + 1
    }
}

// ============================================================================
// Main
// ============================================================================

fn main() -> i64 with IO, Mut, Panic, Div {
    let argc = arg_count()
    if argc < 2 {
        print("Usage: boot4 <source.sio> <output>")
        return 1
    }
    let src_path = get_arg(0)
    let out_path = get_arg(1)

    let size = load_source(src_path)
    SRC_LEN = size
    print("loaded size=")
    print_int(size)
    print("\n")

    print("lexing...\n")
    lex()
    print("tokens=")
    print_int(TK_COUNT)
    print("\n")

    print("parsing...\n")
    parse_program()
    print("fns=")
    print_int(FN_COUNT)
    print(" structs=")
    print_int(ST_COUNT)
    print("\n")

    var main_fn: i64 = -1
    var fi: i64 = 0
    while fi < FN_COUNT {
        let fo = FN_NAME_OFF[fi as usize]
        let fl = FN_NAME_LEN[fi as usize]
        if pool_match(fo, fl, "main") {
            main_fn = fi
        }
        fi = fi + 1
    }

    if main_fn == -1 {
        print("error: no main function found")
        return 1
    }

    MB_BSS_TOTAL = 8

    mb_collect_globals()
    mb_resolve_src_globals()
    print("globals=")
    print_int(MB_GL_COUNT)
    print(" bss=")
    print_int(MB_BSS_TOTAL)
    print("\n")

    emit_print_int_helper()

    var ci: i64 = 0
    while ci < FN_COUNT {
        compile_fn(ci)
        ci = ci + 1
    }

    patch_calls(17)

    write_elf(main_fn)

    let wr = write_file(out_path, ELF, ELF_LEN)
    print("ok\n")
    0
}
