var MC_FIX_CALL_TARGET_FULL: i64 = 0
var MC_FIX_CALL_TARGET_NONFULL: i64 = 0
var MC_FIX_ELIDED_NONFULL: i64 = 0
var MC_FIX_PATCH_IMMEDIATE_COUNT: i64 = 0
var MC_FIX_PATCH_PENDING_COUNT: i64 = 0
var MC_FIX_PATCH_LATE_COUNT: i64 = 0
var MC_FIX_PATCH_OVERFLOW_COUNT: i64 = 0
var MC_OVF_RELOC_ARTIFACT: i64 = 0
