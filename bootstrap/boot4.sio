fn ARM_INT() -> i64 { 0 }
fn ARM_WILD() -> i64 { 1 }
fn ARM_NONE() -> i64 { 2 }
fn ARM_SOME() -> i64 { 3 }
fn ARM_ENUM() -> i64 { 4 }

// ============================================================================
// Lexer helpers
// ============================================================================

fn src_byte(pos: i64) -> i64 with Panic {
    if pos < 0 || pos >= SRC_LEN { return 0 }
    source_byte(pos)
}

fn src_raw_byte(pos: i64) -> i64 with Panic {
    if pos < 0 || pos >= src_hard_cap() { return 0 }
    source_byte(pos)
}

fn src_byte_in_current_slice(pos: i64) -> i64 with Panic {
    if pos < 0 || pos >= MC_CUR_SLICE_END { return 0 }
    if MC_CUR_USE_LIVE_SRC == 1 { return src_raw_byte(pos) }
    let rel = pos - MC_CUR_SLICE_START
    if rel < 0 || rel >= MC_CUR_FROZEN_LEN { return 0 }
    CODE[(MC_CUR_FROZEN_OFF + rel) as usize] as i64
}

fn is_ws(ch: i64) -> bool {
    ch == 32 || ch == 9 || ch == 10 || ch == 13
}

fn is_digit(ch: i64) -> bool {
    ch >= 48 && ch <= 57
}

// 4 MiB, raised from 2 MiB (#1631). The checker-driver closure this compiler
// bundles had roughly 350 bytes of headroom left, and going over does not
// report as a capacity problem -- it truncates the closure and then reports a
// wall of E001 type mismatches in modules that never loaded. The hard cap is
// 16 MiB (src_hard_cap), so this is headroom, not a waiver. Note the budget
// counts post-lex source: comments are free, code is not.
fn src_default_cap() -> i64 { 4194304 }
fn src_hard_cap() -> i64 { 16777216 }
fn tk_cap() -> i64 { 524288 }
fn nd_sink_idx() -> i64 { 262143 }
fn nd_cap() -> i64 { 262143 }  // reserve one slot as a safe sink
fn fn_cap() -> i64 { 4096 }
fn st_cap() -> i64 { 1024 }
fn fld_cap() -> i64 { 8192 }
fn en_cap() -> i64 { 256 }
fn pool_cap() -> i64 { 524288 }
fn name_pool_cap() -> i64 { 524288 }
fn name_pool_tag() -> i64 { 1048576 }
fn name_intern_cap() -> i64 { 16384 }
fn code_default_cap() -> i64 { 4194304 }
fn code_experimental_cap() -> i64 { 8388608 }
fn code_hard_cap() -> i64 { 33554432 }

fn code_cap() -> i64 {
    if MC_EFFECTIVE_CODE_CAP <= 0 { return code_default_cap() }
    if MC_EFFECTIVE_CODE_CAP > code_hard_cap() { return code_hard_cap() }
    MC_EFFECTIVE_CODE_CAP
}

fn elf_cap() -> i64 { code_cap() }

fn code_cap_profile_value(s: string) -> i64 with Mut, Panic, Div {
    if str_eq_manual(s, "baseline") { return code_default_cap() }
    if str_eq_manual(s, "experimental") { return code_experimental_cap() }
    -1
}

fn code_cap_profile_kind() -> i64 {
    let cap = code_cap()
    if cap == code_default_cap() { return 0 }
    if cap == code_experimental_cap() { return 1 }
    2
}

fn code_cap_promotion_eligible() -> i64 {
    if code_cap_profile_kind() == 0 { return 1 }
    0
}

fn print_code_cap_profile() with IO {
    let kind = code_cap_profile_kind()
    if kind == 0 {
        print("baseline")
    } else if kind == 1 {
        print("experimental")
    } else {
        print("custom")
    }
}

fn src_effective_cap() -> i64 {
    if MC_EFFECTIVE_SRC_CAP <= 0 { return src_default_cap() }
    if MC_EFFECTIVE_SRC_CAP > src_hard_cap() { return src_hard_cap() }
    MC_EFFECTIVE_SRC_CAP
}

fn parse_decimal_string(s: string) -> i64 with Mut, Panic, Div {
    let len = str_len(s)
    if len <= 0 { return -1 }
    var value: i64 = 0
    var i: i64 = 0
    while i < len {
        let ch = str_char_at(s, i) as i64
        if !is_digit(ch) { return -1 }
        value = value * 10 + (ch - 48)
        i = i + 1
    }
    value
}

fn str_eq_manual(a: string, b: string) -> bool with Mut, Panic, Div {
    let a_len = str_len(a)
    let b_len = str_len(b)
    if a_len != b_len { return false }
    var i: i64 = 0
    while i < a_len {
        if (str_char_at(a, i) as i64) != (str_char_at(b, i) as i64) {
            return false
        }
        i = i + 1
    }
    true
}

fn mc_hash_src_range(start: i64, len: i64) -> i64 with Mut, Panic, Div {
    var h: i64 = 146959810
    var i: i64 = 0
    while i < len {
        h = (h * 131) + (SRC[(start + i) as usize] as i64) + 7
        if h < 0 { h = 0 - h }
        i = i + 1
    }
    h
}

fn is_alpha(ch: i64) -> bool {
    (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

fn is_alnum(ch: i64) -> bool {
    is_alpha(ch) || is_digit(ch)
}

fn text_is_name_off(off: i64) -> bool {
    off >= name_pool_tag()
}

fn text_raw_off(off: i64) -> i64 {
    if text_is_name_off(off) { return off - name_pool_tag() }
    off
}

fn text_byte(off: i64, idx: i64) -> i64 with Panic {
    let raw = text_raw_off(off) + idx
    if text_is_name_off(off) {
        if raw < 0 || raw >= NAME_POOL_POS { return 0 }
        return NAME_POOL[raw as usize] as i64
    }
    if raw < 0 || raw >= POOL_POS { return 0 }
    POOL[raw as usize] as i64
}

fn mc_source_byte_for_offset(pos: i64) -> i64 with Mut, Panic, Div {
    let module_idx = mc_module_for_src_offset(pos)
    if module_idx >= 0 && module_idx < MC_MOD_COUNT && MC_MOD_KIND[module_idx as usize] != 0 {
        let rel = pos - MC_MOD_SRC_START[module_idx as usize]
        if rel >= 0 && rel < MC_MOD_FROZEN_LEN[module_idx as usize] {
            return CODE[(MC_MOD_FROZEN_OFF[module_idx as usize] + rel) as usize] as i64
        }
    }
    src_byte(pos)
}

fn source_range_match_string(start: i64, len: i64, target: string) -> bool with Mut, Panic, Div {
    if len != str_len(target) { return false }
    var i: i64 = 0
    while i < len {
        let a = mc_source_byte_for_offset(start + i)
        let b = str_char_at(target, i) as i64
        if a != b { return false }
        i = i + 1
    }
    true
}

fn name_pool_hash_source_range(start: i64, len: i64) -> i64 with Mut, Panic, Div {
    var h: i64 = 146959810
    var i: i64 = 0
    while i < len {
        h = (h * 131) + mc_source_byte_for_offset(start + i) + 7
        if h < 0 { h = 0 - h }
        i = i + 1
    }
    h
}

fn name_pool_eq_source_range(raw_off: i64, start: i64, len: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < len {
        if NAME_POOL[(raw_off + i) as usize] as i64 != mc_source_byte_for_offset(start + i) {
            return false
        }
        i = i + 1
    }
    true
}

fn name_pool_add(b: i64) with Mut, Panic {
    if NAME_POOL_POS >= name_pool_cap() {
        let module_idx = mc_pool_phase_module()
        mc_note_name_pool_saturation(module_idx)
        mc_note_saturation(8, module_idx)
        return
    }
    NAME_POOL[NAME_POOL_POS as usize] = b as i8
    NAME_POOL_POS = NAME_POOL_POS + 1
    mc_name_pool_account_delta(mc_pool_phase_module(), 1)
}

fn name_pool_intern_source_range(start: i64, len: i64) -> i64 with Mut, Panic, Div {
    if len <= 0 { return name_pool_tag() }
    let cap = name_intern_cap()
    let h = name_pool_hash_source_range(start, len)
    let module_idx = mc_pool_phase_module()
    var slot = h % cap
    var probes: i64 = 0
    while probes < cap {
        let existing_off = NAME_INTERN_OFF[slot as usize]
        if existing_off < 0 { break }
        if NAME_INTERN_LEN[slot as usize] == len && name_pool_eq_source_range(existing_off, start, len) {
            MC_NAME_INTERN_REUSE = MC_NAME_INTERN_REUSE + 1
            mc_name_intern_reuse_delta(module_idx)
            return name_pool_tag() + existing_off
        }
        slot = slot + 1
        if slot >= cap { slot = 0 }
        probes = probes + 1
    }
    if probes >= cap {
        mc_note_name_slot_saturation(module_idx)
        mc_note_saturation(10, module_idx)
        return pool_copy_source_range(start, len)
    }
    if NAME_POOL_POS + len > name_pool_cap() {
        mc_note_name_pool_saturation(module_idx)
        mc_note_saturation(8, module_idx)
        return pool_copy_source_range(start, len)
    }
    let raw_off = NAME_POOL_POS
    var i: i64 = 0
    while i < len {
        name_pool_add(mc_source_byte_for_offset(start + i))
        i = i + 1
    }
    NAME_INTERN_OFF[slot as usize] = raw_off
    NAME_INTERN_LEN[slot as usize] = len
    NAME_INTERN_USED = NAME_INTERN_USED + 1
    MC_NAME_INTERN_NEW = MC_NAME_INTERN_NEW + 1
    mc_name_intern_new_delta(module_idx)
    name_pool_tag() + raw_off
}

fn pool_add(b: i64) with Mut, Panic {
    if POOL_POS >= pool_cap() {
        let module_idx = mc_pool_phase_module()
        mc_note_pool_saturation(module_idx)
        mc_note_saturation(5, module_idx)
        return
    }
    POOL[POOL_POS as usize] = b as i8
    POOL_POS = POOL_POS + 1
    mc_pool_account_delta(mc_pool_phase_module(), 1)
}

fn pool_concat_colon(a_off: i64, a_len: i64, b_off: i64, b_len: i64) -> i64 with Mut, Panic {
    let total = a_len + 2 + b_len
    if NAME_POOL_POS + total <= name_pool_cap() {
        let start = NAME_POOL_POS
        var j: i64 = 0
        while j < a_len { name_pool_add(text_byte(a_off, j)); j = j + 1 }
        name_pool_add(58); name_pool_add(58)
        j = 0
        while j < b_len { name_pool_add(text_byte(b_off, j)); j = j + 1 }
        return name_pool_tag() + start
    }
    let module_idx = mc_pool_phase_module()
    mc_note_name_pool_saturation(module_idx)
    mc_note_saturation(8, module_idx)
    let start = POOL_POS
    var i: i64 = 0
    while i < a_len { pool_add(text_byte(a_off, i)); i = i + 1 }
    pool_add(58); pool_add(58)
    i = 0
    while i < b_len { pool_add(text_byte(b_off, i)); i = i + 1 }
    start
}

fn pool_match(off: i64, len: i64, target: string) -> bool with Mut, Panic, Div {
    if len != str_len(target) { return false }
    var i: i64 = 0
    while i < len {
        let a = text_byte(off, i)
        let b = str_char_at(target, i) as i64
        if a != b { return false }
        i = i + 1
    }
    true
}

fn pool_copy_string(s: string) -> i64 with Mut, Panic, Div {
    let start = POOL_POS
    let len = str_len(s)
    var i: i64 = 0
    while i < len {
        pool_add(str_char_at(s, i) as i64)
        i = i + 1
    }
    start
}

fn pool_copy_source_range(start: i64, len: i64) -> i64 with Mut, Panic, Div {
    let off = POOL_POS
    var i: i64 = 0
    while i < len {
        pool_add(source_byte(start + i))
        i = i + 1
    }
    off
}

fn pool_copy_current_slice_range(start: i64, len: i64) -> i64 with Mut, Panic, Div {
    let off = POOL_POS
    var i: i64 = 0
    while i < len {
        pool_add(src_byte_in_current_slice(start + i))
        i = i + 1
    }
    off
}

fn pool_slices_eq(a_off: i64, a_len: i64, b_off: i64, b_len: i64) -> bool with Mut, Panic, Div {
    if a_len != b_len { return false }
    var i: i64 = 0
    while i < a_len {
        let a = text_byte(a_off, i)
        let b = text_byte(b_off, i)
        if a != b { return false }
        i = i + 1
    }
    true
}

fn print_pool_slice(off: i64, len: i64) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < len {
        print_char(text_byte(off, i))
        i = i + 1
    }
}

fn mc_hash_reset() with Mut {
    MC_CLOSURE_HASH = 146959810
}

fn mc_hash_mix(v: i64) with Mut, Panic, Div {
    MC_CLOSURE_HASH = (MC_CLOSURE_HASH * 131) + v + 7
    if MC_CLOSURE_HASH < 0 {
        MC_CLOSURE_HASH = 0 - MC_CLOSURE_HASH
    }
}

fn mc_hash_pool_slice(off: i64, len: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < len {
        mc_hash_mix(text_byte(off, i))
        i = i + 1
    }
}

fn mc_parse_status_for_resource(resource: i64) -> i64 {
    if resource == 0 { return 2 }
    if resource == 1 { return 3 }
    if resource == 2 { return 4 }
    if resource == 3 { return 5 }
    if resource == 4 { return 6 }
    if resource == 5 { return 7 }
    if resource == 6 { return 8 }
    if resource == 7 { return 9 }
    if resource == 8 { return 11 }
    if resource == 10 { return 12 }
    1
}

fn mc_module_for_src_offset(off: i64) -> i64 with Mut, Panic, Div {
    var m: i64 = 0
    while m < MC_MOD_COUNT {
        let start = MC_MOD_SRC_START[m as usize]
        let end = start + MC_MOD_SRC_LEN[m as usize]
        if off >= start && off < end { return m }
        m = m + 1
    }
    -1
}

fn mc_module_for_token_idx(tok_idx: i64) -> i64 with Mut, Panic, Div {
    var m: i64 = 0
    while m < MC_MOD_COUNT {
        let tk_start = MC_MOD_TK_START[m as usize]
        let tk_end = MC_MOD_TK_END[m as usize]
        if tok_idx >= tk_start && tok_idx < tk_end { return m }
        m = m + 1
    }
    -1
}

fn mc_module_for_parser_pos() -> i64 with Mut, Panic, Div {
    let module_idx = mc_module_for_token_idx(POS)
    if module_idx >= 0 { return module_idx }
    if MC_PARSE_WINDOW_MODULE >= 0 && MC_PARSE_LIMIT >= 0 && POS >= MC_PARSE_LIMIT && POS < TK_COUNT {
        return MC_PARSE_WINDOW_MODULE
    }
    -1
}

fn mc_set_phase(phase: i64) with Mut {
    MC_CUR_PHASE = phase
}

fn mc_pool_phase_module() -> i64 with Mut, Panic, Div {
    if MC_PARSE_WINDOW_MODULE >= 0 { return MC_PARSE_WINDOW_MODULE }
    if MC_CUR_MODULE_IDX >= 0 { return MC_CUR_MODULE_IDX }
    let module_idx = mc_module_for_parser_pos()
    if module_idx >= 0 { return module_idx }
    -1
}

fn mc_pool_account_delta(module_idx: i64, delta: i64) with Mut {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT || delta == 0 { return }
    MC_MOD_POOL_TOTAL[module_idx as usize] = MC_MOD_POOL_TOTAL[module_idx as usize] + delta
    if MC_CUR_PHASE == 1 {
        MC_MOD_POOL_SCAN[module_idx as usize] = MC_MOD_POOL_SCAN[module_idx as usize] + delta
    } else if MC_CUR_PHASE == 2 {
        MC_MOD_POOL_LEX[module_idx as usize] = MC_MOD_POOL_LEX[module_idx as usize] + delta
    } else if MC_CUR_PHASE == 3 || MC_CUR_PHASE == 4 || MC_CUR_PHASE == 5 {
        MC_MOD_POOL_PARSE[module_idx as usize] = MC_MOD_POOL_PARSE[module_idx as usize] + delta
    }
}

fn mc_name_pool_account_delta(module_idx: i64, delta: i64) with Mut {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT || delta == 0 { return }
    MC_MOD_NAME_POOL[module_idx as usize] = MC_MOD_NAME_POOL[module_idx as usize] + delta
}

fn mc_name_intern_reuse_delta(module_idx: i64) with Mut {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    MC_MOD_NAME_REUSE[module_idx as usize] = MC_MOD_NAME_REUSE[module_idx as usize] + 1
}

fn mc_name_intern_new_delta(module_idx: i64) with Mut {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    MC_MOD_NAME_NEW[module_idx as usize] = MC_MOD_NAME_NEW[module_idx as usize] + 1
}

fn mc_note_pool_saturation(module_idx: i64) with Mut, Panic, Div {
    if MC_POOL_FIRST_PHASE >= 0 { return }
    MC_POOL_FIRST_MODULE = module_idx
    MC_POOL_FIRST_PHASE = MC_CUR_PHASE
}

fn mc_note_name_pool_saturation(module_idx: i64) with Mut, Panic, Div {
    if MC_NAME_POOL_FIRST_PHASE >= 0 { return }
    MC_NAME_POOL_FIRST_MODULE = module_idx
    MC_NAME_POOL_FIRST_PHASE = MC_CUR_PHASE
}

fn mc_note_name_slot_saturation(module_idx: i64) with Mut, Panic, Div {
    if MC_NAME_SLOT_FIRST_PHASE >= 0 { return }
    MC_NAME_SLOT_FIRST_MODULE = module_idx
    MC_NAME_SLOT_FIRST_PHASE = MC_CUR_PHASE
}

fn mc_record_first(resource: i64, module_idx: i64) with Mut, Panic, Div {
    if MC_SAT_FIRST_RESOURCE >= 0 { return }
    MC_SAT_FIRST_RESOURCE = resource
    MC_SAT_FIRST_MODULE = module_idx
}

fn mc_mark_parse_status(module_idx: i64, status: i64) with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    if status > MC_MOD_PARSE_STATUS[module_idx as usize] {
        MC_MOD_PARSE_STATUS[module_idx as usize] = status
    }
}

fn mc_mark_exec_state(module_idx: i64, state: i64) with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    if state > MC_MOD_EXEC_STATE[module_idx as usize] {
        MC_MOD_EXEC_STATE[module_idx as usize] = state
    }
}

fn mc_bump_module_fn_local(module_idx: i64) with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    MC_MOD_FN_LOCAL[module_idx as usize] = MC_MOD_FN_LOCAL[module_idx as usize] + 1
}

fn mc_bump_module_fn_body_needed(module_idx: i64) with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    MC_MOD_FN_BODY_NEEDED[module_idx as usize] = MC_MOD_FN_BODY_NEEDED[module_idx as usize] + 1
}

fn mc_bump_module_fn_body_skipped(module_idx: i64) with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    MC_MOD_FN_BODY_SKIPPED[module_idx as usize] = MC_MOD_FN_BODY_SKIPPED[module_idx as usize] + 1
}

fn mc_large_surface_mode() -> i64 with Mut {
    if MC_MOD_COUNT >= 32 { return 1 }
    if MC_TOTAL_REQUESTED_BYTES >= 1048576 { return 1 }
    0
}

fn mc_module_should_defer_bodies(module_idx: i64) -> i64 with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return 0 }
    if mc_large_surface_mode() == 0 { return 0 }
    if MC_MOD_KIND[module_idx as usize] == 0 { return 0 }
    if MC_MOD_FN_SIG[module_idx as usize] < 128 { return 0 }
    if pool_match(MC_MOD_PATH_OFF[module_idx as usize], MC_MOD_PATH_LEN[module_idx as usize], "self-hosted/ir/lower.sio") {
        return 1
    }
    0
}

fn fn_body_state_full() -> i64 { 1 }
fn fn_body_state_deferred() -> i64 { 2 }
fn fn_body_state_stub() -> i64 { 3 }
fn fn_body_state_skipped() -> i64 { 4 }
fn fn_body_state_materialized_on_demand() -> i64 { 5 }

fn fix_cap() -> i64 { 8192 }
fn fn_lea_fix_cap() -> i64 { 256 }
fn reloc_cap() -> i64 { 16384 }
fn reloc_mod_sample_cap() -> i64 { 128 }
fn code_seg_cap() -> i64 { 1048576 }
fn code_section_text() -> i64 { 0 }
fn code_section_rodata() -> i64 { 1 }
fn code_section_other() -> i64 { 2 }
fn code_overflow_frontier_none() -> i64 { 0 }
fn code_overflow_frontier_segment() -> i64 { 1 }
fn code_overflow_frontier_global() -> i64 { 2 }
fn elf_substage_none() -> i64 { 0 }
fn elf_substage_buffer() -> i64 { 1 }
fn elf_substage_headers() -> i64 { 2 }
fn elf_substage_payload() -> i64 { 3 }
fn elf_substage_tables() -> i64 { 4 }
fn elf_substage_sections() -> i64 { 5 }
fn elf_substage_finalize() -> i64 { 6 }
fn elf_substage_other() -> i64 { 7 }
fn text_hash_seed() -> i64 { 146959810 }

fn print_code_section_name(section: i64) with IO {
    if section == code_section_text() {
        print("text")
    } else if section == code_section_rodata() {
        print("inline_rodata")
    } else if section == code_section_other() {
        print("other")
    } else {
        print("none")
    }
}

fn print_code_overflow_frontier(frontier: i64) with IO {
    if frontier == code_overflow_frontier_segment() {
        print("segment")
    } else if frontier == code_overflow_frontier_global() {
        print("global")
    } else {
        print("none")
    }
}

fn print_elf_substage_name(stage: i64) with IO {
    if stage == elf_substage_buffer() {
        print("buffer")
    } else if stage == elf_substage_headers() {
        print("headers")
    } else if stage == elf_substage_payload() {
        print("payload")
    } else if stage == elf_substage_tables() {
        print("tables")
    } else if stage == elf_substage_sections() {
        print("sections")
    } else if stage == elf_substage_finalize() {
        print("finalize")
    } else if stage == elf_substage_other() {
        print("other")
    } else {
        print("none")
    }
}

fn print_elf_peak_fn_name(fn_idx: i64) with IO, Mut, Panic, Div {
    if fn_idx >= 0 && fn_idx < FN_COUNT {
        print_pool_slice(FN_NAME_OFF[fn_idx as usize], FN_NAME_LEN[fn_idx as usize])
    } else {
        print("<none>")
    }
}

fn print_elf_substage_line(stage: i64) with IO, Mut, Panic, Div {
    if stage <= elf_substage_none() || stage > elf_substage_other() { return }
    let stage_gross = MC_ELF_SUBSTAGE_GROSS[stage as usize]
    let stage_resident = MC_ELF_SUBSTAGE_RESIDENT[stage as usize]
    if stage_gross <= 0 && stage_resident <= 0 { return }
    let peak_fn = MC_ELF_SUBSTAGE_PEAK_FN[stage as usize]
    let peak_fn_bytes = MC_ELF_SUBSTAGE_PEAK_FN_BYTES[stage as usize]
    print("CLOSURE_BUNDLE_V2_ELF_SUBSTAGE stage=")
    print_elf_substage_name(stage)
    print(" text_gross=")
    print_int(stage_gross)
    print(" text_resident=")
    print_int(stage_resident)
    print(" peak_fn=")
    print_int(peak_fn)
    print(" peak_fn_name=")
    print_elf_peak_fn_name(peak_fn)
    print(" peak_fn_bytes=")
    print_int(peak_fn_bytes)
    print("\n")
}

fn mc_module_is_native_elf(module_idx: i64) -> i64 with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return 0 }
    if pool_match(MC_MOD_PATH_OFF[module_idx as usize], MC_MOD_PATH_LEN[module_idx as usize], "self-hosted/native/elf.sio") {
        return 1
    }
    0
}

fn mc_elf_substage_for_fn(fn_idx: i64) -> i64 with Mut, Panic, Div {
    if fn_idx < 0 || fn_idx >= FN_COUNT { return elf_substage_none() }
    if mc_module_is_native_elf(FN_MODULE_IDX[fn_idx as usize]) == 0 { return elf_substage_none() }
    let off = FN_NAME_OFF[fn_idx as usize]
    let len = FN_NAME_LEN[fn_idx as usize]
    if pool_match(off, len, "elf_binary_new") ||
       pool_match(off, len, "elf_emit_byte_ref") ||
       pool_match(off, len, "elf_emit_u16_ref") ||
       pool_match(off, len, "elf_emit_u32_ref") ||
       pool_match(off, len, "elf_emit_u64_ref") ||
       pool_match(off, len, "elf_patch_u16_ref") ||
       pool_match(off, len, "elf_patch_u64_ref") {
        return elf_substage_buffer()
    }
    if pool_match(off, len, "emit_elf_header_ref") ||
       pool_match(off, len, "emit_program_header_text_ref") ||
       pool_match(off, len, "emit_program_header_rodata_ref") ||
       pool_match(off, len, "emit_program_header_data_ref") ||
       pool_match(off, len, "emit_program_header_gnu_stack_ref") ||
       pool_match(off, len, "elf_builder_emit_program_headers_ref") {
        return elf_substage_headers()
    }
    if pool_match(off, len, "elf_builder_emit_payload_ref") {
        return elf_substage_payload()
    }
    if pool_match(off, len, "emit_symtab_entry_ref") ||
       pool_match(off, len, "elf_builder_emit_strtab_symtab_ref") ||
       pool_match(off, len, "elf_builder_emit_cstr_ref") ||
       pool_match(off, len, "elf_builder_emit_shstrtab_ref") ||
       pool_match(off, len, "elf_builder_emit_note_and_shstrtab_ref") {
        return elf_substage_tables()
    }
    if pool_match(off, len, "emit_section_header_ref") ||
       pool_match(off, len, "elf_builder_emit_section_headers_ref") {
        return elf_substage_sections()
    }
    if pool_match(off, len, "finalize_elf64_for_machine") ||
       pool_match(off, len, "finalize_elf64") ||
       pool_match(off, len, "elf_builder_patch_header_ref") {
        return elf_substage_finalize()
    }
    elf_substage_other()
}

fn mc_note_elf_substage_gross(fn_idx: i64) with Mut, Panic, Div {
    let stage = mc_elf_substage_for_fn(fn_idx)
    if stage <= elf_substage_none() || stage > elf_substage_other() { return }
    MC_ELF_TEXT_GROSS_TOTAL = MC_ELF_TEXT_GROSS_TOTAL + 1
    MC_ELF_SUBSTAGE_GROSS[stage as usize] = MC_ELF_SUBSTAGE_GROSS[stage as usize] + 1
    if FN_TEXT_GROSS[fn_idx as usize] > MC_ELF_SUBSTAGE_PEAK_FN_BYTES[stage as usize] {
        MC_ELF_SUBSTAGE_PEAK_FN[stage as usize] = fn_idx
        MC_ELF_SUBSTAGE_PEAK_FN_BYTES[stage as usize] = FN_TEXT_GROSS[fn_idx as usize]
    }
    if FN_TEXT_GROSS[fn_idx as usize] > MC_ELF_PEAK_FN_BYTES {
        MC_ELF_PEAK_FN = fn_idx
        MC_ELF_PEAK_FN_BYTES = FN_TEXT_GROSS[fn_idx as usize]
    }
    if MC_ELF_FIRST_LIMIT_SUBSTAGE < 0 && MC_ELF_TEXT_GROSS_TOTAL > code_cap() {
        MC_ELF_FIRST_LIMIT_SUBSTAGE = stage
        MC_ELF_FIRST_LIMIT_FN = fn_idx
    }
}

fn mc_note_elf_substage_resident(fn_idx: i64) with Mut, Panic, Div {
    let stage = mc_elf_substage_for_fn(fn_idx)
    if stage <= elf_substage_none() || stage > elf_substage_other() { return }
    MC_ELF_SUBSTAGE_RESIDENT[stage as usize] = MC_ELF_SUBSTAGE_RESIDENT[stage as usize] + 1
}

fn mc_note_code_section_gross(section: i64) with Mut {
    if section == code_section_rodata() {
        MC_CODE_RODATA_GROSS = MC_CODE_RODATA_GROSS + 1
    } else if section == code_section_other() {
        MC_CODE_OTHER_GROSS = MC_CODE_OTHER_GROSS + 1
    } else {
        MC_CODE_TEXT_GROSS = MC_CODE_TEXT_GROSS + 1
    }
}

fn mc_note_code_section_resident(section: i64) with Mut {
    if section == code_section_rodata() {
        MC_CODE_RODATA_RESIDENT = MC_CODE_RODATA_RESIDENT + 1
    } else if section == code_section_other() {
        MC_CODE_OTHER_RESIDENT = MC_CODE_OTHER_RESIDENT + 1
    } else {
        MC_CODE_TEXT_RESIDENT = MC_CODE_TEXT_RESIDENT + 1
    }
}

fn mc_note_code_section_discarded(section: i64) with Mut {
    if section == code_section_rodata() {
        MC_CODE_RODATA_DISCARDED = MC_CODE_RODATA_DISCARDED + 1
    } else if section == code_section_other() {
        MC_CODE_OTHER_DISCARDED = MC_CODE_OTHER_DISCARDED + 1
    } else {
        MC_CODE_TEXT_DISCARDED = MC_CODE_TEXT_DISCARDED + 1
    }
}

fn mc_hash_mix_text(h: i64, b: i64) -> i64 with Mut {
    var mixed = (h * 131) + b + 17
    if mixed < 0 { mixed = 0 - mixed }
    mixed
}

fn mc_note_text_gross_byte(b: i64) with Mut, Panic {
    if CURRENT_CODEGEN_FN < 0 || CURRENT_CODEGEN_FN >= FN_COUNT { return }
    let fn_idx = CURRENT_CODEGEN_FN
    FN_TEXT_GROSS[fn_idx as usize] = FN_TEXT_GROSS[fn_idx as usize] + 1
    FN_TEXT_HASH[fn_idx as usize] = mc_hash_mix_text(FN_TEXT_HASH[fn_idx as usize], b)
    if FN_TEXT_GROSS[fn_idx as usize] > MC_PEAK_TEXT_FN_COUNT {
        MC_PEAK_TEXT_FN = fn_idx
        MC_PEAK_TEXT_FN_COUNT = FN_TEXT_GROSS[fn_idx as usize]
    }
    let module_idx = FN_MODULE_IDX[fn_idx as usize]
    if module_idx >= 0 && module_idx < MC_MOD_COUNT {
        MC_MOD_TEXT_GROSS[module_idx as usize] = MC_MOD_TEXT_GROSS[module_idx as usize] + 1
        if MC_MOD_TEXT_GROSS[module_idx as usize] > MC_PEAK_TEXT_MODULE_COUNT {
            MC_PEAK_TEXT_MODULE = module_idx
            MC_PEAK_TEXT_MODULE_COUNT = MC_MOD_TEXT_GROSS[module_idx as usize]
        }
    }
    mc_note_elf_substage_gross(fn_idx)
}

fn mc_note_text_resident_byte() with Mut, Panic {
    if CURRENT_CODEGEN_FN < 0 || CURRENT_CODEGEN_FN >= FN_COUNT { return }
    let fn_idx = CURRENT_CODEGEN_FN
    FN_TEXT_RESIDENT[fn_idx as usize] = FN_TEXT_RESIDENT[fn_idx as usize] + 1
    let module_idx = FN_MODULE_IDX[fn_idx as usize]
    if module_idx >= 0 && module_idx < MC_MOD_COUNT {
        MC_MOD_TEXT_RESIDENT[module_idx as usize] = MC_MOD_TEXT_RESIDENT[module_idx as usize] + 1
    }
    mc_note_elf_substage_resident(fn_idx)
}

fn mc_top_insert_text_fn(fn_idx: i64, bytes: i64) with Mut {
    var pos: i64 = 0
    while pos < 5 {
        if bytes > MC_TOP_TEXT_FN_BYTES[pos as usize] {
            var j: i64 = 4
            while j > pos {
                MC_TOP_TEXT_FN_IDX[j as usize] = MC_TOP_TEXT_FN_IDX[(j - 1) as usize]
                MC_TOP_TEXT_FN_BYTES[j as usize] = MC_TOP_TEXT_FN_BYTES[(j - 1) as usize]
                j = j - 1
            }
            MC_TOP_TEXT_FN_IDX[pos as usize] = fn_idx
            MC_TOP_TEXT_FN_BYTES[pos as usize] = bytes
            return
        }
        pos = pos + 1
    }
}

fn mc_top_insert_text_mod(module_idx: i64, bytes: i64) with Mut {
    var pos: i64 = 0
    while pos < 5 {
        if bytes > MC_TOP_TEXT_MOD_BYTES[pos as usize] {
            var j: i64 = 4
            while j > pos {
                MC_TOP_TEXT_MOD_IDX[j as usize] = MC_TOP_TEXT_MOD_IDX[(j - 1) as usize]
                MC_TOP_TEXT_MOD_BYTES[j as usize] = MC_TOP_TEXT_MOD_BYTES[(j - 1) as usize]
                j = j - 1
            }
            MC_TOP_TEXT_MOD_IDX[pos as usize] = module_idx
            MC_TOP_TEXT_MOD_BYTES[pos as usize] = bytes
            return
        }
        pos = pos + 1
    }
}

fn fn_code_slices_equal(a: i64, b: i64) -> i64 with Mut, Panic, Div {
    if a < 0 || a >= FN_COUNT || b < 0 || b >= FN_COUNT { return 0 }
    let len = FN_CODE_TOTAL[a as usize]
    if len <= 0 { return 0 }
    if FN_CODE_TOTAL[b as usize] != len { return 0 }
    if FN_CODE_RESIDENT[a as usize] != len || FN_CODE_RESIDENT[b as usize] != len { return 0 }
    let off_a = FN_CODE_OFF[a as usize]
    let off_b = FN_CODE_OFF[b as usize]
    var i: i64 = 0
    while i < len {
        if CODE[(off_a + i) as usize] != CODE[(off_b + i) as usize] { return 0 }
        i = i + 1
    }
    1
}

fn mc_note_code_byte(b: i64) with Mut, Panic {
    MC_CODE_COUNT_TOTAL = MC_CODE_COUNT_TOTAL + 1
    mc_note_code_section_gross(CODE_CUR_SECTION)
    if CODE_CUR_SECTION == code_section_text() { mc_note_text_gross_byte(b) }
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        FN_CODE_TOTAL[CURRENT_CODEGEN_FN as usize] = FN_CODE_TOTAL[CURRENT_CODEGEN_FN as usize] + 1
        if FN_CODE_TOTAL[CURRENT_CODEGEN_FN as usize] > MC_CODE_PEAK_FN_COUNT {
            MC_CODE_PEAK_FN = CURRENT_CODEGEN_FN
            MC_CODE_PEAK_FN_COUNT = FN_CODE_TOTAL[CURRENT_CODEGEN_FN as usize]
        }
        let module_idx = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
        if module_idx >= 0 && module_idx < MC_MOD_COUNT {
            MC_MOD_CODE_TOTAL[module_idx as usize] = MC_MOD_CODE_TOTAL[module_idx as usize] + 1
            if MC_MOD_CODE_TOTAL[module_idx as usize] > MC_CODE_PEAK_MODULE_COUNT {
                MC_CODE_PEAK_MODULE = module_idx
                MC_CODE_PEAK_MODULE_COUNT = MC_MOD_CODE_TOTAL[module_idx as usize]
            }
        }
    }
}

fn mc_note_code_progress() with Mut {
    if CODE_LEN > MC_CODE_HIGH_WATER { MC_CODE_HIGH_WATER = CODE_LEN }
    if CODE_LEN > MC_SAT_CODE_HWM { MC_SAT_CODE_HWM = CODE_LEN }
}

fn mc_note_code_resident(section: i64) with Mut, Panic {
    mc_note_code_section_resident(section)
    if section == code_section_text() { mc_note_text_resident_byte() }
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        FN_CODE_RESIDENT[CURRENT_CODEGEN_FN as usize] = FN_CODE_RESIDENT[CURRENT_CODEGEN_FN as usize] + 1
        let module_idx = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
        if module_idx >= 0 && module_idx < MC_MOD_COUNT {
            MC_MOD_CODE_RESIDENT[module_idx as usize] = MC_MOD_CODE_RESIDENT[module_idx as usize] + 1
        }
    }
}

fn mc_note_code_copy(section: i64) with Mut, Panic {
    MC_CODE_COPY_BYTES = MC_CODE_COPY_BYTES + 1
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        FN_CODE_COPY[CURRENT_CODEGEN_FN as usize] = FN_CODE_COPY[CURRENT_CODEGEN_FN as usize] + 1
        let module_idx = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
        if module_idx >= 0 && module_idx < MC_MOD_COUNT {
            MC_MOD_CODE_COPY[module_idx as usize] = MC_MOD_CODE_COPY[module_idx as usize] + 1
        }
    }
}

fn mc_note_code_rewrite() with Mut, Panic {
    MC_CODE_REWRITE_BYTES = MC_CODE_REWRITE_BYTES + 1
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        FN_CODE_REWRITE[CURRENT_CODEGEN_FN as usize] = FN_CODE_REWRITE[CURRENT_CODEGEN_FN as usize] + 1
        let module_idx = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
        if module_idx >= 0 && module_idx < MC_MOD_COUNT {
            MC_MOD_CODE_REWRITE[module_idx as usize] = MC_MOD_CODE_REWRITE[module_idx as usize] + 1
        }
    }
}

fn mc_note_code_discarded(section: i64, frontier: i64) with Mut, Panic {
    MC_CODE_DISCARDED_BYTES = MC_CODE_DISCARDED_BYTES + 1
    if frontier == code_overflow_frontier_segment() {
        MC_CODE_DISCARDED_SEGMENT_BYTES = MC_CODE_DISCARDED_SEGMENT_BYTES + 1
    } else if frontier == code_overflow_frontier_global() {
        MC_CODE_DISCARDED_GLOBAL_BYTES = MC_CODE_DISCARDED_GLOBAL_BYTES + 1
    }
    mc_note_code_section_discarded(section)
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        FN_CODE_DISCARDED[CURRENT_CODEGEN_FN as usize] = FN_CODE_DISCARDED[CURRENT_CODEGEN_FN as usize] + 1
        let module_idx = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
        if module_idx >= 0 && module_idx < MC_MOD_COUNT {
            MC_MOD_CODE_DISCARDED[module_idx as usize] = MC_MOD_CODE_DISCARDED[module_idx as usize] + 1
        }
    }
}

fn code_segment_begin() with Mut {
    CODE_SEG_ACTIVE = 1
    CODE_SEG_BASE = CODE_LEN
    CODE_SEG_LEN = 0
}

fn code_segment_finish() with Mut, Panic {
    var i: i64 = 0
    let copy_len = if CODE_SEG_LEN < code_seg_cap() { CODE_SEG_LEN } else { code_seg_cap() }
    while i < copy_len {
        let abs_off = CODE_SEG_BASE + i
        if abs_off < code_cap() {
            CODE[abs_off as usize] = CODE_SEG[i as usize]
            mc_note_code_resident(CODE_SEG_KIND[i as usize] as i64)
            mc_note_code_copy(CODE_SEG_KIND[i as usize] as i64)
        } else {
            mc_note_saturation(6, -1)
            mc_note_code_overflow(code_overflow_frontier_global())
            break
        }
        i = i + 1
    }
    CODE_SEG_ACTIVE = 0
    CODE_SEG_BASE = 0
    CODE_SEG_LEN = 0
}

fn code_write_at(abs_off: i64, b: i64) with Mut, Panic {
    if CODE_SEG_ACTIVE != 0 && abs_off >= CODE_SEG_BASE && abs_off < CODE_SEG_BASE + CODE_SEG_LEN {
        let rel = abs_off - CODE_SEG_BASE
        if rel >= 0 && rel < code_seg_cap() {
            mc_note_code_rewrite()
            CODE_SEG[rel as usize] = b as i8
            return
        }
    }
    if abs_off < 0 || abs_off >= code_cap() {
        mc_note_saturation(6, -1)
        mc_note_code_overflow(code_overflow_frontier_global())
        return
    }
    mc_note_code_rewrite()
    CODE[abs_off as usize] = b as i8
}

fn code_write_u32_at(abs_off: i64, v: i64) with Mut, Panic {
    code_write_at(abs_off, v & 0xFF)
    code_write_at(abs_off + 1, (v >> 8) & 0xFF)
    code_write_at(abs_off + 2, (v >> 16) & 0xFF)
    code_write_at(abs_off + 3, (v >> 24) & 0xFF)
}

fn mc_note_bad_node(node: i64) with Mut, Panic {
    if MC_FIRST_BAD_NODE_FN >= 0 { return }
    MC_FIRST_BAD_NODE_FN = CURRENT_CODEGEN_FN
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        MC_FIRST_BAD_NODE_MODULE = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
        MC_FIRST_BAD_NODE_BODY_STATE = FN_BODY_STATE[CURRENT_CODEGEN_FN as usize]
    } else {
        MC_FIRST_BAD_NODE_MODULE = -1
        MC_FIRST_BAD_NODE_BODY_STATE = 0
    }
    MC_FIRST_BAD_NODE_NODE = node
    if node >= 0 && node < ND_COUNT {
        MC_FIRST_BAD_NODE_KIND = ND_KIND[node as usize]
    } else {
        MC_FIRST_BAD_NODE_KIND = -1
    }
}

fn mc_note_codegen_phase(fn_idx: i64) with IO, Mut, Panic, Div {
    if fn_idx < 0 || fn_idx >= FN_COUNT { return }
    MC_CODEGEN_PHASE_FN = fn_idx
    MC_CODEGEN_PHASE_MODULE = FN_MODULE_IDX[fn_idx as usize]
    if MC_CODEGEN_PHASE_MODULE != MC_CODEGEN_LAST_PRINT_MODULE {
        print("CODEGEN_PHASE module=")
        print_int(MC_CODEGEN_PHASE_MODULE)
        print(" fn=")
        print_int(fn_idx)
        print(" path=")
        print_mc_module_path(MC_CODEGEN_PHASE_MODULE)
        print("\n")
        MC_CODEGEN_LAST_PRINT_MODULE = MC_CODEGEN_PHASE_MODULE
    }
}

fn mc_note_code_overflow(frontier: i64) with Mut, Panic {
    if MC_FIRST_CODE_OVF_FN >= 0 { return }
    MC_FIRST_CODE_OVF_FN = CURRENT_CODEGEN_FN
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        MC_FIRST_CODE_OVF_MODULE = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
    } else {
        MC_FIRST_CODE_OVF_MODULE = -1
    }
    MC_FIRST_CODE_OVF_SECTION = CODE_CUR_SECTION
    MC_FIRST_CODE_OVF_FRONTIER = frontier
}

fn mc_note_codegen_ineligible(fn_idx: i64, body_state: i64) with Mut, Panic {
    if body_state == fn_body_state_stub() { MC_CODEGEN_STUB_COUNT = MC_CODEGEN_STUB_COUNT + 1 }
    if body_state == fn_body_state_deferred() { MC_CODEGEN_DEFERRED_COUNT = MC_CODEGEN_DEFERRED_COUNT + 1 }
    if MC_FIRST_CODEGEN_INELIGIBLE_FN >= 0 { return }
    MC_FIRST_CODEGEN_INELIGIBLE_FN = fn_idx
    if fn_idx >= 0 && fn_idx < FN_COUNT {
        MC_FIRST_CODEGEN_INELIGIBLE_MODULE = FN_MODULE_IDX[fn_idx as usize]
    } else {
        MC_FIRST_CODEGEN_INELIGIBLE_MODULE = -1
    }
    MC_FIRST_CODEGEN_INELIGIBLE_BODY_STATE = body_state
}

fn mc_finalize_text_truth(entry_fn: i64) with Mut, Panic, Div {
    MC_TEXT_LIVE_BYTES = 0
    MC_TEXT_LIVE_GROSS = 0
    MC_TEXT_DEAD_BYTES_CANDIDATE = 0
    MC_TEXT_DEAD_GROSS_CANDIDATE = 0
    MC_TEXT_DEAD_FN_COUNT = 0
    MC_TEXT_DEAD_FIRST_FN = -1
    MC_TEXT_DEAD_FIRST_MODULE = -1
    MC_TEXT_DUPLICATE_BYTES_CANDIDATE = 0
    MC_TEXT_DUPLICATE_BYTES_EXACT = 0
    MC_TEXT_DUPLICATE_GROUPS_CANDIDATE = 0
    MC_TEXT_DUPLICATE_GROUPS_EXACT = 0
    MC_TEXT_DUP_FIRST_FN = -1
    MC_TEXT_DUP_MATCH_FN = -1
    MC_PEAK_TEXT_MODULE = -1
    MC_PEAK_TEXT_MODULE_COUNT = 0
    MC_PEAK_TEXT_FN = -1
    MC_PEAK_TEXT_FN_COUNT = 0

    var i: i64 = 0
    while i < 5 {
        MC_TOP_TEXT_FN_IDX[i as usize] = -1
        MC_TOP_TEXT_FN_BYTES[i as usize] = 0
        MC_TOP_TEXT_MOD_IDX[i as usize] = -1
        MC_TOP_TEXT_MOD_BYTES[i as usize] = 0
        i = i + 1
    }

    i = 0
    while i < FN_COUNT {
        FN_CALL_REACHABLE[i as usize] = 0
        FN_DUP_CAND_MARK[i as usize] = 0
        FN_DUP_EXACT_MARK[i as usize] = 0
        if FN_TEXT_GROSS[i as usize] > MC_PEAK_TEXT_FN_COUNT {
            MC_PEAK_TEXT_FN = i
            MC_PEAK_TEXT_FN_COUNT = FN_TEXT_GROSS[i as usize]
        }
        mc_top_insert_text_fn(i, FN_TEXT_GROSS[i as usize])
        i = i + 1
    }

    i = 0
    while i < MC_MOD_COUNT {
        if MC_MOD_TEXT_GROSS[i as usize] > MC_PEAK_TEXT_MODULE_COUNT {
            MC_PEAK_TEXT_MODULE = i
            MC_PEAK_TEXT_MODULE_COUNT = MC_MOD_TEXT_GROSS[i as usize]
        }
        mc_top_insert_text_mod(i, MC_MOD_TEXT_GROSS[i as usize])
        i = i + 1
    }

    if entry_fn >= 0 && entry_fn < FN_COUNT {
        FN_CALL_REACHABLE[entry_fn as usize] = 1
    }

    var changed: i64 = 1
    while changed != 0 {
        changed = 0
        i = 0
        while i < REL_COUNT {
            if REL_KIND[i as usize] == 1 {
                let src = REL_SRC_FN[i as usize]
                let target = REL_TARGET_FN[i as usize]
                if src >= 0 && src < FN_COUNT && target >= 0 && target < FN_COUNT {
                    if FN_CALL_REACHABLE[src as usize] != 0 && FN_CALL_REACHABLE[target as usize] == 0 {
                        FN_CALL_REACHABLE[target as usize] = 1
                        changed = 1
                    }
                }
            }
            i = i + 1
        }
    }

    i = 0
    while i < FN_COUNT {
        if FN_CALL_REACHABLE[i as usize] != 0 {
            MC_TEXT_LIVE_BYTES = MC_TEXT_LIVE_BYTES + FN_TEXT_RESIDENT[i as usize]
            MC_TEXT_LIVE_GROSS = MC_TEXT_LIVE_GROSS + FN_TEXT_GROSS[i as usize]
        } else {
            MC_TEXT_DEAD_BYTES_CANDIDATE = MC_TEXT_DEAD_BYTES_CANDIDATE + FN_TEXT_RESIDENT[i as usize]
            MC_TEXT_DEAD_GROSS_CANDIDATE = MC_TEXT_DEAD_GROSS_CANDIDATE + FN_TEXT_GROSS[i as usize]
            if FN_TEXT_GROSS[i as usize] > 0 || FN_TEXT_RESIDENT[i as usize] > 0 {
                MC_TEXT_DEAD_FN_COUNT = MC_TEXT_DEAD_FN_COUNT + 1
                if MC_TEXT_DEAD_FIRST_FN < 0 {
                    MC_TEXT_DEAD_FIRST_FN = i
                    MC_TEXT_DEAD_FIRST_MODULE = FN_MODULE_IDX[i as usize]
                }
            }
        }
        i = i + 1
    }

    i = 0
    while i < FN_COUNT {
        if FN_TEXT_GROSS[i as usize] > 0 && FN_DUP_CAND_MARK[i as usize] == 0 {
            var group_cand: i64 = 0
            var group_exact: i64 = 0
            var j: i64 = i + 1
            while j < FN_COUNT {
                if FN_TEXT_GROSS[j as usize] == FN_TEXT_GROSS[i as usize] &&
                   FN_TEXT_HASH[j as usize] == FN_TEXT_HASH[i as usize] &&
                   FN_CODE_TOTAL[j as usize] == FN_CODE_TOTAL[i as usize] &&
                   FN_TEXT_GROSS[j as usize] > 0 {
                    if group_cand == 0 {
                        MC_TEXT_DUPLICATE_GROUPS_CANDIDATE = MC_TEXT_DUPLICATE_GROUPS_CANDIDATE + 1
                        group_cand = 1
                        if MC_TEXT_DUP_FIRST_FN < 0 {
                            MC_TEXT_DUP_FIRST_FN = i
                            MC_TEXT_DUP_MATCH_FN = j
                        }
                    }
                    if FN_DUP_CAND_MARK[j as usize] == 0 {
                        MC_TEXT_DUPLICATE_BYTES_CANDIDATE = MC_TEXT_DUPLICATE_BYTES_CANDIDATE + FN_TEXT_GROSS[j as usize]
                        FN_DUP_CAND_MARK[j as usize] = 1
                    }
                    if fn_code_slices_equal(i, j) != 0 {
                        if group_exact == 0 {
                            MC_TEXT_DUPLICATE_GROUPS_EXACT = MC_TEXT_DUPLICATE_GROUPS_EXACT + 1
                            group_exact = 1
                        }
                        if FN_DUP_EXACT_MARK[j as usize] == 0 {
                            MC_TEXT_DUPLICATE_BYTES_EXACT = MC_TEXT_DUPLICATE_BYTES_EXACT + FN_TEXT_GROSS[j as usize]
                            FN_DUP_EXACT_MARK[j as usize] = 1
                        }
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn mc_note_fixup_overflow(kind: i64) with Mut, Panic {
    if kind == 1 { MC_OVF_FIX = 1 }
    if kind == 2 { MC_OVF_FN_LEA_FIX = 1 }
    if MC_FIRST_FIX_OVF_FN >= 0 { return }
    MC_FIRST_FIX_OVF_FN = CURRENT_CODEGEN_FN
    if CURRENT_CODEGEN_FN >= 0 && CURRENT_CODEGEN_FN < FN_COUNT {
        MC_FIRST_FIX_OVF_MODULE = FN_MODULE_IDX[CURRENT_CODEGEN_FN as usize]
    } else {
        MC_FIRST_FIX_OVF_MODULE = -1
    }
    MC_FIRST_FIX_OVF_KIND = kind
}

fn reloc_patch_state_pending() -> i64 { 1 }
fn reloc_patch_state_immediate() -> i64 { 2 }
fn reloc_patch_state_patched_late() -> i64 { 3 }
fn reloc_patch_state_elided() -> i64 { 4 }
fn reloc_patch_state_overflow() -> i64 { 5 }

fn reloc_locality_unknown() -> i64 { 0 }
fn reloc_locality_local() -> i64 { 1 }
fn reloc_locality_external() -> i64 { 2 }

fn mc_fixup_locality(src_fn: i64, target_fn_idx: i64) -> i64 with Mut, Panic {
    if src_fn < 0 || src_fn >= FN_COUNT { return reloc_locality_unknown() }
    if target_fn_idx < 0 || target_fn_idx >= FN_COUNT { return reloc_locality_unknown() }
    let src_module = FN_MODULE_IDX[src_fn as usize]
    let target_module = FN_MODULE_IDX[target_fn_idx as usize]
    if src_module < 0 || target_module < 0 { return reloc_locality_unknown() }
    if src_module == target_module { return reloc_locality_local() }
    reloc_locality_external()
}

fn mc_record_reloc(kind: i64, site_off: i64, target_fn_idx: i64, patch_state: i64) -> i64 with Mut, Panic, Div {
    let src_fn = CURRENT_CODEGEN_FN
    let locality = mc_fixup_locality(src_fn, target_fn_idx)
    let src_module = if src_fn >= 0 && src_fn < FN_COUNT { FN_MODULE_IDX[src_fn as usize] } else { -1 }
    if src_module >= 0 && src_module < MC_MOD_COUNT {
        let module_sample_idx = MC_MOD_RELOC_SAMPLE_COUNT[src_module as usize]
        if module_sample_idx < reloc_mod_sample_cap() {
            let bag_idx = src_module * reloc_mod_sample_cap() + module_sample_idx
            MC_MOD_REL_KIND[bag_idx as usize] = kind
            MC_MOD_REL_SITE_OFF[bag_idx as usize] = site_off
            MC_MOD_REL_SRC_FN[bag_idx as usize] = src_fn
            MC_MOD_REL_TARGET_FN[bag_idx as usize] = target_fn_idx
            MC_MOD_REL_PATCH_STATE[bag_idx as usize] = patch_state
            MC_MOD_REL_LOCALITY[bag_idx as usize] = locality
            MC_MOD_RELOC_SAMPLE_COUNT[src_module as usize] = module_sample_idx + 1
        } else {
            MC_OVF_RELOC_ARTIFACT = 1
            MC_MOD_RELOC_SAMPLE_OVF[src_module as usize] = 1
            if MC_MOD_RELOC_FIRST_OVF_FN[src_module as usize] < 0 {
                MC_MOD_RELOC_FIRST_OVF_FN[src_module as usize] = src_fn
            }
            if MC_FIRST_RELOC_ARTIFACT_OVF_MODULE < 0 {
                MC_FIRST_RELOC_ARTIFACT_OVF_MODULE = src_module
                MC_FIRST_RELOC_ARTIFACT_OVF_FN = src_fn
            }
        }
    }
    if REL_COUNT >= reloc_cap() {
        MC_OVF_RELOC_ARTIFACT = 1
        if MC_FIRST_RELOC_ARTIFACT_OVF_MODULE < 0 {
            MC_FIRST_RELOC_ARTIFACT_OVF_MODULE = src_module
            MC_FIRST_RELOC_ARTIFACT_OVF_FN = src_fn
        }
        return -1
    }
    let reloc_idx = REL_COUNT
    REL_KIND[reloc_idx as usize] = kind
    REL_SITE_OFF[reloc_idx as usize] = site_off
    REL_SRC_FN[reloc_idx as usize] = src_fn
    REL_TARGET_FN[reloc_idx as usize] = target_fn_idx
    REL_PATCH_STATE[reloc_idx as usize] = patch_state
    REL_LOCALITY[reloc_idx as usize] = locality
    REL_SRC_MODULE[reloc_idx as usize] = src_module
    if target_fn_idx >= 0 && target_fn_idx < FN_COUNT {
        REL_TARGET_MODULE[reloc_idx as usize] = FN_MODULE_IDX[target_fn_idx as usize]
    } else {
        REL_TARGET_MODULE[reloc_idx as usize] = -1
    }
    REL_COUNT = REL_COUNT + 1
    reloc_idx
}

fn mc_record_fixup(kind: i64, site_off: i64, target_fn_idx: i64, patch_state: i64) -> i64 with Mut, Panic, Div {
    let reloc_idx = mc_record_reloc(kind, site_off, target_fn_idx, patch_state)
    let src_fn = CURRENT_CODEGEN_FN
    let locality = mc_fixup_locality(src_fn, target_fn_idx)
    MC_FIX_COUNT_TOTAL = MC_FIX_COUNT_TOTAL + 1
    if kind == 1 { MC_FIX_COUNT_CALL = MC_FIX_COUNT_CALL + 1 }
    if kind == 2 { MC_FIX_COUNT_FN_ADDR = MC_FIX_COUNT_FN_ADDR + 1 }
    if locality == reloc_locality_local() { MC_FIX_COUNT_LOCAL = MC_FIX_COUNT_LOCAL + 1 }
    if locality == reloc_locality_external() { MC_FIX_COUNT_EXTERNAL = MC_FIX_COUNT_EXTERNAL + 1 }
    if patch_state == reloc_patch_state_pending() { MC_FIX_PATCH_PENDING_COUNT = MC_FIX_PATCH_PENDING_COUNT + 1 }
    if patch_state == reloc_patch_state_immediate() { MC_FIX_PATCH_IMMEDIATE_COUNT = MC_FIX_PATCH_IMMEDIATE_COUNT + 1 }
    if patch_state == reloc_patch_state_overflow() { MC_FIX_PATCH_OVERFLOW_COUNT = MC_FIX_PATCH_OVERFLOW_COUNT + 1 }
    if src_fn >= 0 && src_fn < FN_COUNT {
        FN_FIX_TOTAL[src_fn as usize] = FN_FIX_TOTAL[src_fn as usize] + 1
        if kind == 1 { FN_FIX_CALL[src_fn as usize] = FN_FIX_CALL[src_fn as usize] + 1 }
        if kind == 2 { FN_FIX_FN_ADDR[src_fn as usize] = FN_FIX_FN_ADDR[src_fn as usize] + 1 }
        if locality == reloc_locality_local() { FN_FIX_LOCAL[src_fn as usize] = FN_FIX_LOCAL[src_fn as usize] + 1 }
        if locality == reloc_locality_external() { FN_FIX_EXTERNAL[src_fn as usize] = FN_FIX_EXTERNAL[src_fn as usize] + 1 }
        if FN_FIX_TOTAL[src_fn as usize] > MC_FIX_PEAK_FN_COUNT {
            MC_FIX_PEAK_FN = src_fn
            MC_FIX_PEAK_FN_COUNT = FN_FIX_TOTAL[src_fn as usize]
        }
        let module_idx = FN_MODULE_IDX[src_fn as usize]
        if module_idx >= 0 && module_idx < MC_MOD_COUNT {
            MC_MOD_FIX_TOTAL[module_idx as usize] = MC_MOD_FIX_TOTAL[module_idx as usize] + 1
            if kind == 1 { MC_MOD_FIX_CALL[module_idx as usize] = MC_MOD_FIX_CALL[module_idx as usize] + 1 }
            if kind == 2 { MC_MOD_FIX_FN_ADDR[module_idx as usize] = MC_MOD_FIX_FN_ADDR[module_idx as usize] + 1 }
            if locality == reloc_locality_local() { MC_MOD_FIX_LOCAL[module_idx as usize] = MC_MOD_FIX_LOCAL[module_idx as usize] + 1 }
            if locality == reloc_locality_external() { MC_MOD_FIX_EXTERNAL[module_idx as usize] = MC_MOD_FIX_EXTERNAL[module_idx as usize] + 1 }
            if MC_MOD_FIX_TOTAL[module_idx as usize] > MC_FIX_PEAK_MODULE_COUNT {
                MC_FIX_PEAK_MODULE = module_idx
                MC_FIX_PEAK_MODULE_COUNT = MC_MOD_FIX_TOTAL[module_idx as usize]
                MC_FIX_PEAK_PHASE = MC_CUR_PHASE
            }
        }
    }
    if kind == 1 && target_fn_idx >= 0 && target_fn_idx < FN_COUNT {
        let target_state = FN_BODY_STATE[target_fn_idx as usize]
        if target_state == fn_body_state_full() || target_state == fn_body_state_materialized_on_demand() {
            MC_FIX_CALL_TARGET_FULL = MC_FIX_CALL_TARGET_FULL + 1
        } else {
            MC_FIX_CALL_TARGET_NONFULL = MC_FIX_CALL_TARGET_NONFULL + 1
        }
    }
    reloc_idx
}

fn mc_note_fixup_elided(site_off: i64, target_fn_idx: i64) with Mut, Panic, Div {
    let src_fn = CURRENT_CODEGEN_FN
    mc_record_reloc(1, site_off, target_fn_idx, reloc_patch_state_elided())
    MC_FIX_COUNT_ELIDED = MC_FIX_COUNT_ELIDED + 1
    if target_fn_idx >= 0 && target_fn_idx < FN_COUNT {
        let target_state = FN_BODY_STATE[target_fn_idx as usize]
        if target_state != fn_body_state_full() && target_state != fn_body_state_materialized_on_demand() {
            MC_FIX_ELIDED_NONFULL = MC_FIX_ELIDED_NONFULL + 1
        }
    }
    if src_fn >= 0 && src_fn < FN_COUNT {
        FN_FIX_ELIDED[src_fn as usize] = FN_FIX_ELIDED[src_fn as usize] + 1
        let module_idx = FN_MODULE_IDX[src_fn as usize]
        if module_idx >= 0 && module_idx < MC_MOD_COUNT {
            MC_MOD_FIX_ELIDED[module_idx as usize] = MC_MOD_FIX_ELIDED[module_idx as usize] + 1
        }
    }
}

fn mc_should_elide_call_fixup(target_fn_idx: i64) -> i64 with Mut, Panic {
    if mc_large_surface_mode() == 0 { return 0 }
    if target_fn_idx < 0 || target_fn_idx >= FN_COUNT { return 0 }
    let target_state = FN_BODY_STATE[target_fn_idx as usize]
    if target_state == fn_body_state_full() || target_state == fn_body_state_materialized_on_demand() {
        return 0
    }
    1
}

fn mc_patch_rel32_at(fix_pos: i64, target_off: i64) with Mut, Panic, Div {
    let rel = target_off - (fix_pos + 4)
    code_write_u32_at(fix_pos, rel)
}

fn mc_target_fn_ready(fn_idx: i64) -> i64 with Mut, Panic {
    if fn_idx < 0 || fn_idx >= FN_COUNT { return 0 }
    if fn_idx == CURRENT_CODEGEN_FN { return 1 }
    if FN_CODE_READY[fn_idx as usize] == 0 { return 0 }
    1
}

fn mc_add_call_fixup(fix_pos: i64, fn_idx: i64) with Mut, Panic, Div {
    if mc_target_fn_ready(fn_idx) != 0 {
        mc_record_fixup(1, fix_pos, fn_idx, reloc_patch_state_immediate())
        mc_patch_rel32_at(fix_pos, FN_CODE_OFF[fn_idx as usize])
        return
    }
    if FIX_COUNT >= fix_cap() {
        mc_record_fixup(1, fix_pos, fn_idx, reloc_patch_state_overflow())
        mc_note_fixup_overflow(1)
        return
    }
    let reloc_idx = mc_record_fixup(1, fix_pos, fn_idx, reloc_patch_state_pending())
    FIX_OFF[FIX_COUNT as usize] = fix_pos
    FIX_TARGET[FIX_COUNT as usize] = fn_idx
    FIX_RELOC_IDX[FIX_COUNT as usize] = reloc_idx
    FIX_COUNT = FIX_COUNT + 1
    if FIX_COUNT > MC_FIX_HIGH_WATER { MC_FIX_HIGH_WATER = FIX_COUNT }
}

fn mc_add_fn_lea_fixup(fix_pos: i64, fn_idx: i64) with Mut, Panic, Div {
    if mc_target_fn_ready(fn_idx) != 0 {
        mc_record_fixup(2, fix_pos, fn_idx, reloc_patch_state_immediate())
        mc_patch_rel32_at(fix_pos, FN_CODE_OFF[fn_idx as usize])
        return
    }
    if FN_LEA_FIX_COUNT >= fn_lea_fix_cap() {
        mc_record_fixup(2, fix_pos, fn_idx, reloc_patch_state_overflow())
        mc_note_fixup_overflow(2)
        return
    }
    let reloc_idx = mc_record_fixup(2, fix_pos, fn_idx, reloc_patch_state_pending())
    FN_LEA_FIX_OFF[FN_LEA_FIX_COUNT as usize] = fix_pos
    FN_LEA_FIX_TARGET[FN_LEA_FIX_COUNT as usize] = fn_idx
    FN_LEA_FIX_RELOC_IDX[FN_LEA_FIX_COUNT as usize] = reloc_idx
    FN_LEA_FIX_COUNT = FN_LEA_FIX_COUNT + 1
    if FN_LEA_FIX_COUNT > MC_FN_LEA_FIX_HIGH_WATER { MC_FN_LEA_FIX_HIGH_WATER = FN_LEA_FIX_COUNT }
}

fn mc_note_saturation(resource: i64, module_idx: i64) with Mut, Panic, Div {
    if resource == 0 { MC_OVF_TK = 1 }
    else if resource == 1 { MC_OVF_ND = 1 }
    else if resource == 2 { MC_OVF_FN = 1 }
    else if resource == 3 { MC_OVF_ST = 1 }
    else if resource == 4 { MC_OVF_FLD = 1 }
    else if resource == 5 { MC_OVF_POOL = 1 }
    else if resource == 6 { MC_OVF_CODE = 1 }
    else if resource == 7 { MC_OVF_EN = 1 }
    else if resource == 8 { MC_OVF_NAME = 1; MC_OVF_NAME_BYTES = 1 }
    else if resource == 10 { MC_OVF_NAME = 1; MC_OVF_NAME_SLOTS = 1 }
    mc_record_first(resource, module_idx)
    mc_mark_parse_status(module_idx, mc_parse_status_for_resource(resource))
}

fn mc_note_first_parse_fail(expected: i64, got: i64, module_idx: i64, fail_src: i64) with Mut {
    if module_idx >= 0 && module_idx < MC_MOD_COUNT {
        MC_MOD_PARSE_FAIL_COUNT[module_idx as usize] = MC_MOD_PARSE_FAIL_COUNT[module_idx as usize] + 1
        if MC_MOD_FIRST_PARSE_FAIL_SRC[module_idx as usize] < 0 {
            MC_MOD_FIRST_PARSE_FAIL_SRC[module_idx as usize] = fail_src
            MC_MOD_FIRST_PARSE_FAIL_POS[module_idx as usize] = POS
            MC_MOD_FIRST_PARSE_FAIL_EXPECTED[module_idx as usize] = expected
            MC_MOD_FIRST_PARSE_FAIL_GOT[module_idx as usize] = got
        }
    }
    if MC_FIRST_PARSE_FAIL_MODULE >= 0 { return }
    MC_FIRST_PARSE_FAIL_MODULE = module_idx
    MC_FIRST_PARSE_FAIL_SRC = fail_src
    MC_FIRST_PARSE_FAIL_POS = POS
    MC_FIRST_PARSE_FAIL_EXPECTED = expected
    MC_FIRST_PARSE_FAIL_GOT = got
}

fn mc_note_boundary_mismatch(expected: i64, module_idx: i64, fail_src: i64) with Mut, Panic, Div {
    MC_BOUNDARY_MISMATCH_COUNT = MC_BOUNDARY_MISMATCH_COUNT + 1
    if module_idx >= 0 && module_idx < MC_MOD_COUNT {
        MC_MOD_BOUNDARY_HITS[module_idx as usize] = MC_MOD_BOUNDARY_HITS[module_idx as usize] + 1
        if MC_MOD_BOUNDARY_FIRST_SRC[module_idx as usize] < 0 {
            MC_MOD_BOUNDARY_FIRST_SRC[module_idx as usize] = fail_src
            MC_MOD_BOUNDARY_FIRST_POS[module_idx as usize] = POS
            MC_MOD_BOUNDARY_FIRST_EXPECTED[module_idx as usize] = expected
        }
        mc_mark_parse_status(module_idx, 10)
    }
    if MC_BOUNDARY_FIRST_MODULE >= 0 { return }
    MC_BOUNDARY_FIRST_MODULE = module_idx
    MC_BOUNDARY_FIRST_SRC = fail_src
    MC_BOUNDARY_FIRST_POS = POS
    MC_BOUNDARY_FIRST_EXPECTED = expected
}

fn mc_set_record_slice(src_start: i64, src_len: i64, req_len: i64) with Mut {
    MC_REC_SRC_START = src_start
    MC_REC_SRC_LEN = src_len
    MC_REC_REQ_LEN = req_len
}

fn mc_record_module(path_off: i64, path_len: i64, kind: i64) with Mut, Panic, Div {
    if MC_MOD_COUNT >= 256 { return }
    let idx = MC_MOD_COUNT
    MC_MOD_PATH_OFF[idx as usize] = path_off
    MC_MOD_PATH_LEN[idx as usize] = path_len
    MC_MOD_SRC_START[idx as usize] = MC_REC_SRC_START
    MC_MOD_SRC_LEN[idx as usize] = MC_REC_SRC_LEN
    MC_MOD_REQ_LEN[idx as usize] = MC_REC_REQ_LEN
    MC_MOD_KIND[idx as usize] = kind
    MC_MOD_REQSPEC_OFF[idx as usize] = MC_REC_REQSPEC_OFF
    MC_MOD_REQSPEC_LEN[idx as usize] = MC_REC_REQSPEC_LEN
    MC_MOD_RES_KIND[idx as usize] = MC_REC_RES_KIND
    MC_MOD_PARENT[idx as usize] = MC_REC_PARENT
    MC_MOD_DEPTH[idx as usize] = MC_REC_DEPTH
    MC_MOD_SRC_HASH[idx as usize] = mc_hash_src_range(MC_REC_SRC_START, MC_REC_SRC_LEN)
    MC_MOD_PARSE_STATUS[idx as usize] = 0
    MC_MOD_EXEC_STATE[idx as usize] = 0
    MC_MOD_FN_LOCAL[idx as usize] = 0
    MC_MOD_TK_START[idx as usize] = 0
    MC_MOD_TK_END[idx as usize] = 0
    MC_MOD_TK_SCAN_START[idx as usize] = 0
    MC_MOD_TK_SCAN_END[idx as usize] = 0
    MC_MOD_COUNT = MC_MOD_COUNT + 1
    mc_hash_mix(kind)
    mc_hash_mix(MC_REC_SRC_START)
    mc_hash_mix(MC_REC_SRC_LEN)
    mc_hash_mix(MC_REC_REQ_LEN)
    mc_hash_mix(MC_REC_RES_KIND)
    mc_hash_mix(MC_REC_PARENT)
    mc_hash_mix(MC_REC_DEPTH)
    mc_hash_pool_slice(path_off, path_len)
    mc_hash_pool_slice(MC_REC_REQSPEC_OFF, MC_REC_REQSPEC_LEN)
}

