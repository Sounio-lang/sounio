            if arg != -1 {
                compile_node(arg)
            }
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0xE8)
            let rel = PRINT_INT_OFF - (CODE_LEN + 4)
            emit_u32(rel)
            return 0
        }

        if pool_match(c_off, c_len, "exit") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                compile_node(arg)
            }
            emit(0x48); emit(0x89); emit(0xC7)
            emit(0x48); emit(0xC7); emit(0xC0); emit_u32(60)
            emit(0x0F); emit(0x05)
            return 0
        }

        if pool_match(c_off, c_len, "arg_count") {
            emit(0x48); emit(0xB8); emit_u64(0x700000)
            emit(0x48); emit(0x8B); emit(0x00)
            emit(0x48); emit(0x8B); emit(0x00)
            emit(0x48); emit(0xFF); emit(0xC8)
            return 0
        }

        if pool_match(c_off, c_len, "get_arg") {
