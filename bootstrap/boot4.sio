                        let msn_len = ST_NAME_LEN[mbi_si as usize]
                        let mq_off = pool_concat_colon(msn_off, msn_len, mbi_off, mbi_len)
                        let mq_len = msn_len + 2 + mbi_len
                        let mbi_fn = find_fn_by_name(mq_off, mq_len)
