var MC_FIX_PEAK_FN_COUNT: i64 = 0
var MC_FIX_PEAK_PHASE: i64 = 0

// ============================================================================
// Constants
// ============================================================================

fn TK_EOF() -> i64 { 0 }
fn TK_IDENT() -> i64 { 1 }
fn TK_INT() -> i64 { 2 }
fn TK_STR() -> i64 { 3 }
fn TK_PLUS() -> i64 { 10 }
fn TK_MINUS() -> i64 { 11 }
fn TK_STAR() -> i64 { 12 }
fn TK_SLASH() -> i64 { 13 }
fn TK_PERCENT() -> i64 { 14 }
fn TK_AMP() -> i64 { 15 }
fn TK_PIPE() -> i64 { 16 }
fn TK_CARET() -> i64 { 17 }
fn TK_SHL() -> i64 { 18 }
fn TK_SHR() -> i64 { 19 }
fn TK_AMPAMP() -> i64 { 20 }
fn TK_PIPEPIPE() -> i64 { 21 }
fn TK_BANG() -> i64 { 22 }
fn TK_EQ() -> i64 { 23 }
fn TK_NE() -> i64 { 24 }
fn TK_LT() -> i64 { 25 }
fn TK_LE() -> i64 { 26 }
fn TK_GT() -> i64 { 27 }
fn TK_GE() -> i64 { 28 }
fn TK_ASSIGN() -> i64 { 30 }
fn TK_LPAREN() -> i64 { 31 }
fn TK_RPAREN() -> i64 { 32 }
fn TK_LBRACE() -> i64 { 33 }
