fn mc_record_root(path: string, src_len: i64) with Mut, Panic, Div {
    let off = pool_copy_string(path)
    let len = str_len(path)
    mc_set_record_slice(0, src_len, MC_LAST_REQUESTED_BYTES)
    MC_REC_REQSPEC_OFF = off
    MC_REC_REQSPEC_LEN = len
    MC_REC_RES_KIND = 0
    MC_REC_PARENT = -1
    MC_REC_DEPTH = 0
    mc_record_module(off, len, 0)
    if src_len < MC_LAST_REQUESTED_BYTES && MC_FIRST_TRUNCATED_INDEX < 0 {
        MC_FIRST_TRUNCATED_INDEX = 0
    }
}

fn mc_record_import(import_idx: i64) with Mut, Panic, Div {
    if import_idx < 0 || import_idx >= IMP_LOADED_COUNT { return }
    let off = IMP_POOL_OFF[import_idx as usize]
    let len = IMP_POOL_LEN[import_idx as usize]
    let src_start = IMP_SRC_START[import_idx as usize]
    let src_len = IMP_SRC_LEN[import_idx as usize]
    let req_len = IMP_REQ_LEN[import_idx as usize]
    if src_len < req_len && MC_FIRST_TRUNCATED_INDEX < 0 {
        MC_FIRST_TRUNCATED_INDEX = MC_MOD_COUNT
    }
    mc_set_record_slice(src_start, src_len, req_len)
    MC_REC_REQSPEC_OFF = IMP_REQSPEC_OFF[import_idx as usize]
    MC_REC_REQSPEC_LEN = IMP_REQSPEC_LEN[import_idx as usize]
    MC_REC_RES_KIND = IMP_RES_KIND[import_idx as usize]
    MC_REC_PARENT = IMP_PARENT[import_idx as usize]
    MC_REC_DEPTH = IMP_DEPTH[import_idx as usize]
    mc_record_module(off, len, 1)
}

fn mc_record_unresolved(off: i64, len: i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < MC_UNRES_COUNT {
        if pool_slices_eq(MC_UNRES_OFF[i as usize], MC_UNRES_LEN[i as usize], off, len) {
            return
        }
        i = i + 1
    }
    if MC_UNRES_COUNT >= 128 { return }
    MC_UNRES_OFF[MC_UNRES_COUNT as usize] = off
    MC_UNRES_LEN[MC_UNRES_COUNT as usize] = len
    MC_UNRES_COUNT = MC_UNRES_COUNT + 1
}

fn mc_freeze_modules_into_code_scratch() with Mut, Panic, Div {
    MC_FROZEN_TOTAL = 0
    MC_FROZEN_TRUNCATED = 0
    var m: i64 = 0
    while m < MC_MOD_COUNT {
        let src_start = MC_MOD_SRC_START[m as usize]
        let src_len = MC_MOD_SRC_LEN[m as usize]
        MC_MOD_FROZEN_OFF[m as usize] = MC_FROZEN_TOTAL
        var copied: i64 = 0
        while copied < src_len && MC_FROZEN_TOTAL + copied < code_cap() {
            CODE[(MC_FROZEN_TOTAL + copied) as usize] = SRC[(src_start + copied) as usize]
            copied = copied + 1
        }
        MC_MOD_FROZEN_LEN[m as usize] = copied
        if copied < src_len {
            MC_FROZEN_TRUNCATED = 1
            mc_note_saturation(6, m)
        }
        MC_FROZEN_TOTAL = MC_FROZEN_TOTAL + copied
        m = m + 1
    }
}

fn mc_freeze_current_module_into_code_scratch() with Mut, Panic, Div {
    MC_CUR_FROZEN_OFF = 0
    MC_CUR_FROZEN_LEN = 0
    if MC_CUR_MODULE_IDX < 0 || MC_CUR_MODULE_IDX >= MC_MOD_COUNT { return }
    let src_start = MC_MOD_SRC_START[MC_CUR_MODULE_IDX as usize]
    let src_len = MC_MOD_SRC_LEN[MC_CUR_MODULE_IDX as usize]
    var copied: i64 = 0
    while copied < src_len && copied < code_cap() {
        CODE[copied as usize] = SRC[(src_start + copied) as usize]
        copied = copied + 1
    }
    MC_MOD_FROZEN_OFF[MC_CUR_MODULE_IDX as usize] = 0
    MC_MOD_FROZEN_LEN[MC_CUR_MODULE_IDX as usize] = copied
    MC_CUR_FROZEN_LEN = copied
    if copied < src_len {
        MC_FROZEN_TRUNCATED = 1
        mc_note_saturation(6, MC_CUR_MODULE_IDX)
    }
}

fn mc_compute_token_boundaries() with Mut, Panic, Div {
    var tk_cursor: i64 = 0
    var m: i64 = 0
    while m < MC_MOD_COUNT {
        let src_start = MC_MOD_SRC_START[m as usize]
        let src_end = src_start + MC_MOD_SRC_LEN[m as usize]
        while tk_cursor < TK_COUNT && TK_START[tk_cursor as usize] < src_start {
            tk_cursor = tk_cursor + 1
        }
        MC_MOD_TK_SCAN_START[m as usize] = tk_cursor
        while tk_cursor < TK_COUNT && TK_START[tk_cursor as usize] < src_end {
            tk_cursor = tk_cursor + 1
        }
        MC_MOD_TK_SCAN_END[m as usize] = tk_cursor
        if MC_MOD_TK_START[m as usize] != MC_MOD_TK_SCAN_START[m as usize] || MC_MOD_TK_END[m as usize] != MC_MOD_TK_SCAN_END[m as usize] {
            MC_TK_BOUNDARY_DRIFT_COUNT = MC_TK_BOUNDARY_DRIFT_COUNT + 1
            MC_MOD_TK_BOUNDARY_DRIFT[m as usize] = 1
            if MC_TK_BOUNDARY_FIRST_MODULE < 0 {
                MC_TK_BOUNDARY_FIRST_MODULE = m
            }
        }
        if MC_MOD_TK_END[m as usize] == 0 && MC_MOD_TK_START[m as usize] == 0 {
            MC_MOD_TK_START[m as usize] = MC_MOD_TK_SCAN_START[m as usize]
            MC_MOD_TK_END[m as usize] = MC_MOD_TK_SCAN_END[m as usize]
        }
        if MC_MOD_TK_END[m as usize] > MC_MOD_TK_START[m as usize] && MC_MOD_PARSE_STATUS[m as usize] == 0 {
            MC_MOD_PARSE_STATUS[m as usize] = 1
        }
        m = m + 1
    }
}

fn mc_scan_decl_frontier() with Mut, Panic, Div {
    MC_FN_SIG_TOTAL = 0
    MC_FN_SIG_ROOT = 0
    MC_FN_SIG_IMPORTED = 0
    var m: i64 = 0
    while m < MC_MOD_COUNT {
        MC_MOD_FN_SIG[m as usize] = 0
        var t: i64 = MC_MOD_TK_START[m as usize]
        var depth: i64 = 0
        var impl_header: i64 = 0
        var impl_depth: i64 = -1
        while t < MC_MOD_TK_END[m as usize] {
            let k = TK_KIND[t as usize]
            if k == 60 && depth == 0 {
                impl_header = 1
            } else if k == 33 {
                depth = depth + 1
                if impl_header == 1 && impl_depth < 0 {
                    impl_depth = depth
                    impl_header = 0
                }
            } else if k == 34 {
                if impl_depth == depth { impl_depth = -1 }
                if depth > 0 { depth = depth - 1 }
            } else if k == 50 {
                let next_is_name = t + 1 < MC_MOD_TK_END[m as usize] && TK_KIND[(t + 1) as usize] == 1
                let is_decl_site = depth == 0 || (impl_depth > 0 && depth == impl_depth)
                if next_is_name && is_decl_site {
                    MC_MOD_FN_SIG[m as usize] = MC_MOD_FN_SIG[m as usize] + 1
                    MC_FN_SIG_TOTAL = MC_FN_SIG_TOTAL + 1
                    if MC_MOD_KIND[m as usize] == 0 {
                        MC_FN_SIG_ROOT = MC_FN_SIG_ROOT + 1
                    } else {
                        MC_FN_SIG_IMPORTED = MC_FN_SIG_IMPORTED + 1
                    }
                }
            }
            t = t + 1
        }
        m = m + 1
    }
}

fn mc_finalize_decl_frontier() with Mut, Panic, Div {
    MC_FN_BODY_TOTAL = 0
    MC_FN_BODY_ROOT = 0
    MC_FN_BODY_IMPORTED = 0
    MC_FN_GAP_TOTAL = 0
    MC_FN_BODY_NEEDED_TOTAL = 0
    MC_FN_BODY_SKIPPED_TOTAL = 0
    var m: i64 = 0
    while m < MC_MOD_COUNT {
        let body = MC_MOD_FN_LOCAL[m as usize]
        MC_FN_BODY_TOTAL = MC_FN_BODY_TOTAL + body
        MC_FN_BODY_NEEDED_TOTAL = MC_FN_BODY_NEEDED_TOTAL + MC_MOD_FN_BODY_NEEDED[m as usize]
        MC_FN_BODY_SKIPPED_TOTAL = MC_FN_BODY_SKIPPED_TOTAL + MC_MOD_FN_BODY_SKIPPED[m as usize]
        if MC_MOD_KIND[m as usize] == 0 {
            MC_FN_BODY_ROOT = MC_FN_BODY_ROOT + body
        } else {
            MC_FN_BODY_IMPORTED = MC_FN_BODY_IMPORTED + body
        }
        if MC_MOD_FN_SIG[m as usize] > body {
            MC_FN_GAP_TOTAL = MC_FN_GAP_TOTAL + (MC_MOD_FN_SIG[m as usize] - body)
        }
        m = m + 1
    }
}

fn mc_find_saturating_module() -> i64 with Mut, Panic, Div {
    if MC_SAT_FIRST_RESOURCE == 0 || MC_OVF_TK == 1 {
        var m: i64 = 0
        while m < MC_MOD_COUNT {
            if MC_MOD_TK_END[m as usize] >= TK_COUNT && TK_COUNT >= tk_cap() { return m }
            m = m + 1
        }
    }
    -1
}

fn mc_check_saturation() with Mut, Panic, Div {
    if TK_COUNT > MC_SAT_TK_HWM { MC_SAT_TK_HWM = TK_COUNT }
    if ND_COUNT > MC_SAT_ND_HWM { MC_SAT_ND_HWM = ND_COUNT }
    if FN_COUNT > MC_SAT_FN_HWM { MC_SAT_FN_HWM = FN_COUNT }
    if ST_COUNT > MC_SAT_ST_HWM { MC_SAT_ST_HWM = ST_COUNT }
    if FLD_COUNT > MC_SAT_FLD_HWM { MC_SAT_FLD_HWM = FLD_COUNT }
    if EN_COUNT > MC_SAT_EN_HWM { MC_SAT_EN_HWM = EN_COUNT }
    if POOL_POS > MC_SAT_POOL_HWM { MC_SAT_POOL_HWM = POOL_POS }
    if NAME_POOL_POS > MC_SAT_NAME_HWM { MC_SAT_NAME_HWM = NAME_POOL_POS }
    if NAME_INTERN_USED > MC_SAT_NAME_SLOT_HWM { MC_SAT_NAME_SLOT_HWM = NAME_INTERN_USED }
    if CODE_LEN > MC_SAT_CODE_HWM { MC_SAT_CODE_HWM = CODE_LEN }
    if MC_OVF_TK == 0 && TK_COUNT >= tk_cap() { MC_OVF_TK = 1 }
    if MC_OVF_ND == 0 && ND_COUNT >= nd_cap() { MC_OVF_ND = 1 }
    if MC_OVF_FN == 0 && FN_COUNT >= fn_cap() { MC_OVF_FN = 1 }
    if MC_OVF_ST == 0 && ST_COUNT >= st_cap() { MC_OVF_ST = 1 }
    if MC_OVF_FLD == 0 && FLD_COUNT >= fld_cap() { MC_OVF_FLD = 1 }
    if MC_OVF_EN == 0 && EN_COUNT >= en_cap() { MC_OVF_EN = 1 }
    if MC_OVF_POOL == 0 && POOL_POS >= pool_cap() { MC_OVF_POOL = 1 }
    if MC_OVF_NAME_BYTES == 0 && NAME_POOL_POS >= name_pool_cap() {
        MC_OVF_NAME = 1
        MC_OVF_NAME_BYTES = 1
    }
    if MC_OVF_NAME_SLOTS == 0 && NAME_INTERN_USED >= name_intern_cap() {
        MC_OVF_NAME = 1
        MC_OVF_NAME_SLOTS = 1
    }
    if MC_OVF_CODE == 0 && CODE_LEN >= code_cap() { MC_OVF_CODE = 1 }
    if MC_SAT_FIRST_RESOURCE < 0 {
        if MC_OVF_TK == 1 {
            MC_SAT_FIRST_RESOURCE = 0
            MC_SAT_FIRST_MODULE = mc_find_saturating_module()
        } else if MC_OVF_ND == 1 {
            MC_SAT_FIRST_RESOURCE = 1
            MC_SAT_FIRST_MODULE = mc_module_for_token_idx(POS)
        } else if MC_OVF_FN == 1 {
            MC_SAT_FIRST_RESOURCE = 2
            MC_SAT_FIRST_MODULE = mc_module_for_token_idx(POS)
        } else if MC_OVF_ST == 1 {
            MC_SAT_FIRST_RESOURCE = 3
            MC_SAT_FIRST_MODULE = mc_module_for_token_idx(POS)
        } else if MC_OVF_FLD == 1 {
            MC_SAT_FIRST_RESOURCE = 4
            MC_SAT_FIRST_MODULE = mc_module_for_token_idx(POS)
        } else if MC_OVF_POOL == 1 {
            MC_SAT_FIRST_RESOURCE = 5
            MC_SAT_FIRST_MODULE = mc_module_for_src_offset(MC_LAST_SRC_POS_HINT)
        } else if MC_OVF_NAME_BYTES == 1 {
            MC_SAT_FIRST_RESOURCE = 8
            MC_SAT_FIRST_MODULE = MC_NAME_POOL_FIRST_MODULE
        } else if MC_OVF_NAME_SLOTS == 1 {
            MC_SAT_FIRST_RESOURCE = 10
            MC_SAT_FIRST_MODULE = MC_NAME_SLOT_FIRST_MODULE
        } else if MC_OVF_CODE == 1 {
            MC_SAT_FIRST_RESOURCE = 6
            MC_SAT_FIRST_MODULE = -1
        } else if MC_OVF_EN == 1 {
            MC_SAT_FIRST_RESOURCE = 7
            MC_SAT_FIRST_MODULE = mc_module_for_token_idx(POS)
        }
        if MC_SAT_FIRST_RESOURCE >= 0 {
            mc_mark_parse_status(MC_SAT_FIRST_MODULE, mc_parse_status_for_resource(MC_SAT_FIRST_RESOURCE))
        }
    } else if MC_SAT_FIRST_RESOURCE == 0 && MC_SAT_FIRST_MODULE < 0 {
        MC_SAT_FIRST_MODULE = mc_find_saturating_module()
        mc_mark_parse_status(MC_SAT_FIRST_MODULE, mc_parse_status_for_resource(MC_SAT_FIRST_RESOURCE))
    }
}

fn print_module_closure_pre() with IO, Mut, Panic, Div {
    print("CLOSURE_BUNDLE_V1_PRE module_count=")
    print_int(MC_MOD_COUNT)
    print("CLOSURE_BUNDLE_V1_PRE src_total_bytes=")
    print_int(SRC_LEN)
    print("CLOSURE_BUNDLE_V1_PRE src_cap_bytes=")
    print_int(src_effective_cap())
    print("CLOSURE_BUNDLE_V1_PRE src_hard_cap_bytes=")
    print_int(src_hard_cap())
    print("CLOSURE_BUNDLE_V1_PRE total_requested_bytes=")
    print_int(MC_TOTAL_REQUESTED_BYTES)
    print("CLOSURE_BUNDLE_V1_PRE src_truncated=")
    print_int(MC_SRC_TRUNCATED)
    print("CLOSURE_BUNDLE_V1_PRE first_truncated_index=")
    print_int(MC_FIRST_TRUNCATED_INDEX)
    print("CLOSURE_BUNDLE_V1_PRE closure_hash=")
    print_int(MC_CLOSURE_HASH)
    var i: i64 = 0
    while i < MC_MOD_COUNT {
        print("CLOSURE_BUNDLE_V1_MODULE index=")
        print_int(i)
        print("CLOSURE_BUNDLE_V1_MODULE kind=")
        if MC_MOD_KIND[i as usize] == 0 { print("root") } else { print("import") }
        print("\n")
        print("CLOSURE_BUNDLE_V1_MODULE src_start=")
        print_int(MC_MOD_SRC_START[i as usize])
        print("CLOSURE_BUNDLE_V1_MODULE src_len=")
        print_int(MC_MOD_SRC_LEN[i as usize])
        print("CLOSURE_BUNDLE_V1_MODULE requested_len=")
        print_int(MC_MOD_REQ_LEN[i as usize])
        print("CLOSURE_BUNDLE_V1_MODULE path=")
        print_pool_slice(MC_MOD_PATH_OFF[i as usize], MC_MOD_PATH_LEN[i as usize])
        print("\n")
        i = i + 1
    }
}

fn print_mc_resource_name(resource: i64) with IO, Mut, Panic, Div {
    if resource == 0 { print("tk") }
    else if resource == 1 { print("nd") }
    else if resource == 2 { print("fn") }
    else if resource == 3 { print("st") }
    else if resource == 4 { print("fld") }
    else if resource == 5 { print("pool") }
    else if resource == 6 { print("code") }
    else if resource == 7 { print("en") }
    else if resource == 8 { print("name_bytes") }
    else if resource == 10 { print("name_slots") }
    else { print("none") }
}

fn print_mc_parse_status(status: i64) with IO, Mut, Panic, Div {
    if status == 0 { print("pending") }
    else if status == 1 { print("ok") }
    else if status == 2 { print("tk_sat") }
    else if status == 3 { print("nd_sat") }
    else if status == 4 { print("fn_sat") }
    else if status == 5 { print("st_sat") }
    else if status == 6 { print("fld_sat") }
    else if status == 7 { print("pool_sat") }
    else if status == 8 { print("code_sat") }
    else if status == 9 { print("en_sat") }
    else if status == 10 { print("boundary_eof") }
    else if status == 11 { print("name_bytes_sat") }
    else if status == 12 { print("name_slots_sat") }
    else { print("unknown") }
}

fn print_mc_exec_state(state: i64) with IO, Mut, Panic, Div {
    if state == 0 { print("closure_only") }
    else if state == 1 { print("lexed") }
    else if state == 2 { print("parsed") }
    else { print("unknown") }
}

fn print_fn_body_state(state: i64) with IO, Mut, Panic, Div {
    if state == 1 { print("full") }
    else if state == 2 { print("deferred") }
    else if state == 3 { print("stub") }
    else if state == 4 { print("skipped") }
    else if state == 5 { print("materialized_on_demand") }
    else { print("unknown") }
}

fn print_fixup_kind(kind: i64) with IO, Mut, Panic, Div {
    if kind == 1 { print("call") }
    else if kind == 2 { print("fn_addr") }
    else { print("unknown") }
}

fn print_fixup_locality(locality: i64) with IO, Mut, Panic, Div {
    if locality == 1 { print("local") }
    else if locality == 2 { print("external") }
    else { print("unknown") }
}

fn print_reloc_patch_state(state: i64) with IO, Mut, Panic, Div {
    if state == 1 { print("pending") }
    else if state == 2 { print("patched_immediate") }
    else if state == 3 { print("patched_late") }
    else if state == 4 { print("elided") }
    else if state == 5 { print("overflow") }
    else { print("unknown") }
}

fn print_mc_phase_name(phase: i64) with IO, Mut, Panic, Div {
    if phase == 1 { print("closure") }
    else if phase == 2 { print("lex") }
    else if phase == 3 { print("struct_scan") }
    else if phase == 4 { print("enum_scan") }
    else if phase == 5 { print("parse") }
    else if phase == 6 { print("codegen") }
    else if phase == 7 { print("patch") }
    else { print("none") }
}

fn print_mc_resolution_kind(kind: i64) with IO, Mut, Panic, Div {
    if kind == 0 { print("root") }
    else if kind == 1 { print("namespaced") }
    else if kind == 2 { print("compiler_flat") }
    else { print("unknown") }
}

fn print_mc_module_path(module_idx: i64) with IO, Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT {
        print("<none>")
        return
    }
    print_pool_slice(MC_MOD_PATH_OFF[module_idx as usize], MC_MOD_PATH_LEN[module_idx as usize])
}

fn print_module_usage_line(label: string, used: i64, cap: i64) with IO, Mut, Panic, Div {
    var pct: i64 = 0
    if cap > 0 { pct = (used * 100) / cap }
    print("CLOSURE_BUNDLE_V2 ")
    print(label)
    print("_used=")
    print_int(used)
    print(" ")
    print(label)
    print("_cap=")
    print_int(cap)
    print(" ")
    print(label)
    print("_pct=")
    print_int(pct)
    print("\n")
}

