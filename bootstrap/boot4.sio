            emit(0x48); emit(0x89); emit(0xC7)  // mov rdi, rax
            emit_load_rax(rb_s1)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0x04); emit(0x07)  // movzx rax, byte [rdi+rax]
            return 0
        }

        // print_char(ch) → write single byte to stdout
        if pool_match(c_off, c_len, "print_char") {
            let pc_arg = ND_EXTRA[node as usize]
            if pc_arg != -1 { compile_node(pc_arg) }
            let pc_s = alloc_slot()
            emit_store_rax(pc_s)
            emit_lea_rax(pc_s)
            emit(0x48); emit(0x89); emit(0xC6)  // mov rsi, rax
            emit(0xBA); emit_u32(1)              // mov edx, 1
            emit(0xBF); emit_u32(1)              // mov edi, 1
            emit(0xB8); emit_u32(1)              // mov eax, SYS_write
            emit(0x0F); emit(0x05)               // syscall
            return 0
        }

        if pool_match(c_off, c_len, "print") {
            let arg = ND_EXTRA[node as usize]
            if arg != -1 {
                compile_node(arg)
                // rax = pointer to string; compute strlen at runtime
                emit(0x48); emit(0x89); emit(0xC6)  // mov rsi, rax  (save ptr)
                // inline strlen: rdi = ptr, rcx = 0, scan until null
                emit(0x48); emit(0x89); emit(0xC7)  // mov rdi, rax
                emit(0x31); emit(0xC9)              // xor ecx, ecx
                // loop: cmp byte [rdi+rcx], 0; je done; inc rcx; jmp loop
                emit(0x80); emit(0x3C); emit(0x0F); emit(0x00)  // cmp byte [rdi+rcx], 0
                emit(0x74); emit(0x04)              // je +4
                emit(0x48); emit(0xFF); emit(0xC1)  // inc rcx
                emit(0xEB); emit(0xF5)              // jmp -11
                emit(0x48); emit(0x89); emit(0xCA)  // mov rdx, rcx  (length)
                emit(0xBF); emit_u32(1)             // mov edi, 1
                emit(0xB8); emit_u32(1)             // mov eax, 1
                emit(0x0F); emit(0x05)              // syscall
            }
            emit_mov_rax_imm(0)
            return 0
