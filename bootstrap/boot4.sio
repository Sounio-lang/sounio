fn classify_keyword(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    if len == 2 {
        if source_range_match_string(off, len, "fn") { return 50 }
        if source_range_match_string(off, len, "if") { return 53 }
        if source_range_match_string(off, len, "as") { return 65 }
    } else if len == 3 {
        if source_range_match_string(off, len, "let") { return 51 }
        if source_range_match_string(off, len, "var") { return 52 }
        if source_range_match_string(off, len, "for") { return 55 }
    } else if len == 4 {
        if source_range_match_string(off, len, "else") { return 54 }
        if source_range_match_string(off, len, "true") { return 61 }
        if source_range_match_string(off, len, "with") { return 66 }
        if source_range_match_string(off, len, "None") { return 68 }
        if source_range_match_string(off, len, "Some") { return 67 }
        if source_range_match_string(off, len, "self") { return 1 }
        if source_range_match_string(off, len, "Self") { return 1 }
        if source_range_match_string(off, len, "type") { return 1 }
        if source_range_match_string(off, len, "impl") { return 60 }
        if source_range_match_string(off, len, "enum") { return 59 }
        if source_range_match_string(off, len, "loop") { return 55 }
    } else if len == 5 {
        if source_range_match_string(off, len, "while") { return 55 }
        if source_range_match_string(off, len, "break") { return 63 }
        if source_range_match_string(off, len, "false") { return 62 }
        if source_range_match_string(off, len, "match") { return 57 }
    } else if len == 6 {
        if source_range_match_string(off, len, "return") { return 56 }
        if source_range_match_string(off, len, "struct") { return 58 }
        if source_range_match_string(off, len, "module") { return 1 }
        if source_range_match_string(off, len, "linear") { return 1 }
    } else if len == 8 {
        if source_range_match_string(off, len, "continue") { return 64 }
    }
    0
}

// ============================================================================
// Lexer
// ============================================================================

fn add_token(kind: i64, start: i64, end: i64, ival: i64) with Mut, Panic {
    if TK_COUNT >= tk_cap() {
        mc_note_saturation(0, mc_module_for_src_offset(start))
        return
    }
    let idx = TK_COUNT
    TK_KIND[idx as usize] = kind
    TK_START[idx as usize] = start
    TK_END[idx as usize] = end
    TK_IVAL[idx as usize] = ival
    TK_COUNT = TK_COUNT + 1
}

fn lex_current_slice() with Mut, Panic, Div {
    let module_idx = MC_CUR_MODULE_IDX
    if module_idx >= 0 && module_idx < MC_MOD_COUNT {
        MC_MOD_LEX_CALLS[module_idx as usize] = MC_MOD_LEX_CALLS[module_idx as usize] + 1
        if MC_MOD_KIND[module_idx as usize] == 0 {
            MC_CUR_USE_LIVE_SRC = 1
            MC_CUR_FROZEN_OFF = 0
            MC_CUR_FROZEN_LEN = MC_MOD_SRC_LEN[module_idx as usize]
            MC_MOD_FROZEN_OFF[module_idx as usize] = 0
            MC_MOD_FROZEN_LEN[module_idx as usize] = MC_CUR_FROZEN_LEN
        } else {
            MC_CUR_USE_LIVE_SRC = 0
            MC_CUR_FROZEN_OFF = MC_MOD_FROZEN_OFF[module_idx as usize]
            MC_CUR_FROZEN_LEN = MC_MOD_FROZEN_LEN[module_idx as usize]
        }
        if MC_MOD_SRC_LEN[module_idx as usize] > 0 {
            MC_MOD_FIRST_BYTE[module_idx as usize] = src_byte_in_current_slice(MC_CUR_SLICE_START)
        } else {
            MC_MOD_FIRST_BYTE[module_idx as usize] = -1
        }
        MC_MOD_TK_START[module_idx as usize] = TK_COUNT
        MC_MOD_TK_END[module_idx as usize] = TK_COUNT
    }
    var p: i64 = MC_CUR_SLICE_START
    while p < MC_CUR_SLICE_END {
        MC_LAST_SRC_POS_HINT = p
        let ch = src_byte_in_current_slice(p)
        if is_ws(ch) {
            p = p + 1
            continue
        }
        if ch == 47 && src_byte_in_current_slice(p + 1) == 47 {
            p = p + 2
            while p < MC_CUR_SLICE_END && src_byte_in_current_slice(p) != 10 {
                p = p + 1
            }
            continue
        }
        if is_digit(ch) {
            let start = p
            var val: i64 = 0
            if ch == 48 && p + 1 < MC_CUR_SLICE_END && src_byte_in_current_slice(p + 1) == 120 {
                p = p + 2
                while p < MC_CUR_SLICE_END {
                    let hc = src_byte_in_current_slice(p)
                    if hc >= 48 && hc <= 57 {
                        val = val * 16 + (hc - 48)
                        p = p + 1
                    } else if hc >= 65 && hc <= 70 {
                        val = val * 16 + (hc - 55)
                        p = p + 1
                    } else if hc >= 97 && hc <= 102 {
                        val = val * 16 + (hc - 87)
                        p = p + 1
                    } else {
                        break
                    }
                }
            } else {
                while p < MC_CUR_SLICE_END && is_digit(src_byte_in_current_slice(p)) {
                    val = val * 10 + (src_byte_in_current_slice(p) - 48)
                    p = p + 1
                }
                // Float literal: consume .digits[eE[+-]digits] — emit as TK_INT(0)
                if p < MC_CUR_SLICE_END && src_byte_in_current_slice(p) == 46 && p + 1 < MC_CUR_SLICE_END && is_digit(src_byte_in_current_slice(p + 1)) {
                    p = p + 1
                    while p < MC_CUR_SLICE_END && is_digit(src_byte_in_current_slice(p)) { p = p + 1 }
                    if p < MC_CUR_SLICE_END && (src_byte_in_current_slice(p) == 101 || src_byte_in_current_slice(p) == 69) {
                        p = p + 1
                        if p < MC_CUR_SLICE_END && (src_byte_in_current_slice(p) == 43 || src_byte_in_current_slice(p) == 45) { p = p + 1 }
                        while p < MC_CUR_SLICE_END && is_digit(src_byte_in_current_slice(p)) { p = p + 1 }
                    }
                    val = 0
                }
            }
            add_token(2, start, p, val)
            continue
        }
        if is_alpha(ch) {
            let start = p
            while p < MC_CUR_SLICE_END && is_alnum(src_byte_in_current_slice(p)) {
                p = p + 1
            }
            let ilen = p - start
            let kw = classify_keyword(start, ilen)
            if kw != 0 {
                add_token(kw, start, p, 0)
            } else {
                add_token(1, start, p, start)
            }
            continue
        }
        if ch == 34 {
            p = p + 1
            let start = p
            let pool_start = POOL_POS
            while p < MC_CUR_SLICE_END && src_byte_in_current_slice(p) != 34 {
                if src_byte_in_current_slice(p) == 92 {
                    p = p + 1
                    let esc = src_byte_in_current_slice(p)
                    if esc == 110 { pool_add(10) }
                    else if esc == 116 { pool_add(9) }
                    else if esc == 92 { pool_add(92) }
                    else if esc == 34 { pool_add(34) }
                    else if esc == 48 { pool_add(0) }
                    else { pool_add(esc) }
                } else {
                    pool_add(src_byte_in_current_slice(p))
                }
                p = p + 1
            }
            let slen = POOL_POS - pool_start
            p = p + 1
            add_token(3, start, p, pool_start)
            TK_END[(TK_COUNT - 1) as usize] = slen
            continue
        }
        let ch2 = src_byte_in_current_slice(p + 1)
        if ch == 38 && ch2 == 38 { add_token(20, p, p + 2, 0); p = p + 2; continue }
        if ch == 124 && ch2 == 124 { add_token(21, p, p + 2, 0); p = p + 2; continue }
        if ch == 61 && ch2 == 61 { add_token(23, p, p + 2, 0); p = p + 2; continue }
        if ch == 33 && ch2 == 61 { add_token(24, p, p + 2, 0); p = p + 2; continue }
        if ch == 60 && ch2 == 61 { add_token(26, p, p + 2, 0); p = p + 2; continue }
        if ch == 62 && ch2 == 61 { add_token(28, p, p + 2, 0); p = p + 2; continue }
        if ch == 60 && ch2 == 60 { add_token(18, p, p + 2, 0); p = p + 2; continue }
        if ch == 62 && ch2 == 62 { add_token(19, p, p + 2, 0); p = p + 2; continue }
        if ch == 45 && ch2 == 62 { add_token(42, p, p + 2, 0); p = p + 2; continue }
        if ch == 38 && ch2 == 33 { add_token(70, p, p + 2, 0); p = p + 2; continue }
        if ch == 58 && ch2 == 58 { add_token(41, p, p + 2, 0); p = p + 2; continue }
        if ch == 46 && ch2 == 46 { add_token(43, p, p + 2, 0); p = p + 2; continue }
        // => fat arrow (must come before single =)
        if ch == 61 && ch2 == 62 { add_token(79, p, p + 2, 0); p = p + 2; continue }
        if ch == 43 { add_token(10, p, p + 1, 0); p = p + 1; continue }
        if ch == 45 { add_token(11, p, p + 1, 0); p = p + 1; continue }
        if ch == 42 { add_token(12, p, p + 1, 0); p = p + 1; continue }
        if ch == 47 { add_token(13, p, p + 1, 0); p = p + 1; continue }
        if ch == 37 { add_token(14, p, p + 1, 0); p = p + 1; continue }
        if ch == 38 { add_token(15, p, p + 1, 0); p = p + 1; continue }
        if ch == 124 { add_token(16, p, p + 1, 0); p = p + 1; continue }
        if ch == 94 { add_token(17, p, p + 1, 0); p = p + 1; continue }
        if ch == 33 { add_token(22, p, p + 1, 0); p = p + 1; continue }
        if ch == 126 { add_token(71, p, p + 1, 0); p = p + 1; continue }
        if ch == 61 { add_token(30, p, p + 1, 0); p = p + 1; continue }
        if ch == 40 { add_token(31, p, p + 1, 0); p = p + 1; continue }
        if ch == 41 { add_token(32, p, p + 1, 0); p = p + 1; continue }
        if ch == 123 { add_token(33, p, p + 1, 0); p = p + 1; continue }
        if ch == 125 { add_token(34, p, p + 1, 0); p = p + 1; continue }
        if ch == 91 { add_token(35, p, p + 1, 0); p = p + 1; continue }
        if ch == 93 { add_token(36, p, p + 1, 0); p = p + 1; continue }
        if ch == 44 { add_token(37, p, p + 1, 0); p = p + 1; continue }
        if ch == 58 { add_token(38, p, p + 1, 0); p = p + 1; continue }
        if ch == 59 { add_token(39, p, p + 1, 0); p = p + 1; continue }
        if ch == 46 { add_token(40, p, p + 1, 0); p = p + 1; continue }
        if ch == 60 { add_token(25, p, p + 1, 0); p = p + 1; continue }
        if ch == 62 { add_token(27, p, p + 1, 0); p = p + 1; continue }
        p = p + 1
    }
    if module_idx >= 0 && module_idx < MC_MOD_COUNT {
        MC_MOD_TK_END[module_idx as usize] = TK_COUNT
        if TK_COUNT > MC_MOD_TK_START[module_idx as usize] {
            mc_mark_exec_state(module_idx, 1)
            if MC_MOD_PARSE_STATUS[module_idx as usize] == 0 {
                MC_MOD_PARSE_STATUS[module_idx as usize] = 1
            }
        }
    }
}

fn lex() with Mut, Panic, Div {
    if MC_MOD_COUNT <= 0 {
        MC_CUR_SLICE_START = 0
        MC_CUR_SLICE_END = SRC_LEN
        MC_CUR_MODULE_IDX = -1
        MC_CUR_USE_LIVE_SRC = 1
        lex_current_slice()
    } else {
        MC_CUR_MODULE_IDX = 0
        while MC_CUR_MODULE_IDX < MC_MOD_COUNT {
            MC_CUR_SLICE_START = MC_MOD_SRC_START[MC_CUR_MODULE_IDX as usize]
            MC_CUR_SLICE_END = MC_CUR_SLICE_START + MC_MOD_SRC_LEN[MC_CUR_MODULE_IDX as usize]
            lex_current_slice()
            MC_CUR_MODULE_IDX = MC_CUR_MODULE_IDX + 1
        }
        MC_CUR_MODULE_IDX = -1
    }
    add_token(0, SRC_LEN, SRC_LEN, 0)
}

// ============================================================================
// Parser helpers
// ============================================================================

fn parse_window_eof() -> i64 with Panic {
    if MC_PARSE_LIMIT >= 0 && POS >= MC_PARSE_LIMIT && POS < TK_COUNT { return 1 }
    0
}

fn parse_window_src_end() -> i64 with Panic {
    if MC_PARSE_WINDOW_MODULE >= 0 && MC_PARSE_WINDOW_MODULE < MC_MOD_COUNT {
        return MC_MOD_SRC_START[MC_PARSE_WINDOW_MODULE as usize] + MC_MOD_SRC_LEN[MC_PARSE_WINDOW_MODULE as usize]
    }
    SRC_LEN
}

fn parser_begin_module_window(module_idx: i64) with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    POS = MC_MOD_TK_START[module_idx as usize]
    MC_PARSE_LIMIT = MC_MOD_TK_END[module_idx as usize]
    MC_PARSE_WINDOW_MODULE = module_idx
    MC_PARSE_SEGMENTED = 1
    MC_MOD_PARSE_CALLS[module_idx as usize] = MC_MOD_PARSE_CALLS[module_idx as usize] + 1
}

fn parser_finish_module_window(module_idx: i64, start_pos: i64) with Mut, Panic, Div {
    if module_idx >= 0 && module_idx < MC_MOD_COUNT {
        let tk_cap_local = MC_MOD_TK_END[module_idx as usize] - MC_MOD_TK_START[module_idx as usize]
        var used = POS - start_pos
        if used < 0 { used = 0 }
        if used > tk_cap_local { used = tk_cap_local }
        MC_MOD_PARSE_TK_USED[module_idx as usize] = used
    }
    MC_PARSE_LIMIT = -1
    MC_PARSE_WINDOW_MODULE = -1
}

fn cur_kind() -> i64 with Panic {
    if parse_window_eof() == 1 { return 0 }
    if POS >= TK_COUNT { return 0 }
    TK_KIND[POS as usize]
}

fn cur_ival() -> i64 with Panic {
    if parse_window_eof() == 1 { return 0 }
    if POS >= TK_COUNT { return 0 }
    TK_IVAL[POS as usize]
}

fn cur_start() -> i64 with Panic {
    if parse_window_eof() == 1 { return parse_window_src_end() }
    if POS >= TK_COUNT { return SRC_LEN }
    TK_START[POS as usize]
}

fn cur_end() -> i64 with Panic {
    if parse_window_eof() == 1 { return parse_window_src_end() }
    if POS >= TK_COUNT { return SRC_LEN }
    TK_END[POS as usize]
}

fn advance() with Mut, Panic {
    POS = POS + 1
}

fn expect(kind: i64) with Mut, Panic {
    if cur_kind() != kind {
        let fail_src = cur_start()
        let got_kind = cur_kind()
        let fail_module = mc_module_for_parser_pos()
        mc_note_first_parse_fail(kind, got_kind, fail_module, fail_src)
        if parse_window_eof() == 1 {
            mc_note_boundary_mismatch(kind, fail_module, fail_src)
        }
        print("parse error: expected ")
        print_int(kind)
        print(" got ")
        print_int(got_kind)
        print(" at ")
        print_int(POS)
        print(" src=")
        print_int(fail_src)
        print(" module=")
        print_int(fail_module)
        print(" path=")
        print_mc_module_path(fail_module)
        print(" fn_count=")
        print_int(FN_COUNT)
        print(" st_count=")
        print_int(ST_COUNT)
        print(" en_count=")
        print_int(EN_COUNT)
        print(" nd_count=")
        print_int(ND_COUNT)
        print("\n")
    }
    advance()
}

fn new_node(kind: i64, ival: i64) -> i64 with Mut, Panic {
    let idx = ND_COUNT
    if idx >= nd_cap() {
        print("NODE OVERFLOW idx=")
        print_int(idx)
        print("\n")
        mc_note_saturation(1, mc_module_for_parser_pos())
        let sink = nd_sink_idx()
        ND_KIND[sink as usize] = kind
        ND_IVAL[sink as usize] = ival
        ND_LEFT[sink as usize] = -1
        ND_RIGHT[sink as usize] = -1
        ND_EXTRA[sink as usize] = -1
        ND_EXTRA2[sink as usize] = -1
        ND_STR_OFF[sink as usize] = 0
        ND_STR_LEN[sink as usize] = 0
        return sink
    }
    ND_KIND[idx as usize] = kind
    ND_IVAL[idx as usize] = ival
    ND_LEFT[idx as usize] = -1
    ND_RIGHT[idx as usize] = -1
    ND_EXTRA[idx as usize] = -1
    ND_EXTRA2[idx as usize] = -1
    ND_STR_OFF[idx as usize] = 0
    ND_STR_LEN[idx as usize] = 0
    ND_COUNT = ND_COUNT + 1
    idx
}

fn tok_pool_off() -> i64 with Mut, Panic, Div {
    if POS >= TK_COUNT { return 0 }
    if TK_KIND[POS as usize] == 1 {
        let cached = TK_IVAL[POS as usize]
        if cached < 0 { return 0 - cached - 1 }
        let start = TK_START[POS as usize]
        let len = TK_END[POS as usize] - start
        let interned = name_pool_intern_source_range(start, len)
        TK_IVAL[POS as usize] = 0 - interned - 1
        return interned
    }
    TK_IVAL[POS as usize]
}

fn tok_ident_len() -> i64 with Panic {
    if POS >= TK_COUNT { return 0 }
    TK_END[POS as usize] - TK_START[POS as usize]
}

// ============================================================================
// Struct table helpers
// ============================================================================

fn find_struct_b4(name_off: i64, name_len: i64) -> i64 with Mut, Panic, Div {
    var si: i64 = 0
    while si < ST_COUNT {
        if ST_NAME_LEN[si as usize] == name_len {
            var ok: i64 = 1
            var i: i64 = 0
            while i < name_len {
                if text_byte(ST_NAME_OFF[si as usize], i) != text_byte(name_off, i) {
                    ok = 0
                }
                i = i + 1
            }
            if ok == 1 { return si }
        }
        si = si + 1
    }
    -1
}

// ============================================================================
// Enum table helpers
// ============================================================================

fn find_enum_b4(name_off: i64, name_len: i64) -> i64 with Mut, Panic, Div {
    var ei: i64 = 0
    while ei < EN_COUNT {
        if EN_NAME_LEN[ei as usize] == name_len {
            var ok: i64 = 1
            var i: i64 = 0
            while i < name_len {
                if text_byte(EN_NAME_OFF[ei as usize], i) != text_byte(name_off, i) {
                    ok = 0
                }
                i = i + 1
            }
            if ok == 1 { return ei }
        }
        ei = ei + 1
    }
    -1
}

fn find_enum_variant(ei: i64, vname_off: i64, vname_len: i64) -> i64 with Mut, Panic, Div {
    let base = EN_FIRST_VARIANT[ei as usize]
    let vc = EN_VARIANT_COUNT[ei as usize]
    var vi: i64 = 0
    while vi < vc {
        let evi = base + vi
        if EV_NAME_LEN[evi as usize] == vname_len {
            var ok: i64 = 1
            var k: i64 = 0
            while k < vname_len {
                if text_byte(EV_NAME_OFF[evi as usize], k) != text_byte(vname_off, k) {
                    ok = 0
                }
                k = k + 1
            }
            if ok == 1 { return EV_VALUE[evi as usize] }
        }
        vi = vi + 1
    }
    -1
}

// Look up "EnumName::Variant" from a qualified pool string (contains "::" separator).
// Returns the variant's integer discriminant, or -1 if not found.
fn en_lookup_qualified(pool_off: i64, pool_len: i64) -> i64 with Mut, Panic, Div {
    // Find "::" in the pool string
    var sep: i64 = -1
    var i: i64 = 0
    while i < pool_len - 1 {
        if text_byte(pool_off, i) == 58 && text_byte(pool_off, i + 1) == 58 {
            sep = i
            i = pool_len  // break
        }
        i = i + 1
    }
    if sep < 0 { return -1 }
    let enum_off = pool_off
    let enum_len = sep
    let var_off = pool_off + sep + 2
    let var_len = pool_len - sep - 2
    let ei = find_enum_b4(enum_off, enum_len)
    if ei < 0 { return -1 }
    find_enum_variant(ei, var_off, var_len)
}

fn find_field_b4(si: i64, fname_off: i64, fname_len: i64) -> i64 with Mut, Panic, Div {
    let fi_base = ST_FIELD_FIRST[si as usize]
    let fc = ST_FIELD_COUNT[si as usize]
    var j: i64 = 0
    while j < fc {
        let fj = fi_base + j
        if FLD_NAME_LEN[fj as usize] == fname_len {
            var ok: i64 = 1
            var k: i64 = 0
            while k < fname_len {
                if text_byte(FLD_NAME_OFF[fj as usize], k) != text_byte(fname_off, k) {
                    ok = 0
                }
                k = k + 1
            }
            if ok == 1 { return j }
        }
        j = j + 1
    }
    -1
}

fn struct_total_slots(si: i64) -> i64 with Mut, Panic, Div {
    let fc = ST_FIELD_COUNT[si as usize]
    let fi_base = ST_FIELD_FIRST[si as usize]
    var total: i64 = 0
    var i: i64 = 0
    while i < fc {
        total = total + FLD_SLOT_COUNT[(fi_base + i) as usize]
        i = i + 1
    }
    total
}

fn find_field_slot_offset(si: i64, fname_off: i64, fname_len: i64) -> i64 with Mut, Panic, Div {
    let fc = ST_FIELD_COUNT[si as usize]
    let fi_base = ST_FIELD_FIRST[si as usize]
    var slot_off: i64 = 0
    var i: i64 = 0
    while i < fc {
        let fj = fi_base + i
        if FLD_NAME_LEN[fj as usize] == fname_len {
            var ok: i64 = 1
            var k: i64 = 0
            while k < fname_len {
                if text_byte(FLD_NAME_OFF[fj as usize], k) != text_byte(fname_off, k) { ok = 0 }
                k = k + 1
            }
            if ok == 1 {
                LAST_FIELD_TYPE_SI = FLD_TYPE_SI[fj as usize]
                LAST_FIELD_SLOT_COUNT = FLD_SLOT_COUNT[fj as usize]
                return slot_off
            }
        }
        slot_off = slot_off + FLD_SLOT_COUNT[fj as usize]
        i = i + 1
    }
    LAST_FIELD_TYPE_SI = -1
    LAST_FIELD_SLOT_COUNT = 1
    -1
}

fn field_slot_width_by_offset(si: i64, target_slot_off: i64) -> i64 with Mut, Panic, Div {
    let fc = ST_FIELD_COUNT[si as usize]
    let fi_base = ST_FIELD_FIRST[si as usize]
    var slot_off: i64 = 0
    var i: i64 = 0
    while i < fc {
        let fj = fi_base + i
        let width = FLD_SLOT_COUNT[fj as usize]
        if slot_off == target_slot_off { return width }
        slot_off = slot_off + width
        i = i + 1
    }
    1
}

// ============================================================================
// Parser: type skipping
// ============================================================================

fn skip_type_expr() with Mut, Panic, Div {
    if cur_kind() == 15 {
        advance()
        skip_type_expr()
    } else if cur_kind() == 70 {
        advance()
        skip_type_expr()
    } else if cur_kind() == 35 {
        advance()
        skip_type_expr()
        if cur_kind() == 39 { advance() }
        if cur_kind() == 2 { advance() }
        if cur_kind() == 36 { advance() }
    } else if cur_kind() == 31 {
        advance()
        while cur_kind() != 32 && cur_kind() != 0 {
            skip_type_expr()
            if cur_kind() == 37 { advance() }
        }
        if cur_kind() == 32 { advance() }
    } else if cur_kind() == 50 {
        // Sprint 229: fn(T1, T2, ...) -> U  function type
        advance()
        if cur_kind() == 31 {
            advance()
            while cur_kind() != 32 && cur_kind() != 0 {
                skip_type_expr()
                if cur_kind() == 37 { advance() }
            }
            if cur_kind() == 32 { advance() }
        }
        // -> ReturnType
        if cur_kind() == 42 { advance(); skip_type_expr() }
    } else if cur_kind() == 1 || cur_kind() >= 50 {
        advance()
        // Consume :: path extensions (e.g. TokenKind::Eof, std::vec::Vec)
        while cur_kind() == 41 {
            advance()
            if cur_kind() == 1 { advance() }
        }
        if cur_kind() == 25 {
            advance()
            var depth: i64 = 1
            while depth > 0 && cur_kind() != 0 {
                if cur_kind() == 25 { depth = depth + 1 }
                else if cur_kind() == 27 { depth = depth - 1 }
                else if cur_kind() == 19 { depth = depth - 2 }  // '>>' lexed as SHR = two closing >
                if depth > 0 { advance() }
            }
            if cur_kind() == 27 { advance() }
            else if cur_kind() == 19 { advance() }  // consume '>>' as closing outer >
        }
    } else if cur_kind() == 2 {
        advance()
    }
}

fn skip_type_annotation() with Mut, Panic, Div {
    if cur_kind() == 38 {
        advance()
        skip_type_expr()
    }
}

// ============================================================================
// Parser: expressions
// ============================================================================

fn binop_prec(kind: i64) -> i64 {
    if kind == 21 { 1 }
    else if kind == 20 { 2 }
    else if kind == 16 { 3 }
    else if kind == 17 { 4 }
    else if kind == 15 { 5 }
    else if kind == 23 || kind == 24 { 6 }
    else if kind == 25 || kind == 26 || kind == 27 || kind == 28 { 7 }
    else if kind == 18 || kind == 19 { 8 }
    else if kind == 10 || kind == 11 { 9 }
    else if kind == 12 || kind == 13 || kind == 14 { 10 }
    else { 0 }
}

fn tok_to_binop(kind: i64) -> i64 {
    if kind == 10 { 0 }
    else if kind == 11 { 1 }
    else if kind == 12 { 2 }
    else if kind == 13 { 3 }
    else if kind == 14 { 4 }
    else if kind == 23 { 5 }
    else if kind == 24 { 6 }
    else if kind == 25 { 7 }
    else if kind == 26 { 8 }
    else if kind == 27 { 9 }
    else if kind == 28 { 10 }
    else if kind == 20 { 11 }
    else if kind == 21 { 12 }
    else if kind == 15 { 13 }
    else if kind == 16 { 14 }
    else if kind == 17 { 15 }
    else if kind == 18 { 16 }
    else if kind == 19 { 17 }
    else { -1 }
}

fn parse_block() -> i64 with Mut, Panic, Div {
    expect(33)
    let block_node = new_node(33, 0)
    var first: i64 = -1
    var last: i64 = -1
    while cur_kind() != 34 && cur_kind() != 0 {
        let stmt = parse_stmt()
        if first == -1 {
            first = stmt
        } else {
            ND_RIGHT[last as usize] = stmt
        }
        last = stmt
        if cur_kind() == 39 { advance() }
    }
    expect(34)
    ND_LEFT[block_node as usize] = first
    block_node
}

fn make_stub_body_return_zero() -> i64 with Mut, Panic {
    let block_node = new_node(33, 0)
    let zero_node = new_node(4, 0)
    let ret_node = new_node(34, 0)
    ND_LEFT[ret_node as usize] = zero_node
    ND_LEFT[block_node as usize] = ret_node
    block_node
}

fn parse_args() -> i64 with Mut, Panic, Div {
    var first: i64 = -1
    var last: i64 = -1
    while cur_kind() != 32 && cur_kind() != 0 {
        let arg = parse_expr(0)
        if first == -1 {
            first = arg
        } else {
            ND_EXTRA[last as usize] = arg
        }
        last = arg
        if cur_kind() == 37 { advance() }
    }
    first
}

fn parse_match_expr() -> i64 with Mut, Panic, Div {
    advance()
    let scr = parse_expr(0)
    let match_node = new_node(44, 0)
    ND_LEFT[match_node as usize] = scr
    if cur_kind() == 33 { advance() }
    var first_arm: i64 = -1
    var last_arm: i64 = -1
    while cur_kind() != 34 && cur_kind() != 0 {
        let arm = new_node(45, 0)
        let pk = cur_kind()
        if pk == 2 {
            ND_IVAL[arm as usize] = 0
            ND_STR_OFF[arm as usize] = cur_ival()
            advance()
        } else if pk == 68 {
            ND_IVAL[arm as usize] = 2
            advance()
        } else if pk == 67 {
            ND_IVAL[arm as usize] = 3
            advance()
            if cur_kind() == 31 {
                advance()
                ND_STR_OFF[arm as usize] = tok_pool_off()
                ND_STR_LEN[arm as usize] = tok_ident_len()
                advance()
                if cur_kind() == 32 { advance() }
            }
        } else if pk == 1 {
            let poff = tok_pool_off()
            let plen = tok_ident_len()
            if pool_match(poff, plen, "_") {
                ND_IVAL[arm as usize] = 1
                advance()
            } else {
                // Check for Enum::Variant pattern
                advance()
                if cur_kind() == 41 {
                    // Ident followed by :: — parse as EnumName::Variant
                    let enum_ei = find_enum_b4(poff, plen)
                    advance()  // skip ::
                    if cur_kind() == 1 {
                        let voff = tok_pool_off()
                        let vlen = tok_ident_len()
                        advance()  // skip variant name
                        if enum_ei >= 0 {
                            let disc = find_enum_variant(enum_ei, voff, vlen)
                            ND_IVAL[arm as usize] = 4
                            ND_STR_OFF[arm as usize] = disc
                        } else {
                            ND_IVAL[arm as usize] = 1
                        }
                    } else {
                        ND_IVAL[arm as usize] = 1
                    }
                } else {
                    // Plain identifier — treat as wildcard
                    ND_IVAL[arm as usize] = 1
                }
            }
        } else {
            ND_IVAL[arm as usize] = 1
            advance()
        }
        if cur_kind() == 79 { advance() }
        if cur_kind() == 33 {
            let b2 = parse_block()
            ND_EXTRA[arm as usize] = b2
        } else {
            let e2 = parse_expr(0)
            ND_EXTRA[arm as usize] = e2
        }
        if cur_kind() == 37 { advance() }
        if first_arm == -1 {
            first_arm = arm
        } else {
            ND_RIGHT[last_arm as usize] = arm
        }
        last_arm = arm
    }
    if cur_kind() == 34 { advance() }
    ND_EXTRA[match_node as usize] = first_arm
    match_node
}

fn parse_struct_literal(ident_node: i64, si: i64) -> i64 with Mut, Panic, Div {
    if cur_kind() == 33 { advance() }
    let slit = new_node(47, si)
    var first_fi: i64 = -1
    var last_fi: i64 = -1
    while cur_kind() != 34 && cur_kind() != 0 {
        if cur_kind() == 1 {
            let fn_off = tok_pool_off()
            let fn_len = tok_ident_len()
            advance()
            if cur_kind() == 38 { advance() }
            let fval = parse_expr(0)
            let fi_idx = find_field_slot_offset(si, fn_off, fn_len)
            let fnode3 = new_node(48, fi_idx)
            ND_LEFT[fnode3 as usize] = fval
            if first_fi == -1 { first_fi = fnode3 } else { ND_RIGHT[last_fi as usize] = fnode3 }
            last_fi = fnode3
            if cur_kind() == 37 { advance() }
        } else {
            advance()
        }
    }
    if cur_kind() == 34 { advance() }
    ND_EXTRA[slit as usize] = first_fi
    slit
}

fn parse_expr(min_prec: i64) -> i64 with Mut, Panic, Div {
    var left: i64 = -1
    let k = cur_kind()
    var just_cast_to_ptr: i64 = 0

    if k == 2 {
        left = new_node(1, cur_ival())
        advance()
    } else if k == 3 {
        left = new_node(3, 0)
        ND_STR_OFF[left as usize] = cur_ival()
        ND_STR_LEN[left as usize] = cur_end()
        advance()
    } else if k == 61 {
        left = new_node(4, 1)
        advance()
    } else if k == 62 {
        left = new_node(4, 0)
        advance()
    } else if k == 68 {
        left = new_node(1, 0)
        advance()
    } else if k == 67 {
        advance()
        if cur_kind() == 31 {
            advance()
            left = parse_expr(0)
            if cur_kind() == 32 { advance() }
        } else {
            left = new_node(1, 0)
        }
    } else if k == 1 {
        let off = tok_pool_off()
        let ilen = tok_ident_len()
        left = new_node(2, 0)
        ND_STR_OFF[left as usize] = off
        ND_STR_LEN[left as usize] = ilen
        advance()
        // Consume :: path — build qualified name "A::B" for static method calls
        while cur_kind() == 41 {
            advance()  // skip ::
            if cur_kind() == 1 {
                let seg_off = tok_pool_off()
                let seg_len = tok_ident_len()
                // build "prev::seg" in pool; update left node to use qualified name
                let q_off = pool_concat_colon(ND_STR_OFF[left as usize], ND_STR_LEN[left as usize], seg_off, seg_len)
                let q_len = ND_STR_LEN[left as usize] + 2 + seg_len
                ND_STR_OFF[left as usize] = q_off
                ND_STR_LEN[left as usize] = q_len
                advance()
            }
        }
        if cur_kind() == 31 {
            advance()
            let args = parse_args()
            expect(32)
            let call_node = new_node(12, 0)
            ND_LEFT[call_node as usize] = left
            ND_EXTRA[call_node as usize] = args
            left = call_node
        } else if cur_kind() == 33 {
            let si_check = find_struct_b4(off, ilen)
            if si_check >= 0 {
                left = parse_struct_literal(left, si_check)
            }
        }
    } else if k == 31 {
        advance()
        left = parse_expr(0)
        // Handle tuple expressions: (a, b, c) — keep first, skip rest
        while cur_kind() == 37 {
            advance()
            parse_expr(0)
        }
        expect(32)
    } else if k == 11 {
        advance()
        let operand = parse_expr(10)
        left = new_node(11, 1)
        ND_LEFT[left as usize] = operand
    } else if k == 22 {
        advance()
        let operand = parse_expr(10)
        left = new_node(11, 0)
        ND_LEFT[left as usize] = operand
    } else if k == 71 {
        advance()
        let operand = parse_expr(10)
        left = new_node(11, 2)
        ND_LEFT[left as usize] = operand
    } else if k == 12 {
        advance()
        let operand = parse_expr(11)
        left = new_node(46, 0)
        ND_LEFT[left as usize] = operand
    } else if k == 15 {
        advance()
        let operand = parse_expr(18)
        left = new_node(49, 0)
        ND_LEFT[left as usize] = operand
    } else if k == 70 {
        advance()
        let operand = parse_expr(18)
        left = new_node(49, 0)
        ND_LEFT[left as usize] = operand
    } else if k == 57 {
        left = parse_match_expr()
    } else if k == 33 {
        left = parse_block()
    } else if k == 53 {
        left = parse_if_expr()
    } else if k == 55 {
        left = parse_while_expr()
    } else if k == 35 {
        advance()
        let fill_val = parse_expr(0)
        var arr_count: i64 = 1
        if cur_kind() == 39 {
            advance()
            if cur_kind() == 2 {
                arr_count = cur_ival()
                advance()
            }
        }
        if cur_kind() == 36 { advance() }
        left = new_node(50, arr_count)
        ND_LEFT[left as usize] = fill_val
    } else {
        left = new_node(1, 0)
        advance()
    }

    var postfix_done: i64 = 0
    while postfix_done == 0 {
        if cur_kind() == 65 {
            advance()
            if cur_kind() == 12 {
                just_cast_to_ptr = 1
                advance()
                if cur_kind() == 1 {
                    let cast_mod_off = tok_pool_off()
                    let cast_mod_len = tok_ident_len()
                    if pool_match(cast_mod_off, cast_mod_len, "mut") || pool_match(cast_mod_off, cast_mod_len, "const") {
                        advance()
                    }
                }
                if cur_kind() == 1 || cur_kind() >= 50 {
                    advance()
                }
            } else if cur_kind() == 15 || cur_kind() == 70 {
                advance()
                if cur_kind() == 1 || cur_kind() >= 50 {
                    advance()
                }
            } else if cur_kind() == 1 || cur_kind() >= 50 {
                advance()
            }
        } else if cur_kind() == 35 {
            advance()
            let idx_expr = parse_expr(0)
            if cur_kind() == 36 { advance() }
            let inode = new_node(13, 0)
            ND_LEFT[inode as usize] = left
            ND_RIGHT[inode as usize] = idx_expr
            left = inode
        } else if cur_kind() == 40 {
            advance()
            let fname_off2 = tok_pool_off()
            let fname_len2 = tok_ident_len()
            advance()
            if cur_kind() == 31 {
                advance()
                let mc_args = parse_args()
                if cur_kind() == 32 { advance() }
                let mcnode = new_node(51, 0)
                ND_LEFT[mcnode as usize] = left
                ND_STR_OFF[mcnode as usize] = fname_off2
                ND_STR_LEN[mcnode as usize] = fname_len2
                ND_EXTRA[mcnode as usize] = mc_args
                left = mcnode
            } else {
                let fnode2 = new_node(14, 0)
                ND_LEFT[fnode2 as usize] = left
                ND_STR_OFF[fnode2 as usize] = fname_off2
                ND_STR_LEN[fnode2 as usize] = fname_len2
                left = fnode2
            }
        } else {
            postfix_done = 1
        }
    }

    while true {
        let op_kind = cur_kind()
        let prec = binop_prec(op_kind)
        if prec == 0 || prec < min_prec { break }
        // Don't consume * as binary mul after addr-of or deref: *b on next line is next stmt
        if op_kind == 12 && (ND_KIND[left as usize] == 49 || ND_KIND[left as usize] == 46 || just_cast_to_ptr == 1) { break }
        let binop_code = tok_to_binop(op_kind)
        advance()
        let right = parse_expr(prec + 1)
        let bin_node = new_node(10, binop_code)
        ND_LEFT[bin_node as usize] = left
        ND_RIGHT[bin_node as usize] = right
        left = bin_node
    }

    left
}

fn parse_if_expr() -> i64 with Mut, Panic, Div {
    expect(53)
    let cond = parse_expr(0)
    let then_block = parse_block()
    let if_node = new_node(30, 0)
    ND_LEFT[if_node as usize] = cond
    ND_EXTRA[if_node as usize] = then_block
    if cur_kind() == 54 {
        advance()
        if cur_kind() == 53 {
            let else_part = parse_if_expr()
            ND_EXTRA2[if_node as usize] = else_part
        } else {
            let else_block = parse_block()
            ND_EXTRA2[if_node as usize] = else_block
        }
    }
    if_node
}

fn parse_while_expr() -> i64 with Mut, Panic, Div {
    expect(55)
    let cond = parse_expr(0)
    let body = parse_block()
    let wh_node = new_node(31, 0)
    ND_LEFT[wh_node as usize] = cond
    ND_EXTRA[wh_node as usize] = body
    wh_node
}

// ============================================================================
// Parser: statements
// ============================================================================

fn parse_stmt() -> i64 with Mut, Panic, Div {
    let k = cur_kind()
    if k == 51 || k == 52 {
        let is_var = k == 52
        advance()
        let name_off = tok_pool_off()
        let name_len = tok_ident_len()
        advance()
        var struct_si: i64 = -1
        var is_ref_type: i64 = 0  // 1 if type annotation had & prefix
        var box_inner_hint: i64 = -1
        if cur_kind() == 38 {
            advance()
            // Skip leading & or &! in type annotations
            if cur_kind() == 15 { advance(); is_ref_type = 1 }
            else if cur_kind() == 70 { advance(); is_ref_type = 1 }
            if cur_kind() == 1 {
                let toff = tok_pool_off()
                let tlen = tok_ident_len()
                struct_si = find_struct_b4(toff, tlen)
                // If type is &StructName, treat as pointer-to-struct (not value)
                if struct_si >= 0 && is_ref_type == 1 {
                    // Store struct_si in box_inner_hint for type tracking,
                    // but clear struct_si so codegen doesn't allocate full struct
                    box_inner_hint = struct_si
                    struct_si = -1
                }
                // Detect Option<Box<T>> or Box<T> in type annotation
                if struct_si < 0 && box_inner_hint < 0 {
                    if pool_match(toff, tlen, "Option") || pool_match(toff, tlen, "Box") {
                        box_inner_hint = extract_option_box_inner_at()
                    }
                }
            }
            skip_type_expr()
        }
        expect(30)
        let init = parse_expr(0)
        var node_kind: i64 = 40
        if is_var { node_kind = 41 }
        let node = new_node(node_kind, struct_si)
        ND_STR_OFF[node as usize] = name_off
        ND_STR_LEN[node as usize] = name_len
        ND_LEFT[node as usize] = init
        ND_EXTRA2[node as usize] = box_inner_hint
        return node
    }
    if k == 56 {
        advance()
        let val = if cur_kind() != 34 && cur_kind() != 39 { parse_expr(0) } else { -1 }
        let node = new_node(34, 0)
        ND_LEFT[node as usize] = val
        return node
    }
    if k == 63 {
        advance()
        return new_node(35, 0)
    }
    if k == 64 {
        advance()
        return new_node(36, 0)
    }
    if k == 53 {
        return parse_if_expr()
    }
    if k == 55 {
        return parse_while_expr()
    }
    // Special case: *lval = rhs (deref-assign at statement level)
    // Must handle before parse_expr to avoid Pratt loop consuming *lval
    // when &expr on previous line has no statement separator
    if k == 12 {
        advance()
        let lval = parse_expr(18)
        if cur_kind() == 30 {
            advance()
            let rhs2 = parse_expr(0)
            let dn = new_node(46, 0)
            ND_LEFT[dn as usize] = lval
            let asgn2 = new_node(42, 0)
            ND_LEFT[asgn2 as usize] = dn
            ND_EXTRA[asgn2 as usize] = rhs2
            return asgn2
        }
        let dn2 = new_node(46, 0)
        ND_LEFT[dn2 as usize] = lval
        let es2 = new_node(43, 0)
        ND_LEFT[es2 as usize] = dn2
        return es2
    }
    let expr = parse_expr(0)
    if cur_kind() == 30 {
        advance()
        let rhs = parse_expr(0)
        let asgn = new_node(42, 0)
        ND_LEFT[asgn as usize] = expr
        ND_EXTRA[asgn as usize] = rhs
        return asgn
    }
    let es = new_node(43, 0)
    ND_LEFT[es as usize] = expr
    es
}

// ============================================================================
// Parser: top-level
// ============================================================================

fn skip_effects() with Mut, Panic, Div {
    if cur_kind() == 66 {
        advance()
        while cur_kind() == 1 || cur_kind() >= 50 {
            advance()
            if cur_kind() == 37 { advance() }
        }
    }
}

fn skip_return_type() with Mut, Panic, Div {
    if cur_kind() == 42 {
        advance()
        skip_type_expr()
    }
}

fn skip_paren_group() with Mut, Panic, Div {
    if cur_kind() == 31 {
        advance()
        var depth: i64 = 1
        while depth > 0 && cur_kind() != 0 {
            if cur_kind() == 31 { depth = depth + 1 }
            else if cur_kind() == 32 { depth = depth - 1 }
            advance()
        }
    }
}

fn parse_fn_def() with Mut, Panic, Div {
    let fn_module_idx = mc_module_for_token_idx(POS)
    expect(50)
    if FN_COUNT >= fn_cap() {
        mc_note_saturation(2, mc_module_for_token_idx(POS))
        if cur_kind() == 1 { advance() }
        skip_paren_group()
        skip_return_type()
        skip_effects()
        if cur_kind() == 33 { skip_braces() }
        return 0
    }
    let fn_idx = FN_COUNT
    let name_off = tok_pool_off()
    let name_len = tok_ident_len()
    FN_NAME_OFF[fn_idx as usize] = name_off
    FN_NAME_LEN[fn_idx as usize] = name_len
    FN_MODULE_IDX[fn_idx as usize] = fn_module_idx
    FN_BODY_STATE[fn_idx as usize] = fn_body_state_full()
    advance()

    expect(31)
    var pcount: i64 = 0
    let pbase = fn_idx * 8
    FN_PARAM_BASE[fn_idx as usize] = pbase
    while cur_kind() != 32 && cur_kind() != 0 {
        let poff = tok_pool_off()
        let plen = tok_ident_len()
        FN_PARAM_NAME_OFF[(pbase + pcount) as usize] = poff
        FN_PARAM_NAME_LEN[(pbase + pcount) as usize] = plen
        advance()
        var psi: i64 = -1
        if cur_kind() == 38 {
            advance()
            if cur_kind() == 15 || cur_kind() == 70 {
                advance()
            }
            if cur_kind() == 1 {
                let ptoff = tok_pool_off()
                let ptlen = tok_ident_len()
                psi = find_struct_b4(ptoff, ptlen)
            }
            skip_type_expr()
        } else if pcount == 0 {
            psi = FN_IMPL_SI[fn_idx as usize]
        }
        FN_PARAM_TYPE_SI[(pbase + pcount) as usize] = psi
        pcount = pcount + 1
        if cur_kind() == 37 { advance() }
    }
    expect(32)
    FN_PARAM_COUNT[fn_idx as usize] = pcount

    // Parse return type: record struct return type in FN_RET_SI
    if cur_kind() == 42 {
        advance()
        if cur_kind() == 1 {
            let rt_off = tok_pool_off()
            let rt_len = tok_ident_len()
            let rt_si = find_struct_b4(rt_off, rt_len)
            FN_RET_SI[fn_idx as usize] = rt_si
            // Detect Option<Box<T>> or Box<T> return type
            if rt_si < 0 {
                if pool_match(rt_off, rt_len, "Option") || pool_match(rt_off, rt_len, "Box") {
                    FN_RET_BOX_INNER_SI[fn_idx as usize] = extract_option_box_inner_at()
                }
            }
        }
        skip_type_expr()
    }
    skip_effects()

    var body: i64 = -1
    if mc_module_should_defer_bodies(fn_module_idx) == 1 && cur_kind() == 33 {
        mc_bump_module_fn_body_skipped(fn_module_idx)
        skip_braces()
        body = make_stub_body_return_zero()
        FN_BODY_STATE[fn_idx as usize] = fn_body_state_stub()
    } else {
        mc_bump_module_fn_body_needed(fn_module_idx)
        body = parse_block()
        FN_BODY_STATE[fn_idx as usize] = fn_body_state_full()
    }
    FN_BODY_NODE[fn_idx as usize] = body
    FN_COUNT = FN_COUNT + 1
    mc_bump_module_fn_local(fn_module_idx)
    mc_mark_exec_state(fn_module_idx, 2)
}

// Extract T from Option<Box<T>> or Box<T> type expression.
// Assumes current token is already past Option/Box ident.
// Peeks ahead, does NOT consume tokens (saves/restores POS).
fn extract_option_box_inner_at() -> i64 with Mut, Panic, Div {
    let save_pos = POS
    advance()  // skip Option or Box
    var result: i64 = -1
    if cur_kind() == 25 {
        advance()  // skip <
        if cur_kind() == 1 {
            let inner_off = tok_pool_off()
            let inner_len = tok_ident_len()
            if pool_match(inner_off, inner_len, "Box") {
                advance()  // skip Box
                if cur_kind() == 25 {
                    advance()  // skip <
                    if cur_kind() == 1 {
                        let si_off = tok_pool_off()
                        let si_len = tok_ident_len()
                        result = find_struct_b4(si_off, si_len)
                    }
                }
            } else {
                result = find_struct_b4(inner_off, inner_len)
            }
        }
    }
    POS = save_pos
    result
}

fn parse_struct_decl() with Mut, Panic, Div {
    let module_idx = mc_module_for_token_idx(POS)
    advance()
    // Skip if already parsed (from pre_scan_structs)
    let check_off = tok_pool_off()
    let check_len = tok_ident_len()
    let existing = find_struct_b4(check_off, check_len)
    if existing >= 0 {
        // Already parsed — skip the struct body
        advance()
        skip_braces()
        mc_mark_exec_state(module_idx, 2)
        return 0
    }
    if ST_COUNT >= st_cap() {
        mc_note_saturation(3, mc_module_for_token_idx(POS))
        advance()
        skip_braces()
        mc_mark_exec_state(module_idx, 2)
        return 0
    }
    let si = ST_COUNT
    ST_NAME_OFF[si as usize] = tok_pool_off()
    ST_NAME_LEN[si as usize] = tok_ident_len()
    advance()
    if cur_kind() == 33 { advance() }
    let fi_base = FLD_COUNT
    ST_FIELD_FIRST[si as usize] = fi_base
    var fc: i64 = 0
    while cur_kind() != 34 && cur_kind() != 0 {
        if cur_kind() == 1 {
            if fi_base + fc >= fld_cap() {
                mc_note_saturation(4, mc_module_for_token_idx(POS))
                advance()
                if cur_kind() == 38 {
                    advance()
                    skip_type_expr()
                }
                if cur_kind() == 37 { advance() }
                continue
            }
            FLD_NAME_OFF[(fi_base + fc) as usize] = tok_pool_off()
            FLD_NAME_LEN[(fi_base + fc) as usize] = tok_ident_len()
            fc = fc + 1
            advance()
            var fld_si: i64 = -1
            var fld_slots: i64 = 1
            if cur_kind() == 38 {
                advance()
                if cur_kind() == 35 {
                    // Array type: [elem; count]
                    advance()
                    // Read element type
                    var elem_si: i64 = -1
                    var elem_bytes: i64 = 8
                    if cur_kind() == 1 {
                        let etoff = tok_pool_off()
                        let etlen = tok_ident_len()
                        elem_si = find_struct_b4(etoff, etlen)
                        if elem_si < 0 {
                            // Check if i8/u8 (1 byte) or i16/u16 (2 bytes) etc.
                            if etlen == 2 {
                                let c0 = text_byte(etoff, 0)
                                let c1 = text_byte(etoff, 1)
                                if c0 == 105 && c1 == 56 { elem_bytes = 1 }
                                if c0 == 117 && c1 == 56 { elem_bytes = 1 }
                            }
                        }
                    }
                    skip_type_expr()
                    // Now at ';'
                    if cur_kind() == 39 { advance() }
                    // Read array length
                    var arr_len: i64 = 0
                    if cur_kind() == 2 {
                        arr_len = cur_ival()
                        advance()
                    }
                    if cur_kind() == 36 { advance() }
                    // Compute slot count
                    if elem_si >= 0 {
                        fld_slots = arr_len * struct_total_slots(elem_si)
                    } else {
                        fld_slots = (arr_len * elem_bytes + 7) / 8
                    }
                    if fld_slots < 1 { fld_slots = 1 }
                } else {
                    var box_inner: i64 = -1
                    if cur_kind() == 1 {
                        let ftoff = tok_pool_off()
                        let ftlen = tok_ident_len()
                        FLD_TYPE_NAME_OFF[(fi_base + fc - 1) as usize] = ftoff
                        FLD_TYPE_NAME_LEN[(fi_base + fc - 1) as usize] = ftlen
                        fld_si = find_struct_b4(ftoff, ftlen)
                        if fld_si >= 0 {
                            fld_slots = struct_total_slots(fld_si)
                        }
                        // Detect Option<Box<StructName>> pattern
                        if fld_si < 0 && (pool_match(ftoff, ftlen, "Option") || pool_match(ftoff, ftlen, "Box")) {
                            // Peek ahead for <Box<StructName>> or <StructName>
                            let save_pos = POS
                            advance()  // skip Option/Box
                            if cur_kind() == 25 {
                                advance()  // skip <
                                if cur_kind() == 1 {
                                    let inner_off = tok_pool_off()
                                    let inner_len = tok_ident_len()
                                    if pool_match(inner_off, inner_len, "Box") {
                                        advance()  // skip Box
                                        if cur_kind() == 25 {
                                            advance()  // skip <
                                            if cur_kind() == 1 {
                                                let si_off = tok_pool_off()
                                                let si_len = tok_ident_len()
                                                box_inner = find_struct_b4(si_off, si_len)
                                            }
                                        }
                                    } else {
                                        box_inner = find_struct_b4(inner_off, inner_len)
                                    }
                                }
                            }
                            POS = save_pos  // restore position for skip_type_expr
                        }
                    }
                    skip_type_expr()
                    FLD_BOX_INNER_SI[(fi_base + fc - 1) as usize] = box_inner
                }
            }
            FLD_TYPE_SI[(fi_base + fc - 1) as usize] = fld_si
            FLD_SLOT_COUNT[(fi_base + fc - 1) as usize] = fld_slots
            if cur_kind() == 37 { advance() }
        } else {
            advance()
        }
    }
    if cur_kind() == 34 { advance() }
    ST_FIELD_COUNT[si as usize] = fc
    FLD_COUNT = FLD_COUNT + fc
    ST_COUNT = ST_COUNT + 1
    mc_mark_exec_state(module_idx, 2)
}

fn skip_braces() with Mut, Panic, Div {
    if cur_kind() == 33 {
        advance()
        var depth: i64 = 1
        while depth > 0 && cur_kind() != 0 {
            if cur_kind() == 33 { depth = depth + 1 }
            else if cur_kind() == 34 { depth = depth - 1 }
            if depth > 0 { advance() }
        }
        if cur_kind() == 34 { advance() }
    }
}

fn parse_enum_decl() with Mut, Panic, Div {
    let module_idx = mc_module_for_token_idx(POS)
    advance()  // skip 'enum'
    // Skip if already parsed (from pre_scan_enums)
    let check_off = tok_pool_off()
    let check_len = tok_ident_len()
    let existing = find_enum_b4(check_off, check_len)
    if existing >= 0 {
        advance()
        skip_braces()
        mc_mark_exec_state(module_idx, 2)
        return 0
    }
    if EN_COUNT >= en_cap() {
        mc_note_saturation(7, mc_module_for_token_idx(POS))
        advance()
        skip_braces()
        mc_mark_exec_state(module_idx, 2)
        return 0
    }
    let ei = EN_COUNT
    EN_NAME_OFF[ei as usize] = tok_pool_off()
    EN_NAME_LEN[ei as usize] = tok_ident_len()
    advance()  // skip enum name
    if cur_kind() == 33 { advance() }  // skip {
    let ev_base = EV_COUNT
    EN_FIRST_VARIANT[ei as usize] = ev_base
    var vc: i64 = 0
    while cur_kind() != 34 && cur_kind() != 0 {
        if cur_kind() == 1 {
            let voff = tok_pool_off()
            let vlen = tok_ident_len()
            EV_NAME_OFF[(ev_base + vc) as usize] = voff
            EV_NAME_LEN[(ev_base + vc) as usize] = vlen
            EV_VALUE[(ev_base + vc) as usize] = vc
            vc = vc + 1
            advance()
            // Skip optional payload: (Type) or { ... }
            if cur_kind() == 31 {
                advance()
                var pd: i64 = 1
                while pd > 0 && cur_kind() != 0 {
                    if cur_kind() == 31 { pd = pd + 1 }
                    else if cur_kind() == 32 { pd = pd - 1 }
                    if pd > 0 { advance() }
                }
                if cur_kind() == 32 { advance() }
            }
        }
        if cur_kind() == 37 { advance() }  // skip comma
    }
    if cur_kind() == 34 { advance() }  // skip }
    EN_VARIANT_COUNT[ei as usize] = vc
    EV_COUNT = EV_COUNT + vc
    EN_COUNT = EN_COUNT + 1
    mc_mark_exec_state(module_idx, 2)
}

fn pre_scan_enums() with Mut, Panic, Div {
    let saved_pos = POS
    POS = 0
    while cur_kind() != 0 {
        if cur_kind() == 59 {
            parse_enum_decl()
        } else if cur_kind() == 33 {
            skip_braces()
        } else {
            advance()
        }
    }
    POS = saved_pos
}

fn parse_impl_body() with Mut, Panic, Div {
    // Get struct name from first identifier token
    var si: i64 = -1
    if cur_kind() == 1 {
        let noff = tok_pool_off()
        let nlen = tok_ident_len()
        si = find_struct_b4(noff, nlen)
        advance()
    }
    // Skip generics and 'for Type' clauses until we reach '{'
    while cur_kind() != 33 && cur_kind() != 0 {
        if cur_kind() == 25 {
            advance()
            var d: i64 = 1
            while d > 0 && cur_kind() != 0 {
                if cur_kind() == 25 { d = d + 1 }
                else if cur_kind() == 27 { d = d - 1 }
                else if cur_kind() == 19 { d = d - 2 }  // '>>' = two closing >
                if d > 0 { advance() }
            }
            if cur_kind() == 27 { advance() }
            else if cur_kind() == 19 { advance() }
        } else {
            advance()
        }
    }
    if cur_kind() == 33 { advance() }
    // Parse function definitions inside the impl block
    while cur_kind() != 34 && cur_kind() != 0 {
        if cur_kind() == 50 {
            FN_IMPL_SI[FN_COUNT as usize] = si
            let fn_before = FN_COUNT
            parse_fn_def()
            // Qualify: rename "method" → "StructName::method" so static calls resolve correctly
            if si >= 0 {
                let sn_off = ST_NAME_OFF[si as usize]
                let sn_len = ST_NAME_LEN[si as usize]
                let mn_off = FN_NAME_OFF[fn_before as usize]
                let mn_len = FN_NAME_LEN[fn_before as usize]
                let q_off = pool_concat_colon(sn_off, sn_len, mn_off, mn_len)
                FN_NAME_OFF[fn_before as usize] = q_off
                FN_NAME_LEN[fn_before as usize] = sn_len + 2 + mn_len
            }
        } else if cur_kind() == 33 {
            skip_braces()
        } else {
            advance()
        }
    }
    if cur_kind() == 34 { advance() }
}

// ============================================================================
// Import resolution: pre-scan SRC for 'use' declarations before lex()
// ============================================================================

// Check if the filename currently in IMP_FNAME_BUF (length fname_len) was already loaded.
// Compares against POOL bytes stored for each previous import.
fn imp_already_loaded(fname_len: i64) -> bool with Mut, Panic, Div {
    var ci: i64 = 0
    while ci < IMP_LOADED_COUNT {
        let poff = IMP_POOL_OFF[ci as usize]
        let plen = IMP_POOL_LEN[ci as usize]
        if plen == fname_len {
            var same: i64 = 1
            var mi: i64 = 0
            while mi < fname_len {
                let pb = POOL[(poff + mi) as usize] as i64
                let fb = IMP_FNAME_BUF[mi as usize] as i64
                if pb != fb { same = 0 }
                mi = mi + 1
            }
            if same == 1 { return true }
        }
        ci = ci + 1
    }
    false
}

// Record current IMP_FNAME_BUF (length fname_len) as loaded in POOL for de-dup.
fn imp_record_loaded(fname_len: i64) with Mut, Panic, Div {
    if IMP_LOADED_COUNT >= 128 { return }
    let pstart = POOL_POS
    var i: i64 = 0
    while i < fname_len {
        pool_add(IMP_FNAME_BUF[i as usize] as i64)
        i = i + 1
    }
    IMP_POOL_OFF[IMP_LOADED_COUNT as usize] = pstart
    IMP_POOL_LEN[IMP_LOADED_COUNT as usize] = fname_len
    IMP_SRC_START[IMP_LOADED_COUNT as usize] = 0
    IMP_SRC_LEN[IMP_LOADED_COUNT as usize] = 0
    IMP_REQ_LEN[IMP_LOADED_COUNT as usize] = 0
    IMP_REQSPEC_OFF[IMP_LOADED_COUNT as usize] = 0
    IMP_REQSPEC_LEN[IMP_LOADED_COUNT as usize] = 0
    IMP_RES_KIND[IMP_LOADED_COUNT as usize] = 0
    IMP_PARENT[IMP_LOADED_COUNT as usize] = -1
    IMP_DEPTH[IMP_LOADED_COUNT as usize] = 0
    IMP_LOADED_COUNT = IMP_LOADED_COUNT + 1
}

fn import_path_has_namespace(path_start: i64, path_len: i64) -> i64 with Mut, Panic, Div {
    var pi: i64 = 0
    while pi + 1 < path_len {
        if src_byte_in_current_slice(path_start + pi) == 58 && src_byte_in_current_slice(path_start + pi + 1) == 58 {
            if pi + 2 < path_len {
                let after = src_byte_in_current_slice(path_start + pi + 2)
                if after != 42 && after != 123 {
                    return 1
                }
            }
        }
        pi = pi + 1
    }
    0
}

fn build_import_fname_with_prefix(path_start: i64, path_len: i64, compiler_prefix: i64) -> i64 with Mut, Panic, Div {
    var bi: i64 = 0
    // Write "self-hosted/" (12 bytes)
    IMP_FNAME_BUF[bi as usize] = 115 as i8; bi = bi + 1  // s
    IMP_FNAME_BUF[bi as usize] = 101 as i8; bi = bi + 1  // e
    IMP_FNAME_BUF[bi as usize] = 108 as i8; bi = bi + 1  // l
    IMP_FNAME_BUF[bi as usize] = 102 as i8; bi = bi + 1  // f
    IMP_FNAME_BUF[bi as usize] = 45 as i8;  bi = bi + 1  // -
    IMP_FNAME_BUF[bi as usize] = 104 as i8; bi = bi + 1  // h
    IMP_FNAME_BUF[bi as usize] = 111 as i8; bi = bi + 1  // o
    IMP_FNAME_BUF[bi as usize] = 115 as i8; bi = bi + 1  // s
    IMP_FNAME_BUF[bi as usize] = 116 as i8; bi = bi + 1  // t
    IMP_FNAME_BUF[bi as usize] = 101 as i8; bi = bi + 1  // e
    IMP_FNAME_BUF[bi as usize] = 100 as i8; bi = bi + 1  // d
    IMP_FNAME_BUF[bi as usize] = 47 as i8;  bi = bi + 1  // /
    if compiler_prefix == 1 {
        IMP_FNAME_BUF[bi as usize] = 99 as i8;  bi = bi + 1  // c
        IMP_FNAME_BUF[bi as usize] = 111 as i8; bi = bi + 1  // o
        IMP_FNAME_BUF[bi as usize] = 109 as i8; bi = bi + 1  // m
        IMP_FNAME_BUF[bi as usize] = 112 as i8; bi = bi + 1  // p
        IMP_FNAME_BUF[bi as usize] = 105 as i8; bi = bi + 1  // i
        IMP_FNAME_BUF[bi as usize] = 108 as i8; bi = bi + 1  // l
        IMP_FNAME_BUF[bi as usize] = 101 as i8; bi = bi + 1  // e
        IMP_FNAME_BUF[bi as usize] = 114 as i8; bi = bi + 1  // r
        IMP_FNAME_BUF[bi as usize] = 47 as i8;  bi = bi + 1  // /
    }
    // Convert path: :: → /, stop at ::* or whitespace
    var pi: i64 = 0
    while pi < path_len && bi < 500 {
        let c = src_byte_in_current_slice(path_start + pi)
        if c == 58 && pi + 1 < path_len && src_byte_in_current_slice(path_start + pi + 1) == 58 {
            // :: found
            if pi + 2 >= path_len {
                break  // trailing ::
            }
            let after = src_byte_in_current_slice(path_start + pi + 2)
            if after == 42 || after == 123 {
                break  // ::* or ::{ → stop
            }
            IMP_FNAME_BUF[bi as usize] = 47 as i8  // /
            bi = bi + 1
            pi = pi + 2
        } else if c == 32 || c == 9 || c == 10 || c == 13 || c == 59 || c == 123 {
            break  // whitespace, ;, { → stop
        } else {
            IMP_FNAME_BUF[bi as usize] = c as i8
            bi = bi + 1
            pi = pi + 1
        }
    }
    // Append ".sio" and null terminator
    IMP_FNAME_BUF[bi as usize] = 46 as i8;  bi = bi + 1  // .
    IMP_FNAME_BUF[bi as usize] = 115 as i8; bi = bi + 1  // s
    IMP_FNAME_BUF[bi as usize] = 105 as i8; bi = bi + 1  // i
    IMP_FNAME_BUF[bi as usize] = 111 as i8; bi = bi + 1  // o
    IMP_FNAME_BUF[bi as usize] = 0 as i8                 // null terminator
    bi
}

// Convert a 'use' path (raw source bytes via source_byte) to a filename in IMP_FNAME_BUF.
// Input: path_start = byte offset of path start in SRC_BUF, path_len = length
// Example: "lexer::cursor::*" → "self-hosted/lexer/cursor.sio\0"
// Returns: length of filename (excluding null terminator)
fn import_resolution_kind(path_start: i64, path_len: i64) -> i64 with Mut, Panic, Div {
    if import_path_has_namespace(path_start, path_len) == 1 { return 1 }
    2
}

fn build_import_fname(path_start: i64, path_len: i64, resolution_kind: i64) -> i64 with Mut, Panic, Div {
    if resolution_kind == 2 {
        return build_import_fname_with_prefix(path_start, path_len, 1)
    }
    build_import_fname_with_prefix(path_start, path_len, 0)
}

fn pre_scan_imports_for_module(module_idx: i64) with Mut, Panic, Div {
    if module_idx < 0 || module_idx >= MC_MOD_COUNT { return }
    MC_MOD_SCAN_CALLS[module_idx as usize] = MC_MOD_SCAN_CALLS[module_idx as usize] + 1
    let mod_len = MC_MOD_SRC_LEN[module_idx as usize]
    MC_CUR_MODULE_IDX = module_idx
    if MC_MOD_KIND[module_idx as usize] == 0 {
        MC_CUR_USE_LIVE_SRC = 1
        MC_CUR_SLICE_START = 0
        MC_CUR_SLICE_END = mod_len
        MC_CUR_FROZEN_OFF = 0
        MC_CUR_FROZEN_LEN = mod_len
    } else {
        MC_CUR_USE_LIVE_SRC = 0
        MC_CUR_SLICE_START = 0
        MC_CUR_SLICE_END = mod_len
        mc_freeze_current_module_into_code_scratch()
    }
    var line_start: i64 = 0
    while line_start < mod_len {
        var line_end: i64 = line_start
        while line_end < mod_len && src_byte_in_current_slice(line_end) != 10 {
            line_end = line_end + 1
        }
        var p: i64 = line_start
        while p < line_end && (src_byte_in_current_slice(p) == 32 || src_byte_in_current_slice(p) == 9 || src_byte_in_current_slice(p) == 13) {
            p = p + 1
        }
        if p >= line_end {
            line_start = line_end + 1
            continue
        }
        let c0 = src_byte_in_current_slice(p)
        if c0 == 47 && p + 1 < line_end && src_byte_in_current_slice(p + 1) == 47 {
            line_start = line_end + 1
            continue
        }
        if p + 6 <= line_end &&
           c0 == 109 &&
           src_byte_in_current_slice(p + 1) == 111 &&
           src_byte_in_current_slice(p + 2) == 100 &&
           src_byte_in_current_slice(p + 3) == 117 &&
           src_byte_in_current_slice(p + 4) == 108 &&
           src_byte_in_current_slice(p + 5) == 101 &&
           (p + 6 == line_end || src_byte_in_current_slice(p + 6) == 32 || src_byte_in_current_slice(p + 6) == 9) {
            line_start = line_end + 1
            continue
        }
        if p + 4 <= line_end &&
           c0 == 117 &&
           src_byte_in_current_slice(p + 1) == 115 &&
           src_byte_in_current_slice(p + 2) == 101 &&
           (src_byte_in_current_slice(p + 3) == 32 || src_byte_in_current_slice(p + 3) == 9) {
            var path_start: i64 = p + 4
            while path_start < line_end && (src_byte_in_current_slice(path_start) == 32 || src_byte_in_current_slice(path_start) == 9) {
                path_start = path_start + 1
            }
            var path_end: i64 = line_end
            while path_end > path_start && (src_byte_in_current_slice(path_end - 1) == 32 || src_byte_in_current_slice(path_end - 1) == 9 || src_byte_in_current_slice(path_end - 1) == 59 || src_byte_in_current_slice(path_end - 1) == 13) {
                path_end = path_end - 1
            }
            let path_len = path_end - path_start
            if path_len > 0 {
                MC_MOD_USE_HITS[module_idx as usize] = MC_MOD_USE_HITS[module_idx as usize] + 1
                let resolution_kind = import_resolution_kind(path_start, path_len)
                let fname_len = build_import_fname(path_start, path_len, resolution_kind)
                if !imp_already_loaded(fname_len) {
                    MC_MOD_NEW_IMPORTS[module_idx as usize] = MC_MOD_NEW_IMPORTS[module_idx as usize] + 1
                    imp_record_loaded(fname_len)
                    let import_idx = IMP_LOADED_COUNT - 1
                    IMP_REQSPEC_OFF[import_idx as usize] = pool_copy_current_slice_range(path_start, path_len)
                    IMP_REQSPEC_LEN[import_idx as usize] = path_len
                    IMP_RES_KIND[import_idx as usize] = resolution_kind
                    IMP_PARENT[import_idx as usize] = module_idx
                    IMP_DEPTH[import_idx as usize] = MC_MOD_DEPTH[module_idx as usize] + 1
                    let src_start = SRC_LEN
                    let copied = append_import_from_imp_fname_buf()
                    IMP_SRC_START[import_idx as usize] = src_start
                    IMP_SRC_LEN[import_idx as usize] = copied
                    IMP_REQ_LEN[import_idx as usize] = MC_LAST_REQUESTED_BYTES
                    mc_record_import(import_idx)
                }
            }
            line_start = line_end + 1
            continue
        }
        break
    }
}

// Scan each resolved module slice for line-start 'use path' declarations.
// Resolution happens exactly once here; later phases consume only the bundle entries.
fn pre_scan_imports() with Mut, Panic, Div {
    if MC_MOD_COUNT <= 0 { return }
    var pass: i64 = 0
    while pass < 256 {
        let before = MC_MOD_COUNT
        var module_idx: i64 = 0
        while module_idx < before {
            pre_scan_imports_for_module(module_idx)
            module_idx = module_idx + 1
        }
        if MC_MOD_COUNT == before { break }
        pass = pass + 1
    }
    if pass >= 256 {
        print("warn: import closure pass limit hit\n")
    }
}

// Two-pass struct collection: scan all tokens for struct declarations
// to build the struct table BEFORE parsing function bodies.
// This ensures forward-referenced struct types (e.g., ItemList from imports)
// are available during type annotation parsing.
fn pre_scan_structs() with Mut, Panic, Div {
    let saved_pos = POS
    POS = 0
    while cur_kind() != 0 {
        if cur_kind() == 58 {
            parse_struct_decl()
        } else if cur_kind() == 33 {
            skip_braces()
        } else {
            advance()
        }
    }
    POS = saved_pos
    // Second pass: re-resolve unresolved field types now that all structs are known.
    // Run multiple iterations to handle transitive dependencies.
    var changed: i64 = 1
    var iter: i64 = 0
    while changed > 0 && iter < 10 {
        changed = 0
        var fi: i64 = 0
        while fi < FLD_COUNT {
            let ftype = FLD_TYPE_SI[fi as usize]
            if ftype < 0 && FLD_TYPE_NAME_LEN[fi as usize] > 0 {
                let tn_off = FLD_TYPE_NAME_OFF[fi as usize]
                let tn_len = FLD_TYPE_NAME_LEN[fi as usize]
                let resolved_si = find_struct_b4(tn_off, tn_len)
                if resolved_si >= 0 {
                    FLD_TYPE_SI[fi as usize] = resolved_si
                    let new_slots = struct_total_slots(resolved_si)
                    if FLD_SLOT_COUNT[fi as usize] != new_slots {
                        FLD_SLOT_COUNT[fi as usize] = new_slots
                        changed = changed + 1
                    }
                }
            } else if ftype >= 0 {
                let new_slots = struct_total_slots(ftype)
                if FLD_SLOT_COUNT[fi as usize] != new_slots {
                    FLD_SLOT_COUNT[fi as usize] = new_slots
                    changed = changed + 1
                }
            }
            fi = fi + 1
        }
        iter = iter + 1
    }
}

fn skip_to_next_top_level() with Mut, Panic, Div {
    while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 51 && cur_kind() != 52 && cur_kind() != 59 && cur_kind() != 60 {
        if cur_kind() == 33 {
            skip_braces()
        } else {
            advance()
        }
    }
}

fn parse_program_body() with Mut, Panic, Div {
    while cur_kind() != 0 {
        let k = cur_kind()
        if k == 50 {
            parse_fn_def()
        } else if k == 58 {
            parse_struct_decl()
        } else if k == 59 {
            // enum: already parsed in pre_scan_enums, just skip
            parse_enum_decl()
        } else if k == 60 {
            // impl: collect fn definitions inside
            advance()
            parse_impl_body()
        } else if k == 51 || k == 52 {
            while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 59 && cur_kind() != 60 {
                advance()
            }
        } else if k == 1 {
            let koff = tok_pool_off()
            let klen = tok_ident_len()
            if pool_match(koff, klen, "use") {
                advance()
                while cur_kind() != 0 && cur_kind() != 50 && cur_kind() != 58 && cur_kind() != 39 {
                    advance()
                }
                if cur_kind() == 39 { advance() }
            } else {
                skip_to_next_top_level()
            }
        } else {
            skip_to_next_top_level()
        }
    }
}

fn parse_program() with Mut, Panic, Div {
    if MC_MOD_COUNT <= 0 {
        parse_program_body()
    } else {
        var module_idx: i64 = 0
        while module_idx < MC_MOD_COUNT {
            let start_pos = MC_MOD_TK_START[module_idx as usize]
            let end_pos = MC_MOD_TK_END[module_idx as usize]
            if end_pos > start_pos {
                parser_begin_module_window(module_idx)
                parse_program_body()
                parser_finish_module_window(module_idx, start_pos)
                if MC_MOD_PARSE_TK_USED[module_idx as usize] > 0 {
                    mc_mark_exec_state(module_idx, 2)
                }
            }
            module_idx = module_idx + 1
        }
    }
}

// ============================================================================
// Codegen helpers
// ============================================================================

fn emit(b: i64) with Mut, Panic {
    mc_note_code_byte(b)
    if CODE_SEG_ACTIVE != 0 {
        if CODE_SEG_LEN >= code_seg_cap() {
            mc_note_saturation(6, -1)
            mc_note_code_overflow(code_overflow_frontier_segment())
            mc_note_code_discarded(CODE_CUR_SECTION, code_overflow_frontier_segment())
        } else {
            CODE_SEG[CODE_SEG_LEN as usize] = b as i8
            CODE_SEG_KIND[CODE_SEG_LEN as usize] = CODE_CUR_SECTION as i8
            if CODE_SEG_BASE + CODE_SEG_LEN >= code_cap() {
                mc_note_saturation(6, -1)
                mc_note_code_overflow(code_overflow_frontier_global())
                mc_note_code_discarded(CODE_CUR_SECTION, code_overflow_frontier_global())
            }
        }
        CODE_SEG_LEN = CODE_SEG_LEN + 1
        CODE_LEN = CODE_SEG_BASE + CODE_SEG_LEN
        mc_note_code_progress()
        return
    }
    if CODE_LEN >= code_cap() {
        mc_note_saturation(6, -1)
        mc_note_code_overflow(code_overflow_frontier_global())
        mc_note_code_discarded(CODE_CUR_SECTION, code_overflow_frontier_global())
    } else {
        CODE[CODE_LEN as usize] = b as i8
        mc_note_code_resident(CODE_CUR_SECTION)
    }
    CODE_LEN = CODE_LEN + 1
    mc_note_code_progress()
}

fn emit_u32(v: i64) with Mut, Panic {
    emit(v & 0xFF)
    emit((v >> 8) & 0xFF)
    emit((v >> 16) & 0xFF)
    emit((v >> 24) & 0xFF)
}

fn emit_u64(v: i64) with Mut, Panic {
    emit_u32(v)
    emit_u32(v >> 32)
}

fn emit_mov_rax_imm(val: i64) with Mut, Panic {
    emit(0x48); emit(0xB8)
    emit_u64(val)
}

fn emit_store_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x89); emit(0x85)
    emit_u32(disp)
}

fn emit_load_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8B); emit(0x85)
    emit_u32(disp)
}

fn emit_lea_rax(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8D); emit(0x85)
    emit_u32(disp)
}

fn emit_load_rcx(slot: i64) with Mut, Panic {
    let disp = 0 - ((slot + 1) * 8)
    emit(0x48); emit(0x8B); emit(0x8D)
    emit_u32(disp)
}

var PROLOGUE_PATCH_OFF: i64 = 0  // CODE offset of frame size placeholder

fn emit_prologue() with Mut, Panic {
    emit(0x55)
    emit(0x48); emit(0x89); emit(0xE5)
    emit(0x48); emit(0x81); emit(0xEC)
    PROLOGUE_PATCH_OFF = CODE_LEN
    emit_u32(0)  // placeholder — patched after function body is compiled
}

fn emit_epilogue() with Mut, Panic {
    emit(0x48); emit(0x89); emit(0xEC)
    emit(0x5D)
    emit(0xC3)
}

fn emit_print_int_helper() with Mut, Panic {
    PRINT_INT_OFF = CODE_LEN
    emit(0x55)
    emit(0x48); emit(0x89); emit(0xE5)
    emit(0x48); emit(0x83); emit(0xEC); emit(0x30)
    emit(0x48); emit(0x89); emit(0xF8)
    emit(0x4C); emit(0x8D); emit(0x45); emit(0xFF)
    emit(0x45); emit(0x31); emit(0xC9)
    emit(0x48); emit(0x85); emit(0xC0)
    emit(0x79); emit(0x06)
    emit(0x48); emit(0xF7); emit(0xD8)
    emit(0x41); emit(0xB1); emit(0x01)
    emit(0x48); emit(0x85); emit(0xC0)
    emit(0x75); emit(0x09)
    emit(0x41); emit(0xC6); emit(0x00); emit(0x30)
    emit(0x49); emit(0xFF); emit(0xC8)
    emit(0xEB); emit(0x26)
    emit(0x31); emit(0xD2)
    emit(0x48); emit(0xC7); emit(0xC1); emit(0x0A); emit(0x00); emit(0x00); emit(0x00)
    emit(0x48); emit(0xF7); emit(0xF1)
    emit(0x80); emit(0xC2); emit(0x30)
    emit(0x41); emit(0x88); emit(0x10)
    emit(0x49); emit(0xFF); emit(0xC8)
    emit(0x48); emit(0x85); emit(0xC0)
    emit(0x75); emit(0xE6)
    emit(0x45); emit(0x84); emit(0xC9)
    emit(0x74); emit(0x07)
    emit(0x41); emit(0xC6); emit(0x00); emit(0x2D)
    emit(0x49); emit(0xFF); emit(0xC8)
    emit(0x49); emit(0xFF); emit(0xC0)
    emit(0x4C); emit(0x89); emit(0xC6)
    emit(0x48); emit(0x89); emit(0xEA)
    emit(0x4C); emit(0x29); emit(0xC2)
    emit(0xBF); emit(0x01); emit(0x00); emit(0x00); emit(0x00)
    emit(0xB8); emit(0x01); emit(0x00); emit(0x00); emit(0x00)
    emit(0x0F); emit(0x05)
    emit(0xC9)
    emit(0xC3)
}

// ============================================================================
// Codegen: local variable management
// ============================================================================

fn locals_reset() with Mut {
    LOCAL_COUNT = 0
    NEXT_SLOT = 0
}

fn alloc_slot() -> i64 with Mut {
    let s = NEXT_SLOT
    NEXT_SLOT = NEXT_SLOT + 1
    s
}

fn add_local(off: i64, len: i64) -> i64 with Mut, Panic {
    let idx = LOCAL_COUNT
    let slot = alloc_slot()
    LOCAL_NAME_OFF[idx as usize] = off
    LOCAL_NAME_LEN[idx as usize] = len
    LOCAL_SLOT[idx as usize] = slot
    LOCAL_STRUCT_IDX[idx as usize] = -1
    LOCAL_PTR_LAYOUT[idx as usize] = 0
    LOCAL_IS_ARR[idx as usize] = 0
    LOCAL_ARR_ELEM_SZ[idx as usize] = 0
    LOCAL_IS_SPTR[idx as usize] = 0
    LOCAL_COUNT = LOCAL_COUNT + 1
    slot
}

fn add_local_struct(off: i64, len: i64, si: i64, fc: i64) -> i64 with Mut, Panic {
    let idx = LOCAL_COUNT
    LOCAL_NAME_OFF[idx as usize] = off
    LOCAL_NAME_LEN[idx as usize] = len
    LOCAL_STRUCT_IDX[idx as usize] = si
    LOCAL_COUNT = LOCAL_COUNT + 1
    if fc > 64 {
        // Oversized struct: 1-slot thin pointer (is_sptr=4); backing store is BSS
        let slot = alloc_slot()
        LOCAL_SLOT[idx as usize] = slot
        LOCAL_PTR_LAYOUT[idx as usize] = 0
        LOCAL_IS_ARR[idx as usize] = 0
        LOCAL_ARR_ELEM_SZ[idx as usize] = 0
        LOCAL_IS_SPTR[idx as usize] = 4
        slot
    } else {
        let base = NEXT_SLOT
        LOCAL_SLOT[idx as usize] = base
        LOCAL_PTR_LAYOUT[idx as usize] = 0
        LOCAL_IS_ARR[idx as usize] = 0
        LOCAL_ARR_ELEM_SZ[idx as usize] = 0
        LOCAL_IS_SPTR[idx as usize] = 0
        var ai: i64 = 0
        while ai < fc { let ds = alloc_slot(); ai = ai + 1 }
        base
    }
}

fn add_local_sptr(off: i64, len: i64, si: i64) -> i64 with Mut, Panic {
    let idx = LOCAL_COUNT
    let slot = alloc_slot()
    LOCAL_NAME_OFF[idx as usize] = off
    LOCAL_NAME_LEN[idx as usize] = len
    LOCAL_SLOT[idx as usize] = slot
    LOCAL_STRUCT_IDX[idx as usize] = si
    LOCAL_PTR_LAYOUT[idx as usize] = 0
    LOCAL_IS_ARR[idx as usize] = 0
    LOCAL_ARR_ELEM_SZ[idx as usize] = 0
    LOCAL_IS_SPTR[idx as usize] = 1
    LOCAL_COUNT = LOCAL_COUNT + 1
    slot
}

fn find_local(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    LAST_LOCAL_SI = -1
    LAST_LOCAL_BOX_INNER = -1
    LAST_LOCAL_IS_SPTR = 0
    LAST_LOCAL_PTR_LAYOUT = 0
    LAST_LOCAL_IS_ARR = 0
    LAST_LOCAL_ARR_ELEM_SZ = 0
    LAST_FOUND_SLOT = -1
    var i: i64 = LOCAL_COUNT - 1
    while i >= 0 {
        let lo = LOCAL_NAME_OFF[i as usize]
        let ll = LOCAL_NAME_LEN[i as usize]
        if ll == len {
            var ok: i64 = 1
            var j: i64 = 0
            while j < len {
                if text_byte(lo, j) != text_byte(off, j) { ok = 0 }
                j = j + 1
            }
            if ok == 1 {
                LAST_LOCAL_SI = LOCAL_STRUCT_IDX[i as usize]
                LAST_LOCAL_IS_SPTR = LOCAL_IS_SPTR[i as usize]
                LAST_LOCAL_PTR_LAYOUT = LOCAL_PTR_LAYOUT[i as usize]
                LAST_LOCAL_IS_ARR = LOCAL_IS_ARR[i as usize]
                LAST_LOCAL_ARR_ELEM_SZ = LOCAL_ARR_ELEM_SZ[i as usize]
                LAST_LOCAL_BOX_INNER = LOCAL_BOX_INNER_SI[i as usize]
                LAST_FOUND_SLOT = LOCAL_SLOT[i as usize]
                return LOCAL_SLOT[i as usize]
            }
        }
        i = i - 1
    }
    -1
}

fn find_fn_by_name(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < FN_COUNT {
        let fo = FN_NAME_OFF[i as usize]
        let fl = FN_NAME_LEN[i as usize]
        if fl == len {
            var ok: i64 = 1
            var j: i64 = 0
            while j < len {
                if text_byte(fo, j) != text_byte(off, j) { ok = 0; break }
                j = j + 1
            }
            if ok == 1 { return i }
        }
        i = i + 1
    }
    -1
}

// Look up enum variant by qualified name "EnumName::Variant" in pool at (off, len).
// Sets EV_LOOKUP_FOUND=1 and returns discriminant if found, else sets EV_LOOKUP_FOUND=0 and returns 0.
fn find_enum_variant(off: i64, len: i64) -> i64 with Mut, Panic, Div {
    EV_LOOKUP_FOUND = 0
    // Find "::" separator in the qualified name
    var sep: i64 = -1
    var si: i64 = 0
    while si < len - 1 {
        if text_byte(off, si) == 58 && text_byte(off, si + 1) == 58 {
            sep = si
            break
        }
        si = si + 1
    }
    if sep < 0 { return 0 }
    // enum_name = pool[off..off+sep], variant_name = pool[off+sep+2..off+len]
    let en_off = off
    let en_len = sep
    let vn_off = off + sep + 2
    let vn_len = len - sep - 2
    if en_len <= 0 || vn_len <= 0 { return 0 }
    // Find enum by name
    var ei: i64 = 0
    while ei < EN_COUNT {
        let eo = EN_NAME_OFF[ei as usize]
        let el = EN_NAME_LEN[ei as usize]
        if el == en_len {
            var ok: i64 = 1
            var j: i64 = 0
            while j < en_len {
                if text_byte(eo, j) != text_byte(en_off, j) { ok = 0; break }
                j = j + 1
            }
            if ok == 1 {
                // Found enum; search variants
                let base = EN_VAR_BASE[ei as usize]
                let count = EN_VAR_COUNT[ei as usize]
                var vi: i64 = 0
                while vi < count {
                    let vo = EV_NAME_OFF[(base + vi) as usize]
                    let vl = EV_NAME_LEN[(base + vi) as usize]
                    if vl == vn_len {
                        var ok2: i64 = 1
                        var k: i64 = 0
                        while k < vn_len {
                            if text_byte(vo, k) != text_byte(vn_off, k) { ok2 = 0; break }
                            k = k + 1
                        }
                        if ok2 == 1 {
                            EV_LOOKUP_FOUND = 1
                            return EV_DISC[(base + vi) as usize]
                        }
                    }
                    vi = vi + 1
                }
            }
        }
        ei = ei + 1
    }
    0
}

// ============================================================================
// Global variable collection
// ============================================================================

fn mb_collect_globals() with Mut, Panic, Div {
    var ti: i64 = 0
    var depth: i64 = 0
    while ti < TK_COUNT {
        let k = TK_KIND[ti as usize]
        if k == 0 { break }
        if k == 33 { depth = depth + 1 }
        else if k == 34 { depth = depth - 1 }
        else if k == 52 && depth == 0 {
            ti = ti + 1
            let ns = TK_START[ti as usize]
            let ne = TK_END[ti as usize]
            let gi = MB_GL_COUNT
            MB_GL_NS[gi as usize] = ns
            MB_GL_NE[gi as usize] = ne
            MB_GL_OFF[gi as usize] = MB_BSS_TOTAL
            MB_GL_POOL[gi as usize] = name_pool_intern_source_range(ns, ne - ns)
            ti = ti + 1
            var sz: i64 = 8
            var count: i64 = 1
            if TK_KIND[ti as usize] == 38 {
                ti = ti + 1
                if TK_KIND[ti as usize] == 35 {
                    ti = ti + 1
                    if TK_KIND[ti as usize] == 1 {
                        let tns = TK_START[ti as usize]
                        let tne = TK_END[ti as usize]
                        if tne - tns == 2 {
                            let b0 = source_byte(tns)
                            let b1 = source_byte(tns + 1)
                            if b0 == 105 && b1 == 56 { sz = 1 }
                            if b0 == 117 && b1 == 56 { sz = 1 }
                        }
                        // Check if element type is a struct — use struct_total_slots for elem size
                        if sz == 8 {
                            let etype_pool_off = POOL_POS
                            var ei: i64 = 0
                            while ei < tne - tns {
                                pool_add(source_byte(tns + ei))
                                ei = ei + 1
                            }
                            let etype_pool_len = tne - tns
                            let etype_si = find_struct_b4(etype_pool_off, etype_pool_len)
                            if etype_si >= 0 {
                                sz = struct_total_slots(etype_si) * 8
                                MB_GL_ELEM_SI[gi as usize] = etype_si
                            }
                        }
                        ti = ti + 1
                    }
                    if TK_KIND[ti as usize] == 39 { ti = ti + 1 }
                    if TK_KIND[ti as usize] == 2 {
                        count = TK_IVAL[ti as usize]
                        ti = ti + 1
                    }
                    if TK_KIND[ti as usize] == 36 { ti = ti + 1 }
                } else {
                    if TK_KIND[ti as usize] == 1 || TK_KIND[ti as usize] >= 50 { ti = ti + 1 }
                }
            }
            MB_GL_SZ[gi as usize] = sz
            MB_BSS_TOTAL = MB_BSS_TOTAL + count * sz
            let rem = MB_BSS_TOTAL - (MB_BSS_TOTAL / 8) * 8
            if rem != 0 { MB_BSS_TOTAL = MB_BSS_TOTAL + (8 - rem) }
            MB_GL_COUNT = MB_GL_COUNT + 1
        }
        ti = ti + 1
    }
}

fn mb_find_global(pool_off: i64, pool_len: i64) -> i64 with Mut, Panic, Div {
    var gi: i64 = 0
    while gi < MB_GL_COUNT {
        let ns = MB_GL_NS[gi as usize]
        let ne = MB_GL_NE[gi as usize]
        if pool_len == ne - ns {
            var ok: i64 = 1
            var ci: i64 = 0
            while ci < pool_len {
                let pb = text_byte(pool_off, ci)
                // Compare NAME_POOL vs NAME_POOL to avoid source_byte
                // address mismatch where frozen CODE copies are overwritten
                // by codegen
                let sb = text_byte(MB_GL_POOL[gi as usize], ci)
                if pb != sb { ok = 0; break }
                ci = ci + 1
            }
            if ok == 1 { return gi }
        }
        gi = gi + 1
    }
    0 - 1
}

fn mb_resolve_src_globals() with Mut, Panic, Div {
    var gi: i64 = 0
    while gi < MB_GL_COUNT {
        let ns = MB_GL_NS[gi as usize]
        let ne = MB_GL_NE[gi as usize]
        if ne - ns == 7 {
            let gp = MB_GL_POOL[gi as usize]
            let b0 = text_byte(gp, 0)
            let b1 = text_byte(gp, 1)
            let b2 = text_byte(gp, 2)
            let b3 = text_byte(gp, 3)
            let b4 = text_byte(gp, 4)
            let b5 = text_byte(gp, 5)
            let b6 = text_byte(gp, 6)
            if b0 == 83 && b1 == 82 && b2 == 67 && b3 == 95 && b4 == 66 && b5 == 85 && b6 == 70 {
                MB_SRC_BUF_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
            }
            if b0 == 83 && b1 == 82 && b2 == 67 && b3 == 95 && b4 == 76 && b5 == 69 && b6 == 78 {
                MB_SRC_LEN_GADDR = 0x700000 + MB_GL_OFF[gi as usize]
            }
        }
        gi = gi + 1
    }
}

// ============================================================================
// Codegen: compile AST nodes
// ============================================================================

fn compile_node(node: i64) -> i64 with Mut, Panic, Div {
    if node == -1 {
        emit_mov_rax_imm(0)
        return 0
    }
    if node < 0 || node >= ND_COUNT {
        mc_note_bad_node(node)
        print("BAD NODE node=")
        print_int(node)
        print("\n")
        emit_mov_rax_imm(0)
        return 0
    }
    let kind = ND_KIND[node as usize]
    let ival = ND_IVAL[node as usize]

    if kind == 1 {
        emit_mov_rax_imm(ival)
        return 0
    }
    if kind == 4 {
        emit_mov_rax_imm(ival)
        return 0
    }
    if kind == 3 {
        let soff = ND_STR_OFF[node as usize]
        let slen = ND_STR_LEN[node as usize]
        emit(0xEB)
        let jmp_pos = CODE_LEN
        emit(0x00)
        let str_addr = CODE_LEN
        var si: i64 = 0
        let prev_section = CODE_CUR_SECTION
        CODE_CUR_SECTION = code_section_rodata()
        while si < slen {
            emit(POOL[(soff + si) as usize] as i64)
            si = si + 1
        }
        emit(0)
        CODE_CUR_SECTION = prev_section
        let dist = CODE_LEN - jmp_pos - 1
        code_write_at(jmp_pos, dist)
        emit(0x48); emit(0x8D); emit(0x05)
        let rel = str_addr - (CODE_LEN + 4)
        emit_u32(rel)
        return 0
    }
    if kind == 2 {
        let voff = ND_STR_OFF[node as usize]
        let vlen = ND_STR_LEN[node as usize]
        let slot = find_local(voff, vlen)
        if slot >= 0 {
            emit_load_rax(slot)
        } else {
            let gi = mb_find_global(voff, vlen)
            if gi >= 0 {
                let gaddr = 0x700000 + MB_GL_OFF[gi as usize]
                emit(0x48); emit(0xB9); emit_u64(gaddr)
                if MB_GL_SZ[gi as usize] == 1 {
                    emit(0x48); emit(0x0F); emit(0xB6); emit(0x01)
                } else {
                    emit(0x48); emit(0x8B); emit(0x01)
                }
            } else {
                // Sprint 229: Check if identifier is a function name (fn as first-class value)
                let fn_idx = find_fn_by_name(voff, vlen)
                if fn_idx >= 0 {
                    // LEA rax, [RIP + disp32] — load function address
                    emit(0x48); emit(0x8D); emit(0x05)
                    let lea_fix_pos = CODE_LEN
                    emit_u32(0)
                    mc_add_fn_lea_fixup(lea_fix_pos, fn_idx)
                } else {
                    // Check if it's an Enum::Variant qualified name
                    let ev_disc = en_lookup_qualified(voff, vlen)
                    if ev_disc >= 0 {
                        emit_mov_rax_imm(ev_disc)
                    } else {
                        emit_mov_rax_imm(0)
                    }
                }
            }
        }
        return 0
    }
    if kind == 46 {
        let deref_inner = ND_LEFT[node as usize]
        // Propagate struct type for chained field access: (*ptr).field
        if ND_KIND[deref_inner as usize] == 2 {
            let d_off = ND_STR_OFF[deref_inner as usize]
            let d_len = ND_STR_LEN[deref_inner as usize]
            find_local(d_off, d_len)
            let inner_si = LAST_LOCAL_SI
            if inner_si >= 0 {
                LAST_FIELD_TYPE_SI = inner_si
            }
        }
        compile_node(deref_inner)
        emit(0x48); emit(0x8B); emit(0x00)   // mov rax, [rax]
        return 0
    }
    // NK_ADDR: &expr — emit address of inner expression
    // Handles: &local_var → lea rax, [rbp - (slot+1)*8]
    //          &struct.field → lea rax, [rbp - (base_slot+fi+1)*8]
    //          &global → rip-relative lea
    if kind == 49 {
        let inner = ND_LEFT[node as usize]
        let ik = ND_KIND[inner as usize]
        if ik == 2 {
            let voff2 = ND_STR_OFF[inner as usize]
            let vlen2 = ND_STR_LEN[inner as usize]
            let slot2 = find_local(voff2, vlen2)
            if slot2 >= 0 {
                if LAST_LOCAL_IS_ARR == 1 {
                    // Array locals already store the data base pointer in their slot.
                    emit_load_rax(slot2)
                } else {
                    emit_lea_rax(slot2)
                }
            } else {
                let gi2 = mb_find_global(voff2, vlen2)
                if gi2 >= 0 {
                    let gaddr2 = 0x700000 + MB_GL_OFF[gi2 as usize]
                    emit(0x48); emit(0xB8); emit_u64(gaddr2)
                } else {
                    emit_mov_rax_imm(0)
                }
            }
        } else if ik == 14 {
            let obj2 = ND_LEFT[inner as usize]
            let fn2 = ND_STR_OFF[inner as usize]
            let fl2 = ND_STR_LEN[inner as usize]
            let vo2 = ND_STR_OFF[obj2 as usize]
            let vl2 = ND_STR_LEN[obj2 as usize]
            let bs2 = find_local(vo2, vl2)
            let si3 = LAST_LOCAL_SI
            if bs2 >= 0 && si3 >= 0 {
                let fi2 = find_field_slot_offset(si3, fn2, fl2)
                if fi2 >= 0 {
                    emit_lea_rax(bs2 + fi2)
                    // Propagate Box inner type for Option<Box<T>> fields
                    let raw_fi2 = find_field_b4(si3, fn2, fl2)
                    if raw_fi2 >= 0 {
                        let fbase2 = ST_FIELD_FIRST[si3 as usize]
                        let bi2 = FLD_BOX_INNER_SI[(fbase2 + raw_fi2) as usize]
                        if bi2 >= 0 {
                            LAST_FIELD_TYPE_SI = bi2
                        }
                    }
                } else {
                    emit_mov_rax_imm(0)
                }
            } else {
                emit_mov_rax_imm(0)
            }
        } else {
            compile_node(inner)
        }
        return 0
    }
    if kind == 14 {
        let obj = ND_LEFT[node as usize]
        let fname_off = ND_STR_OFF[node as usize]
        let fname_len = ND_STR_LEN[node as usize]
        LAST_FIELD_TYPE_SI = -1
        LAST_FIELD_LAYOUT = 0
        let obj_nk = ND_KIND[obj as usize]
        // Special case: (*ptr).field — compile inner of DEREF (skip the extra load),
        // then access field at [rax + offset]. The ptr IS the struct address.
        if obj_nk == 46 {
            let deref_inner2 = ND_LEFT[obj as usize]
            // Try to get struct type from inner expression
            var known_si: i64 = -1
            var known_ptr_layout: i64 = 0
            if ND_KIND[deref_inner2 as usize] == 2 {
                let di_off = ND_STR_OFF[deref_inner2 as usize]
                let di_len = ND_STR_LEN[deref_inner2 as usize]
                find_local(di_off, di_len)
                known_si = LAST_LOCAL_SI
                known_ptr_layout = LAST_LOCAL_PTR_LAYOUT
                // Also check LOCAL_BOX_INNER_SI for match bindings
                if known_si < 0 && LAST_LOCAL_BOX_INNER >= 0 {
                    known_si = LAST_LOCAL_BOX_INNER
                }
            }
            compile_node(deref_inner2)  // rax = ptr to struct data
            // Use known struct type, or fallback to searching all structs
            var dfi: i64 = -1
            if known_si >= 0 {
                dfi = find_field_slot_offset(known_si, fname_off, fname_len)
            }
            // Try CURRENT_IMPL_SI as priority hint
            if dfi < 0 && CURRENT_IMPL_SI >= 0 {
                dfi = find_field_slot_offset(CURRENT_IMPL_SI, fname_off, fname_len)
            }
            if dfi < 0 {
                var dsi: i64 = 0
                while dsi < ST_COUNT && dfi < 0 {
                    dfi = find_field_slot_offset(dsi, fname_off, fname_len)
                    if dfi < 0 { dsi = dsi + 1 }
                }
            }
            if dfi >= 0 {
                let dfld_si = LAST_FIELD_TYPE_SI
                let dfld_is_agg = dfld_si >= 0 || LAST_FIELD_SLOT_COUNT > 1
                let ddisp = if known_ptr_layout == 1 { 0 - (dfi * 8) } else { dfi * 8 }
                if dfld_is_agg == 1 {
                    LAST_FIELD_LAYOUT = if known_ptr_layout == 1 { 0 } else { 1 }
                    if ddisp > 0 {
                        emit(0x48); emit(0x8D); emit(0x80); emit_u32(ddisp)
                    } else if ddisp < 0 {
                        emit(0x48); emit(0x8D); emit(0x80); emit_u32(ddisp)
                    }
                } else {
                    if ddisp == 0 {
                        emit(0x48); emit(0x8B); emit(0x00)
                    } else {
                        emit(0x48); emit(0x8B); emit(0x80); emit_u32(ddisp)
                    }
                }
