var ND_KIND: [i64; 262144] = [0; 262144]
var ND_IVAL: [i64; 262144] = [0; 262144]
var ND_LEFT: [i64; 262144] = [-1; 262144]
var ND_RIGHT: [i64; 262144] = [-1; 262144]
