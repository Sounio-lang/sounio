fn TK_FALSE() -> i64 { 62 }
fn TK_BREAK() -> i64 { 63 }
fn TK_CONTINUE() -> i64 { 64 }
fn TK_AS() -> i64 { 65 }
fn TK_WITH() -> i64 { 66 }
fn TK_SOME() -> i64 { 67 }
fn TK_NONE() -> i64 { 68 }
fn TK_STRUCT() -> i64 { 58 }
fn TK_MATCH() -> i64 { 57 }
fn TK_AMPBANG() -> i64 { 70 }
fn TK_FAT_ARROW() -> i64 { 79 }

fn NK_INT() -> i64 { 1 }
fn NK_IDENT() -> i64 { 2 }
fn NK_STR() -> i64 { 3 }
fn NK_BOOL() -> i64 { 4 }
fn NK_BINOP() -> i64 { 10 }
fn NK_UNARY() -> i64 { 11 }
