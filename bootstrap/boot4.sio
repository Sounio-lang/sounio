            emit(0x0F); emit(0x95); emit(0xC0)
            emit(0x48); emit(0x85); emit(0xC9)
            emit(0x0F); emit(0x95); emit(0xC1)
            emit(0x20); emit(0xC8)
            emit(0x48); emit(0x0F); emit(0xB6); emit(0xC0)
        }
