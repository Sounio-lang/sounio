var MC_PEAK_TEXT_FN_COUNT: i64 = 0
var MC_TOP_TEXT_FN_IDX: [i64; 5] = [-1; 5]
var MC_TOP_TEXT_FN_BYTES: [i64; 5] = [0; 5]
var MC_TOP_TEXT_MOD_IDX: [i64; 5] = [-1; 5]
