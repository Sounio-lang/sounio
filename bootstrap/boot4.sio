                }
                if found_fi < 0 {
                    var search_si: i64 = 0
                    while search_si < ST_COUNT && found_fi < 0 {
                        found_fi = find_field_slot_offset(search_si, fname_off, fname_len)
                        if found_fi < 0 { search_si = search_si + 1 }
                    }
                }
