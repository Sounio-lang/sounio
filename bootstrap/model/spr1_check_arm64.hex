01 00 00 d4         # b930  svc #0
1f 00 00 f1         # b934  cmp x0, #0
44 f1 fd 54         # b938  b.mi 0x407760   -> nomem
ef 03 00 aa         # b93c  mov x15, x0
e6 03 0e aa         # b940  mov x6, x14   copy len bytes
