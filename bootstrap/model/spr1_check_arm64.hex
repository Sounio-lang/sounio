ec 07 0c 8b         # b8e8  add x12, xzr, x12, lsl #1

# rd_go:
00 00 80 d2         # b8ec  movz x0, 0x0   read(0, buf + len, cap - len)
c1 01 0d 8b         # b8f0  add x1, x14, x13
82 01 0d cb         # b8f4  sub x2, x12, x13
e8 07 80 d2         # b8f8  movz x8, 0x3f
01 00 00 d4         # b8fc  svc #0
1f 00 00 f1         # b900  cmp x0, #0
e4 f2 fd 54         # b904  b.mi 0x407760   read failed -> nomem
60 00 00 54         # b908  b.eq 0x40b914   -> eof
ad 01 00 8b         # b90c  add x13, x13, x0
eb ff ff 17         # b910  b 0x40b8bc   -> rd

# eof:
