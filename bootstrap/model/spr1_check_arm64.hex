# vote:
# TMRVoterArm64.voterCode, park b +0 -> b +0x10 (to guard)
7f 02 14 eb         # 76c8  cmp x19, x20
66 12 55 fa         # 76cc  ccmp x19, x21, #6, ne
73 02 94 9a         # 76d0  csel x19, x19, x20, eq
86 12 55 fa         # 76d4  ccmp x20, x21, #6, ne
81 00 00 54         # 76d8  b.ne 0x4076e8
f4 03 13 aa         # 76dc  mov x20, x19
f5 03 13 aa         # 76e0  mov x21, x19
04 00 00 14         # 76e4  b 0x4076f4
60 00 80 d2         # 76e8  movz x0, 0x3
a8 0b 80 d2         # 76ec  movz x8, 0x5d
01 00 00 d4         # 76f0  svc #0

# guard:
a0 00 80 d2         # 76f4  movz x0, 0x5   status 5 unless both guards pass
08 00 80 d2         # 76f8  movz x8, 0x0   clear x8 until accept is authorized
02 00 80 d2         # 76fc  movz x2, 0x0   pad & scrub x2
07 00 80 d2         # 7700  movz x7, 0x0   pad & scrub x7
c1 92 87 d2         # 7704  movz x1, 0x3c96   guard 1: load ACCEPT
41 ab b4 f2         # 7708  movk x1, 0xa55a, lsl #16
01 2e dd f2         # 770c  movk x1, 0xe970, lsl #32
81 59 eb f2         # 7710  movk x1, 0x5acc, lsl #48
7f 02 01 eb         # 7714  cmp x19, x1
81 01 00 54         # 7718  b.ne 0x407748   guard 1 -> not_acc
02 00 80 d2         # 771c  movz x2, 0x0   align guard 1 -> not_acc Hamming offset
c6 92 87 d2         # 7720  movz x6, 0x3c96   guard 2: load ACCEPT independently
46 ab b4 f2         # 7724  movk x6, 0xa55a, lsl #16
06 2e dd f2         # 7728  movk x6, 0xe970, lsl #32
86 59 eb f2         # 772c  movk x6, 0x5acc, lsl #48
9f 02 06 eb         # 7730  cmp x20, x6
a1 00 00 54         # 7734  b.ne 0x407748   guard 2 -> not_acc
a8 0b 80 d2         # 7738  movz x8, 0x5d   exit(0): x8 first,
80 5a 02 d1         # 773c  sub x0, x20, #150   then status = (x20 - 0x96) mod 256, zero only when (x20 & 0xff) == 0x96

# accept_svc:
01 00 00 d4         # 7740  svc #0
0c 00 00 14         # 7744  b 0x407774   -> rej_exit

# not_acc:
a1 74 98 d2         # 7748  movz x1, 0xc3a5   check OVERFLOW
61 78 a6 f2         # 774c  movk x1, 0x33c3, lsl #16
c1 e3 c1 f2         # 7750  movk x1, 0xf1e, lsl #32
a1 75 e1 f2         # 7754  movk x1, 0xbad, lsl #48
7f 02 01 eb         # 7758  cmp x19, x1
c1 00 00 54         # 775c  b.ne 0x407774   not OVERFLOW -> rej_exit

# nomem:
c0 00 80 d2         # 7760  movz x0, 0x6   exit(6) via dual-reg OR (popcount(6)=2; immune to 1-bit hw/adrp/reg)
c2 00 80 d2         # 7764  movz x2, 0x6
00 00 02 aa         # 7768  orr x0, x0, x2
a8 0b 80 d2         # 776c  movz x8, 0x5d
01 00 00 d4         # 7770  svc #0

# rej_exit:
a0 00 80 d2         # 7774  movz x0, 0x5   exit(5) via dual-reg OR (popcount(5)=2; immune to 1-bit hw/adrp/reg)
a2 00 80 d2         # 7778  movz x2, 0x5
00 00 02 aa         # 777c  orr x0, x0, x2
a8 0b 80 d2         # 7780  movz x8, 0x5d
01 00 00 d4         # 7784  svc #0
