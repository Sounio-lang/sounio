01 00 00 d4         # b8a4  svc #0
1f 00 00 f1         # b8a8  cmp x0, #0
a4 f5 fd 54         # b8ac  b.mi 0x407760   refused -> nomem
ee 03 00 aa         # b8b0  mov x14, x0   x14 = buffer
2c 00 a0 d2         # b8b4  movz x12, 0x1, lsl #16   x12 = capacity
0d 00 80 d2         # b8b8  movz x13, 0x0   x13 = length

# rd:
bf 01 0c eb         # b8bc  cmp x13, x12
61 01 00 54         # b8c0  b.ne 0x40b8ec   room left -> rd_go
e0 03 0e aa         # b8c4  mov x0, x14   mremap(buf, cap, 2*cap, MREMAP_MAYMOVE=1)
