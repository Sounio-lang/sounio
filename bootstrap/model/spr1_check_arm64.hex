01 00 00 00                     # 040  p_type   = PT_LOAD (code)
05 00 00 00                     # 044  p_flags  = PF_R | PF_X
00 00 00 00 00 00 00 00         # 048  p_offset = 0
00 00 40 00 00 00 00 00         # 050  p_vaddr  = 0x400000
00 00 40 00 00 00 00 00         # 058  p_paddr  = 0x400000
14 ba 00 00 00 00 00 00         # 060  p_filesz = whole file
