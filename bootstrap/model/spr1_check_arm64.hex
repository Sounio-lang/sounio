a1 05 00 91         # b918  add x1, x13, #1
62 00 80 d2         # b91c  movz x2, 0x3
43 04 80 d2         # b920  movz x3, 0x22
04 00 80 92         # b924  movn x4, 0x0
05 00 80 d2         # b928  movz x5, 0x0
