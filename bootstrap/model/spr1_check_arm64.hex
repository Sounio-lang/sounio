# tripled:

# p1:
ef 0f 00 f0         # 1100  adrp x15, 0x600000   0x600000   pass 1: descriptor 1
e0 01 40 f9         # 1104  ldr x0, [x15, #0]   base of input copy
ee 05 40 f9         # 1108  ldr x14, [x15, #8]   N
18 00 0e 8b         # 110c  add x24, x0, x14   p_end = base + N
df 41 00 f1         # 1110  cmp x14, #16
03 54 00 54         # 1114  b.lo 0x401b94   shorter than file header -> p1_rej
0e 00 40 b9         # 1118  ldr w14, [x0, #0]
6f 0a 8a d2         # 111c  movz x15, 0x5053   magic "SPR1"
4f 2a a6 f2         # 1120  movk x15, 0x3152, lsl #16
df 01 0f eb         # 1124  cmp x14, x15
61 53 00 54         # 1128  b.ne 0x401b94   not "SPR1" -> p1_rej
0c 04 40 b9         # 112c  ldr w12, [x0, #4]   main
01 08 40 b9         # 1130  ldr w1, [x0, #8]   nw
0f 0c 40 b9         # 1134  ldr w15, [x0, #12]   nd
0a 40 00 91         # 1138  add x10, x0, #16   first data item

# sd_top_1:
8f 01 00 b4         # 113c  cbz x15, 0x40116c   skipData: items left? -> sd_done_2
4b 11 00 91         # 1140  add x11, x10, #4
7f 01 18 eb         # 1144  cmp x11, x24
68 52 00 54         # 1148  b.hi 0x401b94   truncated length -> p1_rej
4e 01 40 b9         # 114c  ldr w14, [x10, #0]   len
ea 03 0b aa         # 1150  mov x10, x11
0b 03 0a cb         # 1154  sub x11, x24, x10   bytes left
7f 01 0e eb         # 1158  cmp x11, x14
c3 51 00 54         # 115c  b.lo 0x401b94   truncated data -> p1_rej
4a 01 0e 8b         # 1160  add x10, x10, x14
ef 05 00 d1         # 1164  sub x15, x15, #1
f5 ff ff 17         # 1168  b 0x40113c   -> sd_top_1

# sd_done_2:
f9 03 0a aa         # 116c  mov x25, x10   ws = first word
ef 03 01 aa         # 1170  mov x15, x1   nw words

# sw_top_3:
4f 05 00 b4         # 1174  cbz x15, 0x40121c   skipWords (parse): words left? -> sw_done_4
4e 51 00 91         # 1178  add x14, x10, #20
df 01 18 eb         # 117c  cmp x14, x24
a8 50 00 54         # 1180  b.hi 0x401b94   truncated word header -> p1_rej
4e 11 40 b9         # 1184  ldr w14, [x10, #16]   na
ef 81 0e 8b         # 1188  add x15, x15, x14, lsl #32   park na in high half
4b 0d 40 b9         # 118c  ldr w11, [x10, #12]   nc
4a 51 00 91         # 1190  add x10, x10, #20   first instruction

# sc_top_5:
4b 03 00 b4         # 1194  cbz x11, 0x4011fc   skipCode (parse): instructions left? -> sc_done_6
5f 01 18 eb         # 1198  cmp x10, x24   opcode byte inside input?
