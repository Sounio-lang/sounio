// boot1.sio — Stage 1: compiles fn main()->i64{print("...")N}
fn rd(b: [i8; 1048576], o: i64) -> i64 with Panic { let v=b[o as usize]; if v<0 { return v+256 }; v }
fn id(c: i64) -> i64 { if c>=48&&c<=57 { return 1 }; 0 }
fn e1(c: [i8; 262144], p: i64, b: i64) -> i64 with Mut, Panic { c[p as usize]=b as i8; p+1 }
fn e2(c: [i8; 262144], p: i64, a: i64, b: i64) -> i64 with Mut, Panic { c[p as usize]=a as i8; c[(p+1) as usize]=b as i8; p+2 }
fn e3(c: [i8; 262144], p: i64, a: i64, b: i64, d: i64) -> i64 with Mut, Panic { c[p as usize]=a as i8; c[(p+1) as usize]=b as i8; c[(p+2) as usize]=d as i8; p+3 }
fn w4(c: [i8; 262144], p: i64, v: i64) -> i64 with Mut, Panic, Div { c[p as usize]=(v&255) as i8; c[(p+1) as usize]=((v>>8)&255) as i8; c[(p+2) as usize]=((v>>16)&255) as i8; c[(p+3) as usize]=((v>>24)&255) as i8; p+4 }
fn w8(c: [i8; 262144], p: i64, v: i64) -> i64 with Mut, Panic, Div { var i: i64=0; var q=p; while i<8 { c[q as usize]=((v>>(i*8))&255) as i8; q=q+1; i=i+1 }; q }
fn mi(c: [i8; 262144], p: i64, v: i64) -> i64 with Mut, Panic, Div { var q=e2(c,p,0x48,0xB8); w8(c,q,v) }
fn wh(o: [i8; 262144], en: i64, fs: i64, ba: i64) -> i64 with Mut, Panic, Div { o[0 as usize]=0x7F as i8; o[1 as usize]=69 as i8; o[2 as usize]=76 as i8; o[3 as usize]=70 as i8; o[4 as usize]=2 as i8; o[5 as usize]=1 as i8; o[6 as usize]=1 as i8; o[16 as usize]=2 as i8; o[18 as usize]=0x3E as i8; o[20 as usize]=1 as i8; var i: i64=0; while i<8 { o[(24+i) as usize]=((en>>(i*8))&255) as i8; i=i+1 }; o[32 as usize]=64 as i8; o[52 as usize]=64 as i8; o[54 as usize]=56 as i8; o[56 as usize]=1 as i8; o[64 as usize]=1 as i8; o[68 as usize]=7 as i8; i=0; while i<8 { o[(80+i) as usize]=((ba>>(i*8))&255) as i8; i=i+1 }; i=0; while i<8 { o[(88+i) as usize]=((ba>>(i*8))&255) as i8; i=i+1 }; i=0; while i<8 { o[(96+i) as usize]=((fs>>(i*8))&255) as i8; i=i+1 }; let ms=fs+4194304; i=0; while i<8 { o[(104+i) as usize]=((ms>>(i*8))&255) as i8; i=i+1 }; o[113 as usize]=0x10 as i8; 0 }
fn ep(c: [i8; 262144], cp: i64, s: [i8; 1048576], so: i64, sl: i64) -> i64 with Panic, Mut, Div {
    var p=cp; var dl: i64=0; var si: i64=0
    while si<sl { let ch=rd(s,so+si); if ch==92 { si=si+2 } else { si=si+1 }; dl=dl+1 }
    p=e2(c,p,0xEB,dl); let ss=p; si=0
    while si<sl { let ch=rd(s,so+si); if ch==92&&si+1<sl { let ec=rd(s,so+si+1); if ec==110 { c[p as usize]=10 as i8 } else { c[p as usize]=ec as i8 }; p=p+1; si=si+2 } else { c[p as usize]=ch as i8; p=p+1; si=si+1 } }
    let ro=0-(p+7-ss); p=e3(c,p,0x48,0x8D,0x35); p=w4(c,p,ro); p=e1(c,p,0xBA); p=w4(c,p,dl); p=e1(c,p,0xBF); p=w4(c,p,1); p=e1(c,p,0xB8); p=w4(c,p,1); e2(c,p,0x0F,0x05) }
fn main() -> i64 with IO, Mut, Panic, Div {
    if arg_count()<2 { print("Usage: boot1 <src> <out>\n"); return 1 }
    let sp=get_arg(0); let op=get_arg(1); let ss=file_size(sp); let s: [i8; 1048576]=read_file(sp)
    var c: [i8; 262144]=[0; 262144]; var cp: i64=16
    cp=e1(c,cp,0x55); cp=e3(c,cp,0x48,0x89,0xE5); cp=e3(c,cp,0x48,0x81,0xEC); cp=w4(c,cp,2048)
    var p: i64=0; while p<ss&&rd(s,p)!=123 { p=p+1 }; if p<ss { p=p+1 }
    while p<ss&&rd(s,p)!=125 { while p<ss { let x=rd(s,p); if x==32||x==9||x==13||x==10 { p=p+1 } else { break } }; if p>=ss||rd(s,p)==125 { break }; if rd(s,p)==112&&p+5<ss&&rd(s,p+5)==40 { p=p+6; while p<ss&&rd(s,p)!=34 { p=p+1 }; if p<ss { p=p+1; let st=p; while p<ss&&rd(s,p)!=34 { if rd(s,p)==92 { p=p+2 } else { p=p+1 } }; let se=p; if p<ss { p=p+1 }; cp=ep(c,cp,s,st,se-st); while p<ss&&rd(s,p)!=41 { p=p+1 }; if p<ss { p=p+1 } }
    } else if id(rd(s,p))==1 { var v: i64=0; while p<ss&&id(rd(s,p))==1 { v=v*10+rd(s,p)-48; p=p+1 }; cp=mi(c,cp,v) } else { p=p+1 } }
    cp=e2(c,cp,0xC9,0xC3); let tr=cp; cp=e3(c,cp,0x48,0x89,0x25); cp=w4(c,cp,0-(cp+4)); cp=e1(c,cp,0xE8); cp=w4(c,cp,16-(cp+4)); cp=e2(c,cp,0x89,0xC7); cp=e1(c,cp,0xB8); cp=w4(c,cp,60); cp=e2(c,cp,0x0F,0x05)
    var ef: [i8; 262144]=[0; 262144]; let ba: i64=0x400000; let fs=4096+cp; wh(ef,ba+4096+tr,fs,ba); var ci: i64=0; while ci<cp { ef[(4096+ci) as usize]=c[ci as usize]; ci=ci+1 }; write_file(op,ef,fs); 0
}
