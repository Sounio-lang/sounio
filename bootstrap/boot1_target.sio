fn rd(b: [i8; 1048576], o: i64) -> i64 with Panic { let v = b[o as usize]; if v < 0 { return v + 256 }; v }
fn is_alpha(c: i64) -> i64 { if c >= 97 { if c <= 122 { return 1 } }; if c >= 65 { if c <= 90 { return 1 } }; if c == 95 { return 1 }; 0 }
fn is_digit(c: i64) -> i64 { if c >= 48 { if c <= 57 { return 1 } }; 0 }
fn is_alnum(c: i64) -> i64 { if is_alpha(c) == 1 { return 1 }; is_digit(c) }
fn e1(c: [i8; 262144], p: i64, b: i64) -> i64 with Mut, Panic { c[p as usize] = b as i8; p + 1 }
fn e2(c: [i8; 262144], p: i64, a: i64, b: i64) -> i64 with Mut, Panic { c[p as usize] = a as i8; c[(p+1) as usize] = b as i8; p + 2 }
fn e3(c: [i8; 262144], p: i64, a: i64, b: i64, d: i64) -> i64 with Mut, Panic { c[p as usize] = a as i8; c[(p+1) as usize] = b as i8; c[(p+2) as usize] = d as i8; p + 3 }
fn w4(c: [i8; 262144], p: i64, v: i64) -> i64 with Mut, Panic, Div { c[p as usize] = (v&255) as i8; c[(p+1) as usize] = ((v>>8)&255) as i8; c[(p+2) as usize] = ((v>>16)&255) as i8; c[(p+3) as usize] = ((v>>24)&255) as i8; p + 4 }
fn w8(c: [i8; 262144], p: i64, v: i64) -> i64 with Mut, Panic, Div { var i: i64 = 0; var q = p; while i < 8 { c[q as usize] = ((v >> (i*8))&255) as i8; q = q + 1; i = i + 1 }; q }
fn mi(c: [i8; 262144], p: i64, v: i64) -> i64 with Mut, Panic, Div { var q = e2(c, p, 0x48, 0xB8); w8(c, q, v) }
fn ep(c: [i8; 262144], cp: i64, src: [i8; 1048576], so: i64, sl: i64) -> i64 with Panic, Mut, Div {
    var p = cp; var dlen: i64 = 0; var si: i64 = 0
    while si < sl { if rd(src, so+si) == 92 { si = si + 2 } else { si = si + 1 }; dlen = dlen + 1 }
    p = e2(c, p, 0xEB, dlen); let ss = p; si = 0
    while si < sl {
        let ch = rd(src, so+si)
        if ch == 92 { if si+1 < sl { let ec = rd(src, so+si+1); if ec == 110 { c[p as usize] = 10 as i8 } else { c[p as usize] = ec as i8 }; p = p + 1; si = si + 2 } else { c[p as usize] = ch as i8; p = p + 1; si = si + 1 }
        } else { c[p as usize] = ch as i8; p = p + 1; si = si + 1 }
    }
    let ro = 0 - (p+7-ss); p = e3(c, p, 0x48, 0x8D, 0x35); p = w4(c, p, ro)
    p = e1(c, p, 0xBA); p = w4(c, p, dlen); p = e1(c, p, 0xBF); p = w4(c, p, 1)
    p = e1(c, p, 0xB8); p = w4(c, p, 1); e2(c, p, 0x0F, 0x05)
fn scan(code: [i8; 262144], cp_in: i64, src: [i8; 1048576], ss: i64) -> i64 with Mut, Panic, Div {
    var cp = cp_in
    var pos: i64 = 0
    while pos < ss { if rd(src, pos) == 123 { pos = pos + 1; break }; pos = pos + 1 }
    while pos < ss {
        if rd(src, pos) == 125 { break }
        let ch = rd(src, pos)
        if ch == 32 || ch == 10 || ch == 13 || ch == 9 { pos = pos + 1 }
        else {
            if ch == 112 {
                pos = pos + 6
                while pos < ss { if rd(src, pos) == 34 { break }; pos = pos + 1 }
                if pos < ss { pos = pos + 1 }
                let st = pos
                while pos < ss { if rd(src, pos) == 34 { break }; if rd(src, pos) == 92 { pos = pos + 2 } else { pos = pos + 1 } }
                let se = pos
                if pos < ss { pos = pos + 1 }
                cp = ep(code, cp, src, st, se - st)
                while pos < ss { if rd(src, pos) == 41 { break }; pos = pos + 1 }
                if pos < ss { pos = pos + 1 }
            } else {
                if is_digit(ch) == 1 {
                    var val: i64 = 0
                    while pos < ss { if is_digit(rd(src, pos)) != 1 { break }; val = val * 10 + rd(src, pos) - 48; pos = pos + 1 }
                    cp = mi(code, cp, val)
                } else {
                    if is_alpha(ch) == 1 { while pos < ss { if is_alnum(rd(src, pos)) != 1 { break }; pos = pos + 1 } }
                    else { pos = pos + 1 }
                }
            }
        }
    }
    cp
}
fn main() -> i64 with IO, Mut, Panic, Div {
    if arg_count() < 2 { return 1 }
    let sp = get_arg(0); let op = get_arg(1)
    let ss = file_size(sp)
    let src: [i8; 1048576] = read_file(sp)
    var code: [i8; 262144] = [0; 262144]
    var cp: i64 = 16
    cp = e1(code, cp, 0x55); cp = e3(code, cp, 0x48, 0x89, 0xE5); cp = e3(code, cp, 0x48, 0x81, 0xEC); cp = w4(code, cp, 2048)
    cp = scan(code, cp, src, ss)
    cp = e2(code, cp, 0xC9, 0xC3)
    let tramp = cp; cp = e3(code, cp, 0x48, 0x89, 0x25); cp = w4(code, cp, 0 - (cp + 4)); cp = e1(code, cp, 0xE8); cp = w4(code, cp, 16 - (cp + 4)); cp = e2(code, cp, 0x89, 0xC7); cp = e1(code, cp, 0xB8); cp = w4(code, cp, 60); cp = e2(code, cp, 0x0F, 0x05)
    var elf: [i8; 262144] = [0; 262144]
    let base: i64 = 0x400000; let entry = base + 4096 + tramp; let fsz = 4096 + cp
    elf[0 as usize]=0x7F as i8; elf[1 as usize]=69 as i8; elf[2 as usize]=76 as i8; elf[3 as usize]=70 as i8; elf[4 as usize]=2 as i8; elf[5 as usize]=1 as i8; elf[6 as usize]=1 as i8; elf[16 as usize]=2 as i8; elf[18 as usize]=0x3E as i8; elf[20 as usize]=1 as i8
    var i: i64=0; while i<8 { elf[(24+i) as usize]=((entry>>(i*8))&255) as i8; i=i+1 }
    elf[32 as usize]=64 as i8; elf[52 as usize]=64 as i8; elf[54 as usize]=56 as i8; elf[56 as usize]=1 as i8; elf[64 as usize]=1 as i8; elf[68 as usize]=7 as i8
    i=0; while i<8 { elf[(80+i) as usize]=((base>>(i*8))&255) as i8; i=i+1 }; i=0; while i<8 { elf[(88+i) as usize]=((base>>(i*8))&255) as i8; i=i+1 }
    i=0; while i<8 { elf[(96+i) as usize]=((fsz>>(i*8))&255) as i8; i=i+1 }; let msz=fsz+4194304; i=0; while i<8 { elf[(104+i) as usize]=((msz>>(i*8))&255) as i8; i=i+1 }
    elf[113 as usize]=0x10 as i8
    var ci: i64=0; while ci<cp { elf[(4096+ci) as usize]=code[ci as usize]; ci=ci+1 }
    write_file(op, elf, fsz)
    print("boot1: wrote "); print_int(fsz); print(" bytes\n")
    0
}
