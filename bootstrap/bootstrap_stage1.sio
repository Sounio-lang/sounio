fn test_jc_should_compile_warm_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < JC_WARM_THRESHOLD {
        let c = jc_record_call(cache, 1104)
        i = i + 1
    }
