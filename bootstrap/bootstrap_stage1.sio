// file_write.sio — Shared file I/O helpers for self-hosted compile flows.


// NOTE: lexer::mod import removed to avoid transitive parser::ast::* stack overflow.
// io_read_source_file (which needs LexerState) moved to io::source_reader.sio.

fn io_write_bytes_to_file(path: string, data: [i8; 65536], len: i64) -> bool with IO {
    let result = write_file(path, data, len)
    result >= 0
}

fn io_write_elf_to_file(path: string, elf: Elf64Binary) -> bool with IO, Mut {
    let result = write_file(path, elf.bytes, elf.len)
    result == 0
}

fn io_write_native_binary(path: string, bytes: [i8; 65536], len: i64) -> bool with IO {
    io_write_bytes_to_file(path, bytes, len)
}

fn io_write_wide_binary(path: string, bytes: [i8; 262144], len: i64) -> bool with IO {
    let result = write_file(path, bytes, len)
    result == 0
}

fn io_write_huge_binary(path: string, bytes: [i8; 16777216], len: i64) -> bool with IO {
    let result = write_file(path, bytes, len)
    result == 0
}


fn io_trace_append_byte(buf: [i8; 65536], pos: i64, b: i64) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var n = b % 256
    if n < 0 { n = n + 256 }
    if p >= 0 && p < 65536 {
        out[p as usize] = n as i8
        p = p + 1
    }
    (out, p)
}

fn io_trace_append_string(buf: [i8; 65536], pos: i64, s: string) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var i: i64 = 0
    let n = str_len(s)
    while i < n && p < 65536 {
        out[p as usize] = str_char_at(s, i) as i8
        p = p + 1
        i = i + 1
    }
    (out, p)
}

fn io_trace_append_json_string(buf: [i8; 65536], pos: i64, s: string) -> ([i8; 65536], i64) with Mut, Panic, Div {
    var out = buf
    var p = pos
    var i: i64 = 0
    let n = str_len(s)
    while i < n && p < 65536 {
        let ch = str_char_at(s, i)
        if ch == 34 {
            let pair1 = io_trace_append_byte(out, p, 92)   // '\'
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 34)   // '"'
            out = pair2.0
            p = pair2.1
        } else if ch == 92 {
            let pair1 = io_trace_append_byte(out, p, 92)   // '\'
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 92)   // '\'
            out = pair2.0
            p = pair2.1
        } else if ch == 10 {
            let pair1 = io_trace_append_byte(out, p, 92)   // '\'
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 110)  // 'n'
            out = pair2.0
            p = pair2.1
        } else if ch == 13 {
            let pair1 = io_trace_append_byte(out, p, 92)   // '\'
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 114)  // 'r'
            out = pair2.0
            p = pair2.1
        } else if ch == 9 {
            let pair1 = io_trace_append_byte(out, p, 92)   // '\'
            out = pair1.0
            p = pair1.1
            let pair2 = io_trace_append_byte(out, p, 116)  // 't'
            out = pair2.0
            p = pair2.1
        } else {
            let pair = io_trace_append_byte(out, p, ch)
            out = pair.0
            p = pair.1
        }
        i = i + 1
    }
    (out, p)
}

fn io_trace_bool_string(v: bool) -> string {
    if v { "true" } else { "false" }
}

fn io_trace_i64_string(v: i64) -> string with Mut, Panic, Div {
    if v == 0 { return "0" }

    var n = v
    var neg: bool = false
    if n < 0 {
        neg = true
        n = 0 - n
    }

    var rev: [i8; 32] = [0; 32]
    var rev_len: i64 = 0
    while n > 0 && rev_len < 31 {
        let digit = n % 10
        rev[rev_len as usize] = (48 + digit) as i8
        rev_len = rev_len + 1
        n = n / 10
    }

    var out: [i8; 64] = [0; 64]
    var out_len: i64 = 0
    if neg {
        out[out_len as usize] = 45 as i8
        out_len = out_len + 1
    }

    var i = rev_len - 1
    while i >= 0 {
        out[out_len as usize] = rev[i as usize]
        out_len = out_len + 1
        if i == 0 { break }
        i = i - 1
    }
    str_from_bytes(out, out_len)
}

fn io_write_native_decision_trace(
    path: string,
    requested_target: string,
    resolved_target: string,
    matrix_mode: string,
    source: string,
    fallback_reason: string,
    backend: string,
    ok: bool,
    error_code: i64
) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0

    let p0 = io_trace_append_byte(buf, p, 123) // {
    buf = p0.0; p = p0.1

    let p1 = io_trace_append_string(buf, p, "\"requested_target\":\"")
    buf = p1.0; p = p1.1
    let p2 = io_trace_append_json_string(buf, p, requested_target)
    buf = p2.0; p = p2.1
    let p3 = io_trace_append_string(buf, p, "\",")
    buf = p3.0; p = p3.1

    let p4 = io_trace_append_string(buf, p, "\"resolved_target\":\"")
    buf = p4.0; p = p4.1
    let p5 = io_trace_append_json_string(buf, p, resolved_target)
    buf = p5.0; p = p5.1
    let p6 = io_trace_append_string(buf, p, "\",")
    buf = p6.0; p = p6.1

    let p7 = io_trace_append_string(buf, p, "\"matrix_mode\":\"")
    buf = p7.0; p = p7.1
    let p8 = io_trace_append_json_string(buf, p, matrix_mode)
    buf = p8.0; p = p8.1
    let p9 = io_trace_append_string(buf, p, "\",")
    buf = p9.0; p = p9.1

    let p10 = io_trace_append_string(buf, p, "\"source\":\"")
    buf = p10.0; p = p10.1
    let p11 = io_trace_append_json_string(buf, p, source)
    buf = p11.0; p = p11.1
    let p12 = io_trace_append_string(buf, p, "\",")
    buf = p12.0; p = p12.1

    let p13 = io_trace_append_string(buf, p, "\"fallback_reason\":\"")
    buf = p13.0; p = p13.1
    let p14 = io_trace_append_json_string(buf, p, fallback_reason)
    buf = p14.0; p = p14.1
    let p15 = io_trace_append_string(buf, p, "\",")
    buf = p15.0; p = p15.1

    let p16 = io_trace_append_string(buf, p, "\"backend\":\"")
    buf = p16.0; p = p16.1
    let p17 = io_trace_append_json_string(buf, p, backend)
    buf = p17.0; p = p17.1
    let p18 = io_trace_append_string(buf, p, "\",")
    buf = p18.0; p = p18.1

    let p19 = io_trace_append_string(buf, p, "\"ok\":")
    buf = p19.0; p = p19.1
    let p20 = io_trace_append_string(buf, p, io_trace_bool_string(ok))
    buf = p20.0; p = p20.1
    let p21 = io_trace_append_string(buf, p, ",")
    buf = p21.0; p = p21.1

    let p22 = io_trace_append_string(buf, p, "\"error_code\":")
    buf = p22.0; p = p22.1
    let p23 = io_trace_append_string(buf, p, io_trace_i64_string(error_code))
    buf = p23.0; p = p23.1

    let p24 = io_trace_append_byte(buf, p, 125) // }
    buf = p24.0; p = p24.1
    let p25 = io_trace_append_byte(buf, p, 10)  // newline
    buf = p25.0; p = p25.1

    io_write_bytes_to_file(path, buf, p)
}



fn io_write_diagnostics_json(path: string, diags: KernelDiagnostics) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1
    let p0a = io_trace_append_byte(buf, p, 34)
    buf = p0a.0; p = p0a.1
    let p0b = io_trace_append_string(buf, p, "diagnostics")
    buf = p0b.0; p = p0b.1
    let p0c = io_trace_append_byte(buf, p, 34)
    buf = p0c.0; p = p0c.1
    let p0d = io_trace_append_string(buf, p, ":[")
    buf = p0d.0; p = p0d.1
    var i: i64 = 0
    while i < diags.count {
        if i > 0 {
            let pc = io_trace_append_byte(buf, p, 44)
            buf = pc.0; p = pc.1
        }
        let pa = io_trace_append_byte(buf, p, 123)
        buf = pa.0; p = pa.1
        let pa1 = io_trace_append_byte(buf, p, 34)
        buf = pa1.0; p = pa1.1
        let pa2 = io_trace_append_string(buf, p, "severity")
        buf = pa2.0; p = pa2.1
        let pa3 = io_trace_append_byte(buf, p, 34)
        buf = pa3.0; p = pa3.1
        let pa4 = io_trace_append_string(buf, p, ":")
        buf = pa4.0; p = pa4.1
        let pa5 = io_trace_append_string(buf, p, io_trace_i64_string(diags.items[i as usize].severity))
        buf = pa5.0; p = pa5.1
        let pb = io_trace_append_string(buf, p, ",")
        buf = pb.0; p = pb.1
        let pb1 = io_trace_append_byte(buf, p, 34)
        buf = pb1.0; p = pb1.1
        let pb2 = io_trace_append_string(buf, p, "line")
        buf = pb2.0; p = pb2.1
        let pb3 = io_trace_append_byte(buf, p, 34)
        buf = pb3.0; p = pb3.1
        let pb4 = io_trace_append_string(buf, p, ":")
        buf = pb4.0; p = pb4.1
        let pb5 = io_trace_append_string(buf, p, io_trace_i64_string(diags.items[i as usize].line))
        buf = pb5.0; p = pb5.1
        let pcc = io_trace_append_string(buf, p, ",")
        buf = pcc.0; p = pcc.1
        let pc1 = io_trace_append_byte(buf, p, 34)
        buf = pc1.0; p = pc1.1
        let pc2 = io_trace_append_string(buf, p, "code")
        buf = pc2.0; p = pc2.1
        let pc3 = io_trace_append_byte(buf, p, 34)
        buf = pc3.0; p = pc3.1
        let pc4 = io_trace_append_string(buf, p, ":")
        buf = pc4.0; p = pc4.1
        let pc5 = io_trace_append_string(buf, p, io_trace_i64_string(diags.items[i as usize].code))
        buf = pc5.0; p = pc5.1
        let pd = io_trace_append_byte(buf, p, 125)
        buf = pd.0; p = pd.1
        i = i + 1
    }
    let pe = io_trace_append_string(buf, p, "]}")
    buf = pe.0; p = pe.1
    let pf = io_trace_append_byte(buf, p, 10)
    buf = pf.0; p = pf.1
    io_write_bytes_to_file(path, buf, p)
}

fn io_write_promotions_json(path: string, summary: PromotionSummary) -> bool with IO, Mut, Panic, Div {
    var buf: [i8; 65536] = [0; 65536]
    var p: i64 = 0
    let p0 = io_trace_append_byte(buf, p, 123)
    buf = p0.0; p = p0.1
    let p0a = io_trace_append_byte(buf, p, 34)
    buf = p0a.0; p = p0a.1
    let p0b = io_trace_append_string(buf, p, "promotions")
    buf = p0b.0; p = p0b.1
    let p0c = io_trace_append_byte(buf, p, 34)
    buf = p0c.0; p = p0c.1
    let p0d = io_trace_append_string(buf, p, ":[")
    buf = p0d.0; p = p0d.1
    var i: i64 = 0
    while i < summary.count {
        if i > 0 {
            let pc = io_trace_append_byte(buf, p, 44)
            buf = pc.0; p = pc.1
        }
        let pa = io_trace_append_byte(buf, p, 123)
        buf = pa.0; p = pa.1
        let pa1 = io_trace_append_byte(buf, p, 34)
        buf = pa1.0; p = pa1.1
        let pa2 = io_trace_append_string(buf, p, "count")
        buf = pa2.0; p = pa2.1
        let pa3 = io_trace_append_byte(buf, p, 34)
        buf = pa3.0; p = pa3.1
        let pa4 = io_trace_append_string(buf, p, ":")
        buf = pa4.0; p = pa4.1
        let pa5 = io_trace_append_string(buf, p, io_trace_i64_string(summary.records[i as usize].call_count))
        buf = pa5.0; p = pa5.1
        let pb = io_trace_append_string(buf, p, ",")
        buf = pb.0; p = pb.1
        let pb1 = io_trace_append_byte(buf, p, 34)
        buf = pb1.0; p = pb1.1
        let pb2 = io_trace_append_string(buf, p, "new_strategy")
