    let arr = loc_add_array(ctx, 8000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    let a1 = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let a2 = loc_add_access(ctx, arr, 0, 0, LocStrideKind::StrideConstant, lp, 8, 2)
    let count = loc_compute_all_reuse(ctx)
    if count != 2 { return false }
    if ctx.reuse_count != 2 { return false }
    true
}
fn test_loc_compute_all_reuse() -> bool with Mut, Div, Panic {
