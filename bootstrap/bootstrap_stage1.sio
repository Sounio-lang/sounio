    let loc_r1 = lspg_location_new(1, 5, 0, 5, 5)
    let loc_r2 = lspg_location_new(1, 8, 0, 8, 5)
    let r1 = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r1)
    let r2 = lspg_add_reference(ctx, def_id, LspgRefKind::RefRead, loc_r2)
    let _ = r1
    let _ = r2
    lspg_build_def_map(ctx)
    lspg_build_ref_index(ctx)
    let sym_idx = lspg_find_symbol_by_hash(ctx, 100)
    ctx.symbols[sym_idx as usize].ref_count == 2
}
fn test_lspg_build_ref_index() -> bool with Mut, Div, Panic {
    var ctx = lspg_context_new()
    test_lspg_build_ref_index_inner(&! ctx)
}

