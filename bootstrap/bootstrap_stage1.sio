// T40: handle definition -- success
fn test_lspg_handle_def_ok_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    lspg_set_current_file(ctx, 1)
    let loc_d = lspg_location_new(1, 1, 0, 1, 10)
    let def_id = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc_d, 0)
    let loc_r = lspg_location_new(1, 5, 3, 5, 8)
    let ref_id = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r)
    let _ = ref_id
    let ok = lspg_handle_definition(ctx, 5, 5)
    let count = lspg_result_count(ctx)
    let result = lspg_result_at(ctx, 0)
    ok && count == 1 && lspg_location_eq(&result, &loc_d)
}
