// Main name resolution pass
//
// Two-pass algorithm:
//   Pass 1 — collect all top-level items (fn, struct, enum, type alias, impl)
//            into the global scope, enabling forward references.
//   Pass 2 — walk each item body, resolving identifiers and paths
//            against the symbol table with lexical scoping.
//
// Methods return (Resolver, ...) to thread state through value semantics.



// ============================================================
// Resolver state
// ============================================================

struct Resolver {
    symbols: SymbolTable,
    scopes: ScopeStack,
    modules: ModuleRegistry,
    error_count: i64,
    had_error: bool,
    next_id: i64,
}

fn resolver_new() -> Resolver {
    Resolver {
        symbols: symbol_table_new(),
        scopes: scope_stack_new(),
        modules: module_registry_new(),
        error_count: 0,
        had_error: false,
        next_id: 0,
    }
}

fn resolver_with_modules(mods: ModuleRegistry) -> Resolver {
    Resolver {
        symbols: symbol_table_new(),
        scopes: scope_stack_new(),
        modules: mods,
        error_count: 0,
        had_error: false,
        next_id: 0,
    }
}

// ============================================================
// Core operations — define, lookup, scoping, errors
// ============================================================

impl Resolver {
    fn fresh_id(self) -> (Resolver, i64) with Mut {
        var r = self
        let id = r.next_id
        r.next_id = r.next_id + 1
        (r, id)
    }

    fn define(self, name: Name, kind: SymbolKind, span: Span) -> Resolver with Mut, Panic, Div {
        var r = self
        let pair = r.fresh_id()
        r = pair.0
        let id = pair.1
        let sym = Symbol {
            name: name,
            kind: kind,
            def_span: span,
            scope_depth: r.scopes.depth,
            sym_id: id,
        }
        r.symbols = r.symbols.add(sym)
        r
    }

    fn push_scope(self) -> Resolver with Mut, Panic, Div {
        var r = self
        r.scopes = r.scopes.push(r.symbols.count)
        r
    }

    fn pop_scope(self) -> Resolver with Mut {
        var r = self
        r.scopes = r.scopes.pop()
        r
    }

    // Lookup: scan symbols in reverse for innermost binding
    fn lookup(self, name: Name) -> i64 with Mut, Panic, Div {
        var i = self.symbols.count - 1
        while i >= 0 {
            let sym = self.symbols.get(i)
            if name_eq(sym.name, name) {
                return sym.sym_id
            }
            i = i - 1
        }
        -1
    }

    // Lookup restricted to current scope only (for duplicate detection)
    fn lookup_in_current_scope(self, name: Name) -> bool with Mut, Panic, Div {
        let start = self.scopes.current_start()
        var i = self.symbols.count - 1
        while i >= start {
            let sym = self.symbols.get(i)
            if name_eq(sym.name, name) {
                return true
            }
            i = i - 1
        }
        false
    }

    fn report_error(self, span: Span) -> Resolver with Mut, IO {
        var r = self
        r.error_count = r.error_count + 1
        r.had_error = true
        r
    }
}

// ============================================================
// Pass 1: Collect top-level declarations
// ============================================================

impl Resolver {
    fn collect_items(self, items: Option<Box<ItemList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match items {
            Some(list) => {
                var r = self.collect_item((*list).head)
                r.collect_items((*list).tail)
            }
            None => self
        }
    }

    fn collect_item(self, item: Item) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemFn => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymFunction, item.span)
                } else {
                    self
                }
            }
            ItemStruct => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymStruct, item.span)
                } else {
                    self
                }
            }
            ItemEnum => {
                var r = self
                if !name_is_empty(item.name) {
                    r = r.define(item.name, SymbolKind::SymEnum, item.span)
                }
                // Also collect enum variants as top-level names
                r.collect_enum_variants(item.enum_def)
            }
            ItemTypeAlias => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemModels => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymPolicy, item.span)
                } else {
                    self
                }
            }
            ItemAcquisitionPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAcquisitionPolicy, item.span)
                } else {
                    self
                }
            }
            ItemRecoursePolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymRecoursePolicy, item.span)
                } else {
                    self
                }
            }
            ItemTransitionPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTransitionPolicy, item.span)
                } else {
                    self
                }
            }
            ItemTransitionProtocol => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTransitionProtocol, item.span)
                } else {
                    self
                }
            }
            ItemMonitoringPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymMonitoringPolicy, item.span)
                } else {
                    self
                }
            }
            ItemAlternativePolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAlternativePolicy, item.span)
                } else {
                    self
                }
            }
            ItemAlternativeFrontier => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAlternativeFrontier, item.span)
                } else {
                    self
                }
            }
            ItemDecisionPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymDecisionPolicy, item.span)
                } else {
                    self
                }
            }
            ItemDeferralPolicy => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymDeferralPolicy, item.span)
                } else {
                    self
                }
            }
            ItemValidation => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymPolicy, item.span)
                } else {
                    self
                }
            }
            ItemAudit => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymAudit, item.span)
                } else {
                    self
                }
            }
            ItemImpl => self
            ItemUse => {
                if self.modules.count > 0 {
                    // Cross-module import mode: validate and import from registry
                    self.import_use(item.use_path, item.use_glob, item.use_items, item.span)
                } else {
                    // Flat mode: treat selective imports as defining names (no validation yet)
                    self.collect_use_items(item.use_items, item.span)
                }
            }
            ItemUnit => {
                // Register unit declarations as SymUnit (checker handles dimensional analysis)
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymUnit, item.span)
                } else {
                    self
                }
            }
            ItemEffect => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymEffect, item.span)
                } else {
                    self
                }
            }
            ItemTrait => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
            ItemSession => {
                if !name_is_empty(item.name) {
                    self.define(item.name, SymbolKind::SymTypeAlias, item.span)
                } else {
                    self
                }
            }
        }
    }

    fn collect_use_items(self, items: Option<Box<ImportItemList>>, span: Span) -> Resolver with Mut, Panic, Div, Alloc {
        match items {
            None => self  // glob or whole-module — handled by flat mode
            Some(list) => {
                var r = self
                if !name_is_empty((*list).head) {
                    r = r.define((*list).head, SymbolKind::SymImported, span)
                }
                r.collect_use_items((*list).tail, span)
            }
        }
    }

    fn import_use(
        self,
        path: AstPath,
        is_glob: bool,
        items: Option<Box<ImportItemList>>,
        span: Span
    ) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self
        let idx = module_registry_find(r.modules, path)
        if idx < 0 {
            return r.report_error(span)
        }

        let entry = r.modules.modules[idx as usize]

        // Whole-module import (`use foo::bar`): define the last segment name so `bar::x` paths resolve.
        if !is_glob && items == None {
            let mod_name = copy_string_list_tail_to_name(path.segments)
            if !name_is_empty(mod_name) {
                r = r.define(mod_name, SymbolKind::SymImported, span)
            }
            return r
        }

        // Glob import (`use foo::*`): import all exports.
        if is_glob {
            var i: i64 = 0
            while i < entry.export_count && i < 1024 {
                r = r.define(entry.exports[i as usize].name, SymbolKind::SymImported, span)
                i = i + 1
            }
            return r
        }

        // Selective import (`use foo::{A, B}`): import only requested names, validating exports.
        r.import_use_items(entry, items, span)
    }

    fn import_use_items(self, entry: ModuleEntry, items: Option<Box<ImportItemList>>, span: Span) -> Resolver
        with Mut, Panic, Div, Alloc, IO {
        match items {
            None => self
            Some(list) => {
                var r = self
                let name = (*list).head
                if module_entry_contains(entry, name) {
                    r = r.define(name, SymbolKind::SymImported, span)
                } else {
                    r = r.report_error(span)
                }
                r.import_use_items(entry, (*list).tail, span)
            }
        }
    }

    fn collect_enum_variants(self, opt: Option<Box<EnumDef>>) -> Resolver with Mut, Panic, Div, Alloc {
        match opt {
            Some(ed) => self.collect_variant_list((*ed).variants)
            None => self
        }
    }

    fn collect_variant_list(self, opt: Option<Box<VariantDefList>>) -> Resolver with Mut, Panic, Div, Alloc {
        match opt {
            Some(list) => {
                var r = self.define((*list).head.name, SymbolKind::SymEnumVariant, (*list).head.span)
                r.collect_variant_list((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Pass 2: Resolve all items
// ============================================================

impl Resolver {
    fn resolve_items(self, items: Option<Box<ItemList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match items {
            Some(list) => {
                var r = self.resolve_item((*list).head)
                r.resolve_items((*list).tail)
            }
            None => self
        }
    }

    fn resolve_item(self, item: Item) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemFn => self.resolve_fn_def(item.fn_def)
            ItemStruct => self.resolve_struct_def(item.struct_def)
            ItemEnum => self  // variants already collected, no bodies to resolve
            ItemImpl => self.resolve_impl_def(item.impl_def)
            ItemTypeAlias => self.resolve_type_alias(item.type_alias_ty)
            ItemModels => self.resolve_models_def(item.models_def)
            ItemPolicy => self.resolve_policy_def(item.policy_def)
            ItemAcquisitionPolicy => self.resolve_acquisition_policy_def(item.acquisition_policy_def)
            ItemRecoursePolicy => self.resolve_recourse_policy_def(item.recourse_policy_def)
            ItemTransitionPolicy => self.resolve_transition_policy_def(item.transition_policy_def)
            ItemTransitionProtocol => self.resolve_transition_protocol_def(item.transition_protocol_def)
            ItemMonitoringPolicy => self.resolve_monitoring_policy_def(item.monitoring_policy_def)
            ItemAlternativePolicy => self.resolve_alternative_policy_def(item.alternative_policy_def)
            ItemAlternativeFrontier => self.resolve_alternative_frontier_def(item.alternative_frontier_def)
            ItemDecisionPolicy => self.resolve_decision_policy_def(item.decision_policy_def)
            ItemDeferralPolicy => self.resolve_deferral_policy_def(item.deferral_policy_def)
            ItemValidation => self.resolve_validation_def(item.validation_def)
            ItemAudit => self.resolve_audit_def(item.audit_def)
            ItemUse => {
                // Imports are validated during pass 1 for multi-module mode.
                // Flat mode keeps legacy behavior.
                if self.modules.count > 0 { self } else { self.validate_use_items(item.use_items, item.span) }
            }
            ItemUnit => self  // Unit declarations have no body to resolve
            ItemEffect => self
            ItemSession => self
            ItemTrait => self  // Trait methods resolved via checker's collect pass
        }
    }

    // --------------------------------------------------------
    // Import validation
    // --------------------------------------------------------

    fn validate_use_items(self, items: Option<Box<ImportItemList>>, span: Span) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match items {
            None => self  // glob or whole-module — nothing to validate
            Some(list) => {
                var r = self
                // In flat mode, all symbols are in scope, so lookup succeeds trivially.
                // When a real module loader exists, this validates against the module's exports.
                let found = r.lookup((*list).head)
                if found < 0 {
                    // Symbol not found — emit error (in flat mode this won't happen)
                    r = r.report_error(span)
                }
                r.validate_use_items((*list).tail, span)
            }
        }
    }

    // --------------------------------------------------------
    // Function
    // --------------------------------------------------------

    fn resolve_fn_def(self, opt: Option<Box<FnDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                var r = self.push_scope()
                r = r.resolve_params((*fd).params)
                r = r.resolve_opt_type((*fd).return_type)
                r = r.resolve_block((*fd).body)
                r.pop_scope()
            }
            None => self
        }
    }

    fn resolve_params(self, opt: Option<Box<ParamList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_param((*list).head)
                r.resolve_params((*list).tail)
            }
            None => self
        }
    }

    fn resolve_param(self, p: Param) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.resolve_type_expr(p.ty)
        if p.is_self {
            r = r.define(Name { buf: [0; 128], len: 4 }, SymbolKind::SymParameter, p.span)
            // Note: "self" name bytes would be 115,101,108,102 but we don't need exact bytes
            // for the self-hosted phase — self is implicitly available
        } else {
            r = r.define(p.name, SymbolKind::SymParameter, p.span)
        }
        r
    }

    // --------------------------------------------------------
    // Struct
    // --------------------------------------------------------

    fn resolve_struct_def(self, opt: Option<Box<StructDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(sd) => self.resolve_field_defs((*sd).fields)
            None => self
        }
    }

    fn resolve_field_defs(self, opt: Option<Box<FieldDefList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_type_expr((*list).head.ty)
                r.resolve_field_defs((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Impl
    // --------------------------------------------------------

    fn resolve_impl_def(self, opt: Option<Box<ImplDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                var r = self.resolve_type_expr((*id).target_type)
                r = r.push_scope()
                r = r.resolve_impl_methods((*id).methods)
                r.pop_scope()
            }
            None => self
        }
    }

    fn resolve_impl_methods(self, opt: Option<Box<ItemList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_item((*list).head)
                r.resolve_impl_methods((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Type alias
    // --------------------------------------------------------

    fn resolve_type_alias(self, opt: Option<Box<TypeExpr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.resolve_type_expr(*te)
            None => self
        }
    }

    fn resolve_policy_def(self, opt: Option<Box<PolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pd) => self.resolve_type_expr((*pd).target_type)
            None => self
        }
    }

    fn resolve_audit_def(self, opt: Option<Box<AuditDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ad) => self.resolve_type_expr((*ad).target_type)
            None => self
        }
    }

    fn resolve_decision_policy_def(self, opt: Option<Box<DecisionPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => self.resolve_type_expr((*dd).target_type)
            None => self
        }
    }

    fn resolve_acquisition_policy_def(self, opt: Option<Box<AcquisitionPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ad) => self.resolve_type_expr((*ad).target_type)
            None => self
        }
    }

    fn resolve_recourse_policy_def(self, opt: Option<Box<RecoursePolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(rd) => self.resolve_type_expr((*rd).target_type)
            None => self
        }
    }

    fn resolve_transition_policy_def(self, opt: Option<Box<TransitionPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(td) => self.resolve_type_expr((*td).target_type)
            None => self
        }
    }

    fn resolve_transition_protocol_def(self, opt: Option<Box<TransitionProtocolDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(tp) => {
                var r = self.resolve_type_expr((*tp).target_type)
                if !name_is_empty((*tp).policy_name) {
                    let found = r.lookup((*tp).policy_name)
                    if found < 0 {
                        r = r.report_error((*tp).span)
                    }
                }
                r.resolve_transition_step_defs((*tp).steps)
            }
            None => self
        }
    }

    fn resolve_monitoring_policy_def(self, opt: Option<Box<MonitoringPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(md) => self.resolve_type_expr((*md).target_type)
            None => self
        }
    }

    fn resolve_deferral_policy_def(self, opt: Option<Box<DeferralPolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => self.resolve_type_expr((*dd).target_type)
            None => self
        }
    }

    fn resolve_alternative_policy_def(self, opt: Option<Box<AlternativePolicyDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ap) => self.resolve_type_expr((*ap).target_type)
            None => self
        }
    }

    fn resolve_alternative_frontier_def(self, opt: Option<Box<AlternativeFrontierDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(af) => {
                var r = self.resolve_type_expr((*af).target_type)
                if !name_is_empty((*af).policy_name) {
                    let found = r.lookup((*af).policy_name)
                    if found < 0 {
                        r = r.report_error((*af).span)
                    }
                }
                r.resolve_alternative_candidate_defs((*af).candidates)
            }
            None => self
        }
    }

    fn resolve_alternative_candidate_defs(self, opt: Option<Box<AlternativeCandidateDefList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head.value_expr)
                if (*list).head.uses_via && !name_is_empty((*list).head.via_name) {
                    let found = r.lookup((*list).head.via_name)
                    if found < 0 {
                        r = r.report_error((*list).head.span)
                    }
                }
                r.resolve_alternative_candidate_defs((*list).tail)
            }
            None => self
        }
    }

    fn resolve_transition_step_defs(self, opt: Option<Box<TransitionStepDefList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head.value_expr)
                r.resolve_transition_step_defs((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Type expression resolution
// ============================================================

impl Resolver {
    fn resolve_type_expr(self, te: TypeExpr) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match te.kind {
            TypeNamed => {
                // Named types are looked up, but we don't error on unresolved types
                // since many are builtins (i64, bool, Option, etc.)
                var r = self
                r = r.resolve_type_args(te.type_args)
                r
            }
            TypeReference => self.resolve_opt_type(te.inner)
            TypeRefMut => self.resolve_opt_type(te.inner)
            TypeArray => {
                var r = self.resolve_opt_type(te.inner)
                r.resolve_opt_expr(te.array_size)
            }
            TypeTuple => self.resolve_type_args(te.type_args)
            TypeFn => {
                var r = self.resolve_type_args(te.type_args)
                r.resolve_opt_type(te.inner)
            }
            TypeUnit => self
            TypeNever => self
            TypeSelfUpper => self
            TypeInfer => self
            TypeKnowledge => {
                // Resolve inner type of Knowledge[T, ...]
                self.resolve_knowledge_inner(te.knowledge_info)
            }
            TypeModel => self.resolve_type_args(te.type_args)
            TypePolicy => self.resolve_type_args(te.type_args)
            TypeAcquisitionPolicy => self.resolve_type_args(te.type_args)
            TypeAcquisitionPlan => self.resolve_type_args(te.type_args)
            TypeRecoursePolicy => self.resolve_type_args(te.type_args)
            TypeRecoursePlan => self.resolve_type_args(te.type_args)
            TypeTransitionPolicy => self.resolve_type_args(te.type_args)
            TypeTransitionPlan => self.resolve_type_args(te.type_args)
            TypeDecisionPolicy => self.resolve_type_args(te.type_args)
            TypeDeferralPolicy => self.resolve_type_args(te.type_args)
            TypeAlternativePolicy => self.resolve_type_args(te.type_args)
            TypeAlternativeSet => self.resolve_type_args(te.type_args)
            TypeAlternativeOption => self.resolve_type_args(te.type_args)
            TypeContest => self.resolve_type_args(te.type_args)
            TypeRobust => self.resolve_type_args(te.type_args)
            TypeIntervention => self.resolve_type_args(te.type_args)
            TypeCounterfactual => self.resolve_type_args(te.type_args)
            TypeValidated => self.resolve_type_args(te.type_args)
            TypeAdmissible => self.resolve_type_args(te.type_args)
            TypeDeferred => self.resolve_type_args(te.type_args)
            TypeRefinement => {
                // Resolve base type inside refinement
                self.resolve_refinement_inner(te.refinement_info)
            }
            TypeChan => self.resolve_type_args(te.type_args)
            TypeSession => self.resolve_type_args(te.type_args)
        }
    }

    fn resolve_refinement_inner(self, opt: Option<Box<RefinementInfo>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(info) => {
                match (*info).base_type {
                    None => self
                    Some(bte) => self.resolve_type_expr(*bte)
                }
            }
        }
    }

    fn resolve_knowledge_inner(self, opt: Option<Box<KnowledgeTypeInfo>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(info) => self.resolve_type_expr(*(*info).inner_type)
        }
    }

    fn resolve_opt_type(self, opt: Option<Box<TypeExpr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.resolve_type_expr(*te)
            None => self
        }
    }

    fn resolve_type_args(self, opt: Option<Box<TypeExprList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_type_expr((*list).head)
                r.resolve_type_args((*list).tail)
            }
            None => self
        }
    }

    fn resolve_models_def(self, opt: Option<Box<ModelsDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(md) => self.resolve_ast_path_list((*md).models)
            None => self
        }
    }

    fn resolve_validation_def(self, opt: Option<Box<ValidationDef>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vd) => self.resolve_type_expr((*vd).target_type)
            None => self
        }
    }

    fn resolve_ast_path_list(self, opt: Option<Box<AstPathList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_path_head((*list).head)
                r.resolve_ast_path_list((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Block and statement resolution
// ============================================================

impl Resolver {
    fn resolve_block(self, blk: Block) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.push_scope()
        r = r.resolve_stmts(blk.stmts)
        r.pop_scope()
    }

    fn resolve_stmts(self, opt: Option<Box<StmtList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_stmt((*list).head)
                r.resolve_stmts((*list).tail)
            }
            None => self
        }
    }

    fn resolve_stmt(self, s: Stmt) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match s.kind {
            StmtLet => {
                // Resolve initializer BEFORE defining the variable
                var r = self.resolve_opt_type_boxed(s.ty)
                r = r.resolve_opt_expr(s.expr)
                r.define(s.name, SymbolKind::SymVariable, s.span)
            }
            StmtVar => {
                var r = self.resolve_opt_type_boxed(s.ty)
                r = r.resolve_opt_expr(s.expr)
                r.define(s.name, SymbolKind::SymVariable, s.span)
            }
            StmtExpr => self.resolve_opt_expr(s.expr)
            StmtAssign => {
                var r = self.resolve_opt_expr(s.target)
                r.resolve_opt_expr(s.expr)
            }
        }
    }

    fn resolve_opt_type_boxed(self, opt: Option<Box<TypeExpr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.resolve_type_expr(*te)
            None => self
        }
    }
}

// ============================================================
// Expression resolution
// ============================================================

impl Resolver {
    fn resolve_expr(self, e: Expr) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match e.kind {
            ExprIntLit => self
            ExprFloatLit => self
            ExprBoolTrue => self
            ExprBoolFalse => self
            ExprStringLit => self
            ExprCharLit => self
            ExprIdent => {
                let found = self.lookup(e.name)
                if found < 0 {
                    self.report_error(e.span)
                } else {
                    self
                }
            }
            ExprPath => {
                // Path resolution: first segment must be in scope
                // (struct/enum name, module, etc.)
                // For now, just check the first segment exists
                self.resolve_path_head(e.path)
            }
            ExprBinary => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_expr(e.right)
            }
            ExprUnary => self.resolve_opt_expr(e.left)
            ExprFieldAccess => {
                // Resolve the base expression; field checked by type checker
                self.resolve_opt_expr(e.left)
            }
            ExprIndex => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_expr(e.right)
            }
            ExprMethodCall => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_expr_list(e.args)
            }
            ExprCall => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_expr_list(e.args)
            }
            ExprContest => {
                var r = self.resolve_opt_expr(e.left)
                r
            }
            ExprAuditAttach => {
                var r = self.resolve_opt_expr(e.left)
                let found = r.lookup(e.name)
                if found < 0 {
                    r.report_error(e.span)
                } else {
                    r
                }
            }
            ExprIf => {
                var r = self.resolve_opt_expr(e.left)
                r = r.resolve_opt_block(e.block)
                r.resolve_opt_expr(e.else_expr)
            }
            ExprMatch => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_match_arms(e.arms)
            }
            ExprWhile => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_block(e.block)
            }
            ExprLoop => self.resolve_opt_block(e.block)
            ExprBlock => self.resolve_opt_block(e.block)
            ExprReturn => self.resolve_opt_expr(e.left)
            ExprBreak => self.resolve_opt_expr(e.left)
            ExprContinue => self
            ExprStructLit => {
                // Resolve path (struct name) and field init expressions
                var r = self.resolve_path_head(e.path)
                r.resolve_struct_field_inits(e.fields)
            }
            ExprArrayLit => self.resolve_expr_list(e.args)
            ExprTupleLit => self.resolve_expr_list(e.args)
            ExprRange => {
                var r = self.resolve_opt_expr(e.left)
                r.resolve_opt_expr(e.right)
            }
            ExprCast => self.resolve_opt_expr(e.left)
            ExprHandle => {
                var r = self.resolve_opt_block(e.block)
                r.resolve_opt_block_handler(e.handler_block)
            }
            ExprError => self
        }
    }

    fn resolve_opt_expr(self, opt: Option<Box<Expr>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => self.resolve_expr(*e)
            None => self
        }
    }

    fn resolve_opt_block(self, opt: Option<Box<Block>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.resolve_block(*blk)
            None => self
        }
    }

    fn resolve_opt_block_handler(self, opt: Option<Box<Block>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.resolve_block(*blk)
            None => self
        }
    }

    fn resolve_expr_list(self, opt: Option<Box<ExprList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head)
                r.resolve_expr_list((*list).tail)
            }
            None => self
        }
    }

    fn resolve_path_head(self, path: AstPath) -> Resolver with Mut, Panic, Div, Alloc, IO {
        if path.seg_count > 0 {
            let resolved_name = copy_string_list_to_name(path.segments)
            let found = self.lookup(resolved_name)
            if found < 0 {
                // Not found — could be a builtin type, don't error
                self
            } else {
                self
            }
        } else {
            self
        }
    }
}

// ============================================================
// Match arm resolution (binds pattern variables)
// ============================================================

impl Resolver {
    fn resolve_match_arms(self, opt: Option<Box<MatchArmList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_match_arm((*list).head)
                r.resolve_match_arms((*list).tail)
            }
            None => self
        }
    }

    fn resolve_match_arm(self, arm: MatchArm) -> Resolver with Mut, Panic, Div, Alloc, IO {
        var r = self.push_scope()
        r = r.resolve_pattern(arm.pattern)
        r = r.resolve_expr(arm.body)
        r.pop_scope()
    }

    fn resolve_pattern(self, pat: Pattern) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match pat.kind {
            PatWildcard => self
            PatBinding => {
                // Introduce the binding into current scope
                self.define(pat.name, SymbolKind::SymVariable, pat.span)
            }
            PatIntLit => self
            PatBoolTrue => self
            PatBoolFalse => self
            PatStringLit => self
            PatEnum => {
                // Enum variant pattern — e.g. Some(x)
                // Resolve sub-patterns (which introduce bindings)
                self.resolve_pattern_list(pat.sub_patterns)
            }
            PatStruct => {
                self.resolve_pat_fields(pat.pat_fields)
            }
            PatTuple => {
                self.resolve_pattern_list(pat.sub_patterns)
            }
            PatOr => {
                self.resolve_pattern_list(pat.sub_patterns)
            }
        }
    }

    fn resolve_pattern_list(self, opt: Option<Box<PatternList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_pattern((*list).head)
                r.resolve_pattern_list((*list).tail)
            }
            None => self
        }
    }

    fn resolve_pat_fields(self, opt: Option<Box<PatFieldList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_pattern((*list).head.pattern)
                r.resolve_pat_fields((*list).tail)
            }
            None => self
        }
    }
}

// ============================================================
// Struct field init resolution
// ============================================================

impl Resolver {
    fn resolve_struct_field_inits(self, opt: Option<Box<StructFieldList>>) -> Resolver with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var r = self.resolve_expr((*list).head.value)
                r.resolve_struct_field_inits((*list).tail)
            }
            None => self
        }
    }
}

// Note: copy_string_list_to_name is defined in parser/items.sio
// and shared via flat namespace — no duplicate needed here.

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/resolve/mod.sio  (170 lines)
// ════════════════════════════════════════════════════════════════

// Name Resolution — entry point
//
// Runs the two-pass resolution algorithm on a Program AST:
//   Pass 1: collect all top-level declarations (forward references)
//   Pass 2: resolve identifiers in all item bodies
//
// Returns a ResolveResult with the final symbol table and error count.



struct ResolveResult {
    symbols: SymbolTable,
    error_count: i64,
    had_error: bool,
}

// Inject built-in function names into a resolver's global scope so that
// single-file programs can call builtins (print, read_file, etc.) without
// triggering "symbol not found" resolve errors.  These are handled at the
// IR lowering / native codegen layer and need no AST definition.
fn inject_builtins(r: Resolver) -> Resolver with Mut, Panic, Div {
    var res = r
    let dummy = Span::dummy()
    // "print" (5)
    res = res.define(builtin_name_5(112 as i8, 114 as i8, 105 as i8, 110 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    // "print_int" (9): p r i n t _ i n t
    res = res.define(builtin_name_9(112 as i8, 114 as i8, 105 as i8, 110 as i8, 116 as i8, 95 as i8, 105 as i8, 110 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    // "print_char" (10): p r i n t _ c h a r
    res = res.define(builtin_name_10(112 as i8, 114 as i8, 105 as i8, 110 as i8, 116 as i8, 95 as i8, 99 as i8, 104 as i8, 97 as i8, 114 as i8), SymbolKind::SymFunction, dummy)
    // "read_file" (9): r e a d _ f i l e
    res = res.define(builtin_name_9(114 as i8, 101 as i8, 97 as i8, 100 as i8, 95 as i8, 102 as i8, 105 as i8, 108 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "write_file" (10): w r i t e _ f i l e
    res = res.define(builtin_name_10(119 as i8, 114 as i8, 105 as i8, 116 as i8, 101 as i8, 95 as i8, 102 as i8, 105 as i8, 108 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "file_size" (9): f i l e _ s i z e
    res = res.define(builtin_name_9(102 as i8, 105 as i8, 108 as i8, 101 as i8, 95 as i8, 115 as i8, 105 as i8, 122 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "get_arg_count" (13): g e t _ a r g _ c o u n t
    res = res.define(builtin_name_13(103 as i8, 101 as i8, 116 as i8, 95 as i8, 97 as i8, 114 as i8, 103 as i8, 95 as i8, 99 as i8, 111 as i8, 117 as i8, 110 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    // "get_arg" (7): g e t _ a r g
    res = res.define(builtin_name_7(103 as i8, 101 as i8, 116 as i8, 95 as i8, 97 as i8, 114 as i8, 103 as i8), SymbolKind::SymFunction, dummy)
    // "str_len" (7): s t r _ l e n
    res = res.define(builtin_name_7(115 as i8, 116 as i8, 114 as i8, 95 as i8, 108 as i8, 101 as i8, 110 as i8), SymbolKind::SymFunction, dummy)
    // "str_eq" (6): s t r _ e q
    res = res.define(builtin_name_6(115 as i8, 116 as i8, 114 as i8, 95 as i8, 101 as i8, 113 as i8), SymbolKind::SymFunction, dummy)
    // "str_slice" (9): s t r _ s l i c e
    res = res.define(builtin_name_9(115 as i8, 116 as i8, 114 as i8, 95 as i8, 115 as i8, 108 as i8, 105 as i8, 99 as i8, 101 as i8), SymbolKind::SymFunction, dummy)
    // "starts_with" (11): s t a r t s _ w i t h
    res = res.define(builtin_name_11(115 as i8, 116 as i8, 97 as i8, 114 as i8, 116 as i8, 115 as i8, 95 as i8, 119 as i8, 105 as i8, 116 as i8, 104 as i8), SymbolKind::SymFunction, dummy)
    // "str_concat" (10): s t r _ c o n c a t
    res = res.define(builtin_name_10(115 as i8, 116 as i8, 114 as i8, 95 as i8, 99 as i8, 111 as i8, 110 as i8, 99 as i8, 97 as i8, 116 as i8), SymbolKind::SymFunction, dummy)
    res
}

fn builtin_name_5(a: i8, b: i8, c: i8, d: i8, e: i8) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 5 }
    n.buf[0] = a; n.buf[1] = b; n.buf[2] = c; n.buf[3] = d; n.buf[4] = e
    n
}

fn builtin_name_6(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_5(a, b, c, d, e)
    n.len = 6; n.buf[5] = f
    n
}

fn builtin_name_7(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_6(a, b, c, d, e, f)
    n.len = 7; n.buf[6] = g
    n
}

fn builtin_name_9(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_7(a, b, c, d, e, f, g)
    n.len = 9; n.buf[7] = h; n.buf[8] = i
    n
}

fn builtin_name_10(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_9(a, b, c, d, e, f, g, h, i)
    n.len = 10; n.buf[9] = j
    n
}

fn builtin_name_11(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_10(a, b, c, d, e, f, g, h, i, j)
    n.len = 11; n.buf[10] = k
    n
}

fn builtin_name_13(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8, m: i8) -> Name with Mut, Panic, Div {
    var n = builtin_name_11(a, b, c, d, e, f, g, h, i, j, k)
    n.len = 13; n.buf[11] = l; n.buf[12] = m
    n
}

fn resolve_program(prog: Program) -> ResolveResult with Mut, Panic, Div, Alloc, IO {
    var r = resolver_new()

    // Inject builtin function names so single-file programs can call print etc.
    r = inject_builtins(r)

    // Pass 1: collect top-level items into global scope
    r = r.collect_items(prog.items)

    // Pass 2: resolve bodies
    r = r.resolve_items(prog.items)

    ResolveResult {
        symbols: r.symbols,
        error_count: r.error_count,
        had_error: r.had_error,
    }
}

// Multi-module resolution: build an export registry then resolve each module with validated imports.

struct ResolveBatchResult {
    results: [ResolveResult; 64],
    count: i64,
    error_count: i64,
    had_error: bool,
}

fn empty_resolve_result() -> ResolveResult with Mut, Panic, Div {
    ResolveResult { symbols: symbol_table_new(), error_count: 0, had_error: false }
}

fn resolve_modules(programs: [Program; 64], count: i64) -> ResolveBatchResult with Mut, Panic, Div, Alloc, IO {
    var reg = module_registry_new()

    // Pass 0: collect pub exports for each module
    var i: i64 = 0
    while i < count && i < 64 {
        let prog = programs[i as usize]
        let pair = collect_module_exports(prog.items)
        reg = module_registry_put(reg, prog.module_path, pair.0, pair.1)
        i = i + 1
    }

    // Resolve each module using the shared export registry
    var results: [ResolveResult; 64] = [empty_resolve_result(); 64]
    var total_err: i64 = 0
    var had: bool = false

    var j: i64 = 0
    while j < count && j < 64 {
        var r = resolver_with_modules(reg)
        r = r.collect_items(programs[j as usize].items)
        r = r.resolve_items(programs[j as usize].items)

        results[j as usize] = ResolveResult {
            symbols: r.symbols,
            error_count: r.error_count,
            had_error: r.had_error,
        }

        total_err = total_err + r.error_count
        if r.had_error { had = true }
        j = j + 1
    }

    ResolveBatchResult {
        results: results,
        count: count,
        error_count: total_err,
        had_error: had,
    }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/resolve/scopes.sio  (1372 lines)
// ════════════════════════════════════════════════════════════════

// Scope / symbol resolution system for the self-hosted compiler
//
// Provides a flat-array scope stack with rich entry metadata: each binding
// records its name, kind, type_id, depth, slot, mutability, and capture
// status.  Designed for use in closure analysis and later lowering passes
// that need finer-grained scope information than the minimal ScopeStack in
// scope.sio.
//
// Layout:
//   RichScopeEntry  — one binding (name, kind, type, depth, slot, flags)
//   RichScopeStack  — flat arrays: entries[2048], scope_depths[128]
//
// Helpers must precede callers (Sounio requirement: no forward references).

// ============================================================================
// CONSTANTS — scope entry kinds
// ============================================================================

let RSCOPE_VAR: i64 = 1
let RSCOPE_FN: i64 = 2
let RSCOPE_TYPE: i64 = 3
let RSCOPE_PARAM: i64 = 4
let RSCOPE_CONST: i64 = 5

// Sentinel returned when lookup fails.
let RSCOPE_NOT_FOUND: i64 = 0 - 1

// Maximum entries and depth limits.
let RSCOPE_MAX_ENTRIES: i64 = 2048
let RSCOPE_MAX_DEPTH: i64 = 128

// ============================================================================
// NAME COMPARISON HELPER
// ============================================================================

// Byte-by-byte equality over fixed-size name buffers.
// Both buffers are [i8; 64] with an accompanying length.
fn rscope_name_eq(
    a: [i8; 64], a_len: i64,
    b: [i8; 64], b_len: i64
) -> bool with Mut, Div, Panic {
    if a_len != b_len {
        return false
    }
    var i: i64 = 0
    while i < a_len {
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Copy up to 64 bytes from a source buffer into a destination buffer.
fn rscope_name_copy(src: [i8; 64], len: i64) -> [i8; 64] with Mut, Div, Panic {
    var dst: [i8; 64] = [0; 64]
    var i: i64 = 0
    while i < len && i < 64 {
        dst[i as usize] = src[i as usize]
        i = i + 1
    }
    dst
}

// ============================================================================
// SCOPE ENTRY
// ============================================================================

struct RichScopeEntry {
    name: [i8; 64],
    name_len: i64,
    kind: i64,
    type_id: i64,
    depth: i64,
    slot: i64,
    is_mutable: bool,
    is_captured: bool,
}

fn rscope_entry_new() -> RichScopeEntry {
    RichScopeEntry {
        name: [0; 64],
        name_len: 0,
        kind: 0,
        type_id: 0,
        depth: 0,
        slot: 0,
        is_mutable: false,
        is_captured: false,
    }
}

// Create an entry with all fields specified.
fn rscope_entry_make(
    name: [i8; 64],
    name_len: i64,
    kind: i64,
    type_id: i64,
    depth: i64,
    slot: i64,
    is_mutable: bool
) -> RichScopeEntry {
    RichScopeEntry {
        name: name,
        name_len: name_len,
        kind: kind,
        type_id: type_id,
        depth: depth,
        slot: slot,
        is_mutable: is_mutable,
        is_captured: false,
    }
}

// ============================================================================
// SCOPE STACK
// ============================================================================

struct RichScopeStack {
    entries: [RichScopeEntry; 2048],
    entry_count: i64,
    scope_depths: [i64; 128],
    depth_count: i64,
    current_depth: i64,
}

fn rscope_stack_new() -> RichScopeStack {
    RichScopeStack {
        entries: [rscope_entry_new(); 2048],
        entry_count: 0,
        scope_depths: [0; 128],
        depth_count: 0,
        current_depth: 0,
    }
}

// ============================================================================
// SCOPE PUSH / POP
// ============================================================================

// Push a new scope level.  Records the current entry_count as the
// start-of-scope marker in scope_depths so that pop can trim back.
fn rscope_push(stack: RichScopeStack) -> RichScopeStack with Mut, Div, Panic {
    var s = stack
    if s.depth_count < RSCOPE_MAX_DEPTH {
        s.scope_depths[s.depth_count as usize] = s.entry_count
        s.depth_count = s.depth_count + 1
    }
    s.current_depth = s.current_depth + 1
    s
}

// Pop the most recent scope.  Resets entry_count to the value saved
// when the scope was pushed, effectively removing all bindings added
// in that scope.
fn rscope_pop(stack: RichScopeStack) -> RichScopeStack with Mut, Div, Panic {
    var s = stack
    if s.depth_count > 0 {
        s.depth_count = s.depth_count - 1
        s.entry_count = s.scope_depths[s.depth_count as usize]
    }
    if s.current_depth > 0 {
        s.current_depth = s.current_depth - 1
    }
    s
}

// Return the entry_count at which the current scope started.
fn rscope_current_start(stack: RichScopeStack) -> i64 with Div, Panic {
    if stack.depth_count > 0 {
        stack.scope_depths[(stack.depth_count - 1) as usize]
    } else {
        0
    }
}

// ============================================================================
// SCOPE DEFINE — add a binding to the current scope
// ============================================================================

fn rscope_define(
    stack: RichScopeStack,
    name: [i8; 64],
    name_len: i64,
    kind: i64,
    type_id: i64,
    is_mutable: bool
) -> RichScopeStack with Mut, Div, Panic {
    var s = stack
    if s.entry_count < RSCOPE_MAX_ENTRIES {
        let slot = s.entry_count
        s.entries[s.entry_count as usize] = RichScopeEntry {
            name: name,
            name_len: name_len,
            kind: kind,
            type_id: type_id,
            depth: s.current_depth,
            slot: slot,
            is_mutable: is_mutable,
            is_captured: false,
        }
        s.entry_count = s.entry_count + 1
    }
    s
}

// Convenience: define with a pre-built entry (inherits current_depth).
fn rscope_define_entry(stack: RichScopeStack, entry: RichScopeEntry) -> RichScopeStack with Mut, Div, Panic {
    rscope_define(
        stack,
        entry.name,
        entry.name_len,
        entry.kind,
        entry.type_id,
        entry.is_mutable
    )
}

// ============================================================================
// SCOPE LOOKUP — find a binding by name (innermost first)
// ============================================================================

// Returns the slot (index) of the innermost binding with the given name,
// or RSCOPE_NOT_FOUND (-1) if not found.
fn rscope_lookup(
    stack: RichScopeStack,
    name: [i8; 64],
    name_len: i64
) -> i64 with Mut, Div, Panic {
    var i = stack.entry_count - 1
    while i >= 0 {
        let e = stack.entries[i as usize]
        if rscope_name_eq(e.name, e.name_len, name, name_len) {
            return e.slot
        }
        i = i - 1
    }
    RSCOPE_NOT_FOUND
}

// Return the full RichScopeEntry for the innermost binding, or a default
// empty entry if not found.
fn rscope_lookup_entry(
    stack: RichScopeStack,
    name: [i8; 64],
    name_len: i64
) -> RichScopeEntry with Mut, Div, Panic {
    var i = stack.entry_count - 1
    while i >= 0 {
        let e = stack.entries[i as usize]
        if rscope_name_eq(e.name, e.name_len, name, name_len) {
            return e
        }
        i = i - 1
    }
    rscope_entry_new()
}

// ============================================================================
// SCOPE LOOKUP IN DEPTH — find binding at a specific depth
// ============================================================================

// Returns the slot of the first binding with the given name at exactly
// the specified depth, or RSCOPE_NOT_FOUND if none.
fn rscope_lookup_in_depth(
    stack: RichScopeStack,
    name: [i8; 64],
    name_len: i64,
    target_depth: i64
) -> i64 with Mut, Div, Panic {
    var i = stack.entry_count - 1
    while i >= 0 {
        let e = stack.entries[i as usize]
        if e.depth == target_depth {
            if rscope_name_eq(e.name, e.name_len, name, name_len) {
                return e.slot
            }
        }
        i = i - 1
    }
    RSCOPE_NOT_FOUND
}

// ============================================================================
// SCOPE MARK CAPTURED
// ============================================================================

// Mark the innermost binding with the given name as captured.
// Returns the updated stack.
fn rscope_mark_captured(
    stack: RichScopeStack,
    name: [i8; 64],
    name_len: i64
) -> RichScopeStack with Mut, Div, Panic {
    var s = stack
    var i = s.entry_count - 1
    while i >= 0 {
        if rscope_name_eq(s.entries[i as usize].name, s.entries[i as usize].name_len, name, name_len) {
            s.entries[i as usize].is_captured = true
            return s
        }
        i = i - 1
    }
    s
}

// ============================================================================
// SCOPE COUNT CAPTURES
// ============================================================================

// Count the number of entries currently marked as captured.
fn rscope_count_captures(stack: RichScopeStack) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < stack.entry_count {
        if stack.entries[i as usize].is_captured {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count captures at a specific depth.
fn rscope_count_captures_at_depth(stack: RichScopeStack, target_depth: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < stack.entry_count {
        let e = stack.entries[i as usize]
        if e.is_captured && e.depth == target_depth {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// SCOPE IS SHADOWING
// ============================================================================

// Check whether defining a name at the current depth would shadow an
// outer (lower-depth) binding with the same name.
fn rscope_is_shadowing(
    stack: RichScopeStack,
    name: [i8; 64],
    name_len: i64
) -> bool with Mut, Div, Panic {
    var i = stack.entry_count - 1
    while i >= 0 {
        let e = stack.entries[i as usize]
        if rscope_name_eq(e.name, e.name_len, name, name_len) {
            // Found an existing binding — it shadows if the depth is strictly less.
            if e.depth < stack.current_depth {
                return true
            }
        }
        i = i - 1
    }
    false
}

// Check whether a name is already defined in the current scope (same depth).
// Useful for detecting duplicate definitions.
fn rscope_is_duplicate_in_current(
    stack: RichScopeStack,
    name: [i8; 64],
    name_len: i64
) -> bool with Mut, Div, Panic {
    let start = rscope_current_start(stack)
    var i = stack.entry_count - 1
    while i >= start {
        let e = stack.entries[i as usize]
        if rscope_name_eq(e.name, e.name_len, name, name_len) {
            return true
        }
        i = i - 1
    }
    false
}

// ============================================================================
// SCOPE COLLECT LOCALS
// ============================================================================

// Collect all bindings at the current depth into a result buffer.
// Returns the number of entries written.  Writes at most 256 entries.
fn rscope_collect_locals(
    stack: RichScopeStack,
    result: [RichScopeEntry; 256]
) -> ([RichScopeEntry; 256], i64) with Mut, Div, Panic {
    var out = result
    var count: i64 = 0
    var i: i64 = 0
    while i < stack.entry_count {
        let e = stack.entries[i as usize]
        if e.depth == stack.current_depth && count < 256 {
            out[count as usize] = e
            count = count + 1
        }
        i = i + 1
    }
    (out, count)
}

// Collect all bindings of a specific kind across all depths.
fn rscope_collect_by_kind(
    stack: RichScopeStack,
    kind: i64,
    result: [RichScopeEntry; 256]
) -> ([RichScopeEntry; 256], i64) with Mut, Div, Panic {
    var out = result
    var count: i64 = 0
    var i: i64 = 0
    while i < stack.entry_count {
        let e = stack.entries[i as usize]
        if e.kind == kind && count < 256 {
            out[count as usize] = e
            count = count + 1
        }
        i = i + 1
    }
    (out, count)
}

// ============================================================================
// SCOPE UTILITY — depth, count, entry-at-slot
// ============================================================================

// Return the current nesting depth.
fn rscope_depth(stack: RichScopeStack) -> i64 {
    stack.current_depth
}

// Return the total number of live entries.
fn rscope_entry_count(stack: RichScopeStack) -> i64 {
    stack.entry_count
}

// Return the entry at a given slot index.
fn rscope_get_entry(stack: RichScopeStack, slot: i64) -> RichScopeEntry with Div, Panic {
    if slot >= 0 && slot < stack.entry_count {
        stack.entries[slot as usize]
    } else {
        rscope_entry_new()
    }
}

// Check whether a given slot is valid (in range).
fn rscope_slot_valid(stack: RichScopeStack, slot: i64) -> bool {
    slot >= 0 && slot < stack.entry_count
}

// Return the kind of the entry at a given slot.
fn rscope_slot_kind(stack: RichScopeStack, slot: i64) -> i64 with Div, Panic {
    if slot >= 0 && slot < stack.entry_count {
        stack.entries[slot as usize].kind
    } else {
        0
    }
}

// Return true if the entry at the given slot is mutable.
fn rscope_slot_is_mutable(stack: RichScopeStack, slot: i64) -> bool with Div, Panic {
    if slot >= 0 && slot < stack.entry_count {
        stack.entries[slot as usize].is_mutable
    } else {
        false
    }
}

// ============================================================================
// NAME BUILDER HELPERS (for tests)
// ============================================================================

// Build a 1-character name buffer.
fn rscope_make_name1(a: i8) -> [i8; 64] with Mut, Div, Panic {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a
    buf
}

// Build a 2-character name buffer.
fn rscope_make_name2(a: i8, b: i8) -> [i8; 64] with Mut, Div, Panic {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a
    buf[1] = b
    buf
}

// Build a 3-character name buffer.
fn rscope_make_name3(a: i8, b: i8, c: i8) -> [i8; 64] with Mut, Div, Panic {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf
}

// Build a 4-character name buffer.
fn rscope_make_name4(a: i8, b: i8, c: i8, d: i8) -> [i8; 64] with Mut, Div, Panic {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf
}

// Build a 5-character name buffer.
fn rscope_make_name5(a: i8, b: i8, c: i8, d: i8, e: i8) -> [i8; 64] with Mut, Div, Panic {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf[4] = e
    buf
}

// ============================================================================
// MULTI-SCOPE OPERATIONS
// ============================================================================

// Push N nested scopes at once (useful for quickly setting up test scenarios).
fn rscope_push_n(stack: RichScopeStack, n: i64) -> RichScopeStack with Mut, Div, Panic {
    var s = stack
    var i: i64 = 0
    while i < n {
        s = rscope_push(s)
        i = i + 1
    }
    s
}

// Pop N scopes at once.
fn rscope_pop_n(stack: RichScopeStack, n: i64) -> RichScopeStack with Mut, Div, Panic {
    var s = stack
    var i: i64 = 0
    while i < n {
        s = rscope_pop(s)
        i = i + 1
    }
    s
}

// Count entries at a specific depth.
fn rscope_count_at_depth(stack: RichScopeStack, target_depth: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < stack.entry_count {
        if stack.entries[i as usize].depth == target_depth {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count all entries with a given kind.
fn rscope_count_by_kind(stack: RichScopeStack, kind: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < stack.entry_count {
        if stack.entries[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================================
// SCOPE SNAPSHOT / RESTORE
// ============================================================================

// A snapshot captures the entry_count and depth_count so we can restore later.
struct RichScopeSnapshot {
    saved_entry_count: i64,
    saved_depth_count: i64,
    saved_current_depth: i64,
}

fn rscope_snapshot(stack: RichScopeStack) -> RichScopeSnapshot {
    RichScopeSnapshot {
        saved_entry_count: stack.entry_count,
        saved_depth_count: stack.depth_count,
        saved_current_depth: stack.current_depth,
    }
}

fn rscope_restore(stack: RichScopeStack, snap: RichScopeSnapshot) -> RichScopeStack with Mut {
    var s = stack
    s.entry_count = snap.saved_entry_count
    s.depth_count = snap.saved_depth_count
    s.current_depth = snap.saved_current_depth
    s
}

// ============================================================================
// TEST INFRASTRUCTURE
// ============================================================================

fn rscope_assert_true(cond: bool, test_num: i64) -> i64 with IO, Mut, Div, Panic {
    if cond {
        print("  PASS test ")
        print_int(test_num)
        print("\n")
        return 1
    }
    print("  FAIL test ")
    print_int(test_num)
    print("\n")
    0
}

fn rscope_assert_eq_i64(actual: i64, expected: i64, test_num: i64) -> i64 with IO, Mut, Div, Panic {
    if actual == expected {
        print("  PASS test ")
        print_int(test_num)
        print("\n")
        return 1
    }
    print("  FAIL test ")
    print_int(test_num)
    print(" expected=")
    print_int(expected)
    print(" actual=")
    print_int(actual)
    print("\n")
    0
}

// ============================================================================
// TEST 1: Empty stack has zero entries and depth zero
// ============================================================================

fn test_rscope_empty_stack() -> i64 with IO, Mut, Div, Panic {
    let s = rscope_stack_new()
    let c1 = rscope_entry_count(s) == 0
    let c2 = rscope_depth(s) == 0
    rscope_assert_true(c1 && c2, 1)
}

// ============================================================================
// TEST 2: Push increments depth
// ============================================================================

fn test_rscope_push_depth() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let c1 = rscope_depth(s) == 1
    s = rscope_push(s)
    let c2 = rscope_depth(s) == 2
    rscope_assert_true(c1 && c2, 2)
}

// ============================================================================
// TEST 3: Pop decrements depth
// ============================================================================

fn test_rscope_pop_depth() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    s = rscope_push(s)
    s = rscope_pop(s)
    rscope_assert_eq_i64(rscope_depth(s), 1, 3)
}

// ============================================================================
// TEST 4: Define adds an entry
// ============================================================================

fn test_rscope_define_basic() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let name_x = rscope_make_name1(120)  // 'x'
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 10, true)
    rscope_assert_eq_i64(rscope_entry_count(s), 1, 4)
}

// ============================================================================
// TEST 5: Lookup finds a defined binding
// ============================================================================

fn test_rscope_lookup_found() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let name_x = rscope_make_name1(120)  // 'x'
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 10, true)
    let slot = rscope_lookup(s, name_x, 1)
    rscope_assert_true(slot >= 0, 5)
}

// ============================================================================
// TEST 6: Lookup returns NOT_FOUND for undefined name
// ============================================================================

fn test_rscope_lookup_not_found() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let name_x = rscope_make_name1(120)  // 'x'
    let name_y = rscope_make_name1(121)  // 'y'
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 10, true)
    let slot = rscope_lookup(s, name_y, 1)
    rscope_assert_eq_i64(slot, RSCOPE_NOT_FOUND, 6)
}

// ============================================================================
// TEST 7: Inner scope shadows outer binding
// ============================================================================

fn test_rscope_shadowing() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let name_x = rscope_make_name1(120)  // 'x'
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 10, false)
    let outer_slot = rscope_lookup(s, name_x, 1)

    s = rscope_push(s)
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 20, true)
    let inner_slot = rscope_lookup(s, name_x, 1)

    // Inner slot should be different from outer (higher index)
    let c1 = inner_slot != outer_slot
    // Inner entry should have type_id 20
    let e = rscope_get_entry(s, inner_slot)
    let c2 = e.type_id == 20
    rscope_assert_true(c1 && c2, 7)
}

// ============================================================================
// TEST 8: Pop removes inner bindings
// ============================================================================

fn test_rscope_pop_removes() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let name_x = rscope_make_name1(120)  // 'x'
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 10, false)

    s = rscope_push(s)
    let name_y = rscope_make_name1(121)  // 'y'
    s = rscope_define(s, name_y, 1, RSCOPE_VAR, 20, false)
    let before = rscope_entry_count(s)

    s = rscope_pop(s)
    let after = rscope_entry_count(s)

    // After pop, y should be gone (entry_count decreased)
    let c1 = after < before
    // y should not be findable
    let slot_y = rscope_lookup(s, name_y, 1)
    let c2 = slot_y == RSCOPE_NOT_FOUND
    // x should still be findable
    let slot_x = rscope_lookup(s, name_x, 1)
    let c3 = slot_x >= 0
    rscope_assert_true(c1 && c2 && c3, 8)
}

// ============================================================================
// TEST 9: rscope_lookup_in_depth finds at specific depth
// ============================================================================

fn test_rscope_lookup_in_depth() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)  // depth 1
    let name_a = rscope_make_name1(97)  // 'a'
    s = rscope_define(s, name_a, 1, RSCOPE_VAR, 10, false)

    s = rscope_push(s)  // depth 2
    let name_b = rscope_make_name1(98)  // 'b'
    s = rscope_define(s, name_b, 1, RSCOPE_VAR, 20, false)

    // 'a' should be at depth 1 only
    let slot_a_d1 = rscope_lookup_in_depth(s, name_a, 1, 1)
    let slot_a_d2 = rscope_lookup_in_depth(s, name_a, 1, 2)
    let c1 = slot_a_d1 >= 0
    let c2 = slot_a_d2 == RSCOPE_NOT_FOUND

    // 'b' should be at depth 2 only
    let slot_b_d1 = rscope_lookup_in_depth(s, name_b, 1, 1)
    let slot_b_d2 = rscope_lookup_in_depth(s, name_b, 1, 2)
    let c3 = slot_b_d1 == RSCOPE_NOT_FOUND
    let c4 = slot_b_d2 >= 0

    rscope_assert_true(c1 && c2 && c3 && c4, 9)
}

// ============================================================================
// TEST 10: Mark captured and count captures
// ============================================================================

fn test_rscope_mark_captured() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let name_x = rscope_make_name1(120)  // 'x'
    let name_y = rscope_make_name1(121)  // 'y'
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 10, false)
    s = rscope_define(s, name_y, 1, RSCOPE_VAR, 20, false)

    let before = rscope_count_captures(s)
    s = rscope_mark_captured(s, name_x, 1)
    let after = rscope_count_captures(s)

    let c1 = before == 0
    let c2 = after == 1
    rscope_assert_true(c1 && c2, 10)
}

// ============================================================================
// TEST 11: is_shadowing detects shadow
// ============================================================================

fn test_rscope_is_shadowing() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)  // depth 1
    let name_x = rscope_make_name1(120)  // 'x'
    s = rscope_define(s, name_x, 1, RSCOPE_VAR, 10, false)

    s = rscope_push(s)  // depth 2
    // At depth 2, defining 'x' would shadow the one at depth 1
    let shadows = rscope_is_shadowing(s, name_x, 1)
    rscope_assert_true(shadows, 11)
}

// ============================================================================
// TEST 12: is_shadowing returns false when no outer binding
// ============================================================================

fn test_rscope_no_shadowing() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    s = rscope_push(s)
    let name_z = rscope_make_name1(122)  // 'z'
    let shadows = rscope_is_shadowing(s, name_z, 1)
    rscope_assert_true(!shadows, 12)
}

// ============================================================================
// TEST 13: collect_locals returns entries at current depth
// ============================================================================

fn test_rscope_collect_locals() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)  // depth 1
    let name_a = rscope_make_name1(97)  // 'a'
    s = rscope_define(s, name_a, 1, RSCOPE_VAR, 10, false)

    s = rscope_push(s)  // depth 2
    let name_b = rscope_make_name1(98)  // 'b'
    let name_c = rscope_make_name1(99)  // 'c'
    s = rscope_define(s, name_b, 1, RSCOPE_VAR, 20, false)
    s = rscope_define(s, name_c, 1, RSCOPE_VAR, 30, true)

    var result_buf: [RichScopeEntry; 256] = [rscope_entry_new(); 256]
    let pair = rscope_collect_locals(s, result_buf)
    let collected = pair.1
    // Should have 2 entries at depth 2
    rscope_assert_eq_i64(collected, 2, 13)
}

// ============================================================================
// TEST 14: Multiple defines, correct slot ordering
// ============================================================================

fn test_rscope_slot_ordering() -> i64 with IO, Mut, Div, Panic {
    var s = rscope_stack_new()
    s = rscope_push(s)
    let name_a = rscope_make_name1(97)  // 'a'
    let name_b = rscope_make_name1(98)  // 'b'
    let name_c = rscope_make_name1(99)  // 'c'
    s = rscope_define(s, name_a, 1, RSCOPE_VAR, 10, false)
    s = rscope_define(s, name_b, 1, RSCOPE_VAR, 20, false)
    s = rscope_define(s, name_c, 1, RSCOPE_VAR, 30, false)

    let slot_a = rscope_lookup(s, name_a, 1)
    let slot_b = rscope_lookup(s, name_b, 1)
    let slot_c = rscope_lookup(s, name_c, 1)

    // Slots should be in order: a=0, b=1, c=2
    let c1 = slot_a == 0
    let c2 = slot_b == 1
    let c3 = slot_c == 2
    rscope_assert_true(c1 && c2 && c3, 14)
}

