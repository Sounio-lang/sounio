    if test_lopt_vector_width() == 0 { passed = passed + 1 }
    if test_lopt_vector_width_clamped() == 0 { passed = passed + 1 }
    if test_lopt_reduction_vars() == 0 { passed = passed + 1 }
    if test_lopt_peel_first() == 0 { passed = passed + 1 }
    if test_lopt_peel_last() == 0 { passed = passed + 1 }
    if test_lopt_peel_trip_one() == 0 { passed = passed + 1 }
    if test_lopt_tile_size() == 0 { passed = passed + 1 }
