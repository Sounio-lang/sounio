    let c = lifetime_checker_new()
    let p1 = lt_add_static_region(c)
    let c1 = p1.0
    let p2 = lt_add_fn_region(c1, 0, 10, 200)
    let c2 = p2.0
    // Block A: [20, 50], Block B: [60, 90] — no overlap
    let p3 = lt_add_block_region(c2, 1, 20, 50)
    let c3 = p3.0
    let p4 = lt_add_block_region(c3, 1, 60, 90)
    let c4 = p4.0

    let b1 = lt_add_mutable_borrow(c4, 2, 10, 25)
    let c5 = b1.0
    let b2 = lt_add_mutable_borrow(c5, 3, 10, 65)
    let c6 = b2.0

    let conflict = lt_borrows_conflict(c6, 0, 1)
    lt_assert_true(!conflict, 15)
}

