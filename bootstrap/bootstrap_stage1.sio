fn test_te_erase_fn_mixed_params() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let params = te_make_param_kinds_3(TE_TY_I64, TE_TY_VAR, TE_TY_BOOL)
    ctx = te_erase_fn_signature(ctx, 43, params, 3, TE_TY_VAR)
    if ctx.erased_fn_count != 1 {
        print("FAIL: test_te_erase_fn_mixed_params - count\n")
        return 1
    }
    let ef = ctx.erased_fns[0 as usize]
    if te_erased_fn_is_param_erased(ef, 0) {
        print("FAIL: test_te_erase_fn_mixed_params - p0\n")
        return 1
    }
    if te_erased_fn_is_param_erased(ef, 1) == false {
        print("FAIL: test_te_erase_fn_mixed_params - p1\n")
        return 1
    }
    if te_erased_fn_is_param_erased(ef, 2) {
        print("FAIL: test_te_erase_fn_mixed_params - p2\n")
        return 1
    }
    if ef.return_erased == false {
        print("FAIL: test_te_erase_fn_mixed_params - ret\n")
        return 1
    }
    if ef.cast_ops_needed != 2 {
        print("FAIL: test_te_erase_fn_mixed_params - casts\n")
        return 1
    }
    print("PASS: test_te_erase_fn_mixed_params\n")
    return 0
}

// ============================================================
// Test 14: Function signature erasure — all concrete (no erasure)
// ============================================================

fn test_te_erase_fn_all_concrete() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let params = te_make_param_kinds_2(TE_TY_I64, TE_TY_F64)
    ctx = te_erase_fn_signature(ctx, 44, params, 2, TE_TY_BOOL)
    let ef = ctx.erased_fns[0 as usize]
    if te_erased_fn_count_erased_params(ef) != 0 {
        print("FAIL: test_te_erase_fn_all_concrete - erased\n")
        return 1
    }
    if ef.return_erased {
        print("FAIL: test_te_erase_fn_all_concrete - ret\n")
        return 1
    }
    if ef.cast_ops_needed != 0 {
        print("FAIL: test_te_erase_fn_all_concrete - casts\n")
        return 1
    }
    print("PASS: test_te_erase_fn_all_concrete\n")
    return 0
}

// ============================================================
// Test 15: Find erased function by original id
// ============================================================

fn test_te_find_erased_fn() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let p1 = te_make_param_kinds_1(TE_TY_VAR)
    let p2 = te_make_param_kinds_1(TE_TY_I64)
    ctx = te_erase_fn_signature(ctx, 42, p1, 1, TE_TY_I64)
    ctx = te_erase_fn_signature(ctx, 43, p2, 1, TE_TY_VAR)
    let idx0 = te_find_erased_fn(ctx, 42)
    if idx0 != 0 {
        print("FAIL: test_te_find_erased_fn - 0\n")
        return 1
    }
    let idx1 = te_find_erased_fn(ctx, 43)
    if idx1 != 1 {
        print("FAIL: test_te_find_erased_fn - 1\n")
        return 1
    }
    let idx_miss = te_find_erased_fn(ctx, 999)
    if idx_miss != TE_NOT_FOUND {
        print("FAIL: test_te_find_erased_fn - miss\n")
        return 1
    }
    print("PASS: test_te_find_erased_fn\n")
    return 0
}

// ============================================================
// Test 16: Witness construction — basic
// ============================================================

fn test_te_witness_basic() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let methods = te_make_methods_2_set(500, 501)
    ctx = te_build_witness(ctx, 10, 20, 16, 8, 999, methods, 2)
    if ctx.witness_count != 1 {
        print("FAIL: test_te_witness_basic - count\n")
        return 1
    }
    let w = ctx.witnesses[0 as usize]
    if w.type_id != 10 {
        print("FAIL: test_te_witness_basic - type_id\n")
        return 1
    }
    if w.trait_id != 20 {
        print("FAIL: test_te_witness_basic - trait_id\n")
        return 1
    }
    // Should have: size, align, drop, 2 methods = 5 entries
    if w.entry_count != 5 {
        print("FAIL: test_te_witness_basic - entry_count\n")
        return 1
    }
    print("PASS: test_te_witness_basic\n")
    return 0
}

// ============================================================
// Test 17: Witness find size/align/drop
// ============================================================

fn test_te_witness_find_entries() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let methods = te_make_methods_1_set(600)
    ctx = te_build_witness(ctx, 10, 20, 24, 8, 777, methods, 1)
    let w = ctx.witnesses[0 as usize]
    let sz = te_witness_find_size(w)
    if sz != 24 {
        print("FAIL: test_te_witness_find_entries - size\n")
        return 1
    }
    let al = te_witness_find_align(w)
    if al != 8 {
        print("FAIL: test_te_witness_find_entries - align\n")
        return 1
    }
    let dr = te_witness_find_drop(w)
    if dr != 777 {
        print("FAIL: test_te_witness_find_entries - drop\n")
        return 1
    }
    print("PASS: test_te_witness_find_entries\n")
    return 0
}

