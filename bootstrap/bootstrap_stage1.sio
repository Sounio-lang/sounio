    mema_ptr_has_region(ctx, p0, r0) && (mema_ptr_has_region(ctx, p0, r1) == false) &&
    mema_ptr_has_region(ctx, p1, r1) && (mema_ptr_has_region(ctx, p1, r0) == false)
}

