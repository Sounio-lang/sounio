}

// T07: BLR X8 => 0xD63F0100
fn a64_test_blr() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_blr(buf, A64_X8)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xD63F0100) { return false }
    true
}

// T08: CMP X1, X2 => SUBS XZR, X1, X2 => 0xEB02003F
fn a64_test_cmp_reg() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_cmp(buf, A64_X1, A64_X2)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xEB02003F) { return false }
    true
}

// T09: MUL X0, X1, X2 => MADD X0, X1, X2, XZR => 0x9B027C20
fn a64_test_mul() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_mul(buf, A64_X0, A64_X1, A64_X2)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0x9B027C20) { return false }
