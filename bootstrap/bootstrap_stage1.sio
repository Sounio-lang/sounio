    let idx1 = jc_insert_entry(cache, 601, JC_TIER_BASELINE, code, 8)
    let idx2 = jc_insert_entry(cache, 601, JC_TIER_OPT, code, 8)
    let idx3 = jc_insert_entry(cache, 602, JC_TIER_BASELINE, code, 8)
    let count = jc_invalidate_func(cache, 601)
    if count != 2 { return false }
    // 602 should still be valid
    jc_is_valid(cache, idx3)
}
fn test_jc_invalidate_func() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
