    p = p3.1
    let p4 = write_i64(b, p, info.monitoring_policy_id)
    b = p4.0
    p = p4.1
    let p5 = write_i64(b, p, info.audit_id)
    b = p5.0
    p = p5.1
    let p6 = write_i64(b, p, info.contest_id)
    b = p6.0
    p = p6.1
    let p7 = write_name(b, p, info.route_name)
    b = p7.0
    p = p7.1
    let p8 = write_name(b, p, info.rollback_route_name)
    b = p8.0
    p = p8.1
    let p9 = write_type_tag(b, p, info.inner_ty)
    b = p9.0
    p = p9.1
    var i: i64 = 0
    while i < 8 {
        let pair = write_i64(b, p, info.metric_known[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }
    i = 0
    while i < 8 {
        let pair = write_f64(b, p, info.metric_values[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }
    (b, p)
}

fn read_observed_transition_info(buf: [i8; 131072], pos: i64) -> (IrObservedTransitionInfo, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let p0 = read_i64(buf, p)
    let id = p0.0
    p = p0.1
    let p1 = read_i64(buf, p)
    let span_start = p1.0
    p = p1.1
    let p2 = read_i64(buf, p)
    let span_end = p2.0
    p = p2.1
    let p3 = read_i64(buf, p)
    let transition_plan_id = p3.0
    p = p3.1
    let p4 = read_i64(buf, p)
    let monitoring_policy_id = p4.0
    p = p4.1
    let p5 = read_i64(buf, p)
    let audit_id = p5.0
    p = p5.1
    let p6 = read_i64(buf, p)
    let contest_id = p6.0
    p = p6.1
    let p7 = read_name(buf, p)
    let route_name = p7.0
    p = p7.1
    let p8 = read_name(buf, p)
    let rollback_route_name = p8.0
    p = p8.1
    let p9 = read_type_tag(buf, p)
    let inner_ty = p9.0
    p = p9.1
    var metric_known: [i64; 8] = [0; 8]
    var i: i64 = 0
    while i < 8 {
        let pair = read_i64(buf, p)
        metric_known[i] = pair.0
        p = pair.1
        i = i + 1
    }
    var metric_values: [f64; 8] = [0.0; 8]
    i = 0
    while i < 8 {
        let pair = read_f64(buf, p)
        metric_values[i] = pair.0
        p = pair.1
        i = i + 1
    }
    (IrObservedTransitionInfo {
        id: id,
        span_start: span_start,
        span_end: span_end,
        transition_plan_id: transition_plan_id,
        monitoring_policy_id: monitoring_policy_id,
        audit_id: audit_id,
        contest_id: contest_id,
        route_name: route_name,
        rollback_route_name: rollback_route_name,
        inner_ty: inner_ty,
        metric_known: metric_known,
        metric_values: metric_values,
    }, p)
}

