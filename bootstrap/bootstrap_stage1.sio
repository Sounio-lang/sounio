// T16: Invalidate single entry
fn test_jc_invalidate_single_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(5 as i8, 8)
    let idx = jc_insert_entry(cache, 600, JC_TIER_BASELINE, code, 8)
    if jc_is_valid(cache, idx) == false { return false }
    let ok = jc_invalidate_entry(cache, idx)
    if ok == false { return false }
    if jc_is_valid(cache, idx) { return false }
    true
}
fn test_jc_invalidate_single() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_invalidate_single_inner(&! cache)
}

