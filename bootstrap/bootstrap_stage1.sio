    b = req_count_pair.0
    p = req_count_pair.1
    var i: i64 = 0
    while i < 8 {
        let req_pair = write_policy_requirement_info(b, p, info.requirements[i])
        b = req_pair.0
        p = req_pair.1
        i = i + 1
    }
    (b, p)
}

