// T39: Vectorization — non-counted loop
fn test_lopt_vect_non_counted_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let lcount = lopt_find_natural_loops(ctx)
    let vinfo = lopt_check_vectorizable(ctx, 0)
    // Without a known trip count, should not be vectorizable
    if vinfo.is_vectorizable {
        print("FAIL: test_lopt_vect_non_counted\n")
        return 1
    }
    print("PASS: test_lopt_vect_non_counted\n")
    return 0
}

fn test_lopt_vect_non_counted() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_simple_loop_ctx()
    return test_lopt_vect_non_counted_inner(&! ctx)
}

