    // OPT entry should survive
    jc_is_valid(cache, idx3)
}
fn test_jc_invalidate_tier() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_invalidate_tier_inner(&! cache)
}

// T20: Invalidate already-invalid entry returns false
fn test_jc_invalidate_already_invalid_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(5 as i8, 8)
    let idx = jc_insert_entry(cache, 900, JC_TIER_BASELINE, code, 8)
    let ok1 = jc_invalidate_entry(cache, idx)
    if ok1 == false { return false }
    let ok2 = jc_invalidate_entry(cache, idx)
