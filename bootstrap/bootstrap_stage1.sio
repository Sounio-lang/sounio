    emit_mov_reg_reg(buf, 6, 2)
}

// mov rdx, rcx — move fourth arg to third arg register
fn emit_mov_rdx_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 2, 1)
}

// cmp byte [rdi], 0 — compare byte at rdi with zero
fn emit_cmp_byte_rdi_zero(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 80 3f 00 — cmp byte [rdi], 0
    var b = buf
    b = emit_byte(b, 0x80)
    b = emit_byte(b, 0x3f)
    b = emit_byte(b, 0x00)
    b
}

// movzx rax, byte [rsi] — zero-extend byte at rsi into rax
fn emit_movzx_rax_byte_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f b6 06 — movzx rax, byte [rsi]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xb6)
    b = emit_byte(b, 0x06)
    b
}

// inc rsi — increment rsi
fn emit_inc_rsi_bare(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 ff c6 — inc rsi
    emit_inc_rsi(buf)
}

// cmp al, [rdi] — compare al with byte at rdi
fn emit_cmp_al_mem_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 3a 07 — cmp al, [rdi]
    var b = buf
    b = emit_byte(b, 0x3a)
    b = emit_byte(b, 0x07)
    b
}

// push rsi — save rsi on stack
fn emit_push_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x56)
}

// push rdx — save rdx on stack
fn emit_push_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x52)
}

// push rcx — save rcx on stack
fn emit_push_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x51)
}

// sub rsp, imm8 — subtract small value from rsp
fn emit_sub_rsp_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 ec <imm8> — sub rsp, imm8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xec)
    b = emit_byte(b, low8(imm))
    b
}

// add rsp, imm8 — add small value to rsp
fn emit_add_rsp_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 c4 <imm8> — add rsp, imm8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xc4)
    b = emit_byte(b, low8(imm))
    b
}

// mov rsi, rax — move rax to rsi
fn emit_mov_rsi_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 6, 0)
}

// mov rdx, rax — move rax to rdx
fn emit_mov_rdx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 2, 0)
}

// mov rax, rdi — move rdi to rax (for syscall setup)
fn emit_mov_rax_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 0, 7)
}

// mov rbx, rax — save rax in rbx
fn emit_mov_rbx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 3, 0)
}

// mov rdi, rbx — restore rbx to rdi
fn emit_mov_rdi_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_mov_reg_reg(buf, 7, 3)
}

// lea rsi, [rsp] — load stack pointer into rsi (for stat buffer)
fn emit_lea_rsi_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 e6 — mov rsi, rsp (equivalent for our purposes)
    emit_mov_rsi_rsp(buf)
}

// mov rax, [rsp + disp8] — load from stack at small displacement
fn emit_mov_rax_rsp_disp8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 44 24 <disp8> — mov rax, [rsp + disp8]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x44)
    b = emit_byte(b, 0x24)
    b = emit_byte(b, low8(disp))
    b
}

// ============================================================================
// Phase 6.2: Negative-number and float support helpers
// ============================================================================

// test rdi, rdi — set SF if rdi is negative
fn emit_test_rdi_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 85 ff — test rdi, rdi
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x85)
    b = emit_byte(b, 0xff)
    b
}

// jns rel8 — jump if not sign (SF=0, i.e. non-negative)
fn emit_jns_rel8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 79 <disp8>
    var b = buf
    b = emit_byte(b, 0x79)
    b = emit_byte(b, low8(disp))
    b
}


// JS rel8 — jump if sign flag set
fn emit_js_rel8(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 78 <disp8>
    var b = buf
    b = emit_byte(b, 0x78)
    b = emit_byte(b, low8(disp))
    b
}

// neg rdi — negate rdi (two's complement)
fn emit_neg_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 df — neg rdi
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xdf)
    b
}

// mov byte [rsi], imm8 — store immediate byte at [rsi]
fn emit_mov_byte_mem_rsi_imm8(buf: CodeBuffer, imm: i64) -> CodeBuffer with Mut, Panic, Div {
    // c6 06 <imm8>
    var b = buf
    b = emit_byte(b, 0xc6)
    b = emit_byte(b, 0x06)
    b = emit_byte(b, low8(imm))
