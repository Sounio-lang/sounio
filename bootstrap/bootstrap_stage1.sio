// ============================================================
// Test 19: Layout computation — primitives
// ============================================================

fn test_te_layout_primitives() -> i32 with IO, Mut, Div, Panic {
    let l_i64 = te_layout_for_primitive(TE_TY_I64)
    if l_i64.size != 8 {
        print("FAIL: test_te_layout_primitives - i64_size\n")
        return 1
    }
    if l_i64.alignment != 8 {
        print("FAIL: test_te_layout_primitives - i64_align\n")
        return 1
    }
    let l_bool = te_layout_for_primitive(TE_TY_BOOL)
    if l_bool.size != 1 {
        print("FAIL: test_te_layout_primitives - bool_size\n")
        return 1
    }
    let l_i32 = te_layout_for_primitive(TE_TY_I32)
    if l_i32.size != 4 {
        print("FAIL: test_te_layout_primitives - i32_size\n")
        return 1
    }
    if l_i32.alignment != 4 {
        print("FAIL: test_te_layout_primitives - i32_align\n")
        return 1
    }
    let l_unit = te_layout_for_primitive(TE_TY_UNIT)
    if l_unit.size != 0 {
        print("FAIL: test_te_layout_primitives - unit_size\n")
        return 1
    }
    print("PASS: test_te_layout_primitives\n")
    return 0
}

// ============================================================
// Test 20: Layout computation — erased and boxed
// ============================================================

fn test_te_layout_erased_boxed() -> i32 with IO, Mut, Div, Panic {
    let le = te_layout_for_erased()
    if le.size != TE_PTR_SIZE {
        print("FAIL: test_te_layout_erased_boxed - erased_size\n")
        return 1
    }
    let lb = te_layout_for_boxed()
    if lb.size != TE_PTR_SIZE {
        print("FAIL: test_te_layout_erased_boxed - boxed_size\n")
        return 1
    }
    let lv = te_layout_for_vtable_obj()
    if lv.size != TE_PTR_SIZE * 2 {
        print("FAIL: test_te_layout_erased_boxed - vtable_size\n")
        return 1
    }
    print("PASS: test_te_layout_erased_boxed\n")
    return 0
}

// ============================================================
// Test 21: Layout aggregate computation
// ============================================================

fn test_te_layout_aggregate() -> i32 with IO, Mut, Div, Panic {
    // Struct { a: i32, b: i64 } → align=8, size=16 (4 padded to 8, + 8)
    var sizes: [i64; 16] = [0; 16]
    var aligns: [i64; 16] = [0; 16]
    sizes[0 as usize] = 4
    aligns[0 as usize] = 4
    sizes[1 as usize] = 8
    aligns[1 as usize] = 8
    let layout = te_layout_aggregate(sizes, aligns, 2)
    if layout.alignment != 8 {
        print("FAIL: test_te_layout_aggregate - align\n")
        return 1
    }
    if layout.size != 16 {
        print("FAIL: test_te_layout_aggregate - size\n")
        return 1
    }
    print("PASS: test_te_layout_aggregate\n")
    return 0
}

// ============================================================
// Test 22: Align up computation
// ============================================================

fn test_te_align_up() -> i32 with IO, Mut, Div, Panic {
    let r1 = te_align_up(5, 4)
    if r1 != 8 {
        print("FAIL: test_te_align_up - 5to4\n")
        return 1
    }
    let r2 = te_align_up(8, 8)
    if r2 != 8 {
        print("FAIL: test_te_align_up - exact\n")
        return 1
    }
    let r3 = te_align_up(1, 8)
    if r3 != 8 {
        print("FAIL: test_te_align_up - 1to8\n")
        return 1
    }
    let r4 = te_align_up(0, 4)
    if r4 != 0 {
        print("FAIL: test_te_align_up - zero\n")
        return 1
    }
    print("PASS: test_te_align_up\n")
    return 0
}

// ============================================================
// Test 23: Cast chain optimization — box-unbox collapse
// ============================================================

fn test_te_optimize_box_unbox() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    // Insert a box followed by matching unbox (same dst→src chain, same type)
    let box_op = te_cast_box(10, 20, 5, 8, 8)
    let unbox_op = te_cast_unbox(20, 30, 5, 8, 8)
    ctx.cast_ops[0 as usize] = box_op
    ctx.cast_ops[1 as usize] = unbox_op
    ctx.cast_op_count = 2
    ctx = te_optimize_casts(ctx)
    if ctx.cast_op_count != 0 {
        print("FAIL: test_te_optimize_box_unbox - count\n")
        return 1
    }
    if ctx.stats.casts_optimized_away != 2 {
        print("FAIL: test_te_optimize_box_unbox - optimized\n")
        return 1
    }
    print("PASS: test_te_optimize_box_unbox\n")
    return 0
}

// ============================================================
// Test 24: Cast chain optimization — non-matching pair kept
// ============================================================

fn test_te_optimize_no_collapse() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    // Different type indices — should NOT collapse
    let box_op = te_cast_box(10, 20, 5, 8, 8)
    let unbox_op = te_cast_unbox(20, 30, 6, 8, 8)
    ctx.cast_ops[0 as usize] = box_op
    ctx.cast_ops[1 as usize] = unbox_op
    ctx.cast_op_count = 2
    ctx = te_optimize_casts(ctx)
    if ctx.cast_op_count != 2 {
        print("FAIL: test_te_optimize_no_collapse\n")
        return 1
    }
    print("PASS: test_te_optimize_no_collapse\n")
    return 0
}

// ============================================================
// Test 25: Cast chain optimization — trivial align removed
// ============================================================

fn test_te_optimize_trivial_align() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let align_op = te_cast_align(10, 20, 5, 1)
    ctx.cast_ops[0 as usize] = align_op
    ctx.cast_op_count = 1
    ctx = te_optimize_casts(ctx)
    if ctx.cast_op_count != 0 {
        print("FAIL: test_te_optimize_trivial_align - count\n")
        return 1
    }
    if ctx.stats.casts_optimized_away != 1 {
        print("FAIL: test_te_optimize_trivial_align - stat\n")
        return 1
    }
    print("PASS: test_te_optimize_trivial_align\n")
    return 0
}

// ============================================================
// Test 26: Statistics tracking
// ============================================================

fn test_te_stats_tracking() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    // Classify types
    ctx = te_classify_and_register(ctx, TE_TY_I64, 1, 8, 8)
    ctx = te_classify_and_register(ctx, TE_TY_VAR, 2, 0, 0)
    ctx = te_classify_and_register(ctx, TE_TY_TRAIT_OBJ, 3, 0, 0)
    if ctx.stats.types_classified != 3 {
        print("FAIL: test_te_stats_tracking - classified\n")
        return 1
    }
    if ctx.stats.types_concrete != 1 {
        print("FAIL: test_te_stats_tracking - concrete\n")
        return 1
    }
    if ctx.stats.types_erased != 1 {
        print("FAIL: test_te_stats_tracking - erased\n")
        return 1
    }
    if ctx.stats.types_vtable != 1 {
        print("FAIL: test_te_stats_tracking - vtable\n")
        return 1
    }
    print("PASS: test_te_stats_tracking\n")
    return 0
}

// ============================================================
// Test 27: Type map insert and lookup
// ============================================================

fn test_te_type_map() -> i32 with IO, Mut, Div, Panic {
    var map = te_type_map_new()
    let t1 = te_type_concrete(1, 8, 8)
    let t2 = te_type_erased(2)
    map = te_type_map_insert(map, 100, t1)
    map = te_type_map_insert(map, 200, t2)
    if map.count != 2 {
        print("FAIL: test_te_type_map - count\n")
        return 1
    }
    let r1 = te_type_map_lookup(map, 100)
    if r1.kind != TE_KIND_CONCRETE {
        print("FAIL: test_te_type_map - lookup1\n")
        return 1
    }
    let r2 = te_type_map_lookup(map, 200)
    if r2.kind != TE_KIND_ERASED {
        print("FAIL: test_te_type_map - lookup2\n")
        return 1
    }
    let r3 = te_type_map_lookup(map, 999)
    if r3.kind != TE_KIND_ERASED {
        // default empty is erased kind
        print("FAIL: test_te_type_map - miss\n")
        return 1
    }
    print("PASS: test_te_type_map\n")
    return 0
}

// ============================================================
// Test 28: Type map overwrite
// ============================================================

fn test_te_type_map_overwrite() -> i32 with IO, Mut, Div, Panic {
    var map = te_type_map_new()
    let t1 = te_type_concrete(1, 8, 8)
    let t2 = te_type_boxed(1, 8, 8)
    map = te_type_map_insert(map, 100, t1)
    map = te_type_map_insert(map, 100, t2)
    if map.count != 1 {
        print("FAIL: test_te_type_map_overwrite - count\n")
        return 1
    }
    let r = te_type_map_lookup(map, 100)
    if r.kind != TE_KIND_BOXED {
        print("FAIL: test_te_type_map_overwrite - kind\n")
        return 1
    }
    print("PASS: test_te_type_map_overwrite\n")
    return 0
}

