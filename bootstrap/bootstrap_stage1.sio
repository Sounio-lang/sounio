// T25: Reset clears everything
fn recv_test_reset() -> bool with IO, Mut, Panic, Div {
    var s = recv_state_new()
    var msg: [i8; 128] = [0; 128]
    s = recv_report_error(s, 1, 1, 1, 1, msg, 0)
    s = recv_push_recovery(s, recv_point_new(1, 1, 1, 1))
    s = recv_add_sync_token(s, 10)
    s = recv_enter_panic_mode(s)
    s = recv_set_max_errors(s, 10)
    s = recv_reset(s)
    let ok1 = recv_error_count(s) == 0
    let ok2 = recv_stack_depth(s) == 0
    let ok3 = recv_sync_count(s) == 0
    let ok4 = !recv_in_panic_mode(s)
    let ok5 = recv_max_errors(s) == RECV_MAX_ERRORS_DEFAULT()
    let ok6 = recv_tokens_skipped(s) == 0
    let label = recv_test_label(
        84, 50, 53, 0, 0, 0, 0, 0, 0, 0, 3)  // "T25"
    recv_assert_true(ok1 && ok2 && ok3 && ok4 && ok5 && ok6, label.0, label.1)
}

// T26: Error limit enforcement — errors beyond max_errors are dropped
fn recv_test_error_limit_enforcement() -> bool with IO, Mut, Panic, Div {
