    cn.callee_type_arg_count = 1
    body.nodes[0 as usize] = cn
    var cn2 = mono_empty_body_node()
    cn2.kind = MONO_NODE_CALL
    cn2.callee_fn_id = 99
    cn2.callee_type_arg_count = 0
    body.nodes[1 as usize] = cn2
    body.count = 2
