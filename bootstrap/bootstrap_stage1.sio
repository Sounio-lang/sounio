    let loc1 = lspg_location_new(1, 1, 0, 1, 5)
    let loc2 = lspg_location_new(1, 3, 0, 3, 5)
    // Two defs with the same name hash -- should produce only one symbol
    let d1 = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 100, loc1, 0)
    let d2 = lspg_add_definition(ctx, LspgSymKind::GSymVariable, 100, loc2, 1)
    let _ = d1
    let _ = d2
    lspg_build_def_map(ctx)
    lspg_sym_count(ctx) == 1
}
