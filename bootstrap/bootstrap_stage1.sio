    let ty = dep_term_type(ctx)
    let body = dep_term_type(ctx)
    let sig = dep_elaborate_sigma(ctx, 60, ty, body)
    if sig < 0 { return false }
    let found = dep_lookup_var(ctx, 60)
    found == ty
}
