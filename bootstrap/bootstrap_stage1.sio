// Test 43: Match last clause (priority)
fn efh_test_match_clause_last(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)
    efh_add_clause(ctx, 1, 0, 200, false, EfhResumeStrategy::ResumeMulti)  // override

    let first = efh_match_clause(ctx, 1, 0)
    let last = efh_match_clause_last(ctx, 1, 0)

    first == 0 && last == 1  // first returns 0, last returns 1
}
fn test_efh_match_clause_last() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_match_clause_last(&! ctx), 43)
}

// Test 44: Clause validation
fn efh_test_clause_validation(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)

    let ok1 = efh_is_valid_clause(ctx, 0)
    let ok2 = !efh_is_valid_clause(ctx, 1)   // out of bounds
    let ok3 = !efh_is_valid_clause(ctx, 0 - 1)  // negative

    ok1 && ok2 && ok3
}
fn test_efh_clause_validation() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_clause_validation(&! ctx), 44)
}

