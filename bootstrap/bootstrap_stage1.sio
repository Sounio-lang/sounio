        arg_count: base.arg_count,
    }
}

fn ir_call(dst: i64, fn_id: i64, fn_name: Name, args: Option<Box<IrRegList>>, arg_count: i64) -> IrInstr {
    let pair_regs = ir_reg_list_first_two(args)
    let arg0 = pair_regs.0
    let arg1 = pair_regs.1
    let base = ir_instr_new(IrOpcode::IrCall)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: arg0,
        src2: arg1,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: fn_name,
        // Keep the full argument list. src1/src2 cache the first two for compatibility.
        call_args: args,
        arg_count: arg_count,
    }
}

fn ir_reg_list_first_two(args: Option<Box<IrRegList>>) -> (i64, i64) {
    match args {
        Some(list) => {
            let a0 = (*list).head
            match (*list).tail {
                Some(rest) => (a0, (*rest).head),
                _ => (a0, IR_INVALID_REG),
            }
        }
        _ => (IR_INVALID_REG, IR_INVALID_REG),
    }
}

fn ir_return(src: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrReturn)
    IrInstr {
        op: base.op,
        dst: base.dst,
        src1: src,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: base.field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: base.name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn ir_field_get(dst: i64, base_reg: i64, field_idx: i64, field_name: Name) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrFieldGet)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: base_reg,
        src2: base.src2,
        imm_i64: base.imm_i64,
        imm_f64: base.imm_f64,
        label_id: base.label_id,
        fn_id: base.fn_id,
        field_idx: field_idx,
        imm_flags: base.imm_flags,
        bin_op: base.bin_op,
        un_op: base.un_op,
        name: field_name,
        call_args: base.call_args,
        arg_count: base.arg_count,
    }
}

fn ir_field_set(base_reg: i64, field_idx: i64, src: i64, field_name: Name) -> IrInstr {
