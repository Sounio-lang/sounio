    types[1 as usize] = t_i8
    types[2 as usize] = t_i32
    names[0 as usize] = 1
    names[1 as usize] = 2
    names[2 as usize] = 3
    lay_set_fields(ctx, s, &types, &names, 3)
    let l = lay_compute(ctx, s)
    // i64@0(8), i8@8(1), pad 3, i32@12(4), total=16, align=8
    let ok_off = l.fields[0 as usize].offset == 0
    let ok_o1 = l.fields[1 as usize].offset == 8
    let ok_o2 = l.fields[2 as usize].offset == 12
    let ok_size = l.size == 16
    ok_off && ok_o1 && ok_o2 && ok_size
}
