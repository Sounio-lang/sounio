    let child = eg_ctx_node_child(ctx, 1, 0)
    op == EG_OP_NEG && child == x && ctx.graph.node_count == 2
}
fn test_eg_unary_node() -> bool with Mut, Div, Panic {
    var ctx = eg_test_context()
    return test_eg_unary_node_inner(&! ctx)
}

