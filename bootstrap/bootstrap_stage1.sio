fn test_loc_apply_tiling_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 1000000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100000, LOC_INVALID)
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let status = loc_apply_tiling(ctx, 0, 32)
    if loc_tile_status_to_int(status) != 0 { return false }
    if ctx.loops[0 as usize].is_tiled == false { return false }
    if ctx.loops[0 as usize].tile_factor != 32 { return false }
    if ctx.tile_count != 1 { return false }
    true
}
