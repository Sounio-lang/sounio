fn test_avec_plan_summary_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph, plan: &! AvecVecPlan) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 12, false, 0)
