// T29: Tail call count query helper
fn test_tco_count_tail_calls_helper() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = tco_make_self_tail_call_func(0, 2, 0)
