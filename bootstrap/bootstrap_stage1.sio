    var env = gadt_env_new()
    return test_gadt_match_arm_evidence_correct_inner(&! env)
}

// ---- Exhaustiveness Tests (5 tests) ----

fn test_gadt_exhaustive_all_covered_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let did = gadt_add_def(env, 1, 0, pn)
    var fields: [i64; 32] = [0; 32]
    var rp: [i64; 16] = [0; 16]
    let c0 = gadt_add_ctor(env, did, 10, fields, 0, rp, 0)
    let c1 = gadt_add_ctor(env, did, 11, fields, 0, rp, 0)
    var covered: [i64; 512] = [0; 512]
    covered[0 as usize] = c0
    covered[1 as usize] = c1
    gadt_check_exhaustiveness(env, did, covered, 2)
}
fn test_gadt_exhaustive_all_covered() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_exhaustive_all_covered_inner(&! env)
}

fn test_gadt_exhaustive_missing_one_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    var pn: [i64; 16] = [0; 16]
    let did = gadt_add_def(env, 2, 0, pn)
    var fields: [i64; 32] = [0; 32]
    var rp: [i64; 16] = [0; 16]
    let c0 = gadt_add_ctor(env, did, 20, fields, 0, rp, 0)
    let c1 = gadt_add_ctor(env, did, 21, fields, 0, rp, 0)
    let c2 = gadt_add_ctor(env, did, 22, fields, 0, rp, 0)
    var covered: [i64; 512] = [0; 512]
    covered[0 as usize] = c0
    covered[1 as usize] = c2
    // Missing c1
    gadt_check_exhaustiveness(env, did, covered, 2) == false
}
