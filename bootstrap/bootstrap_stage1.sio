    var arr: [i64; 32] = [0; 32]
    arr[0 as usize] = m0
    arr[1 as usize] = m1
    return arr
}

fn te_make_methods_3_set(m0: i64, m1: i64, m2: i64) -> [i64; 32] with Mut, Panic, Div {
    var arr: [i64; 32] = [0; 32]
    arr[0 as usize] = m0
    arr[1 as usize] = m1
    arr[2 as usize] = m2
    return arr
}

fn te_make_methods_4_set(m0: i64, m1: i64, m2: i64, m3: i64) -> [i64; 32] with Mut, Panic, Div {
    var arr: [i64; 32] = [0; 32]
    arr[0 as usize] = m0
    arr[1 as usize] = m1
    arr[2 as usize] = m2
    arr[3 as usize] = m3
    return arr
}

fn te_make_param_kinds_1(k0: i64) -> [i64; 16] with Mut, Panic, Div {
    var arr: [i64; 16] = [0; 16]
    arr[0 as usize] = k0
    return arr
}

fn te_make_param_kinds_2(k0: i64, k1: i64) -> [i64; 16] with Mut, Panic, Div {
    var arr: [i64; 16] = [0; 16]
    arr[0 as usize] = k0
    arr[1 as usize] = k1
    return arr
}

fn te_make_param_kinds_3(k0: i64, k1: i64, k2: i64) -> [i64; 16] with Mut, Panic, Div {
    var arr: [i64; 16] = [0; 16]
    arr[0 as usize] = k0
    arr[1 as usize] = k1
    arr[2 as usize] = k2
    return arr
}

fn te_make_param_kinds_4(k0: i64, k1: i64, k2: i64, k3: i64) -> [i64; 16] with Mut, Panic, Div {
    var arr: [i64; 16] = [0; 16]
    arr[0 as usize] = k0
