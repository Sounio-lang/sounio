// Test 25: Perform creates a continuation
fn efh_test_perform_creates_cont(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)

    let before = efh_cont_total(ctx)
    efh_perform_effect(ctx, 1, 0, 42)
    let after = efh_cont_total(ctx)

    after == before + 1
}
fn test_efh_perform_creates_cont() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_perform_creates_cont(&! ctx), 25)
}

// Test 26: Perform logs an operation
fn efh_test_perform_logs_op(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let hid = efh_register_handler(ctx, 5, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)

    efh_perform_effect(ctx, 5, 3, 77)

    let op = efh_get_op(ctx, 0)
    efh_op_kind_eq(op.kind, EfhOpKind::OpPerform) && op.effect_id == 5 &&
    op.op_index == 3 && op.arg == 77
}
fn test_efh_perform_logs_op() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_perform_logs_op(&! ctx), 26)
}

// Test 27: Perform suspends the handler
fn efh_test_perform_suspends_handler(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let hid = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    efh_install_handler(ctx, hid)

    efh_perform_effect(ctx, 1, 0, 0)

    let state = efh_handler_state(ctx, hid)
    efh_handler_state_eq(state, EfhHandlerState::HandlerSuspended)
}
fn test_efh_perform_suspends_handler() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_perform_suspends_handler(&! ctx), 27)
}

// Test 28: Multiple performs create multiple continuations
fn efh_test_multiple_performs(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    // Register two handlers for different effects
    let h1 = efh_register_handler(ctx, 1, 100, EfhResumeStrategy::ResumeOnce)
    let h2 = efh_register_handler(ctx, 2, 200, EfhResumeStrategy::ResumeOnce)

    // Install both in separate frames
    efh_install_handler(ctx, h1)
    efh_install_handler(ctx, h2)

    efh_perform_effect(ctx, 2, 0, 10)

    // Re-activate h2 so we can find h1
    efh_set_handler_state(ctx, h2, EfhHandlerState::HandlerActive)
    efh_perform_effect(ctx, 1, 0, 20)

    efh_cont_total(ctx) == 2
}
fn test_efh_multiple_performs() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_multiple_performs(&! ctx), 28)
}

