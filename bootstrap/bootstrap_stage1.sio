        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: axiom_count,
        robustness_level_id: verifier_id,
        robustness_scope_id: -1,
    }
}

fn is_proof_type(t: TypeEntry) -> bool {
    t.kind == TypeKind::TyProof
}

fn ty_lemma(prop_ty: TypeEntry, lemma_id: i64, proof_id: i64, usage_milli: f64, dep_count: i64, strength_tag: i64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyLemma,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(prop_ty)),
        array_size: lemma_id,
        fn_sig_id: proof_id,
        tuple_elems: None,
        knowledge_epsilon: usage_milli,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: dep_count,
        robustness_level_id: strength_tag,
        robustness_scope_id: -1,
    }
}

fn is_lemma_type(t: TypeEntry) -> bool {
    t.kind == TypeKind::TyLemma
}

fn ty_axiom(prop_ty: TypeEntry, axiom_id: i64, justification_id: i64, confidence_milli: f64, axiom_class: i64, dispute_count: i64) -> TypeEntry with Alloc {
    TypeEntry {
        kind: TypeKind::TyAxiom,
        name: Name { buf: [0; 128], len: 0 },
        inner: Some(Box::new(prop_ty)),
        array_size: axiom_id,
        fn_sig_id: justification_id,
        tuple_elems: None,
        knowledge_epsilon: confidence_milli,
        algebra_kind: -1,
        clifford_p: -1,
        clifford_q: -1,
        unit_id: -1,
        refinement_id: -1,
        epistemic_meta_id: axiom_class,
        robustness_level_id: dispute_count,
        robustness_scope_id: -1,
    }
}

fn is_axiom_type(t: TypeEntry) -> bool {
    t.kind == TypeKind::TyAxiom
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/defs.sio  (2927 lines)
// ════════════════════════════════════════════════════════════════

// Definition tables for the type checker
//
// Three flat-array tables with linear scan lookup:
//   StructTable  — struct name + fields
//   EnumTable    — enum name + variants
//   FnSigTable   — fn name + params + return type + method info


// ============================================================
// Field info (for struct fields)
// ============================================================

struct FieldInfo {
    name: Name,
    ty: TypeEntry,
}

fn empty_field_info() -> FieldInfo {
    FieldInfo {
        name: Name { buf: [0; 128], len: 0 },
        ty: empty_type_entry(),
    }
}

struct FieldInfoList {
    head: FieldInfo,
    tail: Option<Box<FieldInfoList>>,
}

fn field_info_list_append(list: FieldInfoList, node: FieldInfoList) -> FieldInfoList with Mut, Alloc {
    match list.tail {
        None => FieldInfoList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => FieldInfoList {
            head: list.head,
            tail: Some(Box::new(field_info_list_append(*rest, node))),
        }
    }
}

fn field_info_list_find(opt: Option<Box<FieldInfoList>>, name: Name) -> TypeEntry with Mut, Panic, Div {
    match opt {
        None => empty_type_entry()
        Some(list) => {
            if name_eq((*list).head.name, name) {
                (*list).head.ty
            } else {
                field_info_list_find((*list).tail, name)
            }
        }
    }
}

fn field_info_list_has(opt: Option<Box<FieldInfoList>>, name: Name) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if name_eq((*list).head.name, name) {
                true
            } else {
                field_info_list_has((*list).tail, name)
            }
        }
    }
}

// ============================================================
// Struct info
// ============================================================

struct StructInfo {
    name: Name,
    fields: Option<Box<FieldInfoList>>,
    field_count: i64,
    is_linear: bool,
    type_param_count: i64,
    type_param_names: [Name; 8],
    is_generic_template: bool,
}

fn empty_struct_info() -> StructInfo {
    StructInfo {
        name: Name { buf: [0; 128], len: 0 },
        fields: None,
        field_count: 0,
        is_linear: false,
        type_param_count: 0,
        type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
        is_generic_template: false,
    }
}

// ============================================================
// Struct table
// ============================================================

struct StructTable {
    entries: [StructInfo; 128],
    count: i64,
}

fn struct_table_new() -> StructTable {
    StructTable {
        entries: [empty_struct_info(); 128],
        count: 0,
    }
}

impl StructTable {
    fn add(self, info: StructInfo) -> StructTable with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 128 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        tbl
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> StructInfo with Panic, Div {
        self.entries[idx]
    }
}

// ============================================================
// Variant info (for enum variants)
// ============================================================

struct VariantInfo {
    name: Name,
    fields: Option<Box<FieldInfoList>>,
}

fn empty_variant_info() -> VariantInfo {
    VariantInfo {
        name: Name { buf: [0; 128], len: 0 },
        fields: None,
    }
}

struct VariantInfoList {
    head: VariantInfo,
    tail: Option<Box<VariantInfoList>>,
}

fn variant_info_list_has(opt: Option<Box<VariantInfoList>>, name: Name) -> bool with Mut, Panic, Div {
    match opt {
        None => false
        Some(list) => {
            if name_eq((*list).head.name, name) {
                true
            } else {
                variant_info_list_has((*list).tail, name)
            }
        }
    }
}

// Find a variant by name and return its fields (or None)
fn variant_info_list_find_fields(opt: Option<Box<VariantInfoList>>, name: Name) -> Option<Box<FieldInfoList>> with Mut, Panic, Div {
    match opt {
        None => None
        Some(list) => {
            if name_eq((*list).head.name, name) {
                (*list).head.fields
            } else {
                variant_info_list_find_fields((*list).tail, name)
            }
        }
    }
}

// Search all variants for a field by name, return its type
fn variant_fields_find_field(variants: Option<Box<VariantInfoList>>, field_name: Name) -> TypeEntry with Mut, Panic, Div {
    match variants {
        None => ty_unknown()
        Some(vlist) => {
            let result = field_info_list_find((*vlist).head.fields, field_name)
            if result.kind != TypeKind::TyUnknown {
                result
            } else {
                variant_fields_find_field((*vlist).tail, field_name)
            }
        }
    }
}

fn variant_info_list_append(list: VariantInfoList, node: VariantInfoList) -> VariantInfoList with Mut, Alloc {
    match list.tail {
        None => VariantInfoList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => VariantInfoList {
            head: list.head,
            tail: Some(Box::new(variant_info_list_append(*rest, node))),
        }
    }
}

// ============================================================
// Enum info
// ============================================================

struct EnumInfo {
    name: Name,
    variants: Option<Box<VariantInfoList>>,
    variant_count: i64,
}

fn empty_enum_info() -> EnumInfo {
    EnumInfo {
        name: Name { buf: [0; 128], len: 0 },
        variants: None,
        variant_count: 0,
    }
}

// ============================================================
// Enum table
// ============================================================

struct EnumTable {
    entries: [EnumInfo; 32],
    count: i64,
}

fn enum_table_new() -> EnumTable {
    EnumTable {
        entries: [empty_enum_info(); 32],
        count: 0,
    }
}

impl EnumTable {
    fn add(self, info: EnumInfo) -> EnumTable with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 32 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        tbl
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> EnumInfo with Panic, Div {
        self.entries[idx]
    }

    fn find_variant_enum(self, variant_name: Name) -> i64 with Mut, Panic, Div, Alloc {
        var i: i64 = 0
        while i < self.count {
            if variant_info_list_has(self.entries[i].variants, variant_name) {
                return i
            }
            i = i + 1
        }
        -1
    }
}

// ============================================================
// Function parameter info
// ============================================================

struct FnParamInfo {
    name: Name,
    ty: TypeEntry,
}

fn empty_fn_param_info() -> FnParamInfo {
    FnParamInfo {
        name: Name { buf: [0; 128], len: 0 },
        ty: empty_type_entry(),
    }
}

struct FnParamList {
    head: FnParamInfo,
    tail: Option<Box<FnParamList>>,
}

fn fn_param_list_append(list: FnParamList, node: FnParamList) -> FnParamList with Mut, Alloc {
    match list.tail {
        None => FnParamList { head: list.head, tail: Some(Box::new(node)) }
        Some(rest) => FnParamList {
            head: list.head,
            tail: Some(Box::new(fn_param_list_append(*rest, node))),
        }
    }
}

fn fn_param_list_count(opt: Option<Box<FnParamList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + fn_param_list_count((*list).tail)
    }
}

fn fn_param_list_get(opt: Option<Box<FnParamList>>, idx: i64) -> FnParamInfo with Mut, Panic, Div, Alloc {
    match opt {
        None => empty_fn_param_info()
        Some(list) => {
            if idx == 0 {
                (*list).head
            } else {
                fn_param_list_get((*list).tail, idx - 1)
            }
        }
    }
}

// ============================================================
// Algebra registry
// ============================================================

struct AlgebraInfo {
    name: Name,
    add_commutative: bool,
    add_associative: bool,
    mul_commutative: bool,
    mul_associative: bool,
    mul_alternative: bool,
    reassoc_strategy: i64,   // 0=free, 1=blocked, 2=fano_selective
    algebra_tag: i64,        // backward compat with IR_ALG_* (3=Octonion, etc.)
    is_valid: bool,
}

struct AlgebraTable {
    entries: [AlgebraInfo; 16],
    count: i64,
}

fn empty_algebra_info() -> AlgebraInfo {
    AlgebraInfo {
        name: empty_name(),
        add_commutative: true,
        add_associative: true,
        mul_commutative: true,
        mul_associative: true,
        mul_alternative: false,
        reassoc_strategy: 0,
        algebra_tag: 0,
        is_valid: false,
    }
}

fn empty_algebra_table() -> AlgebraTable {
    AlgebraTable {
        entries: [empty_algebra_info(); 16],
        count: 0,
    }
}

// ============================================================
// Study registry
// ============================================================

struct StudyInfo {
    name: Name,
    title: Name,
    registration: Name,
    design: i32,
    sample_size: i64,
    power: f64,
    alpha: f64,
    correction: i32,
    hypotheses: [StudyHypothesis; 8],
    hypothesis_count: i32,
    outcomes: [StudyOutcome; 16],
    outcome_count: i32,
    is_valid: bool,
}

struct StudyTable {
    entries: [StudyInfo; 16],
    count: i64,
}

fn empty_study_info() -> StudyInfo {
    StudyInfo {
        name: empty_name(),
        title: empty_name(),
        registration: empty_name(),
        design: 0,
        sample_size: 0,
        power: 0.0,
        alpha: 0.0,
        correction: 0,
        hypotheses: [empty_study_hypothesis(); 8],
        hypothesis_count: 0,
        outcomes: [empty_study_outcome(); 16],
        outcome_count: 0,
        is_valid: false,
    }
}

fn empty_study_table() -> StudyTable {
    StudyTable {
        entries: [empty_study_info(); 16],
        count: 0,
    }
}

// ============================================================
// Ontology class registry
// ============================================================

struct OntologyClassInfo {
    name: Name,
    ontology_name: Name,
    class_index: i64,
    superclass_indices: [i64; 8],
    superclass_count: i64,
    all_ancestor_indices: [i64; 64],
    all_ancestor_count: i64,
    disjoint_indices: [i64; 8],
    disjoint_count: i64,
    is_valid: bool,
}

struct OntologyTable {
    entries: [OntologyClassInfo; 64],
    count: i64,
}

fn empty_ontology_class_info() -> OntologyClassInfo {
    OntologyClassInfo {
        name: empty_name(),
        ontology_name: empty_name(),
        class_index: -1,
        superclass_indices: [-1; 8],
        superclass_count: 0,
        all_ancestor_indices: [-1; 64],
        all_ancestor_count: 0,
        disjoint_indices: [-1; 8],
        disjoint_count: 0,
        is_valid: false,
    }
}

fn empty_ontology_table() -> OntologyTable {
    OntologyTable {
        entries: [empty_ontology_class_info(); 64],
        count: 0,
    }
}

fn ontology_table_find(t: OntologyTable, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < t.count {
        if name_eq(t.entries[i as usize].name, name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn ontology_table_is_subclass(t: OntologyTable, sub_idx: i64, super_idx: i64) -> bool with Mut, Panic, Div {
    if sub_idx < 0 || sub_idx >= t.count { return false }
    if sub_idx == super_idx { return true }
    var i: i64 = 0
    while i < t.entries[sub_idx as usize].all_ancestor_count {
        if t.entries[sub_idx as usize].all_ancestor_indices[i as usize] == super_idx {
            return true
        }
        i = i + 1
    }
    false
}

fn ontology_table_is_disjoint(t: OntologyTable, a_idx: i64, b_idx: i64) -> bool with Mut, Panic, Div {
    if a_idx < 0 || b_idx < 0 || a_idx >= t.count || b_idx >= t.count { return false }
    var i: i64 = 0
    while i < t.entries[a_idx as usize].disjoint_count {
        if t.entries[a_idx as usize].disjoint_indices[i as usize] == b_idx {
            return true
        }
        i = i + 1
    }
    false
}

// Returns true if class at idx has itself in its ancestor list (cycle).
fn ontology_table_has_cycle(t: OntologyTable, idx: i64) -> bool with Mut, Panic, Div {
    if idx < 0 || idx >= t.count { return false }
    var i: i64 = 0
    while i < t.entries[idx as usize].all_ancestor_count {
        if t.entries[idx as usize].all_ancestor_indices[i as usize] == idx {
            return true
        }
        i = i + 1
    }
    false
}

fn ontology_table_compute_closure(t: OntologyTable) -> OntologyTable with Mut, Panic, Div {
    var out = t
    // Seed: each class has its direct superclasses as ancestors
    var i: i64 = 0
    while i < out.count {
        var j: i64 = 0
        while j < out.entries[i as usize].superclass_count {
            let sup = out.entries[i as usize].superclass_indices[j as usize]
            // Reject self-loops immediately
            if sup == i { j = j + 1 }
            else if sup >= 0 && out.entries[i as usize].all_ancestor_count < 64 {
                out.entries[i as usize].all_ancestor_indices[out.entries[i as usize].all_ancestor_count as usize] = sup
                out.entries[i as usize].all_ancestor_count = out.entries[i as usize].all_ancestor_count + 1
                j = j + 1
            } else {
                j = j + 1
            }
        }
        i = i + 1
    }
    // Fixed-point: propagate through hierarchy
    var changed = true
    var iterations: i64 = 0
    while changed && iterations < 256 {
        changed = false
        iterations = iterations + 1
        i = 0
        while i < out.count {
            var j: i64 = 0
            while j < out.entries[i as usize].all_ancestor_count {
                let anc_idx = out.entries[i as usize].all_ancestor_indices[j as usize]
                if anc_idx >= 0 && anc_idx < out.count {
                    var k: i64 = 0
                    while k < out.entries[anc_idx as usize].all_ancestor_count {
                        let transitive = out.entries[anc_idx as usize].all_ancestor_indices[k as usize]
                        // Skip if transitive ancestor is self (cycle)
                        if transitive == i {
                            k = k + 1
                        } else {
                            // Check if already present
                            var found = false
                            var m: i64 = 0
                            while m < out.entries[i as usize].all_ancestor_count {
                                if out.entries[i as usize].all_ancestor_indices[m as usize] == transitive {
                                    found = true
                                }
                                m = m + 1
                            }
                            if !found && out.entries[i as usize].all_ancestor_count < 64 {
                                out.entries[i as usize].all_ancestor_indices[out.entries[i as usize].all_ancestor_count as usize] = transitive
                                out.entries[i as usize].all_ancestor_count = out.entries[i as usize].all_ancestor_count + 1
                                changed = true
                            }
                            k = k + 1
                        }
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    // Post-closure cycle check: invalidate classes that ended up in cycles
    i = 0
    while i < out.count {
        if ontology_table_has_cycle(out, i) {
            out.entries[i as usize].is_valid = false
        }
        i = i + 1
    }
    out
}

// ============================================================
// Hyper expression metadata
// ============================================================

struct HyperExprInfo {
    span_start: i64,
    span_end: i64,
    algebra_tag: i64,
    op_kind: i64,  // 1 = multiply
    knowledge_wrapped: bool,
}

fn empty_hyper_expr_info() -> HyperExprInfo {
    HyperExprInfo {
        span_start: 0,
        span_end: 0,
        algebra_tag: -1,
        op_kind: 0,
        knowledge_wrapped: false,
    }
}

struct HyperExprTable {
    entries: [HyperExprInfo; 128],
    count: i64,
}

fn hyper_expr_table_new() -> HyperExprTable {
    HyperExprTable {
        entries: [empty_hyper_expr_info(); 128],
        count: 0,
    }
}

impl HyperExprTable {
    fn add(self, info: HyperExprInfo) -> (HyperExprTable, i64) with Mut, Panic, Div {
        var tbl = self
        if tbl.count < 128 {
            let idx = tbl.count
            tbl.entries[idx as usize] = info
            tbl.count = idx + 1
            return (tbl, idx)
        }
        (tbl, -1)
    }
}

// ============================================================
// Function signature
// ============================================================

struct FnSig {
    name: Name,
    params: Option<Box<FnParamList>>,
    param_count: i64,
    return_type: TypeEntry,
    is_method: bool,
    self_type_name: Name,
    self_type_entry: TypeEntry,   // Semantic receiver type (replaces string heuristic)
    effects: [i64; 8],        // Effect IDs (encoded as integers for now)
    effect_count: i64,
    is_kernel: bool,
    is_epistemic_kernel: bool,
    // Sprint 231: Unified closure type theory
    is_linear_closure: bool,      // true if captures linear resources => call exactly once
    linear_capture_count: i64,    // number of linear captures
    epistemic_epsilon: f64,       // combined GUM epsilon from Knowledge captures (-1.0 = none)
}

fn empty_fn_sig() -> FnSig {
    FnSig {
        name: Name { buf: [0; 128], len: 0 },
        params: None,
        param_count: 0,
        return_type: ty_unit(),
        is_method: false,
        self_type_name: Name { buf: [0; 128], len: 0 },
        self_type_entry: ty_unit(),
        effects: [0; 8],
        effect_count: 0,
        is_kernel: false,
        is_epistemic_kernel: false,
        is_linear_closure: false,
        linear_capture_count: 0,
        epistemic_epsilon: 0.0 - 1.0,
    }
}

// ============================================================
// FnSig table
// ============================================================

struct FnSigTable {
    entries: [FnSig; 64],
    count: i64,
}

fn fn_sig_table_new() -> FnSigTable {
    FnSigTable {
        entries: [empty_fn_sig(); 64],
        count: 0,
    }
}

impl FnSigTable {
    fn add(self, sig: FnSig) -> (FnSigTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 64 {
            tbl.entries[tbl.count] = sig
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) && !self.entries[i].is_method {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn find_method(self, type_name: Name, method_name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if self.entries[i].is_method && name_eq(self.entries[i].self_type_name, type_name) && name_eq(self.entries[i].name, method_name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    // Semantic method lookup: matches by TypeEntry kind+name instead of Name alone.
    // Resolves ambiguity when two types in different modules share a name.
    fn find_method_semantic(self, receiver_ty: TypeEntry, method_name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if self.entries[i].is_method && name_eq(self.entries[i].name, method_name) {
                // Semantic match: compare type kind and name
                let sig_ty = self.entries[i].self_type_entry
                if sig_ty.kind == receiver_ty.kind && name_eq(sig_ty.name, receiver_ty.name) {
                    return i
                }
            }
            i = i + 1
        }
        // Fallback to string-based lookup for backward compatibility
        self.find_method(receiver_ty.name, method_name)
    }

    fn get(self, idx: i64) -> FnSig with Panic, Div {
        self.entries[idx]
    }
}

// ============================================================
// Contest / robustness policy metadata
// ============================================================

let CONTEST_METRIC_SIGN_CONSENSUS: i64 = 0
let CONTEST_METRIC_RELATIVE_BAND: i64 = 1
let CONTEST_METRIC_MAX_TAIL_RISK: i64 = 2
let CONTEST_METRIC_MECHANISTIC_DIVERGENCE: i64 = 3
let CONTEST_METRIC_IDENTIFIABILITY_FLOOR: i64 = 4
let CONTEST_METRIC_COUNTEREXAMPLE_PRESENT: i64 = 5
let CONTEST_METRIC_DEFERRED_REASON: i64 = 6
let CONTEST_METRIC_COUNT: i64 = 7

let POLICY_THRESHOLD_F64: i64 = 0
let POLICY_THRESHOLD_BOOL: i64 = 1
let POLICY_THRESHOLD_NAME: i64 = 2

struct PolicyRequirementInfo {
    metric_id: i64,
    metric_name: Name,
    op: CompareOp,
    threshold: f64,
    threshold_kind: i64,
    bool_threshold: bool,
    name_threshold: Name,
}

fn empty_policy_requirement_info() -> PolicyRequirementInfo {
    PolicyRequirementInfo {
        metric_id: -1,
        metric_name: Name { buf: [0; 128], len: 0 },
        op: CompareOp::CmpEq,
        threshold: 0.0,
        threshold_kind: POLICY_THRESHOLD_F64,
        bool_threshold: false,
        name_threshold: Name { buf: [0; 128], len: 0 },
    }
}

struct PolicyRequirementInfoList {
    head: PolicyRequirementInfo,
    tail: Option<Box<PolicyRequirementInfoList>>,
}

struct PolicyInfo {
    name: Name,
    target_ty: TypeEntry,
    level_name: Name,
    scope_name: Name,
    level_id: i64,
    scope_id: i64,
    requirements: Option<Box<PolicyRequirementInfoList>>,
    requirement_count: i64,
}

fn empty_policy_info() -> PolicyInfo {
    PolicyInfo {
        name: Name { buf: [0; 128], len: 0 },
        target_ty: empty_type_entry(),
        level_name: Name { buf: [0; 128], len: 0 },
        scope_name: Name { buf: [0; 128], len: 0 },
        level_id: -1,
        scope_id: -1,
        requirements: None,
        requirement_count: 0,
    }
}

struct PolicyTable {
    entries: [PolicyInfo; 16],
    count: i64,
}

fn policy_table_new() -> PolicyTable {
    PolicyTable {
        entries: [empty_policy_info(); 16],
        count: 0,
    }
}

impl PolicyTable {
    fn add(self, info: PolicyInfo) -> (PolicyTable, i64) with Mut, Panic, Div {
        var tbl = self
        let idx = tbl.count
        if tbl.count < 16 {
            tbl.entries[tbl.count] = info
            tbl.count = tbl.count + 1
        }
        (tbl, idx)
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get(self, idx: i64) -> PolicyInfo with Panic, Div {
        self.entries[idx]
    }
}

