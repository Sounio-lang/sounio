        print_name_value(model_name)
        print(" has Model<")
        print_type_name(got_input)
        print(", ")
        print_type_name(got_output)
        print(">\n   = expected Model<")
        print_type_name(expected_input)
        print(", ")
        print_type_name(expected_output)
        print(">\n")
        c
    }

