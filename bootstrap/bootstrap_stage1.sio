    test_dep_unify_same_bool_inner(&! ctx)
}

fn test_dep_unify_diff_kind_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Int vs Bool should fail
    let a = dep_term_int(ctx, 1)
    let b = dep_term_bool(ctx, 1)
    let r = dep_unify(ctx, a, b)
    dep_unify_result_is_fail(r)
}
