// T10: Natural loop detection
fn test_lopt_find_natural_loops() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_simple_loop_ctx()
    let count = lopt_find_natural_loops(&! ctx)
    if count != 1 {
        print("FAIL: test_lopt_find_natural_loops count\n")
        return 1
    }
    if ctx.nest.loops[0].header != 1 {
        print("FAIL: test_lopt_find_natural_loops header\n")
        return 1
    }
    if ctx.nest.loops[0].latch != 2 {
        print("FAIL: test_lopt_find_natural_loops latch\n")
        return 1
    }
    print("PASS: test_lopt_find_natural_loops\n")
    return 0
}

// T11: Exit block detection
fn test_lopt_exit_blocks() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_simple_loop_ctx()
    let count = lopt_find_natural_loops(&! ctx)
    // Exit block should be block 1 (header), since 1->3 exits the loop
    let lp = ctx.nest.loops[0]
    if lp.exit_count < 1 {
        print("FAIL: test_lopt_exit_blocks count\n")
        return 1
    }
    // Block 1 has a successor (3) outside the loop
    if lp.exits[0] != 1 {
        print("FAIL: test_lopt_exit_blocks value\n")
        return 1
    }
    print("PASS: test_lopt_exit_blocks\n")
    return 0
}

// T12: Nested loop detection
fn test_lopt_nested_loops() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_make_nested_loop_ctx()
    let count = lopt_find_natural_loops(&! ctx)
    // Should find 2 loops: inner (3->2) and outer (4->1)
    if count != 2 {
        print("FAIL: test_lopt_nested_loops count\n")
        return 1
    }
    print("PASS: test_lopt_nested_loops\n")
    return 0
}

// T13: Loop tree construction
fn test_lopt_build_loop_tree_inner(ctx: &! LoptContext) -> i32 with IO, Mut, Div, Panic {
    let count = lopt_find_natural_loops(ctx)
    let max_depth = lopt_build_loop_tree(ctx)
    if max_depth < 2 {
        print("FAIL: test_lopt_build_loop_tree depth\n")
        return 1
    }
    print("PASS: test_lopt_build_loop_tree\n")
    return 0
}

fn test_lopt_build_loop_tree() -> i32 with IO, Mut, Div, Panic {
