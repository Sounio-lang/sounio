// Section 27: Query Helpers
// ============================================================================

// Get the number of arrays registered.
fn loc_array_count(ctx: &LocContext) -> i64 {
    ctx.array_count
}

// Get the number of loops registered.
fn loc_loop_count(ctx: &LocContext) -> i64 {
    ctx.loop_count
}

// Get the number of accesses registered.
fn loc_access_count(ctx: &LocContext) -> i64 {
    ctx.access_count
}

// Get the number of tiles applied.
fn loc_tile_count(ctx: &LocContext) -> i64 {
    ctx.tile_count
}

// Get the number of prefetches inserted.
fn loc_prefetch_count(ctx: &LocContext) -> i64 {
    ctx.prefetch_count
}

// Get the number of reuse entries computed.
fn loc_reuse_count(ctx: &LocContext) -> i64 {
    ctx.reuse_count
}

// Get a tile config by index.
fn loc_get_tile(ctx: &LocContext, idx: i64) -> LocTileConfig with Div, Panic {
    if idx < 0 { return loc_tile_default() }
    if idx >= ctx.tile_count { return loc_tile_default() }
    ctx.tiles[idx as usize]
}

// Get a prefetch point by index.
fn loc_get_prefetch(ctx: &LocContext, idx: i64) -> LocPrefetchPoint with Div, Panic {
    if idx < 0 { return loc_prefetch_default() }
    if idx >= ctx.prefetch_count { return loc_prefetch_default() }
    ctx.prefetches[idx as usize]
}

// Get a reuse info by index.
fn loc_get_reuse(ctx: &LocContext, idx: i64) -> LocReuseInfo with Div, Panic {
    if idx < 0 { return loc_reuse_default() }
    if idx >= ctx.reuse_count { return loc_reuse_default() }
    ctx.reuse[idx as usize]
}

// Get cache line size from context.
fn loc_cache_line(ctx: &LocContext) -> i64 {
    ctx.cache_line_size
}

// Count accesses with a given stride kind.
fn loc_count_by_stride(ctx: &LocContext, kind: LocStrideKind) -> i64 with Mut, Div, Panic {
    let target = loc_stride_kind_to_int(kind)
    var count: i64 = 0
    var i: i64 = 0
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    if i < ctx.access_count {
        if loc_stride_kind_to_int(ctx.accesses[i as usize].stride_kind) == target { count = count + 1 }
        i = i + 1
    }
    count
}

