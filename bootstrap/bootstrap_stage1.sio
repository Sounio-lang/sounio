fn test_avec_plan_new_inner(plan: &! AvecVecPlan) -> bool with Mut, Div, Panic {
    if plan.loop_id != AVEC_INVALID { return false }
    if plan.vec_width != AVEC_VEC_128 { return false }
    if plan.is_profitable { return false }
    if plan.var_count != 0 { return false }
    true
}

fn test_avec_plan_new() -> bool with Mut, Div, Panic {
    var plan = avec_plan_new()
    test_avec_plan_new_inner(&! plan)
}

fn test_avec_plan_simple_loop_inner(nest: &! AvecLoopNest, graph: &! AvecDepGraph, plan: &! AvecVecPlan) -> bool with Mut, Div, Panic {
    // Simple vectorizable loop: a[i] = b[i] + c[i], 100 iterations
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 11, 21, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 12, 10, 11, false, 0)
    let dep_count = avec_build_dep_graph(graph, nest, 0)
    let result = avec_plan_loop(plan, nest, graph, 0)
    if plan.loop_id != 0 { return false }
    if plan.vec_width < AVEC_VEC_128 { return false }
    true
}

