    var sig = mono_empty_fn_sig()
    sig.fn_id = 0
    sig.name_hash = 111
    sig.is_generic = true
    let idx = mono_fn_table_add(table, sig)
    if idx != 0 {
        print("FAIL: test_mono_fn_table_basic - idx\n")
        return 1
    }
    let got = mono_fn_table_get(table, 0)
    if got.name_hash != 111 {
        print("FAIL: test_mono_fn_table_basic - hash\n")
        return 1
    }
    print("PASS: test_mono_fn_table_basic\n")
    return 0
}

