fn test_lsc_empty_field() -> bool {
    let f = lsc_empty_field()
    let ok_name = f.name_id == 0
    let ok_type = f.type_id == 0
    let ok_struct = f.struct_id == 0
    ok_name && ok_type && ok_struct
}

