}
fn test_jc_not_hot_at_warm() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_not_hot_at_warm_inner(&! cache)
}

// T29: is_hot becomes true after HOT_THRESHOLD calls
fn test_jc_becomes_hot_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < JC_HOT_THRESHOLD {
        let c = jc_record_call(cache, 1103)
