// Test 67: Linear type consumed via explicit drop — no error
fn own_test_67_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyLinear, 10)
    let d = own_explicit_drop(ctx, id, 15)
    let ok = own_check_linear_at_end(ctx)
