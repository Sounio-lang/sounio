// T51: should_compile recommends OPT for hot function
fn test_jc_should_compile_hot_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < JC_HOT_THRESHOLD {
        let c = jc_record_call(cache, 2600)
        i = i + 1
    }
    let tier = jc_should_compile(cache, 2600)
    tier == JC_TIER_OPT
}
