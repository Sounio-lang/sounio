    test_dep_unify_add_terms_inner(&! ctx)
}

fn test_dep_unify_occurs_fail_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Unifying x with (x + 1) should fail (occurs check)
    let x = dep_term_var(ctx, 1)
    let one = dep_term_int(ctx, 1)
    let sum = dep_term_add(ctx, x, one)
    let r = dep_unify(ctx, x, sum)
