// T39: Has self-recursive calls helper
fn test_tco_has_self_recursive_helper() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = tco_make_self_tail_call_func(0, 2, 0)
    funcs[1] = tco_make_test_func(1, 5)
    let module = tco_make_test_module(funcs, 2)

    var ctx = tco_context_new()
    ctx = tco_discover_tail_calls(ctx, module)
    ctx = tco_detect_self_recursive(ctx, module)

    let has_self_0 = tco_has_self_recursive_calls(ctx, 0)
    let has_self_1 = tco_has_self_recursive_calls(ctx, 1)
    if !has_self_0 {
        print("FAIL: test_tco_has_self_recursive_helper (f0)\n")
        return 1
    }
    if has_self_1 {
        print("FAIL: test_tco_has_self_recursive_helper (f1)\n")
        return 1
    }
    print("PASS: test_tco_has_self_recursive_helper\n")
    return 0
}

// T40: Transform kind count helper
fn test_tco_count_transforms_of_kind() -> i32 with IO, Mut, Div, Panic {
    var ctx = tco_context_new()
    // Add two self-to-loop transforms and one trampoline
    var x1 = tco_transform_new(0, TCO_KIND_SELF_TO_LOOP, 0)
    var x2 = tco_transform_new(1, TCO_KIND_SELF_TO_LOOP, 1)
    var x3 = tco_transform_new(2, TCO_KIND_MUTUAL_TO_TRAMPOLINE, TCO_INVALID)
    ctx.transforms[0] = x1
    ctx.transforms[1] = x2
    ctx.transforms[2] = x3
    ctx.transform_count = 3

    let self_count = tco_count_transforms_of_kind(ctx, TCO_KIND_SELF_TO_LOOP)
    let mutual_count = tco_count_transforms_of_kind(ctx, TCO_KIND_MUTUAL_TO_TRAMPOLINE)
    if self_count != 2 {
        print("FAIL: test_tco_count_transforms_of_kind (self)\n")
        return 1
    }
    if mutual_count != 1 {
        print("FAIL: test_tco_count_transforms_of_kind (mutual)\n")
        return 1
    }
    print("PASS: test_tco_count_transforms_of_kind\n")
    return 0
}

// T41: Empty module analysis
fn test_tco_empty_module() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let module = tco_make_test_module(funcs, 0)

    var ctx = tco_context_new()
    ctx = tco_analyze_module(ctx, module)
    ctx = tco_discover_tail_calls(ctx, module)

    if ctx.stats.analyzed != 0 {
        print("FAIL: test_tco_empty_module (analyzed)\n")
        return 1
    }
    if ctx.call_info_count != 0 {
        print("FAIL: test_tco_empty_module (calls)\n")
        return 1
    }
    print("PASS: test_tco_empty_module\n")
    return 0
}

// T42: Callee id lookup
fn test_tco_get_callee_id() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let name_b = tco_make_func_name(102 as i8, 1)
    funcs[0] = tco_make_tail_call_to(0, name_b, 1, 1)
    funcs[1] = tco_make_test_func(1, 3)
    let module = tco_make_test_module(funcs, 2)

    // Find the call instruction in func 0
    var call_idx: i64 = TCO_INVALID
    var si: i64 = 0
    while si < funcs[0].instr_count {
        if tco_is_call(funcs[0].instrs[si as usize]) {
            call_idx = si
        }
        si = si + 1
    }

    let callee = tco_get_callee_id(module, 0, call_idx)
    if callee != 1 {
        print("FAIL: test_tco_get_callee_id\n")
        return 1
    }
    print("PASS: test_tco_get_callee_id\n")
    return 0
}

// T43: A-tail-calls-B helper
fn test_tco_a_tail_calls_b() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let pair = tco_make_mutual_pair(0, 1)
    funcs[0] = pair.0
    funcs[1] = pair.1
    let module = tco_make_test_module(funcs, 2)

    var ctx = tco_context_new()
    ctx = tco_analyze_module(ctx, module)
    ctx = tco_discover_tail_calls(ctx, module)

    let a_calls_b = tco_a_tail_calls_b(ctx, module, 0, 1)
    let b_calls_a = tco_a_tail_calls_b(ctx, module, 1, 0)
    if !a_calls_b {
        print("FAIL: test_tco_a_tail_calls_b (A->B)\n")
        return 1
    }
    if !b_calls_a {
        print("FAIL: test_tco_a_tail_calls_b (B->A)\n")
        return 1
    }
    print("PASS: test_tco_a_tail_calls_b\n")
    return 0
}

// T44: Record trampoline in context
fn test_tco_record_trampoline() -> i32 with IO, Mut, Div, Panic {
    var ctx = tco_context_new()
    var group = tco_mutual_group_new()
    group.func_ids[0] = 0
    group.func_ids[1] = 1
    group.count = 2

    ctx = tco_record_trampoline(ctx, group, 10000)

    if ctx.transform_count != 2 {
        print("FAIL: test_tco_record_trampoline (count)\n")
        return 1
    }
    if ctx.transforms[0].kind != TCO_KIND_MUTUAL_TO_TRAMPOLINE {
        print("FAIL: test_tco_record_trampoline (kind)\n")
        return 1
    }
    if ctx.transforms[0].trampoline_id != 10000 {
        print("FAIL: test_tco_record_trampoline (trampoline_id)\n")
        return 1
    }
    print("PASS: test_tco_record_trampoline\n")
    return 0
}

// T45: Func name generation
fn test_tco_make_func_name() -> i32 with IO, Mut, Div, Panic {
    let n0 = tco_make_func_name(102 as i8, 0)   // "f0"
    let n5 = tco_make_func_name(102 as i8, 5)   // "f5"
    let n12 = tco_make_func_name(102 as i8, 12) // "f12"

    if n0.len != 2 || n0.buf[0] != 102 as i8 || n0.buf[1] != 48 as i8 {
        print("FAIL: test_tco_make_func_name (f0)\n")
        return 1
    }
    if n5.len != 2 || n5.buf[1] != 53 as i8 {
        print("FAIL: test_tco_make_func_name (f5)\n")
        return 1
    }
    if n12.len != 3 || n12.buf[1] != 49 as i8 || n12.buf[2] != 50 as i8 {
        print("FAIL: test_tco_make_func_name (f12)\n")
        return 1
    }
    print("PASS: test_tco_make_func_name\n")
    return 0
}

// T46: Eligible function count in stats
fn test_tco_eligible_stats() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    funcs[0] = tco_make_self_tail_call_func(0, 2, 0)  // eligible
    funcs[1] = tco_make_func_with_alloca(1)             // not eligible
    funcs[2] = tco_make_test_func(2, 3)                 // eligible (no tail calls but eligible)
    let module = tco_make_test_module(funcs, 3)

    var ctx = tco_context_new()
    ctx = tco_analyze_module(ctx, module)

    if ctx.stats.eligible != 2 {
        print("FAIL: test_tco_eligible_stats (eligible=")
        print_int(ctx.stats.eligible)
        print(")\n")
        return 1
    }
    if ctx.stats.rejected != 1 {
        print("FAIL: test_tco_eligible_stats (rejected=")
        print_int(ctx.stats.rejected)
        print(")\n")
        return 1
    }
    print("PASS: test_tco_eligible_stats\n")
    return 0
}

// T47: Non-recursive tail call (to different function, not mutual)
fn test_tco_non_recursive_tail_call() -> i32 with IO, Mut, Div, Panic {
    var funcs: [IrFunction; 1024] = [ir_empty_function(); 1024]
    let name_b = tco_make_func_name(102 as i8, 1)
    funcs[0] = tco_make_tail_call_to(0, name_b, 1, 2)
    funcs[1] = tco_make_test_func(1, 3)
    let module = tco_make_test_module(funcs, 2)

    var ctx = tco_context_new()
    ctx = tco_discover_tail_calls(ctx, module)
    ctx = tco_detect_self_recursive(ctx, module)

    // Should find 1 tail call, but not self-recursive
    if ctx.call_info_count != 1 {
        print("FAIL: test_tco_non_recursive_tail_call (count)\n")
        return 1
    }
    if ctx.call_infos[0].is_self_recursive {
        print("FAIL: test_tco_non_recursive_tail_call (should not be self)\n")
        return 1
    }
    print("PASS: test_tco_non_recursive_tail_call\n")
    return 0
}

// T48: Trampoline id allocation
fn test_tco_allocate_trampoline_id() -> i32 with IO, Mut, Div, Panic {
