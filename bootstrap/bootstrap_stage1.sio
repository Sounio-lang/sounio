    if test_lopt_compute_loop_body() == 0 { passed = passed + 1 }
    if test_lopt_single_block_loop() == 0 { passed = passed + 1 }
    if test_lopt_find_natural_loops() == 0 { passed = passed + 1 }
    if test_lopt_exit_blocks() == 0 { passed = passed + 1 }
    if test_lopt_nested_loops() == 0 { passed = passed + 1 }
    if test_lopt_build_loop_tree() == 0 { passed = passed + 1 }
    if test_lopt_nesting_depth() == 0 { passed = passed + 1 }
    if test_lopt_no_loops() == 0 { passed = passed + 1 }
    if test_lopt_find_ivs() == 0 { passed = passed + 1 }
