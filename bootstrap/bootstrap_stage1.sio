    let c25 = write_i64(b, p, ep.alternative_reason_witness_count)
    b = c25.0
    p = c25.1
    i = 0
    while i < ep.alternative_reason_witness_count {
        let pair = write_alternative_reason_witness_info(b, p, ep.alternative_reason_witnesses[i])
        b = pair.0
