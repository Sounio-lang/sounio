// T44: Deep chain — staleness propagates through many levels.
fn test_inc_invalidate_deep_chain_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    // Chain of 8: 0->1->2->3->4->5->6->7
    inc_make_chain(ctx, 8)
