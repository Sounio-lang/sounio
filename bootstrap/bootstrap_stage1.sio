    }
    if info.tail_call_count != 0 {
        print("FAIL: test_tco_analyze_no_tail_calls (count)\n")
        return 1
    }
    if !info.is_eligible {
        print("FAIL: test_tco_analyze_no_tail_calls (eligible)\n")
        return 1
    }
    print("PASS: test_tco_analyze_no_tail_calls\n")
    return 0
}

