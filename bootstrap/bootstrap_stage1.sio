// T45: Stale count is correct after transitive invalidation.
fn test_inc_stale_count_after_invalidation_inner(ctx: &! IncContext) -> bool with Mut, Div, Panic {
    // Chain: 0->1->2->3
    inc_make_chain(ctx, 4)
    inc_set_all_unchanged(ctx)
    // Modify node 2 — should stale 0, 1, 2 (but not 3)
    inc_modify_node(ctx, 2)
    inc_detect_changes(ctx)
    inc_invalidate_transitive(ctx)

    // Direct stale: 2. Transitive: 1 (depends on 2), 0 (depends on 1).
    // Node 3 is NOT stale (2 depends on 3, not the other way).
    let expected = 3
    inc_stale_count(ctx) == expected
}

