    if test_lopt_safe_div() == 0 { passed = passed + 1 }
    if test_lopt_block_loop_map() == 0 { passed = passed + 1 }
    if test_lopt_dep_direction() == 0 { passed = passed + 1 }

    print("\nLoop Optimization: ")
    print_int(passed)
    print(" / ")
    print_int(total)
