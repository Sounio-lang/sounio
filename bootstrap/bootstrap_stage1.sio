fn a64_test_nop() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_nop(buf)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xD503201F) { return false }
    true
}

// T05: RET => 0xD65F03C0 (ret x30)
fn a64_test_ret() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_ret(buf)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xD65F03C0) { return false }
    true
}

// T06: MOV X0, X1 => ORR X0, XZR, X1 => 0xAA0103E0
fn a64_test_mov_reg() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_mov(buf, A64_X0, A64_X1)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xAA0103E0) { return false }
