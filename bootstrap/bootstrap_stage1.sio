fn test_dep_unify_same_int_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let a = dep_term_int(ctx, 42)
    let b = dep_term_int(ctx, 42)
    let r = dep_unify(ctx, a, b)
    dep_unify_result_is_ok(r)
}
fn test_dep_unify_same_int() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_unify_same_int_inner(&! ctx)
}

fn test_dep_unify_diff_int_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let a = dep_term_int(ctx, 42)
    let b = dep_term_int(ctx, 43)
    let r = dep_unify(ctx, a, b)
    dep_unify_result_is_fail(r)
}
fn test_dep_unify_diff_int() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_unify_diff_int_inner(&! ctx)
}

fn test_dep_unify_var_binds_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Unifying x with 5 should succeed and record substitution
    let x = dep_term_var(ctx, 1)
    let five = dep_term_int(ctx, 5)
    let old_subst = ctx.subst_count
    let r = dep_unify(ctx, x, five)
    if dep_unify_result_is_ok(r) == false { return false }
    // Should have added one substitution
    ctx.subst_count == old_subst + 1
}
fn test_dep_unify_var_binds() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_unify_var_binds_inner(&! ctx)
}

fn test_dep_unify_var_right_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // Unifying 5 with x should also succeed
    let five = dep_term_int(ctx, 5)
    let x = dep_term_var(ctx, 2)
    let r = dep_unify(ctx, five, x)
    dep_unify_result_is_ok(r)
}
fn test_dep_unify_var_right() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_unify_var_right_inner(&! ctx)
}

fn test_dep_unify_same_bool_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
