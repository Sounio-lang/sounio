        i = i + 1
    }

    let c23 = write_i64(b, p, ep.alternative_candidate_count)
    b = c23.0
    p = c23.1
    i = 0
    while i < ep.alternative_candidate_count {
        let pair = write_alternative_candidate_info(b, p, ep.alternative_candidates[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c24 = write_i64(b, p, ep.alternative_set_count)
    b = c24.0
    p = c24.1
    i = 0
    while i < ep.alternative_set_count {
        let pair = write_alternative_set_info(b, p, ep.alternative_sets[i])
