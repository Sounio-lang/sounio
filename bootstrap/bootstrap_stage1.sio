// Test 69: Affine type NOT consumed — no error (affine can be dropped implicitly)
fn own_test_69_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)
    // Do NOT consume it — affine is fine
