    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i8
    types[1 as usize] = t_i64
    names[0 as usize] = 1
    names[1 as usize] = 2
    lay_set_fields(ctx, s, &types, &names, 2)
    let l = lay_compute(ctx, s)
    // size=16, field sizes = 1+8 = 9, padding = 7
    let padding = lay_total_padding(&l)
    padding == 7
}
fn test_lay_17_total_padding() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_17_total_padding_inner(&! ctx), 17)
}

