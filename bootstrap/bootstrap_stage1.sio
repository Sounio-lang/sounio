// self-hosted::native::mod — Native x86-64 backend
//
// Self-hosted native code generator for x86-64 Linux/macOS.
// Implements the full compilation pipeline from HIR to executable binaries.

// Core codegen orchestrator
// (placeholder imports - will wire up once modules compile)

fn native_codegen_version() -> i64 {
    1  // Version 0.1.0
}


// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/native/regs.sio  (99 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::native::regs — Register allocation and mapping
//
// Simple fixed register allocation for bootstrap (no spilling).


// x86-64 register indices (hardware encoding)
fn reg_rax() -> i64 { 0 }
fn reg_rcx() -> i64 { 1 }
fn reg_rdx() -> i64 { 2 }
fn reg_rbx() -> i64 { 3 }
fn reg_rsp() -> i64 { 4 }
fn reg_rbp() -> i64 { 5 }
fn reg_rsi() -> i64 { 6 }
fn reg_rdi() -> i64 { 7 }
fn reg_r8() -> i64  { 8 }
fn reg_r9() -> i64  { 9 }
fn reg_r10() -> i64 { 10 }
fn reg_r11() -> i64 { 11 }
fn reg_r12() -> i64 { 12 }
fn reg_r13() -> i64 { 13 }
fn reg_r14() -> i64 { 14 }
fn reg_r15() -> i64 { 15 }

// System V ABI parameter registers (in order)
fn param_reg(index: i64) -> i64 {
    if index == 0 { reg_rdi() }
    else if index == 1 { reg_rsi() }
    else if index == 2 { reg_rdx() }
    else if index == 3 { reg_rcx() }
    else if index == 4 { reg_r8() }
    else if index == 5 { reg_r9() }
    else { -1 }  // Stack args not yet supported
}

// Return value register
fn return_reg() -> i64 {
    reg_rax()
}

// Caller-saved registers (can be clobbered by function calls)
fn is_caller_saved(reg: i64) -> i64 {
    if reg == reg_rax() { 1 }
    else if reg == reg_rcx() { 1 }
    else if reg == reg_rdx() { 1 }
    else if reg == reg_rsi() { 1 }
    else if reg == reg_rdi() { 1 }
    else if reg == reg_r8() { 1 }
    else if reg == reg_r9() { 1 }
    else if reg == reg_r10() { 1 }
    else if reg == reg_r11() { 1 }
    else { 0 }
}

// Callee-saved registers (must be preserved across calls)
fn is_callee_saved(reg: i64) -> i64 {
    if reg == reg_rbx() { 1 }
    else if reg == reg_r12() { 1 }
    else if reg == reg_r13() { 1 }
    else if reg == reg_r14() { 1 }
    else if reg == reg_r15() { 1 }
    else { 0 }
}

// SIMD register accessors (ZMM0–31 / YMM0–15 / XMM0–15 / opmask k0–k7)
// ZMM, YMM and XMM share the same 5-bit hardware encoding (0–31);
// the register width is encoded in the EVEX L'L field, not the register number.
fn reg_zmm(n: i64) -> i64 { n }
fn reg_ymm(n: i64) -> i64 { n }
fn reg_xmm(n: i64) -> i64 { n }
fn reg_opmask(n: i64) -> i64 { n }  // k0–k7 (opmask registers for predicated ops)

// Simple register allocator: map HIR values to x86-64 registers
// For bootstrap, use a fixed mapping (no spilling)
struct RegAlloc {
    next_reg: i64,        // Next available register
}

fn reg_alloc_new() -> RegAlloc {
    RegAlloc { next_reg: 0 }
}

fn alloc_reg(allocator: RegAlloc) -> RegAlloc with Mut, Panic {
    var a = allocator
    // Skip rsp (4) and rbp (5) - they're reserved for stack
    if a.next_reg == 4 {
        a.next_reg = 6
    }

    let allocated = a.next_reg
    a.next_reg = a.next_reg + 1

    if a.next_reg >= 16 {
        // Out of registers - would need spilling
        // For bootstrap, just wrap around (unsafe but simple)
        a.next_reg = 0
    }
    a
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/native/encode.sio  (2009 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::native::encode — Minimal x86-64 instruction encoder (skeleton)
//
// This module builds up a raw .text byte buffer. The Rust-side NativeEmitter
// (ELF/Mach-O) will wrap these bytes into an executable later.


struct CodeBuffer {
    bytes: [i8; 65536],
    len: i64,
}

fn code_buffer_new() -> CodeBuffer {
    CodeBuffer { bytes: [0; 65536], len: 0 }
}

fn low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}


// Wide variant for large modules (256KB capacity)
struct WideCodeBuffer {
    bytes: [i8; 262144],
    len: i64,
}

fn wide_code_buffer_new() -> WideCodeBuffer with Mut {
    WideCodeBuffer { bytes: [0; 262144], len: 0 }
}

fn wide_emit_byte(buf: WideCodeBuffer, b: i64) -> WideCodeBuffer with Mut, Panic {
    var out = buf
    if out.len < 262144 {
        out.bytes[out.len as usize] = b as i8
        out.len = out.len + 1
    }
    out
}

fn wide_copy_from_code_buffer(dst: WideCodeBuffer, src: CodeBuffer) -> WideCodeBuffer with Mut, Panic, Div {
    var out = dst
    var i: i64 = 0
    while i < src.len && out.len < 262144 {
        out.bytes[out.len as usize] = src.bytes[i as usize]
        out.len = out.len + 1
        i = i + 1
    }
    out
}

fn emit_byte(buf: CodeBuffer, b: i64) -> CodeBuffer with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 65536 {
            out.bytes[out.len as usize] = low8(b) as i8
            out.len = out.len + 1
        }
    }
    out
}

fn emit_byte_mut(buf: &! CodeBuffer, b: i64) with Mut, Panic, Div {
    if (*buf).len >= 0 {
        if (*buf).len < 65536 {
            (*buf).bytes[(*buf).len as usize] = low8(b) as i8
            (*buf).len = (*buf).len + 1
        }
    }
}

fn emit_u32_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, low8(val))
    b = emit_byte(b, low8(val >> 8))
    b = emit_byte(b, low8(val >> 16))
    b = emit_byte(b, low8(val >> 24))
    b
}

fn emit_u32_le_mut(buf: &! CodeBuffer, val: i64) with Mut, Panic, Div {
    emit_byte_mut(buf, low8(val))
    emit_byte_mut(buf, low8(val >> 8))
    emit_byte_mut(buf, low8(val >> 16))
    emit_byte_mut(buf, low8(val >> 24))
}

fn emit_u64_le(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // Write as 2x u32 to avoid depending on bitwise ops.
    var b = buf
    b = emit_u32_le(b, val)
    b = emit_u32_le(b, val >> 32)
    b
}

fn emit_u64_le_mut(buf: &! CodeBuffer, val: i64) with Mut, Panic, Div {
    emit_u32_le_mut(buf, val)
    emit_u32_le_mut(buf, val >> 32)
}

fn modrm_rr(dst: i64, src: i64) -> i64 {
    // Register-direct ModRM: 11 rrr bbb
    // where rrr = src, bbb = dst.
    192 + src * 8 + dst
}

fn modrm_rm_imm(dst: i64) -> i64 {
    // mov r/m64, imm32 uses /0, so ModRM is 11 000 bbb.
    192 + dst
}

// ============================================================================
// x86-64 instruction snippets (not exhaustive)
// ============================================================================

fn emit_mov_rax_imm(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var result = emit_mov_reg_imm(buf, 0, val)
    result
}

fn emit_mov_rdi_imm(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    var result = emit_mov_reg_imm(buf, 7, val)
    result
}

fn emit_mov_reg_imm32(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 c7 /0 <imm32>  — mov r/m64, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xc7)
    b = emit_byte(b, modrm_rm_imm(reg))
    b = emit_u32_le(b, val)
    b
}

fn emit_mov_reg_imm64(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 b8+rd <imm64>  — mov r64, imm64
    // Note: only supports registers 0..7 (no REX.B extension).
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xb8 + reg)
    b = emit_u64_le(b, val)
    b
}

fn emit_mov_reg_imm(buf: CodeBuffer, reg: i64, val: i64) -> CodeBuffer with Mut, Panic, Div {
    if val >= -2147483648 && val <= 2147483647 {
        var r32 = emit_mov_reg_imm32(buf, reg, val)
        r32
    } else {
        var r64 = emit_mov_reg_imm64(buf, reg, val)
        r64
    }
}

fn emit_mov_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 /r — mov r/m64, r64  (dst <- src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_add_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 01 /r — add r/m64, r64  (dst += src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x01)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_sub_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 29 /r — sub r/m64, r64  (dst -= src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x29)
    b = emit_byte(b, modrm_rr(dst, src))
    b
}

fn emit_imul_reg_reg(buf: CodeBuffer, dst: i64, src: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f af /r — imul r64, r/m64 (dst *= src)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xaf)
    // For imul, dst is encoded in the ModRM 'reg' field.
    b = emit_byte(b, 192 + dst * 8 + src)
    b
}

fn emit_syscall(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x05)
    b
}

fn emit_ret(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0xc3)
    b
}

fn emit_exit(buf: CodeBuffer, code: i64) -> CodeBuffer with Mut, Panic, Div {
    // sys_exit(code)
    var b = buf
    b = emit_mov_rax_imm(b, 60)
    b = emit_mov_rdi_imm(b, code)
    b = emit_syscall(b)
    b
}

// emit_write_stdout removed: the codegen pipeline uses lower_load_string
// (RIP-relative LEA + relocation) + emit_builtin_print_str instead.

// ============================================================================
// Stack frame management instructions (Phase 1)
// ============================================================================

fn emit_push_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x55)  // push rbp
    b
}

fn emit_pop_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5d)  // pop rbp
}

fn emit_mov_rbp_rsp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 e5 — mov rbp, rsp
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xe5)
    b
}

fn emit_mov_rsp_rbp(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 ec — mov rsp, rbp
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0xec)
    b
}

fn emit_sub_rsp_imm32(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 81 ec <imm32> — sub rsp, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xec)
    b = emit_u32_le(b, val)
    b
}

fn emit_add_rsp_imm32(buf: CodeBuffer, val: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 81 c4 <imm32> — add rsp, imm32
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x81)
    b = emit_byte(b, 0xc4)
    b = emit_u32_le(b, val)
    b
}

// ============================================================================
// Phase 1: Evaluation stack, jumps, comparisons, memory (disp32)
// ============================================================================

// --- Push / Pop for expression evaluation ---

fn emit_push_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x50)
}

fn emit_pop_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5b)
}

fn emit_pop_rdi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5f)
}

fn emit_pop_rsi(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5e)
}

fn emit_pop_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x5a)
}

fn emit_pop_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    emit_byte(buf, 0x59)
}

fn emit_pop_r8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x58)
    b
}

fn emit_pop_r9(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x41)
    b = emit_byte(b, 0x59)
    b
}

// Pop to System V ABI argument register by index (0=rdi, 1=rsi, ...)
fn emit_pop_arg_reg(buf: CodeBuffer, index: i64) -> CodeBuffer with Mut, Panic, Div {
    if index == 0 { emit_pop_rdi(buf) }
    else if index == 1 { emit_pop_rsi(buf) }
    else if index == 2 { emit_pop_rdx(buf) }
    else if index == 3 { emit_pop_rcx(buf) }
    else if index == 4 { emit_pop_r8(buf) }
    else if index == 5 { emit_pop_r9(buf) }
    else { buf }
}

// --- Stack alignment helpers (for call ABI) ---

fn emit_sub_rsp_8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 ec 08 — sub rsp, 8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xec)
    b = emit_byte(b, 0x08)
    b
}

fn emit_add_rsp_8(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 83 c4 08 — add rsp, 8
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x83)
    b = emit_byte(b, 0xc4)
    b = emit_byte(b, 0x08)
    b
}

// --- Unconditional / Conditional jumps (rel32 placeholder) ---

fn emit_jmp_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // e9 <rel32> — jmp rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0xe9)
    b = emit_u32_le(b, 0)
    b
}

fn emit_jz_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 84 <rel32> — jz rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x84)
    b = emit_u32_le(b, 0)
    b
}

fn emit_jnz_rel32(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 85 <rel32> — jnz rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, 0)
    b
}

// --- Test, Compare, Setcc ---

fn emit_test_rax_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 85 c0 — test rax, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x85)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_cmp_rbx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 39 c3 — cmp rbx, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x39)
    b = emit_byte(b, 0xc3)
    b
}

fn emit_sete_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x94)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setne_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x95)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setl_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9c)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setle_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9e)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setg_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9f)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_setge_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x9d)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_movzx_rax_al(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 0f b6 c0 — movzx rax, al
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0xb6)
    b = emit_byte(b, 0xc0)
    b
}

// --- Arithmetic helpers ---

fn emit_xor_rax_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 31 c0 — xor rax, rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x31)
    b = emit_byte(b, 0xc0)
    b
}

fn emit_neg_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 d8 — neg rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xd8)
    b
}

fn emit_not_bool_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // test rax, rax; sete al; movzx rax, al
    var b = buf
    b = emit_test_rax_rax(b)
    b = emit_sete_al(b)
    b = emit_movzx_rax_al(b)
    b
}

// --- Division support ---

fn emit_cqo(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 99 — cqo (sign-extend rax into rdx:rax)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x99)
    b
}

fn emit_idiv_rcx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 48 f7 f9 — idiv rcx
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0xf7)
    b = emit_byte(b, 0xf9)
    b
}

// --- disp32 memory operations (stack locals) ---

fn emit_store_rax_rbp_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 85 <disp32> — mov [rbp + disp32], rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, disp)
    b
}

fn emit_load_rbp_disp32_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 85 <disp32> — mov rax, [rbp + disp32]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8b)
    b = emit_byte(b, 0x85)
    b = emit_u32_le(b, disp)
    b
}

fn emit_store_reg_rbp_disp32(buf: CodeBuffer, disp: i64, reg: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 <85+reg*8> <disp32> — mov [rbp + disp32], reg
    // Only works for registers 0..7 (no REX.B)
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x85 + reg * 8)
    b = emit_u32_le(b, disp)
    b
}

// --- Call and trap ---

fn emit_call_rel32_placeholder(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // e8 <rel32> — call rel32 (placeholder 0)
    var b = buf
    b = emit_byte(b, 0xe8)
    b = emit_u32_le(b, 0)
    b
}

fn emit_call_mem_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // ff 15 <disp32> — call qword [rip+disp32] (indirect call through RIP-relative memory)
    // Used for Windows IAT calls (ExitProcess, VirtualAlloc via import address table)
    var b = buf
    b = emit_byte(b, 0xff)
    b = emit_byte(b, 0x15)
    b = emit_u32_le(b, disp)
    b
}

fn emit_ud2(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // 0f 0b — ud2 (undefined instruction trap)
    var b = buf
    b = emit_byte(b, 0x0f)
    b = emit_byte(b, 0x0b)
    b
}

// --- Convenience register moves ---

fn emit_mov_rdi_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rdi, rax
    emit_mov_reg_reg(buf, 7, 0)
}

fn emit_mov_rcx_rax(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rcx, rax
    emit_mov_reg_reg(buf, 1, 0)
}

fn emit_mov_rax_rbx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rax, rbx
    emit_mov_reg_reg(buf, 0, 3)
}

fn emit_mov_rax_rdx(buf: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    // mov rax, rdx
    emit_mov_reg_reg(buf, 0, 2)
}

// LEA rax, [rip + disp32] — load effective address (for string literals)
fn emit_lea_rax_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8d 05 <disp32> — lea rax, [rip + disp32]
    var b = buf
    b = emit_byte(b, 0x48)        // REX.W
    b = emit_byte(b, 0x8d)        // lea r64, m
    b = emit_byte(b, 0x05)        // ModRM: [rip + disp32], rax
    b = emit_u32_le(b, disp)
    b
}

// MOV rax, [rip + disp32] — load qword from RIP-relative address (for .data counters)
fn emit_mov_rax_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 05 <disp32> — mov rax, [rip + disp32]
    var b = buf
    b = emit_byte(b, 0x48)        // REX.W
    b = emit_byte(b, 0x8B)        // MOV r64, r/m64
    b = emit_byte(b, 0x05)        // ModRM: [rip + disp32], rax
    b = emit_u32_le(b, disp)
    b
}

// MOV rbx, [rip + disp32] — load qword from RIP-relative address
fn emit_mov_rbx_rip_disp32(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 8b 1d <disp32> — mov rbx, [rip + disp32]
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x8B)
    b = emit_byte(b, 0x1D)
    b = emit_u32_le(b, disp)
    b
}

// MOV [rip + disp32], rax — store qword to RIP-relative address
fn emit_mov_rip_disp32_rax(buf: CodeBuffer, disp: i64) -> CodeBuffer with Mut, Panic, Div {
    // 48 89 05 <disp32> — mov [rip + disp32], rax
    var b = buf
    b = emit_byte(b, 0x48)
    b = emit_byte(b, 0x89)
    b = emit_byte(b, 0x05)
    b = emit_u32_le(b, disp)
    b
}

