fn test_avec_instr_scalar_cost_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let add_cost = avec_instr_scalar_cost(AVEC_OP_BINOP)
    if add_cost != AVEC_COST_SCALAR_ADD { return false }
    let nop_cost = avec_instr_scalar_cost(AVEC_OP_NOP)
    if nop_cost != 0 { return false }
    let label_cost = avec_instr_scalar_cost(AVEC_OP_LABEL)
    if label_cost != 0 { return false }
    true
}

