// ============================================================================
// Section 34: Tests — async_is_await_instr
// ============================================================================

fn test_async_is_await_for_sentinel() -> i64 with Mut, Panic, Div {
    var instr = ir_instr_new(IrOpcode::IrCall)
    instr.fn_id = ASYNC_AWAIT_SENTINEL
    if !async_is_await_instr(instr) { return 1 }

    var nop = ir_nop()
    if async_is_await_instr(nop) { return 2 }

    var regular_call = ir_instr_new(IrOpcode::IrCall)
    regular_call.fn_id = 42
    if async_is_await_instr(regular_call) { return 3 }
    0
}

// ============================================================================
// Section 35: Tests — live var across three suspends
// ============================================================================

fn test_async_liveness_three_suspends() -> i64 with Mut, Panic, Div {
    let func = async_make_three_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)
    sm = async_analyze_liveness(func, sm)
    sm = async_collect_captures(sm)

    // r0 is used at indices 4, 7, 9 (after all three suspends at 2, 5, 8)
    // r1 is used at indices 3, 6 (after suspends at 2, 5, but not after 8)
    // Both r0 and r1 should be captured.
    if !async_is_captured(sm, 0) { return 1 }
    if !async_is_captured(sm, 1) { return 2 }
    // Captures should be deduplicated
    if sm.capture_count < 2 { return 3 }
    0
}

// ============================================================================
// Section 36: Test runner
// ============================================================================

fn async_lower_run_tests() -> i64 with Mut, Panic, Div {
    var fail: i64 = 0

    let t01 = test_async_no_awaits()
    if t01 != 0 { print_int(5001) fail = fail + 1 }

    let t02 = test_async_single_await_detection()
    if t02 != 0 { print_int(5002) fail = fail + 1 }

    let t03 = test_async_multiple_await_detection()
    if t03 != 0 { print_int(5003) fail = fail + 1 }

    let t04 = test_async_three_await_detection()
    if t04 != 0 { print_int(5004) fail = fail + 1 }

    let t05 = test_async_suspend_point_fields()
    if t05 != 0 { print_int(5005) fail = fail + 1 }

    let t06 = test_async_two_suspend_points()
    if t06 != 0 { print_int(5006) fail = fail + 1 }

    let t07 = test_async_var_set_basic()
    if t07 != 0 { print_int(5007) fail = fail + 1 }

    let t08 = test_async_var_set_remove()
    if t08 != 0 { print_int(5008) fail = fail + 1 }

    let t09 = test_async_var_set_union()
    if t09 != 0 { print_int(5009) fail = fail + 1 }

    let t10 = test_async_var_set_intersect()
    if t10 != 0 { print_int(5010) fail = fail + 1 }

    let t11 = test_async_live_across_single()
    if t11 != 0 { print_int(5011) fail = fail + 1 }

    let t12 = test_async_live_across_two_suspends()
    if t12 != 0 { print_int(5012) fail = fail + 1 }

    let t13 = test_async_split_no_suspend()
    if t13 != 0 { print_int(5013) fail = fail + 1 }

    let t14 = test_async_split_single_suspend()
    if t14 != 0 { print_int(5014) fail = fail + 1 }

    let t15 = test_async_split_two_suspends()
    if t15 != 0 { print_int(5015) fail = fail + 1 }

    let t16 = test_async_split_three_suspends()
    if t16 != 0 { print_int(5016) fail = fail + 1 }

    let t17 = test_async_split_state_ids_sequential()
    if t17 != 0 { print_int(5017) fail = fail + 1 }

    let t18 = test_async_split_suspend_before_after()
    if t18 != 0 { print_int(5018) fail = fail + 1 }

    let t19 = test_async_future_field_count_no_captures()
    if t19 != 0 { print_int(5019) fail = fail + 1 }

    let t20 = test_async_future_field_count_with_captures()
    if t20 != 0 { print_int(5020) fail = fail + 1 }

    let t21 = test_async_state_tag_field_is_zero()
    if t21 != 0 { print_int(5021) fail = fail + 1 }

    let t22 = test_async_capture_field_indices()
    if t22 != 0 { print_int(5022) fail = fail + 1 }

    let t23 = test_async_result_field_index()
    if t23 != 0 { print_int(5023) fail = fail + 1 }

