    As,
    Where,
    Pub,
    SelfLower,
    SelfUpper,
    True,
    False,
    Is,
    Unsafe,
    Extern,
    Static,

    // --- Keywords: Units ---
    Unit,

    // --- Keywords: Effects and linear types ---
    Effect,
    Handler,
    Handle,
    With,
    Perform,
    Resume,
    Linear,
    Affine,
    Move,
    Copy,
    Drop,
    Ref,
    Dyn,
    Box,

    // --- Keywords: Async/GPU ---
    Async,
    Await,
    Spawn,
    Kernel,

    // --- Keywords: Epistemic/probabilistic ---
    Uncertain,
    Belief,
    Evidence,
    Confidence,
    Prior,
    Posterior,
    Likelihood,
    Entropy,
    Observe,
    Sample,
    Infer,
    Knowledge,
    Model,
    Policy,
    AcquisitionPolicy,
    AcquisitionPlan,
    RecoursePolicy,
    RecoursePlan,
    TransitionPolicy,
    TransitionPlan,
    MonitoringPolicy,
    ObservedTransition,
    RollbackCertificate,
    AlternativePolicy,
    AlternativeSet,
    AlternativeOption,
    DecisionPolicy,
    DeferralPolicy,
    PolicyLower,
    AcquisitionPolicyLower,
    RecoursePolicyLower,
    TransitionPolicyLower,
    TransitionProtocolLower,
    MonitoringPolicyLower,
    AlternativePolicyLower,
    AlternativeFrontierLower,
    DecisionPolicyLower,
    DeferralPolicyLower,
    ModelsLower,
    ValidationLower,
    AuditLower,
    Require,
    Objective,
    Strategy,
    Step,
    Level,
    Scope,
    Contest,
    Robust,
