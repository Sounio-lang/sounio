    if test_lopt_trip_count_zero_step() == 0 { passed = passed + 1 }
    if test_lopt_classify_counted() == 0 { passed = passed + 1 }
    if test_lopt_classify_while() == 0 { passed = passed + 1 }
    if test_lopt_deps_no_memory() == 0 { passed = passed + 1 }
    if test_lopt_deps_with_memory() == 0 { passed = passed + 1 }
    if test_lopt_find_invariants() == 0 { passed = passed + 1 }
    if test_lopt_invariant_hoistable() == 0 { passed = passed + 1 }
    if test_lopt_licm_pass() == 0 { passed = passed + 1 }
    if test_lopt_side_effect_not_invariant() == 0 { passed = passed + 1 }
    if test_lopt_can_unroll() == 0 { passed = passed + 1 }
    if test_lopt_cannot_unroll_with_call() == 0 { passed = passed + 1 }
    if test_lopt_unroll_factor() == 0 { passed = passed + 1 }
    if test_lopt_unroll_info() == 0 { passed = passed + 1 }
    if test_lopt_full_unroll() == 0 { passed = passed + 1 }
    if test_lopt_full_unroll_too_large() == 0 { passed = passed + 1 }
    if test_lopt_strength_reduction() == 0 { passed = passed + 1 }
    if test_lopt_eliminate_iv() == 0 { passed = passed + 1 }
    if test_lopt_cannot_fuse_diff_trips() == 0 { passed = passed + 1 }
    if test_lopt_cannot_fuse_self() == 0 { passed = passed + 1 }
    if test_lopt_distribute_too_small() == 0 { passed = passed + 1 }
    if test_lopt_vect_non_counted() == 0 { passed = passed + 1 }
