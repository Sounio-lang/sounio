// ============================================================================
// Full module assembly helper: build a complete WASM module from
// high-level descriptions using the encode functions above
// ============================================================================

fn wasm_emit_full_module_with_bodies(
    types: WasmTypeSection,
    funcs: WasmFuncSection,
    min_pages: i64,
    max_pages: i64,
    exports: WasmExportSection,
    code: WasmCodeSection
) -> WasmBuf with Mut, Panic, Div {
    // Delegate to core.sio's full module emitter with empty imports/globals/data.
    wasm_emit_full_module(
        types,
        wasm_import_section_new(),
        funcs,
        wasm_global_section_new(),
        min_pages,
        max_pages,
        exports,
        code,
        wasm_data_section_new()
    )
}

// ============================================================================
// Convenience: build a simple add function module (for testing)
// ============================================================================

fn wasm_build_i32_add_module() -> WasmBuf with Mut, Panic, Div {
    // Type: (i32, i32) -> i32
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)

    var es = wasm_export_section_new()
    es = wasm_export_section_add(es, wasm_export_func("add", 0))

    // Build function body using emitters
    var body = wasm_body_new()
    body = wasm_body_emit_local_get(body, 0)
    body = wasm_body_emit_local_get(body, 1)
    body = wasm_body_emit_i32_add(body)
    body = wasm_body_emit_end(body)

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    wasm_emit_full_module(
        ts,
        wasm_import_section_new(),
        fs,
        wasm_global_section_new(),
        0,
        0,
        es,
        cs,
        wasm_data_section_new()
    )
}

// ============================================================================
// Convenience: build a factorial function module (iterative, for testing)
// ============================================================================

fn wasm_build_factorial_module() -> WasmBuf with Mut, Panic, Div {
    // Type: (i32) -> i32
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)

    var es = wasm_export_section_new()
    es = wasm_export_section_add(es, wasm_export_func("factorial", 0))

    // Build iterative factorial:
    // local $result i32
    // $result = 1
    // block $exit
    //   loop $loop
    //     br_if $exit (i32.le_s local.get 0, 1)
    //     $result = $result * $n
    //     $n = $n - 1
    //     br $loop
    //   end
    // end
    // local.get $result
    var body = wasm_body_new()
    body = wasm_body_add_local(body, 1, WASM_TYPE_I32)  // local 1 = result

    // result = 1
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_local_set(body, 1)

    // block $exit (void)
    body = wasm_body_emit_block(body, WASM_BLOCK_VOID)

    // loop $loop (void)
    body = wasm_body_emit_loop(body, WASM_BLOCK_VOID)

    // if n <= 1, break
    body = wasm_body_emit_local_get(body, 0)    // n
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_i32_le_s(body)
    body = wasm_body_emit_br_if(body, 1)        // break to $exit

    // result = result * n
    body = wasm_body_emit_local_get(body, 1)    // result
    body = wasm_body_emit_local_get(body, 0)    // n
    body = wasm_body_emit_i32_mul(body)
    body = wasm_body_emit_local_set(body, 1)    // result = result * n

    // n = n - 1
    body = wasm_body_emit_local_get(body, 0)    // n
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_i32_sub(body)
    body = wasm_body_emit_local_set(body, 0)    // n = n - 1

    // br $loop
    body = wasm_body_emit_br(body, 0)

    // end loop
    body = wasm_body_emit_end(body)
    // end block
    body = wasm_body_emit_end(body)

    // return result
    body = wasm_body_emit_local_get(body, 1)
    body = wasm_body_emit_end(body)

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    wasm_emit_full_module(
        ts,
        wasm_import_section_new(),
        fs,
        wasm_global_section_new(),
        0,
        0,
        es,
        cs,
        wasm_data_section_new()
    )
}

// ============================================================================
// Inline tests
// ============================================================================

fn wasm_body_byte_at(body: WasmFuncBody, idx: i64) -> i64 with Mut, Panic {
    if idx < 0 { return 0 }
    if idx >= body.code_len { return 0 }
    let raw = body.code[idx as usize] as i64
    if raw < 0 { return raw + 256 }
    raw
}

fn test_wasm_body_local_get() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_local_get(body, 3)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x20
        && wasm_body_byte_at(body, 1) == 3
}

fn test_wasm_body_i32_const() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_i32_const(body, 42)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x41
        && wasm_body_byte_at(body, 1) == 42
}

fn test_wasm_body_i32_const_negative() -> bool with Mut, Panic, Div {
    // i32.const -1 => 0x41 0x7F (signed LEB128)
    var body = wasm_body_new()
    body = wasm_body_emit_i32_const(body, 0 - 1)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x41
        && wasm_body_byte_at(body, 1) == 0x7F
}

fn test_wasm_body_add_sequence() -> bool with Mut, Panic, Div {
    // local.get 0, local.get 1, i32.add, end
    var body = wasm_body_new()
    body = wasm_body_emit_local_get(body, 0)
    body = wasm_body_emit_local_get(body, 1)
    body = wasm_body_emit_i32_add(body)
    body = wasm_body_emit_end(body)

    body.code_len == 6
        && wasm_body_byte_at(body, 0) == 0x20   // local.get
        && wasm_body_byte_at(body, 1) == 0x00   // 0
        && wasm_body_byte_at(body, 2) == 0x20   // local.get
        && wasm_body_byte_at(body, 3) == 0x01   // 1
        && wasm_body_byte_at(body, 4) == 0x6A   // i32.add
        && wasm_body_byte_at(body, 5) == 0x0B   // end
}

fn test_wasm_body_call() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_call(body, 5)
    body.code_len == 2
        && wasm_body_byte_at(body, 0) == 0x10
        && wasm_body_byte_at(body, 1) == 5
}

fn test_wasm_body_block_loop() -> bool with Mut, Panic, Div {
    // block(void), loop(void), br_if 1, br 0, end, end
    var body = wasm_body_new()
    body = wasm_body_emit_block(body, WASM_BLOCK_VOID)
    body = wasm_body_emit_loop(body, WASM_BLOCK_VOID)
    body = wasm_body_emit_br_if(body, 1)
    body = wasm_body_emit_br(body, 0)
    body = wasm_body_emit_end(body)
    body = wasm_body_emit_end(body)

    body.code_len == 10
        && wasm_body_byte_at(body, 0) == 0x02   // block
        && wasm_body_byte_at(body, 1) == 0x40   // void
        && wasm_body_byte_at(body, 2) == 0x03   // loop
        && wasm_body_byte_at(body, 3) == 0x40   // void
        && wasm_body_byte_at(body, 4) == 0x0D   // br_if
        && wasm_body_byte_at(body, 5) == 0x01   // label 1
        && wasm_body_byte_at(body, 6) == 0x0C   // br
        && wasm_body_byte_at(body, 7) == 0x00   // label 0
        && wasm_body_byte_at(body, 8) == 0x0B   // end
        && wasm_body_byte_at(body, 9) == 0x0B   // end
}

fn test_wasm_body_i32_load_store() -> bool with Mut, Panic, Div {
    // i32.load align=2 offset=0, i32.store align=2 offset=4
    var body = wasm_body_new()
    body = wasm_body_emit_i32_load(body, 2, 0)
    body = wasm_body_emit_i32_store(body, 2, 4)

    body.code_len == 6
        && wasm_body_byte_at(body, 0) == 0x28   // i32.load
        && wasm_body_byte_at(body, 1) == 2      // align
        && wasm_body_byte_at(body, 2) == 0      // offset
        && wasm_body_byte_at(body, 3) == 0x36   // i32.store
        && wasm_body_byte_at(body, 4) == 2      // align
        && wasm_body_byte_at(body, 5) == 4      // offset
}

fn test_wasm_body_conversions() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_i32_wrap_i64(body)
    body = wasm_body_emit_i64_extend_i32_s(body)
    body = wasm_body_emit_f64_convert_i64_s(body)
    body = wasm_body_emit_i64_trunc_f64_s(body)

    body.code_len == 4
        && wasm_body_byte_at(body, 0) == 0xA7   // i32.wrap_i64
        && wasm_body_byte_at(body, 1) == 0xAC   // i64.extend_i32_s
        && wasm_body_byte_at(body, 2) == 0xB9   // f64.convert_i64_s
        && wasm_body_byte_at(body, 3) == 0xB0   // i64.trunc_f64_s
}

fn test_wasm_body_if_else() -> bool with Mut, Panic, Div {
    // if(i32), i32.const 1, else, i32.const 0, end
    var body = wasm_body_new()
    body = wasm_body_emit_if(body, WASM_TYPE_I32)
    body = wasm_body_emit_i32_const(body, 1)
    body = wasm_body_emit_else(body)
    body = wasm_body_emit_i32_const(body, 0)
    body = wasm_body_emit_end(body)

    body.code_len == 7
        && wasm_body_byte_at(body, 0) == 0x04   // if
        && wasm_body_byte_at(body, 1) == 0x7F   // i32 result type
        && wasm_body_byte_at(body, 2) == 0x41   // i32.const
        && wasm_body_byte_at(body, 3) == 1      // 1
        && wasm_body_byte_at(body, 4) == 0x05   // else
        && wasm_body_byte_at(body, 5) == 0x41   // i32.const
        && wasm_body_byte_at(body, 6) == 0      // 0 — end omitted for brevity, it's the next byte
}

fn test_wasm_body_add_local() -> bool with Mut, Panic {
    var body = wasm_body_new()
    body = wasm_body_add_local(body, 3, WASM_TYPE_I32)
    body = wasm_body_add_local(body, 1, WASM_TYPE_F64)

    body.local_count == 2
        && body.locals[0 as usize].count == 3
        && body.locals[0 as usize].val_type == WASM_TYPE_I32
        && body.locals[1 as usize].count == 1
        && body.locals[1 as usize].val_type == WASM_TYPE_F64
}

fn test_wasm_build_add_module() -> bool with Mut, Panic, Div {
    // Build the add module and verify the magic header
    let module = wasm_build_i32_add_module()
    module.len > 8
        && wasm_buf_byte_at(module, 0) == 0x00
        && wasm_buf_byte_at(module, 1) == 0x61
        && wasm_buf_byte_at(module, 2) == 0x73
        && wasm_buf_byte_at(module, 3) == 0x6D
        && wasm_buf_byte_at(module, 4) == 0x01
}

fn test_wasm_body_i64_const() -> bool with Mut, Panic, Div {
    // i64.const 256 => 0x42 0x80 0x02
    var body = wasm_body_new()
    body = wasm_body_emit_i64_const(body, 256)
    body.code_len == 3
        && wasm_body_byte_at(body, 0) == 0x42   // i64.const
        && wasm_body_byte_at(body, 1) == 0x80   // 256 LEB128 byte 0
        && wasm_body_byte_at(body, 2) == 0x02   // 256 LEB128 byte 1
}

fn test_wasm_body_comparison_ops() -> bool with Mut, Panic, Div {
    var body = wasm_body_new()
    body = wasm_body_emit_i32_eqz(body)
    body = wasm_body_emit_i32_eq(body)
    body = wasm_body_emit_i32_ne(body)
    body = wasm_body_emit_i32_lt_s(body)
    body = wasm_body_emit_i32_gt_s(body)
    body = wasm_body_emit_i32_le_s(body)
    body = wasm_body_emit_i32_ge_s(body)

    body.code_len == 7
        && wasm_body_byte_at(body, 0) == 0x45
        && wasm_body_byte_at(body, 1) == 0x46
        && wasm_body_byte_at(body, 2) == 0x47
        && wasm_body_byte_at(body, 3) == 0x48
        && wasm_body_byte_at(body, 4) == 0x4A
        && wasm_body_byte_at(body, 5) == 0x4C
        && wasm_body_byte_at(body, 6) == 0x4E
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/wasm/lower.sio  (1916 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::wasm::lower — IR-to-WASM lowering pass
//
// Translates IrModule (from ir/ir.sio) into WASM bytecode using the emitters
// from wasm/encode.sio and the module structures from wasm/mod.sio.
//
// Strategy: register-based IR is lowered to WASM's stack machine by mapping
// each IR register to a WASM local variable.  Each IR instruction becomes a
// sequence: push operands via local.get, execute the operation, store result
// via local.set.  Structured control flow (block/loop) is reconstructed from
// the flat IR label/branch model using a label stack.
//
// Capacities:
//   512 locals per function  (IR registers -> WASM locals)
//   256 functions per module (IR functions -> WASM function indices)
//    64 label stack depth    (nested block/loop scope)


// ============================================================================
// Constants
// ============================================================================

let WASM_LOWER_MAX_LOCALS: i64 = 512
let WASM_LOWER_MAX_FUNCS: i64 = 256
let WASM_LOWER_MAX_LABELS: i64 = 64

// Label kinds for the structured control flow stack
let WASM_LABEL_BLOCK: i64 = 0
let WASM_LABEL_LOOP: i64 = 1

// ============================================================================
// WasmLabelEntry — one entry on the structured control flow label stack
// ============================================================================

struct WasmLabelEntry {
    ir_label_id: i64,
    kind: i64,
}

fn wasm_label_entry_new(ir_label: i64, kind: i64) -> WasmLabelEntry {
    WasmLabelEntry { ir_label_id: ir_label, kind: kind }
}

fn wasm_label_entry_empty() -> WasmLabelEntry {
    WasmLabelEntry { ir_label_id: 0 - 1, kind: WASM_LABEL_BLOCK }
}

// ============================================================================
// WasmLowerCtx — lowering context for one module
// ============================================================================

struct WasmLowerCtx {
    body: WasmFuncBody,
    local_map: [i64; 512],      // ir_reg → wasm local index (-1 = unmapped)
    local_type: [i64; 512],     // wasm local index → WASM_TYPE_I64 or WASM_TYPE_F64
    loop_labels: [i64; 512],    // loop_labels[label_id] = 1 if backward-jump target
    loop_exit: [i64; 512],      // loop_exit[loop_lid] = exit_lid  (-1 = none found)
    is_loop_exit: [i64; 512],   // is_loop_exit[exit_lid] = loop_lid (-1 = not an exit)
    local_count: i64,
    func_map: [i64; 256],
    func_count: i64,
    label_stack: [WasmLabelEntry; 64],
    label_depth: i64,
    error_count: i64,
    string_offsets: [i64; 512], // string_idx → byte offset in data section (-1 = unmapped)
    heap_start: i64,            // first allocatable address (past string data, 8-aligned)
}

fn wasm_lower_ctx_new() -> WasmLowerCtx {
    WasmLowerCtx {
        body: wasm_body_new(),
        local_map: [0 - 1; 512],
        local_type: [WASM_TYPE_I64; 512],
        loop_labels: [0; 512],
        loop_exit: [0 - 1; 512],
        is_loop_exit: [0 - 1; 512],
        local_count: 0,
        func_map: [0 - 1; 256],
        func_count: 0,
        label_stack: [wasm_label_entry_empty(); 64],
        label_depth: 0,
        error_count: 0,
        string_offsets: [0 - 1; 512],
        heap_start: 8,
    }
}

fn wasm_lower_ctx_reset_body(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    out.body = wasm_body_new()
    out.local_count = 0
    out.label_depth = 0
    var i: i64 = 0
    while i < WASM_LOWER_MAX_LOCALS {
        out.local_map[i as usize] = 0 - 1
        out.local_type[i as usize] = WASM_TYPE_I64
        out.loop_labels[i as usize] = 0
        out.loop_exit[i as usize] = 0 - 1
        out.is_loop_exit[i as usize] = 0 - 1
        i = i + 1
    }
    out
}

// ============================================================================
// Local variable allocation
//
// Each IR register gets a dedicated WASM local.  Parameters occupy the first
// N locals (matching WASM's calling convention); additional registers are
// appended after.
// ============================================================================

fn wasm_lower_alloc_local(ctx: WasmLowerCtx, ir_reg: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        if out.local_map[ir_reg as usize] < 0 {
            out.local_map[ir_reg as usize] = out.local_count
            out.local_count = out.local_count + 1
        }
    }
    out
}

fn wasm_lower_get_local(ctx: WasmLowerCtx, ir_reg: i64) -> i64 with Mut, Panic {
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        ctx.local_map[ir_reg as usize]
    } else {
        0 - 1
    }
}

// Mark the WASM local that backs ir_reg as f64.
fn wasm_lower_mark_local_f64(ctx: WasmLowerCtx, ir_reg: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        let wasm_idx = out.local_map[ir_reg as usize]
        if wasm_idx >= 0 && wasm_idx < WASM_LOWER_MAX_LOCALS {
            out.local_type[wasm_idx as usize] = WASM_TYPE_F64
        }
    }
    out
}

// Returns true if the WASM local backing ir_reg is typed f64.
fn wasm_lower_is_float_reg(ctx: WasmLowerCtx, ir_reg: i64) -> bool with Mut, Panic {
    if ir_reg >= 0 && ir_reg < WASM_LOWER_MAX_LOCALS {
        let wasm_idx = ctx.local_map[ir_reg as usize]
        if wasm_idx >= 0 && wasm_idx < WASM_LOWER_MAX_LOCALS {
            return ctx.local_type[wasm_idx as usize] == WASM_TYPE_F64
        }
    }
    false
}

// ============================================================================
// Function table
// ============================================================================

fn wasm_lower_register_func(ctx: WasmLowerCtx, ir_fn_id: i64, wasm_idx: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if ir_fn_id >= 0 && ir_fn_id < WASM_LOWER_MAX_FUNCS {
        out.func_map[ir_fn_id as usize] = wasm_idx
        out.func_count = out.func_count + 1
    }
    out
}

fn wasm_lower_get_func(ctx: WasmLowerCtx, ir_fn_id: i64) -> i64 with Mut, Panic {
    if ir_fn_id >= 0 && ir_fn_id < WASM_LOWER_MAX_FUNCS {
        ctx.func_map[ir_fn_id as usize]
    } else {
        0 - 1
    }
}

// ============================================================================
// Label stack management
//
// IR uses flat labels + branches; WASM requires structured block/loop/end.
// The label stack tracks the nesting so that `br` depth can be computed
// relative to the current position.
// ============================================================================

fn wasm_lower_push_label(ctx: WasmLowerCtx, ir_label: i64, kind: i64) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if out.label_depth < WASM_LOWER_MAX_LABELS {
        out.label_stack[out.label_depth as usize] = wasm_label_entry_new(ir_label, kind)
        out.label_depth = out.label_depth + 1
    }
    out
}

fn wasm_lower_pop_label(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic {
    var out = ctx
    if out.label_depth > 0 {
        out.label_depth = out.label_depth - 1
    }
    out
}

// Find the WASM br depth for an IR label id.
// Scans from top of stack (most recent) outward.
// Returns the 0-based depth, or -1 if not found.
fn wasm_lower_find_label_depth(ctx: WasmLowerCtx, ir_label: i64) -> i64 with Mut, Panic, Div {
    var depth: i64 = 0
    var idx = ctx.label_depth - 1
    while idx >= 0 {
        if ctx.label_stack[idx as usize].ir_label_id == ir_label {
            return depth
        }
        depth = depth + 1
        idx = idx - 1
    }
    0 - 1
}

// ============================================================================
// Loop detection pre-pass
//
// WASM requires `loop` for back-edge targets and `block` for forward labels.
// We scan IrJump/IrBranchTrue/IrBranchFalse instructions; if the target label
// was defined at an earlier instruction index, it is a backward-jump target
// and needs a `loop` opener instead of `block`.
// ============================================================================

fn wasm_lower_detect_loops(ctx: WasmLowerCtx, func: IrFunction) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    // Reset all loop detection state
    var j: i64 = 0
    while j < WASM_LOWER_MAX_LOCALS {
        out.loop_labels[j as usize] = 0
        out.loop_exit[j as usize] = 0 - 1
        out.is_loop_exit[j as usize] = 0 - 1
        j = j + 1
    }

    // Pass 1: record the instruction index at which each label is defined.
    var label_pos: [i64; 512] = [0 - 1; 512]
    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        match instr.op {
            IrOpcode::IrLabel => {
                if instr.label_id >= 0 && instr.label_id < 512 {
                    label_pos[instr.label_id as usize] = i
                }
            }
            _ => {}
        }
        i = i + 1
    }

    // Pass 2: back-edge detection + loop exit label discovery.
    //
    // For each branch that targets a label defined BEFORE the branch (back-edge):
    //   - Mark the target as a loop label.
    //   - Scan the loop body [loop_start+1 .. back_edge-1] for branches that
    //     jump to a label defined AFTER the back-edge — those are loop exits.
    //   - Record the first such exit: loop_exit[loop_lid] = exit_lid,
    //     is_loop_exit[exit_lid] = loop_lid.
    //
    // This allows wasm_lower_label to emit:
    //     block $exit   ← findable by depth from inside the loop
    //       loop $loop
    //         ...
    //         br_if $exit  ← conditional exit (depth=1)
    //         br $loop     ← back-edge (depth=0)
    //       end
    //     end  ← emitted when IrLabel(exit_lid) is encountered
    i = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        let tgt = instr.label_id
        let is_branch = match instr.op {
            IrOpcode::IrJump        => true
            IrOpcode::IrBranchTrue  => true
            IrOpcode::IrBranchFalse => true
            _ => false
        }
        if is_branch && tgt >= 0 && tgt < 512 {
            let lpos = label_pos[tgt as usize]
            if lpos >= 0 && lpos < i {
                // Back-edge found: tgt is a loop label.
                out.loop_labels[tgt as usize] = 1
                // Scan loop body for the first forward exit (if not already found).
                if out.loop_exit[tgt as usize] < 0 {
                    var k: i64 = lpos + 1
                    while k < i {
                        let inner = func.instrs[k as usize]
                        let inner_branch = match inner.op {
                            IrOpcode::IrJump        => true
                            IrOpcode::IrBranchTrue  => true
                            IrOpcode::IrBranchFalse => true
                            _ => false
                        }
                        if inner_branch && inner.label_id >= 0 && inner.label_id < 512 {
                            let exit_pos = label_pos[inner.label_id as usize]
                            if exit_pos > i {
                                // This branch exits the loop (target is after back-edge).
                                out.loop_exit[tgt as usize] = inner.label_id
                                out.is_loop_exit[inner.label_id as usize] = tgt
                                k = i  // break inner loop (no `break` in Sounio)
                            }
                        }
                        k = k + 1
                    }
                }
            }
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Pre-scan: allocate WASM locals for all IR registers used in a function
// ============================================================================

fn wasm_lower_prescan_locals(ctx: WasmLowerCtx, func: IrFunction) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    // First, allocate params (they become WASM parameters, indices 0..param_count-1)
    var p: i64 = 0
    while p < func.param_count {
        let preg = func.param_regs[p as usize]
        if preg >= 0 && preg < WASM_LOWER_MAX_LOCALS {
            out.local_map[preg as usize] = p
        }
        p = p + 1
    }
    out.local_count = func.param_count

    // Then scan all instructions for dst/src registers and allocate locals.
    // IrLoadFloat dst registers are marked as f64 locals.
    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        if instr.dst >= 0 {
            out = wasm_lower_alloc_local(out, instr.dst)
        }
        if instr.src1 >= 0 {
            out = wasm_lower_alloc_local(out, instr.src1)
        }
        if instr.src2 >= 0 {
            out = wasm_lower_alloc_local(out, instr.src2)
        }
        // Mark float-producing destinations (forward propagation in def-order)
        match instr.op {
            IrOpcode::IrLoadFloat => {
                if instr.dst >= 0 {
                    out = wasm_lower_mark_local_f64(out, instr.dst)
                }
            }
            IrOpcode::IrBinOp => {
                // Arithmetic on f64 operands → f64 result.
                // Comparison ops (Eq/Ne/Lt/Le/Gt/Ge) → i64 boolean; no mark.
                if wasm_lower_is_float_reg(out, instr.src1) && wasm_lower_is_float_reg(out, instr.src2) {
                    match instr.bin_op {
                        BinaryOp::OpAdd => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        BinaryOp::OpSub => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        BinaryOp::OpMul => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        BinaryOp::OpDiv => { out = wasm_lower_mark_local_f64(out, instr.dst) }
                        _ => {}
                    }
                }
            }
            IrOpcode::IrCopy => {
                // Propagate f64 type through copies.
                if instr.dst >= 0 && wasm_lower_is_float_reg(out, instr.src1) {
                    out = wasm_lower_mark_local_f64(out, instr.dst)
                }
            }
            IrOpcode::IrUnaryOp => {
                // OpNeg on a f64 operand produces a f64 result.
                match instr.un_op {
                    UnaryOp::OpNeg => {
                        if instr.dst >= 0 && wasm_lower_is_float_reg(out, instr.src1) {
                            out = wasm_lower_mark_local_f64(out, instr.dst)
                        }
                    }
                    _ => {}
                }
            }
            IrOpcode::IrPhi => {
                // Allocate locals for phi incoming values (in call_args list).
                // The dst register is already allocated above; here we ensure
                // incoming value registers are allocated too.
                match instr.call_args {
                    Some(list) => {
                        let reg = (*list).head
                        if reg >= 0 {
                            out = wasm_lower_alloc_local(out, reg)
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Individual instruction lowering
// ============================================================================

// IrLoadImm -> i64.const val; local.set dst
fn wasm_lower_load_imm(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    out.body = wasm_body_emit_i64_const(out.body, instr.imm_i64)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrLoadFloat -> i64.const <bits>; f64.reinterpret_i64; local.set dst
// The local is declared as f64 (marked in prescan). The value is pushed
// as i64 bits then reinterpreted, so no raw 8-byte f64.const encoding needed.
fn wasm_lower_load_float(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    // f64_to_bits: compiler builtin — IEEE 754 bit reinterpret, no numeric conversion
    let bits = f64_to_bits(instr.imm_f64)
    out.body = wasm_body_emit_i64_const(out.body, bits)
    out.body = wasm_body_emit_f64_reinterpret_i64(out.body)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrLoadBool -> i64.const 0/1; local.set dst
fn wasm_lower_load_bool(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let val = instr.imm_i64  // already 0 or 1 from ir_load_bool
    out.body = wasm_body_emit_i64_const(out.body, val)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrCopy -> local.get src1; local.set dst
fn wasm_lower_copy(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let src_local = wasm_lower_get_local(out, instr.src1)
    let dst_local = wasm_lower_get_local(out, instr.dst)
    if src_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, src_local)
    }
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrBinOp -> local.get lhs; local.get rhs; <op>; local.set dst
fn wasm_lower_binop(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let lhs_local = wasm_lower_get_local(out, instr.src1)
    let rhs_local = wasm_lower_get_local(out, instr.src2)
    let dst_local = wasm_lower_get_local(out, instr.dst)

    // Push operands
    if lhs_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, lhs_local)
    }
    if rhs_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, rhs_local)
    }

    // Dispatch to f64 or i64 operations based on operand type.
    if wasm_lower_is_float_reg(out, instr.src1) {
        // ── f64 path ──────────────────────────────────────────────────────────
        // Arithmetic ops produce f64; comparison ops return i32 (extended to i64).
        match instr.bin_op {
            BinaryOp::OpAdd => { out.body = wasm_body_emit_f64_add(out.body) }
            BinaryOp::OpSub => { out.body = wasm_body_emit_f64_sub(out.body) }
            BinaryOp::OpMul => { out.body = wasm_body_emit_f64_mul(out.body) }
            BinaryOp::OpDiv => { out.body = wasm_body_emit_f64_div(out.body) }
            BinaryOp::OpEq => {
                out.body = wasm_body_emit_f64_eq(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpNe => {
                out.body = wasm_body_emit_f64_ne(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLt => {
                out.body = wasm_body_emit_f64_lt(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLe => {
                out.body = wasm_body_emit_f64_le(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGt => {
                out.body = wasm_body_emit_f64_gt(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGe => {
                out.body = wasm_body_emit_f64_ge(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            _ => {
                // Bitwise / shift ops on f64 are undefined; trap.
                out.body = wasm_body_emit_unreachable(out.body)
            }
        }
    } else {
        // ── i64 path ──────────────────────────────────────────────────────────
        match instr.bin_op {
            BinaryOp::OpAdd => { out.body = wasm_body_emit_i64_add(out.body) }
            BinaryOp::OpSub => { out.body = wasm_body_emit_i64_sub(out.body) }
            BinaryOp::OpMul => { out.body = wasm_body_emit_i64_mul(out.body) }
            BinaryOp::OpDiv => { out.body = wasm_body_emit_i64_div_s(out.body) }
            BinaryOp::OpRem => { out.body = wasm_body_emit_i64_rem_s(out.body) }
            BinaryOp::OpEq => {
                out.body = wasm_body_emit_i64_eq(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpNe => {
                out.body = wasm_body_emit_i64_ne(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLt => {
                out.body = wasm_body_emit_i64_lt_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpLe => {
                out.body = wasm_body_emit_i64_le_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGt => {
                out.body = wasm_body_emit_i64_gt_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpGe => {
                out.body = wasm_body_emit_i64_ge_s(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            BinaryOp::OpBitAnd => { out.body = wasm_body_emit_i64_and(out.body) }
            BinaryOp::OpBitOr => { out.body = wasm_body_emit_i64_or(out.body) }
            BinaryOp::OpBitXor => { out.body = wasm_body_emit_i64_xor(out.body) }
            BinaryOp::OpShl => { out.body = wasm_body_emit_i64_shl(out.body) }
            BinaryOp::OpShr => { out.body = wasm_body_emit_i64_shr_s(out.body) }
            BinaryOp::OpAnd => { out.body = wasm_body_emit_i64_and(out.body) }
            BinaryOp::OpOr  => { out.body = wasm_body_emit_i64_or(out.body) }
            _ => {
                // OpConcat, OpRange, OpRangeInclusive: not lowered to WASM
                out.body = wasm_body_emit_unreachable(out.body)
            }
        }
    }

    // Store result
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrUnaryOp -> local.get src; <op>; local.set dst
fn wasm_lower_unaryop(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let src_local = wasm_lower_get_local(out, instr.src1)
    let dst_local = wasm_lower_get_local(out, instr.dst)

    if src_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, src_local)
    }

    if wasm_lower_is_float_reg(out, instr.src1) {
        // ── f64 unary path ────────────────────────────────────────────────────
        match instr.un_op {
            UnaryOp::OpNeg => {
                // f64.neg (0x9A): flip the sign bit — correct IEEE 754 negation.
                // The i64.const(-1)*i64.mul trick is wrong for f64 locals.
                out.body = wasm_body_emit_f64_neg(out.body)
            }
            _ => {
                // OpNot on f64 is undefined; OpRef/Deref don't apply.
            }
        }
    } else {
        // ── i64 unary path ────────────────────────────────────────────────────
        match instr.un_op {
            UnaryOp::OpNeg => {
                // Negate: val is on stack.  Multiply by -1.
                out.body = wasm_body_emit_i64_const(out.body, 0 - 1)
                out.body = wasm_body_emit_i64_mul(out.body)
            }
            UnaryOp::OpNot => {
                // Logical NOT: i64.eqz → i32; extend back to i64.
                out.body = wasm_body_emit_i64_eqz(out.body)
                out.body = wasm_body_emit_i64_extend_i32_u(out.body)
            }
            _ => {
                // OpRef, OpRefMut, OpDeref: not representable in flat WASM lowering.
                // Pass through — value is already on the stack.
            }
        }
    }

    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// Push all call arguments from IrRegList onto the WASM stack.
// Box dereference (*list) does not require Alloc effect — only reads existing heap.
fn wasm_lower_push_args(ctx: WasmLowerCtx, args: Option<Box<IrRegList>>) -> WasmLowerCtx with Mut, Panic, Div {
    match args {
        Some(list) => {
            let reg = (*list).head
            var out = ctx
            if reg >= 0 {
                let local_idx = wasm_lower_get_local(out, reg)
                if local_idx >= 0 {
                    out.body = wasm_body_emit_local_get(out.body, local_idx)
                }
            }
            wasm_lower_push_args(out, (*list).tail)
        }
        _ => ctx
    }
}

// IrCall -> push all args from call_args list; call func_idx; local.set dst
fn wasm_lower_call(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let wasm_func_idx = wasm_lower_get_func(out, instr.fn_id)

    // Push all args via the full call_args list (supports >2 args)
    out = wasm_lower_push_args(out, instr.call_args)

    // Emit call
    if wasm_func_idx >= 0 {
        out.body = wasm_body_emit_call(out.body, wasm_func_idx)
    } else {
        // Unknown function: emit unreachable
        out.body = wasm_body_emit_unreachable(out.body)
    }

    // Store result
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrReturn -> local.get src1; return
fn wasm_lower_return(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    if instr.src1 >= 0 {
        let src_local = wasm_lower_get_local(out, instr.src1)
        if src_local >= 0 {
            out.body = wasm_body_emit_local_get(out.body, src_local)
        }
    }
    out.body = wasm_body_emit_return(out.body)
    out
}

// IrJump -> br <label_depth>
fn wasm_lower_jump(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let depth = wasm_lower_find_label_depth(out, instr.label_id)
    if depth >= 0 {
        out.body = wasm_body_emit_br(out.body, depth)
    } else {
        // Label not found on stack; emit unreachable as fallback
        out.body = wasm_body_emit_unreachable(out.body)
    }
    out
}

// IrBranchTrue -> local.get cond; br_if <label_depth>
fn wasm_lower_branch_true(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let cond_local = wasm_lower_get_local(out, instr.src1)
    if cond_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, cond_local)
        // Truncate i64 to i32 for br_if condition (WASM expects i32)
        out.body = wasm_body_emit_i32_wrap_i64(out.body)
    }
    let depth = wasm_lower_find_label_depth(out, instr.label_id)
    if depth >= 0 {
        out.body = wasm_body_emit_br_if(out.body, depth)
    }
    out
}

// IrBranchFalse -> local.get cond; i64.eqz; i32.wrap_i64 already done by eqz...
//                  Actually: local.get cond; i32.wrap_i64; i32.eqz; br_if depth
fn wasm_lower_branch_false(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let cond_local = wasm_lower_get_local(out, instr.src1)
    if cond_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, cond_local)
        // i64.eqz produces i32 (1 if zero, 0 otherwise) -- inverts the condition
        out.body = wasm_body_emit_i64_eqz(out.body)
    }
    let depth = wasm_lower_find_label_depth(out, instr.label_id)
    if depth >= 0 {
        out.body = wasm_body_emit_br_if(out.body, depth)
    }
    out
}

// IrLabel -> open a `loop` if the label is a backward-jump target (detected by
// IrLabel lowering — three cases:
//
//  (A) Loop exit label: is_loop_exit[lid] >= 0
//      The loop + its wrapper block were both pre-pushed onto the stack when the
//      loop header was seen.  Close all scopes up to and including the loop
//      itself, then close the exit wrapper block.  Do NOT open a new scope.
//
//  (B) Loop header: loop_labels[lid] == 1
//      Emit an outer `block` keyed to the exit label so that forward branches
//      out of the loop (br_if depth=1) can escape.  Then emit the `loop`
//      itself.  Stack depth after: [..., block-exit, loop-lid].
//
//  (C) Forward label (if/else exit, break target): plain `block`.
//
// Depth semantics inside a loop body:
//   br 0  → back to top of loop  (depth 0 = loop-lid)
//   br 1  → exit the loop        (depth 1 = block-exit wrapper)
fn wasm_lower_label(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let lid = instr.label_id
    if lid >= 0 && lid < 512 {
        let loop_owner = out.is_loop_exit[lid as usize]
        if loop_owner >= 0 {
            // ── Case A: this label is the exit point of a loop ────────────────
            // Close all open scopes up to and including the loop-owner scope,
            // then close the exit wrapper block that was pre-opened below it.
            var done = false
            while out.label_depth > 0 && !done {
                let top_id = out.label_stack[(out.label_depth - 1) as usize].ir_label_id
                out.body = wasm_body_emit_end(out.body)
                out = wasm_lower_pop_label(out)
                if top_id == loop_owner {
                    done = true
                }
            }
            // Close the exit wrapper block (should be directly below the loop).
            if out.label_depth > 0 {
                let wrapper_id = out.label_stack[(out.label_depth - 1) as usize].ir_label_id
                if wrapper_id == lid {
                    out.body = wasm_body_emit_end(out.body)
                    out = wasm_lower_pop_label(out)
                }
            }
            // Fall-through continues after the loop; no new scope opened.

        } else if out.loop_labels[lid as usize] == 1 {
            // ── Case B: loop header ───────────────────────────────────────────
            let exit_lid = out.loop_exit[lid as usize]
            if exit_lid >= 0 {
                // Pre-open an outer block for the exit label so branch_false
                // inside the loop can target it via depth=1.
                out.body = wasm_body_emit_block(out.body, WASM_BLOCK_VOID)
                out = wasm_lower_push_label(out, exit_lid, WASM_LABEL_BLOCK)
            }
            out.body = wasm_body_emit_loop(out.body, WASM_BLOCK_VOID)
            out = wasm_lower_push_label(out, lid, WASM_LABEL_LOOP)

        } else {
            // ── Case C: forward label ─────────────────────────────────────────
            out.body = wasm_body_emit_block(out.body, WASM_BLOCK_VOID)
            out = wasm_lower_push_label(out, lid, WASM_LABEL_BLOCK)
        }
    }
    out
}

// Close the current block/loop scope
fn wasm_lower_end_block(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    out.body = wasm_body_emit_end(out.body)
    out = wasm_lower_pop_label(out)
    out
}

// IrFieldGet -> lower as i64.load from (base_ptr + field_idx * 8)
// In this simplified lowering, struct fields are 8-byte slots in linear memory
fn wasm_lower_field_get(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let offset = instr.field_idx * 8

    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    // WASM memory ops take i32 addresses: truncate the i64 pointer.
    out.body = wasm_body_emit_i32_wrap_i64(out.body)
    // i64.load with alignment 3 (2^3 = 8 byte aligned), offset = field_idx * 8
    out.body = wasm_body_emit_i64_load(out.body, 3, offset)

    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrFieldSet -> i64.store to (base_ptr + field_idx * 8)
fn wasm_lower_field_set(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let val_local = wasm_lower_get_local(out, instr.src2)
    let offset = instr.field_idx * 8

    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    // WASM store expects i32 address below the value on the stack.
    out.body = wasm_body_emit_i32_wrap_i64(out.body)
    if val_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, val_local)
    }
    out.body = wasm_body_emit_i64_store(out.body, 3, offset)
    out
}

// IrIndexGet -> i64.load from (base + idx * 8)
fn wasm_lower_index_get(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let idx_local = wasm_lower_get_local(out, instr.src2)
    let dst_local = wasm_lower_get_local(out, instr.dst)

    // Compute address: base + idx * 8
    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    if idx_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, idx_local)
        out.body = wasm_body_emit_i64_const(out.body, 8)
        out.body = wasm_body_emit_i64_mul(out.body)
        out.body = wasm_body_emit_i64_add(out.body)
    }

    // Wrap to i32 address for WASM memory ops
    out.body = wasm_body_emit_i32_wrap_i64(out.body)
    out.body = wasm_body_emit_i64_load(out.body, 3, 0)

    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// IrIndexSet -> i64.store to (base + idx * 8)
fn wasm_lower_index_set(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let base_local = wasm_lower_get_local(out, instr.src1)
    let idx_local = wasm_lower_get_local(out, instr.src2)
    // For IrIndexSet, src_reg is stored in imm_i64 (see ir.sio: ir_index_set)
    let val_local = wasm_lower_get_local(out, instr.imm_i64)

    // Compute address: base + idx * 8
    if base_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, base_local)
    }
    if idx_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, idx_local)
        out.body = wasm_body_emit_i64_const(out.body, 8)
        out.body = wasm_body_emit_i64_mul(out.body)
        out.body = wasm_body_emit_i64_add(out.body)
    }
    out.body = wasm_body_emit_i32_wrap_i64(out.body)

    // Push value
    if val_local >= 0 {
        out.body = wasm_body_emit_local_get(out.body, val_local)
    }
    out.body = wasm_body_emit_i64_store(out.body, 3, 0)
    out
}

// IrNop -> nop (no-op)
fn wasm_lower_nop(ctx: WasmLowerCtx) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    out.body = wasm_body_emit_nop(out.body)
    out
}

// IrPhi -> copy from the first incoming value register (call_args head).
//
// In a well-formed pipeline, SSA phi nodes are eliminated by the SSA-destruction
// pass before reaching this lowerer.  If a phi survives, lower it conservatively
// as a copy from the first incoming value.  Subsequent parallel-copy insertion
// would be needed for full correctness; this is a safe fallback.
fn wasm_lower_phi(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    match instr.call_args {
        Some(list) => {
            let reg = (*list).head
            if reg >= 0 {
                let src_local = wasm_lower_get_local(out, reg)
                if src_local >= 0 && dst_local >= 0 {
                    out.body = wasm_body_emit_local_get(out.body, src_local)
                    out.body = wasm_body_emit_local_set(out.body, dst_local)
                }
            }
        }
        _ => {}
    }
    out
}

// ============================================================================
// Instruction dispatch
// ============================================================================

fn wasm_lower_instruction(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    match instr.op {
        IrOpcode::IrLoadImm => wasm_lower_load_imm(ctx, instr),
        IrOpcode::IrLoadFloat => wasm_lower_load_float(ctx, instr),
        IrOpcode::IrLoadBool => wasm_lower_load_bool(ctx, instr),
        IrOpcode::IrCopy => wasm_lower_copy(ctx, instr),
        IrOpcode::IrContest => wasm_lower_copy(ctx, instr),
        IrOpcode::IrProveRobust => wasm_lower_copy(ctx, instr),
        IrOpcode::IrValidated => wasm_lower_copy(ctx, instr),
        IrOpcode::IrAdmitAction => wasm_lower_copy(ctx, instr),
        IrOpcode::IrDeferAction => wasm_lower_copy(ctx, instr),
        IrOpcode::IrPlanAcquisition => wasm_lower_copy(ctx, instr),
        IrOpcode::IrPlanRecourse => wasm_lower_copy(ctx, instr),
        IrOpcode::IrProposeAlternatives => wasm_lower_copy(ctx, instr),
        IrOpcode::IrCommitAlternative => wasm_lower_copy(ctx, instr),
        IrOpcode::IrLiftKnowledge => wasm_lower_copy(ctx, instr),
        IrOpcode::IrMeasure => wasm_lower_copy(ctx, instr),
        IrOpcode::IrDebugGuard => wasm_lower_nop(ctx),
        IrOpcode::IrBinOp => wasm_lower_binop(ctx, instr),
        IrOpcode::IrUnaryOp => wasm_lower_unaryop(ctx, instr),
        IrOpcode::IrCall => wasm_lower_call(ctx, instr),
        IrOpcode::IrReturn => wasm_lower_return(ctx, instr),
        IrOpcode::IrJump => wasm_lower_jump(ctx, instr),
        IrOpcode::IrBranchTrue => wasm_lower_branch_true(ctx, instr),
        IrOpcode::IrBranchFalse => wasm_lower_branch_false(ctx, instr),
        IrOpcode::IrLabel => wasm_lower_label(ctx, instr),
        IrOpcode::IrFieldGet => wasm_lower_field_get(ctx, instr),
        IrOpcode::IrFieldSet => wasm_lower_field_set(ctx, instr),
        IrOpcode::IrIndexGet => wasm_lower_index_get(ctx, instr),
        IrOpcode::IrIndexSet => wasm_lower_index_set(ctx, instr),
        IrOpcode::IrNop => wasm_lower_nop(ctx),
        IrOpcode::IrPhi => wasm_lower_phi(ctx, instr),
        IrOpcode::IrLoadString => wasm_lower_load_string(ctx, instr),
        IrOpcode::IrAlloc => wasm_lower_alloc(ctx, instr),
        _ => {
            wasm_lower_nop(ctx)
        }
    }
}

// ============================================================================
// Return-type inference: scan IrReturn to determine WASM result type.
// Returns WASM_TYPE_I64 or WASM_TYPE_F64 if function returns a value,
// or -1 (void) if no IrReturn with a live src, or no IrReturn at all.
// Standalone (no ctx): does a two-pass scan of the IR function.
// ============================================================================

fn wasm_lower_return_type(func: IrFunction) -> i64 with Mut, Panic, Div {
    // Pass 1: collect registers produced by IrLoadFloat (these are f64)
    var float_regs: [i64; 512] = [0; 512]
    var i: i64 = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        match instr.op {
            IrOpcode::IrLoadFloat => {
                if instr.dst >= 0 && instr.dst < 512 {
                    float_regs[instr.dst as usize] = 1
                }
            }
            _ => {}
        }
        i = i + 1
    }
    // Pass 2: find IrReturn and determine type of returned value
    i = 0
    while i < func.instr_count {
        let instr = func.instrs[i as usize]
        match instr.op {
            IrOpcode::IrReturn => {
                if instr.src1 >= 0 {
                    if instr.src1 < 512 && float_regs[instr.src1 as usize] == 1 {
                        return WASM_TYPE_F64
                    }
                    return WASM_TYPE_I64
                }
                return 0 - 1  // IrReturn with no src → void
            }
            _ => {}
        }
        i = i + 1
    }
    0 - 1  // no IrReturn found → void
}

// ============================================================================
// f64 param type inference
// ============================================================================
// Infers which of a function's param registers are f64 by:
//   Step 1: seed float_regs from all IrLoadFloat destinations.
//   Step 2: propagate forward (if any BinOp input is f64, output is f64)
//           and backward (if BinOp output is f64, both inputs are f64) — 3 passes.
//   Step 3: check each param_reg against float_regs; emit WASM_TYPE_F64 or I64.
// Returns a [i64; 32] of WASM type codes, one per param.
fn wasm_lower_infer_param_types(func: IrFunction) -> [i64; 32] with Mut, Panic, Div {
    var result: [i64; 32] = [126; 32]  // 0x7e = WASM_TYPE_I64 = 126 (default all i64)

    // Step 1: seed — mark regs written by IrLoadFloat as f64
    var float_regs: [i64; 512] = [0; 512]
    var i: i64 = 0
    while i < func.instr_count && i < 4096 {
        let instr = func.instrs[i as usize]
        match instr.op {
            IrOpcode::IrLoadFloat => {
                if instr.dst >= 0 && instr.dst < 512 {
                    float_regs[instr.dst as usize] = 1
                }
            }
            _ => {}
        }
        i = i + 1
    }

    // Step 2: propagate — 3 passes over the instruction stream handles most
    // programs without needing full fixed-point iteration.
    var pass: i64 = 0
    while pass < 3 {
        i = 0
        while i < func.instr_count && i < 4096 {
            let instr = func.instrs[i as usize]
            match instr.op {
                IrOpcode::IrBinOp => {
                    let s1f = instr.src1 >= 0 && instr.src1 < 512
                              && float_regs[instr.src1 as usize] == 1
                    let s2f = instr.src2 >= 0 && instr.src2 < 512
                              && float_regs[instr.src2 as usize] == 1
                    let df  = instr.dst  >= 0 && instr.dst  < 512
                              && float_regs[instr.dst  as usize] == 1
                    // Forward: float input → float output
                    if (s1f || s2f) && instr.dst >= 0 && instr.dst < 512 {
                        float_regs[instr.dst as usize] = 1
                    }
                    // Backward: float output → float inputs
                    if df {
                        if instr.src1 >= 0 && instr.src1 < 512 {
                            float_regs[instr.src1 as usize] = 1
                        }
                        if instr.src2 >= 0 && instr.src2 < 512 {
                            float_regs[instr.src2 as usize] = 1
                        }
                    }
                }
                IrOpcode::IrCopy => {
                    let s1f = instr.src1 >= 0 && instr.src1 < 512
                              && float_regs[instr.src1 as usize] == 1
                    let df  = instr.dst  >= 0 && instr.dst  < 512
                              && float_regs[instr.dst  as usize] == 1
                    if s1f && instr.dst >= 0 && instr.dst < 512 {
                        float_regs[instr.dst as usize] = 1
                    }
                    if df && instr.src1 >= 0 && instr.src1 < 512 {
                        float_regs[instr.src1 as usize] = 1
                    }
                }
                _ => {}
            }
            i = i + 1
        }
        pass = pass + 1
    }

    // Step 3: assign param types
    var p: i64 = 0
    while p < func.param_count && p < 32 {
        let preg = func.param_regs[p as usize]
        if preg >= 0 && preg < 512 && float_regs[preg as usize] == 1 {
            result[p as usize] = 125  // 0x7d = WASM_TYPE_F64
        }
        p = p + 1
    }

    result
}

// ============================================================================
// IrLoadString — load string literal address
//
// IrLoadString: dst = &string_table[imm_i64]
// Strategy: the string bytes are placed in the WASM data section at a known
// offset (stored in ctx.string_offsets[string_idx]). We emit:
//   i32.const <offset>       → i32 pointer to the string's first byte
//   i64.extend_i32_u         → promote to i64 (IR convention)
//   local.set dst
// If string_idx is unknown (not found in string_offsets), emit i64.const 0.
// ============================================================================

fn wasm_lower_load_string(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    let sidx = instr.imm_i64
    var offset: i64 = 0
    if sidx >= 0 && sidx < 512 {
        let stored = out.string_offsets[sidx as usize]
        if stored >= 0 { offset = stored }
    }
    out.body = wasm_body_emit_i32_const(out.body, offset)
    out.body = wasm_body_emit_i64_extend_i32_u(out.body)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    out
}

// ============================================================================
// IrAlloc — heap bump allocator
//
// IrAlloc: dst = alloc(type_id)
// Strategy: global 0 is the heap bump pointer (i64).
//   1. global.get 0              → current heap ptr (i64)
//   2. local.set dst             → save as result (allocated address)
//   3. global.get 0
//   4. i64.const ALLOC_SIZE      → 64 bytes (conservative fixed size)
//   5. i64.add
//   6. global.set 0              → update heap ptr
// ============================================================================

let WASM_ALLOC_SIZE: i64 = 64   // default allocation size (8 i64 fields)
let WASM_HEAP_GLOBAL: i64 = 0   // index of the heap bump pointer global

fn wasm_lower_alloc(ctx: WasmLowerCtx, instr: IrInstr) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    let dst_local = wasm_lower_get_local(out, instr.dst)
    // Grab current heap pointer as the allocation result
    out.body = wasm_body_emit_global_get(out.body, WASM_HEAP_GLOBAL)
    if dst_local >= 0 {
        out.body = wasm_body_emit_local_set(out.body, dst_local)
    }
    // Bump the heap pointer by WASM_ALLOC_SIZE
    out.body = wasm_body_emit_global_get(out.body, WASM_HEAP_GLOBAL)
    out.body = wasm_body_emit_i64_const(out.body, WASM_ALLOC_SIZE)
    out.body = wasm_body_emit_i64_add(out.body)
    out.body = wasm_body_emit_global_set(out.body, WASM_HEAP_GLOBAL)
    out
}

// ============================================================================
// Basic block lowering: lower all instructions sequentially
// ============================================================================

fn wasm_lower_basic_block(ctx: WasmLowerCtx, func: IrFunction, start: i64, end_idx: i64) -> WasmLowerCtx with Mut, Panic, Div {
    var out = ctx
    var i = start
    while i < end_idx && i < func.instr_count {
        out = wasm_lower_instruction(out, func.instrs[i as usize])
        i = i + 1
    }
    out
}

// ============================================================================
// Function lowering
//
// For each IrFunction:
//   1. Reset body and allocate locals
//   2. Declare non-parameter locals as i64
//   3. Lower all instructions
//   4. Append implicit `end` opcode
//   5. Return the WasmFuncBody
// ============================================================================

fn wasm_lower_function(ctx: WasmLowerCtx, func: IrFunction) -> WasmLowerCtx with Mut, Panic, Div {
    var out = wasm_lower_ctx_reset_body(ctx)

    // Detect loop targets (back-edge labels) before main lowering.
    out = wasm_lower_detect_loops(out, func)

    // Pre-scan to allocate WASM locals for all IR registers
    out = wasm_lower_prescan_locals(out, func)

    // Declare extra locals (beyond parameters) one-by-one by type.
    // This correctly handles mixed i64/f64 extra locals.
    var e: i64 = func.param_count
    while e < out.local_count {
        let ltype = out.local_type[e as usize]
        out.body = wasm_body_add_local(out.body, 1, ltype)
        e = e + 1
    }

    // Lower all instructions
    out = wasm_lower_basic_block(out, func, 0, func.instr_count)

    // Close any remaining open label scopes
    while out.label_depth > 0 {
        out = wasm_lower_end_block(out)
    }

    // Append implicit function end
    out.body = wasm_body_emit_end(out.body)

    out
}

// ============================================================================
// Export helper
//
// Build a WasmExport from an IrFunction Name struct without going through a
// Sounio `string` (which requires a runtime allocation).  Copies the raw bytes
// from Name.buf directly into WasmExport.name_buf.
// ============================================================================

fn wasm_lower_export_from_name(name: Name, func_idx: i64) -> WasmExport with Mut, Panic, Div {
    var exp = wasm_export_new()
    var i: i64 = 0
    while i < name.len && i < 128 {
        exp.name_buf[i as usize] = name.buf[i as usize]
        i = i + 1
    }
    exp.name_len = name.len
    exp.kind = WASM_EXPORT_FUNC
    exp.index = func_idx
    exp
}

// ============================================================================
// Builtin function detection
//
// Builtin functions are those with instr_count == 0 whose name matches one of
// the known host-provided functions (print, print_int, str_len, etc.).
// They are emitted as WASM imports (module="env") rather than local functions.
// ============================================================================

// Check if a Name is the builtin "print" (5 bytes: p-r-i-n-t)
fn wasm_lower_name_is_print(name: Name) -> bool with Mut, Panic {
    name.len == 5
        && (name.buf[0 as usize] as i64) == 112  // p
        && (name.buf[1 as usize] as i64) == 114  // r
        && (name.buf[2 as usize] as i64) == 105  // i
        && (name.buf[3 as usize] as i64) == 110  // n
        && (name.buf[4 as usize] as i64) == 116  // t
}

// Check if a Name begins with "print_" (the prefix shared by print_int, print_char)
fn wasm_lower_name_starts_print_under(name: Name) -> bool with Mut, Panic {
    name.len >= 6
        && (name.buf[0 as usize] as i64) == 112  // p
        && (name.buf[1 as usize] as i64) == 114  // r
        && (name.buf[2 as usize] as i64) == 105  // i
        && (name.buf[3 as usize] as i64) == 110  // n
        && (name.buf[4 as usize] as i64) == 116  // t
        && (name.buf[5 as usize] as i64) == 95   // _
}

// Check if a Name begins with "str_" (str_len, str_eq, str_char_at, etc.)
fn wasm_lower_name_starts_str_under(name: Name) -> bool with Mut, Panic {
    name.len >= 4
        && (name.buf[0 as usize] as i64) == 115  // s
        && (name.buf[1 as usize] as i64) == 116  // t
        && (name.buf[2 as usize] as i64) == 114  // r
        && (name.buf[3 as usize] as i64) == 95   // _
}

// Check if a Name begins with "get_arg" (get_arg, get_arg_count)
fn wasm_lower_name_starts_get_arg(name: Name) -> bool with Mut, Panic {
    name.len >= 7
        && (name.buf[0 as usize] as i64) == 103  // g
        && (name.buf[1 as usize] as i64) == 101  // e
        && (name.buf[2 as usize] as i64) == 116  // t
        && (name.buf[3 as usize] as i64) == 95   // _
        && (name.buf[4 as usize] as i64) == 97   // a
        && (name.buf[5 as usize] as i64) == 114  // r
        && (name.buf[6 as usize] as i64) == 103  // g
}

// Returns true if the function name is a known host builtin.
fn wasm_lower_is_builtin_name(name: Name) -> bool with Mut, Panic {
    if wasm_lower_name_is_print(name) { return true }
    if wasm_lower_name_starts_print_under(name) { return true }
    if wasm_lower_name_starts_str_under(name) { return true }
    if wasm_lower_name_starts_get_arg(name) { return true }
    false
}

// Returns true if this IR function is a host builtin (no body, known builtin name).
fn wasm_lower_is_builtin(func: IrFunction) -> bool with Mut, Panic {
    func.instr_count == 0 && wasm_lower_is_builtin_name(func.name)
}

// Returns the WASM param count for a known builtin.
// print / print_int / print_char → 1 param (the string/value as i64)
// str_len → 1 param (string pointer)
// All others → 2 params (two i64 args)
fn wasm_lower_builtin_param_count(name: Name) -> i64 {
    if wasm_lower_name_is_print(name) { return 1 }        // print
    if wasm_lower_name_starts_print_under(name) { return 1 }  // print_int, print_char
    if name.len == 7 { return 1 }                          // str_len (len=7: s-t-r-_-l-e-n)
    2  // str_eq, str_char_at, str_concat, str_slice, get_arg, etc.
}

// Returns true if the builtin returns i64 (false → void return).
// print / print_int / print_char return void; str_* and get_* return i64.
fn wasm_lower_builtin_returns_i64(name: Name) -> bool {
    if wasm_lower_name_is_print(name) { return false }
    if wasm_lower_name_starts_print_under(name) { return false }
    true
}

// Build a WasmImport for a builtin function.
// module = "env" (101 110 118), name = func.name bytes.
fn wasm_lower_make_builtin_import(func_name: Name, type_idx: i64) -> WasmImport with Mut, Panic, Div {
    var imp = wasm_import_new()
    // module = "env"
    imp.module_buf[0 as usize] = 101 as i8  // e
    imp.module_buf[1 as usize] = 110 as i8  // n
    imp.module_buf[2 as usize] = 118 as i8  // v
    imp.module_len = 3
    // function name
    var i: i64 = 0
    while i < func_name.len && i < 32 {
        imp.name_buf[i as usize] = func_name.buf[i as usize]
        i = i + 1
    }
    imp.name_len = func_name.len
    imp.type_index = type_idx
    imp
}

// ============================================================================
// Module lowering
//
// Translates an entire IrModule into WASM sections:
//   - Type section:     types for all functions (imports + locals)
//   - Import section:   host builtins (print, print_int, str_*, ...)
//   - Function section: local functions only (indices offset by import count)
//   - Code section:     lowered bodies for local functions only
//   - Export section:   local functions by IR name + "memory"
//   - Memory section:   1 page minimum for heap
// ============================================================================

struct WasmLowerResult {
    buf: WasmBuf,
    func_count: i64,
    error_count: i64,
}

fn wasm_lower_result_new() -> WasmLowerResult {
    WasmLowerResult {
        buf: wasm_buf_new(),
        func_count: 0,
        error_count: 0,
    }
}

fn wasm_lower_module(module: IrModule) -> WasmLowerResult with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    var types = wasm_type_section_new()
    var imports = wasm_import_section_new()
    var funcs = wasm_func_section_new()
    var code = wasm_code_section_new()
    var exports = wasm_export_section_new()

    // ── Pass 0: count imports so we can compute WASM function index offsets ──
    var n_imports: i64 = 0
    var si: i64 = 0
    while si < module.fn_count && si < WASM_LOWER_MAX_FUNCS {
        if wasm_lower_is_builtin(module.functions[si as usize]) {
            n_imports = n_imports + 1
        }
        si = si + 1
    }

    // ── Pass 1: register all IR function IDs → WASM function indices ─────────
    // Builtins get indices 0..n_imports-1 (they are imported).
    // Local functions get indices n_imports..n_imports+n_local-1.
    var import_idx: i64 = 0
    var local_idx: i64 = n_imports
    var fi: i64 = 0
    while fi < module.fn_count && fi < WASM_LOWER_MAX_FUNCS {
        let func = module.functions[fi as usize]
        if wasm_lower_is_builtin(func) {
            ctx = wasm_lower_register_func(ctx, fi, import_idx)
            import_idx = import_idx + 1
        } else {
            ctx = wasm_lower_register_func(ctx, fi, local_idx)
            local_idx = local_idx + 1
        }
        fi = fi + 1
    }

    // ── Pass 2: build type section + import/function sections ─────────────────
    // All functions (builtins and locals) get a type entry.
    // The type_index for each function is its position in the type section.
    // Builtins' type entries come first (in IR order), then locals.
    // We track type indices in a temporary array.
    var type_indices: [i64; 256] = [0; 256]
    var type_idx: i64 = 0

    fi = 0
    while fi < module.fn_count && fi < WASM_LOWER_MAX_FUNCS {
        let func = module.functions[fi as usize]
        var ft = wasm_func_type_new()

        if wasm_lower_is_builtin(func) {
            // Builtin: use hardcoded param count and return type.
            let n_params = wasm_lower_builtin_param_count(func.name)
            var p: i64 = 0
            while p < n_params {
                ft = wasm_func_type_add_param(ft, WASM_TYPE_I64)
                p = p + 1
            }
            if wasm_lower_builtin_returns_i64(func.name) {
                ft = wasm_func_type_add_result(ft, WASM_TYPE_I64)
            }
        } else {
            // Local function: infer param types (i64 vs f64) + return type.
            let param_types = wasm_lower_infer_param_types(func)
            var p: i64 = 0
            while p < func.param_count {
                ft = wasm_func_type_add_param(ft, param_types[p as usize])
                p = p + 1
            }
            let ret_type = wasm_lower_return_type(func)
            if ret_type >= 0 {
                ft = wasm_func_type_add_result(ft, ret_type)
            }
        }

        if fi < 256 { type_indices[fi as usize] = type_idx }
        types = wasm_type_section_add(types, ft)
        type_idx = type_idx + 1
        fi = fi + 1
    }

    // ── Pass 3: populate import section, function section, code section ───────
    fi = 0
    while fi < module.fn_count && fi < WASM_LOWER_MAX_FUNCS {
        let func = module.functions[fi as usize]
        let tidx = if fi < 256 { type_indices[fi as usize] } else { 0 }
        let wasm_idx = wasm_lower_get_func(ctx, fi)

        if wasm_lower_is_builtin(func) {
            // Emit WASM import entry for this builtin.
            let imp = wasm_lower_make_builtin_import(func.name, tidx)
            imports = wasm_import_section_add(imports, imp)
        } else {
            // Emit function section entry (type index for this local function).
            funcs = wasm_func_section_add(funcs, tidx)

            // Export local function by its IR name.
            let exp = wasm_lower_export_from_name(func.name, wasm_idx)
            exports = wasm_export_section_add(exports, exp)

            // Lower the function body.
            ctx = wasm_lower_function(ctx, func)
            code = wasm_code_section_add(code, ctx.body)
        }
        fi = fi + 1
    }

    // Also export the linear memory (conventional for WASM modules)
    exports = wasm_export_section_add(exports, wasm_export_memory("memory", 0))

    // ── Pass 4: build data section + global section from string_table ─────────
    // Each string in the IR module becomes one data segment (null-terminated).
    // We populate ctx.string_offsets[si] so IrLoadString knows the right offset.
    // heap_start is placed just past the string data, aligned to 8 bytes.
    var data = wasm_data_section_new()
    var di: i64 = 0
    while di < module.string_count && di < 512 {
        let sname = module.string_table[di as usize]
        let seg_offset = data.data_len
        data = wasm_data_section_add_name(data, sname)
        ctx.string_offsets[di as usize] = seg_offset
        di = di + 1
    }
    // Align heap_start to 8 bytes, minimum 8 (avoid null pointer at address 0)
    let raw_heap = data.data_len
    let aligned = (raw_heap + 7) / 8 * 8
    let heap = if aligned < 8 { 8 } else { aligned }
    ctx.heap_start = heap

    // Global section: mutable i64 global 0 = heap_start (bump allocator pointer)
    var globals = wasm_global_section_new()
    globals = wasm_global_section_add(globals, heap)

    // Emit the full WASM module
    let buf = wasm_emit_full_module(types, imports, funcs, globals, 1, 0, exports, code, data)

    WasmLowerResult {
        buf: buf,
        func_count: module.fn_count,
        error_count: ctx.error_count,
    }
}

// ============================================================================
// Helper: build a simple IR function for testing
// ============================================================================

fn wasm_lower_test_make_add_func() -> IrFunction with Mut, Panic, Div {
    // fn add(a, b) -> a + b
    var func = ir_empty_function()
    func.param_count = 2
    func.param_regs[0 as usize] = 0
    func.param_regs[1 as usize] = 1
    func.reg_count = 3

    // r2 = r0 + r1
    func.instrs[0 as usize] = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    // return r2
    func.instrs[1 as usize] = ir_return(2)
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_const_func() -> IrFunction with Mut, Panic, Div {
    // fn const42() -> 42
    var func = ir_empty_function()
    func.param_count = 0
    func.reg_count = 1

    // r0 = 42
    func.instrs[0 as usize] = ir_load_imm(0, 42)
    // return r0
    func.instrs[1 as usize] = ir_return(0)
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_branch_func() -> IrFunction with Mut, Panic, Div {
    // fn branch_test(cond) -> cond ? 1 : 0
    var func = ir_empty_function()
    func.param_count = 1
    func.param_regs[0 as usize] = 0
    func.reg_count = 2

    // label 0 (block start)
    func.instrs[0 as usize] = ir_label(0)
    // branch_true r0, label 0
    func.instrs[1 as usize] = ir_branch_true(0, 0)
    // r1 = 0
    func.instrs[2 as usize] = ir_load_imm(1, 0)
    // return r1
    func.instrs[3 as usize] = ir_return(1)
    func.instr_count = 4

    func
}

fn wasm_lower_test_make_neg_func() -> IrFunction with Mut, Panic, Div {
    // fn negate(x) -> -x
    var func = ir_empty_function()
    func.param_count = 1
    func.param_regs[0 as usize] = 0
    func.reg_count = 2

    // r1 = -r0
    func.instrs[0 as usize] = ir_unaryop(1, UnaryOp::OpNeg, 0)
    // return r1
    func.instrs[1 as usize] = ir_return(1)
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_copy_func() -> IrFunction with Mut, Panic, Div {
    // fn identity(x) -> x  (via copy)
    var func = ir_empty_function()
    func.param_count = 1
    func.param_regs[0 as usize] = 0
    func.reg_count = 2

    // r1 = r0
    func.instrs[0 as usize] = ir_copy(1, 0)
    // return r1
    func.instrs[1 as usize] = ir_return(1)
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_sub_func() -> IrFunction with Mut, Panic, Div {
    // fn sub(a, b) -> a - b
    var func = ir_empty_function()
    func.param_count = 2
    func.param_regs[0 as usize] = 0
    func.param_regs[1 as usize] = 1
    func.reg_count = 3

    func.instrs[0 as usize] = ir_binop(2, 0, BinaryOp::OpSub, 1)
    func.instrs[1 as usize] = ir_return(2)
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_compare_func() -> IrFunction with Mut, Panic, Div {
    // fn lt(a, b) -> a < b
    var func = ir_empty_function()
    func.param_count = 2
    func.param_regs[0 as usize] = 0
    func.param_regs[1 as usize] = 1
    func.reg_count = 3

    func.instrs[0 as usize] = ir_binop(2, 0, BinaryOp::OpLt, 1)
    func.instrs[1 as usize] = ir_return(2)
    func.instr_count = 2

    func
}

fn wasm_lower_test_make_bool_func() -> IrFunction with Mut, Panic, Div {
    // fn load_true() -> true
    var func = ir_empty_function()
    func.param_count = 0
    func.reg_count = 1

    func.instrs[0 as usize] = ir_load_bool(0, true)
    func.instrs[1 as usize] = ir_return(0)
    func.instr_count = 2

    func
}

// ============================================================================
// Inline tests
// ============================================================================

// Test 1: lowering context initialization
fn test_wasm_lower_ctx_init() -> bool with Mut, Panic, Div {
    let ctx = wasm_lower_ctx_new()
    ctx.local_count == 0
        && ctx.func_count == 0
        && ctx.label_depth == 0
        && ctx.error_count == 0
        && ctx.body.code_len == 0
}

// Test 2: local variable allocation
fn test_wasm_lower_alloc_locals() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 5)
    ctx = wasm_lower_alloc_local(ctx, 0)  // duplicate, should not increment

    let loc0 = wasm_lower_get_local(ctx, 0)
    let loc5 = wasm_lower_get_local(ctx, 5)

    ctx.local_count == 2
        && loc0 == 0
        && loc5 == 1
}

// Test 3: function table registration and lookup
fn test_wasm_lower_func_table() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_register_func(ctx, 0, 10)
    ctx = wasm_lower_register_func(ctx, 3, 42)

    let f0 = wasm_lower_get_func(ctx, 0)
    let f3 = wasm_lower_get_func(ctx, 3)
    let f1 = wasm_lower_get_func(ctx, 1)  // not registered

    f0 == 10 && f3 == 42 && f1 < 0
}

// Test 4: label stack push, find, and pop
fn test_wasm_lower_label_stack() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_push_label(ctx, 100, WASM_LABEL_BLOCK)
    ctx = wasm_lower_push_label(ctx, 200, WASM_LABEL_LOOP)

    let d200 = wasm_lower_find_label_depth(ctx, 200)
    let d100 = wasm_lower_find_label_depth(ctx, 100)
    let d999 = wasm_lower_find_label_depth(ctx, 999)

    // 200 is at depth 0 (top), 100 at depth 1
    let before_ok = d200 == 0 && d100 == 1 && d999 < 0
    ctx = wasm_lower_pop_label(ctx)
    let after_d100 = wasm_lower_find_label_depth(ctx, 100)

    before_ok && after_d100 == 0 && ctx.label_depth == 1
}

// Test 5: lowering IrLoadImm produces i64.const + local.set
fn test_wasm_lower_load_imm() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)

    let instr = ir_load_imm(0, 42)
    ctx = wasm_lower_load_imm(ctx, instr)

    // Should have emitted: i64.const(0x42) 42(LEB128) + local.set(0x21) 0(LEB128)
    // i64.const = 0x42, 42 = 0x2A (1 byte), local.set = 0x21, index 0 = 0x00
    ctx.body.code_len == 4
        && (ctx.body.code[0 as usize] as i64) == 0x42  // i64.const
        && (ctx.body.code[1 as usize] as i64) == 42     // 42 in signed LEB128
        && (ctx.body.code[2 as usize] as i64) == 0x21   // local.set
        && (ctx.body.code[3 as usize] as i64) == 0      // local index 0
}

// Test 6: lowering IrBinOp(OpAdd) produces local.get + local.get + i64.add + local.set
fn test_wasm_lower_binop_add() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 1)
    ctx = wasm_lower_alloc_local(ctx, 2)

    let instr = ir_binop(2, 0, BinaryOp::OpAdd, 1)
    ctx = wasm_lower_binop(ctx, instr)

    // Expected: local.get 0, local.get 1, i64.add, local.set 2
    // Opcodes: 0x20 0x00 | 0x20 0x01 | 0x7C | 0x21 0x02
    ctx.body.code_len == 7
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0
        && (ctx.body.code[2 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[3 as usize] as i64) == 1      // index 1
        && (ctx.body.code[4 as usize] as i64) == 0x7C  // i64.add
        && (ctx.body.code[5 as usize] as i64) == 0x21  // local.set
        && (ctx.body.code[6 as usize] as i64) == 2      // index 2
}

// Test 7: lowering IrReturn produces local.get + return
fn test_wasm_lower_return_val() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 3)

    let instr = ir_return(3)
    ctx = wasm_lower_return(ctx, instr)

    // Expected: local.get 0, return
    // Opcodes: 0x20 0x00 | 0x0F
    ctx.body.code_len == 3
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0 (first allocated)
        && (ctx.body.code[2 as usize] as i64) == 0x0F  // return
}

// Test 8: lowering a complete constant function
fn test_wasm_lower_const_function() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let func = wasm_lower_test_make_const_func()
    ctx = wasm_lower_function(ctx, func)

    // Body should have: local decls, i64.const 42, local.set, local.get, return, end
    ctx.body.code_len > 0 && ctx.body.local_count >= 0
}

// Test 9: lowering add function body is non-empty
fn test_wasm_lower_add_function() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let func = wasm_lower_test_make_add_func()
    ctx = wasm_lower_function(ctx, func)

    // 3 locals allocated (2 params + 1 result); body has instructions + end
    ctx.body.code_len > 4 && ctx.local_count == 3
}

// Test 10: lowering IrCopy produces correct bytecode
fn test_wasm_lower_copy_op() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 1)

    let instr = ir_copy(1, 0)
    ctx = wasm_lower_copy(ctx, instr)

    // Expected: local.get 0, local.set 1
    ctx.body.code_len == 4
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0
        && (ctx.body.code[2 as usize] as i64) == 0x21  // local.set
        && (ctx.body.code[3 as usize] as i64) == 1      // index 1
}

// Test 11: label open produces block opcode + blocktype
fn test_wasm_lower_label_open() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let instr = ir_label(7)
    ctx = wasm_lower_label(ctx, instr)

    // Expected: block(0x02) void(0x40)
    ctx.body.code_len == 2
        && (ctx.body.code[0 as usize] as i64) == 0x02  // block
        && (ctx.body.code[1 as usize] as i64) == 0x40  // void block type
        && ctx.label_depth == 1
}

// Test 12: end_block produces end opcode and pops label
fn test_wasm_lower_end_block() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_push_label(ctx, 10, WASM_LABEL_BLOCK)
    ctx = wasm_lower_end_block(ctx)

    ctx.body.code_len == 1
        && (ctx.body.code[0 as usize] as i64) == 0x0B  // end
        && ctx.label_depth == 0
}

// Test 13: lowering an IrBranchFalse emits i64.eqz + br_if
fn test_wasm_lower_branch_false_op() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_push_label(ctx, 5, WASM_LABEL_BLOCK)

    let instr = ir_branch_false(0, 5)
    ctx = wasm_lower_branch_false(ctx, instr)

    // Expected: local.get 0, i64.eqz, br_if 0
    // Opcodes: 0x20 0x00 | 0x50 | 0x0D 0x00
    ctx.body.code_len == 5
        && (ctx.body.code[0 as usize] as i64) == 0x20  // local.get
        && (ctx.body.code[1 as usize] as i64) == 0      // index 0
        && (ctx.body.code[2 as usize] as i64) == 0x50  // i64.eqz
        && (ctx.body.code[3 as usize] as i64) == 0x0D  // br_if
        && (ctx.body.code[4 as usize] as i64) == 0      // label depth 0
}

// Test 14: full module lowering produces valid WASM header
fn test_wasm_lower_module_header() -> bool with Mut, Panic, Div {
    var module = ir_empty_module()
    let func = wasm_lower_test_make_const_func()
    module.functions[0 as usize] = func
    module.fn_count = 1

    let result = wasm_lower_module(module)

    // Check WASM magic bytes at start of buffer
    result.buf.len > 8
        && wasm_buf_byte_at(result.buf, 0) == 0x00
        && wasm_buf_byte_at(result.buf, 1) == 0x61
        && wasm_buf_byte_at(result.buf, 2) == 0x73
        && wasm_buf_byte_at(result.buf, 3) == 0x6D
        && wasm_buf_byte_at(result.buf, 4) == 0x01
        && result.func_count == 1
        && result.error_count == 0
}

// Test 15: lowering compare (OpLt) produces i64.lt_s
fn test_wasm_lower_compare_lt() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    ctx = wasm_lower_alloc_local(ctx, 0)
    ctx = wasm_lower_alloc_local(ctx, 1)
    ctx = wasm_lower_alloc_local(ctx, 2)

    let instr = ir_binop(2, 0, BinaryOp::OpLt, 1)
    ctx = wasm_lower_binop(ctx, instr)

    // Expected: local.get 0, local.get 1, i64.lt_s, local.set 2
    // i64.lt_s = 0x53
    ctx.body.code_len == 7
        && (ctx.body.code[4 as usize] as i64) == 0x53  // i64.lt_s
}

// Test 16: prescan allocates locals for all used registers
fn test_wasm_lower_prescan() -> bool with Mut, Panic, Div {
    var ctx = wasm_lower_ctx_new()
    let func = wasm_lower_test_make_add_func()
    ctx = wasm_lower_prescan_locals(ctx, func)

    // 2 params (regs 0,1) + 1 extra (reg 2) = 3 locals
    ctx.local_count == 3
        && wasm_lower_get_local(ctx, 0) == 0
        && wasm_lower_get_local(ctx, 1) == 1
        && wasm_lower_get_local(ctx, 2) == 2
}

// ============================================================================
// Test runner
// ============================================================================

fn wasm_lower_run_tests() -> i64 with Mut, Panic, Div {
    var passed: i64 = 0
    var failed: i64 = 0

    if test_wasm_lower_ctx_init() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_alloc_locals() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_func_table() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_label_stack() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_load_imm() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_binop_add() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_return_val() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_const_function() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_add_function() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_copy_op() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_label_open() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_end_block() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_branch_false_op() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_module_header() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_compare_lt() { passed = passed + 1 } else { failed = failed + 1 }
    if test_wasm_lower_prescan() { passed = passed + 1 } else { failed = failed + 1 }

    print_int(passed)
    print_int(failed)

    if failed > 0 { 0 - 1 } else { passed }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/tensor/ops.sio  (1222 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::tensor::ops — Core Tensor Algebra Operations
//
// Implements dense tensor data structures and operations for the
// self-hosted compiler's tensor subsystem. Supports up to 8D tensors
// with a flat 4096-element backing store.
//
// ## Data Model
//
// TensorShape  — dimensions array + rank (up to 8D)
// DenseTensor  — shape + flat f64 data array
// TensorView   — offset into a tensor with custom strides
//
// ## Operations
//
// - Element-wise: add, sub, mul, scale, neg
// - Linear algebra: dot, matmul, transpose
// - Reductions: sum, max, min, norm, mean, sum_axis
// - Construction: zeros, ones, fill, eye, arange
// - Reshaping: reshape, flatten (via reshape)
//
// ## Indexing Convention
//
// Row-major (C-style) layout: last dimension varies fastest.
// For a 2D tensor of shape [M, N], element (i, j) is at index i*N + j.

// ============================================================================
// TensorShape — Up to 8D dimension descriptor
// ============================================================================

struct TensorShape {
    dims: [i64; 8],    // Dimension sizes
    ndim: i64,         // Number of active dimensions (0..8)
}

fn tensor_shape_new(d0: i64, d1: i64, d2: i64, d3: i64, d4: i64, d5: i64, d6: i64, d7: i64, ndim: i64) -> TensorShape {
    TensorShape {
        dims: [d0, d1, d2, d3, d4, d5, d6, d7],
        ndim: ndim,
    }
}

fn tensor_shape_1d(n: i64) -> TensorShape {
    tensor_shape_new(n, 0, 0, 0, 0, 0, 0, 0, 1)
}

fn tensor_shape_2d(m: i64, n: i64) -> TensorShape {
    tensor_shape_new(m, n, 0, 0, 0, 0, 0, 0, 2)
}

fn tensor_shape_3d(m: i64, n: i64, k: i64) -> TensorShape {
    tensor_shape_new(m, n, k, 0, 0, 0, 0, 0, 3)
}

fn tensor_shape_numel(shape: TensorShape) -> i64 with Mut, Panic, Div {
    if shape.ndim <= 0 { return 1 }
    var total: i64 = 1
    var i: i64 = 0
    while i < shape.ndim {
        total = total * shape.dims[i as usize]
        i = i + 1
    }
    total
}

fn tensor_shape_eq(a: TensorShape, b: TensorShape) -> bool with Mut, Panic, Div {
    if a.ndim != b.ndim { return false }
    var i: i64 = 0
    while i < a.ndim {
        if a.dims[i as usize] != b.dims[i as usize] { return false }
        i = i + 1
    }
    true
}

// Broadcasting: given shapes a and b, produce the broadcast shape.
// Rules (NumPy-style):
//   1. Align shapes from the right (trailing dimensions).
//   2. For each pair, if both equal -> keep; if one is 1 -> take the other;
//      else incompatible (return ndim=0 as error sentinel).
fn tensor_shape_broadcast(a: TensorShape, b: TensorShape) -> TensorShape with Mut, Panic, Div {
    // Result ndim is the maximum of the two
    var out_ndim = a.ndim
    if b.ndim > out_ndim { out_ndim = b.ndim }

    var out_dims: [i64; 8] = [0; 8]
    var i: i64 = 0
    while i < out_ndim {
        // Index from the right: a_idx = a.ndim - out_ndim + i
        let a_idx = a.ndim - out_ndim + i
        let b_idx = b.ndim - out_ndim + i

        var da: i64 = 1
        var db: i64 = 1
        if a_idx >= 0 { da = a.dims[a_idx as usize] }
        if b_idx >= 0 { db = b.dims[b_idx as usize] }

        if da == db {
            out_dims[i as usize] = da
        } else if da == 1 {
            out_dims[i as usize] = db
        } else if db == 1 {
            out_dims[i as usize] = da
        } else {
            // Incompatible — return sentinel with ndim=0
            return TensorShape { dims: [0; 8], ndim: 0 }
        }
        i = i + 1
    }

    TensorShape { dims: out_dims, ndim: out_ndim }
}

// ============================================================================
// DenseTensor — Flat storage up to 4096 elements
// ============================================================================

struct DenseTensor {
    shape: TensorShape,
    data: [f64; 4096],
    len: i64,           // Number of active elements (== numel)
}

// ============================================================================
// TensorView — Strided view into a DenseTensor
// ============================================================================

struct TensorView {
    offset: i64,           // Start offset in the backing tensor's data
    shape: TensorShape,
    strides: [i64; 8],     // Strides for each dimension (in elements)
}

// Compute row-major strides for a shape
fn compute_strides(shape: TensorShape) -> [i64; 8] with Mut, Panic, Div {
    var strides: [i64; 8] = [0; 8]
    if shape.ndim <= 0 { return strides }

    // Last dimension stride = 1, then multiply backwards
    strides[(shape.ndim - 1) as usize] = 1
    var i = shape.ndim - 2
    while i >= 0 {
        strides[i as usize] = strides[(i + 1) as usize] * shape.dims[(i + 1) as usize]
        i = i - 1
    }
    strides
}

fn tensor_view_new(offset: i64, shape: TensorShape) -> TensorView with Mut, Panic, Div {
    TensorView {
        offset: offset,
        shape: shape,
        strides: compute_strides(shape),
    }
}

// ============================================================================
// Tensor Constructors
// ============================================================================

fn tensor_zeros(shape: TensorShape) -> DenseTensor with Mut, Panic, Div {
    let n = tensor_shape_numel(shape)
    DenseTensor {
        shape: shape,
        data: [0.0; 4096],
        len: n,
    }
}

fn tensor_ones(shape: TensorShape) -> DenseTensor with Mut, Panic, Div {
    let n = tensor_shape_numel(shape)
    var t = DenseTensor {
        shape: shape,
        data: [0.0; 4096],
        len: n,
    }
    var i: i64 = 0
    while i < n {
        t.data[i as usize] = 1.0
        i = i + 1
    }
    t
}

fn tensor_fill(shape: TensorShape, val: f64) -> DenseTensor with Mut, Panic, Div {
    let n = tensor_shape_numel(shape)
    var t = DenseTensor {
        shape: shape,
        data: [0.0; 4096],
        len: n,
    }
    var i: i64 = 0
    while i < n {
        t.data[i as usize] = val
        i = i + 1
    }
    t
}

// Identity matrix of size n x n
fn tensor_eye(n: i64) -> DenseTensor with Mut, Panic, Div {
    let shape = tensor_shape_2d(n, n)
    var t = tensor_zeros(shape)
    var i: i64 = 0
    while i < n {
        let idx = i * n + i
        t.data[idx as usize] = 1.0
        i = i + 1
    }
    t
}

// Range tensor: [start, start+step, start+2*step, ...) while < end
fn tensor_arange(start: f64, end: f64, step: f64) -> DenseTensor with Mut, Panic, Div {
    // Count elements
    var count: i64 = 0
    var val = start
    if step > 0.0 {
        while val < end {
            count = count + 1
            val = val + step
        }
    } else if step < 0.0 {
        while val > end {
            count = count + 1
            val = val + step
        }
    }
    // step == 0 -> zero-length tensor

    if count > 4096 { count = 4096 }

    let shape = tensor_shape_1d(count)
    var t = DenseTensor {
        shape: shape,
        data: [0.0; 4096],
        len: count,
    }

    var i: i64 = 0
    val = start
    while i < count {
        t.data[i as usize] = val
        val = val + step
        i = i + 1
    }
    t
}

// ============================================================================
// Element Access — 1D
// ============================================================================

fn tensor_get_1d(t: DenseTensor, i: i64) -> f64 with Panic {
    t.data[i as usize]
}

fn tensor_set_1d(t: DenseTensor, i: i64, val: f64) -> DenseTensor with Mut, Panic {
    var out = t
    out.data[i as usize] = val
    out
}

// ============================================================================
// Element Access — 2D (row-major: index = i * cols + j)
// ============================================================================

fn tensor_get_2d(t: DenseTensor, i: i64, j: i64) -> f64 with Panic {
    let cols = t.shape.dims[1]
    let idx = i * cols + j
    t.data[idx as usize]
}

fn tensor_set_2d(t: DenseTensor, i: i64, j: i64, val: f64) -> DenseTensor with Mut, Panic {
    let cols = t.shape.dims[1]
    let idx = i * cols + j
    var out = t
    out.data[idx as usize] = val
    out
}

// ============================================================================
// Flat Index Computation (general N-D -> linear)
// ============================================================================

// Given shape and an index array (up to 8 indices), compute the linear offset.
// Uses row-major layout.
fn tensor_flat_index(shape: TensorShape, indices: [i64; 8]) -> i64 with Mut, Panic, Div {
    let strides = compute_strides(shape)
    var offset: i64 = 0
    var i: i64 = 0
    while i < shape.ndim {
        offset = offset + indices[i as usize] * strides[i as usize]
        i = i + 1
    }
    offset
}

// ============================================================================
// Element-wise Arithmetic
// ============================================================================

fn tensor_add(a: DenseTensor, b: DenseTensor) -> DenseTensor with Mut, Panic, Div {
    var out = tensor_zeros(a.shape)
    var i: i64 = 0
    while i < a.len {
        out.data[i as usize] = a.data[i as usize] + b.data[i as usize]
        i = i + 1
    }
    out
}

fn tensor_sub(a: DenseTensor, b: DenseTensor) -> DenseTensor with Mut, Panic, Div {
    var out = tensor_zeros(a.shape)
    var i: i64 = 0
    while i < a.len {
        out.data[i as usize] = a.data[i as usize] - b.data[i as usize]
        i = i + 1
    }
    out
}

fn tensor_mul_elementwise(a: DenseTensor, b: DenseTensor) -> DenseTensor with Mut, Panic, Div {
    var out = tensor_zeros(a.shape)
    var i: i64 = 0
    while i < a.len {
        out.data[i as usize] = a.data[i as usize] * b.data[i as usize]
        i = i + 1
    }
    out
}

fn tensor_scale(t: DenseTensor, scalar: f64) -> DenseTensor with Mut, Panic, Div {
    var out = tensor_zeros(t.shape)
    var i: i64 = 0
    while i < t.len {
        out.data[i as usize] = t.data[i as usize] * scalar
        i = i + 1
    }
    out
}

fn tensor_neg(t: DenseTensor) -> DenseTensor with Mut, Panic, Div {
    var out = tensor_zeros(t.shape)
    var i: i64 = 0
    while i < t.len {
        out.data[i as usize] = 0.0 - t.data[i as usize]
        i = i + 1
    }
    out
}

// ============================================================================
// Inner Product (1D dot product)
// ============================================================================

fn tensor_dot(a: DenseTensor, b: DenseTensor) -> f64 with Mut, Panic, Div {
    var sum: f64 = 0.0
    var i: i64 = 0
    let n = a.len
    while i < n {
        sum = sum + a.data[i as usize] * b.data[i as usize]
        i = i + 1
    }
    sum
}

// ============================================================================
// Matrix Multiply (2D x 2D -> 2D)
// ============================================================================
//
// C[i,j] = sum_k A[i,k] * B[k,j]
// A is [M, K], B is [K, N], result C is [M, N]

fn tensor_matmul(a: DenseTensor, b: DenseTensor) -> DenseTensor with Mut, Panic, Div {
    let m = a.shape.dims[0]
    let k = a.shape.dims[1]
    let n = b.shape.dims[1]

    let out_shape = tensor_shape_2d(m, n)
    var c = tensor_zeros(out_shape)

    var i: i64 = 0
    while i < m {
        var j: i64 = 0
        while j < n {
            var sum: f64 = 0.0
            var p: i64 = 0
            while p < k {
                let a_idx = i * k + p
                let b_idx = p * n + j
                sum = sum + a.data[a_idx as usize] * b.data[b_idx as usize]
                p = p + 1
            }
            let c_idx = i * n + j
            c.data[c_idx as usize] = sum
            j = j + 1
        }
        i = i + 1
    }
    c
}

// ============================================================================
// Transpose (2D)
// ============================================================================

fn tensor_transpose(t: DenseTensor) -> DenseTensor with Mut, Panic, Div {
    let rows = t.shape.dims[0]
    let cols = t.shape.dims[1]
    let out_shape = tensor_shape_2d(cols, rows)
    var out = tensor_zeros(out_shape)

    var i: i64 = 0
    while i < rows {
        var j: i64 = 0
        while j < cols {
            let src = i * cols + j
            let dst = j * rows + i
            out.data[dst as usize] = t.data[src as usize]
            j = j + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Reductions
// ============================================================================

fn tensor_sum(t: DenseTensor) -> f64 with Mut, Panic, Div {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < t.len {
        s = s + t.data[i as usize]
        i = i + 1
    }
    s
}

fn tensor_max(t: DenseTensor) -> f64 with Mut, Panic, Div {
    if t.len <= 0 { return 0.0 }
    var m = t.data[0]
    var i: i64 = 1
    while i < t.len {
        if t.data[i as usize] > m {
            m = t.data[i as usize]
        }
        i = i + 1
    }
    m
}

fn tensor_min(t: DenseTensor) -> f64 with Mut, Panic, Div {
    if t.len <= 0 { return 0.0 }
    var m = t.data[0]
    var i: i64 = 1
    while i < t.len {
        if t.data[i as usize] < m {
            m = t.data[i as usize]
        }
        i = i + 1
    }
    m
}

// Frobenius norm: sqrt(sum of squares)
// Uses Newton's method for integer-approximate sqrt since Sounio
// does not have a built-in sqrt.
fn approx_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    // Newton iteration: g_{n+1} = (g_n + x / g_n) / 2
    var g = x
    // Initial guess: halve until reasonable
    if g > 1.0 {
        while g * g > x * 4.0 {
            g = g / 2.0
        }
    } else {
        g = 1.0
    }
    // 20 iterations is more than enough for f64 precision
    var iter: i64 = 0
    while iter < 20 {
        g = (g + x / g) / 2.0
        iter = iter + 1
    }
    g
}

fn tensor_norm(t: DenseTensor) -> f64 with Mut, Panic, Div {
    var sum_sq: f64 = 0.0
    var i: i64 = 0
    while i < t.len {
        let v = t.data[i as usize]
        sum_sq = sum_sq + v * v
        i = i + 1
    }
    approx_sqrt(sum_sq)
}

// ============================================================================
// Reshape
// ============================================================================

fn tensor_reshape(t: DenseTensor, new_shape: TensorShape) -> DenseTensor with Mut, Panic, Div {
    // The total element count must match; caller is responsible.
    // We just copy data with the new shape.
    let new_len = tensor_shape_numel(new_shape)
    var out = DenseTensor {
        shape: new_shape,
        data: [0.0; 4096],
        len: new_len,
    }
    // Copy data up to the minimum of old and new lengths
    var n = t.len
    if new_len < n { n = new_len }
    var i: i64 = 0
    while i < n {
        out.data[i as usize] = t.data[i as usize]
        i = i + 1
    }
    out
}

// ============================================================================
// Axis Reduction: sum along a single axis
// ============================================================================
//
// For a tensor of shape [d0, d1, ..., d_{n-1}], summing along axis `ax`
// produces a tensor with that dimension removed.
//
// Strategy: decompose the flat index into (outer, ax_idx, inner) where
//   outer strides over dimensions 0..ax-1
//   ax_idx strides over dimension ax
//   inner strides over dimensions ax+1..ndim-1

fn tensor_sum_axis(t: DenseTensor, axis: i64) -> DenseTensor with Mut, Panic, Div {
    let ndim = t.shape.ndim

    // Compute outer_size = product of dims before axis
    var outer_size: i64 = 1
    var d: i64 = 0
    while d < axis {
        outer_size = outer_size * t.shape.dims[d as usize]
        d = d + 1
    }

    let ax_size = t.shape.dims[axis as usize]

    // Compute inner_size = product of dims after axis
    var inner_size: i64 = 1
    d = axis + 1
    while d < ndim {
        inner_size = inner_size * t.shape.dims[d as usize]
        d = d + 1
    }

    // Build output shape: remove the axis dimension
    var out_dims: [i64; 8] = [0; 8]
    var out_ndim: i64 = 0
    d = 0
    while d < ndim {
        if d != axis {
            out_dims[out_ndim as usize] = t.shape.dims[d as usize]
            out_ndim = out_ndim + 1
        }
        d = d + 1
    }
    // Handle scalar result (all dims collapsed)
    if out_ndim == 0 {
        out_ndim = 1
        out_dims[0] = 1
    }

    let out_shape = TensorShape { dims: out_dims, ndim: out_ndim }
    var out = tensor_zeros(out_shape)

    // Accumulate
    var o: i64 = 0
    while o < outer_size {
        var inn: i64 = 0
        while inn < inner_size {
            var sum: f64 = 0.0
            var a: i64 = 0
            while a < ax_size {
                let src_idx = (o * ax_size + a) * inner_size + inn
                sum = sum + t.data[src_idx as usize]
                a = a + 1
            }
            let dst_idx = o * inner_size + inn
            out.data[dst_idx as usize] = sum
            inn = inn + 1
        }
        o = o + 1
    }

    out
}

// Mean over all elements
fn tensor_mean(t: DenseTensor) -> f64 with Mut, Panic, Div {
    if t.len <= 0 { return 0.0 }
    let s = tensor_sum(t)
    s / (t.len as f64)
}

// ============================================================================
// Approximate equality helper (for tests)
// ============================================================================

fn tops_approx_eq(a: f64, b: f64, eps: f64) -> bool {
    let diff = if a > b { a - b } else { b - a }
    diff < eps
}

// ============================================================================
// Tests
// ============================================================================

// T01: Shape constructors and numel
fn test_shape_basics() -> i64 with Mut, Panic, Div {
    let s1 = tensor_shape_1d(10)
    if s1.ndim != 1 { return 1 }
    if s1.dims[0] != 10 { return 2 }
    if tensor_shape_numel(s1) != 10 { return 3 }

    let s2 = tensor_shape_2d(3, 4)
    if s2.ndim != 2 { return 4 }
    if tensor_shape_numel(s2) != 12 { return 5 }

    let s3 = tensor_shape_3d(2, 3, 4)
    if s3.ndim != 3 { return 6 }
    if tensor_shape_numel(s3) != 24 { return 7 }

    0
}

// T02: Shape equality
fn test_shape_eq() -> i64 with Mut, Panic, Div {
    let a = tensor_shape_2d(3, 4)
    let b = tensor_shape_2d(3, 4)
    let c = tensor_shape_2d(4, 3)

    if !tensor_shape_eq(a, b) { return 1 }
    if tensor_shape_eq(a, c) { return 2 }

    // Different ndim
    let d = tensor_shape_1d(12)
    if tensor_shape_eq(a, d) { return 3 }

    0
}

// T03: Broadcasting rules
fn test_shape_broadcast() -> i64 with Mut, Panic, Div {
    // [3, 1] + [1, 4] -> [3, 4]
    let a = tensor_shape_2d(3, 1)
    let b = tensor_shape_2d(1, 4)
    let c = tensor_shape_broadcast(a, b)
    if c.ndim != 2 { return 1 }
    if c.dims[0] != 3 { return 2 }
    if c.dims[1] != 4 { return 3 }

    // [5] + [3, 5] -> [3, 5]  (different ndim)
    let d = tensor_shape_1d(5)
    let e = tensor_shape_2d(3, 5)
    let f = tensor_shape_broadcast(d, e)
    if f.ndim != 2 { return 4 }
    if f.dims[0] != 3 { return 5 }
    if f.dims[1] != 5 { return 6 }

    // Incompatible: [3] + [4] -> ndim=0 (error)
    let g = tensor_shape_1d(3)
    let h = tensor_shape_1d(4)
    let r = tensor_shape_broadcast(g, h)
    if r.ndim != 0 { return 7 }

    0
}

// T04: Tensor zeros, ones, fill
fn test_constructors() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(5)

    let z = tensor_zeros(shape)
    if z.len != 5 { return 1 }
    if z.data[0] != 0.0 { return 2 }
    if z.data[4] != 0.0 { return 3 }

    let o = tensor_ones(shape)
    if o.data[0] != 1.0 { return 4 }
    if o.data[4] != 1.0 { return 5 }

    let f = tensor_fill(shape, 3.14)
    if !tops_approx_eq(f.data[0], 3.14, 0.001) { return 6 }
    if !tops_approx_eq(f.data[4], 3.14, 0.001) { return 7 }

    0
}

// T05: Identity matrix
fn test_eye() -> i64 with Mut, Panic, Div {
    let eye3 = tensor_eye(3)
    if eye3.shape.ndim != 2 { return 1 }
    if eye3.shape.dims[0] != 3 { return 2 }
    if eye3.len != 9 { return 3 }

    // Diagonal elements should be 1
    if tensor_get_2d(eye3, 0, 0) != 1.0 { return 4 }
    if tensor_get_2d(eye3, 1, 1) != 1.0 { return 5 }
    if tensor_get_2d(eye3, 2, 2) != 1.0 { return 6 }

    // Off-diagonal should be 0
    if tensor_get_2d(eye3, 0, 1) != 0.0 { return 7 }
    if tensor_get_2d(eye3, 1, 0) != 0.0 { return 8 }

    0
}

// T06: arange
fn test_arange() -> i64 with Mut, Panic, Div {
    let t = tensor_arange(0.0, 5.0, 1.0)
    if t.len != 5 { return 1 }
    if !tops_approx_eq(t.data[0], 0.0, 0.001) { return 2 }
    if !tops_approx_eq(t.data[4], 4.0, 0.001) { return 3 }

    // Fractional step
    let t2 = tensor_arange(0.0, 1.0, 0.25)
    if t2.len != 4 { return 4 }
    if !tops_approx_eq(t2.data[0], 0.0, 0.001) { return 5 }
    if !tops_approx_eq(t2.data[3], 0.75, 0.001) { return 6 }

    0
}

// T07: 1D get/set
fn test_get_set_1d() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(4)
    var t = tensor_zeros(shape)

    t = tensor_set_1d(t, 0, 10.0)
    t = tensor_set_1d(t, 3, 40.0)

    if tensor_get_1d(t, 0) != 10.0 { return 1 }
    if tensor_get_1d(t, 1) != 0.0 { return 2 }
    if tensor_get_1d(t, 3) != 40.0 { return 3 }

    0
}

// T08: 2D get/set
fn test_get_set_2d() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_2d(2, 3)
    var t = tensor_zeros(shape)

    t = tensor_set_2d(t, 0, 0, 1.0)
    t = tensor_set_2d(t, 0, 2, 3.0)
    t = tensor_set_2d(t, 1, 1, 5.0)

    if tensor_get_2d(t, 0, 0) != 1.0 { return 1 }
    if tensor_get_2d(t, 0, 2) != 3.0 { return 2 }
    if tensor_get_2d(t, 1, 1) != 5.0 { return 3 }
    if tensor_get_2d(t, 1, 0) != 0.0 { return 4 }

    0
}

// T09: flat_index for 3D tensor
fn test_flat_index() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_3d(2, 3, 4)
    // For [2,3,4] row-major: strides = [12, 4, 1]
    // index(1, 2, 3) = 1*12 + 2*4 + 3 = 23

    var idx: [i64; 8] = [0; 8]
    idx[0] = 1
    idx[1] = 2
    idx[2] = 3

    let flat = tensor_flat_index(shape, idx)
    if flat != 23 { return 1 }

    // index(0, 0, 0) = 0
    var idx0: [i64; 8] = [0; 8]
    let flat0 = tensor_flat_index(shape, idx0)
    if flat0 != 0 { return 2 }

    0
}

// T10: Element-wise add, sub, mul
fn test_elementwise_ops() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(4)
    let a = tensor_fill(shape, 2.0)
    let b = tensor_fill(shape, 3.0)

    let sum_t = tensor_add(a, b)
    if !tops_approx_eq(sum_t.data[0], 5.0, 0.001) { return 1 }

    let diff = tensor_sub(a, b)
    // 2.0 - 3.0 = -1.0
    if !tops_approx_eq(diff.data[0], 0.0 - 1.0, 0.001) { return 2 }

    let prod = tensor_mul_elementwise(a, b)
    if !tops_approx_eq(prod.data[0], 6.0, 0.001) { return 3 }

    0
}

// T11: Scale and negate
fn test_scale_neg() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(3)
    var t = tensor_zeros(shape)
    t = tensor_set_1d(t, 0, 1.0)
    t = tensor_set_1d(t, 1, 2.0)
    t = tensor_set_1d(t, 2, 3.0)

    let scaled = tensor_scale(t, 10.0)
    if !tops_approx_eq(scaled.data[0], 10.0, 0.001) { return 1 }
    if !tops_approx_eq(scaled.data[2], 30.0, 0.001) { return 2 }

    let neg = tensor_neg(t)
    if !tops_approx_eq(neg.data[0], 0.0 - 1.0, 0.001) { return 3 }
    if !tops_approx_eq(neg.data[2], 0.0 - 3.0, 0.001) { return 4 }

    0
}

// T12: Dot product
fn test_dot_product() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(3)
    var a = tensor_zeros(shape)
    a = tensor_set_1d(a, 0, 1.0)
    a = tensor_set_1d(a, 1, 2.0)
    a = tensor_set_1d(a, 2, 3.0)

    var b = tensor_zeros(shape)
    b = tensor_set_1d(b, 0, 4.0)
    b = tensor_set_1d(b, 1, 5.0)
    b = tensor_set_1d(b, 2, 6.0)

    // dot = 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32
    let d = tensor_dot(a, b)
    if !tops_approx_eq(d, 32.0, 0.001) { return 1 }

    // Dot of a vector with itself = sum of squares
    // 1 + 4 + 9 = 14
    let d_self = tensor_dot(a, a)
    if !tops_approx_eq(d_self, 14.0, 0.001) { return 2 }

    0
}

// T13: Matrix multiply
fn test_matmul() -> i64 with Mut, Panic, Div {
    // A = [[1, 2], [3, 4]]  (2x2)
    // B = [[5, 6], [7, 8]]  (2x2)
    // C = A * B = [[1*5+2*7, 1*6+2*8], [3*5+4*7, 3*6+4*8]]
    //           = [[19, 22], [43, 50]]

    let shape = tensor_shape_2d(2, 2)
    var a = tensor_zeros(shape)
    a = tensor_set_2d(a, 0, 0, 1.0)
    a = tensor_set_2d(a, 0, 1, 2.0)
    a = tensor_set_2d(a, 1, 0, 3.0)
    a = tensor_set_2d(a, 1, 1, 4.0)

    var b = tensor_zeros(shape)
    b = tensor_set_2d(b, 0, 0, 5.0)
    b = tensor_set_2d(b, 0, 1, 6.0)
    b = tensor_set_2d(b, 1, 0, 7.0)
    b = tensor_set_2d(b, 1, 1, 8.0)

    let c = tensor_matmul(a, b)
    if !tops_approx_eq(tensor_get_2d(c, 0, 0), 19.0, 0.001) { return 1 }
    if !tops_approx_eq(tensor_get_2d(c, 0, 1), 22.0, 0.001) { return 2 }
    if !tops_approx_eq(tensor_get_2d(c, 1, 0), 43.0, 0.001) { return 3 }
    if !tops_approx_eq(tensor_get_2d(c, 1, 1), 50.0, 0.001) { return 4 }

    0
}

// T14: Transpose
fn test_transpose() -> i64 with Mut, Panic, Div {
    // A = [[1, 2, 3], [4, 5, 6]]  (2x3)
    // A^T = [[1, 4], [2, 5], [3, 6]]  (3x2)
    let shape = tensor_shape_2d(2, 3)
    var a = tensor_zeros(shape)
    a = tensor_set_2d(a, 0, 0, 1.0)
    a = tensor_set_2d(a, 0, 1, 2.0)
    a = tensor_set_2d(a, 0, 2, 3.0)
    a = tensor_set_2d(a, 1, 0, 4.0)
    a = tensor_set_2d(a, 1, 1, 5.0)
    a = tensor_set_2d(a, 1, 2, 6.0)

    let at = tensor_transpose(a)
    if at.shape.dims[0] != 3 { return 1 }
    if at.shape.dims[1] != 2 { return 2 }

    if !tops_approx_eq(tensor_get_2d(at, 0, 0), 1.0, 0.001) { return 3 }
    if !tops_approx_eq(tensor_get_2d(at, 0, 1), 4.0, 0.001) { return 4 }
    if !tops_approx_eq(tensor_get_2d(at, 1, 0), 2.0, 0.001) { return 5 }
    if !tops_approx_eq(tensor_get_2d(at, 2, 1), 6.0, 0.001) { return 6 }

    // Double transpose should recover original
    let att = tensor_transpose(at)
    if !tops_approx_eq(tensor_get_2d(att, 0, 0), 1.0, 0.001) { return 7 }
    if !tops_approx_eq(tensor_get_2d(att, 1, 2), 6.0, 0.001) { return 8 }

    0
}

// T15: Reductions — sum, max, min
fn test_reductions() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(5)
    var t = tensor_zeros(shape)
    // [10, 20, 5, 30, 15]
    t = tensor_set_1d(t, 0, 10.0)
    t = tensor_set_1d(t, 1, 20.0)
    t = tensor_set_1d(t, 2, 5.0)
    t = tensor_set_1d(t, 3, 30.0)
    t = tensor_set_1d(t, 4, 15.0)

    let s = tensor_sum(t)
    if !tops_approx_eq(s, 80.0, 0.001) { return 1 }

    let mx = tensor_max(t)
    if !tops_approx_eq(mx, 30.0, 0.001) { return 2 }

    let mn = tensor_min(t)
    if !tops_approx_eq(mn, 5.0, 0.001) { return 3 }

    0
}

// T16: Norm (Frobenius)
fn test_norm() -> i64 with Mut, Panic, Div {
    // [3, 4] -> norm = sqrt(9 + 16) = sqrt(25) = 5
    let shape = tensor_shape_1d(2)
    var t = tensor_zeros(shape)
    t = tensor_set_1d(t, 0, 3.0)
    t = tensor_set_1d(t, 1, 4.0)

    let n = tensor_norm(t)
    if !tops_approx_eq(n, 5.0, 0.001) { return 1 }

    // Zero tensor norm should be 0
    let z = tensor_zeros(shape)
    let nz = tensor_norm(z)
    if !tops_approx_eq(nz, 0.0, 0.001) { return 2 }

    0
}

// T17: Reshape
fn test_reshape() -> i64 with Mut, Panic, Div {
    // Create a [2, 3] tensor with data 1..6
    let shape = tensor_shape_2d(2, 3)
    var t = tensor_zeros(shape)
    t = tensor_set_2d(t, 0, 0, 1.0)
    t = tensor_set_2d(t, 0, 1, 2.0)
    t = tensor_set_2d(t, 0, 2, 3.0)
    t = tensor_set_2d(t, 1, 0, 4.0)
    t = tensor_set_2d(t, 1, 1, 5.0)
    t = tensor_set_2d(t, 1, 2, 6.0)

    // Reshape to [3, 2]
    let new_shape = tensor_shape_2d(3, 2)
    let r = tensor_reshape(t, new_shape)

    if r.shape.dims[0] != 3 { return 1 }
    if r.shape.dims[1] != 2 { return 2 }
    if r.len != 6 { return 3 }

    // Data should be preserved in flat order
    if !tops_approx_eq(r.data[0], 1.0, 0.001) { return 4 }
    if !tops_approx_eq(r.data[5], 6.0, 0.001) { return 5 }

    // Reshape to 1D [6]
    let flat_shape = tensor_shape_1d(6)
    let flat = tensor_reshape(t, flat_shape)
    if flat.len != 6 { return 6 }
    if !tops_approx_eq(flat.data[3], 4.0, 0.001) { return 7 }

    0
}

// T18: Sum along axis
fn test_sum_axis() -> i64 with Mut, Panic, Div {
    // A = [[1, 2, 3], [4, 5, 6]]  shape [2, 3]
    // sum(axis=0) = [5, 7, 9]     shape [3]
    // sum(axis=1) = [6, 15]       shape [2]
    let shape = tensor_shape_2d(2, 3)
    var t = tensor_zeros(shape)
    t = tensor_set_2d(t, 0, 0, 1.0)
    t = tensor_set_2d(t, 0, 1, 2.0)
    t = tensor_set_2d(t, 0, 2, 3.0)
    t = tensor_set_2d(t, 1, 0, 4.0)
    t = tensor_set_2d(t, 1, 1, 5.0)
    t = tensor_set_2d(t, 1, 2, 6.0)

    // Sum along axis 0 (collapse rows)
    let s0 = tensor_sum_axis(t, 0)
    if s0.shape.ndim != 1 { return 1 }
    if s0.shape.dims[0] != 3 { return 2 }
    if !tops_approx_eq(s0.data[0], 5.0, 0.001) { return 3 }
    if !tops_approx_eq(s0.data[1], 7.0, 0.001) { return 4 }
    if !tops_approx_eq(s0.data[2], 9.0, 0.001) { return 5 }

    // Sum along axis 1 (collapse columns)
    let s1 = tensor_sum_axis(t, 1)
    if s1.shape.ndim != 1 { return 6 }
    if s1.shape.dims[0] != 2 { return 7 }
    if !tops_approx_eq(s1.data[0], 6.0, 0.001) { return 8 }
    if !tops_approx_eq(s1.data[1], 15.0, 0.001) { return 9 }

    0
}

// T19: Mean
fn test_mean() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(4)
    var t = tensor_zeros(shape)
    // [2, 4, 6, 8] -> mean = 20/4 = 5.0
    t = tensor_set_1d(t, 0, 2.0)
    t = tensor_set_1d(t, 1, 4.0)
    t = tensor_set_1d(t, 2, 6.0)
    t = tensor_set_1d(t, 3, 8.0)

    let m = tensor_mean(t)
    if !tops_approx_eq(m, 5.0, 0.001) { return 1 }

    0
}

// T20: Matmul with identity produces same matrix
fn test_matmul_identity() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_2d(3, 3)
    var a = tensor_zeros(shape)
    a = tensor_set_2d(a, 0, 0, 1.0)
    a = tensor_set_2d(a, 0, 1, 2.0)
    a = tensor_set_2d(a, 0, 2, 3.0)
    a = tensor_set_2d(a, 1, 0, 4.0)
    a = tensor_set_2d(a, 1, 1, 5.0)
    a = tensor_set_2d(a, 1, 2, 6.0)
    a = tensor_set_2d(a, 2, 0, 7.0)
    a = tensor_set_2d(a, 2, 1, 8.0)
    a = tensor_set_2d(a, 2, 2, 9.0)

    let eye = tensor_eye(3)
    let ai = tensor_matmul(a, eye)

    // A * I = A
    if !tops_approx_eq(tensor_get_2d(ai, 0, 0), 1.0, 0.001) { return 1 }
    if !tops_approx_eq(tensor_get_2d(ai, 0, 2), 3.0, 0.001) { return 2 }
    if !tops_approx_eq(tensor_get_2d(ai, 1, 1), 5.0, 0.001) { return 3 }
    if !tops_approx_eq(tensor_get_2d(ai, 2, 0), 7.0, 0.001) { return 4 }
    if !tops_approx_eq(tensor_get_2d(ai, 2, 2), 9.0, 0.001) { return 5 }

    0
}

// T21: Non-square matmul dimensions
fn test_matmul_nonsquare() -> i64 with Mut, Panic, Div {
    // A = [1x3], B = [3x1]  -> C = [1x1] (scalar-like)
    let shape_a = tensor_shape_2d(1, 3)
    var a = tensor_zeros(shape_a)
    a = tensor_set_2d(a, 0, 0, 1.0)
    a = tensor_set_2d(a, 0, 1, 2.0)
    a = tensor_set_2d(a, 0, 2, 3.0)

    let shape_b = tensor_shape_2d(3, 1)
    var b = tensor_zeros(shape_b)
    b = tensor_set_2d(b, 0, 0, 4.0)
    b = tensor_set_2d(b, 1, 0, 5.0)
    b = tensor_set_2d(b, 2, 0, 6.0)

    let c = tensor_matmul(a, b)
    // 1*4 + 2*5 + 3*6 = 32
    if c.shape.dims[0] != 1 { return 1 }
    if c.shape.dims[1] != 1 { return 2 }
    if !tops_approx_eq(tensor_get_2d(c, 0, 0), 32.0, 0.001) { return 3 }

    0
}

// T22: Strides computation
fn test_strides() -> i64 with Mut, Panic, Div {
    // [2, 3, 4] -> strides = [12, 4, 1]
    let s = tensor_shape_3d(2, 3, 4)
    let strides = compute_strides(s)
    if strides[0] != 12 { return 1 }
    if strides[1] != 4 { return 2 }
    if strides[2] != 1 { return 3 }

    // [5, 10] -> strides = [10, 1]
    let s2 = tensor_shape_2d(5, 10)
    let strides2 = compute_strides(s2)
    if strides2[0] != 10 { return 4 }
    if strides2[1] != 1 { return 5 }

    0
}

// T23: approx_sqrt correctness
fn test_approx_sqrt() -> i64 with Mut, Panic, Div {
    // sqrt(4) = 2
    if !tops_approx_eq(approx_sqrt(4.0), 2.0, 0.0001) { return 1 }

    // sqrt(9) = 3
    if !tops_approx_eq(approx_sqrt(9.0), 3.0, 0.0001) { return 2 }

    // sqrt(2) ≈ 1.41421
    if !tops_approx_eq(approx_sqrt(2.0), 1.41421, 0.001) { return 3 }

    // sqrt(0) = 0
    if !tops_approx_eq(approx_sqrt(0.0), 0.0, 0.0001) { return 4 }

    // sqrt(100) = 10
    if !tops_approx_eq(approx_sqrt(100.0), 10.0, 0.0001) { return 5 }

    0
}

// T24: Tensor add/sub inverse
fn test_add_sub_inverse() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_1d(4)
    var a = tensor_zeros(shape)
    a = tensor_set_1d(a, 0, 1.0)
    a = tensor_set_1d(a, 1, 2.0)
    a = tensor_set_1d(a, 2, 3.0)
    a = tensor_set_1d(a, 3, 4.0)

    var b = tensor_zeros(shape)
    b = tensor_set_1d(b, 0, 10.0)
    b = tensor_set_1d(b, 1, 20.0)
    b = tensor_set_1d(b, 2, 30.0)
    b = tensor_set_1d(b, 3, 40.0)

    // (a + b) - b = a
    let sum_t = tensor_add(a, b)
    let diff = tensor_sub(sum_t, b)
    if !tops_approx_eq(diff.data[0], 1.0, 0.001) { return 1 }
    if !tops_approx_eq(diff.data[3], 4.0, 0.001) { return 2 }

    0
}

// T25: TensorView creation
fn test_tensor_view() -> i64 with Mut, Panic, Div {
    let shape = tensor_shape_2d(4, 5)
    let view = tensor_view_new(10, shape)

    if view.offset != 10 { return 1 }
    if view.strides[0] != 5 { return 2 }
    if view.strides[1] != 1 { return 3 }

    0
}

// ============================================================================
// Test Runner
// ============================================================================

fn tensor_ops_run_tests() -> i64 with Mut, Panic, Div {
    var passed: i64 = 0
    var failed: i64 = 0

    // T01
    if test_shape_basics() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T02
    if test_shape_eq() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T03
    if test_shape_broadcast() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T04
    if test_constructors() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T05
    if test_eye() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T06
    if test_arange() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T07
    if test_get_set_1d() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T08
    if test_get_set_2d() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T09
    if test_flat_index() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T10
    if test_elementwise_ops() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T11
    if test_scale_neg() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T12
    if test_dot_product() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T13
    if test_matmul() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T14
    if test_transpose() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T15
    if test_reductions() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T16
    if test_norm() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T17
    if test_reshape() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T18
    if test_sum_axis() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T19
    if test_mean() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T20
    if test_matmul_identity() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T21
    if test_matmul_nonsquare() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T22
    if test_strides() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T23
    if test_approx_sqrt() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T24
    if test_add_sub_inverse() == 0 { passed = passed + 1 } else { failed = failed + 1 }
    // T25
    if test_tensor_view() == 0 { passed = passed + 1 } else { failed = failed + 1 }

    // Return 0 if all passed, else number of failures
    failed
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/linker/elf_writer.sio  (1237 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::linker::elf_writer — ELF64 binary writer/linker
//
// Produces complete ELF64 executables from assembled sections. Supports
// x86-64, AArch64 and RISC-V targets. This is the high-level counterpart
// to native::elf which handles raw byte emission; elf_writer manages
// sections, segments, symbol tables and the complete layout pipeline.
//
// ## Architecture
//
//   ElfWriter
//     +-- sections: [ElfSection; 32]   (text, data, bss, strtab, symtab, ...)
//     +-- segments: [Elf64Phdr; 8]     (PT_LOAD for text/data/bss)
//     +-- header:   Elf64Header
//     +-- strtab:   ElfBuf             (section-name string table)
//
//   elf_writer_new(machine, entry)
//     -> elf_writer_add_text_section(code, len)
//     -> elf_writer_add_data_section(data, len)
//     -> elf_writer_add_bss_section(size)
//     -> elf_writer_finalize()          => ElfBuf with complete ELF binary
//
// ## Usage
//
// ```sio
// var w = elf_writer_new(EM_X86_64, 0x401000)
// w = elf_writer_add_text_section(w, code_bytes, code_len)
// w = elf_writer_add_data_section(w, data_bytes, data_len)
// let elf = elf_writer_finalize(w)
// // elf.data[0..elf.len] is a valid ELF64 executable
// ```

// ============================================================================
// ELF64 Constants
// ============================================================================

// Object file type
fn ELF_ET_EXEC() -> i64 { 2 }

// Machine architectures
fn ELF_EM_X86_64() -> i64 { 62 }
fn ELF_EM_AARCH64() -> i64 { 183 }
fn ELF_EM_RISCV() -> i64 { 243 }

// Segment types
fn ELF_PT_LOAD() -> i64 { 1 }
fn ELF_PT_NOTE() -> i64 { 4 }

// Section header types
fn ELF_SHT_NULL() -> i64 { 0 }
fn ELF_SHT_PROGBITS() -> i64 { 1 }
fn ELF_SHT_SYMTAB() -> i64 { 2 }
fn ELF_SHT_STRTAB() -> i64 { 3 }
fn ELF_SHT_RELA() -> i64 { 4 }
fn ELF_SHT_NOBITS() -> i64 { 8 }

// Section header flags
fn ELF_SHF_WRITE() -> i64 { 1 }
fn ELF_SHF_ALLOC() -> i64 { 2 }
fn ELF_SHF_EXECINSTR() -> i64 { 4 }

// Symbol binding and type
fn ELF_STB_LOCAL() -> i64 { 0 }
fn ELF_STB_GLOBAL() -> i64 { 1 }
fn ELF_STT_OBJECT() -> i64 { 1 }
fn ELF_STT_FUNC() -> i64 { 2 }

// Segment permission flags
fn ELF_PF_X() -> i64 { 1 }
fn ELF_PF_W() -> i64 { 2 }
fn ELF_PF_R() -> i64 { 4 }

// ELF ident bytes
fn ELF_MAGIC_0() -> i64 { 0x7f }
fn ELF_MAGIC_1() -> i64 { 0x45 }  // 'E'
fn ELF_MAGIC_2() -> i64 { 0x4c }  // 'L'
fn ELF_MAGIC_3() -> i64 { 0x46 }  // 'F'
fn ELF_CLASS64() -> i64 { 2 }
fn ELF_DATA_LSB() -> i64 { 1 }
fn ELF_EV_CURRENT() -> i64 { 1 }
fn ELF_OSABI_SYSV() -> i64 { 0 }

// Fixed sizes
fn ELF64_EHDR_SIZE() -> i64 { 64 }
fn ELF64_PHDR_SIZE() -> i64 { 56 }
fn ELF64_SHDR_SIZE() -> i64 { 64 }
fn ELF64_SYM_SIZE() -> i64 { 24 }

// Default base address for executables
fn ELF_DEFAULT_BASE() -> i64 { 0x400000 }

// Page alignment
fn ELF_PAGE_SIZE() -> i64 { 4096 }

// ============================================================================
// Structures
// ============================================================================

// Byte buffer for ELF output (256KB max)
struct ElfBuf {
    data: [i8; 262144],
    len: i64,
}

// ELF64 file header
struct Elf64Header {
    e_type: i64,
    e_machine: i64,
    e_entry: i64,
    e_phoff: i64,
    e_shoff: i64,
    e_phentsize: i64,
    e_phnum: i64,
    e_shentsize: i64,
    e_shnum: i64,
    e_shstrndx: i64,
}

// ELF64 program header (segment)
struct Elf64Phdr {
    p_type: i64,
    p_flags: i64,
    p_offset: i64,
    p_vaddr: i64,
    p_paddr: i64,
    p_filesz: i64,
    p_memsz: i64,
    p_align: i64,
}

// ELF64 section header
struct Elf64Shdr {
    sh_name: i64,
    sh_type: i64,
    sh_flags: i64,
    sh_addr: i64,
    sh_offset: i64,
    sh_size: i64,
    sh_link: i64,
    sh_info: i64,
    sh_addralign: i64,
    sh_entsize: i64,
}

// Section descriptor (tracks a section during layout)
struct ElfSection {
    name_offset: i64,
    shdr: Elf64Shdr,
    data_offset: i64,
    data_len: i64,
}

// ELF64 symbol table entry
struct ElfSymbol {
    st_name: i64,
    st_info: i64,
    st_other: i64,
    st_shndx: i64,
    st_value: i64,
    st_size: i64,
}

// High-level ELF writer
struct ElfWriter {
    header: Elf64Header,
    sections: [ElfSection; 32],
    section_count: i64,
    segments: [Elf64Phdr; 8],
    segment_count: i64,
    strtab: ElfBuf,
    section_data: ElfBuf,
    base_addr: i64,
}

// ============================================================================
// Byte-extraction helper
// ============================================================================

fn elf_low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

// ============================================================================
// Buffer operations
// ============================================================================

fn elf_buf_new() -> ElfBuf {
    ElfBuf { data: [0; 262144], len: 0 }
}

fn elf_buf_emit_byte(buf: ElfBuf, b: i64) -> ElfBuf with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 && out.len < 262144 {
        out.data[out.len as usize] = elf_low8(b) as i8
        out.len = out.len + 1
    }
    out
}

fn elf_buf_emit_le16(buf: ElfBuf, val: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    b = elf_buf_emit_byte(b, elf_low8(val))
    b = elf_buf_emit_byte(b, elf_low8(val >> 8))
    b
}

fn elf_buf_emit_le32(buf: ElfBuf, val: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    b = elf_buf_emit_byte(b, elf_low8(val))
    b = elf_buf_emit_byte(b, elf_low8(val >> 8))
    b = elf_buf_emit_byte(b, elf_low8(val >> 16))
    b = elf_buf_emit_byte(b, elf_low8(val >> 24))
    b
}

fn elf_buf_emit_le64(buf: ElfBuf, val: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    b = elf_buf_emit_le32(b, val)
    b = elf_buf_emit_le32(b, val >> 32)
    b
}

// Emit bytes from a source array into the buffer
fn elf_buf_emit_bytes(buf: ElfBuf, src: [i8; 262144], src_len: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < src_len && b.len < 262144 {
        b.data[b.len as usize] = src[i as usize]
        b.len = b.len + 1
        i = i + 1
    }
    b
}

// Emit a slice from a source array (from offset, for count bytes)
fn elf_buf_emit_slice(buf: ElfBuf, src: [i8; 262144], offset: i64, count: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < count && b.len < 262144 {
        b.data[b.len as usize] = src[(offset + i) as usize]
        b.len = b.len + 1
        i = i + 1
    }
    b
}

// Pad the buffer with zeroes until it reaches the given alignment
fn elf_buf_pad_to_alignment(buf: ElfBuf, alignment: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    if alignment <= 0 {
        return b
    }
    var remainder = b.len % alignment
    if remainder < 0 { remainder = remainder + alignment }
    if remainder != 0 {
        var pad = alignment - remainder
        while pad > 0 && b.len < 262144 {
            b.data[b.len as usize] = 0
            b.len = b.len + 1
            pad = pad - 1
        }
    }
    b
}

// Pad buffer to an absolute offset (filling with zeroes)
fn elf_buf_pad_to_offset(buf: ElfBuf, target: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    while b.len < target && b.len < 262144 {
        b.data[b.len as usize] = 0
        b.len = b.len + 1
    }
    b
}

// Read a byte from the buffer at position
fn elf_buf_read_byte(buf: ElfBuf, pos: i64) -> i64 with Mut, Panic {
    if pos >= 0 && pos < buf.len {
        buf.data[pos as usize] as i64
    } else {
        0
    }
}

// Patch a little-endian 32-bit value at a given offset
fn elf_buf_patch_le32(buf: ElfBuf, offset: i64, val: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    if offset >= 0 && offset + 4 <= b.len {
        b.data[offset as usize] = elf_low8(val) as i8
        b.data[(offset + 1) as usize] = elf_low8(val >> 8) as i8
        b.data[(offset + 2) as usize] = elf_low8(val >> 16) as i8
        b.data[(offset + 3) as usize] = elf_low8(val >> 24) as i8
    }
    b
}

// Patch a little-endian 64-bit value at a given offset
fn elf_buf_patch_le64(buf: ElfBuf, offset: i64, val: i64) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    b = elf_buf_patch_le32(b, offset, val)
    b = elf_buf_patch_le32(b, offset + 4, val >> 32)
    b
}

// ============================================================================
// Constructor helpers
// ============================================================================

fn elf64_header_new(machine: i64, entry: i64) -> Elf64Header {
    Elf64Header {
        e_type: ELF_ET_EXEC(),
        e_machine: machine,
        e_entry: entry,
        e_phoff: ELF64_EHDR_SIZE(),
        e_shoff: 0,
        e_phentsize: ELF64_PHDR_SIZE(),
        e_phnum: 0,
        e_shentsize: ELF64_SHDR_SIZE(),
        e_shnum: 0,
        e_shstrndx: 0,
    }
}

fn elf64_phdr_new() -> Elf64Phdr {
    Elf64Phdr {
        p_type: 0,
        p_flags: 0,
        p_offset: 0,
        p_vaddr: 0,
        p_paddr: 0,
        p_filesz: 0,
        p_memsz: 0,
        p_align: 0,
    }
}

fn elf64_shdr_new() -> Elf64Shdr {
    Elf64Shdr {
        sh_name: 0,
        sh_type: ELF_SHT_NULL(),
        sh_flags: 0,
        sh_addr: 0,
        sh_offset: 0,
        sh_size: 0,
        sh_link: 0,
        sh_info: 0,
        sh_addralign: 0,
        sh_entsize: 0,
    }
}

fn elf_section_new() -> ElfSection {
    ElfSection {
        name_offset: 0,
        shdr: elf64_shdr_new(),
        data_offset: 0,
        data_len: 0,
    }
}

fn elf_symbol_new() -> ElfSymbol {
    ElfSymbol {
        st_name: 0,
        st_info: 0,
        st_other: 0,
        st_shndx: 0,
        st_value: 0,
        st_size: 0,
    }
}

// Compose st_info from binding and type
fn elf_st_info(binding: i64, stype: i64) -> i64 {
    binding * 16 + stype
}

// ============================================================================
// ELF emission — write binary structures to ElfBuf
// ============================================================================

// Write the 64-byte ELF header
fn elf_emit_header(buf: ElfBuf, hdr: Elf64Header) -> ElfBuf with Mut, Panic, Div {
    var b = buf

    // e_ident[0..4]: magic
    b = elf_buf_emit_byte(b, ELF_MAGIC_0())
    b = elf_buf_emit_byte(b, ELF_MAGIC_1())
    b = elf_buf_emit_byte(b, ELF_MAGIC_2())
    b = elf_buf_emit_byte(b, ELF_MAGIC_3())

    // e_ident[4]: class (64-bit)
    b = elf_buf_emit_byte(b, ELF_CLASS64())

    // e_ident[5]: data encoding (little-endian)
    b = elf_buf_emit_byte(b, ELF_DATA_LSB())

    // e_ident[6]: version
    b = elf_buf_emit_byte(b, ELF_EV_CURRENT())

    // e_ident[7]: OS/ABI
    b = elf_buf_emit_byte(b, ELF_OSABI_SYSV())

    // e_ident[8..16]: padding (8 zero bytes)
    var pad: i64 = 0
    while pad < 8 {
        b = elf_buf_emit_byte(b, 0)
        pad = pad + 1
    }

    // e_type
    b = elf_buf_emit_le16(b, hdr.e_type)

    // e_machine
    b = elf_buf_emit_le16(b, hdr.e_machine)

    // e_version
    b = elf_buf_emit_le32(b, ELF_EV_CURRENT())

    // e_entry
    b = elf_buf_emit_le64(b, hdr.e_entry)

    // e_phoff
    b = elf_buf_emit_le64(b, hdr.e_phoff)

    // e_shoff
    b = elf_buf_emit_le64(b, hdr.e_shoff)

    // e_flags
    b = elf_buf_emit_le32(b, 0)

    // e_ehsize
    b = elf_buf_emit_le16(b, ELF64_EHDR_SIZE())

    // e_phentsize
    b = elf_buf_emit_le16(b, hdr.e_phentsize)

    // e_phnum
    b = elf_buf_emit_le16(b, hdr.e_phnum)

    // e_shentsize
    b = elf_buf_emit_le16(b, hdr.e_shentsize)

    // e_shnum
    b = elf_buf_emit_le16(b, hdr.e_shnum)

    // e_shstrndx
    b = elf_buf_emit_le16(b, hdr.e_shstrndx)

    b
}

// Write a 56-byte program header
fn elf_emit_phdr(buf: ElfBuf, phdr: Elf64Phdr) -> ElfBuf with Mut, Panic, Div {
    var b = buf

    b = elf_buf_emit_le32(b, phdr.p_type)
    b = elf_buf_emit_le32(b, phdr.p_flags)
    b = elf_buf_emit_le64(b, phdr.p_offset)
    b = elf_buf_emit_le64(b, phdr.p_vaddr)
    b = elf_buf_emit_le64(b, phdr.p_paddr)
    b = elf_buf_emit_le64(b, phdr.p_filesz)
    b = elf_buf_emit_le64(b, phdr.p_memsz)
    b = elf_buf_emit_le64(b, phdr.p_align)

    b
}

// Write a 64-byte section header
fn elf_emit_shdr(buf: ElfBuf, shdr: Elf64Shdr) -> ElfBuf with Mut, Panic, Div {
    var b = buf

    b = elf_buf_emit_le32(b, shdr.sh_name)
    b = elf_buf_emit_le32(b, shdr.sh_type)
    b = elf_buf_emit_le64(b, shdr.sh_flags)
    b = elf_buf_emit_le64(b, shdr.sh_addr)
    b = elf_buf_emit_le64(b, shdr.sh_offset)
    b = elf_buf_emit_le64(b, shdr.sh_size)
    b = elf_buf_emit_le32(b, shdr.sh_link)
    b = elf_buf_emit_le32(b, shdr.sh_info)
    b = elf_buf_emit_le64(b, shdr.sh_addralign)
    b = elf_buf_emit_le64(b, shdr.sh_entsize)

    b
}

// Write a 24-byte symbol table entry
fn elf_emit_symbol(buf: ElfBuf, sym: ElfSymbol) -> ElfBuf with Mut, Panic, Div {
    var b = buf

    b = elf_buf_emit_le32(b, sym.st_name)
    b = elf_buf_emit_byte(b, sym.st_info)
    b = elf_buf_emit_byte(b, sym.st_other)
    b = elf_buf_emit_le16(b, sym.st_shndx)
    b = elf_buf_emit_le64(b, sym.st_value)
    b = elf_buf_emit_le64(b, sym.st_size)

    b
}

// Build a string table from an array of (offset, length) pairs
// Each string is taken from a flat byte source; null-terminated in output.
// `strings` holds offsets into `src_bytes` and `lengths` holds their lengths.
fn elf_build_strtab(
    buf: ElfBuf,
    src_bytes: [i8; 262144],
    offsets: [i64; 64],
    lengths: [i64; 64],
    count: i64
) -> ElfBuf with Mut, Panic, Div {
    var b = buf
    // The string table must start with a null byte
    b = elf_buf_emit_byte(b, 0)

    var i: i64 = 0
    while i < count && i < 64 {
        var j: i64 = 0
        let off = offsets[i as usize]
        let slen = lengths[i as usize]
        while j < slen {
            b = elf_buf_emit_byte(b, src_bytes[(off + j) as usize] as i64)
            j = j + 1
        }
        // null terminator
        b = elf_buf_emit_byte(b, 0)
        i = i + 1
    }

    b
}

// ============================================================================
// Alignment utility
// ============================================================================

fn elf_align_up(value: i64, alignment: i64) -> i64 with Mut, Panic {
    if alignment <= 0 {
        return value
    }
    var r = value % alignment
    if r < 0 { r = r + alignment }
    if r == 0 { value } else { value + (alignment - r) }
}

// ============================================================================
// Section-name string table helpers
// ============================================================================

// Add a section name to the writer's strtab, return the name offset
fn elf_strtab_add_name(strtab: ElfBuf, name_bytes: [i8; 32], name_len: i64) -> (ElfBuf, i64) with Mut, Panic, Div {
    var st = strtab
    // If strtab is empty, emit initial null byte
    if st.len == 0 {
        st = elf_buf_emit_byte(st, 0)
    }
    let offset = st.len
    var i: i64 = 0
    while i < name_len && st.len < 262144 {
        st = elf_buf_emit_byte(st, name_bytes[i as usize] as i64)
        i = i + 1
    }
    // null terminator
    st = elf_buf_emit_byte(st, 0)
    (st, offset)
}

// Helper to create a 32-byte name buffer from up to 8 ASCII characters
fn elf_make_name8(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, len: i64) -> [i8; 32] with Mut, Panic {
    var buf: [i8; 32] = [0; 32]
    if len > 0 { buf[0] = a }
    if len > 1 { buf[1] = b }
    if len > 2 { buf[2] = c }
    if len > 3 { buf[3] = d }
    if len > 4 { buf[4] = e }
    if len > 5 { buf[5] = f }
    if len > 6 { buf[6] = g }
    if len > 7 { buf[7] = h }
    buf
}

// ============================================================================
// High-level ElfWriter API
// ============================================================================

fn elf_writer_new(machine: i64, entry_addr: i64) -> ElfWriter with Mut, Panic, Div {
    var w = ElfWriter {
        header: elf64_header_new(machine, entry_addr),
        sections: [elf_section_new(); 32],
        section_count: 0,
        segments: [elf64_phdr_new(); 8],
        segment_count: 0,
        strtab: elf_buf_new(),
        section_data: elf_buf_new(),
        base_addr: ELF_DEFAULT_BASE(),
    }

    // Section 0 is always the null section (SHT_NULL)
    w.sections[0] = elf_section_new()
    w.section_count = 1

    // Initialize the strtab with a leading null byte
    w.strtab = elf_buf_emit_byte(w.strtab, 0)

    w
}

fn elf_writer_section_count(w: ElfWriter) -> i64 {
    w.section_count
}

// Add a generic section to the writer
fn elf_writer_add_section(
    w: ElfWriter,
    name_bytes: [i8; 32],
    name_len: i64,
    sh_type: i64,
    sh_flags: i64,
    data: [i8; 262144],
    data_len: i64
) -> ElfWriter with Mut, Panic, Div {
    var writer = w
    if writer.section_count >= 32 {
        return writer
    }

    // Add name to strtab
    let strtab_result = elf_strtab_add_name(writer.strtab, name_bytes, name_len)
    writer.strtab = strtab_result.0
    let name_off = strtab_result.1

    // Record data offset in section_data buffer
    let data_off = writer.section_data.len

    // Copy data into section_data buffer
    var i: i64 = 0
    while i < data_len && writer.section_data.len < 262144 {
        writer.section_data.data[writer.section_data.len as usize] = data[i as usize]
        writer.section_data.len = writer.section_data.len + 1
        i = i + 1
    }

    let idx = writer.section_count

    // Set up section header (offsets/addresses resolved during finalize)
    var shdr = elf64_shdr_new()
    shdr.sh_name = name_off
    shdr.sh_type = sh_type
    shdr.sh_flags = sh_flags
    shdr.sh_size = data_len
    shdr.sh_addralign = if sh_flags != 0 { 16 } else { 1 }

    writer.sections[idx as usize] = ElfSection {
        name_offset: name_off,
        shdr: shdr,
        data_offset: data_off,
        data_len: data_len,
    }
    writer.section_count = writer.section_count + 1

    writer
}

// Convenience: add .text section (SHT_PROGBITS, alloc + exec)
fn elf_writer_add_text_section(
    w: ElfWriter,
    code: [i8; 262144],
    code_len: i64
) -> ElfWriter with Mut, Panic, Div {
    // ".text" = [46, 116, 101, 120, 116]
    let name = elf_make_name8(46, 116, 101, 120, 116, 0, 0, 0, 5)
    elf_writer_add_section(
        w, name, 5,
        ELF_SHT_PROGBITS(),
        ELF_SHF_ALLOC() + ELF_SHF_EXECINSTR(),
        code, code_len
    )
}

// Convenience: add .data section (SHT_PROGBITS, alloc + write)
fn elf_writer_add_data_section(
    w: ElfWriter,
    data: [i8; 262144],
    data_len: i64
) -> ElfWriter with Mut, Panic, Div {
    // ".data" = [46, 100, 97, 116, 97]
    let name = elf_make_name8(46, 100, 97, 116, 97, 0, 0, 0, 5)
    elf_writer_add_section(
        w, name, 5,
        ELF_SHT_PROGBITS(),
        ELF_SHF_ALLOC() + ELF_SHF_WRITE(),
        data, data_len
    )
}

// Convenience: add .bss section (SHT_NOBITS, alloc + write)
fn elf_writer_add_bss_section(
    w: ElfWriter,
    size: i64
) -> ElfWriter with Mut, Panic, Div {
    var writer = w
    if writer.section_count >= 32 {
        return writer
    }

    // ".bss" = [46, 98, 115, 115]
    let name = elf_make_name8(46, 98, 115, 115, 0, 0, 0, 0, 4)
    let strtab_result = elf_strtab_add_name(writer.strtab, name, 4)
    writer.strtab = strtab_result.0
    let name_off = strtab_result.1

    let idx = writer.section_count

    var shdr = elf64_shdr_new()
    shdr.sh_name = name_off
    shdr.sh_type = ELF_SHT_NOBITS()
    shdr.sh_flags = ELF_SHF_ALLOC() + ELF_SHF_WRITE()
    shdr.sh_size = size
    shdr.sh_addralign = 16

    writer.sections[idx as usize] = ElfSection {
        name_offset: name_off,
        shdr: shdr,
        data_offset: 0,
        data_len: 0,
    }
    writer.section_count = writer.section_count + 1

    writer
}

// Add a segment (program header) to the writer
fn elf_writer_add_segment(
    w: ElfWriter,
    p_type: i64,
    p_flags: i64,
    p_offset: i64,
    p_vaddr: i64,
    p_filesz: i64,
    p_memsz: i64,
    p_align: i64
) -> ElfWriter with Mut, Panic {
    var writer = w
    if writer.segment_count >= 8 {
        return writer
    }

    let idx = writer.segment_count
    writer.segments[idx as usize] = Elf64Phdr {
        p_type: p_type,
        p_flags: p_flags,
        p_offset: p_offset,
        p_vaddr: p_vaddr,
        p_paddr: p_vaddr,
        p_filesz: p_filesz,
        p_memsz: p_memsz,
        p_align: p_align,
    }
    writer.segment_count = writer.segment_count + 1

    writer
}

// ============================================================================
// Layout and finalize
// ============================================================================

// Finalize: compute layout, add .shstrtab, generate segments, emit everything
fn elf_writer_finalize(w: ElfWriter) -> ElfBuf with Mut, Panic, Div {
    var writer = w
    var out = elf_buf_new()

    // ---------------------------------------------------------------
    // Step 1: Add .shstrtab as the last section (section name string table)
    // ---------------------------------------------------------------
    // ".shstrtab" = [46, 115, 104, 115, 116, 114, 116, 97, 98] (9 chars)
    let shstrtab_name = elf_make_name8(46, 115, 104, 115, 116, 114, 116, 97, 9)
    // We need to add the name for .shstrtab itself into the strtab first
    let st_result = elf_strtab_add_name(writer.strtab, shstrtab_name, 9)
    writer.strtab = st_result.0
    let shstrtab_name_off = st_result.1

    let shstrtab_idx = writer.section_count
    var shstrtab_shdr = elf64_shdr_new()
    shstrtab_shdr.sh_name = shstrtab_name_off
    shstrtab_shdr.sh_type = ELF_SHT_STRTAB()
    shstrtab_shdr.sh_addralign = 1

    writer.sections[shstrtab_idx as usize] = ElfSection {
        name_offset: shstrtab_name_off,
        shdr: shstrtab_shdr,
        data_offset: 0,
        data_len: writer.strtab.len,
    }
    writer.section_count = writer.section_count + 1

    // ---------------------------------------------------------------
    // Step 2: Compute layout offsets
    // ---------------------------------------------------------------
    let total_sections = writer.section_count

    // Count loadable sections for segment generation
    var load_text_idx: i64 = 0 - 1
    var load_data_idx: i64 = 0 - 1
    var load_bss_idx: i64 = 0 - 1
    var si: i64 = 1
    while si < total_sections {
        let sec = writer.sections[si as usize]
        let flags = sec.shdr.sh_flags
        let stype = sec.shdr.sh_type
        if stype == ELF_SHT_PROGBITS() && (flags == ELF_SHF_ALLOC() + ELF_SHF_EXECINSTR()) {
            load_text_idx = si
        }
        if stype == ELF_SHT_PROGBITS() && (flags == ELF_SHF_ALLOC() + ELF_SHF_WRITE()) {
            load_data_idx = si
        }
        if stype == ELF_SHT_NOBITS() {
            load_bss_idx = si
        }
        si = si + 1
    }

    // Determine how many program headers we need
    var phnum: i64 = 0
    if load_text_idx >= 0 { phnum = phnum + 1 }
    if load_data_idx >= 0 { phnum = phnum + 1 }
    if load_bss_idx >= 0 { phnum = phnum + 1 }
    // If no loadable sections, add at least one empty segment
    if phnum == 0 { phnum = 1 }

    // Offset computation
    let phdr_start = ELF64_EHDR_SIZE()
    let phdr_total = phnum * ELF64_PHDR_SIZE()
    let first_section_offset = elf_align_up(phdr_start + phdr_total, ELF_PAGE_SIZE())

    // Lay out each section's file offset and virtual address
    var current_offset = first_section_offset
    var sec_i: i64 = 1  // skip null section
    while sec_i < total_sections {
        var sec = writer.sections[sec_i as usize]
        var shdr2 = sec.shdr

        if shdr2.sh_type == ELF_SHT_NOBITS() {
            // BSS: no file data, just address
            shdr2.sh_offset = current_offset
            shdr2.sh_addr = writer.base_addr + current_offset
        } else if sec_i == shstrtab_idx {
            // .shstrtab goes last, after all data sections
            shdr2.sh_offset = current_offset
            shdr2.sh_addr = 0  // non-allocatable
            current_offset = current_offset + writer.strtab.len
        } else {
            shdr2.sh_offset = current_offset
            if shdr2.sh_flags != 0 {
                shdr2.sh_addr = writer.base_addr + current_offset
            }
            current_offset = current_offset + sec.data_len
            // Align next section
            current_offset = elf_align_up(current_offset, 16)
        }

        sec.shdr = shdr2
        writer.sections[sec_i as usize] = sec
        sec_i = sec_i + 1
    }

    // Section header table comes after all section data
    let shdr_table_offset = elf_align_up(current_offset, 8)

    // ---------------------------------------------------------------
    // Step 3: Populate the header
    // ---------------------------------------------------------------
    var hdr = writer.header
    hdr.e_phoff = phdr_start
    hdr.e_phnum = phnum
    hdr.e_shoff = shdr_table_offset
    hdr.e_shnum = total_sections
    hdr.e_shstrndx = shstrtab_idx

    // ---------------------------------------------------------------
    // Step 4: Emit ELF header
    // ---------------------------------------------------------------
    out = elf_emit_header(out, hdr)

    // ---------------------------------------------------------------
    // Step 5: Emit program headers
    // ---------------------------------------------------------------
    if load_text_idx >= 0 {
        let tsec = writer.sections[load_text_idx as usize]
        var text_phdr = elf64_phdr_new()
        text_phdr.p_type = ELF_PT_LOAD()
        text_phdr.p_flags = ELF_PF_R() + ELF_PF_X()
        text_phdr.p_offset = tsec.shdr.sh_offset
        text_phdr.p_vaddr = tsec.shdr.sh_addr
        text_phdr.p_paddr = tsec.shdr.sh_addr
        text_phdr.p_filesz = tsec.data_len
        text_phdr.p_memsz = tsec.data_len
        text_phdr.p_align = ELF_PAGE_SIZE()
        out = elf_emit_phdr(out, text_phdr)
    }
    if load_data_idx >= 0 {
        let dsec = writer.sections[load_data_idx as usize]
        var data_phdr = elf64_phdr_new()
        data_phdr.p_type = ELF_PT_LOAD()
        data_phdr.p_flags = ELF_PF_R() + ELF_PF_W()
        data_phdr.p_offset = dsec.shdr.sh_offset
        data_phdr.p_vaddr = dsec.shdr.sh_addr
        data_phdr.p_paddr = dsec.shdr.sh_addr
        data_phdr.p_filesz = dsec.data_len
        data_phdr.p_memsz = dsec.data_len
        data_phdr.p_align = ELF_PAGE_SIZE()
        out = elf_emit_phdr(out, data_phdr)
    }
    if load_bss_idx >= 0 {
        let bsec = writer.sections[load_bss_idx as usize]
        var bss_phdr = elf64_phdr_new()
        bss_phdr.p_type = ELF_PT_LOAD()
        bss_phdr.p_flags = ELF_PF_R() + ELF_PF_W()
        bss_phdr.p_offset = bsec.shdr.sh_offset
        bss_phdr.p_vaddr = bsec.shdr.sh_addr
        bss_phdr.p_paddr = bsec.shdr.sh_addr
        bss_phdr.p_filesz = 0
        bss_phdr.p_memsz = bsec.shdr.sh_size
        bss_phdr.p_align = ELF_PAGE_SIZE()
        out = elf_emit_phdr(out, bss_phdr)
    }
    // If no loadable sections, emit a dummy segment
    if load_text_idx < 0 && load_data_idx < 0 && load_bss_idx < 0 {
        out = elf_emit_phdr(out, elf64_phdr_new())
    }

    // ---------------------------------------------------------------
    // Step 6: Pad to first section offset and emit section data
    // ---------------------------------------------------------------
    out = elf_buf_pad_to_offset(out, first_section_offset)

    sec_i = 1
    while sec_i < total_sections {
        let sec3 = writer.sections[sec_i as usize]

        // Pad to section offset
        out = elf_buf_pad_to_offset(out, sec3.shdr.sh_offset)

        if sec3.shdr.sh_type == ELF_SHT_NOBITS() {
            // BSS: no file data
        } else if sec_i == shstrtab_idx {
            // Emit .shstrtab from writer.strtab
            out = elf_buf_emit_bytes(out, writer.strtab.data, writer.strtab.len)
        } else {
            // Emit section data from section_data buffer
            out = elf_buf_emit_slice(out, writer.section_data.data, sec3.data_offset, sec3.data_len)
        }
        sec_i = sec_i + 1
    }

    // ---------------------------------------------------------------
    // Step 7: Pad to section header table offset and emit shdrs
    // ---------------------------------------------------------------
    out = elf_buf_pad_to_offset(out, shdr_table_offset)

    var sh_i: i64 = 0
    while sh_i < total_sections {
        out = elf_emit_shdr(out, writer.sections[sh_i as usize].shdr)
        sh_i = sh_i + 1
    }

    out
}

// ============================================================================
// Inline Tests
// ============================================================================

// T01: elf_buf_new creates an empty buffer
fn elf_writer_test_01_buf_new() -> bool {
    let b = elf_buf_new()
    b.len == 0
}

// T02: elf_buf_emit_byte appends a byte
fn elf_writer_test_02_emit_byte() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    b = elf_buf_emit_byte(b, 0x42)
    b.len == 1 && b.data[0] as i64 == 0x42
}

// T03: elf_buf_emit_le16 writes little-endian 16-bit
fn elf_writer_test_03_emit_le16() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    b = elf_buf_emit_le16(b, 0x1234)
    b.len == 2 && b.data[0] as i64 == 0x34 && b.data[1] as i64 == 0x12
}

// T04: elf_buf_emit_le32 writes little-endian 32-bit
fn elf_writer_test_04_emit_le32() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    b = elf_buf_emit_le32(b, 0x78)  // small value to avoid sign issues
    b.len == 4 && b.data[0] as i64 == 0x78 && b.data[1] as i64 == 0 && b.data[2] as i64 == 0 && b.data[3] as i64 == 0
}

// T05: elf_buf_pad_to_alignment pads correctly
fn elf_writer_test_05_pad_alignment() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    b = elf_buf_emit_byte(b, 1)
    b = elf_buf_emit_byte(b, 2)
    b = elf_buf_emit_byte(b, 3)
    b = elf_buf_pad_to_alignment(b, 8)
    b.len == 8
}

// T06: elf_emit_header produces exactly 64 bytes
fn elf_writer_test_06_header_size() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    let hdr = elf64_header_new(ELF_EM_X86_64(), 0x401000)
    b = elf_emit_header(b, hdr)
    b.len == 64
}

// T07: ELF magic bytes are correct in the emitted header
fn elf_writer_test_07_header_magic() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    let hdr = elf64_header_new(ELF_EM_X86_64(), 0x401000)
    b = elf_emit_header(b, hdr)
    b.data[0] as i64 == 0x7f && b.data[1] as i64 == 0x45 && b.data[2] as i64 == 0x4c && b.data[3] as i64 == 0x46
}

// T08: elf_emit_phdr produces exactly 56 bytes
fn elf_writer_test_08_phdr_size() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    var phdr = elf64_phdr_new()
    phdr.p_type = ELF_PT_LOAD()
    phdr.p_flags = ELF_PF_R() + ELF_PF_X()
    b = elf_emit_phdr(b, phdr)
    b.len == 56
}

// T09: elf_emit_shdr produces exactly 64 bytes
fn elf_writer_test_09_shdr_size() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    let shdr = elf64_shdr_new()
    b = elf_emit_shdr(b, shdr)
    b.len == 64
}

// T10: elf_emit_symbol produces exactly 24 bytes
fn elf_writer_test_10_symbol_size() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    let sym = elf_symbol_new()
    b = elf_emit_symbol(b, sym)
    b.len == 24
}

// T11: elf_writer_new starts with 1 section (null) and 0 segments
fn elf_writer_test_11_writer_new() -> bool with Mut, Panic, Div {
    let w = elf_writer_new(ELF_EM_X86_64(), 0x401000)
    w.section_count == 1 && w.segment_count == 0
}

// T12: elf_writer_add_text_section increments section count
fn elf_writer_test_12_add_text() -> bool with Mut, Panic, Div {
    var w = elf_writer_new(ELF_EM_X86_64(), 0x401000)
    var code: [i8; 262144] = [0; 262144]
    code[0] = 0xcc as i8  // INT3
    w = elf_writer_add_text_section(w, code, 1)
    elf_writer_section_count(w) == 2
}

// T13: elf_writer_add_data_section sets correct type
fn elf_writer_test_13_add_data() -> bool with Mut, Panic, Div {
    var w = elf_writer_new(ELF_EM_X86_64(), 0x401000)
    var data: [i8; 262144] = [0; 262144]
    data[0] = 42
    w = elf_writer_add_data_section(w, data, 4)
    elf_writer_section_count(w) == 2
}

// T14: elf_writer_add_bss_section creates NOBITS section
fn elf_writer_test_14_add_bss() -> bool with Mut, Panic, Div {
    var w = elf_writer_new(ELF_EM_X86_64(), 0x401000)
    w = elf_writer_add_bss_section(w, 4096)
    elf_writer_section_count(w) == 2
}

// T15: elf_buf_patch_le32 patches correctly
fn elf_writer_test_15_patch_le32() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    b = elf_buf_emit_le32(b, 0)
    b = elf_buf_patch_le32(b, 0, 0x42)
    b.data[0] as i64 == 0x42 && b.data[1] as i64 == 0 && b.data[2] as i64 == 0 && b.data[3] as i64 == 0
}

// T16: elf_align_up computes correctly
fn elf_writer_test_16_align_up() -> bool with Mut, Panic {
    let a = elf_align_up(100, 16)
    let b_val = elf_align_up(64, 16)
    let c = elf_align_up(0, 4096)
    a == 112 && b_val == 64 && c == 0
}

// T17: elf_st_info composes binding and type correctly
fn elf_writer_test_17_st_info() -> bool {
    let info_global_func = elf_st_info(ELF_STB_GLOBAL(), ELF_STT_FUNC())
    let info_local_obj = elf_st_info(ELF_STB_LOCAL(), ELF_STT_OBJECT())
    info_global_func == 18 && info_local_obj == 1
}

// T18: finalize produces valid ELF with text section
fn elf_writer_test_18_finalize_text() -> bool with Mut, Panic, Div {
    var w = elf_writer_new(ELF_EM_X86_64(), 0x401000)
    var code: [i8; 262144] = [0; 262144]
    // Minimal code: mov rax, 60; xor rdi, rdi; syscall (exit(0))
    code[0] = 0x48 as i8  // REX.W
    code[1] = 0xc7 as i8  // MOV r/m64, imm32
    code[2] = 0xc0 as i8  // ModRM: rax
    code[3] = 60          // imm32: 60 (sys_exit)
    code[4] = 0
    code[5] = 0
    code[6] = 0
    code[7] = 0x48 as i8  // REX.W
    code[8] = 0x31 as i8  // XOR r/m64, r64
    code[9] = 0xff as i8  // ModRM: rdi, rdi
    code[10] = 0x0f       // SYSCALL prefix
    code[11] = 0x05       // SYSCALL
    w = elf_writer_add_text_section(w, code, 12)
    let elf = elf_writer_finalize(w)

    // Verify it starts with ELF magic
    let ok_magic = elf.data[0] as i64 == 0x7f && elf.data[1] as i64 == 0x45 && elf.data[2] as i64 == 0x4c && elf.data[3] as i64 == 0x46
    // Verify it has nonzero length
    let ok_len = elf.len > 64
    ok_magic && ok_len
}

// T19: finalize with both .text and .data
fn elf_writer_test_19_finalize_text_data() -> bool with Mut, Panic, Div {
    var w = elf_writer_new(ELF_EM_AARCH64(), 0x401000)
    var code: [i8; 262144] = [0; 262144]
    code[0] = 0xd2 as i8  // placeholder AArch64 instruction
    w = elf_writer_add_text_section(w, code, 4)

    var data: [i8; 262144] = [0; 262144]
    data[0] = 72  // 'H'
    data[1] = 101 // 'e'
    data[2] = 108 // 'l'
    data[3] = 108 // 'l'
    data[4] = 111 // 'o'
    w = elf_writer_add_data_section(w, data, 5)

    let elf = elf_writer_finalize(w)
    // Should have ELF magic and multiple sections
    elf.data[0] as i64 == 0x7f && elf.len > 64
}

// T20: elf_buf_emit_le64 writes 8 bytes
fn elf_writer_test_20_emit_le64() -> bool with Mut, Panic, Div {
    var b = elf_buf_new()
    b = elf_buf_emit_le64(b, 1)
    b.len == 8 && b.data[0] as i64 == 1 && b.data[7] as i64 == 0
}

// ============================================================================
// Test Runner
// ============================================================================

fn elf_writer_run_tests() -> i64 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    var total: i64 = 0

    print("=== ELF Writer Tests ===\n")

    total = total + 1
    if elf_writer_test_01_buf_new() { passed = passed + 1; print("  T01 OK buf_new\n") } else { print("  FAIL T01 buf_new\n") }

    total = total + 1
    if elf_writer_test_02_emit_byte() { passed = passed + 1; print("  T02 OK emit_byte\n") } else { print("  FAIL T02 emit_byte\n") }

    total = total + 1
    if elf_writer_test_03_emit_le16() { passed = passed + 1; print("  T03 OK emit_le16\n") } else { print("  FAIL T03 emit_le16\n") }

    total = total + 1
    if elf_writer_test_04_emit_le32() { passed = passed + 1; print("  T04 OK emit_le32\n") } else { print("  FAIL T04 emit_le32\n") }

    total = total + 1
    if elf_writer_test_05_pad_alignment() { passed = passed + 1; print("  T05 OK pad_alignment\n") } else { print("  FAIL T05 pad_alignment\n") }

    total = total + 1
    if elf_writer_test_06_header_size() { passed = passed + 1; print("  T06 OK header_size\n") } else { print("  FAIL T06 header_size\n") }

    total = total + 1
    if elf_writer_test_07_header_magic() { passed = passed + 1; print("  T07 OK header_magic\n") } else { print("  FAIL T07 header_magic\n") }

    total = total + 1
    if elf_writer_test_08_phdr_size() { passed = passed + 1; print("  T08 OK phdr_size\n") } else { print("  FAIL T08 phdr_size\n") }

    total = total + 1
    if elf_writer_test_09_shdr_size() { passed = passed + 1; print("  T09 OK shdr_size\n") } else { print("  FAIL T09 shdr_size\n") }

    total = total + 1
    if elf_writer_test_10_symbol_size() { passed = passed + 1; print("  T10 OK symbol_size\n") } else { print("  FAIL T10 symbol_size\n") }

    total = total + 1
    if elf_writer_test_11_writer_new() { passed = passed + 1; print("  T11 OK writer_new\n") } else { print("  FAIL T11 writer_new\n") }

    total = total + 1
    if elf_writer_test_12_add_text() { passed = passed + 1; print("  T12 OK add_text\n") } else { print("  FAIL T12 add_text\n") }

    total = total + 1
    if elf_writer_test_13_add_data() { passed = passed + 1; print("  T13 OK add_data\n") } else { print("  FAIL T13 add_data\n") }

    total = total + 1
    if elf_writer_test_14_add_bss() { passed = passed + 1; print("  T14 OK add_bss\n") } else { print("  FAIL T14 add_bss\n") }

    total = total + 1
    if elf_writer_test_15_patch_le32() { passed = passed + 1; print("  T15 OK patch_le32\n") } else { print("  FAIL T15 patch_le32\n") }

    total = total + 1
    if elf_writer_test_16_align_up() { passed = passed + 1; print("  T16 OK align_up\n") } else { print("  FAIL T16 align_up\n") }

    total = total + 1
    if elf_writer_test_17_st_info() { passed = passed + 1; print("  T17 OK st_info\n") } else { print("  FAIL T17 st_info\n") }

    total = total + 1
    if elf_writer_test_18_finalize_text() { passed = passed + 1; print("  T18 OK finalize_text\n") } else { print("  FAIL T18 finalize_text\n") }

    total = total + 1
    if elf_writer_test_19_finalize_text_data() { passed = passed + 1; print("  T19 OK finalize_text_data\n") } else { print("  FAIL T19 finalize_text_data\n") }

    total = total + 1
    if elf_writer_test_20_emit_le64() { passed = passed + 1; print("  T20 OK emit_le64\n") } else { print("  FAIL T20 emit_le64\n") }

    print("ELF Writer: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/tools/formatter.sio  (2700 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::tools::formatter -- Source code formatter for Sounio
//
// Reads Sounio source as a byte buffer, tokenizes it into FmtTokens that
// preserve whitespace information, groups tokens into FmtLines, detects
// indentation blocks, and re-emits the source with canonical formatting:
//   - Consistent indentation (configurable width, spaces or tabs)
//   - Trailing whitespace removal
//   - Blank line collapsing (max one consecutive blank line)
//   - Blank line insertion between top-level items
//   - Brace style normalization (same-line or next-line)
//   - Comment indentation alignment
//   - Long line breaking at appropriate points
//   - Optional assignment alignment
//   - Final newline enforcement
//
// All mutating operations use state threading (consume + return).
// Helpers precede callers (no forward refs).

// ============================================================================
// CONSTANTS
// ============================================================================

let FMT_MAX_TOKENS: i64 = 8192
let FMT_MAX_LINES: i64 = 2048
let FMT_MAX_BLOCKS: i64 = 512
let FMT_MAX_OUTPUT: i64 = 65536
let FMT_DEFAULT_INDENT: i64 = 4
let FMT_DEFAULT_MAX_WIDTH: i64 = 100

// Brace styles
let FMT_BRACE_SAME_LINE: i64 = 1
let FMT_BRACE_NEXT_LINE: i64 = 2

// Token kind constants
let FMT_TOK_KEYWORD: i64 = 1
let FMT_TOK_IDENT: i64 = 2
let FMT_TOK_NUMBER: i64 = 3
let FMT_TOK_STRING: i64 = 4
let FMT_TOK_OP: i64 = 5
let FMT_TOK_PUNC: i64 = 6
let FMT_TOK_COMMENT: i64 = 7
let FMT_TOK_NEWLINE: i64 = 8
let FMT_TOK_SPACE: i64 = 9

// Block kind constants
let FMT_BLOCK_FN: i64 = 1
let FMT_BLOCK_IF: i64 = 2
let FMT_BLOCK_FOR: i64 = 3
let FMT_BLOCK_STRUCT: i64 = 4
let FMT_BLOCK_GENERIC: i64 = 5
let FMT_BLOCK_IMPL: i64 = 6
let FMT_BLOCK_WHILE: i64 = 7
let FMT_BLOCK_ENUM: i64 = 8

// ASCII constants
let FMT_CHAR_SPACE: i8 = 32
let FMT_CHAR_TAB: i8 = 9
let FMT_CHAR_NEWLINE: i8 = 10
let FMT_CHAR_CR: i8 = 13
let FMT_CHAR_SLASH: i8 = 47
let FMT_CHAR_STAR: i8 = 42
let FMT_CHAR_LBRACE: i8 = 123
let FMT_CHAR_RBRACE: i8 = 125
let FMT_CHAR_LPAREN: i8 = 40
let FMT_CHAR_RPAREN: i8 = 41
let FMT_CHAR_LBRACKET: i8 = 91
let FMT_CHAR_RBRACKET: i8 = 93
let FMT_CHAR_COMMA: i8 = 44
let FMT_CHAR_SEMI: i8 = 59
let FMT_CHAR_COLON: i8 = 58
let FMT_CHAR_EQ: i8 = 61
let FMT_CHAR_DQUOTE: i8 = 34
let FMT_CHAR_SQUOTE: i8 = 39
let FMT_CHAR_UNDERSCORE: i8 = 95
let FMT_CHAR_HASH: i8 = 35
let FMT_CHAR_BANG: i8 = 33
let FMT_CHAR_PLUS: i8 = 43
let FMT_CHAR_MINUS: i8 = 45
let FMT_CHAR_DOT: i8 = 46
let FMT_CHAR_LT: i8 = 60
let FMT_CHAR_GT: i8 = 62
let FMT_CHAR_AMP: i8 = 38
let FMT_CHAR_PIPE: i8 = 124
let FMT_CHAR_TILDE: i8 = 126
let FMT_CHAR_PERCENT: i8 = 37
let FMT_CHAR_CARET: i8 = 94
let FMT_CHAR_AT: i8 = 64

// Maximum indent stack depth
let FMT_MAX_INDENT_STACK: i64 = 128

// ============================================================================
// STRUCTS
// ============================================================================

// A token preserving whitespace information for formatting.
struct FmtToken {
    kind: i64,               // FMT_TOK_* constant
    text_start: i64,         // offset into source buffer
    text_len: i64,           // length of token text in bytes
    line: i64,               // original source line (1-based)
    col: i64,                // original source column (1-based)
    leading_spaces: i64,     // whitespace chars before this token on its line
    trailing_newlines: i64,  // newline chars after this token
}

// A formatted output line: a contiguous range of tokens.
struct FmtLine {
    token_start: i64,        // index of first token in this line
    token_count: i64,        // number of tokens in this line
    indent_level: i64,       // computed indentation level (0-based nesting)
    is_blank: bool,          // true if line has no non-whitespace tokens
    is_comment: bool,        // true if line is only a comment
    original_line_num: i64,  // original line number in source (1-based)
}

// An indentation block: a range of lines sharing a nesting level.
struct FmtBlock {
    start_line: i64,         // index of first line in this block
    end_line: i64,           // index of last line in this block (inclusive)
    indent_level: i64,       // nesting depth of this block
    kind: i64,               // FMT_BLOCK_* constant
}

// Formatter configuration.
struct FmtConfig {
    indent_width: i64,       // spaces per indent level (default 4)
    max_line_width: i64,     // maximum line width before breaking (default 100)
    use_spaces: bool,        // true=spaces, false=tabs
    trailing_newline: bool,  // true=ensure file ends with newline
    align_assignments: bool, // true=align consecutive let/var assignments
    brace_style: i64,        // FMT_BRACE_SAME_LINE or FMT_BRACE_NEXT_LINE
}

// Output buffer for formatted source.
struct FmtOutput {
    bytes: [i8; 65536],
    pos: i64,
    line_count: i64,
}

// Indent stack for tracking nesting.
struct FmtIndentStack {
    levels: [i64; 128],
    count: i64,
}

// Formatter context: holds all state for a formatting pass.
struct FmtContext {
    tokens: [FmtToken; 8192],
    token_count: i64,
    lines: [FmtLine; 2048],
    line_count: i64,
    blocks: [FmtBlock; 512],
    block_count: i64,
    config: FmtConfig,
    output: FmtOutput,
    indent_stack: FmtIndentStack,
    source: [i8; 65536],
    source_len: i64,
}

// ============================================================================
// CONSTRUCTORS
// ============================================================================

fn fmt_token_new() -> FmtToken {
    FmtToken {
        kind: 0,
        text_start: 0,
        text_len: 0,
        line: 0,
        col: 0,
        leading_spaces: 0,
        trailing_newlines: 0,
    }
}

fn fmt_line_new() -> FmtLine {
    FmtLine {
        token_start: 0,
        token_count: 0,
        indent_level: 0,
        is_blank: true,
        is_comment: false,
        original_line_num: 0,
    }
}

fn fmt_block_new() -> FmtBlock {
    FmtBlock {
        start_line: 0,
        end_line: 0,
        indent_level: 0,
        kind: 0,
    }
}

fn fmt_config_default() -> FmtConfig {
    FmtConfig {
        indent_width: FMT_DEFAULT_INDENT,
        max_line_width: FMT_DEFAULT_MAX_WIDTH,
        use_spaces: true,
        trailing_newline: true,
        align_assignments: false,
        brace_style: FMT_BRACE_SAME_LINE,
    }
}

fn fmt_output_new() -> FmtOutput {
    FmtOutput {
        bytes: [0; 65536],
        pos: 0,
        line_count: 0,
    }
}

fn fmt_indent_stack_new() -> FmtIndentStack {
    FmtIndentStack {
        levels: [0; 128],
        count: 0,
    }
}

fn fmt_context_new(src: [i8; 65536], src_len: i64) -> FmtContext with Mut, Panic {
    FmtContext {
        tokens: [fmt_token_new(); 8192],
        token_count: 0,
        lines: [fmt_line_new(); 2048],
        line_count: 0,
        blocks: [fmt_block_new(); 512],
        block_count: 0,
        config: fmt_config_default(),
        output: fmt_output_new(),
        indent_stack: fmt_indent_stack_new(),
        source: src,
        source_len: src_len,
    }
}

fn fmt_context_with_config(src: [i8; 65536], src_len: i64, cfg: FmtConfig) -> FmtContext with Mut, Panic {
    var ctx = fmt_context_new(src, src_len)
    ctx.config = cfg
    ctx
}

// ============================================================================
// CHARACTER CLASSIFICATION HELPERS
// ============================================================================

fn fmt_is_whitespace(ch: i8) -> bool {
    ch == FMT_CHAR_SPACE || ch == FMT_CHAR_TAB || ch == FMT_CHAR_CR
}

fn fmt_is_newline(ch: i8) -> bool {
    ch == FMT_CHAR_NEWLINE
}

fn fmt_is_digit(ch: i8) -> bool {
    ch >= 48 && ch <= 57
}

fn fmt_is_alpha(ch: i8) -> bool {
    (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122)
}

fn fmt_is_ident_start(ch: i8) -> bool {
    fmt_is_alpha(ch) || ch == FMT_CHAR_UNDERSCORE
}

fn fmt_is_ident_continue(ch: i8) -> bool {
    fmt_is_alpha(ch) || fmt_is_digit(ch) || ch == FMT_CHAR_UNDERSCORE
}

fn fmt_is_operator(ch: i8) -> bool {
    ch == FMT_CHAR_PLUS || ch == FMT_CHAR_MINUS || ch == FMT_CHAR_STAR ||
    ch == FMT_CHAR_SLASH || ch == FMT_CHAR_EQ || ch == FMT_CHAR_LT ||
    ch == FMT_CHAR_GT || ch == FMT_CHAR_AMP || ch == FMT_CHAR_PIPE ||
    ch == FMT_CHAR_BANG || ch == FMT_CHAR_TILDE || ch == FMT_CHAR_PERCENT ||
    ch == FMT_CHAR_CARET
}

fn fmt_is_punctuation(ch: i8) -> bool {
    ch == FMT_CHAR_LPAREN || ch == FMT_CHAR_RPAREN ||
    ch == FMT_CHAR_LBRACE || ch == FMT_CHAR_RBRACE ||
    ch == FMT_CHAR_LBRACKET || ch == FMT_CHAR_RBRACKET ||
    ch == FMT_CHAR_COMMA || ch == FMT_CHAR_SEMI ||
    ch == FMT_CHAR_COLON || ch == FMT_CHAR_DOT ||
    ch == FMT_CHAR_AT || ch == FMT_CHAR_HASH
}

// ============================================================================
// KEYWORD DETECTION
// ============================================================================

// Check if the bytes at source[start..start+len] form a Sounio keyword.
// Returns true for: fn, let, var, if, else, while, for, return, struct,
// enum, impl, use, with, true, false, type, linear, effect.
fn fmt_is_keyword_at(src: [i8; 65536], start: i64, len: i64) -> bool with Div, Panic {
    // 2-char keywords
    if len == 2 {
        // fn
        if src[start as usize] == 102 && src[(start + 1) as usize] == 110 { return true }
        // if
        if src[start as usize] == 105 && src[(start + 1) as usize] == 102 { return true }
    }
    // 3-char keywords
    if len == 3 {
        // let
        if src[start as usize] == 108 && src[(start + 1) as usize] == 101 && src[(start + 2) as usize] == 116 { return true }
        // var
        if src[start as usize] == 118 && src[(start + 1) as usize] == 97 && src[(start + 2) as usize] == 114 { return true }
        // for
        if src[start as usize] == 102 && src[(start + 1) as usize] == 111 && src[(start + 2) as usize] == 114 { return true }
        // use
        if src[start as usize] == 117 && src[(start + 1) as usize] == 115 && src[(start + 2) as usize] == 101 { return true }
    }
    // 4-char keywords
    if len == 4 {
        // else
        if src[start as usize] == 101 && src[(start + 1) as usize] == 108 && src[(start + 2) as usize] == 115 && src[(start + 3) as usize] == 101 { return true }
        // with
        if src[start as usize] == 119 && src[(start + 1) as usize] == 105 && src[(start + 2) as usize] == 116 && src[(start + 3) as usize] == 104 { return true }
        // true
        if src[start as usize] == 116 && src[(start + 1) as usize] == 114 && src[(start + 2) as usize] == 117 && src[(start + 3) as usize] == 101 { return true }
        // type
        if src[start as usize] == 116 && src[(start + 1) as usize] == 121 && src[(start + 2) as usize] == 112 && src[(start + 3) as usize] == 101 { return true }
        // impl
        if src[start as usize] == 105 && src[(start + 1) as usize] == 109 && src[(start + 2) as usize] == 112 && src[(start + 3) as usize] == 108 { return true }
        // enum
        if src[start as usize] == 101 && src[(start + 1) as usize] == 110 && src[(start + 2) as usize] == 117 && src[(start + 3) as usize] == 109 { return true }
    }
    // 5-char keywords
    if len == 5 {
        // while
        if src[start as usize] == 119 && src[(start + 1) as usize] == 104 && src[(start + 2) as usize] == 105 && src[(start + 3) as usize] == 108 && src[(start + 4) as usize] == 101 { return true }
        // false
        if src[start as usize] == 102 && src[(start + 1) as usize] == 97 && src[(start + 2) as usize] == 108 && src[(start + 3) as usize] == 115 && src[(start + 4) as usize] == 101 { return true }
    }
    // 6-char keywords
    if len == 6 {
        // return
        if src[start as usize] == 114 && src[(start + 1) as usize] == 101 && src[(start + 2) as usize] == 116 && src[(start + 3) as usize] == 117 && src[(start + 4) as usize] == 114 && src[(start + 5) as usize] == 110 { return true }
        // struct
        if src[start as usize] == 115 && src[(start + 1) as usize] == 116 && src[(start + 2) as usize] == 114 && src[(start + 3) as usize] == 117 && src[(start + 4) as usize] == 99 && src[(start + 5) as usize] == 116 { return true }
        // linear
        if src[start as usize] == 108 && src[(start + 1) as usize] == 105 && src[(start + 2) as usize] == 110 && src[(start + 3) as usize] == 101 && src[(start + 4) as usize] == 97 && src[(start + 5) as usize] == 114 { return true }
        // effect
        if src[start as usize] == 101 && src[(start + 1) as usize] == 102 && src[(start + 2) as usize] == 102 && src[(start + 3) as usize] == 101 && src[(start + 4) as usize] == 99 && src[(start + 5) as usize] == 116 { return true }
    }
    false
}

// ============================================================================
// OUTPUT BUFFER OPERATIONS
// ============================================================================

// Write a single byte to the output buffer.
fn fmt_output_byte(out: FmtOutput, ch: i8) -> FmtOutput with Mut, Panic {
    var o = out
    if o.pos < FMT_MAX_OUTPUT {
        o.bytes[o.pos as usize] = ch
        o.pos = o.pos + 1
        if ch == FMT_CHAR_NEWLINE {
            o.line_count = o.line_count + 1
        }
    }
    o
}

// Write n copies of a byte to the output buffer.
fn fmt_output_repeat(out: FmtOutput, ch: i8, n: i64) -> FmtOutput with Mut, Panic, Div {
    var o = out
    var i: i64 = 0
    while i < n {
        if o.pos < FMT_MAX_OUTPUT {
            o.bytes[o.pos as usize] = ch
            o.pos = o.pos + 1
            if ch == FMT_CHAR_NEWLINE {
                o.line_count = o.line_count + 1
            }
        }
        i = i + 1
    }
    o
}

// Write a range of bytes from the source buffer to the output.
fn fmt_output_range(out: FmtOutput, src: [i8; 65536], start: i64, len: i64) -> FmtOutput with Mut, Panic, Div {
    var o = out
    var i: i64 = 0
    while i < len {
        if o.pos < FMT_MAX_OUTPUT {
            let ch = src[(start + i) as usize]
            o.bytes[o.pos as usize] = ch
            o.pos = o.pos + 1
            if ch == FMT_CHAR_NEWLINE {
                o.line_count = o.line_count + 1
            }
        }
        i = i + 1
    }
    o
}

// Write a newline to the output buffer.
fn fmt_output_newline(out: FmtOutput) -> FmtOutput with Mut, Panic {
    fmt_output_byte(out, FMT_CHAR_NEWLINE)
}

// Write indentation (spaces or a tab) for the given indent level.
fn fmt_output_indent(out: FmtOutput, level: i64, cfg: FmtConfig) -> FmtOutput with Mut, Panic, Div {
    if cfg.use_spaces {
        let total = level * cfg.indent_width
        fmt_output_repeat(out, FMT_CHAR_SPACE, total)
    } else {
        fmt_output_repeat(out, FMT_CHAR_TAB, level)
    }
}

// ============================================================================
// INDENT STACK OPERATIONS
// ============================================================================

fn fmt_indent_push(stack: FmtIndentStack, level: i64) -> FmtIndentStack with Mut, Panic {
    var s = stack
    if s.count < FMT_MAX_INDENT_STACK {
        s.levels[s.count as usize] = level
        s.count = s.count + 1
    }
    s
}

fn fmt_indent_pop(stack: FmtIndentStack) -> FmtIndentStack with Mut, Panic, Div {
    var s = stack
    if s.count > 0 {
        s.count = s.count - 1
    }
    s
}

fn fmt_indent_top(stack: FmtIndentStack) -> i64 with Div, Panic {
    if stack.count > 0 {
        stack.levels[(stack.count - 1) as usize]
    } else {
        0
    }
}

// ============================================================================
// TOKENIZATION
// ============================================================================

// Scan a line comment starting at pos (after //).
// Returns the end position (exclusive) of the comment.
fn fmt_scan_line_comment(src: [i8; 65536], pos: i64, src_len: i64) -> i64 with Mut, Div, Panic {
    var p = pos
    while p < src_len && src[p as usize] != FMT_CHAR_NEWLINE {
        p = p + 1
    }
    p
}

// Scan a block comment starting at pos (after /*).
// Handles nesting. Returns end position (after closing */).
fn fmt_scan_block_comment(src: [i8; 65536], pos: i64, src_len: i64) -> i64 with Mut, Div, Panic {
    var p = pos + 2  // skip /*
    var depth: i64 = 1
    while p < src_len && depth > 0 {
        if p + 1 < src_len && src[p as usize] == FMT_CHAR_STAR && src[(p + 1) as usize] == FMT_CHAR_SLASH {
            depth = depth - 1
            p = p + 2
        } else if p + 1 < src_len && src[p as usize] == FMT_CHAR_SLASH && src[(p + 1) as usize] == FMT_CHAR_STAR {
            depth = depth + 1
            p = p + 2
        } else {
            p = p + 1
        }
    }
    p
}

// Scan a string literal starting at pos (at opening ").
// Returns end position (after closing ").
fn fmt_scan_string(src: [i8; 65536], pos: i64, src_len: i64) -> i64 with Mut, Div, Panic {
    var p = pos + 1  // skip opening "
    while p < src_len {
        let ch = src[p as usize]
        if ch == 92 {  // backslash
            p = p + 2  // skip escaped char
        } else if ch == FMT_CHAR_DQUOTE {
            p = p + 1  // skip closing "
            return p
        } else {
            p = p + 1
        }
    }
    p
}

// Scan a char literal starting at pos (at opening ').
fn fmt_scan_char_lit(src: [i8; 65536], pos: i64, src_len: i64) -> i64 with Mut, Div, Panic {
    var p = pos + 1  // skip opening '
    while p < src_len {
        let ch = src[p as usize]
        if ch == 92 {  // backslash
            p = p + 2
        } else if ch == FMT_CHAR_SQUOTE {
            p = p + 1
            return p
        } else {
            p = p + 1
        }
    }
    p
}

// Scan a number starting at pos.
fn fmt_scan_number(src: [i8; 65536], pos: i64, src_len: i64) -> i64 with Mut, Div, Panic {
    var p = pos
    // Handle 0x, 0b, 0o prefixes
    if p + 1 < src_len && src[p as usize] == 48 {
        let next = src[(p + 1) as usize]
        if next == 120 || next == 98 || next == 111 {  // x, b, o
            p = p + 2
            while p < src_len && (fmt_is_digit(src[p as usize]) || fmt_is_alpha(src[p as usize]) || src[p as usize] == FMT_CHAR_UNDERSCORE) {
                p = p + 1
            }
            return p
        }
    }
    // Regular integer or float
    while p < src_len && (fmt_is_digit(src[p as usize]) || src[p as usize] == FMT_CHAR_UNDERSCORE) {
        p = p + 1
    }
    // Check for float with dot
    if p < src_len && src[p as usize] == FMT_CHAR_DOT {
        if p + 1 < src_len && fmt_is_digit(src[(p + 1) as usize]) {
            p = p + 1
            while p < src_len && (fmt_is_digit(src[p as usize]) || src[p as usize] == FMT_CHAR_UNDERSCORE) {
                p = p + 1
            }
        }
    }
    // Check for exponent
    if p < src_len && (src[p as usize] == 101 || src[p as usize] == 69) {  // e, E
        p = p + 1
        if p < src_len && (src[p as usize] == FMT_CHAR_PLUS || src[p as usize] == FMT_CHAR_MINUS) {
            p = p + 1
        }
        while p < src_len && fmt_is_digit(src[p as usize]) {
            p = p + 1
        }
    }
    // Check for type suffix (i32, f64, etc.)
    if p < src_len && fmt_is_alpha(src[p as usize]) {
        while p < src_len && fmt_is_ident_continue(src[p as usize]) {
            p = p + 1
        }
    }
    p
}

// Scan an identifier or keyword starting at pos.
fn fmt_scan_ident(src: [i8; 65536], pos: i64, src_len: i64) -> i64 with Mut, Div, Panic {
    var p = pos
    while p < src_len && fmt_is_ident_continue(src[p as usize]) {
        p = p + 1
    }
    p
}

// Scan an operator starting at pos. Multi-char operators (==, !=, ->, etc.)
fn fmt_scan_operator(src: [i8; 65536], pos: i64, src_len: i64) -> i64 with Mut, Div, Panic {
    var p = pos
    let ch = src[p as usize]
    p = p + 1
    // Two-char operators
    if p < src_len {
        let ch2 = src[p as usize]
        // ==, !=, <=, >=, ->, =>, &&, ||, &!, ++, ::, ..
        if (ch == FMT_CHAR_EQ && ch2 == FMT_CHAR_EQ) ||
           (ch == FMT_CHAR_BANG && ch2 == FMT_CHAR_EQ) ||
           (ch == FMT_CHAR_LT && ch2 == FMT_CHAR_EQ) ||
           (ch == FMT_CHAR_GT && ch2 == FMT_CHAR_EQ) ||
           (ch == FMT_CHAR_MINUS && ch2 == FMT_CHAR_GT) ||
           (ch == FMT_CHAR_EQ && ch2 == FMT_CHAR_GT) ||
           (ch == FMT_CHAR_AMP && ch2 == FMT_CHAR_AMP) ||
           (ch == FMT_CHAR_PIPE && ch2 == FMT_CHAR_PIPE) ||
           (ch == FMT_CHAR_AMP && ch2 == FMT_CHAR_BANG) ||
           (ch == FMT_CHAR_PLUS && ch2 == FMT_CHAR_PLUS) ||
           (ch == FMT_CHAR_COLON && ch2 == FMT_CHAR_COLON) ||
           (ch == FMT_CHAR_DOT && ch2 == FMT_CHAR_DOT) {
            p = p + 1
        }
    }
    p
}

// Tokenize the source into FmtTokens.
// Returns the context with tokens populated.
fn fmt_tokenize(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    var pos: i64 = 0
    var line: i64 = 1
    var col: i64 = 1
    var leading: i64 = 0
    var at_line_start: bool = true

    while pos < c.source_len && c.token_count < FMT_MAX_TOKENS {
        let ch = c.source[pos as usize]

        // Newline
        if fmt_is_newline(ch) {
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_NEWLINE
            tok.text_start = pos
            tok.text_len = 1
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            tok.trailing_newlines = 0
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            pos = pos + 1
            line = line + 1
            col = 1
            leading = 0
            at_line_start = true
        }
        // Whitespace (not newline)
        else if fmt_is_whitespace(ch) {
            if at_line_start {
                leading = leading + 1
            }
            pos = pos + 1
            col = col + 1
        }
        // Line comment
        else if ch == FMT_CHAR_SLASH && pos + 1 < c.source_len && c.source[(pos + 1) as usize] == FMT_CHAR_SLASH {
            let start = pos
            let end = fmt_scan_line_comment(c.source, pos, c.source_len)
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_COMMENT
            tok.text_start = start
            tok.text_len = end - start
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            col = col + (end - start)
            pos = end
            at_line_start = false
        }
        // Block comment
        else if ch == FMT_CHAR_SLASH && pos + 1 < c.source_len && c.source[(pos + 1) as usize] == FMT_CHAR_STAR {
            let start = pos
            let end = fmt_scan_block_comment(c.source, pos, c.source_len)
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_COMMENT
            tok.text_start = start
            tok.text_len = end - start
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            // Update line/col by scanning for newlines within the comment
            var scan: i64 = start
            while scan < end {
                if c.source[scan as usize] == FMT_CHAR_NEWLINE {
                    line = line + 1
                    col = 1
                } else {
                    col = col + 1
                }
                scan = scan + 1
            }
            pos = end
            at_line_start = false
        }
        // String literal
        else if ch == FMT_CHAR_DQUOTE {
            let start = pos
            let end = fmt_scan_string(c.source, pos, c.source_len)
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_STRING
            tok.text_start = start
            tok.text_len = end - start
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            col = col + (end - start)
            pos = end
            at_line_start = false
        }
        // Char literal
        else if ch == FMT_CHAR_SQUOTE {
            let start = pos
            let end = fmt_scan_char_lit(c.source, pos, c.source_len)
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_STRING
            tok.text_start = start
            tok.text_len = end - start
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            col = col + (end - start)
            pos = end
            at_line_start = false
        }
        // Number
        else if fmt_is_digit(ch) {
            let start = pos
            let end = fmt_scan_number(c.source, pos, c.source_len)
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_NUMBER
            tok.text_start = start
            tok.text_len = end - start
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            col = col + (end - start)
            pos = end
            at_line_start = false
        }
        // Identifier or keyword
        else if fmt_is_ident_start(ch) {
            let start = pos
            let end = fmt_scan_ident(c.source, pos, c.source_len)
            let tok_len = end - start
            let is_kw = fmt_is_keyword_at(c.source, start, tok_len)
            var tok = fmt_token_new()
            if is_kw { tok.kind = FMT_TOK_KEYWORD }
            else { tok.kind = FMT_TOK_IDENT }
            tok.text_start = start
            tok.text_len = tok_len
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            col = col + tok_len
            pos = end
            at_line_start = false
        }
        // Punctuation (braces, parens, brackets, comma, semicolon, etc.)
        else if fmt_is_punctuation(ch) {
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_PUNC
            tok.text_start = pos
            tok.text_len = 1
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            pos = pos + 1
            col = col + 1
            at_line_start = false
        }
        // Operator
        else if fmt_is_operator(ch) {
            let start = pos
            let end = fmt_scan_operator(c.source, pos, c.source_len)
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_OP
            tok.text_start = start
            tok.text_len = end - start
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            col = col + (end - start)
            pos = end
            at_line_start = false
        }
        // Unknown character: emit as punctuation
        else {
            var tok = fmt_token_new()
            tok.kind = FMT_TOK_PUNC
            tok.text_start = pos
            tok.text_len = 1
            tok.line = line
            tok.col = col
            tok.leading_spaces = leading
            c.tokens[c.token_count as usize] = tok
            c.token_count = c.token_count + 1
            pos = pos + 1
            col = col + 1
            at_line_start = false
        }
    }

    c
}

// ============================================================================
// LINE GROUPING
// ============================================================================

// Group tokens into FmtLines based on newline tokens.
fn fmt_group_lines(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    var tok_idx: i64 = 0
    var current_line_start: i64 = 0
    var current_line_tok_count: i64 = 0
    var current_line_num: i64 = 1

    while tok_idx < c.token_count && c.line_count < FMT_MAX_LINES {
        let tok = c.tokens[tok_idx as usize]

        if tok.kind == FMT_TOK_NEWLINE {
            // Finish current line
            var ln = fmt_line_new()
            ln.token_start = current_line_start
            ln.token_count = current_line_tok_count
            ln.original_line_num = current_line_num
            ln.is_blank = current_line_tok_count == 0
            // Check if line is comment-only
            if current_line_tok_count == 1 {
                let first_tok = c.tokens[current_line_start as usize]
                if first_tok.kind == FMT_TOK_COMMENT {
                    ln.is_comment = true
                }
            }
            c.lines[c.line_count as usize] = ln
            c.line_count = c.line_count + 1

            current_line_num = current_line_num + 1
            tok_idx = tok_idx + 1
            current_line_start = tok_idx
            current_line_tok_count = 0
        } else {
            current_line_tok_count = current_line_tok_count + 1
            tok_idx = tok_idx + 1
        }
    }

    // Handle final line if it has tokens (no trailing newline)
    if current_line_tok_count > 0 && c.line_count < FMT_MAX_LINES {
        var ln = fmt_line_new()
        ln.token_start = current_line_start
        ln.token_count = current_line_tok_count
        ln.original_line_num = current_line_num
        ln.is_blank = false
        if current_line_tok_count == 1 {
            let first_tok = c.tokens[current_line_start as usize]
            if first_tok.kind == FMT_TOK_COMMENT {
                ln.is_comment = true
            }
        }
        c.lines[c.line_count as usize] = ln
        c.line_count = c.line_count + 1
    }

    c
}

// ============================================================================
// INDENTATION COMPUTATION
// ============================================================================

// Check if a source byte range starts with a specific keyword.
// Helper for indent computation: checks if a line starts with a
// block-opening keyword (fn, if, while, for, struct, impl, enum).
fn fmt_line_starts_with_keyword(ctx: FmtContext, line_idx: i64, kw_byte0: i8, kw_byte1: i8, kw_len: i64) -> bool with Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    if ln.token_count == 0 { return false }
    let tok = ctx.tokens[ln.token_start as usize]
    if tok.kind != FMT_TOK_KEYWORD { return false }
    if tok.text_len != kw_len { return false }
    if ctx.source[tok.text_start as usize] != kw_byte0 { return false }
    if kw_len > 1 && ctx.source[(tok.text_start + 1) as usize] != kw_byte1 { return false }
    true
}

// Check if a line contains a left brace.
fn fmt_line_has_lbrace(ctx: FmtContext, line_idx: i64) -> bool with Mut, Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    var i: i64 = 0
    while i < ln.token_count {
        let tok = ctx.tokens[(ln.token_start + i) as usize]
        if tok.kind == FMT_TOK_PUNC && tok.text_len == 1 && ctx.source[tok.text_start as usize] == FMT_CHAR_LBRACE {
            return true
        }
        i = i + 1
    }
    false
}

// Check if a line contains a right brace.
fn fmt_line_has_rbrace(ctx: FmtContext, line_idx: i64) -> bool with Mut, Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    var i: i64 = 0
    while i < ln.token_count {
        let tok = ctx.tokens[(ln.token_start + i) as usize]
        if tok.kind == FMT_TOK_PUNC && tok.text_len == 1 && ctx.source[tok.text_start as usize] == FMT_CHAR_RBRACE {
            return true
        }
        i = i + 1
    }
    false
}

// Check if the first non-whitespace token on a line is a right brace.
fn fmt_line_starts_with_rbrace(ctx: FmtContext, line_idx: i64) -> bool with Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    if ln.token_count == 0 { return false }
    let tok = ctx.tokens[ln.token_start as usize]
    if tok.kind == FMT_TOK_PUNC && tok.text_len == 1 && ctx.source[tok.text_start as usize] == FMT_CHAR_RBRACE {
        return true
    }
    false
}

// Check if a line ends with a left brace (the last non-newline token is {).
fn fmt_line_ends_with_lbrace(ctx: FmtContext, line_idx: i64) -> bool with Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    if ln.token_count == 0 { return false }
    let last_idx = ln.token_start + ln.token_count - 1
    let tok = ctx.tokens[last_idx as usize]
    if tok.kind == FMT_TOK_PUNC && tok.text_len == 1 && ctx.source[tok.text_start as usize] == FMT_CHAR_LBRACE {
        return true
    }
    false
}

// Compute indent levels for all lines.
// Scans through lines, adjusting indent based on braces:
//   - { increases indent for subsequent lines
//   - } decreases indent for the current line
fn fmt_compute_indent(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    var current_indent: i64 = 0
    var i: i64 = 0

    while i < c.line_count {
        let ln = c.lines[i as usize]

        if ln.is_blank {
            c.lines[i as usize].indent_level = current_indent
            i = i + 1
        } else {
            // If line starts with }, decrease indent first
            if fmt_line_starts_with_rbrace(c, i) {
                if current_indent > 0 {
                    current_indent = current_indent - 1
                }
            }

            c.lines[i as usize].indent_level = current_indent

            // If line ends with {, increase indent for next line
            if fmt_line_ends_with_lbrace(c, i) {
                current_indent = current_indent + 1
            }

            // If line has } but does not start with }, and has no {,
            // this is like "} else {" — decrease then increase
            // Already handled: starts_with_rbrace adjusts before,
            // ends_with_lbrace adjusts after.
            // Handle standalone } not at start (e.g., "} else {")
            if fmt_line_starts_with_rbrace(c, i) == false && fmt_line_has_rbrace(c, i) && fmt_line_ends_with_lbrace(c, i) == false {
                if current_indent > 0 {
                    current_indent = current_indent - 1
                }
            }

            i = i + 1
        }
    }

    c
}

// ============================================================================
// BLOCK DETECTION
// ============================================================================

// Detect FmtBlocks from the line array.
// A block is a contiguous range of lines at the same indent level.
fn fmt_detect_blocks(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    if c.line_count == 0 { return c }

    var block_start: i64 = 0
    var prev_indent: i64 = c.lines[0].indent_level
    var i: i64 = 1

    while i < c.line_count && c.block_count < FMT_MAX_BLOCKS {
        let cur_indent = c.lines[i as usize].indent_level
        if cur_indent != prev_indent || i == c.line_count - 1 {
            // Close previous block
            var blk = fmt_block_new()
            blk.start_line = block_start
            if i == c.line_count - 1 && cur_indent == prev_indent {
                blk.end_line = i
            } else {
                blk.end_line = i - 1
            }
            blk.indent_level = prev_indent
            blk.kind = FMT_BLOCK_GENERIC
            c.blocks[c.block_count as usize] = blk
            c.block_count = c.block_count + 1

            block_start = i
            prev_indent = cur_indent
        }
        i = i + 1
    }

    // Close final block if needed
    if c.line_count > 0 && (c.block_count == 0 || c.blocks[(c.block_count - 1) as usize].end_line < c.line_count - 1) {
        if c.block_count < FMT_MAX_BLOCKS {
            var blk = fmt_block_new()
            blk.start_line = block_start
            blk.end_line = c.line_count - 1
            blk.indent_level = prev_indent
            blk.kind = FMT_BLOCK_GENERIC
            c.blocks[c.block_count as usize] = blk
            c.block_count = c.block_count + 1
        }
    }

    c
}

// ============================================================================
// BLANK LINE MANAGEMENT
// ============================================================================

// Count consecutive blank lines starting at line_idx.
fn fmt_count_blank_run(ctx: FmtContext, line_idx: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i = line_idx
    while i < ctx.line_count && ctx.lines[i as usize].is_blank {
        count = count + 1
        i = i + 1
    }
    count
}

// Check if a line is a top-level definition (fn, struct, enum, impl, use, let, type).
fn fmt_is_toplevel_start(ctx: FmtContext, line_idx: i64) -> bool with Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    if ln.indent_level != 0 { return false }
    if ln.token_count == 0 { return false }
    let tok = ctx.tokens[ln.token_start as usize]
    if tok.kind != FMT_TOK_KEYWORD { return false }
    // Check for fn, struct, enum, impl, let, var, type, use, linear, effect
    if tok.text_len == 2 {
        let b0 = ctx.source[tok.text_start as usize]
        let b1 = ctx.source[(tok.text_start + 1) as usize]
        // fn
        if b0 == 102 && b1 == 110 { return true }
    }
    if tok.text_len == 3 {
        let b0 = ctx.source[tok.text_start as usize]
        let b1 = ctx.source[(tok.text_start + 1) as usize]
        let b2 = ctx.source[(tok.text_start + 2) as usize]
        // let
        if b0 == 108 && b1 == 101 && b2 == 116 { return true }
        // var
        if b0 == 118 && b1 == 97 && b2 == 114 { return true }
        // use
        if b0 == 117 && b1 == 115 && b2 == 101 { return true }
    }
    if tok.text_len == 4 {
        let b0 = ctx.source[tok.text_start as usize]
        // type, impl, enum
        if b0 == 116 || b0 == 105 || b0 == 101 { return true }
    }
    if tok.text_len == 6 {
        let b0 = ctx.source[tok.text_start as usize]
        // struct, linear, effect
        if b0 == 115 || b0 == 108 || b0 == 101 { return true }
    }
    false
}

// ============================================================================
// TRAILING WHITESPACE REMOVAL
// ============================================================================

// Remove trailing whitespace from a byte range.
// Returns the new length (trimmed from the right).
fn fmt_trim_trailing(src: [i8; 65536], start: i64, len: i64) -> i64 with Mut, Div, Panic {
    var end = start + len
    while end > start {
        let ch = src[(end - 1) as usize]
        if fmt_is_whitespace(ch) {
            end = end - 1
        } else {
            return end - start
        }
    }
    0
}

// ============================================================================
// ASSIGNMENT ALIGNMENT
// ============================================================================

// Find the column of '=' in a line, or -1 if not an assignment line.
fn fmt_find_eq_col(ctx: FmtContext, line_idx: i64) -> i64 with Mut, Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    if ln.token_count < 3 { return 0 - 1 }
    // Must start with let or var
    let first = ctx.tokens[ln.token_start as usize]
    if first.kind != FMT_TOK_KEYWORD { return 0 - 1 }
    if first.text_len != 3 { return 0 - 1 }
    let b0 = ctx.source[first.text_start as usize]
    // 'l' for let, 'v' for var
    if b0 != 108 && b0 != 118 { return 0 - 1 }

    // Search for '=' token
    var col: i64 = 0
    var i: i64 = 0
    while i < ln.token_count {
        let tok = ctx.tokens[(ln.token_start + i) as usize]
        if tok.kind == FMT_TOK_OP && tok.text_len == 1 {
            if ctx.source[tok.text_start as usize] == FMT_CHAR_EQ {
                return col
            }
        }
        // Accumulate column width
        col = col + tok.text_len
        if i + 1 < ln.token_count {
            col = col + 1  // space between tokens
        }
        i = i + 1
    }
    0 - 1
}

// Compute max '=' column in a run of consecutive assignment lines.
fn fmt_max_eq_col_in_run(ctx: FmtContext, start_line: i64, end_line: i64) -> i64 with Mut, Div, Panic {
    var max_col: i64 = 0
    var i = start_line
    while i <= end_line {
        let col = fmt_find_eq_col(ctx, i)
        if col > max_col {
            max_col = col
        }
        i = i + 1
    }
    max_col
}

// ============================================================================
// LINE BREAKING
// ============================================================================

// Estimate the output width of a line (indent + tokens + spaces).
fn fmt_estimate_line_width(ctx: FmtContext, line_idx: i64) -> i64 with Mut, Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    var width = ln.indent_level * ctx.config.indent_width
    var i: i64 = 0
    while i < ln.token_count {
        let tok = ctx.tokens[(ln.token_start + i) as usize]
        width = width + tok.text_len
        if i + 1 < ln.token_count {
            width = width + 1  // inter-token space
        }
        i = i + 1
    }
    width
}

// Find a good break point in a line.
// Prefers breaking after comma, before operator, after opening paren.
// Returns the token index (relative to line start) to break after, or -1.
fn fmt_find_break_point(ctx: FmtContext, line_idx: i64) -> i64 with Mut, Div, Panic {
    let ln = ctx.lines[line_idx as usize]
    var best: i64 = 0 - 1
    var best_priority: i64 = 0
    var width: i64 = ln.indent_level * ctx.config.indent_width

    var i: i64 = 0
    while i < ln.token_count {
        let tok = ctx.tokens[(ln.token_start + i) as usize]
        width = width + tok.text_len + 1

        // Past the midpoint: start looking for break points
        if width > ctx.config.max_line_width / 2 {
            // After comma: priority 10
            if tok.kind == FMT_TOK_PUNC && tok.text_len == 1 && ctx.source[tok.text_start as usize] == FMT_CHAR_COMMA {
                if 10 > best_priority {
                    best = i
                    best_priority = 10
                }
            }
            // Before operator: priority 8
            if tok.kind == FMT_TOK_OP && best_priority < 8 {
                if i > 0 {
                    best = i - 1
                    best_priority = 8
                }
            }
            // After open paren: priority 5
            if tok.kind == FMT_TOK_PUNC && tok.text_len == 1 && ctx.source[tok.text_start as usize] == FMT_CHAR_LPAREN {
                if 5 > best_priority {
                    best = i
                    best_priority = 5
                }
            }
        }
        i = i + 1
    }
    best
}

// ============================================================================
// EMIT: WRITE FORMATTED OUTPUT
// ============================================================================

// Emit a single token's text from the source buffer to the output.
fn fmt_emit_token(ctx: FmtContext, tok_idx: i64) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    let tok = c.tokens[tok_idx as usize]
    c.output = fmt_output_range(c.output, c.source, tok.text_start, tok.text_len)
    c
}

// Emit a single formatted line.
fn fmt_emit_line(ctx: FmtContext, line_idx: i64) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    let ln = c.lines[line_idx as usize]

    // Blank line: just emit a newline
    if ln.is_blank {
        c.output = fmt_output_newline(c.output)
        return c
    }

    // Write indentation
    c.output = fmt_output_indent(c.output, ln.indent_level, c.config)

    // Write tokens with single space between them
    var i: i64 = 0
    while i < ln.token_count {
        let tok_idx = ln.token_start + i
        c = fmt_emit_token(c, tok_idx)
        // Space between tokens (not after last)
        if i + 1 < ln.token_count {
            c.output = fmt_output_byte(c.output, FMT_CHAR_SPACE)
        }
        i = i + 1
    }

    // Newline at end of line
    c.output = fmt_output_newline(c.output)
    c
}

// Emit all lines, handling blank line collapsing and top-level spacing.
fn fmt_emit_all(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    var i: i64 = 0
    var prev_was_blank: bool = false
    var prev_was_toplevel_end: bool = false

    while i < c.line_count {
        let ln = c.lines[i as usize]

        if ln.is_blank {
            // Collapse multiple blanks to one
            if prev_was_blank == false {
                c.output = fmt_output_newline(c.output)
                prev_was_blank = true
            }
            // Skip additional blanks (collapsing)
            i = i + 1
        } else {
            // Insert blank line between top-level items if needed
            if i > 0 && prev_was_blank == false && fmt_is_toplevel_start(c, i) && prev_was_toplevel_end {
                c.output = fmt_output_newline(c.output)
            }

            c = fmt_emit_line(c, i)
            prev_was_blank = false

            // Track if this was the end of a top-level block (closing brace at indent 0)
            if fmt_line_starts_with_rbrace(c, i) && ln.indent_level == 0 {
                prev_was_toplevel_end = true
            } else if ln.indent_level == 0 && ln.is_comment == false {
                prev_was_toplevel_end = true
            } else {
                prev_was_toplevel_end = false
            }

            i = i + 1
        }
    }

    c
}

// ============================================================================
// FINAL NEWLINE ENFORCEMENT
// ============================================================================

// Ensure the output ends with exactly one newline.
fn fmt_ensure_final_newline(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    if c.config.trailing_newline == false { return c }

    if c.output.pos == 0 {
        // Empty output: add one newline
        c.output = fmt_output_newline(c.output)
        return c
    }

    // Strip trailing newlines beyond the first
    while c.output.pos > 1 && c.output.bytes[(c.output.pos - 1) as usize] == FMT_CHAR_NEWLINE && c.output.bytes[(c.output.pos - 2) as usize] == FMT_CHAR_NEWLINE {
        c.output.pos = c.output.pos - 1
        c.output.line_count = c.output.line_count - 1
    }

    // Ensure it ends with one newline
    if c.output.bytes[(c.output.pos - 1) as usize] != FMT_CHAR_NEWLINE {
        c.output = fmt_output_newline(c.output)
    }

    c
}

// ============================================================================
// BRACE STYLE NORMALIZATION
// ============================================================================

// Rewrite brace placement based on config.
// For SAME_LINE: move opening braces that are alone on a line up to the previous line.
// For NEXT_LINE: move opening braces at end of line to start of next line.
// This operates on the line/token arrays before emission.
fn fmt_normalize_braces(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx

    if c.config.brace_style == FMT_BRACE_SAME_LINE {
        // Find lines that are just "{" and merge with previous line
        var i: i64 = 1
        while i < c.line_count {
            let ln = c.lines[i as usize]
            // Line is just a single lbrace
            if ln.token_count == 1 {
                let tok = c.tokens[ln.token_start as usize]
                if tok.kind == FMT_TOK_PUNC && tok.text_len == 1 && c.source[tok.text_start as usize] == FMT_CHAR_LBRACE {
                    // Previous line is non-blank
                    let prev_ln = c.lines[(i - 1) as usize]
                    if prev_ln.is_blank == false && prev_ln.token_count > 0 {
                        // Merge: add brace token to previous line's count
                        c.lines[(i - 1) as usize].token_count = prev_ln.token_count + 1
                        // Mark current line as blank
                        c.lines[i as usize].is_blank = true
                        c.lines[i as usize].token_count = 0
                    }
                }
            }
            i = i + 1
        }
    }
    // NEXT_LINE style is the default emit behavior (brace gets its own line)
    // so no additional transformation needed here.

    c
}

// ============================================================================
// COMMENT INDENTATION
// ============================================================================

// Fix comment indentation: comments should match the indent of the
// next non-blank, non-comment line.
fn fmt_fix_comment_indent(ctx: FmtContext) -> FmtContext with Mut, Div, Panic {
    var c = ctx
    var i: i64 = 0

    while i < c.line_count {
        if c.lines[i as usize].is_comment {
            // Find next non-blank, non-comment line
            var j = i + 1
            while j < c.line_count && (c.lines[j as usize].is_blank || c.lines[j as usize].is_comment) {
                j = j + 1
            }
            if j < c.line_count {
                c.lines[i as usize].indent_level = c.lines[j as usize].indent_level
            }
        }
        i = i + 1
    }

    c
}

// ============================================================================
// MAIN FORMAT PIPELINE
// ============================================================================

// Run the full formatting pipeline on a source buffer.
// Returns the context with output populated.
fn fmt_format(src: [i8; 65536], src_len: i64) -> FmtContext with Mut, Div, Panic {
    var ctx = fmt_context_new(src, src_len)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx = fmt_compute_indent(ctx)
    ctx = fmt_detect_blocks(ctx)
    ctx = fmt_normalize_braces(ctx)
    ctx = fmt_fix_comment_indent(ctx)
    ctx = fmt_emit_all(ctx)
    ctx = fmt_ensure_final_newline(ctx)
    ctx
}

// Run formatting with a custom config.
fn fmt_format_with_config(src: [i8; 65536], src_len: i64, cfg: FmtConfig) -> FmtContext with Mut, Div, Panic {
    var ctx = fmt_context_with_config(src, src_len, cfg)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx = fmt_compute_indent(ctx)
    ctx = fmt_detect_blocks(ctx)
    ctx = fmt_normalize_braces(ctx)
    ctx = fmt_fix_comment_indent(ctx)
    ctx = fmt_emit_all(ctx)
    ctx = fmt_ensure_final_newline(ctx)
    ctx
}

// ============================================================================
// HELPER: BUILD SOURCE BUFFER FROM BYTE ARRAY
// ============================================================================

// Copy a small byte array into a 65536-byte source buffer.
fn fmt_make_source(input: [i8; 256], len: i64) -> [i8; 65536] with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    var i: i64 = 0
    while i < len && i < 256 {
        src[i as usize] = input[i as usize]
        i = i + 1
    }
    src
}

// ============================================================================
// HELPER: CHECK OUTPUT BYTE
// ============================================================================

// Check if the output byte at position pos equals expected.
fn fmt_output_byte_eq(ctx: FmtContext, pos: i64, expected: i8) -> bool with Div, Panic {
    if pos < 0 || pos >= ctx.output.pos { return false }
    ctx.output.bytes[pos as usize] == expected
}

// Count occurrences of a byte in the output.
fn fmt_output_count_byte(ctx: FmtContext, ch: i8) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    while i < ctx.output.pos {
        if ctx.output.bytes[i as usize] == ch {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Check if output contains a consecutive run of n bytes equal to ch.
fn fmt_output_has_run(ctx: FmtContext, ch: i8, n: i64) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i + n <= ctx.output.pos {
        var found: bool = true
        var j: i64 = 0
        while j < n {
            if ctx.output.bytes[(i + j) as usize] != ch {
                found = false
                j = n  // break
            }
            j = j + 1
        }
        if found { return true }
        i = i + 1
    }
    false
}

// Check if output has no trailing whitespace on any line.
fn fmt_output_no_trailing_ws(ctx: FmtContext) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < ctx.output.pos {
        if ctx.output.bytes[i as usize] == FMT_CHAR_NEWLINE && i > 0 {
            let prev = ctx.output.bytes[(i - 1) as usize]
            if fmt_is_whitespace(prev) {
                return false
            }
        }
        i = i + 1
    }
    true
}

// Check if output ends with exactly one newline.
fn fmt_output_ends_one_newline(ctx: FmtContext) -> bool with Div, Panic {
    if ctx.output.pos == 0 { return false }
    if ctx.output.bytes[(ctx.output.pos - 1) as usize] != FMT_CHAR_NEWLINE { return false }
    if ctx.output.pos >= 2 && ctx.output.bytes[(ctx.output.pos - 2) as usize] == FMT_CHAR_NEWLINE {
        return false
    }
    true
}

// ============================================================================
// TESTS
// ============================================================================

// T01: Default config values
fn test_fmt_config_defaults() -> bool {
    let cfg = fmt_config_default()
    cfg.indent_width == 4 &&
    cfg.max_line_width == 100 &&
    cfg.use_spaces &&
    cfg.trailing_newline &&
    cfg.align_assignments == false &&
    cfg.brace_style == FMT_BRACE_SAME_LINE
}

// T02: Output buffer starts empty
fn test_fmt_output_new() -> bool {
    let out = fmt_output_new()
    out.pos == 0 && out.line_count == 0
}

// T03: Write single byte to output
fn test_fmt_output_single_byte() -> bool with Mut, Panic {
    var out = fmt_output_new()
    out = fmt_output_byte(out, 65)  // 'A'
    out.pos == 1 && out.bytes[0] == 65
}

// T04: Write newline increments line count
fn test_fmt_output_newline_count() -> bool with Mut, Panic {
    var out = fmt_output_new()
    out = fmt_output_newline(out)
    out.pos == 1 && out.line_count == 1
}

// T05: Write repeat bytes
fn test_fmt_output_repeat() -> bool with Mut, Panic, Div {
    var out = fmt_output_new()
    out = fmt_output_repeat(out, FMT_CHAR_SPACE, 4)
    out.pos == 4 && out.bytes[0] == FMT_CHAR_SPACE && out.bytes[3] == FMT_CHAR_SPACE
}

// T06: Indent with spaces
fn test_fmt_output_indent_spaces() -> bool with Mut, Panic, Div {
    var out = fmt_output_new()
    let cfg = fmt_config_default()
    out = fmt_output_indent(out, 2, cfg)
    // 2 levels * 4 spaces = 8 spaces
    out.pos == 8 && out.bytes[0] == FMT_CHAR_SPACE && out.bytes[7] == FMT_CHAR_SPACE
}

// T07: Indent with tabs
fn test_fmt_output_indent_tabs() -> bool with Mut, Panic, Div {
    var out = fmt_output_new()
    var cfg = fmt_config_default()
    cfg.use_spaces = false
    out = fmt_output_indent(out, 3, cfg)
    out.pos == 3 && out.bytes[0] == FMT_CHAR_TAB && out.bytes[2] == FMT_CHAR_TAB
}

// T08: Character classification: whitespace
fn test_fmt_is_whitespace() -> bool {
    fmt_is_whitespace(32) && fmt_is_whitespace(9) && fmt_is_whitespace(13) && fmt_is_whitespace(65) == false
}

// T09: Character classification: digits
fn test_fmt_is_digit() -> bool {
    fmt_is_digit(48) && fmt_is_digit(57) && fmt_is_digit(65) == false && fmt_is_digit(32) == false
}

// T10: Character classification: alpha
fn test_fmt_is_alpha() -> bool {
    fmt_is_alpha(65) && fmt_is_alpha(90) && fmt_is_alpha(97) && fmt_is_alpha(122) &&
    fmt_is_alpha(48) == false && fmt_is_alpha(32) == false
}

// T11: Character classification: ident start
fn test_fmt_is_ident_start() -> bool {
    fmt_is_ident_start(95) && fmt_is_ident_start(65) && fmt_is_ident_start(122) &&
    fmt_is_ident_start(48) == false && fmt_is_ident_start(32) == false
}

// T12: Character classification: operator
fn test_fmt_is_operator() -> bool {
    fmt_is_operator(FMT_CHAR_PLUS) && fmt_is_operator(FMT_CHAR_MINUS) &&
    fmt_is_operator(FMT_CHAR_EQ) && fmt_is_operator(65) == false && fmt_is_operator(48) == false
}

// T13: Character classification: punctuation
fn test_fmt_is_punctuation() -> bool {
    fmt_is_punctuation(FMT_CHAR_LPAREN) && fmt_is_punctuation(FMT_CHAR_RBRACE) &&
    fmt_is_punctuation(FMT_CHAR_COMMA) && fmt_is_punctuation(65) == false && fmt_is_punctuation(43) == false
}

// T14: Keyword detection: "fn"
fn test_fmt_keyword_fn() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 102  // f
    src[1] = 110  // n
    fmt_is_keyword_at(src, 0, 2)
}

// T15: Keyword detection: "struct"
fn test_fmt_keyword_struct() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 115  // s
    src[1] = 116  // t
    src[2] = 114  // r
    src[3] = 117  // u
    src[4] = 99   // c
    src[5] = 116  // t
    fmt_is_keyword_at(src, 0, 6)
}

// T16: Non-keyword ident is not keyword
fn test_fmt_keyword_not_ident() -> bool with Mut, Div, Panic {
    var src: [i8; 65536] = [0; 65536]
    src[0] = 102  // f
    src[1] = 111  // o
    src[2] = 111  // o
    fmt_is_keyword_at(src, 0, 3) == false
}

// T17: Tokenize simple "let x = 5\n"
fn test_fmt_tokenize_let() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "let x = 5\n"
    input[0] = 108  // l
    input[1] = 101  // e
    input[2] = 116  // t
    input[3] = 32   // ' '
    input[4] = 120  // x
    input[5] = 32   // ' '
    input[6] = 61   // =
    input[7] = 32   // ' '
    input[8] = 53   // 5
    input[9] = 10   // \n
    let src = fmt_make_source(input, 10)
    let ctx = fmt_tokenize(fmt_context_new(src, 10))
    // Tokens: let(KW), x(IDENT), =(OP), 5(NUM), \n(NEWLINE) = 5
    ctx.token_count == 5 &&
    ctx.tokens[0].kind == FMT_TOK_KEYWORD &&
    ctx.tokens[1].kind == FMT_TOK_IDENT &&
    ctx.tokens[2].kind == FMT_TOK_OP &&
    ctx.tokens[3].kind == FMT_TOK_NUMBER &&
    ctx.tokens[4].kind == FMT_TOK_NEWLINE
}

// T18: Tokenize comment
fn test_fmt_tokenize_comment() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "// hello\n"
    input[0] = 47   // /
    input[1] = 47   // /
    input[2] = 32   // ' '
    input[3] = 104  // h
    input[4] = 101  // e
    input[5] = 108  // l
    input[6] = 108  // l
    input[7] = 111  // o
    input[8] = 10   // \n
    let src = fmt_make_source(input, 9)
    let ctx = fmt_tokenize(fmt_context_new(src, 9))
    // Tokens: comment, \n = 2
    ctx.token_count == 2 &&
    ctx.tokens[0].kind == FMT_TOK_COMMENT &&
    ctx.tokens[0].text_len == 8
}

// T19: Tokenize string literal
fn test_fmt_tokenize_string() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "\"hi\"\n"
    input[0] = 34   // "
    input[1] = 104  // h
    input[2] = 105  // i
    input[3] = 34   // "
    input[4] = 10   // \n
    let src = fmt_make_source(input, 5)
    let ctx = fmt_tokenize(fmt_context_new(src, 5))
    ctx.token_count == 2 &&
    ctx.tokens[0].kind == FMT_TOK_STRING &&
    ctx.tokens[0].text_len == 4
}

// T20: Tokenize operator
fn test_fmt_tokenize_operator() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "==\n"
    input[0] = 61  // =
    input[1] = 61  // =
    input[2] = 10  // \n
    let src = fmt_make_source(input, 3)
    let ctx = fmt_tokenize(fmt_context_new(src, 3))
    ctx.token_count == 2 &&
    ctx.tokens[0].kind == FMT_TOK_OP &&
    ctx.tokens[0].text_len == 2
}

// T21: Line grouping: single line
fn test_fmt_group_single_line() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "x\n"
    input[0] = 120  // x
    input[1] = 10   // \n
    let src = fmt_make_source(input, 2)
    var ctx = fmt_context_new(src, 2)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx.line_count == 1 && ctx.lines[0].token_count == 1 && ctx.lines[0].is_blank == false
}

// T22: Line grouping: blank line
fn test_fmt_group_blank_line() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "\n"
    input[0] = 10  // \n
    let src = fmt_make_source(input, 1)
    var ctx = fmt_context_new(src, 1)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx.line_count == 1 && ctx.lines[0].is_blank
}

// T23: Line grouping: multiple lines
fn test_fmt_group_multi_line() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "a\nb\n"
    input[0] = 97   // a
    input[1] = 10   // \n
    input[2] = 98   // b
    input[3] = 10   // \n
    let src = fmt_make_source(input, 4)
    var ctx = fmt_context_new(src, 4)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx.line_count == 2 && ctx.lines[0].token_count == 1 && ctx.lines[1].token_count == 1
}

// T24: Indent computation: simple block
fn test_fmt_indent_simple_block() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "fn f() {\nx\n}\n"
    input[0] = 102  // f
    input[1] = 110  // n
    input[2] = 32   // ' '
    input[3] = 102  // f
    input[4] = 40   // (
    input[5] = 41   // )
    input[6] = 32   // ' '
    input[7] = 123  // {
    input[8] = 10   // \n
    input[9] = 120  // x
    input[10] = 10  // \n
    input[11] = 125 // }
    input[12] = 10  // \n
    let src = fmt_make_source(input, 13)
    var ctx = fmt_context_new(src, 13)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx = fmt_compute_indent(ctx)
    // Line 0: "fn f() {" -> indent 0
    // Line 1: "x" -> indent 1
    // Line 2: "}" -> indent 0
    ctx.lines[0].indent_level == 0 &&
    ctx.lines[1].indent_level == 1 &&
    ctx.lines[2].indent_level == 0
}

// T25: Indent computation: nested blocks
fn test_fmt_indent_nested() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "fn f() {\nif x {\ny\n}\n}\n"
    input[0] = 102   // f
    input[1] = 110   // n
    input[2] = 32    // ' '
    input[3] = 102   // f
    input[4] = 40    // (
    input[5] = 41    // )
    input[6] = 32    // ' '
    input[7] = 123   // {
    input[8] = 10    // \n
    input[9] = 105   // i
    input[10] = 102  // f
    input[11] = 32   // ' '
    input[12] = 120  // x
    input[13] = 32   // ' '
    input[14] = 123  // {
    input[15] = 10   // \n
    input[16] = 121  // y
    input[17] = 10   // \n
    input[18] = 125  // }
    input[19] = 10   // \n
    input[20] = 125  // }
    input[21] = 10   // \n
    let src = fmt_make_source(input, 22)
    var ctx = fmt_context_new(src, 22)
    ctx = fmt_tokenize(ctx)
    ctx = fmt_group_lines(ctx)
    ctx = fmt_compute_indent(ctx)
    // Line 0: "fn f() {" -> indent 0
    // Line 1: "if x {" -> indent 1
    // Line 2: "y" -> indent 2
    // Line 3: "}" -> indent 1
    // Line 4: "}" -> indent 0
    ctx.lines[0].indent_level == 0 &&
    ctx.lines[1].indent_level == 1 &&
    ctx.lines[2].indent_level == 2 &&
    ctx.lines[3].indent_level == 1 &&
    ctx.lines[4].indent_level == 0
}

// T26: Trailing whitespace removal
fn test_fmt_trailing_ws_removal() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "x  \n" (x followed by two spaces then newline)
    input[0] = 120  // x
    input[1] = 32   // ' '
    input[2] = 32   // ' '
    input[3] = 10   // \n
    let src = fmt_make_source(input, 4)
    let ctx = fmt_format(src, 4)
    // Output should have no trailing whitespace
    fmt_output_no_trailing_ws(ctx)
}

// T27: Blank line collapsing: three blank lines become one
fn test_fmt_blank_collapse() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "x\n\n\n\ny\n"
    input[0] = 120  // x
    input[1] = 10   // \n
    input[2] = 10   // \n
    input[3] = 10   // \n
    input[4] = 10   // \n
    input[5] = 121  // y
    input[6] = 10   // \n
    let src = fmt_make_source(input, 7)
    let ctx = fmt_format(src, 7)
    // Should not have 3 consecutive newlines
    fmt_output_has_run(ctx, FMT_CHAR_NEWLINE, 3) == false
}

// T28: Final newline enforcement: output ends with exactly one newline
fn test_fmt_final_newline() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "x" (no trailing newline)
    input[0] = 120  // x
    let src = fmt_make_source(input, 1)
    let ctx = fmt_format(src, 1)
    fmt_output_ends_one_newline(ctx)
}

// T29: Final newline: multiple trailing newlines collapsed
fn test_fmt_final_newline_collapse() -> bool with Mut, Div, Panic {
    var input: [i8; 256] = [0; 256]
    // "x\n\n\n"
    input[0] = 120  // x
    input[1] = 10   // \n
    input[2] = 10   // \n
    input[3] = 10   // \n
    let src = fmt_make_source(input, 4)
    let ctx = fmt_format(src, 4)
    fmt_output_ends_one_newline(ctx)
}

// T30: Indent stack push and pop
fn test_fmt_indent_stack() -> bool with Mut, Div, Panic {
    var stack = fmt_indent_stack_new()
    stack = fmt_indent_push(stack, 0)
    stack = fmt_indent_push(stack, 1)
    stack = fmt_indent_push(stack, 2)
    let top1 = fmt_indent_top(stack)
    stack = fmt_indent_pop(stack)
    let top2 = fmt_indent_top(stack)
    stack = fmt_indent_pop(stack)
    let top3 = fmt_indent_top(stack)
    top1 == 2 && top2 == 1 && top3 == 0
}

// T31: Indent stack empty returns 0
fn test_fmt_indent_stack_empty() -> bool with Div, Panic {
    let stack = fmt_indent_stack_new()
    fmt_indent_top(stack) == 0
}

