// ---------------------------------------------------------------------------
// T40: Worklist clear
// ---------------------------------------------------------------------------
fn test_gc_worklist_operations() -> bool with Mut, Panic, Div {
    var ctx = gc_context_new()
    ctx = gc_worklist_push(ctx, 10)
    ctx = gc_worklist_push(ctx, 20)
    let ok1 = ctx.worklist.count == 2
    let pop_r = gc_worklist_pop(ctx)
    ctx = pop_r.0
    let ok2 = pop_r.1 == 20
    ctx = gc_worklist_clear(ctx)
    let ok3 = ctx.worklist.count == 0
    let pop_r2 = gc_worklist_pop(ctx)
