// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/traits.sio  (1367 lines)
// ════════════════════════════════════════════════════════════════

// Trait/interface solver — trait resolution, method dispatch, coherence
//
// Implements trait definitions, implementations, resolution, supertrait
// checking, vtable construction, coherence rules, and built-in trait
// auto-derivation for the self-hosted type checker.
//
// Uses flat-array arena pattern consistent with the rest of the
// self-hosted checker (no recursive types, integer IDs everywhere).

// ============================================================
// Built-in trait ID constants
// ============================================================

let TRAIT_COPY: i64 = 1
let TRAIT_DROP: i64 = 2
let TRAIT_EQ: i64 = 3
let TRAIT_ORD: i64 = 4
let TRAIT_HASH: i64 = 5
let TRAIT_ADD: i64 = 10
let TRAIT_SUB: i64 = 11
let TRAIT_MUL: i64 = 12
let TRAIT_DIV_TRAIT: i64 = 13
let TRAIT_DISPLAY: i64 = 20
let TRAIT_DEBUG: i64 = 21

// Sentinel for "not found"
let TRAIT_NOT_FOUND: i64 = 0 - 1

// ============================================================
// TraitMethod — a single method declaration in a trait
// ============================================================

struct TraitMethod {
    name: i64,
    param_types: [i64; 8],
    param_count: i64,
    return_type: i64,
    has_default_impl: bool,
}

fn empty_trait_method() -> TraitMethod {
    TraitMethod {
        name: 0,
        param_types: [0; 8],
        param_count: 0,
        return_type: 0,
        has_default_impl: false,
    }
}

// ============================================================
// TraitDef — a complete trait definition
// ============================================================

struct TraitDef {
    name: i64,
    methods: [TraitMethod; 16],
    method_count: i64,
    supertraits: [i64; 8],
    supertrait_count: i64,
}

fn empty_trait_def() -> TraitDef {
    TraitDef {
        name: 0,
        methods: [empty_trait_method(); 16],
        method_count: 0,
        supertraits: [0; 8],
        supertrait_count: 0,
    }
}

// ============================================================
// TraitDef builder helpers
// ============================================================

fn trait_def_new(name: i64) -> TraitDef {
    TraitDef {
        name: name,
        methods: [empty_trait_method(); 16],
        method_count: 0,
        supertraits: [0; 8],
        supertrait_count: 0,
    }
}

fn trait_def_add_method(def: TraitDef, method: TraitMethod) -> TraitDef with Mut, Panic, Div {
    var d = def
    if d.method_count < 16 {
        d.methods[d.method_count as usize] = method
        d.method_count = d.method_count + 1
    }
    d
}

fn trait_def_add_supertrait(def: TraitDef, super_id: i64) -> TraitDef with Mut, Panic, Div {
    var d = def
    if d.supertrait_count < 8 {
        d.supertraits[d.supertrait_count as usize] = super_id
        d.supertrait_count = d.supertrait_count + 1
    }
    d
}

fn trait_def_find_method(def: TraitDef, method_name: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < def.method_count {
        if def.methods[i as usize].name == method_name {
            return i
        }
        i = i + 1
    }
    TRAIT_NOT_FOUND
}

// ============================================================
// TraitRegistry — table of all known trait definitions
// ============================================================

struct TraitRegistry {
    traits: [TraitDef; 256],
    count: i64,
}

fn trait_registry_new() -> TraitRegistry {
    TraitRegistry {
        traits: [empty_trait_def(); 256],
        count: 0,
    }
}

fn trait_register(reg: TraitRegistry, def: TraitDef) -> TraitRegistry with Mut, Panic, Div {
    var r = reg
    if r.count < 256 {
        r.traits[r.count as usize] = def
        r.count = r.count + 1
    }
    r
}

fn trait_registry_find(reg: TraitRegistry, trait_name: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < reg.count {
        if reg.traits[i as usize].name == trait_name {
            return i
        }
        i = i + 1
    }
    TRAIT_NOT_FOUND
}

fn trait_registry_get(reg: TraitRegistry, idx: i64) -> TraitDef with Panic, Div {
    reg.traits[idx as usize]
}

// ============================================================
// ImplMethod — maps a trait method to a concrete function
// ============================================================

struct ImplMethod {
    trait_method_idx: i64,
    impl_fn_id: i64,
}

fn empty_impl_method() -> ImplMethod {
    ImplMethod {
        trait_method_idx: 0,
        impl_fn_id: 0,
    }
}

// ============================================================
// TraitImpl — a concrete implementation of a trait for a type
// ============================================================

struct TraitImpl {
    trait_id: i64,
    impl_type: i64,
    type_params: [i64; 8],
    type_param_count: i64,
    methods: [ImplMethod; 16],
    method_count: i64,
}

fn empty_trait_impl() -> TraitImpl {
    TraitImpl {
        trait_id: 0,
        impl_type: 0,
        type_params: [0; 8],
        type_param_count: 0,
        methods: [empty_impl_method(); 16],
        method_count: 0,
    }
}

fn trait_impl_new(trait_id: i64, impl_type: i64) -> TraitImpl {
    TraitImpl {
        trait_id: trait_id,
        impl_type: impl_type,
        type_params: [0; 8],
        type_param_count: 0,
        methods: [empty_impl_method(); 16],
        method_count: 0,
    }
}

fn trait_impl_add_method(ti: TraitImpl, method_idx: i64, fn_id: i64) -> TraitImpl with Mut, Panic, Div {
    var t = ti
    if t.method_count < 16 {
        t.methods[t.method_count as usize] = ImplMethod {
            trait_method_idx: method_idx,
            impl_fn_id: fn_id,
        }
        t.method_count = t.method_count + 1
    }
    t
}

fn trait_impl_add_type_param(ti: TraitImpl, param: i64) -> TraitImpl with Mut, Panic, Div {
    var t = ti
    if t.type_param_count < 8 {
        t.type_params[t.type_param_count as usize] = param
        t.type_param_count = t.type_param_count + 1
    }
    t
}

fn trait_impl_find_method(ti: TraitImpl, trait_method_idx: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < ti.method_count {
        if ti.methods[i as usize].trait_method_idx == trait_method_idx {
            return ti.methods[i as usize].impl_fn_id
        }
        i = i + 1
    }
    TRAIT_NOT_FOUND
}

// ============================================================
// ImplRegistry — table of all trait implementations
// ============================================================

struct ImplRegistry {
    impls: [TraitImpl; 1024],
    count: i64,
}

fn impl_registry_new() -> ImplRegistry {
    ImplRegistry {
        impls: [empty_trait_impl(); 1024],
        count: 0,
    }
}

fn impl_register(reg: ImplRegistry, ti: TraitImpl) -> ImplRegistry with Mut, Panic, Div {
    var r = reg
    if r.count < 1024 {
        r.impls[r.count as usize] = ti
        r.count = r.count + 1
    }
    r
}

// ============================================================
// Trait resolution
// ============================================================

// Find implementation of trait_id for type_id
// Returns (found, impl_index)
fn trait_resolve(trait_reg: TraitRegistry, impl_reg: ImplRegistry, trait_id: i64, type_id: i64) -> (bool, i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < impl_reg.count {
        if impl_reg.impls[i as usize].trait_id == trait_id && impl_reg.impls[i as usize].impl_type == type_id {
            return (true, i)
        }
        i = i + 1
    }
    (false, TRAIT_NOT_FOUND)
}

// Resolve a specific method of a trait for a type
// Returns (found, fn_id)
fn trait_resolve_method(trait_reg: TraitRegistry, impl_reg: ImplRegistry, trait_id: i64, type_id: i64, method_name: i64) -> (bool, i64) with Mut, Panic, Div {
    // First find the implementation
    let resolve_result = trait_resolve(trait_reg, impl_reg, trait_id, type_id)
    let found = resolve_result.0
    let impl_idx = resolve_result.1
    if !found {
        return (false, TRAIT_NOT_FOUND)
    }

    // Find which method index this name corresponds to in the trait def
    let trait_idx = trait_registry_find(trait_reg, trait_id)
    if trait_idx == TRAIT_NOT_FOUND {
        return (false, TRAIT_NOT_FOUND)
    }
    let def = trait_registry_get(trait_reg, trait_idx)
    let method_idx = trait_def_find_method(def, method_name)
    if method_idx == TRAIT_NOT_FOUND {
        // Check if there is a default impl for this method name
        return (false, TRAIT_NOT_FOUND)
    }

    // Look up the impl method
    let fn_id = trait_impl_find_method(impl_reg.impls[impl_idx as usize], method_idx)
    if fn_id == TRAIT_NOT_FOUND {
        // Method not implemented; check for default
        if def.methods[method_idx as usize].has_default_impl {
            // Return the method index as a sentinel indicating default
            return (true, 0 - 2)
        }
        return (false, TRAIT_NOT_FOUND)
    }
    (true, fn_id)
}

// Check if a type has an implementation of a specific trait
fn trait_has_impl(impl_reg: ImplRegistry, trait_id: i64, type_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < impl_reg.count {
        if impl_reg.impls[i as usize].trait_id == trait_id && impl_reg.impls[i as usize].impl_type == type_id {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================
// Supertrait checking
// ============================================================

// Check if a type satisfies all trait bounds
fn trait_satisfies_bounds(trait_reg: TraitRegistry, impl_reg: ImplRegistry, type_id: i64, bounds: [i64; 8], bound_count: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < bound_count {
        let bound_trait = bounds[i as usize]
        if !trait_has_impl(impl_reg, bound_trait, type_id) {
            return false
        }
        i = i + 1
    }
    true
}

// Compute the transitive closure of all supertraits for a given trait
// Returns an array of trait IDs (up to 32)
fn trait_all_supertraits(trait_reg: TraitRegistry, trait_id: i64) -> ([i64; 32], i64) with Mut, Panic, Div {
    var result: [i64; 32] = [0; 32]
    var result_count: i64 = 0

    // Work queue: BFS over supertrait graph
    var queue: [i64; 32] = [0; 32]
    var queue_head: i64 = 0
    var queue_tail: i64 = 0

    // Seed with direct supertraits
    let idx = trait_registry_find(trait_reg, trait_id)
    if idx == TRAIT_NOT_FOUND {
        return (result, 0)
    }
    let def = trait_registry_get(trait_reg, idx)
    var s: i64 = 0
    while s < def.supertrait_count {
        queue[queue_tail as usize] = def.supertraits[s as usize]
        queue_tail = queue_tail + 1
        s = s + 1
    }

    // BFS
    while queue_head < queue_tail {
        let current = queue[queue_head as usize]
        queue_head = queue_head + 1

        // Check if already in result
        var already = false
        var j: i64 = 0
        while j < result_count {
            if result[j as usize] == current {
                already = true
            }
            j = j + 1
        }

        if !already && result_count < 32 {
            result[result_count as usize] = current
            result_count = result_count + 1

            // Enqueue supertraits of current
            let cur_idx = trait_registry_find(trait_reg, current)
            if cur_idx != TRAIT_NOT_FOUND {
                let cur_def = trait_registry_get(trait_reg, cur_idx)
                var k: i64 = 0
                while k < cur_def.supertrait_count && queue_tail < 32 {
                    queue[queue_tail as usize] = cur_def.supertraits[k as usize]
                    queue_tail = queue_tail + 1
                    k = k + 1
                }
            }
        }
    }

    (result, result_count)
}

// Check if an implementation provides all required methods
fn trait_check_impl_complete(trait_reg: TraitRegistry, ti: TraitImpl) -> bool with Mut, Panic, Div {
    let trait_idx = trait_registry_find(trait_reg, ti.trait_id)
    if trait_idx == TRAIT_NOT_FOUND {
        return false
    }
    let def = trait_registry_get(trait_reg, trait_idx)

    var i: i64 = 0
    while i < def.method_count {
        // If the method has a default impl, it doesn't need to be provided
        if !def.methods[i as usize].has_default_impl {
            // Check that the impl provides this method
            let fn_id = trait_impl_find_method(ti, i)
            if fn_id == TRAIT_NOT_FOUND {
                return false
            }
        }
        i = i + 1
    }
    true
}

// Check that a type satisfies all supertraits of a given trait
fn trait_check_supertrait_impls(trait_reg: TraitRegistry, impl_reg: ImplRegistry, trait_id: i64, type_id: i64) -> bool with Mut, Panic, Div {
    let supers = trait_all_supertraits(trait_reg, trait_id)
    let super_ids = supers.0
    let super_count = supers.1

    var i: i64 = 0
    while i < super_count {
        if !trait_has_impl(impl_reg, super_ids[i as usize], type_id) {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================
// VTable — method dispatch table
// ============================================================

struct VTable {
    method_ids: [i64; 32],
    count: i64,
    trait_id: i64,
    impl_type: i64,
}

fn empty_vtable() -> VTable {
    VTable {
        method_ids: [0; 32],
        count: 0,
        trait_id: 0,
        impl_type: 0,
    }
}

fn vtable_build(trait_reg: TraitRegistry, impl_reg: ImplRegistry, trait_id: i64, type_id: i64) -> VTable with Mut, Panic, Div {
    var vt = VTable {
        method_ids: [0; 32],
        count: 0,
        trait_id: trait_id,
        impl_type: type_id,
    }

    // Find the trait definition
    let trait_idx = trait_registry_find(trait_reg, trait_id)
    if trait_idx == TRAIT_NOT_FOUND {
        return vt
    }
    let def = trait_registry_get(trait_reg, trait_idx)

    // Find the implementation
    let resolve_result = trait_resolve(trait_reg, impl_reg, trait_id, type_id)
    let found = resolve_result.0
    let impl_idx = resolve_result.1
    if !found {
        return vt
    }
    let ti = impl_reg.impls[impl_idx as usize]

    // Build vtable: one entry per trait method, in order
    var i: i64 = 0
    while i < def.method_count && vt.count < 32 {
        let fn_id = trait_impl_find_method(ti, i)
        if fn_id != TRAIT_NOT_FOUND {
            vt.method_ids[vt.count as usize] = fn_id
        } else {
            // Default impl or missing — use sentinel
            vt.method_ids[vt.count as usize] = 0 - 1
        }
        vt.count = vt.count + 1
        i = i + 1
    }

    vt
}

fn vtable_lookup(vt: VTable, method_idx: i64) -> i64 with Panic, Div {
    if method_idx < 0 || method_idx >= vt.count {
        return TRAIT_NOT_FOUND
    }
    vt.method_ids[method_idx as usize]
}

// ============================================================
// Coherence checking
// ============================================================

// Orphan rule: an impl is valid only if the trait or the implementing
// type is "local" (i.e., defined in the current crate). Here we use
// a simplified model: trait_id and impl_type are encoded as packed
// integers. The high 16 bits represent the crate ID (0 = local).
fn trait_crate_id(packed: i64) -> i64 with Div, Panic {
    // High 16 bits: shift right by 16
    packed / 65536
}

fn trait_check_orphan(ti: TraitImpl) -> bool with Div, Panic {
    let trait_crate = trait_crate_id(ti.trait_id)
    let type_crate = trait_crate_id(ti.impl_type)
    // At least one of trait or type must be local (crate 0)
    trait_crate == 0 || type_crate == 0
}

// Check if a new impl overlaps with an existing one
// Two impls overlap if they are for the same trait and same type
fn trait_check_overlap(impl_reg: ImplRegistry, new_impl: TraitImpl) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < impl_reg.count {
        let existing = impl_reg.impls[i as usize]
        if existing.trait_id == new_impl.trait_id && existing.impl_type == new_impl.impl_type {
            // Same trait + same type => overlap
            // For generic impls, also check type param overlap
            if existing.type_param_count == 0 && new_impl.type_param_count == 0 {
                return true
            }
            // If both have type params, check if they could unify
            if existing.type_param_count == new_impl.type_param_count {
                var all_same = true
                var j: i64 = 0
                while j < existing.type_param_count {
                    if existing.type_params[j as usize] != new_impl.type_params[j as usize] {
                        all_same = false
                    }
                    j = j + 1
                }
                if all_same {
                    return true
                }
            }
        }
        i = i + 1
    }
    false
}

// ============================================================
// Built-in trait queries
// ============================================================

fn trait_is_builtin(trait_id: i64) -> bool {
    // Copy, Drop, Eq, Ord, Hash
    if trait_id >= 1 && trait_id <= 5 {
        return true
    }
    // Add, Sub, Mul, Div
    if trait_id >= 10 && trait_id <= 13 {
        return true
    }
    // Display, Debug
    if trait_id >= 20 && trait_id <= 21 {
        return true
    }
    false
}

// Check if all fields of a type implement a given trait.
// field_types contains the type IDs of the struct fields.
fn trait_fields_all_implement(impl_reg: ImplRegistry, trait_id: i64, field_types: [i64; 16], field_count: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < field_count {
        if !trait_has_impl(impl_reg, trait_id, field_types[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

// Auto-derive: for certain built-in traits, if all fields implement the
// trait, then the containing struct can also implement it automatically.
// Returns true if auto-derive is possible.
fn trait_auto_derive(trait_id: i64, type_fields: [i64; 16], field_count: i64, impl_reg: ImplRegistry) -> bool with Mut, Panic, Div {
    // Only auto-derivable traits: Copy, Eq, Ord, Hash, Debug
    if trait_id == TRAIT_COPY || trait_id == TRAIT_EQ || trait_id == TRAIT_ORD ||
       trait_id == TRAIT_HASH || trait_id == TRAIT_DEBUG {
        // All fields must implement the trait
        return trait_fields_all_implement(impl_reg, trait_id, type_fields, field_count)
    }

    // Drop cannot be auto-derived (requires custom logic)
    if trait_id == TRAIT_DROP {
        return false
    }

    // Arithmetic traits not auto-derivable
    if trait_id >= TRAIT_ADD && trait_id <= TRAIT_DIV_TRAIT {
        return false
    }

    // Display is not auto-derivable
    if trait_id == TRAIT_DISPLAY {
        return false
    }

    false
}

// ============================================================
// Primitive type trait registrations
// ============================================================

// Type ID constants for primitives (low 16 bits)
let PRIM_I64: i64 = 1
let PRIM_F64: i64 = 2
let PRIM_BOOL: i64 = 3
let PRIM_STRING: i64 = 4
let PRIM_I32: i64 = 5
let PRIM_U8: i64 = 6
let PRIM_U32: i64 = 7
let PRIM_U64: i64 = 8

// Register built-in impls for primitive types
fn impl_register_builtins(reg: ImplRegistry) -> ImplRegistry with Mut, Panic, Div {
    var r = reg

    // i64: Copy, Eq, Ord, Hash, Add, Sub, Mul, Div, Debug, Display
    r = impl_register(r, trait_impl_new(TRAIT_COPY, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_EQ, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_ORD, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_HASH, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_ADD, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_SUB, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_MUL, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_DIV_TRAIT, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_DEBUG, PRIM_I64))
    r = impl_register(r, trait_impl_new(TRAIT_DISPLAY, PRIM_I64))

    // f64: Copy, Eq, Add, Sub, Mul, Div, Debug, Display
    r = impl_register(r, trait_impl_new(TRAIT_COPY, PRIM_F64))
    r = impl_register(r, trait_impl_new(TRAIT_EQ, PRIM_F64))
    r = impl_register(r, trait_impl_new(TRAIT_ADD, PRIM_F64))
    r = impl_register(r, trait_impl_new(TRAIT_SUB, PRIM_F64))
    r = impl_register(r, trait_impl_new(TRAIT_MUL, PRIM_F64))
    r = impl_register(r, trait_impl_new(TRAIT_DIV_TRAIT, PRIM_F64))
    r = impl_register(r, trait_impl_new(TRAIT_DEBUG, PRIM_F64))
    r = impl_register(r, trait_impl_new(TRAIT_DISPLAY, PRIM_F64))

    // bool: Copy, Eq, Hash, Debug, Display
    r = impl_register(r, trait_impl_new(TRAIT_COPY, PRIM_BOOL))
    r = impl_register(r, trait_impl_new(TRAIT_EQ, PRIM_BOOL))
    r = impl_register(r, trait_impl_new(TRAIT_HASH, PRIM_BOOL))
    r = impl_register(r, trait_impl_new(TRAIT_DEBUG, PRIM_BOOL))
    r = impl_register(r, trait_impl_new(TRAIT_DISPLAY, PRIM_BOOL))

    // string: Eq, Hash, Debug, Display
    r = impl_register(r, trait_impl_new(TRAIT_EQ, PRIM_STRING))
    r = impl_register(r, trait_impl_new(TRAIT_HASH, PRIM_STRING))
    r = impl_register(r, trait_impl_new(TRAIT_DEBUG, PRIM_STRING))
    r = impl_register(r, trait_impl_new(TRAIT_DISPLAY, PRIM_STRING))

    r
}

// ============================================================
// Method resolution order (MRO) — breadth-first supertrait search
// ============================================================

// Resolve a method name across a type's trait implementations.
// Searches all impls for the given type, looking for a matching method.
// Returns (found, fn_id).
fn trait_resolve_any_method(trait_reg: TraitRegistry, impl_reg: ImplRegistry, type_id: i64, method_name: i64) -> (bool, i64) with Mut, Panic, Div {
    var i: i64 = 0
    while i < impl_reg.count {
        if impl_reg.impls[i as usize].impl_type == type_id {
            let tid = impl_reg.impls[i as usize].trait_id
            let result = trait_resolve_method(trait_reg, impl_reg, tid, type_id, method_name)
            if result.0 {
                return result
            }
        }
        i = i + 1
    }
    (false, TRAIT_NOT_FOUND)
}

// Count how many traits a type implements
fn trait_count_impls(impl_reg: ImplRegistry, type_id: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < impl_reg.count {
        if impl_reg.impls[i as usize].impl_type == type_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Collect all trait IDs that a type implements
fn trait_collect_impls(impl_reg: ImplRegistry, type_id: i64) -> ([i64; 32], i64) with Mut, Panic, Div {
    var result: [i64; 32] = [0; 32]
    var count: i64 = 0
    var i: i64 = 0
    while i < impl_reg.count {
        if impl_reg.impls[i as usize].impl_type == type_id && count < 32 {
            result[count as usize] = impl_reg.impls[i as usize].trait_id
            count = count + 1
        }
        i = i + 1
    }
    (result, count)
}

// ============================================================
// Test helpers
// ============================================================

fn traits_assert_true(cond: bool, test_id: i64) -> i64 with IO, Mut, Panic, Div {
    if cond {
        print("  PASS test ")
        print_int(test_id)
        print("\n")
        return 0
    } else {
        print("  FAIL test ")
        print_int(test_id)
        print("\n")
        return 1
    }
}

// ============================================================
// Test 1: Empty trait registry
// ============================================================

fn test_trait_empty_registry() -> i64 with IO, Mut, Panic, Div {
    let reg = trait_registry_new()
    let ok1 = reg.count == 0
    let idx = trait_registry_find(reg, 42)
    let ok2 = idx == TRAIT_NOT_FOUND
    traits_assert_true(ok1 && ok2, 1)
}

// ============================================================
// Test 2: Register and find a trait
// ============================================================

fn test_trait_register_and_find() -> i64 with IO, Mut, Panic, Div {
    var reg = trait_registry_new()
    let def = trait_def_new(100)
    reg = trait_register(reg, def)
    let ok1 = reg.count == 1
    let idx = trait_registry_find(reg, 100)
    let ok2 = idx == 0
    let not_found = trait_registry_find(reg, 999)
    let ok3 = not_found == TRAIT_NOT_FOUND
    traits_assert_true(ok1 && ok2 && ok3, 2)
}

// ============================================================
// Test 3: Trait with methods
// ============================================================

fn test_trait_with_methods() -> i64 with IO, Mut, Panic, Div {
    var def = trait_def_new(200)
    let m1 = TraitMethod {
        name: 10,
        param_types: [0; 8],
        param_count: 1,
        return_type: PRIM_I64,
        has_default_impl: false,
    }
    let m2 = TraitMethod {
        name: 20,
        param_types: [0; 8],
        param_count: 0,
        return_type: PRIM_BOOL,
        has_default_impl: true,
    }
    def = trait_def_add_method(def, m1)
    def = trait_def_add_method(def, m2)
    let ok1 = def.method_count == 2
    let idx1 = trait_def_find_method(def, 10)
    let ok2 = idx1 == 0
    let idx2 = trait_def_find_method(def, 20)
    let ok3 = idx2 == 1
    let idx3 = trait_def_find_method(def, 999)
    let ok4 = idx3 == TRAIT_NOT_FOUND
    traits_assert_true(ok1 && ok2 && ok3 && ok4, 3)
}

// ============================================================
// Test 4: Impl registry — register and resolve
// ============================================================

fn test_impl_register_resolve() -> i64 with IO, Mut, Panic, Div {
    var treg = trait_registry_new()
    let def = trait_def_new(TRAIT_EQ)
    treg = trait_register(treg, def)

    var ireg = impl_registry_new()
    let ti = trait_impl_new(TRAIT_EQ, PRIM_I64)
    ireg = impl_register(ireg, ti)

    let ok1 = ireg.count == 1
    let result = trait_resolve(treg, ireg, TRAIT_EQ, PRIM_I64)
    let ok2 = result.0
    let ok3 = result.1 == 0
    let result2 = trait_resolve(treg, ireg, TRAIT_EQ, PRIM_STRING)
    let ok4 = !result2.0
    traits_assert_true(ok1 && ok2 && ok3 && ok4, 4)
}

// ============================================================
// Test 5: trait_has_impl
// ============================================================

fn test_trait_has_impl() -> i64 with IO, Mut, Panic, Div {
    var ireg = impl_registry_new()
    ireg = impl_register(ireg, trait_impl_new(TRAIT_COPY, PRIM_I64))
    ireg = impl_register(ireg, trait_impl_new(TRAIT_EQ, PRIM_I64))

    let ok1 = trait_has_impl(ireg, TRAIT_COPY, PRIM_I64)
    let ok2 = trait_has_impl(ireg, TRAIT_EQ, PRIM_I64)
    let ok3 = !trait_has_impl(ireg, TRAIT_ORD, PRIM_I64)
    let ok4 = !trait_has_impl(ireg, TRAIT_COPY, PRIM_STRING)
    traits_assert_true(ok1 && ok2 && ok3 && ok4, 5)
}

// ============================================================
// Test 6: Supertrait computation
// ============================================================

fn test_supertrait_closure() -> i64 with IO, Mut, Panic, Div {
    var treg = trait_registry_new()

    // Trait A (id=100), no supertraits
    let def_a = trait_def_new(100)
    treg = trait_register(treg, def_a)

    // Trait B (id=101), supertrait A
    var def_b = trait_def_new(101)
    def_b = trait_def_add_supertrait(def_b, 100)
    treg = trait_register(treg, def_b)

    // Trait C (id=102), supertrait B
    var def_c = trait_def_new(102)
    def_c = trait_def_add_supertrait(def_c, 101)
    treg = trait_register(treg, def_c)

    // Transitive closure of C should include B and A
    let result = trait_all_supertraits(treg, 102)
    let supers = result.0
    let count = result.1
    let ok1 = count == 2

    // Should contain 101 (B) and 100 (A)
    var has_b = false
    var has_a = false
    var i: i64 = 0
    while i < count {
        if supers[i as usize] == 101 {
            has_b = true
        }
        if supers[i as usize] == 100 {
            has_a = true
        }
        i = i + 1
    }
    let ok2 = has_b && has_a
    traits_assert_true(ok1 && ok2, 6)
}

// ============================================================
// Test 7: Complete impl check
// ============================================================

fn test_impl_completeness() -> i64 with IO, Mut, Panic, Div {
    var treg = trait_registry_new()
    var def = trait_def_new(300)
    let m1 = TraitMethod {
        name: 50,
        param_types: [0; 8],
        param_count: 0,
        return_type: PRIM_I64,
        has_default_impl: false,
    }
    let m2 = TraitMethod {
        name: 51,
        param_types: [0; 8],
        param_count: 0,
        return_type: PRIM_BOOL,
        has_default_impl: true,
    }
    def = trait_def_add_method(def, m1)
    def = trait_def_add_method(def, m2)
    treg = trait_register(treg, def)

    // Complete impl: provides method 0 (required), skips method 1 (has default)
    var ti_complete = trait_impl_new(300, PRIM_I64)
    ti_complete = trait_impl_add_method(ti_complete, 0, 1000)
    let ok1 = trait_check_impl_complete(treg, ti_complete)

    // Incomplete impl: provides neither
    let ti_incomplete = trait_impl_new(300, PRIM_I64)
    let ok2 = !trait_check_impl_complete(treg, ti_incomplete)

    // Over-complete impl: provides both
    var ti_over = trait_impl_new(300, PRIM_I64)
    ti_over = trait_impl_add_method(ti_over, 0, 1000)
    ti_over = trait_impl_add_method(ti_over, 1, 1001)
    let ok3 = trait_check_impl_complete(treg, ti_over)

    traits_assert_true(ok1 && ok2 && ok3, 7)
}

// ============================================================
// Test 8: VTable construction
// ============================================================

fn test_vtable_build() -> i64 with IO, Mut, Panic, Div {
    var treg = trait_registry_new()
    var def = trait_def_new(400)
    let m1 = TraitMethod {
        name: 60,
        param_types: [0; 8],
        param_count: 1,
        return_type: PRIM_I64,
        has_default_impl: false,
    }
    let m2 = TraitMethod {
        name: 61,
        param_types: [0; 8],
        param_count: 0,
        return_type: PRIM_BOOL,
        has_default_impl: false,
    }
    def = trait_def_add_method(def, m1)
    def = trait_def_add_method(def, m2)
    treg = trait_register(treg, def)

    var ireg = impl_registry_new()
    var ti = trait_impl_new(400, PRIM_I64)
    ti = trait_impl_add_method(ti, 0, 2000)
    ti = trait_impl_add_method(ti, 1, 2001)
    ireg = impl_register(ireg, ti)

    let vt = vtable_build(treg, ireg, 400, PRIM_I64)
    let ok1 = vt.count == 2
    let ok2 = vtable_lookup(vt, 0) == 2000
    let ok3 = vtable_lookup(vt, 1) == 2001
    let ok4 = vt.trait_id == 400
    let ok5 = vt.impl_type == PRIM_I64
    let ok6 = vtable_lookup(vt, 99) == TRAIT_NOT_FOUND
    traits_assert_true(ok1 && ok2 && ok3 && ok4 && ok5 && ok6, 8)
}

// ============================================================
// Test 9: Orphan rule
// ============================================================

fn test_orphan_check() -> i64 with IO, Mut, Panic, Div {
    // Local trait (crate 0), local type (crate 0) => ok
    let ti_local = trait_impl_new(100, 200)
    let ok1 = trait_check_orphan(ti_local)

    // Foreign trait (crate 1 = 65536), local type => ok
    let ti_foreign_trait = trait_impl_new(65536 + 100, 200)
    let ok2 = trait_check_orphan(ti_foreign_trait)

    // Local trait, foreign type => ok
    let ti_foreign_type = trait_impl_new(100, 65536 + 200)
    let ok3 = trait_check_orphan(ti_foreign_type)

    // Foreign trait AND foreign type => NOT ok
    let ti_both_foreign = trait_impl_new(65536 + 100, 65536 + 200)
    let ok4 = !trait_check_orphan(ti_both_foreign)

    traits_assert_true(ok1 && ok2 && ok3 && ok4, 9)
}

// ============================================================
// Test 10: Overlap detection
// ============================================================

fn test_overlap_detection() -> i64 with IO, Mut, Panic, Div {
    var ireg = impl_registry_new()
    let ti1 = trait_impl_new(TRAIT_EQ, PRIM_I64)
    ireg = impl_register(ireg, ti1)

    // Same trait + same type => overlap
    let ti_dup = trait_impl_new(TRAIT_EQ, PRIM_I64)
    let ok1 = trait_check_overlap(ireg, ti_dup)

    // Same trait, different type => no overlap
    let ti_diff_type = trait_impl_new(TRAIT_EQ, PRIM_F64)
    let ok2 = !trait_check_overlap(ireg, ti_diff_type)

    // Different trait, same type => no overlap
    let ti_diff_trait = trait_impl_new(TRAIT_ORD, PRIM_I64)
    let ok3 = !trait_check_overlap(ireg, ti_diff_trait)

    traits_assert_true(ok1 && ok2 && ok3, 10)
}

// ============================================================
// Test 11: Built-in trait identification
// ============================================================

fn test_is_builtin() -> i64 with IO, Mut, Panic, Div {
    let ok1 = trait_is_builtin(TRAIT_COPY)
    let ok2 = trait_is_builtin(TRAIT_DROP)
    let ok3 = trait_is_builtin(TRAIT_EQ)
    let ok4 = trait_is_builtin(TRAIT_ADD)
    let ok5 = trait_is_builtin(TRAIT_DISPLAY)
    let ok6 = !trait_is_builtin(50)
    let ok7 = !trait_is_builtin(0)
    let ok8 = !trait_is_builtin(0 - 1)
    traits_assert_true(ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8, 11)
}

// ============================================================
// Test 12: Auto-derive with all fields implementing trait
// ============================================================

fn test_auto_derive_success() -> i64 with IO, Mut, Panic, Div {
    var ireg = impl_registry_new()
    // Register Copy for i64 and f64
    ireg = impl_register(ireg, trait_impl_new(TRAIT_COPY, PRIM_I64))
    ireg = impl_register(ireg, trait_impl_new(TRAIT_COPY, PRIM_F64))

    // Struct with fields: [i64, f64]
    var fields: [i64; 16] = [0; 16]
    fields[0] = PRIM_I64
    fields[1] = PRIM_F64

    let ok1 = trait_auto_derive(TRAIT_COPY, fields, 2, ireg)

    // Drop is never auto-derivable
    let ok2 = !trait_auto_derive(TRAIT_DROP, fields, 2, ireg)

    // Add is not auto-derivable
    let ok3 = !trait_auto_derive(TRAIT_ADD, fields, 2, ireg)

    traits_assert_true(ok1 && ok2 && ok3, 12)
}

// ============================================================
// Test 13: Auto-derive fails when field lacks impl
// ============================================================

fn test_auto_derive_failure() -> i64 with IO, Mut, Panic, Div {
    var ireg = impl_registry_new()
    // Only register Copy for i64 (not for PRIM_STRING=4)
    ireg = impl_register(ireg, trait_impl_new(TRAIT_COPY, PRIM_I64))

    // Struct with fields: [i64, string]
    var fields: [i64; 16] = [0; 16]
    fields[0] = PRIM_I64
    fields[1] = PRIM_STRING

    let ok1 = !trait_auto_derive(TRAIT_COPY, fields, 2, ireg)
    traits_assert_true(ok1, 13)
}

// ============================================================
// Test 14: Method resolution across traits
// ============================================================

fn test_method_resolution() -> i64 with IO, Mut, Panic, Div {
    var treg = trait_registry_new()

    // Trait with method "foo" (name=500)
    var def = trait_def_new(600)
    let m1 = TraitMethod {
        name: 500,
        param_types: [0; 8],
        param_count: 0,
        return_type: PRIM_I64,
        has_default_impl: false,
    }
    def = trait_def_add_method(def, m1)
    treg = trait_register(treg, def)

    var ireg = impl_registry_new()
    var ti = trait_impl_new(600, PRIM_I64)
    ti = trait_impl_add_method(ti, 0, 3000)
    ireg = impl_register(ireg, ti)

    // Should find method "foo" on i64 via trait 600
    let result = trait_resolve_method(treg, ireg, 600, PRIM_I64, 500)
    let ok1 = result.0
    let ok2 = result.1 == 3000

    // Should not find "bar" (name=501)
    let result2 = trait_resolve_method(treg, ireg, 600, PRIM_I64, 501)
    let ok3 = !result2.0

    traits_assert_true(ok1 && ok2 && ok3, 14)
}

// ============================================================
// Test 15: Bounds satisfaction check
// ============================================================

fn test_bounds_satisfaction() -> i64 with IO, Mut, Panic, Div {
    var ireg = impl_registry_new()
    ireg = impl_register(ireg, trait_impl_new(TRAIT_COPY, PRIM_I64))
    ireg = impl_register(ireg, trait_impl_new(TRAIT_EQ, PRIM_I64))
    ireg = impl_register(ireg, trait_impl_new(TRAIT_ORD, PRIM_I64))

    var treg = trait_registry_new()

    // Bounds: [Copy, Eq] => i64 satisfies
    var bounds1: [i64; 8] = [0; 8]
    bounds1[0] = TRAIT_COPY
    bounds1[1] = TRAIT_EQ
    let ok1 = trait_satisfies_bounds(treg, ireg, PRIM_I64, bounds1, 2)

    // Bounds: [Copy, Hash] => i64 does NOT satisfy (no Hash impl)
    var bounds2: [i64; 8] = [0; 8]
    bounds2[0] = TRAIT_COPY
    bounds2[1] = TRAIT_HASH
    let ok2 = !trait_satisfies_bounds(treg, ireg, PRIM_I64, bounds2, 2)

    // Empty bounds => always satisfies
    let bounds3: [i64; 8] = [0; 8]
    let ok3 = trait_satisfies_bounds(treg, ireg, PRIM_I64, bounds3, 0)

    traits_assert_true(ok1 && ok2 && ok3, 15)
}

// ============================================================
// Test 16: Collect impls for a type
// ============================================================

fn test_collect_impls() -> i64 with IO, Mut, Panic, Div {
    var ireg = impl_registry_new()
    ireg = impl_register(ireg, trait_impl_new(TRAIT_COPY, PRIM_I64))
    ireg = impl_register(ireg, trait_impl_new(TRAIT_EQ, PRIM_I64))
    ireg = impl_register(ireg, trait_impl_new(TRAIT_EQ, PRIM_F64))
    ireg = impl_register(ireg, trait_impl_new(TRAIT_ORD, PRIM_I64))

    let count_i64 = trait_count_impls(ireg, PRIM_I64)
    let ok1 = count_i64 == 3

    let count_f64 = trait_count_impls(ireg, PRIM_F64)
    let ok2 = count_f64 == 1

    let count_bool = trait_count_impls(ireg, PRIM_BOOL)
    let ok3 = count_bool == 0

    let collected = trait_collect_impls(ireg, PRIM_I64)
    let ok4 = collected.1 == 3

    traits_assert_true(ok1 && ok2 && ok3 && ok4, 16)
}

// ============================================================
// Test 17: Supertrait impl check
// ============================================================

fn test_supertrait_impl_check() -> i64 with IO, Mut, Panic, Div {
    var treg = trait_registry_new()

    // Trait A (id=700), no supertraits
    let def_a = trait_def_new(700)
    treg = trait_register(treg, def_a)

    // Trait B (id=701), supertrait A
    var def_b = trait_def_new(701)
    def_b = trait_def_add_supertrait(def_b, 700)
    treg = trait_register(treg, def_b)

    // Type 50 implements B and A => passes supertrait check
    var ireg = impl_registry_new()
    ireg = impl_register(ireg, trait_impl_new(700, 50))
    ireg = impl_register(ireg, trait_impl_new(701, 50))
    let ok1 = trait_check_supertrait_impls(treg, ireg, 701, 50)

    // Type 51 implements B but NOT A => fails
    var ireg2 = impl_registry_new()
    ireg2 = impl_register(ireg2, trait_impl_new(701, 51))
    let ok2 = !trait_check_supertrait_impls(treg, ireg2, 701, 51)

    traits_assert_true(ok1 && ok2, 17)
}

// ============================================================
// Test 18: VTable with default method
// ============================================================

fn test_vtable_default_method() -> i64 with IO, Mut, Panic, Div {
    var treg = trait_registry_new()
    var def = trait_def_new(800)
    let m1 = TraitMethod {
        name: 70,
        param_types: [0; 8],
        param_count: 0,
        return_type: PRIM_I64,
        has_default_impl: false,
    }
    let m2 = TraitMethod {
        name: 71,
        param_types: [0; 8],
        param_count: 0,
        return_type: PRIM_BOOL,
        has_default_impl: true,
    }
    def = trait_def_add_method(def, m1)
    def = trait_def_add_method(def, m2)
    treg = trait_register(treg, def)

    var ireg = impl_registry_new()
    // Only implement method 0 (method 1 has default)
    var ti = trait_impl_new(800, PRIM_I64)
    ti = trait_impl_add_method(ti, 0, 4000)
    ireg = impl_register(ireg, ti)

    let vt = vtable_build(treg, ireg, 800, PRIM_I64)
    let ok1 = vt.count == 2
    let ok2 = vtable_lookup(vt, 0) == 4000
    // Method 1 uses default => sentinel -1
    let ok3 = vtable_lookup(vt, 1) == (0 - 1)
    traits_assert_true(ok1 && ok2 && ok3, 18)
}

// ============================================================
// Test 19: Builtin registrations
// ============================================================

fn test_builtin_registrations() -> i64 with IO, Mut, Panic, Div {
    let ireg = impl_register_builtins(impl_registry_new())

    // i64 has Copy, Eq, Add, Display
    let ok1 = trait_has_impl(ireg, TRAIT_COPY, PRIM_I64)
    let ok2 = trait_has_impl(ireg, TRAIT_EQ, PRIM_I64)
    let ok3 = trait_has_impl(ireg, TRAIT_ADD, PRIM_I64)
    let ok4 = trait_has_impl(ireg, TRAIT_DISPLAY, PRIM_I64)

    // bool has Copy, Eq but not Add
    let ok5 = trait_has_impl(ireg, TRAIT_COPY, PRIM_BOOL)
    let ok6 = trait_has_impl(ireg, TRAIT_EQ, PRIM_BOOL)
    let ok7 = !trait_has_impl(ireg, TRAIT_ADD, PRIM_BOOL)

    // string has Eq but not Copy
    let ok8 = trait_has_impl(ireg, TRAIT_EQ, PRIM_STRING)
    let ok9 = !trait_has_impl(ireg, TRAIT_COPY, PRIM_STRING)

    traits_assert_true(ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8 && ok9, 19)
}

// ============================================================
// Test 20: Impl with type params — overlap with different params
// ============================================================

fn test_type_param_overlap() -> i64 with IO, Mut, Panic, Div {
    var ireg = impl_registry_new()
    var ti1 = trait_impl_new(TRAIT_EQ, 100)
    ti1 = trait_impl_add_type_param(ti1, PRIM_I64)
    ireg = impl_register(ireg, ti1)

    // Same trait+type but different type param => no overlap
    var ti2 = trait_impl_new(TRAIT_EQ, 100)
    ti2 = trait_impl_add_type_param(ti2, PRIM_F64)
    let ok1 = !trait_check_overlap(ireg, ti2)

    // Same trait+type, same type param => overlap
    var ti3 = trait_impl_new(TRAIT_EQ, 100)
    ti3 = trait_impl_add_type_param(ti3, PRIM_I64)
    let ok2 = trait_check_overlap(ireg, ti3)

    traits_assert_true(ok1 && ok2, 20)
}

// ============================================================
// Test runner
// ============================================================

fn traits_run_tests() -> i64 with IO, Mut, Panic, Div {
    print("=== Trait solver tests ===\n")
    var fails: i64 = 0

    let t01 = test_trait_empty_registry()
    if t01 != 0 { fails = fails + 1 }

    let t02 = test_trait_register_and_find()
    if t02 != 0 { fails = fails + 1 }

    let t03 = test_trait_with_methods()
    if t03 != 0 { fails = fails + 1 }

    let t04 = test_impl_register_resolve()
    if t04 != 0 { fails = fails + 1 }

    let t05 = test_trait_has_impl()
    if t05 != 0 { fails = fails + 1 }

    let t06 = test_supertrait_closure()
    if t06 != 0 { fails = fails + 1 }

    let t07 = test_impl_completeness()
    if t07 != 0 { fails = fails + 1 }

    let t08 = test_vtable_build()
    if t08 != 0 { fails = fails + 1 }

    let t09 = test_orphan_check()
    if t09 != 0 { fails = fails + 1 }

    let t10 = test_overlap_detection()
    if t10 != 0 { fails = fails + 1 }

    let t11 = test_is_builtin()
    if t11 != 0 { fails = fails + 1 }

    let t12 = test_auto_derive_success()
    if t12 != 0 { fails = fails + 1 }

    let t13 = test_auto_derive_failure()
    if t13 != 0 { fails = fails + 1 }

    let t14 = test_method_resolution()
    if t14 != 0 { fails = fails + 1 }

    let t15 = test_bounds_satisfaction()
    if t15 != 0 { fails = fails + 1 }

    let t16 = test_collect_impls()
    if t16 != 0 { fails = fails + 1 }

    let t17 = test_supertrait_impl_check()
    if t17 != 0 { fails = fails + 1 }

    let t18 = test_vtable_default_method()
    if t18 != 0 { fails = fails + 1 }

    let t19 = test_builtin_registrations()
    if t19 != 0 { fails = fails + 1 }

    let t20 = test_type_param_overlap()
    if t20 != 0 { fails = fails + 1 }

    print("Total failures: ")
    print_int(fails)
    print("\n")
    fails
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/macros.sio  (2202 lines)
// ════════════════════════════════════════════════════════════════

// Hygienic macro expansion system for the self-hosted compiler
//
// Implements compile-time macro definitions, pattern matching, hygienic
// name generation (gensym), substitution, and recursive expansion with
// cycle detection.
//
// Architecture:
//   MacroParam      — single macro parameter descriptor (name + kind)
//   MacroTemplate   — token template with param references and literals
//   MacroDef        — full macro definition (params + template + scope)
//   MacroExpander   — top-level expander with definition table, expansion
//                     stack for recursion detection, and gensym counter
//
// All data structures use flat-array arena pattern (no recursive types)
// consistent with the self-hosted checker's design.

// ============================================================
// Macro parameter kind constants
// ============================================================

let MACRO_PARAM_EXPR: i64 = 1
let MACRO_PARAM_TYPE: i64 = 2
let MACRO_PARAM_IDENT: i64 = 3
let MACRO_PARAM_BLOCK: i64 = 4

// ============================================================
// Expansion result status constants
// ============================================================

let EXPAND_OK: i64 = 0
let EXPAND_ERR_NOT_FOUND: i64 = 1
let EXPAND_ERR_RECURSION: i64 = 2
let EXPAND_ERR_ARG_COUNT: i64 = 3
let EXPAND_ERR_PATTERN: i64 = 4
let EXPAND_ERR_OVERFLOW: i64 = 5

// ============================================================
// Token kind constants (for template tokens)
// ============================================================

let TOK_LITERAL: i64 = 0
let TOK_PARAM_REF: i64 = 1
let TOK_GENSYM: i64 = 2
let TOK_SPLICE: i64 = 3
let TOK_SEPARATOR: i64 = 4

// ============================================================
// MacroParam — a single macro parameter descriptor
// ============================================================

struct MacroParam {
    name: [i8; 64],
    name_len: i64,
    kind: i64,
    is_variadic: bool,
}

fn macro_param_new() -> MacroParam {
    MacroParam {
        name: [0; 64],
        name_len: 0,
        kind: MACRO_PARAM_EXPR,
        is_variadic: false,
    }
}

fn macro_param_with_kind(kind: i64) -> MacroParam with Mut {
    var p = macro_param_new()
    p.kind = kind
    p
}

// ============================================================
// MacroParam: set name from individual bytes
// ============================================================

fn macro_param_set_name(param: MacroParam, src: [i8; 64], src_len: i64) -> MacroParam with Mut, Panic, Div {
    var p = param
    var i: i64 = 0
    while i < src_len && i < 64 {
        p.name[i as usize] = src[i as usize]
        i = i + 1
    }
    p.name_len = src_len
    p
}

// ============================================================
// MacroParam: name comparison
// ============================================================

fn macro_param_name_eq(a: MacroParam, b_name: [i8; 64], b_len: i64) -> bool with Mut, Panic, Div {
    if a.name_len != b_len {
        return false
    }
    var i: i64 = 0
    while i < a.name_len {
        if a.name[i as usize] != b_name[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================
// MacroTemplate — token sequence with parameter references
// ============================================================
//
// tokens[]        — token kind tags (TOK_LITERAL, TOK_PARAM_REF, etc.)
// param_refs[]    — for TOK_PARAM_REF tokens: which param index to splice
// literal_parts[] — for TOK_LITERAL tokens: literal text content

struct MacroTemplate {
    tokens: [i64; 512],
    token_count: i64,
    param_refs: [i64; 64],
    param_ref_count: i64,
    literal_parts: [[i8; 64]; 128],
    literal_count: i64,
}

fn macro_template_new() -> MacroTemplate {
    MacroTemplate {
        tokens: [0; 512],
        token_count: 0,
        param_refs: [0; 64],
        param_ref_count: 0,
        literal_parts: [[0; 64]; 128],
        literal_count: 0,
    }
}

// ============================================================
// MacroTemplate: append a literal token
// ============================================================

fn macro_template_add_literal(tmpl: MacroTemplate, text: [i8; 64]) -> MacroTemplate with Mut, Panic, Div {
    var t = tmpl
    if t.token_count >= 512 || t.literal_count >= 128 {
        return t
    }
    t.tokens[t.token_count as usize] = TOK_LITERAL
    t.literal_parts[t.literal_count as usize] = text
    t.literal_count = t.literal_count + 1
    t.token_count = t.token_count + 1
    t
}

// ============================================================
// MacroTemplate: append a parameter reference token
// ============================================================

fn macro_template_add_param_ref(tmpl: MacroTemplate, param_idx: i64) -> MacroTemplate with Mut, Panic, Div {
    var t = tmpl
    if t.token_count >= 512 || t.param_ref_count >= 64 {
        return t
    }
    t.tokens[t.token_count as usize] = TOK_PARAM_REF
    t.param_refs[t.param_ref_count as usize] = param_idx
    t.param_ref_count = t.param_ref_count + 1
    t.token_count = t.token_count + 1
    t
}

// ============================================================
// MacroTemplate: append a gensym placeholder token
// ============================================================

fn macro_template_add_gensym(tmpl: MacroTemplate) -> MacroTemplate with Mut, Panic, Div {
    var t = tmpl
    if t.token_count >= 512 {
        return t
    }
    t.tokens[t.token_count as usize] = TOK_GENSYM
    t.token_count = t.token_count + 1
    t
}

// ============================================================
// MacroTemplate: append a splice (variadic expansion) token
// ============================================================

fn macro_template_add_splice(tmpl: MacroTemplate, param_idx: i64) -> MacroTemplate with Mut, Panic, Div {
    var t = tmpl
    if t.token_count >= 512 || t.param_ref_count >= 64 {
        return t
    }
    t.tokens[t.token_count as usize] = TOK_SPLICE
    t.param_refs[t.param_ref_count as usize] = param_idx
    t.param_ref_count = t.param_ref_count + 1
    t.token_count = t.token_count + 1
    t
}

// ============================================================
// MacroTemplate: append a separator token
// ============================================================

fn macro_template_add_separator(tmpl: MacroTemplate, sep: [i8; 64]) -> MacroTemplate with Mut, Panic, Div {
    var t = tmpl
    if t.token_count >= 512 || t.literal_count >= 128 {
        return t
    }
    t.tokens[t.token_count as usize] = TOK_SEPARATOR
    t.literal_parts[t.literal_count as usize] = sep
    t.literal_count = t.literal_count + 1
    t.token_count = t.token_count + 1
    t
}

// ============================================================
// MacroTemplate: count tokens of a specific kind
// ============================================================

fn macro_template_count_kind(tmpl: MacroTemplate, kind: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < tmpl.token_count {
        if tmpl.tokens[i as usize] == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================
// MacroDef — a complete macro definition
// ============================================================

struct MacroDef {
    name: [i8; 64],
    name_len: i64,
    params: [MacroParam; 16],
    param_count: i64,
    template: MacroTemplate,
    scope_id: i64,
    is_builtin: bool,
}

fn macro_def_new() -> MacroDef {
    MacroDef {
        name: [0; 64],
        name_len: 0,
        params: [macro_param_new(); 16],
        param_count: 0,
        template: macro_template_new(),
        scope_id: 0,
        is_builtin: false,
    }
}

// ============================================================
// MacroDef: set name
// ============================================================

fn macro_def_set_name(def: MacroDef, src: [i8; 64], src_len: i64) -> MacroDef with Mut, Panic, Div {
    var d = def
    var i: i64 = 0
    while i < src_len && i < 64 {
        d.name[i as usize] = src[i as usize]
        i = i + 1
    }
    d.name_len = src_len
    d
}

// ============================================================
// MacroDef: add a parameter
// ============================================================

fn macro_def_add_param(def: MacroDef, param: MacroParam) -> MacroDef with Mut, Panic, Div {
    var d = def
    if d.param_count >= 16 {
        return d
    }
    d.params[d.param_count as usize] = param
    d.param_count = d.param_count + 1
    d
}

// ============================================================
// MacroDef: name comparison
// ============================================================

fn macro_def_name_eq(def: MacroDef, target: [i8; 64], target_len: i64) -> bool with Mut, Panic, Div {
    if def.name_len != target_len {
        return false
    }
    var i: i64 = 0
    while i < def.name_len {
        if def.name[i as usize] != target[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================
// MacroDef: find parameter by name (returns index or -1)
// ============================================================

fn macro_def_find_param(def: MacroDef, pname: [i8; 64], plen: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < def.param_count {
        if macro_param_name_eq(def.params[i as usize], pname, plen) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// ============================================================
// MacroDef: check if any parameter is variadic
// ============================================================

fn macro_def_has_variadic(def: MacroDef) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < def.param_count {
        if def.params[i as usize].is_variadic {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================
// Expansion argument buffer — stores the actual arguments
// passed to a macro invocation
// ============================================================

struct MacroArgs {
    tokens: [[i64; 32]; 16],
    token_counts: [i64; 16],
    arg_count: i64,
    arg_kinds: [i64; 16],
}

fn macro_args_new() -> MacroArgs {
    MacroArgs {
        tokens: [[0; 32]; 16],
        token_counts: [0; 16],
        arg_count: 0,
        arg_kinds: [0; 16],
    }
}

// ============================================================
// MacroArgs: add an argument
// ============================================================

fn macro_args_add(args: MacroArgs, toks: [i64; 32], tok_count: i64, kind: i64) -> MacroArgs with Mut, Panic, Div {
    var a = args
    if a.arg_count >= 16 {
        return a
    }
    let idx = a.arg_count
    a.tokens[idx as usize] = toks
    a.token_counts[idx as usize] = tok_count
    a.arg_kinds[idx as usize] = kind
    a.arg_count = a.arg_count + 1
    a
}

// ============================================================
// MacroArgs: get token count for argument at index
// ============================================================

fn macro_args_get_count(args: MacroArgs, idx: i64) -> i64 with Panic, Div {
    if idx < 0 || idx >= args.arg_count {
        return 0
    }
    args.token_counts[idx as usize]
}

// ============================================================
// Expansion output buffer
// ============================================================

struct ExpansionOutput {
    tokens: [i64; 1024],
    token_count: i64,
    names: [[i8; 64]; 256],
    name_count: i64,
    status: i64,
}

fn expansion_output_new() -> ExpansionOutput {
    ExpansionOutput {
        tokens: [0; 1024],
        token_count: 0,
        names: [[0; 64]; 256],
        name_count: 0,
        status: EXPAND_OK,
    }
}

// ============================================================
// ExpansionOutput: append a token
// ============================================================

fn expansion_output_push(out: ExpansionOutput, tok: i64) -> ExpansionOutput with Mut, Panic, Div {
    var o = out
    if o.token_count >= 1024 {
        o.status = EXPAND_ERR_OVERFLOW
        return o
    }
    o.tokens[o.token_count as usize] = tok
    o.token_count = o.token_count + 1
    o
}

// ============================================================
// ExpansionOutput: append a generated name
// ============================================================

fn expansion_output_push_name(out: ExpansionOutput, nm: [i8; 64]) -> ExpansionOutput with Mut, Panic, Div {
    var o = out
    if o.name_count >= 256 {
        o.status = EXPAND_ERR_OVERFLOW
        return o
    }
    o.names[o.name_count as usize] = nm
    o.name_count = o.name_count + 1
    o
}

// ============================================================
// MacroExpander — top-level expansion engine
// ============================================================

struct MacroExpander {
    defs: [MacroDef; 256],
    def_count: i64,
    expansion_stack: [i64; 32],
    stack_depth: i64,
    gensym_counter: i64,
    total_expansions: i64,
    max_depth: i64,
}

fn macro_expander_new() -> MacroExpander {
    MacroExpander {
        defs: [macro_def_new(); 256],
        def_count: 0,
        expansion_stack: [0; 32],
        stack_depth: 0,
        gensym_counter: 0,
        total_expansions: 0,
        max_depth: 32,
    }
}

// ============================================================
// MacroExpander: register a macro definition
// ============================================================

fn macro_register(exp: MacroExpander, def: MacroDef) -> MacroExpander with Mut, Panic, Div {
    var e = exp
    if e.def_count >= 256 {
        return e
    }
    e.defs[e.def_count as usize] = def
    e.def_count = e.def_count + 1
    e
}

// ============================================================
// MacroExpander: lookup macro by name (returns index or -1)
// ============================================================

fn macro_lookup(exp: MacroExpander, name: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
    // Search from most recent to earliest (supports shadowing)
    var i: i64 = exp.def_count - 1
    while i >= 0 {
        if macro_def_name_eq(exp.defs[i as usize], name, name_len) {
            return i
        }
        i = i - 1
    }
    0 - 1
}

// ============================================================
// MacroExpander: lookup macro by name within a scope
// ============================================================

fn macro_lookup_in_scope(exp: MacroExpander, name: [i8; 64], name_len: i64, scope_id: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = exp.def_count - 1
    while i >= 0 {
        let def = exp.defs[i as usize]
        if def.scope_id <= scope_id {
            if macro_def_name_eq(def, name, name_len) {
                return i
            }
        }
        i = i - 1
    }
    0 - 1
}

// ============================================================
// MacroExpander: check for infinite recursion
// ============================================================

fn macro_check_recursion(exp: MacroExpander, def_idx: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < exp.stack_depth {
        if exp.expansion_stack[i as usize] == def_idx {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================
// MacroExpander: push onto expansion stack
// ============================================================

fn macro_push_stack(exp: MacroExpander, def_idx: i64) -> MacroExpander with Mut, Panic, Div {
    var e = exp
    if e.stack_depth >= 32 {
        return e
    }
    e.expansion_stack[e.stack_depth as usize] = def_idx
    e.stack_depth = e.stack_depth + 1
    e
}

// ============================================================
// MacroExpander: pop expansion stack
// ============================================================

fn macro_pop_stack(exp: MacroExpander) -> MacroExpander with Mut {
    var e = exp
    if e.stack_depth > 0 {
        e.stack_depth = e.stack_depth - 1
    }
    e
}

// ============================================================
// MacroExpander: generate a hygienic unique name (gensym)
// ============================================================
//
// Produces a name like "__gensym_NNN" where NNN is the counter
// value. This ensures no collisions with user-defined names.

fn macro_gensym(exp: MacroExpander) -> (MacroExpander, [i8; 64], i64) with Mut, Panic, Div {
    var e = exp
    var buf: [i8; 64] = [0; 64]
    // Prefix: __gensym_
    buf[0] = 95    // '_'
    buf[1] = 95    // '_'
    buf[2] = 103   // 'g'
    buf[3] = 101   // 'e'
    buf[4] = 110   // 'n'
    buf[5] = 115   // 's'
    buf[6] = 121   // 'y'
    buf[7] = 109   // 'm'
    buf[8] = 95    // '_'

    // Convert counter to decimal digits
    var num = e.gensym_counter
    var digits: [i8; 20] = [0; 20]
    var digit_count: i64 = 0

    if num == 0 {
        digits[0] = 48  // '0'
        digit_count = 1
    } else {
        var tmp = num
        while tmp > 0 {
            let d = tmp - (tmp / 10) * 10
            digits[digit_count as usize] = (48 + d) as i8
            digit_count = digit_count + 1
            tmp = tmp / 10
        }
    }

    // Write digits in reverse into buf starting at position 9
    var pos: i64 = 9
    var d_idx: i64 = digit_count - 1
    while d_idx >= 0 {
        if pos < 64 {
            buf[pos as usize] = digits[d_idx as usize]
            pos = pos + 1
        }
        d_idx = d_idx - 1
    }

    let total_len = pos
    e.gensym_counter = e.gensym_counter + 1
    (e, buf, total_len)
}

// ============================================================
// MacroExpander: count total expansions performed
// ============================================================

fn macro_count_expansions(exp: MacroExpander) -> i64 {
    exp.total_expansions
}

// ============================================================
// Name byte comparison helper (compare two [i8; 64] arrays)
// ============================================================

fn name64_eq(a: [i8; 64], a_len: i64, b: [i8; 64], b_len: i64) -> bool with Mut, Panic, Div {
    if a_len != b_len {
        return false
    }
    var i: i64 = 0
    while i < a_len {
        if a[i as usize] != b[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================
// Name byte copy helper
// ============================================================

fn name64_copy(src: [i8; 64], src_len: i64) -> [i8; 64] with Mut, Panic, Div {
    var dst: [i8; 64] = [0; 64]
    var i: i64 = 0
    while i < src_len && i < 64 {
        dst[i as usize] = src[i as usize]
        i = i + 1
    }
    dst
}

// ============================================================
// Make a name from a short ASCII string (up to 16 chars)
// ============================================================

fn make_name64(c0: i8, c1: i8, c2: i8, c3: i8, len: i64) -> [i8; 64] with Mut, Panic, Div {
    var buf: [i8; 64] = [0; 64]
    if len >= 1 { buf[0] = c0 }
    if len >= 2 { buf[1] = c1 }
    if len >= 3 { buf[2] = c2 }
    if len >= 4 { buf[3] = c3 }
    buf
}

// ============================================================
// MacroExpander: validate a macro definition
// ============================================================
//
// Checks:
//   - Name is non-empty
//   - No duplicate parameter names
//   - Parameter kinds are valid (1..4)
//   - At most one variadic parameter (must be last)
//   - Template param_refs reference valid parameter indices
//
// Returns 0 on success, error code on failure.

fn macro_validate_def(def: MacroDef) -> i64 with Mut, Panic, Div {
    // Check name is non-empty
    if def.name_len <= 0 {
        return 1
    }

    // Check parameter kinds are valid
    var i: i64 = 0
    while i < def.param_count {
        let k = def.params[i as usize].kind
        if k < MACRO_PARAM_EXPR || k > MACRO_PARAM_BLOCK {
            return 2
        }
        i = i + 1
    }

    // Check for duplicate parameter names
    var a: i64 = 0
    while a < def.param_count {
        var b: i64 = a + 1
        while b < def.param_count {
            if macro_param_name_eq(def.params[a as usize],
                                   def.params[b as usize].name,
                                   def.params[b as usize].name_len) {
                return 3
            }
            b = b + 1
        }
        a = a + 1
    }

    // Check variadic: at most one, must be last
    var variadic_count: i64 = 0
    var last_variadic_idx: i64 = 0 - 1
    var v: i64 = 0
    while v < def.param_count {
        if def.params[v as usize].is_variadic {
            variadic_count = variadic_count + 1
            last_variadic_idx = v
        }
        v = v + 1
    }
    if variadic_count > 1 {
        return 4
    }
    if variadic_count == 1 && last_variadic_idx != def.param_count - 1 {
        return 5
    }

    // Check template param_refs reference valid indices
    var r: i64 = 0
    while r < def.template.param_ref_count {
        let ref_idx = def.template.param_refs[r as usize]
        if ref_idx < 0 || ref_idx >= def.param_count {
            return 6
        }
        r = r + 1
    }

    0
}

// ============================================================
// macro_match_pattern — check if argument tokens match the
// expected parameter pattern of a macro definition
// ============================================================
//
// Validates:
//   - Argument count matches parameter count (or >= for variadic)
//   - Argument kinds match parameter kinds where specified
//
// Returns true if pattern matches.

fn macro_match_pattern(def: MacroDef, args: MacroArgs) -> bool with Mut, Panic, Div {
    let has_variadic = macro_def_has_variadic(def)

    // Non-variadic: exact count match required
    if !has_variadic {
        if args.arg_count != def.param_count {
            return false
        }
    } else {
        // Variadic: at least (param_count - 1) args required
        if args.arg_count < def.param_count - 1 {
            return false
        }
    }

    // Check kinds for non-variadic parameters
    var i: i64 = 0
    let check_count = if has_variadic { def.param_count - 1 } else { def.param_count }
    while i < check_count {
        if i < args.arg_count {
            let expected_kind = def.params[i as usize].kind
            let actual_kind = args.arg_kinds[i as usize]
            // Kind 0 means "any" — skip check
            if actual_kind != 0 && expected_kind != actual_kind {
                return false
            }
        }
        i = i + 1
    }

    true
}

// ============================================================
// macro_substitute — replace parameter references in template
// with actual argument tokens
// ============================================================
//
// Walks the template token array. For each TOK_PARAM_REF, looks up
// the corresponding argument and splices it in. For TOK_GENSYM,
// generates a fresh hygienic name. TOK_LITERAL tokens are copied
// directly. TOK_SPLICE expands a variadic argument.

fn macro_substitute(
    exp: MacroExpander,
    def: MacroDef,
    args: MacroArgs
) -> (MacroExpander, ExpansionOutput) with Mut, Panic, Div {
    var e = exp
    var out = expansion_output_new()
    var param_ref_idx: i64 = 0
    var literal_idx: i64 = 0

    var t: i64 = 0
    while t < def.template.token_count {
        let tok_kind = def.template.tokens[t as usize]

        if tok_kind == TOK_LITERAL {
            // Copy literal token to output
            if literal_idx < def.template.literal_count {
                out = expansion_output_push(out, TOK_LITERAL)
                out = expansion_output_push_name(out, def.template.literal_parts[literal_idx as usize])
                literal_idx = literal_idx + 1
            }
        } else if tok_kind == TOK_PARAM_REF {
            // Splice argument tokens at this position
            if param_ref_idx < def.template.param_ref_count {
                let pidx = def.template.param_refs[param_ref_idx as usize]
                param_ref_idx = param_ref_idx + 1
                if pidx >= 0 && pidx < args.arg_count {
                    let arg_tc = args.token_counts[pidx as usize]
                    var ai: i64 = 0
                    while ai < arg_tc {
                        let arg_tok = args.tokens[pidx as usize][ai as usize]
                        out = expansion_output_push(out, arg_tok)
                        ai = ai + 1
                    }
                }
            }
        } else if tok_kind == TOK_GENSYM {
            // Generate a fresh hygienic name
            let gs_result = macro_gensym(e)
            e = gs_result.0
            let gs_name = gs_result.1
            let gs_len = gs_result.2
            out = expansion_output_push(out, TOK_GENSYM)
            out = expansion_output_push_name(out, gs_name)
        } else if tok_kind == TOK_SPLICE {
            // Splice variadic argument tokens
            if param_ref_idx < def.template.param_ref_count {
                let vidx = def.template.param_refs[param_ref_idx as usize]
                param_ref_idx = param_ref_idx + 1
                // Splice all args starting from vidx
                var si: i64 = vidx
                while si < args.arg_count {
                    let stc = args.token_counts[si as usize]
                    var sj: i64 = 0
                    while sj < stc {
                        let stok = args.tokens[si as usize][sj as usize]
                        out = expansion_output_push(out, stok)
                        sj = sj + 1
                    }
                    si = si + 1
                }
            }
        } else if tok_kind == TOK_SEPARATOR {
            // Copy separator literal
            if literal_idx < def.template.literal_count {
                out = expansion_output_push(out, TOK_SEPARATOR)
                out = expansion_output_push_name(out, def.template.literal_parts[literal_idx as usize])
                literal_idx = literal_idx + 1
            }
        }

        t = t + 1
    }

    (e, out)
}

// ============================================================
// macro_expand — main expansion entry point
// ============================================================
//
// 1. Lookup the macro definition by name
// 2. Check for recursive expansion
// 3. Validate argument pattern
// 4. Push onto expansion stack
// 5. Substitute template
// 6. Pop expansion stack
// 7. Increment expansion counter

fn macro_expand(
    exp: MacroExpander,
    name: [i8; 64],
    name_len: i64,
    args: MacroArgs
) -> (MacroExpander, ExpansionOutput) with Mut, Panic, Div {
    var e = exp

    // Step 1: Lookup
    let def_idx = macro_lookup(e, name, name_len)
    if def_idx < 0 {
        var out = expansion_output_new()
        out.status = EXPAND_ERR_NOT_FOUND
        return (e, out)
    }

    let def = e.defs[def_idx as usize]

    // Step 2: Recursion check
    if macro_check_recursion(e, def_idx) {
        var out = expansion_output_new()
        out.status = EXPAND_ERR_RECURSION
        return (e, out)
    }

    // Step 3: Pattern match
    if !macro_match_pattern(def, args) {
        var out = expansion_output_new()
        out.status = EXPAND_ERR_ARG_COUNT
        return (e, out)
    }

    // Step 4: Push stack
    e = macro_push_stack(e, def_idx)

    // Step 5: Substitute
    let sub_result = macro_substitute(e, def, args)
    e = sub_result.0
    let out = sub_result.1

    // Step 6: Pop stack
    e = macro_pop_stack(e)

    // Step 7: Increment counter
    e.total_expansions = e.total_expansions + 1

    (e, out)
}

// ============================================================
// Builtin macro helpers
// ============================================================

fn macro_make_builtin(name: [i8; 64], name_len: i64, param_count: i64) -> MacroDef with Mut, Panic, Div {
    var def = macro_def_new()
    def = macro_def_set_name(def, name, name_len)
    def.is_builtin = true
    var i: i64 = 0
    while i < param_count && i < 16 {
        var p = macro_param_new()
        p.kind = MACRO_PARAM_EXPR
        def = macro_def_add_param(def, p)
        i = i + 1
    }
    def
}

// ============================================================
// MacroExpander: register common built-in macros
// ============================================================
//
// Registers placeholders for built-in compile-time macros:
//   - line (0 params) — current source line
//   - column (0 params) — current source column
//   - file (0 params) — current source file
//   - stringify (1 param) — token-to-string
//   - concat (variadic) — concatenate literals

fn macro_register_builtins(exp: MacroExpander) -> MacroExpander with Mut, Panic, Div {
    var e = exp

    // line
    var line_name: [i8; 64] = [0; 64]
    line_name[0] = 108  // 'l'
    line_name[1] = 105  // 'i'
    line_name[2] = 110  // 'n'
    line_name[3] = 101  // 'e'
    let line_def = macro_make_builtin(line_name, 4, 0)
    e = macro_register(e, line_def)

    // column
    var col_name: [i8; 64] = [0; 64]
    col_name[0] = 99   // 'c'
    col_name[1] = 111  // 'o'
    col_name[2] = 108  // 'l'
    col_name[3] = 117  // 'u'
    col_name[4] = 109  // 'm'
    col_name[5] = 110  // 'n'
    let col_def = macro_make_builtin(col_name, 6, 0)
    e = macro_register(e, col_def)

    // file
    var file_name: [i8; 64] = [0; 64]
    file_name[0] = 102  // 'f'
    file_name[1] = 105  // 'i'
    file_name[2] = 108  // 'l'
    file_name[3] = 101  // 'e'
    let file_def = macro_make_builtin(file_name, 4, 0)
    e = macro_register(e, file_def)

    // stringify (1 param)
    var str_name: [i8; 64] = [0; 64]
    str_name[0] = 115  // 's'
    str_name[1] = 116  // 't'
    str_name[2] = 114  // 'r'
    str_name[3] = 105  // 'i'
    str_name[4] = 110  // 'n'
    str_name[5] = 103  // 'g'
    str_name[6] = 105  // 'i'
    str_name[7] = 102  // 'f'
    str_name[8] = 121  // 'y'
    let str_def = macro_make_builtin(str_name, 9, 1)
    e = macro_register(e, str_def)

    // concat (variadic, 1 variadic param)
    var cat_name: [i8; 64] = [0; 64]
    cat_name[0] = 99   // 'c'
    cat_name[1] = 111  // 'o'
    cat_name[2] = 110  // 'n'
    cat_name[3] = 99   // 'c'
    cat_name[4] = 97   // 'a'
    cat_name[5] = 116  // 't'
    var cat_def = macro_def_new()
    cat_def = macro_def_set_name(cat_def, cat_name, 6)
    cat_def.is_builtin = true
    var vp = macro_param_new()
    vp.kind = MACRO_PARAM_EXPR
    vp.is_variadic = true
    cat_def = macro_def_add_param(cat_def, vp)
    e = macro_register(e, cat_def)

    e
}

// ============================================================
// MacroExpander: count registered macros
// ============================================================

fn macro_expander_def_count(exp: MacroExpander) -> i64 {
    exp.def_count
}

// ============================================================
// MacroExpander: count builtins
// ============================================================

fn macro_expander_builtin_count(exp: MacroExpander) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < exp.def_count {
        if exp.defs[i as usize].is_builtin {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================
// MacroExpander: reset expansion stack (for error recovery)
// ============================================================

fn macro_reset_stack(exp: MacroExpander) -> MacroExpander with Mut, Panic, Div {
    var e = exp
    e.stack_depth = 0
    var i: i64 = 0
    while i < 32 {
        e.expansion_stack[i as usize] = 0
        i = i + 1
    }
    e
}

// ============================================================
// MacroExpander: check if a name is a known macro
// ============================================================

fn macro_is_defined(exp: MacroExpander, name: [i8; 64], name_len: i64) -> bool with Mut, Panic, Div {
    let idx = macro_lookup(exp, name, name_len)
    idx >= 0
}

// ============================================================
// MacroExpander: remove a macro definition by index
// ============================================================

fn macro_unregister(exp: MacroExpander, idx: i64) -> MacroExpander with Mut, Panic, Div {
    var e = exp
    if idx < 0 || idx >= e.def_count {
        return e
    }
    // Shift everything down
    var i: i64 = idx
    while i < e.def_count - 1 {
        e.defs[i as usize] = e.defs[(i + 1) as usize]
        i = i + 1
    }
    e.def_count = e.def_count - 1
    e
}

// ============================================================
// MacroExpander: get definition at index
// ============================================================

fn macro_get_def(exp: MacroExpander, idx: i64) -> MacroDef with Panic, Div {
    exp.defs[idx as usize]
}

// ============================================================
// MacroExpander: get current gensym counter value
// ============================================================

fn macro_gensym_counter(exp: MacroExpander) -> i64 {
    exp.gensym_counter
}

// ============================================================
// MacroExpander: get current stack depth
// ============================================================

fn macro_stack_depth(exp: MacroExpander) -> i64 {
    exp.stack_depth
}

// ============================================================
// Scope filtering: collect all macros visible from scope
// ============================================================

fn macro_count_in_scope(exp: MacroExpander, scope_id: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < exp.def_count {
        if exp.defs[i as usize].scope_id <= scope_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// ============================================================
// Template analysis: check if a template references a given param
// ============================================================

fn macro_template_uses_param(tmpl: MacroTemplate, param_idx: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < tmpl.param_ref_count {
        if tmpl.param_refs[i as usize] == param_idx {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================
// Expansion depth limit check
// ============================================================

fn macro_depth_exceeded(exp: MacroExpander) -> bool {
    exp.stack_depth >= exp.max_depth
}

// ============================================================
// Test helpers
// ============================================================

fn macro_assert_true(cond: bool, test_id: i64) -> i64 with IO, Mut, Panic, Div {
    if cond {
        print("  PASS test ")
        print_int(test_id)
        print("\n")
        return 0
    } else {
        print("  FAIL test ")
        print_int(test_id)
        print("\n")
        return 1
    }
}

// Helper: make a test name in a [i8; 64] buffer
fn test_make_name(a: i8, b: i8, c: i8, len: i64) -> [i8; 64] with Mut, Panic, Div {
    var buf: [i8; 64] = [0; 64]
    if len >= 1 { buf[0] = a }
    if len >= 2 { buf[1] = b }
    if len >= 3 { buf[2] = c }
    buf
}

// Helper: make a 5-char name
fn test_make_name5(a: i8, b: i8, c: i8, d: i8, e: i8) -> [i8; 64] with Mut, Panic, Div {
    var buf: [i8; 64] = [0; 64]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf[4] = e
    buf
}

// ============================================================
// Test 1: MacroParam construction and defaults
// ============================================================

fn test_macro_param_new() -> i64 with IO, Mut, Panic, Div {
    let p = macro_param_new()
    let ok1 = p.name_len == 0
    let ok2 = p.kind == MACRO_PARAM_EXPR
    let ok3 = p.is_variadic == false
    macro_assert_true(ok1 && ok2 && ok3, 1)
}

// ============================================================
// Test 2: MacroParam kind constructor
// ============================================================

fn test_macro_param_kind() -> i64 with IO, Mut, Panic, Div {
    let p1 = macro_param_with_kind(MACRO_PARAM_TYPE)
    let p2 = macro_param_with_kind(MACRO_PARAM_IDENT)
    let p3 = macro_param_with_kind(MACRO_PARAM_BLOCK)
    let ok1 = p1.kind == MACRO_PARAM_TYPE
    let ok2 = p2.kind == MACRO_PARAM_IDENT
    let ok3 = p3.kind == MACRO_PARAM_BLOCK
    macro_assert_true(ok1 && ok2 && ok3, 2)
}

// ============================================================
// Test 3: MacroParam name set and compare
// ============================================================

fn test_macro_param_name() -> i64 with IO, Mut, Panic, Div {
    var p = macro_param_new()
    // name = "abc"
    let nm = test_make_name(97, 98, 99, 3)
    p = macro_param_set_name(p, nm, 3)
    let ok1 = p.name_len == 3
    let ok2 = macro_param_name_eq(p, nm, 3)
    // Different name should not match
    let nm2 = test_make_name(120, 121, 122, 3)
    let ok3 = !macro_param_name_eq(p, nm2, 3)
    macro_assert_true(ok1 && ok2 && ok3, 3)
}

// ============================================================
// Test 4: MacroTemplate construction and add literal
// ============================================================

fn test_macro_template_literal() -> i64 with IO, Mut, Panic, Div {
    var tmpl = macro_template_new()
    let ok1 = tmpl.token_count == 0
    let lit = test_make_name(65, 66, 67, 3)
    tmpl = macro_template_add_literal(tmpl, lit)
    let ok2 = tmpl.token_count == 1
    let ok3 = tmpl.literal_count == 1
    let ok4 = tmpl.tokens[0] == TOK_LITERAL
    macro_assert_true(ok1 && ok2 && ok3 && ok4, 4)
}

// ============================================================
// Test 5: MacroTemplate param ref
// ============================================================

fn test_macro_template_param_ref() -> i64 with IO, Mut, Panic, Div {
    var tmpl = macro_template_new()
    tmpl = macro_template_add_param_ref(tmpl, 0)
    tmpl = macro_template_add_param_ref(tmpl, 2)
    let ok1 = tmpl.token_count == 2
    let ok2 = tmpl.param_ref_count == 2
    let ok3 = tmpl.param_refs[0] == 0
    let ok4 = tmpl.param_refs[1] == 2
    let ok5 = tmpl.tokens[0] == TOK_PARAM_REF
    let ok6 = tmpl.tokens[1] == TOK_PARAM_REF
    macro_assert_true(ok1 && ok2 && ok3 && ok4 && ok5 && ok6, 5)
}

// ============================================================
// Test 6: MacroTemplate mixed tokens
// ============================================================

fn test_macro_template_mixed() -> i64 with IO, Mut, Panic, Div {
    var tmpl = macro_template_new()
    let lit1 = test_make_name(65, 0, 0, 1)
    tmpl = macro_template_add_literal(tmpl, lit1)
    tmpl = macro_template_add_param_ref(tmpl, 0)
    tmpl = macro_template_add_gensym(tmpl)
    let lit2 = test_make_name(66, 0, 0, 1)
    tmpl = macro_template_add_literal(tmpl, lit2)
    let ok1 = tmpl.token_count == 4
    let ok2 = tmpl.tokens[0] == TOK_LITERAL
    let ok3 = tmpl.tokens[1] == TOK_PARAM_REF
    let ok4 = tmpl.tokens[2] == TOK_GENSYM
    let ok5 = tmpl.tokens[3] == TOK_LITERAL
    macro_assert_true(ok1 && ok2 && ok3 && ok4 && ok5, 6)
}

