fn test_loc_suggest_tiling_applicable_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 1000000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100000, LOC_INVALID)
    // Large stride, many iterations — working set exceeds L1
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let config = loc_suggest_tiling(ctx, 0)
    if loc_tile_status_to_int(config.status) != 0 { return false }
    if config.factor <= 1 { return false }
    true
}
fn test_loc_suggest_tiling_applicable() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_suggest_tiling_applicable_inner(&! ctx)
}

