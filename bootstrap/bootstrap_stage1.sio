fn write_mechanistic_report_info(buf: [i8; 131072], pos: i64, info: IrMechanisticReportInfo) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos
    let p0 = write_f64(b, p, info.latent_state_divergence)
    b = p0.0
    p = p0.1
    let p1 = write_f64(b, p, info.causal_decomposition_divergence)
    b = p1.0
    p = p1.1
    let p2 = write_f64(b, p, info.intervention_response_divergence)
    b = p2.0
    p = p2.1
    let p3 = write_f64(b, p, info.parameter_role_divergence)
    b = p3.0
    p = p3.1
