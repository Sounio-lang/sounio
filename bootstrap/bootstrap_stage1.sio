    s = recv_report_error(s, 1, 2, 2, 2, msg, 0)
    s = recv_report_error(s, 1, 3, 3, 3, msg, 0)  // should be dropped
    s = recv_report_error(s, 1, 4, 4, 4, msg, 0)  // should be dropped
    let label = recv_test_label(
        84, 50, 54, 0, 0, 0, 0, 0, 0, 0, 3)  // "T26"
    recv_assert_true(recv_error_count(s) == 2, label.0, label.1)
}

