    g = mod_graph_add_dep(g, 1, 0)

    let can_see = mod_graph_visibility_check(g, 1, 0, 0)
    mod_assert_true(can_see, 16)
}

// T17: Visibility — public export but no dependency edge
fn test_mod_visibility_no_dep_edge() -> i64 with IO, Mut, Panic, Div {
