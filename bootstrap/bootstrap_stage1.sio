fn test_loc_misses_multiple_accesses_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr1 = loc_add_array(ctx, 8000, 8, 1)
    let arr2 = loc_add_array(ctx, 4000, 4, 1)
    let lp = loc_add_loop(ctx, 0, 1000, LOC_INVALID)
    let a1 = loc_add_access(ctx, arr1, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let a2 = loc_add_access(ctx, arr2, 0, 4, LocStrideKind::StrideUnit, lp, 4, 2)
    let misses = loc_estimate_cache_misses(ctx, 0)
    // arr1: 1000/8 = 125, arr2: 1000/16 = 63
    // Total = 125 + 63 = 188
    if misses != 188 { return false }
    true
}
fn test_loc_misses_multiple_accesses() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_misses_multiple_accesses_inner(&! ctx)
}

fn test_loc_misses_affine_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 80000, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100, LOC_INVALID)
    let acc = loc_add_access(ctx, arr, 0, 13, LocStrideKind::StrideAffine, lp, 8, 1)
    let misses = loc_estimate_cache_misses(ctx, 0)
    // Affine: miss every other iteration = ceil(100/2) = 50
    if misses != 50 { return false }
    true
}
fn test_loc_misses_affine() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    test_loc_misses_affine_inner(&! ctx)
}

fn test_loc_misses_invalid_loop() -> bool with Mut, Div, Panic {
    var ctx = loc_context_new()
    let misses = loc_estimate_cache_misses(&! ctx, 99)
    misses == 0
}

