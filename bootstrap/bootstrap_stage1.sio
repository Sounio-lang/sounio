        p = pair.1
        i = i + 1
    }

    let c16 = write_i64(b, p, ep.acquisition_plan_count)
    b = c16.0
    p = c16.1
    i = 0
    while i < ep.acquisition_plan_count {
        let pair = write_acquisition_plan_info(b, p, ep.acquisition_plans[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c17 = write_i64(b, p, ep.acquisition_reason_witness_count)
    b = c17.0
    p = c17.1
    i = 0
    while i < ep.acquisition_reason_witness_count {
        let pair = write_acquisition_reason_witness_info(b, p, ep.acquisition_reason_witnesses[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c18 = write_i64(b, p, ep.recourse_policy_count)
    b = c18.0
    p = c18.1
    i = 0
    while i < ep.recourse_policy_count {
        let pair = write_recourse_policy_info(b, p, ep.recourse_policies[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c19 = write_i64(b, p, ep.recourse_plan_count)
    b = c19.0
    p = c19.1
    i = 0
    while i < ep.recourse_plan_count {
        let pair = write_recourse_plan_info(b, p, ep.recourse_plans[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c20 = write_i64(b, p, ep.recourse_reason_witness_count)
    b = c20.0
    p = c20.1
    i = 0
    while i < ep.recourse_reason_witness_count {
        let pair = write_recourse_reason_witness_info(b, p, ep.recourse_reason_witnesses[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c21 = write_i64(b, p, ep.alternative_policy_count)
    b = c21.0
    p = c21.1
    i = 0
    while i < ep.alternative_policy_count {
        let pair = write_alternative_policy_info(b, p, ep.alternative_policies[i])
