// T64 inner: full analyze_function on a simple non-escaping alloc.
fn test_mema_analyze_simple_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let p = mema_alloc_pointer(ctx)
    let a = mema_add_alloc(ctx, r, 32, 1, true)
    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p, r, 0, 0, 1)
    let converged = mema_analyze_function(ctx)
    converged &&
    mema_ptr_has_region(ctx, p, r) &&
    mema_escape_eq(ctx.allocs[0].escape, MemEscapeStatus::EscapeNone) &&
    mema_promote_eq(ctx.allocs[0].promote, MemPromoteResult::PromoteYes)
}

