// Test 35: Cannot resume done continuation
fn efh_test_resume_done(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    efh_resume(ctx, cid, 0)
    efh_complete_continuation(ctx, cid)

    let ok = efh_resume(ctx, cid, 0)
    !ok  // should fail (ContDone is not resumable)
}
fn test_efh_resume_done() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_done(&! ctx), 35)
}

// Test 36: Continuation PC and register count
fn efh_test_cont_pc_regs(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    regs[0] = 10
    regs[1] = 20
    regs[2] = 30
    let cid = efh_capture_continuation(ctx, &regs, 3, 1024)

    let pc = efh_cont_pc(ctx, cid)
    let rc = efh_cont_reg_count(ctx, cid)
    let r0 = efh_cont_get_reg(ctx, cid, 0)
    let r1 = efh_cont_get_reg(ctx, cid, 1)
    let r2 = efh_cont_get_reg(ctx, cid, 2)

    pc == 1024 && rc == 3 && r0 == 10 && r1 == 20 && r2 == 30
}
fn test_efh_cont_pc_regs() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_cont_pc_regs(&! ctx), 36)
}

// Test 37: Continuation handler depth
fn efh_test_cont_handler_depth(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    efh_push_frame(ctx)
    efh_push_frame(ctx)

    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    let depth = efh_cont_handler_depth(ctx, cid)
    depth == 2  // captured at stack depth 2
}
fn test_efh_cont_handler_depth() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_cont_handler_depth(&! ctx), 37)
}

// Test 38: Resume count tracks invocations
fn efh_test_resume_count(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    let ok1 = efh_cont_resume_count(ctx, cid) == 0

    efh_resume(ctx, cid, 0)
    let ok2 = efh_cont_resume_count(ctx, cid) == 1

    // Suspend so we can resume again
    efh_suspend_continuation(ctx, cid)
    efh_resume(ctx, cid, 0)
    let ok3 = efh_cont_resume_count(ctx, cid) == 2

    ok1 && ok2 && ok3
}
fn test_efh_resume_count() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_count(&! ctx), 38)
}

