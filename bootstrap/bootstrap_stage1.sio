    own_exit_scope(ctx)
    let d1 = own_current_scope_depth(ctx)
    own_exit_scope(ctx)
    let d2 = own_current_scope_depth(ctx)
    d1 == 1 && d2 == 0 && own_var_count(ctx) == 2
}

fn own_test_55() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_55_inner(&! ctx), 55)
}

// Test 56: Scope exit releases borrows created in that scope
fn own_test_56_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 5)
    own_enter_scope(ctx, false)
    let bid = own_borrow_shared(ctx, id, 10)
    let before = own_active_borrows_for(ctx, id)
    own_exit_scope(ctx)
    let after = own_active_borrows_for(ctx, id)
    before == 1 && after == 0
    && own_state_is_owned(own_get_state(ctx, id))
}

fn own_test_56() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_56_inner(&! ctx), 56)
}

// Test 57: Loop scope is correctly tracked
fn own_test_57_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    own_enter_scope(ctx, true)
    let is_lp = own_scope_is_loop(ctx, 0)
    own_exit_scope(ctx)
    is_lp
}

fn own_test_57() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_57_inner(&! ctx), 57)
}

// Test 58: Non-loop scope is correctly tracked
fn own_test_58_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    own_enter_scope(ctx, false)
    let is_lp = own_scope_is_loop(ctx, 0)
    own_exit_scope(ctx)
    is_lp == false
}

fn own_test_58() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_58_inner(&! ctx), 58)
}

// ============================================================
//          CATEGORY 7: Branch Merging (7 tests)
// ============================================================

// Test 59: Merge Owned + Owned => Owned
fn own_test_59_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)

    // Snapshot current (Owned)
    let snap1 = own_snapshot_mut(ctx)
    // Both branches leave it as Owned — same snapshot
    let snap2 = own_snapshot_mut(ctx)
    let ok = own_merge_branches(ctx, snap1, snap2)
    ok && own_state_is_owned(own_get_state(ctx, id))
}

fn own_test_59() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_59_inner(&! ctx), 59)
}

// Test 60: Merge Moved + Moved => Moved
fn own_test_60_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)

    // Branch 1: move it
    let m1 = own_transfer(ctx, id, 15)
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: also move it (simulate by restoring to Moved via set_state)
    // Already moved, so snap2 = same state
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    ok && own_state_is_moved(own_get_state(ctx, id))
}

fn own_test_60() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_60_inner(&! ctx), 60)
}

// Test 61: Merge Owned + Moved => PartiallyMoved
fn own_test_61_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)

    // Branch 1: keep owned
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: move it
    let m = own_transfer(ctx, id, 15)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    // For affine types, partial move is OK (no error)
    own_state_is_partially_moved(own_get_state(ctx, id))
}

fn own_test_61() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_61_inner(&! ctx), 61)
}

// Test 62: Merge Owned + Moved for linear type => error
fn own_test_62_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyLinear, 10)

    // Branch 1: keep owned
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: move it
    let m = own_transfer(ctx, id, 15)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    ok == false
    && own_error_kind_eq(own_last_error_kind(ctx), OwnErrorKind::ErrPartialMove)
}

fn own_test_62() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_62_inner(&! ctx), 62)
}

// Test 63: Merge with both sides uninit stays uninit
fn own_test_63_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var_uninit(ctx, OwnTypeKind::TyCopy, 10)
    let snap1 = own_snapshot_mut(ctx)
    let snap2 = own_snapshot_mut(ctx)
    let ok = own_merge_branches(ctx, snap1, snap2)
    ok && own_state_is_uninit(own_get_state(ctx, id))
}

fn own_test_63() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_63_inner(&! ctx), 63)
}

// Test 64: Merge Dropped + Moved => Moved
fn own_test_64_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyDrop, 10)

    // Branch 1: drop it
    let d = own_explicit_drop(ctx, id, 15)
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: simulate moved
    own_set_state(ctx, id, OwnState::StateMoved)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    own_state_is_moved(own_get_state(ctx, id))
}

fn own_test_64() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_64_inner(&! ctx), 64)
}

// Test 65: Merge preserves multiple variables independently
fn own_test_65_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let a = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)
    let b = own_declare_var(ctx, OwnTypeKind::TyAffine, 11)

    // Branch 1: move a, keep b
    let m = own_transfer(ctx, a, 15)
    let snap1 = own_snapshot_mut(ctx)

    // Branch 2: keep a, move b — restore a first
    own_set_state(ctx, a, OwnState::StateOwned)
    let m2 = own_transfer(ctx, b, 20)
    let snap2 = own_snapshot_mut(ctx)

    let ok = own_merge_branches(ctx, snap1, snap2)
    // Both should be partially moved (for affine, no error)
    own_state_is_partially_moved(own_get_state(ctx, a))
    && own_state_is_partially_moved(own_get_state(ctx, b))
}

fn own_test_65() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
    own_assert_true(own_test_65_inner(&! ctx), 65)
}

