// T51 inner: non-escaping heap alloc is promotable.
fn test_mema_promote_non_escaping_inner(ctx: &! MemAnalysisContext) -> bool with Mut, Div, Panic {
    let r = mema_alloc_region(ctx, MemRegionKind::RegHeap, 32, 4, 1)
    let a = mema_add_alloc(ctx, r, 32, 1, true)
    let result = mema_promote_to_stack(ctx, a)
    mema_promote_eq(result, MemPromoteResult::PromoteYes)
