    name1[0] = 120  // 'x'
    var name2: [i8; 64] = [0; 64]
    name2[0] = 121  // 'y'
    let pair1 = bc_register_place_name(bc, name1)
    bc = pair1.0
    let idx1 = pair1.1
    let pair2 = bc_register_place_name(bc, name2)
    bc = pair2.0
    let idx2 = pair2.1
    var fails: i64 = 0
    fails = fails + bc_assert_true(idx1 == 0, 25)
    fails = fails + bc_assert_true(idx2 == 1, 25)
    fails = fails + bc_assert_true(bc_find_place_name(bc, name1) == 0, 25)
    fails = fails + bc_assert_true(bc_find_place_name(bc, name2) == 1, 25)
    fails
}

