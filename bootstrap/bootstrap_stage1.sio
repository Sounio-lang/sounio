    let ok_func = lsc_scope_kind_to_completion_kind(LscScopeKind::LscScopeFunc) == LSC_KIND_FUNCTION
    let ok_type = lsc_scope_kind_to_completion_kind(LscScopeKind::LscScopeType) == LSC_KIND_STRUCT
    let ok_mod = lsc_scope_kind_to_completion_kind(LscScopeKind::LscScopeModule) == LSC_KIND_MODULE
    let ok_field = lsc_scope_kind_to_completion_kind(LscScopeKind::LscScopeField) == LSC_KIND_FIELD
    let ok_method = lsc_scope_kind_to_completion_kind(LscScopeKind::LscScopeMethod) == LSC_KIND_METHOD
