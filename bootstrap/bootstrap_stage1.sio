    test_dep_unify_diff_kind_inner(&! ctx)
}

fn test_dep_unify_add_terms_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // (3 + 4) unifies with (3 + 4) — both normalize to 7
    let a1 = dep_term_int(ctx, 3)
    let a2 = dep_term_int(ctx, 4)
    let sum_a = dep_term_add(ctx, a1, a2)
    let b1 = dep_term_int(ctx, 3)
    let b2 = dep_term_int(ctx, 4)
    let sum_b = dep_term_add(ctx, b1, b2)
    let r = dep_unify(ctx, sum_a, sum_b)
    dep_unify_result_is_ok(r)
}
