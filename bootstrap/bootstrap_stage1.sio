    let c2 = jc_add_cycles(cache, 1003, 300)
    if c1 != 500 { return false }
    c2 == 800
}
fn test_jc_add_cycles() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_add_cycles_inner(&! cache)
}

// T25: get_or_create_profile re-uses existing profile
fn test_jc_profile_reuse_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let p1 = jc_get_or_create_profile(cache, 1004)
    let p2 = jc_get_or_create_profile(cache, 1004)
