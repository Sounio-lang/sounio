    transition_reason_witnesses: TransitionReasonWitnessTable,
    monitoring_policies: MonitoringPolicyTable,
    observed_transitions: ObservedTransitionTable,
    rollback_certificates: RollbackCertificateTable,
    alternative_frontiers: AlternativeFrontierTable,
    alternative_candidates: AlternativeCandidateTable,
    alternative_sets: AlternativeSetTable,
    alternative_reason_witnesses: AlternativeReasonWitnessTable,
    validated_manifests: ValidatedManifestTable,
    error_count: i64,
    warning_count: i64,
    had_error: bool,
    current_return_type: TypeEntry,
    current_impl_type: TypeEntry,
    current_effects: [i64; 8],
    current_effect_count: i64,
    multitest_count: i64,
    multitest_corrected: bool,
    last_literal_int: i64,
    last_literal_float: f64,
    last_literal_kind: i64,   // 0=none, 1=int, 2=float
    loop_depth: i64,
    suppress_linear_consume_depth: i64,
    type_depth: i64,
    expr_depth: i64,
    complexity_budget: i64,
    const_int_names: [Name; 128],
    const_int_values: [i64; 128],
    const_int_known: [i64; 128], // 1=known constant int, 0=shadow/unknown
    const_int_count: i64,
    const_int_scope_marks: [i64; 64],
    const_int_scope_depth: i64,
    effects: EffectTable,
    effect_ops: EffectOpTable,
    handler_depth: i64,
    current_handler_op_id: i64,
    ownership: OwnContext,
    trait_registry: TraitRegistry,
    impl_registry: ImplRegistry,
    multitest_count: i64,
    multitest_corrected: bool,
}

// Wrapper for inferred type arguments (avoids &![T;N] JIT bug)
struct InferBuf {
    args: [TypeEntry; 8],
}

// Wrapper struct for collecting type parameter names (avoids &![T;N] JIT bug)
struct TypeParamBuf {
    names: [Name; 8],
    count: i64,
}

fn empty_type_param_buf() -> TypeParamBuf {
    TypeParamBuf {
        names: [Name { buf: [0; 128], len: 0 }; 8],
        count: 0,
    }
}

// Collect type parameter names from TypeParamDefList.
// Returns (count, names_array) with up to 8 type params.
fn collect_type_params(opt: Option<Box<TypeParamDefList>>) -> (i64, [Name; 8]) with Mut, Panic, Div {
    let buf = collect_type_params_rec(opt, empty_type_param_buf())
    (buf.count, buf.names)
}

fn collect_type_params_rec(opt: Option<Box<TypeParamDefList>>, acc: TypeParamBuf) -> TypeParamBuf with Mut, Panic, Div {
    match opt {
        None => acc
        Some(node) => {
            var buf = acc
            if buf.count < 8 {
                buf.names[buf.count] = (*node).head.name
                buf.count = buf.count + 1
            }
            collect_type_params_rec((*node).tail, buf)
        }
    }
}

// Build a mangled name for a monomorphized generic struct.
// e.g. Pair + [i64] => Pair__i64, Map + [i64, f64] => Map__i64__f64
fn mangle_generic_name(base: Name, args: TypeEntryList) -> Name with Mut, Panic, Div {
    var result = Name { buf: [0; 128], len: 0 }
    // Copy base name
    var i: i64 = 0
    while i < base.len && i < 120 {
        result.buf[i as usize] = base.buf[i as usize]
        i = i + 1
    }
    result.len = i
    // Append type argument names
    mangle_append_args(&! result, args)
    result
}

fn mangle_append_args(result: &! Name, args: TypeEntryList) with Mut, Panic, Div {
    // Append "__"
    if (*result).len < 126 {
        (*result).buf[(*result).len as usize] = 95  // '_'
        (*result).len = (*result).len + 1
        (*result).buf[(*result).len as usize] = 95  // '_'
        (*result).len = (*result).len + 1
    }
    // Append the type name for head
    mangle_append_type_name(result, args.head)
    // Recurse for tail
    match args.tail {
        None => {}
        Some(rest) => mangle_append_args(result, *rest)
    }
}

fn mangle_append_type_name(result: &! Name, ty: TypeEntry) with Mut, Panic, Div {
    // For named types, copy the name; for primitives, use canonical short names
    if ty.kind == TypeKind::TyI8 {
        mangle_append_literal(result, 105, 56, 0, 0, 2)  // "i8"
    } else if ty.kind == TypeKind::TyI32 {
        mangle_append_literal(result, 105, 51, 50, 0, 3)  // "i32"
    } else if ty.kind == TypeKind::TyI64 {
        mangle_append_literal(result, 105, 54, 52, 0, 3)  // "i64"
    } else if ty.kind == TypeKind::TyU8 {
        mangle_append_literal(result, 117, 56, 0, 0, 2)  // "u8"
    } else if ty.kind == TypeKind::TyU32 {
        mangle_append_literal(result, 117, 51, 50, 0, 3)  // "u32"
    } else if ty.kind == TypeKind::TyU64 {
        mangle_append_literal(result, 117, 54, 52, 0, 3)  // "u64"
    } else if ty.kind == TypeKind::TyF32 {
        mangle_append_literal(result, 102, 51, 50, 0, 3)  // "f32"
    } else if ty.kind == TypeKind::TyF64 {
        mangle_append_literal(result, 102, 54, 52, 0, 3)  // "f64"
    } else if ty.kind == TypeKind::TyBool {
        mangle_append_literal(result, 98, 111, 111, 108, 4)  // "bool"
    } else if ty.kind == TypeKind::TyNamed {
        // Copy the type's name
        var j: i64 = 0
        while j < ty.name.len && (*result).len < 128 {
            (*result).buf[(*result).len as usize] = ty.name.buf[j as usize]
            (*result).len = (*result).len + 1
            j = j + 1
        }
    } else {
        // Fallback: append "T"
        if (*result).len < 128 {
            (*result).buf[(*result).len as usize] = 84  // 'T'
            (*result).len = (*result).len + 1
        }
    }
}

fn mangle_append_literal(result: &! Name, c0: i8, c1: i8, c2: i8, c3: i8, len: i64) with Mut, Panic, Div {
    if len >= 1 && (*result).len < 128 {
        (*result).buf[(*result).len as usize] = c0
        (*result).len = (*result).len + 1
    }
    if len >= 2 && (*result).len < 128 {
        (*result).buf[(*result).len as usize] = c1
        (*result).len = (*result).len + 1
    }
    if len >= 3 && (*result).len < 128 {
        (*result).buf[(*result).len as usize] = c2
        (*result).len = (*result).len + 1
    }
    if len >= 4 && (*result).len < 128 {
        (*result).buf[(*result).len as usize] = c3
        (*result).len = (*result).len + 1
    }
}

// Substitute type parameters in a field list to produce a monomorphized field list.
// For each field, if its type is TyNamed and matches a type parameter name,
// replace it with the corresponding concrete type argument.
fn monomorphize_fields(
    fields: Option<Box<FieldInfoList>>,
    tp_count: i64,
    tp_names: [Name; 8],
    args: TypeEntryList,
) -> (Option<Box<FieldInfoList>>, i64) with Mut, Panic, Div, Alloc {
    match fields {
        None => (None, 0)
        Some(fl) => {
            let head = (*fl).head
            let new_ty = substitute_type_param(head.ty, tp_count, tp_names, args)
            let new_head = FieldInfo { name: head.name, ty: new_ty }
            let rest = monomorphize_fields((*fl).tail, tp_count, tp_names, args)
            (Some(Box::new(FieldInfoList { head: new_head, tail: rest.0 })), 1 + rest.1)
        }
    }
}

// If ty is a TyNamed whose name matches a type parameter, replace with the concrete type.
fn substitute_type_param(
    ty: TypeEntry,
    tp_count: i64,
    tp_names: [Name; 8],
    args: TypeEntryList,
) -> TypeEntry with Mut, Panic, Div {
    if ty.kind == TypeKind::TyNamed {
        // Check if this name matches any type parameter
        var idx: i64 = 0
        while idx < tp_count {
            if name_eq(ty.name, tp_names[idx]) {
                // Found match — return the corresponding type argument
                return type_entry_list_nth(args, idx)
            }
            idx = idx + 1
        }
    }
    // Not a type param reference — return as-is
    ty
}

// Get the nth element of a TypeEntryList (0-indexed).
fn type_entry_list_nth(list: TypeEntryList, n: i64) -> TypeEntry with Mut, Panic, Div {
    if n == 0 {
        list.head
    } else {
        match list.tail {
            None => list.head  // fallback: return head if out of bounds
            Some(rest) => type_entry_list_nth(*rest, n - 1)
        }
    }
}

