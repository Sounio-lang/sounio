// T50: copy_code produces correct output
fn test_jc_copy_code_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(77 as i8, 10)
    let idx = jc_insert_entry(cache, 2500, JC_TIER_OPT, code, 10)
    var dst: [i8; 65536] = [0; 65536]
    let len = jc_copy_code(cache, idx, &! dst)
    if len != 10 { return false }
    if dst[0 as usize] != 77 as i8 { return false }
    if dst[9 as usize] != 77 as i8 { return false }
    // Byte past end should be 0
    dst[10 as usize] == 0 as i8
}
