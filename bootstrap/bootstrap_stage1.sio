// T43: handle definition cross-file
fn test_lspg_handle_def_xfile_inner(ctx: &! LspgContext) -> bool with Mut, Div, Panic {
    // Def in file 2
    let loc_d = lspg_location_new(2, 1, 0, 1, 10)
    let def_id = lspg_add_definition(ctx, LspgSymKind::GSymFunction, 100, loc_d, 0)
    // Ref in file 1
    let loc_r = lspg_location_new(1, 5, 3, 5, 8)
    let ref_id = lspg_add_reference(ctx, def_id, LspgRefKind::RefUsage, loc_r)
    let _ = ref_id
