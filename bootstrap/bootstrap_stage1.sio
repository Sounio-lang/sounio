// SOURCE: self-hosted/check/borrow.sio  (235 lines)
// ════════════════════════════════════════════════════════════════

// Borrow checker — single-pass ownership and borrowing verification
//
// Tracks per-variable borrow state: Owned, SharedBorrow(n), ExclusiveBorrow
// Enforces:
//   - &x: fails if exclusive borrow is active
//   - &!x: fails if any borrow is active
//   - linear struct: must be consumed exactly once
//   - Scope exit: releases borrows created in that scope

// ============================================================
// Borrow state per variable
// ============================================================

// State values: 0 = Owned (unborrowed), 1 = SharedBorrow, 2 = ExclusiveBorrow
// shared_count tracks number of active shared borrows

struct BorrowEntry {
    name: Name,
    state: i64,          // 0=Owned, 1=SharedBorrow, 2=ExclusiveBorrow
    shared_count: i64,   // Number of active shared borrows
    is_linear: bool,     // Whether this is a linear type variable
    consumed: bool,      // Whether a linear variable has been consumed
    scope_depth: i64,    // Scope where this entry was created
}

fn empty_borrow_entry() -> BorrowEntry {
    BorrowEntry {
        name: Name { buf: [0; 128], len: 0 },
        state: 0,
        shared_count: 0,
        is_linear: false,
        consumed: false,
        scope_depth: 0,
    }
}

// ============================================================
// Borrow environment
// ============================================================

struct BorrowEnv {
    entries: [BorrowEntry; 128],
    count: i64,
    scope_starts: [i64; 64],
    scope_depth: i64,
}

fn borrow_env_new() -> BorrowEnv {
    BorrowEnv {
        entries: [empty_borrow_entry(); 128],
        count: 0,
        scope_starts: [0; 64],
        scope_depth: 0,
    }
}

impl BorrowEnv {
    fn push_scope(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth < 64 {
            env.scope_starts[env.scope_depth] = env.count
            env.scope_depth = env.scope_depth + 1
        }
        env
    }

    fn pop_scope(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.scope_depth > 0 {
            env.scope_depth = env.scope_depth - 1
            // Release borrows created in this scope by resetting state
            let scope_start = env.scope_starts[env.scope_depth]
            var i = scope_start
            while i < env.count {
                env.entries[i].state = 0
                env.entries[i].shared_count = 0
                i = i + 1
            }
            env.count = scope_start
        }
        env
    }

    // Register a variable for borrow tracking
    fn track(self, name: Name, is_linear: bool) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        if env.count < 128 {
            env.entries[env.count] = BorrowEntry {
                name: name,
                state: 0,
                shared_count: 0,
                is_linear: is_linear,
                consumed: false,
                scope_depth: env.scope_depth,
            }
            env.count = env.count + 1
        }
        env
    }

    // Find entry index for a variable (most recent binding)
    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i = self.count - 1
        while i >= 0 {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i - 1
        }
        -1
    }

    // Try to take a shared borrow (&x)
    // Returns (updated env, error_code) where error_code 0 = ok, 37 = conflict
    fn try_shared_borrow(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            // Variable not tracked — allow (may be a global or external)
            return (env, 0)
        }
        let entry = env.entries[idx]
        if entry.state == 2 {
            // Cannot take shared borrow while exclusive borrow is active
            return (env, 37)
        }
        // Increment shared borrow count
        env.entries[idx].state = 1
        env.entries[idx].shared_count = entry.shared_count + 1
        (env, 0)
    }

    // Try to take an exclusive borrow (&!x)
    // Returns (updated env, error_code) where error_code 0 = ok, 38 = conflict
    fn try_exclusive_borrow(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            return (env, 0)
        }
        let entry = env.entries[idx]
        if entry.state != 0 {
            // Cannot take exclusive borrow while any borrow is active
            return (env, 38)
        }
        env.entries[idx].state = 2
        (env, 0)
    }

    // Mark a linear variable as consumed (moved)
    // Returns (updated env, error_code) where 0 = ok, 39 = already consumed
    fn consume_linear(self, name: Name) -> (BorrowEnv, i64) with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx < 0 {
            return (env, 0)
        }
        let entry = env.entries[idx]
        if !entry.is_linear {
            return (env, 0)
        }
        if entry.consumed {
            // Double consumption of linear value
            return (env, 39)
        }
        env.entries[idx].consumed = true
        (env, 0)
    }

    // Check that all linear variables in the current scope have been consumed
    // Returns (env, unconsumed_count)
    fn check_linear_consumed(self) -> (BorrowEnv, i64) with Mut, Panic, Div {
        let env = self
        var unconsumed: i64 = 0
        let scope_start = if env.scope_depth > 0 {
            env.scope_starts[env.scope_depth - 1]
        } else {
            0
        }
        var i = scope_start
        while i < env.count {
            if env.entries[i].is_linear && !env.entries[i].consumed {
                unconsumed = unconsumed + 1
            }
            i = i + 1
        }
        (env, unconsumed)
    }

    // Check if a variable is currently borrowed (state != 0)
    // Returns true if the variable has an active shared or exclusive borrow
    fn is_borrowed(self, name: Name) -> bool with Mut, Panic, Div {
        let idx = self.find(name)
        if idx < 0 {
            return false
        }
        let entry = self.entries[idx]
        entry.state != 0  // 0 = Owned, 1 = SharedBorrow, 2 = ExclusiveBorrow
    }

    // Release a borrow on a named variable, restoring it to Owned state.
    // Called after a function call returns to release borrows taken for parameters.
    fn release_borrow(self, name: Name) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        let idx = env.find(name)
        if idx >= 0 {
            if env.entries[idx].state == 2 {
                // Exclusive borrow -> Owned
                env.entries[idx].state = 0
            } else if env.entries[idx].state == 1 {
                // Decrement shared borrow count
                env.entries[idx].shared_count = env.entries[idx].shared_count - 1
                if env.entries[idx].shared_count <= 0 {
                    env.entries[idx].state = 0
                    env.entries[idx].shared_count = 0
                }
            }
        }
        env
    }

    // Release all exclusive borrows in the current scope.
    // Used at loop iteration boundaries to allow re-borrowing in the next iteration.
    fn release_exclusive_borrows(self) -> BorrowEnv with Mut, Panic, Div {
        var env = self
        var i: i64 = 0
        while i < env.count {
            if env.entries[i].state == 2 {
                env.entries[i].state = 0
            }
            i = i + 1
        }
        env
    }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/units.sio  (268 lines)
// ════════════════════════════════════════════════════════════════

// Units and dimensional analysis for the type checker
//
// Represents physical quantities as vectors of base dimension exponents:
//   [mass, length, time, temperature, amount, current, luminosity]
//
// Examples:
//   mg, kg, g   → [1, 0, 0, 0, 0, 0, 0]  (mass)
//   m, km       → [0, 1, 0, 0, 0, 0, 0]  (length)
//   s, ms       → [0, 0, 1, 0, 0, 0, 0]  (time)
//   K           → [0, 0, 0, 1, 0, 0, 0]  (temperature)
//   mol         → [0, 0, 0, 0, 1, 0, 0]  (amount)
//   m/s         → [0, 1, -1, 0, 0, 0, 0] (velocity)
//   kg*m/s^2    → [1, 1, -2, 0, 0, 0, 0] (force = Newton)
//
// Unit arithmetic:
//   a * b → add dimension vectors
//   a / b → subtract dimension vectors
//   a + b → dimensions must match exactly
//   a - b → dimensions must match exactly

// ============================================================
// Unit dimension vector (7 base SI dimensions)
// ============================================================

struct UnitDim {
    exponents: [i64; 7],   // [mass, length, time, temp, amount, current, luminosity]
    scale_num: i64,        // Scale factor numerator (for unit conversions)
    scale_den: i64,        // Scale factor denominator
}

fn unit_dim_dimensionless() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_mass() -> UnitDim {
    UnitDim {
        exponents: [1, 0, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_length() -> UnitDim {
    UnitDim {
        exponents: [0, 1, 0, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_time() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 1, 0, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_temperature() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 0, 1, 0, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

fn unit_dim_amount() -> UnitDim {
    UnitDim {
        exponents: [0, 0, 0, 0, 1, 0, 0],
        scale_num: 1,
        scale_den: 1,
    }
}

// ============================================================
// Dimension arithmetic
// ============================================================

// Multiply: add exponents
fn unit_dim_mul(a: UnitDim, b: UnitDim) -> UnitDim with Mut, Panic, Div {
    var result = a
    var i: i64 = 0
    while i < 7 {
        result.exponents[i as usize] = a.exponents[i as usize] + b.exponents[i as usize]
        i = i + 1
    }
    result.scale_num = a.scale_num * b.scale_num
    result.scale_den = a.scale_den * b.scale_den
    result
}

// Divide: subtract exponents
fn unit_dim_div(a: UnitDim, b: UnitDim) -> UnitDim with Mut, Panic, Div {
    var result = a
    var i: i64 = 0
    while i < 7 {
        result.exponents[i as usize] = a.exponents[i as usize] - b.exponents[i as usize]
        i = i + 1
    }
    // Scale: a/b
    result.scale_num = a.scale_num * b.scale_den
    result.scale_den = a.scale_den * b.scale_num
    result
}

// Check if two dimensions are compatible (same exponents, scale may differ)
fn unit_dim_compatible(a: UnitDim, b: UnitDim) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 7 {
        if a.exponents[i as usize] != b.exponents[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// Check if dimension is dimensionless
fn unit_dim_is_dimensionless(d: UnitDim) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < 7 {
        if d.exponents[i as usize] != 0 {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================
// Named unit registry
// ============================================================

struct UnitEntry {
    name: Name,
    dim: UnitDim,
}

fn empty_unit_entry() -> UnitEntry {
    UnitEntry {
        name: Name { buf: [0; 128], len: 0 },
        dim: unit_dim_dimensionless(),
    }
}

struct UnitRegistry {
    entries: [UnitEntry; 32],
    count: i64,
}

fn unit_registry_new() -> UnitRegistry {
    UnitRegistry {
        entries: [empty_unit_entry(); 32],
        count: 0,
    }
}

impl UnitRegistry {
    fn register(self, name: Name, dim: UnitDim) -> UnitRegistry with Mut, Panic, Div {
        var reg = self
        if reg.count < 32 {
            reg.entries[reg.count] = UnitEntry { name: name, dim: dim }
            reg.count = reg.count + 1
        }
        reg
    }

    fn find(self, name: Name) -> i64 with Mut, Panic, Div {
        var i: i64 = 0
        while i < self.count {
            if name_eq(self.entries[i].name, name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    fn get_dim(self, idx: i64) -> UnitDim with Panic, Div {
        self.entries[idx].dim
    }
}

// ============================================================
// Builtin unit definitions
// ============================================================

fn unit_dim_with_scale(base: UnitDim, num: i64, den: i64) -> UnitDim {
    UnitDim {
        exponents: base.exponents,
        scale_num: num,
        scale_den: den,
    }
}

fn register_builtin_units(reg: UnitRegistry) -> UnitRegistry with Mut, Panic, Div {
    var r = reg

    // Mass units (base: g)
    r = r.register(name_from_str2(109, 103), unit_dim_with_scale(unit_dim_mass(), 1, 1000))    // "mg" = 1/1000 g
    r = r.register(name_from_str1(103), unit_dim_mass())                                       // "g"  = 1 g
    r = r.register(name_from_str2(107, 103), unit_dim_with_scale(unit_dim_mass(), 1000, 1))    // "kg" = 1000 g

    // Length units (base: m)
    r = r.register(name_from_str1(109), unit_dim_length())                                     // "m"  = 1 m
    r = r.register(name_from_str2(107, 109), unit_dim_with_scale(unit_dim_length(), 1000, 1))  // "km" = 1000 m
    r = r.register(name_from_str2(99, 109), unit_dim_with_scale(unit_dim_length(), 1, 100))    // "cm" = 1/100 m
    r = r.register(name_from_str2(109, 109), unit_dim_with_scale(unit_dim_length(), 1, 1000))  // "mm" = 1/1000 m

    // Time units (base: s)
    r = r.register(name_from_str1(115), unit_dim_time())                                       // "s"   = 1 s
    r = r.register(name_from_str2(109, 115), unit_dim_with_scale(unit_dim_time(), 1, 1000))    // "ms"  = 1/1000 s
    r = r.register(name_from_str3(109, 105, 110), unit_dim_with_scale(unit_dim_time(), 60, 1)) // "min" = 60 s
    r = r.register(name_from_str1(104), unit_dim_with_scale(unit_dim_time(), 3600, 1))         // "h"   = 3600 s

    // Temperature
    r = r.register(name_from_str1(75), unit_dim_temperature())         // "K"

    // Amount (moles)
    r = r.register(name_from_str3(109, 111, 108), unit_dim_amount())   // "mol"

    r
}

// ============================================================
// Name construction helpers (for builtin registration)
// ============================================================

fn name_from_str1(a: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 1 }
    n.buf[0] = a as i8
    n
}

fn name_from_str2(a: i64, b: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 2 }
    n.buf[0] = a as i8
    n.buf[1] = b as i8
    n
}

fn name_from_str3(a: i64, b: i64, c: i64) -> Name with Mut, Panic, Div {
    var n = Name { buf: [0; 128], len: 3 }
    n.buf[0] = a as i8
    n.buf[1] = b as i8
    n.buf[2] = c as i8
    n
}

// ============================================================
// Unit error printing
// ============================================================

fn print_unit_dim(d: UnitDim) with IO, Mut, Panic, Div {
    var first = true
    if d.exponents[0] != 0 { print("mass^"); print_int(d.exponents[0]); first = false }
    if d.exponents[1] != 0 { if !first { print("*") }; print("length^"); print_int(d.exponents[1]); first = false }
    if d.exponents[2] != 0 { if !first { print("*") }; print("time^"); print_int(d.exponents[2]); first = false }
    if d.exponents[3] != 0 { if !first { print("*") }; print("temp^"); print_int(d.exponents[3]); first = false }
    if d.exponents[4] != 0 { if !first { print("*") }; print("amount^"); print_int(d.exponents[4]); first = false }
    if d.exponents[5] != 0 { if !first { print("*") }; print("current^"); print_int(d.exponents[5]); first = false }
    if d.exponents[6] != 0 { if !first { print("*") }; print("luminosity^"); print_int(d.exponents[6]); first = false }
    if first { print("dimensionless") }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/epistemic.sio  (2318 lines)
// ════════════════════════════════════════════════════════════════

// Epistemic type checking for Knowledge[T, epsilon, validity, provenance]
//
// Provides type-level support for the 4-layer epistemic type:
//   Knowledge[T, epsilon < bound, Valid(...), Provenance]
//
// Functions:
//   check_knowledge_type      — validate and lower a KnowledgeTypeInfo AST node
//   check_knowledge_unwrap    — extract inner type from Knowledge wrapper
//   is_knowledge_type         — predicate
//   knowledge_inner           — extract wrapped type entry
//   check_knowledge_epsilon   — field access for epsilon
//   check_knowledge_epsilon_of — epsilonOf intrinsic
//
// Provenance tracking:
//   ProvenanceKind enum       — source classification
//   Provenance struct         — source metadata
//   provenance_new            — constructor
//
// Validity conditions:
//   ValidityKind enum         — validity classification
//   Validity struct           — validity metadata
//   validity_always           — always valid constructor
//   validity_duration         — duration-based validity
//
// Knowledge metadata:
//   KnowledgeMeta struct      — combined epsilon, validity, provenance
//   knowledge_meta_from_ty    — extract from type
//
// Confidence subsumption:
//   epsilon_subsumes          — lattice ordering (lower = more confident)
//   knowledge_compatible      — type compatibility with epsilon ordering
//
// Epsilon propagation:
//   epsilon_combine_independent — add for independent errors
//   epsilon_combine_correlated  — max for correlated errors
//   knowledge_binary_result     — binary op epsilon propagation

// ============================================================
// Knowledge type construction and validation
// ============================================================

fn check_knowledge_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    // Lower the inner type
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    // Validate metadata constraints that we can prove at type-check time.
    // (TypeEntry does not yet persist full validity/provenance metadata.)
    if !knowledge_metadata_is_valid(info.validity) {
        c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 54, 0, 0, 0)
    }
    let meta = knowledge_meta_from_type_info(info)
    if !knowledge_meta_is_valid(meta) {
        c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 54, 0, 0, 0)
    }

    // Validate epsilon bound if present
    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_knowledge(inner_ty, eps_val)
    (c, ty)
}

fn check_intervention_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_intervention(inner_ty, eps_val)
    (c, ty)
}

fn check_counterfactual_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_counterfactual(inner_ty, eps_val)
    (c, ty)
}

fn check_validated_type(checker: Checker, info: KnowledgeTypeInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let pair = checker.lower_type_expr(*info.inner_type)
    var c = pair.0
    let inner_ty = pair.1

    var eps_val: f64 = -1.0
    match info.epsilon {
        Some(eb) => {
            let bound = *eb
            if bound.value < 0.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else if bound.value > 1.0 {
                c = c.report_error_at(Span { file_id: 0, start: 0, end: 0 }, 22, 0, 0, 0)
            } else {
                eps_val = bound.value
            }
        }
        None => {}
    }

    let ty = ty_validated(inner_ty, eps_val)
    (c, ty)
}

fn knowledge_validity_expr_non_negative(opt: Option<Box<Expr>>) -> bool {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprIntLit {
                return (*e).int_val >= 0
            }
            if (*e).kind == ExprKind::ExprFloatLit {
                return (*e).float_val >= 0.0
            }
            true
        }
        None => false
    }
}

fn knowledge_metadata_is_valid(validity_opt: Option<Box<ValidityCondition>>) -> bool {
    match validity_opt {
        Some(vc) => knowledge_validity_expr_non_negative((*vc).expr)
        None => true
    }
}

fn validity_from_ast(opt: Option<Box<ValidityCondition>>) -> Validity {
    match opt {
        Some(vc) => {
            let value = if knowledge_validity_expr_non_negative((*vc).expr) {
                knowledge_validity_expr_to_f64((*vc).expr)
            } else {
                0.0
            }
            match (*vc).kind {
                AstValidityKind::ValidDuration => validity_duration(value)
                AstValidityKind::ValidUntilTime => validity_until(value)
                AstValidityKind::ValidWhileCond => validity_while()
            }
        }
        None => validity_always()
    }
}

fn knowledge_validity_expr_to_f64(opt: Option<Box<Expr>>) -> f64 {
    match opt {
        Some(e) => {
            if (*e).kind == ExprKind::ExprIntLit {
                (*e).int_val as f64
            } else if (*e).kind == ExprKind::ExprFloatLit {
                (*e).float_val
            } else {
                0.0
            }
        }
        None => 0.0
    }
}

// ============================================================
// Provenance tracking
// ============================================================

// Classification of knowledge sources for audit trails
// and trust boundary tracking. Stored as integer tags to avoid
// depending on local-enum variant resolution in checker fragments.
const PROVENANCE_KIND_DERIVED: i64 = 0
const PROVENANCE_KIND_SOURCE: i64 = 1
const PROVENANCE_KIND_COMPUTED: i64 = 2
const PROVENANCE_KIND_LITERATURE: i64 = 3
const PROVENANCE_KIND_MEASURED: i64 = 4
const PROVENANCE_KIND_INPUT: i64 = 5

// Provenance metadata tracking source and lineage
struct Provenance {
    kind: i64,
    source_id: i64
}

// Construct provenance with a specific kind
// source_id is initialized to 0 (unknown)
fn provenance_new(kind: i64) -> Provenance {
    Provenance {
        kind: kind,
        source_id: 0
    }
}

// Construct provenance with explicit source identifier
fn provenance_with_source(kind: i64, source_id: i64) -> Provenance {
    Provenance {
        kind: kind,
        source_id: source_id
    }
}

fn provenance_from_ast(opt: Option<Box<AstProvenanceKind>>) -> Provenance {
    match opt {
        Some(p) => {
            match *p {
                AstProvenanceKind::AstProvDerived => provenance_new(PROVENANCE_KIND_DERIVED)
                AstProvenanceKind::AstProvSource => provenance_new(PROVENANCE_KIND_SOURCE)
                AstProvenanceKind::AstProvComputed => provenance_new(PROVENANCE_KIND_COMPUTED)
                AstProvenanceKind::AstProvLiterature => provenance_new(PROVENANCE_KIND_LITERATURE)
                AstProvenanceKind::AstProvMeasured => provenance_new(PROVENANCE_KIND_MEASURED)
                AstProvenanceKind::AstProvInput => provenance_new(PROVENANCE_KIND_INPUT)
            }
        }
        None => provenance_new(PROVENANCE_KIND_DERIVED)
    }
}

fn knowledge_meta_from_type_info(info: KnowledgeTypeInfo) -> KnowledgeMeta {
    let base_eps = match info.epsilon {
        Some(eb) => (*eb).value
        None => -1.0
    }
    knowledge_meta_full(base_eps, validity_from_ast(info.validity), provenance_from_ast(info.provenance))
}

// ============================================================
// Knowledge type queries
// ============================================================

fn is_knowledge_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyKnowledge
}

fn is_intervention_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyIntervention
}

fn is_counterfactual_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyCounterfactual
}

fn is_validated_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyValidated
}

fn is_epistemic_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyKnowledge || ty.kind == TypeKind::TyIntervention || ty.kind == TypeKind::TyCounterfactual || ty.kind == TypeKind::TyValidated
}

fn knowledge_inner(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    match ty.inner {
        Some(inner_box) => *inner_box
        None => ty_error()
    }
}

fn check_knowledge_unwrap(ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    if is_knowledge_type(ty) {
        knowledge_inner(ty)
    } else {
        ty_error()
    }
}

fn check_knowledge_epsilon(ty: TypeEntry) -> TypeEntry {
    // .epsilon field access on Knowledge<T> returns f64
    if is_knowledge_type(ty) {
        ty_f64()
    } else {
        ty_error()
    }
}

fn check_knowledge_epsilon_of(ty: TypeEntry) -> TypeEntry {
    // epsilonOf(k) returns the epsilon bound as f64
    if is_knowledge_type(ty) {
        ty_f64()
    } else {
        ty_error()
    }
}

// Check if provenance is from a trusted source
fn provenance_is_trusted(prov: Provenance) -> bool {
    match prov.kind {
        PROVENANCE_KIND_SOURCE => true,
        PROVENANCE_KIND_LITERATURE => true,
        PROVENANCE_KIND_MEASURED => true,
        PROVENANCE_KIND_DERIVED => false,
        PROVENANCE_KIND_COMPUTED => false,
        PROVENANCE_KIND_INPUT => false
    }
}

// Get string representation of provenance kind
fn provenance_kind_name(kind: i64) -> String with Alloc {
    match kind {
        PROVENANCE_KIND_DERIVED => "derived",
        PROVENANCE_KIND_SOURCE => "source",
        PROVENANCE_KIND_COMPUTED => "computed",
        PROVENANCE_KIND_LITERATURE => "literature",
        PROVENANCE_KIND_MEASURED => "measured",
        PROVENANCE_KIND_INPUT => "input"
    }
}

// Check if provenance kind requires verification
fn provenance_kind_needs_verification(kind: i64) -> bool {
    match kind {
        PROVENANCE_KIND_INPUT => true,
        PROVENANCE_KIND_MEASURED => true,
        PROVENANCE_KIND_DERIVED => false,
        PROVENANCE_KIND_SOURCE => false,
        PROVENANCE_KIND_COMPUTED => false,
        PROVENANCE_KIND_LITERATURE => false
    }
}

// Compare two provenance entries for equality
fn provenance_eq(a: Provenance, b: Provenance) -> bool {
    a.kind == b.kind && a.source_id == b.source_id
}

// ============================================================
// Validity conditions (lines 151-220)
// ============================================================

// Classification of validity conditions for knowledge
// Determines when knowledge remains valid/usable
const VALIDITY_KIND_ALWAYS: i64 = 0
const VALIDITY_KIND_DURATION: i64 = 1
const VALIDITY_KIND_UNTIL_TIME: i64 = 2
const VALIDITY_KIND_WHILE_COND: i64 = 3

// Validity metadata for knowledge temporal bounds
struct Validity {
    kind: i64,
    duration_sec: f64,
    until_timestamp: f64
}

// Create always-valid validity (no expiration)
fn validity_always() -> Validity {
    Validity {
        kind: VALIDITY_KIND_ALWAYS,
        duration_sec: 0.0,
        until_timestamp: 0.0
    }
}

// Create duration-based validity
fn validity_duration(seconds: f64) -> Validity {
    Validity {
        kind: VALIDITY_KIND_DURATION,
        duration_sec: seconds,
        until_timestamp: 0.0
    }
}

// Create timestamp-based validity (valid until specific time)
fn validity_until(timestamp: f64) -> Validity {
    Validity {
        kind: VALIDITY_KIND_UNTIL_TIME,
        duration_sec: 0.0,
        until_timestamp: timestamp
    }
}

// Create condition-based validity
fn validity_while() -> Validity {
    Validity {
        kind: VALIDITY_KIND_WHILE_COND,
        duration_sec: 0.0,
        until_timestamp: 0.0
    }
}

// Check if validity has expired based on current time
fn validity_is_expired(validity: Validity, current_time: f64) -> bool {
    match validity.kind {
        VALIDITY_KIND_ALWAYS => false,
        VALIDITY_KIND_DURATION => false,  // Need creation time to check
        VALIDITY_KIND_UNTIL_TIME => current_time > validity.until_timestamp,
        VALIDITY_KIND_WHILE_COND => false  // Condition checked at runtime
    }
}

// Get a conservative validity that combines two validity constraints
fn validity_intersect(a: Validity, b: Validity) -> Validity {
    // The intersection is the more restrictive of the two
    match a.kind {
        VALIDITY_KIND_ALWAYS => b,
        VALIDITY_KIND_DURATION => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                VALIDITY_KIND_DURATION => {
                    if a.duration_sec < b.duration_sec { a } else { b }
                }
                VALIDITY_KIND_UNTIL_TIME => b,
                VALIDITY_KIND_WHILE_COND => b
            }
        }
        VALIDITY_KIND_UNTIL_TIME => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                VALIDITY_KIND_UNTIL_TIME => {
                    if a.until_timestamp < b.until_timestamp { a } else { b }
                }
                _ => a
            }
        }
        VALIDITY_KIND_WHILE_COND => {
            match b.kind {
                VALIDITY_KIND_ALWAYS => a,
                _ => b
            }
        }
    }
}

// ============================================================
// Knowledge metadata (lines 221-300)
// ============================================================

// Combined metadata for Knowledge types including
// epsilon bound, validity conditions, and provenance
struct KnowledgeMeta {
    epsilon: f64,
    validity: Validity,
    provenance: Provenance
}

// Create default metadata with always-valid and unknown provenance
fn knowledge_meta_default(epsilon: f64) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity_always(),
        provenance: provenance_new(PROVENANCE_KIND_DERIVED)
    }
}

// Create metadata from type entry
// Extracts epsilon from Knowledge types, uses defaults otherwise
fn knowledge_meta_from_ty(ty: TypeEntry) -> KnowledgeMeta with Mut, Panic, Div, Alloc {
    match ty.kind {
        TypeKind::TyKnowledge => {
            let eps = ty.knowledge_epsilon
            KnowledgeMeta {
                epsilon: eps,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        TypeKind::TyIntervention => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        TypeKind::TyCounterfactual => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        TypeKind::TyValidated => {
            KnowledgeMeta {
                epsilon: ty.knowledge_epsilon,
                validity: validity_always(),
                provenance: provenance_new(PROVENANCE_KIND_DERIVED)
            }
        }
        _ => knowledge_meta_default(-1.0)
    }
}

// Create metadata with specified validity
fn knowledge_meta_with_validity(epsilon: f64, validity: Validity) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity,
        provenance: provenance_new(PROVENANCE_KIND_DERIVED)
    }
}

// Create metadata with specified provenance
fn knowledge_meta_with_provenance(epsilon: f64, provenance: Provenance) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity_always(),
        provenance: provenance
    }
}

// Create fully specified metadata
fn knowledge_meta_full(epsilon: f64, validity: Validity, provenance: Provenance) -> KnowledgeMeta {
    KnowledgeMeta {
        epsilon: epsilon,
        validity: validity,
        provenance: provenance
    }
}

// Get epsilon from knowledge metadata
fn knowledge_meta_epsilon(meta: KnowledgeMeta) -> f64 {
    meta.epsilon
}

// Get validity from knowledge metadata
fn knowledge_meta_validity(meta: KnowledgeMeta) -> Validity {
    meta.validity
}

// Get provenance from knowledge metadata
fn knowledge_meta_provenance(meta: KnowledgeMeta) -> Provenance {
    meta.provenance
}

fn epsilon_is_valid(eps: f64) -> bool {
    eps >= 0.0 && eps <= 1.0
}

// Check if metadata represents valid knowledge
fn knowledge_meta_is_valid(meta: KnowledgeMeta) -> bool {
    meta.epsilon < 0.0 || epsilon_is_valid(meta.epsilon)
}

// ============================================================
// Confidence subsumption lattice (lines 301-380)
// ============================================================

// Confidence subsumption: lower epsilon = higher confidence
// epsilon_subsumes(eps_a, eps_b) returns true if a is at least as
// confident as b (eps_a <= eps_b)
//
// This defines a partial order where:
//   0.0 (certain) > 0.1 > 0.5 > 1.0 (unknown)
//
// Returns true if eps_a <= eps_b
fn epsilon_subsumes(eps_a: f64, eps_b: f64) -> bool {
    eps_a <= eps_b
}

// Function-call boundaries fail closed on unknown/invalid provided epsilon.
// Required epsilon < 0.0 means "unspecified requirement".
fn epsilon_subsumes_call_boundary(provided_eps: f64, required_eps: f64) -> bool {
    if !epsilon_is_valid(provided_eps) {
        return false
    }
    if required_eps < 0.0 {
        return true
    }
    if !epsilon_is_valid(required_eps) {
        return false
    }
    epsilon_subsumes(provided_eps, required_eps)
}

// Get the more confident (lower) epsilon
fn epsilon_meet(eps_a: f64, eps_b: f64) -> f64 {
    if eps_a < eps_b {
        eps_a
    } else {
        eps_b
    }
}

// Get the less confident (higher) epsilon
fn epsilon_join(eps_a: f64, eps_b: f64) -> f64 {
    if eps_a > eps_b {
        eps_a
    } else {
        eps_b
    }
}

// Check if two knowledge types are compatible
// Compatible if:
//   1. Inner types match (structural equality)
//   2. Epsilon subsumption holds (a is at least as confident as b)
//
// Returns true if ty_a can be used where ty_b is expected
fn knowledge_compatible(ty_a: TypeEntry, ty_b: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    let inner_a = knowledge_inner(ty_a)
    let inner_b = knowledge_inner(ty_b)

    // Check inner types match
    let types_match = types_equal(inner_a, inner_b)
    if !types_match {
        false
    } else {
        // Check epsilon subsumption
        epsilon_subsumes(ty_a.knowledge_epsilon, ty_b.knowledge_epsilon)
    }
}

// Check type equality (structural)
fn types_equal(a: TypeEntry, b: TypeEntry) -> bool {
    if a.kind != b.kind {
        false
    } else {
        match (a.inner, b.inner) {
            (Some(inner_a), Some(inner_b)) => types_equal(*inner_a, *inner_b),
            (None, None) => true,
            _ => false
        }
    }
}

// Check if knowledge type meets epsilon requirement
fn knowledge_meets_epsilon(ty: TypeEntry, required_epsilon: f64) -> bool {
    if is_knowledge_type(ty) {
        epsilon_subsumes(ty.knowledge_epsilon, required_epsilon)
    } else {
        false
    }
}

// Subsumption for provenance
fn provenance_subsumes(provided: Provenance, required: Provenance) -> bool {
    // If caller requires a trusted source, callee argument must be trusted.
    if provenance_is_trusted(required) {
        provenance_is_trusted(provided)
    } else {
        true
    }
}

// Subsumption for validity
fn validity_subsumes(provided: Validity, required: Validity) -> bool {
    if required.kind == VALIDITY_KIND_ALWAYS {
        return provided.kind == VALIDITY_KIND_ALWAYS
    }
    if required.kind == VALIDITY_KIND_DURATION {
        if provided.kind == VALIDITY_KIND_ALWAYS {
            return true
        }
        if provided.kind == VALIDITY_KIND_DURATION {
            return provided.duration_sec >= required.duration_sec
        }
        return false
    }
    if required.kind == VALIDITY_KIND_UNTIL_TIME {
        if provided.kind == VALIDITY_KIND_ALWAYS {
            return true
        }
        if provided.kind == VALIDITY_KIND_UNTIL_TIME {
            return provided.until_timestamp >= required.until_timestamp
        }
        return false
    }
    if required.kind == VALIDITY_KIND_WHILE_COND {
        return provided.kind == VALIDITY_KIND_ALWAYS || provided.kind == VALIDITY_KIND_WHILE_COND
    }
    false
}

// ============================================================
// Epsilon propagation (lines 381-480)
// ============================================================

// Clamp epsilon to valid range [0.0, 1.0]
fn epsilon_clamp(eps: f64) -> f64 {
    if eps < 0.0 {
        0.0
    } else if eps > 1.0 {
        1.0
    } else {
        eps
    }
}

// Approximate sqrt for values in [0, 2] using one Newton iteration
// Initial guess: x/2 + 0.5, then refine: (guess + x/guess) / 2
fn sqrt_approx(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x * 0.5 + 0.5
    guess = (guess + x / guess) * 0.5
    epsilon_clamp(guess)
}

// Combine independent errors: sqrt(eps_a^2 + eps_b^2)
// Quadrature sum for independent random variables (standard error propagation)
// Clamped to [0.0, 1.0]
fn epsilon_combine_independent(eps_a: f64, eps_b: f64) -> f64 with Mut, Panic, Div {
    let sum_sq = eps_a * eps_a + eps_b * eps_b
    sqrt_approx(sum_sq)
}

// Combine correlated errors: eps_a + eps_b (linear sum, conservative)
// For perfectly correlated or unknown correlation, linear sum is the
// sound upper bound.
fn epsilon_combine_correlated(eps_a: f64, eps_b: f64) -> f64 {
    let sum = eps_a + eps_b
    epsilon_clamp(sum)
}

// Combine relative errors for multiplication/division
// Relative errors add: (da/a) + (db/b)
fn epsilon_combine_relative(eps_a: f64, eps_b: f64) -> f64 {
    let sum = eps_a + eps_b
    epsilon_clamp(sum)
}

// Combine errors with unknown correlation (most conservative)
// Defaults to linear sum — sound upper bound for any correlation rho in [0,1]
fn epsilon_combine_unknown(eps_a: f64, eps_b: f64) -> f64 {
    epsilon_combine_correlated(eps_a, eps_b)
}

// Weighted combination for weighted averages
fn epsilon_combine_weighted(eps_a: f64, eps_b: f64, weight_a: f64, weight_b: f64) -> f64 with Panic, Div {
    let weighted_sum = weight_a * eps_a + weight_b * eps_b
    let total_weight = weight_a + weight_b
    if total_weight == 0.0 {
        1.0
    } else {
        epsilon_clamp(weighted_sum / total_weight)
    }
}

// BinaryOp enum is defined in parser/ast.sio and shared via concatenation.
// When checking this file standalone, the pinned binary's resolver provides it.

// Compute result type for binary operations on Knowledge types
// Handles epsilon propagation according to operation semantics
fn knowledge_binary_result(op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> TypeEntry with Mut, Panic, Div, Alloc {
    // If neither operand is Knowledge, return error
    let left_is_knowledge = is_knowledge_type(left_ty)
    let right_is_knowledge = is_knowledge_type(right_ty)

    if !left_is_knowledge && !right_is_knowledge {
        ty_error()
    } else {
        // Extract inner types and epsilons
        let left_inner = if left_is_knowledge {
            knowledge_inner(left_ty)
        } else {
            left_ty
        }
        let right_inner = if right_is_knowledge {
            knowledge_inner(right_ty)
        } else {
            right_ty
        }

        let left_eps = if left_is_knowledge {
            left_ty.knowledge_epsilon
        } else {
            0.0
        }
        let right_eps = if right_is_knowledge {
            right_ty.knowledge_epsilon
        } else {
            0.0
        }

        if !knowledge_op_supported(op) {
            return ty_error()
        }

        if !types_compatible(left_inner, right_inner) {
            return ty_error()
        }

        // Determine result epsilon based on operation
        let result_epsilon = match op {
            BinaryOp::OpAdd => epsilon_combine_independent(left_eps, right_eps),
            BinaryOp::OpSub => epsilon_combine_independent(left_eps, right_eps),
            BinaryOp::OpMul => epsilon_combine_relative(left_eps, right_eps),
            BinaryOp::OpDiv => epsilon_combine_relative(left_eps, right_eps),
            BinaryOp::OpRem => epsilon_combine_independent(left_eps, right_eps),
            _ => 0.0
        }

        // Determine result type based on operation
        match op {
            // Comparisons on Knowledge require explicit unwrap.
            BinaryOp::OpEq => ty_error(),
            BinaryOp::OpNe => ty_error(),
            BinaryOp::OpLt => ty_error(),
            BinaryOp::OpLe => ty_error(),
            BinaryOp::OpGt => ty_error(),
            BinaryOp::OpGe => ty_error(),
            // All other operations return Knowledge with combined epsilon
            _ => {
                // For arithmetic operations, result is Knowledge with combined epsilon
                // Inner type is the same as input inner types (assuming they match)
                ty_knowledge(left_inner, result_epsilon)
            }
        }
    }
}

// Check if binary operation is supported for Knowledge types
fn knowledge_op_supported(op: BinaryOp) -> bool {
    match op {
        BinaryOp::OpAdd => true,
        BinaryOp::OpSub => true,
        BinaryOp::OpMul => true,
        BinaryOp::OpDiv => true,
        BinaryOp::OpRem => true,
        BinaryOp::OpEq => false,
        BinaryOp::OpNe => false,
        BinaryOp::OpLt => false,
        BinaryOp::OpLe => false,
        BinaryOp::OpGt => false,
        BinaryOp::OpGe => false,
        BinaryOp::OpAnd => false,  // Logical ops not supported for Knowledge directly
        BinaryOp::OpOr => false,
        BinaryOp::OpBitAnd => false,
        BinaryOp::OpBitOr => false,
        BinaryOp::OpBitXor => false,
        BinaryOp::OpShl => false,  // Shift not typically used with Knowledge
        BinaryOp::OpShr => false,
        BinaryOp::OpConcat => false,
        BinaryOp::OpRange => false,
        BinaryOp::OpRangeInclusive => false
    }
}

// ============================================================
// Call boundary compatibility (lines 481-500)
// ============================================================

// Check knowledge compatibility at function call boundaries
// Considers epsilon, validity, and provenance
fn knowledge_call_boundary_compatible(provided: TypeEntry, required: TypeEntry) -> bool with Mut, Panic, Div, Alloc {
    if !is_epistemic_type(provided) || !is_epistemic_type(required) {
        return false
    }
    if !types_equal(knowledge_inner(provided), knowledge_inner(required)) {
        return false
    }
    let pmeta = knowledge_meta_from_ty(provided)
    let rmeta = knowledge_meta_from_ty(required)
    if !epsilon_subsumes_call_boundary(knowledge_meta_epsilon(pmeta), knowledge_meta_epsilon(rmeta)) {
        return false
    }
    if !validity_subsumes(knowledge_meta_validity(pmeta), knowledge_meta_validity(rmeta)) {
        return false
    }
    provenance_subsumes(knowledge_meta_provenance(pmeta), knowledge_meta_provenance(rmeta))
}

// ============================================================
// Contest / Policy / Robust type checkers
// ============================================================

fn check_contest_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_contest(inner_ty, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

fn check_policy_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_policy(inner_ty, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

fn check_robust_type(checker: Checker, span: Span, opt: Option<Box<TypeExprList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    match opt {
        Some(args_box) => {
            let args = *args_box
            let pair = checker.lower_type_expr(args.head)
            var c = pair.0
            let inner_ty = pair.1
            match args.tail {
                Some(_) => {
                    c = c.report_error_at(span, 63, 0, 0, 0)
                    (c, ty_error())
                }
                None => (c, ty_robust(inner_ty, -1, -1, -1))
            }
        }
        None => {
            let c = checker.report_error_at(span, 63, 0, 0, 0)
            (c, ty_error())
        }
    }
}

// ============================================================
// Epistemic/Aleatoric uncertainty kind checking (H6.3)
// ============================================================

// Check that a type is not being incorrectly used as epistemic
// when it is actually aleatoric. Returns error code 0 (ok) or 56/57 (error).
// E056: cannot reduce aleatoric uncertainty (it is irreducible)
// E057: cannot coerce epistemic to aleatoric
fn check_uncertainty_kind_reduction(source_ty: TypeEntry, target_ty: TypeEntry) -> i64 {
    match source_ty.kind {
        TypeKind::TyAleatoric => {
            match target_ty.kind {
                TypeKind::TyEpistemic => 56  // E056: aleatoric is irreducible
                TypeKind::TyKnowledge => 0   // OK: aleatoric <: Knowledge
                TypeKind::TyAleatoric => 0   // OK: same kind
                _ => 0
            }
        }
        TypeKind::TyEpistemic => {
            match target_ty.kind {
                TypeKind::TyAleatoric => 57  // E057: cannot coerce epistemic to aleatoric
                TypeKind::TyEpistemic => 0
                TypeKind::TyKnowledge => 0   // OK: epistemic <: Knowledge
                _ => 0
            }
        }
        _ => 0
    }
}

// Returns the resulting uncertainty TypeKind for a binary operation.
// Propagation rules:
//   Epistemic op Epistemic -> Epistemic (quadrature combination)
//   Aleatoric op Aleatoric -> Aleatoric (irreducible, stays aleatoric)
//   Epistemic op Aleatoric -> Knowledge  (mixed, conservative)
//   Knowledge  op anything  -> Knowledge
fn uncertainty_binary_result_kind(a: TypeEntry, b: TypeEntry) -> TypeKind {
    match a.kind {
        TypeKind::TyEpistemic => {
            match b.kind {
                TypeKind::TyEpistemic => TypeKind::TyEpistemic
                TypeKind::TyAleatoric => TypeKind::TyKnowledge
                TypeKind::TyKnowledge => TypeKind::TyKnowledge
                _ => TypeKind::TyEpistemic
            }
        }
        TypeKind::TyAleatoric => {
            match b.kind {
                TypeKind::TyAleatoric => TypeKind::TyAleatoric
                TypeKind::TyEpistemic => TypeKind::TyKnowledge
                TypeKind::TyKnowledge => TypeKind::TyKnowledge
                _ => TypeKind::TyAleatoric
            }
        }
        TypeKind::TyKnowledge => TypeKind::TyKnowledge
        _ => TypeKind::TyKnowledge
    }
}

// ============================================================
// Sprint 20 Track SC: Singleton physical constant checking
// ============================================================
// check_singleton_type: verifies that a Singleton<T, name> type annotation
// is valid. Rules:
//   1. The constant name must be non-empty.
//   2. The inner type must be f64 (physical constants are always real-valued).
//   3. The unit_id must match a known SI unit (-1 is allowed for dimensionless).
// Returns an error code (0 = ok, E070 = invalid singleton).
fn check_singleton_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TySingleton {
        return 0
    }
    if ty.name.len <= 0 {
        return 70  // E070: singleton constant name must be non-empty
    }
    match ty.inner {
        None => return 70
        Some(inner) => {
            // Physical constants must be f64 or f32
            if (*inner).kind != TypeKind::TyF64 && (*inner).kind != TypeKind::TyF32 {
                return 70
            }
        }
    }
    0
}

fn is_valid_singleton(ty: TypeEntry) -> bool {
    check_singleton_type(ty) == 0
}

// singleton_names_match: true if both are singleton types with equal constant names
fn singleton_names_match(a: TypeEntry, b: TypeEntry) -> bool {
    if a.kind != TypeKind::TySingleton { return false }
    if b.kind != TypeKind::TySingleton { return false }
    name_eq(a.name, b.name)
}

// ============================================================
// Sprint 20 Track SE: Scoped effect type checking
// ============================================================
// check_scoped_effect_type: verifies ScopedEffect<E, ε> is well-formed.
// Rules:
//   1. The effect label (name) must be non-empty.
//   2. The epsilon budget must be >= 0.0.
//   3. Inner type (computation result) must be present.
// Returns error code (0 = ok, E071 = malformed scoped effect).
fn check_scoped_effect_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyScopedEffect {
        return 0
    }
    if ty.name.len <= 0 {
        return 71  // E071: scoped effect label must be non-empty
    }
    // Epsilon must be non-negative (or unset = -1.0)
    if ty.knowledge_epsilon >= 0.0 || ty.knowledge_epsilon == (0.0 - 1.0) {
        // ok
    } else {
        return 71
    }
    0
}

fn scoped_effect_budget_ok(ty: TypeEntry, actual_epsilon: f64) -> bool {
    if ty.kind != TypeKind::TyScopedEffect { return true }
    // If budget is unset (-1.0), any epsilon is fine
    if ty.knowledge_epsilon < 0.0 { return true }
    actual_epsilon <= ty.knowledge_epsilon
}

// ============================================================
// Sprint 20 Track CI: Conditional independence type checking
// ============================================================
// check_cond_indep_type: verifies IndepKnowledge<T, A, B | Z> is well-formed.
// Rules:
//   1. var_a != var_b (a variable is trivially independent of itself — degenerate).
//   2. The base type (inner) must be present.
//   3. Confidence must be in (0, 1] or unset (-1.0).
// Returns error code (0 = ok, E072 = malformed CI claim).
fn check_cond_indep_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyCondIndep {
        return 0
    }
    // var_a must differ from var_b (degenerate independence)
    if ty.array_size == ty.fn_sig_id && ty.array_size >= 0 {
        return 72  // E072: a variable cannot be declared independent of itself
    }
    match ty.inner {
        None => return 72
        Some(_) => {}
    }
    // Confidence must be in (0, 1] or unset
    if ty.knowledge_epsilon > 1.0 || ty.knowledge_epsilon == 0.0 {
        return 72
    }
    0
}

fn is_valid_cond_indep(ty: TypeEntry) -> bool {
    check_cond_indep_type(ty) == 0
}

// cond_indep_structurally_holds: structural check for d-separation.
// Returns true if the claimed independence is plausibly structurally valid.
// Full SMT-backed graph check is wired through causal.sio; this is the
// lightweight fallback for common cases.
// var_a=-1 or var_b=-1 means the variable IDs are unresolved — allow.
fn cond_indep_structurally_holds(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyCondIndep { return false }
    if ty.array_size < 0 || ty.fn_sig_id < 0 {
        return true  // unresolved ids: structural check deferred
    }
    if ty.array_size == ty.fn_sig_id {
        return false  // degenerate
    }
    true  // conservative: structural check passes, full d-sep via causal graph in causal.sio
}

// ============================================================
// Sprint 20 Track PO: Potential outcomes type checking
// ============================================================
// check_potential_outcome_type: verifies PotentialOutcome<T, T0, T1> is well-formed.
// Rules:
//   1. inner type must be present (the outcome type T).
//   2. policy_id must be set (>= 0) — cannot have anonymous potential outcome.
//   3. ctrl_id and treat_id can be -1 (unresolved) but not equal (collapses to triviality).
// Linear type: once observed (outcome extracted), the PotentialOutcome is consumed.
// Returns error code (0 = ok, E073 = malformed potential outcome).
fn check_potential_outcome_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyPotentialOutcome {
        return 0
    }
    match ty.inner {
        None => return 73  // E073: potential outcome must have an inner type
        Some(_) => {}
    }
    // ctrl and treat ids must not be identical (would collapse to trivial observation)
    if ty.epistemic_meta_id >= 0 && ty.robustness_level_id >= 0 {
        if ty.epistemic_meta_id == ty.robustness_level_id {
            return 73  // E073: control and treatment worlds must differ
        }
    }
    0
}

fn is_valid_potential_outcome(ty: TypeEntry) -> bool {
    check_potential_outcome_type(ty) == 0
}

// check_ate_type: verifies ATE<T> is well-formed.
// Rules:
//   1. inner type must be numeric (f64 or f32 — ATE is always a real-valued estimand).
fn check_ate_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyATE {
        return 0
    }
    match ty.inner {
        None => return 74  // E074: ATE must have an inner type
        Some(inner) => {
            if (*inner).kind != TypeKind::TyF64 && (*inner).kind != TypeKind::TyF32 {
                return 74  // E074: ATE inner type must be f64 (estimand is a real number)
            }
        }
    }
    0
}

fn is_valid_ate(ty: TypeEntry) -> bool {
    check_ate_type(ty) == 0
}

// potential_outcome_to_ate: type-level transformation PotentialOutcome<f64> -> ATE<f64>
// Models: from potential outcomes, derive average treatment effect estimand.
fn potential_outcome_to_ate(po_ty: TypeEntry, po_id: i64) -> TypeEntry with Alloc {
    match po_ty.inner {
        None => ty_ate(ty_f64(), po_id)
        Some(inner) => ty_ate(*inner, po_id)
    }
}

// ============================================================
// Track DP: Differential Privacy types (Sprint 21)
// ============================================================
// Reference: Dwork et al. 2006 "Calibrating Noise to Sensitivity in Private Data Analysis"
//   Theorem 3.14: Sequential composition — ε_total = Σεᵢ
//   Theorem 3.20: Parallel composition (disjoint datasets) — ε_total = max(εᵢ)
//
// SOTA novelty: No prior type system encodes ε as a type-level quantity with composition.
//   DFuzz (POPL 2013), Fuzzi (PLDI 2019), Duet (POPL 2020) track *sensitivity* (Δf).
//   Sounio tracks the *budget* (ε) — first language with DP budget as a graded type.

// E075: DiffPrivate type invalid — ε must be positive, inner must be valid
fn check_diff_private_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyDiffPrivate {
        return 1
    }
    // ε must be positive (milli-ratio > 0)
    if ty.knowledge_epsilon <= 0.0 {
        return 75
    }
    // inner type must be present
    match ty.inner {
        None => 75
        Some(_) => 0
    }
}

fn is_valid_diff_private(ty: TypeEntry) -> bool {
    check_diff_private_type(ty) == 0
}

// Sequential composition: DiffPrivate<T, ε1> ; DiffPrivate<T, ε2> → DiffPrivate<T, ε1+ε2>
// Theorem 3.14 (Dwork 2006): privacy degrades additively under sequential composition.
fn dp_sequential_compose(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with Alloc {
    let combined_eps = ty_a.knowledge_epsilon + ty_b.knowledge_epsilon
    let inner_ty = match ty_a.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    ty_diff_private(inner_ty, combined_eps as i64, ty_a.fn_sig_id)
}

// Parallel composition: DiffPrivate<T, ε1> || DiffPrivate<T, ε2> → DiffPrivate<T, max(ε1,ε2)>
// Theorem 3.20 (Dwork 2006): on disjoint datasets, worst-case ε is the maximum.
fn dp_parallel_compose(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with Alloc {
    let max_eps = if ty_a.knowledge_epsilon > ty_b.knowledge_epsilon {
        ty_a.knowledge_epsilon
    } else {
        ty_b.knowledge_epsilon
    }
    let inner_ty = match ty_a.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    ty_diff_private(inner_ty, max_eps as i64, ty_a.fn_sig_id)
}

// E076: Privacy budget exhausted — ε_spent > ε_total
fn check_dp_budget_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyDPBudget {
        return 1
    }
    // ε_total must be positive
    if ty.knowledge_epsilon <= 0.0 {
        return 76
    }
    // ε_spent must not exceed ε_total (budget exhausted)
    if (ty.array_size as f64) > ty.knowledge_epsilon {
        return 76
    }
    // inner type must be present
    match ty.inner {
        None => 76
        Some(_) => 0
    }
}

fn is_valid_dp_budget(ty: TypeEntry) -> bool {
    check_dp_budget_type(ty) == 0
}

// Remaining budget: ε_total - ε_spent (in milli-ratio units)
fn dp_budget_remaining(budget_ty: TypeEntry) -> i64 {
    (budget_ty.knowledge_epsilon as i64) - budget_ty.array_size
}

// Consume ε from the budget: produces new DPBudget with ε_spent incremented.
// Returns the original if inner is missing (error recovery).
fn dp_budget_consume(budget_ty: TypeEntry, epsilon_to_spend_milli: i64) -> TypeEntry with Alloc {
    let new_spent = budget_ty.array_size + epsilon_to_spend_milli
    let inner_ty = match budget_ty.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    ty_dp_budget(inner_ty, budget_ty.knowledge_epsilon as i64, new_spent)
}

// ============================================================
// Track T: Causal Transportability types (Sprint 22)
// ============================================================
// Reference: Pearl & Bareinboim (2014) "External Validity: From Do-Calculus to Transportability"
//   Bareinboim & Pearl (2016) "Causal inference and the data-fusion problem"
//   S-admissibility (Def 3, Pearl & Bareinboim 2014): a set of covariates Z is S-admissible
//   if (Y ⊥⊥ S | Z, do(X)) in the augmented causal DAG with selection node S.
//   When satisfied: P*(Y|do(X)) = Σ_z P(Y|do(X), Z=z) P*(Z=z)
//
// SOTA novelty: No prior type system encodes causal transportability or S-admissibility.
//   This completes Pearl's Layer 4 (transportability) in Sounio's type system.

// E078: transport not S-admissible — selection bias blocks cross-domain identification
fn check_transportable_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyTransportable {
        return 1
    }
    // confidence=0 means S-admissibility was not established
    if ty.knowledge_epsilon <= 0.0 {
        return 78
    }
    // Must have a valid effect type
    match ty.inner {
        None => 78
        Some(_) => 0
    }
}

fn is_valid_transportable(ty: TypeEntry) -> bool {
    check_transportable_type(ty) == 0
}

// S-admissibility structural check: selection_bias_id < 0 means no selection detected
// (trivially S-admissible). Positive selection_bias_id means a selection node was found
// and the transport must use the reweighting formula.
fn is_s_admissible(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyTransportable {
        return false
    }
    // confidence_milli == 1000 means fully identified (S-admissible confirmed)
    // confidence_milli == 0 means unknown (cannot confirm transport)
    ty.knowledge_epsilon >= 1000.0
}

// transport_to_ate: type-level transport identification
// Transport<f64, src, tgt, S> → ATE<f64> when S-admissible.
// Corresponds to: P*(Y|do(X)) = Σ_z P(Y|do(X), Z=z) * P*(Z=z)
fn transport_to_ate(transport_ty: TypeEntry, po_id: i64) -> TypeEntry with Alloc {
    match transport_ty.inner {
        None => ty_ate(ty_f64(), po_id)
        Some(inner) => ty_ate(*inner, po_id)
    }
}

// E079: invalid selection diagram — must have non-negative diagram_id and s_node_count
fn check_selection_diagram_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TySelectionDiagram {
        return 1
    }
    // s_node_count must be non-negative
    if ty.array_size < 0 {
        return 79
    }
    match ty.inner {
        None => 79
        Some(_) => 0
    }
}

fn is_valid_selection_diagram(ty: TypeEntry) -> bool {
    check_selection_diagram_type(ty) == 0
}

// ============================================================
// Track F: ML Fairness types (Sprint 22)
// ============================================================
// References:
//   Dwork et al. (2012) "Fairness Through Awareness" — individual + demographic parity
//   Hardt et al. (2016) "Equality of Opportunity in Supervised Learning" — equalized odds
//   Chouldechova (2017) "Fair Prediction with Disparate Impact" — impossibility theorem
//   Kusner et al. (2017) "Counterfactual Fairness" — counterfactual criterion
//
// SOTA novelty: No prior type system encodes demographic parity / equalized odds / counterfactual
//   fairness as a type-level constraint. Chouldechova impossibility theorem as type predicate (E082)
//   is also completely novel.
//
// Fairness criterion codes (array_size):
//   0 = demographic_parity, 1 = equalized_odds, 2 = individual_fairness,
//   3 = calibration_within_group, 4 = counterfactual_fairness

let FAIRNESS_CRITERION_DP: i64 = 0
let FAIRNESS_CRITERION_EO: i64 = 1
let FAIRNESS_CRITERION_IF: i64 = 2
let FAIRNESS_CRITERION_CWG: i64 = 3
let FAIRNESS_CRITERION_CF: i64 = 4

// E080: invalid fairness type — criterion out of range or attribute_id < -1
fn check_fair_prediction_type(ty: TypeEntry) -> i64 {
    if ty.kind != TypeKind::TyFairPrediction {
        return 1
    }
    // criterion must be in [0, 4]
    if ty.array_size < 0 || ty.array_size > 4 {
        return 80
    }
    // slack must be non-negative
    if ty.knowledge_epsilon < 0.0 {
        return 80
    }
    match ty.inner {
        None => 80
        Some(_) => 0
    }
}

fn is_valid_fair_prediction(ty: TypeEntry) -> bool {
    check_fair_prediction_type(ty) == 0
}

// E081: fairness gap exceeds declared slack — actual disparity > tolerance
fn check_fairness_gap_type(gap_ty: TypeEntry, fair_ty: TypeEntry) -> i64 {
    if gap_ty.kind != TypeKind::TyFairnessGap {
        return 1
    }
    // Criteria must match
    if gap_ty.array_size != fair_ty.array_size {
        return 81
    }
    // measured_gap_milli must not exceed the declared slack_milli
    if gap_ty.knowledge_epsilon > fair_ty.knowledge_epsilon {
        return 81
    }
    0
}

// fairness_impossibility_holds — Chouldechova 2017 impossibility theorem:
// Demographic parity ∧ Equalized odds ∧ Calibration-within-group cannot ALL hold
// simultaneously when base rates differ across groups.
// Returns true if the combination of two criteria is contradictory (triggers E082).
fn fairness_impossibility_holds(criterion_a: i64, criterion_b: i64) -> bool {
    // Chouldechova (2017): the tension is between DP/EO and Calibration.
    // In a binary prediction setting with unequal base rates (prevalence p_a ≠ p_b):
    //   - DP (criterion 0) and Calibration (criterion 3) cannot both hold
    //   - EO (criterion 1) and Calibration (criterion 3) cannot both hold
    //   - DP and EO can only simultaneously hold when base rates are equal
    let dp_and_cal = (criterion_a == FAIRNESS_CRITERION_DP && criterion_b == FAIRNESS_CRITERION_CWG)
        || (criterion_a == FAIRNESS_CRITERION_CWG && criterion_b == FAIRNESS_CRITERION_DP)
    let eo_and_cal = (criterion_a == FAIRNESS_CRITERION_EO && criterion_b == FAIRNESS_CRITERION_CWG)
        || (criterion_a == FAIRNESS_CRITERION_CWG && criterion_b == FAIRNESS_CRITERION_EO)
    dp_and_cal || eo_and_cal
}

// counterfactual_fairness_from_potential_outcome:
// TyPotentialOutcome<T> → TyFairPrediction<T, counterfactual_fairness, attr>
// Bridges Sprint 20 PO track with Sprint 22 fairness track.
//
// Kusner et al. (2017): a predictor Ŷ is counterfactually fair if for every individual
// and value of the protected attribute A, the potential outcome Ŷ(A←a) equals Ŷ(A←a').
// This corresponds to: TyPotentialOutcome<T> (linear-consumed) guarantees the "one arm"
// property, which is exactly the requirement for counterfactual fairness.
fn counterfactual_fairness_from_potential_outcome(po_ty: TypeEntry, attr_id: i64) -> TypeEntry with Alloc {
    let inner_ty = match po_ty.inner {
        None => ty_f64()
        Some(inner) => *inner
    }
    // criterion=4 (counterfactual_fairness), slack=0 (exact, not approximate)
    ty_fair_prediction(inner_ty, FAIRNESS_CRITERION_CF, attr_id, 0)
}

// ============================================================
// Sprint 23 Track P: Probabilistic Types (E083-E086)
// ============================================================
// Distribution kind constants (mirrors types.sio)
let DIST_NORMAL_EP: i64 = 0
let DIST_BERNOULLI_EP: i64 = 1
let DIST_POISSON_EP: i64 = 2
let DIST_EXPONENTIAL_EP: i64 = 3
let DIST_UNIFORM_EP: i64 = 4
let DIST_BETA_EP: i64 = 5
let DIST_DIRICHLET_EP: i64 = 6
let DIST_CATEGORICAL_EP: i64 = 7

fn is_valid_distribution(ty: TypeEntry) -> bool with IO {
    // Valid: kind in [-1, 7], inner must be present
    if ty.array_size < -1 { return false }
    if ty.array_size > 7 { return false }
    if ty.knowledge_epsilon != -1.0 && ty.knowledge_epsilon < 0.0 { return false }
    true
}

fn check_distribution_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_distribution(ty) { return 0 }
    83  // E083
}

fn is_valid_sample(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    if ty.array_size > 7 { return false }
    if ty.knowledge_epsilon < 0.0 && ty.knowledge_epsilon != -1.0 { return false }
    true
}

fn check_sample_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_sample(ty) { return 0 }
    84  // E084
}

fn check_sample_dist_compat(sample_ty: TypeEntry, dist_ty: TypeEntry) -> i64 with IO {
    // E084 if distribution kinds don't match (and neither is -1=parametric)
    if sample_ty.array_size == -1 { return 0 }
    if dist_ty.array_size == -1 { return 0 }
    if sample_ty.array_size == dist_ty.array_size { return 0 }
    84
}

fn is_valid_conditional_dist(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    true
}

fn check_conditional_dist_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_conditional_dist(ty) { return 0 }
    85  // E085
}

fn check_conditional_normalized(ty: TypeEntry) -> bool with IO {
    // log_normalizer_milli = 0 means unnormalized
    ty.knowledge_epsilon != 0.0
}

// Conjugacy check: prior kind x likelihood kind
fn is_conjugate_pair(prior_kind: i64, likelihood_kind: i64) -> bool with IO {
    // Normal + Normal -> Normal
    if prior_kind == DIST_NORMAL_EP && likelihood_kind == DIST_NORMAL_EP { return true }
    // Beta + Bernoulli -> Beta
    if prior_kind == DIST_BETA_EP && likelihood_kind == DIST_BERNOULLI_EP { return true }
    // Dirichlet + Categorical -> Dirichlet
    if prior_kind == DIST_DIRICHLET_EP && likelihood_kind == DIST_CATEGORICAL_EP { return true }
    // Gamma + Poisson -> Gamma (Gamma not yet in DIST_ constants; use Exponential as proxy)
    if prior_kind == DIST_EXPONENTIAL_EP && likelihood_kind == DIST_POISSON_EP { return true }
    false
}

fn check_conjugate_update(prior_ty: TypeEntry, likelihood_ty: TypeEntry) -> i64 with IO {
    if is_conjugate_pair(prior_ty.array_size, likelihood_ty.array_size) { return 0 }
    86  // E086: non-conjugate pair
}

// Bridge: Distribution -> Contest (model disagreement across distributions)
fn dist_to_contest(dist_ty: TypeEntry, model_count: i64) -> TypeEntry with IO, Alloc {
    // Wraps distribution in a Contest with model_count witnesses
    ty_contest(dist_ty, model_count)
}

// Bridge: Conditional -> Robust (posterior with proof of correctness)
fn conditional_to_robust(cond_ty: TypeEntry, proof_id: i64) -> TypeEntry with IO, Alloc {
    ty_robust(cond_ty, proof_id, 0)
}

fn sample_from_distribution(dist_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    ty_sample(dist_ty, dist_ty.array_size, -1, 1000.0, -1)
}

fn dist_marginalize(joint_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // Returns a distribution with same kind but wrapped inner
    ty_distribution(joint_ty, joint_ty.array_size, -1, -1.0, -1)
}

fn dist_product(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with IO, Alloc {
    // Independent joint: family stays general (-1)
    ty_distribution(ty_a, -1, -1, -1.0, -1)
}

// ============================================================
// Sprint 23 Track I: Information-Theoretic Types (E087-E090)
// ============================================================

fn is_valid_entropic(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    if ty.array_size > 3 { return false }
    if ty.knowledge_epsilon != -1.0 && ty.knowledge_epsilon < 0.0 { return false }
    true
}

fn check_entropic_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_entropic(ty) { return 0 }
    87  // E087
}

fn is_valid_mutual_info(ty: TypeEntry) -> bool with IO {
    if ty.knowledge_epsilon < 0.0 && ty.knowledge_epsilon != -1.0 { return false }
    if ty.array_size < -1 { return false }
    if ty.array_size > 3 { return false }
    true
}

fn check_mutual_info_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_mutual_info(ty) { return 0 }
    88  // E088
}

fn check_dpi_step(before_ty: TypeEntry, after_ty: TypeEntry) -> i64 with IO {
    // Data Processing Inequality: I(X;Z) <= I(X;Y) after processing
    // after.knowledge_epsilon <= before.knowledge_epsilon (both in milli-nats)
    if before_ty.knowledge_epsilon < 0.0 { return 0 }  // no bound -> always ok
    if after_ty.knowledge_epsilon < 0.0 { return 88 }  // after unbounded but before bounded -> E088
    if after_ty.knowledge_epsilon <= before_ty.knowledge_epsilon { return 0 }
    88  // E088: MI increased after processing (DPI violated)
}

fn is_valid_kl_bounded(ty: TypeEntry) -> bool with IO {
    // KL divergence >= 0 always (Gibbs inequality)
    if ty.knowledge_epsilon < 0.0 { return false }
    if ty.array_size < -1 { return false }
    if ty.array_size > 2 { return false }
    true
}

fn check_kl_bounded_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_kl_bounded(ty) { return 0 }
    89  // E089: KL bound negative
}

fn check_entropy_subsumes(sub_ty: TypeEntry, sup_ty: TypeEntry) -> i64 with IO {
    // Entropic<T,H1> <= Entropic<T,H2> iff H1 <= H2
    // sub has MORE entropy than sup -> contradiction
    if sub_ty.knowledge_epsilon < 0.0 { return 0 }  // sub unbounded -> always fits
    if sup_ty.knowledge_epsilon < 0.0 { return 0 }  // sup unbounded -> always accepts
    if sub_ty.knowledge_epsilon <= sup_ty.knowledge_epsilon { return 0 }
    90  // E090: entropy ordering contradiction
}

fn entropy_combine_independent(ty_a: TypeEntry, ty_b: TypeEntry) -> TypeEntry with IO, Alloc {
    // H(X,Y) = H(X) + H(Y) for independent X, Y
    let combined_milli = ty_a.knowledge_epsilon + ty_b.knowledge_epsilon
    ty_entropic(ty_a, combined_milli, 0, -1, 0)
}

fn entropy_chain_rule(joint_ty: TypeEntry, cond_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // H(X,Y) = H(X) + H(Y|X); returns H(X) given joint and conditional
    let hx_milli = joint_ty.knowledge_epsilon + (0.0 - cond_ty.knowledge_epsilon)
    ty_entropic(joint_ty, hx_milli, 0, -1, 0)
}

fn kl_to_tv_pinsker(kl_ty: TypeEntry) -> TypeEntry with IO, Alloc, Panic {
    // Pinsker's inequality: TV(P,Q)^2 <= KL(P||Q)/2
    // tv_bound_milli = sqrt(kl_milli / 2000) * 1000 (approximate)
    let half_kl = kl_ty.knowledge_epsilon / 2.0
    // sqrt via 1-step Newton: sqrt(x) ~= x/2 for x << 1
    let tv_milli = half_kl / 2.0
    ty_kl_bounded(kl_ty, tv_milli, -1, 0, -1, -1)
}

fn mutual_info_from_entropics(hx_ty: TypeEntry, hy_ty: TypeEntry, hxy_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // I(X;Y) = H(X) + H(Y) - H(X,Y)
    let mi_milli = hx_ty.knowledge_epsilon + hy_ty.knowledge_epsilon + (0.0 - hxy_ty.knowledge_epsilon)
    ty_mutual_info(hx_ty, -1, mi_milli, 3, 0)
}

// Bridge: KLBounded -> ELBO (KL gap directly gives ELBO gap)
fn kl_bounded_to_elbo(kl_ty: TypeEntry, model_id: i64) -> TypeEntry with IO, Alloc {
    ty_elbo(kl_ty, -1, model_id, kl_ty.knowledge_epsilon, -1, 0)
}

// ============================================================
// Sprint 23 Track V: Shape-Typed Linear Algebra (E091-E094)
// ============================================================

fn is_valid_vec_shaped(ty: TypeEntry) -> bool with IO {
    if ty.array_size == 0 { return false }  // zero-length degenerate
    true
}

fn check_vec_shaped_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_vec_shaped(ty) { return 0 }
    91  // E091
}

fn check_vec_length_compat(v1: TypeEntry, v2: TypeEntry) -> i64 with IO {
    if v1.array_size == -1 { return 0 }  // polymorphic
    if v2.array_size == -1 { return 0 }  // polymorphic
    if v1.array_size == v2.array_size { return 0 }
    91  // E091: length mismatch
}

fn is_valid_matrix_shaped(ty: TypeEntry) -> bool with IO {
    if ty.array_size == 0 { return false }   // zero columns
    if ty.algebra_kind == 0 { return false } // zero rows
    true
}

fn check_matrix_shaped_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_matrix_shaped(ty) { return 0 }
    92  // E092
}

fn check_matmul_dims(left: TypeEntry, right: TypeEntry) -> i64 with IO {
    // Matrix<T, m, k> x Matrix<T, k, n>: left.n (array_size) must equal right.m (algebra_kind)
    if left.array_size == -1 { return 0 }
    if right.algebra_kind == -1 { return 0 }
    if left.array_size == right.algebra_kind { return 0 }
    92  // E092: dimension mismatch
}

fn matmul_result_type(left: TypeEntry, right: TypeEntry) -> TypeEntry with IO, Alloc {
    // Matrix<T, m, k> x Matrix<T, k, n> -> Matrix<T, m, n>
    // result.m = left.algebra_kind (m), result.n = right.array_size (n)
    ty_matrix_shaped(left, left.algebra_kind, right.array_size, left.fn_sig_id, -1.0, 0)
}

fn check_decomp_shape(ty: TypeEntry, decomp_kind: i64) -> i64 with IO {
    // decomp_kind: 0=Cholesky, 1=QR, 2=LU, 3=SVD, 4=eig
    if decomp_kind == 3 { return 0 }  // SVD always valid
    let m = ty.algebra_kind
    let n = ty.array_size
    if decomp_kind == 0 {
        // Cholesky: square AND SPD (symmetry_tag=2)
        if m != n { return 93 }
        if ty.epistemic_meta_id != 2 { return 93 }
        return 0
    }
    if decomp_kind == 1 {
        // QR: m >= n (overdetermined)
        if m == -1 || n == -1 { return 0 }
        if m < n { return 93 }
        return 0
    }
    if decomp_kind == 2 {
        // LU: square
        if m != n { return 93 }
        return 0
    }
    if decomp_kind == 4 {
        // Eigendecomp: square
        if m != n { return 93 }
        return 0
    }
    0
}

fn is_valid_broadcastable(ty: TypeEntry) -> bool with IO {
    // actual_m must be 1 OR equal m_target (algebra_kind)
    let m_target = ty.algebra_kind
    let actual_m = ty.clifford_p
    let n_target = ty.array_size
    let actual_n = ty.fn_sig_id
    if m_target == -1 { return true }
    if actual_m == -1 { return true }
    if actual_m == 1 { return true }
    if actual_m != m_target { return false }
    if n_target == -1 { return true }
    if actual_n == -1 { return true }
    if actual_n == 1 { return true }
    if actual_n != n_target { return false }
    true
}

fn check_broadcastable_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_broadcastable(ty) { return 0 }
    94  // E094
}

fn matrix_transpose_type(ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // Matrix<T, m, n> -> Matrix<T, n, m>
    ty_matrix_shaped(ty, ty.array_size, ty.algebra_kind, ty.fn_sig_id, ty.knowledge_epsilon, ty.epistemic_meta_id)
}

fn broadcast_result_type(a: TypeEntry, b: TypeEntry) -> TypeEntry with IO, Alloc {
    // NumPy broadcast: max of dimensions
    let m_out = if a.algebra_kind > b.algebra_kind { a.algebra_kind } else { b.algebra_kind }
    let n_out = if a.array_size > b.array_size { a.array_size } else { b.array_size }
    ty_matrix_shaped(a, m_out, n_out, a.fn_sig_id, -1.0, 0)
}

fn vec_outer_product_type(v1: TypeEntry, v2: TypeEntry) -> TypeEntry with IO, Alloc {
    // Vec<T,m> x Vec<T,n> -> Matrix<T, m, n>
    ty_matrix_shaped(v1, v1.array_size, v2.array_size, 0, -1.0, 0)
}

// ============================================================
// Sprint 23 Track X: Variational Inference Types (E095-E096)
// ============================================================

fn is_valid_elbo(ty: TypeEntry) -> bool with IO {
    // KL gap must be non-negative (KL >= 0 always)
    if ty.knowledge_epsilon < 0.0 && ty.knowledge_epsilon != -1.0 { return false }
    if ty.array_size < -1 { return false }
    if ty.array_size > 3 { return false }
    true
}

fn check_elbo_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_elbo(ty) { return 0 }
    95  // E095
}

fn is_valid_variational_family(ty: TypeEntry) -> bool with IO {
    if ty.array_size < -1 { return false }
    if ty.array_size > 4 { return false }
    if ty.knowledge_epsilon < 0.0 { return false }
    true
}

fn check_variational_family_type(ty: TypeEntry) -> i64 with IO {
    if is_valid_variational_family(ty) { return 0 }
    96  // E096
}

fn elbo_from_kl_bounded(q_ty: TypeEntry, kl_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // KLBounded<Q, delta> -> ELBO<Q, P, delta>
    ty_elbo(q_ty, -1, kl_ty.fn_sig_id, kl_ty.knowledge_epsilon, -1, 0)
}

fn elbo_tighten(elbo_ty: TypeEntry, new_kl_milli: f64) -> TypeEntry with IO, Alloc {
    // Monotone refinement: new_kl_milli must be <= elbo_ty.knowledge_epsilon
    let kl = if new_kl_milli < elbo_ty.knowledge_epsilon { new_kl_milli } else { elbo_ty.knowledge_epsilon }
    ty_elbo(elbo_ty, elbo_ty.array_size, elbo_ty.fn_sig_id, kl, elbo_ty.epistemic_meta_id, elbo_ty.algebra_kind)
}

// Bridge: ELBO -> Contest (VI result lifted to contested posterior)
fn vi_to_contest(elbo_ty: TypeEntry, model_count: i64) -> TypeEntry with IO, Alloc {
    // The approximation gap (kl_gap_milli) becomes the epistemic uncertainty in Contest
    ty_contest(elbo_ty, model_count)
}

// Bridge: ELBO -> Robust (when ELBO has converged -- epistemic_meta_id > 0)
fn elbo_to_robust(elbo_ty: TypeEntry, proof_id: i64) -> TypeEntry with IO, Alloc {
    ty_robust(elbo_ty, proof_id, 0)
}

fn variational_family_expressiveness(family_ty: TypeEntry) -> i64 with IO {
    // Returns capacity bound based on family kind
    // 0=mean_field_gaussian: low (1), 1=full_rank: medium (2),
    // 2=IAF: high (3), 3=RNVP: high (3), 4=planar_flow: medium (2)
    if family_ty.array_size == 0 { return 1 }
    if family_ty.array_size == 1 { return 2 }
    if family_ty.array_size == 2 { return 3 }
    if family_ty.array_size == 3 { return 3 }
    if family_ty.array_size == 4 { return 2 }
    1
}

// ================================================================
// Sprint 24 Track A: Differentiable Programming Types (E100-E103)
// References: Elliott ICFP 2018, Huot et al. LICS 2020,
//             Pearlmutter & Siskind POPL 2008
// ================================================================

fn is_valid_differentiable(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyDifferentiable { return false }
    if ty.array_size < -1 { return false }
    true
}

fn check_differentiable_type(ty: TypeEntry) -> i64 with IO {
    // E100: invalid differentiable type
    if ty.kind != TypeKind::TyDifferentiable { return 100 }
    if ty.array_size < -1 { return 100 }
    0
}

fn is_valid_gradient(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyGradient { return false }
    if ty.array_size == 0 { return false }
    true
}

fn check_gradient_type(grad_ty: TypeEntry, fn_ty: TypeEntry) -> i64 with IO {
    // E101: gradient dimension mismatch
    if grad_ty.kind != TypeKind::TyGradient { return 101 }
    if grad_ty.array_size != -1 && fn_ty.array_size != -1 {
        if grad_ty.array_size != fn_ty.array_size { return 101 }
    }
    if grad_ty.algebra_kind == 0 { return 101 }
    0
}

fn is_valid_jacobian(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyJacobian { return false }
    if ty.array_size == 0 { return false }
    if ty.algebra_kind == 0 { return false }
    true
}

fn check_jacobian_type(jac_ty: TypeEntry) -> i64 with IO {
    // E102: Jacobian dimension invalid
    if jac_ty.kind != TypeKind::TyJacobian { return 102 }
    if jac_ty.array_size == 0 { return 102 }
    if jac_ty.algebra_kind == 0 { return 102 }
    0
}

fn check_ad_mode_compat(grad_ty: TypeEntry, requires_reverse: bool) -> i64 with IO {
    // E103: forward-only mode incompatible with Langevin/reverse-mode context
    if grad_ty.kind != TypeKind::TyGradient { return 103 }
    if requires_reverse {
        if grad_ty.epistemic_meta_id == 0 { return 103 }
    }
    0
}

fn diff_compose(outer: TypeEntry, inner_fn: TypeEntry) -> TypeEntry with IO, Alloc, Mut {
    // Chain rule: C^k o C^j = C^min(k,j)
    var k: i64 = outer.array_size
    let j: i64 = inner_fn.array_size
    if j != -1 && k != -1 {
        if j < k { k = j }
    } else {
        if j == -1 && k == -1 { k = -1 }
        else if j == -1 { k = k }
        else { k = j }
    }
    ty_differentiable(inner_fn, k, -1, 0.0 - 1.0, outer.epistemic_meta_id)
}

fn gradient_norm_check(grad_ty: TypeEntry, actual_norm_milli: f64) -> i64 with IO {
    if grad_ty.knowledge_epsilon < 0.0 { return 0 }
    if actual_norm_milli <= grad_ty.knowledge_epsilon { return 0 }
    103
}

fn jacobian_from_matrix_shape(mat_ty: TypeEntry, base_fn_id: i64) -> TypeEntry with IO, Alloc {
    // BRIDGE: TyMatrixShaped -> TyJacobian
    ty_jacobian(mat_ty, mat_ty.array_size, mat_ty.algebra_kind, base_fn_id, mat_ty.knowledge_epsilon, 0)
}

fn langevin_from_gradient(grad_ty: TypeEntry, temperature_milli: i64) -> TypeEntry with IO, Alloc {
    // MOONSHOT BRIDGE A->B: TyGradient<loss,n,1> -> TySDE<x, -grad_f, sqrt(2*eta*T)>
    // Langevin: dX = -grad_f(X) dt + sqrt(2T) dW, sde_kind=2 (Langevin)
    let state_dim: i64 = grad_ty.array_size
    let drift_id: i64 = grad_ty.fn_sig_id
    let diffusion_bound: f64 = temperature_milli as f64
    ty_sde(grad_ty, state_dim, drift_id, -1, diffusion_bound, 2)
}

// ================================================================
// Sprint 24 Track B: Stochastic Process Types (E104-E107)
// References: Oksendal (2003) SDEs, Doob (1953) martingales,
//             Aguirre et al. POPL 2018
// ================================================================

fn is_valid_markov_chain(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyMarkovChain { return false }
    let ck: i64 = ty.epistemic_meta_id
    if ck < 0 { return false }
    if ck > 2 { return false }
    true
}

fn check_markov_chain_type(ty: TypeEntry) -> i64 with IO {
    // E104: Markov chain kind invalid
    if ty.kind != TypeKind::TyMarkovChain { return 104 }
    let ck: i64 = ty.epistemic_meta_id
    if ck < 0 { return 104 }
    if ck > 2 { return 104 }
    if ty.array_size == 0 { return 104 }
    0
}

fn is_valid_sde(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TySDE { return false }
    if ty.array_size == 0 { return false }
    let sk: i64 = ty.epistemic_meta_id
    if sk < 0 { return false }
    if sk > 3 { return false }
    true
}

fn check_sde_type(ty: TypeEntry) -> i64 with IO {
    // E105: SDE state_dim invalid or sde_kind out of range
    if ty.kind != TypeKind::TySDE { return 105 }
    if ty.array_size == 0 { return 105 }
    let sk: i64 = ty.epistemic_meta_id
    if sk < 0 { return 105 }
    if sk > 3 { return 105 }
    0
}

fn is_valid_martingale(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyMartingale { return false }
    let mk: i64 = ty.epistemic_meta_id
    if mk < 0 { return false }
    if mk > 2 { return false }
    true
}

fn check_martingale_type(ty: TypeEntry) -> i64 with IO {
    // E106: martingale kind invalid or Doob bound negative
    if ty.kind != TypeKind::TyMartingale { return 106 }
    let mk: i64 = ty.epistemic_meta_id
    if mk < 0 { return 106 }
    if mk > 2 { return 106 }
    0
}

fn is_valid_stationary_dist(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyStationaryDist { return false }
    let pk: i64 = ty.array_size
    if pk != 0 && pk != 1 { return false }
    true
}

fn check_stationary_dist_type(ty: TypeEntry) -> i64 with IO {
    // E107: process_kind not in {0, 1}
    if ty.kind != TypeKind::TyStationaryDist { return 107 }
    let pk: i64 = ty.array_size
    if pk != 0 && pk != 1 { return 107 }
    0
}

fn markov_to_distribution(mc_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE: TyMarkovChain -> TyDistribution (parametric, kind=-1)
    ty_distribution(mc_ty, -1, mc_ty.robustness_level_id, mc_ty.knowledge_epsilon, mc_ty.epistemic_meta_id)
}

fn sde_stationary_to_dist(sde_ty: TypeEntry, beta_milli: i64) -> TypeEntry with IO, Alloc {
    // MOONSHOT BRIDGE B->Sprint23P:
    // Ergodic Langevin SDE -> Gibbs/Boltzmann stationary distribution
    // pi(x) proportional to exp(-beta U(x)), where drift = -grad_U
    ty_distribution(sde_ty, -1, sde_ty.fn_sig_id, 1000.0, 0)
}

fn ergodic_to_robust(mc_ty: TypeEntry, proof_id: i64) -> TypeEntry with IO, Alloc {
    // BRIDGE B->Sprint7: ergodic Markov chain -> TyRobust (stability guarantee)
    ty_robust(mc_ty, proof_id, 0, -1)
}

// ================================================================
// Sprint 24 Track C: Complexity/Resource Types (E108-E109)
// References: Hoffmann & Hofmann POPL 2010, Hoffmann et al. POPL 2012
// ================================================================

fn is_valid_bigO(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyBigO { return false }
    if ty.array_size < -1 { return false }
    let rk: i64 = ty.epistemic_meta_id
    if rk < -1 { return false }
    if rk > 2 { return false }
    true
}

fn check_bigO_type(ty: TypeEntry) -> i64 with IO {
    // E108: degree < -1 or resource_kind out of range
    if ty.kind != TypeKind::TyBigO { return 108 }
    if ty.array_size < -1 { return 108 }
    let rk: i64 = ty.epistemic_meta_id
    if rk < -1 { return 108 }
    if rk > 2 { return 108 }
    0
}

fn is_valid_amortized(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyAmortized { return false }
    let pm: i64 = ty.epistemic_meta_id
    if pm < 0 { return false }
    if pm > 2 { return false }
    true
}

fn check_amortized_type(ty: TypeEntry) -> i64 with IO {
    // E109: amortized per_op_degree > worst_case_degree
    if ty.kind != TypeKind::TyAmortized { return 109 }
    let pm: i64 = ty.epistemic_meta_id
    if pm < 0 { return 109 }
    if pm > 2 { return 109 }
    if ty.robustness_level_id != -1 {
        if ty.array_size > ty.robustness_level_id { return 109 }
    }
    0
}

fn bigO_subsumes(outer: TypeEntry, inner_ty: TypeEntry) -> bool with IO {
    // O(n^k) subsumes O(n^j) iff k >= j
    if outer.array_size == -1 { return true }
    if inner_ty.array_size == -1 { return false }
    outer.array_size >= inner_ty.array_size
}

fn bigO_compose(f_ty: TypeEntry, g_ty: TypeEntry) -> TypeEntry with IO, Alloc, Mut {
    // O(n^a) composed with O(n^b): O(n^(a*b)), capped at degree 6
    let a: i64 = f_ty.array_size
    let b: i64 = g_ty.array_size
    var deg: i64 = 0
    if a == -1 || b == -1 {
        deg = -1
    } else {
        deg = a * b
        if deg > 6 { deg = 6 }
    }
    ty_bigO(f_ty, deg, -1, f_ty.knowledge_epsilon, f_ty.epistemic_meta_id, f_ty.algebra_kind)
}

fn matmul_complexity(left_mat: TypeEntry, right_mat: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE C<-Sprint23V: Matrix<T,m,k> x Matrix<T,k,n> -> BigO<T, degree=3>
    ty_bigO(left_mat, 3, -1, 1000.0, 0, 0)
}

fn jacobian_complexity(jac_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE C<-Track A: TyJacobian<f,n,m> -> BigO<T, degree=2>
    ty_bigO(jac_ty, 2, -1, jac_ty.knowledge_epsilon, 0, 0)
}

// ================================================================
// Sprint 24 Track D: Proof Certificate Types (E110-E113)
// References: Wadler (2015) "Propositions as Types",
//             Chlipala CPDT, Martin-Lof (1984)
// ================================================================

fn is_valid_proof(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyProof { return false }
    let pk: i64 = ty.array_size
    if pk < 0 { return false }
    if pk > 3 { return false }
    if ty.epistemic_meta_id < 0 { return false }
    true
}

fn check_proof_type(ty: TypeEntry) -> i64 with IO {
    // E110: proof_kind invalid or axiom_count negative
    if ty.kind != TypeKind::TyProof { return 110 }
    let pk: i64 = ty.array_size
    if pk < 0 { return 110 }
    if pk > 3 { return 110 }
    if ty.epistemic_meta_id < 0 { return 110 }
    0
}

fn check_proof_completeness(ty: TypeEntry) -> i64 with IO {
    // E110: proof has holes (fn_sig_id=-1) unless proof_kind=3 (witnessed)
    if ty.kind != TypeKind::TyProof { return 110 }
    if ty.fn_sig_id == -1 {
        if ty.array_size != 3 { return 110 }
    }
    0
}

fn is_valid_lemma(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyLemma { return false }
    if ty.epistemic_meta_id < 0 { return false }
    let st: i64 = ty.robustness_level_id
    if st < 0 { return false }
    if st > 2 { return false }
    true
}

fn check_lemma_type(ty: TypeEntry) -> i64 with IO {
    // E111: dependency_count negative or strength_tag invalid
    if ty.kind != TypeKind::TyLemma { return 111 }
    if ty.epistemic_meta_id < 0 { return 111 }
    let st: i64 = ty.robustness_level_id
    if st < 0 { return 111 }
    if st > 2 { return 111 }
    0
}

fn check_lemma_acyclic(lemma_ty: TypeEntry, dep_id: i64) -> i64 with IO {
    // E111: self-reference (circular dependency)
    if lemma_ty.array_size == dep_id { return 111 }
    0
}

fn is_valid_axiom(ty: TypeEntry) -> bool {
    if ty.kind != TypeKind::TyAxiom { return false }
    let ac: i64 = ty.epistemic_meta_id
    if ac < 0 { return false }
    if ac > 3 { return false }
    if ty.robustness_level_id < 0 { return false }
    true
}

fn check_axiom_type(ty: TypeEntry) -> i64 with IO {
    // E112: axiom_class not in [0,3]
    if ty.kind != TypeKind::TyAxiom { return 112 }
    let ac: i64 = ty.epistemic_meta_id
    if ac < 0 { return 112 }
    if ac > 3 { return 112 }
    if ty.robustness_level_id < 0 { return 112 }
    0
}

fn check_axiom_constructive(proof_ty: TypeEntry) -> i64 with IO {
    // E112: axiom used as inner of constructive proof (proof_kind=0)
    if proof_ty.kind != TypeKind::TyProof { return 0 }
    if proof_ty.array_size != 0 { return 0 }
    match proof_ty.inner {
        Some(inner) => {
            if (*inner).kind == TypeKind::TyAxiom { return 112 }
            0
        }
        None => 0
    }
}

fn check_proof_confidence(ty: TypeEntry, required_milli: f64) -> i64 with IO {
    // E113: weak proof certificate (confidence < required)
    if ty.kind != TypeKind::TyProof { return 113 }
    if ty.knowledge_epsilon >= 0.0 {
        if ty.knowledge_epsilon < required_milli { return 113 }
    }
    0
}

fn proof_to_robust(proof_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE D->Sprint7: TyProof<robust(T)> -> TyRobust<T>
    ty_robust(proof_ty, proof_ty.fn_sig_id, proof_ty.robustness_level_id, -1)
}

fn proof_to_validated(proof_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // BRIDGE D->Sprint8: Proof<P> -> Validated<T>
    ty_validated(proof_ty, proof_ty.knowledge_epsilon)
}

fn lemma_chain(l1: TypeEntry, l2: TypeEntry) -> TypeEntry with IO, Alloc {
    // (A->B) ^ (B->C) -> (A->C): modus ponens composition
    let new_dep: i64 = l1.epistemic_meta_id + l2.epistemic_meta_id + 1
    ty_lemma(l2, l2.array_size, l2.fn_sig_id, l2.knowledge_epsilon, new_dep, l2.robustness_level_id)
}

fn axiom_to_proof(ax_ty: TypeEntry) -> TypeEntry with IO, Alloc {
    // TyAxiom -> TyProof: probabilistic proof, no proof term, axiom_count=1
    ty_proof(ax_ty, 2, -1, ax_ty.knowledge_epsilon, 1, -1)
}

// ================================================================
// Sprint 24 Moonshot: SGD -> Langevin -> Gibbs -> Contest Bridge
// References: Welling & Teh (2011) SGLD, Roberts & Tweedie (1996)
// ================================================================

fn gradient_bridge_complete(diff_ty: TypeEntry, temp_milli: i64, beta_milli: i64, model_count: i64) -> TypeEntry with IO, Alloc {
    // Full chain: Differentiable -> Gradient -> SDE(Langevin) -> Distribution(Gibbs) -> Contest
    let gradient_ty: TypeEntry = ty_gradient(diff_ty, diff_ty.array_size, 1, diff_ty.fn_sig_id, 0.0 - 1.0, 1)
    let sde_ty: TypeEntry = langevin_from_gradient(gradient_ty, temp_milli)
    let dist_ty: TypeEntry = sde_stationary_to_dist(sde_ty, beta_milli)
    dist_to_contest(dist_ty, model_count)
}

// ================================================================
// FSNN Orbit Epistemic Classification (Horizon 5.1)
//
// When a Mandelbrot orbit is near the escape boundary
// (|z_n| ∈ [0.8R, R] where R = escape_radius), the classification
// "escaped" vs "bounded" is epistemically contested.
//
// Orbit result classification rules:
//   1. OrbitResult with |z_final| < 0.8*R     → bounded, uncontested
//   2. OrbitResult with |z_final| > R          → escaped, uncontested
//   3. OrbitResult with |z_final| ∈ [0.8R, R]  → Contest<OrbitResult>
//
// Propagation:
//   Contest<OrbitResult> → fsnn_extract_features → Contest<FSNNFeatures>
//   (boundary sensitivity contaminates downstream features)
//
// Zero-divisor proximity also introduces Contest when zd_proximity < 0.1:
//   Near zero-divisor ⇒ putative inverse is ill-conditioned
//   ⇒ Contest wrapping with PROVENANCE_KIND_COMPUTED
// ================================================================

const PROVENANCE_KIND_ORBIT_BOUNDARY: i64 = 6

// Classify orbit result epsilon based on distance to escape boundary.
// Returns epsilon in [0, 1]: 0 = confidently classified, 1 = on boundary.
// Linear interpolation within the boundary band [0.8R, R].
fn orbit_boundary_epsilon(terminal_norm: f64, escape_radius: f64) -> f64 {
    let lower = 0.8 * escape_radius
    let upper = escape_radius
    if terminal_norm < lower {
        // Confidently bounded
        0.0
    } else if terminal_norm > upper {
        // Confidently escaped
        0.0
    } else {
        // In boundary band: epsilon scales linearly from 0 at edges to 1 at midpoint
        let mid = 0.5 * (lower + upper)
        let half_width = 0.5 * (upper - lower)
        if half_width < 1e-30 { return 1.0 }
        let dist_from_mid = terminal_norm - mid
        let abs_dist = if dist_from_mid < 0.0 { 0.0 - dist_from_mid } else { dist_from_mid }
        1.0 - abs_dist / half_width
    }
}

// Classify zero-divisor proximity epsilon.
// When the orbit passes near the zero-divisor variety Z,
// the sedenionic inverse becomes ill-conditioned and the
// Jacobian norm may spike. This introduces epistemic uncertainty.
fn zero_divisor_epsilon(zd_proximity: f64) -> f64 {
    if zd_proximity > 0.1 {
        0.0
    } else if zd_proximity < 1e-10 {
        1.0
    } else {
        // Linear interpolation: closer to Z → higher epsilon
        1.0 - zd_proximity / 0.1
    }
}

// Combine orbit boundary and zero-divisor epsilon into a single
// epistemic uncertainty for the FSNN feature vector.
// Uses quadrature combination: epsilon = sqrt(e1^2 + e2^2), clamped to [0,1].
fn orbit_combined_epsilon(boundary_eps: f64, zd_eps: f64) -> f64 {
    let combined_sq = boundary_eps * boundary_eps + zd_eps * zd_eps
    if combined_sq <= 0.0 { return 0.0 }
    // Newton-Raphson sqrt (6 iterations, sufficient for epsilon precision)
    var y = combined_sq
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    y = 0.5 * (y + combined_sq / y)
    if y > 1.0 { 1.0 } else { y }
}

// Check whether an orbit result should be wrapped in Contest<T>.
// Returns 1 if the result is epistemically contested (near boundary or near Z),
// 0 if uncontested.
fn orbit_is_contested(terminal_norm: f64, escape_radius: f64, zd_proximity: f64) -> i64 {
    let eps = orbit_combined_epsilon(
        orbit_boundary_epsilon(terminal_norm, escape_radius),
        zero_divisor_epsilon(zd_proximity)
    )
    if eps > 0.01 { 1 } else { 0 }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/hyper.sio  (260 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted/check/hyper.sio
// Production machine-level hypercomplex type checker predicates
//
// Implements type checking rules for Hyper<Algebra, T> types:
//   - Binary operation compatibility (Quaternion * Quaternion -> Quaternion)
//   - Effect requirements (Div required for types with zero divisors)
//   - Division rejection for non-division algebras (error E032)
//   - Cayley-Dickson tower embedding (R -> C -> H -> O -> S)
//   - Clifford(p,q) parametric constraints
//
// STATUS: Compilable Sounio. Origin: Grok 4.2 spec, manually translated.
//   Uses: Checker.report_error_at(span, code, a, b, c) for diagnostics
//   Uses: name_matches_strN() from compat.sio for name resolution
//   Uses: ty_hyper(), ty_clifford() from types.sio for construction
//   Pattern follows: self-hosted/check/epistemic.sio
//
// Error codes:
//   E030: binary operation on incompatible Hyper algebras
//   E031: missing Div effect for type with zero divisors
//   E032: division on non-division algebra
//   E033: Clifford embedding mismatch (different signatures)
//   E034: Cayley-Dickson coercion direction error (no narrowing)

// --- Algebra kind tag constants (must match ir/algebra.sio) ---
let ALG_REAL: i64 = 0
let ALG_COMPLEX: i64 = 1
let ALG_QUATERNION: i64 = 2
let ALG_OCTONION: i64 = 3
let ALG_SEDENION: i64 = 4
let ALG_CLIFFORD: i64 = 5

// --- Type predicates ---

fn is_hyper_type(ty: TypeEntry) -> bool {
    ty.kind == TypeKind::TyHyper
}

fn hyper_algebra(ty: TypeEntry) -> i64 with Panic {
    if ty.kind != TypeKind::TyHyper { return 0 - 1 }
    return ty.algebra_kind
}

fn hyper_inner(ty: TypeEntry) -> TypeEntry with Panic, Alloc {
    match ty.inner {
        Some(inner) => *inner
        None => ty_error()
    }
}

// --- Division algebra check (Hurwitz) ---

fn is_division_algebra(alg: i64) -> bool {
    alg <= 3  // R, C, H, O
}

// --- Associativity check ---

fn is_associative(alg: i64) -> bool {
    if alg == 0 { return true }  // Real
    if alg == 1 { return true }  // Complex
    if alg == 2 { return true }  // Quaternion
    if alg == 5 { return true }  // Clifford (always)
    return false
}

// --- Zero divisor check ---

fn has_zero_divisors(alg: i64) -> bool {
    alg >= 4  // Sedenion + Clifford(p,q) for p+q >= 2
}

// --- Binary operation result type ---
// Returns the algebra tag for the result of a binary op, or -1 if incompatible.

fn hyper_binary_result(left_alg: i64, right_alg: i64) -> i64 {
    // Same algebra: result is same algebra
    if left_alg == right_alg { return left_alg }
    // Cayley-Dickson tower: R < C < H < O < S — widen to larger
    if left_alg <= 4 && right_alg <= 4 {
        if left_alg > right_alg { return left_alg }
        return right_alg
    }
    // Clifford + Clifford with different signatures: incompatible
    // Clifford + Cayley-Dickson: incompatible
    return 0 - 1
}

// --- Check binary expression involving Hyper types ---

fn check_hyper_binary(c: Checker, span: Span, op: BinaryOp, left: TypeEntry, right: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let left_alg = hyper_algebra(left)
    let right_alg = hyper_algebra(right)
    let result_alg = hyper_binary_result(left_alg, right_alg)
    var checker = c

    if result_alg < 0 {
        // E030: incompatible algebras
        checker = checker.report_error_at(span, 30, 0, 0, 0)
        return (checker, ty_error())
    }

    // Check division: only allowed for division algebras
    if op == BinaryOp::OpDiv && !is_division_algebra(result_alg) {
        // E032: division on non-division algebra
        checker = checker.report_error_at(span, 32, 0, 0, 0)
        return (checker, ty_error())
    }

    // Check Div effect requirement for types with zero divisors
    if has_zero_divisors(result_alg) {
        // E031 if Div effect not in scope (requires checker effect tracking)
        // For now: warn only — full effect checking comes via effects.sio
    }

    // Check NonAssoc effect requirement for non-associative algebras.
    // First check the algebra registry (Phase 1: first-class algebra declarations).
    // If no algebra is registered, fall back to hardcoded is_associative().
    var mul_needs_nonassoc = false
    if op == BinaryOp::OpMul {
        // Query algebra registry by tag
        var found_algebra = false
        var ai: i64 = 0
        while ai < checker.algebras.count {
            let info = checker.algebras.entries[ai]
            if info.is_valid && info.algebra_tag == result_alg {
                found_algebra = true
                if info.mul_alternative && !info.mul_associative {
                    mul_needs_nonassoc = true
                }
            }
            ai = ai + 1
        }
        // Fallback: hardcoded predicate for unregistered algebras
        if !found_algebra && !is_associative(result_alg) {
            mul_needs_nonassoc = true
        }
    }
    if mul_needs_nonassoc {
        let non_assoc_id: i64 = 14
        if !has_effect_id(checker.current_effects, checker.current_effect_count, non_assoc_id) {
            checker = checker.report_error_at(span, 35, result_alg, 0, 0)
        }
    }

    let inner = hyper_inner(left)
    (checker, ty_hyper(result_alg, inner))
}

// --- Cayley-Dickson tower coercion ---
// Can widen: R -> C -> H -> O -> S (embedding)
// Cannot narrow: H -> C is NOT implicit

fn can_coerce_hyper(from_alg: i64, to_alg: i64) -> bool {
    // Same: always ok
    if from_alg == to_alg { return true }
    // Cayley-Dickson widening: from < to in tower ordering
    if from_alg <= 4 && to_alg <= 4 && from_alg < to_alg { return true }
    // Clifford: no implicit coercion between different signatures
    return false
}

// --- Resolve algebra name to tag ---
// Uses byte-comparison helpers from compat.sio

fn resolve_algebra_name(n: Name) -> i64 with Panic, Div {
    // "Real" = 4 chars: 82, 101, 97, 108
    if name_matches_str4(n, 82, 101, 97, 108) { return 0 }
    // "Complex" = 7 chars: 67, 111, 109, 112, 108, 101, 120
    if name_matches_str7(n, 67, 111, 109, 112, 108, 101, 120) { return 1 }
    // "Quaternion" = 10 chars
    if name_matches_str10(n, 81, 117, 97, 116, 101, 114, 110, 105, 111, 110) { return 2 }
    // "Octonion" = 8 chars: 79, 99, 116, 111, 110, 105, 111, 110
    if name_matches_str8(n, 79, 99, 116, 111, 110, 105, 111, 110) { return 3 }
    // "Sedenion" = 8 chars: 83, 101, 100, 101, 110, 105, 111, 110
    if name_matches_str8(n, 83, 101, 100, 101, 110, 105, 111, 110) { return 4 }
    // "Clifford" = 8 chars: 67, 108, 105, 102, 102, 111, 114, 100
    if name_matches_str8(n, 67, 108, 105, 102, 102, 111, 114, 100) { return 5 }
    return 0 - 1
}

// --- Type constructor ---

// ty_hyper constructor is defined in types.sio — this re-export is for
// direct use within hyper.sio predicates.
// See: ty_hyper(alg, elem) and ty_clifford(p, q, elem) in types.sio

// --- Field access for Hyper types ---
// Quaternion: .w, .x, .y, .z (or .real, .i, .j, .k)
// Complex: .real, .imag
// Octonion: .e0 through .e7

fn check_hyper_field_access(c: Checker, span: Span, ty: TypeEntry, field: Name) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let alg = hyper_algebra(ty)
    let inner = hyper_inner(ty)
    var checker = c

    // Complex: .real, .imag
    if alg == 1 {
        if name_matches_str4(field, 114, 101, 97, 108) { return (checker, inner) }  // "real"
        if name_matches_str4(field, 105, 109, 97, 103) { return (checker, inner) }  // "imag"
    }

    // Quaternion: .w, .x, .y, .z
    if alg == 2 {
        if name_matches_str1(field, 119) { return (checker, inner) }  // "w"
        if name_matches_str1(field, 120) { return (checker, inner) }  // "x"
        if name_matches_str1(field, 121) { return (checker, inner) }  // "y"
        if name_matches_str1(field, 122) { return (checker, inner) }  // "z"
    }

    // Octonion/Sedenion/Clifford: accept any component field, return inner
    if alg >= 3 {
        return (checker, inner)
    }

    checker = checker.report_error_at(span, 12, 0, 0, 0)  // E012: unknown field
    (checker, ty_error())
}

// --- Method calls for Hyper types ---
// .conjugate(), .norm(), .inverse() (if division algebra)

fn check_hyper_method_call(c: Checker, span: Span, ty: TypeEntry, method: Name) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
    let alg = hyper_algebra(ty)
    var checker = c

    // .conjugate() -> same Hyper type
    if name_matches_str9(method, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
        return (checker, ty)
    }

    // .norm() -> inner element type (scalar)
    if name_matches_str4(method, 110, 111, 114, 109) {
        return (checker, hyper_inner(ty))
    }

    // .inverse() -> same Hyper type (only for division algebras)
    if name_matches_str7(method, 105, 110, 118, 101, 114, 115, 101) {
        if !is_division_algebra(alg) {
            checker = checker.report_error_at(span, 32, 0, 0, 0)  // E032
            return (checker, ty_error())
        }
        return (checker, ty)
    }

    checker = checker.report_error_at(span, 11, 0, 0, 0)  // E011: method not found
    (checker, ty_error())
}

// --- Print helpers ---

fn print_algebra_name(alg: i64) with IO {
    if alg == 0 { print("Real") }
    else if alg == 1 { print("Complex") }
    else if alg == 2 { print("Quaternion") }
    else if alg == 3 { print("Octonion") }
    else if alg == 4 { print("Sedenion") }
    else if alg == 5 { print("Clifford") }
    else { print("Unknown") }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/effects.sio  (285 lines)
// ════════════════════════════════════════════════════════════════

// Effect processing for type checker
//
// Converts parsed EffectList from AST to effect ID arrays in FnSig.
// Effect IDs: 0=IO, 1=Mut, 2=Alloc, 3=Panic, 4=Div, 5=GPU, 6=Async,
// 7=Prob, 8=Epistemic, 9=Causal, 10=Network, 11=Sensor, 12=Render,
// 13=Observe, 14=NonAssoc, 15=Audit, 16=Hypothesis, 17=MultiTest

// ============================================================
// Effect name to ID mapping
// ============================================================

fn effect_name_to_id(name_buf: [i8; 64], name_len: i64) -> i64 with Mut, Panic, Div {
    // IO
    if name_len == 2 {
        if name_buf[0] == 73 as i8 && name_buf[1] == 79 as i8 {  // "IO"
            return 0
        }
    }

    // Mut
    if name_len == 3 {
        if name_buf[0] == 77 as i8 && name_buf[1] == 117 as i8 && name_buf[2] == 116 as i8 {  // "Mut"
            return 1
        }
        // Div
        if name_buf[0] == 68 as i8 && name_buf[1] == 105 as i8 && name_buf[2] == 118 as i8 {  // "Div"
            return 4
        }
        // GPU
        if name_buf[0] == 71 as i8 && name_buf[1] == 80 as i8 && name_buf[2] == 85 as i8 {  // "GPU"
            return 5
        }
    }

    // Alloc
    if name_len == 5 {
        if name_buf[0] == 65 as i8 && name_buf[1] == 108 as i8 && name_buf[2] == 108 as i8
           && name_buf[3] == 111 as i8 && name_buf[4] == 99 as i8 {  // "Alloc"
            return 2
        }
        // Async
        if name_buf[0] == 65 as i8 && name_buf[1] == 115 as i8 && name_buf[2] == 121 as i8
           && name_buf[3] == 110 as i8 && name_buf[4] == 99 as i8 {  // "Async"
            return 6
        }
        // Panic
        if name_buf[0] == 80 as i8 && name_buf[1] == 97 as i8 && name_buf[2] == 110 as i8
           && name_buf[3] == 105 as i8 && name_buf[4] == 99 as i8 {  // "Panic"
            return 3
        }
    }

    // Prob
    if name_len == 4 {
        if name_buf[0] == 80 as i8 && name_buf[1] == 114 as i8 && name_buf[2] == 111 as i8
           && name_buf[3] == 98 as i8 {  // "Prob"
            return 7
        }
    }

    // Epistemic (9 chars)
    if name_len == 9 {
        if name_buf[0] == 69 as i8 && name_buf[1] == 112 as i8 && name_buf[2] == 105 as i8
           && name_buf[3] == 115 as i8 && name_buf[4] == 116 as i8 && name_buf[5] == 101 as i8
           && name_buf[6] == 109 as i8 && name_buf[7] == 105 as i8 && name_buf[8] == 99 as i8 {
            return 8
        }
    }

    // Causal (6 chars)
    if name_len == 6 {
        if name_buf[0] == 67 as i8 && name_buf[1] == 97 as i8 && name_buf[2] == 117 as i8
           && name_buf[3] == 115 as i8 && name_buf[4] == 97 as i8 && name_buf[5] == 108 as i8 {
            return 9
        }
    }

    // Network (7 chars)
    if name_len == 7 {
        if name_buf[0] == 78 as i8 && name_buf[1] == 101 as i8 && name_buf[2] == 116 as i8
           && name_buf[3] == 119 as i8 && name_buf[4] == 111 as i8 && name_buf[5] == 114 as i8
           && name_buf[6] == 107 as i8 {
            return 10
        }
    }

    // Sensor (6 chars)
    if name_len == 6 {
        if name_buf[0] == 83 as i8 && name_buf[1] == 101 as i8 && name_buf[2] == 110 as i8
           && name_buf[3] == 115 as i8 && name_buf[4] == 111 as i8 && name_buf[5] == 114 as i8 {
            return 11
        }
    }

    // Render (6 chars)
    if name_len == 6 {
        if name_buf[0] == 82 as i8 && name_buf[1] == 101 as i8 && name_buf[2] == 110 as i8
           && name_buf[3] == 100 as i8 && name_buf[4] == 101 as i8 && name_buf[5] == 114 as i8 {
            return 12
        }
    }

    // Observe (7 chars) — von Foerster's observer-inclusion effect
    // Any function that performs observation (reads system state through
    // an observer with measurable cost) must declare this effect.
    if name_len == 7 {
        if name_buf[0] == 79 as i8 && name_buf[1] == 98 as i8 && name_buf[2] == 115 as i8
           && name_buf[3] == 101 as i8 && name_buf[4] == 114 as i8 && name_buf[5] == 118 as i8
           && name_buf[6] == 101 as i8 {  // "Observe"
            return 13
        }
    }

    // NonAssoc (8 chars) — non-associative algebraic operations
    // Any function that multiplies elements of a non-associative algebra
    // (octonions, sedenions, or higher Cayley-Dickson) must declare this.
    // The compiler uses this to block unsafe reassociation optimizations.
    if name_len == 8 {
        if name_buf[0] == 78 as i8 && name_buf[1] == 111 as i8 && name_buf[2] == 110 as i8
           && name_buf[3] == 65 as i8 && name_buf[4] == 115 as i8 && name_buf[5] == 115 as i8
           && name_buf[6] == 111 as i8 && name_buf[7] == 99 as i8 {  // "NonAssoc"
            return 14
        }
    }

    // Audit (5 chars) — runtime provenance and regulatory trace logging
    if name_len == 5 {
        if name_buf[0] == 65 as i8 && name_buf[1] == 117 as i8 && name_buf[2] == 100 as i8
           && name_buf[3] == 105 as i8 && name_buf[4] == 116 as i8 {  // "Audit"
            return 15
        }
    }

    // Hypothesis (10 chars) — statistical tests must target registered study outcomes
    if name_len == 10 {
        if name_buf[0] == 72 as i8 && name_buf[1] == 121 as i8 && name_buf[2] == 112 as i8
           && name_buf[3] == 111 as i8 && name_buf[4] == 116 as i8 && name_buf[5] == 104 as i8
           && name_buf[6] == 101 as i8 && name_buf[7] == 115 as i8 && name_buf[8] == 105 as i8
           && name_buf[9] == 115 as i8 {
            return 16
        }
    }

    // MultiTest (9 chars) — multiple statistical tests in one function
    // require an explicit correction call before the function exits.
    if name_len == 9 {
        if name_buf[0] == 77 as i8 && name_buf[1] == 117 as i8 && name_buf[2] == 108 as i8
           && name_buf[3] == 116 as i8 && name_buf[4] == 105 as i8 && name_buf[5] == 84 as i8
           && name_buf[6] == 101 as i8 && name_buf[7] == 115 as i8 && name_buf[8] == 116 as i8 {
            return 17
        }
    }

    // Unknown effect
    -1
}

// ============================================================
// Extract effects from EffectList
// ============================================================

fn collect_effects_from_list(list: EffectList, effects: [i64; 8], count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var effs = effects
    var n = count

    // Convert this effect to ID
    let eff_id = effect_name_to_id(list.head.name_buf, list.head.name_len)

    // Add if valid and not duplicate
    if eff_id >= 0 && n < 8 {
        var already_present = false
        var i: i64 = 0
        while i < n {
            if effs[i as usize] == eff_id {
                already_present = true
            }
            i = i + 1
        }

        if !already_present {
            effs[n as usize] = eff_id
            n = n + 1
        }
    }

    // Process tail
    match list.tail {
        None => (effs, n)
        Some(next) => collect_effects_from_list(*next, effs, n)
    }
}

fn extract_effects(opt: Option<Box<EffectList>>) -> ([i64; 8], i64) with Mut, Panic, Div {
    match opt {
        None => ([0; 8], 0)
        Some(list) => collect_effects_from_list(*list, [0; 8], 0)
    }
}

// ============================================================
// Effect checking helpers (for future use)
// ============================================================

// Check if effect ID is present in array
fn has_effect_id(effects: [i64; 8], count: i64, target_id: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < count {
        if effects[i as usize] == target_id {
            return true
        }
        i = i + 1
    }
    false
}

// Check if required effects are subset of declared effects
fn effects_subset(required: [i64; 8], req_count: i64, declared: [i64; 8], decl_count: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < req_count {
        let req_id = required[i as usize]
        if !has_effect_id(declared, decl_count, req_id) {
            return false
        }
        i = i + 1
    }
    true
}

// Print effect name by ID (for diagnostics)
fn print_effect_name(id: i64) with IO, Mut, Panic, Div {
    if id == 0 { print("IO") }
    else if id == 1 { print("Mut") }
    else if id == 2 { print("Alloc") }
    else if id == 3 { print("Panic") }
    else if id == 4 { print("Div") }
    else if id == 5 { print("GPU") }
    else if id == 6 { print("Async") }
    else if id == 7 { print("Prob") }
    else if id == 8 { print("Epistemic") }
    else if id == 9 { print("Causal") }
    else if id == 10 { print("Network") }
    else if id == 11 { print("Sensor") }
    else if id == 12 { print("Render") }
    else if id == 13 { print("Observe") }
    else if id == 14 { print("NonAssoc") }
    else if id == 15 { print("Audit") }
    else if id == 16 { print("Hypothesis") }
    else if id == 17 { print("MultiTest") }
    else { print("Effect#"); print_int(id) }
}

// Find missing effects: returns effects in required that are not in declared
fn find_missing_effects(required: [i64; 8], req_count: i64, declared: [i64; 8], decl_count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var missing: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    var missing_count: i64 = 0
    var i: i64 = 0
    while i < req_count {
        let req_id = required[i as usize]
        if !has_effect_id(declared, decl_count, req_id) && missing_count < 8 {
            missing[missing_count as usize] = req_id
            missing_count = missing_count + 1
        }
        i = i + 1
    }
    (missing, missing_count)
}

// Merge two effect sets (union)
fn merge_effects(a: [i64; 8], a_count: i64, b: [i64; 8], b_count: i64) -> ([i64; 8], i64) with Mut, Panic, Div {
    var result = a
    var result_count = a_count

    // Add effects from b that aren't in a
    var i: i64 = 0
    while i < b_count && result_count < 8 {
        let b_id = b[i as usize]
        if !has_effect_id(result, result_count, b_id) {
            result[result_count as usize] = b_id
            result_count = result_count + 1
        }
        i = i + 1
    }

    (result, result_count)
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/refinement.sio  (673 lines)
// ════════════════════════════════════════════════════════════════

// Refinement types — predicate representation + SMT-lite checks
//
// Predicate op tags:
// 0=None, 1=Gt, 2=GtEq, 3=Lt, 4=LtEq, 5=Eq, 6=NotEq, 7=And, 8=Or

fn refinement_op_none() -> i64 { 0 }
fn refinement_op_gt() -> i64 { 1 }
fn refinement_op_gt_eq() -> i64 { 2 }
fn refinement_op_lt() -> i64 { 3 }
fn refinement_op_lt_eq() -> i64 { 4 }
fn refinement_op_eq() -> i64 { 5 }
fn refinement_op_neq() -> i64 { 6 }
fn refinement_op_and() -> i64 { 7 }
fn refinement_op_or() -> i64 { 8 }

struct RefinementPred {
    op: i64,
    var_name: Name,
    rhs_int: i64,
    rhs_float: f64,
    is_float: bool,
    left: Option<Box<RefinementPred>>,
    right: Option<Box<RefinementPred>>,
}

struct RefinementType {
    base_type: TypeEntry,
    var_name: Name,
    predicate: RefinementPred,
}

struct RefinementTable {
    entries: [RefinementType; 64],
    names: [Name; 64],
    count: i64,
}

fn empty_refinement_pred() -> RefinementPred {
    RefinementPred {
        op: refinement_op_none(),
        var_name: Name { buf: [0; 128], len: 0 },
        rhs_int: 0,
        rhs_float: 0.0,
        is_float: false,
        left: None,
        right: None,
    }
}

fn empty_refinement_type() -> RefinementType {
    RefinementType {
        base_type: ty_error(),
        var_name: Name { buf: [0; 128], len: 0 },
        predicate: empty_refinement_pred(),
    }
}

fn refinement_table_new() -> RefinementTable {
    RefinementTable {
        entries: [empty_refinement_type(); 64],
        names: [Name { buf: [0; 128], len: 0 }; 64],
        count: 0,
    }
}

fn refinement_table_find(t: RefinementTable, name: Name) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < t.count {
        if name_eq(t.names[i as usize], name) {
            return i
        }
        i = i + 1
    }
    -1
}

fn refinement_table_add(t: RefinementTable, name: Name, rt: RefinementType) -> RefinementTable with Mut, Panic, Div {
    var out = t
    let idx = refinement_table_find(out, name)
    if idx >= 0 {
        out.entries[idx as usize] = rt
        out.names[idx as usize] = name
        return out
    }
    if out.count < 64 {
        out.entries[out.count as usize] = rt
        out.names[out.count as usize] = name
        out.count = out.count + 1
    }
    out
}

fn make_refinement_synth_name(idx: i64) -> Name with Mut, Panic {
    var n = Name { buf: [0; 128], len: 0 }
    // Write "__ref" prefix
    n.buf[0] = 95   // '_'
    n.buf[1] = 95   // '_'
    n.buf[2] = 114  // 'r'
    n.buf[3] = 101  // 'e'
    n.buf[4] = 102  // 'f'
    if idx < 10 {
        n.buf[5] = (48 + idx) as i8   // '0'..'9'
        n.len = 6
    } else {
        let tens = idx / 10
        let ones = idx % 10
        n.buf[5] = (48 + tens) as i8
        n.buf[6] = (48 + ones) as i8
        n.len = 7
    }
    n
}

fn pred_make_int(op: i64, var_name: Name, val: i64) -> RefinementPred {
    RefinementPred {
        op: op,
        var_name: var_name,
        rhs_int: val,
        rhs_float: val as f64,
        is_float: false,
        left: None,
        right: None,
    }
}

fn pred_make_float(op: i64, var_name: Name, val: f64) -> RefinementPred {
    RefinementPred {
        op: op,
        var_name: var_name,
        rhs_int: val as i64,
        rhs_float: val,
        is_float: true,
        left: None,
        right: None,
    }
}

fn pred_make_compound(op: i64, left: RefinementPred, right: RefinementPred) -> RefinementPred with Alloc {
    RefinementPred {
        op: op,
        var_name: left.var_name,
        rhs_int: 0,
        rhs_float: 0.0,
        is_float: false,
        left: Some(Box::new(left)),
        right: Some(Box::new(right)),
    }
}

fn pred_gt(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_gt(), var_name, val)
}

fn pred_gt_eq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_gt_eq(), var_name, val)
}

fn pred_lt(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_lt(), var_name, val)
}

fn pred_lt_eq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_lt_eq(), var_name, val)
}

fn pred_eq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_eq(), var_name, val)
}

fn pred_neq(var_name: Name, val: i64) -> RefinementPred {
    pred_make_int(refinement_op_neq(), var_name, val)
}

fn pred_gt_f(var_name: Name, val: f64) -> RefinementPred {
    pred_make_float(refinement_op_gt(), var_name, val)
}

fn pred_and(left: RefinementPred, right: RefinementPred) -> RefinementPred with Alloc {
    pred_make_compound(refinement_op_and(), left, right)
}

fn pred_or(left: RefinementPred, right: RefinementPred) -> RefinementPred with Alloc {
    pred_make_compound(refinement_op_or(), left, right)
}

fn pred_check_cmp_int(op: i64, lhs: i64, rhs: i64) -> bool {
    if op == refinement_op_gt() {
        lhs > rhs
    } else if op == refinement_op_gt_eq() {
        lhs >= rhs
    } else if op == refinement_op_lt() {
        lhs < rhs
    } else if op == refinement_op_lt_eq() {
        lhs <= rhs
    } else if op == refinement_op_eq() {
        lhs == rhs
    } else if op == refinement_op_neq() {
        lhs != rhs
    } else {
        false
    }
}

fn pred_check_cmp_float(op: i64, lhs: f64, rhs: f64) -> bool {
    if op == refinement_op_gt() {
        lhs > rhs
    } else if op == refinement_op_gt_eq() {
        lhs >= rhs
    } else if op == refinement_op_lt() {
        lhs < rhs
    } else if op == refinement_op_lt_eq() {
        lhs <= rhs
    } else if op == refinement_op_eq() {
        lhs == rhs
    } else if op == refinement_op_neq() {
        lhs != rhs
    } else {
        false
    }
}

fn pred_check_int(pred: RefinementPred, val: i64) -> bool with Mut, Panic, Div {
    if pred.op == refinement_op_and() {
        let left_ok = match pred.left {
            Some(l) => pred_check_int(*l, val)
            None => false
        }
        if !left_ok { return false }
        let right_ok = match pred.right {
            Some(r) => pred_check_int(*r, val)
            None => false
        }
        left_ok && right_ok
    } else if pred.op == refinement_op_or() {
        let left_ok = match pred.left {
            Some(l) => pred_check_int(*l, val)
            None => false
        }
        if left_ok { return true }
        match pred.right {
            Some(r) => pred_check_int(*r, val)
            None => false
        }
    } else if pred.is_float {
        pred_check_cmp_float(pred.op, val as f64, pred.rhs_float)
    } else {
        pred_check_cmp_int(pred.op, val, pred.rhs_int)
    }
}

fn pred_check_float(pred: RefinementPred, val: f64) -> bool with Mut, Panic, Div {
    if pred.op == refinement_op_and() {
        let left_ok = match pred.left {
            Some(l) => pred_check_float(*l, val)
            None => false
        }
        if !left_ok { return false }
        let right_ok = match pred.right {
            Some(r) => pred_check_float(*r, val)
            None => false
        }
        left_ok && right_ok
    } else if pred.op == refinement_op_or() {
        let left_ok = match pred.left {
            Some(l) => pred_check_float(*l, val)
            None => false
        }
        if left_ok { return true }
        match pred.right {
            Some(r) => pred_check_float(*r, val)
            None => false
        }
    } else if pred.is_float {
        pred_check_cmp_float(pred.op, val, pred.rhs_float)
    } else {
        pred_check_cmp_float(pred.op, val, pred.rhs_int as f64)
    }
}

fn pred_is_atomic(pred: RefinementPred) -> bool {
    pred.op >= refinement_op_gt() && pred.op <= refinement_op_neq()
}

fn pred_equals(a: RefinementPred, b: RefinementPred) -> bool with Mut, Panic, Div {
    if a.op != b.op { return false }
    if !name_eq(a.var_name, b.var_name) { return false }
    if a.is_float != b.is_float { return false }
    if a.is_float {
        if a.rhs_float != b.rhs_float { return false }
    } else {
        if a.rhs_int != b.rhs_int { return false }
    }
    if a.op == refinement_op_and() || a.op == refinement_op_or() {
        let left_eq = match a.left {
            Some(la) => {
                match b.left {
                    Some(lb) => pred_equals(*la, *lb)
                    None => false
                }
            }
            None => false
        }
        if !left_eq { return false }
        match a.right {
            Some(ra) => {
                match b.right {
                    Some(rb) => pred_equals(*ra, *rb)
                    None => false
                }
            }
            None => false
        }
    } else {
        true
    }
}

fn pred_implies_atomic_int(a: RefinementPred, b: RefinementPred) -> bool {
    let av = a.rhs_int
    let bv = b.rhs_int

    if a.op == refinement_op_gt() {
        if b.op == refinement_op_gt() { return av >= bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        if b.op == refinement_op_neq() { return av >= bv }
        return false
    }
    if a.op == refinement_op_gt_eq() {
        if b.op == refinement_op_gt() { return av > bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        if b.op == refinement_op_neq() { return av > bv || av < bv }
        return false
    }
    if a.op == refinement_op_lt() {
        if b.op == refinement_op_lt() { return av <= bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        if b.op == refinement_op_neq() { return av <= bv }
        return false
    }
    if a.op == refinement_op_lt_eq() {
        if b.op == refinement_op_lt() { return av < bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        if b.op == refinement_op_neq() { return av < bv || av > bv }
        return false
    }
    if a.op == refinement_op_eq() {
        if b.op == refinement_op_eq() { return av == bv }
        if b.op == refinement_op_neq() { return av != bv }
        return pred_check_cmp_int(b.op, av, bv)
    }
    if a.op == refinement_op_neq() {
        if b.op == refinement_op_neq() { return av == bv }
        return false
    }
    false
}

fn pred_implies_atomic_float(a: RefinementPred, b: RefinementPred) -> bool {
    let av = if a.is_float { a.rhs_float } else { a.rhs_int as f64 }
    let bv = if b.is_float { b.rhs_float } else { b.rhs_int as f64 }

    if a.op == refinement_op_gt() {
        if b.op == refinement_op_gt() { return av >= bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        return false
    }
    if a.op == refinement_op_gt_eq() {
        if b.op == refinement_op_gt() { return av > bv }
        if b.op == refinement_op_gt_eq() { return av >= bv }
        return false
    }
    if a.op == refinement_op_lt() {
        if b.op == refinement_op_lt() { return av <= bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        return false
    }
    if a.op == refinement_op_lt_eq() {
        if b.op == refinement_op_lt() { return av < bv }
        if b.op == refinement_op_lt_eq() { return av <= bv }
        return false
    }
    if a.op == refinement_op_eq() {
        if b.op == refinement_op_eq() { return av == bv }
        return pred_check_cmp_float(b.op, av, bv)
    }
    if a.op == refinement_op_neq() {
        if b.op == refinement_op_neq() { return av == bv }
        return false
    }
    false
}

fn pred_implies(a: RefinementPred, b: RefinementPred) -> bool with Mut, Panic, Div {
    if pred_equals(a, b) { return true }

    // A implies (B1 or B2) iff A implies B1 or A implies B2
    if b.op == refinement_op_or() {
        let left_ok = match b.left {
            Some(bl) => pred_implies(a, *bl)
            None => false
        }
        if left_ok { return true }
        return match b.right {
            Some(br) => pred_implies(a, *br)
            None => false
        }
    }

    // A implies (B1 and B2) iff A implies both B1 and B2
    if b.op == refinement_op_and() {
        let left_ok = match b.left {
            Some(bl) => pred_implies(a, *bl)
            None => false
        }
        if !left_ok { return false }
        return match b.right {
            Some(br) => pred_implies(a, *br)
            None => false
        }
    }

    // (A1 and A2) implies B if either conjunct alone implies B (safe under-approx)
    if a.op == refinement_op_and() {
        let left_ok = match a.left {
            Some(al) => pred_implies(*al, b)
            None => false
        }
        if left_ok { return true }
        return match a.right {
            Some(ar) => pred_implies(*ar, b)
            None => false
        }
    }

    // (A1 or A2) implies B only if both imply B
    if a.op == refinement_op_or() {
        let left_ok = match a.left {
            Some(al) => pred_implies(*al, b)
            None => false
        }
        if !left_ok { return false }
        return match a.right {
            Some(ar) => pred_implies(*ar, b)
            None => false
        }
    }

    if !pred_is_atomic(a) || !pred_is_atomic(b) { return false }
    if !name_eq(a.var_name, b.var_name) { return false }

    if a.is_float || b.is_float {
        pred_implies_atomic_float(a, b)
    } else {
        if pred_implies_atomic_int(a, b) {
            true
        } else {
            pred_interval_implies(a, b)
        }
    }
}

fn print_pred_op(op: i64) with IO {
    if op == refinement_op_gt() { print(">") }
    else if op == refinement_op_gt_eq() { print(">=") }
    else if op == refinement_op_lt() { print("<") }
    else if op == refinement_op_lt_eq() { print("<=") }
    else if op == refinement_op_eq() { print("==") }
    else if op == refinement_op_neq() { print("!=") }
    else if op == refinement_op_and() { print("&&") }
    else if op == refinement_op_or() { print("||") }
    else { print("?") }
}

fn print_pred_name(n: Name) with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < n.len {
        print_char(n.buf[i as usize] as i64)
        i = i + 1
    }
}

fn print_pred(pred: RefinementPred) with IO, Mut, Panic, Div {
    if pred.op == refinement_op_and() || pred.op == refinement_op_or() {
        print("(")
        match pred.left {
            Some(l) => print_pred(*l)
            None => print("?")
        }
        print(" ")
        print_pred_op(pred.op)
        print(" ")
        match pred.right {
            Some(r) => print_pred(*r)
            None => print("?")
        }
        print(")")
        return
    }

    print_pred_name(pred.var_name)
    print(" ")
    print_pred_op(pred.op)
    print(" ")
    if pred.is_float {
        let rhs_milli = (pred.rhs_float * 1000.0) as i64
        print_int(rhs_milli)
        print("/1000")
    } else {
        print_int(pred.rhs_int)
    }
}

// Interval representation for refinement predicate proving.
// Used by pred_interval_implies as an SMT-lite solver.
struct Interval {
    lo: i64,
    hi: i64,
    lo_strict: bool,  // true = exclusive (>), false = inclusive (>=)
    hi_strict: bool,   // true = exclusive (<), false = inclusive (<=)
    lo_unbounded: bool,
    hi_unbounded: bool,
}

fn interval_full() -> Interval {
    Interval { lo: 0, hi: 0, lo_strict: false, hi_strict: false, lo_unbounded: true, hi_unbounded: true }
}

fn interval_empty() -> Interval {
    Interval { lo: 1, hi: 0, lo_strict: false, hi_strict: false, lo_unbounded: false, hi_unbounded: false }
}

fn interval_is_empty(iv: Interval) -> bool {
    if iv.lo_unbounded || iv.hi_unbounded { false }
    else if iv.lo > iv.hi { true }
    else if iv.lo == iv.hi && (iv.lo_strict || iv.hi_strict) { true }
    else { false }
}

// Convert a single atomic predicate to an interval.
fn pred_to_interval(p: RefinementPred) -> Interval with Mut {
    let v = p.rhs_int
    if p.op == refinement_op_gt() {
        Interval { lo: v, hi: 0, lo_strict: true, hi_strict: false, lo_unbounded: false, hi_unbounded: true }
    } else if p.op == refinement_op_gt_eq() {
        Interval { lo: v, hi: 0, lo_strict: false, hi_strict: false, lo_unbounded: false, hi_unbounded: true }
    } else if p.op == refinement_op_lt() {
        Interval { lo: 0, hi: v, lo_strict: false, hi_strict: true, lo_unbounded: true, hi_unbounded: false }
    } else if p.op == refinement_op_lt_eq() {
        Interval { lo: 0, hi: v, lo_strict: false, hi_strict: false, lo_unbounded: true, hi_unbounded: false }
    } else if p.op == refinement_op_eq() {
        Interval { lo: v, hi: v, lo_strict: false, hi_strict: false, lo_unbounded: false, hi_unbounded: false }
    } else {
        interval_full()
    }
}

// Intersect two intervals (for And predicates).
fn interval_intersect(a: Interval, b: Interval) -> Interval with Mut {
    var lo = a.lo
    var lo_strict = a.lo_strict
    var lo_unbounded = a.lo_unbounded
    var hi = a.hi
    var hi_strict = a.hi_strict
    var hi_unbounded = a.hi_unbounded

    if !b.lo_unbounded {
        if lo_unbounded || b.lo > lo || (b.lo == lo && b.lo_strict && !lo_strict) {
            lo = b.lo
            lo_strict = b.lo_strict
            lo_unbounded = false
        }
    }
    if !b.hi_unbounded {
        if hi_unbounded || b.hi < hi || (b.hi == hi && b.hi_strict && !hi_strict) {
            hi = b.hi
            hi_strict = b.hi_strict
            hi_unbounded = false
        }
    }
    Interval { lo: lo, hi: hi, lo_strict: lo_strict, hi_strict: hi_strict, lo_unbounded: lo_unbounded, hi_unbounded: hi_unbounded }
}

// Convert a compound predicate to an interval (handles And chains).
fn pred_to_interval_compound(p: RefinementPred) -> Interval with Mut, Panic, Div {
    if pred_is_atomic(p) {
        pred_to_interval(p)
    } else if p.op == refinement_op_and() {
        var iv = interval_full()
        match p.left {
            Some(lp) => {
                let left_iv = pred_to_interval_compound(*lp)
                iv = interval_intersect(iv, left_iv)
            }
            None => {}
        }
        match p.right {
            Some(rp) => {
                let right_iv = pred_to_interval_compound(*rp)
                iv = interval_intersect(iv, right_iv)
            }
            None => {}
        }
        iv
    } else {
        interval_full()
    }
}

// Check if interval `iv` satisfies predicate `target`.
fn interval_implies_pred(iv: Interval, target: RefinementPred) -> bool with Mut {
    if interval_is_empty(iv) { return true }
    let tv = target.rhs_int
    if target.op == refinement_op_gt() {
        if iv.lo_unbounded { false }
        else if iv.lo > tv { true }
        else if iv.lo == tv && iv.lo_strict { true }
        else { false }
    } else if target.op == refinement_op_gt_eq() {
        if iv.lo_unbounded { false }
        else if iv.lo > tv { true }
        else if iv.lo == tv && !iv.lo_strict { true }
        else { false }
    } else if target.op == refinement_op_lt() {
        if iv.hi_unbounded { false }
        else if iv.hi < tv { true }
        else if iv.hi == tv && iv.hi_strict { true }
        else { false }
    } else if target.op == refinement_op_lt_eq() {
        if iv.hi_unbounded { false }
        else if iv.hi < tv { true }
        else if iv.hi == tv && !iv.hi_strict { true }
        else { false }
    } else {
        false
    }
}

// Interval-based entailment: does predicate `a` imply predicate `b`?
fn pred_interval_implies(a: RefinementPred, b: RefinementPred) -> bool with Mut, Panic, Div {
    let iv = pred_to_interval_compound(a)
    if interval_is_empty(iv) { return true }
    if pred_is_atomic(b) {
        interval_implies_pred(iv, b)
    } else if b.op == refinement_op_and() {
        var left_ok = true
        match b.left {
            Some(bl) => { left_ok = pred_interval_implies(a, *bl) }
            None => {}
        }
        if !left_ok { return false }
        var right_ok = true
        match b.right {
            Some(br) => { right_ok = pred_interval_implies(a, *br) }
            None => {}
        }
        right_ok
    } else if b.op == refinement_op_or() {
        var left_ok = false
        match b.left {
            Some(bl) => { left_ok = pred_interval_implies(a, *bl) }
            None => {}
        }
        if left_ok { return true }
        var right_ok = false
        match b.right {
            Some(br) => { right_ok = pred_interval_implies(a, *br) }
            None => {}
        }
        right_ok
    } else {
        false
    }
}

