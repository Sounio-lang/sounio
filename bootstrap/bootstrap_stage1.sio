// Test 34: Cannot resume abandoned continuation
fn efh_test_resume_abandoned(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    efh_abort(ctx, cid)
    let ok = efh_resume(ctx, cid, 0)
    !ok  // should fail
}
fn test_efh_resume_abandoned() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_resume_abandoned(&! ctx), 34)
