}

fn test_avec_scalar_cost_loop_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 12, false, 0)
    avec_add_test_instr(nest, AVEC_OP_INDEX_SET, AVEC_INVALID, 21, 30, true, 1)
    let sc = avec_scalar_cost(nest, 0)
    // 3 instructions * AVEC_COST_SCALAR_ADD each = 3
    if sc != 3 { return false }
    true
}

fn test_avec_scalar_cost_loop() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_scalar_cost_loop_inner(&! nest)
}

fn test_avec_vector_cost_loop_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 10, 12, false, 0)
    avec_add_test_instr(nest, AVEC_OP_INDEX_SET, AVEC_INVALID, 21, 30, true, 1)
    let vc = avec_vector_cost(nest, 0, AVEC_VEC_256)
    // All unit-stride, so no gather/scatter penalty: 3 * AVEC_COST_VEC_ADD = 3
    if vc != 3 { return false }
    true
}

fn test_avec_vector_cost_loop() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_vector_cost_loop_inner(&! nest)
}

fn test_avec_profitability_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // 100 iterations, scalar cost 3, vector cost 3, width 4
    // Total scalar = 300, total vector = 3*25 + 0 = 75 -> profitable
    let prof = avec_is_profitable(3, 3, 100, 4)
    if prof == false { return false }
    // 2 iterations too small for vectorization
    let not_prof = avec_is_profitable(3, 3, 2, 4)
    if not_prof { return false }
    true
}

fn test_avec_profitability() -> bool with Mut, Div, Panic {
