    let id = own_declare_var(ctx, OwnTypeKind::TyAffine, 10)
    let m = own_transfer(ctx, id, 15)
    let u = own_check_use(ctx, id, 20)
    m && u == false && own_error_count(ctx) == 1
    && own_error_kind_eq(own_last_error_kind(ctx), OwnErrorKind::ErrUseAfterMove)
}

fn own_test_13() -> i64 with IO, Mut, Div, Panic {
    var ctx = own_context_new()
