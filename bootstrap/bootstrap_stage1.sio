fn test_loc_suggest_tiling_fits_l1_inner(ctx: &! LocContext) -> bool with Mut, Div, Panic {
    let arr = loc_add_array(ctx, 1024, 8, 1)
    let lp = loc_add_loop(ctx, 0, 100, LOC_INVALID)
    // Working set = 100 * 8 = 800 bytes << 32KB L1
    let acc = loc_add_access(ctx, arr, 0, 8, LocStrideKind::StrideUnit, lp, 8, 1)
    let config = loc_suggest_tiling(ctx, 0)
    // Already fits in L1 with margin: not profitable
    if loc_tile_status_to_int(config.status) != 1 { return false }
    true
}
