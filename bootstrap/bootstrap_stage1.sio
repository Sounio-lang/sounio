}

// ============================================================
// Test 6: Vtable construction — basic
// ============================================================

fn test_te_vtable_basic() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let methods = te_make_methods_2_set(100, 101)
    ctx = te_build_vtable(ctx, 10, 20, methods, 2, 16, 8, TE_NOT_FOUND)
    if ctx.vtable_count != 1 {
        print("FAIL: test_te_vtable_basic - count\n")
        return 1
    }
    let vt = ctx.vtables[0 as usize]
    if vt.type_id != 10 {
        print("FAIL: test_te_vtable_basic - type_id\n")
        return 1
    }
    if vt.trait_id != 20 {
        print("FAIL: test_te_vtable_basic - trait_id\n")
        return 1
    }
    if vt.method_count != 2 {
        print("FAIL: test_te_vtable_basic - method_count\n")
        return 1
    }
    if vt.size != 16 {
        print("FAIL: test_te_vtable_basic - size\n")
        return 1
    }
    if vt.alignment != 8 {
        print("FAIL: test_te_vtable_basic - align\n")
        return 1
    }
    print("PASS: test_te_vtable_basic\n")
    return 0
}

// ============================================================
// Test 7: Vtable method lookup
// ============================================================

fn test_te_vtable_method_lookup() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let methods = te_make_methods_3_set(200, 201, 202)
    ctx = te_build_vtable(ctx, 10, 20, methods, 3, 8, 8, TE_NOT_FOUND)
    let fn0 = te_vtable_dispatch(ctx, 0, 0)
    if fn0 != 200 {
        print("FAIL: test_te_vtable_method_lookup - 0\n")
        return 1
    }
    let fn1 = te_vtable_dispatch(ctx, 0, 1)
    if fn1 != 201 {
        print("FAIL: test_te_vtable_method_lookup - 1\n")
        return 1
    }
    let fn2 = te_vtable_dispatch(ctx, 0, 2)
    if fn2 != 202 {
        print("FAIL: test_te_vtable_method_lookup - 2\n")
        return 1
    }
    let fn3 = te_vtable_dispatch(ctx, 0, 3)
    if fn3 != TE_NOT_FOUND {
        print("FAIL: test_te_vtable_method_lookup - oob\n")
        return 1
    }
    print("PASS: test_te_vtable_method_lookup\n")
    return 0
}

