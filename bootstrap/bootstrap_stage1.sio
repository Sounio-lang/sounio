    mema_add_instr(ctx, MemPtrOp::PtrAlloc, p0, r, 0, 0, 1)
    mema_add_instr(ctx, MemPtrOp::PtrCopy, p1, p0, 0, 0, 2)
    mema_add_instr(ctx, MemPtrOp::PtrCopy, p2, p1, 0, 0, 3)
    let converged = mema_analyze_function(ctx)
    converged &&
    mema_must_alias(ctx, p0, p1) &&
    mema_must_alias(ctx, p1, p2) &&
    mema_promote_eq(ctx.allocs[0].promote, MemPromoteResult::PromoteYes)
}

