// Section 21: Tests — state machine struct layout
// ============================================================================

fn test_async_future_field_count_no_captures() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.capture_count = 0
    // state_tag + result = 2
    if async_future_struct_field_count(sm) != 2 { return 1 }
    0
}

fn test_async_future_field_count_with_captures() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.capture_count = 5
    // state_tag + 5 captures + result = 7
    if async_future_struct_field_count(sm) != 7 { return 1 }
    0
}

fn test_async_state_tag_field_is_zero() -> i64 with Mut, Panic, Div {
    if async_state_tag_field() != 0 { return 1 }
    0
}

fn test_async_capture_field_indices() -> i64 with Mut, Panic, Div {
    if async_capture_field(0) != 1 { return 1 }
    if async_capture_field(1) != 2 { return 2 }
    if async_capture_field(4) != 5 { return 3 }
    0
}

fn test_async_result_field_index() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.capture_count = 3
    // result is at capture_count + 1 = 4
    if async_result_field(sm) != 4 { return 1 }
    0
}

fn test_async_future_layout_structure() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.capture_count = 2
    sm.captured_vars[0] = async_live_var_make(0, 1, 0, false)
    sm.captured_vars[1] = async_live_var_make(1, 1, 1, false)
    let name = ir_empty_name()
    let layout = async_build_future_layout(sm, name)
    // state_tag + 2 captures + result = 4 fields
    if layout.field_count != 4 { return 1 }
    // Field 0 should be state_tag
    if layout.fields[0].index != 0 { return 2 }
    // Field 3 should be result
    if layout.fields[3].index != 3 { return 3 }
    0
}

// ============================================================================
// Section 22: Tests — poll function state dispatch
// ============================================================================

fn test_async_poll_dispatch_count() -> i64 with Mut, Panic, Div {
    // Each state gets 3 instructions in the dispatch: load_imm, binop(eq), branch_true
    // Plus 1 for the initial field_get of state_tag.
    let func = async_make_two_await_func()
    var sm = async_state_machine_new()
    sm = async_detect_suspend_points(func, sm)
    sm = async_split_states(func, sm)

    var buf: [IrInstr; 4096] = [ir_nop(); 4096]
    var labels: [i64; 256] = [0; 256]
    labels[0] = 100
    labels[1] = 101
    labels[2] = 102
    let pos = async_emit_poll_dispatch(sm, 50, 51, labels, buf, 0, 52)
    // 1 (field_get) + 3 states * 3 instrs = 10
    if pos != 10 { return 1 }
    0
}

fn test_async_emit_state_update_instrs() -> i64 with Mut, Panic, Div {
    var buf: [IrInstr; 4096] = [ir_nop(); 4096]
    let pos = async_emit_state_update(10, 5, buf, 0, 20)
    // 2 instructions: load_imm + field_set
    if pos != 2 { return 1 }
    0
}

fn test_async_emit_suspend_instrs() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.capture_count = 2
    sm.captured_vars[0] = async_live_var_make(0, 1, 0, false)
    sm.captured_vars[1] = async_live_var_make(1, 1, 1, false)
    var buf: [IrInstr; 4096] = [ir_nop(); 4096]
    let pos = async_emit_suspend(sm, 10, 3, buf, 0, 20, 21)
    // state_update(2) + save_captures(2) + load_pending(1) + return(1) = 6
    if pos != 6 { return 1 }
    0
}

fn test_async_emit_ready_instrs() -> i64 with Mut, Panic, Div {
    var sm = async_state_machine_new()
    sm.capture_count = 1
    sm.captured_vars[0] = async_live_var_make(0, 1, 0, false)
    var buf: [IrInstr; 4096] = [ir_nop(); 4096]
    let pos = async_emit_ready(sm, 10, 5, buf, 0, 20, 21)
    // state_update(2) + field_set_result(1) + load_ready(1) + return(1) = 5
    if pos != 5 { return 1 }
    0
}

