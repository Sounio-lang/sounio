}

// T32: Skip to sync with start_pos offset
fn recv_test_skip_to_sync_with_offset() -> bool with IO, Mut, Panic, Div {
    var s = recv_state_new()
    s = recv_add_sync_token(s, 50)
    s = recv_enter_panic_mode(s)

    var kinds: [i64; 4096] = [0; 4096]
    kinds[0] = 50  // sync at 0 — but we start at 2
    kinds[1] = 10
    kinds[2] = 20
    kinds[3] = 50  // sync at 3
    kinds[4] = 60

    let result = recv_skip_to_sync(s, kinds, 5, 2)
    s = result.0
    let pos = result.1
    let ok1 = pos == 3  // found sync at index 3, not 0
    let ok2 = recv_tokens_skipped(s) == 1  // skipped kind[2]=20
    let label = recv_test_label(
        84, 51, 50, 0, 0, 0, 0, 0, 0, 0, 3)  // "T32"
    recv_assert_true(ok1 && ok2, label.0, label.1)
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn run_recovery_tests() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    var total: i64 = 0

    total = total + 1
    if recv_test_new_state_no_errors() { passed = passed + 1 }

    total = total + 1
    if recv_test_default_max_errors() { passed = passed + 1 }

    total = total + 1
    if recv_test_push_pop_recovery() { passed = passed + 1 }

    total = total + 1
    if recv_test_pop_empty_stack() { passed = passed + 1 }

    total = total + 1
    if recv_test_push_multiple_lifo() { passed = passed + 1 }

    total = total + 1
    if recv_test_add_sync_token() { passed = passed + 1 }

    total = total + 1
    if recv_test_sync_token_dedup() { passed = passed + 1 }

    total = total + 1
    if recv_test_remove_sync_token() { passed = passed + 1 }

    total = total + 1
    if recv_test_report_error() { passed = passed + 1 }

    total = total + 1
    if recv_test_report_multiple_errors() { passed = passed + 1 }

    total = total + 1
    if recv_test_panic_mode() { passed = passed + 1 }

    total = total + 1
    if recv_test_can_continue_under_limit() { passed = passed + 1 }

    total = total + 1
    if recv_test_can_continue_at_limit() { passed = passed + 1 }

    total = total + 1
    if recv_test_cascade_detected() { passed = passed + 1 }

    total = total + 1
    if recv_test_cascade_not_detected() { passed = passed + 1 }

    total = total + 1
    if recv_test_skip_to_sync() { passed = passed + 1 }

    total = total + 1
    if recv_test_skip_to_sync_no_match() { passed = passed + 1 }

    total = total + 1
    if recv_test_suggest_insertion() { passed = passed + 1 }

    total = total + 1
    if recv_test_suggest_deletion() { passed = passed + 1 }

    total = total + 1
    if recv_test_merge_errors() { passed = passed + 1 }

    total = total + 1
    if recv_test_merge_errors_different_lines() { passed = passed + 1 }

    total = total + 1
    if recv_test_format_error() { passed = passed + 1 }

    total = total + 1
    if recv_test_error_with_expected() { passed = passed + 1 }

    total = total + 1
    if recv_test_peek_recovery() { passed = passed + 1 }

    total = total + 1
    if recv_test_reset() { passed = passed + 1 }

    total = total + 1
    if recv_test_error_limit_enforcement() { passed = passed + 1 }

    total = total + 1
    if recv_test_duplicate_error_detection() { passed = passed + 1 }

    total = total + 1
    if recv_test_has_errors() { passed = passed + 1 }

    total = total + 1
    if recv_test_last_error() { passed = passed + 1 }

    total = total + 1
    if recv_test_constants() { passed = passed + 1 }

    total = total + 1
    if recv_test_get_error_out_of_bounds() { passed = passed + 1 }

    total = total + 1
    if recv_test_skip_to_sync_with_offset() { passed = passed + 1 }

    print("Recovery tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print("\n")

    if passed == total {
        print("ALL RECOVERY TESTS PASSED\n")
        0
    } else {
        1
    }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/resolve/scope.sio  (68 lines)
// ════════════════════════════════════════════════════════════════

// Scope stack for lexical scoping
//
// Each scope records where it begins in the symbol table (start_index)
// and its depth. Pushing a scope records the current symbol count;
// popping restores visibility by trimming back to start_index.
// Lookup walks symbols in reverse from current count to find the
// innermost binding for a name.


// ============================================================
// Scope entry
// ============================================================

struct Scope {
    start_index: i64,
    depth: i64,
}

fn empty_scope() -> Scope {
    Scope { start_index: 0, depth: 0 }
}

// ============================================================
// Scope stack
// ============================================================

struct ScopeStack {
    scopes: [Scope; 256],
    depth: i64,
}

fn scope_stack_new() -> ScopeStack {
    ScopeStack {
        scopes: [empty_scope(); 256],
        depth: 0,
    }
}

impl ScopeStack {
    fn push(self, sym_count: i64) -> ScopeStack with Mut, Panic, Div {
        var ss = self
        if ss.depth < 256 {
            ss.scopes[ss.depth] = Scope {
                start_index: sym_count,
                depth: ss.depth,
            }
            ss.depth = ss.depth + 1
        }
        ss
    }

    fn pop(self) -> ScopeStack with Mut {
        var ss = self
        if ss.depth > 0 {
            ss.depth = ss.depth - 1
        }
        ss
    }

    fn current_start(self) -> i64 with Panic, Div {
        if self.depth > 0 {
            self.scopes[self.depth - 1].start_index
        } else {
            0
        }
    }
}

