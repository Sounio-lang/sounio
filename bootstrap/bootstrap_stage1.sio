    msg[1] = 111 as i8  // 'o'
    msg[2] = 112 as i8  // 'p'
    msg[3] = 115 as i8  // 's'
    err = recv_error_set_message(err, msg, 4)
    let result = recv_format_error(err)
    let buf = result.0
    let len = result.1
    // Should start with 'e' for "error["
