    let still_borrowed = own_state_is_borrowed(own_get_state(ctx, id))
    // Now the first borrow is at index 0
    own_release_borrow(ctx, 0)
    let now_owned = own_state_is_owned(own_get_state(ctx, id))
    still_borrowed && now_owned
}

