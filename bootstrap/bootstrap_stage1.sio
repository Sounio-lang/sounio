    let v2 = lsc_add_variable(p, 221, 0)

    var ctx = lsc_context_new()
    ctx.in_type_position = true

    let list = lsc_provide_completions(p, &ctx)
    // Only the type should appear
    list.count == 1
}
fn test_lsc_dispatch_type() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_dispatch_type_inner(&! p)
}

// T49: provide_completions merges identifiers and keywords
fn test_lsc_dispatch_merged_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let v1 = lsc_add_variable(p, 230, 0)
    let kw_count = lsc_register_sounio_keywords(p)

    let ctx = lsc_context_new()
    let list = lsc_provide_completions(p, &ctx)
    // Should have 1 variable + 28 keywords = 29
    list.count == 29
}
fn test_lsc_dispatch_merged() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_dispatch_merged_inner(&! p)
}

// T50: end-to-end: add items, complete, sort, filter
fn test_lsc_e2e_inner(p: &! LscProvider) -> bool with Mut, Div, Panic {
    let v1 = lsc_add_variable(p, 300, 0)
    let v2 = lsc_add_function(p, 301, 0)
    let v3 = lsc_add_type(p, 302, 0)
    let kw_count = lsc_register_sounio_keywords(p)

    let ctx = lsc_context_new()
    let raw = lsc_provide_completions(p, &ctx)
    let sorted = lsc_sort_completions(raw)
    let filtered = lsc_filter_completions(sorted, 10)

    let ok_count = filtered.count == 10
    let ok_incomplete = filtered.is_incomplete
    // First item should have highest priority
    let ok_sorted = filtered.items[0].sort_priority >= filtered.items[1].sort_priority
    ok_count && ok_incomplete && ok_sorted
}
fn test_lsc_e2e() -> bool with Mut, Div, Panic {
    var p = lsc_provider_new()
    test_lsc_e2e_inner(&! p)
}

// T51: provider_new creates empty state
fn test_lsc_provider_new() -> bool {
    let p = lsc_provider_new()
    let ok_scope = p.scope_count == 0
    let ok_field = p.field_count == 0
    let ok_method = p.method_count == 0
    let ok_kw = p.keyword_count == 0
    let ok_depth = p.current_depth == 0
    ok_scope && ok_field && ok_method && ok_kw && ok_depth
}

// T52: context_new creates default context
fn test_lsc_context_new() -> bool {
