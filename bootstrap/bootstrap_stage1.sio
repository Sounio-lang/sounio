fn ir_plan_acquisition(dst: i64, value_reg: i64, deferred_reg: i64, acquisition_policy_reg: i64, plan_id: i64) -> IrInstr {
    let base = ir_instr_new(IrOpcode::IrPlanAcquisition)
    IrInstr {
        op: base.op,
        dst: dst,
        src1: value_reg,
