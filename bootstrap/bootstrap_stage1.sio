    var env = gadt_env_new()
    return test_gadt_types_equal_diff_kind_inner(&! env)
}

fn test_gadt_unify_var_inner(env: &! GadtEnv) -> bool with Mut, Div, Panic {
    let v = gadt_mk_var(env, 50)
    let ti = gadt_mk_int(env)
    let ok = gadt_unify(env, v, ti)
    if ok == false { return false }
    // Evidence should have been pushed
    let refined = gadt_find_evidence(env, 50)
    refined == ti
}
fn test_gadt_unify_var() -> bool with Mut, Div, Panic {
    var env = gadt_env_new()
    return test_gadt_unify_var_inner(&! env)
}

