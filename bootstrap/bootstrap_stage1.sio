// Test 34: Optimized {i8, i32, i8, i16} — sorted by descending align
fn test_lay_34_opt_4fields_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8  = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i16 = lay_register_type(ctx, LayTypeKind::TkI16, LayRepr::ReprDefault)
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
    types[0 as usize] = t_i8
    types[1 as usize] = t_i32
    types[2 as usize] = t_i8
    types[3 as usize] = t_i16
    names[0 as usize] = 1
    names[1 as usize] = 2
    names[2 as usize] = 3
    names[3 as usize] = 4
    lay_set_fields(ctx, s, &types, &names, 4)
    let l = lay_compute_struct_optimized(ctx, s)
    // Sorted: i32(4), i16(2), i8(1), i8(1)
    // i32@0(4), i16@4(2), i8@6(1), i8@7(1) => size=8, align=4
    l.size == 8 && l.align == 4
}
fn test_lay_34_opt_4fields() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_34_opt_4fields_inner(&! ctx), 34)
}

