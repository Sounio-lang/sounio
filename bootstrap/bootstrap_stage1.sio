    inc_modify_node(ctx, 7)
    inc_detect_changes(ctx)
    inc_invalidate_transitive(ctx)

    // ALL nodes should be stale
    var all_stale: bool = true
    var i: i64 = 0
    while i < 8 {
        if inc_node_is_stale(ctx, i) == false {
            all_stale = false
        }
        i = i + 1
    }
    all_stale
}

