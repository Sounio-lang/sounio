// T09: Eligibility — alloca prevents TCO
fn test_tco_alloca_prevents_tco() -> i32 with IO, Mut, Div, Panic {
    let func = tco_make_func_with_alloca(0)
    let info = tco_analyze_function(func, 0)
    if info.is_eligible {
        print("FAIL: test_tco_alloca_prevents_tco\n")
        return 1
    }
    if !info.has_alloca {
        print("FAIL: test_tco_alloca_prevents_tco (has_alloca)\n")
        return 1
    }
    print("PASS: test_tco_alloca_prevents_tco\n")
    return 0
}

// T10: Eligibility — cleanup prevents TCO
fn test_tco_cleanup_prevents_tco() -> i32 with IO, Mut, Div, Panic {
    let func = tco_make_func_with_alloca(0)
    let info = tco_analyze_function(func, 0)
    let elig = tco_check_eligibility(func, info)
    let is_eligible = elig.0
    let reason = elig.1
    if is_eligible {
        print("FAIL: test_tco_cleanup_prevents_tco\n")
        return 1
    }
    // Reason should be cleanup (alloca implies cleanup)
    if reason != TCO_REJECT_CLEANUP {
        print("FAIL: test_tco_cleanup_prevents_tco (reason)\n")
        return 1
    }
    print("PASS: test_tco_cleanup_prevents_tco\n")
    return 0
}

// T11: Module analysis — updates stats
