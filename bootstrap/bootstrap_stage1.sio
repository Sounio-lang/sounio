// main removed — called from bootstrap main.sio via prof_run_all_tests()

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/native/hyper_lower.sio  (476 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted/native/hyper_lower.sio
// Native x86-64 lowering for Hyper<Algebra, T> operations
//
// Strategy:

//   - Cayley-Dickson tower (R, C, H, O, S): scalar/packed f64 in stack slots
//   - Clifford(p,q): 2^(p+q) component multivectors in stack slots
//   - AVX-512 path for Cl(1,3): future (requires EVEX prefix emit support)
//   - Current: scalar loop over components via GPR stack-slot model
//
// This module extends lower_ir.sio with Hyper-aware instruction lowering.
// Pattern follows: lower_ir.sio dispatch + encode.sio emit helpers
//
// STATUS: Compilable Sounio. Origin: Grok 4.2 spec, manually translated.
//   Uses NativeCompiler from codegen.sio
//   Uses emit_* helpers from encode.sio
//   Register conventions: rax = primary, rbx = secondary, rcx = temp

// ============================================================
// Algebra dimension lookup (must match ir/algebra.sio)
// ============================================================

let NATIVE_ALG_REAL: i64 = 0
let NATIVE_ALG_COMPLEX: i64 = 1
let NATIVE_ALG_QUATERNION: i64 = 2
let NATIVE_ALG_OCTONION: i64 = 3
let NATIVE_ALG_SEDENION: i64 = 4
let NATIVE_ALG_CLIFFORD: i64 = 5

fn hyper_dimension(alg: i64, cl_p: i64, cl_q: i64) -> i64 {
    if alg == 0 { return 1 }
    if alg == 1 { return 2 }
    if alg == 2 { return 4 }
    if alg == 3 { return 8 }
    if alg == 4 { return 16 }
    if alg == 5 {
        var result = 1
        var i = 0
        while i < cl_p + cl_q {
            result = result * 2
            i = i + 1
        }
        return result
    }
    return 0
}

// ============================================================
// Stack slot layout for Hyper values
// ============================================================
//
// Each Hyper value occupies dim * 8 bytes on the stack (f64 per component).
// Layout: [component_0][component_1]...[component_{dim-1}]
//
// For Cl(1,3): 16 components * 8 bytes = 128 bytes per multivector.
// Basis ordering by bitset: {}, {e0}, {e1}, {e0e1}, {e2}, ...
//
// Stack allocation: rbp - base_offset

fn hyper_slot_size(alg: i64, cl_p: i64, cl_q: i64) -> i64 {
    hyper_dimension(alg, cl_p, cl_q) * 8
}

// Compute stack displacement for component i of a Hyper value at vreg slot
fn hyper_component_disp(vreg: i64, component: i64, dim: i64) -> i64 {
    // Negative displacement from rbp: -(vreg+1)*dim*8 - component*8
    let base = (vreg + 1) * dim * 8
    0 - base - component * 8
}

// ============================================================
// Component-wise binary operations (scalar fallback)
// ============================================================

fn lower_hyper_add(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i: i64 = 0
    while i < dim {
        let left_disp = hyper_component_disp(left_vreg, i, dim)
        let right_disp = hyper_component_disp(right_vreg, i, dim)
        let dst_disp = hyper_component_disp(dst_vreg, i, dim)
        // rax = left[i]
        c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
        // rbx = right[i]
        c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
        // rax = rax + rbx
        c.code = emit_add_reg_reg(c.code, 0, 3)  // rax=0, rbx=3
        // dst[i] = rax
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

fn lower_hyper_sub(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i: i64 = 0
    while i < dim {
        let left_disp = hyper_component_disp(left_vreg, i, dim)
        let right_disp = hyper_component_disp(right_vreg, i, dim)
        let dst_disp = hyper_component_disp(dst_vreg, i, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
        c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
        c.code = emit_sub_reg_reg(c.code, 0, 3)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

// ============================================================
// Geometric product sign computation
// ============================================================
//
// For Clifford(p,q), the geometric product of basis blades A and B:
//   1. Count swaps to sort combined index sequence
//   2. For shared basis vectors, multiply by metric (e_i^2 = +1 if i<p, -1 if i>=p)
//   3. sign = (-1)^swaps * product_of_metrics

fn geo_product_sign(a: i64, b: i64, p: i64, q: i64) -> i64 {
    let n = p + q
    var sign = 1

    // Count swap parity: for each bit in b, count bits in a above it
    var j: i64 = 0
    while j < n {
        if (b >> j) & 1 == 1 {
            var k = j + 1
            while k < n {
                if (a >> k) & 1 == 1 {
                    sign = 0 - sign
                }
                k = k + 1
            }
        }
        j = j + 1
    }

    // Metric signs for shared basis vectors
    let shared = a & b
    var m: i64 = 0
    while m < n {
        if (shared >> m) & 1 == 1 {
            if m >= p {
                sign = 0 - sign
            }
        }
        m = m + 1
    }

    sign
}

fn geo_product_blade(a: i64, b: i64) -> i64 {
    a ^ b
}

// ============================================================
// Clifford geometric product (full expansion, O(dim^2))
// ============================================================

fn lower_hyper_geo_product(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc

    // Zero destination
    var z: i64 = 0
    while z < dim {
        let dst_disp = hyper_component_disp(dst_vreg, z, dim)
        c.code = emit_mov_rax_imm(c.code, 0)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        z = z + 1
    }

    // Double loop: for each pair (i, j) of basis blades
    var i: i64 = 0
    while i < dim {
        var j: i64 = 0
        while j < dim {
            let k = geo_product_blade(i, j)
            let sign = geo_product_sign(i, j, cl_p, cl_q)

            if sign != 0 {
                let left_disp = hyper_component_disp(left_vreg, i, dim)
                let right_disp = hyper_component_disp(right_vreg, j, dim)
                let dst_disp = hyper_component_disp(dst_vreg, k, dim)

                // rax = left[i]
                c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
                // rbx = right[j]
                c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
                // rax = rax * rbx (imul for bootstrap i64 path)
                c.code = emit_imul_reg_reg(c.code, 0, 3)
                // Apply sign
                if sign < 0 {
                    c.code = emit_neg_rax(c.code)
                }
                // Accumulate: rbx = dst[k], rax = rax + rbx, store
                c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
                c.code = emit_add_reg_reg(c.code, 0, 3)
                c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
            }
            j = j + 1
        }
        i = i + 1
    }
    c
}

// ============================================================
// Hamilton product (Quaternion, dim=4)
// ============================================================
//
//   result[0] = a0*b0 - a1*b1 - a2*b2 - a3*b3
//   result[1] = a0*b1 + a1*b0 + a2*b3 - a3*b2
//   result[2] = a0*b2 - a1*b3 + a2*b0 + a3*b1
//   result[3] = a0*b3 + a1*b2 - a2*b1 + a3*b0

fn lower_quaternion_product(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64) -> NativeCompiler with Mut, Panic, Div {
    let dim: i64 = 4
    var c = nc

    // result[0] = a0*b0 - a1*b1 - a2*b2 - a3*b3
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 0,
        0, 0, 1, 1, 1, -1, 2, 2, -1, 3, 3, -1)
    // result[1] = a0*b1 + a1*b0 + a2*b3 - a3*b2
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 1,
        0, 1, 1, 1, 0, 1, 2, 3, 1, 3, 2, -1)
    // result[2] = a0*b2 - a1*b3 + a2*b0 + a3*b1
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 2,
        0, 2, 1, 1, 3, -1, 2, 0, 1, 3, 1, 1)
    // result[3] = a0*b3 + a1*b2 - a2*b1 + a3*b0
    c = lower_quat_component(c, dst_vreg, left_vreg, right_vreg, dim, 3,
        0, 3, 1, 1, 2, 1, 2, 1, -1, 3, 0, 1)
    c
}

// Compute one quaternion product component (4 terms)
fn lower_quat_component(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64, out_idx: i64, li0: i64, ri0: i64, s0: i64, li1: i64, ri1: i64, s1: i64, li2: i64, ri2: i64, s2: i64, li3: i64, ri3: i64, s3: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let dst_disp = hyper_component_disp(dst_vreg, out_idx, dim)

    // Term 0: s0 * left[li0] * right[ri0]
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li0, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri0, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s0 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    // Term 1: accumulate s1 * left[li1] * right[ri1]
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li1, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri1, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s1 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
    c.code = emit_add_reg_reg(c.code, 0, 3)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    // Term 2
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li2, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri2, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s2 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
    c.code = emit_add_reg_reg(c.code, 0, 3)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    // Term 3
    c.code = emit_load_rbp_disp32_rax(c.code, hyper_component_disp(left_vreg, li3, dim))
    c.code = emit_load_rbp_disp32_rbx(c.code, hyper_component_disp(right_vreg, ri3, dim))
    c.code = emit_imul_reg_reg(c.code, 0, 3)
    if s3 < 0 { c.code = emit_neg_rax(c.code) }
    c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
    c.code = emit_add_reg_reg(c.code, 0, 3)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    c
}

// ============================================================
// Component-wise multiplication (Real, Complex scalar path)
// ============================================================

fn lower_hyper_component_mul(nc: NativeCompiler, dst_vreg: i64, left_vreg: i64, right_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var i: i64 = 0
    while i < dim {
        let left_disp = hyper_component_disp(left_vreg, i, dim)
        let right_disp = hyper_component_disp(right_vreg, i, dim)
        let dst_disp = hyper_component_disp(dst_vreg, i, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, left_disp)
        c.code = emit_load_rbp_disp32_rbx(c.code, right_disp)
        c.code = emit_imul_reg_reg(c.code, 0, 3)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

// ============================================================
// Conjugation
// ============================================================
//
// Cayley-Dickson: keep real part (component 0), negate imaginary parts
// Clifford reversion: sign = (-1)^(grade*(grade-1)/2)

fn lower_hyper_conjugate(nc: NativeCompiler, dst_vreg: i64, src_vreg: i64, alg: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    let dim = hyper_dimension(alg, cl_p, cl_q)
    var c = nc

    if alg <= 4 {
        // Cayley-Dickson: keep component 0, negate rest
        let src_disp_0 = hyper_component_disp(src_vreg, 0, dim)
        let dst_disp_0 = hyper_component_disp(dst_vreg, 0, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, src_disp_0)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp_0)
        var i: i64 = 1
        while i < dim {
            let src_disp = hyper_component_disp(src_vreg, i, dim)
            let dst_disp = hyper_component_disp(dst_vreg, i, dim)
            c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
            c.code = emit_neg_rax(c.code)
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
            i = i + 1
        }
    } else {
        // Clifford reversion
        var k: i64 = 0
        while k < dim {
            let grade = popcount_i64(k)
            let sign_exp = (grade * (grade - 1)) / 2
            let src_disp = hyper_component_disp(src_vreg, k, dim)
            let dst_disp = hyper_component_disp(dst_vreg, k, dim)
            c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
            if sign_exp & 1 == 1 {
                c.code = emit_neg_rax(c.code)
            }
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
            k = k + 1
        }
    }
    c
}

fn popcount_i64(val: i64) -> i64 {
    var x = val
    var count: i64 = 0
    while x != 0 {
        count = count + (x & 1)
        x = x >> 1
    }
    count
}

// ============================================================
// Norm squared: sum of component^2
// ============================================================

fn lower_hyper_norm_sq(nc: NativeCompiler, dst_vreg: i64, src_vreg: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    let dst_disp = hyper_component_disp(dst_vreg, 0, 1)  // scalar result

    // Initialize accumulator to 0
    c.code = emit_mov_rax_imm(c.code, 0)
    c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)

    var i: i64 = 0
    while i < dim {
        let src_disp = hyper_component_disp(src_vreg, i, dim)
        c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
        // rax = rax * rax (square)
        c.code = emit_imul_reg_reg(c.code, 0, 0)
        // accumulate
        c.code = emit_load_rbp_disp32_rbx(c.code, dst_disp)
        c.code = emit_add_reg_reg(c.code, 0, 3)
        c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        i = i + 1
    }
    c
}

// ============================================================
// Grade extraction (Clifford only)
// ============================================================
//
// Extract components of grade g, zero all others

fn lower_hyper_grade_extract(nc: NativeCompiler, dst_vreg: i64, src_vreg: i64, grade: i64, dim: i64) -> NativeCompiler with Mut, Panic, Div {
    var c = nc
    var k: i64 = 0
    while k < dim {
        let blade_grade = popcount_i64(k)
        let src_disp = hyper_component_disp(src_vreg, k, dim)
        let dst_disp = hyper_component_disp(dst_vreg, k, dim)
        if blade_grade == grade {
            c.code = emit_load_rbp_disp32_rax(c.code, src_disp)
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        } else {
            c.code = emit_mov_rax_imm(c.code, 0)
            c.code = emit_store_rax_rbp_disp32(c.code, dst_disp)
        }
        k = k + 1
    }
    c
}

// ============================================================
// Hyper binary operation dispatch
// ============================================================

fn lower_hyper_binop(nc: NativeCompiler, instr: IrInstr, alg: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    let dim = hyper_dimension(alg, cl_p, cl_q)
    let dst_vreg = instr.dst
    let left_vreg = instr.src1
    let right_vreg = instr.src2

    if instr.bin_op == BinaryOp::OpAdd {
        return lower_hyper_add(nc, dst_vreg, left_vreg, right_vreg, dim)
    }
    if instr.bin_op == BinaryOp::OpSub {
        return lower_hyper_sub(nc, dst_vreg, left_vreg, right_vreg, dim)
    }
    if instr.bin_op == BinaryOp::OpMul {
        if alg == NATIVE_ALG_QUATERNION {
            return lower_quaternion_product(nc, dst_vreg, left_vreg, right_vreg)
        }
        if alg == NATIVE_ALG_CLIFFORD {
            return lower_hyper_geo_product(nc, dst_vreg, left_vreg, right_vreg, dim, cl_p, cl_q)
        }
        return lower_hyper_component_mul(nc, dst_vreg, left_vreg, right_vreg, dim)
    }

    // Unsupported op: pass through
    nc
}

// ============================================================
// AVX-512 path stubs (for future EVEX prefix emit support)
// ============================================================
//
// When encode.sio gains EVEX prefix support:
//   - Cl(1,3) 16 components = 2 ZMM registers (8 x f64 each)
//   - geo_product via vfmadd231pd with vpermq for sign flips
//   - conjugate via vxorpd with sign mask
//   - norm via vdpps / horizontal add reduction
//
// The sign table for Cl(1,3) geometric product is a 16x16 matrix of
// {+1, -1, 0} values, compile-time constant. With AVX-512, each row
// of 16 multiplications reduces to 2 FMAs on ZMM registers.
// Total: 16 rows * 2 FMAs = 32 FMA instructions + setup.

fn avx512_cl13_available() -> bool {
    // Placeholder: returns false until EVEX emit support is added
    false
}

// ============================================================
// Hyper lowering entry point
// ============================================================
//
// Called from lower_ir.sio when instruction operates on Hyper types.
// Type metadata (algebra_kind, clifford_p, clifford_q) comes from
// the IR type annotation.

fn lower_hyper_instruction(nc: NativeCompiler, instr: IrInstr, alg: i64, cl_p: i64, cl_q: i64) -> NativeCompiler with Mut, Panic, Div {
    if instr.op == IrOpcode::IrBinOp {
        return lower_hyper_binop(nc, instr, alg, cl_p, cl_q)
    }
    // Other Hyper operations (conjugate, norm, grade) compile as
    // method calls through standard call dispatch for now.
    // Direct opcodes will be added when IR is extended.
    nc
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/wasm/mod.sio  (1388 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::wasm::mod — WebAssembly binary format emitter
//
// Emits valid WASM 1.0 binary modules from structured section descriptors.
// Follows the PtxBuf / SpvBuf buffer pattern used elsewhere in the self-hosted
// compiler:  flat byte array + length counter, value-return mutation.
//
// WASM binary format reference (MVP):
//   Magic:   \0asm           (4 bytes: 0x00 0x61 0x73 0x6D)
//   Version: 1               (4 bytes: 0x01 0x00 0x00 0x00)
//   Sections: id(1 byte) + payload_len(LEB128) + payload
//
// Section IDs used here:
//   1 = Type    3 = Function    5 = Memory    7 = Export    10 = Code
//
// LEB128 encoding is required for all integer fields in WASM.


// ============================================================================
// WASM value type constants
// ============================================================================

let WASM_TYPE_I32: i64 = 0x7F
let WASM_TYPE_I64: i64 = 0x7E
let WASM_TYPE_F32: i64 = 0x7D
let WASM_TYPE_F64: i64 = 0x7C
let WASM_TYPE_FUNCREF: i64 = 0x70
let WASM_TYPE_FUNC: i64 = 0x60

// Section IDs
let WASM_SECTION_TYPE: i64 = 1
let WASM_SECTION_IMPORT: i64 = 2
let WASM_SECTION_FUNCTION: i64 = 3
let WASM_SECTION_TABLE: i64 = 4
let WASM_SECTION_MEMORY: i64 = 5
let WASM_SECTION_GLOBAL: i64 = 6
let WASM_SECTION_EXPORT: i64 = 7
let WASM_SECTION_START: i64 = 8
let WASM_SECTION_ELEMENT: i64 = 9
let WASM_SECTION_CODE: i64 = 10
let WASM_SECTION_DATA: i64 = 11

// Export kinds
let WASM_EXPORT_FUNC: i64 = 0x00
let WASM_EXPORT_TABLE: i64 = 0x01
let WASM_EXPORT_MEMORY: i64 = 0x02
let WASM_EXPORT_GLOBAL: i64 = 0x03

// ============================================================================
// WasmBuf — binary byte buffer (256KB)
// ============================================================================

struct WasmBuf {
    data: [i8; 262144],
    len: i64,
}

fn wasm_buf_new() -> WasmBuf {
    WasmBuf { data: [0; 262144], len: 0 }
}

fn wasm_push_byte(buf: WasmBuf, b: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 {
        if out.len < 262144 {
            let masked = b % 256
            var byte_val = masked
            if byte_val < 0 { byte_val = byte_val + 256 }
            out.data[out.len as usize] = byte_val as i8
            out.len = out.len + 1
        }
    }
    out
}

fn wasm_push_str(buf: WasmBuf, s: string) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        if out.len < 262144 {
            out.data[out.len as usize] = str_char_at(s, i) as i8
            out.len = out.len + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// LEB128 encoding — unsigned and signed
// ============================================================================

// Encode an unsigned 32-bit integer in LEB128 format.
// Each output byte carries 7 data bits; the high bit indicates continuation.
fn wasm_push_u32_leb128(buf: WasmBuf, val: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = val
    // Mask to 32 bits to handle negative i64 representations of u32 values
    if v < 0 { v = v + 4294967296 }
    var done = false
    while !done {
        let low7 = v % 128
        v = v / 128
        if v == 0 {
            out = wasm_push_byte(out, low7)
            done = true
        } else {
            out = wasm_push_byte(out, low7 + 128)
        }
    }
    out
}

// Encode a signed 32-bit integer in LEB128 format.
fn wasm_push_i32_leb128(buf: WasmBuf, val: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = val
    var done = false
    while !done {
        // Extract low 7 bits (handle negative values with masking)
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        // Floor division: Sounio uses truncated div, so (-1/128)=0 not -1.
        // For negative v: floor(v/128) = (v-127)/128 via truncated div.
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        // For negative numbers, v will be -1 eventually
        // Sign bit of the 7-bit value is bit 6 (value 64)
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            // Positive number, no more bytes needed, sign bit is 0
            out = wasm_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            // Negative number, no more bytes needed, sign bit is 1
            out = wasm_push_byte(out, byte_val)
            done = true
        } else {
            // More bytes needed — set continuation bit
            out = wasm_push_byte(out, byte_val + 128)
        }
    }
    out
}

// Encode a signed 64-bit integer in LEB128 format (for i64.const).
fn wasm_push_i64_leb128(buf: WasmBuf, val: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    var v = val
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            out = wasm_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            out = wasm_push_byte(out, byte_val)
            done = true
        } else {
            out = wasm_push_byte(out, byte_val + 128)
        }
    }
    out
}

// ============================================================================
// Helper: compute LEB128 byte length of a u32 value (for size calculations)
// ============================================================================

fn wasm_u32_leb128_len(val: i64) -> i64 with Mut, Panic, Div {
    var v = val
    if v < 0 { v = v + 4294967296 }
    var count: i64 = 0
    var done = false
    while !done {
        v = v / 128
        count = count + 1
        if v == 0 {
            done = true
        }
    }
    count
}

fn wasm_i32_leb128_len(val: i64) -> i64 with Mut, Panic, Div {
    var v = val
    var count: i64 = 0
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        v = v / 128
        count = count + 1
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            done = true
        }
    }
    count
}

fn wasm_i64_leb128_len(val: i64) -> i64 with Mut, Panic, Div {
    // Signed LEB128 byte length for i64 (mirrors wasm_push_i64_leb128 counting logic)
    var v = val
    var count: i64 = 0
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        count = count + 1
        if v == 0 && sign_bit < 64 {
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            done = true
        }
    }
    count
}

// ============================================================================
// Section-level data structures
// ============================================================================

// A single function type: (params...) -> (results...)
struct WasmFuncType {
    params: [i64; 16],
    param_count: i64,
    results: [i64; 4],
    result_count: i64,
}

fn wasm_func_type_new() -> WasmFuncType {
    WasmFuncType {
        params: [0; 16],
        param_count: 0,
        results: [0; 4],
        result_count: 0,
    }
}

fn wasm_func_type_add_param(ft: WasmFuncType, val_type: i64) -> WasmFuncType with Mut, Panic {
    var out = ft
    if out.param_count < 16 {
        out.params[out.param_count as usize] = val_type
        out.param_count = out.param_count + 1
    }
    out
}

fn wasm_func_type_add_result(ft: WasmFuncType, val_type: i64) -> WasmFuncType with Mut, Panic {
    var out = ft
    if out.result_count < 4 {
        out.results[out.result_count as usize] = val_type
        out.result_count = out.result_count + 1
    }
    out
}

// Type section: vector of function types
struct WasmTypeSection {
    types: [WasmFuncType; 256],
    count: i64,
}

fn wasm_type_section_new() -> WasmTypeSection {
    WasmTypeSection {
        types: [WasmFuncType { params: [0; 16], param_count: 0, results: [0; 4], result_count: 0 }; 256],
        count: 0,
    }
}

fn wasm_type_section_add(ts: WasmTypeSection, ft: WasmFuncType) -> WasmTypeSection with Mut, Panic {
    var out = ts
    if out.count < 256 {
        out.types[out.count as usize] = ft
        out.count = out.count + 1
    }
    out
}

// Function section: maps function index to type index
struct WasmFuncSection {
    type_indices: [i64; 256],
    count: i64,
}

fn wasm_func_section_new() -> WasmFuncSection {
    WasmFuncSection { type_indices: [0; 256], count: 0 }
}

fn wasm_func_section_add(fs: WasmFuncSection, type_idx: i64) -> WasmFuncSection with Mut, Panic {
    var out = fs
    if out.count < 256 {
        out.type_indices[out.count as usize] = type_idx
        out.count = out.count + 1
    }
    out
}

// Export entry
struct WasmExport {
    name_buf: [i8; 128],
    name_len: i64,
    kind: i64,
    index: i64,
}

fn wasm_export_new() -> WasmExport {
    WasmExport { name_buf: [0; 128], name_len: 0, kind: 0, index: 0 }
}

fn wasm_export_set_name(exp: WasmExport, name: string) -> WasmExport with Mut, Panic, Div {
    var out = exp
    let n = str_len(name)
    var i: i64 = 0
    while i < n {
        if i < 128 {
            out.name_buf[i as usize] = str_char_at(name, i) as i8
        }
        i = i + 1
    }
    out.name_len = n
    if out.name_len > 128 { out.name_len = 128 }
    out
}

fn wasm_export_func(name: string, func_idx: i64) -> WasmExport with Mut, Panic, Div {
    var exp = wasm_export_new()
    exp = wasm_export_set_name(exp, name)
    exp.kind = WASM_EXPORT_FUNC
    exp.index = func_idx
    exp
}

fn wasm_export_memory(name: string, mem_idx: i64) -> WasmExport with Mut, Panic, Div {
    var exp = wasm_export_new()
    exp = wasm_export_set_name(exp, name)
    exp.kind = WASM_EXPORT_MEMORY
    exp.index = mem_idx
    exp
}

// Export section
struct WasmExportSection {
    exports: [WasmExport; 64],
    count: i64,
}

fn wasm_export_section_new() -> WasmExportSection {
    WasmExportSection {
        exports: [WasmExport { name_buf: [0; 128], name_len: 0, kind: 0, index: 0 }; 64],
        count: 0,
    }
}

fn wasm_export_section_add(es: WasmExportSection, exp: WasmExport) -> WasmExportSection with Mut, Panic {
    var out = es
    if out.count < 64 {
        out.exports[out.count as usize] = exp
        out.count = out.count + 1
    }
    out
}

// ============================================================================
// Import section (ID = 2)
//
// Format:
//   section_id(2) | payload_len(LEB128)
//   count(LEB128)
//   for each import:
//     module_name_len(LEB128) | module_name_bytes...
//     func_name_len(LEB128)   | func_name_bytes...
//     kind(1 byte: 0x00=func)
//     type_index(LEB128)
// ============================================================================

let WASM_IMPORT_KIND_FUNC: i64 = 0
let WASM_IMPORT_MAX: i64 = 64

struct WasmImport {
    module_buf: [i8; 32],
    module_len: i64,
    name_buf:   [i8; 32],
    name_len:   i64,
    type_index: i64,
}

struct WasmImportSection {
    imports: [WasmImport; 64],
    count:   i64,
}

fn wasm_import_new() -> WasmImport {
    WasmImport {
        module_buf: [0; 32],
        module_len: 0,
        name_buf:   [0; 32],
        name_len:   0,
        type_index: 0,
    }
}

fn wasm_import_section_new() -> WasmImportSection {
    WasmImportSection {
        imports: [WasmImport { module_buf: [0; 32], module_len: 0, name_buf: [0; 32], name_len: 0, type_index: 0 }; 64],
        count: 0,
    }
}

fn wasm_import_section_add(sec: WasmImportSection, imp: WasmImport) -> WasmImportSection with Mut, Panic {
    var out = sec
    if out.count < WASM_IMPORT_MAX {
        out.imports[out.count as usize] = imp
        out.count = out.count + 1
    }
    out
}

fn wasm_import_byte_size(imp: WasmImport) -> i64 with Mut, Panic, Div {
    // module_len(LEB128) + module_bytes + name_len(LEB128) + name_bytes + kind(1) + type_idx(LEB128)
    wasm_u32_leb128_len(imp.module_len) + imp.module_len
        + wasm_u32_leb128_len(imp.name_len) + imp.name_len
        + 1
        + wasm_u32_leb128_len(imp.type_index)
}

fn wasm_import_section_payload_size(sec: WasmImportSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(sec.count)
    var i: i64 = 0
    while i < sec.count {
        size = size + wasm_import_byte_size(sec.imports[i as usize])
        i = i + 1
    }
    size
}

fn wasm_emit_import_section(buf: WasmBuf, sec: WasmImportSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if sec.count == 0 { return out }

    let payload_size = wasm_import_section_payload_size(sec)
    out = wasm_emit_section_header(out, WASM_SECTION_IMPORT, payload_size)
    out = wasm_push_u32_leb128(out, sec.count)

    var i: i64 = 0
    while i < sec.count {
        let imp = sec.imports[i as usize]
        // module name length + bytes
        out = wasm_push_u32_leb128(out, imp.module_len)
        var m: i64 = 0
        while m < imp.module_len {
            out = wasm_push_byte(out, imp.module_buf[m as usize] as i64)
            m = m + 1
        }
        // function name length + bytes
        out = wasm_push_u32_leb128(out, imp.name_len)
        var n: i64 = 0
        while n < imp.name_len {
            out = wasm_push_byte(out, imp.name_buf[n as usize] as i64)
            n = n + 1
        }
        // kind = 0x00 (function)
        out = wasm_push_byte(out, WASM_IMPORT_KIND_FUNC)
        // type index
        out = wasm_push_u32_leb128(out, imp.type_index)
        i = i + 1
    }
    out
}

// Local variable declaration within a function body
struct WasmLocal {
    count: i64,
    val_type: i64,
}

fn wasm_local_new(count: i64, val_type: i64) -> WasmLocal {
    WasmLocal { count: count, val_type: val_type }
}

// Function body (code for one function)
struct WasmFuncBody {
    code: [i8; 8192],
    code_len: i64,
    locals: [WasmLocal; 32],
    local_count: i64,
}

fn wasm_func_body_new() -> WasmFuncBody {
    WasmFuncBody {
        code: [0; 8192],
        code_len: 0,
        locals: [WasmLocal { count: 0, val_type: 0 }; 32],
        local_count: 0,
    }
}

// Code section: vector of function bodies
struct WasmCodeSection {
    bodies: [WasmFuncBody; 256],
    count: i64,
}

fn wasm_code_section_new() -> WasmCodeSection {
    WasmCodeSection {
        bodies: [WasmFuncBody {
            code: [0; 8192],
            code_len: 0,
            locals: [WasmLocal { count: 0, val_type: 0 }; 32],
            local_count: 0,
        }; 256],
        count: 0,
    }
}

fn wasm_code_section_add(cs: WasmCodeSection, body: WasmFuncBody) -> WasmCodeSection with Mut, Panic {
    var out = cs
    if out.count < 256 {
        out.bodies[out.count as usize] = body
        out.count = out.count + 1
    }
    out
}

// ============================================================================
// Magic + Version header
// ============================================================================

fn wasm_emit_magic(buf: WasmBuf) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    // \0asm = 0x00 0x61 0x73 0x6D
    out = wasm_push_byte(out, 0x00)
    out = wasm_push_byte(out, 0x61)
    out = wasm_push_byte(out, 0x73)
    out = wasm_push_byte(out, 0x6D)
    // Version 1 = 0x01 0x00 0x00 0x00
    out = wasm_push_byte(out, 0x01)
    out = wasm_push_byte(out, 0x00)
    out = wasm_push_byte(out, 0x00)
    out = wasm_push_byte(out, 0x00)
    out
}

// ============================================================================
// Section header: section_id(1 byte) + payload_len(LEB128)
// ============================================================================

fn wasm_emit_section_header(buf: WasmBuf, section_id: i64, payload_len: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    out = wasm_push_byte(out, section_id)
    out = wasm_push_u32_leb128(out, payload_len)
    out
}

// ============================================================================
// Type section (ID = 1)
//
// Format:
//   section_id(1) | payload_len(LEB128)
//   count(LEB128)
//   for each type:
//     0x60 | param_count(LEB128) | params... | result_count(LEB128) | results...
// ============================================================================

// Compute the byte size of a single func type encoding
fn wasm_func_type_byte_size(ft: WasmFuncType) -> i64 with Mut, Panic, Div {
    // 1 byte for 0x60 marker
    var size: i64 = 1
    // param count (LEB128)
    size = size + wasm_u32_leb128_len(ft.param_count)
    // param types (1 byte each)
    size = size + ft.param_count
    // result count (LEB128)
    size = size + wasm_u32_leb128_len(ft.result_count)
    // result types (1 byte each)
    size = size + ft.result_count
    size
}

// Compute total payload size for the type section
fn wasm_type_section_payload_size(ts: WasmTypeSection) -> i64 with Mut, Panic, Div {
    // count(LEB128)
    var size = wasm_u32_leb128_len(ts.count)
    var i: i64 = 0
    while i < ts.count {
        size = size + wasm_func_type_byte_size(ts.types[i as usize])
        i = i + 1
    }
    size
}

fn wasm_emit_type_section(buf: WasmBuf, types: WasmTypeSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if types.count == 0 { return out }

    let payload_size = wasm_type_section_payload_size(types)
    out = wasm_emit_section_header(out, WASM_SECTION_TYPE, payload_size)

    // Count of types
    out = wasm_push_u32_leb128(out, types.count)

    // Each function type
    var i: i64 = 0
    while i < types.count {
        let ft = types.types[i as usize]
        // 0x60 marker
        out = wasm_push_byte(out, WASM_TYPE_FUNC)
        // Params
        out = wasm_push_u32_leb128(out, ft.param_count)
        var p: i64 = 0
        while p < ft.param_count {
            out = wasm_push_byte(out, ft.params[p as usize])
            p = p + 1
        }
        // Results
        out = wasm_push_u32_leb128(out, ft.result_count)
        var r: i64 = 0
        while r < ft.result_count {
            out = wasm_push_byte(out, ft.results[r as usize])
            r = r + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Function section (ID = 3)
//
// Format:
//   section_id(3) | payload_len(LEB128)
//   count(LEB128)
//   for each function: type_index(LEB128)
// ============================================================================

fn wasm_func_section_payload_size(fs: WasmFuncSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(fs.count)
    var i: i64 = 0
    while i < fs.count {
        size = size + wasm_u32_leb128_len(fs.type_indices[i as usize])
        i = i + 1
    }
    size
}

fn wasm_emit_function_section(buf: WasmBuf, funcs: WasmFuncSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if funcs.count == 0 { return out }

    let payload_size = wasm_func_section_payload_size(funcs)
    out = wasm_emit_section_header(out, WASM_SECTION_FUNCTION, payload_size)

    out = wasm_push_u32_leb128(out, funcs.count)
    var i: i64 = 0
    while i < funcs.count {
        out = wasm_push_u32_leb128(out, funcs.type_indices[i as usize])
        i = i + 1
    }
    out
}

// ============================================================================
// Memory section (ID = 5)
//
// Format:
//   section_id(5) | payload_len(LEB128)
//   count(LEB128) = 1
//   limits_flag(1 byte): 0 = min only, 1 = min + max
//   min_pages(LEB128)
//   [max_pages(LEB128)]  if flag == 1
// ============================================================================

fn wasm_memory_payload_size(min_pages: i64, max_pages: i64) -> i64 with Mut, Panic, Div {
    // count = 1 (LEB128 len)
    var size = wasm_u32_leb128_len(1)
    if max_pages > 0 {
        // flag(1) + min(LEB128) + max(LEB128)
        size = size + 1 + wasm_u32_leb128_len(min_pages) + wasm_u32_leb128_len(max_pages)
    } else {
        // flag(1) + min(LEB128)
        size = size + 1 + wasm_u32_leb128_len(min_pages)
    }
    size
}

fn wasm_emit_memory_section(buf: WasmBuf, min_pages: i64, max_pages: i64) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    let payload_size = wasm_memory_payload_size(min_pages, max_pages)
    out = wasm_emit_section_header(out, WASM_SECTION_MEMORY, payload_size)

    // Count of memories (always 1 in MVP)
    out = wasm_push_u32_leb128(out, 1)

    if max_pages > 0 {
        // Limits with max
        out = wasm_push_byte(out, 0x01)
        out = wasm_push_u32_leb128(out, min_pages)
        out = wasm_push_u32_leb128(out, max_pages)
    } else {
        // Limits without max
        out = wasm_push_byte(out, 0x00)
        out = wasm_push_u32_leb128(out, min_pages)
    }
    out
}

// ============================================================================
// Export section (ID = 7)
//
// Format:
//   section_id(7) | payload_len(LEB128)
//   count(LEB128)
//   for each export:
//     name_len(LEB128) | name(bytes) | kind(1 byte) | index(LEB128)
// ============================================================================

fn wasm_export_byte_size(exp: WasmExport) -> i64 with Mut, Panic, Div {
    // name_len(LEB128) + name_bytes + kind(1) + index(LEB128)
    var size = wasm_u32_leb128_len(exp.name_len)
    size = size + exp.name_len
    size = size + 1  // kind
    size = size + wasm_u32_leb128_len(exp.index)
    size
}

fn wasm_export_section_payload_size(es: WasmExportSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(es.count)
    var i: i64 = 0
    while i < es.count {
        size = size + wasm_export_byte_size(es.exports[i as usize])
        i = i + 1
    }
    size
}

fn wasm_emit_export_section(buf: WasmBuf, exports: WasmExportSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if exports.count == 0 { return out }

    let payload_size = wasm_export_section_payload_size(exports)
    out = wasm_emit_section_header(out, WASM_SECTION_EXPORT, payload_size)

    out = wasm_push_u32_leb128(out, exports.count)
    var i: i64 = 0
    while i < exports.count {
        let exp = exports.exports[i as usize]
        // Name (length-prefixed UTF-8)
        out = wasm_push_u32_leb128(out, exp.name_len)
        var j: i64 = 0
        while j < exp.name_len {
            out = wasm_push_byte(out, exp.name_buf[j as usize] as i64)
            j = j + 1
        }
        // Kind
        out = wasm_push_byte(out, exp.kind)
        // Index
        out = wasm_push_u32_leb128(out, exp.index)
        i = i + 1
    }
    out
}

// ============================================================================
// Code section (ID = 10)
//
// Format:
//   section_id(10) | payload_len(LEB128)
//   count(LEB128)
//   for each function body:
//     body_size(LEB128)
//     local_decl_count(LEB128)
//     for each local decl: count(LEB128) | type(1 byte)
//     code bytes (instructions)
// ============================================================================

// Compute byte size of a single function body entry (locals + code)
fn wasm_func_body_inner_size(body: WasmFuncBody) -> i64 with Mut, Panic, Div {
    // local_decl_count(LEB128)
    var size = wasm_u32_leb128_len(body.local_count)
    // each local decl: count(LEB128) + type(1 byte)
    var i: i64 = 0
    while i < body.local_count {
        size = size + wasm_u32_leb128_len(body.locals[i as usize].count)
        size = size + 1  // val_type
        i = i + 1
    }
    // instruction bytes
    size = size + body.code_len
    size
}

fn wasm_code_section_payload_size(cs: WasmCodeSection) -> i64 with Mut, Panic, Div {
    // count(LEB128)
    var size = wasm_u32_leb128_len(cs.count)
    var i: i64 = 0
    while i < cs.count {
        let inner = wasm_func_body_inner_size(cs.bodies[i as usize])
        // body_size(LEB128) + inner bytes
        size = size + wasm_u32_leb128_len(inner) + inner
        i = i + 1
    }
    size
}

fn wasm_emit_code_section(buf: WasmBuf, bodies: WasmCodeSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if bodies.count == 0 { return out }

    let payload_size = wasm_code_section_payload_size(bodies)
    out = wasm_emit_section_header(out, WASM_SECTION_CODE, payload_size)

    // Count of function bodies
    out = wasm_push_u32_leb128(out, bodies.count)

    var i: i64 = 0
    while i < bodies.count {
        let body = bodies.bodies[i as usize]
        let inner_size = wasm_func_body_inner_size(body)

        // Body size (LEB128)
        out = wasm_push_u32_leb128(out, inner_size)

        // Local declarations
        out = wasm_push_u32_leb128(out, body.local_count)
        var lc: i64 = 0
        while lc < body.local_count {
            out = wasm_push_u32_leb128(out, body.locals[lc as usize].count)
            out = wasm_push_byte(out, body.locals[lc as usize].val_type)
            lc = lc + 1
        }

        // Instruction bytes
        var ci: i64 = 0
        while ci < body.code_len {
            out = wasm_push_byte(out, body.code[ci as usize] as i64)
            ci = ci + 1
        }

        i = i + 1
    }
    out
}

// ============================================================================
// Global section (ID = 6)
//
// Holds mutable i64 globals.  We use one global (index 0) as the heap bump
// pointer, initialized to the address just past the data section.
//
// Format:
//   section_id(6) | payload_len(LEB128)
//   count(LEB128)
//   for each global:
//     val_type(1 byte: 0x7E=i64)
//     mutability(1 byte: 0=const, 1=mutable)
//     init_expr: i64.const(0x42) val(LEB128) end(0x0B)
// ============================================================================

let WASM_GLOBAL_MUTABLE: i64 = 1

// A single i64 mutable global with a known initial value.
struct WasmGlobal {
    init_val: i64,
}

struct WasmGlobalSection {
    globals: [WasmGlobal; 8],
    count:   i64,
}

fn wasm_global_section_new() -> WasmGlobalSection {
    WasmGlobalSection {
        globals: [WasmGlobal { init_val: 0 }; 8],
        count: 0,
    }
}

fn wasm_global_section_add(sec: WasmGlobalSection, init_val: i64) -> WasmGlobalSection with Mut, Panic {
    var out = sec
    if out.count < 8 {
        out.globals[out.count as usize] = WasmGlobal { init_val: init_val }
        out.count = out.count + 1
    }
    out
}

fn wasm_global_entry_byte_size(g: WasmGlobal) -> i64 with Mut, Panic, Div {
    // val_type(1) + mutability(1) + i64.const(1) + val(LEB128) + end(1)
    4 + wasm_i64_leb128_len(g.init_val)
}

fn wasm_global_section_payload_size(sec: WasmGlobalSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(sec.count)
    var i: i64 = 0
    while i < sec.count {
        size = size + wasm_global_entry_byte_size(sec.globals[i as usize])
        i = i + 1
    }
    size
}

fn wasm_emit_global_section(buf: WasmBuf, sec: WasmGlobalSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if sec.count == 0 { return out }

    let payload_size = wasm_global_section_payload_size(sec)
    out = wasm_emit_section_header(out, WASM_SECTION_GLOBAL, payload_size)
    out = wasm_push_u32_leb128(out, sec.count)

    var i: i64 = 0
    while i < sec.count {
        let g = sec.globals[i as usize]
        out = wasm_push_byte(out, WASM_TYPE_I64)        // val_type = i64
        out = wasm_push_byte(out, WASM_GLOBAL_MUTABLE)  // mutable = 1
        out = wasm_push_byte(out, 0x42)                 // i64.const opcode
        out = wasm_push_i64_leb128(out, g.init_val)    // initial value
        out = wasm_push_byte(out, 0x0B)                 // end
        i = i + 1
    }
    out
}

// ============================================================================
// Data section (ID = 11)
//
// Holds constant byte strings placed in linear memory at load time.
// Each segment specifies: memory_index(0) | offset_expr | byte_count | bytes...
//
// Format (MVP active data segment):
//   section_id(11) | payload_len(LEB128)
//   count(LEB128)
//   for each segment:
//     kind(LEB128, 0 = active, memory 0, i32.const offset)
//     offset_expr: i32.const(0x41) offset(LEB128) end(0x0B)
//     byte_count(LEB128)
//     bytes...
// ============================================================================

let WASM_DATA_MAX_BYTES: i64 = 65536

struct WasmDataSection {
    data:       [i8; 65536],
    data_len:   i64,
    seg_count:  i64,          // number of segments (each string = one segment)
    seg_offset: [i64; 512],   // seg_offset[i] = byte offset of segment i in data[]
    seg_len:    [i64; 512],   // seg_len[i]    = byte count of segment i
}

fn wasm_data_section_new() -> WasmDataSection {
    WasmDataSection {
        data:       [0; 65536],
        data_len:   0,
        seg_count:  0,
        seg_offset: [0; 512],
        seg_len:    [0; 512],
    }
}

// Add a Name's bytes as a new data segment at the current offset.
// Returns updated section.  The segment is null-terminated.
fn wasm_data_section_add_name(sec: WasmDataSection, name: Name) -> WasmDataSection with Mut, Panic, Div {
    var out = sec
    if out.seg_count >= 512 { return out }
    let seg_idx = out.seg_count
    out.seg_offset[seg_idx as usize] = out.data_len
    var i: i64 = 0
    while i < name.len && out.data_len < WASM_DATA_MAX_BYTES {
        out.data[out.data_len as usize] = name.buf[i as usize]
        out.data_len = out.data_len + 1
        i = i + 1
    }
    // null terminator
    if out.data_len < WASM_DATA_MAX_BYTES {
        out.data[out.data_len as usize] = 0
        out.data_len = out.data_len + 1
    }
    out.seg_len[seg_idx as usize] = name.len + 1  // include null terminator
    out.seg_count = out.seg_count + 1
    out
}

fn wasm_data_segment_header_size(seg_offset: i64, seg_len: i64) -> i64 with Mut, Panic, Div {
    // kind(1) + i32.const(1) + offset(LEB128) + end(1) + byte_count(LEB128)
    1 + 1 + wasm_u32_leb128_len(seg_offset) + 1 + wasm_u32_leb128_len(seg_len)
}

fn wasm_data_section_payload_size(sec: WasmDataSection) -> i64 with Mut, Panic, Div {
    var size = wasm_u32_leb128_len(sec.seg_count)
    var i: i64 = 0
    while i < sec.seg_count {
        let soff = sec.seg_offset[i as usize]
        let slen = sec.seg_len[i as usize]
        size = size + wasm_data_segment_header_size(soff, slen) + slen
        i = i + 1
    }
    size
}

fn wasm_emit_data_section(buf: WasmBuf, sec: WasmDataSection) -> WasmBuf with Mut, Panic, Div {
    var out = buf
    if sec.seg_count == 0 { return out }

    let payload_size = wasm_data_section_payload_size(sec)
    out = wasm_emit_section_header(out, WASM_SECTION_DATA, payload_size)
    out = wasm_push_u32_leb128(out, sec.seg_count)

    var i: i64 = 0
    while i < sec.seg_count {
        let soff = sec.seg_offset[i as usize]
        let slen = sec.seg_len[i as usize]
        // kind = 0 (active, memory 0, i32.const offset)
        out = wasm_push_u32_leb128(out, 0)
        // offset expression: i32.const <soff> end
        out = wasm_push_byte(out, 0x41)             // i32.const
        out = wasm_push_u32_leb128(out, soff)       // offset value
        out = wasm_push_byte(out, 0x0B)             // end
        // byte count
        out = wasm_push_u32_leb128(out, slen)
        // bytes
        var b: i64 = soff
        while b < soff + slen {
            out = wasm_push_byte(out, sec.data[b as usize] as i64)
            b = b + 1
        }
        i = i + 1
    }
    out
}

// ============================================================================
// Full module assembly
// ============================================================================

fn wasm_emit_full_module(
    types: WasmTypeSection,
    imports: WasmImportSection,
    funcs: WasmFuncSection,
    globals: WasmGlobalSection,
    min_pages: i64,
    max_pages: i64,
    exports: WasmExportSection,
    code: WasmCodeSection,
    data: WasmDataSection
) -> WasmBuf with Mut, Panic, Div {
    var buf = wasm_buf_new()

    // 1. Magic + version
    buf = wasm_emit_magic(buf)

    // 2. Type section (types for both imports and local functions)
    buf = wasm_emit_type_section(buf, types)

    // 3. Import section (before function section — WASM spec ordering)
    buf = wasm_emit_import_section(buf, imports)

    // 4. Function section (local functions only; indices offset by import count)
    buf = wasm_emit_function_section(buf, funcs)

    // 5. Memory section (skip if min_pages == 0 and max_pages == 0)
    if min_pages > 0 || max_pages > 0 {
        buf = wasm_emit_memory_section(buf, min_pages, max_pages)
    }

    // 6. Global section (heap bump pointer + any other globals)
    buf = wasm_emit_global_section(buf, globals)

    // 7. Export section
    buf = wasm_emit_export_section(buf, exports)

    // 8. Code section (local functions only)
    buf = wasm_emit_code_section(buf, code)

    // 9. Data section (string literals in linear memory)
    buf = wasm_emit_data_section(buf, data)

    buf
}

// ============================================================================
// Buffer inspection helpers (for testing)
// ============================================================================

fn wasm_buf_byte_at(buf: WasmBuf, idx: i64) -> i64 with Mut, Panic {
    if idx < 0 { return 0 }
    if idx >= buf.len { return 0 }
    let raw = buf.data[idx as usize] as i64
    // Ensure unsigned interpretation
    if raw < 0 { return raw + 256 }
    raw
}

fn wasm_buf_contains_bytes(buf: WasmBuf, offset: i64, expected: [i64; 16], expected_len: i64) -> bool with Mut, Panic, Div {
    if offset + expected_len > buf.len { return false }
    var i: i64 = 0
    while i < expected_len {
        let actual = wasm_buf_byte_at(buf, offset + i)
        if actual != expected[i as usize] {
            return false
        }
        i = i + 1
    }
    true
}

// ============================================================================
// Inline tests
// ============================================================================

fn test_wasm_leb128_zero() -> bool with Mut, Panic, Div {
    // LEB128 of 0 should be a single byte: 0x00
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 0)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 0
}

fn test_wasm_leb128_small() -> bool with Mut, Panic, Div {
    // LEB128 of 42 fits in one byte: 0x2A
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 42)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 42
}

fn test_wasm_leb128_127() -> bool with Mut, Panic, Div {
    // LEB128 of 127 fits in one byte: 0x7F
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 127)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 127
}

fn test_wasm_leb128_128() -> bool with Mut, Panic, Div {
    // LEB128 of 128 requires two bytes: 0x80 0x01
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 128)
    buf.len == 2 && wasm_buf_byte_at(buf, 0) == 128 && wasm_buf_byte_at(buf, 1) == 1
}

fn test_wasm_leb128_624485() -> bool with Mut, Panic, Div {
    // Classic test: 624485 -> 0xE5 0x8E 0x26
    var buf = wasm_buf_new()
    buf = wasm_push_u32_leb128(buf, 624485)
    buf.len == 3
        && wasm_buf_byte_at(buf, 0) == 0xE5
        && wasm_buf_byte_at(buf, 1) == 0x8E
        && wasm_buf_byte_at(buf, 2) == 0x26
}

fn test_wasm_signed_leb128_neg1() -> bool with Mut, Panic, Div {
    // Signed LEB128 of -1 should be a single byte: 0x7F
    var buf = wasm_buf_new()
    buf = wasm_push_i32_leb128(buf, 0 - 1)
    buf.len == 1 && wasm_buf_byte_at(buf, 0) == 0x7F
}

fn test_wasm_signed_leb128_neg128() -> bool with Mut, Panic, Div {
    // Signed LEB128 of -128 should be: 0x80 0x7F
    var buf = wasm_buf_new()
    buf = wasm_push_i32_leb128(buf, 0 - 128)
    buf.len == 2
        && wasm_buf_byte_at(buf, 0) == 0x80
        && wasm_buf_byte_at(buf, 1) == 0x7F
}

fn test_wasm_magic_header() -> bool with Mut, Panic, Div {
    // WASM magic: 00 61 73 6D 01 00 00 00
    var buf = wasm_buf_new()
    buf = wasm_emit_magic(buf)
    buf.len == 8
        && wasm_buf_byte_at(buf, 0) == 0x00
        && wasm_buf_byte_at(buf, 1) == 0x61
        && wasm_buf_byte_at(buf, 2) == 0x73
        && wasm_buf_byte_at(buf, 3) == 0x6D
        && wasm_buf_byte_at(buf, 4) == 0x01
        && wasm_buf_byte_at(buf, 5) == 0x00
        && wasm_buf_byte_at(buf, 6) == 0x00
        && wasm_buf_byte_at(buf, 7) == 0x00
}

fn test_wasm_type_section_single() -> bool with Mut, Panic, Div {
    // Type section with one func type: (i32, i32) -> i32
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var buf = wasm_buf_new()
    buf = wasm_emit_type_section(buf, ts)

    // Section header: 0x01 (type section ID)
    // Payload: count(1) + 0x60 + param_count(2) + i32 i32 + result_count(1) + i32
    // Payload size = 1 + 1 + 1 + 2 + 1 + 1 = 7
    // Total bytes: 1(section_id) + 1(payload_len=7) + 7 = 9
    buf.len == 9
        && wasm_buf_byte_at(buf, 0) == 0x01      // section id
        && wasm_buf_byte_at(buf, 1) == 7          // payload length
        && wasm_buf_byte_at(buf, 2) == 1          // type count
        && wasm_buf_byte_at(buf, 3) == 0x60       // func type marker
        && wasm_buf_byte_at(buf, 4) == 2          // param count
        && wasm_buf_byte_at(buf, 5) == 0x7F       // i32
        && wasm_buf_byte_at(buf, 6) == 0x7F       // i32
        && wasm_buf_byte_at(buf, 7) == 1          // result count
        && wasm_buf_byte_at(buf, 8) == 0x7F       // i32
}

fn test_wasm_memory_section_min_only() -> bool with Mut, Panic, Div {
    // Memory section with min=1, no max
    var buf = wasm_buf_new()
    buf = wasm_emit_memory_section(buf, 1, 0)

    // Section header: 0x05, payload_len
    // Payload: count(1) + flag(0x00) + min(1)
    // Payload size = 1 + 1 + 1 = 3
    // Total: 1 + 1 + 3 = 5
    buf.len == 5
        && wasm_buf_byte_at(buf, 0) == 0x05      // section id
        && wasm_buf_byte_at(buf, 1) == 3          // payload length
        && wasm_buf_byte_at(buf, 2) == 1          // memory count
        && wasm_buf_byte_at(buf, 3) == 0x00       // limits flag (min only)
        && wasm_buf_byte_at(buf, 4) == 1          // min pages
}

fn test_wasm_memory_section_min_max() -> bool with Mut, Panic, Div {
    // Memory section with min=1, max=10
    var buf = wasm_buf_new()
    buf = wasm_emit_memory_section(buf, 1, 10)

    // Payload: count(1) + flag(0x01) + min(1) + max(10)
    // Payload size = 1 + 1 + 1 + 1 = 4
    // Total: 1 + 1 + 4 = 6
    buf.len == 6
        && wasm_buf_byte_at(buf, 0) == 0x05
        && wasm_buf_byte_at(buf, 1) == 4
        && wasm_buf_byte_at(buf, 2) == 1
        && wasm_buf_byte_at(buf, 3) == 0x01       // limits flag (min+max)
        && wasm_buf_byte_at(buf, 4) == 1           // min
        && wasm_buf_byte_at(buf, 5) == 10          // max
}

fn test_wasm_export_section_func() -> bool with Mut, Panic, Div {
    // Export "add" as function index 0
    var es = wasm_export_section_new()
    let exp = wasm_export_func("add", 0)
    es = wasm_export_section_add(es, exp)

    var buf = wasm_buf_new()
    buf = wasm_emit_export_section(buf, es)

    // Section header: 0x07, payload_len
    // Payload: count(1) + name_len(3) + "add" + kind(0x00) + index(0)
    // Payload size = 1 + 1 + 3 + 1 + 1 = 7
    buf.len == 9
        && wasm_buf_byte_at(buf, 0) == 0x07       // section id
        && wasm_buf_byte_at(buf, 1) == 7           // payload length
        && wasm_buf_byte_at(buf, 2) == 1           // export count
        && wasm_buf_byte_at(buf, 3) == 3           // name length
        && wasm_buf_byte_at(buf, 4) == 0x61        // 'a'
        && wasm_buf_byte_at(buf, 5) == 0x64        // 'd'
        && wasm_buf_byte_at(buf, 6) == 0x64        // 'd'
        && wasm_buf_byte_at(buf, 7) == 0x00        // kind = func
        && wasm_buf_byte_at(buf, 8) == 0x00        // index = 0
}

fn test_wasm_function_section() -> bool with Mut, Panic, Div {
    // Function section: two functions, both using type index 0
    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)
    fs = wasm_func_section_add(fs, 0)

    var buf = wasm_buf_new()
    buf = wasm_emit_function_section(buf, fs)

    // Section header: 0x03, payload_len
    // Payload: count(2) + type_idx(0) + type_idx(0) = 1 + 1 + 1 = 3
    buf.len == 5
        && wasm_buf_byte_at(buf, 0) == 0x03       // section id
        && wasm_buf_byte_at(buf, 1) == 3           // payload length
        && wasm_buf_byte_at(buf, 2) == 2           // function count
        && wasm_buf_byte_at(buf, 3) == 0           // type index 0
        && wasm_buf_byte_at(buf, 4) == 0           // type index 0
}

fn test_wasm_full_module_header() -> bool with Mut, Panic, Div {
    // Build a minimal module: one function (i32, i32) -> i32 that does i32.add
    var ft = wasm_func_type_new()
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_param(ft, WASM_TYPE_I32)
    ft = wasm_func_type_add_result(ft, WASM_TYPE_I32)

    var ts = wasm_type_section_new()
    ts = wasm_type_section_add(ts, ft)

    var fs = wasm_func_section_new()
    fs = wasm_func_section_add(fs, 0)

    var es = wasm_export_section_new()
    es = wasm_export_section_add(es, wasm_export_func("add", 0))

    // Function body: local.get 0, local.get 1, i32.add, end
    var body = wasm_func_body_new()
    // Emit instructions into body.code
    body.code[0 as usize] = 0x20 as i8  // local.get
    body.code[1 as usize] = 0x00 as i8  // index 0
    body.code[2 as usize] = 0x20 as i8  // local.get
    body.code[3 as usize] = 0x01 as i8  // index 1
    body.code[4 as usize] = 0x6A as i8  // i32.add
    body.code[5 as usize] = 0x0B as i8  // end
    body.code_len = 6

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    let module = wasm_emit_full_module(ts, wasm_import_section_new(), fs, wasm_global_section_new(), 1, 0, es, cs, wasm_data_section_new())

    // Verify magic + version at start
    module.len > 8
        && wasm_buf_byte_at(module, 0) == 0x00
        && wasm_buf_byte_at(module, 1) == 0x61
        && wasm_buf_byte_at(module, 2) == 0x73
        && wasm_buf_byte_at(module, 3) == 0x6D
        && wasm_buf_byte_at(module, 4) == 0x01
}

fn test_wasm_leb128_len_helper() -> bool with Mut, Panic, Div {
    // Verify the u32_leb128_len helper
    wasm_u32_leb128_len(0) == 1
        && wasm_u32_leb128_len(1) == 1
        && wasm_u32_leb128_len(127) == 1
        && wasm_u32_leb128_len(128) == 2
        && wasm_u32_leb128_len(16383) == 2
        && wasm_u32_leb128_len(16384) == 3
}

fn test_wasm_signed_leb128_positive() -> bool with Mut, Panic, Div {
    // Signed LEB128 of 63 fits in one byte: 0x3F
    // Signed LEB128 of 64 requires two bytes: 0xC0 0x00
    var buf1 = wasm_buf_new()
    buf1 = wasm_push_i32_leb128(buf1, 63)

    var buf2 = wasm_buf_new()
    buf2 = wasm_push_i32_leb128(buf2, 64)

    buf1.len == 1 && wasm_buf_byte_at(buf1, 0) == 63
        && buf2.len == 2 && wasm_buf_byte_at(buf2, 0) == 0xC0 && wasm_buf_byte_at(buf2, 1) == 0x00
}

fn test_wasm_code_section_simple() -> bool with Mut, Panic, Div {
    // A function body with no locals, just [i32.const 42, end]
    var body = wasm_func_body_new()
    body.code[0 as usize] = 0x41 as i8  // i32.const
    body.code[1 as usize] = 42 as i8    // 42 (signed LEB128)
    body.code[2 as usize] = 0x0B as i8  // end
    body.code_len = 3

    var cs = wasm_code_section_new()
    cs = wasm_code_section_add(cs, body)

    var buf = wasm_buf_new()
    buf = wasm_emit_code_section(buf, cs)

    // Section header: 0x0A, payload
    // Payload: count(1) + body_size(LEB128) + local_count(0) + code(3 bytes)
    // inner_size = 1(local_count=0) + 3(code) = 4
    // Payload = 1(count) + 1(body_size=4) + 4(inner) = 6
    // Total: 1(section) + 1(payload_len=6) + 6 = 8
    buf.len == 8
        && wasm_buf_byte_at(buf, 0) == 0x0A       // section id = 10
        && wasm_buf_byte_at(buf, 1) == 6           // payload length
        && wasm_buf_byte_at(buf, 2) == 1           // body count
        && wasm_buf_byte_at(buf, 3) == 4           // body size (inner)
        && wasm_buf_byte_at(buf, 4) == 0           // local decl count
        && wasm_buf_byte_at(buf, 5) == 0x41        // i32.const
        && wasm_buf_byte_at(buf, 6) == 42          // 42
        && wasm_buf_byte_at(buf, 7) == 0x0B        // end
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/wasm/encode.sio  (1264 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::wasm::encode — WebAssembly opcode emitters for function bodies
//
// Emits WASM instructions into a WasmFuncBody buffer.  Each emitter appends
// the opcode byte (and any immediate operands encoded as LEB128) to the
// body's code array, then returns the mutated body.
//
// Opcode reference: WebAssembly MVP specification, Section 5.4.
//
// Encoding conventions:
//   - Single-byte opcodes: push 1 byte.
//   - Opcodes with u32 immediate (local.get, call, br, etc.): opcode + u32 LEB128.
//   - Opcodes with i32/i64 immediate (i32.const, i64.const): opcode + signed LEB128.
//   - Memory opcodes (i32.load, etc.): opcode + alignment(LEB128) + offset(LEB128).
//   - Block-structured (block, loop, if): opcode + blocktype byte.
//     blocktype: 0x40 = void, 0x7F = i32, 0x7E = i64, etc.


// ============================================================================
// WASM opcode constants
// ============================================================================

// Control flow
let WASM_OP_UNREACHABLE: i64 = 0x00
let WASM_OP_NOP: i64 = 0x01
let WASM_OP_BLOCK: i64 = 0x02
let WASM_OP_LOOP: i64 = 0x03
let WASM_OP_IF: i64 = 0x04
let WASM_OP_ELSE: i64 = 0x05
let WASM_OP_END: i64 = 0x0B
let WASM_OP_BR: i64 = 0x0C
let WASM_OP_BR_IF: i64 = 0x0D
let WASM_OP_BR_TABLE: i64 = 0x0E
let WASM_OP_RETURN: i64 = 0x0F
let WASM_OP_CALL: i64 = 0x10
let WASM_OP_CALL_INDIRECT: i64 = 0x11

// Variable access
let WASM_OP_LOCAL_GET: i64 = 0x20
let WASM_OP_LOCAL_SET: i64 = 0x21
let WASM_OP_LOCAL_TEE: i64 = 0x22
let WASM_OP_GLOBAL_GET: i64 = 0x23
let WASM_OP_GLOBAL_SET: i64 = 0x24

// Memory access
let WASM_OP_I32_LOAD: i64 = 0x28
let WASM_OP_I64_LOAD: i64 = 0x29
let WASM_OP_F32_LOAD: i64 = 0x2A
let WASM_OP_F64_LOAD: i64 = 0x2B
let WASM_OP_I32_STORE: i64 = 0x36
let WASM_OP_I64_STORE: i64 = 0x37
let WASM_OP_F32_STORE: i64 = 0x38
let WASM_OP_F64_STORE: i64 = 0x39
let WASM_OP_MEMORY_SIZE: i64 = 0x3F
let WASM_OP_MEMORY_GROW: i64 = 0x40

// I32 load sub-widths
let WASM_OP_I32_LOAD8_S: i64 = 0x2C
let WASM_OP_I32_LOAD8_U: i64 = 0x2D
let WASM_OP_I32_LOAD16_S: i64 = 0x2E
let WASM_OP_I32_LOAD16_U: i64 = 0x2F

// I32 store sub-widths
let WASM_OP_I32_STORE8: i64 = 0x3A
let WASM_OP_I32_STORE16: i64 = 0x3B

// Constants
let WASM_OP_I32_CONST: i64 = 0x41
let WASM_OP_I64_CONST: i64 = 0x42
let WASM_OP_F32_CONST: i64 = 0x43
let WASM_OP_F64_CONST: i64 = 0x44

// i32 comparison
let WASM_OP_I32_EQZ: i64 = 0x45
let WASM_OP_I32_EQ: i64 = 0x46
let WASM_OP_I32_NE: i64 = 0x47
let WASM_OP_I32_LT_S: i64 = 0x48
let WASM_OP_I32_LT_U: i64 = 0x49
let WASM_OP_I32_GT_S: i64 = 0x4A
let WASM_OP_I32_GT_U: i64 = 0x4B
let WASM_OP_I32_LE_S: i64 = 0x4C
let WASM_OP_I32_LE_U: i64 = 0x4D
let WASM_OP_I32_GE_S: i64 = 0x4E
let WASM_OP_I32_GE_U: i64 = 0x4F

// i64 comparison
let WASM_OP_I64_EQZ: i64 = 0x50
let WASM_OP_I64_EQ: i64 = 0x51
let WASM_OP_I64_NE: i64 = 0x52
let WASM_OP_I64_LT_S: i64 = 0x53
let WASM_OP_I64_GT_S: i64 = 0x55
let WASM_OP_I64_LE_S: i64 = 0x57
let WASM_OP_I64_GE_S: i64 = 0x59

// f64 comparison
let WASM_OP_F64_EQ: i64 = 0x61
let WASM_OP_F64_NE: i64 = 0x62
let WASM_OP_F64_LT: i64 = 0x63
let WASM_OP_F64_GT: i64 = 0x64
let WASM_OP_F64_LE: i64 = 0x65
let WASM_OP_F64_GE: i64 = 0x66

// i32 arithmetic
let WASM_OP_I32_CLZ: i64 = 0x67
let WASM_OP_I32_CTZ: i64 = 0x68
let WASM_OP_I32_POPCNT: i64 = 0x69
let WASM_OP_I32_ADD: i64 = 0x6A
let WASM_OP_I32_SUB: i64 = 0x6B
let WASM_OP_I32_MUL: i64 = 0x6C
let WASM_OP_I32_DIV_S: i64 = 0x6D
let WASM_OP_I32_DIV_U: i64 = 0x6E
let WASM_OP_I32_REM_S: i64 = 0x6F
let WASM_OP_I32_REM_U: i64 = 0x70
let WASM_OP_I32_AND: i64 = 0x71
let WASM_OP_I32_OR: i64 = 0x72
let WASM_OP_I32_XOR: i64 = 0x73
let WASM_OP_I32_SHL: i64 = 0x74
let WASM_OP_I32_SHR_S: i64 = 0x75
let WASM_OP_I32_SHR_U: i64 = 0x76
let WASM_OP_I32_ROTL: i64 = 0x77
let WASM_OP_I32_ROTR: i64 = 0x78

// i64 arithmetic
let WASM_OP_I64_CLZ: i64 = 0x79
let WASM_OP_I64_CTZ: i64 = 0x7A
let WASM_OP_I64_POPCNT: i64 = 0x7B
let WASM_OP_I64_ADD: i64 = 0x7C
let WASM_OP_I64_SUB: i64 = 0x7D
let WASM_OP_I64_MUL: i64 = 0x7E
let WASM_OP_I64_DIV_S: i64 = 0x7F
let WASM_OP_I64_DIV_U: i64 = 0x80
let WASM_OP_I64_REM_S: i64 = 0x81
let WASM_OP_I64_REM_U: i64 = 0x82
let WASM_OP_I64_AND: i64 = 0x83
let WASM_OP_I64_OR: i64 = 0x84
let WASM_OP_I64_XOR: i64 = 0x85
let WASM_OP_I64_SHL: i64 = 0x86
let WASM_OP_I64_SHR_S: i64 = 0x87

// f32 arithmetic
let WASM_OP_F32_ABS: i64 = 0x8B
let WASM_OP_F32_NEG: i64 = 0x8C
let WASM_OP_F32_SQRT: i64 = 0x91
let WASM_OP_F32_ADD: i64 = 0x92
let WASM_OP_F32_SUB: i64 = 0x93
let WASM_OP_F32_MUL: i64 = 0x94
let WASM_OP_F32_DIV: i64 = 0x95

// f64 arithmetic
let WASM_OP_F64_ABS: i64 = 0x99
let WASM_OP_F64_NEG: i64 = 0x9A
let WASM_OP_F64_CEIL: i64 = 0x9B
let WASM_OP_F64_FLOOR: i64 = 0x9C
let WASM_OP_F64_TRUNC: i64 = 0x9D
let WASM_OP_F64_NEAREST: i64 = 0x9E
let WASM_OP_F64_SQRT: i64 = 0x9F
let WASM_OP_F64_ADD: i64 = 0xA0
let WASM_OP_F64_SUB: i64 = 0xA1
let WASM_OP_F64_MUL: i64 = 0xA2
let WASM_OP_F64_DIV: i64 = 0xA3
let WASM_OP_F64_MIN: i64 = 0xA4
let WASM_OP_F64_MAX: i64 = 0xA5

// Conversions
let WASM_OP_I32_WRAP_I64: i64 = 0xA7
let WASM_OP_I32_TRUNC_F32_S: i64 = 0xA8
let WASM_OP_I32_TRUNC_F64_S: i64 = 0xAA
let WASM_OP_I64_EXTEND_I32_S: i64 = 0xAC
let WASM_OP_I64_EXTEND_I32_U: i64 = 0xAD
let WASM_OP_I64_TRUNC_F64_S: i64 = 0xB0
let WASM_OP_F32_CONVERT_I32_S: i64 = 0xB2
let WASM_OP_F32_CONVERT_I64_S: i64 = 0xB4
let WASM_OP_F32_DEMOTE_F64: i64 = 0xB6
let WASM_OP_F64_CONVERT_I32_S: i64 = 0xB7
let WASM_OP_F64_CONVERT_I64_S: i64 = 0xB9
let WASM_OP_F64_PROMOTE_F32: i64 = 0xBB
let WASM_OP_I32_REINTERPRET_F32: i64 = 0xBC
let WASM_OP_I64_REINTERPRET_F64: i64 = 0xBD
let WASM_OP_F32_REINTERPRET_I32: i64 = 0xBE
let WASM_OP_F64_REINTERPRET_I64: i64 = 0xBF

// Block type for void blocks
let WASM_BLOCK_VOID: i64 = 0x40

// Drop and select
let WASM_OP_DROP: i64 = 0x1A
let WASM_OP_SELECT: i64 = 0x1B

// ============================================================================
// WasmFuncBody constructors and helpers
// ============================================================================

fn wasm_body_new() -> WasmFuncBody {
    WasmFuncBody {
        code: [0; 8192],
        code_len: 0,
        locals: [WasmLocal { count: 0, val_type: 0 }; 32],
        local_count: 0,
    }
}

// Push a raw byte into the function body code buffer
fn wasm_body_push_byte(body: WasmFuncBody, b: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    if out.code_len < 8192 {
        let masked = b % 256
        var byte_val = masked
        if byte_val < 0 { byte_val = byte_val + 256 }
        out.code[out.code_len as usize] = byte_val as i8
        out.code_len = out.code_len + 1
    }
    out
}

// Push unsigned LEB128 into the body code buffer
fn wasm_body_push_u32_leb128(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    var v = val
    if v < 0 { v = v + 4294967296 }
    var done = false
    while !done {
        let low7 = v % 128
        v = v / 128
        if v == 0 {
            out = wasm_body_push_byte(out, low7)
            done = true
        } else {
            out = wasm_body_push_byte(out, low7 + 128)
        }
    }
    out
}

// Push signed LEB128 (i32) into the body code buffer
fn wasm_body_push_i32_leb128(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    var v = val
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else {
            out = wasm_body_push_byte(out, byte_val + 128)
        }
    }
    out
}

// Push signed LEB128 (i64) into the body code buffer
fn wasm_body_push_i64_leb128(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    var v = val
    var done = false
    while !done {
        let low7 = v % 128
        var byte_val = low7
        if byte_val < 0 { byte_val = byte_val + 128 }
        if v < 0 { v = (v - 127) / 128 } else { v = v / 128 }
        let sign_bit = byte_val % 128
        if v == 0 && sign_bit < 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else if v == (0 - 1) && sign_bit >= 64 {
            out = wasm_body_push_byte(out, byte_val)
            done = true
        } else {
            out = wasm_body_push_byte(out, byte_val + 128)
        }
    }
    out
}

// ============================================================================
// Emit a single opcode byte
// ============================================================================

fn wasm_body_emit(body: WasmFuncBody, op: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_push_byte(body, op)
}

// Emit opcode + unsigned LEB128 immediate
fn wasm_body_emit_u32(body: WasmFuncBody, op: i64, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, op)
    out = wasm_body_push_u32_leb128(out, val)
    out
}

// Emit opcode + signed LEB128 immediate (i32)
fn wasm_body_emit_i32(body: WasmFuncBody, op: i64, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, op)
    out = wasm_body_push_i32_leb128(out, val)
    out
}

// Emit opcode + signed LEB128 immediate (i64)
fn wasm_body_emit_i64(body: WasmFuncBody, op: i64, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, op)
    out = wasm_body_push_i64_leb128(out, val)
    out
}

// ============================================================================
// Add local declarations to a function body
// ============================================================================

fn wasm_body_add_local(body: WasmFuncBody, count: i64, val_type: i64) -> WasmFuncBody with Mut, Panic {
    var out = body
    if out.local_count < 32 {
        out.locals[out.local_count as usize] = WasmLocal { count: count, val_type: val_type }
        out.local_count = out.local_count + 1
    }
    out
}

// ============================================================================
// Variable access instructions
// ============================================================================

fn wasm_body_emit_local_get(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_LOCAL_GET, idx)
}

fn wasm_body_emit_local_set(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_LOCAL_SET, idx)
}

fn wasm_body_emit_local_tee(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_LOCAL_TEE, idx)
}

fn wasm_body_emit_global_get(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_GLOBAL_GET, idx)
}

fn wasm_body_emit_global_set(body: WasmFuncBody, idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_GLOBAL_SET, idx)
}

// ============================================================================
// Control flow instructions
// ============================================================================

fn wasm_body_emit_unreachable(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_UNREACHABLE)
}

fn wasm_body_emit_nop(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_NOP)
}

fn wasm_body_emit_block(body: WasmFuncBody, block_type: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_BLOCK)
    out = wasm_body_push_byte(out, block_type)
    out
}

fn wasm_body_emit_loop(body: WasmFuncBody, block_type: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_LOOP)
    out = wasm_body_push_byte(out, block_type)
    out
}

fn wasm_body_emit_if(body: WasmFuncBody, block_type: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_IF)
    out = wasm_body_push_byte(out, block_type)
    out
}

fn wasm_body_emit_else(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_ELSE)
}

fn wasm_body_emit_end(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_END)
}

fn wasm_body_emit_br(body: WasmFuncBody, label: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_BR, label)
}

fn wasm_body_emit_br_if(body: WasmFuncBody, label: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_BR_IF, label)
}

fn wasm_body_emit_return(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_RETURN)
}

fn wasm_body_emit_call(body: WasmFuncBody, func_idx: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_u32(body, WASM_OP_CALL, func_idx)
}

// ============================================================================
// Constant instructions
// ============================================================================

fn wasm_body_emit_i32_const(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_i32(body, WASM_OP_I32_CONST, val)
}

fn wasm_body_emit_i64_const(body: WasmFuncBody, val: i64) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit_i64(body, WASM_OP_I64_CONST, val)
}

// f32.const: opcode + 4 bytes (IEEE 754 little-endian)
// Note: for bootstrap, emit raw 4 bytes. Full float encoding is a later phase.
fn wasm_body_emit_f32_const_raw(body: WasmFuncBody, b0: i64, b1: i64, b2: i64, b3: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F32_CONST)
    out = wasm_body_push_byte(out, b0)
    out = wasm_body_push_byte(out, b1)
    out = wasm_body_push_byte(out, b2)
    out = wasm_body_push_byte(out, b3)
    out
}

// f64.const: opcode + 8 bytes (IEEE 754 little-endian)
fn wasm_body_emit_f64_const_raw(
    body: WasmFuncBody,
    b0: i64, b1: i64, b2: i64, b3: i64,
    b4: i64, b5: i64, b6: i64, b7: i64
) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F64_CONST)
    out = wasm_body_push_byte(out, b0)
    out = wasm_body_push_byte(out, b1)
    out = wasm_body_push_byte(out, b2)
    out = wasm_body_push_byte(out, b3)
    out = wasm_body_push_byte(out, b4)
    out = wasm_body_push_byte(out, b5)
    out = wasm_body_push_byte(out, b6)
    out = wasm_body_push_byte(out, b7)
    out
}

