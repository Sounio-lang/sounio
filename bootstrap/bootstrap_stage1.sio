// ============================================================
// Test 9: Find vtable by type and trait
// ============================================================

fn test_te_find_vtable() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let m1 = te_make_methods_1_set(100)
    let m2 = te_make_methods_1_set(200)
    ctx = te_build_vtable(ctx, 10, 20, m1, 1, 8, 8, TE_NOT_FOUND)
    ctx = te_build_vtable(ctx, 11, 21, m2, 1, 16, 8, TE_NOT_FOUND)
    let idx0 = te_find_vtable(ctx, 10, 20)
    if idx0 != 0 {
        print("FAIL: test_te_find_vtable - 0\n")
        return 1
    }
    let idx1 = te_find_vtable(ctx, 11, 21)
    if idx1 != 1 {
        print("FAIL: test_te_find_vtable - 1\n")
        return 1
    }
    let idx_miss = te_find_vtable(ctx, 10, 21)
    if idx_miss != TE_NOT_FOUND {
        print("FAIL: test_te_find_vtable - miss\n")
        return 1
    }
    print("PASS: test_te_find_vtable\n")
    return 0
}

