    let missing = eff_decl_missing(decl)
    let ok1 = eff_set_count(missing) == 2
    let ok2 = eff_set_has(missing, EFF_MUT())
    let ok3 = eff_set_has(missing, EFF_PANIC())
    let ok4 = !eff_set_has(missing, EFF_IO())
    effc_assert_true(ok1 && ok2 && ok3 && ok4, 27)
}

// ============================================================
