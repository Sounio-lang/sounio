    let add_cost = avec_instr_vector_cost(AVEC_OP_BINOP, AVEC_VEC_256)
    if add_cost != AVEC_COST_VEC_ADD { return false }
    let nop_cost = avec_instr_vector_cost(AVEC_OP_NOP, AVEC_VEC_256)
    if nop_cost != 0 { return false }
    let load_cost = avec_instr_vector_cost(AVEC_OP_LOAD_IMM, AVEC_VEC_256)
    if load_cost != AVEC_COST_BROADCAST { return false }
    true
}

