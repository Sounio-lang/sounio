fn wasm_body_emit_f32_mul(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_F32_MUL)
}

fn wasm_body_emit_f32_div(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_F32_DIV)
}

fn wasm_body_emit_f32_sqrt(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_F32_SQRT)
}

fn wasm_body_emit_f32_abs(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_F32_ABS)
}

fn wasm_body_emit_f32_neg(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    wasm_body_emit(body, WASM_OP_F32_NEG)
}

// ============================================================================
// Memory instructions: opcode + align(LEB128) + offset(LEB128)
// ============================================================================

fn wasm_body_emit_i32_load(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I32_LOAD)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_i64_load(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I64_LOAD)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_f32_load(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F32_LOAD)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_f64_load(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F64_LOAD)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_i32_store(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I32_STORE)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_i64_store(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I64_STORE)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_f32_store(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F32_STORE)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_f64_store(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_F64_STORE)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_i32_load8_s(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I32_LOAD8_S)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_i32_load8_u(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I32_LOAD8_U)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_i32_store8(body: WasmFuncBody, align: i64, offset: i64) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_I32_STORE8)
    out = wasm_body_push_u32_leb128(out, align)
    out = wasm_body_push_u32_leb128(out, offset)
    out
}

fn wasm_body_emit_memory_size(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_MEMORY_SIZE)
    out = wasm_body_push_byte(out, 0x00)  // memory index 0
    out
}

fn wasm_body_emit_memory_grow(body: WasmFuncBody) -> WasmFuncBody with Mut, Panic, Div {
    var out = body
    out = wasm_body_push_byte(out, WASM_OP_MEMORY_GROW)
