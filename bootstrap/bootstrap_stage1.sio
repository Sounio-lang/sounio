    let idx1 = jc_insert_entry(cache, 700, JC_TIER_BASELINE, code, 8)
    let idx2 = jc_insert_entry(cache, 701, JC_TIER_OPT, code, 8)
    let idx3 = jc_insert_entry(cache, 702, JC_TIER_NATIVE, code, 8)
    let count = jc_invalidate_all(cache)
    if count != 3 { return false }
    let valid = jc_valid_entry_count(cache)
    valid == 0
}
fn test_jc_invalidate_all() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_invalidate_all_inner(&! cache)
}

// T19: Invalidate by tier
fn test_jc_invalidate_tier_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(5 as i8, 8)
    let idx1 = jc_insert_entry(cache, 800, JC_TIER_BASELINE, code, 8)
    let idx2 = jc_insert_entry(cache, 801, JC_TIER_BASELINE, code, 8)
    let idx3 = jc_insert_entry(cache, 802, JC_TIER_OPT, code, 8)
    let count = jc_invalidate_tier(cache, JC_TIER_BASELINE)
