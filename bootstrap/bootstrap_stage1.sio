// T18: Parent module can see child's private exports
fn test_mod_visibility_parent_sees_child() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    let n_parent = mod_make_name(112, 0, 0, 1)  // "p"
    let n_child = mod_make_name(99, 0, 0, 1)    // "c"
    let r0 = mod_graph_add_module(g, n_parent, 1, p, 0, 0 - 1, true)
    g = r0.0
    let parent_id = r0.1
    let r1 = mod_graph_add_module(g, n_child, 1, p, 0, parent_id, true)
    g = r1.0
    let child_id = r1.1

    let e_priv = mod_make_name(120, 0, 0, 1)
    g = mod_graph_add_export(g, e_priv, 1, MOD_KIND_FN, 10, child_id, false)  // private

    let can_see = mod_graph_visibility_check(g, parent_id, child_id, 0)
    mod_assert_true(can_see, 18)
}

// T19: Resolve a qualified import "foo::bar_fn"
fn test_mod_resolve_qualified_import() -> i64 with IO, Mut, Panic, Div {
    var g = mod_graph_new()
    let p = mod_make_path(0, 0, 0, 0)
    // Module "foo"
    let n_foo = mod_make_name(102, 111, 111, 3)
    let r0 = mod_graph_add_module(g, n_foo, 3, p, 0, 0 - 1, true)
    g = r0.0

    // Export "bar" in module "foo"
    let n_bar = mod_make_name(98, 97, 114, 3)
    g = mod_graph_add_export(g, n_bar, 3, MOD_KIND_FN, 42, 0, true)

    // Build qualified name "foo::bar" as bytes: f=102,o=111,o=111,:=58,:=58,b=98,a=97,r=114
    var qname: [i8; 64] = [0; 64]
    qname[0] = 102  // f
    qname[1] = 111  // o
    qname[2] = 111  // o
    qname[3] = 58   // :
    qname[4] = 58   // :
    qname[5] = 98   // b
    qname[6] = 97   // a
    qname[7] = 114  // r
    let qlen: i64 = 8

    let result = mod_graph_resolve_import(g, qname, qlen)
    let resolved_mod = result.0
    let resolved_exp = result.1

    let ok = resolved_mod == 0 && resolved_exp == 0
    mod_assert_true(ok, 19)
}

