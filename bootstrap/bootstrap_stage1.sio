// T17: SLL x10, x11, x12 => 0x00C59533
// funct7=0000000, rs2=12, rs1=11, funct3=001, rd=10, opcode=0110011
fn rv_test_sll_encoding() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = rv_emit_sll(buf, RV_A0, RV_A1, RV_A2)
