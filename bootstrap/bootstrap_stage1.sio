        p = pair.1
        i = i + 1
    }

    let c13 = write_i64(b, p, ep.deferred_certificate_count)
    b = c13.0
    p = c13.1
    i = 0
    while i < ep.deferred_certificate_count {
        let pair = write_deferred_certificate_info(b, p, ep.deferred_certificates[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c14 = write_i64(b, p, ep.deferred_reason_witness_count)
    b = c14.0
    p = c14.1
    i = 0
    while i < ep.deferred_reason_witness_count {
        let pair = write_deferred_reason_witness_info(b, p, ep.deferred_reason_witnesses[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c15 = write_i64(b, p, ep.acquisition_policy_count)
    b = c15.0
    p = c15.1
    i = 0
    while i < ep.acquisition_policy_count {
        let pair = write_acquisition_policy_info(b, p, ep.acquisition_policies[i])
