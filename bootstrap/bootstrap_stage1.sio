    let ok_line = ctx.line == 0
    let ok_col = ctx.col == 0
    let ok_in_fn = ctx.in_function == false
    let ok_in_st = ctx.in_struct == false
    let ok_dot = ctx.after_dot == false
    let ok_cc = ctx.after_colon_colon == false
    let ok_pfx = ctx.prefix_len == 0
    ok_line && ok_col && ok_in_fn && ok_in_st && ok_dot && ok_cc && ok_pfx
}

// T53: empty_entry has correct defaults
