}

// T11: MOVZ X0, #0x1234, LSL #0 => 0xD2824680
fn a64_test_movz() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_movz(buf, A64_X0, 0x1234, 0)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xD2824680) { return false }
    true
}

// T12: STR X0, [X1, #8] => 0xF9000420
// imm12 = 8/8 = 1
fn a64_test_str() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_str(buf, A64_X0, A64_X1, 8)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xF9000420) { return false }
    true
}

// T13: LDR X0, [X1, #16] => 0xF9400820
// imm12 = 16/8 = 2
fn a64_test_ldr() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_ldr(buf, A64_X0, A64_X1, 16)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xF9400820) { return false }
    true
}

// T14: SDIV X0, X1, X2 => 0x9AC20C20
fn a64_test_sdiv() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_sdiv(buf, A64_X0, A64_X1, A64_X2)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0x9AC20C20) { return false }
    true
}

// T15: SVC #0 => 0xD4000001
fn a64_test_svc() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_svc(buf, 0)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xD4000001) { return false }
    true
}

// T16: CBZ X0, +12 => 0xB4000060
// imm19 = 12/4 = 3, Rt = 0
fn a64_test_cbz() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_cbz(buf, A64_X0, 12)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0xB4000060) { return false }
    true
}

// T17: Prologue/epilogue produces correct instruction count
fn a64_test_prologue_epilogue() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_prologue(buf, 16)
    buf = a64_emit_epilogue(buf, 16)
    // Prologue: stp (1) + mov (1) = 2 instructions = 8 bytes
    // Epilogue: ldp (1) + ret (1) = 2 instructions = 8 bytes
    if !(buf.len == 16) { return false }
    true
}

// T18: AND X0, X1, X2 => 0x8A020020
fn a64_test_and_reg() -> bool with Mut, Panic, Div {
    var buf = code_buffer_new()
    buf = a64_emit_and(buf, A64_X0, A64_X1, A64_X2)
    if !(buf.len == 4) { return false }
    let word = a64_read_word(buf, 0)
    if !(word == 0x8A020020) { return false }
    true
}

// ============================================================================
// Test runner
// ============================================================================

fn a64_test_main() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 18

    print("=== AArch64 Encoder Tests ===\n")

    if a64_test_add_reg()   { passed = passed + 1; print("  T01 OK (ADD reg)\n")  } else { print("  FAIL: T01 ADD reg\n") }
    if a64_test_sub_reg()   { passed = passed + 1; print("  T02 OK (SUB reg)\n")  } else { print("  FAIL: T02 SUB reg\n") }
    if a64_test_add_imm()   { passed = passed + 1; print("  T03 OK (ADD imm)\n")  } else { print("  FAIL: T03 ADD imm\n") }
    if a64_test_nop()       { passed = passed + 1; print("  T04 OK (NOP)\n")      } else { print("  FAIL: T04 NOP\n") }
    if a64_test_ret()       { passed = passed + 1; print("  T05 OK (RET)\n")      } else { print("  FAIL: T05 RET\n") }
    if a64_test_mov_reg()   { passed = passed + 1; print("  T06 OK (MOV reg)\n")  } else { print("  FAIL: T06 MOV reg\n") }
    if a64_test_blr()       { passed = passed + 1; print("  T07 OK (BLR)\n")      } else { print("  FAIL: T07 BLR\n") }
    if a64_test_cmp_reg()   { passed = passed + 1; print("  T08 OK (CMP reg)\n")  } else { print("  FAIL: T08 CMP reg\n") }
    if a64_test_mul()       { passed = passed + 1; print("  T09 OK (MUL)\n")      } else { print("  FAIL: T09 MUL\n") }
    if a64_test_b_eq()      { passed = passed + 1; print("  T10 OK (B.EQ)\n")     } else { print("  FAIL: T10 B.EQ\n") }
    if a64_test_movz()      { passed = passed + 1; print("  T11 OK (MOVZ)\n")     } else { print("  FAIL: T11 MOVZ\n") }
    if a64_test_str()       { passed = passed + 1; print("  T12 OK (STR)\n")      } else { print("  FAIL: T12 STR\n") }
    if a64_test_ldr()       { passed = passed + 1; print("  T13 OK (LDR)\n")      } else { print("  FAIL: T13 LDR\n") }
    if a64_test_sdiv()      { passed = passed + 1; print("  T14 OK (SDIV)\n")     } else { print("  FAIL: T14 SDIV\n") }
    if a64_test_svc()       { passed = passed + 1; print("  T15 OK (SVC)\n")      } else { print("  FAIL: T15 SVC\n") }
    if a64_test_cbz()       { passed = passed + 1; print("  T16 OK (CBZ)\n")      } else { print("  FAIL: T16 CBZ\n") }
    if a64_test_prologue_epilogue() { passed = passed + 1; print("  T17 OK (prologue/epilogue)\n") } else { print("  FAIL: T17 prologue/epilogue\n") }
    if a64_test_and_reg()   { passed = passed + 1; print("  T18 OK (AND reg)\n")  } else { print("  FAIL: T18 AND reg\n") }

    print("\nAArch64 tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/native/dwarf.sio  (932 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::native::dwarf — DWARF debug information emitter
//
// Emits .debug_info and .debug_abbrev sections for DWARF v4 debug info.
// Supports compile units, subprograms (functions), base types, and variables.
//
// The abbreviation table uses a fixed scheme:
//   abbrev 1 = DW_TAG_compile_unit  (has children)
//   abbrev 2 = DW_TAG_base_type     (no children)
//   abbrev 3 = DW_TAG_subprogram    (has children)
//   abbrev 4 = DW_TAG_variable      (no children)
//   abbrev 5 = DW_TAG_formal_parameter (no children)

// ============================================================================
// DWARF constants
// ============================================================================

let DW_TAG_compile_unit: i64 = 0x11
let DW_TAG_subprogram: i64 = 0x2E
let DW_TAG_base_type: i64 = 0x24
let DW_TAG_variable: i64 = 0x34
let DW_TAG_formal_parameter: i64 = 0x05

let DW_AT_name: i64 = 0x03
let DW_AT_comp_dir: i64 = 0x1B
let DW_AT_language: i64 = 0x13
let DW_AT_low_pc: i64 = 0x11
let DW_AT_high_pc: i64 = 0x12
let DW_AT_byte_size: i64 = 0x0B
let DW_AT_encoding: i64 = 0x3E
let DW_AT_type: i64 = 0x49
let DW_AT_location: i64 = 0x02
let DW_AT_frame_base: i64 = 0x40

let DW_FORM_string: i64 = 0x08
let DW_FORM_data1: i64 = 0x0B
let DW_FORM_data2: i64 = 0x05
let DW_FORM_data4: i64 = 0x06
let DW_FORM_data8: i64 = 0x07
let DW_FORM_addr: i64 = 0x01
let DW_FORM_ref4: i64 = 0x13
let DW_FORM_exprloc: i64 = 0x18

let DW_ATE_signed: i64 = 0x05
let DW_ATE_unsigned: i64 = 0x07
let DW_ATE_float: i64 = 0x04
let DW_ATE_boolean: i64 = 0x02

let DW_LANG_SOUNIO: i64 = 0x9000

let DW_CHILDREN_yes: i64 = 1
let DW_CHILDREN_no: i64 = 0

// DWARF expression opcodes
let DW_OP_reg6: i64 = 0x56       // rbp
let DW_OP_fbreg: i64 = 0x91      // frame base + sleb128 offset

// ============================================================================
// DwarfBuf — byte buffer for DWARF section emission
// ============================================================================

struct DwarfBuf {
    data: [i8; 131072],
    len: i64,
}

struct DwarfCompileUnit {
    name_buf: [i8; 256],
    name_len: i64,
    comp_dir_buf: [i8; 256],
    comp_dir_len: i64,
    language: i64,
    low_pc: i64,
    high_pc: i64,
}

struct DwarfSubprogram {
    name_buf: [i8; 128],
    name_len: i64,
    low_pc: i64,
    high_pc: i64,
    return_type: i64,
    frame_base_op: i64,
}

struct DwarfBaseType {
    name_buf: [i8; 64],
    name_len: i64,
    encoding: i64,
    byte_size: i64,
}

struct DwarfVariable {
    name_buf: [i8; 128],
    name_len: i64,
    type_die: i64,
    location_op: i64,
    location_offset: i64,
}

fn dwarf_buf_new() -> DwarfBuf {
    DwarfBuf {
        data: [0; 131072],
        len: 0,
    }
}

// ============================================================================
// Primitive emitters
// ============================================================================

// Mask a value to its low 8 bits (unsigned).
fn dwarf_low8(x: i64) -> i64 with Mut, Panic, Div {
    var n = x % 256
    if n < 0 { n = n + 256 }
    n
}

fn dwarf_push_byte(buf: DwarfBuf, b: i64) -> DwarfBuf with Mut, Panic, Div {
    var out = buf
    if out.len >= 0 && out.len < 131072 {
        out.data[out.len as usize] = dwarf_low8(b) as i8
        out.len = out.len + 1
    }
    out
}

fn dwarf_push_u16_le(buf: DwarfBuf, val: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    b = dwarf_push_byte(b, dwarf_low8(val))
    b = dwarf_push_byte(b, dwarf_low8(val >> 8))
    b
}

fn dwarf_push_u32_le(buf: DwarfBuf, val: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    b = dwarf_push_byte(b, dwarf_low8(val))
    b = dwarf_push_byte(b, dwarf_low8(val >> 8))
    b = dwarf_push_byte(b, dwarf_low8(val >> 16))
    b = dwarf_push_byte(b, dwarf_low8(val >> 24))
    b
}

fn dwarf_push_u64_le(buf: DwarfBuf, val: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    b = dwarf_push_u32_le(b, val)
    b = dwarf_push_u32_le(b, val >> 32)
    b
}

// Emit ULEB128 encoding (unsigned LEB128).
// ULEB128 encodes an unsigned integer in 7-bit groups, low-order first,
// with the high bit set on all bytes except the last.
fn dwarf_push_uleb128(buf: DwarfBuf, val: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    var v = val
    // Handle negative values by treating as unsigned (mask off sign extension)
    // For our purposes, values are always small and non-negative.
    if v < 0 { v = 0 }

    var done = false
    while !done {
        let low7 = v & 127
        v = v >> 7
        if v == 0 {
            b = dwarf_push_byte(b, low7)
            done = true
        } else {
            b = dwarf_push_byte(b, low7 | 128)
        }
    }
    b
}

// Emit SLEB128 encoding (signed LEB128).
// SLEB128 encodes a signed integer in 7-bit groups with sign extension.
fn dwarf_push_sleb128(buf: DwarfBuf, val: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    var v = val
    var more = true

    while more {
        let low7 = v & 127
        v = v >> 7

        // Check if we are done:
        // If value is 0 and sign bit of byte is clear, or
        // if value is -1 and sign bit of byte is set
        let sign_bit = low7 & 64
        if (v == 0 && sign_bit == 0) || (v == -1 && sign_bit != 0) {
            b = dwarf_push_byte(b, low7)
            more = false
        } else {
            b = dwarf_push_byte(b, low7 | 128)
        }
    }
    b
}

// Emit a null-terminated string.
fn dwarf_push_string_bytes(buf: DwarfBuf, s_buf: [i8; 256], s_len: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < s_len {
        b = dwarf_push_byte(b, s_buf[i as usize] as i64)
        i = i + 1
    }
    // Null terminator
    b = dwarf_push_byte(b, 0)
    b
}

// Emit a null-terminated string from a shorter buffer.
fn dwarf_push_string_short(buf: DwarfBuf, s_buf: [i8; 128], s_len: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < s_len {
        b = dwarf_push_byte(b, s_buf[i as usize] as i64)
        i = i + 1
    }
    b = dwarf_push_byte(b, 0)
    b
}

// Emit a null-terminated string from a 64-byte buffer.
fn dwarf_push_string_tiny(buf: DwarfBuf, s_buf: [i8; 64], s_len: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    var i: i64 = 0
    while i < s_len {
        b = dwarf_push_byte(b, s_buf[i as usize] as i64)
        i = i + 1
    }
    b = dwarf_push_byte(b, 0)
    b
}

// ============================================================================
// Abbreviation table emission
// ============================================================================

// Emit the complete .debug_abbrev section.
// Fixed abbreviation scheme:
//   1 = compile_unit (children: yes)
//       DW_AT_name      / DW_FORM_string
//       DW_AT_comp_dir  / DW_FORM_string
//       DW_AT_language  / DW_FORM_data2
//       DW_AT_low_pc    / DW_FORM_addr
//       DW_AT_high_pc   / DW_FORM_addr
//
//   2 = base_type (children: no)
//       DW_AT_name      / DW_FORM_string
//       DW_AT_encoding  / DW_FORM_data1
//       DW_AT_byte_size / DW_FORM_data1
//
//   3 = subprogram (children: yes)
//       DW_AT_name       / DW_FORM_string
//       DW_AT_low_pc     / DW_FORM_addr
//       DW_AT_high_pc    / DW_FORM_addr
//       DW_AT_type       / DW_FORM_ref4
//       DW_AT_frame_base / DW_FORM_exprloc
//
//   4 = variable (children: no)
//       DW_AT_name     / DW_FORM_string
//       DW_AT_type     / DW_FORM_ref4
//       DW_AT_location / DW_FORM_exprloc
//
//   5 = formal_parameter (children: no)
//       DW_AT_name     / DW_FORM_string
//       DW_AT_type     / DW_FORM_ref4
//       DW_AT_location / DW_FORM_exprloc

fn dwarf_emit_abbrev_entry(buf: DwarfBuf, index: i64, tag: i64, has_children: i64, attrs: [i64; 16], forms: [i64; 16], attr_count: i64) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    // Abbreviation index
    b = dwarf_push_uleb128(b, index)
    // Tag
    b = dwarf_push_uleb128(b, tag)
    // Has children
    b = dwarf_push_byte(b, has_children)
    // Attribute specifications
    var i: i64 = 0
    while i < attr_count {
        b = dwarf_push_uleb128(b, attrs[i as usize])
        b = dwarf_push_uleb128(b, forms[i as usize])
        i = i + 1
    }
    // Terminate attribute list with (0, 0)
    b = dwarf_push_uleb128(b, 0)
    b = dwarf_push_uleb128(b, 0)
    b
}

fn dwarf_emit_abbrev_table(buf: DwarfBuf) -> DwarfBuf with Mut, Panic, Div {
    var b = buf

    // Abbrev 1: DW_TAG_compile_unit (has children)
    var attrs1: [i64; 16] = [0; 16]
    var forms1: [i64; 16] = [0; 16]
    attrs1[0] = DW_AT_name;      forms1[0] = DW_FORM_string
    attrs1[1] = DW_AT_comp_dir;  forms1[1] = DW_FORM_string
    attrs1[2] = DW_AT_language;  forms1[2] = DW_FORM_data2
    attrs1[3] = DW_AT_low_pc;    forms1[3] = DW_FORM_addr
    attrs1[4] = DW_AT_high_pc;   forms1[4] = DW_FORM_addr
    b = dwarf_emit_abbrev_entry(b, 1, DW_TAG_compile_unit, DW_CHILDREN_yes, attrs1, forms1, 5)

    // Abbrev 2: DW_TAG_base_type (no children)
    var attrs2: [i64; 16] = [0; 16]
    var forms2: [i64; 16] = [0; 16]
    attrs2[0] = DW_AT_name;      forms2[0] = DW_FORM_string
    attrs2[1] = DW_AT_encoding;  forms2[1] = DW_FORM_data1
    attrs2[2] = DW_AT_byte_size; forms2[2] = DW_FORM_data1
    b = dwarf_emit_abbrev_entry(b, 2, DW_TAG_base_type, DW_CHILDREN_no, attrs2, forms2, 3)

    // Abbrev 3: DW_TAG_subprogram (has children)
    var attrs3: [i64; 16] = [0; 16]
    var forms3: [i64; 16] = [0; 16]
    attrs3[0] = DW_AT_name;       forms3[0] = DW_FORM_string
    attrs3[1] = DW_AT_low_pc;     forms3[1] = DW_FORM_addr
    attrs3[2] = DW_AT_high_pc;    forms3[2] = DW_FORM_addr
    attrs3[3] = DW_AT_type;       forms3[3] = DW_FORM_ref4
    attrs3[4] = DW_AT_frame_base; forms3[4] = DW_FORM_exprloc
    b = dwarf_emit_abbrev_entry(b, 3, DW_TAG_subprogram, DW_CHILDREN_yes, attrs3, forms3, 5)

    // Abbrev 4: DW_TAG_variable (no children)
    var attrs4: [i64; 16] = [0; 16]
    var forms4: [i64; 16] = [0; 16]
    attrs4[0] = DW_AT_name;     forms4[0] = DW_FORM_string
    attrs4[1] = DW_AT_type;     forms4[1] = DW_FORM_ref4
    attrs4[2] = DW_AT_location; forms4[2] = DW_FORM_exprloc
    b = dwarf_emit_abbrev_entry(b, 4, DW_TAG_variable, DW_CHILDREN_no, attrs4, forms4, 3)

    // Abbrev 5: DW_TAG_formal_parameter (no children)
    var attrs5: [i64; 16] = [0; 16]
    var forms5: [i64; 16] = [0; 16]
    attrs5[0] = DW_AT_name;     forms5[0] = DW_FORM_string
    attrs5[1] = DW_AT_type;     forms5[1] = DW_FORM_ref4
    attrs5[2] = DW_AT_location; forms5[2] = DW_FORM_exprloc
    b = dwarf_emit_abbrev_entry(b, 5, DW_TAG_formal_parameter, DW_CHILDREN_no, attrs5, forms5, 3)

    // Terminate abbreviation table with 0
    b = dwarf_push_byte(b, 0)
    b
}

// ============================================================================
// Debug Info Entry (DIE) emitters
// ============================================================================

// Emit a DW_TAG_compile_unit DIE (abbreviation 1).
fn dwarf_emit_compile_unit(buf: DwarfBuf, cu: DwarfCompileUnit) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    // Abbreviation code 1
    b = dwarf_push_uleb128(b, 1)
    // DW_AT_name: string
    b = dwarf_push_string_bytes(b, cu.name_buf, cu.name_len)
    // DW_AT_comp_dir: string
    b = dwarf_push_string_bytes(b, cu.comp_dir_buf, cu.comp_dir_len)
    // DW_AT_language: data2
    b = dwarf_push_u16_le(b, cu.language)
    // DW_AT_low_pc: addr (8 bytes on 64-bit)
    b = dwarf_push_u64_le(b, cu.low_pc)
    // DW_AT_high_pc: addr (8 bytes on 64-bit)
    b = dwarf_push_u64_le(b, cu.high_pc)
    b
}

// Emit a DW_TAG_base_type DIE (abbreviation 2).
fn dwarf_emit_base_type(buf: DwarfBuf, ty: DwarfBaseType) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    // Abbreviation code 2
    b = dwarf_push_uleb128(b, 2)
    // DW_AT_name: string
    b = dwarf_push_string_tiny(b, ty.name_buf, ty.name_len)
    // DW_AT_encoding: data1
    b = dwarf_push_byte(b, ty.encoding)
    // DW_AT_byte_size: data1
    b = dwarf_push_byte(b, ty.byte_size)
    b
}

// Emit a DW_TAG_subprogram DIE (abbreviation 3).
fn dwarf_emit_subprogram(buf: DwarfBuf, sub: DwarfSubprogram) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    // Abbreviation code 3
    b = dwarf_push_uleb128(b, 3)
    // DW_AT_name: string
    b = dwarf_push_string_short(b, sub.name_buf, sub.name_len)
    // DW_AT_low_pc: addr
    b = dwarf_push_u64_le(b, sub.low_pc)
    // DW_AT_high_pc: addr
    b = dwarf_push_u64_le(b, sub.high_pc)
    // DW_AT_type: ref4 (offset to return type DIE)
    b = dwarf_push_u32_le(b, sub.return_type)
    // DW_AT_frame_base: exprloc
    // Expression: 1 byte length, then DW_OP_reg6 (rbp)
    b = dwarf_push_uleb128(b, 1)         // expression length
    b = dwarf_push_byte(b, sub.frame_base_op)
    b
}

// Emit a DW_TAG_variable DIE (abbreviation 4).
fn dwarf_emit_variable(buf: DwarfBuf, var_info: DwarfVariable) -> DwarfBuf with Mut, Panic, Div {
    var b = buf
    // Abbreviation code 4
    b = dwarf_push_uleb128(b, 4)
    // DW_AT_name: string
    b = dwarf_push_string_short(b, var_info.name_buf, var_info.name_len)
    // DW_AT_type: ref4
    b = dwarf_push_u32_le(b, var_info.type_die)
    // DW_AT_location: exprloc
    // Expression: DW_OP_fbreg + sleb128 offset
    // We need to compute the SLEB128 length first. For simplicity, emit
    // into a temporary measurement and then emit the actual bytes.
    let expr_len = dwarf_sleb128_size(var_info.location_offset) + 1
    b = dwarf_push_uleb128(b, expr_len)
    b = dwarf_push_byte(b, var_info.location_op)
    b = dwarf_push_sleb128(b, var_info.location_offset)
    b
}

// Emit a null DIE to terminate a children list.
fn dwarf_emit_end_children(buf: DwarfBuf) -> DwarfBuf with Mut, Panic, Div {
    dwarf_push_byte(buf, 0)
}

// ============================================================================
// Helper: compute SLEB128 encoding size
// ============================================================================

fn dwarf_sleb128_size(val: i64) -> i64 with Mut, Panic, Div {
    var v = val
    var size: i64 = 0
    var more = true
    while more {
        let low7 = v & 127
        v = v >> 7
        size = size + 1
        let sign_bit = low7 & 64
        if (v == 0 && sign_bit == 0) || (v == -1 && sign_bit != 0) {
            more = false
        }
    }
    size
}

// ============================================================================
// Sounio-specific type constructors
// ============================================================================

fn dwarf_set_name_i64(buf: [i8; 64]) -> [i8; 64] with Mut, Panic, Div {
    var out = buf
    out[0] = 105  // 'i'
    out[1] = 54   // '6'
    out[2] = 52   // '4'
    out
}

fn dwarf_set_name_f64(buf: [i8; 64]) -> [i8; 64] with Mut, Panic, Div {
    var out = buf
    out[0] = 102  // 'f'
    out[1] = 54   // '6'
    out[2] = 52   // '4'
    out
}

fn dwarf_set_name_bool(buf: [i8; 64]) -> [i8; 64] with Mut, Panic, Div {
    var out = buf
    out[0] = 98   // 'b'
    out[1] = 111  // 'o'
    out[2] = 111  // 'o'
    out[3] = 108  // 'l'
    out
}

fn dwarf_set_name_i8(buf: [i8; 64]) -> [i8; 64] with Mut, Panic, Div {
    var out = buf
    out[0] = 105  // 'i'
    out[1] = 56   // '8'
    out
}

fn dwarf_sounio_i64_type() -> DwarfBaseType with Mut, Panic, Div {
    DwarfBaseType {
        name_buf: dwarf_set_name_i64([0; 64]),
        name_len: 3,
        encoding: DW_ATE_signed,
        byte_size: 8,
    }
}

fn dwarf_sounio_f64_type() -> DwarfBaseType with Mut, Panic, Div {
    DwarfBaseType {
        name_buf: dwarf_set_name_f64([0; 64]),
        name_len: 3,
        encoding: DW_ATE_float,
        byte_size: 8,
    }
}

fn dwarf_sounio_bool_type() -> DwarfBaseType with Mut, Panic, Div {
    DwarfBaseType {
        name_buf: dwarf_set_name_bool([0; 64]),
        name_len: 4,
        encoding: DW_ATE_boolean,
        byte_size: 1,
    }
}

fn dwarf_sounio_i8_type() -> DwarfBaseType with Mut, Panic, Div {
    DwarfBaseType {
        name_buf: dwarf_set_name_i8([0; 64]),
        name_len: 2,
        encoding: DW_ATE_signed,
        byte_size: 1,
    }
}

// ============================================================================
// Full debug section emission
// ============================================================================

// Emit a complete .debug_info section with compilation unit header,
// compile unit DIE, and subprogram DIEs.
//
// DWARF v4 compilation unit header:
//   u32: unit_length (excluding this field)
//   u16: version (4)
//   u32: debug_abbrev_offset (0 — single abbrev section)
//   u8:  address_size (8 for 64-bit)
fn dwarf_emit_debug_info(cu: DwarfCompileUnit, subs: [DwarfSubprogram; 256], sub_count: i64) -> DwarfBuf with Mut, Panic, Div {
    // First, emit the content into a temporary buffer to measure its length.
    var content = dwarf_buf_new()

    // Compile unit DIE
    content = dwarf_emit_compile_unit(content, cu)

    // Base type DIEs for Sounio primitive types
    let i64_type = dwarf_sounio_i64_type()
    let f64_type = dwarf_sounio_f64_type()
    let bool_type = dwarf_sounio_bool_type()
    let i8_type = dwarf_sounio_i8_type()

    content = dwarf_emit_base_type(content, i64_type)
    content = dwarf_emit_base_type(content, f64_type)
    content = dwarf_emit_base_type(content, bool_type)
    content = dwarf_emit_base_type(content, i8_type)

    // Subprogram DIEs
    var si: i64 = 0
    while si < sub_count {
        content = dwarf_emit_subprogram(content, subs[si as usize])
        // End subprogram children (even if empty)
        content = dwarf_emit_end_children(content)
        si = si + 1
    }

    // End compile unit children
    content = dwarf_emit_end_children(content)

    // Now build the final buffer with the header.
    var result = dwarf_buf_new()

    // Header: version(2) + abbrev_offset(4) + address_size(1) = 7 bytes
    let content_len = content.len
    let unit_length = content_len + 7

    // unit_length (u32)
    result = dwarf_push_u32_le(result, unit_length)
    // version (u16) — DWARF v4
    result = dwarf_push_u16_le(result, 4)
    // debug_abbrev_offset (u32)
    result = dwarf_push_u32_le(result, 0)
    // address_size (u8)
    result = dwarf_push_byte(result, 8)

    // Copy content into result
    var ci: i64 = 0
    while ci < content_len {
        result = dwarf_push_byte(result, content.data[ci as usize] as i64)
        ci = ci + 1
    }

    result
}

// ============================================================================
// Tests
// ============================================================================

// Helper: read a byte from a DwarfBuf as unsigned.
fn dwarf_read_u8(buf: DwarfBuf, pos: i64) -> i64 {
    let raw = buf.data[pos as usize] as i64
    if raw < 0 { raw + 256 } else { raw }
}

// Helper: read a u16 LE from a DwarfBuf.
fn dwarf_read_u16_le(buf: DwarfBuf, pos: i64) -> i64 {
    let b0 = dwarf_read_u8(buf, pos)
    let b1 = dwarf_read_u8(buf, pos + 1)
    b0 + b1 * 256
}

// Helper: read a u32 LE from a DwarfBuf.
fn dwarf_read_u32_le(buf: DwarfBuf, pos: i64) -> i64 {
    let b0 = dwarf_read_u8(buf, pos)
    let b1 = dwarf_read_u8(buf, pos + 1)
    let b2 = dwarf_read_u8(buf, pos + 2)
    let b3 = dwarf_read_u8(buf, pos + 3)
    b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

// Helper: build a test compile unit.
fn dwarf_test_compile_unit() -> DwarfCompileUnit with Mut, Panic, Div {
    var name: [i8; 256] = [0; 256]
    name[0] = 116  // 't'
    name[1] = 101  // 'e'
    name[2] = 115  // 's'
    name[3] = 116  // 't'

    var dir: [i8; 256] = [0; 256]
    dir[0] = 47    // '/'
    dir[1] = 116   // 't'
    dir[2] = 109   // 'm'
    dir[3] = 112   // 'p'

    DwarfCompileUnit {
        name_buf: name,
        name_len: 4,
        comp_dir_buf: dir,
        comp_dir_len: 4,
        language: DW_LANG_SOUNIO,
        low_pc: 0x1000,
        high_pc: 0x2000,
    }
}

// Helper: build a test subprogram.
fn dwarf_test_subprogram() -> DwarfSubprogram with Mut, Panic, Div {
    var name: [i8; 128] = [0; 128]
    name[0] = 109  // 'm'
    name[1] = 97   // 'a'
    name[2] = 105  // 'i'
    name[3] = 110  // 'n'

    DwarfSubprogram {
        name_buf: name,
        name_len: 4,
        low_pc: 0x1000,
        high_pc: 0x1100,
        return_type: 0x30,
        frame_base_op: DW_OP_reg6,
    }
}

// T01: ULEB128 encoding of small values
fn test_uleb128_encoding() -> bool with Mut, Panic, Div {
    // 0 encodes as [0x00]
    var b0 = dwarf_buf_new()
    b0 = dwarf_push_uleb128(b0, 0)
    if !(b0.len == 1) { return false }
    if !(dwarf_read_u8(b0, 0) == 0) { return false }

    // 127 encodes as [0x7F]
    var b1 = dwarf_buf_new()
    b1 = dwarf_push_uleb128(b1, 127)
    if !(b1.len == 1) { return false }
    if !(dwarf_read_u8(b1, 0) == 0x7F) { return false }

    // 128 encodes as [0x80, 0x01]
    var b2 = dwarf_buf_new()
    b2 = dwarf_push_uleb128(b2, 128)
    if !(b2.len == 2) { return false }
    if !(dwarf_read_u8(b2, 0) == 0x80) { return false }
    if !(dwarf_read_u8(b2, 1) == 0x01) { return false }

    // 624485 encodes as [0xE5, 0x8E, 0x26]
    var b3 = dwarf_buf_new()
    b3 = dwarf_push_uleb128(b3, 624485)
    if !(b3.len == 3) { return false }
    if !(dwarf_read_u8(b3, 0) == 0xE5) { return false }
    if !(dwarf_read_u8(b3, 1) == 0x8E) { return false }
    if !(dwarf_read_u8(b3, 2) == 0x26) { return false }

    true
}

// T02: SLEB128 encoding of signed values
fn test_sleb128_encoding() -> bool with Mut, Panic, Div {
    // 0 encodes as [0x00]
    var b0 = dwarf_buf_new()
    b0 = dwarf_push_sleb128(b0, 0)
    if !(b0.len == 1) { return false }
    if !(dwarf_read_u8(b0, 0) == 0x00) { return false }

    // -1 encodes as [0x7F]
    var b1 = dwarf_buf_new()
    b1 = dwarf_push_sleb128(b1, 0 - 1)
    if !(b1.len == 1) { return false }
    if !(dwarf_read_u8(b1, 0) == 0x7F) { return false }

    // 63 encodes as [0x3F]
    var b2 = dwarf_buf_new()
    b2 = dwarf_push_sleb128(b2, 63)
    if !(b2.len == 1) { return false }
    if !(dwarf_read_u8(b2, 0) == 0x3F) { return false }

    // -64 encodes as [0x40]
    var b3 = dwarf_buf_new()
    b3 = dwarf_push_sleb128(b3, 0 - 64)
    if !(b3.len == 1) { return false }
    if !(dwarf_read_u8(b3, 0) == 0x40) { return false }

    // 64 encodes as [0xC0, 0x00]
    var b4 = dwarf_buf_new()
    b4 = dwarf_push_sleb128(b4, 64)
    if !(b4.len == 2) { return false }
    if !(dwarf_read_u8(b4, 0) == 0xC0) { return false }
    if !(dwarf_read_u8(b4, 1) == 0x00) { return false }

    true
}

// T03: Abbreviation table starts with abbrev code 1 and ends with 0
fn test_abbrev_table_emission() -> bool with Mut, Panic, Div {
    var buf = dwarf_buf_new()
    buf = dwarf_emit_abbrev_table(buf)

    // Must have non-zero length
    if buf.len <= 0 { return false }

    // First byte should be ULEB128(1) = 0x01 (abbrev code 1)
    if !(dwarf_read_u8(buf, 0) == 1) { return false }

    // Last byte should be 0x00 (terminator)
    if !(dwarf_read_u8(buf, buf.len - 1) == 0) { return false }

    true
}

// T04: Compile unit DIE starts with abbrev code 1
fn test_compile_unit_die() -> bool with Mut, Panic, Div {
    let cu = dwarf_test_compile_unit()
    var buf = dwarf_buf_new()
    buf = dwarf_emit_compile_unit(buf, cu)

    // Must have some data
    if buf.len <= 0 { return false }

    // First byte: ULEB128(1) = 0x01 (abbreviation code for compile_unit)
    if !(dwarf_read_u8(buf, 0) == 1) { return false }

    // After abbrev code, next bytes should be the name "test\0"
    if !(dwarf_read_u8(buf, 1) == 116) { return false }  // 't'
    if !(dwarf_read_u8(buf, 2) == 101) { return false }  // 'e'
    if !(dwarf_read_u8(buf, 3) == 115) { return false }  // 's'
    if !(dwarf_read_u8(buf, 4) == 116) { return false }  // 't'
    if !(dwarf_read_u8(buf, 5) == 0) { return false }    // null terminator

    true
}

// T05: Base type DIE encodes encoding and byte_size correctly
fn test_base_type_die() -> bool with Mut, Panic, Div {
    let ty = dwarf_sounio_i64_type()
    var buf = dwarf_buf_new()
    buf = dwarf_emit_base_type(buf, ty)

    // First byte: abbrev code 2
    if !(dwarf_read_u8(buf, 0) == 2) { return false }

    // Then name "i64\0" (4 bytes)
    if !(dwarf_read_u8(buf, 1) == 105) { return false }  // 'i'
    if !(dwarf_read_u8(buf, 2) == 54) { return false }   // '6'
    if !(dwarf_read_u8(buf, 3) == 52) { return false }   // '4'
    if !(dwarf_read_u8(buf, 4) == 0) { return false }    // null

    // Then encoding: DW_ATE_signed = 0x05
    if !(dwarf_read_u8(buf, 5) == DW_ATE_signed) { return false }

    // Then byte_size: 8
    if !(dwarf_read_u8(buf, 6) == 8) { return false }

    // Total: 7 bytes
    if !(buf.len == 7) { return false }

    true
}

// T06: Subprogram DIE starts with abbrev code 3 and has name
fn test_subprogram_die() -> bool with Mut, Panic, Div {
    let sub = dwarf_test_subprogram()
    var buf = dwarf_buf_new()
    buf = dwarf_emit_subprogram(buf, sub)

    // First byte: abbrev code 3
    if !(dwarf_read_u8(buf, 0) == 3) { return false }

    // Then name "main\0"
    if !(dwarf_read_u8(buf, 1) == 109) { return false }  // 'm'
    if !(dwarf_read_u8(buf, 2) == 97) { return false }   // 'a'
    if !(dwarf_read_u8(buf, 3) == 105) { return false }  // 'i'
    if !(dwarf_read_u8(buf, 4) == 110) { return false }  // 'n'
    if !(dwarf_read_u8(buf, 5) == 0) { return false }    // null

    // Must have some reasonable length (name + 2 addrs + ref4 + exprloc)
    // Name (5) + abbrev (1) + low_pc (8) + high_pc (8) + ref4 (4) + exprloc (2) = 28
    if buf.len < 20 { return false }

    true
}

// T07: Sounio type mapping produces correct types
fn test_sounio_type_mapping() -> bool with Mut, Panic, Div {
    let i64t = dwarf_sounio_i64_type()
    let f64t = dwarf_sounio_f64_type()
    let boolt = dwarf_sounio_bool_type()
    let i8t = dwarf_sounio_i8_type()

    // i64: encoding=signed, size=8
    if !(i64t.encoding == DW_ATE_signed) { return false }
    if !(i64t.byte_size == 8) { return false }
    if !(i64t.name_len == 3) { return false }

    // f64: encoding=float, size=8
    if !(f64t.encoding == DW_ATE_float) { return false }
    if !(f64t.byte_size == 8) { return false }
    if !(f64t.name_len == 3) { return false }

    // bool: encoding=boolean, size=1
    if !(boolt.encoding == DW_ATE_boolean) { return false }
    if !(boolt.byte_size == 1) { return false }
    if !(boolt.name_len == 4) { return false }

    // i8: encoding=signed, size=1
    if !(i8t.encoding == DW_ATE_signed) { return false }
    if !(i8t.byte_size == 1) { return false }
    if !(i8t.name_len == 2) { return false }

    true
}

// T08: Full debug_info section has correct DWARF v4 header
fn test_debug_info_header() -> bool with Mut, Panic, Div {
    let cu = dwarf_test_compile_unit()
    var subs: [DwarfSubprogram; 256] = [dwarf_test_subprogram(); 256]
    let buf = dwarf_emit_debug_info(cu, subs, 1)

    // Must have data
    if buf.len < 11 { return false }

    // Bytes 0..3: unit_length (u32 LE) — should be buf.len - 4
    let unit_length = dwarf_read_u32_le(buf, 0)
    if !(unit_length == buf.len - 4) { return false }

    // Bytes 4..5: version (u16 LE) — should be 4
    let version = dwarf_read_u16_le(buf, 4)
    if !(version == 4) { return false }

    // Bytes 6..9: debug_abbrev_offset (u32 LE) — should be 0
    let abbrev_off = dwarf_read_u32_le(buf, 6)
    if !(abbrev_off == 0) { return false }

    // Byte 10: address_size — should be 8
    if !(dwarf_read_u8(buf, 10) == 8) { return false }

    true
}

// T09: Variable DIE encodes location expression correctly
fn test_variable_die_location() -> bool with Mut, Panic, Div {
    var name: [i8; 128] = [0; 128]
    name[0] = 120  // 'x'

    let var_info = DwarfVariable {
        name_buf: name,
        name_len: 1,
        type_die: 0x30,
        location_op: DW_OP_fbreg,
        location_offset: 0 - 8,
    }

    var buf = dwarf_buf_new()
    buf = dwarf_emit_variable(buf, var_info)

    // First byte: abbrev code 4
    if !(dwarf_read_u8(buf, 0) == 4) { return false }

    // Then name "x\0"
    if !(dwarf_read_u8(buf, 1) == 120) { return false }
    if !(dwarf_read_u8(buf, 2) == 0) { return false }

    // Must have some data
    if buf.len < 8 { return false }

    true
}

// T10: End children emits a single null byte
fn test_end_children() -> bool with Mut, Panic, Div {
    var buf = dwarf_buf_new()
    buf = dwarf_emit_end_children(buf)

    if !(buf.len == 1) { return false }
    if !(dwarf_read_u8(buf, 0) == 0) { return false }
    true
}

// Test runner
fn test_dwarf_main() -> i32 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 10

    print("=== DWARF Debug Info Tests ===\n")

    if test_uleb128_encoding() { passed = passed + 1; print("  T01 OK uleb128_encoding\n") } else { print("  FAIL: T01 uleb128_encoding\n") }
    if test_sleb128_encoding() { passed = passed + 1; print("  T02 OK sleb128_encoding\n") } else { print("  FAIL: T02 sleb128_encoding\n") }
    if test_abbrev_table_emission() { passed = passed + 1; print("  T03 OK abbrev_table\n") } else { print("  FAIL: T03 abbrev_table\n") }
    if test_compile_unit_die() { passed = passed + 1; print("  T04 OK compile_unit_die\n") } else { print("  FAIL: T04 compile_unit_die\n") }
    if test_base_type_die() { passed = passed + 1; print("  T05 OK base_type_die\n") } else { print("  FAIL: T05 base_type_die\n") }
    if test_subprogram_die() { passed = passed + 1; print("  T06 OK subprogram_die\n") } else { print("  FAIL: T06 subprogram_die\n") }
    if test_sounio_type_mapping() { passed = passed + 1; print("  T07 OK sounio_type_mapping\n") } else { print("  FAIL: T07 sounio_type_mapping\n") }
    if test_debug_info_header() { passed = passed + 1; print("  T08 OK debug_info_header\n") } else { print("  FAIL: T08 debug_info_header\n") }
    if test_variable_die_location() { passed = passed + 1; print("  T09 OK variable_die_location\n") } else { print("  FAIL: T09 variable_die_location\n") }
    if test_end_children() { passed = passed + 1; print("  T10 OK end_children\n") } else { print("  FAIL: T10 end_children\n") }

    print("\nDWARF: ")
    print_int(passed)
    print(" / ")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/native/regalloc.sio  (938 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::native::regalloc — Linear-scan register allocator
//
// Implements interval-based register allocation for the IR.  Replaces the
// trivial round-robin allocator in regs.sio with a proper linear-scan pass
// that computes live intervals, assigns physical registers, and spills when
// pressure exceeds the available set.
//
// Algorithm:  Poletto & Sarkar, "Linear scan register allocation" (1999).


// ============================================================================
// Constants
// ============================================================================

let RA_MAX_INTERVALS: i64 = 512
let RA_MAX_ACTIVE: i64 = 64
let RA_MAX_HINTS: i64 = 256
let RA_SPILLED: i64 = 0 - 1          // sentinel: no physical register assigned
let RA_UNASSIGNED: i64 = 0 - 2       // not yet processed

// ============================================================================
// Core data structures
// ============================================================================

// A single live interval: one virtual register, its live range, and allocation.
struct LiveInterval {
    vreg: i64,             // virtual register id
    start: i64,            // first use/def position
    end: i64,              // last use/def position (inclusive)
    assigned_preg: i64,    // physical register (-1 = spilled, -2 = unassigned)
    spill_slot: i64,       // stack slot index when spilled (-1 = none)
}

// Register preference hint: suggest a physical register for a vreg.
struct RegHint {
    vreg: i64,
    preferred_preg: i64,
}

// Full allocator state.
struct RegAllocState {
    intervals: [LiveInterval; 512],
    count: i64,
    spill_count: i64,          // number of spill slots allocated so far
    num_pregs: i64,            // total physical registers available
    hints: [RegHint; 256],
    hint_count: i64,
    // Bookkeeping for per-preg free-until position
    free_until: [i64; 64],    // free_until[preg] = earliest position preg is free
}

// Spill summary returned after allocation.
struct SpillInfo {
    total_spills: i64,
    frame_growth: i64,         // bytes added to the stack frame (8 per slot)
}

// ============================================================================
// Constructors and helpers
// ============================================================================

fn empty_live_interval() -> LiveInterval {
    LiveInterval {
        vreg: 0,
        start: 0,
        end: 0,
        assigned_preg: RA_UNASSIGNED,
        spill_slot: 0 - 1,
    }
}

fn empty_reg_hint() -> RegHint {
    RegHint { vreg: 0, preferred_preg: 0 }
}

fn regalloc_new() -> RegAllocState {
    RegAllocState {
        intervals: [empty_live_interval(); 512],
        count: 0,
        spill_count: 0,
        num_pregs: 14,
        hints: [empty_reg_hint(); 256],
        hint_count: 0,
        free_until: [0; 64],
    }
}

// ============================================================================
// Interval management
// ============================================================================

// Add a new live interval for the given vreg spanning [start, end].
fn regalloc_add_interval(
    state: RegAllocState, vreg: i64, start: i64, end: i64
) -> RegAllocState with Mut, Panic, Div {
    var s = state
    if s.count < RA_MAX_INTERVALS {
        s.intervals[s.count as usize] = LiveInterval {
            vreg: vreg,
            start: start,
            end: end,
            assigned_preg: RA_UNASSIGNED,
            spill_slot: 0 - 1,
        }
        s.count = s.count + 1
    }
    s
}

// Insertion sort intervals by start position.  Ties broken by shorter interval
// first (heuristic: shorter intervals are easier to allocate).
fn regalloc_sort_by_start(state: RegAllocState) -> RegAllocState with Mut, Panic, Div {
    var s = state
    var i: i64 = 1
    while i < s.count {
        let key = s.intervals[i as usize]
        var j = i - 1
        while j >= 0 {
            let cmp_start = s.intervals[j as usize].start > key.start
            let same_start = s.intervals[j as usize].start == key.start
            let cmp_end = s.intervals[j as usize].end > key.end
            if cmp_start || (same_start && cmp_end) {
                s.intervals[(j + 1) as usize] = s.intervals[j as usize]
                j = j - 1
            } else {
                // break out of inner loop
                j = 0 - 1
            }
        }
        s.intervals[(j + 1) as usize] = key
        i = i + 1
    }
    s
}

// ============================================================================
// Active-set helpers
// ============================================================================

// Expire intervals in the active set whose end < position.
// Returns the new active count.
// Also frees the physical registers of expired intervals.
fn regalloc_expire_old(
    state: RegAllocState,
    active: [i64; 64],
    active_count: i64,
    position: i64
) -> RegAllocState with Mut, Panic, Div {
    // We return the state with updated free_until; the caller must also
    // receive the compacted active array.  Since Sounio does not support
    // returning tuples of arrays easily, we encode the new active list
    // into the first active_count slots of the state.free_until.
    // Instead we use a helper pattern: compact in-place.
    state
}

// In-place expire + compact.  Returns (new_state, new_active, new_active_count)
// packed into the state and arrays.
fn regalloc_expire_into(
    state: RegAllocState,
    active: [i64; 64],
    active_count: i64,
    position: i64
) -> RegAllocState with Mut, Panic, Div {
    var s = state
    var act = active
    var kept: i64 = 0
    var i: i64 = 0
    while i < active_count {
        let idx = act[i as usize]
        if s.intervals[idx as usize].end >= position {
            // still live — keep
            act[kept as usize] = idx
            kept = kept + 1
        }
        // else: expired — its preg is released (handled in free_until reset)
        i = i + 1
    }
    // zero-fill tail
    var k = kept
    while k < RA_MAX_ACTIVE {
        act[k as usize] = 0
        k = k + 1
    }
    // Write back — store compacted active in first 64 slots of free_until
    // (ab)use: we actually return via a second call; see linear_scan below.
    s
}

// Count how many active intervals use a given preg.
fn regalloc_preg_in_use(
    state: RegAllocState, active: [i64; 64], active_count: i64, preg: i64
) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < active_count {
        let idx = active[i as usize]
        if state.intervals[idx as usize].assigned_preg == preg {
            return true
        }
        i = i + 1
    }
    false
}

// Find the active interval that ends latest — candidate for spilling.
fn regalloc_find_latest_end(
    state: RegAllocState, active: [i64; 64], active_count: i64
) -> i64 with Mut, Panic, Div {
    var best_idx: i64 = 0 - 1
    var best_end: i64 = 0 - 1
    var i: i64 = 0
    while i < active_count {
        let idx = active[i as usize]
        let e = state.intervals[idx as usize].end
        if e > best_end {
            best_end = e
            best_idx = i
        }
        i = i + 1
    }
    best_idx
}

// Spill the interval with the latest end point.
// Returns (state, active, active_count) via mutation.
fn regalloc_spill_at(
    state: RegAllocState, active: [i64; 64], active_count: i64
) -> RegAllocState with Mut, Panic, Div {
    var s = state
    let victim_active_idx = regalloc_find_latest_end(s, active, active_count)
    if victim_active_idx >= 0 {
        let victim_interval_idx = active[victim_active_idx as usize]
        s.intervals[victim_interval_idx as usize].assigned_preg = RA_SPILLED
        s.intervals[victim_interval_idx as usize].spill_slot = s.spill_count
        s.spill_count = s.spill_count + 1
    }
    s
}

// ============================================================================
// Coalescing hints
// ============================================================================

fn regalloc_add_hint(
    state: RegAllocState, vreg: i64, preferred_preg: i64
) -> RegAllocState with Mut, Panic, Div {
    var s = state
    if s.hint_count < RA_MAX_HINTS {
        s.hints[s.hint_count as usize] = RegHint {
            vreg: vreg,
            preferred_preg: preferred_preg,
        }
        s.hint_count = s.hint_count + 1
    }
    s
}

// Look up the preferred preg for a vreg.  Returns -1 if none.
fn regalloc_lookup_hint(state: RegAllocState, vreg: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < state.hint_count {
        if state.hints[i as usize].vreg == vreg {
            return state.hints[i as usize].preferred_preg
        }
        i = i + 1
    }
    0 - 1
}

// Try to assign the hinted register if it is free.  Returns the preg or -1.
fn regalloc_try_hint(
    state: RegAllocState,
    active: [i64; 64],
    active_count: i64,
    interval_idx: i64
) -> i64 with Mut, Panic, Div {
    let vreg = state.intervals[interval_idx as usize].vreg
    let hint = regalloc_lookup_hint(state, vreg)
    if hint < 0 {
        return 0 - 1
    }
    // Check if the hinted preg is currently in use
    if regalloc_preg_in_use(state, active, active_count, hint) {
        return 0 - 1
    }
    hint
}

// ============================================================================
// Main linear-scan allocation
// ============================================================================

fn regalloc_linear_scan(state: RegAllocState, num_regs: i64) -> RegAllocState with Mut, Panic, Div {
    var s = state
    s.num_pregs = num_regs

    // 1. Sort intervals by start
    s = regalloc_sort_by_start(s)

    // 2. Active set: indices into s.intervals[]
    var active: [i64; 64] = [0; 64]
    var active_count: i64 = 0

    // 3. Walk each interval
    var i: i64 = 0
    while i < s.count {
        let pos = s.intervals[i as usize].start

        // 3a. Expire old intervals
        var new_count: i64 = 0
        var j: i64 = 0
        while j < active_count {
            let aidx = active[j as usize]
            if s.intervals[aidx as usize].end >= pos {
                active[new_count as usize] = aidx
                new_count = new_count + 1
            }
            j = j + 1
        }
        active_count = new_count

        // 3b. Try hinted register first
        let hint_preg = regalloc_try_hint(s, active, active_count, i)
        if hint_preg >= 0 {
            s.intervals[i as usize].assigned_preg = hint_preg
            active[active_count as usize] = i
            active_count = active_count + 1
        } else if active_count >= num_regs {
            // 3c. All registers in use — need to spill
            let victim_pos = regalloc_find_latest_end(s, active, active_count)
            if victim_pos >= 0 {
                let victim_idx = active[victim_pos as usize]
                if s.intervals[victim_idx as usize].end > s.intervals[i as usize].end {
                    // Spill the victim, give its preg to current
                    let stolen_preg = s.intervals[victim_idx as usize].assigned_preg
                    s.intervals[victim_idx as usize].assigned_preg = RA_SPILLED
                    s.intervals[victim_idx as usize].spill_slot = s.spill_count
                    s.spill_count = s.spill_count + 1

                    s.intervals[i as usize].assigned_preg = stolen_preg

                    // Remove victim from active, add current
                    active[victim_pos as usize] = i
                } else {
                    // Current interval ends later — spill it instead
                    s.intervals[i as usize].assigned_preg = RA_SPILLED
                    s.intervals[i as usize].spill_slot = s.spill_count
                    s.spill_count = s.spill_count + 1
                }
            } else {
                // No victim found (should not happen) — spill current
                s.intervals[i as usize].assigned_preg = RA_SPILLED
                s.intervals[i as usize].spill_slot = s.spill_count
                s.spill_count = s.spill_count + 1
            }
        } else {
            // 3d. Free register available — find one
            var found_preg: i64 = 0 - 1
            var p: i64 = 0
            while p < num_regs {
                if !(regalloc_preg_in_use(s, active, active_count, p)) {
                    found_preg = p
                    // break
                    p = num_regs
                } else {
                    p = p + 1
                }
            }
            if found_preg >= 0 {
                s.intervals[i as usize].assigned_preg = found_preg
                active[active_count as usize] = i
                active_count = active_count + 1
            } else {
                // Shouldn't happen if active_count < num_regs, but guard
                s.intervals[i as usize].assigned_preg = RA_SPILLED
                s.intervals[i as usize].spill_slot = s.spill_count
                s.spill_count = s.spill_count + 1
            }
        }

        i = i + 1
    }
    s
}

// ============================================================================
// Query interface
// ============================================================================

// Look up the physical register assigned to a virtual register.
// Returns RA_SPILLED (-1) if the vreg was spilled, RA_UNASSIGNED (-2) if
// the vreg was never seen, or 0..N for a physical register index.
fn regalloc_get_assignment(state: RegAllocState, vreg: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < state.count {
        if state.intervals[i as usize].vreg == vreg {
            return state.intervals[i as usize].assigned_preg
        }
        i = i + 1
    }
    RA_UNASSIGNED
}

// Check whether a virtual register was spilled.
fn regalloc_is_spilled(state: RegAllocState, vreg: i64) -> bool with Mut, Panic, Div {
    regalloc_get_assignment(state, vreg) == RA_SPILLED
}

// Get the spill slot assigned to a virtual register (-1 if not spilled).
fn regalloc_get_spill_slot(state: RegAllocState, vreg: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < state.count {
        if state.intervals[i as usize].vreg == vreg {
            return state.intervals[i as usize].spill_slot
        }
        i = i + 1
    }
    0 - 1
}

// Compute spill summary.
fn regalloc_spill_info(state: RegAllocState) -> SpillInfo {
    SpillInfo {
        total_spills: state.spill_count,
        frame_growth: state.spill_count * 8,
    }
}

// ============================================================================
// Liveness analysis — build live intervals from IR instructions
// ============================================================================

// Liveness workspace: tracks def/use per vreg to build intervals.
struct LivenessMap {
    defs: [i64; 512],    // first definition point per vreg
    uses: [i64; 512],    // last use point per vreg
    seen: [i64; 512],    // 1 if vreg has been seen, 0 otherwise
    max_vreg: i64,
}

fn liveness_map_new() -> LivenessMap {
    LivenessMap {
        defs: [0; 512],
        uses: [0; 512],
        seen: [0; 512],
        max_vreg: 0,
    }
}

// Record a definition of vreg at position.
fn liveness_def_point(
    map: LivenessMap, vreg: i64, position: i64
) -> LivenessMap with Mut, Panic, Div {
    var m = map
    if vreg >= 0 && vreg < 512 {
        if m.seen[vreg as usize] == 0 {
            m.defs[vreg as usize] = position
            m.uses[vreg as usize] = position
            m.seen[vreg as usize] = 1
        }
        // def can extend; take min
        if position < m.defs[vreg as usize] {
            m.defs[vreg as usize] = position
        }
        if vreg >= m.max_vreg {
            m.max_vreg = vreg + 1
        }
    }
    m
}

// Record a use of vreg at position — extends the interval end.
fn liveness_use_point(
    map: LivenessMap, vreg: i64, position: i64
) -> LivenessMap with Mut, Panic, Div {
    var m = map
    if vreg >= 0 && vreg < 512 {
        if m.seen[vreg as usize] == 0 {
            // Use before def (parameter or phi): treat position as both
            m.defs[vreg as usize] = position
            m.uses[vreg as usize] = position
            m.seen[vreg as usize] = 1
        }
        if position > m.uses[vreg as usize] {
            m.uses[vreg as usize] = position
        }
        if vreg >= m.max_vreg {
            m.max_vreg = vreg + 1
        }
    }
    m
}

// Build a RegAllocState from a LivenessMap.
fn liveness_build_intervals(map: LivenessMap) -> RegAllocState with Mut, Panic, Div {
    var s = regalloc_new()
    var v: i64 = 0
    while v < map.max_vreg {
        if map.seen[v as usize] == 1 {
            s = regalloc_add_interval(s, v, map.defs[v as usize], map.uses[v as usize])
        }
        v = v + 1
    }
    s
}

// A simple IR instruction for liveness analysis.
// dst, src1, src2 are virtual register ids (-1 = none).
struct RaSimpleInstr {
    dst:  i64,
    src1: i64,
    src2: i64,
}

fn ra_simple_instr(dst: i64, src1: i64, src2: i64) -> RaSimpleInstr {
    RaSimpleInstr { dst: dst, src1: src1, src2: src2 }
}

fn ra_empty_simple_instr() -> RaSimpleInstr {
    RaSimpleInstr { dst: 0 - 1, src1: 0 - 1, src2: 0 - 1 }
}

// High-level: compute intervals from an array of RaSimpleInstr.
// Walks instructions sequentially, recording defs (dst) and uses (src1, src2).
fn liveness_compute_intervals(
    instrs: [RaSimpleInstr; 512], instr_count: i64
) -> RegAllocState with Mut, Panic, Div {
    var map = liveness_map_new()
    var pos: i64 = 0
    while pos < instr_count {
        let instr = instrs[pos as usize]
        // Record destination as def
        if instr.dst >= 0 {
            map = liveness_def_point(map, instr.dst, pos)
        }
        // Record sources as uses
        if instr.src1 >= 0 {
            map = liveness_use_point(map, instr.src1, pos)
        }
        if instr.src2 >= 0 {
            map = liveness_use_point(map, instr.src2, pos)
        }
        pos = pos + 1
    }
    liveness_build_intervals(map)
}

// ============================================================================
// Utility: dump allocation (for debugging — returns count of assigned regs)
// ============================================================================

fn regalloc_count_assigned(state: RegAllocState) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < state.count {
        if state.intervals[i as usize].assigned_preg >= 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn regalloc_count_spilled(state: RegAllocState) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < state.count {
        if state.intervals[i as usize].assigned_preg == RA_SPILLED {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Check that no two active (non-spilled) intervals with overlapping ranges
// share the same physical register.
fn regalloc_verify_no_conflicts(state: RegAllocState) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < state.count {
        let a = state.intervals[i as usize]
        if a.assigned_preg >= 0 {
            var j = i + 1
            while j < state.count {
                let b = state.intervals[j as usize]
                if b.assigned_preg >= 0 && b.assigned_preg == a.assigned_preg {
                    // Check overlap: [a.start,a.end] and [b.start,b.end]
                    if a.start <= b.end && b.start <= a.end {
                        return false
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    true
}

// ============================================================================
// Tests
// ============================================================================

// T01: empty allocator has zero intervals
fn test_regalloc_empty() -> i64 with Mut, Panic, Div {
    let s = regalloc_new()
    if s.count != 0 { return 1 }
    if s.spill_count != 0 { return 2 }
    if s.num_pregs != 14 { return 3 }
    0
}

// T02: add_interval increments count
fn test_regalloc_add() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 10)
    if s.count != 1 { return 1 }
    s = regalloc_add_interval(s, 1, 2, 8)
    if s.count != 2 { return 2 }
    if s.intervals[0 as usize].vreg != 0 { return 3 }
    if s.intervals[1 as usize].vreg != 1 { return 4 }
    0
}

// T03: sort orders by start
fn test_regalloc_sort() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 10, 20)
    s = regalloc_add_interval(s, 1, 2, 15)
    s = regalloc_add_interval(s, 2, 5, 12)
    s = regalloc_sort_by_start(s)
    if s.intervals[0 as usize].vreg != 1 { return 1 }
    if s.intervals[1 as usize].vreg != 2 { return 2 }
    if s.intervals[2 as usize].vreg != 0 { return 3 }
    0
}

// T04: single interval gets preg 0
fn test_regalloc_single() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 5)
    s = regalloc_linear_scan(s, 4)
    let a = regalloc_get_assignment(s, 0)
    if a < 0 { return 1 }
    if regalloc_is_spilled(s, 0) { return 2 }
    0
}

// T05: two non-overlapping intervals can share one register
fn test_regalloc_nonoverlap() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 5)
    s = regalloc_add_interval(s, 1, 6, 10)
    s = regalloc_linear_scan(s, 1)
    // Both should be assigned (the same preg reused after expire)
    if regalloc_is_spilled(s, 0) { return 1 }
    if regalloc_is_spilled(s, 1) { return 2 }
    0
}

// T06: two overlapping intervals with 1 reg -> one spilled
fn test_regalloc_overlap_spill() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 10)
    s = regalloc_add_interval(s, 1, 3, 8)
    s = regalloc_linear_scan(s, 1)
    let spilled = regalloc_count_spilled(s)
    if spilled != 1 { return 1 }
    let assigned = regalloc_count_assigned(s)
    if assigned != 1 { return 2 }
    0
}

// T07: three intervals, two regs, no spill needed when ranges don't all overlap
fn test_regalloc_three_fit() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 5)
    s = regalloc_add_interval(s, 1, 2, 10)
    s = regalloc_add_interval(s, 2, 6, 12)
    s = regalloc_linear_scan(s, 2)
    // vreg 0 ends at 5, vreg 2 starts at 6 -> they can share a preg
    if regalloc_count_spilled(s) != 0 { return 1 }
    if !(regalloc_verify_no_conflicts(s)) { return 2 }
    0
}

// T08: spill count and frame growth
fn test_regalloc_spill_info() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 20)
    s = regalloc_add_interval(s, 1, 1, 19)
    s = regalloc_add_interval(s, 2, 2, 18)
    s = regalloc_linear_scan(s, 2)
    let info = regalloc_spill_info(s)
    if info.total_spills != 1 { return 1 }
    if info.frame_growth != 8 { return 2 }
    0
}

// T09: get_spill_slot returns correct slot index
fn test_regalloc_spill_slot() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 20)
    s = regalloc_add_interval(s, 1, 1, 19)
    s = regalloc_add_interval(s, 2, 2, 18)
    s = regalloc_linear_scan(s, 2)
    // One of them got spilled — find which
    var spilled_vreg: i64 = 0 - 1
    if regalloc_is_spilled(s, 0) { spilled_vreg = 0 }
    if regalloc_is_spilled(s, 1) { spilled_vreg = 1 }
    if regalloc_is_spilled(s, 2) { spilled_vreg = 2 }
    if spilled_vreg < 0 { return 1 }
    let slot = regalloc_get_spill_slot(s, spilled_vreg)
    if slot < 0 { return 2 }
    0
}

// T10: hints are respected when register is free
fn test_regalloc_hint_respected() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 10)
    s = regalloc_add_hint(s, 0, 3)
    s = regalloc_linear_scan(s, 8)
    let a = regalloc_get_assignment(s, 0)
    if a != 3 { return 1 }
    0
}

// T11: hints ignored when hinted preg is occupied
fn test_regalloc_hint_busy() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 10)
    s = regalloc_add_interval(s, 1, 1, 8)
    // Both want preg 0
    s = regalloc_add_hint(s, 0, 0)
    s = regalloc_add_hint(s, 1, 0)
    s = regalloc_linear_scan(s, 4)
    // vreg 0 should get preg 0 (arrives first)
    let a0 = regalloc_get_assignment(s, 0)
    let a1 = regalloc_get_assignment(s, 1)
    if a0 != 0 { return 1 }
    // vreg 1 should get some other preg (hint was busy)
    if a1 == 0 { return 2 }
    if a1 < 0 { return 3 }
    0
}

// T12: no-conflict verification passes for valid allocation
fn test_regalloc_verify_ok() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 5)
    s = regalloc_add_interval(s, 1, 3, 10)
    s = regalloc_add_interval(s, 2, 6, 15)
    s = regalloc_linear_scan(s, 4)
    if !(regalloc_verify_no_conflicts(s)) { return 1 }
    0
}

// T13: liveness_def_point and liveness_use_point
fn test_liveness_points() -> i64 with Mut, Panic, Div {
    var m = liveness_map_new()
    m = liveness_def_point(m, 0, 5)
    m = liveness_use_point(m, 0, 12)
    if m.defs[0 as usize] != 5 { return 1 }
    if m.uses[0 as usize] != 12 { return 2 }
    if m.seen[0 as usize] != 1 { return 3 }
    m = liveness_def_point(m, 0, 3)
    // def should update to earlier position
    if m.defs[0 as usize] != 3 { return 4 }
    0
}

// T14: liveness_build_intervals creates correct count
fn test_liveness_build() -> i64 with Mut, Panic, Div {
    var m = liveness_map_new()
    m = liveness_def_point(m, 0, 0)
    m = liveness_use_point(m, 0, 5)
    m = liveness_def_point(m, 1, 2)
    m = liveness_use_point(m, 1, 7)
    m = liveness_def_point(m, 3, 4)
    m = liveness_use_point(m, 3, 10)
    let s = liveness_build_intervals(m)
    if s.count != 3 { return 1 }
    0
}

// T15: end-to-end liveness + allocation
fn test_liveness_allocate() -> i64 with Mut, Panic, Div {
    var m = liveness_map_new()
    // Simulate a small function: 4 vregs
    m = liveness_def_point(m, 0, 0)
    m = liveness_use_point(m, 0, 3)
    m = liveness_def_point(m, 1, 1)
    m = liveness_use_point(m, 1, 5)
    m = liveness_def_point(m, 2, 4)
    m = liveness_use_point(m, 2, 7)
    m = liveness_def_point(m, 3, 6)
    m = liveness_use_point(m, 3, 9)
    var s = liveness_build_intervals(m)
    s = regalloc_linear_scan(s, 3)
    if regalloc_count_spilled(s) != 0 { return 1 }
    if !(regalloc_verify_no_conflicts(s)) { return 2 }
    0
}

// T16: many intervals with limited registers forces spills
fn test_regalloc_pressure() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    // 8 overlapping intervals, only 3 regs
    var v: i64 = 0
    while v < 8 {
        s = regalloc_add_interval(s, v, v, v + 10)
        v = v + 1
    }
    s = regalloc_linear_scan(s, 3)
    let spilled = regalloc_count_spilled(s)
    if spilled < 1 { return 1 }
    if !(regalloc_verify_no_conflicts(s)) { return 2 }
    0
}

// T17: sort stability — same start, shorter interval first
fn test_regalloc_sort_tiebreak() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 5, 20)
    s = regalloc_add_interval(s, 1, 5, 10)
    s = regalloc_add_interval(s, 2, 5, 15)
    s = regalloc_sort_by_start(s)
    // shortest first: vreg 1 (end=10), then vreg 2 (end=15), then vreg 0 (end=20)
    if s.intervals[0 as usize].vreg != 1 { return 1 }
    if s.intervals[1 as usize].vreg != 2 { return 2 }
    if s.intervals[2 as usize].vreg != 0 { return 3 }
    0
}

// T18: lookup of unassigned vreg
fn test_regalloc_unassigned() -> i64 with Mut, Panic, Div {
    let s = regalloc_new()
    let a = regalloc_get_assignment(s, 42)
    if a != RA_UNASSIGNED { return 1 }
    if regalloc_is_spilled(s, 42) { return 2 }
    0
}

// T19: liveness map max_vreg tracking
fn test_liveness_max_vreg() -> i64 with Mut, Panic, Div {
    var m = liveness_map_new()
    m = liveness_def_point(m, 7, 0)
    if m.max_vreg != 8 { return 1 }
    m = liveness_def_point(m, 3, 1)
    if m.max_vreg != 8 { return 2 }
    m = liveness_def_point(m, 15, 2)
    if m.max_vreg != 16 { return 3 }
    0
}

// T20: zero-length intervals (def and last use at same point)
fn test_regalloc_zero_length() -> i64 with Mut, Panic, Div {
    var s = regalloc_new()
    s = regalloc_add_interval(s, 0, 0, 0)
    s = regalloc_add_interval(s, 1, 1, 1)
    s = regalloc_add_interval(s, 2, 2, 2)
    s = regalloc_linear_scan(s, 1)
    // Each expires before the next starts -> no spills with 1 reg
    if regalloc_count_spilled(s) != 0 { return 1 }
    0
}

// ============================================================================
// Test runner
// ============================================================================

fn regalloc_run_tests() -> i64 with Mut, Panic, Div {
    var fail: i64 = 0

    let t01 = test_regalloc_empty()
    if t01 != 0 { print_int(101) fail = fail + 1 }

    let t02 = test_regalloc_add()
    if t02 != 0 { print_int(102) fail = fail + 1 }

    let t03 = test_regalloc_sort()
    if t03 != 0 { print_int(103) fail = fail + 1 }

    let t04 = test_regalloc_single()
    if t04 != 0 { print_int(104) fail = fail + 1 }

    let t05 = test_regalloc_nonoverlap()
    if t05 != 0 { print_int(105) fail = fail + 1 }

    let t06 = test_regalloc_overlap_spill()
    if t06 != 0 { print_int(106) fail = fail + 1 }

    let t07 = test_regalloc_three_fit()
    if t07 != 0 { print_int(107) fail = fail + 1 }

    let t08 = test_regalloc_spill_info()
    if t08 != 0 { print_int(108) fail = fail + 1 }

    let t09 = test_regalloc_spill_slot()
    if t09 != 0 { print_int(109) fail = fail + 1 }

    let t10 = test_regalloc_hint_respected()
    if t10 != 0 { print_int(110) fail = fail + 1 }

    let t11 = test_regalloc_hint_busy()
    if t11 != 0 { print_int(111) fail = fail + 1 }

    let t12 = test_regalloc_verify_ok()
    if t12 != 0 { print_int(112) fail = fail + 1 }

    let t13 = test_liveness_points()
    if t13 != 0 { print_int(113) fail = fail + 1 }

    let t14 = test_liveness_build()
    if t14 != 0 { print_int(114) fail = fail + 1 }

    let t15 = test_liveness_allocate()
    if t15 != 0 { print_int(115) fail = fail + 1 }

    let t16 = test_regalloc_pressure()
    if t16 != 0 { print_int(116) fail = fail + 1 }

    let t17 = test_regalloc_sort_tiebreak()
    if t17 != 0 { print_int(117) fail = fail + 1 }

    let t18 = test_regalloc_unassigned()
    if t18 != 0 { print_int(118) fail = fail + 1 }

    let t19 = test_liveness_max_vreg()
    if t19 != 0 { print_int(119) fail = fail + 1 }

    let t20 = test_regalloc_zero_length()
    if t20 != 0 { print_int(120) fail = fail + 1 }

    fail
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/native/codegen_plan.sio  (1666 lines)
// ════════════════════════════════════════════════════════════════

// self-hosted::native::codegen_plan — Code generation planning and scheduling
//
// Implements instruction scheduling for a compiler backend.  Given a block of
// low-level instructions with register operands and latency information, this
// module builds a dependency graph and applies list scheduling to produce an
// execution order that respects data/anti/output/control dependencies while
// attempting to minimise register pressure and total cycle count.
//
// Algorithm:  List scheduling with critical-path priority (Gibbons & Muchnick,
// "Efficient instruction scheduling for a pipelined architecture", 1986).

// ============================================================================
// Constants
// ============================================================================

let DEP_DATA: i64 = 1        // true (flow) dependency: write -> read
let DEP_ANTI: i64 = 2        // anti dependency: read -> write
let DEP_OUTPUT: i64 = 3      // output dependency: write -> write
let DEP_CONTROL: i64 = 4     // control dependency (branches, barriers)

let CGPLAN_MAX_INSTRS: i64 = 512
let CGPLAN_MAX_DEPS: i64 = 2048
let CGPLAN_MAX_BLOCKS: i64 = 256
let CGPLAN_MAX_CYCLES: i64 = 512

// Opcode constants for peephole patterns
let CGOP_NOP: i64 = 0
let CGOP_MOV: i64 = 1
let CGOP_ADD: i64 = 2
let CGOP_SUB: i64 = 3
let CGOP_MUL: i64 = 4
let CGOP_DIV: i64 = 5
let CGOP_LOAD: i64 = 6
let CGOP_STORE: i64 = 7
let CGOP_CMP: i64 = 8
let CGOP_BRANCH: i64 = 9
let CGOP_CALL: i64 = 10
let CGOP_RET: i64 = 11

// Sentinel values
let REG_NONE: i64 = 0 - 1
let CYCLE_INF: i64 = 999999

// ============================================================================
// Core data structures
// ============================================================================

// A single instruction in the scheduling model.
struct CodegenInstr {
    id: i64,              // unique instruction index within block
    opcode: i64,          // operation kind (OP_* constants)
    dst_reg: i64,         // destination register (-1 = none)
    src1_reg: i64,        // first source register (-1 = none)
    src2_reg: i64,        // second source register (-1 = none)
    latency: i64,         // execution latency in cycles
    is_scheduled: bool,   // true if already placed in the schedule
    earliest_cycle: i64,  // earliest cycle this instr can execute
}

// A dependency edge between two instructions.
struct DepEdge {
    from_id: i64,         // producer instruction id
    to_id: i64,           // consumer instruction id
    kind: i64,            // DEP_DATA, DEP_ANTI, DEP_OUTPUT, DEP_CONTROL
    latency: i64,         // minimum cycles between producer issue and consumer issue
}

// A basic block with its instructions, dependency graph, and schedule.
struct CodegenBlock {
    instrs: [CodegenInstr; 512],
    instr_count: i64,
    schedule: [i64; 512],       // ordered list of instruction ids
    schedule_len: i64,
    deps: [DepEdge; 2048],
    dep_count: i64,
    cycle_count: i64,           // total cycles after scheduling
}

// Top-level scheduling plan: a collection of blocks with global metrics.
struct CodegenPlan {
    blocks: [CodegenBlock; 256],
    block_count: i64,
    reg_pressure: [i64; 512],   // register pressure per cycle
    spill_slots: i64,           // number of spill slots needed
    total_cycles: i64,          // sum of all block cycle counts
}

// ============================================================================
// Constructors
// ============================================================================

fn codegen_instr_new(
    id: i64, opcode: i64, dst_reg: i64, src1_reg: i64, src2_reg: i64, latency: i64
) -> CodegenInstr {
    CodegenInstr {
        id: id,
        opcode: opcode,
        dst_reg: dst_reg,
        src1_reg: src1_reg,
        src2_reg: src2_reg,
        latency: latency,
        is_scheduled: false,
        earliest_cycle: 0,
    }
}

fn empty_codegen_instr() -> CodegenInstr {
    CodegenInstr {
        id: 0,
        opcode: CGOP_NOP,
        dst_reg: REG_NONE,
        src1_reg: REG_NONE,
        src2_reg: REG_NONE,
        latency: 1,
        is_scheduled: false,
        earliest_cycle: 0,
    }
}

fn dep_edge_new(from_id: i64, to_id: i64, kind: i64, latency: i64) -> DepEdge {
    DepEdge {
        from_id: from_id,
        to_id: to_id,
        kind: kind,
        latency: latency,
    }
}

fn empty_dep_edge() -> DepEdge {
    DepEdge {
        from_id: 0,
        to_id: 0,
        kind: DEP_DATA,
        latency: 0,
    }
}

fn codegen_block_new() -> CodegenBlock {
    CodegenBlock {
        instrs: [empty_codegen_instr(); 512],
        instr_count: 0,
        schedule: [0; 512],
        schedule_len: 0,
        deps: [empty_dep_edge(); 2048],
        dep_count: 0,
        cycle_count: 0,
    }
}

fn codegen_plan_new() -> CodegenPlan {
    CodegenPlan {
        blocks: [codegen_block_new(); 256],
        block_count: 0,
        reg_pressure: [0; 512],
        spill_slots: 0,
        total_cycles: 0,
    }
}

// ============================================================================
// Instruction and dependency management
// ============================================================================

// Add an instruction to block 0 (convenience for single-block plans).
fn cgplan_add_instr(
    plan: CodegenPlan, instr: CodegenInstr
) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        p.block_count = 1
    }
    let bi: i64 = 0
    if p.blocks[bi as usize].instr_count < CGPLAN_MAX_INSTRS {
        let idx = p.blocks[bi as usize].instr_count
        p.blocks[bi as usize].instrs[idx as usize] = instr
        p.blocks[bi as usize].instr_count = idx + 1
    }
    p
}

// Add an instruction to a specific block.
fn cgplan_add_instr_to_block(
    plan: CodegenPlan, block_idx: i64, instr: CodegenInstr
) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if block_idx >= p.block_count {
        p.block_count = block_idx + 1
    }
    if p.blocks[block_idx as usize].instr_count < CGPLAN_MAX_INSTRS {
        let idx = p.blocks[block_idx as usize].instr_count
        p.blocks[block_idx as usize].instrs[idx as usize] = instr
        p.blocks[block_idx as usize].instr_count = idx + 1
    }
    p
}

// Add a dependency edge to block 0.
fn cgplan_add_dep(
    plan: CodegenPlan, edge: DepEdge
) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        p.block_count = 1
    }
    let bi: i64 = 0
    if p.blocks[bi as usize].dep_count < CGPLAN_MAX_DEPS {
        let idx = p.blocks[bi as usize].dep_count
        p.blocks[bi as usize].deps[idx as usize] = edge
        p.blocks[bi as usize].dep_count = idx + 1
    }
    p
}

// Add a dependency edge to a specific block.
fn cgplan_add_dep_to_block(
    plan: CodegenPlan, block_idx: i64, edge: DepEdge
) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if block_idx < CGPLAN_MAX_BLOCKS {
        if p.blocks[block_idx as usize].dep_count < CGPLAN_MAX_DEPS {
            let idx = p.blocks[block_idx as usize].dep_count
            p.blocks[block_idx as usize].deps[idx as usize] = edge
            p.blocks[block_idx as usize].dep_count = idx + 1
        }
    }
    p
}

// ============================================================================
// Dependency analysis — auto-detect from register defs/uses
// ============================================================================

// Find the last instruction that writes to `reg` before position `pos`.
// Returns -1 if no such instruction exists.
fn cgplan_find_last_writer(
    block: CodegenBlock, reg: i64, before_pos: i64
) -> i64 with Mut, Div, Panic {
    var result: i64 = 0 - 1
    var i: i64 = 0
    while i < before_pos {
        if i < block.instr_count {
            if block.instrs[i as usize].dst_reg == reg {
                result = i
            }
        }
        i = i + 1
    }
    result
}

// Find the last instruction that reads `reg` before position `pos`.
// Returns -1 if no such instruction exists.
fn cgplan_find_last_reader(
    block: CodegenBlock, reg: i64, before_pos: i64
) -> i64 with Mut, Div, Panic {
    var result: i64 = 0 - 1
    var i: i64 = 0
    while i < before_pos {
        if i < block.instr_count {
            let instr = block.instrs[i as usize]
            if instr.src1_reg == reg || instr.src2_reg == reg {
                result = i
            }
        }
        i = i + 1
    }
    result
}

// Build dependencies for every block by scanning register defs and uses.
// Detects:
//   - DATA deps: write(r) -> read(r)
//   - ANTI deps: read(r) -> write(r)
//   - OUTPUT deps: write(r) -> write(r)
//   - CONTROL deps: branch/call/ret -> all subsequent instrs
fn cgplan_build_deps(plan: CodegenPlan) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        return p
    }
    var bi: i64 = 0
    while bi < p.block_count {
        p.blocks[bi as usize].dep_count = 0

        var i: i64 = 0
        while i < p.blocks[bi as usize].instr_count {
            let instr = p.blocks[bi as usize].instrs[i as usize]

            if instr.src1_reg >= 0 {
                let writer = cgplan_find_last_writer(p.blocks[bi as usize], instr.src1_reg, i)
                if writer >= 0 {
                    let lat = p.blocks[bi as usize].instrs[writer as usize].latency
                    let edge = dep_edge_new(writer, i, DEP_DATA, lat)
                    p = cgplan_add_dep_to_block(p, bi, edge)
                }
            }
            if instr.src2_reg >= 0 {
                let writer = cgplan_find_last_writer(p.blocks[bi as usize], instr.src2_reg, i)
                if writer >= 0 {
                    let lat = p.blocks[bi as usize].instrs[writer as usize].latency
                    let edge = dep_edge_new(writer, i, DEP_DATA, lat)
                    p = cgplan_add_dep_to_block(p, bi, edge)
                }
            }

            if instr.dst_reg >= 0 {
                let reader = cgplan_find_last_reader(p.blocks[bi as usize], instr.dst_reg, i)
                if reader >= 0 {
                    let edge = dep_edge_new(reader, i, DEP_ANTI, 0)
                    p = cgplan_add_dep_to_block(p, bi, edge)
                }
            }

            if instr.dst_reg >= 0 {
                let prev_writer = cgplan_find_last_writer(p.blocks[bi as usize], instr.dst_reg, i)
                if prev_writer >= 0 {
                    let edge = dep_edge_new(prev_writer, i, DEP_OUTPUT, 1)
                    p = cgplan_add_dep_to_block(p, bi, edge)
                }
            }

            if instr.opcode == CGOP_BRANCH || instr.opcode == CGOP_CALL || instr.opcode == CGOP_RET {
                var j: i64 = 0
                while j < i {
                    let prior = p.blocks[bi as usize].instrs[j as usize]
                    let has_dep = cgplan_has_dep(p, bi, j, i)
                    if !(has_dep) {
                        let edge = dep_edge_new(j, i, DEP_CONTROL, prior.latency)
                        p = cgplan_add_dep_to_block(p, bi, edge)
                    }
                    j = j + 1
                }
            }

            i = i + 1
        }
        bi = bi + 1
    }
    p
}

// Check whether a dependency from `from_id` to `to_id` already exists in a block.
fn cgplan_has_dep(
    plan: CodegenPlan, block_idx: i64, from_id: i64, to_id: i64
) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    let count = plan.blocks[block_idx as usize].dep_count
    while i < count {
        let edge = plan.blocks[block_idx as usize].deps[i as usize]
        if edge.from_id == from_id && edge.to_id == to_id {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================================
// Priority computation — critical path length
// ============================================================================

// Compute the critical path length from instruction `instr_id` to any leaf.
// Uses a recursive approach with memoisation via the priorities array.
// priorities[i] = -1 means not yet computed.
fn cgplan_compute_priority_inner(
    block: CodegenBlock, instr_id: i64, priorities: [i64; 512]
) -> [i64; 512] with Mut, Div, Panic {
    var prio = priorities
    if prio[instr_id as usize] >= 0 {
        return prio
    }

    // Base: instruction latency
    var max_succ_prio: i64 = 0

    // Walk all deps where this instr is the source (from_id == instr_id)
    var d: i64 = 0
    while d < block.dep_count {
        let edge = block.deps[d as usize]
        if edge.from_id == instr_id {
            // Recurse into successor
            prio = cgplan_compute_priority_inner(block, edge.to_id, prio)
            let succ_total = edge.latency + prio[edge.to_id as usize]
            if succ_total > max_succ_prio {
                max_succ_prio = succ_total
            }
        }
        d = d + 1
    }

    prio[instr_id as usize] = block.instrs[instr_id as usize].latency + max_succ_prio
    prio
}

// Compute scheduling priorities for all instructions in all blocks.
// Higher priority = longer critical path = should be scheduled first.
fn cgplan_compute_priority(plan: CodegenPlan) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        return p
    }
    var bi: i64 = 0
    while bi < p.block_count {
        var prio: [i64; 512] = [0; 512]
        var k: i64 = 0
        while k < CGPLAN_MAX_INSTRS {
            prio[k as usize] = 0 - 1
            k = k + 1
        }

        var i: i64 = 0
        while i < p.blocks[bi as usize].instr_count {
            prio = cgplan_compute_priority_inner(p.blocks[bi as usize], i, prio)
            i = i + 1
        }

        var j: i64 = 0
        while j < p.blocks[bi as usize].instr_count {
            p.blocks[bi as usize].instrs[j as usize].earliest_cycle = prio[j as usize]
            j = j + 1
        }
        bi = bi + 1
    }
    p
}

// Return the maximum critical path length across all blocks.
fn cgplan_critical_path(plan: CodegenPlan) -> i64 with Mut, Div, Panic {
    if plan.block_count == 0 {
        return 0
    }
    var max_cp: i64 = 0
    var bi: i64 = 0
    while bi < plan.block_count {
        var i: i64 = 0
        while i < plan.blocks[bi as usize].instr_count {
            let cp = plan.blocks[bi as usize].instrs[i as usize].earliest_cycle
            if cp > max_cp {
                max_cp = cp
            }
            i = i + 1
        }
        bi = bi + 1
    }
    max_cp
}

// ============================================================================
// Readiness check — can an instruction be issued at a given cycle?
// ============================================================================

// Check if all predecessors of `instr_id` have been scheduled and their
// latencies are satisfied by `cycle`.
fn cgplan_check_ready(
    plan: CodegenPlan, block_idx: i64, instr_id: i64, cycle: i64
) -> bool with Mut, Div, Panic {
    let block = plan.blocks[block_idx as usize]
    let instr = block.instrs[instr_id as usize]

    // Already scheduled -> not ready (already done)
    if instr.is_scheduled {
        return false
    }

    // Check all incoming dependency edges
    var d: i64 = 0
    while d < block.dep_count {
        let edge = block.deps[d as usize]
        if edge.to_id == instr_id {
            let pred = block.instrs[edge.from_id as usize]
            // Predecessor must be scheduled
            if !(pred.is_scheduled) {
                return false
            }
            // Predecessor must have completed: scheduled_cycle + latency <= cycle
            // We use earliest_cycle to store the scheduled cycle after scheduling
            // For readiness, check: pred.earliest_cycle + edge.latency <= cycle
            // But during scheduling, we track scheduled cycles in the schedule array.
            // Use a simpler model: the predecessor's earliest_cycle is its issue cycle.
            // Then the consumer can issue at pred.earliest_cycle + edge.latency.
            let pred_done = pred.earliest_cycle + edge.latency
            if pred_done > cycle {
                return false
            }
        }
        d = d + 1
    }
    true
}

// ============================================================================
// List scheduling
// ============================================================================

// Count the number of successors (outgoing deps) for an instruction.
fn cgplan_count_successors(block: CodegenBlock, instr_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var d: i64 = 0
    while d < block.dep_count {
        if block.deps[d as usize].from_id == instr_id {
            count = count + 1
        }
        d = d + 1
    }
    count
}

// Count the number of predecessors (incoming deps) for an instruction.
fn cgplan_count_predecessors(block: CodegenBlock, instr_id: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var d: i64 = 0
    while d < block.dep_count {
        if block.deps[d as usize].to_id == instr_id {
            count = count + 1
        }
        d = d + 1
    }
    count
}

// Find the highest-priority ready instruction at `cycle`.  Returns -1 if none ready.
// Priority is stored in earliest_cycle after cgplan_compute_priority.
// During scheduling, we save the original priority in a temporary, then
// overwrite earliest_cycle with the actual issue cycle.
fn cgplan_pick_best_ready(
    plan: CodegenPlan, block_idx: i64, cycle: i64, saved_prio: [i64; 512]
) -> i64 with Mut, Div, Panic {
    var best_id: i64 = 0 - 1
    var best_prio: i64 = 0 - 1
    let block = plan.blocks[block_idx as usize]

    var i: i64 = 0
    while i < block.instr_count {
        if !(block.instrs[i as usize].is_scheduled) {
            let ready = cgplan_check_ready(plan, block_idx, i, cycle)
            if ready {
                let p = saved_prio[i as usize]
                if p > best_prio {
                    best_prio = p
                    best_id = i
                }
            }
        }
        i = i + 1
    }
    best_id
}

// Main list scheduling pass for all blocks.
// Steps:
//   1. Compute priorities via critical path
//   2. Save priorities (will be overwritten with issue cycles)
//   3. At each cycle, pick the highest-priority ready instruction
//   4. Mark it scheduled, record its issue cycle
//   5. Advance cycle counter
fn cgplan_list_schedule(plan: CodegenPlan) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        return p
    }
    p = cgplan_compute_priority(p)

    p.total_cycles = 0
    var bi: i64 = 0
    while bi < p.block_count {
        let n = p.blocks[bi as usize].instr_count
        if n > 0 {
            var saved_prio: [i64; 512] = [0; 512]
            var k: i64 = 0
            while k < n {
                saved_prio[k as usize] = p.blocks[bi as usize].instrs[k as usize].earliest_cycle
                k = k + 1
            }

            var ri: i64 = 0
            while ri < n {
                p.blocks[bi as usize].instrs[ri as usize].is_scheduled = false
                p.blocks[bi as usize].instrs[ri as usize].earliest_cycle = 0
                ri = ri + 1
            }
            p.blocks[bi as usize].schedule_len = 0

            var scheduled_count: i64 = 0
            var cycle: i64 = 0
            var stall_limit: i64 = n * 10

            while scheduled_count < n && cycle < stall_limit {
                let best = cgplan_pick_best_ready(p, bi, cycle, saved_prio)
                if best >= 0 {
                    p.blocks[bi as usize].instrs[best as usize].is_scheduled = true
                    p.blocks[bi as usize].instrs[best as usize].earliest_cycle = cycle
                    p.blocks[bi as usize].schedule[scheduled_count as usize] = best
                    scheduled_count = scheduled_count + 1
                    cycle = cycle + 1
                } else {
                    cycle = cycle + 1
                }
            }

            p.blocks[bi as usize].schedule_len = scheduled_count
            p.blocks[bi as usize].cycle_count = cycle
            p.total_cycles = p.total_cycles + cycle
        }
        bi = bi + 1
    }
    p
}

// ============================================================================
// Register pressure estimation
// ============================================================================

// A register is "live" from the cycle it is defined until the cycle of its
// last use.  We approximate this by walking the schedule and tracking which
// destination registers are live at each cycle.

// Find the latest cycle at which register `reg` is used as a source.
fn cgplan_last_use_cycle(
    block: CodegenBlock, reg: i64
) -> i64 with Mut, Div, Panic {
    var last: i64 = 0 - 1
    var i: i64 = 0
    while i < block.schedule_len {
        let iid = block.schedule[i as usize]
        let instr = block.instrs[iid as usize]
        let cyc = instr.earliest_cycle
        if instr.src1_reg == reg || instr.src2_reg == reg {
            if cyc > last {
                last = cyc
            }
        }
        i = i + 1
    }
    last
}

// Estimate register pressure across the concatenated per-block schedules.
// Stores into plan.reg_pressure[cycle] = number of live registers at that cycle.
fn cgplan_estimate_pressure(plan: CodegenPlan) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        return p
    }
    var c: i64 = 0
    while c < CGPLAN_MAX_CYCLES {
        p.reg_pressure[c as usize] = 0
        c = c + 1
    }

    var block_base_cycle: i64 = 0
    var bi: i64 = 0
    while bi < p.block_count {
        let block = p.blocks[bi as usize]
        var si: i64 = 0
        while si < block.schedule_len {
            let iid = block.schedule[si as usize]
            let instr = block.instrs[iid as usize]
            let dst = instr.dst_reg
            if dst >= 0 {
                let def_cyc = instr.earliest_cycle
                let last_use = cgplan_last_use_cycle(block, dst)
                var end_cyc = def_cyc
                if last_use >= def_cyc {
                    end_cyc = last_use
                }
                if end_cyc >= CGPLAN_MAX_CYCLES {
                    end_cyc = CGPLAN_MAX_CYCLES - 1
                }
                var cyc: i64 = def_cyc
                while cyc <= end_cyc {
                    let global_cyc = block_base_cycle + cyc
                    if global_cyc >= 0 && global_cyc < CGPLAN_MAX_CYCLES {
                        p.reg_pressure[global_cyc as usize] = p.reg_pressure[global_cyc as usize] + 1
                    }
                    cyc = cyc + 1
                }
            }
            si = si + 1
        }
        block_base_cycle = block_base_cycle + block.cycle_count
        bi = bi + 1
    }
    p
}

// Return the maximum register pressure across all cycles.
fn cgplan_max_pressure(plan: CodegenPlan) -> i64 with Mut, Div, Panic {
    var max_p: i64 = 0
    var c: i64 = 0
    let limit = plan.total_cycles
    while c < limit {
        if c < CGPLAN_MAX_CYCLES {
            if plan.reg_pressure[c as usize] > max_p {
                max_p = plan.reg_pressure[c as usize]
            }
        }
        c = c + 1
    }
    max_p
}

// ============================================================================
// Spill detection
// ============================================================================

// Detect instructions at cycles where register pressure exceeds `max_regs`.
// Returns the number of spill slots needed (one per excess register).
fn cgplan_detect_spills(plan: CodegenPlan, max_regs: i64) -> i64 with Mut, Div, Panic {
    var spills: i64 = 0
    var c: i64 = 0
    let limit = plan.total_cycles
    while c < limit {
        if c < CGPLAN_MAX_CYCLES {
            let pressure = plan.reg_pressure[c as usize]
            if pressure > max_regs {
                let excess = pressure - max_regs
                if excess > spills {
                    spills = excess
                }
            }
        }
        c = c + 1
    }
    spills
}

// Update the plan's spill_slots field based on detected spills.
fn cgplan_update_spills(plan: CodegenPlan, max_regs: i64) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    p.spill_slots = cgplan_detect_spills(p, max_regs)
    p
}

// ============================================================================
// Reorder for pressure — swap adjacent instructions to reduce register pressure
// ============================================================================

// Check whether instruction `a` depends on instruction `b` (directly).
fn cgplan_depends_on(
    block: CodegenBlock, a: i64, b: i64
) -> bool with Mut, Div, Panic {
    var d: i64 = 0
    while d < block.dep_count {
        let edge = block.deps[d as usize]
        if edge.from_id == b && edge.to_id == a {
            return true
        }
        d = d + 1
    }
    false
}

// Attempt to reorder the schedule to reduce register pressure.
// Uses a simple bubble-pass: if swapping two adjacent instructions (that are
// not dependent) would reduce peak pressure, do the swap.
fn cgplan_reorder_for_pressure(plan: CodegenPlan, max_regs: i64) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        return p
    }
    var bi: i64 = 0
    while bi < p.block_count {
        let slen = p.blocks[bi as usize].schedule_len

        var pass: i64 = 0
        while pass < 3 {
            var i: i64 = 0
            while i < slen - 1 {
                let id_a = p.blocks[bi as usize].schedule[i as usize]
                let id_b = p.blocks[bi as usize].schedule[(i + 1) as usize]
                let a_dep_b = cgplan_depends_on(p.blocks[bi as usize], id_a, id_b)
                let b_dep_a = cgplan_depends_on(p.blocks[bi as usize], id_b, id_a)
                if !(a_dep_b) && !(b_dep_a) {
                    let a_dst = p.blocks[bi as usize].instrs[id_a as usize].dst_reg
                    let b_dst = p.blocks[bi as usize].instrs[id_b as usize].dst_reg
                    let a_has_dst = if a_dst >= 0 { 1 } else { 0 }
                    let b_has_dst = if b_dst >= 0 { 1 } else { 0 }
                    if a_has_dst > b_has_dst {
                        p.blocks[bi as usize].schedule[i as usize] = id_b
                        p.blocks[bi as usize].schedule[(i + 1) as usize] = id_a
                    }
                }
                i = i + 1
            }
            pass = pass + 1
        }

        var si: i64 = 0
        while si < slen {
            let iid = p.blocks[bi as usize].schedule[si as usize]
            p.blocks[bi as usize].instrs[iid as usize].earliest_cycle = si
            si = si + 1
        }
        bi = bi + 1
    }

    p = cgplan_estimate_pressure(p)
    p = cgplan_update_spills(p, max_regs)
    p
}

// ============================================================================
// Peephole optimisations on the schedule
// ============================================================================

// Peephole pass: look for simple patterns in the scheduled instruction stream
// and replace with more efficient sequences.
// Patterns:
//   1. MOV r, r (self-move) -> NOP
//   2. ADD r, 0 -> NOP
//   3. SUB r, 0 -> NOP
//   4. MUL r, 1 -> NOP (identity multiply)
//   5. Consecutive MOVs: MOV a, b; MOV b, a -> remove second
fn cgplan_peephole(plan: CodegenPlan) -> CodegenPlan with Mut, Div, Panic {
    var p = plan
    if p.block_count == 0 {
        return p
    }
    var bi: i64 = 0
    while bi < p.block_count {
        let n = p.blocks[bi as usize].instr_count

        var i: i64 = 0
        while i < n {
            let instr = p.blocks[bi as usize].instrs[i as usize]
            if instr.opcode == CGOP_MOV {
                if instr.dst_reg == instr.src1_reg && instr.dst_reg >= 0 {
                    p.blocks[bi as usize].instrs[i as usize].opcode = CGOP_NOP
                    p.blocks[bi as usize].instrs[i as usize].dst_reg = REG_NONE
                    p.blocks[bi as usize].instrs[i as usize].src1_reg = REG_NONE
                    p.blocks[bi as usize].instrs[i as usize].src2_reg = REG_NONE
                    p.blocks[bi as usize].instrs[i as usize].latency = 0
                }
            }
            i = i + 1
        }

        var j: i64 = 0
        while j < n {
            let instr = p.blocks[bi as usize].instrs[j as usize]
            if instr.opcode == CGOP_ADD && instr.src2_reg == REG_NONE {
                if instr.dst_reg == instr.src1_reg {
                    p.blocks[bi as usize].instrs[j as usize].opcode = CGOP_NOP
                    p.blocks[bi as usize].instrs[j as usize].dst_reg = REG_NONE
                    p.blocks[bi as usize].instrs[j as usize].src1_reg = REG_NONE
                    p.blocks[bi as usize].instrs[j as usize].latency = 0
                }
            }
            j = j + 1
        }

        var m: i64 = 0
        while m < n {
            let instr = p.blocks[bi as usize].instrs[m as usize]
            if instr.opcode == CGOP_SUB && instr.src2_reg == REG_NONE {
                if instr.dst_reg == instr.src1_reg {
                    p.blocks[bi as usize].instrs[m as usize].opcode = CGOP_NOP
                    p.blocks[bi as usize].instrs[m as usize].dst_reg = REG_NONE
                    p.blocks[bi as usize].instrs[m as usize].src1_reg = REG_NONE
                    p.blocks[bi as usize].instrs[m as usize].latency = 0
                }
            }
            m = m + 1
        }

        var q: i64 = 0
        while q < n - 1 {
            let first = p.blocks[bi as usize].instrs[q as usize]
            let second = p.blocks[bi as usize].instrs[(q + 1) as usize]
            if first.opcode == CGOP_MOV && second.opcode == CGOP_MOV {
                if first.dst_reg == second.src1_reg && first.src1_reg == second.dst_reg {
                    p.blocks[bi as usize].instrs[(q + 1) as usize].opcode = CGOP_NOP
                    p.blocks[bi as usize].instrs[(q + 1) as usize].dst_reg = REG_NONE
                    p.blocks[bi as usize].instrs[(q + 1) as usize].src1_reg = REG_NONE
                    p.blocks[bi as usize].instrs[(q + 1) as usize].src2_reg = REG_NONE
                    p.blocks[bi as usize].instrs[(q + 1) as usize].latency = 0
                }
            }
            q = q + 1
        }

        var nop_count: i64 = 0
        var ni: i64 = 0
        while ni < n {
            if p.blocks[bi as usize].instrs[ni as usize].opcode == CGOP_NOP {
                nop_count = nop_count + 1
            }
            ni = ni + 1
        }
        bi = bi + 1
    }

    p
}

// ============================================================================
// Utility: count specific dep types
// ============================================================================

fn cgplan_count_deps_of_kind(plan: CodegenPlan, block_idx: i64, kind: i64) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var i: i64 = 0
    let total = plan.blocks[block_idx as usize].dep_count
    while i < total {
        if plan.blocks[block_idx as usize].deps[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count scheduled instructions (is_scheduled == true) across all blocks.
fn cgplan_count_scheduled(plan: CodegenPlan) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var bi: i64 = 0
    while bi < plan.block_count {
        var i: i64 = 0
        while i < plan.blocks[bi as usize].instr_count {
            if plan.blocks[bi as usize].instrs[i as usize].is_scheduled {
                count = count + 1
            }
            i = i + 1
        }
        bi = bi + 1
    }
    count
}

// Count NOP instructions across all blocks.
fn cgplan_count_nops(plan: CodegenPlan) -> i64 with Mut, Div, Panic {
    var count: i64 = 0
    var bi: i64 = 0
    while bi < plan.block_count {
        var i: i64 = 0
        while i < plan.blocks[bi as usize].instr_count {
            if plan.blocks[bi as usize].instrs[i as usize].opcode == CGOP_NOP {
                count = count + 1
            }
            i = i + 1
        }
        bi = bi + 1
    }
    count
}

// Validate every block schedule: every instruction id in schedule[] is unique and in range.
fn cgplan_validate_schedule(plan: CodegenPlan) -> bool with Mut, Div, Panic {
    var bi: i64 = 0
    while bi < plan.block_count {
        let slen = plan.blocks[bi as usize].schedule_len
        let n = plan.blocks[bi as usize].instr_count
        if slen != n {
            return false
        }

        var seen: [i64; 512] = [0; 512]
        var i: i64 = 0
        while i < slen {
            let id = plan.blocks[bi as usize].schedule[i as usize]
            if id < 0 || id >= n {
                return false
            }
            if seen[id as usize] != 0 {
                return false
            }
            seen[id as usize] = 1
            i = i + 1
        }
        bi = bi + 1
    }
    true
}

// Validate that every block schedule respects all dependencies.
fn cgplan_validate_deps(plan: CodegenPlan) -> bool with Mut, Div, Panic {
    var bi: i64 = 0
    while bi < plan.block_count {
        let block = plan.blocks[bi as usize]
        var pos: [i64; 512] = [0; 512]
        var i: i64 = 0
        while i < block.schedule_len {
            let id = block.schedule[i as usize]
            pos[id as usize] = i
            i = i + 1
        }

        var d: i64 = 0
        while d < block.dep_count {
            let edge = block.deps[d as usize]
            if pos[edge.from_id as usize] >= pos[edge.to_id as usize] {
                return false
            }
            d = d + 1
        }
        bi = bi + 1
    }
    true
}

// ============================================================================
// Multi-block helpers
// ============================================================================

// Schedule all blocks in the plan (applies list scheduling to each).
fn cgplan_schedule_all_blocks(plan: CodegenPlan) -> CodegenPlan with Mut, Div, Panic {
    cgplan_list_schedule(plan)
}

// Compute total cycles across all blocks.
fn cgplan_compute_total_cycles(plan: CodegenPlan) -> i64 with Mut, Div, Panic {
    var total: i64 = 0
    var b: i64 = 0
    while b < plan.block_count {
        total = total + plan.blocks[b as usize].cycle_count
        b = b + 1
    }
    total
}

// ============================================================================
// Tests
// ============================================================================

fn cgplan_assert_true(condition: bool, test_number: i64) -> i64 {
    if condition { 0 } else { test_number }
}

// T01: empty plan has zero blocks
fn test_cgplan_empty() -> i64 with Mut, Div, Panic {
    let p = codegen_plan_new()
    let r1 = cgplan_assert_true(p.block_count == 0, 1)
    if r1 != 0 { return r1 }
    let r2 = cgplan_assert_true(p.total_cycles == 0, 2)
    if r2 != 0 { return r2 }
    let r3 = cgplan_assert_true(p.spill_slots == 0, 3)
    if r3 != 0 { return r3 }
    0
}

// T02: codegen_instr_new populates all fields
fn test_cgplan_instr_new() -> i64 with Mut, Div, Panic {
    let instr = codegen_instr_new(7, CGOP_ADD, 1, 2, 3, 2)
    let r1 = cgplan_assert_true(instr.id == 7, 1)
    if r1 != 0 { return r1 }
    let r2 = cgplan_assert_true(instr.opcode == CGOP_ADD, 2)
    if r2 != 0 { return r2 }
    let r3 = cgplan_assert_true(instr.dst_reg == 1, 3)
    if r3 != 0 { return r3 }
    let r4 = cgplan_assert_true(instr.src1_reg == 2, 4)
    if r4 != 0 { return r4 }
    let r5 = cgplan_assert_true(instr.src2_reg == 3, 5)
    if r5 != 0 { return r5 }
    let r6 = cgplan_assert_true(instr.latency == 2, 6)
    if r6 != 0 { return r6 }
    let r7 = cgplan_assert_true(instr.is_scheduled == false, 7)
    if r7 != 0 { return r7 }
    0
}

// T03: dep_edge_new populates all fields
fn test_cgplan_dep_edge_new() -> i64 with Mut, Div, Panic {
    let e = dep_edge_new(3, 5, DEP_ANTI, 0)
    let r1 = cgplan_assert_true(e.from_id == 3, 1)
    if r1 != 0 { return r1 }
    let r2 = cgplan_assert_true(e.to_id == 5, 2)
    if r2 != 0 { return r2 }
