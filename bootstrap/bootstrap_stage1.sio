    efh_add_clause(ctx, 5, 3, 777, true, EfhResumeStrategy::ResumeMulti)

    let c = efh_get_clause(ctx, 0)
    c.effect_id == 5 && c.op_index == 3 && c.handler_fn_id == 777 &&
    c.captures_cont && efh_resume_strategy_eq(c.resume_strategy, EfhResumeStrategy::ResumeMulti)
}
fn test_efh_get_clause_props() -> i64 with IO, Mut, Div, Panic {
    var ctx = efh_context_new()
    efh_assert_true(efh_test_get_clause_props(&! ctx), 42)
