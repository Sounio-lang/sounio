fn test_dep_term_if_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let cond = dep_term_bool(ctx, 1)
    let then_t = dep_term_int(ctx, 10)
    let else_t = dep_term_int(ctx, 20)
    let t = dep_term_if(ctx, cond, then_t, else_t)
    if t < 0 { return false }
    let k = dep_get_kind(ctx, t)
    if dep_term_kind_is_if(k) == false { return false }
    if dep_get_left(ctx, t) != cond { return false }
    if dep_get_right(ctx, t) != then_t { return false }
    dep_get_body(ctx, t) == else_t
}
fn test_dep_term_if() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_term_if_inner(&! ctx)
}

// ============================================================
// Test Category 2: Substitution (10 tests)
// ============================================================

fn test_dep_subst_var_match_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // x[x := 5] == 5
    let x = dep_term_var(ctx, 1)
    let five = dep_term_int(ctx, 5)
    let result = dep_substitute(ctx, x, 1, five)
    result == five
}
fn test_dep_subst_var_match() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_var_match_inner(&! ctx)
}

fn test_dep_subst_var_no_match_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // y[x := 5] == y
    let y = dep_term_var(ctx, 2)
    let five = dep_term_int(ctx, 5)
    let result = dep_substitute(ctx, y, 1, five)
    result == y
}
fn test_dep_subst_var_no_match() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_subst_var_no_match_inner(&! ctx)
}

fn test_dep_subst_int_noop_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    // 42[x := 5] == 42
    let fortytwo = dep_term_int(ctx, 42)
    let five = dep_term_int(ctx, 5)
    let result = dep_substitute(ctx, fortytwo, 1, five)
    result == fortytwo
}
