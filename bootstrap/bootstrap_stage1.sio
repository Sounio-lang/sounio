fn test_avec_contiguous_loop_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_INDEX_SET, AVEC_INVALID, 21, 31, true, 1)
    avec_is_contiguous(nest, 0)
}

fn test_avec_contiguous_loop() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_contiguous_loop_inner(&! nest)
}

fn test_avec_access_pattern_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 2)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 10, 20, 30, true, 1)
    avec_add_test_instr(nest, AVEC_OP_INDEX_GET, 11, 21, 31, true, 4)
    let pat0 = avec_access_pattern(nest, start)
    let pat1 = avec_access_pattern(nest, start + 1)
    if pat0 != AVEC_ACCESS_UNIT { return false }
    if pat1 != AVEC_ACCESS_STRIDED { return false }
    true
}

fn test_avec_access_pattern() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_access_pattern_inner(&! nest)
}

// ============================================================================
// Test Category 5: Reduction Detection (5 tests)
// ============================================================================

fn test_avec_is_reduction_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // sum = sum + x  (dst == src1, pattern for reduction)
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 10, 20, false, 0)
    avec_is_reduction(nest, start)
}

fn test_avec_is_reduction() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_is_reduction_inner(&! nest)
}

fn test_avec_not_reduction_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // c = a + b (not a reduction, dst != src1 and dst != src2)
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 1)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 20, 30, false, 0)
    if avec_is_reduction(nest, start) { return false }
    true
}

fn test_avec_not_reduction() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_not_reduction_inner(&! nest)
}

fn test_avec_find_reductions_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Loop with 2 reductions and 1 non-reduction
    let start = avec_make_test_loop(nest, 0, 0, 100, 1, 3)
    avec_add_test_instr(nest, AVEC_OP_BINOP, 10, 10, 20, false, 0) // reduction
    avec_add_test_instr(nest, AVEC_OP_BINOP, 11, 20, 30, false, 0) // not reduction
    avec_add_test_instr(nest, AVEC_OP_BINOP, 12, 12, 21, false, 0) // reduction
    let count = avec_find_reductions(nest, 0)
    if count != 2 { return false }
    true
}

fn test_avec_find_reductions() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_find_reductions_inner(&! nest)
}

fn test_avec_reduction_identity_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Add identity = 0
    if avec_reduction_identity(1) != 0 { return false }
    // Mul identity = 1
    if avec_reduction_identity(2) != 1 { return false }
    // BitOr identity = 0
    if avec_reduction_identity(4) != 0 { return false }
    true
}

fn test_avec_reduction_identity() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_reduction_identity_inner(&! nest)
}

fn test_avec_is_associative_inner(nest: &! AvecLoopNest) -> bool with Mut, Div, Panic {
    // Add and Mul are associative
    if avec_is_associative(1) == false { return false }
    if avec_is_associative(2) == false { return false }
    // Unknown op 99 is not
    if avec_is_associative(99) { return false }
    true
}

fn test_avec_is_associative() -> bool with Mut, Div, Panic {
    var nest = avec_loop_nest_new()
    test_avec_is_associative_inner(&! nest)
}

