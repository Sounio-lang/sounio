// ============================================================
// Test helpers
// ============================================================

fn te_test_make_context() -> TeContext {
    return te_context_new()
}

// ============================================================
// Test 1: Type classification — concrete i64
// ============================================================

fn test_te_classify_concrete_i64() -> i32 with IO, Mut, Div, Panic {
    let te = te_classify_type(TE_TY_I64, 1, 8, 8)
    if te.kind != TE_KIND_CONCRETE {
        print("FAIL: test_te_classify_concrete_i64 - kind\n")
        return 1
    }
    if te.size != 8 {
        print("FAIL: test_te_classify_concrete_i64 - size\n")
        return 1
    }
    if te.alignment != 8 {
        print("FAIL: test_te_classify_concrete_i64 - align\n")
        return 1
    }
    if te.is_pointer {
        print("FAIL: test_te_classify_concrete_i64 - pointer\n")
        return 1
    }
    print("PASS: test_te_classify_concrete_i64\n")
    return 0
}

// ============================================================
// Test 2: Type classification — erased (type variable)
// ============================================================

fn test_te_classify_erased_var() -> i32 with IO, Mut, Div, Panic {
    let te = te_classify_type(TE_TY_VAR, 100, 0, 0)
    if te.kind != TE_KIND_ERASED {
        print("FAIL: test_te_classify_erased_var - kind\n")
        return 1
    }
    if te.is_pointer == false {
        print("FAIL: test_te_classify_erased_var - pointer\n")
        return 1
    }
    if te.size != TE_PTR_SIZE {
        print("FAIL: test_te_classify_erased_var - size\n")
        return 1
    }
    print("PASS: test_te_classify_erased_var\n")
    return 0
}

// ============================================================
// Test 3: Type classification — trait object
// ============================================================

fn test_te_classify_trait_obj() -> i32 with IO, Mut, Div, Panic {
    let te = te_classify_type(TE_TY_TRAIT_OBJ, 200, 0, 0)
    if te.kind != TE_KIND_VTABLE {
        print("FAIL: test_te_classify_trait_obj - kind\n")
        return 1
    }
    if te.is_pointer == false {
        print("FAIL: test_te_classify_trait_obj - pointer\n")
        return 1
    }
    if te.size != TE_PTR_SIZE * 2 {
        print("FAIL: test_te_classify_trait_obj - size\n")
        return 1
    }
    print("PASS: test_te_classify_trait_obj\n")
    return 0
}

// ============================================================
// Test 4: Type classification — concrete bool
// ============================================================

fn test_te_classify_concrete_bool() -> i32 with IO, Mut, Div, Panic {
    let te = te_classify_type(TE_TY_BOOL, 3, 1, 1)
    if te.kind != TE_KIND_CONCRETE {
        print("FAIL: test_te_classify_concrete_bool - kind\n")
