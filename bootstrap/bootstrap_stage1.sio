    fn collect_transition_protocol_def(self, name: Name, opt: Option<Box<TransitionProtocolDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(proto) => {
                let target_pair = self.lower_type_expr((*proto).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                if target_ty.kind != TypeKind::TyAlternativeOption {
                    c = c.report_transition_protocol_target_mismatch((*proto).span, name, target_ty)
                    return c
                }

                let policy_id = c.transition_policies.find((*proto).policy_name)
                if policy_id < 0 || policy_id >= c.transition_policies.count {
                    c = c.report_transition_policy_target_mismatch((*proto).span, (*proto).policy_name, knowledge_inner(target_ty), ty_error())
                    return c
                }
                let policy_info = c.transition_policies.get(policy_id)
                let inner_ty = knowledge_inner(target_ty)
                if !types_compatible(policy_info.target_ty, inner_ty) {
                    c = c.report_transition_policy_target_mismatch((*proto).span, policy_info.name, policy_info.target_ty, inner_ty)
                    return c
                }

                let step_pair = c.collect_transition_step_defs((*proto).steps)
                c = step_pair.0
                let info = TransitionProtocolInfo {
                    name: name,
                    target_ty: target_ty,
                    transition_policy_id: policy_id,
                    step_ids: step_pair.1,
                    step_count: step_pair.2,
                }
                let add_result = c.transition_protocols.add(info)
                c.transition_protocols = add_result.0
                c.env = c.env.bind(name, ty_unknown(), false)
                c = c.const_int_bind_unknown(name)

                var i: i64 = 0
                while i < step_pair.2 && i < 16 {
                    let step_id = step_pair.1[i as usize]
                    if step_id >= 0 && step_id < c.transition_steps.count {
                        var step_info = c.transition_steps.get(step_id)
                        step_info.protocol_id = add_result.1
                        c.transition_steps.entries[step_id as usize] = step_info
                    }
                    i = i + 1
                }
                c
            }
            None => self
        }
    }

    fn collect_transition_step_defs(self, opt: Option<Box<TransitionStepDefList>>) -> (Checker, [i64; 16], i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                var ids: [i64; 16] = [-1; 16]
                var count: i64 = 0
                let rest_pair = c.collect_transition_step_defs((*list).tail)
                c = rest_pair.0
                ids = rest_pair.1
                count = rest_pair.2
                if count < 16 {
                    let req_pair = c.collect_transition_policy_requirements((*list).head.requirements)
                    c = req_pair.0
                    let info = TransitionStepInfo {
                        span_start: (*list).head.span.start,
                        span_end: (*list).head.span.end,
                        protocol_id: -1,
                        name: (*list).head.name,
                        value_expr: (*list).head.value_expr,
                        value_repr: empty_name(),
                        requirements: req_pair.1,
                        requirement_count: req_pair.2,
                    }
                    let add_result = c.transition_steps.add(info)
                    c.transition_steps = add_result.0
                    var shifted: [i64; 16] = [-1; 16]
                    shifted[0] = add_result.1
                    var i: i64 = 0
                    while i < count && i + 1 < 16 {
                        shifted[(i + 1) as usize] = ids[i as usize]
                        i = i + 1
                    }
                    ids = shifted
                    count = count + 1
                }
                (c, ids, count)
            }
            None => (self, [-1; 16], 0)
        }
    }

    fn collect_transition_policy_requirements(self, opt: Option<Box<PolicyRequirementList>>) -> (Checker, Option<Box<PolicyRequirementInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_transition_policy_requirement_list(*list)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_transition_policy_requirement_list(self, list: PolicyRequirementList) -> (Checker, PolicyRequirementInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let req = list.head
        var c = self
        let metric_id = transition_policy_metric_id_from_name(req.metric_name)
        if metric_id < 0 {
            c = c.report_unknown_policy_metric(req.span, req.metric_name)
        }
        let threshold_kind =
            if req.threshold_kind == 1 { POLICY_THRESHOLD_BOOL }
            else if req.threshold_kind == 2 { POLICY_THRESHOLD_NAME }
            else { POLICY_THRESHOLD_F64 }
        let threshold =
            if threshold_kind == POLICY_THRESHOLD_BOOL {
                if req.bool_threshold { 1.0 } else { 0.0 }
            } else if threshold_kind == POLICY_THRESHOLD_NAME && metric_id == CONTEST_METRIC_DEFERRED_REASON {
                let code = deferral_reason_code_from_name_value(req.name_threshold)
                if code < 0 {
                    c = c.report_unknown_policy_metric(req.span, req.metric_name)
                }
                code as f64
            } else {
                req.threshold
            }
        let head = PolicyRequirementInfo {
            metric_id: metric_id,
            metric_name: req.metric_name,
            op: req.op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: req.bool_threshold,
            name_threshold: req.name_threshold,
        }
        let head_list = PolicyRequirementInfoList { head: head, tail: None }
        match list.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_pair = c.collect_transition_policy_requirement_list(*rest)
                c = rest_pair.0
                let rest_list = rest_pair.1
                let rest_count = rest_pair.2
                (c, PolicyRequirementInfoList { head: head, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn collect_alternative_policy_def(self, name: Name, opt: Option<Box<AlternativePolicyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ap) => {
                let target_pair = self.lower_type_expr((*ap).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let seed_metric_ids: [i64; 8] = [-1; 8]
                let seed_directions: [i64; 8] = [0; 8]
                let obj_pair = c.collect_alternative_objectives((*ap).objectives, seed_metric_ids, seed_directions, 0)
                c = obj_pair.0
                let info = AlternativePolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    frontier_name: (*ap).frontier_name,
                    objective_metric_ids: obj_pair.1,
                    objective_directions: obj_pair.2,
                    objective_count: obj_pair.3,
                    max_options: (*ap).max_options,
                }
                let add_result = c.alternative_policies.add(info)
                c.alternative_policies = add_result.0
                c.env = c.env.bind(name, ty_alternative_policy(target_ty, add_result.1), false)
                c
            }
            None => self
        }
    }

    fn collect_alternative_frontier_def(self, name: Name, opt: Option<Box<AlternativeFrontierDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                let target_pair = self.lower_type_expr((*fd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1

                var target_kind: i64 = -1
                var inner_ty = ty_error()
                if target_ty.kind == TypeKind::TyDeferred {
                    target_kind = ALTERNATIVE_SOURCE_DEFERRED
                    inner_ty = knowledge_inner(target_ty)
                } else if target_ty.kind == TypeKind::TyRecoursePlan {
                    target_kind = ALTERNATIVE_SOURCE_RECOURSE_PLAN
                    inner_ty = knowledge_inner(target_ty)
                } else {
                    c = c.report_error_at((*fd).span, 114, 0, 0, 0)
                }

                let policy_id = c.alternative_policies.find((*fd).policy_name)
                if policy_id < 0 {
                    c = c.report_error_at((*fd).span, 119, 0, 0, 0)
                } else {
                    let policy_info = c.alternative_policies.get(policy_id)
                    if !types_compatible(policy_info.target_ty, inner_ty) {
                        c = c.report_error_at((*fd).span, 119, 0, 0, 0)
                    }
                }

                let cand_pair = c.collect_alternative_candidates((*fd).candidates)
                c = cand_pair.0
                let info = AlternativeFrontierInfo {
                    name: name,
                    target_kind: target_kind,
                    target_ty: target_ty,
                    policy_id: policy_id,
                    candidate_ids: cand_pair.1,
                    candidate_count: cand_pair.2,
                }
                let add_result = c.alternative_frontiers.add(info)
                c.alternative_frontiers = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_alternative_objectives(
        self,
        opt: Option<Box<AlternativeObjectiveDefList>>,
        metric_ids: [i64; 8],
        directions: [i64; 8],
        count: i64
    ) -> (Checker, [i64; 8], [i64; 8], i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                var mids = metric_ids
                var dirs = directions
                var next_count = count
                let metric_id = alternative_metric_id_from_name((*list).head.metric_name)
                if metric_id < 0 || count >= 8 {
                    c = c.report_error_at((*list).head.span, 119, 0, 0, 0)
                } else {
                    mids[count as usize] = metric_id
                    dirs[count as usize] =
                        if (*list).head.direction == AlternativeObjectiveDirection::AlternativeObjectiveMaximize { 1 } else { 0 }
                    next_count = count + 1
                }
                c.collect_alternative_objectives((*list).tail, mids, dirs, next_count)
            }
            None => (self, metric_ids, directions, count)
        }
    }

    fn collect_alternative_candidates(self, opt: Option<Box<AlternativeCandidateDefList>>) -> (Checker, [i64; 16], i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_alternative_candidates((*list).tail)
                var c = pair.0
                var ids = pair.1
                var count = pair.2
                if count < 16 {
                    let seed_known: [i64; 8] = [0; 8]
                    let seed_values: [f64; 8] = [0.0; 8]
                    let metric_pair = c.collect_alternative_candidate_metrics((*list).head.metrics, seed_known, seed_values)
                    c = metric_pair.0
                    let info = AlternativeCandidateInfo {
                        span_start: (*list).head.span.start,
                        span_end: (*list).head.span.end,
                        frontier_id: -1,
                        name: (*list).head.name,
                        via_recourse_policy_name: (*list).head.via_name,
                        uses_via: (*list).head.uses_via,
                        value_expr: (*list).head.value_expr,
                        value_repr: empty_name(),
                        metric_known: metric_pair.1,
                        metric_values: metric_pair.2,
                        source_kind: -1,
                        deferred_certificate_id: -1,
                        source_policy_id: -1,
                        source_plan_id: -1,
                        strategy_name: empty_name(),
                        route_name: empty_name(),
                        audit_id: -1,
                        contest_id: -1,
                        dominance_rank: -1,
                    }
                    let add_result = c.alternative_candidates.add(info)
                    c.alternative_candidates = add_result.0
                    ids[count as usize] = add_result.1
                    count = count + 1
                }
                (c, ids, count)
            }
            None => (self, [-1; 16], 0)
        }
    }

    fn collect_alternative_candidate_metrics(
        self,
        opt: Option<Box<AuditFieldEntryList>>,
        known: [i64; 8],
        values: [f64; 8]
    ) -> (Checker, [i64; 8], [f64; 8]) with Mut, Panic, Div, Alloc, IO {
        var c = self
        var out_known = known
        var out_values = values
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let metric_id = alternative_metric_id_from_name((*list).head.name)
                    if metric_id < 0
                    || metric_id >= 4
                    || out_known[metric_id as usize] == 1
                    || (*list).head.value_kind != AuditValueKind::AuditValueFloat {
                        c = c.report_error_at((*list).head.span, 116, 0, 0, 0)
                    } else {
                        out_known[metric_id as usize] = 1
                        out_values[metric_id as usize] = (*list).head.value_f64
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        (c, out_known, out_values)
    }

    fn collect_decision_policy_def(self, name: Name, opt: Option<Box<DecisionPolicyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => {
                let target_pair = self.lower_type_expr((*dd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let req_pair = c.collect_policy_requirements((*dd).requirements)
                c = req_pair.0
                let requirements = req_pair.1
                let requirement_count = req_pair.2
                let info = DecisionPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.decision_policies.add(info)
                c.decision_policies = add_result.0
                c.env = c.env.bind(name, ty_decision_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_deferral_policy_def(self, name: Name, opt: Option<Box<DeferralPolicyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(dd) => {
                let target_pair = self.lower_type_expr((*dd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let req_pair = c.collect_policy_requirements((*dd).requirements)
                c = req_pair.0
                let requirements = req_pair.1
                let requirement_count = req_pair.2
                let info = DeferralPolicyInfo {
                    name: name,
                    target_ty: target_ty,
                    route_name: (*dd).route_name,
                    requirements: requirements,
                    requirement_count: requirement_count,
                }
                let add_result = c.deferral_policies.add(info)
                c.deferral_policies = add_result.0
                c.env = c.env.bind(name, ty_deferral_policy(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_models_def(self, name: Name, opt: Option<Box<ModelsDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(md) => {
                let pair = self.collect_model_family_members((*md).models, empty_model_family_info(), (*md).span)
                var c = pair.0
                var info = pair.1
                info.name = name
                let add_result = c.model_families.add(info)
                c.model_families = add_result.0
                let family_info = c.model_families.get(add_result.1)
                c.env = c.env.bind(name, ty_model_family(family_info.input_ty, family_info.output_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_model_family_members(self, opt: Option<Box<AstPathList>>, seed: ModelFamilyInfo, span: Span) -> (Checker, ModelFamilyInfo) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let model_name = checker_copy_string_list_tail_to_name((*list).head.segments)
                var c = self
                let model_ty = c.env.lookup(model_name)
                var info = seed
                if model_ty.kind != TypeKind::TyModel {
                    c = c.report_model_type_incompatibility(span, model_name, model_ty)
                } else {
                    let input_ty = model_input_ty(model_ty)
                    let output_ty = model_output_ty(model_ty)
                    if info.model_count == 0 {
                        info.input_ty = input_ty
                        info.output_ty = output_ty
                    } else if !types_compatible(info.input_ty, input_ty) || !types_compatible(info.output_ty, output_ty) {
                        c = c.report_model_family_member_mismatch(span, model_name, info.input_ty, info.output_ty, input_ty, output_ty)
                    }
                    if info.model_count < 16 {
                        info.model_names[info.model_count as usize] = model_name
                    }
                    info.model_count = info.model_count + 1
                }
                c.collect_model_family_members((*list).tail, info, span)
            }
            None => (self, seed)
        }
    }

    fn collect_validation_def(self, name: Name, opt: Option<Box<ValidationDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vd) => {
                let target_pair = self.lower_type_expr((*vd).target_type)
                var c = target_pair.0
                let target_ty = target_pair.1
                let info = ValidationPolicyInfo { name: name, target_ty: target_ty }
                let add_result = c.validations.add(info)
                c.validations = add_result.0
                c.env = c.env.bind(name, ty_validation(target_ty, add_result.1), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn lower_audit_target_type(self, te: TypeExpr, span: Span) -> (Checker, bool, TypeEntry, i64, i64) with Mut, Panic, Div, Alloc, IO {
        if te.kind != TypeExprKind::TypeContest {
            return (self, false, ty_error(), -1, -1)
        }
        match te.type_args {
            Some(args) => {
                match (*args).tail {
                    Some(rest) => {
                        match (*rest).tail {
                            Some(last) => {
                                match (*last).tail {
                                    Some(_) => (self, false, ty_error(), -1, -1)
                                    None => {
                                        let inner_pair = self.lower_type_expr((*args).head)
                                        var c = inner_pair.0
                                        let inner_ty = inner_pair.1
                                        let family_pair = c.lower_type_expr((*rest).head)
                                        c = family_pair.0
                                        let family_ty = family_pair.1
                                        let policy_pair = c.lower_type_expr((*last).head)
                                        c = policy_pair.0
                                        let policy_ty = policy_pair.1
                                        if family_ty.kind != TypeKind::TyModelFamily
                                            || policy_ty.kind != TypeKind::TyPolicy
                                            || family_ty.epistemic_meta_id < 0
                                            || policy_ty.epistemic_meta_id < 0 {
                                            return (c, false, ty_error(), -1, -1)
                                        }
                                        if !types_compatible(model_output_ty(family_ty), inner_ty)
                                            || !types_compatible(knowledge_inner(policy_ty), inner_ty) {
                                            c = c.report_error_at(span, 58, 0, 0, 0)
                                            return (c, false, ty_error(), -1, -1)
                                        }
                                        (c, true, inner_ty, family_ty.epistemic_meta_id, policy_ty.epistemic_meta_id)
                                    }
                                }
                            }
                            None => (self, false, ty_error(), -1, -1)
                        }
                    }
                    None => (self, false, ty_error(), -1, -1)
                }
            }
            None => (self, false, ty_error(), -1, -1)
        }
    }

    fn collect_audit_def(self, name: Name, opt: Option<Box<AuditDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ad) => {
                let target_pair = self.lower_audit_target_type((*ad).target_type, (*ad).span)
                var c = target_pair.0
                let ok = target_pair.1
                let target_inner_ty = target_pair.2
                let family_id = target_pair.3
                let policy_id = target_pair.4
                if !ok {
                    return c.report_audit_definition_requires_full_contest((*ad).span, ty_error())
                }

                var info = empty_audit_info()
                info.name = name
                info.span_start = (*ad).span.start
                info.span_end = (*ad).span.end
                info.target_inner_ty = target_inner_ty
                info.family_id = family_id
                info.policy_id = policy_id

                let sec_pair = c.collect_audit_sections(name, (*ad).sections, info, [0; 4])
                c = sec_pair.0
                info = sec_pair.1

                let add_result = c.audits.add(info)
                c.audits = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_audit_sections(
        self,
        audit_name: Name,
        opt: Option<Box<AuditSectionList>>,
        seed: AuditInfo,
        section_seen: [i64; 4]
    ) -> (Checker, AuditInfo, [i64; 4]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let section = (*list).head
                var c = self
                var info = seed
                var seen = section_seen
                let section_idx =
                    if section.kind == AuditSectionKind::AuditSectionMetrics { 0 }
                    else if section.kind == AuditSectionKind::AuditSectionMechanistic { 1 }
                    else if section.kind == AuditSectionKind::AuditSectionCounterexample { 2 }
                    else if section.kind == AuditSectionKind::AuditSectionPosteriorWeights { 3 }
                    else { -1 }

                if section_idx < 0 {
                    c = c.report_audit_unknown_or_duplicate_field(section.span, section.name, empty_name())
                } else if seen[section_idx as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(section.span, section.name, empty_name())
                } else {
                    seen[section_idx as usize] = 1
                    if section.kind == AuditSectionKind::AuditSectionMetrics {
                        let pair = c.collect_audit_metrics_section(section.name, section.fields, info, [0; 8])
                        c = pair.0
                        info = pair.1
                    } else if section.kind == AuditSectionKind::AuditSectionMechanistic {
                        let pair = c.collect_audit_mechanistic_section(audit_name, section.name, section.fields)
                        c = pair.0
                        info.mechanistic_report_id = pair.1
                        if pair.1 >= 0 && pair.1 < c.mechanistic_reports.count {
                            let report = c.mechanistic_reports.get(pair.1)
                            info.metric_known[CONTEST_METRIC_MECHANISTIC_DIVERGENCE as usize] = 1
                            info.metric_values[CONTEST_METRIC_MECHANISTIC_DIVERGENCE as usize] = report.aggregate_divergence
                        }
                    } else if section.kind == AuditSectionKind::AuditSectionCounterexample {
                        let pair = c.collect_audit_counterexample_section(audit_name, section.name, section.fields)
                        c = pair.0
                        info.counterexample_id = pair.1
                        if pair.1 >= 0 {
                            info.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1
                            info.metric_values[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1.0
                        }
                    } else if section.kind == AuditSectionKind::AuditSectionPosteriorWeights {
                        if info.family_id < 0 || info.family_id >= c.model_families.count {
                            c = c.report_audit_weights_family_mismatch(section.span, audit_name)
                        } else {
                            let family = c.model_families.get(info.family_id)
                            let pair = c.collect_audit_posterior_weights_section(audit_name, section.name, family, section.fields)
                            c = pair.0
                            info.posterior_weights_id = pair.1
                        }
                    }
                }
                c.collect_audit_sections(audit_name, (*list).tail, info, seen)
            }
            None => (self, seed, section_seen)
        }
    }

    fn collect_audit_metrics_section(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>,
        seed: AuditInfo,
        seen_fields: [i64; 8]
    ) -> (Checker, AuditInfo, [i64; 8]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var info = seed
                var seen = seen_fields
                let metric_id = audit_metric_id_from_name(field.name)
                if metric_id < 0 || field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if seen[metric_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[metric_id as usize] = 1
                    info.metric_known[metric_id as usize] = 1
                    info.metric_values[metric_id as usize] = field.value_f64
                }
                c.collect_audit_metrics_section(section_name, (*list).tail, info, seen)
            }
            None => (self, seed, seen_fields)
        }
    }

    fn collect_audit_mechanistic_section(
        self,
        audit_name: Name,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>
    ) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.collect_audit_mechanistic_fields(section_name, opt, [0; 6], [0.0; 6])
        var c = pair.0
        let seen = pair.1
        let values = pair.2
        var i: i64 = 0
        while i < 6 {
            if seen[i as usize] != 1 {
                c = c.report_audit_mechanistic_incomplete(Span { start: 0, end: 0 }, audit_name)
                return (c, -1)
            }
            i = i + 1
        }
        let report = MechanisticReportInfo {
            latent_state_divergence: values[1],
            causal_decomposition_divergence: values[2],
            intervention_response_divergence: values[3],
            parameter_role_divergence: values[4],
            structural_explanation_distance: values[5],
            aggregate_divergence: values[0],
        }
        let add_result = c.mechanistic_reports.add(report)
        c.mechanistic_reports = add_result.0
        (c, add_result.1)
    }

    fn collect_audit_mechanistic_fields(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>,
        seen_fields: [i64; 6],
        values: [f64; 6]
    ) -> (Checker, [i64; 6], [f64; 6]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var vals = values
                let field_id = audit_mechanistic_field_id_from_name(field.name)
                if field_id < 0 || field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if seen[field_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[field_id as usize] = 1
                    vals[field_id as usize] = field.value_f64
                }
                c.collect_audit_mechanistic_fields(section_name, (*list).tail, seen, vals)
            }
            None => (self, seen_fields, values)
        }
    }

    fn collect_audit_counterexample_section(
        self,
        audit_name: Name,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>
    ) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.collect_audit_counterexample_fields(
            section_name,
            opt,
            [0; 6],
            [Name { buf: [0; 128], len: 0 }; 6],
            [0.0; 6]
        )
        var c = pair.0
        let seen = pair.1
        let names = pair.2
        let values = pair.3
        var i: i64 = 0
        while i < 6 {
            if seen[i as usize] != 1 {
                c = c.report_audit_counterexample_incomplete(Span { start: 0, end: 0 }, audit_name)
                return (c, -1)
            }
            i = i + 1
        }
        let info = CounterexampleInfo {
            model_name: names[0],
            subgroup_name: names[1],
            metric_name: names[2],
            observed_value: values[3],
            threshold_value: values[4],
            summary: names[5],
        }
        let add_result = c.counterexamples.add(info)
        c.counterexamples = add_result.0
        (c, add_result.1)
    }

    fn collect_audit_counterexample_fields(
        self,
        section_name: Name,
        opt: Option<Box<AuditFieldEntryList>>,
        seen_fields: [i64; 6],
        names: [Name; 6],
        values: [f64; 6]
    ) -> (Checker, [i64; 6], [Name; 6], [f64; 6]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var next_names = names
                var next_values = values
                let field_id = audit_counterexample_field_id_from_name(field.name)
                if field_id < 0 || seen[field_id as usize] == 1 {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if (field_id == 3 || field_id == 4) && field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if field_id != 3 && field_id != 4 && field.value_kind != AuditValueKind::AuditValueName {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else {
                    seen[field_id as usize] = 1
                    if field_id == 3 || field_id == 4 {
                        next_values[field_id as usize] = field.value_f64
                    } else {
                        next_names[field_id as usize] = field.value_name
                    }
                }
                c.collect_audit_counterexample_fields(section_name, (*list).tail, seen, next_names, next_values)
            }
            None => (self, seen_fields, names, values)
        }
    }

    fn collect_audit_posterior_weights_section(
        self,
        audit_name: Name,
        section_name: Name,
        family: ModelFamilyInfo,
        opt: Option<Box<AuditFieldEntryList>>
    ) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        if family.model_count > 16 {
            let c = self.report_audit_weights_family_mismatch(Span { start: 0, end: 0 }, audit_name)
            return (c, -1)
        }
        let pair = self.collect_audit_posterior_weight_fields(section_name, family, opt, [0; 16], [0.0; 16])
        var c = pair.0
        let seen = pair.1
        let weights = pair.2
        var i: i64 = 0
        var total: f64 = 0.0
        while i < family.model_count && i < 16 {
            if seen[i as usize] != 1 {
                c = c.report_audit_weights_family_mismatch(Span { start: 0, end: 0 }, audit_name)
                return (c, -1)
            }
            total = total + weights[i as usize]
            i = i + 1
        }
        if audit_abs_f64(total - 1.0) > 0.000001 {
            c = c.report_audit_weights_not_normalized(Span { start: 0, end: 0 }, audit_name, total)
            return (c, -1)
        }
        let info = PosteriorWeightsInfo {
            model_names: family.model_names,
            weights: weights,
            count: family.model_count,
        }
        let add_result = c.posterior_weights.add(info)
        c.posterior_weights = add_result.0
        (c, add_result.1)
    }

    fn collect_audit_posterior_weight_fields(
        self,
        section_name: Name,
        family: ModelFamilyInfo,
        opt: Option<Box<AuditFieldEntryList>>,
        seen_fields: [i64; 16],
        weights: [f64; 16]
    ) -> (Checker, [i64; 16], [f64; 16]) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let field = (*list).head
                var c = self
                var seen = seen_fields
                var next_weights = weights
                let model_idx = model_family_model_index(family, field.name)
                if field.value_kind != AuditValueKind::AuditValueFloat {
                    c = c.report_audit_unknown_or_duplicate_field(field.span, section_name, field.name)
                } else if field.value_f64 < 0.0 {
                    c = c.report_audit_weights_not_normalized(field.span, section_name, field.value_f64)
                } else if model_idx < 0 {
                    c = c.report_audit_weights_family_mismatch(field.span, section_name)
                } else if seen[model_idx as usize] == 1 {
                    c = c.report_audit_weights_family_mismatch(field.span, section_name)
                } else {
                    seen[model_idx as usize] = 1
                    next_weights[model_idx as usize] = field.value_f64
                }
                c.collect_audit_posterior_weight_fields(section_name, family, (*list).tail, seen, next_weights)
            }
            None => (self, seen_fields, weights)
        }
    }

    fn collect_policy_requirements(self, opt: Option<Box<PolicyRequirementList>>) -> (Checker, Option<Box<PolicyRequirementInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.collect_policy_requirement_list(*list)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_policy_requirement_list(self, list: PolicyRequirementList) -> (Checker, PolicyRequirementInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let req = list.head
        var c = self
        let metric_id = policy_metric_id_from_name(req.metric_name)
        if metric_id < 0 {
            c = c.report_unknown_policy_metric(req.span, req.metric_name)
        }
        let threshold_kind =
            if req.threshold_kind == 1 { POLICY_THRESHOLD_BOOL }
            else if req.threshold_kind == 2 { POLICY_THRESHOLD_NAME }
            else { POLICY_THRESHOLD_F64 }
        let threshold =
            if threshold_kind == POLICY_THRESHOLD_BOOL {
                if req.bool_threshold { 1.0 } else { 0.0 }
            } else if threshold_kind == POLICY_THRESHOLD_NAME && metric_id == CONTEST_METRIC_DEFERRED_REASON {
                let code = deferral_reason_code_from_name_value(req.name_threshold)
                if code < 0 {
                    c = c.report_unknown_policy_metric(req.span, req.metric_name)
                }
                code as f64
            } else {
                req.threshold
            }
        let head = PolicyRequirementInfo {
            metric_id: metric_id,
            metric_name: req.metric_name,
            op: req.op,
            threshold: threshold,
            threshold_kind: threshold_kind,
            bool_threshold: req.bool_threshold,
            name_threshold: req.name_threshold,
        }
        let head_list = PolicyRequirementInfoList { head: head, tail: None }
        match list.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_pair = c.collect_policy_requirement_list(*rest)
                c = rest_pair.0
                let rest_list = rest_pair.1
                let rest_count = rest_pair.2
                (c, PolicyRequirementInfoList { head: head, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect function signature
    // --------------------------------------------------------

    fn collect_fn_def(self, name: Name, opt: Option<Box<FnDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                let pair = self.collect_fn_params((*fd).params)
                var c = pair.0
                let params = pair.1
                let param_count = pair.2
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from function signature (including user-defined)
                let eff_pair = c.extract_effects_with_checker((*fd).effects)
                c = eff_pair.0
                let fn_effects = eff_pair.1
                let fn_effect_count = eff_pair.2

                // Kernel function enforcement
                let is_kernel_fn = (*fd).is_kernel
                var kernel_effects = fn_effects
                var kernel_effect_count = fn_effect_count

                if is_kernel_fn {
                    // Auto-inject GPU effect (ID 5) if not already present
                    var has_gpu = false
                    var ei = 0
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if ei < kernel_effect_count {
                        if kernel_effects[ei] == 5 { has_gpu = true }
                        ei = ei + 1
                    }
                    if has_gpu == false {
                        if kernel_effect_count < 8 {
                            kernel_effects[kernel_effect_count] = 5
                            kernel_effect_count = kernel_effect_count + 1
                        }
                    }

                    // E070: Reject IO(0), Mut(1), Alloc(2) effects
                    var ri = 0
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }
                    if ri < kernel_effect_count {
                        if kernel_effects[ri] == 0 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 1 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        if kernel_effects[ri] == 2 {
                            c = c.report_error_at((*fd).span, 70, 0, 0, 0)
                        }
                        ri = ri + 1
                    }

                    // E072: Kernel must return unit type
                    if ret_ty.kind != TypeKind::TyUnit {
                        c = c.report_error_at((*fd).span, 72, 0, 0, 0)
                    }
                }

                // Detect epistemic kernel: any param with Knowledge/Epistemic type
                var has_epistemic_param = false
                if is_kernel_fn {
                    var walk_params = params
                    var walk_i: i64 = 0
                    while walk_i < param_count {
                        match walk_params {
                            Some(plist) => {
                                let pty = (*plist).head.ty
                                if is_epistemic_type(pty) || pty.kind == TypeKind::TyEpistemic || pty.kind == TypeKind::TyAleatoric {
                                    has_epistemic_param = true
                                }
                                walk_params = (*plist).tail
                            }
                            None => { walk_i = param_count }
                        }
                        walk_i = walk_i + 1
                    }
                }

                let sig = FnSig {
                    name: name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: false,
                    self_type_name: Name { buf: [0; 128], len: 0 },
                    self_type_entry: ty_unit(),
                    effects: kernel_effects,
                    effect_count: kernel_effect_count,
                    is_kernel: is_kernel_fn,
                    is_epistemic_kernel: has_epistemic_param,
                    is_linear_closure: false,
                    linear_capture_count: 0,
                    epistemic_epsilon: 0.0 - 1.0,
                }
                let add_result = c.fn_sigs.add(sig)
                c.fn_sigs = add_result.0
                let sig_id = add_result.1
                c.env = c.env.bind(name, ty_fn(sig_id), false)
                c = c.const_int_bind_unknown(name)
                c
            }
            None => self
        }
    }

    fn collect_fn_params(self, opt: Option<Box<ParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let pair = self.collect_fn_param_list(*pl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_fn_param_list(self, pl: ParamList) -> (Checker, FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_fn_param_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn lower_opt_return_type(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }

    // --------------------------------------------------------
    // Collect struct definition
    // --------------------------------------------------------

    fn collect_struct_def(self, name: Name, opt: Option<Box<StructDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(sd) => {
                // Extract type parameters if present
                let tp_result = collect_type_params((*sd).type_params)
                let tp_count = tp_result.0
                let tp_names = tp_result.1
                let is_generic = tp_count > 0

                let pair = self.collect_field_defs((*sd).fields)
                var c = pair.0
                let fields = pair.1
                let field_count = pair.2
                let info = StructInfo {
                    name: name,
                    fields: fields,
                    field_count: field_count,
                    is_linear: (*sd).is_linear,
                    type_param_count: tp_count,
                    type_param_names: tp_names,
                    is_generic_template: is_generic,
                }
                c.structs = c.structs.add(info)
                c
            }
            None => self
        }
    }

    fn collect_field_defs(self, opt: Option<Box<FieldDefList>>) -> (Checker, Option<Box<FieldInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fdl) => {
                let pair = self.collect_field_def_list(*fdl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_field_def_list(self, fdl: FieldDefList) -> (Checker, FieldInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(fdl.head.ty)
        var c = pair.0
        let field_ty = pair.1
        let head_info = FieldInfo { name: fdl.head.name, ty: field_ty }
        let head_list = FieldInfoList { head: head_info, tail: None }
        match fdl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_field_def_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FieldInfoList { head: head_info, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect enum definition
    // --------------------------------------------------------

    fn collect_enum_def(self, name: Name, opt: Option<Box<EnumDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(ed) => {
                let pair = self.collect_variants((*ed).variants)
                var c = pair.0
                let variants = pair.1
                let variant_count = pair.2
                let info = EnumInfo {
                    name: name,
                    variants: variants,
                    variant_count: variant_count,
                }
                c.enums = c.enums.add(info)
                c
            }
            None => self
        }
    }

    fn collect_variants(self, opt: Option<Box<VariantDefList>>) -> (Checker, Option<Box<VariantInfoList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(vdl) => {
                let pair = self.collect_variant_list(*vdl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_variant_list(self, vdl: VariantDefList) -> (Checker, VariantInfoList, i64) with Mut, Panic, Div, Alloc, IO {
        // Collect variant fields (if any) using the same mechanism as struct fields
        let fields_result = self.collect_field_defs(vdl.head.fields)
        var c = fields_result.0
        let v_fields = fields_result.1
        let head_info = VariantInfo { name: vdl.head.name, fields: v_fields }
        let head_list = VariantInfoList { head: head_info, tail: None }
        match vdl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_variant_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, VariantInfoList { head: head_info, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    // --------------------------------------------------------
    // Collect trait definitions
    // --------------------------------------------------------

    fn collect_trait_def(self, name: Name, opt: Option<Box<TraitDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(td) => {
                // Register trait in the trait registry (sequential ID from count)
                var c = self
                let trait_id = c.trait_registry.count + 100  // offset past builtins
                var tdef = trait_def_new(trait_id)
                // Collect method signatures from the trait body
                c = c.collect_trait_methods((*td).methods, trait_id)
                c.trait_registry = trait_register(c.trait_registry, tdef)
                c
            }
            None => self
        }
    }

    fn collect_trait_methods(self, methods: Option<Box<ItemList>>, trait_id: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match methods {
            None => self
            Some(list) => {
                var c = self
                let item = (*list).head
                if item.kind == ItemKind::ItemFn {
                    c = c.collect_fn_def(item.name, item.fn_def)
                }
                c.collect_trait_methods((*list).tail, trait_id)
            }
        }
    }

    // --------------------------------------------------------
    // Collect algebra declaration
    // --------------------------------------------------------

    fn collect_algebra_def(self, opt: Option<Box<AlgebraDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(adef) => {
                var c = self
                let idx = c.algebras.count
                if idx >= 16 { return c }  // table full

                var info = empty_algebra_info()
                info.name = (*adef).name
                info.reassoc_strategy = (*adef).reassoc_strategy
                info.is_valid = true

                // Derive algebra_tag from name for backward compat
                // "Octonion" = 8 chars, O=79
                // "Sedenion" = 8 chars, S=83
                // "Quaternion" = 10 chars, Q=81
                if info.name.len == 8 && info.name.buf[0] == 79 as i8 {
                    info.algebra_tag = 3  // Octonion
                } else if info.name.len == 8 && info.name.buf[0] == 83 as i8 {
                    info.algebra_tag = 4  // Sedenion
                } else if info.name.len == 10 && info.name.buf[0] == 81 as i8 {
                    info.algebra_tag = 2  // Quaternion
                }

                // Walk op declarations
                c = c.collect_algebra_ops((*adef).ops, idx)

                // Copy info into table
                c.algebras.entries[idx] = info
                c.algebras.count = idx + 1
                c
            }
        }
    }

    fn collect_algebra_ops(self, ops: Option<Box<AlgebraOpDeclList>>, idx: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match ops {
            None => self
            Some(list) => {
                var c = self
                let op = (*list).head
                // Check op name: "add" (3 chars, a=97,d=100,d=100) or "mul" (3, m=109)
                if op.op_name.len == 3 && op.op_name.buf[0] == 97 as i8 {
                    // add
                    c.algebras.entries[idx].add_commutative = op.is_commutative
                    c.algebras.entries[idx].add_associative = op.is_associative
                } else if op.op_name.len == 3 && op.op_name.buf[0] == 109 as i8 {
                    // mul
                    c.algebras.entries[idx].mul_commutative = op.is_commutative
                    c.algebras.entries[idx].mul_associative = op.is_associative
                    c.algebras.entries[idx].mul_alternative = op.is_alternative
                }
                c.collect_algebra_ops((*list).tail, idx)
            }
        }
    }

    // --------------------------------------------------------
    // Collect study declaration
    // --------------------------------------------------------

    fn collect_study_def(self, span: Span, opt: Option<Box<StudyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(sdef) => {
                var c = self
                let idx = c.studies.count
                if idx >= 16 {
                    c = c.report_error_at(span, 154, 0, 0, 0)
                    return c
                }

                var info = empty_study_info()
                info.name = (*sdef).name
                info.title = (*sdef).title
                info.registration = (*sdef).registration
                info.design = (*sdef).design
                info.sample_size = (*sdef).sample_size
                info.power = (*sdef).power
                info.alpha = (*sdef).alpha
                info.correction = (*sdef).correction
                info.hypotheses = (*sdef).hypotheses
                info.hypothesis_count = (*sdef).n_hypotheses
                info.outcomes = (*sdef).outcomes
                info.outcome_count = (*sdef).n_outcomes
                info.is_valid = (*sdef).n_hypotheses > 0 as i32

                if !info.is_valid {
                    c = c.report_error_at(span, 155, 0, 0, 0)
                }

                c.studies.entries[idx as usize] = info
                c.studies.count = idx + 1
                c
            }
        }
    }

    // --------------------------------------------------------
    // Collect ontology definitions
    // --------------------------------------------------------

    fn collect_ontology_def(self, opt: Option<Box<OntologyDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => self
            Some(odef) => {
                var c = self
                let ont_name = (*odef).name
                // Walk class declarations and register each class
                c = c.collect_ontology_classes((*odef).classes, ont_name)
                // Walk disjoint declarations
                c = c.collect_ontology_disjoints((*odef).disjoints)
                // Compute transitive closure of superclass relationships
                c.ontologies = ontology_table_compute_closure(c.ontologies)
                // Bind each class name as a named type with ontology_id
                var i: i64 = 0
                while i < c.ontologies.count {
                    if c.ontologies.entries[i as usize].is_valid {
                        let cls_name = c.ontologies.entries[i as usize].name
                        let ty = ty_with_ontology(ty_named(cls_name), i)
                        c.env = c.env.bind(cls_name, ty, false)
                    }
                    i = i + 1
                }
                c
            }
        }
    }

    fn collect_ontology_classes(self, classes: Option<Box<OntologyClassDeclList>>, ont_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match classes {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                let idx = c.ontologies.count
                if idx >= 64 {
                    c = c.report_error_at(decl.span, 153, 0, 0, 0)
                    return c
                }

                var info = empty_ontology_class_info()
                info.name = decl.name
                info.ontology_name = ont_name
                info.class_index = idx
                info.is_valid = true

                // Resolve superclass names to indices
                var i: i64 = 0
                while i < decl.superclass_count && i < 8 {
                    let sc_name = decl.superclass_names[i as usize]
                    let sc_idx = ontology_table_find(c.ontologies, sc_name)
                    if sc_idx >= 0 {
                        info.superclass_indices[info.superclass_count as usize] = sc_idx
                        info.superclass_count = info.superclass_count + 1
                    }
                    i = i + 1
                }

                c.ontologies.entries[idx as usize] = info
                c.ontologies.count = idx + 1
                c.collect_ontology_classes((*list).tail, ont_name)
            }
        }
    }

    fn collect_ontology_disjoints(self, disjoints: Option<Box<OntologyDisjointDeclList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match disjoints {
            None => self
            Some(list) => {
                var c = self
                let decl = (*list).head
                let a_idx = ontology_table_find(c.ontologies, decl.name_a)
                let b_idx = ontology_table_find(c.ontologies, decl.name_b)
                if a_idx >= 0 && b_idx >= 0 {
                    // Add disjoint in both directions
                    let a_dc = c.ontologies.entries[a_idx as usize].disjoint_count
                    if a_dc < 8 {
                        c.ontologies.entries[a_idx as usize].disjoint_indices[a_dc as usize] = b_idx
                        c.ontologies.entries[a_idx as usize].disjoint_count = a_dc + 1
                    }
                    let b_dc = c.ontologies.entries[b_idx as usize].disjoint_count
                    if b_dc < 8 {
                        c.ontologies.entries[b_idx as usize].disjoint_indices[b_dc as usize] = a_idx
                        c.ontologies.entries[b_idx as usize].disjoint_count = b_dc + 1
                    }
                }
                c.collect_ontology_disjoints((*list).tail)
            }
        }
    }

    // --------------------------------------------------------
    // Collect impl methods
    // --------------------------------------------------------

    fn collect_impl_def(self, opt: Option<Box<ImplDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.collect_impl_methods((*id).methods, impl_ty.name)
                c
            }
            None => self
        }
    }

    fn collect_impl_methods(self, opt: Option<Box<ItemList>>, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.collect_impl_method((*list).head, type_name)
                c.collect_impl_methods((*list).tail, type_name)
            }
            None => self
        }
    }

    fn collect_impl_method(self, item: Item, type_name: Name) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                let pair = self.collect_method_params((*fd).params)
                var c = pair.0
                let params = pair.1
                let param_count = pair.2
                let ret_pair = c.lower_opt_return_type((*fd).return_type)
                c = ret_pair.0
                let ret_ty = ret_pair.1

                // Extract effects from method signature (including user-defined)
                let eff_pair = c.extract_effects_with_checker((*fd).effects)
                c = eff_pair.0
                let fn_effects = eff_pair.1
                let fn_effect_count = eff_pair.2

                let sig = FnSig {
                    name: item.name,
                    params: params,
                    param_count: param_count,
                    return_type: ret_ty,
                    is_method: true,
                    self_type_name: type_name,
                    self_type_entry: c.current_impl_type,
                    effects: fn_effects,
                    effect_count: fn_effect_count,
                    is_kernel: false,
                    is_epistemic_kernel: false,
                    is_linear_closure: false,
                    linear_capture_count: 0,
                    epistemic_epsilon: 0.0 - 1.0,
                }
                let add_result = c.fn_sigs.add(sig)
                c.fn_sigs = add_result.0
                c
            }
            None => self
        }
    }

    fn collect_method_params(self, opt: Option<Box<ParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                // Skip self param for method signatures
                if (*pl).head.is_self {
                    self.collect_fn_params((*pl).tail)
                } else {
                    let pair = self.collect_fn_param_list(*pl)
                    (pair.0, Some(Box::new(pair.1)), pair.2)
                }
            }
            None => (self, None, 0)
        }
    }
}

// ============================================================
// Pass 2: Check all items
// ============================================================

impl Checker {
    fn check_items(self, items: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        var cursor = items
        while true {
            match cursor {
                Some(list) => {
                    c = c.check_item((*list).head)
                    cursor = (*list).tail
                }
                None => break
            }
        }
        c
    }

    fn check_item(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.kind {
            ItemFn => self.check_fn_item(item.fn_def)
            ItemStruct => self
            ItemEnum => self
            ItemImpl => self.check_impl_item(item.impl_def)
            ItemTypeAlias => self
            ItemModels => self
            ItemPolicy => self
            ItemAcquisitionPolicy => self
            ItemRecoursePolicy => self
            ItemTransitionPolicy => self
            ItemTransitionProtocol => self
            ItemMonitoringPolicy => self
            ItemAlternativePolicy => self
            ItemAlternativeFrontier => self
            ItemDecisionPolicy => self
            ItemDeferralPolicy => self
            ItemValidation => self
            ItemAudit => self
            ItemUse => self
            ItemUnit => self  // Already handled in collect pass
            ItemEffect => self  // Already handled in collect pass
            ItemSession => self  // Session protocol declaration — type-checking is structural
            ItemTrait => self  // Trait methods already collected in pass 1
            ItemAlgebra => self  // Already handled in collect pass
            ItemStudy => self  // Already handled in collect pass
            ItemOntology => self  // Already handled in collect pass
        }
    }

    // --------------------------------------------------------
    // Check function definition
    // --------------------------------------------------------

    fn check_fn_item(self, opt: Option<Box<FnDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(fd) => {
                var c = self
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let saved_multitest_count = c.multitest_count
                let saved_multitest_corrected = c.multitest_corrected
                let sig_id = c.fn_sigs.find((*fd).name)
                if sig_id >= 0 {
                    let sig = c.fn_sigs.get(sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                }
                c.multitest_count = 0
                c.multitest_corrected = false
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c.ownership = own_enter_scope(c.ownership)
                c = c.push_const_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                // Check return type compatibility
                if sig_id >= 0 {
                    let sig2 = c.fn_sigs.get(sig_id)
                    if !types_compatible(body_ty, sig2.return_type) {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                if c.multitest_count > 1 && !c.multitest_corrected {
                    c = c.report_multitest_correction_required((*fd).span, c.multitest_count)
                }
                // Check linear types consumed at function exit
                let own_errors = own_check_linear_at_end(c.ownership)
                if own_errors.error_count > 0 {
                    var ei: i64 = 0
                    while ei < own_errors.error_count {
                        c = c.report_error_at((*fd).span, 40, 0, 0, 0)
                        ei = ei + 1
                    }
                }
                c = c.pop_const_scope()
                c.borrows = c.borrows.pop_scope()
                c.ownership = own_exit_scope(c.ownership)
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c.multitest_count = saved_multitest_count
                c.multitest_corrected = saved_multitest_corrected
                c
            }
            None => self
        }
    }

    fn bind_fn_params(self, opt: Option<Box<ParamList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_fn_param((*pl).head)
                c.bind_fn_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_fn_param(self, p: Param) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        if p.is_self {
            c.env = c.env.bind(p.name, c.current_impl_type, p.is_self_mut)
            c = c.const_int_bind_unknown(p.name)
            // Track self parameter for borrow checking
            let self_linear = c.is_linear_type(c.current_impl_type)
            c.borrows = c.borrows.track(p.name, self_linear)
            c
        } else {
            let pair = c.lower_type_expr(p.ty)
            c = pair.0
            let param_ty = pair.1
            c.env = c.env.bind(p.name, param_ty, false)
            c = c.const_int_bind_unknown(p.name)
            // Track parameter for borrow checking (linear if struct is declared linear)
            let lin = c.is_linear_type(param_ty)
            c.borrows = c.borrows.track(p.name, lin)
            c
        }
    }

    // --------------------------------------------------------
    // Check impl definition
    // --------------------------------------------------------

    fn check_impl_item(self, opt: Option<Box<ImplDef>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(id) => {
                let pair = self.lower_type_expr((*id).target_type)
                var c = pair.0
                let impl_ty = pair.1
                c.current_impl_type = impl_ty
                c = c.check_impl_methods((*id).methods)
                c.current_impl_type = ty_error()
                c
            }
            None => self
        }
    }

    fn check_impl_methods(self, opt: Option<Box<ItemList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.check_impl_method((*list).head)
                c.check_impl_methods((*list).tail)
            }
            None => self
        }
    }

    fn check_impl_method(self, item: Item) -> Checker with Mut, Panic, Div, Alloc, IO {
        match item.fn_def {
            Some(fd) => {
                var c = self
                // Save outer effects context
                let saved_effects = c.current_effects
                let saved_effect_count = c.current_effect_count
                let saved_multitest_count = c.multitest_count
                let saved_multitest_corrected = c.multitest_corrected
                let sig_id = c.fn_sigs.find_method(c.current_impl_type.name, (*fd).name)
                if sig_id >= 0 {
                    let sig = c.fn_sigs.get(sig_id)
                    c.current_return_type = sig.return_type
                    c.current_effects = sig.effects
                    c.current_effect_count = sig.effect_count
                }
                c.multitest_count = 0
                c.multitest_corrected = false
                c.env = c.env.push_scope()
                c.borrows = c.borrows.push_scope()
                c = c.push_const_scope()
                c = c.bind_fn_params((*fd).params)
                let pair = c.check_block((*fd).body)
                c = pair.0
                let body_ty = pair.1
                if sig_id >= 0 {
                    let sig2 = c.fn_sigs.get(sig_id)
                    if !types_compatible(body_ty, sig2.return_type) {
                        c = c.report_mismatch((*fd).span, 8, sig2.return_type, body_ty)
                    }
                }
                if c.multitest_count > 1 && !c.multitest_corrected {
                    c = c.report_multitest_correction_required((*fd).span, c.multitest_count)
                }
                c = c.pop_const_scope()
                c.borrows = c.borrows.pop_scope()
                c.env = c.env.pop_scope()
                c.current_return_type = ty_unit()
                // Restore outer effects context
                c.current_effects = saved_effects
                c.current_effect_count = saved_effect_count
                c.multitest_count = saved_multitest_count
                c.multitest_corrected = saved_multitest_corrected
                c
            }
            None => self
        }
    }
}

// ============================================================
// Block and statement checking
// ============================================================

impl Checker {
    fn check_block(self, blk: Block) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        let pair = c.check_stmts(blk.stmts)
        c = pair.0
        let result_ty = pair.1
        // Check that all linear variables in this scope have been consumed
        let linear_check = c.borrows.check_linear_consumed()
        c.borrows = linear_check.0
        if linear_check.1 > 0 {
            c.had_error = true
            c.error_count = c.error_count + 1
            print("error[E040]: linear value not consumed (")
            print_int(linear_check.1)
            print(" unconsumed)\n")
        }
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, result_ty)
    }

    fn check_stmts(self, opt: Option<Box<StmtList>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_stmt((*list).head)
                var c = pair.0
                let stmt_ty = pair.1
                match (*list).tail {
                    Some(_) => c.check_stmts((*list).tail)
                    None => (c, stmt_ty)
                }
            }
            None => (self, ty_unit())
        }
    }

    fn check_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match s.kind {
            StmtLet => self.check_let_stmt(s)
            StmtVar => self.check_var_stmt(s)
            StmtExpr => self.check_expr_stmt(s)
            StmtAssign => self.check_assign_stmt(s)
        }
    }

    fn check_let_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_binding_init_expr(s.expr, ann_ty)
        c = init_pair.0
        let init_ty = init_pair.1
        // Determine binding type: annotation if present, else init type
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            // Integer literal narrowing: literal 5 (i64) is compatible with i32/i8 annotations
            let int_lit_narrow = c.last_literal_kind == 1
                && init_ty.kind == TypeKind::TyI64
                && (ann_ty.kind == TypeKind::TyI32 || ann_ty.kind == TypeKind::TyI8)
            if !types_compatible(init_ty, ann_ty) && !int_lit_narrow {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            if ann_ty.kind == init_ty.kind
                && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                    || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                    || ann_ty.kind == TypeKind::TyValidated
                    || ann_ty.kind == TypeKind::TyAdmissible
                    || ann_ty.kind == TypeKind::TyDeferred
                    || ann_ty.kind == TypeKind::TyAcquisitionPlan
                    || ann_ty.kind == TypeKind::TyRecoursePlan
                    || ann_ty.kind == TypeKind::TyTransitionPlan
                    || ann_ty.kind == TypeKind::TyObservedTransition
                    || ann_ty.kind == TypeKind::TyRollbackCertificate
                    || ann_ty.kind == TypeKind::TyAlternativeSet
                    || ann_ty.kind == TypeKind::TyAlternativeOption) {
                bind_ty = init_ty
            } else {
                bind_ty = ann_ty
            }
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        let const_pair = eval_const_int_opt_expr(c, s.expr)
        let cur_env = c.env
        c.env = cur_env.bind(s.name, bind_ty, false)
        if const_pair.0 {
            c = c.const_int_bind_value(s.name, const_pair.1)
        } else {
            c = c.const_int_bind_unknown(s.name)
        }
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        if lin {
            c.ownership = own_declare_var(c.ownership, s.name, OwnTypeKind::TyLinear)
        }
        (c, ty_unit())
    }

    fn check_var_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.last_literal_kind = 0  // reset before checking init expr
        let ann_pair = c.lower_opt_type(s.ty)
        c = ann_pair.0
        let ann_ty = ann_pair.1
        let init_pair = c.check_binding_init_expr(s.expr, ann_ty)
        c = init_pair.0
        let init_ty = init_pair.1
        var bind_ty = init_ty
        if ann_ty.kind != TypeKind::TyUnknown {
            // Integer literal narrowing: literal 5 (i64) is compatible with i32/i8 annotations
            let int_lit_narrow = c.last_literal_kind == 1
                && init_ty.kind == TypeKind::TyI64
                && (ann_ty.kind == TypeKind::TyI32 || ann_ty.kind == TypeKind::TyI8)
            if !types_compatible(init_ty, ann_ty) && !int_lit_narrow {
                c = c.report_mismatch(s.span, 1, ann_ty, init_ty)
            }
            if ann_ty.kind == init_ty.kind
                && (((ann_ty.kind == TypeKind::TyContest) && ann_ty.epistemic_meta_id >= 0)
                    || ((ann_ty.kind == TypeKind::TyRobust) && ann_ty.robustness_level_id >= 0 && ann_ty.robustness_scope_id >= 0)
                    || ann_ty.kind == TypeKind::TyValidated
                    || ann_ty.kind == TypeKind::TyAdmissible
                    || ann_ty.kind == TypeKind::TyDeferred
                    || ann_ty.kind == TypeKind::TyAcquisitionPlan
                    || ann_ty.kind == TypeKind::TyRecoursePlan
                    || ann_ty.kind == TypeKind::TyTransitionPlan
                    || ann_ty.kind == TypeKind::TyObservedTransition
                    || ann_ty.kind == TypeKind::TyRollbackCertificate
                    || ann_ty.kind == TypeKind::TyAlternativeSet
                    || ann_ty.kind == TypeKind::TyAlternativeOption) {
                bind_ty = init_ty
            } else {
                bind_ty = ann_ty
            }
        }
        // Validate refinement predicate on literal initializers
        c = c.check_refinement_literal(s.span, bind_ty)
        let const_pair = eval_const_int_opt_expr(c, s.expr)
        c.env = c.env.bind(s.name, bind_ty, true)
        if const_pair.0 {
            c = c.const_int_bind_value(s.name, const_pair.1)
        } else {
            c = c.const_int_bind_unknown(s.name)
        }
        // Track variable for borrow checking (linear if struct is declared linear)
        let lin = c.is_linear_type(bind_ty)
        c.borrows = c.borrows.track(s.name, lin)
        // Register in ownership context for state tracking
        if lin {
            c.ownership = own_declare_var(c.ownership, s.name, OwnTypeKind::TyLinear)
        }
        (c, ty_unit())
    }

    fn check_refinement_literal(self, span: Span, ty: TypeEntry) -> Checker with Mut, Panic, Div {
        if ty.refinement_id < 0 || ty.refinement_id >= 128 { return self }
        let rt = self.refinements.entries[ty.refinement_id as usize]
        var c = self
        if c.last_literal_kind == 1 {
            // Integer literal — check predicate
            if !pred_check_int(rt.predicate, c.last_literal_int) {
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        } else if c.last_literal_kind == 2 {
            // Float literal — check predicate
            if !pred_check_float(rt.predicate, c.last_literal_float) {
                c = c.report_error_at(span, 42, 0, 0, 0)
            }
        }
        // Reset literal tracking
        c.last_literal_kind = 0
        c
    }

    fn is_linear_type(self, ty: TypeEntry) -> bool with Mut, Panic, Div {
        if ty.kind == TypeKind::TyNamed {
            let idx = self.structs.find(ty.name)
            if idx >= 0 {
                return self.structs.entries[idx].is_linear
            }
        }
        false
    }

    fn check_expr_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_expr(s.expr)
    }

    fn check_assign_stmt(self, s: Stmt) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let target_pair = c.check_opt_expr(s.target)
        c = target_pair.0
        let target_ty = target_pair.1
        let val_pair = c.check_opt_expr(s.expr)
        c = val_pair.0
        let val_ty = val_pair.1
        // Compound assignments (+=, -=, etc.) require numeric operands
        if s.assign_op != AssignOp::AssignEq {
            if !is_error_or_unknown(target_ty) && !is_error_or_unknown(val_ty) {
                let compound_result = binary_result_type(compound_assign_to_binop(s.assign_op), target_ty, val_ty)
                if compound_result.kind == TypeKind::TyError {
                    c = c.report_mismatch(s.span, 21, target_ty, val_ty)
                }
            }
        } else {
            // Simple assignment: check compatibility
            if !types_compatible(target_ty, val_ty) {
                c = c.report_mismatch(s.span, 2, target_ty, val_ty)
            }
        }
        // Check mutability: if target is an ident, it must be mutable
        c = c.check_assign_mutability(s.target, s.span)
        match s.target {
            Some(target) => {
                if (*target).kind == ExprKind::ExprIdent {
                    let rhs_pair = eval_const_int_opt_expr(c, s.expr)
                    if rhs_pair.0 {
                        c = c.const_int_bind_value((*target).name, rhs_pair.1)
                    } else {
                        c = c.const_int_bind_unknown((*target).name)
                    }
                }
            }
            None => {}
        }
        (c, ty_unit())
    }

    fn check_assign_mutability(self, opt: Option<Box<Expr>>, span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => {
                if (*e).kind == ExprKind::ExprIdent {
                    if !self.env.lookup_is_mutable((*e).name) {
                        self.report_error_at(span, 3, 0, 0, 0)
                    } else {
                        self
                    }
                } else {
                    // Field access, index — assume mutable for now
                    self
                }
            }
            None => self
        }
    }

    fn check_opt_expr(self, opt: Option<Box<Expr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => self.check_expr(*e)
            None => (self, ty_unit())
        }
    }

    fn check_binding_init_expr(self, opt: Option<Box<Expr>>, ann_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(e) => {
                if (*e).kind == ExprKind::ExprContest {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_contest_expr_expected(*e, ann_ty)
                    } else {
                        self.check_contest_expr_no_annotation(*e)
                    }
                } else if (*e).kind == ExprKind::ExprCall && call_expr_is_builtin_lift_knowledge((*e).left) {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_lift_knowledge_expr_expected(*e, ann_ty)
                    } else {
                        self.check_expr(*e)
                    }
                } else if (*e).kind == ExprKind::ExprAuditAttach {
                    if ann_ty.kind == TypeKind::TyContest {
                        self.check_audit_attach_expr_expected(*e, ann_ty)
                    } else {
                        self.check_expr(*e)
                    }
                } else if (*e).kind == ExprKind::ExprPath && ann_ty.kind == TypeKind::TyNamed {
                    // Bidirectional inference for enum variants: Option::None with
                    // annotation Option<i32> → use the annotation type so generic
                    // parameters are preserved.
                    let path_pair = self.check_path_expr(*e)
                    let c = path_pair.0
                    let path_ty = path_pair.1
                    if path_ty.kind == TypeKind::TyNamed && name_eq(path_ty.name, ann_ty.name) {
                        (c, ann_ty)
                    } else {
                        (c, path_ty)
                    }
                } else {
                    self.check_expr(*e)
                }
            }
            None => (self, ty_unit())
        }
    }
}

// ============================================================
// Expression type checking — dispatch
// ============================================================

impl Checker {
    fn check_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check expression depth limit
        let depth_pair = self.check_expr_depth(e.span)
        var c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        let result = match e.kind {
            ExprIntLit => {
                c.last_literal_int = e.int_val
                c.last_literal_kind = 1
                (c, ty_i64())
            }
            ExprFloatLit => {
                c.last_literal_float = e.float_val
                c.last_literal_kind = 2
                (c, ty_f64())
            }
            ExprBoolTrue => (c, ty_bool())
            ExprBoolFalse => (c, ty_bool())
            ExprStringLit => (c, ty_string())
            ExprCharLit => (c, ty_char())
            ExprIdent => {
                let ident_ty = c.env.lookup(e.name)
                // If this is a linear type variable, mark it as consumed
                var c2 = c
                if c2.is_linear_type(ident_ty) && c2.suppress_linear_consume_depth == 0 {
                    // CRITICAL FIX: Check if borrowed before consuming
                    if c2.borrows.is_borrowed(e.name) {
                        c2 = c2.report_error_at(e.span, 38, 0, 0, 0)  // Cannot consume borrowed value
                    } else {
                        let consume_result = c2.borrows.consume_linear(e.name)
                        c2.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c2 = c2.report_error_at(e.span, consume_result.1, 0, 0, 0)
                        }
                        // Ownership state machine: transfer (move) the linear value
                        let own_result = own_transfer(c2.ownership, e.name)
                        c2.ownership = own_result.0
                    }
                }
                (c2, ident_ty)
            }
            ExprPath => c.check_path_expr(e)
            ExprBinary => c.check_binary_expr(e)
            ExprUnary => c.check_unary_expr(e)
            ExprFieldAccess => c.check_field_access(e)
            ExprIndex => c.check_index_expr(e)
            ExprMethodCall => c.check_method_call(e)
            ExprCall => c.check_call_expr(e)
            ExprIf => c.check_if_expr(e)
            ExprMatch => c.check_match_expr(e)
            ExprWhile => c.check_while_expr(e)
            ExprLoop => c.check_loop_expr(e)
            ExprBlock => c.check_block_expr(e)
            ExprReturn => c.check_return_expr(e)
            ExprBreak => c.check_break_expr(e)
            ExprContinue => c.check_continue_expr(e)
            ExprStructLit => c.check_struct_lit(e)
            ExprArrayLit => c.check_array_lit(e)
            ExprTupleLit => c.check_tuple_lit(e)
            ExprRange => c.check_range_expr(e)
            ExprCast => c.check_cast_expr(e)
            ExprHandle => c.check_handle_expr(e)
            ExprClosure => c.check_closure_expr(e)
            ExprContest => c.check_contest_expr_no_annotation(e)
            ExprAuditAttach => c.check_audit_attach_expr(e)
            ExprForIn => c.check_for_in_expr(e)
            ExprError => (c, ty_error())
        }
        (result.0.exit_expr_depth(), result.1)
    }

    // --------------------------------------------------------
    // Path expression — enum variant
    // --------------------------------------------------------

    fn check_path_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // First segment is enum/type name, last is variant
        // For now, look up first segment as enum name
        let first_name = checker_copy_string_list_to_name(e.path.segments)
        let enum_idx = self.enums.find(first_name)
        if enum_idx >= 0 {
            (self, ty_named(first_name))
        } else {
            // Could be a variant name directly (e.g. None, Some)
            let variant_enum_idx = self.enums.find_variant_enum(first_name)
            if variant_enum_idx >= 0 {
                let ei = self.enums.get(variant_enum_idx)
                (self, ty_named(ei.name))
            } else {
                // Look up in env as a regular binding
                (self, self.env.lookup(first_name))
            }
        }
    }

    // --------------------------------------------------------
    // Binary expression
    // --------------------------------------------------------

    fn check_binary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let left_ty = left_pair.1
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        let right_ty = right_pair.1

        // Observer semantics: comparing Unobserved<T> requires with Observe
        if left_ty.kind == TypeKind::TyUnobserved || right_ty.kind == TypeKind::TyUnobserved {
            let is_cmp = e.bin_op == BinaryOp::OpEq || e.bin_op == BinaryOp::OpNe
                || e.bin_op == BinaryOp::OpLt || e.bin_op == BinaryOp::OpLe
                || e.bin_op == BinaryOp::OpGt || e.bin_op == BinaryOp::OpGe
            if is_cmp {
                let observe_id: i64 = 13
                if !has_effect_id(c.current_effects, c.current_effect_count, observe_id) {
                    c = c.report_error_at(e.span, 36, 0, 0, 0)
                }
            }
        }

        // Validate binary operator type constraints
        c = c.check_binary_op_types(e.span, e.bin_op, left_ty, right_ty)

        // Epsilon propagation for Knowledge types
        // If either operand is Knowledge<T, epsilon>, propagate epsilon bounds
        if is_knowledge_type(left_ty) || is_knowledge_type(right_ty) {
            let left_inner = if is_knowledge_type(left_ty) { knowledge_inner(left_ty) } else { left_ty }
            let right_inner = if is_knowledge_type(right_ty) { knowledge_inner(right_ty) } else { right_ty }
            if left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
                let hyper_checked = check_hyper_binary(c, e.span, e.bin_op, left_inner, right_inner)
                c = hyper_checked.0
            }
            let knowledge_result = knowledge_binary_result(e.bin_op, left_ty, right_ty)
            if knowledge_result.kind == TypeKind::TyError {
                c = c.report_error_at(e.span, 36, 0, 0, 0)
            }
            // Continue with normal checking for inner type compatibility
            // The knowledge_binary_result handles epsilon propagation
            let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, knowledge_result)
            c = result_with_units.0
            let final_result = result_with_units.1
            if e.bin_op == BinaryOp::OpMul && left_inner.kind == TypeKind::TyHyper && right_inner.kind == TypeKind::TyHyper {
                let final_inner = if final_result.kind == TypeKind::TyKnowledge {
                    knowledge_inner(final_result)
                } else {
                    final_result
                }
                if final_inner.kind == TypeKind::TyHyper {
                    c = c.record_hyper_expr(e.span, final_inner.algebra_kind, 1, true)
                }
            }
            return (c, final_result)
        }

        if left_ty.kind == TypeKind::TyHyper && right_ty.kind == TypeKind::TyHyper {
            let hyper_result = check_hyper_binary(c, e.span, e.bin_op, left_ty, right_ty)
            c = hyper_result.0
            let typed_result = hyper_result.1
            let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, typed_result)
            c = result_with_units.0
            let final_result = result_with_units.1
            if e.bin_op == BinaryOp::OpMul && final_result.kind == TypeKind::TyHyper {
                c = c.record_hyper_expr(e.span, final_result.algebra_kind, 1, false)
            }
            return (c, final_result)
        }

        let result = binary_result_type(e.bin_op, left_ty, right_ty)
        if result.kind == TypeKind::TyError && !is_error_or_unknown(left_ty) && !is_error_or_unknown(right_ty) {
            c = c.report_mismatch(e.span, 4, left_ty, right_ty)
        }
        // Division/modulo by zero: detect denominators that fold to a constant integer zero.
        if e.bin_op == BinaryOp::OpDiv {
            let denom_pair = eval_const_int_opt_expr(c, e.right)
            if denom_pair.0 && denom_pair.1 == 0 {
                c = c.report_error_at(e.span, 56, 0, 0, 0)
            }
        } else if e.bin_op == BinaryOp::OpRem {
            let denom_pair = eval_const_int_opt_expr(c, e.right)
            if denom_pair.0 && denom_pair.1 == 0 {
                c = c.report_error_at(e.span, 57, 0, 0, 0)
            }
        }
        // Unit checking for arithmetic on unit-typed values
        let result_with_units = c.check_binary_units(e.span, e.bin_op, left_ty, right_ty, result)
        c = result_with_units.0
        let final_result = result_with_units.1
        (c, final_result)
    }

    fn check_binary_op_types(self, span: Span, op: BinaryOp, left_ty: TypeEntry, right_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        if is_error_or_unknown(left_ty) || is_error_or_unknown(right_ty) {
            return self
        }
        match op {
            OpBitAnd => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpBitOr => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpBitXor => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 48, 0, 0, 0)
                }
                self
            }
            OpShl => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            OpShr => {
                if !is_integer_type(left_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                if !is_integer_type(right_ty) {
                    return self.report_error_at(span, 49, 0, 0, 0)
                }
                self
            }
            OpRem => {
                if !is_integer_type(left_ty) || !is_integer_type(right_ty) {
                    return self.report_error_at(span, 50, 0, 0, 0)
                }
                self
            }
            OpAnd => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            OpOr => {
                if !is_bool_type(left_ty) || !is_bool_type(right_ty) {
                    return self.report_error_at(span, 51, 0, 0, 0)
                }
                self
            }
            _ => self
        }
    }

    fn check_binary_units(self, span: Span, op: BinaryOp, left: TypeEntry, right: TypeEntry, result: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let lu = left.unit_id
        let ru = right.unit_id
        // If neither side has units, nothing to check
        if lu < 0 && ru < 0 {
            return (c, result)
        }
        match op {
            // Addition/subtraction: units must match exactly
            OpAdd => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            OpSub => {
                if lu != ru {
                    c = c.report_unit_mismatch(span, lu, ru)
                    (c, result)
                } else {
                    (c, ty_with_unit(result, lu))
                }
            }
            // Multiplication: combine unit dimensions
            OpMul => {
                if lu >= 0 && ru >= 0 {
                    // Both have units — product gets combined dimensions
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let prod = unit_dim_mul(ld, rd)
                    // For now, result is f64 with no named unit (product unit)
                    // A future pass could register the product unit
                    (c, result)
                } else {
                    // One side has units, other is scalar — keep the unit
                    let uid = if lu >= 0 { lu } else { ru }
                    (c, ty_with_unit(result, uid))
                }
            }
            // Division: combine unit dimensions
            OpDiv => {
                if lu >= 0 && ru >= 0 {
                    let ld = c.units.get_dim(lu)
                    let rd = c.units.get_dim(ru)
                    let quot = unit_dim_div(ld, rd)
                    if unit_dim_is_dimensionless(quot) {
                        // Units cancel out — result is dimensionless
                        (c, result)
                    } else {
                        // Quotient has dimensions — result is f64 (unnamed unit)
                        (c, result)
                    }
                } else if lu >= 0 {
                    // numerator has units, denominator is scalar — keep unit
                    (c, ty_with_unit(result, lu))
                } else {
                    // numerator is scalar, denominator has units — inverse unit
                    (c, result)
                }
            }
            // Comparison operators: units must match
            OpEq => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpNe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpLt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpLe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpGt => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            OpGe => { if lu != ru { c = c.report_unit_mismatch(span, lu, ru) }; (c, result) }
            // Other operators: pass through
            _ => (c, result)
        }
    }

    fn report_unit_mismatch(self, span: Span, left_uid: i64, right_uid: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.had_error = true
        c.error_count = c.error_count + 1
        print("error[E041]: unit mismatch in arithmetic operation\n")
        print("  left unit: ")
        if left_uid >= 0 {
            print_unit_dim(c.units.get_dim(left_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n  right unit: ")
        if right_uid >= 0 {
            print_unit_dim(c.units.get_dim(right_uid))
        } else {
            print("(dimensionless)")
        }
        print("\n")
        c
    }

    // --------------------------------------------------------
    // Unary expression
    // --------------------------------------------------------

    fn check_slice_borrow_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let want_mut = e.un_op == UnaryOp::OpRefMut
        let borrow_name = unary_operand_name(e.left)
        match e.left {
            Some(index_expr) => {
                let idx_expr = *index_expr
                if idx_expr.kind != ExprKind::ExprIndex {
                    return (self.report_error_at(e.span, 13, 0, 0, 0), ty_error())
                }
                let base_pair = self.check_opt_expr(idx_expr.left)
                var c = base_pair.0
                let base_ty = base_pair.1
                let result_ty = slice_borrow_result_type(base_ty, want_mut)
                if result_ty.kind == TypeKind::TyError && !is_error_or_unknown(base_ty) {
                    c = c.report_error_at(e.span, 13, 0, 0, 0)
                }
                match idx_expr.right {
                    Some(range_expr) => {
                        if (*range_expr).kind != ExprKind::ExprRange || (*range_expr).bin_op != BinaryOp::OpRange {
                            c = c.report_error_at(e.span, 13, 0, 0, 0)
                        } else {
                            match (*range_expr).left {
                                Some(start_expr) => {
                                    let start_pair = c.check_expr(*start_expr)
                                    c = start_pair.0
                                    if !is_error_or_unknown(start_pair.1) && !is_integer_type(start_pair.1) {
                                        c = c.report_mismatch(e.span, 55, ty_i64(), start_pair.1)
                                    }
                                }
                                None => {
                                    c = c.report_error_at(e.span, 13, 0, 0, 0)
                                }
                            }
                            match (*range_expr).right {
                                Some(end_expr) => {
                                    let end_pair = c.check_expr(*end_expr)
                                    c = end_pair.0
                                    if !is_error_or_unknown(end_pair.1) && !is_integer_type(end_pair.1) {
                                        c = c.report_mismatch(e.span, 55, ty_i64(), end_pair.1)
                                    }
                                }
                                None => {
                                    c = c.report_error_at(e.span, 13, 0, 0, 0)
                                }
                            }
                        }
                    }
                    None => {
                        c = c.report_error_at(e.span, 13, 0, 0, 0)
                    }
                }
                if borrow_name.len > 0 {
                    if want_mut {
                        let borrow_result = c.borrows.try_exclusive_borrow(borrow_name)
                        c.borrows = borrow_result.0
                        if borrow_result.1 != 0 {
                            c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                        }
                    } else {
                        let borrow_result = c.borrows.try_shared_borrow(borrow_name)
                        c.borrows = borrow_result.0
                        if borrow_result.1 != 0 {
                            c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                        }
                    }
                }
                (c, result_ty)
            }
            None => (self.report_error_at(e.span, 13, 0, 0, 0), ty_error())
        }
    }

    fn check_unary_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        if (e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut) && expr_is_half_open_range(e.left) {
            return self.check_slice_borrow_expr(e)
        }
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let operand_ty = pair.1
        let result = unary_result_type(e.un_op, operand_ty)
        if result.kind == TypeKind::TyError && !is_error_or_unknown(operand_ty) {
            c = c.report_error_at(e.span, 5, 0, 0, 0)
        }
        // Borrow checking: if this is &x or &!x on a named variable
        if e.un_op == UnaryOp::OpRef || e.un_op == UnaryOp::OpRefMut {
            let borrow_name = unary_operand_name(e.left)
            if borrow_name.len > 0 {
                if e.un_op == UnaryOp::OpRef {
                    let borrow_result = c.borrows.try_shared_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                } else {
                    let borrow_result = c.borrows.try_exclusive_borrow(borrow_name)
                    c.borrows = borrow_result.0
                    if borrow_result.1 != 0 {
                        c = c.report_error_at(e.span, borrow_result.1, 0, 0, 0)
                    }
                }
            }
        }
        (c, result)
    }

    // --------------------------------------------------------
    // Field access
    // --------------------------------------------------------

    fn check_field_access(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let base_ty = pair.1
        if base_ty.kind == TypeKind::TyNamed {
            let struct_idx = c.structs.find(base_ty.name)
            if struct_idx >= 0 {
                let si = c.structs.get(struct_idx)
                let field_ty = field_info_list_find(si.fields, e.name)
                if field_ty.kind == TypeKind::TyError && !field_info_list_has(si.fields, e.name) {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                }
                (c, field_ty)
            } else {
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T> field access: .value -> T, .epsilon -> f64
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                // "value" = [118, 97, 108, 117, 101]
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                // "epsilon" = [101, 112, 115, 105, 108, 111, 110]
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyIntervention {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyCounterfactual {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyValidated {
            if name_matches_str5(e.name, 118, 97, 108, 117, 101) {
                (c, knowledge_inner(base_ty))
            } else if name_matches_str7(e.name, 101, 112, 115, 105, 108, 111, 110) {
                (c, ty_f64())
            } else {
                c = c.report_error_at(e.span, 12, 0, 0, 0)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper field access: delegates to hyper.sio predicates
            // Complex: .real, .imag -> inner type
            // Quaternion: .w, .x, .y, .z -> inner type
            // Octonion: .e0.e7 -> inner type
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // Complex fields
            if alg == 1 {
                // "real" = [114, 101, 97, 108], "imag" = [105, 109, 97, 103]
                if name_matches_str4(e.name, 114, 101, 97, 108) { (c, inner_ty) }
                else if name_matches_str4(e.name, 105, 109, 97, 103) { (c, inner_ty) }
                else {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                    (c, ty_error())
                }
            // Quaternion fields
            } else if alg == 2 {
                // .w .x .y .z (119, 120, 121, 122)
                if name_matches_str1(e.name, 119) { (c, inner_ty) }
                else if name_matches_str1(e.name, 120) { (c, inner_ty) }
                else if name_matches_str1(e.name, 121) { (c, inner_ty) }
                else if name_matches_str1(e.name, 122) { (c, inner_ty) }
                else {
                    c = c.report_error_at(e.span, 12, 0, 0, 0)
                    (c, ty_error())
                }
            } else {
                // Octonion/Sedenion/Clifford: field access by component index
                // For now accept any short field name and return inner type
                (c, inner_ty)
            }
        } else if base_ty.kind == TypeKind::TyTuple {
            // Tuple field access by index (e.g. t.0, t.1)
            // The field name contains the index as ascii digits
            let idx = (e.name.buf[0] as i64) - 48
            let tuple_count = type_entry_list_count(base_ty.tuple_elems)
            if idx >= tuple_count {
                c = c.report_error_at(e.span, 47, 0, 0, 0)
                (c, ty_error())
            } else {
                let elem = type_entry_list_get(base_ty.tuple_elems, idx)
                (c, elem)
            }
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 12, 0, 0, 0)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Index expression
    // --------------------------------------------------------

    fn check_index_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let base_pair = self.check_opt_expr(e.left)
        var c = base_pair.0
        let base_ty = base_pair.1
        let idx_pair = c.check_opt_expr(e.right)
        c = idx_pair.0
        let idx_ty = idx_pair.1
        // Index must be i64
        if !is_error_or_unknown(idx_ty) && idx_ty.kind != TypeKind::TyI64 {
            c = c.report_error_at(e.span, 14, 0, 0, 0)
        }
        let elem_ty = indexable_elem_type(base_ty)
        if !is_error_or_unknown(base_ty) && elem_ty.kind == TypeKind::TyError {
            c = c.report_error_at(e.span, 13, 0, 0, 0)
            (c, ty_error())
        } else if is_error_or_unknown(base_ty) {
            (c, base_ty)
        } else {
            (c, elem_ty)
        }
    }

    // --------------------------------------------------------
    // Method call
    // --------------------------------------------------------

    fn check_method_call(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Method receiver evaluation should not eagerly consume linear values,
        // because receiver passing mode is method-signature dependent.
        var checker_for_base = self
        checker_for_base.suppress_linear_consume_depth = checker_for_base.suppress_linear_consume_depth + 1
        let base_pair = checker_for_base.check_opt_expr(e.left)
        var c = base_pair.0
        if c.suppress_linear_consume_depth > 0 {
            c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
        }
        let base_ty = base_pair.1
        if name_matches_str3(e.name, 108, 101, 110) && len_method_supported(base_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            return (c, ty_i64())
        }
        if base_ty.kind == TypeKind::TyKnowledge {
            // Knowledge<T>.unwrap() -> T
            if name_matches_str6(e.name, 117, 110, 119, 114, 97, 112) {
                // "unwrap" = [117, 110, 119, 114, 97, 112]
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, knowledge_inner(base_ty))
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyHyper {
            // Hyper method calls: .conjugate() .norm() .inverse()
            let alg = base_ty.algebra_kind
            let inner_ty = match base_ty.inner {
                Some(inner) => *inner
                None => ty_error()
            }
            // "conjugate" = [99,111,110,106,117,103,97,116,101] (9 chars)
            if name_matches_str9(e.name, 99, 111, 110, 106, 117, 103, 97, 116, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, base_ty)  // conjugate returns same Hyper type
            // "norm" = [110,111,114,109] (4 chars)
            } else if name_matches_str4(e.name, 110, 111, 114, 109) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, inner_ty)  // norm returns scalar
            // "inverse" = [105,110,118,101,114,115,101] (7 chars)
            } else if name_matches_str7(e.name, 105, 110, 118, 101, 114, 115, 101) {
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                // Only division algebras have inverse (alg <= 3)
                if alg > 3 {
                    c = c.report_error_at(e.span, 32, 0, 0, 0)
                    (c, ty_error())
                } else {
                    (c, base_ty)
                }
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyNamed {
            let sig_id = c.fn_sigs.find_method_semantic(base_ty, e.name)
            if sig_id >= 0 {
                let sig = c.fn_sigs.get(sig_id)
                let call_start_borrows = c.borrows
                c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
                // Verify callee method's effects are subset of caller's effects
                c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
                // Release borrows taken for method call arguments
                c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
                (c, sig.return_type)
            } else {
                // Method not found
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                // Still check args to accumulate errors
                let call_start_borrows = c.borrows
                c = c.check_expr_list_no_type_no_linear_consume(e.args)
                c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
                (c, ty_error())
            }
        } else if base_ty.kind == TypeKind::TyString {
            // String methods: .as_bytes() -> &[i8], .len() -> i64
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            // "as_bytes" = [97,115,95,98,121,116,101,115]
            if name_matches_str8(e.name, 97, 115, 95, 98, 121, 116, 101, 115) {
                (c, ty_ref(ty_i8()))
            // "len" = [108,101,110]
            } else if name_matches_str3(e.name, 108, 101, 110) {
                (c, ty_i64())
            } else {
                c = c.report_error_at(e.span, 11, 0, 0, 0)
                (c, ty_error())
            }
        } else if is_error_or_unknown(base_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, base_ty)
        } else {
            c = c.report_error_at(e.span, 19, 0, 0, 0)
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, ty_error())
        }
    }

    // --------------------------------------------------------
    // Function call
    // --------------------------------------------------------

    fn check_slice_len_call_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        let call_start_borrows = self.borrows
        let first_pair = self.check_opt_expr(first_arg)
        var c = first_pair.0
        let arg_ty = first_pair.1
        match first_arg {
            None => c = c.report_error_at(e.span, 10, 0, 0, 0)
            Some(_) => {}
        }
        match second_arg {
            Some(_) => c = c.report_error_at(e.span, 10, 0, 0, 0)
            None => {}
        }
        let is_ok =
            arg_ty.kind == TypeKind::TySlice
            || arg_ty.kind == TypeKind::TySliceMut
            || slice_param_accepts_array_ref(arg_ty, ty_slice(ty_unknown()))
        if !is_ok && !is_error_or_unknown(arg_ty) {
            c = c.report_error_at(e.span, 9, 0, 0, 0)
        }
        c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
        (c, ty_i64())
    }

    fn check_call_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Safety guard: ExprIndex nodes (e.right=Some) are occasionally dispatched here
        // due to a VM-level kind mismatch. ExprCall never sets e.right; ExprIndex always does.
        match e.right {
            Some(_) => return self.check_index_expr(e)
            None => {}
        }
        if call_expr_is_builtin_prove_robust(e.left) {
            return self.check_prove_robust_expr(e)
        }
        if call_expr_is_builtin_validate_manifest(e.left) {
            return self.check_validate_manifest_expr(e)
        }
        if call_expr_is_builtin_admit_action(e.left) {
            return self.check_admit_action_expr(e)
        }
        if call_expr_is_builtin_defer_action(e.left) {
            return self.check_defer_action_expr(e)
        }
        if call_expr_is_builtin_deferral_reason(e.left) {
            return self.check_deferral_reason_expr(e)
        }
        if call_expr_is_builtin_plan_acquisition(e.left) {
            return self.check_plan_acquisition_expr(e)
        }
        if call_expr_is_builtin_acquisition_reason(e.left) {
            return self.check_acquisition_reason_expr(e)
        }
        if call_expr_is_builtin_plan_recourse(e.left) {
            return self.check_plan_recourse_expr(e)
        }
        if call_expr_is_builtin_recourse_reason(e.left) {
            return self.check_recourse_reason_expr(e)
        }
        if call_expr_is_builtin_propose_alternatives(e.left) {
            return self.check_propose_alternatives_expr(e)
        }
        if call_expr_is_builtin_alternative_count(e.left) {
            return self.check_alternative_count_expr(e)
        }
        if call_expr_is_builtin_alternative_option(e.left) {
            return self.check_alternative_option_expr(e)
        }
        if call_expr_is_builtin_alternative_reason(e.left) {
            return self.check_alternative_reason_expr(e)
        }
        if call_expr_is_builtin_commit_alternative(e.left) {
            return self.check_commit_alternative_expr(e)
        }
        if call_expr_is_builtin_transition_reason(e.left) {
            return self.check_transition_reason_expr(e)
        }
        if call_expr_is_builtin_transition_step_count(e.left) {
            return self.check_transition_step_count_expr(e)
        }
        if call_expr_is_builtin_observe_transition(e.left) {
            return self.check_observe_transition_expr(e)
        }
        if call_expr_is_builtin_rollback_transition(e.left) {
            return self.check_rollback_transition_expr(e)
        }
        if call_expr_is_builtin_lift_knowledge(e.left) {
            return self.check_lift_knowledge_expr(e)
        }
        if call_expr_is_builtin_measure(e.left) {
            return self.check_measure_expr(e)
        }
        if call_expr_is_builtin_slice_len(e.left) {
            return self.check_slice_len_call_expr(e)
        }
        let witness_kind = call_expr_contest_witness_kind(e.left)
        if witness_kind >= 0 {
            return self.check_contest_witness_expr(e, witness_kind)
        }
        var c = self
        if multitest_effect_enabled(c.current_effects, c.current_effect_count) {
            let callee_name = multitest_call_name(e.left)
            if multitest_is_stat_test_name(callee_name) {
                c.multitest_count = c.multitest_count + 1
            } else if multitest_is_correction_name(callee_name) {
                c.multitest_corrected = true
            }
        }
        if hypothesis_effect_enabled(c.current_effects, c.current_effect_count) {
            let callee_name = multitest_call_name(e.left)
            if c.studies.count > 0 && multitest_is_stat_test_name(callee_name) {
                let outcome_name = hypothesis_outcome_name_from_args(e.args)
                if !name_is_empty(outcome_name) && !active_study_has_hypothesis_outcome(c.studies, outcome_name) {
                    c = c.report_hypothesis_penalty_warning(e.span, outcome_name)
                }
            }
        }
        let callee_pair = c.check_opt_expr(e.left)
        c = callee_pair.0
        let callee_ty = callee_pair.1
        let array_like_ty =
            if callee_ty.kind == TypeKind::TyArray {
                callee_ty
            } else if callee_ty.kind == TypeKind::TyRef || callee_ty.kind == TypeKind::TyRefMut {
                match callee_ty.inner {
                    Some(inner_ty) => *inner_ty
                    None => ty_error()
                }
            } else {
                ty_error()
            }
        if array_like_ty.kind == TypeKind::TyArray {
            let idx_arg = expr_list_head(e.args)
            let extra_arg = expr_list_second(e.args)
            match idx_arg {
                Some(arg) => {
                    let idx_pair = c.check_expr(*arg)
                    c = idx_pair.0
                    let idx_ty = idx_pair.1
                    if !is_error_or_unknown(idx_ty) && idx_ty.kind != TypeKind::TyI64 {
                        c = c.report_error_at(e.span, 14, 0, 0, 0)
                    }
                    match extra_arg {
                        Some(extra) => {
                            let extra_pair = c.check_expr(*extra)
                            c = extra_pair.0
                            c = c.report_error_at(e.span, 17, 0, 0, 0)
                            (c, ty_error())
                        }
                        None => {
                            match array_like_ty.inner {
                                Some(elem_ty) => return (c, *elem_ty)
                                None => return (c, ty_error())
                            }
                        }
                    }
                }
                None => {}
            }
        }
        if callee_ty.kind == TypeKind::TyFn && callee_ty.fn_sig_id >= 0 {
            let sig = c.fn_sigs.get(callee_ty.fn_sig_id)
            let call_start_borrows = c.borrows
            c = c.check_call_args(e.args, sig.params, sig.param_count, e.span)
            // Verify callee's effects are subset of caller's effects
            c = c.check_callee_effects(e.span, sig.effects, sig.effect_count)
            // Release borrows taken for call arguments — the call has returned,
            // so exclusive/shared borrows on arguments are no longer active.
            c = c.release_call_arg_borrows(e.args, sig.params, call_start_borrows)
            (c, sig.return_type)
        } else if is_error_or_unknown(callee_ty) {
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, callee_ty)
        } else {
            c = c.report_error_at(e.span, 17, 0, 0, 0)
            let call_start_borrows = c.borrows
            c = c.check_expr_list_no_type_no_linear_consume(e.args)
            c = c.release_call_arg_borrows(e.args, None, call_start_borrows)
            (c, ty_error())
        }
    }

    fn check_contest_expr_no_annotation(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_contest_expr_expected(e, ty_error())
        (pair.0.report_error_at(e.span, 59, 0, 0, 0), ty_error())
    }

    fn check_contest_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        let subject_pair = c.check_opt_expr(e.left)
        c = subject_pair.0
        let subject_ty = subject_pair.1
        if !contest_model_list_present(e.args) {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
        }
        if expected_contest_ty.kind == TypeKind::TyError || expected_contest_ty.kind != TypeKind::TyContest {
            (c, ty_error())
        } else {
            var info = contest_info_from_expr_models(e.args)
            info = contest_info_attach_span(info, e.span)
            if expected_contest_ty.epistemic_meta_id >= 0 && expected_contest_ty.epistemic_meta_id < c.contests.count {
                let expected_info = c.contests.get(expected_contest_ty.epistemic_meta_id)
                info.family_id = expected_info.family_id
                info.policy_id = expected_info.policy_id
                info.audit_id = expected_info.audit_id
                var i: i64 = 0
                while i < 8 {
                    info.metric_known[i as usize] = expected_info.metric_known[i as usize]
                    info.metric_values[i as usize] = expected_info.metric_values[i as usize]
                    i = i + 1
                }
                info.mechanistic_report_id = expected_info.mechanistic_report_id
                info.posterior_weights_id = expected_info.posterior_weights_id
                info.counterexample_id = expected_info.counterexample_id
                info.provenance_bundle_id = expected_info.provenance_bundle_id
                if expected_info.family_id >= 0 {
                    if expected_info.family_id >= c.model_families.count {
                        c = c.report_missing_model_family_metadata(e.span)
                    } else {
                        let family_info = c.model_families.get(expected_info.family_id)
                        if !contest_model_lists_match(e.args, family_info, 0) {
                            c = c.report_model_family_mismatch(e.span, family_info, info)
                        }
                        if !types_compatible(subject_ty, family_info.input_ty) {
                            c = c.report_mismatch(e.span, 1, family_info.input_ty, subject_ty)
                        }
                    }
                }
                c.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = info
                (c, ty_contest(knowledge_inner(expected_contest_ty), expected_contest_ty.epistemic_meta_id))
            } else {
                let add_result = c.contests.add(info)
                c.contests = add_result.0
                (c, ty_contest(knowledge_inner(expected_contest_ty), add_result.1))
            }
        }
    }

    fn check_audit_attach_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_audit_attach_expr_expected(e, ty_error())
    }

    fn check_audit_attach_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let audit_id = self.audits.find(e.name)
        if audit_id < 0 || audit_id >= self.audits.count {
            return (self.report_error_at(e.span, 86, 0, 0, 0), ty_error())
        }

        let audit_info = self.audits.get(audit_id)
        var seeded_expected_ty = expected_contest_ty
        var seeded_checker = self
        if expected_contest_ty.kind == TypeKind::TyContest
        && expected_contest_ty.epistemic_meta_id >= 0
        && expected_contest_ty.epistemic_meta_id < self.contests.count {
            let expected_info = self.contests.get(expected_contest_ty.epistemic_meta_id)
            if expected_info.family_id >= 0 && expected_info.policy_id >= 0 {
                if !contest_matches_audit_target(expected_contest_ty, expected_info, audit_info) {
                    return (self.report_audit_target_mismatch(e.span, e.name, audit_info, knowledge_inner(expected_contest_ty), expected_info), ty_error())
                }
                var merged_expected = contest_info_apply_audit(expected_info, audit_info, audit_id)
                merged_expected = contest_info_attach_span(merged_expected, e.span)
                seeded_checker.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = merged_expected
                seeded_expected_ty = ty_contest(knowledge_inner(expected_contest_ty), expected_contest_ty.epistemic_meta_id)
            }
        }
        let contest_pair = match e.left {
            Some(left_expr) => {
                if (*left_expr).kind == ExprKind::ExprContest {
                    let seeded_pair =
                        if seeded_expected_ty.kind == TypeKind::TyContest { (seeded_checker, seeded_expected_ty) }
                        else { self.contest_type_seeded_from_audit(audit_info, audit_id, e.span) }
                    if seeded_pair.1.kind == TypeKind::TyError {
                        seeded_pair
                    } else {
                        seeded_pair.0.check_contest_expr_expected(*left_expr, seeded_pair.1)
                    }
                } else if (*left_expr).kind == ExprKind::ExprCall && call_expr_is_builtin_lift_knowledge((*left_expr).left) {
                    let seeded_pair =
                        if seeded_expected_ty.kind == TypeKind::TyContest { (seeded_checker, seeded_expected_ty) }
                        else { self.contest_type_seeded_from_audit(audit_info, audit_id, e.span) }
                    if seeded_pair.1.kind == TypeKind::TyError {
                        seeded_pair
                    } else {
                        seeded_pair.0.check_lift_knowledge_expr_expected(*left_expr, seeded_pair.1)
                    }
                } else {
                    seeded_checker.check_expr(*left_expr)
                }
            }
            None => (seeded_checker.report_error_at(e.span, 86, 0, 0, 0), ty_error())
        }

        var c = contest_pair.0
        let contest_ty = contest_pair.1
        if contest_ty.kind != TypeKind::TyContest {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }
        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }

        let contest_info = c.contests.get(contest_ty.epistemic_meta_id)
        if contest_info.family_id < 0 || contest_info.policy_id < 0 {
            return (c.report_audit_attachment_requires_contest(e.span, e.name, contest_ty), ty_error())
        }
        if !contest_matches_audit_target(contest_ty, contest_info, audit_info) {
            return (c.report_audit_target_mismatch(e.span, e.name, audit_info, knowledge_inner(contest_ty), contest_info), ty_error())
        }

        var merged = contest_info_apply_audit(contest_info, audit_info, audit_id)
        merged = contest_info_attach_span(merged, e.span)
        c.contests.entries[contest_ty.epistemic_meta_id as usize] = merged
        (c, ty_contest(knowledge_inner(contest_ty), contest_ty.epistemic_meta_id))
    }

    fn check_prove_robust_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)

        let policy_pair = self.check_opt_expr(second_arg)
        var c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyPolicy {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.policies.count {
            c = c.report_policy_requires_named_definition(e.span)
            return (c, ty_error())
        }

        let policy_info = c.policies.get(policy_ty.epistemic_meta_id)
        if policy_info.level_id < 0 || policy_info.scope_id < 0 {
            c = c.report_policy_missing_robustness_metadata(e.span, policy_info.name)
            return (c, ty_error())
        }

        let contest_inner = knowledge_inner(policy_ty)
        let contest_pair = match first_arg {
            Some(arg) => c.check_expr(*arg)
            None => (c.report_error_at(e.span, 58, 0, 0, 0), ty_error())
        }
        c = contest_pair.0
        let contest_ty = contest_pair.1

        if contest_ty.kind != TypeKind::TyContest {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if !types_compatible(knowledge_inner(contest_ty), contest_inner) {
            c = c.report_error_at(e.span, 58, 0, 0, 0)
            return (c, ty_error())
        }

        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            c = c.report_missing_model_family_metadata(e.span)
            return (c, ty_error())
        }

        let contest_info = c.contests.get(contest_ty.epistemic_meta_id)
        if contest_info.family_id < 0 {
            c = c.report_missing_model_family_metadata(e.span)
            return (c, ty_error())
        }
        if contest_info.policy_id >= 0 && contest_info.policy_id != policy_ty.epistemic_meta_id {
            c = c.report_contest_policy_mismatch(e.span, contest_info.policy_id, policy_ty.epistemic_meta_id)
            return (c, ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = check_policy_requirements_against_contest(
                c,
                e.span,
                policy_info.name,
                policy_info.requirements,
                contest_ty.epistemic_meta_id
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let proof_info = robust_proof_info_from_contest(contest_ty.epistemic_meta_id, contest_info, policy_info, e.span)
        let add_result = c.robust_proofs.add(proof_info)
        c.robust_proofs = add_result.0
        (c, ty_robust(contest_inner, add_result.1, policy_info.level_id, policy_info.scope_id))
    }

    // validate_manifest(robust: Robust<T>) -> Validated<T>
    // Terminal epistemic chain step: a Robust<T> that has been manifestly validated
    // becomes Validated<T>. Policy satisfaction was proven at check time; this call
    // serves as the explicit compile-time gate that produces the Validated<T> token.
    fn check_validate_manifest_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let second_arg = expr_list_second(e.args)
        let robust_pair = self.check_opt_expr(first_arg)
        var c = robust_pair.0
        let robust_ty = robust_pair.1
        if robust_ty.kind != TypeKind::TyRobust {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let validation_pair = c.check_opt_expr(second_arg)
        c = validation_pair.0
        let validation_ty = validation_pair.1
        if validation_ty.kind != TypeKind::TyValidation {
            c = c.report_missing_validation_policy(e.span)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(robust_ty)
        if !types_compatible(inner_ty, knowledge_inner(validation_ty)) {
            c = c.report_validation_target_mismatch(e.span, knowledge_inner(validation_ty), inner_ty)
            return (c, ty_error())
        }
        if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= c.robust_proofs.count {
            c = c.report_missing_robust_proof(e.span)
            return (c, ty_error())
        }
        let proof_info = c.robust_proofs.get(robust_ty.epistemic_meta_id)
        let manifest_info = ValidatedManifestInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            audit_id: proof_info.audit_id,
            robust_proof_id: robust_ty.epistemic_meta_id,
            validation_id: validation_ty.epistemic_meta_id,
            inner_ty: inner_ty,
        }
        let add_result = c.validated_manifests.add(manifest_info)
        c.validated_manifests = add_result.0
        (c, ty_validated_with_policy(inner_ty, 0.0 - 1.0, add_result.1))
    }

    fn check_decision_policy_requirements_against_proof(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        proof_info: RobustProofInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || req.metric_id >= 8 || proof_info.metric_known[req.metric_id as usize] != 1 {
                    let c = self.report_missing_decision_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = proof_info.metric_values[req.metric_id as usize]
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_decision_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_decision_policy_requirements_against_proof(span, policy_name, (*list).tail, proof_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn deferral_reason_code_from_metric_id(self, metric_id: i64) -> i64 {
        if metric_id == CONTEST_METRIC_SIGN_CONSENSUS || metric_id == CONTEST_METRIC_RELATIVE_BAND {
            return DEFERRAL_REASON_STRUCTURAL_DISAGREEMENT
        }
        if metric_id == CONTEST_METRIC_MECHANISTIC_DIVERGENCE {
            return DEFERRAL_REASON_MECHANISTIC_CONFLICT
        }
        if metric_id == CONTEST_METRIC_MAX_TAIL_RISK {
            return DEFERRAL_REASON_TAIL_RISK
        }
        if metric_id == CONTEST_METRIC_IDENTIFIABILITY_FLOOR {
            return DEFERRAL_REASON_IDENTIFIABILITY_GAP
        }
        DEFERRAL_REASON_POLICY_INCOMPLETE
    }

    fn deferral_reason_code_from_requirements(self, opt: Option<Box<PolicyRequirementInfoList>>) -> i64 with Mut, Panic, Div {
        match opt {
            Some(list) => self.deferral_reason_code_from_metric_id((*list).head.metric_id)
            None => DEFERRAL_REASON_POLICY_INCOMPLETE
        }
    }

    fn check_deferral_policy_requirements_against_contest(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        contest_info: ContestInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = contest_info_get_metric(contest_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_deferral_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_deferral_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_deferral_policy_requirements_against_contest(span, policy_name, (*list).tail, contest_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_deferral_policy_requirements_against_proof(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        proof_info: RobustProofInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                if req.metric_id < 0 || req.metric_id >= 8 || proof_info.metric_known[req.metric_id as usize] != 1 {
                    let c = self.report_missing_deferral_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = proof_info.metric_values[req.metric_id as usize]
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_deferral_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_deferral_policy_requirements_against_proof(span, policy_name, (*list).tail, proof_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_acquisition_policy_requirements_against_deferred(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        cert_info: DeferredCertificateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = deferred_certificate_get_metric(cert_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_acquisition_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_acquisition_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_acquisition_policy_requirements_against_deferred(span, policy_name, (*list).tail, cert_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn check_recourse_policy_requirements_against_deferred(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        cert_info: DeferredCertificateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = deferred_certificate_get_metric(cert_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_recourse_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_recourse_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_recourse_policy_requirements_against_deferred(span, policy_name, (*list).tail, cert_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn deferred_reason_witness_info_new(self, span: Span, certificate_id: i64) -> DeferredReasonWitnessInfo {
        DeferredReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            deferred_certificate_id: certificate_id,
        }
    }

    fn acquisition_reason_witness_info_new(self, span: Span, plan_id: i64) -> AcquisitionReasonWitnessInfo {
        AcquisitionReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            acquisition_plan_id: plan_id,
        }
    }

    fn recourse_reason_witness_info_new(self, span: Span, plan_id: i64) -> RecourseReasonWitnessInfo {
        RecourseReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            recourse_plan_id: plan_id,
        }
    }

    fn transition_reason_witness_info_new(self, span: Span, plan_id: i64) -> TransitionReasonWitnessInfo {
        TransitionReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            transition_plan_id: plan_id,
        }
    }

    fn alternative_reason_witness_info_new(self, span: Span, candidate_id: i64) -> AlternativeReasonWitnessInfo {
        AlternativeReasonWitnessInfo {
            span_start: span.start,
            span_end: span.end,
            candidate_id: candidate_id,
        }
    }

    fn alternative_frontier_name_from_expr(self, opt: Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match opt {
            Some(inner) => contest_model_name(*inner)
            None => empty_name()
        }
    }

    fn transition_protocol_name_from_expr(self, opt: Option<Box<Expr>>) -> Name with Mut, Panic, Div, Alloc {
        match opt {
            Some(inner) => contest_model_name(*inner)
            None => empty_name()
        }
    }

    fn alternative_metric_name(metric_id: i64) -> Name with Mut, Panic, Div {
        if metric_id == ALTERNATIVE_METRIC_INTERVENTION_COST {
            make_name("intervention_cost")
        } else if metric_id == ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK {
            make_name("residual_tail_risk")
        } else if metric_id == ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE {
            make_name("mechanistic_divergence")
        } else if metric_id == ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN {
            make_name("admissibility_margin")
        } else {
            make_name("unknown_metric")
        }
    }

    fn transition_metric_is_candidate(metric_id: i64) -> bool {
        metric_id == TRANSITION_METRIC_INTERVENTION_COST
        || metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK
        || metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE
        || metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN
    }

    fn transition_metric_to_candidate_metric(metric_id: i64) -> i64 {
        if metric_id == TRANSITION_METRIC_INTERVENTION_COST {
            ALTERNATIVE_METRIC_INTERVENTION_COST
        } else if metric_id == TRANSITION_METRIC_RESIDUAL_TAIL_RISK {
            ALTERNATIVE_METRIC_RESIDUAL_TAIL_RISK
        } else if metric_id == TRANSITION_METRIC_MECHANISTIC_DIVERGENCE {
            ALTERNATIVE_METRIC_MECHANISTIC_DIVERGENCE
        } else if metric_id == TRANSITION_METRIC_ADMISSIBILITY_MARGIN {
            ALTERNATIVE_METRIC_ADMISSIBILITY_MARGIN
        } else {
            -1
        }
    }

    fn transition_candidate_metric_pair(self, candidate: AlternativeCandidateInfo, metric_id: i64) -> (bool, f64) with Mut, Panic, Div {
        if self.transition_metric_is_candidate(metric_id) {
            let alt_metric_id = self.transition_metric_to_candidate_metric(metric_id)
            if alt_metric_id >= 0 && alt_metric_id < 8 && candidate.metric_known[alt_metric_id as usize] == 1 {
                return (true, candidate.metric_values[alt_metric_id as usize])
            }
            return (false, 0.0)
        }

        if candidate.source_kind == ALTERNATIVE_SOURCE_DEFERRED {
            if candidate.deferred_certificate_id >= 0 && candidate.deferred_certificate_id < self.deferred_certificates.count {
                return deferred_certificate_get_metric(self.deferred_certificates.get(candidate.deferred_certificate_id), metric_id)
            }
            return (false, 0.0)
        }

        if candidate.source_kind == ALTERNATIVE_SOURCE_RECOURSE_PLAN {
            if candidate.source_plan_id >= 0 && candidate.source_plan_id < self.recourse_plans.count {
                let plan_info = self.recourse_plans.get(candidate.source_plan_id)
                if metric_id >= 0 && metric_id < 8 && plan_info.metric_known[metric_id as usize] == 1 {
                    return (true, plan_info.metric_values[metric_id as usize])
                }
            }
            return (false, 0.0)
        }

        (false, 0.0)
    }

    fn transition_plan_metric_pair(self, plan: TransitionPlanInfo, metric_id: i64) -> (bool, f64) with Mut, Panic, Div {
        if self.transition_metric_is_candidate(metric_id) {
            let alt_metric_id = self.transition_metric_to_candidate_metric(metric_id)
            if alt_metric_id >= 0 && alt_metric_id < 8 && plan.metric_known[alt_metric_id as usize] == 1 {
                return (true, plan.metric_values[alt_metric_id as usize])
            }
        }

        if plan.alternative_option_id >= 0 && plan.alternative_option_id < self.alternative_candidates.count {
            return self.transition_candidate_metric_pair(self.alternative_candidates.get(plan.alternative_option_id), metric_id)
        }

        if plan.contest_id >= 0 && plan.contest_id < self.contests.count {
            return contest_info_get_metric(self.contests.get(plan.contest_id), metric_id)
        }

        (false, 0.0)
    }

    fn transition_expr_value_repr(self, e: Expr) -> Name with Mut, Panic, Div, Alloc {
        if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
            return contest_model_name(e)
        }
        if e.kind == ExprKind::ExprIntLit || e.kind == ExprKind::ExprFloatLit {
            return make_name("literal")
        }
        make_name("transition_value")
    }

    fn transition_expr_value_matches_candidate(self, step_expr: Expr, candidate_expr: Expr) -> bool with Mut, Panic, Div, Alloc {
        if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprIntLit {
            return step_expr.int_val == candidate_expr.int_val
        }
        if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprFloatLit {
            return step_expr.float_val == candidate_expr.float_val
        }
        if step_expr.kind == ExprKind::ExprIntLit && candidate_expr.kind == ExprKind::ExprFloatLit {
            return (step_expr.int_val as f64) == candidate_expr.float_val
        }
        if step_expr.kind == ExprKind::ExprFloatLit && candidate_expr.kind == ExprKind::ExprIntLit {
            return step_expr.float_val == (candidate_expr.int_val as f64)
        }
        if (step_expr.kind == ExprKind::ExprIdent || step_expr.kind == ExprKind::ExprPath)
            && (candidate_expr.kind == ExprKind::ExprIdent || candidate_expr.kind == ExprKind::ExprPath) {
            return name_eq(contest_model_name(step_expr), contest_model_name(candidate_expr))
        }
        false
    }

    fn check_transition_requirements_against_candidate(
        self,
        span: Span,
        owner_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        candidate: AlternativeCandidateInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = self.transition_candidate_metric_pair(candidate, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_transition_requirement_unavailable(span, owner_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_transition_requirement_unavailable(span, owner_name, req)
                        (c, false)
                    } else {
                        self.check_transition_requirements_against_candidate(span, owner_name, (*list).tail, candidate)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn alternative_expr_value_repr(self, e: Expr) -> Name with Mut, Panic, Div, Alloc {
        if e.kind == ExprKind::ExprIdent || e.kind == ExprKind::ExprPath {
            return contest_model_name(e)
        }
        if e.kind == ExprKind::ExprIntLit || e.kind == ExprKind::ExprFloatLit {
            return make_name("literal")
        }
        make_name("value")
    }

    fn alternative_candidate_metric_known(self, info: AlternativeCandidateInfo, metric_id: i64) -> bool with Mut, Panic, Div {
        metric_id >= 0 && metric_id < 8 && info.metric_known[metric_id as usize] == 1
    }

    fn alternative_candidate_metric_value(self, info: AlternativeCandidateInfo, metric_id: i64) -> f64 with Mut, Panic, Div {
        if metric_id >= 0 && metric_id < 8 {
            info.metric_values[metric_id as usize]
        } else {
            0.0
        }
    }

    fn alternative_candidate_metrics_complete(self, info: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> (bool, i64) with Mut, Panic, Div {
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            if !self.alternative_candidate_metric_known(info, metric_id) {
                return (false, metric_id)
            }
            i = i + 1
        }
        (true, -1)
    }

    fn alternative_candidate_no_worse(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, metric_id: i64, direction: i64) -> bool with Mut, Panic, Div {
        let l = self.alternative_candidate_metric_value(lhs, metric_id)
        let r = self.alternative_candidate_metric_value(rhs, metric_id)
        if direction == 1 { r >= l } else { r <= l }
    }

    fn alternative_candidate_strictly_better(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, metric_id: i64, direction: i64) -> bool with Mut, Panic, Div {
        let l = self.alternative_candidate_metric_value(lhs, metric_id)
        let r = self.alternative_candidate_metric_value(rhs, metric_id)
        if direction == 1 { r > l } else { r < l }
    }

    fn alternative_candidate_is_duplicate(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> bool with Mut, Panic, Div {
        if !name_eq(lhs.value_repr, rhs.value_repr) {
            return false
        }
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            if self.alternative_candidate_metric_value(lhs, metric_id) != self.alternative_candidate_metric_value(rhs, metric_id) {
                return false
            }
            i = i + 1
        }
        true
    }

    fn alternative_candidate_is_dominated(self, lhs: AlternativeCandidateInfo, rhs: AlternativeCandidateInfo, policy_info: AlternativePolicyInfo) -> bool with Mut, Panic, Div {
        var all_no_worse = true
        var any_better = false
        var i: i64 = 0
        while i < policy_info.objective_count && i < 8 {
            let metric_id = policy_info.objective_metric_ids[i as usize]
            let direction = policy_info.objective_directions[i as usize]
            if !self.alternative_candidate_no_worse(lhs, rhs, metric_id, direction) {
                all_no_worse = false
            }
            if self.alternative_candidate_strictly_better(lhs, rhs, metric_id, direction) {
                any_better = true
            }
            i = i + 1
        }
        all_no_worse && any_better
    }

    fn alternative_candidate_attach_realized(
        self,
        info: AlternativeCandidateInfo,
        frontier_id: i64,
        source_kind: i64,
        deferred_certificate_id: i64,
        source_policy_id: i64,
        source_plan_id: i64,
        strategy_name: Name,
        route_name: Name,
        audit_id: i64,
        contest_id: i64,
        value_repr: Name
    ) -> AlternativeCandidateInfo with Mut, Panic, Div {
        var next = info
        next.frontier_id = frontier_id
        next.source_kind = source_kind
        next.deferred_certificate_id = deferred_certificate_id
        next.source_policy_id = source_policy_id
        next.source_plan_id = source_plan_id
        next.strategy_name = strategy_name
        next.route_name = route_name
        next.audit_id = audit_id
        next.contest_id = contest_id
        next.value_repr = value_repr
        next.dominance_rank = 0
        next
    }

    fn contest_has_counterexample(self, contest_id: i64) -> bool with Mut, Panic, Div {
        if contest_id < 0 || contest_id >= self.contests.count {
            return false
        }
        let contest_info = self.contests.get(contest_id)
        if contest_info.counterexample_id >= 0 {
            return true
        }
        let metric_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_COUNTEREXAMPLE_PRESENT)
        metric_pair.0 && metric_pair.1 > 0.0
    }

    fn deferred_certificate_attach_resolution_metrics(self, cert: DeferredCertificateInfo) -> DeferredCertificateInfo with Mut, Panic, Div {
        var next = cert
        if next.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] != 1
        && self.contest_has_counterexample(next.contest_id) {
            next.metric_known[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1
            next.metric_values[CONTEST_METRIC_COUNTEREXAMPLE_PRESENT as usize] = 1.0
        }
        next.metric_known[CONTEST_METRIC_DEFERRED_REASON as usize] = 1
        next.metric_values[CONTEST_METRIC_DEFERRED_REASON as usize] = next.reason_code as f64
        next
    }

    fn check_admit_action_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let robust_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let robust_pair = c.check_opt_expr(robust_arg)
        c = robust_pair.0
        let robust_ty = robust_pair.1
        if robust_ty.kind != TypeKind::TyRobust {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }
        if robust_ty.robustness_level_id < 0 || robust_ty.robustness_scope_id < 0 {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }
        if robust_ty.epistemic_meta_id < 0 || robust_ty.epistemic_meta_id >= c.robust_proofs.count {
            return (c.report_missing_admissibility_proof(e.span), ty_error())
        }

        let decision_pair = c.check_opt_expr(policy_arg)
        c = decision_pair.0
        let decision_ty = decision_pair.1
        if decision_ty.kind != TypeKind::TyDecisionPolicy {
            return (c.report_missing_decision_policy(e.span), ty_error())
        }
        if decision_ty.epistemic_meta_id < 0 || decision_ty.epistemic_meta_id >= c.decision_policies.count {
            return (c.report_missing_decision_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(robust_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_decision_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.decision_policies.get(decision_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_decision_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let proof_info = c.robust_proofs.get(robust_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_decision_policy_requirements_against_proof(
                e.span,
                policy_info.name,
                policy_info.requirements,
                proof_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let cert_info = DecisionCertificateInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            audit_id: proof_info.audit_id,
            robust_proof_id: robust_ty.epistemic_meta_id,
            decision_policy_id: decision_ty.epistemic_meta_id,
            inner_ty: inner_ty,
            metric_known: proof_info.metric_known,
            metric_values: proof_info.metric_values,
        }
        let add_result = c.decision_certificates.add(cert_info)
        c.decision_certificates = add_result.0
        (c, ty_admissible(inner_ty, add_result.1))
    }

    fn check_defer_action_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let evidence_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let evidence_pair = c.check_opt_expr(evidence_arg)
        c = evidence_pair.0
        let evidence_ty = evidence_pair.1

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyDeferralPolicy {
            return (c.report_missing_deferral_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.deferral_policies.count {
            return (c.report_missing_deferral_policy(e.span), ty_error())
        }
        let policy_info = c.deferral_policies.get(policy_ty.epistemic_meta_id)

        if evidence_ty.kind == TypeKind::TyContest {
            let inner_ty = knowledge_inner(evidence_ty)
            if !types_compatible(inner_ty, value_ty) {
                return (c.report_deferral_target_mismatch(e.span, inner_ty, value_ty), ty_error())
            }
            if !types_compatible(policy_info.target_ty, inner_ty) {
                return (c.report_deferral_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
            }
            if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= c.contests.count {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            let contest_info = c.contests.get(evidence_ty.epistemic_meta_id)
            if contest_info.family_id < 0 || contest_info.policy_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if policy_info.requirement_count > 0 {
                let req_pair = c.check_deferral_policy_requirements_against_contest(
                    e.span,
                    policy_info.name,
                    policy_info.requirements,
                    contest_info
                )
                c = req_pair.0
                if !req_pair.1 {
                    return (c, ty_error())
                }
            }
            var cert_info = DeferredCertificateInfo {
                span_start: e.span.start,
                span_end: e.span.end,
                audit_id: contest_info.audit_id,
                contest_id: evidence_ty.epistemic_meta_id,
                robust_proof_id: -1,
                deferral_policy_id: policy_ty.epistemic_meta_id,
                evidence_kind: DEFERRAL_EVIDENCE_CONTEST,
                reason_code: c.deferral_reason_code_from_requirements(policy_info.requirements),
                inner_ty: inner_ty,
                metric_known: contest_info.metric_known,
                metric_values: contest_info.metric_values,
            }
            cert_info = c.deferred_certificate_attach_resolution_metrics(cert_info)
            let add_result = c.deferred_certificates.add(cert_info)
            c.deferred_certificates = add_result.0
            return (c, ty_deferred(inner_ty, add_result.1))
        }

        if evidence_ty.kind == TypeKind::TyRobust {
            let inner_ty = knowledge_inner(evidence_ty)
            if !types_compatible(inner_ty, value_ty) {
                return (c.report_deferral_target_mismatch(e.span, inner_ty, value_ty), ty_error())
            }
            if !types_compatible(policy_info.target_ty, inner_ty) {
                return (c.report_deferral_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
            }
            if evidence_ty.robustness_level_id < 0 || evidence_ty.robustness_scope_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if evidence_ty.epistemic_meta_id < 0 || evidence_ty.epistemic_meta_id >= c.robust_proofs.count {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            let proof_info = c.robust_proofs.get(evidence_ty.epistemic_meta_id)
            if proof_info.contest_id < 0 {
                return (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
            }
            if policy_info.requirement_count > 0 {
                let req_pair = c.check_deferral_policy_requirements_against_proof(
                    e.span,
                    policy_info.name,
                    policy_info.requirements,
                    proof_info
                )
                c = req_pair.0
                if !req_pair.1 {
                    return (c, ty_error())
                }
            }
            var cert_info = DeferredCertificateInfo {
                span_start: e.span.start,
                span_end: e.span.end,
                audit_id: proof_info.audit_id,
                contest_id: proof_info.contest_id,
                robust_proof_id: evidence_ty.epistemic_meta_id,
                deferral_policy_id: policy_ty.epistemic_meta_id,
                evidence_kind: DEFERRAL_EVIDENCE_ROBUST,
                reason_code: c.deferral_reason_code_from_requirements(policy_info.requirements),
                inner_ty: inner_ty,
                metric_known: proof_info.metric_known,
                metric_values: proof_info.metric_values,
            }
            cert_info = c.deferred_certificate_attach_resolution_metrics(cert_info)
            let add_result = c.deferred_certificates.add(cert_info)
            c.deferred_certificates = add_result.0
            return (c, ty_deferred(inner_ty, add_result.1))
        }

        (c.report_missing_deferral_evidence(e.span, evidence_ty), ty_error())
    }

    fn check_deferral_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let deferred_pair = self.check_opt_expr(first_arg)
        var c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_deferral_reason_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }
        let add_result = c.deferred_reason_witnesses.add(c.deferred_reason_witness_info_new(e.span, deferred_ty.epistemic_meta_id))
        c.deferred_reason_witnesses = add_result.0
        (c, ty_named(deferral_reason_type_name()))
    }

    fn check_plan_acquisition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let deferred_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let deferred_pair = c.check_opt_expr(deferred_arg)
        c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_plan_acquisition_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyAcquisitionPolicy {
            return (c.report_missing_acquisition_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.acquisition_policies.count {
            return (c.report_missing_acquisition_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(deferred_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_acquisition_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.acquisition_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_acquisition_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let cert_info = c.deferred_certificates.get(deferred_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_acquisition_policy_requirements_against_deferred(
                e.span,
                policy_info.name,
                policy_info.requirements,
                cert_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let plan_info = AcquisitionPlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            deferred_certificate_id: deferred_ty.epistemic_meta_id,
            acquisition_policy_id: policy_ty.epistemic_meta_id,
            audit_id: cert_info.audit_id,
            contest_id: cert_info.contest_id,
            objective_name: policy_info.objective_name,
            route_name: policy_info.route_name,
            inner_ty: inner_ty,
            metric_known: cert_info.metric_known,
            metric_values: cert_info.metric_values,
        }
        let add_result = c.acquisition_plans.add(plan_info)
        c.acquisition_plans = add_result.0
        (c, ty_acquisition_plan(inner_ty, add_result.1))
    }

    fn check_acquisition_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyAcquisitionPlan {
            return (c.report_acquisition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        if plan_ty.epistemic_meta_id < 0 || plan_ty.epistemic_meta_id >= c.acquisition_plans.count {
            return (c.report_acquisition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.acquisition_reason_witnesses.add(c.acquisition_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.acquisition_reason_witnesses = add_result.0
        (c, ty_named(acquisition_reason_type_name()))
    }

    fn check_plan_recourse_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let deferred_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let deferred_pair = c.check_opt_expr(deferred_arg)
        c = deferred_pair.0
        let deferred_ty = deferred_pair.1
        if deferred_ty.kind != TypeKind::TyDeferred {
            return (c.report_plan_recourse_requires_deferred(e.span, deferred_ty), ty_error())
        }
        if deferred_ty.epistemic_meta_id < 0 || deferred_ty.epistemic_meta_id >= c.deferred_certificates.count {
            return (c.report_missing_deferred_certificate(e.span), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        if policy_ty.kind != TypeKind::TyRecoursePolicy {
            return (c.report_missing_recourse_policy(e.span), ty_error())
        }
        if policy_ty.epistemic_meta_id < 0 || policy_ty.epistemic_meta_id >= c.recourse_policies.count {
            return (c.report_missing_recourse_policy(e.span), ty_error())
        }

        let inner_ty = knowledge_inner(deferred_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_recourse_target_mismatch(e.span, inner_ty, value_ty), ty_error())
        }

        let policy_info = c.recourse_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_recourse_target_mismatch(e.span, policy_info.target_ty, inner_ty), ty_error())
        }

        let cert_info = c.deferred_certificates.get(deferred_ty.epistemic_meta_id)
        if policy_info.requirement_count > 0 {
            let req_pair = c.check_recourse_policy_requirements_against_deferred(
                e.span,
                policy_info.name,
                policy_info.requirements,
                cert_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let plan_info = RecoursePlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            deferred_certificate_id: deferred_ty.epistemic_meta_id,
            recourse_policy_id: policy_ty.epistemic_meta_id,
            audit_id: cert_info.audit_id,
            contest_id: cert_info.contest_id,
            strategy_name: policy_info.strategy_name,
            route_name: policy_info.route_name,
            inner_ty: inner_ty,
            metric_known: cert_info.metric_known,
            metric_values: cert_info.metric_values,
        }
        let add_result = c.recourse_plans.add(plan_info)
        c.recourse_plans = add_result.0
        (c, ty_recourse_plan(inner_ty, add_result.1))
    }

    fn check_recourse_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyRecoursePlan {
            return (c.report_recourse_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        if plan_ty.epistemic_meta_id < 0 || plan_ty.epistemic_meta_id >= c.recourse_plans.count {
            return (c.report_recourse_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.recourse_reason_witnesses.add(c.recourse_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.recourse_reason_witnesses = add_result.0
        (c, ty_named(recourse_reason_type_name()))
    }

    fn check_propose_alternatives_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let evidence_arg = expr_list_second(e.args)
        let frontier_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let evidence_pair = c.check_opt_expr(evidence_arg)
        c = evidence_pair.0
        let evidence_ty = evidence_pair.1

        var source_kind: i64 = -1
        var inner_ty = ty_error()
        var deferred_certificate_id: i64 = -1
        var recourse_plan_id: i64 = -1
        var audit_id: i64 = -1
        var contest_id: i64 = -1
        var strategy_name = empty_name()
        var route_name = empty_name()
        var recourse_policy_id: i64 = -1
        var cert_info = empty_deferred_certificate_info()

        if evidence_ty.kind == TypeKind::TyDeferred {
            source_kind = ALTERNATIVE_SOURCE_DEFERRED
            inner_ty = knowledge_inner(evidence_ty)
            deferred_certificate_id = evidence_ty.epistemic_meta_id
            if deferred_certificate_id < 0 || deferred_certificate_id >= c.deferred_certificates.count {
                return (c.report_alternative_requires_metadata(e.span, self.alternative_frontier_name_from_expr(frontier_arg)), ty_error())
            }
            cert_info = c.deferred_certificates.get(deferred_certificate_id)
            audit_id = cert_info.audit_id
            contest_id = cert_info.contest_id
        } else if evidence_ty.kind == TypeKind::TyRecoursePlan {
            source_kind = ALTERNATIVE_SOURCE_RECOURSE_PLAN
            inner_ty = knowledge_inner(evidence_ty)
            recourse_plan_id = evidence_ty.epistemic_meta_id
            if recourse_plan_id < 0 || recourse_plan_id >= c.recourse_plans.count {
                return (c.report_alternative_requires_metadata(e.span, self.alternative_frontier_name_from_expr(frontier_arg)), ty_error())
            }
            let plan_info = c.recourse_plans.get(recourse_plan_id)
            audit_id = plan_info.audit_id
            contest_id = plan_info.contest_id
            strategy_name = plan_info.strategy_name
            route_name = plan_info.route_name
            recourse_policy_id = plan_info.recourse_policy_id
            if plan_info.deferred_certificate_id >= 0 && plan_info.deferred_certificate_id < c.deferred_certificates.count {
                cert_info = c.deferred_certificates.get(plan_info.deferred_certificate_id)
            }
        } else {
            return (c.report_propose_alternatives_requires_evidence(e.span, evidence_ty), ty_error())
        }

        if !types_compatible(inner_ty, value_ty) {
            return (c.report_mismatch(e.span, 1, inner_ty, value_ty), ty_error())
        }

        let frontier_name = c.alternative_frontier_name_from_expr(frontier_arg)
        let frontier_id = c.alternative_frontiers.find(frontier_name)
        if frontier_id < 0 || frontier_id >= c.alternative_frontiers.count {
            return (c.report_alternative_frontier_target_mismatch(e.span, frontier_name, evidence_ty), ty_error())
        }
        let frontier_info = c.alternative_frontiers.get(frontier_id)
        if frontier_info.target_kind != source_kind || !types_compatible(frontier_info.target_ty, evidence_ty) {
            return (c.report_alternative_frontier_target_mismatch(e.span, frontier_name, evidence_ty), ty_error())
        }
        if audit_id < 0 || contest_id < 0 {
            return (c.report_alternative_requires_metadata(e.span, frontier_name), ty_error())
        }
        if frontier_info.policy_id < 0 || frontier_info.policy_id >= c.alternative_policies.count {
            return (c.report_alternative_policy_target_mismatch(e.span, frontier_name), ty_error())
        }
        let policy_info = c.alternative_policies.get(frontier_info.policy_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_alternative_policy_target_mismatch(e.span, policy_info.name), ty_error())
        }

        if policy_info.max_options >= 0 && frontier_info.candidate_count > policy_info.max_options {
            return (c.report_alternative_candidate_dominated_or_duplicate(e.span, frontier_name), ty_error())
        }

        var realized_candidate_ids: [i64; 16] = [-1; 16]
        var realized_count: i64 = 0
        var idx: i64 = frontier_info.candidate_count - 1
        while idx >= 0 {
            let candidate_id = frontier_info.candidate_ids[idx as usize]
            if candidate_id >= 0 && candidate_id < c.alternative_candidates.count {
                let template = c.alternative_candidates.get(candidate_id)
                let complete_pair = c.alternative_candidate_metrics_complete(template, policy_info)
                if !complete_pair.0 {
                    return (c.report_alternative_candidate_metrics_incomplete(e.span, template.name, c.alternative_metric_name(complete_pair.1)), ty_error())
                }

                let value_check = c.check_expr(template.value_expr)
                c = value_check.0
                let candidate_value_ty = value_check.1
                if !types_compatible(inner_ty, candidate_value_ty) {
                    return (c.report_alternative_candidate_value_mismatch(e.span, template.name, inner_ty, candidate_value_ty), ty_error())
                }

                var realized = template
                if source_kind == ALTERNATIVE_SOURCE_DEFERRED {
                    if !template.uses_via {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, empty_name()), ty_error())
                    }
                    let via_policy_id = c.recourse_policies.find(template.via_recourse_policy_name)
                    if via_policy_id < 0 || via_policy_id >= c.recourse_policies.count {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    let via_policy = c.recourse_policies.get(via_policy_id)
                    if !types_compatible(via_policy.target_ty, inner_ty) {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    if via_policy.requirement_count > 0 {
                        let req_pair = c.check_recourse_policy_requirements_against_deferred(e.span, via_policy.name, via_policy.requirements, cert_info)
                        c = req_pair.0
                        if !req_pair.1 {
                            return (c, ty_error())
                        }
                    }
                    realized = c.alternative_candidate_attach_realized(
                        template,
                        frontier_id,
                        ALTERNATIVE_SOURCE_DEFERRED,
                        deferred_certificate_id,
                        via_policy_id,
                        -1,
                        via_policy.strategy_name,
                        via_policy.route_name,
                        audit_id,
                        contest_id,
                        c.alternative_expr_value_repr(template.value_expr)
                    )
                } else {
                    if template.uses_via {
                        return (c.report_alternative_candidate_policy_mismatch(e.span, template.name, template.via_recourse_policy_name), ty_error())
                    }
                    realized = c.alternative_candidate_attach_realized(
                        template,
                        frontier_id,
                        ALTERNATIVE_SOURCE_RECOURSE_PLAN,
                        -1,
                        recourse_policy_id,
                        recourse_plan_id,
                        strategy_name,
                        route_name,
                        audit_id,
                        contest_id,
                        c.alternative_expr_value_repr(template.value_expr)
                    )
                }
                c.alternative_candidates.entries[candidate_id as usize] = realized
                realized_candidate_ids[realized_count as usize] = candidate_id
                realized_count = realized_count + 1
            }
            idx = idx - 1
        }

        var i: i64 = 0
        while i < realized_count {
            let lhs_id = realized_candidate_ids[i as usize]
            let lhs = c.alternative_candidates.get(lhs_id)
            var j: i64 = 0
            while j < realized_count {
                if i != j {
                    let rhs_id = realized_candidate_ids[j as usize]
                    let rhs = c.alternative_candidates.get(rhs_id)
                    if c.alternative_candidate_is_duplicate(lhs, rhs, policy_info) || c.alternative_candidate_is_dominated(lhs, rhs, policy_info) {
                        return (c.report_alternative_candidate_dominated_or_duplicate(e.span, lhs.name), ty_error())
                    }
                }
                j = j + 1
            }
            i = i + 1
        }

        let set_info = AlternativeSetInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            source_kind: source_kind,
            frontier_id: frontier_id,
            deferred_certificate_id: deferred_certificate_id,
            recourse_plan_id: recourse_plan_id,
            audit_id: audit_id,
            contest_id: contest_id,
            inner_ty: inner_ty,
            candidate_ids: realized_candidate_ids,
            candidate_count: realized_count,
        }
        let add_result = c.alternative_sets.add(set_info)
        c.alternative_sets = add_result.0
        (c, ty_alternative_set(inner_ty, add_result.1))
    }

    fn check_alternative_count_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let set_arg = expr_list_head(e.args)
        let set_pair = self.check_opt_expr(set_arg)
        var c = set_pair.0
        let set_ty = set_pair.1
        if set_ty.kind != TypeKind::TyAlternativeSet || set_ty.epistemic_meta_id < 0 || set_ty.epistemic_meta_id >= c.alternative_sets.count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        (c, ty_i64())
    }

    fn check_alternative_option_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let set_arg = expr_list_head(e.args)
        let idx_arg = expr_list_second(e.args)
        let set_pair = self.check_opt_expr(set_arg)
        var c = set_pair.0
        let set_ty = set_pair.1
        if set_ty.kind != TypeKind::TyAlternativeSet || set_ty.epistemic_meta_id < 0 || set_ty.epistemic_meta_id >= c.alternative_sets.count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let idx_pair = eval_const_int_opt_expr(c, idx_arg)
        if !idx_pair.0 {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let set_info = c.alternative_sets.get(set_ty.epistemic_meta_id)
        if idx_pair.1 < 0 || idx_pair.1 >= set_info.candidate_count {
            return (c.report_alternative_option_requires_set(e.span, set_ty), ty_error())
        }
        let candidate_id = set_info.candidate_ids[idx_pair.1 as usize]
        (c, ty_alternative_option(knowledge_inner(set_ty), candidate_id))
    }

    fn check_alternative_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let option_pair = self.check_opt_expr(first_arg)
        var c = option_pair.0
        let option_ty = option_pair.1
        if option_ty.kind != TypeKind::TyAlternativeOption
        || option_ty.epistemic_meta_id < 0
        || option_ty.epistemic_meta_id >= c.alternative_candidates.count {
            return (c.report_alternative_reason_requires_option(e.span, option_ty), ty_error())
        }
        let add_result = c.alternative_reason_witnesses.add(c.alternative_reason_witness_info_new(e.span, option_ty.epistemic_meta_id))
        c.alternative_reason_witnesses = add_result.0
        (c, ty_named(alternative_reason_type_name()))
    }

    fn check_commit_alternative_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let option_arg = expr_list_second(e.args)
        let protocol_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let option_pair = c.check_opt_expr(option_arg)
        c = option_pair.0
        let option_ty = option_pair.1
        if option_ty.kind != TypeKind::TyAlternativeOption
            || option_ty.epistemic_meta_id < 0
            || option_ty.epistemic_meta_id >= c.alternative_candidates.count {
            return (c.report_commit_alternative_requires_option(e.span, option_ty), ty_error())
        }
        let candidate_info = c.alternative_candidates.get(option_ty.epistemic_meta_id)
        let inner_ty = knowledge_inner(option_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_transition_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let protocol_name = c.transition_protocol_name_from_expr(protocol_arg)
        let protocol_id = c.transition_protocols.find(protocol_name)
        if protocol_id < 0 || protocol_id >= c.transition_protocols.count {
            return (c.report_transition_protocol_target_mismatch(e.span, protocol_name, option_ty), ty_error())
        }
        let protocol_info = c.transition_protocols.get(protocol_id)
        if !types_compatible(protocol_info.target_ty, option_ty) {
            return (c.report_transition_protocol_target_mismatch(e.span, protocol_name, option_ty), ty_error())
        }

        let policy_id = protocol_info.transition_policy_id
        if policy_id < 0 || policy_id >= c.transition_policies.count {
            return (c.report_transition_policy_target_mismatch(e.span, empty_name(), inner_ty, option_ty), ty_error())
        }
        let policy_info = c.transition_policies.get(policy_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_transition_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.max_steps >= 0 && protocol_info.step_count > policy_info.max_steps {
            return (c.report_transition_steps_exceed_max(e.span, protocol_info.name, policy_info.max_steps, protocol_info.step_count), ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = c.check_transition_requirements_against_candidate(e.span, policy_info.name, policy_info.requirements, candidate_info)
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        var final_step_expr = candidate_info.value_expr
        var final_step_repr = candidate_info.value_repr
        var i: i64 = 0
        while i < protocol_info.step_count && i < 16 {
            let step_id = protocol_info.step_ids[i as usize]
            if step_id >= 0 && step_id < c.transition_steps.count {
                let step_info = c.transition_steps.get(step_id)
                let step_value_pair = c.check_expr(step_info.value_expr)
                c = step_value_pair.0
                let step_value_ty = step_value_pair.1
                if !types_compatible(inner_ty, step_value_ty) {
                    return (c.report_transition_step_value_mismatch(e.span, step_info.name, inner_ty, step_value_ty), ty_error())
                }
                if step_info.requirement_count > 0 {
                    let req_pair = c.check_transition_requirements_against_candidate(e.span, step_info.name, step_info.requirements, candidate_info)
                    c = req_pair.0
                    if !req_pair.1 {
                        return (c, ty_error())
                    }
                }
                final_step_expr = step_info.value_expr
                final_step_repr = c.transition_expr_value_repr(step_info.value_expr)
            }
            i = i + 1
        }

        if protocol_info.step_count <= 0 || !c.transition_expr_value_matches_candidate(final_step_expr, candidate_info.value_expr) {
            return (c.report_transition_final_step_mismatch(e.span, protocol_info.name, candidate_info.name), ty_error())
        }

        let plan_info = TransitionPlanInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_policy_id: policy_id,
            transition_protocol_id: protocol_id,
            alternative_option_id: option_ty.epistemic_meta_id,
            audit_id: candidate_info.audit_id,
            contest_id: candidate_info.contest_id,
            route_name: policy_info.route_name,
            rollback_route_name: policy_info.rollback_route_name,
            step_count: protocol_info.step_count,
            final_value_repr: final_step_repr,
            inner_ty: inner_ty,
            metric_known: candidate_info.metric_known,
            metric_values: candidate_info.metric_values,
        }
        let add_result = c.transition_plans.add(plan_info)
        c.transition_plans = add_result.0
        (c, ty_transition_plan(inner_ty, add_result.1))
    }

    fn check_monitoring_policy_requirements_against_plan(
        self,
        span: Span,
        policy_name: Name,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> (Checker, bool) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let req = (*list).head
                let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                if !metric_pair.0 {
                    let c = self.report_missing_monitoring_diagnostic(span, policy_name, req)
                    (c, false)
                } else {
                    let observed = metric_pair.1
                    if !policy_requirement_holds(observed, req.op, req.threshold) {
                        let c = self.report_failed_monitoring_policy_requirement(span, policy_name, req, observed)
                        (c, false)
                    } else {
                        self.check_monitoring_policy_requirements_against_plan(span, policy_name, (*list).tail, plan_info)
                    }
                }
            }
            None => (self, true)
        }
    }

    fn monitoring_policy_has_violation_or_unavailable(
        self,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> bool with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if !metric_pair.0 {
                        return true
                    }
                    if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return true
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        false
    }

    fn monitoring_policy_reason_code_from_plan(
        self,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> i64 with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if !metric_pair.0 || !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return self.deferral_reason_code_from_metric_id(req.metric_id)
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        DEFERRAL_REASON_POLICY_INCOMPLETE
    }

    fn monitoring_policy_requirements_hold_silent(
        self,
        opt: Option<Box<PolicyRequirementInfoList>>,
        plan_info: TransitionPlanInfo
    ) -> bool with Mut, Panic, Div, Alloc {
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    let req = (*list).head
                    let metric_pair = self.transition_plan_metric_pair(plan_info, req.metric_id)
                    if !metric_pair.0 {
                        return false
                    }
                    if !policy_requirement_holds(metric_pair.1, req.op, req.threshold) {
                        return false
                    }
                    cur = (*list).tail
                }
                None => {
                    done = true
                }
            }
        }
        true
    }

    fn check_transition_reason_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_transition_reason_requires_plan(e.span, plan_ty), ty_error())
        }
        let add_result = c.transition_reason_witnesses.add(c.transition_reason_witness_info_new(e.span, plan_ty.epistemic_meta_id))
        c.transition_reason_witnesses = add_result.0
        (c, ty_named(transition_reason_type_name()))
    }

    fn check_transition_step_count_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let plan_pair = self.check_opt_expr(first_arg)
        var c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_transition_step_count_requires_plan(e.span, plan_ty), ty_error())
        }
        (c, ty_i64())
    }

    fn check_observe_transition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let plan_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let plan_pair = c.check_opt_expr(plan_arg)
        c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_observe_transition_requires_plan(e.span, plan_ty), ty_error())
        }

        let inner_ty = knowledge_inner(plan_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        let policy_name = c.transition_protocol_name_from_expr(policy_arg)
        if policy_ty.kind != TypeKind::TyMonitoringPolicy
            || policy_ty.epistemic_meta_id < 0
            || policy_ty.epistemic_meta_id >= c.monitoring_policies.count {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_name, inner_ty, policy_ty), ty_error())
        }

        let plan_info = c.transition_plans.get(plan_ty.epistemic_meta_id)
        let policy_info = c.monitoring_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.requirement_count > 0 {
            let req_pair = c.check_monitoring_policy_requirements_against_plan(
                e.span,
                policy_info.name,
                policy_info.requirements,
                plan_info
            )
            c = req_pair.0
            if !req_pair.1 {
                return (c, ty_error())
            }
        }

        let observed_info = ObservedTransitionInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_plan_id: plan_ty.epistemic_meta_id,
            monitoring_policy_id: policy_ty.epistemic_meta_id,
            audit_id: plan_info.audit_id,
            contest_id: plan_info.contest_id,
            route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
            rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
            inner_ty: inner_ty,
            metric_known: plan_info.metric_known,
            metric_values: plan_info.metric_values,
        }
        let add_result = c.observed_transitions.add(observed_info)
        c.observed_transitions = add_result.0
        (c, ty_observed_transition(inner_ty, add_result.1))
    }

    fn check_rollback_transition_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let value_arg = expr_list_head(e.args)
        let plan_arg = expr_list_second(e.args)
        let policy_arg = expr_list_third(e.args)

        let value_pair = self.check_opt_expr(value_arg)
        var c = value_pair.0
        let value_ty = value_pair.1

        let plan_pair = c.check_opt_expr(plan_arg)
        c = plan_pair.0
        let plan_ty = plan_pair.1
        if plan_ty.kind != TypeKind::TyTransitionPlan
            || plan_ty.epistemic_meta_id < 0
            || plan_ty.epistemic_meta_id >= c.transition_plans.count {
            return (c.report_rollback_transition_requires_plan(e.span, plan_ty), ty_error())
        }

        let inner_ty = knowledge_inner(plan_ty)
        if !types_compatible(inner_ty, value_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, empty_name(), inner_ty, value_ty), ty_error())
        }

        let policy_pair = c.check_opt_expr(policy_arg)
        c = policy_pair.0
        let policy_ty = policy_pair.1
        let policy_name = c.transition_protocol_name_from_expr(policy_arg)
        if policy_ty.kind != TypeKind::TyMonitoringPolicy
            || policy_ty.epistemic_meta_id < 0
            || policy_ty.epistemic_meta_id >= c.monitoring_policies.count {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_name, inner_ty, policy_ty), ty_error())
        }

        let plan_info = c.transition_plans.get(plan_ty.epistemic_meta_id)
        let policy_info = c.monitoring_policies.get(policy_ty.epistemic_meta_id)
        if !types_compatible(policy_info.target_ty, inner_ty) {
            return (c.report_monitoring_policy_target_mismatch(e.span, policy_info.name, policy_info.target_ty, inner_ty), ty_error())
        }

        if policy_info.requirement_count <= 0
        || c.monitoring_policy_requirements_hold_silent(policy_info.requirements, plan_info) {
            return (c.report_rollback_transition_requires_failure(e.span, policy_info.name), ty_error())
        }

        let rollback_info = RollbackCertificateInfo {
            span_start: e.span.start,
            span_end: e.span.end,
            transition_plan_id: plan_ty.epistemic_meta_id,
            monitoring_policy_id: policy_ty.epistemic_meta_id,
            audit_id: plan_info.audit_id,
            contest_id: plan_info.contest_id,
            route_name: if !name_is_empty(policy_info.route_name) { policy_info.route_name } else { plan_info.route_name },
            rollback_route_name: if !name_is_empty(policy_info.rollback_route_name) { policy_info.rollback_route_name } else { plan_info.rollback_route_name },
            reason_code: c.monitoring_policy_reason_code_from_plan(policy_info.requirements, plan_info),
            inner_ty: inner_ty,
            metric_known: plan_info.metric_known,
            metric_values: plan_info.metric_values,
        }
        let add_result = c.rollback_certificates.add(rollback_info)
        c.rollback_certificates = add_result.0
        (c, ty_rollback_certificate(inner_ty, add_result.1))
    }

    fn check_contest_witness_expr(self, e: Expr, witness_kind: i64) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let builtin_name = match e.left {
            Some(callee) => if (*callee).kind == ExprKind::ExprIdent { (*callee).name } else { empty_name() }
            None => empty_name()
        }
        let first_arg = expr_list_head(e.args)
        let contest_pair = self.check_opt_expr(first_arg)
        var c = contest_pair.0
        let contest_ty = contest_pair.1
        if contest_ty.kind != TypeKind::TyContest {
            c = c.report_contest_witness_requires_contest(e.span, builtin_name, contest_ty)
            return (c, ty_error())
        }
        if contest_ty.epistemic_meta_id < 0 || contest_ty.epistemic_meta_id >= c.contests.count {
            c = c.report_contest_witness_metadata_incomplete(e.span, builtin_name)
            return (c, ty_error())
        }
        let contest_id = contest_ty.epistemic_meta_id
        let contest_info = c.contests.get(contest_id)
        if contest_info.family_id < 0 || contest_info.policy_id < 0 {
            c = c.report_contest_witness_metadata_incomplete(e.span, builtin_name)
            return (c, ty_error())
        }

        if contest_witness_requires_metric(witness_kind) {
            let metric_id = contest_witness_metric_id(witness_kind)
            let metric_pair = contest_info_get_metric(contest_info, metric_id)
            if !metric_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, metric_id, contest_id)
                return (c, ty_error())
            }
        }

        if contest_witness_requires_mechanistic(witness_kind) {
            if contest_info.mechanistic_report_id < 0 || contest_info.mechanistic_report_id >= c.mechanistic_reports.count {
                c = c.report_mechanistic_report_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_DISAGREEMENT {
            let sign_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_SIGN_CONSENSUS)
            if !sign_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_SIGN_CONSENSUS, contest_id)
                return (c, ty_error())
            }
            let band_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_RELATIVE_BAND)
            if !band_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_RELATIVE_BAND, contest_id)
                return (c, ty_error())
            }
            let tail_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_MAX_TAIL_RISK)
            if !tail_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_MAX_TAIL_RISK, contest_id)
                return (c, ty_error())
            }
            let ident_pair = contest_info_get_metric(contest_info, CONTEST_METRIC_IDENTIFIABILITY_FLOOR)
            if !ident_pair.0 {
                c = c.report_contest_metric_unavailable(e.span, CONTEST_METRIC_IDENTIFIABILITY_FLOOR, contest_id)
                return (c, ty_error())
            }
            if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= c.counterexamples.count {
                c = c.report_counterexample_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
            if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= c.posterior_weights.count {
                c = c.report_posterior_weights_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_COUNTEREXAMPLE {
            if contest_info.counterexample_id < 0 || contest_info.counterexample_id >= c.counterexamples.count {
                c = c.report_counterexample_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        if witness_kind == CONTEST_WITNESS_POSTERIOR_WEIGHTS {
            if contest_info.posterior_weights_id < 0 || contest_info.posterior_weights_id >= c.posterior_weights.count {
                c = c.report_posterior_weights_unavailable(e.span, contest_id)
                return (c, ty_error())
            }
        }

        let add_result = c.contest_witnesses.add(contest_witness_info_new(e.span, witness_kind, contest_id))
        c.contest_witnesses = add_result.0
        (c, contest_witness_result_type(witness_kind))
    }

    fn check_lift_knowledge_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // lift_knowledge(k: Knowledge<T>) -> Contest<T>
        // Type-check first arg; must be Knowledge<T>; produce Contest<T>
        let first_arg = expr_list_head(e.args)
        let k_pair = self.check_opt_expr(first_arg)
        var c = k_pair.0
        let k_ty = k_pair.1
        if k_ty.kind != TypeKind::TyKnowledge {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(k_ty)
        (c, ty_contest(inner_ty, k_ty.epistemic_meta_id))
    }

    fn check_lift_knowledge_expr_expected(self, e: Expr, expected_contest_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let first_arg = expr_list_head(e.args)
        let k_pair = self.check_opt_expr(first_arg)
        var c = k_pair.0
        let k_ty = k_pair.1
        if k_ty.kind != TypeKind::TyKnowledge {
            c = c.report_error_at(e.span, 63, 0, 0, 0)
            return (c, ty_error())
        }
        let inner_ty = knowledge_inner(k_ty)
        let expected_inner = knowledge_inner(expected_contest_ty)
        if !types_compatible(inner_ty, expected_inner) {
            c = c.report_mismatch(e.span, 1, expected_inner, inner_ty)
            return (c, ty_error())
        }
        if expected_contest_ty.epistemic_meta_id >= 0 && expected_contest_ty.epistemic_meta_id < c.contests.count {
            var info = c.contests.get(expected_contest_ty.epistemic_meta_id)
            info = contest_info_attach_span(info, e.span)
            c.contests.entries[expected_contest_ty.epistemic_meta_id as usize] = info
            return (c, ty_contest(expected_inner, expected_contest_ty.epistemic_meta_id))
        }
        (c, expected_contest_ty)
    }

    fn check_measure_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // measure(v: T, uncertainty: f64) -> Knowledge<T>
        // Type-check first arg; T = type of value; result = Knowledge<T> with epsilon=-1 (unspecified)
        let first_arg = expr_list_head(e.args)
        let v_pair = self.check_opt_expr(first_arg)
        let c = v_pair.0
        let v_ty = v_pair.1
        (c, ty_knowledge(v_ty, 0.0 - 1.0))
    }

    fn borrow_state_and_shared_count(self, name: Name) -> (i64, i64) with Mut, Panic, Div, Alloc, IO {
        let idx = self.borrows.find(name)
        if idx >= 0 {
            let entry = self.borrows.entries[idx]
            (entry.state, entry.shared_count)
        } else {
            (0, 0)
        }
    }

    // Release borrows taken for function call arguments after the call returns.
    // Handles:
    //   1) implicit boundary borrows: f(x) where param is &T / &!T
    //   2) explicit unary borrows:   f(&x) / f(&!x)
    // Release only borrows introduced by this call expression; pre-existing
    // borrows must remain active even if a call-site borrow attempt fails.
    fn release_call_arg_borrows(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, call_start_borrows: BorrowEnv) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        match args {
            None => c
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                var implicit_release_kind: i64 = 0  // 0=none, 1=shared, 2=exclusive
                var next_params: Option<Box<FnParamList>> = None

                match params {
                    None => {}
                    Some(param_list) => {
                        let param = (*param_list).head
                        if param.ty.kind == TypeKind::TyRef {
                            implicit_release_kind = 1
                        } else if param.ty.kind == TypeKind::TyRefMut {
                            implicit_release_kind = 2
                        }
                        next_params = (*param_list).tail
                    }
                }

                if arg_expr.kind == ExprKind::ExprIdent && implicit_release_kind != 0 {
                    // Release borrows unconditionally after call returns.
                    // Previous logic used state delta (before_pair vs current_pair)
                    // which failed when consecutive calls borrow the same variable
                    // (the second call saw before_pair.0 == 2 from the first call's
                    // un-released borrow, and skipped the release).
                    if implicit_release_kind == 1 || implicit_release_kind == 2 {
                        c.borrows = c.borrows.release_borrow(arg_expr.name)
                    }
                }

                if arg_expr.kind == ExprKind::ExprUnary &&
                   (arg_expr.un_op == UnaryOp::OpRef || arg_expr.un_op == UnaryOp::OpRefMut) {
                    let borrow_name = unary_operand_name(arg_expr.left)
                    if !name_is_empty(borrow_name) {
                        // Unconditionally release call-site borrows after call returns
                        c.borrows = c.borrows.release_borrow(borrow_name)
                    }
                }

                c.release_call_arg_borrows((*arg_list).tail, next_params, call_start_borrows)
            }
        }
    }

    fn check_call_args(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c = c.check_call_args_inner(args, params, 0, expected_count, call_span)
        c
    }

    fn check_call_arg_borrow_boundary(self, arg_expr: Expr, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        if arg_expr.kind != ExprKind::ExprIdent {
            return self
        }
        var c = self
        if param_ty.kind == TypeKind::TyRef {
            let borrow_result = c.borrows.try_shared_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        } else if param_ty.kind == TypeKind::TyRefMut {
            let borrow_result = c.borrows.try_exclusive_borrow(arg_expr.name)
            c.borrows = borrow_result.0
            if borrow_result.1 != 0 {
                c = c.report_error_at(call_span, borrow_result.1, 0, 0, 0)
            }
        }
        c
    }

    fn check_call_arg_refinement_boundary(self, arg_expr: Expr, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if expected_ty.refinement_id < 0 || expected_ty.refinement_id >= 128 || is_error_or_unknown(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if is_error_or_unknown(provided_ty) {
            return self
        }

        let expected_ref = self.refinements.entries[expected_ty.refinement_id as usize]
        var c = self

        if arg_expr.kind == ExprKind::ExprIntLit {
            if !pred_check_int(expected_ref.predicate, arg_expr.int_val) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }
        if arg_expr.kind == ExprKind::ExprFloatLit {
            if !pred_check_float(expected_ref.predicate, arg_expr.float_val) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        if provided_ty.refinement_id >= 0 && provided_ty.refinement_id < 128 {
            let provided_ref = c.refinements.entries[provided_ty.refinement_id as usize]
            if !pred_implies(provided_ref.predicate, expected_ref.predicate) {
                c = c.report_error_at(call_span, 42, 0, 0, 0)
            }
            return c
        }

        // Try known-constant lookup for identifiers
        if arg_expr.kind == ExprKind::ExprIdent {
            let const_result = c.const_int_lookup(arg_expr.name)
            if const_result.0 {
                if !pred_check_int(expected_ref.predicate, const_result.1) {
                    return c.report_error_at(call_span, 42, 0, 0, 0)
                }
                return c
            }
        }

        // Try environment-based proof: look up arg type for refinement
        if arg_expr.kind == ExprKind::ExprIdent {
            let env_lookup = c.env.lookup(arg_expr.name)
            if env_lookup.refinement_id >= 0 && env_lookup.refinement_id < 128 {
                let env_ref = c.refinements.entries[env_lookup.refinement_id as usize]
                if pred_implies(env_ref.predicate, expected_ref.predicate) {
                    return c
                }
            }
            // Ontology-aware proof: if arg has an ontology type and the expected
            // refinement's base type also has an ontology type, check if ontology
            // subsumption holds. If it does, the base type constraint is satisfied
            // by the class hierarchy — only the predicate part needs verification.
            // This bridges ontology axioms into refinement obligations.
            if env_lookup.ontology_id >= 0 && expected_ty.ontology_id >= 0 {
                if ontology_table_is_subclass(c.ontologies, env_lookup.ontology_id, expected_ty.ontology_id) {
                    // Ontology subsumption proves base type compatibility.
                    // The predicate is not yet proven, but the type system accepts
                    // the base constraint. Scan ancestor classes for refinement
                    // predicates that could discharge the obligation.
                    var found_ancestor_ref = false
                    var anc_i: i64 = 0
                    while anc_i < c.ontologies.entries[env_lookup.ontology_id as usize].all_ancestor_count {
                        let anc_idx = c.ontologies.entries[env_lookup.ontology_id as usize].all_ancestor_indices[anc_i as usize]
                        if anc_idx >= 0 && anc_idx < c.ontologies.count {
                            // Check if this ancestor's type binding has a refinement
                            let anc_name = c.ontologies.entries[anc_idx as usize].name
                            let anc_ty = c.env.lookup(anc_name)
                            if anc_ty.refinement_id >= 0 && anc_ty.refinement_id < 128 {
                                let anc_ref = c.refinements.entries[anc_ty.refinement_id as usize]
                                if pred_implies(anc_ref.predicate, expected_ref.predicate) {
                                    found_ancestor_ref = true
                                }
                            }
                        }
                        anc_i = anc_i + 1
                    }
                    if found_ancestor_ref {
                        return c
                    }
                }
            }
        }

        // Epistemic fallback: emit warning, not error — unverifiable != wrong.
        // W040 semantics: the call compiles. The predicate is NOT proven statically.
        //   - Debug mode (future): codegen inserts runtime assertion at this call site.
        //     If the predicate fails at runtime, panic with "refinement predicate violated".
        //   - Release mode: trust the programmer. The warning was sufficient notice.
        // To suppress: #[allow(W040)] on the call site (not yet implemented).
        // To force proof: annotate the argument with an explicit refinement type.
        c.report_warning_at(call_span, 40, 0, 0, 0)
    }

    fn check_call_arg_knowledge_boundary(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if !is_epistemic_type(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if !is_epistemic_type(provided_ty) || is_error_or_unknown(provided_ty) {
            return self
        }
        if provided_ty.kind != expected_ty.kind {
            return self.report_error_at(call_span, 36, 0, 0, 0)
        }
        if knowledge_call_boundary_compatible(provided_ty, expected_ty) {
            self
        } else {
            self.report_error_at(call_span, 36, 0, 0, 0)
        }
    }

    fn check_call_arg_ontology_boundary(self, arg_ty: TypeEntry, param_ty: TypeEntry, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let expected_ty = call_ref_inner_or_self(param_ty)
        if expected_ty.ontology_id < 0 || is_error_or_unknown(expected_ty) {
            return self
        }
        let provided_ty = call_ref_inner_or_self(arg_ty)
        if is_error_or_unknown(provided_ty) {
            return self
        }
        if provided_ty.ontology_id < 0 {
            // Non-ontology value passed where ontology type expected
            return self.report_error_at(call_span, 150, 0, 0, 0)
        }
        // Check subsumption: provided must be subclass of expected
        if ontology_table_is_subclass(self.ontologies, provided_ty.ontology_id, expected_ty.ontology_id) {
            return self
        }
        // Check disjointness for better error
        if ontology_table_is_disjoint(self.ontologies, provided_ty.ontology_id, expected_ty.ontology_id) {
            return self.report_error_at(call_span, 151, 0, 0, 0)
        }
        self.report_error_at(call_span, 152, 0, 0, 0)
    }

    fn check_call_args_inner(self, args: Option<Box<ExprList>>, params: Option<Box<FnParamList>>, idx: i64, expected_count: i64, call_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        match args {
            Some(arg_list) => {
                let arg_expr = (*arg_list).head
                let param_info = fn_param_list_get(params, idx)
                let implicit_borrow =
                    arg_expr.kind == ExprKind::ExprIdent &&
                    (param_info.ty.kind == TypeKind::TyRef || param_info.ty.kind == TypeKind::TyRefMut)

                var checker_for_arg = self
                if implicit_borrow {
                    checker_for_arg.suppress_linear_consume_depth = checker_for_arg.suppress_linear_consume_depth + 1
                }

                let pair = checker_for_arg.check_expr(arg_expr)
                var c = pair.0
                if implicit_borrow && c.suppress_linear_consume_depth > 0 {
                    c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
                }
                let arg_ty = pair.1

                // Check against parameter type and boundary contracts
                let has_param_info = !name_is_empty(param_info.name) || param_info.ty.kind != TypeKind::TyError
                if has_param_info {
                    if !call_arg_types_compatible(arg_expr, arg_ty, param_info.ty) {
                        c = c.report_mismatch(call_span, 9, param_info.ty, arg_ty)
                    }
                    c = c.check_call_arg_borrow_boundary(arg_expr, param_info.ty, call_span)
                    c = c.check_call_arg_refinement_boundary(arg_expr, arg_ty, param_info.ty, call_span)
                    c = c.check_call_arg_knowledge_boundary(arg_ty, param_info.ty, call_span)
                    c = c.check_call_arg_ontology_boundary(arg_ty, param_info.ty, call_span)
                }
                // Linear type consumption: if arg is linear and not implicitly borrowed, consume it
                if has_param_info &&
                   arg_expr.kind == ExprKind::ExprIdent &&
                   c.is_linear_type(arg_ty) &&
                   !implicit_borrow &&
                   c.suppress_linear_consume_depth == 0 {
                    if c.borrows.is_borrowed(arg_expr.name) {
                        c = c.report_error_at(call_span, 38, 0, 0, 0)
                    } else {
                        let consume_result = c.borrows.consume_linear(arg_expr.name)
                        c.borrows = consume_result.0
                        if consume_result.1 != 0 {
                            c = c.report_error_at(call_span, 39, 0, 0, 0)
                        }
                    }
                }
                c.check_call_args_inner((*arg_list).tail, params, idx + 1, expected_count, call_span)
            }
            None => {
                // Check arity: idx should equal expected_count
                if idx != expected_count && expected_count >= 0 {
                    self.report_error_at(call_span, 10, 0, 0, 0)
                } else {
                    self
                }
            }
        }
    }

    fn check_expr_list_no_type(self, opt: Option<Box<ExprList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                c.check_expr_list_no_type((*list).tail)
            }
            None => self
        }
    }

    // Diagnostic-only argument checking helper: validate expression shape/type
    // without consuming linear values from identifier reads.
    fn check_expr_list_no_type_no_linear_consume(self, opt: Option<Box<ExprList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.suppress_linear_consume_depth = c.suppress_linear_consume_depth + 1
        c = c.check_expr_list_no_type(opt)
        if c.suppress_linear_consume_depth > 0 {
            c.suppress_linear_consume_depth = c.suppress_linear_consume_depth - 1
        }
        c
    }

    // --------------------------------------------------------
    // If expression
    // --------------------------------------------------------

    fn check_if_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        // Condition must be bool
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // Check then block
        let then_pair = c.check_opt_block(e.block)
        c = then_pair.0
        let then_ty = then_pair.1
        // Check else
        match e.else_expr {
            Some(else_e) => {
                let else_pair = c.check_expr(*else_e)
                c = else_pair.0
                let else_ty = else_pair.1
                if !types_compatible(then_ty, else_ty) {
                    c = c.report_mismatch(e.span, 7, then_ty, else_ty)
                }
                (c, then_ty)
            }
            None => (c, ty_unit())
        }
    }

    fn check_opt_block(self, opt: Option<Box<Block>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(blk) => self.check_block(*blk)
            None => (self, ty_unit())
        }
    }

    // --------------------------------------------------------
    // Match expression
    // --------------------------------------------------------

    fn check_match_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let scrut_pair = self.check_opt_expr(e.left)
        var c = scrut_pair.0
        let scrut_ty = scrut_pair.1
        c.check_match_arms(e.arms, scrut_ty)
    }

    fn check_match_arms(self, opt: Option<Box<MatchArmList>>, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let first_ty = pair.1
                c = c.check_remaining_arms((*list).tail, scrut_ty, first_ty)
                (c, first_ty)
            }
            None => (self, ty_unit())
        }
    }

    fn check_match_arm(self, arm: MatchArm, scrut_ty: TypeEntry) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        c = c.bind_pattern(arm.pattern, scrut_ty)
        let pair = c.check_expr(arm.body)
        c = pair.0
        let body_ty = pair.1
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, body_ty)
    }

    fn check_remaining_arms(self, opt: Option<Box<MatchArmList>>, scrut_ty: TypeEntry, expected_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_match_arm((*list).head, scrut_ty)
                var c = pair.0
                let arm_ty = pair.1
                if !types_compatible(arm_ty, expected_ty) {
                    c = c.report_mismatch((*list).head.span, 18, expected_ty, arm_ty)
                }
                c.check_remaining_arms((*list).tail, scrut_ty, expected_ty)
            }
            None => self
        }
    }

    fn bind_pattern(self, pat: Pattern, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match pat.kind {
            PatWildcard => self
            PatBinding => {
                var c = self
                c.env = c.env.bind(pat.name, scrut_ty, pat.is_mut)
                c = c.const_int_bind_unknown(pat.name)
                // Track pattern binding for borrow checking (linear if type is linear)
                let lin = c.is_linear_type(scrut_ty)
                c.borrows = c.borrows.track(pat.name, lin)
                c
            }
            PatIntLit => self
            PatBoolTrue => self
            PatBoolFalse => self
            PatStringLit => self
            PatEnum => {
                // Enum variant pattern — bind sub-patterns with scrut_ty
                // (variant field types not tracked yet, use scrut_ty as fallback)
                self.bind_pattern_list(pat.sub_patterns, scrut_ty)
            }
            PatStruct => {
                // Struct destructuring — bind field patterns with their field types
                self.bind_struct_pat_fields(pat.pat_fields, scrut_ty)
            }
            PatTuple => self.bind_tuple_pattern_list(pat.sub_patterns, scrut_ty)
            PatOr => self.bind_pattern_list(pat.sub_patterns, scrut_ty)
        }
    }

    fn bind_pattern_list(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self.bind_pattern((*list).head, scrut_ty)
                c.bind_pattern_list((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_struct_pat_fields(self, opt: Option<Box<PatFieldList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                // Look up the field type from either a struct or enum variant
                var field_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyNamed {
                    // First try: look up as struct
                    let struct_idx = c.structs.find(scrut_ty.name)
                    if struct_idx >= 0 {
                        let si = c.structs.get(struct_idx)
                        field_ty = field_info_list_find(si.fields, (*list).head.name)
                    } else {
                        // Second try: look up as enum — find which variant has this field
                        let enum_idx = c.enums.find(scrut_ty.name)
                        if enum_idx >= 0 {
                            let ei = c.enums.get(enum_idx)
                            // Search all variants for one that has this field
                            field_ty = variant_fields_find_field(ei.variants, (*list).head.name)
                        }
                    }
                }
                c = c.bind_pattern((*list).head.pattern, field_ty)
                c.bind_struct_pat_fields((*list).tail, scrut_ty)
            }
            None => self
        }
    }

    fn bind_tuple_pattern_list(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry) -> Checker with Mut, Panic, Div, Alloc, IO {
        // For tuple patterns, assign each sub-pattern the corresponding tuple element type
        self.bind_tuple_pattern_list_idx(opt, scrut_ty, 0)
    }

    fn bind_tuple_pattern_list_idx(self, opt: Option<Box<PatternList>>, scrut_ty: TypeEntry, idx: i64) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var elem_ty = ty_unknown()
                if scrut_ty.kind == TypeKind::TyTuple {
                    elem_ty = type_entry_list_get(scrut_ty.tuple_elems, idx)
                }
                var c = self.bind_pattern((*list).head, elem_ty)
                c.bind_tuple_pattern_list_idx((*list).tail, scrut_ty, idx + 1)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // While, Loop, Block, Return
    // --------------------------------------------------------

    fn check_break_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 44, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_continue_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        if c.loop_depth == 0 {
            c = c.report_error_at(e.span, 45, 0, 0, 0)
        }
        (c, ty_never())
    }

    fn check_for_in_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Check iterator expression (range)
        let iter_pair = self.check_opt_expr(e.left)
        var c = iter_pair.0
        // Push scope for loop variable
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()
        c.env = c.env.bind(e.name, ty_i64(), false)
        c.loop_depth = c.loop_depth + 1
        c.borrows = c.borrows.release_exclusive_borrows()
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        c.loop_depth = c.loop_depth - 1
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()
        (c, ty_unit())
    }

    fn check_while_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let cond_pair = self.check_opt_expr(e.left)
        var c = cond_pair.0
        let cond_ty = cond_pair.1
        if !is_error_or_unknown(cond_ty) && !is_bool_type(cond_ty) {
            c = c.report_mismatch(e.span, 6, ty_bool(), cond_ty)
        }
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body.
        // In a while loop, each iteration may re-borrow the same variables.
        // Without this, the second iteration would fail because the first
        // iteration's exclusive borrows are still active.
        c.borrows = c.borrows.release_exclusive_borrows()
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_loop_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self
        // Check loop depth limit before incrementing
        let depth_pair = c.check_loop_depth(e.span)
        c = depth_pair.0
        if !depth_pair.1 {
            return (c, ty_error())
        }
        c.loop_depth = c.loop_depth + 1
        // Release exclusive borrows before checking loop body (same as while loops)
        c.borrows = c.borrows.release_exclusive_borrows()
        let pair = c.check_opt_block(e.block)
        c = pair.0
        c.loop_depth = c.loop_depth - 1
        (c, ty_unit())
    }

    fn check_block_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        self.check_opt_block(e.block)
    }

    fn check_return_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let val_ty = pair.1
        if !types_compatible(val_ty, c.current_return_type) {
            c = c.report_mismatch(e.span, 8, c.current_return_type, val_ty)
        }
        (c, ty_never())
    }

    // --------------------------------------------------------
    // Struct literal
    // --------------------------------------------------------

    fn check_struct_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let struct_name = checker_copy_string_list_to_name(e.path.segments)
        let struct_idx = self.structs.find(struct_name)
        if struct_idx >= 0 {
            let si = self.structs.get(struct_idx)
            if si.is_generic_template {
                // Generic struct: infer type params from field initializers
                self.check_generic_struct_lit(e, si)
            } else {
                var c = self.check_struct_field_inits(e.fields, si, e.span)
                (c, ty_named(struct_name))
            }
        } else {
            var c = self.report_error_at(e.span, 15, 0, 0, 0)
            c = c.check_struct_field_inits_no_type(e.fields)
            (c, ty_error())
        }
    }

    fn check_generic_struct_lit(self, e: Expr, tmpl: StructInfo) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Infer type arguments from field initializers, then monomorphize.
        var inferred = InferBuf { args: [ty_error(); 8] }
        let pair = self.infer_type_params_from_fields(e.fields, tmpl, inferred)
        var c = pair.0
        inferred = pair.1
        c.finalize_generic_struct_lit(e, tmpl, inferred.args)
    }

    fn infer_type_params_from_fields(self, opt: Option<Box<StructFieldList>>, tmpl: StructInfo, acc: InferBuf) -> (Checker, InferBuf) with Mut, Panic, Div, Alloc, IO {
        match opt {
            None => (self, acc)
            Some(fl) => {
                let field_name = (*fl).head.name
                let tmpl_field_ty = field_info_list_find(tmpl.fields, field_name)
                let pair = self.check_expr((*fl).head.value)
                var c = pair.0
                let init_ty = pair.1

                // If this template field type references a type parameter, record the inferred type
                var buf = acc
                if tmpl_field_ty.kind == TypeKind::TyNamed {
                    var pi: i64 = 0
                    while pi < tmpl.type_param_count {
                        if name_eq(tmpl_field_ty.name, tmpl.type_param_names[pi]) {
                            buf.args[pi] = init_ty
                            pi = tmpl.type_param_count  // break
                        } else {
                            pi = pi + 1
                        }
                    }
                }
                c.infer_type_params_from_fields((*fl).tail, tmpl, buf)
            }
        }
    }

    fn finalize_generic_struct_lit(self, e: Expr, tmpl: StructInfo, inferred_args: [TypeEntry; 8]) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // Build the TypeEntryList from inferred args
        var args_list_opt: Option<Box<TypeEntryList>> = None
        var ai: i64 = tmpl.type_param_count - 1
        while ai >= 0 {
            args_list_opt = Some(Box::new(TypeEntryList { head: inferred_args[ai], tail: args_list_opt }))
            ai = ai - 1
        }

        match args_list_opt {
            None => (self, ty_error())
            Some(args_box) => {
                let args = *args_box
                // Build mangled name
                let mangled = mangle_generic_name(tmpl.name, args)

                // Check if already monomorphized
                var c = self
                let existing_idx = c.structs.find(mangled)
                if existing_idx < 0 {
                    // Monomorphize
                    let mono_fields = monomorphize_fields(tmpl.fields, tmpl.type_param_count, tmpl.type_param_names, args)
                    let mono_info = StructInfo {
                        name: mangled,
                        fields: mono_fields.0,
                        field_count: mono_fields.1,
                        is_linear: tmpl.is_linear,
                        type_param_count: 0,
                        type_param_names: [Name { buf: [0; 128], len: 0 }; 8],
                        is_generic_template: false,
                    }
                    c.structs = c.structs.add(mono_info)
                }

                // Now validate fields against the monomorphized struct
                let mono_idx = c.structs.find(mangled)
                if mono_idx >= 0 {
                    let mono_si = c.structs.get(mono_idx)
                    c = c.check_struct_field_inits(e.fields, mono_si, e.span)
                }
                (c, ty_named(mangled))
            }
        }
    }

    fn check_struct_field_inits(self, opt: Option<Box<StructFieldList>>, si: StructInfo, lit_span: Span) -> Checker with Mut, Panic, Div, Alloc, IO {
        let init_count = struct_field_list_count(opt)
        if init_count != si.field_count {
            return self.report_error_at(lit_span, 46, 0, 0, 0)
        }
        self.check_struct_field_inits_with_type(opt, si)
    }

    fn check_struct_field_inits_with_type(self, opt: Option<Box<StructFieldList>>, si: StructInfo) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                var c = self
                let field_ty = field_info_list_find(si.fields, (*list).head.name)
                let pair = c.check_expr((*list).head.value)
                c = pair.0
                let init_ty = pair.1
                if !types_compatible(init_ty, field_ty) {
                    c = c.report_mismatch((*list).head.value.span, 16, field_ty, init_ty)
                }
                c.check_struct_field_inits_with_type((*list).tail, si)
            }
            None => self
        }
    }

    fn check_struct_field_inits_no_type(self, opt: Option<Box<StructFieldList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head.value)
                var c = pair.0
                c.check_struct_field_inits_no_type((*list).tail)
            }
            None => self
        }
    }

    // --------------------------------------------------------
    // Array literal
    // --------------------------------------------------------

    fn check_array_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match e.left {
            Some(elem_expr) => match e.right {
                Some(count_expr) => {
                    let elem_pair = self.check_expr(*elem_expr)
                    var c = elem_pair.0
                    let elem_ty = elem_pair.1
                    let count_pair = c.check_expr(*count_expr)
                    c = count_pair.0
                    let count_ty = count_pair.1
                    if !types_compatible(count_ty, ty_i64()) {
                        c = c.report_mismatch((*count_expr).span, 20, ty_i64(), count_ty)
                        return (c, ty_array(elem_ty, 0))
                    }
                    if (*count_expr).kind != ExprKind::ExprIntLit {
                        c = c.report((*count_expr).span, 20)
                        return (c, ty_array(elem_ty, 0))
                    }
                    return (c, ty_array(elem_ty, (*count_expr).int_val))
                }
                None => ()
            }
            None => ()
        }

        let pair = self.check_array_elems(e.args)
        let c = pair.0
        let elem_ty = pair.1
        let count = pair.2
        (c, ty_array(elem_ty, count))
    }

    fn check_array_elems(self, opt: Option<Box<ExprList>>) -> (Checker, TypeEntry, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let first_ty = pair.1
                let rest = c.check_array_rest((*list).tail, first_ty)
                (rest.0, first_ty, 1 + rest.1)
            }
            None => (self, ty_error(), 0)
        }
    }

    fn check_array_rest(self, opt: Option<Box<ExprList>>, expected: TypeEntry) -> (Checker, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(list) => {
                let pair = self.check_expr((*list).head)
                var c = pair.0
                let elem_ty = pair.1
                if !types_compatible(elem_ty, expected) {
                    c = c.report_mismatch((*list).head.span, 20, expected, elem_ty)
                }
                let rest = c.check_array_rest((*list).tail, expected)
                (rest.0, 1 + rest.1)
            }
            None => (self, 0)
        }
    }

    // --------------------------------------------------------
    // Tuple literal
    // --------------------------------------------------------

    fn check_tuple_lit(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_tuple_elems(e.args)
        let c = pair.0
        match pair.1 {
            Some(elem_list) => (c, ty_tuple(*elem_list))
            None => (c, ty_unit())
        }
    }

    fn check_tuple_elems(self, opt: Option<Box<ExprList>>) -> (Checker, Option<Box<TypeEntryList>>) with Mut, Panic, Div, Alloc, IO {
        // Iterative: collect element types into array, then build list in reverse.
        // Avoids recursive Checker copies that overflow the SOBC VM stack.
        var c = self
        var types: [TypeEntry; 16] = [empty_type_entry(); 16]
        var count: i64 = 0
        var cur = opt
        var done = false
        while !done {
            match cur {
                Some(list) => {
                    if count < 16 {
                        let pair = c.check_expr((*list).head)
                        c = pair.0
                        types[count] = pair.1
                        count = count + 1
                        cur = (*list).tail
                    } else {
                        done = true
                    }
                }
                None => {
                    done = true
                }
            }
        }
        if count == 0 {
            return (c, None)
        }
        // Build TypeEntryList in reverse order (last element first)
        var result: Option<Box<TypeEntryList>> = None
        var j = count - 1
        while j >= 0 {
            result = Some(Box::new(TypeEntryList { head: types[j], tail: result }))
            j = j - 1
        }
        (c, result)
    }

    // --------------------------------------------------------
    // Range expression
    // --------------------------------------------------------

    fn check_range_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let left_pair = self.check_opt_expr(e.left)
        var c = left_pair.0
        let left_ty = left_pair.1
        let right_pair = c.check_opt_expr(e.right)
        c = right_pair.0
        let right_ty = right_pair.1
        // Range endpoints must be integer types
        if !is_error_or_unknown(left_ty) && !is_integer_type(left_ty) {
            c = c.report_mismatch(e.span, 55, ty_i64(), left_ty)
        }
        if !is_error_or_unknown(right_ty) && !is_integer_type(right_ty) {
            c = c.report_mismatch(e.span, 55, ty_i64(), right_ty)
        }
        (c, ty_unit())
    }

    fn check_cast_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        let pair = self.check_opt_expr(e.left)
        var c = pair.0
        let src_ty = pair.1
        // Resolve the target type from the cast_type annotation
        match e.cast_type {
            Some(ty) => {
                let ty_pair = c.lower_type_expr(*ty)
                c = ty_pair.0
                let target_ty = ty_pair.1
                // Unit conversion check: if both are unit-typed, dimensions must be compatible
                if src_ty.unit_id >= 0 && target_ty.unit_id >= 0 {
                    let src_dim = c.units.get_dim(src_ty.unit_id)
                    let tgt_dim = c.units.get_dim(target_ty.unit_id)
                    if !unit_dim_compatible(src_dim, tgt_dim) {
                        c = c.report_error_at(e.span, 43, 0, 0, 0)
                    }
                }
                (c, target_ty)
            }
            None => (c, ty_error())
        }
    }

    fn check_handle_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        // handle<Effect> { body } with { handlers }
        // The handler discharges the named effect within the body.
        var c = self

        // Resolve the effect name to an ID
        var eff_name_buf: [i8; 64] = [0; 64]
        var i: i64 = 0
        while i < e.name.len && i < 64 {
            eff_name_buf[i as usize] = e.name.buf[i as usize]
            i = i + 1
        }
        let eff_id = effect_name_to_id(eff_name_buf, e.name.len)

        // Add the handled effect to the current effects (body may use it)
        var saved_effects = c.current_effects
        var saved_count = c.current_effect_count
        if eff_id >= 0 && c.current_effect_count < 8 {
            if !has_effect_id(c.current_effects, c.current_effect_count, eff_id) {
                c.current_effects[c.current_effect_count as usize] = eff_id
                c.current_effect_count = c.current_effect_count + 1
            }
        }

        // Check the body block
        let body_pair = c.check_opt_block(e.block)
        c = body_pair.0
        let body_ty = body_pair.1

        // Restore original effects (handler discharges the effect)
        c.current_effects = saved_effects
        c.current_effect_count = saved_count

        // Check the handler block (with { ... }) if present
        match e.handler_block {
            Some(hb) => {
                let hpair = c.check_block(*hb)
                c = hpair.0
            }
            None => {}
        }

        (c, body_ty)
    }

    // --------------------------------------------------------
    // Closure expression checking with effect inference
    // --------------------------------------------------------

    fn check_closure_expr(self, e: Expr) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        var c = self

        // Convert closure params to FnParamList for signature
        let params_pair = c.collect_closure_params(e.closure_params)
        c = params_pair.0
        let params = params_pair.1
        let param_count = params_pair.2

        // Lower return type annotation (if present) or use unknown
        let ret_pair = c.lower_opt_closure_return(e.closure_return)
        c = ret_pair.0
        let ret_ty = ret_pair.1

        // Save current effects, clear for inference
        let saved_effects = c.current_effects
        let saved_effect_count = c.current_effect_count
        c.current_effects = [0; 8]
        c.current_effect_count = 0

        // Push scope for parameters
        c.env = c.env.push_scope()
        c.borrows = c.borrows.push_scope()
        c = c.push_const_scope()

        // Bind closure params in environment
        c = c.bind_closure_params(e.closure_params)

        // Check body expression
        let body_pair = c.check_opt_expr(e.closure_body)
        c = body_pair.0
        let body_ty = body_pair.1

        // Infer return type from body if not annotated
        let inferred_ret_ty = if ret_ty.kind == TypeKind::TyUnknown {
            body_ty
        } else {
            ret_ty
        }

        // Check body type against return type if annotated
        if ret_ty.kind != TypeKind::TyUnknown {
            if !types_compatible(body_ty, ret_ty) {
                c = c.report_mismatch(e.span, 8, ret_ty, body_ty)
            }
        }

        // Get inferred effects from current_effects
        let inferred_effects = c.current_effects
        let inferred_effect_count = c.current_effect_count

        // Pop scope
        c = c.pop_const_scope()
        c.borrows = c.borrows.pop_scope()
        c.env = c.env.pop_scope()

        // Restore outer effects context
        c.current_effects = saved_effects
        c.current_effect_count = saved_effect_count

        // Sprint 231: Capture analysis — scan outer scope for linear + epistemic
        var capture_linear = false
        var capture_linear_count: i64 = 0
        var capture_epsilon: f64 = 0.0 - 1.0
        // Conservative: scan all bindings in the outer scope (below closure params)
        // The closure scope was pushed above; outer bindings are those with
        // scope_depth < current closure scope depth.
        var ci: i64 = 0
        let env_count = c.env.count
        while ci < env_count {
            let binding = c.env.bindings[ci as usize]
            let binding_ty = binding.ty
            if c.is_linear_type(binding_ty) {
                capture_linear = true
                capture_linear_count = capture_linear_count + 1
            }
            if binding_ty.kind == TypeKind::TyKnowledge {
                let eps = binding_ty.knowledge_epsilon
                if eps >= 0.0 {
                    if capture_epsilon < 0.0 {
                        capture_epsilon = eps
                    } else {
                        capture_epsilon = capture_epsilon + eps
                    }
                }
            }
            ci = ci + 1
        }
        // Sprint 231: Auto-inject Epistemic effect if Knowledge values captured
        if capture_epsilon >= 0.0 {
            var has_epistemic = false
            var ei: i64 = 0
            while ei < inferred_effect_count {
                if inferred_effects[ei] == 8 { has_epistemic = true }
                ei = ei + 1
            }
            if !has_epistemic && inferred_effect_count < 8 {
                inferred_effects[inferred_effect_count] = 8
                inferred_effect_count = inferred_effect_count + 1
            }
        }
        // Create FnSig with inferred effects + capture metadata
        let closure_sig = FnSig {
            name: Name { buf: [0; 128], len: 0 },  // Anonymous closure
            params: params,
            param_count: param_count,
            return_type: inferred_ret_ty,
            is_method: false,
            self_type_name: Name { buf: [0; 128], len: 0 },
            self_type_entry: ty_unit(),
            effects: inferred_effects,
            effect_count: inferred_effect_count,
            is_kernel: false,
            is_epistemic_kernel: false,
            is_linear_closure: capture_linear,
            linear_capture_count: capture_linear_count,
            epistemic_epsilon: capture_epsilon,
        }

        // Add to fn_sigs table
        let add_result = c.fn_sigs.add(closure_sig)
        c.fn_sigs = add_result.0
        let sig_id = add_result.1

        (c, ty_fn(sig_id))
    }

    fn collect_closure_params(self, opt: Option<Box<ClosureParamList>>) -> (Checker, Option<Box<FnParamList>>, i64) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                let pair = self.collect_closure_param_list(*pl)
                (pair.0, Some(Box::new(pair.1)), pair.2)
            }
            None => (self, None, 0)
        }
    }

    fn collect_closure_param_list(self, pl: ClosureParamList) -> (Checker, FnParamList, i64) with Mut, Panic, Div, Alloc, IO {
        let pair = self.lower_type_expr(pl.head.ty)
        var c = pair.0
        let head_ty = pair.1
        let head_param = FnParamInfo { name: pl.head.name, ty: head_ty }
        let head_list = FnParamList { head: head_param, tail: None }
        match pl.tail {
            None => (c, head_list, 1)
            Some(rest) => {
                let rest_result = c.collect_closure_param_list(*rest)
                c = rest_result.0
                let rest_list = rest_result.1
                let rest_count = rest_result.2
                (c, FnParamList { head: head_param, tail: Some(Box::new(rest_list)) }, 1 + rest_count)
            }
        }
    }

    fn bind_closure_params(self, opt: Option<Box<ClosureParamList>>) -> Checker with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(pl) => {
                var c = self.bind_closure_param((*pl).head)
                c.bind_closure_params((*pl).tail)
            }
            None => self
        }
    }

    fn bind_closure_param(self, p: ClosureParam) -> Checker with Mut, Panic, Div, Alloc, IO {
        var c = self
        let pair = c.lower_type_expr(p.ty)
        c = pair.0
        let param_ty = pair.1
        c.env = c.env.bind(p.name, param_ty, false)
        c = c.const_int_bind_unknown(p.name)
        c
    }

    fn lower_opt_closure_return(self, opt: Option<Box<TypeExpr>>) -> (Checker, TypeEntry) with Mut, Panic, Div, Alloc, IO {
        match opt {
            Some(te) => self.lower_type_expr(*te)
            None => (self, ty_unknown())
        }
    }
}

// ============================================================
// Struct field list helper
// ============================================================

fn struct_field_list_count(opt: Option<Box<StructFieldList>>) -> i64 with Mut, Panic, Div, Alloc {
    match opt {
        None => 0
        Some(list) => 1 + struct_field_list_count((*list).tail)
    }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/mod.sio  (254 lines)
// ════════════════════════════════════════════════════════════════

// Type Checker — entry point
//
// Runs the two-pass type checking algorithm on a Program AST:
//   Pass 1: collect struct/enum/fn definitions into tables
//   Pass 2: check function bodies for type consistency
//
// Returns a CheckResult with the error count.



struct CheckResult {
    error_count: i64,
    had_error: bool,
}

struct CheckArtifactsResult {
    error_count: i64,
    had_error: bool,
    checker: Checker,
}

struct CheckEpistemicResult {
    error_count: i64,
    had_error: bool,
    epistemic: IrEpistemicSection,
}

struct CheckBoxedEpistemicResult {
    error_count: i64,
    had_error: bool,
    epistemic: Box<IrEpistemicSection>,
}

fn check_policy_requirements_to_ir(
    opt: Option<Box<PolicyRequirementInfoList>>,
    out: [IrPolicyRequirementInfo; 8],
    idx: i64
) -> [IrPolicyRequirementInfo; 8] with Mut, Panic, Div, Alloc {
    match opt {
        Some(list) => {
            var next = out
            if idx < 8 {
                next[idx as usize] = IrPolicyRequirementInfo {
                    metric_id: (*list).head.metric_id,
                    metric_name: (*list).head.metric_name,
                    op: (*list).head.op,
                    threshold: (*list).head.threshold,
                    threshold_kind: (*list).head.threshold_kind,
                    bool_threshold: (*list).head.bool_threshold,
                    name_threshold: (*list).head.name_threshold,
                }
            }
            check_policy_requirements_to_ir((*list).tail, next, idx + 1)
        }
        None => out
    }
}

fn checker_to_ir_epistemic_into(checker: &Checker, ep: &! IrEpistemicSection) with Mut, Panic, Div, Alloc {
    checker_export_ir_epistemic_into_local(checker, ep)
}

fn checker_to_ir_epistemic(checker: Checker) -> IrEpistemicSection with Mut, Panic, Div, Alloc {
    var ep = ir_empty_epistemic_section()
    checker_export_ir_epistemic_into_local(&checker, &!ep)
    ep
}

fn check_result_to_ir_epistemic(result: &CheckArtifactsResult) -> IrEpistemicSection with Mut, Panic, Div, Alloc {
    checker_to_ir_epistemic(result.checker)
}

fn checker_to_ir_algebras(checker: &Checker) -> IrAlgebraTable with Mut, Panic, Div, Alloc {
    var out = ir_empty_algebra_table()
    var i: i64 = 0
    while i < checker.algebras.count && i < 32 {
        let src = checker.algebras.entries[i]
        out.entries[i] = IrAlgebraInfo {
            name: src.name,
            add_commutative: src.add_commutative,
            add_associative: src.add_associative,
            mul_commutative: src.mul_commutative,
            mul_associative: src.mul_associative,
            mul_alternative: src.mul_alternative,
            reassoc_strategy: src.reassoc_strategy,
            algebra_tag: src.algebra_tag,
            is_valid: src.is_valid,
        }
        i = i + 1
    }
    out.count = if checker.algebras.count > 32 { 32 } else { checker.algebras.count }
    out
}

fn checker_to_ir_ontologies(checker: &Checker) -> IrOntologyTable with Mut, Panic, Div, Alloc {
    var out = ir_empty_ontology_table()
    var i: i64 = 0
    while i < checker.ontologies.count && i < 64 {
        let src = checker.ontologies.entries[i as usize]
        out.entries[i as usize] = IrOntologyClassInfo {
            name: src.name,
            ontology_name: src.ontology_name,
            class_index: src.class_index,
            superclass_count: src.superclass_count,
            is_valid: src.is_valid,
        }
        i = i + 1
    }
    out.count = if checker.ontologies.count > 64 { 64 } else { checker.ontologies.count }
    out
}

fn checker_collect_hyper_alg_from_type_list(
    elems: Option<Box<TypeEntryList>>,
    found_alg: &! i64,
    found_any: &! i64,
    ambiguous: &! i64
) with Mut, Panic, Div, Alloc {
    if *ambiguous != 0 { return }
    match elems {
        None => {}
        Some(list) => {
            checker_collect_hyper_alg_from_type((*list).head, &! found_alg, &! found_any, &! ambiguous)
            checker_collect_hyper_alg_from_type_list((*list).tail, &! found_alg, &! found_any, &! ambiguous)
        }
    }
}

fn checker_collect_hyper_alg_from_type(
    ty: TypeEntry,
    found_alg: &! i64,
    found_any: &! i64,
    ambiguous: &! i64
) with Mut, Panic, Div, Alloc {
    if *ambiguous != 0 { return }
    if ty.kind == TypeKind::TyHyper {
        if *found_any == 0 {
            *found_any = 1
            *found_alg = ty.algebra_kind
        } else if *found_alg != ty.algebra_kind {
            *ambiguous = 1
        }
    }
    match ty.inner {
        None => {}
        Some(inner) => checker_collect_hyper_alg_from_type(*inner, &! found_alg, &! found_any, &! ambiguous)
    }
    checker_collect_hyper_alg_from_type_list(ty.tuple_elems, &! found_alg, &! found_any, &! ambiguous)
}

fn checker_infer_fn_hyper_algebra(checker: &Checker, fn_name: Name) -> i64 with Mut, Panic, Div, Alloc {
    let sig_idx = checker.fn_sigs.find(fn_name)
    if sig_idx < 0 { return -1 }
    let sig = checker.fn_sigs.get(sig_idx)
    var found_alg: i64 = -1
    var found_any: i64 = 0
    var ambiguous: i64 = 0

    checker_collect_hyper_alg_from_type(sig.return_type, &! found_alg, &! found_any, &! ambiguous)
    if sig.is_method {
        checker_collect_hyper_alg_from_type(sig.self_type_entry, &! found_alg, &! found_any, &! ambiguous)
    }

    var i: i64 = 0
    while i < sig.param_count && ambiguous == 0 {
        let param = fn_param_list_get(sig.params, i)
        checker_collect_hyper_alg_from_type(param.ty, &! found_alg, &! found_any, &! ambiguous)
        i = i + 1
    }

    if ambiguous != 0 { return -1 }
    if found_any == 0 { return -1 }
    found_alg
}

fn checker_apply_ir_metadata(checker: &Checker, module: &! IrModule) with Mut, Panic, Div, Alloc {
    (*module).algebras = checker_to_ir_algebras(checker)
    (*module).ontologies = checker_to_ir_ontologies(checker)
    var i: i64 = 0
    while i < (*module).fn_count {
        let fn_name = (*module).functions[i].name
        (*module).functions[i].hyper_algebra_kind = checker_infer_fn_hyper_algebra(checker, fn_name)
        i = i + 1
    }
}

fn check_program_ok(prog: Program) -> bool with Mut, Panic, Div, Alloc, IO {
    let result = check_program(prog)
    !result.had_error
}

fn check_program_epistemic_into(prog: Program, out: &! IrEpistemicSection) -> bool with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    if artifacts.had_error {
        return false
    }
    checker_export_ir_epistemic_into_local(&artifacts.checker, out)
    true
}

fn check_program(prog: Program) -> CheckResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    CheckResult {
        error_count: artifacts.error_count,
        had_error: artifacts.had_error,
    }
}

fn check_program_with_artifacts(prog: Program) -> CheckArtifactsResult with Mut, Panic, Div, Alloc, IO {
    var checker = checker_new()
    checker = checker.collect_items(prog.items)
    checker = checker.check_items(prog.items)
    CheckArtifactsResult {
        error_count: checker.error_count,
        had_error: checker.had_error,
        checker: checker,
    }
}

fn check_program_epistemic(prog: Program) -> CheckEpistemicResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    let error_count = artifacts.error_count
    let had_error = artifacts.had_error
    let epistemic = if had_error {
        ir_empty_epistemic_section()
    } else {
        check_result_to_ir_epistemic(&artifacts)
    }
    CheckEpistemicResult {
        error_count: error_count,
        had_error: had_error,
        epistemic: epistemic,
    }
}

fn check_program_boxed_ir_epistemic(prog: Program) -> CheckBoxedEpistemicResult with Mut, Panic, Div, Alloc, IO {
    let artifacts = check_program_with_artifacts(prog)
    let error_count = artifacts.error_count
    let had_error = artifacts.had_error
    let epistemic = if had_error {
        ir_empty_epistemic_section()
    } else {
        check_result_to_ir_epistemic(&artifacts)
    }
    CheckBoxedEpistemicResult {
        error_count: error_count,
        had_error: had_error,
        epistemic: Box::new(epistemic),
    }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/patterns.sio  (1734 lines)
// ════════════════════════════════════════════════════════════════

// Pattern match compiler / exhaustiveness checker
//
// Implements the Maranget-style algorithm for:
//   - Exhaustiveness checking (are all cases covered?)
//   - Usefulness checking (is each arm reachable?)
//   - Decision tree compilation (compile match to switch tree)
//
// Uses flat-array arena pattern (no recursive types) consistent
// with the self-hosted checker's design.

// ============================================================
// Pattern kind constants
// ============================================================

let PAT_WILDCARD: i64 = 0
let PAT_LITERAL_INT: i64 = 1
let PAT_LITERAL_BOOL: i64 = 2
let PAT_VARIANT: i64 = 3
let PAT_TUPLE: i64 = 4
let PAT_STRUCT: i64 = 5
let PAT_OR: i64 = 6
let PAT_BINDING: i64 = 7
let PAT_RANGE: i64 = 8

// ============================================================
// Decision node kind constants
// ============================================================

let DECISION_LEAF: i64 = 0
let DECISION_SWITCH: i64 = 1
let DECISION_FAIL: i64 = 2

// ============================================================
// PatternPool — arena of pattern nodes
// ============================================================
//
// Each pattern is identified by an integer ID (its index).
// kinds[id]          = PAT_WILDCARD / PAT_LITERAL_INT / ...
// values[id]         = literal value, variant tag, range lo, etc.
// values2[id]        = range hi (for PAT_RANGE), bool value, etc.
// child_offsets[id]  = start offset into children[]
// child_counts[id]   = number of children in children[]

struct PatternPool {
    kinds: [i64; 1024],
    values: [i64; 1024],
    values2: [i64; 1024],
    children: [i64; 4096],
    child_offsets: [i64; 1024],
    child_counts: [i64; 1024],
    count: i64,
    child_total: i64,
}

fn pat_pool_new() -> PatternPool {
    PatternPool {
        kinds: [0; 1024],
        values: [0; 1024],
        values2: [0; 1024],
        children: [0; 4096],
        child_offsets: [0; 1024],
        child_counts: [0; 1024],
        count: 0,
        child_total: 0,
    }
}

// ============================================================
// Pool: add wildcard
// ============================================================

fn pat_pool_add_wildcard(pool: PatternPool) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_WILDCARD
    p.values[id as usize] = 0
    p.values2[id as usize] = 0
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = 0
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: add literal int
// ============================================================

fn pat_pool_add_literal_int(pool: PatternPool, value: i64) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_LITERAL_INT
    p.values[id as usize] = value
    p.values2[id as usize] = 0
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = 0
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: add literal bool
// ============================================================

fn pat_pool_add_literal_bool(pool: PatternPool, value: i64) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_LITERAL_BOOL
    p.values[id as usize] = value
    p.values2[id as usize] = 0
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = 0
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: add variant (enum constructor with tag + children)
// ============================================================

fn pat_pool_add_variant(pool: PatternPool, tag: i64, children_ids: [i64; 16], child_count: i64) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_VARIANT
    p.values[id as usize] = tag
    p.values2[id as usize] = 0
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = child_count

    // Copy children into the children array
    var i: i64 = 0
    while i < child_count {
        p.children[(p.child_total + i) as usize] = children_ids[i as usize]
        i = i + 1
    }
    p.child_total = p.child_total + child_count
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: add tuple pattern (children are sub-patterns)
// ============================================================

fn pat_pool_add_tuple(pool: PatternPool, children_ids: [i64; 16], child_count: i64) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_TUPLE
    p.values[id as usize] = 0
    p.values2[id as usize] = 0
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = child_count

    var i: i64 = 0
    while i < child_count {
        p.children[(p.child_total + i) as usize] = children_ids[i as usize]
        i = i + 1
    }
    p.child_total = p.child_total + child_count
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: add or-pattern (left | right)
// ============================================================

fn pat_pool_add_or(pool: PatternPool, left_id: i64, right_id: i64) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_OR
    p.values[id as usize] = left_id
    p.values2[id as usize] = right_id
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = 0
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: add binding (equivalent to wildcard for exhaustiveness)
// ============================================================

fn pat_pool_add_binding(pool: PatternPool) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_BINDING
    p.values[id as usize] = 0
    p.values2[id as usize] = 0
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = 0
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: add range pattern [lo..hi]
// ============================================================

fn pat_pool_add_range(pool: PatternPool, lo: i64, hi: i64) -> (PatternPool, i64) with Mut, Panic, Div {
    var p = pool
    let id = p.count
    p.kinds[id as usize] = PAT_RANGE
    p.values[id as usize] = lo
    p.values2[id as usize] = hi
    p.child_offsets[id as usize] = p.child_total
    p.child_counts[id as usize] = 0
    p.count = p.count + 1
    (p, id)
}

// ============================================================
// Pool: get child ID at index for a given pattern
// ============================================================

fn pat_pool_get_child(pool: PatternPool, pat_id: i64, child_idx: i64) -> i64 with Panic, Div {
    let offset = pool.child_offsets[pat_id as usize]
    pool.children[(offset + child_idx) as usize]
}

// ============================================================
// Pool: check if pattern is a wildcard-like (wildcard or binding)
// ============================================================

fn pat_is_wildcard_like(pool: PatternPool, pat_id: i64) -> bool with Panic, Div {
    let k = pool.kinds[pat_id as usize]
    k == PAT_WILDCARD || k == PAT_BINDING
}

// ============================================================
// PatternRow — a single row in the pattern matrix
// ============================================================

struct PatternRow {
    patterns: [i64; 16],
    pattern_count: i64,
    action_id: i64,
}

fn pat_row_new() -> PatternRow {
    PatternRow {
        patterns: [0; 16],
        pattern_count: 0,
        action_id: 0,
    }
}

fn pat_row_with_action(action: i64) -> PatternRow {
    PatternRow {
        patterns: [0; 16],
        pattern_count: 0,
        action_id: action,
    }
}

// ============================================================
// PatternRow: set pattern at column
// ============================================================

fn pat_row_set(row: PatternRow, col: i64, pat_id: i64) -> PatternRow with Mut, Panic, Div {
    var r = row
    r.patterns[col as usize] = pat_id
    if col >= r.pattern_count {
        r.pattern_count = col + 1
    }
    r
}

// ============================================================
// PatternRow: get pattern at column
// ============================================================

fn pat_row_get(row: PatternRow, col: i64) -> i64 with Panic, Div {
    row.patterns[col as usize]
}

// ============================================================
// PatternRow: remove first column, shift left
// ============================================================

fn pat_row_remove_first(row: PatternRow) -> PatternRow with Mut, Panic, Div {
    var r = pat_row_new()
    r.action_id = row.action_id
    var i: i64 = 1
    while i < row.pattern_count {
        r.patterns[(i - 1) as usize] = row.patterns[i as usize]
        i = i + 1
    }
    r.pattern_count = row.pattern_count - 1
    r
}

// ============================================================
// PatternRow: prepend patterns from variant children
// ============================================================

fn pat_row_expand_variant(row: PatternRow, pool: PatternPool, arity: i64) -> PatternRow with Mut, Panic, Div {
    // The first column is the variant; replace it with arity wildcards
    // then append the remaining columns.
    var r = pat_row_new()
    r.action_id = row.action_id

    // First: arity new columns for the variant sub-patterns
    let first_pat_id = pat_row_get(row, 0)
    let child_count = pool.child_counts[first_pat_id as usize]

    var c: i64 = 0
    while c < arity {
        if c < child_count {
            r.patterns[c as usize] = pat_pool_get_child(pool, first_pat_id, c)
        } else {
            // More arity positions than children -> wildcard placeholder
            // Use pattern 0 as a convention (caller must ensure 0 is a wildcard)
            r.patterns[c as usize] = 0
        }
        c = c + 1
    }

    // Then copy remaining columns from original row (skip column 0)
    var j: i64 = 1
    while j < row.pattern_count {
        r.patterns[(arity + j - 1) as usize] = row.patterns[j as usize]
        j = j + 1
    }
    r.pattern_count = arity + row.pattern_count - 1
    r
}

// ============================================================
// PatternMatrix — collection of rows
// ============================================================

struct PatternMatrix {
    rows: [PatternRow; 128],
    row_count: i64,
    column_count: i64,
}

fn pat_matrix_new() -> PatternMatrix {
    PatternMatrix {
        rows: [pat_row_new(); 128],
        row_count: 0,
        column_count: 0,
    }
}

// ============================================================
// PatternMatrix: add row
// ============================================================

fn pat_matrix_add_row(matrix: PatternMatrix, row: PatternRow) -> PatternMatrix with Mut, Panic, Div {
    var m = matrix
    if m.row_count < 128 {
        m.rows[m.row_count as usize] = row
        m.row_count = m.row_count + 1
        if row.pattern_count > m.column_count {
            m.column_count = row.pattern_count
        }
    }
    m
}

// ============================================================
// PatternMatrix: get row
// ============================================================

fn pat_matrix_get_row(matrix: PatternMatrix, idx: i64) -> PatternRow with Panic, Div {
    matrix.rows[idx as usize]
}

// ============================================================
// CtorSet — set of constructors seen in a column
// ============================================================

struct CtorSet {
    ctors: [i64; 64],
    count: i64,
    is_complete: bool,
}

fn ctor_set_new() -> CtorSet {
    CtorSet {
        ctors: [0; 64],
        count: 0,
        is_complete: false,
    }
}

// ============================================================
// CtorSet: add a constructor (no duplicates)
// ============================================================

fn ctor_set_add(set: CtorSet, ctor: i64) -> CtorSet with Mut, Panic, Div {
    // Check if already present
    var i: i64 = 0
    while i < set.count {
        if set.ctors[i as usize] == ctor {
            return set
        }
        i = i + 1
    }
    var s = set
    if s.count < 64 {
        s.ctors[s.count as usize] = ctor
        s.count = s.count + 1
    }
    s
}

// ============================================================
// CtorSet: check membership
// ============================================================

fn ctor_set_contains(set: CtorSet, ctor: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < set.count {
        if set.ctors[i as usize] == ctor {
            return true
        }
        i = i + 1
    }
    false
}

// ============================================================
// Collect head constructors from the first column
// ============================================================

fn pat_collect_head_ctors(matrix: PatternMatrix, pool: PatternPool) -> CtorSet with Mut, Panic, Div {
    var set = ctor_set_new()
    var i: i64 = 0
    while i < matrix.row_count {
        let row = pat_matrix_get_row(matrix, i)
        if row.pattern_count > 0 {
            let pat_id = pat_row_get(row, 0)
            let kind = pool.kinds[pat_id as usize]
            if kind == PAT_LITERAL_INT {
                set = ctor_set_add(set, pool.values[pat_id as usize])
            } else if kind == PAT_LITERAL_BOOL {
                set = ctor_set_add(set, pool.values[pat_id as usize])
            } else if kind == PAT_VARIANT {
                set = ctor_set_add(set, pool.values[pat_id as usize])
            } else if kind == PAT_OR {
                // Recurse into or-pattern arms
                let left_id = pool.values[pat_id as usize]
                let right_id = pool.values2[pat_id as usize]
                let left_kind = pool.kinds[left_id as usize]
                let right_kind = pool.kinds[right_id as usize]
                if left_kind == PAT_VARIANT {
                    set = ctor_set_add(set, pool.values[left_id as usize])
                } else if left_kind == PAT_LITERAL_INT {
                    set = ctor_set_add(set, pool.values[left_id as usize])
                } else if left_kind == PAT_LITERAL_BOOL {
                    set = ctor_set_add(set, pool.values[left_id as usize])
                }
                if right_kind == PAT_VARIANT {
                    set = ctor_set_add(set, pool.values[right_id as usize])
                } else if right_kind == PAT_LITERAL_INT {
                    set = ctor_set_add(set, pool.values[right_id as usize])
                } else if right_kind == PAT_LITERAL_BOOL {
                    set = ctor_set_add(set, pool.values[right_id as usize])
                }
            }
            // Wildcards and bindings do not contribute constructors
        }
        i = i + 1
    }
    set
}

// ============================================================
// Specialize matrix for a given constructor
//
// For each row:
//   - If head pattern is ctor with matching tag: expand children + rest
//   - If head pattern is wildcard/binding: expand with `arity` wildcards + rest
//   - If head pattern is or-pattern: expand both arms
//   - Otherwise: skip the row
// ============================================================

fn pat_specialize(matrix: PatternMatrix, pool: PatternPool, ctor: i64, arity: i64) -> PatternMatrix with Mut, Panic, Div {
    var result = pat_matrix_new()
    var wildcard_id: i64 = 0 - 1

    // We need wildcard IDs for expansion; find or assume pool[0] is wildcard
    // In practice, callers ensure pool[0] = wildcard
    if pool.count > 0 && pool.kinds[0] == PAT_WILDCARD {
        wildcard_id = 0
    }

    var i: i64 = 0
    while i < matrix.row_count {
        let row = pat_matrix_get_row(matrix, i)
        if row.pattern_count == 0 {
            i = i + 1
            // Skip empty rows (should not happen)
        } else {
            let pat_id = pat_row_get(row, 0)
            let kind = pool.kinds[pat_id as usize]

            if kind == PAT_VARIANT && pool.values[pat_id as usize] == ctor {
                // Matching variant: expand sub-patterns
                let new_row = pat_row_expand_variant(row, pool, arity)
                result = pat_matrix_add_row(result, new_row)
            } else if kind == PAT_LITERAL_INT && pool.values[pat_id as usize] == ctor {
                // Matching int literal
                let new_row = pat_row_remove_first(row)
                result = pat_matrix_add_row(result, new_row)
            } else if kind == PAT_LITERAL_BOOL && pool.values[pat_id as usize] == ctor {
                // Matching bool literal
                let new_row = pat_row_remove_first(row)
                result = pat_matrix_add_row(result, new_row)
            } else if kind == PAT_WILDCARD || kind == PAT_BINDING {
                // Wildcard matches any constructor: expand with arity wildcards
                var new_row = pat_row_new()
                new_row.action_id = row.action_id
                var c: i64 = 0
                while c < arity {
                    if wildcard_id >= 0 {
                        new_row.patterns[c as usize] = wildcard_id
                    }
                    c = c + 1
                }
                // Copy remaining columns
                var j: i64 = 1
                while j < row.pattern_count {
                    new_row.patterns[(arity + j - 1) as usize] = row.patterns[j as usize]
                    j = j + 1
                }
                new_row.pattern_count = arity + row.pattern_count - 1
                result = pat_matrix_add_row(result, new_row)
            } else if kind == PAT_OR {
                // Or-pattern: try both arms
                let left_id = pool.values[pat_id as usize]
                let right_id = pool.values2[pat_id as usize]

                // Try left arm
                var left_row = row
                left_row.patterns[0] = left_id
                let left_kind = pool.kinds[left_id as usize]
                if left_kind == PAT_WILDCARD || left_kind == PAT_BINDING {
                    var nr = pat_row_new()
                    nr.action_id = row.action_id
                    var c2: i64 = 0
                    while c2 < arity {
                        if wildcard_id >= 0 {
                            nr.patterns[c2 as usize] = wildcard_id
                        }
                        c2 = c2 + 1
                    }
                    var j2: i64 = 1
                    while j2 < row.pattern_count {
                        nr.patterns[(arity + j2 - 1) as usize] = row.patterns[j2 as usize]
                        j2 = j2 + 1
                    }
                    nr.pattern_count = arity + row.pattern_count - 1
                    result = pat_matrix_add_row(result, nr)
                } else if left_kind == PAT_VARIANT && pool.values[left_id as usize] == ctor {
                    let nr2 = pat_row_expand_variant(left_row, pool, arity)
                    result = pat_matrix_add_row(result, nr2)
                } else if left_kind == PAT_LITERAL_INT && pool.values[left_id as usize] == ctor {
                    let nr3 = pat_row_remove_first(left_row)
                    result = pat_matrix_add_row(result, nr3)
                } else if left_kind == PAT_LITERAL_BOOL && pool.values[left_id as usize] == ctor {
                    let nr4 = pat_row_remove_first(left_row)
                    result = pat_matrix_add_row(result, nr4)
                }

                // Try right arm
                var right_row = row
                right_row.patterns[0] = right_id
                let right_kind = pool.kinds[right_id as usize]
                if right_kind == PAT_WILDCARD || right_kind == PAT_BINDING {
                    var nr5 = pat_row_new()
                    nr5.action_id = row.action_id
                    var c3: i64 = 0
                    while c3 < arity {
                        if wildcard_id >= 0 {
                            nr5.patterns[c3 as usize] = wildcard_id
                        }
                        c3 = c3 + 1
                    }
                    var j3: i64 = 1
                    while j3 < row.pattern_count {
                        nr5.patterns[(arity + j3 - 1) as usize] = row.patterns[j3 as usize]
                        j3 = j3 + 1
                    }
                    nr5.pattern_count = arity + row.pattern_count - 1
                    result = pat_matrix_add_row(result, nr5)
                } else if right_kind == PAT_VARIANT && pool.values[right_id as usize] == ctor {
                    let nr6 = pat_row_expand_variant(right_row, pool, arity)
                    result = pat_matrix_add_row(result, nr6)
                } else if right_kind == PAT_LITERAL_INT && pool.values[right_id as usize] == ctor {
                    let nr7 = pat_row_remove_first(right_row)
                    result = pat_matrix_add_row(result, nr7)
                } else if right_kind == PAT_LITERAL_BOOL && pool.values[right_id as usize] == ctor {
                    let nr8 = pat_row_remove_first(right_row)
                    result = pat_matrix_add_row(result, nr8)
                }
            }
            // All other patterns: skip row (does not match constructor)
            i = i + 1
        }
    }
    result
}

// ============================================================
// Default matrix (rows whose first column is wildcard/binding)
// ============================================================

fn pat_default_matrix(matrix: PatternMatrix, pool: PatternPool) -> PatternMatrix with Mut, Panic, Div {
    var result = pat_matrix_new()
    var i: i64 = 0
    while i < matrix.row_count {
        let row = pat_matrix_get_row(matrix, i)
        if row.pattern_count > 0 {
            let pat_id = pat_row_get(row, 0)
            let kind = pool.kinds[pat_id as usize]
            if kind == PAT_WILDCARD || kind == PAT_BINDING {
                let new_row = pat_row_remove_first(row)
                result = pat_matrix_add_row(result, new_row)
            } else if kind == PAT_OR {
                // Or-pattern: include if either arm is wildcard-like
                let left_id = pool.values[pat_id as usize]
                let right_id = pool.values2[pat_id as usize]
                if pat_is_wildcard_like(pool, left_id) || pat_is_wildcard_like(pool, right_id) {
                    let new_row2 = pat_row_remove_first(row)
                    result = pat_matrix_add_row(result, new_row2)
                }
            }
        }
        i = i + 1
    }
    result
}

// ============================================================
// Exhaustiveness checking (recursive)
//
// type_ctor_count: total number of constructors for the scrutinee
//   type in the first column (e.g. 2 for bool, N for an enum with
//   N variants). Use 0 or a large number for open types like i64.
// ============================================================

fn pat_is_exhaustive(matrix: PatternMatrix, pool: PatternPool, type_ctor_count: i64) -> bool with Mut, Panic, Div {
    // Base case: no columns left -> exhaustive iff at least one row
    if matrix.column_count == 0 {
        return matrix.row_count > 0
    }

    // Base case: no rows -> not exhaustive (nothing matches)
    if matrix.row_count == 0 {
        return false
    }

    // Collect constructors in the first column
    let head_ctors = pat_collect_head_ctors(matrix, pool)

    // Check if all constructors of the type are present
    if head_ctors.count >= type_ctor_count && type_ctor_count > 0 {
        // Complete: check each constructor's specialization
        var c: i64 = 0
        while c < head_ctors.count {
            let ctor = head_ctors.ctors[c as usize]
            let specialized = pat_specialize(matrix, pool, ctor, 0)
            if !pat_is_exhaustive(specialized, pool, 0) {
                return false
            }
            c = c + 1
        }
        return true
    } else {
        // Incomplete set or open type: check the default matrix
        let def = pat_default_matrix(matrix, pool)
        return pat_is_exhaustive(def, pool, 0)
    }
}

// ============================================================
// Find a missing constructor (returns ctor value or -1)
// ============================================================

fn pat_find_missing(matrix: PatternMatrix, pool: PatternPool, type_ctor_count: i64) -> i64 with Mut, Panic, Div {
    if matrix.column_count == 0 {
        if matrix.row_count > 0 {
            return 0 - 1
        } else {
            // No rows = everything is missing; return 0 as placeholder
            return 0
        }
    }

    if matrix.row_count == 0 {
        return 0
    }

    let head_ctors = pat_collect_head_ctors(matrix, pool)

    // Check each expected constructor
    var c: i64 = 0
    while c < type_ctor_count {
        if !ctor_set_contains(head_ctors, c) {
            return c
        }
        c = c + 1
    }

    // All constructors present; recurse into default
    let def = pat_default_matrix(matrix, pool)
    pat_find_missing(def, pool, 0)
}

// ============================================================
// Usefulness checking
//
// A row (pattern vector) q is useful with respect to matrix P
// iff there exists a value matched by q that is not matched by
// any row in P.
// ============================================================

fn pat_is_useful(matrix: PatternMatrix, pool: PatternPool, new_row: PatternRow, type_ctor_count: i64) -> bool with Mut, Panic, Div {
    // Base: no columns -> useful iff matrix has no rows
    if new_row.pattern_count == 0 {
        return matrix.row_count == 0
    }

    // Look at the first pattern in new_row
    let q_pat_id = pat_row_get(new_row, 0)
    let q_kind = pool.kinds[q_pat_id as usize]

    if q_kind == PAT_VARIANT {
        let tag = pool.values[q_pat_id as usize]
        let arity = pool.child_counts[q_pat_id as usize]
        let spec_matrix = pat_specialize(matrix, pool, tag, arity)
        let spec_row = pat_row_expand_variant(new_row, pool, arity)
        return pat_is_useful(spec_matrix, pool, spec_row, 0)
    } else if q_kind == PAT_LITERAL_INT || q_kind == PAT_LITERAL_BOOL {
        let val = pool.values[q_pat_id as usize]
        let spec_matrix2 = pat_specialize(matrix, pool, val, 0)
        let spec_row2 = pat_row_remove_first(new_row)
        return pat_is_useful(spec_matrix2, pool, spec_row2, 0)
    } else if q_kind == PAT_OR {
        // Or-pattern: useful if either arm is useful
        let left_id = pool.values[q_pat_id as usize]
        let right_id = pool.values2[q_pat_id as usize]
        var left_row = new_row
        left_row.patterns[0] = left_id
        var right_row = new_row
        right_row.patterns[0] = right_id
        if pat_is_useful(matrix, pool, left_row, type_ctor_count) {
            return true
        }
        return pat_is_useful(matrix, pool, right_row, type_ctor_count)
    } else {
        // Wildcard / binding
        let head_ctors = pat_collect_head_ctors(matrix, pool)

        if head_ctors.count >= type_ctor_count && type_ctor_count > 0 {
            // Complete constructor set: check each constructor
            var c: i64 = 0
            while c < head_ctors.count {
                let ctor2 = head_ctors.ctors[c as usize]
                let spec3 = pat_specialize(matrix, pool, ctor2, 0)
                // New row with wildcard: just remove first column
                let spec_row3 = pat_row_remove_first(new_row)
                if pat_is_useful(spec3, pool, spec_row3, 0) {
                    return true
                }
                c = c + 1
            }
            return false
        } else {
            // Incomplete: use default matrix
            let def = pat_default_matrix(matrix, pool)
            let def_row = pat_row_remove_first(new_row)
            return pat_is_useful(def, pool, def_row, 0)
        }
    }
}

// ============================================================
// Find first redundant row (returns row index or -1)
// ============================================================

fn pat_find_redundant(matrix: PatternMatrix, pool: PatternPool, type_ctor_count: i64) -> i64 with Mut, Panic, Div {
    // Build matrix incrementally; check each row against preceding rows
    var built = pat_matrix_new()
    built.column_count = matrix.column_count

    var i: i64 = 0
    while i < matrix.row_count {
        let row = pat_matrix_get_row(matrix, i)
        if !pat_is_useful(built, pool, row, type_ctor_count) {
            return i
        }
        built = pat_matrix_add_row(built, row)
        i = i + 1
    }
    0 - 1
}

// ============================================================
// Decision tree for compiled pattern matches
// ============================================================
//
// DecisionTree encodes a tree as a flat array of nodes.
// Each node is 4 i64 values:
//   [kind, column_or_action, child_offset, child_count]
//
// DECISION_LEAF: action = column_or_action
// DECISION_SWITCH: column = column_or_action, children at child_offset
// DECISION_FAIL: indicates match failure

struct DecisionTree {
    nodes: [i64; 2048],
    node_count: i64,
}

fn decision_tree_new() -> DecisionTree {
    DecisionTree {
        nodes: [0; 2048],
        node_count: 0,
    }
}

// ============================================================
// DecisionTree: add a leaf node
// ============================================================

fn decision_tree_add_leaf(tree: DecisionTree, action: i64) -> (DecisionTree, i64) with Mut, Panic, Div {
    var t = tree
    let idx = t.node_count
    let base = idx * 4
    t.nodes[base as usize] = DECISION_LEAF
    t.nodes[(base + 1) as usize] = action
    t.nodes[(base + 2) as usize] = 0
    t.nodes[(base + 3) as usize] = 0
    t.node_count = t.node_count + 1
    (t, idx)
}

// ============================================================
// DecisionTree: add a fail node
// ============================================================

fn decision_tree_add_fail(tree: DecisionTree) -> (DecisionTree, i64) with Mut, Panic, Div {
    var t = tree
    let idx = t.node_count
    let base = idx * 4
    t.nodes[base as usize] = DECISION_FAIL
    t.nodes[(base + 1) as usize] = 0
    t.nodes[(base + 2) as usize] = 0
    t.nodes[(base + 3) as usize] = 0
    t.node_count = t.node_count + 1
    (t, idx)
}

// ============================================================
// DecisionTree: add a switch node
// ============================================================

fn decision_tree_add_switch(tree: DecisionTree, column: i64, child_offset: i64, child_count: i64) -> (DecisionTree, i64) with Mut, Panic, Div {
    var t = tree
    let idx = t.node_count
    let base = idx * 4
    t.nodes[base as usize] = DECISION_SWITCH
    t.nodes[(base + 1) as usize] = column
    t.nodes[(base + 2) as usize] = child_offset
    t.nodes[(base + 3) as usize] = child_count
    t.node_count = t.node_count + 1
    (t, idx)
}

// ============================================================
// DecisionTree: get node kind
// ============================================================

fn decision_tree_node_kind(tree: DecisionTree, idx: i64) -> i64 with Panic, Div {
    tree.nodes[(idx * 4) as usize]
}

// ============================================================
// DecisionTree: get node action (for leaf nodes)
// ============================================================

fn decision_tree_node_action(tree: DecisionTree, idx: i64) -> i64 with Panic, Div {
    tree.nodes[(idx * 4 + 1) as usize]
}

// ============================================================
// Compile pattern matrix to decision tree
//
// Simple strategy: pick first column, switch on head constructors,
// recurse into specializations.
// ============================================================

fn pat_compile_to_decision_tree(matrix: PatternMatrix, pool: PatternPool) -> DecisionTree with Mut, Panic, Div {
    var tree = decision_tree_new()
    let result = pat_compile_node(tree, matrix, pool)
    result.0
}

fn pat_compile_node(tree: DecisionTree, matrix: PatternMatrix, pool: PatternPool) -> (DecisionTree, i64) with Mut, Panic, Div {
    // No rows: fail
    if matrix.row_count == 0 {
        return decision_tree_add_fail(tree)
    }

    // No columns: leaf with first row's action
    if matrix.column_count == 0 {
        let row = pat_matrix_get_row(matrix, 0)
        return decision_tree_add_leaf(tree, row.action_id)
    }

    // Check if first row's first pattern is wildcard -> immediate leaf
    let first_row = pat_matrix_get_row(matrix, 0)
    let first_pat = pat_row_get(first_row, 0)
    if pat_is_wildcard_like(pool, first_pat) {
        // Check if ALL rows start with wildcards (single-column trivial case)
        var all_wild = true
        var k: i64 = 0
        while k < matrix.row_count {
            let rk = pat_matrix_get_row(matrix, k)
            let pk = pat_row_get(rk, 0)
            if !pat_is_wildcard_like(pool, pk) {
                all_wild = false
            }
            k = k + 1
        }
        if all_wild && matrix.column_count == 1 {
            return decision_tree_add_leaf(tree, first_row.action_id)
        }
    }

    // Collect head constructors
    let head_ctors = pat_collect_head_ctors(matrix, pool)

    if head_ctors.count == 0 {
        // All wildcards in first column: recurse on default matrix
        let def = pat_default_matrix(matrix, pool)
        return pat_compile_node(tree, def, pool)
    }

    // Build switch node: one child per constructor + optional default
    let child_start = tree.node_count + 1  // reserve space for the switch itself
    var t = tree
    var child_indices: [i64; 64] = [0; 64]
    var num_children: i64 = 0

    var c: i64 = 0
    while c < head_ctors.count {
        let ctor = head_ctors.ctors[c as usize]
        let spec = pat_specialize(matrix, pool, ctor, 0)
        let result = pat_compile_node(t, spec, pool)
        t = result.0
        child_indices[c as usize] = result.1
        num_children = num_children + 1
        c = c + 1
    }

    // Add default branch
    let def2 = pat_default_matrix(matrix, pool)
    if def2.row_count > 0 {
        let def_result = pat_compile_node(t, def2, pool)
        t = def_result.0
        child_indices[num_children as usize] = def_result.1
        num_children = num_children + 1
    }

    // Now create the switch node pointing to children
    let switch_result = decision_tree_add_switch(t, 0, child_indices[0], num_children)
    switch_result
}

// ============================================================
// Test helpers
// ============================================================

fn assert_true(cond: bool, test_id: i64) -> i64 with IO, Mut, Panic, Div {
    if cond {
        print("  PASS test ")
        print_int(test_id)
        print("\n")
        return 0
    } else {
        print("  FAIL test ")
        print_int(test_id)
        print("\n")
        return 1
    }
}

// ============================================================
// Test 1: Empty matrix is not exhaustive
// ============================================================

fn test_empty_not_exhaustive() -> i64 with IO, Mut, Panic, Div {
    let pool_pair = pat_pool_add_wildcard(pat_pool_new())
    let pool = pool_pair.0
    let matrix = pat_matrix_new()
    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(!result, 1)
}

// ============================================================
// Test 2: Single wildcard row is exhaustive
// ============================================================

fn test_wildcard_exhaustive() -> i64 with IO, Mut, Panic, Div {
    let pool_pair = pat_pool_add_wildcard(pat_pool_new())
    let pool = pool_pair.0
    let wc_id = pool_pair.1

    var row = pat_row_with_action(0)
    row = pat_row_set(row, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row)

    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(result, 2)
}

// ============================================================
// Test 3: Bool exhaustive (true + false covers all)
// ============================================================

fn test_bool_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    // id 0: wildcard (needed for specialization)
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    // id 1: true (value=1)
    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    // id 2: false (value=0)
    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)

    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, false_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    let result = pat_is_exhaustive(matrix, pool, 2)
    assert_true(result, 3)
}

// ============================================================
// Test 4: Bool NOT exhaustive (only true)
// ============================================================

fn test_bool_not_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let result = pat_is_exhaustive(matrix, pool, 2)
    assert_true(!result, 4)
}

// ============================================================
// Test 5: Find missing constructor in bool match (only true)
// ============================================================

fn test_find_missing_bool() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let missing = pat_find_missing(matrix, pool, 2)
    // Missing should be 0 (false)
    assert_true(missing == 0, 5)
}

// ============================================================
// Test 6: Variant exhaustiveness (3-variant enum, all covered)
// ============================================================

fn test_variant_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let empty_children: [i64; 16] = [0; 16]

    let pair1 = pat_pool_add_variant(pool, 0, empty_children, 0)
    pool = pair1.0
    let v0 = pair1.1

    let pair2 = pat_pool_add_variant(pool, 1, empty_children, 0)
    pool = pair2.0
    let v1 = pair2.1

    let pair3 = pat_pool_add_variant(pool, 2, empty_children, 0)
    pool = pair3.0
    let v2 = pair3.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, v0)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, v1)
    var row3 = pat_row_with_action(2)
    row3 = pat_row_set(row3, 0, v2)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)
    matrix = pat_matrix_add_row(matrix, row3)

    let result = pat_is_exhaustive(matrix, pool, 3)
    assert_true(result, 6)
}

// ============================================================
// Test 7: Missing variant detection (3-variant, only 2 covered)
// ============================================================

fn test_missing_variant() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let empty_children: [i64; 16] = [0; 16]

    let pair1 = pat_pool_add_variant(pool, 0, empty_children, 0)
    pool = pair1.0
    let v0 = pair1.1

    let pair2 = pat_pool_add_variant(pool, 2, empty_children, 0)
    pool = pair2.0
    let v2 = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, v0)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, v2)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    let missing = pat_find_missing(matrix, pool, 3)
    // Variant tag 1 is missing
    assert_true(missing == 1, 7)
}

// ============================================================
// Test 8: Redundant pattern detection (duplicate wildcard)
// ============================================================

fn test_redundant_wildcard() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    // Rows: true, false, _  (third is redundant)
    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, false_id)
    var row3 = pat_row_with_action(2)
    row3 = pat_row_set(row3, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)
    matrix = pat_matrix_add_row(matrix, row3)

    let redundant = pat_find_redundant(matrix, pool, 2)
    // Row 2 (index 2) is redundant
    assert_true(redundant == 2, 8)
}

// ============================================================
// Test 9: No redundant patterns
// ============================================================

fn test_no_redundant() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, false_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    let redundant = pat_find_redundant(matrix, pool, 2)
    assert_true(redundant == 0 - 1, 9)
}

// ============================================================
// Test 10: Specialization correctness (bool true)
// ============================================================

fn test_specialize_bool() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    // Matrix: row0=[true], row1=[false], row2=[_]
    var row1 = pat_row_with_action(10)
    row1 = pat_row_set(row1, 0, true_id)
    var row2 = pat_row_with_action(20)
    row2 = pat_row_set(row2, 0, false_id)
    var row3 = pat_row_with_action(30)
    row3 = pat_row_set(row3, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)
    matrix = pat_matrix_add_row(matrix, row3)

    // Specialize for true (value=1)
    let spec = pat_specialize(matrix, pool, 1, 0)
    // Should have rows: row0 (true matches) + row2 (wildcard matches) = 2 rows
    // Actions: 10 and 30
    let ok1 = spec.row_count == 2
    let r0 = pat_matrix_get_row(spec, 0)
    let r1 = pat_matrix_get_row(spec, 1)
    let ok2 = r0.action_id == 10
    let ok3 = r1.action_id == 30
    assert_true(ok1 && ok2 && ok3, 10)
}

// ============================================================
// Test 11: Default matrix correctness
// ============================================================

fn test_default_matrix() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    // Matrix: row0=[true], row1=[_]
    var row1 = pat_row_with_action(10)
    row1 = pat_row_set(row1, 0, true_id)
    var row2 = pat_row_with_action(20)
    row2 = pat_row_set(row2, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    let def = pat_default_matrix(matrix, pool)
    // Only row1 (wildcard) should be in the default, action=20
    let ok1 = def.row_count == 1
    let r0 = pat_matrix_get_row(def, 0)
    let ok2 = r0.action_id == 20
    assert_true(ok1 && ok2, 11)
}

// ============================================================
// Test 12: Binding treated as wildcard for exhaustiveness
// ============================================================

fn test_binding_as_wildcard() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_binding(pool)
    pool = pair1.0
    let bind_id = pair1.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, bind_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(result, 12)
}

// ============================================================
// Test 13: Or-pattern exhaustiveness (true | false covers bool)
// ============================================================

fn test_or_pattern_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    let pair3 = pat_pool_add_or(pool, true_id, false_id)
    pool = pair3.0
    let or_id = pair3.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, or_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let result = pat_is_exhaustive(matrix, pool, 2)
    assert_true(result, 13)
}

// ============================================================
// Test 14: Or-pattern NOT exhaustive (true | true, missing false)
// ============================================================

fn test_or_pattern_not_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    // Or with duplicate: true | true
    let pair2 = pat_pool_add_or(pool, true_id, true_id)
    pool = pair2.0
    let or_id = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, or_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let result = pat_is_exhaustive(matrix, pool, 2)
    assert_true(!result, 14)
}

// ============================================================
// Test 15: Usefulness — wildcard after exhaustive bool is NOT useful
// ============================================================

fn test_usefulness_redundant_after_bool() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    // Matrix with true and false
    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, false_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    // New row: wildcard — should NOT be useful
    var new_row = pat_row_with_action(2)
    new_row = pat_row_set(new_row, 0, wc_id)

    let useful = pat_is_useful(matrix, pool, new_row, 2)
    assert_true(!useful, 15)
}

// ============================================================
// Test 16: Usefulness — false is useful when only true exists
// ============================================================

fn test_usefulness_false_after_true() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_bool(pool, 1)
    pool = pair1.0
    let true_id = pair1.1

    let pair2 = pat_pool_add_literal_bool(pool, 0)
    pool = pair2.0
    let false_id = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, true_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    var new_row = pat_row_with_action(1)
    new_row = pat_row_set(new_row, 0, false_id)

    let useful = pat_is_useful(matrix, pool, new_row, 2)
    assert_true(useful, 16)
}

// ============================================================
// Test 17: Decision tree — single wildcard produces leaf
// ============================================================

fn test_decision_tree_leaf() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    var row1 = pat_row_with_action(42)
    row1 = pat_row_set(row1, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    let tree = pat_compile_to_decision_tree(matrix, pool)
    // Should have at least one node, and it should be a leaf
    let ok1 = tree.node_count >= 1
    // Find the root node (last one added by compile)
    let root_idx = tree.node_count - 1
    let kind = decision_tree_node_kind(tree, root_idx)
    let ok2 = kind == DECISION_LEAF
    let action = decision_tree_node_action(tree, root_idx)
    let ok3 = action == 42
    assert_true(ok1 && ok2 && ok3, 17)
}

// ============================================================
// Test 18: Int literal patterns (two ints, no exhaustiveness)
// ============================================================

fn test_int_literal_not_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_int(pool, 0)
    pool = pair1.0
    let zero_id = pair1.1

    let pair2 = pat_pool_add_literal_int(pool, 1)
    pool = pair2.0
    let one_id = pair2.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, zero_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, one_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    // i64 is an open type, so 2 literals cannot be exhaustive
    // (type_ctor_count=0 means open type, checked via default matrix)
    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(!result, 18)
}

// ============================================================
// Test 19: Int literals + wildcard IS exhaustive
// ============================================================

fn test_int_with_wildcard_exhaustive() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    let pair1 = pat_pool_add_literal_int(pool, 42)
    pool = pair1.0
    let forty_two_id = pair1.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, forty_two_id)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)

    let result = pat_is_exhaustive(matrix, pool, 0)
    assert_true(result, 19)
}

// ============================================================
// Test 20: Duplicate int literal is redundant
// ============================================================

fn test_duplicate_int_redundant() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_int(pool, 5)
    pool = pair1.0
    let five_a = pair1.1

    let pair2 = pat_pool_add_literal_int(pool, 5)
    pool = pair2.0
    let five_b = pair2.1

    let pair3 = pat_pool_add_wildcard(pool)
    pool = pair3.0
    let wc_id = pair3.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, five_a)
    var row2 = pat_row_with_action(1)
    row2 = pat_row_set(row2, 0, five_b)
    var row3 = pat_row_with_action(2)
    row3 = pat_row_set(row3, 0, wc_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)
    matrix = pat_matrix_add_row(matrix, row2)
    matrix = pat_matrix_add_row(matrix, row3)

    let redundant = pat_find_redundant(matrix, pool, 0)
    // Row 1 (second literal 5) is redundant
    assert_true(redundant == 1, 20)
}

// ============================================================
// Test 21: Or-pattern usefulness
// ============================================================

fn test_or_pattern_usefulness() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let pair1 = pat_pool_add_literal_int(pool, 1)
    pool = pair1.0
    let one_id = pair1.1

    let pair2 = pat_pool_add_literal_int(pool, 2)
    pool = pair2.0
    let two_id = pair2.1

    let pair3 = pat_pool_add_literal_int(pool, 3)
    pool = pair3.0
    let three_id = pair3.1

    // Matrix: 1 | 2
    let pair4 = pat_pool_add_or(pool, one_id, two_id)
    pool = pair4.0
    let or_id = pair4.1

    var row1 = pat_row_with_action(0)
    row1 = pat_row_set(row1, 0, or_id)

    var matrix = pat_matrix_new()
    matrix.column_count = 1
    matrix = pat_matrix_add_row(matrix, row1)

    // New row: 3 should be useful
    var new_row = pat_row_with_action(1)
    new_row = pat_row_set(new_row, 0, three_id)

    let useful = pat_is_useful(matrix, pool, new_row, 0)
    assert_true(useful, 21)
}

// ============================================================
// Test 22: Pool child access correctness
// ============================================================

fn test_pool_children() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()

    // Add a wildcard at index 0
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0
    let wc_id = pair0.1

    // Add a variant with 2 children (both wildcard)
    var children: [i64; 16] = [0; 16]
    children[0] = wc_id
    children[1] = wc_id
    let pair1 = pat_pool_add_variant(pool, 5, children, 2)
    pool = pair1.0
    let var_id = pair1.1

    // Check child access
    let c0 = pat_pool_get_child(pool, var_id, 0)
    let c1 = pat_pool_get_child(pool, var_id, 1)
    let ok1 = c0 == wc_id
    let ok2 = c1 == wc_id
    let ok3 = pool.child_counts[var_id as usize] == 2
    let ok4 = pool.values[var_id as usize] == 5
    assert_true(ok1 && ok2 && ok3 && ok4, 22)
}

// ============================================================
// Test 23: Decision tree — empty matrix produces fail
// ============================================================

fn test_decision_tree_fail() -> i64 with IO, Mut, Panic, Div {
    var pool = pat_pool_new()
    let pair0 = pat_pool_add_wildcard(pool)
    pool = pair0.0

    let matrix = pat_matrix_new()
    let tree = pat_compile_to_decision_tree(matrix, pool)
    let ok1 = tree.node_count >= 1
    let root_idx = tree.node_count - 1
    let kind = decision_tree_node_kind(tree, root_idx)
    let ok2 = kind == DECISION_FAIL
    assert_true(ok1 && ok2, 23)
}

// ============================================================
// Test runner
// ============================================================

fn pattern_check_run_tests() -> i64 with IO, Mut, Panic, Div {
    print("=== Pattern check tests ===\n")
    var fails: i64 = 0
    fails = fails + test_empty_not_exhaustive()
    fails = fails + test_wildcard_exhaustive()
    fails = fails + test_bool_exhaustive()
    fails = fails + test_bool_not_exhaustive()
    fails = fails + test_find_missing_bool()
    fails = fails + test_variant_exhaustive()
    fails = fails + test_missing_variant()
    fails = fails + test_redundant_wildcard()
    fails = fails + test_no_redundant()
    fails = fails + test_specialize_bool()
    fails = fails + test_default_matrix()
    fails = fails + test_binding_as_wildcard()
    fails = fails + test_or_pattern_exhaustive()
    fails = fails + test_or_pattern_not_exhaustive()
    fails = fails + test_usefulness_redundant_after_bool()
    fails = fails + test_usefulness_false_after_true()
    fails = fails + test_decision_tree_leaf()
    fails = fails + test_int_literal_not_exhaustive()
    fails = fails + test_int_with_wildcard_exhaustive()
    fails = fails + test_duplicate_int_redundant()
    fails = fails + test_or_pattern_usefulness()
    fails = fails + test_pool_children()
    fails = fails + test_decision_tree_fail()

    print("Total failures: ")
    print_int(fails)
    print("\n")
    fails
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/infer.sio  (1491 lines)
// ════════════════════════════════════════════════════════════════

// Hindley-Milner type inference engine for the self-hosted checker
//
// Implements Algorithm W-style constraint-based type inference with:
//   - Type variable allocation and substitution
//   - First-order unification with occurs check
//   - Let-polymorphism via generalize/instantiate
//   - Environment-based type lookup
//
// All types are stored as integer IDs into a flat TypePool arena.
// Substitutions are explicit maps from type-variable IDs to type IDs.

// ============================================================
// Type kind constants
// ============================================================

const TYPE_VAR: i64 = 100
const TYPE_INT: i64 = 1
const TYPE_FLOAT: i64 = 2
const TYPE_BOOL: i64 = 3
const TYPE_STRING: i64 = 4
const TYPE_UNIT: i64 = 5
const TYPE_FN: i64 = 10
const TYPE_ARRAY: i64 = 11
const TYPE_TUPLE: i64 = 12
const TYPE_STRUCT: i64 = 13

// Binary operator tags for infer_binary_op
const OP_ADD: i64 = 1
const OP_SUB: i64 = 2
const OP_MUL: i64 = 3
const OP_DIV: i64 = 4
const OP_EQ: i64 = 5
const OP_NEQ: i64 = 6
const OP_LT: i64 = 7
const OP_GT: i64 = 8
const OP_AND: i64 = 9
const OP_OR: i64 = 10

// Sentinel for "not found" or "error"
const TYPE_NONE: i64 = 0 - 1

// ============================================================
// TypeNode — a single node in the type pool
// ============================================================
//
// kind:      one of the TYPE_* constants above
// id:        unique index in the pool (also used as type-variable ID)
// args:      child type IDs (e.g. domain/codomain for TYPE_FN,
//            element type for TYPE_ARRAY, fields for TYPE_TUPLE)
// arg_count: how many entries in args are meaningful
// name:      packed i64 for named types / struct tags

struct TypeNode {
    kind: i64,
    id: i64,
    args: [i64; 8],
    arg_count: i64,
    name: i64,
}

fn empty_type_node() -> TypeNode {
    TypeNode {
        kind: 0,
        id: 0,
        args: [0; 8],
        arg_count: 0,
        name: 0,
    }
}

// ============================================================
// TypePool — arena of TypeNodes
// ============================================================

struct TypePool {
    nodes: [TypeNode; 2048],
    count: i64,
    next_var_id: i64,
}

fn type_pool_new() -> TypePool {
    TypePool {
        nodes: [empty_type_node(); 2048],
        count: 0,
        next_var_id: 1000,
    }
}

// ============================================================
// TypePool helpers — allocate nodes
// ============================================================

fn pool_alloc(pool: TypePool, kind: i64, name: i64) -> (TypePool, i64) with Mut, Panic, Div {
    var p = pool
    let idx = p.count
    p.nodes[idx as usize] = TypeNode {
        kind: kind,
        id: idx,
        args: [0; 8],
        arg_count: 0,
        name: name,
    }
    p.count = p.count + 1
    (p, idx)
}

fn pool_alloc_with_args(pool: TypePool, kind: i64, name: i64, a0: i64, a1: i64, argc: i64) -> (TypePool, i64) with Mut, Panic, Div {
    var p = pool
    let idx = p.count
    var args: [i64; 8] = [0; 8]
    args[0] = a0
    args[1] = a1
    p.nodes[idx as usize] = TypeNode {
        kind: kind,
        id: idx,
        args: args,
        arg_count: argc,
        name: name,
    }
    p.count = p.count + 1
    (p, idx)
}

fn pool_alloc_var(pool: TypePool) -> (TypePool, i64) with Mut, Panic, Div {
    var p = pool
    let idx = p.count
    let vid = p.next_var_id
    p.nodes[idx as usize] = TypeNode {
        kind: TYPE_VAR,
        id: idx,
        args: [0; 8],
        arg_count: 0,
        name: vid,
    }
    p.count = p.count + 1
    p.next_var_id = p.next_var_id + 1
    (p, idx)
}

fn pool_get(pool: TypePool, idx: i64) -> TypeNode with Mut, Panic, Div {
    pool.nodes[idx as usize]
}

fn pool_kind(pool: TypePool, idx: i64) -> i64 with Mut, Panic, Div {
    pool.nodes[idx as usize].kind
}

fn pool_var_name(pool: TypePool, idx: i64) -> i64 with Mut, Panic, Div {
    pool.nodes[idx as usize].name
}

fn pool_arg(pool: TypePool, idx: i64, n: i64) -> i64 with Mut, Panic, Div {
    pool.nodes[idx as usize].args[n as usize]
}

fn pool_arg_count(pool: TypePool, idx: i64) -> i64 with Mut, Panic, Div {
    pool.nodes[idx as usize].arg_count
}

// Allocate concrete primitives
fn pool_alloc_int(pool: TypePool) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc(pool, TYPE_INT, 0)
}

fn pool_alloc_float(pool: TypePool) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc(pool, TYPE_FLOAT, 0)
}

fn pool_alloc_bool(pool: TypePool) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc(pool, TYPE_BOOL, 0)
}

fn pool_alloc_string(pool: TypePool) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc(pool, TYPE_STRING, 0)
}

fn pool_alloc_unit(pool: TypePool) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc(pool, TYPE_UNIT, 0)
}

// Allocate function type: domain -> codomain
fn pool_alloc_fn(pool: TypePool, domain: i64, codomain: i64) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc_with_args(pool, TYPE_FN, 0, domain, codomain, 2)
}

// Allocate array type: [elem; _]
fn pool_alloc_array(pool: TypePool, elem: i64) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc_with_args(pool, TYPE_ARRAY, 0, elem, 0, 1)
}

// Allocate tuple type with 2 elements
fn pool_alloc_tuple2(pool: TypePool, a: i64, b: i64) -> (TypePool, i64) with Mut, Panic, Div {
    pool_alloc_with_args(pool, TYPE_TUPLE, 0, a, b, 2)
}

// ============================================================
// Substitution — maps type variable IDs to type IDs
// ============================================================

struct Substitution {
    from_ids: [i64; 1024],
    to_ids: [i64; 1024],
    count: i64,
}

fn subst_new() -> Substitution {
    Substitution {
        from_ids: [0; 1024],
        to_ids: [0; 1024],
        count: 0,
    }
}

fn subst_add(subst: Substitution, from: i64, to: i64) -> Substitution with Mut, Panic, Div {
    var s = subst
    // Check if mapping already exists; if so, update it
    var i: i64 = 0
    while i < s.count {
        if s.from_ids[i as usize] == from {
            s.to_ids[i as usize] = to
            return s
        }
        i = i + 1
    }
    // New mapping
    if s.count < 1024 {
        s.from_ids[s.count as usize] = from
        s.to_ids[s.count as usize] = to
        s.count = s.count + 1
    }
    s
}

fn subst_lookup(subst: Substitution, var_name: i64) -> i64 with Mut, Panic, Div {
    var i: i64 = 0
    while i < subst.count {
        if subst.from_ids[i as usize] == var_name {
            return subst.to_ids[i as usize]
        }
        i = i + 1
    }
    TYPE_NONE
}

// Apply a substitution to a type, producing a new type in the pool.
// If the type is a variable and the substitution maps it, return the mapped type.
// For compound types (fn, array, tuple), recursively apply to children.
fn subst_apply(subst: Substitution, pool: TypePool, type_id: i64) -> (TypePool, i64) with Mut, Panic, Div {
    if type_id < 0 {
        return (pool, type_id)
    }
    if type_id >= pool.count {
        return (pool, type_id)
    }
    let node = pool_get(pool, type_id)
    if node.kind == TYPE_VAR {
        let mapped = subst_lookup(subst, node.name)
        if mapped != TYPE_NONE {
            // Recursively apply in case the target is also a variable
            return subst_apply(subst, pool, mapped)
        }
        return (pool, type_id)
    }
    if node.kind == TYPE_FN {
        let pair_d = subst_apply(subst, pool, node.args[0])
        var p = pair_d.0
        let dom = pair_d.1
        let pair_c = subst_apply(subst, p, node.args[1])
        p = pair_c.0
        let cod = pair_c.1
        // If nothing changed, return original
        if dom == node.args[0] && cod == node.args[1] {
            return (p, type_id)
        }
        return pool_alloc_fn(p, dom, cod)
    }
    if node.kind == TYPE_ARRAY {
        let pair_e = subst_apply(subst, pool, node.args[0])
        var p2 = pair_e.0
        let elem = pair_e.1
        if elem == node.args[0] {
            return (p2, type_id)
        }
        return pool_alloc_array(p2, elem)
    }
    if node.kind == TYPE_TUPLE {
        let pair_a = subst_apply(subst, pool, node.args[0])
        var p3 = pair_a.0
        let ta = pair_a.1
        let pair_b = subst_apply(subst, p3, node.args[1])
        p3 = pair_b.0
        let tb = pair_b.1
        if ta == node.args[0] && tb == node.args[1] {
            return (p3, type_id)
        }
        return pool_alloc_tuple2(p3, ta, tb)
    }
    // Concrete primitive — no substitution needed
    (pool, type_id)
}

// Compose two substitutions: applying the result is equivalent to
// applying s2 first and then s1.  s1 . s2 = { v -> s1(s2(v)) }
fn subst_compose(s1: Substitution, s2: Substitution, pool: TypePool) -> (Substitution, TypePool) with Mut, Panic, Div {
    var result = subst_new()
    var p = pool

    // For each mapping in s2, apply s1 to its target
    var i: i64 = 0
    while i < s2.count {
        let from = s2.from_ids[i as usize]
        let to = s2.to_ids[i as usize]
        let pair = subst_apply(s1, p, to)
        p = pair.0
        let new_to = pair.1
        result = subst_add(result, from, new_to)
        i = i + 1
    }

    // Add mappings from s1 that are not already in the composed result
    var j: i64 = 0
    while j < s1.count {
        let from1 = s1.from_ids[j as usize]
        let existing = subst_lookup(result, from1)
        if existing == TYPE_NONE {
            result = subst_add(result, from1, s1.to_ids[j as usize])
        }
        j = j + 1
    }

    (result, p)
}

// ============================================================
// UnifyResult — outcome of unification
// ============================================================

struct UnifyResult {
    ok: bool,
    subst: Substitution,
    error_a: i64,
    error_b: i64,
}

fn unify_ok(s: Substitution) -> UnifyResult {
    UnifyResult {
        ok: true,
        subst: s,
        error_a: TYPE_NONE,
        error_b: TYPE_NONE,
    }
}

fn unify_err(a: i64, b: i64) -> UnifyResult {
    UnifyResult {
        ok: false,
        subst: subst_new(),
        error_a: a,
        error_b: b,
    }
}

// ============================================================
// Occurs check — prevent infinite types
// ============================================================
//
// Returns true if var_name (the name field of a TYPE_VAR node)
// appears anywhere inside the type at type_id.

fn occurs_check(pool: TypePool, var_name: i64, type_id: i64) -> bool with Mut, Panic, Div {
    if type_id < 0 {
        return false
    }
    if type_id >= pool.count {
        return false
    }
    let node = pool_get(pool, type_id)
    if node.kind == TYPE_VAR {
        return node.name == var_name
    }
    if node.kind == TYPE_FN {
        if occurs_check(pool, var_name, node.args[0]) {
            return true
        }
        return occurs_check(pool, var_name, node.args[1])
    }
    if node.kind == TYPE_ARRAY {
        return occurs_check(pool, var_name, node.args[0])
    }
    if node.kind == TYPE_TUPLE {
        if occurs_check(pool, var_name, node.args[0]) {
            return true
        }
        return occurs_check(pool, var_name, node.args[1])
    }
    false
}

// ============================================================
// Unification — Robinson's algorithm
// ============================================================

// Unify argument lists of equal length.
fn unify_args(pool: TypePool, a_id: i64, b_id: i64, count: i64) -> (UnifyResult, TypePool) with Mut, Panic, Div {
    if count <= 0 {
        return (unify_ok(subst_new()), pool)
    }
    let a_node = pool_get(pool, a_id)
    let b_node = pool_get(pool, b_id)

    // Unify first argument pair
    var p = pool
    let r0 = unify(p, a_node.args[0], b_node.args[0])
    p = r0.1
    let u0 = r0.0
    if !u0.ok {
        return (u0, p)
    }
    if count == 1 {
        return (u0, p)
    }

    // Apply substitution from first pair to the rest, then unify second pair
    let pair_a1 = subst_apply(u0.subst, p, a_node.args[1])
    p = pair_a1.0
    let a1_resolved = pair_a1.1
    let pair_b1 = subst_apply(u0.subst, p, b_node.args[1])
    p = pair_b1.0
    let b1_resolved = pair_b1.1
    let r1 = unify(p, a1_resolved, b1_resolved)
    p = r1.1
    let u1 = r1.0
    if !u1.ok {
        return (u1, p)
    }

    // Compose substitutions
    let composed = subst_compose(u1.subst, u0.subst, p)
    p = composed.1
    (unify_ok(composed.0), p)
}

// Main unification: returns (UnifyResult, TypePool) because substitution
// application may allocate new type nodes.
fn unify(pool: TypePool, type_a: i64, type_b: i64) -> (UnifyResult, TypePool) with Mut, Panic, Div {
    var p = pool

    // Trivial: same type ID
    if type_a == type_b {
        return (unify_ok(subst_new()), p)
    }

    // Bounds check
    if type_a < 0 || type_a >= p.count {
        return (unify_err(type_a, type_b), p)
    }
    if type_b < 0 || type_b >= p.count {
        return (unify_err(type_a, type_b), p)
    }

    let a = pool_get(p, type_a)
    let b = pool_get(p, type_b)

    // Variable on the left
    if a.kind == TYPE_VAR {
        if occurs_check(p, a.name, type_b) {
            return (unify_err(type_a, type_b), p)
        }
        let s = subst_add(subst_new(), a.name, type_b)
        return (unify_ok(s), p)
    }

    // Variable on the right
    if b.kind == TYPE_VAR {
        if occurs_check(p, b.name, type_a) {
            return (unify_err(type_a, type_b), p)
        }
        let s = subst_add(subst_new(), b.name, type_a)
        return (unify_ok(s), p)
    }

    // Both concrete — kinds must match
    if a.kind != b.kind {
        return (unify_err(type_a, type_b), p)
    }

    // Primitives with no args: INT, FLOAT, BOOL, STRING, UNIT
    if a.kind == TYPE_INT || a.kind == TYPE_FLOAT || a.kind == TYPE_BOOL || a.kind == TYPE_STRING || a.kind == TYPE_UNIT {
        return (unify_ok(subst_new()), p)
    }

    // Struct types: names must match
    if a.kind == TYPE_STRUCT {
        if a.name != b.name {
            return (unify_err(type_a, type_b), p)
        }
        return (unify_ok(subst_new()), p)
    }

    // Function types: unify domain, then codomain
    if a.kind == TYPE_FN {
        return unify_args(p, type_a, type_b, 2)
    }

    // Array types: unify element type
    if a.kind == TYPE_ARRAY {
        return unify(p, a.args[0], b.args[0])
    }

    // Tuple types: unify element-wise
    if a.kind == TYPE_TUPLE {
        if a.arg_count != b.arg_count {
            return (unify_err(type_a, type_b), p)
        }
        return unify_args(p, type_a, type_b, a.arg_count)
    }

    // Unknown kind — fail
    (unify_err(type_a, type_b), p)
}

// ============================================================
// InferCtx — type inference context
// ============================================================
//
// Carries the pool, current substitution, and a name-to-type
// environment for variable bindings.

struct InferCtx {
    pool: TypePool,
    subst: Substitution,
    env_names: [i64; 512],
    env_types: [i64; 512],
    env_count: i64,
}

fn infer_ctx_new() -> InferCtx {
    InferCtx {
        pool: type_pool_new(),
        subst: subst_new(),
        env_names: [0; 512],
        env_types: [0; 512],
        env_count: 0,
    }
}

// Allocate a fresh type variable, returning updated context and type ID
fn infer_fresh_var(ctx: InferCtx) -> (InferCtx, i64) with Mut, Panic, Div {
    let pair = pool_alloc_var(ctx.pool)
    var c = ctx
    c.pool = pair.0
    (c, pair.1)
}

// Bind a name to a type in the environment
fn infer_bind(ctx: InferCtx, name: i64, type_id: i64) -> InferCtx with Mut, Panic, Div {
    var c = ctx
    if c.env_count < 512 {
        c.env_names[c.env_count as usize] = name
        c.env_types[c.env_count as usize] = type_id
        c.env_count = c.env_count + 1
    }
    c
}

// Look up a name in the environment (most recent binding wins)
fn infer_lookup(ctx: InferCtx, name: i64) -> i64 with Mut, Panic, Div {
    var i = ctx.env_count - 1
    while i >= 0 {
        if ctx.env_names[i as usize] == name {
            return ctx.env_types[i as usize]
        }
        i = i - 1
    }
    TYPE_NONE
}

// ============================================================
// Inference helpers for literals
// ============================================================

fn infer_literal_int(ctx: InferCtx) -> (InferCtx, i64) with Mut, Panic, Div {
    let pair = pool_alloc_int(ctx.pool)
    var c = ctx
    c.pool = pair.0
    (c, pair.1)
}

fn infer_literal_float(ctx: InferCtx) -> (InferCtx, i64) with Mut, Panic, Div {
    let pair = pool_alloc_float(ctx.pool)
    var c = ctx
    c.pool = pair.0
    (c, pair.1)
}

fn infer_literal_bool(ctx: InferCtx) -> (InferCtx, i64) with Mut, Panic, Div {
    let pair = pool_alloc_bool(ctx.pool)
    var c = ctx
    c.pool = pair.0
    (c, pair.1)
}

fn infer_literal_string(ctx: InferCtx) -> (InferCtx, i64) with Mut, Panic, Div {
    let pair = pool_alloc_string(ctx.pool)
    var c = ctx
    c.pool = pair.0
    (c, pair.1)
}

fn infer_literal_unit(ctx: InferCtx) -> (InferCtx, i64) with Mut, Panic, Div {
    let pair = pool_alloc_unit(ctx.pool)
    var c = ctx
    c.pool = pair.0
    (c, pair.1)
}

// ============================================================
// Binary operator inference
// ============================================================
//
// Arithmetic ops (+, -, *, /): unify both operands, result = operand type
// Comparison ops (==, !=, <, >): unify both operands, result = bool
// Logical ops (&&, ||): both must be bool, result = bool

fn infer_binary_op(ctx: InferCtx, op: i64, lhs_type: i64, rhs_type: i64) -> (InferCtx, i64) with Mut, Panic, Div {
    var c = ctx
    // Unify operands
    let r = unify(c.pool, lhs_type, rhs_type)
    c.pool = r.1
    let ur = r.0
    if !ur.ok {
        // Type error: operands do not unify
        // Return TYPE_NONE to signal error
        return (c, TYPE_NONE)
    }
    // Merge substitution
    let comp = subst_compose(ur.subst, c.subst, c.pool)
    c.subst = comp.0
    c.pool = comp.1

    // Resolve the operand type after substitution
    let resolved_pair = subst_apply(c.subst, c.pool, lhs_type)
    c.pool = resolved_pair.0
    let resolved_type = resolved_pair.1

    // Determine result type based on operator class
    if op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV {
        // Arithmetic: result is the unified operand type
        return (c, resolved_type)
    }
    if op == OP_EQ || op == OP_NEQ || op == OP_LT || op == OP_GT {
        // Comparison: result is always bool
        let bp = pool_alloc_bool(c.pool)
        c.pool = bp.0
        return (c, bp.1)
    }
    if op == OP_AND || op == OP_OR {
        // Logical: operands must be bool, result is bool
        let bp2 = pool_alloc_bool(c.pool)
        c.pool = bp2.0
        let bool_id = bp2.1
        let ru = unify(c.pool, resolved_type, bool_id)
        c.pool = ru.1
        if !ru.0.ok {
            return (c, TYPE_NONE)
        }
        let comp2 = subst_compose(ru.0.subst, c.subst, c.pool)
        c.subst = comp2.0
        c.pool = comp2.1
        return (c, bool_id)
    }
    // Unknown operator
    (c, TYPE_NONE)
}

// ============================================================
// Function application inference
// ============================================================
//
// Given a function type and an argument type:
//   1. Unify the function's domain with the argument type
//   2. Return the function's codomain with substitutions applied

fn infer_application(ctx: InferCtx, fn_type: i64, arg_type: i64) -> (InferCtx, i64) with Mut, Panic, Div {
    var c = ctx

    // Check that fn_type is indeed a function type
    if fn_type < 0 || fn_type >= c.pool.count {
        return (c, TYPE_NONE)
    }
    let fn_node = pool_get(c.pool, fn_type)
    if fn_node.kind != TYPE_FN {
        // Not a function type — cannot apply
        return (c, TYPE_NONE)
    }

    let domain = fn_node.args[0]
    let codomain = fn_node.args[1]

    // Unify domain with argument
    let r = unify(c.pool, domain, arg_type)
    c.pool = r.1
    let ur = r.0
    if !ur.ok {
        return (c, TYPE_NONE)
    }

    // Compose with existing substitution
    let comp = subst_compose(ur.subst, c.subst, c.pool)
    c.subst = comp.0
    c.pool = comp.1

    // Apply composed substitution to the codomain
    let resolved = subst_apply(c.subst, c.pool, codomain)
    c.pool = resolved.0
    (c, resolved.1)
}

// ============================================================
// Let-binding inference
// ============================================================

fn infer_let_binding(ctx: InferCtx, name: i64, expr_type: i64) -> InferCtx with Mut, Panic, Div {
    infer_bind(ctx, name, expr_type)
}

// ============================================================
// Free variables
// ============================================================
//
// Collect all type variable names reachable from a type.
// Returns a flat array of variable names and a count via FreeVarsResult.

struct FreeVarsResult {
    vars: [i64; 64],
    count: i64,
}

fn free_vars_empty() -> FreeVarsResult {
    FreeVarsResult {
        vars: [0; 64],
        count: 0,
    }
}

fn free_vars_add(fv: FreeVarsResult, var_name: i64) -> FreeVarsResult with Mut, Panic, Div {
    // Check for duplicates
    var i: i64 = 0
    while i < fv.count {
        if fv.vars[i as usize] == var_name {
            return fv
        }
        i = i + 1
    }
    var result = fv
    if result.count < 64 {
        result.vars[result.count as usize] = var_name
        result.count = result.count + 1
    }
    result
}

fn free_vars_merge(a: FreeVarsResult, b: FreeVarsResult) -> FreeVarsResult with Mut, Panic, Div {
    var result = a
    var i: i64 = 0
    while i < b.count {
        result = free_vars_add(result, b.vars[i as usize])
        i = i + 1
    }
    result
}

fn free_vars(pool: TypePool, type_id: i64) -> FreeVarsResult with Mut, Panic, Div {
    if type_id < 0 || type_id >= pool.count {
        return free_vars_empty()
    }
    let node = pool_get(pool, type_id)
    if node.kind == TYPE_VAR {
        return free_vars_add(free_vars_empty(), node.name)
    }
    if node.kind == TYPE_FN {
        let fv_d = free_vars(pool, node.args[0])
        let fv_c = free_vars(pool, node.args[1])
        return free_vars_merge(fv_d, fv_c)
    }
    if node.kind == TYPE_ARRAY {
        return free_vars(pool, node.args[0])
    }
    if node.kind == TYPE_TUPLE {
        let fv_a = free_vars(pool, node.args[0])
        let fv_b = free_vars(pool, node.args[1])
        return free_vars_merge(fv_a, fv_b)
    }
    // Concrete type — no free variables
    free_vars_empty()
}

// ============================================================
// Generalization
// ============================================================
//
// Generalize a type over all free variables that are NOT free in the
// environment.  This is the key to let-polymorphism.
//
// For simplicity in this flat-array representation, generalization
// marks the type ID as a "scheme" by recording which variables are
// universally quantified.  We store the scheme as:
//   SchemeEntry { type_id, bound_vars, bound_count }

struct SchemeEntry {
    type_id: i64,
    bound_vars: [i64; 64],
    bound_count: i64,
}

fn scheme_mono(type_id: i64) -> SchemeEntry {
    SchemeEntry {
        type_id: type_id,
        bound_vars: [0; 64],
        bound_count: 0,
    }
}

// Collect free variables from the entire environment
fn env_free_vars(ctx: InferCtx) -> FreeVarsResult with Mut, Panic, Div {
    var result = free_vars_empty()
    var i: i64 = 0
    while i < ctx.env_count {
        let fv = free_vars(ctx.pool, ctx.env_types[i as usize])
        result = free_vars_merge(result, fv)
        i = i + 1
    }
    result
}

fn free_vars_contains(fv: FreeVarsResult, var_name: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < fv.count {
        if fv.vars[i as usize] == var_name {
            return true
        }
        i = i + 1
    }
    false
}

fn generalize(ctx: InferCtx, type_id: i64) -> SchemeEntry with Mut, Panic, Div {
    let ty_fv = free_vars(ctx.pool, type_id)
    let env_fv = env_free_vars(ctx)
    var scheme = scheme_mono(type_id)
    var i: i64 = 0
    while i < ty_fv.count {
        let v = ty_fv.vars[i as usize]
        if !free_vars_contains(env_fv, v) {
            if scheme.bound_count < 64 {
                scheme.bound_vars[scheme.bound_count as usize] = v
                scheme.bound_count = scheme.bound_count + 1
            }
        }
        i = i + 1
    }
    scheme
}

// ============================================================
// Instantiation
// ============================================================
//
// Replace each bound variable in a scheme with a fresh type variable.
// Returns the instantiated type ID.

fn instantiate(ctx: InferCtx, scheme: SchemeEntry) -> (InferCtx, i64) with Mut, Panic, Div {
    if scheme.bound_count == 0 {
        return (ctx, scheme.type_id)
    }
    var c = ctx
    var rename = subst_new()
    var i: i64 = 0
    while i < scheme.bound_count {
        let old_var = scheme.bound_vars[i as usize]
        let pair = pool_alloc_var(c.pool)
        c.pool = pair.0
        let fresh_id = pair.1
        rename = subst_add(rename, old_var, fresh_id)
        i = i + 1
    }
    let result = subst_apply(rename, c.pool, scheme.type_id)
    c.pool = result.0
    (c, result.1)
}

// ============================================================
// Scheme-aware environment
// ============================================================
//
// For let-polymorphism we need to store schemes, not just type IDs.
// SchemeEnv wraps InferCtx with a parallel scheme table.

struct SchemeEnv {
    ctx: InferCtx,
    scheme_names: [i64; 512],
    schemes: [SchemeEntry; 512],
    scheme_count: i64,
}

fn scheme_env_new() -> SchemeEnv {
    SchemeEnv {
        ctx: infer_ctx_new(),
        scheme_names: [0; 512],
        schemes: [scheme_mono(0); 512],
        scheme_count: 0,
    }
}

fn scheme_env_bind(env: SchemeEnv, name: i64, scheme: SchemeEntry) -> SchemeEnv with Mut, Panic, Div {
    var e = env
    if e.scheme_count < 512 {
        e.scheme_names[e.scheme_count as usize] = name
        e.schemes[e.scheme_count as usize] = scheme
        e.scheme_count = e.scheme_count + 1
    }
    // Also bind in the underlying ctx for free-var calculation
    e.ctx = infer_bind(e.ctx, name, scheme.type_id)
    e
}

fn scheme_env_lookup(env: SchemeEnv, name: i64) -> SchemeEntry with Mut, Panic, Div {
    var i = env.scheme_count - 1
    while i >= 0 {
        if env.scheme_names[i as usize] == name {
            return env.schemes[i as usize]
        }
        i = i - 1
    }
    scheme_mono(TYPE_NONE)
}

fn scheme_env_instantiate(env: SchemeEnv, name: i64) -> (SchemeEnv, i64) with Mut, Panic, Div {
    let scheme = scheme_env_lookup(env, name)
    if scheme.type_id == TYPE_NONE {
        return (env, TYPE_NONE)
    }
    let pair = instantiate(env.ctx, scheme)
    var e = env
    e.ctx = pair.0
    (e, pair.1)
}

// ============================================================
// INLINE TESTS
// ============================================================

// --- Test 1: Fresh variable allocation ---
fn infer_test_fresh_var() -> bool with Mut, Panic, Div {
    let pair1 = infer_fresh_var(infer_ctx_new())
    var ctx = pair1.0
    let v1 = pair1.1
    let pair2 = infer_fresh_var(ctx)
    ctx = pair2.0
    let v2 = pair2.1
    // Two fresh vars should have different IDs
    let ok1 = v1 != v2
    // Both should be TYPE_VAR
    let ok2 = pool_kind(ctx.pool, v1) == TYPE_VAR
    let ok3 = pool_kind(ctx.pool, v2) == TYPE_VAR
    // They should have different names
    let ok4 = pool_var_name(ctx.pool, v1) != pool_var_name(ctx.pool, v2)
    ok1 && ok2 && ok3 && ok4
}

// --- Test 2: Unify two identical concrete types ---
fn infer_test_unify_same_concrete() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let p1 = pool_alloc_int(ctx.pool)
    ctx.pool = p1.0
    let t1 = p1.1
    let p2 = pool_alloc_int(ctx.pool)
    ctx.pool = p2.0
    let t2 = p2.1
    let r = unify(ctx.pool, t1, t2)
    r.0.ok
}

// --- Test 3: Unify two different concrete types fails ---
fn infer_test_unify_different_concrete() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let p1 = pool_alloc_int(ctx.pool)
    ctx.pool = p1.0
    let t1 = p1.1
    let p2 = pool_alloc_bool(ctx.pool)
    ctx.pool = p2.0
    let t2 = p2.1
    let r = unify(ctx.pool, t1, t2)
    !r.0.ok
}

// --- Test 4: Unify type variable with concrete ---
fn infer_test_unify_var_concrete() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let pv = pool_alloc_var(ctx.pool)
    ctx.pool = pv.0
    let tv = pv.1
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    let r = unify(ctx.pool, tv, ti)
    let ur = r.0
    // Should succeed
    let ok1 = ur.ok
    // Substitution should map the variable to int
    let var_name = pool_var_name(ctx.pool, tv)
    let mapped = subst_lookup(ur.subst, var_name)
    let ok2 = mapped == ti
    ok1 && ok2
}

// --- Test 5: Unify two type variables ---
fn infer_test_unify_two_vars() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let pv1 = pool_alloc_var(ctx.pool)
    ctx.pool = pv1.0
    let v1 = pv1.1
    let pv2 = pool_alloc_var(ctx.pool)
    ctx.pool = pv2.0
    let v2 = pv2.1
    let r = unify(ctx.pool, v1, v2)
    // Should succeed: one variable maps to the other
    r.0.ok
}

// --- Test 6: Occurs check detects infinite type ---
fn infer_test_occurs_check() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create a type variable 'a
    let pv = pool_alloc_var(ctx.pool)
    ctx.pool = pv.0
    let va = pv.1
    let va_name = pool_var_name(ctx.pool, va)
    // Create int
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    // Create fn(int, 'a) — 'a appears in this type
    let pf = pool_alloc_fn(ctx.pool, ti, va)
    ctx.pool = pf.0
    let fn_type = pf.1
    // occurs_check should detect 'a inside fn(int, 'a)
    let ok1 = occurs_check(ctx.pool, va_name, fn_type)
    // occurs_check should NOT detect 'a inside int
    let ok2 = !occurs_check(ctx.pool, va_name, ti)
    ok1 && ok2
}

// --- Test 7: Occurs check blocks unification (infinite type) ---
fn infer_test_occurs_unify_fails() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create 'a
    let pv = pool_alloc_var(ctx.pool)
    ctx.pool = pv.0
    let va = pv.1
    // Create fn('a, int) — contains 'a
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    let pf = pool_alloc_fn(ctx.pool, va, ti)
    ctx.pool = pf.0
    let fn_type = pf.1
    // Trying to unify 'a with fn('a, int) should fail (infinite type)
    let r = unify(ctx.pool, va, fn_type)
    !r.0.ok
}

// --- Test 8: Function type inference (application) ---
fn infer_test_fn_application() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create fn(int) -> bool
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    let pb = pool_alloc_bool(ctx.pool)
    ctx.pool = pb.0
    let tb = pb.1
    let pf = pool_alloc_fn(ctx.pool, ti, tb)
    ctx.pool = pf.0
    let fn_type = pf.1
    // Create an int argument
    let pai = pool_alloc_int(ctx.pool)
    ctx.pool = pai.0
    let arg_int = pai.1
    // Apply fn to int
    let result = infer_application(ctx, fn_type, arg_int)
    var c = result.0
    let result_type = result.1
    // Result should be bool
    let ok1 = result_type != TYPE_NONE
    let ok2 = pool_kind(c.pool, result_type) == TYPE_BOOL
    ok1 && ok2
}

// --- Test 9: Function application with type variable ---
fn infer_test_fn_app_with_var() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create 'a
    let pv = pool_alloc_var(ctx.pool)
    ctx.pool = pv.0
    let va = pv.1
    // Create fn('a) -> 'a  (identity function)
    let pf = pool_alloc_fn(ctx.pool, va, va)
    ctx.pool = pf.0
    let fn_type = pf.1
    // Create int argument
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let arg_int = pi.1
    // Apply identity to int
    let result = infer_application(ctx, fn_type, arg_int)
    var c = result.0
    let result_type = result.1
    // Result should resolve to int (via substitution 'a -> int)
    let ok1 = result_type != TYPE_NONE
    // Apply full substitution to resolve
    let resolved = subst_apply(c.subst, c.pool, result_type)
    c.pool = resolved.0
    let final_type = resolved.1
    let ok2 = pool_kind(c.pool, final_type) == TYPE_INT
    ok1 && ok2
}

// --- Test 10: Binary operator type checking ---
fn infer_test_binary_add() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let p1 = pool_alloc_int(ctx.pool)
    ctx.pool = p1.0
    let t1 = p1.1
    let p2 = pool_alloc_int(ctx.pool)
    ctx.pool = p2.0
    let t2 = p2.1
    let result = infer_binary_op(ctx, OP_ADD, t1, t2)
    var c = result.0
    let rt = result.1
    let ok1 = rt != TYPE_NONE
    let ok2 = pool_kind(c.pool, rt) == TYPE_INT
    ok1 && ok2
}

// --- Test 11: Binary comparison returns bool ---
fn infer_test_binary_eq() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let p1 = pool_alloc_int(ctx.pool)
    ctx.pool = p1.0
    let t1 = p1.1
    let p2 = pool_alloc_int(ctx.pool)
    ctx.pool = p2.0
    let t2 = p2.1
    let result = infer_binary_op(ctx, OP_EQ, t1, t2)
    var c = result.0
    let rt = result.1
    let ok1 = rt != TYPE_NONE
    let ok2 = pool_kind(c.pool, rt) == TYPE_BOOL
    ok1 && ok2
}

// --- Test 12: Binary type mismatch fails ---
fn infer_test_binary_mismatch() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let p1 = pool_alloc_int(ctx.pool)
    ctx.pool = p1.0
    let t1 = p1.1
    let p2 = pool_alloc_bool(ctx.pool)
    ctx.pool = p2.0
    let t2 = p2.1
    let result = infer_binary_op(ctx, OP_ADD, t1, t2)
    // Should signal error
    result.1 == TYPE_NONE
}

// --- Test 13: Let-binding and lookup ---
fn infer_test_let_lookup() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    // Bind name 42 (arbitrary tag) to int type
    ctx = infer_let_binding(ctx, 42, ti)
    let looked = infer_lookup(ctx, 42)
    let ok1 = looked == ti
    // Missing name returns TYPE_NONE
    let ok2 = infer_lookup(ctx, 999) == TYPE_NONE
    ok1 && ok2
}

// --- Test 14: Substitution composition ---
fn infer_test_subst_compose() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create 'a, 'b, and int
    let pva = pool_alloc_var(ctx.pool)
    ctx.pool = pva.0
    let va = pva.1
    let va_name = pool_var_name(ctx.pool, va)
    let pvb = pool_alloc_var(ctx.pool)
    ctx.pool = pvb.0
    let vb = pvb.1
    let vb_name = pool_var_name(ctx.pool, vb)
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    // s1: 'b -> int
    let s1 = subst_add(subst_new(), vb_name, ti)
    // s2: 'a -> 'b
    let s2 = subst_add(subst_new(), va_name, vb)
    // Compose: s1 . s2 should give 'a -> int (because 'a -> 'b -> int)
    let comp = subst_compose(s1, s2, ctx.pool)
    let composed = comp.0
    ctx.pool = comp.1
    // Apply to 'a: should get int
    let result = subst_apply(composed, ctx.pool, va)
    ctx.pool = result.0
    let resolved = result.1
    pool_kind(ctx.pool, resolved) == TYPE_INT
}

// --- Test 15: Free variables collection ---
fn infer_test_free_vars() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create fn('a, 'b) where 'a and 'b are type variables
    let pva = pool_alloc_var(ctx.pool)
    ctx.pool = pva.0
    let va = pva.1
    let pvb = pool_alloc_var(ctx.pool)
    ctx.pool = pvb.0
    let vb = pvb.1
    let pf = pool_alloc_fn(ctx.pool, va, vb)
    ctx.pool = pf.0
    let fn_type = pf.1
    let fv = free_vars(ctx.pool, fn_type)
    // Should have exactly 2 free variables
    fv.count == 2
}

// --- Test 16: Generalize captures unbound vars ---
fn infer_test_generalize() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create 'a -> 'a (identity type)
    let pva = pool_alloc_var(ctx.pool)
    ctx.pool = pva.0
    let va = pva.1
    let pf = pool_alloc_fn(ctx.pool, va, va)
    ctx.pool = pf.0
    let fn_type = pf.1
    // Empty environment => both vars are free => generalize captures them
    let scheme = generalize(ctx, fn_type)
    // The identity fn has 1 distinct variable, so bound_count should be 1
    scheme.bound_count == 1
}

// --- Test 17: Instantiate produces fresh vars ---
fn infer_test_instantiate() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create 'a -> 'a
    let pva = pool_alloc_var(ctx.pool)
    ctx.pool = pva.0
    let va = pva.1
    let va_name = pool_var_name(ctx.pool, va)
    let pf = pool_alloc_fn(ctx.pool, va, va)
    ctx.pool = pf.0
    let fn_type = pf.1
    // Generalize
    let scheme = generalize(ctx, fn_type)
    // Instantiate
    let pair = instantiate(ctx, scheme)
    var c = pair.0
    let inst_type = pair.1
    // The instantiated type should be a function
    let ok1 = pool_kind(c.pool, inst_type) == TYPE_FN
    // Its domain should be a fresh variable (different name from original)
    let dom = pool_arg(c.pool, inst_type, 0)
    let ok2 = pool_kind(c.pool, dom) == TYPE_VAR
    let new_name = pool_var_name(c.pool, dom)
    let ok3 = new_name != va_name
    ok1 && ok2 && ok3
}

// --- Test 18: Let polymorphism ---
fn infer_test_let_poly() -> bool with Mut, Panic, Div {
    // Simulate: let id = fn('a) -> 'a  (polymorphic identity)
    // Then apply id to int => int, apply id to bool => bool
    var env = scheme_env_new()

    // Create the identity type: 'a -> 'a
    let pva = pool_alloc_var(env.ctx.pool)
    env.ctx.pool = pva.0
    let va = pva.1
    let pf = pool_alloc_fn(env.ctx.pool, va, va)
    env.ctx.pool = pf.0
    let id_type = pf.1

    // Generalize and bind as "id" (name tag = 1)
    let scheme = generalize(env.ctx, id_type)
    env = scheme_env_bind(env, 1, scheme)

    // Instantiate and apply to int
    let inst1 = scheme_env_instantiate(env, 1)
    env = inst1.0
    let id_inst1 = inst1.1
    let pi = pool_alloc_int(env.ctx.pool)
    env.ctx.pool = pi.0
    let ti = pi.1
    let app1 = infer_application(env.ctx, id_inst1, ti)
    env.ctx = app1.0
    let res1 = app1.1
    let resolved1 = subst_apply(env.ctx.subst, env.ctx.pool, res1)
    env.ctx.pool = resolved1.0
    let ok1 = pool_kind(env.ctx.pool, resolved1.1) == TYPE_INT

    // Instantiate AGAIN and apply to bool
    let inst2 = scheme_env_instantiate(env, 1)
    env = inst2.0
    let id_inst2 = inst2.1
    let pb = pool_alloc_bool(env.ctx.pool)
    env.ctx.pool = pb.0
    let tb = pb.1
    let app2 = infer_application(env.ctx, id_inst2, tb)
    env.ctx = app2.0
    let res2 = app2.1
    let resolved2 = subst_apply(env.ctx.subst, env.ctx.pool, res2)
    env.ctx.pool = resolved2.0
    let ok2 = pool_kind(env.ctx.pool, resolved2.1) == TYPE_BOOL

    // Both should work — this is the essence of let-polymorphism
    ok1 && ok2
}

// --- Test 19: Unify function types ---
fn infer_test_unify_fn_types() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // fn(int) -> bool
    let pi1 = pool_alloc_int(ctx.pool)
    ctx.pool = pi1.0
    let t_int1 = pi1.1
    let pb1 = pool_alloc_bool(ctx.pool)
    ctx.pool = pb1.0
    let t_bool1 = pb1.1
    let pf1 = pool_alloc_fn(ctx.pool, t_int1, t_bool1)
    ctx.pool = pf1.0
    let fn1 = pf1.1

    // fn('a) -> 'b  (with fresh variables)
    let pva = pool_alloc_var(ctx.pool)
    ctx.pool = pva.0
    let va = pva.1
    let pvb = pool_alloc_var(ctx.pool)
    ctx.pool = pvb.0
    let vb = pvb.1
    let pf2 = pool_alloc_fn(ctx.pool, va, vb)
    ctx.pool = pf2.0
    let fn2 = pf2.1

    // Unify fn(int)->bool with fn('a)->'b
    let r = unify(ctx.pool, fn1, fn2)
    ctx.pool = r.1
    let ur = r.0
    let ok1 = ur.ok

    // 'a should map to int, 'b should map to bool
    let va_name = pool_var_name(ctx.pool, va)
    let vb_name = pool_var_name(ctx.pool, vb)
    let a_mapped = subst_lookup(ur.subst, va_name)
    let b_mapped = subst_lookup(ur.subst, vb_name)
    let ok2 = pool_kind(ctx.pool, a_mapped) == TYPE_INT
    let ok3 = pool_kind(ctx.pool, b_mapped) == TYPE_BOOL
    ok1 && ok2 && ok3
}

// --- Test 20: Substitution apply to nested type ---
fn infer_test_subst_nested() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    // Create 'a
    let pva = pool_alloc_var(ctx.pool)
    ctx.pool = pva.0
    let va = pva.1
    let va_name = pool_var_name(ctx.pool, va)
    // Create fn('a, 'a)
    let pf = pool_alloc_fn(ctx.pool, va, va)
    ctx.pool = pf.0
    let fn_type = pf.1
    // Create int
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    // Substitution: 'a -> int
    let s = subst_add(subst_new(), va_name, ti)
    // Apply to fn('a, 'a) => fn(int, int)
    let result = subst_apply(s, ctx.pool, fn_type)
    ctx.pool = result.0
    let resolved = result.1
    // Result should be a function type
    let ok1 = pool_kind(ctx.pool, resolved) == TYPE_FN
    // Domain should be int
    let dom = pool_arg(ctx.pool, resolved, 0)
    let ok2 = pool_kind(ctx.pool, dom) == TYPE_INT
    // Codomain should be int
    let cod = pool_arg(ctx.pool, resolved, 1)
    let ok3 = pool_kind(ctx.pool, cod) == TYPE_INT
    ok1 && ok2 && ok3
}

// --- Test 21: Logical operator requires bool ---
fn infer_test_logical_op() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let p1 = pool_alloc_bool(ctx.pool)
    ctx.pool = p1.0
    let b1 = p1.1
    let p2 = pool_alloc_bool(ctx.pool)
    ctx.pool = p2.0
    let b2 = p2.1
    // bool && bool => bool
    let result = infer_binary_op(ctx, OP_AND, b1, b2)
    var c = result.0
    let rt = result.1
    let ok1 = rt != TYPE_NONE
    let ok2 = pool_kind(c.pool, rt) == TYPE_BOOL
    ok1 && ok2
}

// --- Test 22: Logical operator with non-bool fails ---
fn infer_test_logical_op_mismatch() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let p1 = pool_alloc_int(ctx.pool)
    ctx.pool = p1.0
    let t1 = p1.1
    let p2 = pool_alloc_int(ctx.pool)
    ctx.pool = p2.0
    let t2 = p2.1
    // int && int => should fail (operands not bool)
    let result = infer_binary_op(ctx, OP_AND, t1, t2)
    result.1 == TYPE_NONE
}

// --- Test 23: Application to non-function fails ---
fn infer_test_app_non_fn() -> bool with Mut, Panic, Div {
    var ctx = infer_ctx_new()
    let pi = pool_alloc_int(ctx.pool)
    ctx.pool = pi.0
    let ti = pi.1
    // Trying to apply int as a function should fail
    let result = infer_application(ctx, ti, ti)
    result.1 == TYPE_NONE
}

// ============================================================
// Test runner
// ============================================================

fn infer_run_tests() -> i64 with IO, Mut, Panic, Div {
    var passed: i64 = 0
    let total: i64 = 23

    print("=== HM Type Inference Tests ===\n")

    if infer_test_fresh_var() { passed = passed + 1; print("  T01 OK: fresh variable allocation\n") } else { print("  FAIL: T01 fresh variable allocation\n") }
    if infer_test_unify_same_concrete() { passed = passed + 1; print("  T02 OK: unify identical concrete types\n") } else { print("  FAIL: T02 unify identical concrete types\n") }
    if infer_test_unify_different_concrete() { passed = passed + 1; print("  T03 OK: unify different concrete types fails\n") } else { print("  FAIL: T03 unify different concrete types fails\n") }
    if infer_test_unify_var_concrete() { passed = passed + 1; print("  T04 OK: unify var with concrete\n") } else { print("  FAIL: T04 unify var with concrete\n") }
    if infer_test_unify_two_vars() { passed = passed + 1; print("  T05 OK: unify two type variables\n") } else { print("  FAIL: T05 unify two type variables\n") }
    if infer_test_occurs_check() { passed = passed + 1; print("  T06 OK: occurs check detection\n") } else { print("  FAIL: T06 occurs check detection\n") }
    if infer_test_occurs_unify_fails() { passed = passed + 1; print("  T07 OK: occurs check blocks infinite type\n") } else { print("  FAIL: T07 occurs check blocks infinite type\n") }
    if infer_test_fn_application() { passed = passed + 1; print("  T08 OK: function application\n") } else { print("  FAIL: T08 function application\n") }
    if infer_test_fn_app_with_var() { passed = passed + 1; print("  T09 OK: fn application with type var\n") } else { print("  FAIL: T09 fn application with type var\n") }
    if infer_test_binary_add() { passed = passed + 1; print("  T10 OK: binary add int + int\n") } else { print("  FAIL: T10 binary add int + int\n") }
    if infer_test_binary_eq() { passed = passed + 1; print("  T11 OK: binary eq returns bool\n") } else { print("  FAIL: T11 binary eq returns bool\n") }
    if infer_test_binary_mismatch() { passed = passed + 1; print("  T12 OK: binary op type mismatch\n") } else { print("  FAIL: T12 binary op type mismatch\n") }
    if infer_test_let_lookup() { passed = passed + 1; print("  T13 OK: let binding and lookup\n") } else { print("  FAIL: T13 let binding and lookup\n") }
    if infer_test_subst_compose() { passed = passed + 1; print("  T14 OK: substitution composition\n") } else { print("  FAIL: T14 substitution composition\n") }
    if infer_test_free_vars() { passed = passed + 1; print("  T15 OK: free variable collection\n") } else { print("  FAIL: T15 free variable collection\n") }
    if infer_test_generalize() { passed = passed + 1; print("  T16 OK: generalize captures unbound vars\n") } else { print("  FAIL: T16 generalize captures unbound vars\n") }
    if infer_test_instantiate() { passed = passed + 1; print("  T17 OK: instantiate produces fresh vars\n") } else { print("  FAIL: T17 instantiate produces fresh vars\n") }
    if infer_test_let_poly() { passed = passed + 1; print("  T18 OK: let polymorphism\n") } else { print("  FAIL: T18 let polymorphism\n") }
    if infer_test_unify_fn_types() { passed = passed + 1; print("  T19 OK: unify function types\n") } else { print("  FAIL: T19 unify function types\n") }
    if infer_test_subst_nested() { passed = passed + 1; print("  T20 OK: substitution on nested type\n") } else { print("  FAIL: T20 substitution on nested type\n") }
    if infer_test_logical_op() { passed = passed + 1; print("  T21 OK: logical op bool && bool\n") } else { print("  FAIL: T21 logical op bool && bool\n") }
    if infer_test_logical_op_mismatch() { passed = passed + 1; print("  T22 OK: logical op int && int fails\n") } else { print("  FAIL: T22 logical op int && int fails\n") }
    if infer_test_app_non_fn() { passed = passed + 1; print("  T23 OK: apply non-function fails\n") } else { print("  FAIL: T23 apply non-function fails\n") }

    print("\nInference tests: ")
    print_int(passed)
    print("/")
    print_int(total)
    print(" passed\n")

    if passed == total { 0 } else { 1 }
}

// ════════════════════════════════════════════════════════════════
// SOURCE: self-hosted/check/const_eval.sio  (2051 lines)
// ════════════════════════════════════════════════════════════════

// Compile-time constant evaluator
//
// Evaluates constant expressions during type checking for array sizes,
// const generics, and compile-time folding. Pure value-level evaluation
// with no side effects on the type environment.
//
// Architecture:
//   ConstValue  — tagged constant (int, float, bool, string, array, tuple, unit, error)
//   ConstPool   — arena of ConstValues (flat array, ID = index)
//   ConstExpr   — expression tree node (literal, var, binop, unop, if, array, index, field, call)
//   ExprPool    — arena of ConstExprs
//   ConstEnv    — name-to-value bindings for const variables
//
// Evaluation returns (ConstPool, i64) where i64 is the value ID in the pool.

// ============================================================
// Constant value kinds
// ============================================================

fn CONST_INT()    -> i64 { 1 }
fn CONST_FLOAT()  -> i64 { 2 }
fn CONST_BOOL()   -> i64 { 3 }
fn CONST_STRING() -> i64 { 4 }
fn CONST_ARRAY()  -> i64 { 5 }
fn CONST_TUPLE()  -> i64 { 6 }
fn CONST_UNIT()   -> i64 { 7 }
fn CONST_ERROR()  -> i64 { 99 }

// ============================================================
// Constant expression kinds
// ============================================================

fn CEXPR_LIT()    -> i64 { 1 }
fn CEXPR_VAR()    -> i64 { 2 }
fn CEXPR_BINOP()  -> i64 { 3 }
fn CEXPR_UNOP()   -> i64 { 4 }
fn CEXPR_IF()     -> i64 { 5 }
fn CEXPR_ARRAY()  -> i64 { 6 }
fn CEXPR_INDEX()  -> i64 { 7 }
fn CEXPR_FIELD()  -> i64 { 8 }
fn CEXPR_CALL()   -> i64 { 9 }

// ============================================================
// Binary operator tags
// ============================================================

fn BINOP_ADD()  -> i64 { 1 }
fn BINOP_SUB()  -> i64 { 2 }
fn BINOP_MUL()  -> i64 { 3 }
fn BINOP_DIV()  -> i64 { 4 }
fn BINOP_MOD()  -> i64 { 5 }
fn BINOP_EQ()   -> i64 { 6 }
fn BINOP_NEQ()  -> i64 { 7 }
fn BINOP_LT()   -> i64 { 8 }
fn BINOP_GT()   -> i64 { 9 }
fn BINOP_LE()   -> i64 { 10 }
fn BINOP_GE()   -> i64 { 11 }
fn BINOP_AND()  -> i64 { 12 }
fn BINOP_OR()   -> i64 { 13 }

// ============================================================
// Unary operator tags
// ============================================================

fn UNOP_NEG()   -> i64 { 1 }
fn UNOP_NOT()   -> i64 { 2 }

// ============================================================
// ConstValue — a single compile-time constant
// ============================================================

struct ConstValue {
    kind: i64,
    int_val: i64,
    float_val: f64,
    bool_val: i64,
    children: [i64; 16],
    child_count: i64,
}

fn empty_const_value() -> ConstValue {
    ConstValue {
        kind: CONST_ERROR(),
        int_val: 0,
        float_val: 0.0,
        bool_val: 0,
        children: [0; 16],
        child_count: 0,
    }
}

fn const_value_int(v: i64) -> ConstValue {
    ConstValue {
        kind: CONST_INT(),
        int_val: v,
        float_val: 0.0,
        bool_val: 0,
        children: [0; 16],
        child_count: 0,
    }
}

fn const_value_float(v: f64) -> ConstValue {
    ConstValue {
        kind: CONST_FLOAT(),
        int_val: 0,
        float_val: v,
        bool_val: 0,
        children: [0; 16],
        child_count: 0,
    }
}

fn const_value_bool(v: bool) -> ConstValue {
    let bv: i64 = if v { 1 } else { 0 }
    ConstValue {
        kind: CONST_BOOL(),
        int_val: 0,
        float_val: 0.0,
        bool_val: bv,
        children: [0; 16],
        child_count: 0,
    }
}

fn const_value_unit() -> ConstValue {
    ConstValue {
        kind: CONST_UNIT(),
        int_val: 0,
        float_val: 0.0,
        bool_val: 0,
        children: [0; 16],
        child_count: 0,
    }
}

fn const_value_error() -> ConstValue {
    ConstValue {
        kind: CONST_ERROR(),
        int_val: 0,
        float_val: 0.0,
        bool_val: 0,
        children: [0; 16],
        child_count: 0,
    }
}

fn const_value_is_error(v: ConstValue) -> bool with Mut, Panic, Div {
    v.kind == CONST_ERROR()
}

fn const_value_is_int(v: ConstValue) -> bool with Mut, Panic, Div {
    v.kind == CONST_INT()
}

fn const_value_is_float(v: ConstValue) -> bool with Mut, Panic, Div {
    v.kind == CONST_FLOAT()
}

fn const_value_is_bool(v: ConstValue) -> bool with Mut, Panic, Div {
    v.kind == CONST_BOOL()
}

// ============================================================
// ConstPool — arena of ConstValues
// ============================================================

struct ConstPool {
    values: [ConstValue; 1024],
    count: i64,
}

fn const_pool_new() -> ConstPool {
    ConstPool {
        values: [empty_const_value(); 1024],
        count: 0,
    }
}

fn const_pool_add(pool: ConstPool, val: ConstValue) -> (ConstPool, i64) with Mut, Panic, Div {
    var p = pool
    if p.count >= 1024 {
        // Pool full — return error value at slot 0
        return (p, 0 - 1)
    }
    let id = p.count
    p.values[id as usize] = val
    p.count = p.count + 1
    (p, id)
}

fn const_pool_get(pool: ConstPool, id: i64) -> ConstValue with Mut, Panic, Div {
    if id < 0 || id >= pool.count {
        return const_value_error()
    }
    pool.values[id as usize]
}

fn const_pool_add_int(pool: ConstPool, v: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    const_pool_add(pool, const_value_int(v))
}

fn const_pool_add_float(pool: ConstPool, v: f64) -> (ConstPool, i64) with Mut, Panic, Div {
    const_pool_add(pool, const_value_float(v))
}

fn const_pool_add_bool(pool: ConstPool, v: bool) -> (ConstPool, i64) with Mut, Panic, Div {
    const_pool_add(pool, const_value_bool(v))
}

fn const_pool_add_unit(pool: ConstPool) -> (ConstPool, i64) with Mut, Panic, Div {
    const_pool_add(pool, const_value_unit())
}

fn const_pool_add_error(pool: ConstPool) -> (ConstPool, i64) with Mut, Panic, Div {
    const_pool_add(pool, const_value_error())
}

// ============================================================
// ConstExpr — expression tree node
// ============================================================

struct ConstExpr {
    kind: i64,
    op: i64,
    value_id: i64,
    children: [i64; 8],
    child_count: i64,
    name: i64,
}

fn empty_const_expr() -> ConstExpr {
    ConstExpr {
        kind: CEXPR_LIT(),
        op: 0,
        value_id: 0 - 1,
        children: [0; 8],
        child_count: 0,
        name: 0,
    }
}

// ============================================================
// ExprPool — arena of ConstExprs
// ============================================================

struct ExprPool {
    exprs: [ConstExpr; 2048],
    count: i64,
}

fn expr_pool_new() -> ExprPool {
    ExprPool {
        exprs: [empty_const_expr(); 2048],
        count: 0,
    }
}

fn expr_pool_add(pool: ExprPool, expr: ConstExpr) -> (ExprPool, i64) with Mut, Panic, Div {
    var p = pool
    if p.count >= 2048 {
        return (p, 0 - 1)
    }
    let id = p.count
    p.exprs[id as usize] = expr
    p.count = p.count + 1
    (p, id)
}

fn expr_pool_get(pool: ExprPool, id: i64) -> ConstExpr with Mut, Panic, Div {
    if id < 0 || id >= pool.count {
        return empty_const_expr()
    }
    pool.exprs[id as usize]
}

// ============================================================
// Expression constructors
// ============================================================

fn cexpr_lit(value_id: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_LIT()
    e.value_id = value_id
    e
}

fn cexpr_var(name: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_VAR()
    e.name = name
    e
}

fn cexpr_binop(op: i64, lhs_id: i64, rhs_id: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_BINOP()
    e.op = op
    e.children[0] = lhs_id
    e.children[1] = rhs_id
    e.child_count = 2
    e
}

fn cexpr_unop(op: i64, operand_id: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_UNOP()
    e.op = op
    e.children[0] = operand_id
    e.child_count = 1
    e
}

fn cexpr_if(cond_id: i64, then_id: i64, else_id: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_IF()
    e.children[0] = cond_id
    e.children[1] = then_id
    e.children[2] = else_id
    e.child_count = 3
    e
}

fn cexpr_array(elem_ids: [i64; 8], count: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_ARRAY()
    e.children = elem_ids
    e.child_count = count
    e
}

fn cexpr_index(array_id: i64, index_id: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_INDEX()
    e.children[0] = array_id
    e.children[1] = index_id
    e.child_count = 2
    e
}

fn cexpr_field(base_id: i64, field_name: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_FIELD()
    e.children[0] = base_id
    e.child_count = 1
    e.name = field_name
    e
}

fn cexpr_call(fn_name: i64, arg_ids: [i64; 8], arg_count: i64) -> ConstExpr with Mut, Panic, Div {
    var e = empty_const_expr()
    e.kind = CEXPR_CALL()
    e.name = fn_name
    e.children = arg_ids
    e.child_count = arg_count
    e
}

// ============================================================
// ConstEnv — name-to-value binding environment
// ============================================================

struct ConstEnv {
    names: [i64; 256],
    values: [i64; 256],
    count: i64,
}

fn const_env_new() -> ConstEnv {
    ConstEnv {
        names: [0; 256],
        values: [0; 256],
        count: 0,
    }
}

fn const_env_bind(env: ConstEnv, name: i64, val_id: i64) -> ConstEnv with Mut, Panic, Div {
    var e = env
    if e.count >= 256 {
        return e
    }
    e.names[e.count as usize] = name
    e.values[e.count as usize] = val_id
    e.count = e.count + 1
    e
}

fn const_env_lookup(env: ConstEnv, name: i64) -> i64 with Mut, Panic, Div {
    // Search backwards for most recent binding
    var i = env.count - 1
    while i >= 0 {
        if env.names[i as usize] == name {
            return env.values[i as usize]
        }
        i = i - 1
    }
    0 - 1
}

fn const_env_has(env: ConstEnv, name: i64) -> bool with Mut, Panic, Div {
    var i = env.count - 1
    while i >= 0 {
        if env.names[i as usize] == name {
            return true
        }
        i = i - 1
    }
    false
}

// ============================================================
// Integer arithmetic on const values
// ============================================================

fn const_add_int(a: i64, b: i64) -> i64 with Mut, Panic, Div {
    a + b
}

fn const_sub_int(a: i64, b: i64) -> i64 with Mut, Panic, Div {
    a - b
}

fn const_mul_int(a: i64, b: i64) -> i64 with Mut, Panic, Div {
    a * b
}

fn const_div_int(a: i64, b: i64) -> i64 with Mut, Panic, Div {
    if b == 0 {
        return 0
    }
    a / b
}

fn const_mod_int(a: i64, b: i64) -> i64 with Mut, Panic, Div {
    if b == 0 {
        return 0
    }
    a % b
}

fn const_eq_int(a: i64, b: i64) -> bool with Mut, Panic, Div {
    a == b
}

fn const_lt_int(a: i64, b: i64) -> bool with Mut, Panic, Div {
    a < b
}

fn const_gt_int(a: i64, b: i64) -> bool with Mut, Panic, Div {
    a > b
}

fn const_le_int(a: i64, b: i64) -> bool with Mut, Panic, Div {
    a <= b
}

fn const_ge_int(a: i64, b: i64) -> bool with Mut, Panic, Div {
    a >= b
}

// ============================================================
// Boolean operations on const values
// ============================================================

fn const_and_bool(a: bool, b: bool) -> bool with Mut, Panic, Div {
    a && b
}

fn const_or_bool(a: bool, b: bool) -> bool with Mut, Panic, Div {
    a || b
}

fn const_not_bool(a: bool) -> bool with Mut, Panic, Div {
    !a
}

// ============================================================
// Float arithmetic on const values
// ============================================================

fn const_add_float(a: f64, b: f64) -> f64 with Mut, Panic, Div {
    a + b
}

fn const_sub_float(a: f64, b: f64) -> f64 with Mut, Panic, Div {
    a - b
}

fn const_mul_float(a: f64, b: f64) -> f64 with Mut, Panic, Div {
    a * b
}

fn const_div_float(a: f64, b: f64) -> f64 with Mut, Panic, Div {
    if b == 0.0 {
        return 0.0
    }
    a / b
}

// ============================================================
// Evaluation — binary operations
// ============================================================

fn const_eval_binop(pool: ConstPool, op: i64, lhs_id: i64, rhs_id: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    let lhs = const_pool_get(pool, lhs_id)
    let rhs = const_pool_get(pool, rhs_id)

    // Error propagation
    if const_value_is_error(lhs) || const_value_is_error(rhs) {
        return const_pool_add_error(pool)
    }

    // Int x Int operations
    if lhs.kind == CONST_INT() && rhs.kind == CONST_INT() {
        if op == BINOP_ADD() {
            return const_pool_add_int(pool, const_add_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_SUB() {
            return const_pool_add_int(pool, const_sub_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_MUL() {
            return const_pool_add_int(pool, const_mul_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_DIV() {
            return const_pool_add_int(pool, const_div_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_MOD() {
            return const_pool_add_int(pool, const_mod_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_EQ() {
            return const_pool_add_bool(pool, const_eq_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_NEQ() {
            return const_pool_add_bool(pool, !const_eq_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_LT() {
            return const_pool_add_bool(pool, const_lt_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_GT() {
            return const_pool_add_bool(pool, const_gt_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_LE() {
            return const_pool_add_bool(pool, const_le_int(lhs.int_val, rhs.int_val))
        }
        if op == BINOP_GE() {
            return const_pool_add_bool(pool, const_ge_int(lhs.int_val, rhs.int_val))
        }
        return const_pool_add_error(pool)
    }

    // Float x Float operations
    if lhs.kind == CONST_FLOAT() && rhs.kind == CONST_FLOAT() {
        if op == BINOP_ADD() {
            return const_pool_add_float(pool, const_add_float(lhs.float_val, rhs.float_val))
        }
        if op == BINOP_SUB() {
            return const_pool_add_float(pool, const_sub_float(lhs.float_val, rhs.float_val))
        }
        if op == BINOP_MUL() {
            return const_pool_add_float(pool, const_mul_float(lhs.float_val, rhs.float_val))
        }
        if op == BINOP_DIV() {
            return const_pool_add_float(pool, const_div_float(lhs.float_val, rhs.float_val))
        }
        if op == BINOP_EQ() {
            return const_pool_add_bool(pool, lhs.float_val == rhs.float_val)
        }
        if op == BINOP_NEQ() {
            return const_pool_add_bool(pool, lhs.float_val != rhs.float_val)
        }
        if op == BINOP_LT() {
            return const_pool_add_bool(pool, lhs.float_val < rhs.float_val)
        }
        if op == BINOP_GT() {
            return const_pool_add_bool(pool, lhs.float_val > rhs.float_val)
        }
        if op == BINOP_LE() {
            return const_pool_add_bool(pool, lhs.float_val <= rhs.float_val)
        }
        if op == BINOP_GE() {
            return const_pool_add_bool(pool, lhs.float_val >= rhs.float_val)
        }
        return const_pool_add_error(pool)
    }

    // Bool x Bool operations
    if lhs.kind == CONST_BOOL() && rhs.kind == CONST_BOOL() {
        let lv = lhs.bool_val != 0
        let rv = rhs.bool_val != 0
        if op == BINOP_AND() {
            return const_pool_add_bool(pool, const_and_bool(lv, rv))
        }
        if op == BINOP_OR() {
            return const_pool_add_bool(pool, const_or_bool(lv, rv))
        }
        if op == BINOP_EQ() {
            return const_pool_add_bool(pool, lv == rv)
        }
        if op == BINOP_NEQ() {
            return const_pool_add_bool(pool, lv != rv)
        }
        return const_pool_add_error(pool)
    }

    // Mixed Int/Float — promote int to float
    if lhs.kind == CONST_INT() && rhs.kind == CONST_FLOAT() {
        let lf = lhs.int_val as f64
        if op == BINOP_ADD() { return const_pool_add_float(pool, lf + rhs.float_val) }
        if op == BINOP_SUB() { return const_pool_add_float(pool, lf - rhs.float_val) }
        if op == BINOP_MUL() { return const_pool_add_float(pool, lf * rhs.float_val) }
        if op == BINOP_DIV() { return const_pool_add_float(pool, const_div_float(lf, rhs.float_val)) }
        return const_pool_add_error(pool)
    }
    if lhs.kind == CONST_FLOAT() && rhs.kind == CONST_INT() {
        let rf = rhs.int_val as f64
        if op == BINOP_ADD() { return const_pool_add_float(pool, lhs.float_val + rf) }
        if op == BINOP_SUB() { return const_pool_add_float(pool, lhs.float_val - rf) }
        if op == BINOP_MUL() { return const_pool_add_float(pool, lhs.float_val * rf) }
        if op == BINOP_DIV() { return const_pool_add_float(pool, const_div_float(lhs.float_val, rf)) }
        return const_pool_add_error(pool)
    }

    // Unsupported combination
    const_pool_add_error(pool)
}

// ============================================================
// Evaluation — unary operations
// ============================================================

fn const_eval_unop(pool: ConstPool, op: i64, operand_id: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    let val = const_pool_get(pool, operand_id)

    if const_value_is_error(val) {
        return const_pool_add_error(pool)
    }

    if op == UNOP_NEG() {
        if val.kind == CONST_INT() {
            return const_pool_add_int(pool, 0 - val.int_val)
        }
        if val.kind == CONST_FLOAT() {
            return const_pool_add_float(pool, 0.0 - val.float_val)
        }
        return const_pool_add_error(pool)
    }

    if op == UNOP_NOT() {
        if val.kind == CONST_BOOL() {
            let bv = val.bool_val != 0
            return const_pool_add_bool(pool, const_not_bool(bv))
        }
        return const_pool_add_error(pool)
    }

    const_pool_add_error(pool)
}

// ============================================================
// Evaluation — conditional (if-then-else)
// ============================================================

fn const_eval_if(pool: ConstPool, expr_pool: ExprPool, env: ConstEnv, cond_id: i64, then_id: i64, else_id: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    let pair_c = const_eval(pool, expr_pool, env, cond_id)
    var p = pair_c.0
    let cond_val_id = pair_c.1
    let cond_val = const_pool_get(p, cond_val_id)

    if const_value_is_error(cond_val) {
        return const_pool_add_error(p)
    }

    if cond_val.kind != CONST_BOOL() {
        return const_pool_add_error(p)
    }

    let cond_true = cond_val.bool_val != 0
    if cond_true {
        return const_eval(p, expr_pool, env, then_id)
    } else {
        return const_eval(p, expr_pool, env, else_id)
    }
}

// ============================================================
// Evaluation — array indexing
// ============================================================

fn const_eval_index(pool: ConstPool, array_val_id: i64, index_val_id: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    let arr = const_pool_get(pool, array_val_id)
    let idx = const_pool_get(pool, index_val_id)

    if const_value_is_error(arr) || const_value_is_error(idx) {
        return const_pool_add_error(pool)
    }

    if arr.kind != CONST_ARRAY() {
        return const_pool_add_error(pool)
    }
    if idx.kind != CONST_INT() {
        return const_pool_add_error(pool)
    }

    let i = idx.int_val
    if i < 0 || i >= arr.child_count {
        // Out of bounds
        return const_pool_add_error(pool)
    }

    // The child at index i is a value ID in the pool
    let child_id = arr.children[i as usize]
    (pool, child_id)
}

// ============================================================
// Evaluation — main evaluator
// ============================================================

fn const_eval(pool: ConstPool, expr_pool: ExprPool, env: ConstEnv, expr_id: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    if expr_id < 0 || expr_id >= expr_pool.count {
        return const_pool_add_error(pool)
    }

    let expr = expr_pool_get(expr_pool, expr_id)

    // Literal — value_id points directly into the const pool
    if expr.kind == CEXPR_LIT() {
        return (pool, expr.value_id)
    }

    // Variable lookup
    if expr.kind == CEXPR_VAR() {
        let val_id = const_env_lookup(env, expr.name)
        if val_id < 0 {
            return const_pool_add_error(pool)
        }
        return (pool, val_id)
    }

    // Binary operation
    if expr.kind == CEXPR_BINOP() {
        let lhs_expr_id = expr.children[0]
        let rhs_expr_id = expr.children[1]
        let pair_l = const_eval(pool, expr_pool, env, lhs_expr_id)
        var p = pair_l.0
        let lhs_val_id = pair_l.1
        let pair_r = const_eval(p, expr_pool, env, rhs_expr_id)
        p = pair_r.0
        let rhs_val_id = pair_r.1
        return const_eval_binop(p, expr.op, lhs_val_id, rhs_val_id)
    }

    // Unary operation
    if expr.kind == CEXPR_UNOP() {
        let operand_expr_id = expr.children[0]
        let pair_o = const_eval(pool, expr_pool, env, operand_expr_id)
        let p = pair_o.0
        let operand_val_id = pair_o.1
        return const_eval_unop(p, expr.op, operand_val_id)
    }

    // If-then-else
    if expr.kind == CEXPR_IF() {
        let cond_eid = expr.children[0]
        let then_eid = expr.children[1]
        let else_eid = expr.children[2]
        return const_eval_if(pool, expr_pool, env, cond_eid, then_eid, else_eid)
    }

    // Array construction
    if expr.kind == CEXPR_ARRAY() {
        var p = pool
        var arr_val = empty_const_value()
        arr_val.kind = CONST_ARRAY()
        arr_val.child_count = expr.child_count
        var i: i64 = 0
        while i < expr.child_count && i < 8 {
            let elem_eid = expr.children[i as usize]
            let pair_e = const_eval(p, expr_pool, env, elem_eid)
            p = pair_e.0
            let elem_vid = pair_e.1
            if i < 16 {
                arr_val.children[i as usize] = elem_vid
            }
            i = i + 1
        }
        return const_pool_add(p, arr_val)
    }

    // Index into array
    if expr.kind == CEXPR_INDEX() {
        let arr_eid = expr.children[0]
        let idx_eid = expr.children[1]
        let pair_a = const_eval(pool, expr_pool, env, arr_eid)
        var p = pair_a.0
        let arr_vid = pair_a.1
        let pair_i = const_eval(p, expr_pool, env, idx_eid)
        p = pair_i.0
        let idx_vid = pair_i.1
        return const_eval_index(p, arr_vid, idx_vid)
    }

    // Field access and call are not yet fully supported —
    // return error for now (extensible in later stages)
    if expr.kind == CEXPR_FIELD() || expr.kind == CEXPR_CALL() {
        return const_pool_add_error(pool)
    }

    const_pool_add_error(pool)
}

// ============================================================
// Value extraction helpers
// ============================================================

fn const_to_i64(pool: ConstPool, val_id: i64) -> i64 with Mut, Panic, Div {
    let v = const_pool_get(pool, val_id)
    if v.kind == CONST_INT() {
        return v.int_val
    }
    if v.kind == CONST_BOOL() {
        return v.bool_val
    }
    // Default for non-integer types
    0
}

fn const_to_f64(pool: ConstPool, val_id: i64) -> f64 with Mut, Panic, Div {
    let v = const_pool_get(pool, val_id)
    if v.kind == CONST_FLOAT() {
        return v.float_val
    }
    if v.kind == CONST_INT() {
        return v.int_val as f64
    }
    0.0
}

fn const_to_bool(pool: ConstPool, val_id: i64) -> bool with Mut, Panic, Div {
    let v = const_pool_get(pool, val_id)
    if v.kind == CONST_BOOL() {
        return v.bool_val != 0
    }
    if v.kind == CONST_INT() {
        return v.int_val != 0
    }
    false
}

// ============================================================
// Const-ness checking
// ============================================================

fn is_const_expr(expr_pool: ExprPool, expr_id: i64) -> bool with Mut, Panic, Div {
    if expr_id < 0 || expr_id >= expr_pool.count {
        return false
    }
    let expr = expr_pool_get(expr_pool, expr_id)

    // Literals are always const
    if expr.kind == CEXPR_LIT() {
        return true
    }

    // Variables are const if they were bound in the const env (we assume yes
    // here — the caller must check that the variable is actually const)
    if expr.kind == CEXPR_VAR() {
        return true
    }

    // Binary/unary: const if children are const
    if expr.kind == CEXPR_BINOP() {
        let lc = is_const_expr(expr_pool, expr.children[0])
        let rc = is_const_expr(expr_pool, expr.children[1])
        return lc && rc
    }
    if expr.kind == CEXPR_UNOP() {
        return is_const_expr(expr_pool, expr.children[0])
    }

    // If: const if all three branches are const
    if expr.kind == CEXPR_IF() {
        let cc = is_const_expr(expr_pool, expr.children[0])
        let tc = is_const_expr(expr_pool, expr.children[1])
        let ec = is_const_expr(expr_pool, expr.children[2])
        return cc && tc && ec
    }

    // Array: const if all elements are const
    if expr.kind == CEXPR_ARRAY() {
        var i: i64 = 0
        while i < expr.child_count {
            if !is_const_expr(expr_pool, expr.children[i as usize]) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // Index: const if both array and index are const
    if expr.kind == CEXPR_INDEX() {
        let ac = is_const_expr(expr_pool, expr.children[0])
        let ic = is_const_expr(expr_pool, expr.children[1])
        return ac && ic
    }

    // Field access and calls are not const-foldable yet
    false
}

// ============================================================
// Const folding integration
// ============================================================

fn try_const_fold(pool: ConstPool, expr_pool: ExprPool, env: ConstEnv, expr_id: i64) -> (bool, ConstPool, i64) with Mut, Panic, Div {
    if !is_const_expr(expr_pool, expr_id) {
        return (false, pool, 0 - 1)
    }
    let pair = const_eval(pool, expr_pool, env, expr_id)
    let p = pair.0
    let vid = pair.1
    let v = const_pool_get(p, vid)
    if const_value_is_error(v) {
        return (false, p, vid)
    }
    (true, p, vid)
}

// ============================================================
// Array const value construction (for [expr; N] patterns)
// ============================================================

fn const_make_array(pool: ConstPool, elem_id: i64, count: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    if count < 0 || count > 16 {
        return const_pool_add_error(pool)
    }
    var arr = empty_const_value()
    arr.kind = CONST_ARRAY()
    arr.child_count = count
    var i: i64 = 0
    while i < count {
        arr.children[i as usize] = elem_id
        i = i + 1
    }
    const_pool_add(pool, arr)
}

// Tuple const value construction
fn const_make_tuple(pool: ConstPool, elem_ids: [i64; 16], count: i64) -> (ConstPool, i64) with Mut, Panic, Div {
    if count < 0 || count > 16 {
        return const_pool_add_error(pool)
    }
    var tup = empty_const_value()
    tup.kind = CONST_TUPLE()
    tup.child_count = count
    var i: i64 = 0
    while i < count {
        tup.children[i as usize] = elem_ids[i as usize]
        i = i + 1
    }
    const_pool_add(pool, tup)
}

// ============================================================
// Equality check for ConstValues
// ============================================================

fn const_values_equal(pool: ConstPool, a_id: i64, b_id: i64) -> bool with Mut, Panic, Div {
    let a = const_pool_get(pool, a_id)
    let b = const_pool_get(pool, b_id)
    if a.kind != b.kind {
        return false
    }
    if a.kind == CONST_INT() {
        return a.int_val == b.int_val
    }
    if a.kind == CONST_FLOAT() {
        return a.float_val == b.float_val
    }
    if a.kind == CONST_BOOL() {
        return a.bool_val == b.bool_val
    }
    if a.kind == CONST_UNIT() {
        return true
    }
    if a.kind == CONST_ARRAY() || a.kind == CONST_TUPLE() {
        if a.child_count != b.child_count {
            return false
        }
        var i: i64 = 0
        while i < a.child_count {
            if !const_values_equal(pool, a.children[i as usize], b.children[i as usize]) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if a.kind == CONST_ERROR() {
        return true
    }
    false
}

// ============================================================
// Debug: kind to tag name (returns i64 tag for printing)
// ============================================================

fn const_kind_tag(kind: i64) -> i64 with Mut, Panic, Div {
    // Returns the kind value itself — useful for test diagnostics
    kind
}

// ============================================================
// Test helpers
// ============================================================

fn ce_assert_true(cond: bool, test_id: i64) -> i64 with IO, Mut, Panic, Div {
    if cond {
        print("  PASS test ")
        print_int(test_id)
        print("\n")
        return 0
    } else {
        print("  FAIL test ")
        print_int(test_id)
        print("\n")
        return 1
    }
}

// ============================================================
// Test 1: Pool add and get — integer
// ============================================================

fn test_ce_pool_int() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pair = const_pool_add_int(pool, 42)
    pool = pair.0
    let id = pair.1
    let v = const_pool_get(pool, id)
    let ok1 = v.kind == CONST_INT()
    let ok2 = v.int_val == 42
    ce_assert_true(ok1 && ok2, 1)
}

// ============================================================
// Test 2: Pool add and get — float
// ============================================================

fn test_ce_pool_float() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pair = const_pool_add_float(pool, 3.14)
    pool = pair.0
    let id = pair.1
    let v = const_pool_get(pool, id)
    let ok1 = v.kind == CONST_FLOAT()
    let ok2 = v.float_val == 3.14
    ce_assert_true(ok1 && ok2, 2)
}

// ============================================================
// Test 3: Pool add and get — bool
// ============================================================

fn test_ce_pool_bool() -> i64 with IO, Mut, Panic, Div {
    var pool = const_pool_new()
    let pair_t = const_pool_add_bool(pool, true)
    pool = pair_t.0
    let id_t = pair_t.1
    let pair_f = const_pool_add_bool(pool, false)
    pool = pair_f.0
    let id_f = pair_f.1
    let vt = const_pool_get(pool, id_t)
    let vf = const_pool_get(pool, id_f)
    let ok1 = vt.bool_val == 1
    let ok2 = vf.bool_val == 0
    let ok3 = vt.kind == CONST_BOOL() && vf.kind == CONST_BOOL()
    ce_assert_true(ok1 && ok2 && ok3, 3)
}

// ============================================================
// Test 4: Env bind and lookup
// ============================================================

fn test_ce_env_bind() -> i64 with IO, Mut, Panic, Div {
    var env = const_env_new()
    env = const_env_bind(env, 100, 42)
    env = const_env_bind(env, 200, 77)
    let v1 = const_env_lookup(env, 100)
    let v2 = const_env_lookup(env, 200)
    let v3 = const_env_lookup(env, 300)
    let ok1 = v1 == 42
    let ok2 = v2 == 77
    let ok3 = v3 == (0 - 1)
    ce_assert_true(ok1 && ok2 && ok3, 4)
}

