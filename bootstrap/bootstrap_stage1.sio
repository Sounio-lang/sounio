// Test 33: Abort continuation
fn efh_test_abort_cont(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    var regs: [i64; 64] = [0; 64]
    let cid = efh_capture_continuation(ctx, &regs, 0, 0)

    let ok = efh_abort(ctx, cid)
    let state = efh_cont_state(ctx, cid)

