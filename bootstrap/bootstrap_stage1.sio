fn test_dep_constraint_greater_eq_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let a = dep_term_int(ctx, 5)
    let b = dep_term_int(ctx, 5)
    dep_add_constraint(ctx, DEP_CONSTRAINT_KIND_GREATER_EQ, a, b, 1)
    if dep_check_constraints(ctx) == false { return false }
    // Also check 6 >= 5
    dep_clear_constraints(ctx)
    let c = dep_term_int(ctx, 6)
    let d = dep_term_int(ctx, 5)
    dep_add_constraint(ctx, DEP_CONSTRAINT_KIND_GREATER_EQ, c, d, 2)
    dep_check_constraints(ctx)
}
