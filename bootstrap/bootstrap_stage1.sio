    list = lsp_completion_list_add(list, item)

    let ok_found = lsc_list_contains_label(list, 42)
    let ok_not = lsc_list_contains_label(list, 99) == false
    ok_found && ok_not
}

// T67: lsc_list_find_label
fn test_lsc_list_find() -> bool with Mut, Div, Panic {
    var list = lsp_completion_list_new()
    let i1 = lsp_completion_item_new(10, LSC_KIND_VARIABLE, 0, 0)
    let i2 = lsp_completion_item_new(20, LSC_KIND_FUNCTION, 0, 0)
    list = lsp_completion_list_add(list, i1)
    list = lsp_completion_list_add(list, i2)

    let idx1 = lsc_list_find_label(list, 10)
    let idx2 = lsc_list_find_label(list, 20)
    let idx3 = lsc_list_find_label(list, 30)
    idx1 == 0 && idx2 == 1 && idx3 == LSC_INVALID
}

// T68: lsc_list_max_priority and lsc_list_min_priority
fn test_lsc_list_priority_range() -> bool with Mut, Div, Panic {
