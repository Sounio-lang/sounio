fn write_hyper_expr_info(buf: [i8; 131072], pos: i64, info: IrHyperExprInfo) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos
    let p0 = write_i64(b, p, info.span_start)
    b = p0.0
    p = p0.1
    let p1 = write_i64(b, p, info.span_end)
    b = p1.0
    p = p1.1
    let p2 = write_i64(b, p, info.algebra_tag)
    b = p2.0
    p = p2.1
    let p3 = write_i64(b, p, info.op_kind)
    b = p3.0
    p = p3.1
    let p4 = write_i64(b, p, if info.knowledge_wrapped { 1 } else { 0 })
    b = p4.0
    p = p4.1
    (b, p)
}

fn read_hyper_expr_info(buf: [i8; 131072], pos: i64) -> (IrHyperExprInfo, i64) with Mut, Panic, Div, Alloc {
    var p = pos
    let p0 = read_i64(buf, p)
    let span_start = p0.0
    p = p0.1
    let p1 = read_i64(buf, p)
    let span_end = p1.0
    p = p1.1
    let p2 = read_i64(buf, p)
    let algebra_tag = p2.0
    p = p2.1
    let p3 = read_i64(buf, p)
    let op_kind = p3.0
    p = p3.1
    let p4 = read_i64(buf, p)
    let knowledge_wrapped = p4.0 != 0
    p = p4.1
    (IrHyperExprInfo {
        span_start: span_start,
        span_end: span_end,
        algebra_tag: algebra_tag,
        op_kind: op_kind,
        knowledge_wrapped: knowledge_wrapped,
    }, p)
}

fn serialize_ir_epistemic_section(buf: [i8; 131072], pos: i64, ep: IrEpistemicSection) -> ([i8; 131072], i64) with Mut, Panic, Div, Alloc {
    var b = buf
    var p = pos

    let c0 = write_i64(b, p, ep.model_family_count)
    b = c0.0
    p = c0.1
    var i: i64 = 0
    while i < ep.model_family_count {
        let pair = write_model_family_info(b, p, ep.model_families[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c1 = write_i64(b, p, ep.policy_count)
    b = c1.0
    p = c1.1
    i = 0
    while i < ep.policy_count {
        let pair = write_ir_policy_info(b, p, ep.policies[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c2 = write_i64(b, p, ep.validation_count)
    b = c2.0
    p = c2.1
    i = 0
    while i < ep.validation_count {
        let pair = write_validation_policy_info(b, p, ep.validations[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c3 = write_i64(b, p, ep.mechanistic_report_count)
    b = c3.0
    p = c3.1
    i = 0
    while i < ep.mechanistic_report_count {
        let pair = write_mechanistic_report_info(b, p, ep.mechanistic_reports[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c4 = write_i64(b, p, ep.posterior_weights_count)
    b = c4.0
    p = c4.1
    i = 0
    while i < ep.posterior_weights_count {
        let pair = write_posterior_weights_info(b, p, ep.posterior_weights[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c5 = write_i64(b, p, ep.counterexample_count)
    b = c5.0
    p = c5.1
    i = 0
    while i < ep.counterexample_count {
        let pair = write_counterexample_info(b, p, ep.counterexamples[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c5b = write_i64(b, p, ep.audit_count)
    b = c5b.0
    p = c5b.1
    i = 0
    while i < ep.audit_count {
        let pair = write_audit_info(b, p, ep.audits[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c6 = write_i64(b, p, ep.contest_count)
    b = c6.0
    p = c6.1
    i = 0
    while i < ep.contest_count {
        let pair = write_contest_info(b, p, ep.contests[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c7 = write_i64(b, p, ep.contest_witness_count)
    b = c7.0
    p = c7.1
    i = 0
    while i < ep.contest_witness_count {
        let pair = write_contest_witness_info(b, p, ep.contest_witnesses[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c8 = write_i64(b, p, ep.robust_proof_count)
    b = c8.0
    p = c8.1
    i = 0
    while i < ep.robust_proof_count {
        let pair = write_robust_proof_info(b, p, ep.robust_proofs[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c9 = write_i64(b, p, ep.validated_manifest_count)
    b = c9.0
    p = c9.1
    i = 0
    while i < ep.validated_manifest_count {
        let pair = write_validated_manifest_info(b, p, ep.validated_manifests[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    // Appended in-place to preserve compatibility with older SOIR v2 artifacts that
    // ended the epistemic section at validated_manifests.
    let c10 = write_i64(b, p, ep.decision_policy_count)
    b = c10.0
    p = c10.1
    i = 0
    while i < ep.decision_policy_count {
        let pair = write_decision_policy_info(b, p, ep.decision_policies[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c11 = write_i64(b, p, ep.decision_certificate_count)
    b = c11.0
    p = c11.1
    i = 0
    while i < ep.decision_certificate_count {
        let pair = write_decision_certificate_info(b, p, ep.decision_certificates[i])
