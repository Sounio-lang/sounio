    ctx.nest.loops[0].is_counted = true
    ctx.nest.loops[0].instr_count = 50

    let info = lopt_full_unroll(ctx, 0)
    // 1000 * 50 > LOPT_FULL_UNROLL_THRESHOLD (256), so should be rejected
    if info.can_unroll {
        print("FAIL: test_lopt_full_unroll_too_large\n")
        return 1
    }
    print("PASS: test_lopt_full_unroll_too_large\n")
