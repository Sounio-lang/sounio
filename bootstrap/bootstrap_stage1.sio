// Test 39: Add a clause
fn efh_test_add_clause(ctx: &! EfhContext) -> bool with Mut, Div, Panic {
    let idx = efh_add_clause(ctx, 1, 0, 100, true, EfhResumeStrategy::ResumeOnce)
