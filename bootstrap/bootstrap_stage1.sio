    bc = bc_check_use_after_move(bc, 1)  // use after move
    var fails: i64 = 0
    fails = fails + bc_assert_true(bc.error_count > 0, 15)
    fails = fails + bc_assert_true(bc_has_error_code(bc, ERR_USE_AFTER_MOVE), 15)
    fails
}

