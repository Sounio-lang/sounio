    print("=== Loop Optimization Tests ===\n")

    if test_lopt_context_new() == 0 { passed = passed + 1 }
    if test_lopt_add_block() == 0 { passed = passed + 1 }
    if test_lopt_add_edge() == 0 { passed = passed + 1 }
    if test_lopt_add_instr() == 0 { passed = passed + 1 }
    if test_lopt_dominates_self() == 0 { passed = passed + 1 }
