// Test 68: Linear type NOT consumed — ErrMissingDrop at function check
fn own_test_68_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyLinear, 10)
    // Do NOT consume it
    let ok = own_check_linear_at_end(ctx)
