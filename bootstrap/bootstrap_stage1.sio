// T27: is_warm becomes true after WARM_THRESHOLD calls
fn test_jc_becomes_warm_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    var i: i64 = 0
    while i < JC_WARM_THRESHOLD {
        let c = jc_record_call(cache, 1101)
        i = i + 1
    }
    jc_is_warm(cache, 1101)
}
fn test_jc_becomes_warm() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_becomes_warm_inner(&! cache)
}

