// T70: fragmentation increases after invalidation
fn test_jc_fragmentation_after_invalidate_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 4)
    let idx0 = jc_insert_entry(cache, 4400, JC_TIER_BASELINE, code, 4)
    let idx1 = jc_insert_entry(cache, 4401, JC_TIER_BASELINE, code, 4)
    let ok = jc_invalidate_entry(cache, idx0)
    let frag = jc_fragmentation(cache)
    // 1 invalid out of 2 entries = 0.5
    if frag < 0.49 { return false }
    frag > 0.0
}
fn test_jc_fragmentation_after_invalidate() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_fragmentation_after_invalidate_inner(&! cache)
}

// T71: find_hottest_entry
fn test_jc_find_hottest_inner(cache: &! JcCache) -> bool with Mut, Div, Panic {
    let code = jc_test_code(1 as i8, 4)
    let idx0 = jc_insert_entry(cache, 4500, JC_TIER_BASELINE, code, 4)
    let idx1 = jc_insert_entry(cache, 4501, JC_TIER_BASELINE, code, 4)
    let idx2 = jc_insert_entry(cache, 4502, JC_TIER_BASELINE, code, 4)
    cache.entries[idx0 as usize].hit_count = 5
    cache.entries[idx1 as usize].hit_count = 100
    cache.entries[idx2 as usize].hit_count = 50
    let hottest = jc_find_hottest_entry(cache)
    hottest == idx1
}
fn test_jc_find_hottest() -> bool with Mut, Div, Panic {
    var cache = jc_cache_new()
    test_jc_find_hottest_inner(&! cache)
}

