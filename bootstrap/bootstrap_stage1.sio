// Test 70: Linear type with borrow still active at end — MissingDrop
fn own_test_70_inner(ctx: &! OwnContext) -> bool with Mut, Div, Panic {
    let id = own_declare_var(ctx, OwnTypeKind::TyLinear, 10)
    let bid = own_borrow_shared(ctx, id, 15)
    // Linear variable is still borrowed (not consumed)
    let ok = own_check_linear_at_end(ctx)
    ok == false
    && own_error_kind_eq(own_last_error_kind(ctx), OwnErrorKind::ErrMissingDrop)
