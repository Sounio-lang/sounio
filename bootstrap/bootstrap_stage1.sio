        i = i + 1
    }

    let c26 = write_i64(b, p, ep.transition_policy_count)
    b = c26.0
    p = c26.1
    i = 0
    while i < ep.transition_policy_count {
        let pair = write_transition_policy_info(b, p, ep.transition_policies[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }

    let c27 = write_i64(b, p, ep.transition_protocol_count)
    b = c27.0
    p = c27.1
    i = 0
    while i < ep.transition_protocol_count {
        let pair = write_transition_protocol_info(b, p, ep.transition_protocols[i])
