// ---------------------------------------------------------------------------
// Scheduling/yield — T19: total switches increment
// ---------------------------------------------------------------------------
fn test_gth_switches_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let s0 = sched.total_switches
    let first = gth_schedule_next(sched)
    let s1 = sched.total_switches
    let next = gth_yield_current(sched)
    let s2 = sched.total_switches
    s0 == 0 && s1 == 1 && s2 == 2
}
fn test_gth_switches() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_switches_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Scheduling/yield — T20: yield count per thread
// ---------------------------------------------------------------------------
fn test_gth_yield_count_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    let yc_before = sched.threads[t0 as usize].yield_count
    let next = gth_yield_current(sched)
    let yc_after = sched.threads[t0 as usize].yield_count
    yc_before == 0 && yc_after == 1
}
fn test_gth_yield_count() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_yield_count_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Preemption — T21: ticks_used increments
// ---------------------------------------------------------------------------
fn test_gth_tick_increment_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    let ticks_before = sched.threads[t0 as usize].ticks_used
    let cur = gth_tick(sched)
    let ticks_after = sched.threads[t0 as usize].ticks_used
    ticks_before == 0 && ticks_after == 1
}
fn test_gth_tick_increment() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_tick_increment_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Preemption — T22: no preempt before time slice expires
// ---------------------------------------------------------------------------
fn test_gth_no_preempt_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    // Tick a few times, should not preempt
    var i: i64 = 0
    while i < 5 {
        let cur = gth_tick(sched)
        i = i + 1
    }
    // Still on t0
    sched.current_thread == t0
}
fn test_gth_no_preempt() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_no_preempt_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Preemption — T23: preempt after time slice
// ---------------------------------------------------------------------------
fn test_gth_preempt_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    // Set a short time slice
    sched.time_quantum = 3
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let t1 = gth_spawn(sched, 2, GTH_PRIO_NORMAL)
    // Override time_slice on spawned threads
    sched.threads[t0 as usize].time_slice = 3
    sched.threads[t1 as usize].time_slice = 3
    let first = gth_schedule_next(sched)
    let ok1 = sched.current_thread == t0
    // Tick 3 times to exceed time slice
    var i: i64 = 0
    while i < 3 {
        let cur = gth_tick(sched)
        i = i + 1
    }
    // After 3 ticks, should have preempted to t1
    sched.current_thread == t1
}
fn test_gth_preempt() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_preempt_inner(&! sched)
}

// ---------------------------------------------------------------------------
// Preemption — T24: preempt_check returns false when under budget
// ---------------------------------------------------------------------------
fn test_gth_preempt_check_false_inner(sched: &! GthScheduler) -> bool with Mut, Div, Panic {
    let t0 = gth_spawn(sched, 1, GTH_PRIO_NORMAL)
    let first = gth_schedule_next(sched)
    sched.threads[t0 as usize].ticks_used = 2
    sched.threads[t0 as usize].time_slice = 100
    let preempted = gth_preempt_check(sched)
    !preempted
}
fn test_gth_preempt_check_false() -> bool with Mut, Div, Panic {
    var sched = gth_scheduler_new()
    test_gth_preempt_check_false_inner(&! sched)
}

