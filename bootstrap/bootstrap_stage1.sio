fn write_transition_policy_info(buf: [i8; 131072], pos: i64, info: IrTransitionPolicyInfo) -> ([i8; 131072], i64) with Mut, Panic, Div {
    var b = buf
    var p = pos
    let p0 = write_i64(b, p, info.id)
    b = p0.0
    p = p0.1
    let p1 = write_name(b, p, info.name)
    b = p1.0
    p = p1.1
    let p2 = write_type_tag(b, p, info.target_ty)
    b = p2.0
    p = p2.1
    let p3 = write_name(b, p, info.route_name)
    b = p3.0
    p = p3.1
    let p4 = write_i64(b, p, info.requirement_count)
    b = p4.0
    p = p4.1
    var i: i64 = 0
    while i < 8 {
        let pair = write_policy_requirement_info(b, p, info.requirements[i])
        b = pair.0
        p = pair.1
        i = i + 1
    }
    let p5 = write_i64(b, p, info.max_steps)
    b = p5.0
    p = p5.1
    write_name(b, p, info.rollback_route_name)
}

