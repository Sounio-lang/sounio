    types[1 as usize] = t_i8
    names[0 as usize] = 100
    names[1 as usize] = 200
    lay_set_fields(ctx, s, &types, &names, 2)
    let l = lay_compute(ctx, s)
    // i64 at 0 (8 bytes), i8 at 8 (1 byte), trailing pad to align=8: size = 16
    let ok_size = l.size == 16
    let ok_align = l.align == 8
    let trailing = lay_trailing_padding(&l)
    let ok_trailing = trailing == 7
    ok_size && ok_align && ok_trailing
}
fn test_lay_11_trailing_pad() -> i64 with IO, Mut, Div, Panic {
    var ctx = lay_context_new()
    lay_assert(test_lay_11_trailing_pad_inner(&! ctx), 11)
}

// Test 12: Struct {i32, i8, i32} — interleaved padding
fn test_lay_12_interleaved_pad_inner(ctx: &! LayContext) -> bool with Mut, Div, Panic {
    let t_i8 = lay_register_type(ctx, LayTypeKind::TkI8, LayRepr::ReprDefault)
    let t_i32 = lay_register_type(ctx, LayTypeKind::TkI32, LayRepr::ReprDefault)
    let s = lay_register_type(ctx, LayTypeKind::TkStruct, LayRepr::ReprDefault)
    var types: [i64; 256] = [0; 256]
    var names: [i64; 256] = [0; 256]
