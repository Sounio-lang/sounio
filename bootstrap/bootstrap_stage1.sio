fn test_dep_term_int_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let t = dep_term_int(ctx, 42)
    if t < 0 { return false }
    let k = dep_get_kind(ctx, t)
    if dep_term_kind_is_int_lit(k) == false { return false }
    dep_get_val(ctx, t) == 42
}
fn test_dep_term_int() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_term_int_inner(&! ctx)
}

fn test_dep_term_int_negative_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let t = dep_term_int(ctx, 0 - 7)
    if t < 0 { return false }
    dep_get_val(ctx, t) == 0 - 7
}
fn test_dep_term_int_negative() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_term_int_negative_inner(&! ctx)
}

fn test_dep_term_bool_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let t1 = dep_term_bool(ctx, 1)
    let t2 = dep_term_bool(ctx, 0)
    if dep_get_val(ctx, t1) != 1 { return false }
    dep_get_val(ctx, t2) == 0
}
fn test_dep_term_bool() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_term_bool_inner(&! ctx)
}

fn test_dep_term_var_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let t = dep_term_var(ctx, 99)
    if t < 0 { return false }
    let k = dep_get_kind(ctx, t)
    if dep_term_kind_is_var(k) == false { return false }
    dep_get_var_id(ctx, t) == 99
}
fn test_dep_term_var() -> bool with Mut, Div, Panic {
    var ctx = dep_context_new()
    test_dep_term_var_inner(&! ctx)
}

fn test_dep_term_add_inner(ctx: &! DepContext) -> bool with Mut, Div, Panic {
    let a = dep_term_int(ctx, 3)
    let b = dep_term_int(ctx, 5)
    let t = dep_term_add(ctx, a, b)
    if t < 0 { return false }
    let k = dep_get_kind(ctx, t)
    if dep_term_kind_is_add(k) == false { return false }
    if dep_get_left(ctx, t) != a { return false }
    dep_get_right(ctx, t) == b
}
