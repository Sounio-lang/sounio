    vt = te_vtable_add_method(vt, 100)
    vt = te_vtable_add_method(vt, 200)
    vt = te_vtable_add_method(vt, 300)
    let idx = te_vtable_find_method(vt, 200)
    if idx != 1 {
        print("FAIL: test_te_vtable_find_method - found\n")
        return 1
    }
    let miss = te_vtable_find_method(vt, 999)
    if miss != TE_NOT_FOUND {
        print("FAIL: test_te_vtable_find_method - miss\n")
        return 1
    }
    print("PASS: test_te_vtable_find_method\n")
    return 0
}

// ============================================================
// Test 38: Witness without drop
// ============================================================

fn test_te_witness_no_drop() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let methods = te_make_methods_1_set(700)
    ctx = te_build_witness(ctx, 10, 20, 8, 4, TE_NOT_FOUND, methods, 1)
    let w = ctx.witnesses[0 as usize]
    let dr = te_witness_find_drop(w)
    if dr != TE_NOT_FOUND {
        print("FAIL: test_te_witness_no_drop\n")
        return 1
    }
    // Should have size + align + 1 method = 3 entries (no drop)
    if w.entry_count != 3 {
        print("FAIL: test_te_witness_no_drop - count\n")
        return 1
    }
    print("PASS: test_te_witness_no_drop\n")
    return 0
}

// ============================================================
// Test 39: Find witness by type and trait
// ============================================================

fn test_te_find_witness() -> i32 with IO, Mut, Div, Panic {
    var ctx = te_context_new()
    let m1 = te_make_methods_1_set(100)
    let m2 = te_make_methods_1_set(200)
    ctx = te_build_witness(ctx, 10, 20, 8, 8, TE_NOT_FOUND, m1, 1)
    ctx = te_build_witness(ctx, 11, 21, 16, 8, TE_NOT_FOUND, m2, 1)
    let idx0 = te_find_witness(ctx, 10, 20)
    if idx0 != 0 {
        print("FAIL: test_te_find_witness - 0\n")
        return 1
    }
    let idx1 = te_find_witness(ctx, 11, 21)
    if idx1 != 1 {
        print("FAIL: test_te_find_witness - 1\n")
        return 1
    }
    let miss = te_find_witness(ctx, 99, 99)
    if miss != TE_NOT_FOUND {
        print("FAIL: test_te_find_witness - miss\n")
        return 1
    }
    print("PASS: test_te_find_witness\n")
    return 0
}

// ============================================================
