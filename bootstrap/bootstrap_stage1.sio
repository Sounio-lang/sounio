    // --- Keywords: Session types ---
    Session,     // 'session'
    Chan,        // 'chan'
    Send,        // 'send' (session step)
    Recv,        // 'recv' (session step)
    Close,       // 'close' (session end)
    Dual,        // 'dual' (protocol duality)
}

// ============================================================================
// TOKEN STRUCTURE
// ============================================================================

struct Token {
    kind: TokenKind,
    start: i64,
    end: i64,
    line: i64,
    col: i64,
    text: [i8; 256],
    text_len: i64,
    int_value: i64,
    float_value: f64,
}

impl Token {
    fn new() -> Token {
        Token {
            kind: TokenKind::Eof,
            start: 0,
            end: 0,
            line: 1,
            col: 1,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn with_kind(kind: TokenKind, start: i64, end: i64, line: i64, col: i64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn eof(pos: i64, line: i64, col: i64) -> Token {
        Token {
            kind: TokenKind::Eof,
            start: pos,
            end: pos,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn error(pos: i64, line: i64, col: i64) -> Token {
        Token {
            kind: TokenKind::Error,
            start: pos,
            end: pos + 1,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: 0.0,
        }
    }

    fn with_int(kind: TokenKind, start: i64, end: i64, line: i64, col: i64, value: i64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: value,
            float_value: 0.0,
        }
    }

    fn with_float(kind: TokenKind, start: i64, end: i64, line: i64, col: i64, value: f64) -> Token {
        Token {
            kind: kind,
            start: start,
            end: end,
            line: line,
            col: col,
            text: [0; 256],
            text_len: 0,
            int_value: 0,
            float_value: value,
        }
    }
}

