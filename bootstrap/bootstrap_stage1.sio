        print("FAIL: test_lopt_add_edge pred\n")
        return 1
    }
    if ctx.block_succs[0][0] != 1 {
        print("FAIL: test_lopt_add_edge succ_val\n")
        return 1
    }
    print("PASS: test_lopt_add_edge\n")
    return 0
}

fn test_lopt_add_edge() -> i32 with IO, Mut, Div, Panic {
    var ctx = lopt_context_new()
    return test_lopt_add_edge_inner(&! ctx)
}

