    }
    if te.size != 1 {
        print("FAIL: test_te_classify_concrete_bool - size\n")
        return 1
    }
    print("PASS: test_te_classify_concrete_bool\n")
    return 0
}

// ============================================================
// Test 5: Type classification — reference types are concrete
// ============================================================

fn test_te_classify_ref() -> i32 with IO, Mut, Div, Panic {
    let te = te_classify_type(TE_TY_REF, 50, 0, 0)
    if te.kind != TE_KIND_CONCRETE {
        print("FAIL: test_te_classify_ref - kind\n")
        return 1
