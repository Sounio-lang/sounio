fn lower_program_to_ir_probe_callsite_ref(prog: &Program, caller_name: Name) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
    let lo = lowerer_new_probe()
    var lo2 = lo.preseed_program_items_ref(&prog.items, caller_name)
    lo2 = lo2.lower_program_bodies_filtered_ref(&prog.items, caller_name)
    var patch_stats = ir_empty_validated_patch_stats()
    if !lo2.had_error {
        patch_stats = ir_patch_validated_calls(&! lo2.module)
    }
    IrLowerResult {
        module: *lo2.module,
        error_count: lo2.error_count,
        had_error: lo2.had_error,
        patch_stats: patch_stats,
    }
}

fn lower_program_to_ir_probe_callsite(prog: Program, caller_name: Name) -> IrLowerResult with Mut, Panic, Div, Alloc, IO {
