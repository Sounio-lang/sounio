00100000 00000011 00000000 01010100                                       : 0x0c0  b.eq is_sep                0x0c0 + 0x64 = 0x124
00011111 10000000 00000000 01110001                                       : 0x0c4  cmp w0, #32                ' '
11100000 00000010 00000000 01010100                                       : 0x0c8  b.eq is_sep                0x0c8 + 0x5c = 0x124
00011111 00101000 00000000 01110001                                       : 0x0cc  cmp w0, #10                '\n'
10100000 00000010 00000000 01010100                                       : 0x0d0  b.eq is_sep                0x0d0 + 0x54 = 0x124
00011111 00100100 00000000 01110001                                       : 0x0d4  cmp w0, #9                 '\t'
01100000 00000010 00000000 01010100                                       : 0x0d8  b.eq is_sep                0x0d8 + 0x4c = 0x124

: bit: '0' (48) or '1' (49) only
00000000 11000000 00000000 01010001                                       : 0x0dc  sub w0, w0, #48            '0' -> 0, '1' -> 1
00011111 00000100 00000000 01110001                                       : 0x0e0  cmp w0, #1
00101000 00000011 00000000 01010100                                       : 0x0e4  b.hi fail                  0x0e4 + 0x64 = 0x148 (not '0' or '1')
00010011 00000100 00010011 10001011                                       : 0x0e8  add x19, x0, x19, lsl #1   acc = (acc << 1) + bit
10010100 00000110 00000000 10010001                                       : 0x0ec  add x20, x20, #1           cnt += 1
10011111 00100010 00000000 11110001                                       : 0x0f0  cmp x20, #8
10000001 11111100 11111111 01010100                                       : 0x0f4  b.ne loop                  0x0f4 - 0x70 = 0x084 (group not complete)

