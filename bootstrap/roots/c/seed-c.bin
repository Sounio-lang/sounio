11110011 00000011 00000000 00111001                                       : 0x0f8  strb w19, [sp, #0]
00001000 00001000 10000000 11010010                                       : 0x0fc  movz x8, #64               syscall 64 = write
00100000 00000000 10000000 11010010                                       : 0x100  movz x0, #1                fd 1 = stdout
11100001 00000011 00000000 10010001                                       : 0x104  add x1, sp, #0             buffer = sp
00100010 00000000 10000000 11010010                                       : 0x108  movz x2, #1                count = 1
00000001 00000000 00000000 11010100                                       : 0x10c  svc #0
00011111 00000100 00000000 11110001                                       : 0x110  cmp x0, #1
10100001 00000001 00000000 01010100                                       : 0x114  b.ne fail                  0x114 + 0x34 = 0x148 (write failed)
00010011 00000000 10000000 11010010                                       : 0x118  movz x19, #0               acc = 0
00010100 00000000 10000000 11010010                                       : 0x11c  movz x20, #0               cnt = 0
11011001 11111111 11111111 00010111                                       : 0x120  b loop                     0x120 - 0x9c = 0x084

