00000000 00000000 10000000 11010010                                       : 0x088  movz x0, #0                fd 0 = stdin
11100001 00000011 00000000 10010001                                       : 0x08c  add x1, sp, #0             buffer = sp
00100010 00000000 10000000 11010010                                       : 0x090  movz x2, #1                count = 1
00000001 00000000 00000000 11010100                                       : 0x094  svc #0
00011111 00000000 00000000 11110001                                       : 0x098  cmp x0, #0
01101011 00000101 00000000 01010100                                       : 0x09c  b.lt fail                  0x09c + 0xac = 0x148: read failed
11000000 00000100 00000000 01010100                                       : 0x0a0  b.eq eof                   0x0a0 + 0x98 = 0x138: end of input
11100000 00000011 01000000 00111001                                       : 0x0a4  ldrb w0, [sp, #0]

: inside a comment: skip everything up to and including the newline
10110101 00000000 00000000 10110100                                       : 0x0a8  cbz x21, notc              0x0a8 + 0x14 = 0x0bc
00011111 00101000 00000000 01110001                                       : 0x0ac  cmp w0, #10                '\n'
10100001 11111110 11111111 01010100                                       : 0x0b0  b.ne loop                  0x0b0 - 0x2c = 0x084
00010101 00000000 10000000 11010010                                       : 0x0b4  movz x21, #0               newline ends the comment
11110011 11111111 11111111 00010111                                       : 0x0b8  b loop                     0x0b8 - 0x34 = 0x084

