; Cross-check listing: seed-a (bootstrap/roots/a) rendered in format B, so that
; seed-b can assemble it. The bytes are the same as seed-a.hex; the comments
; below are seed-a.hex's, verbatim, and describe seed-a and its format A.
;
; seed-a: the first loader of bootstrap root A. Written by hand, byte by byte.
;
; What it does: reads a listing from standard input and writes the bytes it
; describes to standard output.
;
; Format A, the format of this file:
;   - a byte is two lowercase hexadecimal digits, 0-9 and a-f;
;   - the two digits of a byte may be separated by whitespace;
;   - whitespace is space (0x20), tab (0x09) and newline (0x0a);
;   - '#' starts a comment that runs to the end of the line.
; Anything else is refused: uppercase digits, carriage return (0x0d), any
; other character, and an odd number of digits at the end of input.
;
; Exit status: 0 when the whole input was valid and every byte was written;
; 1 on a refused input, a failed read or a short write. Output is written as
; it is decoded, so on exit 1 the bytes already written must be discarded.
;
; Self-reproduction: `seed-a < seed-a.hex` writes exactly the bytes of `seed-a`.
;
; Layout: one ELF64 header (0x00-0x3f), one program header (0x40-0x77), code
; (0x78-0x10e). The file is loaded at virtual address 0x400000, so file offset
; X is address 0x400000 + X. Total 271 bytes.
;
; Machine state at entry: only rsp is used as given by the kernel. Every
; register the code reads is set first (r12, r14) or set by an instruction
; before use (eax, edi, esi, edx). Registers used:
;   r12  digit accumulator, with a sentinel: 1 means "no digit yet". One digit
;        makes it 0x10-0x1f, a second makes it 0x100-0x1ff: the low eight bits
;        are then the byte, which is written, and r12 goes back to 1.
;   r14  1 inside a comment, 0 outside.
;   [rsp] one-byte buffer for read and for write.

; ---------------------------------------------------------------- ELF header
177 105 114 106             ; 00  e_ident: magic 0x7f 'E' 'L' 'F'
002                         ; 04  EI_CLASS   = ELFCLASS64
001                         ; 05  EI_DATA    = little endian
001                         ; 06  EI_VERSION = 1
000                         ; 07  EI_OSABI   = System V
000 000 000 000 000 000 000 000 ; 08  EI_ABIVERSION and padding
002 000                     ; 10  e_type      = ET_EXEC
076 000                     ; 12  e_machine   = EM_X86_64
001 000 000 000             ; 14  e_version   = 1
170 000 100 000 000 000 000 000 ; 18  e_entry     = 0x400078 (start of the code)
100 000 000 000 000 000 000 000 ; 20  e_phoff     = 0x40
000 000 000 000 000 000 000 000 ; 28  e_shoff     = 0 (no section headers)
000 000 000 000             ; 30  e_flags     = 0
100 000                     ; 34  e_ehsize    = 64
070 000                     ; 36  e_phentsize = 56
001 000                     ; 38  e_phnum     = 1
000 000                     ; 3a  e_shentsize = 0
000 000                     ; 3c  e_shnum     = 0
000 000                     ; 3e  e_shstrndx  = 0

; ----------------------------------------------------------- program header
001 000 000 000             ; 40  p_type   = PT_LOAD
005 000 000 000             ; 44  p_flags  = PF_R | PF_X
000 000 000 000 000 000 000 000 ; 48  p_offset = 0
000 000 100 000 000 000 000 000 ; 50  p_vaddr  = 0x400000
000 000 100 000 000 000 000 000 ; 58  p_paddr  = 0x400000
017 001 000 000 000 000 000 000 ; 60  p_filesz = 0x10f (the whole file)
017 001 000 000 000 000 000 000 ; 68  p_memsz  = 0x10f
000 020 000 000 000 000 000 000 ; 70  p_align  = 0x1000

; --------------------------------------------------------------------- code
; Offsets on the left are file offsets. A jump's target is the offset of the
; next instruction plus the signed 8-bit displacement.

; start
101 274 001 000 000 000     ; 78  mov r12d, 1          accumulator: no digit yet
105 061 366                 ; 7e  xor r14d, r14d       not in a comment

; loop: read one byte into [rsp]
061 300                     ; 81  xor eax, eax         syscall 0 = read
061 377                     ; 83  xor edi, edi         fd 0 = stdin
110 211 346                 ; 85  mov rsi, rsp         buffer
152 001                     ; 88  push 1
132                         ; 8a  pop rdx              count = 1
017 005                     ; 8b  syscall
110 205 300                 ; 8d  test rax, rax
170 165                     ; 90  js fail              92 + 75 = 107: read failed
164 146                     ; 92  jz eof               94 + 66 = fa: end of input
017 266 004 044             ; 94  movzx eax, byte [rsp]

; inside a comment: skip everything up to and including the newline
105 205 366                 ; 98  test r14d, r14d
164 011                     ; 9b  jz notc              9d + 09 = a6
074 012                     ; 9d  cmp al, 0x0a
165 340                     ; 9f  jne loop             a1 - 20 = 81
105 061 366                 ; a1  xor r14d, r14d       newline ends the comment
353 333                     ; a4  jmp loop             a6 - 25 = 81

; notc: '#' opens a comment
074 043                     ; a6  cmp al, '#'
165 010                     ; a8  jne ws               aa + 08 = b2
101 276 001 000 000 000     ; aa  mov r14d, 1
353 317                     ; b0  jmp loop             b2 - 31 = 81

; ws: space, newline and tab are skipped
074 040                     ; b2  cmp al, ' '
164 313                     ; b4  je loop              b6 - 35 = 81
074 012                     ; b6  cmp al, 0x0a
164 307                     ; b8  je loop              ba - 39 = 81
074 011                     ; ba  cmp al, 0x09
164 303                     ; bc  je loop              be - 3d = 81

; digit value: '0'-'9' gives 0-9, 'a'-'f' gives 10-15, anything else fails.
; eax was zero-extended from the byte, so only al changes below.
054 060                     ; be  sub al, '0'
074 011                     ; c0  cmp al, 9
166 010                     ; c2  jbe nib              c4 + 08 = cc  ('0'-'9')
054 061                     ; c4  sub al, 'a' - '0'
074 005                     ; c6  cmp al, 5
167 075                     ; c8  ja fail              ca + 3d = 107 (not 'a'-'f')
004 012                     ; ca  add al, 10

; nib: shift the digit into the accumulator
101 301 344 004             ; cc  shl r12d, 4
101 011 304                 ; d0  or r12d, eax
101 201 374 000 001 000 000 ; d3  cmp r12d, 0x100
162 245                     ; da  jb loop              dc - 5b = 81  (first digit)

; second digit: write the low byte of the accumulator
104 210 044 044             ; dc  mov [rsp], r12b
152 001                     ; e0  push 1
130                         ; e2  pop rax              syscall 1 = write
211 307                     ; e3  mov edi, eax         fd 1 = stdout
110 211 346                 ; e5  mov rsi, rsp         buffer
211 302                     ; e8  mov edx, eax         count = 1
017 005                     ; ea  syscall
110 203 370 001             ; ec  cmp rax, 1
165 025                     ; f0  jne fail             f2 + 15 = 107 (write failed)
101 274 001 000 000 000     ; f2  mov r12d, 1          back to "no digit yet"
353 207                     ; f8  jmp loop             fa - 79 = 81

; eof: accept only if no digit is left over
101 203 374 001             ; fa  cmp r12d, 1
165 007                     ; fe  jne fail             100 + 07 = 107 (odd digit count)
152 074                     ; 100 push 60
130                         ; 102 pop rax              syscall 60 = exit
061 377                     ; 103 xor edi, edi         status 0
017 005                     ; 105 syscall

; fail
152 074                     ; 107 push 60
130                         ; 109 pop rax              syscall 60 = exit
152 001                     ; 10a push 1
137                         ; 10c pop rdi              status 1
017 005                     ; 10d syscall
; 10f end of file
