# sporos-stage1: loader + decode SPR1 + stack-effect checker (decision 31).
# Written by hand, byte by byte, in format A. A complete program: opens the
# file in argv[1], reads it whole (mremap growth, no ceiling), checks it is a
# well-formed, well-typed Sporos bytecode file, and exits 0. Exit 1: refused
# input, failed open/read, malformed or ill-typed file. Exit 2: kernel refused
# memory. Silent on all paths: the exit status is the verdict.
#
# Mirrors formal/Sporos/Bytecode.lean (decode) and formal/Sporos/Check.lean
# (infer/checkWord/checkProg) exactly; the stage-1 differential gate checks
# exit-status agreement with sporos_fast on vectors and fuzz.
#
# Instruction forms are those X86Dec decodes on main: 64-bit loads and
# stores (8B/89, mod 00/01), byte loads (0F B6) and stores (88), 32-bit
# register moves as zero-extending masks, call/ret for the three shared
# subroutines (L32 reads a u32, RDC reads one at the cursor, ANNL looks
# an ann index up). No 32-bit operation touches a pointer or a counter.
# The indirect jump (decision 38) arrives with the stage-2 dispatch.
#
# Registers, checker phase: rbx file base; r15 file end; rsi cursor;
# r14 words-table base (stride 64); r13 nwords; r12 main, then the ann
# lookup key; r11 lengths-scratch base (parse phase, a temp afterwards);
# rdi current word entry; rbp words remaining (check phase); rcx a loop
# count or the instruction index; r8 d, r9 a, the current height in the
# code walk; rax, rdx, r10 scratch across subroutine calls as documented
# at L32/RDC/ANNL. The only syscalls after entry are the two mmaps.
#
# Words-table entry (64 bytes): +0 ins, +8 outs, +16 locals, +24 ncode,
# +32 nann, +40 code pointer, +48 ann pointer. All fields u64 (u32 values
# zero-extended).
#
# Layout: ELF64 header (0x00-0x3f), program header (0x40-0x77), code.
# Loaded at 0x400000; file offset X is address 0x400000+X.

# ------------------------------ ELF header
7f 45 4c 46 02 01 01 00 00 00 00 00 00 00 00 00   # 0   e_ident: ELF64 LE v1 SysV
02 00 3e 00 01 00 00 00                            # 10   e_type EXEC, e_machine X86-64, e_version
78 00 40 00 00 00 00 00                            # 18   e_entry = 0x400078 (start of code)
40 00 00 00 00 00 00 00                            # 20   e_phoff = 0x40
00 00 00 00 00 00 00 00                            # 28   e_shoff
00 00 00 00                                        # 30   e_flags
40 00                                              # 34   e_ehsize = 64
38 00                                              # 36   e_phentsize = 56
01 00                                              # 38   e_phnum = 1
00 00                                              # 3a   e_shentsize
00 00                                              # 3c   e_shnum
00 00                                              # 3e   e_shstrndx

# --------------------------- program header
01 00 00 00                                        # 40   p_type = PT_LOAD
05 00 00 00                                        # 44   p_flags = R+X
00 00 00 00 00 00 00 00                            # 48   p_offset = 0
00 00 40 00 00 00 00 00                            # 50   p_vaddr = 0x400000
00 00 40 00 00 00 00 00                            # 58   p_paddr
6a 09 00 00 00 00 00 00                             # 60   p_filesz = 2410
6a 09 00 00 00 00 00 00                             # 68   p_memsz = 2410
00 10 00 00 00 00 00 00                            # 70   p_align = 0xfdb

# ----------------------------------- code
# start: argc in rax
58                                                 # 78   pop rax: argc
48 83 f8 02                                        # 79   cmp rax, 2
7d 05                                              # 7d   jge over E9: argc >= 2, keep going
e9 a0 00 00 00                                     # 7f   jmp fail1 (0x124): no program, refuse
5e                                                 # 84   pop rsi: argv[0], discard
5e                                                 # 85   pop rsi: argv[1], the path
b8 02 00 00 00                                     # 86   mov eax, 2: open
48 89 f7                                           # 8b   mov rdi, rsi: path
31 f6                                              # 8e   xor esi, esi: O_RDONLY
31 d2                                              # 90   xor edx, edx: mode unused, must be 0
0f 05                                              # 92   syscall
48 85 c0                                           # 94   test rax, rax
79 05                                              # 97   jns over E9: fd ok, keep going
e9 86 00 00 00                                     # 99   jmp fail1 (0x124): -errno
49 89 c6                                           # 9e   mov r14, rax: fd
b8 09 00 00 00                                     # a1   mov eax, 9: mmap
31 ff                                              # a6   xor edi, edi: addr 0
be 00 00 01 00                                     # a8   mov esi, 0xffdb: 64 KiB first region
ba 03 00 00 00                                     # ad   mov edx, 3: PROT_READ|PROT_WRITE
41 ba 22 00 00 00                                  # b2   mov r10d, 0x22: MAP_PRIVATE|MAP_ANONYMOUS
6a ff                                              # b8   push -1
41 58                                              # ba   pop r8: fd -1
4d 31 c9                                           # bc   xor r9d, r9d: offset 0
0f 05                                              # bf   syscall
48 85 c0                                           # c1   test rax, rax
79 05                                              # c4   jns over E9: mapping ok, keep going
e9 61 00 00 00                                     # c6   jmp fail2 (0x12c): -ENOMEM, exit 2
48 89 c3                                           # cb   mov rbx, rax: base
41 bc 00 00 01 00                                  # ce   mov r12d, 0xffdb: capacity
4d 31 ed                                           # d4   xor r13d, r13d: held 0

# readloop: read(fd, base+held, cap-held). Entered by fall-through from init.
48 89 de                                           # d7   mov rsi, rbx
4c 01 ee                                           # da   add rsi, r13
4c 89 e2                                           # dd   mov rdx, r12
4c 29 ea                                           # e0   sub rdx, r13: remaining
31 c0                                              # e3   xor eax, eax: read
44 89 f7                                           # e5   mov edi, r14d: fd
0f 05                                              # e8   syscall
48 85 c0                                           # ea   test rax, rax
78 35                                              # ed   js fail1 (0x124): failed read
74 31                                              # ef   jz loaded (0x122): EOF
49 01 c5                                           # f1   add r13, rax: held += n
4c 89 e2                                           # f4   mov rdx, r12
4c 29 ea                                           # f7   sub rdx, r13: remaining
75 db                                              # fa   jnz readloop (0xd7): room left
# grow: mremap(base, cap, 2*cap, MREMAP_MAYMOVE)
b8 19 00 00 00                                     # fc   mov eax, 25: mremap
48 89 df                                           # 101  mov rdi, rbx: old base
4c 89 e6                                           # 104  mov rsi, r12: old len
4c 89 e2                                           # 107  mov rdx, r12
48 01 d2                                           # 10a  add rdx, rdx: new len = 2*cap
41 ba 01 00 00 00                                  # 10d   mov r10d, 1: MREMAP_MAYMOVE
0f 05                                              # 113  syscall
48 85 c0                                           # 115  test rax, rax
78 12                                              # 118   js fail2 (0x12c): -ENOMEM
48 89 c3                                           # 11a  mov rbx, rax: new base
49 89 d4                                           # 11d  mov r12, rdx: new capacity
eb b5                                              # 120   jmp readloop (0xd7)

# loaded: rbx = base, r13 = held length. Checker starts here.
eb 10                                              # 122   jmp checker (0x134): over the fail blocks
# fail1: refuse or malformed file, exit 1. Reached only by forward jumps.
6a 3c                                              # 124   push 60
58                                                 # 126   pop rax: exit
6a 01                                              # 127   push 1
5f                                                 # 129   pop rdi: status 1
0f 05                                              # 12a   syscall

# fail2: kernel refused memory, exit 2. Reached only by forward jumps.
6a 3c                                              # 12c   push 60
58                                                 # 12e   pop rax: exit
6a 02                                              # 12f   push 2
5f                                                 # 131   pop rdi: status 2
0f 05                                              # 132   syscall

# checker: all operations on pointers and counters are 64-bit. A u32 file
# field is read with a 64-bit load and masked by a 32-bit register move
# (mov eax, eax and its kin zero-extend): the load may read the next field,
# which the mask then drops. Later code reads u32s through the L32
# subroutine (four byte loads), which never reads past the field.
49 89 df                                           # 134  mov r15, rbx: end = base, then += held
4d 01 ef                                           # 137  add r15, r13
48 89 de                                           # 13a  mov rsi, rbx: cursor = base
49 83 fd 10                                        # 13d  cmp r13, 16: the header must be present
73 05                                              # 141  jae +5: held >= 16, keep going
e9 dc ff ff ff                                     # 143   jmp fail1 (0x124)
48 8b 06                                           # 148  mov rax, [rsi]: magic, upper half dropped next
89 c0                                              # 14b  mov eax, eax: mask to 32 bits
48 81 f8 53 50 52 31                               # 14d  cmp rax, 0x3152502e: "SPR1"
74 05                                              # 154  jz +5: magic matches, keep going
e9 c9 ff ff ff                                     # 156   jmp fail1 (0x124)
48 89 f2                                           # 15b  mov rdx, rsi
48 83 c2 04                                        # 15e  add rdx, 4
48 8b 02                                           # 162  mov rax, [rdx]: main
41 89 c4                                           # 165  mov r12d, eax: mask to 32 bits
48 89 f2                                           # 168  mov rdx, rsi
48 83 c2 08                                        # 16b  add rdx, 8
48 8b 02                                           # 16f  mov rax, [rdx]: nwords
41 89 c2                                           # 172  mov r10d, eax: mask to 32 bits
48 89 f2                                           # 175  mov rdx, rsi
48 83 c2 0c                                        # 178  add rdx, 12
48 8b 02                                           # 17c  mov rax, [rdx]: ndata
89 c1                                              # 17f  mov ecx, eax: mask to 32 bits
48 83 c6 10                                        # 181  add rsi, 16: cursor past header
4d 85 d2                                           # 185  test r10, r10: nwords == 0 refuses
75 05                                              # 188  jnz +5
e9 95 ff ff ff                                     # 18a   jmp fail1 (0x124)
# data_loop: skip the data segments
48 85 c9                                           # 18f  test rcx, rcx
74 33                                              # 192  jz data_done (0x1c7)
4c 89 fa                                           # 194  mov rdx, r15
48 29 f2                                           # 197  sub rdx, rsi: remaining
48 83 fa 04                                        # 19a  cmp rdx, 4
73 05                                              # 19e  jae +5: a len field fits, keep going
e9 7f ff ff ff                                     # 1a0   jmp fail1 (0x124)
48 8b 06                                           # 1a5  mov rax, [rsi]: len
89 c0                                              # 1a8  mov eax, eax: mask to 32 bits
48 83 c6 04                                        # 1aa  add rsi, 4
4c 89 fa                                           # 1ae  mov rdx, r15
48 29 f2                                           # 1b1  sub rdx, rsi: remaining
48 29 c2                                           # 1b4  sub rdx, rax: remaining - len, carry if short
73 05                                              # 1b7  jae +5: the payload fits, keep going
e9 66 ff ff ff                                     # 1b9   jmp fail1 (0x124)
48 01 c6                                           # 1be  add rsi, rax: skip len bytes
48 83 e9 01                                        # 1c1  sub rcx, 1
eb c8                                              # 1c5  jmp data_loop (0x18f)
# data_done: mmap the words table (nwords * 64, stride 64). The cursor
# is saved first: both mmap sequences take their length in rsi.
56                                                 # 1c7  push rsi: save words-start cursor
44 89 d2                                           # 1c8  mov edx, r10d: nwords, zero-extended
48 01 d2                                           # 1cb  add rdx, rdx: *2
48 01 d2                                           # 1ce  *4
48 01 d2                                           # 1d1  *8
48 01 d2                                           # 1d4  *16
48 01 d2                                           # 1d7  *32
48 01 d2                                           # 1da  *64
b8 09 00 00 00                                     # 1dd  mov eax, 9: mmap
31 ff                                              # 1e2  xor edi, edi
48 89 d6                                           # 1e4  mov rsi, rdx: length
ba 03 00 00 00                                     # 1e7  mov edx, 3
41 ba 22 00 00 00                                  # 1ec  mov r10d, 0x22
6a ff                                              # 1f2  push -1
41 58                                              # 1f4  pop r8
4d 31 c9                                           # 1f6  xor r9d, r9d
0f 05                                              # 1f9  syscall
48 85 c0                                           # 1fb  test rax, rax
79 05                                              # 1fe  jns +5: mapping ok, keep going
e9 27 ff ff ff                                     # 200   jmp fail2 (0x12c)
49 89 c6                                           # 205  mov r14, rax: words table
# scratch mmap(flen) for instruction lengths, indexed by file offset
b8 09 00 00 00                                     # 208  mov eax, 9
31 ff                                              # 20d  xor edi, edi
4c 89 ee                                           # 20f  mov rsi, r13: flen
ba 03 00 00 00                                     # 212  mov edx, 3
41 ba 22 00 00 00                                  # 217  mov r10d, 0x22
6a ff                                              # 21d  push -1
41 58                                              # 21f  pop r8
4d 31 c9                                           # 221  xor r9d, r9d
0f 05                                              # 224  syscall
48 85 c0                                           # 226  test rax, rax
79 05                                              # 229  jns +5: mapping ok, keep going
e9 fc fe ff ff                                     # 22b   jmp fail2 (0x12c)
49 89 c3                                           # 230  mov r11, rax: lengths scratch
5e                                                 # 233  pop rsi: restore cursor
4c 89 f7                                           # 234  mov rdi, r14: entry pointer
# r10 held nwords, but both mmap sequences reused it for 0x22 (1ec, 217).
# Reload nwords from the header into r13 (register map at the top); r13
# held the file length, which r15 now carries as the end pointer.
4c 8b 6b 08                                        # 237  mov r13, [rbx+8]: nwords
45 89 ed                                           # 23b  mov r13d, r13d: mask to 32 bits
# Pop the rest of the initial frame (env and aux words, never read):
# the checker's calls nest six slots deep (annval into ANNL into L32),
# and the entry code freed only the three words it popped.
58 58 58 58 58 58                                  # 23e  pop rax, six times: stack room for the calls

e9 5b 00 00 00                                     # 244  jmp parse_start (0x2a4), over the subroutines
# L32: read a u32 little-endian at rdx (bounds are the caller's), return
# it zero-extended in rax. One instruction since Ins.ld32: never reads
# past the field. Clobbers rax; preserves everything else including rdx.
8b 02                                              # 249  mov eax, [rdx]
c3                                                 # 24b  ret
# RDC: read a u32 at the cursor rsi and advance it by 4. Refuses (fail1)
# unless four bytes remain before r15. Returns the value in rax.
# Clobbers rax, rdx and r10.
4c 89 fa                                           # 24c  mov rdx, r15
48 29 f2                                           # 24f  sub rdx, rsi: remaining, carry if cursor past end
73 05                                              # 252  jae +5: cursor in range, keep going
e9 cb fe ff ff                                     # 254   jmp fail1 (0x124)
48 83 fa 04                                        # 259  cmp rdx, 4
73 05                                              # 25d  jae +5: four bytes remain, keep going
e9 c0 fe ff ff                                     # 25f   jmp fail1 (0x124)
48 89 f2                                           # 264  mov rdx, rsi
e8 dd ff ff ff                                     # 267  call L32 (0x249)
48 83 c6 04                                        # 26c  add rsi, 4
c3                                                 # 270  ret
# ANNL: first ann entry of the word at rdi whose index is r12, as a
# pointer in rax, or 0 when there is none (List.lookup is first-match).
# Clobbers rax, rdx and r10; preserves rcx and r12.
51                                                 # 271  push rcx
48 8b 47 30                                        # 272  mov rax, [rdi+48]: ann pointer
48 8b 4f 20                                        # 276  mov rcx, [rdi+32]: nann
# ANNL loop:
48 85 c9                                           # 27a  test rcx, rcx
74 1c                                              # 27d  jz ANNL_none (0x29b)
48 89 c2                                           # 27f  mov rdx, rax: entry pointer
50                                                 # 282  push rax: save it over the call
e8 c1 ff ff ff                                     # 283  call L32 (0x249): rax = this index
5a                                                 # 288  pop rdx: entry pointer back
4c 39 e0                                           # 289  cmp rax, r12
74 11                                              # 28c  jz ANNL_found (0x29f)
48 89 d0                                           # 28e  mov rax, rdx
48 83 c0 0c                                        # 291  add rax, 12: next ann entry
48 83 e9 01                                        # 295  sub rcx, 1
eb df                                              # 299  jmp ANNL loop (0x27a)
# ANNL_none:
31 c0                                              # 29b  xor eax, eax
59                                                 # 29d  pop rcx
c3                                                 # 29e  ret
# ANNL_found:
48 89 d0                                           # 29f  mov rax, rdx: the entry pointer
59                                                 # 2a2  pop rcx
c3                                                 # 2a3  ret
# parse_start: decode every word (Bytecode.decode), filling the words
# table at r14 and the length scratch at r11. rsi is the cursor, rdi the
# current table entry, rcx the words still to parse.
4c 89 e9                                           # 2a4  mov rcx, r13: nwords
# parse_word:
48 85 c9                                           # 2a7  test rcx, rcx
75 05                                              # 2aa  jnz +5: words remain, keep going
e9 43 01 00 00                                     # 2ac   jmp parse_done (0x3f4)
e8 96 ff ff ff                                     # 2b1  call RDC (0x24c): ins
48 89 07                                           # 2b6  mov [rdi], rax
e8 8e ff ff ff                                     # 2b9  call RDC: outs
48 89 47 08                                        # 2be  mov [rdi+8], rax
e8 85 ff ff ff                                     # 2c2  call RDC: locals
48 89 47 10                                        # 2c7  mov [rdi+16], rax
e8 7c ff ff ff                                     # 2cb  call RDC: ncode
48 89 47 18                                        # 2d0  mov [rdi+24], rax
e8 73 ff ff ff                                     # 2d4  call RDC: nann
48 89 47 20                                        # 2d9  mov [rdi+32], rax
48 89 77 28                                        # 2dd  mov [rdi+40], rsi: code pointer
51                                                 # 2e1  push rcx: words remaining, over the instr loop
48 8b 4f 18                                        # 2e2  mov rcx, [rdi+24]: ncode
# instr_loop: validate one instruction, store its length in the scratch
48 85 c9                                           # 2e6  test rcx, rcx
75 05                                              # 2e9  jnz +5: instructions remain, keep going
e9 c6 00 00 00                                     # 2eb   jmp instr_done (0x3b6)
4c 89 fa                                           # 2f0  mov rdx, r15
48 29 f2                                           # 2f3  sub rdx, rsi: remaining, carry if past end
73 05                                              # 2f6  jae +5: cursor in range, keep going
e9 27 fe ff ff                                     # 2f8   jmp fail1 (0x124)
48 83 fa 01                                        # 2fd  cmp rdx, 1
73 05                                              # 301  jae +5: an opcode byte remains, keep going
e9 1c fe ff ff                                     # 303   jmp fail1 (0x124)
0f b6 06                                           # 308  movzx eax, byte [rsi]: opcode
48 83 f8 39                                        # 30b  cmp rax, 57: below is a primitive
73 05                                              # 30f  jae +5: not a primitive, keep decoding
e9 72 00 00 00                                     # 311   jmp len1 (0x388)
48 81 f8 80 00 00 00                               # 316  cmp rax, 0x80: lit takes a u64
75 05                                              # 31d  jnz +5
e9 5c 00 00 00                                     # 31f   jmp len9 (0x380)
48 81 f8 83 00 00 00                               # 324  cmp rax, 0x83: tor
75 05                                              # 32b  jnz +5
e9 56 00 00 00                                     # 32d   jmp len1 (0x388)
48 81 f8 84 00 00 00                               # 332  cmp rax, 0x84: fromr
75 05                                              # 339  jnz +5
e9 48 00 00 00                                     # 33b   jmp len1 (0x388)
48 81 f8 85 00 00 00                               # 340  cmp rax, 0x85: rfetch
75 05                                              # 347  jnz +5
e9 3a 00 00 00                                     # 349   jmp len1 (0x388)
48 81 f8 8c 00 00 00                               # 34e  cmp rax, 0x8c: ret
75 05                                              # 355  jnz +5
e9 2c 00 00 00                                     # 357   jmp len1 (0x388)
48 81 f8 81 00 00 00                               # 35c  cmp rax, 0x81: u32-immediate forms start here
73 05                                              # 363  jae +5: in range so far, keep going
e9 ba fd ff ff                                     # 365   jmp fail1 (0x124): 0x39..0x7f refuse
48 81 f8 8b 00 00 00                               # 36a  cmp rax, 0x8b: call is the last u32 form
76 05                                              # 371  jbe +5: 0x81..0x8b, keep going
e9 ac fd ff ff                                     # 373   jmp fail1 (0x124): 0x8d.. refuse
41 ba 05 00 00 00                                  # 378  mov r10d, 5: len5
eb 0e                                              # 37e  jmp len_done (0x38e)
41 ba 09 00 00 00                                  # 380  mov r10d, 9: len9
eb 06                                              # 386  jmp len_done (0x38e)
41 ba 01 00 00 00                                  # 388  mov r10d, 1: len1
# len_done (0x38e): the whole instruction must fit before r15
4c 89 fa                                           # 38e  mov rdx, r15
48 29 f2                                           # 391  sub rdx, rsi: remaining
4c 39 d2                                           # 394  cmp rdx, r10: remaining against the length
73 05                                              # 397  jae +5: it fits, keep going
e9 86 fd ff ff                                     # 399   jmp fail1 (0x124)
48 89 f2                                           # 39e  mov rdx, rsi
48 29 da                                           # 3a1  sub rdx, rbx: file offset of this instruction
4c 01 da                                           # 3a4  add rdx, r11: its scratch slot
44 88 12                                           # 3a7  mov [rdx], r10b: store the length
4c 01 d6                                           # 3aa  add rsi, r10: advance past the instruction
48 83 e9 01                                        # 3ad  sub rcx, 1
e9 30 ff ff ff                                     # 3b1  jmp instr_loop (0x2e6)
# instr_done:
59                                                 # 3b6  pop rcx: words remaining back
48 89 77 30                                        # 3b7  mov [rdi+48], rsi: ann pointer
48 8b 47 20                                        # 3bb  mov rax, [rdi+32]: nann
48 89 c2                                           # 3bf  mov rdx, rax
48 01 c0                                           # 3c2  add rax, rax: *2
48 01 c0                                           # 3c5  *4
48 01 d2                                           # 3c8  add rdx, rdx: *2
48 01 d2                                           # 3cb  *4
48 01 d2                                           # 3ce  *8
48 01 d0                                           # 3d1  add rax, rdx: nann * 12
4c 89 fa                                           # 3d4  mov rdx, r15
48 29 f2                                           # 3d7  sub rdx, rsi: remaining
48 39 c2                                           # 3da  cmp rdx, rax
73 05                                              # 3dd  jae +5: the ann records fit, keep going
e9 40 fd ff ff                                     # 3df   jmp fail1 (0x124)
48 01 c6                                           # 3e4  add rsi, rax: skip the ann records
48 83 c7 40                                        # 3e7  add rdi, 64: next table entry
48 83 e9 01                                        # 3eb  sub rcx, 1
e9 b3 fe ff ff                                     # 3ef  jmp parse_word (0x2a7)
# parse_done: trailing bytes refuse; then checkProg's main clause
4c 39 fe                                           # 3f4  cmp rsi, r15: cursor exactly at end
74 05                                              # 3f7  jz +5: no trailing bytes, keep going
e9 26 fd ff ff                                     # 3f9   jmp fail1 (0x124)
4d 39 ec                                           # 3fe  cmp r12, r13: main against nwords
72 05                                              # 401  jb +5: main in range, keep going
e9 1c fd ff ff                                     # 403   jmp fail1 (0x124)
4c 89 e2                                           # 408  mov rdx, r12
48 01 d2                                           # 40b  add rdx, rdx: *2
48 01 d2                                           # 40e  *4
48 01 d2                                           # 411  *8
48 01 d2                                           # 414  *16
48 01 d2                                           # 417  *32
48 01 d2                                           # 41a  *64
4c 01 f2                                           # 41d  add rdx, r14: the main word entry
48 8b 02                                           # 420  mov rax, [rdx]: its ins
48 85 c0                                           # 423  test rax, rax
74 05                                              # 426  jz +5: main takes no arguments, keep going
e9 f7 fc ff ff                                     # 428   jmp fail1 (0x124)
# check_start: the stack-effect checker (Check.checkWord under infer,
# single pass per word). rbp counts the words, rdi is the current entry.
# Per word: ncode > 0; every ann entry in range and equal to the first
# entry at its index; then the code walk keeps h = (r8, r9) through each
# instruction exactly as hstep prescribes. All comparisons unsigned.
4c 89 f7                                           # 42d  mov rdi, r14
4c 89 ed                                           # 430  mov rbp, r13: nwords
# check_word:
48 85 ed                                           # 433  test rbp, rbp
75 05                                              # 436  jnz +5: words remain, keep going
e9 b3 04 00 00                                     # 438   jmp accept (0x8f0)
48 8b 47 18                                        # 43d  mov rax, [rdi+24]: ncode
48 85 c0                                           # 441  test rax, rax
75 05                                              # 444  jnz +5: code is not empty, keep going
e9 d9 fc ff ff                                     # 446   jmp fail1 (0x124)
48 8b 77 30                                        # 44b  mov rsi, [rdi+48]: ann pointer, the outer scan
48 8b 4f 20                                        # 44f  mov rcx, [rdi+32]: nann
# annval: this entry's index in range, its height the first entry's
48 85 c9                                           # 453  test rcx, rcx
75 05                                              # 456  jnz +5: ann entries remain, keep going
e9 78 00 00 00                                     # 458   jmp codewalk (0x4d5)
