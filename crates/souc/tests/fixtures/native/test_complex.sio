// Complex test file with functions, loops, and conditionals
fn add(a: i32, b: i32) -> i32 {
    a + b
}

fn factorial(n: i32) -> i32 {
    if n <= 1 {
        1
    } else {
        n * factorial(n - 1)
    }
}

fn sum_array(arr: &[i32], len: usize) -> i32 {
    var sum: i32 = 0;
    var i: usize = 0;
    while i < len {
        sum = sum + arr[i];
        i = i + 1;
    }
    sum
}

fn main() -> i32 {
    let x = add(10, 20);
    let y = factorial(5);
    let arr = [1, 2, 3, 4, 5];
    let s = sum_array(&arr, 5);
    x + y + s
}
