// Example: Extracting value and confidence from Knowledge<T>

fn extract_value_and_confidence(ep: Knowledge<f64>) -> (f64, f64) {
    // Extract raw value
    let val = ep.value()
    
    // Extract confidence
    let conf = ep.confidence()
    
    (val, conf)
}

fn main() -> f64 {
    let measurement = measure(42.0, uncertainty: 2.0)  // confidence ~0.95
    
    // Extract components
    let (value, confidence) = extract_value_and_confidence(measurement)
    
    // Use raw value in computation
    value * 2.0
}
