// Example: Basic epistemic operations with Knowledge<T>
// This demonstrates confidence propagation through arithmetic

fn compute_dose(weight: Knowledge<kg>, dose_per_kg: Knowledge<mg/kg>) -> Knowledge<mg> {
    // Confidence propagates: min(weight.conf, dose_per_kg.conf)
    weight * dose_per_kg
}

fn main() -> Knowledge<mg> {
    // Create epistemic values with uncertainty
    let w = measure(70.0, uncertainty: 1.0)  // 70 ± 1 kg, confidence ~0.99
    let d = measure(5.0, uncertainty: 0.1)   // 5 ± 0.1 mg/kg, confidence ~0.98
    
    // Compute dose - confidence propagates through multiplication
    compute_dose(w, d)
}
