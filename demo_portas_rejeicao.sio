// ============================================================================
// SOUNIO DEMO 3: Portas de Confiança Dinâmicas (Dynamic Confidence Gates)
// ============================================================================
//
// O Sounio possui um expansor de guardas dinâmicas que analisa restrições de
// 'where' ligadas a 'Knowledge<T>' e injeta asserções automáticas de runtime.
//
// Como testar:
//
// 1. Rode o caso de sucesso (Idade = 21):
//    - O Sounio expande as guardas e executa o programa normalmente.
//    - Comando:
//      bash scripts/ontology/expand_knowledge_runtime_guards.sh demo_portas_sucesso.sio /tmp/demo3_sucesso.sio && ./bin/souc run /tmp/demo3_sucesso.sio
//
// 2. Rode o caso de rejeição (Idade = 13):
//    - O Sounio expande as guardas, mas o assert de segurança falha no runtime!
//    - Comando:
//      bash scripts/ontology/expand_knowledge_runtime_guards.sh demo_portas_rejeicao.sio /tmp/demo3_rejeicao.sio && ./bin/souc run /tmp/demo3_rejeicao.sio
// ============================================================================

struct Patient {
    age: i64,
}

fn obter_idade() -> i64 {
    return 13 // Idade inválida (rejeição)
}

fn criar_paciente() -> Knowledge<Patient where { age >= 18 }> with Panic {
    return Knowledge {
        value: Patient {
            age: obter_idade(),
        }
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("=== Sounio Demo 3: Portas de Confiança Dinâmicas (Rejeição) ===")
    
    let paciente = criar_paciente()
    
    println("[SOUC] Este print não será executado por conta da falha na guarda!")
    return 0
}
