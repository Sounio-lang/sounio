{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-cutover-approval.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Canonical Cutover Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approval_type",
    "authority_scope",
    "approval_context",
    "canonical_cutover_approval_status",
    "canonical_cutover_execution_status",
    "source_removal_status",
    "source_bindings",
    "canonical_repository",
    "destinations",
    "operator_approval",
    "explicit_cli_confirmations",
    "recovery_plan",
    "rehearsal_evidence",
    "assurance_level",
    "limitations",
    "approval_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-cutover-approval.v1"},
    "approval_type": {"const": "policy-bound-canonical-cutover-approval"},
    "authority_scope": {"const": "exact-git-repository-tree-cutover-approval"},
    "approval_context": {"enum": ["disposable-fixture", "canonical-production"]},
    "canonical_cutover_approval_status": {"const": "approved-not-executed"},
    "canonical_cutover_execution_status": {"const": "not-executed"},
    "source_removal_status": {"const": "not-executed"},
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_file_sha256",
        "authorization_identity_sha256",
        "materialization_file_sha256",
        "materialization_identity_sha256",
        "inventory_identity_sha256",
        "pre_cutover_tree_sha256",
        "authorized_post_cutover_tree_sha256",
        "removal_scope_identity_sha256",
        "repair_set_identity_sha256",
        "gate_set_identity_sha256",
        "cutover_policy_file_sha256",
        "cutover_policy_identity_sha256"
      ],
      "properties": {
        "authorization_file_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_file_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "pre_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_post_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "removal_scope_identity_sha256": {"$ref": "#/$defs/sha256"},
        "repair_set_identity_sha256": {"$ref": "#/$defs/sha256"},
        "gate_set_identity_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_policy_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonical_repository": {"$ref": "#/$defs/verifiedCanonicalRepository"},
    "destinations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verifiedDestination"}},
    "operator_approval": {"$ref": "#/$defs/operatorApproval"},
    "explicit_cli_confirmations": {"$ref": "#/$defs/explicitCliConfirmations"},
    "recovery_plan": {"$ref": "#/$defs/verifiedRecoveryPlan"},
    "rehearsal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup_type",
        "pre_cutover_tree_sha256",
        "authorized_post_cutover_tree_sha256",
        "restored_tree_sha256",
        "authorized_unit_count",
        "authorized_file_count",
        "repair_evidence",
        "post_removal_gates",
        "rehearsal_status"
      ],
      "properties": {
        "backup_type": {"const": "full-regular-file-pre-cutover-copy"},
        "pre_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_post_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "restored_tree_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_unit_count": {"type": "integer", "minimum": 1},
        "authorized_file_count": {"type": "integer", "minimum": 1},
        "repair_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rehearsedRepair"}},
        "post_removal_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rehearsedGate"}},
        "rehearsal_status": {"const": "removed-repaired-gates-passed-and-pre-tree-restored"}
      }
    },
    "assurance_level": {"const": "identity-plus-git-remote-ref"},
    "limitations": {
      "const": [
        "does_not_execute_the_canonical_cutover",
        "does_not_remove_any_source_from_the_bound_canonical_repository",
        "approval_is_limited_to_the_exact_bound_git_repositories_and_refs",
        "disposable_fixture_receipt_is_not_canonical_production_approval",
        "git_remote_ref_observation_does_not_prove_hosting_administration_or_ownership",
        "does_not_transfer_ownership_or_maintainership",
        "operator_label_does_not_prove_human_identity_or_organizational_authority",
        "rehearsal_does_not_capture_every_production_environment_property",
        "git_object_ids_are_bound_as_observed_not_as_independent_signatures",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority",
        "does_not_assert_independent_replay"
      ]
    },
    "approval_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verifiedCanonicalRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "head_oid",
        "remote_head_oid",
        "worktree_status",
        "remote_ref_status",
        "retained_marker",
        "canonical_repository_status"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "remote_head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"},
        "remote_ref_status": {"const": "head-equals-remote-branch"},
        "retained_marker": {"$ref": "#/$defs/fileEvidence"},
        "canonical_repository_status": {"const": "clean-head-equals-remote"}
      }
    },
    "verifiedDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "ring",
        "target_id",
        "target_owner",
        "checkout_path",
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "head_oid",
        "remote_head_oid",
        "worktree_status",
        "remote_ref_status",
        "file_count",
        "total_bytes",
        "tree_sha256",
        "owner_approval_evidence",
        "destination_status"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "ring": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "target_owner": {"type": "string", "minLength": 1},
        "checkout_path": {"type": "string", "minLength": 1},
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "remote_head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"},
        "remote_ref_status": {"const": "head-equals-remote-branch"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "owner_approval_evidence": {"$ref": "#/$defs/fileEvidence"},
        "destination_status": {"const": "clean-head-equals-remote-and-content-verified"}
      }
    },
    "operatorApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approval_evidence",
        "authorization_identity_confirmation",
        "scope_identity_confirmation",
        "pre_cutover_tree_confirmation",
        "authorized_post_cutover_tree_confirmation",
        "destination_set_identity_confirmation",
        "recovery_plan_identity_confirmation",
        "repairs_reviewed",
        "gates_reviewed"
      ],
      "properties": {
        "approved_by": {"$ref": "#/$defs/safeToken"},
        "approval_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileEvidence"}},
        "authorization_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "scope_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "pre_cutover_tree_confirmation": {"$ref": "#/$defs/sha256"},
        "authorized_post_cutover_tree_confirmation": {"$ref": "#/$defs/sha256"},
        "destination_set_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "recovery_plan_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "repairs_reviewed": {"const": true},
        "gates_reviewed": {"const": true}
      }
    },
    "explicitCliConfirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_identity_sha256",
        "scope_identity_sha256",
        "policy_identity_sha256",
        "pre_cutover_tree_sha256",
        "confirmation_status"
      ],
      "properties": {
        "authorization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "scope_identity_sha256": {"$ref": "#/$defs/sha256"},
        "policy_identity_sha256": {"$ref": "#/$defs/sha256"},
        "pre_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "confirmation_status": {"const": "matched"}
      }
    },
    "recoveryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_type",
        "canonical_repository_id",
        "required_backup_model",
        "transaction_workspace",
        "receipt_commit_point",
        "no_receipt_recovery",
        "receipt_present_recovery",
        "crash_atomicity",
        "approved_by"
      ],
      "properties": {
        "schema": {"const": "sounio.physical-extraction-canonical-cutover-recovery-plan.v1"},
        "plan_type": {"const": "full-regular-file-backup-and-explicit-rollback"},
        "canonical_repository_id": {"$ref": "#/$defs/safeToken"},
        "required_backup_model": {"const": "full-regular-file-pre-execution-copy"},
        "transaction_workspace": {"const": "same-filesystem-external"},
        "receipt_commit_point": {"const": "atomic-hardlink-after-verification"},
        "no_receipt_recovery": {"const": "restore-and-verify-pre-cutover-tree"},
        "receipt_present_recovery": {"const": "committed-state-manual-review"},
        "crash_atomicity": {"const": "not-guaranteed-across-multiple-filesystem-operations"},
        "approved_by": {"$ref": "#/$defs/safeToken"}
      }
    },
    "verifiedRecoveryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_evidence",
        "recovery_plan_identity_sha256",
        "pre_cutover_tree_confirmation",
        "authorized_post_cutover_tree_confirmation",
        "recovery_plan"
      ],
      "properties": {
        "plan_evidence": {"$ref": "#/$defs/fileEvidence"},
        "recovery_plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "pre_cutover_tree_confirmation": {"$ref": "#/$defs/sha256"},
        "authorized_post_cutover_tree_confirmation": {"$ref": "#/$defs/sha256"},
        "recovery_plan": {"$ref": "#/$defs/recoveryPlan"}
      }
    },
    "rehearsedRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "after_sha256", "rehearsal_status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "rehearsal_status": {"const": "applied-and-verified"}
      }
    },
    "rehearsedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "exit_code", "stdout_sha256", "stderr_sha256", "rehearsal_status"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/safeToken"},
        "exit_code": {"type": "integer"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "rehearsal_status": {"const": "passed"}
      }
    }
  }
}
