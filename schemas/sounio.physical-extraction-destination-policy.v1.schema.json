{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-destination-policy.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Destination Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_type",
    "authority_scope",
    "source_inventory_identity_sha256",
    "approval_status",
    "destinations",
    "limitations",
    "policy_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-destination-policy.v1"},
    "policy_type": {"const": "local-destination-approval-policy"},
    "authority_scope": {"const": "explicit-local-copy-destination-approval"},
    "source_inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
    "approval_status": {"enum": ["pending", "approved"]},
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/destination"}
    },
    "limitations": {
      "const": [
        "does_not_create_destination_containers",
        "does_not_transfer_ownership_or_maintainership",
        "does_not_authorize_source_removal",
        "does_not_assert_remote_repository_state",
        "does_not_assert_publication_or_registry_status",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority"
      ]
    },
    "policy_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_kind",
        "target_owner",
        "destination_key",
        "content_path",
        "approval_state",
        "approved_by",
        "approval_evidence",
        "destination_marker_sha256"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_kind": {"const": "separate-distribution"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "destination_key": {"$ref": "#/$defs/safeToken"},
        "content_path": {"$ref": "#/$defs/safeToken"},
        "approval_state": {"enum": ["pending", "approved"]},
        "approved_by": {"$ref": "#/$defs/safeToken"},
        "approval_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "destination_marker_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
