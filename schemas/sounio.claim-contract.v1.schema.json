{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.org/schemas/sounio.claim-contract.v1.schema.json",
  "title": "Sounio claim contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim-id",
    "requested-class",
    "context-of-use",
    "root-artifact",
    "evidence"
  ],
  "properties": {
    "schema": {"const": "sounio.claim-contract.v1"},
    "claim-id": {"type": "string", "minLength": 1},
    "requested-class": {"type": "string", "minLength": 1},
    "context-of-use": {"type": "string", "minLength": 1},
    "root-artifact": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref", "sha256"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
