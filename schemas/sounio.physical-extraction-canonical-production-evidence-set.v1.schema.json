{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-production-evidence-set.v1.schema.json",
  "title": "Sounio R3 Canonical Production Read-Only Evidence Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_type",
    "authority_scope",
    "evidence_status",
    "next_required_action",
    "proposal_status",
    "execution_authority",
    "source_removal_authority",
    "canonical_production_approval",
    "canonical_cutover_execution_status",
    "source_bindings",
    "canonical_source",
    "targets",
    "validation",
    "proposed_execution_plan",
    "governance_prerequisites",
    "summary",
    "assurance_level",
    "limitations",
    "evidence_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-production-evidence-set.v1"},
    "evidence_type": {"const": "read-only-production-evidence-draft"},
    "authority_scope": {"const": "evidence-observation-only"},
    "evidence_status": {
      "enum": [
        "production-evidence-draft-exact-parity",
        "production-evidence-draft-gaps-observed"
      ]
    },
    "next_required_action": {
      "enum": [
        "obtain-separate-explicit-governance-decisions",
        "resolve-parity-or-validation-gaps-and-reissue-evidence"
      ]
    },
    "proposal_status": {"const": "proposed-not-approved"},
    "execution_authority": {"const": "none"},
    "source_removal_authority": {"const": "none"},
    "canonical_production_approval": {"const": "not-approved"},
    "canonical_cutover_execution_status": {"const": "not-executed"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "canonical_source": {"$ref": "#/$defs/canonicalSource"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "validation": {"$ref": "#/$defs/validation"},
    "proposed_execution_plan": {"$ref": "#/$defs/executionPlan"},
    "governance_prerequisites": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/prerequisite"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "assurance_level": {"const": "exact-git-and-byte-observation-plus-supplied-validation"},
    "limitations": {
      "const": [
        "evidence_set_never_grants_execution_authority",
        "evidence_set_does_not_create_or_modify_repositories",
        "evidence_set_does_not_materialize_or_remove_source_files",
        "evidence_set_does_not_create_or_update_git_refs",
        "source_and_destination_observations_are_sequential_not_atomic",
        "byte_parity_does_not_prove_scientific_truth",
        "supplied_validation_observations_are_not_replayed_by_the_verifier",
        "exact_copy_evidence_is_not_destination_owner_approval",
        "mapping_proposal_remains_proposed_not_approved",
        "source_removal_authority_and_production_approval_remain_absent",
        "canonical_cutover_remains_not_executed",
        "does_not_assert_clinical_validation_or_clinical_authority"
      ]
    },
    "evidence_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "string": {"type": "string", "minLength": 1},
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "science_rings_sha256",
        "ownership_policy_sha256",
        "inventory_identity_sha256",
        "repository_catalog_file_sha256",
        "repository_catalog_identity_sha256",
        "mapping_proposal_file_sha256",
        "mapping_proposal_identity_sha256",
        "validation_observations_file_sha256",
        "validation_observations_identity_sha256"
      ],
      "properties": {
        "science_rings_sha256": {"$ref": "#/$defs/sha256"},
        "ownership_policy_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_file_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_identity_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_proposal_file_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_proposal_identity_sha256": {"$ref": "#/$defs/sha256"},
        "validation_observations_file_sha256": {"$ref": "#/$defs/sha256"},
        "validation_observations_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonicalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "head_oid",
        "worktree_status",
        "catalog_remote_url",
        "catalog_default_branch",
        "catalog_head_oid",
        "assessment_status",
        "gap_codes",
        "observation_status"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"$ref": "#/$defs/string"},
        "branch": {"$ref": "#/$defs/safeId"},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"},
        "catalog_remote_url": {"$ref": "#/$defs/string"},
        "catalog_default_branch": {"$ref": "#/$defs/safeId"},
        "catalog_head_oid": {"$ref": "#/$defs/gitOid"},
        "assessment_status": {"const": "observed-matching-clean-default"},
        "gap_codes": {"const": []},
        "observation_status": {"const": "exact-catalog-bound-clean-snapshot"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes", "comparison_tree_sha256"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "comparison_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "total_bytes", "inventory_tree_sha256", "comparison_tree_sha256"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "inventory_tree_sha256": {"$ref": "#/$defs/sha256"},
        "comparison_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "destinationRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "head_oid",
        "worktree_status",
        "observation_status"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"$ref": "#/$defs/string"},
        "branch": {"$ref": "#/$defs/safeId"},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"},
        "observation_status": {"const": "exact-proposal-and-catalog-bound-clean-snapshot"}
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "matching_file_count",
        "missing_file_count",
        "extra_file_count",
        "changed_file_count",
        "sample_limit",
        "missing_paths_sample_complete",
        "extra_paths_sample_complete",
        "changed_paths_sample_complete",
        "missing_paths_sample",
        "extra_paths_sample",
        "changed_paths_sample"
      ],
      "properties": {
        "status": {"enum": ["exact-copy-verified", "parity-gap-observed"]},
        "matching_file_count": {"type": "integer", "minimum": 0},
        "missing_file_count": {"type": "integer", "minimum": 0},
        "extra_file_count": {"type": "integer", "minimum": 0},
        "changed_file_count": {"type": "integer", "minimum": 0},
        "sample_limit": {"const": 20},
        "missing_paths_sample_complete": {"type": "boolean"},
        "extra_paths_sample_complete": {"type": "boolean"},
        "changed_paths_sample_complete": {"type": "boolean"},
        "missing_paths_sample": {"$ref": "#/$defs/pathSample"},
        "extra_paths_sample": {"$ref": "#/$defs/pathSample"},
        "changed_paths_sample": {"$ref": "#/$defs/pathSample"}
      }
    },
    "pathSample": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "ring",
        "target_id",
        "target_owner",
        "source_inventory",
        "destination_repository",
        "destination_inventory",
        "parity"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/string"},
        "ring": {"enum": ["scientific-package", "research"]},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "source_inventory": {"$ref": "#/$defs/sourceInventory"},
        "destination_repository": {"$ref": "#/$defs/destinationRepository"},
        "destination_inventory": {"$ref": "#/$defs/inventory"},
        "parity": {"$ref": "#/$defs/parity"}
      }
    },
    "validationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "scope",
        "command",
        "result",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "evidence_ref"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/safeId"},
        "scope": {"$ref": "#/$defs/safeId"},
        "command": {"type": "string", "minLength": 1, "maxLength": 4096},
        "result": {"enum": ["passed", "failed"]},
        "exit_code": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S+$"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_head_oid", "observations", "summary"],
      "properties": {
        "canonical_head_oid": {"$ref": "#/$defs/gitOid"},
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/validationObservation"}
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observation_count", "passed_count", "failed_count"],
          "properties": {
            "observation_count": {"type": "integer", "minimum": 1},
            "passed_count": {"type": "integer", "minimum": 0},
            "failed_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "executionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "step_id", "required_condition"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 7},
        "step_id": {"$ref": "#/$defs/safeId"},
        "required_condition": {"$ref": "#/$defs/safeId"}
      }
    },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_status", "steps", "abort_conditions", "rollback_evidence_required"],
      "properties": {
        "plan_status": {"const": "draft-not-authorized"},
        "steps": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/executionStep"}
        },
        "abort_conditions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/safeId"}
        },
        "rollback_evidence_required": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/safeId"}
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prerequisite_id", "status", "detail_code"],
      "properties": {
        "prerequisite_id": {"$ref": "#/$defs/safeId"},
        "status": {"enum": ["satisfied-evidence-only", "observed-partial", "missing"]},
        "detail_code": {"$ref": "#/$defs/safeId"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "exact_parity_target_count",
        "parity_gap_target_count",
        "matching_file_count",
        "missing_file_count",
        "extra_file_count",
        "changed_file_count",
        "validation_passed_count",
        "validation_failed_count",
        "permission_bearing_prerequisite_missing_count"
      ],
      "properties": {
        "target_count": {"type": "integer", "minimum": 1},
        "exact_parity_target_count": {"type": "integer", "minimum": 0},
        "parity_gap_target_count": {"type": "integer", "minimum": 0},
        "matching_file_count": {"type": "integer", "minimum": 0},
        "missing_file_count": {"type": "integer", "minimum": 0},
        "extra_file_count": {"type": "integer", "minimum": 0},
        "changed_file_count": {"type": "integer", "minimum": 0},
        "validation_passed_count": {"type": "integer", "minimum": 0},
        "validation_failed_count": {"type": "integer", "minimum": 0},
        "permission_bearing_prerequisite_missing_count": {"const": 4}
      }
    }
  }
}
