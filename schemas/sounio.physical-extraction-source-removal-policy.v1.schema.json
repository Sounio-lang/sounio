{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-source-removal-policy.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Source-Removal Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_type",
    "authority_scope",
    "source_bindings",
    "approval_status",
    "removal_scope",
    "review_evidence",
    "repairs",
    "post_removal_gates",
    "limitations",
    "policy_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-source-removal-policy.v1"},
    "policy_type": {"const": "reviewed-post-removal-candidate-policy"},
    "authority_scope": {"const": "temporary-copy-source-removal-candidate-approval"},
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_file_sha256",
        "inventory_identity_sha256",
        "materialization_file_sha256",
        "materialization_identity_sha256"
      ],
      "properties": {
        "inventory_file_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_file_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval_status": {"const": "approved"},
    "removal_scope": {"$ref": "#/$defs/removalScope"},
    "review_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/reviewEvidence"}
    },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repair"}
    },
    "post_removal_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "limitations": {
      "const": [
        "does_not_delete_original_source_files",
        "does_not_authorize_unlisted_source_paths",
        "does_not_execute_canonical_repository_migration",
        "does_not_assert_remote_repository_or_publication_state",
        "does_not_transfer_ownership_or_maintainership",
        "distinct_reviewer_labels_do_not_prove_organizational_independence",
        "post_removal_environment_is_not_fully_captured",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority"
      ]
    },
    "policy_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "path": {"type": "string", "minLength": 1},
    "scopeUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "ring",
        "target_id",
        "target_owner",
        "file_count",
        "total_bytes",
        "tree_sha256"
      ],
      "properties": {
        "source_path": {"$ref": "#/$defs/path"},
        "ring": {"enum": ["scientific-package", "research"]},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "removalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_identity_sha256", "units"],
      "properties": {
        "scope_identity_sha256": {"$ref": "#/$defs/sha256"},
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scopeUnit"}}
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_label", "path", "size_bytes", "sha256"],
      "properties": {
        "reviewer_label": {"$ref": "#/$defs/safeToken"},
        "path": {"$ref": "#/$defs/path"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_size_bytes",
        "before_sha256",
        "replacement_path",
        "replacement_size_bytes",
        "replacement_sha256",
        "after_size_bytes",
        "after_sha256"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "before_size_bytes": {"type": "integer", "minimum": 0},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "replacement_path": {"$ref": "#/$defs/path"},
        "replacement_size_bytes": {"type": "integer", "minimum": 0},
        "replacement_sha256": {"$ref": "#/$defs/sha256"},
        "after_size_bytes": {"type": "integer", "minimum": 0},
        "after_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "argv",
        "cwd",
        "timeout_seconds",
        "expected_exit_code",
        "expected_stdout_sha256",
        "expected_stderr_sha256"
      ],
      "properties": {
        "gate_id": {"$ref": "#/$defs/safeToken"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"$ref": "#/$defs/path"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "expected_exit_code": {"const": 0},
        "expected_stdout_sha256": {"$ref": "#/$defs/sha256"},
        "expected_stderr_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
