{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.org/schemas/sounio.package-release-bundle.v1.schema.json",
  "title": "Sounio package release bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_identity_sha256",
    "package",
    "artifact",
    "boundary_receipt",
    "claim_contract",
    "bindings",
    "assurance_level",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "sounio.package-release-bundle.v1"},
    "bundle_identity_sha256": {"$ref": "#/$defs/sha256"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "manifest", "manifest_sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "manifest": {"const": "sounio.toml"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"const": "native-elf"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundary_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "identity_sha256", "mode", "verdict"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "strict"},
        "verdict": {"const": "OK"}
      }
    },
    "claim_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "claim_id", "requested_class"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "claim_id": {"type": "string", "minLength": 1},
        "requested_class": {"type": "string", "minLength": 1}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bundle_sha256", "policy_sha256", "compiler_sha256"],
      "properties": {
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assurance_level": {"const": "identity-only"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
