{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-production-gap-assessment.v1.schema.json",
  "title": "Sounio R3 Canonical Production Non-Authorizing Gap Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assessment_type",
    "authority_scope",
    "readiness_status",
    "next_required_action",
    "execution_authority",
    "canonical_cutover_execution_status",
    "source_bindings",
    "canonical_repository",
    "targets",
    "prerequisites",
    "summary",
    "assurance_level",
    "limitations",
    "assessment_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-production-gap-assessment.v1"},
    "assessment_type": {"const": "non-authorizing-production-prerequisite-gap-report"},
    "authority_scope": {"const": "prerequisite-observation-only"},
    "readiness_status": {
      "enum": [
        "mapping-proposal-required",
        "destination-repositories-required",
        "canonical-source-snapshot-required",
        "production-evidence-and-human-decision-required"
      ]
    },
    "next_required_action": {
      "enum": [
        "author-and-review-target-repository-mapping-proposal",
        "provision-and-observe-every-proposed-destination-repository",
        "reobserve-clean-canonical-default-branch-snapshot",
        "author-production-evidence-set-and-obtain-explicit-human-decision"
      ]
    },
    "execution_authority": {"const": "none"},
    "canonical_cutover_execution_status": {"const": "not-executed"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "canonical_repository": {"$ref": "#/$defs/canonicalRepository"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "prerequisites": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/prerequisite"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "assurance_level": {"const": "identity-plus-supplied-catalog-observation"},
    "limitations": {
      "const": [
        "assessment_never_grants_execution_authority",
        "assessment_does_not_create_or_modify_repositories",
        "assessment_does_not_materialize_or_remove_source_files",
        "assessment_does_not_create_or_update_git_refs",
        "supplied_catalog_is_not_live_hosting_attestation",
        "observed_permission_does_not_prove_human_or_organizational_authority",
        "mapping_proposal_is_not_destination_owner_approval",
        "production_evidence_and_explicit_human_decision_remain_separate",
        "assessment_does_not_provide_atomic_snapshot_across_inventory_and_git_observation",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority"
      ]
    },
    "assessment_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nullableGitOid": {
      "oneOf": [
        {"$ref": "#/$defs/gitOid"},
        {"type": "null"}
      ]
    },
    "nullableString": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "science_rings_sha256",
        "ownership_policy_sha256",
        "inventory_identity_sha256",
        "repository_catalog_file_sha256",
        "repository_catalog_identity_sha256",
        "mapping_proposal_file_sha256",
        "mapping_proposal_identity_sha256"
      ],
      "properties": {
        "science_rings_sha256": {"$ref": "#/$defs/sha256"},
        "ownership_policy_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_file_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_identity_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_proposal_file_sha256": {"$ref": "#/$defs/nullableSha256"},
        "mapping_proposal_identity_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "canonicalRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "head_oid",
        "worktree_status",
        "catalog_remote_url",
        "catalog_default_branch",
        "catalog_head_oid",
        "assessment_status",
        "gap_codes"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"type": "string", "minLength": 1},
        "branch": {"$ref": "#/$defs/safeId"},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"enum": ["clean", "dirty"]},
        "catalog_remote_url": {"$ref": "#/$defs/nullableString"},
        "catalog_default_branch": {"$ref": "#/$defs/nullableString"},
        "catalog_head_oid": {"$ref": "#/$defs/nullableGitOid"},
        "assessment_status": {"enum": ["observed-matching-clean-default", "prerequisite-gap"]},
        "gap_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeId"},
          "uniqueItems": true
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "ring",
        "target_id",
        "target_owner",
        "file_count",
        "total_bytes",
        "tree_sha256",
        "repository_id",
        "remote_url",
        "branch",
        "head_oid",
        "assessment_status",
        "gap_codes"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "ring": {"enum": ["scientific-package", "research"]},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "repository_id": {
          "oneOf": [
            {"$ref": "#/$defs/safeToken"},
            {"type": "null"}
          ]
        },
        "remote_url": {"$ref": "#/$defs/nullableString"},
        "branch": {"$ref": "#/$defs/nullableString"},
        "head_oid": {"$ref": "#/$defs/nullableGitOid"},
        "assessment_status": {"enum": ["observed-available-proposal-not-approved", "prerequisite-gap"]},
        "gap_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeId"},
          "uniqueItems": true
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prerequisite_id", "status", "detail_code"],
      "properties": {
        "prerequisite_id": {"$ref": "#/$defs/safeId"},
        "status": {"enum": ["satisfied", "missing"]},
        "detail_code": {"$ref": "#/$defs/safeId"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_target_count",
        "mapped_target_count",
        "observed_available_destination_count",
        "satisfied_prerequisite_count",
        "missing_prerequisite_count"
      ],
      "properties": {
        "planned_target_count": {"type": "integer", "minimum": 1},
        "mapped_target_count": {"type": "integer", "minimum": 0},
        "observed_available_destination_count": {"type": "integer", "minimum": 0},
        "satisfied_prerequisite_count": {"type": "integer", "minimum": 0, "maximum": 8},
        "missing_prerequisite_count": {"type": "integer", "minimum": 0, "maximum": 8}
      }
    }
  }
}
