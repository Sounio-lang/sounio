{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-production-mapping-decision.v1.schema.json",
  "title": "Sounio R3 Canonical Production Mapping Selection Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_type",
    "authority_scope",
    "decision_status",
    "source_decision_evidence",
    "bindings",
    "authorized_operations",
    "prohibited_operations",
    "targets",
    "limitations",
    "decision_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-production-mapping-decision.v1"},
    "decision_type": {"const": "canonical-production-target-mapping-selection"},
    "authority_scope": {"const": "mapping-proposal-input-only"},
    "decision_status": {"const": "human-selection-recorded-not-approved"},
    "source_decision_evidence": {"$ref": "#/$defs/sourceDecisionEvidence"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "authorized_operations": {
      "const": ["draft-proposed-not-approved-mapping"]
    },
    "prohibited_operations": {
      "const": [
        "create-or-modify-repositories",
        "materialize-or-remove-source-files",
        "create-or-update-git-refs",
        "approve-canonical-production",
        "approve-or-execute-canonical-cutover"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "limitations": {
      "const": [
        "decision_record_does_not_authenticate_responder_identity",
        "decision_record_does_not_prove_human_or_organizational_authority",
        "decision_record_authorizes_only_draft_proposed_not_approved_mapping",
        "decision_record_does_not_create_or_modify_repositories",
        "decision_record_does_not_authorize_materialization_source_removal_or_ref_updates",
        "decision_record_does_not_approve_canonical_production_or_cutover",
        "decision_must_be_reconfirmed_after_bound_catalog_or_source_drift",
        "decision_record_does_not_assert_scientific_truth"
      ]
    },
    "decision_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S+\\.git$"},
    "nullableToken": {
      "oneOf": [
        {"$ref": "#/$defs/safeToken"},
        {"type": "null"}
      ]
    },
    "nullableId": {
      "oneOf": [
        {"$ref": "#/$defs/safeId"},
        {"type": "null"}
      ]
    },
    "nullableUrl": {
      "oneOf": [
        {"$ref": "#/$defs/url"},
        {"type": "null"}
      ]
    },
    "nullableVisibility": {
      "oneOf": [
        {"enum": ["PUBLIC", "PRIVATE", "INTERNAL"]},
        {"type": "null"}
      ]
    },
    "nullableRationale": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 2048},
        {"type": "null"}
      ]
    },
    "sourceDecisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_url",
        "response_url",
        "responder_label",
        "response_body_sha256",
        "submitted_at_utc",
        "evidence_status"
      ],
      "properties": {
        "issue_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://\\S+$"},
        "response_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://\\S+$"},
        "responder_label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@/-]{0,127}$"},
        "response_body_sha256": {"$ref": "#/$defs/sha256"},
        "submitted_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "evidence_status": {"const": "transcribed-not-authenticated"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_catalog_identity_sha256",
        "repository_catalog_observed_at_utc",
        "canonical_repository_id",
        "canonical_repository_branch",
        "canonical_repository_head_oid"
      ],
      "properties": {
        "repository_catalog_identity_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_observed_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "canonical_repository_id": {"$ref": "#/$defs/safeToken"},
        "canonical_repository_branch": {"$ref": "#/$defs/safeId"},
        "canonical_repository_head_oid": {"$ref": "#/$defs/gitOid"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "target_id",
        "target_owner",
        "action",
        "repository_id",
        "remote_url",
        "branch",
        "visibility",
        "rationale"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "action": {"enum": ["reuse-observed", "request-new", "revise-target"]},
        "repository_id": {"$ref": "#/$defs/nullableToken"},
        "remote_url": {"$ref": "#/$defs/nullableUrl"},
        "branch": {"$ref": "#/$defs/nullableId"},
        "visibility": {"$ref": "#/$defs/nullableVisibility"},
        "rationale": {"$ref": "#/$defs/nullableRationale"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "reuse-observed"}}, "required": ["action"]},
          "then": {
            "properties": {
              "repository_id": {"$ref": "#/$defs/safeToken"},
              "remote_url": {"$ref": "#/$defs/url"},
              "branch": {"$ref": "#/$defs/safeId"},
              "visibility": {"type": "null"},
              "rationale": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "request-new"}}, "required": ["action"]},
          "then": {
            "properties": {
              "repository_id": {"$ref": "#/$defs/safeToken"},
              "remote_url": {"$ref": "#/$defs/url"},
              "branch": {"$ref": "#/$defs/safeId"},
              "visibility": {"enum": ["PUBLIC", "PRIVATE", "INTERNAL"]},
              "rationale": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "revise-target"}}, "required": ["action"]},
          "then": {
            "properties": {
              "repository_id": {"type": "null"},
              "remote_url": {"type": "null"},
              "branch": {"type": "null"},
              "visibility": {"type": "null"},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 2048}
            }
          }
        }
      ]
    }
  }
}
