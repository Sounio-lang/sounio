{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-source-removal-execution-policy.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Source-Removal Execution Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_type",
    "authority_scope",
    "source_bindings",
    "approval_status",
    "execution_root_marker",
    "execution_scope",
    "operator_approval",
    "limitations",
    "policy_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-source-removal-execution-policy.v1"},
    "policy_type": {"const": "explicit-local-source-removal-execution-policy"},
    "authority_scope": {"const": "exact-local-repository-tree-execution-approval"},
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_file_sha256",
        "authorization_identity_sha256",
        "materialization_file_sha256",
        "materialization_identity_sha256",
        "inventory_identity_sha256",
        "pre_execution_tree_sha256",
        "post_execution_tree_sha256"
      ],
      "properties": {
        "authorization_file_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_file_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "pre_execution_tree_sha256": {"$ref": "#/$defs/sha256"},
        "post_execution_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approval_status": {"const": "approved"},
    "execution_root_marker": {"$ref": "#/$defs/fileEvidence"},
    "execution_scope": {
      "$ref": "sounio.physical-extraction-source-removal-policy.v1.schema.json#/$defs/removalScope"
    },
    "operator_approval": {"$ref": "#/$defs/operatorApproval"},
    "limitations": {
      "const": [
        "does_not_create_or_imply_production_approval",
        "authorizes_only_one_exact_local_repository_tree",
        "does_not_assert_remote_repository_or_publication_state",
        "does_not_transfer_ownership_or_maintainership",
        "operator_label_does_not_prove_human_identity_or_organizational_authority",
        "does_not_guarantee_crash_atomicity_across_multiple_filesystem_operations",
        "crash_recovery_requires_the_retained_transaction_workspace",
        "requires_a_quiescent_execution_root_without_nonparticipating_writers",
        "does_not_preserve_uninventoried_filesystem_metadata",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority"
      ]
    },
    "policy_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "operatorApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approval_evidence",
        "authorization_identity_confirmation",
        "scope_identity_confirmation",
        "pre_execution_tree_confirmation"
      ],
      "properties": {
        "approved_by": {"$ref": "#/$defs/safeToken"},
        "approval_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileEvidence"}
        },
        "authorization_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "scope_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "pre_execution_tree_confirmation": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
