{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.org/schemas/sounio.registry-attestation.v1.schema.json",
  "title": "Sounio registry attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attestation_identity_sha256",
    "attestation_type",
    "registry",
    "package",
    "release_bindings",
    "science",
    "decision",
    "assurance_level",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "sounio.registry-attestation.v1"},
    "attestation_identity_sha256": {"$ref": "#/$defs/sha256"},
    "attestation_type": {"const": "unsigned-local-policy-evaluation"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "namespace", "authority_scope", "publication_status", "policy_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "namespace": {"$ref": "#/$defs/token"},
        "authority_scope": {"const": "local-catalog-index"},
        "publication_status": {"const": "disabled"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "bundle_identity_sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "version": {"$ref": "#/$defs/token"},
        "bundle_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "release_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_manifest_sha256",
        "artifact_sha256",
        "boundary_receipt_sha256",
        "boundary_receipt_identity_sha256",
        "claim_contract_sha256",
        "claim_id",
        "requested_class",
        "source_bundle_sha256",
        "package_policy_sha256",
        "compiler_sha256"
      ],
      "properties": {
        "bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "boundary_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "boundary_receipt_identity_sha256": {"$ref": "#/$defs/sha256"},
        "claim_contract_sha256": {"$ref": "#/$defs/sha256"},
        "claim_id": {"type": "string", "minLength": 1},
        "requested_class": {"$ref": "#/$defs/token"},
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "package_policy_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "science": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ring", "evidence_status", "context_of_use", "visibility"],
      "properties": {
        "ring": {"enum": ["pl-core", "scientific-package", "research"]},
        "evidence_status": {"type": "string", "minLength": 1},
        "context_of_use": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["public", "protected", "embargoed"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "checks"],
      "properties": {
        "verdict": {"const": "POLICY_MATCH"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "assurance_level": {"const": "identity-only"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
  }
}
