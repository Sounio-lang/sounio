{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-inventory.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Planning Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "inventory_type",
    "authority_scope",
    "extraction_status",
    "source_documents",
    "summary",
    "units",
    "assurance_level",
    "limitations",
    "inventory_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-inventory.v1"},
    "inventory_type": {"const": "physical-extraction-planning-snapshot"},
    "authority_scope": {"const": "repository-file-identity-and-ownership-plan"},
    "extraction_status": {"const": "not-executed"},
    "source_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["science_rings_sha256", "ownership_policy_sha256"],
      "properties": {
        "science_rings_sha256": {"$ref": "#/$defs/sha256"},
        "ownership_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_count",
        "file_count",
        "total_bytes",
        "retained_core_units",
        "planned_extraction_units",
        "blocked_units"
      ],
      "properties": {
        "unit_count": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "retained_core_units": {"type": "integer", "minimum": 0},
        "planned_extraction_units": {"type": "integer", "minimum": 0},
        "blocked_units": {"type": "integer", "minimum": 0}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "assurance_level": {"const": "identity-only"},
    "limitations": {
      "const": [
        "does_not_move_or_delete_source_files",
        "does_not_assert_target_repository_or_distribution_exists",
        "does_not_assert_ownership_or_maintainership_was_transferred",
        "does_not_assert_publication_or_registry_status",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority",
        "does_not_assert_independent_replay",
        "full_verification_requires_the_original_repository_snapshot_and_policies"
      ]
    },
    "inventory_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "ring",
        "evidence_status",
        "context_of_use",
        "visibility",
        "ring_next_gate",
        "allowed_claim_classes",
        "ring_evidence_refs",
        "current_owner",
        "target_kind",
        "target_id",
        "target_owner",
        "disposition",
        "migration_state",
        "ownership_evidence",
        "extraction_gate",
        "file_count",
        "total_bytes",
        "tree_sha256",
        "files"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "ring": {
          "enum": [
            "pl-core",
            "scientific-package",
            "research",
            "scientific-package-candidate",
            "mixed-unresolved",
            "unclassified"
          ]
        },
        "evidence_status": {"type": "string", "minLength": 1},
        "context_of_use": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["public", "protected", "embargoed"]},
        "ring_next_gate": {"$ref": "#/$defs/safeId"},
        "allowed_claim_classes": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeId"},
          "uniqueItems": true
        },
        "ring_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/safeId"},
          "uniqueItems": true
        },
        "current_owner": {"$ref": "#/$defs/safeToken"},
        "target_kind": {"enum": ["same-repository", "separate-distribution", "unassigned"]},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "disposition": {"enum": ["retain-core", "extract-planned", "hold-unresolved"]},
        "migration_state": {"enum": ["retained", "planned", "blocked-classification"]},
        "ownership_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/safeId"},
          "uniqueItems": true
        },
        "extraction_gate": {"$ref": "#/$defs/safeId"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  }
}
