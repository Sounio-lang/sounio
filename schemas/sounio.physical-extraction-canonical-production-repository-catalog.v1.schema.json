{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-production-repository-catalog.v1.schema.json",
  "title": "Sounio R3 Canonical Production Repository Catalog Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalog_type",
    "authority_scope",
    "organization",
    "observed_at_utc",
    "repositories",
    "limitations",
    "catalog_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-production-repository-catalog.v1"},
    "catalog_type": {"const": "observed-hosting-repository-catalog"},
    "authority_scope": {"const": "supplied-repository-metadata-observation"},
    "organization": {"$ref": "#/$defs/safeId"},
    "observed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    },
    "limitations": {
      "const": [
        "catalog_is_a_supplied_point_in_time_observation",
        "catalog_does_not_prove_repository_ownership_or_administration",
        "catalog_does_not_prove_branch_protection_or_push_acceptance",
        "catalog_does_not_approve_target_mapping_or_source_removal",
        "catalog_does_not_assert_scientific_truth"
      ]
    },
    "catalog_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "name_with_owner",
        "remote_url",
        "default_branch",
        "head_oid",
        "visibility",
        "archived",
        "is_empty",
        "observed_permission"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "name_with_owner": {"$ref": "#/$defs/safeId"},
        "remote_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "default_branch": {"$ref": "#/$defs/safeId"},
        "head_oid": {
          "oneOf": [
            {"$ref": "#/$defs/gitOid"},
            {"type": "null"}
          ]
        },
        "visibility": {"enum": ["PUBLIC", "PRIVATE", "INTERNAL"]},
        "archived": {"type": "boolean"},
        "is_empty": {"type": "boolean"},
        "observed_permission": {"enum": ["ADMIN", "MAINTAIN", "WRITE", "TRIAGE", "READ", "NONE", "UNKNOWN"]}
      }
    }
  }
}
