{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-source-removal-authorization.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Source-Removal Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorization_type",
    "authority_scope",
    "authorization_status",
    "source_removal_execution_status",
    "source_bindings",
    "removal_scope",
    "summary",
    "review_evidence",
    "repairs",
    "post_removal_gates",
    "candidate_evidence",
    "assurance_level",
    "limitations",
    "authorization_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-source-removal-authorization.v1"},
    "authorization_type": {"const": "verified-post-removal-candidate-authorization"},
    "authority_scope": {"const": "local-temporary-copy-post-removal-evidence"},
    "authorization_status": {"const": "authorized-not-executed"},
    "source_removal_execution_status": {"const": "not-executed"},
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_file_sha256",
        "inventory_identity_sha256",
        "materialization_file_sha256",
        "materialization_identity_sha256",
        "removal_policy_file_sha256",
        "removal_policy_identity_sha256"
      ],
      "properties": {
        "inventory_file_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_file_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "removal_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "removal_policy_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "removal_scope": {"$ref": "sounio.physical-extraction-source-removal-policy.v1.schema.json#/$defs/removalScope"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_unit_count",
        "authorized_file_count",
        "authorized_total_bytes",
        "review_evidence_count",
        "repair_count",
        "post_removal_gate_count"
      ],
      "properties": {
        "authorized_unit_count": {"type": "integer", "minimum": 1},
        "authorized_file_count": {"type": "integer", "minimum": 1},
        "authorized_total_bytes": {"type": "integer", "minimum": 0},
        "review_evidence_count": {"type": "integer", "minimum": 2},
        "repair_count": {"type": "integer", "minimum": 1},
        "post_removal_gate_count": {"type": "integer", "minimum": 1}
      }
    },
    "review_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "sounio.physical-extraction-source-removal-policy.v1.schema.json#/$defs/reviewEvidence"}
    },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/appliedRepair"}
    },
    "post_removal_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gateEvidence"}
    },
    "candidate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_source_file_count",
        "original_source_tree_sha256",
        "candidate_tree_sha256",
        "candidate_status",
        "original_source_status"
      ],
      "properties": {
        "original_source_file_count": {"type": "integer", "minimum": 1},
        "original_source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_tree_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_status": {"const": "removed-repaired-and-gates-passed"},
        "original_source_status": {"const": "reverified-unchanged"}
      }
    },
    "assurance_level": {"const": "identity-only"},
    "limitations": {
      "const": [
        "does_not_delete_original_source_files",
        "authorizes_only_the_bound_scope_for_a_separate_execution_interface",
        "does_not_execute_canonical_repository_migration",
        "does_not_assert_remote_repository_or_publication_state",
        "does_not_transfer_ownership_or_maintainership",
        "distinct_reviewer_labels_do_not_prove_organizational_independence",
        "post_removal_environment_is_not_fully_captured",
        "does_not_preserve_uninventoried_filesystem_metadata_in_candidate_copy",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority",
        "does_not_assert_independent_replay",
        "full_verification_requires_original_sources_materialization_destinations_policy_and_gates"
      ]
    },
    "authorization_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "appliedRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_size_bytes",
        "before_sha256",
        "replacement_path",
        "replacement_size_bytes",
        "replacement_sha256",
        "after_size_bytes",
        "after_sha256",
        "repair_status"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "before_size_bytes": {"type": "integer", "minimum": 0},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "replacement_path": {"type": "string", "minLength": 1},
        "replacement_size_bytes": {"type": "integer", "minimum": 0},
        "replacement_sha256": {"$ref": "#/$defs/sha256"},
        "after_size_bytes": {"type": "integer", "minimum": 0},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "repair_status": {"const": "applied-and-verified"}
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "argv",
        "cwd",
        "timeout_seconds",
        "exit_code",
        "stdout_size_bytes",
        "stdout_sha256",
        "stderr_size_bytes",
        "stderr_sha256",
        "gate_status"
      ],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "exit_code": {"const": 0},
        "stdout_size_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_size_bytes": {"type": "integer", "minimum": 0},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "gate_status": {"const": "passed"}
      }
    }
  }
}
