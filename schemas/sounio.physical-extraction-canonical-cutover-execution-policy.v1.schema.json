{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-cutover-execution-policy.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Canonical Cutover Execution Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_type",
    "authority_scope",
    "execution_context",
    "approval_status",
    "source_bindings",
    "canonical_repository",
    "commit_plan",
    "execution_authorization",
    "limitations",
    "policy_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-cutover-execution-policy.v1"},
    "policy_type": {"const": "explicit-canonical-cutover-execution-policy"},
    "authority_scope": {"const": "exact-approved-git-cutover-execution"},
    "execution_context": {"enum": ["disposable-fixture", "canonical-production"]},
    "approval_status": {"const": "approved"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "canonical_repository": {"$ref": "#/$defs/canonicalRepository"},
    "commit_plan": {"$ref": "#/$defs/commitPlan"},
    "execution_authorization": {"$ref": "#/$defs/executionAuthorization"},
    "limitations": {
      "const": [
        "execution_is_limited_to_the_exact_approved_git_transition",
        "disposable_fixture_context_is_not_canonical_production_execution",
        "git_remote_ref_update_does_not_prove_hosting_administration_or_ownership",
        "does_not_transfer_ownership_or_maintainership",
        "operator_label_does_not_prove_human_identity_or_organizational_authority",
        "remote_ref_update_and_receipt_promotion_are_not_one_atomic_transaction",
        "crash_between_remote_update_and_receipt_promotion_requires_bound_manual_recovery",
        "requires_quiescent_nonparticipating_writers",
        "git_object_ids_and_json_hashes_are_change_detectors_not_independent_signatures",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority"
      ]
    },
    "policy_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutover_approval_file_sha256",
        "cutover_approval_identity_sha256",
        "cutover_policy_file_sha256",
        "cutover_policy_identity_sha256",
        "authorization_file_sha256",
        "authorization_identity_sha256",
        "materialization_file_sha256",
        "materialization_identity_sha256",
        "pre_cutover_tree_sha256",
        "authorized_post_cutover_tree_sha256",
        "removal_scope_identity_sha256",
        "destination_set_identity_sha256",
        "recovery_plan_identity_sha256"
      ],
      "properties": {
        "cutover_approval_file_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_approval_identity_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_policy_identity_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_file_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_file_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "pre_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_post_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "removal_scope_identity_sha256": {"$ref": "#/$defs/sha256"},
        "destination_set_identity_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_plan_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonicalRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "pre_cutover_head_oid",
        "pre_cutover_remote_head_oid",
        "expected_post_cutover_git_tree_oid",
        "expected_cutover_commit_oid"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "pre_cutover_head_oid": {"$ref": "#/$defs/gitOid"},
        "pre_cutover_remote_head_oid": {"$ref": "#/$defs/gitOid"},
        "expected_post_cutover_git_tree_oid": {"$ref": "#/$defs/gitOid"},
        "expected_cutover_commit_oid": {"$ref": "#/$defs/gitOid"}
      }
    },
    "commitPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_name",
        "author_email",
        "author_date",
        "committer_name",
        "committer_email",
        "committer_date",
        "message",
        "local_ref_update",
        "remote_ref_update"
      ],
      "properties": {
        "author_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "author_email": {"type": "string", "minLength": 3, "maxLength": 254},
        "author_date": {"type": "string", "pattern": "^[0-9]{10} [+-][0-9]{4}$"},
        "committer_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "committer_email": {"type": "string", "minLength": 3, "maxLength": 254},
        "committer_date": {"type": "string", "pattern": "^[0-9]{10} [+-][0-9]{4}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "local_ref_update": {"const": "compare-and-swap-pre-head-to-expected-commit"},
        "remote_ref_update": {"const": "exact-force-with-lease-pre-head-to-expected-commit"}
      }
    },
    "executionAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approval_evidence",
        "cutover_approval_identity_confirmation",
        "pre_cutover_head_confirmation",
        "pre_cutover_remote_head_confirmation",
        "authorized_post_cutover_tree_confirmation",
        "expected_cutover_commit_confirmation",
        "destination_set_identity_confirmation",
        "recovery_plan_identity_confirmation",
        "remote_update_reviewed",
        "recovery_plan_reviewed"
      ],
      "properties": {
        "approved_by": {"$ref": "#/$defs/safeToken"},
        "approval_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileEvidence"}},
        "cutover_approval_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "pre_cutover_head_confirmation": {"$ref": "#/$defs/gitOid"},
        "pre_cutover_remote_head_confirmation": {"$ref": "#/$defs/gitOid"},
        "authorized_post_cutover_tree_confirmation": {"$ref": "#/$defs/sha256"},
        "expected_cutover_commit_confirmation": {"$ref": "#/$defs/gitOid"},
        "destination_set_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "recovery_plan_identity_confirmation": {"$ref": "#/$defs/sha256"},
        "remote_update_reviewed": {"const": true},
        "recovery_plan_reviewed": {"const": true}
      }
    }
  }
}
