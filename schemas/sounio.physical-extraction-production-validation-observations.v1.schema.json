{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-production-validation-observations.v1.schema.json",
  "title": "Sounio R3 Supplied Production Validation Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_type",
    "authority_scope",
    "canonical_head_oid",
    "observations",
    "limitations",
    "validation_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-production-validation-observations.v1"},
    "observation_type": {"const": "supplied-validation-observations"},
    "authority_scope": {"const": "evidence-citation-only"},
    "canonical_head_oid": {"$ref": "#/$defs/gitOid"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    },
    "limitations": {
      "const": [
        "observations_are_supplied_records_not_commands_replayed_by_this_contract",
        "a_pass_result_does_not_prove_scientific_truth",
        "a_pass_result_does_not_assert_clinical_validation_or_clinical_authority",
        "validation_observations_do_not_grant_production_or_cutover_authority"
      ]
    },
    "validation_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "scope",
        "command",
        "result",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "evidence_ref"
      ],
      "properties": {
        "observation_id": {"$ref": "#/$defs/safeId"},
        "scope": {"$ref": "#/$defs/safeId"},
        "command": {"type": "string", "minLength": 1, "maxLength": 4096},
        "result": {"enum": ["passed", "failed"]},
        "exit_code": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S+$"}
      }
    }
  }
}
