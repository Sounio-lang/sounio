{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-production-mapping-decision-receipt.v1.schema.json",
  "title": "Sounio R3 Canonical Production Mapping Decision Processing Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_type",
    "authority_scope",
    "processing_status",
    "next_required_action",
    "execution_authority",
    "canonical_cutover_execution_status",
    "source_bindings",
    "source_decision_evidence",
    "targets",
    "summary",
    "proposal_output_status",
    "proposal_identity_sha256",
    "assurance_level",
    "limitations",
    "receipt_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-production-mapping-decision-receipt.v1"},
    "receipt_type": {"const": "non-authorizing-mapping-decision-processing-receipt"},
    "authority_scope": {"const": "mapping-proposal-preparation-only"},
    "processing_status": {
      "enum": [
        "proposal-input-complete",
        "destination-repository-creation-required",
        "ownership-policy-review-required"
      ]
    },
    "next_required_action": {
      "enum": [
        "review-proposed-not-approved-mapping",
        "provision-repositories-reobserve-catalog-and-reconfirm-selection",
        "revise-governed-target-and-repeat-human-selection"
      ]
    },
    "execution_authority": {"const": "none"},
    "canonical_cutover_execution_status": {"const": "not-executed"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "source_decision_evidence": {"$ref": "#/$defs/sourceDecisionEvidence"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/targetResult"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "proposal_output_status": {"enum": ["emitted-proposed-not-approved", "not-emitted"]},
    "proposal_identity_sha256": {"$ref": "#/$defs/nullableSha256"},
    "assurance_level": {"const": "identity-plus-bound-catalog-and-local-git-observation"},
    "limitations": {
      "const": [
        "receipt_never_grants_execution_authority",
        "receipt_does_not_authenticate_responder_identity_or_authority",
        "receipt_does_not_create_or_modify_repositories",
        "receipt_does_not_materialize_or_remove_source_files",
        "receipt_does_not_create_or_update_git_refs",
        "emitted_mapping_is_proposed_not_approved",
        "supplied_catalog_is_not_live_hosting_attestation",
        "catalog_or_source_drift_requires_a_new_selection_record",
        "receipt_commit_does_not_make_multi_file_promotion_crash_atomic",
        "receipt_does_not_approve_canonical_production_or_cutover",
        "receipt_does_not_assert_scientific_truth"
      ]
    },
    "receipt_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"processing_status": {"const": "proposal-input-complete"}}, "required": ["processing_status"]},
      "then": {
        "properties": {
          "next_required_action": {"const": "review-proposed-not-approved-mapping"},
          "proposal_output_status": {"const": "emitted-proposed-not-approved"},
          "proposal_identity_sha256": {"$ref": "#/$defs/sha256"},
          "summary": {
            "type": "object",
            "properties": {
              "request_new_count": {"const": 0},
              "revise_target_count": {"const": 0},
              "proposal_mapping_count": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"processing_status": {"const": "destination-repository-creation-required"}}, "required": ["processing_status"]},
      "then": {
        "properties": {
          "next_required_action": {"const": "provision-repositories-reobserve-catalog-and-reconfirm-selection"},
          "proposal_output_status": {"const": "not-emitted"},
          "proposal_identity_sha256": {"type": "null"},
          "summary": {
            "type": "object",
            "properties": {
              "request_new_count": {"type": "integer", "minimum": 1},
              "revise_target_count": {"const": 0},
              "proposal_mapping_count": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"processing_status": {"const": "ownership-policy-review-required"}}, "required": ["processing_status"]},
      "then": {
        "properties": {
          "next_required_action": {"const": "revise-governed-target-and-repeat-human-selection"},
          "proposal_output_status": {"const": "not-emitted"},
          "proposal_identity_sha256": {"type": "null"},
          "summary": {
            "type": "object",
            "properties": {
              "revise_target_count": {"type": "integer", "minimum": 1},
              "proposal_mapping_count": {"const": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S+\\.git$"},
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nullableGitOid": {
      "oneOf": [
        {"$ref": "#/$defs/gitOid"},
        {"type": "null"}
      ]
    },
    "nullableToken": {
      "oneOf": [
        {"$ref": "#/$defs/safeToken"},
        {"type": "null"}
      ]
    },
    "nullableId": {
      "oneOf": [
        {"$ref": "#/$defs/safeId"},
        {"type": "null"}
      ]
    },
    "nullableString": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 2048},
        {"type": "null"}
      ]
    },
    "nullableUrl": {
      "oneOf": [
        {"$ref": "#/$defs/url"},
        {"type": "null"}
      ]
    },
    "nullableVisibility": {
      "oneOf": [
        {"enum": ["PUBLIC", "PRIVATE", "INTERNAL"]},
        {"type": "null"}
      ]
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "science_rings_sha256",
        "ownership_policy_sha256",
        "inventory_identity_sha256",
        "repository_catalog_file_sha256",
        "repository_catalog_identity_sha256",
        "repository_catalog_observed_at_utc",
        "mapping_decision_file_sha256",
        "mapping_decision_identity_sha256",
        "canonical_repository_id",
        "canonical_repository_branch",
        "canonical_repository_head_oid"
      ],
      "properties": {
        "science_rings_sha256": {"$ref": "#/$defs/sha256"},
        "ownership_policy_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_file_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_identity_sha256": {"$ref": "#/$defs/sha256"},
        "repository_catalog_observed_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "mapping_decision_file_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_decision_identity_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_repository_id": {"$ref": "#/$defs/safeToken"},
        "canonical_repository_branch": {"$ref": "#/$defs/safeId"},
        "canonical_repository_head_oid": {"$ref": "#/$defs/gitOid"}
      }
    },
    "sourceDecisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_url",
        "response_url",
        "responder_label",
        "response_body_sha256",
        "submitted_at_utc",
        "evidence_status"
      ],
      "properties": {
        "issue_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://\\S+$"},
        "response_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://\\S+$"},
        "responder_label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@/-]{0,127}$"},
        "response_body_sha256": {"$ref": "#/$defs/sha256"},
        "submitted_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "evidence_status": {"const": "transcribed-not-authenticated"}
      }
    },
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "target_id",
        "target_owner",
        "action",
        "repository_id",
        "remote_url",
        "branch",
        "visibility",
        "expected_head_oid",
        "rationale",
        "result_status"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "action": {"enum": ["reuse-observed", "request-new", "revise-target"]},
        "repository_id": {"$ref": "#/$defs/nullableToken"},
        "remote_url": {"$ref": "#/$defs/nullableUrl"},
        "branch": {"$ref": "#/$defs/nullableId"},
        "visibility": {"$ref": "#/$defs/nullableVisibility"},
        "expected_head_oid": {"$ref": "#/$defs/nullableGitOid"},
        "rationale": {"$ref": "#/$defs/nullableString"},
        "result_status": {
          "enum": [
            "observed-repository-reuse-ready-for-proposal",
            "repository-creation-request-required",
            "ownership-policy-revision-required"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "reuse-observed"}}, "required": ["action"]},
          "then": {
            "properties": {
              "repository_id": {"$ref": "#/$defs/safeToken"},
              "remote_url": {"$ref": "#/$defs/url"},
              "branch": {"$ref": "#/$defs/safeId"},
              "visibility": {"enum": ["PUBLIC", "PRIVATE", "INTERNAL"]},
              "expected_head_oid": {"$ref": "#/$defs/gitOid"},
              "rationale": {"type": "null"},
              "result_status": {"const": "observed-repository-reuse-ready-for-proposal"}
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "request-new"}}, "required": ["action"]},
          "then": {
            "properties": {
              "repository_id": {"$ref": "#/$defs/safeToken"},
              "remote_url": {"$ref": "#/$defs/url"},
              "branch": {"$ref": "#/$defs/safeId"},
              "visibility": {"enum": ["PUBLIC", "PRIVATE", "INTERNAL"]},
              "expected_head_oid": {"type": "null"},
              "rationale": {"type": "null"},
              "result_status": {"const": "repository-creation-request-required"}
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "revise-target"}}, "required": ["action"]},
          "then": {
            "properties": {
              "repository_id": {"type": "null"},
              "remote_url": {"type": "null"},
              "branch": {"type": "null"},
              "visibility": {"type": "null"},
              "expected_head_oid": {"type": "null"},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 2048},
              "result_status": {"const": "ownership-policy-revision-required"}
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "reuse_observed_count",
        "request_new_count",
        "revise_target_count",
        "proposal_mapping_count"
      ],
      "properties": {
        "target_count": {"type": "integer", "minimum": 1},
        "reuse_observed_count": {"type": "integer", "minimum": 0},
        "request_new_count": {"type": "integer", "minimum": 0},
        "revise_target_count": {"type": "integer", "minimum": 0},
        "proposal_mapping_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
