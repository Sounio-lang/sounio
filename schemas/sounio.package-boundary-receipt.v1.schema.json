{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.org/schemas/sounio.package-boundary-receipt.v1.schema.json",
  "title": "Sounio package boundary receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verdict",
    "mode",
    "identity_only",
    "graph",
    "diagnostics",
    "hashes",
    "engine",
    "policy",
    "claim_contract",
    "artifact",
    "assurance_level",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "sounio.package-boundary-receipt.v1"},
    "verdict": {"enum": ["OK", "REJECT", "UNKNOWN"]},
    "mode": {"enum": ["off", "advisory", "strict"]},
    "identity_only": {"const": true},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_artifact",
        "capacity",
        "saturated",
        "nodes",
        "edges",
        "unresolved_imports"
      ],
      "properties": {
        "root_artifact": {"$ref": "#/$defs/relativePath"},
        "capacity": {"type": "integer", "minimum": 0},
        "saturated": {"type": "boolean"},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "ring", "evidence_status", "context_of_use", "visibility", "review_state"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "ring": {"type": "string", "minLength": 1},
              "evidence_status": {"type": "string", "minLength": 1},
              "context_of_use": {"type": "string", "minLength": 1},
              "visibility": {"enum": ["public", "protected", "embargoed"]},
              "review_state": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["caller", "dependency"],
            "properties": {
              "caller": {"$ref": "#/$defs/relativePath"},
              "dependency": {"$ref": "#/$defs/relativePath"}
            },
            "additionalProperties": false
          }
        },
        "unresolved_imports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["caller", "import"],
            "properties": {
              "caller": {"$ref": "#/$defs/relativePath"},
              "import": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"pattern": "^[EW]-SRB-[A-Z0-9-]+$"},
          "severity": {"enum": ["warning", "error"]},
          "message": {"type": "string", "minLength": 1},
          "path": {"$ref": "#/$defs/relativePath"},
          "dependency": {"$ref": "#/$defs/relativePath"}
        },
        "additionalProperties": false
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bundle_sha256",
        "policy_sha256",
        "claim_contract_sha256",
        "compiler_sha256",
        "closure_report_sha256",
        "elf_sha256",
        "receipt_identity_sha256"
      ],
      "properties": {
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/optionalSha256"},
        "claim_contract_sha256": {"$ref": "#/$defs/optionalSha256"},
        "compiler_sha256": {"$ref": "#/$defs/optionalSha256"},
        "closure_report_sha256": {"$ref": "#/$defs/optionalSha256"},
        "elf_sha256": {"$ref": "#/$defs/optionalSha256"},
        "receipt_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity", "boundary_collector"],
      "properties": {
        "name": {"const": "madaros"},
        "identity": {"type": "string"},
        "boundary_collector": {"enum": ["none", "madaros-raw-ast-v1", "sounio-host-syntax-v1"]}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/relativePath"}]}
      }
    },
    "claim_contract": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "claim_id",
            "requested_class",
            "context_of_use",
            "root_artifact",
            "evidence_types",
            "evidence_bindings"
          ],
          "properties": {
            "source": {"$ref": "#/$defs/relativePath"},
            "claim_id": {"type": "string", "minLength": 1},
            "requested_class": {"type": "string", "minLength": 1},
            "context_of_use": {"type": "string", "minLength": 1},
            "root_artifact": {"$ref": "#/$defs/relativePath"},
            "evidence_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "evidence_bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "ref", "sha256"],
                "properties": {
                  "type": {"type": "string", "minLength": 1},
                  "ref": {"$ref": "#/$defs/relativePath"},
                  "sha256": {"$ref": "#/$defs/sha256"}
                }
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"enum": ["not-emitted", "native-elf"]},
        "path": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/relativePath"}]}
      }
    },
    "assurance_level": {"const": "identity-only"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optionalSha256": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
