{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-cutover-execution.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Canonical Cutover Execution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_type",
    "authority_scope",
    "execution_context",
    "canonical_cutover_approval_status",
    "canonical_cutover_execution_status",
    "source_removal_status",
    "source_bindings",
    "canonical_repository",
    "commit_plan",
    "execution_scope",
    "summary",
    "execution_authorization",
    "explicit_cli_confirmations",
    "destinations",
    "recovery_plan",
    "repairs",
    "post_removal_gates",
    "tree_evidence",
    "transaction_evidence",
    "assurance_level",
    "limitations",
    "execution_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-cutover-execution.v1"},
    "execution_type": {"const": "policy-bound-canonical-git-cutover"},
    "authority_scope": {"const": "exact-approved-git-cutover-execution"},
    "execution_context": {"enum": ["disposable-fixture", "canonical-production"]},
    "canonical_cutover_approval_status": {"const": "consumed"},
    "canonical_cutover_execution_status": {"const": "executed-and-verified"},
    "source_removal_status": {"const": "executed"},
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "canonical_repository": {"$ref": "#/$defs/executedCanonicalRepository"},
    "commit_plan": {
      "$ref": "sounio.physical-extraction-canonical-cutover-execution-policy.v1.schema.json#/$defs/commitPlan"
    },
    "execution_scope": {
      "$ref": "sounio.physical-extraction-source-removal-policy.v1.schema.json#/$defs/removalScope"
    },
    "summary": {"$ref": "#/$defs/summary"},
    "execution_authorization": {
      "$ref": "sounio.physical-extraction-canonical-cutover-execution-policy.v1.schema.json#/$defs/executionAuthorization"
    },
    "explicit_cli_confirmations": {"$ref": "#/$defs/explicitCliConfirmations"},
    "destinations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/destinationEvidence"}},
    "recovery_plan": {
      "$ref": "sounio.physical-extraction-canonical-cutover-approval.v1.schema.json#/$defs/verifiedRecoveryPlan"
    },
    "repairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/executedRepair"}},
    "post_removal_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gateEvidence"}},
    "tree_evidence": {"$ref": "#/$defs/treeEvidence"},
    "transaction_evidence": {"$ref": "#/$defs/transactionEvidence"},
    "assurance_level": {"const": "identity-plus-git-remote-ref-and-published-commit"},
    "limitations": {
      "const": [
        "execution_is_limited_to_the_exact_approved_git_transition",
        "disposable_fixture_receipt_is_not_canonical_production_execution",
        "git_remote_ref_observation_does_not_prove_hosting_administration_or_ownership",
        "does_not_transfer_ownership_or_maintainership",
        "operator_label_does_not_prove_human_identity_or_organizational_authority",
        "remote_ref_update_and_receipt_promotion_were_not_one_atomic_transaction",
        "a_process_crash_between_remote_update_and_receipt_promotion_requires_bound_manual_recovery",
        "requires_quiescent_nonparticipating_writers",
        "regular_file_content_and_git_tree_identity_do_not_capture_all_filesystem_metadata",
        "git_object_ids_and_json_hashes_are_change_detectors_not_independent_signatures",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority",
        "does_not_assert_independent_replay",
        "post_execution_verification_uses_bound_receipts_not_removed_source_files"
      ]
    },
    "execution_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutover_approval_file_sha256",
        "cutover_approval_identity_sha256",
        "cutover_policy_file_sha256",
        "cutover_policy_identity_sha256",
        "authorization_file_sha256",
        "authorization_identity_sha256",
        "materialization_file_sha256",
        "materialization_identity_sha256",
        "pre_cutover_tree_sha256",
        "authorized_post_cutover_tree_sha256",
        "removal_scope_identity_sha256",
        "destination_set_identity_sha256",
        "recovery_plan_identity_sha256",
        "execution_policy_file_sha256",
        "execution_policy_identity_sha256"
      ],
      "properties": {
        "cutover_approval_file_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_approval_identity_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "cutover_policy_identity_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_file_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_file_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "pre_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_post_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "removal_scope_identity_sha256": {"$ref": "#/$defs/sha256"},
        "destination_set_identity_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executedCanonicalRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "pre_cutover_head_oid",
        "pre_cutover_remote_head_oid",
        "expected_post_cutover_git_tree_oid",
        "expected_cutover_commit_oid",
        "post_cutover_head_oid",
        "post_cutover_remote_head_oid",
        "worktree_status",
        "remote_ref_status",
        "publication_status"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "pre_cutover_head_oid": {"$ref": "#/$defs/gitOid"},
        "pre_cutover_remote_head_oid": {"$ref": "#/$defs/gitOid"},
        "expected_post_cutover_git_tree_oid": {"$ref": "#/$defs/gitOid"},
        "expected_cutover_commit_oid": {"$ref": "#/$defs/gitOid"},
        "post_cutover_head_oid": {"$ref": "#/$defs/gitOid"},
        "post_cutover_remote_head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"},
        "remote_ref_status": {"const": "head-equals-remote-branch"},
        "publication_status": {"const": "exact-branch-ref-updated"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_unit_count",
        "removed_file_count",
        "removed_total_bytes",
        "repair_count",
        "post_removal_gate_count",
        "destination_repository_count"
      ],
      "properties": {
        "executed_unit_count": {"type": "integer", "minimum": 1},
        "removed_file_count": {"type": "integer", "minimum": 1},
        "removed_total_bytes": {"type": "integer", "minimum": 0},
        "repair_count": {"type": "integer", "minimum": 1},
        "post_removal_gate_count": {"type": "integer", "minimum": 1},
        "destination_repository_count": {"type": "integer", "minimum": 1}
      }
    },
    "explicitCliConfirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutover_approval_identity_sha256",
        "execution_policy_identity_sha256",
        "pre_cutover_head_oid",
        "expected_cutover_commit_oid",
        "execution_context",
        "confirmation_status"
      ],
      "properties": {
        "cutover_approval_identity_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_identity_sha256": {"$ref": "#/$defs/sha256"},
        "pre_cutover_head_oid": {"$ref": "#/$defs/gitOid"},
        "expected_cutover_commit_oid": {"$ref": "#/$defs/gitOid"},
        "execution_context": {"enum": ["disposable-fixture", "canonical-production"]},
        "confirmation_status": {"const": "matched"}
      }
    },
    "destinationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "repository_id",
        "branch",
        "head_oid",
        "remote_head_oid",
        "tree_sha256",
        "destination_status"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 200},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "remote_head_oid": {"$ref": "#/$defs/gitOid"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "destination_status": {"const": "unchanged-head-equals-remote-and-content-verified"}
      }
    },
    "executedRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "after_sha256", "execution_status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "execution_status": {"const": "applied-and-verified"}
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "argv",
        "cwd",
        "timeout_seconds",
        "exit_code",
        "stdout_size_bytes",
        "stdout_sha256",
        "stderr_size_bytes",
        "stderr_sha256",
        "execution_gate_status"
      ],
      "properties": {
        "gate_id": {"$ref": "#/$defs/safeToken"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "exit_code": {"type": "integer"},
        "stdout_size_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_size_bytes": {"type": "integer", "minimum": 0},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "execution_gate_status": {"const": "passed"}
      }
    },
    "treeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_cutover_tree_sha256",
        "authorized_post_cutover_tree_sha256",
        "post_cutover_git_tree_oid",
        "post_cutover_status"
      ],
      "properties": {
        "pre_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "authorized_post_cutover_tree_sha256": {"$ref": "#/$defs/sha256"},
        "post_cutover_git_tree_oid": {"$ref": "#/$defs/gitOid"},
        "post_cutover_status": {"const": "exact-authorized-regular-file-and-git-tree"}
      }
    },
    "transactionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup_type",
        "local_ref_update",
        "remote_ref_update",
        "receipt_promotion",
        "pre_receipt_failure_recovery",
        "distributed_atomicity",
        "transaction_status"
      ],
      "properties": {
        "backup_type": {"const": "full-regular-file-and-mode-pre-cutover-copy"},
        "local_ref_update": {"const": "compare-and-swap-pre-head-to-expected-commit"},
        "remote_ref_update": {"const": "exact-force-with-lease-pre-head-to-expected-commit"},
        "receipt_promotion": {"const": "atomic-hardlink-after-remote-ref-verification"},
        "pre_receipt_failure_recovery": {"const": "exact-lease-remote-ref-rollback-then-local-tree-rollback"},
        "distributed_atomicity": {"const": "not-guaranteed"},
        "transaction_status": {"const": "committed"}
      }
    }
  }
}
