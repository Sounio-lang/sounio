{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-production-mapping-proposal.v1.schema.json",
  "title": "Sounio R3 Canonical Production Target Repository Mapping Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_type",
    "authority_scope",
    "proposal_status",
    "catalog_identity_sha256",
    "canonical_repository_id",
    "mappings",
    "limitations",
    "proposal_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-production-mapping-proposal.v1"},
    "proposal_type": {"const": "target-repository-mapping-proposal"},
    "authority_scope": {"const": "repository-target-proposal-only"},
    "proposal_status": {"const": "proposed-not-approved"},
    "catalog_identity_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_repository_id": {"$ref": "#/$defs/safeToken"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mapping"}
    },
    "limitations": {
      "const": [
        "proposal_does_not_create_or_modify_repositories",
        "proposal_is_not_destination_owner_approval",
        "proposal_is_not_canonical_production_approval",
        "proposal_does_not_authorize_source_removal_or_ref_updates",
        "proposal_does_not_assert_scientific_truth"
      ]
    },
    "proposal_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_owner",
        "repository_id",
        "remote_url",
        "branch",
        "expected_head_oid",
        "mapping_status"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "branch": {"$ref": "#/$defs/safeId"},
        "expected_head_oid": {"$ref": "#/$defs/gitOid"},
        "mapping_status": {"const": "proposed-not-approved"}
      }
    }
  }
}
