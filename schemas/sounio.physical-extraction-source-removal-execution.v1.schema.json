{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-source-removal-execution.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Source-Removal Execution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_type",
    "authority_scope",
    "execution_status",
    "source_removal_status",
    "source_bindings",
    "execution_scope",
    "summary",
    "operator_approval",
    "execution_root_marker",
    "repairs",
    "post_removal_gates",
    "tree_evidence",
    "transaction_evidence",
    "assurance_level",
    "limitations",
    "execution_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-source-removal-execution.v1"},
    "execution_type": {"const": "policy-bound-local-source-removal"},
    "authority_scope": {"const": "exact-local-repository-tree"},
    "execution_status": {"const": "executed-and-verified"},
    "source_removal_status": {"const": "executed"},
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_file_sha256",
        "authorization_identity_sha256",
        "materialization_file_sha256",
        "materialization_identity_sha256",
        "execution_policy_file_sha256",
        "execution_policy_identity_sha256"
      ],
      "properties": {
        "authorization_file_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_file_sha256": {"$ref": "#/$defs/sha256"},
        "materialization_identity_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "execution_policy_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_scope": {
      "$ref": "sounio.physical-extraction-source-removal-policy.v1.schema.json#/$defs/removalScope"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed_unit_count",
        "removed_file_count",
        "removed_total_bytes",
        "repair_count",
        "post_removal_gate_count"
      ],
      "properties": {
        "executed_unit_count": {"type": "integer", "minimum": 1},
        "removed_file_count": {"type": "integer", "minimum": 1},
        "removed_total_bytes": {"type": "integer", "minimum": 0},
        "repair_count": {"type": "integer", "minimum": 1},
        "post_removal_gate_count": {"type": "integer", "minimum": 1}
      }
    },
    "operator_approval": {
      "$ref": "sounio.physical-extraction-source-removal-execution-policy.v1.schema.json#/$defs/operatorApproval"
    },
    "execution_root_marker": {
      "$ref": "sounio.physical-extraction-source-removal-execution-policy.v1.schema.json#/$defs/fileEvidence"
    },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/executedRepair"}
    },
    "post_removal_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gateEvidence"}
    },
    "tree_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_execution_file_count",
        "pre_execution_tree_sha256",
        "post_execution_tree_sha256",
        "post_execution_status"
      ],
      "properties": {
        "pre_execution_file_count": {"type": "integer", "minimum": 1},
        "pre_execution_tree_sha256": {"$ref": "#/$defs/sha256"},
        "post_execution_tree_sha256": {"$ref": "#/$defs/sha256"},
        "post_execution_status": {"const": "exact-authorized-tree"}
      }
    },
    "transaction_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_type", "receipt_promotion", "normal_failure_rollback", "transaction_status"],
      "properties": {
        "backup_type": {"const": "full-regular-file-pre-execution-copy"},
        "receipt_promotion": {"const": "promoted-after-post-execution-verification"},
        "normal_failure_rollback": {"const": "exact-pre-execution-tree"},
        "transaction_status": {"const": "committed"}
      }
    },
    "assurance_level": {"const": "identity-only"},
    "limitations": {
      "const": [
        "does_not_assert_this_execution_is_canonical_production_cutover",
        "execution_scope_is_only_the_bound_local_repository_tree",
        "does_not_assert_remote_repository_or_publication_state",
        "does_not_transfer_ownership_or_maintainership",
        "operator_label_does_not_prove_human_identity_or_organizational_authority",
        "does_not_guarantee_crash_atomicity_across_multiple_filesystem_operations",
        "crash_recovery_requires_the_retained_transaction_workspace_when_no_receipt_exists",
        "requires_a_quiescent_execution_root_without_nonparticipating_writers",
        "does_not_preserve_uninventoried_filesystem_metadata",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority",
        "does_not_assert_independent_replay",
        "post_execution_verification_uses_bound_receipts_and_materialized_copies_not_removed_sources"
      ]
    },
    "execution_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "executedRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_size_bytes",
        "before_sha256",
        "replacement_path",
        "replacement_size_bytes",
        "replacement_sha256",
        "after_size_bytes",
        "after_sha256",
        "repair_status",
        "execution_status"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "before_size_bytes": {"type": "integer", "minimum": 0},
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "replacement_path": {"type": "string", "minLength": 1},
        "replacement_size_bytes": {"type": "integer", "minimum": 0},
        "replacement_sha256": {"$ref": "#/$defs/sha256"},
        "after_size_bytes": {"type": "integer", "minimum": 0},
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "repair_status": {"const": "applied-and-verified"},
        "execution_status": {"const": "executed-and-verified"}
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "argv",
        "cwd",
        "timeout_seconds",
        "exit_code",
        "stdout_size_bytes",
        "stdout_sha256",
        "stderr_size_bytes",
        "stderr_sha256",
        "execution_gate_status"
      ],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "exit_code": {"const": 0},
        "stdout_size_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_size_bytes": {"type": "integer", "minimum": 0},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "execution_gate_status": {"const": "passed"}
      }
    }
  }
}
