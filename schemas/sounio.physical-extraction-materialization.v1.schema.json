{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-materialization.v1.schema.json",
  "title": "Sounio R3 Physical Extraction Materialization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "materialization_type",
    "authority_scope",
    "materialization_status",
    "source_removal_status",
    "source_bindings",
    "summary",
    "units",
    "assurance_level",
    "limitations",
    "materialization_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-materialization.v1"},
    "materialization_type": {"const": "verified-local-exact-copy"},
    "authority_scope": {"const": "local-destination-byte-identity"},
    "materialization_status": {"const": "copied-and-verified"},
    "source_removal_status": {"const": "not-authorized"},
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_file_sha256",
        "inventory_identity_sha256",
        "destination_policy_file_sha256",
        "destination_policy_identity_sha256"
      ],
      "properties": {
        "inventory_file_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_identity_sha256": {"$ref": "#/$defs/sha256"},
        "destination_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "destination_policy_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialized_unit_count",
        "file_count",
        "total_bytes",
        "retained_source_units",
        "blocked_source_units"
      ],
      "properties": {
        "materialized_unit_count": {"type": "integer", "minimum": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "retained_source_units": {"type": "integer", "minimum": 0},
        "blocked_source_units": {"type": "integer", "minimum": 0}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "assurance_level": {"const": "identity-only"},
    "limitations": {
      "const": [
        "does_not_delete_source_files",
        "does_not_transfer_ownership_or_maintainership",
        "does_not_assert_remote_repository_state",
        "does_not_assert_publication_or_registry_status",
        "does_not_preserve_uninventoried_filesystem_metadata",
        "does_not_guarantee_crash_atomicity_across_multiple_destinations",
        "does_not_assert_scientific_truth",
        "does_not_assert_clinical_validation_or_clinical_authority",
        "does_not_assert_independent_replay",
        "full_verification_requires_original_sources_inventory_policy_and_destinations"
      ]
    },
    "materialization_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeToken": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "ring",
        "target_id",
        "target_owner",
        "destination_key",
        "content_path",
        "destination_marker_sha256",
        "source_tree_sha256",
        "destination_tree_sha256",
        "file_count",
        "total_bytes",
        "copy_status",
        "files"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "ring": {"enum": ["scientific-package", "research"]},
        "target_id": {"$ref": "#/$defs/safeId"},
        "target_owner": {"$ref": "#/$defs/safeToken"},
        "destination_key": {"$ref": "#/$defs/safeToken"},
        "content_path": {"$ref": "#/$defs/safeToken"},
        "destination_marker_sha256": {"$ref": "#/$defs/sha256"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "destination_tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "copy_status": {"const": "copied-and-verified"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        }
      }
    }
  }
}
