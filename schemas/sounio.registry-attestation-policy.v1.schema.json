{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.org/schemas/sounio.registry-attestation-policy.v1.schema.json",
  "title": "Sounio registry attestation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry", "acceptance"],
  "properties": {
    "schema": {"const": "sounio.registry-attestation-policy.v1"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "namespace", "authority-scope", "publication-status"],
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "namespace": {"$ref": "#/$defs/token"},
        "authority-scope": {"const": "local-catalog-index"},
        "publication-status": {"const": "disabled"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed-rings",
        "allowed-visibilities",
        "allowed-claim-classes",
        "allowed-assurance-levels",
        "required-boundary-mode",
        "required-boundary-verdict"
      ],
      "properties": {
        "allowed-rings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["pl-core", "scientific-package", "research"]}
        },
        "allowed-visibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["public", "protected", "embargoed"]}
        },
        "allowed-claim-classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "allowed-assurance-levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"const": "identity-only"}
        },
        "required-boundary-mode": {"const": "strict"},
        "required-boundary-verdict": {"const": "OK"}
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
