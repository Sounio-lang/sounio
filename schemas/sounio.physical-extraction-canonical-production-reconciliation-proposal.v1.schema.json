{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sounio.dev/schemas/sounio.physical-extraction-canonical-production-reconciliation-proposal.v1.schema.json",
  "title": "Sounio R3 Canonical Production Path-Level Reconciliation Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_type",
    "authority_scope",
    "proposal_status",
    "execution_authority",
    "destination_write_authority",
    "source_removal_authority",
    "canonical_production_approval",
    "canonical_cutover_execution_status",
    "next_required_action",
    "evidence_binding",
    "source_snapshot",
    "destination_snapshot",
    "proposed_strategy",
    "summary",
    "path_plan_sha256",
    "path_plan",
    "review_decisions_required",
    "execution_preconditions_if_separately_authorized",
    "limitations",
    "proposal_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "sounio.physical-extraction-canonical-production-reconciliation-proposal.v1"},
    "proposal_type": {"const": "path-level-exact-source-mirror-proposal"},
    "authority_scope": {"const": "reconciliation-description-and-review-only"},
    "proposal_status": {"const": "proposed-not-approved"},
    "execution_authority": {"const": "none"},
    "destination_write_authority": {"const": "none"},
    "source_removal_authority": {"const": "none"},
    "canonical_production_approval": {"const": "not-approved"},
    "canonical_cutover_execution_status": {"const": "not-executed"},
    "next_required_action": {"const": "human-review-only-no-execution"},
    "evidence_binding": {"$ref": "#/$defs/evidenceBinding"},
    "source_snapshot": {"$ref": "#/$defs/sourceSnapshot"},
    "destination_snapshot": {"$ref": "#/$defs/destinationSnapshot"},
    "proposed_strategy": {"$ref": "#/$defs/strategy"},
    "summary": {"$ref": "#/$defs/summary"},
    "path_plan_sha256": {"$ref": "#/$defs/sha256"},
    "path_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pathPlanRow"}
    },
    "review_decisions_required": {
      "const": [
        "accept-or-reject-source-only-additions",
        "accept-or-reject-changed-path-replacements",
        "accept-reject-or-preserve-destination-only-paths",
        "reissue-after-any-source-destination-or-policy-drift"
      ]
    },
    "execution_preconditions_if_separately_authorized": {
      "const": [
        "obtain-separate-explicit-destination-write-authorization",
        "reobserve-exact-source-and-destination-git-bindings",
        "review-every-destination-only-path-disposition",
        "review-every-changed-path-replacement",
        "establish-separate-execution-and-recovery-policy",
        "generate-and-review-an-immutable-pre-execution-ref-snapshot"
      ]
    },
    "limitations": {
      "const": [
        "proposal_never_grants_execution_or_destination_write_authority",
        "proposal_does_not_copy_replace_or_remove_any_repository_file",
        "proposal_does_not_create_commits_push_refs_tags_releases_or_registry_entries",
        "proposal_does_not_remove_or_relocate_canonical_source_files",
        "proposal_is_bound_to_sequential_point_in_time_snapshots_not_atomic_remote_state",
        "proposal_must_be_reissued_after_any_bound_git_or_byte_drift",
        "destination_only_removals_are_described_for_review_not_authorized",
        "exact_byte_mirroring_does_not_prove_scientific_truth",
        "proposal_does_not_assert_clinical_validation_or_clinical_authority",
        "production_approval_and_canonical_cutover_remain_absent"
      ]
    },
    "proposal_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "safeToken": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "gitObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_name", "remote_url", "branch", "head_oid", "worktree_status"],
      "properties": {
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"$ref": "#/$defs/nonEmptyString"},
        "branch": {"$ref": "#/$defs/safeId"},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"}
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_file_sha256", "evidence_identity_sha256", "target_id"],
      "properties": {
        "evidence_file_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_identity_sha256": {"$ref": "#/$defs/sha256"},
        "target_id": {"$ref": "#/$defs/safeId"}
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_name",
        "remote_url",
        "branch",
        "head_oid",
        "worktree_status",
        "source_path",
        "file_count",
        "total_bytes",
        "comparison_tree_sha256"
      ],
      "properties": {
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"$ref": "#/$defs/nonEmptyString"},
        "branch": {"$ref": "#/$defs/safeId"},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"},
        "source_path": {"$ref": "#/$defs/nonEmptyString"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "comparison_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "destinationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "remote_name",
        "remote_url",
        "branch",
        "head_oid",
        "worktree_status",
        "file_count",
        "total_bytes",
        "comparison_tree_sha256"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/safeToken"},
        "remote_name": {"$ref": "#/$defs/safeToken"},
        "remote_url": {"$ref": "#/$defs/nonEmptyString"},
        "branch": {"$ref": "#/$defs/safeId"},
        "head_oid": {"$ref": "#/$defs/gitOid"},
        "worktree_status": {"const": "clean"},
        "file_count": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "comparison_tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_id",
        "strategy_status",
        "desired_postcondition",
        "destination_only_path_disposition",
        "mutation_authority"
      ],
      "properties": {
        "strategy_id": {"const": "exact-source-mirror"},
        "strategy_status": {"const": "described-for-review-not-authorized"},
        "desired_postcondition": {"const": "destination-tree-equals-source-subtree-by-path-size-and-sha256"},
        "destination_only_path_disposition": {"const": "remove-only-if-separately-explicitly-approved"},
        "mutation_authority": {"const": "none"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_count",
        "mutation_path_count",
        "add_path_count",
        "replace_path_count",
        "remove_path_count",
        "retain_path_count",
        "proposed_destination_file_count",
        "proposed_destination_total_bytes"
      ],
      "properties": {
        "path_count": {"type": "integer", "minimum": 1},
        "mutation_path_count": {"type": "integer", "minimum": 1},
        "add_path_count": {"type": "integer", "minimum": 0},
        "replace_path_count": {"type": "integer", "minimum": 0},
        "remove_path_count": {"type": "integer", "minimum": 0},
        "retain_path_count": {"type": "integer", "minimum": 0},
        "proposed_destination_file_count": {"type": "integer", "minimum": 1},
        "proposed_destination_total_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "fileState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size_bytes", "sha256"],
      "properties": {
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableFileState": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/fileState"}
      ]
    },
    "pathPlanRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "disposition",
        "operation_authority",
        "source",
        "destination_before",
        "destination_after_if_separately_approved"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "disposition": {
          "enum": [
            "add-source-byte-copy",
            "remove-destination-only",
            "replace-with-source-byte-copy",
            "retain-identical"
          ]
        },
        "operation_authority": {"const": "none"},
        "source": {"$ref": "#/$defs/nullableFileState"},
        "destination_before": {"$ref": "#/$defs/nullableFileState"},
        "destination_after_if_separately_approved": {"$ref": "#/$defs/nullableFileState"}
      }
    }
  }
}
