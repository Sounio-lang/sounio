module main

use pbpk::rapamycin_slow_adjusted::{
    sa_margin_n7, sa_margin_n14, sa_margin_n28,
    sa_n_crit, sa_n_last_cert, sa_n_peak, sa_margin_peak,
    sa_ncrit_gap, sa_nlast_cert_gain
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Slow stratum D=2.5mg — monitoring visits ===\n")
    print("margin_n7=");  print_f64(sa_margin_n7());  print("\n")
    print("margin_n14="); print_f64(sa_margin_n14()); print("\n")
    print("margin_n28="); print_f64(sa_margin_n28()); print("\n")

    print("\n=== Trajectory ===\n")
    print("n_crit=");       pi(sa_n_crit());        print("\n")
    print("n_last_cert=");  pi(sa_n_last_cert());   print("\n")
    print("n_peak=");       pi(sa_n_peak());         print("\n")
    print("margin_peak=");  print_f64(sa_margin_peak()); print("\n")

    print("\n=== vs D=5mg standard ===\n")
    print("ncrit_gap (adj-std)=");       pi(sa_ncrit_gap());        print("\n")
    print("nlast_cert_gain (adj-std)="); pi(sa_nlast_cert_gain());  print("\n")
}
