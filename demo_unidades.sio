// ============================================================================
// SOUNIO DEMO 1: Análise Dimensional e Unidades Físicas Estáticas
// ============================================================================
//
// Como testar o compilador do Sounio protegendo você de erros de física:
//
// 1. Execute o código correto:
//    ./bin/souc run demo_unidades.sio
//
// 2. Agora force um erro de física! Altere a linha 25 de:
//    let speed: f64<m/s> = distance / elapsed
//    para:
//    let speed: f64<m/s> = distance + elapsed
//
// 3. Tente compilar novamente:
//    ./bin/souc check demo_unidades.sio
//
// O compilador rejeitará o código em menos de 0.3 segundos, impedindo que
// um erro físico ("somar metros com segundos") chegue ao tempo de execução!
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Sounio Demo 1: Análise Dimensional ===")

    let distance: m = 100.0       // Tipo 'm' (metro)
    let elapsed: s = 9.58         // Tipo 's' (segundo)

    // Sounio calcula e valida a dimensão derivada m/s automaticamente!
    let speed: f64<m/s> = distance / elapsed

    print("Distância percorrida: ")
    print_f64(distance)
    println(" m")

    print("Tempo decorrido     : ")
    print_f64(elapsed)
    println(" s")

    print("Velocidade calculada: ")
    print_f64(speed)
    println(" m/s")

    println("\n[SOUC] Sucesso! Tipo físico validado estaticamente.")
    return 0
}
