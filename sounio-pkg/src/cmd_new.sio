// sounio-pkg/src/cmd_new.sio — new package generator
//
// Prints a bash script to stdout that creates a new Sounio package.
// The bash wrapper pipes this output through: PKG_NAME="<name>" bash
//
// The script uses $PKG_NAME (unquoted heredoc) for the manifest so that
// bash expands it to the actual project name at execution time.

pub fn main() with IO {
    println("#!/usr/bin/env bash")
    println("set -e")
    println("[ -z \"$PKG_NAME\" ] && { echo 'error: PKG_NAME not set' >&2; exit 1; }")
    println("[ -d \"$PKG_NAME\" ] && { echo \"error: directory '$PKG_NAME' already exists\" >&2; exit 1; }")
    println("mkdir -p \"$PKG_NAME/src\" \"$PKG_NAME/tests\"")
    println("")
    println("# Write sounio.toml (unquoted heredoc — bash expands $PKG_NAME)")
    println("cat > \"$PKG_NAME/sounio.toml\" << EOF")
    println("[package]")
    println("name = \"$PKG_NAME\"")
    println("version = \"0.1.0\"")
    println("edition = \"2025\"")
    println("description = \"A new Sounio package\"")
    println("")
    println("[dependencies]")
    println("EOF")
    println("")
    println("# Write src/lib.sio (quoted heredoc — preserves content literally)")
    println("cat > \"$PKG_NAME/src/lib.sio\" << 'SIOEOF'")
    println("pub fn main() with IO {")
    println("    println(\"Hello, world!\")")
    println("}")
    println("SIOEOF")
    println("")
    println("# Write tests/test_main.sio")
    println("cat > \"$PKG_NAME/tests/test_main.sio\" << 'SIOEOF'")
    println("// tests/test_main.sio")
    println("")
    println("fn test_true() {")
    println("    assert(true)")
    println("}")
    println("")
    println("pub fn main() with IO, Panic {")
    println("    test_true()")
    println("    println(\"PASS: all tests passed\")")
    println("}")
    println("SIOEOF")
    println("")
    println("echo \"Created package: $PKG_NAME\"")
    println("echo \"  $PKG_NAME/sounio.toml\"")
    println("echo \"  $PKG_NAME/src/lib.sio\"")
    println("echo \"  $PKG_NAME/tests/test_main.sio\"")
    println("echo \"\"")
    println("echo \"Run: cd $PKG_NAME && sounio-pkg build\"")
}
