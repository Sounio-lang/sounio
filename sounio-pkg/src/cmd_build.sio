// sounio-pkg/src/cmd_build.sio — build command
//
// Prints a bash script to stdout that type-checks the current package.
// The bash wrapper pipes this through: bash

pub fn main() with IO {
    println("#!/usr/bin/env bash")
    println("set -e")
    println("SOUC=\"${SOUC:-./artifacts/omega/souc-bin/souc-linux-x86_64-jit}\"")
    println("export SOUNIO_STDLIB_PATH=\"${SOUNIO_STDLIB_PATH:-$(pwd)/stdlib}\"")
    println("if [ ! -f sounio.toml ]; then")
    println("  echo 'error: sounio.toml not found — are you inside a sounio package?' >&2")
    println("  exit 1")
    println("fi")
    println("if [ ! -f src/lib.sio ]; then")
    println("  echo 'error: src/lib.sio not found' >&2")
    println("  exit 1")
    println("fi")
    println("echo 'Building...'")
    println("\"$SOUC\" check src/lib.sio")
    println("echo 'Build OK'")
}
