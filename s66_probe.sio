module main

use pbpk::rapamycin_loading_dose::{
    ld_std_trough_load_n1, ld_std_trough_load_n7,
    ld_std_margin_load_n1, ld_std_margin_load_n3, ld_std_margin_load_n7,
    ld_std_ncrit_load, ld_std_nlast_load, ld_std_span_load,
    ld_std_ncrit_uniform, ld_std_nlast_uniform, ld_std_span_uniform, ld_std_advance,
    ld_slow_margin_load_n1, ld_slow_margin_load_n7,
    ld_slow_ncrit_load, ld_slow_nlast_load, ld_slow_span_load,
    ld_slow_ncrit_uniform, ld_slow_advance,
    ld_fast_margin_load_n1, ld_fast_margin_load_n7,
    ld_fast_ncrit_load, ld_fast_nlast_load, ld_fast_span_load,
    ld_fast_ncrit_uniform, ld_fast_advance,
    ld_inh_margin_load_n1, ld_inh_margin_load_n7,
    ld_inh_ncrit_load, ld_inh_nlast_load, ld_inh_span_load,
    ld_inh_ncrit_uniform, ld_inh_advance,
    ld_ind_margin_load_n1, ld_ind_margin_load_n7,
    ld_ind_ncrit_load, ld_ind_nlast_load, ld_ind_span_load,
    ld_ind_ncrit_uniform, ld_ind_advance
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== STD (15mg load + 5mg maint) ===\n")
    print("trough N=1 (load): "); print_f64(ld_std_trough_load_n1()); print("\n")
    print("trough N=7 (load): "); print_f64(ld_std_trough_load_n7()); print("\n")
    print("margin N=1: "); print_f64(ld_std_margin_load_n1()); print("\n")
    print("margin N=3: "); print_f64(ld_std_margin_load_n3()); print("\n")
    print("margin N=7: "); print_f64(ld_std_margin_load_n7()); print("\n")
    print("load: ncrit="); pi(ld_std_ncrit_load()); print(" nlast="); pi(ld_std_nlast_load()); print(" span="); pi(ld_std_span_load()); print("\n")
    print("unif: ncrit="); pi(ld_std_ncrit_uniform()); print(" nlast="); pi(ld_std_nlast_uniform()); print(" span="); pi(ld_std_span_uniform()); print("\n")
    print("advance: "); pi(ld_std_advance()); print(" days\n")

    print("\n=== SLOW (7.5mg load + 2.5mg maint) ===\n")
    print("margin N=1: "); print_f64(ld_slow_margin_load_n1()); print("\n")
    print("margin N=7: "); print_f64(ld_slow_margin_load_n7()); print("\n")
    print("load: ncrit="); pi(ld_slow_ncrit_load()); print(" nlast="); pi(ld_slow_nlast_load()); print(" span="); pi(ld_slow_span_load()); print("\n")
    print("unif ncrit="); pi(ld_slow_ncrit_uniform()); print(" advance="); pi(ld_slow_advance()); print("\n")

    print("\n=== FAST (28.5mg load + 9.5mg maint) ===\n")
    print("margin N=1: "); print_f64(ld_fast_margin_load_n1()); print("\n")
    print("margin N=7: "); print_f64(ld_fast_margin_load_n7()); print("\n")
    print("load: ncrit="); pi(ld_fast_ncrit_load()); print(" nlast="); pi(ld_fast_nlast_load()); print(" span="); pi(ld_fast_span_load()); print("\n")
    print("unif ncrit="); pi(ld_fast_ncrit_uniform()); print(" advance="); pi(ld_fast_advance()); print("\n")

    print("\n=== INH (4.5mg load + 1.5mg maint) ===\n")
    print("margin N=1: "); print_f64(ld_inh_margin_load_n1()); print("\n")
    print("margin N=7: "); print_f64(ld_inh_margin_load_n7()); print("\n")
    print("load: ncrit="); pi(ld_inh_ncrit_load()); print(" nlast="); pi(ld_inh_nlast_load()); print(" span="); pi(ld_inh_span_load()); print("\n")
    print("unif ncrit="); pi(ld_inh_ncrit_uniform()); print(" advance="); pi(ld_inh_advance()); print("\n")

    print("\n=== IND (102mg load + 34mg maint) ===\n")
    print("margin N=1: "); print_f64(ld_ind_margin_load_n1()); print("\n")
    print("margin N=7: "); print_f64(ld_ind_margin_load_n7()); print("\n")
    print("load: ncrit="); pi(ld_ind_ncrit_load()); print(" nlast="); pi(ld_ind_nlast_load()); print(" span="); pi(ld_ind_span_load()); print("\n")
    print("unif ncrit="); pi(ld_ind_ncrit_uniform()); print(" advance="); pi(ld_ind_advance()); print("\n")
}
