module main

use pbpk::rapamycin_dual_adjusted_coverage::{
    dac_cert_n7,  dac_warn_n7,  dac_alarm_n7,
    dac_cert_n14, dac_warn_n14, dac_alarm_n14,
    dac_cert_n28, dac_warn_n28, dac_alarm_n28
}
use pbpk::rapamycin_adjusted_coverage::{
    ac_cert_n7,  ac_warn_n7,  ac_alarm_n7,
    ac_cert_n14, ac_warn_n14, ac_alarm_n14,
    ac_cert_n28, ac_warn_n28, ac_alarm_n28
}
use pbpk::rapamycin_population_coverage::{
    pc_cert_n7,  pc_warn_n7,  pc_alarm_n7,
    pc_cert_n14, pc_warn_n14, pc_alarm_n14,
    pc_cert_n28, pc_warn_n28, pc_alarm_n28
}

fn main() with Mut, Div, Panic, IO {
    print("=== Standard protocol (Sprint 46) ===\n")
    print("N=7:  cert="); print_f64(pc_cert_n7());  print(" warn="); print_f64(pc_warn_n7());  print(" alarm="); print_f64(pc_alarm_n7());  print("\n")
    print("N=14: cert="); print_f64(pc_cert_n14()); print(" warn="); print_f64(pc_warn_n14()); print(" alarm="); print_f64(pc_alarm_n14()); print("\n")
    print("N=28: cert="); print_f64(pc_cert_n28()); print(" warn="); print_f64(pc_warn_n28()); print(" alarm="); print_f64(pc_alarm_n28()); print("\n")

    print("\n=== Slow-only adjusted (Sprint 50) ===\n")
    print("N=7:  cert="); print_f64(ac_cert_n7());  print(" warn="); print_f64(ac_warn_n7());  print(" alarm="); print_f64(ac_alarm_n7());  print("\n")
    print("N=14: cert="); print_f64(ac_cert_n14()); print(" warn="); print_f64(ac_warn_n14()); print(" alarm="); print_f64(ac_alarm_n14()); print("\n")
    print("N=28: cert="); print_f64(ac_cert_n28()); print(" warn="); print_f64(ac_warn_n28()); print(" alarm="); print_f64(ac_alarm_n28()); print("\n")

    print("\n=== Dual-adjusted (Sprint 53) ===\n")
    print("N=7:  cert="); print_f64(dac_cert_n7());  print(" warn="); print_f64(dac_warn_n7());  print(" alarm="); print_f64(dac_alarm_n7());  print("\n")
    print("N=14: cert="); print_f64(dac_cert_n14()); print(" warn="); print_f64(dac_warn_n14()); print(" alarm="); print_f64(dac_alarm_n14()); print("\n")
    print("N=28: cert="); print_f64(dac_cert_n28()); print(" warn="); print_f64(dac_warn_n28()); print(" alarm="); print_f64(dac_alarm_n28()); print("\n")

    print("\n=== Deltas dual vs standard ===\n")
    print("N=7  Δcert="); print_f64(dac_cert_n7()  - pc_cert_n7());  print(" Δwarn="); print_f64(dac_warn_n7()  - pc_warn_n7());  print(" Δalarm="); print_f64(dac_alarm_n7()  - pc_alarm_n7());  print("\n")
    print("N=14 Δcert="); print_f64(dac_cert_n14() - pc_cert_n14()); print(" Δwarn="); print_f64(dac_warn_n14() - pc_warn_n14()); print(" Δalarm="); print_f64(dac_alarm_n14() - pc_alarm_n14()); print("\n")
    print("N=28 Δcert="); print_f64(dac_cert_n28() - pc_cert_n28()); print(" Δwarn="); print_f64(dac_warn_n28() - pc_warn_n28()); print(" Δalarm="); print_f64(dac_alarm_n28() - pc_alarm_n28()); print("\n")

    print("\n=== Deltas dual vs slow-only ===\n")
    print("N=7  Δcert="); print_f64(dac_cert_n7()  - ac_cert_n7());  print(" Δwarn="); print_f64(dac_warn_n7()  - ac_warn_n7());  print(" Δalarm="); print_f64(dac_alarm_n7()  - ac_alarm_n7());  print("\n")
    print("N=14 Δcert="); print_f64(dac_cert_n14() - ac_cert_n14()); print(" Δwarn="); print_f64(dac_warn_n14() - ac_warn_n14()); print(" Δalarm="); print_f64(dac_alarm_n14() - ac_alarm_n14()); print("\n")
    print("N=28 Δcert="); print_f64(dac_cert_n28() - ac_cert_n28()); print(" Δwarn="); print_f64(dac_warn_n28() - ac_warn_n28()); print(" Δalarm="); print_f64(dac_alarm_n28() - ac_alarm_n28()); print("\n")
}
