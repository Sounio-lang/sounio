//@ run-pass
//@ timeout: 300
//@ expect-stdout-contains: BDQ_LUNG_LEDGERS_PASS
// ============================================================================
// BEDAQUILINE LUNG PBPK IN HUMANS — Sounio reimplementation
//
// Model: Karakitsios, Della Pasqua & Dokoumetzidis (2025), Br J Clin Pharmacol
//        91:3167-3178, doi:10.1002/bcp.70163 — Supporting Information eqs S1-S19,
//        Tables S2-S4 (human physiology), S8, S11, S13 (parameters fitted in mice).
// Plasma driver: Svensson, Dosne & Karlsson (2016), CPT:PSP 5:682,
//        doi:10.1002/psp4.12147 — Table 3, typical patient at reference covariates.
// Regimen: 400 mg qd x 14 d, then 200 mg Mon/Wed/Fri to the end of week 24.
//
// Oracle: demos/aris_bdq/ref/bdq.cpp (C++23, same equations, independent code).
// Gate:   demos/aris_bdq/parity.sh compares the BDQ| lines below against the
//         oracle (relative tolerance 1e-5).
//
// Every state equation is linear in the state (k_caseum(t) depends on time only),
// so the system is advanced with TR-BDF2 (L-stable, second order) and a dense
// LU solve per stage. Doses are applied on step boundaries.
//
// Reading choices that the paper leaves open, and that this file makes explicit:
//   * ionisation: diprotic BASE (pKa 8.5 and 1.1). The formula printed in S1
//     contains an acid term 10^(pH-pKa2); with it the published figures cannot be
//     reproduced (oracle mode `ion`). See ion_w() below.
//   * eq S12: back-diffusion from cas2 enters cas1 with a PLUS sign (the printed
//     sign removes mass from the chain). The ledger at the end proves conservation.
//   * K_EW:B is not reported; derived from equal unbound-unionised concentration
//     between plasma and EW.
//   * tau (onset of the fractal rate) is not reported; 1e-3 h (insensitive).
// ============================================================================

fn fabs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ---- units of the physical inputs (dimensional audit at the end of the program)
unit cm;
unit h;
unit mL = cm * cm * cm;
unit flow = mL / h;
unit area = cm * cm;
unit permeability = cm / h;
unit Lph = L / h;

fn ps_typed(perm: permeability, sa: area) -> flow with Mut {
    perm * sa
}

fn capacity_typed(v_ew: mL, v_pb: mL, k_ewb: f64, fu_ew: f64) -> mL with Mut, Div {
    (v_ew + v_pb / k_ewb) / fu_ew
}

fn k10_typed(cl: Lph, v: L) -> f64 with Mut, Div {
    let k = cl / v
    k as f64
}

struct Params {
    cl: f64, v: f64, q1: f64, vp1: f64, q2: f64, vp2: f64,
    mat_frac: f64, fr: f64, f_bio: f64,
    q_lung: f64, sa: f64,
    v_pb: f64, v_ew: f64, v_lys: f64, v_iw: f64,
    ph_pl: f64, ph_ew: f64, ph_iw: f64, ph_lys: f64, ph_foamy: f64,
    bp: f64, fu_pls: f64, fu_ew: f64,
    pka_hi: f64, pka_lo: f64,
    perm: f64, kplys_fu_mouse: f64, ph_iw_mouse: f64,
    rate_m: f64, r_m: f64, rate_f: f64, r_f: f64,
    kp_cas: f64, kcas: f64, h: f64, tau: f64,
    flys: f64, ratio1: f64
}

// ---- every input as Knowledge: value, evidence quality ε, provenance -------------
// ε is evidence quality, not probability. The scheme used here is explicit and
// contestable:
//   0.90  estimated from human data with RSE < 10 %           (Svensson 2016)
//   0.85  estimated in mice, RSE < 10 %                        (S8, S11, S13)
//   0.80  physiology tables / drug constants from industry data (S2, S3, S4)
//   0.70  estimated in mice, RSE 10–30 %
//   0.60  estimated in mice, RSE > 30 %, or a value read from one image
//   0.50  assumed, single literature value, no uncertainty given
//   0.30  assumed and called "difficult to determine" by the authors
// Reading .value is an epistemic act, so this function carries `with Epistemic`.
// Confidence gates (`with Epistemic(N)`) are checked per token inside a function,
// not across calls; the gated claim at the end therefore restates its own inputs.

fn params_from_tables() -> Params with Epistemic, Mut {
    // plasma, Svensson 2016 Table 3 (95% CI width / 3.92 → RSE)
    let cl   : Knowledge[f64] = Knowledge(2.62,   ε=0.90, prov="Svensson2016_T3_CL/F_L_per_h_RSE2.5")
    let v    : Knowledge[f64] = Knowledge(198.0,  ε=0.90, prov="Svensson2016_T3_V/F_L_RSE4.0")
    let q1   : Knowledge[f64] = Knowledge(3.66,   ε=0.90, prov="Svensson2016_T3_Q1/F_L_per_h_RSE4.3")
    let vp1  : Knowledge[f64] = Knowledge(8550.0, ε=0.90, prov="Svensson2016_T3_VP1/F_L_RSE3.8")
    let q2   : Knowledge[f64] = Knowledge(7.34,   ε=0.90, prov="Svensson2016_T3_Q2/F_L_per_h_RSE3.6")
    let vp2  : Knowledge[f64] = Knowledge(2690.0, ε=0.90, prov="Svensson2016_T3_VP2/F_L_RSE5.6")
    let matf : Knowledge[f64] = Knowledge(0.66,   ε=0.90, prov="Svensson2016_T3_MAT_fraction_of_6h")
    let fr   : Knowledge[f64] = Knowledge(0.47,   ε=0.90, prov="Svensson2016_T3_FR_transit_fraction")
    let fbio : Knowledge[f64] = Knowledge(1.0,    ε=0.50, prov="Svensson2016_F_fixed_relative")
    // human lung physiology, Karakitsios 2025 Table S3 (mL, mL/h, cm^2)
    let qlung: Knowledge[f64] = Knowledge(356000.0, ε=0.80, prov="TableS3_human_Qlung_mL_per_h_Gill2016_Simcyp")
    let sa   : Knowledge[f64] = Knowledge(960000.0, ε=0.80, prov="TableS3_human_SA_cm2_Stone1992")
    let vpb  : Knowledge[f64] = Knowledge(101.2,  ε=0.80, prov="TableS3_human_Vpb_mL_Gill2016_upper_range")
    let vew  : Knowledge[f64] = Knowledge(89.2,   ε=0.80, prov="TableS3_human_Vew_mL")
    let vlys : Knowledge[f64] = Knowledge(5.47,   ε=0.80, prov="TableS3_human_Vlys_mL_1pct_lung")
    let viw  : Knowledge[f64] = Knowledge(351.0,  ε=0.80, prov="TableS3_human_Viw_mL")
    let phpl : Knowledge[f64] = Knowledge(7.4,    ε=0.80, prov="TableS3_pH_plasma")
    let phew : Knowledge[f64] = Knowledge(7.4,    ε=0.80, prov="TableS3_pH_EW_Simcyp")
    let phiw : Knowledge[f64] = Knowledge(6.69,   ε=0.80, prov="TableS3_human_pH_IW_Simcyp")
    let phly : Knowledge[f64] = Knowledge(5.0,    ε=0.50, prov="TableS3_pH_lysosome_Simcyp_default_all_species")
    let phfo : Knowledge[f64] = Knowledge(5.84,   ε=0.50, prov="Kempker2017_pH_foamy_macrophage")
    // binding and drug constants, Tables S2 and S4
    let bp   : Knowledge[f64] = Knowledge(1.0,    ε=0.80, prov="TableS4_B/P_Janssen")
    let fupl : Knowledge[f64] = Knowledge(0.0005, ε=0.30, prov="TableS4_fu_pls_assumed_difficult_to_determine_S10")
    let fuew : Knowledge[f64] = Knowledge(0.00082, ε=0.50, prov="TableS4_fu_EW_from_fu_pls_eq7")
    let pkah : Knowledge[f64] = Knowledge(8.5,    ε=0.80, prov="TableS2_pKa_base_Janssen")
    let pkal : Knowledge[f64] = Knowledge(1.1,    ε=0.80, prov="TableS2_pKa_base_ACD_predicted")
    // fitted in mice (S8, S11, S13) and carried to humans
    let perm : Knowledge[f64] = Knowledge(55.7,   ε=0.70, prov="TableS8_Perm_cm_per_h_RSE18.9")
    let kplf : Knowledge[f64] = Knowledge(3480000.0, ε=0.85, prov="TableS8_KpLYS:IW/fuIW_RSE3.6")
    let phim : Knowledge[f64] = Knowledge(7.36,   ε=0.80, prov="TableS3_mouse_pH_IW")
    let ratm : Knowledge[f64] = Knowledge(143000.0, ε=0.85, prov="TableS11_rate_mphi_RSE7.8")
    let rm   : Knowledge[f64] = Knowledge(5680000.0, ε=0.85, prov="TableS11_Kp_mphi/(fu*fni)_RSE3.6")
    let ratf : Knowledge[f64] = Knowledge(5780.0, ε=0.70, prov="TableS13_rate_fmphi_RSE25.6")
    let rf   : Knowledge[f64] = Knowledge(1440000.0, ε=0.70, prov="TableS13_Kp_fmphi/(fu*fni)_RSE27.4")
    let kpc  : Knowledge[f64] = Knowledge(0.71,   ε=0.70, prov="TableS13_Kp_caseum_RSE29.5")
    let kcas : Knowledge[f64] = Knowledge(0.25,   ε=0.70, prov="TableS13_k_cas_RSE18.9")
    let hh   : Knowledge[f64] = Knowledge(0.75,   ε=0.85, prov="TableS13_h_RSE6.7")
    let tau  : Knowledge[f64] = Knowledge(0.001,  ε=0.50, prov="not_reported_small_constant_insensitive")
    let flys : Knowledge[f64] = Knowledge(0.078,  ε=0.50, prov="Ufuk2017_lysosomal_fraction_rat_AM_range_3.7-13.9")
    let rat1 : Knowledge[f64] = Knowledge(1.67,   ε=0.60, prov="Walter2023_ratio1_one_representative_image")
    return Params {
        cl: cl.value, v: v.value, q1: q1.value, vp1: vp1.value, q2: q2.value, vp2: vp2.value,
        mat_frac: matf.value, fr: fr.value, f_bio: fbio.value,
        q_lung: qlung.value, sa: sa.value,
        v_pb: vpb.value, v_ew: vew.value, v_lys: vlys.value, v_iw: viw.value,
        ph_pl: phpl.value, ph_ew: phew.value, ph_iw: phiw.value, ph_lys: phly.value, ph_foamy: phfo.value,
        bp: bp.value, fu_pls: fupl.value, fu_ew: fuew.value,
        pka_hi: pkah.value, pka_lo: pkal.value,
        perm: perm.value, kplys_fu_mouse: kplf.value, ph_iw_mouse: phim.value,
        rate_m: ratm.value, r_m: rm.value, rate_f: ratf.value, r_f: rf.value,
        kp_cas: kpc.value, kcas: kcas.value, h: hh.value, tau: tau.value,
        flys: flys.value, ratio1: rat1.value
    }
}

// 1 / fraction non-ionised for a diprotic base.
fn ion_w(p: Params, ph: f64) -> f64 {
    let a: f64 = pow(10.0, p.pka_hi - ph)
    let b: f64 = pow(10.0, p.pka_hi + p.pka_lo - 2.0 * ph)
    return 1.0 + a + b
}

fn fni(p: Params, ph: f64) -> f64 {
    return 1.0 / ion_w(p, ph)
}

struct DerivedP {
    ktr: f64, ka: f64, k_ewb: f64, ps: f64, w_ew: f64, a_iw: f64,
    kplys_fu_h: f64, f_iw: f64, r: f64, cap_ew: f64
}

fn derive(p: Params) -> DerivedP {
    let mat: f64 = p.mat_frac * 6.0
    let mtt: f64 = p.fr * mat
    let ln10: f64 = log(10.0)
    let k_ewb: f64 = (p.fu_pls * fni(p, p.ph_pl)) / (p.fu_ew * fni(p, p.ph_ew) * p.bp)
    let fulys_fnilys: f64 = fni(p, p.ph_iw_mouse) / p.kplys_fu_mouse
    let f_iw: f64 = p.v_iw / (p.v_pb + p.v_ew + p.v_iw + p.v_lys)
    return DerivedP {
        ktr: 2.0 / mtt,
        ka: ln10 / ((1.0 - p.fr) * mat),
        k_ewb: k_ewb,
        ps: p.perm * p.sa,
        w_ew: ion_w(p, p.ph_ew),
        a_iw: ion_w(p, p.ph_iw),
        kplys_fu_h: fni(p, p.ph_iw) / fulys_fnilys,
        f_iw: f_iw,
        r: p.flys / f_iw,
        cap_ew: (p.v_ew + p.v_pb / k_ewb) / p.fu_ew
    }
}

// ---- state layout (17): plasma amounts, lung concentrations, caseum chain, ledgers
fn i_t1() -> i32 { return 0 }
fn i_t2() -> i32 { return 1 }
fn i_dep() -> i32 { return 2 }
fn i_cen() -> i32 { return 3 }
fn i_p1() -> i32 { return 4 }
fn i_p2() -> i32 { return 5 }
fn i_elim() -> i32 { return 6 }
fn i_cuew() -> i32 { return 7 }
fn i_ciw() -> i32 { return 8 }
fn i_cmph() -> i32 { return 9 }
fn i_cas1() -> i32 { return 10 }
fn i_casin() -> i32 { return 16 }
fn ns() -> i32 { return 17 }

struct Sys {
    a: [f64; 289],
    m: [f64; 289],
    x: [f64; 17],
    y: [f64; 17],
    z: [f64; 17]
}

fn aset(s: &!Sys, i: i32, j: i32, v: f64) with Mut {
    s.a[i * 17 + j] = v
}

fn kcase(p: Params, t: f64) -> f64 {
    let d: f64 = pow(t + p.tau, p.h)
    return p.kcas / d
}

// dx/dt = A(t) x
fn build_a(p: Params, d: DerivedP, t: f64, s: &!Sys) with Mut {
    var k: i32 = 0
    while k < 289 {
        s.a[k] = 0.0
        k = k + 1
    }
    // plasma (Svensson 2016): two transit compartments, depot, 3-compartment disposition
    aset(s, i_t1(), i_t1(), 0.0 - d.ktr)
    aset(s, i_t2(), i_t1(), d.ktr)
    aset(s, i_t2(), i_t2(), 0.0 - d.ktr)
    aset(s, i_dep(), i_t2(), d.ktr)
    aset(s, i_dep(), i_dep(), 0.0 - d.ka)
    aset(s, i_cen(), i_dep(), d.ka)
    let k10: f64 = p.cl / p.v
    let k12: f64 = p.q1 / p.v
    let k21: f64 = p.q1 / p.vp1
    let k13: f64 = p.q2 / p.v
    let k31: f64 = p.q2 / p.vp2
    aset(s, i_cen(), i_cen(), 0.0 - (k10 + k12 + k13))
    aset(s, i_cen(), i_p1(), k21)
    aset(s, i_cen(), i_p2(), k31)
    aset(s, i_p1(), i_cen(), k12)
    aset(s, i_p1(), i_p1(), 0.0 - k21)
    aset(s, i_p2(), i_cen(), k13)
    aset(s, i_p2(), i_p2(), 0.0 - k31)
    aset(s, i_elim(), i_cen(), k10)
    // extracellular water, eq S1 (state: unbound EW concentration)
    let inv: f64 = 1.0 / d.cap_ew
    aset(s, i_cuew(), i_cen(), inv * p.q_lung * p.bp / p.v)
    aset(s, i_cuew(), i_cuew(), 0.0 - inv * (p.q_lung / (p.fu_ew * d.k_ewb) + d.ps / d.w_ew))
    aset(s, i_cuew(), i_ciw(), inv * d.ps / d.a_iw)
    // intracellular water + lysosomes, eq S4 (fu_IW = 1)
    let cap_iw: f64 = p.v_iw + d.kplys_fu_h * p.v_lys
    aset(s, i_ciw(), i_cuew(), d.ps / (d.w_ew * cap_iw))
    aset(s, i_ciw(), i_ciw(), 0.0 - d.ps / (d.a_iw * cap_iw))
    // cellular lesion, eq S11 (fu*fni fixed to 1)
    let denm: f64 = 1.0 / (d.r + 1.0) + p.r_m * d.r / (d.r + 1.0)
    aset(s, i_cmph(), i_cuew(), p.rate_m / d.w_ew)
    aset(s, i_cmph(), i_cmph(), 0.0 - p.rate_m / denm)
    // outer caseum lumped with cas1, eq S12; chain eqs S13-S14 (ratio2..6 = 1)
    let denf: f64 = (1.0 + p.r_f * d.r) / (d.r + 1.0)
    let g: f64 = 1.0 / (1.0 + p.ratio1 / p.kp_cas)
    let kc: f64 = kcase(p, t)
    let c1: i32 = i_cas1()
    aset(s, c1, i_cuew(), p.rate_f * p.ratio1 * g / d.w_ew)
    aset(s, c1, c1, 0.0 - p.rate_f * p.ratio1 * g / (denf * p.kp_cas) - kc * g)
    aset(s, c1, c1 + 1, kc * g)
    var n: i32 = c1 + 1
    while n <= c1 + 4 {
        aset(s, n, n - 1, kc)
        aset(s, n, n, 0.0 - 2.0 * kc)
        aset(s, n, n + 1, kc)
        n = n + 1
    }
    aset(s, c1 + 5, c1 + 4, kc)
    aset(s, c1 + 5, c1 + 5, 0.0 - kc)
    // ledger of the conserved chain quantity C1/g + C2 + ... + C6
    aset(s, i_casin(), i_cuew(), p.rate_f * p.ratio1 / d.w_ew)
    aset(s, i_casin(), c1, 0.0 - p.rate_f * p.ratio1 / (denf * p.kp_cas))
}

// s.z <- A s.x
fn matvec_into_z(s: &!Sys) with Mut {
    var i: i32 = 0
    while i < 17 {
        var acc: f64 = 0.0
        var j: i32 = 0
        while j < 17 {
            acc = acc + s.a[i * 17 + j] * s.x[j]
            j = j + 1
        }
        s.z[i] = acc
        i = i + 1
    }
}

// solve (I - c A) y = y in place, dense LU with partial pivoting
fn solve_y(s: &!Sys, c: f64) with Mut, Div {
    var i: i32 = 0
    while i < 17 {
        var j: i32 = 0
        while j < 17 {
            var e: f64 = 0.0 - c * s.a[i * 17 + j]
            if i == j { e = e + 1.0 }
            s.m[i * 17 + j] = e
            j = j + 1
        }
        i = i + 1
    }
    var k: i32 = 0
    while k < 17 {
        var piv: i32 = k
        var big: f64 = fabs(s.m[k * 17 + k])
        var r: i32 = k + 1
        while r < 17 {
            let v: f64 = fabs(s.m[r * 17 + k])
            if v > big {
                big = v
                piv = r
            }
            r = r + 1
        }
        if piv != k {
            var j2: i32 = 0
            while j2 < 17 {
                let tmp: f64 = s.m[k * 17 + j2]
                s.m[k * 17 + j2] = s.m[piv * 17 + j2]
                s.m[piv * 17 + j2] = tmp
                j2 = j2 + 1
            }
            let ty: f64 = s.y[k]
            s.y[k] = s.y[piv]
            s.y[piv] = ty
        }
        var r2: i32 = k + 1
        while r2 < 17 {
            let f: f64 = s.m[r2 * 17 + k] / s.m[k * 17 + k]
            if f != 0.0 {
                var j3: i32 = k
                while j3 < 17 {
                    s.m[r2 * 17 + j3] = s.m[r2 * 17 + j3] - f * s.m[k * 17 + j3]
                    j3 = j3 + 1
                }
                s.y[r2] = s.y[r2] - f * s.y[k]
            }
            r2 = r2 + 1
        }
        k = k + 1
    }
    var b: i32 = 16
    while b >= 0 {
        var acc: f64 = s.y[b]
        var j4: i32 = b + 1
        while j4 < 17 {
            acc = acc - s.m[b * 17 + j4] * s.y[j4]
            j4 = j4 + 1
        }
        s.y[b] = acc / s.m[b * 17 + b]
        b = b - 1
    }
}

// dose (mg) given at the start of step time t, if any
fn dose_at(t: f64) -> f64 {
    let day_f: f64 = t / 24.0
    let day: i64 = day_f as i64
    if (day as f64) * 24.0 != t { return 0.0 }
    if day < 14 { return 400.0 }
    if day >= 168 { return 0.0 }
    // from day 14: Mon/Wed/Fri pattern, period 7 days, offsets 0, 2, 4
    let off: i64 = (day - 14) % 7
    if off == 0 || off == 2 || off == 4 { return 200.0 }
    return 0.0
}

struct Obs {
    cp_u: f64, cyt_m: f64, lys_m: f64, cyt_f: f64, lys_f: f64,
    cas1: f64, cas2: f64, cas3: f64, cas4: f64, cas5: f64, cas6: f64
}

fn observe(p: Params, d: DerivedP, s: &!Sys) -> Obs with Mut {
    let cp: f64 = s.x[i_cen()] / p.v
    let fni_iw: f64 = fni(p, p.ph_foamy)
    let fni_lys: f64 = fni(p, p.ph_lys)
    let denm: f64 = (1.0 + p.r_m * d.r) / (1.0 + d.r)
    let clys_m: f64 = p.r_m * (s.x[i_cmph()] / denm)
    let cyt_m: f64 = clys_m / (p.r_m * fni_iw) * 1000.0
    let cout: f64 = s.x[i_cas1()] / p.kp_cas
    let denf: f64 = (1.0 + p.r_f * d.r) / (1.0 + d.r)
    let clys_f: f64 = p.r_f * cout / denf
    let cyt_f: f64 = clys_f / (p.r_f * fni_iw) * 1000.0
    let c1: i32 = i_cas1()
    return Obs {
        cp_u: p.fu_pls * cp * 1000.0,
        cyt_m: cyt_m,
        lys_m: cyt_m * fni_iw / fni_lys,
        cyt_f: cyt_f,
        lys_f: cyt_f * fni_iw / fni_lys,
        cas1: s.x[c1] * 1000.0, cas2: s.x[c1 + 1] * 1000.0, cas3: s.x[c1 + 2] * 1000.0,
        cas4: s.x[c1 + 3] * 1000.0, cas5: s.x[c1 + 4] * 1000.0, cas6: s.x[c1 + 5] * 1000.0
    }
}

struct SimOut {
    lysm_max_w02: f64,
    lysm_min_w324: f64,
    lysf_min_w324: f64,
    cpu_w24: f64,
    cas1_w24: f64,
    cas2_w24: f64,
    cas6_w24: f64,
    cpu_max_w02: f64,
    mass_resid_rel: f64,
    cas_resid_rel: f64
}

fn simulate(p: Params, dt: f64) -> SimOut with Mut, Div {
    let d: DerivedP = derive(p)
    var s = Sys { a: [0.0; 289], m: [0.0; 289], x: [0.0; 17], y: [0.0; 17], z: [0.0; 17] }
    let gam: f64 = 2.0 - sqrt(2.0)
    let tend: f64 = 4032.0
    let nsteps: i64 = (tend / dt + 0.5) as i64
    var dosed: f64 = 0.0
    var lysm_max: f64 = 0.0
    var cpu_max: f64 = 0.0
    var lysm_min: f64 = 1.0e300
    var lysf_min: f64 = 1.0e300
    var next_rec: f64 = 0.0
    var n: i64 = 0
    var last = observe(p, d, &!s)
    while n <= nsteps {
        let t: f64 = (n as f64) * dt
        let dose: f64 = dose_at(t)
        if dose > 0.0 {
            s.x[i_t1()] = s.x[i_t1()] + p.f_bio * dose
            dosed = dosed + p.f_bio * dose
        }
        if t + 0.000000001 >= next_rec {
            let o = observe(p, d, &!s)
            if t <= 336.0 {
                if o.lys_m > lysm_max { lysm_max = o.lys_m }
                if o.cp_u > cpu_max { cpu_max = o.cp_u }
            }
            if t >= 504.0 {
                if o.lys_m < lysm_min { lysm_min = o.lys_m }
                if o.lys_f < lysf_min { lysf_min = o.lys_f }
            }
            last = o
            next_rec = next_rec + 1.0
        }
        if n == nsteps { break }
        // TR-BDF2: trapezoid stage to t + gam*dt, then BDF2 stage to t + dt
        build_a(p, d, t, &!s)
        matvec_into_z(&!s)
        var i: i32 = 0
        while i < 17 {
            s.y[i] = s.x[i] + 0.5 * gam * dt * s.z[i]
            i = i + 1
        }
        build_a(p, d, t + gam * dt, &!s)
        solve_y(&!s, 0.5 * gam * dt)
        let c_y: f64 = 1.0 / (gam * (2.0 - gam))
        let c_x: f64 = (1.0 - gam) * (1.0 - gam) / (gam * (2.0 - gam))
        var i2: i32 = 0
        while i2 < 17 {
            s.y[i2] = c_y * s.y[i2] - c_x * s.x[i2]
            i2 = i2 + 1
        }
        build_a(p, d, t + dt, &!s)
        solve_y(&!s, (1.0 - gam) / (2.0 - gam) * dt)
        var i3: i32 = 0
        while i3 < 17 {
            s.x[i3] = s.y[i3]
            i3 = i3 + 1
        }
        n = n + 1
    }
    let inbody: f64 = s.x[0] + s.x[1] + s.x[2] + s.x[3] + s.x[4] + s.x[5]
    let mres: f64 = fabs(dosed - inbody - s.x[i_elim()]) / dosed
    let g: f64 = 1.0 / (1.0 + p.ratio1 / p.kp_cas)
    let c1: i32 = i_cas1()
    let chain: f64 = s.x[c1] / g + s.x[c1 + 1] + s.x[c1 + 2] + s.x[c1 + 3] + s.x[c1 + 4] + s.x[c1 + 5]
    let cres: f64 = fabs(chain - s.x[i_casin()]) / fabs(chain)
    return SimOut {
        lysm_max_w02: lysm_max, lysm_min_w324: lysm_min, lysf_min_w324: lysf_min,
        cpu_w24: last.cp_u, cas1_w24: last.cas1, cas2_w24: last.cas2, cas6_w24: last.cas6,
        cpu_max_w02: cpu_max, mass_resid_rel: mres, cas_resid_rel: cres
    }
}

fn emit(tag: string, v: f64) with IO {
    print("BDQ|")
    print(tag)
    print("=")
    println(v)
}

// ---- first-order GUM over the uncertainty the two papers actually report
// Karakitsios 2025 S8/S11/S13: SE / estimate.  Svensson 2016 Table 3: SE = CI width / 3.92.
fn gum_n() -> i32 { return 15 }

fn gum_name(i: i32) -> string {
    if i == 0 { return "Perm" }
    if i == 1 { return "KpLYS/fu_mouse" }
    if i == 2 { return "rate_mphi" }
    if i == 3 { return "Kp_mphi/(fu*fni)" }
    if i == 4 { return "rate_fmphi" }
    if i == 5 { return "Kp_fmphi/(fu*fni)" }
    if i == 6 { return "Kp_caseum" }
    if i == 7 { return "k_cas" }
    if i == 8 { return "h" }
    if i == 9 { return "CL/F" }
    if i == 10 { return "V/F" }
    if i == 11 { return "Q1/F" }
    if i == 12 { return "VP1/F" }
    if i == 13 { return "Q2/F" }
    return "VP2/F"
}

fn gum_rel_sd(i: i32) -> f64 {
    if i == 0 { return 10.5 / 55.7 }
    if i == 1 { return 126000.0 / 3480000.0 }
    if i == 2 { return 11200.0 / 143000.0 }
    if i == 3 { return 203000.0 / 5680000.0 }
    if i == 4 { return 1480.0 / 5780.0 }
    if i == 5 { return 395000.0 / 1440000.0 }
    if i == 6 { return 0.21 / 0.71 }
    if i == 7 { return 0.048 / 0.25 }
    if i == 8 { return 0.05 / 0.75 }
    if i == 9 { return (2.75 - 2.49) / 3.92 / 2.62 }
    if i == 10 { return (215.0 - 184.0) / 3.92 / 198.0 }
    if i == 11 { return (3.97 - 3.35) / 3.92 / 3.66 }
    if i == 12 { return (9230.0 - 7940.0) / 3.92 / 8550.0 }
    if i == 13 { return (7.84 - 6.80) / 3.92 / 7.34 }
    return (2980.0 - 2390.0) / 3.92 / 2690.0
}

// copy of p with parameter i multiplied by f
fn scaled(p: Params, i: i32, f: f64) -> Params with Mut {
    var q = p
    if i == 0 { q.perm = p.perm * f }
    if i == 1 { q.kplys_fu_mouse = p.kplys_fu_mouse * f }
    if i == 2 { q.rate_m = p.rate_m * f }
    if i == 3 { q.r_m = p.r_m * f }
    if i == 4 { q.rate_f = p.rate_f * f }
    if i == 5 { q.r_f = p.r_f * f }
    if i == 6 { q.kp_cas = p.kp_cas * f }
    if i == 7 { q.kcas = p.kcas * f }
    if i == 8 { q.h = p.h * f }
    if i == 9 { q.cl = p.cl * f }
    if i == 10 { q.v = p.v * f }
    if i == 11 { q.q1 = p.q1 * f }
    if i == 12 { q.vp1 = p.vp1 * f }
    if i == 13 { q.q2 = p.q2 * f }
    if i == 14 { q.vp2 = p.vp2 * f }
    return q
}

struct Budget {
    c_lys: [f64; 15],
    c_cas6: [f64; 15]
}

// central differences (step 1 % of the value); contribution = (s * u)^2 with u = rel_sd * 1
// in relative units, since the step and u are both relative to the nominal value.
fn gum_budget(p: Params, b: &!Budget) with Mut, Div {
    var i: i32 = 0
    while i < gum_n() {
        let up = simulate(scaled(p, i, 1.01), 0.25)
        let dn = simulate(scaled(p, i, 0.99), 0.25)
        let u: f64 = gum_rel_sd(i)
        let d_lys: f64 = (up.lysm_min_w324 - dn.lysm_min_w324) / 0.02
        let d_cas: f64 = (up.cas6_w24 - dn.cas6_w24) / 0.02
        b.c_lys[i] = d_lys * u * d_lys * u
        b.c_cas6[i] = d_cas * u * d_cas * u
        i = i + 1
    }
}

fn report_budget(tag: string, nominal: f64, c: [f64; 15]) with IO, Mut, Div {
    var var_tot: f64 = 0.0
    var i: i32 = 0
    while i < 15 {
        var_tot = var_tot + c[i]
        i = i + 1
    }
    let u: f64 = sqrt(var_tot)
    print("GUM|")
    print(tag)
    print("|nominal=")
    println(nominal)
    print("GUM|")
    print(tag)
    print("|u=")
    println(u)
    var k: i32 = 0
    while k < 15 {
        let share: f64 = c[k] / var_tot
        if share >= 0.02 {
            print("GUM|")
            print(tag)
            print("|share|")
            print(gum_name(k))
            print("=")
            println(share)
        }
        k = k + 1
    }
}

// Dimensional audit: the derived quantities the f64 core uses are recomputed from
// unit-typed literals of Tables S3 and Svensson Table 3. A swapped or mis-scaled input
// (mL for L, an area for a volume) does not compile here; a mismatch with derive()
// fails the run.
fn units_audit(p: Params, d: DerivedP) -> i32 with IO, Mut, Div {
    let perm: permeability = 55.7
    let sa: area = 960000.0
    let v_ew: mL = 89.2
    let v_pb: mL = 101.2
    let cl: Lph = 2.62
    let v: L = 198.0
    let ps: f64 = ps_typed(perm, sa) as f64
    let cap: f64 = capacity_typed(v_ew, v_pb, d.k_ewb, p.fu_ew) as f64
    let k10: f64 = k10_typed(cl, v)
    var bad: i32 = 0
    if fabs(ps - d.ps) > 0.000000000001 * fabs(d.ps) { bad = bad + 1 }
    if fabs(cap - d.cap_ew) > 0.000000000001 * fabs(d.cap_ew) { bad = bad + 1 }
    if fabs(k10 - p.cl / p.v) > 0.000000000001 * fabs(p.cl / p.v) { bad = bad + 1 }
    if bad == 0 { println("BDQ_UNITS_AUDIT_PASS") } else { println("BDQ_UNITS_AUDIT_FAIL") }
    return bad
}

// The paper's central claim, restated with the two inputs it actually rests on (see
// bdq_mic_claim_*.sio). Declared at the honest ceiling: the weakest of its own inputs,
// fu_pls (ε = 0.30). Raising the declaration above 300 is refused at compile time.
fn lysosomal_claim_mic50() -> f64 with Epistemic(300), Mut, Div, Panic {
    let fu_pls: Knowledge[f64] = Knowledge(0.0005, ε=0.30, prov="TableS4_fu_pls_assumed_difficult_to_determine_S10")
    let ph_lys: Knowledge[f64] = Knowledge(5.0, ε=0.50, prov="TableS3_pH_lysosome_Simcyp_default_all_species")
    var p = params_from_tables()
    p.fu_pls = fu_pls.value
    p.ph_lys = ph_lys.value
    let r = simulate(p, 0.25)
    r.lysm_min_w324
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let p = params_from_tables()
    let r = simulate(p, 0.25)
    emit("cpu_max_w0-2_ng_per_mL", r.cpu_max_w02)
    emit("lysM_max_w0-2_ng_per_g", r.lysm_max_w02)
    emit("lysM_min_w3-24_ng_per_g", r.lysm_min_w324)
    emit("lysF_min_w3-24_ng_per_g", r.lysf_min_w324)
    emit("cpu_w24_ng_per_mL", r.cpu_w24)
    emit("cas1_w24_ng_per_g", r.cas1_w24)
    emit("cas2_w24_ng_per_g", r.cas2_w24)
    emit("cas6_w24_ng_per_g", r.cas6_w24)
    // ledgers are printed scaled so that 6-decimal output shows them
    emit("plasma_ledger_rel_x1e9", r.mass_resid_rel * 1000000000.0)
    emit("caseum_ledger_rel_x1e9", r.cas_resid_rel * 1000000000.0)
    var ok: i32 = 0
    if r.mass_resid_rel > 0.000000001 { ok = 1 }
    if r.cas_resid_rel > 0.000000001 { ok = 1 }
    if ok == 0 { println("BDQ_LUNG_LEDGERS_PASS") } else { println("BDQ_LUNG_LEDGERS_FAIL") }
    ok = ok + units_audit(p, derive(p))
    // uncertainty the papers report, propagated to the human lung (30 extra simulations)
    var b = Budget { c_lys: [0.0; 15], c_cas6: [0.0; 15] }
    gum_budget(p, &!b)
    report_budget("lysM_min_w3-24", r.lysm_min_w324, b.c_lys)
    report_budget("cas6_w24", r.cas6_w24, b.c_cas6)
    // the efficacy claim, through the full model, at its honest confidence
    emit("claim_lysM_min_w3-24_eps300", lysosomal_claim_mic50())
    return ok
}
