//@ run-pass
//@ expect-stdout-contains: BDQ_MIC_CLAIM_HONEST_PASS
// ============================================================================
// THE PAPER'S CENTRAL CLAIM, AS A TYPED CLAIM — HONEST CEILING (compiles)
//
// Karakitsios, Della Pasqua & Dokoumetzidis (2025) conclude that only unbound
// bedaquiline in macrophage lysosomes exceeds the MIC50 in humans. In the model
// (bdq_lung.sio; rate_mphi = 1.4e5 /h) the lysosome sits in quasi-equilibrium with
// extracellular water, and the unbound lysosomal concentration reduces to
//
//     Cu_LYS = fu_pls * C_plasma * fni(pH_EW) / fni(pH_LYS)
//
// None of the lung parameters fitted in mice appears in it. The claim rests on
// the plasma model and on two inputs the paper fixes without uncertainty:
// fu_pls = 0.0005 ("difficult to determine") and pH_LYS = 5.0.
//
// Each input is carried as Knowledge[f64] with an evidence-quality epsilon and
// its provenance. The epsilons are ILLUSTRATIVE choices of this demo, written
// down so they can be argued with; epsilon is evidence quality, not probability.
//
//   C_plasma trough (Svensson 2016 pop-PK, n = 335)          eps = 0.85
//   pKa 8.5 (Janssen internal, cited in Table S2)             eps = 0.80
//   pH_LYS = 5.0 (Simcyp default, assumed in all species)     eps = 0.50
//   fu_pls = 0.0005 (assumed; S10 tests 0.00018-0.00144)      eps = 0.30
//
// `with Epistemic(N)` requires every input to carry confidence >= N.
// The maximum satisfiable N is the weakest input, fu_pls (0.30) -> 300.
// ============================================================================

fn pow10(x: f64) -> f64 {
    let v: f64 = pow(10.0, x)
    return v
}

fn lysosomal_unbound_trough() -> f64 with Epistemic(300), Mut, Div, Panic {
    let cp_trough: Knowledge[f64] = Knowledge(692.0, ε=0.85, prov="Svensson2016_Table3_typical_wk24_trough_ng_per_mL")
    let pka: Knowledge[f64] = Knowledge(8.5, ε=0.80, prov="Karakitsios2025_TableS2_Janssen_internal")
    let ph_lys: Knowledge[f64] = Knowledge(5.0, ε=0.50, prov="Karakitsios2025_TableS3_Simcyp_default_assumed_all_species")
    let fu_pls: Knowledge[f64] = Knowledge(0.0005, ε=0.30, prov="Karakitsios2025_TableS4_assumed_fixed_S10_range_0.00018_0.00144")
    let w_ew: f64 = 1.0 + pow10(pka.value - 7.4) + pow10(pka.value + 1.1 - 14.8)
    let w_lys: f64 = 1.0 + pow10(pka.value - ph_lys.value) + pow10(pka.value + 1.1 - 2.0 * ph_lys.value)
    fu_pls.value * cp_trough.value * w_lys / w_ew
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    print("unbound lysosomal trough (ng/g), MIC50 = 60: ")
    println(lysosomal_unbound_trough())
    println("BDQ_MIC_CLAIM_HONEST_PASS")
}
