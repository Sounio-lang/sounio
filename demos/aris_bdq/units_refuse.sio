//@ compile-fail
//@ error-pattern: unit mismatch in call argument
// A clearance where a volume is expected: refused at compile time.

unit L;
unit h;
unit clearance = L / h;

fn half_life(cl: clearance, v: L) -> f64 with Mut, Div {
    0.693 * (v as f64) / (cl as f64)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let cl: clearance = 2.62
    let v: L = 198.0
    println(half_life(v, cl))
    return 0
}
