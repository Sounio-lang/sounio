//@ compile-fail
//@ requires: madaros
//@ error-pattern: cannot prove ontology subsumption at this call site
// A plasma concentration of the M2 metabolite cannot be used where the
// parent drug's concentration is required: the ontology says M2 is not a
// bedaquiline, and the type system checks it at the call site.

ontology DrugOntology {
    class Chemical
    class Diarylquinoline subclass_of Chemical
    class Bedaquiline subclass_of Diarylquinoline
    class Bedaquiline_M2 subclass_of Chemical
}

fn parent_exposure(c: Knowledge<Bedaquiline>) -> i32 {
    1
}

fn main() -> i32 {
    let m2: Knowledge<Bedaquiline_M2> = measure(0 as Bedaquiline_M2, uncertainty: 0.1)
    parent_exposure(m2)
}
