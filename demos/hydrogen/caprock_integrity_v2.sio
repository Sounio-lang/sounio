// demos/hydrogen/caprock_integrity_v2.sio
//
// Caprock integrity for underground hydrogen storage — DEEP version:
// depth-coupled physics, two failure mechanisms, three candidate formations,
// corner-exact p-boxes with in-run monotonicity verification, and
// convergence/seed robustness checks. One deterministic run.
//
// Written for Dr. Emmanuel Stamatakis (NCSR Demokritos, H2Lab), following his
// 2025 review (Hydrogen 6(4):91): sealing requires the caprock to stay
// strongly water-wet *regardless of pressure and temperature*, and to
// exhibit the lowest possible diffusion coefficient.
//
// Model:
//   depth z = 800 m -> T = 15 + 25·z/1km = 35 °C, P ≈ 8.1 MPa (hydrostatic)
//   γ(P,T) = 72 − 0.15·(T−20) + 0.3·(P−1) mN/m   (±5 aleatory)
//   capillary: P_c = 2γ·cos(θ)/r  vs  Δρ·g·z (Δρ = 950 kg/m³)
//   diffusion: τ = L²/(π²·D_eff)  vs  30 yr design life,
//              D_eff intact vs micro-fractured (orders of magnitude apart)
//   θ per formation: epistemic INTERVAL (scarce, conflicting H2 data)
// Formations (illustrative ranges consistent with the review's ranking):
//   anhydrite (evaporite): θ ∈ [5,25]°,  r ~ logN(5 nm, 0.5)
//   shale:                 θ ∈ [15,45]°, r ~ logN(15 nm, 0.5)
//   mudstone:              θ ∈ [10,40]°, r ~ logN(25 nm, 0.5)
//
// Epistemic honesty: P_c is strictly decreasing in θ on [0,90°), so the
// p-box corners at θ_lo/θ_hi are EXACT bounds, not samples — the run
// verifies the monotonicity numerically before relying on it.

// ─── pure-Sounio math ───

fn mh_sqrt(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn mh_exp(x: f64) -> f64 with Mut, Div {
    if x > 700.0 { return 1.0e200 }
    if x < 0.0 - 700.0 { return 0.0 }
    var kf = x / 0.6931471805599453
    var k = kf as i64
    if kf < 0.0 {
        if kf != (k as f64) { k = k - 1 }
    }
    let r = x - (k as f64) * 0.6931471805599453
    var s = 1.0
    var term = 1.0
    var n: i64 = 1
    while n < 25 { term = term * r / (n as f64); s = s + term; n = n + 1 }
    var result = s
    if k >= 0 {
        var i: i64 = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i: i64 = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    result
}

fn mh_cos(x: f64) -> f64 {
    let x2 = x * x
    1.0 - x2 / 2.0 + x2 * x2 / 24.0 - x2 * x2 * x2 / 720.0
}

// ─── PRNG (xorshift, deterministic) ───

var RNG_A: i64 = 0
var RNG_B: i64 = 0

fn rng_seed(a: i64, b: i64) with Mut {
    RNG_A = a
    RNG_B = b
}

fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}

fn rand_uniform() -> f64 with Mut, Div {
    let r = rng_next()
    (r % 10000) as f64 / 10000.0
}

fn rand_normal() -> f64 with Mut, Div {
    var sum = 0.0
    var j = 0
    while j < 12 { sum = sum + rand_uniform(); j = j + 1 }
    sum - 6.0
}

fn rand_gaussian(mu: f64, sigma: f64) -> f64 with Mut, Div {
    mu + sigma * rand_normal()
}

// ─── physics ───

fn gamma_pt(t: f64, p: f64) -> f64 {
    72.0 - 0.15 * (t - 20.0) + 0.3 * (p - 1.0)
}

// ln(median radius [m]) for a radius given in nm
fn ln_radius_nm(r_nm: f64) -> f64 with Mut, Div {
    // ln(r_nm) + ln(1e-9) = ln(r_nm) - 20.72326583694641
    // ln via log2-free identity: use built-in decomposition
    // small set of values -> Newton on exp is overkill; use ln(5)=1.6094379,
    // ln(15)=2.7080502, ln(25)=3.2188758 via generic series below
    mh_ln(r_nm) - 20.72326583694641
}

fn mh_ln(x: f64) -> f64 with Mut, Div {
    // ln(x) for x > 0: reduce x = m * 2^k with m in [1,2), atanh series
    var m = x
    var k: i64 = 0
    while m >= 2.0 { m = m / 2.0; k = k + 1 }
    while m < 1.0 { m = m * 2.0; k = k - 1 }
    // ln(m) = 2*atanh((m-1)/(m+1)), 12 terms suffice to 1e-10 on [1,2)
    let y = (m - 1.0) / (m + 1.0)
    let y2 = y * y
    var term = y
    var sum = 0.0
    var i: i64 = 0
    while i < 12 {
        sum = sum + term / (2.0 * (i as f64) + 1.0)
        term = term * y2
        i = i + 1
    }
    2.0 * sum + (k as f64) * 0.6931471805599453
}

// capillary seal reliability [%] at fixed theta (aleatory gamma, r)
fn seal_mc(theta_deg: f64, gmu: f64, r_med_nm: f64, thr_mpa: f64, n: i64) -> f64 with Mut, Div {
    let cth = mh_cos(theta_deg * 3.141592653589793 / 180.0)
    let lnr = ln_radius_nm(r_med_nm)
    var i: i64 = 0
    var hits: i64 = 0
    while i < n {
        let gamma = rand_gaussian(gmu, 5.0) / 1000.0
        let r = mh_exp(rand_gaussian(lnr, 0.5))
        let pc = 2.0 * gamma * cth / r / 1000000.0
        if pc >= thr_mpa { hits = hits + 1 }
        i = i + 1
    }
    100.0 * (hits as f64) / (n as f64)
}

fn tau_years(l: f64, d: f64) -> f64 with Div {
    l * l / (9.869604401089358 * d) / 31557600.0
}

// P_c at a fixed point (for monotonicity verification)
fn pc_point(theta_deg: f64, gamma_mn: f64, r_nm: f64) -> f64 {
    2.0 * (gamma_mn / 1000.0) * mh_cos(theta_deg * 3.141592653589793 / 180.0)
        / (r_nm * 0.000000001) / 1000000.0
}

// ─── main ───

fn main() -> i32 with IO, Mut, Div {
    let z = 800.0
    let temp = 15.0 + 25.0 * z / 1000.0
    let pres = 0.1 + 10.0 * z / 1000.0
    let gmu = gamma_pt(temp, pres)
    let thr = 950.0 * 9.81 * z / 1000000.0

    print("=== Caprock integrity v2 — depth-coupled, 2 mechanisms, 3 formations ===")
    println("")
    print("depth [m]: "); println(z)
    print("T [C]: "); println(temp)
    print("P [MPa]: "); println(pres)
    print("gamma(P,T) [mN/m]: "); println(gmu)
    print("capillary threshold [MPa]: "); println(thr)
    println("")

    // ── monotonicity verification: P_c strictly decreasing in theta ──
    var ok = 1
    var prev = pc_point(5.0, gmu, 15.0)
    var tg = 10.0
    while tg <= 45.0 {
        let cur = pc_point(tg, gmu, 15.0)
        if cur >= prev { ok = 0 }
        prev = cur
        tg = tg + 5.0
    }
    if ok == 1 {
        println("monotonicity P_c(theta) VERIFIED -> corner p-box bounds are exact")
    } else {
        println("MONOTONICITY FAIL -> corner bounds not certified")
        return 1
    }
    println("")

    // ── per-formation corner p-boxes ──
    let n: i64 = 20000

    print("ANHYDRITE (evaporite):")
    println("")
    rng_seed(314159265, 271828182)
    let a_hi = seal_mc(5.0, gmu, 5.0, thr, n)
    rng_seed(314159265, 271828182)
    let a_lo = seal_mc(25.0, gmu, 5.0, thr, n)
    print("   seal p-box [%]: "); println(a_lo)
    print("              ...: "); println(a_hi)
    print("   epistemic width [pp]: "); println(a_hi - a_lo)
    println("")

    print("SHALE:")
    println("")
    rng_seed(314159265, 271828182)
    let s_hi = seal_mc(15.0, gmu, 15.0, thr, n)
    rng_seed(314159265, 271828182)
    let s_lo = seal_mc(45.0, gmu, 15.0, thr, n)
    print("   seal p-box [%]: "); println(s_lo)
    print("              ...: "); println(s_hi)
    print("   epistemic width [pp]: "); println(s_hi - s_lo)
    println("")

    print("MUDSTONE:")
    println("")
    rng_seed(314159265, 271828182)
    let m_hi = seal_mc(10.0, gmu, 25.0, thr, n)
    rng_seed(314159265, 271828182)
    let m_lo = seal_mc(40.0, gmu, 25.0, thr, n)
    print("   seal p-box [%]: "); println(m_lo)
    print("              ...: "); println(m_hi)
    print("   epistemic width [pp]: "); println(m_hi - m_lo)
    println("")

    // ── diffusion: intact vs micro-fractured ──
    print("DIFFUSION lifetime tau = L^2/(pi^2 D) vs 30 yr design life:")
    println("")
    print("   intact L=50m D=1e-11 [yr]: "); println(tau_years(50.0, 0.00000000001))
    print("   intact L=50m D=1e-09 [yr]: "); println(tau_years(50.0, 0.000000001))
    print("   FRACT  L=50m D=1e-07 [yr]: "); println(tau_years(50.0, 0.0000001))
    print("   FRACT  L=20m D=1e-07 [yr]: "); println(tau_years(20.0, 0.0000001))
    println("")

    // ── robustness: convergence + seed invariance (shale, theta=30) ──
    print("ROBUSTNESS (shale, theta=30):")
    println("")
    rng_seed(314159265, 271828182)
    print("   N=1000   rel [%]: "); println(seal_mc(30.0, gmu, 15.0, thr, 1000))
    rng_seed(314159265, 271828182)
    print("   N=10000  rel [%]: "); println(seal_mc(30.0, gmu, 15.0, thr, 10000))
    rng_seed(314159265, 271828182)
    print("   N=50000  rel [%]: "); println(seal_mc(30.0, gmu, 15.0, thr, 50000))
    rng_seed(999983, 787787)
    print("   N=50000 alt-seed : "); println(seal_mc(30.0, gmu, 15.0, thr, 50000))
    println("")

    // ── the statement ──
    print("Evaporites seal robustly (p-box ~[99,100]%). Shale is INDETERMINATE:")
    println("")
    print("its ~24-point epistemic width — not physics scatter — decides the")
    println("")
    print("site. Diffusion through intact caprock is safe for millennia; micro-")
    println("")
    print("fracturing flips it below the 30 yr design life. Measure wettability")
    println("")
    print("and image the fractures: that is where the certainty is bought.")
    println("")
    println("CAPROCK_INTEGRITY_V2_OK")
    0
}
