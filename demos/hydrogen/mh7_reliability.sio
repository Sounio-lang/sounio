// demos/hydrogen/mh7_reliability.sio
//
// Seven-stage metal-hydride hydrogen compressor — reliability of the 350 bar
// HRS delivery target under alloy BATCH uncertainty, with the two dependence
// structures the literature never separates (independent batches vs worst-case
// same-batch correlation), a distribution-free corner p-box, analytic GUM, and
// Sobol per-stage variance shares that name the alloy to characterize first.
//
// Written for Dr. Emmanuel Stamatakis (NCSR Demokritos, H2Lab): the system is
// his seven-stage MH compressor for Hydrogen Refuelling Stations — Renewable
// Energy 147 (2020) 164-178, DOI 10.1016/j.renene.2019.08.104, on which he is
// first author — a paper that closes by offering itself "as the model and tool
// for sensitivity analysis and optimization". This file answers that
// invitation with epistemic UQ in the language.
//
// Published oracles reproduced in this run (his paper):
//   overall pressure ratio 18.7 at 80 C, reaching 365 bar (37.96 kWh_th/kg)
//   overall pressure ratio 41.5 at 120 C (56.05 kWh_th/kg)
//
// HONESTY — what is NOT from his paper. His Table 3 (per-stage alloys with
// their van't Hoff parameters) is paywalled to us: both fetch attempts were
// refused (403). The per-stage internals below are therefore a REPRESENTATIVE
// construction and are never attributed to him:
//   - ΔH ladder 24..36 kJ/mol H2, evenly spaced (AB5/MmNi5-family range) — OURS;
//   - per-stage efficiency η = 0.90 (hysteresis + plateau slope + drops) —
//     assumption, the cascade-demo idiom;
//   - per-stage temperature-swing ladder s(T_max) = S80·((T_max − 293.15)/60)^γ
//     with S80 = 15.238957 K and γ = 0.613475 — SOLVED from his two published
//     ratios (18.7 @ 80 C, 41.5 @ 120 C) given the two items above, so both
//     oracles are reproduced exactly by construction. The fitted ladder implies
//     ~15-21 K per-stage swings — a thermally coupled cascade splitting the
//     heat budget, not seven independent 60 K swings.
//   SWAP SLOT: replace dh_nom/w with his Table 3 rows and re-solve (S80, γ);
//   every number in this file re-derives itself.
//
// The Knightian core: alloy ΔH shifts per production BATCH by ±1.5..2.5 kJ/mol
// (literature interval range, ±2.0 the mid-point). Nobody publishes
// batch-to-batch distributions, so batch deviations are INTERVALS, not
// distributions. Width assignment is ours and labeled: mature AB5 early stages
// ±1.5, less-characterized high-pressure stages ±2.5. Dependence structures:
// stages filled from the SAME batch share one deviation (comonotonic);
// different batches are independent. Both are computed by Monte Carlo, and
// the corner p-box (all δ = −w vs all δ = +w) is distribution-free: P7 is
// strictly increasing in every ΔH_i, so the corners are exact bounds for ANY
// batch behavior. Field context: MH compressors have shown ~1-year field
// lifetimes (Tarasov 2019) against ~10^4-cycle demands — the reliability of
// the PRESSURE TARGET under batch uncertainty is the binding question.
//
// Run:  bin/souc run demos/hydrogen/mh7_reliability.sio
// Byte-identical on the Madaros and lean_single engines by construction (see
// the determinism note below); ends with MH7_RELIABILITY_OK.

// NOTE: `use epistemic::pbox::*` and `use epistemic::sobol_indices::*`
// together trip a spurious E035 (both modules export a `run_tests` symbol;
// dual-wildcard collision). Qualified calls without `use` silently no-op on
// this compiler, so the workaround is selective import of the two pbox
// functions this file uses.
use epistemic::sobol_indices::*
use epistemic::pbox::new
use epistemic::pbox::width

// ─── pure-Sounio math (no extern) ───

fn mh_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn mh_sqrt(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn mh_exp(x: f64) -> f64 with Mut, Div {
    if x > 700.0 { return 1.0e200 }
    if x < 0.0 - 700.0 { return 0.0 }
    var kf = x / 0.6931471805599453
    var k = kf as i64
    if kf < 0.0 {
        if kf != (k as f64) { k = k - 1 }
    }
    let r = x - (k as f64) * 0.6931471805599453
    var s = 1.0
    var term = 1.0
    var n: i64 = 1
    while n < 25 { term = term * r / (n as f64); s = s + term; n = n + 1 }
    var result = s
    if k >= 0 {
        var i: i64 = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i: i64 = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    result
}

fn mh_ln(x: f64) -> f64 with Mut, Div {
    var m = x
    var k: i64 = 0
    while m >= 2.0 { m = m / 2.0; k = k + 1 }
    while m < 1.0 { m = m * 2.0; k = k - 1 }
    let y = (m - 1.0) / (m + 1.0)
    let y2 = y * y
    var term = y
    var sum = 0.0
    var i: i64 = 0
    while i < 12 {
        sum = sum + term / (2.0 * (i as f64) + 1.0)
        term = term * y2
        i = i + 1
    }
    2.0 * sum + (k as f64) * 0.6931471805599453
}

// normal CDF via Abramowitz-Stegun 7.1.26 (|err| < 1.5e-7 on erf)
fn phi(x: f64) -> f64 with Mut, Div {
    var v = x / 1.4142135623730951
    var neg = false
    if v < 0.0 { neg = true; v = 0.0 - v }
    let t = 1.0 / (1.0 + 0.3275911 * v)
    let t2 = t * t
    let poly = 0.254829592 * t - 0.284496736 * t2 + 1.421413741 * t2 * t
             - 1.453152027 * t2 * t2 + 1.061405429 * t2 * t2 * t
    var e = 1.0 - poly * mh_exp(0.0 - v * v)
    if neg { e = 0.0 - e }
    0.5 * (1.0 + e)
}

// ─── PRNG (xorshift, deterministic seed → reproducible receipt) ───

var RNG_A: i64 = 0
var RNG_B: i64 = 0

fn rng_seed(a: i64, b: i64) with Mut {
    RNG_A = a
    RNG_B = b
}

fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}

fn rand_u() -> f64 with Mut, Div {
    (rng_next() % 10000) as f64 / 10000.0
}

// ─── cross-engine determinism helpers ───
//
// The two compiler backends (Madaros, lean_single) evaluate this file's
// pure-Sounio float chains to within 1 ulp of each other, but their f64
// PRINTERS are not interchangeable — one truncates where the other rounds,
// and 6-decimal decimals are not binary-representable, so no binary float
// can be trusted to print identically on both. Therefore:
//  - every number below is printed by print_fix6, which scales to an
//    INTEGER with round-half-up and emits decimal digits as string
//    literals — bit-identical integer in, byte-identical text out;
//  - the Monte Carlo decision is a pure-integer comparison (see mc_hits):
//    the event {ln P7 >= ln 350} is rearranged so that a sum of 84 integer
//    draws is compared against one integer threshold per sample, with the
//    exact ceiling rule t = ceil(y) (for integer sd, sd >= y is exactly
//    sd >= ceil(y)) — no borderline float `>` can flip a count.

fn floor_i64(x: f64) -> i64 with Mut {
    var n = x as i64
    if (n as f64) > x { n = n - 1 }
    return n
}

fn ceil_i64(x: f64) -> i64 with Mut {
    var n = floor_i64(x)
    if (n as f64) < x { n = n + 1 }
    return n
}

fn pct(hits: i64, n: i64) -> f64 with Div {
    100.0 * (hits as f64) / (n as f64)
}

fn pd(d: i64) with IO {
    if d == 0 { print("0") }
    if d == 1 { print("1") }
    if d == 2 { print("2") }
    if d == 3 { print("3") }
    if d == 4 { print("4") }
    if d == 5 { print("5") }
    if d == 6 { print("6") }
    if d == 7 { print("7") }
    if d == 8 { print("8") }
    if d == 9 { print("9") }
}

// fixed 6-decimal printer; |x| < 10^6, round-half-up
fn print_fix6(x: f64) with IO, Mut {
    var v = x
    if v < 0.0 { print("-"); v = 0.0 - v }
    let n = floor_i64(v * 1000000.0 + 0.5)
    let ip = n / 1000000
    let fp = n % 1000000
    var div: i64 = 100000
    while div > ip { div = div / 10 }
    if div < 1 { div = 1 }
    while div > 0 { pd((ip / div) % 10); div = div / 10 }
    print(".")
    var fdiv: i64 = 100000
    while fdiv > 0 { pd((fp / fdiv) % 10); fdiv = fdiv / 10 }
}

// fixed 4-decimal printer, same construction — used for the stage window
// temperatures, whose rational arithmetic lands exactly on 6-decimal
// rounding half-boundaries (engine printers disagree there by design)
fn print_fix4(x: f64) with IO, Mut {
    var v = x
    if v < 0.0 { print("-"); v = 0.0 - v }
    let n = floor_i64(v * 10000.0 + 0.5)
    let ip = n / 10000
    let fp = n % 10000
    var div: i64 = 100000
    while div > ip { div = div / 10 }
    if div < 1 { div = 1 }
    while div > 0 { pd((ip / div) % 10); div = div / 10 }
    print(".")
    var fdiv: i64 = 1000
    while fdiv > 0 { pd((fp / fdiv) % 10); fdiv = fdiv / 10 }
}

// ─── the system (representative internals — read the header) ───

var DH_NOM: [f64; 7] = [0.0; 7]   // kJ/mol H2, OUR representative ladder
var W_DH: [f64; 7] = [0.0; 7]     // kJ/mol batch interval half-widths

fn stage_tcold(i: i64, t0: f64, step: f64) -> f64 with Div {
    t0 + (i as f64) * step
}

// thermal leverage a_i = (1/T_cold,i − 1/T_hot,i)/R  [per kJ/mol]:
// d(ln r_i)/d(ΔH_i) — how stage i's batch deviation moves ln P7.
fn stage_a(i: i64, t0: f64, step: f64, swing: f64) -> f64 with Div {
    let tc = t0 + (i as f64) * step
    let th = tc + swing
    (1.0 / tc - 1.0 / th) / 8.314 * 1000.0
}

fn sum_dh() -> f64 {
    DH_NOM[0] + DH_NOM[1] + DH_NOM[2] + DH_NOM[3] + DH_NOM[4] + DH_NOM[5] + DH_NOM[6]
}

// ─── Monte Carlo on P(ln P7 >= ln 350) — integer decision ───
//
// ln P7 = ln P7_nom + Σ a_i δ_i + σ_η Σ g_j, where δ_i is stage i's batch
// deviation (kJ/mol) and g_j are Irwin-Hall normals (sum of 12 uniforms
// minus 6). With sd the sum of the 84 integer draws behind the 7 g_j,
//     margin + Σ a_i δ_i + σ_η (sd/10^4 − 42) >= 0
// ⟺  sd >= (42 − (margin + Σ a_i δ_i)/σ_η)·10^4 = y
// ⟺  sd >= ceil(y)   (exact for integer sd).
// mode: 0 independent batches, 1 comonotonic same batch, 2 mid (δ = 0),
//       3 corner δ = −w, 4 corner δ = +w. Returns hits out of n.

fn mc_hits(mode: i64, n: i64, t0: f64, step: f64, swing: f64,
           margin: f64, sig_eta: f64, sum_aw: f64) -> i64 with Mut, Div {
    var hits: i64 = 0
    var i: i64 = 0
    while i < n {
        var ad = 0.0
        if mode == 0 {
            var k: i64 = 0
            while k < 7 {
                // NOTE: keep the RNG call in its own statement — on this
                // Madaros build, a Mut-effectful call combined with a
                // global-array read in one expression double-consumes the
                // stream (engine divergence; lean_single is correct).
                let u = rand_u()
                let d = W_DH[k] * (2.0 * u - 1.0)
                ad = ad + stage_a(k, t0, step, swing) * d
                k = k + 1
            }
        }
        if mode == 1 {
            let phi_u = 2.0 * rand_u() - 1.0
            ad = phi_u * sum_aw
        }
        if mode == 3 { ad = 0.0 - sum_aw }
        if mode == 4 { ad = sum_aw }
        var sd: i64 = 0
        var j: i64 = 0
        while j < 84 { sd = sd + rng_next() % 10000; j = j + 1 }
        let y = (42.0 - (margin + ad) / sig_eta) * 10000.0
        if sd >= ceil_i64(y) { hits = hits + 1 }
        i = i + 1
    }
    hits
}

// ─── Sobol machinery (Saltelli matrices, precomputed outputs) ───
// 14 inputs: cols 0..6 = batch deviations δ_i (uniform on [-w_i, w_i]),
// cols 7..13 = per-stage log-efficiency scatter g_j (Irwin-Hall normal).
// Model is EXACTLY linear in the inputs: f(x) = margin + Σ a_i x_i + σ Σ x_j,
// so stdlib log_linear_indices gives exact shares and Jansen is the
// sampling cross-check.

var SAL_A: [f64; 224000] = [0.0; 224000]
var SAL_B: [f64; 224000] = [0.0; 224000]
var SFA: [f64; 16384] = [0.0; 16384]
var SFB: [f64; 16384] = [0.0; 16384]
var SFAB: [f64; 16384] = [0.0; 16384]
var SIG14: [f64; 16384] = [0.0; 16384]
var OUT14: [f64; 16384] = [0.0; 16384]

fn draw_input(c: i64) -> f64 with Mut, Div {
    if c < 7 {
        // RNG call hoisted into its own statement — see mc_hits note.
        let u = rand_u()
        return W_DH[c] * (2.0 * u - 1.0)
    }
    var s = 0.0
    var j = 0
    while j < 12 { s = s + rand_u(); j = j + 1 }
    s - 6.0
}

fn eval_row(c_override: i64, j: i64, t0: f64, step: f64, swing: f64,
            margin: f64, sig_eta: f64) -> f64 with Mut, Div {
    var acc = margin
    var c: i64 = 0
    while c < 14 {
        var v = SAL_A[c * 16000 + j]
        if c == c_override { v = SAL_B[c * 16000 + j] }
        if c < 7 {
            acc = acc + stage_a(c, t0, step, swing) * v
        } else {
            acc = acc + sig_eta * v
        }
        c = c + 1
    }
    acc
}

fn eval_row_b(j: i64, t0: f64, step: f64, swing: f64,
              margin: f64, sig_eta: f64) -> f64 with Mut, Div {
    var acc = margin
    var c: i64 = 0
    while c < 14 {
        let v = SAL_B[c * 16000 + j]
        if c < 7 {
            acc = acc + stage_a(c, t0, step, swing) * v
        } else {
            acc = acc + sig_eta * v
        }
        c = c + 1
    }
    acc
}

// ─── main ───

fn main() -> i32 with IO, Mut, Div {
    // representative internals (OURS — see header)
    DH_NOM[0] = 24.0; DH_NOM[1] = 26.0; DH_NOM[2] = 28.0; DH_NOM[3] = 30.0
    DH_NOM[4] = 32.0; DH_NOM[5] = 34.0; DH_NOM[6] = 36.0
    W_DH[0] = 1.5; W_DH[1] = 1.5; W_DH[2] = 2.0; W_DH[3] = 2.0
    W_DH[4] = 2.0; W_DH[5] = 2.5; W_DH[6] = 2.5

    let t0 = 293.15
    let s80 = 15.238957          // K, fitted (with gamma) from his two ratios
    let gamma = 0.613475         // swing scaling exponent, same fit
    let eta_nom = 0.90           // per-stage efficiency lump (assumption)
    let sig_eta = 0.035          // aleatory scatter on ln eta (assumption)
    let t80 = 353.15
    let t120 = 393.15
    let step80 = ((t80 - s80) - t0) / 6.0
    let p0 = 365.0 / 18.7        // supply bar implied by the 365/18.7 oracle
    let ln_eta = mh_ln(eta_nom)
    let c_eff = 400.0            // J/(mol H2 K) per stage, energy sanity only

    print("=== 7-stage MH compressor — batch-uncertainty reliability ===")
    println("")
    print("  Stamatakis et al., Renewable Energy 147 (2020) 164-178,")
    println("")
    print("  DOI 10.1016/j.renene.2019.08.104. Oracles: ratio 18.7 @ 80 C")
    println("")
    print("  reaching 365 bar (37.96 kWh/kg); ratio 41.5 @ 120 C (56.05).")
    println("")
    print("  Per-stage internals are a REPRESENTATIVE ladder calibrated to")
    println("")
    print("  those oracles — his Table 3 is paywalled; swap slot in header.")
    println("")
    println("")

    // ── nominal chain ──
    print("Nominal chain @ 80 C (stage | window C | dH +- w kJ/mol | r_i | P bar):")
    println("")
    var lnsum = 0.0
    var p = p0
    var k: i64 = 0
    while k < 7 {
        let a = stage_a(k, t0, step80, s80)
        let lnr = a * DH_NOM[k] + ln_eta
        let r = mh_exp(lnr)
        lnsum = lnsum + lnr
        p = p * r
        print("  "); pd(k + 1); print(" | ")
        print_fix4(stage_tcold(k, t0, step80) - 273.15); print("..")
        print_fix4(stage_tcold(k, t0, step80) + s80 - 273.15); print(" | ")
        print_fix6(DH_NOM[k]); print(" +- "); print_fix6(W_DH[k]); print(" | ")
        print_fix6(r); print(" | "); print_fix6(p); println("")
        k = k + 1
    }
    println("")
    print("  overall ratio (oracle 18.7)      : "); print_fix6(mh_exp(lnsum)); println("")
    print("  delivery P7 (oracle 365 bar)     : "); print_fix6(p); println("")
    print("  supply P0 implied by oracle pair : "); print_fix6(p0); println("")
    // 120 C oracle check: same ladder, swing scaled by the fitted exponent
    let swing120 = s80 * mh_exp(gamma * mh_ln((t120 - t0) / (t80 - t0)))
    let step120 = ((t120 - swing120) - t0) / 6.0
    var lnsum120 = 0.0
    k = 0
    while k < 7 {
        lnsum120 = lnsum120 + stage_a(k, t0, step120, swing120) * DH_NOM[k] + ln_eta
        k = k + 1
    }
    print("  ratio @120 C (oracle 41.5)       : "); print_fix6(mh_exp(lnsum120)); println("")
    print("  fitted per-stage swing 80/120 [K]: "); print_fix6(s80); print(" / "); print_fix6(swing120); println("")
    let q80 = (sum_dh() + 7.0 * c_eff * s80 / 1000.0) * 500.0 / 3600.0
    let q120 = (sum_dh() + 7.0 * c_eff * swing120 / 1000.0) * 500.0 / 3600.0
    print("  thermal 80 C (oracle 37.96 kWh/kg): "); print_fix6(q80); println("")
    print("  thermal 120 C (oracle 56.05)      : "); print_fix6(q120)
    print("  <- sanity only: the C_eff lump"); println("")
    print("     under-prices high-T sensible/regeneration heat, by design.")
    println("")
    println("")

    // ── UQ setup ──
    let margin = mh_ln(p / 350.0)
    var sum_aw = 0.0
    var sum_aw2 = 0.0
    k = 0
    while k < 7 {
        let aw = stage_a(k, t0, step80, s80) * W_DH[k]
        sum_aw = sum_aw + aw
        sum_aw2 = sum_aw2 + aw * aw
        k = k + 1
    }
    print("Batch-uncertainty model: dH shifts +-1.5..2.5 kJ/mol per BATCH")
    println("")
    print("  as INTERVALS (no published batch distributions), efficiency")
    println("")
    print("  scatter lognormal sigma_ln eta = 0.035 (aleatory). Target:")
    println("")
    print("  P7 >= 350 bar (350-bar dispensing). Nominal log-margin: ")
    print_fix6(margin); println("")
    println("")

    // ── Monte Carlo reliability under both dependence structures ──
    let n: i64 = 20000
    rng_seed(314159265, 271828182)
    let h_ind = mc_hits(0, n, t0, step80, s80, margin, sig_eta, sum_aw)
    rng_seed(314159265, 271828182)
    let h_cor = mc_hits(1, n, t0, step80, s80, margin, sig_eta, sum_aw)
    rng_seed(314159265, 271828182)
    let h_mid = mc_hits(2, n, t0, step80, s80, margin, sig_eta, sum_aw)
    rng_seed(314159265, 271828182)
    let h_lo = mc_hits(3, n, t0, step80, s80, margin, sig_eta, sum_aw)
    rng_seed(314159265, 271828182)
    let h_hi = mc_hits(4, n, t0, step80, s80, margin, sig_eta, sum_aw)

    print("P(P7 >= 350 bar), MC n = 20000 (integer-counted):")
    println("")
    print("  batches at nominal dH (eta scatter only) : "); print_fix6(pct(h_mid, n)); println(" %")
    print("  (a) independent batches                  : "); print_fix6(pct(h_ind, n)); println(" %")
    print("  (b) same batch, full correlation         : "); print_fix6(pct(h_cor, n)); println(" %")
    print("  dependence cost (a) - (b) [pp]           : ")
    print_fix6(pct(h_ind, n) - pct(h_cor, n)); println("")
    let rel_box = new(pct(h_lo, n), pct(h_hi, n))
    print("  distribution-free corner p-box           : [")
    print_fix6(rel_box.lo); print(" , "); print_fix6(rel_box.hi); print("] %  width ")
    print_fix6(width(rel_box)); println("")
    println("")

    // ── GUM first-order (analytic, exact in log space) ──
    let s3 = mh_sqrt(3.0)
    let var_ind = sum_aw2 / 3.0 + 7.0 * sig_eta * sig_eta
    let var_cor = sum_aw * sum_aw / 3.0 + 7.0 * sig_eta * sig_eta
    let s_ind = mh_sqrt(var_ind)
    let s_cor = mh_sqrt(var_cor)
    print("GUM (uniform batch variance w^2/3, lognormal eta):")
    println("")
    print("  sigma_ln P7  independent / correlated    : ")
    print_fix6(s_ind); print(" / "); print_fix6(s_cor); println("")
    print("  GUM P(>=350) independent / correlated [%]: ")
    print_fix6(100.0 * phi(margin / s_ind)); print(" / ")
    print_fix6(100.0 * phi(margin / s_cor)); println("")
    print("  GUM 2-sigma band on P7 (indep) [bar]     : [")
    print_fix6(p * mh_exp(0.0 - 2.0 * s_ind)); print(" , ")
    print_fix6(p * mh_exp(2.0 * s_ind)); print("]")
    println("")
    print("  GUM 2-sigma band on P7 (corr)  [bar]     : [")
    print_fix6(p * mh_exp(0.0 - 2.0 * s_cor)); print(" , ")
    print_fix6(p * mh_exp(2.0 * s_cor)); print("]")
    println("")
    println("")

    // ── Sobol: which batch dominates the variance ──
    k = 0
    while k < 7 {
        SIG14[k] = stage_a(k, t0, step80, s80) * W_DH[k] / s3
        SIG14[7 + k] = sig_eta
        k = k + 1
    }
    log_linear_indices(SIG14, &!OUT14, 14)
    // Jansen cross-check on precomputed outputs, Saltelli n = 16000
    let ns: i64 = 16000
    rng_seed(314159265, 271828182)
    var j: i64 = 0
    var c: i64 = 0
    while c < 14 {
        j = 0
        while j < ns { SAL_A[c * 16000 + j] = draw_input(c); j = j + 1 }
        c = c + 1
    }
    c = 0
    while c < 14 {
        j = 0
        while j < ns { SAL_B[c * 16000 + j] = draw_input(c); j = j + 1 }
        c = c + 1
    }
    j = 0
    while j < ns {
        SFA[j] = eval_row(0 - 1, j, t0, step80, s80, margin, sig_eta)
        SFB[j] = eval_row_b(j, t0, step80, s80, margin, sig_eta)
        j = j + 1
    }
    let var_tot = variance(SFA, ns)

    print("Sobol first-order shares of Var(ln P7) [%]: exact (log-linear, the")
    println("")
    print("  model IS linear in log space) vs Jansen MC (Saltelli n = 16000):")
    println("")
    var jansen_sum = 0.0
    c = 0
    while c < 7 {
        j = 0
        while j < ns {
            SFAB[j] = eval_row(c, j, t0, step80, s80, margin, sig_eta)
            j = j + 1
        }
        let sj = first_order_jansen(SFA, SFB, SFAB, ns, var_tot)
        jansen_sum = jansen_sum + sj
        print("  stage "); pd(c + 1); print(" batch dH: exact ")
        print_fix6(100.0 * OUT14[c]); print(" | Jansen ")
        print_fix6(100.0 * sj); println("")
        c = c + 1
    }
    var exact_eta = 0.0
    var jansen_eta = 0.0
    c = 7
    while c < 14 {
        exact_eta = exact_eta + OUT14[c]
        j = 0
        while j < ns {
            SFAB[j] = eval_row(c, j, t0, step80, s80, margin, sig_eta)
            j = j + 1
        }
        jansen_eta = jansen_eta + first_order_jansen(SFA, SFB, SFAB, ns, var_tot)
        c = c + 1
    }
    print("  efficiency scatter (all 7 stages): exact ")
    print_fix6(100.0 * exact_eta); print(" | Jansen ")
    print_fix6(100.0 * jansen_eta); println("")
    print("  Jansen indices sum (estimator noise; exact shares sum to 100): ")
    print_fix6(100.0 * (jansen_sum + jansen_eta)); println("")
    println("")

    // ── the design statement ──
    print("Reading: the nominal chain hits 365 bar with room, but honest batch")
    println("")
    print("intervals put P(>=350) at 59-67 % — and the unobservable batch")
    println("")
    print("dependence structure alone moves it by 6 points. Distribution-free,")
    println("")
    print("only the corner p-box is certain: without batch characterization the")
    println("")
    print("reliability is an interval, not a number. Sobol names the levers:")
    println("")
    print("efficiency scatter carries most of the variance; among the alloy")
    println("")
    print("batches the HIGH-pressure stages dominate — characterize those")
    println("")
    print("alloys first. That is the sensitivity analysis his paper offered")
    println("")
    print("itself as the tool for — run as one deterministic receipt.")
    println("")
    println("MH7_RELIABILITY_OK")
    0
}
