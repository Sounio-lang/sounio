// demos/hydrogen/hub_chain.sio
//
// The chain nobody closes: production -> compression -> storage ->
// DELIVERED hydrogen cost for the Crete hybrid system, with uncertainty
// propagated through all three stages as a p-box.
//
// Every number comes from the Demokritos/FORTH literature:
//   production (Energies 16:6257, 2023 — Stamatakis et al., Crete case):
//     PEM electrolyser 50 MW, 46.4 kWh/kg, CAPEX 1500 EUR/kW,
//     O&M 20 EUR/kW/yr, electrolyser CF 0.395 nominal,
//     system LCOE scenarios 0.046-0.052 EUR/kWh  -> electricity price
//     epistemic interval; CF epistemic interval [0.35, 0.44].
//   compression (Renewable Energy 147:164, 2020 + IJHE 46:29272, 2021):
//     MH thermal compression energy spans 44 kWh_th/kg (dual-stage
//     case 3: 322 kJ/mol) to 89 kWh_th/kg (seven-stage case 1:
//     136.67 MJ per 0.425 kg) -> epistemic interval [44, 89];
//     waste-heat valued at [0.005, 0.02] EUR/kWh_th.
//   storage (Energies 2023): H2 tank 500 EUR/kg capacity, 100 t store
//     cycling 37.29x/yr against 3729 t/yr production; seasonal UHS loss
//     interval [0.3, 0.6] %/yr (caprock retention p-box, see
//     caprock_integrity_v2.sio).
//
// Method: D = (prod + compr + storage)·(1 + loss) is MONOTONE in every
// epistemic input (increasing in prices/energy/loss, decreasing in CF),
// so the p-box on P(D < threshold) is exact via corner evaluation —
// machine-checked in formal/lean4/SounioHydrogenPbox.lean §3
// (monotone_event_equiv). Aleatory scatter inside each corner is a small
// Gaussian operational band; 20k MC samples per corner, deterministic seed.
//
// Question: can delivered green H2 in Crete beat 6 EUR/kg?
// Honest answer: an interval.
//
// Marker: HUB_CHAIN_OK

use epistemic::pbox::*

// ─── pure-Sounio math (same verified helpers as the other demos) ───

fn mh_sqrt(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn mh_exp(x: f64) -> f64 with Mut, Div {
    if x > 700.0 { return 1.0e200 }
    if x < 0.0 - 700.0 { return 0.0 }
    var kf = x / 0.6931471805599453
    var k = kf as i64
    if kf < 0.0 {
        if kf != (k as f64) { k = k - 1 }
    }
    let r = x - (k as f64) * 0.6931471805599453
    var s = 1.0
    var term = 1.0
    var n: i64 = 1
    while n < 25 { term = term * r / (n as f64); s = s + term; n = n + 1 }
    var result = s
    if k >= 0 {
        var i: i64 = 0
        while i < k { result = result * 2.0; i = i + 1 }
    } else {
        var i: i64 = 0
        while i < (0 - k) { result = result / 2.0; i = i + 1 }
    }
    result
}

fn mh_ln(x: f64) -> f64 with Mut, Div {
    var m = x
    var k: i64 = 0
    while m >= 2.0 { m = m / 2.0; k = k + 1 }
    while m < 1.0 { m = m * 2.0; k = k - 1 }
    let y = (m - 1.0) / (m + 1.0)
    let y2 = y * y
    var term = y
    var sum = 0.0
    var i: i64 = 0
    while i < 12 {
        sum = sum + term / (2.0 * (i as f64) + 1.0)
        term = term * y2
        i = i + 1
    }
    2.0 * sum + (k as f64) * 0.6931471805599453
}

// ─── PRNG ───

var RNG_A: i64 = 0
var RNG_B: i64 = 0

fn rng_seed(a: i64, b: i64) with Mut {
    RNG_A = a
    RNG_B = b
}

fn rng_next() -> i64 with Mut {
    var x = RNG_A
    let y = RNG_B
    RNG_A = y
    x = x ^ (x << 23)
    x = x ^ (x >> 17)
    x = x ^ (y ^ (y >> 26))
    RNG_B = x
    let r = x + y
    if r < 0 { 0 - r } else { r }
}

fn rand_uniform() -> f64 with Mut, Div {
    let r = rng_next()
    (r % 10000) as f64 / 10000.0
}

fn rand_normal() -> f64 with Mut, Div {
    var sum = 0.0
    var j = 0
    while j < 12 { sum = sum + rand_uniform(); j = j + 1 }
    sum - 6.0
}

fn rand_gaussian(mu: f64, sigma: f64) -> f64 with Mut, Div {
    mu + sigma * rand_normal()
}

// ─── the chain ───

fn crf(r: f64, n_yr: i64) -> f64 with Mut, Div {
    let q = mh_exp((n_yr as f64) * mh_ln(1.0 + r))
    r * q / (q - 1.0)
}

// production cost [EUR/kg]: electricity + annualized electrolyser CAPEX/O&M
fn prod_cost(elec: f64, cf: f64) -> f64 with Mut, Div {
    let ann = 75000000.0 * crf(0.07, 25) + 1000000.0
    let prod = 50000.0 * cf * 8760.0 / 46.4
    46.4 * elec + ann / prod
}

// compression cost [EUR/kg]: thermal energy x waste-heat price
fn compr_cost(e_th: f64, p_heat: f64) -> f64 {
    e_th * p_heat
}

// storage cost [EUR/kg]: 500 EUR/kg tank, CRF 7%/25y, ncyc cycles/yr.
// His 100 t store against 3729 t/yr gives 37.29; the cycling rate is
// dispatch-dependent, so ncyc is an epistemic INTERVAL [30, 45].
fn storage_cost(ncyc: f64) -> f64 with Mut, Div {
    500.0 * crf(0.07, 25) / ncyc
}

// delivered cost along the whole chain
fn delivered(elec: f64, cf: f64, e_th: f64, p_heat: f64, loss: f64, ncyc: f64) -> f64 with Mut, Div {
    (prod_cost(elec, cf) + compr_cost(e_th, p_heat) + storage_cost(ncyc)) * (1.0 + loss)
}

// P(delivered < 6 EUR/kg) at one epistemic corner, aleatory scatter only
fn prob_below6(elec: f64, cf: f64, e_th: f64, p_heat: f64, loss: f64, ncyc: f64, n: i64) -> f64 with IO, Mut, Div {
    var i: i64 = 0
    var hits: i64 = 0
    var sum = 0.0
    var sumsq = 0.0
    while i < n {
        let e = rand_gaussian(elec, 0.002)
        let c = rand_gaussian(cf, 0.02)
        let t = rand_gaussian(e_th, 5.0)
        let d = delivered(e, c, t, p_heat, loss, ncyc)
        sum = sum + d
        sumsq = sumsq + d * d
        if d < 6.0 { hits = hits + 1 }
        i = i + 1
    }
    let mean = sum / (n as f64)
    print("   mean delivered [EUR/kg]: "); println(mean)
    print("   std  delivered [EUR/kg]: ")
    println(mh_sqrt(sumsq / (n as f64) - mean * mean))
    100.0 * (hits as f64) / (n as f64)
}

// quiet variant for the decomposition table (no per-run prints)
fn prob_quiet(elec: f64, cf: f64, e_th: f64, p_heat: f64, loss: f64, ncyc: f64, n: i64) -> f64 with Mut, Div {
    var i: i64 = 0
    var hits: i64 = 0
    while i < n {
        let e = rand_gaussian(elec, 0.002)
        let c = rand_gaussian(cf, 0.02)
        let t = rand_gaussian(e_th, 5.0)
        let d = delivered(e, c, t, p_heat, loss, ncyc)
        if d < 6.0 { hits = hits + 1 }
        i = i + 1
    }
    100.0 * (hits as f64) / (n as f64)
}

fn main() -> i32 with IO, Mut, Div {
    print("=== Crete H2 chain: production -> compression -> storage ===")
    println("")
    print("    delivered-cost p-box from HIS OWN published numbers")
    println("")
    println("")

    // stage-by-stage epistemic intervals (deterministic corners)
    print("stage 1 production [EUR/kg]:  [")
    print(prod_cost(0.046, 0.44)); print(" , ")
    print(prod_cost(0.052, 0.35)); println(" ]")
    print("stage 2 compression [EUR/kg]: [")
    print(compr_cost(44.0, 0.005)); print(" , ")
    print(compr_cost(89.0, 0.02)); println(" ]")
    print("stage 3 storage [EUR/kg]:     [")
    print(storage_cost(45.0)); print(" , ")
    print(storage_cost(30.0)); println(" ]")
    print("seasonal UHS loss [%/yr]:     [0.3 , 0.6]")
    println("")
    println("")

    let d_lo = delivered(0.046, 0.44, 44.0, 0.005, 0.003, 45.0)
    let d_mid = delivered(0.049, 0.395, 66.5, 0.0125, 0.0045, 37.29)
    let d_hi = delivered(0.052, 0.35, 89.0, 0.02, 0.006, 30.0)
    print("delivered cost interval [EUR/kg]:  [")
    print(d_lo); print(" , "); print(d_hi); println(" ]")
    print("nominal point estimate [EUR/kg]:    ")
    println(d_mid)
    println("")

    // p-box on P(D < 6 EUR/kg): only two corners matter (monotone chain,
    // Lean-checked: SounioHydrogenPbox.monotone_event_equiv)
    print("BEST corner (elec .046, CF .44, 44 kWh_th, heat .005, loss .3%, 45 cycles):")
    println("")
    rng_seed(314159265, 271828182)
    let p_hi = prob_below6(0.046, 0.44, 44.0, 0.005, 0.003, 45.0, 20000)
    print("   P(delivered < 6 EUR/kg) [%]: "); println(p_hi)
    println("")
    print("WORST corner (elec .052, CF .35, 89 kWh_th, heat .02, loss .6%, 30 cycles):")
    println("")
    rng_seed(314159265, 271828182)
    let p_lo = prob_below6(0.052, 0.35, 89.0, 0.02, 0.006, 30.0, 20000)
    print("   P(delivered < 6 EUR/kg) [%]: "); println(p_lo)
    println("")

    let box = new(p_lo, p_hi)
    print("PBOX on beating 6 EUR/kg delivered: [")
    print(box.lo); print(" , "); print(box.hi); println(" ]")
    print("   epistemic width [pp]: "); println(width(box))
    println("")

    // ─── ignorance decomposition: which uncertainty holds the decision? ───
    // One-at-a-time corners around the nominal point. This is a p-box
    // sensitivity analysis: it ranks what to measure or decide FIRST.
    print("ignorance decomposition (P(<6) at one-at-a-time corners) [%]:")
    println("")
    print("   nominal point:            ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.049, 0.395, 66.5, 0.0125, 0.0045, 37.29, 20000))
    print("   electricity .046 / .052:  ")
    rng_seed(314159265, 271828182)
    print(prob_quiet(0.046, 0.395, 66.5, 0.0125, 0.0045, 37.29, 20000))
    print(" / ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.052, 0.395, 66.5, 0.0125, 0.0045, 37.29, 20000))
    print("   capacity factor .44 / .35: ")
    rng_seed(314159265, 271828182)
    print(prob_quiet(0.049, 0.44, 66.5, 0.0125, 0.0045, 37.29, 20000))
    print(" / ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.049, 0.35, 66.5, 0.0125, 0.0045, 37.29, 20000))
    print("   compr. energy 44 / 89:     ")
    rng_seed(314159265, 271828182)
    print(prob_quiet(0.049, 0.395, 44.0, 0.0125, 0.0045, 37.29, 20000))
    print(" / ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.049, 0.395, 89.0, 0.0125, 0.0045, 37.29, 20000))
    print("   heat price .005 / .02:     ")
    rng_seed(314159265, 271828182)
    print(prob_quiet(0.049, 0.395, 66.5, 0.005, 0.0045, 37.29, 20000))
    print(" / ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.049, 0.395, 66.5, 0.02, 0.0045, 37.29, 20000))
    print("   UHS loss .3% / .6%:        ")
    rng_seed(314159265, 271828182)
    print(prob_quiet(0.049, 0.395, 66.5, 0.0125, 0.003, 37.29, 20000))
    print(" / ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.049, 0.395, 66.5, 0.0125, 0.006, 37.29, 20000))
    print("   tank cycling 45 / 30:      ")
    rng_seed(314159265, 271828182)
    print(prob_quiet(0.049, 0.395, 66.5, 0.0125, 0.0045, 45.0, 20000))
    print(" / ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.049, 0.395, 66.5, 0.0125, 0.0045, 30.0, 20000))
    println("")

    // the decisive pair: compression technology x waste-heat price
    print("decisive PAIR (44 kWh_th + heat .005, rest nominal): ")
    rng_seed(314159265, 271828182)
    println(prob_quiet(0.049, 0.395, 44.0, 0.005, 0.0045, 37.29, 20000))
    println("")

    print("The point estimate (~6.3 EUR/kg) says: barely misses 6 EUR/kg.")
    println("")
    print("The chain says the decision is UNDETERMINED — the p-box spans")
    println("")
    print("[0, 100] — and then decomposes WHY: no single variable flips")
    println("")
    print("it, but the compression pair (technology choice 44 vs 89")
    println("")
    print("kWh_th/kg x waste-heat contract) decides the business case")
    println("")
    print("alone. His two compressor papers ARE the two endpoints of the")
    println("")
    print("decisive interval. Propagation machine-checked in Lean 4")
    println("")
    print("(SounioHydrogenPbox.monotone_event_equiv): no independence")
    println("")
    print("assumption anywhere in the chain.")
    println("")
    println("HUB_CHAIN_OK")
    0
}
