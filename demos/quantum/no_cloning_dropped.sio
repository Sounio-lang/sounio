//@ typecheck-fail
//@ error-pattern: linear value not consumed
//@ description: no-deleting: a linear qubit that is never consumed is refused at compile time (Madaros E040)
// A qubit state is a linear value: the type system lets it be used exactly once.
linear struct Qubit { amp: [f64; 2] }

// Measuring consumes the qubit: afterwards only the classical outcome exists.
fn measure_z(q: Qubit) -> i64 {
    let a = q.amp
    if a[0] * a[0] >= a[1] * a[1] { 0 } else { 1 }
}

fn main() -> i32 with IO {
    let q = Qubit { amp: [0.6, 0.8] }
    println("prepared a qubit and never measured it")
    0
}
