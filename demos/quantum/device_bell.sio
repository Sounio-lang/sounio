// The Bell job a machine can run, and the oracle verdict marked as such.
//   bin/souc run demos/quantum/device_bell.sio
// The document is OpenQASM 3 for both bases. The last line is the statevector.

use quantum::qasm_tape::{
    tape_bell,
    tape_bell_x,
    tape_device_job,
    tape_device_oracle,
}

fn main() -> i32 with Mut, Div, Panic, IO {
    let pi = 3.141592653589793
    let job = tape_device_job(tape_bell(), tape_bell_x(pi), 1000)
    print(job.text)
    let ora = tape_device_oracle(tape_bell(), tape_bell_x(pi), 1000, 1)
    if ora.oracle == 1 {
        if ora.pair == 1 {
            print("oracle pair\n")
            return 0
        }
    }
    print("oracle copy\n")
    return 1
}
