module main

use pbpk::rapamycin_cni_protocol::{
    cp_cni_ceil, cp_cnifree_floor, cp_cnifree_ceil,
    cp_cni_margin_n7, cp_cni_margin_n14, cp_cni_margin_n21, cp_cni_margin_n28,
    cp_cni_n_crit, cp_cni_n_last_cert, cp_cni_n_peak, cp_cni_margin_peak, cp_cni_cert_span,
    cp_free_margin_n7, cp_free_margin_n14, cp_free_margin_n28,
    cp_free_n_crit, cp_free_n_last_cert, cp_free_n_peak, cp_free_margin_peak, cp_free_cert_span,
    cp_combined_n_crit, cp_combined_n_last_cert, cp_combined_cert_span,
    cp_cni_span_loss, cp_free_span_loss
}

fn pi(n: i64) with Mut, Div, Panic, IO {
    if n == 0 { print("0") }
    else {
        var digits = [0, 0, 0, 0, 0, 0, 0, 0]
        var num = n; var count = 0
        while num > 0 { digits[count] = num - (num / 10) * 10; num = num / 10; count = count + 1 }
        var idx = count - 1
        while idx >= 0 {
            if digits[idx] == 0 { print("0") } else if digits[idx] == 1 { print("1") }
            else if digits[idx] == 2 { print("2") } else if digits[idx] == 3 { print("3") }
            else if digits[idx] == 4 { print("4") } else if digits[idx] == 5 { print("5") }
            else if digits[idx] == 6 { print("6") } else if digits[idx] == 7 { print("7") }
            else if digits[idx] == 8 { print("8") } else { print("9") };
            idx = idx - 1
        }
    }
}

fn main() with Mut, Div, Panic, IO {
    print("=== Protocol constants ===\n")
    print("cni_ceil:      "); print_f64(cp_cni_ceil());      print("\n")
    print("cnifree_floor: "); print_f64(cp_cnifree_floor()); print("\n")
    print("cnifree_ceil:  "); print_f64(cp_cnifree_ceil());  print("\n")

    print("\n=== CNI protocol margins (floor=0.004, ceil=0.012) ===\n")
    print("margin N=7:  "); print_f64(cp_cni_margin_n7());  print("\n")
    print("margin N=14: "); print_f64(cp_cni_margin_n14()); print("\n")
    print("margin N=21: "); print_f64(cp_cni_margin_n21()); print("\n")
    print("margin N=28: "); print_f64(cp_cni_margin_n28()); print("\n")
    print("n_crit:       "); pi(cp_cni_n_crit());      print("\n")
    print("n_last_cert:  "); pi(cp_cni_n_last_cert()); print("\n")
    print("n_peak:       "); pi(cp_cni_n_peak());      print("\n")
    print("margin_peak:  "); print_f64(cp_cni_margin_peak()); print("\n")
    print("cert_span:    "); pi(cp_cni_cert_span());   print("\n")

    print("\n=== CNI-free protocol margins (floor=0.012, ceil=0.020) ===\n")
    print("margin N=7:  "); print_f64(cp_free_margin_n7());  print("\n")
    print("margin N=14: "); print_f64(cp_free_margin_n14()); print("\n")
    print("margin N=28: "); print_f64(cp_free_margin_n28()); print("\n")
    print("n_crit:       "); pi(cp_free_n_crit());      print("\n")
    print("n_last_cert:  "); pi(cp_free_n_last_cert()); print("\n")
    print("n_peak:       "); pi(cp_free_n_peak());      print("\n")
    print("margin_peak:  "); print_f64(cp_free_margin_peak()); print("\n")
    print("cert_span:    "); pi(cp_free_cert_span());   print("\n")

    print("\n=== Combined reference (from Sprint 57) ===\n")
    print("combined n_crit:      "); pi(cp_combined_n_crit());      print("\n")
    print("combined n_last_cert: "); pi(cp_combined_n_last_cert()); print("\n")
    print("combined cert_span:   "); pi(cp_combined_cert_span());   print("\n")

    print("\n=== Span losses vs combined ===\n")
    print("cni_span_loss:  "); pi(cp_cni_span_loss());  print("\n")
    print("free_span_loss: "); pi(cp_free_span_loss()); print("\n")
}
