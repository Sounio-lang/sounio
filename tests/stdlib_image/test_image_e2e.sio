//@ run-pass
// E2E tests for stdlib/image

use image::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0
    var img = image_new(4, 4)

    print("Test 01: image_new... ")
    if image_width(&img) == 4 && image_height(&img) == 4 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: image_set_pixel and image_get_pixel... ")
    image_set_pixel(&! img, 0, 0, 255)
    image_set_pixel(&! img, 1, 1, 128)
    let p1 = image_get_pixel(&img, 0, 0)
    let p2 = image_get_pixel(&img, 1, 1)
    if p1 == 255 && p2 == 128 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (p1=")
        print(p1)
        print(", p2=")
        print(p2)
        print(")\n")
        fail = fail + 1
    }

    print("Test 03: pixel out of bounds returns 0... ")
    let p3 = image_get_pixel(&img, 10, 10)
    if p3 == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: fill image with single color... ")
    var x = 0
    while x < 4 {
        var y = 0
        while y < 4 {
            image_set_pixel(&! img, x, y, 42)
            y = y + 1
        }
        x = x + 1
    }
    let p4 = image_get_pixel(&img, 3, 3)
    if p4 == 42 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: image_get_pixel unchanged pixel... ")
    let p5 = image_get_pixel(&img, 0, 0)
    if p5 == 42 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_image: ALL PASS (")
        print(pass)
        print("/5)\n")
        0
    } else {
        print("stdlib_image: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}