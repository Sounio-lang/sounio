struct Frac { n: i64, d: i64 }

trait ExactRing {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic
}

impl ExactRing for Frac {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic {
        Frac { n: self.n + o.n, d: self.d }
    }
}

fn add_er<F: ExactRing>(a: F, b: F) -> F with Mut, Div, Panic {
    a.er_add(b)
}

fn main() -> i32 with Mut, Div, Panic {
    let s = add_er::<Frac>(1, 1)
    if s.n == 2 { 0 } else { 1 }
}
