use math::rational::{Rational, rat_add, rat_one}

trait ExactRing {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic
}

impl ExactRing for Rational {
    fn er_add(self, o: Self) -> Self with Mut, Div, Panic { rat_add(self, o) }
}

fn add_er<F: ExactRing>(a: F, b: F) -> F with Mut, Div, Panic {
    a.er_add(b)
}

fn main() -> i32 with Mut, Div, Panic {
    let s = add_er::<Rational>(1, 1)
    if s.num == 2 { 0 } else { 1 }
}
