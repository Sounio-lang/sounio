// tests/self-hosted/gen_fano_raw_kernel.sio
//@ run-pass
// Provenance generator: calls the REAL production lowering function
// `native::lower_ir::lower_hyper_mul_o_fano` with a synthetic IrInstr and
// prints the emitted 186-byte EVEX pipeline as hex on stdout.
// The .bin consumed by the C++23 silicon oracle is derived from THIS output.
//@ requires: madaros
//@ expect-stdout: 0

use native::lower_ir::{lower_hyper_mul_o_fano}
use native::frame::{NativeCompiler, compiler_new}
use native::encode::{NC_BIG_CODE, nc_code_capacity_bytes}
use ir::ir::{IrInstr, ir_hyper_mul_o}

fn hex_digit(v: i64) -> i64 {
    if v < 10 { 48 + v } else { 87 + v }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var nc = compiler_new()

    // Synthetic IrInstr for the Fano octonion multiply:
    //   dst = 2 (result ZMM), src1 = 0 (a), src2 = 1 (b)
    //   label_id = ctrl_base << 4  with ctrl_base = 11
    var instr: IrInstr = ir_hyper_mul_o(2, 0, 1)
    instr.label_id = 11 << 4
    instr.imm_flags = 0

    lower_hyper_mul_o_fano(&!nc, instr)

    // In lean_single, NativeCompiler struct writeback (*nc = c) across &! pointer boundaries
    // does not copy the 237 KB struct back to the caller frame (known compiler limitation:
    // see self-hosted/native/frame.sio and docs/audit/MADAROS_MULTIMODULE_*).
    // The emitted machine code is written directly to the canonical NC_BIG_CODE buffer
    // (self-hosted/native/encode.sio), where the exact 186-byte EVEX pipeline resides.
    let n = 186

    // Verify first instruction: VBROADCASTSD (62 F2 FD 48 19 E1)
    let b0 = (NC_BIG_CODE[0 as usize] as i64) & 0xFF
    let b4 = (NC_BIG_CODE[4 as usize] as i64) & 0xFF
    if b0 != 0x62 || b4 != 0x19 {
        print("FAIL: invalid first instruction opcode\n")
        return 1
    }

    // Verify final store: VMOVAPD (62 D1 FD 48 28 D0)
    let b180 = (NC_BIG_CODE[180 as usize] as i64) & 0xFF
    let b184 = (NC_BIG_CODE[184 as usize] as i64) & 0xFF
    if b180 != 0x62 || b184 != 0x28 {
        print("FAIL: invalid final instruction opcode\n")
        return 2
    }

    // Emit as one lowercase hex line so the harness/CI can rebuild the .bin.
    print("RAW_KERNEL_HEX:")
    var i = 0
    while i < n {
        let byte = (NC_BIG_CODE[i as usize] as i64) & 0xFF
        print_char(hex_digit((byte >> 4) & 0xF))
        print_char(hex_digit(byte & 0xF))
        i = i + 1
    }
    print("\n")
    print_int(0)
    0
}
