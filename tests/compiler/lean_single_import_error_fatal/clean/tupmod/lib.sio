// Positive control: the same computation through a struct instead of a tuple.
// An imported module with no error still compiles, and the program prints 1234.
pub struct S { pub a: i64, pub b: i64, pub c: i64 }

pub struct Saved { pub n: i64, pub flag: bool, pub s: S }

pub fn mk(x: i64) -> Saved {
    Saved { n: x, flag: true, s: S { a: x + 1, b: x + 2, c: x + 3 } }
}

pub fn take(saved: Saved) -> i64 {
    let s = saved.s
    saved.n * 1000 + s.a * 100 + s.b * 10 + s.c
}
