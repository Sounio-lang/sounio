// A by-value 3-tuple holding a struct, read back with `.2`. The lean_single
// seed refuses `saved.2` ("tuple index out of bounds"); before the error was
// fatal in an imported module, it exited 0 and the ELF printed garbage
// (1548023700998412) instead of 1234.
pub struct S { pub a: i64, pub b: i64, pub c: i64 }

pub fn mk(x: i64) -> (i64, bool, S) {
    (x, true, S { a: x + 1, b: x + 2, c: x + 3 })
}

pub fn take(saved: (i64, bool, S)) -> i64 {
    let s = saved.2
    saved.0 * 1000 + s.a * 100 + s.b * 10 + s.c
}
