use coordination::loom_witness_epoch_handoff::{
    LoomWitnessEpochHandoffHostTrust,
    WitnessEpochDigest256,
    admit_witness_epoch_digest256,
    host_witness_epoch_handoff_frame_accepts,
    admit_verified_old_epoch_quorum,
    admit_verified_new_epoch_quorum,
    join_verified_witness_epoch_quorums,
    consume_verified_witness_epoch_handoff,
    close_host_witness_epoch_handoff_receipt,
}

fn digest(seed: i64) -> WitnessEpochDigest256 {
    admit_witness_epoch_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> WitnessEpochDigest256 {
    admit_witness_epoch_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn linear_handoff_case() -> bool with LoomWitnessEpochHandoffHostTrust, Panic {
    let old_quorum = admit_verified_old_epoch_quorum(
        1, 1, 3, 4,
        digest(10), digest(20), 501, 7, 12, digest(30), digest(40),
    )
    let new_quorum = admit_verified_new_epoch_quorum(
        2, 1, 3, 4,
        digest(50), digest(60), 501, 1, 12, digest(30), digest(70),
    )
    let handoff = join_verified_witness_epoch_quorums(
        old_quorum, new_quorum, 1, 2, zero_digest(),
    )
    let receipt = consume_verified_witness_epoch_handoff(handoff)
    close_host_witness_epoch_handoff_receipt(receipt) == 12
}

fn main() -> i64 with IO, LoomWitnessEpochHandoffHostTrust, Panic {
    let accepted = host_witness_epoch_handoff_frame_accepts(
        1, 1, 1, 2, 3, 3, 4, 4,
        501, 501, 7, 1, 12, 12,
        digest(10), digest(20), digest(30), digest(40),
        digest(50), digest(50), digest(60), digest(70), zero_digest(),
    )
    let missing_predecessor_refused = !host_witness_epoch_handoff_frame_accepts(
        1, 1, 2, 3, 3, 3, 4, 4,
        501, 501, 7, 1, 12, 12,
        digest(10), digest(20), digest(30), digest(40),
        digest(50), digest(50), digest(60), digest(70), zero_digest(),
    )
    if !accepted || !missing_predecessor_refused || !linear_handoff_case() {
        return 1
    }
    println("loom-witness-epoch-handoff-typestate: PASS linear=1 old_quorum=1 new_quorum=1 handoff=1 host_receipt=1")
    0
}
