use coordination::loom_portfolio_attention::{
    LoomPortfolioHostTrust,
    PortfolioDigest256,
    admit_portfolio_digest256,
    host_portfolio_frame_accepts,
    acquire_portfolio_budget,
    compile_attention_portfolio,
    complete_attention_portfolio,
    close_portfolio_budget,
    close_completed_attention_portfolio,
}

fn digest(seed: i64) -> PortfolioDigest256 {
    admit_portfolio_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> PortfolioDigest256 {
    admit_portfolio_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn typestate_case() -> bool with Panic {
    let budget = acquire_portfolio_budget(100, 100, 10, 10)
    let compiled = compile_attention_portfolio(
        budget, 101, 201, 301, 401, 40, 30, 5, 4,
        digest(10), digest(20),
    )
    let (remaining, portfolio) = compiled
    let completed = complete_attention_portfolio(portfolio, digest(30))
    close_portfolio_budget(remaining) == 141 &&
    close_completed_attention_portfolio(completed) == 302
}

fn main() -> i64 with IO, LoomPortfolioHostTrust, Panic {
    let accepted = host_portfolio_frame_accepts(
        1, 1, 100, 100, 10, 10, 101, 201, 202, 301, 401,
        900, 500, 400, 40, 50, 50, 5, 5,
        800, 900, 900, 50, 50, 50, 5, 5,
        digest(10), digest(20), digest(30), digest(40), digest(50),
        zero_digest(),
    )
    let dominated_refused = !host_portfolio_frame_accepts(
        1, 1, 100, 100, 10, 10, 101, 201, 202, 301, 401,
        100, 900, 900, 40, 50, 50, 5, 5,
        900, 100, 100, 40, 50, 50, 5, 5,
        digest(10), digest(20), digest(30), digest(40), digest(50),
        zero_digest(),
    )
    if !accepted || !dominated_refused || !typestate_case() { return 1 }
    println("loom-portfolio-typestate: PASS budgets=4 linear=1 portfolio=compiled completion=typed comparator=bounded")
    0
}
