module decimal_literal_rounding_v1_parser_probe

use lexer::cursor::{CURSOR_SOURCE}
use parser::parser::{parser_parse_float_token}

fn main() -> i32 with IO, Mut, Panic, Div {
    if arg_count() != 1 {
        panic("decimal literal parser probe expects one decimal string")
    }
    let raw = get_arg(0)
    let len = str_len(raw)
    if len <= 0 || len > 1024 {
        panic("decimal literal parser probe input length")
    }

    var i: i64 = 0
    while i < len {
        CURSOR_SOURCE[i as usize] = str_char_at(raw, i) as i8
        i = i + 1
    }

    let value = parser_parse_float_token(0, len)
    print(raw)
    print(" ")
    print_int(f64_to_bits(value))
    print("\n")
    0
}
