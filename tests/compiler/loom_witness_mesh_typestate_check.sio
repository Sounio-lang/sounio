use coordination::loom_witness_mesh::{
    LoomWitnessMeshHostTrust,
    WitnessMeshDigest256,
    admit_witness_mesh_digest256,
    host_witness_mesh_frame_accepts,
    admit_verified_witness_share,
    combine_verified_witness_shares,
    consume_verified_witness_mesh_checkpoint,
    close_host_witness_mesh_receipt,
}

fn digest(seed: i64) -> WitnessMeshDigest256 {
    admit_witness_mesh_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> WitnessMeshDigest256 {
    admit_witness_mesh_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn linear_quorum_case() -> bool with LoomWitnessMeshHostTrust, Panic {
    let first = admit_verified_witness_share(101, 401, 1, 3, digest(20))
    let second = admit_verified_witness_share(201, 401, 1, 3, digest(20))
    let checkpoint = combine_verified_witness_shares(first, second)
    let receipt = consume_verified_witness_mesh_checkpoint(checkpoint)
    close_host_witness_mesh_receipt(receipt) == 405
}

fn main() -> i64 with IO, LoomWitnessMeshHostTrust, Panic {
    let accepted = host_witness_mesh_frame_accepts(
        2, 1, 1, 0,
        101, 201, 301,
        101, 201, 0,
        401, 401, 401, 0,
        0, 1, 1, 1, 0,
        0, 3, 3, 3, 0,
        digest(10), digest(10), digest(10), zero_digest(),
        digest(20), digest(20), digest(20), zero_digest(),
    )
    let one_share_refused = !host_witness_mesh_frame_accepts(
        2, 1, 0, 0,
        101, 201, 301,
        101, 0, 0,
        401, 401, 0, 0,
        0, 1, 1, 0, 0,
        0, 3, 3, 0, 0,
        digest(10), digest(10), zero_digest(), zero_digest(),
        digest(20), digest(20), zero_digest(), zero_digest(),
    )
    if !accepted || !one_share_refused || !linear_quorum_case() {
        return 1
    }
    println("loom-witness-mesh-typestate: PASS linear=1 shares=2 checkpoint=1 host_receipt=1 quorum=2/3")
    0
}
