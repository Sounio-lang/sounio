use mod::{half}

// Regression fixture for the visibility-preflight builtin allow-list.
// Before the fix, any 2+-module program that called one of these builtins
// tripped E137 ("use of undeclared variable") in the visibility preflight
// pass even though the codegen lane resolves them correctly. The wildcard
// import `use mod::*` was a workaround; the named import + builtin combo
// was the failing shape. See
// docs/audit/MADAROS_MULTIMODULE_PRINT_IMPORT_BUGS_2026-07-13.md defect 2
// for the original report on print_f64.

fn main() -> i64 with IO {
    // Exercise every builtin that was missing from the allow-list.
    print_f64(half())         // expected: "0.500000"
    print_char(10)            // newline
    print_f64(sqrt(half()))   // expected: "0.707107"
    print_char(10)
    print_f64(exp(half()))    // expected: "1.648721"
    print_char(10)
    print_f64(log(half()))    // expected: "-0.693147"
    print_char(10)
    print_f64(sin(half()))    // expected: "0.479426"
    print_char(10)
    print_f64(cos(half()))    // expected: "0.877583"
    print_char(10)
    assert(half() > 0.0)
    0
}
