ontology RebracketingSemantics {
    class CompilerSemanticObligation
    class ExactBitwiseRebracketObligation subclass_of CompilerSemanticObligation
}

fn require_compiler_semantic_obligation(obligation: CompilerSemanticObligation) -> i64 {
    0
}

fn ontology_subsumption_witness(obligation: ExactBitwiseRebracketObligation) -> i64 {
    require_compiler_semantic_obligation(obligation)
}

pub fn authority_apply_cross_block(
    x: i64,
    choose_left: bool,
    obligation: ExactBitwiseRebracketObligation,
) -> i64 {
    // The typed parameter requests evidence; it never grants rewrite authority.
    let inner = x & 255
    let branch_value = if choose_left { 3 } else { 7 }
    let branch_zero = branch_value ^ branch_value
    (inner & 15) | branch_zero
}

fn main() -> i64 {
    let obligation: ExactBitwiseRebracketObligation = 0 as ExactBitwiseRebracketObligation
    let observed = authority_apply_cross_block(171, true, obligation)
    // The result is range-limited by & 15, so zero is exact equality.
    observed ^ 11
}
