// Imported form of the synthetic ordered-path compiler witness.
ontology ImportedOrderedPathProvenance {
    class OrderedPathStep
    class StepA subclass_of OrderedPathStep
    class StepB subclass_of OrderedPathStep
    class StepC subclass_of OrderedPathStep
    class PathOrderReceipt
    class OrderABReceipt subclass_of PathOrderReceipt
    class OrderBAReceipt subclass_of PathOrderReceipt
    class ReceptorOccupancyObservation
    class FunctionalState
    class StateAfterAB subclass_of FunctionalState
    class StateAfterBA subclass_of FunctionalState
    class LeftGroupedABCState subclass_of FunctionalState
    class RightGroupedABCState subclass_of FunctionalState
    class GroupingReceipt
    class LeftGrouping subclass_of GroupingReceipt
    class RightGrouping subclass_of GroupingReceipt
}

fn state_after_ab(input: i64, occupancy: ReceptorOccupancyObservation, a: StepA, b: StepB, order: OrderABReceipt) -> StateAfterAB {
    (input | (occupancy as i64) | (a as i64) | (b as i64) | (order as i64)) as StateAfterAB
}
fn state_after_ba(input: i64, occupancy: ReceptorOccupancyObservation, b: StepB, a: StepA, order: OrderBAReceipt) -> StateAfterBA {
    (input | (occupancy as i64) | (b as i64) | (a as i64) | (order as i64)) as StateAfterBA
}
fn project_ab(state: StateAfterAB, input: i64, occupancy: i64) -> i64 { (state as i64) | input | occupancy }
fn project_ba(state: StateAfterBA, input: i64, occupancy: i64) -> i64 { (state as i64) | input | occupancy }
// Each typed continuation applies base context 7; right grouping adds mask 8.
fn continue_ab(state: StateAfterAB) -> i64 { (state as i64) ^ 7 }
fn continue_ba(state: StateAfterBA) -> i64 { (state as i64) | 7 }

fn left_grouped_abc(input: i64, occupancy: ReceptorOccupancyObservation, a: StepA, b: StepB, c: StepC, grouping: LeftGrouping) -> LeftGroupedABCState {
    (input | (occupancy as i64) | (a as i64) | (b as i64) | (c as i64) | (grouping as i64)) as LeftGroupedABCState
}
fn right_grouped_abc(input: i64, occupancy: ReceptorOccupancyObservation, a: StepA, b: StepB, c: StepC, grouping: RightGrouping) -> RightGroupedABCState {
    (input | (occupancy as i64) | (a as i64) | (b as i64) | (c as i64) | (grouping as i64)) as RightGroupedABCState
}
fn project_left(state: LeftGroupedABCState, input: i64, occupancy: i64) -> i64 { (state as i64) | input | occupancy }
fn project_right(state: RightGroupedABCState, input: i64, occupancy: i64) -> i64 { (state as i64) | input | occupancy }
fn continue_left(state: LeftGroupedABCState) -> i64 { (state as i64) & 7 }
fn continue_right(state: RightGroupedABCState) -> i64 { (state as i64) ^ 15 }

pub fn imported_ordered_path_run() -> i64 with IO {
    let input: i64 = 333
    let occupancy: ReceptorOccupancyObservation = 800 as ReceptorOccupancyObservation
    let a: StepA = 1 as StepA
    let b: StepB = 1 as StepB
    let c: StepC = 1 as StepC
    let ab = state_after_ab(input, occupancy, a, b, 1 as OrderABReceipt)
    let ba = state_after_ba(input, occupancy, b, a, 1 as OrderBAReceipt)
    let left = left_grouped_abc(input, occupancy, a, b, c, 1 as LeftGrouping)
    let right = right_grouped_abc(input, occupancy, a, b, c, 1 as RightGrouping)
    let immediate_ab = project_ab(ab, input, occupancy as i64)
    let immediate_ba = project_ba(ba, input, occupancy as i64)
    let immediate_left = project_left(left, input, occupancy as i64)
    let immediate_right = project_right(right, input, occupancy as i64)
    let later_ab = continue_ab(ab)
    let later_ba = continue_ba(ba)
    let later_left = continue_left(left)
    let later_right = continue_right(right)
    // Branchless exact certificate: zero iff every observed word is expected.
    let mismatch =
        (immediate_ab ^ 877) |
        (immediate_ba ^ 877) |
        (immediate_left ^ 877) |
        (immediate_right ^ 877) |
        (later_ab ^ 874) |
        (later_ba ^ 879) |
        (later_left ^ 5) |
        (later_right ^ 866)
    print("ORDERED_PATH_OK occupancy=")
    print_int(occupancy as i64)
    print(" input=")
    print_int(input)
    print(" immediate=")
    print_int(immediate_ab)
    print(" later_ab=")
    print_int(later_ab)
    print(" later_ba=")
    print_int(later_ba)
    print(" later_left=")
    print_int(later_left)
    print(" later_right=")
    print_int(later_right)
    print("\n")
    mismatch
}
