struct HiddenInner {
    scalar: i64,
    values: [i64; 2],
}

pub struct PublicOuterPrivateSecond {
    pub inner: HiddenInner,
}

pub fn make_private_second() -> PublicOuterPrivateSecond {
    let inner: HiddenInner = HiddenInner {
        scalar: 0,
        values: [0, 0],
    }
    PublicOuterPrivateSecond { inner: inner }
}

pub struct PublicInner {
    pub scalar: i64,
    pub values: [i64; 2],
}

struct HiddenOuter {
    pub inner: PublicInner,
}

pub fn make_private_first() -> HiddenOuter {
    let inner: PublicInner = PublicInner {
        scalar: 0,
        values: [0, 0],
    }
    HiddenOuter { inner: inner }
}
