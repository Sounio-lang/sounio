struct OcpSealedExactBitwiseRebracketAuthority {
    occurrence_token: i64,
}

fn ocp_issue_exact_bitwise_rebracket_authority(
    occurrence_token: i64,
) -> OcpSealedExactBitwiseRebracketAuthority {
    OcpSealedExactBitwiseRebracketAuthority { occurrence_token: occurrence_token }
}

pub fn authority_leaf_internal_probe() -> bool {
    let authority = ocp_issue_exact_bitwise_rebracket_authority(255)
    authority.occurrence_token == 255
}
