    if neg_zero >= 0 { return 12 }
    if (neg_zero & 9223372036854775807) != 0 { return 13 }

    if f64_to_bits(1.0) != 4607182418800017408 { return 14 }
    if f64_to_bits(0.0 - 1.0) != -4616189618054758400 { return 15 }

