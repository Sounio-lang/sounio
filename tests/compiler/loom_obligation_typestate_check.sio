use coordination::loom_obligation::{
    LoomObligationHostTrust,
    ObligationDigest256,
    admit_obligation_digest256,
    open_obligation_host_bridge,
    admit_host_obligation_transition,
    close_obligation_host_bridge,
    import_durable_obligation,
    consume_durable_obligation,
    claim_consumed_obligation,
    interrupt_consumed_obligation,
    renew_work_claim,
    interrupt_work_claim,
    recover_interrupted_obligation,
    claim_recoverable_obligation,
    complete_work_claim,
    completed_obligation_token,
    host_obligation_transition_accepts,
}

fn consumed_recovery_case() -> bool with LoomObligationHostTrust, Panic {
    let message = digest(11)
    let seal = open_obligation_host_bridge(102, message)
    let pair = admit_host_obligation_transition(
        seal, 1, 0, 1, 102, 0, 0, 0, 0,
        message, zero_digest(), zero_digest(),
    )
    let (next_seal, receipt) = pair
    close_obligation_host_bridge(next_seal)
    match import_durable_obligation(receipt) {
        Some(durable) => match consume_durable_obligation(durable, 211, 311, 410) {
            Some(consumed) => {
                let interrupted = interrupt_consumed_obligation(consumed)
                match recover_interrupted_obligation(interrupted, 212, 312) {
                    Some(recoverable) => match claim_recoverable_obligation(
                        recoverable, 412, 510,
                    ) {
                        Some(claim) => match complete_work_claim(
                            claim, digest(31), digest(41),
                        ) {
                            Some(completed) =>
                                completed_obligation_token(completed) == 102,
                            None => false,
                        },
                        None => false,
                    },
                    None => false,
                }
            },
            None => false,
        },
        None => false,
    }
}

fn digest(seed: i64) -> ObligationDigest256 {
    admit_obligation_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> ObligationDigest256 {
    admit_obligation_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn linear_recovery_case() -> bool with LoomObligationHostTrust, Panic {
    let message = digest(10)
    let seal = open_obligation_host_bridge(101, message)
    let pair = admit_host_obligation_transition(
        seal, 1, 0, 1, 101, 0, 0, 0, 0,
        message, zero_digest(), zero_digest(),
    )
    let (next_seal, receipt) = pair
    close_obligation_host_bridge(next_seal)
    match import_durable_obligation(receipt) {
        Some(durable) => match consume_durable_obligation(durable, 201, 301, 400) {
            Some(consumed) => match claim_consumed_obligation(consumed, 401, 500) {
                Some(claim) => match renew_work_claim(claim, 600) {
                    Some(renewed) => {
                        let interrupted = interrupt_work_claim(renewed)
                        match recover_interrupted_obligation(interrupted, 202, 302) {
                            Some(recoverable) => match claim_recoverable_obligation(
                                recoverable, 402, 700,
                            ) {
                                Some(recovered_claim) => match complete_work_claim(
                                    recovered_claim, digest(30), digest(40),
                                ) {
                                    Some(completed) =>
                                        completed_obligation_token(completed) == 101,
                                    None => false,
                                },
                                None => false,
                            },
                            None => false,
                        }
                    },
                    None => false,
                },
                None => false,
            },
            None => false,
        },
        None => false,
    }
}

fn main() -> i64 with IO, LoomObligationHostTrust, Panic {
    let open_accepts = host_obligation_transition_accepts(
        1, 0, 1, 101, 0, 0, 0, 0,
        digest(10), zero_digest(), zero_digest(),
    )
    let completion_accepts = host_obligation_transition_accepts(
        7, 3, 6, 101, 201, 301, 401, 500,
        digest(10), digest(30), digest(40),
    )
    let evidence_less_refuses = !host_obligation_transition_accepts(
        7, 3, 6, 101, 201, 301, 401, 500,
        digest(10), digest(30), zero_digest(),
    )
    let consumed_interrupt_wrong_next_refuses = !host_obligation_transition_accepts(
        5, 2, 6, 101, 201, 301, 0, 400,
        digest(10), zero_digest(), zero_digest(),
    )
    let claimed_interrupt_wrong_next_refuses = !host_obligation_transition_accepts(
        5, 3, 6, 101, 201, 301, 401, 500,
        digest(10), zero_digest(), zero_digest(),
    )
    let linear_recovery = linear_recovery_case()
    let consumed_recovery = consumed_recovery_case()
    if !open_accepts || !completion_accepts || !evidence_less_refuses ||
        !consumed_interrupt_wrong_next_refuses ||
        !claimed_interrupt_wrong_next_refuses || !linear_recovery ||
        !consumed_recovery {
        return 1
    }
    println("loom-obligation-typestate: PASS host_seal=private linear=1 recovery=1 exclusive_claim=1 evidence_bound=1 zero_evidence=refused")
    0
}
