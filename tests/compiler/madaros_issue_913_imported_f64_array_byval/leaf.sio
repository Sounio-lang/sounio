fn nested_array_score(values: [f64; 100], n: i64) -> (f64, f64) with Mut {
    var i: i64 = 0
    var score: f64 = 0.0
    var square_score: f64 = 0.0
    while i < n {
        let value = values[i as usize]
        score = score + value
        square_score = square_score + value * value
        i = i + 1
    }
    (score, square_score)
}

pub struct ImportedArrayScore {
    pub values: [f64; 10],
}

pub fn imported_array_score(x: [f64; 100], y: [f64; 100], n: i64) -> ImportedArrayScore with Mut {
    var values: [f64; 10] = [0.0; 10]
    let (x_score, x_square_score) = nested_array_score(x, n)
    let (y_score, y_square_score) = nested_array_score(y, n)
    values[1] = x_score + y_score * 1000.0
    ImportedArrayScore { values: values }
}

pub fn imported_array_score_ref(x: &[f64; 100], y: &[f64; 100], n: i64) -> f64 with Mut {
    var i: i64 = 0
    var x_score: f64 = 0.0
    var y_score: f64 = 0.0
    while i < n {
        x_score = x_score + (*x)[i as usize]
        y_score = y_score + (*y)[i as usize]
        i = i + 1
    }
    x_score + y_score * 1000.0
}
