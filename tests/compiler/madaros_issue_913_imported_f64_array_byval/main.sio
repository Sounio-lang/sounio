use leaf::*

fn local_array_score(x: [f64; 100], y: [f64; 100], n: i64) -> f64 with Mut {
    var i: i64 = 0
    var x_score: f64 = 0.0
    var y_score: f64 = 0.0
    while i < n {
        x_score = x_score + x[i as usize]
        y_score = y_score + y[i as usize]
        i = i + 1
    }
    x_score + y_score * 1000.0
}

fn main() -> i64 with IO, Mut {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    x[0] = 1.0
    x[1] = 2.0
    x[2] = 3.0
    x[3] = 4.0
    y[0] = 5.0
    y[1] = 6.0
    y[2] = 7.0
    y[3] = 8.0

    let imported = imported_array_score(x, y, 4)
    print("imported_by_value=")
    print_f64(imported.values[1])
    print_char(10)

    print("local_by_value=")
    print_f64(local_array_score(x, y, 4))
    print_char(10)

    print("imported_by_reference=")
    print_f64(imported_array_score_ref(&x, &y, 4))
    print_char(10)

    0
}
