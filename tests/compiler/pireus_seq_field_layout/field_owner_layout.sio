// Native regression: same-named fields in different struct layouts must
// not affect projection through a Seq<T> field, reference, or nested owner.
struct Decoy { pad: i64, id: i64 }
struct Item { id: i64, other: i64 }
struct Rows { entries: Seq<Item> }
struct Outer { rows: Rows }
fn ref_id(rows: &Rows) -> i64 with Epistemic { rows.entries[0].id }
fn value_id(rows: Rows) -> i64 with Epistemic { rows.entries[0].id }
fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let decoy = Decoy { pad: 90, id: 91 }
    var flat: Seq<Item> = seq_new()
    flat.push(Item { id: 7, other: 43 })
    var rows = Rows { entries: seq_new() }
    rows.entries.push(Item { id: 7, other: 43 })
    let outer = Outer { rows: rows }
    if decoy.id != 91 { return 1 }
    if flat[0].id != 7 { return 2 }
    if rows.entries[0].id != 7 { return 3 }
    if rows.entries[0].other != 43 { return 4 }
    if ref_id(&rows) != 7 { return 5 }
    if value_id(rows) != 7 { return 6 }
    if outer.rows.entries[0].id != 7 { return 7 }
    print("PIREUS_SEQ_FIELD_OWNER_LAYOUT_PASS\n")
    0
}
