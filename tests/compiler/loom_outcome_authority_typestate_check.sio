use coordination::loom_outcome_authority::{
    LoomOutcomeAuthorityHostTrust,
    OutcomeAuthorityDigest256,
    admit_outcome_authority_digest256,
    host_outcome_authority_frame_accepts,
    admit_verified_measurement_receipt,
    classify_verified_measurement,
    consume_verified_outcome,
    close_host_outcome_authority_receipt,
}

fn digest(seed: i64) -> OutcomeAuthorityDigest256 {
    admit_outcome_authority_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn linear_authority_case() -> bool with LoomOutcomeAuthorityHostTrust, Panic {
    let measurement = admit_verified_measurement_receipt(
        101, 201, 301, 401, 701, 750, 1201, digest(20),
    )
    let evidence = classify_verified_measurement(measurement, 501, digest(50))
    let receipt = consume_verified_outcome(evidence)
    close_host_outcome_authority_receipt(receipt) == 2956
}

fn main() -> i64 with IO, LoomOutcomeAuthorityHostTrust, Panic {
    let accepted = host_outcome_authority_frame_accepts(
        1, 1,
        101, 201, 301, 401, 501, 601, 701, 750,
        801, 901, 1001, 1101,
        101, 201, 301, 401, 701, 750, 1201,
        101, 201, 301, 401, 501, 701, 750, 1201,
        digest(10), digest(20), digest(20),
        digest(30), digest(30), digest(40), digest(40), digest(50),
    )
    let collapsed_refused = !host_outcome_authority_frame_accepts(
        1, 1,
        101, 201, 301, 401, 501, 601, 701, 750,
        801, 801, 1001, 1101,
        101, 201, 301, 401, 701, 750, 1201,
        101, 201, 301, 401, 501, 701, 750, 1201,
        digest(10), digest(20), digest(20),
        digest(30), digest(30), digest(40), digest(40), digest(50),
    )
    if !accepted || !collapsed_refused || !linear_authority_case() {
        return 1
    }
    println("loom-outcome-authority-typestate: PASS linear=1 receipts=measurement+classification+host roles=pairwise head=bound")
    0
}
