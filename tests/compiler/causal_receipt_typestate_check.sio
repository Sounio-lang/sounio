//@ check-pass

use coordination::causal_receipt::{
    falsified_experiment_token,
    inconclusive_experiment_token,
    observe_experiment,
    preregister_experiment,
    promote_supported,
    retain_falsified,
    retain_inconclusive,
    support_observation,
    supported_prereg_digest,
    supported_subject_commit,
}

fn supported_case() -> bool {
    let prereg = match preregister_experiment(101, 201, 301) {
        Some(value) => value,
        None => { return false },
    }
    let observed = match observe_experiment(
        prereg, 302, true, 401, 501, true, 402, 502, true,
    ) {
        Some(value) => value,
        None => { return false },
    }
    match support_observation(observed) {
        Some(value) => {
            promote_supported(value) == 101 &&
            supported_subject_commit(value) == 302 &&
            supported_prereg_digest(value) == 201
        },
        None => false,
    }
}

fn failed_control_refuses_promotion() -> bool {
    let prereg = match preregister_experiment(102, 202, 303) {
        Some(value) => value,
        None => { return false },
    }
    let observed = match observe_experiment(
        prereg, 304, true, 403, 503, true, 404, 504, false,
    ) {
        Some(value) => value,
        None => { return false },
    }
    match support_observation(observed) {
        Some(value) => false,
        None => true,
    }
}

fn falsified_is_retained() -> bool {
    let prereg = match preregister_experiment(103, 203, 305) {
        Some(value) => value,
        None => { return false },
    }
    let observed = match observe_experiment(
        prereg, 306, true, 405, 505, false, 406, 506, true,
    ) {
        Some(value) => value,
        None => { return false },
    }
    match retain_falsified(observed) {
        Some(value) => falsified_experiment_token(value) == 103,
        None => false,
    }
}

fn inconclusive_is_retained() -> bool {
    let prereg = match preregister_experiment(104, 204, 307) {
        Some(value) => value,
        None => { return false },
    }
    let observed = match observe_experiment(
        prereg, 308, true, 407, 507, false, 408, 508, false,
    ) {
        Some(value) => value,
        None => { return false },
    }
    match retain_inconclusive(observed) {
        Some(value) => inconclusive_experiment_token(value) == 104,
        None => false,
    }
}

fn same_artifact_is_refused() -> bool {
    let prereg = match preregister_experiment(105, 205, 309) {
        Some(value) => value,
        None => { return false },
    }
    match observe_experiment(
        prereg, 310, true, 409, 509, true, 409, 510, true,
    ) {
        Some(value) => false,
        None => true,
    }
}

fn posthoc_is_refused() -> bool {
    let prereg = match preregister_experiment(106, 206, 311) {
        Some(value) => value,
        None => { return false },
    }
    match observe_experiment(
        prereg, 311, true, 411, 511, true, 412, 512, true,
    ) {
        Some(value) => false,
        None => true,
    }
}

fn main() -> i64 with IO {
    if !supported_case() { return 11 }
    if !failed_control_refuses_promotion() { return 12 }
    if !falsified_is_retained() { return 13 }
    if !inconclusive_is_retained() { return 14 }
    if !same_artifact_is_refused() { return 15 }
    if !posthoc_is_refused() { return 16 }
    println("causal-typestate: PASS supported=1 control-refusal=1 falsified=1 inconclusive=1 distinct=1 prereg-before-subject=1")
    0
}
