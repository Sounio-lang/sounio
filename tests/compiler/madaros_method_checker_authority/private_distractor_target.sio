pub struct VisibilityAuthority {
    pub value: i64,
}

pub fn make_visibility_authority() -> VisibilityAuthority {
    VisibilityAuthority { value: 42 }
}

impl VisibilityAuthority {
    pub fn witness(self: VisibilityAuthority) -> i64 {
        self.value
    }
}

impl VisibilityAuthority {
    fn witness(self: VisibilityAuthority) -> i64 {
        99
    }
}
