use ambiguous_same_receiver_marker::{duplicate_marker}

struct DuplicateAuthority {
    value: i64,
}

impl DuplicateAuthority {
    pub fn witness(self: DuplicateAuthority) -> i64 {
        self.value
    }
}

impl DuplicateAuthority {
    pub fn witness(self: DuplicateAuthority) -> i64 {
        99
    }
}

fn main() -> i64 {
    if duplicate_marker() != 7 { return 1 }
    let value = DuplicateAuthority { value: 42 }
    value.witness()
}
