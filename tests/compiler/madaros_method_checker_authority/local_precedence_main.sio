use local_precedence_distractor::{unrelated_marker}

struct LocalAuthority {
    value: i64,
}

impl LocalAuthority {
    fn witness(self: LocalAuthority) -> i64 {
        self.value
    }
}

fn make_local() -> LocalAuthority {
    LocalAuthority { value: 42 }
}

fn main() -> i64 {
    if unrelated_marker() != 7 { return 1 }
    let value = make_local()
    value.witness()
}
