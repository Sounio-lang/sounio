fn exp(x: f64) -> f64 {
    x + 1.0
}

fn cos(x: f64) -> f64 {
    x + 2.0
}

fn main() -> i32 with IO {
    let e = exp(1.0)
    let c = cos(1.0)
    let es = (e * 1000.0) as i64
    let cs = (c * 1000.0) as i64
    print_int(es)
    print("\n")
    print_int(cs)
    print("\n")
    if es == 2000 && cs == 3000 {
        println("SAMEFILE_OK")
        return 0
    }
    println("SAMEFILE_FAIL")
    return 1
}
