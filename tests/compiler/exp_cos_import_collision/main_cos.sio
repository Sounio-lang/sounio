use exp_cos_import_collision::lib::{cos}

fn main() -> i32 with IO {
    let v = cos(1.0)
    // user: 3.0 → 3000; true cos≈0.54 → 540
    let scaled = (v * 1000.0) as i64
    print_int(scaled)
    print("\n")
    if scaled == 3000 {
        println("USER_COS_OK")
        return 0
    }
    println("USER_COS_FAIL")
    return 1
}
