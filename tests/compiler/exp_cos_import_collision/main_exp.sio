use exp_cos_import_collision::lib::{exp}

fn main() -> i32 with IO {
    let v = exp(1.0)
    // user body: 2.0; float intrinsic: ~2.718
    let scaled = (v * 1000.0) as i64
    print_int(scaled)
    print("\n")
    if scaled == 2000 {
        println("USER_EXP_OK")
        return 0
    }
    println("USER_EXP_FAIL")
    return 1
}
