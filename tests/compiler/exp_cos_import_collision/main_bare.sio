// Bare float intrinsic — no user def of exp
fn main() -> i32 with IO {
    let v = exp(0.0)
    // e^0 = 1.0
    let scaled = (v * 1000.0) as i64
    print_int(scaled)
    print("\n")
    if scaled == 1000 {
        println("BARE_EXP_OK")
        return 0
    }
    println("BARE_EXP_FAIL")
    return 1
}
