// Synthetic compiler witness only. The integer projection is not a biological,
// pharmacological, diagnostic, or clinical model.
ontology OrderedPathProvenance {
    class OrderedPathStep
    class StepA subclass_of OrderedPathStep
    class StepB subclass_of OrderedPathStep
    class StepC subclass_of OrderedPathStep
    class PathOrderReceipt
    class OrderABReceipt subclass_of PathOrderReceipt
    class OrderBAReceipt subclass_of PathOrderReceipt
    class ReceptorOccupancyObservation
    class FunctionalState
    class StateAfterAB subclass_of FunctionalState
    class StateAfterBA subclass_of FunctionalState
    class LeftGroupedABCState subclass_of FunctionalState
    class RightGroupedABCState subclass_of FunctionalState
    class GroupingReceipt
    class LeftGrouping subclass_of GroupingReceipt
    class RightGrouping subclass_of GroupingReceipt
}

fn make_step_a() -> StepA { 1 as StepA }
fn make_step_b() -> StepB { 2 as StepB }
fn make_step_c() -> StepC { 3 as StepC }
fn order_ab() -> OrderABReceipt { 1 as OrderABReceipt }
fn order_ba() -> OrderBAReceipt { 2 as OrderBAReceipt }
fn observe_occupancy() -> ReceptorOccupancyObservation {
    800 as ReceptorOccupancyObservation
}
fn left_grouping() -> LeftGrouping { 1 as LeftGrouping }
fn right_grouping() -> RightGrouping { 2 as RightGrouping }

fn state_after_ab(
    input: i64,
    occupancy: ReceptorOccupancyObservation,
    a: StepA,
    b: StepB,
    order: OrderABReceipt,
) -> StateAfterAB {
    (input + (occupancy as i64)) as StateAfterAB
}

fn state_after_ba(
    input: i64,
    occupancy: ReceptorOccupancyObservation,
    b: StepB,
    a: StepA,
    order: OrderBAReceipt,
) -> StateAfterBA {
    (input + (occupancy as i64)) as StateAfterBA
}

fn project_ab(state: StateAfterAB) -> i64 { state as i64 }
fn project_ba(state: StateAfterBA) -> i64 { state as i64 }
fn continue_ab(state: StateAfterAB, next_input: i64) -> i64 {
    (state as i64) + next_input
}
fn continue_ba(state: StateAfterBA, next_input: i64) -> i64 {
    (state as i64) + next_input * 2
}

fn left_grouped_abc(
    input: i64,
    occupancy: ReceptorOccupancyObservation,
    a: StepA,
    b: StepB,
    c: StepC,
    grouping: LeftGrouping,
) -> LeftGroupedABCState {
    (input + (occupancy as i64)) as LeftGroupedABCState
}

fn right_grouped_abc(
    input: i64,
    occupancy: ReceptorOccupancyObservation,
    a: StepA,
    b: StepB,
    c: StepC,
    grouping: RightGrouping,
) -> RightGroupedABCState {
    (input + (occupancy as i64)) as RightGroupedABCState
}

fn project_left(state: LeftGroupedABCState) -> i64 { state as i64 }
fn project_right(state: RightGroupedABCState) -> i64 { state as i64 }
fn continue_left(state: LeftGroupedABCState, next_input: i64) -> i64 {
    (state as i64) + next_input * 3
}
fn continue_right(state: RightGroupedABCState, next_input: i64) -> i64 {
    (state as i64) + next_input * 4
}

fn main() -> i64 with IO {
    let input: i64 = 333
    let occupancy = observe_occupancy()
    let a = make_step_a()
    let b = make_step_b()
    let c = make_step_c()

    let ab = state_after_ab(input, occupancy, a, b, order_ab())
    let ba = state_after_ba(input, occupancy, b, a, order_ba())
    let immediate_ab = project_ab(ab)
    let immediate_ba = project_ba(ba)
    if immediate_ab != 1133 || immediate_ba != 1133 { return 1 }

    let left = left_grouped_abc(input, occupancy, a, b, c, left_grouping())
    let right = right_grouped_abc(input, occupancy, a, b, c, right_grouping())
    let immediate_left = project_left(left)
    let immediate_right = project_right(right)
    if immediate_left != 1133 || immediate_right != 1133 { return 2 }

    let later_ab = continue_ab(ab, 7)
    let later_ba = continue_ba(ba, 7)
    let later_left = continue_left(left, 7)
    let later_right = continue_right(right, 7)
    if later_ab != 1140 || later_ba != 1147 { return 3 }
    if later_left != 1154 || later_right != 1161 { return 4 }

    print("ORDERED_PATH_OK occupancy=")
    print_int(occupancy as i64)
    print(" input=")
    print_int(input)
    print(" immediate=")
    print_int(immediate_ab)
    print(" later_ab=")
    print_int(later_ab)
    print(" later_ba=")
    print_int(later_ba)
    print(" later_left=")
    print_int(later_left)
    print(" later_right=")
    print_int(later_right)
    print("\n")
    0
}
