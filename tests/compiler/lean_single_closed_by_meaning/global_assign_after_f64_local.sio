// lean_single used to type-check an assignment to a global against `rhs_ty`, a
// variable declared only in the local-assignment branch of compile_stmt: the
// global branch read a stale stack slot. Here the slot holds the f64 type left by
// `y = 2.5`, so the seed warned "assignment type mismatch" on the well-typed
// `G = 5`. Must compile with no warning and print 5.
var G: i64 = 0

fn main() -> i64 with IO, Mut, Panic, Div {
    var y: f64 = 0.0
    y = 2.5
    G = 5
    print_int(G)
    print("\n")
    return 0
}
