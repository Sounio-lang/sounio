//@ run-pass

fn apply_xor(state: i64, next_input: i64) -> i64 {
    state ^ next_input
}

fn apply_or(state: i64, next_input: i64) -> i64 {
    state | next_input
}

fn apply_and(state: i64, next_input: i64) -> i64 {
    state & next_input
}

fn apply_xor_mask(state: i64, next_input: i64) -> i64 {
    state ^ (next_input | 8)
}

fn main() -> i64 with IO {
    let ab = apply_xor(877, 7)
    let ba = apply_or(877, 7)
    let left = apply_and(877, 7)
    let right = apply_xor_mask(877, 7)
    print_int(ab)
    print(" ")
    print_int(ba)
    print(" ")
    print_int(left)
    print(" ")
    print_int(right)
    print("\n")
    (ab ^ 874) | (ba ^ 879) | (left ^ 5) | (right ^ 866)
}
