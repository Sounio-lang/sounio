//@ run-pass
//@ description: a Knowledge<f64> parameter keeps the variance measure() stored in slot 1

fn read_sigma(k: Knowledge<f64>) -> f64 with Epistemic {
    uncertainty_of(k)
}

fn main() -> i32 with Epistemic, IO {
    let k: Knowledge<f64> = measure(1.0, uncertainty: 0.01)
    let local_sig = uncertainty_of(k)
    let crossed = read_sigma(k)
    print("local=")
    print_f64(local_sig)
    print(" cross=")
    print_f64(crossed)
    print("\n")
    if local_sig < 0.009999 { return 1 }
    if local_sig > 0.010001 { return 1 }
    if crossed < 0.009999 { return 2 }
    if crossed > 0.010001 { return 2 }
    return 0
}
