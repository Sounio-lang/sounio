use coordination::loom_witness_mesh_v1::{
    LoomWitnessMeshV1HostTrust,
    WitnessMeshV1Digest256,
    admit_witness_mesh_v1_digest256,
    host_witness_mesh_v1_frame_accepts,
    admit_verified_witness_mesh_v1_share,
    combine_verified_witness_mesh_v1_shares,
    consume_verified_witness_mesh_v1_checkpoint,
    close_host_witness_mesh_v1_receipt,
}

fn digest(seed: i64) -> WitnessMeshV1Digest256 {
    admit_witness_mesh_v1_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> WitnessMeshV1Digest256 {
    admit_witness_mesh_v1_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn linear_quorum_case() -> bool with LoomWitnessMeshV1HostTrust, Panic {
    let first = admit_verified_witness_mesh_v1_share(101, 501, 1, 3, digest(20))
    let second = admit_verified_witness_mesh_v1_share(201, 501, 1, 3, digest(20))
    let third = admit_verified_witness_mesh_v1_share(301, 501, 1, 3, digest(20))
    let checkpoint = combine_verified_witness_mesh_v1_shares(first, second, third)
    let receipt = consume_verified_witness_mesh_v1_checkpoint(checkpoint)
    close_host_witness_mesh_v1_receipt(receipt) == 505
}

fn main() -> i64 with IO, LoomWitnessMeshV1HostTrust, Panic {
    let accepted = host_witness_mesh_v1_frame_accepts(
        3, 1, 1, 1, 0,
        101, 201, 301, 401,
        101, 201, 301, 0,
        501, 501, 501, 501, 0,
        0, 1, 1, 1, 1, 0,
        0, 3, 3, 3, 3, 0,
        digest(10), digest(10), digest(10), digest(10), zero_digest(),
        digest(20), digest(20), digest(20), digest(20), zero_digest(),
    )
    let two_shares_refused = !host_witness_mesh_v1_frame_accepts(
        3, 1, 1, 0, 0,
        101, 201, 301, 401,
        101, 201, 0, 0,
        501, 501, 501, 0, 0,
        0, 1, 1, 1, 0, 0,
        0, 3, 3, 3, 0, 0,
        digest(10), digest(10), digest(10), zero_digest(), zero_digest(),
        digest(20), digest(20), digest(20), zero_digest(), zero_digest(),
    )
    if !accepted || !two_shares_refused || !linear_quorum_case() {
        return 1
    }
    println("loom-witness-mesh-v1-typestate: PASS linear=1 shares=3 checkpoint=1 host_receipt=1 quorum=3/4")
    0
}
