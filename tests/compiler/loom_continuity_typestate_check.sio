//@ check-pass

use coordination::loom_continuity::{
    observe_continuity,
    pod_resurrection_count,
    pod_resurrection_evidence_set,
    pod_resurrection_lineage_head,
    pod_resurrection_predecessor,
    promote_clean_respawn,
    promote_initial_generation,
    promote_pod_resurrection,
    verify_clean_respawn,
    verify_initial_generation,
    verify_pod_resurrection,
}

fn observation(
    transition_kind: i64,
    transition_count: i64,
    pod_count: i64,
    lineage_head: i64,
    predecessor: i64,
    predecessor_semantic: i64,
    predecessor_guardian: i64,
    loom_authority: bool,
) -> Option<ObservedContinuity> {
    observe_continuity(
        101, 201, 301, 401, 501,
        lineage_head, predecessor, predecessor_semantic, predecessor_guardian,
        transition_kind, transition_count, pod_count,
        loom_authority, true, true,
    )
}

fn initial_case() -> bool {
    let observed = match observation(1, 0, 0, 0, 0, 0, 0, true) {
        Some(value) => value,
        None => { return false },
    }
    match verify_initial_generation(observed) {
        Some(receipt) => promote_initial_generation(receipt) == 201,
        None => false,
    }
}

fn clean_respawn_case() -> bool {
    let observed = match observation(2, 2, 1, 601, 701, 801, 901, true) {
        Some(value) => value,
        None => { return false },
    }
    match verify_clean_respawn(observed) {
        Some(receipt) => promote_clean_respawn(receipt) == 201,
        None => false,
    }
}

fn pod_resurrection_case() -> bool {
    let observed = match observation(3, 2, 2, 602, 702, 802, 902, true) {
        Some(value) => value,
        None => { return false },
    }
    match verify_pod_resurrection(observed) {
        Some(receipt) =>
            promote_pod_resurrection(receipt) == 201 &&
            pod_resurrection_evidence_set(receipt) == 101 &&
            pod_resurrection_lineage_head(receipt) == 602 &&
            pod_resurrection_predecessor(receipt) == 702 &&
            pod_resurrection_count(receipt) == 2,
        None => false,
    }
}

fn incomplete_predecessor_refuses() -> bool {
    let observed = match observation(3, 1, 1, 603, 703, 0, 903, true) {
        Some(value) => value,
        None => { return false },
    }
    match verify_pod_resurrection(observed) {
        Some(receipt) => false,
        None => true,
    }
}

fn zero_pod_count_refuses() -> bool {
    let observed = match observation(3, 1, 0, 604, 704, 804, 904, true) {
        Some(value) => value,
        None => { return false },
    }
    match verify_pod_resurrection(observed) {
        Some(receipt) => false,
        None => true,
    }
}

fn wrong_kind_refuses() -> bool {
    let observed = match observation(2, 1, 0, 605, 705, 805, 905, true) {
        Some(value) => value,
        None => { return false },
    }
    match verify_pod_resurrection(observed) {
        Some(receipt) => false,
        None => true,
    }
}

fn foreign_authority_refuses() -> bool {
    let observed = match observation(3, 1, 1, 606, 706, 806, 906, false) {
        Some(value) => value,
        None => { return false },
    }
    match verify_pod_resurrection(observed) {
        Some(receipt) => false,
        None => true,
    }
}

fn main() -> i64 with IO {
    if !initial_case() { return 11 }
    if !clean_respawn_case() { return 12 }
    if !pod_resurrection_case() { return 13 }
    if !incomplete_predecessor_refuses() { return 14 }
    if !zero_pod_count_refuses() { return 15 }
    if !wrong_kind_refuses() { return 16 }
    if !foreign_authority_refuses() { return 17 }
    println("loom-continuity-typestate: PASS initial=1 clean=1 pod=1 predecessor=refused count=refused kind=refused authority=refused")
    0
}
