fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn print_i64_dec(x: i64) -> i64 {
    x + 10
}

pub fn leaf_call_matrix() -> i64 {
    let abs_term = abs_f64(0.0 - 2.0) as i64
    abs_term
        + print_i64_dec(0)
        + print_i64_dec(1)
        + print_i64_dec(2)
        + print_i64_dec(3)
        + print_i64_dec(4)
        + print_i64_dec(5)
        + print_i64_dec(6)
        + print_i64_dec(7)
        + print_i64_dec(8)
        + print_i64_dec(9)
        + print_i64_dec(10)
        + print_i64_dec(11)
        + print_i64_dec(12)
        + print_i64_dec(13)
        + print_i64_dec(14)
        + print_i64_dec(15)
        + print_i64_dec(16)
}
