use duplicate_private_enum_leaf::{leaf_construct_private_enum_forms}

enum DuplicatePrivateEnum {
    RootUnit,
    RootCall,
    RootRecord { root_value: i64 },
}

enum LocalBare {
    A,
}

enum CrossKind {
    LocalRecord { local_value: i64 },
}

fn main() -> i64 {
    let root_unit = DuplicatePrivateEnum::RootUnit
    let root_call = DuplicatePrivateEnum::RootCall()
    let root_record = DuplicatePrivateEnum::RootRecord { root_value: 6 }
    let local_bare = A
    let local_cross_kind = CrossKind::LocalRecord { local_value: 7 }
    // ExprLoop crosses the remaining by-value checker bridge. These constructors
    // must retain the same module-local authority as the ordinary in-place path.
    loop {
        let bridged_record = DuplicatePrivateEnum::RootRecord { root_value: 8 }
        let bridged_cross_kind = CrossKind::LocalRecord { local_value: 9 }
        break
    }
    if leaf_construct_private_enum_forms() != 5 { return 41 }
    0
}
