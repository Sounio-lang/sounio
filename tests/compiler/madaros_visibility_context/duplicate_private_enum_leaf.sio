enum DuplicatePrivateEnum {
    LeafUnit,
    LeafCall,
    LeafRecord { leaf_value: i64 },
}

// The root owns a bare variant named A. This remote enum type deliberately
// collides with that variant spelling.
enum A {
    RemoteNamed,
}

// The root owns a local enum with this name. A remote private struct must not
// preempt `CrossKind::LocalRecord { ... }` during struct-literal dispatch.
struct CrossKind {
    remote_value: i64,
}

pub fn leaf_construct_private_enum_forms() -> i64 {
    let leaf_unit = DuplicatePrivateEnum::LeafUnit
    let leaf_call = DuplicatePrivateEnum::LeafCall()
    let leaf_record = DuplicatePrivateEnum::LeafRecord { leaf_value: 3 }
    loop {
        let bridged_leaf_record = DuplicatePrivateEnum::LeafRecord { leaf_value: 6 }
        break
    }
    let remote_named = A::RemoteNamed
    let remote_struct = CrossKind { remote_value: 4 }
    5
}
