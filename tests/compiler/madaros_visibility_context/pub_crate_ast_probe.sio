use lexer::mod::{lex_file_parse_items}
use parser::parser::{parser_last_error_count}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var cursor = lex_file_parse_items(get_arg(0))
    var item_count: i64 = 0
    var all_pub_crate = true

    while true {
        match cursor {
            Some(node) => {
                let visibility_kind = (*node).head.visibility.kind
                print("visibility[")
                print_int(item_count)
                print("]=")
                print_int(visibility_kind)
                print("\n")
                if visibility_kind != 2 { all_pub_crate = false }
                item_count = item_count + 1
                cursor = (*node).tail
            }
            None => break
        }
    }

    let parse_errors = parser_last_error_count()
    if all_pub_crate && item_count == 3 && parse_errors == 0 {
        print("PASS pub_crate_ast_visibility kind=2 items=3 parse_errors=0\n")
        return 0
    }
    print("parse_errors=")
    print_int(parse_errors)
    print("\n")
    print("FAIL pub_crate_ast_visibility\n")
    1
}
