ontology LoopRebracketingSemantics {
    class CompilerSemanticObligation
    class ExactBitwiseRebracketObligation subclass_of CompilerSemanticObligation
}

fn require_compiler_semantic_obligation(obligation: CompilerSemanticObligation) -> i64 {
    0
}

fn ontology_subsumption_witness(obligation: ExactBitwiseRebracketObligation) -> i64 {
    require_compiler_semantic_obligation(obligation)
}

pub fn authority_refuse_loop(
    x: i64,
    rounds: i64,
    obligation: ExactBitwiseRebracketObligation,
) -> i64 {
    let inner = x & 255
    var i: i64 = 0
    while i < rounds {
        i = i + 1
    }
    inner & 15
}

fn main() -> i64 {
    // The optimizer still inspects authority_refuse_loop and must record the
    // backedge refusal. Runtime stays independent of historical loop codegen.
    0
}
