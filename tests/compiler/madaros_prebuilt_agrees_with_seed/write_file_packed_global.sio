// write_file on a packed global `[i8; N]` must write its bytes in order (#2966,
// fixed by f078496f87). A Madaros built before that commit read every 8th byte,
// starting 32 bytes late, because the global had no object header. lean_single.sio
// writes its output ELF this way (`write_file(output, ELF, tsz)`), so that
// Madaros built a lean_single whose output was not an ELF.
// Must write ABCDEFGHIJKLMNOP to write_file_packed_global.out in the working
// directory and print 16.
var BUF: [i8; 4096] = [0; 4096]

fn main() -> i64 with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < 64 {
        BUF[i as usize] = (i + 65) as i8
        i = i + 1
    }
    let ok = write_file("write_file_packed_global.out", BUF, 16)
    print_int(ok)
    print("\n")
    return 0
}
