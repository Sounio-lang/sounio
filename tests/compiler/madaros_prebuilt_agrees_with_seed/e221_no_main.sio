// An executable entry file with no `main` must be refused with
// `error[E221]: no main` and no ELF (#2720). A prebuilt built before #2720
// wrote the ELF anyway, with e_entry at the first merged dep function, and it
// died with SIGILL (rc 132). The same file stays a valid library: `check` and
// `--emit-obj` accept it.
use darwin_pbpk::core::pbpk28_params::*

fn init() -> PBPKState28 { pbpk28_state_zero() }
