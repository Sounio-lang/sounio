// A bodyless `extern "C" fn main()` is not an entry point: it lowers to an
// empty stub. It must be refused with `error[E221]: no main` and no ELF
// (#2720). A prebuilt built before #2720 wrote an ELF that died with SIGILL.
use darwin_pbpk::core::pbpk28_params::*

extern "C" fn main()

fn init() -> PBPKState28 { pbpk28_state_zero() }
