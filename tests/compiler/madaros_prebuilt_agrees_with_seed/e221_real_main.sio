// The positive control for the two E221 witnesses: the same import with a
// real `main` compiles, runs, and prints E221_REAL_MAIN_OK.
use darwin_pbpk::core::pbpk28_params::*

fn init() -> PBPKState28 { pbpk28_state_zero() }

fn main() -> i64 with IO {
    let s = init()
    print("E221_REAL_MAIN_OK\n")
    return 0
}
