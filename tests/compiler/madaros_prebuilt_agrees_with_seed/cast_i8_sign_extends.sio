// `0xc3 as i8` is -61: the sign-extended low byte (4066c302f5). A Madaros built
// before that commit took the cast for the identity and printed `195 -61 NE`.
// lean_single.sio relies on it in `CD[(CL - 1) as usize] != 0xc3 as i8`, which
// decides whether a function already ends in `ret`; under the identity reading
// every explicit `return` gained an unreachable second epilogue.
// Must print `-61 -61 EQ`.
var B: [i8; 16] = [0; 16]

fn main() -> i64 with IO, Mut, Panic, Div {
    B[3] = 0xc3 as i8
    let k: i64 = 0xc3 as i8
    print_int(k)
    print(" ")
    print_int(B[3] as i64)
    print(" ")
    if B[3] != 0xc3 as i8 { print("NE") } else { print("EQ") }
    print("\n")
    return 0
}
