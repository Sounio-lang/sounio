use coordination::fleet_transaction::{
    HostTrust,
    admit_runtime_receipt,
    import_issued_start_capability,
    import_host_argv_attestation,
    import_host_checkpoint_draft,
    import_host_evidence_verification,
    import_host_handoff_preparation,
    import_host_anchor_recipient_verification,
    consume_start_capability,
    attest_started_argv,
    draft_checkpoint,
    verify_checkpoint,
    prepare_handoff,
    accept_anchored_handoff,
    finalize_accepted_handoff,
    finalized_receipt_matches,
}

fn main() with HostTrust {
    let issue_receipt = admit_runtime_receipt(
        601, 1, 801, 1, 73, 11, 0, 0, 0, 0, 0, 0, 0, 0,
    )
    let argv_receipt = admit_runtime_receipt(
        601, 2, 801, 2, 73, 12, 101, 0, 0, 0, 0, 0, 0, 0,
    )
    let draft_receipt = admit_runtime_receipt(
        601, 3, 801, 3, 73, 11, 101, 201, 301, 0, 0, 0, 0, 0,
    )
    let evidence_receipt = admit_runtime_receipt(
        601, 4, 801, 4, 73, 11, 101, 201, 301, 0, 0, 0, 0, 0,
    )
    let preparation_receipt = admit_runtime_receipt(
        601, 5, 801, 5, 73, 11, 101, 201, 301, 401, 501, 9, 0, 0,
    )
    let anchor_receipt = admit_runtime_receipt(
        601, 6, 801, 6, 73, 11, 101, 201, 301, 401, 501, 9, 701, 9,
    )
    let issued = import_issued_start_capability(issue_receipt)
    let wrong_slot = import_host_argv_attestation(argv_receipt)
    let draft_fact = import_host_checkpoint_draft(draft_receipt)
    let evidence = import_host_evidence_verification(evidence_receipt)
    let preparation = import_host_handoff_preparation(preparation_receipt)
    let anchor = import_host_anchor_recipient_verification(anchor_receipt)
    let consumed = consume_start_capability(issued)
    let active = attest_started_argv(consumed, wrong_slot)
    let draft = draft_checkpoint(active, draft_fact)
    let verified = verify_checkpoint(draft, evidence)
    let prepared = prepare_handoff(verified, preparation)
    let accepted = accept_anchored_handoff(prepared, anchor)
    let receipt = finalize_accepted_handoff(accepted)
    let matched = finalized_receipt_matches(
        receipt, 601, 801, 6, 11, 101, 201, 301, 401, 501, 9, 701, 9,
    )
}
