use coordination::fleet_transaction::{
    HostTrust,
    open_host_trust_bridge,
    admit_runtime_receipt,
    close_host_trust_bridge,
    import_issued_start_capability,
    consume_start_capability,
}

fn main() with HostTrust {
    let bridge0 = open_host_trust_bridge(601, 801)
    let (bridge1, host_receipt) = admit_runtime_receipt(
        bridge0,
        601, 1, 801, 1, 73, 11, 0, 0, 0, 0, 0, 0, 0, 0,
    )
    close_host_trust_bridge(bridge1)
    let issued = import_issued_start_capability(host_receipt)
    let first = consume_start_capability(issued)
    let second = consume_start_capability(issued)
}
