struct Bag {
    items: Seq<i64>,
    tag: i64,
}

pub fn imported_seq_field_push() -> i64 with Alloc, Mut {
    var bag = Bag { items: seq_new(), tag: 7 }
    bag.items.push(12)
    bag.items.push(13)
    bag.items.push(14)
    bag.items.push(15)
    bag.items.push(16)
    if bag.tag != 7 { return 101 }
    if bag.items.count() != 5 { return 102 }
    bag.items[0] + bag.items.get(4)
}
