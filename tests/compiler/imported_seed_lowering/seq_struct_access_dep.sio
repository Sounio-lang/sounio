struct Decoy {
    y: i64,
}

struct Pair {
    x: i64,
    y: i64,
}

fn indexed_y(values: Seq<Pair>) -> i64 with Alloc, Mut {
    values[0].y
}

pub fn imported_seq_struct_access() -> i64 with Alloc, Mut {
    let decoy = Decoy { y: 99 }
    if decoy.y != 99 { return 100 }
    var values: Seq<Pair> = seq_new()
    var alias = values
    values.push(Pair { x: 3, y: 4 })
    values.push(Pair { x: 5, y: 6 })
    if alias[0].x != 3 { return 101 }
    if indexed_y(alias) != 4 { return 102 }
    alias.set(1, Pair { x: 7, y: 8 })
    if values[1].y != 8 { return 103 }
    values[0].y + values.get(1).x
}
