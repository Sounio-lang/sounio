pub fn imported_seq_free_builtins() -> i64 with Alloc, Mut, Panic {
    var values: Seq<i64> = seq_new()
    var i = 0
    while i < 9 {
        seq_push(values, i * 4)
        i = i + 1
    }
    if seq_count(values) != 9 { return 101 }
    if seq_get(values, 8) != 32 { return 102 }
    seq_set(values, 1, 40)
    seq_get(values, 1) + seq_get(values, 8) + seq_count(values)
}
