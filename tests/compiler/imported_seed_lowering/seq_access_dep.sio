pub fn imported_seq_access() -> i64 with Alloc, Mut {
    var values: Seq<i64> = seq_new()
    var alias = values
    values.push(1)
    values.push(2)
    values.push(3)
    values.push(4)
    values.push(5)
    if alias.get(4) != 5 { return 101 }
    alias.set(0, 9)
    if values.get(0) != 9 { return 102 }
    if values[4] != 5 { return 103 }
    values[0] = 11
    values.get(0)
}
