pub struct MethodPoisonShape {
    family_id: i64,
}

pub struct MethodInnerState {
    state_id: i64,
    protocol_id: i64,
}

pub struct MethodStateFactory {
    seed: i64,
}

impl MethodStateFactory {
    pub fn build(self: &MethodStateFactory) -> MethodInnerState {
        MethodInnerState {
            state_id: 6102,
            protocol_id: 8400,
        }
    }
}

pub fn method_result_known_layout_miss(factory: MethodStateFactory) -> i64 {
    factory.build().family_id
}

pub fn method_result_known_field(factory: MethodStateFactory) -> i64 {
    factory.build().state_id
}
