use issue_901_nested_field_chain_leaf::{make_outer_transition, nested_family_id_direct, nested_family_id_materialized}
use issue_901_method_result_known_layout_miss_leaf::{method_result_known_field, MethodStateFactory}
use issue_901_indexed_element_known_layout_miss_leaf::{indexed_element_known_field, IndexedInnerState, IndexedStateBatch}

fn main() with IO, Panic {
    let value_direct = make_outer_transition()
    let direct = nested_family_id_direct(value_direct)
    assert(direct == 520)

    let value_materialized = make_outer_transition()
    let materialized = nested_family_id_materialized(value_materialized)
    assert(materialized == 520)

    let method_field = method_result_known_field(MethodStateFactory { seed: 0 })
    assert(method_field == 6102)
    let indexed_field = indexed_element_known_field(IndexedStateBatch {
        states: [IndexedInnerState { state_id: 6102, protocol_id: 8400 }; 1],
    })
    assert(indexed_field == 6102)

    println(direct)
    println(materialized)
    println("ISSUE_901_NESTED_FIELD_CHAIN_OK")
    println("ISSUE_901_NOMINAL_PROJECTION_CONTROLS_OK")
}
