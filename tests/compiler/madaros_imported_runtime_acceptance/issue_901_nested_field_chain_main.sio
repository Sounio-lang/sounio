use issue_901_nested_field_chain_leaf::{make_outer_transition, nested_family_id}

fn main() with IO, Panic {
    let value = make_outer_transition()
    let nested_family = nested_family_id(value)
    println(nested_family)
    assert(nested_family == 520)
    println("ISSUE_901_NESTED_FIELD_CHAIN_OK")
}
