use issue_901_nested_field_chain_leaf::{make_outer_transition, nested_family_id_direct, nested_family_id_materialized}

fn main() with IO, Panic {
    let value_direct = make_outer_transition()
    let direct = nested_family_id_direct(value_direct)
    assert(direct == 520)

    let value_materialized = make_outer_transition()
    let materialized = nested_family_id_materialized(value_materialized)
    assert(materialized == 520)

    println(direct)
    println(materialized)
    println("ISSUE_901_NESTED_FIELD_CHAIN_OK")
}
