// #901: typed chained field access must retain the inner nominal layout.
// `family_id` is deliberately at index 2 in EarlierFamilyShape and
// OuterTransition, but at index 1 in InnerState. A global name lookup reads
// InnerState.protocol_id (8400) instead of its family_id (520).

pub struct EarlierFamilyShape {
    prefix_a: i64,
    prefix_b: i64,
    family_id: i64,
}

pub struct OuterTransition {
    transition_id: i64,
    evidence_kind: i64,
    family_id: i64,
    // Deliberately declared before InnerState: nested type resolution must not
    // depend on declaration order.
    result_state: InnerState,
}

pub struct InnerState {
    state_id: i64,
    family_id: i64,
    protocol_id: i64,
}

pub fn make_outer_transition() -> OuterTransition {
    OuterTransition {
        transition_id: 6101,
        evidence_kind: 1,
        family_id: 520,
        result_state: InnerState {
            state_id: 6102,
            family_id: 520,
            protocol_id: 8400,
        },
    }
}

pub fn nested_family_id(value: OuterTransition) -> i64 {
    value.result_state.family_id
}
