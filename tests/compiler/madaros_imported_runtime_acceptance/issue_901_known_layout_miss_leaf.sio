// #901 negative witness: `family_id` exists globally, but not on InnerState.
// A typed nested lookup must reject this rather than borrow PoisonShape.family_id.

pub struct PoisonShape {
    family_id: i64,
}

pub struct InnerState {
    state_id: i64,
    protocol_id: i64,
}

pub struct OuterTransition {
    family_id: i64,
    result_state: InnerState,
}

pub fn known_layout_miss(value: OuterTransition) -> i64 {
    let inner = value.result_state
    inner.family_id
}
