pub struct IndexedPoisonShape {
    family_id: i64,
}

pub struct IndexedInnerState {
    state_id: i64,
    protocol_id: i64,
}

pub struct IndexedStateBatch {
    states: [IndexedInnerState; 1],
}

pub fn indexed_element_known_layout_miss(batch: IndexedStateBatch) -> i64 {
    batch.states[0].family_id
}

pub fn indexed_element_known_field(batch: IndexedStateBatch) -> i64 {
    batch.states[0].state_id
}
