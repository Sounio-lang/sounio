use coordination::loom_epistemic_machine::{
    LoomEpistemicHostTrust,
    EpistemicDigest256,
    admit_epistemic_digest256,
    open_epistemic_host_bridge,
    admit_host_epistemic_transition,
    close_epistemic_host_bridge,
    import_epistemic_world,
    observe_epistemic_knowledge,
    open_epistemic_claim,
    challenge_epistemic_claim,
    acquire_linear_write_capability,
    release_linear_write_capability,
    fork_epistemic_world,
    challenged_claim_token,
    forked_world_token,
    host_epistemic_transition_accepts,
}

fn digest(seed: i64) -> EpistemicDigest256 {
    admit_epistemic_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> EpistemicDigest256 {
    admit_epistemic_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn typestate_case() -> bool with LoomEpistemicHostTrust, Panic {
    let zero = zero_digest()
    let seal = open_epistemic_host_bridge(101)
    let admitted = admit_host_epistemic_transition(
        seal, 1, 0, 1, 101, 0, 0, 0, 0, 0,
        zero, zero, zero, zero, zero, zero, zero,
    )
    let (next_seal, receipt) = admitted
    close_epistemic_host_bridge(next_seal)
    match import_epistemic_world(receipt) {
        Some(world) => match observe_epistemic_knowledge(
            world, 201, digest(10), digest(20), digest(30), digest(40), digest(50),
        ) {
            Some(observed) => {
                let (world_after_observation, knowledge) = observed
                match open_epistemic_claim(knowledge, 301, digest(60)) {
                    Some(claim) => match challenge_epistemic_claim(
                        claim, 401, digest(70),
                    ) {
                        Some(challenged) => {
                            let claim_token = challenged_claim_token(challenged)
                            match acquire_linear_write_capability(
                                world_after_observation, 501, 601, 701, 801,
                            ) {
                                Some(acquired) => {
                                    let (world_after_capability, capability) = acquired
                                    let capability_token =
                                        release_linear_write_capability(capability)
                                    match fork_epistemic_world(
                                        world_after_capability, 102,
                                        digest(80), digest(90),
                                    ) {
                                        Some(forked) => {
                                            let (parent_world, child_world) = forked
                                            claim_token == 301 &&
                                            capability_token == 501 &&
                                            forked_world_token(child_world) == 102
                                        },
                                        None => false,
                                    }
                                },
                                None => false,
                            }
                        },
                        None => false,
                    },
                    None => false,
                }
            },
            None => false,
        },
        None => false,
    }
}

fn main() -> i64 with IO, LoomEpistemicHostTrust, Panic {
    let zero = zero_digest()
    let observation_accepts = host_epistemic_transition_accepts(
        2, 1, 1, 101, 0, 201, 0, 0, 0,
        digest(10), digest(20), digest(30), digest(40), digest(50), zero, zero,
    )
    let missing_uncertainty_refuses = !host_epistemic_transition_accepts(
        2, 1, 1, 101, 0, 201, 0, 0, 0,
        digest(10), digest(20), zero, digest(40), digest(50), zero, zero,
    )
    let challenge_without_falsifier_refuses = !host_epistemic_transition_accepts(
        4, 1, 1, 101, 0, 401, 301, 0, 0,
        zero, zero, zero, zero, zero, zero, zero,
    )
    if !observation_accepts || !missing_uncertainty_refuses ||
        !challenge_without_falsifier_refuses || !typestate_case() {
        return 1
    }
    println("loom-epistemic-typestate: PASS host_seal=private knowledge_axes=5 claim=1 challenge=1 linear_capability=1 fork=1")
    0
}
