// Wave14e residual: bare float intrinsics must participate in f64 arithmetic.
// Pre-fix tip: print_f64(cos(0)) and f64_to_bits(cos(0)) look correct (bits ABI),
// but cos(0.0) * 1000.0 used cvtsi2sd on the IEEE bit pattern → ~4.6e21.
// Gate: scaled integer sentinels (avoid flaky f64 compares / print_f64 alone).

fn main() -> i32 with IO {
    // cos(0)=1 → 1000
    let c = cos(0.0)
    let cm = (c * 1000.0) as i64
    print_int(cm)
    print("\n")
    if cm != 1000 {
        println("FAIL cos*1000")
        return 1
    }

    // sqrt(4)=2 → 2000
    let q = sqrt(4.0)
    let qm = (q * 1000.0) as i64
    print_int(qm)
    print("\n")
    if qm != 2000 {
        println("FAIL sqrt*1000")
        return 2
    }

    // sin(0)=0 → 0 after + identity via float path
    let s = sin(0.0)
    let sp = ((s + 1.0) * 1000.0) as i64
    print_int(sp)
    print("\n")
    if sp != 1000 {
        println("FAIL sin+1")
        return 3
    }

    // exp(1)≈2.718 → scaled 2718 ± 1 (minimax)
    let e = exp(1.0)
    let em = (e * 1000.0) as i64
    print_int(em)
    print("\n")
    if em < 2717 || em > 2719 {
        println("FAIL exp(1)*1000")
        return 4
    }

    // control: literal product still correct
    let lit = (1.0 * 1000.0) as i64
    if lit != 1000 {
        println("FAIL lit*1000")
        return 5
    }

    println("BARE_FLOAT_ARITH_OK")
    return 0
}
