fn emit_decimal_literal_v1(name: string, value: f64) with IO, Mut, Panic, Div {
    print(name)
    print(" ")
    print_int(f64_to_bits(value))
    print("\n")
}

fn main() -> i32 with IO, Mut, Panic, Div {
    emit_decimal_literal_v1("0.1", 0.1)
    emit_decimal_literal_v1("3.14", 3.14)
    emit_decimal_literal_v1("0.333333333333333", 0.333333333333333)
    emit_decimal_literal_v1("2.718281828459045", 2.718281828459045)
    emit_decimal_literal_v1("6.022e23", 6.022e23)
    emit_decimal_literal_v1("1.7976931348623157e308", 1.7976931348623157e308)
    emit_decimal_literal_v1("5e-300", 5e-300)
    emit_decimal_literal_v1("1.23456789012345678", 1.23456789012345678)
    emit_decimal_literal_v1("5e-324", 5e-324)
    emit_decimal_literal_v1("2e-324", 2e-324)
    emit_decimal_literal_v1("3e-324", 3e-324)
    emit_decimal_literal_v1("2.2250738585072014e-308", 2.2250738585072014e-308)
    emit_decimal_literal_v1("1.7976931348623158e308", 1.7976931348623158e308)
    0
}
