use coordination::loom_attention_compiler::{
    LoomAttentionHostTrust,
    AttentionDigest256,
    admit_attention_digest256,
    host_attention_frame_accepts,
    acquire_attention_budget,
    compile_attention_plan,
    complete_attention_plan,
    close_attention_budget,
    close_completed_attention_plan,
}

fn digest(seed: i64) -> AttentionDigest256 {
    admit_attention_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> AttentionDigest256 {
    admit_attention_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn typestate_case() -> bool with Panic {
    let budget = acquire_attention_budget(100)
    let compiled = compile_attention_plan(
        budget, 101, 201, 301, 401, 501, 40,
        digest(10), digest(20), digest(30),
    )
    let (remaining, plan) = compiled
    let completed = complete_attention_plan(plan, digest(40))
    close_attention_budget(remaining) == 60 &&
    close_completed_attention_plan(completed) == 302
}

fn main() -> i64 with IO, LoomAttentionHostTrust, Panic {
    let accepted = host_attention_frame_accepts(
        1, 1, 100, 101, 201, 202, 301, 401,
        900, 500, 400, 50, 100,
        800, 900, 900, 50, 100,
        digest(10), digest(20), digest(30), zero_digest(),
    )
    let dominated_refused = !host_attention_frame_accepts(
        1, 1, 100, 101, 201, 202, 301, 401,
        100, 900, 900, 50, 0,
        900, 100, 100, 50, 100,
        digest(10), digest(20), digest(30), zero_digest(),
    )
    if !accepted || !dominated_refused || !typestate_case() { return 1 }
    println("loom-attention-typestate: PASS policies=3 budget=linear plan=compiled completion=typed comparator=bounded")
    0
}
