struct LeftValue {
    value: f64,
}

struct RightValue {
    value: f64,
}

impl LeftValue {
    fn exp(self: &LeftValue) -> f64 {
        self.value + 40.0
    }
}

impl RightValue {
    fn exp(self: &RightValue) -> f64 {
        self.value + 80.0
    }
}

fn main() -> i32 with IO {
    let left = LeftValue { value: 2.0 }
    let right = RightValue { value: 4.0 }
    let left_value = left.exp()
    let right_value = right.exp()
    if left_value < 41.9 || left_value > 42.1 { return 1 }
    if right_value < 83.9 || right_value > 84.1 { return 2 }
    print("ISSUE1021_METHOD_EXP_OVERLOAD_OK\n")
    return 0
}
