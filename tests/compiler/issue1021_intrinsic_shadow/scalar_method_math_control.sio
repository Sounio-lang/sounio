fn main() -> i32 with IO, Mut, Div, Panic {
    let one: f64 = 1.0
    let four: f64 = 4.0
    let negative: f64 = 0.0 - 3.0
    let raised = one.exp()
    let natural = raised.ln()
    let rooted = four.sqrt()
    let absolute = negative.abs()
    if raised < 2.7 || raised > 2.8 { return 1 }
    if natural < 0.9 || natural > 1.1 { return 2 }
    if rooted < 1.9 || rooted > 2.1 { return 3 }
    if absolute < 2.9 || absolute > 3.1 { return 4 }
    print("ISSUE1021_SCALAR_METHOD_MATH_CONTROL_OK\n")
    return 0
}
