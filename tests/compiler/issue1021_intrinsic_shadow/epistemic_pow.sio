use epistemic::knowledge::*
use epistemic::propagate::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let x = Epistemic::measured(2.0, 0.1)
    let value = pow(x, 3.0)
    let observed = value.val()
    if observed < 7.5 || observed > 8.5 { return 1 }
    print("ISSUE1021_EPISTEMIC_POW_OK\n")
    return 0
}
