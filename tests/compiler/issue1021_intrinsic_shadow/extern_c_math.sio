extern "C" {
    fn sqrt(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn ln(x: f64) -> f64;
    fn tan(x: f64) -> f64;
    fn atan(x: f64) -> f64;
    fn tanh(x: f64) -> f64;
    fn asin(x: f64) -> f64;
    fn acos(x: f64) -> f64;
    fn abs(x: f64) -> f64;
    fn atan2(y: f64, x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let rooted = sqrt(4.0)
    let raised = exp(1.0)
    let logged = log(raised)
    let natural = ln(raised)
    let powered = pow(2.0, 3.0)
    let absolute = abs(0.0 - 3.0)
    let angle = atan2(1.0, 1.0)
    if rooted < 1.9 || rooted > 2.1 { return 1 }
    if logged < 0.9 || logged > 1.1 { return 2 }
    if natural < 0.9 || natural > 1.1 { return 3 }
    if powered < 7.5 || powered > 8.5 { return 4 }
    if absolute < 2.9 || absolute > 3.1 { return 5 }
    if angle < 0.7 || angle > 0.9 { return 6 }
    if sin(0.0) < 0.0 || sin(0.0) > 0.01 { return 7 }
    if cos(0.0) < 0.99 || cos(0.0) > 1.01 { return 8 }
    if tan(0.0) < 0.0 || tan(0.0) > 0.01 { return 9 }
    if atan(0.0) < 0.0 || atan(0.0) > 0.01 { return 10 }
    if tanh(0.0) < 0.0 || tanh(0.0) > 0.01 { return 11 }
    if asin(0.0) < 0.0 || asin(0.0) > 0.01 { return 12 }
    if acos(1.0) < 0.0 || acos(1.0) > 0.01 { return 13 }
    print("ISSUE1021_EXTERN_C_MATH_OK\n")
    return 0
}
