fn main() -> i32 with IO, Mut, Div, Panic {
    let rooted = sqrt(4.0)
    let raised = exp(1.0)
    let natural = ln(raised)
    let logged = log(raised)
    let absolute = abs(0.0 - 3.0)
    let sine = sin(0.0)
    let cosine = cos(0.0)
    if rooted < 1.9 || rooted > 2.1 { return 1 }
    if raised < 2.7 || raised > 2.8 { return 2 }
    if natural < 0.9 || natural > 1.1 { return 3 }
    if logged < 0.9 || logged > 1.1 { return 4 }
    if absolute < 2.9 || absolute > 3.1 { return 5 }
    if sine < 0.0 || sine > 0.01 { return 6 }
    if cosine < 0.99 || cosine > 1.01 { return 7 }
    print("ISSUE1021_SCALAR_FREE_MATH_CONTROL_OK\n")
    return 0
}
