use epistemic::knowledge::*
use epistemic::propagate::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let x = Epistemic::measured(2.0, 0.1)
    let value = inverse(x)
    let observed = value.val()
    if observed < 0.4 || observed > 0.6 { return 1 }
    print("ISSUE1021_EPISTEMIC_INVERSE_CONTROL_OK\n")
    return 0
}
