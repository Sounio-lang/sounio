use epistemic::knowledge::*
use epistemic::propagate::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let x = Epistemic::measured(2.0, 0.1)
    let value = ln(x)
    let observed = value.val()
    if observed < 0.6 || observed > 0.8 { return 1 }
    print("ISSUE1021_EPISTEMIC_LN_OK\n")
    return 0
}
