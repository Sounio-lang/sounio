use epistemic::knowledge::*
use epistemic::propagate::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let x = Epistemic::measured(2.0, 0.1)
    let value = exp(x)
    let observed = value.val()
    if observed < 7.0 || observed > 8.0 { return 1 }
    print("ISSUE1021_EPISTEMIC_EXP_OK\n")
    return 0
}
