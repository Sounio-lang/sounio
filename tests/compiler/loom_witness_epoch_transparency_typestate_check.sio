use coordination::loom_witness_epoch_transparency::{
    LoomWitnessEpochTransparencyHostTrust,
    EpochTransparencyDigest256,
    admit_epoch_transparency_digest256,
    host_epoch_transparency_frame_accepts,
    admit_verified_epoch_transparency_handoff,
    admit_verified_epoch_transparency_checkpoint,
    join_epoch_transparency,
    consume_verified_epoch_transparency,
    close_host_epoch_transparency_receipt,
}

fn digest(seed: i64) -> EpochTransparencyDigest256 {
    admit_epoch_transparency_digest256(
        seed, seed + 1, seed + 2, seed + 3,
        seed + 4, seed + 5, seed + 6, seed + 7,
    )
}

fn zero_digest() -> EpochTransparencyDigest256 {
    admit_epoch_transparency_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn linear_transparency_case()
    -> bool with LoomWitnessEpochTransparencyHostTrust, Panic {
    let handoff = admit_verified_epoch_transparency_handoff(
        1, 1, 2, digest(10), zero_digest(),
    )
    let checkpoint = admit_verified_epoch_transparency_checkpoint(
        1, 1, 1, 3, 4, 1, digest(20), 1, 1,
        digest(30), digest(40), digest(50), digest(60),
    )
    let verified = match join_epoch_transparency(
        handoff, checkpoint, 1, 1, 1, 1, 1,
        0, 1, digest(10), zero_digest(),
        digest(70), digest(70), digest(20),
    ) {
        Some(value) => value,
        None => return false,
    }
    let receipt = consume_verified_epoch_transparency(verified)
    close_host_epoch_transparency_receipt(receipt) == 1
}

fn main() -> i64 with IO, LoomWitnessEpochTransparencyHostTrust, Panic {
    let accepted = host_epoch_transparency_frame_accepts(
        1, 1, 1, 1, 1, 1, 1, 1, 1, 3, 4,
        1, 2, 0, 1, 1, 1, 1,
        101, 202, 301, 302, 303, 304,
        digest(10), digest(10), zero_digest(), zero_digest(),
        digest(70), digest(70), digest(20), digest(20),
        digest(30), digest(40), digest(50), digest(60),
    )
    let unreachable_refused = !host_epoch_transparency_frame_accepts(
        1, 0, 1, 1, 1, 1, 1, 1, 1, 3, 4,
        1, 2, 0, 1, 1, 1, 1,
        101, 202, 301, 302, 303, 304,
        digest(10), digest(10), zero_digest(), zero_digest(),
        digest(70), digest(70), digest(20), digest(20),
        digest(30), digest(40), digest(50), digest(60),
    )
    if !accepted || !unreachable_refused || !linear_transparency_case() {
        return 1
    }
    println("loom-witness-epoch-transparency-typestate: PASS linear=1 handoff=1 checkpoint=1 transparency=1 host_receipt=1")
    0
}
