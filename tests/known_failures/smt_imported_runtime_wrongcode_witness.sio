use theorem::smt::*
fn main() -> i32 with IO, Mut, Div {
    println("Before T1")
    var ctx = smt_new()
    println("After smt_new")
    var c1: [i32; 8] = [0 as i32; 8]
    c1[0] = 0
    c1[1] = 2
    println("Before smt_add_clause 1")
    smt_add_clause(&! ctx, &c1, 2)
    println("After smt_add_clause 1")
    var c2: [i32; 8] = [0 as i32; 8]
    c2[0] = 1
    c2[1] = 2
    println("Before smt_add_clause 2")
    smt_add_clause(&! ctx, &c2, 2)
    println("After smt_add_clause 2")
    let t1 = smt_solve(&! ctx)
    println("After smt_solve")
    return 0
}
