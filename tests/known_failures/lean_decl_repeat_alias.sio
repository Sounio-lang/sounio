//@ run-pass — RESOLVED 2026-07-05 (runtime-loop decl-init): typed decl-init
// repeat `var r: [Inner; N] = [V; N]` now emits a RUNTIME loop (O(1) code
// per decl) that heap-allocs and copies one fresh element per slot from the
// once-compiled V, on BOTH lanes. History: x86 splatted one shared pointer
// (aliasing), a64 ignored V and zero-filled (null pointers); the first fix
// attempt (compile-time per-element unrolling) exploded Madaros +11MB at
// [T;1024] scale and was reverted — the loop emission is the durable form.
struct Inner { a: i64, b: i64 }
fn mk() -> Inner { Inner { a: 1, b: 2 } }
fn main() -> i64 with IO, Mut, Panic, Div {
    var r: [Inner; 3] = [mk(); 3]
    r[0 as usize].a = 99
    var fails: i64 = 0
    if r[0 as usize].a != 99 { fails = fails + 1 }
    if r[1 as usize].a != 1 { fails = fails + 1 }
    if r[2 as usize].a != 1 { fails = fails + 1 }
    if fails == 0 { print("ALIAS_W PASS\n") } else { print("ALIAS_W FAIL\n") }
    return fails
}
