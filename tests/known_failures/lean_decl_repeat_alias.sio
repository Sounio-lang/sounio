//@ known-failure (BOTH lanes): typed decl-init repeat aliasing.
// x86 splats ONE materialized element pointer; a64 zero-fills (nulls).
// DESIGN CONSTRAINT discovered 2026-07-05: the naive per-element
// recompile+materialize fix EXPLODES emitted code on large arrays
// (Madaros itself declares [T; 1024]-scale locals; the trial seed grew
// +11MB and the built Madaros segfaulted). The proper fix must emit a
// RUNTIME loop (labels + branch) doing alloc+copy per slot in O(1) code.
// Witness: TYPED decl-init repeat `var r: [Inner; N] = [V; N]` splats ONE
// element pointer across all slots (rep-stosq of the same materialized V),
// so writing through r[0] mutates r[1]/r[2] — element aliasing. The
// expression-context literal was fixed to per-element heap copies
// (9203671c0/341014ec7); this covers the typed-decl path.
struct Inner { a: i64, b: i64 }
fn mk() -> Inner { Inner { a: 1, b: 2 } }
fn main() -> i64 with IO, Mut, Panic, Div {
    var r: [Inner; 3] = [mk(); 3]
    r[0 as usize].a = 99
    var fails: i64 = 0
    if r[0 as usize].a != 99 { fails = fails + 1 }
    if r[1 as usize].a != 1 { fails = fails + 1 }
    if r[2 as usize].a != 1 { fails = fails + 1 }
    if fails == 0 { print("ALIAS_W PASS\n") } else { print("ALIAS_W FAIL\n") }
    return fails
}
