//@ known-failure: auto-deref on a Box<T> PARAMETER is miscompiled by Madaros — a scalar field
//@ known-failure: reads 0 instead of the stored value (exit 0, silent), a struct field SIGSEGVs.
//@ known-failure: The explicit forms (*b).tag and (*b).span are both CORRECT, and lean_single
//@ known-failure: compiles all four shapes correctly, so this is Madaros-only.
//@ known-failure:
//@ known-failure: Root cause located, not fixed: the read path asks only whether the FIELD is
//@ known-failure: pointer-typed (ir/lower.sio field_is_pointer_for_base_ref), never whether the
//@ known-failure: BASE itself is a Box. For `b: Box<Ex>`, lookup_local_struct_type(b) returns
//@ known-failure: "Box" (lower_param_struct_type_name keeps the outer name), no struct named
//@ known-failure: "Box" exists, so no deref is emitted and the offset is applied to the pointer.
//@ known-failure: Fixing it needs the INNER type name as well as the box marker, which the
//@ known-failure: locals table does not carry today.
//@ known-failure:
//@ known-failure: This is not academic: parser/exprs.sio:1333 does exactly this
//@ known-failure: (`let start = base.span`, base: Box<Expr>) in parse_dot_expr_box.

struct Sp {
    a: i64,
    b: i64,
}

struct Ex {
    kind: i64,
    span: Sp,
    tag: i64,
}

fn mk() -> Ex {
    Ex { kind: 3, span: Sp { a: 111, b: 222 }, tag: 9 }
}

fn scalar_autoderef(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    b.tag
}

fn scalar_explicit(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    (*b).tag
}

fn struct_autoderef(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    let s = b.span
    s.a
}

fn struct_explicit(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    let s = (*b).span
    s.a
}

fn main() with IO, Mut, Panic, Div, Alloc {
    print_int(scalar_explicit(Box::new(mk())))
    print_int(struct_explicit(Box::new(mk())))
    println(" <- 9 and 111: the explicit forms, correct today")
    print_int(scalar_autoderef(Box::new(mk())))
    println(" <- expects 9, Madaros prints 0")
    print_int(struct_autoderef(Box::new(mk())))
    println(" <- expects 111, Madaros SIGSEGVs before here")
}
