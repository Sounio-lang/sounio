//@ run-pass
// Witness: &! borrow of a Box<T> PARAMETER (not an array element). This is
// the pattern from the historic bug report:
//   ir_patch_validated_calls_in_function(..., &! (*module).functions[i], ...)
// where a &! Box<T> parameter's field write/read read back garbage. Here we
// isolate just the "&! Box<Holder> param, single field write" shape without
// any array indexing, to see whether the bug is specific to the array-of-
// aggregate case or affects &! Box<T> params generally.
//
// STATUS: does not typecheck under the current seed (SKIP per task spec —
// 3 syntax variants tried: (*hb).n deref, bare hb.n, and an explicit
// `var hb: Box<Holder>` annotation). All fail identically at the call site
// `poke(&! hb)` with "error[E001]: Type mismatch in call argument" —
// call_arg_type_compatible() (lean_single.sio ~L3013) has no coercion rule
// for an expected &!T (exclusive-ref) parameter at all (only expected &T
// shared-ref has an auto-ref/downgrade rule, ~L3033-3046), so `&! hb` is
// never accepted as ty_eq to the declared &! Box<Holder> param regardless
// of hb's inferred type. This looks like a distinct, narrower gap (missing
// call-arg compatibility rule for &!Box<T>) rather than the aggregate-array-
// element codegen bug this file set is otherwise probing. See
// self-hosted/compiler/module_frontend.sio:1279-1281 and :1736-1737 for a
// pre-existing production workaround: functions are declared to take
// `&! IrModule` (not `&! Box<IrModule>`) and callers materialize the
// reference via `&! (*acc_box)` at the call site.

struct Holder { arr: [i64; 4], n: i64 }

fn poke(hb: &! Box<Holder>) with Mut {
    (*hb).n = 77
}

fn make_holder() -> Holder {
    Holder { arr: [0; 4], n: 0 }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var hb = Box::new(make_holder())
    poke(&! hb)

    if (*hb).n == 77 {
        print("W5 PASS\n")
        0
    } else {
        print("W5 FAIL n=")
        print_int((*hb).n)
        print("\n")
        1
    }
}
