//@ compile-fail (BY DESIGN, diagnosed since 2026-07-05): `&! Box<T>`
// parameters are unsupported — borrows auto-deref boxes (`&! hb` yields
// `&! T`), so this parameter shape can never be satisfied. The compiler now
// emits the targeted guidance error instead of a generic E001:
//   "E001: &! Box<T> params unsupported by design; declare &! T"
// Production code declares `&! T` and callers pass `&! var` / `&! (*box)`.
struct Holder { arr: [i64; 4], n: i64 }

fn poke(hb: &! Box<Holder>) with Mut {
    (*hb).n = 77
}

fn make_holder() -> Holder {
    Holder { arr: [0; 4], n: 0 }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var hb = Box::new(make_holder())
    poke(&! hb)

    if (*hb).n == 77 {
        print("W5 PASS\n")
        0
    } else {
        print("W5 FAIL n=")
        print_int((*hb).n)
        print("\n")
        1
    }
}
