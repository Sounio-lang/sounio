//@ run-pass
// Witness: read-only &borrow of an AGGREGATE array element. Tests whether
// the suspected slot-address-vs-heap-pointer bug also affects the shared
// (non-mutable) borrow path, or only the &! exclusive path.

struct Inner { a: i64, b: i64, c: i64 }
struct Holder { arr: [Inner; 4], n: i64 }

fn total(e: &Inner) -> i64 with Panic, Div {
    e.a + e.b
}

fn zero_inner() -> Inner {
    Inner { a: 0, b: 0, c: 0 }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var h = Holder { arr: [zero_inner(); 4], n: 0 }

    var i: i64 = 0
    while i < 4 {
        h.arr[i as usize].a = i
        h.arr[i as usize].b = 10 * i
        h.arr[i as usize].c = 99
        i = i + 1
    }

    var sum: i64 = 0
    var expected: i64 = 0
    i = 0
    while i < 4 {
        sum = sum + total(&h.arr[i as usize])
        expected = expected + i + 10 * i
        i = i + 1
    }

    if sum == expected {
        print("W4 PASS\n")
        0
    } else {
        print("W4 FAIL sum=")
        print_int(sum)
        print(" expected=")
        print_int(expected)
        print("\n")
        1
    }
}
