//@ RESOLVED 2026-07-05 (a64 struct-literal copy-direction fix, 35fb7c908): now prints the correct value on Apple Silicon. Kept as an a64 soak regression probe. Original defect: prints a pointer-looking value
// (e.g. 6132921600) instead of 7 — the a64 READ path for aggregate array
// elements returns the slot pointer as the value. exit 0 (silent wrong
// output). Found by the 2026-07-05 real-hardware a64 soak. x86 lane: PASS.
struct Inner { a: i64, b: i64, iarr: [i64; 3] }
struct Holder { aarr: [Inner; 3], s: i64 }
fn main() -> i64 with IO, Mut, Div, Panic {
    var h = Holder { aarr: [ Inner { a: 1, b: 2, iarr: [0, 0, 0] }, Inner { a: 3, b: 4, iarr: [0, 0, 0] }, Inner { a: 5, b: 6, iarr: [7, 8, 9] } ], s: 10 }
    print_int(h.aarr[2 as usize].iarr[0 as usize])
    return 0
}
