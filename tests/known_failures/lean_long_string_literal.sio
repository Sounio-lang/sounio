//@ run-pass — RESOLVED 2026-07-05 (jmp rel32 for inline string values):
// a string literal >= 127 bytes used as a VALUE (function argument, let
// binding) was skipped with `jmp rel8`, whose max forward reach is +127 —
// slen+1 >= 128 wrapped NEGATIVE and execution jumped backward into
// garbage (SIGSEGV). Found when a ~170-char diagnostic message crashed the
// self-compiled compiler. Direct print() was immune (qword-packed push
// emitter). Also added: clean rejection of literals > 256 bytes (the SQW
// decode buffer bound; overflow used to clobber adjacent globals and
// produce phantom parse errors).
fn takes(m: str) -> i64 with IO { print(m); print("\n"); return 1 }
fn main() -> i64 with IO, Mut, Panic, Div {
    let r1 = takes("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")
    if r1 != 1 { return 1 }
    print("LONGSTR PASS\n")
    return 0
}
