//@ RESOLVED 2026-07-05 (a64 struct-literal copy-direction fix, 35fb7c908): now prints the correct value on Apple Silicon. Kept as an a64 soak regression probe. Original defect: prints 3 instead of 5 (indexed read
// of a scalar array struct-field returns the wrong element) and SIGBUS (exit
// 138) on the return path. Found by the 2026-07-05 real-hardware a64 soak on
// macOS 27 / Apple Silicon. x86 lane: PASS. See
// docs/audit/SEED_GENERAL_PLACE_RESOLVER_2026-07-05.md (a64 soak section).
struct Inner { a: i64, b: i64, iarr: [i64; 3] }
fn main() -> i64 with IO, Mut, Div, Panic {
    var x = Inner { a: 1, b: 2, iarr: [3, 4, 5] }
    print_int(x.iarr[2 as usize])
    return 0
}
