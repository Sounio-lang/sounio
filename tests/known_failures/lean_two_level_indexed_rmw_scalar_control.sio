//@ run-pass
// Control witness for lean_two_level_indexed_rmw_aggregate.sio: identical
// loop shape and two-level indexed store, but the leaf array element type
// is a scalar (i64) rather than an aggregate. Expected to PASS -- scalar
// leaf arrays are hypothesized to be handled correctly by lean_single,
// unlike the aggregate-leaf case.

struct Mid {
    arr2: [i64; 4],
    pad: i64,
}

struct Outer {
    arr1: [Mid; 4],
    count: i64,
}

fn zero_mid() -> Mid {
    Mid { arr2: [0; 4], pad: 0 }
}

fn zero_outer() -> Outer {
    Outer { arr1: [zero_mid(); 4], count: 0 }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var o = zero_outer()

    var fi: i64 = 0
    while fi < 4 {
        var ii: i64 = 0
        while ii < 4 {
            var v = o.arr1[fi as usize].arr2[ii as usize]
            v = fi * 10 + ii
            o.arr1[fi as usize].arr2[ii as usize] = v
            ii = ii + 1
        }
        fi = fi + 1
    }

    var mismatches: i64 = 0
    fi = 0
    while fi < 4 {
        var ii: i64 = 0
        while ii < 4 {
            let got = o.arr1[fi as usize].arr2[ii as usize]
            let exp = fi * 10 + ii
            if got != exp { mismatches = mismatches + 1 }
            ii = ii + 1
        }
        fi = fi + 1
    }

    if mismatches == 0 {
        print("W_B PASS\n")
        0
    } else {
        print("W_B FAIL mismatches=")
        print_int(mismatches)
        print("\n")
        1
    }
}
