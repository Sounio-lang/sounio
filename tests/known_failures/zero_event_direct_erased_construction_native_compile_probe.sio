use epistemic::zero_event::*

fn main() with Panic {
    let forged = ErasedZeroF64 {
        value_f64: 0.0,
        source_evidence_flags: ze_flag_unknown(),
        discharge_reason_tag: ze_discharge_reason_display(),
        discharge_present: true,
    }
    let _raw = ze_erased_value_f64(forged)
}
