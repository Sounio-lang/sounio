//@ run-pass — RESOLVED 2026-07-05: expression-context aggregate repeat
// literal now materializes pointer-per-slot heap elements, and the flat
// field[i][j] store handler was retired in favor of the general place
// engine (kind-2 materialize). Kept as the 2-D grid regression witness.
// Witness: direct double-indexed store on a single 2-D array field,
// `h.grid[i][j] = v`, where the leaf element type is an AGGREGATE. This
// syntax (`[[T; N]; M]` field type with `field[i][j] = v` store) is used
// for scalar leaves elsewhere in this codebase (e.g. bootstrap_stage1.sio
// block_succs/dom_frontier tables). Here we exercise it with an aggregate
// leaf, reusing the same transient local across all iterations, to check
// whether the same aliasing hazard suspected in the two-level indexed
// field (arr1[i].arr2[j]) case also appears for a single doubly-indexed
// field.

struct Inner {
    a: i64,
    b: i64,
    c: i64,
}

struct Holder {
    grid: [[Inner; 3]; 3],
}

fn zero_inner() -> Inner {
    Inner { a: 0, b: 0, c: 0 }
}

fn zero_row() -> [Inner; 3] {
    [zero_inner(); 3]
}

fn zero_holder() -> Holder {
    Holder { grid: [zero_row(); 3] }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var h = zero_holder()

    var i: i64 = 0
    while i < 3 {
        var j: i64 = 0
        while j < 3 {
            var ins = h.grid[i as usize][j as usize]
            ins.a = i * 10 + j
            ins.b = 100 + i
            ins.c = 200 + j
            h.grid[i as usize][j as usize] = ins
            j = j + 1
        }
        i = i + 1
    }

    var mismatches: i64 = 0
    i = 0
    while i < 3 {
        var j: i64 = 0
        while j < 3 {
            let got = h.grid[i as usize][j as usize]
            let exp_a = i * 10 + j
            let exp_b = 100 + i
            let exp_c = 200 + j
            if got.a != exp_a { mismatches = mismatches + 1 }
            if got.b != exp_b { mismatches = mismatches + 1 }
            if got.c != exp_c { mismatches = mismatches + 1 }
            j = j + 1
        }
        i = i + 1
    }

    if mismatches == 0 {
        print("W_C PASS\n")
        0
    } else {
        print("W_C FAIL mismatches=")
        print_int(mismatches)
        print("\n")
        1
    }
}
