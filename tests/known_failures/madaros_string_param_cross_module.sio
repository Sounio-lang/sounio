//@ known-failure (default/Madaros lane, imported compile): calling an
// IMPORTED fn whose signature takes a builtin `string` parameter crashes
// (SIGSEGV, null-base indexed load) at the call site, before the callee
// body runs. Isolated 2026-07-06 from the EISA-on-default campaign:
//   - str_new() imported (Str return, no params): OK
//   - str_from_i64(42) imported (i64 param, Str return): OK  -> by-value
//     large-struct SRET across modules is FINE
//   - str_from_literal("abc") imported (string param): SIGSEGV
// => the defect is the builtin-string parameter ABI across the module
// boundary in the default lane's imported pipeline (caller passes one
// shape, callee reads another). lean_single lane: all green.
// This underlies the "default lane known wrong-code on imported struct
// chains" annotation in the EISA tests: every red EISA witness reaches a
// str::lib call with a string literal (receipts, f64bits_to_str, ...).
use str::lib::*
fn main() -> i64 with IO, Mut, Div, Panic {
    print("PRE\n")
    let a = str_from_literal("abc")
    if a.len == 3 { print("STRPARAM PASS\n"); return 0 }
    print("STRPARAM FAIL\n")
    return 1
}
