//@ run-pass
// Control witness for lean_borrow_aggregate_array_elem.sio: &! borrow of a
// SCALAR array element (same struct-field-array shape as the aggregate
// witness, just with an i64 element instead of a struct element). Scalar
// arrays are stored inline in lean_single, so slot address == element
// address and this pattern is expected to PASS.
//
// Note: `&! bare_local_array[i]` (no enclosing struct) is not accepted by
// the parser at all -- it is only special-cased for Seq (VAR_TY==12), not
// fixed-size arrays (VAR_TY==8) -- see lean_single.sio ~L9536-9566/~L9613.
// So this control mirrors W1's struct-field-array shape exactly, changing
// only the element type, to isolate the scalar-vs-aggregate variable.

struct SHolder { arr: [i64; 4], n: i64 }

fn bump(e: &! i64) with Mut {
    *e = *e + 100
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var h = SHolder { arr: [0; 4], n: 0 }

    var i: i64 = 0
    while i < 4 {
        h.arr[i as usize] = 10 * i
        i = i + 1
    }

    i = 0
    while i < 4 {
        bump(&! h.arr[i as usize])
        i = i + 1
    }

    var mismatches: i64 = 0
    i = 0
    while i < 4 {
        let got = h.arr[i as usize]
        if got != 10 * i + 100 { mismatches = mismatches + 1 }
        i = i + 1
    }

    if mismatches == 0 {
        print("W2 PASS\n")
        0
    } else {
        print("W2 FAIL mismatches=")
        print_int(mismatches)
        print("\n")
        1
    }
}
