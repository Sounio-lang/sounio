//@ run-pass
// Witness: same aggregate-array-element &! borrow bug as
// lean_borrow_aggregate_array_elem.sio, but the Holder lives behind a Box
// (heap-allocated) to check whether an extra pointer indirection changes the
// codegen path for `&! (*hb).arr[i]`.

struct Inner { a: i64, b: i64, c: i64 }
struct Holder { arr: [Inner; 4], n: i64 }

fn bump(e: &! Inner) with Mut {
    e.a = e.a + 100
    e.b = e.b + 200
}

fn zero_inner() -> Inner {
    Inner { a: 0, b: 0, c: 0 }
}

fn make_holder() -> Holder {
    Holder { arr: [zero_inner(); 4], n: 0 }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var hb = Box::new(make_holder())

    var i: i64 = 0
    while i < 4 {
        (*hb).arr[i as usize].a = i
        (*hb).arr[i as usize].b = 10 * i
        (*hb).arr[i as usize].c = 99
        i = i + 1
    }

    i = 0
    while i < 4 {
        bump(&! (*hb).arr[i as usize])
        i = i + 1
    }

    var mismatches: i64 = 0
    i = 0
    while i < 4 {
        let got = (*hb).arr[i as usize]
        if got.a != i + 100 { mismatches = mismatches + 1 }
        if got.b != 10 * i + 200 { mismatches = mismatches + 1 }
        if got.c != 99 { mismatches = mismatches + 1 }
        i = i + 1
    }

    if mismatches == 0 {
        print("W3 PASS\n")
        0
    } else {
        print("W3 FAIL mismatches=")
        print_int(mismatches)
        print("\n")
        1
    }
}
