//@ known-failure: Madaros miscompiles auto-deref through a Box<T>. A scalar field reads 0 with
//@ known-failure: EXIT 0, a struct field SIGSEGVs; the explicit (*b) forms are correct, and
//@ known-failure: lean_single compiles all ten assertions below correctly (BOXMATRIX OK).
//@ known-failure:
//@ known-failure: MECHANISM, established: IrFieldGet carries label_id, which is how the lowerer
//@ known-failure: signals "the base is a reference" (lower.sio, `if base_is_ref { instr.label_id = 1 }`).
//@ known-failure: machine_ir.sio:516 lowers IrFieldGet to MIR_OP_PSEUDO_FIELD_GET with dst, src1 and
//@ known-failure: field_idx ONLY — label_id is never propagated, so that flag reaches no instruction.
//@ known-failure: What actually breaks is the FIELD INDEX: lookup_local_struct_type returns the
//@ known-failure: literal "Box" for a Box local/param, no struct by that name exists, so
//@ known-failure: field_idx_for_base_ref falls back to a by-name search and resolves the wrong slot.
//@ known-failure: A correct fix needs the deref step (field_get(base, 0), the same step
//@ known-failure: fd0fb03f3 added one level down for Box-typed FIELDS) plus the index resolved
//@ known-failure: against T.
//@ known-failure:
//@ known-failure: WHY THE SLOT CANNOT SIMPLY HOLD T: twelve sites read lookup_local_struct_type and
//@ known-failure: two test it with ir_name_is_box — the explicit `*b` deref (lower_unary_expr_ref)
//@ known-failure: and the `*p = v` store path. Measured: recording T there repairs all five read
//@ known-failure: forms and SIGSEGVs on the first line of this file, i.e. it breaks `(*b)`.
//@ known-failure:
//@ known-failure: FOUR ATTEMPTS, all built and measured, all reverted. Every one of them fixed the
//@ known-failure: five read forms (99 / 111111 / 99 / 111 / 99, all correct) and every one broke a
//@ known-failure: program that reads NO field at all:
//@ known-failure:     fn takes_box(b: Box<Ex>) -> i64 { 7 }   // no field read
//@ known-failure:     takes_box(Box::new(mk()))  then  let x = mk()   -> SIGSEGV
//@ known-failure: which the unpatched compiler runs correctly. Refuted causes:
//@ known-failure:   1. is_ref as the carrier            — label_id is not propagated (read the backend)
//@ known-failure:   2. a [Name; 4096] size cliff (295KB) — a [i64; 4096] version breaks identically
//@ known-failure:   3. a struct-valued if-expression store — statement stores break identically
//@ known-failure:   4. a by-value `self` method reached through `&! Lowerer` — a free function taking
//@ known-failure:      the layout table by reference breaks identically
//@ known-failure: A DEAD [i64; 4096] array added to LowerLocalStack and never read or written
//@ known-failure: changes nothing, so declaring a slot is safe; something about writing it at param
//@ known-failure: bind time or reading it at the field-access site is not. That is the open question.
//@ known-failure:
//@ known-failure: WHY IT MATTERS: 174 auto-deref accesses on Box-typed names live in the compiler's
//@ known-failure: own source, 162 of them in ir/lower.sio, 6 in parser/exprs.sio (including
//@ known-failure: `let start = base.span` in parse_dot_expr_box). They are correct today only
//@ known-failure: because lean_single compiles them. A Madaros-built Madaros inherits the
//@ known-failure: miscompile, so this sits directly on the gen1 == gen2 path.

struct Sp {
    a: i64,
    b: i64,
}

struct Ex {
    kind: i64,
    span: Sp,
    tag: i64,
}

struct HolderInline {
    inner: Ex,
    n: i64,
}

struct HolderBox {
    inner: Box<Ex>,
    n: i64,
}

fn mk() -> Ex {
    Ex { kind: 3, span: Sp { a: 111, b: 222 }, tag: 9 }
}

fn p_scalar_auto(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    b.tag
}

fn p_scalar_expl(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    (*b).tag
}

fn p_struct_auto(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    let s = b.span
    s.a
}

fn p_struct_expl(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    let s = (*b).span
    s.a
}

fn p_ref(e: &Ex) -> i64 with Mut, Panic, Div {
    e.tag
}

fn check(got: i64, want: i64, ok: bool) -> bool with IO, Mut, Panic, Div {
    if got == want {
        return ok
    }
    print("MISMATCH got=")
    print_int(got)
    print(" want=")
    print_int(want)
    print("\n")
    false
}

fn main() with IO, Mut, Panic, Div, Alloc {
    var ok = true
    ok = check(p_scalar_expl(Box::new(mk())), 9, ok)
    ok = check(p_scalar_auto(Box::new(mk())), 9, ok)
    ok = check(p_struct_expl(Box::new(mk())), 111, ok)
    ok = check(p_struct_auto(Box::new(mk())), 111, ok)
    let bl = Box::new(mk())
    ok = check((*bl).tag, 9, ok)
    let bl1 = Box::new(mk())
    ok = check(bl1.tag, 9, ok)
    let bl2 = Box::new(mk())
    let s2 = bl2.span
    ok = check(s2.a, 111, ok)
    var hi: HolderInline = HolderInline { inner: mk(), n: 1 }
    var hb: HolderBox = HolderBox { inner: Box::new(mk()), n: 2 }
    ok = check(hi.inner.tag, 9, ok)
    ok = check(hb.inner.tag, 9, ok)
    let x = mk()
    ok = check(p_ref(&x), 9, ok)
    if ok {
        println("BOXMATRIX OK")
    } else {
        println("BOXMATRIX FAIL")
    }
}
