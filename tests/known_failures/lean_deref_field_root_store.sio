//@ run-pass — RESOLVED 2026-07-05 (deref-of-field-chain roots in the place
// engine): `(*name.field).proj = v` silently DROPPED the store — the general
// assign scanner only knew `name` and `(*name)` roots, so the shape fell to
// the wrong path. Found by the lower.sio band-aid reversion proof (SMT tests
// hung: loop break labels written via `(*lo.loop_labels).brk[d] = l` were
// never recorded). The engine now walks the inner field chain with the
// intermediate rules, always entering pointer-like cells.
struct Labels { cont: [i64; 8], brk: [i64; 8] }
struct Lo { depth: i64, labels: Box<Labels> }
fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var lo = Lo { depth: 2, labels: Box::new(Labels { cont: [0; 8], brk: [0; 8] }) }
    (*lo.labels).brk[lo.depth as usize] = 77
    if (*lo.labels).brk[2 as usize] == 77 {
        print("DEREF_FIELD_ROOT PASS\n")
        return 0
    }
    print("DEREF_FIELD_ROOT FAIL\n")
    return 1
}
