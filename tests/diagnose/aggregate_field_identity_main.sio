//@ ignore
// Receiver-layout discriminator for large arrays of structs.
//
// Arms:
//   direct: main calls the builder and reads the returned aggregate itself
//   nested: main calls a builder-module function which calls the builder
//   transitive: main -> boundary module -> builder module
//
// Every arm must preserve the same field identity and the untouched second
// array element. A nonzero exit code identifies the first divergent read.

use aggregate_field_identity_builder::{
    aggregate_field_build_candidates,
    aggregate_field_observe_same_module_nested,
}
use aggregate_field_identity_boundary::{aggregate_field_observe_transitive}

fn main() -> i64 with IO, Mut, Panic, Div {
    let (candidates, count) = aggregate_field_build_candidates()
    if count != 1 { return 11 }
    if candidates[0].len != 2 { return 12 }
    if candidates[0].payloads[0].data[0] != 222 { return 13 }
    if candidates[0].payloads[0].marker != 111 { return 14 }
    if candidates[0].buffers[0].ptr != 333 { return 15 }
    if candidates[0].buffers[0].cap != 444 { return 16 }
    if candidates[0].buffers[0].weight != 4.5 { return 17 }
    if candidates[0].buffers[0].samples[1] != 6.25 { return 18 }
    if candidates[1].len != 0 { return 19 }

    let nested = aggregate_field_observe_same_module_nested()
    if nested != 0 { return nested }

    let transitive = aggregate_field_observe_transitive()
    if transitive != 0 { return transitive }

    println("AGGREGATE_FIELD_IDENTITY_OK")
    0
}
