//@ ignore
// Transitive module boundary for aggregate_field_identity_main.sio.

use aggregate_field_identity_builder::{aggregate_field_build_candidates}

pub fn aggregate_field_observe_transitive() -> i64 with Mut, Panic {
    let (candidates, count) = aggregate_field_build_candidates()
    if count != 1 { return 31 }
    if candidates[0].len != 2 { return 32 }
    if candidates[0].payloads[0].data[0] != 222 { return 33 }
    if candidates[0].payloads[0].marker != 111 { return 34 }
    if candidates[0].buffers[0].ptr != 333 { return 35 }
    if candidates[0].buffers[0].cap != 444 { return 36 }
    if candidates[0].buffers[0].weight != 4.5 { return 37 }
    if candidates[0].buffers[0].samples[1] != 6.25 { return 38 }
    if candidates[1].len != 0 { return 39 }
    0
}
