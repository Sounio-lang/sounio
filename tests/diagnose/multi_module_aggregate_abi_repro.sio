// Minimal reproducer for Task C: lean_single multi-module ABI bug
// Function ScanResult::with_text takes mixed aggregate params:
//   (Cursor=5 slots, TokenKind, i64, i64, [i8;256]=32 slots, i64) -> ScanResult=41 slots
// Accessing any field of the returned ScanResult crashes in multi-module mode.
// Expected output: a\nb kind=13\n
// Actual: crashes at print_int(result.kind as i64)
use lexer::mod::*
use lexer::cursor
use lexer::tables::*

fn main() -> i64 with IO, Mut, Panic, Div {
    var text: [i8; 256] = [0; 256]
    text[0] = 102 as i8
    let cur: Cursor = Cursor { source_len: 3, pos: 2, line: 1, col: 3, current: 32 as i8 }
    print("a\n")
    let result = ScanResult::with_text(cur, TokenKind::Fn, 0, 2, text, 2)
    print("b kind=")
    print_int(result.kind as i64)
    print("\n")
    0
}
