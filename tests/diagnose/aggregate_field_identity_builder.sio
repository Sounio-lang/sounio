//@ ignore
// Large aggregate builder for aggregate_field_identity_main.sio.
// One Payload is large enough that [Candidate; 16] is about 8 MiB, preserving
// the aggregate shape that exposed the lowering defect.

// Deliberately register the same field names at different indices before the
// real receiver layouts. A name-only field lookup would resolve `len`/`cap`
// against these decoys and read a plausible value from the wrong slot.
pub struct AggregateFieldLenDecoy {
    len: i32,
    pad0: i64,
    pad1: i64,
}

pub struct AggregateFieldCapDecoy {
    cap: i64,
    pad0: i64,
}

pub struct AggregateFieldWeightDecoy {
    weight: i64,
    pad0: i64,
}

pub struct AggregateFieldSamplesDecoy {
    samples: [i64; 2],
    pad0: i64,
}

pub struct AggregateFieldPayload {
    data: [i64; 5760],
    marker: i64,
}

pub struct AggregateFieldBuffer {
    ptr: i64,
    cap: i64,
    weight: f64,
    samples: [f64; 2],
}

pub struct AggregateFieldCandidate {
    payloads: [AggregateFieldPayload; 11],
    buffers: [AggregateFieldBuffer; 11],
    len: i32,
}

fn payload_zero() -> AggregateFieldPayload {
    AggregateFieldPayload { data: [0; 5760], marker: 0 }
}

fn buffer_zero() -> AggregateFieldBuffer {
    AggregateFieldBuffer { ptr: 0, cap: 0, weight: 0.0, samples: [0.0; 2] }
}

fn candidate_zero() -> AggregateFieldCandidate {
    AggregateFieldCandidate {
        payloads: [payload_zero(); 11],
        buffers: [buffer_zero(); 11],
        len: 0,
    }
}

pub fn aggregate_field_build_candidates() -> ([AggregateFieldCandidate; 16], i32) with Mut, Panic {
    var candidates: [AggregateFieldCandidate; 16] = [candidate_zero(); 16]
    var candidate = candidate_zero()
    candidate.payloads[0].data[0] = 222
    candidate.payloads[0].marker = 111
    candidate.buffers[0].ptr = 333
    candidate.buffers[0].cap = 444
    candidate.buffers[0].weight = 4.5
    candidate.buffers[0].samples[1] = 6.25
    candidate.len = 2
    candidates[0] = candidate
    (candidates, 1)
}

// Cross-module caller -> this function -> same-module large aggregate return.
pub fn aggregate_field_observe_same_module_nested() -> i64 with Mut, Panic {
    let (candidates, count) = aggregate_field_build_candidates()
    if count != 1 { return 21 }
    if candidates[0].len != 2 { return 22 }
    if candidates[0].payloads[0].data[0] != 222 { return 23 }
    if candidates[0].payloads[0].marker != 111 { return 24 }
    if candidates[0].buffers[0].ptr != 333 { return 25 }
    if candidates[0].buffers[0].cap != 444 { return 26 }
    if candidates[0].buffers[0].weight != 4.5 { return 27 }
    if candidates[0].buffers[0].samples[1] != 6.25 { return 28 }
    if candidates[1].len != 0 { return 29 }
    0
}
