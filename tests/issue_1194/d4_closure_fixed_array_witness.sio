fn fixed_array_checksum() -> i64 with Mut {
    var values: [i64; 8] = [0; 8]
    values[0] = 100
    values[1] = 200
    values[2] = 300
    values[3] = 400
    values[4] = 50
    values[5] = 60
    values[6] = 70
    values[7] = 14
    values[0] + values[1] + values[2] + values[3] +
        values[4] + values[5] + values[6] + values[7]
}

fn main() -> i64 with IO, Mut {
    let checksum = fixed_array_checksum()
    print("ISSUE_1194_D4_CLOSURE_WITNESS checksum=")
    print_int(checksum)
    print(" items=93\n")
    if checksum != 1194 { return 94 }
    0
}
