//@ run-pass
// E2E tests for stdlib/queue

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0

    print("Test 01: queue basic test... ")
    print("PASS\n")
    pass = pass + 1

    if fail == 0 {
        print("stdlib_queue: ALL PASS (")
        print(pass)
        print("/1)\n")
        0
    } else {
        print("stdlib_queue: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}