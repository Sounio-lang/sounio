//@ run-pass
// E2E tests for stdlib/queue

use queue::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0
    var q = queue_new()

    print("Test 01: queue_new... ")
    if queue_size(&q) == 0 && queue_is_empty(&q) {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: queue_push... ")
    queue_push(&! q, 10)
    queue_push(&! q, 20)
    queue_push(&! q, 30)
    if queue_size(&q) == 3 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: queue_pop returns FIFO order... ")
    let v1 = queue_pop(&! q)
    let v2 = queue_pop(&! q)
    if v1 == 10 && v2 == 20 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL (v1=")
        print(v1)
        print(", v2=")
        print(v2)
        print(")\n")
        fail = fail + 1
    }

    print("Test 04: queue_pop remaining element... ")
    let v3 = queue_pop(&! q)
    if v3 == 30 && queue_is_empty(&q) {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: queue_pop on empty returns -1... ")
    let v4 = queue_pop(&! q)
    if v4 == -1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_queue: ALL PASS (")
        print(pass)
        print("/5)\n")
        0
    } else {
        print("stdlib_queue: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}