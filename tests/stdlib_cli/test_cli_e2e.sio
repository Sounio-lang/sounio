//@ run-pass
// E2E tests for stdlib/cli

use cli::pure::types

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0

    print("Test 01: args_new creates empty args... ")
    var a1 = args_new()
    if args_count(&a1) == 0 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 02: args_push increments count... ")
    var a2 = args_new()
    args_push(&! a2, "arg1")
    if args_count(&a2) == 1 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 03: args_push adds multiple args... ")
    var a3 = args_new()
    args_push(&! a3, "first")
    args_push(&! a3, "second")
    args_push(&! a3, "third")
    if args_count(&a3) == 3 {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 04: args_get retrieves first arg... ")
    var a4 = args_new()
    args_push(&! a4, "hello")
    args_push(&! a4, "world")
    let first = args_get(&a4, 0)
    if str_eq(first, "hello") {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    print("Test 05: args_get retrieves second arg... ")
    let second = args_get(&a4, 1)
    if str_eq(second, "world") {
        print("PASS\n") pass = pass + 1
    } else {
        print("FAIL\n") fail = fail + 1
    }

    if fail == 0 {
        print("stdlib_cli: ALL PASS (")
        print(pass)
        print("/5)\n")
        0
    } else {
        print("stdlib_cli: FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    run_tests()
}