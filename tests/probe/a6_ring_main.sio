// WP-A6 imported-lane effect-carry witness (W3), runnable end-to-end.
// Imports a module whose effect-carrying trait method lives on the (now
// imported => ty_unknown) `Frac` struct next to an effect-empty `i64` impl of
// the same trait. Pre-fix this failed type-check with
//   error[E035] ... (missing: Mut, Div, Panic)   on Frac::radd;
// post-fix it type-checks cleanly and returns 5.
use a6_ring_mod::{frac_add_num}

fn main() -> i64 with Mut, Div, Panic {
    frac_add_num(1, 2, 1, 3)   // n = 1*3 + 1*2 = 5 ; d = 2*3 = 6
}
