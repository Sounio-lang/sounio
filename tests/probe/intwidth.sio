//@ run-pass
// A7 witness: the Madaros merged type-checker coerces between narrow integer
// widths (i32<->i64) so an if-expression whose branches are i32 and i64 joins
// to the wider type instead of raising E007. Mirrors the last cd_exact blocker
// (stdlib/algebra/cayley_dickson.sio: `if bits <= 6 { bits } else { 7 }`).
fn f(bits: i32) -> i64 {
    // `bits` is i32, the literal 7 is i64 => branch-join must widen to i64.
    if bits <= 6 { bits } else { 7 }
}

fn main() with IO {
    let r: i64 = f(3)
    println(r)
}
