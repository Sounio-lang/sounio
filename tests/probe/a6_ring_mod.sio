// WP-A6 witness helper: an effect-carrying trait method implemented on an
// IMPORTED struct (`Frac`, bound to ty_unknown => empty name) ALONGSIDE an
// effect-empty impl of the same trait on the i64 builtin (also empty name).
// Pre-fix, the name-only impl-method sig lookup resolved `Frac::radd`'s body
// against the effect-empty `i64::radd`, leaving current_effects empty and
// firing a spurious `error[E035] ... (missing: Mut, Div, Panic)` on frac_add.
// All `Frac` VALUES stay inside this module (only i64 crosses the module
// boundary at runtime), so this exercises the type-checker fix without the
// separate cross-module struct-return codegen gap.
use a6_frac_def::{Frac}

fn frac_add(a: Frac, b: Frac) -> Frac with Mut, Div, Panic {
    Frac { n: a.n * b.d + b.n * a.d, d: a.d * b.d }
}

trait Ringy {
    fn radd(self, o: Self) -> Self with Mut, Div, Panic
}

impl Ringy for i64 {
    fn radd(self, o: Self) -> Self { self + o }
}

impl Ringy for Frac {
    fn radd(self, o: Self) -> Self with Mut, Div, Panic { frac_add(self, o) }
}

pub fn frac_add_num(an: i64, ad: i64, bn: i64, bd: i64) -> i64 with Mut, Div, Panic {
    let a = Frac { n: an, d: ad }
    let b = Frac { n: bn, d: bd }
    let c = frac_add(a, b)
    c.n
}
