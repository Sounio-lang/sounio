// WP-A6 witness: the struct whose identity is lost when IMPORTED. Defined here
// so that a6_ring_mod (which impls a trait on it) sees `Frac` only through a
// `use`, i.e. bound to ty_unknown() with an empty TypeEntry name — the exact
// shape (`use math::rational::{Rational}`) that made the imported-lane E035 fire.
pub struct Frac { n: i64, d: i64 }
