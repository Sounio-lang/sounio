// Madaros D6 acceptance: module-level const readable from non-main local fn.
// Historical bug: BSS scalar resolved to a stale local vreg outside `main`.
// Fix: ir_load_global reload of IR_STRATEGY_BSS_GLOBAL (lower.sio).

const C_A: i64 = 20

fn fill(a: &![i64; 704]) with Mut, Panic {
    a[64 + C_A] = 1
}

fn main() with IO, Mut, Panic {
    var a: [i64; 704] = [0; 704]
    fill(&!a)
    assert(a[84] == 1)
    assert(a[64] == 0)
    println("D6_CONST_NONMAIN_OK")
}
