// TRUSTWORTHY under default Madaros multi-module native import:
// epistemic::uncertain_eq (Bernoulli P(|a−b|<ε) + ep_decide + EqField).
//
// Historical map row "native-import-blocked" was driven by the run-pass driver
// missing `IO` on main (print → E035), not by a lowering defect in uncertain_eq.
// This witness imports the module and checks first-principles numbers (python
// math.erf cross-check to 1e-4 in the source header of uncertain_eq.sio).
use epistemic::knowledge::{Epistemic}
use epistemic::uncertain_eq::{ep_eq_prob, ep_decide, ep_eq_field}

fn approx_eq(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let c10 = Epistemic::measured(10.0, 0.0)
    let c13 = Epistemic::measured(13.0, 0.0)
    let m_tight = Epistemic::measured(10.0, 0.01)
    let m_mid = Epistemic::measured(10.0, 2.0)
    let m_wide = Epistemic::measured(10.0, 1000.0)
    let b6 = Epistemic::measured(13.0, 6.0)

    // both-certain corner
    if approx_eq(ep_eq_prob(&c10, &c10, 0.5), 1.0, 1e-12) == 0 { return 1 }
    if approx_eq(ep_eq_prob(&c10, &c13, 0.5), 0.0, 1e-12) == 0 { return 2 }

    // anti-footgun trio (Hellinger δ-catastrophe must stay gone)
    if approx_eq(ep_eq_prob(&c10, &m_mid, 0.5), 0.1974127, 1e-4) == 0 { return 3 }
    if approx_eq(ep_eq_prob(&c10, &m_tight, 0.5), 1.0, 1e-4) == 0 { return 4 }
    if approx_eq(ep_eq_prob(&c10, &m_wide, 0.5), 0.0003989, 1e-4) == 0 { return 5 }

    // named-threshold commitment
    if ep_decide(0.99, 0.95) == false { return 6 }
    if ep_decide(0.5, 0.95) { return 7 }

    // EqField diagnostic windows
    let ef = ep_eq_field(&m_mid, &b6, 0.5)
    if approx_eq(ef.p_equal, 0.0563211, 1e-4) == 0 { return 8 }
    if approx_eq(ef.hellinger, 0.5174665, 1e-4) == 0 { return 9 }
    if approx_eq(ef.w2, 5.0, 1e-9) == 0 { return 10 }
    if approx_eq(ef.z, 0.4743416, 1e-4) == 0 { return 11 }

    print("UNCERTAIN_EQ_TRUST_OK\n")
    return 0
}
