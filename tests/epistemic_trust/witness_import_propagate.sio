// Native-import witness: epistemic::propagate under default Madaros.
// Prints scaled micro-units (integers) so float print flakiness is avoided:
//   line1 product val     → 6000000   (2*3)
//   line2 product var     → 250000    (0.25)
//   line3 exp val         → 2718281   (e¹ ≈ 2.718281)  — literal import name `exp`
//   line4 exp var         → 73890     (e²·0.01 ≈ 0.073890)
//   line5 MC identity val → ~1000000  (mean ≈ 1.0; band-checked in gate)
//   line6 MC identity var → ~10000    (var  ≈ 0.01; band-checked in gate)
//   line7 MC square val   → ~4010000  (E[X²]≈4.01 for X~N(2,0.01))
//   line8 MC square var   → ~160000   (delta ≈ 0.16)
// Wave6 C: call-site name `exp` must run (not float-intrinsic hijack / SEGV).
use epistemic::knowledge::{Epistemic}
use epistemic::propagate::{product, exp, monte_carlo_identity, monte_carlo_square}

fn main() -> i32 with IO, Mut, Div, Panic, Prob {
    let a = Epistemic { val: 2.0, variance: 0.01, confidence: 900 }
    let b = Epistemic { val: 3.0, variance: 0.04, confidence: 900 }
    let p = product(a, b)
    print_int((p.val * 1000000.0) as i64)
    print("\n")
    print_int((p.variance * 1000000.0) as i64)
    print("\n")

    let x = Epistemic { val: 1.0, variance: 0.01, confidence: 900 }
    let e = exp(x)
    print_int((e.val * 1000000.0) as i64)
    print("\n")
    print_int((e.variance * 1000000.0) as i64)
    print("\n")

    let id = monte_carlo_identity(x, 5000)
    print_int((id.val * 1000000.0) as i64)
    print("\n")
    print_int((id.variance * 1000000.0) as i64)
    print("\n")

    let xs = Epistemic { val: 2.0, variance: 0.01, confidence: 900 }
    let sq = monte_carlo_square(xs, 8000)
    print_int((sq.val * 1000000.0) as i64)
    print("\n")
    print_int((sq.variance * 1000000.0) as i64)
    print("\n")
    return 0
}
