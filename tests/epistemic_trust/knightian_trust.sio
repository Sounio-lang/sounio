// Trust witness: epistemic::knightian (p-box) under native import (self-contained).
// pb_gap = hi-lo, pb_midpoint = (lo+hi)/2 for pb_new(2,3,...).
use epistemic::knightian::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let p = pb_new(2.0, 3.0, 0.25, 900)
    let g = pb_gap(&p)
    let dg = if g > 1.0 { g - 1.0 } else { 1.0 - g }
    if dg >= 1.0e-9 { print("FAIL gap\n"); return 1 }
    let m = pb_midpoint(&p)
    let dm = if m > 2.5 { m - 2.5 } else { 2.5 - m }
    if dm >= 1.0e-9 { print("FAIL midpoint\n"); return 2 }
    print("KNIGHTIAN_TRUST_OK\n")
    return 0
}
