// Local + open-slice .len() under default Madaros (D3 residual closeout).
fn slice_len(data: &[f64]) -> i64 {
    data.len()
}

fn main() with IO, Mut, Panic {
    var a: [f64; 4] = [1.0, 2.0, 3.0, 4.0]
    let n1 = a.len()
    let n2 = slice_len(&a)
    assert(n1 == 4)
    assert(n2 == 4)
    println(n1)
    println("D3_OPENSLICE_LEN_OK")
}
