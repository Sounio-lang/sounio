// Trust witness: epistemic::correlation under native import (self-contained).
// Covariance of two independent CorrelatedValues is exactly 0.
use epistemic::correlation::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let a = correlated_independent(10.0, 1.0, 0.9)
    let b = correlated_independent(20.0, 2.0, 0.9)
    let c = covariance(a, b)
    let ac = if c > 0.0 { c } else { 0.0 - c }
    if ac >= 1.0e-9 { print("FAIL cov\n"); return 1 }
    print("CORRELATION_TRUST_OK\n")
    return 0
}
