// Corruption witness: gum_k95 under native import. nu_eff=4.17 here, so the
// correct 95% coverage factor is t95(4)=2.776, but the f64->i64 cast bug
// (dof_to_i64) makes k95 collapse to 1.960. Prints k95*1000: 1960 = still
// corrupt, 2776 = fixed (then re-enable U95 columns and update the trust map).
use epistemic::gum::*
fn main() -> i32 with IO, Mut, Div, Panic {
    let r = gum_combine2(98.3, gum_type_a(0.070710, 5), gum_type_b_uniform(0.5))
    print_int((gum_k95(r) * 1000.0) as i64)
    print("\n")
    return 0
}
