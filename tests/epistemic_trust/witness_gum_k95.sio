// Trust witness: gum_k95 under native import with a Type-A-dominant budget.
//
// History: the original witness used gum_type_a(0.070710, 5) + gum_type_b_uniform(0.5).
// That Type-B dominates → nu_eff ≈ 2.8e4 → k95=1.960 is *correct* (normal tail), so the
// trip-wire could never flip when D1/#983 fixed. Escalation doc already noted this
// (MADAROS_IMPORTED_MODULE_NATIVE_PATH_ESCALATION_2026-07-14).
//
// Correct small-dof probe (Wave10): Type-A n=5 (ν=4) + negligible Type-B so
// Welch–Satterthwaite ν_eff stays ≈4 → t95(4)=2.776. Prints k95*1000 as integer:
//   2776 = Student-t coverage (TRUSTWORTHY)
//   1960 = old bitcast collapse (must not return under default Madaros)
//
// Measured on origin/main after #1252 (D5+D1) + gum dof_to_i64 arithmetic-source:
//   dof=4.000148 k95=2.775999 → 2776
use epistemic::gum::*
fn main() -> i32 with IO, Mut, Div, Panic {
    let r = gum_combine2(98.3, gum_type_a(0.30, 5), gum_type_b_uniform(0.001))
    print_int((gum_k95(r) * 1000.0) as i64)
    print("\n")
    return 0
}
