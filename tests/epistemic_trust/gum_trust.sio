// Trust witness: epistemic::gum under native import.
// value + u_c (Type-B-heavy budget) and finite-dof k95/U95 (Type-A-dominant budget).
// D1/#983 f64-param cast + stdlib dof_to_i64 arithmetic-source closed the coverage
// residual; Wave10 promotes k95/U95 into the gating set (was Section B trip-wire).
use epistemic::gum::*

fn main() -> i32 with IO, Mut, Div, Panic {
    // --- A. value + u_c (original Type-B-heavy budget; first-principles RSS) ---
    let r = gum_combine2(98.3, gum_type_a(0.070710, 5), gum_type_b_uniform(0.5))
    let v = gum_value(r)
    let dv = if v > 98.3 { v - 98.3 } else { 98.3 - v }
    if dv >= 1.0e-6 { print("FAIL value\n"); return 1 }
    let uc = gum_std_u(r)
    let du = if uc > 0.290402 { uc - 0.290402 } else { 0.290402 - uc }
    if du >= 1.0e-4 { print("FAIL u_c\n"); return 2 }

    // --- B. finite-dof coverage (Type-A dominant → ν_eff≈4 → t95=2.776) ---
    // Must NOT use a Type-B-dominant budget here: that correctly yields k=1.96 and
    // cannot detect the historical f64→i64 bitcast collapse.
    let r2 = gum_combine2(98.3, gum_type_a(0.30, 5), gum_type_b_uniform(0.001))
    let k = gum_k95(r2)
    let dk = if k > 2.776 { k - 2.776 } else { 2.776 - k }
    if dk >= 1.0e-3 { print("FAIL k95\n"); return 3 }
    // u95 = k95 * u_c; measured u_c≈0.134165 → U95≈0.372443
    let u95 = gum_u95(r2)
    let du95 = if u95 > 0.372443 { u95 - 0.372443 } else { 0.372443 - u95 }
    if du95 >= 1.0e-3 { print("FAIL u95\n"); return 4 }
    let dof = gum_dof(r2)
    let ddof = if dof > 4.0 { dof - 4.0 } else { 4.0 - dof }
    if ddof >= 1.0e-2 { print("FAIL dof\n"); return 5 }

    print("GUM_TRUST_OK\n")
    return 0
}
