// Trust witness: epistemic::gum under native import. value + u_c are TRUSTWORTHY;
// the coverage factor k95 is CORRUPTED (f64->i64 cast bug) and is asserted broken
// separately in the gate so a compiler fix flips the witness.
use epistemic::gum::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let r = gum_combine2(98.3, gum_type_a(0.070710, 5), gum_type_b_uniform(0.5))
    let v = gum_value(r)
    let dv = if v > 98.3 { v - 98.3 } else { 98.3 - v }
    if dv >= 1.0e-6 { print("FAIL value\n"); return 1 }
    let uc = gum_std_u(r)
    let du = if uc > 0.290402 { uc - 0.290402 } else { 0.290402 - uc }
    if du >= 1.0e-4 { print("FAIL u_c\n"); return 2 }
    print("GUM_TRUST_OK\n")
    return 0
}
