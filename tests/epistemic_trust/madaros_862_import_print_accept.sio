// tests/epistemic_trust/madaros_862_import_print_accept.sio
//
// #862 acceptance (D4): importing program with
//   - named single-symbol `use`
//   - user helper fn
//   - `print_f64`
// compiles and runs under default Madaros.
//
// Measured 2026-08-06 on shipped Madaros post-#1627 promote: green.
// (Builtin allow-list + named-import bind landed earlier in check.sio;
// this gate locks the acceptance triad.)
//
// Gate: scripts/ci/madaros_862_import_print_gate.sh

use epistemic::knowledge::ep_measured
use epistemic::knowledge::ep_val

fn twice(x: f64) -> f64 {
    x + x
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let x = ep_measured(5.0, 0.1)
    let y = twice(ep_val(&x))
    print_f64(y)
    print("\n")
    // y == 10.0 → scaled 10000000
    let yi = (y * 1000000.0) as i64
    if yi == 10000000 {
        print("MADAROS_862_ACCEPT_OK\n")
        0
    } else {
        print("MADAROS_862_ACCEPT_FAIL\n")
        1
    }
}
