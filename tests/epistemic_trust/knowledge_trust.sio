// TRUSTWORTHY under default Madaros: free-function Epistemic API.
// Method form is also TRUSTWORTHY — see knowledge_method_parity.sio and
// scripts/madaros_knowledge_method_residual_gate.sh (Wave9 residual closeout).
use epistemic::knowledge::{
    ep_measured, ep_val, ep_variance, ep_std, ep_add, ep_mul, ep_gate, ep_certain, ep_merge
}

fn approx_eq(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let x = ep_measured(10.0, 0.5)
    let y = ep_measured(4.0, 0.2)
    if approx_eq(ep_val(&x), 10.0, 1e-12) == 0 { return 1 }
    if approx_eq(ep_variance(&x), 0.25, 1e-12) == 0 { return 2 }
    if approx_eq(ep_std(&x), 0.5, 1e-9) == 0 { return 3 }
    let s = ep_add(&x, &y)
    if approx_eq(ep_val(&s), 14.0, 1e-12) == 0 { return 4 }
    if approx_eq(ep_variance(&s), 0.29, 1e-12) == 0 { return 5 }
    let p = ep_mul(&x, &y)
    if approx_eq(ep_val(&p), 40.0, 1e-12) == 0 { return 6 }
    if approx_eq(ep_variance(&p), 8.0, 1e-10) == 0 { return 7 }
    if ep_gate(&x, 900) != 1 { return 8 }
    let c = ep_certain(1.0)
    if ep_gate(&c, 1000) != 1 { return 9 }
    let m = ep_merge(&x, &y)
    // inverse-var merge of 10±0.5 and 4±0.2 → (10/0.25 + 4/0.04) / (1/0.25+1/0.04)
    // = (40 + 100) / (4 + 25) = 140/29 ≈ 4.827586
    if approx_eq(ep_val(&m), 4.827586, 1e-5) == 0 { return 10 }
    print("KNOWLEDGE_TRUST_OK\n")
    return 0
}
