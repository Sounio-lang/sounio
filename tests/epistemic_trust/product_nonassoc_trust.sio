// TRUSTWORTHY under default Madaros: product_nonassoc (structural variance leaf).
// Self-contained PnOct associator in epistemic::product_nonassoc (no algebra:: use).
// Epistemic via field form (ep_* free calls + product_nonassoc multi-import trip E035
// under Madaros run_check_mode — field construct is the native-safe surface here).
// Sentinel: PRODUCT_NONASSOC_TRUST_OK when fano=0.25 and nonfano=4.25 (κ=1).
use epistemic::knowledge::{Epistemic}
use epistemic::product_nonassoc::{product_nonassoc, pn_oct_basis}

fn approx(x: f64, y: f64) -> bool {
    let d = if x > y { x - y } else { y - x }
    d < 0.0001
}

fn main() -> i32 with IO, Mut, Div, Panic, NonAssoc {
    let kappa = 1.0
    let base = Epistemic { val: 10.0, variance: 0.25, confidence: 900 }
    let a = pn_oct_basis(1)
    let b = pn_oct_basis(2)
    let cf = pn_oct_basis(3)
    let cn = pn_oct_basis(4)
    let r_fano = product_nonassoc(base, &a, &b, &cf, kappa)
    let r_nf = product_nonassoc(base, &a, &b, &cn, kappa)
    if approx(r_fano.val, 10.0) { } else { return 1 }
    if approx(r_fano.variance, 0.25) { } else { return 2 }
    if approx(r_nf.val, 10.0) { } else { return 3 }
    if approx(r_nf.variance, 4.25) { } else { return 4 }
    if r_nf.variance > r_fano.variance { } else { return 5 }
    print("PRODUCT_NONASSOC_TRUST_OK\n")
    return 0
}
