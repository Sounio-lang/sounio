// TRUSTWORTHY under default Madaros: epistemic::propagate delta-method + MC.
// Free-function Epistemic field form + exp (literal name) / product / value-style LCG MC.
// Sentinel: PROPAGATE_TRUST_OK when product, exp, and MC identity bands hold.
use epistemic::knowledge::{Epistemic}
use epistemic::propagate::{product, exp, monte_carlo_identity, monte_carlo_square}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn approx(x: f64, y: f64, tol: f64) -> bool {
    abs_f(x - y) < tol
}

fn main() -> i32 with IO, Mut, Div, Panic, Prob {
    // Product: (2±√0.01)*(3±√0.04) → 6, var = 9*0.01 + 4*0.04 = 0.25
    let a = Epistemic { val: 2.0, variance: 0.01, confidence: 900 }
    let b = Epistemic { val: 3.0, variance: 0.04, confidence: 900 }
    let p = product(a, b)
    if approx(p.val, 6.0, 0.000001) { } else { return 1 }
    if approx(p.variance, 0.25, 0.000001) { } else { return 2 }

    // exp (literal import name — Wave6 C collision fix): e¹, var = e²·0.01
    let x = Epistemic { val: 1.0, variance: 0.01, confidence: 900 }
    let e = exp(x)
    if approx(e.val, 2.718281828459045, 0.00001) { } else { return 3 }
    if approx(e.variance, 0.073890560989, 0.0001) { } else { return 4 }
    if e.confidence > 800 { } else { return 5 }

    // MC identity: X ~ N(1, 0.01) → mean≈1, var≈0.01 (N=5000, generous band)
    let id = monte_carlo_identity(x, 5000)
    if approx(id.val, 1.0, 0.05) { } else { return 6 }
    if approx(id.variance, 0.01, 0.005) { } else { return 7 }

    // MC square: X ~ N(2, 0.01) → E[X²]≈4.01, Var≈0.16 (delta); band for CLT MC
    let xs = Epistemic { val: 2.0, variance: 0.01, confidence: 900 }
    let sq = monte_carlo_square(xs, 8000)
    if approx(sq.val, 4.01, 0.15) { } else { return 8 }
    if approx(sq.variance, 0.16, 0.08) { } else { return 9 }

    print("PROPAGATE_TRUST_OK\n")
    return 0
}
