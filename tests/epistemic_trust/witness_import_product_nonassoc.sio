// Native-import witness: epistemic::product_nonassoc (knowledge-free augment).
// After the 2026-07-20 leaf rewrite (no algebra:: use; struct PnOct multiply),
// default Madaros compile+run must succeed and print scaled micro-units:
//   fano variance 0.25 → 250000
//   nonfano variance 4.25 → 4250000
// Printed as two integers (fano then nonfano) so float print flakiness is avoided.
use epistemic::product_nonassoc::{product_nonassoc_augment, pn_oct_basis}

fn main() -> i32 with IO, Mut, Div, Panic, NonAssoc {
    let kappa = 1.0
    let base_var = 0.25
    let a = pn_oct_basis(1)
    let b = pn_oct_basis(2)
    let cf = pn_oct_basis(3)
    let cn = pn_oct_basis(4)
    let vf = product_nonassoc_augment(base_var, &a, &b, &cf, kappa)
    let vn = product_nonassoc_augment(base_var, &a, &b, &cn, kappa)
    // scaled micro-units: * 1e6 → 250000 / 4250000
    print_int((vf * 1000000.0) as i64)
    print("\n")
    print_int((vn * 1000000.0) as i64)
    print("\n")
    return 0
}
