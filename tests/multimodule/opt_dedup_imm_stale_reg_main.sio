//@ run-pass
//@ expect-stdout: OPT_DEDUP_IMM_STALE_REG_OK
//@ description: -O must not reuse a register whose recorded immediate is stale
// Regression: ocp_mfi_dedup_imm recorded "register R holds immediate K" and
// never invalidated that when another instruction WROTE R. #1667 had killed the
// table at block boundaries -- correctly, in both halves it promised -- but a
// write inside a block left the entry standing, so the next IrLoadImm of the
// same value became a copy of a register that had since changed:
//
//     var a = 5      // seen[ra] = 5
//     a = a + 1      // ra is now 6, seen[ra] still says 5
//     var b = 5      // became copy(rb, ra)  ->  b == 6
//
// Five lines of ordinary code returning the wrong number under -O, exit 0.

fn main() -> i32 with IO, Mut, Panic {
    var a: i64 = 5
    a = a + 1
    var b: i64 = 5

    var c: i64 = 7
    c = c * 2
    var d: i64 = 7
    var e: i64 = 7

    if b == 5 && d + e == 14 {
        println("OPT_DEDUP_IMM_STALE_REG_OK")
        return 0
    }
    println("OPT_DEDUP_IMM_STALE_REG_FAIL")
    1
}
