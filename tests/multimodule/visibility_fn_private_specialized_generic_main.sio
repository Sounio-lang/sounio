//@ compile-fail
//
// Copilot review (PR #2515), comment 4109123889: check_items_verdict_boot4_with_module_map
// (self-hosted/check/mod.sio) -- the checking path taken whenever a
// multi-module `check` instantiates ANY generic anywhere in the program --
// stamps current_module_id correctly per specialized item but never
// updates current_module (the AstPath field), which stays empty_path() for
// every item on this path. checker_fn_sig_visible_inplace's private-access
// check used to fall through to a path comparison whenever the module-id
// fast path found a mismatch, and ast_path_eq(empty, empty) granted access
// -- so ANY multi-module program that instantiates a generic (like
// `identity::<i64>` below) could reach another module's PRIVATE function,
// even with no `pub` and no re-export. Fixed by treating a real, valid
// module-id mismatch as authoritative (denying access outright) instead of
// falling through to the always-empty path comparison on this path.
//
// `identity::<i64>(5)` is what forces specialize_generics_multi to run and
// populate spec_item_module_*, routing this compile through
// check_items_verdict_boot4_with_module_map -- without it, this file would
// take the ordinary (already-correct) multi-module path and the bug would
// not reproduce.
use visibility_fn_private_specialized_generic_lib::{identity, private_fn}

fn main() -> i64 {
    let n = identity::<i64>(5)
    private_fn()
}
