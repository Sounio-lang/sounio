//@ run-pass

use abi_name_many_args_lib::{make_name, make_pair, wrapper_frontend_shape}

fn main() -> i64 {
    let x = make_name(10 as i8, 1)
    let y = make_name(20 as i8, 1)
    let z = make_name(30 as i8, 1)
    let pair = make_pair(7)
    let result = wrapper_frontend_shape("abc", 5, 6, x, y, pair.1, z, 8)
    if !result.0 {
        return 1
    }
    if result.1 == 89 {
        return 0
    }
    result.1
}
