// Import order matters here: tta_other (whose unrelated private
// `make_pair` shares tta_callee's real export's bare name) is `use`d
// FIRST, so thin_collect_imports_from_items registers it as import_map
// entry 0 -- the entry thin_build_compiled_unit's per-unit collector
// visits before tta_callee's. See tta_other.sio's own comment.
use tta_other::{touch_other}
use tta_callee::{make_pair}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let (scalar, arr) = make_pair()
    let other = touch_other()
    var ok: bool = true
    if scalar != 7 { ok = false }
    if arr[0] != 10.5 { ok = false }
    if arr[1] != 20.5 { ok = false }
    // Arithmetic on the destructured array's own elements: under the
    // name-only-keyed table collecting tta_other's unrelated colliding
    // `make_pair` (a DIFFERENT tuple-array shape/mask) ahead of this real
    // export, this slot's f64 elements get read through the integer path
    // and this multiply corrupts them via cvtsi2sd on the raw bit pattern
    // instead of an ordinary f64 multiply.
    let doubled: f64 = arr[1] * 2.0
    if doubled != 41.0 { ok = false }
    if other != 99 { ok = false }
    if ok {
        println("THINLINK_TUPLE_ARR_IMPORT PASS")
        return 0
    }
    1
}
