use tta_callee::{make_pair}
use tta_other::{touch_other}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let (scalar, arr) = make_pair()
    let other = touch_other()
    var ok: bool = true
    if scalar != 1.5 { ok = false }
    if arr[0] != 10.5 { ok = false }
    if arr[1] != 20.5 { ok = false }
    if arr[2] != 30.5 { ok = false }
    // Arithmetic on the destructured array's own elements: pre-fix (no
    // global-table fallback for an IDENTIFIER classified through the import
    // path), a misclassified f64 element is read as an integer and this
    // multiply corrupts it via cvtsi2sd on the raw bit pattern instead of an
    // ordinary f64 multiply.
    let doubled: f64 = arr[1] * 2.0
    if doubled != 41.0 { ok = false }
    if other != 7 { ok = false }
    if ok {
        println("THINLINK_TUPLE_ARR_IMPORT PASS")
        return 0
    }
    1
}
