// Same free-fn NAME as tta_callee.sio's `helper` (private to this module,
// loaded as its own separate compiled unit in the same program), but a
// plain i64 -- no tuple, no array. See tta_callee.sio for what pairing these
// two under one name across units is pinning.
fn helper() -> i64 {
    7
}

pub fn touch_other() -> i64 {
    helper()
}
