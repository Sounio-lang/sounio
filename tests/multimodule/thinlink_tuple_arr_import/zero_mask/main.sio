// The selected declaration is imported first and has an authoritative zero
// tuple-array mask. The later module contains a private same-named function
// with a nonzero mask; lowering that module must not reclassify this result.
use zero_callee::{make_pair}
use zero_other::{touch_other}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let (arr, scalar) = make_pair()
    let other = touch_other()
    // Keep integer arithmetic directly on the selected callee's array slot.
    // If the later private f64-array namesake overwrites the authoritative
    // zero mask, these element loads take the float path and this value fails.
    let sum: i64 = arr[0] + arr[1]
    if sum == 30 && scalar == 7 && other == 99 {
        println("THINLINK_TUPLE_ARR_ZERO_MASK PASS")
        return 0
    }
    1
}
