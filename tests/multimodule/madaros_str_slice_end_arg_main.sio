// #2244 multimodule witness -- see madaros_str_slice_end_arg_leaf.sio.
// Exit code is the number of failing cases.
//
// Run:
//   MADAROS_RAW_BIN=/tmp/m.elf; ulimit -s 524288
//   "$MADAROS_RAW_BIN" build tests/multimodule/madaros_str_slice_end_arg_main.sio /tmp/mm.elf
//   /tmp/mm.elf   # expects dir=stdlib/net digit=7 bad=0

use madaros_str_slice_end_arg_leaf::{dir_of, digit_char}

fn main() -> i64 with IO, Mut, Div, Panic {
    var bad = 0
    let d = dir_of("stdlib/net/tcp.sio")
    print("dir=")
    println(d)
    if !str_eq(d, "stdlib/net") { bad = bad + 1 }
    let c = digit_char(7)
    print("digit=")
    println(c)
    if !str_eq(c, "7") { bad = bad + 1 }
    print("bad=")
    print_int(bad)
    println("")
    bad
}
