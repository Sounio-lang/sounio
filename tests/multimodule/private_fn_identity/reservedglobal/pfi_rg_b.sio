// pfi_rg_a is module #1, so the pass would name its `helper` `helper__m1` -- which
// is already a module GLOBAL here. A global is an ItemFn with no body, and it owns
// an IR slot just like a fn, so the generated name must not reuse it.
var helper__m1: i64 = 41

fn helper() -> i64 { 20 }
pub fn rb_get() -> i64 { helper() }
pub fn rb_global() -> i64 { helper__m1 }
