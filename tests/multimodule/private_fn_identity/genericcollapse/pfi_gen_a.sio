// Private GENERIC helper colliding with pfi_gen_b's, instantiated through a
// public wrapper -- forces module_frontend_specialized_prepare's
// specialized-collapse path (a program with a generic instantiation ANYWHERE
// merges every module into one item list and lowers it as a single unit,
// distinct from the ordinary multi-module pipeline every other fixture in
// this gate exercises).
fn helper<T>(x: T) -> T { x }
pub fn get_a() -> i64 { helper::<i64>(1) }
