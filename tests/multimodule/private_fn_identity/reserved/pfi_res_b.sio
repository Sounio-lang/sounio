// pfi_res_a is module #1, so the pass would name its `helper` `helper__m1` -- and
// lowering ALREADY emits that symbol here: `helper_` + `_` + method `m1` is how it
// names `helper_::m1` (Type_method). The pass must not reuse a name any emitted
// symbol (method, extern, kernel, global, fn) already owns.
struct helper_ { n: i64 }

impl helper_ {
    fn m1(self) -> i64 with Mut, Panic, Div, Alloc { self.n + 777 }
}

pub fn method_call(n: i64) -> i64 with Mut, Panic, Div, Alloc {
    let h = helper_ { n: n }
    h.m1()
}

fn helper() -> i64 { 20 }
pub fn rb_get() -> i64 { helper() }
