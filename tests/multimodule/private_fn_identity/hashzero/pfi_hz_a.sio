// `fZOXITBAFRX_E` hashes to exactly 0 under this compiler's own ast_name_hash
// (self-hosted/parser/ast.sio: djb2, `if hash < 0 { 0 - hash } else { hash }`
// clamp -- the clamp makes every real hash >= 0, so a legitimate name CAN
// land on 0 itself). Before the h+1 key shift in pfi_census_note/
// pfi_census_mods, `if h == 0 { return true }` meant this collision was
// never recorded at all: PFI_DUP_ANY stayed unset and the original
// first-loaded-wins miscompile persisted. See hashzero/README note below
// (no expected.txt in this directory -- see why there).
fn fZOXITBAFRX_E() -> i64 { 1 }
pub fn ra_get() -> i64 { fZOXITBAFRX_E() }
