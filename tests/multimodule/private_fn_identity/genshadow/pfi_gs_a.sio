// pfi_gs_a is module #1, so the pass would name its private `helper` `helper__m1`.
// This module ALSO has a parameter literally spelled `helper__m1` in a different
// function. check.sio resolves a bare identifier against env (local bindings)
// BEFORE fn_sigs, so if `helper()`'s call site inside `something` were rewritten
// to `helper__m1()`, it would resolve to THIS PARAMETER, not the renamed
// function. The rename must refuse this module's `helper` instead of guessing.
fn helper() -> i64 { 1 }

fn something(helper__m1: i64) -> i64 {
    helper() + helper__m1
}

pub fn ra_get() -> i64 { something(100) }
