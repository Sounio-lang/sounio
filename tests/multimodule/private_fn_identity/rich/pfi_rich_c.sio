// A PUBLIC `helper` (main imports it: it must keep its own name and must not be
// confused with the private `helper`s of pfi_rich_a / pfi_rich_b) and a private
// `inner` reached through an impl method.
pub fn helper(x: i64) -> i64 { x + 5000 }

fn inner(x: i64) -> i64 { x + 3 }

struct Counter { n: i64 }

impl Counter {
    fn bump(self) -> i64 with Mut, Panic, Div, Alloc { inner(self.n) }
}

pub fn rc_bump(n: i64) -> i64 with Mut, Panic, Div, Alloc {
    let c = Counter { n: n }
    c.bump()
}
