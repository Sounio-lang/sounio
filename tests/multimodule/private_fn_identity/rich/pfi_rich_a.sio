// Private helpers whose names are also private in pfi_rich_b / pfi_rich_c.
fn inner(x: i64) -> i64 { x + 1 }
fn helper(x: i64) -> i64 { inner(x) * 10 }
fn twice(x: i64) -> i64 { x * 2 }
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
fn fact(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact(n - 1) } }

pub fn ra_direct(x: i64) -> i64 { helper(x) }
pub fn ra_twice(x: i64) -> i64 { twice(x) }
// `helper` passed as a value: an argument stored by value in the call's list.
pub fn ra_value(x: i64) -> i64 { apply(helper, x) }
// `helper` bound to a local: a boxed initializer.
pub fn ra_let_value(x: i64) -> i64 {
    let f = helper
    f(x)
}
pub fn ra_fact(n: i64) -> i64 { fact(n) }
