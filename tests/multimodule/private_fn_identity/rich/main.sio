use pfi_rich_a::{ra_direct, ra_twice, ra_value, ra_let_value, ra_fact}
use pfi_rich_b::{rb_direct, rb_twice, rb_value, rb_fact}
use pfi_rich_c::{helper, rc_bump}

fn show(name: string, v: i64) with IO, Mut, Panic, Div {
    print(name)
    print("=")
    print_int(v)
    println("")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    show("ra_direct", ra_direct(4))
    show("ra_twice", ra_twice(4))
    show("ra_value", ra_value(4))
    show("ra_let_value", ra_let_value(4))
    show("ra_fact", ra_fact(3))
    show("rb_direct", rb_direct(4))
    show("rb_twice", rb_twice(4))
    show("rb_value", rb_value(4))
    show("rb_fact", rb_fact(3))
    show("pub_helper", helper(4))
    show("rc_bump", rc_bump(4))
    0
}
