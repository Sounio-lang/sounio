// Same names as pfi_rich_a, different bodies (except `twice`, which is an
// identical copy: renaming a benign duplicate must leave it correct).
fn inner(x: i64) -> i64 { x + 2 }
fn helper(x: i64) -> i64 { inner(x) * 100 }
fn twice(x: i64) -> i64 { x * 2 }
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) + 1000 }
fn fact(n: i64) -> i64 { if n <= 1 { 7 } else { n * fact(n - 1) } }

pub fn rb_direct(x: i64) -> i64 { helper(x) }
pub fn rb_twice(x: i64) -> i64 { twice(x) }
pub fn rb_value(x: i64) -> i64 { apply(helper, x) }
pub fn rb_fact(n: i64) -> i64 { fact(n) }
