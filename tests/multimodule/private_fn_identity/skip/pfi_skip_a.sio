// `sa_shadow` has a PARAMETER spelled like the private fn, so an identifier
// `helper` in this module cannot be proven to mean the function. The pass must
// leave this module alone and say so. (pfi_skip_b's `helper` is renamed, which
// is enough to keep the two apart.)
fn helper() -> i64 { 1 }
pub fn sa_get() -> i64 { helper() }
pub fn sa_shadow(helper: i64) -> i64 { helper + 1 }
