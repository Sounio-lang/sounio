pub struct Hidden { secret:i64, pub exposed:i64 }
pub fn make_hidden()->Hidden { Hidden{secret:11,exposed:22} }
pub fn same_module()->i64 with Mut {
 var h=make_hidden();let p=&!h.secret;*p=33;h.secret
}
impl Hidden {
 pub fn reveal(self:&Hidden)->i64 { self.secret }
 pub fn update(self:&!Hidden,v:i64) with Mut { let p=&!self.secret;*p=v }
}
pub struct Inner { secret:i64, pub open_value:i64, pub open_array:[i64;2], closed_array:[i64;2] }
pub struct PublicOuter { pub inner:Inner, pub pad:i64 }
pub struct PrivateOuter { inner:Inner, pub pad:i64 }
pub fn make_inner()->Inner { Inner{secret:1,open_value:2,open_array:[3,4],closed_array:[5,6]} }
pub fn make_public_outer()->PublicOuter { PublicOuter{inner:make_inner(),pad:0} }
pub fn make_private_outer()->PrivateOuter { PrivateOuter{inner:make_inner(),pad:0} }
pub fn observe_public(o:&PublicOuter)->i64 with Panic { o.inner.secret+o.inner.open_value+o.inner.open_array[0]+o.inner.closed_array[0] }

pub fn same_module_nested()->bool with Mut,Panic {
 var o=make_private_outer();o.inner.secret=6
 let p=&!o;p.inner.secret=7;p.inner.closed_array[0]=8
 p.inner.secret==7&&p.inner.closed_array[0]==8
}
