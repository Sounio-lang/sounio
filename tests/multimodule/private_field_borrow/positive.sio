//@ run-pass
//@ expect-stdout: MULTIMODULE_PRIVATE_BORROW_PUBLIC_PASS
use owner::*
use decoy::{Readable,readable}
fn read(x:&i64)->i64{*x}
fn write(x:&!i64,v:i64) with Mut{*x=v}
fn mutate_outer(o:&!PublicOuter) with Mut,Panic {o.inner.open_value=9;o.inner.open_array[0]=8}
fn borrow_public(p:&!Readable) with Mut,Panic {write(&!p.secret,67);write(&!(*p).secret,68);assert(read(&p.secret)==68&&read(&(*p).secret)==68)}
fn main()->i32 with IO,Mut,Panic {assert(same_module()==33);var h=make_hidden();assert(h.reveal()==11);h.update(44);assert(h.reveal()==44);assert(same_module_nested());var d=readable();write(&!d.secret,66);assert(read(&d.secret)==66);borrow_public(&!d);assert(read(&d.secret)==68);var o=make_public_outer();o.inner.open_value=9;mutate_outer(&!o);assert(observe_public(&o)==23);println("MULTIMODULE_PRIVATE_BORROW_PUBLIC_PASS");0}
