//@ run-pass
//@ requires: madaros
//@ expect-stdout: BUILTIN_BOX_AFTER_IMPORT_OK
use Box::helpers
var root: Option<Box<Cell>> = None
struct Cell { value: i64 }
fn main() -> i32 with IO, Mut, Alloc, Panic {
    let node = Box::new(Cell { value: 42 })
    root = Some(node)
    let observed = match root { Some(item) => (*item).value, None => 0, }
    if observed != 42 { return 1 }
    println("BUILTIN_BOX_AFTER_IMPORT_OK")
    return 0
}
