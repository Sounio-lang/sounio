//@ run-pass

pub fn add_public(a: i64, b: i64) -> i64 {
    a + b
}

pub fn sub_public(a: i64, b: i64) -> i64 {
    a - b
}

pub fn sum5_public(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    a + b + c + d + e
}

pub fn sum6_public(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    a + b + c + d + e + f
}

pub fn sum7_public(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
    a + b + c + d + e + f + g
}
