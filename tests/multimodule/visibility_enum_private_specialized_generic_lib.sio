// Copilot review (PR #2515), comment 4109793910: sibling of
// visibility_fn_private_specialized_generic_lib.sio /
// visibility_struct_private_specialized_generic_lib.sio, but for a
// PRIVATE ENUM instead of a private function/struct. See the _main.sio
// fixture's own comment for the bug this pair reproduces.
enum PrivateChoice {
    A,
    B,
}

pub fn identity<T>(x: T) -> T {
    x
}

pub fn make_choice() -> i64 {
    let c = PrivateChoice::A
    match c {
        PrivateChoice::A => 1,
        PrivateChoice::B => 2,
    }
}
