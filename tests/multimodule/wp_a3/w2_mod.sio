// WP-A3 W2 imported module: a generic struct + a generic fn returning it.
// Exercises the multi-module AST specializer: main instantiates wrap::<i64>
// across the module boundary and reads the .val field of the returned W<i64>.
module w2_mod

pub struct W<T> { val: T }

pub fn wrap<T>(v: T) -> W<T> with Mut, Panic {
    W { val: v }
}
