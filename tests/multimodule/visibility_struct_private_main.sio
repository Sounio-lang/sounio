//@ compile-fail
//@ error-pattern: E176

// Copilot review (PR #2515), comment 4110379104 (via the now-wired
// madaros_visibility_context_gate.sh): this fixture is scoped to isolate
// struct-CONSTRUCTOR privacy (E176) alone. It used to also read `s.x`,
// which after this PR's checker_field_visible_inplace fix now ALSO
// (correctly) emits E259 for the same non-pub field on the same private
// struct -- two genuine diagnostics for one offending construction, which
// broke expect_private_rejection's "exactly one diagnostic" assertion.
// Dropped the field read; the constructor alone already fully exercises
// this fixture's purpose. Field privacy has its own dedicated case
// (private-field-specialized-generic below).
use visibility_struct_private_lib::{PrivateStruct}

fn main() -> i64 {
    let s = PrivateStruct { x: 1 }
    0
}
