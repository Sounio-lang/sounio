//@ run-pass
//@ expect-stdout: UNIT_IMPORTED_METADATA_PASS
use defs::{echo, reading, Reading}
fn main() -> i32 with IO, Mut, Alloc {
    let result = echo(1000.0)
    let sample = reading(0.07)
    let nominal = result as f64
    let field = sample.amount as f64
    if nominal < 999.999999999999 || nominal > 1000.000000000001 { print("UNIT_IMPORTED_RETURN_FAIL\n"); return 1 }
    if field < 0.069999999999 || field > 0.070000000001 { print("UNIT_IMPORTED_FIELD_FAIL\n"); return 2 }
    print("UNIT_IMPORTED_METADATA_PASS\n")
    return 0
}
