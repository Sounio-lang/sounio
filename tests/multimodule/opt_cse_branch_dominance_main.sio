//@ run-pass
//@ expect-stdout: OPT_CSE_BRANCH_DOMINANCE_OK
//@ description: -O must not CSE an expression into a branch its definition does not dominate
// Regression: ocp_mfi_cse kept its (op, src1, src2) table across basic blocks.
// `if a { return f(e) }  if b { return f(e) + k }` had the second occurrence
// rewritten as a copy of the first, whose register is never written when the
// first branch is not taken -- so the value read was whatever the preceding
// call had left there. Measured: atan(1.0) after a sqrt(1.0), giving
// pi + 0.791495 = 3.933087 instead of pi.
//
// The preceding msqrt call, the two branches, and pi bound to a local are all
// load-bearing: drop any one and the defect does not reproduce.

fn msqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 60 { g = (g + x / g) / 2.0; i = i + 1 }
    return g
}

fn matan(x: f64) -> f64 with Mut, Panic, Div {
    var sum = x
    var term = x
    var n = 1
    while n <= 40 { term = 0.0 - term * x * x; sum = sum + term / ((2 * n + 1) as f64); n = n + 1 }
    return sum
}

fn matan2(y: f64, x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    if x > 0.0 { return matan(y / x) }
    if x < 0.0 && y >= 0.0 { return matan(y / x) + pi }
    return 0.0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let r = msqrt(1.0)
    let v = matan2(0.0, 0.0 - 1.0)
    if v > 3.1415 && v < 3.1416 {
        println("OPT_CSE_BRANCH_DOMINANCE_OK")
        return 0
    }
    println("OPT_CSE_BRANCH_DOMINANCE_FAIL")
    1
}
