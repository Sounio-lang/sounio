// Every call is in scope: a named import, a glob, a `pub use` re-export, and a
// local closure spelled like a pub fn (hyg::lib's hyg_neg) that is not imported.
use hyg::lib::{hyg_double}
use hyg::middle::*
use hyg::reexport::{hyg_triple}
fn main() -> i32 with IO, Mut, Div, Panic {
    let a = hyg_double(5)
    let b = hyg_quad(1)
    let c = hyg_triple(2)
    let hyg_neg = |x: i64| x + 100
    print_int(a + b + c + hyg_neg(0))
    print("\n")
    0
}
