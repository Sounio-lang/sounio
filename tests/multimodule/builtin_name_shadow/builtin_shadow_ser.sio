// Private buffer codecs. Their names collide with the runtime builtins
// read_i64 and write_i64. Callers in this module must keep these signatures.
fn write_i64(buf: &![i8; 8], pos: i64, val: i64) -> i64 with Mut, Panic {
    (*buf)[0] = ((val) & 255) as i8
    pos + 1
}

fn read_i64(buf: &[i8; 8], pos: i64) -> (i64, i64) with Panic {
    ((*buf)[0] as i64, pos + 1)
}

pub fn ser_local() -> i64 with Mut, Panic {
    var buf: [i8; 8] = [0 as i8; 8]
    write_i64(&!buf, 3, 9)
}

pub fn ser_touch() -> i64 {
    1
}
