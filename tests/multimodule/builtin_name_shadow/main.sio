use builtin_shadow_ser::{ser_local, ser_touch}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    if ser_touch() != 1 {
        return 2
    }
    if ser_local() != 4 {
        return 3
    }
    let p = heap_alloc(64)
    if p == 0 {
        return 5
    }
    write_i64(p, 0, 7)
    if read_i64(p, 0) != 7 {
        return 1
    }
    print("builtin_name_shadow: ok\n")
    0
}
