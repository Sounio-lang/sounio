//@ run-pass
// Cross-module generic method dispatch on a struct ARRAY element: main instantiates
// g_probe::<Rat> across the module boundary; inside, the imported generic fn does
// `a.c[i].e_add(...)` on an imported `G<F> { c: [F;4] }`. Before the imported-generic
// monomorphization fix the body lowered against generic `G<F>` (symbolic F) and
// crashed codegen. Expected exit code 14 (7 + 7).
use xmod_generic_method_mod::{Rat, rmk, G, g_probe}

fn main() -> i64 with Mut, Panic, Div {
    let g = G { c: [rmk(7); 4], bits: 2 }
    let r = g_probe::<Rat>(g)
    return r.num
}
