// Imported module for the cross-module generic-method-dispatch regression.
// A generic struct with an array field + a trait + a generic fn that dispatches
// a trait method on a struct array element. Exercises imported-generic
// monomorphization (the WP-A3 collapse-to-specialized-single-module path).
module xmod_generic_method_mod

pub struct Rat { pub num: i64, pub den: i64 }
pub fn rmk(n: i64) -> Rat { Rat { num: n, den: 1 } }
pub trait ER { fn e_add(self, o: Rat) -> Rat with Mut, Div, Panic; }
impl ER for Rat { fn e_add(self, o: Rat) -> Rat with Mut, Div, Panic { Rat { num: self.num + o.num, den: 1 } } }
pub struct G<F> { pub c: [F; 4], pub bits: i32 }
pub fn g_probe<F>(a: G<F>) -> Rat with Mut, Panic, Div { a.c[0 as usize].e_add(a.c[1 as usize]) }
