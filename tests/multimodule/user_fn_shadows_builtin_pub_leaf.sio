// KL-21 pub residual, defining module. A `pub fn` whose name is an intercepted
// builtin is renamed `measure__user` here by builtin_shadow_apply_items; the
// pub phase then rebinds importers that spell `measure` through their `use`.
// Expected exit code comes from the importer (user_fn_shadows_builtin_pub_main).
pub fn measure(x: i64) -> i64 { x + 1000 }
