pub fn ordered_sum_7(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64
) -> i64 {
    a1 + (a2 * 2) + (a3 * 3) + (a4 * 4) + (a5 * 5) + (a6 * 6) + (a7 * 7)
}

pub fn ordered_sum_8(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, a8: i64
) -> i64 {
    ordered_sum_7(a1, a2, a3, a4, a5, a6, a7) + (a8 * 8)
}

pub fn ordered_sum_9(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64
) -> i64 {
    ordered_sum_8(a1, a2, a3, a4, a5, a6, a7, a8) + (a9 * 9)
}

pub fn ordered_sum_13(
    a1: i64, a2: i64, a3: i64, a4: i64, a5: i64,
    a6: i64, a7: i64, a8: i64, a9: i64, a10: i64,
    a11: i64, a12: i64, a13: i64
) -> i64 {
    a1 + (a2 * 2) + (a3 * 3) + (a4 * 4) + (a5 * 5) +
    (a6 * 6) + (a7 * 7) + (a8 * 8) + (a9 * 9) +
    (a10 * 10) + (a11 * 11) + (a12 * 12) + (a13 * 13)
}
