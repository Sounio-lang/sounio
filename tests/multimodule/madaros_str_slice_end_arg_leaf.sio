// #2244 multimodule witness: 3-arg str_slice inside an IMPORTED module.
// The single-file compile path and the merged multi-module path are different
// call sites of ir_module_ensure_builtin_call_targets, so a single-file fixture
// cannot show that the arity retag reaches both.
//
// The two shapes mirror the compiler own call sites the issue names:
// module_frontend.sio:409 (directory of a path) and :366 (one character out
// of a lookup table).

pub fn dir_of(path: string) -> string with Mut, Panic, Div {
    let n = str_len(path)
    var last: i64 = 0 - 1
    var i: i64 = 0
    while i < n {
        if str_char_at(path, i) == 47 { last = i }
        i = i + 1
    }
    if last < 0 { return "." }
    str_slice(path, 0, last)
}

pub fn digit_char(v: i64) -> string with Mut, Panic, Div {
    str_slice("0123456789", v, v + 1)
}
