// Module a folds `X = 5`; module b's `X = impure()` cannot be folded or
// deferred. The fold in a must not cancel b's refusal (E309).
use gii_df_a::{get_xa}
use gii_df_b::{get_xb}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    print_int(get_xa())
    println("")
    print_int(get_xb())
    println("")
    0
}
