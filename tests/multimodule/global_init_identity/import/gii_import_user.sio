use gii_import_lib::{base, f, LIMIT}

fn g(x: i64) -> i64 { x * 100 }
var K: i64 = 5
var X: i64 = base() + 1
var Y: i64 = LIMIT * 2
var R: i64 = f(1)
var L: i64 = g(2)
var KK: i64 = K + 1
pub fn get_x() -> i64 { X }
pub fn get_y() -> i64 { Y }
pub fn get_r() -> i64 { R }
pub fn get_l() -> i64 { L }
pub fn get_kk() -> i64 { KK }
