use gii_import_lib::{HALF}
use gii_import_user::{get_x, get_y, get_r, get_l, get_kk}

fn show(name: string, v: i64) with IO, Mut, Panic, Div {
    print(name)
    print("=")
    print_int(v)
    println("")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    show("x", get_x())
    show("y", get_y())
    show("r", get_r())
    show("l", get_l())
    show("kk", get_kk())
    println(HALF)
    0
}
