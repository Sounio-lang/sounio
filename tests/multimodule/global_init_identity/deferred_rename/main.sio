// Two modules each define private `K`, `Q` (a struct literal, deferred to
// `main`'s entry) and `T` (an array filled by statements at `main`'s entry).
// The identity pass renames each module's copies apart; the deferred
// initializers must be renamed with them, or they write the old symbol and the
// module reads zero.
use gii_dr_a::{get_ra}
use gii_dr_b::{get_rb}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    print_int(get_ra())
    println("")
    print_int(get_rb())
    println("")
    0
}
