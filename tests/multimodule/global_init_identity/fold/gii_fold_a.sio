fn scale(x: i64) -> i64 { x * 2 }
fn bump(a: i64) -> i64 {
    let t = a + 1
    t
}
fn one() -> i64 { 1 }
var SA: i64 = scale(3)
var BA: i64 = bump(5)
var TA: [i64; 3] = [scale(1), one(), 30]
pub fn get_sa() -> i64 { SA }
pub fn get_ba() -> i64 { BA }
pub fn get_ta0() -> i64 { TA[0] }
pub fn get_ta1() -> i64 { TA[1] }
