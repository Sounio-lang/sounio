use gii_fold_a::{get_sa, get_ba, get_ta0, get_ta1}
use gii_fold_b::{get_sb, get_bb, get_tb0, get_tb1}

fn show(name: string, v: i64) with IO, Mut, Panic, Div {
    print(name)
    print("=")
    print_int(v)
    println("")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    show("sa", get_sa())
    show("ba", get_ba())
    show("ta0", get_ta0())
    show("ta1", get_ta1())
    show("sb", get_sb())
    show("bb", get_bb())
    show("tb0", get_tb0())
    show("tb1", get_tb1())
    0
}
