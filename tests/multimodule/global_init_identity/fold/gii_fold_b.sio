fn scale(x: i64) -> i64 { x * 10 }
fn bump(a: i64) -> i64 {
    let t = a + 100
    t
}
fn one() -> i64 { 11 }
var SB: i64 = scale(3)
var BB: i64 = bump(5)
var TB: [i64; 3] = [scale(1), one(), 30]
pub fn get_sb() -> i64 { SB }
pub fn get_bb() -> i64 { BB }
pub fn get_tb0() -> i64 { TB[0] }
pub fn get_tb1() -> i64 { TB[1] }
