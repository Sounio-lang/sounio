use gii_shadow_lib::{helper, helper2}
use gii_shadow_user::{get_x_is_foreign, get_x2_is_foreign}

fn show(name: string, v: i64) with IO, Mut, Panic, Div {
    print(name)
    print("=")
    print_int(v)
    println("")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    show("lib_helper", helper())
    show("lib_helper2", helper2())
    show("x_is_foreign", get_x_is_foreign())
    show("x2_is_foreign", get_x2_is_foreign())
    0
}
