use gii_basic_b::{get_b, get_g}
use gii_basic_a::{get_a}

fn show(name: string, v: i64) with IO, Mut, Panic, Div {
    print(name)
    print("=")
    print_int(v)
    println("")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    show("a", get_a())
    show("b", get_b())
    show("g", get_g())
    0
}
