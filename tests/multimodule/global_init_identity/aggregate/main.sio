// Two modules each define a private `T` with a closed element-list
// initializer. Both are deferred to `main`'s entry and each block writes the
// bare name, so the second would overwrite the first: refused (E309).
use gii_agg_a::{get_a}
use gii_agg_b::{get_b}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    print_int(get_a())
    println("")
    print_int(get_b())
    println("")
    0
}
