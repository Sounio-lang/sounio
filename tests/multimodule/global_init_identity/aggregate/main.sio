// Two modules each define a private `T` with a closed element-list
// initializer, deferred to `main`'s entry. The identity pass gives each `T`
// its own symbol and renames the statements that fill it: 23 and 43. With
// the pass disabled both blocks write one symbol and the compile is refused
// (E309).
use gii_agg_a::{get_a}
use gii_agg_b::{get_b}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    print_int(get_a())
    println("")
    print_int(get_b())
    println("")
    0
}
