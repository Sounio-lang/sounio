use gii_amb_a::{get_a}
use gii_amb_b::{get_b}
use gii_amb_c::{get_sc_is_folded}

fn show(name: string, v: i64) with IO, Mut, Panic, Div {
    print(name)
    print("=")
    print_int(v)
    println("")
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    show("a", get_a())
    show("b", get_b())
    show("sc_is_folded", get_sc_is_folded())
    0
}
