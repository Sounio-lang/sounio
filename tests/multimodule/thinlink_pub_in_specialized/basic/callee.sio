// A generic instantiated ANYWHERE in the merged program routes the whole
// typecheck through check_items_verdict_boot4_with_module_map (the
// specialized multi-module path) instead of the ordinary per-module
// checker -- see that function's own comment (check/mod.sio).
fn identity<T>(x: T) -> T {
    x
}

// `pub(main)`: visible specifically to the module named `main`. This
// repo's module_path is derived from the FILE's own path (module_loader.sio's
// file_path_to_module_path), so a `pub(path)` restriction can only ever name
// another module by its own exact derived path -- there is no real
// hierarchical package scoping to lean on here. What this fixture pins is
// the MECHANISM itself: `current_module` must be the real AstPath of the
// calling item, not empty_path(), for this check to succeed for ANYONE
// (empty_path() can never be a valid non-empty path's descendant).
pub(main) fn restricted_value() -> i64 with Mut, Panic, Div, Alloc {
    identity::<i64>(42)
}
