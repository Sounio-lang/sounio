// Same shape as basic/callee.sio, but restricted to a module that is NOT
// the caller (`nobody`, which no file in this fixture is named). Proves the
// fix is a real check, not current_module simply always satisfying it now.
fn identity<T>(x: T) -> T {
    x
}

pub(nobody) fn restricted_value() -> i64 with Mut, Panic, Div, Alloc {
    identity::<i64>(42)
}
