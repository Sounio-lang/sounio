//@ run-pass
//@ exit-code: 99
// REGRESSION WITNESS for the cross-module DCE mark table.
//
// 600 functions in a single reachability chain, every one of them live:
// main -> wrap::<i64> -> dce_chain_0 -> dce_chain_1 -> ... -> dce_chain_599.
// The generic `wrap` is what puts this on the specialized-collapse path, which
// is the only path spec_dce_unreachable_item_fns runs on.
//
// Against a compiler with the old [i64; 512] linear mark list this program
// COMPILES, RUNS, AND ANSWERS WRONG:
//
//     spec_dce: item_fns 602 -> 512 marks=512      <- 90 live fns deleted
//     exit 8                                        <- expected 99
//
// No error, no warning, compiler rc=0. The pass ran out of marks, stopped
// recording, and then deleted every function it could not find in its own
// table. `chain_0()` returns 601 and 601 % 251 == 99.
use dce_chain_mod::{wrap, W, dce_chain_0}

fn main() -> i64 with Mut, Panic, Div {
    let w = wrap::<i64>(dce_chain_0())
    return w.val % 251
}
