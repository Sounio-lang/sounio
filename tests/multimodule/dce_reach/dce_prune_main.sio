//@ run-pass
//@ exit-code: 7
// The other arm of the DCE witness: the pass must still PRUNE.
//
// 300 functions nothing calls, one that main reaches. A mark table that never
// refuses anything would be trivially correct and useless, so this pins the
// optimisation itself:
//
//     spec_dce: item_fns 303 -> 3 marks=3
//
// identical before and after the table was rewritten.
use dce_prune_mod::{wrap, W, live_one}

fn main() -> i64 with Mut, Panic {
    let w = wrap::<i64>(live_one())
    return w.val
}
