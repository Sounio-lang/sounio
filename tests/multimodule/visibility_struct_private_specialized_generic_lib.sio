// Copilot review (PR #2515), comment 4109697757: sibling of
// visibility_fn_private_specialized_generic_lib.sio, but for a PRIVATE
// generic STRUCT instead of a private function. See the _main.sio
// fixture's own comment for the bug this pair reproduces.
struct PrivateBig<F> {
    x: F,
}

pub fn identity<T>(x: T) -> T {
    x
}

pub fn make_private_big(v: i64) -> i64 {
    let p = PrivateBig { x: v }
    p.x
}
