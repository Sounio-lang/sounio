module bms::user
// A module that defines functions with the names of native float builtins.
pub fn sqrt(x: f64) -> f64 { x + 100.0 }
pub fn exp(x: f64) -> f64 { x + 200.0 }
fn cos(x: f64) -> f64 { x + 300.0 }
// Its own calls see its own definitions.
pub fn own_sqrt(x: f64) -> f64 { sqrt(x) }
pub fn own_cos(x: f64) -> f64 { cos(x) }
pub fn tag() -> i64 { 7 }
