// Does not import bms::user's sqrt/exp: the bare names are the builtins.
use bms::user::{own_sqrt, own_cos, tag}
fn main() -> i32 with IO, Mut, Div, Panic {
    if tag() != 7 { return 1 }
    println(sqrt(4.0))
    println(exp(0.0))
    println(cos(0.0))
    println(own_sqrt(4.0))
    println(own_cos(0.0))
    0
}
