//@ run-pass
//@ expect-stdout: OPT_CHAINED_CALL_ACCUMULATOR_OK
//@ description: -O must not drop a store whose only consumer is a call argument
// Regression: ocp_mfi_dse decided a store was dead by scanning SRC1/SRC2 only.
// A call reads its arguments from instr.call_args, a Box list the peel does not
// walk, so `x = f(x, k)` looked unread and the store was NOPed. Every call then
// received the pre-chain value of x and only the last write survived: this
// program printed 100 instead of 111 under -O, and exit 0 either way.
use opt_chained_call_accumulator_dep::{occ_add}

fn main() -> i32 with IO, Mut, Panic {
    var x: i64 = 0
    x = occ_add(x, 1)
    x = occ_add(x, 10)
    x = occ_add(x, 100)
    if x == 111 {
        println("OPT_CHAINED_CALL_ACCUMULATOR_OK")
        return 0
    }
    println("OPT_CHAINED_CALL_ACCUMULATOR_FAIL")
    1
}
