// Copilot review (PR #2515), comment 4114124500: `use pkg_mod::Widget;` is
// a real path-form TYPE import (no braces) -- the same shape a function/
// value named import uses (`use a::b::f;`), syntactically indistinguishable
// at the AST level. Before the fix, module_frontend.sio's named-item
// fallback recorded `Widget`'s import into the SAME "named item, not a
// module" registry a function import would use, which made check.sio's
// checker_use_module_note_path skip registering "pkg_mod::Widget" as a
// known use-suffix entirely -- so the 3-segment associated-call validation
// below (`checker_use_module_known` for a path longer than 2 segments)
// always failed, and `pkg_mod::Widget::make()` fell back to W044 instead of
// typechecking as the real associated-function call it is. The fix checks
// whether the resolved terminal is ACTUALLY a struct/enum before noting it,
// so a genuine type import still gets its combined suffix registered.
use pkg_mod::Widget;

fn main() -> i32 with IO, Mut, Panic {
    let v: i64 = pkg_mod::Widget::make()
    if v == 42 {
        println("PATH_FORM_TYPE_IMPORT_QUALIFIER_OK")
        return 0
    }
    1
}
