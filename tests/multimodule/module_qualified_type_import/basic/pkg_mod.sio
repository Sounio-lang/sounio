// Real module `main.sio` imports via a PATH-FORM (no braces) named import:
// `use pkg_mod::Widget;`. "pkg_mod/Widget.sio" does not exist, but
// "pkg_mod.sio" (this file) does -- the named-item fallback in
// module_frontend.sio's resolve_import_file_path resolves it that way,
// confirming `Widget` is a named item inside this file, not a module of
// its own.
pub struct Widget {
    n: i64,
}

impl Widget {
    pub fn make() -> i64 {
        42
    }
}
