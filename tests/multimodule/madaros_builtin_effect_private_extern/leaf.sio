// #2760 review: a PRIVATE `extern "C"` stub for a builtin name in ANOTHER module
// must not hide the builtin from the module that calls it. The call resolver
// (fn_sig_table_find_prefer_module) skips a foreign private extern stub, so
// `main.sio`'s heap_alloc is the implicit builtin and owes Alloc.
extern "C" {
    fn heap_alloc(size: i64) -> i64
}

pub fn leaf_value() -> i64 { 1 }
