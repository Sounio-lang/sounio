// EXPECT: error[E035] -- `leaf()` calls the builtin heap_alloc without `with Alloc`.
// Before the review fix the cross-module extern stub made the effect lookup
// return early, so this checked clean.
use leaf

fn leaf_fn() -> i64 {
    let p = heap_alloc(8)
    leaf::leaf_value()
}

fn main() -> i64 with IO {
    leaf_fn()
}
