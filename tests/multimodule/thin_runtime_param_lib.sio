//@ run-pass

use thin_single_lib::{add_public, sub_public}

pub fn entry(x: i64) -> i64 {
    add_public(x, x + 1)
}

pub fn pair_plus(v: i64) -> i64 {
    add_public(v + 1, v + 2)
}

pub fn pair_diff(v: i64) -> i64 {
    sub_public(v + 8, v + 1)
}

pub fn pair_diff_local(v: i64) -> i64 {
    let y = v + 8
    sub_public(y, v + 1)
}
