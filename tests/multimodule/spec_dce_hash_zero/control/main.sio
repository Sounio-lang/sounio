// Negative control for tests/multimodule/spec_dce_hash_zero/hashzero/main.sio:
// identical shape, but `twenty`'s ast_name_hash is not 0, so this compiles and
// runs cleanly both before and after the spec_dce hash-0 fix. If this case
// ever fails, the failure is not the hash-0 sentinel bug -- something else
// broke.

fn twenty() -> i64 {
    20
}

fn main() -> i64 with IO {
    print_int(twenty())
    0
}
