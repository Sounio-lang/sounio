// Regression fixture for the spec_dce hash-0 sentinel bug
// (docs/audit/MADAROS_SPEC_DCE_HASH_ZERO_2026-09-22.md).
//
// fZOXITBAFRX_E's ast_name_hash is exactly 0 under this compiler's djb2
// ast_name_hash (confirmed directly, and independently in Python). Before the
// h+1 key shift in spec_dce_hash_insert/spec_dce_hash_find
// (self-hosted/check/specializer.sio), `if h == 0 { return false }` in both
// functions meant a call site to this function could never mark it
// reachable, so cross-module DCE dropped its still-called FnDef and the
// compile failed closed with:
//   error[E137] ... use of undeclared variable
//   name fZOXITBAFRX_E
//   IR lowering failed during merge: epistemic_export_failed
//
// This is a single module with no imports -- the plain, unconditional path
// (module_frontend_lower_single_program_array_direct_box), not a
// collision or generics edge case. See tests/multimodule/spec_dce_hash_zero/
// control/main.sio for the identical-shape, non-zero-hash negative control.

fn fZOXITBAFRX_E() -> i64 {
    20
}

fn main() -> i64 with IO {
    print_int(fZOXITBAFRX_E())
    0
}
