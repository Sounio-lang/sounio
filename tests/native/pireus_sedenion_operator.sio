// Ordinary source-level Sedenion multiplication witness for Pireus.
//@ check-pass

fn cd_sign(a: i64, b: i64, bits: i64) -> i64 {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let ah = if a >= half { 1 } else { 0 }
    let bh = if b >= half { 1 } else { 0 }
    let al = a & (half - 1)
    let bl = b & (half - 1)
    if ah == 0 && bh == 0 { return cd_sign(al, bl, bits - 1) }
    if ah == 0 && bh == 1 { return cd_sign(bl, al, bits - 1) }
    if ah == 1 && bh == 0 {
        if bl == 0 { return cd_sign(al, 0, bits - 1) }
        return 0 - cd_sign(al, bl, bits - 1)
    }
    if bl == 0 { return 0 - cd_sign(0, al, bits - 1) }
    cd_sign(bl, al, bits - 1)
}

fn main() -> i32 with IO, Alloc, Mut, Panic, Div, NonAssoc {
    let pa = heap_alloc(128) as *mut Hyper<Sedenion, f64>
    let pb = heap_alloc(128) as *mut Hyper<Sedenion, f64>
    let pout = heap_alloc(128) as *mut Hyper<Sedenion, f64>
    var failures: i64 = 0
    var a: i64 = 0
    while a < 16 {
        var b: i64 = 0
        while b < 16 {
            var k: i64 = 0
            while k < 16 {
                write_f64(pa as *mut f64, k, if k == a { 1.0 } else { 0.0 })
                write_f64(pb as *mut f64, k, if k == b { 1.0 } else { 0.0 })
                write_f64(pout as *mut f64, k, 0.0)
                k = k + 1
            }
            *pout = (*pa) * (*pb)
            k = 0
            while k < 16 {
                let expected = if k == (a ^ b) { cd_sign(a, b, 4) as f64 } else { 0.0 }
                if read_f64(pout as *mut f64, k) != expected {
                    failures = failures + 1
                }
                k = k + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    heap_free(pa as *mut i8)
    heap_free(pb as *mut i8)
    heap_free(pout as *mut i8)
    if failures == 0 {
        print("PIREUS_SEDENION_OPERATOR_RUNTIME_PASS basis_pairs=256 components=4096\n")
        return 0
    }
    print("PIREUS_SEDENION_OPERATOR_RUNTIME_FAIL failures=")
    print_int(failures)
    print("\n")
    1
}
