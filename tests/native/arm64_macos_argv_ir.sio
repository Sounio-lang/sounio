use native::codegen_arm64_macos::{compile_arm64_macos_to_file}
use parser::ast::{make_name}
use ir::ir::*

fn emit(f: &!IrFunction, instr: IrInstr) with Mut, Panic, Div {
    ir_arena_store(ir_region_slot_w((*f).region, (*f).instr_count), instr)
    (*f).instr_count = (*f).instr_count + 1
}
fn main() with IO, Mut, Panic, Div, Alloc {
    var m = ir_empty_module()
    var f = ir_empty_function()
    f.name = make_name("main")
    f.reg_count = 8
    ir_function_alloc_region(&!f)
    emit(&!f, ir_call(0, 1, make_name("arg_count"), None, 0))
    emit(&!f, ir_call(1, 2, make_name("print_int"), Some(Box::new(ir_reg_list_single(0))), 1))
    emit(&!f, ir_load_imm(2, 10))
    emit(&!f, ir_call(3, 3, make_name("print_char"), Some(Box::new(ir_reg_list_single(2))), 1))
    emit(&!f, ir_load_imm(4, 1))
    emit(&!f, ir_call(5, 4, make_name("get_arg"), Some(Box::new(ir_reg_list_single(4))), 1))
    emit(&!f, ir_call(6, 5, make_name("println"), Some(Box::new(ir_reg_list_single(5))), 1))
    emit(&!f, ir_load_imm(7, 0))
    emit(&!f, ir_return(7))
    ir_module_fn_set(&!m, 0, f)
    var target = ir_empty_function()
    target.name = make_name("arg_count")
    ir_module_fn_set(&!m, 1, target)
    target.name = make_name("print_int")
    ir_module_fn_set(&!m, 2, target)
    target.name = make_name("print_char")
    ir_module_fn_set(&!m, 3, target)
    target.name = make_name("get_arg")
    ir_module_fn_set(&!m, 4, target)
    target.name = make_name("println")
    ir_module_fn_set(&!m, 5, target)
    m.fn_count = 6
    assert(compile_arm64_macos_to_file(&m, get_arg(0)) == 0)
}
