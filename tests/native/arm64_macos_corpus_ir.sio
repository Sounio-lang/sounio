use native::codegen_arm64_macos::{compile_arm64_macos_to_file}
use ir::ir::*
use parser::ast::{make_name, BinaryOp, UnaryOp}
fn emit(f: &!IrFunction, instr: IrInstr) with Mut, Panic, Div {
    ir_arena_store(ir_region_slot_w((*f).region, (*f).instr_count), instr)
    (*f).instr_count = (*f).instr_count + 1
}
fn output(f: &!IrFunction, reg: i64, target: i64) with Mut, Panic, Div, Alloc {
    emit(f, ir_call(50, target, make_name(""), Some(Box::new(ir_reg_list_single(reg))), 1))
    emit(f, ir_load_imm(51, 10))
    emit(f, ir_call(52, 3, make_name("print_char"), Some(Box::new(ir_reg_list_single(51))), 1))
}
fn main() with IO, Mut, Panic, Div, Alloc {
    var m = ir_empty_module()
    var f = ir_empty_function()
    f.name = make_name("main")
    f.reg_count = 64
    ir_function_alloc_region(&!f)
    emit(&!f, ir_alloc_array(0, 32, 4))
    emit(&!f, ir_load_imm(1, 2))
    emit(&!f, ir_load_imm(2, 77))
    emit(&!f, ir_index_set(0, 1, 2))
    emit(&!f, ir_index_get(3, 0, 1))
    output(&!f, 3, 1)
    emit(&!f, ir_unaryop(4, UnaryOp::OpRef, 0))
    var index = ir_index_get(5, 4, 1)
    index.label_id = 1
    emit(&!f, index)
    output(&!f, 5, 1)
    emit(&!f, ir_load_float(6, 2.25))
    output(&!f, 6, 2)
    emit(&!f, ir_unaryop(7, UnaryOp::OpNeg, 6))
    output(&!f, 7, 2)
    emit(&!f, ir_binop(8, 6, BinaryOp::OpGt, 7))
    output(&!f, 8, 1)
    emit(&!f, ir_load_fn_ref(9, 4))
    emit(&!f, ir_call_indirect(10, 9, Some(Box::new(ir_reg_list_single(6))), 1))
    output(&!f, 10, 2)
    var args: Option<Box<IrRegList>> = None
    var k: i64 = 0
    while k < 12 { args = Some(Box::new(ir_reg_list_cons(2, args))); k = k + 1 }
    emit(&!f, ir_call(11, 5, make_name("last12"), args, 12))
    output(&!f, 11, 1)
    emit(&!f, ir_alloc(13, 8))
    emit(&!f, ir_load_imm(14, 123))
    emit(&!f, ir_call_sret(15, 6, make_name("sret_one"), 13, 14, 1))
    emit(&!f, ir_field_get(16, 15, 0, make_name("value")))
    output(&!f, 16, 1)
    emit(&!f, ir_load_global(17, 16, make_name("counter")))
    output(&!f, 17, 1)
    emit(&!f, ir_store_global(2, 16, make_name("counter")))
    emit(&!f, ir_load_global(17, 16, make_name("counter")))
    output(&!f, 17, 1)
    emit(&!f, ir_load_bss_address(18, BSS_BASE_LINUX + 64))
    var raw_index = ir_index_get(19, 18, 1)
    raw_index.label_id = 2
    emit(&!f, raw_index)
    output(&!f, 19, 1)
    emit(&!f, ir_load_fn_ref(34, 14))
    emit(&!f, ir_alloc(35, 16))
    emit(&!f, ir_field_set(35, 0, 34, make_name("")))
    emit(&!f, ir_field_set(35, 1, 2, make_name("")))
    emit(&!f, ir_load_imm(36, 1))
    emit(&!f, ir_binop(37, 35, BinaryOp::OpBitOr, 36))
    emit(&!f, ir_call_indirect(38, 37, Some(Box::new(ir_reg_list_single(2))), 1))
    output(&!f, 38, 1)
    emit(&!f, ir_load_fn_ref(39, 15))
    emit(&!f, ir_field_set(35, 0, 39, make_name("")))
    var env_args: Option<Box<IrRegList>> = None
    var env_i: i64 = 0
    while env_i < 12 { env_args = Some(Box::new(ir_reg_list_cons(2, env_args))); env_i = env_i + 1 }
    emit(&!f, ir_call_indirect(40, 37, env_args, 12))
    output(&!f, 40, 1)
    emit(&!f, ir_load_imm(20, 10))
    emit(&!f, ir_load_float(21, 1.0))
    emit(&!f, ir_binop_typed(22, 21, BinaryOp::OpDiv, 20, true, true))
    output(&!f, 22, 2)
    emit(&!f, ir_load_string(23, 0, make_name("formal/lean4/SounioSatG529.lean")))
    emit(&!f, ir_call(24, 9, make_name("file_size"), Some(Box::new(ir_reg_list_single(23))), 1))
    emit(&!f, ir_call(25, 10, make_name("read_file"), Some(Box::new(ir_reg_list_single(23))), 1))
    emit(&!f, ir_call(26, 11, make_name("str_len"), Some(Box::new(ir_reg_list_single(25))), 1))
    emit(&!f, ir_binop(27, 24, BinaryOp::OpEq, 26))
    emit(&!f, ir_load_imm(28, 16777216))
    emit(&!f, ir_binop(29, 24, BinaryOp::OpGt, 28))
    emit(&!f, ir_binop(30, 27, BinaryOp::OpAnd, 29))
    output(&!f, 30, 1)
    emit(&!f, ir_load_float(31, 0.0))
    emit(&!f, ir_call(32, 12, make_name("sin"), Some(Box::new(ir_reg_list_single(31))), 1))
    output(&!f, 32, 2)
    let two_args = Some(Box::new(ir_reg_list_cons(21, Some(Box::new(ir_reg_list_single(21))))))
    emit(&!f, ir_call(33, 13, make_name("atan2"), two_args, 2))
    output(&!f, 33, 2)
    var raw_store = ir_index_set(18, 1, 2)
    raw_store.label_id = 2
    emit(&!f, raw_store)
    emit(&!f, raw_index)
    output(&!f, 19, 1)
    emit(&!f, ir_load_imm(12, 0))
    emit(&!f, ir_return(12))
    ir_module_fn_set(&!m, 0, f)
    var stub = ir_empty_function()
    stub.name = make_name("print_int")
    ir_module_fn_set(&!m, 1, stub)
    stub.name = make_name("print_f64")
    ir_module_fn_set(&!m, 2, stub)
    stub.name = make_name("print_char")
    ir_module_fn_set(&!m, 3, stub)
    var identity = ir_empty_function()
    identity.name = make_name("identity")
    identity.param_count = 1
    identity.param_regs[0] = 0
    identity.reg_count = 1
    identity.returns_float = 1
    ir_function_alloc_region(&!identity)
    emit(&!identity, ir_return(0))
    ir_module_fn_set(&!m, 4, identity)
    var last = ir_empty_function()
    last.name = make_name("last12")
    last.param_count = 12
    last.reg_count = 12
    k = 0
    while k < 12 { last.param_regs[k as usize] = k; k = k + 1 }
    ir_function_alloc_region(&!last)
    emit(&!last, ir_return(11))
    ir_module_fn_set(&!m, 5, last)
    var sret = ir_empty_function()
    sret.name = make_name("sret_one")
    sret.param_count = 1
    sret.param_regs[0] = 1
    sret.is_sret = 1
    sret.sret_dest_reg = 0
    sret.reg_count = 2
    ir_function_alloc_region(&!sret)
    emit(&!sret, ir_field_set(0, 0, 1, make_name("value")))
    emit(&!sret, ir_return_sret(0))
    ir_module_fn_set(&!m, 6, sret)
    var global = ir_empty_function()
    global.name = make_name("counter")
    global.compile_strategy = IR_STRATEGY_BSS_GLOBAL
    global.param_count = 16
    global.bss_size = 8
    global.returns_float = 1
    global.prof_counter_id = 123456
    ir_module_fn_set(&!m, 7, global)
    global.name = make_name("array")
    global.param_count = 64
    global.bss_size = 32
    global.prof_counter_id = 7
    ir_module_fn_set(&!m, 8, global)
    stub.name = make_name("file_size")
    ir_module_fn_set(&!m, 9, stub)
    stub.name = make_name("read_file")
    ir_module_fn_set(&!m, 10, stub)
    stub.name = make_name("str_len")
    ir_module_fn_set(&!m, 11, stub)
    stub.name = make_name("sin")
    stub.returns_float = 1
    ir_module_fn_set(&!m, 12, stub)
    stub.name = make_name("atan2")
    ir_module_fn_set(&!m, 13, stub)
    var captured = ir_empty_function()
    captured.name = make_name("captured_add")
    captured.param_count = 2
    captured.param_regs[0] = 0
    captured.param_regs[1] = 1
    captured.reg_count = 4
    ir_function_alloc_region(&!captured)
    emit(&!captured, ir_field_get(2, 0, 1, make_name("")))
    emit(&!captured, ir_binop(3, 2, BinaryOp::OpAdd, 1))
    emit(&!captured, ir_return(3))
    ir_module_fn_set(&!m, 14, captured)
    var captured_stack = ir_empty_function()
    captured_stack.name = make_name("captured_stack_add")
    captured_stack.param_count = 13
    captured_stack.reg_count = 15
    k = 0
    while k < 13 { captured_stack.param_regs[k as usize] = k; k = k + 1 }
    ir_function_alloc_region(&!captured_stack)
    emit(&!captured_stack, ir_field_get(13, 0, 1, make_name("")))
    emit(&!captured_stack, ir_binop(14, 13, BinaryOp::OpAdd, 12))
    emit(&!captured_stack, ir_return(14))
    ir_module_fn_set(&!m, 15, captured_stack)
    m.fn_count = 16
    print_int(compile_arm64_macos_to_file(&m, get_arg(0)) as i64)
    print("\n")
}
