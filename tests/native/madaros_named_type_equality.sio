use check::epistemic::{types_equal}
use check::check::*
use check::types::{ty_named, ty_i64, ty_f64}
use parser::ast::{make_name}
fn main() with IO, Mut, Panic, Div, Alloc {
    var left = ty_named(make_name("Chemical"))
    var right = ty_named(make_name("Chemical"))
    assert(types_equal(left, right))
    assert(!types_equal(left, ty_named(make_name("OtherChemical"))))
    left.ontology_id = 1
    right.ontology_id = 2
    assert(!types_equal(left, right))
    right.ontology_id = 1
    left.inner = Some(Box::new(ty_i64()))
    assert(!types_equal(left, right))
    right.inner = Some(Box::new(ty_i64()))
    assert(types_equal(left, right))
    right.inner = Some(Box::new(ty_f64()))
    assert(!types_equal(left, right))
    print("named type equality: PASS\n")
}
