//@ run-pass
// Phase 6 M1: Struct allocation and field access via native backend
//
// Creates a struct, sets fields, reads them back, and returns the sum
// as the exit code.  When compiled by the self-hosted native backend
// and executed, the process should exit with code 42.

struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    let p = Point { x: 17, y: 25 }
    return p.x + p.y
}
