use lexer::mod::{lex_file_parse_items}
use check::specializer::{specialize_generics, spec_report_any_specializer_failure}
use parser::ast::*
fn main() with IO, Mut, Panic, Div, Alloc {
    let items = specialize_generics(lex_file_parse_items("tests/run-pass/closure_generic_hof.sio"))
    assert(!spec_report_any_specializer_failure())
    var current = &items
    var checked: bool = false
    while true {
        match *current {
            Some(node) => {
                if str_from_bytes((*node).head.name.buf, (*node).head.name.len) == "apply_t" {
                    match (*node).head.fn_def {
                        Some(fd) => {
                            match (*fd).params {
                                Some(first) => {
                                    match (*first).head.ty.inner {
                                        Some(returned) => {
                                            let leaf = str_from_bytes((*returned).path.segments.head_buf, (*returned).path.segments.head_len)
                                            print("callback_return=")
                                            print(leaf)
                                            print("\n")
                                            assert(leaf == "i64")
                                        }
                                        None => assert(false),
                                    }
                                    match (*first).head.ty.type_args {
                                        Some(arg_types) => {
                                            let leaf = str_from_bytes((*arg_types).head.path.segments.head_buf, (*arg_types).head.path.segments.head_len)
                                            print("callback_param=")
                                            print(leaf)
                                            print("\n")
                                            assert(leaf == "i64")
                                        }
                                        None => assert(false),
                                    }
                                }
                                None => assert(false),
                            }
                            match (*fd).return_type {
                                Some(ty) => {
                                    let name = str_from_bytes((*ty).path.segments.head_buf, (*ty).path.segments.head_len)
                                    print("return=")
                                    print(name)
                                    print("\n")
                                    assert(name == "i64")
                                    checked = true
                                }
                                None => assert(false),
                            }
                        }
                        None => assert(false),
                    }
                }
                current = &(*node).tail
            }
            None => break,
        }
    }
    assert(checked)
    print("scalar specializer: PASS\n")
}
