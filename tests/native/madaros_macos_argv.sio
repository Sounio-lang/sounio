// Executed with explicit argv by madaros_macos_arm64_acceptance_gate.sh.
// Like Linux, the argument count and indices exclude the executable name.
var argv_global_marker: i64 = 73

pub fn main() -> i64 with IO, Mut, Panic, Div {
    if argv_global_marker != 73 { return 1 }
    let argc = arg_count()
    print_int(argc)
    println("")
    if argc > 0 { println(get_arg(0)) }
    if argc > 1 { println(get_arg(1)) }
    0
}
