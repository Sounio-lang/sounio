// #1161 fixture for scripts/ci/madaros_ir_roundtrip_gate.sh -- NOT a run-pass
// test. A module-level global (a BSS-global IR function with bss_size) and an
// extern "C" call returning f64 (returns_float). The SOIR reader hard-codes
// both fields to 0, so `madaros --ir-roundtrip` must refuse this program.
// Before #1161 the duplicate v2 writer printed "ir-roundtrip: OK".
var G: f64 = 0.5

extern "C" { fn floor(x: f64) -> f64 }

fn half(x: f64) -> f64 { x * G }

fn main() -> i64 with IO, Mut {
    G = 0.25
    let y = floor(7.9)
    println(half(8.0) + y)
    0
}
