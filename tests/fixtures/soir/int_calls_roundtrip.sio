// #1161 fixture for scripts/ci/madaros_ir_roundtrip_gate.sh -- NOT a run-pass
// test. Integer-only functions with call arguments and `-> i64` returns: the
// SOIR v2 encoding drops call-argument registers and return_struct_name, so
// --ir-roundtrip / --ir-dump must refuse it (they used to print OK).
fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn scale(x: i64, k: i64) -> i64 {
    if x > 10 { x * k } else { add(x, k) }
}

fn main() -> i64 with IO {
    let s = scale(add(3, 4), 5)
    print_int(s)
    0
}
