// #1161 fixture for scripts/ci/madaros_ir_roundtrip_gate.sh -- NOT a run-pass
// test. Call arguments, integer lets (float_reg_bits words) and an extern call:
// all carried by SOIR v6 (ir/serialize.sio) and dropped by the old v2 writer
// that compiler/main.sio used to keep, so --ir-roundtrip refused this before
// and proves a byte-identical decode/re-encode now. Unit-returning functions
// only: a named return type sets return_struct_name, which v6 does not carry.
fn add_and_print(a: i64, b: i64) with IO {
    let c = a + b
    if c > 3 {
        print_int(c)
    }
}

fn main() with IO {
    add_and_print(1, 2)
    let x = 5
    add_and_print(x, 4)
}
