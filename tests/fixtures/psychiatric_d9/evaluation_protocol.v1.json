{
  "schema_version": "psychiatric-d9-evaluation-protocol/v1",
  "protocol_id": "uci373-benzos-recent-fixed-score-v1",
  "status": "prespecified-before-full-dataset-analysis",
  "declared_on": "2026-07-19",
  "dataset": {
    "dataset_id": "uci-ml-repository-373",
    "doi": "10.24432/C5TC7S",
    "file": "uci_drug_consumption_373.data",
    "row_id_column_zero_based": 0,
    "column_count": 32
  },
  "target": {
    "kind": "finite_dataset_response_evaluation",
    "population": "eligible respondents present in the frozen UCI 373 file",
    "external_population_generalization": false,
    "patient_state_target": false,
    "clinical_action_target": false
  },
  "eligibility": {
    "semeron_column_zero_based": 30,
    "required_value": "CL0",
    "meaning": "exclude records reporting use of the fictitious Semeron control"
  },
  "partition": {
    "method": "row_id_modulo_5",
    "development_remainders": [0, 1, 2],
    "calibration_remainders": [3],
    "evaluation_remainders": [4],
    "uses_outcome": false
  },
  "outcome": {
    "column_name": "Benzos",
    "column_zero_based": 16,
    "recent_classes": ["CL4", "CL5", "CL6"],
    "nonrecent_classes": ["CL0", "CL1", "CL2", "CL3"],
    "meaning": "self-reported benzodiazepine use recency category",
    "not_medication_response": true,
    "not_diagnosis": true
  },
  "fixed_score": {
    "formula": "Nscore + Impulsive + SS",
    "terms": [
      {"column_name": "Nscore", "column_zero_based": 6, "coefficient": 1},
      {"column_name": "Impulsive", "column_zero_based": 11, "coefficient": 1},
      {"column_name": "SS", "column_zero_based": 12, "coefficient": 1}
    ],
    "fitted_from_dataset": false
  },
  "prediction_set": {
    "nonrecent_only_when_score_lte": -1.0,
    "recent_only_when_score_gte": 1.0,
    "otherwise": "both_labels",
    "nonrecent_mask": 1,
    "recent_mask": 2,
    "both_mask": 3
  },
  "coverage_gate": {
    "calibration_minimum_numerator": 3,
    "calibration_minimum_denominator": 4,
    "evaluation_minimum_numerator": 3,
    "evaluation_minimum_denominator": 4,
    "comparison": "exact_cross_multiplication",
    "permille_is_diagnostic_only": true
  },
  "support_gate": {
    "bands": ["score_lte_minus_1", "score_between", "score_gte_plus_1"],
    "require_each_evaluation_band_in_calibration": true,
    "causal_positivity_claim": false,
    "treatment_overlap_claim": false
  },
  "binding_gate": {
    "external_source_hash_required": true,
    "license_declaration_required": true,
    "metrological_instrument_calibration_available": false,
    "collection_window_verified": false,
    "external_custody_sealed": false,
    "sealed_validation_available": false,
    "expected_result": "abstain_from_empirical_binding"
  },
  "forbidden_claims": [
    "population prevalence",
    "individual conditional coverage",
    "causal treatment effect",
    "benzodiazepine response",
    "diagnosis or patient state",
    "prescribing or clinical action authority",
    "verified consent or clinical custody"
  ]
}
