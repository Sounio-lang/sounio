// Private qualification snapshot only. Production Storage sources are unchanged.
use parser::ast::{Item,empty_path,visibility_private,make_name}
use check::defs::{StructInfo,FieldInfo,FieldInfoList,struct_table_alloc,enum_table_alloc}
use check::compat::{types_compatible}
use compiler::module_parse::{load_module_file}
use parser::parser::{parser_last_error_count}
fn audit_items(item:Item,count:i64)->Option<Box<ItemList>> with Mut,Panic,Div,Alloc {
 var head:Option<Box<ItemList>> = None
 var i:i64=0
 while i<count {head=Some(Box::new(ItemList {head:item,tail:head}));i=i+1}
 head
}
fn audit_row(label:string,value:i64) with IO {print(label);print("\t");print_int(value);print("\n")}
pub fn storage_audit_component(path:string)->i32 with Mut,Panic,Div,Alloc,IO {
 let structs=struct_table_alloc()
 let enums=enum_table_alloc()
 (*structs).entries[0]=StructInfo {name:make_name("ScalarOwner"),fields:Some(Box::new(FieldInfoList {head:FieldInfo {name:make_name("private_payload"),ty:ty_i64(),is_pub:false},tail:None})),field_count:1,is_linear:false,type_param_count:0,type_param_names:[make_name("");8],is_generic_template:false,visibility_kind:0,defining_module_id:0,visibility:visibility_private(),defining_module:empty_path()}
 (*structs).count=1
 let program=load_module_file(path)
 assert(parser_last_error_count()==0)
 var source:Option<Box<ItemList>> = None
 match program.items {Some(first)=>{(*first).head.origin_module_id=0;source=Some(first)},None=>return 1}
 var selected:Option<Box<ItemList>> = None
 match source {Some(first)=>{selected=audit_items((*first).head,4352)},None=>return 1}
 let scalar_ty=ty_i64()
 let named_ty=ty_named(make_name("ScalarOwner"))
 let boundary=storage_types_begin(structs,enums,selected)
 audit_row("source4352_live",if storage_context_live(&boundary) {1} else {0})
 audit_row("source4352_count",STORAGE_SOURCE_COUNT)
 match source {Some(first)=>{selected=audit_items((*first).head,4353)},None=>return 1}
 let overflow=storage_types_begin(structs,enums,selected)
 audit_row("source4353_live",if storage_context_live(&overflow) {1} else {0})
 audit_row("source4353_count",STORAGE_SOURCE_COUNT)
 audit_row("source4353_scalar_state",storage_element_state(&overflow,&scalar_ty))
 audit_row("source4353_nominal_state",storage_element_state(&overflow,&named_ty))
 let ctx=storage_types_begin(structs,enums,source)
 let nominal=storage_type_resolve(&ctx,ty_named(make_name("ScalarOwner")))
 match (*structs).entries[0].fields {Some(field)=>{(*field).head.ty=ty_f64()},None=>return 1}
 audit_row("same_epoch_field_mutation_state",storage_element_state(&ctx,&named_ty))
 let fresh_nominal=storage_type_resolve(&ctx,named_ty)
 match nominal {Some(a)=>{audit_row("same_epoch_field_mutation_equal",if storage_resolved_equal(&ctx,&(*a),&(*a)) {1} else {0});match fresh_nominal {Some(b)=>{audit_row("same_epoch_field_mutation_old_new_equal",if storage_resolved_equal(&ctx,&(*a),&(*b)) {1} else {0})},None=>return 1}},None=>return 1}
 match (*structs).entries[0].fields {Some(field)=>{(*field).head.ty=ty_ref(ty_i64())},None=>return 1}
 audit_row("same_epoch_ref_mutation_state",storage_element_state(&ctx,&named_ty))
 match nominal {Some(a)=>{audit_row("same_epoch_ref_mutation_old_equal",if storage_resolved_equal(&ctx,&(*a),&(*a)) {1} else {0})},None=>return 1}
 match (*structs).entries[0].fields {Some(field)=>{(*field).head.ty=ty_i64()},None=>return 1}
 let empty_owner=ty_storage_unresolved(ty_unit())
 audit_row("compat_direct_storage",if types_compatible(empty_owner,empty_owner) {1} else {0})
 let tuple=ty_tuple(TypeEntryList {head:empty_owner,tail:None})
 audit_row("compat_tuple_storage_self",if types_compatible(tuple,tuple) {1} else {0})
 audit_row("compat_tuple_storage_unknown",if types_compatible(tuple,ty_unknown()) {1} else {0})
 audit_row("compat_array_storage_unknown",if types_compatible(ty_array(empty_owner,1),ty_unknown()) {1} else {0})
 audit_row("compat_tuple_storage_error",if types_compatible(tuple,ty_error()) {1} else {0})
 audit_row("compat_array_storage_error",if types_compatible(ty_array(empty_owner,1),ty_error()) {1} else {0})
 var named_storage=ty_named(make_name("Carrier"));named_storage.inner=Some(Box::new(empty_owner))
 var named_int=ty_named(make_name("Carrier"));named_int.inner=Some(Box::new(ty_i64()))
 audit_row("compat_named_storage_unknown",if types_compatible(named_storage,ty_unknown()) {1} else {0})
 audit_row("compat_named_storage_error",if types_compatible(named_storage,ty_error()) {1} else {0})
 audit_row("compat_named_storage_self",if types_compatible(named_storage,named_storage) {1} else {0})
 audit_row("compat_named_inner_storage_int",if types_compatible(named_storage,named_int) {1} else {0})
 var phantom=ty_named(make_name("ScalarOwner"));phantom.inner=Some(Box::new(ty_i64()))
 audit_row("concrete_nominal_extra_inner_state",storage_element_state(&ctx,&phantom))
 var tuple_extent=ty_tuple(TypeEntryList {head:ty_i64(),tail:None})
 let tuple_before=storage_type_resolve(&ctx,tuple_extent)
 tuple_extent.array_size=17
 audit_row("tuple_extra_extent_state",storage_element_state(&ctx,&tuple_extent))
 let tuple_after=storage_type_resolve(&ctx,tuple_extent)
 match tuple_before {Some(a)=>{match tuple_after {Some(b)=>{audit_row("tuple_extra_extent_equal",if storage_resolved_equal(&ctx,&(*a),&(*b)) {1} else {0})},None=>return 1}},None=>return 1}
 STORAGE_CONTEXT_NODES=65535
 let last=storage_type_resolve(&ctx,ty_i64())
 audit_row("identity_last_succeeds",match last {Some(_)=>1,None=>0})
 audit_row("identity_count_at_limit",STORAGE_CONTEXT_NODES)
 audit_row("identity_after_limit_succeeds",match storage_type_resolve(&ctx,ty_i64()) {Some(_)=>1,None=>0})
 audit_row("identity_count_after_refusal",STORAGE_CONTEXT_NODES)
 STORAGE_CONTEXT_NODES=65534
 let partial=storage_type_resolve(&ctx,ty_tuple(TypeEntryList {head:ty_i64(),tail:None}))
 audit_row("identity_partial_published",match partial {Some(_)=>1,None=>0})
 audit_row("identity_partial_count",STORAGE_CONTEXT_NODES)
 let next=storage_types_begin(structs,enums,source)
 match nominal {Some(a)=>{audit_row("old_context_after_begin",if storage_resolved_equal(&ctx,&(*a),&(*a)) {1} else {0});audit_row("old_wrapper_new_context",if storage_resolved_equal(&next,&(*a),&(*a)) {1} else {0})},None=>return 1}
 println("STORAGE_CLOSED_AUDIT_CAPTURED")
 0
}
