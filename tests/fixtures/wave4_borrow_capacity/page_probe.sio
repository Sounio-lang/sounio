use parser::ast::{make_name}
use check::borrow::*
fn main()->i32 with IO,Alloc,Mut,Panic,Div {
 var env=borrow_env_new()
 println("INIT")
 println(env.arena);println(env.count);println(borrow_failure_kind(&env))
 env=env.push_scope()
 println("SCOPE");println(env.scope_depth);println(borrow_failure_kind(&env))
 env=env.track(make_name("a"),false)
 println("ONE");println(env.count);println(env.entry_root);println(env.binding_root);println(env.name_root);println(borrow_failure_kind(&env))
 let e=borrow_entry_get(&env,0)
 println(e.binding_id);println(e.name.len);println(e.state)
 println("FIND");println(env.find(make_name("a")));println(borrow_binding_id(&env,make_name("a")));println(borrow_failure_kind(&env))
 env=env.track(make_name("b"),false)
 println("TWO");println(env.count);println(borrow_binding_id(&env,make_name("b")));println(borrow_failure_kind(&env))
 return 0
}
