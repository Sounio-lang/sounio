use parser::ast::{Name,make_name}
use check::borrow::*
fn numbered(n:i64)->Name with Mut,Panic,Div {
 var out=Name{buf:[0;384],len:5}
 out.buf[0]=99 as i8
 var value=n;var i:i64=1
 while i<5 {out.buf[i as usize]=(65+value%26) as i8;value=value/26;i=i+1}
 out
}
fn test_entry_fields(base:&BorrowEnv) with IO,Alloc,Mut,Panic,Div {
 {
 var changed=borrow_entry_get(base,0)
 changed.state=2
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.state=7
 assert(borrow_entry_get(base,0).state==0)
 assert(borrow_entry_get(&next,0).state==2)
 var observed=borrow_entry_get(&next,0)
 observed.state=7
 assert(borrow_entry_get(&next,0).state==2)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.shared_count=2
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.shared_count=7
 assert(borrow_entry_get(base,0).shared_count==0)
 assert(borrow_entry_get(&next,0).shared_count==2)
 var observed=borrow_entry_get(&next,0)
 observed.shared_count=7
 assert(borrow_entry_get(&next,0).shared_count==2)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.loan_live=false
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.loan_live=true
 assert(borrow_entry_get(base,0).loan_live==true)
 assert(borrow_entry_get(&next,0).loan_live==false)
 var observed=borrow_entry_get(&next,0)
 observed.loan_live=true
 assert(borrow_entry_get(&next,0).loan_live==false)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.loan_temporary=true
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.loan_temporary=false
 assert(borrow_entry_get(base,0).loan_temporary==false)
 assert(borrow_entry_get(&next,0).loan_temporary==true)
 var observed=borrow_entry_get(&next,0)
 observed.loan_temporary=false
 assert(borrow_entry_get(&next,0).loan_temporary==true)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.loan_pinned=true
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.loan_pinned=false
 assert(borrow_entry_get(base,0).loan_pinned==false)
 assert(borrow_entry_get(&next,0).loan_pinned==true)
 var observed=borrow_entry_get(&next,0)
 observed.loan_pinned=false
 assert(borrow_entry_get(&next,0).loan_pinned==true)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.is_affine=true
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.is_affine=false
 assert(borrow_entry_get(base,0).is_affine==false)
 assert(borrow_entry_get(&next,0).is_affine==true)
 var observed=borrow_entry_get(&next,0)
 observed.is_affine=false
 assert(borrow_entry_get(&next,0).is_affine==true)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.is_linear=true
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.is_linear=false
 assert(borrow_entry_get(base,0).is_linear==false)
 assert(borrow_entry_get(&next,0).is_linear==true)
 var observed=borrow_entry_get(&next,0)
 observed.is_linear=false
 assert(borrow_entry_get(&next,0).is_linear==true)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.consumed=true
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.consumed=false
 assert(borrow_entry_get(base,0).consumed==false)
 assert(borrow_entry_get(&next,0).consumed==true)
 var observed=borrow_entry_get(&next,0)
 observed.consumed=false
 assert(borrow_entry_get(&next,0).consumed==true)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.scope_depth=7
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.scope_depth=9
 assert(borrow_entry_get(base,0).scope_depth==1)
 assert(borrow_entry_get(&next,0).scope_depth==7)
 var observed=borrow_entry_get(&next,0)
 observed.scope_depth=9
 assert(borrow_entry_get(&next,0).scope_depth==7)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.provenance=7
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 changed.provenance=9
 assert(borrow_entry_get(base,0).provenance==0)
 assert(borrow_entry_get(&next,0).provenance==7)
 var observed=borrow_entry_get(&next,0)
 observed.provenance=9
 assert(borrow_entry_get(&next,0).provenance==7)
 }
 {
 var changed=borrow_entry_get(base,0)
 changed.binding_id=777
 assert(borrow_entry_get(base,0).binding_id==1)
 }
 {
 var changed=borrow_entry_get(base,0)
 var name=changed.name
 name.buf[0]=122 as i8
 changed.name=name
 let next=borrow_entry_set(borrow_env_clone(base),0,changed)
 name.buf[0]=121 as i8
 changed.name=name
 assert(borrow_entry_get(base,0).name.buf[0]==99 as i8)
 assert(borrow_entry_get(&next,0).name.buf[0]==122 as i8)
 var observed=borrow_entry_get(&next,0)
 var observed_name=observed.name
 observed_name.buf[0]=120 as i8
 observed.name=observed_name
 assert(borrow_entry_get(&next,0).name.buf[0]==122 as i8)
 }
 println("ENTRY_ALL_FIELDS_IMMUTABLE")
}

fn main()->i32 with IO,Alloc,Mut,Panic,Div {
 var env=borrow_env_new()
 env=env.push_scope()
 var i:i64=0
 while i<512 {env=env.track(numbered(i),false);i=i+1}
 assert(borrow_failure_kind(&env)==0 && env.count==512)
 assert(borrow_binding_index(&env,1)==0 && borrow_binding_index(&env,512)==511)
 let saved=env
 test_entry_fields(&saved)
 env=env.set_provenance(numbered(0),7)
 assert(env.provenance_of(numbered(0))==7)
 assert(saved.provenance_of(numbered(0))==0)
 let original_id=borrow_binding_id(&env,numbered(0))
 env=env.push_scope()
 env=env.track(numbered(0),false)
 let shadow_id=borrow_binding_id(&env,numbered(0))
 assert(shadow_id!=original_id)
 env=env.pop_scope()
 assert(borrow_binding_id(&env,numbered(0))==original_id)
 assert(!borrow_binding_live(&env,shadow_id))
 env=env.track(make_name("replacement"),false)
 assert(!borrow_binding_live(&env,shadow_id))
 let token=make_name("token")
 env=env.track(token,true)
 let token_id=borrow_binding_id(&env,token)
 i=0
 while i<24 {env=borrow_branch_enter(env);i=i+1}
 let moved=env.consume_linear(token)
 env=moved.0
 assert(moved.1==0)
 i=0
 while i<24 {
  env=borrow_branch_then_done(env)
  let other=env.consume_linear(token)
  env=other.0
  assert(other.1==0)
  let both=borrow_branch_then(&env,token_id) && borrow_entry_get(&env,borrow_binding_index(&env,token_id)).consumed
  assert(both && !borrow_branch_before(&env,token_id))
  env=borrow_set_consumed(env,token_id,both)
  env=borrow_branch_leave(env)
  i=i+1
 }
 assert(env.branch_depth==0 && borrow_failure_kind(&env)==0)
 assert(borrow_entry_get(&env,borrow_binding_index(&env,token_id)).consumed)
 var graph=borrow_env_new()
 graph=graph.push_scope()
 let owner=make_name("owner")
 graph=graph.track(owner,false)
 i=0
 while i<4097 {
  let name=numbered(i)
  graph=graph.track(name,false)
  graph=borrow_persist_owner(graph,name,owner,1)
  i=i+1
 }
 assert(borrow_failure_kind(&graph)==0 && graph.loan_count==4097)
 assert(borrow_persistent_state(&graph,owner)==1)
 let graph_snapshot=graph
 graph=graph.pop_scope()
 assert(graph.count==0 && borrow_persistent_state(&graph,owner)==0)
 assert(borrow_persistent_state(&graph_snapshot,owner)==1)
 assert(borrow_entry_guards_ok(&saved))
 assert(borrow_entry_guards_ok(&env))
 assert(borrow_entry_guards_ok(&graph_snapshot))
 var compact=borrow_env_new().push_scope().push_scope()
 compact=compact.track(make_name("compact_owner"),false)
 let compact_owner=borrow_binding_id(&compact,make_name("compact_owner"))
 let source=borrow_sources_add(0,compact_owner,1)
 compact=borrow_add_temporary(compact,source)
 let temporary_id=borrow_entry_get(&compact,1).binding_id
 compact=compact.track(make_name("survivor"),false)
 let survivor_id=borrow_binding_id(&compact,make_name("survivor"))
 let compact_before=borrow_env_clone(&compact)
 compact=borrow_end_temporaries_since(compact,0)
 compact=borrow_compact_temporaries(compact)
 assert(compact.count==2 && borrow_binding_index(&compact,survivor_id)==1)
 assert(!borrow_binding_live(&compact,temporary_id))
 assert(compact_before.count==3 && borrow_binding_index(&compact_before,survivor_id)==2)
 assert(borrow_binding_live(&compact_before,temporary_id))
 assert(borrow_entry_get(&compact_before,1).loan_live)
 assert(borrow_failure_kind(&compact)==0 && borrow_entry_guards_ok(&compact))
 println("PRIVATE_COMPACTION_RELOCATION_OK")
 println("ENTRY_CELL_GUARDS_OK")
 println("BORROW_COMPONENT_OK entries=512 loans=4097 branches=24 immutable_forks=1")
 return 0
}
