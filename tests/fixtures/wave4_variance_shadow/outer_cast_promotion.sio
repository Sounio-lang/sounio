// Draft semantic refusal: cast is not closed integer proof.
// A parse/check failure is unsupported coverage, never a refusal pass.
struct Boxed { x: i64 }
impl Boxed { fn read(self: &Boxed) -> i64 { self.x } }
fn opaque(x: i64) -> i64 { x }
fn tested(seed: i64) -> i64 with Mut {
    var s = seed
    if s == 0 { s = 1 }
    if seed != 0 { s = (1.5 as i64) }
    s
}
fn main() -> i32 with IO, Mut, Alloc, Div, Panic {
    print_int(tested(5)); print("\n")
    0
}
