// Draft qualification input. C++23 independently checks every output row.
fn core(seed: i64) -> i64 with Mut {
    var s = seed
    if s == 0 { s = 1 }
    s = s * 3 + 1
    s
}
fn aliases(seed: i64) -> i64 with Mut {
    let initial = seed
    var s = initial
    if s == 0 { s = 1 }
    let a = s + 2
    let b = a * 3 - 1
    b
}
fn nested(seed: i64) -> i64 with Mut {
    var s = seed
    if s == 0 { if seed == 0 { s = 1 } }
    var i: i64 = 0
    while i < 3 { s = s * 3 + 1; i = i + 1 }
    s
}
fn emit(seed: i64) with IO, Mut {
    print_int(seed); print(" ")
    print_int(core(seed)); print(" ")
    print_int(aliases(seed)); print(" ")
    print_int(nested(seed)); print("\n")
}
fn main() -> i32 with IO, Mut {
    emit(0); emit(1); emit(5); emit(0 - 1)
    emit(0 - 5); emit(17); emit(1024)
    0
}
