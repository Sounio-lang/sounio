// Fully concrete. No Option, None, generic inference, raw cast or FFI.
// Capture scalars before/after the Sounio clobber; print only after both reads.
fn nested(v:i64,mark:i64,outer:i64)->((i64,i64),i64) with Mut,Alloc { ((v,mark),outer) }
fn clobber(seed:i64)->i64 with Mut,Panic,Div,Alloc {
 var a:[i64;512]=[0;512]
 var i:i64=0
 while i<512 { a[i as usize]=seed+i; i=i+1 }
 var sum:i64=0
 i=0
 while i<512 { sum=sum+a[i as usize]; i=i+1 }
 sum
}
fn row(id:i64,value:i64,marker:i64,outer:i64,checksum:i64) with IO {
 print(id);print(" ");print(value);print(" ");print(marker);print(" ")
 print(outer);print(" ");println(checksum)
}

fn main()->i32 with IO,Mut,Panic,Div,Alloc {
 let a:((i64,i64),i64)=nested(42,1,7)
 let before0:i64=(a.0).0
 let before1:i64=(a.0).1
 let before2:i64=a.1
 let checksum0:i64=clobber(100)
 let after0:i64=(a.0).0
 let after1:i64=(a.0).1
 let after2:i64=a.1
 row(0,before0,before1,before2,0)
 row(1,after0,after1,after2,checksum0)
 let b:((i64,i64),i64)=nested(0-9,0,8)
 let before3:i64=(b.0).0
 let before4:i64=(b.0).1
 let before5:i64=b.1
 let checksum1:i64=clobber(101)
 let after3:i64=(b.0).0
 let after4:i64=(b.0).1
 let after5:i64=b.1
 row(2,before3,before4,before5,0)
 row(3,after3,after4,after5,checksum1)
 0
}
