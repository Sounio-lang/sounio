struct Ghost<T> { value:i64 }
impl Ghost<T> {
 fn get(self:&Ghost<T>,index:i64)->T {0}
 fn push(self:&!Ghost<T>,value:T) {}
}
struct Word { value:i64 }
impl Word {fn get(self:&Word,index:i64)->i64 {self.value+index}}
struct FloatWord { value:f64 }
impl FloatWord {fn get(self:&FloatWord,index:i64)->f64 {self.value}}
fn make_word()->Word {Word {value:17}}
fn make_float()->FloatWord {FloatWord {value:2.5}}
struct Other<T> {value:i64}
impl Other<T> {fn get(self:&Other<T>,index:i64)->T {0}}
fn main()->i32 {let a=make_word();if a.get(0)!=17 {return 1};0}
