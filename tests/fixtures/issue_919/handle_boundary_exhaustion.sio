//@ run-fail

// The 1,048,576th allocation has no representable nonzero handle ID. The
// default x86-64 Linux Core-IR emitter must terminate with status 182 before it
// can reset handle_count, recycle ID 1, or reach the marker below.
struct Issue919Cell {
    value: i64,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var i: i64 = 0
    var last: i64 = -1
    while i < 1048576 {
        let cell = Issue919Cell { value: i }
        last = cell.value
        i = i + 1
    }
    print("ISSUE_919_HANDLE_EXHAUSTION_UNREACHABLE\n")
    if last == 1048575 {
        return 91
    }
    92
}
