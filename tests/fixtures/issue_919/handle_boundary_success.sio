//@ run-pass

// The native-v2 table reserves handle ID 0, so capacity 1,048,576 exposes
// exactly IDs 1 through 1,048,575. This fixture must finish on the last usable
// ID without taking either allocation slow path.
struct Issue919Cell {
    value: i64,
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    var i: i64 = 0
    var last: i64 = -1
    while i < 1048575 {
        let cell = Issue919Cell { value: i }
        last = cell.value
        i = i + 1
    }
    if last != 1048574 {
        return 90
    }
    print("ISSUE_919_HANDLE_BOUNDARY_SUCCESS allocations=1048575\n")
    0
}
