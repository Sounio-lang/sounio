use parser::ast::*
use lexer::span::Span
use check::types::*
use check::env::*
use check::binding_stamp::{binding_stamp_is_plain_i64,binding_stamp_checked_i64}

fn expr(value:i64)->Expr with Mut,Panic,Div {
    Expr {kind:ExprKind::ExprIntLit,span:Span {file_id:7 as i32,start:31,end:79},int_val:value,float_val:0.0,
        f128_lit_lo:0,f128_lit_hi:0,f128_lit_exact:false,name:empty_name(),path:empty_path(),bin_op:BinaryOp::OpAdd,un_op:UnaryOp::OpNeg,
        left:None,right:None,block:None,else_expr:None,args:None,arms:None,fields:None,cast_type:None,handler_block:None,
        closure_params:None,closure_return:None,closure_effects:None,closure_body:None,type_args:None}
}
fn node()->Box<StmtList> with Mut,Panic,Div,Alloc {
    Box::new(StmtList {head:Stmt {kind:StmtKind::StmtLet,span:Span {file_id:7 as i32,start:31,end:79},name:make_name("status"),ty:None,
        expr:Some(Box::new(expr(-7000000001))),target:None,assign_op:AssignOp::AssignEq},tail:None})
}
fn classifier_controls()->i64 with Mut,Panic,Div,Alloc {
    if !binding_stamp_is_plain_i64(ty_i64()) {return 1}
    var i:i64=0
    while i<36 {
        var t=ty_i64()
        if i==0 {t.kind=TypeKind::TyF64}
        if i==1 {t.name=make_name("i64")}
        if i==2 {t.name.buf[383]=1 as i8}
        if i==3 {t.inner=Some(Box::new(ty_i64()))}
        if i==4 {t.tuple_elems=Some(Box::new(TypeEntryList {head:ty_i64(),tail:None}))}
        if i==5 {t.array_size=0}
        if i==6 {t.fn_sig_id=0}
        if i==7 {t.knowledge_epsilon=0.0}
        if i==8 {t.knowledge_validity_value=-0.0}
        if i==9 {t.knowledge_epsilon_mode=1}
        if i==10 {t.knowledge_provenance_kind=0}
        if i==11 {t.knowledge_validity_kind=0}
        if i==12 {t.algebra_kind=0}
        if i==13 {t.clifford_p=0}
        if i==14 {t.clifford_q=0}
        if i==15 {t.unit_id=0}
        if i==16 {t.refinement_id=0}
        if i==17 {t.epistemic_meta_id=0}
        if i==18 {t.robustness_level_id=0}
        if i==19 {t.robustness_scope_id=0}
        if i==20 {t.ontology_id=0}
        if i==21 {t.noise_set_id=0}
        if i==22 {t.kind=TypeKind::TyUnknown}
        if i==23 {t.kind=TypeKind::TyKnowledge}
        if i==24 {t.kind=TypeKind::TyRawPtr}
        if i==25 {t.kind=TypeKind::TyError}
        if i==26 {t.kind=TypeKind::TyRef}
        if i==27 {t.kind=TypeKind::TyRefMut}
        if i==28 {t.kind=TypeKind::TyUnit}
        if i==29 {t.kind=TypeKind::TyF128}
        if i==30 {t.kind=TypeKind::TyF256}
        if i==31 {t.kind=TypeKind::TyWorkerFnI64}
        if i==32 {t.kind=TypeKind::TyWorkerFnF64}
        if i==33 {t.kind=TypeKind::TyI32}
        if i==34 {t.name.len = -1}
        if i==35 {t.knowledge_validity_value=1.0}
        if binding_stamp_is_plain_i64(t) {return 10+i}
        i=i+1
    }
    0
}
fn annotation_ok(list:Box<StmtList>)->bool with Mut,Panic,Div {
    match (*list).head.ty {
        None=>false,
        Some(t)=>{
            if (*t).kind!=TypeExprKind::TypeNamed || (*t).path.seg_count!=1 {return false}
            if (*t).span.file_id!=7 as i32 || (*t).span.start!=31 || (*t).span.end!=79 {return false}
            if (*t).path.segments.head_len!=3 || (*t).path.segments.head_buf[0]!=105 as i8 || (*t).path.segments.head_buf[1]!=54 as i8 || (*t).path.segments.head_buf[2]!=52 as i8 {return false}
            true
        }
    }
}
@WORKER_SOURCE_PREFIX@
var WORKER_SOURCE_EPOCH:i64=0
fn allocation_churn(seed:i64)->i64 with Mut,Panic,Div,Alloc {
    let garbage=node()
    (*garbage).head.name=make_name("fresh allocation after annotation publication")
    seed+(*garbage).head.span.start
}
fn worker_rhs_controls(env:&!TypeEnv)->i64 with Mut,Panic,Div,Alloc {
    var j:i64=0
    while j<5 {
        let fresh=node()
        var rhs=expr(9)
        if j==1 {rhs.kind=ExprKind::ExprArrayLit}
        if j==2 {rhs.kind=ExprKind::ExprStructLit}
        if j==3 {rhs.kind=ExprKind::ExprCall; rhs.left=Some(Box::new(expr(0)))}
        if j==4 {rhs.kind=ExprKind::ExprIdent; rhs.name=make_name("uncertified global")}
        (*fresh).head.expr=Some(Box::new(rhs))
        let block=Block {stmts:Some(fresh),span:(*fresh).head.span}
        var frame=WorkerSourceFrame {id:1,call_depth:0,locals:None}
        let before=worker_source_block(0 as *mut FnSigTable,&!frame,&block,0)
        type_env_reset_into(env)
        type_env_push_scope_mut(env)
        type_env_bind_mut(env,make_name("status"),ty_i64(),false)
        // Adversarial post-check metadata cannot override a forbidden RHS.
        assert(binding_stamp_checked_i64(fresh,&(*env),0,1,0,0,false))
        let after=worker_source_block(0 as *mut FnSigTable,&!frame,&block,0)
        if j==0 {assert(before==3 && after==3)} else {assert(before==0 && after==0)}
        j=j+1
    }
    0
}

fn main()->i64 with Mut,Panic,Div,Alloc,IO {
    let code=classifier_controls()
    assert(code==0)
    var env=Box::new(type_env_new())
    type_env_push_scope_mut(&!(*env))
    let list=node()
    let alias=list
    type_env_bind_mut(&!(*env),make_name("status"),ty_i64(),false)
    assert(binding_stamp_checked_i64(list,&(*env),0,1,0,0,false))
    assert(annotation_ok(alias))
    assert(!binding_stamp_checked_i64(list,&(*env),0,1,0,0,false))
    match (*list).head.expr {Some(e)=>assert((*e).int_val == -7000000001),None=>assert(false)}
    assert((*list).head.span.start==31)
    var j:i64=0
    while j<12 {
        let fresh=node()
        let n=if j==0 {1} else {0}
        let scope=if j==1 {0} else {1}
        let before=if j==2 {1} else {0}
        let after=if j==3 {1} else {0}
        if j==5 {(*fresh).head.name=make_name("other")}
        if j==6 {(*fresh).head.kind=StmtKind::StmtVar}
        if j==7 {(*env).overflowed=true}
        if j==8 {(*env).bindings[0].scope_depth=0}
        if j==9 {(*env).count=2}
        if j==10 {(*env).bindings[0].ty.noise_set_id=0}
        if j==11 {(*fresh).head.kind=StmtKind::StmtExpr}
        assert(!binding_stamp_checked_i64(fresh,&(*env),n,scope,before,after,j==4))
        match (*fresh).head.ty {Some(_)=>assert(false),None=>{}}
        (*env).overflowed=false
        (*env).bindings[0].scope_depth=1
        (*env).bindings[0].ty=ty_i64()
        (*env).count=1
        j=j+1
    }
    // Same-name shadow: only the newly appended index may authorize this node.
    type_env_bind_mut(&!(*env),make_name("status"),ty_f64(),false)
    let shadow=node()
    assert(!binding_stamp_checked_i64(shadow,&(*env),1,1,0,0,false))
    (*env).bindings[1].ty=ty_i64()
    assert(binding_stamp_checked_i64(shadow,&(*env),1,1,0,0,false))
    assert(annotation_ok(shadow))
    assert(binding_stamp_is_plain_i64((*env).bindings[0].ty))
    // Mutable bindings have their own positive path and preserve mutability.
    let mutable=node()
    (*mutable).head.kind=StmtKind::StmtVar
    type_env_bind_mut(&!(*env),make_name("status"),ty_i64(),true)
    assert(binding_stamp_checked_i64(mutable,&(*env),2,1,0,0,false))
    assert(annotation_ok(mutable))
    let captured=Block {stmts:Some(list),span:(*list).head.span}
    var churn:i64=0
    while churn<5000 {assert(allocation_churn(churn)==churn+31);churn=churn+1}
    match captured.stmts {Some(same)=>assert(annotation_ok(same)),None=>assert(false)}
    // Existing authored annotations are retained verbatim, even for a differing type.
    let authored=node()
    (*authored).head.ty=(*list).head.ty
    match (*authored).head.ty {Some(t)=>{(*t).path.segments.head_buf[0]=102 as i8},None=>assert(false)}
    type_env_reset_into(&!(*env))
    type_env_push_scope_mut(&!(*env))
    type_env_bind_mut(&!(*env),make_name("status"),ty_i64(),false)
    assert(!binding_stamp_checked_i64(authored,&(*env),0,1,0,0,false))
    match (*authored).head.ty {Some(t)=>assert((*t).path.segments.head_buf[0]==102 as i8),None=>assert(false)}
    assert(worker_rhs_controls(&!(*env))==0)
    print("BINDING_STAMP_COMPONENT_OK\n")
    0
}
