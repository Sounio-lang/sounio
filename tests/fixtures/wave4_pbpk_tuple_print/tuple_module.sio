// Diagnostic producers only: explicit checked return types and no chemistry.
pub fn triple()->(i64,[f64;4],[f64;4]) with Alloc,Mut,Div,Panic {
 let values:[f64;4]=[1.0;4]
 let errors:[f64;4]=[0.5;4]
 (0-7,values,errors)
}
pub fn triple_explicit()->(i64,[f64;4],[f64;4]) with Alloc,Mut,Div,Panic {
 let values:[f64;4]=[1.0;4]
 let errors:[f64;4]=[0.5;4]
 return (0-7,values,errors)
}
pub fn signed_pair()->(i64,i64) with Alloc,Mut,Div,Panic {(0-7,0-7000000001)}
pub fn float_pair()->(f64,f64) with Alloc,Mut,Div,Panic {(0.5,1.25)}
pub fn mixed_pair()->(i64,f64) with Alloc,Mut,Div,Panic {(0-7,0.5)}
pub fn nested()->((i64,f64),[f64;4]) with Alloc,Mut,Div,Panic {
 let values:[f64;4]=[1.0;4]
 ((0-7,0.5),values)
}
