use pbpk_tuple_probe::{triple}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let (status,values,errors)=triple()
 assert(status==0-7)
 assert(values[0]==1.0 && errors[0]==0.5)
 print("I=");print(status);println("")
 print("V=");print(values[0]);println("")
 print("U=");print(errors[0]);println("")
 0
}
