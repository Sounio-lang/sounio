// Diagnostic producers only: explicit checked return types and no chemistry.
fn triple()->(i64,[f64;4],[f64;4]) with Alloc,Mut,Div,Panic {
 let values:[f64;4]=[1.0;4]
 let errors:[f64;4]=[0.5;4]
 (0-7,values,errors)
}
fn triple_explicit()->(i64,[f64;4],[f64;4]) with Alloc,Mut,Div,Panic {
 let values:[f64;4]=[1.0;4]
 let errors:[f64;4]=[0.5;4]
 return (0-7,values,errors)
}
fn signed_pair()->(i64,i64) with Alloc,Mut,Div,Panic {(0-7,0-7000000001)}
fn float_pair()->(f64,f64) with Alloc,Mut,Div,Panic {(0.5,1.25)}
fn mixed_pair()->(i64,f64) with Alloc,Mut,Div,Panic {(0-7,0.5)}
fn nested()->((i64,f64),[f64;4]) with Alloc,Mut,Div,Panic {
 let values:[f64;4]=[1.0;4]
 ((0-7,0.5),values)
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let (a,b)=signed_pair()
 print("I0=");print(a);println("")
 print("I1=");print(b);println("")
 0
}
