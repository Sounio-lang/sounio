struct Packet {
    id: i64,
    value: i64,
    tag: i64,
    payload: [i64; 280],
}
fn plain(p: Packet, kind: i64) -> Packet {
    if kind == 0 { p } else if kind == 1 { p } else { p }
}
fn implicit(p: Packet, kind: i64) -> Packet {
    if kind == 0 { p }
    else if kind == 1 {
        return p
    } else { p }
}
fn explicit(p: Packet, kind: i64) -> Packet {
    return if kind == 0 { p }
    else if kind == 1 {
        if p.id > 0 { return p }
        p
    } else { p }
}
fn main() -> i32 with IO {
    let p = Packet { id: 11, value: 22, tag: 33 , payload: [0; 280] };
    let result = explicit(p, 0);
    let id: i64 = result.id;
    let value: i64 = result.value;
    let tag: i64 = result.tag;
    println("PACKET_RETURN {} {} {}", id, value, tag);
    assert(id == 11 && value == 22 && tag == 33);
    0
}
