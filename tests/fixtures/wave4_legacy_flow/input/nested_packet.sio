struct Packet { id: i64, value: i64, tag: i64 }
fn choose(p: Packet, k: i64) -> Packet { if k == 0 { if p.id == 11 { p } else { return p } } else { if p.value == 22 { return p } else { p } } }
fn main() -> i32 with IO {
 let p = Packet { id: 11, value: 22, tag: 33 }
 let q = choose(p, 0)
 println("FLOW {} {} {}", q.id, q.value, q.tag)
 assert(q.id == 11 && q.value == 22 && q.tag == 33)
 0
}
