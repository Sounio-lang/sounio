fn choose(x: f64, o: Option<i64>) -> f64 { if let Some(v) = o { x * 2.0 } else { return x * 2.0 } }
fn main() -> i32 with IO, Epistemic {
 let input: Knowledge<f64> = measure(1.25, uncertainty: 0.5)
 let x: f64 = input.value
 let q: f64 = choose(x, None)
 let variance: f64 = variance_of(q)
 let qb: i64 = f64_to_bits(q)
 let vb: i64 = f64_to_bits(variance)
 println("SHADOW {} {}", qb, vb)
 0
}
