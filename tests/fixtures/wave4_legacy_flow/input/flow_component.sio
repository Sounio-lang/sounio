fn flow_sequence_x86(prior: i64, next: i64) -> i64 {
    if prior == 0 { return 0 }
    return next
}
fn flow_join_x86(left: i64, right: i64) -> i64 {
    if left != 0 || right != 0 { return 1 }
    return 0
}
fn main() -> i32 with IO, Panic {
 assert(flow_sequence_x86(0,0) == 0)
 assert(flow_sequence_x86(0,1) == 0)
 assert(flow_sequence_x86(1,0) == 0)
 assert(flow_sequence_x86(1,1) == 1)
 assert(flow_join_x86(0,0) == 0)
 assert(flow_join_x86(0,1) == 1)
 assert(flow_join_x86(1,0) == 1)
 assert(flow_join_x86(1,1) == 1)
 println("FLOW 11")
 0
}
