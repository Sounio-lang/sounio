fn setup_bounds() with Mut {
 SRC_LEN = 10
 SRC[0 as usize] = 101; SRC[1 as usize] = 110; SRC[2 as usize] = 117; SRC[3 as usize] = 109
 SRC[4 as usize] = 32; SRC[5 as usize] = 65; SRC[6 as usize] = 123; SRC[7 as usize] = 85; SRC[8 as usize] = 125; SRC[9 as usize] = 86
 TK[0 as usize] = 47; TS[0 as usize] = 0; TE[0 as usize] = 4
 TK[1 as usize] = 3; TS[1 as usize] = 5; TE[1 as usize] = 6
 TK[2 as usize] = 8; TS[2 as usize] = 6; TE[2 as usize] = 7
 TK[3 as usize] = 3; TS[3 as usize] = 7; TE[3 as usize] = 8
 TK[4 as usize] = 9; TS[4 as usize] = 8; TE[4 as usize] = 9
 TK[5 as usize] = 3; TS[5 as usize] = 9; TE[5 as usize] = 10
}
fn run_bounds(id:i64, ec:i64, sc:i64, tc:i64, nt:i64, et:i64, vt:i64, ei:i64, vc:i64) with IO, Mut, Panic, Div {
 setup_bounds()
 EN_COUNT = ec; ST_COUNT = sc; TC = tc
 let h = gl_name_hash(5,6)
 EN[0 as usize] = h; EN[1 as usize] = vc; EN[2 as usize] = gl_name_hash(7,8)
 FLOW_EN_DECL_TOK_X86[0 as usize] = nt
 FLOW_EN_VALID_X86[0 as usize] = 1
 FLOW_EN_VARIANT_TOK_X86[0 as usize] = 3
 READS = 0; BAD_READS = 0; BAD_KIND = 0
 let valid = flow_validate_enum_x86(ei)
 var vi:i64 = 0
 if valid { vi = 1 }
 let lookup = flow_enum_for_hash_x86(h)
 let variant = flow_enum_variant_x86(ei,et,vt)
 println("BOUNDS {} {} {} {} {} {} {}", id,vi,lookup,variant,READS,BAD_READS,BAD_KIND)
}
fn main() -> i32 with IO, Mut, Panic, Div {
 run_bounds(0,1,0,6,1,1,3,0,1)
 run_bounds(1,0,0,6,1,1,3,0,1)
 run_bounds(2,-1,0,6,1,1,3,0,1)
 run_bounds(3,256,0,6,1,1,3,0,1)
 run_bounds(4,257,0,6,1,1,3,0,1)
 run_bounds(5,9223372036854775807,0,6,1,1,3,0,1)
 run_bounds(6,(0 - 9223372036854775807 - 1),0,6,1,1,3,0,1)
 run_bounds(7,1,-1,6,1,1,3,0,1)
 run_bounds(8,1,1024,6,1,1,3,0,1)
 run_bounds(9,1,1025,6,1,1,3,0,1)
 run_bounds(10,1,9223372036854775807,6,1,1,3,0,1)
 run_bounds(11,1,(0 - 9223372036854775807 - 1),6,1,1,3,0,1)
 run_bounds(12,1,0,0,1,1,3,0,1)
 run_bounds(13,1,0,1,1,1,3,0,1)
 run_bounds(14,1,0,2,1,1,3,0,1)
 run_bounds(15,1,0,-1,1,1,3,0,1)
 run_bounds(16,1,0,2097152,1,1,3,0,1)
 run_bounds(17,1,0,2097153,1,1,3,0,1)
 run_bounds(18,1,0,9223372036854775807,1,1,3,0,1)
 run_bounds(19,1,0,(0 - 9223372036854775807 - 1),1,1,3,0,1)
 run_bounds(20,1,0,6,0,1,3,0,1)
 run_bounds(21,1,0,6,-1,1,3,0,1)
 run_bounds(22,1,0,6,5,1,3,0,1)
 run_bounds(23,1,0,6,6,1,3,0,1)
 run_bounds(24,1,0,6,9223372036854775807,1,3,0,1)
 run_bounds(25,1,0,6,(0 - 9223372036854775807 - 1),1,3,0,1)
 run_bounds(26,1,0,6,1,1,3,-1,1)
 run_bounds(27,1,0,6,1,1,3,256,1)
 run_bounds(28,1,0,6,1,1,3,9223372036854775807,1)
 run_bounds(29,1,0,6,1,9223372036854775807,3,0,1)
 run_bounds(30,1,0,6,1,1,9223372036854775807,0,1)
