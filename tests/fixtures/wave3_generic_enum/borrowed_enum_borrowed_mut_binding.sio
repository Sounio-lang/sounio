// Intentional admission negative: shared carrier matching cannot move its affine payload.
// The binding is unused so an undeclared-variable cascade cannot qualify this refusal.
enum Option<T>{Some(T),None}
fn read(value:&Option<&!i64>) {match value {Option::Some(view)=>{},Option::None=>{}}}
fn main() with Mut,Alloc,Panic,Div {var owner=42;let value:Option<&!i64> =Option::Some(&!owner);read(&value)}
