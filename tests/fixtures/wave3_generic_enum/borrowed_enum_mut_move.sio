enum Option<T>{Some(T),None}
fn main() with IO,Mut,Alloc,Panic,Div {
 var owner:i64=42
 {
  let value:Option<&!i64> =Option::Some(&!owner)
  match value {Option::Some(view)=>{let moved=view;*moved=43;assert(*moved==43)},Option::None=>panic("missing")}
 }
 assert(owner==43)
 println("BORROWED_ENUM_MUT_MOVE_OK")
}
