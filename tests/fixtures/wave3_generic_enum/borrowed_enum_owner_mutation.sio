enum Result<T,E>{Ok(T),Err(E)}
struct Owner{value:i64}
struct View{owner:&Owner}
fn make(owner:&Owner)->Result<View,i64> with Alloc {Result::Ok(View{owner:owner})}
fn main() with IO,Mut,Alloc,Panic,Div {
 var owner=Owner{value:42}
 let result=make(&owner)
 owner.value=43
 match result {Result::Ok(view)=>println((*view.owner).value),Result::Err(_)=>{}}
}
