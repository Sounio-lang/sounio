use parser::ast::{make_name}
use check::borrow::{borrow_env_new,borrow_binding_id,borrow_persistent_state,borrow_persist_owner}
fn main()->i32 with IO,Mut,Alloc,Div,Panic {
 let owner=make_name("owner")
 let carrier=make_name("carrier")
 var env=borrow_env_new().push_scope().track(owner,true).push_scope().track(carrier,false)
 env=borrow_persist_owner(env,carrier,owner,1)
 let snapshot=env
 let old_carrier=borrow_binding_id(&snapshot,carrier)
 env=env.pop_scope().push_scope().track(make_name("replacement"),false)
 assert(borrow_binding_id(&snapshot,carrier)==old_carrier)
 assert(borrow_persistent_state(&snapshot,owner)==1)
 assert(borrow_persistent_state(&env,owner)==0)
 println("PERSISTENT_LOAN_SNAPSHOT_BINDINGS_OK")
 0
}
