// Intended run-pass: a lexical carrier scope releases its owner's loan.
fn borrow_value(owner:&i64)->&i64 {owner}
fn main() with IO,Mut,Panic {
 var owner:i64=42
 {
  let carrier=borrow_value(&owner)
  let alias=carrier
  assert(*alias==42)
 }
 owner=43
 assert(owner==43)
 println("RETURNED_LOAN_SCOPE_OK")
}
