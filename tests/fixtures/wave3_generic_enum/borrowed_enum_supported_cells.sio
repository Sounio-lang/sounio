enum Option<T>{Some(T),None}
fn main() with IO,Mut,Alloc,Panic,Div {
 let byte:u8=255 as u8
 let bytes:Option<&u8> =Option::Some(&byte)
 match bytes {Option::Some(view)=>assert(*view==255 as u8),Option::None=>panic("u8")}
 let signed:i8=(0-128) as i8
 let signeds:Option<&i8> =Option::Some(&signed)
 match signeds {Option::Some(view)=>assert(*view==(0-128) as i8),Option::None=>panic("i8")}
 let integer:i32=(0-2147483647) as i32
 let integers:Option<&i32> =Option::Some(&integer)
 match integers {Option::Some(view)=>assert(*view==(0-2147483647) as i32),Option::None=>panic("i32")}
 let uint:u32=4294967295 as u32
 let uints:Option<&u32> =Option::Some(&uint)
 match uints {Option::Some(view)=>assert(*view==4294967295 as u32),Option::None=>panic("u32")}
 let ulong:u64=4294967296 as u64
 let ulongs:Option<&u64> =Option::Some(&ulong)
 match ulongs {Option::Some(view)=>assert(*view==4294967296 as u64),Option::None=>panic("u64")}
 let boolean:bool=true
 let booleans:Option<&bool> =Option::Some(&boolean)
 match booleans {Option::Some(view)=>assert(*view),Option::None=>panic("bool")}
 let character:char='x'
 let characters:Option<&char> =Option::Some(&character)
 match characters {Option::Some(view)=>assert(*view=='x'),Option::None=>panic("char")}
 let single:f32=0.5
 let singles:Option<&f32> =Option::Some(&single)
 match singles {Option::Some(view)=>assert(*view+(0.25 as f32)==(0.75 as f32)),Option::None=>panic("f32")}
 let text:string="owner"
 let expected="ow"+"ner"
 let texts:Option<&string> =Option::Some(&text)
 match texts {Option::Some(view)=>assert(*view==expected),Option::None=>panic("string")}
 println("BORROWED_ENUM_SUPPORTED_CELLS_OK")
}
