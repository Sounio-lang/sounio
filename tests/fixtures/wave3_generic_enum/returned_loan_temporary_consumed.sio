fn borrow_value(owner:&i64)->&i64 {owner}
fn overwrite(owner:&!i64)->i64 with Mut {*owner=43;0}
fn read(value:&i64)->i64 {*value}
fn sum(first:i64,second:i64)->i64 {first+second}
fn main() with IO,Mut,Panic {
 var owner:i64=42
 assert(sum(read(borrow_value(&owner)),overwrite(&!owner))==42)
 assert(owner==43)
 println("RETURNED_LOAN_TEMPORARY_CONSUMED_OK")
}
