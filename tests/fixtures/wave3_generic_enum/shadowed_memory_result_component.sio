// Seed component exercises the real private checker helper and real declaration checks.
use parser::ast::{make_name}
use compiler::module_parse::{load_module_file}
use check::types::{TypeKind}
use check::check::{checker_shadowed_builtin_result}
use check::mod::{check_items_verdict_boot4}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
 let resolved=load_module_file("tests/fixtures/wave3_generic_enum/shadowed_memory_result_resolved.sio")
 assert(check_items_verdict_boot4(resolved.items)==0)
 let wrong=load_module_file("tests/fixtures/wave3_generic_enum/shadowed_memory_result_wrong.sio")
 assert(check_items_verdict_boot4(wrong.items)==1)
 println("RESOLVED_USER_MEMORY_SIGNATURE_CONTROLS_OK")
 assert(checker_shadowed_builtin_result(make_name("read_i64")).kind==TypeKind::TyI64)
 assert(checker_shadowed_builtin_result(make_name("heap_alloc")).kind==TypeKind::TyI64)
 assert(checker_shadowed_builtin_result(make_name("write_i64")).kind==TypeKind::TyUnit)
 assert(checker_shadowed_builtin_result(make_name("write_f64")).kind==TypeKind::TyUnit)
 println("SHADOWED_INTEGER_AND_UNIT_CONTROLS_OK")
 assert(checker_shadowed_builtin_result(make_name("read_f64")).kind==TypeKind::TyF64)
 println("SHADOWED_FLOAT_RESULT_OK")
 0
}
