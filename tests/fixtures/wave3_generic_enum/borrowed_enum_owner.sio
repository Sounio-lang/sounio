enum Result<T,E>{Ok(T),Err(E)}
struct Owner{value:i64}
struct View{owner:&Owner}
fn make(owner:&Owner)->Result<View,i64> with Alloc {
 Result::Ok(View{owner:owner})
}
fn main() with IO,Mut,Alloc,Panic,Div {
 let owner=Owner{value:42}
 let result=make(&owner)
 match result {Result::Ok(view)=>assert((*view.owner).value==42),Result::Err(_)=>panic("missing")}
 println("BORROWED_ENUM_OWNER_OK")
}
