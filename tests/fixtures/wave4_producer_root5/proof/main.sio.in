
fn proof_row(id:i64,x:i64,y:i64) with IO {print(id);print(" ");print(x);print(" ");println(y)}
fn emit_fixture(which:i64) with IO,Mut,Panic,Div {
    FLOW_PROOF_COUNT_X86=0;FLOW_PROOF_FRAME_BASE_X86=0
    VAR_COUNT=0;FN_COUNT=0;GL_COUNT=0;EN_COUNT=0;ST_COUNT=0
    NEXT_SLOT=1;CL=0;CURRENT_FN=-1;EP=0
    SRC[0]=78 as i8;SRC[1]=111 as i8;SRC[2]=110 as i8;SRC[3]=101 as i8;SRC_LEN=4
    if which==1 {SRC[0]=83 as i8;SRC[1]=111 as i8;SRC[2]=109 as i8;SRC[3]=101 as i8;SRC[4]=40 as i8;SRC[5]=55 as i8;SRC[6]=41 as i8;SRC_LEN=7}
    lex_all()
    compile_primary()
    print("CODE ");print(which);print(" ");print(CL)
    var i:i64=0
    while i<CL {print(" ");print(CD[i as usize] as i64 & 255);i=i+1}
    println("")
    proof_row(which,flow_value_at_x86(0,EP,EXPR_TY,EXPR_TY_HASH),flow_value_at_x86(1,EP,EXPR_TY,EXPR_TY_HASH))
}
fn make_tuple(oh:i64,key:i64)->i64 with Mut,Panic {
    TUP_SCRATCH_ELEM_TY[0]=11;TUP_SCRATCH_ELEM_HASH[0]=oh
    TUP_SCRATCH_ELEM_TY[1]=1;TUP_SCRATCH_ELEM_HASH[1]=0
    TUP_SCRATCH_COUNT=2
    return tup_cache_register(key,11,oh,1,0)
}
fn make_proof(h:i64,oh:i64,child:i64)->i64 with Mut,Panic {
    var c:[i64;16]=[0;16];var t:[i64;16]=[0;16];var hs:[i64;16]=[0;16]
    c[0]=child;t[0]=11;t[1]=1;hs[0]=oh
    return flow_proof_tuple_x86(h,2,c,t,hs)
}
fn main()->i64 with IO,Mut,Panic,Div {
    emit_fixture(0);emit_fixture(1)
    FLOW_PROOF_COUNT_X86=0;FLOW_PROOF_FRAME_BASE_X86=0;TUP_CACHE_COUNT=0
    let oh=option_hash_make(1,0)
    let sh=make_tuple(oh,630000000200002003)
    let nh=make_tuple(0,200002003)
    let sp=make_proof(sh,oh,2)
    let np=make_proof(nh,0,1)
    proof_row(2,flow_sibling_tuple_hash_x86(6,sh,sp,6,nh,np),sh)
    proof_row(3,flow_sibling_tuple_hash_x86(6,nh,np,6,sh,sp),sh)
    let forged=make_proof(nh,0,0)
    proof_row(4,flow_sibling_tuple_hash_x86(6,sh,sp,6,nh,forged),0)
    let wrongfamily=make_proof(sh,oh,0)
    proof_row(5,flow_sibling_tuple_hash_x86(6,sh,wrongfamily,6,nh,np),0)
    proof_row(6,flow_proof_row_x86(9223372036854775807,sh,2),-1)
    proof_row(7,flow_proof_row_x86(sp,sh,17),-1)
    proof_row(8,flow_proof_row_x86(sp,nh,2),-1)
    let save_count=FLOW_PROOF_COUNT_X86
    let save_base=FLOW_PROOF_FRAME_BASE_X86
    FLOW_PROOF_FRAME_BASE_X86=save_count
    let child=make_proof(sh,oh,2)
    proof_row(9,flow_proof_row_x86(sp,sh,2),-1)
    FLOW_PROOF_COUNT_X86=save_count;FLOW_PROOF_FRAME_BASE_X86=save_base
    proof_row(10,flow_proof_row_x86(sp,sh,2),sp-3)
    proof_row(11,flow_proof_row_x86(child,sh,2),-1)
    FLOW_PROOF_COUNT_X86=1024
    proof_row(12,make_proof(sh,oh,2),0)
    FLOW_PROOF_COUNT_X86=4096
    proof_row(13,make_proof(sh,oh,2),0)
    FLOW_PROOF_COUNT_X86=4097
    proof_row(14,make_proof(sh,oh,2),0)
    FLOW_PROOF_COUNT_X86=-1
    proof_row(15,make_proof(sh,oh,2),0)
    FLOW_PROOF_COUNT_X86=save_count;FLOW_PROOF_FRAME_BASE_X86=-1
    proof_row(16,make_proof(sh,oh,2),0)
    FLOW_PROOF_FRAME_BASE_X86=0
    TUP_CACHE_COUNT=16385
    proof_row(17,make_proof(sh,oh,2),0)
    TUP_CACHE_COUNT=2
    proof_row(18,flow_sibling_value_x86(6,sh,sp,6,nh,np,1),0)
    proof_row(19,flow_word_box_payload_x86(10,0,0) as i64,0)
    proof_row(20,flow_word_box_payload_x86(9,0,0) as i64,0)
    proof_row(21,flow_word_box_payload_x86(0,0,0) as i64,0)
    proof_row(22,flow_word_box_payload_x86(13,0,0) as i64,0)
    proof_row(23,flow_word_box_payload_x86(6,987654,0) as i64,0)
    proof_row(24,flow_word_box_payload_x86(11,box_hash_make(6,987654),0) as i64,0)
    ST_COUNT=1;ST[0]=987654
    proof_row(25,flow_word_box_payload_x86(11,box_hash_make(6,987654),0) as i64,1)
    proof_row(26,flow_word_box_payload_x86(11,box_hash_make(10,0),0) as i64,0)
    ST_COUNT=0
    // Local shadow and global/custom ambiguity deny facts, irrespective of emitted bits.
    SRC[0]=78 as i8;SRC[1]=111 as i8;SRC[2]=110 as i8;SRC[3]=101 as i8;SRC_LEN=4;lex_all()
    proof_row(27,flow_builtin_constructor_x86(0) as i64,1)
    VAR_COUNT=1;VAR_NS[0]=0;VAR_NE[0]=4
    proof_row(28,flow_builtin_constructor_x86(0) as i64,0)
    VAR_COUNT=0;EN_COUNT=1;EN[1]=1;EN[2]=gl_name_hash(0,4)
    proof_row(29,flow_builtin_constructor_x86(0) as i64,0)
    EN_COUNT=0;FN_COUNT=1;FN_NS[0]=0;FN_NE[0]=4
    proof_row(30,flow_builtin_constructor_x86(0) as i64,0)
    FN_COUNT=0;GL_COUNT=1;GL[0]=gl_name_hash(0,4)
    proof_row(31,flow_builtin_constructor_x86(0) as i64,0)
    GL_COUNT=0
    return 0
}

