struct Node{value:i64,next:Option<Box<Node>>}
struct Big{values:[i64;280]}
fn scalar(o:Option<i64>)->(Option<i64>,i64) with Mut,Panic,Div{
 match o{Some(v)=>(Some(v),1),None=>(None,0)}
}
fn reverse(o:Option<i64>)->(Option<i64>,i64) with Mut,Panic,Div{
 match o{None=>(None,0),Some(v)=>(Some(v),1)}
}
fn floating(o:Option<i64>)->(Option<f64>,i64) with Mut,Panic,Div{
 match o{Some(v)=>(Some((v as f64)+0.5),1),None=>(None,0)}
}
fn boolean(o:Option<i64>)->(Option<bool>,i64) with Mut,Panic,Div{
 match o{Some(v)=>(Some(v>0),1),None=>(None,0)}
}
fn recursive(o:Option<i64>)->(Option<Box<Node>>,i64) with Alloc,Mut,Panic,Div{
 match o{Some(v)=>(Some(Box::new(Node{value:v,next:None})),1),None=>(None,0)}
}
fn widebox(o:Option<i64>)->(Option<Box<Big>>,i64) with Alloc,Mut,Panic,Div{
 match o{Some(v)=>(Some(Box::new(Big{values:[v;280]})),1),None=>(None,0)}
}
fn nested(o:Option<i64>)->((Option<Box<Node>>,i64),i64) with Alloc,Mut,Panic,Div{
 match o{Some(v)=>((Some(Box::new(Node{value:v,next:None})),1),7),None=>((None,0),8)}
}
fn clobber(seed:i64)->i64 with Mut,Panic,Div{
 var a:[i64;512]=[0;512]
 var i:i64=0
 while i<512{a[i as usize]=seed+i;i=i+1}
 var sum:i64=0
 i=0
 while i<512{sum=sum+a[i as usize];i=i+1}
 sum
}
fn un(v:Option<i64>)->i64{match v{Some(x)=>x,None=>-9}}
fn unf(v:Option<f64>)->i64{match v{Some(x)=>f64_to_bits(x),None=>f64_to_bits(-9.0)}}
fn unb(v:Option<bool>)->i64{match v{Some(x)=>if x{1}else{0},None=>-9}}
fn unn(v:Option<Box<Node>>)->i64 with Mut,Panic,Div{match v{Some(x)=>(*x).value,None=>-9}}
fn unbig(v:Option<Box<Big>>)->i64 with Mut,Panic,Div{match v{Some(x)=>(*x).values[279],None=>-9}}
fn row(id:i64,value:i64,marker:i64) with IO{print(id);print(" ");print(value);print(" ");println(marker)}
fn main()->i32 with IO,Alloc,Mut,Panic,Div{
 let a=scalar(Some(37));let b=scalar(None);let trash0=clobber(100)
 row(0,un(a.0),a.1);row(1,un(b.0),b.1)
 let c=reverse(Some(38));let d=reverse(None);let trash1=clobber(101)
 row(2,un(c.0),c.1);row(3,un(d.0),d.1)
 let e=floating(Some(39));let f=floating(None);let trash2=clobber(102)
 row(4,unf(e.0),e.1);row(5,unf(f.0),f.1)
 let g=boolean(Some(1));let h=boolean(None);let trash3=clobber(103)
 row(6,unb(g.0),g.1);row(7,unb(h.0),h.1)
 let j=recursive(Some(40));let k=recursive(None);let trash4=clobber(104)
 row(8,unn(j.0),j.1);row(9,unn(k.0),k.1)
 let l=widebox(Some(41));let m=widebox(None);let trash5=clobber(105)
 row(10,unbig(l.0),l.1);row(11,unbig(m.0),m.1)
 let n=nested(Some(42));let p=nested(None);let trash6=clobber(106)
 let ni=n.0;let pi=p.0
 row(12,unn(ni.0),ni.1);row(13,unn(pi.0),pi.1)
 row(14,n.1,p.1)
 row(15,trash0+trash1+trash2+trash3+trash4+trash5+trash6,0)
 0
}

