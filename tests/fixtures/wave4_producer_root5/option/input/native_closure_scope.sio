fn f(o:Option<i64>)->(Option<i64>,i64) with Mut,Panic,Div {
 match o{
  Some(v)=>(Some(v),1),
  None=>{
   let c=||->i64{let local=(Some(8),0);7}
   let unused=c()
   (None,0)
  }
 }
}
fn un(o:Option<i64>)->i64{match o{Some(v)=>v,None=>-9}}
fn main()->i32 with IO,Mut,Panic,Div {
 let a=f(Some(17))
 let b=f(None)
 print(un(a.0));print(" ");print(a.1);print(" ");print(un(b.0));print(" ");println(b.1)
 0
}

