fn cell(v:Option<i64>,at:i64)->i64 with Mut,Panic,Div {
 let p=v as *i64
 *(p+at)
}
fn choose(o:Option<i64>)->(Option<i64>,i64) with Mut,Panic,Div {
 match o{Some(x)=>(Some(x),1),None=>(None,0)}
}
fn main()->i32 with IO,Mut,Panic,Div {
 let s=Some(77)
 let n=None
 print(cell(s,0));print(" ");println(cell(s,1))
 print(cell(n,0));print(" ");println(cell(n,1))
 let a=choose(Some(88))
 let b=choose(None)
 print(cell(a.0,0));print(" ");println(cell(a.0,1))
 print(cell(b.0,0));print(" ");println(cell(b.0,1))
 0
}

