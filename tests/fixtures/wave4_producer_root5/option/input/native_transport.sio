fn same_some(o:Option<i64>,b:bool)->(Option<i64>,i64){match o{Some(v)=>if b{(Some(v),1)}else{(Some(v+1),2)},None=>(None,0)}}
fn same_none(o:Option<i64>,b:bool)->(Option<i64>,i64){match o{Some(v)=>(Some(v),1),None=>(if b{None}else{None},0)}}
fn via_iflet(o:Option<i64>,other:Option<i64>)->(Option<i64>,i64){match o{Some(v)=>if let Some(x)=other{(Some(v+x),3)}else{(Some(v),4)},None=>(None,0)}}
fn via_match(o:Option<i64>,b:bool)->(Option<i64>,i64){match o{Some(v)=>match b{true=>(Some(v),5),false=>(Some(v+1),6)},None=>(None,0)}}
fn dead_left(o:Option<i64>,b:bool)->(Option<i64>,i64){match o{Some(v)=>if b{return (Some(v),7)}else{(Some(v+1),8)},None=>(None,0)}}
fn dead_right(o:Option<i64>,b:bool)->(Option<i64>,i64){match o{Some(v)=>if b{(Some(v),9)}else{return (Some(v+1),10)},None=>(None,0)}}
fn un(o:Option<i64>)->i64{match o{Some(v)=>v,None=>-9}}
fn clobber(seed:i64)->i64 with Mut,Panic,Div{var a:[i64;512]=[0;512];var i:i64=0;while i<512{a[i as usize]=seed+i;i=i+1};var sum:i64=0;i=0;while i<512{sum=sum+a[i as usize];i=i+1};return sum}
fn row(id:i64,r:(Option<i64>,i64)) with IO,Mut,Panic,Div{let trash=clobber(830+id);print(id);print(" ");print(un(r.0));print(" ");print(r.1);print(" ");println(trash)}
fn main()->i32 with IO,Mut,Panic,Div{
 row(0,same_some(Some(17),true));row(1,same_some(Some(17),false));row(2,same_some(None,true))
 row(3,same_none(Some(17),true));row(4,same_none(None,true));row(5,same_none(None,false))
 row(6,via_iflet(Some(17),Some(3)));row(7,via_iflet(Some(17),None));row(8,via_iflet(None,Some(3)))
 row(9,via_match(Some(17),true));row(10,via_match(Some(17),false));row(11,via_match(None,false))
 row(12,dead_left(Some(17),true));row(13,dead_left(Some(17),false));row(14,dead_left(None,false))
 row(15,dead_right(Some(17),true));row(16,dead_right(Some(17),false));row(17,dead_right(None,false))
 return 0
}

