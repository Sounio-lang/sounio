use lexer::span::*
use parser::ast::*
use resolve::symbol::*
use resolve::imports::*
fn item_for(k:ItemKind,p:i64)->Item with Mut,Panic,Div {
 var n=empty_name()
 n.len=1
 n.buf[0]=120 as i8
 return Item{origin_module_id:-1,kind:k,span:Span{file_id:0,start:0,end:0},visibility:Visibility{kind:p,path:empty_path()},name:n,fn_def:None,struct_def:None,enum_def:None,impl_def:None,type_alias_ty:None,policy_def:None,acquisition_policy_def:None,recourse_policy_def:None,decision_policy_def:None,deferral_policy_def:None,transition_policy_def:None,transition_protocol_def:None,monitoring_policy_def:None,alternative_policy_def:None,alternative_frontier_def:None,models_def:None,validation_def:None,audit_def:None,use_items:None,effect_def:None,session_decl:None,trait_def:None,algebra_def:None,study_def:None,ontology_def:None,use_path:empty_path(),use_glob:false}
}
fn probe(k:ItemKind,p:i64,ix:i64) with IO,Mut,Panic,Div,Alloc{
 let before=modreg_pool_count()
 let r=collect_module_exports(Some(Box::new(ItemList{head:item_for(k,p),tail:None})))
 let after=modreg_pool_count()
 var kind:i64=-1
 var first:i64=-1
 var len:i64=-1
 if after>before {
  kind=modreg_export_kind_at(before) as i64
  let n=modreg_export_name_at(before)
  first=n.buf[0] as i64
  len=n.len
 }
 print(ix);print(" ");print(p);print(" ");print(r.0-before);print(" ");print(r.1);print(" ");print(after-before);print(" ");print(kind);print(" ");print(first);print(" ");print(len);print(" ");println(modreg_pool_dropped())
}
fn main()->i32 with IO,Mut,Panic,Div,Alloc{
probe(ItemKind::ItemFn,0,0)
probe(ItemKind::ItemFn,1,0)
probe(ItemKind::ItemStruct,0,1)
probe(ItemKind::ItemStruct,1,1)
probe(ItemKind::ItemEnum,0,2)
probe(ItemKind::ItemEnum,1,2)
probe(ItemKind::ItemImpl,0,3)
probe(ItemKind::ItemImpl,1,3)
probe(ItemKind::ItemTypeAlias,0,4)
probe(ItemKind::ItemTypeAlias,1,4)
probe(ItemKind::ItemModels,0,5)
probe(ItemKind::ItemModels,1,5)
