probe(ItemKind::ItemRecoursePolicy,1,8)
probe(ItemKind::ItemTransitionPolicy,0,9)
probe(ItemKind::ItemTransitionPolicy,1,9)
probe(ItemKind::ItemTransitionProtocol,0,10)
probe(ItemKind::ItemTransitionProtocol,1,10)
probe(ItemKind::ItemMonitoringPolicy,0,11)
probe(ItemKind::ItemMonitoringPolicy,1,11)
probe(ItemKind::ItemDecisionPolicy,0,12)
probe(ItemKind::ItemDecisionPolicy,1,12)
probe(ItemKind::ItemDeferralPolicy,0,13)
probe(ItemKind::ItemDeferralPolicy,1,13)
probe(ItemKind::ItemAlternativePolicy,0,14)
probe(ItemKind::ItemAlternativePolicy,1,14)
probe(ItemKind::ItemAlternativeFrontier,0,15)
probe(ItemKind::ItemAlternativeFrontier,1,15)
probe(ItemKind::ItemValidation,0,16)
probe(ItemKind::ItemValidation,1,16)
