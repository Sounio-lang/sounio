var hits:i64=0
fn f(o:Option<i64>) with Mut{match o{Some(_)=>return,None=>{hits=hits+1}}}
fn g(o:Option<i64>) with Mut{match o{Some(v)=>match v{1=>return,_=>{hits=hits+10}},None=>{hits=hits+100}}}
fn valued(o:Option<i64>)->i64{match o{Some(v)=>return v,None=>7}}
fn main()->i32 with IO,Mut{
 f(Some(1));f(None);g(Some(1));g(Some(2));g(None)
 print(hits);print(" ");print(valued(Some(17)));print(" ");println(valued(None))
 return 0
}

