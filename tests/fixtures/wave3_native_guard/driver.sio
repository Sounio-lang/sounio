use ir::ir::*;
use native::codegen_x86_linux::{native_resolve_target,compile_native_v2_preview_to_file}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
 let prefix=get_arg(0)
 var module=ir_empty_module()
 module.fn_count=2
 ir_fn_pool_ensure(&module,1)
 var entry=ir_empty_function()
 entry.name=make_name("main")
 entry.reg_count=1
 entry.instr_count=2
 assert(ir_function_alloc_region(&!entry)==IR_ARENA_OK)
 ir_arena_store(ir_region_slot_w(entry.region,0),ir_load_imm(0,17))
 ir_arena_store(ir_region_slot_w(entry.region,1),ir_return(0))
 ir_fn_set(&!module,0,entry)
 var missing=ir_empty_function()
 missing.name=make_name("wave3_missing_native_body")
 ir_fn_set(&!module,1,missing)
 let target=native_resolve_target("x86_64-linux","auto",true)
 let rejected=compile_native_v2_preview_to_file(&module,target,prefix+"bad.elf")
 print("MISSING_BODY_STATUS ");print_int(rejected as i64);print("\n")
 assert(rejected!=0)
 missing.name=make_name("str_len")
 ir_fn_set(&!module,1,missing)
 assert(compile_native_v2_preview_to_file(&module,target,prefix+"valid.elf")==0)
 println("NATIVE_MISSING_BODY_REFUSAL_OK")
 0
}
