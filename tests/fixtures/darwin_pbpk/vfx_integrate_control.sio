// Control for the vfx_integrate_to refusal probes: must exit 0 and print both
// VFX_PROBE_REACHED and VFX_PROBE_ESCAPED. Run by
// scripts/ci/dissertation_pbpk28_parity_gate.sh (venlafaxine guards).
//
// Accepted spans: a zero span (t_end = t_start), the parity reference's
// on-grid sample chain at dt = 0.5, and 24 h at dt = 24/17 (17 steps, dt not
// exact in binary: the whole-step test must accept it, as it does for tau).

use darwin_pbpk::scenarios::venlafaxine_xr::*
use darwin_pbpk::release::matrix_er::*

fn main() with IO, Mut, Div, Panic {
    let rel = venlafaxine_xr_matrix_gohel2008()
    var s = vfx_scenario_init(2)
    println("VFX_PROBE_REACHED")
    s = vfx_integrate_to(s, rel, 0.0, 0.0, 0.5)
    s = vfx_integrate_to(s, rel, 0.0, 1.0, 0.5)
    s = vfx_integrate_to(s, rel, 1.0, 2.0, 0.5)
    s = vfx_integrate_to(s, rel, 2.0, 96.0, 0.5)
    var u = vfx_scenario_init(2)
    u = vfx_integrate_to(u, rel, 0.0, 24.0, 24.0 / 17.0)
    println("VFX_PROBE_ESCAPED")
    println(s.parent.cv[0])
    println(u.parent.cv[0])
}
