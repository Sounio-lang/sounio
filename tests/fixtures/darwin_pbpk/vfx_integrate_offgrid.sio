// Refusal probe: must PANIC (exit status exactly 1) after VFX_PROBE_REACHED
// and never print VFX_PROBE_ESCAPED. Run by
// scripts/ci/dissertation_pbpk28_parity_gate.sh (venlafaxine guards).
//
// At dt = 0.5, vfx_integrate_to(s, rel, 0.0, 1.2, dt) used to return the
// 1.0 h state (parent blood 0.020945) and 1.3 the 1.5 h state (0.031557),
// each labelled by the caller as t_end. It now panics unless t_end − t_start
// is a whole number of dt steps (vfx_whole_steps, the test vfx_ss_interval
// applies to tau).

use darwin_pbpk::scenarios::venlafaxine_xr::*
use darwin_pbpk::release::matrix_er::*

fn main() with IO, Mut, Div, Panic {
    let rel = venlafaxine_xr_matrix_gohel2008()
    var s = vfx_scenario_init(2)
    println("VFX_PROBE_REACHED")
    s = vfx_integrate_to(s, rel, 0.0, 1.2, 0.5)
    println("VFX_PROBE_ESCAPED")
    println(s.parent.cv[0])
}
