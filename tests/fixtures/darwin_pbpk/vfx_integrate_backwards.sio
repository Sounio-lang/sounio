// Must PANIC (non-zero exit), run by scripts/ci/dissertation_pbpk28_parity_gate.sh
// (venlafaxine guards). Not a run-pass test: the v2 harness has no panic
// expectation.
//
// vfx_integrate_to(s, rel, 1.0, 0.0, dt) used to return the 1 h state
// unchanged, and a caller sampling 1 h then 0 h labelled it t = 0 (parent
// blood 0.020945 instead of 0). It now panics on t_end < t_start. The gate
// requires VFX_BACKWARDS_REACHED, a non-zero exit, and no VFX_BACKWARDS_ACCEPTED.

use darwin_pbpk::scenarios::venlafaxine_xr::*
use darwin_pbpk::release::matrix_er::*

fn main() with IO, Mut, Div, Panic {
    let rel = venlafaxine_xr_matrix_gohel2008()
    var s = vfx_scenario_init(2)
    s = vfx_integrate_to(s, rel, 0.0, 1.0, 0.5)
    println("VFX_BACKWARDS_REACHED")
    s = vfx_integrate_to(s, rel, 1.0, 0.0, 0.5)
    println("VFX_BACKWARDS_ACCEPTED")
    println(s.parent.cv[0])
}
