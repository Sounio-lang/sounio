// Refusal probe: must PANIC (exit status exactly 1, the panic status on both
// engines) after VFX_PROBE_REACHED and never print VFX_PROBE_ESCAPED. Run by
// scripts/ci/dissertation_pbpk28_parity_gate.sh (venlafaxine guards); the v2
// harness has no panic expectation, and a panic prints no message on either
// engine, so the sentinels are what pin the refusing call.
//
// vfx_integrate_to(s, rel, 1.0, 0.0, dt) used to return the 1 h state
// unchanged, and a caller sampling 1 h then 0 h labelled it t = 0 (parent
// blood 0.020945 instead of 0). It now panics on t_end < t_start.

use darwin_pbpk::scenarios::venlafaxine_xr::*
use darwin_pbpk::release::matrix_er::*

fn main() with IO, Mut, Div, Panic {
    let rel = venlafaxine_xr_matrix_gohel2008()
    var s = vfx_scenario_init(2)
    s = vfx_integrate_to(s, rel, 0.0, 1.0, 0.5)
    println("VFX_PROBE_REACHED")
    s = vfx_integrate_to(s, rel, 1.0, 0.0, 0.5)
    println("VFX_PROBE_ESCAPED")
    println(s.parent.cv[0])
}
