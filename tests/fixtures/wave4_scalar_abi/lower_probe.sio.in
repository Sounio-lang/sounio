pub fn wave4_lower_probe()->i32 with IO,Alloc,Mut,Panic,Div {
 var lo=lowerer_new()
 let f=lowerer_find_or_add_fn_id_mut(&!lo,make_name("read_f64"))
 if ir_fn_get(&(*lo.module),f as usize).returns_float!=1 {return 31}
 let i=lowerer_find_or_add_fn_id_mut(&!lo,make_name("read_i64"))
 if ir_fn_get(&(*lo.module),i as usize).returns_float!=0 {return 32}
 var declared=ir_fn_get(&(*lo.module),f as usize)
 declared.returns_float=0
 ir_fn_set(&!(*lo.module),f as usize,declared)
 let again=lowerer_find_or_add_fn_id_mut(&!lo,make_name("read_f64"))
 if ir_fn_get(&(*lo.module),again as usize).returns_float!=0 {return 33}
 println("RAW_READ_FLOAT_METADATA_OK")
 return 0
}
