pub fn wave4_exit_probe()->i32 with IO,Alloc,Mut,Panic,Div {
 var c=compiler_new()
 nc_emit_exit_code(&!c,37)
 if (NC_BIG_CODE[0] as i64 & 255)!=72 {return 41}
 if (NC_BIG_CODE[1] as i64 & 255)==199 {
  if (NC_BIG_CODE[3] as i64 & 255)!=231 {return 42}
 } else {
  if (NC_BIG_CODE[1] as i64 & 255)!=184 {return 43}
  if (NC_BIG_CODE[2] as i64 & 255)!=231 {return 44}
 }
 if (NC_BIG_CODE[(c.code.len-2) as usize] as i64 & 255)!=15 {return 45}
 if (NC_BIG_CODE[(c.code.len-1) as usize] as i64 & 255)!=5 {return 46}
 println("FATAL_EXIT_GROUP_EMISSION_OK")
 return 0
}
