use ffi::platform::{platform_open,platform_status,platform_close}
use sync::native_channel::{native_channel_new,native_channel_status,native_channel_token,native_channel_try_send,native_channel_destroy}
use sync::native_channel_range::{NativeChannelRangeConfig,native_channel_range_reservation,native_channel_range_producer_new,native_channel_range_producer_status,native_channel_range_producer_wait_count_code,native_channel_range_producer_cancel,native_channel_range_producer_join,native_channel_range_producer_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let c=native_channel_new(&p,1,8)
 assert(native_channel_status(&c)==0)
 let token=native_channel_token(&c)
 assert(native_channel_try_send(&p,&token,99)==0)
 let budget=native_channel_range_reservation(&p)
 assert(budget.status==0)
 let cfg=NativeChannelRangeConfig{start:0,count:1,step:1,deadline_ns:9223372036854775807,max_bytes:budget.value}
 var producer=native_channel_range_producer_new(&p,&c,&cfg)
 assert(native_channel_range_producer_status(&producer)==0)
 var attempts:i64=0
 while attempts<1000000 && native_channel_range_producer_wait_count_code(&p,&producer)==0 {attempts=attempts+1}
 assert(native_channel_range_producer_wait_count_code(&p,&producer)>0)
 print("FATAL_WITH_ACTIVE_THREAD_ARMED\n")
 assert(false)
 // These operations keep the linear source path complete; the fatal assertion
 // above must terminate the process before any cleanup is reached.
 let canceled=native_channel_range_producer_cancel(&p,&producer)
 let joined=native_channel_range_producer_join(&p,&!producer)
 let closed=native_channel_range_producer_close(&p,producer)
 let destroyed=native_channel_destroy(&p,c)
 platform_close(p)
 0
}
