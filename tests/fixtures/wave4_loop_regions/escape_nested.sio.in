struct RegionRow {v:i64}
fn return_from_loop(n:i64)->RegionRow with Alloc,Mut,Div,Panic {
 var i:i64=0
 while i<1 {
  let row=RegionRow{v:n}
  return row
 }
 RegionRow{v:0}
}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
 var saved=RegionRow{v:0}
 var i:i64=0
 while i<7 {saved=RegionRow{v:i};i=i+1}
 assert(saved.v==6)
 let returned=return_from_loop(77)
 assert(returned.v==77)
 var sum:i64=0
 i=0
 while i<1000000 {
  var parent:[i64;4]=[0;4]
  parent[0]=i
  var j:i64=0
  while j<2 {
   var child:[i64;4]=[0;4]
   child[0]=1
   parent[1]=parent[1]+child[0]
   j=j+1
  }
  sum=sum+parent[1]
  i=i+1
 }
 assert(sum==2000000)
 assert(saved.v==6 && returned.v==77)
 print("LOOP_REGION_ESCAPE_NESTED_OK\n")
 0
}
