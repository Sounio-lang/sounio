fn main()->i64 with IO,Alloc,Mut,Div,Panic {
 let n:i64=4000000
 var i:i64=0
 var sum:i64=0
 loop {
  var row:[i64;64]=[0;64]
  if i>=n {break}
  row[0]=i
  if i%3==0 {i=i+1;continue}
  sum=sum+row[0]
  i=i+1
 }
 let multiples=(n-1)/3
 assert(sum==n*(n-1)/2-3*multiples*(multiples+1)/2)
 print("LOOP_REGION_CONTROL_OK\n")
 0
}
