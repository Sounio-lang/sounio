struct RegionCarry {v:i64}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
 var i:i64=0
 var sum:i64=0
 let n:i64=20000000
 while i<n {
  var carry=RegionCarry{v:0}
  var j:i64=0
  while j<1 {
   carry=RegionCarry{v:i}
   j=j+1
  }
  sum=sum+carry.v
  i=i+1
 }
 assert(sum==n*(n-1)/2)
 print("LOOP_REGION_INNER_CARRY_OK\n")
 0
}
