// Actual checker publishes concrete match types; actual lowerer and native emitter consume them.
use compiler::module_parse::{load_module_file}
use parser::parser::{parser_last_error_count}
use check::specializer::{specialize_generics,spec_report_unsound_poison}
use check::mod::{check_items_verdict_boot4}
use ir::lower::{lower_program_to_ir,lower_hard_error_report}
use native::codegen_x86_linux::{native_resolve_target,compile_native_v2_preview_to_file}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
 var program=load_module_file(get_arg(0))
 if parser_last_error_count()>0 {println("PARSE_REFUSED");return 1}
 program.items=specialize_generics(program.items)
 if spec_report_unsound_poison() {return 1}
 if check_items_verdict_boot4(program.items)!=0 {println("ACTUAL_CHECKER_REFUSED");return 1}
 let lowered=lower_program_to_ir(program)
 if lowered.had_error || lowered.error_count>0 {lower_hard_error_report();println("ACTUAL_LOWER_REFUSED");return 1}
 let target=native_resolve_target("x86_64-linux","auto",true)
 let status=compile_native_v2_preview_to_file(&lowered.module,target,get_arg(1))
 print("ACTUAL_CHECK_LOWER_NATIVE_STATUS ");print_int(status as i64);print("\n")
 status as i32
}
