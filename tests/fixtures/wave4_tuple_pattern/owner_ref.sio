struct Wrong {padding:i64,value:i64}
struct Owner {value:i64,padding:i64}
fn borrow_owner(owner:&Owner)->&Owner {owner}
fn main() with IO,Mut,Alloc,Panic,Div {
 let owner=Owner{value:42,padding:99}
 var seen:i64=0
 match (borrow_owner(&owner),7) {(view,number)=>{seen=number;assert((*view).value==42)}}
 assert(seen==7)
 println("TUPLE_PATTERN_OWNER_REF_OK")
}
