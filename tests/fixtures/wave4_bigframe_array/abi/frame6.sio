use data::bigframe::*
use data::bigframe_ops::*
fn test(src:&BigFrame,b:i64,c:i64,d:i64,e:f64,f:f64)->BigFrame with Alloc,Mut,Div,Panic {
 var out=bf_new(1,1)
 var row:[f64;64]=[0.0;64]
 row[0]=(bf_nrows(src) as f64)+2.0*(b as f64)+3.0*(c as f64)+4.0*(d as f64)+5.0*e+6.0*f
 bf_push_row(&!out,&row,1)
 return out
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var src=bf_new(1,1)
 var row:[f64;64]=[0.0;64];row[0]=123.0;bf_push_row(&!src,&row,1)
 println("BEGIN")
 let out=test(&src,22,33,44,1.25,2.5)
 let observed_bits:i64=f64_to_bits(bf_get(&out,0,0));println(observed_bits)
 println("END")
 return 0
}
