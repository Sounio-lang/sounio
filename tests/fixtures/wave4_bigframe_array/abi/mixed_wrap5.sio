fn test(a:i64,b:i64,c:i64,d:i64,e:f64,f:f64,g:i64)->f64 {(a as f64)+2.0*(b as f64)+3.0*(c as f64)+4.0*(d as f64)+5.0*e+6.0*f+7.0*(g as f64)}
fn forward(a:i64,b:i64,c:i64,d:i64,e:f64)->f64 {test(a,b,c,d,e,2.5,707)}
fn main()->i32 with IO {println("BEGIN");let observed_bits:i64=f64_to_bits(forward(11,22,33,44,1.25));println(observed_bits);println("END");return 0}
