fn first(values:&[f64;1024])->f64 {return read_f64(values as *mut f64,0)}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var values:[f64;1024]=[0.0;1024]
 values[0]=3.75
 println("BEGIN")
 let value=first(&values)
 let observed_bits:i64=f64_to_bits(value)
 println(observed_bits)
 println("END")
 return 0
}
