use graph::types::*
fn main()->i32 with IO,Mut,Panic,Div,Epistemic {
 let empty=ProbabilityMeasure::empty()
 let one:[NodeId]=[7]
 let four:[NodeId]=[1,2,3,4]
 let p1=ProbabilityMeasure::uniform(one)
 let p4=ProbabilityMeasure::uniform(four)
 print("SIZE0=");println(empty.support_size())
 print("SIZE1=");println(p1.support_size())
 print("SIZE4=");println(p4.support_size())
 0
}
