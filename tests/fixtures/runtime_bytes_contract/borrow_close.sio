use core::result::{Result}
use text::utf8_bytes::{Utf8Bytes,utf8_bytes_get}
use text::{Utf8Text,utf8_text_from_string,utf8_text_as_bytes,utf8_text_append_scalar,utf8_text_close}
fn main()->i32 with IO,Alloc,Mut,Panic,Div {let text=utf8_text_from_string("owner",64);let held=utf8_text_as_bytes(&text);utf8_text_close(text);match held {Result::Ok(view)=>{return utf8_bytes_get(&view,0).value as i32},Result::Err(code)=>{return code as i32}}}
