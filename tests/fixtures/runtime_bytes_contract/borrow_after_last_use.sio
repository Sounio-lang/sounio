use core::result::{Result}
use text::utf8_bytes::{Utf8Bytes,utf8_bytes_get}
use text::{Utf8Text,utf8_text_from_string,utf8_text_as_bytes,utf8_text_append_scalar,utf8_text_close}
fn main()->i32 with IO,Alloc,Mut,Panic,Div {var text=utf8_text_from_string("owner",64);match utf8_text_as_bytes(&text) {Result::Ok(view)=>{assert(utf8_bytes_get(&view,0).value==111)},Result::Err(_)=>{assert(false)}};assert(utf8_text_append_scalar(&!text,66)==0);utf8_text_close(text);println("RUNTIME_BYTES_LAST_USE_OK");0}
