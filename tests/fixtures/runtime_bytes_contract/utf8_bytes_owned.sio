use core::result::{Result}
use collections::byte_buffer::{byte_buffer_new,byte_buffer_push,byte_buffer_close}
use text::utf8_bytes::{Utf8Bytes,utf8_text_as_bytes,utf8_bytes_len,utf8_bytes_get,utf8_bytes_slice}
use text::utf8::{utf8_text_from_bytes,utf8_text_status,utf8_text_close}
fn slice_error(view:&Utf8Bytes,start:i64,end:i64)->i64 {
 match utf8_bytes_slice(view,start,end) {
  Result::Ok(_)=>{0},
  Result::Err(code)=>{code},
 }
}
fn main()->i32 with IO,Alloc,Mut,Panic,Div {
 var input=byte_buffer_new(32)
 assert(byte_buffer_push(&!input,65)==0)
 assert(byte_buffer_push(&!input,0)==0)
 assert(byte_buffer_push(&!input,195)==0)
 assert(byte_buffer_push(&!input,169)==0)
 assert(byte_buffer_push(&!input,240)==0)
 assert(byte_buffer_push(&!input,159)==0)
 assert(byte_buffer_push(&!input,146)==0)
 assert(byte_buffer_push(&!input,161)==0)
 let text=utf8_text_from_bytes(&input,32)
 byte_buffer_close(input)
 assert(utf8_text_status(&text)==0)
 match utf8_text_as_bytes(&text) {
  Result::Ok(view)=>{
   assert(utf8_bytes_len(&view)==8)
   assert(utf8_bytes_get(&view,0-1).status==4)
   assert(utf8_bytes_get(&view,8).status==4)
   assert(slice_error(&view,0-1,1)==4)
   assert(slice_error(&view,4,3)==4)
   assert(slice_error(&view,0,9)==4)
   match utf8_bytes_slice(&view,0,0) {
    Result::Ok(empty)=>{assert(utf8_bytes_len(&empty)==0);assert(utf8_bytes_get(&empty,0).status==4)},
    Result::Err(_)=>{assert(false)},
   }
   match utf8_bytes_slice(&view,0,8) {
    Result::Ok(full)=>{assert(utf8_bytes_len(&full)==8);assert(utf8_bytes_get(&full,7).value==161)},
    Result::Err(_)=>{assert(false)},
   }
   var i:i64=0
   while i<utf8_bytes_len(&view) {
    let cell=utf8_bytes_get(&view,i)
    assert(cell.status==0)
    print("BYTE ");print_int(i);print(" ");print_int(cell.value);print("\n")
    i=i+1
   }
   match utf8_bytes_slice(&view,3,4) {
    Result::Ok(part)=>{assert(utf8_bytes_len(&part)==1);assert(utf8_bytes_get(&part,0).value==169)},
    Result::Err(_)=>{assert(false)},
   }
  },
  Result::Err(_)=>{assert(false)},
 }
 utf8_text_close(text)
 println("UTF8_AS_BYTES_PROTO_OK")
 0
}
