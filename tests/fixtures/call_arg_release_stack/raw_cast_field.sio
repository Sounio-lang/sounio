//@ run-pass
//@ requires: madaros
//@ expect-stdout: raw cast field PASS
struct CastName { buf:[i8;384], len:i64 }
struct CastItem { origin_module_id:i64, name:CastName }
struct CastItems { head:CastItem, tail:Option<Box<CastItems>> }
struct CastStage { items:Option<Box<CastItems>> }
struct CastPrefix { padding:[i64;3], value:i64 }
fn cast_stage(items:Option<Box<CastItems>>)->Option<Box<CastItems>> with Mut,Alloc,Panic,Div {
 let p=heap_alloc(4096) as *mut CastStage
 (*p).items=items
 let addr=p as i64
 (*(addr as *mut CastStage)).items
}
fn main() with IO,Mut,Panic,Div,Alloc {
 let item=CastItem {origin_module_id:0-1,name:CastName {buf:[0;384],len:3}}
 let items=cast_stage(Some(Box::new(CastItems {head:item,tail:None})))
 match items {
  Some(node)=>{assert((*node).head.origin_module_id==0-1);assert((*node).head.name.len==3)}
  None=>assert(false),
 }
 let p=heap_alloc(4096) as *mut CastPrefix
 (*p).value=73
 let addr=p as i64
 assert((*(addr as *mut CastPrefix)).value==73)
 (*(addr as *mut CastPrefix)).value=91
 assert((*p).value==91)
 print("raw cast field PASS\n")
}
