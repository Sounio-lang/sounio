// Checker-only: native scalar implicit borrowing has a pre-existing lowering defect.
// Consecutive implicit and explicit loans, nested calls, and parameter cursor alignment.
fn read(x: &i64) -> i64 { *x }
fn touch(x: &!i64) -> i64 with Mut { *x }
fn identity(x: i64) -> i64 { x }
fn mixed(a: i64, x: &i64, b: i64, y: &!i64) -> i64 with Mut, Panic {
    assert(a == 11)
    assert(*x == 7)
    assert(b == 22)
    assert(*y == 9)
    *y
}
fn main() with Mut, Panic {
    var x: i64 = 7
    var y: i64 = 9
    assert(touch(&!x) == 7)
    assert(read(&x) == 7)
    assert(touch(&!x) == 7)
    assert(identity(read(&x)) == 7)
    assert(touch(x) == 7)
    assert(read(x) == 7)
    assert(touch(x) == 7)
    assert(mixed(11, x, 22, y) == 9)
    assert(touch(y) == 9)
    assert(mixed(11, &x, 22, &!y) == 9)
    assert(touch(&!y) == 9)
}
