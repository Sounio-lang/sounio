module tests::fixtures::soir_v4::lossless_roundtrip

use ir::serialize::{soir_v4_lossless_roundtrip_self_test}

fn main() -> i64 with IO, Mut, Panic, Div {
    let status = soir_v4_lossless_roundtrip_self_test()
    if status != 0 {
        print("SOIR_V4_LOSSLESS_ROUNDTRIP_RUNTIME_FAIL status=")
        print_int(status)
        print("\n")
        return status
    }
    print("SOIR_V4_LOSSLESS_ROUNDTRIP_RUNTIME_PASS bytes=1624 functions=1 instructions=2 strings=1 epistemic=empty algebras=empty\n")
    0
}
