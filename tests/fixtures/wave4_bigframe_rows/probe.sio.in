use data::bigframe::{bf_new,bf_push_row,bf_get,bf_nrows,bf_free}
use data::bigframe_ops::{bf_unique,bf_drop_duplicates}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
 let n:i64=4000000
 var src=bf_new(2,n)
 var row:[f64;64]=[0.0;64]
 var i:i64=0
 while i<n {
  row[0]=i as f64
  row[1]=(i+10) as f64
  bf_push_row(&!src,&row,2)
  i=i+1
 }
 var unique=bf_unique(&src,0)
 assert(bf_nrows(&unique)==n)
 assert(bf_get(&unique,0,0)==0.0)
 assert(bf_get(&unique,n-1,0)==(n-1) as f64)
 var dedup=bf_drop_duplicates(&src,0)
 assert(bf_nrows(&dedup)==n)
 assert(bf_get(&dedup,0,1)==10.0)
 assert(bf_get(&dedup,n-1,1)==(n+9) as f64)
 i=0
 while i<n {
  assert(bf_get(&unique,i,0)==i as f64)
  assert(bf_get(&dedup,i,0)==i as f64)
  assert(bf_get(&dedup,i,1)==(i+10) as f64)
  i=i+1
 }
 bf_free(&!unique)
 bf_free(&!dedup)
 bf_free(&!src)
 print("BIGFRAME_ROW_REUSE_OK\n")
 0
}
