use compiler::trusted_origins::{trusted_origins_reset,trusted_origins_note,trusted_origin_is_worker,trusted_origin_is_storage}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
 trusted_origins_reset()
 trusted_origins_note(1,"fixtures/ffi/worker.sio")
 trusted_origins_note(2,"fixtures/mem/typed_storage.sio")
 assert(!trusted_origin_is_worker(1))
 assert(!trusted_origin_is_storage(2))
 print("trusted origins fail closed: OK\n")
 0
}
