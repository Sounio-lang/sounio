use compiler::trusted_origins::{trusted_origins_reset,trusted_origins_note,trusted_origin_is_worker,trusted_origin_is_storage}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
 trusted_origins_reset()
 assert(!trusted_origin_is_worker(0))
 trusted_origins_note(1,"fixtures/ffi/worker.sio")
 trusted_origins_note(2,"fixtures/mem/typed_storage.sio")
 trusted_origins_note(3,"spoof/ffi/worker.sio")
 trusted_origins_note(4,"spoof/mem/typed_storage.sio")
 assert(trusted_origin_is_worker(1))
 assert(trusted_origin_is_storage(2))
 assert(!trusted_origin_is_worker(3))
 assert(!trusted_origin_is_storage(4))
 trusted_origins_note(5,"worker-link.sio")
 assert(trusted_origin_is_worker(5))
 trusted_origins_note(6,"storage-hardlink.sio")
 assert(trusted_origin_is_storage(6))
 assert(trusted_origin_is_worker(1))
 assert(trusted_origin_is_storage(2))
 assert(!trusted_origin_is_worker(256))
 assert(!trusted_origin_is_storage(0-1))
 trusted_origins_reset()
 assert(!trusted_origin_is_worker(5))
 assert(!trusted_origin_is_storage(6))
 print("trusted origins native: OK\n")
 0
}
