struct Snapshot {bits:i64}
struct M {count:i64,bits:i64}
fn snapshot_read(m:&M)->Snapshot with Alloc,Mut,Panic,Div {Snapshot{bits:m.bits}}
fn snapshot_clone(s:Snapshot)->Snapshot with Alloc,Mut,Panic,Div {Snapshot{bits:s.bits}}
fn slot_write(m:&!M,index:i64,s:Snapshot) with Alloc,Mut,Panic,Div {m.count=index;m.bits=s.bits}
fn main()->i32 with Alloc,Mut,Panic,Div {var m=M{count:7,bits:19};let index=m.count;let rhs=snapshot_clone(snapshot_read(&m));slot_write(&!m,index,rhs);if m.count!=7 || m.bits!=19 {return 1};0}
