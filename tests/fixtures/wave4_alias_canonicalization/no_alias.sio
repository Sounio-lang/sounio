struct Ghost<T>{value:i64}
impl Ghost<T>{fn get(self:&Ghost<T>,index:i64)->T{0}}
struct Word{value:i64}
impl Word{fn get(self:&Word,index:i64)->i64{self.value+index}}
struct FloatWord{value:f64}
impl FloatWord{fn get(self:&FloatWord,index:i64)->f64{self.value}}
fn main()->i32{let w=Word{value:17};if w.get(1)!=18{return 1};0}
