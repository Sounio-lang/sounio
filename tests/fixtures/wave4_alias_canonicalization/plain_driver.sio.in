use compiler::module_parse::{load_module_file}
use parser::parser::{parser_last_error_count}
use check::specializer::{specialize_generics,spec_report_any_specializer_failure,spec_alias_canonical_single_prepare_after_check,spec_alias_canonical_items_after_check,spec_alias_canonical_count}
use check::mod::{check_items_verdict_boot4}
use parser::ast::{Program}
use ir::ir::{ir_empty_epistemic_section_boxed}
use ir::lower::{lower_program_to_ir_summary_box_with_epistemic_ref,lower_program_bodies_from_summary_with_epistemic_boxed_owned,lower_hard_error_report,fo_preregister_program_items_multipass,fo_xfer_global_reset,lower_use_module_reset,lower_fn_tuple_arr_reset}
use native::codegen_x86_linux::{native_resolve_target,compile_native_v2_preview_to_file}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
 let parsed=load_module_file(get_arg(0))
 if parser_last_error_count()>0 {println("PARSE_REFUSED");return 1}
 let checked_items=specialize_generics(parsed.items)
 var program=Program {module_path:parsed.module_path,items:checked_items}
 if spec_report_any_specializer_failure() {return 1}
 fo_xfer_global_reset()
 lower_use_module_reset()
 lower_fn_tuple_arr_reset()
 fo_preregister_program_items_multipass(&program.items,0)
 let verdict=check_items_verdict_boot4(program.items)
 print("AUTHORITATIVE_CHECK_VERDICT ");println(verdict)
 if verdict!=0 {return 1}
 if str_eq(get_arg(2),"after") {
  spec_alias_canonical_single_prepare_after_check(program.items)
  spec_alias_canonical_items_after_check(program.items,0)
  if spec_alias_canonical_count()>0 {
   fo_xfer_global_reset()
   lower_use_module_reset()
   lower_fn_tuple_arr_reset()
   fo_preregister_program_items_multipass(&program.items,0)
  }
 }
 let epistemic=ir_empty_epistemic_section_boxed()
 let summary=lower_program_to_ir_summary_box_with_epistemic_ref(&program,&(*epistemic))
 if summary.had_error || summary.error_count>0 {lower_hard_error_report();println("ACTUAL_SUMMARY_REFUSED");return 1}
 let lowered=lower_program_bodies_from_summary_with_epistemic_boxed_owned(&program,*summary.summary,&(*epistemic))
 if lowered.had_error || lowered.error_count>0 {lower_hard_error_report();println("ACTUAL_LOWER_REFUSED");return 1}
 let target=native_resolve_target("x86_64-linux","auto",true)
 let status=compile_native_v2_preview_to_file(&(*lowered.module),target,get_arg(1))
 print("ACTUAL_DIRECT_NATIVE_STATUS ");print_int(status as i64);print("\n")
 status as i32
}
