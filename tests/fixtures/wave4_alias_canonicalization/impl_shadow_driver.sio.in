use compiler::module_parse::{load_module_file}
use parser::parser::{parser_last_error_count}
use parser::ast::*
use check::specializer::{specialize_generics,spec_alias_canonical_single_prepare_after_check,spec_alias_canonical_items_after_check}
use check::mod::{check_items_verdict_boot4}
fn impl_placeholder_count(items:Option<Box<ItemList>>)->i64 with Mut,Panic,Div {
 var count:i64=0
 var cursor=items
 while true {match cursor {
  Some(node)=>{
   let item=(*node).head
   if item.kind==ItemKind::ItemImpl {match item.impl_def {
    Some(id)=>{
     var args=(*id).target_type.type_args
     while true {match args {
      Some(arg)=>{
       let ty=(*arg).head
       if ty.kind==TypeExprKind::TypeNamed && ty.path.seg_count==1 {
        let path=ty.path.segments
        if path.head_len==1 {
         let code=path.head_buf[0] as i64
         if code>=65 && code<=90 {count=count+1}
        }
       }
       args=(*arg).tail
      },None=>break,
     }}
    },None=>{},
   }}
   cursor=(*node).tail
  },None=>break,
 }}
 count
}
fn main()->i32 with IO,Mut,Panic,Div,Alloc {
 let parsed=load_module_file(get_arg(0))
 if parser_last_error_count()!=0 {return 2}
 let items=specialize_generics(parsed.items)
 let verdict=check_items_verdict_boot4(items)
 print("CHECK ");println(verdict)
 if verdict!=0 {return 2}
 let before=impl_placeholder_count(items)
 spec_alias_canonical_single_prepare_after_check(items)
 spec_alias_canonical_items_after_check(items,0)
 let after=impl_placeholder_count(items)
 print("IMPL_PLACEHOLDERS_BEFORE ");println(before)
 print("IMPL_PLACEHOLDERS_AFTER ");println(after)
 if before<1 || after!=before {
  println("ALIAS_IMPL_PARAMETER_CAPTURE")
  return 1
 }
 println("ALIAS_IMPL_PARAMETER_PRESERVED")
 0
}
