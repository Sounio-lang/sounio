use linalg::tensor16::{tensor16_zeros,tensor16_set,tensor16_get,tensor16_add_jordan_source}
use linalg::mat16::{mat16_from_array}
fn main()->i64 with IO,Mut,Div,Panic {
 var scenario:i32=0
 while scenario<3 {
  var data:[f64;256]=[0.0;256]
  var i:i32=0
  while i<16 {
   var j:i32=0
   while j<16 {
    if scenario==1 && i==j {data[i*16+j]=1.0}
    if scenario==2 {data[i*16+j]=(((i*7+j*3)%11-5) as f64)/8.0}
    j=j+1
   }
   i=i+1
  }
  let matrix=mat16_from_array(data)
  var initial=tensor16_zeros()
  initial=tensor16_set(initial,0,1,2,0.5)
  initial=tensor16_set(initial,3,4,5,-0.25)
  let result=tensor16_add_jordan_source(initial,matrix)
  i=0
  while i<16 {
   var j:i32=0
   while j<16 {
    var k:i32=0
    while k<16 {print_f64(tensor16_get(result,i,j,k));print("\n");k=k+1}
    j=j+1
   }
   i=i+1
  }
  scenario=scenario+1
 }
 0
}
