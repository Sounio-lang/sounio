fn main() -> i64 with IO, Mut, Div {
    let failures = positive_transition_failures() +
        authority_refusal_failures() + material_refusal_failures()
    if failures == 0 {
        println("SOUNIO_SPARK_PAIR_SELFTEST_PASS vectors=88 authority=Sounio")
        return 0
    }
    println("SOUNIO_SPARK_PAIR_SELFTEST_FAIL")
    1
}
