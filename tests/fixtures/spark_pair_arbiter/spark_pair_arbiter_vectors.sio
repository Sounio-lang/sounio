//! Executable Sounio expectations for the Spark Pair Arbiter policy.

fn test_mask_bit(mask: i64, power: i64) -> i64 with Div {
    (mask / power) % 2
}

fn test_authority(mask: i64) -> SparkPairAuthorityFacts with Div {
    admit_spark_pair_authority_facts(
        test_mask_bit(mask, 1), test_mask_bit(mask, 2),
        test_mask_bit(mask, 4), test_mask_bit(mask, 8),
        test_mask_bit(mask, 16), test_mask_bit(mask, 32),
        test_mask_bit(mask, 64), test_mask_bit(mask, 128),
        test_mask_bit(mask, 256), test_mask_bit(mask, 512),
    )
}

fn test_slurm(mask: i64) -> SparkPairSlurmFacts with Div {
    admit_spark_pair_slurm_facts(
        test_mask_bit(mask, 1), test_mask_bit(mask, 2),
        test_mask_bit(mask, 4), test_mask_bit(mask, 8),
        test_mask_bit(mask, 16), test_mask_bit(mask, 32),
        test_mask_bit(mask, 64), test_mask_bit(mask, 128),
    )
}

fn test_k8s(mask: i64) -> SparkPairK8sFacts with Div {
    admit_spark_pair_k8s_facts(
        test_mask_bit(mask, 1), test_mask_bit(mask, 2),
        test_mask_bit(mask, 256),
        test_mask_bit(mask, 4), test_mask_bit(mask, 8),
        test_mask_bit(mask, 16), test_mask_bit(mask, 32),
        test_mask_bit(mask, 64), test_mask_bit(mask, 128),
        test_mask_bit(mask, 512),
    )
}

fn test_host(mask: i64) -> SparkPairHostFacts with Div {
    admit_spark_pair_host_facts(
        test_mask_bit(mask, 1), test_mask_bit(mask, 2),
        test_mask_bit(mask, 4), test_mask_bit(mask, 8),
        test_mask_bit(mask, 16),
        test_mask_bit(mask, 32), test_mask_bit(mask, 64),
        test_mask_bit(mask, 128), test_mask_bit(mask, 256),
        test_mask_bit(mask, 512), test_mask_bit(mask, 1024),
        test_mask_bit(mask, 2048), test_mask_bit(mask, 4096),
        test_mask_bit(mask, 8192), test_mask_bit(mask, 16384),
        test_mask_bit(mask, 32768),
        test_mask_bit(mask, 65536),
    )
}

fn expect_pair_decision(
    action: i64,
    state: i64,
    epoch: i64,
    observed_epoch: i64,
    authority_mask: i64,
    slurm_mask: i64,
    k8s_mask: i64,
    expected_allowed: bool,
    expected_next: i64,
    expected_reason: i64,
) -> i64 with Div {
    let decision = decide_spark_pair_transition(
        action, state, epoch, observed_epoch,
        test_authority(authority_mask),
        test_slurm(slurm_mask),
        test_k8s(k8s_mask),
        test_host(131071),
    )
    if spark_pair_decision_allowed(decision) != expected_allowed { return 1 }
    if spark_pair_decision_next_state(decision) != expected_next { return 1 }
    if spark_pair_decision_reason(decision) != expected_reason { return 1 }
    0
}

fn expect_pair_host_decision(
    action: i64,
    state: i64,
    epoch: i64,
    observed_epoch: i64,
    authority_mask: i64,
    slurm_mask: i64,
    k8s_mask: i64,
    host_mask: i64,
    expected_allowed: bool,
    expected_next: i64,
    expected_reason: i64,
) -> i64 with Div {
    let decision = decide_spark_pair_transition(
        action, state, epoch, observed_epoch,
        test_authority(authority_mask),
        test_slurm(slurm_mask),
        test_k8s(k8s_mask),
        test_host(host_mask),
    )
    if spark_pair_decision_allowed(decision) != expected_allowed { return 1 }
    if spark_pair_decision_next_state(decision) != expected_next { return 1 }
    if spark_pair_decision_reason(decision) != expected_reason { return 1 }
    0
}

fn positive_transition_failures() -> i64 with Div {
    var failures: i64 = 0
    failures = failures + expect_pair_decision(28, 0, 1, 1, 97, 26, 768, true, 0, 0)
    failures = failures + expect_pair_decision(24, 0, 1, 1, 249, 26, 1009, true, 0, 0)
    failures = failures + expect_pair_host_decision(29, 0, 1, 1, 249, 26, 1009, 0, true, 0, 0)
    failures = failures + expect_pair_decision(23, 0, 1, 1, 1017, 26, 1009, true, 0, 0)
    failures = failures + expect_pair_decision(25, 0, 1, 1, 1017, 30, 1009, true, 0, 0)
    failures = failures + expect_pair_decision(26, 0, 1, 1, 1017, 65, 1009, true, 0, 0)
    failures = failures + expect_pair_decision(27, 0, 1, 999, 993, 255, 1009, true, 0, 0)
    failures = failures + expect_pair_decision(1, 0, 1, 1, 1017, 255, 1009, true, 1, 0)
    failures = failures + expect_pair_decision(2, 1, 1, 1, 1017, 255, 1009, true, 2, 0)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 1017, 255, 1009, true, 3, 0)
    failures = failures + expect_pair_decision(4, 3, 1, 1, 1017, 255, 1009, true, 4, 0)
    failures = failures + expect_pair_decision(5, 4, 1, 1, 1017, 255, 1009, true, 5, 0)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 1017, 255, 767, true, 6, 0)
    failures = failures + expect_pair_decision(7, 6, 1, 1, 1017, 255, 767, true, 6, 0)
    failures = failures + expect_pair_decision(8, 6, 1, 1, 1017, 255, 767, true, 7, 0)
    failures = failures + expect_pair_decision(9, 7, 1, 1, 1017, 255, 767, true, 8, 0)
    failures = failures + expect_pair_decision(10, 8, 1, 1, 1017, 255, 767, true, 9, 0)
    failures = failures + expect_pair_decision(12, 9, 1, 1, 1017, 255, 1009, true, 1, 0)
    failures = failures + expect_pair_decision(13, 10, 2, 2, 1017, 255, 1009, true, 1, 0)
    failures = failures + expect_pair_decision(14, 6, 1, 1, 1017, 255, 767, true, 6, 0)
    failures = failures + expect_pair_decision(11, 6, 1, 999, 993, 255, 767, true, 10, 0)
    failures = failures + expect_pair_decision(11, 10, 2, 1, 993, 255, 1009, true, 10, 0)
    failures = failures + expect_pair_decision(15, 10, 2, 2, 1017, 255, 737, true, 10, 0)
    failures = failures + expect_pair_decision(16, 10, 2, 2, 1017, 255, 751, true, 10, 0)
    failures = failures + expect_pair_decision(17, 10, 2, 2, 1017, 255, 767, true, 10, 0)
    failures = failures + expect_pair_decision(18, 10, 2, 2, 1017, 255, 1009, true, 10, 0)
    failures = failures + expect_pair_decision(19, 10, 2, 2, 1017, 255, 1009, true, 10, 0)
    failures = failures + expect_pair_decision(20, 10, 2, 2, 1017, 223, 1009, true, 10, 0)
    failures = failures + expect_pair_decision(21, 10, 2, 2, 1017, 191, 1009, true, 10, 0)
    failures = failures + expect_pair_decision(22, 10, 2, 2, 1017, 2, 1009, true, 10, 0)
    failures = failures + expect_pair_host_decision(29, 10, 2, 2, 1017, 255, 1009, 0, true, 10, 0)
    failures = failures + expect_pair_host_decision(30, 2, 2, 2, 1017, 255, 1009, 131071, true, 2, 0)
    failures = failures + expect_pair_host_decision(31, 0, 2, 2, 1017, 255, 1009, 131071, true, 0, 0)
    failures = failures + expect_pair_host_decision(32, 3, 2, 2, 1017, 255, 1009, 131071, true, 3, 0)
    // Drain effects remain available while consumers are present. They
    // establish zero jobs before action 30 is allowed to activate the fence.
    failures = failures + expect_pair_host_decision(23, 0, 2, 2, 1017, 2, 1009, 90227, true, 0, 0)
    failures = failures + expect_pair_host_decision(22, 10, 2, 2, 1017, 2, 1009, 90227, true, 10, 0)
    failures = failures + expect_pair_host_decision(30, 10, 2, 2, 1017, 24, 1009, 90227, true, 10, 0)
    failures
}

