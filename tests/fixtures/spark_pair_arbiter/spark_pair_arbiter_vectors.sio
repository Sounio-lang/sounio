fn material_refusal_failures() -> i64 with Div {
    var failures: i64 = 0
    failures = failures + expect_pair_decision(2, 1, 1, 1, 1017, 254, 1009, false, 1, 111)
    failures = failures + expect_pair_decision(2, 1, 1, 1, 1017, 253, 1009, false, 1, 113)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 1017, 251, 767, false, 2, 114)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 1017, 247, 767, false, 2, 115)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 1017, 239, 767, false, 2, 116)
    failures = failures + expect_pair_decision(5, 4, 1, 1, 1017, 223, 1009, false, 4, 117)
    failures = failures + expect_pair_decision(5, 4, 1, 1, 1017, 255, 1008, false, 4, 118)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 1017, 255, 765, false, 5, 119)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 1017, 255, 763, false, 5, 119)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 1017, 255, 759, false, 5, 119)
    // NVML is supplementary on unified-memory GB10. Complete host facts,
    // rather than a driver observation, decide material exclusion.
    failures = failures + expect_pair_decision(6, 5, 1, 1, 1017, 255, 751, true, 6, 0)
    failures = failures + expect_pair_decision(9, 7, 1, 1, 1017, 255, 735, false, 7, 121)
    failures = failures + expect_pair_decision(9, 7, 1, 1, 1017, 255, 703, false, 7, 121)
