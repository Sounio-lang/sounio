    failures = failures + expect_pair_decision(12, 9, 1, 1, 1017, 127, 1009, false, 9, 123)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 65534, false, 0, 128)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 65533, false, 0, 129)
