//! Executable Sounio expectations for the Spark Pair Arbiter policy.

fn test_mask_bit(mask: i64, power: i64) -> i64 with Div {
    (mask / power) % 2
}

fn test_authority(mask: i64) -> SparkPairAuthorityFacts with Div {
    admit_spark_pair_authority_facts(
        test_mask_bit(mask, 1), test_mask_bit(mask, 2),
        test_mask_bit(mask, 4), test_mask_bit(mask, 8),
        test_mask_bit(mask, 16), test_mask_bit(mask, 32),
        test_mask_bit(mask, 64), test_mask_bit(mask, 128),
    )
}

fn test_slurm(mask: i64) -> SparkPairSlurmFacts with Div {
    admit_spark_pair_slurm_facts(
        test_mask_bit(mask, 1), test_mask_bit(mask, 2),
        test_mask_bit(mask, 4), test_mask_bit(mask, 8),
        test_mask_bit(mask, 16), test_mask_bit(mask, 32),
        test_mask_bit(mask, 64), test_mask_bit(mask, 128),
    )
}

fn test_k8s(mask: i64) -> SparkPairK8sFacts with Div {
    admit_spark_pair_k8s_facts(
        test_mask_bit(mask, 1), test_mask_bit(mask, 2),
        test_mask_bit(mask, 4), test_mask_bit(mask, 8),
        test_mask_bit(mask, 16), test_mask_bit(mask, 32),
        test_mask_bit(mask, 64), test_mask_bit(mask, 128),
    )
}

fn expect_pair_decision(
    action: i64,
    state: i64,
    epoch: i64,
    observed_epoch: i64,
    authority_mask: i64,
    slurm_mask: i64,
    k8s_mask: i64,
    expected_allowed: bool,
    expected_next: i64,
    expected_reason: i64,
) -> i64 with Div {
    let decision = decide_spark_pair_transition(
        action, state, epoch, observed_epoch,
        test_authority(authority_mask),
        test_slurm(slurm_mask),
        test_k8s(k8s_mask),
    )
    if spark_pair_decision_allowed(decision) != expected_allowed { return 1 }
    if spark_pair_decision_next_state(decision) != expected_next { return 1 }
    if spark_pair_decision_reason(decision) != expected_reason { return 1 }
    0
}

fn positive_transition_failures() -> i64 with Div {
    var failures: i64 = 0
    failures = failures + expect_pair_decision(1, 0, 1, 1, 249, 255, 255, true, 1, 0)
    failures = failures + expect_pair_decision(2, 1, 1, 1, 249, 255, 255, true, 2, 0)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 249, 255, 255, true, 3, 0)
    failures = failures + expect_pair_decision(4, 3, 1, 1, 249, 255, 255, true, 4, 0)
    failures = failures + expect_pair_decision(5, 4, 1, 1, 249, 255, 255, true, 5, 0)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 249, 255, 255, true, 6, 0)
    failures = failures + expect_pair_decision(7, 6, 1, 1, 249, 255, 255, true, 6, 0)
    failures = failures + expect_pair_decision(8, 6, 1, 1, 249, 255, 255, true, 7, 0)
    failures = failures + expect_pair_decision(9, 7, 1, 1, 249, 255, 255, true, 8, 0)
    failures = failures + expect_pair_decision(10, 8, 1, 1, 249, 255, 255, true, 9, 0)
    failures = failures + expect_pair_decision(12, 9, 1, 1, 249, 255, 255, true, 1, 0)
    failures = failures + expect_pair_decision(13, 10, 2, 2, 249, 255, 255, true, 1, 0)
    failures = failures + expect_pair_decision(14, 6, 1, 1, 249, 255, 255, true, 6, 0)
    failures = failures + expect_pair_decision(11, 6, 1, 1, 225, 255, 255, true, 10, 0)
    failures
}

fn authority_refusal_failures() -> i64 with Div {
    var failures: i64 = 0
    failures = failures + expect_pair_decision(14, 1, 1, 1, 248, 255, 255, false, 1, 101)
    failures = failures + expect_pair_decision(14, 1, 1, 1, 251, 255, 255, false, 1, 102)
    failures = failures + expect_pair_decision(14, 1, 1, 1, 253, 255, 255, false, 1, 103)
    failures = failures + expect_pair_decision(14, 1, 0, 0, 249, 255, 255, false, 1, 107)
    failures = failures + expect_pair_decision(14, 1, 2, 1, 249, 255, 255, false, 1, 107)
    failures = failures + expect_pair_decision(14, 1, 1, 1, 217, 255, 255, false, 1, 109)
    failures = failures + expect_pair_decision(14, 1, 1, 1, 241, 255, 255, false, 1, 106)
    failures = failures + expect_pair_decision(14, 1, 1, 1, 233, 255, 255, false, 1, 108)
    failures = failures + expect_pair_decision(2, 1, 1, 1, 185, 255, 255, false, 1, 110)
    failures = failures + expect_pair_decision(2, 1, 1, 1, 121, 255, 255, false, 1, 112)
    failures = failures + expect_pair_decision(99, 1, 1, 1, 249, 255, 255, false, 1, 124)
    failures = failures + expect_pair_decision(2, 0, 1, 1, 249, 255, 255, false, 0, 105)
    failures
}

fn material_refusal_failures() -> i64 with Div {
    var failures: i64 = 0
    failures = failures + expect_pair_decision(2, 1, 1, 1, 249, 254, 255, false, 1, 111)
    failures = failures + expect_pair_decision(2, 1, 1, 1, 249, 253, 255, false, 1, 113)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 249, 251, 255, false, 2, 114)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 249, 247, 255, false, 2, 115)
    failures = failures + expect_pair_decision(3, 2, 1, 1, 249, 239, 255, false, 2, 116)
    failures = failures + expect_pair_decision(5, 4, 1, 1, 249, 223, 255, false, 4, 117)
    failures = failures + expect_pair_decision(5, 4, 1, 1, 249, 255, 254, false, 4, 118)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 249, 255, 253, false, 5, 119)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 249, 255, 251, false, 5, 119)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 249, 255, 247, false, 5, 119)
    failures = failures + expect_pair_decision(6, 5, 1, 1, 249, 255, 239, false, 5, 120)
    failures = failures + expect_pair_decision(9, 7, 1, 1, 249, 255, 223, false, 7, 121)
    failures = failures + expect_pair_decision(9, 7, 1, 1, 249, 255, 191, false, 7, 121)
    failures = failures + expect_pair_decision(7, 6, 1, 1, 249, 255, 127, false, 6, 122)
    failures = failures + expect_pair_decision(12, 9, 1, 1, 249, 127, 255, false, 9, 123)
    failures
}

fn main() -> i64 with IO, Mut, Div {
    let failures = positive_transition_failures() +
        authority_refusal_failures() + material_refusal_failures()
    if failures == 0 {
        println("SOUNIO_SPARK_PAIR_SELFTEST_PASS vectors=41 authority=Sounio")
        return 0
    }
    println("SOUNIO_SPARK_PAIR_SELFTEST_FAIL")
    1
}
