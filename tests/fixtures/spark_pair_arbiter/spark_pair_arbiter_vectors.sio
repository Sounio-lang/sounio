    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 65503, false, 0, 133)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 65471, false, 0, 134)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 65407, false, 0, 135)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 65279, false, 0, 136)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 65023, false, 0, 137)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 64511, false, 0, 138)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 63487, false, 0, 139)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 61439, false, 0, 140)
    failures = failures + expect_pair_host_decision(31, 0, 1, 1, 1017, 26, 1009, 57343, false, 0, 141)
