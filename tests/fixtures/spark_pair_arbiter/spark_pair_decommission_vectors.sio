fn main() -> i64 with IO, Mut, Div {
    let failures = decommission_positive_failures() +
        decommission_recovery_entry_failures() + decommission_refusal_failures()
    if failures == 0 {
        println("SOUNIO_SPARK_PAIR_DECOMMISSION_SELFTEST_PASS vectors=69 authority=Sounio effect=NONE")
        return 0
    }
    println("SOUNIO_SPARK_PAIR_DECOMMISSION_SELFTEST_FAIL")
    1
}
