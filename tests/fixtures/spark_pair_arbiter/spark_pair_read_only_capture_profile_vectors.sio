//! Sounio-owned vectors for the strict observation producer profile of frame 9027.

fn capture_profile_test_digest(tag: i64) -> SparkPairRestoreDigest256 {
    admit_spark_pair_restore_digest256(
        tag, tag + 1, tag + 2, tag + 3,
        tag + 4, tag + 5, tag + 6, tag + 7,
    )
}

fn capture_profile_test_zero() -> SparkPairRestoreDigest256 {
    admit_spark_pair_restore_digest256(0, 0, 0, 0, 0, 0, 0, 0)
}

fn capture_profile_test_decide(
    snapshot: SparkPairRestoreDigest256,
    node0: SparkPairRestoreDigest256,
    node1: SparkPairRestoreDigest256,
    historical: SparkPairRestoreDigest256,
    historical_status: i64,
    observation_mask: i64,
    integrity_mask: i64,
    policy_error: i64,
    timed_out: i64,
) -> SparkPairReadOnlyCaptureProfileDecision with Div {
    decide_spark_pair_read_only_capture_profile(
        snapshot, node0, node1, historical, historical_status,
        observation_mask, integrity_mask, policy_error, timed_out,
    )
}

fn capture_profile_complete() -> SparkPairReadOnlyCaptureProfileDecision with Div {
    capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), capture_profile_test_zero(),
        0, 131071, 127, 0, 0,
    )
}

fn expect_capture_profile_complete() -> i64 with Div {
    let decision = capture_profile_complete()
    if !spark_pair_read_only_capture_receipt_accepted(decision) { return 1 }
    if spark_pair_read_only_capture_incomplete(decision) { return 1 }
    if !spark_pair_read_only_capture_frame_9027_invoked(decision) { return 1 }
    if spark_pair_read_only_capture_restorable(decision) { return 1 }
    if spark_pair_read_only_capture_restore_allowed(decision) { return 1 }
    if spark_pair_read_only_capture_restore_reason(decision) != 315 { return 1 }
    if spark_pair_read_only_capture_profile_reason(decision) != 0 { return 1 }
    if spark_pair_read_only_capture_profile_snapshot_mask(decision) != 491455 { return 1 }
    0
}

fn capture_profile_reason_for_observation_power(power: i64) -> i64 {
    if power == 1 { return 311 }
    if power == 2 || power == 4 { return 312 }
    if power == 8 { return 313 }
    if power == 16 || power == 32 { return 314 }
    if power == 64 || power == 128 { return 316 }
    if power == 256 { return 317 }
    if power == 512 || power == 1024 { return 318 }
    if power == 2048 || power == 4096 || power == 8192 { return 319 }
    if power == 16384 { return 320 }
    if power == 32768 { return 321 }
    323
}

fn expect_capture_profile_missing_observation(power: i64) -> i64 with Div {
    let decision = capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), capture_profile_test_zero(),
        0, 131071 - power, 127, 0, 0,
    )
    if spark_pair_read_only_capture_receipt_accepted(decision) { return 1 }
    if !spark_pair_read_only_capture_incomplete(decision) { return 1 }
    if spark_pair_read_only_capture_frame_9027_invoked(decision) { return 1 }
    if spark_pair_read_only_capture_profile_reason(decision) != 405 { return 1 }
    if spark_pair_read_only_capture_restore_reason(decision) !=
        capture_profile_reason_for_observation_power(power) { return 1 }
    0
}

fn expect_capture_profile_missing_integrity(power: i64) -> i64 with Div {
    let decision = capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), capture_profile_test_zero(),
        0, 131071, 127 - power, 0, 0,
    )
    if spark_pair_read_only_capture_receipt_accepted(decision) { return 1 }
    if !spark_pair_read_only_capture_incomplete(decision) { return 1 }
    if spark_pair_read_only_capture_frame_9027_invoked(decision) { return 1 }
    if spark_pair_read_only_capture_restore_reason(decision) != 322 { return 1 }
    if spark_pair_read_only_capture_profile_snapshot_mask(decision) != 360383 { return 1 }
    0
}

fn expect_capture_profile_history(
    historical: SparkPairRestoreDigest256,
    status: i64,
    expected_profile_reason: i64,
) -> i64 with Div {
    let decision = capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), historical,
        status, 131071, 127, 0, 0,
    )
    if spark_pair_read_only_capture_receipt_accepted(decision) { return 1 }
    if spark_pair_read_only_capture_profile_reason(decision) != expected_profile_reason {
        return 1
    }
    0
}

fn expect_capture_profile_identity_reason(
    snapshot: SparkPairRestoreDigest256,
    node0: SparkPairRestoreDigest256,
    node1: SparkPairRestoreDigest256,
    expected_reason: i64,
) -> i64 with Div {
    let decision = capture_profile_test_decide(
        snapshot, node0, node1, capture_profile_test_zero(),
        0, 131071, 127, 0, 0,
    )
    if !spark_pair_read_only_capture_incomplete(decision) { return 1 }
    if !spark_pair_read_only_capture_frame_9027_invoked(decision) { return 1 }
    if spark_pair_read_only_capture_restore_reason(decision) != expected_reason { return 1 }
    0
}

fn expect_capture_profile_field_schema() -> i64 {
    if spark_pair_read_only_capture_node_field_count() != 38 { return 1 }
    if spark_pair_read_only_capture_node_field_name(0) != "schema" { return 1 }
    if spark_pair_read_only_capture_node_field_name(9) != "protected_content_receipt" { return 1 }
    if spark_pair_read_only_capture_node_field_name(10) !=
        "restorable.systemd_system_sha256" { return 1 }
    if spark_pair_read_only_capture_node_field_name(17) !=
        "restorable.protected_paths_metadata_sha256" { return 1 }
    if spark_pair_read_only_capture_node_field_name(18) !=
        "observation.boot_identity_sha256" { return 1 }
    if spark_pair_read_only_capture_node_field_name(34) !=
        "observation.no_unknown_fields" { return 1 }
    if spark_pair_read_only_capture_node_field_name(37) != "state_transition" { return 1 }
    if spark_pair_read_only_capture_node_field_name(38) != "INVALID" { return 1 }
    if spark_pair_read_only_capture_node_field_class(0) != 0 { return 1 }
    if spark_pair_read_only_capture_node_field_class(10) != 1 { return 1 }
    if spark_pair_read_only_capture_node_field_class(18) != 2 { return 1 }
    if spark_pair_read_only_capture_node_field_class(35) != 3 { return 1 }
    if spark_pair_read_only_capture_node_field_class(38) != -1 { return 1 }
    if spark_pair_read_only_capture_pair_field_count() != 16 { return 1 }
    if spark_pair_read_only_capture_pair_field_name(0) != "schema" { return 1 }
    if spark_pair_read_only_capture_pair_field_name(3) != "node0_manifest_sha256" { return 1 }
    if spark_pair_read_only_capture_pair_field_name(9) != "node1_observation_sha256" { return 1 }
    if spark_pair_read_only_capture_pair_field_name(15) != "state_transition" { return 1 }
    if spark_pair_read_only_capture_pair_field_name(16) != "INVALID" { return 1 }
    0
}

fn main() -> i64 with IO, Div {
    var failures = 0
    var vectors = 0

    let complete_result = expect_capture_profile_complete()
    if complete_result != 0 { println("capture_profile_vector_fail=complete") }
    failures = failures + complete_result; vectors = vectors + 1
    let schema_result = expect_capture_profile_field_schema()
    if schema_result != 0 { println("capture_profile_vector_fail=field_schema") }
    failures = failures + schema_result; vectors = vectors + 1

    var observation_power = 1
    while observation_power <= 65536 {
        let observation_result = expect_capture_profile_missing_observation(observation_power)
        if observation_result != 0 { println("capture_profile_vector_fail=missing_observation") }
        failures = failures + observation_result
        vectors = vectors + 1
        observation_power = observation_power * 2
    }

    var integrity_power = 1
    while integrity_power <= 64 {
        let integrity_result = expect_capture_profile_missing_integrity(integrity_power)
        if integrity_result != 0 { println("capture_profile_vector_fail=missing_integrity") }
        failures = failures + integrity_result
        vectors = vectors + 1
        integrity_power = integrity_power * 2
    }

    failures = failures + expect_capture_profile_history(
        capture_profile_test_digest(401), 0, 402,
    ); vectors = vectors + 1
    failures = failures + expect_capture_profile_history(
        capture_profile_test_zero(), 1, 402,
    ); vectors = vectors + 1
    failures = failures + expect_capture_profile_history(
        capture_profile_test_digest(401), 1, 403,
    ); vectors = vectors + 1
    failures = failures + expect_capture_profile_history(
        capture_profile_test_zero(), 2, 401,
    ); vectors = vectors + 1

    failures = failures + expect_capture_profile_identity_reason(
        capture_profile_test_zero(), capture_profile_test_digest(201),
        capture_profile_test_digest(301), 309,
    ); vectors = vectors + 1
    failures = failures + expect_capture_profile_identity_reason(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(201), 314,
    ); vectors = vectors + 1
    failures = failures + expect_capture_profile_identity_reason(
        capture_profile_test_digest(201), capture_profile_test_digest(201),
        capture_profile_test_digest(301), 309,
    ); vectors = vectors + 1

    let policy_error = capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), capture_profile_test_zero(),
        0, 131071, 127, 1, 0,
    )
    if spark_pair_read_only_capture_restore_reason(policy_error) != 302 { failures = failures + 1 }
    vectors = vectors + 1

    let timeout = capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), capture_profile_test_zero(),
        0, 131071, 127, 0, 1,
    )
    if spark_pair_read_only_capture_restore_reason(timeout) != 303 { failures = failures + 1 }
    vectors = vectors + 1

    let malformed_mask = capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), capture_profile_test_zero(),
        0, 131072, 127, 0, 0,
    )
    if spark_pair_read_only_capture_profile_reason(malformed_mask) != 401 {
        failures = failures + 1
    }
    vectors = vectors + 1

    let malformed_bit = capture_profile_test_decide(
        capture_profile_test_digest(101), capture_profile_test_digest(201),
        capture_profile_test_digest(301), capture_profile_test_zero(),
        0, 131071, 127, 2, 0,
    )
    if spark_pair_read_only_capture_profile_reason(malformed_bit) != 401 {
        failures = failures + 1
    }
    vectors = vectors + 1

    if failures != 0 {
        println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_SELFTEST_FAIL")
        return 1
    }
    println("SOUNIO_SPARK_PAIR_READ_ONLY_CAPTURE_PROFILE_SELFTEST_PASS vectors=37 authority=Sounio")
    0
}
