use geo::pure::types::{point2d_new,point3d_new,point2d_distance,point3d_distance}
fn emit(x:f64,y:f64,z:f64) with IO,Mut,Div,Panic {
 let a=point2d_new(0.0,0.0);let b=point2d_new(x,y)
 print_int(f64_to_bits(point2d_distance(&a,&b)));print("\n")
 let c=point3d_new(0.0,0.0,0.0);let d=point3d_new(x,y,z)
 print_int(f64_to_bits(point3d_distance(&c,&d)));print("\n")
}
fn main()->i32 with IO,Mut,Div,Panic {
 emit(0.0,0.0,0.0)
 emit(3.0,4.0,0.0)
 emit(1.0,2.0,2.0)
 emit(-3.0,-4.0,-12.0)
 emit(1.0e308,1.0e308,0.0)
 emit(1.0e308,1.0e308,1.0e308)
 emit(1.0e-308,1.0e-308,1.0e-308)
 emit(1.0e-320,1.0e-320,0.0)
 emit(1.7976931348623157e308,1.0e292,0.0)
 emit(-0.0,0.0,-0.0)
 emit(1.0e-200,1.0e200,-1.0e-100)
 let inf=bits_to_f64(9218868437227405312)
 let nan=bits_to_f64(9221120237041090561)
 emit(inf,2.0,3.0)
 emit(nan,2.0,3.0)
 emit(nan,inf,3.0)
 emit(2.0,nan,inf)
 0
}
