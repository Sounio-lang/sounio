// Companion observability only. Original test_graph_types_e2e.sio is unchanged.
use graph::types::*
fn main()->i32 with IO,Mut,Panic,Epistemic {
    var g=Graph::new(4)
    g.add_edge(0,1)
    g.add_edge(0,2)
    g.add_edge(0,3)
    g.add_edge(1,2)
    print("GRAPH_NODES ");print_int(g.num_nodes());println("")
    print("GRAPH_EDGES ");print_int(g.num_edges());println("")
    var u:i64=0
    while u<4 {
        print("GRAPH_DEGREE ");print_int(u);print(" ");print_int(g.degree(u));println("")
        u=u+1
    }
    u=0
    while u<4 {
        var v:i64=0
        while v<4 {
            print("GRAPH_HAS ");print_int(u);print(" ");print_int(v);print(" ")
            print_int(if g.has_edge(u,v) {1}else{0});println("")
            v=v+1
        }
        u=u+1
    }
    let nb: Seq<NodeId> = g.neighbors(3)
    print("GRAPH_NEIGHBOR_COUNT 3 ");print_int(nb.len().unwrap("neighbors"));println("")
    print("GRAPH_NEIGHBOR 3 0 ");print_int(nb.get(0));println("")
    println("GRAPH_METRICS_END")
    0
}
