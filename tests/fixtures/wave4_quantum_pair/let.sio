// Both resource layers are explicitly linear; dropping or duplicating them is invalid.
linear struct Token { id:i64 }
linear struct Pair { first:Token, second:Token }
fn take(t:Token)->i64 {
 match t { Token { id } => id }
}
fn main()->i32 with IO,Mut,Alloc,Div,Panic {
 let p=Pair {first:Token{id:17},second:Token{id:25}}
 let Pair { first, second } = p
  let a=take(first)
  let b=take(second)
  assert(a==17)
  assert(b==25)
  assert(a+b==42)
  print("PAIR_FIRST=");println(a)
  print("PAIR_SECOND=");println(b)
  print("PAIR_SUM=");println(a+b)
 println("LINEAR_PAIR_LET_OK")
 0
}
