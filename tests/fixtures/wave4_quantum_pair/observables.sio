use quantum::born_shot_law::{ry_cnot_cov,ry_cz_cov,ghz4_parity,ry_chsh_exit,ry_partial_chsh}
use quantum::qasm_tape::{tape_new,tape_ry,tape_rz,tape_h,tape_cx,tape_replay_2,tape_bell}
fn emit(label:string,value:f64) with IO {
 let bits:i64=f64_to_bits(value)
 print(label);print("=");println(bits)
}
fn main()->i32 with IO,Mut,Alloc,Div,Panic {
 let pi=3.141592653589793
 let cn=ry_cnot_cov(0.37,0.0)
 emit("cn.mu0",cn.mu0)
 emit("cn.mu1",cn.mu1)
 emit("cn.second",cn.second)
 emit("cn.cov",cn.cov)
 emit("cn.given_angle",cn.given_angle)
 emit("cn.across_angles",cn.across_angles)
 let cz=ry_cz_cov(0.37,0.0)
 emit("cz.mu0",cz.mu0)
 emit("cz.mu1",cz.mu1)
 emit("cz.second",cz.second)
 emit("cz.cov",cz.cov)
 emit("cz.given_angle",cz.given_angle)
 emit("cz.across_angles",cz.across_angles)
 let gh=ghz4_parity()
 emit("gh.parity",gh.parity)
 emit("gh.marginal",gh.marginal)
 let ch=ry_chsh_exit(pi)
 emit("ch.zz_copy",ch.zz_copy)
 emit("ch.xx_copy",ch.xx_copy)
 emit("ch.zz_bell",ch.zz_bell)
 emit("ch.xx_bell",ch.xx_bell)
 emit("ch.chsh_bell",ch.chsh_bell)
 emit("ch.chsh_00",ch.chsh_00)
 emit("ch.chsh_01",ch.chsh_01)
 emit("ch.chsh_10",ch.chsh_10)
 emit("ch.chsh_11",ch.chsh_11)
 let pt=ry_partial_chsh(0.7,0.41,pi)
 emit("pt.zz",pt.zz)
 emit("pt.xx",pt.xx)
 emit("pt.fixed",pt.fixed)
 emit("pt.tilted",pt.tilted)
 var rev=tape_new(2)
 rev=tape_ry(rev,0,0.31)
 rev=tape_ry(rev,1,1.13)
 rev=tape_cx(rev,1,0)
 rev=tape_rz(rev,0,-0.43)
 rev=tape_h(rev,1)
 let rev_p=tape_replay_2(rev)
 emit("rev.p00",rev_p.p00)
 emit("rev.p01",rev_p.p01)
 emit("rev.p10",rev_p.p10)
 emit("rev.p11",rev_p.p11)
 var fwd=tape_new(2)
 fwd=tape_ry(fwd,0,0.31)
 fwd=tape_ry(fwd,1,1.13)
 fwd=tape_cx(fwd,0,1)
 fwd=tape_rz(fwd,0,-0.43)
 fwd=tape_h(fwd,1)
 let fwd_p=tape_replay_2(fwd)
 emit("fwd.p00",fwd_p.p00)
 emit("fwd.p01",fwd_p.p01)
 emit("fwd.p10",fwd_p.p10)
 emit("fwd.p11",fwd_p.p11)
 let bell=tape_replay_2(tape_bell())
 emit("bell.p00",bell.p00)
 emit("bell.p01",bell.p01)
 emit("bell.p10",bell.p10)
 emit("bell.p11",bell.p11)
 println("QUANTUM_OBSERVABLES_END")
 0
}
