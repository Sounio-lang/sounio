fn emit_constraint(kind:i64,pair:i64,lhs:i64,rhs:i64) with IO,Alloc,Mut,Div,Panic {
    var ctx=dep_context_new()
    let a=dep_term_int(&!ctx,lhs)
    let b=dep_term_int(&!ctx,rhs)
    dep_add_constraint(&!ctx,kind,a,b,0)
    let result=dep_check_single_constraint(&!ctx,0)
    print("D|");print_int(kind);print("|");print_int(pair);print("|");print_int(if result {1} else {0});print("\n")
}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
    var lhs:[i64;8]=[0;8]
    var rhs:[i64;8]=[0;8]
    lhs[0]=0;rhs[0]=0
    lhs[1]=0-2;rhs[1]=0
    lhs[2]=2;rhs[2]=0-2
    lhs[3]=3;rhs[3]=3
    lhs[4]=9223372036854775807;rhs[4]=0
    lhs[5]=0-9223372036854775807-1;rhs[5]=0
    lhs[6]=0-1;rhs[6]=0
    lhs[7]=0-1;rhs[7]=0-1
    var kind:i64=0
    while kind<7 {
        var pair:i64=0
        while pair<8 {emit_constraint(kind,pair,lhs[pair as usize],rhs[pair as usize]);pair=pair+1}
        kind=kind+1
    }
    emit_constraint(0-1,8,5,3)
    emit_constraint(7,8,5,3)
    emit_constraint(9223372036854775807,8,5,3)
    emit_constraint(0-9223372036854775807-1,8,5,3)
    kind=0
    while kind<7 {
        var ctx=dep_context_new()
        let two=dep_term_int(&!ctx,2)
        let three=dep_term_int(&!ctx,3)
        let sum=dep_term_add(&!ctx,two,three)
        let five=dep_term_int(&!ctx,5)
        dep_add_constraint(&!ctx,kind,sum,five,0)
        print("A|");print_int(kind);print("|");print_int(if dep_check_single_constraint(&!ctx,0) {1} else {0});print("\n")
        kind=kind+1
    }
    var empty=dep_context_new()
    print("I|-1|");print_int(if dep_check_single_constraint(&!empty,0-1) {1} else {0});print("\n")
    print("I|0|");print_int(if dep_check_single_constraint(&!empty,0) {1} else {0});print("\n")
    println("TOTAL_TAGS_DEPENDENT_END")
    0
}
