fn emit_name(kind:i64) with IO,Alloc {
    print("N|");print_int(kind);print("|");print(provenance_kind_name(kind));print("\n")
}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
    var tags:[i64;11]=[0;11]
    var i:i64=0
    while i<8 {tags[i as usize]=i;i=i+1}
    tags[8]=0-1
    tags[9]=9223372036854775807
    tags[10]=0-9223372036854775807-1
    i=0
    while i<11 {
        let kind=tags[i as usize]
        // Before lacks a return for an unknown string tag: do not dereference
        // an undefined string result merely to collect its unsafe baseline.
        if @AFTER@==1 || i<6 {emit_name(kind)}
        print("P|");print_int(kind);print("|");print_int(if provenance_kind_needs_verification(kind) {1} else {0});print("\n")
        var t:i64=0
        while t<3 {
            var now:f64=0.0-1.0
            if t==1 {now=0.5}
            if t==2 {now=2.0}
            let validity=Validity {kind:kind,duration_sec:10.0,until_timestamp:0.5,pred_id:0.0}
            print("V|");print_int(kind);print("|");print_int(t);print("|");print_int(if validity_is_expired(validity,now) {1} else {0});print("\n")
            t=t+1
        }
        i=i+1
    }
    let unsat=validity_unsatisfiable()
    print("U|");print_int(unsat.kind);print("|");print_int(if validity_is_expired(unsat,0.5) {1} else {0});print("\n")
    print("S|");print_int(if validity_subsumes(unsat,unsat) {1} else {0});print("\n")
    println("TOTAL_TAGS_EPISTEMIC_END")
    0
}
