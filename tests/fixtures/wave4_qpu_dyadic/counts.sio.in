use quantum::qasm_tape::{BasisProb,ShotCounts}
use ffi::platform::{Platform,platform_open,platform_status,platform_call,platform_close}
fn wide_core_literal(p: BasisProb, shots: i64, seed: i64) -> ShotCounts with Mut, Div, Panic {
    var n00: i64 = 0
    var n01: i64 = 0
    var n10: i64 = 0
    var n11: i64 = 0
    var s = seed
    if s == 0 { s = 1 }
    var k: i64 = 0
    let scale = 4294967296.0
    let b01 = p.p00 + p.p01
    let b10 = b01 + p.p10
    while k < shots {
        s = s * 6364136223846793005 + 1442695040888963407
        let u = (((s >> 32) & 4294967295) as f64) / scale
        if u < p.p00 {
            n00 = n00 + 1
        } else {
            if u < b01 {
                n01 = n01 + 1
            } else {
                if u < b10 {
                    n10 = n10 + 1
                } else {
                    n11 = n11 + 1
                }
            }
        }
        k = k + 1
    }
    ShotCounts { n00: n00, n01: n01, n10: n10, n11: n11 }
}

fn wide_core_dyadic(p: BasisProb, shots: i64, seed: i64) -> ShotCounts with Mut, Div, Panic {
    var n00: i64 = 0
    var n01: i64 = 0
    var n10: i64 = 0
    var n11: i64 = 0
    var s = seed
    if s == 0 { s = 1 }
    var k: i64 = 0
    let inverse_scale = 0.00000000023283064365386962890625
    let b01 = p.p00 + p.p01
    let b10 = b01 + p.p10
    while k < shots {
        s = s * 6364136223846793005 + 1442695040888963407
        let u = (((s >> 32) & 4294967295) as f64) * inverse_scale
        if u < p.p00 {
            n00 = n00 + 1
        } else {
            if u < b01 {
                n01 = n01 + 1
            } else {
                if u < b10 {
                    n10 = n10 + 1
                } else {
                    n11 = n11 + 1
                }
            }
        }
        k = k + 1
    }
    ShotCounts { n00: n00, n01: n01, n10: n10, n11: n11 }
}

fn emit_counts(name:string,kind:string,ns:i64,c:ShotCounts) with IO {
 print("CASE=");println(name)
 print("VARIANT=");println(kind)
 print("ELAPSED_NS=");println(ns)
 print("N00=");println(c.n00)
 print("N01=");println(c.n01)
 print("N10=");println(c.n10)
 print("N11=");println(c.n11)
}
fn run_case(p:&Platform,name:string,probs:BasisProb,shots:i64,seed:i64,reverse:bool) with IO,Alloc,Mut,Div,Panic {
 if reverse {
  let t0=platform_call(p,30,0,0,0,0)
  let b=wide_core_dyadic(probs,shots,seed)
  let t1=platform_call(p,30,0,0,0,0)
  emit_counts(name,"dyadic",t1.value-t0.value,b)
  let t2=platform_call(p,30,0,0,0,0)
  let a=wide_core_literal(probs,shots,seed)
  let t3=platform_call(p,30,0,0,0,0)
  emit_counts(name,"literal",t3.value-t2.value,a)
 } else {
  let t0=platform_call(p,30,0,0,0,0)
  let a=wide_core_literal(probs,shots,seed)
  let t1=platform_call(p,30,0,0,0,0)
  emit_counts(name,"literal",t1.value-t0.value,a)
  let t2=platform_call(p,30,0,0,0,0)
  let b=wide_core_dyadic(probs,shots,seed)
  let t3=platform_call(p,30,0,0,0,0)
  emit_counts(name,"dyadic",t3.value-t2.value,b)
 }
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
@CALLS@
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("WIDE_COUNTS_DIAGNOSTIC_END")
 0
}
