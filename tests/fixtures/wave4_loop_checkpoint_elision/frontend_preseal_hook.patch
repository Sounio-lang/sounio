+fn module_frontend_loop_checkpoint_cleanup(module: &! IrModule, arch_id: i64, os_id: i64) with IO, Mut, Div, Panic {
+    // Experimental x86_64 Linux native-v2 proof only, independent of -O.
+    // Called before the FIRST seal. Worker cloning/proof happens later.
+    if str_eq(read_env("SOUNIO_LOOP_REGIONS"), "1") && arch_id == ARCH_X86_64() && os_id == OS_LINUX() {
+        let audit = loop_checkpoint_elide_module(module)
+        print("loop_checkpoint_elision: functions=")
+        print_int(audit.functions)
+        print(" refused=")
+        print_int(audit.refused)
+        print(" entries=")
+        print_int(audit.entries)
+        print(" eligible=")
+        print_int(audit.eligible)
+        print(" neutralized=")
+        print_int(audit.neutralized)
+        print(" status=")
+        print_int(audit.status)
+        print("\n")
+    }
+}
