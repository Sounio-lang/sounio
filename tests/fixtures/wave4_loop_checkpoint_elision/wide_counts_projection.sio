// SINGLE-FILE IR PROJECTION: no import-loader or public API acceptance.
// Struct layouts match the imported counter types. Both cores remain byte-exact.
struct BasisProb {p00:f64,p01:f64,p10:f64,p11:f64}
struct ShotCounts {n00:i64,n01:i64,n10:i64,n11:i64}
fn wide_core_literal(p: BasisProb, shots: i64, seed: i64) -> ShotCounts with Mut, Div, Panic {
    var n00: i64 = 0
    var n01: i64 = 0
    var n10: i64 = 0
    var n11: i64 = 0
    var s = seed
    if s == 0 { s = 1 }
    var k: i64 = 0
    let scale = 4294967296.0
    let b01 = p.p00 + p.p01
    let b10 = b01 + p.p10
    while k < shots {
        s = s * 6364136223846793005 + 1442695040888963407
        let u = (((s >> 32) & 4294967295) as f64) / scale
        if u < p.p00 {
            n00 = n00 + 1
        } else {
            if u < b01 {
                n01 = n01 + 1
            } else {
                if u < b10 {
                    n10 = n10 + 1
                } else {
                    n11 = n11 + 1
                }
            }
        }
        k = k + 1
    }
    ShotCounts { n00: n00, n01: n01, n10: n10, n11: n11 }
}

fn wide_core_hoist(p: BasisProb, shots: i64, seed: i64) -> ShotCounts with Mut, Div, Panic {
    var n00: i64 = 0
    var n01: i64 = 0
    var n10: i64 = 0
    var n11: i64 = 0
    var s = seed
    if s == 0 { s = 1 }
    var k: i64 = 0
    let scale = 4294967296.0
    let p00 = p.p00
    let b01 = p00 + p.p01
    let b10 = b01 + p.p10
    while k < shots {
        s = s * 6364136223846793005 + 1442695040888963407
        let u = (((s >> 32) & 4294967295) as f64) / scale
        if u < p00 {
            n00 = n00 + 1
        } else {
            if u < b01 {
                n01 = n01 + 1
            } else {
                if u < b10 {
                    n10 = n10 + 1
                } else {
                    n11 = n11 + 1
                }
            }
        }
        k = k + 1
    }
    ShotCounts { n00: n00, n01: n01, n10: n10, n11: n11 }
}

fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=BasisProb{p00:0.17,p01:0.23,p10:0.31,p11:0.29}
 let a=wide_core_literal(p,10000000,200001)
 let b=wide_core_hoist(p,10000000,200001)
 assert(a.n00==b.n00 && a.n01==b.n01 && a.n10==b.n10 && a.n11==b.n11)
 print("LITERAL_N00=");println(a.n00)
 print("LITERAL_N01=");println(a.n01)
 print("LITERAL_N10=");println(a.n10)
 print("LITERAL_N11=");println(a.n11)
 print("HOIST_N00=");println(b.n00)
 print("HOIST_N01=");println(b.n01)
 print("HOIST_N10=");println(b.n10)
 print("HOIST_N11=");println(b.n11)
 println("SINGLE_FILE_PROJECTION_ONLY")
 0
}
