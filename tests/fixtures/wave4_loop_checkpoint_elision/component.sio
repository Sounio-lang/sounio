// Component only: actual IrModule/arena API. No source compiler integration.
use ir::ir::*
use ir::loop_checkpoint_elision::{loop_checkpoint_analyze_function,loop_checkpoint_elide_function}
use parser::ast::*

fn emit(f:&!IrFunction,ins:IrInstr) with Mut,Div,Panic {
 var region=f.region
 assert(ir_region_push(&!region,ins)==IR_ARENA_OK)
 f.region=region
 f.instr_count=ir_region_len(&region)
}
fn call(dst:i64,target:i64,name:string,flag:i64,a:i64,b:i64,n:i64)->IrInstr with Mut,Div,Panic,Alloc {
 var args:Option<Box<IrRegList> > = None
 if n==1 {args=Some(Box::new(ir_reg_list_single(a)))}
 if n==2 {args=Some(Box::new(ir_reg_list_append(ir_reg_list_single(a),b)))}
 var ins=ir_call(dst,target,make_name(name),args,n)
 ins.imm_flags=flag
 ins
}
fn enter(f:&!IrFunction,t:i64) with Mut,Div,Panic,Alloc {emit(f,call(t,1,"__rgn_enter",64076,-1,-1,0))}
fn close(f:&!IrFunction,t:i64,z:i64,r:i64) with Mut,Div,Panic,Alloc {
 emit(f,ir_load_imm(z,0))
 emit(f,call(r,2,"__rgn_exit_scalar",64077,t,z,2))
}
fn alloc(dst:i64)->IrInstr with Mut {
 var ins=ir_instr_new(IrOpcode::IrAlloc)
 ins.dst=dst;ins.imm_i64=32
 ins
}
fn make_case(kind:i64)->Box<IrModule> with Mut,Div,Panic,Alloc {
 var module=Box::new(ir_empty_module())
 module.fn_count=6
 var i:i64=0
 while i<6 {
  ir_fn_pool_ensure(&(*module),i)
  var stub=ir_empty_function()
  if i==1 {stub.name=make_name("__rgn_enter")}
  if i==2 {stub.name=make_name("__rgn_exit_scalar")}
  if i==3 {stub.name=make_name("__rgn_leave")}
  if i==4 {stub.name=make_name("@region1:keep_local")}
  if i==5 {stub.name=make_name("ordinary")}
  ir_fn_set(&!(*module),i,stub)
  i=i+1
 }
 var f=ir_empty_function()
 f.name=make_name("component")
 f.reg_count=64;f.label_count=8;f.param_count=1;f.param_regs[0]=0
 assert(ir_function_alloc_region(&!f)==IR_ARENA_OK)
 emit(&!f,ir_load_imm(1,0))
 if kind==19 {emit(&!f,ir_field_get(3,0,0,make_name("p00")))}
 if kind==18 {
  emit(&!f,call(2,1,"__rgn_enter",64066,-1,-1,0))
  emit(&!f,ir_load_imm(5,0))
  emit(&!f,call(6,2,"__rgn_exit_scalar",64067,2,5,2))
 }else {
  if kind==14 {emit(&!f,ir_label(0))}
  enter(&!f,2)
  if kind==12 || kind==13 || kind==14 || kind==15 {
   emit(&!f,ir_branch_true(0,1))
   close(&!f,2,5,6)
   emit(&!f,ir_jump(2))
   emit(&!f,ir_label(1))
   if kind==12 || kind==14 {emit(&!f,alloc(4))}
   else {emit(&!f,ir_binop(4,1,BinaryOp::OpAdd,1))}
   if kind==15 {emit(&!f,ir_return(1))}
   else {
    close(&!f,2,7,8)
    if kind==14 {emit(&!f,ir_jump(0))}
   }
   emit(&!f,ir_label(2))
  }else {
   if kind==9 || kind==10 || kind==11 {
    enter(&!f,9)
    if kind==10 {emit(&!f,alloc(4))}
    else {emit(&!f,ir_binop(4,1,BinaryOp::OpAdd,1))}
    close(&!f,9,10,11)
    if kind==11 {emit(&!f,alloc(12))}
   }else {
    if kind==1 {emit(&!f,alloc(4))}
    else {if kind==2 {emit(&!f,call(4,5,"ordinary",0,-1,-1,0))}
    else {if kind==5 {emit(&!f,ir_branch_true(2,3));emit(&!f,ir_label(3))}
    else {if kind==6 {
     var ins=ir_field_get(4,0,0,make_name("p00"));ins.imm_flags=64064;emit(&!f,ins)
    }else {if kind==7 {emit(&!f,ir_unaryop(4,UnaryOp::OpDeref,0))}
    else {if kind==8 {emit(&!f,ir_copy(2,1))}
    else {if kind==16 {emit(&!f,ir_jump(7))}
    else {if kind==17 {emit(&!f,ir_binop(4,63,BinaryOp::OpAdd,1))}
    else {emit(&!f,ir_binop(4,1,BinaryOp::OpAdd,1))}
    }}}}}}}
   }
   if kind==20 {emit(&!f,call(12,4,"@region1:keep_local",64078,2,1,2))}
   if kind==21 {emit(&!f,call(6,3,"__rgn_leave",64079,2,-1,1))}
   else {close(&!f,2,5,6)}
  }
 }
 if kind==3 {emit(&!f,ir_return(2))}
 else {if kind==4 {emit(&!f,ir_return(6))}
 else {emit(&!f,ir_return(1))}}
 ir_fn_set(&!(*module),0,f)
 module
}
fn exercise(kind:i64,status:i64,eligible:i64,changed:i64) with IO,Mut,Div,Panic,Alloc {
 var module=make_case(kind)
 let original=ir_fn_get(&(*module),0)
 let before=ir_function_clone(&original)
 let probed=loop_checkpoint_analyze_function(&(*module),0)
 let applied=loop_checkpoint_elide_function(&!(*module),0)
 println("LCE_CASE {} {} {} {} {}",kind,applied.status,applied.entries,applied.eligible,applied.neutralized)
 assert(applied.status==status && applied.eligible==eligible && applied.neutralized==changed)
 assert(probed.status==applied.status && probed.eligible==applied.eligible)
 let after=ir_fn_get(&(*module),0)
 assert(after.instr_count==before.instr_count && after.reg_count==before.reg_count && after.label_count==before.label_count && after.param_count==before.param_count)
 var i:i64=0
 while i<64 {
  assert(after.param_regs[i as usize]==before.param_regs[i as usize])
  assert(after.float_reg_bits[i as usize]==before.float_reg_bits[i as usize])
  i=i+1
 }
 i=0
 var actual:i64=0
 while i<before.instr_count {
  let a=ir_arena_load(ir_region_slot_r(before.region,i))
  let b=ir_arena_load(ir_region_slot_r(after.region,i))
  if a.op!=b.op {
   assert(a.op==IrOpcode::IrCall && a.imm_flags>=64076 && a.imm_flags<=64079)
   assert(b.op==IrOpcode::IrLoadImm && b.dst==a.dst && b.imm_i64==0 && b.src1== -1 && b.src2== -1 && b.arg_count==0)
   actual=actual+1
  }else {
   assert(a.dst==b.dst && a.src1==b.src1 && a.src2==b.src2 && a.imm_i64==b.imm_i64 && a.label_id==b.label_id && a.fn_id==b.fn_id && a.field_idx==b.field_idx && a.imm_flags==b.imm_flags && a.bin_op==b.bin_op && a.un_op==b.un_op && a.name_id==b.name_id && a.arg_count==b.arg_count)
   let av:i64=f64_to_bits(a.imm_f64)
   let bv:i64=f64_to_bits(b.imm_f64)
   assert(av==bv)
   var j:i64=0
   while j<a.arg_count {
    assert(ir_arena_arg_at(ir_region_slot_r(before.region,i),j)==ir_arena_arg_at(ir_region_slot_r(after.region,i),j))
    j=j+1
   }
  }
  i=i+1
 }
 assert(actual==changed)
}

fn attack(kind:i64,expected:i64) with IO,Mut,Div,Panic,Alloc {
 var module=make_case(0)
 let old=loop_checkpoint_analyze_function(&(*module),0)
 assert(old.status==0 && old.eligible==1)
 var f=ir_fn_get(&(*module),0)
 let entry=ir_region_slot_r(f.region,1)
 let body=ir_region_slot_r(f.region,2)
 let zero=ir_region_slot_r(f.region,3)
 let exit=ir_region_slot_r(f.region,4)
 let ret=ir_region_slot_r(f.region,5)
 if kind==100 {IR_A_FN_ID[entry as usize]=5}
 if kind==101 {IR_A_NAME_ID[entry as usize]=ir_intern_name(make_name("ordinary"))}
 if kind==102 {
  var target=ir_fn_get(&(*module),1)
  assert(ir_function_alloc_region(&!target)==IR_ARENA_OK)
  target.reg_count=1
  emit(&!target,ir_load_imm(0,0))
  ir_fn_set(&!(*module),1,target)
 }
 if kind==103 {IR_ARG_POOL[IR_A_ARG_BASE[exit as usize] as usize]=4}
 if kind==104 {IR_A_ARG_COUNT[exit as usize]=1}
 if kind==105 {ir_arena_store(body,ir_jump(7))}
 if kind==106 {IR_A_SRC1[body as usize]=63}
 if kind==107 {IR_A_DST[entry as usize]=0}
 if kind==108 {IR_A_SRC1[ret as usize]=6}
 if kind==109 {IR_A_SRC1[ret as usize]=5}
 if kind==110 {
  emit(&!f,ir_copy(12,2))
  emit(&!f,ir_return(1))
  ir_fn_set(&!(*module),0,f)
 }
 if kind==111 {
  var unknown=ir_instr_new(IrOpcode::IrLoadGlobal)
  unknown.dst=4
  ir_arena_store(body,unknown)
 }
 if kind==112 {f.reg_count=513;ir_fn_set(&!(*module),0,f)}
 if kind==113 {assert(ir_region_seal(&f.region)==IR_ARENA_OK)}
 if kind==114 {ir_arena_store(body,alloc(4))}
 if kind==115 {IR_A_FN_ID[entry as usize]=999}
 if kind==116 {IR_A_IMM_I64[zero as usize]=1}
 if kind==117 {IR_A_BIN_OP[body as usize]=BinaryOp::OpConcat as i64}
 if kind==118 {ir_arena_store(body,ir_unaryop(4,UnaryOp::OpRef,0))}
 if kind==119 {
  ir_arena_store(ret,call(8,2,"__rgn_exit_scalar",64077,2,5,2))
  emit(&!f,ir_return(1))
  ir_fn_set(&!(*module),0,f)
 }
 if kind==120 {IR_A_SRC1[entry as usize]=1}
 if kind==121 {IR_A_ARG_BASE[exit as usize]=IR_ARG_POOL_LEN}
 if kind==122 {IR_A_OP[body as usize]=IrOpcode::IrPhi as i64}
 if kind==123 {
  var marker=ir_nop();marker.dst=2;marker.imm_flags=64064
  ir_arena_store(body,marker)
 }
 if kind==124 {
  var index=ir_instr_new(IrOpcode::IrIndexSet)
  index.src1=0;index.src2=1;index.imm_i64=2
  emit(&!f,index)
  emit(&!f,ir_return(1))
  ir_fn_set(&!(*module),0,f)
 }
 if kind==125 {f.instr_count=f.instr_count+20;ir_fn_set(&!(*module),0,f)}
 if kind==126 {ir_arena_store(body,call(4,1,"__rgn_enter",64066,-1,-1,0))}

 if kind==127 {ir_float_bits_set(&!f,2);ir_fn_set(&!(*module),0,f)}
 if kind==128 {ir_float_bits_set(&!f,6);ir_fn_set(&!(*module),0,f)}
 if kind==129 {ir_float_bits_set(&!f,5);ir_fn_set(&!(*module),0,f)}
 if kind==130 {ir_arena_store(zero,ir_load_float(5,0.0))}
 if kind==131 || kind==132 || kind==133 || kind==138 {
  let id=if kind==133 {2}else{1}
  var callee=ir_fn_get(&(*module),id)
  if kind==131 {callee.returns_float=1}
  if kind==132 {callee.param_count=1}
  if kind==133 {callee.first_param_is_ref=1}
  if kind==138 {callee.is_sret=1}
  ir_fn_set(&!(*module),id,callee)
 }
 if kind==134 {IR_A_IMM_FLAGS[body as usize]=1}
 if kind==135 {ir_arena_store(body,ir_load_imm(4,0-4242))}
 if kind==136 {
  ir_arena_store(ret,ir_load_imm(7,0-4242));emit(&!f,ir_return(1));ir_fn_set(&!(*module),0,f)
 }
 if kind==137 {IR_A_IMM_FLAGS[body as usize]=8}
 if kind==139 {IR_A_FIELD_IDX[entry as usize]=0}
 if kind==140 {IR_A_IMM_F64[entry as usize]=1.0}
 if kind==141 {
  var marker=ir_nop();marker.dst=5;marker.imm_flags=64064
  ir_arena_store(body,marker)
 }


 if kind>=142 && kind<=153 || kind==165 {
  var callee=ir_fn_get(&(*module),1)
  if kind==142 {callee.reg_count=1}
  if kind==143 {callee.bss_size=8}
  if kind==144 {callee.prof_counter_id=0}
  if kind==145 {callee.compile_strategy=3}
  if kind==146 {callee.label_count=1}
  if kind==147 {callee.sret_dest_reg=0}
  if kind==148 {callee.hyper_algebra_kind=0}
  if kind==149 {callee.return_struct_name=make_name("Fake")}
  if kind==150 {callee.return_fixed_array_len=4}
  if kind==151 {callee.return_kn_value_float=0}
  if kind==152 {callee.f128_param_mask=1}
  if kind==153 {callee.ref_struct_param_mask=1}
  if kind==165 {callee.param_count=2}
  ir_fn_set(&!(*module),1,callee)
 }
 if kind>=154 && kind<=161 {
  if kind==154 {f.compile_strategy=3}
  if kind==155 {f.is_sret=1}
  if kind==156 {f.first_param_is_ref=1}
  if kind==157 {f.f128_param_mask=1}
  if kind==158 {f.return_kn_value_float=0}
  if kind==159 {f.returns_float=2}
  if kind==160 {f.ref_struct_param_mask=1}
  if kind==161 {f.returns_float=0-2}
  ir_fn_set(&!(*module),0,f)
 }
 if kind==162 {IR_A_BIN_OP[body as usize]=BinaryOp::OpBitAnd as i64;IR_A_IMM_FLAGS[body as usize]=2}
 if kind==163 {IR_A_BIN_OP[body as usize]=BinaryOp::OpRem as i64;IR_A_IMM_FLAGS[body as usize]=6}
 if kind==164 {var ins=ir_load_bool(4,true);ins.imm_i64=2;ir_arena_store(body,ins)}

 let original=ir_fn_get(&(*module),0)
 let before=ir_function_clone(&original)
 let audit=loop_checkpoint_elide_function(&!(*module),0)
 println("LCE_ATTACK {} {} {} {}",kind,audit.status,audit.eligible,audit.neutralized)
 assert(audit.status==expected && audit.eligible==0 && audit.neutralized==0)
 let after=ir_fn_get(&(*module),0)
 assert(before.instr_count==after.instr_count && before.reg_count==after.reg_count)
 // The over-length adversarial metadata is not dereferenced past its region.
 if kind!=125 {
  var i:i64=0
  while i<before.instr_count {
   let a=ir_arena_load(ir_region_slot_r(before.region,i))
   let b=ir_arena_load(ir_region_slot_r(after.region,i))
   assert(a.op==b.op && a.dst==b.dst && a.src1==b.src1 && a.src2==b.src2 &&
    a.imm_i64==b.imm_i64 && a.imm_flags==b.imm_flags && a.label_id==b.label_id &&
    a.fn_id==b.fn_id && a.field_idx==b.field_idx && a.bin_op==b.bin_op &&
    a.un_op==b.un_op && a.name_id==b.name_id && a.arg_count==b.arg_count)
   var k:i64=0
   while k<a.arg_count && kind!=121 {
    assert(ir_arena_arg_at(ir_region_slot_r(before.region,i),k)==ir_arena_arg_at(ir_region_slot_r(after.region,i),k))
    k=k+1
   }
   i=i+1
  }
 }
}


fn alias_and_arguments() with IO,Mut,Div,Panic,Alloc {
 var module=make_case(0)
 var f=ir_fn_get(&(*module),0)
 let old_region=f.region
 // An ordinary call outside the checkpoint has three arguments and remains
 // untouched even though the target region is cloned before publication.
 var args=ir_reg_list_append(ir_reg_list_single(0),1)
 args=ir_reg_list_append(args,4)
 let old_ret=ir_region_slot_w(f.region,5)
 ir_arena_store(old_ret,ir_call(20,5,make_name("ordinary"),Some(Box::new(args)),3))
 emit(&!f,ir_return(1))
 ir_fn_set(&!(*module),0,f)
 var alias=f
 alias.name=make_name("ordinary")
 ir_fn_set(&!(*module),5,alias)
 let old_entry=ir_region_slot_r(old_region,1)
 let old_exit=ir_region_slot_r(old_region,4)
 let old_after=ir_region_slot_r(old_region,5)
 let arg_base=IR_A_ARG_BASE[old_after as usize]
 let arg_len=IR_ARG_POOL_LEN
 let audit=loop_checkpoint_elide_function(&!(*module),0)
 assert(audit.status==0 && audit.eligible==1 && audit.neutralized==2)
 let selected=ir_fn_get(&(*module),0)
 let other=ir_fn_get(&(*module),5)
 assert(selected.region.slot!=old_region.slot)
 assert(other.region.slot==old_region.slot && other.region.generation==old_region.generation)
 assert((IR_A_OP[old_entry as usize] as IrOpcode)==IrOpcode::IrCall)
 assert((IR_A_OP[old_exit as usize] as IrOpcode)==IrOpcode::IrCall)
 let new_after=ir_region_slot_r(selected.region,5)
 assert(IR_A_ARG_BASE[new_after as usize]==arg_base && IR_ARG_POOL_LEN==arg_len)
 assert(IR_A_ARG_COUNT[new_after as usize]==3)
 assert(ir_arena_arg_at(new_after,0)==0 && ir_arena_arg_at(new_after,1)==1 && ir_arena_arg_at(new_after,2)==4)
 assert(IR_A_ARG_BASE[old_after as usize]==arg_base && IR_A_ARG_COUNT[old_after as usize]==3)
 println("LCE_ALIAS_ARGUMENTS_OK")
}


fn control_flags() with IO,Mut,Div,Panic,Alloc {
 var kind:i64=0
 while kind<4 {
  var module=make_case(13)
  let f=ir_fn_get(&(*module),0)
  let at=if kind==0 || kind==3 {2}else{if kind==1 {5}else{6}}
  let slot=ir_region_slot_w(f.region,at)
  if kind==3 {IR_A_OP[slot as usize]=IrOpcode::IrBranchFalse as i64}
  IR_A_IMM_FLAGS[slot as usize]=1
  let audit=loop_checkpoint_elide_function(&!(*module),0)
  assert(audit.status==14 && audit.eligible==0 && audit.neutralized==0)
  assert(IR_A_IMM_FLAGS[slot as usize]==1)
  println("LCE_CONTROL_FLAGS {} {}",kind,audit.status)
  kind=kind+1
 }
}
fn float_arithmetic_flags() with IO,Mut,Div,Panic,Alloc {
 var flag:i64=2
 while flag<=6 {
  var module=make_case(0)
  let f=ir_fn_get(&(*module),0)
  let slot=ir_region_slot_w(f.region,2)
  IR_A_IMM_FLAGS[slot as usize]=flag
  let audit=loop_checkpoint_elide_function(&!(*module),0)
  assert(audit.status==0 && audit.eligible==1 && audit.neutralized==2)
  let after=ir_fn_get(&(*module),0)
  let copied=ir_region_slot_r(after.region,2)
  assert(IR_A_IMM_FLAGS[copied as usize]==flag)
  println("LCE_FLOAT_FLAGS {} {}",flag,audit.neutralized)
  flag=flag+2
 }
}


fn module_wrapper() with IO,Mut,Div,Panic,Alloc {
 var module=make_case(0)
 let count=module.fn_count
 let audit=loop_checkpoint_elide_module(&!(*module))
 assert(audit.status==0 && audit.functions==count && audit.eligible==1 && audit.neutralized==2)
 let again=loop_checkpoint_elide_module(&!(*module))
 assert(again.status==0 && again.functions==count && again.eligible==0 && again.neutralized==0)
 module.fn_count=IR_MAX_FUNCS+1
 let invalid=loop_checkpoint_elide_module(&!(*module))
 assert(invalid.status==1 && invalid.functions==0 && invalid.neutralized==0)
 println("LCE_MODULE_WRAPPER_OK")
}

