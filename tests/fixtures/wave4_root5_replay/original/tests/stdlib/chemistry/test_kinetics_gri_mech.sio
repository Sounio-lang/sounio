//@ run-pass
// tests/stdlib/chemistry/test_kinetics_gri_mech.sio
//
// GRI-Mech 3.0 real modified-Arrhenius rates k(T) = A T^n exp(-Ea/(R T)) for the
// H2/O2 sub-mechanism (grimech30.dat parameters), plus a 1500K/1atm RK4 integration
// cross-checked against an independent Python replication. lean_single engine.
use chemistry::kinetics::*
fn main() -> i32 with IO, Mut, Div, Panic {
    if !test_gri_rates() { print("FAIL gri_rates\n"); return 1 }
    if !test_big_crn_gri() { print("FAIL big_crn_gri\n"); return 2 }
    print("GRI MECH PASS\n")
    0
}
