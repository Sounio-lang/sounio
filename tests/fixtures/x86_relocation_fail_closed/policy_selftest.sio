//@ run-pass

use native::codegen_x86_linux::{native_v2_relocation_fail_closed_selftest}
use native::reloc::{add_call_reloc, add_data_reloc, add_data_section_reloc, add_rip_reloc, relocation_table_capacity, reloc_table_new}

fn public_relocation_table_fail_closed() -> bool with Mut, Panic {
    var table = reloc_table_new()
    table.count = 255
    table = add_call_reloc(table, 1, 0)
    if table.count != 256 { return false }
    table = add_data_reloc(table, 5, 0)
    if table.count != 257 { return false }

    table.count = relocation_table_capacity() - 1
    table = add_rip_reloc(table, 9, 0)
    if table.count != relocation_table_capacity() { return false }
    table = add_data_section_reloc(table, 13, 0)
    table.count == relocation_table_capacity() + 1
}

fn main() -> i64 with IO, Mut, Panic, Div {
    if !public_relocation_table_fail_closed() || !native_v2_relocation_fail_closed_selftest() {
        print("X86_RELOCATION_FAIL_CLOSED_SELFTEST_FAIL\n")
        return 1
    }
    print("X86_RELOCATION_FAIL_CLOSED_SELFTEST_PASS legacy_public=4096 legacy_x86=4096 flat=65536 rela=341 shared=pending_relocs_refused\n")
    0
}
