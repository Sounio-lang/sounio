pub fn read_i64(bytes: &[u8; 1], off: i64, order: i64) -> i64 {
    700 + off + order
}
pub fn write_i64(bytes: &[u8; 1], off: i64, value: i64, order: i64) -> i64 {
    800 + off + value + order
}
pub fn read_f64(bytes: &[u8; 1], off: i64, order: i64) -> f64 { 3.25 }
pub fn write_f64(bytes: &[u8; 1], off: i64, value: f64, order: i64) -> i64 { 900 }
