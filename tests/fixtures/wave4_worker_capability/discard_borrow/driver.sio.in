use compiler::module_parse::{load_module_file}
use parser::parser::{parser_last_error_count}
use check::mod::{check_items_verdict_boot4}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
    let program=load_module_file(get_arg(0))
    if parser_last_error_count()>0 {println("PARSE_REFUSED");return 2}
    let verdict=check_items_verdict_boot4(program.items)
    print("DISCARD_CHECKER_VERDICT ");print_int(verdict);print("\n")
    verdict as i32
}
