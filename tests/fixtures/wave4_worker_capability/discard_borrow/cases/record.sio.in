struct EnvVar {
    key: [u8; 64],
    key_len: i32,
    value: [u8; 256],
    val_len: i32
}
pub fn envvar_new(key: &[u8; 64], key_len: i32) -> EnvVar with Mut, Panic, Div {
    var ev = EnvVar {
        key: [0; 64],
        key_len: key_len,
        value: [0; 256],
        val_len: 0
    }
    var i: i32 = 0
    while i < key_len && i < 64 {
        ev.key[i] = key[i]
        i = i + 1
    }
    ev
}
fn main()->i32 {0}
