use check::types::{TypeKind,ty_i64,ty_f64,ty_unknown,ty_error,ty_worker_fn_i64,ty_worker_fn_f64,type_is_worker_capability,f128_f256_internal_identity_probe_code}
use check::compat::{types_compatible}
fn main() with IO,Mut,Alloc,Panic,Div {
 assert(f128_f256_internal_identity_probe_code()==0)
 let i=ty_worker_fn_i64()
 let f=ty_worker_fn_f64()
 assert((TypeKind::TyDsepProof as i64)==99)
 assert((i.kind as i64)==100)
 assert((f.kind as i64)==101)
 assert(type_is_worker_capability(i))
 assert(type_is_worker_capability(f))
 assert(!type_is_worker_capability(ty_i64()))
 assert(types_compatible(i,i))
 assert(types_compatible(f,f))
 assert(!types_compatible(i,f))
 assert(!types_compatible(f,i))
 assert(!types_compatible(i,ty_i64()))
 assert(!types_compatible(ty_i64(),i))
 assert(!types_compatible(f,ty_f64()))
 assert(!types_compatible(ty_f64(),f))
 assert(!types_compatible(i,ty_unknown()))
 assert(!types_compatible(ty_unknown(),i))
 assert(!types_compatible(i,ty_error()))
 assert(!types_compatible(ty_error(),i))
 println("WORKER_OPAQUE_TYPE_COMPONENT_OK")
}
