use parser::ast::{Name}
use compiler::module_parse::{load_module_file}
use parser::parser::{parser_last_error_count}
use check::specializer::{specialize_generics,spec_report_unsound_poison}
use check::mod::{check_items_verdict_boot4}
use ir::lower::{lower_program_to_ir,lower_hard_error_report}
use native::worker_proof::{worker_compilation_begin,worker_lower_backend_opt_in,worker_source_checked_context,worker_module_has_intrinsics,worker_validate_capability_flow,worker_capability_error,worker_backend_begin,worker_validate_callback_closures,worker_prepare_clones,worker_closure_error,worker_closure_error_function,worker_closure_error_instruction}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
 worker_compilation_begin();worker_lower_backend_opt_in()
 var program=load_module_file(get_arg(0))
 let mode=get_arg(1)
 if parser_last_error_count()>0 {println("PARSE_REFUSED");return 1}
 program.items=specialize_generics(program.items)
 if spec_report_unsound_poison() {return 1}
 let verdict=check_items_verdict_boot4(program.items)
 let checked=worker_source_checked_context()
 if str_eq(mode,"forward") || str_eq(mode,"closure") {if verdict!=0 || !checked {return 1}}
 else {if verdict!=1 || checked {return 1}}
 let lowered=lower_program_to_ir(program)
 if str_eq(mode,"bad_graph") {
  if !lowered.had_error && lowered.error_count==0 {return 1}
  println("WORKER_FAILED_CHECKER_GRAPH_CANNOT_ISSUE_TOKEN_OK")
  return 0
 }
 if lowered.had_error || lowered.error_count>0 {lower_hard_error_report();return 1}
 if !worker_module_has_intrinsics(&lowered.module) {println("OPAQUE_CONTRACT_ESCAPED_NATIVE_BOUNDARY");return 1}
 if str_eq(mode,"closure") {
  var module=Box::new(lowered.module)
  worker_backend_begin(&(*module))
  if !worker_validate_capability_flow(&(*module)) || !worker_validate_callback_closures(&(*module)) || !worker_prepare_clones(&!(*module)) {
   print("ACTUAL_IR_PROOF_REFUSED cap=");print_int(worker_capability_error());print(" closure=");print_int(worker_closure_error());print(" fn=");print_int(worker_closure_error_function());print(" at=");print_int(worker_closure_error_instruction());print("\n")
   return 1
  }
  println("WORKER_ACTUAL_CHECKER_LOWER_IR_CLONES_OK")
  return 0
 }
 let safe=worker_validate_capability_flow(&lowered.module)
 if str_eq(mode,"forward") {
  if !safe {return 1}
  println("WORKER_NO_CONSTRUCTOR_FORWARD_CONTRACT_OK")
 } else {
  if safe || worker_capability_error()!=214 {print("FLOW_ERROR ");print_int(worker_capability_error());print("\n");return 1}
  println("WORKER_RAW_FUNCTION_WITHOUT_CONSTRUCTOR_REFUSED_OK")
 }
 0
}
