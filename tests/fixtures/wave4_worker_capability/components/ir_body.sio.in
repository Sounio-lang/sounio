
// Component-only private metadata injection. Appended only to the immutable
// qualification snapshot, never exported by production worker_proof.sio.
use ir::ir::{IrFunction,ir_function_alloc_region,ir_region_push,ir_region_set,ir_load_imm,ir_load_fn_ref,ir_reg_list_single,ir_reg_list_cons,ir_return,ir_binop,ir_unaryop,ir_store_ptr,ir_empty_module,ir_phi}
use parser::ast::{BinaryOp}
fn worker_probe_signature(source:i64,params:i64,refs:i64,abi:i64)->Box<WorkerSourceSignature> with Mut,Panic,Div,Alloc {
    Box::new(WorkerSourceSignature {id:source,owner:0,name:empty_name(),start:0,end:1,param_count:params,refs:refs,cap_i64:0,cap_f64:0,cap_return:0,float_params:0,float_return:false,root_abi:abi,return_class:1,callback_abi:true,next:None})
}
fn worker_probe_binding(key:i64,fi:i64,source:i64,params:i64,refs:i64,abi:i64,trusted:bool) with Mut,Panic,Div,Alloc {
    WORKER_LOWER_BINDINGS=Some(Box::new(WorkerLowerBinding {module_key:key,fn_id:fi,source_epoch:77,signature:worker_probe_signature(source,params,refs,abi),fresh:true,trusted_worker:trusted,next:WORKER_LOWER_BINDINGS}))
}
fn worker_probe_emit(function:&!IrFunction,instruction:IrInstr) with Mut,Panic,Div {
    if ir_region_push(&!(*function).region,instruction)==0 {(*function).instr_count=(*function).instr_count+1}
}
fn worker_probe_mutate(module:&!IrModule,fi:i64,at:i64,instruction:IrInstr)->bool with Mut,Panic,Div,Alloc {
    let function=ir_fn_get(&(*module),fi)
    ir_region_set(&function.region,at,instruction)==0
}
fn worker_probe_contract_without_intrinsics(original:&IrModule)->i64 with Mut,Panic,Div,Alloc {
    var module=Box::new(ir_empty_module())
    let key=(*module).functions as i64
    ir_module_fn_set(&!(*module),0,ir_fn_get(original,0))
    var accept=Box::new(ir_empty_function())
    (*accept).name=make_name("accept_opaque");(*accept).param_count=1;(*accept).param_regs[0]=0;(*accept).reg_count=2
    if ir_function_alloc_region(&!(*accept))!=0 {return 0}
    worker_probe_emit(&!(*accept),ir_load_imm(1,0))
    worker_probe_emit(&!(*accept),ir_return(1))
    ir_module_fn_set(&!(*module),1,*accept)
    var caller=Box::new(ir_empty_function())
    (*caller).name=make_name("main");(*caller).reg_count=2
    if ir_function_alloc_region(&!(*caller))!=0 {return 0}
    worker_probe_emit(&!(*caller),ir_load_fn_ref(0,0))
    worker_probe_emit(&!(*caller),ir_call(1,1,make_name("accept_opaque"),Some(Box::new(ir_reg_list_single(0))),1))
    worker_probe_emit(&!(*caller),ir_return(1))
    ir_module_fn_set(&!(*module),2,*caller)
    (*module).fn_count=3
    worker_probe_binding(key,0,50,1,0,1,false)
    worker_probe_binding(key,1,51,1,0,0,false)
    worker_probe_binding(key,2,52,0,0,0,false)
    match worker_lower_binding_direct(key,1) {Some(binding)=>{
        (*(*binding).signature).cap_i64=1
        (*(*binding).signature).callback_abi=false
    },None=>return 0}
    if !worker_module_has_intrinsics(&(*module)) {return 0}
    if worker_validate_capability_flow(&(*module)) || worker_capability_error()!=214 {return 0}
    match worker_lower_binding_direct(key,1) {Some(binding)=>{(*binding).fresh=false},None=>return 0}
    if !worker_module_has_intrinsics(&(*module)) || worker_validate_capability_flow(&(*module)) || worker_capability_error()!=222 {return 0}
    match worker_lower_binding_direct(key,1) {Some(binding)=>{(*binding).fresh=true;(*(*binding).signature).cap_i64=0-1},None=>return 0}
    if !worker_module_has_intrinsics(&(*module)) || worker_validate_capability_flow(&(*module)) || worker_capability_error()!=225 {return 0}
    3
}
pub fn worker_ir_component()->i32 with Mut,Panic,Div,Alloc,IO {
    worker_compilation_begin()
    worker_lower_backend_opt_in()
    var module=Box::new(ir_empty_module())
    let key=(*module).functions as i64
    var callback=Box::new(ir_empty_function())
    (*callback).name=make_name("callback")
    (*callback).param_count=1;(*callback).param_regs[0]=0;(*callback).reg_count=3
    if ir_function_alloc_region(&!(*callback))!=0 {return 1}
    worker_probe_emit(&!(*callback),ir_load_imm(1,2))
    worker_probe_emit(&!(*callback),ir_binop(2,0,BinaryOp::OpMul,1))
    worker_probe_emit(&!(*callback),ir_return(2))
    ir_module_fn_set(&!(*module),0,*callback)
    (*module).fn_count=1
    var main=Box::new(ir_empty_function())
    (*main).name=make_name("main");(*main).reg_count=5
    if ir_function_alloc_region(&!(*main))!=0 {return 1}
    worker_probe_emit(&!(*main),ir_load_fn_ref(0,0))
    ir_module_fn_set(&!(*module),1,*main)
    (*module).fn_count=2
    let ctor=worker_register_intrinsic(&!(*module),1)
    let raw=worker_register_intrinsic(&!(*module),17)
    let raw_f64=worker_register_intrinsic(&!(*module),18)
    if ctor<0 || raw<0 || raw_f64<0 {return 1}
    var call=ir_call(1,ctor,worker_protected_name(1),Some(Box::new(ir_reg_list_single(0))),1)
    call.imm_i64=123;call.imm_flags=64501
    worker_probe_emit(&!(*main),call)
    worker_probe_emit(&!(*main),ir_load_imm(2,0))
    worker_probe_emit(&!(*main),ir_return(2))
    ir_module_fn_set(&!(*module),1,*main)
    worker_probe_binding(key,0,10,1,0,1,false)
    worker_probe_binding(key,1,20,0,0,0,false)
    WORKER_LOWER_INTENTS=Some(Box::new(WorkerLowerIntent {token:123,source_epoch:77,caller:20,start:2,end:3,target:10,abi:1,next:None}))
    worker_backend_begin(&(*module))
    worker_backend_note_builtin(key,ctor,2001)
    worker_backend_note_builtin(key,raw,2017)
    worker_backend_note_builtin(key,raw_f64,2018)
    if !worker_validate_constructor_identities(&(*module)) {print("identity ");print_int(worker_identity_error());return 1}
    if !worker_validate_capability_flow(&(*module)) {print("capflow ");print_int(worker_capability_error());return 1}
    if !worker_validate_callback_closures(&(*module)) {print("closure ");print_int(worker_closure_error());return 1}
    var refused:i64=0
    // The checked source binding stays fixed while final IR is corrupted.
    var allocation=ir_nop();allocation.op=IrOpcode::IrAlloc;allocation.dst=2
    if !worker_probe_mutate(&!(*module),0,1,allocation) {return 1}
    if !worker_validate_callback_closures(&(*module)) && worker_closure_error()==109 {refused=refused+1}
    if !worker_probe_mutate(&!(*module),0,1,ir_binop(2,0,BinaryOp::OpMul,1)) {return 1}
    var forged=call;forged.imm_i64=0
    if !worker_probe_mutate(&!(*module),1,1,forged) {return 1}
    if !worker_validate_constructor_identities(&(*module)) && worker_identity_error()==15 {refused=refused+1}
    if !worker_probe_mutate(&!(*module),1,1,call) {return 1}
    if !worker_probe_mutate(&!(*module),1,0,ir_load_imm(0,0)) {return 1}
    if !worker_validate_constructor_identities(&(*module)) && worker_identity_error()==9 {refused=refused+1}
    if !worker_probe_mutate(&!(*module),1,0,ir_load_fn_ref(0,0)) {return 1}
    var extract=ir_call(2,raw,worker_protected_name(17),Some(Box::new(ir_reg_list_single(1))),1)
    extract.imm_flags=64502
    if !worker_probe_mutate(&!(*module),1,2,extract) {return 1}
    if !worker_validate_capability_flow(&(*module)) && worker_capability_error()==212 {refused=refused+1}
    match worker_lower_binding_direct(key,1) {Some(binding)=>{(*binding).trusted_worker=true},None=>return 1}
    if !worker_validate_capability_flow(&(*module)) {print("trustedflow ");print_int(worker_capability_error());return 1}
    var mismatch=ir_call(2,raw_f64,worker_protected_name(18),Some(Box::new(ir_reg_list_single(1))),1)
    mismatch.imm_flags=64502
    if !worker_probe_mutate(&!(*module),1,2,mismatch) {return 1}
    if !worker_validate_capability_flow(&(*module)) && worker_capability_error()==215 {refused=refused+1}
    if !worker_probe_mutate(&!(*module),1,2,ir_load_imm(2,0)) {return 1}
    match worker_lower_binding_direct(key,0) {Some(binding)=>{(*binding).fresh=false},None=>return 1}
    if !worker_validate_constructor_identities(&(*module)) && worker_identity_error()==10 {refused=refused+1}
    match worker_lower_binding_direct(key,0) {Some(binding)=>{(*binding).fresh=true},None=>return 1}
    (*callback).returns_float=1
    ir_module_fn_set(&!(*module),0,*callback)
    if !worker_validate_callback_closures(&(*module)) && worker_closure_error()==129 {refused=refused+1}
    (*callback).returns_float=0
    ir_module_fn_set(&!(*module),0,*callback)
    if !worker_validate_callback_closures(&(*module)) || !worker_validate_capability_flow(&(*module)) {return 1}
    if refused!=7 {print("refusal count ");print_int(refused);return 1}
    if !worker_probe_mutate(&!(*module),1,2,ir_phi(0)) {return 1}
    if !worker_validate_constructor_identities(&(*module)) && worker_identity_error()==9 {refused=refused+1}
    if !worker_probe_mutate(&!(*module),1,2,ir_phi(1)) {return 1}
    if !worker_validate_capability_flow(&(*module)) && worker_capability_error()==224 {refused=refused+1}
    if !worker_probe_mutate(&!(*module),1,2,ir_copy(1,4)) {return 1}
    if !worker_validate_capability_flow(&(*module)) && worker_capability_error()==208 {refused=refused+1}
    if !worker_probe_mutate(&!(*module),1,2,ir_load_imm(2,0)) {return 1}
    if refused!=10 {print("flow mutation count ");print_int(refused);return 1}
    refused=refused+worker_probe_contract_without_intrinsics(&(*module))
    if refused!=13 {println("NO_INTRINSIC_CONTRACT_UNPROVED");return 1}
    if worker_probe_cfg_contract(&!(*module),call,extract)!=9 {return 1}
    if worker_probe_external_slots(&!(*module))!=2 {return 1}
    let original_count=(*module).fn_count
    if !worker_prepare_clones(&!(*module)) {print("clone proof ");print_int(worker_closure_error());print(" cap ");print_int(worker_capability_error());return 1}
    if worker_certified_entry_count()!=1 || worker_certified_entry_abi(0)!=1 {return 1}
    let clone_id=worker_certified_entry_id(0)
    if clone_id<original_count {return 1}
    let unchanged=ir_fn_get(&(*module),0)
    if !worker_function_matches(&unchanged,&(*callback)) {println("ORIGINAL_CHANGED");return 1}
    var emitted=ir_fn_get(&(*module),clone_id)
    if emitted.region.slot==unchanged.region.slot || worker_certificate_status(key,clone_id,&emitted)!=1 {return 1}
    emitted.reg_count=emitted.reg_count+1
    if worker_certificate_status(key,clone_id,&emitted)!=(0-1) {return 1}
    refused=refused+1
    emitted.reg_count=emitted.reg_count-1
    if worker_certificate_status(key,clone_id,&emitted)!=1 {return 1}
    if !worker_probe_mutate(&!(*module),clone_id,1,allocation) {return 1}
    if worker_certificate_status(key,clone_id,&emitted)!=(0-1) || worker_validate_callback_closures(&(*module)) {return 1}
    refused=refused+1
    if !worker_probe_mutate(&!(*module),clone_id,1,ir_binop(2,0,BinaryOp::OpMul,1)) {return 1}
    if worker_certificate_status(key,clone_id,&emitted)!=1 {return 1}
    if refused!=15 {return 1}
    println("WORKER_IR_CLONES_COMPONENT_OK source_metadata=injected closures=1 original_unchanged=true mutations_refused=15 emitter_enabled=false")
    0
}
use ir::ir::{ir_label,ir_jump,ir_branch_true}
fn worker_probe_cfg_main(module:&!IrModule,call:IrInstr,extract:IrInstr,mode:i64) with Mut,Panic,Div,Alloc {
    var main=Box::new(ir_empty_function())
    (*main).name=make_name("main");(*main).reg_count=6
    if ir_function_alloc_region(&!(*main))!=0 {return}
    worker_probe_emit(&!(*main),ir_load_imm(3,0))
    if mode==1 || mode==2 {
        worker_probe_emit(&!(*main),ir_branch_true(3,0))
        worker_probe_emit(&!(*main),ir_load_fn_ref(0,0))
        worker_probe_emit(&!(*main),ir_label(0))
        if mode==2 {worker_probe_emit(&!(*main),ir_copy(4,0))}
        var ctor=call
        if mode==2 {ctor.call_args=Some(Box::new(ir_reg_list_single(4)))}
        worker_probe_emit(&!(*main),ctor)
    } else {
        worker_probe_emit(&!(*main),ir_load_fn_ref(0,0))
        if mode==3 {
            worker_probe_emit(&!(*main),ir_branch_true(3,0))
            worker_probe_emit(&!(*main),call)
            worker_probe_emit(&!(*main),ir_label(0))
            worker_probe_emit(&!(*main),extract)
        } else if mode==4 || mode==5 {
            worker_probe_emit(&!(*main),call)
            worker_probe_emit(&!(*main),ir_branch_true(3,0))
            worker_probe_emit(&!(*main),ir_copy(4,1))
            worker_probe_emit(&!(*main),ir_jump(1))
            worker_probe_emit(&!(*main),ir_label(0))
            if mode==4 {worker_probe_emit(&!(*main),ir_load_imm(4,0))}
            else {worker_probe_emit(&!(*main),ir_copy(4,1))}
            worker_probe_emit(&!(*main),ir_label(1))
            var raw=extract;raw.call_args=Some(Box::new(ir_reg_list_single(4)))
            worker_probe_emit(&!(*main),raw)
        } else if mode==6 {
            worker_probe_emit(&!(*main),ir_branch_true(3,0))
            worker_probe_emit(&!(*main),ir_copy(4,0))
            worker_probe_emit(&!(*main),ir_jump(1))
            worker_probe_emit(&!(*main),ir_label(0))
            worker_probe_emit(&!(*main),ir_copy(4,0))
            worker_probe_emit(&!(*main),ir_label(1))
            var ctor=call;ctor.call_args=Some(Box::new(ir_reg_list_single(4)))
            worker_probe_emit(&!(*main),ctor)
        } else {
            worker_probe_emit(&!(*main),call)
        }
    }
    worker_probe_emit(&!(*main),ir_load_imm(2,0))
    worker_probe_emit(&!(*main),ir_return(2))
    ir_module_fn_set(module,1,*main)
}
fn worker_probe_cfg_contract(module:&!IrModule,call:IrInstr,extract:IrInstr)->i64 with Mut,Panic,Div,Alloc,IO {
    let saved_main=ir_fn_get(&(*module),1)
    let saved_callback=ir_fn_get(&(*module),0)
    var refused:i64=0
    worker_probe_cfg_main(module,call,extract,1)
    if !worker_validate_constructor_identities(&(*module)) && worker_identity_error()==21 {refused=refused+1}
    worker_probe_cfg_main(module,call,extract,2)
    if !worker_validate_constructor_identities(&(*module)) && worker_identity_error()==20 {refused=refused+1}
    worker_probe_cfg_main(module,call,extract,3)
    if !worker_validate_capability_flow(&(*module)) && worker_capability_error()==228 {refused=refused+1}
    worker_probe_cfg_main(module,call,extract,4)
    if !worker_validate_capability_flow(&(*module)) && worker_capability_error()==208 {refused=refused+1}
    worker_probe_cfg_main(module,call,extract,5)
    if !worker_validate_capability_flow(&(*module)) {println("CFG_BOTH_CAP_BRANCHES_REFUSED");return 0}
    worker_probe_cfg_main(module,call,extract,6)
    if !worker_validate_capability_flow(&(*module)) {println("CFG_BOTH_FNREF_BRANCHES_REFUSED");return 0}
    ir_module_fn_set(module,1,saved_main)
    var callback=Box::new(ir_empty_function())
    (*callback).name=make_name("callback");(*callback).param_count=1;(*callback).param_regs[0]=0;(*callback).reg_count=4
    if ir_function_alloc_region(&!(*callback))!=0 {return 0}
    worker_probe_emit(&!(*callback),ir_branch_true(0,0))
    worker_probe_emit(&!(*callback),ir_unaryop(1,UnaryOp::OpRefMut,0))
    worker_probe_emit(&!(*callback),ir_label(0))
    worker_probe_emit(&!(*callback),ir_unaryop(2,UnaryOp::OpDeref,1))
    worker_probe_emit(&!(*callback),ir_return(2))
    ir_module_fn_set(module,0,*callback)
    if !worker_validate_callback_closures(&(*module)) && worker_closure_error()==138 {refused=refused+1}
    if !worker_probe_mutate(module,0,3,ir_store_ptr(1,0)) {return 0}
    if !worker_validate_callback_closures(&(*module)) && worker_closure_error()==138 {refused=refused+1}
    // A reference established before a back-edge remains valid on every loop_fn
    // iteration. The bool result may have multiple ordinary Copy definitions.
    var loop_fn=Box::new(ir_empty_function())
    (*loop_fn).name=make_name("callback");(*loop_fn).param_count=1;(*loop_fn).param_regs[0]=0;(*loop_fn).reg_count=4
    if ir_function_alloc_region(&!(*loop_fn))!=0 {return 0}
    worker_probe_emit(&!(*loop_fn),ir_unaryop(1,UnaryOp::OpRefMut,0))
    worker_probe_emit(&!(*loop_fn),ir_label(0))
    worker_probe_emit(&!(*loop_fn),ir_copy(3,0))
    worker_probe_emit(&!(*loop_fn),ir_branch_true(0,1))
    worker_probe_emit(&!(*loop_fn),ir_copy(3,0))
    worker_probe_emit(&!(*loop_fn),ir_label(1))
    worker_probe_emit(&!(*loop_fn),ir_unaryop(2,UnaryOp::OpDeref,1))
    worker_probe_emit(&!(*loop_fn),ir_branch_true(3,0))
    worker_probe_emit(&!(*loop_fn),ir_return(2))
    ir_module_fn_set(module,0,*loop_fn)
    if !worker_validate_callback_closures(&(*module)) {println("CFG_VALID_LOOP_REFUSED");return 0}
    if !worker_probe_mutate(module,0,0,ir_branch_true(0,999)) {return 0}
    if !worker_validate_callback_closures(&(*module)) && worker_closure_error()==139 {refused=refused+1}
    if !worker_probe_mutate(module,0,0,ir_label(0)) {return 0}
    if !worker_validate_callback_closures(&(*module)) && worker_closure_error()==139 {refused=refused+1}
    if !worker_probe_mutate(module,0,0,ir_unaryop(1,UnaryOp::OpRefMut,0)) {return 0}
    if !worker_probe_mutate(module,0,8,ir_load_imm(2,0)) {return 0}
    if !worker_validate_callback_closures(&(*module)) && worker_closure_error()==139 {refused=refused+1}
    ir_module_fn_set(module,0,saved_callback)
    if refused!=9 {print("CFG_REFUSAL_COUNT ");print_int(refused);return 0}
    println("WORKER_CFG_OK corruptions_refused=9 positive_merges_and_loop=3")
    9
}

fn worker_probe_external_slots(module:&!IrModule)->i64 with Mut,Panic,Div,Alloc,IO {
    let key=(*module).functions as i64
    let fi=(*module).fn_count
    var external=ir_empty_function();external.name=make_name("dlopen");external.param_count=2;external.reg_count=0
    ir_module_fn_set(module,fi,external);(*module).fn_count=fi+1
    if !worker_validate_capability_flow(&(*module)) {print("EXTERN_NAMESPACE_FLOW_REFUSED ");print_int(worker_capability_error());print("\n");return 0}
    worker_probe_binding(key,fi,900,2,0,0,false)
    match worker_lower_binding_direct(key,fi) {Some(binding)=>{(*(*binding).signature).cap_i64=1;(*(*binding).signature).callback_abi=false},None=>return 0}
    if worker_validate_capability_flow(&(*module)) || worker_capability_error()!=229 {println("EMPTY_OPAQUE_CONTRACT_ACCEPTED_OR_WRONG_REFUSAL");return 0}
    match worker_lower_binding_direct(key,fi) {Some(binding)=>{(*(*binding).signature).cap_i64=0},None=>return 0}
    if !worker_validate_capability_flow(&(*module)) {return 0}
    println("WORKER_EXTERN_NAMESPACE_OK ordinary_empty=1 opaque_empty_refused=1")
    2
}
