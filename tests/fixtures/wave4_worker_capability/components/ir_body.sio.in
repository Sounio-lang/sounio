}

fn worker_probe_external_slots(module:&!IrModule)->i64 with Mut,Panic,Div,Alloc,IO {
    let key=(*module).functions as i64
    let fi=(*module).fn_count
    var external=ir_empty_function();external.name=make_name("dlopen");external.param_count=2;external.reg_count=0
    ir_module_fn_set(module,fi,external);(*module).fn_count=fi+1
    if !worker_validate_capability_flow(&(*module)) {print("EXTERN_NAMESPACE_FLOW_REFUSED ");print_int(worker_capability_error());print("\n");return 0}
    worker_probe_binding(key,fi,900,2,0,0,false)
    match worker_lower_binding_direct(key,fi) {Some(binding)=>{(*(*binding).signature).cap_i64=1;(*(*binding).signature).callback_abi=false},None=>return 0}
    if worker_validate_capability_flow(&(*module)) || worker_capability_error()!=229 {println("EMPTY_OPAQUE_CONTRACT_ACCEPTED_OR_WRONG_REFUSAL");return 0}
    match worker_lower_binding_direct(key,fi) {Some(binding)=>{(*(*binding).signature).cap_i64=0},None=>return 0}
    if !worker_validate_capability_flow(&(*module)) {return 0}
    println("WORKER_EXTERN_NAMESPACE_OK ordinary_empty=1 opaque_empty_refused=1")
    2
}
fn worker_probe_retirement()->bool with Mut,Panic,Div,Alloc,IO {
    worker_compilation_begin()
    worker_lower_backend_opt_in()
    let first=worker_probe_signature(700,1,0,1)
    let second=worker_probe_signature(701,1,0,1)
    let mark=__arena_mark()
    WORKER_LOWER_BINDINGS=Some(worker_lower_store_binding(WorkerLowerBinding {module_key:100,fn_id:0,source_epoch:77,signature:first,fresh:true,trusted_worker:false,next:None}))
    WORKER_LOWER_INTENTS=Some(worker_lower_store_intent(WorkerLowerIntent {token:700,source_epoch:77,caller:700,start:3,end:4,target:700,abi:1,next:None}))
    worker_lower_note_remap(100,0,200,4)
    worker_lower_note_remap(200,4,300,9)
    worker_lower_retire_dependencies(300)
    if WORKER_LOWER_BAD || WORKER_LOWER_REMAP_COUNT!=0 {return false}
    __arena_reset(mark)
    // Reuse the retired table key for a different physical source identity.
    WORKER_LOWER_BINDINGS=Some(worker_lower_store_binding(WorkerLowerBinding {module_key:100,fn_id:0,source_epoch:77,signature:second,fresh:true,trusted_worker:false,next:WORKER_LOWER_BINDINGS}))
    match worker_lower_binding(300,9,0) {Some(binding)=>{if (*(*binding).signature).id!=700 || !(*binding).fresh {return false}},None=>return false}
    match worker_lower_binding(100,0,0) {Some(binding)=>{if (*(*binding).signature).id!=701 {return false}},None=>return false}
    match worker_lower_binding(200,4,0) {Some(_)=>return false,None=>{}}
    match worker_identity_intent(700) {Some(intent)=>{if (*intent).target!=700 || (*intent).start!=3 {return false}},None=>return false}
    worker_lower_note_remap(100,0,300,9)
    match worker_lower_binding(300,9,0) {Some(_)=>{},None=>{}}
    if !WORKER_LOWER_BAD {return false}
    print("WORKER_RETIREMENT_OK arena_reset=1 chain_consolidated=1 reused_key_isolated=1 retired_edge_absent=1 conflicting_reuse_refused=1\n")
    worker_compilation_begin()
    true
}
