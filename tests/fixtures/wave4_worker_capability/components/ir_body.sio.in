use ir::ir::{ir_label,ir_jump,ir_branch_true}
fn worker_probe_cfg_main(module:&!IrModule,call:IrInstr,extract:IrInstr,mode:i64) with Mut,Panic,Div,Alloc {
    var main=Box::new(ir_empty_function())
    (*main).name=make_name("main");(*main).reg_count=6
    if ir_function_alloc_region(&!(*main))!=0 {return}
    worker_probe_emit(&!(*main),ir_load_imm(3,0))
    if mode==1 || mode==2 {
        worker_probe_emit(&!(*main),ir_branch_true(3,0))
        worker_probe_emit(&!(*main),ir_load_fn_ref(0,0))
        worker_probe_emit(&!(*main),ir_label(0))
        if mode==2 {worker_probe_emit(&!(*main),ir_copy(4,0))}
        var ctor=call
        if mode==2 {ctor.call_args=Some(Box::new(ir_reg_list_single(4)))}
        worker_probe_emit(&!(*main),ctor)
    } else {
        worker_probe_emit(&!(*main),ir_load_fn_ref(0,0))
        if mode==3 {
            worker_probe_emit(&!(*main),ir_branch_true(3,0))
            worker_probe_emit(&!(*main),call)
            worker_probe_emit(&!(*main),ir_label(0))
            worker_probe_emit(&!(*main),extract)
        } else if mode==4 || mode==5 {
            worker_probe_emit(&!(*main),call)
            worker_probe_emit(&!(*main),ir_branch_true(3,0))
            worker_probe_emit(&!(*main),ir_copy(4,1))
            worker_probe_emit(&!(*main),ir_jump(1))
            worker_probe_emit(&!(*main),ir_label(0))
            if mode==4 {worker_probe_emit(&!(*main),ir_load_imm(4,0))}
            else {worker_probe_emit(&!(*main),ir_copy(4,1))}
            worker_probe_emit(&!(*main),ir_label(1))
            var raw=extract;raw.call_args=Some(Box::new(ir_reg_list_single(4)))
            worker_probe_emit(&!(*main),raw)
        } else if mode==6 {
            worker_probe_emit(&!(*main),ir_branch_true(3,0))
            worker_probe_emit(&!(*main),ir_copy(4,0))
            worker_probe_emit(&!(*main),ir_jump(1))
            worker_probe_emit(&!(*main),ir_label(0))
            worker_probe_emit(&!(*main),ir_copy(4,0))
            worker_probe_emit(&!(*main),ir_label(1))
            var ctor=call;ctor.call_args=Some(Box::new(ir_reg_list_single(4)))
            worker_probe_emit(&!(*main),ctor)
        } else {
            worker_probe_emit(&!(*main),call)
        }
    }
    worker_probe_emit(&!(*main),ir_load_imm(2,0))
    worker_probe_emit(&!(*main),ir_return(2))
    ir_module_fn_set(module,1,*main)
}
fn worker_probe_cfg_contract(module:&!IrModule,call:IrInstr,extract:IrInstr)->i64 with Mut,Panic,Div,Alloc,IO {
