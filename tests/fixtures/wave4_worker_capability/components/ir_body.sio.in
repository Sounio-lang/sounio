    worker_probe_binding(key,1,51,1,0,0,false)
    worker_probe_binding(key,2,52,0,0,0,false)
    match worker_lower_binding_direct(key,1) {Some(binding)=>{
        (*(*binding).signature).cap_i64=1
        (*(*binding).signature).callback_abi=false
    },None=>return 0}
    if !worker_module_has_intrinsics(&(*module)) {return 0}
    if worker_validate_capability_flow(&(*module)) || worker_capability_error()!=214 {return 0}
    match worker_lower_binding_direct(key,1) {Some(binding)=>{(*binding).fresh=false},None=>return 0}
    if !worker_module_has_intrinsics(&(*module)) || worker_validate_capability_flow(&(*module)) || worker_capability_error()!=222 {return 0}
    match worker_lower_binding_direct(key,1) {Some(binding)=>{(*binding).fresh=true;(*(*binding).signature).cap_i64=0-1},None=>return 0}
    if !worker_module_has_intrinsics(&(*module)) || worker_validate_capability_flow(&(*module)) || worker_capability_error()!=225 {return 0}
    3
}
