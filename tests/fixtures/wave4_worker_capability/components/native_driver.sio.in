use parser::ast::{Name}
use native::worker_proof::{worker_native_component_module,worker_certified_entry_count,worker_certified_entry_id}
use native::codegen_x86_linux::{native_resolve_target,compile_native_v2_preview_to_file}
use ir::ir::{IrOpcode,ir_fn_get,ir_nop,ir_region_get,ir_region_set,ir_load_imm,ir_unaryop}
use parser::ast::{UnaryOp}
use native::frame::{NC_FN_OFFSETS}
fn worker_offset(name:string,id:i64) with IO,Mut,Panic,Div {
 print("OFFSET ");print(name);print(" ");print_int(NC_FN_OFFSETS[id as usize]);print("\n")
}
fn main()->i32 with IO,Mut,Panic,Div,Alloc {
 let program=worker_native_component_module()
 let mode=get_arg(1)
 if str_eq(mode,"sentinel") || str_eq(mode,"width") || str_eq(mode,"unary") {
   let function=ir_fn_get(&(*program),0)
   var mutation=ir_load_imm(1,0-4242)
   var at:i64=0
   if str_eq(mode,"width") {mutation=ir_nop();mutation.op=IrOpcode::IrStorePtr;mutation.src1=0;mutation.src2=1;mutation.imm_flags=5;at=1}
   if str_eq(mode,"unary") {mutation=ir_unaryop(2,99 as UnaryOp,0);at=1}
   if ir_region_set(&function.region,at,mutation)!=0 {return 1}
 }
 if str_eq(mode,"empty") {
   let function=ir_fn_get(&(*program),3)
   var at:i64=0
   while at<6 {if ir_region_set(&function.region,at,ir_nop())!=0 {return 1};at=at+1}
 }
 let target=native_resolve_target("x86_64-linux","auto",true)
 let status=compile_native_v2_preview_to_file(&(*program),target,get_arg(0))
 if status!=0 {print("NATIVE_COMPONENT_REFUSED ");print_int(status as i64);print("\n");return 1}
 worker_offset("@worker:raw_i64",6)
 worker_offset("@worker:raw_f64",7)
 worker_offset("worker_i64_original",0)
 worker_offset("worker_f64_original",1)
 var e:i64=0
 while e<worker_certified_entry_count() {
  let id=worker_certified_entry_id(e)
  print("OFFSET @worker:clone:");print_int(id);print(" ");print_int(NC_FN_OFFSETS[id as usize]);print("\n")
  e=e+1
 }
 println("WORKER_NATIVE_COMPONENT_EMITTED_METADATA_INJECTED")
 0
}
