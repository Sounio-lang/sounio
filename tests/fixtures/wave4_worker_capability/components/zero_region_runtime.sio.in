fn leaf_zero(x:i64)->i64 {x-x}
fn leaf_plus(x:i64)->i64 {x+7}
fn regionful(x:i64)->i64 {let value=leaf_zero(x);value+1}
fn main()->i32 with IO {
 if leaf_zero(20)!=0 || leaf_plus(20)!=27 || regionful(20)!=1 {return 1}
 print("ZERO_ADDR ");print_int(leaf_zero as i64);print("\n")
 print("PLUS_ADDR ");print_int(leaf_plus as i64);print("\n")
 print("REGION_ADDR ");print_int(regionful as i64);print("\n")
 0
}
