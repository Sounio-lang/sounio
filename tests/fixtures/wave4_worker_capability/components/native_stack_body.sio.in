
// Snapshot-only bridge for the native emitter component. Source metadata is
// injected here; this deliberately does not qualify a loader/checker graph.
use ir::ir::{ir_function_alloc_region,ir_region_push,ir_load_float,ir_float_bits_set,ir_mark_float_reg,ir_binop_typed,ir_return,ir_empty_module}
use parser::ast::{BinaryOp}
fn worker_native_emit(function:&!IrFunction,instruction:IrInstr) with Mut,Panic,Div {
    if ir_region_push(&!(*function).region,instruction)==0 {(*function).instr_count=(*function).instr_count+1}
}
fn worker_native_bind(key:i64,fi:i64,source:i64,params:i64,abi:i64) with Mut,Panic,Div,Alloc {
    let sig=Box::new(WorkerSourceSignature {id:source,owner:0,name:empty_name(),start:0,end:1,param_count:params,refs:0,cap_i64:0,cap_f64:0,cap_return:0,float_params:if abi==2 {1} else {0},float_return:abi==2,root_abi:abi,return_class:1,callback_abi:true,next:None})
    WORKER_LOWER_BINDINGS=Some(worker_lower_store_binding(WorkerLowerBinding {module_key:key,fn_id:fi,source_epoch:77,signature:sig,fresh:true,trusted_worker:false,next:WORKER_LOWER_BINDINGS}))
}
pub fn worker_native_component_module()->Box<IrModule> with Mut,Panic,Div,Alloc {
    worker_compilation_begin();worker_lower_backend_opt_in()
    var module=Box::new(ir_empty_module())
    let key=(*module).functions as i64
    var multiply=Box::new(ir_empty_function())
    (*multiply).name=make_name("worker_i64_original");(*multiply).param_count=1;(*multiply).param_regs[0]=0;(*multiply).reg_count=3
    let a=ir_function_alloc_region(&!(*multiply))
    worker_native_emit(&!(*multiply),ir_load_imm(1,2))
    worker_native_emit(&!(*multiply),ir_binop_typed(2,0,BinaryOp::OpMul,1,false,false))
    worker_native_emit(&!(*multiply),ir_return(2))
    ir_module_fn_set(&!(*module),0,*multiply)
    var identity=Box::new(ir_empty_function())
    (*identity).name=make_name("worker_f64_original");(*identity).param_count=1;(*identity).param_regs[0]=0;(*identity).reg_count=1;(*identity).returns_float=1
    let b=ir_function_alloc_region(&!(*identity))
    let bit=ir_float_bits_set(&!(*identity),0)
    worker_native_emit(&!(*identity),ir_mark_float_reg(0))
    worker_native_emit(&!(*identity),ir_return(0))
    ir_module_fn_set(&!(*module),1,*identity)
    var half=Box::new(ir_empty_function())
    (*half).name=make_name("worker_half_original");(*half).param_count=1;(*half).param_regs[0]=0;(*half).reg_count=3;(*half).returns_float=1
    let c=ir_function_alloc_region(&!(*half))
    let b0=ir_float_bits_set(&!(*half),0);let b1=ir_float_bits_set(&!(*half),1);let b2=ir_float_bits_set(&!(*half),2)
    worker_native_emit(&!(*half),ir_mark_float_reg(0))
    worker_native_emit(&!(*half),ir_load_float(1,0.5))
    worker_native_emit(&!(*half),ir_binop_typed(2,0,BinaryOp::OpMul,1,true,true))
    worker_native_emit(&!(*half),ir_return(2))
    ir_module_fn_set(&!(*module),2,*half)
    var main=Box::new(ir_empty_function())
    (*main).name=make_name("main");(*main).reg_count=7
    let d=ir_function_alloc_region(&!(*main))
    ir_module_fn_set(&!(*module),3,*main)
    (*module).fn_count=4
    let ci=worker_register_intrinsic(&!(*module),1)
    let cf=worker_register_intrinsic(&!(*module),2)
    let ri=worker_register_intrinsic(&!(*module),17)
    let rf=worker_register_intrinsic(&!(*module),18)
    var index:i64=0
    while index<3 {
        let reg=index*2
        worker_native_emit(&!(*main),ir_load_fn_ref(reg,index))
        let abi=if index==0 {1} else {2}
        let target=if abi==1 {ci} else {cf}
        var call=ir_call(reg+1,target,worker_protected_name(abi),Some(Box::new(ir_reg_list_single(reg))),1)
        call.imm_i64=123+index;call.imm_flags=64501
        worker_native_emit(&!(*main),call)
        WORKER_LOWER_INTENTS=Some(worker_lower_store_intent(WorkerLowerIntent {token:123+index,source_epoch:77,caller:20,start:2+index,end:3+index,target:10+index,abi:abi,next:WORKER_LOWER_INTENTS}))
        worker_native_bind(key,index,10+index,1,abi)
        index=index+1
    }
    worker_native_emit(&!(*main),ir_load_imm(6,0))
    worker_native_emit(&!(*main),ir_return(6))
    ir_module_fn_set(&!(*module),3,*main)
    worker_native_bind(key,3,20,0,0)
    worker_native_stack_extension(&!(*module))
    module
}

use ir::ir::{ir_unaryop,ir_store_ptr,ir_reg_list_cons}
fn worker_native_region_stub(module:&!IrModule,id:i64,name:string,params:i64) with Mut,Panic,Div,Alloc {
    var stub=ir_empty_function();stub.name=make_name(name);stub.param_count=params;stub.reg_count=params
    var p:i64=0
    while p<params {stub.param_regs[p as usize]=p;p=p+1}
    ir_module_fn_set(module,id,stub)
}
fn worker_native_stack_extension(module:&!IrModule) with Mut,Panic,Div,Alloc {
    let key=(*module).functions as i64
    var helper=Box::new(ir_empty_function())
    (*helper).name=make_name("worker_stack_helper_original");(*helper).param_count=2;(*helper).param_regs[0]=0;(*helper).param_regs[1]=1;(*helper).reg_count=4
    let a=ir_function_alloc_region(&!(*helper))
    worker_native_emit(&!(*helper),ir_load_imm(2,2))
    worker_native_emit(&!(*helper),ir_binop_typed(3,0,BinaryOp::OpMul,2,false,false))
    worker_native_emit(&!(*helper),ir_store_ptr(1,3))
    worker_native_emit(&!(*helper),ir_return(3))
    ir_module_fn_set(module,8,*helper)
    worker_native_bind(key,8,40,2,0)
    match worker_lower_binding_direct(key,8) {Some(binding)=>{(*(*binding).signature).refs=2},None=>{}}
    worker_native_region_stub(module,9,"__rgn_enter",0)
    worker_native_region_stub(module,10,"__rgn_exit_scalar",0) // factory descriptor; call ABI still has two words
    worker_native_region_stub(module,11,"__rgn_barrier",2)
    worker_native_region_stub(module,12,"__rgn_mark_all",0)
    var original=Box::new(ir_empty_function())
    (*original).name=make_name("worker_i64_original");(*original).param_count=1;(*original).param_regs[0]=0;(*original).reg_count=7
    let b=ir_function_alloc_region(&!(*original))
    worker_native_emit(&!(*original),ir_load_imm(1,0))
    worker_native_emit(&!(*original),ir_unaryop(2,UnaryOp::OpRefMut,1))
    var enter=ir_call(5,9,make_name("__rgn_enter"),None,0);enter.imm_flags=64066
    worker_native_emit(&!(*original),enter)
    let args=Some(Box::new(ir_reg_list_cons(0,Some(Box::new(ir_reg_list_single(2))))))
    worker_native_emit(&!(*original),ir_call(3,8,make_name("worker_stack_helper_original"),args,2))
    worker_native_emit(&!(*original),ir_unaryop(4,UnaryOp::OpDeref,2))
    var exit=ir_call(0-1,10,make_name("__rgn_exit_scalar"),Some(Box::new(ir_reg_list_cons(5,Some(Box::new(ir_reg_list_single(4)))))),2);exit.imm_flags=64067
    worker_native_emit(&!(*original),exit)
    worker_native_emit(&!(*original),ir_return(4))
    ir_module_fn_set(module,0,*original)
    // An ordinary serial entry deliberately has no explicit region calls.
    // Its helper's automatic store barrier must nevertheless remain present.
    var serial=Box::new(ir_empty_function())
    (*serial).name=make_name("worker_serial_store");(*serial).param_count=1;(*serial).param_regs[0]=0;(*serial).reg_count=5
    let c=ir_function_alloc_region(&!(*serial))
    worker_native_emit(&!(*serial),ir_load_imm(1,0))
    worker_native_emit(&!(*serial),ir_unaryop(2,UnaryOp::OpRefMut,1))
    worker_native_emit(&!(*serial),ir_call(3,8,make_name("worker_stack_helper_original"),args,2))
    worker_native_emit(&!(*serial),ir_unaryop(4,UnaryOp::OpDeref,2))
    worker_native_emit(&!(*serial),ir_return(4))
    ir_module_fn_set(module,13,*serial)
    (*module).fn_count=14
}
