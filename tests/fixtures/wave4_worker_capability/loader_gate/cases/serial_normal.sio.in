use stats::normal_scalar::{normal_cdf_scalar,normal_sf_scalar,normal_logcdf_scalar,normal_logsf_scalar}
fn serial(kind:i64,x:f64)->f64 with Mut,Div,Panic {
 if kind==0 {return normal_cdf_scalar(x)}
 if kind==1 {return normal_sf_scalar(x)}
 if kind==2 {return normal_logcdf_scalar(x)}
 return normal_logsf_scalar(x)
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let inf=1.0e308*10.0
 var values:[f64;15]=[-40.0,-8.0,-2.0,-1.0,-0.5,bits_to_f64(0-9223372036854775807-1),0.0,0.5,1.0,2.0,8.0,40.0,inf,0.0-inf,bits_to_f64(9221120237041090626)]
 var kind:i64=0
 while kind<4 {
  var i:i64=0
  while i<15 {
   let x=values[i as usize]
   let result=serial(kind,x)
   print("NORMAL_BITS ");print_int(kind);print(" ");print_int(f64_to_bits(x));print(" ");print_int(f64_to_bits(result));print(" ");print_int(f64_to_bits(result));print("\n")
   i=i+1
  }
  kind=kind+1
 }
 println("WORKER_SERIAL_NORMAL_CONTROL_OK")
 return 0
}
