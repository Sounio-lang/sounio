// worker_alias is a hardlink to the configured physical ffi/worker.sio.
use worker_gate::good::{collision}
use worker_gate::worker_alias::{platform_thread_spawn_i64}
use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 assert(collision(21)==64)
 let p=platform_open()
 assert(platform_status(&p)==0)
 let task=platform_thread_spawn_i64(&p,worker_fn_i64(collision),21)
 assert(task.status==0)
 let result=platform_call(&p,21,task.value,0,0,0)
 assert(result.status==0 && result.value==64)
 assert(platform_call(&p,2,task.value,0,0,0).status==0)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("WORKER_LOADER_ALIAS_BRIDGE_OK")
 return 0
}
