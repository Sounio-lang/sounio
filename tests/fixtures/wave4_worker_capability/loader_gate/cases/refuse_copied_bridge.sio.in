// Same bytes as ffi/worker.sio, but a different physical inode.
use worker_gate::good::{collision}
use worker_gate::worker_copy::{platform_thread_spawn_i64}
use ffi::platform::{platform_open,platform_call,platform_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 let task=platform_thread_spawn_i64(&p,worker_fn_i64(collision),21)
 let joined=platform_call(&p,21,task.value,0,0,0)
 let closed=platform_call(&p,2,task.value,0,0,0)
 platform_close(p)
 return 0
}
