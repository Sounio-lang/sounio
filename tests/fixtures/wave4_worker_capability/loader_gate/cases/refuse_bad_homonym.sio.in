use worker_gate::bad::{collision}
use worker_gate::good::{good_serial}
use ffi::platform::{platform_open,platform_close}
use thread::native::{native_thread_spawn,native_thread_join,native_thread_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 assert(good_serial(7)==22)
 let p=platform_open()
 var task=native_thread_spawn(&p,worker_fn_i64(collision),21)
 let ignored=native_thread_join(&p,&!task)
 let closed=native_thread_close(&p,task)
 platform_close(p)
 return 0
}
