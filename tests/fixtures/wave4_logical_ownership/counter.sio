fn rhs(counter:&!i64)->bool with Mut { *counter=*counter+1;true }
fn main()->i32 with IO,Mut,Panic {var counter:i64=0;assert(!(false && rhs(&!counter)));assert(true || rhs(&!counter));assert(true && rhs(&!counter));assert(false || rhs(&!counter));assert(counter==2);println("LOGICAL_COUNTER_OK");0}

