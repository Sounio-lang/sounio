
// Test-only bridge appended in an isolated component snapshot, never production.
fn wave4_logical_probe_expr(items:Option<Box<ItemList> >)->Option<Box<Expr> > with Mut,Panic,Div {
 match items {
  Some(list)=>match (*list).head.fn_def {
   Some(def)=>match (*def).body.stmts {Some(stmts)=>(*stmts).head.expr,None=>None},
   None=>None
  },
  None=>None
 }
}
fn wave4_logical_probe_budget(c:*mut Checker,mode:i64) with Mut,Panic,Div {
 if mode==2 {
  let arena=(*c).borrows.arena as *mut BorrowArena
  // Exactly one 64-byte branch frame plus its16-byte allocation header fits.
  (*arena).bytes=9223372036854775791-64
 }
}
fn wave4_logical_probe_state(c:*mut Checker,mode:i64)->i64 with Mut,Panic,Div {
 if (*c).borrows.branch_depth!=0 {return 91}
 if (*c).borrows.branch_head!=0 {return 92}
 if (*c).ns_branch_depth!=0 {return 93}
 let failure=borrow_failure_kind(&(*c).borrows)
 if mode==2 {if failure!=2 {return 94}}
 else {if failure!=0 {return 95}}
 let had=checker_had_error_scalar(c)
 if mode==0 {if had!=0 {return 96}}
 else {if had!=1 {return 97}}
 0
}
pub fn wave4_logical_probe(items:Option<Box<ItemList> >,mode:i64,by_value:bool)->i64 with Alloc,Mut,Panic,Div,IO {
 match wave4_logical_probe_expr(items) {
  Some(expr)=>{
   if by_value {
    var initial=checker_new()
    wave4_logical_probe_budget((&!initial) as *mut Checker,mode)
    let checked=initial.check_binary_expr(*expr)
    var final_state=checked.0
    wave4_logical_probe_state((&!final_state) as *mut Checker,mode)
   } else {
    let c=heap_alloc(134217728) as *mut Checker
    checker_init_in_place(c)
    wave4_logical_probe_budget(c,mode)
    let ignored=checker_check_binary_expr_inplace(c,*expr)
    wave4_logical_probe_state(c,mode)
   }
  },
  None=>98
 }
}

