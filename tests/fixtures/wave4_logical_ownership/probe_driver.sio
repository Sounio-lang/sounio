use parser::ast::{Name}
use compiler::module_parse::{load_module_file}
use parser::parser::{parser_last_error_count}
use check::check::{wave4_logical_probe}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
 let program=load_module_file(get_arg(0))
 assert(parser_last_error_count()==0)
 let mode=if get_arg(1)=="fault" {2}else{if get_arg(1)=="type" {1}else{0}}
 let by_value=get_arg(2)=="byvalue"
 let status=wave4_logical_probe(program.items,mode,by_value)
 print("LOGICAL_FRAME_STATUS ");print_int(status);print("\n")
 if status!=0 {return status as i32}
 println("LOGICAL_FRAME_PROBE_OK")
 0
}

