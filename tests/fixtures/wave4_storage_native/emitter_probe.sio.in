
pub fn wave4_storage_emit_probe()->i64 with IO,Alloc,Mut,Panic,Div {
 var op:i64=1
 while op<=21 {
  if op<=5 || op>=17 {
   var c=compiler_new()
   NC_RGN_BARRIER_FN=0
   emit_builtin_storage_into(&!c,op)
   if c.ir_validation_failed {return 41}
   print_int(op);print_char(32);print_int(c.code.len);print_char(32);print_int(c.flat_reloc_count);print_char(10)
   var i:i64=0
   while i<c.code.len {
    print_int(NC_BIG_CODE[i as usize] as i64 & 255);print_char(32)
    i=i+1
   }
   print_char(10)
   i=0
   while i<c.flat_reloc_count {print_int(NC_FLAT_RELOC_OFFSETS[i as usize]);print_char(32);i=i+1}
   print_char(10)
  }
  op=op+1
 }
 var bad=compiler_new()
 emit_builtin_storage_into(&!bad,99)
 if !bad.ir_validation_failed {return 42}
 0
}
