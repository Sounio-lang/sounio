use ir::ir::{ir_empty_module,ir_fn_get,ir_module_fn_set,IR_FLOAT_REG_MARKER_FLAG}
use ir::storage_intrinsics::{storage_register_intrinsic,storage_ir_call,StorageCellDescriptor,StorageIntrinsicOperands}
fn main()->i64 with IO,Alloc,Mut,Div,Panic {
 var m=ir_empty_module()
 let one=storage_register_intrinsic(&!m,1)
 assert(one==0)
 assert(storage_register_intrinsic(&!m,1)==one)
 assert(m.fn_count==1)
 let two=storage_register_intrinsic(&!m,2)
 assert(two==1)
 let out=ir_fn_get(&m,two)
 assert(out.param_count==2 && out.reg_count==2 && out.instr_count==0 && out.returns_float==0)
 assert(out.param_regs[0]==0 && out.param_regs[1]==1)
 assert(storage_register_intrinsic(&!m,99)==0-1)
 assert(m.fn_count==2)
 let d=StorageCellDescriptor{status:0,kind:3,size:8,align:8,limbs:1,contains_borrow:0,payload_state:0,needs_bare_function:false}
 let args=StorageIntrinsicOperands{owner_handle:0,address:1,source:2,value:3,count:4}
 let call=storage_ir_call(2,5,&args,&d,7)
 assert((call.imm_flags&IR_FLOAT_REG_MARKER_FLAG)!=0)
 var invalid=out
 invalid.param_count=3
 ir_module_fn_set(&!m,two,invalid)
 assert(storage_register_intrinsic(&!m,2)==0-1)
 print("storage registration and float call metadata: OK\n")
 0
}
