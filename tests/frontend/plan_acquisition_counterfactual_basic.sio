// Sprint 19: acquisition planning from deferred counterfactual evidence.

type CFM = Model<i64, Counterfactual<i64>>
models CounterfactualModels = [CFM]
policy CounterfactualPolicy for Counterfactual<i64> level Stable scope InDistribution {
    require mechanistic_divergence <= 0.20
}
deferral_policy CounterfactualReview for Counterfactual<i64> route causal_review {
    require mechanistic_divergence > 0.20
}
acquisition_policy CounterfactualClarify for Counterfactual<i64> objective Identifiability route causal_panel {
    require mechanistic_divergence >= 0.20
    require identifiability_floor < 0.80
}
audit CounterfactualAudit for Contest<Counterfactual<i64>, CounterfactualModels, CounterfactualPolicy> {
    metrics {
        mechanistic_divergence: 0.23
        identifiability_floor: 0.72
    }
    mechanistic {
        aggregate_divergence: 0.23
        latent_state_divergence: 0.19
        causal_decomposition_divergence: 0.22
        intervention_response_divergence: 0.27
        parameter_role_divergence: 0.18
        structural_explanation_distance: 0.24
    }
}

fn main() -> i64 {
    let raw: i64 = 7
    let cf: Counterfactual<i64> = measure(raw, uncertainty: 0.05)
    let c: Contest<Counterfactual<i64>, CounterfactualModels, CounterfactualPolicy> =
        (contest [CFM] on raw) audit CounterfactualAudit
    let deferred: Deferred<Counterfactual<i64>> = defer_action(cf, c, CounterfactualReview)
    let plan: AcquisitionPlan<Counterfactual<i64>> = plan_acquisition(cf, deferred, CounterfactualClarify)
    let reason = acquisition_reason(plan)
    0
}
