//@ run-pass
//@ description: Sprint 40 — native dual-path for Robust<T> multi-return CFG
//@ note: IR_STRATEGY_INSTRUMENTED (3) triggers ir_opt_apply_strategy()

// Robust<T> functions may have multiple return sites. ir_opt_apply_strategy()
// rewrites ALL IrReturn instructions to IrJump(merge_label) in both the fast
// and instrumented paths, collecting the result in the merge_block:
//
//   fast_path:           all IrReturn → IrJump(merge_label)
//   instrumented_path:   all cloned IrReturn → IrJump(merge_label)
//   merge_block:         single IrReturn — unified exit point
//
// This mirrors hlir_opt_clone_instrs() multi-return handling from Sprint 38 HLIR,
// now extended to the native IR lowering path.
//
// dual_path_structure: four_block_diamond
// strategy_constant: IR_STRATEGY_INSTRUMENTED = 3

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn robust_multi_return(x: i64) -> Robust<i64, Stable, InDistribution> {
    if x > 0 {
        let pos: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on x
        return prove_robust(pos, DefaultPolicy)
    }

    if x == 0 {
        let zero: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on 0
        return prove_robust(zero, DefaultPolicy)
    }

    let neg: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on (0 - x)
    return prove_robust(neg, DefaultPolicy)
}

fn main() -> i64 {
    let _ = robust_multi_return(2)
    0
}
