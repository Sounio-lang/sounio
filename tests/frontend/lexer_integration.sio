// Sprint 1 lexer integration tests.
// Uses the real compiler lexer via tests/frontend/lexer.sio symlink.

use lexer::{lex, lex_buffer, TokenKind, token_kind_to_string}

fn expect_kind(source: string, index: i64, expected: TokenKind, name: string) -> bool with Mut, Panic, Div {
    let tokens = lex(source)

    if index < 0 || index >= tokens.len {
        println("FAIL: " + name + " (index out of bounds)")
        return false
    }

    let got = tokens.items[index as usize].kind
    if got != expected {
        println("FAIL: " + name + " expected " + token_kind_to_string(expected) + " got " + token_kind_to_string(got))
        return false
    }

    true
}

fn test_empty_input() -> bool with Mut, Panic, Div {
    let tokens = lex("")
    if tokens.len != 1 {
        println("FAIL: empty input should produce only EOF")
        return false
    }
    if tokens.items[0].kind != TokenKind::Eof {
        println("FAIL: empty input should produce Eof")
        return false
    }
    true
}

fn test_keyword_and_identifier() -> bool with Mut, Panic, Div {
    if !expect_kind("fn main", 0, TokenKind::Fn, "fn keyword") { return false }
    if !expect_kind("fn main", 1, TokenKind::Ident, "main identifier") { return false }
    true
}

fn test_number_and_operator() -> bool with Mut, Panic, Div {
    if !expect_kind("42 + 3.14", 0, TokenKind::Int, "integer literal") { return false }
    if !expect_kind("42 + 3.14", 1, TokenKind::Plus, "plus operator") { return false }
    if !expect_kind("42 + 3.14", 2, TokenKind::Float, "float literal") { return false }
    true
}

fn test_compound_operators() -> bool with Mut, Panic, Div {
    if !expect_kind("==", 0, TokenKind::EqEq, "eqeq") { return false }
    if !expect_kind("!=", 0, TokenKind::NotEq, "noteq") { return false }
    if !expect_kind("<=", 0, TokenKind::LtEq, "lteq") { return false }
    if !expect_kind(">=", 0, TokenKind::GtEq, "gteq") { return false }
    true
}

fn test_legacy_buffer_zero_len() -> bool with Mut, Panic, Div {
    var buf: [i8; 1048576] = [0; 1048576]
    let state = lex_buffer(buf, 0, 0)
    if state.token_count != 1 {
        println("FAIL: legacy zero-len path should produce EOF only")
        return false
    }
    if state.tokens[0].kind != TokenKind::Eof {
        println("FAIL: legacy zero-len path should return EOF token")
        return false
    }
    true
}

fn run_case(name: string, ok: bool) -> i64 {
    print("Running " + name + "... ")
    if ok {
        println("PASS")
        return 1
    }
    println("FAIL")
    0
}

fn main() -> i32 with Mut, Panic, Div {
    println("=== Sprint 1: Lexer Integration ===")

    var total: i64 = 0
    var passed: i64 = 0

    total = total + 1
    passed = passed + run_case("test_empty_input", test_empty_input())

    total = total + 1
    passed = passed + run_case("test_keyword_and_identifier", test_keyword_and_identifier())

    total = total + 1
    passed = passed + run_case("test_number_and_operator", test_number_and_operator())

    total = total + 1
    passed = passed + run_case("test_compound_operators", test_compound_operators())

    total = total + 1
    passed = passed + run_case("test_legacy_buffer_zero_len", test_legacy_buffer_zero_len())

    if passed != total {
        return 1
    }
    return 0
}
