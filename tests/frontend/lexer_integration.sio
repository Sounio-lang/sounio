// Lexer Integration Tests for Sounio
// Minimal standalone test

// Copy minimal TokenKind enum from lexer.sio
enum TokenKind {
    Int,
    Float,
    String,
    Bool,
    Ident,
    Fn,
    Let,
    If,
    Else,
    While,
    For,
    Return,
    Struct,
    Enum,
    Use,
    Mut,
    With,
    As,
    Match,
    Break,
    Continue,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Eq,
    EqEq,
    NotEq,
    Lt,
    Gt,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Dot,
    Colon,
    Semi,
    Pipe,
    Underscore,
    Comment,
    Whitespace,
    Newline,
    Eof,
    Invalid,
}

struct Token {
    kind: TokenKind,
    text: string,
    line: i64,
    column: i64,
}

struct LexerState {
    tokens: [Token; 1024],
    token_count: i64,
}

// Stub functions - will be implemented
fn lex(buffer: [i8; 1048576], length: i64, offset: i64) -> LexerState {
    LexerState { tokens: [], token_count: 0 }
}

fn token_kind_to_string(kind: TokenKind) -> string {
    "TODO"
}

// ============================================================================
// TEST HELPERS
// ============================================================================

fn string_to_buffer(s: string) -> ([i8; 1048576], i64) with Mut, Panic, Div {
    var buffer: [i8; 1048576] = [0; 1048576]
    var i: i64 = 0
    while i < len(s) {
        buffer[i as usize] = s[i as usize] as i8
        i = i + 1
    }
    (buffer, len(s))
}

fn lex_string(source: string) -> LexerState with Mut, Panic, Div {
    let (buffer, length) = string_to_buffer(source)
    lex(buffer, length, 0)
}

fn count_tokens_by_kind(state: LexerState, kind: TokenKind) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < state.token_count {
        if state.tokens[i as usize].kind == kind {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn get_token(state: LexerState, index: i64) -> Token {
    state.tokens[index as usize]
}

// ============================================================================
// BASIC TESTS
// ============================================================================

fn test_empty_input() -> bool with Mut, Panic, Div {
    let state = lex_string("")
    
    if state.token_count != 1 {
        println("FAIL: Empty input should have 1 token (Eof), got " + int_to_string(state.token_count))
        return false
    }
    
    let token = get_token(state, 0)
    if token.kind != TokenKind::Eof {
        println("FAIL: Empty input should produce Eof token")
        return false
    }
    
    true
}

fn test_whitespace() -> bool with Mut, Panic, Div {
    let state = lex_string("  \n\t  ")
    
    // Should have whitespace tokens and Eof
    let whitespace_count = count_tokens_by_kind(state, TokenKind::Whitespace)
    let newline_count = count_tokens_by_kind(state, TokenKind::Newline)
    
    if whitespace_count < 2 {
        println("FAIL: Expected at least 2 whitespace tokens")
        return false
    }
    
    if newline_count != 1 {
        println("FAIL: Expected 1 newline token")
        return false
    }
    
    true
}

fn test_simple_identifiers() -> bool with Mut, Panic, Div {
    let state = lex_string("hello world")
    
    let ident_count = count_tokens_by_kind(state, TokenKind::Ident)
    if ident_count != 2 {
        println("FAIL: Expected 2 Ident tokens, got " + int_to_string(ident_count))
        return false
    }
    
    let token1 = get_token(state, 0)
    let token2 = get_token(state, 1)
    
    if token1.text != "hello" {
        println("FAIL: First token text should be 'hello', got '" + token1.text + "'")
        return false
    }
    
    if token2.text != "world" {
        println("FAIL: Second token text should be 'world', got '" + token2.text + "'")
        return false
    }
    
    true
}

fn test_keywords() -> bool with Mut, Panic, Div {
    let state = lex_string("fn let if else")
    
    // Check token kinds
    if state.token_count < 5 {  // 4 keywords + Eof
        println("FAIL: Expected at least 5 tokens")
        return false
    }
    
    let expected_kinds = [TokenKind::Fn, TokenKind::Let, TokenKind::If, TokenKind::Else]
    var i: i64 = 0
    while i < 4 {
        let token = get_token(state, i)
        if token.kind != expected_kinds[i as usize] {
            println("FAIL: Token at index " + int_to_string(i) + " expected " + token_kind_to_string(expected_kinds[i as usize]) + " got " + token_kind_to_string(token.kind))
            return false
        }
        i = i + 1
    }
    
    true
}

fn test_numbers() -> bool with Mut, Panic, Div {
    let state = lex_string("123 3.14 0x1A 0b101")
    
    let int_count = count_tokens_by_kind(state, TokenKind::Int)
    let float_count = count_tokens_by_kind(state, TokenKind::Float)
    
    if int_count != 3 {  // 123, 0x1A, 0b101
        println("FAIL: Expected 3 Int tokens, got " + int_to_string(int_count))
        return false
    }
    
    if float_count != 1 {  // 3.14
        println("FAIL: Expected 1 Float token, got " + int_to_string(float_count))
        return false
    }
    
    true
}

// ============================================================================
// OPERATOR TESTS
// ============================================================================

fn test_operators() -> bool with Mut, Panic, Div {
    let state = lex_string("+ - * / = == != < >")
    
    let expected_kinds = [
        TokenKind::Plus,
        TokenKind::Minus,
        TokenKind::Star,
        TokenKind::Slash,
        TokenKind::Eq,
        TokenKind::EqEq,
        TokenKind::NotEq,
        TokenKind::Lt,
        TokenKind::Gt,
    ]
    
    var i: i64 = 0
    while i < len(expected_kinds) {
        let token = get_token(state, i)
        if token.kind != expected_kinds[i as usize] {
            println("FAIL: Operator mismatch at index " + int_to_string(i))
            return false
        }
        i = i + 1
    }
    
    true
}

// ============================================================================
// DELIMITER TESTS
// ============================================================================

fn test_delimiters() -> bool with Mut, Panic, Div {
    let state = lex_string("( ) { } [ ] , ; :")
    
    let expected_kinds = [
        TokenKind::LParen,
        TokenKind::RParen,
        TokenKind::LBrace,
        TokenKind::RBrace,
        TokenKind::LBracket,
        TokenKind::RBracket,
        TokenKind::Comma,
        TokenKind::Semi,
        TokenKind::Colon,
    ]
    
    var i: i64 = 0
    while i < len(expected_kinds) {
        let token = get_token(state, i)
        if token.kind != expected_kinds[i as usize] {
            println("FAIL: Delimiter mismatch at index " + int_to_string(i))
            return false
        }
        i = i + 1
    }
    
    true
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn run_lexer_tests() -> i32 with Mut, Panic, Div {
    println("=== Sprint 1: Lexer Integration Tests ===")
    println("Testing actual lexer implementation\n")
    
    let tests = [
        ("test_empty_input", test_empty_input),
        ("test_whitespace", test_whitespace),
        ("test_simple_identifiers", test_simple_identifiers),
        ("test_keywords", test_keywords),
        ("test_numbers", test_numbers),
        ("test_operators", test_operators),
        ("test_delimiters", test_delimiters),
    ]
    
    var passed: i64 = 0
    var failed: i64 = 0
    
    for (name, test_func) in tests {
        print("Running " + name + "... ")
        
        let result = test_func()
        
        if result {
            println("PASS")
            passed = passed + 1
        } else {
            println("FAIL")
            failed = failed + 1
        }
    }
    
    println("\nSummary: " + int_to_string(passed) + " passed, " + int_to_string(failed) + " failed")
    
    if failed > 0 {
        return 1
    }
    return 0
}

fn main() -> i32 with Mut, Panic, Div {
    run_lexer_tests()
}
