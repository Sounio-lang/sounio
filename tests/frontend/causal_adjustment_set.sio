//@ run-pass
//@ description: identifiable query — observed confounder Z blocks backdoor X <- Z -> Y

// Causal DAG: X <- Z -> Y, with Z observed.
// The backdoor path X <- Z -> Y is blocked by conditioning on Z.
// Therefore P(Y|do(X)) = sum_z P(Y|X,Z=z) P(Z=z) is identifiable.

fn estimate_adjusted_effect(x: f64, z: f64, y: f64) -> f64 with IO, Div {
    // Adjusting for Z: stratified estimate
    let stratum_effect: f64 = y + (0.0 - x)
    stratum_effect
}

fn main() -> i64 with IO, Div {
    let effect = estimate_adjusted_effect(1.0, 0.5, 3.0)
    42
}
