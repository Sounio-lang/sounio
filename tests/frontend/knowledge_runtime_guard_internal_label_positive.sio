unit mg_dL;

struct PatientRuntimeGuardInternalLabelPositive {
    glucose: mg_dL,
}

fn measured_runtime_guard_internal_label_positive_glucose() -> mg_dL {
    return 140.0
}

fn make_patient_runtime_guard_internal_label_positive() -> Knowledge<PatientRuntimeGuardInternalLabelPositive where {
    glucose >= 126.0 <mg_dL>
}> with Panic {
    return Knowledge {
        value: PatientRuntimeGuardInternalLabelPositive {
            glucose: measured_runtime_guard_internal_label_positive_glucose(),
        }
    }
}

fn main() -> i32 with Panic {
    let patient: Knowledge<PatientRuntimeGuardInternalLabelPositive where {
        glucose >= 126.0 <mg_dL>
    }> = make_patient_runtime_guard_internal_label_positive()
    return 0
}
