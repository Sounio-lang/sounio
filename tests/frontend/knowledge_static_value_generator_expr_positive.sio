struct PatientStaticValueGeneratorExprPositive {
    age: i64,
}

fn make_patient_static_value_generator_expr_positive(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorExprPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorExprPositive {
            age: base + delta,
        }
    }
}

fn accept_patient_static_value_generator_expr_positive(
    patient: Knowledge<PatientStaticValueGeneratorExprPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_expr_positive(make_patient_static_value_generator_expr_positive(17, 1))
}
