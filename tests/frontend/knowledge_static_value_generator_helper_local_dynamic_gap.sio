struct PatientStaticValueGeneratorHelperLocalDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_helper_local_delta() -> i64 {
    return 4
}

fn add_patient_static_value_helper_local_dynamic_gap(base: i64, delta: i64) -> i64 {
    let total = base + delta
    return total
}

fn make_patient_static_value_generator_helper_local_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorHelperLocalDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperLocalDynamicGap {
            age: add_patient_static_value_helper_local_dynamic_gap(13, measured_patient_static_value_generator_helper_local_delta()),
        }
    }
}

fn accept_patient_static_value_generator_helper_local_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorHelperLocalDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_local_dynamic_gap(make_patient_static_value_generator_helper_local_dynamic_gap())
}
