//@ current-source-run-pass
//@ expect-stdout: unit derived acceleration: PASS

unit acceleration = m / s / s;

fn takes_acceleration(a: acceleration) -> f64 with Mut {
    a
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 18.0
    let time: s = 3.0
    let accel = distance / time / time
    let checked = takes_acceleration(accel)
    if checked == 2.0 {
        print("unit derived acceleration: PASS\n")
    }
    return 0
}
