struct PatientStaticValueGeneratorLocalPositive {
    age: i64,
}

fn make_patient_static_value_generator_local_positive(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorLocalPositive> {
    let age = base + delta
    return Knowledge {
        value: PatientStaticValueGeneratorLocalPositive {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_local_positive(
    patient: Knowledge<PatientStaticValueGeneratorLocalPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_local_positive(make_patient_static_value_generator_local_positive(17, 1))
}
