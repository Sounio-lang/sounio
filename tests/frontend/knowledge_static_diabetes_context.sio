ontology KnowledgeStaticSNOMED {
    class Entity
    class Diabetes subclass_of Entity
    class Type2Diabetes subclass_of Diabetes
    class Asthma subclass_of Entity
    disjoint Asthma, Diabetes
}

struct Patient {
    diagnosis: Type2Diabetes
}

fn accept_diabetes_context(p: Knowledge<Patient where { diagnosis subclass_of Diabetes }>) -> i32 {
    1
}

fn main() -> i32 {
    0
}
