struct PatientStaticValueGeneratorAssignRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_assign_reject_literal(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorAssignRejectLiteral> {
    var age = base
    age = age + delta
    return Knowledge {
        value: PatientStaticValueGeneratorAssignRejectLiteral {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_assign_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorAssignRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_assign_reject_literal(make_patient_static_value_generator_assign_reject_literal(13, 4))
}
