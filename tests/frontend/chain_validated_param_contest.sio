//@ run-pass
//@ description: Sprint 43 — __validated runtime flag propagation through instrumented call chain
//@ note: IR_STRATEGY_INSTRUMENTED (3) on outer AND inner; outer forwards param_regs[0] to inner

// Flag propagation chain:
//   main() [standard]  →  outer_contested(__validated=1)  →  inner_contested(__validated=outer.param_regs[0])
//
// outer_contested is instrumented; when it calls inner_contested (also instrumented),
// ir_lower_inject_validated_param has set outer's param_regs[0] = the __validated vreg.
// Sprint 43 forwards that vreg directly, no ir_load_imm emitted.
// outer_contested is intentionally defined before inner_contested to prove lowering
// is not sensitive to callee definition order.
//
// Non-instrumented callers (like main) still inject __validated = 1 (constant, fast path).
//
// dual_path_structure: four_block_diamond (both outer and inner)
// strategy_constant: IR_STRATEGY_INSTRUMENTED = 3

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn outer_contested(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let y = x + 1
    // Sprint 43: outer forwards its __validated (param_regs[0]) to inner
    let inner_c = inner_contested(y)
    inner_c
}

fn inner_contested(n: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let inner_result = n * 2
    let c: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on inner_result
    c
}

fn main() -> i64 {
    let _ = outer_contested(5)
    0
}
