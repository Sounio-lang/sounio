//@ run-pass
//@ description: Front-door criterion identifies causal effect via mediator

struct CausalEffect { value: f64 }

fn estimate_via_mediator(exposure: f64, mediator: f64) -> f64 with IO {
    mediator + 0.1
}

fn main() -> i64 with IO {
    let effect = CausalEffect { value: estimate_via_mediator(1.0, 2.5) }
    42
}
