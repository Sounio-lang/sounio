struct PatientStaticValueGeneratorBranchReturnCondPositive {
    age: i64,
}

fn make_patient_static_value_generator_branch_return_cond_positive(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorBranchReturnCondPositive> {
    if base + delta >= 18 {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchReturnCondPositive {
                age: 18,
            }
        }
    } else {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchReturnCondPositive {
                age: 13,
            }
        }
    }
}

fn accept_patient_static_value_generator_branch_return_cond_positive(
    patient: Knowledge<PatientStaticValueGeneratorBranchReturnCondPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_return_cond_positive(make_patient_static_value_generator_branch_return_cond_positive(17, 1))
}
