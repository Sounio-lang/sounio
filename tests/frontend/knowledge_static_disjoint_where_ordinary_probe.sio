ontology KnowledgeStaticDisjointWhereProbe {
    class Entity
    class Diabetes subclass_of Entity
    class Asthma subclass_of Entity
    disjoint Asthma, Diabetes
}

struct PatientDisjointWhereProbe {
    dx: Asthma
}

fn reject_disjoint_where_probe(p: Knowledge<PatientDisjointWhereProbe where { dx subclass_of Diabetes }>) -> i32 {
    1
}

fn main() -> i32 {
    0
}
