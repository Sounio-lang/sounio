struct DoseRuntimeGuardUnitReject {
    amount: mg,
}

fn measured_runtime_guard_unit_reject_amount() -> mg {
    return 250.0
}

fn make_dose_runtime_guard_unit_reject() -> Knowledge<DoseRuntimeGuardUnitReject where {
    amount >= 500 <mg>
}> with Panic {
    return Knowledge {
        value: DoseRuntimeGuardUnitReject {
            amount: measured_runtime_guard_unit_reject_amount(),
        }
    }
}

fn main() -> i32 with Panic {
    let dose: Knowledge<DoseRuntimeGuardUnitReject where {
        amount >= 500 <mg>
    }> = make_dose_runtime_guard_unit_reject()
    return 0
}
