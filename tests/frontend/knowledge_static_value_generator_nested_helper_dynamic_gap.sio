struct PatientStaticValueGeneratorNestedHelperDynamicGap {
    age: i64,
}

fn measured_patient_static_value_nested_helper_delta() -> i64 {
    return 1
}

fn inner_patient_static_value_nested_helper_dynamic_gap(base: i64, delta: i64) -> i64 {
    if base + delta >= 18 {
        return 13
    } else {
        return 18
    }
}

fn outer_patient_static_value_nested_helper_dynamic_gap(seed: i64) -> i64 {
    return inner_patient_static_value_nested_helper_dynamic_gap(seed, measured_patient_static_value_nested_helper_delta())
}

fn make_patient_static_value_generator_nested_helper_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorNestedHelperDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorNestedHelperDynamicGap {
            age: outer_patient_static_value_nested_helper_dynamic_gap(17),
        }
    }
}

fn accept_patient_static_value_generator_nested_helper_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorNestedHelperDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_nested_helper_dynamic_gap(make_patient_static_value_generator_nested_helper_dynamic_gap())
}
