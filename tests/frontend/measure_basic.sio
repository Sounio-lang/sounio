type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}
validation DefaultManifest for i64 {}

fn main() -> i64 {
    let k: Knowledge<i64> = measure(42, uncertainty: 1.0)
    let c: Contest<i64, DefaultModels, DefaultPolicy> = lift_knowledge(k)
    let r: Robust<i64, Stable, InDistribution> = prove_robust(c, DefaultPolicy)
    let v: Validated<i64> = validate_manifest(r, DefaultManifest)
