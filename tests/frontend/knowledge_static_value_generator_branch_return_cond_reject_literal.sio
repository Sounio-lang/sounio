struct PatientStaticValueGeneratorBranchReturnCondRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_branch_return_cond_reject_literal(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorBranchReturnCondRejectLiteral> {
    if base + delta >= 18 {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchReturnCondRejectLiteral {
                age: 18,
            }
        }
    } else {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchReturnCondRejectLiteral {
                age: 13,
            }
        }
    }
}

fn accept_patient_static_value_generator_branch_return_cond_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorBranchReturnCondRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_return_cond_reject_literal(make_patient_static_value_generator_branch_return_cond_reject_literal(13, 4))
}
