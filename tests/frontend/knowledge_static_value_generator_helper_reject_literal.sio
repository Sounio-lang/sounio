struct PatientStaticValueGeneratorHelperRejectLiteral {
    age: i64,
}

fn add_patient_static_value_helper_reject_literal(base: i64, delta: i64) -> i64 {
    return base + delta
}

fn make_patient_static_value_generator_helper_reject_literal() -> Knowledge<PatientStaticValueGeneratorHelperRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperRejectLiteral {
            age: add_patient_static_value_helper_reject_literal(13, 4),
        }
    }
}

fn accept_patient_static_value_generator_helper_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorHelperRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_reject_literal(make_patient_static_value_generator_helper_reject_literal())
}
