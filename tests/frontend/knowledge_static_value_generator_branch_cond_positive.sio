struct PatientStaticValueGeneratorBranchCondPositive {
    age: i64,
}

fn make_patient_static_value_generator_branch_cond_positive(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorBranchCondPositive> {
    var age = 13
    if base + delta >= 18 {
        age += 5
    } else {
        age += 0
    }
    return Knowledge {
        value: PatientStaticValueGeneratorBranchCondPositive {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_branch_cond_positive(
    patient: Knowledge<PatientStaticValueGeneratorBranchCondPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_cond_positive(make_patient_static_value_generator_branch_cond_positive(17, 1))
}
