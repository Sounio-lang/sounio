ontology KnowledgeStaticReturnSubclassWhereProbe {
    class Entity
    class Diabetes subclass_of Entity
    class Type2Diabetes subclass_of Diabetes
}

struct PatientReturnSubclassWhereProbe {
    dx: Type2Diabetes
}

fn accept_return_subclass_where_probe(
    p: Knowledge<PatientReturnSubclassWhereProbe>
) -> Knowledge<PatientReturnSubclassWhereProbe where { dx subclass_of Diabetes }> {
    return p
}

fn main() -> i32 {
    0
}
