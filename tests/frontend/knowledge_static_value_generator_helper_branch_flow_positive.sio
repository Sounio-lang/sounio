struct PatientStaticValueGeneratorHelperBranchFlowPositive {
    age: i64,
}

fn choose_patient_static_value_helper_branch_flow_positive(base: i64, delta: i64) -> i64 {
    var age = 13
    if base + delta >= 18 {
        age += 5
    } else {
        age += 0
    }
    return age
}

fn make_patient_static_value_generator_helper_branch_flow_positive() -> Knowledge<PatientStaticValueGeneratorHelperBranchFlowPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperBranchFlowPositive {
            age: choose_patient_static_value_helper_branch_flow_positive(17, 1),
        }
    }
}

fn accept_patient_static_value_generator_helper_branch_flow_positive(
    patient: Knowledge<PatientStaticValueGeneratorHelperBranchFlowPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_branch_flow_positive(make_patient_static_value_generator_helper_branch_flow_positive())
}
