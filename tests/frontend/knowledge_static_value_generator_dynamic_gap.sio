struct PatientStaticValueGeneratorDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_age() -> i64 {
    return 13
}

fn make_patient_static_value_generator_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorDynamicGap {
            age: measured_patient_static_value_generator_age(),
        }
    }
}

fn accept_patient_static_value_generator_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_dynamic_gap(make_patient_static_value_generator_dynamic_gap())
}
