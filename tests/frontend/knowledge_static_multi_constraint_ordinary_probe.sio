ontology KnowledgeStaticMultiConstraintProbe {
    class Entity
    class MetabolicDisease subclass_of Entity
    class Diabetes subclass_of MetabolicDisease
    class Type2Diabetes subclass_of Diabetes
}

struct PatientMultiConstraintProbe {
    dx: Type2Diabetes
}

fn accept_multi_constraint_probe(
    p: Knowledge<PatientMultiConstraintProbe where {
        dx subclass_of MetabolicDisease,
        dx subclass_of Diabetes
    }>
) -> i32 {
    1
}

fn main() -> i32 {
    0
}
