ontology KnowledgeStaticCompositeRejectRefinement {
    class Entity
    class MetabolicDisease subclass_of Entity
    class Diabetes subclass_of MetabolicDisease
    class Type2Diabetes subclass_of Diabetes
}

unit acceleration = m / s / s;

struct PatientCompositeRejectRefinement {
    dx: Type2Diabetes,
    accel: acceleration,
    age: { v: i64 | v >= 13 },
}

fn reject_composite_patient_refinement(
    p: Knowledge<PatientCompositeRejectRefinement where {
        dx subclass_of Diabetes,
        accel >= 1.0 <acceleration>,
        age >= 18
    }>
) -> i32 {
    return 1
}
