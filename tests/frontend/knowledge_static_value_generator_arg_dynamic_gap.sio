struct PatientStaticValueGeneratorArgDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_arg_age() -> i64 {
    return 13
}

fn make_patient_static_value_generator_arg_dynamic_gap(age: i64) -> Knowledge<PatientStaticValueGeneratorArgDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorArgDynamicGap {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_arg_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorArgDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_arg_dynamic_gap(make_patient_static_value_generator_arg_dynamic_gap(measured_patient_static_value_generator_arg_age()))
}
