struct PatientStaticValueGeneratorHelperAssignRejectLiteral {
    age: i64,
}

fn add_patient_static_value_helper_assign_reject_literal(base: i64, delta: i64) -> i64 {
    var total = base
    total += delta
    return total
}

fn make_patient_static_value_generator_helper_assign_reject_literal() -> Knowledge<PatientStaticValueGeneratorHelperAssignRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperAssignRejectLiteral {
            age: add_patient_static_value_helper_assign_reject_literal(13, 4),
        }
    }
}

fn accept_patient_static_value_generator_helper_assign_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorHelperAssignRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_assign_reject_literal(make_patient_static_value_generator_helper_assign_reject_literal())
}
