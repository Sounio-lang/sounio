struct PatientStaticValueAssignPositive {
    age: i64,
}

fn main() -> i32 {
    var patient: Knowledge<PatientStaticValueAssignPositive where { age >= 18 }> = Knowledge {
        value: PatientStaticValueAssignPositive {
            age: 45,
        }
    }
    patient = Knowledge {
        value: PatientStaticValueAssignPositive {
            age: 50,
        }
    }
    return 0
}
