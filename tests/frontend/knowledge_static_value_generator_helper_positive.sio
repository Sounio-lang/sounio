struct PatientStaticValueGeneratorHelperPositive {
    age: i64,
}

fn add_patient_static_value_helper_positive(base: i64, delta: i64) -> i64 {
    return base + delta
}

fn make_patient_static_value_generator_helper_positive() -> Knowledge<PatientStaticValueGeneratorHelperPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperPositive {
            age: add_patient_static_value_helper_positive(17, 1),
        }
    }
}

fn accept_patient_static_value_generator_helper_positive(
    patient: Knowledge<PatientStaticValueGeneratorHelperPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_positive(make_patient_static_value_generator_helper_positive())
}
