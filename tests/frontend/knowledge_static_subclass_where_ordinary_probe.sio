ontology KnowledgeStaticSubclassWhereProbe {
    class Entity
    class Diabetes subclass_of Entity
    class Type2Diabetes subclass_of Diabetes
}

struct PatientSubclassWhereProbe {
    dx: Type2Diabetes
}

fn accept_subclass_where_probe(p: Knowledge<PatientSubclassWhereProbe where { dx subclass_of Diabetes }>) -> i32 {
    1
}

fn main() -> i32 {
    0
}
