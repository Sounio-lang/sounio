struct PatientRuntimeGuardMultiReject {
    age: i64,
    glucose: i64,
}

fn measured_runtime_guard_multi_reject_age() -> i64 {
    return 44
}

fn measured_runtime_guard_multi_reject_glucose() -> i64 {
    return 100
}

fn make_patient_runtime_guard_multi_reject() -> Knowledge<PatientRuntimeGuardMultiReject where {
    age >= 18,
    glucose >= 126
}> with Panic {
    return Knowledge {
        value: PatientRuntimeGuardMultiReject {
            age: measured_runtime_guard_multi_reject_age(),
            glucose: measured_runtime_guard_multi_reject_glucose(),
        }
    }
}

fn main() -> i32 with Panic {
    let patient: Knowledge<PatientRuntimeGuardMultiReject where {
        age >= 18,
        glucose >= 126
    }> = make_patient_runtime_guard_multi_reject()
    return 0
}
