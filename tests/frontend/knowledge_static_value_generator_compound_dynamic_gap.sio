struct PatientStaticValueGeneratorCompoundDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_compound_delta() -> i64 {
    return 4
}

fn make_patient_static_value_generator_compound_dynamic_gap(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorCompoundDynamicGap> {
    var age = base
    age += delta
    return Knowledge {
        value: PatientStaticValueGeneratorCompoundDynamicGap {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_compound_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorCompoundDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_compound_dynamic_gap(make_patient_static_value_generator_compound_dynamic_gap(13, measured_patient_static_value_generator_compound_delta()))
}
