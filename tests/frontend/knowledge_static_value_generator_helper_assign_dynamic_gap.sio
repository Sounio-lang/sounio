struct PatientStaticValueGeneratorHelperAssignDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_helper_assign_delta() -> i64 {
    return 4
}

fn add_patient_static_value_helper_assign_dynamic_gap(base: i64, delta: i64) -> i64 {
    var total = base
    total += delta
    return total
}

fn make_patient_static_value_generator_helper_assign_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorHelperAssignDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperAssignDynamicGap {
            age: add_patient_static_value_helper_assign_dynamic_gap(13, measured_patient_static_value_generator_helper_assign_delta()),
        }
    }
}

fn accept_patient_static_value_generator_helper_assign_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorHelperAssignDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_assign_dynamic_gap(make_patient_static_value_generator_helper_assign_dynamic_gap())
}
