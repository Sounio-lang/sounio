struct PatientStaticValueCallPositive {
    age: i64,
}

fn accept_patient_static_value_call_positive(
    patient: Knowledge<PatientStaticValueCallPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_call_positive(Knowledge {
        value: PatientStaticValueCallPositive {
            age: 45,
        }
    })
}
