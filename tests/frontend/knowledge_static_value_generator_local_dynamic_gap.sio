struct PatientStaticValueGeneratorLocalDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_local_delta() -> i64 {
    return 4
}

fn make_patient_static_value_generator_local_dynamic_gap(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorLocalDynamicGap> {
    let age = base + delta
    return Knowledge {
        value: PatientStaticValueGeneratorLocalDynamicGap {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_local_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorLocalDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_local_dynamic_gap(make_patient_static_value_generator_local_dynamic_gap(13, measured_patient_static_value_generator_local_delta()))
}
