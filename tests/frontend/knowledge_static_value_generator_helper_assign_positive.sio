struct PatientStaticValueGeneratorHelperAssignPositive {
    age: i64,
}

fn add_patient_static_value_helper_assign_positive(base: i64, delta: i64) -> i64 {
    var total = base
    total += delta
    return total
}

fn make_patient_static_value_generator_helper_assign_positive() -> Knowledge<PatientStaticValueGeneratorHelperAssignPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperAssignPositive {
            age: add_patient_static_value_helper_assign_positive(17, 1),
        }
    }
}

fn accept_patient_static_value_generator_helper_assign_positive(
    patient: Knowledge<PatientStaticValueGeneratorHelperAssignPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_assign_positive(make_patient_static_value_generator_helper_assign_positive())
}
