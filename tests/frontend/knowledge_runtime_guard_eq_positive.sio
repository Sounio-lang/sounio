struct AssayRuntimeGuardEqPositive {
    repeats: i64,
}

fn measured_runtime_guard_eq_positive_repeats() -> i64 {
    return 3
}

fn make_assay_runtime_guard_eq_positive() -> Knowledge<AssayRuntimeGuardEqPositive where {
    repeats == 3
}> with Panic {
    return Knowledge {
        value: AssayRuntimeGuardEqPositive {
            repeats: measured_runtime_guard_eq_positive_repeats(),
        }
    }
}

fn main() -> i32 with Panic {
    let assay: Knowledge<AssayRuntimeGuardEqPositive where {
        repeats == 3
    }> = make_assay_runtime_guard_eq_positive()
    return 0
}
