struct PatientRuntimeGuardCallReject {
    age: i64,
}

fn measured_runtime_guard_call_reject_age() -> i64 {
    return 13
}

fn accept_patient_runtime_guard_call_reject(
    patient: Knowledge<PatientRuntimeGuardCallReject where { age >= 18 }>
) -> i32 {
    return 0
}

fn main() -> i32 with Panic {
    return accept_patient_runtime_guard_call_reject(Knowledge {
        value: PatientRuntimeGuardCallReject {
            age: measured_runtime_guard_call_reject_age(),
        }
    })
