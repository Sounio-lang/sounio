//@ run-pass
//@ description: causal type in pharmacokinetic context

fn pk_dose_effect(dose: f64, clearance: f64) -> f64 with IO, Div, Panic {
    // AUC = Dose / Clearance  (simplified one-compartment PK)
    dose / clearance
}

fn main() -> i64 with IO, Div, Panic {
    let dose: f64 = 100.0
    let cl: f64 = 2.5
    let auc = pk_dose_effect(dose, cl)
    42
}
