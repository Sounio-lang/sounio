struct PatientStaticValueGeneratorCompoundPositive {
    age: i64,
}

fn make_patient_static_value_generator_compound_positive(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorCompoundPositive> {
    var age = base
    age += delta
    return Knowledge {
        value: PatientStaticValueGeneratorCompoundPositive {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_compound_positive(
    patient: Knowledge<PatientStaticValueGeneratorCompoundPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_compound_positive(make_patient_static_value_generator_compound_positive(17, 1))
}
