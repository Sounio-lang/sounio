//@ run-pass
//@ description: Sprint 47 — .sprof profile reader + strategy promotion
//@ note: sprof_parse reads text profile; sprof_apply_promotion overrides strategy

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn hot_function(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let result = x * 2
    let c: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on result
    c
}

fn main() -> i64 {
    let _ = hot_function(5)
    0
}
