// Sprint 38: StrategyInstrumented full-CFG fixture with multiple returns.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn robust_multi_return(x: i64) -> Robust<i64, Stable, InDistribution> {
    if x > 0 {
        let pos: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on x
        return prove_robust(pos, DefaultPolicy)
    }

    if x == 0 {
        let zero: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on 0
        return prove_robust(zero, DefaultPolicy)
    }

    let neg: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on (0 - x)
    return prove_robust(neg, DefaultPolicy)
}

fn main() -> i64 {
    let _ = robust_multi_return(2)
    0
}
