ontology KnowledgeStaticTransitiveWhereProbe {
    class Entity
    class MetabolicDisease subclass_of Entity
    class Diabetes subclass_of MetabolicDisease
    class Type2Diabetes subclass_of Diabetes
}

struct PatientTransitiveWhereProbe {
    dx: Type2Diabetes
}

fn accept_transitive_where_probe(p: Knowledge<PatientTransitiveWhereProbe where { dx subclass_of MetabolicDisease }>) -> i32 {
    1
}

fn main() -> i32 {
    0
}
