// Sprint 1 simple smoke test.
// Explicit runner style (no tuple destructuring/function-table pattern).

fn test_basic_arithmetic() -> bool {
    let x = 2 + 2
    if x != 4 {
        println("FAIL: 2 + 2 should be 4")
        return false
    }

    let y = 10 * 10
    if y != 100 {
        println("FAIL: 10 * 10 should be 100")
        return false
    }

    true
}

fn test_string_concat() -> bool {
    let a = "Hello"
    let b = " World"
    if a + b != "Hello World" {
        println("FAIL: string concatenation")
        return false
    }
    true
}

fn test_boolean_logic() -> bool {
    let a = true
    let b = false

    if !a { return false }
    if b { return false }
    if (a && b) != false { return false }
    if (a || b) != true { return false }

    true
}

fn run_case(name: string, ok: bool) -> i64 {
    print("Running " + name + "... ")
    if ok {
        println("PASS")
        return 1
    }

    println("FAIL")
    0
}

fn main() -> i32 {
    println("=== Simple Frontend Smoke ===")

    var total: i64 = 0
    var passed: i64 = 0

    total = total + 1
    passed = passed + run_case("test_basic_arithmetic", test_basic_arithmetic())

    total = total + 1
    passed = passed + run_case("test_string_concat", test_string_concat())

    total = total + 1
    passed = passed + run_case("test_boolean_logic", test_boolean_logic())

    if passed != total {
        return 1
    }
    0
}
