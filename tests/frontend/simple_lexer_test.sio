// Simple Lexer Test - No imports needed
// Tests basic language features

fn int_to_string(n: i64) -> string with Mut, Panic, Div {
    if n == 0 {
        return "0"
    }
    
    let negative = n < 0
    var num = if negative { 0 - n } else { n }
    var result = ""
    
    while num > 0 {
        let digit = num % 10
        let ch = 48 + digit  // ASCII '0' = 48
        result = string_from_char(ch as i8) + result
        num = num / 10
    }
    
    if negative {
        "-" + result
    } else {
        result
    }
}

fn string_from_char(ch: i8) -> string {
    var arr: [i8; 2] = [ch, 0]
    // Convert array to string (simplified)
    if ch == 65 { "A" }
    else if ch == 66 { "B" }
    else { "?" }
}

fn test_basic_arithmetic() -> bool {
    let x = 2 + 2
    if x != 4 {
        println("FAIL: 2 + 2 should be 4, got " + int_to_string(x))
        return false
    }
    
    let y = 10 * 10
    if y != 100 {
        println("FAIL: 10 * 10 should be 100, got " + int_to_string(y))
        return false
    }
    
    true
}

fn test_string_concatenation() -> bool {
    let s1 = "Hello"
    let s2 = " World"
    let combined = s1 + s2
    
    if combined != "Hello World" {
        println("FAIL: String concatenation failed")
        return false
    }
    
    true
}

fn test_boolean_logic() -> bool {
    let a = true
    let b = false
    
    if !a {
        println("FAIL: true should be true")
        return false
    }
    
    if b {
        println("FAIL: false should be false")
        return false
    }
    
    if (a && b) != false {
        println("FAIL: true && false should be false")
        return false
    }
    
    if (a || b) != true {
        println("FAIL: true || false should be true")
        return false
    }
    
    true
}

fn main() -> i32 {
    println("=== Simple Lexer Test ===")
    
    let tests = [
        ("test_basic_arithmetic", test_basic_arithmetic),
        ("test_string_concatenation", test_string_concatenation),
        ("test_boolean_logic", test_boolean_logic),
    ]
    
    var passed = 0
    var failed = 0
    
    for (name, test_func) in tests {
        print("Running " + name + "... ")
        
        let result = test_func()
        
        if result {
            println("PASS")
            passed = passed + 1
        } else {
            println("FAIL")
            failed = failed + 1
        }
    }
    
    println("\nSummary: " + int_to_string(passed) + " passed, " + int_to_string(failed) + " failed")
    
    if failed > 0 {
        return 1
    }
    return 0
}
