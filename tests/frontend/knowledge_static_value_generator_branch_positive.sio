struct PatientStaticValueGeneratorBranchPositive {
    age: i64,
}

fn make_patient_static_value_generator_branch_positive() -> Knowledge<PatientStaticValueGeneratorBranchPositive> {
    if true {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchPositive {
                age: 18,
            }
        }
    } else {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchPositive {
                age: 13,
            }
        }
    }
}

fn accept_patient_static_value_generator_branch_positive(
    patient: Knowledge<PatientStaticValueGeneratorBranchPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_positive(make_patient_static_value_generator_branch_positive())
}
