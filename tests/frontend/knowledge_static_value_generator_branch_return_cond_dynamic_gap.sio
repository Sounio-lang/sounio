struct PatientStaticValueGeneratorBranchReturnCondDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_branch_return_cond_delta() -> i64 {
    return 1
}

fn make_patient_static_value_generator_branch_return_cond_dynamic_gap(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorBranchReturnCondDynamicGap> {
    if base + delta >= 18 {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchReturnCondDynamicGap {
                age: 13,
            }
        }
    } else {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchReturnCondDynamicGap {
                age: 18,
            }
        }
    }
}

fn accept_patient_static_value_generator_branch_return_cond_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorBranchReturnCondDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_return_cond_dynamic_gap(make_patient_static_value_generator_branch_return_cond_dynamic_gap(17, measured_patient_static_value_generator_branch_return_cond_delta()))
}
