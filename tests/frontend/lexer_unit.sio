// Lexer Unit Tests for Sounio
// Sprint 1: Frontend Stabilization

import stdlib.test.assert::*

// ============================================================================
// TEST HELPERS
// ============================================================================

fn lex_source(source: string) -> [Token] with IO, Mut, Panic, Div, Alloc {
    // TODO: Call actual lexer function
    // For now, return empty array
    []
}

fn count_tokens_by_kind(tokens: [Token], kind: TokenKind) -> i64 {
    var count = 0
    for token in tokens {
        if token.kind == kind {
            count = count + 1
        }
    }
    count
}

fn assert_token_kind(tokens: [Token], index: i64, expected: TokenKind) -> bool {
    if index >= len(tokens) {
        println("FAIL: Token index " + int_to_string(index) + " out of bounds")
        return false
    }
    
    let token = tokens[index]
    if token.kind != expected {
        println("FAIL: Token at index " + int_to_string(index) + " expected " + token_kind_to_string(expected) + " got " + token_kind_to_string(token.kind))
        return false
    }
    
    true
}

fn assert_token_text(tokens: [Token], index: i64, expected: string) -> bool {
    if index >= len(tokens) {
        println("FAIL: Token index " + int_to_string(index) + " out of bounds")
        return false
    }
    
    let token = tokens[index]
    if token.text != expected {
        println("FAIL: Token at index " + int_to_string(index) + " expected text '" + expected + "' got '" + token.text + "'")
        return false
    }
    
    true
}

// ============================================================================
// LITERAL TESTS
// ============================================================================

fn test_int_literals() -> bool {
    let source = "123 0x1A 0b101 0o777 -42 999999999999999999"
    let tokens = lex_source(source)
    
    // Should have 6 Int tokens
    let int_count = count_tokens_by_kind(tokens, TokenKind::Int)
    if int_count != 6 {
        println("FAIL: Expected 6 Int tokens, got " + int_to_string(int_count))
        return false
    }
    
    // Verify specific tokens
    if !assert_token_text(tokens, 0, "123") { return false }
    if !assert_token_text(tokens, 1, "0x1A") { return false }
    if !assert_token_text(tokens, 2, "0b101") { return false }
    if !assert_token_text(tokens, 3, "0o777") { return false }
    if !assert_token_text(tokens, 4, "-42") { return false }
    if !assert_token_text(tokens, 5, "999999999999999999") { return false }
    
    true
}

fn test_float_literals() -> bool {
    let source = "3.14 2.0e10 -0.5 1. .5 6.022e23"
    let tokens = lex_source(source)
    
    let float_count = count_tokens_by_kind(tokens, TokenKind::Float)
    if float_count != 6 {
        println("FAIL: Expected 6 Float tokens, got " + int_to_string(float_count))
        return false
    }
    
    true
}

fn test_string_literals() -> bool {
    let source = '"hello" "world\n" "escaped\\" "unicode\u{1F600}" ""'
    let tokens = lex_source(source)
    
    let string_count = count_tokens_by_kind(tokens, TokenKind::String)
    if string_count != 5 {
        println("FAIL: Expected 5 String tokens, got " + int_to_string(string_count))
        return false
    }
    
    true
}

fn test_bool_literals() -> bool {
    let source = "true false"
    let tokens = lex_source(source)
    
    let bool_count = count_tokens_by_kind(tokens, TokenKind::Bool)
    if bool_count != 2 {
        println("FAIL: Expected 2 Bool tokens, got " + int_to_string(bool_count))
        return false
    }
    
    if !assert_token_text(tokens, 0, "true") { return false }
    if !assert_token_text(tokens, 1, "false") { return false }
    
    true
}

// ============================================================================
// KEYWORD TESTS
// ============================================================================

fn test_keywords() -> bool {
    let source = "fn let var if else while for return struct enum use mut with as match break continue"
    let tokens = lex_source(source)
    
    // Check each keyword
    let expected_keywords = [
        TokenKind::Fn,
        TokenKind::Let,
        TokenKind::Var,
        TokenKind::If,
        TokenKind::Else,
        TokenKind::While,
        TokenKind::For,
        TokenKind::Return,
        TokenKind::Struct,
        TokenKind::Enum,
        TokenKind::Use,
        TokenKind::Mut,
        TokenKind::With,
        TokenKind::As,
        TokenKind::Match,
        TokenKind::Break,
        TokenKind::Continue,
    ]
    
    if len(tokens) != len(expected_keywords) {
        println("FAIL: Expected " + int_to_string(len(expected_keywords)) + " tokens, got " + int_to_string(len(tokens)))
        return false
    }
    
    var i = 0
    while i < len(expected_keywords) {
        if !assert_token_kind(tokens, i, expected_keywords[i]) {
            return false
        }
        i = i + 1
    }
    
    true
}

// ============================================================================
// OPERATOR TESTS
// ============================================================================

fn test_operators() -> bool {
    let source = "+ - * / % = == != < <= > >= && || ! -> =>"
    let tokens = lex_source(source)
    
    let expected_operators = [
        TokenKind::Plus,
        TokenKind::Minus,
        TokenKind::Star,
        TokenKind::Slash,
        TokenKind::Percent,
        TokenKind::Eq,
        TokenKind::EqEq,
        TokenKind::NotEq,
        TokenKind::Lt,
        TokenKind::LtEq,
        TokenKind::Gt,
        TokenKind::GtEq,
        TokenKind::And,
        TokenKind::Or,
        TokenKind::Not,
        TokenKind::Arrow,
        TokenKind::FatArrow,
    ]
    
    if len(tokens) != len(expected_operators) {
        println("FAIL: Expected " + int_to_string(len(expected_operators)) + " operator tokens, got " + int_to_string(len(tokens)))
        return false
    }
    
    var i = 0
    while i < len(expected_operators) {
        if !assert_token_kind(tokens, i, expected_operators[i]) {
            return false
        }
        i = i + 1
    }
    
    true
}

// ============================================================================
// DELIMITER TESTS
// ============================================================================

fn test_delimiters() -> bool {
    let source = "() {} [] , . : ; | _"
    let tokens = lex_source(source)
    
    let expected_delimiters = [
        TokenKind::LParen,
        TokenKind::RParen,
        TokenKind::LBrace,
        TokenKind::RBrace,
        TokenKind::LBracket,
        TokenKind::RBracket,
        TokenKind::Comma,
        TokenKind::Dot,
        TokenKind::Colon,
        TokenKind::Semi,
        TokenKind::Pipe,
        TokenKind::Underscore,
    ]
    
    if len(tokens) != len(expected_delimiters) {
        println("FAIL: Expected " + int_to_string(len(expected_delimiters)) + " delimiter tokens, got " + int_to_string(len(tokens)))
        return false
    }
    
    var i = 0
    while i < len(expected_delimiters) {
        if !assert_token_kind(tokens, i, expected_delimiters[i]) {
            return false
        }
        i = i + 1
    }
    
    true
}

// ============================================================================
// IDENTIFIER TESTS
// ============================================================================

fn test_identifiers() -> bool {
    let source = "hello world123 _private CamelCase snake_case π unicode_λ"
    let tokens = lex_source(source)
    
    let ident_count = count_tokens_by_kind(tokens, TokenKind::Ident)
    if ident_count != 7 {
        println("FAIL: Expected 7 Ident tokens, got " + int_to_string(ident_count))
        return false
    }
    
    true
}

// ============================================================================
// EDGE CASE TESTS
// ============================================================================

fn test_edge_cases() -> bool {
    // Test 1: Empty input
    let tokens1 = lex_source("")
    if len(tokens1) != 1 || tokens1[0].kind != TokenKind::Eof {
        println("FAIL: Empty input should produce only Eof token")
        return false
    }
    
    // Test 2: Only whitespace
    let tokens2 = lex_source("  \n\t  ")
    // Should have whitespace tokens and Eof
    
    // Test 3: Comments
    let tokens3 = lex_source("// comment\ncode // another comment")
    let comment_count = count_tokens_by_kind(tokens3, TokenKind::Comment)
    if comment_count != 2 {
        println("FAIL: Expected 2 Comment tokens, got " + int_to_string(comment_count))
        return false
    }
    
    true
}

// ============================================================================
// ERROR HANDLING TESTS
// ============================================================================

fn test_error_handling() -> bool {
    // Test invalid characters
    let source = "@ $ #"
    let tokens = lex_source(source)
    
    let invalid_count = count_tokens_by_kind(tokens, TokenKind::Invalid)
    if invalid_count < 3 {
        println("FAIL: Expected at least 3 Invalid tokens for @ $ #, got " + int_to_string(invalid_count))
        return false
    }
    
    true
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn run_all_lexer_tests() -> i32 {
    let tests = [
        ("test_int_literals", test_int_literals),
        ("test_float_literals", test_float_literals),
        ("test_string_literals", test_string_literals),
        ("test_bool_literals", test_bool_literals),
        ("test_keywords", test_keywords),
        ("test_operators", test_operators),
        ("test_delimiters", test_delimiters),
        ("test_identifiers", test_identifiers),
        ("test_edge_cases", test_edge_cases),
        ("test_error_handling", test_error_handling),
    ]
    
    var passed = 0
    var failed = 0
    
    for (name, test_func) in tests {
        print("Running " + name + "... ")
        
        let result = test_func()
        
        if result {
            println("PASS")
            passed = passed + 1
        } else {
            println("FAIL")
            failed = failed + 1
        }
    }
    
    println("\nLexer Tests Summary: " + int_to_string(passed) + " passed, " + int_to_string(failed) + " failed")
    
    if failed > 0 {
        return 1
    }
    return 0
}

fn main() -> i32 {
    println("=== Sprint 1: Lexer Unit Tests ===")
    println("Testing all TokenKind variants and edge cases\n")
    
    let result = run_all_lexer_tests()
    
    println("\n=== Lexer Test Complete ===")
    return result
}
