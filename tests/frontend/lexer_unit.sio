// Sprint 1 lexer unit tests.
// Real lexer API coverage for core tokens and edge behavior.

use lexer::{lex, TokenKind, token_kind_to_string}

fn expect_kind(source: string, index: i64, expected: TokenKind, name: string) -> bool with Mut, Panic, Div {
    let tokens = lex(source)

    if index < 0 || index >= tokens.len {
        println("FAIL: " + name + " (index out of bounds)")
        return false
    }

    let got = tokens.items[index as usize].kind
    if got != expected {
        println("FAIL: " + name + " expected " + token_kind_to_string(expected) + " got " + token_kind_to_string(got))
        return false
    }

    true
}

fn has_kind(source: string, expected: TokenKind) -> bool with Mut, Panic, Div {
    let tokens = lex(source)
    var i: i64 = 0
    while i < tokens.len {
        if tokens.items[i as usize].kind == expected {
            return true
        }
        i = i + 1
    }
    false
}

fn test_ident_and_keywords() -> bool with Mut, Panic, Div {
    if !expect_kind("let x", 0, TokenKind::Let, "let keyword") { return false }
    if !expect_kind("let x", 1, TokenKind::Ident, "identifier x") { return false }
    if !expect_kind("fn main", 0, TokenKind::Fn, "fn keyword") { return false }
    true
}

fn test_numeric_literals() -> bool with Mut, Panic, Div {
    if !expect_kind("0", 0, TokenKind::Int, "int zero") { return false }
    if !expect_kind("123", 0, TokenKind::Int, "int literal") { return false }
    if !expect_kind("3.14", 0, TokenKind::Float, "float literal") { return false }
    true
}

fn test_string_literals() -> bool with Mut, Panic, Div {
    if !expect_kind("\"hi\"", 0, TokenKind::String, "string literal") { return false }
    if !expect_kind("\"line\\n\"", 0, TokenKind::String, "escaped newline string") { return false }
    true
}

fn test_operators_and_delimiters() -> bool with Mut, Panic, Div {
    if !expect_kind("==", 0, TokenKind::EqEq, "eqeq") { return false }
    if !expect_kind("&&", 0, TokenKind::And, "andand") { return false }
    if !expect_kind("->", 0, TokenKind::Arrow, "arrow") { return false }
    if !expect_kind("=>", 0, TokenKind::FatArrow, "fat arrow") { return false }
    if !expect_kind("(", 0, TokenKind::LParen, "left paren") { return false }
    if !expect_kind("}", 0, TokenKind::RBrace, "right brace") { return false }
    true
}

fn test_comments_and_invalid() -> bool with Mut, Panic, Div {
    let tokens = lex("// ignore\nlet x")
    if tokens.len < 3 {
        println("FAIL: comment stream should still include let x EOF")
        return false
    }
    if tokens.items[0].kind != TokenKind::Let {
        println("FAIL: comment should be skipped before let")
        return false
    }
    if !has_kind("@", TokenKind::Invalid) {
        println("FAIL: invalid character should produce Invalid token")
        return false
    }
    true
}

fn run_case(name: string, ok: bool) -> i64 {
    print("Running " + name + "... ")
    if ok {
        println("PASS")
        return 1
    }
    println("FAIL")
    0
}

fn main() -> i32 with Mut, Panic, Div {
    println("=== Sprint 1: Lexer Unit ===")

    var total: i64 = 0
    var passed: i64 = 0

    total = total + 1
    passed = passed + run_case("test_ident_and_keywords", test_ident_and_keywords())

    total = total + 1
    passed = passed + run_case("test_numeric_literals", test_numeric_literals())

    total = total + 1
    passed = passed + run_case("test_string_literals", test_string_literals())

    total = total + 1
    passed = passed + run_case("test_operators_and_delimiters", test_operators_and_delimiters())

    total = total + 1
    passed = passed + run_case("test_comments_and_invalid", test_comments_and_invalid())

    if passed != total {
        return 1
    }
    0
}
