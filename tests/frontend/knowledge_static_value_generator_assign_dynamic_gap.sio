struct PatientStaticValueGeneratorAssignDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_assign_delta() -> i64 {
    return 4
}

fn make_patient_static_value_generator_assign_dynamic_gap(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorAssignDynamicGap> {
    var age = base
    age = age + delta
    return Knowledge {
        value: PatientStaticValueGeneratorAssignDynamicGap {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_assign_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorAssignDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_assign_dynamic_gap(make_patient_static_value_generator_assign_dynamic_gap(13, measured_patient_static_value_generator_assign_delta()))
}
