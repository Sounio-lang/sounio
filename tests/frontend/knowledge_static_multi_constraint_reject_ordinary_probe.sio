ontology KnowledgeStaticMultiConstraintRejectProbe {
    class Entity
    class MetabolicDisease subclass_of Entity
    class Diabetes subclass_of MetabolicDisease
    class Asthma subclass_of Entity
    disjoint Asthma, Diabetes
}

struct PatientMultiConstraintRejectProbe {
    dx: Asthma
}

fn reject_multi_constraint_probe(
    p: Knowledge<PatientMultiConstraintRejectProbe where {
        dx subclass_of Entity,
        dx subclass_of Diabetes
    }>
) -> i32 {
    1
}

fn main() -> i32 {
    0
}
