use data::bigrat::*

fn r(n: i64, d: i64) -> BigRat with Mut, Panic, Div {
    bigrat_make(big_from_i64(n), big_from_i64(d))
}

fn show(label: string, x: BigRat) with IO, Mut, Panic, Div {
    print(label)
    print(": ")
    big_print(bigrat_num(x))
    print("/")
    big_print(bigrat_den(x))
    print("\n")
}

fn main() -> i64 with IO, Mut, Panic, Div {
    show("add", bigrat_add(r(1, 2), r(1, 3)))
    show("mul", bigrat_mul(r(2, 3), r(3, 4)))
    show("sub", bigrat_sub(r(1, 2), r(1, 3)))
    show("div", bigrat_div(r(1, 2), r(1, 3)))
    show("cmp_lt", r(1, 3))
    show("cmp_eq", r(1, 2))

    // Sum of reciprocals of the first six primes: forces a large reduced denominator.
    var acc = r(0, 1)
    acc = bigrat_add(acc, r(1, 2))
    acc = bigrat_add(acc, r(1, 3))
    acc = bigrat_add(acc, r(1, 5))
    acc = bigrat_add(acc, r(1, 7))
    acc = bigrat_add(acc, r(1, 11))
    acc = bigrat_add(acc, r(1, 13))
    show("prime_recip_sum", acc)

    let cmp1 = bigrat_cmp(r(1, 3), r(1, 2))
    let cmp2 = bigrat_cmp(r(1, 2), r(1, 2))
    print("bigrat_cmp(1/3,1/2)=")
    print_int(cmp1)
    print("\n")
    print("bigrat_cmp(1/2,1/2)=")
    print_int(cmp2)
    print("\n")
    return 0
}
