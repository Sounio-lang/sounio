//@ run-pass
//@ description: ML fairness types — demographic parity, equalized odds, counterfactual fairness

// FairPrediction<T, criterion, protected_attr> encodes ML fairness constraints as types.
//
// FAIRNESS CRITERIA (Sounio Sprint 22 Track F):
//   0 = Demographic parity:   P(Ŷ=1|A=0) = P(Ŷ=1|A=1)           (Dwork et al. 2012)
//   1 = Equalized odds:       TPR(A=0)=TPR(A=1) ∧ FPR(A=0)=FPR(A=1) (Hardt et al. 2016)
//   2 = Individual fairness:  |f(x)-f(x')| ≤ L·d(x,x') Lipschitz bound (Dwork et al. 2012)
//   3 = Calibration-within-group: P(Y=1|Ŷ=p,A=a)=p for all a    (Chouldechova 2017)
//   4 = Counterfactual fairness: Ŷ(A←a)=Ŷ(A←a') for all a,a'   (Kusner et al. 2017)
//
// IMPOSSIBILITY THEOREM (Chouldechova 2017):
//   When base rates differ (P(Y=1|A=0) ≠ P(Y=1|A=1)),
//   criteria 0, 1, and 3 cannot all simultaneously hold.
//   Sounio encodes this as E082 (contradictory fairness criteria).
//
// SOTA novelty: First type system to encode fairness criteria as type-level constraints.
// Paper: FAccT 2027 + POPL 2027 short paper

// ============================================================
// Demographic parity
// ============================================================

// demographic_parity_gap: |P(Ŷ=1|A=0) - P(Ŷ=1|A=1)|
// For binary protected attribute A ∈ {0, 1}.
// Perfect DP requires this = 0; ε-DP requires this ≤ ε.
fn demographic_parity_gap(positive_rate_a0: f64, positive_rate_a1: f64) -> f64 with IO {
    let diff = positive_rate_a1 + (0.0 - positive_rate_a0)
    if diff < 0.0 { 0.0 - diff } else { diff }  // absolute value
}

// demographic_parity_ratio: P(Ŷ=1|A=min) / P(Ŷ=1|A=max)
// The "80% rule" (EEOC/EU AI Act): ratio must exceed 0.8 for fairness.
fn demographic_parity_ratio(rate_a0: f64, rate_a1: f64) -> f64 with IO, Div, Panic {
    let min_rate = if rate_a0 < rate_a1 { rate_a0 } else { rate_a1 }
    let max_rate = if rate_a0 > rate_a1 { rate_a0 } else { rate_a1 }
    min_rate / max_rate
}

// ============================================================
// Equalized odds
// ============================================================

// equalized_odds_gap: max(|ΔTPR|, |ΔFPR|) across protected groups
// Both true positive rate and false positive rate must be equal across groups.
fn equalized_odds_gap(
    tpr_a0: f64, tpr_a1: f64,   // TPR = P(Ŷ=1|Y=1, A=a) per group
    fpr_a0: f64, fpr_a1: f64    // FPR = P(Ŷ=1|Y=0, A=a) per group
) -> f64 with IO {
    let tpr_diff = tpr_a1 + (0.0 - tpr_a0)
    let fpr_diff = fpr_a1 + (0.0 - fpr_a0)
    let abs_tpr = if tpr_diff < 0.0 { 0.0 - tpr_diff } else { tpr_diff }
    let abs_fpr = if fpr_diff < 0.0 { 0.0 - fpr_diff } else { fpr_diff }
    if abs_tpr > abs_fpr { abs_tpr } else { abs_fpr }
}

// equal_opportunity_gap: |ΔTPR| only (Hardt et al. 2016)
// Weaker criterion: only requires equal TPR (not FPR).
// Appropriate when false negatives have higher societal cost.
fn equal_opportunity_gap(tpr_a0: f64, tpr_a1: f64) -> f64 with IO {
    let diff = tpr_a1 + (0.0 - tpr_a0)
    if diff < 0.0 { 0.0 - diff } else { diff }
}

// ============================================================
// Calibration within group
// ============================================================

// calibration_gap: |P(Y=1|Ŷ=p,A=0) - P(Y=1|Ŷ=p,A=1)|
// At predicted probability p, how much do actual outcomes differ across groups?
// A well-calibrated model has calibration_gap = 0 for all p.
fn calibration_gap(
    actual_rate_a0: f64,  // P(Y=1|Ŷ≈p, A=0) — empirical outcome rate given prediction
    actual_rate_a1: f64   // P(Y=1|Ŷ≈p, A=1)
) -> f64 with IO {
    let diff = actual_rate_a1 + (0.0 - actual_rate_a0)
    if diff < 0.0 { 0.0 - diff } else { diff }
}

// ============================================================
// Chouldechova impossibility theorem
// ============================================================

// chouldechova_tension: computes the inevitable fairness gap given base rate difference.
// When P(Y=1|A=0) ≠ P(Y=1|A=1), Chouldechova (2017) shows:
//   PPV_0 - PPV_1 = [ (1-FPR_0)/(1-P0) - (1-FPR_1)/(1-P1) ] × (proportion of positives)
//
// This function computes the minimum achievable unfairness given different base rates.
// Returns: the lower bound on any fairness gap that cannot be eliminated.
fn chouldechova_minimum_gap(
    base_rate_a0: f64,   // P(Y=1|A=0) — prevalence in group A=0
    base_rate_a1: f64,   // P(Y=1|A=1) — prevalence in group A=1
    threshold: f64       // classification threshold
) -> f64 with IO {
    // When base rates differ, some fairness metrics must differ.
    // Lower bound on |DP gap| given |base_rate_a0 - base_rate_a1|:
    // gap ≥ |base_rate_a0 - base_rate_a1| * (1 - threshold)
    let base_diff = base_rate_a1 + (0.0 - base_rate_a0)
    let abs_diff = if base_diff < 0.0 { 0.0 - base_diff } else { base_diff }
    abs_diff * (1.0 + (0.0 - threshold))
}

// ============================================================
// Individual fairness (Lipschitz condition)
// ============================================================

// individual_fairness_violation: |f(x) - f(x')| - L * d(x, x')
// A model satisfies individual fairness if this is ≤ 0 for all pairs (x, x').
// d(x, x') = task-specific metric (e.g., Mahalanobis distance in feature space).
fn individual_fairness_violation(
    score_x: f64,      // model output f(x)
    score_x_prime: f64, // model output f(x')
    lipschitz_const: f64, // L — Lipschitz constant
    distance_xx: f64   // d(x, x') — similarity metric
) -> f64 with IO {
    // Violation = |f(x) - f(x')| - L * d(x, x')
    // Negative means Lipschitz condition is satisfied (individually fair).
    let score_diff = score_x + (0.0 - score_x_prime)
    let abs_diff = if score_diff < 0.0 { 0.0 - score_diff } else { score_diff }
    abs_diff + (0.0 - (lipschitz_const * distance_xx))
}

// ============================================================
// Counterfactual fairness
// ============================================================

// counterfactual_fairness_check: verifies that changing protected attribute A
// does not change the prediction Ŷ.
// Kusner et al. (2017): Ŷ is counterfactually fair if Ŷ(A←a) = Ŷ(A←a') for all a, a'.
// In practice: the prediction must be invariant to interventions on A.
fn counterfactual_fairness_gap(
    score_with_a0: f64,   // f(x, A=0) — score under control treatment of A
    score_with_a1: f64    // f(x, A=1) — score under treatment of A
) -> f64 with IO {
    // Counterfactual fairness requires this gap = 0
    let diff = score_with_a1 + (0.0 - score_with_a0)
    if diff < 0.0 { 0.0 - diff } else { diff }
}

// ============================================================
// Fairness-accuracy tradeoff
// ============================================================

// fairness_accuracy_loss: the accuracy cost of enforcing a fairness constraint.
// Menon & Williamson (2018): fairness-constrained accuracy loss = L(fairness) - L(unconstrained).
// Returns the additive accuracy penalty from imposing the fairness constraint.
fn fairness_accuracy_loss(
    unconstrained_accuracy: f64,
    fair_accuracy: f64
) -> f64 with IO {
    unconstrained_accuracy + (0.0 - fair_accuracy)  // positive = accuracy penalty
}

// pareto_fairness_score: composite objective λ*accuracy + (1-λ)*fairness
// λ ∈ [0,1] trades off accuracy (λ→1) vs fairness (λ→0).
fn pareto_fairness_score(accuracy: f64, fairness_gap: f64, lambda: f64) -> f64 with IO {
    lambda * accuracy + (1.0 + (0.0 - lambda)) * (1.0 + (0.0 - fairness_gap))
}

// ============================================================
// Main: audit a hypothetical credit scoring model
// ============================================================

fn main() -> i64 with IO, Div, Panic {
    // Hypothetical credit model audit:
    // Group A=0 (majority): approval rate 0.65, TPR 0.80, FPR 0.15
    // Group A=1 (minority): approval rate 0.50, TPR 0.72, FPR 0.22
    let rate_a0: f64 = 0.65
    let rate_a1: f64 = 0.50

    // 1. Demographic parity audit
    let dp_gap = demographic_parity_gap(rate_a0, rate_a1)
    let dp_ratio = demographic_parity_ratio(rate_a0, rate_a1)

    // 2. Equalized odds audit
    let eo_gap = equalized_odds_gap(0.80, 0.72, 0.15, 0.22)
    let eop_gap = equal_opportunity_gap(0.80, 0.72)  // equal opportunity only

    // 3. Calibration audit
    let cal_gap = calibration_gap(0.63, 0.48)  // at predicted probability 0.6

    // 4. Chouldechova impossibility: base rates differ → some criterion must be violated
    let min_gap = chouldechova_minimum_gap(0.30, 0.20, 0.50)

    // 5. Individual fairness: two similar applicants (cosine similarity = 0.95)
    let if_violation = individual_fairness_violation(0.71, 0.65, 0.5, 0.05)

    // 6. Counterfactual fairness: only attribute changed is race/gender
    let cf_gap = counterfactual_fairness_gap(0.68, 0.52)  // large gap → not CF-fair

    // 7. Accuracy-fairness tradeoff (λ=0.7)
    let pareto = pareto_fairness_score(0.82, dp_gap, 0.7)

    42
}
