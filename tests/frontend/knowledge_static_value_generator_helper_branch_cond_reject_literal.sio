struct PatientStaticValueGeneratorHelperBranchCondRejectLiteral {
    age: i64,
}

fn choose_patient_static_value_helper_branch_cond_reject_literal(base: i64, delta: i64) -> i64 {
    if base + delta >= 18 {
        return 18
    } else {
        return 13
    }
}

fn make_patient_static_value_generator_helper_branch_cond_reject_literal() -> Knowledge<PatientStaticValueGeneratorHelperBranchCondRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperBranchCondRejectLiteral {
            age: choose_patient_static_value_helper_branch_cond_reject_literal(13, 4),
        }
    }
}

fn accept_patient_static_value_generator_helper_branch_cond_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorHelperBranchCondRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_branch_cond_reject_literal(make_patient_static_value_generator_helper_branch_cond_reject_literal())
}
