struct PatientStaticValueGeneratorBranchDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_branch_condition() -> bool {
    return true
}

fn make_patient_static_value_generator_branch_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorBranchDynamicGap> {
    if measured_patient_static_value_generator_branch_condition() {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchDynamicGap {
                age: 13,
            }
        }
    } else {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchDynamicGap {
                age: 18,
            }
        }
    }
}

fn accept_patient_static_value_generator_branch_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorBranchDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_dynamic_gap(make_patient_static_value_generator_branch_dynamic_gap())
}
