//@ run-pass
//@ description: f64<UnitExpr> accepts a derived dimension computed from unit-typed values.

fn takes_velocity(v: f64<m/s>) -> f64 {
    return v
}

fn takes_acceleration(a: f64<m/s/s>) -> f64 {
    return a
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 10.0
    let elapsed: s = 2.0
    let speed: f64<m/s> = distance / elapsed
    let again: f64<m/s> = takes_velocity(speed)
    let acceleration: f64<m/s/s> = again / elapsed
    let checked: f64<m/s/s> = takes_acceleration(acceleration)
    println("unit f64 unit expr: PASS")
    return 0
}
