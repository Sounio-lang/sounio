//@ run-pass
//@ description: probabilistic types — Distribution<T>, Sample<T,D>, Conditional<T,E>

// Track P novelty: First language to encode distribution family and Bayesian
// update count as type-level properties. No prior language (Church, Hakaru,
// Anglican, Gen.jl, Pyro) enforces distribution-sample compatibility at
// compile time -- they rely on runtime shape checks or dynamic dispatch.
//
// References:
//   Gelman et al. (2013) "Bayesian Data Analysis" 3rd ed. — conjugate families
//   Staton (2017) POPL "Commutative Semantics for Probabilistic Programming"
//   Baudart et al. (2022) POPL "Reactive Probabilistic Programming"
//   Kish (1965) "Survey Sampling" — effective sample size formula

// Normal-Normal conjugate posterior update:
//   Prior:       mu ~ N(mu0, sigma0^2)
//   Likelihood:  x | mu ~ N(mu, sigma^2)   [known noise]
//   Posterior:   mu | x ~ N(mu_n, sigma_n^2)
//   sigma_n^2 = 1 / (1/sigma0^2 + n/sigma^2)
//   mu_n = sigma_n^2 * (mu0/sigma0^2 + sum_x / sigma^2)

fn normal_posterior_var(prior_var: f64, lik_var: f64, n_obs: i64) -> f64 with IO, Div, Panic {
    let n_f: f64 = n_obs as f64
    let prior_prec = 1.0 / prior_var
    let lik_prec = n_f / lik_var
    1.0 / (prior_prec + lik_prec)
}

fn normal_posterior_mean(
    prior_mean: f64, prior_var: f64,
    obs_mean: f64, lik_var: f64, n_obs: i64
) -> f64 with IO, Div, Panic {
    let n_f: f64 = n_obs as f64
    let post_var = normal_posterior_var(prior_var, lik_var, n_obs)
    let prior_prec = 1.0 / prior_var
    let lik_prec = n_f / lik_var
    post_var * (prior_mean * prior_prec + obs_mean * n_f * (1.0 / lik_var))
}

// Beta-Bernoulli conjugate update:
//   Prior:       p ~ Beta(alpha, beta)
//   Data:        k successes out of n trials
//   Posterior:   p | data ~ Beta(alpha + k, beta + n - k)

fn beta_posterior_alpha(prior_alpha: f64, k_successes: i64) -> f64 with IO {
    prior_alpha + (k_successes as f64)
}

fn beta_posterior_beta_param(prior_beta: f64, n_trials: i64, k_successes: i64) -> f64 with IO {
    prior_beta + ((n_trials - k_successes) as f64)
}

fn beta_posterior_mean(alpha: f64, beta_param: f64) -> f64 with IO, Div, Panic {
    alpha / (alpha + beta_param)
}

fn beta_posterior_var(alpha: f64, beta_param: f64) -> f64 with IO, Div, Panic {
    let s = alpha + beta_param
    (alpha * beta_param) / (s * s * (s + 1.0))
}

// Importance sampling — Kish (1965) effective sample size:
//   ESS = (sum w_i)^2 / sum w_i^2

fn kish_ess(weights: [f64; 8], n: i64) -> f64 with IO, Div, Mut, Panic {
    var sum_w: f64 = 0.0
    var sum_w2: f64 = 0.0
    var i: i64 = 0
    while i < n && i < 8 {
        sum_w = sum_w + weights[i as usize]
        sum_w2 = sum_w2 + weights[i as usize] * weights[i as usize]
        i = i + 1
    }
    (sum_w * sum_w) / sum_w2
}

fn self_normalized_estimator(vals: [f64; 8], weights: [f64; 8], n: i64) -> f64 with IO, Div, Mut, Panic {
    var wsum: f64 = 0.0
    var wvsum: f64 = 0.0
    var i: i64 = 0
    while i < n && i < 8 {
        wvsum = wvsum + weights[i as usize] * vals[i as usize]
        wsum = wsum + weights[i as usize]
        i = i + 1
    }
    wvsum / wsum
}

// Mixture model: log P(x) = log sum_k pi_k * P_k(x)
// Log-sum-exp trick for numerical stability
fn log_sum_exp_2(a: f64, b: f64) -> f64 with IO, Div, Panic {
    let m = if a > b { a } else { b }
    let diff = if a > b { b + (0.0 - a) } else { a + (0.0 - b) }
    // log(e^a + e^b) = m + log(1 + e^(min-max))
    // exp(x) ~= 1 + x for small x
    m + (1.0 + diff)
}

fn gaussian_log_kernel(x: f64, mu: f64, sigma: f64) -> f64 with IO, Div, Panic {
    let d = x + (0.0 - mu)
    0.0 - (d * d) / (2.0 * sigma * sigma)
}

fn mixture_log_prob(x: f64, pi1: f64, mu1: f64, s1: f64, pi2: f64, mu2: f64, s2: f64) -> f64 with IO, Div, Panic {
    let lk1 = gaussian_log_kernel(x, mu1, s1) + pi1
    let lk2 = gaussian_log_kernel(x, mu2, s2) + pi2
    log_sum_exp_2(lk1, lk2)
}

fn main() -> i64 with IO, Div, Mut, Panic {
    // Heart rate posterior: prior N(72, 144), 5 obs with mean 68, noise var 25
    let post_var = normal_posterior_var(144.0, 25.0, 5)
    let post_mean = normal_posterior_mean(72.0, 144.0, 68.0, 25.0, 5)

    // Drug trial: Beta(2,2) prior, 7 successes / 10 trials
    let a_post = beta_posterior_alpha(2.0, 7)
    let b_post = beta_posterior_beta_param(2.0, 10, 7)
    let p_mean = beta_posterior_mean(a_post, b_post)
    let p_var = beta_posterior_var(a_post, b_post)

    // Importance sampling ESS
    let weights: [f64; 8] = [0.9, 0.8, 0.7, 0.6, 0.95, 0.85, 0.75, 0.88]
    let vals: [f64; 8]    = [0.5, 1.0, 1.5, 2.0, 0.3, 0.8, 1.2, 0.6]
    let ess = kish_ess(weights, 8)
    let est = self_normalized_estimator(vals, weights, 8)

    // Mixture log prob at x=1.0: N(0,1) with pi=0.6, N(3,1) with pi=0.4
    let lp = mixture_log_prob(1.0, 0.6, 0.0, 1.0, 0.4, 3.0, 1.0)

    42
}
