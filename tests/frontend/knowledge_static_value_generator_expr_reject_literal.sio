struct PatientStaticValueGeneratorExprRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_expr_reject_literal(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorExprRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorExprRejectLiteral {
            age: base + delta,
        }
    }
}

fn accept_patient_static_value_generator_expr_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorExprRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_expr_reject_literal(make_patient_static_value_generator_expr_reject_literal(13, 4))
}
