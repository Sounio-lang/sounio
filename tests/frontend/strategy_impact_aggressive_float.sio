//@ run-pass
//@ description: Sprint 39 — Aggressive strategy float chain benchmark
//@ note: operand_reordering_active=true (Validated<T> → IR_STRATEGY_AGGRESSIVE)

type M1 = Model<f64, f64>
models StrategyModels = [M1]
policy StrategyPolicy for f64 level Stable scope InDistribution {}
validation StrategyManifest for f64 {}

fn mixed_chain_aggressive(a: f64, b: f64, c: f64) -> Validated<f64> {
    let sum_ab: f64 = a + b
    let sum: f64 = sum_ab + c
    let prod_ab: f64 = a * b
    let prod: f64 = prod_ab * c
    let result: f64 = sum + prod

    let contested: Contest<f64, StrategyModels, StrategyPolicy> = contest [M1] on result
    let robust: Robust<f64, Stable, InDistribution> = prove_robust(contested, StrategyPolicy)
    validate_manifest(robust, StrategyManifest)
}

fn main() -> i64 {
    let v = mixed_chain_aggressive(1.5, 2.5, 3.5)
    let _sink = v
    0
}
