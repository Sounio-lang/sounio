//@ run-pass
//@ description: Sprint 49 — profile-guided inlining fixture

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn small_helper(x: i64) -> i64 { x + 1 }

fn hot_caller(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let y = small_helper(x)
    let c: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on y
    c
}

fn main() -> i64 {
    let _ = hot_caller(5)
    0
}
