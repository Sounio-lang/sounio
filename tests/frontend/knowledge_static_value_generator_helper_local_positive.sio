struct PatientStaticValueGeneratorHelperLocalPositive {
    age: i64,
}

fn add_patient_static_value_helper_local_positive(base: i64, delta: i64) -> i64 {
    let total = base + delta
    return total
}

fn make_patient_static_value_generator_helper_local_positive() -> Knowledge<PatientStaticValueGeneratorHelperLocalPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperLocalPositive {
            age: add_patient_static_value_helper_local_positive(17, 1),
        }
    }
}

fn accept_patient_static_value_generator_helper_local_positive(
    patient: Knowledge<PatientStaticValueGeneratorHelperLocalPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_local_positive(make_patient_static_value_generator_helper_local_positive())
}
