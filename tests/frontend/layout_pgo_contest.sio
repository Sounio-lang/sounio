//@ run-pass
//@ description: Sprint 50 — profile-guided function layout fixture

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn cold_helper(x: i64) -> i64 { x + 1 }

fn hot_inner(x: i64) -> i64 { x * 3 }

fn hot_caller(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let y = hot_inner(x)
    let z = cold_helper(y)
    let c: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on z
    c
}

fn main() -> i64 {
    let _ = hot_caller(5)
    0
}
