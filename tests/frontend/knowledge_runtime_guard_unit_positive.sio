struct DoseRuntimeGuardUnitPositive {
    amount: mg,
}

fn measured_runtime_guard_unit_positive_amount() -> mg {
    return 750.0
}

fn make_dose_runtime_guard_unit_positive() -> Knowledge<DoseRuntimeGuardUnitPositive where {
    amount >= 500 <mg>
}> with Panic {
    return Knowledge {
        value: DoseRuntimeGuardUnitPositive {
            amount: measured_runtime_guard_unit_positive_amount(),
        }
    }
}

fn main() -> i32 with Panic {
    let dose: Knowledge<DoseRuntimeGuardUnitPositive where {
        amount >= 500 <mg>
    }> = make_dose_runtime_guard_unit_positive()
    return 0
}
