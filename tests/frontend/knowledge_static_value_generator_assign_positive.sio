struct PatientStaticValueGeneratorAssignPositive {
    age: i64,
}

fn make_patient_static_value_generator_assign_positive(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorAssignPositive> {
    var age = base
    age = age + delta
    return Knowledge {
        value: PatientStaticValueGeneratorAssignPositive {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_assign_positive(
    patient: Knowledge<PatientStaticValueGeneratorAssignPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_assign_positive(make_patient_static_value_generator_assign_positive(17, 1))
}
