// Sprint 21: set-valued alternatives from Deferred<T> through named recourse policies.

type M1 = Model<i64, i64>
models DefaultModels = [M1]

policy DefaultPolicy for i64 level Stable scope InDistribution {
    require max_tail_risk < 0.10
}

deferral_policy ReviewPolicy for i64 route pharmacy_review {
    require max_tail_risk >= 0.05
}

recourse_policy ConservativeFallback for i64 strategy dose_reduction route pharmacy_review {
    require deferred_reason == TailRisk
    require max_tail_risk >= 0.05
}

recourse_policy TemporaryHold for i64 strategy temporary_hold route nephrology_review {
    require deferred_reason == TailRisk
    require max_tail_risk >= 0.05
}

alternative_policy DoseFrontier for i64 frontier Pareto {
    objective minimize intervention_cost
    objective minimize residual_tail_risk
    objective minimize mechanistic_divergence
    objective maximize admissibility_margin
    max_options 8
}

audit ReviewAudit for Contest<i64, DefaultModels, DefaultPolicy> {
    metrics {
        max_tail_risk: 0.08
    }
}

alternative_frontier DoseDeferredFrontier for Deferred<i64> under DoseFrontier {
    candidate Reduce10 via ConservativeFallback {
        value: 45
        metrics {
            intervention_cost: 0.10
            residual_tail_risk: 0.04
            mechanistic_divergence: 0.08
            admissibility_margin: 0.12
        }
    }

    candidate HoldDose via TemporaryHold {
        value: 0
        metrics {
            intervention_cost: 0.30
            residual_tail_risk: 0.01
            mechanistic_divergence: 0.03
            admissibility_margin: 0.18
        }
    }
}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<i64, DefaultModels, DefaultPolicy> = (contest [M1] on d) audit ReviewAudit
    let deferred: Deferred<i64> = defer_action(d, c, ReviewPolicy)
    let set: AlternativeSet<i64> = propose_alternatives(d, deferred, DoseDeferredFrontier)
    let n = alternative_count(set)
    let opt: AlternativeOption<i64> = alternative_option(set, 0)
    let reason = alternative_reason(opt)
    0
}
