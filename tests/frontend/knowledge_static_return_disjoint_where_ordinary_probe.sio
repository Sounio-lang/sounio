ontology KnowledgeStaticReturnDisjointWhereProbe {
    class Entity
    class Diabetes subclass_of Entity
    class Asthma subclass_of Entity
    disjoint Asthma, Diabetes
}

struct PatientReturnDisjointWhereProbe {
    dx: Asthma
}

fn reject_return_disjoint_where_probe(
    p: Knowledge<PatientReturnDisjointWhereProbe>
) -> Knowledge<PatientReturnDisjointWhereProbe where { dx subclass_of Diabetes }> {
    return p
}

fn main() -> i32 {
    0
}
