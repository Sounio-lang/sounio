struct PatientStaticValueGeneratorArgRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_arg_reject_literal(age: i64) -> Knowledge<PatientStaticValueGeneratorArgRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorArgRejectLiteral {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_arg_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorArgRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_arg_reject_literal(make_patient_static_value_generator_arg_reject_literal(13))
}
