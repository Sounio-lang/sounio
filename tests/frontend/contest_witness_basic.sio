// Full audit-backed contest witness surface fixture.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

audit DefaultAudit for Contest<i64, DefaultModels, DefaultPolicy> {
    metrics {
        sign_consensus: 1.0
        relative_band: 0.10
        max_tail_risk: 0.02
        identifiability_floor: 0.80
    }

    mechanistic {
        aggregate_divergence: 0.18
        latent_state_divergence: 0.12
        causal_decomposition_divergence: 0.20
        intervention_response_divergence: 0.21
        parameter_role_divergence: 0.09
        structural_explanation_distance: 0.17
    }

    counterexample {
        model_name: M1
        subgroup_name: baseline
        metric_name: exposure
        observed_value: 0.24
        threshold_value: 0.20
        summary: "baseline exposure counterexample"
    }

    posterior_weights {
        M1: 1.0
    }
}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<i64, DefaultModels, DefaultPolicy> = (contest [M1] on d) audit DefaultAudit
    let s: f64 = sign_consensus(c)
    let b: f64 = relative_band(c)
    let t: f64 = max_tail_risk(c)
    let m: f64 = mechanistic_divergence(c)
    let i: f64 = identifiability_floor(c)
    let dg = disagreement(c)
    let cx = counterexample(c)
    let pw = posterior_weights(c)
    0
}
