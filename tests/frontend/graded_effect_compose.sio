//@ run-pass
//@ description: graded effect composition — quadrature for epistemic, additive for aleatoric

fn sqrt_approx(x: f64) -> f64 with Div, Mut, Panic {
    if x <= 0.0 {
        0.0
    } else {
        var est: f64 = x
        var i: i64 = 0
        while i < 10 {
            est = (est + x / est) / 2.0
            i = i + 1
        }
        est
    }
}

// Epistemic grade composition: sqrt(ε1² + ε2²) — quadrature
fn epistemic_compose(eps1: f64, eps2: f64) -> f64 with Div, Mut, Panic {
    let sum_sq = eps1 * eps1 + eps2 * eps2
    sqrt_approx(sum_sq)
}

// Aleatoric grade composition: ε1 + ε2 — additive
fn aleatoric_compose(eps1: f64, eps2: f64) -> f64 {
    eps1 + eps2
}

fn main() -> i64 with IO, Div, Mut, Panic {
    let eps_model: f64 = 0.03      // epistemic: parameter estimation
    let eps_sensor: f64 = 0.05     // aleatoric: sensor noise

    // Epistemic ∘ Epistemic = quadrature
    let eps_ee = epistemic_compose(eps_model, eps_model)

    // Aleatoric ∘ Aleatoric = additive (irreducible)
    let eps_aa = aleatoric_compose(eps_sensor, eps_sensor)

    42
}
