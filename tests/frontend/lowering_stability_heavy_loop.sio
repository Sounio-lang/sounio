//@ run-pass
//@ description: Sprint 70 — heavier loop-bearing staged lowering stability fixture

fn bump(x: i64) -> i64 {
    x + 1
}

fn bias(x: i64) -> i64 {
    let base = 2 + 3
    x + base
}

fn main() -> i64 {
    var acc: i64 = 0
    var outer: i64 = 0
    while outer < 3 {
        var inner: i64 = 0
        let bonus = 1 + 2
        while inner < 2 {
            let widened = outer + bonus
            acc = acc + widened + inner
            inner = inner + 1
        }
        outer = outer + 1
    }
    acc
}
