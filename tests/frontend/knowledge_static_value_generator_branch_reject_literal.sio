struct PatientStaticValueGeneratorBranchRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_branch_reject_literal() -> Knowledge<PatientStaticValueGeneratorBranchRejectLiteral> {
    if false {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchRejectLiteral {
                age: 18,
            }
        }
    } else {
        return Knowledge {
            value: PatientStaticValueGeneratorBranchRejectLiteral {
                age: 13,
            }
        }
    }
}

fn accept_patient_static_value_generator_branch_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorBranchRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_reject_literal(make_patient_static_value_generator_branch_reject_literal())
}
