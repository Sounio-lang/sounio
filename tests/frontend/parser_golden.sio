// Sprint 1 parser golden smoke.
// Parser currently has instability on richer inputs; keep this lane deterministic
// with a minimal real parse invocation over a canonical EOF token stream.

use lexer::{Token, TokenKind}
use parser::{parse, Expr, ExprKind, expr_to_string}

fn eof_token() -> Token {
    Token {
        kind: TokenKind::Eof,
        text: "",
        line: 1,
        column: 1,
    }
}

fn eof_token_array() -> [Token; 4096] {
    [eof_token(); 4096]
}

fn assert_block_and_render(ast: Expr) -> bool with Mut, Panic, Div {
    if ast.kind != ExprKind::Block {
        println("FAIL: expected parser root kind Block")
        return false
    }

    let rendered = expr_to_string(ast)
    if rendered == "" {
        println("FAIL: expr_to_string should not be empty")
        return false
    }

    true
}

fn test_parse_zero_len_input() -> bool with Mut, Panic, Div {
    let tokens = eof_token_array()
    let ast = parse(tokens, 0)
    assert_block_and_render(ast)
}

fn test_parse_single_eof() -> bool with Mut, Panic, Div {
    var tokens = eof_token_array()
    tokens[0] = eof_token()

    let ast = parse(tokens, 1)
    assert_block_and_render(ast)
}

fn test_parse_double_eof() -> bool with Mut, Panic, Div {
    var tokens: [Token; 4096] = [eof_token(); 4096]
    tokens[0] = eof_token()
    tokens[1] = eof_token()

    let ast = parse(tokens, 2)
    if !assert_block_and_render(ast) {
        return false
    }

    // Regression check: repeated calls over canonical EOF streams stay stable.
    let ast2 = parse(tokens, 2)
    if !assert_block_and_render(ast2) {
        return false
    }

    true
}

fn main() -> i32 with Mut, Panic, Div {
    println("=== Sprint 1: Parser Golden Smoke ===")

    var passed: i64 = 0
    var total: i64 = 0

    print("Running test_parse_zero_len_input... ")
    total = total + 1
    if test_parse_zero_len_input() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
    }

    print("Running test_parse_single_eof... ")
    total = total + 1
    if test_parse_single_eof() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
    }

    print("Running test_parse_double_eof... ")
    total = total + 1
    if test_parse_double_eof() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
    }

    if passed == total {
        return 0
    }

    1
}
