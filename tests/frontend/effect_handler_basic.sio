//@ run-pass
//@ description: basic effect annotation on function — row-poly effects foundation

fn pure_id(x: i64) -> i64 {
    x
}

fn with_io(x: i64) -> i64 with IO {
    pure_id(x)
}

fn with_io_mut(x: i64) -> i64 with IO, Mut {
    with_io(x)
}

fn main() -> i64 with IO, Mut {
    with_io_mut(42)
}
