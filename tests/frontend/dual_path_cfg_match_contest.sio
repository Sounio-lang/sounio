// Sprint 38: StrategyInstrumented full-CFG fixture with match/switch lowering.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn contest_match_branch(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let datum = match x {
        0 => 1
        1 => x + 2
        _ => x + 3
    }
    let contested: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on datum
    contested
}

fn main() -> i64 {
    let _ = contest_match_branch(1)
    0
}
