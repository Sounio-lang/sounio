struct PatientRuntimeGuardAssignPositive {
    age: i64,
}

fn measured_runtime_guard_assign_positive_age() -> i64 {
    return 21
}

fn main() -> i32 with Panic {
    var patient: Knowledge<PatientRuntimeGuardAssignPositive where { age >= 18 }> = Knowledge {
        value: PatientRuntimeGuardAssignPositive {
            age: 45,
        }
    }
    patient = Knowledge {
        value: PatientRuntimeGuardAssignPositive {
            age: measured_runtime_guard_assign_positive_age(),
        }
    }
    return 0
}
