//@ run-pass
//@ description: Sprint 44 — IrProfCounter injection in instrumented slow path
//@ note: IR_STRATEGY_INSTRUMENTED functions get IrProfCounter at slow-path entry; fast path has none
// profiling_counter: present in instrumented path only
// Sprint 44 emits a 7-byte NOP placeholder; Sprint 45 backfills with ADD [counter], 1

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn measured_fn(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let datum = x + 1
    let contested: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on datum
    contested
}

fn main() -> i64 {
    let _ = measured_fn(10)
    0
}
