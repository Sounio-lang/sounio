//@ run-pass
//@ description: Sprint 40 — native dual-path dispatch for Contest<T> if/else CFG
//@ note: IR_STRATEGY_INSTRUMENTED (3) triggers ir_opt_apply_strategy()

// ir_opt_apply_strategy() transforms the flat IrFunction into a four_block_diamond:
//   dispatch_block:      IrBranchTrue(__validated, fast_label) + IrJump(instr_label)
//   fast_path:           original if/else instrs → IrJump(merge_label)
//   instrumented_path:   cloned instrs (vreg_offset + label_offset) → IrJump(merge_label)
//   merge_block:         IrLabel(merge_label) + IrReturn
//
// vreg_offset:  ir_opt_max_vreg(func) + 1   (instrumented locals above original)
// label_offset: ir_opt_max_label(func) + 1  (instrumented labels above original)
// dispatch_label = label_offset
// instr_label    = label_offset + 1
// merge_label    = label_offset + 2
//
// dual_path_structure: four_block_diamond
// strategy_constant: IR_STRATEGY_INSTRUMENTED = 3

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn disputed_if(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let datum = if x > 0 {
        x + 1
    } else {
        0 - x
    }
    let contested: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on datum
    contested
}

fn main() -> i64 {
    let _ = disputed_if(4)
    0
}
