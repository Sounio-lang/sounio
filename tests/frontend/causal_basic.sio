//@ run-pass
//@ description: basic causal type — simple DAG with directed edge

fn estimate_drug_effect(dose_mg: f64, outcome_score: f64) -> f64 with IO, Div {
    // Simple linear estimate: ATE = E[Y|do(X=1)] - E[Y|do(X=0)]
    let control_mean: f64 = 5.0
    let treatment_mean: f64 = 8.0
    treatment_mean + (0.0 - control_mean)
}

fn main() -> i64 with IO, Div {
    let ate = estimate_drug_effect(100.0, 8.5)
    42
}
