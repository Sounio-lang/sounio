struct PatientRuntimeGuardPositive {
    age: i64,
}

fn measured_runtime_guard_positive_age() -> i64 {
    return 21
}

fn make_patient_runtime_guard_positive() -> Knowledge<PatientRuntimeGuardPositive where { age >= 18 }> with Panic {
    return Knowledge {
        value: PatientRuntimeGuardPositive {
            age: measured_runtime_guard_positive_age(),
        }
    }
}

fn main() -> i32 with Panic {
    let patient: Knowledge<PatientRuntimeGuardPositive where { age >= 18 }> = make_patient_runtime_guard_positive()
    return 0
}
