//@ run-pass
//@ description: simple X -> Y with no backdoor paths — trivially identifiable

// Causal DAG: X -> Y (single directed edge, no confounders).
// With no backdoor paths, P(Y|do(X)) = P(Y|X) and the causal
// effect is trivially identifiable from observational data.

fn estimate_direct_effect(x: f64, y: f64) -> f64 with IO {
    // No confounders: simple regression identifies causal effect
    y + (0.0 - x)
}

fn main() -> i64 with IO {
    let effect = estimate_direct_effect(1.0, 3.5)
    42
}
