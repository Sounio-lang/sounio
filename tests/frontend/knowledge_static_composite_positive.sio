ontology KnowledgeStaticCompositePositive {
    class Entity
    class MetabolicDisease subclass_of Entity
    class Diabetes subclass_of MetabolicDisease
    class Type2Diabetes subclass_of Diabetes
}

unit acceleration = m / s / s;

struct PatientCompositePositive {
    dx: Type2Diabetes,
    accel: acceleration,
    age: { v: i64 | v >= 18 },
}

fn accept_composite_patient(
    p: Knowledge<PatientCompositePositive where {
        dx subclass_of Diabetes,
        accel >= 1.0 <acceleration>,
        age >= 18
    }>
) -> i32 {
    return 1
}
