struct PatientStaticValueCallRejectLiteral {
    age: i64,
}

fn accept_patient_static_value_call_reject_literal(
    patient: Knowledge<PatientStaticValueCallRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_call_reject_literal(Knowledge {
        value: PatientStaticValueCallRejectLiteral {
            age: 13,
        }
    })
}
