unit acceleration = m / s / s;

struct MotionStaticValueUnitDynamicGap {
    accel: acceleration,
}

fn measured_accel() -> acceleration {
    return 0.5
}

fn make_motion_static_value_unit_dynamic_gap() -> Knowledge<MotionStaticValueUnitDynamicGap where { accel >= 1.0 <acceleration> }> {
    return Knowledge {
        value: MotionStaticValueUnitDynamicGap {
            accel: measured_accel(),
        }
    }
}

fn main() -> i32 {
    return 0
}
