struct PatientStaticValueGeneratorHelperDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_helper_delta() -> i64 {
    return 4
}

fn add_patient_static_value_helper_dynamic_gap(base: i64, delta: i64) -> i64 {
    return base + delta
}

fn make_patient_static_value_generator_helper_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorHelperDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperDynamicGap {
            age: add_patient_static_value_helper_dynamic_gap(13, measured_patient_static_value_generator_helper_delta()),
        }
    }
}

fn accept_patient_static_value_generator_helper_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorHelperDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_dynamic_gap(make_patient_static_value_generator_helper_dynamic_gap())
}
