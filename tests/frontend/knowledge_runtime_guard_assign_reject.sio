struct PatientRuntimeGuardAssignReject {
    age: i64,
}

fn measured_runtime_guard_assign_reject_age() -> i64 {
    return 13
}

fn main() -> i32 with Panic {
    var patient: Knowledge<PatientRuntimeGuardAssignReject where { age >= 18 }> = Knowledge {
        value: PatientRuntimeGuardAssignReject {
            age: 45,
        }
    }
    patient = Knowledge {
        value: PatientRuntimeGuardAssignReject {
            age: measured_runtime_guard_assign_reject_age(),
        }
    }
    return 0
}
