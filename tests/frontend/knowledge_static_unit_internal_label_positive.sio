unit mg_dL;
unit mmol_L;
unit U_L;
unit mm_h;

struct LabReadingInternalLabelPositive {
    glucose: mg_dL,
    potassium: mmol_L,
    alt: U_L,
    esr: mm_h,
}

fn accept_internal_labels(
    reading: Knowledge<LabReadingInternalLabelPositive where {
        glucose >= 126.0 <mg_dL>,
        potassium >= 3.5 <mmol_L>,
        alt >= 1.0 <U_L>,
        esr >= 1.0 <mm_h>
    }>
) -> i32 {
    1
}

fn main() -> i64 {
    0
}
