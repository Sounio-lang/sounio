struct PatientStaticValueGeneratorNestedHelperPositive {
    age: i64,
}

fn inner_patient_static_value_nested_helper_positive(base: i64, delta: i64) -> i64 {
    if base + delta >= 18 {
        return 18
    } else {
        return 13
    }
}

fn outer_patient_static_value_nested_helper_positive(seed: i64) -> i64 {
    return inner_patient_static_value_nested_helper_positive(seed, 1)
}

fn make_patient_static_value_generator_nested_helper_positive() -> Knowledge<PatientStaticValueGeneratorNestedHelperPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorNestedHelperPositive {
            age: outer_patient_static_value_nested_helper_positive(17),
        }
    }
}

fn accept_patient_static_value_generator_nested_helper_positive(
    patient: Knowledge<PatientStaticValueGeneratorNestedHelperPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_nested_helper_positive(make_patient_static_value_generator_nested_helper_positive())
}
