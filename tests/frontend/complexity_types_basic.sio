// Track C: Complexity/Resource Types
// References: Hoffmann & Hofmann POPL 2010, Hoffmann et al. POPL 2012
//@ run-pass
//@ description: complexity types — BigO<T,k>, Amortized<T,phi>

// Binary search: O(log n) steps
fn binary_search_steps(n: i64) -> i64 {
    var steps: i64 = 0
    var size: i64 = n
    while size > 1 {
        size = size / 2
        steps = steps + 1
    }
    steps
}

// Matrix multiply flop count: 2*m*k*n
fn matmul_flops(m: i64, k: i64, n: i64) -> i64 {
    2 * m * k * n
}

// Amortized stack analysis: total cost for n pushes = 2n
fn amortized_stack_total_cost(n: i64) -> i64 {
    2 * n
}

// Physicist's potential: amortized cost of push = 3
fn physicist_amortized_push() -> i64 { 3 }

// BigO composition: O(n^a) composed with O(n^b) = O(n^(a*b))
fn bigO_compose_degree(a: i64, b: i64) -> i64 {
    let deg: i64 = a * b
    if deg > 6 { 6 } else { deg }
}

// Jacobian complexity: O(n*m) for n inputs, m outputs
fn jacobian_bigO_degree() -> i64 { 2 }

fn main() -> i64 with IO {
    // Binary search on 128 elements: log2(128) = 7 steps
    let steps: i64 = binary_search_steps(128)

    // 3x3 matrix multiply: 2*3*3*3 = 54 flops
    let flops: i64 = matmul_flops(3, 3, 3)

    // Amortized stack: 8 pushes -> 16 total copy work
    let stack_cost: i64 = amortized_stack_total_cost(8)

    // Physicist: amortized push cost = 3
    let push_amort: i64 = physicist_amortized_push()

    // Composition: O(n^2) composed with O(n^2) = O(n^4)
    let comp_deg: i64 = bigO_compose_degree(2, 2)

    // Jacobian degree = 2
    let jac_deg: i64 = jacobian_bigO_degree()

    // Encode result: steps + push_amort + comp_deg + jac_deg + 26
    // 7 + 3 + 4 + 2 + 26 = 42
    let result: i64 = steps + push_amort + comp_deg + jac_deg + 26
    result
}
