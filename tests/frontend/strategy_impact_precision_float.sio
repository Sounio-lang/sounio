//@ run-pass
//@ description: Sprint 39 — PrecisionPreserving strategy float chain benchmark
//@ note: operand_reordering_active=false (Knowledge<T> → IR_STRATEGY_PRECISION_PRESERVING)

fn mixed_chain_precision(a: f64, b: f64, c: f64) -> Knowledge<f64> with IO {
    let sum_ab: f64 = a + b
    let sum: f64 = sum_ab + c
    let prod_ab: f64 = a * b
    let prod: f64 = prod_ab * c
    let result: f64 = sum + prod
    measure(result, uncertainty: 0.05)
}

fn main() -> i64 with IO {
    let k = mixed_chain_precision(1.5, 2.5, 3.5)
    let _sink = k
    0
}
