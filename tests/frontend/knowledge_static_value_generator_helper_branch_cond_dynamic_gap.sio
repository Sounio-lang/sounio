struct PatientStaticValueGeneratorHelperBranchCondDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_helper_branch_cond_delta() -> i64 {
    return 1
}

fn choose_patient_static_value_helper_branch_cond_dynamic_gap(base: i64, delta: i64) -> i64 {
    if base + delta >= 18 {
        return 13
    } else {
        return 18
    }
}

fn make_patient_static_value_generator_helper_branch_cond_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorHelperBranchCondDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperBranchCondDynamicGap {
            age: choose_patient_static_value_helper_branch_cond_dynamic_gap(17, measured_patient_static_value_generator_helper_branch_cond_delta()),
        }
    }
}

fn accept_patient_static_value_generator_helper_branch_cond_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorHelperBranchCondDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_branch_cond_dynamic_gap(make_patient_static_value_generator_helper_branch_cond_dynamic_gap())
}
