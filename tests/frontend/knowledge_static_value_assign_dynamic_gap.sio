struct PatientStaticValueAssignDynamicGap {
    age: i64,
}

fn measured_age() -> i64 {
    return 13
}

fn main() -> i32 {
    var patient: Knowledge<PatientStaticValueAssignDynamicGap where { age >= 18 }> = Knowledge {
        value: PatientStaticValueAssignDynamicGap {
            age: 45,
        }
    }
    patient = Knowledge {
        value: PatientStaticValueAssignDynamicGap {
            age: measured_age(),
        }
    }
    return 0
}
