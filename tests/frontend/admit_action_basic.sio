// Sprint 16: decision admissibility runtime fixture — first-slice surface.
// Ordinary `./souc check` should succeed through the wrapper-backed epistemic lane.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}
decision_policy DefaultDecisionPolicy for i64 {}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on d
    let r: Robust<i64, Stable, InDistribution> = prove_robust(c, DefaultPolicy)
    let a: Admissible<i64> = admit_action(d, r, DefaultDecisionPolicy)
    0
}
