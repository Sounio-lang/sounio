struct PatientStaticValueGeneratorBranchFlowPositive {
    age: i64,
}

fn make_patient_static_value_generator_branch_flow_positive() -> Knowledge<PatientStaticValueGeneratorBranchFlowPositive> {
    var age = 13
    if true {
        age += 5
    } else {
        age += 0
    }
    return Knowledge {
        value: PatientStaticValueGeneratorBranchFlowPositive {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_branch_flow_positive(
    patient: Knowledge<PatientStaticValueGeneratorBranchFlowPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_flow_positive(make_patient_static_value_generator_branch_flow_positive())
}
