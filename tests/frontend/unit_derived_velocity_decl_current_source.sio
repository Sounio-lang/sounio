//@ current-source-run-pass
//@ expect-stdout: unit derived velocity: PASS

unit velocity = m / s;

fn takes_velocity(v: velocity) -> f64 with Mut {
    v
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 10.0
    let time: s = 2.0
    let speed = distance / time
    let checked = takes_velocity(speed)
    if checked == 5.0 {
        print("unit derived velocity: PASS\n")
    }
    return 0
}
