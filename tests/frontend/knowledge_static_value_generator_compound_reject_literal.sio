struct PatientStaticValueGeneratorCompoundRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_compound_reject_literal(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorCompoundRejectLiteral> {
    var age = base
    age += delta
    return Knowledge {
        value: PatientStaticValueGeneratorCompoundRejectLiteral {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_compound_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorCompoundRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_compound_reject_literal(make_patient_static_value_generator_compound_reject_literal(13, 4))
}
