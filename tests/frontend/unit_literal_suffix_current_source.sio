//@ current-source-run-pass
//@ expect-stdout: unit literal suffix: PASS

fn takes_mg(dose: mg) -> f64 with Mut {
    dose
}

fn takes_mg_int(dose: mg) -> i64 with Mut {
    dose
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let base = 200.0<mg>
    let extra = 300.0<mg>
    let whole = 300<mg>
    let total = base + extra
    let checked = takes_mg(total)
    let checked_i = takes_mg_int(whole)
    if checked == 500.0 && checked_i == 300 {
        print("unit literal suffix: PASS\n")
    }
    return 0
}
