// Adapted from the verified local-model candidate: force differing head indices.
struct ExprList { label: i64, head: i64, tail: i64 }
struct Cell { head: i64, tail: Option<Box<Cell>> }
struct Holder { cell: Option<Box<Cell>> }

fn read_holder(h: Holder) -> i64 with Mut, Panic, Div, Alloc {
    match h.cell {
        Some(node) => (*node).head,
        None => -1,
    }
}

fn read_field_alias(h: Holder) -> i64 with Mut, Panic, Div, Alloc {
    let cell = h.cell
    let cell = cell
    match cell {
        Some(node) => (*node).head,
        None => -1,
    }
}

fn main() -> i64 with Mut, Panic, Div, Alloc {
    let holder = Holder { cell: Some(Box::new(Cell { head: 42, tail: None })) }
    if read_holder(holder) != 42 { return 1 }
    if read_field_alias(holder) != 42 { return 2 }
    let empty = Holder { cell: None }
    if read_holder(empty) != -1 { return 3 }
    if read_field_alias(empty) != -1 { return 4 }
    0
}
