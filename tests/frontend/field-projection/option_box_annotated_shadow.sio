// Expected exit 0: annotated Option and Some's same-name binder retain Cell layout.
struct ExprList { label: i64, head: i64, tail: i64 }
struct Cell { head: i64, tail: Option<Box<Cell>> }
fn main() -> i32 with Panic {
    let node = Box::new(Cell { head: 42, tail: None })
    let current: Option<Box<Cell>> = Some(node)
    let answer = match current { Some(current) => (*current).head, None => 0, }
    if answer != 42 { return 1 }
    return 0
}
