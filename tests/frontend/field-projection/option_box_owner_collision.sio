// Expected native exit 0; field owners must survive Some binding.
struct ExprList { label: i64, head: i64, tail: i64 }
struct Cell { head: i64, tail: Option<Box<Cell>> }
fn head_of(current: Option<Box<Cell>>) -> i64 with Panic {
    match current { Some(node) => (*node).head, None => 0, }
}
fn main() -> i32 with Panic {
    let cell = Box::new(Cell { head: 42, tail: None })
    if head_of(Some(cell)) != 42 { return 1 }
    return 0
}
