// Expected exit 0: Option<Box<Cell>> return retains the payload owner.
struct Decoy { pad: i64, head: i64 }
struct Cell { head: i64, tail: i64 }
fn make() -> Option<Box<Cell>> with Panic {
    return Some(Box::new(Cell { head: 42, tail: 7 }))
}
fn main() -> i32 with Panic {
    let result = make()
    match result {
        Some(node) => { if (*node).head != 42 { return 1 } }
        None => return 2,
    }
    match make() {
        Some(node) => { if (*node).head != 42 { return 3 } }
        None => return 4,
    }
    return 0
}
