// Expected exit 0: matching a referenced Option preserves its payload owner.
struct Decoy { pad: i64, head: i64 }
struct Cell { head: i64, tail: i64 }
fn read(current: &Option<Box<Cell>>) -> i64 with Panic {
    match *current { Some(node) => (*node).head, None => 0, }
}
fn main() -> i32 with Panic {
    let value: Option<Box<Cell>> = Some(Box::new(Cell { head: 42, tail: 7 }))
    if read(&value) != 42 { return 1 }
    return 0
}
