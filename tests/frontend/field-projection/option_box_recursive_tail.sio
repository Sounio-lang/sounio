// Expected native exit 0: tail must resolve against Cell, not ExprList.
struct ExprList { label: i64, head: i64, tail: i64 }
struct Cell { head: i64, tail: Option<Box<Cell>> }
fn sum(current: Option<Box<Cell>>) -> i64 with Panic {
    match current { Some(node) => (*node).head + sum((*node).tail), None => 0, }
}
fn main() -> i32 with Panic {
    let tail = Box::new(Cell { head: 7, tail: None })
    let head = Box::new(Cell { head: 42, tail: Some(tail) })
    if sum(Some(head)) != 49 { return 1 }
    return 0
}
