// Expected exit 0: inferred dereference keeps the Box field's inner owner.
struct Decoy { pad: i64, path: i64 }
struct Value { path: i64, tail: i64 }
struct Info { pad: i64, inner: Box<Value> }
struct Holder { info: Option<Box<Info>> }
fn read(h: Holder) -> i64 with Panic {
    match h.info {
        Some(info) => {
            let value = *(*info).inner
            value.path
        }
        None => 0,
    }
}
fn main() -> i32 with Panic {
    let h = Holder { info: Some(Box::new(Info { pad: 7, inner: Box::new(Value { path: 42, tail: 0 }) })) }
    if read(h) != 42 { return 1 }
    return 0
}
