// Expected exit 0: same-name alias reads payload metadata before rebinding.
struct ExprList { label: i64, head: i64, tail: i64 }
struct Cell { head: i64, tail: Option<Box<Cell>> }
fn read(current: Option<Box<Cell>>) -> i64 with Panic {
    let current = current
    match current { Some(node) => (*node).head, None => 0, }
}
fn main() -> i32 with Panic {
    let node = Box::new(Cell { head: 42, tail: None })
    if read(Some(node)) != 42 { return 1 }
    return 0
}
