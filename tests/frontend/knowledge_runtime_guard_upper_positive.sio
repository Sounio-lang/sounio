struct ScoreRuntimeGuardUpperPositive {
    score: i64,
}

fn measured_runtime_guard_upper_positive_score() -> i64 {
    return 88
}

fn make_score_runtime_guard_upper_positive() -> Knowledge<ScoreRuntimeGuardUpperPositive where {
    score <= 100
}> with Panic {
    return Knowledge {
        value: ScoreRuntimeGuardUpperPositive {
            score: measured_runtime_guard_upper_positive_score(),
        }
    }
}

fn main() -> i32 with Panic {
    let score: Knowledge<ScoreRuntimeGuardUpperPositive where {
        score <= 100
    }> = make_score_runtime_guard_upper_positive()
    return 0
}
