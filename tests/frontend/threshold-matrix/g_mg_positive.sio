// Expected native runtime exit: 0; must emit a runtime guard.
struct ThresholdWitness { amount: g, }
fn measured_threshold_witness() -> g { return 0.75 }
fn make_threshold_witness() -> Knowledge<ThresholdWitness where { amount >= 500 <mg> }> with Panic {
    return Knowledge { value: ThresholdWitness { amount: measured_threshold_witness(), } }
}
fn main() -> i32 with Panic {
    let value: Knowledge<ThresholdWitness where { amount >= 500 <mg> }> = make_threshold_witness()
    return 0
}
