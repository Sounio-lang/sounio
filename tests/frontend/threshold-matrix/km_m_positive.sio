struct ThresholdWitness { amount: km, }
fn measured_threshold_witness() -> km { return 1.5 }
fn make_threshold_witness() -> Knowledge<ThresholdWitness where { amount >= 1000 <m> }> with Panic {
    return Knowledge { value: ThresholdWitness { amount: measured_threshold_witness(), } }
}
fn main() -> i32 with Panic {
    let value: Knowledge<ThresholdWitness where { amount >= 1000 <m> }> = make_threshold_witness()
    return 0
}
