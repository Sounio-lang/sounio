// Expected native runtime exit: 1; must emit a runtime guard.
struct ThresholdWitness { amount: f64, }
fn measured_threshold_witness() -> f64 { return 0.25 }
fn make_threshold_witness() -> Knowledge<ThresholdWitness where { amount >= 0.5 }> with Panic {
    return Knowledge { value: ThresholdWitness { amount: measured_threshold_witness(), } }
}
fn main() -> i32 with Panic {
    let value: Knowledge<ThresholdWitness where { amount >= 0.5 }> = make_threshold_witness()
    return 0
}
