struct ThresholdWitness { amount: m, }
fn measured_threshold_witness() -> m { return 1000.0 }
fn make_threshold_witness() -> Knowledge<ThresholdWitness where { amount >= 1 <km> }> with Panic {
    return Knowledge { value: ThresholdWitness { amount: measured_threshold_witness(), } }
}
fn main() -> i32 with Panic {
    let value: Knowledge<ThresholdWitness where { amount >= 1 <km> }> = make_threshold_witness()
    return 0
}
