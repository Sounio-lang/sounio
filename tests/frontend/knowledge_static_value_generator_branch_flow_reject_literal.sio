struct PatientStaticValueGeneratorBranchFlowRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_branch_flow_reject_literal() -> Knowledge<PatientStaticValueGeneratorBranchFlowRejectLiteral> {
    var age = 13
    if false {
        age += 5
    } else {
        age += 0
    }
    return Knowledge {
        value: PatientStaticValueGeneratorBranchFlowRejectLiteral {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_branch_flow_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorBranchFlowRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_flow_reject_literal(make_patient_static_value_generator_branch_flow_reject_literal())
}
