//@ run-pass
//@ description: Sprint 38 — Contest<T> return triggers IR_STRATEGY_INSTRUMENTED

type M1 = Model<f64, f64>
models DisputedModels = [M1]
policy DisputedPolicy for f64 level Stable scope InDistribution {}

fn disputed_measurement() -> Contest<f64, DisputedModels, DisputedPolicy> with IO {
    let k: Knowledge<f64> = measure(9.81, uncertainty: 0.5)
    lift_knowledge(k)
}

fn main() -> i64 with IO {
    let c = disputed_measurement()
    let _sink = c
    0
}
