//@ run-pass
//@ description: Sprint 39 — Standard strategy float chain benchmark
//@ note: operand_reordering_active=false (plain f64 → IR_STRATEGY_STANDARD)

fn mixed_chain_standard(a: f64, b: f64, c: f64) -> f64 {
    let sum_ab: f64 = a + b
    let sum: f64 = sum_ab + c
    let prod_ab: f64 = a * b
    let prod: f64 = prod_ab * c
    sum + prod
}

fn main() -> i64 {
    let x = mixed_chain_standard(1.5, 2.5, 3.5)
    let _sink = x
    0
}
