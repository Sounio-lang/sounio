ontology KnowledgeStaticCompositeRejectOntology {
    class Entity
    class MetabolicDisease subclass_of Entity
    class Diabetes subclass_of MetabolicDisease
    class Type2Diabetes subclass_of Diabetes
    class Asthma subclass_of Entity
    disjoint Asthma, Diabetes
}

unit acceleration = m / s / s;

struct PatientCompositeRejectOntology {
    dx: Asthma,
    accel: acceleration,
    age: { v: i64 | v >= 18 },
}

fn reject_composite_patient_ontology(
    p: Knowledge<PatientCompositeRejectOntology where {
        dx subclass_of Diabetes,
        accel >= 1.0 <acceleration>,
        age >= 18
    }>
) -> i32 {
    return 1
}
