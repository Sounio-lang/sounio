struct PatientStaticValueGeneratorHelperBranchFlowRejectLiteral {
    age: i64,
}

fn choose_patient_static_value_helper_branch_flow_reject_literal(base: i64, delta: i64) -> i64 {
    var age = 13
    if base + delta >= 18 {
        age += 5
    } else {
        age += 0
    }
    return age
}

fn make_patient_static_value_generator_helper_branch_flow_reject_literal() -> Knowledge<PatientStaticValueGeneratorHelperBranchFlowRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperBranchFlowRejectLiteral {
            age: choose_patient_static_value_helper_branch_flow_reject_literal(13, 4),
        }
    }
}

fn accept_patient_static_value_generator_helper_branch_flow_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorHelperBranchFlowRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_branch_flow_reject_literal(make_patient_static_value_generator_helper_branch_flow_reject_literal())
}
