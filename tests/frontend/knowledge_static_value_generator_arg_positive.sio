struct PatientStaticValueGeneratorArgPositive {
    age: i64,
}

fn make_patient_static_value_generator_arg_positive(age: i64) -> Knowledge<PatientStaticValueGeneratorArgPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorArgPositive {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_arg_positive(
    patient: Knowledge<PatientStaticValueGeneratorArgPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_arg_positive(make_patient_static_value_generator_arg_positive(45))
}
