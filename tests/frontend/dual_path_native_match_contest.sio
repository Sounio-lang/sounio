//@ run-pass
//@ description: Sprint 40 — native dual-path dispatch for Contest<T> match/switch CFG
//@ note: IR_STRATEGY_INSTRUMENTED (3) triggers ir_opt_apply_strategy()

// ir_opt_apply_strategy() handles multi-way branches (match/switch):
//   dispatch_block:      IrBranchTrue(__validated, fast_label) + IrJump(instr_label)
//   fast_path:           original match instrs + IrJump(merge_label) per branch
//   instrumented_path:   IrLabel(instr_label) + cloned match instrs (vreg+label offset)
//   merge_block:         IrLabel(merge_label) + IrReturn
//
// ir_opt_clone_instr() remaps label_id in each IrJump within the switch,
// so instrumented-path switch targets land in the offset range, not the
// original fast-path blocks.
//
// dual_path_structure: four_block_diamond
// strategy_constant: IR_STRATEGY_INSTRUMENTED = 3

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn disputed_match(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let datum = match x {
        0 => 1
        1 => x + 2
        _ => x + 3
    }
    let contested: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on datum
    contested
}

fn main() -> i64 {
    let _ = disputed_match(1)
    0
}
