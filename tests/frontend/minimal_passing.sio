// Minimal Passing Test
// This should always pass

fn main() -> i32 {
    println("Minimal test running...")
    
    // Basic assertion
    let x = 1
    let y = 2
    let sum = x + y
    
    if sum == 3 {
        println("PASS: 1 + 2 = 3")
        return 0
    } else {
        println("FAIL: 1 + 2 should be 3")
        return 1
    }
}
