struct PatientStaticValueCallDynamicGap {
    age: i64,
}

fn measured_age() -> i64 {
    return 13
}

fn accept_patient_static_value_call_dynamic_gap(
    patient: Knowledge<PatientStaticValueCallDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_call_dynamic_gap(Knowledge {
        value: PatientStaticValueCallDynamicGap {
            age: measured_age(),
        }
    })
}
