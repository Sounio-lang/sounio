//@ run-pass
//@ description: singleton physical constants — typed canonical values prevent substitution errors

// Physical constants as named singletons.
// In Sounio, Singleton<f64, "speed_of_light"> ensures only the
// canonical c can be passed to relativistic calculations.

fn relativistic_kinetic_energy(m_kg: f64, v_ms: f64) -> f64 with IO, Div, Panic {
    // Speed of light (exact, SI 2019 redefinition): 299792458 m/s
    let c: f64 = 299792458.0
    let c2 = c * c
    let beta = v_ms / c
    let beta2 = beta * beta
    // Non-relativistic limit: E_k ≈ 0.5 m v²
    let gamma_approx: f64 = 1.0 + 0.5 * beta2
    m_kg * c2 * (gamma_approx + (0.0 - 1.0))
}

fn gravitational_potential(m1_kg: f64, m2_kg: f64, r_m: f64) -> f64 with IO, Div, Panic {
    // Gravitational constant: G = 6.674e-11 N·m²/kg²
    let G: f64 = 0.00000000006674
    let numerator = G * m1_kg * m2_kg
    0.0 - (numerator / r_m)
}

fn planck_energy(freq_hz: f64) -> f64 with IO, Div {
    // Planck constant: h = 6.62607015e-34 J·s
    let h: f64 = 0.000000000000000000000000000000000662607015
    h * freq_hz
}

fn main() -> i64 with IO, Div, Panic {
    let ke = relativistic_kinetic_energy(1.0, 1000.0)
    let ug = gravitational_potential(5.972e24, 1.0, 6371000.0)
    let ep = planck_energy(5.0e14)
    42
}
