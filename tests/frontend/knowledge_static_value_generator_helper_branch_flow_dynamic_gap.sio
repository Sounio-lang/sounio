struct PatientStaticValueGeneratorHelperBranchFlowDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_helper_branch_flow_delta() -> i64 {
    return 1
}

fn choose_patient_static_value_helper_branch_flow_dynamic_gap(base: i64, delta: i64) -> i64 {
    var age = 13
    if base + delta >= 18 {
        age += 5
    } else {
        age += 0
    }
    return age
}

fn make_patient_static_value_generator_helper_branch_flow_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorHelperBranchFlowDynamicGap> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperBranchFlowDynamicGap {
            age: choose_patient_static_value_helper_branch_flow_dynamic_gap(17, measured_patient_static_value_generator_helper_branch_flow_delta()),
        }
    }
}

fn accept_patient_static_value_generator_helper_branch_flow_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorHelperBranchFlowDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_branch_flow_dynamic_gap(make_patient_static_value_generator_helper_branch_flow_dynamic_gap())
}
