struct PatientStaticValueGeneratorBranchFlowDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_branch_flow_condition() -> bool {
    return true
}

fn make_patient_static_value_generator_branch_flow_dynamic_gap() -> Knowledge<PatientStaticValueGeneratorBranchFlowDynamicGap> {
    var age = 13
    if measured_patient_static_value_generator_branch_flow_condition() {
        age += 5
    } else {
        age += 0
    }
    return Knowledge {
        value: PatientStaticValueGeneratorBranchFlowDynamicGap {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_branch_flow_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorBranchFlowDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_flow_dynamic_gap(make_patient_static_value_generator_branch_flow_dynamic_gap())
}
