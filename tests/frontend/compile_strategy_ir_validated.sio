//@ run-pass
//@ description: Sprint 38 — Validated<T> return triggers IR_STRATEGY_AGGRESSIVE

type M1 = Model<i64, i64>
models CalibrationModels = [M1]
policy CalibrationPolicy for i64 level Stable scope InDistribution {}
validation CalibrationManifest for i64 {}

fn calibrated_constant() -> Validated<i64> {
    let d: i64 = 42
    let c: Contest<i64, CalibrationModels, CalibrationPolicy> = contest [M1] on d
    let r: Robust<i64, Stable, InDistribution> = prove_robust(c, CalibrationPolicy)
    validate_manifest(r, CalibrationManifest)
}

fn main() -> i64 {
    let v = calibrated_constant()
    let _sink = v
    0
}
