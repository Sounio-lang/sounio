struct ScoreRuntimeGuardUpperReject {
    score: i64,
}

fn measured_runtime_guard_upper_reject_score() -> i64 {
    return 120
}

fn make_score_runtime_guard_upper_reject() -> Knowledge<ScoreRuntimeGuardUpperReject where {
    score <= 100
}> with Panic {
    return Knowledge {
        value: ScoreRuntimeGuardUpperReject {
            score: measured_runtime_guard_upper_reject_score(),
        }
    }
}

fn main() -> i32 with Panic {
    let score: Knowledge<ScoreRuntimeGuardUpperReject where {
        score <= 100
    }> = make_score_runtime_guard_upper_reject()
    return 0
}
