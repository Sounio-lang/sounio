struct PatientStaticValueGeneratorPositive {
    age: i64,
}

fn make_patient_static_value_generator_positive() -> Knowledge<PatientStaticValueGeneratorPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorPositive {
            age: 45,
        }
    }
}

fn accept_patient_static_value_generator_positive(
    patient: Knowledge<PatientStaticValueGeneratorPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_positive(make_patient_static_value_generator_positive())
}
