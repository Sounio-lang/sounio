unit mg_dL;

struct PatientRuntimeGuardInternalLabelReject {
    glucose: mg_dL,
}

fn measured_runtime_guard_internal_label_reject_glucose() -> mg_dL {
    return 100.0
}

fn make_patient_runtime_guard_internal_label_reject() -> Knowledge<PatientRuntimeGuardInternalLabelReject where {
    glucose >= 126.0 <mg_dL>
}> with Panic {
    return Knowledge {
        value: PatientRuntimeGuardInternalLabelReject {
            glucose: measured_runtime_guard_internal_label_reject_glucose(),
        }
    }
}

fn main() -> i32 with Panic {
    let patient: Knowledge<PatientRuntimeGuardInternalLabelReject where {
        glucose >= 126.0 <mg_dL>
    }> = make_patient_runtime_guard_internal_label_reject()
    return 0
}
