//@ run-pass
//@ description: Sprint 48 — show-profile probe fixture

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn hot_fn(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let result = x * 3
    let c: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on result
    c
}

fn cold_fn(x: i64) -> i64 { x + 1 }

fn main() -> i64 {
    let _ = hot_fn(10)
    let _ = cold_fn(5)
    0
}
