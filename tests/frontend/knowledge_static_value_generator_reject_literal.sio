struct PatientStaticValueGeneratorRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_reject_literal() -> Knowledge<PatientStaticValueGeneratorRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorRejectLiteral {
            age: 13,
        }
    }
}

fn accept_patient_static_value_generator_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_reject_literal(make_patient_static_value_generator_reject_literal())
}
