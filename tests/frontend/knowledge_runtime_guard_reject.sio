struct PatientRuntimeGuardReject {
    age: i64,
}

fn measured_runtime_guard_reject_age() -> i64 {
    return 13
}

fn make_patient_runtime_guard_reject() -> Knowledge<PatientRuntimeGuardReject where { age >= 18 }> with Panic {
    return Knowledge {
        value: PatientRuntimeGuardReject {
            age: measured_runtime_guard_reject_age(),
        }
    }
}

fn main() -> i32 with Panic {
    let patient: Knowledge<PatientRuntimeGuardReject where { age >= 18 }> = make_patient_runtime_guard_reject()
    return 0
}
