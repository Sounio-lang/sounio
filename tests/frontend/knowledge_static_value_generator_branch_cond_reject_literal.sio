struct PatientStaticValueGeneratorBranchCondRejectLiteral {
    age: i64,
}

fn make_patient_static_value_generator_branch_cond_reject_literal(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorBranchCondRejectLiteral> {
    var age = 13
    if base + delta >= 18 {
        age += 5
    } else {
        age += 0
    }
    return Knowledge {
        value: PatientStaticValueGeneratorBranchCondRejectLiteral {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_branch_cond_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorBranchCondRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_cond_reject_literal(make_patient_static_value_generator_branch_cond_reject_literal(13, 4))
}
