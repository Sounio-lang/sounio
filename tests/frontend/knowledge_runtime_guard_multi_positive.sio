struct PatientRuntimeGuardMultiPositive {
    age: i64,
    glucose: i64,
}

fn measured_runtime_guard_multi_positive_age() -> i64 {
    return 44
}

fn measured_runtime_guard_multi_positive_glucose() -> i64 {
    return 140
}

fn make_patient_runtime_guard_multi_positive() -> Knowledge<PatientRuntimeGuardMultiPositive where {
    age >= 18,
    glucose >= 126
}> with Panic {
    return Knowledge {
        value: PatientRuntimeGuardMultiPositive {
            age: measured_runtime_guard_multi_positive_age(),
            glucose: measured_runtime_guard_multi_positive_glucose(),
        }
    }
}

fn main() -> i32 with Panic {
    let patient: Knowledge<PatientRuntimeGuardMultiPositive where {
        age >= 18,
        glucose >= 126
    }> = make_patient_runtime_guard_multi_positive()
    return 0
}
