    x
}

fn takes_potassium_mmol_l(x: mmol_L) -> f64 with Mut {
    x
}

fn takes_alt_u_l(x: U_L) -> f64 with Mut {
    x
}

fn takes_esr_mm_h(x: mm_h) -> f64 with Mut {
    x
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let glucose = 140.0<mg_dL>
    let potassium = 4.2<mmol_L>
