// Sprint 19: acquisition planning from explicit deferral evidence.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {
    require mechanistic_divergence <= 0.20
}
deferral_policy ReviewPolicy for i64 route renal_review {
    require mechanistic_divergence > 0.20
}
acquisition_policy RenalClarify for i64 objective ModelDiscrimination route renal_panel {
    require mechanistic_divergence >= 0.20
    require identifiability_floor < 0.80
}
audit ReviewAudit for Contest<i64, DefaultModels, DefaultPolicy> {
    metrics {
        identifiability_floor: 0.70
    }
    mechanistic {
        aggregate_divergence: 0.24
        latent_state_divergence: 0.20
        causal_decomposition_divergence: 0.25
        intervention_response_divergence: 0.28
        parameter_role_divergence: 0.21
        structural_explanation_distance: 0.26
    }
}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<i64, DefaultModels, DefaultPolicy> = (contest [M1] on d) audit ReviewAudit
    let deferred: Deferred<i64> = defer_action(d, c, ReviewPolicy)
    let plan: AcquisitionPlan<i64> = plan_acquisition(d, deferred, RenalClarify)
    let reason = acquisition_reason(plan)
    0
}
