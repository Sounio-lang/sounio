struct AssayRuntimeGuardEqReject {
    repeats: i64,
}

fn measured_runtime_guard_eq_reject_repeats() -> i64 {
    return 4
}

fn make_assay_runtime_guard_eq_reject() -> Knowledge<AssayRuntimeGuardEqReject where {
    repeats == 3
}> with Panic {
    return Knowledge {
        value: AssayRuntimeGuardEqReject {
            repeats: measured_runtime_guard_eq_reject_repeats(),
        }
    }
}

fn main() -> i32 with Panic {
    let assay: Knowledge<AssayRuntimeGuardEqReject where {
        repeats == 3
    }> = make_assay_runtime_guard_eq_reject()
    return 0
}
