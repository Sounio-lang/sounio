ontology KnowledgeStaticCompositeRejectUnit {
    class Entity
    class MetabolicDisease subclass_of Entity
    class Diabetes subclass_of MetabolicDisease
    class Type2Diabetes subclass_of Diabetes
}

unit velocity = m / s;
unit acceleration = m / s / s;

struct PatientCompositeRejectUnit {
    dx: Type2Diabetes,
    accel: velocity,
    age: { v: i64 | v >= 18 },
}

fn reject_composite_patient_unit(
    p: Knowledge<PatientCompositeRejectUnit where {
        dx subclass_of Diabetes,
        accel >= 1.0 <acceleration>,
        age >= 18
    }>
) -> i32 {
    return 1
}
