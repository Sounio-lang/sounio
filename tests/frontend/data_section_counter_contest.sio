//@ run-pass
//@ description: Sprint 45 — INC QWORD PTR [RIP+disp32] counter in .data section
//@ note: IrProfCounter emits actual x86-64 counter increment targeting writable .data

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn profiled_contested(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let result = x + 1
    let c: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on result
    c
}

fn main() -> i64 {
    let _ = profiled_contested(10)
    0
}
