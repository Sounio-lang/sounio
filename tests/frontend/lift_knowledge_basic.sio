policy DefaultPolicy for i64 {}

fn main() -> i64 {
    let k: Knowledge<i64> = measure(42, uncertainty: 1.0)
    let c: Contest<i64> = lift_knowledge(k)
    let r: Robust<i64> = prove_robust(c, DefaultPolicy)
    let v: Validated<i64> = validate_manifest(r)
