// Partial audit fixture with explicit counterexample witness coverage.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

audit CounterexampleOnlyAudit for Contest<i64, DefaultModels, DefaultPolicy> {
    counterexample {
        model_name: M1
        subgroup_name: renal_impaired
        metric_name: toxic_exposure
        observed_value: 0.24
        threshold_value: 0.20
        summary: "counterexample-only attachment"
    }
}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<i64, DefaultModels, DefaultPolicy> = (contest [M1] on d) audit CounterexampleOnlyAudit
    let cx = counterexample(c)
    0
}
