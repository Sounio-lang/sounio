// Sprint 17: explicit deferral from contested counterfactual evidence.

type CFM = Model<i64, Counterfactual<i64>>
models CounterfactualModels = [CFM]
policy CounterfactualPolicy for Counterfactual<i64> level Stable scope InDistribution {}
deferral_policy ReviewPolicy for Counterfactual<i64> route review {
    require relative_band >= 0.20
}
audit ReviewAudit for Contest<Counterfactual<i64>, CounterfactualModels, CounterfactualPolicy> {
    metrics {
        relative_band: 0.25
    }
}

fn review_counterfactual(cf: Counterfactual<i64>) -> i64 {
    let d: i64 = 42
    let c: Contest<Counterfactual<i64>, CounterfactualModels, CounterfactualPolicy> =
        (contest [CFM] on d) audit ReviewAudit
    let deferred: Deferred<Counterfactual<i64>> = defer_action(cf, c, ReviewPolicy)
    let reason = deferral_reason(deferred)
    0
}

fn main() -> i64 {
    0
}
