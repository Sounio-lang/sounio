// Causal composition fixture using Contest<Counterfactual<i64>, ...> with named audit.

type CFM = Model<i64, Counterfactual<i64>>
models CounterfactualModels = [CFM]
policy CounterfactualPolicy for Counterfactual<i64> level Stable scope InDistribution {}

audit CounterfactualAudit for Contest<Counterfactual<i64>, CounterfactualModels, CounterfactualPolicy> {
    metrics {
        sign_consensus: 1.0
        relative_band: 0.10
        max_tail_risk: 0.02
        identifiability_floor: 0.80
    }

    mechanistic {
        aggregate_divergence: 0.18
        latent_state_divergence: 0.12
        causal_decomposition_divergence: 0.20
        intervention_response_divergence: 0.21
        parameter_role_divergence: 0.09
        structural_explanation_distance: 0.17
    }

    counterexample {
        model_name: CFM
        subgroup_name: baseline
        metric_name: counterfactual_outcome
        observed_value: 0.24
        threshold_value: 0.20
        summary: "counterfactual disagreement witness"
    }

    posterior_weights {
        CFM: 1.0
    }
}

fn main() -> i64 {
    let d: i64 = 42
    let c: Contest<Counterfactual<i64>, CounterfactualModels, CounterfactualPolicy> =
        (contest [CFM] on d) audit CounterfactualAudit
    let dg = disagreement(c)
    0
}
