// Sprint 1 Smoke Test
// Basic test to verify test infrastructure works

fn main() -> i32 {
    println("Sprint 1 Smoke Test")
    println("Testing basic arithmetic...")
    
    let x = 2 + 2
    if x != 4 {
        println("FAIL: 2 + 2 should be 4")
        return 1
    }
    
    let y = 10 * 10
    if y != 100 {
        println("FAIL: 10 * 10 should be 100")
        return 1
    }

    println("All basic tests passed!")
    return 0
}
