//@ knowledge-runtime-guards

struct PatientRuntimeGuardDirectivePositive {
    age: i64,
}

fn measured_runtime_guard_directive_positive_age() -> i64 {
    return 21
}

fn accept_patient_runtime_guard_directive_positive(
    patient: Knowledge<PatientRuntimeGuardDirectivePositive where { age >= 18 }>
) -> i32 {
    return 0
}

fn main() -> i32 with Panic {
    return accept_patient_runtime_guard_directive_positive(Knowledge {
        value: PatientRuntimeGuardDirectivePositive {
            age: measured_runtime_guard_directive_positive_age(),
        }
    })
}
