// Sprint 38: StrategyInstrumented full-CFG fixture with if/else merge.

type M1 = Model<i64, i64>
models DefaultModels = [M1]
policy DefaultPolicy for i64 level Stable scope InDistribution {}

fn contest_if_branch(x: i64) -> Contest<i64, DefaultModels, DefaultPolicy> {
    let datum = if x > 0 {
        x + 1
    } else {
        0 - x
    }
    let contested: Contest<i64, DefaultModels, DefaultPolicy> = contest [M1] on datum
    contested
}

fn main() -> i64 {
    let _ = contest_if_branch(4)
    0
}
