struct PatientStaticValueGeneratorHelperBranchCondPositive {
    age: i64,
}

fn choose_patient_static_value_helper_branch_cond_positive(base: i64, delta: i64) -> i64 {
    if base + delta >= 18 {
        return 18
    } else {
        return 13
    }
}

fn make_patient_static_value_generator_helper_branch_cond_positive() -> Knowledge<PatientStaticValueGeneratorHelperBranchCondPositive> {
    return Knowledge {
        value: PatientStaticValueGeneratorHelperBranchCondPositive {
            age: choose_patient_static_value_helper_branch_cond_positive(17, 1),
        }
    }
}

fn accept_patient_static_value_generator_helper_branch_cond_positive(
    patient: Knowledge<PatientStaticValueGeneratorHelperBranchCondPositive where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_helper_branch_cond_positive(make_patient_static_value_generator_helper_branch_cond_positive())
}
