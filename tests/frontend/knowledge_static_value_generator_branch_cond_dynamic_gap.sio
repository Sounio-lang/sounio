struct PatientStaticValueGeneratorBranchCondDynamicGap {
    age: i64,
}

fn measured_patient_static_value_generator_branch_cond_delta() -> i64 {
    return 1
}

fn make_patient_static_value_generator_branch_cond_dynamic_gap(base: i64, delta: i64) -> Knowledge<PatientStaticValueGeneratorBranchCondDynamicGap> {
    var age = 13
    if base + delta >= 18 {
        age += 5
    } else {
        age += 0
    }
    return Knowledge {
        value: PatientStaticValueGeneratorBranchCondDynamicGap {
            age: age,
        }
    }
}

fn accept_patient_static_value_generator_branch_cond_dynamic_gap(
    patient: Knowledge<PatientStaticValueGeneratorBranchCondDynamicGap where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_branch_cond_dynamic_gap(make_patient_static_value_generator_branch_cond_dynamic_gap(17, measured_patient_static_value_generator_branch_cond_delta()))
}
