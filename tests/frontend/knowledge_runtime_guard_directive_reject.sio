//@ knowledge-runtime-guards

struct PatientRuntimeGuardDirectiveReject {
    age: i64,
}

fn measured_runtime_guard_directive_reject_age() -> i64 {
    return 13
}

fn accept_patient_runtime_guard_directive_reject(
    patient: Knowledge<PatientRuntimeGuardDirectiveReject where { age >= 18 }>
) -> i32 {
    return 0
}

fn main() -> i32 with Panic {
    return accept_patient_runtime_guard_directive_reject(Knowledge {
        value: PatientRuntimeGuardDirectiveReject {
            age: measured_runtime_guard_directive_reject_age(),
        }
    })
}
