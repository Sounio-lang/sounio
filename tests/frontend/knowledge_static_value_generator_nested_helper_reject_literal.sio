struct PatientStaticValueGeneratorNestedHelperRejectLiteral {
    age: i64,
}

fn inner_patient_static_value_nested_helper_reject_literal(base: i64, delta: i64) -> i64 {
    if base + delta >= 18 {
        return 18
    } else {
        return 13
    }
}

fn outer_patient_static_value_nested_helper_reject_literal(seed: i64) -> i64 {
    return inner_patient_static_value_nested_helper_reject_literal(seed, 4)
}

fn make_patient_static_value_generator_nested_helper_reject_literal() -> Knowledge<PatientStaticValueGeneratorNestedHelperRejectLiteral> {
    return Knowledge {
        value: PatientStaticValueGeneratorNestedHelperRejectLiteral {
            age: outer_patient_static_value_nested_helper_reject_literal(13),
        }
    }
}

fn accept_patient_static_value_generator_nested_helper_reject_literal(
    patient: Knowledge<PatientStaticValueGeneratorNestedHelperRejectLiteral where { age >= 18 }>
) -> i32 {
    return 1
}

fn main() -> i32 {
    return accept_patient_static_value_generator_nested_helper_reject_literal(make_patient_static_value_generator_nested_helper_reject_literal())
}
