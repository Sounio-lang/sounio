// Imported half of the E311 multimodule witness: the untyped read sits in a
// module that main.sio imports, so the refusal must come from the imported
// compile path as well.
pub struct A { pub x: i64, pub y: i64 }
pub struct B { pub y: i64, pub x: i64 }

pub fn third_x() -> i64 with Mut, Div, Panic, Alloc {
    let t = (A { x: 3, y: 4 }, B { y: 5, x: 6 }, B { y: 7, x: 8 })
    t.2.x
}
