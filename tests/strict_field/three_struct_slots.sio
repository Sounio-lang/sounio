// E311 witness for scripts/ci/madaros_strict_field_gate.sh. A tuple local
// records the struct of its first two struct-bearing slots only, so slot 2's
// `x` has no type: A and B declare `x` at different indices, the lowerer would
// vote, and SOUNIO_STRICT_FIELD=1 must refuse the compile with E311.
struct A { x: i64, y: i64 }
struct B { y: i64, x: i64 }

fn main() with IO, Mut, Div, Panic, Alloc {
    let a = A { x: 1, y: 2 }
    let t = (A { x: 3, y: 4 }, B { y: 5, x: 6 }, B { y: 7, x: 8 })
    let v = t.2.x
    print_int(v + a.y)
    println("")
}
