//@ run-pass
//@ expect-stdout: BIGFIELD_OK
// Cap-free evidence: a field 200 bytes long — far larger than the 64-byte csv_str_into
// convenience buffer — is read IN FULL via the raw accessors csv_field_range + csv_byte,
// proving there is no field-LENGTH cap. Read from a file (the real cap-free path via
// read_file's dynamically sized mmap, #1078); a 200-byte string literal cannot be used
// because Madaros v0.80.0 caps string literals near 128 bytes (unrelated to this reader).
//
// Fixture (generated by the reader gate before this test runs, mirroring
// test_csv_reader_file.sio):  printf 'k,v\nlong,%s\n' "$(printf 'a%.0s' {1..200})" > cr_bigfield.csv
use data::csv_reader::{csv_open_file, csv_next_row, csv_col, csv_field_range, csv_byte, CsvRange, CsvReader}
fn main() -> i32 with IO, Mut, Panic, Div {
    var r = csv_open_file("cr_bigfield.csv")
    let cv = csv_col(&r, "v")
    csv_next_row(&!r)
    let rng = csv_field_range(&r, cv)
    var count = 0
    var i = rng.start
    let stop = rng.start + rng.len
    while i < stop {
        let b = csv_byte(&r, i)
        if b == 97 { count = count + 1 }   // 'a' == 97
        i = i + 1
    }
    if rng.len == 200 && count == 200 {
        print("BIGFIELD_OK\n")
    } else {
        print("FAIL len="); print_int(rng.len); print(" count="); print_int(count); print("\n")
    }
    return 0
}
