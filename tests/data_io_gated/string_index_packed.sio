// Gate probe: packed-string IndexGet (native-v2).
//
// read_file / str_from_bytes return packed *u8 (null-terminated), NOT GC array
// handles. Indexing via s[i] must load a single byte (label_id=3), not scale*8
// through the handle table. str_char_at remains the explicit alternative.
//
// Expected stdout (probe.txt content "hi\n" = bytes 104 105 10):
//   SFB:72 105 33
//   RF:3 104 105 10
//   LIT:72 105
//   AT:104 105
//   ARR:65 66
//   STRING_INDEX_OK

fn main() with IO {
    // --- str_from_bytes packed result ---
    var buf: [i8; 8] = [0; 8]
    buf[0] = 72
    buf[1] = 105
    buf[2] = 33
    let sfb = str_from_bytes(buf, 3)
    print("SFB:")
    print_int(sfb[0] as i64)
    print(" ")
    print_int(sfb[1] as i64)
    print(" ")
    print_int(sfb[2] as i64)
    print("\n")

    // --- read_file packed result ---
    let raw = read_file("probe.txt")
    let n = str_len(raw)
    print("RF:")
    print_int(n)
    print(" ")
    print_int(raw[0] as i64)
    print(" ")
    print_int(raw[1] as i64)
    print(" ")
    print_int(raw[2] as i64)
    print("\n")

    // --- string literal (typed string; index yields i64 byte) ---
    let lit = "Hi"
    print("LIT:")
    print_int(lit[0] as i64)
    print(" ")
    print_int(lit[1] as i64)
    print("\n")

    // --- str_char_at still works (regression) ---
    print("AT:")
    print_int(str_char_at(raw, 0) as i64)
    print(" ")
    print_int(str_char_at(raw, 1) as i64)
    print("\n")

    // --- [i8;N] array index still works (must NOT take string path) ---
    var arr: [i8; 4] = [0; 4]
    arr[0] = 65
    arr[1] = 66
    print("ARR:")
    print_int(arr[0] as i64)
    print(" ")
    print_int(arr[1] as i64)
    print("\n")

    print("STRING_INDEX_OK\n")
}
