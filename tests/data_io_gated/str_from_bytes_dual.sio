//@ run-pass
// D2 residual (#933): str_from_bytes must accept both handle-by-value and &buf.
// Canonical: str_from_bytes(buf, n). Residual shape: str_from_bytes(&buf, n)
// (native-v2 OpRef = LEA of the handle slot — auto-unwrapped at lower).

fn main() -> i32 with IO, Mut, Panic, Div {
    var buf: [i8; 16] = [0; 16]
    buf[0 as usize] = 104 as i8   // 'h'
    buf[1 as usize] = 105 as i8   // 'i'
    buf[2 as usize] = 33 as i8    // '!'

    // Shape A: handle by value (must not regress)
    print(str_from_bytes(buf, 2))
    print("|")
    // Shape B: &buf residual (must auto-unwrap to the same handle)
    print(str_from_bytes(&buf, 3))
    print("\n")
    return 0
}
