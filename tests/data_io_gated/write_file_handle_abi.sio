//@ run-pass
// Native-v2 write_file handle-ABI probe (codegen_x86_linux::emit_builtin_write_file).
//
// Local fixed arrays are GC handles with 8-byte boxed element slots. The canonical
// call shape is write_file(path, buf, n) — handle by value, matching str_from_bytes(buf, n).
// The gate (scripts/native_write_file_handle_abi_gate.sh) compiles this with a current-
// source Madaros, runs it, and byte-cmps the written file against the golden CSV
// payload "x,y\n1,2\n3,4\n" (12 bytes). rc must equal 12 AND contents must match.

fn main() -> i32 with IO, Mut, Panic, Div {
    var buf: [i8; 16] = [0; 16]
    // golden: x,y\n1,2\n3,4\n
    buf[0 as usize] = 120 as i8   // 'x'
    buf[1 as usize] = 44 as i8    // ','
    buf[2 as usize] = 121 as i8   // 'y'
    buf[3 as usize] = 10 as i8    // '\n'
    buf[4 as usize] = 49 as i8    // '1'
    buf[5 as usize] = 44 as i8    // ','
    buf[6 as usize] = 50 as i8    // '2'
    buf[7 as usize] = 10 as i8    // '\n'
    buf[8 as usize] = 51 as i8    // '3'
    buf[9 as usize] = 44 as i8    // ','
    buf[10 as usize] = 52 as i8   // '4'
    buf[11 as usize] = 10 as i8   // '\n'

    // Path is relative; gate runs from a temp dir and supplies the golden fixture nearby.
    let path = "write_file_handle_abi.out"
    let rc = write_file(path, buf, 12)
    if rc != 12 {
        print("FAIL_RC\n")
        return 1
    }
    // Print a stable sentinel on success so the gate can also check stdout.
    print("WRITE_OK\n")
    return 0
}
