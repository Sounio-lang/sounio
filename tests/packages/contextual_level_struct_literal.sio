//@ run-pass
//@ expect-stdout: contextual level literal: passed

struct Certificate {
    level: i64,
}

fn certificate_new(level: i64) -> Certificate {
    Certificate { level: level }
}

fn main() -> i64 with IO, Panic {
    let certificate = certificate_new(7)
    assert(certificate.level == 7)
    println("contextual level literal: passed")
    0
}
