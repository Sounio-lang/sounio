//@ run-pass
//@ requires: madaros
//@ expect-stdout: PACKAGE_PBPK_GUM_MEASUREMENT_OK

use epistemic_core::*
use darwin_pbpk::io::observed_csv::*
use darwin_pbpk::io::normalization::*
use darwin_pbpk::schema::observation::*

fn measurement_probe_near(a: f64, b: f64, tol: f64) -> bool {
    let delta = if a < b { b - a } else { a - b }
    delta <= tol
}

fn main() with IO, Mut, Div, Panic {
    let plasma_raw = parse_observed_csv(
        "s1,15,min,plasma,blood,central,,10.225,ug/L,1.044,lcms,synthetic_ref"
    )
    let brain_raw = parse_observed_csv(
        "s1,4,h,brain,brain,tissue,,0.285,ug/L,0.981,lcms,synthetic_ref"
    )
    let plasma_table = normalize_observations(plasma_raw, "rapamycin_iv_bolus_ref")
    let brain_table = normalize_observations(brain_raw, "rapamycin_iv_bolus_ref")
    let plasma = normalized_observation_get(plasma_table, 0)
    let brain = normalized_observation_get(brain_table, 0)

    let plasma_k = measure_with_confidence(
        plasma.measurement, plasma.measurement_uncertainty, 0.97, plasma.source
    )
    let brain_k = measure_with_confidence(
        brain.measurement, brain.measurement_uncertainty, 0.97, brain.source
    )
    let ratio = knowledge_div(&brain_k, &plasma_k)

    assert(measurement_probe_near(plasma.measurement, 0.010225, 0.000001))
    assert(measurement_probe_near(plasma.measurement_uncertainty, 0.001044, 0.000001))
    assert(measurement_probe_near(brain.measurement, 0.000285, 0.000001))
    assert(measurement_probe_near(brain.measurement_uncertainty, 0.000981, 0.000001))
    assert(knowledge_value(&ratio) > 0.02 && knowledge_value(&ratio) < 0.04)
    assert(knowledge_uncertainty(&ratio) > 0.09 && knowledge_uncertainty(&ratio) < 0.11)
    assert(measurement_probe_near(knowledge_confidence(&ratio), 0.97, 0.000001))

    println("PACKAGE_PBPK_GUM_MEASUREMENT_OK")
}
