//@ run-pass
//@ expect-stdout: empty println preserves calls: passed

fn fib(n: i32) -> i32 {
    if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

fn main() -> i64 with IO, Panic {
    print("empty println before recursive call:")
    println()
    assert(fib(10) == 55)
    println("empty println preserves calls: passed")
    0
}
