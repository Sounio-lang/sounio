//@ run-pass
//@ expect-stdout: package import science witness:

use epistemic_core::*

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn approx_eq(actual: f64, expected: f64, tolerance: f64) -> bool {
    abs_f64(actual - expected) <= tolerance
}

fn test_concentration_from_measurements() -> bool with Mut, Div, Panic {
    let dose = measure(500.0, 25.0, "dose_hplc")
    let volume = measure(10.0, 0.2, "volume_pipette")
    let concentration = knowledge_div(&dose, &volume)

    let value_ok = approx_eq(knowledge_value(&concentration), 50.0, 0.000001)
    let uncertainty_ok = approx_eq(knowledge_uncertainty(&concentration), 2.6925824, 0.0001)
    let rel_ok = approx_eq(knowledge_rel_uncertainty(&concentration), 0.0538516, 0.0001)
    value_ok && uncertainty_ok && rel_ok
}

fn test_pbpk_shaped_daily_dose_budget() -> bool with Mut, Div, Panic {
    let clearance = measure_with_confidence(4.0, 0.4, 0.92, "clearance_model")
    let target_auc = measure(125.0, 5.0, "target_auc")
    let daily_dose = knowledge_mul(&clearance, &target_auc)

    let value_ok = approx_eq(knowledge_value(&daily_dose), 500.0, 0.000001)
    let uncertainty_ok = approx_eq(knowledge_uncertainty(&daily_dose), 53.851648, 0.001)
    let confidence_ok = approx_eq(knowledge_confidence(&daily_dose), 0.92, 0.000001)
    value_ok && uncertainty_ok && confidence_ok
}

fn test_confidence_gate_check() -> bool with Panic {
    let k = measure_with_confidence(1.0, 0.1, 0.96, "validated_assay")
    confidence_check(&k, 0.95)
}

fn test_package_sqrt_export() -> bool with Mut, Div, Panic {
    approx_eq(sqrt(2.0), 1.41421356, 0.000001)
}

fn main() with IO, Mut, Div, Panic {
    var passed: i64 = 0
    var total: i64 = 0

    total = total + 1
    if test_concentration_from_measurements() { passed = passed + 1 } else { println("FAIL: test_concentration_from_measurements") }

    total = total + 1
    if test_pbpk_shaped_daily_dose_budget() { passed = passed + 1 } else { println("FAIL: test_pbpk_shaped_daily_dose_budget") }

    total = total + 1
    if test_confidence_gate_check() { passed = passed + 1 } else { println("FAIL: test_confidence_gate_check") }

    total = total + 1
    if test_package_sqrt_export() { passed = passed + 1 } else { println("FAIL: test_package_sqrt_export") }

    print("package import science witness: ")
    print_int(passed)
    print("/")
    print_int(total)
    println(" passed")

    assert(passed == total)
}
