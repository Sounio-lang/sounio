//@ run-pass
//@ expect-stdout: deref value field f64: passed

struct Reading {
    value: f64,
    uncertainty: f64,
}

fn add_readings(a: &Reading, b: &Reading) -> Reading {
    Reading {
        value: (*a).value + (*b).value,
        uncertainty: (*a).uncertainty + (*b).uncertainty,
    }
}

fn main() -> i64 with IO, Panic {
    let a = Reading { value: 100.0, uncertainty: 2.0 }
    let b = Reading { value: 50.0, uncertainty: 1.5 }
    let sum = add_readings(&a, &b)
    assert(sum.value == 150.0)
    assert(sum.uncertainty == 3.5)
    println("deref value field f64: passed")
    0
}
