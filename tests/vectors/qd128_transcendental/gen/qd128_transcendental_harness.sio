// for every case in tests/vectors/qd128_transcendental/qd128_transcendental.jsonl.
//
// Inputs are rebuilt from exact (mantissa, exponent) integer pairs rather than
// decimal literals: souc's decimal literal parser is not correctly rounded and
// would otherwise feed the harness a different number than the oracle saw.
use math::qd128::*

fn mk(m: i64, e: i64) -> f64 with Mut {
    var r = m as f64
    var n = e
    while n < 0 {
        r = r * 0.5
        n = n + 1
    }
    while n > 0 {
        r = r * 2.0
        n = n - 1
    }
    r
}

fn emit(tag: i64, q: Qd128) with IO, Mut, Panic, Div {
    print_int(tag)
    print(" ")
    print_int(f64_to_bits(q.x0))
    print(" ")
    print_int(f64_to_bits(q.x1))
    print(" ")
    print_int(f64_to_bits(q.x2))
    print(" ")
    print_int(f64_to_bits(q.x3))
    print("\n")
}

