//@ run-pass
//@ requires: madaros
use llm::mmap::{page_arena_alloc, page_arena_free, page_arena_is_ok, page_arena_ptr, page_arena_len, mapped_shard_open, mapped_shard_close, mapped_shard_is_ok, mapped_shard_read_u8}
use llm::raw_memory::{ptr_read_i64_le, ptr_write_i64_le}
fn main() -> i64 with IO, Alloc, Mut, Panic, Div {
    let a = page_arena_alloc(17)
    if !page_arena_is_ok(&a) { return 1 }
    let p = page_arena_ptr(&a)
    if page_arena_len(&a) != 16384 || ptr_read_i64_le(p, 0) != 0 { return 2 }
    let _w = ptr_write_i64_le(p, 16376, 42)
    if ptr_read_i64_le(p, 16376) != 42 { return 3 }
    if page_arena_free(a) != 0 { return 4 }
    let s = mapped_shard_open("tests/llm/llm_mmap_contract.sio")
    if !mapped_shard_is_ok(&s) { return 5 }
    let v = mapped_shard_read_u8(&s, 0)
    if !v.1 || v.0 != 47 { return 6 }
    if mapped_shard_close(s) != 0 { return 7 }
    println("LLM_MMAP_CONTRACT_PASS")
    0
}
