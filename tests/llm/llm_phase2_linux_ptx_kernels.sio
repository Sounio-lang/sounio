//@ run-pass
//@ requires: madaros
//@ expect-stdout: LLM_PHASE2_LINUX_PTX_KERNELS_PASS
//
// Phase 2 Linux PTX Kernels test:
// Cross-compiles to x86_64-linux ELF with DT_NEEDED: libdl.so.2 and runs
// via musl_pt_interp_adapter + libcuda_mock.so in souc-linux VM across 5 PTX kernels:
// 1. QK-RMSNorm (qwen3_rmsnorm_bf16)
// 2. RoPE (qwen3_rope_f32)
// 3. GEMV (qwen3_bf16_gemv_f32)
// 4. SwiGLU (qwen3_swiglu_f32)
// 5. Paged GQA (qwen3_paged_gqa_f32)

use llm::mmap::{
    PageArena,
    page_arena_alloc,
    page_arena_free,
    page_arena_ptr,
    page_arena_is_ok,
    page_arena_read_u32_le,
}
use tensor2::convert::{f64_to_f32_bits, f32_bits_to_f64}
use llm::hal::{
    CudaDriverSession,
    cuda_session_open,
    cuda_session_close,
    cuda_session_is_ok,
    cuda_module_load_ptx_ptr,
    cuda_module_unload,
    cuda_module_get_fn,
    cuda_mem_alloc,
    cuda_mem_free,
    cuda_memcpy_h2d,
    cuda_memcpy_d2h,
    cuda_launch_6param_1d,
    cuda_launch_8param_1d,
}
use llm::qwen3_kernels::{
    emit_qwen3_kernels_ptx_cstr,
}

extern "C" {
    fn sqrt(x: f64) -> f64
    fn exp(x: f64) -> f64
    fn pow(x: f64, y: f64) -> f64
    fn sin(x: f64) -> f64
    fn cos(x: f64) -> f64
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn write_f32_at(arena: &PageArena, idx: i64, val: f64) with Mut {
    let bits = f64_to_f32_bits(val)
    let p = page_arena_ptr(arena)
    let _rc = ptr_write_u32_le(p, idx * 4, bits)
}

fn read_f32_at(arena: &PageArena, idx: i64) -> f64 with Mut {
    let r = page_arena_read_u32_le(arena, idx * 4)
    if !r.1 { return 0.0 }
    f32_bits_to_f64(r.0)
}

fn test_cuda_rmsnorm(sess: &CudaDriverSession, hfn: i64) -> bool with IO, Mut, Alloc {
    let n_groups = 4
    let dim = 64
    let total = n_groups * dim

    let arena_x = page_arena_alloc(total * 4)
    let arena_w = page_arena_alloc(dim * 2)
    let arena_out = page_arena_alloc(total * 4)
    var pass = true

    if !page_arena_is_ok(&arena_x) || !page_arena_is_ok(&arena_w) || !page_arena_is_ok(&arena_out) {
        pass = false
    } else {
        var i: i64 = 0
        while i < total {
            let v = (((i % 17) - 8) as f64) * 0.125
            write_f32_at(&arena_x, i, v)
            i = i + 1
        }

        let p_w = page_arena_ptr(&arena_w)
        var j: i64 = 0
        while j < dim {
            let _w = ptr_write_u16_le(p_w, j * 2, 0x3F80)
            j = j + 1
        }

        let d_x = cuda_mem_alloc(sess, total * 4)
        let d_w = cuda_mem_alloc(sess, dim * 2)
        let d_out = cuda_mem_alloc(sess, total * 4)

        if d_x == 0 || d_w == 0 || d_out == 0 {
            pass = false
        } else {
            let _h2d0 = cuda_memcpy_h2d(sess, d_x, page_arena_ptr(&arena_x), total * 4)
            let _h2d1 = cuda_memcpy_h2d(sess, d_w, p_w, dim * 2)

            let rc = cuda_launch_6param_1d(sess, hfn, n_groups, 32, d_x, d_w, d_out, n_groups, dim, 0x358637bd)
            if rc != 0 {
                pass = false
            } else {
                let _d2h = cuda_memcpy_d2h(sess, page_arena_ptr(&arena_out), d_out, total * 4)

                var g: i64 = 0
                while g < n_groups {
                    var sum_sq: f64 = 0.0
                    var d: i64 = 0
                    while d < dim {
                        let v = ((((g * dim + d) % 17) - 8) as f64) * 0.125
                        sum_sq = sum_sq + v * v
                        d = d + 1
                    }
                    let inv_rms = 1.0 / sqrt(sum_sq / (dim as f64) + 0.000001)

                    d = 0
                    while d < dim {
                        let v = ((((g * dim + d) % 17) - 8) as f64) * 0.125
                        let expected = v * inv_rms * 1.0
                        let actual = read_f32_at(&arena_out, g * dim + d)
                        if abs_f64(actual - expected) >= 0.0001 {
                            pass = false
                        }
                        d = d + 1
                    }
                    g = g + 1
                }
            }
        }

        if d_x != 0 { let _f0 = cuda_mem_free(sess, d_x) }
        if d_w != 0 { let _f1 = cuda_mem_free(sess, d_w) }
        if d_out != 0 { let _f2 = cuda_mem_free(sess, d_out) }
    }

    let _c0 = page_arena_free(arena_x)
    let _c1 = page_arena_free(arena_w)
    let _c2 = page_arena_free(arena_out)
    pass
}

fn test_cuda_rope(sess: &CudaDriverSession, hfn: i64) -> bool with IO, Mut, Alloc {
    let n_heads = 4
    let head_dim = 64
    let total = n_heads * head_dim
    let pos = 3
    let theta = 1000000.0

    let arena_v = page_arena_alloc(total * 4)
    var pass = true

    if !page_arena_is_ok(&arena_v) {
        pass = false
    } else {
        var i: i64 = 0
        while i < total {
            let val = (((i % 23) - 11) as f64) * 0.125
            write_f32_at(&arena_v, i, val)
            i = i + 1
        }

        let d_v = cuda_mem_alloc(sess, total * 4)
        if d_v == 0 {
            pass = false
        } else {
            let _h2d = cuda_memcpy_h2d(sess, d_v, page_arena_ptr(&arena_v), total * 4)
            let rc = cuda_launch_6param_1d(sess, hfn, n_heads, 32, d_v, n_heads, head_dim, pos, 0x49742400, 0)
            if rc != 0 {
                pass = false
            } else {
                let _d2h = cuda_memcpy_d2h(sess, page_arena_ptr(&arena_v), d_v, total * 4)
                let half = head_dim / 2
                var h: i64 = 0
                while h < n_heads {
                    var j: i64 = 0
                    while j < half {
                        let freq = pow(theta, -((2 * j) as f64) / (head_dim as f64))
                        let angle = (pos as f64) * freq
                        let cos_a = cos(angle)
                        let sin_a = sin(angle)
                        let x0 = ((((h * head_dim + j) % 23) - 11) as f64) * 0.125
                        let x1 = ((((h * head_dim + j + half) % 23) - 11) as f64) * 0.125
                        let exp0 = x0 * cos_a - x1 * sin_a
                        let exp1 = x1 * cos_a + x0 * sin_a

                        let act0 = read_f32_at(&arena_v, h * head_dim + j)
                        let act1 = read_f32_at(&arena_v, h * head_dim + j + half)
                        if abs_f64(act0 - exp0) >= 0.0001 || abs_f64(act1 - exp1) >= 0.0001 {
                            pass = false
                        }
                        j = j + 1
                    }
                    h = h + 1
                }
            }
            let _f = cuda_mem_free(sess, d_v)
        }
    }

    let _c0 = page_arena_free(arena_v)
    pass
}

fn test_cuda_gemv(sess: &CudaDriverSession, hfn: i64) -> bool with IO, Mut, Alloc {
    let out_dim = 64
    let in_dim = 64
    let matrix_bytes = out_dim * in_dim * 2

    let arena_w = page_arena_alloc(matrix_bytes)
    let arena_x = page_arena_alloc(in_dim * 4)
    let arena_y = page_arena_alloc(out_dim * 4)
    var pass = true

    if !page_arena_is_ok(&arena_w) || !page_arena_is_ok(&arena_x) || !page_arena_is_ok(&arena_y) {
        pass = false
    } else {
        var c: i64 = 0
        var sum_x: f64 = 0.0
        while c < in_dim {
            let val = (((c % 4) + 1) as f64) * 0.25
            write_f32_at(&arena_x, c, val)
            sum_x = sum_x + val
            c = c + 1
        }

        let p_w = page_arena_ptr(&arena_w)
        var r: i64 = 0
        while r < out_dim {
            let w_val_bf16 = 0x3C00 + (r % 4) * 0x0080
            let quad_w = w_val_bf16 | (w_val_bf16 << 16) | (w_val_bf16 << 32) | (w_val_bf16 << 48)
            let row_base = p_w + r * in_dim * 2
            var k: i64 = 0
            while k < in_dim {
                let _w = ptr_write_i64_le(row_base, k * 2, quad_w)
                k = k + 4
            }
            r = r + 1
        }

        let d_w = cuda_mem_alloc(sess, matrix_bytes)
        let d_x = cuda_mem_alloc(sess, in_dim * 4)
        let d_y = cuda_mem_alloc(sess, out_dim * 4)

        if d_w == 0 || d_x == 0 || d_y == 0 {
            pass = false
        } else {
            let _h2d0 = cuda_memcpy_h2d(sess, d_w, p_w, matrix_bytes)
            let _h2d1 = cuda_memcpy_h2d(sess, d_x, page_arena_ptr(&arena_x), in_dim * 4)

            let rc = cuda_launch_6param_1d(sess, hfn, out_dim, 32, d_w, d_x, d_y, out_dim, in_dim, 0)
            if rc != 0 {
                pass = false
            } else {
                let _d2h = cuda_memcpy_d2h(sess, page_arena_ptr(&arena_y), d_y, out_dim * 4)
                r = 0
                while r < out_dim {
                    let w_float = 0.0078125 * pow(2.0, (r % 4) as f64)
                    let expected = w_float * sum_x
                    let actual = read_f32_at(&arena_y, r)
                    if abs_f64(actual - expected) >= 0.0001 {
                        pass = false
                    }
                    r = r + 1
                }
            }
        }

        if d_w != 0 { let _f0 = cuda_mem_free(sess, d_w) }
        if d_x != 0 { let _f1 = cuda_mem_free(sess, d_x) }
        if d_y != 0 { let _f2 = cuda_mem_free(sess, d_y) }
    }

    let _c0 = page_arena_free(arena_w)
    let _c1 = page_arena_free(arena_x)
    let _c2 = page_arena_free(arena_y)
    pass
}

fn test_cuda_swiglu(sess: &CudaDriverSession, hfn: i64) -> bool with IO, Mut, Alloc {
    let inter_dim = 256

    let arena_g = page_arena_alloc(inter_dim * 4)
    let arena_u = page_arena_alloc(inter_dim * 4)
    let arena_o = page_arena_alloc(inter_dim * 4)
    var pass = true

    if !page_arena_is_ok(&arena_g) || !page_arena_is_ok(&arena_u) || !page_arena_is_ok(&arena_o) {
        pass = false
    } else {
        var i: i64 = 0
        while i < inter_dim {
            let g_val = (((i % 19) - 9) as f64) * 0.125
            let u_val = (((i % 13) - 6) as f64) * 0.125
            write_f32_at(&arena_g, i, g_val)
            write_f32_at(&arena_u, i, u_val)
            i = i + 1
        }

        let d_g = cuda_mem_alloc(sess, inter_dim * 4)
        let d_u = cuda_mem_alloc(sess, inter_dim * 4)
        let d_o = cuda_mem_alloc(sess, inter_dim * 4)

        if d_g == 0 || d_u == 0 || d_o == 0 {
            pass = false
        } else {
            let _h2d0 = cuda_memcpy_h2d(sess, d_g, page_arena_ptr(&arena_g), inter_dim * 4)
            let _h2d1 = cuda_memcpy_h2d(sess, d_u, page_arena_ptr(&arena_u), inter_dim * 4)

            let rc = cuda_launch_6param_1d(sess, hfn, inter_dim, 32, d_g, d_u, d_o, inter_dim, 0, 0)
            if rc != 0 {
                pass = false
            } else {
                let _d2h = cuda_memcpy_d2h(sess, page_arena_ptr(&arena_o), d_o, inter_dim * 4)
                i = 0
                while i < inter_dim {
                    let g_val = (((i % 19) - 9) as f64) * 0.125
                    let u_val = (((i % 13) - 6) as f64) * 0.125
                    let silu_g = g_val / (1.0 + exp(-g_val))
                    let expected = silu_g * u_val
                    let actual = read_f32_at(&arena_o, i)
                    if abs_f64(actual - expected) >= 0.0001 {
                        pass = false
                    }
                    i = i + 1
                }
            }
        }

        if d_g != 0 { let _f0 = cuda_mem_free(sess, d_g) }
        if d_u != 0 { let _f1 = cuda_mem_free(sess, d_u) }
        if d_o != 0 { let _f2 = cuda_mem_free(sess, d_o) }
    }

    let _c0 = page_arena_free(arena_g)
    let _c1 = page_arena_free(arena_u)
    let _c2 = page_arena_free(arena_o)
    pass
}

fn test_cuda_paged_gqa(sess: &CudaDriverSession, hfn: i64) -> bool with IO, Mut, Alloc {
    let n_q = 8
    let n_kv = 2
    let head_dim = 64
    let seq_len = 8
    let block_size = 16

    let arena_q = page_arena_alloc(n_q * head_dim * 4)
    let arena_k = page_arena_alloc(block_size * n_kv * head_dim * 4)
    let arena_v = page_arena_alloc(block_size * n_kv * head_dim * 4)
    let arena_table = page_arena_alloc(16 * 4)
    let arena_out = page_arena_alloc(n_q * head_dim * 4)
    let arena_scores = page_arena_alloc(seq_len * 4)
    var pass = true

    if !page_arena_is_ok(&arena_q) || !page_arena_is_ok(&arena_k) || !page_arena_is_ok(&arena_v)
        || !page_arena_is_ok(&arena_table) || !page_arena_is_ok(&arena_out) || !page_arena_is_ok(&arena_scores) {
        pass = false
    } else {
        let p_table = page_arena_ptr(&arena_table)
        let _wt = ptr_write_u32_le(p_table, 0, 0)

        var i: i64 = 0
        while i < n_q * head_dim {
            let v = (((i % 11) - 5) as f64) * 0.0625
            write_f32_at(&arena_q, i, v)
            i = i + 1
        }

        var pos: i64 = 0
        while pos < seq_len {
            var kv_h: i64 = 0
            while kv_h < n_kv {
                var d: i64 = 0
                while d < head_dim {
                    let kv_idx = (pos * n_kv + kv_h) * head_dim + d
                    let val_k = ((((pos + kv_h + d) % 9) - 4) as f64) * 0.0625
                    let val_v = ((((pos * 2 + kv_h + d) % 7) - 3) as f64) * 0.125
                    write_f32_at(&arena_k, kv_idx, val_k)
                    write_f32_at(&arena_v, kv_idx, val_v)
                    d = d + 1
                }
                kv_h = kv_h + 1
            }
            pos = pos + 1
        }

        let d_q = cuda_mem_alloc(sess, n_q * head_dim * 4)
        let d_k = cuda_mem_alloc(sess, block_size * n_kv * head_dim * 4)
        let d_v = cuda_mem_alloc(sess, block_size * n_kv * head_dim * 4)
        let d_table = cuda_mem_alloc(sess, 16 * 4)
        let d_out = cuda_mem_alloc(sess, n_q * head_dim * 4)

        if d_q == 0 || d_k == 0 || d_v == 0 || d_table == 0 || d_out == 0 {
            pass = false
        } else {
            let _h2d0 = cuda_memcpy_h2d(sess, d_q, page_arena_ptr(&arena_q), n_q * head_dim * 4)
            let _h2d1 = cuda_memcpy_h2d(sess, d_k, page_arena_ptr(&arena_k), block_size * n_kv * head_dim * 4)
            let _h2d2 = cuda_memcpy_h2d(sess, d_v, page_arena_ptr(&arena_v), block_size * n_kv * head_dim * 4)
            let _h2d3 = cuda_memcpy_h2d(sess, d_table, p_table, 16 * 4)

            let cfg = (n_kv & 65535) | ((head_dim & 65535) << 16) | ((block_size & 65535) << 32)
            let rc = cuda_launch_8param_1d(sess, hfn, n_q, 32, d_q, d_k, d_v, d_table, d_out, n_q, seq_len, cfg)
            if rc != 0 {
                pass = false
            } else {
                let _d2h = cuda_memcpy_d2h(sess, page_arena_ptr(&arena_out), d_out, n_q * head_dim * 4)

                let scale = 1.0 / sqrt(head_dim as f64)
                let group_size = n_q / n_kv

                var q_h: i64 = 0
                while q_h < n_q {
                    let kv_h = q_h / group_size
                    var max_s: f64 = -1000000.0

                    pos = 0
                    while pos < seq_len {
                        var dot: f64 = 0.0
                        var d: i64 = 0
                        while d < head_dim {
                            let q_val = ((((q_h * head_dim + d) % 11) - 5) as f64) * 0.0625
                            let k_val = ((((pos + kv_h + d) % 9) - 4) as f64) * 0.0625
                            dot = dot + q_val * k_val
                            d = d + 1
                        }
                        let s = dot * scale
                        if s > max_s { max_s = s }
                        write_f32_at(&arena_scores, pos, s)
                        pos = pos + 1
                    }

                    var denom: f64 = 0.0
                    pos = 0
                    while pos < seq_len {
                        let s = read_f32_at(&arena_scores, pos)
                        denom = denom + exp(s - max_s)
                        pos = pos + 1
                    }

                    var d: i64 = 0
                    while d < head_dim {
                        var acc: f64 = 0.0
                        pos = 0
                        while pos < seq_len {
                            let s = read_f32_at(&arena_scores, pos)
                            let weight = exp(s - max_s) / denom
                            let v_val = ((((pos * 2 + kv_h + d) % 7) - 3) as f64) * 0.125
                            acc = acc + weight * v_val
                            pos = pos + 1
                        }
                        let actual = read_f32_at(&arena_out, q_h * head_dim + d)
                        if abs_f64(actual - acc) >= 0.0001 {
                            pass = false
                        }
                        d = d + 1
                    }
                    q_h = q_h + 1
                }
            }
        }

        if d_q != 0 { let _f0 = cuda_mem_free(sess, d_q) }
        if d_k != 0 { let _f1 = cuda_mem_free(sess, d_k) }
        if d_v != 0 { let _f2 = cuda_mem_free(sess, d_v) }
        if d_table != 0 { let _f3 = cuda_mem_free(sess, d_table) }
        if d_out != 0 { let _f4 = cuda_mem_free(sess, d_out) }
    }

    let _c0 = page_arena_free(arena_q)
    let _c1 = page_arena_free(arena_k)
    let _c2 = page_arena_free(arena_v)
    let _c3 = page_arena_free(arena_table)
    let _c4 = page_arena_free(arena_out)
    let _c5 = page_arena_free(arena_scores)
    pass
}

fn main() -> i32 with IO, Mut, Alloc {
    let sess = cuda_session_open("", 0)
    var ok = false
    if !cuda_session_is_ok(&sess) {
        println("FAIL: cuda_session_open")
    } else {
        let ptx_cstr = emit_qwen3_kernels_ptx_cstr()
        let hmod = cuda_module_load_ptx_ptr(&sess, ptx_cstr)
        heap_free(ptx_cstr as *mut u8)

        if hmod == 0 {
            println("FAIL: cuda_module_load_ptx_ptr")
        } else {
            let fn_rmsnorm = cuda_module_get_fn(&sess, hmod, "qwen3_rmsnorm_bf16")
            let fn_rope = cuda_module_get_fn(&sess, hmod, "qwen3_rope_f32")
            let fn_gemv = cuda_module_get_fn(&sess, hmod, "qwen3_bf16_gemv_f32")
            let fn_swiglu = cuda_module_get_fn(&sess, hmod, "qwen3_swiglu_f32")
            let fn_paged_gqa = cuda_module_get_fn(&sess, hmod, "qwen3_paged_gqa_f32")

            if fn_rmsnorm == 0 || fn_rope == 0 || fn_gemv == 0 || fn_swiglu == 0 || fn_paged_gqa == 0 {
                println("FAIL: cuda_module_get_fn")
            } else {
                let ok_norm = test_cuda_rmsnorm(&sess, fn_rmsnorm)
                if !ok_norm {
                    println("FAIL: test_cuda_rmsnorm")
                } else {
                    let ok_rope = test_cuda_rope(&sess, fn_rope)
                    if !ok_rope {
                        println("FAIL: test_cuda_rope")
                    } else {
                        let ok_gemv = test_cuda_gemv(&sess, fn_gemv)
                        if !ok_gemv {
                            println("FAIL: test_cuda_gemv")
                        } else {
                            let ok_swiglu = test_cuda_swiglu(&sess, fn_swiglu)
                            if !ok_swiglu {
                                println("FAIL: test_cuda_swiglu")
                            } else {
                                let ok_gqa = test_cuda_paged_gqa(&sess, fn_paged_gqa)
                                if !ok_gqa {
                                    println("FAIL: test_cuda_paged_gqa")
                                } else {
                                    ok = true
                                }
                            }
                        }
                    }
                }
            }
            let _u = cuda_module_unload(&sess, hmod)
        }
    }

    let _sc = cuda_session_close(sess)
    if ok {
        println("LLM_PHASE2_LINUX_PTX_KERNELS_PASS")
        0
    } else {
        1
    }
}
