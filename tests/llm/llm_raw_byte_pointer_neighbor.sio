//@ run-pass
//@ requires: madaros
pub fn main() -> i64 with IO, Alloc, Mut, Panic {
    let base = heap_alloc(16) as i64
    let p = base as *mut i64
    (*p) = 0x1122334455667788
    let b = (base + 1) as *mut u8
    (*b) = 255 as u8
    let signed = (base + 1) as *mut i8
    let unsigned_value = (*b) as i64
    let signed_value = (*signed) as i64
    let actual = (*p)
    heap_free(base as *mut u8)
    print("unsigned=")
    print_int(unsigned_value)
    print(" signed=")
    print_int(signed_value)
    print(" word=")
    print_int(actual)
    println("")
    if actual == 0x112233445566ff88 && unsigned_value == 255 && signed_value == -1 {
        println("LLM_RAW_BYTE_POINTER_NEIGHBOR_PASS")
        return 0
    }
    println("LLM_RAW_BYTE_POINTER_NEIGHBOR_FAIL")
    1
}
