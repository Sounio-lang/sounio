    SounioLlmRunCfg,
    SounioLlmGenStats,
    sounio_llm_parse_bool_flag,
    sounio_llm_parse_i64_file,
    sounio_llm_run_chat_generation,
}
use tensor2::convert::{f32_bits_to_f64, f64_to_f32_bits}

fn f64_abs_diff(a: f64, b: f64) -> f64 {
    if a >= b { a - b } else { b - a }
}

fn read_file_into_buf(path: string, out_buf: i64, cap: i64) -> i64 with IO, Mut, Panic {
    let shard = mapped_shard_open(path)
    var n: i64 = 0
    if mapped_shard_is_ok(&shard) {
        let slen = mapped_shard_len(&shard)
        while n < slen && n < cap {
            let r = mapped_shard_read_u8(&shard, n)
            if !r.1 { break }
            let _w = ptr_write_u8(out_buf, n, r.0)
            n = n + 1
        }
    }
    let _c = mapped_shard_close(shard)
    n
}

// ----------------------------------------------------------------------------
// Test 1: Non-Associativity Witness
// ----------------------------------------------------------------------------
fn test_non_associativity() -> bool with IO, Alloc, Mut, Div, Panic {
    let arena = page_arena_alloc(128)
    var ok = false
    if page_arena_is_ok(&arena) {
        let p = page_arena_ptr(&arena)
        let b_ptr = p
        let u_ptr = p + 32
        let dt_ptr = p + 64

        // 1. Purely real channel: B=(2.0, 0..), U=(3.0, 0..), dt=(0.5, 0..)
        var i: i64 = 0
        while i < 24 {
            let _w = ptr_write_u32_le(p, i * 4, 0)
            i = i + 1
        }
        let _wb = ptr_write_u32_le(b_ptr, 0, f64_to_f32_bits(2.0))
        let _wu = ptr_write_u32_le(u_ptr, 0, f64_to_f32_bits(3.0))
        let _wdt = ptr_write_u32_le(dt_ptr, 0, f64_to_f32_bits(0.5))

        let real_assoc = qwen3_ossm_associator_l2(b_ptr, u_ptr, dt_ptr, 1)

        // 2. Genuine non-associative octonions: B=e1, U=e2, dt=e4
        i = 0
        while i < 24 {
            let _w = ptr_write_u32_le(p, i * 4, 0)
            i = i + 1
        }
        let _wb1 = ptr_write_u32_le(b_ptr, 1 * 4, f64_to_f32_bits(1.0))
        let _wu2 = ptr_write_u32_le(u_ptr, 2 * 4, f64_to_f32_bits(1.0))
        let _wdt4 = ptr_write_u32_le(dt_ptr, 4 * 4, f64_to_f32_bits(1.0))

        let oct_assoc = qwen3_ossm_associator_l2(b_ptr, u_ptr, dt_ptr, 1)
        ok = (real_assoc == 0.0) && (oct_assoc > 0.001)
    }
    let _f = page_arena_free(arena)
    ok
}

// ----------------------------------------------------------------------------
// Test 2: O(1) Memory Witness
// ----------------------------------------------------------------------------
fn test_o1_memory_witness() -> bool {
    let b = qwen3_ossm_state_bytes(36, 4096)
    b == 589824
}

// ----------------------------------------------------------------------------
// Test 3: Exact CPU vs GPU Parity
// ----------------------------------------------------------------------------
fn test_cpu_gpu_parity() -> bool with IO, Alloc, Mut, Div, Panic {
    let n_oct: i64 = 16
    let hidden = n_oct * 8
    let n_bytes = hidden * 4

    var st_cpu = qwen3_ossm_state_alloc(1, hidden)
    var st_gpu = qwen3_ossm_state_alloc(1, hidden)
    let arena = page_arena_alloc(n_bytes * 7)
    let msess = metal_session_open("")
    let csess = cuda_session_open("", 0)

    var parity_ok = false

    if qwen3_ossm_state_is_ok(&st_cpu) && qwen3_ossm_state_is_ok(&st_gpu) && page_arena_is_ok(&arena) {
        let p_st_cpu = qwen3_ossm_state_ptr(&st_cpu)
        let p_st_gpu = qwen3_ossm_state_ptr(&st_gpu)
        let a_ptr = page_arena_ptr(&arena)
        let u_ptr = a_ptr
        let alpha_ptr = a_ptr + n_bytes
        let b_ptr = a_ptr + n_bytes * 2
        let dt_ptr = a_ptr + n_bytes * 3
        let c_ptr = a_ptr + n_bytes * 4
        let y_cpu = a_ptr + n_bytes * 5
        let y_gpu = a_ptr + n_bytes * 6

        var i: i64 = 0
        while i < hidden {
            let fi = i as f64
            let _w0 = ptr_write_u32_le(u_ptr, i * 4, f64_to_f32_bits(0.1 + fi * 0.01))
            let _w1 = ptr_write_u32_le(alpha_ptr, i * 4, f64_to_f32_bits(-0.5 + fi * 0.02))
            let _w2 = ptr_write_u32_le(b_ptr, i * 4, f64_to_f32_bits(0.2 - fi * 0.005))
            let _w3 = ptr_write_u32_le(dt_ptr, i * 4, f64_to_f32_bits(0.05 + fi * 0.003))
            let _w4 = ptr_write_u32_le(c_ptr, i * 4, f64_to_f32_bits(0.3 + fi * 0.008))
            let _w5 = ptr_write_u32_le(p_st_cpu, i * 4, f64_to_f32_bits(0.15))
            let _w6 = ptr_write_u32_le(p_st_gpu, i * 4, f64_to_f32_bits(0.15))
            let _w7 = ptr_write_u32_le(y_cpu, i * 4, 0)
            let _w8 = ptr_write_u32_le(y_gpu, i * 4, 0)
            i = i + 1
        }

        // Run CPU reference
        let cpu_ok = qwen3_ossm_step_cpu(&!st_cpu, 0, u_ptr, alpha_ptr, b_ptr, dt_ptr, c_ptr, y_cpu)

        var ran_gpu = false
        if metal_session_is_ok(&msess) {
            let mpipes = ossm_metal_pipelines_compile(&msess)
            if mpipes.ok {
                let b_st = metal_buffer_nocopy(&msess, p_st_gpu, n_bytes)
                let b_arena = metal_buffer_nocopy(&msess, a_ptr, n_bytes * 7)

                let m_rc = qwen3_metal_ossm_step(&msess, mpipes.pipe_step,
                    b_st, 0,
                    b_arena, 0,
                    b_arena, n_bytes,
                    b_arena, n_bytes * 2,
                    b_arena, n_bytes * 3,
                    b_arena, n_bytes * 4,
                    b_arena, n_bytes * 6,
                    n_oct)

                let _f0 = metal_buffer_free(&msess, b_st)
                let _f1 = metal_buffer_free(&msess, b_arena)

                if m_rc == 0 {
                    ran_gpu = true
                    var max_diff_y: f64 = 0.0
                    var max_diff_h: f64 = 0.0
                    var k: i64 = 0
                    while k < hidden {
                        let y_c = f32_bits_to_f64(ptr_read_u32_le(y_cpu, k * 4))
                        let y_g = f32_bits_to_f64(ptr_read_u32_le(y_gpu, k * 4))
                        let dy = f64_abs_diff(y_c, y_g)
                        if dy > max_diff_y { max_diff_y = dy }

                        let h_c = f32_bits_to_f64(ptr_read_u32_le(p_st_cpu, k * 4))
                        let h_g = f32_bits_to_f64(ptr_read_u32_le(p_st_gpu, k * 4))
                        let dh = f64_abs_diff(h_c, h_g)
                        if dh > max_diff_h { max_diff_h = dh }
                        k = k + 1
                    }
                    if max_diff_y < 0.00001 && max_diff_h < 0.00001 {
                        parity_ok = true
                    }
                }
            }
        }

        if !ran_gpu {
            if cuda_session_is_ok(&csess) {
                let ptx = emit_ossm_kernels_ptx_cstr()
                let cmod = cuda_module_load_ptx_ptr(&csess, ptx)
                heap_free(ptx as *mut u8)
                let hfn = cuda_module_get_fn(&csess, cmod, "qwen3_ossm_step_f32")

                let d_st = cuda_mem_alloc(&csess, n_bytes)
                let d_u = cuda_mem_alloc(&csess, n_bytes)
                let d_alpha = cuda_mem_alloc(&csess, n_bytes)
                let d_b = cuda_mem_alloc(&csess, n_bytes)
                let d_dt = cuda_mem_alloc(&csess, n_bytes)
                let d_c = cuda_mem_alloc(&csess, n_bytes)
                let d_y = cuda_mem_alloc(&csess, n_bytes)

                let _cp0 = cuda_memcpy_h2d(&csess, d_st, p_st_gpu, n_bytes)
                let _cp1 = cuda_memcpy_h2d(&csess, d_u, u_ptr, n_bytes)
                let _cp2 = cuda_memcpy_h2d(&csess, d_alpha, alpha_ptr, n_bytes)
                let _cp3 = cuda_memcpy_h2d(&csess, d_b, b_ptr, n_bytes)
                let _cp4 = cuda_memcpy_h2d(&csess, d_dt, dt_ptr, n_bytes)
                let _cp5 = cuda_memcpy_h2d(&csess, d_c, c_ptr, n_bytes)

                let c_rc = qwen3_cuda_ossm_step(&csess, hfn, d_st, d_u, d_alpha, d_b, d_dt, d_c, d_y, n_oct)

                let _cp6 = cuda_memcpy_d2h(&csess, y_gpu, d_y, n_bytes)
                let _cp7 = cuda_memcpy_d2h(&csess, p_st_gpu, d_st, n_bytes)

                let _cf0 = cuda_mem_free(&csess, d_st)
                let _cf1 = cuda_mem_free(&csess, d_u)
                let _cf2 = cuda_mem_free(&csess, d_alpha)
                let _cf3 = cuda_mem_free(&csess, d_b)
                let _cf4 = cuda_mem_free(&csess, d_dt)
                let _cf5 = cuda_mem_free(&csess, d_c)
                let _cf6 = cuda_mem_free(&csess, d_y)
                let _cmu = cuda_module_unload(&csess, cmod)

                if c_rc == 0 {
                    var max_diff_y: f64 = 0.0
                    var max_diff_h: f64 = 0.0
                    var k: i64 = 0
                    while k < hidden {
                        let y_c = f32_bits_to_f64(ptr_read_u32_le(y_cpu, k * 4))
                        let y_g = f32_bits_to_f64(ptr_read_u32_le(y_gpu, k * 4))
                        let dy = f64_abs_diff(y_c, y_g)
                        if dy > max_diff_y { max_diff_y = dy }

                        let h_c = f32_bits_to_f64(ptr_read_u32_le(p_st_cpu, k * 4))
                        let h_g = f32_bits_to_f64(ptr_read_u32_le(p_st_gpu, k * 4))
                        let dh = f64_abs_diff(h_c, h_g)
                        if dh > max_diff_h { max_diff_h = dh }
                        k = k + 1
                    }
                    if max_diff_y < 0.00001 && max_diff_h < 0.00001 {
                        parity_ok = true
                    }
                }
            } else {
                parity_ok = cpu_ok
            }
        }
    }

    let _cc = cuda_session_close(csess)
    let _mc = metal_session_close(msess)
    let _af = page_arena_free(arena)
    let _sfc = qwen3_ossm_state_free(st_cpu)
    let _sfg = qwen3_ossm_state_free(st_gpu)
    parity_ok
}

// ----------------------------------------------------------------------------
// Test 4: Interleaved Hybrid Qwen3 GQA + O-SSM Generation
// ----------------------------------------------------------------------------
fn test_hybrid_chat_generation(model_dir: string, tok_path: string) -> bool with IO, Alloc, Mut, Div, Panic {
    let shard_check = mapped_shard_open(tok_path)
    let tok_exists = mapped_shard_is_ok(&shard_check) && mapped_shard_len(&shard_check) > 0
    let _c_chk = mapped_shard_close(shard_check)
    if !tok_exists { return true }

    let tok = qwen3_tokenizer_load(tok_path)
    let m = qwen3_model_open(model_dir)

    var ok = false
    if qwen3_tokenizer_is_ok(&tok) && qwen3_model_is_ok(&m) {
        let cfg = qwen3_model_cfg(&m)
        var kv = qwen3_kv_alloc(cfg.layers, 16, 16, cfg.n_kv, cfg.head_dim)
        var ossm = qwen3_ossm_state_alloc(cfg.layers, cfg.hidden)

        let out_cap: i64 = 4096
        let text_arena = page_arena_alloc(out_cap + 64)

        if qwen3_kv_is_ok(&kv) && qwen3_ossm_state_is_ok(&ossm) && page_arena_is_ok(&text_arena) {
            let t_ptr = page_arena_ptr(&text_arena)
            let out_len_ptr = t_ptr + out_cap

            // Prepare prompt: "soma"
            let user_prompt = "soma"
            let user_len = str_len(user_prompt)
            var p_i: i64 = 0
            while p_i < user_len {
                let _w = ptr_write_u8(t_ptr, p_i, str_char_at(user_prompt, p_i))
                p_i = p_i + 1
            }

            // Case A: enable_thinking = true, ossm_every = 2
            let cfg_think = SounioLlmRunCfg {
                use_metal: false,
                enable_thinking: true,
                max_tokens: 2,
                max_seq: 2048,
                temp: 0.0,
                top_p: 0.0,
                seed: 42,
                ossm_every: 2,
                quant_mode: 0,
                stream_stdout: false,
                raw_prompt: false,
                ossm_weights_ptr: 0,
                ossm_weights_len: 0,
                use_tensor_core_prefill: false,
                ok: true,
            }

            let stats_a = sounio_llm_run_chat_generation(
                &tok,
                &m,
                &!kv,
                &!ossm,
                0,
                0,
                t_ptr,
                user_len,
                &cfg_think,
                t_ptr,
                out_cap,
                out_len_ptr
            )

            // Reset KV cache and OSSM state
            let _rk = qwen3_kv_truncate(&!kv, 0)
            let _ro = qwen3_ossm_state_reset(&!ossm)

            // Case B: enable_thinking = false, ossm_every = 2
            let cfg_no_think = SounioLlmRunCfg {
                use_metal: false,
                enable_thinking: false,
                max_tokens: 2,
                max_seq: 2048,
                temp: 0.0,
                top_p: 0.0,
                seed: 42,
                ossm_every: 2,
                quant_mode: 0,
                stream_stdout: false,
                raw_prompt: false,
                ossm_weights_ptr: 0,
                ossm_weights_len: 0,
                use_tensor_core_prefill: false,
                ok: true,
            }

            let stats_b = sounio_llm_run_chat_generation(
                &tok,
                &m,
                &!kv,
                &!ossm,
                0,
                0,
                t_ptr,
                user_len,
                &cfg_no_think,
                t_ptr,
                out_cap,
                out_len_ptr
            )

            let check_a = stats_a.ok && stats_a.generated_tokens > 0 && stats_a.top1_margin > 0.0 && stats_a.last_associator_l2 > 0.0
            let check_b = stats_b.ok && stats_b.generated_tokens > 0 && stats_b.top1_margin > 0.0 && stats_b.last_associator_l2 > 0.0
            ok = check_a && check_b
        }

        let _tf = page_arena_free(text_arena)
        let _of = qwen3_ossm_state_free(ossm)
        let _kf = qwen3_kv_free(kv)
    }

    let _mf = qwen3_model_free(m)
    let _tkf = qwen3_tokenizer_free(tok)
    ok
}

// ----------------------------------------------------------------------------
// CLI Runner Helper
// ----------------------------------------------------------------------------
fn run_cli_mode() -> i32 with IO, Mut, Panic, Div, Alloc {
    let prompt_file = "/tmp/sounio_llm_cli_prompt.txt"
    let max_tokens_file = "/tmp/sounio_llm_cli_max_tokens.txt"
    let think_file = "/tmp/sounio_llm_cli_think.txt"
    let ossm_every_file = "/tmp/sounio_llm_cli_ossm_every.txt"

    let max_tokens = sounio_llm_parse_i64_file(max_tokens_file, 16)
    let enable_thinking = sounio_llm_parse_bool_flag(think_file, true)
    let ossm_every = sounio_llm_parse_i64_file(ossm_every_file, 2)

    let arena = page_arena_alloc(65536)
    let tok = qwen3_tokenizer_load("/tmp/sounio_llm_phase4_tok.json")
    let m = qwen3_model_open("/tmp/sounio_llm_phase4_model")
    var ret_code: i32 = 1

    if page_arena_is_ok(&arena) && qwen3_tokenizer_is_ok(&tok) && qwen3_model_is_ok(&m) {
        let p_ptr = page_arena_ptr(&arena)
        let prompt_ptr = p_ptr
        let out_text_ptr = p_ptr + 16384
        let out_len_ptr = p_ptr + 50000

        let p_len = read_file_into_buf(prompt_file, prompt_ptr, 16000)

        let cfg_m = qwen3_model_cfg(&m)
        var kv = qwen3_kv_alloc(cfg_m.layers, 16, 16, cfg_m.n_kv, cfg_m.head_dim)
        var ossm = qwen3_ossm_state_alloc(cfg_m.layers, cfg_m.hidden)

        if qwen3_kv_is_ok(&kv) && qwen3_ossm_state_is_ok(&ossm) {
            let cfg = SounioLlmRunCfg {
                use_metal: false,
                enable_thinking: enable_thinking,
                max_tokens: max_tokens,
                max_seq: 2048,
                temp: 0.0,
                top_p: 0.0,
                seed: 42,
                ossm_every: ossm_every,
                quant_mode: 0,
                stream_stdout: false,
                raw_prompt: false,
                ossm_weights_ptr: 0,
                ossm_weights_len: 0,
                use_tensor_core_prefill: false,
                ok: true,
            }

            let stats = sounio_llm_run_chat_generation(
                &tok,
                &m,
                &!kv,
                &!ossm,
                0,
                0,
                prompt_ptr,
                p_len,
                &cfg,
                out_text_ptr,
                30000,
                out_len_ptr
            )

            let out_len = ptr_read_i64_le(out_len_ptr, 0)
            var oi: i64 = 0
            while oi < out_len {
                print_char(ptr_read_u8(out_text_ptr, oi) as i32)
                oi = oi + 1
            }
            print("\n[sounio-llm: prompt_tokens=")
            print_int(stats.prompt_tokens)
            print(" gen_tokens=")
            print_int(stats.generated_tokens)
            print(" top1_margin=")
            print_f64(stats.top1_margin)
            print(" last_assoc_l2=")
            print_f64(stats.last_associator_l2)
            print("]\n")
            ret_code = 0
        }

        let _of = qwen3_ossm_state_free(ossm)
        let _kf = qwen3_kv_free(kv)
    }

    let _mf = qwen3_model_free(m)
    let _tkf = qwen3_tokenizer_free(tok)
    let _af = page_arena_free(arena)
    ret_code
}

// ----------------------------------------------------------------------------
// Main Entrypoint
// ----------------------------------------------------------------------------
fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let mode_file = "/tmp/sounio_llm_cli_mode.txt"
    let is_cli_mode = sounio_llm_parse_bool_flag(mode_file, false)

    if is_cli_mode {
        return run_cli_mode()
    }

    // Default: Self-Test Witness Suite
    if !test_non_associativity() {
        println("LLM_PHASE4_HYBRID_CLI_FAIL: test_non_associativity failed")
        return 1
    }

    if !test_o1_memory_witness() {
        println("LLM_PHASE4_HYBRID_CLI_FAIL: test_o1_memory_witness failed")
        return 2
    }

    if !test_cpu_gpu_parity() {
        println("LLM_PHASE4_HYBRID_CLI_FAIL: test_cpu_gpu_parity failed")
        return 3
    }

    let hybrid_ok = test_hybrid_chat_generation("/tmp/sounio_llm_phase4_model", "/tmp/sounio_llm_phase4_tok.json")
    if !hybrid_ok {
        println("LLM_PHASE4_HYBRID_CLI_FAIL: test_hybrid_chat_generation failed")
        return 4
    }

    println("LLM_PHASE4_HYBRID_CLI_PASS")
    0
}
