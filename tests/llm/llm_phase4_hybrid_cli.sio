//@ run-pass
//@ requires: madaros
//@ expect-stdout: LLM_PHASE4_HYBRID_CLI_PASS
//
// Phase 4 witness: Hybrid Qwen3 GQA + O-SSM Inference Engine & CLI Driver.
//
// Verifies:
// 1. Non-associativity witness:
//    - Real channel associator L2 == 0.0
//    - Non-associative octonions (e1, e2, e4) associator L2 > 0.001
// 2. O(1) memory witness:
//    - qwen3_ossm_state_bytes(36, 4096) == 589824
// 3. Exact CPU vs GPU parity for qwen3_ossm_step_f32 (< 1e-5 on Metal NoCopy & CUDA PTX witness)
// 4. Interleaved Hybrid Qwen3 GQA + O-SSM (ossm_every = 2) multi-token chat generation:
//    - enable_thinking = true and enable_thinking = false
//    - Decoded output length > 0
//    - Non-zero top1_margin
//    - Non-zero last_associator_l2 > 0.0

use llm::mmap::{
    PageArena,
    page_arena_alloc,
    page_arena_free,
    page_arena_is_ok,
    page_arena_ptr,
    MappedShard,
    mapped_shard_open,
    mapped_shard_close,
    mapped_shard_is_ok,
    mapped_shard_len,
    mapped_shard_read_u8,
}
use llm::qwen3::{
    Qwen3Model,
    qwen3_model_open,
    qwen3_model_free,
    qwen3_model_is_ok,
    qwen3_model_cfg,
}
use llm::qwen3_paged_kv::{
    Qwen3PagedKv,
    qwen3_kv_alloc,
    qwen3_kv_free,
    qwen3_kv_is_ok,
    qwen3_kv_truncate,
}
use llm::qwen3_tokenizer::{
    Qwen3Tokenizer,
    qwen3_tokenizer_is_ok,
    qwen3_tokenizer_load,
    qwen3_tokenizer_free,
}
use llm::hal::{
    MetalSession,
    metal_session_open,
    metal_session_close,
    metal_session_is_ok,
    metal_buffer_nocopy,
    metal_buffer_free,
    CudaDriverSession,
    cuda_session_open,
    cuda_session_close,
    cuda_session_is_ok,
    cuda_module_load_ptx_ptr,
    cuda_module_unload,
    cuda_module_get_fn,
    cuda_mem_alloc,
    cuda_mem_free,
    cuda_memcpy_h2d,
    cuda_memcpy_d2h,
}
use llm::qwen3_ossm::{
    qwen3_ossm_associator_l2,
    Qwen3OssmState,
    qwen3_ossm_state_alloc,
    qwen3_ossm_state_free,
    qwen3_ossm_state_reset,
    qwen3_ossm_state_is_ok,
    qwen3_ossm_state_ptr,
    qwen3_ossm_state_bytes,
    qwen3_ossm_step_cpu,
    emit_ossm_kernels_msl_cstr,
    ossm_metal_pipelines_compile,
    qwen3_metal_ossm_step,
    emit_ossm_kernels_ptx_cstr,
    qwen3_cuda_ossm_step,
}
