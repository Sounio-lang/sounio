//@ run-pass
//@ requires: madaros
// Requires the pinned Granite tokenizer.json path as argv[1]. These explicit
// vocabulary controls supplement, not replace, the 480-prompt offline oracle.
use llm::qwen3_tokenizer::{granite_tokenizer_load, qwen3_encode_str, qwen3_tokenizer_is_ok, qwen3_tokenizer_free}
use llm::raw_memory::{ptr_read_i64_le}

pub fn main(argc: i32, argv: i64) -> i64 with IO, Alloc, Mut, Div, Panic {
    if argc != 2 { return 1 }
    let path = ptr_read_i64_le(argv, 8)
    let tok = granite_tokenizer_load((path as *mut u8) as string)
    if !qwen3_tokenizer_is_ok(&tok) { println("GRANITE_TOKENIZER_LOAD_FAIL"); let _f = qwen3_tokenizer_free(tok); return 2 }
    let ids = heap_alloc(128) as i64
    var ok = ids != 0
    if ok {
        let n0 = qwen3_encode_str(&tok, "hello", ids, 16)
        if n0 != 1 || ptr_read_i64_le(ids, 0) != 7656 { ok = false }
        let n1 = qwen3_encode_str(&tok, " hello!", ids, 16)
        if n1 != 2 || ptr_read_i64_le(ids, 0) != 17964 || ptr_read_i64_le(ids, 8) != 19 { ok = false }
        let n2 = qwen3_encode_str(&tok, "123", ids, 16)
        if n2 != 3 || ptr_read_i64_le(ids, 0) != 35 || ptr_read_i64_le(ids, 8) != 36 || ptr_read_i64_le(ids, 16) != 37 { ok = false }
        let n3 = qwen3_encode_str(&tok, "<|start_of_role|><|end_of_role|><|end_of_text|><|tool_call|>", ids, 16)
        if n3 != 4 || ptr_read_i64_le(ids, 0) != 49152 || ptr_read_i64_le(ids, 8) != 49153 || ptr_read_i64_le(ids, 16) != 0 || ptr_read_i64_le(ids, 24) != 49154 { ok = false }
        heap_free(ids as *mut u8)
    }
    let _f = qwen3_tokenizer_free(tok)
    println(if ok { "GRANITE_TOKENIZER_SMOKE_PASS" } else { "GRANITE_TOKENIZER_SMOKE_FAIL" })
    if ok { 0 } else { 3 }
}
