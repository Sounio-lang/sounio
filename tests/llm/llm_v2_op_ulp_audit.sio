//@ run-pass
//@ requires: madaros
//@ expect-stdout: ULP_AUDIT_DONE
//
// Cross-Backend Metal vs PTX FP32 Divergence Localization Diagnostic.
// Does NOT modify any production kernels. Dumps binary IEEE-754 f32 records:
//   [magic:u32=0x554C5031 "ULP1"][tag_len:u32][tag:u8*tag_len][count:u32][f32*count]

