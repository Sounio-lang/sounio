//@ run-pass
//@ requires: madaros
//
// Option A Acceptance Part 2:
// Runs greedy SIMT BF16 inference over a prompt file (default max_tokens=128) on Metal or Audit CUDA PTX.
// Line 1 carries:
//   # run_header binary_sha256=<64hex> float_model="binary32, round-to-nearest-even, FTZ+DAZ, fixed op order" backend=<metal|cuda_audit> prefill=simt
// Per-prompt TSV lines:
//   prompt_idx \t prompt_tokens \t gen_tokens \t fma_min_norm_hits \t top1:top2:b1_u32:b2_u32:margin_u32:exactness=VERIFIED_EXACT:history=UNCOMPARED,...
// Supports append+resume across interruptions and reports TOTAL_CUDA_FMA_MIN_NORM_HITS.

use llm::raw_memory::{ptr_read_i64_le, ptr_read_u32_le, ptr_read_u8, ptr_write_i64_le, ptr_write_u8}

use llm::mmap::{
    PageArena,
    MappedShard,
    page_arena_alloc,
    page_arena_free,
    page_arena_is_ok,
    page_arena_ptr,
    mapped_shard_open,
    mapped_shard_close,
    mapped_shard_is_ok,
    mapped_shard_len,
    mapped_shard_read_u8,
}
use llm::hal::{
    MetalSession,
    hal_getenv_ptr,
    hal_self_binary_sha256_hex,
    metal_session_open,
    metal_session_close,
    metal_session_is_ok,
}
use llm::qwen3_paged_kv::{
    Qwen3PagedKv,
    qwen3_kv_alloc,
    qwen3_kv_free,
    qwen3_kv_is_ok,
    qwen3_kv_truncate,
}
use llm::qwen3_tokenizer::{
    Qwen3Tokenizer,
    qwen3_tokenizer_load,
    granite_tokenizer_load,
    granite_format_audit_chat_bytes,
    qwen3_tokenizer_free,
    qwen3_tokenizer_is_ok,
    qwen3_format_chat_bytes,
    qwen3_encode_bytes,
}
use llm::qwen3::{
    Qwen3Model,
    Qwen3MetalRunner,
    Qwen3CudaRunner,
    qwen3_model_open,
    qwen3_model_free,
    qwen3_model_is_ok,
    qwen3_model_cfg,
    qwen3_metal_runner_init,
    qwen3_metal_runner_free,
    qwen3_metal_runner_is_ok,
    qwen3_cuda_runner_init_audit,
    qwen3_cuda_runner_free,
    qwen3_cuda_runner_is_ok,
    qwen3_cuda_print_info,
    qwen3_cuda_audit_reset_fma_hits,
    qwen3_cuda_audit_read_fma_hits,
    qwen3_forward_batch_bf16_metal_mode,
    qwen3_forward_batch_bf16_cuda_mode,
    qwen3_forward_token_metal_opt,
    qwen3_forward_token_cuda_opt,
    f32_ftz_sub,
}

extern "C" {
    fn dlopen(filename: *mut u8, flags: i32) -> *mut u8
    fn dlsym(handle: *mut u8, symbol: *mut u8) -> *mut u8
    fn dlclose(handle: *mut u8) -> i32
}

struct OutFile {
    libc_h: i64,
    fp: i64,
    fn_fwrite: i64,
    fn_fflush: i64,
    fn_fclose: i64,
    ok: bool,
}

fn cstr_from_str(s: string) -> i64 with Alloc, Mut {
    let n = str_len(s)
    let buf = heap_alloc(n + 8) as i64
    var i: i64 = 0
    while i < n {
        let _w = ptr_write_u8(buf, i, str_char_at(s, i) & 255)
        i = i + 1
    }
    let _z = ptr_write_u8(buf, n, 0)
    buf
}

fn out_open_append(path_ptr: i64) -> OutFile with Alloc, Mut {
    let h = dlopen(0 as *mut u8, 1) as i64
    if h == 0 {
        return OutFile { libc_h: 0, fp: 0, fn_fwrite: 0, fn_fflush: 0, fn_fclose: 0, ok: false }
    }
    let s_fopen = cstr_from_str("fopen")
    let s_fwrite = cstr_from_str("fwrite")
    let s_fflush = cstr_from_str("fflush")
    let s_fclose = cstr_from_str("fclose")
    let s_mode = cstr_from_str("ab")
    let r_fopen = dlsym(h as *mut u8, s_fopen as *mut u8) as i64
    let r_fwrite = dlsym(h as *mut u8, s_fwrite as *mut u8) as i64
    let r_fflush = dlsym(h as *mut u8, s_fflush as *mut u8) as i64
    let r_fclose = dlsym(h as *mut u8, s_fclose as *mut u8) as i64
    heap_free(s_fopen as *mut u8)
    heap_free(s_fwrite as *mut u8)
    heap_free(s_fflush as *mut u8)
    heap_free(s_fclose as *mut u8)
    if r_fopen == 0 || r_fwrite == 0 || r_fflush == 0 || r_fclose == 0 {
        heap_free(s_mode as *mut u8)
        let _c = dlclose(h as *mut u8)
        return OutFile { libc_h: 0, fp: 0, fn_fwrite: 0, fn_fflush: 0, fn_fclose: 0, ok: false }
    }
    let fopen_fn = r_fopen as fn(i64, i64) -> i64
    let fp = fopen_fn(path_ptr, s_mode)
    heap_free(s_mode as *mut u8)
    if fp == 0 {
        let _c = dlclose(h as *mut u8)
        return OutFile { libc_h: 0, fp: 0, fn_fwrite: 0, fn_fflush: 0, fn_fclose: 0, ok: false }
    }
    OutFile { libc_h: h, fp: fp, fn_fwrite: r_fwrite, fn_fflush: r_fflush, fn_fclose: r_fclose, ok: true }
}

fn out_write_flush(of: &OutFile, ptr: i64, nbytes: i64) -> bool {
    if !of.ok || of.fp == 0 || nbytes < 0 { return false }
    let fwrite_fn = of.fn_fwrite as fn(i64, i64, i64, i64) -> i64
    let fflush_fn = of.fn_fflush as fn(i64) -> i32
    let written = fwrite_fn(ptr, 1, nbytes, of.fp)
    let _fl = fflush_fn(of.fp)
    written == nbytes
}

fn out_close(of: &OutFile) {
    if of.fp != 0 && of.fn_fclose != 0 {
        let fclose_fn = of.fn_fclose as fn(i64) -> i32
        let _rc = fclose_fn(of.fp)
    }
    if of.libc_h != 0 {
        let _c = dlclose(of.libc_h as *mut u8)
    }
}

fn count_existing_lines(path_ptr: i64, has_header_out: i64) -> i64 with IO, Alloc, Mut, Panic {
    let p_str = (path_ptr as *mut u8) as string
    let s = mapped_shard_open(p_str)
    var lines: i64 = 0
    var has_header: i64 = 0
    if mapped_shard_is_ok(&s) {
        let n = mapped_shard_len(&s)
        var i: i64 = 0
        var line_start = true
        var is_comment = false
        var non_empty = false
        var match_pos: i64 = 0
        var hdr_prefix = "# run_header "
        var hlen = str_len(hdr_prefix)
        var hdr_match = true
        while i < n {
            let rr = mapped_shard_read_u8(&s, i)
            if !rr.1 { break }
            let ch = rr.0
            if ch == 10 {
                if non_empty {
                    if is_comment {
                        if hdr_match && match_pos >= hlen && lines == 0 {
                            has_header = 1
                        }
                    } else {
                        lines = lines + 1
                    }
                }
                line_start = true
                is_comment = false
                non_empty = false
                match_pos = 0
                hdr_match = true
            } else {
                if ch != 13 {
                    non_empty = true
                }
                if line_start {
                    is_comment = (ch == 35)
                    line_start = false
                }
                if match_pos < hlen {
                    if ch != (str_char_at(hdr_prefix, match_pos) & 255) {
                        hdr_match = false
                    }
                    match_pos = match_pos + 1
                }
            }
            i = i + 1
        }
        if non_empty && !is_comment {
            lines = lines + 1
        } else if non_empty && is_comment && hdr_match && match_pos >= hlen && lines == 0 {
            has_header = 1
        }
    }
    let _c = mapped_shard_close(s)
    let _wh = ptr_write_i64_le(has_header_out, 0, has_header)
    lines
}

fn cstr_env_or_default(dst: i64, var_name: string, fallback: string) -> i64 with Alloc, Mut {
    let p = hal_getenv_ptr(var_name)
    if p != 0 && ptr_read_u8(p, 0) != 0 {
        var i: i64 = 0
        while i < 4090 {
            let b = ptr_read_u8(p, i)
            let _w = ptr_write_u8(dst, i, b)
            if b == 0 { return i }
            i = i + 1
        }
        let _z = ptr_write_u8(dst, 4090, 0)
        return 4090
    }
    let n = str_len(fallback)
    var i: i64 = 0
    while i < n {
        let _w = ptr_write_u8(dst, i, str_char_at(fallback, i) & 255)
        i = i + 1
    }
    let _z = ptr_write_u8(dst, n, 0)
    n
}

fn env_i64_or(var_name: string, fallback: i64) -> i64 with Alloc, Mut {
    let p = hal_getenv_ptr(var_name)
    if p == 0 || ptr_read_u8(p, 0) == 0 { return fallback }
    var v: i64 = 0
    var i: i64 = 0
    var seen = false
    while i < 32 {
        let b = ptr_read_u8(p, i)
        if b == 0 { break }
        if b >= 48 && b <= 57 {
            v = v * 10 + (b - 48)
            seen = true
        } else {
            return fallback
        }
        i = i + 1
    }
    if seen { v } else { fallback }
}

fn env_equals(var_name: string, val: string) -> bool with Alloc, Mut {
    let p = hal_getenv_ptr(var_name)
    if p == 0 { return false }
    let n = str_len(val)
    var i: i64 = 0
    while i < n {
        if ptr_read_u8(p, i) != (str_char_at(val, i) & 255) { return false }
        i = i + 1
    }
    ptr_read_u8(p, n) == 0
}

fn join_tok_json(dst: i64, dir_ptr: i64, dlen: i64) with Mut {
    var i: i64 = 0
    while i < dlen {
        let _w = ptr_write_u8(dst, i, ptr_read_u8(dir_ptr, i))
        i = i + 1
    }
    var p = dlen
    if p > 0 && ptr_read_u8(dst, p - 1) != 47 {
        let _w = ptr_write_u8(dst, p, 47)
        p = p + 1
    }
    let suf = "tokenizer.json"
    var j: i64 = 0
    let sn = str_len(suf)
    while j < sn {
        let _w = ptr_write_u8(dst, p + j, str_char_at(suf, j) & 255)
        j = j + 1
    }
    let _z = ptr_write_u8(dst, p + sn, 0)
}

fn app_byte(buf: i64, pos: i64, b: i64) -> i64 with Mut {
    let _w = ptr_write_u8(buf, pos, b & 255)
    pos + 1
}

fn app_i64(buf: i64, pos: i64, v: i64) -> i64 with Alloc, Mut, Div {
    var p = pos
    var x = v
    if x == 0 { return app_byte(buf, p, 48) }
    if x < 0 {
        p = app_byte(buf, p, 45)
        x = 0 - x
    }
    let tmp = heap_alloc(32) as i64
    var d: i64 = 0
    while x > 0 {
        let _w = ptr_write_u8(tmp, d, 48 + (x % 10))
        x = x / 10
        d = d + 1
    }
    while d > 0 {
        d = d - 1
        p = app_byte(buf, p, ptr_read_u8(tmp, d))
    }
    heap_free(tmp as *mut u8)
    p
}

fn next_prompt_from_shard(
    shard: &MappedShard,
    slen: i64,
    bi_ptr: i64,
    line_ptr: i64,
    prompt_cap: i64
) -> i64 with Mut {
    var bi = ptr_read_i64_le(bi_ptr, 0)
    var line_len: i64 = 0
    while bi <= slen {
        var is_eol = (bi == slen)
        var ch: i64 = 0
        if bi < slen {
            let rr = mapped_shard_read_u8(shard, bi)
            if !rr.1 { return -1 }
            ch = rr.0
            if ch == 10 { is_eol = true }
        }
        bi = bi + 1
        if is_eol {
            while line_len > 0 && ptr_read_u8(line_ptr, line_len - 1) == 13 {
                line_len = line_len - 1
            }
            if line_len > 0 {
                let _wn = ptr_write_u8(line_ptr, line_len, 0)
                let _wb = ptr_write_i64_le(bi_ptr, 0, bi)
                return line_len
            }
            if bi > slen { break }
        } else {
            if line_len + 1 < prompt_cap {
                let _wl = ptr_write_u8(line_ptr, line_len, ch)
                line_len = line_len + 1
            } else {
                return -1
            }
        }
    }
    let _wb = ptr_write_i64_le(bi_ptr, 0, bi)
    0
}

fn app_str(buf: i64, pos: i64, s: string) -> i64 with Mut {
    let n = str_len(s)
    var p = pos
    var i: i64 = 0
    while i < n {
        p = app_byte(buf, p, str_char_at(s, i) & 255)
        i = i + 1
    }
    p
}

fn write_run_header(of: &OutFile, backend_name: string) -> bool with IO, Alloc, Mut, Panic, Div {
    let sha_buf = heap_alloc(80) as i64
    let sh_ok = hal_self_binary_sha256_hex(sha_buf)
    let hdr_buf = heap_alloc(512) as i64
    var p: i64 = 0
    p = app_str(hdr_buf, p, "# run_header binary_sha256=")
    if sh_ok {
        var i: i64 = 0
        while i < 64 {
            p = app_byte(hdr_buf, p, ptr_read_u8(sha_buf, i))
            i = i + 1
        }
    } else {
        heap_free(sha_buf as *mut u8)
        heap_free(hdr_buf as *mut u8)
        return false
    }
    p = app_str(hdr_buf, p, " float_model=\"binary32, round-to-nearest-even, FTZ+DAZ, fixed op order\" backend=")
    p = app_str(hdr_buf, p, backend_name)
    p = app_str(hdr_buf, p, " prefill=simt")
    let _zn = ptr_write_u8(hdr_buf, p, 0)
    var hi: i64 = 0
    while hi < p {
        print_char(ptr_read_u8(hdr_buf, hi) as i32)
        hi = hi + 1
    }
    println("")
    p = app_byte(hdr_buf, p, 10)
    let ok = out_write_flush(of, hdr_buf, p)
    heap_free(sha_buf as *mut u8)
    heap_free(hdr_buf as *mut u8)
    ok
}

fn append_top2_entry(m: &Qwen3Model, out_buf: i64, pos_ptr: i64, with_comma: bool) -> i64 with Alloc, Mut, Div {
    let top2_p = page_arena_ptr(&m.arena) + m.buf_top2_off
    let t1 = ptr_read_i64_le(top2_p, 0)
    let t2 = ptr_read_i64_le(top2_p, 8)
    let b1 = ptr_read_u32_le(top2_p, 16)
    let b2 = ptr_read_u32_le(top2_p, 20)
    let mb = f32_ftz_sub(b1, b2)

    var p = ptr_read_i64_le(pos_ptr, 0)
    if with_comma { p = app_byte(out_buf, p, 44) }
    p = app_i64(out_buf, p, t1)
    p = app_byte(out_buf, p, 58)
    p = app_i64(out_buf, p, t2)
    p = app_byte(out_buf, p, 58)
    p = app_i64(out_buf, p, b1)
    p = app_byte(out_buf, p, 58)
    p = app_i64(out_buf, p, b2)
    p = app_byte(out_buf, p, 58)
    p = app_i64(out_buf, p, mb)
    p = app_str(out_buf, p, ":exactness=VERIFIED_EXACT:history=UNCOMPARED")
    let _wp = ptr_write_i64_le(pos_ptr, 0, p)
    t1
}

fn finalize_prompt_line(
    of: &OutFile,
    out_buf: i64,
    pos_ptr: i64,
    out_cap: i64
) -> bool with Mut {
    var p = ptr_read_i64_le(pos_ptr, 0)
    if p + 2 >= out_cap { return false }
    p = app_byte(out_buf, p, 10)
    out_write_flush(of, out_buf, p)
}

fn begin_prompt_line(
    out_buf: i64,
    pos_ptr: i64,
    pidx: i64,
    n_prompt: i64,
    max_tokens: i64,
    fma_hits: i64
) with Alloc, Mut, Div {
    var p: i64 = 0
    p = app_i64(out_buf, p, pidx)
    p = app_byte(out_buf, p, 9)
    p = app_i64(out_buf, p, n_prompt)
    p = app_byte(out_buf, p, 9)
    p = app_i64(out_buf, p, max_tokens)
    p = app_byte(out_buf, p, 9)
    p = app_i64(out_buf, p, fma_hits)
    p = app_byte(out_buf, p, 9)
    let _wp = ptr_write_i64_le(pos_ptr, 0, p)
}

fn run_61440_metal(
    m: &Qwen3Model,
    tok: &Qwen3Tokenizer,
    shard: &MappedShard,
    slen: i64,
    of: &OutFile,
    resume_skip: i64,
    max_tokens: i64,
    max_seq: i64,
    max_prompts: i64
) -> bool with IO, Alloc, Mut, Div, Panic {
    let cfg = m.cfg
    let max_blocks = (max_seq + 15) / 16
    var kv = qwen3_kv_alloc(cfg.layers, max_blocks, 16, cfg.n_kv, cfg.head_dim)
    let rt = qwen3_metal_runner_init(m, &kv, "")
    let prompt_cap: i64 = 65536
    let tokens_cap: i64 = 8192
    let out_cap: i64 = 262144
    let work_arena = page_arena_alloc(prompt_cap * 2 + tokens_cap * 8 + out_cap + 256)

    var ok = qwen3_kv_is_ok(&kv) && qwen3_metal_runner_is_ok(&rt) && page_arena_is_ok(&work_arena)
    var done_prompts: i64 = 0

    if ok {
        println("[audit61440] backend=metal prefill=simt float_model=\"binary32, round-to-nearest-even, FTZ+DAZ, fixed op order\"")
        let wbase = page_arena_ptr(&work_arena)
        let line_ptr = wbase
        let chat_ptr = line_ptr + prompt_cap
        let tok_ptr = chat_ptr + prompt_cap
        let out_ptr = tok_ptr + tokens_cap * 8
        let bi_ptr = out_ptr + out_cap
        let pos_ptr = bi_ptr + 8
        let _wbi0 = ptr_write_i64_le(bi_ptr, 0, 0)

        var pidx: i64 = 0
        while ok {
            if max_prompts > 0 && pidx >= max_prompts { break }
            let ll = next_prompt_from_shard(shard, slen, bi_ptr, line_ptr, prompt_cap)
            if ll < 0 { ok = false; break }
            if ll == 0 { break }

            if pidx < resume_skip {
                pidx = pidx + 1
                continue
            }

            let chat_len = if tok.granite { granite_format_audit_chat_bytes(line_ptr, ll, chat_ptr, prompt_cap) } else { qwen3_format_chat_bytes(0, 0, line_ptr, ll, true, false, chat_ptr, prompt_cap) }
            if chat_len <= 0 { ok = false; break }
            let n_prompt = qwen3_encode_bytes(tok, chat_ptr, chat_len, tok_ptr, tokens_cap)
            if n_prompt <= 0 || n_prompt + max_tokens > max_seq { ok = false; break }

            if !qwen3_kv_truncate(&!kv, 0) { ok = false; break }
            if !qwen3_forward_batch_bf16_metal_mode(m, &!kv, &rt, tok_ptr, 0, n_prompt, false, true, 0, false) {
                ok = false
                break
            }

            // Record tuples into tmp_entries after header; header has fma=0 on Metal
            begin_prompt_line(out_ptr, pos_ptr, pidx, n_prompt, max_tokens, 0)
            var prev_tok = append_top2_entry(m, out_ptr, pos_ptr, false)
            var step: i64 = 1
            while step < max_tokens {
                let kv_pos = n_prompt + step - 1
                if !qwen3_forward_token_metal_opt(m, &!kv, &rt, prev_tok, kv_pos, true) {
                    ok = false
                    break
                }
                prev_tok = append_top2_entry(m, out_ptr, pos_ptr, true)
                step = step + 1
            }
            if !ok { break }
            if !finalize_prompt_line(of, out_ptr, pos_ptr, out_cap) { ok = false; break }

            done_prompts = done_prompts + 1
            pidx = pidx + 1
            if (pidx % 20) == 0 {
                print("[audit61440-metal] completed_prompt=")
                print_int(pidx)
                println("")
            }
        }
    }

    if max_prompts > 0 && done_prompts + resume_skip != max_prompts { ok = false }
    let _fw = page_arena_free(work_arena)
    let _fr = qwen3_metal_runner_free(rt)
    let _fk = qwen3_kv_free(kv)
    if ok {
        print("AUDIT_61440_DONE backend=metal new_prompts=")
        print_int(done_prompts)
        println(" TOTAL_CUDA_FMA_MIN_NORM_HITS=0")
    }
    ok
}

fn run_61440_cuda(
    m: &Qwen3Model,
    tok: &Qwen3Tokenizer,
    shard: &MappedShard,
    slen: i64,
    of: &OutFile,
    resume_skip: i64,
    max_tokens: i64,
    max_seq: i64,
    max_prompts: i64
) -> bool with IO, Alloc, Mut, Div, Panic {
    let rt = qwen3_cuda_runner_init_audit(m, max_seq, "", -1)
    let prompt_cap: i64 = 65536
    let tokens_cap: i64 = 8192
    let out_cap: i64 = 262144
    let work_arena = page_arena_alloc(prompt_cap * 2 + tokens_cap * 8 + out_cap * 2 + 256)

    var ok = qwen3_cuda_runner_is_ok(&rt) && page_arena_is_ok(&work_arena)
    print("GRANITE_DIAG_AUDIT_INIT runner="); print_int(if qwen3_cuda_runner_is_ok(&rt) { 1 } else { 0 }); print(" arena="); print_int(if page_arena_is_ok(&work_arena) { 1 } else { 0 }); println("")
    var done_prompts: i64 = 0
    var total_fma_hits: i64 = 0

    if ok {
        println("[audit61440] backend=cuda_audit prefill=simt float_model=\"binary32, round-to-nearest-even, FTZ+DAZ, fixed op order\"")
        qwen3_cuda_print_info(&rt)
        let wbase = page_arena_ptr(&work_arena)
        let line_ptr = wbase
        let chat_ptr = line_ptr + prompt_cap
        let tok_ptr = chat_ptr + prompt_cap
        let out_ptr = tok_ptr + tokens_cap * 8
        let ent_ptr = out_ptr + out_cap
        let bi_ptr = ent_ptr + out_cap
        let pos_ptr = bi_ptr + 8
        let _wbi0 = ptr_write_i64_le(bi_ptr, 0, 0)

        var pidx: i64 = 0
        while ok {
            if pidx >= 1 { break } // diagnostic only: never produce a 61440 audit
            let ll = next_prompt_from_shard(shard, slen, bi_ptr, line_ptr, prompt_cap)
            if ll < 0 { println("GRANITE_DIAG_PROMPT_READ_FAIL"); ok = false; break }
            if ll == 0 { break }

            if pidx < resume_skip {
                pidx = pidx + 1
                continue
            }

            let chat_len = if tok.granite { granite_format_audit_chat_bytes(line_ptr, ll, chat_ptr, prompt_cap) } else { qwen3_format_chat_bytes(0, 0, line_ptr, ll, true, false, chat_ptr, prompt_cap) }
            if chat_len <= 0 { println("GRANITE_DIAG_CHAT_FAIL"); ok = false; break }
            let n_prompt = qwen3_encode_bytes(tok, chat_ptr, chat_len, tok_ptr, tokens_cap)
            if n_prompt <= 0 || n_prompt + max_tokens > max_seq { println("GRANITE_DIAG_TOKEN_LENGTH_FAIL"); ok = false; break }

            if !qwen3_cuda_audit_reset_fma_hits(&rt) { println("GRANITE_DIAG_FMA_RESET_FAIL"); ok = false; break }
            if !qwen3_forward_batch_bf16_cuda_mode(m, &rt, tok_ptr, 0, n_prompt, false, true, 0, false) {
                println("GRANITE_DIAG_PREFILL_FAIL")
                ok = false
                break
            }

            let _wep0 = ptr_write_i64_le(pos_ptr, 0, 0)
            var prev_tok = append_top2_entry(m, ent_ptr, pos_ptr, false)
            var step: i64 = 1
            while step < max_tokens {
                let kv_pos = n_prompt + step - 1
                if !qwen3_forward_token_cuda_opt(m, &rt, prev_tok, kv_pos, true) {
                    print("GRANITE_DIAG_DECODE_FAIL step="); print_int(step); println("")
                    ok = false
                    break
                }
                prev_tok = append_top2_entry(m, ent_ptr, pos_ptr, true)
                step = step + 1
            }
            if !ok { break }
            let ent_len = ptr_read_i64_le(pos_ptr, 0)
            let fma_delta = qwen3_cuda_audit_read_fma_hits(&rt)
            if fma_delta < 0 { println("GRANITE_DIAG_FMA_READ_FAIL"); ok = false; break }
            total_fma_hits = total_fma_hits + fma_delta

            begin_prompt_line(out_ptr, pos_ptr, pidx, n_prompt, max_tokens, fma_delta)
            var hp = ptr_read_i64_le(pos_ptr, 0)
            if hp + ent_len + 2 >= out_cap { println("GRANITE_DIAG_OUTPUT_CAP_FAIL"); ok = false; break }
            var ei: i64 = 0
            while ei < ent_len {
                let _wc = ptr_write_u8(out_ptr, hp + ei, ptr_read_u8(ent_ptr, ei))
                ei = ei + 1
            }
            let _wp = ptr_write_i64_le(pos_ptr, 0, hp + ent_len)
            if !finalize_prompt_line(of, out_ptr, pos_ptr, out_cap) { println("GRANITE_DIAG_OUTPUT_WRITE_FAIL"); ok = false; break }

            done_prompts = done_prompts + 1
            pidx = pidx + 1
            if (pidx % 20) == 0 {
                print("[audit61440-cuda] completed_prompt=")
                print_int(pidx)
                print(" cum_fma_hits=")
                print_int(total_fma_hits)
                println("")
            }
        }
    }

    if done_prompts != 1 { ok = false }
    let _fw = page_arena_free(work_arena)
    let _fr = qwen3_cuda_runner_free(rt)
    if ok {
        print("GRANITE_DIAG_FIRST_PROMPT_PASS backend=cuda new_prompts=")
        print_int(done_prompts)
        print(" TOTAL_CUDA_FMA_MIN_NORM_HITS=")
        print_int(total_fma_hits)
        println("")
    }
    ok
}

fn arg_eq(p: string, s: string) -> bool {
    if str_len(p) != str_len(s) { return false }
    var i: i64 = 0
    while i < str_len(s) {
        if str_char_at(p, i) != str_char_at(s, i) { return false }
        i = i + 1
    }
    true
}

fn copy_arg(dst: i64, src: string) -> i64 with Mut {
    let n = str_len(src)
    if n >= 4090 { return -1 }
    var i: i64 = 0
    while i < n {
        let _w = ptr_write_u8(dst, i, str_char_at(src, i) & 255)
        i = i + 1
    }
    let _z = ptr_write_u8(dst, i, 0)
    n
}

fn decimal_arg(p: string) -> i64 with Div {
    let n = str_len(p)
    if n <= 0 || n > 8 { return -1 }
    var i: i64 = 0
    var v: i64 = 0
    while i < n {
        let b = str_char_at(p, i)
        if b < 48 || b > 57 { return -1 }
        v = v * 10 + b - 48
        i = i + 1
    }
    v
}

// Offline oracle: one line per prompt, unsigned decimal token IDs separated
// by spaces/tabs; exact order and length, no omitted or extra prompts.
fn matches_token_ids(line: i64, len: i64, ids: i64, count: i64) -> bool with Div {
    var p: i64 = 0
    var i: i64 = 0
    while p < len {
        while p < len && (ptr_read_u8(line, p) == 32 || ptr_read_u8(line, p) == 9) { p = p + 1 }
        if p == len { break }
        var v: i64 = 0
        var digits: i64 = 0
        while p < len {
            let b = ptr_read_u8(line, p)
            if b == 32 || b == 9 { break }
            if b < 48 || b > 57 || digits >= 6 { return false }
            v = v * 10 + b - 48
            digits = digits + 1
            p = p + 1
        }
        if digits == 0 || i >= count || v != ptr_read_i64_le(ids, i * 8) { return false }
        i = i + 1
    }
    i == count
}

fn verify_granite_prompt_ids(tok: &Qwen3Tokenizer, prompts: &MappedShard, slen: i64, ref_path: i64) -> bool with IO, Alloc, Mut, Panic, Div {
    let ref = mapped_shard_open((ref_path as *mut u8) as string)
    let arena = page_arena_alloc(4 * 65536 + 32)
    var ok = mapped_shard_is_ok(&ref) && page_arena_is_ok(&arena)
    if ok {
        let base = page_arena_ptr(&arena)
        let prompt = base
        let chat = base + 65536
        let ids = base + 131072
        let oracle_line = base + 196608
        let pi = base + 262144
        let ri = pi + 8
        let _z0 = ptr_write_i64_le(pi, 0, 0)
        let _z1 = ptr_write_i64_le(ri, 0, 0)
        let rlen = mapped_shard_len(&ref)
        var i: i64 = 0
        while i < 480 && ok {
            let ll = next_prompt_from_shard(prompts, slen, pi, prompt, 65536)
            let rl = next_prompt_from_shard(&ref, rlen, ri, oracle_line, 65536)
            if ll <= 0 || rl <= 0 { ok = false; break }
            let cl = granite_format_audit_chat_bytes(prompt, ll, chat, 65536)
            if cl <= 0 { ok = false; break }
            let n = qwen3_encode_bytes(tok, chat, cl, ids, 8192)
            if n <= 0 || !matches_token_ids(oracle_line, rl, ids, n) {
                print("GRANITE_TOKEN_IDS_MISMATCH prompt=")
                print_int(i)
                println("")
                ok = false
                break
            }
            i = i + 1
        }
        if ok {
            ok = next_prompt_from_shard(prompts, slen, pi, prompt, 65536) == 0
                && next_prompt_from_shard(&ref, rlen, ri, oracle_line, 65536) == 0
        }
    }
    let _f = page_arena_free(arena)
    let _r = mapped_shard_close(ref)
    println(if ok { "GRANITE_TOKEN_IDS_480_PASS" } else { "GRANITE_TOKEN_IDS_480_FAIL" })
    ok
}

pub fn main() -> i64 with IO, Alloc, Mut, Div, Panic {
    let force_cuda = env_equals("SOUNIO_AUDIT_BACKEND", "cuda")
    let probe_sess = metal_session_open("")
    let use_metal = (!force_cuda) && metal_session_is_ok(&probe_sess)
    let _cp = metal_session_close(probe_sess)

    let model_buf = heap_alloc(4096) as i64
    let tok_buf = heap_alloc(4096) as i64
    let prompts_buf = heap_alloc(4096) as i64
    let out_buf = heap_alloc(4096) as i64

    var dlen = cstr_env_or_default(model_buf, "SOUNIO_MODEL_DIR", "/tmp/models/Qwen3-0.6B")
    let _plen = cstr_env_or_default(prompts_buf, "SOUNIO_PROMPTS_FILE", "/tmp/v2_480_prompts.txt")
    let _olen = cstr_env_or_default(out_buf, "SOUNIO_OUT_FILE", "/tmp/v2_61440_out.tsv")

    var max_tokens = env_i64_or("SOUNIO_MAX_TOKENS", 128)
    let max_seq = env_i64_or("SOUNIO_MAX_SEQ", 512)
    var max_prompts = env_i64_or("SOUNIO_MAX_PROMPTS", 0)
    var granite = false
    let ref_buf = heap_alloc(4096) as i64
    let _rl = cstr_env_or_default(ref_buf, "SOUNIO_GRANITE_PROMPT_IDS", "")
    let argc = arg_count()
    var ai: i64 = 0
    while ai < argc {
        if ai + 1 >= argc { println("AUDIT_BAD_ARG"); return 1 }
        let key = get_arg(ai)
        let val = get_arg(ai + 1)
        if arg_eq(key, "--arch") {
            if arg_eq(val, "granite") { granite = true }
            else if arg_eq(val, "qwen3") { granite = false }
            else { println("AUDIT_UNKNOWN_ARCH"); return 1 }
        } else if arg_eq(key, "--model-dir") { dlen = copy_arg(model_buf, val) }
        else if arg_eq(key, "--prompts-file") { if copy_arg(prompts_buf, val) < 0 { return 1 } }
        else if arg_eq(key, "--prompt-ids") { if copy_arg(ref_buf, val) < 0 { return 1 } }
        else if arg_eq(key, "--out") { if copy_arg(out_buf, val) < 0 { return 1 } }
        else if arg_eq(key, "--prompts") { max_prompts = decimal_arg(val) }
        else if arg_eq(key, "--tokens") { max_tokens = decimal_arg(val) }
        else if arg_eq(key, "--dtype") { if !arg_eq(val, "bf16") { return 1 } }
        else { println("AUDIT_UNKNOWN_ARG"); return 1 }
        ai = ai + 2
    }
    if dlen < 0 || max_prompts < 0 { return 1 }
    if granite && max_prompts == 0 { max_prompts = 480 }
    if granite && (max_prompts != 480 || max_tokens != 128) { println("GRANITE_REGISTERED_SHAPE_REQUIRED"); return 1 }
    join_tok_json(tok_buf, model_buf, dlen)
    let has_hdr_box = heap_alloc(8) as i64
    let _zh0 = ptr_write_i64_le(has_hdr_box, 0, 0)
    let resume_skip = count_existing_lines(out_buf, has_hdr_box)
    let has_header = ptr_read_i64_le(has_hdr_box, 0)
    heap_free(has_hdr_box as *mut u8)

    let m = qwen3_model_open((model_buf as *mut u8) as string)
    let tok = if granite { granite_tokenizer_load((tok_buf as *mut u8) as string) } else { qwen3_tokenizer_load((tok_buf as *mut u8) as string) }
    let shard = mapped_shard_open((prompts_buf as *mut u8) as string)
    let slen = if mapped_shard_is_ok(&shard) { mapped_shard_len(&shard) } else { 0 }
    let of = out_open_append(out_buf)

    var ok = qwen3_model_is_ok(&m) && qwen3_tokenizer_is_ok(&tok)
        && mapped_shard_is_ok(&shard) && slen > 0 && of.ok
        && max_tokens > 0 && max_seq > max_tokens && qwen3_model_cfg(&m).granite == granite

    if ok && granite {
        ok = verify_granite_prompt_ids(&tok, &shard, slen, ref_buf)
    }

    if ok && resume_skip > 0 && has_header == 0 {
        println("AUDIT_61440_HEADER_MISSING_IN_EXISTING_OUT")
        ok = false
    }

    if ok {
        if has_header == 0 {
            let hdr_ok = write_run_header(&of, if use_metal { "metal" } else { "cuda_audit" })
            if !hdr_ok {
                println("AUDIT_61440_HEADER_WRITE_FAIL")
                ok = false
            }
        }
    }

    if ok {
        print("[audit61440] resume_skip=")
        print_int(resume_skip)
        print(" max_tokens=")
        print_int(max_tokens)
        print(" max_seq=")
        print_int(max_seq)
        print(" max_prompts=")
        print_int(max_prompts)
        println("")
        ok = if use_metal {
            run_61440_metal(&m, &tok, &shard, slen, &of, resume_skip, max_tokens, max_seq, max_prompts)
        } else {
            run_61440_cuda(&m, &tok, &shard, slen, &of, resume_skip, max_tokens, max_seq, max_prompts)
        }
    } else {
        println("AUDIT_61440_INIT_FAIL")
    }

    out_close(&of)
    let _cs = mapped_shard_close(shard)
    let _ft = qwen3_tokenizer_free(tok)
    let _fm = qwen3_model_free(m)
    heap_free(ref_buf as *mut u8)
    heap_free(model_buf as *mut u8)
    heap_free(tok_buf as *mut u8)
    heap_free(prompts_buf as *mut u8)
    heap_free(out_buf as *mut u8)

    if !ok {
        println("AUDIT_61440_FAIL")
        return 1
    }
    0
}
