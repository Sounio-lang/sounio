//@ run-pass
//@ requires: madaros
//@ expect-stdout: LLM_PHASE5_NOSTUB_AND_5SHARD_PASS
//
// Phase 5 Witness:
// 1. Zero { ret; } stubs in emitted PTX strings from qwen3_kernels, qwen3_quant_eisa, qwen3_ossm.
// 2. 5-shard Qwen3-8B synthetic/topology validation (n_shards == 5 in 8-shard Qwen3Model).
// 3. Sorted descending top-256 Nucleus top_p sampler behavior.
// 4. Qwen3EisaModel Metal NoCopy vs CPU parity + EisaArgmaxCert certification.

use llm::mmap::{
    page_arena_alloc,
    page_arena_free,
    page_arena_is_ok,
    page_arena_ptr,
    mapped_shard_open,
    mapped_shard_close,
    mapped_shard_is_ok,
    mapped_shard_len,
}
use llm::qwen3::{
    Qwen3Model,
    qwen3_model_open,
    qwen3_model_free,
    qwen3_model_is_ok,
    qwen3_model_n_shards,
    qwen3_model_shard_ptr,
    qwen3_model_cfg,
    qwen3_model_logits_ptr,
}
use llm::qwen3_kernels::{
    emit_qwen3_kernels_ptx_cstr,
}
use llm::qwen3_quant_eisa::{
    emit_eisa_kernels_ptx_cstr,
    eisa_certify_argmax,
    qwen3_quantize_bf16_to_q4_eisa,
    qwen3_gemv_q4_eisa_cpu,
    emit_eisa_kernels_msl_cstr,
    eisa_metal_pipelines_compile,
    qwen3_metal_gemv_q4_eisa,
    qwen3_metal_encode_quantize_q4_eisa,
}
use llm::qwen3_ossm::{
    emit_ossm_kernels_ptx_cstr,
}
use llm::sounio_llm_cli::{
    sounio_llm_sample_top_p,
}
use llm::hal::{
    metal_session_open,
    metal_session_close,
    metal_session_is_ok,
    metal_buffer_nocopy,
    metal_buffer_free,
    metal_cmd_begin,
    metal_cmd_commit_sync,
}
use tensor2::convert::{
    f32_bits_to_f64,
    f64_to_f32_bits,
    f64_to_f16_bits,
}

fn find_needle(buf: i64, needle: string) -> i64 with Mut {
    let n_len = str_len(needle)
    if n_len == 0 { return 0 }
    var pos: i64 = 0
    while true {
        let b = ptr_read_u8(buf, pos)
        if b == 0 { return -1 }
        var is_match = true
        var j: i64 = 0
        while j < n_len {
            let bj = ptr_read_u8(buf, pos + j)
            let nj = str_char_at(needle, j)
            if bj != nj {
                is_match = false
                j = n_len
            } else {
                j = j + 1
            }
        }
        if is_match { return pos }
        pos = pos + 1
    }
    -1
}

// ----------------------------------------------------------------------------
// Test 1: Zero { ret; } stubs in all emitted PTX strings
// ----------------------------------------------------------------------------
fn test_zero_ptx_stubs() -> bool with Alloc, Mut, IO {
    let ptx_q = emit_qwen3_kernels_ptx_cstr()
    let ptx_e = emit_eisa_kernels_ptx_cstr()
    let ptx_o = emit_ossm_kernels_ptx_cstr()

    if ptx_q == 0 || ptx_e == 0 || ptx_o == 0 {
        if ptx_q != 0 { heap_free(ptx_q as *mut u8) }
        if ptx_e != 0 { heap_free(ptx_e as *mut u8) }
        if ptx_o != 0 { heap_free(ptx_o as *mut u8) }
        return false
    }

    let stub_q = find_needle(ptx_q, "{ ret; }") >= 0
    let stub_e = find_needle(ptx_e, "{ ret; }") >= 0
    let stub_o = find_needle(ptx_o, "{ ret; }") >= 0

    let ok_q = (find_needle(ptx_q, ".target sm_80") >= 0) && (find_needle(ptx_q, "qwen3_rmsnorm_bf16") >= 0) && !stub_q
    let ok_e = (find_needle(ptx_e, ".target sm_80") >= 0) && (find_needle(ptx_e, "qwen3_gemv_q4_eisa") >= 0) && !stub_e
    let ok_o = (find_needle(ptx_o, ".target sm_80") >= 0) && (find_needle(ptx_o, "qwen3_ossm_step_f32") >= 0) && !stub_o

    heap_free(ptx_q as *mut u8)
    heap_free(ptx_e as *mut u8)
    heap_free(ptx_o as *mut u8)

    ok_q && ok_e && ok_o
}

// ----------------------------------------------------------------------------
// Test 2: 5-shard Qwen3-8B synthetic/topology validation
// ----------------------------------------------------------------------------
fn test_5shard_topology(model_dir: string) -> bool with IO, Mut, Panic, Alloc, Div {
    let m = qwen3_model_open(model_dir)
    var shards_ok = false

    if qwen3_model_is_ok(&m) {
        let n = qwen3_model_n_shards(&m)
        let s0_ok = qwen3_model_shard_ptr(&m, 0) > 0
        let s1_ok = qwen3_model_shard_ptr(&m, 1) > 0
        let s2_ok = qwen3_model_shard_ptr(&m, 2) > 0
        let s3_ok = qwen3_model_shard_ptr(&m, 3) > 0
        let s4_ok = qwen3_model_shard_ptr(&m, 4) > 0
        let s5_empty = qwen3_model_shard_ptr(&m, 5) == 0
        let s6_empty = qwen3_model_shard_ptr(&m, 6) == 0
        let s7_empty = qwen3_model_shard_ptr(&m, 7) == 0
        shards_ok = (n == 5) && s0_ok && s1_ok && s2_ok && s3_ok && s4_ok && s5_empty && s6_empty && s7_empty
    } else {
        shards_ok = false
    }

    let _mf = qwen3_model_free(m)
    shards_ok
}

// ----------------------------------------------------------------------------
// Test 3: Sorted descending top-256 Nucleus top_p sampler behavior
// ----------------------------------------------------------------------------
fn test_top_p_sampler_behavior(model_dir: string) -> bool with IO, Mut, Panic, Alloc, Div {
    let m = qwen3_model_open(model_dir)
    var ok = false

    if qwen3_model_is_ok(&m) {
        let cfg = qwen3_model_cfg(&m)
        let vocab = cfg.vocab
        if vocab >= 256 {
            let arena = page_arena_alloc(128)
            if page_arena_is_ok(&arena) {
                let rng_ptr = page_arena_ptr(&arena)
                let _w = ptr_write_i64_le(rng_ptr, 0, 42)

                let logits_base = qwen3_model_logits_ptr(&m)

                // Fill all logits with -100.0
                var i: i64 = 0
                while i < vocab {
                    let _w = ptr_write_u32_le(logits_base, i * 4, f64_to_f32_bits(-100.0))
                    i = i + 1
                }

                // Put top candidates at 42 (10.0) and 100 (9.0)
                let _w42 = ptr_write_u32_le(logits_base, 42 * 4, f64_to_f32_bits(10.0))
                let _w100 = ptr_write_u32_le(logits_base, 100 * 4, f64_to_f32_bits(9.0))

                // Sample with top_p = 0.8
                var samples_valid = true
                var count_42: i64 = 0
                var count_100: i64 = 0
                var step: i64 = 0
                while step < 30 {
                    let tok = sounio_llm_sample_top_p(&m, 1.0, 0.8, rng_ptr)
                    if tok == 42 {
                        count_42 = count_42 + 1
                    } else if tok == 100 {
                        count_100 = count_100 + 1
                    } else {
                        samples_valid = false
                        break
                    }
                    step = step + 1
                }

                ok = samples_valid && (count_42 > 0)
            }
            let _af = page_arena_free(arena)
        } else {
            ok = false
        }
    } else {
        ok = false
    }

    let _mf = qwen3_model_free(m)
    ok
}

// ----------------------------------------------------------------------------
// Test 4: Qwen3EisaModel Metal NoCopy vs CPU parity + EisaArgmaxCert certification
// ----------------------------------------------------------------------------
fn test_eisa_parity_and_cert() -> bool with IO, Mut, Panic, Alloc, Div {
    let dim: i64 = 64
    let n_weights = dim * dim
    let q4_bytes = ((n_weights + 31) / 32) * 20

    let arena = page_arena_alloc(65536 * 4)
    var test_ok = false

    if page_arena_is_ok(&arena) {
        let p = page_arena_ptr(&arena)
        let w_bf16_ptr = p
        let dst_q4_ptr = p + 65536
        let x_f32_ptr = p + 65536 * 2
        let val_cpu_ptr = p + 65536 * 3
        let val_gpu_ptr = val_cpu_ptr + 1024
        let err_cpu_ptr = val_gpu_ptr + 1024

        // Populate test matrix and vector
        var i: i64 = 0
        while i < dim * dim {
            let fi = (i % 23) as f64
            let val = (fi - 11.0) * 0.05
            let _w = ptr_write_u16_le(w_bf16_ptr, i * 2, (f64_to_f32_bits(val) >> 16) & 65535)
            i = i + 1
        }
        i = 0
        while i < dim {
            let fi = i as f64
            let _w = ptr_write_u32_le(x_f32_ptr, i * 4, f64_to_f32_bits(0.1 + fi * 0.02))
            let _wv0 = ptr_write_u32_le(val_cpu_ptr, i * 4, 0)
            let _wv1 = ptr_write_u32_le(val_gpu_ptr, i * 4, 0)
            let _we = ptr_write_u32_le(err_cpu_ptr, i * 4, 0)
            i = i + 1
        }

        let quant_ok = qwen3_quantize_bf16_to_q4_eisa(w_bf16_ptr, dst_q4_ptr, dim, dim)
        if quant_ok {
            let cpu_ok = qwen3_gemv_q4_eisa_cpu(dst_q4_ptr, x_f32_ptr, 0, val_cpu_ptr, err_cpu_ptr, 0, dim, dim)

            // Test EisaArgmaxCert
            let cert = eisa_certify_argmax(val_cpu_ptr, err_cpu_ptr, 0, dim)
            let cert_ok = (cert.top1_id >= 0) && (cert.runner_up_id >= 0) && (cert.top1_id != cert.runner_up_id)

            // Test Metal if available
            let msess = metal_session_open("")
            var metal_parity_ok = true

            if metal_session_is_ok(&msess) {
                let pipes = eisa_metal_pipelines_compile(&msess)
                if pipes.ok && pipes.q4_gemv > 0 && pipes.q4_quant_bf16 > 0 {
                    let dst_gpu_q4_ptr = dst_q4_ptr + 32768
                    let b_src = metal_buffer_nocopy(&msess, w_bf16_ptr, 65536)
                    let b_dst = metal_buffer_nocopy(&msess, dst_q4_ptr, 65536)
                    let cid = metal_cmd_begin(&msess)
                    if cid > 0 {
                        let _enc = qwen3_metal_encode_quantize_q4_eisa(
                            &msess, cid, pipes.q4_quant_bf16, b_src, 0, b_dst, 32768, dim, dim
                        )
                        let _cres = metal_cmd_commit_sync(&msess, cid)
                        if _cres == 0 {
                            var bi: i64 = 0
                            while bi < q4_bytes {
                                let bc = ptr_read_u8(dst_q4_ptr, bi)
                                let bg = ptr_read_u8(dst_gpu_q4_ptr, bi)
                                if bc != bg {
                                    metal_parity_ok = false
                                    break
                                }
                                bi = bi + 1
                            }
                        } else {
                            metal_parity_ok = false
                        }
                    }
                    let _fsrc = metal_buffer_free(&msess, b_src)
                    let _fdst = metal_buffer_free(&msess, b_dst)

                    let b_w = metal_buffer_nocopy(&msess, dst_q4_ptr, 65536)
                    let b_x = metal_buffer_nocopy(&msess, x_f32_ptr, 65536)
                    let b_out = metal_buffer_nocopy(&msess, val_cpu_ptr, 65536)

                    let m_rc = qwen3_metal_gemv_q4_eisa(&msess, pipes.q4_gemv, b_w, 0, b_x, 0, b_out, 1024, b_out, 2048, dim, dim)

                    let _f0 = metal_buffer_free(&msess, b_w)
                    let _f1 = metal_buffer_free(&msess, b_x)
                    let _f2 = metal_buffer_free(&msess, b_out)

                    if m_rc == 0 {
                        var k: i64 = 0
                        var max_diff: f64 = 0.0
                        while k < dim {
                            let vc = f32_bits_to_f64(ptr_read_u32_le(val_cpu_ptr, k * 4))
                            let vg = f32_bits_to_f64(ptr_read_u32_le(val_gpu_ptr, k * 4))
                            let diff = if vc >= vg { vc - vg } else { vg - vc }
                            if diff > max_diff { max_diff = diff }
                            k = k + 1
                        }
                        if max_diff >= 0.0001 {
                            metal_parity_ok = false
                        }
                    }
                }
            }
            let _mc = metal_session_close(msess)

            test_ok = cpu_ok && cert_ok && metal_parity_ok
        }
    }

    let _af = page_arena_free(arena)
    test_ok
}

// ----------------------------------------------------------------------------
// Main Entrypoint
// ----------------------------------------------------------------------------
pub fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if !test_zero_ptx_stubs() {
        println("LLM_PHASE5_NOSTUB_AND_5SHARD_FAIL: test_zero_ptx_stubs failed")
        return 1
    }

    if !test_5shard_topology("/tmp/sounio_llm_phase5_5shard_model") {
        println("LLM_PHASE5_NOSTUB_AND_5SHARD_FAIL: test_5shard_topology failed")
        return 2
    }

    if !test_top_p_sampler_behavior("/tmp/sounio_llm_phase5_5shard_model") {
        println("LLM_PHASE5_NOSTUB_AND_5SHARD_FAIL: test_top_p_sampler_behavior failed")
        return 3
    }

    if !test_eisa_parity_and_cert() {
        println("LLM_PHASE5_NOSTUB_AND_5SHARD_FAIL: test_eisa_parity_and_cert failed")
        return 4
    }

    println("LLM_PHASE5_NOSTUB_AND_5SHARD_PASS")
    0
}
