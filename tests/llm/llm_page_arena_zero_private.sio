//@ run-pass
//@ requires: madaros
use llm::mmap::{PageArena, page_arena_alloc, page_arena_free, page_arena_is_ok, page_arena_ptr, page_arena_len}
use llm::raw_memory::{ptr_read_u8, ptr_write_u8}

fn arena_zero(a: &PageArena) -> bool {
    if !page_arena_is_ok(a) || page_arena_len(a) != 32768 { return false }
    let p = page_arena_ptr(a)
    ptr_read_u8(p, 0) == 0 && ptr_read_u8(p, 16384) == 0 && ptr_read_u8(p, 32767) == 0
}

pub fn main() -> i64 with IO, Alloc, Mut, Panic, Div {
    let a = page_arena_alloc(16385)
    let b = page_arena_alloc(16385)
    var ok = arena_zero(&a) && arena_zero(&b)
    if ok {
        let p = page_arena_ptr(&a)
        let _w = ptr_write_u8(p, 0, 90)
        let _w2 = ptr_write_u8(p, 32767, 37)
        ok = ptr_read_u8(p, 0) == 90 && ptr_read_u8(p, 32767) == 37 && arena_zero(&b)
    }
    let ra = page_arena_free(a)
    let rb = page_arena_free(b)
    if ok && ra == 0 && rb == 0 { println("LLM_PAGE_ARENA_ZERO_PRIVATE_PASS"); return 0 }
    println("LLM_PAGE_ARENA_ZERO_PRIVATE_FAIL")
    1
}
