//@ run-pass
//@ requires: madaros
use llm::raw_memory::{ptr_read_u8, ptr_read_u16_le, ptr_read_u32_le, ptr_read_i64_le, ptr_write_u8, ptr_write_u16_le, ptr_write_u32_le, ptr_write_i64_le}

fn main() -> i64 with Alloc, Mut, IO, Panic {
    let p = heap_alloc(32) as i64
    if p == 0 { return 1 }
    let _w = ptr_write_i64_le(p, 0, 0x1122334455667788)
    if ptr_read_u8(p, 3) != 0x55 || ptr_read_u16_le(p, 3) != 0x4455 || ptr_read_u32_le(p, 1) != 0x44556677 { return 2 }
    let _b = ptr_write_u8(p, 3, 0x2a)
    if ptr_read_i64_le(p, 0) != 0x112233442a667788 { return 3 }
    let _h = ptr_write_u16_le(p, 1, 0xabcd)
    if ptr_read_i64_le(p, 0) != 0x112233442aabcd88 { return 4 }
    let _i = ptr_write_u32_le(p, 3, 0xfedcba98)
    if ptr_read_u32_le(p, 3) != 0xfedcba98 || ptr_read_u8(p, 7) != 0x11 || ptr_read_u8(p, 2) != 0xab { return 5 }
    let _n = ptr_write_i64_le(p, 9, -42)
    if ptr_read_i64_le(p, 9) != -42 { return 6 }
    heap_free(p as *mut u8)
    println("LLM_RAW_MEMORY_CONTRACT_PASS")
    0
}
