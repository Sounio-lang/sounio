//@ run-pass
//@ requires: madaros
//@ expect-stdout: LLM_PHASE5_PTX_INTEGRITY_PASS
//
// Phase 5 PTX Integrity Test:
// Verifies that emit_qwen3_ptx_sm80_cstr, emit_eisa_ptx_sm80_cstr, and
// emit_ossm_ptx_sm80_cstr emit complete sm_80 PTX implementations
// containing real ISA instructions and no { ret; } stubs.

use llm::ptx_kernels_sm80::{
    emit_qwen3_ptx_sm80_cstr,
    emit_eisa_ptx_sm80_cstr,
    emit_ossm_ptx_sm80_cstr,
}

fn find_sub_from(buf: i64, start: i64, needle: string) -> i64 with Mut {
    let n_len = str_len(needle)
    if n_len == 0 { return start }
    var pos = start
    while true {
        let b = ptr_read_u8(buf, pos)
        if b == 0 { return -1 }
        var is_match = true
        var j: i64 = 0
        while j < n_len {
            let bj = ptr_read_u8(buf, pos + j)
            let nj = str_char_at(needle, j)
            if bj != nj {
                is_match = false
                j = n_len
            } else {
                j = j + 1
            }
        }
        if is_match { return pos }
        pos = pos + 1
    }
    -1
}

fn find_sub_between(buf: i64, start: i64, end: i64, needle: string) -> bool with Mut {
    let n_len = str_len(needle)
    if n_len == 0 { return true }
    var pos = start
    while pos + n_len <= end {
        var is_match = true
        var j: i64 = 0
        while j < n_len {
            let bj = ptr_read_u8(buf, pos + j)
            let nj = str_char_at(needle, j)
            if bj != nj {
                is_match = false
                j = n_len
            } else {
                j = j + 1
            }
        }
        if is_match { return true }
        pos = pos + 1
    }
    false
}

fn verify_header(buf: i64) -> bool with Mut {
    if find_sub_from(buf, 0, ".version 8.0") < 0 { return false }
    if find_sub_from(buf, 0, ".target sm_80") < 0 { return false }
    if find_sub_from(buf, 0, ".address_size 64") < 0 { return false }
    true
}

fn verify_cleanliness(buf: i64) -> bool with Mut {
    if find_sub_from(buf, 0, "2f40000000") >= 0 { return false }
    if find_sub_from(buf, 0, "0xFF") >= 0 { return false }
    if find_sub_from(buf, 0, "0xff") >= 0 { return false }
    true
}

fn verify_kernel(buf: i64, name: string) -> bool with Mut {
    let pos_entry = find_sub_from(buf, 0, name)
    if pos_entry < 0 { return false }
    let pos_brace = find_sub_from(buf, pos_entry, "{")
    if pos_brace < 0 { return false }
    let pos_ret = find_sub_from(buf, pos_brace, "ret;")
    if pos_ret < 0 { return false }
    let dist = pos_ret - pos_brace
    if dist < 120 { return false }
    if !find_sub_between(buf, pos_brace, pos_ret, ".reg") { return false }
    if !find_sub_between(buf, pos_brace, pos_ret, "ld.param") { return false }
    if !find_sub_between(buf, pos_brace, pos_ret, "ld.global") { return false }
    if !find_sub_between(buf, pos_brace, pos_ret, "st.global") { return false }
    true
}

fn main() -> i64 with Alloc, Mut, IO {
    var ok = true

    // 1. Qwen3 sm80 PTX
    let buf_qwen3 = emit_qwen3_ptx_sm80_cstr()
    if buf_qwen3 == 0 {
        println("FAIL: buf_qwen3 is null")
        return 1
    }
    if !verify_header(buf_qwen3) {
        println("FAIL: buf_qwen3 header invalid")
        ok = false
    }
    if !verify_cleanliness(buf_qwen3) {
        println("FAIL: buf_qwen3 contains forbidden syntax (2f40000000 or 0xFF)")
        ok = false
    }
    if !verify_kernel(buf_qwen3, "qwen3_rmsnorm_bf16") {
        println("FAIL: qwen3_rmsnorm_bf16 failed integrity check")
        ok = false
    }
    if !verify_kernel(buf_qwen3, "qwen3_rope_f32") {
        println("FAIL: qwen3_rope_f32 failed integrity check")
        ok = false
    }
    if !verify_kernel(buf_qwen3, "qwen3_bf16_gemv_f32") {
        println("FAIL: qwen3_bf16_gemv_f32 failed integrity check")
        ok = false
    }
    if !verify_kernel(buf_qwen3, "qwen3_swiglu_f32") {
        println("FAIL: qwen3_swiglu_f32 failed integrity check")
        ok = false
    }
    if !verify_kernel(buf_qwen3, "qwen3_paged_gqa_f32") {
        println("FAIL: qwen3_paged_gqa_f32 failed integrity check")
        ok = false
    }
    heap_free(buf_qwen3 as *mut u8)

    // 2. EISA sm80 PTX
    let buf_eisa = emit_eisa_ptx_sm80_cstr()
    if buf_eisa == 0 {
        println("FAIL: buf_eisa is null")
        return 1
    }
    if !verify_header(buf_eisa) {
        println("FAIL: buf_eisa header invalid")
        ok = false
    }
    if !verify_cleanliness(buf_eisa) {
        println("FAIL: buf_eisa contains forbidden syntax (2f40000000 or 0xFF)")
        ok = false
    }
    if !verify_kernel(buf_eisa, "qwen3_gemv_q4_eisa") {
        println("FAIL: qwen3_gemv_q4_eisa failed integrity check")
        ok = false
    }
    if !verify_kernel(buf_eisa, "qwen3_gemv_q8_eisa") {
        println("FAIL: qwen3_gemv_q8_eisa failed integrity check")
        ok = false
    }
    heap_free(buf_eisa as *mut u8)

    // 3. O-SSM sm80 PTX
    let buf_ossm = emit_ossm_ptx_sm80_cstr()
    if buf_ossm == 0 {
        println("FAIL: buf_ossm is null")
        return 1
    }
    if !verify_header(buf_ossm) {
        println("FAIL: buf_ossm header invalid")
        ok = false
    }
    if !verify_cleanliness(buf_ossm) {
        println("FAIL: buf_ossm contains forbidden syntax (2f40000000 or 0xFF)")
        ok = false
    }
    if !verify_kernel(buf_ossm, "qwen3_ossm_step_f32") {
        println("FAIL: qwen3_ossm_step_f32 failed integrity check")
        ok = false
    }
    heap_free(buf_ossm as *mut u8)

    if ok {
        println("LLM_PHASE5_PTX_INTEGRITY_PASS")
        0
    } else {
        1
    }
}
