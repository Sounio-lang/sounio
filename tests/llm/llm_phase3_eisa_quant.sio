//@ run-pass
//@ requires: madaros
//@ expect-stdout: LLM_PHASE3_EISA_QUANT_PASS
//
// Phase 3: Block-32 Quantization Formats (Q4_EISA & Q8_EISA) with Strict
// Epistemic Error and Measurement Uncertainty Propagation.
//
// Evaluates:
// 1. Memory budget contract: qwen3_eisa_q4_bytes(8190735360) == 5119209600.
// 2. Test A (Qwen3-8B width 64 x 4096):
//    - Strict containment: abs(y_bf16 - val) <= err for 100% of rows on CPU and GPU.
//    - CPU vs GPU parity (max_diff < 1e-4).
//    - Epistemic tightness: mean(err_q8) < mean(err_q4) * 0.1 (> 10x tighter).
// 3. Test B (Constructive Argmax Discrimination & Epistemic Separation):
//    - Close logits (margin 0.05) where Q4 is uncertified, but Q8 is certified.
//    - Strict separation of err and u: non-zero u_x increases combined_u while err and val remain unchanged.

use llm::mmap::{
    PageArena,
    page_arena_alloc,
    page_arena_free,
    page_arena_ptr,
}
use tensor2::convert::{
    f64_to_bf16_bits,
    bf16_bits_to_f64,
    f64_to_f32_bits,
    f32_bits_to_f64,
}
use llm::hal::{
    MetalSession,
    metal_session_open,
    metal_session_close,
    metal_session_is_ok,
    metal_buffer_nocopy,
    metal_buffer_free,
    CudaDriverSession,
    cuda_session_open,
    cuda_session_close,
    cuda_session_is_ok,
    cuda_module_load_ptx_ptr,
    cuda_module_unload,
    cuda_module_get_fn,
    cuda_mem_alloc,
    cuda_mem_free,
    cuda_memcpy_h2d,
    cuda_memcpy_d2h,
}
use llm::qwen3_quant_eisa::{
    EisaScalar,
    EisaArgmaxCert,
    EisaMetalPipelines,
    eisa_metal_pipelines_empty,
    qwen3_eisa_q4_bytes,
    qwen3_eisa_q8_bytes,
    qwen3_quantize_bf16_to_q4_eisa,
    qwen3_quantize_bf16_to_q8_eisa,
    qwen3_gemv_q4_eisa_cpu,
    qwen3_gemv_q8_eisa_cpu,
    eisa_certify_argmax,
    emit_eisa_kernels_msl_cstr,
    eisa_metal_pipelines_compile,
    qwen3_metal_gemv_q4_eisa,
    qwen3_metal_gemv_q8_eisa,
    emit_eisa_kernels_ptx_cstr,
    qwen3_cuda_gemv_q4_eisa,
    qwen3_cuda_gemv_q8_eisa,
}

fn f64_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn write_f32_at(ptr: i64, idx: i64, val: f64) with Mut {
    let _w = ptr_write_u32_le(ptr, idx * 4, f64_to_f32_bits(val))
}

fn read_f32_at(ptr: i64, idx: i64) -> f64 with Mut {
    f32_bits_to_f64(ptr_read_u32_le(ptr, idx * 4))
}

fn write_bf16_at(ptr: i64, idx: i64, val: f64) with Mut {
    let _w = ptr_write_u16_le(ptr, idx * 2, f64_to_bf16_bits(val))
}

fn read_bf16_at(ptr: i64, idx: i64) -> f64 with Mut {
    bf16_bits_to_f64(ptr_read_u16_le(ptr, idx * 2))
}

fn run_test_a_metal(
    sess: &MetalSession,
    p_q4: i64,
    p_q8: i64,
    p_x: i64,
    p_y_bf16: i64,
    p_val_q4_cpu: i64,
    p_err_q4_cpu: i64,
    p_val_q8_cpu: i64,
    p_err_q8_cpu: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with IO, Alloc, Mut {
    let pipes = eisa_metal_pipelines_compile(sess)
    if !pipes.ok {
        println("FAIL: eisa_metal_pipelines_compile")
        return false
    }

    let q4_bytes = qwen3_eisa_q4_bytes(out_dim * in_dim)
    let q8_bytes = qwen3_eisa_q8_bytes(out_dim * in_dim)
    let x_bytes = in_dim * 4
    let out_bytes = out_dim * 4

    let arena_gpu_val_q4 = page_arena_alloc(out_bytes)
    let arena_gpu_err_q4 = page_arena_alloc(out_bytes)
    let arena_gpu_val_q8 = page_arena_alloc(out_bytes)
    let arena_gpu_err_q8 = page_arena_alloc(out_bytes)

    let p_gpu_val_q4 = page_arena_ptr(&arena_gpu_val_q4)
    let p_gpu_err_q4 = page_arena_ptr(&arena_gpu_err_q4)
    let p_gpu_val_q8 = page_arena_ptr(&arena_gpu_val_q8)
    let p_gpu_err_q8 = page_arena_ptr(&arena_gpu_err_q8)

    let buf_q4 = metal_buffer_nocopy(sess, p_q4, q4_bytes)
    let buf_q8 = metal_buffer_nocopy(sess, p_q8, q8_bytes)
    let buf_x = metal_buffer_nocopy(sess, p_x, x_bytes)
    let buf_val_q4 = metal_buffer_nocopy(sess, p_gpu_val_q4, out_bytes)
    let buf_err_q4 = metal_buffer_nocopy(sess, p_gpu_err_q4, out_bytes)
    let buf_val_q8 = metal_buffer_nocopy(sess, p_gpu_val_q8, out_bytes)
    let buf_err_q8 = metal_buffer_nocopy(sess, p_gpu_err_q8, out_bytes)

    var ok = true
    let rc4 = qwen3_metal_gemv_q4_eisa(sess, pipes.q4_gemv, buf_q4, 0, buf_x, 0, buf_val_q4, 0, buf_err_q4, 0, out_dim, in_dim)
    let rc8 = qwen3_metal_gemv_q8_eisa(sess, pipes.q8_gemv, buf_q8, 0, buf_x, 0, buf_val_q8, 0, buf_err_q8, 0, out_dim, in_dim)

    let _f0 = metal_buffer_free(sess, buf_q4)
    let _f1 = metal_buffer_free(sess, buf_q8)
    let _f2 = metal_buffer_free(sess, buf_x)
    let _f3 = metal_buffer_free(sess, buf_val_q4)
    let _f4 = metal_buffer_free(sess, buf_err_q4)
    let _f5 = metal_buffer_free(sess, buf_val_q8)
    let _f6 = metal_buffer_free(sess, buf_err_q8)

    if rc4 != 0 || rc8 != 0 {
        println("FAIL: metal kernel launch returned non-zero")
        ok = false
    } else {
        var r: i64 = 0
        while r < out_dim {
            let y = read_f32_at(p_y_bf16, r)
            let val_q4_gpu = read_f32_at(p_gpu_val_q4, r)
            let err_q4_gpu = read_f32_at(p_gpu_err_q4, r)
            let val_q8_gpu = read_f32_at(p_gpu_val_q8, r)
            let err_q8_gpu = read_f32_at(p_gpu_err_q8, r)

            let diff_q4 = f64_abs(y - val_q4_gpu)
            if diff_q4 > err_q4_gpu {
                println("FAIL: Metal Q4 containment violated")
                ok = false
            }
            let diff_q8 = f64_abs(y - val_q8_gpu)
            if diff_q8 > err_q8_gpu {
                println("FAIL: Metal Q8 containment violated")
                ok = false
            }

            let val_q4_cpu = read_f32_at(p_val_q4_cpu, r)
            let err_q4_cpu = read_f32_at(p_err_q4_cpu, r)
            let val_q8_cpu = read_f32_at(p_val_q8_cpu, r)
            let err_q8_cpu = read_f32_at(p_err_q8_cpu, r)

            if f64_abs(val_q4_cpu - val_q4_gpu) >= 0.0001 || f64_abs(err_q4_cpu - err_q4_gpu) >= 0.0001 {
                println("FAIL: CPU vs Metal Q4 parity")
                ok = false
            }
            if f64_abs(val_q8_cpu - val_q8_gpu) >= 0.0001 || f64_abs(err_q8_cpu - err_q8_gpu) >= 0.0001 {
                println("FAIL: CPU vs Metal Q8 parity")
                ok = false
            }

            r = r + 1
        }
    }

    let _c0 = page_arena_free(arena_gpu_val_q4)
    let _c1 = page_arena_free(arena_gpu_err_q4)
    let _c2 = page_arena_free(arena_gpu_val_q8)
    let _c3 = page_arena_free(arena_gpu_err_q8)
    ok
}

fn run_test_a_cuda(
    sess: &CudaDriverSession,
    p_q4: i64,
    p_q8: i64,
    p_x: i64,
    p_y_bf16: i64,
    p_val_q4_cpu: i64,
    p_err_q4_cpu: i64,
    p_val_q8_cpu: i64,
    p_err_q8_cpu: i64,
    out_dim: i64,
    in_dim: i64
) -> bool with IO, Alloc, Mut {
    let ptx_cstr = emit_eisa_kernels_ptx_cstr()
    let hmod = cuda_module_load_ptx_ptr(sess, ptx_cstr)
    heap_free(ptx_cstr as *mut u8)
    if hmod == 0 {
        println("FAIL: cuda_module_load_ptx_ptr")
        return false
    }

    let hfn_q4 = cuda_module_get_fn(sess, hmod, "qwen3_gemv_q4_eisa")
    let hfn_q8 = cuda_module_get_fn(sess, hmod, "qwen3_gemv_q8_eisa")
    if hfn_q4 == 0 || hfn_q8 == 0 {
        let _u = cuda_module_unload(sess, hmod)
        println("FAIL: cuda_module_get_fn")
        return false
    }

    let q4_bytes = qwen3_eisa_q4_bytes(out_dim * in_dim)
    let q8_bytes = qwen3_eisa_q8_bytes(out_dim * in_dim)
    let x_bytes = in_dim * 4
    let out_bytes = out_dim * 4

    let d_q4 = cuda_mem_alloc(sess, q4_bytes)
    let d_q8 = cuda_mem_alloc(sess, q8_bytes)
    let d_x = cuda_mem_alloc(sess, x_bytes)
    let d_val = cuda_mem_alloc(sess, out_bytes)
    let d_err = cuda_mem_alloc(sess, out_bytes)

    if d_q4 == 0 || d_q8 == 0 || d_x == 0 || d_val == 0 || d_err == 0 {
        if d_q4 != 0 { let _f = cuda_mem_free(sess, d_q4) }
        if d_q8 != 0 { let _f = cuda_mem_free(sess, d_q8) }
        if d_x != 0 { let _f = cuda_mem_free(sess, d_x) }
        if d_val != 0 { let _f = cuda_mem_free(sess, d_val) }
        if d_err != 0 { let _f = cuda_mem_free(sess, d_err) }
        let _u = cuda_module_unload(sess, hmod)
        println("FAIL: cuda_mem_alloc")
        return false
    }

    let arena_cuda_out_val = page_arena_alloc(out_bytes)
    let arena_cuda_out_err = page_arena_alloc(out_bytes)
    let p_cuda_val = page_arena_ptr(&arena_cuda_out_val)
    let p_cuda_err = page_arena_ptr(&arena_cuda_out_err)

    var ok = true
    let _h0 = cuda_memcpy_h2d(sess, d_q4, p_q4, q4_bytes)
    let _h1 = cuda_memcpy_h2d(sess, d_x, p_x, x_bytes)
    let rc4 = qwen3_cuda_gemv_q4_eisa(sess, hfn_q4, d_q4, d_x, d_val, d_err, out_dim, in_dim)
    let _d0 = cuda_memcpy_d2h(sess, p_cuda_val, d_val, out_bytes)
    let _d1 = cuda_memcpy_d2h(sess, p_cuda_err, d_err, out_bytes)

    if rc4 != 0 {
        println("FAIL: cuda launch q4")
        ok = false
    } else {
        var r: i64 = 0
        while r < out_dim {
            let y = read_f32_at(p_y_bf16, r)
            let val_gpu = read_f32_at(p_cuda_val, r)
            let err_gpu = read_f32_at(p_cuda_err, r)
            if f64_abs(y - val_gpu) > err_gpu {
                println("FAIL: CUDA Q4 containment")
                ok = false
            }
            let val_cpu = read_f32_at(p_val_q4_cpu, r)
            let err_cpu = read_f32_at(p_err_q4_cpu, r)
            if f64_abs(val_cpu - val_gpu) >= 0.0001 || f64_abs(err_cpu - err_gpu) >= 0.0001 {
                println("FAIL: CPU vs CUDA Q4 parity")
                ok = false
            }
            r = r + 1
        }
    }

    let _h2 = cuda_memcpy_h2d(sess, d_q8, p_q8, q8_bytes)
    let rc8 = qwen3_cuda_gemv_q8_eisa(sess, hfn_q8, d_q8, d_x, d_val, d_err, out_dim, in_dim)
    let _d2 = cuda_memcpy_d2h(sess, p_cuda_val, d_val, out_bytes)
    let _d3 = cuda_memcpy_d2h(sess, p_cuda_err, d_err, out_bytes)

    if rc8 != 0 {
        println("FAIL: cuda launch q8")
        ok = false
    } else {
        var r: i64 = 0
        while r < out_dim {
            let y = read_f32_at(p_y_bf16, r)
            let val_gpu = read_f32_at(p_cuda_val, r)
            let err_gpu = read_f32_at(p_cuda_err, r)
            if f64_abs(y - val_gpu) > err_gpu {
                println("FAIL: CUDA Q8 containment")
                ok = false
            }
            let val_cpu = read_f32_at(p_val_q8_cpu, r)
            let err_cpu = read_f32_at(p_err_q8_cpu, r)
            if f64_abs(val_cpu - val_gpu) >= 0.0001 || f64_abs(err_cpu - err_gpu) >= 0.0001 {
                println("FAIL: CPU vs CUDA Q8 parity")
                ok = false
            }
            r = r + 1
        }
    }

    let _f0 = cuda_mem_free(sess, d_q4)
    let _f1 = cuda_mem_free(sess, d_q8)
    let _f2 = cuda_mem_free(sess, d_x)
    let _f3 = cuda_mem_free(sess, d_val)
    let _f4 = cuda_mem_free(sess, d_err)
    let _u = cuda_module_unload(sess, hmod)
    let _c0 = page_arena_free(arena_cuda_out_val)
    let _c1 = page_arena_free(arena_cuda_out_err)
    ok
}

fn test_a_runner() -> bool with IO, Mut, Alloc, Div {
    let out_dim: i64 = 64
    let in_dim: i64 = 4096

    let arena_w = page_arena_alloc(out_dim * in_dim * 2)
    let arena_x = page_arena_alloc(in_dim * 4)
    let arena_q4 = page_arena_alloc(qwen3_eisa_q4_bytes(out_dim * in_dim))
    let arena_q8 = page_arena_alloc(qwen3_eisa_q8_bytes(out_dim * in_dim))
    let arena_y = page_arena_alloc(out_dim * 4)
    let arena_val_q4 = page_arena_alloc(out_dim * 4)
    let arena_err_q4 = page_arena_alloc(out_dim * 4)
    let arena_val_q8 = page_arena_alloc(out_dim * 4)
    let arena_err_q8 = page_arena_alloc(out_dim * 4)

    let p_w = page_arena_ptr(&arena_w)
    let p_x = page_arena_ptr(&arena_x)
    let p_q4 = page_arena_ptr(&arena_q4)
    let p_q8 = page_arena_ptr(&arena_q8)
    let p_y = page_arena_ptr(&arena_y)
    let p_val_q4 = page_arena_ptr(&arena_val_q4)
    let p_err_q4 = page_arena_ptr(&arena_err_q4)
    let p_val_q8 = page_arena_ptr(&arena_val_q8)
    let p_err_q8 = page_arena_ptr(&arena_err_q8)

    // Populate deterministic BF16 weights and FP32 inputs
    var idx: i64 = 0
    let total_weights = out_dim * in_dim
    while idx < total_weights {
        let v = ((((idx % 17) - 8) as f64) * 0.0625)
        write_bf16_at(p_w, idx, v)
        idx = idx + 1
    }

    var c: i64 = 0
    while c < in_dim {
        let v = ((((c % 13) - 6) as f64) * 0.03125)
        write_f32_at(p_x, c, v)
        c = c + 1
    }

    // Reference BF16 GEMV on CPU
    var r: i64 = 0
    while r < out_dim {
        var sum: f64 = 0.0
        c = 0
        while c < in_dim {
            let w = read_bf16_at(p_w, r * in_dim + c)
            let x = read_f32_at(p_x, c)
            sum = sum + w * x
            c = c + 1
        }
        write_f32_at(p_y, r, sum)
        r = r + 1
    }

    // Quantize
    let q4_ok = qwen3_quantize_bf16_to_q4_eisa(p_w, p_q4, out_dim, in_dim)
    let q8_ok = qwen3_quantize_bf16_to_q8_eisa(p_w, p_q8, out_dim, in_dim)
    if !q4_ok || !q8_ok {
        println("FAIL: quantization failed")
        return false
    }

    // CPU GEMV
    let gemv_q4_ok = qwen3_gemv_q4_eisa_cpu(p_q4, p_x, 0, p_val_q4, p_err_q4, 0, out_dim, in_dim)
    let gemv_q8_ok = qwen3_gemv_q8_eisa_cpu(p_q8, p_x, 0, p_val_q8, p_err_q8, 0, out_dim, in_dim)
    if !gemv_q4_ok || !gemv_q8_ok {
        println("FAIL: CPU GEMV failed")
        return false
    }

    // Containment and Tightness check on CPU
    var ok = true
    var sum_err_q4: f64 = 0.0
    var sum_err_q8: f64 = 0.0
    r = 0
    while r < out_dim {
        let y = read_f32_at(p_y, r)
        let v4 = read_f32_at(p_val_q4, r)
        let e4 = read_f32_at(p_err_q4, r)
        let v8 = read_f32_at(p_val_q8, r)
        let e8 = read_f32_at(p_err_q8, r)

        let diff4 = f64_abs(y - v4)
        if diff4 > e4 {
            println("FAIL: CPU Q4 containment violated")
            ok = false
        }
        let diff8 = f64_abs(y - v8)
        if diff8 > e8 {
            println("FAIL: CPU Q8 containment violated")
            ok = false
        }

        sum_err_q4 = sum_err_q4 + e4
        sum_err_q8 = sum_err_q8 + e8
        r = r + 1
    }

    let mean_err_q4 = sum_err_q4 / (out_dim as f64)
    let mean_err_q8 = sum_err_q8 / (out_dim as f64)
    if mean_err_q8 >= mean_err_q4 * 0.1 {
        println("FAIL: Q8 bound is not > 10x tighter than Q4")
        ok = false
    }

    // GPU path (Metal on Darwin, CUDA on Linux)
    let metal_s = metal_session_open("")
    if metal_session_is_ok(&metal_s) {
        let metal_ok = run_test_a_metal(&metal_s, p_q4, p_q8, p_x, p_y, p_val_q4, p_err_q4, p_val_q8, p_err_q8, out_dim, in_dim)
        if !metal_ok { ok = false }
    }
    let _ms = metal_session_close(metal_s)

    let cuda_s = cuda_session_open("", 0)
    if cuda_session_is_ok(&cuda_s) {
        let cuda_ok = run_test_a_cuda(&cuda_s, p_q4, p_q8, p_x, p_y, p_val_q4, p_err_q4, p_val_q8, p_err_q8, out_dim, in_dim)
        if !cuda_ok { ok = false }
    }
    let _cs = cuda_session_close(cuda_s)

    let _a0 = page_arena_free(arena_w)
    let _a1 = page_arena_free(arena_x)
    let _a2 = page_arena_free(arena_q4)
    let _a3 = page_arena_free(arena_q8)
    let _a4 = page_arena_free(arena_y)
    let _a5 = page_arena_free(arena_val_q4)
    let _a6 = page_arena_free(arena_err_q4)
    let _a7 = page_arena_free(arena_val_q8)
    let _a8 = page_arena_free(arena_err_q8)

    ok
}

fn test_b_runner() -> bool with IO, Mut, Alloc, Div {
    let out_dim: i64 = 16
    let in_dim: i64 = 32

    let arena_w = page_arena_alloc(out_dim * in_dim * 2)
    let arena_x = page_arena_alloc(in_dim * 4)
    let arena_ux = page_arena_alloc(in_dim * 4)
    let arena_q4 = page_arena_alloc(qwen3_eisa_q4_bytes(out_dim * in_dim))
    let arena_q8 = page_arena_alloc(qwen3_eisa_q8_bytes(out_dim * in_dim))

    let arena_val_q4 = page_arena_alloc(out_dim * 4)
    let arena_err_q4 = page_arena_alloc(out_dim * 4)
    let arena_val_q8 = page_arena_alloc(out_dim * 4)
    let arena_err_q8 = page_arena_alloc(out_dim * 4)
    let arena_u_q8 = page_arena_alloc(out_dim * 4)

    let p_w = page_arena_ptr(&arena_w)
    let p_x = page_arena_ptr(&arena_x)
    let p_ux = page_arena_ptr(&arena_ux)
    let p_q4 = page_arena_ptr(&arena_q4)
    let p_q8 = page_arena_ptr(&arena_q8)
    let p_val_q4 = page_arena_ptr(&arena_val_q4)
    let p_err_q4 = page_arena_ptr(&arena_err_q4)
    let p_val_q8 = page_arena_ptr(&arena_val_q8)
    let p_err_q8 = page_arena_ptr(&arena_err_q8)
    let p_u_q8 = page_arena_ptr(&arena_u_q8)

    // Vector x: all 0.125
    var c: i64 = 0
    while c < in_dim {
        write_f32_at(p_x, c, 0.125)
        write_f32_at(p_ux, c, 0.01)
        c = c + 1
    }

    // Row 0: target dot product 10.15
    c = 0
    var sum_dot0: f64 = 0.0
    while c < in_dim {
        let base_val = 2.5375 + 0.1 * (((c % 5) - 2) as f64)
        write_bf16_at(p_w, c, base_val)
        let actual_bf16 = read_bf16_at(p_w, c)
        sum_dot0 = sum_dot0 + actual_bf16 * 0.125
        c = c + 1
    }
    let corr0 = (10.15 - sum_dot0) / 4.0
    c = 0
    while c < in_dim {
        let curr = read_bf16_at(p_w, c)
        write_bf16_at(p_w, c, curr + corr0)
        c = c + 1
    }

    // Row 1: target dot product 10.00
    c = 0
    var sum_dot1: f64 = 0.0
    while c < in_dim {
        let base_val = 2.5000 + 0.1 * (((c % 5) - 2) as f64)
        write_bf16_at(p_w, in_dim + c, base_val)
        let actual_bf16 = read_bf16_at(p_w, in_dim + c)
        sum_dot1 = sum_dot1 + actual_bf16 * 0.125
        c = c + 1
    }
    let corr1 = (10.00 - sum_dot1) / 4.0
    c = 0
    while c < in_dim {
        let curr = read_bf16_at(p_w, in_dim + c)
        write_bf16_at(p_w, in_dim + c, curr + corr1)
        c = c + 1
    }

    // Rows 2..15: dot product 2.0 (far below rows 0 and 1)
    var r: i64 = 2
    while r < out_dim {
        c = 0
        while c < in_dim {
            write_bf16_at(p_w, r * in_dim + c, 0.5)
            c = c + 1
        }
        r = r + 1
    }

    // Quantize
    let _q4 = qwen3_quantize_bf16_to_q4_eisa(p_w, p_q4, out_dim, in_dim)
    let _q8 = qwen3_quantize_bf16_to_q8_eisa(p_w, p_q8, out_dim, in_dim)

    // CPU GEMV without u_x
    let _g4 = qwen3_gemv_q4_eisa_cpu(p_q4, p_x, 0, p_val_q4, p_err_q4, 0, out_dim, in_dim)
    let _g8 = qwen3_gemv_q8_eisa_cpu(p_q8, p_x, 0, p_val_q8, p_err_q8, 0, out_dim, in_dim)

    let cert_q4 = eisa_certify_argmax(p_val_q4, p_err_q4, 0, out_dim)
    let cert_q8 = eisa_certify_argmax(p_val_q8, p_err_q8, 0, out_dim)

    var ok = true
    if cert_q4.certified_numerical {
        println("FAIL: Q4 should not be certified numerically on close margin")
        ok = false
    }
    if !cert_q8.certified_numerical {
        println("FAIL: Q8 should be certified numerically")
        ok = false
    }
    if cert_q8.top1_id != 0 {
        println("FAIL: Q8 top1_id should be 0")
        ok = false
    }

    // Now run with measurement uncertainty u_x > 0
    let _g8_u = qwen3_gemv_q8_eisa_cpu(p_q8, p_x, p_ux, p_val_q8, p_err_q8, p_u_q8, out_dim, in_dim)
    let cert_q8_u = eisa_certify_argmax(p_val_q8, p_err_q8, p_u_q8, out_dim)

    if cert_q8_u.combined_u <= 0.0 {
        println("FAIL: combined_u should be > 0.0")
        ok = false
    }
    if cert_q8_u.combined_err != cert_q8.combined_err {
        println("FAIL: combined_err changed when adding u_x")
        ok = false
    }
    if cert_q8_u.top1_val != cert_q8.top1_val {
        println("FAIL: top1_val changed when adding u_x")
        ok = false
    }

    let _a0 = page_arena_free(arena_w)
    let _a1 = page_arena_free(arena_x)
    let _a2 = page_arena_free(arena_ux)
    let _a3 = page_arena_free(arena_q4)
    let _a4 = page_arena_free(arena_q8)
    let _a5 = page_arena_free(arena_val_q4)
    let _a6 = page_arena_free(arena_err_q4)
    let _a7 = page_arena_free(arena_val_q8)
    let _a8 = page_arena_free(arena_err_q8)
    let _a9 = page_arena_free(arena_u_q8)

    ok
}

fn main() -> i32 with IO, Mut, Alloc, Div {
    let budget_q4 = qwen3_eisa_q4_bytes(8190735360)
    if budget_q4 != 5119209600 {
        println("FAIL: budget_q4 contract")
        return 1
    }

    let ok_a = test_a_runner()
    if !ok_a {
        println("FAIL: Test A")
        return 1
    }

    let ok_b = test_b_runner()
    if !ok_b {
        println("FAIL: Test B")
        return 1
    }

    println("LLM_PHASE3_EISA_QUANT_PASS")
    0
}
