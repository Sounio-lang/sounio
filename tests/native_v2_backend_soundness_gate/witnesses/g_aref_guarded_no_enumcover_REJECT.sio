// A-refine boundary: a guarded INTEGER match with no unguarded catch-all and no
// enum scrutinee at all -> arm_unconditional_variant_idx finds no covering arm,
// so enum-exhaustiveness cannot be proven -> must REJECT (unchanged base behavior).
fn main()->i64 {
    let n:i64 = 3
    match n {
        m if m>10 => 1,
        m if m>0 => 2
    }
}
