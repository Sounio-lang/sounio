// A-refine boundary: B is covered ONLY by a guarded arm (no unguarded B arm).
// If both B guards fail, res is uninitialized -> must REJECT.
enum E { A{x:i64}, B{y:i64} }
fn main()->i64 {
    let e:E = E::B{y:3}
    match e {
        E::A{x} => x,
        E::B{y} if y>10 => 1,
        E::B{y} if y>0 => 2
    }
}
