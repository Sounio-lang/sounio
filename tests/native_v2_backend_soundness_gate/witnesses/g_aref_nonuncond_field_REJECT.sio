// A-refine boundary: the "unguarded" A arm has a NESTED LITERAL field pattern
// (x:0), so it is NOT an unconditional cover of A -- it can fail to match. With
// the only other A arm guarded, an all-fail path is possible -> must REJECT.
enum E { A{x:i64}, B }
fn main()->i64 {
    let e:E = E::A{x:5}
    match e {
        E::A{x:0} => 1,
        E::A{x} if x>10 => 2,
        E::B => 9
    }
}
