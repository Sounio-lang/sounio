// A-refine: exhaustive guarded enum match over THREE variants. Every variant
// has an UNGUARDED arm (A via arm 2, B via arm 3, C via arm 4), so the
// all-guards-false path cannot leave res uninitialized. Must compile + return 3.
enum E { A{x:i64}, B{y:i64}, C }
fn main()->i64 {
    let e:E = E::B{y:7}
    match e {
        E::A{x} if x>10 => 1,
        E::A{x} => x,
        E::B{y} if y>100 => 2,
        E::B{y} => 3,
        E::C => 9
    }
}
