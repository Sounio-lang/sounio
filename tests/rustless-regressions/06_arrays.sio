// Rustless Regression Test 06: Arrays
//
// Tests: array indexing, array literals, array operations

fn sum_array(arr: [i64; 5]) -> i64 with Mut, Panic, Div {
    var sum: i64 = 0
    var i: i64 = 0

    while i < 5 {
        sum = sum + arr[i]
        i = i + 1
    }

    sum
}

fn array_multiply(arr: [i64; 3], factor: i64) -> [i64; 3] with Mut, Panic, Div {
    var result: [i64; 3] = [0; 3]
    var i: i64 = 0

    while i < 3 {
        result[i] = arr[i] * factor
        i = i + 1
    }

    result
}

fn main() -> i64 with IO, Mut, Panic, Div {
    // Test array literal and indexing
    let arr1: [i64; 5] = [1, 2, 3, 4, 5]

    if arr1[0] != 1 { return 1 }
    if arr1[2] != 3 { return 2 }
    if arr1[4] != 5 { return 3 }

    // Test sum_array
    let total = sum_array(arr1)
    if total != 15 { return 4 }  // 1+2+3+4+5 = 15

    // Test array_multiply
    let arr2: [i64; 3] = [10, 20, 30]
    let arr3 = array_multiply(arr2, 2)

    if arr3[0] != 20 { return 5 }
    if arr3[1] != 40 { return 6 }
    if arr3[2] != 60 { return 7 }

    // Test zero-initialized array
    let zeros: [i64; 4] = [0; 4]
    if zeros[0] != 0 { return 8 }
    if zeros[3] != 0 { return 9 }

    0  // All tests passed
}
