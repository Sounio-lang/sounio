// Rustless Regression Test 04: Functions
//
// Tests: parameter passing, return values, multiple parameters

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn mul(a: i64, b: i64) -> i64 {
    a * b
}

fn compute(x: i64, y: i64, z: i64) -> i64 {
    add(mul(x, y), z)
}

fn identity(x: i64) -> i64 {
    x
}

fn constant() -> i64 {
    42
}

fn main() -> i64 with IO {
    // Test simple functions
    let r1 = add(10, 20)
    if r1 != 30 { return 1 }

    let r2 = mul(6, 7)
    if r2 != 42 { return 2 }

    // Test function composition
    let r3 = compute(5, 6, 10)  // (5*6) + 10 = 40
    if r3 != 40 { return 3 }

    // Test identity
    let r4 = identity(99)
    if r4 != 99 { return 4 }

    // Test constant
    let r5 = constant()
    if r5 != 42 { return 5 }

    0  // All tests passed
}
