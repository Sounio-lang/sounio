// Rustless Regression Test 09: Comprehensive Integration
//
// Tests: combination of multiple features in a realistic scenario

struct TestResult {
    test_id: i64,
    passed: bool,
    score: i64,
}

fn run_arithmetic_tests() -> TestResult {
    let a = 100 + 50  // 150
    let b = a - 30    // 120
    let c = b * 2     // 240
    let d = c / 4     // 60

    let passed = (d == 60)

    TestResult {
        test_id: 1,
        passed: passed,
        score: if passed { 100 } else { 0 },
    }
}

fn run_loop_tests() -> TestResult with Mut {
    var sum: i64 = 0
    var i: i64 = 1

    while i <= 10 {
        sum = sum + i
        i = i + 1
    }

    let passed = (sum == 55)

    TestResult {
        test_id: 2,
        passed: passed,
        score: if passed { 100 } else { 0 },
    }
}

fn factorial_helper(n: i64) -> i64 {
    if n <= 1 {
        1
    } else {
        n * factorial_helper(n - 1)
    }
}

fn run_recursion_tests() -> TestResult {
    let result = factorial_helper(5)
    let passed = (result == 120)

    TestResult {
        test_id: 3,
        passed: passed,
        score: if passed { 100 } else { 0 },
    }
}

fn run_array_tests() -> TestResult with Mut, Panic, Div {
    let arr: [i64; 5] = [2, 4, 6, 8, 10]

    var sum: i64 = 0
    var i: i64 = 0

    while i < 5 {
        sum = sum + arr[i]
        i = i + 1
    }

    let passed = (sum == 30)

    TestResult {
        test_id: 4,
        passed: passed,
        score: if passed { 100 } else { 0 },
    }
}

fn evaluate_results(r1: TestResult, r2: TestResult, r3: TestResult, r4: TestResult) -> i64 {
    if !r1.passed { return 1 }
    if !r2.passed { return 2 }
    if !r3.passed { return 3 }
    if !r4.passed { return 4 }

    let total_score = r1.score + r2.score + r3.score + r4.score

    if total_score == 400 {
        0  // Perfect score
    } else {
        5  // Something went wrong
    }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    // Run all test suites
    let result1 = run_arithmetic_tests()
    let result2 = run_loop_tests()
    let result3 = run_recursion_tests()
    let result4 = run_array_tests()

    // Evaluate combined results
    evaluate_results(result1, result2, result3, result4)
}
