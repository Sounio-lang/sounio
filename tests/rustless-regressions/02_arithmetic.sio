// Rustless Regression Test 02: Arithmetic Operations
//
// Tests: add, sub, mul, div, mod, negation, comparisons

fn test_basic_arithmetic() -> i64 {
    let a = 10 + 5  // 15
    let b = 20 - 8  // 12
    let c = 6 * 7   // 42
    let d = 100 / 4 // 25
    let e = 17 % 5  // 2

    if a != 15 { return 1 }
    if b != 12 { return 2 }
    if c != 42 { return 3 }
    if d != 25 { return 4 }
    if e != 2  { return 5 }

    0
}

fn test_comparisons() -> i64 {
    if !(10 < 20)   { return 10 }
    if !(10 <= 10)  { return 11 }
    if !(20 > 10)   { return 12 }
    if !(20 >= 20)  { return 13 }
    if !(42 == 42)  { return 14 }
    if !(42 != 43)  { return 15 }

    0
}

fn test_negation() -> i64 {
    let x = 42
    let neg_x = -x

    if neg_x != -42 { return 20 }
    if -neg_x != 42 { return 21 }

    0
}

fn main() -> i64 with IO {
    let r1 = test_basic_arithmetic()
    if r1 != 0 { return r1 }

    let r2 = test_comparisons()
    if r2 != 0 { return r2 }

    let r3 = test_negation()
    if r3 != 0 { return r3 }

    0  // All tests passed
}
