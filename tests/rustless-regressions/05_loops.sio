// Rustless Regression Test 05: Loops
//
// Tests: while loops, iteration, accumulation

fn sum_to_n(n: i64) -> i64 with Mut {
    var sum: i64 = 0
    var i: i64 = 1

    while i <= n {
        sum = sum + i
        i = i + 1
    }

    sum
}

fn count_down(start: i64) -> i64 with Mut {
    var count: i64 = start
    var iterations: i64 = 0

    while count > 0 {
        count = count - 1
        iterations = iterations + 1
    }

    iterations
}

fn factorial(n: i64) -> i64 with Mut {
    var result: i64 = 1
    var i: i64 = 1

    while i <= n {
        result = result * i
        i = i + 1
    }

    result
}

fn main() -> i64 with IO, Mut {
    // Test sum_to_n
    let r1 = sum_to_n(10)  // 1+2+...+10 = 55
    if r1 != 55 { return 1 }

    // Test count_down
    let r2 = count_down(20)
    if r2 != 20 { return 2 }

    // Test factorial
    let r3 = factorial(5)  // 5! = 120
    if r3 != 120 { return 3 }

    let r4 = factorial(6)  // 6! = 720
    if r4 != 720 { return 4 }

    0  // All tests passed
}
