// Rustless Regression Test 01: Fibonacci (Recursion)
//
// Tests: recursion, arithmetic, function calls, base cases

fn fib(n: i64) -> i64 {
    if n <= 1 {
        n
    } else {
        fib(n - 1) + fib(n - 2)
    }
}

fn main() -> i64 with IO {
    // Return fib(7) = 13 (reduced from fib(10) to avoid stack overflow in interpreter)
    fib(7)
}
