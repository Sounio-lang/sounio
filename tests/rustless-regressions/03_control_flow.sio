// Rustless Regression Test 03: Control Flow
//
// Tests: if/else, nested conditions, boolean logic

fn test_simple_if(x: i64) -> i64 {
    if x > 10 {
        100
    } else {
        200
    }
}

fn test_nested_if(x: i64, y: i64) -> i64 {
    if x > 0 {
        if y > 0 {
            1
        } else {
            2
        }
    } else {
        if y > 0 {
            3
        } else {
            4
        }
    }
}

fn test_boolean_logic(a: bool, b: bool) -> i64 {
    if a && b {
        1
    } else if a || b {
        2
    } else {
        3
    }
}

fn main() -> i64 with IO {
    // Test simple if
    let r1 = test_simple_if(15)
    if r1 != 100 { return 1 }

    let r2 = test_simple_if(5)
    if r2 != 200 { return 2 }

    // Test nested if
    let r3 = test_nested_if(5, 5)
    if r3 != 1 { return 3 }

    let r4 = test_nested_if(5, -5)
    if r4 != 2 { return 4 }

    let r5 = test_nested_if(-5, 5)
    if r5 != 3 { return 5 }

    let r6 = test_nested_if(-5, -5)
    if r6 != 4 { return 6 }

    // Test boolean logic
    let r7 = test_boolean_logic(true, true)
    if r7 != 1 { return 7 }

    let r8 = test_boolean_logic(true, false)
    if r8 != 2 { return 8 }

    let r9 = test_boolean_logic(false, false)
    if r9 != 3 { return 9 }

    0  // All tests passed
}
