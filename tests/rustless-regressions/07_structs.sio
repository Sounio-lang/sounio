// Rustless Regression Test 07: Structs
//
// Tests: struct literals, field access, nested structs

struct Point {
    x: i64,
    y: i64,
}

struct Rectangle {
    top_left: Point,
    width: i64,
    height: i64,
}

fn point_distance_from_origin(p: Point) -> i64 {
    // Simplified Manhattan distance
    let abs_x = if p.x < 0 { -p.x } else { p.x }
    let abs_y = if p.y < 0 { -p.y } else { p.y }
    abs_x + abs_y
}

fn rectangle_area(r: Rectangle) -> i64 {
    r.width * r.height
}

fn main() -> i64 with IO {
    // Test simple struct
    let p1 = Point { x: 3, y: 4 }

    if p1.x != 3 { return 1 }
    if p1.y != 4 { return 2 }

    // Test function with struct parameter
    let dist = point_distance_from_origin(p1)
    if dist != 7 { return 3 }  // 3 + 4 = 7

    // Test nested struct
    let origin = Point { x: 0, y: 0 }
    let rect = Rectangle {
        top_left: origin,
        width: 10,
        height: 20,
    }

    if rect.top_left.x != 0 { return 4 }
    if rect.top_left.y != 0 { return 5 }
    if rect.width != 10 { return 6 }
    if rect.height != 20 { return 7 }

    // Test function with nested struct
    let area = rectangle_area(rect)
    if area != 200 { return 8 }  // 10 * 20 = 200

    0  // All tests passed
}
