//@ run-pass
use special::igamma::*
use parity::emit::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let ia = [0.5, 0.5, 1.0, 1.0, 2.0, 2.0, 5.0, 5.0, 2.0, 5.0]
    let ix = [0.5, 2.0, 1.0, 5.0, 1.0, 5.0, 2.0, 10.0, 10.0, 3.0]
    var i = 0
    while i < 10 {
        let a = ia[i]
        let x = ix[i]
        let lo = igamma_lower(a, x)
        let up = igamma_upper(a, x)
        emit2("igamma_lower", f64_to_bits(a), f64_to_bits(x), f64_to_bits(lo))
        emit2("igamma_upper", f64_to_bits(a), f64_to_bits(x), f64_to_bits(up))
        i = i + 1
    }
    let ck = [1.0, 1.0, 2.0, 2.0, 5.0, 5.0]
    let cx = [0.5, 2.0, 2.0, 5.0, 5.0, 10.0]
    var j = 0
    while j < 6 {
        let k = ck[j]
        let x = cx[j]
        let c = chi2_cdf(x, k)
        emit2("chi2_cdf", f64_to_bits(x), f64_to_bits(k), f64_to_bits(c))
        j = j + 1
    }
    return 0
}
