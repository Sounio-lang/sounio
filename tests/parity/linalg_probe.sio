//@ run-pass
// Phase-0 confirmation probe for linalg<->mpmath parity vertical.
// Findings recorded (see docs/research parity report):
//   1. matrix bridge + row-major + MatNM-by-value param
//   2. matnm_lu piv encoding convention
//   3. eigen_symmetric eigenvector layout (row-k vs column-k)
//
// Run under lean_single:
//   SOUNIO_SOUC_ENGINE=lean_single ./bin/souc compile tests/parity/linalg_probe.sio -o /tmp/linalg_probe.elf

use linalg::matnm::*
use linalg::eigen::{eigen_symmetric}

var WORK_MAT: [f64; 65536] = [0.0; 65536]
var EIGENVECTORS: [f64; 65536] = [0.0; 65536]
var EIGENVALUES: [f64; 256] = [0.0; 256]

fn emit3i(tag: string, i: i64, j: i64, bits: i64) with IO, Mut, Panic {
    print(tag); print(" "); print_int(i); print(" "); print_int(j); print(" "); print_int(bits); print("\n")
}

fn emit2i(tag: string, k: i64, val: i64) with IO, Mut, Panic {
    print(tag); print(" "); print_int(k); print(" "); print_int(val); print("\n")
}

// Finding 1b: does a helper taking MatNM BY VALUE compile+run under lean_single?
fn emit_from_matnm_byval(m: MatNM) with IO, Mut, Div, Panic {
    var i: i64 = 0
    while i < m.rows {
        var j: i64 = 0
        while j < m.cols {
            let v = matnm_get(m, i, j)
            emit3i("E2", i, j, f64_to_bits(v))
            j = j + 1
        }
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // ------------------------------------------------------------------
    // Finding 1: matrix bridge + row-major + MatNM-by-value
    // ------------------------------------------------------------------
    var m = matnm_zeros(2, 2)
    m = matnm_set(m, 0, 0, 1.5)
    m = matnm_set(m, 0, 1, 2.5)
    m = matnm_set(m, 1, 0, 3.5)
    m = matnm_set(m, 1, 1, 4.5)

    var i: i64 = 0
    while i < 2 {
        var j: i64 = 0
        while j < 2 {
            let v = matnm_get(m, i, j)
            emit3i("E", i, j, f64_to_bits(v))
            j = j + 1
        }
        i = i + 1
    }

    // Same emission via a BY-VALUE helper (tests Madaros big-struct-by-value under lean_single)
    emit_from_matnm_byval(m)

    // ------------------------------------------------------------------
    // Finding 2: matnm_lu piv encoding
    // A = [[0,1,1],[1,0,1],[1,1,0]] forces a pivot swap at step 0.
    // ------------------------------------------------------------------
    var a = matnm_zeros(3, 3)
    a = matnm_set(a, 0, 0, 0.0)
    a = matnm_set(a, 0, 1, 1.0)
    a = matnm_set(a, 0, 2, 1.0)
    a = matnm_set(a, 1, 0, 1.0)
    a = matnm_set(a, 1, 1, 0.0)
    a = matnm_set(a, 1, 2, 1.0)
    a = matnm_set(a, 2, 0, 1.0)
    a = matnm_set(a, 2, 1, 1.0)
    a = matnm_set(a, 2, 2, 0.0)

    // Also emit A itself for the Python-side reconstruction check.
    i = 0
    while i < 3 {
        var j: i64 = 0
        while j < 3 {
            emit3i("A", i, j, f64_to_bits(matnm_get(a, i, j)))
            j = j + 1
        }
        i = i + 1
    }

    let lu = matnm_lu(a)

    i = 0
    while i < 3 {
        var j: i64 = 0
        while j < 3 {
            emit3i("L", i, j, f64_to_bits(matnm_get(lu.l, i, j)))
            emit3i("U", i, j, f64_to_bits(matnm_get(lu.u, i, j)))
            j = j + 1
        }
        i = i + 1
    }

    var k: i64 = 0
    while k < 3 {
        emit2i("P", k, lu.piv[k])
        k = k + 1
    }
    emit2i("SIGN", 0, lu.sign)

    // ------------------------------------------------------------------
    // Finding 3: eigen_symmetric eigenvector layout
    // A = [[2,1],[1,2]] -> eigenvalues 1, 3.
    // ------------------------------------------------------------------
    WORK_MAT[0 * 2 + 0] = 2.0
    WORK_MAT[0 * 2 + 1] = 1.0
    WORK_MAT[1 * 2 + 0] = 1.0
    WORK_MAT[1 * 2 + 1] = 2.0

    let ok = eigen_symmetric(&!WORK_MAT, 2, &!EIGENVALUES, &!EIGENVECTORS)
    if !ok {
        print("EIGEN_FAILED\n")
        return 1
    }

    i = 0
    while i < 2 {
        emit2i("EVAL", i, f64_to_bits(EIGENVALUES[i]))
        i = i + 1
    }

    var r: i64 = 0
    while r < 2 {
        var c: i64 = 0
        while c < 2 {
            emit3i("EVEC", r, c, f64_to_bits(EIGENVECTORS[r * 2 + c]))
            c = c + 1
        }
        r = r + 1
    }

    return 0
}
