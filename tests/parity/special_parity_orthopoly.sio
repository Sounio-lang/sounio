//@ run-pass
use special::orthopoly::*
use parity::emit::*

fn main() -> i32 with IO, Mut, Div, Panic {
    // legendre_p(n, x), x in [-1, 1]
    let ns = [2.0, 3.0, 4.0]
    let xs_pn = [-0.8, -0.4, 0.0, 0.4, 0.8]
    var i = 0
    while i < 3 {
        let n = ns[i]
        var j = 0
        while j < 5 {
            let x = xs_pn[j]
            let v = legendre_p(n as i32, x)
            emit2("legendre_p", f64_to_bits(n), f64_to_bits(x), f64_to_bits(v))
            j = j + 1
        }
        i = i + 1
    }

    // chebyshev_t(n, x)
    var i2 = 0
    while i2 < 3 {
        let n = ns[i2]
        var j = 0
        while j < 5 {
            let x = xs_pn[j]
            let v = chebyshev_t(n as i32, x)
            emit2("chebyshev_t", f64_to_bits(n), f64_to_bits(x), f64_to_bits(v))
            j = j + 1
        }
        i2 = i2 + 1
    }

    // chebyshev_u(n, x)
    var i3 = 0
    while i3 < 3 {
        let n = ns[i3]
        var j = 0
        while j < 5 {
            let x = xs_pn[j]
            let v = chebyshev_u(n as i32, x)
            emit2("chebyshev_u", f64_to_bits(n), f64_to_bits(x), f64_to_bits(v))
            j = j + 1
        }
        i3 = i3 + 1
    }

    // hermite_h(n, x), hermite_he(n, x)
    let xs_h = [-1.5, -0.5, 0.5, 1.5]
    var i4 = 0
    while i4 < 3 {
        let n = ns[i4]
        var j = 0
        while j < 4 {
            let x = xs_h[j]
            let vh = hermite_h(n as i32, x)
            emit2("hermite_h", f64_to_bits(n), f64_to_bits(x), f64_to_bits(vh))
            let vhe = hermite_he(n as i32, x)
            emit2("hermite_he", f64_to_bits(n), f64_to_bits(x), f64_to_bits(vhe))
            j = j + 1
        }
        i4 = i4 + 1
    }

    // laguerre_l(n, x)
    let xs_l = [0.5, 1.0, 2.0, 5.0]
    var i5 = 0
    while i5 < 3 {
        let n = ns[i5]
        var j = 0
        while j < 4 {
            let x = xs_l[j]
            let v = laguerre_l(n as i32, x)
            emit2("laguerre_l", f64_to_bits(n), f64_to_bits(x), f64_to_bits(v))
            j = j + 1
        }
        i5 = i5 + 1
    }

    // laguerre_l_assoc(n, alpha, x)
    let alphas = [0.5, 1.5]
    let xs_la = [0.5, 2.0]
    var i6 = 0
    while i6 < 3 {
        let n = ns[i6]
        var a = 0
        while a < 2 {
            let alpha = alphas[a]
            var j = 0
            while j < 2 {
                let x = xs_la[j]
                let v = laguerre_l_assoc(n as i32, alpha, x)
                emit3("laguerre_l_assoc", f64_to_bits(n), f64_to_bits(alpha), f64_to_bits(x), f64_to_bits(v))
                j = j + 1
            }
            a = a + 1
        }
        i6 = i6 + 1
    }

    // jacobi_p(n, alpha, beta, x)
    let ab_alpha = [1.0, 0.5]
    let ab_beta = [1.0, 0.5]
    let xs_j = [-0.5, 0.0, 0.5]
    var i7 = 0
    while i7 < 3 {
        let n = ns[i7]
        var a = 0
        while a < 2 {
            let alpha = ab_alpha[a]
            let beta = ab_beta[a]
            var j = 0
            while j < 3 {
                let x = xs_j[j]
                let v = jacobi_p(n as i32, alpha, beta, x)
                emit4("jacobi_p", f64_to_bits(n), f64_to_bits(alpha), f64_to_bits(beta), f64_to_bits(x), f64_to_bits(v))
                j = j + 1
            }
            a = a + 1
        }
        i7 = i7 + 1
    }

    return 0
}
