//@ run-pass
use special::airy::*
use special::zeta::*
use special::elliptic::*
use parity::emit::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let xs = [-2.0, -1.0, 0.0, 1.0, 2.0, 3.0]
    var i = 0
    while i < 6 {
        let x = xs[i]
        let vai = airy_ai(x)
        let vbi = airy_bi(x)
        let vaip = airy_ai_prime(x)
        let vbip = airy_bi_prime(x)
        emit1("airy_ai", f64_to_bits(x), f64_to_bits(vai))
        emit1("airy_bi", f64_to_bits(x), f64_to_bits(vbi))
        emit1("airy_ai_prime", f64_to_bits(x), f64_to_bits(vaip))
        emit1("airy_bi_prime", f64_to_bits(x), f64_to_bits(vbip))
        i = i + 1
    }

    let zs = [2.0, 3.0, 4.0, 6.0, 8.0, 10.0]
    var j = 0
    while j < 6 {
        let s = zs[j]
        let vz = riemann_zeta(s)
        emit1("riemann_zeta", f64_to_bits(s), f64_to_bits(vz))
        j = j + 1
    }

    let es = [2.0, 3.0, 4.0]
    var k = 0
    while k < 3 {
        let s = es[k]
        let ve = dirichlet_eta(s)
        emit1("dirichlet_eta", f64_to_bits(s), f64_to_bits(ve))
        k = k + 1
    }

    let hs = [2.0, 2.0, 3.0, 4.0]
    let ha = [1.0, 3.0, 2.0, 1.5]
    var m = 0
    while m < 4 {
        let s = hs[m]
        let a = ha[m]
        let vh = hurwitz_zeta(s, a)
        emit2("hurwitz_zeta", f64_to_bits(s), f64_to_bits(a), f64_to_bits(vh))
        m = m + 1
    }

    let ks = [0.0, 0.25, 0.5, 0.75, 0.9]
    var n = 0
    while n < 5 {
        let kk = ks[n]
        let vek = elliptic_k(kk)
        let vee = elliptic_e(kk)
        emit1("elliptic_k", f64_to_bits(kk), f64_to_bits(vek))
        emit1("elliptic_e", f64_to_bits(kk), f64_to_bits(vee))
        n = n + 1
    }

    return 0
}
