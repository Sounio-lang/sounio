//@ run-pass
// Task 2 of linalg<->mpmath parity vertical: matnm tier-1 (scalar) + tier-2
// (well-defined matrix) ops. Emits A(+B) plus results for det/trace/norm_fro/
// transpose/mul/inv/solve across 3 cases, compared against mpmath by
// scripts/linalg_parity_gate.sh + scripts/parity/linalg_parity_ref.py.
//
// Run under lean_single:
//   SOUNIO_SOUC_ENGINE=lean_single ./bin/souc compile tests/parity/linalg_parity_matnm.sio -o /tmp/linalg_parity_matnm.elf

use linalg::matnm::*
use parity::emit_mat::*

// Build a 2x2 matrix from scalars, row-major.
fn m2(a: f64, b: f64, c: f64, d: f64) -> MatNM with Mut, Panic {
    var m = matnm_zeros(2, 2)
    m = matnm_set(m, 0, 0, a)
    m = matnm_set(m, 0, 1, b)
    m = matnm_set(m, 1, 0, c)
    m = matnm_set(m, 1, 1, d)
    return m
}

// Build a 3x3 matrix from scalars, row-major.
fn m3(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, ii: f64) -> MatNM with Mut, Panic {
    var m = matnm_zeros(3, 3)
    m = matnm_set(m, 0, 0, a); m = matnm_set(m, 0, 1, b); m = matnm_set(m, 0, 2, c)
    m = matnm_set(m, 1, 0, d); m = matnm_set(m, 1, 1, e); m = matnm_set(m, 1, 2, f)
    m = matnm_set(m, 2, 0, g); m = matnm_set(m, 2, 1, h); m = matnm_set(m, 2, 2, ii)
    return m
}

// Build a 2x1 column vector.
fn v2(a: f64, b: f64) -> MatNM with Mut, Panic {
    var m = matnm_zeros(2, 1)
    m = matnm_set(m, 0, 0, a)
    m = matnm_set(m, 1, 0, b)
    return m
}

// Build a 3x1 column vector.
fn v3(a: f64, b: f64, c: f64) -> MatNM with Mut, Panic {
    var m = matnm_zeros(3, 1)
    m = matnm_set(m, 0, 0, a)
    m = matnm_set(m, 1, 0, b)
    m = matnm_set(m, 2, 0, c)
    return m
}

fn run_case(cs: i64, a: MatNM, b: MatNM, rhs: MatNM) with IO, Mut, Div, Panic {
    emit_mat("det", cs, "A", a)
    emit_scalar("det", cs, matnm_det(a))

    emit_mat("trace", cs, "A", a)
    emit_scalar("trace", cs, matnm_trace(a))

    emit_mat("norm_fro", cs, "A", a)
    emit_scalar("norm_fro", cs, matnm_norm_fro(a))

    emit_mat("transpose", cs, "A", a)
    emit_mat("transpose", cs, "R", matnm_transpose(a))

    emit_mat("mul", cs, "A", a)
    emit_mat("mul", cs, "B", b)
    emit_mat("mul", cs, "R", matnm_mul(a, b))

    emit_mat("inv", cs, "A", a)
    emit_mat("inv", cs, "R", matnm_inv(a))

    emit_mat("solve", cs, "A", a)
    emit_mat("solve", cs, "B", rhs)
    emit_mat("solve", cs, "R", matnm_solve(a, rhs))

    let lu0 = matnm_lu(a)
    emit_mat("lu", cs, "A", a)
    emit_mat("lu", cs, "L", lu0.l)
    emit_mat("lu", cs, "U", lu0.u)
    var pk = 0
    while pk < a.rows {
        print("lu "); print_int(cs); print(" P "); print_int(pk); print(" 0 "); print_int(lu0.piv[pk]); print("\n")
        pk = pk + 1
    }

    let qr0 = matnm_qr(a)
    emit_mat("qr", cs, "A", a)
    emit_mat("qr", cs, "Q", qr0.q)
    emit_mat("qr", cs, "RR", qr0.r)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // Case 0: 2x2, A = [[4,3],[6,3]] (det = -6, invertible); B = [[1,2],[3,4]];
    // solve RHS b = [[5],[6]].
    let a0 = m2(4.0, 3.0, 6.0, 3.0)
    let b0 = m2(1.0, 2.0, 3.0, 4.0)
    let rhs0 = v2(5.0, 6.0)
    run_case(0, a0, b0, rhs0)

    // Case 1: 3x3 general invertible, A = [[1,2,3],[0,1,4],[5,6,0]] (det = 1);
    // B = [[2,0,1],[1,1,0],[0,1,2]]; b = [[1],[2],[3]].
    let a1 = m3(1.0, 2.0, 3.0, 0.0, 1.0, 4.0, 5.0, 6.0, 0.0)
    let b1 = m3(2.0, 0.0, 1.0, 1.0, 1.0, 0.0, 0.0, 1.0, 2.0)
    let rhs1 = v3(1.0, 2.0, 3.0)
    run_case(1, a1, b1, rhs1)

    // Case 2: 3x3 SPD, A = [[4,1,1],[1,3,0],[1,0,2]]; B = A (mul A.A);
    // b = [[1],[1],[1]].
    let a2 = m3(4.0, 1.0, 1.0, 1.0, 3.0, 0.0, 1.0, 0.0, 2.0)
    let b2 = a2
    let rhs2 = v3(1.0, 1.0, 1.0)
    run_case(2, a2, b2, rhs2)

    return 0
}
