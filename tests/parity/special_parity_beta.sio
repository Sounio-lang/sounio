//@ run-pass
use special::beta::*
use parity::emit::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let avals = [0.5, 1.0, 2.0, 2.5, 5.0]
    let bvals = [0.5, 1.0, 3.0, 1.5, 2.0]
    var i = 0
    while i < 5 {
        let a = avals[i]
        let b = bvals[i]
        let bv = beta(a, b)
        let lb = lbeta(a, b)
        emit2("beta", f64_to_bits(a), f64_to_bits(b), f64_to_bits(bv))
        emit2("lbeta", f64_to_bits(a), f64_to_bits(b), f64_to_bits(lb))
        i = i + 1
    }
    let xs = [0.1, 0.25, 0.5, 0.75, 0.9]
    var k = 0
    while k < 5 {
        let x = xs[k]
        let iv = ibeta(2.0, 3.0, x)
        emit3("ibeta", f64_to_bits(2.0), f64_to_bits(3.0), f64_to_bits(x), f64_to_bits(iv))
        k = k + 1
    }
    let ps = [0.1, 0.5, 0.9]
    var j = 0
    while j < 3 {
        let p = ps[j]
        let vv = ibeta_inv(2.0, 3.0, p)
        emit3("ibeta_inv", f64_to_bits(2.0), f64_to_bits(3.0), f64_to_bits(p), f64_to_bits(vv))
        j = j + 1
    }
    return 0
}
