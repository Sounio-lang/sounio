//@ run-pass
// Task 4 of linalg<->mpmath parity vertical: symmetric eigendecomposition.
// Emits A, EVAL (eigenvalues), EVEC (eigenvectors, native column-k = eigenvector k
// per Phase-0) across 2 well-separated-spectrum cases, compared against mpmath
// (mp.eigsy) by scripts/linalg_parity_gate.sh + scripts/parity/linalg_parity_ref.py.
//
// Run under lean_single:
//   SOUNIO_SOUC_ENGINE=lean_single ./bin/souc compile tests/parity/linalg_parity_eigen.sio -o /tmp/linalg_parity_eigen.elf

use linalg::eigen::{eigen_symmetric}

var WORK_MAT: [f64; 65536] = [0.0; 65536]
var EIGENVECTORS: [f64; 65536] = [0.0; 65536]
var EIGENVALUES: [f64; 256] = [0.0; 256]

fn emit_a(op: string, cs: i64, n: i32) with IO, Mut, Div, Panic {
    var i = 0
    while i < n {
        var j = 0
        while j < n {
            let v = WORK_MAT[i * n + j]
            let vb = f64_to_bits(v)
            print(op); print(" "); print_int(cs); print(" A ")
            print_int(i); print(" "); print_int(j); print(" "); print_int(vb); print("\n")
            j = j + 1
        }
        i = i + 1
    }
}

fn emit_eval(op: string, cs: i64, n: i32) with IO, Mut, Div, Panic {
    var i = 0
    while i < n {
        let v = EIGENVALUES[i]
        let vb = f64_to_bits(v)
        print(op); print(" "); print_int(cs); print(" EVAL ")
        print_int(i); print(" 0 "); print_int(vb); print("\n")
        i = i + 1
    }
}

fn emit_evec(op: string, cs: i64, n: i32) with IO, Mut, Div, Panic {
    var r = 0
    while r < n {
        var c = 0
        while c < n {
            // Phase-0 CONFIRMED: native EVECS[r*n+c] read as (r,c) already gives
            // column c = eigenvector for eigenvalue c (A = V.Lambda.V^T). Do NOT
            // transpose here.
            let v = EIGENVECTORS[r * n + c]
            let vb = f64_to_bits(v)
            print(op); print(" "); print_int(cs); print(" EVEC ")
            print_int(r); print(" "); print_int(c); print(" "); print_int(vb); print("\n")
            c = c + 1
        }
        r = r + 1
    }
}

fn run_case(cs: i64, n: i32) with IO, Mut, Div, Panic {
    // A is stable across eigen_symmetric_raw (it only reads mat, copying it into
    // the vecs workspace before iterating) — verified against
    // stdlib/linalg/eigen.sio's eg_copy_matrix. Emit A before calling anyway, so
    // this test never depends on that non-mutation property.
    emit_a("eig", cs, n)
    if !eigen_symmetric(&!WORK_MAT, n, &!EIGENVALUES, &!EIGENVECTORS) {
        print("eig "); print_int(cs); print(" FAIL_CONVERGE\n")
        return
    }
    emit_eval("eig", cs, n)
    emit_evec("eig", cs, n)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // Case 0: 2x2 symmetric, A = [[2,1],[1,2]], eigenvalues 1, 3 (well separated).
    WORK_MAT[0 * 2 + 0] = 2.0
    WORK_MAT[0 * 2 + 1] = 1.0
    WORK_MAT[1 * 2 + 0] = 1.0
    WORK_MAT[1 * 2 + 1] = 2.0
    run_case(0, 2)

    // Case 1: 3x3 SPD, A = [[4,1,1],[1,3,0],[1,0,2]], distinct eigenvalues.
    WORK_MAT[0 * 3 + 0] = 4.0
    WORK_MAT[0 * 3 + 1] = 1.0
    WORK_MAT[0 * 3 + 2] = 1.0
    WORK_MAT[1 * 3 + 0] = 1.0
    WORK_MAT[1 * 3 + 1] = 3.0
    WORK_MAT[1 * 3 + 2] = 0.0
    WORK_MAT[2 * 3 + 0] = 1.0
    WORK_MAT[2 * 3 + 1] = 0.0
    WORK_MAT[2 * 3 + 2] = 2.0
    run_case(1, 3)

    return 0
}
