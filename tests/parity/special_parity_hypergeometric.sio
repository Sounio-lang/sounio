//@ run-pass
use special::hypergeometric::*
use parity::emit::*

fn main() -> i32 with IO, Mut, Div, Panic {
    // hyperg_0f1(b, z)
    let b0 = [1.0, 2.0, 0.5, 2.5]
    let z0 = [0.5, 1.0, 2.0, 0.25]
    var i = 0
    while i < 4 {
        let b = b0[i]
        let z = z0[i]
        let v = hyperg_0f1(b, z)
        emit2("hyperg_0f1", f64_to_bits(b), f64_to_bits(z), f64_to_bits(v))
        i = i + 1
    }

    // hyperg_1f1(a, b, z)
    let a1 = [1.0, 0.5, 2.0, 1.0]
    let b1 = [2.0, 1.5, 3.0, 1.0]
    let z1 = [0.5, 1.0, 2.0, 0.25]
    var j = 0
    while j < 4 {
        let a = a1[j]
        let b = b1[j]
        let z = z1[j]
        let v = hyperg_1f1(a, b, z)
        emit3("hyperg_1f1", f64_to_bits(a), f64_to_bits(b), f64_to_bits(z), f64_to_bits(v))
        j = j + 1
    }

    // hyperg_u(a, b, z)
    let a2 = [1.0, 0.5, 2.0]
    let b2 = [2.0, 1.5, 2.0]
    let z2 = [0.5, 1.0, 2.0]
    var k = 0
    while k < 3 {
        let a = a2[k]
        let b = b2[k]
        let z = z2[k]
        let v = hyperg_u(a, b, z)
        emit3("hyperg_u", f64_to_bits(a), f64_to_bits(b), f64_to_bits(z), f64_to_bits(v))
        k = k + 1
    }

    // hyperg_2f1(a, b, c, z)
    let a3 = [1.0, 0.5, 2.0, 1.0]
    let b3 = [1.0, 0.5, 1.0, 2.0]
    let c3 = [2.0, 1.0, 3.0, 4.0]
    let z3 = [0.3, 0.5, -0.5, 0.2]
    var m = 0
    while m < 4 {
        let a = a3[m]
        let b = b3[m]
        let c = c3[m]
        let z = z3[m]
        let v = hyperg_2f1(a, b, c, z)
        emit4("hyperg_2f1", f64_to_bits(a), f64_to_bits(b), f64_to_bits(c), f64_to_bits(z), f64_to_bits(v))
        m = m + 1
    }

    return 0
}
