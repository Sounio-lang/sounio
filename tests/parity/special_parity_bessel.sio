//@ run-pass
use special::bessel::*
use parity::emit::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let xs = [0.5, 1.0, 2.0, 5.0, 10.0]
    var i = 0
    while i < 5 {
        let x = xs[i]
        let vj0 = bessel_j0(x)
        let vj1 = bessel_j1(x)
        let vy0 = bessel_y0(x)
        let vy1 = bessel_y1(x)
        let vi0 = bessel_i0(x)
        let vi1 = bessel_i1(x)
        let vk0 = bessel_k0(x)
        let vk1 = bessel_k1(x)
        emit1("bessel_j0", f64_to_bits(x), f64_to_bits(vj0))
        emit1("bessel_j1", f64_to_bits(x), f64_to_bits(vj1))
        emit1("bessel_y0", f64_to_bits(x), f64_to_bits(vy0))
        emit1("bessel_y1", f64_to_bits(x), f64_to_bits(vy1))
        emit1("bessel_i0", f64_to_bits(x), f64_to_bits(vi0))
        emit1("bessel_i1", f64_to_bits(x), f64_to_bits(vi1))
        emit1("bessel_k0", f64_to_bits(x), f64_to_bits(vk0))
        emit1("bessel_k1", f64_to_bits(x), f64_to_bits(vk1))
        i = i + 1
    }
    let nx = [1.0, 5.0]
    var m = 0
    while m < 2 {
        let x = nx[m]
        let vjn2 = bessel_jn(2, x)
        let vjn3 = bessel_jn(3, x)
        let vyn2 = bessel_yn(2, x)
        let vin2 = bessel_in(2, x)
        let vkn2 = bessel_kn(2, x)
        emit2("bessel_jn", f64_to_bits(2.0), f64_to_bits(x), f64_to_bits(vjn2))
        emit2("bessel_jn", f64_to_bits(3.0), f64_to_bits(x), f64_to_bits(vjn3))
        emit2("bessel_yn", f64_to_bits(2.0), f64_to_bits(x), f64_to_bits(vyn2))
        emit2("bessel_in", f64_to_bits(2.0), f64_to_bits(x), f64_to_bits(vin2))
        emit2("bessel_kn", f64_to_bits(2.0), f64_to_bits(x), f64_to_bits(vkn2))
        m = m + 1
    }
    return 0
}
