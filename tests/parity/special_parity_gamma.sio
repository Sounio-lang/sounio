//@ run-pass
use special::gamma::*
use parity::emit::*

fn main() -> i32 with IO, Mut, Div, Panic {
    // gamma (small args, O(1)..120) and digamma at the same points
    let gs = [0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0, 6.0]
    var i = 0
    while i < 9 {
        let x = gs[i]
        let g = gamma(x)
        let dg = digamma(x)
        emit1("gamma", f64_to_bits(x), f64_to_bits(g))
        emit1("digamma", f64_to_bits(x), f64_to_bits(dg))
        i = i + 1
    }
    // lgamma at large args (log gamma is O(hundreds))
    let ls = [10.0, 20.0, 50.0, 100.0, 170.0]
    var k = 0
    while k < 5 {
        let x = ls[k]
        let lg = lgamma(x)
        emit1("lgamma", f64_to_bits(x), f64_to_bits(lg))
        k = k + 1
    }
    // digamma at a couple larger args too
    let ds = [7.0, 12.0]
    var j = 0
    while j < 2 {
        let x = ds[j]
        let dg = digamma(x)
        emit1("digamma", f64_to_bits(x), f64_to_bits(dg))
        j = j + 1
    }
    return 0
}
