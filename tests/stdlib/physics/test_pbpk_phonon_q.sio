// Explicit API/effect/owner migration; preserved numeric inputs, bounds and assertions.
//@ run-pass
// tests/stdlib/physics/test_pbpk_phonon_q.sio
//
// Integration test for stdlib/physics/pbpk_phonon_q.sio
//
// Validates:
//   1. phonon_liver_cycle_q returns a Quantity in dim_concentration
//   2. The cycle-averaged outflow is positive for non-zero boundary
//   3. phonon_correction_q returns a non-trivial Quantity (non-zero diff
//      between phonon and well-stirred estimates)
//   4. phonon_init_uniform_q sets all 64 sites to the requested value
//   5. pbpk_phonon_q produces equivalent results to pbpk_phonon (legacy)
//      when the same physical scenario is run, after unit conversion

use physics::phonon::*
use physics::pbpk_phonon::*
use physics::phonon_quantity::*
use physics::pbpk_phonon_q::*
use units::lib::*
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use physics::phonon_factor::{phonon_workspace}
use math::pure::{sqrt}
fn qzeros(n:i64)->NumericBuffer with Alloc,Mut,Div,Panic {
 var b=numeric_buffer_new(n,n*8);var i:i64=0
 while i<n {assert(numeric_buffer_set(&!b,i,0.0)==0);i=i+1};b
}
fn uniform(c:f64,variance:f64,p:&PhononQuantityParams)->PhononQuantityState with Alloc,Mut,Div,Panic {
 assert(variance>=0.0)
 let q=q_concentration_mass(c,sqrt(variance));let initial:[Quantity;64]=[q;64]
 let s=phonon_quantity_from_independent_quantities(&initial,64,p,0.0,65536)
 assert(phonon_quantity_state_status(&s)==0);s
}
fn site_value(s:&PhononQuantityState,i:i64)->f64 with Panic {
 let x=phonon_quantity_concentration(s,i);assert(x.status==0);x.value
}
fn site_variance(s:&PhononQuantityState,i:i64)->f64 with Mut,Div,Panic {
 let x=phonon_quantity_covariance(s,i,i);assert(x.status==0);x.value
}
fn mean_value(s:&PhononQuantityState)->f64 with Mut,Div,Panic {
 let x=phonon_quantity_spatial_average(s);assert(x.status==0);let q=x.quantity;q.value
}
fn simulate(s:&!PhononQuantityState,t_end:f64)->i64 with Alloc,Mut,Div,Panic {
 let shape=phonon_workspace(phonon_quantity_state_n(s),phonon_quantity_state_rank(s))
 var work=qzeros(shape.scratch_len)
 let bound=phonon_quantity_cfl_dt(s);assert(bound.status==0)
 let r=phonon_quantity_simulate_checked(s,&!work,t_end,bound.value,1000000)
 numeric_buffer_close(work);assert(r.status==0);r.steps
}
fn cycle(s:&!PhononQuantityState)->Quantity with Alloc,Mut,Div,Panic {
 let shape=phonon_workspace(phonon_quantity_state_n(s),phonon_quantity_state_rank(s))
 var work=qzeros(shape.scratch_len)
 var average=qzeros(2*(phonon_quantity_state_rank(s)+1))
 let r=phonon_liver_cycle_q_checked(s,&!work,&!average,1e-4,1000000)
 numeric_buffer_close(work);numeric_buffer_close(average);assert(r.status==0);r.quantity
}
fn correction(s:&!PhononQuantityState)->Quantity with Alloc,Mut,Div,Panic {
 let shape=phonon_workspace(phonon_quantity_state_n(s),phonon_quantity_state_rank(s))
 var work=qzeros(shape.scratch_len)
 var average=qzeros(2*(phonon_quantity_state_rank(s)+1))
 let r=phonon_correction_q_checked(s,&!work,&!average,1e-4,1000000)
 numeric_buffer_close(work);numeric_buffer_close(average);assert(r.status==0);r.quantity
}
fn legacy_cycle_si(s:&!PhononState)->f64 with Alloc,Mut,Div,Panic {
 let shape=phonon_workspace(phonon_state_n(s),phonon_state_rank(s))
 var work=qzeros(shape.scratch_len);var average=qzeros(2*(phonon_state_rank(s)+1))
 let r=phonon_liver_cycle_checked(s,&!work,&!average,1e-4,1000000)
 numeric_buffer_close(work);numeric_buffer_close(average);assert(r.status==0);r.mean
}


fn assert_close(got: f64, expected: f64, tol: f64) with Panic {
    let d = got - expected
    let ad = if d < 0.0 { 0.0 - d } else { d }
    if ad > tol {
        panic()
    }
}

fn test_liver_cycle_dim() with Alloc, Mut, Div, Panic {
    let base = rapamycin_phonon_params_q()

    // PBPK inputs in kg/m³ (10 ng/mL portal, 8 ng/mL arterial, 2 ng/mL tissue)
    let c_portal   = q_concentration_mass(1.0e-5, 0.0)
    let c_arterial = q_concentration_mass(8.0e-6, 0.0)
    let c_tissue   = q_concentration_mass(2.0e-6, 0.0)

    var bound = base
    bound.c_portal=c_portal;bound.c_ha=c_arterial;bound.c_tissue=c_tissue
    var s=uniform(0.0,0.0,&bound)
    let out = cycle(&!s)
    assert(dim_eq(out.dim, dim_concentration()))
    assert(out.value > 0.0)
    assert(out.uncertainty >= 0.0)
    phonon_quantity_close(s)
}

fn test_liver_cycle_drives_lattice() with Alloc, Mut, Div, Panic {
    let base = rapamycin_phonon_params_q()

    // After a full cardiac cycle of flow with non-zero boundary,
    // the outlet site (site_value(&s,63)) should be > 0.
    let c_portal   = q_concentration_mass(1.0e-5, 0.0)
    let c_arterial = q_concentration_mass(8.0e-6, 0.0)
    let c_tissue   = q_concentration_mass(2.0e-6, 0.0)

    var bound = base
    bound.c_portal=c_portal;bound.c_ha=c_arterial;bound.c_tissue=c_tissue
    var s=uniform(0.0,0.0,&bound)
    let _out = cycle(&!s)
    assert(site_value(&s,63) > 0.0)
    // And the inlet (site_value(&s,0)) should be near the boundary value
    // (1e-5 kg/m³) since the boundary is the dominant source.
    assert(site_value(&s,0) > 0.5e-5)
    phonon_quantity_close(s)
}

fn test_correction_non_trivial() with Alloc, Mut, Div, Panic {
    let base = rapamycin_phonon_params_q()

    let c_liver = q_concentration_mass(2.0e-6, 0.0)
    let kp      = q_dimensionless(5.0, 0.0)
    let c_portal   = q_concentration_mass(1.0e-5, 0.0)
    let c_arterial = q_concentration_mass(8.0e-6, 0.0)

    var bound=base
    bound.c_portal=c_portal;bound.c_ha=c_arterial;bound.c_tissue=c_liver;bound.kp=kp
    var s=uniform(0.0,0.0,&bound)
    let corr = correction(&!s)
    assert(dim_eq(corr.dim, dim_concentration()))
    // The correction is the difference between two well-defined scales
    // (c_venous_phonon - c_venous_wellstirred) so it should be non-zero
    // and have a meaningful magnitude (< 1e-5 kg/m³).
    let d = if corr.value < 0.0 { 0.0 - corr.value } else { corr.value }
    assert(d > 0.0)
    assert(d < 1.0e-5)
    phonon_quantity_close(s)
}

fn test_init_uniform_q() with Alloc, Mut, Div, Panic {
    let p=rapamycin_phonon_params_q()
    let s=uniform(1.5e-5,1.0e-12,&p)
    assert_close(site_value(&s,0),    1.5e-5,  1.0e-15)
    assert_close(site_value(&s,32),   1.5e-5,  1.0e-15)
    assert_close(site_value(&s,63),   1.5e-5,  1.0e-15)
    assert_close(site_variance(&s,0), 1.0e-12, 1.0e-18)
    assert(phonon_quantity_state_n(&s) == 64)
    phonon_quantity_close(s)
}

// --- Parity: pbpk_phonon (legacy) vs pbpk_phonon_q (new) ---

fn test_pbpk_parity() with Alloc, Mut, Div, Panic {
    // Same physical scenario, expressed in ng/mL (legacy) and kg/m³ (new).
    // The legacy pbpk returns raw f64 in ng/mL, the new returns Quantity
    // in kg/m³. After multiplying the legacy by 1e-6, they should match.

    // Build legacy params
    var legacy_params: [f64; 64] = [0.0; 64]
    legacy_params[0]     = 1.0e-9
    legacy_params[1]        = 3.9e-6
    legacy_params[2] = 0.1
    legacy_params[3]   = 0.003
    legacy_params[4]        = 0.075
    legacy_params[5]        = 5.0
    legacy_params[6]  = 10.0   // ng/mL
    legacy_params[7]      = 8.0    // ng/mL
    legacy_params[8]   = 1.2
    legacy_params[9]  = 0.05
    legacy_params[10]      = 0.30
    legacy_params[11]    = 0.785
    legacy_params[12]  = 2.0    // ng/mL
    legacy_params[13]   = 3.0e-4
    legacy_params[14]  = 1.0

    // Explicit ng/mL joint-factor import; the same canonical cycle solver.
    var legacy_s=phonon_from_legacy_factor(qzeros(64),qzeros(0),&legacy_params,0,0.0)
    assert(phonon_state_status(&legacy_s)==0)
    let legacy_out_ng_ml=legacy_cycle_si(&!legacy_s)*1.0e6

    // New: same scenario in SI
    let base = rapamycin_phonon_params_q()
    let c_portal   = q_concentration_mass(1.0e-5, 0.0)
    let c_arterial = q_concentration_mass(8.0e-6, 0.0)
    let c_tissue   = q_concentration_mass(2.0e-6, 0.0)
    var bound=base
    bound.c_portal=c_portal;bound.c_ha=c_arterial;bound.c_tissue=c_tissue
    var new_s=uniform(0.0,0.0,&bound)
    let new_out = cycle(&!new_s)

    // Compare: legacy_out_ng_ml × 1e-6 should match new_out.value
    let legacy_kg_m3 = legacy_out_ng_ml * 1.0e-6
    let d = new_out.value - legacy_kg_m3
    let ad = if d < 0.0 { 0.0 - d } else { d }
    assert(ad < 1.0e-9)
    phonon_close(legacy_s);phonon_quantity_close(new_s)
}

fn main() -> i64 with Alloc, IO, Mut, Div, Panic {
    test_liver_cycle_dim()
    test_liver_cycle_drives_lattice()
    test_correction_non_trivial()
    test_init_uniform_q()
    test_pbpk_parity()
    0
}
