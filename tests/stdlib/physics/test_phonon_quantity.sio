// Explicit API/effect/owner migration; preserved numeric inputs, bounds and assertions.
//@ run-pass
// tests/stdlib/physics/test_phonon_quantity.sio
// Integration test for stdlib/physics/phonon_quantity.sio
//
// Validates:
//   1. PhononParams field dimensions match the units/Quantity constructors
//   2. rapamycin defaults are in SI (ng/mL → kg/m³ factor 1e-6)
//   3. pulsatile_input_q returns a Quantity with the right dim
//   4. CFL timestep is bounded by 1e-4 s
//   5. lattice64_init produces a uniform state with the right shape
//   6. spatial_average of [1, 2, 3] is 2.0
//   7. simulate preserves a uniform steady state with zero flow + zero clearance

use physics::phonon_quantity::*
use units::lib::*
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use physics::phonon_factor::{phonon_workspace}
use math::pure::{sqrt}
fn qzeros(n:i64)->NumericBuffer with Alloc,Mut,Div,Panic {
 var b=numeric_buffer_new(n,n*8);var i:i64=0
 while i<n {assert(numeric_buffer_set(&!b,i,0.0)==0);i=i+1};b
}
fn uniform(c:f64,variance:f64,p:&PhononQuantityParams)->PhononQuantityState with Alloc,Mut,Div,Panic {
 assert(variance>=0.0)
 let q=q_concentration_mass(c,sqrt(variance));let initial:[Quantity;64]=[q;64]
 let s=phonon_quantity_from_independent_quantities(&initial,64,p,0.0,65536)
 assert(phonon_quantity_state_status(&s)==0);s
}
fn site_value(s:&PhononQuantityState,i:i64)->f64 with Panic {
 let x=phonon_quantity_concentration(s,i);assert(x.status==0);x.value
}
fn site_variance(s:&PhononQuantityState,i:i64)->f64 with Mut,Div,Panic {
 let x=phonon_quantity_covariance(s,i,i);assert(x.status==0);x.value
}
fn mean_value(s:&PhononQuantityState)->f64 with Mut,Div,Panic {
 let x=phonon_quantity_spatial_average(s);assert(x.status==0);let q=x.quantity;q.value
}
fn simulate(s:&!PhononQuantityState,t_end:f64)->i64 with Alloc,Mut,Div,Panic {
 let shape=phonon_workspace(phonon_quantity_state_n(s),phonon_quantity_state_rank(s))
 var work=qzeros(shape.scratch_len)
 let bound=phonon_quantity_cfl_dt(s);assert(bound.status==0)
 let r=phonon_quantity_simulate_checked(s,&!work,t_end,bound.value,1000000)
 numeric_buffer_close(work);assert(r.status==0);r.steps
}


fn assert_close(got: f64, expected: f64, tol: f64) with Panic {
    let d = got - expected
    let ad = if d < 0.0 { 0.0 - d } else { d }
    if ad > tol {
        panic()
    }
}

fn test_params_dimensions() with Panic {
    let p = rapamycin_phonon_params_q()
    assert(dim_eq(p.d_eff.dim,     dim_diffusion()))
    assert(dim_eq(p.dx.dim,        dim_length()))
    assert(dim_eq(p.k_release.dim, dim_rate()))
    assert(dim_eq(p.cl_site.dim,   dim_rate()))
    assert(dim_eq(p.fu.dim,        dim_dimensionless()))
    assert(dim_eq(p.kp.dim,        dim_dimensionless()))
    assert(dim_eq(p.c_portal.dim,  dim_concentration()))
    assert(dim_eq(p.c_ha.dim,      dim_concentration()))
    assert(dim_eq(p.f_heart.dim,   dim_rate()))
    assert(dim_eq(p.a_portal.dim,  dim_dimensionless()))
    assert(dim_eq(p.a_ha.dim,      dim_dimensionless()))
    assert(dim_eq(p.phi_ha.dim,    dim_dimensionless()))
    assert(dim_eq(p.c_tissue.dim,  dim_concentration()))
    assert(dim_eq(p.v_blood.dim,   dim_velocity()))
    assert(dim_eq(p.zonation.dim,  dim_dimensionless()))
}

fn test_params_si_scale() with Panic {
    let p = rapamycin_phonon_params_q()
    // 10 ng/mL = 1e-5 kg/m³
    assert_close(p.c_portal.value, 1.0e-5, 1.0e-12)
    // 8 ng/mL = 8e-6 kg/m³
    assert_close(p.c_ha.value, 8.0e-6, 1.0e-12)
    // 2 ng/mL = 2e-6 kg/m³
    assert_close(p.c_tissue.value, 2.0e-6, 1.0e-12)
    // 3.9 μm = 3.9e-6 m
    assert_close(p.dx.value, 3.9e-6, 1.0e-12)
    // 300 μm/s = 3.0e-4 m/s
    assert_close(p.v_blood.value, 3.0e-4, 1.0e-12)
}

fn test_pulsatile_boundary_dim() with Mut, Div, Panic {
    let p = rapamycin_phonon_params_q()
    let b = pulsatile_input_q(0.0, &p)
    assert(dim_eq(b.dim, dim_concentration()))
    // The boundary is a weighted sum of two concentrations, so its
    // absolute uncertainty is the sqrt-sum of weighted uncertainties.
    // We just check it is positive and bounded.
    assert(b.value > 0.0)
    assert(b.uncertainty >= 0.0)
}

fn test_cfl_dt_bounded() with Alloc, Mut, Div, Panic {
    let p = rapamycin_phonon_params_q()
    let s = uniform(0.0, 0.0, &p)
    let bound = phonon_quantity_cfl_dt(&s)
    assert(bound.status == 0)
    let dt = bound.value
    assert(dt > 0.0)
    assert(dt <= 1.0e-4)
    phonon_quantity_close(s)
}

fn test_lattice_init_uniform() with Alloc, Mut, Div, Panic {
    let p = rapamycin_phonon_params_q()
    let s = uniform(1.5e-5, 1.0e-12, &p)
    assert_close(site_value(&s,0),    1.5e-5,  1.0e-15)
    assert_close(site_value(&s,32),   1.5e-5,  1.0e-15)
    assert_close(site_value(&s,63),   1.5e-5,  1.0e-15)
    assert_close(site_variance(&s,0), 1.0e-12, 1.0e-18)
    assert(phonon_quantity_state_n(&s) == 64)
    phonon_quantity_close(s)
}

fn test_spatial_average() with Alloc, Mut, Div, Panic {
    let z = q_concentration_mass(0.0, 0.0)
    var initial: [Quantity;64] = [z;64]
    initial[0] = q_concentration_mass(1.0, 0.0)
    initial[1] = q_concentration_mass(2.0, 0.0)
    initial[2] = q_concentration_mass(3.0, 0.0)
    let p = rapamycin_phonon_params_q()
    let s = phonon_quantity_from_independent_quantities(&initial,3,&p,0.0,65536)
    assert(phonon_quantity_state_status(&s)==0)
    assert_close(mean_value(&s), 2.0, 1.0e-12)
    phonon_quantity_close(s)
}

fn test_simulate_uniform_steady() with Alloc, Mut, Div, Panic {
    let base = rapamycin_phonon_params_q()
    // Build a parameters set with:
    //   - zero advection, zero metabolism, zero release
    //   - boundary concentration equal to the interior (no flux at inlet)
    //   - zero pulsatility amplitudes (constant in time boundary)
    var p = PhononQuantityParams {
        d_eff:     base.d_eff,
        dx:        base.dx,
        k_release: quantity_new(0.0, 0.0, base.k_release.dim),
        cl_site:   quantity_new(0.0, 0.0, base.cl_site.dim),
        fu:        base.fu,
        kp:        quantity_new(1.0, 0.0, base.kp.dim),
        c_portal:  base.c_portal,
        c_ha:      base.c_portal,                  // match boundary
        f_heart:   base.f_heart,
        a_portal:  quantity_new(0.0, 0.0, base.a_portal.dim),
        a_ha:      quantity_new(0.0, 0.0, base.a_ha.dim),
        phi_ha:    base.phi_ha,
        c_tissue:  base.c_portal,
        v_blood:   quantity_new(0.0, 0.0, base.v_blood.dim),
        zonation:  base.zonation,
    }
    var s = uniform(1.0e-5, 0.0, &p)

    let steps = simulate(&!s, 0.01)
    assert(steps > 0)
    // Without advection, metabolism, release, or pulsatile boundary,
    // the lattice should stay at the initial uniform concentration.
    var i: i64 = 0
    while i < phonon_quantity_state_n(&s) {
        let d = site_value(&s,i) - 1.0e-5
        let ad = if d < 0.0 { 0.0 - d } else { d }
        assert(ad < 1.0e-9)
        // Variances can grow (linearized GUM integration) but must stay ≥ 0
        assert(site_variance(&s,i) >= 0.0)
        i = i + 1
    }
    phonon_quantity_close(s)
}

fn main() -> i64 with Alloc, IO, Mut, Div, Panic {
    test_params_dimensions()
    test_params_si_scale()
    test_pulsatile_boundary_dim()
    test_cfl_dt_bounded()
    test_lattice_init_uniform()
    test_spatial_average()
    test_simulate_uniform_steady()
    0
}
