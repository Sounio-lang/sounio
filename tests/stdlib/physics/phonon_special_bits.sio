//@ run-pass
//@ expect-stdout: PHONON_SPECIAL_BITS_PASS
fn main()->i32 with IO,Mut,Div,Panic {
 let nan:f64=0.0/0.0
 let inf:f64=1.0/0.0
 let nb:i64=f64_to_bits(nan);let ib:i64=f64_to_bits(inf)
 assert((nb&9218868437227405312)==9218868437227405312&&(nb&4503599627370495)!=0)
 assert(ib==9218868437227405312)
 print("SPECIAL_BITS nan ");print_int(nb);println("")
 print("SPECIAL_BITS inf ");print_int(ib);println("")
 println("PHONON_SPECIAL_BITS_PASS");0
}
