//@ check-only
//@ expect-stdout: SCIENCE_PHYSICS_OK
// Science pipeline lane: physics foundations (classical + em + sr + thermo).
// CHECK-ONLY in E2E harness until Madaros run stops SIGSEGV on imported modules.

use physics::classical
use physics::em
use physics::sr
use physics::thermo

fn emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC physics ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var ok: i32 = 0

    if classical::test_newton_force_basic() { ok = ok + 1 }
    if classical::test_ke() { ok = ok + 1 }
    if classical::test_position_kinematics() { ok = ok + 1 }
    if classical::test_force_components() { ok = ok + 1 }
    if em::test_coulomb() { ok = ok + 1 }
    if em::test_lorentz_3d() { ok = ok + 1 }
    if em::test_poynting_vec() { ok = ok + 1 }
    if em::test_em_wave_prop() { ok = ok + 1 }
    if em::test_matrix_pol_rot() { ok = ok + 1 }
    if sr::test_gamma() { ok = ok + 1 }
    if sr::test_time_dil() { ok = ok + 1 }
    if sr::test_vel_add() { ok = ok + 1 }
    if thermo::test_ideal_gas() { ok = ok + 1 }
    if thermo::test_first_law() { ok = ok + 1 }
    if thermo::test_carnot() { ok = ok + 1 }

    let m = classical::quantity_new(2.0, 0.01, classical::dim_mass());
    let a = classical::quantity_new(3.0, 0.02, classical::dim_acceleration());
    let f = classical::classical_force(&m, &a);
    emit_metric("newton_force_N", f.value);

    let v = classical::quantity_new(3.0, 0.0, classical::dim_velocity());
    let ke = classical::classical_ke(&m, &v);
    emit_metric("ke_J", ke.value);

    let (pos_m, _) = classical::classical_pos(0.0, 0.0, 1.0, 0.0, 0.5, 0.0, 2.0);
    emit_metric("position_m", pos_m);

    let (coulomb_f, _) = em::coulomb_force(1.0e-6, 1e-9, 1.0e-6, 1e-9, 0.1, 0.001);
    emit_metric("coulomb_f_N", coulomb_f);

    let c_light = 299792458.0;
    let (gamma_v, _) = sr::gamma(0.6 * c_light, 0.001 * c_light);
    emit_metric("gamma_beta06", gamma_v);

    let (t_dil, _) = sr::time_dilation(1.0, 0.0, 0.6 * c_light, 0.0);
    emit_metric("time_dil_factor", t_dil);

    let (vel_add, _) = sr::velocity_addition(0.5 * c_light, 0.0, 0.5 * c_light, 0.0);
    emit_metric("vel_add_w", vel_add);

    let (p_gas, _) = thermo::ideal_gas_p(1.0, 0.001, 300.0, 0.1, 0.024, 0.0001);
    emit_metric("ideal_gas_P_Pa", p_gas);

    let (du, _) = thermo::first_law_delta_u(100.0, 1.0, 40.0, 2.0);
    emit_metric("first_law_du_J", du);

    let (eta, _) = thermo::carnot_efficiency(600.0, 1.0, 300.0, 1.0);
    emit_metric("carnot_eta", eta);

    emit_metric("classical_ok", bool_to_f64(
        classical::test_newton_force_basic() &&
        classical::test_ke() &&
        classical::test_position_kinematics() &&
        classical::test_force_components()
    ));
    let (ey_wave, _, b_wave, _) = em::em_wave_propagating(0.0, 0.0, 1.0, 1.0, 100.0, 1.0)
    emit_metric("wave_ey_Vpm", ey_wave.y)

    let (ry, rz) = em::rotate_transverse_e(1.0, 0.0, 1.5708)
    emit_metric("pol_rot_rz", rz)

    emit_metric("em_ok", bool_to_f64(
        em::test_coulomb() &&
        em::test_lorentz_3d() &&
        em::test_poynting_vec() &&
        em::test_em_wave_prop() &&
        em::test_matrix_pol_rot()
    ));
    emit_metric("sr_ok", bool_to_f64(sr::test_gamma() && sr::test_time_dil() && sr::test_vel_add()));
    emit_metric("thermo_ok", bool_to_f64(thermo::test_ideal_gas() && thermo::test_first_law() && thermo::test_carnot()));
    emit_metric("tests_passed", ok as f64);

    if ok < 15 {
        return 1
    }

    print("SCIENCE_PHYSICS_OK\n")
    return 0
}