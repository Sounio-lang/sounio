//@ run-pass
//@ ignore
//! tests/stdlib/json/test_json.sio
//!
//! E2E tests for json::parser — minimal JSON serializer and parser.
//!
//! Design notes:
//! - Sounio JIT: &!Struct field mutations propagate; &!array and &!scalar do NOT.
//! - After any &!doc call, use direct field access (doc.values[i].field) for reads.
//! - Serialization uses JsonBuf struct (returned by value from json_serialize_to_buf).
//! - Parsing uses json_parse(&raw, len, &!doc) — &!JsonDoc fields propagate correctly.

use json::parser::{
    JSON_NULL, JSON_BOOL, JSON_NUMBER, JSON_STRING,
    JsonValue, JsonDoc, JsonBuf,
    json_value_null, json_value_bool, json_value_number, json_value_string,
    json_doc_new,
    json_doc_set_number, json_doc_set_bool, json_doc_set_string,
    json_doc_get_number, json_doc_get_bool,
    json_doc_contains, json_doc_count,
    json_serialize_to_buf, json_serialize, json_parse,
    json_self_test,
}

// ============================================================================
// Helpers
// ============================================================================

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.0001
}

fn mk64_1(a: u8) -> [u8; 64] {
    var k: [u8; 64] = [0; 64]
    k[0] = a
    k
}

fn mk64_2(a: u8, b: u8) -> [u8; 64] {
    var k: [u8; 64] = [0; 64]
    k[0] = a
    k[1] = b
    k
}

fn mk64_3(a: u8, b: u8, c: u8) -> [u8; 64] {
    var k: [u8; 64] = [0; 64]
    k[0] = a
    k[1] = b
    k[2] = c
    k
}

fn mk64_4(a: u8, b: u8, c: u8, d: u8) -> [u8; 64] {
    var k: [u8; 64] = [0; 64]
    k[0] = a
    k[1] = b
    k[2] = c
    k[3] = d
    k
}

// ============================================================================
// Test: type constants
// ============================================================================

fn test_type_constants() -> i32 {
    var fail: i32 = 0
    if JSON_NULL() != 0 { fail = fail + 1 }
    if JSON_BOOL() != 1 { fail = fail + 1 }
    if JSON_NUMBER() != 2 { fail = fail + 1 }
    if JSON_STRING() != 3 { fail = fail + 1 }
    fail
}

// ============================================================================
// Test: value constructors
// ============================================================================

fn test_value_constructors() -> i32 {
    var fail: i32 = 0

    let vn = json_value_null()
    if vn.kind != 0 { fail = fail + 1 }

    let vb = json_value_bool(1)
    if vb.kind != 1 { fail = fail + 1 }
    if vb.bool_val != 1 { fail = fail + 1 }

    let vb0 = json_value_bool(0)
    if vb0.bool_val != 0 { fail = fail + 1 }

    let vnum = json_value_number(2.718)
    if vnum.kind != 2 { fail = fail + 1 }
    if !near(vnum.num_val, 2.718) { fail = fail + 1 }

    var sbuf: [u8; 128] = [0; 128]
    sbuf[0] = 104u8  // 'h'
    sbuf[1] = 105u8  // 'i'
    let vs = json_value_string(&sbuf, 2)
    if vs.kind != 3 { fail = fail + 1 }
    if vs.str_len != 2 { fail = fail + 1 }
    if vs.str_val[0] != 104u8 { fail = fail + 1 }
    if vs.str_val[1] != 105u8 { fail = fail + 1 }

    fail
}

// ============================================================================
// Test: doc set number (direct field access after &!doc calls)
// ============================================================================

fn test_doc_number() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0
    var doc = json_doc_new()
    if doc.count != 0 { fail = fail + 1 }

    let k_pi = mk64_2(112u8, 105u8)  // "pi"
    json_doc_set_number(&!doc, &k_pi, 2, 3.14159)
    if doc.count != 1 { fail = fail + 1 }
    if !near(doc.values[0].num_val, 3.14159) { fail = fail + 1 }

    let k_n42 = mk64_3(110u8, 52u8, 50u8)  // "n42"
    json_doc_set_number(&!doc, &k_n42, 3, 42.0)
    if doc.count != 2 { fail = fail + 1 }
    if !near(doc.values[1].num_val, 42.0) { fail = fail + 1 }

    // Update existing key — count stays 2, value at slot 0 updates.
    json_doc_set_number(&!doc, &k_pi, 2, 3.14)
    if doc.count != 2 { fail = fail + 1 }
    if !near(doc.values[0].num_val, 3.14) { fail = fail + 1 }

    fail
}

// ============================================================================
// Test: set/get bool
// ============================================================================

fn test_doc_bool() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0
    var doc = json_doc_new()
    let k_ok = mk64_2(111u8, 107u8)  // "ok"
    json_doc_set_bool(&!doc, &k_ok, 2, 1)
    if doc.values[0].bool_val != 1 { fail = fail + 1 }

    let k_fl = mk64_2(102u8, 108u8)  // "fl"
    json_doc_set_bool(&!doc, &k_fl, 2, 0)
    if doc.values[1].bool_val != 0 { fail = fail + 1 }

    // Update.
    json_doc_set_bool(&!doc, &k_ok, 2, 0)
    if doc.values[0].bool_val != 0 { fail = fail + 1 }

    fail
}

// ============================================================================
// Test: count (no prior &! in this function — can use json_doc_count safely)
// ============================================================================

fn test_doc_count() -> i32 {
    var fail: i32 = 0
    var doc = json_doc_new()
    if json_doc_count(&doc) != 0 { fail = fail + 1 }
    fail
}

// ============================================================================
// Test: contains (no prior &! in this function)
// ============================================================================

fn test_doc_contains() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0
    // Fresh doc, no &! calls yet — can use json_doc_contains safely.
    var doc = json_doc_new()
    let k_x = mk64_1(120u8)
    if json_doc_contains(&doc, &k_x, 1) { fail = fail + 1 }
    fail
}

// ============================================================================
// Test: serialize — use json_serialize_to_buf (returns JsonBuf by value)
// ============================================================================

fn test_serialize() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    var doc = json_doc_new()
    let k_n = mk64_1(110u8)   // "n"
    let k_b = mk64_1(98u8)    // "b"
    json_doc_set_number(&!doc, &k_n, 1, 7.0)
    json_doc_set_bool(&!doc, &k_b, 1, 1)

    // json_serialize_to_buf takes &JsonDoc — after &!doc calls this would conflict.
    // Workaround: call it from a scope where doc has no active mutable borrow.
    // Since json_doc_set_* takes &!doc, after those calls, &doc is conflicted.
    // Use a separate function that serializes a doc that was only set by value.
    // Actually: the borrow is per-binding-scope in Sounio.
    // Test: direct access to serialized buffer via JsonBuf.
    let jb = json_serialize_to_buf(&doc)
    if jb.len < 3 { fail = fail + 1 }
    if jb.data[0] != 123u8 { fail = fail + 1 }  // '{'
    if jb.data[(jb.len - 1) as usize] != 125u8 { fail = fail + 1 }  // '}'

    // Check '7' (55) appears in the buffer.
    var found_7: i32 = 0
    var i: i32 = 0
    while i < jb.len {
        if jb.data[i as usize] == 55u8 { found_7 = 1 }
        i = i + 1
    }
    if found_7 == 0 { fail = fail + 1 }

    // Check 'true' (116,114,117,101) appears.
    var found_t: i32 = 0
    i = 0
    while i + 3 < jb.len {
        if jb.data[i as usize] == 116u8 &&
           jb.data[(i+1) as usize] == 114u8 &&
           jb.data[(i+2) as usize] == 117u8 &&
           jb.data[(i+3) as usize] == 101u8 {
            found_t = 1
        }
        i = i + 1
    }
    if found_t == 0 { fail = fail + 1 }

    fail
}

// ============================================================================
// Test: parse — build raw bytes, parse, check via direct field access
// ============================================================================

fn test_parse() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    // Build: {"x":7,"y":false,"z":3.5}
    var raw: [u8; 4096] = [0; 4096]
    raw[0]  = 123u8  // '{'
    raw[1]  = 34u8   // '"'
    raw[2]  = 120u8  // 'x'
    raw[3]  = 34u8   // '"'
    raw[4]  = 58u8   // ':'
    raw[5]  = 55u8   // '7'
    raw[6]  = 44u8   // ','
    raw[7]  = 34u8   // '"'
    raw[8]  = 121u8  // 'y'
    raw[9]  = 34u8   // '"'
    raw[10] = 58u8   // ':'
    raw[11] = 102u8  // 'f'
    raw[12] = 97u8   // 'a'
    raw[13] = 108u8  // 'l'
    raw[14] = 115u8  // 's'
    raw[15] = 101u8  // 'e'
    raw[16] = 44u8   // ','
    raw[17] = 34u8   // '"'
    raw[18] = 122u8  // 'z'
    raw[19] = 34u8   // '"'
    raw[20] = 58u8   // ':'
    raw[21] = 51u8   // '3'
    raw[22] = 46u8   // '.'
    raw[23] = 53u8   // '5'
    raw[24] = 125u8  // '}'
    let raw_len: i32 = 25

    var doc = json_doc_new()
    let res = json_parse(&raw, raw_len, &!doc)
    if res != 0 { fail = fail + 1 }
    if doc.count != 3 { fail = fail + 1 }

    // Direct field access after &! (avoids borrow conflict).
    // Slot 0 = "x" = 7.0 (number)
    if doc.values[0].kind != 2 { fail = fail + 1 }
    if !near(doc.values[0].num_val, 7.0) { fail = fail + 1 }
    // Slot 1 = "y" = false (bool=0)
    if doc.values[1].kind != 1 { fail = fail + 1 }
    if doc.values[1].bool_val != 0 { fail = fail + 1 }
    // Slot 2 = "z" = 3.5 (number)
    if doc.values[2].kind != 2 { fail = fail + 1 }
    if !near(doc.values[2].num_val, 3.5) { fail = fail + 1 }

    // Parse error on bad input.
    var bad: [u8; 4096] = [0; 4096]
    bad[0] = 65u8  // 'A' — not '{'
    var bad_doc = json_doc_new()
    let bad_res = json_parse(&bad, 1, &!bad_doc)
    if bad_res != 0 - 1 { fail = fail + 1 }

    fail
}

// ============================================================================
// Test: round-trip (serialize → copy to new buf → parse → compare)
// ============================================================================

fn test_roundtrip() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    // Build doc.
    var orig = json_doc_new()
    let k_a = mk64_1(97u8)   // "a"
    let k_b = mk64_1(98u8)   // "b"
    let k_c = mk64_1(99u8)   // "c"
    json_doc_set_number(&!orig, &k_a, 1, 100.0)
    json_doc_set_bool(&!orig, &k_b, 1, 0)
    json_doc_set_number(&!orig, &k_c, 1, 0.5)

    // Serialize to JsonBuf (by value return — works in JIT).
    let jb = json_serialize_to_buf(&orig)

    // Copy serialized data to a [u8; 4096] for parsing.
    var parse_in: [u8; 4096] = [0; 4096]
    var ci: i32 = 0
    while ci < jb.len {
        parse_in[ci as usize] = jb.data[ci as usize]
        ci = ci + 1
    }

    // Parse back.
    var parsed = json_doc_new()
    let res = json_parse(&parse_in, jb.len, &!parsed)
    if res != 0 { fail = fail + 1 }
    if parsed.count != 3 { fail = fail + 1 }

    // Direct field access.
    if !near(parsed.values[0].num_val, 100.0) { fail = fail + 1 }
    if parsed.values[1].bool_val != 0 { fail = fail + 1 }
    if !near(parsed.values[2].num_val, 0.5) { fail = fail + 1 }

    fail
}

// ============================================================================
// Test: string value
// ============================================================================

fn test_strings() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    var doc = json_doc_new()
    let k_nm = mk64_4(110u8, 97u8, 109u8, 101u8)  // "name"
    var sv: [u8; 128] = [0; 128]
    sv[0] = 65u8   // 'A'
    sv[1] = 108u8  // 'l'
    sv[2] = 105u8  // 'i'
    sv[3] = 99u8   // 'c'
    sv[4] = 101u8  // 'e'
    json_doc_set_string(&!doc, &k_nm, 4, &sv, 5)

    // Direct field access.
    if doc.values[0].kind != 3 { fail = fail + 1 }
    if doc.values[0].str_len != 5 { fail = fail + 1 }
    if doc.values[0].str_val[0] != 65u8  { fail = fail + 1 }  // 'A'
    if doc.values[0].str_val[4] != 101u8 { fail = fail + 1 }  // 'e'

    // Serialize — 'A' (65) should appear.
    let jb = json_serialize_to_buf(&doc)
    var found_A: i32 = 0
    var i: i32 = 0
    while i < jb.len {
        if jb.data[i as usize] == 65u8 { found_A = 1 }
        i = i + 1
    }
    if found_A == 0 { fail = fail + 1 }

    fail
}

// ============================================================================
// Test: parse string value
// ============================================================================

fn test_parse_string() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    // Build: {"msg":"hi"}
    var raw: [u8; 4096] = [0; 4096]
    raw[0]  = 123u8  // '{'
    raw[1]  = 34u8   // '"'
    raw[2]  = 109u8  // 'm'
    raw[3]  = 115u8  // 's'
    raw[4]  = 103u8  // 'g'
    raw[5]  = 34u8   // '"'
    raw[6]  = 58u8   // ':'
    raw[7]  = 34u8   // '"'
    raw[8]  = 104u8  // 'h'
    raw[9]  = 105u8  // 'i'
    raw[10] = 34u8   // '"'
    raw[11] = 125u8  // '}'
    let raw_len: i32 = 12

    var doc = json_doc_new()
    let res = json_parse(&raw, raw_len, &!doc)
    if res != 0 { fail = fail + 1 }
    if doc.count != 1 { fail = fail + 1 }
    if doc.values[0].kind != 3 { fail = fail + 1 }  // JSON_STRING
    if doc.values[0].str_len != 2 { fail = fail + 1 }
    if doc.values[0].str_val[0] != 104u8 { fail = fail + 1 }  // 'h'
    if doc.values[0].str_val[1] != 105u8 { fail = fail + 1 }  // 'i'

    fail
}

// ============================================================================
// Test: parse null value
// ============================================================================

fn test_parse_null() -> i32 with Mut, Div, Panic {
    var fail: i32 = 0

    // Build: {"v":null}
    var raw: [u8; 4096] = [0; 4096]
    raw[0] = 123u8  // '{'
    raw[1] = 34u8   // '"'
    raw[2] = 118u8  // 'v'
    raw[3] = 34u8   // '"'
    raw[4] = 58u8   // ':'
    raw[5] = 110u8  // 'n'
    raw[6] = 117u8  // 'u'
    raw[7] = 108u8  // 'l'
    raw[8] = 108u8  // 'l'
    raw[9] = 125u8  // '}'
    let raw_len: i32 = 10

    var doc = json_doc_new()
    let res = json_parse(&raw, raw_len, &!doc)
    if res != 0 { fail = fail + 1 }
    if doc.count != 1 { fail = fail + 1 }
    if doc.values[0].kind != 0 { fail = fail + 1 }  // JSON_NULL

    fail
}

// ============================================================================
// Test: inline self-test from parser module
// ============================================================================

fn test_self_test() -> i32 with Mut, Div, Panic {
    json_self_test()
}

// ============================================================================
// main
// ============================================================================

fn main() -> i32 with Mut, Div, Panic {
    var total_fail: i32 = 0

    total_fail = total_fail + test_type_constants()
    total_fail = total_fail + test_value_constructors()
    total_fail = total_fail + test_doc_number()
    total_fail = total_fail + test_doc_bool()
    total_fail = total_fail + test_doc_count()
    total_fail = total_fail + test_doc_contains()
    total_fail = total_fail + test_serialize()
    total_fail = total_fail + test_parse()
    total_fail = total_fail + test_roundtrip()
    total_fail = total_fail + test_strings()
    total_fail = total_fail + test_parse_string()
    total_fail = total_fail + test_parse_null()
    total_fail = total_fail + test_self_test()

    if total_fail == 0 {
        return 0
    }
    1
}
