//@ run-pass
//@ expect-stdout: JSON_OK
use json::parser::*;

fn main() -> i32 with IO, Mut, Div, Panic {
    var doc = json_doc_new()
    var key: [u8; 64] = [0u8; 64]
    key[0] = 120 as u8
    json_doc_set_number(&!doc, &key, 1, 42.0)
    if doc.count != 1 { return 1 }
    if !json_doc_contains(&doc, &key, 1) { return 1 }
    println("JSON_OK")
    0
}
