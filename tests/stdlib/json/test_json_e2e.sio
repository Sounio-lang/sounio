//@ run-pass
// E2E: stdlib/json/mod.sio — JsonValue, JsonArray

use json::*;

fn run_tests(arr: &! JsonArray) -> i32 {
    // Null value
    let n = json_null()
    if !n.is_null() { return 1 }
    if n.is_int() { return 2 }

    // Bool value
    let t = json_bool(true)
    if !t.is_bool() { return 3 }
    if !t.as_bool() { return 4 }

    let f = json_bool(false)
    if f.as_bool() { return 5 }

    // Int value
    let i = json_int(42)
    if !i.is_int() { return 6 }
    if i.as_int() != 42 { return 7 }

    // Float value
    let fv = json_float(3.14)
    if !fv.is_float() { return 8 }

    // JsonArray
    arr.push_int(10)
    arr.push_int(20)
    arr.push_float(3.14)
    arr.push_null()
    if arr.len() != 4 { return 9 }
    if arr.get_int(0) != 10 { return 10 }
    if arr.get_int(1) != 20 { return 11 }

    return 0
}

fn main() -> i32 {
    var arr = JsonArray::new()
    return run_tests(&! arr)
}
