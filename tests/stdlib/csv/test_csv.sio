//@ run-pass
//@ expect-stdout: CSV_OK
use csv::parser::*;

fn main() -> i32 with IO, Mut, Div, Panic {
    var t = csv_table_new()
    var row: [f64; 16] = [0.0; 16]
    row[0] = 1.0
    row[1] = 2.0
    csv_table_add_row(&!t, &row, 2)
    if t.n_rows != 1 { return 1 }
    if t.n_cols != 2 { return 1 }
    if csv_table_get(&t, 0, 1) != 2.0 { return 1 }
    println("CSV_OK")
    0
}
