//@ run-pass
//@ requires: madaros
//@ expect-stdout: UNICODE_PROPERTIES_OK
// Deliberately no IO/Alloc/Mut/Div requirement in property functions;
// main uses only printing and assertions. Queries use the pinned static data.
use text::ucd_data::{unicode_property_is,unicode_property_value}
fn main() with IO,Panic {
 assert(unicode_property_is(65,"gc","Lu"))
 assert(unicode_property_is(65,"General Category","Uppercase-Letter"))
 assert(unicode_property_is(65,"gc","L"))
 assert(unicode_property_is(65,"gc","Letter"))
 assert(unicode_property_is(65,"gc","LC"))
 assert(unicode_property_is(65,"gc","Cased_Letter"))
 assert(!unicode_property_is(65,"gc","Ll"))
 assert(unicode_property_is(48,"gc","N"))
 assert(!unicode_property_is(48,"gc","L"))
 assert(unicode_property_is(0,"gc","C"))
 assert(unicode_property_is(0xD800,"gc","Cs"))
 assert(unicode_property_is(0x0345,"Alphabetic","Y"))
 assert(unicode_property_is(0x00A0,"White_Space","Y"))
 assert(!unicode_property_is(0x200B,"White_Space","Y"))
 assert(unicode_property_is(0x10FFFF,"Noncharacter_Code_Point","Y"))
 assert(unicode_property_is(65,"scx","Latin"))
 assert(unicode_property_is(40,"scx","Common"))
 assert(unicode_property_is(0x30FC,"scx","Hiragana"))
 assert(unicode_property_is(0x30FC,"scx","Kana"))
 assert(!unicode_property_is(0x30FC,"scx","Latin"))
 let extension=unicode_property_value(65,"scx")
 let script=unicode_property_value(65,"sc")
 assert(extension.status==0 && script.status==0 && extension.id==script.id)
 // Numeric data is canonical exact UCD text. A minus sign is significant.
 assert(unicode_property_is(0x0F33,"nv","-1/2"))
 assert(!unicode_property_is(0x0F33,"nv","1/2"))
 assert(unicode_property_is(65,"Age","1.1"))
 assert(unicode_property_value(0-1,"gc").status==5)
 assert(unicode_property_value(0x110000,"gc").status==5)
 assert(unicode_property_value(65,"no_such_property").status==4)
 print("UNICODE_PROPERTIES_OK\n")
}
