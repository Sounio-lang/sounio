//@ run-pass
//@ expect-stdout: LOCALE_ADVERSARIAL_NATIVE_OK
use collections::byte_buffer::{byte_buffer_new,byte_buffer_push,byte_buffer_close}
use text::utf8::{Utf8Text,utf8_text_from_string,utf8_text_from_bytes,utf8_text_status,utf8_text_byte_len,utf8_text_byte_at,utf8_text_close}
use text::locale_collation::{UnicodeLocaleOptions,unicode_locale_options,unicode_locale_collator,unicode_locale_collator_status,unicode_locale_collation_key,unicode_locale_key_status,unicode_locale_key_len,unicode_locale_key_at,unicode_locale_key_compare,unicode_locale_key_close,unicode_locale_key_encoding_version,unicode_locale_key_uca_version,unicode_locale_key_cldr_version,unicode_locale_resolved_options,unicode_locale_uca_version,unicode_locale_cldr_version,unicode_locale_key_format_version,unicode_locale_bundled_count,unicode_locale_bundled_collator}
fn unchanged(t:&Utf8Text) with Panic {
 assert(utf8_text_status(t)==0)
 assert(utf8_text_byte_len(t)==4)
 assert(utf8_text_byte_at(t,0).value==195)
 assert(utf8_text_byte_at(t,1).value==164)
 assert(utf8_text_byte_at(t,2).value==0)
 assert(utf8_text_byte_at(t,3).value==98)
}
fn main() with IO,Alloc,Mut,Div,Panic {
 let name=utf8_text_from_string("de",128)
 let kind=utf8_text_from_string("phonebook",128)
 let options=unicode_locale_options()
 let c=unicode_locale_collator(&name,&kind,&options,8192)
 assert(unicode_locale_collator_status(&c)==0)
 let actual=unicode_locale_resolved_options(&c)
 assert(actual.strength>=1 && actual.strength<=5)
 assert(actual.alternate>=0 && actual.alternate<=1)
 assert(actual.case_first>=0 && actual.case_first<=2)
 assert(actual.max_variable>=0 && actual.max_variable<=3)
 assert(unicode_locale_uca_version()==1179648)
 assert(unicode_locale_cldr_version()==49)
 assert(unicode_locale_key_format_version()==1)
 assert(unicode_locale_bundled_count()==154)
 assert(unicode_locale_collator_status(&unicode_locale_bundled_collator(0-1))==4)
 assert(unicode_locale_collator_status(&unicode_locale_bundled_collator(154))==4)
 var index:i64=0
 while index<unicode_locale_bundled_count() {let item=unicode_locale_bundled_collator(index);assert(unicode_locale_collator_status(&item)==0);index=index+1}
 var bytes=byte_buffer_new(32)
 assert(byte_buffer_push(&!bytes,195)==0)
 assert(byte_buffer_push(&!bytes,164)==0)
 assert(byte_buffer_push(&!bytes,0)==0)
 assert(byte_buffer_push(&!bytes,98)==0)
 let text=utf8_text_from_bytes(&bytes,32)
 byte_buffer_close(bytes)
 unchanged(&text)
 let good=unicode_locale_collation_key(&c,&text,65536,65536)
 let equal=unicode_locale_collation_key(&c,&text,65536,65536)
 assert(unicode_locale_key_status(&good)==0)
 assert(unicode_locale_key_compare(&good,&equal).status==0)
 assert(unicode_locale_key_compare(&good,&equal).order==0)
 assert(unicode_locale_key_encoding_version(&good)==1)
 assert(unicode_locale_key_uca_version(&good)==1179648)
 assert(unicode_locale_key_cldr_version(&good)==49)
 assert(unicode_locale_key_at(&good,0-1).status==4)
 assert(unicode_locale_key_at(&good,unicode_locale_key_len(&good)).status==4)
 let no_key_budget=unicode_locale_collation_key(&c,&text,0,65536)
 assert(unicode_locale_key_status(&no_key_budget)==2)
 assert(unicode_locale_key_len(&no_key_budget)==0)
 assert(unicode_locale_key_compare(&good,&no_key_budget).status==2)
 unchanged(&text)
 let no_work_budget=unicode_locale_collation_key(&c,&text,65536,0)
 assert(unicode_locale_key_status(&no_work_budget)==2)
 assert(unicode_locale_key_len(&no_work_budget)==0)
 unchanged(&text)
 let negative_work=unicode_locale_collation_key(&c,&text,65536,0-1)
 assert(unicode_locale_key_status(&negative_work)==1)
 assert(unicode_locale_key_len(&negative_work)==0)
 let primary_options=UnicodeLocaleOptions {strength:1,alternate:0-1,backwards_secondary:0-1,case_level:0-1,case_first:0-1,max_variable:0-1}
 let primary=unicode_locale_collator(&name,&kind,&primary_options,8192)
 let other_settings=unicode_locale_collation_key(&primary,&text,65536,65536)
 assert(unicode_locale_key_status(&other_settings)==0)
 assert(unicode_locale_key_compare(&good,&other_settings).status==7)
 let a_text=utf8_text_from_string("a",128)
 let b_text=utf8_text_from_string("b",128)
 let a_key=unicode_locale_collation_key(&primary,&a_text,65536,65536)
 let b_key=unicode_locale_collation_key(&primary,&b_text,65536,65536)
 assert(unicode_locale_key_status(&a_key)==0 && unicode_locale_key_status(&b_key)==0)
 assert(unicode_locale_key_compare(&a_key,&b_key).order==0-1)
 unicode_locale_key_close(a_key);unicode_locale_key_close(b_key)
 utf8_text_close(a_text);utf8_text_close(b_text)
 let sv_name=utf8_text_from_string("sv",128)
 let sv_kind=utf8_text_from_string("standard",128)
 let sv=unicode_locale_collator(&sv_name,&sv_kind,&options,8192)
 let other_locale=unicode_locale_collation_key(&sv,&text,65536,65536)
 assert(unicode_locale_key_status(&other_locale)==0)
 assert(unicode_locale_key_compare(&good,&other_locale).status==7)
 let invalid_options=UnicodeLocaleOptions {strength:0,alternate:0-1,backwards_secondary:0-1,case_level:0-1,case_first:0-1,max_variable:0-1}
 let invalid=unicode_locale_collator(&name,&kind,&invalid_options,8192)
 assert(unicode_locale_collator_status(&invalid)==1)
 let invalid_key=unicode_locale_collation_key(&invalid,&text,65536,65536)
 assert(unicode_locale_key_status(&invalid_key)==1)
 assert(unicode_locale_key_len(&invalid_key)==0)
 var malformed=byte_buffer_new(8)
 assert(byte_buffer_push(&!malformed,237)==0)
 assert(byte_buffer_push(&!malformed,160)==0)
 assert(byte_buffer_push(&!malformed,128)==0)
 let surrogate=utf8_text_from_bytes(&malformed,8)
 byte_buffer_close(malformed)
 assert(utf8_text_status(&surrogate)==5)
 let rejected=unicode_locale_collation_key(&c,&surrogate,65536,65536)
 assert(unicode_locale_key_status(&rejected)==5)
 assert(unicode_locale_key_len(&rejected)==0)
 unchanged(&text)
 unicode_locale_key_close(good);unicode_locale_key_close(equal)
 unicode_locale_key_close(no_key_budget);unicode_locale_key_close(no_work_budget)
 unicode_locale_key_close(negative_work);unicode_locale_key_close(other_settings)
 unicode_locale_key_close(other_locale);unicode_locale_key_close(invalid_key)
 unicode_locale_key_close(rejected)
 utf8_text_close(name);utf8_text_close(kind);utf8_text_close(text)
 utf8_text_close(sv_name);utf8_text_close(sv_kind);utf8_text_close(surrogate)
 println("LOCALE_ADVERSARIAL_NATIVE_OK")
}

