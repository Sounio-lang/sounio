//@ run-pass
//@ requires: madaros
//@ expect-stdout: NARROW_U8_STORE_OK
// Regression: the last element must not touch the page after this allocation.
fn main() with Alloc,Mut,Panic,IO {
 let base=heap_alloc(4088)
 assert((base as i64)>0)
 let last=((base as i64)+4087) as *mut u8
 *last=1 as u8
 assert((*last as i64)==1)
 heap_free(base)
 print("NARROW_U8_STORE_OK\n")
}
