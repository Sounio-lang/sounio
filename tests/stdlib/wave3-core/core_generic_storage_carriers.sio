//@ run-pass
//@ expect-stdout: CORE_GENERIC_STORAGE_CARRIERS_OK
use core::{Result}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_push,byte_buffer_len,byte_buffer_get,byte_buffer_close}
fn owner_bytes()->ByteBuffer with Alloc,Mut,Div,Panic {
 var bytes=byte_buffer_new(3)
 assert(byte_buffer_push(&!bytes,65)==0)
 assert(byte_buffer_push(&!bytes,0)==0)
 assert(byte_buffer_push(&!bytes,255)==0)
 bytes
}
fn consume(owner:ByteBuffer)->i64 with Alloc,Panic {
 assert(byte_buffer_len(&owner)==3)
 assert(byte_buffer_get(&owner,0).value==65)
 assert(byte_buffer_get(&owner,1).value==0)
 assert(byte_buffer_get(&owner,2).value==255)
 byte_buffer_close(owner)
 3
}
fn push_result(value:Result<(),(i64,ByteBuffer)>)->i64 with Alloc,Panic {
 match value {
  Result::Ok(unit)=>{0},
  Result::Err(pair)=>{
   let (code,owner)=pair
   assert(code==3)
   consume(owner)
  },
 }
}
fn replace_result(value:Result<ByteBuffer,(i64,ByteBuffer)>)->ByteBuffer with Panic {
 match value {
  Result::Ok(owner)=>{owner},
  Result::Err(pair)=>{
   let (code,owner)=pair
   assert(code==3)
   owner
  },
 }
}
fn numeric(value:Result<f64,(i64,f64)>)->f64 with Panic {
 match value {
  Result::Ok(number)=>{number},
  Result::Err(pair)=>{
   let (code,number)=pair
   assert(code==3)
   number
  },
 }
}
fn main() with IO,Alloc,Mut,Div,Panic {
 let failed_push:Result<(),(i64,ByteBuffer)> =Result::Err((3,owner_bytes()))
 assert(push_result(failed_push)==3)
 let successful_push:Result<(),(i64,ByteBuffer)> =Result::Ok(())
 assert(push_result(successful_push)==0)
 let successful_replace:Result<ByteBuffer,(i64,ByteBuffer)> =Result::Ok(owner_bytes())
 assert(consume(replace_result(successful_replace))==3)
 let failed_replace:Result<ByteBuffer,(i64,ByteBuffer)> =Result::Err((3,owner_bytes()))
 assert(consume(replace_result(failed_replace))==3)
 let success:Result<f64,(i64,f64)> =Result::Ok(0.5)
 let error:Result<f64,(i64,f64)> =Result::Err((3,0.5))
 assert(numeric(success)==0.5)
 assert(numeric(error)==0.5)
 println("CORE_GENERIC_STORAGE_CARRIERS_OK")
}
