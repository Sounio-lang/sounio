//@ run-pass
//@ requires: madaros
//@ expect-stdout: UTF8_EXACT_PAGE_OK
// Payload4088 + allocator header8 exactly fills a4096-byte page.
// A narrow store/load must stay inside the allocation even at the final byte.
// This is deliberately an exact budget: geometric reserve cannot add padding.
use collections::byte_buffer::{byte_buffer_new,byte_buffer_len,byte_buffer_capacity,byte_buffer_get,byte_buffer_close}
use text::utf8::{utf8_encode_append,utf8_text_from_bytes,utf8_text_status,utf8_text_byte_len,utf8_text_scalar_len,utf8_text_next,utf8_text_append_scalar,utf8_text_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var bytes=byte_buffer_new(4088)
 var i:i64=0
 while i<4088 {assert(utf8_encode_append(&!bytes,65)==0);i=i+1}
 assert(byte_buffer_len(&bytes)==4088 && byte_buffer_capacity(&bytes)==4088)
 assert(byte_buffer_get(&bytes,4087).value==65)
 assert(utf8_encode_append(&!bytes,233)==2)
 assert(byte_buffer_len(&bytes)==4088)
 var text=utf8_text_from_bytes(&bytes,4088)
 byte_buffer_close(bytes)
 assert(utf8_text_status(&text)==0)
 assert(utf8_text_byte_len(&text)==4088 && utf8_text_scalar_len(&text)==4088)
 assert(utf8_text_next(&text,4087).codepoint==65)
 assert(utf8_text_append_scalar(&!text,65)==2)
 assert(utf8_text_scalar_len(&text)==4088)
 utf8_text_close(text)
 let negative=utf8_text_new(0-1)
 assert(utf8_text_status(&negative)==1)
 utf8_text_close(negative)
 let overflow=utf8_text_new(9223372036854771705)
 assert(utf8_text_status(&overflow)==1)
 utf8_text_close(overflow)
 print("UTF8_EXACT_PAGE_OK\n")
 0
}
