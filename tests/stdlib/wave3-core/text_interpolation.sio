//@ run-pass
//@ requires: madaros
//@ expect-stdout: TEXT_INTERPOLATION_OK
use text::{interp_str,interp_i64,interp_f64}
use text::format::{i64_to_str,f64_to_str,format_int,format_f64}
fn main()->i32 with IO,Mut,Div,Panic {
 assert(interp_str("Hi {name}!","name","NUL-free")=="Hi NUL-free!")
 assert(interp_str("{x}/{x}","x","v")=="v/{x}")
 assert(interp_str("unchanged","missing","v")=="unchanged")
 assert(interp_i64("n={n}","n",0-9223372036854775807-1)=="n=-9223372036854775808")
 assert(i64_to_str(0-9223372036854775807-1)=="-9223372036854775808")
 assert(format_int(9223372036854775807)=="9223372036854775807")
 // Exactly representable binary fractions preserve the existing four-place truncation.
 assert(f64_to_str(1.25)=="1.2500")
 assert(format_f64(0.5)=="0.5000")
 assert(interp_f64("x={x}","x",0.0-0.5)=="x=-0.5000")
 print("TEXT_INTERPOLATION_OK\n")
 0
}
