//@ run-pass
//@ expect-stdout: CORE_GENERIC_LIB_EXPORTS_OK
use core::lib::{Option,Result}
fn read(value:Option<i64>)->i64 {
 match value {Option::Some(number)=>{number},Option::None=>{0}}
}
fn unit(value:Result<(),i64>)->i64 {
 match value {Result::Ok(empty)=>{0},Result::Err(code)=>{code}}
}
fn main() with IO,Panic {
 let value:Option<i64> =Option::Some(42)
 let empty:Option<i64> =Option::None
 assert(read(value)==42)
 assert(read(empty)==0)
 let success:Result<(),i64> =Result::Ok(())
 assert(unit(success)==0)
 println("CORE_GENERIC_LIB_EXPORTS_OK")
}
