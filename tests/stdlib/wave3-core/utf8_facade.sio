//@ run-pass
//@ requires: madaros
//@ expect-stdout: UTF8_FACADE_OK
use text::{Utf8Text,utf8_text_new,utf8_text_append_scalar,utf8_text_scalar_len,utf8_text_byte_len,utf8_text_byte_at,utf8_text_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var text:Utf8Text=utf8_text_new(4)
 assert(utf8_text_append_scalar(&!text,0)==0)
 assert(utf8_text_append_scalar(&!text,233)==0)
 assert(utf8_text_scalar_len(&text)==2 && utf8_text_byte_len(&text)==3)
 assert(utf8_text_byte_at(&text,0).value==0)
 utf8_text_close(text)
 print("UTF8_FACADE_OK\n")
 0
}

