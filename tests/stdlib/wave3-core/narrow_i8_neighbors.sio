//@ run-pass
//@ requires: madaros
//@ expect-stdout: NARROW_WIDTH_OK
// Expected byte patterns generated in C++23; allocation size is unpadded.
fn main() with Alloc,Mut,Panic,IO {
 let base=heap_alloc(4088)
 assert((base as i64)>0)
 let words=base as *mut i64
 write_i64(words,0,1234605616436508552)
 write_i64(words,1,1311768465173141112)
 let at=((base as i64)+3) as *mut i8
 *at=(0-128) as i8
 assert(read_i64(words,0)==1234605617157928840)
 assert(read_i64(words,1)==1311768465173141112)
 assert((*at as i64)==(0-128))
 heap_free(base)
 print("NARROW_WIDTH_OK\n")
}
