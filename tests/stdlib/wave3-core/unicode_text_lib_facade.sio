//@ run-pass
//@ expect-stdout: UNICODE_TEXT_LIB_FACADE_OK
use text::lib::{Utf8Text,utf8_text_from_string,utf8_text_new,utf8_text_byte_len,utf8_text_byte_at,utf8_text_close,unicode_property_is,unicode_lowercase_append,unicode_normalize_append,unicode_segment_append,unicode_collator_root,unicode_collation_key,unicode_collation_key_status,unicode_collation_key_compare,unicode_collation_key_close,unicode_locale_options,unicode_locale_collator,unicode_locale_collation_key,unicode_locale_key_status,unicode_locale_key_compare,unicode_locale_key_close,unicode_bidi_resolve,unicode_bidi_status,unicode_bidi_scalar_len,unicode_bidi_level,unicode_bidi_line_reorder,unicode_bidi_line_status,unicode_bidi_line_len,unicode_bidi_line_level,unicode_bidi_line_close,unicode_bidi_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_len,integer_buffer_get,integer_buffer_close}
fn main() with IO,Alloc,Mut,Div,Panic {
 let input=utf8_text_from_string("A",128)
 assert(unicode_property_is(65,"General_Category","Lu"))
 var lower=utf8_text_new(128)
 assert(unicode_lowercase_append(&input,0,4096,&!lower)==0)
 assert(utf8_text_byte_len(&lower)==1)
 assert(utf8_text_byte_at(&lower,0).value==97)
 var normalized=utf8_text_new(128)
 assert(unicode_normalize_append(&input,2,4096,&!normalized)==0)
 assert(utf8_text_byte_len(&normalized)==1)
 var boundaries=integer_buffer_new(0,128)
 assert(unicode_segment_append(&input,0,8192,&!boundaries)==0)
 assert(integer_buffer_len(&boundaries)==2)
 assert(integer_buffer_get(&boundaries,0).value==0)
 assert(integer_buffer_get(&boundaries,1).value==1)
 let root=unicode_collator_root(0,3,false,false)
 let root_key=unicode_collation_key(&root,&input,65536,65536)
 assert(unicode_collation_key_status(&root_key)==0)
 assert(unicode_collation_key_compare(&root_key,&root_key).order==0)
 let name=utf8_text_from_string("de",128)
 let ty=utf8_text_from_string("phonebook",128)
 let options=unicode_locale_options()
 let locale=unicode_locale_collator(&name,&ty,&options,8192)
 let locale_key=unicode_locale_collation_key(&locale,&input,65536,65536)
 assert(unicode_locale_key_status(&locale_key)==0)
 assert(unicode_locale_key_compare(&locale_key,&locale_key).order==0)
 let bidi=unicode_bidi_resolve(&input,0,4096,8192)
 assert(unicode_bidi_status(&bidi)==0)
 assert(unicode_bidi_scalar_len(&bidi)==1)
 assert(unicode_bidi_level(&bidi,0).value==0)
 let line=unicode_bidi_line_reorder(&bidi,0,1,1024)
 assert(unicode_bidi_line_status(&line)==0)
 assert(unicode_bidi_line_len(&line)==1)
 assert(unicode_bidi_line_level(&line,0).value==0)
 unicode_bidi_line_close(line);unicode_bidi_close(bidi)
 unicode_collation_key_close(root_key);unicode_locale_key_close(locale_key)
 integer_buffer_close(boundaries)
 utf8_text_close(input);utf8_text_close(lower);utf8_text_close(normalized)
 utf8_text_close(name);utf8_text_close(ty)
 println("UNICODE_TEXT_LIB_FACADE_OK")
}

