//@ run-pass
//@ expect-stdout: CORE_CONCRETE_OPTION_VISIBILITY_OK
use core::option::{IntOption,FloatOption,int_some,int_none,int_option_unwrap,int_option_unwrap_or,float_some,float_none,float_option_unwrap,float_option_unwrap_or}
fn integer(value:&IntOption)->i64 {int_option_unwrap(value)}
fn floating(value:&FloatOption)->f64 {float_option_unwrap(value)}
fn main() with IO,Panic {
 let some_integer:IntOption=int_some(42)
 let no_integer:IntOption=int_none()
 let some_float:FloatOption=float_some(0.5)
 let no_float:FloatOption=float_none()
 assert(integer(&some_integer)==42)
 assert(int_option_unwrap_or(&no_integer,7)==7)
 assert(floating(&some_float)==0.5)
 assert(float_option_unwrap_or(&no_float,0.25)==0.25)
 println("CORE_CONCRETE_OPTION_VISIBILITY_OK")
}
