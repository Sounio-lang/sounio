//@ run-pass
//@ expect-stdout: NORMAL_SCALAR_OK
use stats::normal_scalar::{normal_cdf_scalar,normal_sf_scalar,normal_logcdf_scalar,normal_logsf_scalar,normal_standard_logtail_into}
use math::pure::{is_finite}
fn main() with IO,Mut,Div,Panic {
 assert(normal_cdf_scalar(0.0)==0.5)
 assert(normal_sf_scalar(0.0)==0.5)
 assert(normal_logcdf_scalar(0.0)== -0.6931471805599453)
 assert(normal_logsf_scalar(0.0)== -0.6931471805599453)
 assert(normal_cdf_scalar(-8.0)==normal_sf_scalar(8.0))
 assert(normal_logcdf_scalar(-8.0)==normal_logsf_scalar(8.0))
 assert(normal_sf_scalar(8.0)>0.0 && normal_sf_scalar(8.0)<1.0e-14)
 assert(normal_logcdf_scalar(10.0)<0.0)
 assert(normal_logsf_scalar(-10.0)<0.0)
 assert(normal_sf_scalar(40.0)==0.0)
 assert(is_finite(normal_logsf_scalar(40.0)))
 assert(normal_logsf_scalar(40.0)< -700.0)
 let inf=1.0e308*10.0
 assert(normal_cdf_scalar(inf)==1.0 && normal_sf_scalar(inf)==0.0)
 assert(normal_cdf_scalar(-inf)==0.0 && normal_sf_scalar(-inf)==1.0)
 assert(normal_logcdf_scalar(inf)==0.0 && normal_logsf_scalar(-inf)==0.0)
 assert(normal_logcdf_scalar(-inf)== -inf && normal_logsf_scalar(inf)== -inf)
 let nan=inf-inf
 assert(normal_cdf_scalar(nan)!=normal_cdf_scalar(nan))
 assert(normal_sf_scalar(nan)!=normal_sf_scalar(nan))
 assert(normal_logcdf_scalar(nan)!=normal_logcdf_scalar(nan))
 assert(normal_logsf_scalar(nan)!=normal_logsf_scalar(nan))
 var status:i64=9
 var iterations:i64=9
 var method:i64=9
 let unavailable=normal_standard_logtail_into(2.0,1,1.0e-12,&!status,&!iterations,&!method)
 assert(status==3 && iterations==1 && method==2)
 let zero=normal_standard_logtail_into(0.0,1,1.0e-12,&!status,&!iterations,&!method)
 assert(status==0 && iterations==0 && method==0 && zero== -0.6931471805599453)
 println("NORMAL_SCALAR_OK")
}
