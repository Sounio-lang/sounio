//@ run-pass
//@ requires: madaros
//@ expect-stdout: UNICODE_COLLATION_ROOT_OK
use text::utf8::{utf8_text_new,utf8_text_from_string,utf8_text_append_scalar,utf8_text_close}
use text::collation::{unicode_collator_root,unicode_collator_status,unicode_collator_uca_version,unicode_collator_cldr_version,unicode_collator_resolved_locale,unicode_collation_key,unicode_collation_key_status,unicode_collation_key_len,unicode_collation_key_compare,unicode_collation_key_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let root=unicode_collator_root(0,5,false,false)
 let cldr=unicode_collator_root(1,5,false,false)
 assert(unicode_collator_status(&root)==0)
 assert(unicode_collator_uca_version(&root)==1179648)
 assert(unicode_collator_cldr_version(&cldr)==49)
 assert(str_len(unicode_collator_resolved_locale(&cldr))==4)
 let invalid=unicode_collator_root(2,0,false,false)
 assert(unicode_collator_status(&invalid)==1)
 let composed=utf8_text_from_string("é",8)
 var decomposed=utf8_text_new(8)
 assert(utf8_text_append_scalar(&!decomposed,101)==0)
 assert(utf8_text_append_scalar(&!decomposed,769)==0)
 let a=unicode_collation_key(&root,&composed,8192,8192)
 let b=unicode_collation_key(&root,&decomposed,8192,8192)
 assert(unicode_collation_key_status(&a)==0 && unicode_collation_key_status(&b)==0)
 assert(unicode_collation_key_compare(&a,&b).status==0)
 assert(unicode_collation_key_compare(&a,&b).order==0)
 let other=unicode_collation_key(&cldr,&composed,8192,8192)
 assert(unicode_collation_key_compare(&a,&other).status==7)
 unicode_collation_key_close(other)
 unicode_collation_key_close(a)
 unicode_collation_key_close(b)
 let budget=unicode_collation_key(&root,&composed,0,8192)
 assert(unicode_collation_key_status(&budget)==2)
 assert(unicode_collation_key_len(&budget)==0)
 unicode_collation_key_close(budget)
 utf8_text_close(composed)
 utf8_text_close(decomposed)
 let empty=utf8_text_new(0)
 var nul=utf8_text_new(1)
 assert(utf8_text_append_scalar(&!nul,0)==0)
 let empty_key=unicode_collation_key(&root,&empty,64,128)
 let nul_key=unicode_collation_key(&root,&nul,64,128)
 assert(unicode_collation_key_status(&empty_key)==0)
 assert(unicode_collation_key_status(&nul_key)==0)
 assert(unicode_collation_key_compare(&empty_key,&nul_key).order==0-1)
 unicode_collation_key_close(empty_key)
 unicode_collation_key_close(nul_key)
 utf8_text_close(empty)
 utf8_text_close(nul)
 print("UNICODE_COLLATION_ROOT_OK\n")
 0
}
