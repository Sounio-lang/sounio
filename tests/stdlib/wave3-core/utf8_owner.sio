//@ run-pass
//@ requires: madaros
//@ expect-stdout: UTF8_OWNER_OK
use collections::byte_buffer::{byte_buffer_new,byte_buffer_push,byte_buffer_get,byte_buffer_len,byte_buffer_close}
use text::utf8_scalar::{utf8_decode4}
use text::utf8::{utf8_text_new,utf8_text_from_bytes,utf8_text_from_string,utf8_text_status,utf8_text_byte_len,utf8_text_scalar_len,utf8_text_byte_at,utf8_text_next,utf8_text_append_bytes,utf8_text_copy_bytes,utf8_text_append_scalar,utf8_text_close,utf8_encode_append}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 assert(utf8_decode4(0,0,0,0,1,0).codepoint==0)
 assert(utf8_decode4(194,128,0,0,2,0).codepoint==128)
 assert(utf8_decode4(223,191,0,0,2,0).codepoint==2047)
 assert(utf8_decode4(224,160,128,0,3,0).codepoint==2048)
 assert(utf8_decode4(237,159,191,0,3,0).codepoint==55295)
 assert(utf8_decode4(238,128,128,0,3,0).codepoint==57344)
 assert(utf8_decode4(244,143,191,191,4,0).codepoint==1114111)
 assert(utf8_decode4(192,128,0,0,2,0).status==5)
 assert(utf8_decode4(224,128,128,0,3,0).status==5)
 assert(utf8_decode4(240,128,128,128,4,0).status==5)
 assert(utf8_decode4(194,65,0,0,2,0).status==5)
 assert(utf8_decode4(237,160,128,0,3,0).status==5)
 assert(utf8_decode4(244,144,128,128,4,0).status==5)
 assert(utf8_decode4(245,128,128,128,4,0).status==5)
 assert(utf8_decode4(240,159,0,0,2,0).status==5)
 var source=byte_buffer_new(40000)
 var i:i64=0
 while i<2000 {
  assert(utf8_encode_append(&!source,0)==0)
  assert(utf8_encode_append(&!source,233)==0)
  assert(utf8_encode_append(&!source,128512)==0)
  i=i+1
 }
 var t=utf8_text_from_bytes(&source,40000)
 byte_buffer_close(source)
 assert(utf8_text_status(&t)==0)
 assert(utf8_text_byte_len(&t)==14000)
 assert(utf8_text_scalar_len(&t)==6000)
 assert(utf8_text_byte_at(&t,0).value==0)
 assert(utf8_text_byte_at(&t,1).value==195)
 assert(utf8_text_byte_at(&t,14000).status==4)
 assert(utf8_text_next(&t,2).status==5)
 var offset:i64=0
 var count:i64=0
 while offset<utf8_text_byte_len(&t) {
  let scalar=utf8_text_next(&t,offset)
  assert(scalar.status==0)
  offset=scalar.next
  count=count+1
 }
 assert(count==6000)
 assert(utf8_text_next(&t,offset).status==4)
 var bad=byte_buffer_new(8)
 assert(byte_buffer_push(&!bad,192)==0)
 assert(byte_buffer_push(&!bad,128)==0)
 assert(utf8_text_append_bytes(&!t,&bad)==5)
 assert(utf8_text_byte_len(&t)==14000)
 assert(utf8_text_scalar_len(&t)==6000)
 byte_buffer_close(bad)
 assert(utf8_text_append_scalar(&!t,65)==0)
 assert(utf8_text_append_scalar(&!t,55296)==5)
 assert(utf8_text_scalar_len(&t)==6001)
 var out=byte_buffer_new(8)
 assert(byte_buffer_push(&!out,42)==0)
 assert(utf8_text_copy_bytes(&t,&!out)==2)
 assert(byte_buffer_len(&out)==1 && byte_buffer_get(&out,0).value==42)
 byte_buffer_close(out)
 var text=utf8_text_from_string("ok",2)
 assert(utf8_text_status(&text)==0 && utf8_text_scalar_len(&text)==2)
 assert(utf8_text_append_scalar(&!text,65)==2)
 assert(utf8_text_scalar_len(&text)==2)
 utf8_text_close(text)
 let empty=utf8_text_new(0)
 assert(utf8_text_status(&empty)==0 && utf8_text_scalar_len(&empty)==0)
 utf8_text_close(empty)
 utf8_text_close(t)
 print("UTF8_OWNER_OK\n")
 return 0
}

