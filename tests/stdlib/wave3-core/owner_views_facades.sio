//@ run-pass
//@ expect-stdout: OWNER_VIEWS_FACADES_OK
use core::lib::{Result}
use collections::byte_buffer::{byte_buffer_new,byte_buffer_push,byte_buffer_close}
use collections::lib::{ByteView,byte_view_get,byte_view_slice}
use collections::mod::{byte_view_new,byte_view_len}
use text::utf8::{utf8_text_from_bytes,utf8_text_close}
use text::mod::{Utf8View,utf8_view_new,utf8_view_byte_at,utf8_view_slice}
use text::lib::{utf8_view_byte_len,utf8_view_next,utf8_view_scalar_len}
fn byte_len(view:&ByteView)->i64 {byte_view_len(view)}
fn text_len(view:&Utf8View)->i64 {utf8_view_byte_len(view)}
fn main() with IO,Alloc,Mut,Div,Panic {
 var owner=byte_buffer_new(1)
 assert(byte_buffer_push(&!owner,0)==0)
 match byte_view_new(&owner,0,1) {
  Result::Ok(view)=>{
   assert(byte_len(&view)==1)
   let byte=byte_view_get(&view,0)
   assert(byte.status==0 && byte.value==0)
   match byte_view_slice(&view,0,1) {
    Result::Ok(part)=>{assert(byte_len(&part)==1)},
    Result::Err(code)=>{assert(code==0)},
   }
  },
  Result::Err(code)=>{assert(code==0)},
 }
 let text=utf8_text_from_bytes(&owner,1)
 match utf8_view_new(&text,0,1) {
  Result::Ok(view)=>{
   assert(text_len(&view)==1)
   assert(utf8_view_scalar_len(&view)==1)
   let byte=utf8_view_byte_at(&view,0)
   assert(byte.status==0 && byte.value==0)
   let scalar=utf8_view_next(&view,0)
   assert(scalar.status==0 && scalar.codepoint==0 && scalar.next==1)
   match utf8_view_slice(&view,0,1) {
    Result::Ok(part)=>{assert(text_len(&part)==1)},
    Result::Err(code)=>{assert(code==0)},
   }
  },
  Result::Err(code)=>{assert(code==0)},
 }
 utf8_text_close(text)
 byte_buffer_close(owner)
 println("OWNER_VIEWS_FACADES_OK")
}
