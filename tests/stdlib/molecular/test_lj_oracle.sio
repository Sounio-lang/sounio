//@ run-pass
//@ expect-stdout: MOLECULAR_LJ_ORACLE_OK

// molecular::lj::mol_total_energy_virial against the independent long-double
// C++ reference in stdlib/molecular/oracles/lj_config_oracle.cpp, on the same
// jittered-grid configuration (N = 400, box 10, cutoff 3). The two constants
// below are that program's output, pasted, not values this code produced.
use molecular::lj::*

fn ae(a: f64, b: f64) -> f64 { if a > b { a - b } else { b - a } }

fn main() -> i32 with IO, Mut, Div, Panic {
    var pos: [f64; 3072] = [0.0; 3072]
    var s: i64 = 20261113
    var i: i64 = 0
    while i < 400 {
        var k: i64 = 0
        while k < 3 {
            s = (1103515245 * s + 12345) % 2147483648
            let v = (s as f64) / 2147483648.0
            var site = i % 8
            if k == 1 { site = (i / 8) % 8 }
            if k == 2 { site = i / 64 }
            pos[(3 * i + k) as usize] = ((site as f64) + 0.5) * 1.25 + 0.3 * (v - 0.5)
            k = k + 1
        }
        i = i + 1
    }
    let (u, w) = mol_total_energy_virial(&pos, 400, 10.0, 3.0)
    let u_ref = 0.0 - 1183.39455489403486
    let w_ref = 0.0 - 3470.84541813209606
    print("U  sounio = "); println(u)
    print("U  oracle = "); println(u_ref)
    print("W  sounio = "); println(w)
    print("W  oracle = "); println(w_ref)
    // f64 summation of ~22000 terms against long double: 1e-11 relative.
    if ae(u, u_ref) > 1.0e-11 * ae(u_ref, 0.0) { print("FAIL U\n"); return 1 }
    if ae(w, w_ref) > 1.0e-11 * ae(w_ref, 0.0) { print("FAIL W\n"); return 2 }
    print("MOLECULAR_LJ_ORACLE_OK\n")
    return 0
}
