//@ run-pass
//@ requires: madaros
//@ expect-stdout: MOLECULAR_HOST_GUEST_ORACLE_OK

// molecular::host_guest against the independent long-double C++ reference in
// stdlib/molecular/oracles/host_guest_oracle.cpp: the sII lattice (group order,
// orbit sizes, coordination, cage shells), the guest-host field and its two
// parameter gradients at three points, and the guest-guest pair. The reference
// numbers below are that program's output, pasted.
// Model: SPC/E oxygen (78.20 K, 3.166 A), Buch H2 (34.2 K, 2.96 A), 250 K,
// a = 17.31 A, cutoff 12 A.
use molecular::host_guest::*

fn ae(a: f64, b: f64) -> f64 { if a > b { a - b } else { b - a } }

fn rel_ok(got: f64, want: f64, tol: f64) -> bool { ae(got, want) <= tol * ae(want, 0.0) + 1.0e-12 }

fn check(name: string, got: f64, want: f64) -> i64 with IO {
    print(name)
    print(" ")
    println(got)
    if rel_ok(got, want, 1.0e-10) { return 0 }
    print("  FAIL, oracle ")
    println(want)
    1
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var bad: i64 = 0
    let a = 17.31
    let nops = hg_build_fd3m()
    if nops != 192 { print("FAIL group order\n"); return 1 }
    var frac: [f64; 12288] = [0.0; 12288]
    let no = hg_sii_oxygens(&!frac, 0.21796, 0.18198, 0.37081)
    if no != 136 { print("FAIL oxygens\n"); return 2 }
    var host: [f64; 12288] = [0.0; 12288]
    let nh = hg_replicate(&!host, &frac, no, a, 12.0)
    if nh != 3672 { print("FAIL sites\n"); return 3 }
    // every home-cell oxygen has exactly four neighbours in 2.6..2.9 A
    var i: i64 = 0
    var badc: i64 = 0
    while i < no {
        let x = a * frac[(3 * i) as usize]
        let y = a * frac[(3 * i + 1) as usize]
        let z = a * frac[(3 * i + 2) as usize]
        var c: i64 = 0
        var k: i64 = 0
        while k < nh {
            let dx = x - host[(3 * k) as usize]
            let dy = y - host[(3 * k + 1) as usize]
            let dz = z - host[(3 * k + 2) as usize]
            let r2 = dx * dx + dy * dy + dz * dz
            if r2 > 0.01 && r2 < 3.2 * 3.2 {
                if r2 < 2.6 * 2.6 || r2 > 2.9 * 2.9 { badc = badc + 1 }
                c = c + 1
            }
            k = k + 1
        }
        if c != 4 { badc = badc + 1 }
        i = i + 1
    }
    if badc != 0 { print("FAIL coordination\n"); return 4 }
    print("lattice: 192 operations, 136 oxygens, 3672 sites, all 4-coordinated\n")
    var cen: [f64; 192] = [0.0; 192]
    let nc = hg_sii_cages(&!cen, a)
    if nc != 24 { print("FAIL cages\n"); return 5 }
    // shell sizes: 20 oxygens within 5.3 A of a small-cage centre, 28 of a large one
    var t: i64 = 0
    while t < 2 {
        let ci = if t == 0 { 0 } else { 16 }
        var c: i64 = 0
        var k: i64 = 0
        while k < nh {
            let dx = cen[(3 * ci) as usize] - host[(3 * k) as usize]
            let dy = cen[(3 * ci + 1) as usize] - host[(3 * k + 1) as usize]
            let dz = cen[(3 * ci + 2) as usize] - host[(3 * k + 2) as usize]
            if dx * dx + dy * dy + dz * dz < 5.3 * 5.3 { c = c + 1 }
            k = k + 1
        }
        if (t == 0 && c != 20) || (t == 1 && c != 28) { print("FAIL cage shell\n"); return 6 }
        t = t + 1
    }
    print("cages: 16 small (20 O), 8 large (28 O)\n")
    let eps = sqrt(78.20 * 34.2)
    let sig = 0.5 * (3.166 + 2.96)
    let lam = 0.0040105507372702378
    let rho = 0.02622090667229109
    let (w1, e1, s1) = hg_field(&host, nh, 0.3, 0.2, 0.0 - 0.1, eps, sig, 34.2, lam, 12.0, rho)
    bad = bad + check("w1", w1, 0.0 - 818.51503924985482)
    bad = bad + check("dw1/deH", e1, 0.0 - 11.966594141079748)
    bad = bad + check("dw1/dsH", s1, 0.0 - 515.63401014152956)
    let (w2, e2, s2) = hg_field(&host, nh, 6.4, 6.6, 6.3, eps, sig, 34.2, lam, 12.0, rho)
    bad = bad + check("w2", w2, 0.0 - 492.61930927940258)
    bad = bad + check("dw2/deH", e2, 0.0 - 7.2020366853713821)
    bad = bad + check("dw2/dsH", s2, 0.0 - 443.54643012601625)
    let (w3, e3, s3) = hg_field(&host, nh, 1.0, 8.0, 15.5, eps, sig, 34.2, lam, 12.0, rho)
    bad = bad + check("w3", w3, 1594219.647158507)
    bad = bad + check("dw3/deH", e3, 23307.304783019107)
    bad = bad + check("dw3/dsH", s3, 3144001.7661599085)
    let (u, ue, us) = hg_pair_r2(3.3 * 3.3, 34.2, 2.96, 0.0080211014745404756, 8.655 * 8.655)
    bad = bad + check("u_pair", u, 0.0 - 32.107675280508205)
    bad = bad + check("du/deH", ue, 0.0 - 0.93882091463474276)
    bad = bad + check("du/dsH", us, 17.439829681550383)
    if bad != 0 { return 7 }
    print("MOLECULAR_HOST_GUEST_ORACLE_OK\n")
    0
}
