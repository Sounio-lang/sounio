// Materialized with four exact original conformance harnesses.
// Explicit user argv: 1 Unicode/UCA, 2 CLDR keys, 3 metadata, 4 BIDI.
use coherent_unicode::{coherent_run_unicode}
use coherent_locale::{coherent_run_locale}
use coherent_metadata::{coherent_run_metadata}
use coherent_bidi::{coherent_run_bidi}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 if arg_count()!=1 {return 64}
 let name=get_arg(0)
 if str_len(name)!=1 {return 64}
 let kind=str_char_at(name,0)
 if kind==49 {assert(coherent_run_unicode()==0)}
 else if kind==50 {assert(coherent_run_locale()==0)}
 else if kind==51 {coherent_run_metadata()}
 else if kind==52 {assert(coherent_run_bidi()==0)}
 else {return 64}
 0
}
