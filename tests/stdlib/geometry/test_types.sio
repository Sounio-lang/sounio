//@ ignore
//@ reason: outdated API — Point2D::new, Vec2, Vec3, Matrix3 not exported from geometry::types
//! tests/stdlib/geometry/test_types.sio
//!
//! Teste run-pass para geometry/types.sio: construtores e ops básicas.

import geometry::types::*;
import epistemic::Knowledge;

// Assume Sounio has assert_eq or similar. Use simple checks with print for run-pass.
fn main() -> void {
    // Test Point2D
    let p1 = Point2D::new(1.0, 2.0);
    let p2 = Point2D::new(3.0, 4.0);
    let sum_p = p1.add(p2);
    // Assume Knowledge has .value for comparison, but for test, construct expected
    let expected_sum_x = Knowledge::known(4.0);
    let expected_sum_y = Knowledge::known(6.0);
    // For run-pass, assume no panic, print success
    std::print("Point2D add: {} {}", sum_p.x.value(), sum_p.y.value()); // assume .value()
    assert_eq(sum_p.x, expected_sum_x); // assume assert_eq and == for Knowledge

    let dot_p = p1.dot(p2);
    std::print("Point2D dot: {}", dot_p.value()); // 1*3 + 2*4 = 11

    // Test Vec2
    let v1 = Vec2::new(1.0, 0.0);
    let v2 = Vec2::new(0.0, 1.0);
    let dot_v = v1.dot(v2);
    std::print("Vec2 dot perpendicular: {}", dot_v.value()); // 0

    // Test Vec3 cross
    let vv1 = Vec3::new(1.0, 0.0, 0.0);
    let vv2 = Vec3::new(0.0, 1.0, 0.0);
    let cross = vv1.cross(vv2);
    std::print("Vec3 cross i x j = k: {} {} {}", cross.x.value(), cross.y.value(), cross.z.value()); // 0 0 1

    // Test Matrix3
    let id = Matrix3::identity();
    std::print("Matrix3 identity ok");

    std::print("TODOS OS TESTES PASSARAM!");
}