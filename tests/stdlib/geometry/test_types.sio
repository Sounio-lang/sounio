//@ run-pass
// Teste de stdlib/geometry/types.sio — construtores e operações.
//
// 🚨 REESCRITO em 29-ago-2026. O arquivo anterior NÃO ERA SOUNIO: usava `import` (Sounio usa
// `use`), `fn main() -> void` (não existe), `std::print("... {} ...", a, b)` no estilo Rust,
// `Point2D::new(...)` com sintaxe de método, `.value()` em campos que são f64 puro, e
// `Vec2`/`Vec3`, que não existem — os tipos são `Point2D` e `Point3D`. Os próprios comentários
// diziam "assume assert_eq", "assume .value()".
//
// Ele estava marcado `run-pass` e PASSAVA, porque o compilador aceitava em silêncio todo nome
// desconhecido e emitia `xor eax,eax`. Achado pelo E201.
//
// A API real é de funções livres: point2d_new/add/sub/dot, point3d_*, matrix3_identity/mul_vec.

use geometry::types::*

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn perto(a: f64, b: f64) -> bool { abs_f64(a - b) < 0.000001 }

fn main() -> i64 with IO, Mut {
    var falhas: i64 = 0

    // Point2D: soma componente a componente
    let p1 = point2d_new(1.0, 2.0)
    let p2 = point2d_new(3.0, 4.0)
    let soma = point2d_add(p1, p2)
    if !perto(soma.x, 4.0) { println("FALHA: soma.x"); falhas = falhas + 1 }
    if !perto(soma.y, 6.0) { println("FALHA: soma.y"); falhas = falhas + 1 }

    // Point2D: subtração
    let dif = point2d_sub(p2, p1)
    if !perto(dif.x, 2.0) { println("FALHA: dif.x"); falhas = falhas + 1 }
    if !perto(dif.y, 2.0) { println("FALHA: dif.y"); falhas = falhas + 1 }

    // Point2D: produto escalar 1*3 + 2*4 = 11
    if !perto(point2d_dot(p1, p2), 11.0) { println("FALHA: dot 2D"); falhas = falhas + 1 }

    // Point3D: produto vetorial i × j = k
    let i3 = point3d_new(1.0, 0.0, 0.0)
    let j3 = point3d_new(0.0, 1.0, 0.0)
    let k3 = point3d_cross(i3, j3)
    if !perto(k3.x, 0.0) { println("FALHA: cross.x"); falhas = falhas + 1 }
    if !perto(k3.y, 0.0) { println("FALHA: cross.y"); falhas = falhas + 1 }
    if !perto(k3.z, 1.0) { println("FALHA: cross.z"); falhas = falhas + 1 }

    // Produto escalar de ortogonais é zero
    if !perto(point3d_dot(i3, j3), 0.0) { println("FALHA: dot ortogonal"); falhas = falhas + 1 }

    // Matrix3 identidade não move o vetor
    let id = matrix3_identity()
    let v = point3d_new(2.0, 3.0, 5.0)
    let vv = matrix3_mul_vec(id, v)
    if !perto(vv.x, 2.0) { println("FALHA: I*v x"); falhas = falhas + 1 }
    if !perto(vv.y, 3.0) { println("FALHA: I*v y"); falhas = falhas + 1 }
    if !perto(vv.z, 5.0) { println("FALHA: I*v z"); falhas = falhas + 1 }

    if falhas == 0 { println("geometry types: PASS") } else { println("geometry types: FAIL") }
    falhas
}
