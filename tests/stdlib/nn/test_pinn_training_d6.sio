//@ run-pass
//@ expect-stdout: D6_PINN_TRAINING_LOOP_PASS

use tensor::ops::{
    tensor_scalar,
    tensor_free,
}
use nn::optimizer::{
    param_store_new,
    param_store_register,
    param_store_free,
    adam_new,
}
use nn::pinn::{
    pinn_integer_1comp_sanity,
    pinn_fractional_1comp_sanity,
}

fn d6_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 with Alloc, IO, Mut, Panic, Div {
    println("d6:integer")
    var k = tensor_scalar(0.05)
    var store = param_store_new()
    let k_idx = param_store_register(&!store, &!k, -1)
    var opt = adam_new(0.01)
    let result = pinn_integer_1comp_sanity(&!store, &!opt, k_idx)
    assert(result.steps == 3000 as usize)
    assert(result.l2 < 1.0e-3)
    assert(d6_abs(result.learned_k - 0.1) < 5.0e-3)
    param_store_free(&!store)
    tensor_free(&!k)

    println("d6:fractional")
    var k2 = tensor_scalar(0.05)
    var store2 = param_store_new()
    let k2_idx = param_store_register(&!store2, &!k2, -1)
    var opt2 = adam_new(0.01)
    let result2 = pinn_fractional_1comp_sanity(&!store2, &!opt2, k2_idx)
    assert(result2.steps == 5000 as usize)
    assert(result2.l2 < 0.05)
    assert(d6_abs(result2.learned_k - 0.1) < 2.0e-2)

    param_store_free(&!store2)
    tensor_free(&!k2)
    println("D6_PINN_TRAINING_LOOP_PASS")
    return 0
}
