//@ run-pass
// tests/stdlib/nn/test_autograd_v2.sio
//
// Validates reverse-mode automatic differentiation via the Wengert tape.
//
// Tests:
//   1. Linear:     f(x) = 3x + 2,          df/dx = 3
//   2. Quadratic:  f(x) = x^2,             df/dx = 2x → at x=3, grad=6
//   3. Product:    f(x,y) = x*y,           ∂f/∂x = y, ∂f/∂y = x
//   4. Chain rule: f(x) = sin(x^2),        df/dx = 2x·cos(x^2)
//   5. Sigmoid:    σ'(x) = σ(x)·(1-σ(x))
//   6. Division:   f(x,y) = x/y,           ∂f/∂x = 1/y, ∂f/∂y = -x/y^2
//   7. Composite:  f(x) = exp(2x+1),       df/dx = 2·exp(2x+1)
//   8. ReLU:       f(x) = relu(x),         df/dx = 1 for x>0, 0 for x<0

use nn::autograd_v2::{
    Tape,
    AD2_VAR, AD2_ADD, AD2_MUL, AD2_SUB, AD2_DIV,
    AD2_NEG, AD2_EXP, AD2_LOG, AD2_SIN, AD2_COS,
    AD2_RELU, AD2_SIGMOID, AD2_TANH, AD2_POW,
    AD2_MUL_CONST, AD2_ADD_CONST,
    tape_new, tape_var, tape_const,
    tape_add, tape_sub, tape_mul, tape_div,
    tape_neg, tape_exp, tape_log,
    tape_sin, tape_cos,
    tape_relu, tape_sigmoid, tape_tanh,
    tape_mul_const, tape_pow_const, tape_add_const,
    tape_backward,
    tape_value, tape_grad,
}

// ---------------------------------------------------------------------------
// Tolerance helper
// ---------------------------------------------------------------------------

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

// ---------------------------------------------------------------------------
// Test 1: Linear f(x) = 3x + 2, df/dx = 3
// ---------------------------------------------------------------------------

fn test_linear() -> i32 with Mut, Div, Panic {
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 5.0)
    let (zi, t2) = tape_mul_const(t1, xi, 3.0)
    let (oi, t3) = tape_add_const(t2, zi, 2.0)
    let t4 = tape_backward(t3, oi)

    // f(5) = 17
    if !near(tape_value(&t4, oi), 17.0, 0.0001) { return 1 }
    // df/dx = 3
    if !near(tape_grad(&t4, xi), 3.0, 0.0001) { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Test 2: Quadratic f(x) = x^2, df/dx = 2x → at x=3, grad=6
// ---------------------------------------------------------------------------

fn test_quadratic() -> i32 with Mut, Div, Panic {
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 3.0)
    // x^2 = x * x
    let (oi, t2) = tape_mul(t1, xi, xi)
    let t3 = tape_backward(t2, oi)

    // f(3) = 9
    if !near(tape_value(&t3, oi), 9.0, 0.0001) { return 1 }
    // df/dx = 2*3 = 6
    if !near(tape_grad(&t3, xi), 6.0, 0.0001) { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Test 3: Product rule f(x,y) = x*y, ∂f/∂x = y, ∂f/∂y = x
// ---------------------------------------------------------------------------

fn test_product_rule() -> i32 with Mut, Div, Panic {
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 4.0)
    let (yi, t2) = tape_var(t1, 7.0)
    let (oi, t3) = tape_mul(t2, xi, yi)
    let t4 = tape_backward(t3, oi)

    // f(4,7) = 28
    if !near(tape_value(&t4, oi), 28.0, 0.0001) { return 1 }
    // ∂f/∂x = y = 7
    if !near(tape_grad(&t4, xi), 7.0, 0.0001) { return 1 }
    // ∂f/∂y = x = 4
    if !near(tape_grad(&t4, yi), 4.0, 0.0001) { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Test 4: Chain rule f(x) = sin(x^2), df/dx = 2x·cos(x^2)
// ---------------------------------------------------------------------------

fn test_chain_rule() -> i32 with Mut, Div, Panic {
    // x = 1.0
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 1.0)
    let (x2i, t2) = tape_mul(t1, xi, xi)     // x^2
    let (oi, t3) = tape_sin(t2, x2i)          // sin(x^2)
    let t4 = tape_backward(t3, oi)

    // Expected grad: 2*1*cos(1^2) = 2*cos(1) ≈ 2*0.5403 = 1.0806
    let expected = 2.0 * 0.5403023058681398
    if !near(tape_grad(&t4, xi), expected, 0.001) { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Test 5: Sigmoid gradient σ'(x) = σ(x)·(1-σ(x))
// ---------------------------------------------------------------------------

fn test_sigmoid_grad() -> i32 with Mut, Div, Panic {
    // x = 0.0 → σ(0) = 0.5, σ'(0) = 0.25
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 0.0)
    let (oi, t2) = tape_sigmoid(t1, xi)
    let t3 = tape_backward(t2, oi)

    if !near(tape_value(&t3, oi), 0.5, 0.0001) { return 1 }
    if !near(tape_grad(&t3, xi), 0.25, 0.0001) { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Test 6: Division f(x,y) = x/y, ∂f/∂x = 1/y, ∂f/∂y = -x/y^2
// ---------------------------------------------------------------------------

fn test_division() -> i32 with Mut, Div, Panic {
    // x=6, y=3 → f=2, ∂f/∂x=1/3, ∂f/∂y=-6/9=-2/3
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 6.0)
    let (yi, t2) = tape_var(t1, 3.0)
    let (oi, t3) = tape_div(t2, xi, yi)
    let t4 = tape_backward(t3, oi)

    if !near(tape_value(&t4, oi), 2.0, 0.0001) { return 1 }
    if !near(tape_grad(&t4, xi), 0.33333, 0.0001) { return 1 }
    if !near(tape_grad(&t4, yi), 0.0 - 0.66666, 0.0001) { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Test 7: Composite f(x) = exp(2x+1), df/dx = 2·exp(2x+1)
// ---------------------------------------------------------------------------

fn test_composite_exp() -> i32 with Mut, Div, Panic {
    // x = 0 → f = exp(1) ≈ 2.71828, df/dx = 2*exp(1) ≈ 5.43656
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 0.0)
    let (zx, t2) = tape_mul_const(t1, xi, 2.0)  // 2x
    let (zb, t3) = tape_add_const(t2, zx, 1.0)  // 2x + 1
    let (oi, t4) = tape_exp(t3, zb)               // exp(2x + 1)
    let t5 = tape_backward(t4, oi)

    let e1 = 2.718281828459045
    if !near(tape_value(&t5, oi), e1, 0.001) { return 1 }
    if !near(tape_grad(&t5, xi), 2.0 * e1, 0.001) { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Test 8: ReLU gradient: df/dx = 1 for x>0, 0 for x<0
// ---------------------------------------------------------------------------

fn test_relu_grad() -> i32 with Mut, Div, Panic {
    // Positive input: x=2, f(x)=2, df/dx=1
    let t0 = tape_new()
    let (xi, t1) = tape_var(t0, 2.0)
    let (oi, t2) = tape_relu(t1, xi)
    let t3 = tape_backward(t2, oi)

    if !near(tape_value(&t3, oi), 2.0, 0.0001) { return 1 }
    if !near(tape_grad(&t3, xi), 1.0, 0.0001) { return 1 }

    // Negative input: x=-3, f(x)=0, df/dx=0
    let t10 = tape_new()
    let (xi2, t11) = tape_var(t10, 0.0 - 3.0)
    let (oi2, t12) = tape_relu(t11, xi2)
    let t13 = tape_backward(t12, oi2)

    if !near(tape_value(&t13, oi2), 0.0, 0.0001) { return 1 }
    if !near(tape_grad(&t13, xi2), 0.0, 0.0001) { return 1 }

    return 0
}

// ---------------------------------------------------------------------------
// Runner
// ---------------------------------------------------------------------------

fn main() -> i32 with Mut, Div, Panic {
    var fail = 0

    if test_linear() != 0 { fail = fail + 1 }
    if test_quadratic() != 0 { fail = fail + 1 }
    if test_product_rule() != 0 { fail = fail + 1 }
    if test_chain_rule() != 0 { fail = fail + 1 }
    if test_sigmoid_grad() != 0 { fail = fail + 1 }
    if test_division() != 0 { fail = fail + 1 }
    if test_composite_exp() != 0 { fail = fail + 1 }
    if test_relu_grad() != 0 { fail = fail + 1 }

    return fail
}
