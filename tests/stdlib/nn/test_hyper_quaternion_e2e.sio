//@ run-pass
//@ expect-stdout: HYPER_NN_OK

use nn::quaternion::*

fn emit_metric(name: string, value: f64) with IO {
    print("HYPER_METRIC nn ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("HYPER_NN_START\n")

    let q = quaternion_exact(1.0, 2.0, 3.0, 4.0)
    let sum = quaternion_add(q, q)
    let prod = quaternion_mul(quaternion_identity(), q)
    let diff = quaternion_sub(q, quaternion_zero())

    // Norm squared: 1+4+9+16 = 30
    let nsq = quaternion_norm_squared(q)

    emit_metric("sum_w", quaternion_get_w(sum))
    emit_metric("prod_x", quaternion_get_x(prod))
    emit_metric("diff_w", quaternion_get_w(diff))
    emit_metric("norm_sq", nsq.value)

    // sum of q+q: w=2
    if quaternion_get_w(sum) != 2.0 { return 2 }
    // prod: identity * q = q, so x = 2.0
    if quaternion_get_x(prod) != 2.0 { return 3 }
    // diff: q - 0 = q, so w = 1.0
    if quaternion_get_w(diff) != 1.0 { return 4 }

    print("HYPER_NN_OK\n")
    0
}
