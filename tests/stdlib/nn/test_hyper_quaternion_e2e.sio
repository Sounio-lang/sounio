//@ run-pass
//@ expect-stdout: HYPER_NN_OK

use nn::quaternion::*
use nn::dense_quaternion::*
use nn::optimizers_quaternion::*

fn emit_metric(name: string, value: f64) with IO {
    print("HYPER_METRIC nn ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    print("HYPER_NN_START\n")

    let q = quaternion_exact(1.0, 2.0, 3.0, 4.0)
    let sum = quaternion_add(q, q)
    let prod = quaternion_mul(quaternion_identity(), q)

    var layer = dense_quaternion_new(1, 1, ActivationFunction::None)
    layer = dense_quaternion_set_weight(layer, quaternion_identity())
    layer = dense_quaternion_set_bias(layer, quaternion_zero())
    let out = dense_quaternion_forward(layer, q)

    let opt = adam_quaternion_default()
    let optimizer_ok = adam_quaternion_beta1(opt) > 0.0

    emit_metric("sum_w", quaternion_get_w(sum))
    emit_metric("prod_x", quaternion_get_x(prod))
    emit_metric("dense_w", quaternion_get_w(out))
    emit_metric("optimizer_contract_ok", if optimizer_ok { 1.0 } else { 0.0 })

    if quaternion_get_w(sum) != 2.0 { return 2 }
    if quaternion_get_x(prod) != 2.0 { return 3 }
    if quaternion_get_w(out) != 1.0 { return 4 }

    print("HYPER_NN_OK\n")
    0
}
