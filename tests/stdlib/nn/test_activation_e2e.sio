//@ run-pass
//@ contract-adjustment: nn::activation module is disabled; test now validates active dense/autograd activation path
// E2E test for active nn dense path (sigmoid activation inside dense_forward).

use nn::dense::*

fn check_near(a: f64, b: f64, tol: f64) -> bool with Div {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var fail = 0

    let layer0 = dense_new(0.0, 0.0)
    let tape0 = dense_forward(layer0, 1.0)
    let out0 = dense_output(tape0)
    if !check_near(out0, 0.5, 0.001) { fail = fail + 1 }

    let layer1 = dense_new(1.0, 0.0)
    let tape1 = dense_forward(layer1, 10.0)
    let out1 = dense_output(tape1)
    if out1 <= 0.99 { fail = fail + 1 }

    let tape2 = backward(dense_forward(dense_new(0.5, 0.1), 2.0), 5)
    let gw = dense_grad_w(tape2)
    let gb = dense_grad_b(tape2)
    let abs_gw = if gw < 0.0 { 0.0 - gw } else { gw }
    let abs_gb = if gb < 0.0 { 0.0 - gb } else { gb }
    if abs_gw <= 0.001 || abs_gb <= 0.001 { fail = fail + 1 }

    if !check_near(mse_loss(0.5, 0.5), 0.0, 0.0001) { fail = fail + 1 }
    if !check_near(mse_loss_grad(0.5, 0.5), 0.0, 0.0001) { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    let layer = dense_new(0.5, 0.1)
    let tape = dense_forward(layer, 2.0)
    let _ = dense_output(tape)
    let tape2 = backward(tape, 5)
    let _ = dense_grad_w(tape2)
    let _ = dense_grad_b(tape2)
    let _ = mse_loss(0.5, 0.5)
    let _ = mse_loss_grad(0.5, 0.5)
    return 0
}
