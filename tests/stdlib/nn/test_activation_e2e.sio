//@ run-pass
// E2E test for stdlib/nn/activation
//
// Tests relu, sigmoid, tanh_val, leaky_relu, and softplus
// with known inputs and expected outputs.

use nn::activation::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: relu(1.0) = 1.0
    print("Test 1: relu(1.0)=1.0... ")
    if check_near(relu(1.0), 1.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: relu(-1.0) = 0.0
    print("Test 2: relu(-1.0)=0.0... ")
    if check_near(relu(0.0 - 1.0), 0.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: sigmoid(0.0) = 0.5
    print("Test 3: sigmoid(0.0)=0.5... ")
    if check_near(sigmoid(0.0), 0.5, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: tanh_val(0.0) = 0.0
    print("Test 4: tanh_val(0.0)=0.0... ")
    if check_near(tanh_val(0.0), 0.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: sigmoid_deriv(0.0) = 0.25
    // sigmoid'(0) = sigmoid(0) * (1 - sigmoid(0)) = 0.5 * 0.5 = 0.25
    print("Test 5: sigmoid_deriv(0.0)=0.25... ")
    if check_near(sigmoid_deriv(0.0), 0.25, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 6: leaky_relu(-2.0, 0.01) = -0.02
    print("Test 6: leaky_relu(-2.0, 0.01)... ")
    if check_near(leaky_relu(0.0 - 2.0, 0.01), 0.0 - 0.02, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 7: swish(0.0) = 0.0 * sigmoid(0.0) = 0.0
    print("Test 7: swish(0.0)=0.0... ")
    if check_near(swish(0.0), 0.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
