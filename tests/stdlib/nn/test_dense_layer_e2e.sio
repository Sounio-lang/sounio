//@ run-pass
//! tests/stdlib/nn/test_dense_layer_e2e.sio
//!
//! E2E tests for nn::dense_layer Vec4 operations and activation functions.
//! Note: Mat4x4 multiply and DenseLayer4 forward tests require compiler
//! support for large-struct parameters (>8 fields) alongside other struct
//! parameters — a known codegen limitation tracked separately.

use nn::dense_layer::{
    Vec4,
    vec4_new, vec4_zero, vec4_ones, vec4_add, vec4_scale, vec4_dot,
    vec4_apply_activation,
}
use test::helpers::{check_near}

// ============================================================================
// Vec4 operations
// ============================================================================

fn test_vec4_zero() with Mut, Div, Panic {
    let v = vec4_zero()
    assert(check_near(v.e0, 0.0, 1e-9))
    assert(check_near(v.e1, 0.0, 1e-9))
    assert(check_near(v.e2, 0.0, 1e-9))
    assert(check_near(v.e3, 0.0, 1e-9))
}

fn test_vec4_ones() with Mut, Div, Panic {
    let v = vec4_ones()
    assert(check_near(v.e0, 1.0, 1e-9))
    assert(check_near(v.e3, 1.0, 1e-9))
}

fn test_vec4_new() with Mut, Div, Panic {
    let v = vec4_new(1.0, 2.0, 3.0, 4.0)
    assert(check_near(v.e0, 1.0, 1e-9))
    assert(check_near(v.e1, 2.0, 1e-9))
    assert(check_near(v.e2, 3.0, 1e-9))
    assert(check_near(v.e3, 4.0, 1e-9))
}

fn test_vec4_add() with Mut, Div, Panic {
    let a = vec4_new(1.0, 2.0, 3.0, 4.0)
    let b = vec4_new(5.0, 6.0, 7.0, 8.0)
    let c = vec4_add(a, b)
    assert(check_near(c.e0, 6.0, 1e-9))
    assert(check_near(c.e1, 8.0, 1e-9))
    assert(check_near(c.e2, 10.0, 1e-9))
    assert(check_near(c.e3, 12.0, 1e-9))
}

fn test_vec4_scale() with Mut, Div, Panic {
    let v = vec4_new(1.0, 2.0, 3.0, 4.0)
    let s = vec4_scale(v, 2.0)
    assert(check_near(s.e0, 2.0, 1e-9))
    assert(check_near(s.e3, 8.0, 1e-9))
}

fn test_vec4_dot() with Mut, Div, Panic {
    // [1,2,3,4] · [1,0,0,0] = 1
    let a = vec4_new(1.0, 2.0, 3.0, 4.0)
    let b = vec4_new(1.0, 0.0, 0.0, 0.0)
    assert(check_near(vec4_dot(a, b), 1.0, 1e-9))
    // [1,2,3,4] · [1,1,1,1] = 10
    let ones = vec4_ones()
    assert(check_near(vec4_dot(a, ones), 10.0, 1e-9))
}

// ============================================================================
// Activation functions via vec4_apply_activation
// ============================================================================

fn test_relu_positive() with Mut, Div, Panic {
    // ReLU(1) = 1
    let v = vec4_new(1.0, 2.0, 0.0 - 1.0, 0.0)
    let out = vec4_apply_activation(v, 1)
    assert(check_near(out.e0, 1.0, 1e-9))
    assert(check_near(out.e1, 2.0, 1e-9))
    assert(check_near(out.e2, 0.0, 1e-9))   // ReLU(-1) = 0
}

fn test_sigmoid_activation() with Mut, Div, Panic {
    // Sigmoid(0) = 0.5
    let v = vec4_new(0.0, 0.0, 0.0, 0.0)
    let out = vec4_apply_activation(v, 2)
    assert(check_near(out.e0, 0.5, 1e-4))
}

fn test_identity_activation() with Mut, Div, Panic {
    let v = vec4_new(1.5, 2.5, 3.5, 4.5)
    let out = vec4_apply_activation(v, 4)
    assert(check_near(out.e0, 1.5, 1e-9))
    assert(check_near(out.e3, 4.5, 1e-9))
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with Mut, Div, Panic {
    test_vec4_zero()
    test_vec4_ones()
    test_vec4_new()
    test_vec4_add()
    test_vec4_scale()
    test_vec4_dot()
    test_relu_positive()
    test_sigmoid_activation()
    test_identity_activation()
}
