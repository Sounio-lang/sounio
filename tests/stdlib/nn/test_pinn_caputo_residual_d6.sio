//@ run-pass
//@ expect-stdout: D6_PINN_CAPUTO_RESIDUAL_PASS

use tensor::types::{
    shape1,
}
use tensor::ops::{
    tensor_zeros,
    tensor_free,
}
use tensor::tape::{
    tape_begin,
    tape_drop,
    tape_leaf,
    tape_backward,
    tape_value_at,
    tape_grad_at,
}
use nn::pinn::{
    pinn_fractional_residual_taped,
    pinn_fill_fractional_history,
}

fn d6_resid_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 with Alloc, IO, Mut, Panic, Div {
    var history = tensor_zeros(shape1(20 as usize))
    pinn_fill_fractional_history(&!history, 1.0, 0.1, 0.8, 0.1)
    var tape = tape_begin()
    let hid = tape_leaf(&!tape, &history, true)
    let resid = pinn_fractional_residual_taped(&history, hid, 0.1, 0.8, 0.1, &!tape)
    tape_backward(&!tape, resid)

    assert(d6_resid_abs(tape_value_at(&tape, resid, 0 as usize)) < 0.1)
    var norm = 0.0
    var i: usize = 0 as usize
    while i < history.shape.len {
        let g = tape_grad_at(&tape, hid, i)
        norm = norm + g * g
        i = i + 1 as usize
    }
    assert(norm > 1.0e-12)

    tape_drop(&!tape)
    tensor_free(&!history)
    println("D6_PINN_CAPUTO_RESIDUAL_PASS")
    return 0
}
