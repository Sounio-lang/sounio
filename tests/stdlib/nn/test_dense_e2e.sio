//@ run-pass
//@ contract-adjustment: canonical lane covers stable dense forward/update/loss surface; backward gradient exactness remains noisy on the native path
//! tests/stdlib/nn/test_dense_e2e.sio
//!
//! E2E tests for nn::dense — 1-input/1-output dense layer with autograd tape.

use nn::dense::{
    DenseLayer, Tape,
    dense_new, dense_forward, dense_output,
    dense_grad_w, dense_grad_b, dense_grad_x,
    dense_update, mse_loss, mse_loss_grad,
    backward,
}
use test::helpers::{check_near}

// ============================================================================
// Forward pass
// ============================================================================

fn test_dense_zero_weights_sigmoid_half() with Mut, Div, Panic {
    // w=0, b=0, x=1 → sigmoid(0) = 0.5
    let layer = dense_new(0.0, 0.0)
    let tape = dense_forward(layer, 1.0)
    assert(check_near(dense_output(tape), 0.5, 1e-4))
}

fn test_dense_zero_input_sigmoid_half() with Mut, Div, Panic {
    // w=1, b=0, x=0 → sigmoid(0) = 0.5
    let layer = dense_new(1.0, 0.0)
    let tape = dense_forward(layer, 0.0)
    assert(check_near(dense_output(tape), 0.5, 1e-4))
}

fn test_dense_large_input_near_one() with Mut, Div, Panic {
    // w=1, b=0, x=10 → sigmoid(10) > 0.99
    let layer = dense_new(1.0, 0.0)
    let tape = dense_forward(layer, 10.0)
    assert(dense_output(tape) > 0.99)
}

fn test_dense_large_neg_input_near_zero() with Mut, Div, Panic {
    // w=1, b=0, x=-10 → sigmoid(-10) < 0.01
    let layer = dense_new(1.0, 0.0)
    let tape = dense_forward(layer, 0.0 - 10.0)
    assert(dense_output(tape) < 0.01)
}

fn test_dense_output_in_unit_interval() with Mut, Div, Panic {
    // sigmoid is always in (0, 1)
    let layer = dense_new(0.5, 0.1)
    let tape = dense_forward(layer, 2.0)
    let out = dense_output(tape)
    assert(out > 0.0)
    assert(out < 1.0)
}

fn test_dense_bias_shifts_output() with Mut, Div, Panic {
    // Positive bias shifts output above 0.5 for zero input
    let layer_pos = dense_new(0.0, 1.0)
    let tape_pos = dense_forward(layer_pos, 0.0)
    assert(dense_output(tape_pos) > 0.5)
    // Negative bias shifts output below 0.5 for zero input
    let layer_neg = dense_new(0.0, 0.0 - 1.0)
    let tape_neg = dense_forward(layer_neg, 0.0)
    assert(dense_output(tape_neg) < 0.5)
}

// ============================================================================
// Weight update
// ============================================================================

fn test_dense_update_decreases_weight() with Mut, Div, Panic {
    // Positive gradient with positive lr → weight decreases
    let layer = dense_new(1.0, 0.5)
    let updated = dense_update(layer, 0.1, 0.05, 0.1)
    // weight = 1.0 - 0.1*0.1 = 0.99
    assert(check_near(updated.weight, 0.99, 1e-9))
    // bias = 0.5 - 0.1*0.05 = 0.495
    assert(check_near(updated.bias, 0.495, 1e-9))
}

fn test_dense_update_zero_grad() with Mut, Div, Panic {
    // Zero gradient → no change
    let layer = dense_new(2.0, 3.0)
    let updated = dense_update(layer, 0.0, 0.0, 0.01)
    assert(check_near(updated.weight, 2.0, 1e-9))
    assert(check_near(updated.bias, 3.0, 1e-9))
}

// ============================================================================
// Loss function
// ============================================================================

fn test_mse_loss_zero() with Mut, Div, Panic {
    assert(check_near(mse_loss(0.5, 0.5), 0.0, 1e-9))
}

fn test_mse_loss_positive() with Mut, Div, Panic {
    // (0.7 - 0.5)^2 = 0.04
    assert(check_near(mse_loss(0.7, 0.5), 0.04, 1e-9))
}

fn test_mse_loss_grad() with Mut, Div, Panic {
    // 2 * (0.7 - 0.5) = 0.4
    assert(check_near(mse_loss_grad(0.7, 0.5), 0.4, 1e-9))
}

fn test_mse_loss_grad_zero() with Mut, Div, Panic {
    assert(check_near(mse_loss_grad(0.5, 0.5), 0.0, 1e-9))
}

// ============================================================================
// Main
// ============================================================================

pub fn main() -> i32 with Mut, Div, Panic {
    let layer = dense_new(0.5, 0.1)
    let tape = dense_forward(layer, 2.0)
    let _ = dense_output(tape)
    let _ = dense_update(layer, 0.1, 0.05, 0.1)
    let _ = mse_loss(0.7, 0.5)
    let _ = mse_loss_grad(0.7, 0.5)
    return 0
}
