//@ run-pass
// E2E test for stdlib/nn/dense
//
// Tests dense layer construction, forward pass (y = sigmoid(w*x+b)),
// backward pass gradient computation, and weight update.

use nn::dense::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: Forward pass with w=0, b=0 => sigmoid(0) = 0.5
    print("Test 1: dense(w=0,b=0) x=1 => 0.5... ")
    let layer1 = dense_new(0.0, 0.0)
    let tape1 = dense_forward(layer1, 1.0)
    let out1 = dense_output(tape1)
    if check_near(out1, 0.5, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: Forward pass with w=1, b=0, x=0 => sigmoid(0) = 0.5
    print("Test 2: dense(w=1,b=0) x=0 => 0.5... ")
    let layer2 = dense_new(1.0, 0.0)
    let tape2 = dense_forward(layer2, 0.0)
    let out2 = dense_output(tape2)
    if check_near(out2, 0.5, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: Large positive input => sigmoid approaches 1
    print("Test 3: dense(w=1,b=0) x=10 => ~1.0... ")
    let layer3 = dense_new(1.0, 0.0)
    let tape3 = dense_forward(layer3, 10.0)
    let out3 = dense_output(tape3)
    if out3 > 0.99 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: Backward pass produces non-zero gradients
    print("Test 4: backward gives gradients... ")
    let layer4 = dense_new(0.5, 0.1)
    let tape4 = dense_forward(layer4, 2.0)
    let tape4b = backward(tape4, 5)
    let gw = dense_grad_w(tape4b)
    let gb = dense_grad_b(tape4b)
    // Gradients should be non-zero for non-saturated sigmoid
    let gw_abs = if gw < 0.0 { 0.0 - gw } else { gw }
    let gb_abs = if gb < 0.0 { 0.0 - gb } else { gb }
    if gw_abs > 0.001 && gb_abs > 0.001 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: MSE loss at perfect prediction = 0
    print("Test 5: mse_loss(0.5, 0.5)=0... ")
    if check_near(mse_loss(0.5, 0.5), 0.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
