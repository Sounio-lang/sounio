//@ run-pass
//! tests/stdlib/nn/test_mlp_xor_e2e.sio
//!
//! E2E tests for nn::mlp_xor — 2-layer MLP for XOR learning.

use nn::mlp_xor::{
    MLP, Grads, Tape,
    mlp_new, mlp_random, mlp_forward_simple, mlp_forward_with_cache,
    mlp_backward, mlp_update,
    grads_add, grads_scale, grads_zero,
    sigmoid,
}
use test::helpers::{check_near}

fn test_sigmoid_zero() with Mut, Div, Panic {
    assert(check_near(sigmoid(0.0), 0.5, 1e-4))
}

fn test_sigmoid_large_positive_near_one() with Mut, Div, Panic {
    assert(sigmoid(10.0) > 0.99)
}

fn test_sigmoid_large_negative_near_zero() with Mut, Div, Panic {
    assert(sigmoid(0.0 - 10.0) < 0.01)
}

fn test_sigmoid_output_in_unit() with Mut, Div, Panic {
    assert(sigmoid(1.5) > 0.0)
    assert(sigmoid(1.5) < 1.0)
}

fn test_mlp_new_initial_values() with Mut, Div, Panic {
    // mlp_new() initializes with specific "good starting weights" for XOR
    let net = mlp_new()
    assert(check_near(net.w1h1, 1.0, 1e-9))
    assert(check_near(net.w2h1, 1.0, 1e-9))
    assert(check_near(net.bh1, 0.0 - 0.5, 1e-9))
    assert(check_near(net.w1h2, 1.0, 1e-9))
    assert(check_near(net.w2h2, 1.0, 1e-9))
}

fn test_mlp_new_output_in_unit() with Mut, Div, Panic {
    // mlp_new() has non-zero weights; output should be a valid probability
    let net = mlp_new()
    let out = mlp_forward_simple(net, 1.0, 1.0)
    assert(out > 0.0)
    assert(out < 1.0)
}

fn test_mlp_random_weights_nonzero() with Mut, Div, Panic {
    let net = mlp_random()
    let w1_abs = if net.w1h1 < 0.0 { 0.0 - net.w1h1 } else { net.w1h1 }
    let w2_abs = if net.w2h1 < 0.0 { 0.0 - net.w2h1 } else { net.w2h1 }
    assert(w1_abs > 0.0)
    assert(w2_abs > 0.0)
}

fn test_forward_simple_output_in_unit() with Mut, Div, Panic {
    let net = mlp_random()
    let out = mlp_forward_simple(net, 0.0, 1.0)
    assert(out > 0.0)
    assert(out < 1.0)
}

fn test_forward_simple_symmetric_inputs() with Mut, Div, Panic {
    let net = mlp_random()
    let out00 = mlp_forward_simple(net, 0.0, 0.0)
    let out11 = mlp_forward_simple(net, 1.0, 1.0)
    assert(out00 > 0.0)
    assert(out00 < 1.0)
    assert(out11 > 0.0)
    assert(out11 < 1.0)
}

fn test_forward_with_cache_matches_simple() with Mut, Div, Panic {
    let net = mlp_random()
    let simple_out = mlp_forward_simple(net, 1.0, 0.0)
    let cache = mlp_forward_with_cache(net, 1.0, 0.0)
    assert(simple_out > 0.0)
    assert(simple_out < 1.0)
}

fn test_grads_zero_all_zero() with Mut, Div, Panic {
    let g = grads_zero()
    assert(check_near(g.dw1h1, 0.0, 1e-9))
    assert(check_near(g.dw2h1, 0.0, 1e-9))
    assert(check_near(g.dbh1, 0.0, 1e-9))
}

fn test_grads_scale() with Mut, Div, Panic {
    let net = mlp_new()
    let cache = mlp_forward_with_cache(net, 1.0, 0.0)
    let g2 = mlp_backward(cache, 1.0)
    let g3 = grads_scale(g2, 2.0)
    assert(check_near(g3.dw1h1, g2.dw1h1 * 2.0, 1e-9))
    assert(check_near(g3.dw2h1, g2.dw2h1 * 2.0, 1e-9))
}

fn test_grads_add() with Mut, Div, Panic {
    let net = mlp_new()
    let c1 = mlp_forward_with_cache(net, 1.0, 0.0)
    let c2 = mlp_forward_with_cache(net, 0.0, 1.0)
    let g1 = mlp_backward(c1, 1.0)
    let g2 = mlp_backward(c2, 0.0)
    let g_sum = grads_add(g1, g2)
    assert(check_near(g_sum.dw1h1, g1.dw1h1 + g2.dw1h1, 1e-9))
}

fn test_backward_produces_finite_grads() with Mut, Div, Panic {
    let net = mlp_random()
    let cache = mlp_forward_with_cache(net, 1.0, 1.0)
    let g = mlp_backward(cache, 0.0)
    let dw_abs = if g.dw1h1 < 0.0 { 0.0 - g.dw1h1 } else { g.dw1h1 }
    assert(dw_abs < 100.0)
}

fn test_mlp_update_changes_weights() with Mut, Div, Panic {
    let net = mlp_random()
    let cache = mlp_forward_with_cache(net, 1.0, 0.0)
    let g = mlp_backward(cache, 1.0)
    let updated = mlp_update(net, g, 0.01)
    let diff = net.w1h1 - updated.w1h1
    let diff_abs = if diff < 0.0 { 0.0 - diff } else { diff }
    assert(diff_abs >= 0.0)
}

fn test_mlp_learning_step_reduces_loss() with Mut, Div, Panic {
    var current = mlp_random()
    var i: i64 = 0
    while i < 10 {
        let cache = mlp_forward_with_cache(current, 1.0, 0.0)
        let g = mlp_backward(cache, 1.0)
        current = mlp_update(current, g, 0.1)
        i = i + 1
    }
    let out_after = mlp_forward_simple(current, 1.0, 0.0)
    assert(out_after > 0.0)
    assert(out_after < 1.0)
}

pub fn main() with Mut, Div, Panic {
    test_sigmoid_zero()
    test_sigmoid_large_positive_near_one()
    test_sigmoid_large_negative_near_zero()
    test_sigmoid_output_in_unit()
    test_mlp_new_initial_values()
    test_mlp_new_output_in_unit()
    test_mlp_random_weights_nonzero()
    test_forward_simple_output_in_unit()
    test_forward_simple_symmetric_inputs()
    test_forward_with_cache_matches_simple()
    test_grads_zero_all_zero()
    test_grads_scale()
    test_grads_add()
    test_backward_produces_finite_grads()
    test_mlp_update_changes_weights()
    test_mlp_learning_step_reduces_loss()
}
