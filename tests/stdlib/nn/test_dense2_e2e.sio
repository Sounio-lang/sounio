//@ run-pass
//! tests/stdlib/nn/test_dense2_e2e.sio
//!
//! E2E tests for nn::dense2 — 2-input/1-output dense layer with autograd tape.

use nn::dense2::{
    Dense2Layer, Tape,
    dense2_new, dense2_forward, dense2_output,
    dense2_grad_w1, dense2_grad_w2, dense2_grad_b,
    dense2_update, mse_loss, mse_loss_grad,
    backward,
}
use test::helpers::{check_near}

// ============================================================================
// Forward pass
// ============================================================================

fn test_dense2_zero_weights_sigmoid_half() with Mut, Div, Panic {
    // w1=0, w2=0, b=0, x1=1, x2=1 → sigmoid(0) = 0.5
    let layer = dense2_new(0.0, 0.0, 0.0)
    let tape = dense2_forward(layer, 1.0, 1.0)
    assert(check_near(dense2_output(tape), 0.5, 1e-4))
}

fn test_dense2_zero_inputs_sigmoid_half() with Mut, Div, Panic {
    // w1=1, w2=1, b=0, x1=0, x2=0 → sigmoid(0) = 0.5
    let layer = dense2_new(1.0, 1.0, 0.0)
    let tape = dense2_forward(layer, 0.0, 0.0)
    assert(check_near(dense2_output(tape), 0.5, 1e-4))
}

fn test_dense2_positive_net_above_half() with Mut, Div, Panic {
    // w1=1, w2=1, b=0, x1=2, x2=2 → sigmoid(4) > 0.5
    let layer = dense2_new(1.0, 1.0, 0.0)
    let tape = dense2_forward(layer, 2.0, 2.0)
    assert(dense2_output(tape) > 0.5)
}

fn test_dense2_negative_net_below_half() with Mut, Div, Panic {
    // net = -5 → sigmoid(-5) < 0.5
    let layer = dense2_new(1.0, 1.0, 0.0)
    let tape = dense2_forward(layer, 0.0 - 2.5, 0.0 - 2.5)
    assert(dense2_output(tape) < 0.5)
}

fn test_dense2_output_in_unit_interval() with Mut, Div, Panic {
    // sigmoid always in (0, 1)
    let layer = dense2_new(0.3, 0.7, 0.1)
    let tape = dense2_forward(layer, 1.5, 0.8)
    let out = dense2_output(tape)
    assert(out > 0.0)
    assert(out < 1.0)
}

fn test_dense2_bias_shifts_output() with Mut, Div, Panic {
    // Positive bias → output > 0.5 for zero inputs
    let layer_pos = dense2_new(0.0, 0.0, 1.0)
    let tape_pos = dense2_forward(layer_pos, 0.0, 0.0)
    assert(dense2_output(tape_pos) > 0.5)
    // Negative bias → output < 0.5 for zero inputs
    let layer_neg = dense2_new(0.0, 0.0, 0.0 - 1.0)
    let tape_neg = dense2_forward(layer_neg, 0.0, 0.0)
    assert(dense2_output(tape_neg) < 0.5)
}

fn test_dense2_w1_only_affects_x1() with Mut, Div, Panic {
    // w1=1, w2=0: output depends on x1 but not x2
    let layer = dense2_new(1.0, 0.0, 0.0)
    let t1 = dense2_forward(layer, 2.0, 99.0)
    let t2 = dense2_forward(layer, 2.0, 0.0)
    assert(check_near(dense2_output(t1), dense2_output(t2), 1e-9))
}

// ============================================================================
// Backward pass — gradients
// ============================================================================

fn test_dense2_backward_grads_nonzero() with Mut, Div, Panic {
    let layer = dense2_new(0.5, 0.3, 0.1)
    let tape = dense2_forward(layer, 1.0, 2.0)
    let tape_b = backward(tape, 9)
    let gw1 = dense2_grad_w1(tape_b)
    let gw2 = dense2_grad_w2(tape_b)
    let gb = dense2_grad_b(tape_b)
    let gw1_abs = if gw1 < 0.0 { 0.0 - gw1 } else { gw1 }
    let gw2_abs = if gw2 < 0.0 { 0.0 - gw2 } else { gw2 }
    let gb_abs = if gb < 0.0 { 0.0 - gb } else { gb }
    assert(gw1_abs > 0.001)
    assert(gw2_abs > 0.001)
    assert(gb_abs > 0.001)
}

fn test_dense2_grad_w2_larger_than_w1_for_bigger_x2() with Mut, Div, Panic {
    // x1=1, x2=3: grad_w2 = d_sigmoid * x2 = 3 * (d_sigmoid * x1) = 3 * grad_w1
    let layer = dense2_new(0.0, 0.0, 0.0)
    let tape = dense2_forward(layer, 1.0, 3.0)
    let tape_b = backward(tape, 9)
    let gw1 = dense2_grad_w1(tape_b)
    let gw2 = dense2_grad_w2(tape_b)
    let gw1_abs = if gw1 < 0.0 { 0.0 - gw1 } else { gw1 }
    let gw2_abs = if gw2 < 0.0 { 0.0 - gw2 } else { gw2 }
    assert(gw2_abs > gw1_abs)
}

fn test_dense2_backward_symmetry() with Mut, Div, Panic {
    // At w1=0, w2=0, b=0: sigmoid'(0) = 0.25
    // gw1 = 0.25 * x1, gw2 = 0.25 * x2, gb = 0.25
    let layer = dense2_new(0.0, 0.0, 0.0)
    let tape = dense2_forward(layer, 2.0, 4.0)
    let tape_b = backward(tape, 9)
    let gw1 = dense2_grad_w1(tape_b)
    let gw2 = dense2_grad_w2(tape_b)
    let gb = dense2_grad_b(tape_b)
    assert(check_near(gw1, 0.5, 0.01))   // 0.25 * 2
    assert(check_near(gw2, 1.0, 0.01))   // 0.25 * 4
    assert(check_near(gb, 0.25, 0.01))
}

// ============================================================================
// Weight update
// ============================================================================

fn test_dense2_update_decreases_weight() with Mut, Div, Panic {
    // Positive gradient + positive lr → weight decreases
    let layer = dense2_new(1.0, 2.0, 0.5)
    let updated = dense2_update(layer, 0.1, 0.2, 0.05, 0.1)
    assert(check_near(updated.w1, 0.99, 1e-9))   // 1.0 - 0.1*0.1
    assert(check_near(updated.w2, 1.98, 1e-9))   // 2.0 - 0.1*0.2
    assert(check_near(updated.bias, 0.495, 1e-9)) // 0.5 - 0.1*0.05
}

fn test_dense2_update_zero_grad() with Mut, Div, Panic {
    // Zero gradient → no change
    let layer = dense2_new(3.0, 4.0, 5.0)
    let updated = dense2_update(layer, 0.0, 0.0, 0.0, 0.01)
    assert(check_near(updated.w1, 3.0, 1e-9))
    assert(check_near(updated.w2, 4.0, 1e-9))
    assert(check_near(updated.bias, 5.0, 1e-9))
}

// ============================================================================
// Loss function
// ============================================================================

fn test_mse_loss_zero() with Mut, Div, Panic {
    assert(check_near(mse_loss(0.5, 0.5), 0.0, 1e-9))
}

fn test_mse_loss_positive() with Mut, Div, Panic {
    // (0.7 - 0.5)^2 = 0.04
    assert(check_near(mse_loss(0.7, 0.5), 0.04, 1e-9))
}

fn test_mse_loss_grad() with Mut, Div, Panic {
    // 2 * (0.7 - 0.5) = 0.4
    assert(check_near(mse_loss_grad(0.7, 0.5), 0.4, 1e-9))
}

fn test_mse_loss_grad_zero() with Mut, Div, Panic {
    assert(check_near(mse_loss_grad(0.5, 0.5), 0.0, 1e-9))
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with Mut, Div, Panic {
    test_dense2_zero_weights_sigmoid_half()
    test_dense2_zero_inputs_sigmoid_half()
    test_dense2_positive_net_above_half()
    test_dense2_negative_net_below_half()
    test_dense2_output_in_unit_interval()
    test_dense2_bias_shifts_output()
    test_dense2_w1_only_affects_x1()
    test_dense2_backward_grads_nonzero()
    test_dense2_grad_w2_larger_than_w1_for_bigger_x2()
    test_dense2_backward_symmetry()
    test_dense2_update_decreases_weight()
    test_dense2_update_zero_grad()
    test_mse_loss_zero()
    test_mse_loss_positive()
    test_mse_loss_grad()
    test_mse_loss_grad_zero()
}
