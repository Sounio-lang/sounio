//@ run-pass
// E2E: stdlib/thread/pool.sio — ThreadPool submit/complete

use thread::pool::*;

fn run_tests(pool: &! ThreadPool) -> i32 with Mut {
    if thread_pool_total_workers(pool) != 4 { return 1 }
    if thread_pool_active_count(pool) != 0 { return 2 }

    // Submit tasks
    let ok1 = thread_pool_submit(pool, 100)
    if !ok1 { return 3 }
    let ok2 = thread_pool_submit(pool, 200)
    if !ok2 { return 4 }
    if thread_pool_active_count(pool) != 2 { return 5 }

    // Complete one
    thread_pool_complete(pool, 0)
    if thread_pool_active_count(pool) != 1 { return 6 }

    thread_pool_complete(pool, 1)
    if thread_pool_active_count(pool) != 0 { return 7 }

    return 0
}

fn main() -> i32 with Mut {
    var pool = thread_pool_new(4)
    return run_tests(&! pool)
}
