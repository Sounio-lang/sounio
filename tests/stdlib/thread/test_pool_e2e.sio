//@ run-pass
// E2E: stdlib/thread/pool.sio — ThreadPool submit/complete

use thread::pool::*;

fn run_tests(pool: &! ThreadPool) -> i32 {
    if pool.total_workers() != 4 { return 1 }
    if pool.active_count() != 0 { return 2 }

    // Submit tasks
    let ok1 = pool.submit(100)
    if !ok1 { return 3 }
    let ok2 = pool.submit(200)
    if !ok2 { return 4 }
    if pool.active_count() != 2 { return 5 }

    // Complete one
    pool.complete(0)
    if pool.active_count() != 1 { return 6 }

    pool.complete(1)
    if pool.active_count() != 0 { return 7 }

    return 0
}

fn main() -> i32 {
    var pool = ThreadPool::new(4)
    return run_tests(&! pool)
}
