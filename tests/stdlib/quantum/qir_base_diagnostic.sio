//@ run-pass
use quantum::qasm_tape::{tape_new, tape_bell, tape_h, tape_measure, tape_qasm, tape_qir_base_error}

fn main() -> i32 with Mut, Div, Panic, IO {
    if !str_eq(tape_qir_base_error(tape_bell()), "") { return 1 }
    var unmeasured = tape_new(1)
    unmeasured = tape_h(unmeasured, 0)
    if !str_eq(tape_qir_base_error(unmeasured), "") { return 6 }
    var sequence = tape_new(1)
    sequence = tape_h(sequence, 0)
    sequence = tape_h(sequence, 0)
    sequence = tape_measure(sequence, 0)
    if !str_eq(tape_qir_base_error(sequence), "") { return 7 }


    var late = tape_new(1)
    late = tape_h(late, 0)
    late = tape_measure(late, 0)
    late = tape_h(late, 0)
    if !str_eq(tape_qir_base_error(late), "tape_qir: gate after measurement is not supported by base profile") { return 2 }
    if !str_eq(tape_qasm(late), "OPENQASM 3.0;\ninclude \"stdgates.inc\";\nqubit[1] q;\nbit[1] c;\nh q[0];\nc[0] = measure q[0];\nh q[0];\n") { return 5 }

    var duplicate = tape_new(1)
    duplicate = tape_measure(duplicate, 0)
    duplicate = tape_measure(duplicate, 0)
    if !str_eq(tape_qir_base_error(duplicate), "tape_qir: qubit measured more than once") { return 3 }
    var other = tape_new(2)
    other = tape_measure(other, 0)
    other = tape_h(other, 1)
    if !str_eq(tape_qir_base_error(other), "tape_qir: gate after measurement is not supported by base profile") { return 4 }
    print("QIR_BASE_DIAGNOSTICS_OK\n")
    0
}
