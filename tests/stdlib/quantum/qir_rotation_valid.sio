//@ run-pass
use quantum::qasm_tape::{tape_new, tape_ry, tape_rz, tape_measure, tape_qir}
fn main() -> i32 with Mut, Div, Panic, IO {
    var t = tape_new(1)
    t = tape_ry(t, 0, 1.5707963267948966)
    t = tape_rz(t, 0, 0.2)
    t = tape_measure(t, 0)
    print(tape_qir(t))
    print("ROTATION_QIR_EMITTED\n")
    0
}
