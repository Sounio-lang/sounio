use quantum::qasm_tape::{tape_new, tape_ry, tape_qir, tape_qir_base_error}
fn main() -> i32 with Mut, Div, Panic, IO {
    let t = tape_ry(tape_new(1), 0, 0.0 / 0.0)
    if !str_eq(tape_qir_base_error(t), "tape_qir: non-finite rotation angle") { return 2 }
    print("NONFINITE_PRECHECK_OK\n")
    print(tape_qir(t))
    print("QIR_EMITTED\n")
    0
}
