//@ run-pass
use quantum::qasm_tape::{tape_new, tape_h, tape_rz, tape_measure, tape_qir}
fn main() -> i32 with Mut, Div, Panic, IO {
    var t = tape_new(1)
    t = tape_h(t, 0)
    t = tape_rz(t, 0, 3.141592653589793)
    t = tape_h(t, 0)
    t = tape_measure(t, 0)
    print(tape_qir(t))
    print("PHASE_QIR_EMITTED\n")
    0
}
