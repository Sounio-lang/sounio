//@ run-pass
use quantum::qasm_tape::{tape_new, tape_h, tape_cx, tape_measure, tape_ry, tape_rz, tape_qir_base_error}

fn main() -> i32 with Mut, Div, Panic, IO {
    var t = tape_h(tape_new(1), 0)
    t.kind[0] = 42
    if !str_eq(tape_qir_base_error(t), "tape_qir: unsupported opcode") { print("UNKNOWN_OPCODE_ACCEPTED\n"); return 1 }
    var count = tape_new(1)
    count.n_ops = 65
    if !str_eq(tape_qir_base_error(count), "tape_qir: invalid operation count") { return 2 }
    count.n_ops = -1
    if !str_eq(tape_qir_base_error(count), "tape_qir: invalid operation count") { return 3 }
    var wires = tape_h(tape_new(1), 0)
    wires.q0[0] = 1
    if !str_eq(tape_qir_base_error(wires), "tape_qir: invalid qubit index") { return 4 }
    var cx = tape_cx(tape_new(2), 0, 1)
    cx.q1[0] = 2
    if !str_eq(tape_qir_base_error(cx), "tape_qir: invalid qubit index") { return 5 }
    cx.q1[0] = 0
    if !str_eq(tape_qir_base_error(cx), "tape_qir: CNOT requires distinct qubits") { return 6 }
    var m = tape_measure(tape_new(1), 0)
    m.n_meas = 0
    if !str_eq(tape_qir_base_error(m), "tape_qir: measurement count mismatch") { return 7 }
    var nq = tape_new(0)
    nq.n_qubits = -1
    if !str_eq(tape_qir_base_error(nq), "tape_qir: invalid qubit count") { return 8 }
    var nonfinite = tape_ry(tape_new(1), 0, 0.0 / 0.0)
    if !str_eq(tape_qir_base_error(nonfinite), "tape_qir: non-finite rotation angle") { return 9 }
    nonfinite = tape_rz(tape_new(1), 0, 1.0 / 0.0)
    if !str_eq(tape_qir_base_error(nonfinite), "tape_qir: non-finite rotation angle") { return 10 }
    nonfinite = tape_rz(tape_new(1), 0, (0.0 - 1.0) / 0.0)
    if !str_eq(tape_qir_base_error(nonfinite), "tape_qir: non-finite rotation angle") { return 11 }
    print("MALFORMED_TAPE_REJECTED\n")
    0
}
