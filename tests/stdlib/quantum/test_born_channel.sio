//@ run-pass
// Present zero and an empty channel are different values.
// One shared angle fills the covariance. Two equal Epistemics leave it empty.

use epistemic::knowledge::{ep_new, Epistemic}

use quantum::born_channel::{
    born_prepared,
    born_one_shot,
    born_pair_one_angle,
    born_pair_two_angles,
    pair_var_sum,
    band_filled,
    band_variance,
    band_u_first,
    band_u_second,
    Born,
    BornPair,
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn check(name: string, ok: bool) -> i32 with IO {
    if ok {
        print(name)
        print(": PASS\n")
        return 0
    }
    print(name)
    print(": FAIL\n")
    return 1
}

fn prep(angle: Epistemic) -> Born with Mut, Div, Panic {
    born_prepared(angle)
}

fn one(angle: Epistemic) -> BornPair with Mut, Div, Panic {
    born_pair_one_angle(angle)
}

fn two(a: Epistemic, b: Epistemic) -> BornPair with Mut, Div, Panic {
    born_pair_two_angles(a, b)
}

fn main() -> i32 with Mut, Div, Panic, IO, Epistemic {
    var fail = 0
    let pi = 3.141592653589793
    let tol = 0.000000001

    let k_mid: Knowledge<f64> = measure(pi / 2.0, uncertainty: 0.01)
    let sig_mid = uncertainty_of(k_mid)
    let mid = ep_new(k_mid.value, sig_mid * sig_mid, 900)
    let b_mid = prep(mid)
    fail = fail + check("T1_prob", near(b_mid.prob, 0.5, tol))
    fail = fail + check("T1_angle_filled", band_filled(b_mid.angle) == 1)
    fail = fail + check("T1_shot_empty", band_filled(b_mid.shot) == 0)
    fail = fail + check("T1_no_bit", b_mid.bit_one == (0 - 1))
    fail = fail + check("T1_u1", near(band_u_first(b_mid.angle), 0.005, tol))
    fail = fail + check("T1_var", near(band_variance(b_mid.angle), 0.000025, tol))

    let k_pole: Knowledge<f64> = measure(pi, uncertainty: 0.1)
    let sig_pole = uncertainty_of(k_pole)
    let pole = ep_new(k_pole.value, sig_pole * sig_pole, 900)
    let b_pole = prep(pole)
    fail = fail + check("T2_pole_filled", band_filled(b_pole.angle) == 1)
    fail = fail + check("T2_pole_u1_present_zero", near(band_u_first(b_pole.angle), 0.0, tol))
    fail = fail + check("T2_pole_u2", near(band_u_second(b_pole.angle), 0.00353553390593, 0.00000001))
    fail = fail + check("T2_pole_shot_empty", band_filled(b_pole.shot) == 0)

    let shot = born_one_shot(pi / 2.0, 0.0)
    fail = fail + check("T3_shot_prob", near(shot.prob, 0.5, tol))
    fail = fail + check("T3_bit", shot.bit_one == 1)
    fail = fail + check("T3_angle_empty", band_filled(shot.angle) == 0)
    fail = fail + check("T3_shot_filled", band_filled(shot.shot) == 1)
    fail = fail + check("T3_shot_var", near(band_variance(shot.shot), 0.25, tol))

    let shared = one(mid)
    let apart = two(mid, mid)
    fail = fail + check("T4_shared_cov_filled", band_filled(shared.cov) == 1)
    fail = fail + check("T4_shared_cov", near(band_variance(shared.cov), 0.000025, tol))
    fail = fail + check("T4_shared_sum", near(pair_var_sum(shared), 0.0001, tol))
    fail = fail + check("T5_apart_cov_empty", band_filled(apart.cov) == 0)
    fail = fail + check("T5_apart_sum", near(pair_var_sum(apart), 0.00005, tol))
    fail = fail + check("T5_sums_differ", pair_var_sum(shared) > pair_var_sum(apart))

    let shared_pole = one(pole)
    let apart_pole = two(pole, pole)
    fail = fail + check("T6_pole_cov_present_zero", band_filled(shared_pole.cov) == 1)
    fail = fail + check("T6_pole_cov_value", near(band_variance(shared_pole.cov), 0.0, tol))
    fail = fail + check("T6_pole_apart_empty", band_filled(apart_pole.cov) == 0)
    fail = fail + check("T6_pole_sums_match", near(pair_var_sum(shared_pole), pair_var_sum(apart_pole), tol))

    if fail == 0 {
        print("ALL_PASS\n")
    }
    return fail
}
