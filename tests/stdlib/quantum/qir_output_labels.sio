//@ run-pass
use quantum::qasm_tape::{tape_new, tape_measure, tape_qir}
fn main() -> i32 with Mut, Div, Panic, IO {
    print("QIR_LABELS_EMPTY_BEGIN\n")
    print(tape_qir(tape_new(0)))
    print("QIR_LABELS_EMPTY_END\nQIR_LABELS_MANY_BEGIN\n")
    var t = tape_new(12)
    var i: i32 = 0
    while i < 12 {
        t = tape_measure(t, i)
        i = i + 1
    }
    print(tape_qir(t))
    print("QIR_LABELS_MANY_END\n")
    0
}
