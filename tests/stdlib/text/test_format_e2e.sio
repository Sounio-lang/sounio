//@ run-pass
// E2E test for stdlib/text/format
//
// Tests i64_to_str, f64_to_str, format1-4.

use text::format::*

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: i64_to_str(0) = "0"
    print("Test 1: i64_to_str(0)... ")
    let s1 = i64_to_str(0)
    if s1 == "0" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: i64_to_str(42) = "42"
    print("Test 2: i64_to_str(42)... ")
    let s2 = i64_to_str(42)
    if s2 == "42" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: i64_to_str(-7) = "-7"
    print("Test 3: i64_to_str(-7)... ")
    let s3 = i64_to_str(0 - 7)
    if s3 == "-7" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: i64_to_str(12345) = "12345"
    print("Test 4: i64_to_str(12345)... ")
    let s4 = i64_to_str(12345)
    if s4 == "12345" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: f64_to_str(0.0) starts with "0.0000"
    print("Test 5: f64_to_str(0.0)... ")
    let s5 = f64_to_str(0.0)
    if s5 == "0.0000" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 6: f64_to_str(3.14) starts with "3.14"
    print("Test 6: f64_to_str(3.14)... ")
    let s6 = f64_to_str(3.14)
    if starts_with(s6, "3.14") {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("PASS (approx)\n")
        pass = pass + 1
    }

    // Test 7: format1
    print("Test 7: format1... ")
    let s7 = format1("Hello, {}!", "world")
    if s7 == "Hello, world!" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 8: format2
    print("Test 8: format2... ")
    let s8 = format2("{} + {} = 3", "1", "2")
    if s8 == "1 + 2 = 3" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 9: format3
    print("Test 9: format3... ")
    let s9 = format3("{} {} {}", "a", "b", "c")
    if s9 == "a b c" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 10: format4
    print("Test 10: format4... ")
    let s10 = format4("{} {} {} {}", "1", "2", "3", "4")
    if s10 == "1 2 3 4" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print_int(pass)
    print(" Failed: ")
    print_int(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div, Panic, IO {
    return run_tests()
}
