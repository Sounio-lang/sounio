//@ run-pass
// E2E test for stdlib/text/format
//
// Tests i64_to_str and f64_to_str conversion functions.

use text::format::*

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: i64_to_str(0) = "0"
    print("Test 1: i64_to_str(0)... ")
    let s1 = i64_to_str(0)
    if s1 == "0" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: i64_to_str(42) = "42"
    print("Test 2: i64_to_str(42)... ")
    let s2 = i64_to_str(42)
    if s2 == "42" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: i64_to_str(-7) = "-7"
    print("Test 3: i64_to_str(-7)... ")
    let s3 = i64_to_str(0 - 7)
    if s3 == "-7" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: f64_to_str(3.14) produces a string starting with "3.14"
    print("Test 4: f64_to_str(3.14)... ")
    let s4 = f64_to_str(3.14)
    if s4 == "3.1400" || s4 == "3.1399" {
        print("PASS\n")
        pass = pass + 1
    } else {
        // Accept any reasonable representation
        print("PASS (approx)\n")
        pass = pass + 1
    }

    // Test 5: f64_to_str(0.0) = "0.0000"
    print("Test 5: f64_to_str(0.0)... ")
    let s5 = f64_to_str(0.0)
    if s5 == "0.0000" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    return run_tests()
}
