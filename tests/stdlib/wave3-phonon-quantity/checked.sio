use units::lib::*
use physics::phonon_quantity::*
use physics::phonon_factor::{PhononParams,phonon_default_si_params,phonon_boundary_checked}
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
fn exact()->PhononQuantityParams {
 let p=phonon_default_si_params()
 PhononQuantityParams{d_eff:quantity_new(p.d_eff,0.0,dim_diffusion()),dx:quantity_new(p.dx,0.0,dim_length()),k_release:quantity_new(p.k_release,0.0,dim_rate()),cl_site:quantity_new(p.cl_site,0.0,dim_rate()),fu:quantity_new(p.fu,0.0,dim_dimensionless()),kp:quantity_new(p.kp,0.0,dim_dimensionless()),c_portal:quantity_new(p.c_portal,0.0,dim_concentration()),c_ha:quantity_new(p.c_ha,0.0,dim_concentration()),f_heart:quantity_new(p.f_heart,0.0,dim_rate()),a_portal:quantity_new(p.a_portal,0.0,dim_dimensionless()),a_ha:quantity_new(p.a_ha,0.0,dim_dimensionless()),phi_ha:quantity_new(p.phi_ha,0.0,dim_dimensionless()),c_tissue:quantity_new(p.c_tissue,0.0,dim_concentration()),v_blood:quantity_new(p.v_blood,0.0,dim_velocity()),zonation:quantity_new(p.zonation,0.0,dim_dimensionless())}
}
fn zeros(n:i64)->NumericBuffer with Alloc,Mut,Div {
 var b=numeric_buffer_new(n,n*8);var i:i64=0
 while i<n {numeric_buffer_set(&!b,i,0.0);i=i+1};b
}
fn row(name:string,x:f64) with IO {print("QROW ");print(name);print(" ");print_int(f64_to_bits(x));println("")}
fn status(name:string,x:i64) with IO {print("QSTATUS ");print(name);print(" ");print_int(x);println("")}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=exact();assert(phonon_quantity_params_status(&p)==0)
 let def=rapamycin_phonon_params_q();assert(phonon_quantity_params_status(&def)==0)
 let b=pulsatile_input_q_checked(0.125,&def);assert(b.status==0)
 var v=zeros(2);numeric_buffer_set(&!v,0,1e-5);numeric_buffer_set(&!v,1,2e-5)
 var f=zeros(17);numeric_buffer_set(&!f,0,2e-7);numeric_buffer_set(&!f,1,3e-7)
 var s=phonon_quantity_from_factor(v,f,&p,1,0.0)
 assert(phonon_quantity_state_status(&s)==0)
 let c=phonon_quantity_covariance(&s,0,1);assert(c.status==0 && c.value>0.0)
 row("shared.initial.cov",c.value)
 let a=phonon_quantity_spatial_average(&s);assert(a.status==0)
 let aq=a.quantity
 row("shared.initial.mean_u",aq.uncertainty)
 var work=zeros(20)
 let sim=phonon_quantity_simulate_checked(&!s,&!work,1e-4,1e-4,2);assert(sim.status==0 && sim.steps==1)
 let x0=phonon_quantity_concentration(&s,0);let x1=phonon_quantity_concentration(&s,1)
 let f0=phonon_quantity_factor_entry(&s,0,0);let f1=phonon_quantity_factor_entry(&s,1,0)
 let cross=phonon_quantity_covariance(&s,0,1)
 row("shared.step.x0",x0.value);row("shared.step.x1",x1.value)
 row("shared.step.f0",f0.value);row("shared.step.f1",f1.value);row("shared.step.cov",cross.value)
 numeric_buffer_close(work);phonon_quantity_close(s)
 let means=phonon_quantity_means(&def)
 let boundary=phonon_boundary_checked(&means,0.125)
 assert(boundary.status==0)
 row("boundary.value",boundary.value)
 let bq=b.quantity;row("boundary.u",bq.uncertainty)
 var g:i64=0
 while g<6 {print("QGRAD ");print_int(g);print(" ");print_int(f64_to_bits(boundary.gradient[g]));println("");g=g+1}
 let q=q_concentration_mass(1e-5,2e-7)
 let init:[Quantity;64]=[q;64]
 let ind=phonon_quantity_from_independent_quantities(&init,2,&p,0.0,10000)
 assert(phonon_quantity_state_status(&ind)==0)
 let ic=phonon_quantity_covariance(&ind,0,1);assert(ic.status==0 && ic.value==0.0)
 phonon_quantity_close(ind)
 var wrong0=p;wrong0.d_eff=quantity_new(1.0,0.0,dim_length())
 let e0=phonon_quantity_params_status(&wrong0);assert(e0==5);status("dim.d_eff",e0)
 var wrong1=p;wrong1.dx=quantity_new(1.0,0.0,dim_time())
 let e1=phonon_quantity_params_status(&wrong1);assert(e1==5);status("dim.dx",e1)
 var wrong2=p;wrong2.k_release=quantity_new(1.0,0.0,dim_length())
 let e2=phonon_quantity_params_status(&wrong2);assert(e2==5);status("dim.k_release",e2)
 var wrong3=p;wrong3.cl_site=quantity_new(1.0,0.0,dim_length())
 let e3=phonon_quantity_params_status(&wrong3);assert(e3==5);status("dim.cl_site",e3)
 var wrong4=p;wrong4.fu=quantity_new(1.0,0.0,dim_length())
 let e4=phonon_quantity_params_status(&wrong4);assert(e4==5);status("dim.fu",e4)
 var wrong5=p;wrong5.kp=quantity_new(1.0,0.0,dim_length())
 let e5=phonon_quantity_params_status(&wrong5);assert(e5==5);status("dim.kp",e5)
 var wrong6=p;wrong6.c_portal=quantity_new(1.0,0.0,dim_length())
 let e6=phonon_quantity_params_status(&wrong6);assert(e6==5);status("dim.c_portal",e6)
 var wrong7=p;wrong7.c_ha=quantity_new(1.0,0.0,dim_length())
 let e7=phonon_quantity_params_status(&wrong7);assert(e7==5);status("dim.c_ha",e7)
 var wrong8=p;wrong8.f_heart=quantity_new(1.0,0.0,dim_length())
 let e8=phonon_quantity_params_status(&wrong8);assert(e8==5);status("dim.f_heart",e8)
 var wrong9=p;wrong9.a_portal=quantity_new(1.0,0.0,dim_length())
 let e9=phonon_quantity_params_status(&wrong9);assert(e9==5);status("dim.a_portal",e9)
 var wrong10=p;wrong10.a_ha=quantity_new(1.0,0.0,dim_length())
 let e10=phonon_quantity_params_status(&wrong10);assert(e10==5);status("dim.a_ha",e10)
 var wrong11=p;wrong11.phi_ha=quantity_new(1.0,0.0,dim_length())
 let e11=phonon_quantity_params_status(&wrong11);assert(e11==5);status("dim.phi_ha",e11)
 var wrong12=p;wrong12.c_tissue=quantity_new(1.0,0.0,dim_length())
 let e12=phonon_quantity_params_status(&wrong12);assert(e12==5);status("dim.c_tissue",e12)
 var wrong13=p;wrong13.v_blood=quantity_new(1.0,0.0,dim_length())
 let e13=phonon_quantity_params_status(&wrong13);assert(e13==5);status("dim.v_blood",e13)
 var wrong14=p;wrong14.zonation=quantity_new(1.0,0.0,dim_length())
 let e14=phonon_quantity_params_status(&wrong14);assert(e14==5);status("dim.zonation",e14)
 var neg=p;neg.dx=q_length(3.9e-6,0.0-1e-7);status("negative_u",phonon_quantity_params_status(&neg));assert(phonon_quantity_params_status(&neg)==6)
 var nan=p;nan.fu=q_dimensionless(bits_to_f64(9221120237041090560),0.0);status("nan",phonon_quantity_params_status(&nan));assert(phonon_quantity_params_status(&nan)==1)
 var domain=p;domain.dx=q_length(0.0,0.0);status("domain",phonon_quantity_params_status(&domain));assert(phonon_quantity_params_status(&domain)==2)
 let budget=phonon_quantity_from_independent_quantities(&init,2,&p,0.0,0);status("budget",phonon_quantity_state_status(&budget));assert(phonon_quantity_state_status(&budget)==7);phonon_quantity_close(budget)
 let mismatch=phonon_quantity_from_factor(zeros(2),zeros(17),&def,1,0.0);status("marginal_mismatch",phonon_quantity_state_status(&mismatch));assert(phonon_quantity_state_status(&mismatch)==9);phonon_quantity_close(mismatch)
 var nv=zeros(2);numeric_buffer_set(&!nv,0,1e-5);numeric_buffer_set(&!nv,1,2e-5)
 var nf=zeros(17);numeric_buffer_set(&!nf,0,2e-7);numeric_buffer_set(&!nf,1,0.0-3e-7)
 let signed=phonon_quantity_from_factor(nv,nf,&p,1,0.0);assert(phonon_quantity_state_status(&signed)==0)
 let nc=phonon_quantity_covariance(&signed,0,1);row("shared.negative.cov",nc.value);phonon_quantity_close(signed)

 println("PHONON_QUANTITY_CHECKED_OK");0
}
