//@ check-only
// E2E test for stdlib/stats/inferential
// Tests: t_test_one_sample, t_test_independent, t_test_welch, t_test_paired,
//        anova_oneway_3, mann_whitney_u, cohens_d_interpret, eta_squared_interpret,
//        ttest_result_new, anova_result_new, mannwhitney_result_new

use stats::inferential::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32  with Mut, Div{
    var pass = 0
    var fail = 0

    // Test 1: ttest_result_new initializes correctly
    let empty = ttest_result_new()
    if check_near(empty.t_stat, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 2: anova_result_new initializes correctly
    let aempty = anova_result_new()
    if check_near(aempty.f_stat, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 3: mannwhitney_result_new initializes correctly
    let mempty = mannwhitney_result_new()
    if check_near(mempty.p_value, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Setup data: group A mean=7
    var data: [f64; 100] = [0.0; 100]
    data[0] = 5.0
    data[1] = 6.0
    data[2] = 7.0
    data[3] = 8.0
    data[4] = 9.0

    // Test 4: one-sample t-test against mu0=7 -> t ~ 0
    let r1 = t_test_one_sample(data, 5, 7.0)
    if check_near(r1.t_stat, 0.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 5: one-sample t-test mean_diff = 7 - 7 = 0
    if check_near(r1.mean_diff, 0.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 6: one-sample t-test df = 4
    if check_near(r1.df, 4.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Setup group B: mean=12
    var data2: [f64; 100] = [0.0; 100]
    data2[0] = 10.0
    data2[1] = 11.0
    data2[2] = 12.0
    data2[3] = 13.0
    data2[4] = 14.0

    // Test 7: independent t-test mean_diff = 7 - 12 = -5
    let r2 = t_test_independent(data, 5, data2, 5)
    if check_near(r2.mean_diff, 0.0 - 5.0, 0.1) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 8: independent t-test df = 8
    if check_near(r2.df, 8.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 9: Welch t-test mean_diff = -5
    let r3 = t_test_welch(data, 5, data2, 5)
    if check_near(r3.mean_diff, 0.0 - 5.0, 0.1) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 10: paired t-test on pre/post
    var pre: [f64; 100] = [0.0; 100]
    var post: [f64; 100] = [0.0; 100]
    pre[0] = 100.0
    pre[1] = 102.0
    pre[2] = 104.0
    pre[3] = 101.0
    pre[4] = 103.0
    post[0] = 95.0
    post[1] = 97.0
    post[2] = 99.0
    post[3] = 96.0
    post[4] = 98.0
    let r4 = t_test_paired(pre, post, 5)
    if check_near(r4.mean_diff, 5.0, 0.1) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 11: ANOVA with 3 identical groups => F ~ 0
    var g1: [f64; 100] = [0.0; 100]
    var g2: [f64; 100] = [0.0; 100]
    var g3: [f64; 100] = [0.0; 100]
    g1[0] = 5.0
    g1[1] = 6.0
    g1[2] = 7.0
    g2[0] = 5.0
    g2[1] = 6.0
    g2[2] = 7.0
    g3[0] = 5.0
    g3[1] = 6.0
    g3[2] = 7.0
    let ra = anova_oneway_3(g1, 3, g2, 3, g3, 3)
    if check_near(ra.f_stat, 0.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 12: ANOVA df_between = 2
    if ra.df_between == 2 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 13: Mann-Whitney U test between separated groups
    var mx: [f64; 100] = [0.0; 100]
    var my: [f64; 100] = [0.0; 100]
    mx[0] = 1.0
    mx[1] = 2.0
    mx[2] = 3.0
    my[0] = 4.0
    my[1] = 5.0
    my[2] = 6.0
    let rm = mann_whitney_u(mx, 3, my, 3)
    if rm.u_stat >= 0.0 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 14: cohens_d_interpret small effect
    let interp_small = cohens_d_interpret(0.3)
    if interp_small == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 15: cohens_d_interpret large effect
    let interp_large = cohens_d_interpret(1.2)
    if interp_large == 3 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 16: eta_squared_interpret negligible
    let eta_neg = eta_squared_interpret(0.005)
    if eta_neg == 0 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 17: eta_squared_interpret large
    let eta_large = eta_squared_interpret(0.2)
    if eta_large == 3 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 18: Welch t-test has CI lower < CI upper
    if r3.ci_lower < r3.ci_upper { pass = pass + 1 } else { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
