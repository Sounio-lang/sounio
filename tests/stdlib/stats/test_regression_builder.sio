//@ check-only
// tests/stdlib/stats/test_regression_builder.sio — Tests for LinearRegression Builder Pattern
//
// Tests for the builder pattern and method chaining API in stats/regression/linear.sio.

use stats::regression::linear::{
    LinearModel, LinearRegression, KnowledgeLinearModel,
    fit_simple_linear_regression, fit_linear_regression_epistemic,
    linear_regression_new,
}
use stats::shared::{BetaConfidence, beta_new, beta_combine, abs_f64}

// =============================================================================
// Helper: Build linear data inline (y = 2 + 3x + 0.1 noise)
// =============================================================================

fn make_x() -> [f64; 100] with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        x[i as usize] = i as f64
        i = i + 1
    }
    x
}

fn make_y() -> [f64; 100] with Mut, Div, Panic {
    var y: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        y[i as usize] = 2.0 + 3.0 * (i as f64) + 0.1
        i = i + 1
    }
    y
}

fn local_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// =============================================================================
// Test: linear_regression_new() top-level constructor
// =============================================================================

fn test_regression_new() with Mut, Div, Panic {
    let builder = linear_regression_new()
    assert(builder.n == 0)
}

// =============================================================================
// Test: Builder pattern via method chaining
// =============================================================================

fn test_regression_builder_with_data() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let builder = linear_regression_new()
        .with_data(x, y, 10)

    assert(builder.n == 10)
}

fn test_regression_builder_with_x_y_n() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let builder = linear_regression_new()
        .with_x(x)
        .with_y(y)
        .with_n(10)

    assert(builder.n == 10)
}

// =============================================================================
// Test: fit_simple()
// =============================================================================

fn test_regression_builder_fit_simple() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()

    let beta0 = model.coefficients[0]
    let beta1 = model.coefficients[1]

    assert(beta0 > 1.5 && beta0 < 2.5)
    assert(beta1 > 2.5 && beta1 < 3.5)
    assert(model.r_squared > 0.95)
}

// =============================================================================
// Test: LinearModel methods
// =============================================================================

fn test_linear_model_predict() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()

    // Predict at x=5: ~2 + 3*5 = 17
    let y_pred = model.predict(5.0)
    assert(y_pred > 16.0 && y_pred < 18.0)
}

fn test_linear_model_intercept_slope() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()

    let intercept = model.intercept()
    let slope = model.slope()

    assert(intercept > 1.5 && intercept < 2.5)
    assert(slope > 2.5 && slope < 3.5)
}

fn test_linear_model_slope_se() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()

    let se = model.slope_se()
    assert(se > 0.0 && se < 0.5)
}

fn test_linear_model_r2() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()

    let r2 = model.r2()
    let adj_r2 = model.adj_r2()

    assert(r2 > 0.95)
    assert(adj_r2 > 0.90)
}

fn test_linear_model_is_significant() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()

    assert(model.is_slope_significant())
}

fn test_linear_model_slope_ci() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()

    let (lo, hi) = model.slope_ci()

    assert(lo < 3.0)
    assert(hi > 3.0)
    assert(hi - lo < 1.0)
}

// =============================================================================
// Test: Full method chain
// =============================================================================

fn test_regression_method_chain() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let y_pred = linear_regression_new()
        .with_data(x, y, 10)
        .fit_simple()
        .predict(5.0)

    assert(y_pred > 16.0 && y_pred < 18.0)
}

// =============================================================================
// Test: Epistemic regression
// =============================================================================

fn test_regression_builder_fit_epistemic() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = linear_regression_new()
        .with_data(x, y, 10)
        .fit_epistemic()

    let beta0 = model.value.coefficients[0]
    let beta1 = model.value.coefficients[1]

    assert(beta0 > 1.5 && beta0 < 2.5)
    assert(beta1 > 2.5 && beta1 < 3.5)

    // method_code 0 = OLS
    assert(model.provenance.method_code == 0)
    assert(model.provenance.n_obs == 10)
    assert(model.provenance.n_predictors == 1)
}

// =============================================================================
// Test: Backward compatibility - standalone functions
// =============================================================================

fn test_regression_backward_compatibility_fit() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = fit_simple_linear_regression(x, y, 10)

    let beta0 = model.coefficients[0]
    let beta1 = model.coefficients[1]

    assert(beta0 > 1.5 && beta0 < 2.5)
    assert(beta1 > 2.5 && beta1 < 3.5)
}

fn test_regression_backward_compatibility_epistemic() with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()

    let model = fit_linear_regression_epistemic(x, y, 10)

    let beta0 = model.value.coefficients[0]
    let beta1 = model.value.coefficients[1]

    assert(beta0 > 1.5 && beta0 < 2.5)
    assert(beta1 > 2.5 && beta1 < 3.5)
}

// =============================================================================
// Main test runner
// =============================================================================

pub fn main() with Mut, Div, Panic {
    test_regression_new()
    test_regression_builder_with_data()
    test_regression_builder_with_x_y_n()
    test_regression_builder_fit_simple()
    test_linear_model_predict()
    test_linear_model_intercept_slope()
    test_linear_model_slope_se()
    test_linear_model_r2()
    test_linear_model_is_significant()
    test_linear_model_slope_ci()
    test_regression_method_chain()
    test_regression_builder_fit_epistemic()
    test_regression_backward_compatibility_fit()
    test_regression_backward_compatibility_epistemic()

    var i: i64 = 0
    while i < 3 { i = i + 1 }
}
