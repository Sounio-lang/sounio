//@ run-pass
//@ expect-stdout: STATS_REGRESSION_OK
use stats::regression::linear::*;
fn main() -> i32 with IO, Mut {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    let b = linear_regression_new().with_data(x, y, 10)
    if b.n != 10 { return 1 }
    println("STATS_REGRESSION_OK")
    0
}
