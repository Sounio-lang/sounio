//@ run-pass
// OLS diagnostics E2E (lean_single multi-module).
//
// Fixed design from cooks_distance suite selftest:
//   x={1,2,3,4,5}, y={1,2,3,4,10}
//   slope=2, intercept=-2; Cook's D5=2.25, D1=0.5625, max_d=2.25
// Plus textbook OLS x={1..5}, y={2,4,5,4,5}: slope=0.6, intercept=2.2
// and residual normality via Shapiro–Wilk on residuals of the clean fit.
//
// Engine: lean_single
// Gate:   bash scripts/stats_ols_diag_e2e_gate.sh

use stats::cooks_distance::{cooks_distance, CooksResult}
use stats::validation::{linear_regression, r_squared, LinearFit}
use stats::shapiro_wilk::{shapiro_wilk, ShapiroResult}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn near_f64(a: f64, b: f64, tol: f64) -> bool {
    return abs_f64(a - b) < tol
}

fn fail(code: i32) -> i32 with IO {
    print("FAIL code ")
    print(code)
    print("\n")
    return code
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // ----- Cook's D + OLS influence design -----
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    var d: [f64; 256] = [0.0; 256]
    x[0] = 1.0; x[1] = 2.0; x[2] = 3.0; x[3] = 4.0; x[4] = 5.0
    y[0] = 1.0; y[1] = 2.0; y[2] = 3.0; y[3] = 4.0; y[4] = 10.0
    let cr: CooksResult = cooks_distance(&x, &y, 5, &!d)
    if !near_f64(cr.slope, 2.0, 1.0e-9) { return fail(1) }
    if !near_f64(cr.intercept, 0.0 - 2.0, 1.0e-9) { return fail(2) }
    if !near_f64(d[4], 2.25, 1.0e-4) { return fail(3) }
    if !near_f64(d[0], 0.5625, 1.0e-4) { return fail(4) }
    if !near_f64(cr.max_d, 2.25, 1.0e-4) { return fail(5) }
    if cr.n_influential < 1 { return fail(6) }

    print("OLS_DIAG_E2E cook_slope=")
    print(cr.slope)
    print(" cook_intercept=")
    print(cr.intercept)
    print(" max_cooks=")
    print(cr.max_d)
    print(" d1=")
    print(d[0])
    print(" d5=")
    print(d[4])
    print(" n_infl=")
    print(cr.n_influential)
    print("\n")

    // ----- Textbook OLS -----
    var xt: [f64; 256] = [0.0; 256]
    var yt: [f64; 256] = [0.0; 256]
    xt[0] = 1.0; xt[1] = 2.0; xt[2] = 3.0; xt[3] = 4.0; xt[4] = 5.0
    yt[0] = 2.0; yt[1] = 4.0; yt[2] = 5.0; yt[3] = 4.0; yt[4] = 5.0
    let fit: LinearFit = linear_regression(&xt, &yt, 5)
    let r2 = r_squared(&xt, &yt, 5)
    if !near_f64(fit.slope, 0.6, 1.0e-12) { return fail(10) }
    if !near_f64(fit.intercept, 2.2, 1.0e-12) { return fail(11) }
    if !near_f64(r2, 0.6, 1.0e-12) { return fail(12) }

    print("OLS_DIAG_E2E ols_slope=")
    print(fit.slope)
    print(" ols_intercept=")
    print(fit.intercept)
    print(" ols_r2=")
    print(r2)
    print("\n")

    // ----- Residual normality (Shapiro W) on clean line residuals -----
    // For influence design residuals e = y - (2x - 2): e={1,0,-1,-2,2}
    var resid: [f64; 256] = [0.0; 256]
    resid[0] = 1.0; resid[1] = 0.0; resid[2] = 0.0 - 1.0; resid[3] = 0.0 - 2.0; resid[4] = 2.0
    let sw: ShapiroResult = shapiro_wilk(&resid, 5)
    // W must be finite in (0,1]; p not claimed for n=5
    if sw.w <= 0.0 || sw.w > 1.0 { return fail(20) }

    print("OLS_DIAG_E2E resid_shapiro_w=")
    print(sw.w)
    print(" resid_shapiro_p=")
    print(sw.p)
    print("\n")

    print("STATS_OLS_DIAG_E2E_OK\n")
    return 0
}
