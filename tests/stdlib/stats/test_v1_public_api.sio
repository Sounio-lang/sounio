//@ run-pass
// stats::v1 public API workflows: descriptive, group comparison, regression.

use stats::v1::{
    describe,
    compare_groups,
    regress_simple,
    beta_confidence,
    confidence_mean,
    summary_evidence_mean,
    comparison_evidence_mean,
    regression_evidence_mean,
}

fn make_group_a() -> [f64; 100] with Mut, Div, Panic {
    var data: [f64; 100] = [0.0; 100]
    data[0] = 10.0
    data[1] = 12.0
    data[2] = 14.0
    data[3] = 16.0
    data[4] = 18.0
    data
}

fn make_group_b() -> [f64; 100] with Mut, Div, Panic {
    var data: [f64; 100] = [0.0; 100]
    data[0] = 12.0
    data[1] = 14.0
    data[2] = 16.0
    data[3] = 18.0
    data[4] = 20.0
    data
}

fn make_group_bad_variance() -> [f64; 100] with Mut, Div, Panic {
    var data: [f64; 100] = [0.0; 100]
    data[0] = 12.0
    data[1] = 14.0
    data[2] = 16.0
    data[3] = 18.0
    data[4] = 80.0
    data
}

fn make_group_short() -> [f64; 100] with Mut, Div, Panic {
    var data: [f64; 100] = [0.0; 100]
    data[0] = 12.0
    data[1] = 80.0
    data
}

fn make_x() -> [f64; 100] with Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        x[i as usize] = i as f64
        i = i + 1
    }
    x
}

fn make_y() -> [f64; 100] with Mut, Div, Panic {
    var y: [f64; 100] = [0.0; 100]
    var i: i64 = 0
    while i < 10 {
        y[i as usize] = 2.0 + 3.0 * (i as f64) + 0.1
        i = i + 1
    }
    y
}

fn make_y_poor_fit() -> [f64; 100] with Mut, Div, Panic {
    var y: [f64; 100] = [0.0; 100]
    y[0] = 10.0
    y[1] = 30.0
    y[2] = 11.0
    y[3] = 29.0
    y[4] = 12.0
    y[5] = 28.0
    y[6] = 13.0
    y[7] = 27.0
    y[8] = 14.0
    y[9] = 26.0
    y
}

fn local_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn test_descriptive_workflow() -> i32 with Mut, Div, Panic {
    let data = make_group_a()
    let summary = describe(data, 5)

    if summary.n != 5 { return 1 }
    if local_abs(summary.mean - 14.0) > 0.001 { return 2 }
    if summary.variance < 9.9 { return 3 }
    if summary.variance > 10.1 { return 4 }
    if summary.std_dev < 3.1 { return 5 }
    if summary.std_dev > 3.2 { return 6 }
    if summary.std_error < 1.4 { return 7 }
    if summary.std_error > 1.5 { return 8 }
    if summary_evidence_mean(&summary) < 0.80 { return 9 }
    if confidence_mean(&summary.report.sample_evidence) < 0.80 { return 31 }
    if confidence_mean(&summary.report.variance_evidence) < 0.80 { return 32 }
    if confidence_mean(&summary.report.overall_evidence) < 0.80 { return 33 }
    return 0
}

fn test_group_comparison_workflow() -> i32 with Mut, Div, Panic {
    let a = make_group_a()
    let b = make_group_b()
    let comparison = compare_groups(a, 5, b, 5)

    if comparison.n_a != 5 { return 10 }
    if comparison.n_b != 5 { return 11 }
    if local_abs(comparison.mean_diff + 2.0) > 0.001 { return 12 }
    if comparison.se_diff < 1.9 { return 13 }
    if comparison.se_diff > 2.1 { return 14 }
    if comparison.ci_lower >= comparison.ci_upper { return 15 }
    if comparison_evidence_mean(&comparison) < 0.90 { return 16 }
    if confidence_mean(&comparison.report.sample_evidence) < 0.90 { return 34 }
    if confidence_mean(&comparison.report.balance_evidence) < 0.90 { return 35 }
    if confidence_mean(&comparison.report.variance_evidence) < 0.80 { return 36 }
    if confidence_mean(&comparison.report.overall_evidence) < 0.90 { return 37 }
    return 0
}

fn test_regression_workflow() -> i32 with Mut, Div, Panic {
    let x = make_x()
    let y = make_y()
    let workflow = regress_simple(x, y, 10)

    if workflow.model.intercept < 1.5 { return 20 }
    if workflow.model.intercept > 2.5 { return 21 }
    if workflow.model.slope < 2.5 { return 22 }
    if workflow.model.slope > 3.5 { return 23 }
    if workflow.model.r_squared < 0.95 { return 24 }
    if workflow.model.n != 10 { return 25 }
    if regression_evidence_mean(&workflow) < 0.90 { return 26 }
    if confidence_mean(&workflow.report.sample_evidence) < 0.90 { return 38 }
    if confidence_mean(&workflow.report.fit_evidence) < 0.80 { return 39 }
    if confidence_mean(&workflow.report.overall_evidence) < 0.90 { return 40 }
    return 0
}

fn test_beta_exports() -> i32 with Mut, Div, Panic {
    let confidence = beta_confidence(9.0, 1.0)
    if confidence_mean(&confidence) < 0.80 { return 30 }
    return 0
}

fn test_bad_data_lowers_evidence() -> i32 with Mut, Div, Panic {
    let good = make_group_a()
    let bad_variance = make_group_bad_variance()
    let short_bad = make_group_short()

    let good_summary = describe(good, 5)
    let bad_summary = describe(bad_variance, 5)
    if summary_evidence_mean(&bad_summary) >= summary_evidence_mean(&good_summary) { return 41 }
    if confidence_mean(&bad_summary.report.variance_evidence) >= confidence_mean(&good_summary.report.variance_evidence) { return 42 }

    let good_comparison = compare_groups(good, 5, make_group_b(), 5)
    let bad_comparison = compare_groups(good, 5, short_bad, 2)
    if comparison_evidence_mean(&bad_comparison) >= comparison_evidence_mean(&good_comparison) { return 43 }
    if confidence_mean(&bad_comparison.report.balance_evidence) >= confidence_mean(&good_comparison.report.balance_evidence) { return 44 }
    if confidence_mean(&bad_comparison.report.variance_evidence) >= confidence_mean(&good_comparison.report.variance_evidence) { return 45 }

    let x = make_x()
    let good_regression = regress_simple(x, make_y(), 10)
    let bad_regression = regress_simple(x, make_y_poor_fit(), 10)
    if regression_evidence_mean(&bad_regression) >= regression_evidence_mean(&good_regression) { return 46 }
    if confidence_mean(&bad_regression.report.fit_evidence) >= confidence_mean(&good_regression.report.fit_evidence) { return 47 }

    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    let d = test_descriptive_workflow()
    if d != 0 { return d }

    let g = test_group_comparison_workflow()
    if g != 0 { return g }

    let r = test_regression_workflow()
    if r != 0 { return r }

    let b = test_beta_exports()
    if b != 0 { return b }

    let bad = test_bad_data_lowers_evidence()
    if bad != 0 { return bad }

    return 0
}
