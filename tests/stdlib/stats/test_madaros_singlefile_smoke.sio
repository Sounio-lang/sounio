//@ run-pass
// Madaros single-file smoke — NO multi-module `use` chain.
//
// Self-contained Welch two-sample t on the drug/placebo n=8 design.
// Proves default Madaros can compile+run a pure single-file stats-shaped
// program. Does NOT claim multi-module Madaros import trust.
//
// Engine: default bin/souc (Madaros). Do not force lean_single for this smoke.
// Gate:   bash scripts/stats_madaros_singlefile_smoke_gate.sh

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn near_f64(a: f64, b: f64, tol: f64) -> bool {
    return abs_f64(a - b) < tol
}

fn mean8(data: &[f64; 8]) -> f64 with Mut, Div, Panic {
    var s = 0.0
    var i = 0
    while i < 8 {
        s = s + data[i as usize]
        i = i + 1
    }
    return s / 8.0
}

fn var8(data: &[f64; 8]) -> f64 with Mut, Div, Panic {
    let m = mean8(data)
    var ss = 0.0
    var i = 0
    while i < 8 {
        let d = data[i as usize] - m
        ss = ss + d * d
        i = i + 1
    }
    return ss / 7.0
}

fn sqrt_nr(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var drug: [f64; 8] = [0.0; 8]
    var placebo: [f64; 8] = [0.0; 8]
    drug[0] = 15.2; drug[1] = 18.1; drug[2] = 12.5; drug[3] = 20.3
    drug[4] = 16.8; drug[5] = 14.7; drug[6] = 19.2; drug[7] = 13.9
    placebo[0] = 8.3; placebo[1] = 10.1; placebo[2] = 7.5; placebo[3] = 11.2
    placebo[4] = 9.4; placebo[5] = 8.9; placebo[6] = 10.5; placebo[7] = 7.8

    let mx = mean8(&drug)
    let my = mean8(&placebo)
    let sx2 = var8(&drug)
    let sy2 = var8(&placebo)
    let se2x = sx2 / 8.0
    let se2y = sy2 / 8.0
    let se = sqrt_nr(se2x + se2y)
    let t = (mx - my) / se
    let num = (se2x + se2y) * (se2x + se2y)
    let denom = se2x * se2x / 7.0 + se2y * se2y / 7.0
    let df = num / denom

    // Closed-form oracle (same as scipy E2E vertical)
    let exp_t = 6.657160298051489
    let exp_df = 10.141137519725348
    if !near_f64(t, exp_t, 1.0e-9) {
        print("FAIL t\n")
        return 1
    }
    if !near_f64(df, exp_df, 1.0e-9) {
        print("FAIL df\n")
        return 2
    }

    print("MADAROS_SMOKE t=")
    print(t)
    print(" df=")
    print(df)
    print(" se=")
    print(se)
    print("\n")
    print("STATS_MADAROS_SINGLEFILE_SMOKE_OK\n")
    return 0
}
