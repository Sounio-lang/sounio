//@ run-pass
// Shapiro–Wilk public W/p E2E (lean_single multi-module).
//
// Oracles are Royston AS R94, the same approximation as
// tests/reference/shapiro_reference.cpp and stats_shapiro_reference.sio.
// The 1965 4 d.p. table is not what this implementation computes.
//
// Engine: SOUNIO_SOUC_ENGINE=lean_single
// Gate:   bash scripts/stats_shapiro_e2e_gate.sh

use stats::shapiro_wilk::{shapiro_wilk, ShapiroResult}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn near_f64(a: f64, b: f64, tol: f64) -> bool {
    return abs_f64(a - b) < tol
}

fn fail(code: i32) -> i32 with IO {
    print("FAIL code ")
    print(code)
    print("\n")
    return code
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // Case A: n=5 arithmetic 1..5, Royston AS R94.
    var a: [f64; 100] = [0.0; 100]
    a[0] = 1.0; a[1] = 2.0; a[2] = 3.0; a[3] = 4.0; a[4] = 5.0
    let ra: ShapiroResult = shapiro_wilk(&a, 5)
    if !near_f64(ra.w, 0.98676215544771961, 1.0e-9) { return fail(1) }
    if !near_f64(ra.p, 0.96717393596804047, 1.0e-6) { return fail(2) }

    print("SHAPIRO_E2E n5_w=")
    print(ra.w)
    print(" n5_p=")
    print(ra.p)
    print("\n")

    // Case B: n=10 near-linear 2..11 → W ≈ 0.970158460121212, p high
    var b: [f64; 100] = [0.0; 100]
    var i = 0
    while i < 10 {
        b[i as usize] = 2.0 + (i as f64)
        i = i + 1
    }
    let rb: ShapiroResult = shapiro_wilk(&b, 10)
    if !near_f64(rb.w, 0.97016461123066611, 1.0e-9) { return fail(3) }
    if rb.p <= 0.5 { return fail(4) }

    print("SHAPIRO_E2E n10_w=")
    print(rb.w)
    print(" n10_p=")
    print(rb.p)
    print("\n")

    // Case C: n=10 skew → W ≈ 0.738023544970166, p < 0.05
    var c: [f64; 100] = [0.0; 100]
    c[0] = 1.0; c[1] = 1.1; c[2] = 1.2; c[3] = 1.3; c[4] = 1.5
    c[5] = 2.0; c[6] = 3.0; c[7] = 5.0; c[8] = 8.0; c[9] = 13.0
    let rc: ShapiroResult = shapiro_wilk(&c, 10)
    if !near_f64(rc.w, 0.73781870358086632, 1.0e-9) { return fail(5) }
    if rc.p >= 0.05 { return fail(6) }

    print("SHAPIRO_E2E skew_w=")
    print(rc.w)
    print(" skew_p=")
    print(rc.p)
    print("\n")

    print("STATS_SHAPIRO_E2E_OK\n")
    return 0
}
