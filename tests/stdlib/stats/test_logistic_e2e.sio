//@ run-pass
//@ known-failure: Requires implementation
// E2E test for stdlib/stats/regression/logistic
// Tests: sigmoid, logit, fit_logistic_simple, fit_dose_response

use stats::regression::logistic::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: sigmoid(0) = 0.5
    let s0 = sigmoid(0.0)
    if check_near(s0, 0.5, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: sigmoid(large) -> 1.0
    let s_large = sigmoid(20.0)
    if s_large > 0.99 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: logit(0.5) = 0.0
    let l_half = logit(0.5)
    if check_near(l_half, 0.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: logit(sigmoid(x)) = x (round trip for x=2.0)
    let s2 = sigmoid(2.0)
    let l2 = logit(s2)
    if check_near(l2, 2.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: Fit logistic regression on dose-response data
    // Low doses -> 0, high doses -> 1
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    x[0] = 1.0;  y[0] = 0.0
    x[1] = 2.0;  y[1] = 0.0
    x[2] = 3.0;  y[2] = 0.0
    x[3] = 4.0;  y[3] = 0.0
    x[4] = 5.0;  y[4] = 1.0
    x[5] = 6.0;  y[5] = 0.0
    x[6] = 7.0;  y[6] = 1.0
    x[7] = 8.0;  y[7] = 1.0
    x[8] = 9.0;  y[8] = 1.0
    x[9] = 10.0; y[9] = 1.0

    let model = fit_logistic_simple(x, y, 10)

    // slope (beta1) should be positive
    if model.beta[1] > 0.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: model should converge
    if model.converged {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: odds ratio for x should be > 1
    if model.odds_ratios[1] > 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
