//@ run-pass
// E2E test for stdlib/stats/timeseries/arima
// Tests: levinson_durbin, acf, fit_ar

use stats::timeseries::arima::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: Levinson-Durbin for AR(1) with phi=0.7
    // For AR(1) with phi=0.7, the ACF is r(k) = 0.7^k
    // r(0)=1.0, r(1)=0.7, r(2)=0.49, r(3)=0.343
    var acf_vals: [f64; 20] = [0.0; 20]
    acf_vals[0] = 1.0
    acf_vals[1] = 0.7
    acf_vals[2] = 0.49
    acf_vals[3] = 0.343
    acf_vals[4] = 0.2401

    let ar1 = levinson_durbin(acf_vals, 1)
    // Should recover phi_1 = 0.7
    if check_near(ar1[0], 0.7, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: Levinson-Durbin for AR(2) with phi1=0.5, phi2=0.3
    // ACF: r(1) = phi1/(1-phi2) = 0.5/0.7 = 0.7143
    //       r(2) = phi1*r(1) + phi2 = 0.5*0.7143 + 0.3 = 0.6571
    var acf2: [f64; 20] = [0.0; 20]
    acf2[0] = 1.0
    acf2[1] = 0.7143
    acf2[2] = 0.6571
    acf2[3] = 0.5540
    acf2[4] = 0.4670

    let ar2 = levinson_durbin(acf2, 2)
    // Should approximately recover phi1=0.5, phi2=0.3
    if check_near(ar2[0], 0.5, 0.1) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if check_near(ar2[1], 0.3, 0.1) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: fit_ar on a simple AR(1) process
    // Build an AR(1) process: y[t] = 0.8 * y[t-1] + noise
    var series: [f64; 500] = [0.0; 500]
    series[0] = 1.0
    var i: i64 = 1
    while i < 100 {
        series[i as usize] = 0.8 * series[(i - 1) as usize] + 0.1 * ((i % 7) as f64 - 3.0)
        i = i + 1
    }

    let result = fit_ar(series, 100, 1)
    // AR(1) coefficient should be approximately 0.8
    let ar1_coeff = result.ar_coeffs[0]
    let diff = ar1_coeff - 0.8
    let abs_diff = if diff < 0.0 { 0.0 - diff } else { diff }
    if abs_diff < 0.3 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: AIC should be finite (not nan or inf)
    let aic_val = result.aic
    if aic_val > 0.0 - 1.0e20 && aic_val < 1.0e20 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
