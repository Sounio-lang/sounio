//@ run-pass
//@ known-failure: Requires implementation
// E2E test for stdlib/optimize/nelder_mead
// Tests: nm_config_default, nm_quadratic, nm_rosenbrock, quadratic, rosenbrock

use optimize::nelder_mead::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: quadratic minimum at (3, 2)
    let config = nm_config_default()
    var init: [f64; 20] = [0.0; 20]
    init[0] = 0.0
    init[1] = 0.0

    let result = nm_quadratic(init, 2, config)

    // Should converge
    if result.converged {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: optimal x[0] should be near 3.0
    if check_near(result.params[0], 3.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: optimal x[1] should be near 2.0
    if check_near(result.params[1], 2.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: optimal value should be near 0.0
    if check_near(result.value, 0.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: Rosenbrock minimum at (1, 1)
    var init_r: [f64; 20] = [0.0; 20]
    init_r[0] = 0.0 - 1.0
    init_r[1] = 1.0

    var rosen_config = nm_config_default()
    rosen_config.max_iterations = 10000

    let rosen_result = nm_rosenbrock(init_r, 2, rosen_config)

    // Rosenbrock is harder; check if it improved from initial
    let init_val = rosenbrock(init_r)
    if rosen_result.value < init_val {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: function evaluations should be > 0
    if result.func_evals > 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
