//@ run-pass
// E2E test for stdlib/optimize/bfgs
// Tests: bfgs_config_default, bfgs_quadratic, bfgs_rosenbrock, quadratic

use optimize::bfgs::*
use test::helpers::check_near

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: BFGS on quadratic, minimum at (3, 2)
    let config = bfgs_config_default()
    var init: [f64; 20] = [0.0; 20]
    init[0] = 0.0
    init[1] = 0.0

    let result = bfgs_quadratic(init, 2, config)

    // Should converge
    if result.converged {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: optimal x[0] near 3.0
    if check_near(result.params[0], 3.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: optimal x[1] near 2.0
    if check_near(result.params[1], 2.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: optimal value near 0.0
    if check_near(result.value, 0.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: BFGS on Rosenbrock from (0, 0)
    var init_r: [f64; 20] = [0.0; 20]
    init_r[0] = 0.0
    init_r[1] = 0.0
    let rosen_result = bfgs_rosenbrock(init_r, 2, config)

    // Should improve from initial
    let init_val = rosenbrock(init_r)
    if rosen_result.value < init_val {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: grad_evals should be positive
    if result.grad_evals > 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
