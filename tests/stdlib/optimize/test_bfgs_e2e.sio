//@ run-pass
//@ contract-adjustment: updated to current optimize::bfgs solver entrypoint names (bfgs_bfgs_*)
// E2E test for stdlib/optimize/bfgs

use optimize::bfgs::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    let config = bfgs_config_default()
    var init: [f64; 20] = [0.0; 20]
    init[0] = 0.0
    init[1] = 0.0

    let result = bfgs_bfgs_quadratic(init, 2, config)

    if result.converged {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if check_near(result.params[0], 3.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if check_near(result.params[1], 2.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if check_near(result.value, 0.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    var init_r: [f64; 20] = [0.0; 20]
    init_r[0] = 0.0
    init_r[1] = 0.0
    let rosen_result = bfgs_bfgs_rosenbrock(init_r, 2, config)

    let init_val = bfgs_rosenbrock(init_r)
    if rosen_result.value < init_val {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if result.grad_evals > 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
