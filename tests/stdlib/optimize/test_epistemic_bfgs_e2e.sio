//@ run-pass
// tests/stdlib/optimize/test_epistemic_bfgs_e2e.sio — E2E Tests for Epistemic BFGS
//
// Tests for uncertainty-aware optimization with GUM-compliant gradient propagation.

use optimize::epistemic_bfgs::{
    EpistemicParams, EpistemicGradient, EpistemicBFGSConfig, EpistemicBFGSResult,
    eparams_zeros, eparams_norm,
    epistemic_bfgs_config_default,
    epistemic_bfgs_quadratic,
    ebfgs_compute_step_size,
}

// =============================================================================
// Test: Quadratic Optimization Convergence
// =============================================================================

fn test_epistemic_bfgs_convergence() with IO, Mut, Panic, Div {
    // Initial point (0, 0) with uncertainty
    var initial = eparams_zeros(2)
    initial.values[0] = 0.0
    initial.values[1] = 0.0
    initial.uncertainties[0] = 0.01
    initial.uncertainties[1] = 0.01
    initial.confidences[0] = 0.95
    initial.confidences[1] = 0.95
    
    let config = epistemic_bfgs_config_default()
    let result = epistemic_bfgs_quadratic(&initial, &config)
    
    // Should converge to (3, 2)
    assert(result.converged)
    assert(result.params.values[0] > 2.99 && result.params.values[0] < 3.01)
    assert(result.params.values[1] > 1.99 && result.params.values[1] < 2.01)
    
    // Uncertainty should be tracked
    assert(result.params.uncertainties[0] > 0.0)
    assert(result.final_grad_uncertainty >= 0.0)
    
    println("test_epistemic_bfgs_convergence passed!")
}

// =============================================================================
// Test: Uncertainty-Aware Step Size
// =============================================================================

fn test_epistemic_step_size() with IO, Mut, Panic, Div {
    let config = epistemic_bfgs_config_default()
    
    // Low uncertainty -> full step
    let alpha_low = ebfgs_compute_step_size(0.001, 1.0, &config)
    assert(alpha_low > 0.9)
    
    // High uncertainty -> reduced step
    let alpha_high = ebfgs_compute_step_size(1.0, 1.0, &config)
    assert(alpha_high < alpha_low)
    
    // Very high uncertainty -> very small step
    let alpha_very_high = ebfgs_compute_step_size(10.0, 1.0, &config)
    assert(alpha_very_high < 0.2)
    
    println("test_epistemic_step_size passed!")
}

// =============================================================================
// Test: Confidence Degradation Through Optimization
// =============================================================================

fn test_epistemic_confidence_degradation() with IO, Mut, Panic, Div {
    var initial = eparams_zeros(2)
    initial.values[0] = 0.0
    initial.values[1] = 0.0
    initial.uncertainties[0] = 0.01
    initial.uncertainties[1] = 0.01
    initial.confidences[0] = 0.95
    initial.confidences[1] = 0.90
    
    let config = epistemic_bfgs_config_default()
    let result = epistemic_bfgs_quadratic(&initial, &config)
    
    // Confidence should be preserved or degraded
    assert(result.params.confidences[0] <= 0.95)
    assert(result.params.confidences[1] <= 0.90)
    
    println("test_epistemic_confidence_degradation passed!")
}

// =============================================================================
// Main Test Runner
// =============================================================================

pub fn main() {
    test_epistemic_bfgs_convergence()
    test_epistemic_step_size()
    test_epistemic_confidence_degradation()
    println("All Epistemic BFGS E2E tests passed!")
}
