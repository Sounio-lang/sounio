// Deepened run-proof for optimize::nelder_mead::nm_quadratic.
// The library quadratic is (x-3)^2 + (y-2)^2. The inlined run-pass does not
// call this function. lean_single.
use optimize::nelder_mead::*

fn ae(a: f64, b: f64) -> f64 {
    if a > b { a - b } else { b - a }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var start: [f64; 20] = [0.0; 20]
    let cfg = nm_config_default()
    let hit = nm_quadratic(start, 2, cfg)
    if !hit.converged { print("FAIL conv\n"); return 1 }
    if ae(hit.value, 0.0) >= 1.0e-8 { print("FAIL value\n"); return 2 }
    if ae(hit.params[0], 3.0) >= 1.0e-4 { print("FAIL x\n"); return 3 }
    if ae(hit.params[1], 2.0) >= 1.0e-4 { print("FAIL y\n"); return 4 }
    if ae(quadratic(hit.params), hit.value) >= 1.0e-12 { print("FAIL quad\n"); return 5 }
    print("NM_QUADRATIC_DEEP_STDLIB_OK\n")
    return 0
}
