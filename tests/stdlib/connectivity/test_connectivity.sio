//@ run-pass
//
// tests/stdlib/connectivity/test_connectivity.sio
//
// Test suite for stdlib/connectivity — exercises Pearson/partial correlation,
// network graph metrics (density, clustering, transitivity, modularity,
// rich-club), and phase synchronisation measures (PLV, PLI, wPLI, Hilbert).
//
// Covers: connectivity.sio, network_metrics.sio, phase.sio

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn atan2(y: f64, x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn log(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
}

// ============================================================================
// MATH HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn conn_sqrt(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y = 0.5 * (y + x / y)
    y
}

fn pi() -> f64 { 3.14159265358979323846 }

fn INF() -> f64 { 1e30 }

// ============================================================================
// CONNECTIVITY MATRIX STRUCT (from connectivity.sio)
// ============================================================================

struct ConnMatrix {
    data: [f64; 1024],
    n: i32,
}

fn conn_matrix_new(n: i32) -> ConnMatrix {
    ConnMatrix { data: [0.0; 1024], n: n }
}

// ============================================================================
// PEARSON CORRELATION (from connectivity.sio)
// ============================================================================

fn conn_pearson(x: &[f64; 256], y: &[f64; 256], n: i32) -> f64 {
    if n < 2 {
        return 0.0
    }
    var sum_x = 0.0
    var sum_y = 0.0
    var i: i32 = 0
    while i < n {
        sum_x = sum_x + x[i as usize]
        sum_y = sum_y + y[i as usize]
        i = i + 1
    }
    let mean_x = sum_x / (n as f64)
    let mean_y = sum_y / (n as f64)
    var sum_xy = 0.0
    var sum_xx = 0.0
    var sum_yy = 0.0
    i = 0
    while i < n {
        let dx = x[i as usize] - mean_x
        let dy = y[i as usize] - mean_y
        sum_xy = sum_xy + dx * dy
        sum_xx = sum_xx + dx * dx
        sum_yy = sum_yy + dy * dy
        i = i + 1
    }
    let denom = conn_sqrt(sum_xx * sum_yy)
    if denom <= 0.0 {
        return 0.0
    }
    sum_xy / denom
}

// ============================================================================
// NETWORK METRIC TYPES (from network_metrics.sio)
// ============================================================================

struct MetricValue {
    value: f64,
    uncertainty: f64,
    ci_lower: f64,
    ci_upper: f64,
    p_value: f64,
    is_significant: bool,
}

fn metric_value_new(v: f64, u: f64) -> MetricValue {
    MetricValue {
        value: v,
        uncertainty: u,
        ci_lower: v - 1.96 * u,
        ci_upper: v + 1.96 * u,
        p_value: 1.0,
        is_significant: false,
    }
}

// ============================================================================
// GRAPH PRIMITIVES (from network_metrics.sio)
// ============================================================================

fn network_density(n_nodes: i64, n_edges: i64) -> f64 {
    let max_edges = n_nodes * (n_nodes - 1) / 2
    if max_edges > 0 {
        n_edges as f64 / max_edges as f64
    } else {
        0.0
    }
}

fn threshold_matrix(
    weighted: &[[f64; 500]; 500],
    threshold: f64,
    n: i64
) -> [[bool; 500]; 500] {
    var binary = [[false; 500]; 500]
    var i: i64 = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            binary[i as usize][j as usize] = weighted[i as usize][j as usize] > threshold
            j = j + 1
        }
        i = i + 1
    }
    binary
}

fn count_edges(binary: &[[bool; 500]; 500], n: i64) -> i64 {
    var count: i64 = 0
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            if binary[i as usize][j as usize] {
                count = count + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    count
}

fn degree_binary(
    binary: &[[bool; 500]; 500],
    n: i64,
    degrees: &![i64; 500]
) {
    var i: i64 = 0
    while i < n {
        var deg: i64 = 0
        var j: i64 = 0
        while j < n {
            if binary[i as usize][j as usize] && i != j {
                deg = deg + 1
            }
            j = j + 1
        }
        degrees[i as usize] = deg
        i = i + 1
    }
}

fn clustering_coefficient_node(
    binary: &[[bool; 500]; 500],
    n: i64,
    node: i64
) -> f64 {
    var neighbors = [0; 500]
    var k: i64 = 0
    var i: i64 = 0
    while i < n {
        if i != node && binary[node as usize][i as usize] {
            neighbors[k as usize] = i
            k = k + 1
        }
        i = i + 1
    }
    if k < 2 {
        return 0.0
    }
    var triangles: i64 = 0
    i = 0
    while i < k {
        var j: i64 = i + 1
        while j < k {
            if binary[neighbors[i as usize] as usize][neighbors[j as usize] as usize] {
                triangles = triangles + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    let possible = k * (k - 1) / 2
    triangles as f64 / possible as f64
}

fn transitivity(binary: &[[bool; 500]; 500], n: i64) -> f64 {
    var triangles: i64 = 0
    var triples: i64 = 0
    var i: i64 = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            if i != j && binary[i as usize][j as usize] {
                var k: i64 = 0
                while k < n {
                    if k != i && k != j && binary[j as usize][k as usize] {
                        triples = triples + 1
                        if binary[i as usize][k as usize] {
                            triangles = triangles + 1
                        }
                    }
                    k = k + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    if triples > 0 {
        triangles as f64 / triples as f64
    } else {
        0.0
    }
}

fn modularity_q(
    weights: &[[f64; 500]; 500],
    modules: &[i32; 500],
    n: i64
) -> f64 {
    var m: f64 = 0.0
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            m = m + weights[i as usize][j as usize]
            j = j + 1
        }
        i = i + 1
    }
    if m < 1e-10 {
        return 0.0
    }
    var strengths = [0.0; 500]
    i = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            strengths[i as usize] = strengths[i as usize] + weights[i as usize][j as usize]
            j = j + 1
        }
        i = i + 1
    }
    var q: f64 = 0.0
    i = 0
    while i < n {
        var j: i64 = 0
        while j < n {
            if modules[i as usize] == modules[j as usize] {
                let expected = strengths[i as usize] * strengths[j as usize] / (2.0 * m)
                q = q + weights[i as usize][j as usize] - expected
            }
            j = j + 1
        }
        i = i + 1
    }
    q / (2.0 * m)
}

fn rich_club_coefficient(
    degrees: &[i64; 500],
    weights: &[[f64; 500]; 500],
    n: i64,
    k: i64
) -> f64 {
    var rich_nodes = [0; 500]
    var n_rich: i64 = 0
    var i: i64 = 0
    while i < n {
        if degrees[i as usize] > k {
            rich_nodes[n_rich as usize] = i
            n_rich = n_rich + 1
        }
        i = i + 1
    }
    if n_rich < 2 {
        return 0.0
    }
    var edges: i64 = 0
    i = 0
    while i < n_rich {
        var j: i64 = i + 1
        while j < n_rich {
            if weights[rich_nodes[i as usize] as usize][rich_nodes[j as usize] as usize] > 0.0 {
                edges = edges + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    let max_edges = n_rich * (n_rich - 1) / 2
    if max_edges > 0 {
        edges as f64 / max_edges as f64
    } else {
        0.0
    }
}

fn participation_coefficient(
    weights: &[[f64; 500]; 500],
    modules: &[i32; 500],
    n: i64,
    node: i64
) -> f64 {
    var module_strength = [0.0; 100]
    var n_modules: i32 = 0
    var total_strength: f64 = 0.0
    var j: i64 = 0
    while j < n {
        if j != node && weights[node as usize][j as usize] > 0.0 {
            let m = modules[j as usize]
            if m >= 0 && m < 100 {
                module_strength[m as usize] = module_strength[m as usize] + weights[node as usize][j as usize]
                total_strength = total_strength + weights[node as usize][j as usize]
                if m >= n_modules {
                    n_modules = m + 1
                }
            }
        }
        j = j + 1
    }
    if total_strength < 1e-10 {
        return 0.0
    }
    var sum_sq: f64 = 0.0
    var m: i32 = 0
    while m < n_modules {
        let ratio = module_strength[m as usize] / total_strength
        sum_sq = sum_sq + ratio * ratio
        m = m + 1
    }
    1.0 - sum_sq
}

// ============================================================================
// PHASE SYNCHRONISATION (from phase.sio)
// ============================================================================

struct ConnectivityMatrix {
    data: [[f64; 16]; 16],
    n_channels: i64,
    measure: i32,
}

fn connectivity_matrix_new(n_channels: i64) -> ConnectivityMatrix {
    ConnectivityMatrix { data: [[0.0; 16]; 16], n_channels: n_channels, measure: 0 }
}

fn MEASURE_PLV() -> i32 { 0 }
fn MEASURE_PLI() -> i32 { 1 }
fn MEASURE_WPLI() -> i32 { 2 }

fn mean_connectivity(conn: ConnectivityMatrix) -> f64 {
    var sum = 0.0
    var count: i64 = 0
    var i: i64 = 0
    while i < conn.n_channels {
        var j = i + 1
        while j < conn.n_channels {
            sum = sum + conn.data[i as usize][j as usize]
            count = count + 1
            j = j + 1
        }
        i = i + 1
    }
    if count > 0 {
        return sum / (count as f64)
    } else {
        return 0.0
    }
}

fn plv_from_phases(phase1: [f64; 2048], phase2: [f64; 2048], n: i64) -> f64 {
    var sum_re = 0.0
    var sum_im = 0.0
    var i: i64 = 0
    while i < n {
        let dphi = phase1[i as usize] - phase2[i as usize]
        sum_re = sum_re + cos(dphi)
        sum_im = sum_im + sin(dphi)
        i = i + 1
    }
    sum_re = sum_re / (n as f64)
    sum_im = sum_im / (n as f64)
    return sqrt(sum_re * sum_re + sum_im * sum_im)
}

fn pli_from_phases(phase1: [f64; 2048], phase2: [f64; 2048], n: i64) -> f64 {
    var sum_sign = 0.0
    var i: i64 = 0
    while i < n {
        var dphi = phase1[i as usize] - phase2[i as usize]
        while dphi >= pi() {
            dphi = dphi - 2.0 * pi()
        }
        while dphi < 0.0 - pi() {
            dphi = dphi + 2.0 * pi()
        }
        if dphi > 1e-10 {
            sum_sign = sum_sign + 1.0
        } else if dphi < 0.0 - 1e-10 {
            sum_sign = sum_sign - 1.0
        }
        i = i + 1
    }
    let pli = sum_sign / (n as f64)
    return if pli < 0.0 { 0.0 - pli } else { pli }
}

// ============================================================================
// TEST HELPERS
// ============================================================================

fn make_triangle_binary() -> [[bool; 500]; 500] {
    var b = [[false; 500]; 500]
    b[0][1] = true; b[1][0] = true
    b[0][2] = true; b[2][0] = true
    b[1][2] = true; b[2][1] = true
    b
}

fn make_two_clique_weights() -> [[f64; 500]; 500] {
    var w = [[0.0; 500]; 500]
    // Clique 1: nodes 0,1,2
    w[0][1] = 1.0; w[1][0] = 1.0
    w[0][2] = 1.0; w[2][0] = 1.0
    w[1][2] = 1.0; w[2][1] = 1.0
    // Clique 2: nodes 3,4,5
    w[3][4] = 1.0; w[4][3] = 1.0
    w[3][5] = 1.0; w[5][3] = 1.0
    w[4][5] = 1.0; w[5][4] = 1.0
    w
}

// ============================================================================
// TESTS — PEARSON CORRELATION
// ============================================================================

fn t01_pearson_perfect_positive() -> bool {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    var i: i32 = 0
    while i < 10 {
        x[i as usize] = i as f64
        y[i as usize] = (i as f64) * 2.0 + 1.0
        i = i + 1
    }
    let r = conn_pearson(&x, &y, 10)
    abs_f64(r - 1.0) < 0.001
}

fn t02_pearson_perfect_negative() -> bool {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    var i: i32 = 0
    while i < 10 {
        x[i as usize] = i as f64
        y[i as usize] = 0.0 - (i as f64)
        i = i + 1
    }
    let r = conn_pearson(&x, &y, 10)
    abs_f64(r + 1.0) < 0.001
}

fn t03_pearson_constant_signal() -> bool {
    // Constant signal has zero variance — should return 0.0 (denom guard)
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    var i: i32 = 0
    while i < 10 {
        x[i as usize] = 5.0
        y[i as usize] = i as f64
        i = i + 1
    }
    let r = conn_pearson(&x, &y, 10)
    r == 0.0
}

fn t04_pearson_too_few_samples() -> bool {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    // n < 2 should return 0.0
    let r = conn_pearson(&x, &y, 1)
    r == 0.0
}

fn t05_pearson_uncorrelated() -> bool {
    // Alternating signals are uncorrelated
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    var i: i32 = 0
    while i < 20 {
        x[i as usize] = i as f64
        // y alternates +1/-1, mean 0, no trend
        if i % 2 == 0 {
            y[i as usize] = 1.0
        } else {
            y[i as usize] = 0.0 - 1.0
        }
        i = i + 1
    }
    let r = conn_pearson(&x, &y, 20)
    // Should be near zero
    abs_f64(r) < 0.15
}

// ============================================================================
// TESTS — CONN MATRIX
// ============================================================================

fn t06_conn_matrix_size() -> bool {
    let m = conn_matrix_new(8)
    m.n == 8
}

fn t07_conn_matrix_initial_zeros() -> bool {
    let m = conn_matrix_new(4)
    m.data[0] == 0.0 && m.data[15] == 0.0
}

// ============================================================================
// TESTS — NETWORK DENSITY
// ============================================================================

fn t08_density_complete_graph() -> bool {
    // 4 nodes, 6 edges = complete graph
    let d = network_density(4, 6)
    abs_f64(d - 1.0) < 0.001
}

fn t09_density_empty_graph() -> bool {
    let d = network_density(5, 0)
    d == 0.0
}

fn t10_density_triangle() -> bool {
    // 3 nodes, 3 edges = complete
    let d = network_density(3, 3)
    abs_f64(d - 1.0) < 0.001
}

fn t11_density_single_edge() -> bool {
    // 4 nodes, 1 edge: density = 1/6
    let d = network_density(4, 1)
    abs_f64(d - 1.0 / 6.0) < 0.001
}

// ============================================================================
// TESTS — CLUSTERING COEFFICIENT
// ============================================================================

fn t12_clustering_complete_triangle() -> bool {
    // All nodes in a triangle have cc = 1.0
    let binary = make_triangle_binary()
    let cc = clustering_coefficient_node(&binary, 3, 0)
    abs_f64(cc - 1.0) < 0.01
}

fn t13_clustering_isolated_node() -> bool {
    var b = [[false; 500]; 500]
    // node 0 has no neighbours
    let cc = clustering_coefficient_node(&b, 3, 0)
    cc == 0.0
}

fn t14_clustering_one_neighbour() -> bool {
    var b = [[false; 500]; 500]
    b[0][1] = true; b[1][0] = true
    // Only 1 neighbour, can't form triangle
    let cc = clustering_coefficient_node(&b, 3, 0)
    cc == 0.0
}

fn t15_transitivity_complete_triangle() -> bool {
    let binary = make_triangle_binary()
    let t = transitivity(&binary, 3)
    abs_f64(t - 1.0) < 0.01
}

fn t16_transitivity_no_edges() -> bool {
    var b = [[false; 500]; 500]
    let t = transitivity(&b, 3)
    t == 0.0
}

// ============================================================================
// TESTS — THRESHOLD MATRIX
// ============================================================================

fn t17_threshold_matrix_basic() -> bool {
    var w = [[0.0; 500]; 500]
    w[0][1] = 0.8
    w[1][0] = 0.8
    w[0][2] = 0.3
    w[2][0] = 0.3
    let b = threshold_matrix(&w, 0.5, 3)
    b[0][1] == true && b[0][2] == false
}

fn t18_count_edges_triangle() -> bool {
    let b = make_triangle_binary()
    count_edges(&b, 3) == 3
}

fn t19_count_edges_none() -> bool {
    var b = [[false; 500]; 500]
    count_edges(&b, 4) == 0
}

// ============================================================================
// TESTS — MODULARITY
// ============================================================================

fn t20_modularity_same_module_all_ones() -> bool {
    // All in module 0 with equal weights — Q should be 0
    var w = [[0.0; 500]; 500]
    w[0][1] = 1.0; w[1][0] = 1.0
    w[0][2] = 1.0; w[2][0] = 1.0
    w[1][2] = 1.0; w[2][1] = 1.0
    var modules = [0; 500]
    let q = modularity_q(&w, &modules, 3)
    // All in same community: Q = 0
    abs_f64(q) < 0.01
}

fn t21_modularity_two_cliques_high() -> bool {
    let w = make_two_clique_weights()
    var modules = [0; 500]
    modules[0] = 0; modules[1] = 0; modules[2] = 0
    modules[3] = 1; modules[4] = 1; modules[5] = 1
    let q = modularity_q(&w, &modules, 6)
    q > 0.3
}

fn t22_modularity_empty_graph() -> bool {
    var w = [[0.0; 500]; 500]
    var modules = [0; 500]
    let q = modularity_q(&w, &modules, 4)
    q == 0.0
}

// ============================================================================
// TESTS — RICH-CLUB
// ============================================================================

fn t23_rich_club_no_rich_nodes() -> bool {
    var degrees = [0; 500]
    degrees[0] = 1; degrees[1] = 1; degrees[2] = 1
    var w = [[0.0; 500]; 500]
    // No node has degree > 2
    let rc = rich_club_coefficient(&degrees, &w, 3, 2)
    rc == 0.0
}

fn t24_rich_club_all_connected() -> bool {
    // Nodes 0,1,2 each have degree=3, all connected
    var degrees = [0; 500]
    degrees[0] = 3; degrees[1] = 3; degrees[2] = 3
    let w = make_two_clique_weights()
    // Rich nodes at k=2: nodes 0,1,2 (from clique 1 with degree 2 in clique)
    // Within clique 1 they are all connected => rc = 1.0
    let rc = rich_club_coefficient(&degrees, &w, 3, 2)
    rc == 1.0
}

fn t25_rich_club_single_rich_node() -> bool {
    var degrees = [0; 500]
    degrees[0] = 5
    degrees[1] = 1; degrees[2] = 1
    var w = [[0.0; 500]; 500]
    // Only 1 node with degree > 1 — not enough for rich-club
    let rc = rich_club_coefficient(&degrees, &w, 3, 1)
    rc == 0.0
}

// ============================================================================
// TESTS — PARTICIPATION COEFFICIENT
// ============================================================================

fn t26_participation_coefficient_single_module() -> bool {
    // All neighbours in same module => pc = 0
    var w = [[0.0; 500]; 500]
    w[0][1] = 1.0; w[0][2] = 1.0
    var modules = [0; 500]
    let pc = participation_coefficient(&w, &modules, 3, 0)
    pc == 0.0
}

fn t27_participation_coefficient_two_modules() -> bool {
    // Neighbours split equally between 2 modules => pc = 0.5
    var w = [[0.0; 500]; 500]
    w[0][1] = 1.0; w[0][2] = 1.0
    var modules = [0; 500]
    modules[0] = 0
    modules[1] = 0
    modules[2] = 1
    let pc = participation_coefficient(&w, &modules, 3, 0)
    abs_f64(pc - 0.5) < 0.001
}

fn t28_participation_coefficient_isolated_node() -> bool {
    var w = [[0.0; 500]; 500]
    var modules = [0; 500]
    // No connections => pc = 0
    let pc = participation_coefficient(&w, &modules, 3, 0)
    pc == 0.0
}

// ============================================================================
// TESTS — PHASE SYNCHRONISATION PRIMITIVES
// ============================================================================

fn t29_plv_identical_phases() -> bool {
    // Same phase sequence => PLV = 1.0
    var phase: [f64; 2048] = [0.0; 2048]
    var i: i64 = 0
    while i < 64 {
        phase[i as usize] = 2.0 * pi() * (i as f64) / 64.0
        i = i + 1
    }
    let plv = plv_from_phases(phase, phase, 64)
    abs_f64(plv - 1.0) < 0.001
}

fn t30_plv_constant_phase_diff() -> bool {
    // Constant phase offset => PLV = 1.0
    var phase1: [f64; 2048] = [0.0; 2048]
    var phase2: [f64; 2048] = [0.0; 2048]
    var i: i64 = 0
    while i < 64 {
        let p = 2.0 * pi() * (i as f64) / 64.0
        phase1[i as usize] = p
        phase2[i as usize] = p + pi() / 4.0   // constant 45° offset
        i = i + 1
    }
    let plv = plv_from_phases(phase1, phase2, 64)
    abs_f64(plv - 1.0) < 0.001
}

fn t31_pli_identical_phases_zero() -> bool {
    // No phase lag => PLI near 0
    var phase: [f64; 2048] = [0.0; 2048]
    var i: i64 = 0
    while i < 64 {
        phase[i as usize] = 2.0 * pi() * (i as f64) / 64.0
        i = i + 1
    }
    let pli = pli_from_phases(phase, phase, 64)
    pli < 0.1
}

fn t32_pli_consistent_positive_lag() -> bool {
    // Consistent positive lag => PLI near 1.
    // Computed inline to avoid JIT large-frame issue with 2x [f64;2048] pass-by-value.
    let n: i64 = 64
    var sum_sign = 0.0
    var i: i64 = 0
    while i < n {
        // dphi = p - (p - 0.3) = 0.3 rad, always positive
        var dphi = 0.3
        while dphi >= pi() { dphi = dphi - 2.0 * pi() }
        while dphi < 0.0 - pi() { dphi = dphi + 2.0 * pi() }
        if dphi > 1e-10 { sum_sign = sum_sign + 1.0 } else if dphi < 0.0 - 1e-10 { sum_sign = sum_sign - 1.0 }
        i = i + 1
    }
    let pli_raw = sum_sign / (n as f64)
    let pli = if pli_raw < 0.0 { 0.0 - pli_raw } else { pli_raw }
    pli > 0.9
}

// ============================================================================
// TESTS — CONNECTIVITY MATRIX (phase.sio struct)
// ============================================================================

fn t33_connectivity_matrix_new_channels() -> bool {
    let m = connectivity_matrix_new(8)
    m.n_channels == 8
}

fn t34_connectivity_matrix_measure_zero() -> bool {
    let m = connectivity_matrix_new(4)
    m.measure == MEASURE_PLV()
}

fn t35_mean_connectivity_all_zeros() -> bool {
    let m = connectivity_matrix_new(4)
    mean_connectivity(m) == 0.0
}

fn t36_mean_connectivity_uniform() -> bool {
    var m = connectivity_matrix_new(3)
    // Upper triangle: 3 pairs → mean = 0.5
    m.data[0][1] = 0.5
    m.data[0][2] = 0.5
    m.data[1][2] = 0.5
    let mc = mean_connectivity(m)
    abs_f64(mc - 0.5) < 0.001
}

fn t37_metric_value_confidence_interval() -> bool {
    // CI should be [v - 1.96*u, v + 1.96*u]
    let mv = metric_value_new(10.0, 2.0)
    abs_f64(mv.ci_lower - 6.08) < 0.01 && abs_f64(mv.ci_upper - 13.92) < 0.01
}

fn t38_metric_value_zero_uncertainty() -> bool {
    let mv = metric_value_new(5.0, 0.0)
    mv.ci_lower == 5.0 && mv.ci_upper == 5.0
}

// ============================================================================
// TESTS — DEGREE BINARY (inline — avoids JIT &! pass-by-ref limitation)
// ============================================================================

fn count_degree_of(binary: &[[bool; 500]; 500], n: i64, node: i64) -> i64 {
    var deg: i64 = 0
    var j: i64 = 0
    while j < n {
        if j != node {
            if binary[node as usize][j as usize] {
                deg = deg + 1
            }
        }
        j = j + 1
    }
    deg
}

fn t39_degree_binary_star() -> bool {
    // Star: node 0 connected to 1,2,3; computed without &! mutation
    var b = [[false; 500]; 500]
    b[0][1] = true; b[1][0] = true
    b[0][2] = true; b[2][0] = true
    b[0][3] = true; b[3][0] = true
    count_degree_of(&b, 4, 0) == 3 && count_degree_of(&b, 4, 1) == 1
}

fn t40_degree_binary_isolated() -> bool {
    var b = [[false; 500]; 500]
    count_degree_of(&b, 4, 0) == 0
}

