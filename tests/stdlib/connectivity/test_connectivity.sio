//@ run-pass
//@ expect-stdout: CONNECTIVITY_OK
use connectivity::connectivity::*;
fn main() -> i32 with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    x[0] = 1.0; x[1] = 2.0; y[0] = 2.0; y[1] = 4.0
    if conn_pearson(&x, &y, 2) < 0.9 { return 1 }
    println("CONNECTIVITY_OK")
    0
}
