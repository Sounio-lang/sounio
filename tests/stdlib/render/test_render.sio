//@ run-pass
//@ known-failure: Requires implementation
// tests/stdlib/render/test_render.sio
// Test suite for stdlib/render/ — types, framebuffer, rasterizer, scene, pipeline, epistemic
//
// Covers:
//   T01 — Color constructors and channel values
//   T02 — Vec3 arithmetic (add, sub, scale, dot, cross, length_sq)
//   T03 — Framebuffer construction and pixel set/read
//   T04 — Framebuffer clear
//   T05 — Depth-buffer pixel replacement (nearest wins)
//   T06 — float_to_byte / clamp_byte
//   T07 — Rasterizer edge function
//   T08 — Rasterize triangle pixel count
//   T09 — Rasterize line sets pixels
//   T10 — Rasterize rect fills region
//   T11 — Camera defaults
//   T12 — Scene construction and project_point3d
//   T13 — RenderConfig defaults and HD preset
//   T14 — UncertainVertex and ConfidenceBand construction
//   T15 — Vertex and Triangle construction

// ============================================================================
// Inline: stdlib/render/types.sio
// ============================================================================

struct Color { r: f64, g: f64, b: f64, a: f64 }

fn color_rgb(r: f64, g: f64, b: f64) -> Color {
    Color { r: r, g: g, b: b, a: 1.0 }
}
fn color_rgba(r: f64, g: f64, b: f64, a: f64) -> Color {
    Color { r: r, g: g, b: b, a: a }
}
fn color_white() -> Color { Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 } }
fn color_black() -> Color { Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 } }
fn color_red()   -> Color { Color { r: 1.0, g: 0.0, b: 0.0, a: 1.0 } }
fn color_green() -> Color { Color { r: 0.0, g: 1.0, b: 0.0, a: 1.0 } }
fn color_blue()  -> Color { Color { r: 0.0, g: 0.0, b: 1.0, a: 1.0 } }

struct Vec2 { x: f64, y: f64 }
struct Vec3 { x: f64, y: f64, z: f64 }
struct Vec4 { x: f64, y: f64, z: f64, w: f64 }

fn vec3_add(a: Vec3, b: Vec3) -> Vec3 {
    Vec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }
}
fn vec3_sub(a: Vec3, b: Vec3) -> Vec3 {
    Vec3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }
}
fn vec3_scale(v: Vec3, s: f64) -> Vec3 {
    Vec3 { x: v.x * s, y: v.y * s, z: v.z * s }
}
fn vec3_dot(a: Vec3, b: Vec3) -> f64 {
    a.x * b.x + a.y * b.y + a.z * b.z
}
fn vec3_cross(a: Vec3, b: Vec3) -> Vec3 {
    Vec3 {
        x: a.y * b.z - a.z * b.y,
        y: a.z * b.x - a.x * b.z,
        z: a.x * b.y - a.y * b.x,
    }
}
fn vec3_length_sq(v: Vec3) -> f64 {
    v.x * v.x + v.y * v.y + v.z * v.z
}

struct Vertex {
    position: Vec3,
    color: Color,
    normal: Vec3,
    uv: Vec2,
}
fn vertex_new(pos: Vec3, col: Color) -> Vertex {
    Vertex {
        position: pos,
        color: col,
        normal: Vec3 { x: 0.0, y: 0.0, z: 1.0 },
        uv: Vec2 { x: 0.0, y: 0.0 },
    }
}

struct Triangle { v0: Vertex, v1: Vertex, v2: Vertex }

struct Canvas { width: i64, height: i64 }
fn canvas_new(w: i64, h: i64) -> Canvas { Canvas { width: w, height: h } }

// ============================================================================
// Inline: stdlib/render/framebuffer.sio
// ============================================================================

struct Framebuffer {
    width: i64,
    height: i64,
    r: [i64; 65536],
    g: [i64; 65536],
    b: [i64; 65536],
    depth: [f64; 65536],
}

fn fb_new(w: i64, h: i64) -> Framebuffer {
    Framebuffer {
        width: w, height: h,
        r: [0; 65536],
        g: [0; 65536],
        b: [0; 65536],
        depth: [1000000.0; 65536],
    }
}

fn fb_set_pixel(fb: &!Framebuffer, x: i64, y: i64, r: i64, g: i64, b: i64) with Mut, Panic {
    if x >= 0 && x < (*fb).width && y >= 0 && y < (*fb).height {
        let idx = y * (*fb).width + x
        (*fb).r[idx] = r
        (*fb).g[idx] = g
        (*fb).b[idx] = b
    }
}

fn fb_set_pixel_depth(fb: &!Framebuffer, x: i64, y: i64, z: f64, r: i64, g: i64, b: i64) with Mut, Panic {
    if x >= 0 && x < (*fb).width && y >= 0 && y < (*fb).height {
        let idx = y * (*fb).width + x
        if z < (*fb).depth[idx] {
            (*fb).r[idx] = r
            (*fb).g[idx] = g
            (*fb).b[idx] = b
            (*fb).depth[idx] = z
        }
    }
}

fn fb_clear(fb: &!Framebuffer, r: i64, g: i64, b: i64) with Mut, Panic, Div {
    var i: i64 = 0
    let total = (*fb).width * (*fb).height
    while i < total {
        (*fb).r[i] = r
        (*fb).g[i] = g
        (*fb).b[i] = b
        (*fb).depth[i] = 1000000.0
        i = i + 1
    }
}

fn clamp_byte(v: i64) -> i64 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    v
}

fn float_to_byte(f: f64) -> i64 {
    let v = (f * 255.0) as i64
    clamp_byte(v)
}

// ============================================================================
// Inline: stdlib/render/rasterizer.sio  (uses local Vec3/Color defined above)
// ============================================================================

struct Vertex2D { x: f64, y: f64, z: f64, r: f64, g: f64, b: f64 }

fn min_i64(a: i64, b: i64) -> i64 { if a < b { a } else { b } }
fn max_i64(a: i64, b: i64) -> i64 { if a > b { a } else { b } }
fn min_f64(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn max_f64(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

fn edge_fn(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) -> f64 {
    (cx - ax) * (by - ay) - (cy - ay) * (bx - ax)
}

fn rasterize_triangle(
    v0: Vertex2D, v1: Vertex2D, v2: Vertex2D,
    fb_r: &![i64; 65536], fb_g: &![i64; 65536], fb_b: &![i64; 65536],
    fb_depth: &![f64; 65536],
    fb_w: i64, fb_h: i64
) -> i64 with Mut, Div, Panic {
    let min_x = max_i64(0, (min_f64(min_f64(v0.x, v1.x), v2.x)) as i64)
    let max_x = min_i64(fb_w - 1, (max_f64(max_f64(v0.x, v1.x), v2.x)) as i64 + 1)
    let min_y = max_i64(0, (min_f64(min_f64(v0.y, v1.y), v2.y)) as i64)
    let max_y = min_i64(fb_h - 1, (max_f64(max_f64(v0.y, v1.y), v2.y)) as i64 + 1)
    let area = edge_fn(v0.x, v0.y, v1.x, v1.y, v2.x, v2.y)
    if area == 0.0 { return 0 }
    var pixels_written: i64 = 0
    var py: i64 = min_y
    while py <= max_y {
        var px: i64 = min_x
        while px <= max_x {
            let cx = (px as f64) + 0.5
            let cy = (py as f64) + 0.5
            let w0 = edge_fn(v1.x, v1.y, v2.x, v2.y, cx, cy)
            let w1 = edge_fn(v2.x, v2.y, v0.x, v0.y, cx, cy)
            let w2 = edge_fn(v0.x, v0.y, v1.x, v1.y, cx, cy)
            let inside = if area > 0.0 {
                w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0
            } else {
                w0 <= 0.0 && w1 <= 0.0 && w2 <= 0.0
            }
            if inside {
                let b0 = w0 / area
                let b1 = w1 / area
                let b2 = w2 / area
                let z = b0 * v0.z + b1 * v1.z + b2 * v2.z
                let idx = py * fb_w + px
                if z < (*fb_depth)[idx] {
                    let ri = b0 * v0.r + b1 * v1.r + b2 * v2.r
                    let gi = b0 * v0.g + b1 * v1.g + b2 * v2.g
                    let bi = b0 * v0.b + b1 * v1.b + b2 * v2.b
                    (*fb_r)[idx] = (ri * 255.0) as i64
                    (*fb_g)[idx] = (gi * 255.0) as i64
                    (*fb_b)[idx] = (bi * 255.0) as i64
                    (*fb_depth)[idx] = z
                    pixels_written = pixels_written + 1
                }
            }
            px = px + 1
        }
        py = py + 1
    }
    pixels_written
}

fn rasterize_line(
    x0: i64, y0: i64, x1: i64, y1: i64,
    r: i64, g: i64, b: i64,
    fb_r: &![i64; 65536], fb_g: &![i64; 65536], fb_b: &![i64; 65536],
    fb_w: i64, fb_h: i64
) with Mut, Panic, Div {
    var cx: i64 = x0
    var cy: i64 = y0
    var dx: i64 = x1 - x0
    var dy: i64 = y1 - y0
    if dx < 0 { dx = 0 - dx }
    if dy < 0 { dy = 0 - dy }
    let sx: i64 = if x0 < x1 { 1 } else { 0 - 1 }
    let sy: i64 = if y0 < y1 { 1 } else { 0 - 1 }
    var err: i64 = dx - dy
    var steps: i64 = 0
    let max_steps = dx + dy + 1
    while steps < max_steps {
        if cx >= 0 && cx < fb_w && cy >= 0 && cy < fb_h {
            let idx = cy * fb_w + cx
            (*fb_r)[idx] = r
            (*fb_g)[idx] = g
            (*fb_b)[idx] = b
        }
        if cx == x1 && cy == y1 { steps = max_steps }
        let e2 = err * 2
        if e2 > (0 - dy) {
            err = err - dy
            cx = cx + sx
        }
        if e2 < dx {
            err = err + dx
            cy = cy + sy
        }
        steps = steps + 1
    }
}

fn rasterize_rect(
    x0: i64, y0: i64, rw: i64, rh: i64,
    r: i64, g: i64, b: i64,
    fb_r: &![i64; 65536], fb_g: &![i64; 65536], fb_b: &![i64; 65536],
    fb_w: i64, fb_h: i64
) with Mut, Panic, Div {
    var dy: i64 = 0
    while dy < rh {
        var dx: i64 = 0
        while dx < rw {
            let px = x0 + dx
            let py = y0 + dy
            if px >= 0 && px < fb_w && py >= 0 && py < fb_h {
                let idx = py * fb_w + px
                (*fb_r)[idx] = r
                (*fb_g)[idx] = g
                (*fb_b)[idx] = b
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// ============================================================================
// Inline: stdlib/render/scene.sio
// ============================================================================

struct Camera {
    pos_x: f64, pos_y: f64, pos_z: f64,
    target_x: f64, target_y: f64, target_z: f64,
    up_x: f64, up_y: f64, up_z: f64,
    fov: f64, near: f64, far: f64,
}

fn camera_default() -> Camera {
    Camera {
        pos_x: 0.0, pos_y: 0.0, pos_z: 5.0,
        target_x: 0.0, target_y: 0.0, target_z: 0.0,
        up_x: 0.0, up_y: 1.0, up_z: 0.0,
        fov: 60.0, near: 0.1, far: 100.0,
    }
}

struct Light {
    pos_x: f64, pos_y: f64, pos_z: f64,
    color_r: f64, color_g: f64, color_b: f64,
    intensity: f64,
}

fn light_point(x: f64, y: f64, z: f64, intensity: f64) -> Light {
    Light {
        pos_x: x, pos_y: y, pos_z: z,
        color_r: 1.0, color_g: 1.0, color_b: 1.0,
        intensity: intensity,
    }
}

struct Scene {
    triangle_count: i64,
    light_count: i64,
    camera: Camera,
}

fn scene_new() -> Scene {
    Scene { triangle_count: 0, light_count: 0, camera: camera_default() }
}

struct ScreenPt { sx: i64, sy: i64, depth: f64 }

fn project_point3d(
    wx: f64, wy: f64, wz: f64,
    focal: f64, z_offset: f64,
    fb_w: i64, fb_h: i64
) -> ScreenPt with Div, Panic {
    let z_cam = wz + z_offset
    let scale = focal / z_cam
    ScreenPt {
        sx: (wx * scale + ((fb_w as f64) * 0.5)) as i64,
        sy: ((0.0 - wy) * scale + ((fb_h as f64) * 0.5)) as i64,
        depth: z_cam,
    }
}

// ============================================================================
// Inline: stdlib/render/pipeline.sio
// ============================================================================

enum RenderBackend {
    BackendPPM,
    BackendSPIRV,
    BackendMetal,
    BackendWGSL,
}

struct RenderConfig {
    width: i64,
    height: i64,
    backend: RenderBackend,
    samples: i64,
    clear_r: f64,
    clear_g: f64,
    clear_b: f64,
}

fn render_config_default() -> RenderConfig {
    RenderConfig {
        width: 800, height: 600,
        backend: RenderBackend::BackendPPM,
        samples: 1,
        clear_r: 0.0, clear_g: 0.0, clear_b: 0.0,
    }
}

fn render_config_hd() -> RenderConfig {
    RenderConfig {
        width: 1920, height: 1080,
        backend: RenderBackend::BackendPPM,
        samples: 4,
        clear_r: 0.1, clear_g: 0.1, clear_b: 0.15,
    }
}

// ============================================================================
// Inline: stdlib/render/epistemic.sio
// ============================================================================

struct UncertainVertex {
    pos_x: f64, pos_y: f64, pos_z: f64,
    uncertainty: f64,
    color_r: f64, color_g: f64, color_b: f64,
}

fn uncertain_vertex(x: f64, y: f64, z: f64, eps: f64) -> UncertainVertex {
    UncertainVertex {
        pos_x: x, pos_y: y, pos_z: z, uncertainty: eps,
        color_r: 1.0, color_g: 1.0, color_b: 1.0,
    }
}

struct ConfidenceBand {
    center_x: f64, center_y: f64, center_z: f64,
    sigma: f64,
    color_r: f64, color_g: f64, color_b: f64,
    alpha: f64,
}

fn confidence_band_1sigma(cx: f64, cy: f64, cz: f64, sigma: f64) -> ConfidenceBand {
    ConfidenceBand {
        center_x: cx, center_y: cy, center_z: cz, sigma: sigma,
        color_r: 0.3, color_g: 0.5, color_b: 1.0, alpha: 0.3,
    }
}

enum UncertaintyVizMode {
    GaussianBlur,
    AlphaBlend,
    HeatmapGradient,
    ConfidenceContour,
}

// ============================================================================
// Test helpers
// ============================================================================

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn close(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

// ============================================================================
// MAIN — run all tests
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic {
    var passed: i64 = 0
    var failed: i64 = 0

    // ------------------------------------------------------------------
    // T01 — Color constructors
    // ------------------------------------------------------------------
    let white = color_white()
    let black = color_black()
    let red   = color_red()
    let green = color_green()
    let blue  = color_blue()
    let custom = color_rgba(0.5, 0.25, 0.75, 0.8)

    if white.r == 1.0 && white.g == 1.0 && white.b == 1.0 && white.a == 1.0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    if black.r == 0.0 && black.a == 1.0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    if red.r == 1.0 && red.g == 0.0 && red.b == 0.0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    if green.r == 0.0 && green.g == 1.0 && green.b == 0.0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    if blue.b == 1.0 && blue.r == 0.0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    if close(custom.r, 0.5, 0.001) && close(custom.a, 0.8, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // color_rgb sets alpha=1
    let rgb = color_rgb(0.2, 0.4, 0.6)
    if close(rgb.a, 1.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T02 — Vec3 arithmetic
    // ------------------------------------------------------------------
    let a3 = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
    let b3 = Vec3 { x: 4.0, y: 5.0, z: 6.0 }

    let sum3 = vec3_add(a3, b3)
    if close(sum3.x, 5.0, 0.001) && close(sum3.y, 7.0, 0.001) && close(sum3.z, 9.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    let diff3 = vec3_sub(b3, a3)
    if close(diff3.x, 3.0, 0.001) && close(diff3.y, 3.0, 0.001) && close(diff3.z, 3.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    let scaled = vec3_scale(a3, 2.0)
    if close(scaled.x, 2.0, 0.001) && close(scaled.z, 6.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // dot product: 1*4 + 2*5 + 3*6 = 32
    let dot = vec3_dot(a3, b3)
    if close(dot, 32.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // cross product of x-hat and y-hat = z-hat
    let xhat = Vec3 { x: 1.0, y: 0.0, z: 0.0 }
    let yhat = Vec3 { x: 0.0, y: 1.0, z: 0.0 }
    let zhat = vec3_cross(xhat, yhat)
    if close(zhat.x, 0.0, 0.001) && close(zhat.y, 0.0, 0.001) && close(zhat.z, 1.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // length_sq of (3,4,0) = 25
    let v345 = Vec3 { x: 3.0, y: 4.0, z: 0.0 }
    if close(vec3_length_sq(v345), 25.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T03 — Framebuffer: construction and pixel set/read
    // ------------------------------------------------------------------
    var fb = fb_new(8, 8)
    fb_set_pixel(&!fb, 0, 0, 100, 150, 200)
    if fb.r[0] == 100 && fb.g[0] == 150 && fb.b[0] == 200 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // out-of-bounds write must not crash; pixel stays 0
    fb_set_pixel(&!fb, 100, 100, 255, 255, 255)
    if fb.r[0] == 100 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // pixel at (3, 2) in an 8-wide fb => index 2*8+3 = 19
    fb_set_pixel(&!fb, 3, 2, 42, 43, 44)
    if fb.r[19] == 42 && fb.g[19] == 43 && fb.b[19] == 44 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T04 — Framebuffer clear
    // ------------------------------------------------------------------
    fb_clear(&!fb, 7, 8, 9)
    // all 64 pixels should be (7,8,9)
    var all_ok: bool = true
    var ci: i64 = 0
    while ci < 64 {
        if fb.r[ci] != 7 || fb.g[ci] != 8 || fb.b[ci] != 9 { all_ok = false }
        ci = ci + 1
    }
    if all_ok {
        passed = passed + 1
    } else { failed = failed + 1 }

    // depth should be reset to 1000000
    if close(fb.depth[0], 1000000.0, 1.0) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T05 — Depth-buffer: nearest pixel wins
    // ------------------------------------------------------------------
    var fb2 = fb_new(4, 4)
    // write at z=5.0 first
    fb_set_pixel_depth(&!fb2, 1, 1, 5.0, 200, 0, 0)
    // write closer z=2.0 — should overwrite
    fb_set_pixel_depth(&!fb2, 1, 1, 2.0, 0, 200, 0)
    // write farther z=8.0 — should not overwrite
    fb_set_pixel_depth(&!fb2, 1, 1, 8.0, 0, 0, 200)
    let idx11 = 1 * 4 + 1
    if fb2.r[idx11] == 0 && fb2.g[idx11] == 200 && fb2.b[idx11] == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }
    if close(fb2.depth[idx11], 2.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T06 — float_to_byte and clamp_byte
    // ------------------------------------------------------------------
    if float_to_byte(0.0) == 0 && float_to_byte(1.0) == 255 {
        passed = passed + 1
    } else { failed = failed + 1 }
    if float_to_byte(0.5) == 127 || float_to_byte(0.5) == 128 {
        passed = passed + 1
    } else { failed = failed + 1 }
    if clamp_byte(300) == 255 && clamp_byte(0 - 5) == 0 && clamp_byte(128) == 128 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T07 — Edge function
    // ------------------------------------------------------------------
    // Triangle (0,0)-(10,0)-(0,10): area = edge_fn(0,0, 10,0, 0,10) = -100
    let ef = edge_fn(0.0, 0.0, 10.0, 0.0, 0.0, 10.0)
    if ef != 0.0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // A point at centroid (3.3, 3.3) should be inside
    let ef_inside = edge_fn(0.0, 0.0, 10.0, 0.0, 3.33, 3.33)
    if ef_inside != 0.0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T08 — Rasterize triangle into 16x16 fb
    // ------------------------------------------------------------------
    var fb3 = fb_new(16, 16)
    let tv0 = Vertex2D { x: 0.0, y: 0.0, z: 1.0, r: 1.0, g: 0.0, b: 0.0 }
    let tv1 = Vertex2D { x: 8.0, y: 0.0, z: 1.0, r: 0.0, g: 1.0, b: 0.0 }
    let tv2 = Vertex2D { x: 0.0, y: 8.0, z: 1.0, r: 0.0, g: 0.0, b: 1.0 }
    let npix = rasterize_triangle(tv0, tv1, tv2,
        &!fb3.r, &!fb3.g, &!fb3.b, &!fb3.depth, 16, 16)
    if npix > 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // Degenerate (same vertices) should return 0 — use a fresh framebuffer
    var fb3b = fb_new(16, 16)
    let npix_degen = rasterize_triangle(tv0, tv0, tv0,
        &!fb3b.r, &!fb3b.g, &!fb3b.b, &!fb3b.depth, 16, 16)
    if npix_degen == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T09 — Rasterize line sets pixels on both endpoints
    // ------------------------------------------------------------------
    var fb4 = fb_new(16, 16)
    rasterize_line(0, 0, 7, 0, 255, 128, 64, &!fb4.r, &!fb4.g, &!fb4.b, 16, 16)
    // pixel (0,0) and (7,0) must be set
    if fb4.r[0] == 255 && fb4.r[7] == 255 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // vertical line
    var fb5 = fb_new(16, 16)
    rasterize_line(3, 0, 3, 5, 200, 100, 50, &!fb5.r, &!fb5.g, &!fb5.b, 16, 16)
    if fb5.r[0 * 16 + 3] == 200 && fb5.r[5 * 16 + 3] == 200 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T10 — Rasterize rect fills exact region
    // ------------------------------------------------------------------
    var fb6 = fb_new(16, 16)
    rasterize_rect(2, 2, 4, 3, 77, 88, 99, &!fb6.r, &!fb6.g, &!fb6.b, 16, 16)
    // pixel (2,2) must be set
    if fb6.r[2 * 16 + 2] == 77 {
        passed = passed + 1
    } else { failed = failed + 1 }
    // pixel (5,4) is last pixel inside 4-wide 3-tall rect starting at (2,2)
    if fb6.r[4 * 16 + 5] == 77 {
        passed = passed + 1
    } else { failed = failed + 1 }
    // pixel (6,2) is outside rect
    if fb6.r[2 * 16 + 6] == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T11 — Camera defaults
    // ------------------------------------------------------------------
    let cam = camera_default()
    if close(cam.pos_z, 5.0, 0.001) && close(cam.fov, 60.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }
    if close(cam.near, 0.1, 0.001) && close(cam.far, 100.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T12 — Scene construction + project_point3d
    // ------------------------------------------------------------------
    let sc = scene_new()
    if sc.triangle_count == 0 && sc.light_count == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // Project origin with z_offset=5, focal=100, 100x100 fb
    // z_cam = 0 + 5 = 5, scale = 100/5 = 20
    // sx = 0*20 + 50 = 50, sy = 0*20 + 50 = 50
    let pt = project_point3d(0.0, 0.0, 0.0, 100.0, 5.0, 100, 100)
    if pt.sx == 50 && pt.sy == 50 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // Verify depth is z_cam
    if close(pt.depth, 5.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // Light point constructor
    let lt = light_point(1.0, 2.0, 3.0, 0.8)
    if close(lt.intensity, 0.8, 0.001) && close(lt.pos_y, 2.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T13 — RenderConfig
    // ------------------------------------------------------------------
    let rc = render_config_default()
    if rc.width == 800 && rc.height == 600 && rc.samples == 1 {
        passed = passed + 1
    } else { failed = failed + 1 }

    let hd = render_config_hd()
    if hd.width == 1920 && hd.height == 1080 && hd.samples == 4 {
        passed = passed + 1
    } else { failed = failed + 1 }

    if close(hd.clear_b, 0.15, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T14 — Epistemic rendering types
    // ------------------------------------------------------------------
    let uv = uncertain_vertex(1.0, 2.0, 3.0, 0.05)
    if close(uv.pos_x, 1.0, 0.001) && close(uv.uncertainty, 0.05, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }
    if close(uv.color_r, 1.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    let cb = confidence_band_1sigma(0.0, 0.0, 0.0, 2.5)
    if close(cb.sigma, 2.5, 0.001) && close(cb.alpha, 0.3, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }
    if close(cb.color_b, 1.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T15 — Vertex and Triangle construction
    // ------------------------------------------------------------------
    let pos = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
    let col = color_red()
    let vtx = vertex_new(pos, col)
    if close(vtx.position.x, 1.0, 0.001) && close(vtx.color.r, 1.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }
    // normal defaults to (0,0,1)
    if close(vtx.normal.z, 1.0, 0.001) {
        passed = passed + 1
    } else { failed = failed + 1 }

    let canvas = canvas_new(320, 240)
    if canvas.width == 320 && canvas.height == 240 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // Summary
    // ------------------------------------------------------------------
    print("render tests passed=")
    print_int(passed)
    print(" failed=")
    print_int(failed)
    print("\n")

    if failed > 0 { return 1 }
    return 0
}
