//@ run-pass
// E2E: stdlib/core/result.sio — IntResult/FloatResult

use core::result::*;

fn run_tests() -> i32 {
    // IntResult Ok
    let ok = int_ok(42)
    if !ok.is_ok() { return 1 }
    if ok.is_err() { return 2 }
    if int_result_unwrap(&ok) != 42 { return 3 }
    if int_result_unwrap_or(&ok, 0) != 42 { return 4 }

    // IntResult Err
    let err = int_err(404)
    if err.is_ok() { return 5 }
    if !err.is_err() { return 6 }
    if int_result_err(&err) != 404 { return 7 }
    if int_result_unwrap_or(&err, 0 - 1) != 0 - 1 { return 8 }

    // FloatResult
    let fok = float_ok(3.14)
    if !float_result_is_ok(&fok) { return 9 }

    let ferr = float_err(500)
    if float_result_is_ok(&ferr) { return 10 }
    if float_result_err(&ferr) != 500 { return 11 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
