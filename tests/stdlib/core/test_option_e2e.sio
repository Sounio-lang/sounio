//@ run-pass
// E2E: stdlib/core/option.sio — IntOption/FloatOption

use core::option::*;

fn run_tests() -> i32 {
    // IntOption None
    let none = int_none()
    if int_option_is_some(&none) { return 1 }
    if !int_option_is_none(&none) { return 2 }
    if int_option_unwrap_or(&none, 42) != 42 { return 3 }

    // IntOption Some
    let some = int_some(99)
    if !int_option_is_some(&some) { return 4 }
    if int_option_is_none(&some) { return 5 }
    if int_option_unwrap(&some) != 99 { return 6 }
    if int_option_unwrap_or(&some, 0) != 99 { return 7 }

    // FloatOption
    let fnone = float_none()
    if float_option_is_some(&fnone) { return 8 }
    if float_option_unwrap_or(&fnone, 3.14) != 3.14 { return 9 }

    let fsome = float_some(2.718)
    if !float_option_is_some(&fsome) { return 10 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
