//@ run-pass
// E2E: stdlib/core/option.sio — IntOption/FloatOption

use core::option::*;

fn run_tests() -> i32 {
    // IntOption None
    let none = int_none()
    if none.is_some() { return 1 }
    if !none.is_none() { return 2 }
    if none.unwrap_or(42) != 42 { return 3 }

    // IntOption Some
    let some = int_some(99)
    if !some.is_some() { return 4 }
    if some.is_none() { return 5 }
    if some.unwrap() != 99 { return 6 }
    if some.unwrap_or(0) != 99 { return 7 }

    // FloatOption
    let fnone = float_none()
    if fnone.is_some() { return 8 }
    if fnone.unwrap_or(3.14) != 3.14 { return 9 }

    let fsome = float_some(2.718)
    if !fsome.is_some() { return 10 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
