//@ run-pass
//@ ignore BLOCKED: Sounio type checker does not infer `Option<i32>` from `Option::None` — bidirectional type inference required; compiler change needed
//@ ignore-owner: stdlib-core
//@ ignore-unblock: implement bidirectional type inference in souc so Option::None is inferred as Option<i32> from context
//@ description: core::option and core::result type tests
/// Tests for stdlib/core Option and Result types
///
/// Verifies that Option and Result work correctly with their basic operations.

use core::option::*
use core::result::*

fn run_tests() -> i32  with IO, Mut{
    var pass = 0
    var fail = 0

    // Test 1: Option Some
    print("Test 1: Option Some creation... ")
    let some_val = Option::Some(42)
    match some_val {
        Option::Some(v) => {
            if v == 42 {
                print("PASS\n")
                pass = pass + 1
            } else {
                print("FAIL (wrong value)\n")
                fail = fail + 1
            }
        }
        Option::None => {
            print("FAIL (got None)\n")
            fail = fail + 1
        }
    }

    // Test 2: Option None
    print("Test 2: Option None creation... ")
    let none_val: Option<i32> = Option::None
    match none_val {
        Option::Some(_) => {
            print("FAIL (got Some)\n")
            fail = fail + 1
        }
        Option::None => {
            print("PASS\n")
            pass = pass + 1
        }
    }

    // Test 3: Result Ok
    print("Test 3: Result Ok creation... ")
    let ok_val: Result<i32, string> = Result::Ok(100)
    match ok_val {
        Result::Ok(v) => {
            if v == 100 {
                print("PASS\n")
                pass = pass + 1
            } else {
                print("FAIL (wrong value)\n")
                fail = fail + 1
            }
        }
        Result::Err(_) => {
            print("FAIL (got Err)\n")
            fail = fail + 1
        }
    }

    // Test 4: Result Err
    print("Test 4: Result Err creation... ")
    let err_val: Result<i32, string> = Result::Err("error message")
    match err_val {
        Result::Ok(_) => {
            print("FAIL (got Ok)\n")
            fail = fail + 1
        }
        Result::Err(msg) => {
            print("PASS\n")
            pass = pass + 1
        }
    }

    // Test 5: is_some on Some
    print("Test 5: is_some on Some... ")
    let some_check = Option::Some(1)
    if some_check.is_some() {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 6: is_none on None
    print("Test 6: is_none on None... ")
    let none_check: Option<i32> = Option::None
    if none_check.is_none() {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 7: is_ok on Ok
    print("Test 7: is_ok on Ok... ")
    let ok_check: Result<i32, string> = Result::Ok(1)
    if ok_check.is_ok() {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 8: is_err on Err
    print("Test 8: is_err on Err... ")
    let err_check: Result<i32, string> = Result::Err("err")
    if err_check.is_err() {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    run_tests()
}
