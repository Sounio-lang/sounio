//@ run-pass
//@ expect-stdout: Passed: 16
//@ description: core::option and core::result type tests
/// Tests for stdlib/core IntOption, FloatOption, IntResult, FloatResult.
/// Uses the concrete types (tag + value) that the stdlib actually exports.

use core::option::*
use core::result::*

fn run_tests() -> i32 with IO, Mut {
    var pass = 0
    var fail = 0

    // ---------------------------------------------------------------- IntOption
    print("Test 01: int_some — is_some true... ")
    let s = int_some(42)
    if int_option_is_some(&s) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 02: int_some — is_none false... ")
    if !int_option_is_none(&s) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 03: int_some — unwrap value... ")
    if int_option_unwrap(&s) == 42 {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL (got ")
        print(int_option_unwrap(&s))
        print(")\n"); fail = fail + 1
    }

    print("Test 04: int_none — is_none true... ")
    let n = int_none()
    if int_option_is_none(&n) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 05: int_none — is_some false... ")
    if !int_option_is_some(&n) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 06: int_option_unwrap_or — Some returns value... ")
    if int_option_unwrap_or(&s, 99) == 42 {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 07: int_option_unwrap_or — None returns default... ")
    if int_option_unwrap_or(&n, 99) == 99 {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    // --------------------------------------------------------------- FloatOption
    print("Test 08: float_some — is_some true... ")
    let fs = float_some(3.14)
    if float_option_is_some(&fs) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 09: float_none — is_none true... ")
    let fn2 = float_none()
    if float_option_is_none(&fn2) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    // ---------------------------------------------------------------- IntResult
    print("Test 10: int_ok — is_ok true... ")
    let ok = int_ok(100)
    if int_result_is_ok(&ok) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 11: int_ok — is_err false... ")
    if !int_result_is_err(&ok) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 12: int_ok — unwrap value... ")
    if int_result_unwrap(&ok) == 100 {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 13: int_err — is_err true... ")
    let er = int_err(42)
    if int_result_is_err(&er) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 14: int_err — error code... ")
    if int_result_err(&er) == 42 {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 15: short alias is_ok... ")
    if is_ok(&ok) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("Test 16: short alias is_err... ")
    if is_err(&er) {
        print("PASS\n"); pass = pass + 1
    } else {
        print("FAIL\n"); fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print("  Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with IO, Mut {
    run_tests()
}
