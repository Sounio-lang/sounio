//@ check-only
// tests/stdlib/os/test_env_present.sio — getenv presence for PATH

fn path_key() -> [u8; 64] {
    var k: [u8; 64] = [0; 64]
    k[0] = 80   // P
    k[1] = 65   // A
    k[2] = 84   // T
    k[3] = 72   // H
    k[4] = 0
    k
}

fn main() -> i32 with IO {
    let key = path_key()
    if os::env::env_var_present(&key) { 0 } else { 1 }
}