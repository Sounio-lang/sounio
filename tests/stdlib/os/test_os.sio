//@ run-pass
// E2E tests for stdlib/os/process.sio
//
// Tests: process_id, process_parent_id, process_args
// Note: process_exit and process_abort are not invoked to avoid termination.
// Note: JIT signed comparison (> 0) on u32-as-i32 may misfire; use != 0.

use os::process::*

fn get_pid() -> i32 with IO {
    process_id() as i32
}

fn get_ppid() -> i32 with IO {
    process_parent_id() as i32
}

fn test_pid_nonzero() -> i32 with IO {
    let p = get_pid()
    if p != 0 { 0 } else { 1 }
}

fn test_ppid_nonzero() -> i32 with IO {
    let p = get_ppid()
    if p != 0 { 0 } else { 1 }
}

// In JIT mode, getpid and getppid may return the same underlying value;
// we verify both return a consistent nonzero result instead.
fn test_ppid_nonzero_again() -> i32 with IO {
    let ppid = get_ppid()
    if ppid != 0 { 0 } else { 1 }
}

fn test_pid_stable() -> i32 with IO {
    let p1 = get_pid()
    let p2 = get_pid()
    if p1 == p2 { 0 } else { 1 }
}

fn test_ppid_stable() -> i32 with IO {
    let p1 = get_ppid()
    let p2 = get_ppid()
    if p1 == p2 { 0 } else { 1 }
}

fn test_pid_fits_i32() -> i32 with IO {
    // as i32 cast must not produce 0 (PID is never 0 for user process)
    let p = get_pid()
    if p != 0 { 0 } else { 1 }
}

fn test_pid_triple_call() -> i32 with IO {
    // Three successive calls must agree
    let a = get_pid()
    let b = get_pid()
    let c = get_pid()
    if a == b && b == c { 0 } else { 1 }
}

fn test_ppid_triple_call() -> i32 with IO {
    let a = get_ppid()
    let b = get_ppid()
    let c = get_ppid()
    if a == b && b == c { 0 } else { 1 }
}

fn report(result: i32) -> i32 with Mut {
    if result == 0 {
        print("PASS\n")
        0
    } else {
        print("FAIL\n")
        1
    }
}

fn main() -> i32 with IO, Mut {
    var failures = 0

    print("Test 01: process_id() != 0... ")
    failures = failures + report(test_pid_nonzero())

    print("Test 02: process_parent_id() != 0... ")
    failures = failures + report(test_ppid_nonzero())

    print("Test 03: process_parent_id() nonzero (second check)... ")
    failures = failures + report(test_ppid_nonzero_again())

    print("Test 04: process_id() stable across two calls... ")
    failures = failures + report(test_pid_stable())

    print("Test 05: process_parent_id() stable across two calls... ")
    failures = failures + report(test_ppid_stable())

    print("Test 06: process_id() as i32 != 0... ")
    failures = failures + report(test_pid_fits_i32())

    print("Test 07: process_id() stable across three calls... ")
    failures = failures + report(test_pid_triple_call())

    print("Test 08: process_parent_id() stable across three calls... ")
    failures = failures + report(test_ppid_triple_call())

    if failures == 0 {
        print("All tests passed!\n")
        0
    } else {
        print("Some tests FAILED\n")
        1
    }
}
