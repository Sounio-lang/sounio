//@ run-pass
// E2E tests for stdlib/str/lib.sio
//
// Tests: str_eq, str_cat, str_contains, str_starts_with, str_ends_with,
//        str_index_of, str_sub, str_trim, str_to_upper, str_to_lower,
//        str_split_char, str_reverse, str_repeat, str_char_at_s,
//        str_replace_char, str_from_i64, str_from_f64, str_to_i64,
//        str_to_f64 (round-trip).

use str::lib::*

fn near(a: f64, b: f64, tol: f64) -> bool with Div {
    let d = if a > b { a - b } else { b - a }
    d < tol
}

fn run_tests() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    // ------------------------------------------------------------------ str_eq
    print("Test 01: str_eq equal strings... ")
    let s_a = str_from_literal("hello")
    let s_b = str_from_literal("hello")
    if str_eq(&s_a, &s_b) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 02: str_eq different strings... ")
    let s_c = str_from_literal("world")
    if !str_eq(&s_a, &s_c) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // --------------------------------------------------------------- str_cat
    print("Test 03: str_cat... ")
    let s_cat = str_cat(&s_a, &s_c)
    let s_expected_cat = str_from_literal("helloworld")
    if str_eq(&s_cat, &s_expected_cat) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------------------- str_contains
    print("Test 04: str_contains (found)... ")
    let haystack = str_from_literal("hello world")
    let needle = str_from_literal("world")
    if str_contains(&haystack, &needle) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 05: str_contains (not found)... ")
    let needle2 = str_from_literal("xyz")
    if !str_contains(&haystack, &needle2) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ---------------------------------------------------------- str_starts_with
    print("Test 06: str_starts_with (true)... ")
    let prefix = str_from_literal("hello")
    if str_starts_with(&haystack, &prefix) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 07: str_starts_with (false)... ")
    let prefix2 = str_from_literal("world")
    if !str_starts_with(&haystack, &prefix2) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------------------ str_ends_with
    print("Test 08: str_ends_with (true)... ")
    let suffix = str_from_literal("world")
    if str_ends_with(&haystack, &suffix) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 09: str_ends_with (false)... ")
    let suffix2 = str_from_literal("hello")
    if !str_ends_with(&haystack, &suffix2) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------------------- str_index_of
    print("Test 10: str_index_of (found)... ")
    let idx = str_index_of(&haystack, &needle)
    if idx == 6 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(idx)
        print(")\n")
        fail = fail + 1
    }

    print("Test 11: str_index_of (not found)... ")
    let idx2 = str_index_of(&haystack, &needle2)
    if idx2 == 0 - 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(idx2)
        print(")\n")
        fail = fail + 1
    }

    // --------------------------------------------------------------- str_sub
    print("Test 12: str_sub... ")
    let src_slice = str_from_literal("abcdef")
    let sliced = str_sub(&src_slice, 2, 5)
    let expected_slice = str_from_literal("cde")
    if str_eq(&sliced, &expected_slice) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(str_to_string(sliced))
        print(")\n")
        fail = fail + 1
    }

    // ---------------------------------------------------------------- str_trim
    print("Test 13: str_trim (leading+trailing spaces)... ")
    let padded = str_from_literal("  hello  ")
    let trimmed = str_trim(&padded)
    let expected_trim = str_from_literal("hello")
    if str_eq(&trimmed, &expected_trim) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(trimmed))
        print("')\n")
        fail = fail + 1
    }

    print("Test 14: str_trim (all whitespace)... ")
    let all_ws = str_from_literal("   ")
    let trimmed2 = str_trim(&all_ws)
    if trimmed2.len == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------------------- str_to_upper
    print("Test 15: str_to_upper... ")
    let lower_str = str_from_literal("hello world")
    let upper_str = str_to_upper(&lower_str)
    let expected_upper = str_from_literal("HELLO WORLD")
    if str_eq(&upper_str, &expected_upper) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(upper_str))
        print("')\n")
        fail = fail + 1
    }

    // ----------------------------------------------------------- str_to_lower
    print("Test 16: str_to_lower... ")
    let upper_in = str_from_literal("HELLO WORLD")
    let lower_out = str_to_lower(&upper_in)
    let expected_lower = str_from_literal("hello world")
    if str_eq(&lower_out, &expected_lower) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(lower_out))
        print("')\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- str_split_char
    print("Test 17: str_split_char (3 parts)... ")
    let csv = str_from_literal("a,b,c")
    var split_out = str_split_new()
    let split_count = str_split_char(&csv, 44 as i8, &!split_out)
    if split_count == 3 {
        let part0 = str_split_get(&split_out, 0)
        let part1 = str_split_get(&split_out, 1)
        let part2 = str_split_get(&split_out, 2)
        let ea = str_from_literal("a")
        let eb = str_from_literal("b")
        let ec = str_from_literal("c")
        if str_eq(&part0, &ea) && str_eq(&part1, &eb) && str_eq(&part2, &ec) {
            print("PASS\n")
            pass = pass + 1
        } else {
            print("FAIL (values wrong, lens=")
            print(part0.len)
            print(",")
            print(part1.len)
            print(",")
            print(part2.len)
            print(")\n")
            fail = fail + 1
        }
    } else {
        print("FAIL (count=")
        print(split_count)
        print(")\n")
        fail = fail + 1
    }

    print("Test 18: str_split_char (trailing delimiter)... ")
    let csv2 = str_from_literal("x,y,")
    var split_out2 = str_split_new()
    let sc2 = str_split_char(&csv2, 44 as i8, &!split_out2)
    if sc2 == 3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (count=")
        print(sc2)
        print(")\n")
        fail = fail + 1
    }

    // ----------------------------------------------------------- str_reverse
    print("Test 19: str_reverse... ")
    let fwd = str_from_literal("abcde")
    let rev = str_reverse(&fwd)
    let expected_rev = str_from_literal("edcba")
    if str_eq(&rev, &expected_rev) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(rev))
        print("')\n")
        fail = fail + 1
    }

    // ----------------------------------------------------------- str_repeat
    print("Test 20: str_repeat (3x)... ")
    let base = str_from_literal("ab")
    let rep3 = str_repeat(&base, 3)
    let expected_rep = str_from_literal("ababab")
    if str_eq(&rep3, &expected_rep) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(rep3))
        print("')\n")
        fail = fail + 1
    }

    print("Test 21: str_repeat (0x)... ")
    let rep0 = str_repeat(&base, 0)
    if rep0.len == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------------- str_replace_char
    print("Test 22: str_replace_char... ")
    let with_dots = str_from_literal("a.b.c")
    let replaced = str_replace_char(&with_dots, 46 as i8, 45 as i8)  // '.' → '-'
    let expected_replaced = str_from_literal("a-b-c")
    if str_eq(&replaced, &expected_replaced) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(replaced))
        print("')\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- str_char_at_s
    print("Test 23: str_char_at_s (valid idx)... ")
    let abc = str_from_literal("ABC")
    let ch_a = str_char_at_s(&abc, 0)
    if ch_a == 65 as i8 {  // 'A'
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(ch_a)
        print(")\n")
        fail = fail + 1
    }

    print("Test 24: str_char_at_s (out-of-bounds)... ")
    let ch_oob = str_char_at_s(&abc, 99)
    if ch_oob == 0 as i8 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------------ str_from_i64
    print("Test 25: str_from_i64(42)... ")
    let si_42 = str_from_i64(42)
    if str_to_string(si_42) == "42" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(si_42))
        print("')\n")
        fail = fail + 1
    }

    print("Test 26: str_from_i64(-7)... ")
    let si_neg7 = str_from_i64(0 - 7)
    if str_to_string(si_neg7) == "-7" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(si_neg7))
        print("')\n")
        fail = fail + 1
    }

    print("Test 27: str_from_i64(0)... ")
    let si_0 = str_from_i64(0)
    if str_to_string(si_0) == "0" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(si_0))
        print("')\n")
        fail = fail + 1
    }

    // ------------------------------------------------------ str_from_f64
    print("Test 28: str_from_f64(3.14, 2)... ")
    let sf_314 = str_from_f64(3.14, 2)
    if str_to_string(sf_314) == "3.14" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(sf_314))
        print("')\n")
        fail = fail + 1
    }

    print("Test 29: str_from_f64(0.0, 2)... ")
    let sf_0 = str_from_f64(0.0, 2)
    if str_to_string(sf_0) == "0.00" {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got '")
        print(str_to_string(sf_0))
        print("')\n")
        fail = fail + 1
    }

    // ------------------------------------------------------ str_to_i64
    print("Test 30: str_to_i64('123')... ")
    let parse_in = str_from_literal("123")
    let parsed_i = str_to_i64(&parse_in)
    if parsed_i == 123 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(parsed_i)
        print(")\n")
        fail = fail + 1
    }

    print("Test 31: str_to_i64('-456')... ")
    let parse_neg = str_from_literal("-456")
    let parsed_neg = str_to_i64(&parse_neg)
    if parsed_neg == 0 - 456 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(parsed_neg)
        print(")\n")
        fail = fail + 1
    }

    // ------------------------------------------------------ str_to_f64
    print("Test 32: str_to_f64('3.14')... ")
    let parse_f = str_from_literal("3.14")
    let parsed_f = str_to_f64(&parse_f)
    if near(parsed_f, 3.14, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(parsed_f)
        print(")\n")
        fail = fail + 1
    }

    // ---------------------------------------------- Round-trip f64
    print("Test 33: round-trip str_to_f64(str_from_f64(2.718, 3))... ")
    let rt_str = str_from_f64(2.718, 3)
    let rt_val = str_to_f64(&rt_str)
    if near(rt_val, 2.718, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL (got ")
        print(rt_val)
        print(")\n")
        fail = fail + 1
    }

    // ---------------------------------------------- str_len
    print("Test 34: str_len... ")
    let s_len_test = str_from_literal("abcde")
    if str_len(&s_len_test) == 5 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------ Summary
    print("\nPassed: ")
    print(pass)
    print("  Failed: ")
    print(fail)
    print("\n")

    fail
}

fn main() -> i32 with Mut, Div, Panic {
    run_tests()
}
