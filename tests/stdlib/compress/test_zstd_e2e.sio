//@ ignore
// TODO: re-enable after FFI pointer argument typing accepts array-to-pointer casts in the test harness.
// tests/stdlib/compress/test_zstd_e2e.sio — E2E tests for compress::zstd
//
// Tests compress/decompress round-trip, utility functions, error handling.
// Requires libzstd at JIT link time. If ZSTD_versionNumber() returns 0,
// the test skips the FFI-dependent cases gracefully.

use compress::zstd::{
    ZstdError, ZstdResult,
    zstd_compress, zstd_decompress,
    zstd_compress_bound, zstd_frame_content_size,
    zstd_is_error, zstd_is_ok,
    zstd_version, zstd_default_level, zstd_min_level, zstd_max_level,
    zstd_clamp_level,
}

// ============================================================================
// Struct predicates (no FFI needed)
// ============================================================================

fn test_zstd_is_ok_true() with Panic {
    let r = ZstdResult { ok: true, size: 42, error: ZstdError { code: 0 } }
    assert(zstd_is_ok(r))
}

fn test_zstd_is_ok_false() with Panic {
    let r = ZstdResult { ok: false, size: 0, error: ZstdError { code: 12 } }
    assert(!zstd_is_ok(r))
}

// ============================================================================
// Library metadata (requires libzstd)
// ============================================================================

fn test_zstd_version() with Panic {
    let v = zstd_version()
    // libzstd version >= 1.0.0 → versionNumber >= 10000
    assert(v > 0)
}

fn test_zstd_level_bounds() with Panic {
    let lo = zstd_min_level()
    let hi = zstd_max_level()
    let def = zstd_default_level()
    assert(lo < hi)
    assert(def >= lo)
    assert(def <= hi)
}

fn test_zstd_clamp_level() with Panic {
    let lo = zstd_min_level()
    let hi = zstd_max_level()
    // Clamp below min
    let clamped_lo = zstd_clamp_level(lo - 1000)
    assert(clamped_lo == lo)
    // Clamp above max
    let clamped_hi = zstd_clamp_level(hi + 1000)
    assert(clamped_hi == hi)
    // Clamp default (already in range)
    let def = zstd_default_level()
    let clamped_def = zstd_clamp_level(def)
    assert(clamped_def == def)
}

// ============================================================================
// compress_bound
// ============================================================================

fn test_compress_bound_positive() with Panic {
    let bound = zstd_compress_bound(100)
    assert(bound > 100)   // must be at least as large as input
}

fn test_compress_bound_zero() with Panic, Div {
    let bound = zstd_compress_bound(0)
    assert(bound >= 0)
}

// ============================================================================
// Round-trip compress / decompress
// ============================================================================

fn test_compress_decompress_roundtrip() with Mut, Panic, Div {
    // Source: 256-byte repeating pattern (highly compressible)
    var src: [u8; 256] = [0; 256]
    var i: i64 = 0
    while i < 256 {
        src[i as usize] = (i % 16) as u8
        i = i + 1
    }

    let bound = zstd_compress_bound(256)
    var dst: [u8; 512] = [0; 512]

    let def_level = zstd_default_level()
    let r1 = zstd_compress(src as *const u8, 256, dst as *mut u8, bound, def_level)
    assert(zstd_is_ok(r1))
    assert(r1.size > 0)

    // Decompress
    var recovered: [u8; 512] = [0; 512]
    let r2 = zstd_decompress(dst as *const u8, r1.size, recovered as *mut u8, 512)
    assert(zstd_is_ok(r2))
    assert(r2.size == 256)

    // Verify first 4 bytes
    assert(recovered[0] == 0)
    assert(recovered[1] == 1)
    assert(recovered[2] == 2)
    assert(recovered[3] == 3)
}

fn test_compress_level_1() with Mut, Panic, Div {
    var src: [u8; 64] = [0; 64]
    var i: i64 = 0
    while i < 64 {
        src[i as usize] = (i % 8) as u8
        i = i + 1
    }
    var dst: [u8; 256] = [0; 256]
    let r = zstd_compress(src as *const u8, 64, dst as *mut u8, 256, 1)
    assert(zstd_is_ok(r))
    assert(r.size > 0)
}

fn test_frame_content_size() with Mut, Panic, Div {
    // Compress something, then check frame content size
    var src: [u8; 32] = [5; 32]
    var dst: [u8; 128] = [0; 128]
    let r = zstd_compress(src as *const u8, 32, dst as *mut u8, 128, 3)
    assert(zstd_is_ok(r))

    let fcs = zstd_frame_content_size(dst as *const u8, r.size)
    assert(fcs == 32)
}

fn test_buffer_too_small() with Mut, Panic, Div {
    var src: [u8; 256] = [1; 256]
    var dst: [u8; 2] = [0; 2]    // way too small
    let r = zstd_compress(src as *const u8, 256, dst as *mut u8, 2, 3)
    // ZSTD returns an error code
    assert(!zstd_is_ok(r))
}

fn test_decompress_corrupt_data() with Mut, Panic, Div {
    // Feed garbage as compressed data
    var garbage: [u8; 16] = [0; 16]
    garbage[0] = 99
    garbage[1] = 42
    var dst: [u8; 256] = [0; 256]
    let r = zstd_decompress(garbage as *const u8, 16, dst as *mut u8, 256)
    assert(!zstd_is_ok(r))
}

// ============================================================================
// zstd_is_error helper
// ============================================================================

fn test_is_error_on_success_code() with Panic {
    // 0 is never an error
    assert(!zstd_is_error(0))
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with IO, Mut, Div, Panic {
    test_zstd_is_ok_true()
    test_zstd_is_ok_false()
    test_zstd_version()
    test_zstd_level_bounds()
    test_zstd_clamp_level()
    test_compress_bound_positive()
    test_compress_bound_zero()
    test_compress_decompress_roundtrip()
    test_compress_level_1()
    test_frame_content_size()
    test_buffer_too_small()
    test_decompress_corrupt_data()
    test_is_error_on_success_code()
    println("PASS: compress/zstd — all tests passed")
}
