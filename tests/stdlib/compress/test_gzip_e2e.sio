// tests/stdlib/compress/test_gzip_e2e.sio — E2E tests for compress::gzip
//
// Tests round-trip compress/decompress, CRC32, error cases, level constants.
// Requires zlib (libz) at JIT link time — standard on Linux.

use compress::gzip::{
    GzipError, GzipResult,
    gzip_compress, gzip_compress_level, gzip_decompress,
    gzip_crc32, crc32_compute,
    gzip_is_ok, gzip_error_message,
    gzip_default_level, gzip_best_speed, gzip_best_compression,
}

// ============================================================================
// Constants and metadata
// ============================================================================

fn test_level_constants() with Panic {
    assert(gzip_default_level() == 6)
    assert(gzip_best_speed() == 1)
    assert(gzip_best_compression() == 9)
}

fn test_error_message_ok() with Panic {
    let e = GzipError { code: 0 }
    assert(gzip_error_message(e) == "ok")
}

fn test_error_message_buf_error() with Panic {
    let e = GzipError { code: -5 }
    assert(gzip_error_message(e) == "buf error")
}

fn test_error_message_unknown() with Panic {
    let e = GzipError { code: 99 }
    assert(gzip_error_message(e) == "unknown error")
}

fn test_gzip_is_ok_true() with Panic {
    let r = GzipResult { ok: true, size: 42, error: GzipError { code: 0 } }
    assert(gzip_is_ok(r))
}

fn test_gzip_is_ok_false() with Panic {
    let r = GzipResult { ok: false, size: 0, error: GzipError { code: -3 } }
    assert(!gzip_is_ok(r))
}

// ============================================================================
// Compress + Decompress round-trip
// ============================================================================

fn test_compress_decompress_roundtrip() with Mut, Panic, Div {
    // Source: 256-byte buffer filled with a repeating pattern (highly compressible)
    var src: [u8; 256] = [0; 256]
    var i: i64 = 0
    while i < 256 {
        src[i as usize] = (i % 8) as u8
        i = i + 1
    }

    // Compress
    var compressed: [u8; 1024] = [0; 1024]
    let r1 = gzip_compress(src as *const u8, 256, compressed as *mut u8, 1024)
    assert(gzip_is_ok(r1))
    assert(r1.size > 0)
    assert(r1.size < 256)   // repeating pattern should compress

    // Decompress
    var recovered: [u8; 512] = [0; 512]
    let r2 = gzip_decompress(compressed as *const u8, r1.size, recovered as *mut u8, 512)
    assert(gzip_is_ok(r2))
    assert(r2.size == 256)

    // Verify round-trip correctness for first 8 bytes
    assert(recovered[0] == 0)
    assert(recovered[1] == 1)
    assert(recovered[7] == 7)
    assert(recovered[8] == 0)   // wraps back
}

fn test_compress_level_1() with Mut, Panic, Div {
    var src: [u8; 64] = [0; 64]
    var i: i64 = 0
    while i < 64 {
        src[i as usize] = (i % 4) as u8
        i = i + 1
    }
    var dst: [u8; 256] = [0; 256]
    let r = gzip_compress_level(src as *const u8, 64, dst as *mut u8, 256, 1)
    assert(gzip_is_ok(r))
    assert(r.size > 0)
}

fn test_compress_level_9() with Mut, Panic, Div {
    var src: [u8; 64] = [0; 64]
    var i: i64 = 0
    while i < 64 {
        src[i as usize] = (i % 2) as u8
        i = i + 1
    }
    var dst: [u8; 256] = [0; 256]
    let r = gzip_compress_level(src as *const u8, 64, dst as *mut u8, 256, 9)
    assert(gzip_is_ok(r))
    assert(r.size > 0)
}

fn test_buffer_too_small() with Mut, Panic, Div {
    var src: [u8; 256] = [42; 256]
    var dst: [u8; 2] = [0; 2]    // too small
    let r = gzip_compress(src as *const u8, 256, dst as *mut u8, 2)
    // zlib returns Z_BUF_ERROR (-5) for buffer too small
    assert(!gzip_is_ok(r))
}

// ============================================================================
// CRC32
// ============================================================================

fn test_crc32_empty() with Mut, Panic, Div {
    var buf: [u8; 1] = [0; 1]
    let c = gzip_crc32(buf as *const u8, 0)
    // CRC32 of empty buffer is 0
    assert(c == 0)
}

fn test_crc32_known() with Mut, Panic, Div {
    // CRC32 of "hello" (bytes 104,101,108,108,111) = 0x3610a686
    var buf: [u8; 5] = [104; 5]
    buf[1] = 101
    buf[2] = 108
    buf[3] = 108
    buf[4] = 111
    let c = gzip_crc32(buf as *const u8, 5)
    assert(c == 907060870)   // 0x3610a686 = 907060870
}

fn test_crc32_consistent() with Mut, Panic, Div {
    var buf: [u8; 8] = [1; 8]
    let c1 = gzip_crc32(buf as *const u8, 8)
    let c2 = crc32_compute(buf as *const u8, 8)
    assert(c1 == c2)
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with IO, Mut, Div, Panic {
    test_level_constants()
    test_error_message_ok()
    test_error_message_buf_error()
    test_error_message_unknown()
    test_gzip_is_ok_true()
    test_gzip_is_ok_false()
    test_compress_decompress_roundtrip()
    test_compress_level_1()
    test_compress_level_9()
    test_buffer_too_small()
    test_crc32_empty()
    test_crc32_known()
    test_crc32_consistent()
    println("PASS: compress/gzip — all tests passed")
}
