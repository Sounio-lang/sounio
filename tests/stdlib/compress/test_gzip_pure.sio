//@ run-pass
// tests/stdlib/compress/test_gzip_pure.sio — Pure (non-FFI) tests for compress::gzip
//
// Tests: level constants, GzipError/GzipResult predicates, error messages.
// These do not call compress/decompress/crc32 (which require PLT linking to
// libz — not available until the native backend gains GOT/PLT support).

use compress::gzip::{
    GzipError, GzipResult,
    gzip_compress, gzip_decompress,
    gzip_is_ok,
    gzip_error_message,
    gzip_default_level, gzip_best_speed, gzip_best_compression,
}

fn test_level_constants() with Panic {
    assert(gzip_default_level() == 6 as i32)
    assert(gzip_best_speed() == 1 as i32)
    assert(gzip_best_compression() == 9 as i32)
}

fn test_error_message_ok() with Panic {
    let e = GzipError { code: 0 }
    assert(gzip_error_message(e) == "ok")
}

fn test_error_message_buf_error() with Panic {
    let neg5: i32 = 0 - 5
    let e = GzipError { code: neg5 }
    assert(gzip_error_message(e) == "buf error")
}

fn test_error_message_data_error() with Panic {
    let neg3: i32 = 0 - 3
    let e = GzipError { code: neg3 }
    assert(gzip_error_message(e) == "data error")
}

fn test_error_message_unknown() with Panic {
    let e = GzipError { code: 99 }
    assert(gzip_error_message(e) == "unknown error")
}

fn test_gzip_is_ok_true() with Panic {
    let e = GzipError { code: 0 }
    let r = GzipResult { ok: true, size: 42, error: e }
    assert(gzip_is_ok(r))
}

fn test_gzip_is_ok_false() with Panic {
    let neg3: i32 = 0 - 3
    let e = GzipError { code: neg3 }
    let r = GzipResult { ok: false, size: 0, error: e }
    assert(!gzip_is_ok(r))
}

fn test_compress_returns_error() with Mut, Panic {
    // compress/decompress stubs return Z_BUF_ERROR (-5) until PLT support lands
    var dummy_src: [u8; 4] = [0; 4]
    var dummy_dst: [u8; 8] = [0; 8]
    let r = gzip_compress((&!dummy_src) as *mut u8, 4, (&!dummy_dst) as *mut u8, 8)
    assert(!gzip_is_ok(r))
    let neg5: i32 = 0 - 5
    assert(r.error.code == neg5)
}

pub fn main() with IO, Mut, Div, Panic {
    test_level_constants()
    test_error_message_ok()
    test_error_message_buf_error()
    test_error_message_data_error()
    test_error_message_unknown()
    test_gzip_is_ok_true()
    test_gzip_is_ok_false()
    test_compress_returns_error()
    println("PASS: compress/gzip — pure tests passed")
}
