// Targeted transactional refusal at zero discrepancy tolerance.
use math::numdiff_checked::{diff_controls,diff_summary,gradient_into,jacobian_into,hessian_into}
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close}
fn quartic(x:&NumericBuffer,n:i64,values:&!NumericBuffer,m:i64,ctx:&!NumericBuffer)->i64 with Mut,Div,Panic {
    let count=numeric_buffer_at(ctx,0)+1.0
    numeric_buffer_set(ctx,0,count)
    let a=numeric_buffer_at(x,0)
    var row:i64=0
    while row<m {numeric_buffer_set(values,row,a*a*a*a);row=row+1}
    0
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    var x=numeric_buffer_new(1,8)
    var steps=numeric_buffer_new(1,8)
    var sample=numeric_buffer_new(1,8)
    var values=numeric_buffer_new(2,16)
    var work=numeric_buffer_new(12,96)
    var out=numeric_buffer_new(2,16)
    var errors=numeric_buffer_new(2,16)
    var ctx=numeric_buffer_new(1,8)
    var r=diff_summary()
    let c=diff_controls(0.0,0.0,100)
    numeric_buffer_set(&!x,0,1.0);numeric_buffer_set(&!steps,0,0.125)
    var kind:i64=0
    while kind<3 {
        numeric_buffer_set(&!ctx,0,0.0)
        numeric_buffer_set(&!out,0,77.0);numeric_buffer_set(&!out,1,77.0)
        numeric_buffer_set(&!errors,0,88.0);numeric_buffer_set(&!errors,1,88.0)
        var status:i64=0
        if kind==0 {status=gradient_into(quartic,&x,&steps,1,&c,&!sample,&!values,&!work,&!out,&!errors,&!ctx,&!r)} else if kind==1 {status=jacobian_into(quartic,&x,&steps,1,2,&c,&!sample,&!values,&!work,&!out,&!errors,&!ctx,&!r)} else {status=hessian_into(quartic,&x,&steps,1,&c,&!sample,&!values,&!work,&!out,&!errors,&!ctx,&!r)}
        assert(status==7 && r.status==7 && !r.converged && r.callback_count==5 && numeric_buffer_at(&ctx,0)==5.0)
        assert(numeric_buffer_at(&out,0)==77.0 && numeric_buffer_at(&out,1)==77.0)
        assert(numeric_buffer_at(&errors,0)==88.0 && numeric_buffer_at(&errors,1)==88.0)
        let calls:i64=r.callback_count
        print("NDC ");print(kind);print(" ");print(status);print(" ");println(calls)
        kind=kind+1
    }
    numeric_buffer_close(x);numeric_buffer_close(steps);numeric_buffer_close(sample);numeric_buffer_close(values);numeric_buffer_close(work);numeric_buffer_close(out);numeric_buffer_close(errors);numeric_buffer_close(ctx)
    println("NUMDIFF_DYNAMIC_NONCONVERGENCE_PASS")
    0
}
