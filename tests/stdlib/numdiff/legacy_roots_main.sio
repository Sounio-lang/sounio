use io::sci_print::{println_f64_sci}
fn main()->i32 with IO,Mut,Div,Panic {
    println("ROOTS")
    let h=optimal_h_forward(0.0)
    println_f64_sci(h,15)
    println_f64_sci(optimal_h_central(0.0),15)
    println_f64_sci(nd_cbrt(1.0e-300),15)
    println_f64_sci(nd_cbrt(1.0e300),15)
    println_f64_sci(nd_cbrt(0.0-1.0e-300),15)
    println_f64_sci(nd_sqrt(0.0),15)
    let quantum=2.2250738585072014e-308/4503599627370496.0
    println_f64_sci(nd_sqrt(quantum),15)
    if h>1.0e-7 {return 1}
    println("NUMDIFF_LEGACY_ROOTS_PASS")
    0
}
