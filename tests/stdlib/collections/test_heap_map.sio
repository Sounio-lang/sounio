//@ run-pass
// E2E: stdlib/collections/heap_map.sio — HeapIntIntMap dynamic hash map

use collections::heap_map::*;

fn main() -> i32 with IO, Alloc {
    var m = HeapIntIntMap {
        keys: 0 as *mut i64, vals: 0 as *mut i64,
        used: 0 as *mut i64, count: 0, cap: 0
    }

    // insert and get
    m.insert(1, 100)
    m.insert(2, 200)
    m.insert(3, 300)
    if m.len() != 3 { print("FAIL: len after 3 inserts\n"); return 1 }
    if m.get(1) != 100 { print("FAIL: get(1)\n"); return 1 }
    if m.get(2) != 200 { print("FAIL: get(2)\n"); return 1 }
    if m.get(3) != 300 { print("FAIL: get(3)\n"); return 1 }
    if m.get(99) != 0  { print("FAIL: get missing\n"); return 1 }

    // contains
    if m.contains(1) == false { print("FAIL: contains(1)\n"); return 1 }
    if m.contains(99) == true  { print("FAIL: contains(99)\n"); return 1 }

    // update existing key
    m.insert(2, 999)
    if m.len() != 3 { print("FAIL: len after update\n"); return 1 }
    if m.get(2) != 999 { print("FAIL: get after update\n"); return 1 }

    // remove
    m.remove(2)
    if m.len() != 2 { print("FAIL: len after remove\n"); return 1 }
    if m.contains(2) == true { print("FAIL: contains after remove\n"); return 1 }
    if m.get(2) != 0  { print("FAIL: get after remove\n"); return 1 }

    // insert after remove (reuse tombstone path)
    m.insert(2, 42)
    if m.get(2) != 42 { print("FAIL: get after re-insert\n"); return 1 }

    // stress: push past initial cap=64 to trigger rehash
    var i: i64 = 10
    while i < 70 {
        m.insert(i * 1000, i * 10)
        i = i + 1
    }
    if m.get(10000) != 100  { print("FAIL: get after rehash (10)\n"); return 1 }
    if m.get(50000) != 500  { print("FAIL: get after rehash (50)\n"); return 1 }
    if m.get(69000) != 690  { print("FAIL: get after rehash (69)\n"); return 1 }

    // collision test — insert keys that share a bucket in initial cap
    // keys 0 and 64 both map to slot 0 at cap=64
    var c = HeapIntIntMap {
        keys: 0 as *mut i64, vals: 0 as *mut i64,
        used: 0 as *mut i64, count: 0, cap: 0
    }
    c.insert(0, 7)
    c.insert(64, 8)
    if c.get(0) != 7  { print("FAIL: collision get(0)\n"); return 1 }
    if c.get(64) != 8 { print("FAIL: collision get(64)\n"); return 1 }
    c.free()

    m.free()

    print("PASS\n")
    return 0
}
