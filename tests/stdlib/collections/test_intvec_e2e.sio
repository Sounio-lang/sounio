//@ run-pass
//@ known-failure: Requires implementation
// E2E: stdlib/collections/vec.sio — IntVec push/pop/get/set/len/contains/swap

use collections::vec::*;

fn run_tests(v: &! IntVec) -> i32 {
    // Test push and len
    v.push(10)
    v.push(20)
    v.push(30)
    if v.len() != 3 { return 1 }

    // Test get
    if v.get(0) != 10 { return 2 }
    if v.get(1) != 20 { return 3 }
    if v.get(2) != 30 { return 4 }

    // Test set
    v.set(1, 99)
    if v.get(1) != 99 { return 5 }

    // Test contains
    if !v.contains(10) { return 6 }
    if v.contains(42) { return 7 }

    // Test index_of
    if v.index_of(30) != 2 { return 8 }
    if v.index_of(999) != 0 - 1 { return 9 }

    // Test swap
    v.swap(0, 2)
    if v.get(0) != 30 { return 10 }
    if v.get(2) != 10 { return 11 }

    // Test pop
    let popped = v.pop()
    if popped != 10 { return 12 }
    if v.len() != 2 { return 13 }

    // Test sum/min/max
    v.clear()
    v.push(5)
    v.push(3)
    v.push(8)
    v.push(1)
    if v.sum() != 17 { return 14 }
    if v.min() != 1 { return 15 }
    if v.max() != 8 { return 16 }

    // Test first/last
    if v.first() != 5 { return 17 }
    if v.last() != 1 { return 18 }

    // Test reverse
    v.reverse()
    if v.get(0) != 1 { return 19 }
    if v.get(3) != 5 { return 20 }

    // Test is_empty after clear
    v.clear()
    if !v.is_empty() { return 21 }

    return 0
}

fn main() -> i32 {
    var v = IntVec::new()
    return run_tests(&! v)
}
