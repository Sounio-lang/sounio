//@ run-pass
// E2E: stdlib/collections/hashmap.sio — IntIntMap insert/get/contains/remove

use collections::hashmap::*;

fn run_tests(m: &! IntIntMap) -> i32 {
    // Empty map
    if m.len() != 0 { return 1 }
    if !m.is_empty() { return 2 }

    // Insert and get
    m.insert(42, 100)
    m.insert(17, 200)
    m.insert(99, 300)
    if m.len() != 3 { return 3 }
    if m.get(42) != 100 { return 4 }
    if m.get(17) != 200 { return 5 }
    if m.get(99) != 300 { return 6 }

    // Contains
    if !m.contains(42) { return 7 }
    if m.contains(0) { return 8 }

    // Update existing key
    m.insert(42, 999)
    if m.get(42) != 999 { return 9 }
    if m.len() != 3 { return 10 }

    // Remove
    let removed = m.remove(17)
    if !removed { return 11 }
    if m.len() != 2 { return 12 }
    if m.contains(17) { return 13 }

    // Remove non-existent
    let removed2 = m.remove(12345)
    if removed2 { return 14 }

    // Many inserts
    var i: i64 = 0
    while i < 100 {
        m.insert(i + 1000, i * 2)
        i = i + 1
    }
    if m.get(1050) != 100 { return 15 }

    // Clear
    m.clear()
    if m.len() != 0 { return 16 }

    return 0
}

fn main() -> i32 {
    var m = IntIntMap::new()
    return run_tests(&! m)
}
