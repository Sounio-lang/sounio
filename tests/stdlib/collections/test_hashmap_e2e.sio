//@ run-pass
//@ known-failure: Collection impl constructor/runtime path unstable

// E2E: stdlib/collections/hashmap.sio — active HashMap64 standalone API

use collections::hashmap::*;

fn as_f64(x: i64) -> f64 {
    x as f64
}

fn run_tests(m: &! HashMap64) -> i32 with Mut {
    // Empty map
    if hashmap_count(m) != 0 { return 1 }

    // Insert and get
    if !hashmap_insert(m, 42, as_f64(100)) { return 2 }
    if !hashmap_insert(m, 17, as_f64(200)) { return 3 }
    if !hashmap_insert(m, 99, as_f64(300)) { return 4 }
    if hashmap_count(m) != 3 { return 5 }
    if hashmap_get(m, 42) != as_f64(100) { return 6 }
    if hashmap_get(m, 17) != as_f64(200) { return 7 }
    if hashmap_get(m, 99) != as_f64(300) { return 8 }

    // Contains
    if !hashmap_contains(m, 42) { return 9 }
    if hashmap_contains(m, 0) { return 10 }

    // Update existing key
    if !hashmap_insert(m, 42, as_f64(999)) { return 11 }
    if hashmap_get(m, 42) != as_f64(999) { return 12 }
    if hashmap_count(m) != 3 { return 13 }

    // Remove
    let removed = hashmap_remove(m, 17)
    if !removed { return 14 }
    if hashmap_count(m) != 2 { return 15 }
    if hashmap_contains(m, 17) { return 16 }

    // Remove non-existent
    let removed2 = hashmap_remove(m, 12345)
    if removed2 { return 17 }

    // Many inserts
    var i: i64 = 0
    while i < 100 {
        if !hashmap_insert(m, i + 1000, as_f64(i * 2)) { return 18 }
        i = i + 1
    }
    if hashmap_get(m, 1050) != as_f64(100) { return 19 }

    return 0
}

fn main() -> i32 with Mut {
    var m = hashmap_new()
    return run_tests(&! m)
}
