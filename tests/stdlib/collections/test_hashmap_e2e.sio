//@ run-pass
// E2E: stdlib/collections/hashmap.sio — active HashMap64 standalone API

use collections::hashmap::*;

fn as_f64(x: i64) -> f64 {
    x as f64
}

fn hm_count_v(m: HashMap64) -> i64 {
    hashmap_count(&m)
}

fn hm_get_v(m: HashMap64, key: i64) -> f64 {
    hashmap_get(&m, key)
}

fn hm_contains_v(m: HashMap64, key: i64) -> bool {
    hashmap_contains(&m, key)
}

fn hm_insert_v(m: HashMap64, key: i64, value: f64) -> HashMap64 with Mut {
    var next = m
    let _ = hashmap_insert(&! next, key, value)
    next
}

fn hm_remove_v(m: HashMap64, key: i64) -> HashMap64 with Mut {
    var next = m
    let _ = hashmap_remove(&! next, key)
    next
}

fn run_tests() -> i32 with Mut {
    var m = hashmap_new()
    // Empty map
    if hm_count_v(m) != 0 { return 1 }

    // Insert and get
    m = hm_insert_v(m, 42, as_f64(100))
    m = hm_insert_v(m, 17, as_f64(200))
    m = hm_insert_v(m, 99, as_f64(300))
    if hm_count_v(m) != 3 { return 5 }
    if hm_get_v(m, 42) != as_f64(100) { return 6 }
    if hm_get_v(m, 17) != as_f64(200) { return 7 }
    if hm_get_v(m, 99) != as_f64(300) { return 8 }

    // Contains
    if !hm_contains_v(m, 42) { return 9 }
    if hm_contains_v(m, 0) { return 10 }

    // Update existing key
    m = hm_insert_v(m, 42, as_f64(999))
    if hm_get_v(m, 42) != as_f64(999) { return 12 }
    if hm_count_v(m) != 3 { return 13 }

    // Remove
    m = hm_remove_v(m, 17)
    if hm_count_v(m) != 2 { return 15 }
    if hm_contains_v(m, 17) { return 16 }

    // Remove non-existent
    let count_before = hm_count_v(m)
    m = hm_remove_v(m, 12345)
    if hm_count_v(m) != count_before { return 17 }

    // Many inserts
    var i: i64 = 0
    while i < 100 {
        m = hm_insert_v(m, i + 1000, as_f64(i * 2))
        i = i + 1
    }
    if hm_get_v(m, 1050) != as_f64(100) { return 19 }

    return 0
}

fn main() -> i32 with Mut {
    return run_tests()
}
