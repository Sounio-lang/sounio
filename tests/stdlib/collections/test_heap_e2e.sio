//@ run-pass
// E2E: stdlib/collections/heap.sio — IntHeap min-heap ordering

use collections::heap::*;

fn run_tests(h: &! IntHeap) -> i32 {
    // Empty heap
    if !h.is_empty() { return 1 }

    // Push and peek_min
    h.push(50)
    h.push(20)
    h.push(80)
    h.push(10)
    h.push(60)
    if h.len() != 5 { return 2 }
    if h.peek_min() != 10 { return 3 }

    // Pop in sorted order
    let v1 = h.pop_min()
    if v1 != 10 { return 4 }
    let v2 = h.pop_min()
    if v2 != 20 { return 5 }
    let v3 = h.pop_min()
    if v3 != 50 { return 6 }
    let v4 = h.pop_min()
    if v4 != 60 { return 7 }
    let v5 = h.pop_min()
    if v5 != 80 { return 8 }

    // Empty after pops
    if !h.is_empty() { return 9 }

    // Push duplicates
    h.push(5)
    h.push(5)
    h.push(5)
    if h.len() != 3 { return 10 }
    if h.pop_min() != 5 { return 11 }
    if h.pop_min() != 5 { return 12 }

    return 0
}

fn main() -> i32 {
    var h = IntHeap::new()
    return run_tests(&! h)
}
