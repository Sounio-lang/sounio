//@ run-pass
//@ expect-stdout: ALL PASS
// E2E: stdlib/collections/bitset.sio — BitSet set/clear/test/count/ops

use collections::bitset::*

fn main() -> i32 with IO, Mut, Div, Panic {
    var pass = 0
    var fail = 0

    var a = BitSet { words: [0; 1024] }
    var b = BitSet { words: [0; 1024] }

    // Test 1: initially empty
    print("Test 1 [initial count=0]: ")
    if a.count() == 0 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 2: set and test bits
    print("Test 2 [set/test bits]: ")
    a.set(0)
    a.set(10)
    a.set(63)
    a.set(64)
    a.set(1000)
    if a.test(0) && a.test(10) && a.test(63) && a.test(64) && a.test(1000) && !a.test(1) && !a.test(999) {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 3: count
    print("Test 3 [count=5]: ")
    if a.count() == 5 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 4: clear bit
    print("Test 4 [clear_bit]: ")
    a.clear_bit(10)
    if !a.test(10) && a.count() == 4 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 5: union
    print("Test 5 [union_with]: ")
    b.set(5)
    b.set(1000)
    a.union_with(&b)
    if a.test(5) && a.test(1000) {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 6: intersection (fresh variables to avoid borrow conflict)
    print("Test 6 [intersect_with]: ")
    var a2 = BitSet { words: [0; 1024] }
    var b2 = BitSet { words: [0; 1024] }
    a2.set(1)
    a2.set(2)
    a2.set(3)
    b2.set(2)
    b2.set(3)
    b2.set(4)
    a2.intersect_with(&b2)
    if !a2.test(1) && a2.test(2) && a2.test(3) && !a2.test(4) {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 7: xor (fresh variables)
    print("Test 7 [xor_with]: ")
    var a3 = BitSet { words: [0; 1024] }
    var c = BitSet { words: [0; 1024] }
    a3.set(2)
    a3.set(3)
    c.set(2)
    a3.xor_with(&c)
    if !a3.test(2) && a3.test(3) {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 8: is_subset_of
    print("Test 8 [is_subset_of]: ")
    var f = BitSet { words: [0; 1024] }
    f.set(5)
    f.set(10)
    var g = BitSet { words: [0; 1024] }
    g.set(5)
    if g.is_subset_of(&f) && !f.is_subset_of(&g) {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    println("")
    print("Passed: ")
    print(pass)
    print("  Failed: ")
    println(fail)
    println("")
    if fail == 0 {
        println("ALL PASS")
    }
    if fail > 0 { return 1 }
    0
}
