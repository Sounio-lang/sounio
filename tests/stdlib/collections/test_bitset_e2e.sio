//@ run-pass

// E2E: stdlib/collections/bitset.sio — BitSet set/clear/test/count/ops

use collections::bitset::*;

fn run_tests(a: &! BitSet, b: &! BitSet) -> i32 with IO, Mut {
    // Initially empty
    if a.count() != 0 { return 1 }

    // Set and test
    a.set(0)
    a.set(10)
    a.set(63)
    a.set(64)
    a.set(1000)
    if !a.test(0) { return 2 }
    if !a.test(10) { return 3 }
    if !a.test(63) { return 4 }
    if !a.test(64) { return 5 }
    if !a.test(1000) { return 6 }
    if a.test(1) { return 7 }
    if a.test(999) { return 8 }

    // Count
    if a.count() != 5 { return 9 }

    // Clear bit
    a.clear_bit(10)
    if a.test(10) { return 10 }
    if a.count() != 4 { return 11 }

    // Union
    b.set(5)
    b.set(1000)
    a.union_with(b)
    if !a.test(5) { return 12 }

    // Intersection
    a.clear()
    a.set(1)
    a.set(2)
    a.set(3)
    b.clear()
    b.set(2)
    b.set(3)
    b.set(4)
    a.intersect_with(b)
    if a.test(1) { return 13 }
    if !a.test(2) { return 14 }
    if !a.test(3) { return 15 }
    if a.test(4) { return 16 }

    return 0
}

fn main() -> i32 with IO, Mut {
    var a = BitSet::new()
    var b = BitSet::new()
    return run_tests(&! a, &! b)
}
