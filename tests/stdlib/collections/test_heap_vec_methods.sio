//@ run-pass
// E2E: stdlib/collections/heap_vec.sio — HeapI64Vec and HeapF64Vec method API

use collections::heap_vec::*;

fn main() -> i32 with IO, Alloc {
    // HeapI64Vec method API
    var v = HeapI64Vec { ptr: 0 as *mut i64, len: 0, cap: 0 }

    // push multiple values
    v.push(10)
    v.push(20)
    v.push(30)
    v.push(40)
    v.push(50)

    // len
    if v.len() != 5 { print("FAIL: len\n"); return 1 }

    // get
    if v.get(0) != 10 { print("FAIL: get(0)\n"); return 1 }
    if v.get(2) != 30 { print("FAIL: get(2)\n"); return 1 }
    if v.get(4) != 50 { print("FAIL: get(4)\n"); return 1 }
    if v.get(99) != 0 { print("FAIL: get out-of-bounds\n"); return 1 }

    // set
    v.set(1, 99)
    if v.get(1) != 99 { print("FAIL: set\n"); return 1 }

    // contains
    if v.contains(30) == false { print("FAIL: contains(30)\n"); return 1 }
    if v.contains(77) == true  { print("FAIL: contains(77)\n"); return 1 }

    // pop
    let last = v.pop()
    if last != 50 { print("FAIL: pop value\n"); return 1 }
    if v.len() != 4 { print("FAIL: len after pop\n"); return 1 }

    // clear
    v.clear()
    if v.len() != 0 { print("FAIL: clear\n"); return 1 }

    // push after clear grows again
    v.push(7)
    v.push(8)
    if v.len() != 2 { print("FAIL: push after clear\n"); return 1 }
    if v.get(0) != 7 { print("FAIL: get after clear\n"); return 1 }

    v.free()

    // HeapF64Vec method API
    var f = HeapF64Vec { ptr: 0 as *mut f64, len: 0, cap: 0 }
    f.push(1.0)
    f.push(2.0)
    f.push(3.0)

    if f.len() != 3 { print("FAIL: f64 len\n"); return 1 }
    if f.get(1) != 2.0 { print("FAIL: f64 get\n"); return 1 }

    let s = f.sum()
    if s < 5.9 || s > 6.1 { print("FAIL: f64 sum\n"); return 1 }

    f.free()

    print("PASS\n")
    return 0
}
