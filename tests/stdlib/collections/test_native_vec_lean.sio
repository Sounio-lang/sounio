//@ run-pass
//@ expect-stdout: NATIVE_VEC_OK
var NVEC_DATA: [i64; 16] = [0; 16]
var NVEC_LEN: i64 = 0

fn push(x: i64) with Mut, Panic {
    NVEC_DATA[NVEC_LEN as usize] = x
    NVEC_LEN = NVEC_LEN + 1
}

fn main() -> i32 with IO, Mut, Panic {
    push(2)
    push(3)
    if NVEC_LEN != 2 { return 1 }
    if NVEC_DATA[0] + NVEC_DATA[1] != 5 { return 1 }
    println("NATIVE_VEC_OK")
    0
}
