// Test: NativeI64Vec — inline (no imports, lean-emitter compatible)
// Uses global backing array to avoid large stack frames.
// Verifies: push, pop, get, sort, sum, min, max
// Exit code: 10 = all tests pass

var NVEC_DATA: [i64; 4096] = [0; 4096]
var NVEC_LEN: i64 = 0

fn nv_push(x: i64) with Mut, Panic {
    if NVEC_LEN >= 4096 { return }
    NVEC_DATA[NVEC_LEN as usize] = x
    NVEC_LEN = NVEC_LEN + 1
}

fn nv_pop() -> i64 with Mut, Panic {
    if NVEC_LEN == 0 { return 0 }
    NVEC_LEN = NVEC_LEN - 1
    NVEC_DATA[NVEC_LEN as usize]
}

fn nv_get(i: i64) -> i64 {
    NVEC_DATA[i as usize]
}

fn nv_len() -> i64 {
    NVEC_LEN
}

fn nv_sum() -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < NVEC_LEN { s = s + NVEC_DATA[i as usize]; i = i + 1 }
    s
}

fn nv_min() -> i64 with Mut {
    var m = NVEC_DATA[0]
    var i: i64 = 1
    while i < NVEC_LEN {
        if NVEC_DATA[i as usize] < m { m = NVEC_DATA[i as usize] }
        i = i + 1
    }
    m
}

fn nv_max() -> i64 with Mut {
    var m = NVEC_DATA[0]
    var i: i64 = 1
    while i < NVEC_LEN {
        if NVEC_DATA[i as usize] > m { m = NVEC_DATA[i as usize] }
        i = i + 1
    }
    m
}

fn nv_sort() with Mut {
    var i: i64 = 1
    while i < NVEC_LEN {
        let key = NVEC_DATA[i as usize]
        var j = i - 1
        while j >= 0 && NVEC_DATA[j as usize] > key {
            NVEC_DATA[(j + 1) as usize] = NVEC_DATA[j as usize]
            j = j - 1
        }
        NVEC_DATA[(j + 1) as usize] = key
        i = i + 1
    }
}

fn main() -> i64 with Mut, Panic {
    var pass: i64 = 0

    // Test 1: push 5 elements, check len
    nv_push(30)
    nv_push(10)
    nv_push(50)
    nv_push(20)
    nv_push(40)
    if nv_len() == 5 { pass = pass + 1 }

    // Test 2: sum == 150
    if nv_sum() == 150 { pass = pass + 1 }

    // Test 3: sort, then first element == 10
    nv_sort()
    if nv_get(0) == 10 { pass = pass + 1 }

    // Test 4: sort, last element == 50
    if nv_get(4) == 50 { pass = pass + 1 }

    // Test 5: pop returns 50
    let popped = nv_pop()
    if popped == 50 { pass = pass + 1 }

    // Test 6: len after pop == 4
    if nv_len() == 4 { pass = pass + 1 }

    // Test 7: min == 10
    if nv_min() == 10 { pass = pass + 1 }

    // Test 8: max == 40
    if nv_max() == 40 { pass = pass + 1 }

    // Test 9: push 100 more elements
    var k: i64 = 0
    while k < 100 { nv_push(k); k = k + 1 }
    if nv_len() == 104 { pass = pass + 1 }

    // Test 10: sum = 10+20+30+40 + 0..99 = 100 + 4950 = 5050
    if nv_sum() == 5050 { pass = pass + 1 }

    pass
}
