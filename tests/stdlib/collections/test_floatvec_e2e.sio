//@ run-pass
//@ known-failure: Requires implementation
// E2E: stdlib/collections/vec.sio — FloatVec operations

use collections::vec::*;

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.001
}

fn run_tests(v: &! FloatVec) -> i32 {
    v.push(1.5)
    v.push(2.5)
    v.push(3.5)
    if v.len() != 3 { return 1 }
    if !near(v.get(0), 1.5) { return 2 }
    if !near(v.get(2), 3.5) { return 3 }

    // sum
    if !near(v.sum(), 7.5) { return 4 }

    // min/max
    if !near(v.min(), 1.5) { return 5 }
    if !near(v.max(), 3.5) { return 6 }

    // mean
    if !near(v.mean(), 2.5) { return 7 }

    // set
    v.set(1, 9.9)
    if !near(v.get(1), 9.9) { return 8 }

    // pop
    let p = v.pop()
    if !near(p, 3.5) { return 9 }
    if v.len() != 2 { return 10 }

    return 0
}

fn main() -> i32 {
    var v = FloatVec::new()
    return run_tests(&! v)
}
