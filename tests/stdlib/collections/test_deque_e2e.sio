//@ run-pass
//@ known-failure: Requires implementation
// E2E: stdlib/collections/deque.sio — IntDeque push/pop front and back

use collections::deque::*;

fn run_tests(d: &! IntDeque) -> i32 {
    // Empty deque
    if !d.is_empty() { return 1 }

    // Push back
    d.push_back(10)
    d.push_back(20)
    d.push_back(30)
    if d.len() != 3 { return 2 }
    if d.front() != 10 { return 3 }
    if d.back() != 30 { return 4 }

    // Push front
    d.push_front(5)
    if d.front() != 5 { return 5 }
    if d.len() != 4 { return 6 }

    // Get by index
    if d.get(0) != 5 { return 7 }
    if d.get(1) != 10 { return 8 }
    if d.get(3) != 30 { return 9 }

    // Pop front
    let f = d.pop_front()
    if f != 5 { return 10 }
    if d.front() != 10 { return 11 }

    // Pop back
    let b = d.pop_back()
    if b != 30 { return 12 }
    if d.back() != 20 { return 13 }

    // Clear
    d.clear()
    if !d.is_empty() { return 14 }

    return 0
}

fn main() -> i32 {
    var d = IntDeque::new()
    return run_tests(&! d)
}
