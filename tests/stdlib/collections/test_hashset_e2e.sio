//@ run-pass
//@ known-failure: Requires implementation
// E2E: stdlib/collections/hashset.sio — IntSet insert/contains/remove

use collections::hashset::*;

fn run_tests(s: &! IntSet) -> i32 {
    // Empty set
    if !s.is_empty() { return 1 }

    // Insert
    let ok1 = s.insert(10)
    if !ok1 { return 2 }
    let ok2 = s.insert(20)
    if !ok2 { return 3 }
    let ok3 = s.insert(30)
    if !ok3 { return 4 }
    if s.len() != 3 { return 5 }

    // Contains
    if !s.contains(10) { return 6 }
    if !s.contains(20) { return 7 }
    if s.contains(99) { return 8 }

    // Duplicate insert returns false
    let dup = s.insert(10)
    if dup { return 9 }
    if s.len() != 3 { return 10 }

    // Remove
    let r1 = s.remove(20)
    if !r1 { return 11 }
    if s.len() != 2 { return 12 }
    if s.contains(20) { return 13 }

    // Remove non-existent
    let r2 = s.remove(999)
    if r2 { return 14 }

    // Clear
    s.clear()
    if !s.is_empty() { return 15 }

    return 0
}

fn main() -> i32 {
    var s = IntSet::new()
    return run_tests(&! s)
}
