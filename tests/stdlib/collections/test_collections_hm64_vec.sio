//@ run-pass
// E2E: HashMap64 and VecF64 standalone-function APIs
// Tests: insert/get/contains/remove/tombstone/collision/count (HashMap64)
//        push/pop/get/set/bounds/sum/mean/reverse/clear (VecF64)

use collections::hashmap::*;
use collections::vec::*;

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.0001
}

fn hm_count_v(m: HashMap64) -> i64 {
    hashmap_count(&m)
}

fn hm_get_v(m: HashMap64, key: i64) -> f64 {
    hashmap_get(&m, key)
}

fn hm_contains_v(m: HashMap64, key: i64) -> bool {
    hashmap_contains(&m, key)
}

fn hm_insert_v(m: HashMap64, key: i64, value: f64) -> HashMap64 with Mut {
    var next = m
    let _ = hashmap_insert(&! next, key, value)
    next
}

fn hm_remove_v(m: HashMap64, key: i64) -> HashMap64 with Mut {
    var next = m
    let _ = hashmap_remove(&! next, key)
    next
}

fn vec_len_v(v: VecF64) -> i64 {
    vec_len(&v)
}

fn vec_get_v(v: VecF64, idx: i64) -> f64 {
    vec_get(&v, idx)
}

fn vec_sum_v(v: VecF64) -> f64 with Mut {
    vec_sum(&v)
}

fn vec_mean_v(v: VecF64) -> f64 with Mut, Div {
    vec_mean(&v)
}

fn vec_push_v(v: VecF64, value: f64) -> VecF64 with Mut {
    var next = v
    let _ = vec_push(&! next, value)
    next
}

fn vec_pop_v(v: VecF64) -> VecF64 with Mut {
    var next = v
    let _ = vec_pop(&! next)
    next
}

fn vec_set_v(v: VecF64, idx: i64, value: f64) -> VecF64 with Mut {
    var next = v
    vec_set(&! next, idx, value)
    next
}

fn vec_clear_v(v: VecF64) -> VecF64 with Mut {
    var next = v
    vec_clear(&! next)
    next
}

fn vec_reverse_v(v: VecF64) -> VecF64 with Mut, Panic {
    var next = v
    vec_reverse(&! next)
    next
}

fn vec_swap_v(v: VecF64, i: i64, j: i64) -> VecF64 with Mut, Panic {
    var next = v
    vec_swap(&! next, i, j)
    next
}

// ============================================================================
// HashMap64 tests — returns 0 on success, error code otherwise
// ============================================================================

fn test_hashmap() -> i32 with Mut {
    var m = hashmap_new()
    // Empty map
    if hm_count_v(m) != 0 { return 101 }

    // Basic insert and get
    m = hm_insert_v(m, 1, 1.5)
    m = hm_insert_v(m, 2, 2.5)
    m = hm_insert_v(m, 3, 3.5)

    if hm_count_v(m) != 3 { return 105 }
    if !near(hm_get_v(m, 1), 1.5) { return 106 }
    if !near(hm_get_v(m, 2), 2.5) { return 107 }
    if !near(hm_get_v(m, 3), 3.5) { return 108 }

    // Contains
    if !hm_contains_v(m, 1) { return 109 }
    if !hm_contains_v(m, 2) { return 110 }
    if hm_contains_v(m, 99) { return 111 }

    // Missing key returns 0.0
    if !near(hm_get_v(m, 999), 0.0) { return 112 }

    // Update existing key — count stays same
    m = hm_insert_v(m, 2, 99.9)
    if hm_count_v(m) != 3 { return 114 }
    if !near(hm_get_v(m, 2), 99.9) { return 115 }

    // Remove with tombstone
    m = hm_remove_v(m, 1)
    if hm_count_v(m) != 2 { return 117 }
    if hm_contains_v(m, 1) { return 118 }

    // Remove non-existent returns false
    let before_missing = hm_count_v(m)
    m = hm_remove_v(m, 42)
    if hm_count_v(m) != before_missing { return 119 }

    // Tombstone: insert key 1 again after removal — should still find via probing
    m = hm_insert_v(m, 1, 7.7)
    if !near(hm_get_v(m, 1), 7.7) { return 121 }
    if hm_count_v(m) != 3 { return 122 }

    // Collision handling: insert many keys that hash to same slot
    // Keys 0, 256, 512 all map to slot 0 with mask &255
    m = hm_insert_v(m, 0, 10.0)
    m = hm_insert_v(m, 256, 20.0)
    m = hm_insert_v(m, 512, 30.0)
    if !near(hm_get_v(m, 0), 10.0) { return 126 }
    if !near(hm_get_v(m, 256), 20.0) { return 127 }
    if !near(hm_get_v(m, 512), 30.0) { return 128 }

    // Negative key
    m = hm_insert_v(m, 0 - 7, 77.7)
    if !near(hm_get_v(m, 0 - 7), 77.7) { return 130 }

    0
}

// ============================================================================
// VecF64 tests — returns 0 on success, error code otherwise
// ============================================================================

fn test_vec() -> i32 with Mut, Div, Panic {
    var v = vec_new()
    // Empty
    if vec_len_v(v) != 0 { return 201 }

    // Push and len
    v = vec_push_v(v, 1.0)
    v = vec_push_v(v, 2.0)
    v = vec_push_v(v, 3.0)
    if vec_len_v(v) != 3 { return 205 }

    // Get
    if !near(vec_get_v(v, 0), 1.0) { return 206 }
    if !near(vec_get_v(v, 1), 2.0) { return 207 }
    if !near(vec_get_v(v, 2), 3.0) { return 208 }

    // Out-of-bounds get returns 0.0
    if !near(vec_get_v(v, 99), 0.0) { return 209 }

    // Set
    v = vec_set_v(v, 1, 9.9)
    if !near(vec_get_v(v, 1), 9.9) { return 210 }

    // Out-of-bounds set is a no-op
    v = vec_set_v(v, 99, 1.0)
    if vec_len_v(v) != 3 { return 211 }

    // Sum: 1.0 + 9.9 + 3.0 = 13.9
    if !near(vec_sum_v(v), 13.9) { return 212 }

    // Pop
    let popped = vec_get_v(v, vec_len_v(v) - 1)
    v = vec_pop_v(v)
    if !near(popped, 3.0) { return 213 }
    if vec_len_v(v) != 2 { return 214 }

    // Pop from near-empty
    v = vec_pop_v(v)
    v = vec_pop_v(v)
    // Pop from empty returns 0.0
    let empty_pop = vec_get_v(v, 0)
    v = vec_pop_v(v)
    if !near(empty_pop, 0.0) { return 215 }
    if vec_len_v(v) != 0 { return 216 }

    // Rebuild for sum/mean/reverse tests
    v = vec_clear_v(v)
    v = vec_push_v(v, 2.0)
    v = vec_push_v(v, 4.0)
    v = vec_push_v(v, 6.0)
    v = vec_push_v(v, 8.0)
    // sum = 20.0
    if !near(vec_sum_v(v), 20.0) { return 217 }
    // mean = 5.0
    if !near(vec_mean_v(v), 5.0) { return 218 }

    // Reverse: [2,4,6,8] -> [8,6,4,2]
    v = vec_reverse_v(v)
    if !near(vec_get_v(v, 0), 8.0) { return 219 }
    if !near(vec_get_v(v, 1), 6.0) { return 220 }
    if !near(vec_get_v(v, 2), 4.0) { return 221 }
    if !near(vec_get_v(v, 3), 2.0) { return 222 }

    // Swap
    v = vec_swap_v(v, 0, 3)
    if !near(vec_get_v(v, 0), 2.0) { return 223 }
    if !near(vec_get_v(v, 3), 8.0) { return 224 }

    // Clear
    v = vec_clear_v(v)
    if vec_len_v(v) != 0 { return 225 }

    // Mean of empty vec returns 0.0
    if !near(vec_mean_v(v), 0.0) { return 226 }

    0
}

// ============================================================================
// Main
// ============================================================================

fn main() -> i32 with Mut, Div, Panic {
    let hm_result = test_hashmap()
    if hm_result != 0 { return hm_result }

    let v_result = test_vec()
    if v_result != 0 { return v_result }

    0
}
