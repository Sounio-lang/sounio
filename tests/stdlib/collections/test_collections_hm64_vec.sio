//@ run-pass
// E2E: HashMap64 and VecF64 standalone-function APIs
// Tests: insert/get/contains/remove/tombstone/collision/count (HashMap64)
//        push/pop/get/set/bounds/sum/mean/reverse/clear (VecF64)

use collections::hashmap::*
use collections::vec::*

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.0001
}

// ============================================================================
// HashMap64 tests — returns 0 on success, error code otherwise
// ============================================================================

fn test_hashmap(m: &!HashMap64) -> i32 with Mut, Div, Panic {
    if hashmap_count(m) != 0 { return 101 }

    let ok1 = hashmap_insert(m, 1, 1.5)
    if !ok1 { return 102 }
    let ok2 = hashmap_insert(m, 2, 2.5)
    if !ok2 { return 103 }
    let ok3 = hashmap_insert(m, 3, 3.5)
    if !ok3 { return 104 }

    if hashmap_count(m) != 3 { return 105 }
    if !near(hashmap_get(m, 1), 1.5) { return 106 }
    if !near(hashmap_get(m, 2), 2.5) { return 107 }
    if !near(hashmap_get(m, 3), 3.5) { return 108 }

    if !hashmap_contains(m, 1) { return 109 }
    if !hashmap_contains(m, 2) { return 110 }
    if hashmap_contains(m, 99) { return 111 }

    if !near(hashmap_get(m, 999), 0.0) { return 112 }

    let ok_upd = hashmap_insert(m, 2, 99.9)
    if !ok_upd { return 113 }
    if hashmap_count(m) != 3 { return 114 }
    if !near(hashmap_get(m, 2), 99.9) { return 115 }

    let rem1 = hashmap_remove(m, 1)
    if !rem1 { return 116 }
    if hashmap_count(m) != 2 { return 117 }
    if hashmap_contains(m, 1) { return 118 }

    let rem2 = hashmap_remove(m, 42)
    if rem2 { return 119 }

    let ok_re = hashmap_insert(m, 1, 7.7)
    if !ok_re { return 120 }
    if !near(hashmap_get(m, 1), 7.7) { return 121 }
    if hashmap_count(m) != 3 { return 122 }

    let okA = hashmap_insert(m, 0, 10.0)
    if !okA { return 123 }
    let okB = hashmap_insert(m, 256, 20.0)
    if !okB { return 124 }
    let okC = hashmap_insert(m, 512, 30.0)
    if !okC { return 125 }
    if !near(hashmap_get(m, 0), 10.0) { return 126 }
    if !near(hashmap_get(m, 256), 20.0) { return 127 }
    if !near(hashmap_get(m, 512), 30.0) { return 128 }

    let okN = hashmap_insert(m, 0 - 7, 77.7)
    if !okN { return 129 }
    if !near(hashmap_get(m, 0 - 7), 77.7) { return 130 }

    0
}

// ============================================================================
// VecF64 tests — returns 0 on success, error code otherwise
// ============================================================================

fn test_vec(v: &!VecF64) -> i32 with Mut, Div, Panic {
    if vec_len(v) != 0 { return 201 }

    // vec_push returns void
    vec_push(v, 1.0)
    vec_push(v, 2.0)
    vec_push(v, 3.0)
    if vec_len(v) != 3 { return 205 }

    if !near(vec_get(v, 0), 1.0) { return 206 }
    if !near(vec_get(v, 1), 2.0) { return 207 }
    if !near(vec_get(v, 2), 3.0) { return 208 }

    if !near(vec_get(v, 99), 0.0) { return 209 }

    vec_set(v, 1, 9.9)
    if !near(vec_get(v, 1), 9.9) { return 210 }

    vec_set(v, 99, 1.0)
    if vec_len(v) != 3 { return 211 }

    // Sum: 1.0 + 9.9 + 3.0 = 13.9
    if !near(vec_sum(v), 13.9) { return 212 }

    let popped = vec_pop(v)
    if !near(popped, 3.0) { return 213 }
    if vec_len(v) != 2 { return 214 }

    var _d1 = vec_pop(v)
    var _d2 = vec_pop(v)
    let empty_pop = vec_pop(v)
    if !near(empty_pop, 0.0) { return 215 }
    if vec_len(v) != 0 { return 216 }

    vec_clear(v)
    vec_push(v, 2.0)
    vec_push(v, 4.0)
    vec_push(v, 6.0)
    vec_push(v, 8.0)
    if !near(vec_sum(v), 20.0) { return 217 }
    if !near(vec_mean(v), 5.0) { return 218 }

    vec_reverse(v)
    if !near(vec_get(v, 0), 8.0) { return 219 }
    if !near(vec_get(v, 1), 6.0) { return 220 }
    if !near(vec_get(v, 2), 4.0) { return 221 }
    if !near(vec_get(v, 3), 2.0) { return 222 }

    vec_swap(v, 0, 3)
    if !near(vec_get(v, 0), 2.0) { return 223 }
    if !near(vec_get(v, 3), 8.0) { return 224 }

    vec_clear(v)
    if vec_len(v) != 0 { return 225 }

    if !near(vec_mean(v), 0.0) { return 226 }

    0
}

// ============================================================================
// Main
// ============================================================================

fn main() -> i32 with Mut, Div, Panic {
    var m = hashmap_new()
    let hm_result = test_hashmap(&!m)
    if hm_result != 0 { return hm_result }

    var v = vec_new()
    let v_result = test_vec(&!v)
    if v_result != 0 { return v_result }

    0
}
