//@ run-pass
// E2E: stdlib/collections/heap_vec.sio — HeapVec<T> generic + concrete impls

use collections::heap_vec::*;

fn main() -> i32 with IO, Alloc, Mut {
    // HeapVec<i64> — full method coverage
    var vi = HeapVec::<i64>::new()
    if vi.is_empty() == false { print("FAIL new not empty\n"); return 1 }

    vi.push(10)
    vi.push(20)
    vi.push(30)
    if vi.len() != 3 { print("FAIL i64 len\n"); return 1 }
    if vi.get(0) != 10 { print("FAIL i64 get(0)\n"); return 1 }
    if vi.get(1) != 20 { print("FAIL i64 get(1)\n"); return 1 }
    if vi.get(2) != 30 { print("FAIL i64 get(2)\n"); return 1 }
    if vi.contains(20) == false { print("FAIL i64 contains\n"); return 1 }
    if vi.contains(99) == true  { print("FAIL i64 not contains\n"); return 1 }
    if vi.sum() != 60 { print("FAIL i64 sum\n"); return 1 }

    vi.set(1, 99)
    if vi.get(1) != 99 { print("FAIL i64 set\n"); return 1 }

    let popped = vi.pop()
    if popped != 30 { print("FAIL i64 pop\n"); return 1 }
    if vi.len() != 2 { print("FAIL i64 len after pop\n"); return 1 }

    vi.clear()
    if vi.len() != 0 { print("FAIL i64 clear\n"); return 1 }
    if vi.is_empty() == false { print("FAIL i64 is_empty\n"); return 1 }

    // with_capacity and growth
    var v2 = HeapVec::<i64>::with_capacity(2)
    if v2.cap() != 2 { print("FAIL i64 with_capacity\n"); return 1 }
    v2.push(1)
    v2.push(2)
    v2.push(3)
    if v2.cap() < 2 { print("FAIL i64 grew\n"); return 1 }
    v2.free()

    vi.free()

    // HeapVec<f64> — struct creation and storage/retrieval work.
    // NOTE: f64 arithmetic on values returned from generic-struct methods
    // currently has a known codegen issue; we test push/get/len/cap only.
    var vf = HeapVec::<f64>::new()
    vf.push(1.5)
    vf.push(2.5)
    vf.push(3.5)
    if vf.len() != 3 { print("FAIL f64 len\n"); return 1 }
    if vf.get(0) != 1.5 { print("FAIL f64 get(0)\n"); return 1 }
    if vf.get(1) != 2.5 { print("FAIL f64 get(1)\n"); return 1 }
    if vf.get(2) != 3.5 { print("FAIL f64 get(2)\n"); return 1 }
    vf.free()

    // Backward compat: concrete HeapI64Vec and HeapF64Vec still work
    var ci = HeapI64Vec { ptr: 0 as *mut i64, len: 0, cap: 0 }
    ci.push(7)
    if ci.get(0) != 7 { print("FAIL concrete i64\n"); return 1 }
    ci.free()

    var cf = HeapF64Vec { ptr: 0 as *mut f64, len: 0, cap: 0 }
    cf.push(2.0)
    cf.push(3.0)
    let cs = cf.sum()
    if cs < 4.9 || cs > 5.1 { print("FAIL concrete f64 sum\n"); return 1 }
    cf.free()

    print("PASS\n")
    return 0
}
