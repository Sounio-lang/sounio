// Deepened run-proof for stdlib roots::lib id dispatch only.
// f_id = 0 is x*x - 2. root_unc is a convergence width, not Epistemic.variance
// and not a measurement uncertainty. Does not call the fn(f64)->f64 API.
// lean_single.
use roots::lib::*

fn ae(a: f64, b: f64) -> f64 {
    if a > b { a - b } else { b - a }
}

fn near_sqrt2(x: f64) -> bool {
    ae(x, 1.41421356237) < 1.0e-6
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let bis = bisection_id(0, 1.0, 2.0, 1.0e-8, 80)
    if bis.converged != 1 { print("FAIL bis_flag\n"); return 1 }
    if !near_sqrt2(bis.root) { print("FAIL bis_root\n"); return 2 }
    // Residual stop reports tol/2. Measured 2026-10-15: unc = 5e-9 exactly.
    // That stand-in is a convergence width, not the leftover bracket and not a GUM variance.
    if bis.root_unc < 0.0 || bis.root_unc > 5.0e-9 { print("FAIL bis_width\n"); return 3 }

    let newt = newton_id(0, 1.0, 1.0e-12, 40)
    if newt.converged != 1 { print("FAIL newt_flag\n"); return 4 }
    if !near_sqrt2(newt.root) { print("FAIL newt_root\n"); return 5 }
    // |f|/|f'| at the stop. Measured 1.6e-16 on this start.
    if newt.root_unc < 0.0 || newt.root_unc > 1.0e-9 { print("FAIL newt_width\n"); return 6 }

    let sec = secant_id(0, 1.0, 2.0, 1.0e-12, 40)
    if sec.converged != 1 { print("FAIL sec_flag\n"); return 7 }
    if !near_sqrt2(sec.root) { print("FAIL sec_root\n"); return 8 }
    // |x_curr - x_prev| at the stop. Measured 3.2e-10 on this start.
    if sec.root_unc < 0.0 || sec.root_unc > 1.0e-9 { print("FAIL sec_width\n"); return 9 }

    // [2, 3] does not bracket x*x-2. Width is half the initial interval.
    let miss = bisection_id(0, 2.0, 3.0, 1.0e-8, 20)
    if miss.converged != 0 { print("FAIL miss_flag\n"); return 10 }
    if ae(miss.root_unc, 0.5) >= 1.0e-12 { print("FAIL miss_width\n"); return 11 }

    // Claims formerly checked only by the inlined copy.
    let cubic = secant_id(1, 1.0, 2.0, 1.0e-8, 200)
    if cubic.converged != 1 { print("FAIL cubic_flag\n"); return 12 }
    if ae(cubic.root, 1.3247179572) >= 1.0e-6 { print("FAIL cubic_root\n"); return 13 }

    let dottie = brent_id(2, 0.0, 1.0, 1.0e-8, 200)
    if dottie.converged != 1 { print("FAIL brent_cos_flag\n"); return 14 }
    if ae(dottie.root, 0.73908513321) >= 1.0e-6 { print("FAIL brent_cos\n"); return 15 }
    if dottie.root_unc < 0.0 { print("FAIL brent_cos_width\n"); return 16 }

    let ln3 = brent_id(3, 0.0, 2.0, 1.0e-8, 200)
    if ln3.converged != 1 { print("FAIL brent_exp_flag\n"); return 17 }
    if ae(ln3.root, 1.09861228867) >= 1.0e-6 { print("FAIL brent_exp\n"); return 18 }
    if ln3.root_unc < 0.0 { print("FAIL brent_exp_width\n"); return 19 }

    print("ROOTS_ID_DEEP_STDLIB_OK\n")
    return 0
}
