//@ run-pass
// Sprint 230: E2E test for functional calculus library

use functional::calculus::{
    deriv, deriv_h, deriv2, deriv4,
    newton, bisect, secant,
    integrate, integrate_n, trapezoid,
    minimize, maximize,
    fixed_point,
    fc_abs, fc_sqrt,
}

// Pure Sounio sin(x) via Taylor series
fn my_sin(x: f64) -> f64 with Mut, Panic, Div {
    let x2 = x * x
    let t1 = x
    let t3 = 0.0 - x * x2 / 6.0
    let t5 = 0.0 - t3 * x2 / 20.0
    let t7 = 0.0 - t5 * x2 / 42.0
    let t9 = 0.0 - t7 * x2 / 72.0
    let t11 = 0.0 - t9 * x2 / 110.0
    let t13 = 0.0 - t11 * x2 / 156.0
    t1 + t3 + t5 + t7 + t9 + t11 + t13
}

// cos(x) = sin(x + pi/2)
fn my_cos(x: f64) -> f64 with Mut, Panic, Div {
    my_sin(x + 1.5707963267949)
}

// Test functions
fn parabola(x: f64) -> f64 { x * x - 4.0 * x + 3.0 }
fn cubic(x: f64) -> f64 { x * x * x - 2.0 * x - 5.0 }
fn identity(x: f64) -> f64 { x }
fn neg_parabola(x: f64) -> f64 { 0.0 - (x * x - 4.0 * x + 3.0) }

// Fixed-point test: cos has fixed point near 0.7391
fn fp_cos(x: f64) -> f64 with Mut, Panic, Div { my_cos(x) }

fn main() -> i32 with IO, Mut, Panic, Div {
    let pi = 3.14159265358979

    // ---- Differentiation ----

    // d/dx sin(0) = cos(0) = 1.0
    let d1 = deriv(my_sin, 0.0)
    assert(fc_abs(d1 - 1.0) < 0.001)

    // d/dx sin(pi/2) = cos(pi/2) = 0.0
    let d2 = deriv(my_sin, 1.5707963)
    assert(fc_abs(d2) < 0.01)

    // d/dx x^2 at x=3 = 6.0
    let d3 = deriv(parabola, 3.0)
    // parabola'(x) = 2x - 4, at x=3: 2
    assert(fc_abs(d3 - 2.0) < 0.001)

    // Second derivative: parabola''(x) = 2 everywhere
    let d2nd = deriv2(parabola, 1.0)
    assert(fc_abs(d2nd - 2.0) < 0.01)

    // ---- Root Finding ----

    // Newton: sin(x)=0 near x=3 -> pi
    let root1 = newton(my_sin, 3.0)
    assert(fc_abs(root1 - pi) < 0.001)

    // Bisection: cubic root in [2,3]
    let root2 = bisect(cubic, 2.0, 3.0)
    assert(fc_abs(cubic(root2)) < 0.001)
    assert(fc_abs(root2 - 2.0946) < 0.01)

    // Secant: parabola root near 0.5 -> 1.0
    let root3 = secant(parabola, 0.5, 0.8)
    assert(fc_abs(root3 - 1.0) < 0.001)

    // ---- Integration ----

    // integral of sin from 0 to pi = 2.0
    let area1 = integrate(my_sin, 0.0, pi)
    assert(fc_abs(area1 - 2.0) < 0.01)

    // integral of x from 0 to 1 = 0.5
    let area2 = integrate(identity, 0.0, 1.0)
    assert(fc_abs(area2 - 0.5) < 0.001)

    // integral of parabola from 0 to 3 = [x^3/3 - 2x^2 + 3x]_0^3 = 9 - 18 + 9 = 0
    let area3 = integrate(parabola, 0.0, 3.0)
    assert(fc_abs(area3) < 0.01)

    // ---- Optimization ----

    // Minimize parabola on [0, 5] -> x=2.0
    let min1 = minimize(parabola, 0.0, 5.0)
    assert(fc_abs(min1 - 2.0) < 0.001)

    // Maximize negative parabola on [0, 5] -> also x=2.0
    let max1 = maximize(neg_parabola, 0.0, 5.0)
    assert(fc_abs(max1 - 2.0) < 0.001)

    // ---- Fixed Point ----

    // cos has fixed point near 0.7391 (Dottie number)
    let fp = fixed_point(fp_cos, 1.0)
    // cos(fp) should equal fp
    assert(fc_abs(my_cos(fp) - fp) < 0.001)

    // ---- sqrt ----
    let s = fc_sqrt(2.0)
    assert(fc_abs(s * s - 2.0) < 0.0001)

    print(0)
    0
}
