//@ run-pass
// Test functional::calculus — numerical differentiation, root finding,
// integration, and optimization with first-class function references.

// ============================================================================
// Self-contained math (pure Sounio, no extern C)
// ============================================================================

fn tc_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn tc_sqrt(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var guess = x
    if x > 1.0 { guess = x * 0.5 }
    var i: i64 = 0
    while i < 60 {
        guess = 0.5 * (guess + x / guess)
        i = i + 1
    }
    guess
}

fn tc_sin(x: f64) -> f64 with Mut, Panic, Div {
    // Reduce to [0, 2pi) then Taylor
    let pi = 3.14159265358979323846
    let twopi = 2.0 * pi
    var t = x
    while t > pi { t = t - twopi }
    while t < 0.0 - pi { t = t + twopi }
    // 9-term Taylor series
    var sum = t
    var term = t
    var i: i64 = 1
    while i < 9 {
        let n2 = (2 * i) as f64
        term = 0.0 - term * t * t / (n2 * (n2 + 1.0))
        sum = sum + term
        i = i + 1
    }
    sum
}

fn tc_cos(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.14159265358979323846
    tc_sin(x + pi * 0.5)
}

fn tc_exp(x: f64) -> f64 with Mut, Panic, Div {
    var sum = 1.0
    var term = 1.0
    var i: i64 = 1
    while i < 30 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    sum
}

// ============================================================================
// Numerical differentiation (central difference)
// ============================================================================

fn deriv(f: fn(f64) -> f64 with Mut, Panic, Div, x: f64) -> f64 with Mut, Panic, Div {
    let h = 0.00000001
    (f(x + h) - f(x - h)) / (2.0 * h)
}

fn deriv2(f: fn(f64) -> f64 with Mut, Panic, Div, x: f64) -> f64 with Mut, Panic, Div {
    let h = 0.0001
    (f(x + h) - 2.0 * f(x) + f(x - h)) / (h * h)
}

// ============================================================================
// Root finding
// ============================================================================

fn newton(f: fn(f64) -> f64 with Mut, Panic, Div, x0: f64) -> f64 with Mut, Panic, Div {
    var x = x0
    var i: i64 = 0
    while i < 100 {
        let fx = f(x)
        if tc_abs(fx) < 0.000000000001 { return x }
        let dfx = deriv(f, x)
        if tc_abs(dfx) < 0.0000000000000001 { return x }
        let step = fx / dfx
        if step > 1.0 { x = x - 1.0 }
        else if step < 0.0 - 1.0 { x = x + 1.0 }
        else { x = x - step }
        i = i + 1
    }
    x
}

fn bisect(f: fn(f64) -> f64 with Mut, Panic, Div, a: f64, b: f64) -> f64 with Mut, Panic, Div {
    var lo = a
    var hi = b
    var flo = f(lo)
    var i: i64 = 0
    while i < 100 {
        let mid = 0.5 * (lo + hi)
        if (hi - lo) < 0.000000000001 { return mid }
        let fmid = f(mid)
        if tc_abs(fmid) < 0.000000000001 { return mid }
        if (flo > 0.0 && fmid > 0.0) || (flo < 0.0 && fmid < 0.0) {
            lo = mid
            flo = fmid
        } else {
            hi = mid
        }
        i = i + 1
    }
    0.5 * (lo + hi)
}

// ============================================================================
// Integration (Simpson's 1/3)
// ============================================================================

fn integrate(f: fn(f64) -> f64 with Mut, Panic, Div, a: f64, b: f64) -> f64 with Mut, Panic, Div {
    let n: i64 = 1000
    let h = (b - a) / (n as f64)
    var sum = f(a) + f(b)
    var i: i64 = 1
    while i < n {
        let x = a + (i as f64) * h
        if i % 2 == 0 {
            sum = sum + 2.0 * f(x)
        } else {
            sum = sum + 4.0 * f(x)
        }
        i = i + 1
    }
    sum * h / 3.0
}

// ============================================================================
// Optimization (golden section)
// ============================================================================

fn minimize(f: fn(f64) -> f64 with Mut, Panic, Div, a: f64, b: f64) -> f64 with Mut, Panic, Div {
    let resphi = 0.3819660113
    var lo = a
    var hi = b
    var x1 = lo + resphi * (hi - lo)
    var x2 = hi - resphi * (hi - lo)
    var f1 = f(x1)
    var f2 = f(x2)
    var i: i64 = 0
    while i < 100 {
        if tc_abs(hi - lo) < 0.0000000001 { return 0.5 * (lo + hi) }
        if f1 < f2 {
            hi = x2
            x2 = x1
            f2 = f1
            x1 = lo + resphi * (hi - lo)
            f1 = f(x1)
        } else {
            lo = x1
            x1 = x2
            f1 = f2
            x2 = hi - resphi * (hi - lo)
            f2 = f(x2)
        }
        i = i + 1
    }
    0.5 * (lo + hi)
}

// ============================================================================
// Test target functions
// ============================================================================

fn f_x_squared(x: f64) -> f64 with Mut, Panic, Div { x * x }
fn f_x_cubed(x: f64) -> f64 with Mut, Panic, Div { x * x * x }
fn f_shifted(x: f64) -> f64 with Mut, Panic, Div { (x - 3.0) * (x - 3.0) }
fn f_exp_neg(x: f64) -> f64 with Mut, Panic, Div { tc_exp(0.0 - x * x) }

// ============================================================================
// Tests
// ============================================================================

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var pass: i64 = 0
    var fail: i64 = 0

    // T1: derivative of x² at x=3 → 2x = 6
    let d1 = deriv(f_x_squared, 3.0)
    if check_near(d1, 6.0, 0.001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T1: deriv(x^2, 3)") }

    // T2: derivative of x³ at x=2 → 3x² = 12
    let d2 = deriv(f_x_cubed, 2.0)
    if check_near(d2, 12.0, 0.001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T2: deriv(x^3, 2)") }

    // T3: second derivative of x² → 2 (constant)
    let d2_val = deriv2(f_x_squared, 5.0)
    if check_near(d2_val, 2.0, 0.01) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T3: deriv2(x^2)") }

    // T4: Newton root of x² - 4 = 0 → x = 2
    // Use (x-2)(x+2) = x² - 4, but we need a function that returns x²-4
    // Since we can't build closures, test with sin(x) root near pi
    let root_sin = newton(tc_sin, 3.0)
    let pi = 3.14159265358979323846
    if check_near(root_sin, pi, 0.0001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T4: newton(sin, 3.0)") }

    // T5: bisection root of sin on [2, 4] → pi
    let root_bi = bisect(tc_sin, 2.0, 4.0)
    if check_near(root_bi, pi, 0.0001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T5: bisect(sin, 2, 4)") }

    // T6: integrate sin from 0 to pi → 2.0
    let area = integrate(tc_sin, 0.0, pi)
    if check_near(area, 2.0, 0.001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T6: integrate(sin, 0, pi)") }

    // T7: integrate x² from 0 to 1 → 1/3
    let area2 = integrate(f_x_squared, 0.0, 1.0)
    if check_near(area2, 0.333333, 0.001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T7: integrate(x^2, 0, 1)") }

    // T8: minimize (x-3)² on [0, 10] → 3.0
    let xmin = minimize(f_shifted, 0.0, 10.0)
    if check_near(xmin, 3.0, 0.001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T8: minimize((x-3)^2)") }

    // T9: minimize x² on [-5, 5] → 0.0
    let xmin2 = minimize(f_x_squared, 0.0 - 5.0, 5.0)
    if check_near(xmin2, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T9: minimize(x^2)") }

    // T10: derivative of cos at 0 → -sin(0) = 0
    let d_cos = deriv(tc_cos, 0.0)
    if check_near(d_cos, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1; println("FAIL T10: deriv(cos, 0)") }

    // Summary
    print("functional::calculus tests: ")
    print(pass)
    print(" passed, ")
    print(fail)
    println(" failed")

    if fail > 0 { return 1 }
    0
}
