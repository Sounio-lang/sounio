//@ run-pass
//@ expect-stdout: FACTOR_LAYOUT_REFUSAL_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use linalg::dynamic_factorize::{dynamic_lu}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var a=numeric_buffer_new(3,24)
 var factor=numeric_buffer_new(4,32)
 var work=numeric_buffer_new(6,48)
 var pivot=integer_buffer_new(2,16)
 var pivotwork=integer_buffer_new(2,16)
 var i:i64=0
 while i<3 {numeric_buffer_set(&!a,i,1.0);i=i+1}
 i=0;while i<4 {numeric_buffer_set(&!factor,i,71.0);i=i+1}
 i=0;while i<6 {numeric_buffer_set(&!work,i,73.0);i=i+1}
 integer_buffer_set(&!pivot,0,79);integer_buffer_set(&!pivot,1,79)
 integer_buffer_set(&!pivotwork,0,83);integer_buffer_set(&!pivotwork,1,83)
 let layout=numeric_matrix(4,2,2,2,1,0)
 let result=dynamic_lu(&a,&layout,&!factor,&!pivot,&!work,&!pivotwork,0.0)
 assert(result.status==1 && result.n==2)
 i=0;while i<4 {assert(numeric_buffer_at(&factor,i)==71.0);i=i+1}
 i=0;while i<6 {assert(numeric_buffer_at(&work,i)==73.0);i=i+1}
 assert(integer_buffer_at(&pivot,0)==79 && integer_buffer_at(&pivot,1)==79)
 assert(integer_buffer_at(&pivotwork,0)==83 && integer_buffer_at(&pivotwork,1)==83)
 numeric_buffer_close(a);numeric_buffer_close(factor);numeric_buffer_close(work)
 integer_buffer_close(pivot);integer_buffer_close(pivotwork)
 println("FACTOR_LAYOUT_REFUSAL_PASS")
 0
}
