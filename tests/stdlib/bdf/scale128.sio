//@ run-pass
//@ expect-stdout: BDF_SCALE_PASS
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_len,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_close}
use ode::bdf_checked::{BDFOptions,bdf_workspace,solve_bdf1_checked}
fn diagonal_rhs(t:f64,y:&NumericBuffer,out:&!NumericBuffer)->i64 with Mut,Div,Panic {
 let n=numeric_buffer_len(y)
 var i:i64=0
 while i<n {numeric_buffer_set(out,i,-numeric_buffer_at(y,i));i=i+1}
 0
}
fn diagonal_jac(t:f64,y:&NumericBuffer,out:&!NumericBuffer)->i64 with Mut,Div,Panic {
 let n=numeric_buffer_len(y)
 var i:i64=0
 while i<n {var j:i64=0;while j<n {numeric_buffer_set(out,i*n+j,if i==j {-1.0}else{0.0});j=j+1};i=i+1}
 0
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let n:i64=128
 let shape=bdf_workspace(n)
 assert(shape.status==0)
 var state=numeric_buffer_new(n,n*8)
 var coarse=numeric_buffer_new(n,n*8)
 var half=numeric_buffer_new(n,n*8)
 var trial=numeric_buffer_new(n,n*8)
 var f=numeric_buffer_new(n,n*8)
 var residual=numeric_buffer_new(n,n*8)
 var delta=numeric_buffer_new(n,n*8)
 var matrix=numeric_buffer_new(n*n,n*n*8)
 var factor=numeric_buffer_new(n*n,n*n*8)
 var work=numeric_buffer_new(shape.factor_work_len,shape.factor_work_len*8)
 var pivots=integer_buffer_new(n,n*8)
 var pivotwork=integer_buffer_new(n,n*8)
 var i:i64=0
 while i<n {numeric_buffer_set(&!state,i,1.0+(i as f64)/128.0);i=i+1}
 let o=BDFOptions{atol:1.0e-5,rtol:1.0e-5,newton_tol:0.01,rcond:0.0,dt_init:0.001,dt_min:1.0e-16,dt_max:0.01,max_attempts:1000,max_newton:4}
 let r=solve_bdf1_checked(diagonal_rhs,diagonal_jac,&!state,&!coarse,&!half,&!trial,&!f,&!residual,&!delta,&!matrix,&!factor,&!work,&!pivots,&!pivotwork,0.0,0.01,&o)
 assert(r.status==0 && r.t_final==0.01)
 i=0
 while i<n {let bits:i64=f64_to_bits(numeric_buffer_at(&state,i));println("SCALE {} {}",i,bits);i=i+1}
 let accepted:i64=r.accepted;let attempts:i64=r.attempts;let calls:i64=r.nfeval;let factors:i64=r.nfactorizations;let bytes:i64=shape.payload_bytes
 println("SCALE_WORK {} {} {} {} {}",accepted,attempts,calls,factors,bytes)
 numeric_buffer_close(state);numeric_buffer_close(coarse);numeric_buffer_close(half);numeric_buffer_close(trial)
 numeric_buffer_close(f);numeric_buffer_close(residual);numeric_buffer_close(delta);numeric_buffer_close(matrix);numeric_buffer_close(factor);numeric_buffer_close(work)
 integer_buffer_close(pivots);integer_buffer_close(pivotwork)
 println("BDF_SCALE_PASS")
 0
}
