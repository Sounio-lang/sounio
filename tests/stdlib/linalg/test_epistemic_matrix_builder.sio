//@ run-pass
//@ expect-stdout: EPISTEMIC_MATRIX_OK
use linalg::epistemic_matrix::*;
fn main() -> i32 with IO, Mut, Div, Panic {
    var m = ematrix_zeros(2, 2)
    ematrix_set(&!m, 0, 0, 1.0, 0.1, 0.95)
    if ematrix_get_val(&m, 0, 0) != 1.0 { return 1 }
    println("EPISTEMIC_MATRIX_OK")
    0
}
