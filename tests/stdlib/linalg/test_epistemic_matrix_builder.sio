// tests/stdlib/linalg/test_epistemic_matrix_builder.sio — Tests for EpistemicMatrix Builder Pattern
//
// Tests for the new builder pattern and method chaining API.

use linalg::epistemic_matrix::{
    EpistemicMatrix, EpistemicScalar, MatrixConfidenceSummary,
    ematrix_zeros, ematrix_identity, ematrix_set,
    ematrix_get_val, ematrix_get_unc, ematrix_get_conf,
    ematrix_add, ematrix_sub, ematrix_mul, ematrix_scale, ematrix_transpose,
    ematrix_frobenius, ematrix_trace, ematrix_confidence_summary,
}

// =============================================================================
// Test: Builder Pattern - Basic Construction
// =============================================================================

fn test_ematrix_builder_zeros() with Mut, Div, Panic {
    // New builder pattern
    let m = ematrix_zeros(3, 3)
    
    // Verify dimensions
    assert(m.rows == 3)
    assert(m.cols == 3)
    
    // Verify all zeros
    assert(m.get_val(0, 0) == 0.0)
    assert(m.get_val(1, 1) == 0.0)
    assert(m.get_val(2, 2) == 0.0)
}

fn test_ematrix_builder_identity() with Mut, Div, Panic {
    // New builder pattern
    let m = ematrix_identity(3)
    
    // Verify diagonal is 1
    assert(m.get_val(0, 0) == 1.0)
    assert(m.get_val(1, 1) == 1.0)
    assert(m.get_val(2, 2) == 1.0)
    
    // Verify off-diagonal is 0
    assert(m.get_val(0, 1) == 0.0)
    assert(m.get_val(1, 0) == 0.0)
}

// =============================================================================
// Test: Method Chaining - uncertainty() and confidence()
// =============================================================================

fn test_ematrix_builder_uncertainty_confidence() with Mut, Div, Panic {
    // Builder pattern with default uncertainty and confidence
    let m = ematrix_zeros(2, 2)
        .uncertainty(0.1)
        .confidence(0.95)
        .set(0, 0, 1.0)
        .set(0, 1, 2.0)
        .set(1, 0, 3.0)
        .set(1, 1, 4.0)
    
    // Verify values
    assert(m.get_val(0, 0) == 1.0)
    assert(m.get_val(0, 1) == 2.0)
    assert(m.get_val(1, 0) == 3.0)
    assert(m.get_val(1, 1) == 4.0)
    
    // Verify uncertainty propagated
    assert(m.get_unc(0, 0) == 0.1)
    assert(m.get_unc(1, 1) == 0.1)
    
    // Verify confidence propagated
    assert(m.get_conf(0, 0) == 0.95)
    assert(m.get_conf(1, 1) == 0.95)
}

fn test_ematrix_builder_set_full() with Mut, Div, Panic {
    // Builder pattern with explicit uncertainty per element
    let m = ematrix_zeros(2, 2)
        .set_full(0, 0, 1.0, 0.01, 0.99)
        .set_full(1, 1, 2.0, 0.02, 0.95)
    
    // Verify values
    assert(m.get_val(0, 0) == 1.0)
    assert(m.get_val(1, 1) == 2.0)
    
    // Verify different uncertainties
    assert(m.get_unc(0, 0) == 0.01)
    assert(m.get_unc(1, 1) == 0.02)
    
    // Verify different confidences
    assert(m.get_conf(0, 0) == 0.99)
    assert(m.get_conf(1, 1) == 0.95)
}

// =============================================================================
// Test: Method Chaining - matmul()
// =============================================================================

fn test_ematrix_builder_matmul() with Mut, Div, Panic {
    // Create two matrices with builder pattern
    let a = ematrix_identity(2)
        .uncertainty(0.1)
        .confidence(0.95)
    
    let b = ematrix_zeros(2, 2)
        .set_full(0, 0, 2.0, 0.2, 0.90)
        .set_full(1, 1, 2.0, 0.2, 0.90)
    
    // Matrix multiplication with method chaining
    let c = a.matmul(&b)
    
    // C should be 2*I (since A=I)
    assert(c.get_val(0, 0) > 1.99 && c.get_val(0, 0) < 2.01)
    assert(c.get_val(1, 1) > 1.99 && c.get_val(1, 1) < 2.01)
    
    // Uncertainty should propagate (GUM formula)
    // u(c)^2 = u(a)^2 * b^2 + a^2 * u(b)^2
    // For identity: u(c) = sqrt(0.01 * 4 + 1 * 0.04) = sqrt(0.08) ≈ 0.283
    let unc = c.get_unc(0, 0)
    assert(unc > 0.27 && unc < 0.30)
}

// =============================================================================
// Test: Method Chaining - add(), sub(), scale(), transpose()
// =============================================================================

fn test_ematrix_builder_add() with Mut, Div, Panic {
    let a = ematrix_zeros(2, 2)
        .uncertainty(0.1)
        .confidence(0.95)
        .set(0, 0, 1.0)
    
    let b = ematrix_zeros(2, 2)
        .uncertainty(0.2)
        .confidence(0.90)
        .set(0, 0, 2.0)
    
    let c = a.add(&b)
    
    // Value should be 3.0
    assert(c.get_val(0, 0) == 3.0)
    
    // GUM: u(c) = sqrt(u(a)^2 + u(b)^2) = sqrt(0.01 + 0.04) = sqrt(0.05) ≈ 0.224
    let unc = c.get_unc(0, 0)
    assert(unc > 0.22 && unc < 0.23)
    
    // Confidence should be min(0.95, 0.90) = 0.90
    let conf = c.get_conf(0, 0)
    assert(conf > 0.89 && conf < 0.91)
}

fn test_ematrix_builder_sub() with Mut, Div, Panic {
    let a = ematrix_zeros(2, 2)
        .set_full(0, 0, 5.0, 0.1, 0.95)
    
    let b = ematrix_zeros(2, 2)
        .set_full(0, 0, 3.0, 0.2, 0.90)
    
    let c = a.sub(&b)
    
    // Value should be 2.0
    assert(c.get_val(0, 0) == 2.0)
    
    // GUM: u(c) = sqrt(u(a)^2 + u(b)^2)
    let unc = c.get_unc(0, 0)
    assert(unc > 0.22 && unc < 0.23)
}

fn test_ematrix_builder_scale() with Mut, Div, Panic {
    let a = ematrix_zeros(2, 2)
        .uncertainty(0.1)
        .confidence(0.95)
        .set(0, 0, 2.0)
    
    let c = a.scale(3.0)
    
    // Value should be 6.0
    assert(c.get_val(0, 0) == 6.0)
    
    // Uncertainty should scale: u(c*A) = |c| * u(A) = 3 * 0.1 = 0.3
    let unc = c.get_unc(0, 0)
    assert(unc == 0.3)
    
    // Confidence unchanged
    assert(c.get_conf(0, 0) == 0.95)
}

fn test_ematrix_builder_transpose() with Mut, Div, Panic {
    let a = ematrix_zeros(2, 3)
        .set_full(0, 0, 1.0, 0.1, 0.95)
        .set_full(1, 2, 2.0, 0.2, 0.90)
    
    let t = a.transpose()
    
    // Dimensions should swap: 2x3 -> 3x2
    assert(t.rows == 3)
    assert(t.cols == 2)
    
    // Values should transpose
    assert(t.get_val(0, 0) == 1.0)
    assert(t.get_val(2, 1) == 2.0)
    
    // Uncertainty preserved
    assert(t.get_unc(0, 0) == 0.1)
    assert(t.get_unc(2, 1) == 0.2)
    
    // Confidence preserved
    assert(t.get_conf(0, 0) == 0.95)
    assert(t.get_conf(2, 1) == 0.90)
}

// =============================================================================
// Test: Backward Compatibility - Standalone functions still work
// =============================================================================

fn test_ematrix_backward_compatibility_zeros() with Mut, Div, Panic {
    // Old API should still work
    var m = ematrix_zeros(3, 3)
    ematrix_set(&!m, 0, 0, 1.0, 0.1, 0.95)
    
    let val = ematrix_get_val(&m, 0, 0)
    let unc = ematrix_get_unc(&m, 0, 0)
    let conf = ematrix_get_conf(&m, 0, 0)
    
    assert(val == 1.0)
    assert(unc == 0.1)
    assert(conf == 0.95)
}

fn test_ematrix_backward_compatibility_identity() with Mut, Div, Panic {
    // Old API should still work
    let m = ematrix_identity(3)
    
    assert(ematrix_get_val(&m, 0, 0) == 1.0)
    assert(ematrix_get_val(&m, 1, 1) == 1.0)
    assert(ematrix_get_val(&m, 0, 1) == 0.0)
}

fn test_ematrix_backward_compatibility_ops() with Mut, Div, Panic {
    // Old API for operations should still work
    var a = ematrix_zeros(2, 2)
    var b = ematrix_zeros(2, 2)
    
    ematrix_set(&!a, 0, 0, 1.0, 0.1, 0.95)
    ematrix_set(&!b, 0, 0, 2.0, 0.2, 0.90)
    
    // Old API: ematrix_add
    let c_add = ematrix_add(&a, &b)
    assert(ematrix_get_val(&c_add, 0, 0) == 3.0)
    
    // Old API: ematrix_sub
    let c_sub = ematrix_sub(&a, &b)
    assert(ematrix_get_val(&c_sub, 0, 0) == -1.0)
    
    // Old API: ematrix_mul
    let c_mul = ematrix_mul(&a, &b)
    
    // Old API: ematrix_scale
    let c_scale = ematrix_scale(&a, 2.0)
    assert(ematrix_get_val(&c_scale, 0, 0) == 2.0)
    
    // Old API: ematrix_transpose
    let c_t = ematrix_transpose(&a)
    assert(ematrix_get_val(&c_t, 0, 0) == 1.0)
}

// =============================================================================
// Test: Complex Chain Operations
// =============================================================================

fn test_ematrix_builder_complex_chain() with Mut, Div, Panic {
    // Complex computation: (A + B).scale(0.5).matmul(&C)
    let a = ematrix_identity(2)
        .uncertainty(0.05)
        .confidence(0.99)
    
    let b = ematrix_zeros(2, 2)
        .uncertainty(0.1)
        .confidence(0.95)
        .set(0, 0, 0.5)
        .set(1, 1, 0.5)
    
    let c = ematrix_zeros(2, 2)
        .set_full(0, 0, 2.0, 0.1, 0.90)
        .set_full(1, 1, 2.0, 0.1, 0.90)
    
    // Chain: (a + b).scale(0.5).matmul(&c)
    let result = a.add(&b).scale(0.5).matmul(&c)
    
    // Diagonal should be approximately: (1 + 0.5) * 0.5 * 2 = 1.5
    let val = result.get_val(0, 0)
    assert(val > 1.49 && val < 1.51)
    
    // Confidence should degrade through chain
    let conf = result.get_conf(0, 0)
    assert(conf < 0.95)  // Should be degraded from original 0.99
}

// =============================================================================
// Main test runner
// =============================================================================

pub fn main() with Mut, Div, Panic {
    test_ematrix_builder_zeros()
    test_ematrix_builder_identity()
    test_ematrix_builder_uncertainty_confidence()
    test_ematrix_builder_set_full()
    test_ematrix_builder_matmul()
    test_ematrix_builder_add()
    test_ematrix_builder_sub()
    test_ematrix_builder_scale()
    test_ematrix_builder_transpose()
    test_ematrix_backward_compatibility_zeros()
    test_ematrix_backward_compatibility_identity()
    test_ematrix_backward_compatibility_ops()
    test_ematrix_builder_complex_chain()
    
    // Success indicator
    var i: i64 = 0
    while i < 3 {
        i = i + 1
    }
}
