//@ run-pass
// E2E test for stdlib/linalg/matrix
// Tests: mat2_new, mat2_identity, mat2_det, mat2_mul, mat2_inverse, mat2_trace

use linalg::matrix::*
use test::helpers::check_near

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: mat2_identity determinant = 1.0
    let eye = mat2_identity()
    let det_eye = mat2_det(eye)
    if check_near(det_eye, 1.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: mat2_identity trace = 2.0
    let tr_eye = mat2_trace(eye)
    if check_near(tr_eye, 2.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: det of A = [[2,1],[1,3]] is 2*3 - 1*1 = 5.0
    let a = mat2_new(2.0, 1.0, 1.0, 3.0)
    let det_a = mat2_det(a)
    if check_near(det_a, 5.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: trace of A = 2 + 3 = 5.0
    let tr_a = mat2_trace(a)
    if check_near(tr_a, 5.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: A * I = A (m00 element)
    let ai = mat2_mul(a, eye)
    if check_near(ai.m00, 2.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: A * inv(A) diagonal should be ~1.0
    let a_inv = mat2_inverse(a)
    let prod = mat2_mul(a, a_inv)
    if check_near(prod.m00, 1.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: A * inv(A) off-diagonal should be ~0.0
    if check_near(prod.m01, 0.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 8: A * inv(A) second diagonal should be ~1.0
    if check_near(prod.m11, 1.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 9: mat2_zero all elements are 0
    let z = mat2_zero()
    if check_near(z.m00, 0.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 10: mat2_add A + zero = A
    let sum = mat2_add(a, z)
    if check_near(sum.m00, 2.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
