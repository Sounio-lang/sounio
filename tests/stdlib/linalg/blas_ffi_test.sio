//@ run-pass
//@ expect-stdout: BLAS_FFI_OK
// tests/stdlib/linalg/blas_ffi_test.sio — BLAS Pure-Sounio Implementation Tests
//
// Tests for the pure-Sounio BLAS-compatible matrix operations in blas_ffi.sio.
// FFI is not available; blas_available() always returns false.

use linalg::blas_ffi::{
    blas_available, dgemm_available, dgesvd_available,
    blas_dgemm, blas_dgemm_rowmajor, blas_dgesvd_approx,
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

// =============================================================================
// Availability
// =============================================================================

fn test_blas_availability() with Panic, Div {
    // Pure-Sounio fallback — all return false
    assert(blas_available() == false)
    assert(dgemm_available() == false)
    assert(dgesvd_available() == false)
}

// =============================================================================
// DGEMM: C = A * B  (2x2)
// =============================================================================

fn test_dgemm_2x2() with Mut, Div, Panic {
    // A = [1 2; 3 4], B = [5 6; 7 8]
    // A*B = [19 22; 43 50]
    var a: [f64; 256] = [0.0; 256]
    var b: [f64; 256] = [0.0; 256]
    var c: [f64; 256] = [0.0; 256]

    a[0] = 1.0   a[1] = 2.0
    a[2] = 3.0   a[3] = 4.0

    b[0] = 5.0   b[1] = 6.0
    b[2] = 7.0   b[3] = 8.0

    let rc = blas_dgemm(&a, &b, &!c, 2, 2, 2)
    assert(rc == 0)

    assert(abs_f64(c[0] - 19.0) < 1e-10)
    assert(abs_f64(c[1] - 22.0) < 1e-10)
    assert(abs_f64(c[2] - 43.0) < 1e-10)
    assert(abs_f64(c[3] - 50.0) < 1e-10)
}

// =============================================================================
// DGEMM: C = alpha * A * B + beta * C  (rowmajor)
// =============================================================================

fn test_dgemm_rowmajor_alpha_beta() with Mut, Div, Panic {
    // A = [1 0; 0 1] (identity), B = [2 3; 4 5], C = [1 1; 1 1]
    // result = 2.0 * I * B + 0.5 * C = 2*B + 0.5*C
    // = [2*2+0.5, 2*3+0.5; 2*4+0.5, 2*5+0.5]
    // = [4.5, 6.5; 8.5, 10.5]
    var a: [f64; 256] = [0.0; 256]
    var b: [f64; 256] = [0.0; 256]
    var c: [f64; 256] = [0.0; 256]

    a[0] = 1.0   a[1] = 0.0
    a[2] = 0.0   a[3] = 1.0

    b[0] = 2.0   b[1] = 3.0
    b[2] = 4.0   b[3] = 5.0

    c[0] = 1.0   c[1] = 1.0
    c[2] = 1.0   c[3] = 1.0

    let rc = blas_dgemm_rowmajor(2, 2, 2, 2.0, &a, &b, 0.5, &!c)
    assert(rc == 0)

    assert(abs_f64(c[0] - 4.5) < 1e-10)
    assert(abs_f64(c[1] - 6.5) < 1e-10)
    assert(abs_f64(c[2] - 8.5) < 1e-10)
    assert(abs_f64(c[3] - 10.5) < 1e-10)
}

// =============================================================================
// DGEMM: Identity property A * I = A
// =============================================================================

fn test_dgemm_identity_property() with Mut, Div, Panic {
    // A * I = A
    var a: [f64; 256] = [0.0; 256]
    var id: [f64; 256] = [0.0; 256]
    var c: [f64; 256] = [0.0; 256]

    a[0] = 1.0   a[1] = 2.0   a[2] = 3.0
    a[3] = 4.0   a[4] = 5.0   a[5] = 6.0
    a[6] = 7.0   a[7] = 8.0   a[8] = 9.0

    id[0] = 1.0
    id[4] = 1.0
    id[8] = 1.0

    let rc = blas_dgemm(&a, &id, &!c, 3, 3, 3)
    assert(rc == 0)

    var row = 0
    while row < 3 {
        var col = 0
        while col < 3 {
            let idx = row * 3 + col
            assert(abs_f64(c[idx] - a[idx]) < 1e-10)
            col = col + 1
        }
        row = row + 1
    }
}

// =============================================================================
// DGEMM: Error handling
// =============================================================================

fn test_dgemm_error_invalid_dims() with Mut, Div, Panic {
    var a: [f64; 256] = [0.0; 256]
    var b: [f64; 256] = [0.0; 256]
    var c: [f64; 256] = [0.0; 256]

    // m=0 should return -1
    let rc = blas_dgemm_rowmajor(0, 2, 2, 1.0, &a, &b, 0.0, &!c)
    assert(rc == 0 - 1)
}

// =============================================================================
// DGESVD: Singular value of known matrix
// =============================================================================

fn test_dgesvd_identity() with Mut, Div, Panic {
    // Singular value of 2x2 identity should be 1.0
    var a: [f64; 256] = [0.0; 256]
    var s: [f64; 16] = [0.0; 16]

    a[0] = 1.0
    a[3] = 1.0

    let rc = blas_dgesvd_approx(&a, 2, 2, &!s, 20)
    assert(rc == 0)

    // Dominant singular value should be ~1.0
    assert(abs_f64(s[0] - 1.0) < 1e-6)
}

fn test_dgesvd_scaled_identity() with Mut, Div, Panic {
    // Singular value of 3*I should be 3.0
    var a: [f64; 256] = [0.0; 256]
    var s: [f64; 16] = [0.0; 16]

    a[0] = 3.0
    a[4] = 3.0
    a[8] = 3.0

    let rc = blas_dgesvd_approx(&a, 3, 3, &!s, 20)
    assert(rc == 0)
    assert(abs_f64(s[0] - 3.0) < 1e-5)
}

// =============================================================================
// Main
// =============================================================================

pub fn main() with IO, Mut, Div, Panic {
    test_blas_availability()
    test_dgemm_2x2()
    test_dgemm_rowmajor_alpha_beta()
    test_dgemm_identity_property()
    test_dgemm_error_invalid_dims()
    test_dgesvd_identity()
    test_dgesvd_scaled_identity()

    var i: i64 = 0
    while i < 3 { i = i + 1 }
    println("BLAS_FFI_OK")
}
