//@ run-pass
// E2E test for stdlib/linalg/decomp
// Tests: qr_decompose, eigen_decompose, qr_reconstruction_error, qr_orthogonality_error

use linalg::decomp::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Panic, Div {
    var pass = 0
    var fail = 0

    // Build a 3x3 test matrix
    // A = [[1, 2, 3],
    //      [4, 5, 6],
    //      [7, 8, 10]]  (det != 0)
    var a = mat8_zeros(3, 3)
    a = mat8_set(a, 0, 0, 1.0)
    a = mat8_set(a, 0, 1, 2.0)
    a = mat8_set(a, 0, 2, 3.0)
    a = mat8_set(a, 1, 0, 4.0)
    a = mat8_set(a, 1, 1, 5.0)
    a = mat8_set(a, 1, 2, 6.0)
    a = mat8_set(a, 2, 0, 7.0)
    a = mat8_set(a, 2, 1, 8.0)
    a = mat8_set(a, 2, 2, 10.0)

    // Test 1: QR decomposition of A
    let qr = qr_decompose(a)

    // Test 2: Q*R reconstruction error should be small
    let recon_err = qr_reconstruction_error(a, qr)
    if recon_err < 0.001 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: Q should be orthogonal: Q^T * Q = I
    let orth_err = qr_orthogonality_error(qr)
    if orth_err < 0.001 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: R should be upper triangular
    let tri_err = qr_upper_triangular_error(qr)
    if tri_err < 0.001 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: QR of identity should give Q=I, R=I
    let eye = mat8_identity(2)
    let qr_eye = qr_decompose(eye)
    let eye_recon = qr_reconstruction_error(eye, qr_eye)
    if eye_recon < 0.001 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: mat8_get/set round trip
    let v = mat8_get(a, 1, 1)
    if check_near(v, 5.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: symmetric eigendecomposition routes through the dense symmetric path
    var sym = mat8_zeros(3, 3)
    sym = mat8_set(sym, 0, 0, 2.0)
    sym = mat8_set(sym, 0, 1, 1.0)
    sym = mat8_set(sym, 1, 0, 1.0)
    sym = mat8_set(sym, 1, 1, 3.0)
    sym = mat8_set(sym, 1, 2, 1.0)
    sym = mat8_set(sym, 2, 1, 1.0)
    sym = mat8_set(sym, 2, 2, 2.0)

    let eig = eigen_decompose(sym)
    let eig_err = eigen_residual(sym, eig)
    let imag_total = check_near(eig.eigenvalues_imag[0], 0.0, 1.0e-8)
        && check_near(eig.eigenvalues_imag[1], 0.0, 1.0e-8)
        && check_near(eig.eigenvalues_imag[2], 0.0, 1.0e-8)

    if eig_err < 1.0e-6 && imag_total {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Panic, Div {
    return run_tests()
}
