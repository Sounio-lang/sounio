//@ run-pass
// E2E: stdlib/async/executor.sio — Executor spawn/complete

use async::executor::*;

fn run_tests(ex: &! Executor) -> i32 {
    // Empty executor
    if ex.task_count() != 0 { return 1 }
    if !ex.all_done() { return 2 }

    // Spawn tasks
    ex.spawn(1)
    ex.spawn(2)
    ex.spawn(3)
    if ex.task_count() != 3 { return 3 }
    if ex.pending_count() != 3 { return 4 }
    if ex.all_done() { return 5 }

    // Complete tasks
    ex.complete_task(0, 10)
    if ex.pending_count() != 2 { return 6 }

    ex.complete_task(1, 20)
    ex.complete_task(2, 30)
    if !ex.all_done() { return 7 }
    if ex.pending_count() != 0 { return 8 }

    return 0
}

fn main() -> i32 {
    var ex = Executor::new()
    return run_tests(&! ex)
}
