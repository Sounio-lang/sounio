//@ run-pass
// E2E: stdlib/async/executor.sio — Executor spawn/complete

use async::executor::*;

fn run_tests(ex: &! Executor) -> i32 with Mut {
    // Empty executor
    if executor_task_count(ex) != 0 { return 1 }
    if !executor_all_done(ex) { return 2 }

    // Spawn tasks
    executor_spawn(ex, 1)
    executor_spawn(ex, 2)
    executor_spawn(ex, 3)
    if executor_task_count(ex) != 3 { return 3 }
    if executor_pending_count(ex) != 3 { return 4 }
    if executor_all_done(ex) { return 5 }

    // Complete tasks
    executor_complete_task(ex, 0, 10)
    if executor_pending_count(ex) != 2 { return 6 }

    executor_complete_task(ex, 1, 20)
    executor_complete_task(ex, 2, 30)
    if !executor_all_done(ex) { return 7 }
    if executor_pending_count(ex) != 0 { return 8 }

    return 0
}

fn main() -> i32 with Mut {
    var ex = executor_new()
    return run_tests(&! ex)
}
