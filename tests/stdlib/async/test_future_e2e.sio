//@ run-pass
// E2E: stdlib/async/future.sio — PollResult

use async::future::*;

fn run_tests() -> i32 {
    // Pending
    let p = poll_pending()
    if poll_is_ready(&p) { return 1 }
    if !poll_is_pending(&p) { return 2 }

    // Ready
    let r = poll_ready(42)
    if !poll_is_ready(&r) { return 3 }
    if poll_is_pending(&r) { return 4 }
    if poll_value(&r) != 42 { return 5 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
