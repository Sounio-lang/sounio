//@ check-only
// E2E test for stdlib/plot/canvas
// Tests: Canvas, canvas_new, canvas_with_title, canvas_set, canvas_get,
//        canvas_hline, canvas_vline, canvas_draw_axes, canvas_fill_rect,
//        canvas_text, scale_linear,
//        shade_char, marker_dot, light_horizontal, light_vertical

use plot::canvas::*

fn run_tests() -> i32 {
    // Test 1: Create a canvas
    let c = canvas_new(40, 20)
    if c.width != 40 { return 1 }
    if c.height != 20 { return 1 }

    // Test 2: Create a canvas with title
    let c2 = canvas_with_title(40, 20, "My Plot")
    if c2.width != 40 { return 1 }

    // Test 3: Set and get a cell
    var c3 = canvas_new(10, 10)
    canvas_set(&! c3, 5, 5, "X")
    let ch = canvas_get(&c3, 5, 5)
    // ch should be "X"

    // Test 4: Scale linear mapping
    let px = scale_linear(50.0, 0.0, 100.0, 0, 80)
    if px != 40 { return 1 }

    // Test 5: shade_char for boundary values
    let s0 = shade_char(0.0)
    let s1 = shade_char(1.0)

    // Test 6: Marker and drawing character functions
    let md = marker_dot()
    let lh = light_horizontal()
    let lv = light_vertical()

    // Test 7: Draw axes on canvas
    var c4 = canvas_new(40, 20)
    canvas_draw_axes(&! c4, 5, 3)

    // Test 8: Fill rect
    var c5 = canvas_new(20, 10)
    canvas_fill_rect(&! c5, 2, 2, 5, 5, "#")

    return 0
}

fn main() -> i32 {
    return run_tests()
}
