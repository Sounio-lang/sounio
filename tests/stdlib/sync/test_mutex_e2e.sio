//@ run-pass
//@ requires: madaros
//@ expect-stdout: MUTEX_NATIVE_OK
use ffi::platform::{platform_open,platform_status,platform_close}
use sync::mutex::{mutex_new,mutex_status,mutex_is_valid,mutex_lock,mutex_try_lock,mutex_unlock,mutex_destroy,mutex_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let p=platform_open()
    assert(platform_status(&p)==0)
    var m=mutex_new(&p)
    assert(mutex_status(&m)==0)
    assert(mutex_is_valid(&m))
    assert(mutex_lock(&p,&m)==0)
    assert(mutex_lock(&p,&m)==35)
    assert(mutex_try_lock(&p,&m).status==16)
    assert(mutex_destroy(&p,&!m)==16)
    assert(mutex_is_valid(&m))
    assert(mutex_unlock(&p,&m)==0)
    assert(mutex_unlock(&p,&m)==1)
    assert(mutex_try_lock(&p,&m).status==0)
    assert(mutex_unlock(&p,&m)==0)
    assert(mutex_destroy(&p,&!m)==0)
    assert(!mutex_is_valid(&m))
    mutex_close(m)
    platform_close(p)
    println("MUTEX_NATIVE_OK")
    return 0
}
