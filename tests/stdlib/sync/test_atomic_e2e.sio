//@ run-pass
// E2E: stdlib/sync/atomic.sio — AtomicI64 operations

use sync::atomic::*;

fn run_tests(a: &! AtomicI64) -> i32 with Mut {
    // Initial value
    if atomic_load(a) != 0 { return 1 }

    // Store and load
    atomic_store(a, 42)
    if atomic_load(a) != 42 { return 2 }

    // Add
    let old = atomic_add(a, 10)
    if old != 42 { return 3 }
    if atomic_load(a) != 52 { return 4 }

    // Sub
    let old2 = atomic_sub(a, 2)
    if old2 != 52 { return 5 }
    if atomic_load(a) != 50 { return 6 }

    // CAS success
    let ok = atomic_cas(a, 50, 100)
    if !ok { return 7 }
    if atomic_load(a) != 100 { return 8 }

    // CAS failure
    let fail = atomic_cas(a, 50, 200)
    if fail { return 9 }
    if atomic_load(a) != 100 { return 10 }

    return 0
}

fn main() -> i32 with Mut {
    var a = atomic_new(0)
    return run_tests(&! a)
}
