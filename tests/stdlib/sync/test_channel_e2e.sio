//@ run-pass
// E2E: stdlib/sync/channel.sio — IntChannel send/recv

use sync::channel::*;

fn run_tests(ch: &! IntChannel) -> i32 with Mut {
    // Empty channel
    if !channel_is_empty(ch) { return 1 }

    // Send and recv
    let ok1 = channel_send(ch, 10)
    if !ok1 { return 2 }
    let ok2 = channel_send(ch, 20)
    if !ok2 { return 3 }
    let ok3 = channel_send(ch, 30)
    if !ok3 { return 4 }
    if channel_len(ch) != 3 { return 5 }

    // Recv in FIFO order
    let v1 = channel_recv(ch)
    if v1 != 10 { return 6 }
    let v2 = channel_recv(ch)
    if v2 != 20 { return 7 }
    let v3 = channel_recv(ch)
    if v3 != 30 { return 8 }

    // Empty after recv
    if !channel_is_empty(ch) { return 9 }

    // Close
    channel_close(ch)
    if !channel_is_closed(ch) { return 10 }
    let ok4 = channel_send(ch, 99)
    if ok4 { return 11 }

    return 0
}

fn main() -> i32 with Mut {
    var ch = channel_new()
    return run_tests(&! ch)
}
