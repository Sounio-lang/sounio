//@ run-pass
// E2E: stdlib/sync/rwlock.sio — RwLock read/write lock

use sync::rwlock::*;

fn run_tests(rw: &! RwLock) -> i32 with Mut {
    // Multiple read locks
    let r1 = rwlock_read_lock(rw)
    if !r1 { return 1 }
    let r2 = rwlock_read_lock(rw)
    if !r2 { return 2 }
    if rwlock_reader_count(rw) != 2 { return 3 }

    // Write lock fails while readers hold
    let w1 = rwlock_write_lock(rw)
    if w1 { return 4 }

    // Unlock readers
    rwlock_read_unlock(rw)
    rwlock_read_unlock(rw)
    if rwlock_reader_count(rw) != 0 { return 5 }

    // Write lock succeeds now
    let w2 = rwlock_write_lock(rw)
    if !w2 { return 6 }
    if !rwlock_is_write_locked(rw) { return 7 }

    // Read lock fails while writer holds
    let r3 = rwlock_read_lock(rw)
    if r3 { return 8 }

    // Unlock writer
    rwlock_write_unlock(rw)
    if rwlock_is_write_locked(rw) { return 9 }

    return 0
}

fn main() -> i32 with Mut {
    var rw = rwlock_new()
    return run_tests(&! rw)
}
