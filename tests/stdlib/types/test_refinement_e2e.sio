//@ run-pass
// tests/stdlib/types/test_refinement_e2e.sio — E2E tests for types::refinement
//
// Covers: construction, clamping, validity, invalid-input rejection, conversions
// for all 8 concrete refinement types.

use types::refinement::{
    Probability, ProbabilityResult,
    probability_is_valid, probability_try_new, probability_clamp, probability_value,
    Positive, PositiveResult,
    positive_is_valid, positive_try_new, positive_clamp, positive_value,
    NonNegative, NonNegativeResult,
    non_negative_is_valid, non_negative_try_new, non_negative_clamp, non_negative_value,
    Percentage, PercentageResult,
    percentage_is_valid, percentage_try_new, percentage_clamp, percentage_value,
    NonZero, NonZeroResult,
    non_zero_is_valid, non_zero_try_new, non_zero_value,
    Concentration, ConcentrationResult,
    concentration_is_valid, concentration_try_new, concentration_clamp, concentration_value,
    Temperature, TemperatureResult,
    temperature_is_valid, temperature_try_new, temperature_clamp, temperature_value,
    UnitInterval, UnitIntervalResult,
    unit_interval_is_valid, unit_interval_try_new, unit_interval_clamp, unit_interval_value,
    probability_to_percentage, percentage_to_probability,
    probability_to_unit_interval, positive_to_concentration,
    temperature_celsius_to_kelvin, temperature_kelvin_to_celsius,
}

fn abs_f(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// ============================================================================
// Probability [0, 1]
// ============================================================================

fn test_probability_valid() with Panic {
    assert(probability_is_valid(0.0))
    assert(probability_is_valid(0.5))
    assert(probability_is_valid(1.0))
    assert(!probability_is_valid(1.001))
    assert(!probability_is_valid(0.0 - 0.001))
}

fn test_probability_try_new() with Panic {
    let r1 = probability_try_new(0.5)
    assert(r1.ok)
    assert(abs_f(probability_value(r1.value) - 0.5) < 1.0e-15)

    let r2 = probability_try_new(2.0)
    assert(!r2.ok)

    let r3 = probability_try_new(0.0 - 0.1)
    assert(!r3.ok)
}

fn test_probability_clamp() with Panic {
    let p1 = probability_clamp(1.5)
    assert(abs_f(probability_value(p1) - 1.0) < 1.0e-15)

    let p2 = probability_clamp(0.0 - 0.5)
    assert(abs_f(probability_value(p2)) < 1.0e-15)

    let p3 = probability_clamp(0.3)
    assert(abs_f(probability_value(p3) - 0.3) < 1.0e-15)
}

// ============================================================================
// Positive (0, +inf)
// ============================================================================

fn test_positive_valid() with Panic {
    assert(positive_is_valid(1.0))
    assert(positive_is_valid(1.0e-300))
    assert(!positive_is_valid(0.0))
    assert(!positive_is_valid(0.0 - 1.0))
}

fn test_positive_try_new() with Panic {
    let r1 = positive_try_new(5.0)
    assert(r1.ok)
    assert(abs_f(positive_value(r1.value) - 5.0) < 1.0e-15)

    let r2 = positive_try_new(0.0)
    assert(!r2.ok)
}

fn test_positive_clamp() with Panic {
    let p = positive_clamp(0.0 - 1.0)
    assert(positive_value(p) > 0.0)
}

// ============================================================================
// NonNegative [0, +inf)
// ============================================================================

fn test_non_negative_valid() with Panic {
    assert(non_negative_is_valid(0.0))
    assert(non_negative_is_valid(100.0))
    assert(!non_negative_is_valid(0.0 - 0.001))
}

fn test_non_negative_try_new() with Panic {
    let r1 = non_negative_try_new(0.0)
    assert(r1.ok)
    assert(abs_f(non_negative_value(r1.value)) < 1.0e-15)

    let r2 = non_negative_try_new(0.0 - 5.0)
    assert(!r2.ok)
}

fn test_non_negative_clamp() with Panic {
    let n = non_negative_clamp(0.0 - 10.0)
    assert(abs_f(non_negative_value(n)) < 1.0e-15)
}

// ============================================================================
// Percentage [0, 100]
// ============================================================================

fn test_percentage_valid() with Panic {
    assert(percentage_is_valid(0.0))
    assert(percentage_is_valid(50.0))
    assert(percentage_is_valid(100.0))
    assert(!percentage_is_valid(100.001))
    assert(!percentage_is_valid(0.0 - 1.0))
}

fn test_percentage_try_new() with Panic {
    let r1 = percentage_try_new(75.5)
    assert(r1.ok)
    assert(abs_f(percentage_value(r1.value) - 75.5) < 1.0e-10)

    let r2 = percentage_try_new(101.0)
    assert(!r2.ok)
}

fn test_percentage_clamp() with Panic {
    let p1 = percentage_clamp(150.0)
    assert(abs_f(percentage_value(p1) - 100.0) < 1.0e-15)

    let p2 = percentage_clamp(0.0 - 10.0)
    assert(abs_f(percentage_value(p2)) < 1.0e-15)
}

// ============================================================================
// NonZero |x| > 1e-15
// ============================================================================

fn test_non_zero_valid() with Panic {
    assert(non_zero_is_valid(1.0))
    assert(non_zero_is_valid(0.0 - 1.0))
    assert(non_zero_is_valid(1.0e-14))
    assert(!non_zero_is_valid(0.0))
    assert(!non_zero_is_valid(1.0e-16))
}

fn test_non_zero_try_new() with Panic {
    let r1 = non_zero_try_new(3.14)
    assert(r1.ok)
    assert(abs_f(non_zero_value(r1.value) - 3.14) < 1.0e-10)

    let r2 = non_zero_try_new(0.0)
    assert(!r2.ok)
}

// ============================================================================
// Concentration (0, +inf)
// ============================================================================

fn test_concentration_valid() with Panic {
    assert(concentration_is_valid(1.0e-6))
    assert(concentration_is_valid(1.5))
    assert(!concentration_is_valid(0.0))
    assert(!concentration_is_valid(0.0 - 1.0))
}

fn test_concentration_try_new() with Panic {
    let r1 = concentration_try_new(0.001)
    assert(r1.ok)
    assert(abs_f(concentration_value(r1.value) - 0.001) < 1.0e-12)

    let r2 = concentration_try_new(0.0)
    assert(!r2.ok)
}

fn test_concentration_clamp() with Panic {
    let c = concentration_clamp(0.0 - 5.0)
    assert(concentration_value(c) > 0.0)
}

// ============================================================================
// Temperature (0, +inf) K
// ============================================================================

fn test_temperature_valid() with Panic {
    assert(temperature_is_valid(273.15))
    assert(temperature_is_valid(1.0e-10))
    assert(!temperature_is_valid(0.0))
    assert(!temperature_is_valid(0.0 - 10.0))
}

fn test_temperature_try_new() with Panic {
    let r1 = temperature_try_new(300.0)
    assert(r1.ok)
    assert(abs_f(temperature_value(r1.value) - 300.0) < 1.0e-10)

    let r2 = temperature_try_new(0.0)
    assert(!r2.ok)
}

fn test_temperature_clamp() with Panic {
    let t = temperature_clamp(0.0 - 100.0)
    assert(temperature_value(t) > 0.0)
}

// ============================================================================
// UnitInterval [0, 1]
// ============================================================================

fn test_unit_interval_valid() with Panic {
    assert(unit_interval_is_valid(0.0))
    assert(unit_interval_is_valid(1.0))
    assert(unit_interval_is_valid(0.5))
    assert(!unit_interval_is_valid(1.5))
}

fn test_unit_interval_try_new() with Panic {
    let r1 = unit_interval_try_new(0.25)
    assert(r1.ok)
    assert(abs_f(unit_interval_value(r1.value) - 0.25) < 1.0e-15)

    let r2 = unit_interval_try_new(0.0 - 0.1)
    assert(!r2.ok)
}

fn test_unit_interval_clamp() with Panic {
    let u1 = unit_interval_clamp(2.0)
    assert(abs_f(unit_interval_value(u1) - 1.0) < 1.0e-15)

    let u2 = unit_interval_clamp(0.0 - 1.0)
    assert(abs_f(unit_interval_value(u2)) < 1.0e-15)
}

// ============================================================================
// Conversions
// ============================================================================

fn test_conversions() with Div, Panic {
    let p = probability_try_new(0.5)
    assert(p.ok)

    // probability → percentage: 0.5 → 50.0
    let pct = probability_to_percentage(p.value)
    assert(abs_f(percentage_value(pct) - 50.0) < 1.0e-10)

    // percentage → probability: 50.0 → 0.5
    let p2 = percentage_to_probability(pct)
    assert(abs_f(probability_value(p2) - 0.5) < 1.0e-10)

    // probability → unit interval: identity
    let ui = probability_to_unit_interval(p.value)
    assert(abs_f(unit_interval_value(ui) - 0.5) < 1.0e-15)

    // celsius → kelvin: 0 C = 273.15 K
    let k = temperature_celsius_to_kelvin(0.0)
    assert(abs_f(k - 273.15) < 1.0e-10)

    // kelvin → celsius: 300 K = 26.85 C
    let t = temperature_try_new(300.0)
    assert(t.ok)
    let c = temperature_kelvin_to_celsius(t.value)
    assert(abs_f(c - 26.85) < 1.0e-10)

    // positive → concentration: identity
    let pos = positive_try_new(1.5)
    assert(pos.ok)
    let conc = positive_to_concentration(pos.value)
    assert(abs_f(concentration_value(conc) - 1.5) < 1.0e-15)
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with IO, Mut, Div, Panic {
    test_probability_valid()
    test_probability_try_new()
    test_probability_clamp()
    test_positive_valid()
    test_positive_try_new()
    test_positive_clamp()
    test_non_negative_valid()
    test_non_negative_try_new()
    test_non_negative_clamp()
    test_percentage_valid()
    test_percentage_try_new()
    test_percentage_clamp()
    test_non_zero_valid()
    test_non_zero_try_new()
    test_concentration_valid()
    test_concentration_try_new()
    test_concentration_clamp()
    test_temperature_valid()
    test_temperature_try_new()
    test_temperature_clamp()
    test_unit_interval_valid()
    test_unit_interval_try_new()
    test_unit_interval_clamp()
    test_conversions()
    println("PASS: types/refinement — all tests passed")
}
