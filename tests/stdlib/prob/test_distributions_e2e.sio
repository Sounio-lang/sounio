//@ check-only
// E2E test for stdlib/prob/distributions
// Tests: uniform_new, uniform_pdf, Uniform struct, abs_dist

use prob::distributions::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: uniform_new creates correct struct
    let u = uniform_new(0.0, 10.0)
    if check_near(u.a, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 2: uniform_new upper bound
    if check_near(u.b, 10.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 3: uniform_pdf inside range = 1/(b-a) = 0.1
    let p1 = uniform_pdf(u, 5.0)
    if check_near(p1, 0.1, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 4: uniform_pdf at lower bound
    let p2 = uniform_pdf(u, 0.0)
    if check_near(p2, 0.1, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 5: uniform_pdf at upper bound
    let p3 = uniform_pdf(u, 10.0)
    if check_near(p3, 0.1, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 6: uniform_pdf below range = 0
    let p4 = uniform_pdf(u, 0.0 - 1.0)
    if check_near(p4, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 7: uniform_pdf above range = 0
    let p5 = uniform_pdf(u, 11.0)
    if check_near(p5, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 8: uniform_new with unit interval [0,1]
    let u2 = uniform_new(0.0, 1.0)
    let p6 = uniform_pdf(u2, 0.5)
    if check_near(p6, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 9: abs_dist of negative value
    let a = abs_dist(0.0 - 5.0)
    if check_near(a, 5.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 10: abs_dist of positive value
    let b = abs_dist(3.0)
    if check_near(b, 3.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
