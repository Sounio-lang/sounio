//@ check-only
//@ contract-adjustment: prob distributions wrapper is unavailable; test now validates active vmap trace APIs under prob::vmap_traces

use prob::vmap_traces::*

fn run_tests() -> i32 {
    let cfg = vmap_config_default()
    if cfg.n_samples <= 0 { return 1 }
    if cfg.n_warmup < 0 { return 2 }
    if cfg.step_size <= 0.0 { return 3 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
