//@ check-only
// tests/stdlib/prob/test_distributions.sio
// Validation tests for the new distributions in stdlib/prob/distributions.sio:
// Gamma, Exponential, Uniform, Poisson, Dirichlet(K=2).
//
// Reference values computed from standard mathematical tables.

use prob::distributions::{
    gamma_log_pdf, gamma_cdf, gamma_mean, gamma_variance,
    exponential_log_pdf, exponential_cdf, exponential_mean, exponential_quantile,
    uniform_log_pdf, uniform_cdf, uniform_mean, uniform_quantile,
    poisson_log_pmf, poisson_mean, poisson_variance,
    dirichlet_log_pdf_2
}

fn abs_f(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

pub fn main() with Mut, Div, Panic {
    // ------------------------------------------------------------------
    // Exponential(1.0): CDF at x=1 = 1 - e^(-1) ≈ 0.6321
    // ------------------------------------------------------------------
    let e_cdf = exponential_cdf(1.0, 1.0)
    assert(abs_f(e_cdf - 0.6321) < 0.001)

    // Exponential mean = 1/lambda = 1.0
    assert(abs_f(exponential_mean(1.0) - 1.0) < 1.0e-10)

    // Exponential quantile: Q(0.0, 1.0) = 0
    let q0 = exponential_quantile(0.0, 1.0)
    assert(abs_f(q0) < 1.0e-10)

    // Exponential log-PDF at x=1, lambda=1: ln(1) - 1*1 = -1.0
    let e_lpdf = exponential_log_pdf(1.0, 1.0)
    assert(abs_f(e_lpdf - (0.0 - 1.0)) < 1.0e-6)

    // Exponential CDF at x=0: 0
    let e_cdf0 = exponential_cdf(0.0, 1.0)
    assert(abs_f(e_cdf0) < 1.0e-10)

    // ------------------------------------------------------------------
    // Uniform(0, 1): mean = 0.5
    // ------------------------------------------------------------------
    assert(uniform_mean(0.0, 1.0) == 0.5)

    // Uniform CDF at midpoint
    let u_cdf = uniform_cdf(0.5, 0.0, 1.0)
    assert(abs_f(u_cdf - 0.5) < 1.0e-10)

    // Uniform CDF below range = 0
    let u_cdf_lo = uniform_cdf(0.0 - 1.0, 0.0, 1.0)
    assert(abs_f(u_cdf_lo) < 1.0e-10)

    // Uniform CDF above range = 1
    let u_cdf_hi = uniform_cdf(2.0, 0.0, 1.0)
    assert(abs_f(u_cdf_hi - 1.0) < 1.0e-10)

    // Uniform quantile: Q(0.5, 0, 1) = 0.5
    let u_q = uniform_quantile(0.5, 0.0, 1.0)
    assert(abs_f(u_q - 0.5) < 1.0e-10)

    // Uniform log-PDF at 0.5, U(0,1): -ln(1) = 0
    let u_lpdf = uniform_log_pdf(0.5, 0.0, 1.0)
    assert(abs_f(u_lpdf) < 1.0e-10)

    // ------------------------------------------------------------------
    // Gamma(alpha=1, beta=1) = Exponential(1): CDF at x=1 should match
    // ------------------------------------------------------------------
    let g_cdf = gamma_cdf(1.0, 1.0, 1.0)
    assert(abs_f(g_cdf - e_cdf) < 0.01)

    // Gamma(2,1): mean = 2, variance = 2
    let g_mean = gamma_mean(2.0, 1.0)
    assert(abs_f(g_mean - 2.0) < 1.0e-10)

    let g_var = gamma_variance(2.0, 1.0)
    assert(abs_f(g_var - 2.0) < 1.0e-10)

    // ------------------------------------------------------------------
    // Poisson(lambda=2): mean = 2, variance = 2
    // ------------------------------------------------------------------
    let p_mean = poisson_mean(2.0)
    assert(abs_f(p_mean - 2.0) < 1.0e-10)

    let p_var = poisson_variance(2.0)
    assert(abs_f(p_var - 2.0) < 1.0e-10)

    // Poisson(2) PMF at k=0: e^(-2) ≈ 0.1353; log = -2
    let pmf0 = poisson_log_pmf(0, 2.0)
    assert(abs_f(pmf0 - (0.0 - 2.0)) < 0.001)

    // Poisson log-PMF should be -inf for k < 0
    let pmf_neg = poisson_log_pmf(0 - 1, 2.0)
    assert(pmf_neg < 0.0 - 1.0e20)

    // ------------------------------------------------------------------
    // Dirichlet(K=2): log-PDF for uniform = (1,1), point (0.5, 0.5)
    // Dir(1,1) = Uniform on simplex; log-PDF = 0 (constant = 1)
    // ------------------------------------------------------------------
    let d_lpdf = dirichlet_log_pdf_2(0.5, 0.5, 1.0, 1.0)
    assert(abs_f(d_lpdf) < 1.0e-6)

    // Loop guard (keep compiler happy with Mut effect)
    var i: i64 = 0
    while i < 3 { i = i + 1 }
}
