//@ check-only
// E2E test for stdlib/prob/beta
// Tests: beta_new, beta_uniform, beta_jeffreys, beta_weak, beta_posterior,
//        beta_mean, beta_variance, beta_std, beta_sample_size, beta_mode,
//        beta_risk_adjusted_mean, beta_ci_normal, beta_epsilon,
//        abs_f64, clamp01, sqrt_f64

use prob::beta::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: beta_uniform creates Beta(1,1)
    let u = beta_uniform()
    if check_near(u.alpha, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 2: beta_uniform beta = 1
    if check_near(u.beta, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 3: beta_mean of Beta(1,1) = 0.5
    let m = beta_mean(u)
    if check_near(m, 0.5, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 4: beta_variance of Beta(1,1) = 1/12 ~ 0.0833
    let v = beta_variance(u)
    if check_near(v, 0.0833, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 5: beta_jeffreys creates Beta(0.5, 0.5)
    let j = beta_jeffreys()
    if check_near(j.alpha, 0.5, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 6: beta_weak creates Beta(2,2)
    let w = beta_weak()
    if check_near(w.alpha, 2.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 7: beta_new with normal values
    let b = beta_new(3.0, 7.0)
    if check_near(b.alpha, 3.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 8: beta_mean of Beta(3,7) = 3/10 = 0.3
    let bm = beta_mean(b)
    if check_near(bm, 0.3, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 9: beta_sample_size of Beta(3,7) = 10
    let ss = beta_sample_size(b)
    if check_near(ss, 10.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 10: beta_mode of Beta(3,7) = (3-1)/(3+7-2) = 2/8 = 0.25
    let mo = beta_mode(b)
    if check_near(mo, 0.25, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 11: beta_std > 0 for Beta(3,7)
    let sd = beta_std(b)
    if sd > 0.0 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 12: beta_posterior updates correctly
    let prior = beta_uniform()
    let post = beta_posterior(prior, 3, 2)
    if check_near(post.alpha, 4.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 13: beta_posterior beta parameter
    if check_near(post.beta, 3.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 14: beta_ci_normal returns CI with lo <= hi
    let ci = beta_ci_normal(b, 1.96)
    if ci.lo <= ci.hi { pass = pass + 1 } else { fail = fail + 1 }

    // Test 15: beta_ci_normal lo >= 0
    if ci.lo >= 0.0 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 16: beta_ci_normal hi <= 1
    if ci.hi <= 1.0 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 17: beta_risk_adjusted_mean with lambda=1 < mean
    let ram = beta_risk_adjusted_mean(b, 1.0)
    if ram < bm { pass = pass + 1 } else { fail = fail + 1 }

    // Test 18: beta_epsilon returns positive
    let eps = beta_epsilon()
    if eps > 0.0 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 19: sqrt_f64 of 4.0 ~ 2.0
    let sq = sqrt_f64(4.0)
    if check_near(sq, 2.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 20: clamp01 clamps above 1.0
    let clamped = clamp01(1.5)
    if check_near(clamped, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
