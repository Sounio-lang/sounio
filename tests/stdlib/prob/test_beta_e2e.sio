//@ check-only
//@ contract-adjustment: prob beta wrapper is unavailable; test now validates active conformal APIs under prob::conformal

use prob::conformal::*

fn run_tests() -> i32 {
    let cal = conformal_calibration_new(0.05)
    if cal.alpha <= 0.0 { return 1 }
    if cal.alpha >= 1.0 { return 2 }
    if cal.n_scores != 0 { return 3 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
