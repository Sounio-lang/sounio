//@ run-pass
// E2E test for stdlib/prob/normal
// Tests: normal_new, normal_pdf, normal_zscore, normal_mean, normal_ci, normal_sum

use prob::normal::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: Standard normal pdf at x=0 is 1/sqrt(2*pi) approx 0.3989
    let n = normal_new(0.0, 1.0)
    let pdf_at_zero = normal_pdf(n, 0.0)
    if check_near(pdf_at_zero, 0.3989, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: Z-score of mu is 0
    let z_mu = normal_zscore(n, 0.0)
    if check_near(z_mu, 0.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: Z-score of (mu + sigma) is 1.0
    let z_one = normal_zscore(n, 1.0)
    if check_near(z_one, 1.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: normal_mean returns mu
    let m = normal_mean(n)
    if check_near(m, 0.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: normal_variance returns sigma^2
    let v = normal_variance(n)
    if check_near(v, 1.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: 95% CI for N(100, 10): [100 - 1.96*10, 100 + 1.96*10]
    let n2 = normal_new(100.0, 10.0)
    let ci = normal_ci(n2, 1.96)
    if check_near(ci.lo, 80.4, 0.1) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: Sum of two independent normals: N(1,1) + N(2,1) = N(3, sqrt(2))
    let a = normal_new(1.0, 1.0)
    let b = normal_new(2.0, 1.0)
    let s = normal_sum(a, b)
    let s_mean = normal_mean(s)
    if check_near(s_mean, 3.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 8: PDF is symmetric: pdf(mu+1) == pdf(mu-1)
    let pdf_plus = normal_pdf(n, 1.0)
    let pdf_minus = normal_pdf(n, 0.0 - 1.0)
    if check_near(pdf_plus, pdf_minus, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
