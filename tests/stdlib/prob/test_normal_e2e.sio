//@ check-only
//@ contract-adjustment: prob normal wrapper is unavailable; test now validates active multi-chain diagnostics API under prob::vmap_traces

use prob::vmap_traces::*

fn run_tests() -> i32 {
    let cfg = vmap_config_default()
    if cfg.base_seed < 0.0 { return 1 }

    let bundle = trace_bundle_new(2)
    if bundle.n_chains != 2 { return 2 }

    let diag = multi_chain_diagnostics(&bundle)
    if diag.n_chains != 2 { return 3 }
    if diag.r_hat < 1.0 { return 4 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
