//@ run-pass
// E2E test for stdlib/random/distributions
//
// Tests distribution constructors and analytical property functions
// (mean, variance) which are deterministic.

use random::distributions::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: Uniform mean = (low + high) / 2
    print("Test 1: uniform_mean([2,8])=5... ")
    let u = uniform_new(2.0, 8.0)
    if check_near(uniform_mean(u), 5.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: Uniform variance = (high - low)^2 / 12
    print("Test 2: uniform_variance([0,12])=12... ")
    let u2 = uniform_new(0.0, 12.0)
    if check_near(uniform_variance(u2), 12.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: Normal mean = given mean
    print("Test 3: normal_mean(5,2)=5... ")
    let n = normal_new(5.0, 2.0)
    if check_near(normal_mean(n), 5.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: Normal variance = std^2
    print("Test 4: normal_variance(0,3)=9... ")
    let n2 = normal_new(0.0, 3.0)
    if check_near(normal_variance(n2), 9.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: Exponential mean = 1/rate
    print("Test 5: exponential_mean(0.5)=2... ")
    let e = exponential_new(0.5)
    if check_near(exponential_mean(e), 2.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 6: Beta mean = alpha / (alpha + beta)
    print("Test 6: beta_mean(2,3)=0.4... ")
    let b = beta_new(2.0, 3.0)
    if check_near(beta_mean(b), 0.4, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 7: Poisson mean = rate
    print("Test 7: poisson_mean(4.5)=4.5... ")
    let p = poisson_new(4.5)
    if check_near(poisson_mean(p), 4.5, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
