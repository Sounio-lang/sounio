//@ run-pass
// E2E test for stdlib/random/xoshiro
//
// Tests: deterministic seeding, uniform output in [0,1), and
// repeated calls produce different values.

use random::xoshiro::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

// Helper: call xoshiro_next_i64 twice via a single &! borrow
// Returns true if successive calls produce different values
fn test_successive_differ(rng: &!Xoshiro256) -> bool with Mut {
    let a = xoshiro_next_i64(rng)
    let b = xoshiro_next_i64(rng)
    return a != b
}

// Helper: check uniform produces values in [0, 1) over n calls
fn test_uniform_range(rng: &!Xoshiro256, n: i32) -> bool with Prob, Mut, Div, Panic {
    var all_in_range = true
    var i = 0
    while i < n {
        let u = uniform(rng)
        if u < 0.0 || u >= 1.0 {
            all_in_range = false
        }
        i = i + 1
    }
    return all_in_range
}

fn run_tests() -> i32 with Mut, Prob, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: Seeding is deterministic -- same seed yields same first output
    print("Test 1: deterministic seed... ")
    var rng1 = xoshiro_seed(42)
    let v1 = xoshiro_next_i64(&!rng1)
    var rng2 = xoshiro_seed(42)
    let v2 = xoshiro_next_i64(&!rng2)
    if v1 == v2 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: Different seeds give different outputs
    print("Test 2: different seeds differ... ")
    var rng3 = xoshiro_seed(123)
    let v3 = xoshiro_next_i64(&!rng3)
    if v1 != v3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: uniform() produces values in [0, 1)
    print("Test 3: uniform in [0,1)... ")
    var rng4 = xoshiro_seed(99)
    if test_uniform_range(&!rng4, 20) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: Successive calls produce different values
    print("Test 4: successive calls differ... ")
    var rng5 = xoshiro_seed(77)
    if test_successive_differ(&!rng5) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Prob, Div, Panic {
    return run_tests()
}
