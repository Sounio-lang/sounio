//@ run-pass
// E2E: stdlib/random/rng.sio — PCG64 random number generator

use random::rng::*;

fn run_tests() -> i32 {
    // Create RNG with seed
    let rng = pcg64_new(42)

    // Generate a number — should be deterministic
    let r1 = pcg64_next_i64(rng)
    let val1 = r1.1
    let rng1 = r1.0
    if val1 == 0 { return 1 }

    // Generate another — should be different
    let r2 = pcg64_next_i64(rng1)
    let val2 = r2.1
    if val1 == val2 { return 2 }

    // Same seed gives same sequence
    let rng2 = pcg64_new(42)
    let r3 = pcg64_next_i64(rng2)
    let val3 = r3.1
    if val1 != val3 { return 3 }

    // Different seed gives different sequence
    let rng3 = pcg64_new(999)
    let r4 = pcg64_next_i64(rng3)
    let val4 = r4.1
    if val1 == val4 { return 4 }

    // Float generation
    let rng4 = pcg64_new(42)
    let r5 = pcg64_next_f64(rng4)
    let fval = r5.1

    return 0
}

fn main() -> i32 {
    return run_tests()
}
