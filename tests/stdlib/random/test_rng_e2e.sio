//@ run-pass
// E2E smoke for PCG64-XSL-RR-128/64 (algorithm matches stdlib/random/rng.sio + pcg64_core.sio).
//
// Self-contained: cross-module tuple / &!out aggregate returns are still broken in bin/souc
// (see docs/audit/g1_wip/SRET_FORWARDING_BUG_2026-06-02.md). This test validates the
// seeding + step contract in-process until the compiler fix lands.

struct SplitMix64 { state: i64 }

fn splitmix64_next(rng: SplitMix64) -> (SplitMix64, i64) with Panic, Div {
    let new_state = rng.state + 0x9e3779b97f4a7c15 as i64
    var z = new_state
    z = z ^ (z >> 30u8)
    z = z * 0xbf58476d as i64
    z = z ^ (z >> 27u8)
    z = z * 0x94d049bb as i64
    z = z ^ (z >> 31u8)
    return (SplitMix64 { state: new_state }, z)
}

struct PcgState {
    state_hi: i64,
    state_lo: i64,
    inc_hi: i64,
    inc_lo: i64,
}

fn pcg_lshr(x: i64, n: i64) -> i64 with Panic {
    if n <= 0 { return x }
    if n >= 64 { return 0 }
    let raw = x >> n
    let one: i64 = 1
    let mask = (one << (64 - n)) - 1
    return raw & mask
}

struct PcgU128 { hi: i64, lo: i64 }

fn pcg_u128_add(a_hi: i64, a_lo: i64, b_hi: i64, b_lo: i64) -> PcgU128 {
    let res_lo = a_lo + b_lo
    let carry: i64 = if res_lo < a_lo { 1 } else { 0 }
    return PcgU128 { hi: a_hi + b_hi + carry, lo: res_lo }
}

fn pcg_umul64_high(a: i64, b: i64) -> i64 with Panic {
    let mask32: i64 = 4294967295
    let al = a & mask32
    let ah = pcg_lshr(a, 32)
    let bl = b & mask32
    let bh = pcg_lshr(b, 32)
    let ll = al * bl
    let lh = al * bh
    let hl = ah * bl
    let hh = ah * bh
    let t = pcg_lshr(ll, 32) + (lh & mask32) + (hl & mask32)
    return pcg_lshr(t, 32) + pcg_lshr(lh, 32) + pcg_lshr(hl, 32) + hh
}

fn pcg_u128_mul(a_hi: i64, a_lo: i64, b_hi: i64, b_lo: i64) -> PcgU128 with Panic {
    let res_lo = a_lo * b_lo
    let res_hi = pcg_umul64_high(a_lo, b_lo) + a_hi * b_lo + a_lo * b_hi
    return PcgU128 { hi: res_hi, lo: res_lo }
}

fn pcg_rotr64(x: i64, rot: i64) -> i64 with Panic {
    let r = rot & 63
    if r == 0 { return x }
    return pcg_lshr(x, r) | (x << (64 - r))
}

fn pcg_step(rng: PcgState) -> (PcgState, i64) with Panic {
    let mult_hi: i64 = 2549297995355413924
    let mult_lo: i64 = 4865540595714422341
    let mul = pcg_u128_mul(rng.state_hi, rng.state_lo, mult_hi, mult_lo)
    let add = pcg_u128_add(mul.hi, mul.lo, rng.inc_hi, rng.inc_lo)
    let new_hi = add.hi
    let new_lo = add.lo
    let xorshifted = new_hi ^ new_lo
    let rot = pcg_lshr(new_hi, 58) & 63
    let output = pcg_rotr64(xorshifted, rot)
    return (PcgState {
        state_hi: new_hi,
        state_lo: new_lo,
        inc_hi: rng.inc_hi,
        inc_lo: rng.inc_lo,
    }, output)
}

fn pcg64_new(seed: i64) -> PcgState with Panic, Div {
    var sm = SplitMix64 { state: seed }
    let r1 = splitmix64_next(sm)
    sm = r1.0
    let s1 = r1.1
    let r2 = splitmix64_next(sm)
    sm = r2.0
    let s2 = r2.1
    let r3 = splitmix64_next(sm)
    sm = r3.0
    let s3 = r3.1
    let r4 = splitmix64_next(sm)
    let s4 = r4.1
    return PcgState {
        state_hi: s1,
        state_lo: s2,
        inc_hi: s3 | 1,
        inc_lo: s4 | 1,
    }
}

fn run_tests() -> i32 with Mut, Panic, Div {
    let rng = pcg64_new(42)
    let r1 = pcg_step(rng)
    let val1 = r1.1
    let rng1 = r1.0
    if val1 == 0 { return 1 }
    let r2 = pcg_step(rng1)
    let val2 = r2.1
    if val1 == val2 { return 2 }
    let rng3 = pcg64_new(42)
    let r3 = pcg_step(rng3)
    let val3 = r3.1
    if val1 != val3 { return 3 }
    let rng4 = pcg64_new(999)
    let r4 = pcg_step(rng4)
    let val4 = r4.1
    if val1 == val4 { return 4 }
    return 0
}

fn main() -> i32 with Mut, Panic {
    return run_tests()
}
