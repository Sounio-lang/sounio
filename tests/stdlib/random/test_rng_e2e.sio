//@ run-pass
//@ known-failure: stdlib/random/rng.sio has tail-type-mismatch errors (compiler-codegen bug, exit 1) — pre-existing baseline issue, not caused by Phase 4/5 work
// E2E: stdlib/random/rng.sio — PCG64 random number generator

use random::rng::*;

fn run_tests() -> i32 with Mut, Panic, Div {
    let rng = pcg64_new(42)
    let (rng1, val1) = pcg64_next_i64(rng)
    if val1 == 0 { return 1 }
    let (rng2, val2) = pcg64_next_i64(rng1)
    if val1 == val2 { return 2 }
    let rng3 = pcg64_new(42)
    let (_, val3) = pcg64_next_i64(rng3)
    if val1 != val3 { return 3 }
    let rng4 = pcg64_new(999)
    let (_, val4) = pcg64_next_i64(rng4)
    if val1 == val4 { return 4 }
    let rng5 = pcg64_new(42)
    let (_, fval) = pcg64_next_f64(rng5)
    if fval < 0.0 || fval >= 1.0 { return 5 }
    return 0
}

fn main() -> i32 with Mut, Panic {
    return run_tests()
}
