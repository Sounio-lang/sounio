//@ run-pass
//@ requires: madaros
//@ expect-stdout: NATIVE_CHANNEL_OK
use ffi::platform::{platform_open,platform_status,platform_close}
use sync::native_channel::{native_channel_new,native_channel_status,native_channel_token,channel_token_argument,channel_token_from_argument,native_channel_try_send,native_channel_send,native_channel_try_receive,native_channel_receive,native_channel_close,native_channel_destroy}
use thread::native::{native_thread_spawn_io,native_thread_status,native_thread_join,native_thread_close}
fn produce(argument:i64)->i64 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let token=channel_token_from_argument(&p,argument)
 var i:i64=0
 while i<128 {assert(native_channel_send(&p,&token,i,5000)==0);i=i+1}
 platform_close(p)
 return i
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let c=native_channel_new(&p,2,16)
 assert(native_channel_status(&c)==0)
 let token=native_channel_token(&c)
 assert(native_channel_try_receive(&p,&token).status==11)
 assert(native_channel_receive(&p,&token,1).status==110)
 assert(native_channel_try_send(&p,&token,0)==0)
 assert(native_channel_try_send(&p,&token,7)==0)
 assert(native_channel_try_send(&p,&token,9)==11)
 assert(native_channel_send(&p,&token,9,1)==110)
 let zero=native_channel_try_receive(&p,&token)
 assert(zero.status==0 && !zero.closed && zero.value==0)
 assert(native_channel_try_receive(&p,&token).value==7)
 var t=native_thread_spawn_io(&p,produce,channel_token_argument(&token))
 assert(native_thread_status(&t)==0)
 var i:i64=0
 while i<128 {
  let r=native_channel_receive(&p,&token,5000)
  assert(r.status==0 && !r.closed)
  assert(r.value==i)
  i=i+1
 }
 assert(native_thread_join(&p,&!t).value==128)
 assert(native_thread_close(&p,t)==0)
 assert(native_channel_try_send(&p,&token,42)==0)
 assert(native_channel_close(&p,&c)==0)
 assert(native_channel_try_send(&p,&token,1)==32)
 assert(native_channel_try_receive(&p,&token).value==42)
 let end=native_channel_try_receive(&p,&token)
 assert(end.status==0 && end.closed)
 assert(native_channel_destroy(&p,c)==0)
 assert(native_channel_try_receive(&p,&token).status==9)
 let invalid=native_channel_new(&p,2,8)
 assert(native_channel_status(&invalid)==105)
 assert(native_channel_destroy(&p,invalid)==105)
 platform_close(p)
 println("NATIVE_CHANNEL_OK")
 return 0
}
