use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
use thread::native::{native_thread_spawn,native_thread_status,native_thread_join,native_thread_close}
fn helper(x:i64)->i64 with IO {println(x);x}
fn task(x:i64)->i64 with IO {helper(x)}
fn main() with IO,Panic {let p=platform_open();let t=native_thread_spawn(&p,worker_fn_i64(task),0);assert(native_thread_close(&p,t)==0);platform_close(p)}
