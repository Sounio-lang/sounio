#include <cassert>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <thread>
using I=std::int64_t;
extern "C" I sounio_platform_call(I,I,I,I,I) noexcept;
static I ok(I op,I a=0,I b=0,I c=0,I d=0){
 const I v=sounio_platform_call(op,a,b,c,d);assert(sounio_platform_call(0,0,0,0,0)==0);return v;
}
int main(){
 const I c=ok(70,1,8);ok(71,c,99);
 const I p=ok(141,c,ok(149));ok(142,p,0,1,1);
 ok(143,p,std::numeric_limits<I>::max());
 std::this_thread::sleep_for(std::chrono::milliseconds(20));
 ok(146,p);assert(ok(144,p)==0);assert(ok(145,p)==125);
 ok(2,p);assert(ok(72,c)==99);ok(2,c);assert(ok(3)==0);
 std::puts("MAX_DEADLINE_CANCEL_CPP_OK cleanup=0");
}
