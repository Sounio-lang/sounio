// I64 and F64 capabilities are distinct nominal types.
use ffi::platform::{platform_open,platform_close}
use thread::native_pool_f64::{native_pool_f64_new,native_pool_f64_close}
fn identity(x:i64)->i64 {x}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 let pool=native_pool_f64_new(&p,worker_fn_i64(identity),1,1,2000000)
 assert(native_pool_f64_close(&p,pool)==0)
 platform_close(p)
 return 0
}
