// WorkerFn semantic refusal; E137 and parser errors do not qualify.
use ffi::platform::{platform_open,platform_status,platform_close}
use thread::native_pool::{native_pool_new,native_pool_close}

fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let offset:i64=7
 let pool=native_pool_new(&p,worker_fn_i64(|x:i64| -> i64 {x+offset}),1,1,2000000)
 assert(native_pool_close(&p,pool)==0)
 platform_close(p)
 return 0
}
