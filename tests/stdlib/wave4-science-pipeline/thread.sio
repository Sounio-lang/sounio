use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
use thread::native::{native_thread_spawn,native_thread_status,native_thread_join,native_thread_close}
fn zero(x:i64)->i64 {x-x}
fn plus(x:i64)->i64 {x+7}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 var t=native_thread_spawn(&p,worker_fn_i64(zero),0-17)
 assert(native_thread_status(&t)==0)
 let r=native_thread_join(&p,&!t)
 assert(r.status==0)
 assert(r.value==0)
 assert(native_thread_join(&p,&!t).status==22)
 assert(native_thread_close(&p,t)==0)
 var t2=native_thread_spawn(&p,worker_fn_i64(plus),0-49)
 assert(native_thread_status(&t2)==0)
 let r2=native_thread_join(&p,&!t2)
 assert(r2.status==0)
 assert(r2.value==0-42)
 assert(native_thread_close(&p,t2)==0)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("NATIVE_CERTIFIED_THREAD_OK")
 return 0
}
