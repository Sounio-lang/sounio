//@ run-pass
//@ expect-stdout: ARROW_WRITER_ABORT_OK
use ffi::platform::{Platform,platform_open,platform_status,platform_call,platform_close}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_push,byte_buffer_close}
use io::native_file::{native_file_open}
use arrow::lib::{arrow_schema_new,arrow_schema_add,arrow_type_int}
use arrow::native_stream::{ArrowStreamWriter,arrow_stream_writer_new,arrow_stream_writer_begin,arrow_stream_writer_finish,arrow_stream_writer_close,arrow_stream_writer_abort}
fn writer(p:&Platform,name:string)->ArrowStreamWriter with IO,Alloc,Mut,Div,Panic {
 var path=byte_buffer_new(4096)
 var i:i64=0
 while i<str_len(name) {assert(byte_buffer_push(&!path,str_char_at(name,i))==0);i=i+1}
 let out=arrow_stream_writer_new(native_file_open(p,&path,1))
 byte_buffer_close(path)
 return out
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let unfinished=writer(&p,"strict-unfinished.arrow")
 assert(arrow_stream_writer_close(&p,unfinished)==22)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 let unopened=writer(&p,"abort-unopened.arrow")
 assert(arrow_stream_writer_abort(&p,unopened)==0)
 var schema=arrow_schema_new()
 assert(arrow_schema_add(&!schema,"x",0,arrow_type_int(),64,1,0)==0)
 var begun=writer(&p,"abort-begun.arrow")
 assert(arrow_stream_writer_begin(&p,&!begun,&schema)==0)
 assert(arrow_stream_writer_abort(&p,begun)==0)
 var finished=writer(&p,"strict-finished.arrow")
 assert(arrow_stream_writer_begin(&p,&!finished,&schema)==0)
 assert(arrow_stream_writer_finish(&p,&!finished)==0)
 assert(arrow_stream_writer_close(&p,finished)==0)
 var close_error=writer(&p,"close-error.arrow")
 assert(arrow_stream_writer_begin(&p,&!close_error,&schema)==0)
 let expected_close:i64=0
 let code=arrow_stream_writer_abort(&p,close_error)
 println(code)
 assert(code==expected_close)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("ARROW_WRITER_ABORT_OK")
 return 0
}
