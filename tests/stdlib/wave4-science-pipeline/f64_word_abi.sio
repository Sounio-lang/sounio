//@ run-pass
//@ expect-stdout: NATIVE_F64_WORD_ABI_OK
// Deliberate raw FFI witness: independently proves native f64 GPR/RAX carrier.
use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
fn identity(x:f64)->f64 {x}
fn half(x:f64)->f64 {x*0.5}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let budget=platform_call(&p,139,2,4,0,0)
 assert(budget.status==0)
 let made=platform_call(&p,140,identity as i64,2,4,budget.value)
 assert(made.status==0)
 var bits:[i64;4]=[0,0-9223372036854775807-1,4602678819172646912,9221120237041090626]
 var i:i64=0
 while i<4 {
  let id=platform_call(&p,131,made.value,bits[i as usize],5000,0)
  assert(id.status==0 && id.value==i)
  let result=platform_call(&p,132,made.value,id.value,5000,0)
  assert(result.status==0 && result.value==bits[i as usize])
  i=i+1
 }
 assert(platform_call(&p,133,made.value,0,0,0).status==0)
 assert(platform_call(&p,134,made.value,0,0,0).status==0)
 assert(platform_call(&p,136,made.value,0,0,0).status==0)
 assert(platform_call(&p,2,made.value,0,0,0).status==0)
 let second=platform_call(&p,140,half as i64,2,4,budget.value)
 assert(second.status==0)
 let task=platform_call(&p,131,second.value,f64_to_bits(1.0),5000,0)
 assert(task.status==0)
 let answer=platform_call(&p,132,second.value,task.value,5000,0)
 assert(answer.status==0 && answer.value==f64_to_bits(0.5))
 assert(platform_call(&p,133,second.value,0,0,0).status==0)
 assert(platform_call(&p,134,second.value,0,0,0).status==0)
 assert(platform_call(&p,136,second.value,0,0,0).status==0)
 assert(platform_call(&p,2,second.value,0,0,0).status==0)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("NATIVE_F64_WORD_ABI_OK")
 return 0
}
