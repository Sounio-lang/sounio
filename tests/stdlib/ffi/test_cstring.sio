//@ ignore BLOCKED: uses unsafe blocks, raw pointer types (*const u8), and byte literals (b'..') which are not supported in the current JIT
/// Testes para ffi::cstring: roundtrip e null-termination

module ffi::test_cstring;

use ffi::cstring::{cstring_from_str, str_from_cstring};

fn test_roundtrip() with IO, Mut, Panic, Div {
    let orig = "hello world";
    let ptr = cstring_from_str(orig);
    let round = str_from_cstring(ptr);
    assert(round == orig);
    println("test_roundtrip: PASSED");
}

fn test_null_terminator() with Panic, Div {
    let orig = "test";
    let ptr = cstring_from_str(orig);
    unsafe {
        assert(ptr.read() == b't');
        assert(*(ptr.offset((orig.len() as isize))) == 0u8);
    }
    println("test_null_terminator: PASSED");
}

fn test_empty() with Panic, Div {
    let orig = "";
    let ptr = cstring_from_str(orig);
    let round = str_from_cstring(ptr);
    assert(round == orig);
    unsafe {
        assert(*(ptr.offset(0isize)) == 0u8);
    }
    println("test_empty: PASSED");
}

fn main() {
    println("Running ffi::cstring tests...");
    println("================================");
    test_roundtrip();
    test_null_terminator();
    test_empty();
    println("================================");
    println("All ffi::cstring tests PASSED!");
}