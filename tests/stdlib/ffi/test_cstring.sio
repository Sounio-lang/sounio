//@ run-pass
//@ expect-stdout: FFI_CSTRING_OK
use ffi::cstring::*;

fn main() -> i32 with IO, Mut, Div, Panic {
    var src: [u8; 256] = [0u8; 256]
    var dst: [u8; 257] = [0u8; 257]
    src[0] = 104 as u8
    src[1] = 105 as u8
    if cstring_write(src, 2, &!dst) != 3 { return 1 }
    if cstring_len(dst, 257) != 2 { return 1 }
    println("FFI_CSTRING_OK")
    0
}
