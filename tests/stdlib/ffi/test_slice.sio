//@ run-pass
//@ ignore BLOCKED: stdlib/ffi/callback.sio has parse error (Expected {, found `(`)
//@ description: slice_from_raw_parts FFI helper tests
/// Tests for slice_from_raw_parts FFI helpers
///
/// These tests verify the raw pointer to slice conversion intrinsics work
/// correctly across the FFI boundary.

module ffi::test_slice;

use ffi::{slice_from_raw_parts, slice_from_raw_parts_mut};

// =============================================================================
// Test: Basic immutable slice from raw parts
// =============================================================================

/// Test creating an immutable slice from a raw pointer
fn test_slice_from_raw_parts_basic() {
    // Create a stack-allocated array and get a raw pointer
    let data: [u8; 4] = [1, 2, 3, 4]
    let ptr: *const u8 = &data[0] as *const u8
    let len: usize = 4

    // Convert to slice using the intrinsic
    let slice = unsafe { slice_from_raw_parts(ptr, len) }

    // Verify the slice contents
    assert(slice.len() == 4)
    assert(slice[0] == 1)
    assert(slice[1] == 2)
    assert(slice[2] == 3)
    assert(slice[3] == 4)

    println("test_slice_from_raw_parts_basic: PASSED")
}

// =============================================================================
// Test: Mutable slice from raw parts
// =============================================================================

/// Test creating a mutable slice from a raw pointer and modifying it
fn test_slice_from_raw_parts_mut_basic() {
    // Create a mutable array
    var data: [u8; 4] = [10, 20, 30, 40]
    let ptr: *mut u8 = &data[0] as *mut u8
    let len: usize = 4

    // Convert to mutable slice
    let slice = unsafe { slice_from_raw_parts_mut(ptr, len) }

    // Modify through the slice
    slice[0] = 100
    slice[3] = 200

    // Verify modifications propagated to original array
    assert(data[0] == 100)
    assert(data[3] == 200)

    println("test_slice_from_raw_parts_mut_basic: PASSED")
}

// =============================================================================
// Test: Empty slice handling
// =============================================================================

/// Test creating empty slices (zero length)
fn test_empty_slice() {
    let data: [u8; 4] = [1, 2, 3, 4]
    let ptr: *const u8 = &data[0] as *const u8

    // Zero-length slice should work
    let empty = unsafe { slice_from_raw_parts(ptr, 0) }
    assert(empty.len() == 0)

    println("test_empty_slice: PASSED")
}

// =============================================================================
// Test: Slice with offset pointer
// =============================================================================

/// Test creating a slice from an offset into an array
fn test_slice_with_offset() {
    let data: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8]

    // Get pointer to element at index 2
    let ptr: *const u8 = &data[2] as *const u8
    let len: usize = 4

    // Create slice from offset
    let slice = unsafe { slice_from_raw_parts(ptr, len) }

    // Should see elements [3, 4, 5, 6]
    assert(slice.len() == 4)
    assert(slice[0] == 3)
    assert(slice[1] == 4)
    assert(slice[2] == 5)
    assert(slice[3] == 6)

    println("test_slice_with_offset: PASSED")
}

// =============================================================================
// Test: Slice of different element types
// =============================================================================

/// Test slice creation with larger element types
fn test_slice_f32() {
    var data: [f32; 3] = [1.0, 2.5, 3.75]
    let ptr: *const f32 = &data[0] as *const f32
    let len: usize = 3

    let slice = unsafe { slice_from_raw_parts(ptr, len) }

    assert(slice.len() == 3)
    assert(slice[0] == 1.0)
    assert(slice[1] == 2.5)
    assert(slice[2] == 3.75)

    println("test_slice_f32: PASSED")
}

/// Test mutable slice with i32 elements
fn test_slice_i32_mut() {
    var data: [i32; 4] = [100, 200, 300, 400]
    let ptr: *mut i32 = &data[0] as *mut i32
    let len: usize = 4

    let slice = unsafe { slice_from_raw_parts_mut(ptr, len) }

    // Sum using the slice
    var sum: i32 = 0
    var i: usize = 0
    while i < slice.len() {
        sum = sum + slice[i]
        i = i + 1
    }

    assert(sum == 1000)

    // Double each element
    i = 0
    while i < slice.len() {
        slice[i] = slice[i] * 2
        i = i + 1
    }

    assert(data[0] == 200)
    assert(data[1] == 400)
    assert(data[2] == 600)
    assert(data[3] == 800)

    println("test_slice_i32_mut: PASSED")
}

// =============================================================================
// Main test runner
// =============================================================================

fn main() {
    println("Running slice_from_raw_parts tests...")
    println("=====================================")

    test_slice_from_raw_parts_basic()
    test_slice_from_raw_parts_mut_basic()
    test_empty_slice()
    test_slice_with_offset()
    test_slice_f32()
    test_slice_i32_mut()

    println("=====================================")
    println("All tests PASSED!")
}
