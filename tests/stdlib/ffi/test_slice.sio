//@ run-pass
//@ expect-stdout: FFI_RAW_POINTER_OK
use ffi::*;

fn main() -> i32 with IO, Mut {
    var value: i64 = 0
    let ptr = (&!value) as *mut i64
    ffi_i64_write(ptr, 42)
    if value != 42 { return 1 }
    if ffi_i64_read(ptr) != 42 { return 1 }
    println("FFI_RAW_POINTER_OK")
    0
}
