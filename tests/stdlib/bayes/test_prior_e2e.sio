//@ run-pass
//! tests/stdlib/bayes/test_prior_e2e.sio
//!
//! E2E tests for bayes::prior — Bayesian prior distribution log-probabilities.

use bayes::prior::{
    Prior, PriorEval,
    prior_new, prior_eval_new, prior_log_prob,
    prior_normal, log_prob_normal,
    prior_lognormal, log_prob_lognormal,
    prior_uniform, log_prob_uniform,
    prior_beta, log_prob_beta,
    prior_gamma, log_prob_gamma,
    prior_half_normal, log_prob_half_normal,
    prior_exponential, log_prob_exponential,
    prior_cauchy, log_prob_cauchy,
    prior_half_cauchy, log_prob_half_cauchy,
    prior_weakly_informative_coef, prior_weakly_informative_scale,
}
use test::helpers::{check_near}

// ============================================================================
// Normal prior
// ============================================================================

fn test_normal_valid_at_mean() with Mut, Div, Panic {
    let eval = log_prob_normal(0.0, 0.0, 1.0)
    assert(eval.valid)
    // log N(0|0,1) = -0.5*log(2*pi) ≈ -0.9189
    assert(check_near(eval.log_prob, 0.0 - 0.9189, 0.01))
}

fn test_normal_invalid_sigma() with Mut, Div, Panic {
    let eval = log_prob_normal(0.0, 0.0, 0.0 - 1.0)
    assert(eval.valid == false)
}

fn test_normal_off_mean_lower_log_prob() with Mut, Div, Panic {
    // log prob at mean > log prob away from mean
    let at_mean = log_prob_normal(0.0, 0.0, 1.0)
    let away = log_prob_normal(2.0, 0.0, 1.0)
    assert(at_mean.log_prob > away.log_prob)
}

// ============================================================================
// Log-normal prior
// ============================================================================

fn test_lognormal_positive_valid() with Mut, Div, Panic {
    let eval = log_prob_lognormal(1.0, 0.0, 1.0)
    assert(eval.valid)
}

fn test_lognormal_negative_invalid() with Mut, Div, Panic {
    let eval = log_prob_lognormal(0.0 - 1.0, 0.0, 1.0)
    assert(eval.valid == false)
}

fn test_lognormal_zero_invalid() with Mut, Div, Panic {
    let eval = log_prob_lognormal(0.0, 0.0, 1.0)
    assert(eval.valid == false)
}

// ============================================================================
// Uniform prior
// ============================================================================

fn test_uniform_in_support() with Mut, Div, Panic {
    let eval = log_prob_uniform(0.5, 0.0, 1.0)
    assert(eval.valid)
    // log(1/(1-0)) = 0
    assert(check_near(eval.log_prob, 0.0, 1e-9))
}

fn test_uniform_out_of_support() with Mut, Div, Panic {
    let eval = log_prob_uniform(1.5, 0.0, 1.0)
    assert(eval.valid == false)
}

fn test_uniform_boundary() with Mut, Div, Panic {
    // At exact boundaries, value should be valid
    let lo = log_prob_uniform(0.0, 0.0, 1.0)
    assert(lo.valid)
}

// ============================================================================
// Beta prior
// ============================================================================

fn test_beta_in_unit_interval() with Mut, Div, Panic {
    let eval = log_prob_beta(0.5, 2.0, 2.0)
    assert(eval.valid)
    // log((0.5)^1 * (0.5)^1) = -ln(2) * 2 ≈ -1.386
    assert(eval.log_prob < 0.0)
}

fn test_beta_outside_unit_invalid() with Mut, Div, Panic {
    let eval_neg = log_prob_beta(0.0 - 0.1, 2.0, 2.0)
    assert(eval_neg.valid == false)
    let eval_pos = log_prob_beta(1.1, 2.0, 2.0)
    assert(eval_pos.valid == false)
}

fn test_beta_symmetric_at_half() with Mut, Div, Panic {
    // Beta(2,2) is symmetric; prob at 0.5 == prob at 0.5
    let e1 = log_prob_beta(0.5, 2.0, 2.0)
    let e2 = log_prob_beta(0.5, 2.0, 2.0)
    assert(check_near(e1.log_prob, e2.log_prob, 1e-9))
}

// ============================================================================
// Gamma prior
// ============================================================================

fn test_gamma_positive_valid() with Mut, Div, Panic {
    let eval = log_prob_gamma(1.0, 2.0, 1.0)
    assert(eval.valid)
}

fn test_gamma_negative_invalid() with Mut, Div, Panic {
    let eval = log_prob_gamma(0.0 - 1.0, 2.0, 1.0)
    assert(eval.valid == false)
}

// ============================================================================
// Half-normal prior
// ============================================================================

fn test_half_normal_positive_valid() with Mut, Div, Panic {
    let eval = log_prob_half_normal(1.0, 1.0)
    assert(eval.valid)
}

fn test_half_normal_negative_invalid() with Mut, Div, Panic {
    let eval = log_prob_half_normal(0.0 - 0.5, 1.0)
    assert(eval.valid == false)
}

// ============================================================================
// Exponential prior
// ============================================================================

fn test_exponential_positive_valid() with Mut, Div, Panic {
    let eval = log_prob_exponential(1.0, 1.0)
    assert(eval.valid)
    // log(Exp(1|rate=1)) = log(rate) - rate*x = log(1) - 1 = -1
    assert(check_near(eval.log_prob, 0.0 - 1.0, 0.01))
}

fn test_exponential_negative_invalid() with Mut, Div, Panic {
    let eval = log_prob_exponential(0.0 - 1.0, 1.0)
    assert(eval.valid == false)
}

// ============================================================================
// Cauchy prior
// ============================================================================

fn test_cauchy_at_location() with Mut, Div, Panic {
    let eval = log_prob_cauchy(0.0, 0.0, 1.0)
    assert(eval.valid)
}

fn test_cauchy_invalid_scale() with Mut, Div, Panic {
    let eval = log_prob_cauchy(0.0, 0.0, 0.0 - 1.0)
    assert(eval.valid == false)
}

// ============================================================================
// Half-Cauchy prior
// ============================================================================

fn test_half_cauchy_positive_valid() with Mut, Div, Panic {
    let eval = log_prob_half_cauchy(1.0, 2.5)
    assert(eval.valid)
}

fn test_half_cauchy_negative_invalid() with Mut, Div, Panic {
    let eval = log_prob_half_cauchy(0.0 - 1.0, 2.5)
    assert(eval.valid == false)
}

// ============================================================================
// Generic dispatch via prior_log_prob
// ============================================================================

fn test_dispatch_normal() with Mut, Div, Panic {
    let prior = prior_normal(0.0, 1.0)
    let eval = prior_log_prob(prior, 0.0)
    assert(eval.valid)
}

fn test_dispatch_uniform() with Mut, Div, Panic {
    let prior = prior_uniform(0.0, 1.0)
    let eval_in = prior_log_prob(prior, 0.5)
    let eval_out = prior_log_prob(prior, 1.5)
    assert(eval_in.valid)
    assert(eval_out.valid == false)
}

fn test_weakly_informative_coef() with Mut, Div, Panic {
    let prior = prior_weakly_informative_coef()
    // Normal(0, 2.5) — should be valid at 0
    let eval = prior_log_prob(prior, 0.0)
    assert(eval.valid)
}

fn test_weakly_informative_scale() with Mut, Div, Panic {
    let prior = prior_weakly_informative_scale()
    // HalfCauchy(2.5) — valid at 1.0, invalid at -1.0
    let eval_pos = prior_log_prob(prior, 1.0)
    let eval_neg = prior_log_prob(prior, 0.0 - 1.0)
    assert(eval_pos.valid)
    assert(eval_neg.valid == false)
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with Mut, Div, Panic {
    test_normal_valid_at_mean()
    test_normal_invalid_sigma()
    test_normal_off_mean_lower_log_prob()
    test_lognormal_positive_valid()
    test_lognormal_negative_invalid()
    test_lognormal_zero_invalid()
    test_uniform_in_support()
    test_uniform_out_of_support()
    test_uniform_boundary()
    test_beta_in_unit_interval()
    test_beta_outside_unit_invalid()
    test_beta_symmetric_at_half()
    test_gamma_positive_valid()
    test_gamma_negative_invalid()
    test_half_normal_positive_valid()
    test_half_normal_negative_invalid()
    test_exponential_positive_valid()
    test_exponential_negative_invalid()
    test_cauchy_at_location()
    test_cauchy_invalid_scale()
    test_half_cauchy_positive_valid()
    test_half_cauchy_negative_invalid()
    test_dispatch_normal()
    test_dispatch_uniform()
    test_weakly_informative_coef()
    test_weakly_informative_scale()
}
