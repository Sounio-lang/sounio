//@ run-pass
// Tests for stdlib/bayes/mcmc — Metropolis-Hastings MCMC sampler
//
// Validates:
// - Normal mean inference: data≈5.0 → posterior mean≈5.0, std≈0.4-0.6
// - Acceptance rate in (0.1, 0.9)
// - GUM bridge: result.as_gum.value == posterior mean
// - Linear slope inference: y≈2x → slope≈2.0

use bayes::mcmc::{MCMCConfig, MCMCResult, mcmc_config_default, mcmc_run, mcmc_run_linear}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn near_f64(a: f64, b: f64, tol: f64) -> bool {
    abs_f(a - b) < tol
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var pass: i32 = 0
    var fail: i32 = 0

    // =========================================================================
    // Test 1: Normal mean inference
    // Data: [5.1, 4.9, 5.2, 4.8, 5.0] — true mean = 5.0
    // model_id=0: Normal mean, known variance=1
    // =========================================================================

    var data: [f64; 256] = [0.0; 256]
    data[0] = 5.1
    data[1] = 4.9
    data[2] = 5.2
    data[3] = 4.8
    data[4] = 5.0

    let cfg = mcmc_config_default(0)

    // Verify config defaults
    if cfg.n_samples == 1000 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }
    if cfg.n_burnin == 200 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }
    if cfg.model_id == 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    let result = mcmc_run(cfg, &data, 5, 42)

    // Posterior mean should be close to 5.0
    if result.mean > 4.0 && result.mean < 6.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Posterior std_dev should be in reasonable range (0.1 - 2.0)
    if result.std_dev > 0.05 && result.std_dev < 2.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // n_samples should match what was requested (capped at 1024)
    if result.n_samples == 1000 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // =========================================================================
    // Test 2: Acceptance rate in reasonable range
    // With step_size=0.1 near a peaked posterior, high acceptance (~90%) is normal.
    // =========================================================================

    if result.acceptance_rate > 0.05 && result.acceptance_rate < 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // =========================================================================
    // Test 3: GUM bridge — as_gum.value should equal posterior mean
    // =========================================================================

    if near_f64(result.as_gum.value, result.mean, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // GUM std_uncertainty should equal posterior std_dev
    if near_f64(result.as_gum.std_u, result.std_dev, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // =========================================================================
    // Test 4: Smaller run with explicit step_size check
    // Use a smaller n_samples to verify count
    // =========================================================================

    var cfg2 = mcmc_config_default(0)
    cfg2.n_samples = 500
    cfg2.step_size = 0.5

    let result2 = mcmc_run(cfg2, &data, 5, 99)
    if result2.n_samples == 500 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // =========================================================================
    // Test 5: Linear slope inference
    // x=[1,2,3,4,5], y=[2.1, 3.9, 6.1, 7.8, 10.2] → slope ≈ 2.0
    // =========================================================================

    var x_data: [f64; 256] = [0.0; 256]
    var y_data: [f64; 256] = [0.0; 256]
    x_data[0] = 1.0
    x_data[1] = 2.0
    x_data[2] = 3.0
    x_data[3] = 4.0
    x_data[4] = 5.0
    y_data[0] = 2.1
    y_data[1] = 3.9
    y_data[2] = 6.1
    y_data[3] = 7.8
    y_data[4] = 10.2

    var lin_cfg = mcmc_config_default(2)
    lin_cfg.n_samples = 1000
    lin_cfg.n_burnin = 300
    lin_cfg.step_size = 0.1

    let lin_result = mcmc_run_linear(lin_cfg, &x_data, &y_data, 5, 7)

    // Posterior mean should be close to 2.0 (true slope)
    if lin_result.mean > 1.5 && lin_result.mean < 2.5 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Acceptance rate should be non-trivial (not 0 and not rejecting everything)
    if lin_result.acceptance_rate > 0.05 && lin_result.acceptance_rate < 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // GUM bridge for linear model
    if near_f64(lin_result.as_gum.value, lin_result.mean, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // n_samples collected should be 1000
    if lin_result.n_samples == 1000 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // =========================================================================
    // Test 6: LCG properties — different seeds give different results
    // =========================================================================

    let r_a = mcmc_run(cfg, &data, 5, 1)
    let r_b = mcmc_run(cfg, &data, 5, 999)
    // With different seeds, samples[0] should differ
    // (extremely unlikely to be identical unless the RNG is broken)
    if r_a.samples[0] != r_b.samples[0] {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Both should have valid means (not NaN proxy: mean == mean is always true for normal f64)
    if r_a.mean > 0.0 - 100.0 && r_a.mean < 100.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail == 0 { return 0 }
    return 1
}
