//@ run-pass
// E2E test for stdlib/bayes/mcmc (updated for new API)
// Tests: mcmc_config_default, mcmc_run, lcg_uniform, lcg_next, mcmc_run_linear

use bayes::mcmc::{MCMCConfig, MCMCResult, mcmc_config_default, mcmc_run, mcmc_run_linear, lcg_next, lcg_uniform}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32  with Mut{
    var pass = 0
    var fail = 0

    // Test 1: LCG produces values in [0, 1)
    let u_r = lcg_uniform(42)
    let u = u_r.value
    if u >= 0.0 && u < 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: mcmc_config_default returns correct n_samples
    let cfg = mcmc_config_default(0)
    if cfg.n_samples == 1000 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: config model_id is preserved
    let cfg2 = mcmc_config_default(1)
    if cfg2.model_id == 1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: MCMC sampling for normal mean model
    // Data near 5.0, prior is flat (model_id=0)
    var data: [f64; 256] = [0.0; 256]
    data[0] = 5.0
    data[1] = 4.9
    data[2] = 5.1
    data[3] = 5.2
    data[4] = 4.8

    let result = mcmc_run(cfg, &data, 5, 12345)

    // Chain should have samples
    if result.n_samples > 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: Acceptance rate should be non-zero and not exactly 1
    if result.acceptance_rate > 0.0 && result.acceptance_rate <= 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: Posterior mean from MCMC should be in plausible range
    if result.mean > 3.0 && result.mean < 7.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: GUM bridge value matches posterior mean
    if check_near(result.as_gum.value, result.mean, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
