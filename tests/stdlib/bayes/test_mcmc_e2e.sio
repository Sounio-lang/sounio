//@ run-pass
// E2E test for stdlib/bayes/mcmc
// Tests: mcmc_config_default, log_posterior_new, metropolis_hastings,
//        normal_normal_posterior, rng_new, rng_uniform

use bayes::mcmc::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: RNG produces values in [0, 1)
    let r = rng_new(42)
    let r1 = rng_uniform(r)
    if r1.last >= 0.0 && r1.last < 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: Analytical posterior for normal-normal
    // Prior: N(0, 100), Data: mean=5.0, var=1.0, n=10
    let post = normal_normal_posterior(0.0, 100.0, 5.0, 1.0, 10)
    // Posterior mean should be between prior mean (0) and data mean (5)
    if post.mean > 0.0 && post.mean < 5.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: Posterior variance should be less than both prior and data variance
    if post.variance < 100.0 && post.variance < 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: MCMC sampling for normal-normal model
    let lp = log_posterior_new(5.0, 1.0, 10, 0.0, 100.0)
    var config = mcmc_config_default()
    config.n_samples = 100
    config.n_warmup = 200
    config.seed = 12345

    let chain = metropolis_hastings(lp, config)

    // Chain should have samples
    if chain.n_samples > 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: Acceptance rate should be reasonable (between 0.1 and 0.9)
    if chain.acceptance_rate > 0.05 && chain.acceptance_rate < 0.99 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: Posterior mean from MCMC should be in plausible range
    // Analytical mean is about 4.5 (weighted toward data with large prior var)
    if chain.mean > 1.0 && chain.mean < 8.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
