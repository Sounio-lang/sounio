//@ run-pass
// E2E test for stdlib/ode/rk4
// Tests: solve_rk4_scalar (exponential decay), rk4_step_scalar, exp_decay_analytical

use ode::rk4::*
use test::helpers::check_near

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: Solve du/dt = -0.1*u from t=0 to t=1, u0=1.0
    // Analytical: u(1) = exp(-0.1) approx 0.9048
    let sol = solve_rk4_scalar(1.0, 0.0, 1.0, 100)
    let analytical = exp_decay_analytical(1.0, 0.1, 1.0)
    if check_near(sol.u_final, analytical, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: t_final should be 1.0
    if check_near(sol.t_final, 1.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: nsteps should be 100
    if sol.nsteps == 100 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: nfeval = 4 * nsteps = 400
    if sol.nfeval == 400 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: Solve to t=10, u should be smaller
    let sol10 = solve_rk4_scalar(1.0, 0.0, 10.0, 1000)
    let analytical10 = exp_decay_analytical(1.0, 0.1, 10.0)
    if check_near(sol10.u_final, analytical10, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: PK3 model solve - gut should decrease
    let pk_params = default_pk3_params()
    let pk_init = PKState3 { gut: 100.0, central: 0.0, periph: 0.0, t: 0.0 }
    let pk_sol = solve_rk4_pk3(pk_init, pk_params, 1.0, 100)
    if pk_sol.gut < 100.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: PK3 model - central should increase from 0 initially
    if pk_sol.central > 0.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
