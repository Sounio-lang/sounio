//@ run-pass
// E2E test for active ODE solver APIs (RK4/RK45).
// E2E test for active ODE solver APIs.

use ode::solver::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    let sol = solve_rk4_exp_decay(1.0, 0.0, 1.0, 100)
    let analytical = exp_decay_analytical(1.0, 0.1, 1.0)
    if check_near(sol.u_final, analytical, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if check_near(sol.t_final, 1.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if sol.nsteps == 100 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if sol.nfeval == 400 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    let sol10 = solve_rk4_exp_decay(1.0, 0.0, 10.0, 1000)
    let analytical10 = exp_decay_analytical(1.0, 0.1, 10.0)
    if check_near(sol10.u_final, analytical10, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    let pk_params = solver_default_pk3_params()
    let pk_init = State3 { u1: 100.0, u2: 0.0, u3: 0.0, t: 0.0 }
    let pk_sol = solve_pk3_rk4(pk_init, pk_params, 1.0, 100)
    if pk_sol.u1_final < 100.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if pk_sol.u2_final > 0.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    return run_tests()
}
