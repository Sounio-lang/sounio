//@ run-pass
// Generic RK4 fn-ref smoke test.

use ode::rk4::{rk4_integrate, rk4_step}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    return abs_f64(a - b) < tol
}

fn decay_rhs(t: f64, y: &[f64; 64], dydt: &![f64; 64]) with Mut, Div, Panic {
    dydt[0] = 0.0 - y[0]
}

pub fn main() -> i64 with Mut, Div, Panic {
    var y_step: [f64; 64] = [0.0; 64]
    y_step[0] = 1.0
    rk4_step(decay_rhs, 0.0, &!y_step, 0.01, 1)

    var y: [f64; 64] = [0.0; 64]
    y[0] = 1.0
    let t_final = rk4_integrate(decay_rhs, &!y, 1, 0.0, 1.0, 0.01)

    let expected = 0.367879
    let ok_step = y_step[0] < 1.0 && y_step[0] > 0.98
    let ok_final = check_near(y[0], expected, 0.001)
    let ok_time = check_near(t_final, 1.0, 0.000000001)

    if ok_step && ok_final && ok_time {
        println("PASS")
        return 0
    }

    println("FAIL")
    return 1
}
