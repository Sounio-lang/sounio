//@ run-pass
//@ expect-stdout: DP54_INVALID_PASS
use ode::checked_dp54::*
use ode::solver::{default_options}
var RHS_CALLS:i64=0
var EVENT_CALLS:i64=0
fn rhs(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {RHS_CALLS=RHS_CALLS+1;var i:i64=0;while i<64 {dy[i]=1.0;i=i+1}}
fn event(t:f64,y:&[f64;64])->f64 with Mut,Div,Panic {EVENT_CALLS=EVENT_CALLS+1;t-0.5}
fn main()->i32 with IO,Mut,Div,Panic {
 var y:[f64;64]=[1.0;64];var initial=default_options();initial.dt_init=1.0;initial.dt_max=1.0
 var dense=dp54_dense_init();var receipt=dp54_event_init()
 let first=solve_dp54_event64(rhs,event,&y,1,0.0,1.0,initial,dp54_default_limits(),dp54_default_event_options(),&!dense,&!receipt)
 assert(first.status==5&&dp54_event_info(&receipt).found)
 var kind:i64=0
 while kind<12 {
  RHS_CALLS=0;EVENT_CALLS=0
  var opts=default_options();var limits=dp54_default_limits();var events=dp54_default_event_options();var start:f64=0.0
  y[0]=1.0
  if kind==0 {limits.max_rhs= -1}
  if kind==1 {limits.max_rhs=7000001}
  if kind==2 {limits.max_event= -1}
  if kind==3 {limits.max_event=10000001}
  if kind==4 {limits.max_root_iterations= -1}
  if kind==5 {limits.max_root_iterations=1000001}
  if kind==6 {events.direction=2}
  if kind==7 {events.root_atol=0.0}
  if kind==8 {events.root_atol=0.0/0.0}
  if kind==9 {y[0]=0.0/0.0}
  if kind==10 {start=1.0/0.0}
  if kind==11 {opts.max_steps=0}
  let r=solve_dp54_event64(rhs,event,&y,1,start,1.0,opts,limits,events,&!dense,&!receipt)
  let info=dp54_event_info(&receipt);let domain=dp54_dense_domain(&dense)
  print("DP54_INVALID ");print_int(kind);print(" ");print_int(r.status);print(" ");print_int(r.nfeval);print(" ");print_int(RHS_CALLS);print(" ");print_int(info.status);print(" ");print_int(info.count);print(" ");print_int(info.n_event_eval);print(" ");print_int(EVENT_CALLS);print(" ");print_int(if info.found {1}else{0});print(" ");print_int(if info.bracket_ready {1}else{0});println("")
  assert(r.status==3&&r.nfeval==0&&RHS_CALLS==0&&EVENT_CALLS==0&&r.state[0]==0.0)
  assert(info.status==3&&info.count==0&&!info.found&&!info.bracket_ready&&info.n_event_eval==0)
  assert(domain.status==3)
  if kind==9 {assert(y[0]!=y[0])}else{assert(y[0]==1.0)}
  kind=kind+1
 }
 dp54_dense_close(dense);dp54_event_close(receipt);println("DP54_INVALID_PASS");0
}
