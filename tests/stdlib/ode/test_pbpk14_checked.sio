//@ run-pass
//@ expect-stdout: PBPK14_CHECKED_OK
use ode::pbpk14_rk4::{PBPK14State,PBPK14Params,PBPK14Solution,solve_pbpk14_rk4}
fn emit(name:string,s:&PBPK14Solution) with IO {
print("PBPK14 ");print(name);print(" ");print_int(s.status);print(" ");print_int(s.nsteps);print(" ");print_int(s.internal_steps);print(" ");print_int(s.nfeval);print(" ");print_int(f64_to_bits(s.t_final));print(" ");print_int(f64_to_bits(s.gut));print(" ");print_int(f64_to_bits(s.art));print(" ");print_int(f64_to_bits(s.ven));print(" ");print_int(f64_to_bits(s.lung));print(" ");print_int(f64_to_bits(s.heart));print(" ");print_int(f64_to_bits(s.brain));print(" ");print_int(f64_to_bits(s.muscle));print(" ");print_int(f64_to_bits(s.adipose));print(" ");print_int(f64_to_bits(s.skin));print(" ");print_int(f64_to_bits(s.bone));print(" ");print_int(f64_to_bits(s.spleen));print(" ");print_int(f64_to_bits(s.gut_tis));print(" ");print_int(f64_to_bits(s.liver));print(" ");print_int(f64_to_bits(s.kidney));print("\n")
}
fn main()->i32 with IO,Mut,Div,Panic {
{
let state=PBPK14State {gut:100.00000000000000,art:0.0000000000000000,ven:0.0000000000000000,lung:0.0000000000000000,heart:0.0000000000000000,brain:0.0000000000000000,muscle:0.0000000000000000,adipose:0.0000000000000000,skin:0.0000000000000000,bone:0.0000000000000000,spleen:0.0000000000000000,gut_tis:0.0000000000000000,liver:0.0000000000000000,kidney:0.0000000000000000}
let params=PBPK14Params {ka:1.0000000000000000,rb:1.0000000000000000,fu:0.29999999999999999,cl_int:50.000000000000000,gfr:7.5000000000000000}
let sol=solve_pbpk14_rk4(state,params,24.000000000000000,100)
assert(sol.status==0)
emit("oral24",&sol)
}
{
let state=PBPK14State {gut:100.00000000000000,art:0.0000000000000000,ven:0.0000000000000000,lung:0.0000000000000000,heart:0.0000000000000000,brain:0.0000000000000000,muscle:0.0000000000000000,adipose:0.0000000000000000,skin:0.0000000000000000,bone:0.0000000000000000,spleen:0.0000000000000000,gut_tis:0.0000000000000000,liver:0.0000000000000000,kidney:0.0000000000000000}
