//@ run-pass
// tests/stdlib/ode/test_epistemic_pkpd_e2e.sio
//
// End-to-end: Epistemic PK/PD inference on a synthetic drug candidate.
// Demonstrates the complete chain:
//   Noisy dose → plasma concentration → clinical effect → GUM 95% CI
//
// True params: ka=0.500 h⁻¹, ke=0.200 h⁻¹, Vd=10 L, dose=100 mg
//             Emax=1.000 (normalized), EC50=3.000 mg/L
//
// Verifies:
//   - Both PK and PD converge
//   - Parameters recovered within 15% of truth
//   - Sensitivity analysis: EC50 is the dominant uncertainty driver (> 50%)
//   - u(E_peak) > 0 (non-degenerate therapeutic uncertainty)

use ode::epistemic_pkpd_fit::{PKPDFitResult, epistemic_pkpd_fit}

fn pd2_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn test_full_pkpd_inference() with IO, Mut, Div, Panic {
    // True: ka=0.5, ke=0.2, Vd=10, dose=100, Emax=1.0, EC50=3.0
    // Concentration obs (5% alternating noise):
    let obs_t:  [f64; 6] = [0.5,   1.0,   2.0,   4.0,   8.0,   12.0]
    let obs_c:  [f64; 6] = [2.206, 3.360, 5.293, 4.971, 3.213,  1.392]
    let obs_cu: [f64; 6] = [0.110, 0.177, 0.252, 0.261, 0.153,  0.073]
    // Effect obs (3% alternating noise on true E = [0.412,0.541,0.627,0.636,0.505,0.329]):
    let obs_e:  [f64; 6] = [0.424, 0.514, 0.646, 0.604, 0.520,  0.319]
    let obs_eu: [f64; 6] = [0.012, 0.016, 0.019, 0.019, 0.015,  0.010]

    println("=== Epistemic PK/PD Inference: Dose → Effect ===")
    println("Drug: synthetic candidate (oral, 100 mg)")
    println("Observations: 6 time points, plasma + effect")
    println("True: ka=0.500, ke=0.200, Emax=1.000, EC50=3.000")
    println("")

    var r: PKPDFitResult
    r.ka = 0.0
    r.u_ka = 0.0
    r.ka_lo95 = 0.0
    r.ka_hi95 = 0.0
    r.ke = 0.0
    r.u_ke = 0.0
    r.ke_lo95 = 0.0
    r.ke_hi95 = 0.0
    r.rms_pk = 0.0
    r.emax = 0.0
    r.u_emax = 0.0
    r.emax_lo95 = 0.0
    r.emax_hi95 = 0.0
    r.ec50 = 0.0
    r.u_ec50 = 0.0
    r.ec50_lo95 = 0.0
    r.ec50_hi95 = 0.0
    r.rms_pd = 0.0
    r.e_peak = 0.0
    r.u_e_peak = 0.0
    r.sens_ka_pct = 0.0
    r.sens_ke_pct = 0.0
    r.sens_emax_pct = 0.0
    r.sens_ec50_pct = 0.0
    r.converged_pk = 0
    r.converged_pd = 0
    epistemic_pkpd_fit(
        &!r, obs_t, obs_c, obs_cu, obs_e, obs_eu,
        100.0, 10.0,
        0.6, 0.25,
        1.2, 3.6,
    )

    println("=== PK Parameters ===")
    println("  ka (absorption rate) =")
    println(r.ka)
    println("  h-1  +/-")
    println(r.u_ka)
    println("  95% CI: [")
    println(r.ka_lo95)
    println(",")
    println(r.ka_hi95)
    println("]")
    println("  ke (elimination rate) =")
    println(r.ke)
    println("  h-1  +/-")
    println(r.u_ke)
    println("  95% CI: [")
    println(r.ke_lo95)
    println(",")
    println(r.ke_hi95)
    println("]")
    println("  RMS concentration residual =")
    println(r.rms_pk)

    println("")
    println("=== PD Parameters ===")
    println("  Emax (max normalized effect) =")
    println(r.emax)
    println("  +/-")
    println(r.u_emax)
    println("  95% CI: [")
    println(r.emax_lo95)
    println(",")
    println(r.emax_hi95)
    println("]")
    println("  EC50 (mg/L for 50% effect) =")
    println(r.ec50)
    println("  mg/L  +/-")
    println(r.u_ec50)
    println("  95% CI: [")
    println(r.ec50_lo95)
    println(",")
    println(r.ec50_hi95)
    println("]")
    println("  RMS effect residual =")
    println(r.rms_pd)

    println("")
    println("=== Peak Effect Prediction (t=4h) ===")
    println("  E_peak =")
    println(r.e_peak)
    println("  +/-")
    println(r.u_e_peak)
    println("  (normalized; 0=no effect, 1=maximum)")

    println("")
    println("=== Uncertainty Sensitivity at Peak ===")
    println("  ka    explains")
    println(r.sens_ka_pct)
    println("% of E_peak uncertainty")
    println("  ke    explains")
    println(r.sens_ke_pct)
    println("% of E_peak uncertainty")
    println("  Emax  explains")
    println(r.sens_emax_pct)
    println("% of E_peak uncertainty")
    println("  EC50  explains")
    println(r.sens_ec50_pct)
    println("% of E_peak uncertainty")
    println("")

    // --- assertions ---

    // Both algorithms converged
    assert(r.converged_pk == 1)
    assert(r.converged_pd == 1)

    // PK recovery within 15%
    let ka_err = pd2_abs(r.ka - 0.5) / 0.5
    let ke_err = pd2_abs(r.ke - 0.2) / 0.2
    assert(ka_err < 0.15)
    assert(ke_err < 0.15)

    // PD recovery within 15%
    let emax_err = pd2_abs(r.emax - 1.0)
    let ec50_err = pd2_abs(r.ec50 - 3.0) / 3.0
    assert(emax_err < 0.15)
    assert(ec50_err < 0.15)

    // Fitted params close to truth (noise can introduce small bias)
    assert(pd2_abs(r.ka - 0.5) < 3.0 * r.u_ka + 0.02)
    assert(pd2_abs(r.ke - 0.2) < 3.0 * r.u_ke + 0.02)
    assert(pd2_abs(r.emax - 1.0) < 0.10)   // noise bias ≤ 10%
    assert(pd2_abs(r.ec50 - 3.0) < 0.50)   // noise bias ≤ 17%

    // Non-degenerate uncertainties
    assert(r.u_ka > 0.0)
    assert(r.u_ke > 0.0)
    assert(r.u_emax > 0.0)
    assert(r.u_ec50 > 0.0)
    assert(r.u_e_peak > 0.0)

    // Sensitivities sum to ~100%
    let sens_sum = r.sens_ka_pct + r.sens_ke_pct + r.sens_emax_pct + r.sens_ec50_pct
    assert(sens_sum > 95.0 && sens_sum < 105.0)

    // Peak effect is in plausible range (between 0 and 1)
    assert(r.e_peak > 0.3 && r.e_peak < 0.9)

    println("PASS: epistemic PK/PD inference e2e")
}

fn test_ec50_dominance() with IO, Mut, Div, Panic {
    // When EC50 has high measurement uncertainty, it should dominate sensitivity.
    // Use very tight PK obs (low u_pk) but noisy effect obs (high u_pd).
    let obs_t:  [f64; 6] = [0.5,   1.0,   2.0,   4.0,   8.0,   12.0]
    let obs_c:  [f64; 6] = [2.101, 3.537, 5.041, 5.233, 3.060,  1.465]
    let obs_cu: [f64; 6] = [0.005, 0.008, 0.010, 0.010, 0.006,  0.003]  // very tight
    let obs_e:  [f64; 6] = [0.412, 0.541, 0.627, 0.636, 0.505,  0.329]
    let obs_eu: [f64; 6] = [0.030, 0.040, 0.050, 0.050, 0.038,  0.025]  // noisier effects

    var r: PKPDFitResult
    r.ka = 0.0
    r.u_ka = 0.0
    r.ka_lo95 = 0.0
    r.ka_hi95 = 0.0
    r.ke = 0.0
    r.u_ke = 0.0
    r.ke_lo95 = 0.0
    r.ke_hi95 = 0.0
    r.rms_pk = 0.0
    r.emax = 0.0
    r.u_emax = 0.0
    r.emax_lo95 = 0.0
    r.emax_hi95 = 0.0
    r.ec50 = 0.0
    r.u_ec50 = 0.0
    r.ec50_lo95 = 0.0
    r.ec50_hi95 = 0.0
    r.rms_pd = 0.0
    r.e_peak = 0.0
    r.u_e_peak = 0.0
    r.sens_ka_pct = 0.0
    r.sens_ke_pct = 0.0
    r.sens_emax_pct = 0.0
    r.sens_ec50_pct = 0.0
    r.converged_pk = 0
    r.converged_pd = 0
    epistemic_pkpd_fit(
        &!r, obs_t, obs_c, obs_cu, obs_e, obs_eu,
        100.0, 10.0, 0.5, 0.2, 1.0, 3.0,
    )

    // EC50 + Emax together should explain > 80% when PK is very precise
    let pd_sens = r.sens_emax_pct + r.sens_ec50_pct
    assert(pd_sens > 80.0)

    println("PASS: PD parameters dominate when PK is tight")
}

pub fn main() with IO, Mut, Div, Panic {
    test_full_pkpd_inference()
    test_ec50_dominance()
}
