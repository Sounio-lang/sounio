//@ run-pass
// E2E test for stdlib/ode/tsit5
// Tests: solve_exp_decay, default_config, exp_decay_analytical

use ode::tsit5::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: Solve exp decay du/dt = -0.1*u, u(0)=1, t=0 to 10
    // Analytical: u(10) = exp(-1) approx 0.3679
    let config = default_config()
    let sol = solve_exp_decay(1.0, 0.0, 10.0, config)

    let analytical = exp_decay_analytical(1.0, 0.1, 10.0)
    if check_near(sol.u_final, analytical, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: Solution should report success
    if sol.success {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: t_final should reach 10.0
    if check_near(sol.t_final, 10.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: adaptive solver should use fewer steps than fixed 10000
    if sol.nsteps < 10000 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: High accuracy config should also converge
    let hi_config = high_accuracy_config()
    let sol_hi = solve_exp_decay(1.0, 0.0, 10.0, hi_config)
    if sol_hi.success {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: High accuracy result should be closer to analytical
    let err_default = sol.u_final - analytical
    let abs_err_default = if err_default < 0.0 { 0.0 - err_default } else { err_default }
    let err_hi = sol_hi.u_final - analytical
    let abs_err_hi = if err_hi < 0.0 { 0.0 - err_hi } else { err_hi }
    if abs_err_hi <= abs_err_default + 0.001 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
