//@ run-pass
//@ contract-adjustment: ode::tsit5 module is disabled; test now validates active adaptive RK45 path in ode::solver
// E2E test for active adaptive ODE solver path.

use ode::solver::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div {
    var pass = 0
    var fail = 0

    let config = default_options()
    let sol = solve_rk45_exp_decay(1.0, 0.0, 10.0, config)

    let analytical = exp_decay_analytical(1.0, 0.1, 10.0)
    if check_near(sol.u_final, analytical, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if sol.success {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if check_near(sol.t_final, 10.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if sol.nsteps < 10000 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    let hi_config = high_accuracy_options()
    let sol_hi = solve_rk45_exp_decay(1.0, 0.0, 10.0, hi_config)
    if sol_hi.success {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    let err_default = sol.u_final - analytical
    let abs_err_default = if err_default < 0.0 { 0.0 - err_default } else { err_default }
    let err_hi = sol_hi.u_final - analytical
    let abs_err_hi = if err_hi < 0.0 { 0.0 - err_hi } else { err_hi }
    if abs_err_hi <= abs_err_default + 0.001 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div {
    return run_tests()
}
