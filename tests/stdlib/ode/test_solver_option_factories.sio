//@ run-pass
//@ expect-stdout: ODE_OPTION_FACTORIES_OK
use ode::solver::{SolverODESolution,default_options,fast_options,high_accuracy_options,solve_rk45_exp_decay,exp_decay_analytical}
fn emit(name:string,s:&SolverODESolution) with IO {
print("SOLVER ");print(name);print(" ");print_int(s.status);print(" ");print_int(s.nsteps);print(" ");print_int(s.nreject);print(" ");print_int(f64_to_bits(s.u_final));print(" ");print_int(f64_to_bits(s.t_final));print("\n")
}
fn main()->i32 with IO,Mut,Div,Panic {
{
let opts=default_options()
let sol=solve_rk45_exp_decay(1.0,0.0,10.0,opts)
assert(sol.success)
assert(sol.status==0)
emit("default",&sol)
}
{
let opts=fast_options()
let sol=solve_rk45_exp_decay(1.0,0.0,10.0,opts)
assert(sol.success)
assert(sol.status==0)
emit("fast",&sol)
}
{
let opts=high_accuracy_options()
let sol=solve_rk45_exp_decay(1.0,0.0,10.0,opts)
assert(sol.success)
assert(sol.status==0)
emit("high",&sol)
}
{
var bad=default_options()
bad.max_steps=1000001
let refused=solve_rk45_exp_decay(1.0,0.0,10.0,bad)
assert(refused.status==3)
assert(refused.nsteps==0)
assert(refused.nfeval==0)
}
println("ODE_OPTION_FACTORIES_OK")
0
}
