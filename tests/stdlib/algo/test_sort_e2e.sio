//@ run-pass
// E2E test for stdlib/algo/sort
//
// Tests quicksort_i64, heapsort_i64, quicksort_f64, and is_sorted_i64/f64
// on small arrays with known expected results.

use algo::sort::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Panic, Div, Alloc {
    var pass = 0
    var fail = 0

    // Test 1: quicksort_i64 sorts a small array
    print("Test 1: quicksort_i64... ")
    var arr1: [i64; 1024] = [0; 1024]
    arr1[0] = 5; arr1[1] = 3; arr1[2] = 8; arr1[3] = 1; arr1[4] = 9
    arr1[5] = 2; arr1[6] = 7; arr1[7] = 4; arr1[8] = 6
    quicksort_i64(&!arr1, 9)
    if is_sorted_i64(&arr1, 9) && arr1[0] == 1 && arr1[8] == 9 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: heapsort_i64 sorts a reverse-sorted array
    print("Test 2: heapsort_i64 reverse... ")
    var arr2: [i64; 1024] = [0; 1024]
    arr2[0] = 5; arr2[1] = 4; arr2[2] = 3; arr2[3] = 2; arr2[4] = 1
    heapsort_i64(&!arr2, 5)
    if is_sorted_i64(&arr2, 5) && arr2[0] == 1 && arr2[4] == 5 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: quicksort_f64 sorts floating point values
    print("Test 3: quicksort_f64... ")
    var arr3: [f64; 1024] = [0.0; 1024]
    arr3[0] = 3.14; arr3[1] = 1.41; arr3[2] = 2.72; arr3[3] = 0.57; arr3[4] = 1.73
    quicksort_f64(&!arr3, 5)
    if is_sorted_f64(&arr3, 5) && check_near(arr3[0], 0.57, 0.01) && check_near(arr3[4], 3.14, 0.01) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: is_sorted_i64 detects unsorted array
    print("Test 4: is_sorted_i64 false... ")
    var arr4: [i64; 1024] = [0; 1024]
    arr4[0] = 3; arr4[1] = 1; arr4[2] = 2
    if !is_sorted_i64(&arr4, 3) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: mergesort_i64 stable sort with duplicates
    print("Test 5: mergesort_i64 duplicates... ")
    var arr5: [i64; 1024] = [0; 1024]
    arr5[0] = 3; arr5[1] = 1; arr5[2] = 4; arr5[3] = 1; arr5[4] = 5
    arr5[5] = 9; arr5[6] = 2; arr5[7] = 6; arr5[8] = 5
    mergesort_i64(&!arr5, 9)
    if is_sorted_i64(&arr5, 9) && arr5[0] == 1 && arr5[1] == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Panic, Div, Alloc {
    return run_tests()
}
