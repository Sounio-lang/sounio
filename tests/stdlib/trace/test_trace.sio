//@ run-pass
// E2E tests for stdlib/trace/trace.sio
//
// Tests: tracer_new, tracer_begin, tracer_end, tracer_span_duration
//        TraceSpan fields, Tracer capacity, nested spans, span-not-found,
//        root vs child spans.

use trace::trace::*

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // ----------------------------------------------- tracer_new
    print("Test 01: tracer_new count is 0... ")
    let t0 = tracer_new()
    if t0.count == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- tracer_begin root span
    print("Test 02: tracer_begin returns id=1 for first span... ")
    let r1 = tracer_begin(t0, 0, 10, 1000)
    let t1 = r1.0
    let id1 = r1.1
    if id1 == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- count increments
    print("Test 03: tracer count is 1 after one begin... ")
    if t1.count == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- tracer_begin second span
    print("Test 04: tracer_begin returns id=2 for second span... ")
    let r2 = tracer_begin(t1, id1, 20, 2000)
    let t2 = r2.0
    let id2 = r2.1
    if id2 == 2 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- nested span count
    print("Test 05: tracer count is 2 after two begins... ")
    if t2.count == 2 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- tracer_end and duration
    print("Test 06: tracer_end + duration for inner span... ")
    let t3 = tracer_end(t2, id2, 3000)
    let dur2 = tracer_span_duration(&t3, id2)
    if dur2 == 1000 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- outer span still open (duration=0)
    print("Test 07: outer span duration is 0 while open... ")
    let dur1_open = tracer_span_duration(&t3, id1)
    if dur1_open == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- tracer_end outer span
    print("Test 08: tracer_end outer span, duration = 3000... ")
    let t4 = tracer_end(t3, id1, 4000)
    let dur1 = tracer_span_duration(&t4, id1)
    if dur1 == 3000 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- span-not-found returns 0
    print("Test 09: duration of unknown span id returns 0... ")
    let dur_none = tracer_span_duration(&t4, 999)
    if dur_none == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- tag stored correctly
    print("Test 10: span tag is stored as given... ")
    if t4.spans[0].tag == 10 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- parent_id stored
    print("Test 11: child span parent_id equals root span id... ")
    if t4.spans[1].parent_id == id1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ----------------------------------------------- tracer full returns -1
    print("Test 12: tracer full (128 spans) returns id=-1... ")
    // Fill tracer to capacity quickly by repeated begins
    var tfull = tracer_new()
    var i: i32 = 0
    while i < 128 {
        let rf = tracer_begin(tfull, 0, 0, i as i64)
        tfull = rf.0
        i = i + 1
    }
    let rover = tracer_begin(tfull, 0, 0, 9999)
    let id_over = rover.1
    if id_over == 0 - 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("All tests passed!\n")
        0
    } else {
        print("Some tests FAILED\n")
        1
    }
}

fn main() -> i32 {
    run_tests()
}
