//@ run-pass
//@ ignore
// tests/stdlib/hardware/test_hardware.sio
// Test suite for stdlib/hardware/ — K-AXI flag packing + PTX launch contract
//
// Covers (inline copies of kaxi.sio adapters + launch.sio):
//   T01 — kaxi_flags_pack round-trip (op, success, failure, alpha_q8)
//   T02 — kaxi_flags_unpack_op_kind
//   T03 — kaxi_flags_unpack_success_inc
//   T04 — kaxi_flags_unpack_failure_inc
//   T05 — kaxi_flags_unpack_alpha_q8
//   T06 — kaxi_flags_is_valid: valid and invalid values
//   T07 — kaxi_replay_is_epistemic: op 0 is not, op 1-5 are
//   T08 — kaxi_hw_counter_step increments for epistemic ops
//   T09 — kaxi_hw_epistemic_power_log_q32_32 arithmetic
//   T10 — kaxi_hw_poll_replay_flags: batch processing
//   T11 — launch_is_supported_op
//   T12 — launch_pack_flags: FMA op sets success=1, failure=0, alpha=16
//   T13 — launch_ptx_default_l4_config fields
//   T14 — launch_ptx_config_is_valid and launch_ptx_target_is_l4
//   T15 — launch_ptx_sanitize_op_kind clamps unsupported to PASS
//   T16 — launch_ptx_kernel produces correct PtxLaunchReport for FMA
//   T17 — launch_ptx_kernel: PASS op sets used_fallback
//   T18 — launch_ptx_software_epistemic_power_log_q32_32 > 0 for epistemic
//   T19 — launch_ptx_hybrid_epistemic_power_log_q32_32 is average
//   T20 — launch_clamp_q8 boundary values

// ============================================================================
// KAXI constants
// ============================================================================

let KAXI_OP_PASS: i64 = 0
let KAXI_OP_ADD: i64 = 1
let KAXI_OP_MUL: i64 = 2
let KAXI_OP_DIV: i64 = 3
let KAXI_OP_FMA: i64 = 4
let KAXI_OP_PROP_VAR: i64 = 5

let PTX_TARGET_L4 = "nvidia_l4"
let PTX_TARGET_L4_ALIAS = "l4"
let PTX_KERNEL_EPISTEMIC_GEMM = "epistemic_gemm_l4"
let KAXI_RING_BUFFER_SIZE: i64 = 64

// ============================================================================
// Inline: kaxi adapter helpers (from kaxi.sio @@TEMPLATE block)
// ============================================================================

fn kaxi_flags_pack(op_kind: i64, success_inc: i64, failure_inc: i64, alpha_q8: i64) -> i64 {
    let op = op_kind & 0xF
    let failure = (failure_inc & 0xFF) << 8
    let success = (success_inc & 0xFF) << 16
    let alpha = (alpha_q8 & 0xFF) << 24
    op | failure | success | alpha
}

fn kaxi_flags_unpack_op_kind(flags: i64) -> i64 { flags & 0xF }
fn kaxi_flags_unpack_success_inc(flags: i64) -> i64 { (flags >> 16) & 0xFF }
fn kaxi_flags_unpack_failure_inc(flags: i64) -> i64 { (flags >> 8) & 0xFF }
fn kaxi_flags_unpack_alpha_q8(flags: i64) -> i64 { (flags >> 24) & 0xFF }

fn kaxi_flags_is_valid(flags: i64) -> bool {
    let op = kaxi_flags_unpack_op_kind(flags)
    let success = kaxi_flags_unpack_success_inc(flags)
    let failure = kaxi_flags_unpack_failure_inc(flags)
    let alpha = kaxi_flags_unpack_alpha_q8(flags)
    op >= 0 && op <= 5 &&
    success >= 0 && success <= 255 &&
    failure >= 0 && failure <= 255 &&
    alpha >= 0 && alpha <= 255
}

fn kaxi_replay_is_epistemic(flags: i64) -> bool {
    let op = kaxi_flags_unpack_op_kind(flags)
    op >= 1 && op <= 5
}

fn kaxi_hw_counter_step(
    fidelity_total: i64, prov_total: i64, formal_total: i64, flags: i64
) -> (i64, i64, i64) {
    let is_epi = if kaxi_replay_is_epistemic(flags) { 1 as i64 } else { 0 as i64 }
    (fidelity_total + is_epi, prov_total + is_epi, formal_total + is_epi)
}

fn kaxi_hw_epistemic_power_log_q32_32(
    fidelity_total: i64, prov_total: i64, quantum_total: i64
) -> i64 {
    (fidelity_total >> 3) + (prov_total >> 4) + (quantum_total >> 5)
}

fn kaxi_hw_poll_replay_flags(
    flags_batch: [i64; 64], count: i64, quantum_total: i64
) -> (i64, i64, i64, i64) with Mut, Panic, Div, Alloc {
    var fidelity_total: i64 = 0
    var prov_total: i64 = 0
    var formal_total: i64 = 0
    var i: i64 = 0
    while i < count && i < 64 {
        let flags = flags_batch[i as usize]
        let (next_fidelity, next_prov, next_formal) =
            kaxi_hw_counter_step(fidelity_total, prov_total, formal_total, flags)
        fidelity_total = next_fidelity
        prov_total = next_prov
        formal_total = next_formal
        i = i + 1
    }
    let score = kaxi_hw_epistemic_power_log_q32_32(fidelity_total, prov_total, quantum_total)
    (fidelity_total, prov_total, formal_total, score)
}

// ============================================================================
// Inline: launch.sio helpers
// ============================================================================

struct PtxLaunchConfig {
    target: string,
    grid_x: i64,
    block_x: i64,
    shared_mem_bytes: i64,
    include_quantum_lane: bool,
}

struct PtxLaunchReport {
    launch_accepted: bool,
    used_fallback: bool,
    kernel_name: string,
    target: string,
    op_kind: i64,
    replay_flags: i64,
    fidelity_total: i64,
    prov_total: i64,
    formal_total: i64,
    hardware_epistemic_power_log_q32_32: i64,
}

fn launch_clamp_q8(v: i64) -> i64 {
    if v < 0 { 0 }
    else if v > 256 { 256 }
    else { v }
}

fn launch_is_supported_op(op_kind: i64) -> bool {
    op_kind == KAXI_OP_ADD ||
    op_kind == KAXI_OP_MUL ||
    op_kind == KAXI_OP_DIV ||
    op_kind == KAXI_OP_FMA ||
    op_kind == KAXI_OP_PROP_VAR
}

fn launch_pack_flags(op_kind: i64) -> i64 {
    let op = op_kind & 0xF
    let success = if op == KAXI_OP_PASS { 0 as i64 } else { 1 as i64 }
    let failure = 0 as i64
    let alpha_q8 = 16 as i64
    op | ((failure & 0xFF) << 8) | ((success & 0xFF) << 16) | ((alpha_q8 & 0xFF) << 24)
}

fn launch_hw_counter_step(
    fidelity_total: i64, prov_total: i64, formal_total: i64, op_kind: i64
) -> (i64, i64, i64) {
    let is_epi = if op_kind >= KAXI_OP_ADD && op_kind <= KAXI_OP_PROP_VAR { 1 as i64 } else { 0 as i64 }
    (fidelity_total + is_epi, prov_total + is_epi, formal_total + is_epi)
}

fn launch_hw_epistemic_power_log_q32_32(fidelity_total: i64, prov_total: i64, quantum_total: i64) -> i64 {
    (fidelity_total >> 3) + (prov_total >> 4) + (quantum_total >> 5)
}

fn launch_ptx_default_l4_config() -> PtxLaunchConfig {
    PtxLaunchConfig {
        target: PTX_TARGET_L4,
        grid_x: 80,
        block_x: 128,
        shared_mem_bytes: 0,
        include_quantum_lane: false,
    }
}

fn launch_ptx_target_is_l4(target: string) -> bool {
    str_eq(target, PTX_TARGET_L4) || str_eq(target, PTX_TARGET_L4_ALIAS)
}

fn launch_ptx_config_is_valid(cfg: PtxLaunchConfig) -> bool {
    launch_ptx_target_is_l4(cfg.target) &&
    cfg.grid_x > 0 &&
    cfg.block_x > 0 &&
    cfg.shared_mem_bytes >= 0
}

fn launch_ptx_sanitize_op_kind(op_kind: i64) -> i64 {
    if launch_is_supported_op(op_kind) { op_kind } else { KAXI_OP_PASS }
}

fn launch_ptx_kernel(kernel_name: string, op_kind: i64, cfg: PtxLaunchConfig) -> PtxLaunchReport {
    let launch_accepted = launch_ptx_config_is_valid(cfg)
    let op = launch_ptx_sanitize_op_kind(op_kind)
    let flags = launch_pack_flags(op)
    let (fidelity_total, prov_total, formal_total) =
        launch_hw_counter_step(0, 0, 0, op)
    let quantum_total = if cfg.include_quantum_lane { 1 as i64 } else { 0 as i64 }
    let score_q32_32 =
        launch_hw_epistemic_power_log_q32_32(fidelity_total, prov_total, quantum_total)
    PtxLaunchReport {
        launch_accepted: launch_accepted,
        used_fallback: !launch_accepted || op == KAXI_OP_PASS,
        kernel_name: kernel_name,
        target: cfg.target,
        op_kind: op,
        replay_flags: flags,
        fidelity_total: fidelity_total,
        prov_total: prov_total,
        formal_total: formal_total,
        hardware_epistemic_power_log_q32_32: score_q32_32,
    }
}

fn launch_ptx_read_epistemic_power_q32_32(report: PtxLaunchReport) -> i64 {
    report.hardware_epistemic_power_log_q32_32
}

fn launch_ptx_runtime_metric_q8(report: PtxLaunchReport) -> i64 {
    if report.launch_accepted && !report.used_fallback { 256 }
    else if report.launch_accepted { 160 }
    else { 64 }
}

fn launch_ptx_gum_metric_q8(report: PtxLaunchReport) -> i64 {
    if report.fidelity_total > 0 { 256 } else { 64 }
}

fn launch_ptx_prov_metric_q8(report: PtxLaunchReport) -> i64 {
    if report.prov_total > 0 { 256 } else { 64 }
}

fn launch_ptx_formal_metric_q8(report: PtxLaunchReport) -> i64 {
    if report.formal_total > 0 { 256 } else { 64 }
}

fn launch_ptx_conformance_metric_q8(report: PtxLaunchReport) -> i64 {
    if report.op_kind != KAXI_OP_PASS { 256 } else { 64 }
}

fn launch_ptx_software_epistemic_power_log_q32_32(report: PtxLaunchReport) -> i64 with Div, Panic {
    let runtime = launch_clamp_q8(launch_ptx_runtime_metric_q8(report))
    let gum = launch_clamp_q8(launch_ptx_gum_metric_q8(report))
    let prov = launch_clamp_q8(launch_ptx_prov_metric_q8(report))
    let formal = launch_clamp_q8(launch_ptx_formal_metric_q8(report))
    let conformance = launch_clamp_q8(launch_ptx_conformance_metric_q8(report))
    let weighted_q8 =
        (runtime * 90 + gum * 64 + prov * 38 + formal * 38 + conformance * 26) / 256
    weighted_q8 << 16
}

fn launch_ptx_hybrid_epistemic_power_log_q32_32(report: PtxLaunchReport) -> i64 with Div, Panic {
    let hw_log = launch_ptx_read_epistemic_power_q32_32(report)
    let sw_log = launch_ptx_software_epistemic_power_log_q32_32(report)
    (hw_log + sw_log) / 2
}

// ============================================================================
// MAIN — run all tests
// ============================================================================

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    var passed: i64 = 0
    var failed: i64 = 0

    // ------------------------------------------------------------------
    // T01 — kaxi_flags_pack round-trip
    // ------------------------------------------------------------------
    let f_fma = kaxi_flags_pack(KAXI_OP_FMA, 2, 1, 16)
    // op=4 in bits 0-3, failure=1 in bits 8-15, success=2 in bits 16-23, alpha=16 in bits 24-31
    if f_fma != 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // Pack then unpack should be identity
    let f2 = kaxi_flags_pack(3, 7, 4, 200)
    let roundtrip_ok =
        kaxi_flags_unpack_op_kind(f2) == 3 &&
        kaxi_flags_unpack_success_inc(f2) == 7 &&
        kaxi_flags_unpack_failure_inc(f2) == 4 &&
        kaxi_flags_unpack_alpha_q8(f2) == 200
    if roundtrip_ok {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T02 — kaxi_flags_unpack_op_kind
    // ------------------------------------------------------------------
    if kaxi_flags_unpack_op_kind(f_fma) == KAXI_OP_FMA {
        passed = passed + 1
    } else { failed = failed + 1 }

    // op=0 (PASS)
    let f_pass = kaxi_flags_pack(KAXI_OP_PASS, 0, 0, 0)
    if kaxi_flags_unpack_op_kind(f_pass) == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T03 — kaxi_flags_unpack_success_inc
    // ------------------------------------------------------------------
    if kaxi_flags_unpack_success_inc(f_fma) == 2 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T04 — kaxi_flags_unpack_failure_inc
    // ------------------------------------------------------------------
    if kaxi_flags_unpack_failure_inc(f_fma) == 1 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T05 — kaxi_flags_unpack_alpha_q8
    // ------------------------------------------------------------------
    if kaxi_flags_unpack_alpha_q8(f_fma) == 16 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T06 — kaxi_flags_is_valid
    // ------------------------------------------------------------------
    // All fields in range 0-5 op, 0-255 others => valid
    if kaxi_flags_is_valid(f_fma) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // op=5 (PROP_VAR) is valid
    let f_prop = kaxi_flags_pack(KAXI_OP_PROP_VAR, 1, 0, 8)
    if kaxi_flags_is_valid(f_prop) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // op=0 (PASS) is valid
    if kaxi_flags_is_valid(f_pass) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T07 — kaxi_replay_is_epistemic
    // ------------------------------------------------------------------
    // op=0 is NOT epistemic
    if !kaxi_replay_is_epistemic(f_pass) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // op=1 (ADD) is epistemic
    let f_add = kaxi_flags_pack(KAXI_OP_ADD, 1, 0, 8)
    if kaxi_replay_is_epistemic(f_add) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // op=5 (PROP_VAR) is epistemic
    if kaxi_replay_is_epistemic(f_prop) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T08 — kaxi_hw_counter_step
    // ------------------------------------------------------------------
    // Epistemic flag => each counter increments by 1
    let (fd1, pd1, fm1) = kaxi_hw_counter_step(0, 0, 0, f_add)
    if fd1 == 1 && pd1 == 1 && fm1 == 1 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // Non-epistemic (PASS) => counters stay the same
    let (fd2, pd2, fm2) = kaxi_hw_counter_step(5, 3, 7, f_pass)
    if fd2 == 5 && pd2 == 3 && fm2 == 7 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T09 — kaxi_hw_epistemic_power_log_q32_32
    // ------------------------------------------------------------------
    // With fidelity=8, prov=16, quantum=32:
    // score = (8>>3) + (16>>4) + (32>>5) = 1 + 1 + 1 = 3
    let score = kaxi_hw_epistemic_power_log_q32_32(8, 16, 32)
    if score == 3 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // All zeros => score = 0
    let score_zero = kaxi_hw_epistemic_power_log_q32_32(0, 0, 0)
    if score_zero == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T10 — kaxi_hw_poll_replay_flags batch
    // ------------------------------------------------------------------
    var batch: [i64; 64] = [0; 64]
    batch[0] = kaxi_flags_pack(KAXI_OP_ADD, 1, 0, 8)   // epistemic
    batch[1] = kaxi_flags_pack(KAXI_OP_PASS, 0, 0, 0)  // not epistemic
    batch[2] = kaxi_flags_pack(KAXI_OP_FMA, 1, 1, 16)  // epistemic
    let (bt_fid, bt_prov, bt_form, bt_score) =
        kaxi_hw_poll_replay_flags(batch, 3, 0)
    if bt_fid == 2 && bt_prov == 2 && bt_form == 2 {
        passed = passed + 1
    } else { failed = failed + 1 }
    // score = (2>>3)+(2>>4)+(0>>5) = 0+0+0 = 0
    if bt_score == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // With quantum_total=32: score = 0 + 0 + 1 = 1
    let (_, _, _, bt_score2) = kaxi_hw_poll_replay_flags(batch, 3, 32)
    if bt_score2 == 1 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T11 — launch_is_supported_op
    // ------------------------------------------------------------------
    if launch_is_supported_op(KAXI_OP_ADD) &&
       launch_is_supported_op(KAXI_OP_MUL) &&
       launch_is_supported_op(KAXI_OP_DIV) &&
       launch_is_supported_op(KAXI_OP_FMA) &&
       launch_is_supported_op(KAXI_OP_PROP_VAR) {
        passed = passed + 1
    } else { failed = failed + 1 }

    if !launch_is_supported_op(KAXI_OP_PASS) && !launch_is_supported_op(99) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T12 — launch_pack_flags for FMA
    // ------------------------------------------------------------------
    let lf_fma = launch_pack_flags(KAXI_OP_FMA)
    if kaxi_flags_unpack_op_kind(lf_fma) == KAXI_OP_FMA &&
       kaxi_flags_unpack_success_inc(lf_fma) == 1 &&
       kaxi_flags_unpack_failure_inc(lf_fma) == 0 &&
       kaxi_flags_unpack_alpha_q8(lf_fma) == 16 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // PASS op => success=0
    let lf_pass = launch_pack_flags(KAXI_OP_PASS)
    if kaxi_flags_unpack_success_inc(lf_pass) == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T13 — launch_ptx_default_l4_config fields
    // ------------------------------------------------------------------
    let cfg = launch_ptx_default_l4_config()
    if str_eq(cfg.target, PTX_TARGET_L4) {
        passed = passed + 1
    } else { failed = failed + 1 }
    if cfg.grid_x == 80 && cfg.block_x == 128 && cfg.shared_mem_bytes == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }
    if !cfg.include_quantum_lane {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T14 — launch_ptx_config_is_valid and launch_ptx_target_is_l4
    // ------------------------------------------------------------------
    if launch_ptx_target_is_l4(PTX_TARGET_L4) && launch_ptx_target_is_l4(PTX_TARGET_L4_ALIAS) {
        passed = passed + 1
    } else { failed = failed + 1 }

    if launch_ptx_config_is_valid(cfg) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // grid_x=0 makes it invalid
    let bad_cfg = PtxLaunchConfig {
        target: PTX_TARGET_L4,
        grid_x: 0,
        block_x: 128,
        shared_mem_bytes: 0,
        include_quantum_lane: false,
    }
    if !launch_ptx_config_is_valid(bad_cfg) {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T15 — launch_ptx_sanitize_op_kind
    // ------------------------------------------------------------------
    if launch_ptx_sanitize_op_kind(KAXI_OP_FMA) == KAXI_OP_FMA {
        passed = passed + 1
    } else { failed = failed + 1 }
    // unsupported op => PASS
    if launch_ptx_sanitize_op_kind(99) == KAXI_OP_PASS {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T16 — launch_ptx_kernel: FMA on valid L4 config
    // ------------------------------------------------------------------
    let report_fma = launch_ptx_kernel(PTX_KERNEL_EPISTEMIC_GEMM, KAXI_OP_FMA, cfg)
    if report_fma.launch_accepted {
        passed = passed + 1
    } else { failed = failed + 1 }
    if !report_fma.used_fallback {
        passed = passed + 1
    } else { failed = failed + 1 }
    if report_fma.op_kind == KAXI_OP_FMA {
        passed = passed + 1
    } else { failed = failed + 1 }
    if report_fma.fidelity_total == 1 && report_fma.prov_total == 1 && report_fma.formal_total == 1 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T17 — launch_ptx_kernel: PASS op forces used_fallback
    // ------------------------------------------------------------------
    let report_pass = launch_ptx_kernel(PTX_KERNEL_EPISTEMIC_GEMM, KAXI_OP_PASS, cfg)
    if report_pass.used_fallback {
        passed = passed + 1
    } else { failed = failed + 1 }
    if report_pass.fidelity_total == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T18 — launch_ptx_software_epistemic_power_log_q32_32 > 0 for FMA
    // ------------------------------------------------------------------
    let sw_log = launch_ptx_software_epistemic_power_log_q32_32(report_fma)
    if sw_log > 0 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T19 — launch_ptx_hybrid_epistemic_power_log_q32_32 is midpoint
    // ------------------------------------------------------------------
    let hw_log = launch_ptx_read_epistemic_power_q32_32(report_fma)
    let hybrid = launch_ptx_hybrid_epistemic_power_log_q32_32(report_fma)
    let expected_hybrid = (hw_log + sw_log) / 2
    if hybrid == expected_hybrid {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // T20 — launch_clamp_q8 boundary values
    // ------------------------------------------------------------------
    if launch_clamp_q8(0 - 10) == 0 {
        passed = passed + 1
    } else { failed = failed + 1 }
    if launch_clamp_q8(300) == 256 {
        passed = passed + 1
    } else { failed = failed + 1 }
    if launch_clamp_q8(128) == 128 {
        passed = passed + 1
    } else { failed = failed + 1 }
    if launch_clamp_q8(256) == 256 {
        passed = passed + 1
    } else { failed = failed + 1 }

    // ------------------------------------------------------------------
    // Summary
    // ------------------------------------------------------------------
    print("hardware tests passed=")
    print_int(passed)
    print(" failed=")
    print_int(failed)
    print("\n")

    if failed > 0 { return 1 }
    return 0
}
