//@ run-pass

use hardware::pireus::operator_seed_kernel::{
    PIREUS_OSK_OK,
    PIREUS_OSK_LANES,
    PIREUS_OSK_CELLS,
    PIREUS_OSK_TERMS,
    PIREUS_OSK_PROBES,
    PIREUS_OSK_BASIS_PRODUCTS,
    PIREUS_OSK_BASIS_LANE_CHECKS,
    pireus_operator_seed_kernel_request,
    pireus_operator_seed_kernel_parent_paths,
    pireus_operator_seed_kernel_evaluate,
    pireus_osk_digest_nonzero,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request = pireus_operator_seed_kernel_request()
    let paths = pireus_operator_seed_kernel_parent_paths()
    let result = pireus_operator_seed_kernel_evaluate(&request, &paths)
    var failures: i64 = 0
    if !result.valid || result.error != PIREUS_OSK_OK ||
        result.failure_groups != 0 {
        failures = failures + 1
    }
    if !result.lineage.complete || !result.lineage.parent_valid ||
        !result.lineage.parent_frozen_match ||
        !result.lineage.parent_source_file_match ||
        !result.lineage.parent_semantics_receipt_match ||
        !result.lineage.parent_freeze_file_match ||
        !result.lineage.parent_evidence_file_match ||
        !result.lineage.parent_process_evidence_bound ||
        !result.lineage.parent_process_evidence_externalized ||
        result.lineage.parent_recursive_evaluation_used ||
        !result.lineage.parent_operator_seed ||
        result.lineage.parent_existing_bridge ||
        result.lineage.parent_residual_nonzero <= 0 ||
        result.lineage.seed_word_cell_checks != PIREUS_OSK_CELLS ||
        result.lineage.seed_word_cell_failures != 0 {
        failures = failures + 1
    }
    if !result.operator_ir.complete ||
        result.operator_ir.destination_count != PIREUS_OSK_LANES ||
        result.operator_ir.terms_per_destination != PIREUS_OSK_LANES ||
        result.operator_ir.term_count != PIREUS_OSK_TERMS ||
        result.operator_ir.unique_term_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.unique_term_failures != 0 ||
        result.operator_ir.unique_source_checks != PIREUS_OSK_CELLS ||
        result.operator_ir.unique_source_failures != 0 ||
        result.operator_ir.destination_group_checks != PIREUS_OSK_LANES ||
        result.operator_ir.destination_group_failures != 0 ||
        result.operator_ir.xor_address_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.xor_address_failures != 0 ||
        result.operator_ir.coefficient_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.coefficient_failures != 0 ||
        result.operator_ir.roundtrip_checks != PIREUS_OSK_TERMS ||
        result.operator_ir.roundtrip_failures != 0 {
        failures = failures + 1
    }
    var term: i64 = 0
    while term < PIREUS_OSK_TERMS {
        let destination = term / PIREUS_OSK_LANES
        let left = term - destination * PIREUS_OSK_LANES
        let right = left ^ destination
        if result.operator_ir.destinations[term] != destination ||
            result.operator_ir.left_indices[term] != left ||
            result.operator_ir.right_indices[term] != right ||
            result.operator_ir.source_cells[term] !=
                left * PIREUS_OSK_LANES + right ||
            (result.operator_ir.coefficients[term] != 1 &&
                result.operator_ir.coefficients[term] != -1) {
            failures = failures + 1
        }
        term = term + 1
    }
    if !result.basis.complete ||
        result.basis.products != PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.lane_checks != PIREUS_OSK_BASIS_LANE_CHECKS ||
        result.basis.path_checks != PIREUS_OSK_BASIS_LANE_CHECKS ||
        result.basis.destination_checks != PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.coefficient_checks != PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.single_support_checks !=
            2 * PIREUS_OSK_BASIS_PRODUCTS ||
        result.basis.failures != 0 {
        failures = failures + 1
    }
    var probe: i64 = 0
    while probe < PIREUS_OSK_PROBES {
        if result.probes[probe].id != probe ||
            !result.probes[probe].complete ||
            result.probes[probe].lane_checks != PIREUS_OSK_LANES ||
            result.probes[probe].equality_failures != 0 ||
            result.probes[probe].bound_checks != 2 * PIREUS_OSK_LANES ||
            result.probes[probe].bound_failures != 0 {
            failures = failures + 1
        }
        probe = probe + 1
    }
    if result.negatives.total != 35 ||
        result.negatives.passed != result.negatives.total {
        failures = failures + 1
    }
    if !result.receipt.parent_lineage_bound ||
        !result.receipt.parent_frozen_match ||
        !result.receipt.parent_process_evidence_bound ||
        !result.receipt.parent_process_evidence_externalized ||
        result.receipt.parent_recursive_evaluation_used ||
        !result.receipt.operator_seed_admitted ||
        !result.receipt.table_evaluator_validated ||
        !result.receipt.kernel_ir_complete ||
        !result.receipt.ir_evaluator_validated ||
        !result.receipt.basis_sweep_complete ||
        !result.receipt.dense_probes_complete ||
        !result.receipt.generated_operator_candidate ||
        result.receipt.expected_result_used ||
        result.receipt.target_evidence_used ||
        result.receipt.material_evidence_used ||
        result.receipt.target_cost_used ||
        result.receipt.target_performance_used ||
        result.receipt.semantics_frozen ||
        result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open ||
        result.receipt.material_parity_open ||
        result.receipt.broad_novelty ||
        result.receipt.historical_novelty ||
        result.receipt.priority_claim || result.receipt.claim_ready {
        failures = failures + 1
    }
    if !result.candidate.generated ||
        !result.candidate.future_parent_eligible ||
        !pireus_osk_digest_nonzero(&result.candidate.kernel_digest) ||
        !pireus_osk_digest_nonzero(&result.candidate.execution_digest) ||
        !pireus_osk_digest_nonzero(&result.lineage_digest) ||
        !pireus_osk_digest_nonzero(&result.seed_digest) ||
        !pireus_osk_digest_nonzero(&result.kernel_digest) ||
        !pireus_osk_digest_nonzero(&result.probe_digest) ||
        !pireus_osk_digest_nonzero(&result.basis_digest) ||
        !pireus_osk_digest_nonzero(&result.receipt_digest) ||
        !pireus_osk_digest_nonzero(&result.forge_digest) {
        failures = failures + 1
    }
    print("pireus operator seed kernel structural failures: ")
    print_int(failures)
    print("\n")
    if failures == 0 { 0 } else { 1 }
}
