//@ run-pass

use hardware::pireus::material_engine_admission::{
    PireusMaterialEngineParentPaths,
    PIREUS_MATERIAL_ENGINE_OK, PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT,
    pireus_material_engine_parent_file_matches,
    pireus_material_engine_admission_evaluate,
    pireus_material_engine_admission_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 12 { return 2 }
    let parents = PireusMaterialEngineParentPaths {
        garden: get_arg(0), engine_source: get_arg(1),
        engine_semantics: get_arg(2), engine_receipt: get_arg(3),
        cost_source: get_arg(4), cost_semantics: get_arg(5),
        cost_receipt: get_arg(6), cost_evidence: get_arg(7),
        apple_receipt: get_arg(8), apple_evidence: get_arg(9),
        dgx_receipt: get_arg(10), dgx_evidence: get_arg(11),
    }
    let result = pireus_material_engine_admission_evaluate(&parents)
    var failures: i64 = 0
    if !result.valid || result.error != PIREUS_MATERIAL_ENGINE_OK ||
        result.failures != 0 || !result.parent_files_valid ||
        !result.execution_engine_parent_snapshot_matches ||
        !result.target_cost_parent_hash_bound {
        failures = failures + 1
    }
    if !pireus_material_engine_admission_matches_frozen_semantics(&result) {
        failures = failures + 1
    }
    var i: i64 = 0
    while i < PIREUS_MATERIAL_ENGINE_PARENT_FILE_COUNT {
        if !pireus_material_engine_parent_file_matches(
            result.parent_file_match_mask, i) {
            failures = failures + 1
        }
        i = i + 1
    }
    if !result.apple_admitted || !result.dgx_24_admitted ||
        !result.dgx_48_unresolved || result.dgx_48_resolution_count != 0 ||
        result.unresolved_identity_request_count != 1 ||
        result.identity_request_count != 1 ||
        result.apple_gpu_engine_count != 0 || result.dgx_cpu_engine_count != 0 {
        failures = failures + 1
    }
    if !result.ontology_identity_binding_valid ||
        result.admitted_machine_count != result.admitted_engine_count ||
        result.cost_request_eligible_engine_count !=
            result.admitted_engine_count ||
        result.cost_request_eligibility_count !=
            2 * result.cost_request_eligible_engine_count ||
        result.overlay_cluster_machine_count !=
            result.base_cluster_machine_count + result.admitted_machine_count {
        failures = failures + 1
    }
    if result.material_cost_value_count != 0 ||
        result.whole_operation_coverage_count != 0 ||
        result.comparison_count != 0 || result.speedup_count != 0 ||
        result.ranking_count != 0 || result.cross_target_comparable ||
        result.parity_open || result.claim_ready {
        failures = failures + 1
    }
    if result.negatives.total < 22 ||
        result.negatives.passed != result.negatives.total {
        failures = failures + 1
    }
    var digest_nonzero = false
    var ontology_digest_nonzero = false
    i = 0
    while i < 8 {
        if result.result_digest.words[i as usize] != 0 {
            digest_nonzero = true
        }
        if result.ontology_digest.words[i as usize] != 0 {
            ontology_digest_nonzero = true
        }
        i = i + 1
    }
    if !digest_nonzero || !ontology_digest_nonzero {
        failures = failures + 1
    }
    if failures == 0 {
        print("pireus material engine admission test passed\n")
        0
    } else {
        print("pireus material engine admission test failed: ")
        print_int(failures); print("\n")
        1
    }
}
