//@ run-pass

use hardware::pireus::u250_dual_card_admission::{
    PIREUS_U250_LANGUAGE_CPP,
    PIREUS_U250_LANGUAGE_EXTERNAL_LLM,
    PIREUS_U250_LANGUAGE_PYTHON,
    PIREUS_U250_LANGUAGE_RUST,
    PIREUS_U250_ROLE_REVIEW_ONLY,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
}
use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
}
use hardware::pireus::u250_fpga_kernel_artifact::{
    pireus_u250_fpga_kernel_artifact_request,
    pireus_u250_fpga_kernel_artifact_project,
}
use hardware::pireus::u250_xclbin_material_receipt::{
    pireus_u250_xclbin_material_ingest_file,
}
use hardware::pireus::u250_kernel_launch_receipt::{
    PIREUS_U250_KERNEL_LAUNCH_STATUS_PARENT_REFUSED,
    PIREUS_U250_KERNEL_LAUNCH_STATUS_AUTHORITY_REFUSED,
    PIREUS_U250_KERNEL_LAUNCH_STATUS_ORDER_REFUSED,
    PIREUS_U250_KERNEL_LAUNCH_STATUS_OBSERVATION_REFUSED,
    PIREUS_U250_KERNEL_LAUNCH_STATUS_IDENTITY_REFUSED,
    PIREUS_U250_KERNEL_LAUNCH_STATUS_INVOCATION_REFUSED,
    PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED,
    PIREUS_U250_KERNEL_LAUNCH_STATUS_CLAIM_REFUSED,
    pireus_u250_kernel_launch_request,
    pireus_u250_kernel_launch_observation,
    pireus_u250_kernel_launch_project,
    pireus_u250_kernel_launch_ingest_file,
    pireus_u250_kernel_launch_waiting_matches_expected,
    pireus_u250_kernel_launch_parity_matches_expected,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 3 && arg_count() != 5 { return 100 }
    let admission = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let engine_request = pireus_u250_execution_engine_request()
    let engine = pireus_u250_execution_engine_project(
        &admission, &engine_request)
    let artifact_request = pireus_u250_fpga_kernel_artifact_request()
    let artifact = pireus_u250_fpga_kernel_artifact_project(
        &engine, &artifact_request)
    let material = pireus_u250_xclbin_material_ingest_file(
        &artifact, get_arg(2))

    let waiting_request = pireus_u250_kernel_launch_request()
    let waiting = pireus_u250_kernel_launch_project(
        &material, &waiting_request)
    if !pireus_u250_kernel_launch_waiting_matches_expected(&waiting) {
        return 1
    }

    let observed_request = pireus_u250_kernel_launch_observation()
    let observed = pireus_u250_kernel_launch_project(
        &material, &observed_request)
    if !pireus_u250_kernel_launch_parity_matches_expected(&observed) {
        return 2
    }

    var bad_parent = material
    bad_parent.artifact_parity_open = false
    let bad_parent_result = pireus_u250_kernel_launch_project(
        &bad_parent, &observed_request)
    if bad_parent_result.valid || bad_parent_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_PARENT_REFUSED { return 3 }

    var premature = pireus_u250_kernel_launch_observation()
    premature.semantics_frozen = false
    let premature_result = pireus_u250_kernel_launch_project(
        &material, &premature)
    if premature_result.valid || premature_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_ORDER_REFUSED { return 4 }

    var no_completion = pireus_u250_kernel_launch_observation()
    no_completion.run_completed = false
    let no_completion_result = pireus_u250_kernel_launch_project(
        &material, &no_completion)
    if no_completion_result.valid || no_completion_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_OBSERVATION_REFUSED { return 5 }

    var no_output = pireus_u250_kernel_launch_observation()
    no_output.output_values_recorded = false
    let no_output_result = pireus_u250_kernel_launch_project(
        &material, &no_output)
    if no_output_result.valid || no_output_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_OBSERVATION_REFUSED { return 6 }

    var wrong_device = pireus_u250_kernel_launch_observation()
    wrong_device.device_bdf_matches = false
    let wrong_device_result = pireus_u250_kernel_launch_project(
        &material, &wrong_device)
    if wrong_device_result.valid || wrong_device_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_IDENTITY_REFUSED { return 7 }

    var wrong_digest = pireus_u250_kernel_launch_observation()
    wrong_digest.artifact_digest_matches = false
    let wrong_digest_result = pireus_u250_kernel_launch_project(
        &material, &wrong_digest)
    if wrong_digest_result.valid || wrong_digest_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_IDENTITY_REFUSED { return 8 }

    var wrong_samples = pireus_u250_kernel_launch_observation()
    wrong_samples.n_samples = 5
    let wrong_samples_result = pireus_u250_kernel_launch_project(
        &material, &wrong_samples)
    if wrong_samples_result.valid || wrong_samples_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_INVOCATION_REFUSED { return 9 }

    var wrong_lut = pireus_u250_kernel_launch_observation()
    wrong_lut.lut_1 = 16383
    let wrong_lut_result = pireus_u250_kernel_launch_project(
        &material, &wrong_lut)
    if wrong_lut_result.valid || wrong_lut_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_INVOCATION_REFUSED { return 10 }

    var wrong_width = pireus_u250_kernel_launch_observation()
    wrong_width.histogram_output_bytes = 16
    let wrong_width_result = pireus_u250_kernel_launch_project(
        &material, &wrong_width)
    if wrong_width_result.valid || wrong_width_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_INVOCATION_REFUSED { return 11 }

    var cpp_authority = pireus_u250_kernel_launch_observation()
    cpp_authority.producer_language = PIREUS_U250_LANGUAGE_CPP
    cpp_authority.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let cpp_authority_result = pireus_u250_kernel_launch_project(
        &material, &cpp_authority)
    if cpp_authority_result.valid || cpp_authority_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_AUTHORITY_REFUSED { return 12 }

    var python = pireus_u250_kernel_launch_observation()
    python.producer_language = PIREUS_U250_LANGUAGE_PYTHON
    python.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let python_result = pireus_u250_kernel_launch_project(&material, &python)
    if python_result.valid || python_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_AUTHORITY_REFUSED { return 13 }

    var rust = pireus_u250_kernel_launch_observation()
    rust.producer_language = PIREUS_U250_LANGUAGE_RUST
    rust.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let rust_result = pireus_u250_kernel_launch_project(&material, &rust)
    if rust_result.valid || rust_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_AUTHORITY_REFUSED { return 14 }

    var llm = pireus_u250_kernel_launch_observation()
    llm.producer_language = PIREUS_U250_LANGUAGE_EXTERNAL_LLM
    llm.producer_role = PIREUS_U250_ROLE_REVIEW_ONLY
    let llm_result = pireus_u250_kernel_launch_project(&material, &llm)
    if llm_result.valid || llm_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_AUTHORITY_REFUSED { return 15 }

    var verdict = pireus_u250_kernel_launch_observation()
    verdict.semantic_verdict_emitted_by_child = true
    let verdict_result = pireus_u250_kernel_launch_project(&material, &verdict)
    if verdict_result.valid || verdict_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED { return 16 }

    var expected = pireus_u250_kernel_launch_observation()
    expected.expected_output_present = true
    let expected_result = pireus_u250_kernel_launch_project(
        &material, &expected)
    if expected_result.valid || expected_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED { return 17 }

    var correctness = pireus_u250_kernel_launch_observation()
    correctness.kernel_correctness_present = true
    let correctness_result = pireus_u250_kernel_launch_project(
        &material, &correctness)
    if correctness_result.valid || correctness_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED { return 18 }

    var operation = pireus_u250_kernel_launch_observation()
    operation.operation_capability_count = 1
    let operation_result = pireus_u250_kernel_launch_project(
        &material, &operation)
    if operation_result.valid || operation_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED { return 19 }

    var lowering = pireus_u250_kernel_launch_observation()
    lowering.lowering_requested = true
    let lowering_result = pireus_u250_kernel_launch_project(
        &material, &lowering)
    if lowering_result.valid || lowering_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED { return 20 }

    var isa = pireus_u250_kernel_launch_observation()
    isa.isa_claim_present = true
    let isa_result = pireus_u250_kernel_launch_project(&material, &isa)
    if isa_result.valid || isa_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED { return 21 }

    var performance = pireus_u250_kernel_launch_observation()
    performance.performance_present = true
    let performance_result = pireus_u250_kernel_launch_project(
        &material, &performance)
    if performance_result.valid || performance_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CAPABILITY_REFUSED { return 22 }

    var claim = pireus_u250_kernel_launch_observation()
    claim.claim_ready_requested = true
    let claim_result = pireus_u250_kernel_launch_project(&material, &claim)
    if claim_result.valid || claim_result.status !=
        PIREUS_U250_KERNEL_LAUNCH_STATUS_CLAIM_REFUSED { return 23 }

    if arg_count() == 5 {
        let sealed = pireus_u250_kernel_launch_ingest_file(
            &material, get_arg(3))
        if !pireus_u250_kernel_launch_parity_matches_expected(&sealed) {
            return 24
        }
        let tampered = pireus_u250_kernel_launch_ingest_file(
            &material, get_arg(4))
        if tampered.valid || tampered.status !=
            PIREUS_U250_KERNEL_LAUNCH_STATUS_OBSERVATION_REFUSED { return 25 }
    }

    print("PIREUS_U250_KERNEL_LAUNCH_TEST_PASS waiting=1 parity_projection=1 parent=REFUSED premature=REFUSED incomplete=REFUSED missing_output=REFUSED device_drift=REFUSED digest_drift=REFUSED samples_drift=REFUSED lut_drift=REFUSED width_drift=REFUSED cpp_authority=REFUSED python_authority=REFUSED rust_authority=REFUSED llm_authority=REFUSED child_verdict=REFUSED expected_output=REFUSED correctness=REFUSED operation=REFUSED lowering=REFUSED isa=REFUSED performance=REFUSED claim_ready=REFUSED\n")
    0
}
