//@ run-pass
//!
//! Matcher-free structural test for the Pireus V14 plan. It checks only
//! Garden-fixed domains and false boundaries; it contains no V14 golden.

use hardware::pireus::multiprobe_block_certification::{
    PIREUS_MBC_OK,
    PIREUS_MBC_PROBES,
    PIREUS_MBC_ACTIONS,
    PIREUS_MBC_BLOCKS,
    PIREUS_MBC_BLOCK_WIDTH,
    PIREUS_MBC_LOGICAL_JOBS,
    pireus_mbc_block_shape_valid,
    pireus_mbc_digest_nonzero,
    pireus_multiprobe_block_certification_request,
    pireus_multiprobe_block_certification_paths,
    pireus_multiprobe_block_certification_evaluate,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if PIREUS_MBC_PROBES * PIREUS_MBC_BLOCKS !=
        PIREUS_MBC_LOGICAL_JOBS ||
        PIREUS_MBC_BLOCKS * PIREUS_MBC_BLOCK_WIDTH !=
            PIREUS_MBC_ACTIONS {
        return 1
    }
    if !pireus_mbc_block_shape_valid(0, 0, 630, 630) ||
        !pireus_mbc_block_shape_valid(63, 39690, 630, 40320) ||
        pireus_mbc_block_shape_valid(63, 39689, 630, 40319) {
        return 2
    }
    let request = pireus_multiprobe_block_certification_request()
    let paths = pireus_multiprobe_block_certification_paths()
    let result = pireus_multiprobe_block_certification_evaluate(
        &request, &paths, false)
    if !result.valid || result.error != PIREUS_MBC_OK ||
        !result.garden_match || !result.contract_match ||
        !result.parent_transcript_match {
        return 3
    }
    if result.parent_records != PIREUS_MBC_PROBES ||
        result.parent_canonical_cells != PIREUS_MBC_PROBES * 256 ||
        result.parent_duplicate_contents != 0 ||
        result.parent_parse_failures != 0 {
        return 4
    }
    if result.partition_blocks != PIREUS_MBC_BLOCKS ||
        result.partition_views != PIREUS_MBC_ACTIONS ||
        result.partition_failures != 0 ||
        result.work_domains != PIREUS_MBC_LOGICAL_JOBS ||
        result.work_addresses != PIREUS_MBC_LOGICAL_JOBS ||
        result.domain_validation_failures != 0 ||
        result.address_replay_checks != PIREUS_MBC_LOGICAL_JOBS ||
        result.address_replay_failures != 0 {
        return 5
    }
    if result.negative_cases_total <= 0 ||
        result.negative_cases_passed != result.negative_cases_total {
        return 6
    }
    if !pireus_mbc_digest_nonzero(&result.strategy_digest) ||
        !pireus_mbc_digest_nonzero(&result.probe_set_digest) ||
        !pireus_mbc_digest_nonzero(&result.partition_digest) ||
        !pireus_mbc_digest_nonzero(&result.plan_digest) ||
        !pireus_mbc_digest_nonzero(&result.first_work_address) ||
        !pireus_mbc_digest_nonzero(&result.last_work_address) {
        return 7
    }
    if result.completed_blocks != 0 || result.reuse_hits != 0 ||
        result.expected_result_digests != 0 ||
        result.actual_block_execution_complete || result.any_block_reused ||
        result.all_v13_probes_certified ||
        result.deterministic_purity_formally_proved ||
        result.material_bound_profile_instantiated ||
        result.collision_free_semantic_identity ||
        result.formal_parity_open || result.effect_parity_open ||
        result.material_parity_open || result.denotational_parity_open ||
        result.performance_measured || result.speedup_admitted ||
        result.cache_hit_rate_admitted || result.algorithmic_novelty ||
        result.material_novelty || result.scientific_novelty ||
        result.global_novelty || result.historical_novelty ||
        result.priority_claim || result.claim_ready {
        return 8
    }
    print("PIREUS_MULTIPROBE_BLOCK_CERTIFICATION_EXECUTABLE_OK\n")
    0
}
