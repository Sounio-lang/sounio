//@ run-pass
use hardware::pireus::xor_material_matching::{
    PIREUS_XOR_MATERIAL_OK,
    pireus_xor_material_evaluate,
    pireus_xor_material_digest_nonzero,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let result = pireus_xor_material_evaluate()
    if !result.valid || result.error != PIREUS_XOR_MATERIAL_OK { return 1 }
    if !result.operation_parent_live_match ||
        !result.operation_parent_binding_valid { return 2 }
    if result.selector.count != result.reconstructed_cells { return 3 }
    if !result.layout_one_source_per_group { return 4 }
    if !result.xed.valid { return 5 }
    if result.xed.selector_semantics_receipt_present ||
        result.xed.instruction_match_authorized ||
        result.xed.immediate_sufficiency_authorized ||
        result.xed.two_source_necessity_authorized { return 6 }
    if result.targets.observed[0] || result.targets.observed[1] ||
        result.targets.observed[2] { return 7 }
    if result.material_observation_count != 0 ||
        result.instruction_match_count != 0 || result.lowering_count != 0 ||
        result.cost_record_count != 0 { return 8 }
    if result.negatives.passed != result.negatives.total { return 9 }
    if !pireus_xor_material_digest_nonzero(&result.selector_digest) {
        return 10
    }
    if !pireus_xor_material_digest_nonzero(&result.evidence_digest) {
        return 11
    }
    if !pireus_xor_material_digest_nonzero(&result.target_digest) { return 12 }
    if !pireus_xor_material_digest_nonzero(&result.witness_digest) {
        return 13
    }
    if result.parity_open || result.claim_ready || result.failures != 0 {
        return 14
    }
    print("PIREUS_XOR_MATERIAL_EXECUTABLE_OK\n")
    0
}
