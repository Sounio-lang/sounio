//@ run-pass
use hardware::pireus::xor_selector_material_admission::PireusXorMaterialFilePaths
use hardware::pireus::target_cost_observation::{
    PireusCostParentPaths,
    PIREUS_COST_OK, PIREUS_COST_REQUEST_COUNT,
    PIREUS_COST_EVIDENCE_REQUEST, PIREUS_COST_ENV_COMPLETE,
    pireus_cost_ledger_request, pireus_cost_request_valid,
    pireus_target_cost_observation_evaluate,
    pireus_target_cost_observation_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 19 {
        print("PIREUS_TARGET_COST_OBSERVATION_TEST_REQUIRES_PINNED_PARENTS\n")
        return 2
    }
    let material = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(2), darwin_evidence: get_arg(3),
        apple_receipt: get_arg(4), apple_evidence: get_arg(5),
        dgx_receipt: get_arg(6), dgx_evidence: get_arg(7),
    }
    let parents = PireusCostParentPaths {
        garden: get_arg(8), admission_source: get_arg(9),
        admission_semantics: get_arg(10), admission_receipt: get_arg(11),
        admission_evidence: get_arg(12), engine_source: get_arg(13),
        engine_semantics: get_arg(14), engine_receipt: get_arg(15),
        operation_source: get_arg(16), operation_semantics: get_arg(17),
        operation_receipt: get_arg(18),
    }
    let result = pireus_target_cost_observation_evaluate(
        get_arg(0), get_arg(1), &material, &parents)
    if !result.valid || result.error != PIREUS_COST_OK ||
        result.failures != 0 || !result.parent_files_valid ||
        !result.admission_parent_live || !result.operation_parent_live ||
        !result.engine_parent_live ||
        !pireus_target_cost_observation_matches_frozen_semantics(&result) {
        return 1
    }
    if result.ledger.request_count != PIREUS_COST_REQUEST_COUNT ||
        result.ledger.selector_request_count != 6 ||
        result.ledger.whole_operation_request_count != 1 ||
        result.ontology_request_count != PIREUS_COST_REQUEST_COUNT ||
        result.ontology_observation_count != 0 ||
        result.ontology_summary_count != 0 ||
        result.ontology_comparison_count != 0 {
        return 2
    }
    var i: i64 = 0
    while i < PIREUS_COST_REQUEST_COUNT {
        let request = pireus_cost_ledger_request(&result.ledger, i)
        if !pireus_cost_request_valid(&request) || request.value_present ||
            request.evidence_role != PIREUS_COST_EVIDENCE_REQUEST ||
            request.required_environment_mask != PIREUS_COST_ENV_COMPLETE ||
            request.bound_environment_mask != 0 {
            return 3
        }
        i = i + 1
    }
    if result.material_observation_count != 0 ||
        result.derived_summary_count != 0 ||
        result.comparison_receipt_count != 0 || result.speedup_count != 0 ||
        result.ranking_count != 0 || result.cross_target_comparable ||
        result.parity_open || result.claim_ready ||
        result.negatives.passed != result.negatives.total {
        return 4
    }
    print("PIREUS_TARGET_COST_OBSERVATION_EXECUTABLE_OK\n")
    0
}
