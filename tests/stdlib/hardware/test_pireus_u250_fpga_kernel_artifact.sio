//@ run-pass

use hardware::pireus::u250_dual_card_admission::{
    PIREUS_U250_LANGUAGE_CPP,
    PIREUS_U250_LANGUAGE_EXTERNAL_LLM,
    PIREUS_U250_LANGUAGE_PYTHON,
    PIREUS_U250_LANGUAGE_RUST,
    PIREUS_U250_ROLE_MATERIAL_PARITY,
    PIREUS_U250_ROLE_REVIEW_ONLY,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
}
use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    PIREUS_U250_ENGINE_SLOT_1,
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
}
use hardware::pireus::u250_fpga_kernel_artifact::{
    PIREUS_KERNEL_SYMBOL_KRNL_CENSUS_OUTLINE,
    PIREUS_U250_KERNEL_STATUS_PARENT_REFUSED,
    PIREUS_U250_KERNEL_STATUS_AUTHORITY_REFUSED,
    PIREUS_U250_KERNEL_STATUS_ABI_REFUSED,
    PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED,
    PIREUS_U250_KERNEL_STATUS_CAPABILITY_REFUSED,
    PIREUS_U250_KERNEL_STATUS_PARITY_REFUSED,
    PIREUS_U250_KERNEL_STATUS_CLAIM_REFUSED,
    PIREUS_U250_KERNEL_STATUS_OUTLINE_REFUSED,
    pireus_u250_fpga_kernel_artifact_request,
    pireus_u250_fpga_kernel_artifact_project,
    pireus_u250_fpga_kernel_artifact_matches_expected,
    pireus_u250_fpga_kernel_artifact_store,
    pireus_u250_query_kernel_artifacts,
    pireus_u250_query_kernel_arguments,
    pireus_u250_query_artifact_bits,
    pireus_u250_query_artifact_isa,
    pireus_u250_query_artifact_operations,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 3 { return 100 }
    let material = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let engine_request = pireus_u250_execution_engine_request()
    let engine = pireus_u250_execution_engine_project(
        &material, &engine_request)
    let canonical = pireus_u250_fpga_kernel_artifact_request()
    let result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &canonical)
    if !pireus_u250_fpga_kernel_artifact_matches_expected(&result) { return 1 }

    var store = pireus_u250_fpga_kernel_artifact_store(&engine, &result)
    let artifacts = pireus_u250_query_kernel_artifacts(&store)
    let arguments = pireus_u250_query_kernel_arguments(&store)
    let bits = pireus_u250_query_artifact_bits(&store)
    let isa = pireus_u250_query_artifact_isa(&store)
    let operations = pireus_u250_query_artifact_operations(&store)
    if triple_store_count(&store) != 420 ||
        sparql_result_count(&artifacts) != 1 ||
        sparql_result_count(&arguments) != 8 ||
        sparql_result_count(&bits) != 0 ||
        sparql_result_count(&isa) != 0 ||
        sparql_result_count(&operations) != 0 { return 2 }

    var wrong_engine = pireus_u250_fpga_kernel_artifact_request()
    wrong_engine.engine = PIREUS_U250_ENGINE_SLOT_1
    let wrong_engine_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &wrong_engine)
    if wrong_engine_result.valid || wrong_engine_result.status !=
        PIREUS_U250_KERNEL_STATUS_ABI_REFUSED { return 3 }

    var outline = pireus_u250_fpga_kernel_artifact_request()
    outline.kernel_symbol = PIREUS_KERNEL_SYMBOL_KRNL_CENSUS_OUTLINE
    let outline_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &outline)
    if outline_result.valid || outline_result.status !=
        PIREUS_U250_KERNEL_STATUS_OUTLINE_REFUSED { return 4 }

    var wrong_abi = pireus_u250_fpga_kernel_artifact_request()
    wrong_abi.abi_argument_count = 7
    let wrong_abi_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &wrong_abi)
    if wrong_abi_result.valid || wrong_abi_result.status !=
        PIREUS_U250_KERNEL_STATUS_ABI_REFUSED { return 5 }

    var source_bits = pireus_u250_fpga_kernel_artifact_request()
    source_bits.source_implies_bits = true
    let source_bits_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &source_bits)
    if source_bits_result.valid || source_bits_result.bitstream_present ||
        source_bits_result.status !=
        PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED { return 6 }

    var build_bits = pireus_u250_fpga_kernel_artifact_request()
    build_bits.build_recipe_implies_bits = true
    let build_bits_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &build_bits)
    if build_bits_result.valid || build_bits_result.bitstream_present ||
        build_bits_result.status !=
        PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED { return 7 }

    var unsealed_bits = pireus_u250_fpga_kernel_artifact_request()
    unsealed_bits.bitstream_present = true
    unsealed_bits.bitstream_digest_present = true
    let unsealed_bits_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &unsealed_bits)
    if unsealed_bits_result.valid || !unsealed_bits_result.bitstream_present ||
        unsealed_bits_result.status !=
        PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED { return 8 }

    var digest_only = pireus_u250_fpga_kernel_artifact_request()
    digest_only.bitstream_digest_present = true
    let digest_only_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &digest_only)
    if digest_only_result.valid || !digest_only_result.bitstream_digest_present ||
        digest_only_result.status !=
        PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED { return 23 }

    var receipt_without_ingestor = pireus_u250_fpga_kernel_artifact_request()
    receipt_without_ingestor.material_receipt_present = true
    let receipt_without_ingestor_result =
        pireus_u250_fpga_kernel_artifact_project(
            &engine, &receipt_without_ingestor)
    if receipt_without_ingestor_result.valid ||
        !receipt_without_ingestor_result.material_refused ||
        receipt_without_ingestor_result.status !=
        PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED { return 24 }

    var execution_without_receipt = pireus_u250_fpga_kernel_artifact_request()
    execution_without_receipt.kernel_execution_observed = true
    let execution_without_receipt_result =
        pireus_u250_fpga_kernel_artifact_project(
            &engine, &execution_without_receipt)
    if execution_without_receipt_result.valid ||
        !execution_without_receipt_result.kernel_execution_observed ||
        execution_without_receipt_result.status !=
        PIREUS_U250_KERNEL_STATUS_MATERIAL_REFUSED { return 25 }

    var python = pireus_u250_fpga_kernel_artifact_request()
    python.producer_language = PIREUS_U250_LANGUAGE_PYTHON
    python.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let python_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &python)
    if python_result.valid || !python_result.authority_refused ||
        python_result.status !=
        PIREUS_U250_KERNEL_STATUS_AUTHORITY_REFUSED { return 9 }

    var rust = pireus_u250_fpga_kernel_artifact_request()
    rust.producer_language = PIREUS_U250_LANGUAGE_RUST
    rust.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let rust_result = pireus_u250_fpga_kernel_artifact_project(&engine, &rust)
    if rust_result.valid || !rust_result.authority_refused ||
        rust_result.status !=
        PIREUS_U250_KERNEL_STATUS_AUTHORITY_REFUSED { return 10 }

    var cpp = pireus_u250_fpga_kernel_artifact_request()
    cpp.producer_language = PIREUS_U250_LANGUAGE_CPP
    cpp.producer_role = PIREUS_U250_ROLE_MATERIAL_PARITY
    let cpp_result = pireus_u250_fpga_kernel_artifact_project(&engine, &cpp)
    if cpp_result.valid || !cpp_result.authority_refused ||
        cpp_result.status !=
        PIREUS_U250_KERNEL_STATUS_AUTHORITY_REFUSED { return 11 }

    var llm = pireus_u250_fpga_kernel_artifact_request()
    llm.producer_language = PIREUS_U250_LANGUAGE_EXTERNAL_LLM
    llm.producer_role = PIREUS_U250_ROLE_REVIEW_ONLY
    let llm_result = pireus_u250_fpga_kernel_artifact_project(&engine, &llm)
    if llm_result.valid || !llm_result.authority_refused ||
        llm_result.status !=
        PIREUS_U250_KERNEL_STATUS_AUTHORITY_REFUSED { return 12 }

    var legacy_python = pireus_u250_fpga_kernel_artifact_request()
    legacy_python.legacy_python_golden_promoted = true
    let legacy_python_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &legacy_python)
    if legacy_python_result.valid || !legacy_python_result.authority_refused ||
        legacy_python_result.status !=
        PIREUS_U250_KERNEL_STATUS_AUTHORITY_REFUSED { return 13 }

    var xrt_isa = pireus_u250_fpga_kernel_artifact_request()
    xrt_isa.xrt_as_isa = true
    let xrt_isa_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &xrt_isa)
    if xrt_isa_result.valid || !xrt_isa_result.capability_refused ||
        xrt_isa_result.status !=
        PIREUS_U250_KERNEL_STATUS_CAPABILITY_REFUSED { return 14 }

    var operation = pireus_u250_fpga_kernel_artifact_request()
    operation.artifact_as_operation = true
    operation.operation_capability_count = 1
    let operation_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &operation)
    if operation_result.valid || operation_result.operation_capability_count != 1 ||
        operation_result.status !=
        PIREUS_U250_KERNEL_STATUS_CAPABILITY_REFUSED { return 15 }

    var correctness = pireus_u250_fpga_kernel_artifact_request()
    correctness.kernel_correctness_requested = true
    let correctness_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &correctness)
    if correctness_result.valid || !correctness_result.kernel_correctness_present ||
        correctness_result.status !=
        PIREUS_U250_KERNEL_STATUS_CAPABILITY_REFUSED { return 16 }

    var lowering = pireus_u250_fpga_kernel_artifact_request()
    lowering.lowering_requested = true
    let lowering_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &lowering)
    if lowering_result.valid || lowering_result.lowering_authorized ||
        lowering_result.status !=
        PIREUS_U250_KERNEL_STATUS_CAPABILITY_REFUSED { return 17 }

    var performance = pireus_u250_fpga_kernel_artifact_request()
    performance.performance_present = true
    let performance_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &performance)
    if performance_result.valid || !performance_result.performance_present ||
        performance_result.status !=
        PIREUS_U250_KERNEL_STATUS_CAPABILITY_REFUSED { return 18 }

    var parity = pireus_u250_fpga_kernel_artifact_request()
    parity.semantics_frozen = true
    parity.parity_open_requested = true
    let parity_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &parity)
    if parity_result.valid || parity_result.artifact_parity_open ||
        parity_result.status !=
        PIREUS_U250_KERNEL_STATUS_PARITY_REFUSED { return 19 }

    var abi_parity = pireus_u250_fpga_kernel_artifact_request()
    abi_parity.abi_parity_requested = true
    let abi_parity_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &abi_parity)
    if abi_parity_result.valid || abi_parity_result.abi_parity_open ||
        abi_parity_result.status !=
        PIREUS_U250_KERNEL_STATUS_PARITY_REFUSED { return 20 }

    var claim = pireus_u250_fpga_kernel_artifact_request()
    claim.claim_ready_requested = true
    let claim_result = pireus_u250_fpga_kernel_artifact_project(
        &engine, &claim)
    if claim_result.valid || claim_result.claim_ready || claim_result.status !=
        PIREUS_U250_KERNEL_STATUS_CLAIM_REFUSED { return 21 }

    let bad_material = pireus_u250_material_ingest_files(get_arg(0), get_arg(2))
    let bad_engine = pireus_u250_execution_engine_project(
        &bad_material, &engine_request)
    let bad_parent_result = pireus_u250_fpga_kernel_artifact_project(
        &bad_engine, &canonical)
    if bad_parent_result.valid || bad_parent_result.parent_engine_known ||
        bad_parent_result.status !=
        PIREUS_U250_KERNEL_STATUS_PARENT_REFUSED { return 22 }

    print("PIREUS_U250_FPGA_KERNEL_ARTIFACT_TEST_PASS status=BLUEPRINT_ONLY kernel=krnl_san_scan abi_arguments=8 input_buffers=2 scalar_inputs=3 output_buffers=3 m_axi=5 s_axilite=3 bits_edges=0 isa_edges=0 operation_edges=0 outline=REFUSED source_implies_bits=REFUSED build_implies_bits=REFUSED unsealed_bits=REFUSED digest_without_bits=REFUSED receipt_without_ingestor=REFUSED execution_without_receipt=REFUSED python_authority=REFUSED rust_authority=REFUSED cpp_authority=REFUSED llm_authority=REFUSED legacy_python_golden=REFUSED xrt_as_isa=REFUSED artifact_as_operation=REFUSED correctness=REFUSED lowering=REFUSED performance=REFUSED parity_without_receipt=REFUSED abi_parity_without_receipt=REFUSED claim_ready=REFUSED parent_tamper=REFUSED\n")
    0
}
