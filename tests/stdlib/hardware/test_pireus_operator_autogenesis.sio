//@ run-pass

use hardware::pireus::operator_autogenesis::{
    PIREUS_OAG_OK,
    pireus_operator_autogenesis_request,
    pireus_operator_autogenesis_parent_paths,
    pireus_operator_autogenesis_execute,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request = pireus_operator_autogenesis_request()
    let paths = pireus_operator_autogenesis_parent_paths()
    let summary = pireus_operator_autogenesis_execute(&request, &paths, false)
    var failures = summary.structural_failures
    if !summary.valid || summary.error != PIREUS_OAG_OK ||
        summary.failure_groups != 0 || summary.generated <= 0 ||
        summary.admitted <= 0 ||
        summary.negative_failures != 0 || !summary.frozen_match ||
        summary.frozen_mismatch_code != 0 || summary.claim_ready {
        failures = failures + 1
    }
    print("pireus operator autogenesis structural failures: ")
    print_int(failures)
    print("\n")
    if failures == 0 { 0 } else { 1 }
}
