//@ run-pass
//! Structural test for the first, still-unfrozen Sounio bilinear census.

use hardware::pireus::operator_genesis_bilinear::{
    PIREUS_BILINEAR_OK,
    PIREUS_BILINEAR_RAW_COUNT,
    PIREUS_BILINEAR_QUADRATIC_COUNT,
    PIREUS_BILINEAR_BUCKET_SIZE,
    PIREUS_BILINEAR_GL4_COUNT,
    PIREUS_BILINEAR_ACTION_COUNT,
    pireus_operator_genesis_bilinear_request,
    pireus_operator_genesis_bilinear_evaluate,
    pireus_bilinear_digest_nonzero,
    pireus_operator_genesis_bilinear_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_genesis_bilinear_request()
    let result = pireus_operator_genesis_bilinear_evaluate(&request)
    if !result.valid || result.error != PIREUS_BILINEAR_OK ||
        result.failures != 0 ||
        !pireus_operator_genesis_bilinear_matches_frozen_semantics(&result) {
        return 1
    }
    if result.grammar.matrices_scanned != PIREUS_BILINEAR_RAW_COUNT ||
        result.grammar.quadratic_codes != PIREUS_BILINEAR_QUADRATIC_COUNT ||
        result.grammar.expected_bucket_size != PIREUS_BILINEAR_BUCKET_SIZE ||
        result.grammar.minimum_bucket_size != PIREUS_BILINEAR_BUCKET_SIZE ||
        result.grammar.maximum_bucket_size != PIREUS_BILINEAR_BUCKET_SIZE ||
        result.grammar.bucket_failures != 0 ||
        result.grammar.reconstruction_failures != 0 ||
        result.grammar.gauge_fiber_checks != PIREUS_BILINEAR_RAW_COUNT ||
        result.grammar.gauge_fiber_failures != 0 ||
        result.grammar.cocycle_failures != 0 || !result.grammar.complete {
        return 2
    }
    if result.group.matrix_count != PIREUS_BILINEAR_GL4_COUNT ||
        result.group.bfs_count != PIREUS_BILINEAR_GL4_COUNT ||
        result.group.set_mismatches != 0 ||
        result.group.bfs_noninvertible != 0 || result.group.bfs_overflow ||
        !result.group.identity_present || !result.group.sorted_unique ||
        result.group.actions_considered != PIREUS_BILINEAR_ACTION_COUNT ||
        !result.group.complete { return 3 }
    if !result.stabilizer.complete ||
        result.stabilizer.actions_considered != PIREUS_BILINEAR_ACTION_COUNT ||
        result.stabilizer.admitted_actions <= 0 ||
        result.stabilizer.admitted_actions !=
            result.stabilizer.admitted_no_swap +
                result.stabilizer.admitted_swap ||
        result.stabilizer.inverse_admission_failures != 0 ||
        result.stabilizer.affine_inverse_failures != 0 { return 4 }
    if !result.classes.complete || result.classes.class_count <= 0 ||
        result.classes.class_count > PIREUS_BILINEAR_QUADRATIC_COUNT ||
        result.classes.quadratic_total != PIREUS_BILINEAR_QUADRATIC_COUNT ||
        result.classes.raw_total != PIREUS_BILINEAR_RAW_COUNT ||
        result.classes.signature_consistency_failures != 0 ||
        result.classes.associator_base_failures != 0 ||
        result.classes.corpus_incidence_failures != 0 { return 5 }
    var quadratic_total: i64 = 0
    var raw_total: i64 = 0
    var class_id: i64 = 0
    while class_id < result.classes.class_count {
        if result.classes.class_quadratic_sizes[class_id] <= 0 ||
            result.classes.class_raw_sizes[class_id] !=
                result.classes.class_quadratic_sizes[class_id] *
                    PIREUS_BILINEAR_BUCKET_SIZE { return 6 }
        quadratic_total = quadratic_total +
            result.classes.class_quadratic_sizes[class_id]
        raw_total = raw_total + result.classes.class_raw_sizes[class_id]
        class_id = class_id + 1
    }
    if quadratic_total != PIREUS_BILINEAR_QUADRATIC_COUNT ||
        raw_total != PIREUS_BILINEAR_RAW_COUNT { return 7 }
    if !result.corpus.complete || result.corpus.incidence_failures != 0 ||
        result.corpus.action_checks != 3 * PIREUS_BILINEAR_ACTION_COUNT {
        return 8
    }
    if !result.selected.present || result.selected.class_id < 0 ||
        result.selected.class_id >= result.classes.class_count ||
        result.selected.quadratic_code < 0 ||
        result.selected.quadratic_code >= PIREUS_BILINEAR_QUADRATIC_COUNT ||
        result.selected.bilinear_matrix < 0 ||
        result.selected.bilinear_matrix >= PIREUS_BILINEAR_RAW_COUNT ||
        result.selected.represented_in_v1 ||
        result.selected.equivalent_to_corpus || !result.witness.present {
        return 9
    }
    if !result.receipt.expanded_bilinear_grammar_exhausted ||
        !result.receipt.bilinear_gauge_quotient_exact ||
        !result.receipt.declared_family_equivalence_exact ||
        !result.receipt.corpus_incidence_exact ||
        !result.receipt.relative_semantic_novelty ||
        !result.receipt.relative_grammar_extension_novelty ||
        result.receipt.relative_algebraic_novelty ||
        result.receipt.algebra_isomorphism_complete ||
        result.receipt.all_sign_tables_exhausted ||
        result.receipt.orbit_hamming_distance ||
        result.receipt.global_novelty || result.receipt.claim_ready {
        return 10
    }
    if result.negatives.passed != result.negatives.total ||
        result.negatives.total != 21 || !result.negatives.python_oracle ||
        !result.negatives.rust_oracle || !result.negatives.cpp_authority ||
        !result.negatives.llm_authority ||
        !result.negatives.parity_prefreeze ||
        !result.negatives.incomplete_grammar ||
        !result.negatives.incomplete_quotient ||
        !result.negatives.incomplete_stabilizer ||
        !result.negatives.incomplete_corpus ||
        !result.negatives.orbit_hamming_promotion ||
        !result.negatives.algebraic_promotion ||
        !result.negatives.invalid_waiver { return 11 }
    if !pireus_bilinear_digest_nonzero(&result.grammar_digest) ||
        !pireus_bilinear_digest_nonzero(&result.quotient_digest) ||
        !pireus_bilinear_digest_nonzero(&result.matrix_digest) ||
        !pireus_bilinear_digest_nonzero(&result.stabilizer_digest) ||
        !pireus_bilinear_digest_nonzero(&result.partition_digest) ||
        !pireus_bilinear_digest_nonzero(&result.corpus_digest) ||
        !pireus_bilinear_digest_nonzero(&result.search_digest) ||
        !pireus_bilinear_digest_nonzero(&result.selected_digest) ||
        !pireus_bilinear_digest_nonzero(&result.receipt_digest) { return 12 }
    print("PIREUS_OPERATOR_GENESIS_BILINEAR_EXECUTABLE_OK\n")
    0
}
