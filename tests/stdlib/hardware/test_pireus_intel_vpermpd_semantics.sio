//@ run-pass
use hardware::pireus::intel_vpermpd_semantics::{
    PIREUS_INTEL_PDF_OK,
    pireus_intel_vpermpd_evaluate,
    pireus_intel_vpermpd_select_lane,
    pireus_intel_vpermpd_imm8_supports_xor,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 {
        print("PIREUS_INTEL_VPERMPD_TEST_REQUIRES_PINNED_PDF_AND_XED\n")
        return 0
    }
    let result = pireus_intel_vpermpd_evaluate(get_arg(0), get_arg(1))
    if !result.valid || result.error != PIREUS_INTEL_PDF_OK { return 1 }
    if !result.parent_valid ||
        !result.selector_semantics_receipt_present { return 2 }
    if result.pdf.description_page_matches != 1 ||
        result.pdf.vector_form_matches != 1 ||
        result.pdf.description_selector_rule_matches != 1 ||
        result.pdf.operation_page_matches != 1 ||
        result.pdf.operation_vector_form_matches != 1 ||
        result.pdf.operation_selector_cells != 8 { return 3 }
    if result.pdf.stream_markers != 2034 ||
        result.pdf.flate_streams != 2032 ||
        result.pdf.decoded_flate_streams != 2031 ||
        result.pdf.oversized_flate_outputs != 1 ||
        !result.pdf.oversized_output_xref ||
        result.pdf.oversized_output_content_candidate ||
        result.pdf.flate_decode_failures != 0 { return 12 }
    if result.vector_bits != 512 || result.element_bits != 64 ||
        result.index_element_bits != 64 || result.selector_bits != 3 ||
        result.selector_mask != 7 || result.source_lanes != 8 { return 4 }
    if pireus_intel_vpermpd_select_lane(0) != 0 ||
        pireus_intel_vpermpd_select_lane(7) != 7 ||
        pireus_intel_vpermpd_select_lane(8) != 0 ||
        pireus_intel_vpermpd_select_lane(15) != 7 { return 5 }
    if result.xor_selector_cells != 256 ||
        result.xor_selector_matches != 256 ||
        result.xor_selector_failures != 0 ||
        result.abstract_form_applications != 32 ||
        !result.vector_control_complete { return 6 }
    if !pireus_intel_vpermpd_imm8_supports_xor(0) ||
        !pireus_intel_vpermpd_imm8_supports_xor(3) ||
        pireus_intel_vpermpd_imm8_supports_xor(4) ||
        pireus_intel_vpermpd_imm8_supports_xor(7) ||
        pireus_intel_vpermpd_imm8_supports_xor(8) { return 7 }
    if result.imm8_patterns_tested != 8 ||
        result.imm8_patterns_supported != 4 ||
        result.imm8_patterns_refused != 4 || result.imm8_complete { return 8 }
    if !result.one_source_form_sufficient ||
        result.two_source_form_required ||
        !result.instruction_match_authorized { return 9 }
    if result.material_observation_count != 0 ||
        result.lowering_count != 0 || result.cost_record_count != 0 ||
        result.parity_open || result.claim_ready { return 10 }
    if result.negative_witnesses_passed != 18 ||
        result.negative_witnesses_total != 18 ||
        result.failures != 0 { return 11 }
    print("PIREUS_INTEL_VPERMPD_EXECUTABLE_OK\n")
    0
}
