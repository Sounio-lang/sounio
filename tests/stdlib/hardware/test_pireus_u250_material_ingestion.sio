//@ run-pass

use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
    pireus_u250_material_ingestion_matches_expected,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if arg_count() != 3 {
        print("usage: test_pireus_u250_material_ingestion <raw> <receipt> <tampered>\n")
        return 2
    }
    let accepted = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let bad_receipt = pireus_u250_material_ingest_files(
        get_arg(0), get_arg(2))
    let bad_probe = pireus_u250_material_ingest_files(
        get_arg(2), get_arg(1))
    if !pireus_u250_material_ingestion_matches_expected(&accepted) {
        return 1
    }
    if bad_receipt.valid || bad_receipt.classification_allowed ||
        bad_receipt.admitted_card_count != 0 || bad_receipt.parity_open ||
        bad_receipt.claim_ready { return 2 }
    if bad_probe.valid || bad_probe.classification_allowed ||
        bad_probe.admitted_card_count != 0 || bad_probe.parity_open ||
        bad_probe.claim_ready { return 3 }
    print("PIREUS_U250_MATERIAL_INGESTION_TEST_PASS sealed=1 status=INVENTORY_PARTIAL declared=2 discovered=1 admitted=1 missing=1 second_slot=UNRESOLVED tampered_receipt=REFUSED tampered_probe=REFUSED cost_present=0 speedup_present=0 kernel_correctness_present=0 claim_ready=0\n")
    0
}
