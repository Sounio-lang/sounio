//@ run-pass
//!
//! Structural, result-agnostic test for Quotient Novelty Forge v5.

use hardware::pireus::quotient_novelty_forge::{
    PIREUS_QUOTIENT_OK,
    PIREUS_QUOTIENT_DIMENSION,
    PIREUS_QUOTIENT_CHILD_COUNT,
    PIREUS_QUOTIENT_CELL_COUNT,
    PIREUS_QUOTIENT_MATRIX_ENCODINGS,
    PIREUS_QUOTIENT_GL4_COUNT,
    PIREUS_QUOTIENT_ACTION_COUNT,
    PIREUS_QUOTIENT_GAUGE_BITS,
    PIREUS_QUOTIENT_GAUGE_WORD_COUNT,
    PIREUS_QUOTIENT_PROFILE_COUNT,
    PIREUS_QUOTIENT_RELATION_CELLS,
    PIREUS_QUOTIENT_ALL_RELATION_CELLS,
    pireus_quotient_novelty_request,
    pireus_quotient_novelty_evaluate,
    pireus_quotient_digest_nonzero,
    pireus_quotient_novelty_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_quotient_novelty_request()
    let result = pireus_quotient_novelty_evaluate(&request)
    if !result.valid || result.error != PIREUS_QUOTIENT_OK ||
        result.failures != 0 ||
        !pireus_quotient_novelty_matches_frozen_semantics(&result) {
        return 1
    }
    if !result.lineage.complete || !result.lineage.parent_live_match ||
        !result.lineage.parent_digest_match ||
        !result.lineage.parent_scope_match || !result.parent.complete ||
        result.parent.reconstruction_checks !=
            PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CELL_COUNT ||
        result.parent.reconstruction_failures != 0 ||
        result.parent.sign_range_failures != 0 { return 2 }
    if !result.normalizer.complete ||
        result.normalizer.gauge_bits != PIREUS_QUOTIENT_GAUGE_BITS ||
        result.normalizer.canonical_words !=
            PIREUS_QUOTIENT_GAUGE_WORD_COUNT ||
        result.normalizer.pivot_checks != PIREUS_QUOTIENT_GAUGE_BITS *
            PIREUS_QUOTIENT_GAUGE_BITS ||
        result.normalizer.pivot_failures != 0 ||
        result.normalizer.roundtrip_words !=
            PIREUS_QUOTIENT_GAUGE_WORD_COUNT ||
        result.normalizer.roundtrip_cell_checks !=
            PIREUS_QUOTIENT_GAUGE_WORD_COUNT * PIREUS_QUOTIENT_CELL_COUNT ||
        result.normalizer.roundtrip_failures != 0 ||
        result.normalizer.unique_failures != 0 { return 3 }
    if !result.actions.complete ||
        result.actions.matrix_encodings_scanned !=
            PIREUS_QUOTIENT_MATRIX_ENCODINGS ||
        result.actions.invertible_matrices != PIREUS_QUOTIENT_GL4_COUNT ||
        result.actions.actions_considered != PIREUS_QUOTIENT_ACTION_COUNT ||
        result.actions.admitted_actions <= 0 ||
        result.actions.admitted_actions !=
            result.actions.admitted_no_swap + result.actions.admitted_swap ||
        !result.actions.identity_present ||
        result.actions.identity_vector_checks !=
            PIREUS_QUOTIENT_DIMENSION ||
        result.actions.identity_vector_failures != 0 ||
        result.actions.action_code_checks !=
            result.actions.admitted_actions ||
        result.actions.action_code_failures != 0 ||
        result.actions.parent_cell_checks !=
            result.actions.admitted_actions * PIREUS_QUOTIENT_CELL_COUNT ||
        result.actions.parent_replay_failures != 0 ||
        result.actions.inverse_checks != result.actions.admitted_actions ||
        result.actions.inverse_failures != 0 ||
        result.actions.closure_checks != result.actions.admitted_actions *
            result.actions.admitted_actions ||
        result.actions.closure_failures != 0 ||
        result.actions.composition_vector_checks !=
            result.actions.admitted_actions *
                result.actions.admitted_actions *
                PIREUS_QUOTIENT_DIMENSION ||
        result.actions.composition_vector_failures != 0 ||
        result.actions.gauge_equivariance_checks !=
            result.actions.admitted_actions * PIREUS_QUOTIENT_GAUGE_BITS *
                PIREUS_QUOTIENT_CELL_COUNT ||
        result.actions.gauge_equivariance_failures != 0 { return 4 }
    if !result.atlas.complete ||
        result.atlas.q0_pair_checks != PIREUS_QUOTIENT_RELATION_CELLS ||
        result.atlas.q1_pair_checks != PIREUS_QUOTIENT_RELATION_CELLS ||
        result.atlas.q2_action_child_checks !=
            result.actions.admitted_actions * PIREUS_QUOTIENT_CHILD_COUNT ||
        result.atlas.q2_target_checks !=
            result.actions.admitted_actions *
                PIREUS_QUOTIENT_RELATION_CELLS ||
        result.atlas.reflexive_checks != PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT ||
        result.atlas.reflexive_failures != 0 ||
        result.atlas.symmetric_checks !=
            PIREUS_QUOTIENT_ALL_RELATION_CELLS ||
        result.atlas.symmetric_failures != 0 ||
        result.atlas.transitive_failures != 0 ||
        result.atlas.refinement_checks !=
            2 * PIREUS_QUOTIENT_RELATION_CELLS ||
        result.atlas.refinement_failures != 0 ||
        result.atlas.partition_checks != PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT ||
        result.atlas.partition_failures != 0 ||
        result.atlas.witness_cell_checks != PIREUS_QUOTIENT_PROFILE_COUNT *
            PIREUS_QUOTIENT_CHILD_COUNT * PIREUS_QUOTIENT_CELL_COUNT ||
        result.atlas.witness_failures != 0 ||
        result.atlas.separation_failures != 0 { return 5 }

    var profile: i64 = 0
    while profile < PIREUS_QUOTIENT_PROFILE_COUNT {
        if result.atlas.class_counts[profile] <= 0 ||
            result.atlas.class_counts[profile] >
                PIREUS_QUOTIENT_CHILD_COUNT ||
            result.atlas.minimum_class_sizes[profile] <= 0 ||
            result.atlas.maximum_class_sizes[profile] <
                result.atlas.minimum_class_sizes[profile] ||
            result.atlas.class_size_sums[profile] !=
                PIREUS_QUOTIENT_CHILD_COUNT {
            return 6
        }
        var child: i64 = 0
        while child < PIREUS_QUOTIENT_CHILD_COUNT {
            let slot = profile * PIREUS_QUOTIENT_CHILD_COUNT + child
            if result.atlas.child_class_ids[slot] < 0 ||
                result.atlas.child_class_ids[slot] >=
                    result.atlas.class_counts[profile] ||
                result.atlas.child_representatives[slot] < 0 ||
                result.atlas.child_representatives[slot] >=
                    PIREUS_QUOTIENT_CHILD_COUNT ||
                result.atlas.witness_matrices[slot] <= 0 ||
                result.atlas.witness_swaps[slot] < 0 ||
                result.atlas.witness_swaps[slot] > 1 ||
                result.atlas.witness_gauges[slot] < 0 ||
                result.atlas.witness_gauges[slot] >=
                    PIREUS_QUOTIENT_GAUGE_WORD_COUNT {
                return 7
            }
            child = child + 1
        }
        profile = profile + 1
    }

    let receipt = &result.receipt
    if !receipt.parent_lineage_bound ||
        !receipt.parent_population_recovered ||
        !receipt.declared_action_universe_complete ||
        !receipt.gauge_normalizer_exact ||
        !receipt.parent_gauge_stabilizer_complete ||
        !receipt.extensional_quotient_exact ||
        !receipt.basis_sign_gauge_quotient_exact ||
        !receipt.parent_linear_swap_gauge_quotient_exact ||
        !receipt.canonical_novelty_atlas_complete ||
        !receipt.parent_relative_operator_novelty_typed ||
        !receipt.no_child_selected ||
        !receipt.target_envelopes_unresolved ||
        receipt.global_linear_swap_gauge_quotient_complete ||
        receipt.nonlinear_permutation_quotient_complete ||
        receipt.isotopy_quotient_complete ||
        receipt.algebra_isomorphism_complete ||
        receipt.relative_algebraic_novelty || receipt.algorithmic_novelty ||
        receipt.material_novelty || receipt.scientific_novelty ||
        receipt.global_novelty || receipt.historical_novelty ||
        receipt.priority_claim || receipt.external_prior_art_complete ||
        receipt.semantics_frozen || receipt.formal_parity_open ||
        receipt.effect_parity_open || receipt.material_parity_open ||
        receipt.target_lowering_admitted || receipt.target_cost_admitted ||
        receipt.target_performance_admitted || receipt.claim_ready {
        return 8
    }
    if result.negatives.passed != result.negatives.total ||
        result.negatives.total != 31 || !result.negatives.python_oracle ||
        !result.negatives.rust_oracle || !result.negatives.cpp_authority ||
        !result.negatives.llm_authority ||
        !result.negatives.result_injection ||
        !result.negatives.global_quotient_promotion ||
        !result.negatives.isomorphism_promotion ||
        !result.negatives.parity_prefreeze ||
        !result.negatives.claim_ready_promotion ||
        !result.negatives.invalid_waiver { return 9 }
    if !pireus_quotient_digest_nonzero(&result.lineage_digest) ||
        !pireus_quotient_digest_nonzero(&result.normalizer_digest) ||
        !pireus_quotient_digest_nonzero(&result.action_digest) ||
        !pireus_quotient_digest_nonzero(&result.atlas_digest) ||
        !pireus_quotient_digest_nonzero(&result.receipt_digest) ||
        !pireus_quotient_digest_nonzero(&result.forge_digest) { return 10 }

    print("PIREUS_QUOTIENT_NOVELTY_FORGE_EXECUTABLE_OK\n")
    0
}
