//@ run-pass
use hardware::pireus::xor_selector_material_admission::{
    PIREUS_XOR_ADMISSION_OK,
    PIREUS_XOR_ADMISSION_NODE_ADMITTED,
    PIREUS_XOR_ADMISSION_NODE_UNRESOLVED,
    PireusXorMaterialFilePaths,
    pireus_xor_selector_material_admission_evaluate,
    pireus_xor_selector_material_admission_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 8 {
        print("PIREUS_XOR_SELECTOR_ADMISSION_TEST_REQUIRES_PINNED_PDF_AND_XED\n")
        return 2
    }
    let material_paths = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(2),
        darwin_evidence: get_arg(3),
        apple_receipt: get_arg(4),
        apple_evidence: get_arg(5),
        dgx_receipt: get_arg(6),
        dgx_evidence: get_arg(7),
    }
    let result = pireus_xor_selector_material_admission_evaluate(
        get_arg(0), get_arg(1), &material_paths)
    if !result.valid || result.error != PIREUS_XOR_ADMISSION_OK ||
        result.failures != 0 ||
        !pireus_xor_selector_material_admission_matches_frozen_semantics(
            &result) {
        return 1
    }
    if !result.material_files_valid ||
        result.material_file_match_count != 6 ||
        result.darwin.binding_error != 0 ||
        result.apple.binding_error != 0 || result.dgx.binding_error != 0 ||
        result.darwin.admitted_node_count != 5 ||
        !result.darwin.whole_operation_covered ||
        result.apple.admitted_node_count != 1 ||
        result.dgx.admitted_node_count != 1 ||
        result.apple.whole_operation_covered ||
        result.dgx.whole_operation_covered {
        return 2
    }
    if result.darwin.node_status[0] != PIREUS_XOR_ADMISSION_NODE_ADMITTED ||
        result.apple.node_status[0] != PIREUS_XOR_ADMISSION_NODE_ADMITTED ||
        result.dgx.node_status[0] != PIREUS_XOR_ADMISSION_NODE_ADMITTED {
        return 3
    }
    var node: i64 = 1
    while node < 5 {
        if result.apple.node_status[node] !=
                PIREUS_XOR_ADMISSION_NODE_UNRESOLVED ||
            result.dgx.node_status[node] !=
                PIREUS_XOR_ADMISSION_NODE_UNRESOLVED {
            return 4
        }
        node = node + 1
    }
    if result.unnamed_node_claim_count != 1 ||
        result.encoding_difference_count != 1 ||
        result.negatives.passed != 22 || result.negatives.total != 22 ||
        result.cost_record_count != 0 || result.cross_isa_equivalence ||
        result.transform_authorized || result.parity_open || result.claim_ready {
        return 5
    }
    print("PIREUS_XOR_SELECTOR_MATERIAL_ADMISSION_EXECUTABLE_OK\n")
    0
}
