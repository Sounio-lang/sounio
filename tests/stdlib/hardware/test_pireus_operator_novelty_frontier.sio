//@ run-pass

use hardware::pireus::operator_novelty_frontier::{
    PIREUS_ONF_OK,
    PIREUS_ONF_REPRESENTATIVES,
    PIREUS_ONF_GRAMMAR_CARDINALITY,
    pireus_operator_novelty_frontier_request,
    pireus_operator_novelty_frontier_paths,
    pireus_operator_novelty_frontier_execute,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request = pireus_operator_novelty_frontier_request()
    let paths = pireus_operator_novelty_frontier_paths()
    let summary = pireus_operator_novelty_frontier_execute(
        &request, &paths, false)
    var failures = summary.structural_failures + summary.negative_failures
    if !summary.valid || summary.error != PIREUS_ONF_OK ||
        summary.generated != PIREUS_ONF_GRAMMAR_CARDINALITY ||
        summary.typed_admitted + summary.typed_rejected != summary.generated ||
        summary.atlas_collision_candidates + summary.n2_relative_novelty !=
            summary.typed_admitted ||
        summary.separators + summary.atlas_collision_edges !=
            summary.typed_admitted * PIREUS_ONF_REPRESENTATIVES ||
        summary.quotient_singletons + 2 * summary.quotient_pairs !=
            summary.typed_admitted ||
        summary.quotient_classes !=
            summary.quotient_singletons + summary.quotient_pairs ||
        summary.quotient_in_grammar_images !=
            summary.quotient_fixed + 2 * summary.quotient_pairs ||
        summary.codec_checks <= 0 || summary.unit_boundary_checks <= 0 ||
        summary.direct_canary_checks <= 0 ||
        !summary.bounded_internal_frontier_complete ||
        summary.candidate_selected || summary.n3_novelty ||
        summary.n4_novelty || summary.algorithmic_novelty ||
        summary.material_novelty || summary.scientific_novelty ||
        summary.historical_novelty || summary.priority_claim ||
        summary.claim_ready {
        failures = failures + 1
    }
    print("pireus operator novelty frontier structural failures: ")
    print_int(failures)
    print("\n")
    if failures == 0 { 0 } else { 1 }
}
