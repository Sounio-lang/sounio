//@ run-pass

use hardware::pireus::operator_novelty_feedback::{
    PIREUS_ONF_OK,
    PIREUS_ONF_CELL_COUNT,
    pireus_operator_novelty_feedback_request,
    pireus_operator_novelty_cd16_challenge,
    pireus_operator_novelty_feedback_evaluate,
    pireus_operator_novelty_feedback_frozen_mismatch_code,
    pireus_onf_digest_nonzero,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_novelty_feedback_request()
    let challenge = pireus_operator_novelty_cd16_challenge()
    let result = pireus_operator_novelty_feedback_evaluate(
        &request, &challenge)
    var failures: i64 = 0
    if !result.valid || result.error != PIREUS_ONF_OK ||
        result.failures != 0 {
        failures = failures + 1
    }
    if !result.lineage.complete || !result.challenge.complete ||
        !result.normalizer.complete || !result.actions.complete ||
        !result.atlas.complete {
        failures = failures + 1
    }
    if result.actions.v5_relation_failures != 0 ||
        result.atlas.pair_failures != 0 ||
        result.atlas.chosen_replay_checks != PIREUS_ONF_CELL_COUNT ||
        result.atlas.chosen_replay_failures != 0 {
        failures = failures + 1
    }
    let exclusive = (result.atlas.existing_class_bridge &&
        !result.atlas.operator_seed_generated) ||
        (!result.atlas.existing_class_bridge &&
            result.atlas.operator_seed_generated)
    if !exclusive || !result.receipt.outcome_exclusive ||
        result.receipt.existing_class_bridge !=
            result.atlas.existing_class_bridge ||
        result.receipt.operator_seed_generated !=
            result.atlas.operator_seed_generated {
        failures = failures + 1
    }
    if result.atlas.operator_seed_generated &&
        (!result.atlas.exhaustive_separation ||
            result.atlas.nonmembership_checks != result.atlas.pair_count ||
            result.atlas.nonmembership_failures != 0 ||
            result.atlas.zero_residual_hits != 0 ||
            result.atlas.best_residual_nonzero_cells <= 0) {
        failures = failures + 1
    }
    if result.atlas.existing_class_bridge &&
        (result.atlas.zero_residual_hits <= 0 ||
            result.atlas.best_residual_nonzero_cells != 0) {
        failures = failures + 1
    }
    if result.negatives.passed != result.negatives.total ||
        result.receipt.target_evidence_used ||
        result.receipt.material_evidence_used ||
        result.receipt.target_cost_used ||
        result.receipt.target_performance_used ||
        result.receipt.semantics_frozen ||
        result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open ||
        result.receipt.material_parity_open ||
        result.receipt.broad_novelty ||
        result.receipt.historical_novelty ||
        result.receipt.priority_claim || result.receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_onf_digest_nonzero(&result.lineage_digest) ||
        !pireus_onf_digest_nonzero(&result.challenge_digest) ||
        !pireus_onf_digest_nonzero(&result.normalizer_digest) ||
        !pireus_onf_digest_nonzero(&result.action_digest) ||
        !pireus_onf_digest_nonzero(&result.atlas_digest) ||
        !pireus_onf_digest_nonzero(&result.receipt_digest) ||
        !pireus_onf_digest_nonzero(&result.forge_digest) {
        failures = failures + 1
    }
    if pireus_operator_novelty_feedback_frozen_mismatch_code(&result) != 0 {
        failures = failures + 1
    }
    print("pireus operator novelty feedback structural failures: ")
    print_int(failures)
    print("\n")
    if failures == 0 { 0 } else { 1 }
}
