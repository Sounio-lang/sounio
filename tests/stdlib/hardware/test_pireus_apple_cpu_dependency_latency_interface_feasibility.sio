//@ run-pass

use hardware::pireus::xor_selector_material_admission::{
    PireusXorMaterialFilePaths,
}
use hardware::pireus::apple_cpu_dependency_latency_request::{
    PireusAppleCpuLatencyParentPaths,
}
use hardware::pireus::apple_cpu_dependency_latency_interface_feasibility::{
    PireusAppleInterfaceParentPaths,
    PIREUS_APPLE_INTERFACE_OK,
    PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT,
    PIREUS_APPLE_INTERFACE_FAMILY_COUNT,
    PIREUS_APPLE_INTERFACE_NEGATIVE_COUNT,
    PIREUS_INTERFACE_STAGE_ASSESSMENT_REQUESTED,
    PIREUS_INTERFACE_VERDICT_UNASSESSED,
    pireus_apple_interface_parent_file_matches,
    pireus_apple_cpu_dependency_latency_interface_feasibility_evaluate,
    pireus_apple_cpu_dependency_latency_interface_feasibility_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 38 { return 2 }
    let material_files = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(7), darwin_evidence: get_arg(8),
        apple_receipt: get_arg(9), apple_evidence: get_arg(10),
        dgx_receipt: get_arg(11), dgx_evidence: get_arg(12),
    }
    let request_parents = PireusAppleCpuLatencyParentPaths {
        garden: get_arg(13),
        target_cost_source: get_arg(14),
        target_cost_semantics: get_arg(15),
        target_cost_receipt: get_arg(16),
        target_cost_evidence: get_arg(17),
        material_source: get_arg(18),
        material_semantics: get_arg(19),
        material_receipt: get_arg(20),
        material_evidence: get_arg(21),
        cost_parent_garden: get_arg(22),
        cost_parent_admission_source: get_arg(23),
        cost_parent_admission_semantics: get_arg(24),
        cost_parent_admission_receipt: get_arg(25),
        cost_parent_admission_evidence: get_arg(26),
        cost_parent_engine_source: get_arg(27),
        cost_parent_engine_semantics: get_arg(28),
        cost_parent_engine_receipt: get_arg(29),
        cost_parent_operation_source: get_arg(30),
        cost_parent_operation_semantics: get_arg(31),
        cost_parent_operation_receipt: get_arg(32),
        material_parent_garden: get_arg(33),
        material_parent_apple_receipt: get_arg(34),
        material_parent_apple_evidence: get_arg(35),
        material_parent_dgx_receipt: get_arg(36),
        material_parent_dgx_evidence: get_arg(37),
    }
    let parents = PireusAppleInterfaceParentPaths {
        garden: get_arg(0), request_source: get_arg(1),
        request_semantics: get_arg(2), request_receipt: get_arg(3),
        request_evidence: get_arg(4), request_parents: request_parents,
    }
    let result =
        pireus_apple_cpu_dependency_latency_interface_feasibility_evaluate(
            get_arg(5), get_arg(6), &material_files, &parents)
    var failures: i64 = 0
    if !result.valid || result.error != PIREUS_APPLE_INTERFACE_OK ||
        result.failures != 0 || !result.parent_files_valid ||
        !result.request_parent_live ||
        !pireus_apple_cpu_dependency_latency_interface_feasibility_matches_frozen_semantics(
            &result) {
        failures = failures + 1
    }
    var i: i64 = 0
    while i < PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT {
        if !pireus_apple_interface_parent_file_matches(
            result.parent_file_match_mask, i) {
            failures = failures + 1
        }
        i = i + 1
    }
    if result.parent_file_match_count !=
            PIREUS_APPLE_INTERFACE_PARENT_FILE_COUNT ||
        !result.requirement_valid || !result.manifest_valid ||
        !result.assessment_valid || !result.observations_valid ||
        !result.decision_valid || !result.ontology_valid ||
        result.ontology_triple_count <= 0 {
        failures = failures + 1
    }
    if result.manifest.family_count != PIREUS_APPLE_INTERFACE_FAMILY_COUNT ||
        result.manifest.closed ||
        result.assessment.material_candidate_count != 0 ||
        result.observations.evidence_received ||
        result.observations.classification_requested ||
        result.observations.candidate_manifest_ref != 0 ||
        result.observations.declared_candidate_count != 0 ||
        result.observations.manifest_closed ||
        result.observations.transport_failure {
        failures = failures + 1
    }
    if result.decision.stage !=
            PIREUS_INTERFACE_STAGE_ASSESSMENT_REQUESTED ||
        result.decision.verdict != PIREUS_INTERFACE_VERDICT_UNASSESSED ||
        result.decision.candidate_count != 0 ||
        result.decision.complete_terminal_count != 0 ||
        result.decision.feasible_count != 0 ||
        result.decision.refusal_count != 0 ||
        result.decision.cycle_ineligible_count != 0 ||
        result.decision.feasible_candidate_id != 0 ||
        result.decision.manifest_closed {
        failures = failures + 1
    }
    if result.remote_execution || result.environment_bound ||
        result.harness_frozen || result.measurand_validated ||
        result.authorization.present || result.authorization.authorization_id != 0 ||
        result.cost.present || result.cost.sample_count != 0 ||
        result.cost.estimate_numerator != 0 ||
        result.cost.estimate_denominator != 0 ||
        result.cost.raw_result_ref != 0 || result.parity_open ||
        result.claim_ready {
        failures = failures + 1
    }
    if result.negatives.total != PIREUS_APPLE_INTERFACE_NEGATIVE_COUNT ||
        result.negatives.passed != result.negatives.total {
        failures = failures + 1
    }
    var parent_digest_nonzero = false
    var ontology_digest_nonzero = false
    var result_digest_nonzero = false
    i = 0
    while i < 8 {
        if result.parent_manifest_digest.words[i as usize] != 0 {
            parent_digest_nonzero = true
        }
        if result.ontology_digest.words[i as usize] != 0 {
            ontology_digest_nonzero = true
        }
        if result.result_digest.words[i as usize] != 0 {
            result_digest_nonzero = true
        }
        i = i + 1
    }
    if !parent_digest_nonzero || !ontology_digest_nonzero ||
        !result_digest_nonzero {
        failures = failures + 1
    }
    if failures == 0 {
        print("pireus Apple CPU interface feasibility test passed\n")
        0
    } else {
        print("pireus Apple CPU interface feasibility test failed: ")
        print_int(failures); print("\n")
        1
    }
}
