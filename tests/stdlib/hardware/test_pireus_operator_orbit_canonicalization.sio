//@ run-pass
//!
//! Matcher-free structural test for Pireus V13. It checks only Garden-fixed
//! relations and boundary negatives; it never matches a discovered class,
//! witness, attempt count, canonical table, diagnostic, probe, or digest.

use hardware::pireus::operator_orbit_canonicalization::{
    PIREUS_POC_OK,
    PIREUS_POC_MATRIX_CODES,
    PIREUS_POC_GL4_COUNT,
    PIREUS_POC_ACTIONS,
    PIREUS_POC_GAUGE_BITS,
    PIREUS_POC_GAUGE_WORDS,
    PIREUS_POC_V12_IMAGES,
    PIREUS_POC_MUTATION_REQUESTS,
    PIREUS_POC_ADMISSION_QUOTA,
    PIREUS_POC_INTERIOR,
    PIREUS_POC_CELLS,
    PIREUS_POC_NEGATIVE_CASES,
    pireus_operator_orbit_canonicalization_request,
    pireus_operator_orbit_canonicalization_run,
    pireus_poc_digest_nonzero,
    pireus_operator_orbit_canonicalization_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_orbit_canonicalization_request()
    let result = pireus_operator_orbit_canonicalization_run(&request, false)
    if !result.valid || result.error != PIREUS_POC_OK ||
        !result.cubic_parent_match || !result.v12_parent_match ||
        !result.v5_parent_match ||
        !pireus_operator_orbit_canonicalization_matches_frozen_semantics(&result) {
        return 1
    }
    if result.matrix_codes_scanned != PIREUS_POC_MATRIX_CODES ||
        result.invertible_matrices != PIREUS_POC_GL4_COUNT ||
        result.matrix_inverse_checks != PIREUS_POC_GL4_COUNT * 32 ||
        result.matrix_inverse_failures != 0 ||
        result.gauge_pivot_checks != PIREUS_POC_GAUGE_BITS *
            PIREUS_POC_GAUGE_BITS ||
        result.gauge_pivot_failures != 0 ||
        result.gauge_roundtrip_words != PIREUS_POC_GAUGE_WORDS ||
        result.gauge_roundtrip_cell_checks !=
            PIREUS_POC_GAUGE_WORDS * PIREUS_POC_CELLS ||
        result.gauge_roundtrip_failures != 0 {
        return 2
    }
    if result.baseline_images != PIREUS_POC_V12_IMAGES ||
        result.baseline_reconstruction_failures != 0 ||
        !result.baseline_digest_match || result.baseline_classes <= 0 ||
        result.baseline_classes > PIREUS_POC_V12_IMAGES {
        return 3
    }
    if result.canonicalizations !=
            result.baseline_images + result.mutation_attempts ||
        result.action_views != result.canonicalizations * PIREUS_POC_ACTIONS ||
        result.action_pivot_checks != result.action_views *
            PIREUS_POC_GAUGE_BITS ||
        result.action_pivot_failures != 0 ||
        result.canonical_replay_checks !=
            result.canonicalizations * PIREUS_POC_CELLS ||
        result.canonical_replay_failures != 0 ||
        result.canonical_replacements < result.canonicalizations ||
        result.canonical_cell_comparisons <= 0 {
        return 4
    }
    if result.mutation_attempts < PIREUS_POC_ADMISSION_QUOTA ||
        result.mutation_attempts > PIREUS_POC_MUTATION_REQUESTS ||
        result.mutation_attempts !=
            result.equivalent_collapses + result.admitted_classes ||
        result.admitted_classes != PIREUS_POC_ADMISSION_QUOTA ||
        result.mutation_checks !=
            result.mutation_attempts * PIREUS_POC_INTERIOR ||
        result.mutation_failures != 0 ||
        result.separator_certificates !=
            result.admitted_classes * result.baseline_classes +
                result.admitted_classes * (result.admitted_classes - 1) / 2 ||
        result.separator_checks < result.separator_certificates ||
        result.separator_failures != 0 {
        return 5
    }
    if result.phase_checks != PIREUS_POC_ADMISSION_QUOTA *
            (2 * PIREUS_POC_INTERIOR + 2 * PIREUS_POC_CELLS) ||
        result.phase_failures != 0 ||
        result.anf_checks !=
            PIREUS_POC_ADMISSION_QUOTA * 2 * PIREUS_POC_INTERIOR ||
        result.anf_failures != 0 ||
        result.unit_checks != PIREUS_POC_ADMISSION_QUOTA * 62 ||
        result.unit_failures != 0 ||
        result.microprogram_checks !=
            PIREUS_POC_ADMISSION_QUOTA * 2 * PIREUS_POC_CELLS ||
        result.microprogram_failures != 0 ||
        result.diagnostic_checks !=
            PIREUS_POC_ADMISSION_QUOTA * (3 * PIREUS_POC_CELLS + 4096) {
        return 6
    }
    if result.negative_cases_passed != PIREUS_POC_NEGATIVE_CASES ||
        result.negative_cases_total != PIREUS_POC_NEGATIVE_CASES ||
        !pireus_poc_digest_nonzero(&result.baseline_digest) ||
        !pireus_poc_digest_nonzero(&result.run_digest) {
        return 7
    }
    var admitted: i64 = 0
    while admitted < PIREUS_POC_ADMISSION_QUOTA {
        if result.accepted_parent_epochs[admitted] < 0 ||
            result.accepted_parent_epochs[admitted] >= 16 ||
            result.accepted_coefficients[admitted] < 0 ||
            result.accepted_coefficients[admitted] >= PIREUS_POC_INTERIOR ||
            result.accepted_matrices[admitted] < 0 ||
            result.accepted_matrices[admitted] >= PIREUS_POC_MATRIX_CODES ||
            result.accepted_swaps[admitted] < 0 ||
            result.accepted_swaps[admitted] > 1 ||
            result.accepted_gauges[admitted] < 0 ||
            result.accepted_gauges[admitted] >= PIREUS_POC_GAUGE_WORDS {
            return 8
        }
        var nonzero = false
        var word: i64 = 0
        while word < 8 {
            if result.accepted_digest_words[admitted * 8 + word] != 0 {
                nonzero = true
            }
            word = word + 1
        }
        if !nonzero { return 8 }
        admitted = admitted + 1
    }
    if !result.exact_declared_orbit_canonicalization_complete ||
        !result.bounded_relative_linear_swap_gauge_novelty ||
        result.full_2_pow_225_space_exhausted ||
        result.nonlinear_permutation_quotient_complete ||
        result.isotopy_quotient_complete ||
        result.unrestricted_algebra_isomorphism_complete ||
        result.algebraic_novelty || result.algorithmic_novelty ||
        result.material_novelty || result.performance_novelty ||
        result.scientific_novelty || result.global_novelty ||
        result.historical_novelty || result.priority_claim ||
        result.target_lowering_admitted || result.target_cost_admitted ||
        result.target_performance_admitted || result.claim_ready {
        return 9
    }
    print("PIREUS_OPERATOR_ORBIT_CANONICALIZATION_EXECUTABLE_OK\n")
    0
}
