//@ run-pass
//!
//! Structural test for the frozen Cubic Operator Forge v4.

use hardware::pireus::cubic_operator_forge::{
    PIREUS_CUBIC_FORGE_OK,
    PIREUS_CUBIC_FORGE_MUTATION_COUNT,
    PIREUS_CUBIC_FORGE_L2R1_COUNT,
    PIREUS_CUBIC_FORGE_KIND_L2R1,
    PIREUS_CUBIC_FORGE_KIND_L1R2,
    PIREUS_CUBIC_FORGE_CELL_COUNT,
    PIREUS_CUBIC_FORGE_GROUP_COUNT,
    PIREUS_CUBIC_FORGE_TARGET_COUNT,
    PIREUS_CUBIC_FORGE_OBLIGATION_COUNT,
    PIREUS_CUBIC_FORGE_BILINEAR_COUNT,
    PIREUS_CUBIC_FORGE_PAIR_COUNT,
    PIREUS_CUBIC_FORGE_EXPECTED_SUPPORT,
    pireus_cubic_forge_request,
    pireus_cubic_operator_forge_evaluate,
    pireus_cubic_forge_digest_nonzero,
    pireus_cubic_operator_forge_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_cubic_forge_request()
    let result = pireus_cubic_operator_forge_evaluate(&request)
    if !result.valid || result.error != PIREUS_CUBIC_FORGE_OK ||
        result.failures != 0 ||
        !pireus_cubic_operator_forge_matches_frozen_semantics(&result) {
        return 1
    }
    if !result.lineage.complete || !result.lineage.parent_live_match ||
        !result.lineage.parent_digest_match ||
        !result.lineage.parent_scope_match { return 2 }

    let population = &result.population
    if !population.complete ||
        population.mutation_count != PIREUS_CUBIC_FORGE_MUTATION_COUNT ||
        population.descriptor_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT ||
        population.descriptor_failures != 0 ||
        population.support_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT ||
        population.support_failures != 0 ||
        population.witness_checks != PIREUS_CUBIC_FORGE_MUTATION_COUNT ||
        population.witness_failures != 0 ||
        population.bilinear_witness_checks !=
            PIREUS_CUBIC_FORGE_MUTATION_COUNT *
                PIREUS_CUBIC_FORGE_BILINEAR_COUNT ||
        population.bilinear_witness_failures != 0 ||
        population.pairwise_checks != PIREUS_CUBIC_FORGE_PAIR_COUNT ||
        population.pairwise_failures != 0 { return 3 }

    var mutation: i64 = 0
    while mutation < PIREUS_CUBIC_FORGE_MUTATION_COUNT {
        let kind = population.kinds[mutation]
        let r = population.r_coordinates[mutation]
        let s = population.s_coordinates[mutation]
        let t = population.t_coordinates[mutation]
        if (mutation < PIREUS_CUBIC_FORGE_L2R1_COUNT &&
                (kind != PIREUS_CUBIC_FORGE_KIND_L2R1 || r >= s)) ||
            (mutation >= PIREUS_CUBIC_FORGE_L2R1_COUNT &&
                (kind != PIREUS_CUBIC_FORGE_KIND_L1R2 || s >= t)) ||
            r < 0 || r >= 4 || s < 0 || s >= 4 || t < 0 || t >= 4 ||
            population.support_counts[mutation] !=
                PIREUS_CUBIC_FORGE_EXPECTED_SUPPORT ||
            population.witness_values[mutation] != 1 ||
            population.negative_counts[mutation] < 0 ||
            population.negative_counts[mutation] >
                PIREUS_CUBIC_FORGE_CELL_COUNT ||
            population.square_negative_counts[mutation] < 0 ||
            population.square_negative_counts[mutation] > 16 ||
            population.commutator_defects[mutation] < 0 ||
            population.commutator_defects[mutation] > 256 ||
            population.associator_defects[mutation] < 0 ||
            population.associator_defects[mutation] > 4096 ||
            population.group_counts[mutation] !=
                PIREUS_CUBIC_FORGE_GROUP_COUNT ||
            population.unresolved_obligations[mutation] !=
                PIREUS_CUBIC_FORGE_TARGET_COUNT *
                    PIREUS_CUBIC_FORGE_OBLIGATION_COUNT {
            return 4
        }
        var word: i64 = 0
        var child_nonzero = false
        var lineage_nonzero = false
        while word < 8 {
            if population.child_digest_words[mutation * 8 + word] != 0 {
                child_nonzero = true
            }
            if population.child_lineage_digest_words[mutation * 8 + word] != 0 {
                lineage_nonzero = true
            }
            word = word + 1
        }
        if !child_nonzero || !lineage_nonzero { return 5 }
        mutation = mutation + 1
    }

    var cell: i64 = 0
    while cell < PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_CELL_COUNT {
        if population.sign_bits[cell] < 0 || population.sign_bits[cell] > 1 {
            return 6
        }
        cell = cell + 1
    }
    var group: i64 = 0
    while group < PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_GROUP_COUNT {
        if population.group_negative_masks[group] < 0 ||
            population.group_negative_masks[group] > 255 { return 7 }
        group = group + 1
    }
    if population.sign_range_failures != 0 ||
        population.parent_delta_failures != 0 ||
        population.semantic_cell_failures != 0 ||
        population.fixture_failures != 0 ||
        population.group_total != PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_GROUP_COUNT ||
        population.unresolved_obligation_total !=
            PIREUS_CUBIC_FORGE_MUTATION_COUNT *
            PIREUS_CUBIC_FORGE_TARGET_COUNT *
            PIREUS_CUBIC_FORGE_OBLIGATION_COUNT ||
        population.target_observations != 0 ||
        population.target_discharges != 0 ||
        population.material_receipts != 0 ||
        population.target_lowerings != 0 ||
        population.target_cost_records != 0 ||
        population.target_performance_records != 0 ||
        population.selected_child != -1 || population.ranking_present {
        return 8
    }

    let receipt = &result.receipt
    if !receipt.parent_lineage_bound ||
        !receipt.mixed_cubic_population_complete ||
        !receipt.noncocycle_witness_complete ||
        !receipt.relative_bilinear_grammar_novelty ||
        !receipt.executable_child_genomes || !receipt.immutable_lineage ||
        !receipt.no_child_selected || !receipt.target_envelopes_unresolved ||
        !receipt.declared_coordinate_scope ||
        !receipt.structural_counts_are_child_diagnostics ||
        !receipt.fixture_is_smoke_only ||
        receipt.declared_gl4_gauge_inequivalence ||
        receipt.relative_algebraic_novelty ||
        receipt.algebra_isomorphism_complete ||
        receipt.algorithmic_novelty || receipt.material_novelty ||
        receipt.scientific_novelty || receipt.global_novelty ||
        receipt.historical_novelty || receipt.priority_claim ||
        receipt.external_prior_art_complete || receipt.semantics_frozen ||
        receipt.formal_parity_open || receipt.effect_parity_open ||
        receipt.material_parity_open || receipt.target_lowering_admitted ||
        receipt.target_cost_admitted ||
        receipt.target_performance_admitted || receipt.claim_ready {
        return 9
    }
    if result.negatives.passed != result.negatives.total ||
        result.negatives.total != 35 || !result.negatives.python_oracle ||
        !result.negatives.rust_oracle || !result.negatives.cpp_authority ||
        !result.negatives.llm_authority || !result.negatives.missing_parent ||
        !result.negatives.unfrozen_parent ||
        !result.negatives.unbound_parent ||
        !result.negatives.wrong_mutation_count ||
        !result.negatives.reordered_descriptors ||
        !result.negatives.malformed_descriptor ||
        !result.negatives.pure_side_mutation ||
        !result.negatives.bilinear_equality ||
        !result.negatives.child_collision || !result.negatives.selected_child ||
        !result.negatives.ranking_objective ||
        !result.negatives.material_without_receipt ||
        !result.negatives.changed_partner ||
        !result.negatives.changed_destination ||
        !result.negatives.changed_ordinal ||
        !result.negatives.reassociated_reduction ||
        !result.negatives.fixture_proof_promotion ||
        !result.negatives.diagnostic_scope_promotion ||
        !result.negatives.parity_prefreeze ||
        !result.negatives.gl4_gauge_promotion ||
        !result.negatives.algebraic_promotion ||
        !result.negatives.claim_ready_promotion ||
        !result.negatives.invalid_waiver { return 10 }
    if !pireus_cubic_forge_digest_nonzero(&result.lineage_digest) ||
        !pireus_cubic_forge_digest_nonzero(&result.grammar_digest) ||
        !pireus_cubic_forge_digest_nonzero(&result.population_digest) ||
        !pireus_cubic_forge_digest_nonzero(&result.receipt_digest) ||
        !pireus_cubic_forge_digest_nonzero(&result.forge_digest) { return 11 }

    print("PIREUS_CUBIC_OPERATOR_FORGE_EXECUTABLE_OK\n")
    0
}
