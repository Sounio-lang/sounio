//@ run-pass

use hardware::pireus::execution_engine::{
    PIREUS_ENGINE_KIND_CPU, PIREUS_ENGINE_KIND_GPU,
}
use hardware::pireus::u250_dual_card_admission::{
    PIREUS_U250_LANGUAGE_CPP,
    PIREUS_U250_LANGUAGE_EXTERNAL_LLM,
    PIREUS_U250_LANGUAGE_PYTHON,
    PIREUS_U250_ROLE_MATERIAL_PARITY,
    PIREUS_U250_ROLE_REVIEW_ONLY,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
}
use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    PIREUS_U250_ENGINE_STATUS_PARENT_REFUSED,
    PIREUS_U250_ENGINE_STATUS_AUTHORITY_REFUSED,
    PIREUS_U250_ENGINE_STATUS_PROJECTION_REFUSED,
    PIREUS_U250_ENGINE_STATUS_CAPABILITY_REFUSED,
    PIREUS_U250_ENGINE_STATUS_PARITY_REFUSED,
    PIREUS_U250_ENGINE_STATUS_CLAIM_REFUSED,
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
    pireus_u250_execution_engine_matches_expected,
    pireus_u250_execution_engine_store,
    pireus_u250_query_observed_engines,
    pireus_u250_query_unresolved_slots,
    pireus_u250_query_memory_profiles,
    pireus_u250_query_blueprint_slots,
    pireus_u250_query_engine_isa,
    pireus_u250_query_engine_operations,
    pireus_u250_query_machine_bridge,
}
use ontology::query::{triple_store_count, sparql_result_count}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 3 { return 100 }
    let parent = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let canonical = pireus_u250_execution_engine_request()
    let result = pireus_u250_execution_engine_project(&parent, &canonical)
    if !pireus_u250_execution_engine_matches_expected(&result) { return 1 }

    var store = pireus_u250_execution_engine_store(&result)
    let observed = pireus_u250_query_observed_engines(&store)
    let unresolved = pireus_u250_query_unresolved_slots(&store)
    let memory = pireus_u250_query_memory_profiles(&store)
    let slots = pireus_u250_query_blueprint_slots(&store)
    let isa = pireus_u250_query_engine_isa(&store)
    let operations = pireus_u250_query_engine_operations(&store)
    let bridge = pireus_u250_query_machine_bridge(&store)
    if triple_store_count(&store) != 326 ||
        sparql_result_count(&slots) != 2 ||
        sparql_result_count(&observed) != 1 ||
        sparql_result_count(&unresolved) != 1 ||
        sparql_result_count(&memory) != 1 ||
        sparql_result_count(&isa) != 0 ||
        sparql_result_count(&operations) != 0 ||
        sparql_result_count(&bridge) != 1 { return 2 }

    var cpu = pireus_u250_execution_engine_request()
    cpu.engine_kind = PIREUS_ENGINE_KIND_CPU
    let cpu_result = pireus_u250_execution_engine_project(&parent, &cpu)
    if cpu_result.valid || cpu_result.status !=
        PIREUS_U250_ENGINE_STATUS_PROJECTION_REFUSED { return 3 }

    var gpu = pireus_u250_execution_engine_request()
    gpu.engine_kind = PIREUS_ENGINE_KIND_GPU
    let gpu_result = pireus_u250_execution_engine_project(&parent, &gpu)
    if gpu_result.valid || gpu_result.status !=
        PIREUS_U250_ENGINE_STATUS_PROJECTION_REFUSED { return 4 }

    var xrt_isa = pireus_u250_execution_engine_request()
    xrt_isa.xrt_as_isa = true
    let xrt_isa_result = pireus_u250_execution_engine_project(
        &parent, &xrt_isa)
    if xrt_isa_result.valid || !xrt_isa_result.xrt_as_isa ||
        xrt_isa_result.status !=
        PIREUS_U250_ENGINE_STATUS_PROJECTION_REFUSED { return 5 }

    var fabric_operation = pireus_u250_execution_engine_request()
    fabric_operation.fabric_as_operation = true
    let fabric_operation_result = pireus_u250_execution_engine_project(
        &parent, &fabric_operation)
    if fabric_operation_result.valid ||
        !fabric_operation_result.fabric_as_operation ||
        fabric_operation_result.status !=
        PIREUS_U250_ENGINE_STATUS_PROJECTION_REFUSED { return 6 }

    var shell_kernel = pireus_u250_execution_engine_request()
    shell_kernel.shell_implies_kernel_correctness = true
    let shell_kernel_result = pireus_u250_execution_engine_project(
        &parent, &shell_kernel)
    if shell_kernel_result.valid ||
        !shell_kernel_result.kernel_correctness_present ||
        shell_kernel_result.status !=
        PIREUS_U250_ENGINE_STATUS_CAPABILITY_REFUSED { return 7 }

    var memory_lowering = pireus_u250_execution_engine_request()
    memory_lowering.memory_implies_lowering = true
    let memory_lowering_result = pireus_u250_execution_engine_project(
        &parent, &memory_lowering)
    if memory_lowering_result.valid ||
        memory_lowering_result.lowering_authorized ||
        memory_lowering_result.status !=
        PIREUS_U250_ENGINE_STATUS_CAPABILITY_REFUSED { return 8 }

    var operation = pireus_u250_execution_engine_request()
    operation.operation_capability_count = 1
    let operation_result = pireus_u250_execution_engine_project(
        &parent, &operation)
    if operation_result.valid || operation_result.operation_capability_count != 1 ||
        operation_result.status !=
        PIREUS_U250_ENGINE_STATUS_CAPABILITY_REFUSED { return 9 }

    var cost = pireus_u250_execution_engine_request()
    cost.cost_present = true
    let cost_result = pireus_u250_execution_engine_project(&parent, &cost)
    if cost_result.valid || !cost_result.cost_present || cost_result.status !=
        PIREUS_U250_ENGINE_STATUS_CAPABILITY_REFUSED { return 10 }

    var cpp = pireus_u250_execution_engine_request()
    cpp.producer_language = PIREUS_U250_LANGUAGE_CPP
    cpp.producer_role = PIREUS_U250_ROLE_MATERIAL_PARITY
    let cpp_result = pireus_u250_execution_engine_project(&parent, &cpp)
    if cpp_result.valid || !cpp_result.authority_refused ||
        cpp_result.status !=
        PIREUS_U250_ENGINE_STATUS_AUTHORITY_REFUSED { return 11 }

    var llm = pireus_u250_execution_engine_request()
    llm.producer_language = PIREUS_U250_LANGUAGE_EXTERNAL_LLM
    llm.producer_role = PIREUS_U250_ROLE_REVIEW_ONLY
    let llm_result = pireus_u250_execution_engine_project(&parent, &llm)
    if llm_result.valid || !llm_result.authority_refused ||
        llm_result.status !=
        PIREUS_U250_ENGINE_STATUS_AUTHORITY_REFUSED { return 12 }

    var python = pireus_u250_execution_engine_request()
    python.producer_language = PIREUS_U250_LANGUAGE_PYTHON
    python.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let python_result = pireus_u250_execution_engine_project(&parent, &python)
    if python_result.valid || !python_result.authority_refused ||
        python_result.status !=
        PIREUS_U250_ENGINE_STATUS_AUTHORITY_REFUSED { return 13 }

    var parity = pireus_u250_execution_engine_request()
    parity.parity_open_requested = true
    let parity_result = pireus_u250_execution_engine_project(&parent, &parity)
    if parity_result.valid || parity_result.execution_engine_parity_open ||
        parity_result.status !=
        PIREUS_U250_ENGINE_STATUS_PARITY_REFUSED { return 14 }

    var parity_without_receipt = pireus_u250_execution_engine_request()
    parity_without_receipt.semantics_frozen = true
    parity_without_receipt.parity_open_requested = true
    let parity_without_receipt_result = pireus_u250_execution_engine_project(
        &parent, &parity_without_receipt)
    if parity_without_receipt_result.valid ||
        parity_without_receipt_result.execution_engine_parity_open ||
        parity_without_receipt_result.status !=
        PIREUS_U250_ENGINE_STATUS_PARITY_REFUSED { return 15 }

    var claim = pireus_u250_execution_engine_request()
    claim.claim_ready_requested = true
    let claim_result = pireus_u250_execution_engine_project(&parent, &claim)
    if claim_result.valid || claim_result.claim_ready || claim_result.status !=
        PIREUS_U250_ENGINE_STATUS_CLAIM_REFUSED { return 16 }

    let bad_parent = pireus_u250_material_ingest_files(get_arg(0), get_arg(2))
    let bad_parent_result = pireus_u250_execution_engine_project(
        &bad_parent, &canonical)
    if bad_parent_result.valid || bad_parent_result.status !=
        PIREUS_U250_ENGINE_STATUS_PARENT_REFUSED ||
        bad_parent_result.observed_engine_count != 0 { return 17 }

    print("PIREUS_U250_EXECUTION_ENGINE_TEST_PASS status=ENGINE_INVENTORY_PARTIAL slots=2 observed=1 unresolved=1 memory_profiles=1 isa_edges=0 operation_edges=0 machine_bridge=1 cpu=REFUSED gpu=REFUSED xrt_as_isa=REFUSED fabric_as_operation=REFUSED shell_kernel=REFUSED memory_lowering=REFUSED operation_without_receipt=REFUSED cost=REFUSED cpp_authority=REFUSED llm_authority=REFUSED python_authority=REFUSED parity_prefreeze=REFUSED parity_without_receipt=REFUSED claim_ready=REFUSED parent_tamper=REFUSED\n")
    0
}
