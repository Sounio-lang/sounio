//@ run-pass

use hardware::pireus::apple_cpu_dependency_latency_interface_material_ingestion::{
    PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE,
    PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED,
    PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED,
    pireus_apple_material_ingest_file,
    pireus_apple_material_ingest_sealed_files,
    pireus_apple_material_ingestion_classification_allowed,
    pireus_apple_material_ingestion_sealed_matches_frozen_classifier,
    pireus_apple_material_ingestion_transport_matches_frozen_semantics,
}

fn yes(value: bool) -> i64 { if value { 1 } else { 0 } }

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if arg_count() != 9 {
        print("usage: test_pireus_apple_cpu_dependency_latency_interface_material_ingestion <receipt> <summary> <samples> <transport-failure> <unsealed> <child-verdict> <child-classification> <malformed> <tampered-receipt>\n")
        return 2
    }

    let sealed = pireus_apple_material_ingest_sealed_files(
        get_arg(0), get_arg(1), get_arg(2))
    let transport = pireus_apple_material_ingest_file(get_arg(3))
    let unsealed = pireus_apple_material_ingest_file(get_arg(4))
    let child_verdict = pireus_apple_material_ingest_file(get_arg(5))
    let child_requested = pireus_apple_material_ingest_file(get_arg(6))
    let malformed = pireus_apple_material_ingest_file(get_arg(7))
    let bad_receipt = pireus_apple_material_ingest_sealed_files(
        get_arg(8), get_arg(1), get_arg(2))
    let bad_summary = pireus_apple_material_ingest_sealed_files(
        get_arg(0), get_arg(5), get_arg(2))
    let bad_samples = pireus_apple_material_ingest_sealed_files(
        get_arg(0), get_arg(1), get_arg(7))

    let sealed_ok = sealed.valid && sealed.status ==
            PIREUS_APPLE_MATERIAL_INGEST_SEALED_CLASSIFIED &&
        sealed.material_facts_present && sealed.parity_receipt_valid &&
        sealed.material_observation_ready && sealed.classification_requested &&
        pireus_apple_material_ingestion_classification_allowed(&sealed) &&
        pireus_apple_material_ingestion_sealed_matches_frozen_classifier(
            &sealed)
    let transport_ok = transport.valid && transport.status ==
            PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE &&
        transport.transport_failure && !transport.material_facts_present &&
        !pireus_apple_material_ingestion_classification_allowed(&transport) &&
        pireus_apple_material_ingestion_transport_matches_frozen_semantics(
            &transport)
    let unsealed_ok = unsealed.valid && unsealed.status ==
            PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED &&
        !unsealed.transport_failure && unsealed.material_facts_present &&
        !unsealed.parity_receipt_valid &&
        !unsealed.material_observation_ready &&
        !pireus_apple_material_ingestion_classification_allowed(&unsealed)
    let negatives_ok = !child_verdict.valid && !child_requested.valid &&
        !malformed.valid && !bad_receipt.valid && !bad_summary.valid &&
        !bad_samples.valid

    print("PIREUS_APPLE_MATERIAL_INGESTION_TEST sealed=")
    print_int(yes(sealed_ok))
    print(" transport="); print_int(yes(transport_ok))
    print(" unsealed="); print_int(yes(unsealed_ok))
    print(" child_verdict_refused="); print_int(yes(!child_verdict.valid))
    print(" child_classification_refused=")
    print_int(yes(!child_requested.valid))
    print(" malformed_refused="); print_int(yes(!malformed.valid))
    print(" bad_receipt_refused="); print_int(yes(!bad_receipt.valid))
    print(" bad_summary_refused="); print_int(yes(!bad_summary.valid))
    print(" bad_samples_refused="); print_int(yes(!bad_samples.valid))
    print("\n")

    if sealed_ok && transport_ok && unsealed_ok && negatives_ok {
        print("PIREUS_APPLE_MATERIAL_INGESTION_TEST_PASS sealed=1 verdict=INDETERMINATE candidates=6 terminal=5 feasible=0 refusals=2 ineligible=3 manifest_closed=0 transport=1 unsealed=1 child_verdict=REFUSED child_classification=REFUSED malformed=REFUSED tampered=REFUSED cost_present=0 claim_ready=0\n")
        0
    } else {
        print("PIREUS_APPLE_MATERIAL_INGESTION_TEST_FAIL\n")
        1
    }
}
