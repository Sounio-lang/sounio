//@ run-pass

use hardware::pireus::apple_cpu_dependency_latency_interface_material_ingestion::{
    PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE,
    PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED,
    pireus_apple_material_ingest_file,
    pireus_apple_material_ingest_text,
    pireus_apple_material_ingestion_classification_allowed,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if arg_count() != 1 {
        print("usage: test_pireus_apple_cpu_dependency_latency_interface_material_ingestion <transport-failure>\n")
        return 2
    }

    let transport = pireus_apple_material_ingest_file(get_arg(0))
    let summary = "PIREUS_APPLE_CPU_INTERFACE_MATERIAL_PARITY_V1\nproducer_language=C++\nproducer_role=MATERIAL_PARITY\nsounio_source_sha256=d8c7e6f9410c36f6858fb2379efa010a5adbaa32c615d89edc3e764a0606a6be\nsounio_semantics_sha256=6819916ac4240923a149dd95ee9dcbeaba8d3826b7452dd819e177ff62ce8c7f\nauthority_commit=ba85ed0689484f747e392783de4f912001153360\nsemantic_write=false\nexpected_result_write=false\nclassification_requested=false\nsemantic_verdict_emitted=false\ncost_present=false\nmeasurand_validated=false\nrequested_warmups=128\nrequested_samples=1001\ncandidate_count=6\nhostname=Sounio-Language-MacBook\nos=Darwin\nos_release=27.0.0\narchitecture=arm64\nmodel=Mac17,7\ncpu=Apple M5 Max\ntarget=J714c\ncandidate_0_family=CORE_CYCLE_COUNTER\ncandidate_1_family=PROCESS_PMU_CYCLE_EVENT\ncandidate_2_family=SYSTEM_TRACE_CYCLE_EVENT\ncandidate_3_family=ARCHITECTURAL_TIMER_TICK\ncandidate_4_family=OS_MONOTONIC_TIME\ncandidate_5_family=FREQUENCY_DERIVED_ESTIMATE\ncandidate_5_native_cycle_claim=false\nprobe_completed=true\n"
    let unsealed = pireus_apple_material_ingest_text(summary)
    let child_verdict = pireus_apple_material_ingest_text(
        summary ++ "verdict=FEASIBLE_CYCLE_NATIVE\n")
    let child_requested = pireus_apple_material_ingest_text(
        summary ++ "classification_requested=true\n")
    let malformed = pireus_apple_material_ingest_text(
        "producer_language=C++\nprobe_completed=true\n")

    let transport_ok = transport.valid && transport.status ==
            PIREUS_APPLE_MATERIAL_INGEST_TRANSPORT_FAILURE &&
        transport.transport_failure && !transport.material_facts_present &&
        !pireus_apple_material_ingestion_classification_allowed(&transport)
    let unsealed_ok = unsealed.valid && unsealed.status ==
            PIREUS_APPLE_MATERIAL_INGEST_FACTS_UNSEALED &&
        !unsealed.transport_failure && unsealed.material_facts_present &&
        !unsealed.parity_receipt_valid &&
        !unsealed.material_observation_ready &&
        !pireus_apple_material_ingestion_classification_allowed(&unsealed)
    let negatives_ok = !child_verdict.valid && !child_requested.valid &&
        !malformed.valid

    if transport_ok && unsealed_ok && negatives_ok {
        print("PIREUS_APPLE_MATERIAL_INGESTION_TEST_PASS transport=1 unsealed=1 child_verdict=REFUSED child_classification=REFUSED malformed=REFUSED classification_allowed=0\n")
        0
    } else {
        print("PIREUS_APPLE_MATERIAL_INGESTION_TEST_FAIL\n")
        1
    }
}
