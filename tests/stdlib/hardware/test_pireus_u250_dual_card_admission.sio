//@ run-pass

use hardware::pireus::u250_dual_card_admission::{
    PIREUS_U250_LANGUAGE_CPP,
    PIREUS_U250_LANGUAGE_EXTERNAL_LLM,
    PIREUS_U250_LANGUAGE_PYTHON,
    PIREUS_U250_ROLE_MATERIAL_PARITY,
    PIREUS_U250_ROLE_REVIEW_ONLY,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
    PIREUS_U250_STATUS_AUTHORITY_REFUSED,
    PIREUS_U250_STATUS_DECLARATION_INVALID,
    PIREUS_U250_STATUS_FORBIDDEN_PRODUCER,
    PIREUS_U250_STATUS_IDENTITY_CONFLICT,
    PIREUS_U250_STATUS_INVENTORY_COMPLETE,
    PIREUS_U250_STATUS_INVENTORY_OPEN,
    PIREUS_U250_STATUS_PRE_FREEZE_REFUSED,
    pireus_u250_canonical_declaration,
    pireus_u250_dual_card_admit,
    pireus_u250_empty_observation,
    pireus_u250_initial_admission,
    pireus_u250_initial_matches_expected,
    pireus_u250_reference_material_observation,
}

fn main() -> i32 with IO, Mut {
    let initial = pireus_u250_initial_admission()
    if !pireus_u250_initial_matches_expected(&initial) { return 1 }

    var wrong_count = pireus_u250_canonical_declaration()
    wrong_count.declared_card_count = 1
    let empty_0 = pireus_u250_empty_observation(0)
    let empty_1 = pireus_u250_empty_observation(1)
    let wrong_count_result = pireus_u250_dual_card_admit(
        &wrong_count, &empty_0, &empty_1)
    if wrong_count_result.valid || wrong_count_result.status !=
        PIREUS_U250_STATUS_DECLARATION_INVALID { return 2 }

    let sealed_before_freeze =
        pireus_u250_reference_material_observation(0, 1001)
    let canonical = pireus_u250_canonical_declaration()
    let prefreeze = pireus_u250_dual_card_admit(
        &canonical, &sealed_before_freeze, &empty_1)
    if prefreeze.valid || prefreeze.status !=
        PIREUS_U250_STATUS_PRE_FREEZE_REFUSED ||
        prefreeze.admitted_card_count != 0 ||
        !prefreeze.material_before_freeze { return 3 }

    var unsealed = pireus_u250_reference_material_observation(0, 1001)
    unsealed.receipt_valid = false
    let unsealed_result = pireus_u250_dual_card_admit(
        &canonical, &unsealed, &empty_1)
    if !unsealed_result.valid || unsealed_result.status !=
        PIREUS_U250_STATUS_INVENTORY_OPEN ||
        unsealed_result.admitted_card_count != 0 ||
        unsealed_result.rejected_card_count != 1 ||
        unsealed_result.unsealed_observation_count != 1 { return 4 }

    var frozen = pireus_u250_canonical_declaration()
    frozen.semantics_frozen = true
    frozen.parity_open_requested = true
    let duplicate_0 = pireus_u250_reference_material_observation(0, 2001)
    let duplicate_1 = pireus_u250_reference_material_observation(1, 2001)
    let duplicate = pireus_u250_dual_card_admit(
        &frozen, &duplicate_0, &duplicate_1)
    if duplicate.valid || duplicate.status !=
        PIREUS_U250_STATUS_IDENTITY_CONFLICT ||
        !duplicate.duplicate_identity || duplicate.admitted_card_count != 0 {
        return 5
    }

    var missing_pf = pireus_u250_reference_material_observation(0, 3001)
    missing_pf.management_pf_count = 0
    let missing_pf_result = pireus_u250_dual_card_admit(
        &frozen, &missing_pf, &empty_1)
    if !missing_pf_result.valid || missing_pf_result.admitted_card_count != 0 ||
        missing_pf_result.malformed_observation_count != 1 { return 6 }

    var wrong_pci = pireus_u250_reference_material_observation(0, 3002)
    wrong_pci.user_pci_identity = 0
    let wrong_pci_result = pireus_u250_dual_card_admit(
        &frozen, &wrong_pci, &empty_1)
    if !wrong_pci_result.valid || wrong_pci_result.admitted_card_count != 0 ||
        wrong_pci_result.malformed_observation_count != 1 { return 7 }

    var python = pireus_u250_reference_material_observation(0, 4001)
    python.producer_language = PIREUS_U250_LANGUAGE_PYTHON
    let python_result = pireus_u250_dual_card_admit(
        &frozen, &python, &empty_1)
    if python_result.valid || python_result.status !=
        PIREUS_U250_STATUS_FORBIDDEN_PRODUCER ||
        !python_result.forbidden_producer ||
        python_result.admitted_card_count != 0 { return 8 }

    var cpp_authority = pireus_u250_reference_material_observation(0, 4002)
    cpp_authority.producer_language = PIREUS_U250_LANGUAGE_CPP
    cpp_authority.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let cpp_authority_result = pireus_u250_dual_card_admit(
        &frozen, &cpp_authority, &empty_1)
    if cpp_authority_result.valid || cpp_authority_result.status !=
        PIREUS_U250_STATUS_AUTHORITY_REFUSED ||
        !cpp_authority_result.authority_promotion { return 9 }

    var llm_authority = pireus_u250_reference_material_observation(0, 4003)
    llm_authority.producer_language = PIREUS_U250_LANGUAGE_EXTERNAL_LLM
    llm_authority.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let llm_authority_result = pireus_u250_dual_card_admit(
        &frozen, &llm_authority, &empty_1)
    if llm_authority_result.valid || llm_authority_result.status !=
        PIREUS_U250_STATUS_AUTHORITY_REFUSED ||
        !llm_authority_result.authority_promotion { return 10 }

    var llm_review = pireus_u250_reference_material_observation(0, 4004)
    llm_review.producer_language = PIREUS_U250_LANGUAGE_EXTERNAL_LLM
    llm_review.producer_role = PIREUS_U250_ROLE_REVIEW_ONLY
    let llm_review_result = pireus_u250_dual_card_admit(
        &frozen, &llm_review, &empty_1)
    if !llm_review_result.valid || llm_review_result.admitted_card_count != 0 ||
        llm_review_result.rejected_card_count != 1 { return 11 }

    var claim = pireus_u250_canonical_declaration()
    claim.claim_ready_requested = true
    let claim_result = pireus_u250_dual_card_admit(
        &claim, &empty_0, &empty_1)
    if claim_result.valid || claim_result.claim_ready { return 12 }

    let admitted_0 = pireus_u250_reference_material_observation(0, 5001)
    let admitted_1 = pireus_u250_reference_material_observation(1, 5002)
    let complete = pireus_u250_dual_card_admit(
        &frozen, &admitted_0, &admitted_1)
    if !complete.valid || complete.status !=
        PIREUS_U250_STATUS_INVENTORY_COMPLETE ||
        complete.admitted_card_count != 2 || !complete.inventory_complete ||
        !complete.material_parity_ready || !complete.parity_open ||
        complete.claim_ready || complete.cost_present ||
        complete.speedup_present || complete.kernel_correctness_present {
        return 13
    }

    var wrong_slot = pireus_u250_empty_observation(0)
    wrong_slot.slot = 2
    let wrong_slot_result = pireus_u250_dual_card_admit(
        &canonical, &wrong_slot, &empty_1)
    if wrong_slot_result.valid || wrong_slot_result.status !=
        PIREUS_U250_STATUS_DECLARATION_INVALID { return 14 }

    print("PIREUS_U250_DUAL_CARD_ADMISSION_TEST_PASS initial=INVENTORY_OPEN declared=2 discovered=0 admitted=0 prefreeze=REFUSED unsealed=CONTAINED duplicate=REFUSED missing_pf=CONTAINED wrong_pci=CONTAINED python=PREEXEC_REFUSED cpp_authority=REFUSED llm_authority=REFUSED llm_review=REVIEW_ONLY complete=INVENTORY_ONLY claim_ready=0\n")
    0
}
