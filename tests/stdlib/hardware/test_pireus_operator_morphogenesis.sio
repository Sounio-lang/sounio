//@ run-pass
//!
//! Structural, relation-only test for the matcher-free V12 Sounio generator.

use hardware::pireus::operator_morphogenesis::{
    PIREUS_POM_OK,
    PIREUS_POM_EPOCHS,
    PIREUS_POM_ARCHIVE_CAPACITY,
    PIREUS_POM_CERTIFICATE_CAPACITY,
    PIREUS_POM_SIGN_CELLS,
    PIREUS_POM_INTERIOR_CELLS,
    PIREUS_POM_NEGATIVE_CASES,
    pireus_operator_morphogenesis_request,
    pireus_operator_morphogenesis_evaluate,
    pireus_pom_digest_nonzero,
    pireus_operator_morphogenesis_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_morphogenesis_request()
    let result = pireus_operator_morphogenesis_evaluate(&request)
    let population = &result.population
    if !result.valid || result.error != PIREUS_POM_OK ||
        result.structural_failures != 0 || !result.lineage.complete ||
        !result.lineage.cubic_live_valid || !result.lineage.cubic_frozen_match ||
        !population.complete ||
        !pireus_operator_morphogenesis_matches_frozen_semantics(&result) {
        return 1
    }

    if population.generated_epochs != PIREUS_POM_EPOCHS ||
        population.initial_archive_count <= 0 ||
        population.initial_archive_count > 2 * 48 ||
        population.final_archive_count > PIREUS_POM_ARCHIVE_CAPACITY ||
        population.orbit_fixed + population.orbit_pairs != PIREUS_POM_EPOCHS ||
        population.final_archive_count != population.initial_archive_count +
            population.orbit_fixed + 2 * population.orbit_pairs {
        return 2
    }

    var archive_sum: i64 = 0
    var epoch: i64 = 0
    while epoch < PIREUS_POM_EPOCHS {
        if population.archive_before[epoch] <= 0 ||
            population.archive_before[epoch] > PIREUS_POM_INTERIOR_CELLS ||
            population.archive_after[epoch] !=
                population.archive_before[epoch] +
                    population.orbit_kinds[epoch] ||
            (population.orbit_kinds[epoch] != 1 &&
                population.orbit_kinds[epoch] != 2) ||
            population.negative_sign_counts[epoch] < 0 ||
            population.negative_sign_counts[epoch] > PIREUS_POM_SIGN_CELLS ||
            population.square_negative_counts[epoch] < 0 ||
            population.square_negative_counts[epoch] > 16 ||
            population.commutator_defects[epoch] < 0 ||
            population.commutator_defects[epoch] > PIREUS_POM_SIGN_CELLS ||
            population.associator_defects[epoch] < 0 ||
            population.associator_defects[epoch] > 4096 {
            return 3
        }
        archive_sum = archive_sum + population.archive_before[epoch]
        epoch = epoch + 1
    }

    if population.phase_checks != archive_sum ||
        population.certificate_count != 2 * archive_sum ||
        population.certificate_checks != population.certificate_count ||
        population.certificate_count > PIREUS_POM_CERTIFICATE_CAPACITY ||
        population.direct_comparison_checks != 2 * archive_sum ||
        population.anf_coefficient_checks !=
            PIREUS_POM_EPOCHS * PIREUS_POM_INTERIOR_CELLS ||
        population.anf_reconstruction_checks !=
            PIREUS_POM_EPOCHS * PIREUS_POM_INTERIOR_CELLS ||
        population.microprogram_checks !=
            PIREUS_POM_EPOCHS * PIREUS_POM_SIGN_CELLS ||
        population.unit_checks != PIREUS_POM_EPOCHS * 31 ||
        population.cd_axis_checks != 32 {
        return 4
    }
    if population.archive_closure_failures != 0 ||
        population.archive_capacity_failures != 0 ||
        population.cd_sign_failures != 0 || population.cd_axis_failures != 0 ||
        population.phase_failures != 0 ||
        population.anf_reconstruction_failures != 0 ||
        population.certificate_failures != 0 ||
        population.direct_collision_failures != 0 ||
        population.unit_failures != 0 ||
        population.microprogram_failures != 0 ||
        population.capacity_refusals != 0 { return 5 }

    var generated_cell: i64 = 0
    while generated_cell < PIREUS_POM_EPOCHS * PIREUS_POM_SIGN_CELLS {
        if population.generated_sign_bits[generated_cell] < 0 ||
            population.generated_sign_bits[generated_cell] > 1 ||
            population.microprogram_sign_bits[generated_cell] < 0 ||
            population.microprogram_sign_bits[generated_cell] > 1 {
            return 6
        }
        let epoch = generated_cell / PIREUS_POM_SIGN_CELLS
        let entry = generated_cell - epoch * PIREUS_POM_SIGN_CELLS
        let destination = entry / 16
        let ordinal = entry - destination * 16
        let left = population.microprogram_left_inputs[generated_cell]
        let right = population.microprogram_right_inputs[generated_cell]
        if population.microprogram_destinations[generated_cell] != destination ||
            population.microprogram_ordinals[generated_cell] != ordinal ||
            left != ordinal || right != (left ^ destination) ||
            population.microprogram_sign_bits[generated_cell] !=
                population.generated_sign_bits[
                    epoch * PIREUS_POM_SIGN_CELLS + left * 16 + right] {
            return 6
        }
        generated_cell = generated_cell + 1
    }
    var generated_interior: i64 = 0
    while generated_interior <
            PIREUS_POM_EPOCHS * PIREUS_POM_INTERIOR_CELLS {
        if population.generated_phase_bits[generated_interior] < 0 ||
            population.generated_phase_bits[generated_interior] > 1 ||
            population.generated_anf_bits[generated_interior] < 0 ||
            population.generated_anf_bits[generated_interior] > 1 { return 7 }
        generated_interior = generated_interior + 1
    }
    var certificate: i64 = 0
    while certificate < population.certificate_count {
        if (population.certificate_kinds[certificate] != 0 &&
                population.certificate_kinds[certificate] != 1) ||
            population.certificate_epochs[certificate] < 0 ||
            population.certificate_epochs[certificate] >= PIREUS_POM_EPOCHS ||
            population.certificate_archive_indices[certificate] < 0 ||
            population.certificate_partner_indices[certificate] < 0 ||
            population.certificate_cells[certificate] < 0 ||
            population.certificate_cells[certificate] >= PIREUS_POM_SIGN_CELLS ||
            population.certificate_generated_bits[certificate] ==
                population.certificate_archived_bits[certificate] {
            return 8
        }
        certificate = certificate + 1
    }

    if result.negatives.passed != result.negatives.total ||
        result.negatives.total != PIREUS_POM_NEGATIVE_CASES ||
        !result.negatives.python_oracle || !result.negatives.rust_oracle ||
        !result.negatives.cpp_authority || !result.negatives.llm_authority ||
        !result.negatives.wrong_stage || !result.negatives.missing_policy ||
        !result.negatives.missing_garden || !result.negatives.missing_contract ||
        !result.negatives.unfrozen_cubic || !result.negatives.unbound_frontier ||
        !result.negatives.wrong_epoch_budget ||
        !result.negatives.incomplete_archive || !result.negatives.witness_reuse ||
        !result.negatives.witness_agreement ||
        !result.negatives.omitted_action_image || !result.negatives.broken_unit ||
        !result.negatives.broken_xor_route ||
        !result.negatives.reassociated_reduction ||
        !result.negatives.injected_result ||
        !result.negatives.incomplete_comparison ||
        !result.negatives.selected_candidate || !result.negatives.parity_prefreeze ||
        !result.negatives.review_promotion || !result.negatives.claim_promotion {
        return 9
    }
    if !pireus_pom_digest_nonzero(&population.final_archive_digest) ||
        !pireus_pom_digest_nonzero(&population.run_digest) ||
        !result.proof_carrying_generation_complete ||
        !result.constructive_bounded_relative_novelty ||
        result.candidate_selected || result.ranking_present ||
        result.full_space_exhausted || result.full_gl_gauge_inequivalence ||
        result.algebraic_novelty || result.algorithmic_novelty ||
        result.material_novelty || result.performance_novelty ||
        result.scientific_novelty || result.historical_novelty ||
        result.global_novelty || result.priority_claim || result.claim_ready {
        return 10
    }

    print("PIREUS_OPERATOR_MORPHOGENESIS_EXECUTABLE_OK\n")
    0
}
