//@ run-pass
use hardware::pireus::xor_lowering_legality::{
    PIREUS_XOR_LOWERING_OK,
    pireus_xor_lowering_evaluate,
    pireus_xor_lowering_matches_frozen_semantics,
}

fn words_equal(left: &[i64; 8], right: &[i64; 8]) -> bool
with Mut, Panic {
    var i: i64 = 0
    while i < 8 {
        if left[i] != right[i] { return false }
        i = i + 1
    }
    true
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 {
        print("PIREUS_XOR_LOWERING_TEST_REQUIRES_PINNED_PDF_AND_XED\n")
        return 0
    }
    let result = pireus_xor_lowering_evaluate(get_arg(0), get_arg(1))
    if !result.valid || result.error != PIREUS_XOR_LOWERING_OK ||
        result.failures != 0 ||
        !pireus_xor_lowering_matches_frozen_semantics(&result) { return 1 }
    if !result.parents.valid || !result.parents.operation_live_match ||
        !result.parents.material_live_match || !result.parents.intel_live_match {
        return 2
    }
    if result.plan.count != 5 ||
        result.plan.semantic_authorized_count != 5 ||
        result.plan.material_candidate_count != 1 ||
        result.plan.material_authorized_count != 0 ||
        result.plan.unresolved_material_count != 5 ||
        result.plan.reassociation_required_count != 0 ||
        !result.plan.exact_tree_reduction_refused { return 3 }

    let expected_kinds: [i64; 5] = [1, 2, 3, 4, 5]
    let expected_capabilities: [i64; 5] = [1, 2, 3, 4, 5]
    let expected_semantic_forms: [i64; 5] = [1, 2, 3, 4, 5]
    let expected_material_forms: [i64; 5] = [1, 0, 0, 0, 0]
    let expected_groups: [i64; 5] = [32, 32, 32, 16, 16]
    let expected_barriers: [bool; 5] = [false, true, false, true, true]
    let expected_refusals: [i64; 5] = [1, 2, 2, 2, 2]
    var node: i64 = 0
    while node < 5 {
        if result.plan.node_kinds[node] != expected_kinds[node] ||
            result.plan.capabilities[node] != expected_capabilities[node] ||
            result.plan.semantic_forms[node] !=
                expected_semantic_forms[node] ||
            result.plan.material_forms[node] != expected_material_forms[node] ||
            result.plan.group_counts[node] != expected_groups[node] ||
            result.plan.barriers_present[node] != expected_barriers[node] ||
            result.plan.refusal_reasons[node] != expected_refusals[node] ||
            !result.plan.exact_order_preserved[node] ||
            result.plan.reassociation_required[node] ||
            result.plan.barriers_crossed[node] ||
            !result.plan.semantic_authorized[node] ||
            result.plan.material_authorized[node] {
            return 4
        }
        node = node + 1
    }

    let expected_masks: [i64; 32] = [
        254, 255, 104, 150, 194, 60, 164, 90,
        14, 240, 84, 170, 152, 102, 50, 204,
        254, 0, 148, 149, 56, 57, 82, 83,
        224, 225, 138, 139, 38, 39, 76, 77
    ]
    if !result.signs.valid || result.signs.count != 32 ||
        result.signs.negative_cells != 120 ||
        result.signs.positive_cells != 136 ||
        result.signs.other_cells != 0 ||
        result.signs.complete_cells != 256 { return 5 }
    var group: i64 = 0
    while group < 32 {
        if result.signs.displacements[group] != group / 2 ||
            result.signs.chunks[group] != group % 2 ||
            result.signs.negative_lane_masks[group] != expected_masks[group] {
            return 6
        }
        group = group + 1
    }

    if result.execution.matching_lanes != 16 ||
        result.execution.mismatching_lanes != 0 ||
        result.execution.first_mismatch != 0 - 1 ||
        !result.execution.partner_table_valid ||
        !result.execution.ascending_i || result.execution.reassociated ||
        !result.execution.bit_exact_to_frozen_parent { return 7 }
    var lane: i64 = 0
    while lane < 16 {
        if result.execution.output_bits[lane] !=
            result.execution.parent_output_bits[lane] { return 8 }
        lane = lane + 1
    }

    if result.targets.count != 3 ||
        !result.targets.selector_candidates[0] ||
        result.targets.selector_candidates[1] ||
        result.targets.selector_candidates[2] { return 9 }
    var target: i64 = 0
    while target < 3 {
        if !result.targets.canonical[target] ||
            result.targets.observed[target] ||
            result.targets.material_receipts[target] { return 10 }
        target = target + 1
    }

    let expected_plan_digest: [i64; 8] = [
        2142091107, 4249907122, 3863427811, 504864931,
        773906704, 3125338900, 1218300674, 2342175410
    ]
    let expected_sign_digest: [i64; 8] = [
        752426894, 1081783397, 4255815771, 3046881682,
        374348601, 3092447425, 409805503, 2155165117
    ]
    let expected_execution_digest: [i64; 8] = [
        1681975016, 353754803, 255370894, 371728465,
        3003784656, 2361654069, 297010941, 1230873056
    ]
    let expected_target_digest: [i64; 8] = [
        1171138587, 3673533213, 2025206369, 3854413864,
        2173565745, 4002586673, 3864924956, 1538784405
    ]
    let expected_witness_digest: [i64; 8] = [
        3349983975, 2376690512, 2661503365, 1848883686,
        3608709071, 4162318832, 3458944498, 2513815805
    ]
    if !words_equal(&result.plan_digest.words, &expected_plan_digest) ||
        !words_equal(&result.sign_digest.words, &expected_sign_digest) ||
        !words_equal(&result.execution_digest.words, &expected_execution_digest) ||
        !words_equal(&result.target_digest.words, &expected_target_digest) ||
        !words_equal(&result.witness_digest.words, &expected_witness_digest) {
        return 11
    }

    if result.negatives.passed != 20 || result.negatives.total != 20 ||
        result.material_observation_count != 0 ||
        result.compiler_emission_count != 0 ||
        result.cost_record_count != 0 ||
        result.numerical_refinement_receipt_count != 0 ||
        result.parity_open || result.claim_ready { return 12 }

    print("PIREUS_XOR_LOWERING_EXECUTABLE_OK\n")
    0
}
