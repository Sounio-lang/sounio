//@ run-pass
use hardware::pireus::xor_convolution_operation::{
    PIREUS_XOR_OPERATION_OK,
    pireus_xor_operation_evaluate,
    pireus_xor_operation_digest_nonzero,
    pireus_xor_operation_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let result = pireus_xor_operation_evaluate()
    if !result.valid || result.error != PIREUS_XOR_OPERATION_OK { return 1 }
    if !result.xor_parent_frozen || !result.graph_parent_frozen { return 2 }
    if !result.xor_parent_match || !result.graph_parent_receipt_valid {
        return 3
    }
    if !result.output_matches_parent { return 4 }
    if result.negatives.passed != result.negatives.total { return 5 }
    if result.material_observation_count != 0 || result.lowering_count != 0 ||
        result.cost_record_count != 0 ||
        result.targets.material_receipt_count != 0 { return 6 }
    if result.parity_open || result.claim_ready { return 7 }
    if !pireus_xor_operation_digest_nonzero(&result.parent_digest) { return 8 }
    if !pireus_xor_operation_digest_nonzero(&result.graph_digest) { return 9 }
    if !pireus_xor_operation_digest_nonzero(&result.capability_digest) {
        return 10
    }
    if !pireus_xor_operation_digest_nonzero(&result.target_digest) { return 11 }
    if !pireus_xor_operation_digest_nonzero(&result.result_digest) { return 12 }
    if !pireus_xor_operation_digest_nonzero(&result.witness_digest) { return 13 }
    if result.failures != 0 { return 14 }
    if !pireus_xor_operation_matches_frozen_semantics(&result) { return 15 }
    print("PIREUS_XOR_OPERATION_OK\n")
    0
}
