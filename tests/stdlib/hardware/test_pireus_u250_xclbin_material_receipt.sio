//@ run-pass

use hardware::pireus::u250_dual_card_admission::{
    PIREUS_U250_LANGUAGE_CPP,
    PIREUS_U250_LANGUAGE_EXTERNAL_LLM,
    PIREUS_U250_LANGUAGE_PYTHON,
    PIREUS_U250_LANGUAGE_RUST,
    PIREUS_U250_ROLE_MATERIAL_PARITY,
    PIREUS_U250_ROLE_REVIEW_ONLY,
    PIREUS_U250_ROLE_SEMANTIC_AUTHORITY,
}
use hardware::pireus::u250_material_ingestion::{
    pireus_u250_material_ingest_files,
}
use hardware::pireus::u250_execution_engine::{
    pireus_u250_execution_engine_request,
    pireus_u250_execution_engine_project,
}
use hardware::pireus::u250_fpga_kernel_artifact::{
    pireus_u250_fpga_kernel_artifact_request,
    pireus_u250_fpga_kernel_artifact_project,
}
use hardware::pireus::u250_xclbin_material_receipt::{
    PIREUS_U250_XCLBIN_STATUS_AUTHORITY_REFUSED,
    PIREUS_U250_XCLBIN_STATUS_ORDER_REFUSED,
    PIREUS_U250_XCLBIN_STATUS_MATERIAL_REFUSED,
    PIREUS_U250_XCLBIN_STATUS_IDENTITY_REFUSED,
    PIREUS_U250_XCLBIN_STATUS_ABI_REFUSED,
    PIREUS_U250_XCLBIN_STATUS_CAPABILITY_REFUSED,
    PIREUS_U250_XCLBIN_STATUS_CLAIM_REFUSED,
    pireus_u250_xclbin_material_request,
    pireus_u250_xclbin_material_observation,
    pireus_u250_xclbin_material_project,
    pireus_u250_xclbin_material_ingest_file,
    pireus_u250_xclbin_waiting_matches_expected,
    pireus_u250_xclbin_parity_matches_expected,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 2 && arg_count() != 4 { return 100 }
    let material = pireus_u250_material_ingest_files(get_arg(0), get_arg(1))
    let engine_request = pireus_u250_execution_engine_request()
    let engine = pireus_u250_execution_engine_project(
        &material, &engine_request)
    let artifact_request = pireus_u250_fpga_kernel_artifact_request()
    let artifact = pireus_u250_fpga_kernel_artifact_project(
        &engine, &artifact_request)

    let waiting_request = pireus_u250_xclbin_material_request()
    let waiting = pireus_u250_xclbin_material_project(
        &artifact, &waiting_request)
    if !pireus_u250_xclbin_waiting_matches_expected(&waiting) { return 1 }

    let observed_request = pireus_u250_xclbin_material_observation()
    let observed = pireus_u250_xclbin_material_project(
        &artifact, &observed_request)
    if !pireus_u250_xclbin_parity_matches_expected(&observed) { return 2 }

    var premature = pireus_u250_xclbin_material_observation()
    premature.semantics_frozen = false
    let premature_result = pireus_u250_xclbin_material_project(
        &artifact, &premature)
    if premature_result.valid || premature_result.status !=
        PIREUS_U250_XCLBIN_STATUS_ORDER_REFUSED { return 3 }

    var missing_bits = pireus_u250_xclbin_material_observation()
    missing_bits.bitstream_present = false
    let missing_bits_result = pireus_u250_xclbin_material_project(
        &artifact, &missing_bits)
    if missing_bits_result.valid || missing_bits_result.status !=
        PIREUS_U250_XCLBIN_STATUS_MATERIAL_REFUSED { return 4 }

    var missing_digest = pireus_u250_xclbin_material_observation()
    missing_digest.bitstream_digest_present = false
    let missing_digest_result = pireus_u250_xclbin_material_project(
        &artifact, &missing_digest)
    if missing_digest_result.valid || missing_digest_result.status !=
        PIREUS_U250_XCLBIN_STATUS_MATERIAL_REFUSED { return 5 }

    var missing_metadata = pireus_u250_xclbin_material_observation()
    missing_metadata.metadata_present = false
    let missing_metadata_result = pireus_u250_xclbin_material_project(
        &artifact, &missing_metadata)
    if missing_metadata_result.valid || missing_metadata_result.status !=
        PIREUS_U250_XCLBIN_STATUS_MATERIAL_REFUSED { return 6 }

    var wrong_size = pireus_u250_xclbin_material_observation()
    wrong_size.artifact_size_bytes = 41112055
    let wrong_size_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_size)
    if wrong_size_result.valid || wrong_size_result.status !=
        PIREUS_U250_XCLBIN_STATUS_IDENTITY_REFUSED { return 7 }

    var wrong_digest = pireus_u250_xclbin_material_observation()
    wrong_digest.digest_7 = 0xfcd4bdbe
    let wrong_digest_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_digest)
    if wrong_digest_result.valid || wrong_digest_result.status !=
        PIREUS_U250_XCLBIN_STATUS_IDENTITY_REFUSED { return 8 }

    var wrong_uuid = pireus_u250_xclbin_material_observation()
    wrong_uuid.xclbin_uuid_matches = false
    let wrong_uuid_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_uuid)
    if wrong_uuid_result.valid || wrong_uuid_result.status !=
        PIREUS_U250_XCLBIN_STATUS_IDENTITY_REFUSED { return 9 }

    var wrong_kernel = pireus_u250_xclbin_material_observation()
    wrong_kernel.kernel_symbol_matches = false
    let wrong_kernel_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_kernel)
    if wrong_kernel_result.valid || wrong_kernel_result.status !=
        PIREUS_U250_XCLBIN_STATUS_IDENTITY_REFUSED { return 10 }

    var wrong_platform = pireus_u250_xclbin_material_observation()
    wrong_platform.platform_matches = false
    let wrong_platform_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_platform)
    if wrong_platform_result.valid || wrong_platform_result.status !=
        PIREUS_U250_XCLBIN_STATUS_IDENTITY_REFUSED { return 11 }

    var wrong_clock = pireus_u250_xclbin_material_observation()
    wrong_clock.achieved_frequency_tenths_mhz = 1351
    let wrong_clock_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_clock)
    if wrong_clock_result.valid || wrong_clock_result.status !=
        PIREUS_U250_XCLBIN_STATUS_IDENTITY_REFUSED { return 12 }

    var wrong_order = pireus_u250_xclbin_material_observation()
    wrong_order.argument_order_matches = false
    let wrong_order_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_order)
    if wrong_order_result.valid || wrong_order_result.status !=
        PIREUS_U250_XCLBIN_STATUS_ABI_REFUSED { return 13 }

    var wrong_interface = pireus_u250_xclbin_material_observation()
    wrong_interface.interface_mapping_matches = false
    let wrong_interface_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_interface)
    if wrong_interface_result.valid || wrong_interface_result.status !=
        PIREUS_U250_XCLBIN_STATUS_ABI_REFUSED { return 14 }

    var wrong_bank = pireus_u250_xclbin_material_observation()
    wrong_bank.material_bank_mapping_matches = false
    let wrong_bank_result = pireus_u250_xclbin_material_project(
        &artifact, &wrong_bank)
    if wrong_bank_result.valid || wrong_bank_result.status !=
        PIREUS_U250_XCLBIN_STATUS_ABI_REFUSED { return 15 }

    var cpp_authority = pireus_u250_xclbin_material_observation()
    cpp_authority.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let cpp_authority_result = pireus_u250_xclbin_material_project(
        &artifact, &cpp_authority)
    if cpp_authority_result.valid || cpp_authority_result.status !=
        PIREUS_U250_XCLBIN_STATUS_AUTHORITY_REFUSED { return 16 }

    var python = pireus_u250_xclbin_material_observation()
    python.producer_language = PIREUS_U250_LANGUAGE_PYTHON
    python.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let python_result = pireus_u250_xclbin_material_project(
        &artifact, &python)
    if python_result.valid || python_result.status !=
        PIREUS_U250_XCLBIN_STATUS_AUTHORITY_REFUSED { return 17 }

    var rust = pireus_u250_xclbin_material_observation()
    rust.producer_language = PIREUS_U250_LANGUAGE_RUST
    rust.producer_role = PIREUS_U250_ROLE_SEMANTIC_AUTHORITY
    let rust_result = pireus_u250_xclbin_material_project(&artifact, &rust)
    if rust_result.valid || rust_result.status !=
        PIREUS_U250_XCLBIN_STATUS_AUTHORITY_REFUSED { return 18 }

    var llm = pireus_u250_xclbin_material_observation()
    llm.producer_language = PIREUS_U250_LANGUAGE_EXTERNAL_LLM
    llm.producer_role = PIREUS_U250_ROLE_REVIEW_ONLY
    let llm_result = pireus_u250_xclbin_material_project(&artifact, &llm)
    if llm_result.valid || llm_result.status !=
        PIREUS_U250_XCLBIN_STATUS_AUTHORITY_REFUSED { return 19 }

    var child_verdict = pireus_u250_xclbin_material_observation()
    child_verdict.semantic_verdict_emitted_by_child = true
    let child_verdict_result = pireus_u250_xclbin_material_project(
        &artifact, &child_verdict)
    if child_verdict_result.valid || child_verdict_result.status !=
        PIREUS_U250_XCLBIN_STATUS_CAPABILITY_REFUSED { return 20 }

    var execution = pireus_u250_xclbin_material_observation()
    execution.kernel_execution_observed = true
    let execution_result = pireus_u250_xclbin_material_project(
        &artifact, &execution)
    if execution_result.valid || execution_result.status !=
        PIREUS_U250_XCLBIN_STATUS_CAPABILITY_REFUSED { return 21 }

    var correctness = pireus_u250_xclbin_material_observation()
    correctness.kernel_correctness_present = true
    let correctness_result = pireus_u250_xclbin_material_project(
        &artifact, &correctness)
    if correctness_result.valid || correctness_result.status !=
        PIREUS_U250_XCLBIN_STATUS_CAPABILITY_REFUSED { return 22 }

    var operation = pireus_u250_xclbin_material_observation()
    operation.operation_capability_count = 1
    let operation_result = pireus_u250_xclbin_material_project(
        &artifact, &operation)
    if operation_result.valid || operation_result.status !=
        PIREUS_U250_XCLBIN_STATUS_CAPABILITY_REFUSED { return 23 }

    var lowering = pireus_u250_xclbin_material_observation()
    lowering.lowering_requested = true
    let lowering_result = pireus_u250_xclbin_material_project(
        &artifact, &lowering)
    if lowering_result.valid || lowering_result.status !=
        PIREUS_U250_XCLBIN_STATUS_CAPABILITY_REFUSED { return 24 }

    var performance = pireus_u250_xclbin_material_observation()
    performance.performance_present = true
    let performance_result = pireus_u250_xclbin_material_project(
        &artifact, &performance)
    if performance_result.valid || performance_result.status !=
        PIREUS_U250_XCLBIN_STATUS_CAPABILITY_REFUSED { return 25 }

    var claim = pireus_u250_xclbin_material_observation()
    claim.claim_ready_requested = true
    let claim_result = pireus_u250_xclbin_material_project(&artifact, &claim)
    if claim_result.valid || claim_result.status !=
        PIREUS_U250_XCLBIN_STATUS_CLAIM_REFUSED { return 26 }

    if arg_count() == 4 {
        let sealed = pireus_u250_xclbin_material_ingest_file(
            &artifact, get_arg(2))
        if !pireus_u250_xclbin_parity_matches_expected(&sealed) { return 27 }
        let tampered = pireus_u250_xclbin_material_ingest_file(
            &artifact, get_arg(3))
        if tampered.valid || tampered.status !=
            PIREUS_U250_XCLBIN_STATUS_MATERIAL_REFUSED { return 28 }
    }

    print("PIREUS_U250_XCLBIN_MATERIAL_TEST_PASS waiting=1 parity_projection=1 premature=REFUSED missing_bits=REFUSED missing_digest=REFUSED missing_metadata=REFUSED size_drift=REFUSED digest_drift=REFUSED uuid_drift=REFUSED kernel_drift=REFUSED platform_drift=REFUSED clock_drift=REFUSED order_drift=REFUSED interface_drift=REFUSED bank_drift=REFUSED cpp_authority=REFUSED python_authority=REFUSED rust_authority=REFUSED llm_authority=REFUSED child_verdict=REFUSED execution=REFUSED correctness=REFUSED operation=REFUSED lowering=REFUSED performance=REFUSED claim_ready=REFUSED\n")
    0
}
