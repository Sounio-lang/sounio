//@ run-pass
use hardware::pireus::operator_genesis::{
    PIREUS_GENESIS_OK,
    PIREUS_GENESIS_CANDIDATE_COUNT,
    PIREUS_GENESIS_ACTION_COUNT,
    PIREUS_GENESIS_COMPARISONS_PER_CANDIDATE,
    pireus_operator_genesis_request,
    pireus_operator_genesis_evaluate,
    pireus_operator_genesis_matches_frozen_semantics,
    pireus_genesis_digest_nonzero,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_genesis_request()
    let result = pireus_operator_genesis_evaluate(&request)
    if !result.valid || result.error != PIREUS_GENESIS_OK ||
        result.failures != 0 ||
        !pireus_operator_genesis_matches_frozen_semantics(&result) { return 1 }

    if !result.space.valid || result.space.bits != 4 ||
        result.space.dimension != 16 || result.space.coefficient_values != 2 ||
        !result.space.destination_is_xor ||
        !result.space.accumulation_is_ascending_i { return 2 }

    if result.grammar.candidate_count != PIREUS_GENESIS_CANDIDATE_COUNT ||
        !result.grammar.exhaustive || result.grammar.stochastic ||
        !result.grammar.base_twist_table_bound ||
        result.group.coordinate_permutations != 24 ||
        result.group.operand_exchange_actions != 2 ||
        result.group.action_count != PIREUS_GENESIS_ACTION_COUNT ||
        result.group.unique_action_count != PIREUS_GENESIS_ACTION_COUNT ||
        result.group.closure_failures != 0 ||
        result.group.inverse_failures != 0 || !result.group.verified_group ||
        !result.group.lexicographic_sign_order ||
        !result.group.lowest_action_tie_break || result.group.gl4_complete ||
        result.group.sign_gauge_complete || result.group.isotopy_complete {
        return 3
    }

    if result.search.candidates_evaluated !=
            PIREUS_GENESIS_CANDIDATE_COUNT ||
        result.search.actions_per_candidate != PIREUS_GENESIS_ACTION_COUNT ||
        result.search.comparisons_per_candidate !=
            PIREUS_GENESIS_COMPARISONS_PER_CANDIDATE {
        return 4
    }

    var mask_seen: i64 = 0
    var cd_corpus_equivalent: bool = false
    var ordinal: i64 = 0
    while ordinal < PIREUS_GENESIS_CANDIDATE_COUNT {
        let mask = result.search.candidate_masks[ordinal]
        if mask < 0 || mask >= PIREUS_GENESIS_CANDIDATE_COUNT { return 5 }
        let bit = 1 << mask
        if (mask_seen & bit) != 0 { return 6 }
        mask_seen = mask_seen | bit
        if result.search.candidate_canonical_actions[ordinal] < 0 ||
            result.search.candidate_canonical_actions[ordinal] >=
                PIREUS_GENESIS_ACTION_COUNT ||
            result.search.candidate_scores[ordinal] < 0 ||
            result.search.candidate_scores[ordinal] > 256 {
            return 7
        }
        if mask == 0 {
            cd_corpus_equivalent =
                result.search.candidate_equivalent[ordinal] &&
                result.search.candidate_scores[ordinal] == 0
        }
        ordinal = ordinal + 1
    }
    if mask_seen != 65535 || !cd_corpus_equivalent { return 8 }

    let selected = &result.search.selected
    if selected.generation_ordinal < 0 ||
        selected.generation_ordinal >= PIREUS_GENESIS_CANDIDATE_COUNT ||
        selected.phase_mask < 0 ||
        selected.phase_mask >= PIREUS_GENESIS_CANDIDATE_COUNT ||
        selected.canonical_action < 0 ||
        selected.canonical_action >= PIREUS_GENESIS_ACTION_COUNT ||
        selected.score <= 0 ||
        selected.nearest_distance != selected.score ||
        selected.comparisons_completed !=
            PIREUS_GENESIS_COMPARISONS_PER_CANDIDATE ||
        selected.equivalent_to_corpus ||
        !selected.relative_novelty_witnessed { return 9 }

    if !result.witness.present ||
        result.witness.corpus_id != selected.nearest_corpus_id ||
        result.witness.corpus_action != selected.nearest_corpus_action ||
        result.witness.i < 0 || result.witness.i >= 16 ||
        result.witness.j < 0 || result.witness.j >= 16 ||
        result.witness.candidate_value == result.witness.corpus_value ||
        result.witness.hamming_distance != selected.score ||
        result.witness.comparisons_completed !=
            PIREUS_GENESIS_COMPARISONS_PER_CANDIDATE ||
        result.witness.comparisons_expected !=
            PIREUS_GENESIS_COMPARISONS_PER_CANDIDATE { return 10 }

    let fingerprint = &result.fingerprint
    if fingerprint.positive_count + fingerprint.negative_count +
            fingerprint.other_count != 256 ||
        fingerprint.other_count != 0 ||
        fingerprint.commutator_defect_count < 0 ||
        fingerprint.commutator_defect_count > 256 ||
        fingerprint.associator_defect_count < 0 ||
        fingerprint.associator_defect_count > 4096 { return 11 }
    var displacement_negative_sum: i64 = 0
    var displacement: i64 = 0
    while displacement < 16 {
        let count = fingerprint.displacement_negative_counts[displacement]
        if count < 0 || count > 16 { return 12 }
        displacement_negative_sum = displacement_negative_sum + count
        displacement = displacement + 1
    }
    if displacement_negative_sum != fingerprint.negative_count { return 13 }

    if !result.receipt.grammar_hash_bound ||
        !result.receipt.corpus_hash_bound ||
        !result.receipt.group_hash_bound ||
        !result.receipt.exhaustive_search ||
        !result.receipt.relative_semantic_novelty ||
        result.receipt.relative_algebraic_novelty ||
        !result.receipt.declared_action_inequivalence ||
        result.receipt.algebra_isomorphism_complete ||
        result.receipt.source_hash_bound ||
        result.receipt.semantics_hash_bound ||
        result.receipt.algorithmic_novelty ||
        result.receipt.material_novelty ||
        result.receipt.scientific_novelty ||
        result.receipt.global_novelty ||
        result.receipt.historical_novelty ||
        result.receipt.priority_claim ||
        result.receipt.external_prior_art_complete ||
        result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open ||
        result.receipt.material_parity_count != 0 ||
        result.receipt.receipt_frozen || result.receipt.receipt_admitted ||
        result.receipt.parity_open || result.receipt.claim_ready { return 14 }

    if result.negatives.passed != 24 || result.negatives.total != 24 ||
        !result.negatives.python_oracle || !result.negatives.rust_oracle ||
        !result.negatives.cpp_authority || !result.negatives.llm_authority ||
        !result.negatives.parity_prefreeze ||
        !result.negatives.global_promotion ||
        !result.negatives.scientific_promotion ||
        !result.negatives.invalid_waiver ||
        !result.negatives.zero_distance_promotion ||
        !result.negatives.incomplete_exhaustion_promotion { return 15 }

    if !pireus_genesis_digest_nonzero(&result.space_digest) ||
        !pireus_genesis_digest_nonzero(&result.grammar_digest) ||
        !pireus_genesis_digest_nonzero(&result.group_digest) ||
        !pireus_genesis_digest_nonzero(&result.corpus_digest) ||
        !pireus_genesis_digest_nonzero(&result.search_digest) ||
        !pireus_genesis_digest_nonzero(&result.candidate_digest) ||
        !pireus_genesis_digest_nonzero(&result.canonical_digest) ||
        !pireus_genesis_digest_nonzero(&result.fingerprint_digest) ||
        !pireus_genesis_digest_nonzero(&result.witness_digest) ||
        !pireus_genesis_digest_nonzero(&result.receipt_digest) { return 16 }

    print("PIREUS_OPERATOR_GENESIS_EXECUTABLE_OK\n")
    0
}
