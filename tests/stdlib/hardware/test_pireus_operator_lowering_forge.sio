//! Structural tests for the matcher-free v6 Sounio authority executable.

use hardware::pireus::operator_lowering_forge::{
    PIREUS_OLF_OK,
    PIREUS_OLF_TARGET_COUNT,
    pireus_operator_lowering_request,
    pireus_operator_lowering_evaluate,
    pireus_operator_lowering_frozen_mismatch_code,
    pireus_olf_digest_nonzero,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let request = pireus_operator_lowering_request()
    let result = pireus_operator_lowering_evaluate(&request)
    var failures: i64 = 0

    if result.error != PIREUS_OLF_OK || !result.valid ||
        result.failures != 0 {
        failures = failures + 1
    }
    if !result.lineage.complete || !result.grammar.complete ||
        !result.targets.complete || !result.semantics.complete ||
        !result.atlas.complete {
        failures = failures + 1
    }
    if !result.semantics.definitional_reconstruction ||
        result.semantics.parent_relation_failures != 0 ||
        result.semantics.parent_relation_checks <= 0 ||
        result.semantics.roundtrip_word_checks <= 0 ||
        result.semantics.roundtrip_word_failures != 0 {
        failures = failures + 1
    }
    if result.atlas.candidate_count <= 0 ||
        result.atlas.generation_attempts != result.atlas.candidate_count ||
        result.atlas.capacity_overflows != 0 ||
        result.atlas.program_class_count <= 0 ||
        result.atlas.machine_class_count != PIREUS_OLF_TARGET_COUNT {
        failures = failures + 1
    }
    if result.atlas.program_equivalence_failures != 0 ||
        result.atlas.program_separation_failures != 0 ||
        result.atlas.machine_equivalence_failures != 0 ||
        result.atlas.serialization_collapse_failures != 0 ||
        result.atlas.order_separation_failures != 0 {
        failures = failures + 1
    }
    if result.atlas.residual_count != result.atlas.candidate_count ||
        result.atlas.unresolved_obligations <= 0 ||
        result.atlas.refuted_obligations != 0 ||
        result.atlas.admitted_lowerings != 0 ||
        result.atlas.selected_candidate != -1 ||
        result.atlas.ranking_present {
        failures = failures + 1
    }
    if result.negatives.passed != result.negatives.total ||
        !result.negatives.python_oracle || !result.negatives.rust_oracle ||
        !result.negatives.same_graph_collapsed ||
        !result.negatives.different_order_separated ||
        !result.negatives.endpoint_erasure_refused ||
        !result.negatives.residual_fallback_refused {
        failures = failures + 1
    }
    if result.receipt.material_machine_quotient_complete ||
        result.receipt.operator_seed_generated ||
        result.receipt.target_observations_admitted ||
        result.receipt.target_lowerings_admitted ||
        result.receipt.target_costs_admitted ||
        result.receipt.target_performance_admitted ||
        result.receipt.semantics_frozen || result.receipt.formal_parity_open ||
        result.receipt.effect_parity_open ||
        result.receipt.material_parity_open ||
        result.receipt.algorithmic_novelty ||
        result.receipt.material_novelty ||
        result.receipt.historical_novelty || result.receipt.priority_claim ||
        result.receipt.claim_ready {
        failures = failures + 1
    }
    if !pireus_olf_digest_nonzero(&result.lineage_digest) ||
        !pireus_olf_digest_nonzero(&result.grammar_digest) ||
        !pireus_olf_digest_nonzero(&result.target_digest) ||
        !pireus_olf_digest_nonzero(&result.semantic_digest) ||
        !pireus_olf_digest_nonzero(&result.atlas_digest) ||
        !pireus_olf_digest_nonzero(&result.receipt_digest) ||
        !pireus_olf_digest_nonzero(&result.forge_digest) {
        failures = failures + 1
    }
    if pireus_operator_lowering_frozen_mismatch_code(&result) != 0 {
        failures = failures + 1
    }

    print("pireus operator lowering forge structural failures=")
    print_int(failures)
    print("\n")
    if failures == 0 { 0 } else { 1 }
}
