//@ run-pass
//@ requires: slow
//@ timeout: 3600
// Needs minutes, not the default 30 s (multiprobe measured 215 s on lean_single
// 2026-10-06; the .timeout sidecar from the Pireus lane allows 3600 s). Runs in the
// slow lane (SOUNIO_SLOW_TESTS_AVAILABLE).

use hardware::pireus::operator_discovery_engine::{
    PIREUS_ODE_OK,
    pireus_operator_discovery_engine_request,
    pireus_operator_discovery_engine_paths,
    pireus_operator_discovery_engine_execute,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    let request = pireus_operator_discovery_engine_request()
    let paths = pireus_operator_discovery_engine_paths()
    let summary = pireus_operator_discovery_engine_execute(
        &request, &paths, false)
    var failures = summary.structural_failures + summary.group_failures +
        summary.negative_failures
    if !summary.valid || summary.error != PIREUS_ODE_OK ||
        summary.generated <= 0 || summary.typed_admitted <= 0 ||
        summary.typed_rejected <= 0 || summary.quotient_collisions <= 0 ||
        summary.incomplete_searches <= 0 ||
        (summary.n2_relative_novelty == 0 && summary.separators != 0) ||
        (summary.n2_relative_novelty > 0 && summary.separators != 6) ||
        summary.n3_novelty || summary.n4_novelty ||
        summary.historical_novelty || summary.claim_ready {
        failures = failures + 1
    }
    print("pireus operator discovery engine structural failures: ")
    print_int(failures)
    print("\n")
    if failures == 0 { 0 } else { 1 }
}
