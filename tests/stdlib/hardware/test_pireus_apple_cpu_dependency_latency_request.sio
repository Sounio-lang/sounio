//@ run-pass

use hardware::pireus::xor_selector_material_admission::{
    PireusXorMaterialFilePaths,
}
use hardware::pireus::apple_cpu_dependency_latency_request::{
    PireusAppleCpuLatencyParentPaths,
    PIREUS_APPLE_CPU_LATENCY_OK,
    PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT,
    PIREUS_REQUEST_STAGE_TEMPLATE,
    PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND,
    PIREUS_MEASUREMENT_FEASIBILITY_UNKNOWN,
    pireus_apple_cpu_latency_parent_file_matches,
    pireus_apple_cpu_dependency_latency_request_evaluate,
    pireus_apple_cpu_dependency_latency_request_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc, Epistemic {
    if arg_count() != 33 { return 2 }
    let material_files = PireusXorMaterialFilePaths {
        darwin_receipt: get_arg(2), darwin_evidence: get_arg(3),
        apple_receipt: get_arg(4), apple_evidence: get_arg(5),
        dgx_receipt: get_arg(6), dgx_evidence: get_arg(7),
    }
    let parents = PireusAppleCpuLatencyParentPaths {
        garden: get_arg(8),
        target_cost_source: get_arg(9),
        target_cost_semantics: get_arg(10),
        target_cost_receipt: get_arg(11),
        target_cost_evidence: get_arg(12),
        material_source: get_arg(13),
        material_semantics: get_arg(14),
        material_receipt: get_arg(15),
        material_evidence: get_arg(16),
        cost_parent_garden: get_arg(17),
        cost_parent_admission_source: get_arg(18),
        cost_parent_admission_semantics: get_arg(19),
        cost_parent_admission_receipt: get_arg(20),
        cost_parent_admission_evidence: get_arg(21),
        cost_parent_engine_source: get_arg(22),
        cost_parent_engine_semantics: get_arg(23),
        cost_parent_engine_receipt: get_arg(24),
        cost_parent_operation_source: get_arg(25),
        cost_parent_operation_semantics: get_arg(26),
        cost_parent_operation_receipt: get_arg(27),
        material_parent_garden: get_arg(28),
        material_parent_apple_receipt: get_arg(29),
        material_parent_apple_evidence: get_arg(30),
        material_parent_dgx_receipt: get_arg(31),
        material_parent_dgx_evidence: get_arg(32),
    }
    let result = pireus_apple_cpu_dependency_latency_request_evaluate(
        get_arg(0), get_arg(1), &material_files, &parents)
    var failures: i64 = 0
    if !result.valid || result.error != PIREUS_APPLE_CPU_LATENCY_OK ||
        result.failures != 0 || !result.parent_files_valid ||
        !result.target_cost_parent_live || !result.material_engine_parent_live {
        failures = failures + 1
    }
    if !pireus_apple_cpu_dependency_latency_request_matches_frozen_semantics(
        &result) {
        failures = failures + 1
    }
    var i: i64 = 0
    while i < PIREUS_APPLE_CPU_LATENCY_PARENT_FILE_COUNT {
        if !pireus_apple_cpu_latency_parent_file_matches(
            result.parent_file_match_mask, i) {
            failures = failures + 1
        }
        i = i + 1
    }
    if !result.request_template_valid || !result.material_instance_valid ||
        !result.target_matches_instance || !result.subject_matches_receipt ||
        !result.quantity_eligible ||
        !result.engine_identity_materially_admitted ||
        !result.ontology_binding_valid || result.ontology_triple_count <= 0 {
        failures = failures + 1
    }
    if result.stage.from_tag != PIREUS_REQUEST_STAGE_TEMPLATE ||
        result.stage.to_tag != PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND ||
        result.binding.state_tag !=
            PIREUS_REQUEST_STAGE_MATERIAL_IDENTITY_BOUND ||
        result.binding.execution_authorization_id != 0 ||
        result.binding.measurement_feasibility !=
            PIREUS_MEASUREMENT_FEASIBILITY_UNKNOWN {
        failures = failures + 1
    }
    if result.measurement_interface_ready || result.execution_authorized ||
        result.environment_bound || result.value_present ||
        result.material_observation_present || result.derived_summary_present ||
        result.comparison_present || result.speedup_present ||
        result.ranking_present || result.parity_open || result.claim_ready {
        failures = failures + 1
    }
    if result.negatives.total <= 0 ||
        result.negatives.passed != result.negatives.total {
        failures = failures + 1
    }
    var manifest_digest_nonzero = false
    var ontology_digest_nonzero = false
    var result_digest_nonzero = false
    i = 0
    while i < 8 {
        if result.parent_manifest_digest.words[i as usize] != 0 {
            manifest_digest_nonzero = true
        }
        if result.ontology_digest.words[i as usize] != 0 {
            ontology_digest_nonzero = true
        }
        if result.result_digest.words[i as usize] != 0 {
            result_digest_nonzero = true
        }
        i = i + 1
    }
    if !manifest_digest_nonzero || !ontology_digest_nonzero ||
        !result_digest_nonzero {
        failures = failures + 1
    }
    if failures == 0 {
        print("pireus Apple CPU dependency latency request test passed\n")
        0
    } else {
        print("pireus Apple CPU dependency latency request test failed: ")
        print_int(failures); print("\n")
        1
    }
}
