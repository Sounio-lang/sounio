//@ run-pass

//@ expect-stdout: FMRI_CONNECTIVITY_E2E_OK
//@ contract-adjustment: promoted to run-pass support role for active fmri callable APIs
// Support-lane runtime checks for active fmri preprocessing/connectivity APIs.

use fmri::preprocess::{motion_params_new, framewise_displacement, gaussian_kern_new, bandpass_config_rsfmri, demean}
use fmri::connectivity::{pearson_corr, compute_fc, node_degree}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic, IO {
    var fail = 0

    let mp0 = motion_params_new()
    let mp1 = motion_params_new()
    if !check_near(framewise_displacement(mp0, mp1), 0.0, 0.001) { fail = fail + 1 }

    let kern = gaussian_kern_new(6.0, 2.0)
    if kern.size < 3 || kern.sigma <= 0.0 { fail = fail + 1 }

    let bp = bandpass_config_rsfmri(2.0)
    if !(bp.low_cutoff < bp.high_cutoff) { fail = fail + 1 }

    var ts: [f64; 200] = [0.0; 200]
    ts[0] = 5.0
    ts[1] = 5.0
    ts[2] = 5.0
    ts[3] = 5.0
    ts[4] = 5.0
    let dm = demean(ts, 5)
    if !check_near(dm[0], 0.0, 0.001) { fail = fail + 1 }

    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    x[0] = 1.0
    x[1] = 2.0
    x[2] = 3.0
    x[3] = 4.0
    x[4] = 5.0
    y[0] = 1.0
    y[1] = 2.0
    y[2] = 3.0
    y[3] = 4.0
    y[4] = 5.0

    let r = pearson_corr(x, y, 5)
    if !check_near(r, 1.0, 0.05) { fail = fail + 1 }

    let fc = compute_fc(x, y, 5)
    if fc.ci_lower > fc.ci_upper { fail = fail + 1 }

    var row: [f64; 10] = [0.0; 10]
    row[0] = 0.1
    row[1] = 0.8
    row[2] = 0.9
    row[3] = 0.2
    if node_degree(row, 4, 0.5) != 2 { fail = fail + 1 }

    if fail > 0 {
        return 1
    }

    print("FMRI_CONNECTIVITY_E2E_OK\n")
    0
}

fn main() -> i32 with Mut, Div, Panic, IO {
    run_tests()
}
