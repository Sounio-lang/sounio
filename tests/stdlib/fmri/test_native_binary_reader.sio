//@ run-pass
//@ expect-stdout: NIFTI_NATIVE_BINARY_READ_OK
use fmri::nifti::{NiftiVersion,NiftiEndian,nifti_file_buffer_new,nifti_header_new,nifti_read_file_buffer_into,nifti_parse_header_buffer_into}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var a=nifti_file_buffer_new()
 assert(nifti_read_file_buffer_into("tests/fixtures/fmri/tiny_real_slice_nifti1.nii",&!a)==0)
 assert(a.len==384)
 assert(a.data[2]==0 as u8)
 assert(a.data[352]==10 as u8)
 assert(a.data[383]==41 as u8)
 var ha=nifti_header_new()
 assert(nifti_parse_header_buffer_into(&a,&!ha)==0)
 assert(ha.nx==2 && ha.ny==2 && ha.nz==2 && ha.nt==4)
 assert(ha.version==NiftiVersion::Nifti1 && ha.endian==NiftiEndian::Little)
 var b=nifti_file_buffer_new()
 assert(nifti_read_file_buffer_into("tests/fixtures/fmri/tiny_real_slice_nifti2.nii",&!b)==0)
 assert(b.len==576)
 assert(b.data[2]==0 as u8)
 assert(b.data[544]==30 as u8)
 assert(b.data[575]==61 as u8)
 var hb=nifti_header_new()
 assert(nifti_parse_header_buffer_into(&b,&!hb)==0)
 assert(hb.vox_offset==544)
 assert(hb.version==NiftiVersion::Nifti2 && hb.endian==NiftiEndian::Little)
 println("NIFTI_NATIVE_BINARY_READ_OK")
 0
}
