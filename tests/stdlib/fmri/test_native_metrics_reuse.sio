//@ run-pass
//@ expect-stdout: FMRI_NATIVE_REUSE_OK
use fmri::nifti::{nifti_file_buffer_new,nifti_header_new,nifti_read_file_buffer_into,nifti_parse_header_buffer_into}
use fmri::pipeline_real::{fmri_native_metrics_new,fmri_calculate_native}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var a=nifti_file_buffer_new()
 var b=nifti_file_buffer_new()
 var motion=nifti_file_buffer_new()
 assert(nifti_read_file_buffer_into("tests/fixtures/fmri/tiny_real_slice_nifti1.nii",&!a)==0)
 assert(nifti_read_file_buffer_into("tests/fixtures/fmri/tiny_real_slice_nifti2.nii",&!b)==0)
 assert(nifti_read_file_buffer_into("tests/fixtures/fmri/tiny_real_motion.tsv",&!motion)==0)
 var ha=nifti_header_new()
 var hb=nifti_header_new()
 assert(nifti_parse_header_buffer_into(&a,&!ha)==0)
 assert(nifti_parse_header_buffer_into(&b,&!hb)==0)
 var result=fmri_native_metrics_new()
 assert(fmri_calculate_native(&a,&ha,&b,&hb,&motion,&!result)==0)
 assert(result.status==0 && result.tsnr_status==0 && result.fc_status==0)
 let count=ha.nx*ha.ny*ha.nz*ha.nt
 var i:i64=0
 while i<count {a.data[(ha.vox_offset+i) as usize]=1 as u8;i=i+1}
 assert(fmri_calculate_native(&a,&ha,&b,&hb,&motion,&!result)==0)
 assert(result.status==0 && result.tsnr_status!=0 && result.fc_status!=0 && result.ci_status!=0)
 assert(result.tsnr_median==0.0 && result.fc_r==0.0 && result.fc_ci_width==0.0)
 assert(result.dvars_status==0 && result.dvars_median==0.0 && result.nframes==ha.nt)
 motion.len=0
 assert(fmri_calculate_native(&a,&ha,&b,&hb,&motion,&!result)==22)
 assert(result.status==22 && result.nframes==0 && result.fd_mean==0.0)
 assert(result.tsnr_status!=0 && result.fc_status!=0 && result.ci_status!=0)
 println("FMRI_NATIVE_REUSE_OK")
 0
}
