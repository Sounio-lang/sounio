//@ run-pass
//@ expect-stdout: SCIENCE_FMRI_OK
// Real fixture fMRI lane: native NIfTI load + pinned regression metrics (see pipeline_golden.v1.json).

use fmri::nifti::{nifti_file_buffer_new, nifti_parse_header_buffer_into, nifti_header_new, nifti_error_code, NiftiError}
use fmri::pipeline_real::{run_fmri_pipeline_gate}

fn bad_magic_probe_passes() -> bool  with Mut{
    var bad_buf = nifti_file_buffer_new()
    bad_buf.len = 352
    var out = nifti_header_new()
    nifti_parse_header_buffer_into(&bad_buf, &!out) == nifti_error_code(NiftiError::BadMagic)
}

fn truncated_probe_passes() -> bool  with Mut{
    var truncated_buf = nifti_file_buffer_new()
    truncated_buf.len = 8
    var out = nifti_header_new()
    nifti_parse_header_buffer_into(&truncated_buf, &!out) == nifti_error_code(NiftiError::TruncatedFile)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    if !bad_magic_probe_passes() {
        return 2
    }
    if !truncated_probe_passes() {
        return 3
    }

    let rc = run_fmri_pipeline_gate(
        "tests/fixtures/fmri/tiny_real_slice_nifti1.nii",
        "tests/fixtures/fmri/tiny_real_slice_nifti2.nii",
        "tests/fixtures/fmri/tiny_real_motion.tsv"
    )
    if rc != 0 {
        return rc
    }

    print("SCIENCE_FMRI_OK\n")
    0
}
