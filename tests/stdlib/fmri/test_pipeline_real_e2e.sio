//@ ignore
//@ expect-stdout: SCIENCE_FMRI_OK
//
// 🚨 BLOQUEADO POR DEFEITO DE COMPILADOR, não por este teste. Marcado `ignore` com o motivo
// nomeado — não para ficar verde, mas para não fingir. Ver docs/E201_NOME_DESCONHECIDO.md.
//
// Este arquivo estava `run-pass` e PASSAVA imprimindo SCIENCE_FMRI_OK sem jamais abrir um
// arquivo: `run_fmri_pipeline_gate` não existia e o compilador devolvia 0 em silêncio. O E201
// (28-ago-2026) derrubou o disfarce, e o gate real foi escrito em stdlib/fmri/pipeline_real.sio.
//
// Com o gate de verdade, a cadeia inteira apareceu, em três camadas:
//   1. `nifti_read_file_buffer_into` rejeitava todo binário como truncado, porque checava
//      `read_file(path).len()` — que é strlen e para no primeiro NUL (offset 2 nesta fixture).
//      CONSERTADO: o limite passa a vir de `file_size` (stat).
//   2. `nifti_str_byte_u8` limitava o índice por `src.len()`, o mesmo strlen.
//      CONSERTADO: `nifti_byte_at(src, idx, limit)` com limite explícito.
//   3. 🔴 NÃO CONSERTADO: `read_file` devolve `string` e os acessores declaram `[i8; 0]`.
//      A chamada é erro de tipo (E001) e o que o compilador emite lê ZEROS. A pista NIfTI
//      nativa nunca foi bem-tipada. Consertar exige decisão de linguagem — uma primitiva de
//      indexação de bytes sobre `string`, ou `read_file` devolvendo um tipo de bytes.
//
// A fixture está PERFEITA (verificada byte a byte): NIfTI-1, magic n+1, dim 2x2x2x4, uint8,
// vox_offset 352, 384 bytes exatos. O defeito nunca foi dela.
// Real executable fMRI lane using native NIfTI parse/load path.

// `use fmri::*` não importava NADA: stdlib/fmri/lib.sio é só documentação, sem uma única
// declaração de módulo. Os nomes nifti_* resolviam por permissividade do compilador, não por
// import. Ver o E201 (28-ago-2026).
use fmri::nifti::*
use fmri::pipeline_real::*

fn bad_magic_probe_passes() -> bool  with Mut{
    var bad_buf = nifti_file_buffer_new()
    bad_buf.len = 352
    var out = nifti_header_new()
    nifti_parse_header_buffer_into(&bad_buf, &!out) == nifti_error_code(NiftiError::BadMagic)
}

fn truncated_probe_passes() -> bool  with Mut{
    var truncated_buf = nifti_file_buffer_new()
    truncated_buf.len = 8
    var out = nifti_header_new()
    nifti_parse_header_buffer_into(&truncated_buf, &!out) == nifti_error_code(NiftiError::TruncatedFile)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    if !bad_magic_probe_passes() {
        return 2
    }
    if !truncated_probe_passes() {
        return 3
    }

    let rc = run_fmri_pipeline_gate(
        "tests/fixtures/fmri/tiny_real_slice_nifti1.nii",
        "tests/fixtures/fmri/tiny_real_slice_nifti2.nii",
        "tests/fixtures/fmri/tiny_real_motion.tsv"
    )
    if rc != 0 {
        return rc
    }

    print("SCIENCE_FMRI_OK\n")
    0
}
