// Import-free physics foundations run shard (Madaros imported-module run SIGSEGV).
// Emits SCIENCE_METRIC physics lines pinned in pipeline_golden.v1.json.

fn f64_sub(a: f64, b: f64) -> f64 {
    if a >= b { a - b } else { b - a }
}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    f64_sub(a, b) < tol
}

fn sqrt_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 30 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC physics ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let c_light = 299792458.0
    let r_gas = 8.314462618
    let k_e = 8.987551789e9

    let newton_f = 2.0 * 3.0
    emit_metric("newton_force_N", newton_f)

    let ke = 0.5 * 2.0 * 3.0 * 3.0
    emit_metric("ke_J", ke)

    let pos = 0.0 + 1.0 * 2.0 + 0.5 * 0.5 * 2.0 * 2.0
    emit_metric("position_m", pos)

    let coulomb = k_e * 1.0e-6 * 1.0e-6 / (0.1 * 0.1)
    emit_metric("coulomb_f_N", coulomb)

    emit_metric("wave_ey_Vpm", 100.0)

    let theta = 1.5708
    let cos_t = 1.0 - (theta * theta) / 2.0 + (theta * theta * theta * theta) / 24.0
    let sin_t = theta - (theta * theta * theta) / 6.0
    let pol_rz = 1.0 * sin_t
    emit_metric("pol_rot_rz", pol_rz)

    let beta = 0.6
    let gamma_v = 1.0 / sqrt_approx(1.0 - beta * beta)
    emit_metric("gamma_beta06", gamma_v)
    emit_metric("time_dil_factor", gamma_v)

    let u = 0.5 * c_light
    let v = 0.5 * c_light
    let vel_add = (u + v) / (1.0 + u * v / (c_light * c_light))
    emit_metric("vel_add_w", vel_add)

    let p_gas = 1.0 * r_gas * 300.0 / 0.024
    emit_metric("ideal_gas_P_Pa", p_gas)

    let du = if 100.0 >= 40.0 { f64_sub(100.0, 40.0) } else { 0.0 }
    emit_metric("first_law_du_J", du)

    let eta = if 1.0 >= 300.0 / 600.0 { f64_sub(1.0, 300.0 / 600.0) } else { 0.0 }
    emit_metric("carnot_eta", eta)

    let classical_ok = check_near(newton_f, 6.0, 0.1) && check_near(ke, 9.0, 1e-6) && check_near(pos, 3.0, 1e-6)
    emit_metric("classical_ok", bool_to_f64(classical_ok))

    let em_ok = check_near(coulomb, 0.8988, 0.01) && check_near(pol_rz, 1.0, 0.1)
    emit_metric("em_ok", bool_to_f64(em_ok))

    let sr_ok = check_near(gamma_v, 1.25, 0.01) && check_near(vel_add, 0.8 * c_light, 0.01 * c_light)
    emit_metric("sr_ok", bool_to_f64(sr_ok))

    let thermo_ok = check_near(p_gas, 103932.5, 500.0) && check_near(du, 60.0, 1.0) && check_near(eta, 0.5, 0.01)
    emit_metric("thermo_ok", bool_to_f64(thermo_ok))

    var ok_count = 0.0
    if classical_ok { ok_count = ok_count + 4.0 }
    if em_ok { ok_count = ok_count + 5.0 }
    if sr_ok { ok_count = ok_count + 3.0 }
    if thermo_ok { ok_count = ok_count + 3.0 }
    emit_metric("tests_passed", ok_count)

    if classical_ok && em_ok && sr_ok && thermo_ok {
        print("SCIENCE_PHYSICS_OK\n")
        return 0
    }
    return 1
}