//@ run-pass
//@ expect-stdout: MECHANICS_CHECKED_ROWS_OK
use units::lib::*
use physics::mechanics::*
use physics::uncertainty::{PhysicsScalarResult}
fn row(name:string,r:PhysicsScalarResult) with IO {
 print("MECH_ROW ");print(name);print(" ");print_int(r.status);print(" ")
 print_int(f64_to_bits(r.value));print(" ");print_int(f64_to_bits(r.standard_uncertainty))
 print(" ");print_int(r.uncertainty_model);print(" ");print_int(if r.first_order {1} else {0});print("\n")
}
fn main()->i32 with IO,Mut,Div,Panic {
 let m=q_mass(2.0,0.1);let v=q_velocity(3.0,0.1)
 row("ke",kinetic_energy_q_checked(&m,&v))
 let k=quantity_new(100.0,2.0,dim_spring_constant());let x=q_length(0.5,0.01)
 row("spring",hookean_force_q_checked(&k,&x))
 let f=q_force(10.0,0.1);let d=q_length(5.0,0.2)
 row("work",work_done_q_checked(&f,&d))
 let e=q_energy(100.0,3.0);let t=q_time(2.0,0.1)
 row("power",power_q_checked(&e,&t))
 let one=q_mass(1.0,0.01);let earth=q_mass(5.972e24,1e21);let radius=q_length(6.371e6,100.0)
 row("gravity",gravitational_force_q_checked(&one,&earth,&radius))
 let g=quantity_new(2.0,0.01,dim_gravitational_constant());let a=q_mass(3.0,0.1);let b=q_mass(5.0,0.2);let r=q_length(4.0,0.01)
 row("gravity-explicit",gravitational_force_with_g_checked(&g,&a,&b,&r))
 let zero_v=q_velocity(0.0,1.0);row("ke-zero",kinetic_energy_q_checked(&m,&zero_v))
 let zero_f=q_force(0.0,1.0);row("work-zero",work_done_q_checked(&zero_f,&d))
 let zero_e=q_energy(0.0,3.0);row("power-zero",power_q_checked(&zero_e,&t))
 let zero_mass=q_mass(0.0,0.2);row("gravity-zero",gravitational_force_with_g_checked(&g,&zero_mass,&b,&r))
 let bad_dim=q_length(2.0,0.1);row("bad-dim",kinetic_energy_q_checked(&bad_dim,&v))
 let bad_unc=q_mass(2.0,0.0-0.1);row("bad-unc",kinetic_energy_q_checked(&bad_unc,&v))
 let bad_nan=q_velocity(bits_to_f64(9221120237041090560),0.1);row("bad-nan",kinetic_energy_q_checked(&m,&bad_nan))
 let bad_mass=q_mass(0.0-1.0,0.1);row("bad-mass",kinetic_energy_q_checked(&bad_mass,&v))
 let no_time=q_time(0.0,0.0);row("bad-time",power_q_checked(&e,&no_time))
 let no_radius=q_length(0.0,0.0);row("bad-radius",gravitational_force_q_checked(&one,&earth,&no_radius))
 let negative_k=quantity_new(0.0-1.0,0.0,dim_spring_constant());row("bad-spring",hookean_force_q_checked(&negative_k,&x))
 let huge_f=q_force(1e308,0.0);let huge_d=q_length(1e308,0.0);row("overflow",work_done_q_checked(&huge_f,&huge_d))
 let tiny_f=q_force(1.0,bits_to_f64(1));let half=q_length(0.5,0.0);row("underflow",work_done_q_checked(&tiny_f,&half))
 let wrapper=kinetic_energy_q(q_mass(1.0,0.0),q_velocity(10.0,0.0))
 assert(wrapper.value==50.0 && dim_eq(wrapper.dim,dim_energy()))
 println("MECHANICS_CHECKED_ROWS_OK")
 0
}
