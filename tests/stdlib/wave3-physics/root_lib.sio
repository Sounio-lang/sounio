//@ run-pass
//@ expect-stdout: MECHANICS_ROOT_LIB_OK
use physics::lib::*
use units::lib::*
fn main()->i32 with IO,Mut,Div,Panic {
 let q=kinetic_energy_q(q_mass(1.0,0.0),q_velocity(10.0,0.0))
 assert(q.value==50.0 && dim_eq(q.dim,dim_energy()))
 let energy=q_energy(100.0,3.0);let time=q_time(2.0,0.1)
 let result=power_q_checked(&energy,&time)
 assert(result.status==0 && result.value==50.0 && result.standard_uncertainty>0.0)
 println("MECHANICS_ROOT_LIB_OK")
 0
}
