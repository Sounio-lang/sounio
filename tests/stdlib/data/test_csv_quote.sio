// Run-proof for data::csv RFC-4180 field quoting — byte-exact against
// tests/stdlib/data/fixtures/csv_quoting.csv (which round-trips through Python's
// csv.reader to the raw fields below).
//
// csv_field_str must quote a field iff it contains a comma, a double quote, CR or
// LF (RFC 4180 §2.5-2.7); an embedded double quote is doubled. Plain fields are
// emitted unquoted (so the existing pk_basic header/rows are unaffected).
use data::csv::*

fn main() -> i32 with IO, Mut, Div, Panic {
    var c: i64 = 0
    c = csv_field_str(c, "name")
    c = csv_field_str(c, "note")
    c = csv_end_row(c)

    c = csv_field_str(c, "Smith, John")       // comma -> quote
    c = csv_field_str(c, "he said \"hi\"")    // embedded quote -> quote + double
    c = csv_end_row(c)

    c = csv_field_str(c, "line1\nline2")       // embedded LF -> quote
    c = csv_field_str(c, "plain")              // no special chars -> unquoted
    c = csv_end_row(c)

    return 0
}
