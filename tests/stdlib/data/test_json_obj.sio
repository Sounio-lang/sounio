// Run-proof for data::json — byte-exact flat JSON object to stdout.
// Must reproduce tests/stdlib/data/fixtures/pk_obj.json exactly and parse as
// valid JSON (jq) in scripts/data_io_json_gate.sh.
//
// Member count is threaded explicitly (like data::csv's column index): a comma
// is emitted before every member except the first. Numbers use the same integer
// fixed-point emission as data::csv (no print_f64). Keys here are escape-free
// literals; escaping arrives with json_member_str in the next cycle.
use data::json::*

fn main() -> i32 with IO, Mut, Div, Panic {
    json_obj_open()
    var n: i64 = 0
    n = json_member_int(n, "time_min", 30)
    n = json_member_int(n, "dose_mg", 500)
    n = json_member_f64(n, "conc_mg_l", 12.34, 3)
    json_obj_close()
    print("\n")
    return 0
}
