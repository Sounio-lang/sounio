// Run-proof for data::json nested structures + null/bool — a real PK dataset
// export. Byte-exact against tests/stdlib/data/fixtures/pk_dataset.json and
// jq-valid.
//
// Exercises json_member_key (a member whose value is opened by the caller, here
// an array -> nesting), json_member_bool, and json_member_null. The second record
// is below the limit of quantification (BLQ): its concentration and uncertainty
// are JSON null, the canonical encoding of a missing measurement.
use data::json::*

fn main() -> i32 with IO, Mut, Div, Panic {
    json_obj_open()
    var n: i64 = 0
    n = json_member_str(n, "drug", "vancomycin")
    n = json_member_str(n, "unit_conc", "mg/L")
    n = json_member_key(n, "records")
    json_arr_open()

    var k: i64 = 0

    k = json_arr_sep(k)
    json_obj_open()
    var m0: i64 = 0
    m0 = json_member_int(m0, "time_min", 30)
    m0 = json_member_f64(m0, "conc", 24.5, 3)
    m0 = json_member_f64(m0, "u_c", 0.208, 3)
    m0 = json_member_bool(m0, "blq", false)
    json_obj_close()

    k = json_arr_sep(k)
    json_obj_open()
    var m1: i64 = 0
    m1 = json_member_int(m1, "time_min", 480)
    m1 = json_member_null(m1, "conc")
    m1 = json_member_null(m1, "u_c")
    m1 = json_member_bool(m1, "blq", true)
    json_obj_close()

    json_arr_close()
    json_obj_close()
    print("\n")
    return 0
}
