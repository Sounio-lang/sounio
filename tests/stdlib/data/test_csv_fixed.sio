// Run-proof for data::csv fixed-point decimal fields — byte-exact against
// tests/stdlib/data/fixtures/pk_conc.csv.
//
// Concentrations are carried as scaled integers (value * 10^decimals) so all
// formatting is integer arithmetic — no print_f64 (unavailable on Madaros
// v0.80.0). csv_field_fixed(col, scaled, decimals) must zero-pad the fractional
// part to exactly `decimals` digits: 8005/3 -> "8.005", 0/3 -> "0.000".
use data::csv::*

fn main() -> i32 with IO, Mut, Div, Panic {
    var c: i64 = 0
    c = csv_field_str(c, "subject")
    c = csv_field_str(c, "time_min")
    c = csv_field_str(c, "conc_mg_l")
    c = csv_end_row(c)

    c = csv_field_int(c, 1)
    c = csv_field_int(c, 0)
    c = csv_field_fixed(c, 0, 3)
    c = csv_end_row(c)

    c = csv_field_int(c, 1)
    c = csv_field_int(c, 30)
    c = csv_field_fixed(c, 12340, 3)
    c = csv_end_row(c)

    c = csv_field_int(c, 1)
    c = csv_field_int(c, 60)
    c = csv_field_fixed(c, 8005, 3)
    c = csv_end_row(c)

    return 0
}
