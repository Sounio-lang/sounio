// Run-proof for data::csv f64 fixed-point fields — byte-exact against
// tests/stdlib/data/fixtures/pk_f64.csv.
//
// csv_field_f64(col, value, decimals) rounds an f64 to `decimals` places
// (round-half-up via +0.5 before truncation) and emits it zero-padded, sign
// preserved. This is the primitive the GUM value / u_c columns build on. No
// print_f64 (unavailable): scaling is f64 mul, then `as i64`, then integer
// digit emission. Negative literals are written `0.0 - x` (no unary minus).
use data::csv::*

fn main() -> i32 with IO, Mut, Div, Panic {
    var c: i64 = 0
    c = csv_field_str(c, "value")
    c = csv_end_row(c)

    c = csv_field_f64(c, 12.34, 4)
    c = csv_end_row(c)

    c = csv_field_f64(c, 0.290402, 4)
    c = csv_end_row(c)

    c = csv_field_f64(c, 98.3, 4)
    c = csv_end_row(c)

    c = csv_field_f64(c, 0.0 - 1.5, 4)
    c = csv_end_row(c)

    return 0
}
