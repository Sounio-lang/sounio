// Run-proof for data::json arrays — a multi-row PK table emitted as a JSON array
// of objects. Byte-exact against tests/stdlib/data/fixtures/pk_table.json and
// jq-valid.
//
// json_arr_open/close bracket the array; json_arr_sep is called before each
// element and emits a comma for every element except the first (element count
// threaded, like member/column counts elsewhere). Each row is a JSON object with
// a time, a concentration and its combined standard uncertainty column.
use data::json::*

fn main() -> i32 with IO, Mut, Div, Panic {
    var times: [i64; 2] = [0; 2]
    times[0 as usize] = 30
    times[1 as usize] = 60

    var concs: [f64; 2] = [0.0; 2]
    concs[0 as usize] = 12.34
    concs[1 as usize] = 8.005

    var us: [f64; 2] = [0.0; 2]
    us[0 as usize] = 0.45
    us[1 as usize] = 0.32

    json_arr_open()
    var k: i64 = 0
    var row: i64 = 0
    while row < 2 {
        k = json_arr_sep(k)
        json_obj_open()
        var n: i64 = 0
        n = json_member_int(n, "time_min", times[row as usize])
        n = json_member_f64(n, "conc_mg_l", concs[row as usize], 3)
        n = json_member_f64(n, "u_c", us[row as usize], 3)
        json_obj_close()
        row = row + 1
    }
    json_arr_close()
    print("\n")
    return 0
}
