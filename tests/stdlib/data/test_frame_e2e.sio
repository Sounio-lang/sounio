//@ check-only
// E2E test for stdlib/data/frame
// Tests: DataFrame, Column, dataframe_new, dataframe_ncols, dataframe_nrows,
//        dataframe_shape, column_is_numeric, EpistemicResult

use data::frame::*

fn run_tests() -> i32 {
    // Test 1: Create empty dataframe
    let df = dataframe_new()
    let nc = dataframe_ncols(df)
    if nc != 0 { return 1 }

    // Test 2: nrows of empty dataframe should be 0
    let df2 = dataframe_new()
    let nr = dataframe_nrows(df2)
    if nr != 0 { return 1 }

    // Test 3: has_column on empty dataframe should be false
    let df3 = dataframe_new()
    let has = dataframe_has_column(df3, "x")
    if has { return 1 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
