//@ check-only
// E2E test for stdlib/data/csv_loader
// Tests: Edge, WeightedEdge, NetworkData, parse_edge_list,
//        validate_edge_list, to_adjacency_list

use data::csv_loader::*

fn run_tests() -> i32 with Mut, Div, Panic {
    // Test 1: Parse simple unweighted triangle graph
    let csv = "0,1\n1,2\n2,0\n"
    let net = parse_edge_list(csv)
    if net.num_nodes != 3 { return 1 }
    if net.weighted { return 1 }

    // Test 2: Validate edge list
    let valid = validate_edge_list(&net)
    if valid == false { return 1 }

    // Test 3: Convert to adjacency list
    let adj = to_adjacency_list(&net)
    if adj.len() != 3 { return 1 }

    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    return run_tests()
}
