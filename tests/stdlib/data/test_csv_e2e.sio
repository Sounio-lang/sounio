//@ run-pass
//@ requires: madaros
//@ expect-stdout: DATA_CSV_LOADER_OK
// Madaros only: stdlib/data/csv_loader.sio compares characters with character
// literals ('0', '-', ' ', '\t'), which lean_single does not have and now refuses
// at the lexer. It used to skip the quotes, so `c >= '0' && c <= '9'` compiled as
// `c >= 0 && c <= 9`, and `char_at` is an unknown method there; this test passed on
// lean_single without exercising a correct loader. Madaros does not typecheck the
// module today either (E001, csv_loader.sio:48), which its corpus baseline records.
use data::csv_loader::*;

fn main() -> i32 with IO, Mut, Div, Panic {
    let csv = "0,1\n"
    let net = parse_edge_list(csv)
    if net.weighted { return 1 }
    println("DATA_CSV_LOADER_OK")
    0
}
