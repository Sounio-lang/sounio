//@ run-pass
//@ expect-stdout: DATA_CSV_LOADER_OK
// stdlib/data/csv_loader.sio compares byte codes from str_char_at rather than
// character literals, so it now runs on both engines (it used to be Madaros-only:
// lean_single refuses character literals at the lexer).
use data::csv_loader::*;

fn main() -> i32 with IO, Mut, Div, Panic {
    let csv = "0,1\n"
    let net = parse_edge_list(csv)
    if net.weighted { return 1 }
    println("DATA_CSV_LOADER_OK")
    0
}
