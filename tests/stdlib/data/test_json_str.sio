// Run-proof for data::json string escaping (RFC 8259 §7) — byte-exact against
// tests/stdlib/data/fixtures/pk_str.json and jq-valid.
//
// The raw label contains a quote, a backslash, a newline and a tab; the writer
// must escape them to \" \\ \n \t. json_member_str escapes both the key and the
// value through the same escaper.
use data::json::*

fn main() -> i32 with IO, Mut, Div, Panic {
    json_obj_open()
    var n: i64 = 0
    n = json_member_str(n, "label", "q=\" bs=\\ nl=\n tab=\t end")
    n = json_member_str(n, "note", "plain")
    json_obj_close()
    print("\n")
    return 0
}
