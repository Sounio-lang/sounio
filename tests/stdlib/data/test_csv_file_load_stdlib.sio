// Run-proof for the file-based CSV data pipeline (originally compiler-blocked, now unblocked):
// read a CSV file from disk with the read_file builtin, parse it via csv_parse_string, and compute
// column statistics. Fixture: tests/stdlib/data/fixtures/sample.csv (1.5,2,3 / 4,5,6 / 7,8,9).
// Path is repo-relative (the gate runs from the repo root). lean_single engine.
use csv::parser::*
fn ae(a: f64, b: f64) -> f64 { if a > b { a - b } else { b - a } }
fn main() -> i32 with IO, Mut, Div, Panic {
    // load the file straight off disk
    let s = read_file("tests/stdlib/data/fixtures/sample.csv")
    if str_len(s) <= 0 { print("FAIL read\n"); return 1 }
    // one-call parse of the string contents
    var t = csv_table_new()
    let rc = csv_parse_string(s, &!t, 44 as u8)
    if rc != 0 { print("FAIL rc\n"); return 2 }
    if t.n_rows != 3 || t.n_cols != 3 { print("FAIL shape\n"); return 3 }
    // every cell + column aggregates from the loaded file
    if ae(csv_table_get(&t, 0, 0), 1.5) >= 1.0e-9 { print("FAIL cell00\n"); return 4 }
    if ae(csv_table_get(&t, 2, 2), 9.0) >= 1.0e-9 { print("FAIL cell22\n"); return 5 }
    if ae(csv_col_sum(&t, 0), 12.5) >= 1.0e-9 { print("FAIL sum\n"); return 6 }    // 1.5+4+7
    if ae(csv_col_mean(&t, 1), 5.0) >= 1.0e-9 { print("FAIL mean\n"); return 7 }    // (2+5+8)/3
    if ae(csv_col_max(&t, 2), 9.0) >= 1.0e-9 { print("FAIL max\n"); return 8 }
    if ae(csv_col_min(&t, 0), 1.5) >= 1.0e-9 { print("FAIL min\n"); return 9 }
    print("CSV_FILE_LOAD_STDLIB_OK\n")
    return 0
}
