// Run-proof for stdlib data::csv — byte-exact CSV writer to stdout.
//
// Emits a PK-shaped table and must reproduce tests/stdlib/data/fixtures/pk_basic.csv
// exactly (compared with `cmp` in scripts/data_io_csv_gate.sh).
//
// Trilha A of the Data & Science I/O vertical: stdout sink only — no read_file/
// write_file/str_from_bytes (all mis-lower `&buf` to a builtin on Madaros v0.80.0;
// see docs/audit/DATA_IO_LANE_COMPILER_BLOCKER_2026-07-13.md). When write_file is
// fixed (Trilha B) the same field logic re-targets a file with no rewrite.
//
// Importing programs on current Madaros must inline all logic into main() and call
// only imported free functions — no local helpers, no print_f64
// (docs/audit/MADAROS_MULTIMODULE_PRINT_IMPORT_BUGS_2026-07-13.md). This driver
// obeys that: column state is threaded explicitly through csv_field_* return values.
use data::csv::*

fn main() -> i32 with IO, Mut, Div, Panic {
    var c: i64 = 0
    c = csv_field_str(c, "subject")
    c = csv_field_str(c, "time_min")
    c = csv_field_str(c, "dose_mg")
    c = csv_end_row(c)

    c = csv_field_int(c, 1)
    c = csv_field_int(c, 0)
    c = csv_field_int(c, 500)
    c = csv_end_row(c)

    c = csv_field_int(c, 1)
    c = csv_field_int(c, 30)
    c = csv_field_int(c, 500)
    c = csv_end_row(c)

    return 0
}
