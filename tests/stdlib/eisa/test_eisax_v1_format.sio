// validated_lane: lean_single
//@ run-pass

use eisa::format::*

fn build_v0_base() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b.consts[0] = 1.0
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0
    b.ops[1] = op_egate()
    b.dsts[1] = 0
    b.as_[1] = 0
    b.bs_[1] = 0
    b.n_code = 2
    b
}

fn build_v1_base(fuel: i64) -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, fuel)
    b.consts[0] = 2.0
    b.consts[1] = 3.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 1
    b.as_[0] = 0
    b.bs_[0] = 0
    b.ops[1] = op_emov()
    b.dsts[1] = 2
    b.as_[1] = 1
    b.bs_[1] = 0
    b.ops[2] = op_ebrz()
    b.dsts[2] = 0
    b.as_[2] = 2
    b.bs_[2] = 6
    b.ops[3] = op_ebrn()
    b.dsts[3] = 0
    b.as_[3] = 2
    b.bs_[3] = 6
    b.ops[4] = op_eadd()
    b.dsts[4] = 3
    b.as_[4] = 1
    b.bs_[4] = 2
    b.ops[5] = op_ebr()
    b.dsts[5] = 0
    b.as_[5] = 8
    b.bs_[5] = 0
    b.ops[6] = op_ehalt()
    b.dsts[6] = 0
    b.as_[6] = 0
    b.bs_[6] = 0
    b.ops[7] = op_estore()
    b.dsts[7] = 3
    b.as_[7] = 0
    b.bs_[7] = 0
    b.n_code = 8
    b
}

fn build_v1_ehalt_only(fuel: i64) -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, fuel)
    b = eisax_emit_ehalt(b)
    b
}

fn build_branch_instr(op: i64, target: i64) -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 10)
    if op == op_ebr() {
        b = eisax_emit_ebr(b, target)
    } else {
        if op == op_ebrz() {
            b = eisax_emit_ebrz(b, 0, target)
        } else {
            b = eisax_emit_ebrn(b, 0, target)
        }
    }
    b
}

fn build_v1_n_code_256() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 5000)
    var i = 0
    while i < 256 {
        b.ops[i as usize] = op_ehalt()
        b.dsts[i as usize] = 0
        b.as_[i as usize] = 0
        b.bs_[i as usize] = 0
        i = i + 1
    }
    b.n_code = 256
    b
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0

    // F1: round-trip v1 + hash determinism with new opcodes present.
    let b_f1 = build_v1_base(1234)
    let img_f1a = eisax_encode(b_f1)
    let img_f1b = eisax_encode(b_f1)
    if eisax_validate(img_f1a) != 0 { fails = fails + 1 }
    if eisax_validate(img_f1b) != 0 { fails = fails + 1 }
    if eisax_prog_hash(img_f1a) != eisax_prog_hash(img_f1b) { fails = fails + 1 }

    // F2: version cross-rejection.
    var cross = img_f1a
    cross.w[1] = 0
    if eisax_validate(cross) == 0 { fails = fails + 1 }

    let img_v0 = eisax_encode(build_v0_base())
    cross = img_v0
    cross.w[1] = eisax_version_v1()
    if eisax_validate(cross) == 0 { fails = fails + 1 }

    // Since EISA v2 (W3), version word 2 is ACCEPTED by the validator, so a
    // v1 image with its version word flipped to 2 no longer trips the
    // version check — it trips the HASH check instead (code 11), because
    // the version word is mixed into the EISA-hash and the stored hash was
    // computed for version 1. Version 3 remains unknown and still returns
    // the version error (13).
    cross = img_f1a
    cross.w[1] = 2
    if eisax_validate(cross) != 11 { fails = fails + 1 }

    cross = img_f1a
    cross.w[1] = 3
    if eisax_validate(cross) != 13 { fails = fails + 1 }

    // F3: fuel bounds in v1.
    if eisax_validate(eisax_encode(build_v1_ehalt_only(0))) != 14 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_v1_ehalt_only(16777217))) != 14 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_v1_ehalt_only(1))) != 0 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_v1_ehalt_only(16777216))) != 0 { fails = fails + 1 }

    // F4: branch target checks for ebr/ebrz/ebrn.
    if eisax_validate(eisax_encode(build_branch_instr(op_ebr(), 1))) != 0 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_branch_instr(op_ebrz(), 1))) != 0 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_branch_instr(op_ebrn(), 1))) != 0 { fails = fails + 1 }

    if eisax_validate(eisax_encode(build_branch_instr(op_ebr(), 2))) == 0 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_branch_instr(op_ebrz(), 2))) == 0 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_branch_instr(op_ebrn(), 2))) == 0 { fails = fails + 1 }

    if eisax_validate(eisax_encode(build_branch_instr(op_ebr(), 0 - 1))) == 0 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_branch_instr(op_ebrz(), 0 - 1))) == 0 { fails = fails + 1 }
    if eisax_validate(eisax_encode(build_branch_instr(op_ebrn(), 0 - 1))) == 0 { fails = fails + 1 }

    // F5: field discipline for new opcodes and reserved 14/15.
    var bad = eisax_encode(build_v1_base(222))
    bad.w[7 + 4 * 1 + 3] = 1
    if eisax_validate(bad) == 0 { fails = fails + 1 }

    bad = eisax_encode(build_v1_ehalt_only(50))
    bad.w[7 + 1] = 1
    if eisax_validate(bad) == 0 { fails = fails + 1 }

    bad = eisax_encode(build_v1_ehalt_only(50))
    bad.w[7] = 14
    if eisax_validate(bad) == 0 { fails = fails + 1 }

    bad = eisax_encode(build_v1_ehalt_only(50))
    bad.w[7] = 15
    if eisax_validate(bad) == 0 { fails = fails + 1 }

    // F6: v1 budgets + v0 regression guard on register window.
    if eisax_validate(eisax_encode(build_v1_n_code_256())) != 0 { fails = fails + 1 }
    bad = eisax_encode(build_v1_n_code_256())
    bad.w[2] = 257
    if eisax_validate(bad) == 0 { fails = fails + 1 }

    var b_reg = build_v1_ehalt_only(20)
    b_reg.ops[0] = op_emov()
    b_reg.dsts[0] = 63
    b_reg.as_[0] = 63
    b_reg.bs_[0] = 0
    if eisax_validate(eisax_encode(b_reg)) != 0 { fails = fails + 1 }

    b_reg.dsts[0] = 64
    if eisax_validate(eisax_encode(b_reg)) == 0 { fails = fails + 1 }

    var v0_bad = eisax_encode(build_v0_base())
    v0_bad.w[6 + 1] = 32
    if eisax_validate(v0_bad) == 0 { fails = fails + 1 }

    // F7: hash sensitivity to fuel and branch target.
    let h_a = eisax_prog_hash(eisax_encode(build_v1_base(500)))
    let h_b = eisax_prog_hash(eisax_encode(build_v1_base(501)))
    if h_a == h_b { fails = fails + 1 }

    var b_h = build_v1_base(700)
    let h_t1 = eisax_prog_hash(eisax_encode(b_h))
    b_h.as_[5] = 7
    let h_t2 = eisax_prog_hash(eisax_encode(b_h))
    if h_t1 == h_t2 { fails = fails + 1 }

    // F8: v0 path still validates via existing API.
    if eisax_validate(eisax_encode(build_v0_base())) != 0 { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: eisax v1 F1 F2 F3 F4 F5 F6 F7 F8")
    0
}
