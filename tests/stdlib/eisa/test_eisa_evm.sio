// validated_lane: lean_single

use eisa::format::*
use eisa::asm::*
use eisa::isa::*
use eisa::evm::*
use str::lib::*

fn f64_bits_eq(a: f64, b: f64) -> bool with Mut, Div, Panic {
    let pa = f64_parts(a)
    let pb = f64_parts(b)
    pa.sign == pb.sign && pa.exp == pb.exp && pa.mant == pb.mant
}

fn nl_str() -> Str with Mut, Div, Panic {
    var buf: [i8; 256] = [0; 256]
    buf[0] = 10 as i8
    str_from_bytes_buf(&buf, 1)
}

fn concat_line(dst: &Str, line: &Str, nl: &Str) -> Str with Mut, Div, Panic {
    let t = str_cat(dst, line)
    str_cat(&t, nl)
}

fn build_golden_src() -> Str with Mut, Div, Panic {
    let nl = nl_str()
    var src = str_new()
    let l0 = str_from_literal(".eisa v0")
    src = concat_line(&src, &l0, &nl)
    let l1 = str_from_literal("e0 <- econst 0.5")
    src = concat_line(&src, &l1, &nl)
    let l2 = str_from_literal("e1 <- econst 7.25")
    src = concat_line(&src, &l2, &nl)
    let l3 = str_from_literal("e2 <- emul e0 , e1")
    src = concat_line(&src, &l3, &nl)
    let l4 = str_from_literal("egate e2")
    src = concat_line(&src, &l4, &nl)
    let l5 = str_from_literal("estore [ dose ] <- e2")
    src = concat_line(&src, &l5, &nl)
    src
}

fn build_prog_alt_src() -> Str with Mut, Div, Panic {
    let nl = nl_str()
    var src = str_new()
    let l0 = str_from_literal(".eisa v0")
    src = concat_line(&src, &l0, &nl)
    let l1 = str_from_literal("e0 <- econst 0.5")
    src = concat_line(&src, &l1, &nl)
    let l2 = str_from_literal("e1 <- econst 7.25")
    src = concat_line(&src, &l2, &nl)
    let l3 = str_from_literal("e2 <- eadd e0 , e1")
    src = concat_line(&src, &l3, &nl)
    let l4 = str_from_literal("egate e2")
    src = concat_line(&src, &l4, &nl)
    let l5 = str_from_literal("estore [ dose ] <- e2")
    src = concat_line(&src, &l5, &nl)
    src
}

fn build_poison_src() -> Str with Mut, Div, Panic {
    let nl = nl_str()
    var src = str_new()
    let l0 = str_from_literal(".eisa v0")
    src = concat_line(&src, &l0, &nl)
    let l1 = str_from_literal("e0 <- econst 1.0")
    src = concat_line(&src, &l1, &nl)
    let l2 = str_from_literal("e1 <- econst 0.0")
    src = concat_line(&src, &l2, &nl)
    let l3 = str_from_literal("e2 <- ediv e0 , e1")
    src = concat_line(&src, &l3, &nl)
    let l4 = str_from_literal("e3 <- eadd e2 , e0")
    src = concat_line(&src, &l4, &nl)
    let l5 = str_from_literal("egate e3")
    src = concat_line(&src, &l5, &nl)
    src
}

fn instr(op: i64, dst: i64, a: i64, b: i64, imm: f64) -> EInstr {
    EInstr { op: op, dst: dst, a: a, b: b, imm: imm }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0

    let src = build_golden_src()
    let asm_res = eisa_assemble(src)
    if asm_res.status != 0 { fails = fails + 1 }
    let img = eisax_encode(asm_res.build)
    if eisax_validate(img) != 0 { fails = fails + 1 }

    // V1: run golden .eisax program and check memory value + gate count.
    var m1 = evm_load(img)
    let rc1 = evm_run(&!m1)
    if rc1 != 0 { fails = fails + 1 }
    let want = f64_parts(3.625)
    let got = f64_parts(evm_mem_val(&m1, 0))
    if want.sign != got.sign || want.exp != got.exp || want.mant != got.mant {
        fails = fails + 1
    }
    if evm_gate_count(&m1) != 1 { fails = fails + 1 }

    // V2: differential conformance vs in-memory ISA interpreter.
    var mi = emachine_new()
    var prog: [EInstr; 32] = [instr(op_econst(), 0, 0, 0, 0.0); 32]
    prog[0] = instr(op_econst(), 0, 0, 0, 0.5)
    prog[1] = instr(op_econst(), 1, 0, 0, 7.25)
    prog[2] = instr(op_emul(), 2, 0, 1, 0.0)
    prog[3] = instr(op_egate(), 2, 0, 0, 0.0)
    prog[4] = instr(op_estore(), 2, 0, 0, 0.0)
    let rci = eisa_run(&!mi, &prog, 5)
    if rci != 0 { fails = fails + 1 }

    var me = evm_load(img)
    let rce = evm_run(&!me)
    if rce != 0 { fails = fails + 1 }

    var r = 0
    while r < 16 {
        if !f64_bits_eq(mi.reg_val[r as usize], evm_reg_val(&me, r)) { fails = fails + 1 }
        if !f64_bits_eq(mi.reg_ehi[r as usize], evm_reg_ehi(&me, r)) { fails = fails + 1 }
        if !f64_bits_eq(mi.reg_elo[r as usize], evm_reg_elo(&me, r)) { fails = fails + 1 }
        if !f64_bits_eq(mi.reg_u[r as usize], evm_reg_u(&me, r)) { fails = fails + 1 }
        if mi.reg_poison[r as usize] != evm_reg_poison(&me, r) { fails = fails + 1 }
        r = r + 1
    }

    // V3: poison propagation through ediv-by-zero and subsequent eadd.
    let poison_src = build_poison_src()
    let poison_asm = eisa_assemble(poison_src)
    if poison_asm.status != 0 { fails = fails + 1 }
    let poison_img = eisax_encode(poison_asm.build)
    var mp = evm_load(poison_img)
    let rcp = evm_run(&!mp)
    if rcp != 0 { fails = fails + 1 }
    if evm_reg_poison(&mp, 2) != 1 { fails = fails + 1 }
    if evm_reg_poison(&mp, 3) != 1 { fails = fails + 1 }
    let pn = f64_parts(evm_reg_val(&mp, 2))
    if pn.sign != 0 || pn.exp != 2047 || pn.mant != 1 { fails = fails + 1 }
    let pu = f64_parts(evm_reg_u(&mp, 2))
    if pu.exp != 2047 || pu.mant != 0 { fails = fails + 1 }
    if evm_gate_count(&mp) != 1 { fails = fails + 1 }

    // V4: invalid image is refused by loader and cannot execute.
    var bad = img
    bad.w[0] = 0
    var mb = evm_load(bad)
    if evm_loaded(&mb) != 0 { fails = fails + 1 }
    if evm_error(&mb) != 1 { fails = fails + 1 }
    let rcb = evm_run(&!mb)
    if rcb != 1 { fails = fails + 1 }

    // V5: machine stores provenance hash; different programs hash differently.
    if evm_prog_hash(&m1) != eisax_prog_hash(img) { fails = fails + 1 }
    let src_alt = build_prog_alt_src()
    let asm_alt = eisa_assemble(src_alt)
    if asm_alt.status != 0 { fails = fails + 1 }
    let img_alt = eisax_encode(asm_alt.build)
    if eisax_prog_hash(img) == eisax_prog_hash(img_alt) { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: eisa evm V1 V2 V3 V4 V5")
    0
}
