// validated_lane: lean_single (default lane known wrong-code on imported struct chains)

use eisa::core::*
use eisa::isa::*

fn instr(op: i64, dst: i64, a: i64, b: i64, imm: f64) -> EInstr {
    EInstr { op: op, dst: dst, a: a, b: b, imm: imm }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0

    // P1
    let p1_x0 = 0.1
    let p1_r0 = f64_recompose(f64_decompose(p1_x0))
    if p1_r0 != p1_x0 { fails = fails + 1 }

    let p1_x1 = 3.14159265358979
    let p1_r1 = f64_recompose(f64_decompose(p1_x1))
    if p1_r1 != p1_x1 { fails = fails + 1 }

    let p1_x2 = 10000000000000000.0
    let p1_r2 = f64_recompose(f64_decompose(p1_x2))
    if p1_r2 != p1_x2 { fails = fails + 1 }

    let p1_x3 = 1.0e-300
    let p1_r3 = f64_recompose(f64_decompose(p1_x3))
    if p1_r3 != p1_x3 { fails = fails + 1 }

    let p1_x4 = 0.0
    let p1_r4 = f64_recompose(f64_decompose(p1_x4))
    if p1_r4 != p1_x4 { fails = fails + 1 }

    let p1_x5 = 0.0 - 2.5
    let p1_r5 = f64_recompose(f64_decompose(p1_x5))
    if p1_r5 != p1_x5 { fails = fails + 1 }

    let one_bits = f64_decompose(1.0)
    if one_bits.sign != 0 { fails = fails + 1 }
    if one_bits.exp != 1023 { fails = fails + 1 }
    if one_bits.mant != 0 { fails = fails + 1 }

    // P2
    var m2 = emachine_new()
    var p2: [EInstr; 32] = [instr(op_econst(), 0, 0, 0, 0.0); 32]
    p2[0] = instr(op_econst(), 0, 0, 0, 0.5)
    p2[1] = instr(op_econst(), 1, 0, 0, 7.25)
    p2[2] = instr(op_emul(), 2, 0, 1, 0.0)
    p2[3] = instr(op_eadd(), 3, 2, 2, 0.0)
    p2[4] = instr(op_ediv(), 4, 3, 1, 0.0)
    p2[5] = instr(op_esqrt(), 5, 4, 0, 0.0)
    p2[6] = instr(op_egate(), 5, 0, 0, 0.0)
    let rc2 = eisa_run(&!m2, &p2, 7)
    if rc2 != 0 { fails = fails + 1 }

    let r0 = ereg_exact(0.5)
    let r1 = ereg_exact(7.25)
    let r2 = emul(r0, r1)
    let r3 = eadd(r2, r2)
    let r4 = ediv(r3, r1)
    let r5 = esqrt(r4)
    let g2 = egate(r5, 2)

    if m2.reg_val[5] != r5.val { fails = fails + 1 }
    if m2.reg_ehi[5] != r5.err.hi { fails = fails + 1 }
    if m2.reg_elo[5] != r5.err.lo { fails = fails + 1 }
    if m2.reg_u[5] != r5.u { fails = fails + 1 }
    if emachine_last_gate(&m2) != g2 { fails = fails + 1 }

    // P3
    var m3 = emachine_new()
    var p3: [EInstr; 32] = [instr(op_econst(), 0, 0, 0, 0.0); 32]
    p3[0] = instr(op_econst(), 0, 0, 0, 1.0)
    p3[1] = instr(op_econst(), 1, 0, 0, 0.0)
    p3[2] = instr(op_ediv(), 2, 0, 1, 0.0)
    p3[3] = instr(op_eadd(), 3, 2, 0, 0.0)
    p3[4] = instr(op_egate(), 3, 0, 0, 0.0)
    p3[5] = instr(op_estore(), 3, 0, 0, 0.0)
    p3[6] = instr(op_eload(), 4, 0, 0, 0.0)
    let rc3 = eisa_run(&!m3, &p3, 7)
    if rc3 != 0 { fails = fails + 1 }
    if m3.reg_poison[3] != 1 { fails = fails + 1 }
    if emachine_last_gate(&m3) != 2 { fails = fails + 1 }
    if emachine_last_poisoned(&m3) != 1 { fails = fails + 1 }
    if m3.reg_poison[4] != 1 { fails = fails + 1 }

    // P4
    var m4 = emachine_new()
    m4.mem_u[2] = 0.0 - 0.5
    var p4: [EInstr; 32] = [instr(op_econst(), 0, 0, 0, 0.0); 32]
    p4[0] = instr(op_eload(), 0, 2, 0, 0.0)
    let rc4 = eisa_run(&!m4, &p4, 1)
    if rc4 != 1 { fails = fails + 1 }

    // P5
    var m5 = emachine_new()
    m5.mem_val[1] = 1.0
    m5.mem_ehi[1] = 0.0
    m5.mem_elo[1] = 0.0
    m5.mem_u[1] = 0.001
    var p5: [EInstr; 32] = [instr(op_econst(), 0, 0, 0, 0.0); 32]
    p5[0] = instr(op_eload(), 0, 1, 0, 0.0)
    p5[1] = instr(op_eload(), 1, 1, 0, 0.0)
    p5[2] = instr(op_eadd(), 2, 0, 1, 0.0)
    p5[3] = instr(op_egate(), 2, 0, 0, 0.0)
    p5[4] = instr(op_egate(), 2, 0, 0, 0.0)
    let rc5 = eisa_run(&!m5, &p5, 5)
    if rc5 != 0 { fails = fails + 1 }

    let ref_m = ereg_measured(1.0, 0.001)
    let ref_add = eadd(ref_m, ref_m)
    let ref_g = egate(ref_add, 2)
    if emachine_last_gate(&m5) != 0 { fails = fails + 1 }
    if emachine_last_gate(&m5) != ref_g { fails = fails + 1 }
    if m5.gate_count != 2 { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: eisa isa P1 P2 P3 P4 P5")
    0
}
