//@ run-pass
// validated_lane: lean_single

use eisa::format::*
use eisa::bridge_x86::*

fn cksum(buf: &[i8; 131072], n: i64) -> i64 with Mut, Panic, Div {
    var h = 2166136261
    var i = 0
    while i < n {
        let byte = (*buf)[i as usize] as i64 & 255
        h = (h * 31 + byte + 1) % 2147483647
        i = i + 1
    }
    h
}

fn v1_loop_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 24)
    b.consts[0] = 0.0
    b.consts[1] = 3.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 2
    b.as_[1] = 1
    b.ops[2] = op_ebrz()
    b.as_[2] = 0
    b.bs_[2] = 4
    b.ops[3] = op_ehalt()
    b.ops[4] = op_egate()
    b.dsts[4] = 2
    b.ops[5] = op_ehalt()
    b.n_code = 6
    eisax_encode(b)
}

fn v1_loop_tampered_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 24)
    b.consts[0] = 0.0
    b.consts[1] = 4.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 2
    b.as_[1] = 1
    b.ops[2] = op_ebrz()
    b.as_[2] = 0
    b.bs_[2] = 4
    b.ops[3] = op_ehalt()
    b.ops[4] = op_egate()
    b.dsts[4] = 2
    b.ops[5] = op_ehalt()
    b.n_code = 6
    eisax_encode(b)
}

fn v1_fuel_img(fuel: i64) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, fuel)
    b.consts[0] = 1.0
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 5
    b.as_[0] = 0
    b.ops[1] = op_ebr()
    b.as_[1] = 1
    b.n_code = 2
    eisax_encode(b)
}


fn v1_fuel_e0_img(fuel: i64) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, fuel)
    b.consts[0] = 1.0
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_ebr()
    b.as_[1] = 1
    b.n_code = 2
    eisax_encode(b)
}

fn v1_highreg_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 12)
    b.consts[0] = 7.25
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 20
    b.as_[0] = 0
    b.ops[1] = op_egate()
    b.dsts[1] = 20
    b.ops[2] = op_ehalt()
    b.n_code = 3
    eisax_encode(b)
}

fn v1_i6_img(poisoned: bool) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 32)
    b.consts[0] = 1.0
    b.consts[1] = if poisoned { 0.0 } else { 2.0 }
    b.consts[2] = 5.0
    b.n_const = 3
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_ediv()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1
    b.ops[3] = op_ebrz()
    b.as_[3] = 2
    b.bs_[3] = 6
    b.ops[4] = op_econst()
    b.dsts[4] = 3
    b.as_[4] = 2
    b.ops[5] = op_egate()
    b.dsts[5] = 3
    b.ops[6] = op_ehalt()
    b.n_code = 7
    eisax_encode(b)
}

fn v1_arith_high_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 40)
    b.consts[0] = 2.0
    b.consts[1] = 4.0
    b.consts[2] = 0.5
    b.n_const = 3
    b.ops[0] = op_econst()
    b.dsts[0] = 20
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 21
    b.as_[1] = 1
    b.ops[2] = op_econst()
    b.dsts[2] = 22
    b.as_[2] = 2
    b.ops[3] = op_eadd()
    b.dsts[3] = 30
    b.as_[3] = 20
    b.bs_[3] = 21
    b.ops[4] = op_esub()
    b.dsts[4] = 31
    b.as_[4] = 30
    b.bs_[4] = 22
    b.ops[5] = op_emul()
    b.dsts[5] = 32
    b.as_[5] = 31
    b.bs_[5] = 21
    b.ops[6] = op_ediv()
    b.dsts[6] = 33
    b.as_[6] = 32
    b.bs_[6] = 20
    b.ops[7] = op_esqrt()
    b.dsts[7] = 34
    b.as_[7] = 33
    b.ops[8] = op_emov()
    b.dsts[8] = 40
    b.as_[8] = 34
    b.ops[9] = op_egate()
    b.dsts[9] = 40
    b.ops[10] = op_ehalt()
    b.n_code = 11
    eisax_encode(b)
}

fn v1_fuel_high_img(fuel: i64) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, fuel)
    b.consts[0] = 1.0
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 20
    b.as_[0] = 0
    b.ops[1] = op_ebr()
    b.as_[1] = 1
    b.n_code = 2
    eisax_encode(b)
}

fn v1_branch_high_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 30)
    b.consts[0] = 1.0e16
    b.consts[1] = 1.0
    b.consts[2] = 0.0 - 1.0
    b.n_const = 3
    b.ops[0] = op_econst()
    b.dsts[0] = 33
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 34
    b.as_[1] = 1
    b.ops[2] = op_eadd()
    b.dsts[2] = 35
    b.as_[2] = 33
    b.bs_[2] = 34
    b.ops[3] = op_esub()
    b.dsts[3] = 36
    b.as_[3] = 35
    b.bs_[3] = 33
    b.ops[4] = op_ebrz()
    b.as_[4] = 36
    b.bs_[4] = 6
    b.ops[5] = op_ehalt()
    b.ops[6] = op_econst()
    b.dsts[6] = 37
    b.as_[6] = 2
    b.ops[7] = op_ebrn()
    b.as_[7] = 37
    b.bs_[7] = 9
    b.ops[8] = op_ehalt()
    b.ops[9] = op_egate()
    b.dsts[9] = 36
    b.ops[10] = op_egate()
    b.dsts[10] = 37
    b.ops[11] = op_ehalt()
    b.n_code = 12
    eisax_encode(b)
}

fn v0_golden_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b.consts[0] = 0.5
    b.consts[1] = 7.25
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_emul()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1
    b.ops[3] = op_egate()
    b.dsts[3] = 2
    b.ops[4] = op_estore()
    b.dsts[4] = 2
    b.as_[4] = 0
    b.n_code = 5
    eisax_encode(b)
}

fn main() -> i32 with Mut, Div, Panic, IO {
    var fails = 0
    var buf: [i8; 131072] = [0; 131072]

    // Y1
    let m1 = bridge_translate(v1_loop_img(), &!buf)
    if m1.status != 0 { fails = fails + 1 }
    let y1_len = m1.len
    let y1_ck = cksum(&buf, m1.len)
    let m1b = bridge_translate(v1_loop_img(), &!buf)
    if m1b.status != 0 { fails = fails + 1 }
    if m1b.len != y1_len { fails = fails + 1 }
    if cksum(&buf, m1b.len) != y1_ck { fails = fails + 1 }
    // Pin updated 9171 -> 9326 with the full-highreg migration: egate gained a
    // conditional last_written refresh (poisoned dst) and the poisoned-branch
    // path now snapshots last_written = a, matching EVM receipt discipline.
    if y1_len != 9326 { fails = fails + 1 }

    // Y2
    if eisax_validate(v1_loop_img()) != 0 { fails = fails + 1 }
    if eisax_prog_hash(v1_loop_img()) == 0 { fails = fails + 1 }

    // Y3
    let mt = bridge_translate(v1_loop_tampered_img(), &!buf)
    if mt.status != 0 { fails = fails + 1 }
    if mt.len == y1_len && cksum(&buf, mt.len) == y1_ck { fails = fails + 1 }

    // Y4
    let v0a = bridge_translate(v0_golden_img(), &!buf)
    let v0_len = v0a.len
    let v0_ck = cksum(&buf, v0a.len)
    let v0b = bridge_translate(v0_golden_img(), &!buf)
    if v0b.len != v0_len || cksum(&buf, v0b.len) != v0_ck { fails = fails + 1 }

    // Y5
    let f5 = bridge_translate(v1_fuel_img(5), &!buf)
    let f5_ck = cksum(&buf, f5.len)
    let f9 = bridge_translate(v1_fuel_img(9), &!buf)
    let f9_ck = cksum(&buf, f9.len)
    if f5.status != 0 || f9.status != 0 { fails = fails + 1 }
    if f5.len == f9.len && f5_ck == f9_ck { fails = fails + 1 }

    // Y6
    let i6p = bridge_translate(v1_i6_img(true), &!buf)
    let i6p_ck = cksum(&buf, i6p.len)
    let i6n = bridge_translate(v1_i6_img(false), &!buf)
    let i6n_ck = cksum(&buf, i6n.len)
    if i6p.status != 0 || i6n.status != 0 { fails = fails + 1 }
    if i6p.len == i6n.len && i6p_ck == i6n_ck { fails = fails + 1 }

    // Y7: fuel lane writes non-e0 before exhaustion (covers dynamic last_written path).
    let fuel_img = v1_fuel_img(5)
    if eisax_code_op(fuel_img, 0) != op_econst() { fails = fails + 1 }
    if eisax_code_dst(fuel_img, 0) != 5 { fails = fails + 1 }
    let fe0 = bridge_translate(v1_fuel_e0_img(5), &!buf)
    let fe0_ck = cksum(&buf, fe0.len)
    if fe0.status != 0 { fails = fails + 1 }
    if fe0.len == f5.len && fe0_ck == f5_ck { fails = fails + 1 }

    // Y8: high register e20 translation witness.
    let h20 = bridge_translate(v1_highreg_img(), &!buf)
    if h20.status != 0 { fails = fails + 1 }
    if h20.len <= 0 { fails = fails + 1 }

    // Y9a: v1-arith-high — full arithmetic chain (eadd/esub/emul/ediv/esqrt +
    // emov) entirely on e20..e40 registers translates deterministically.
    // Runtime conformance vs the EVM is the v1-arith-high gate lane.
    let a1 = bridge_translate(v1_arith_high_img(), &!buf)
    if a1.status != 0 { fails = fails + 1 }
    if a1.len <= 0 { fails = fails + 1 }
    let a1_len = a1.len
    let a1_ck = cksum(&buf, a1.len)
    let a2 = bridge_translate(v1_arith_high_img(), &!buf)
    if a2.len != a1_len || cksum(&buf, a2.len) != a1_ck { fails = fails + 1 }

    // Y9b: v1-fuel-high — fuel exhaustion whose last write is e20. Fuel is a
    // baked immediate, so different budgets must produce different ELFs; and
    // the e20 image must differ from the e5 image of the same shape (the
    // last-written snapshot targets a different register block). The dynamic
    // reg=e20 stop=fuel receipt is enforced byte-for-byte by the v1-fuel-high
    // gate lane.
    let fh5 = bridge_translate(v1_fuel_high_img(5), &!buf)
    if fh5.status != 0 { fails = fails + 1 }
    let fh5_ck = cksum(&buf, fh5.len)
    let fh9 = bridge_translate(v1_fuel_high_img(9), &!buf)
    if fh9.status != 0 { fails = fails + 1 }
    if fh5.len == fh9.len && fh5_ck == cksum(&buf, fh9.len) { fails = fails + 1 }
    let fl5 = bridge_translate(v1_fuel_img(5), &!buf)
    if fl5.status != 0 { fails = fails + 1 }
    if fh5.len == fl5.len && fh5_ck == cksum(&buf, fl5.len) { fails = fails + 1 }

    // Y9c: v1-branch-high — ebrz/ebrn + frail counting where the tested
    // registers are high (e33..e37); deterministic translation. The frail=1
    // receipt pair is enforced by the v1-branch-high gate lane.
    let b1 = bridge_translate(v1_branch_high_img(), &!buf)
    if b1.status != 0 { fails = fails + 1 }
    if b1.len <= 0 { fails = fails + 1 }
    let b1_len = b1.len
    let b1_ck = cksum(&buf, b1.len)
    let b2 = bridge_translate(v1_branch_high_img(), &!buf)
    if b2.len != b1_len || cksum(&buf, b2.len) != b1_ck { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: eisa bridge v1 Y1 ... Y9")
    0
}
