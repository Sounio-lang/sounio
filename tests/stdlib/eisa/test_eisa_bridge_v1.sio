//@ run-pass
// validated_lane: lean_single

use eisa::format::*
use eisa::bridge_x86::*

fn cksum(buf: &[i8; 65536], n: i64) -> i64 with Mut, Panic, Div {
    var h = 2166136261
    var i = 0
    while i < n {
        let byte = (*buf)[i as usize] as i64 & 255
        h = (h * 31 + byte + 1) % 2147483647
        i = i + 1
    }
    h
}

fn v1_loop_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 24)
    b.consts[0] = 0.0
    b.consts[1] = 3.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 2
    b.as_[1] = 1
    b.ops[2] = op_ebrz()
    b.as_[2] = 0
    b.bs_[2] = 4
    b.ops[3] = op_ehalt()
    b.ops[4] = op_egate()
    b.dsts[4] = 2
    b.ops[5] = op_ehalt()
    b.n_code = 6
    eisax_encode(b)
}

fn v1_loop_tampered_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 24)
    b.consts[0] = 0.0
    b.consts[1] = 4.0
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 2
    b.as_[1] = 1
    b.ops[2] = op_ebrz()
    b.as_[2] = 0
    b.bs_[2] = 4
    b.ops[3] = op_ehalt()
    b.ops[4] = op_egate()
    b.dsts[4] = 2
    b.ops[5] = op_ehalt()
    b.n_code = 6
    eisax_encode(b)
}

fn v1_fuel_img(fuel: i64) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, fuel)
    b.consts[0] = 1.0
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 5
    b.as_[0] = 0
    b.ops[1] = op_ebr()
    b.as_[1] = 1
    b.n_code = 2
    eisax_encode(b)
}

fn v1_fuel_e0_img(fuel: i64) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, fuel)
    b.consts[0] = 1.0
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_ebr()
    b.as_[1] = 1
    b.n_code = 2
    eisax_encode(b)
}

fn v1_highreg_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 12)
    b.consts[0] = 7.25
    b.n_const = 1
    b.ops[0] = op_econst()
    b.dsts[0] = 20
    b.as_[0] = 0
    b.ops[1] = op_egate()
    b.dsts[1] = 20
    b.ops[2] = op_ehalt()
    b.n_code = 3
    eisax_encode(b)
}

fn v1_i6_img(poisoned: bool) -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 32)
    b.consts[0] = 1.0
    b.consts[1] = if poisoned { 0.0 } else { 2.0 }
    b.consts[2] = 5.0
    b.n_const = 3
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_ediv()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1
    b.ops[3] = op_ebrz()
    b.as_[3] = 2
    b.bs_[3] = 6
    b.ops[4] = op_econst()
    b.dsts[4] = 3
    b.as_[4] = 2
    b.ops[5] = op_egate()
    b.dsts[5] = 3
    b.ops[6] = op_ehalt()
    b.n_code = 7
    eisax_encode(b)
}

fn v0_golden_img() -> EisaxImage with Mut, Panic, Div {
    var b = eisax_build_new()
    b.consts[0] = 0.5
    b.consts[1] = 7.25
    b.n_const = 2
    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.ops[2] = op_emul()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1
    b.ops[3] = op_egate()
    b.dsts[3] = 2
    b.ops[4] = op_estore()
    b.dsts[4] = 2
    b.as_[4] = 0
    b.n_code = 5
    eisax_encode(b)
}

fn main() -> i32 with Mut, Div, Panic, IO {
    var fails = 0
    var buf: [i8; 65536] = [0; 65536]

    // Y1
    let m1 = bridge_translate(v1_loop_img(), &!buf)
    if m1.status != 0 { fails = fails + 1 }
    let y1_len = m1.len
    let y1_ck = cksum(&buf, m1.len)
    let m1b = bridge_translate(v1_loop_img(), &!buf)
    if m1b.status != 0 { fails = fails + 1 }
    if m1b.len != y1_len { fails = fails + 1 }
    if cksum(&buf, m1b.len) != y1_ck { fails = fails + 1 }
    if y1_len != 4179 { fails = fails + 1 }

    // Y2
    if eisax_validate(v1_loop_img()) != 0 { fails = fails + 1 }
    if eisax_prog_hash(v1_loop_img()) == 0 { fails = fails + 1 }

    // Y3
    let mt = bridge_translate(v1_loop_tampered_img(), &!buf)
    if mt.status != 0 { fails = fails + 1 }
    if mt.len == y1_len && cksum(&buf, mt.len) == y1_ck { fails = fails + 1 }

    // Y4
    let v0a = bridge_translate(v0_golden_img(), &!buf)
    let v0_len = v0a.len
    let v0_ck = cksum(&buf, v0a.len)
    let v0b = bridge_translate(v0_golden_img(), &!buf)
    if v0b.len != v0_len || cksum(&buf, v0b.len) != v0_ck { fails = fails + 1 }

    // Y5
    let f5 = bridge_translate(v1_fuel_img(5), &!buf)
    let f5_ck = cksum(&buf, f5.len)
    let f9 = bridge_translate(v1_fuel_img(9), &!buf)
    let f9_ck = cksum(&buf, f9.len)
    if f5.status != 0 || f9.status != 0 { fails = fails + 1 }
    if f5.len == f9.len && f5_ck == f9_ck { fails = fails + 1 }

    // Y6
    let i6p = bridge_translate(v1_i6_img(true), &!buf)
    let i6p_ck = cksum(&buf, i6p.len)
    let i6n = bridge_translate(v1_i6_img(false), &!buf)
    let i6n_ck = cksum(&buf, i6n.len)
    if i6p.status != 0 || i6n.status != 0 { fails = fails + 1 }
    if i6p.len == i6n.len && i6p_ck == i6n_ck { fails = fails + 1 }

    // Y7: fuel lane writes non-e0 before exhaustion (covers dynamic last_written path).
    let fuel_img = v1_fuel_img(5)
    if eisax_code_op(fuel_img, 0) != op_econst() { fails = fails + 1 }
    if eisax_code_dst(fuel_img, 0) != 5 { fails = fails + 1 }
    let fe0 = bridge_translate(v1_fuel_e0_img(5), &!buf)
    let fe0_ck = cksum(&buf, fe0.len)
    if fe0.status != 0 { fails = fails + 1 }
    if fe0.len == f5.len && fe0_ck == f5_ck { fails = fails + 1 }

    // Y8: high register e20 translation witness.
    let h20 = bridge_translate(v1_highreg_img(), &!buf)
    if h20.status != 0 { fails = fails + 1 }
    if h20.len <= 0 { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: eisa bridge v1 Y1 ... Y8")
    0
}
