//@ run-pass
// validated_lane: lean_single

use eisa::format::*
use eisa::evm::*
use eisa::isa::*

fn f64_bits_eq(a: f64, b: f64) -> bool with Mut, Div, Panic {
    let pa = f64_parts(a)
    let pb = f64_parts(b)
    pa.sign == pb.sign && pa.exp == pb.exp && pa.mant == pb.mant
}

fn instr(op: i64, dst: i64, a: i64, b: i64, imm: f64) -> EInstr {
    EInstr { op: op, dst: dst, a: a, b: b, imm: imm }
}

fn build_u1_loop() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 40)
    b.consts[0] = 3.0
    b.consts[1] = 1.0
    b.consts[2] = 0.0
    b.n_const = 3

    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0

    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.bs_[1] = 0

    b.ops[2] = op_econst()
    b.dsts[2] = 3
    b.as_[2] = 2
    b.bs_[2] = 0

    b.ops[3] = op_ebrz()
    b.dsts[3] = 0
    b.as_[3] = 0
    b.bs_[3] = 7

    b.ops[4] = op_eadd()
    b.dsts[4] = 3
    b.as_[4] = 3
    b.bs_[4] = 1

    b.ops[5] = op_esub()
    b.dsts[5] = 0
    b.as_[5] = 0
    b.bs_[5] = 1

    b.ops[6] = op_ebr()
    b.dsts[6] = 0
    b.as_[6] = 3
    b.bs_[6] = 0

    b.ops[7] = op_egate()
    b.dsts[7] = 3
    b.as_[7] = 0
    b.bs_[7] = 0

    b.ops[8] = op_ebr()
    b.dsts[8] = 0
    b.as_[8] = 9
    b.bs_[8] = 0

    b.n_code = 9
    b
}

fn build_u2_emov() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 30)
    b.consts[0] = 0.0
    b.consts[1] = 1.0
    b.n_const = 2

    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0

    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.bs_[1] = 0

    b.ops[2] = op_esub()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1

    b.ops[3] = op_emul()
    b.dsts[3] = 3
    b.as_[3] = 2
    b.bs_[3] = 0

    b.ops[4] = op_emov()
    b.dsts[4] = 4
    b.as_[4] = 3
    b.bs_[4] = 0

    b.ops[5] = op_ediv()
    b.dsts[5] = 6
    b.as_[5] = 1
    b.bs_[5] = 0

    b.ops[6] = op_emov()
    b.dsts[6] = 7
    b.as_[6] = 6
    b.bs_[6] = 0

    b.ops[7] = op_egate()
    b.dsts[7] = 4
    b.as_[7] = 0
    b.bs_[7] = 0

    b.ops[8] = op_egate()
    b.dsts[8] = 7
    b.as_[8] = 0
    b.bs_[8] = 0

    b.ops[9] = op_ehalt()
    b.dsts[9] = 0
    b.as_[9] = 0
    b.bs_[9] = 0

    b.n_code = 10
    b
}

fn build_u3_i6() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 20)
    b.consts[0] = 1.0
    b.consts[1] = 0.0
    b.consts[2] = 5.0
    b.n_const = 3

    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0

    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.bs_[1] = 0

    b.ops[2] = op_ediv()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1

    b.ops[3] = op_ebrz()
    b.dsts[3] = 0
    b.as_[3] = 2
    b.bs_[3] = 5

    b.ops[4] = op_econst()
    b.dsts[4] = 3
    b.as_[4] = 2
    b.bs_[4] = 0

    b.ops[5] = op_egate()
    b.dsts[5] = 3
    b.as_[5] = 0
    b.bs_[5] = 0

    b.ops[6] = op_ehalt()
    b.dsts[6] = 0
    b.as_[6] = 0
    b.bs_[6] = 0

    b.n_code = 7
    b
}

fn build_u4_frail() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 20)
    b.consts[0] = 1.0e16
    b.consts[1] = 1.0
    b.n_const = 2

    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0

    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.bs_[1] = 0

    b.ops[2] = op_eadd()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1

    b.ops[3] = op_esub()
    b.dsts[3] = 3
    b.as_[3] = 2
    b.bs_[3] = 0

    b.ops[4] = op_ebrz()
    b.dsts[4] = 0
    b.as_[4] = 3
    b.bs_[4] = 6

    b.ops[5] = op_ehalt()
    b.dsts[5] = 0
    b.as_[5] = 0
    b.bs_[5] = 0

    b.ops[6] = op_egate()
    b.dsts[6] = 3
    b.as_[6] = 0
    b.bs_[6] = 0

    b.ops[7] = op_ehalt()
    b.dsts[7] = 0
    b.as_[7] = 0
    b.bs_[7] = 0

    b.n_code = 8
    b
}

fn build_u5_exact_zero() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 20)
    b.consts[0] = 0.0
    b.n_const = 1

    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0

    b.ops[1] = op_ebrz()
    b.dsts[1] = 0
    b.as_[1] = 0
    b.bs_[1] = 3

    b.ops[2] = op_ehalt()
    b.dsts[2] = 0
    b.as_[2] = 0
    b.bs_[2] = 0

    b.ops[3] = op_egate()
    b.dsts[3] = 0
    b.as_[3] = 0
    b.bs_[3] = 0

    b.ops[4] = op_ehalt()
    b.dsts[4] = 0
    b.as_[4] = 0
    b.bs_[4] = 0

    b.n_code = 5
    b
}

fn build_u6_fuel() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b = eisax_build_set_version(b, eisax_version_v1())
    b = eisax_build_set_fuel(b, 5)
    b.ops[0] = op_ebr()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0
    b.n_code = 1
    b
}

fn build_u7_v0() -> EisaxBuild with Mut, Panic {
    var b = eisax_build_new()
    b.consts[0] = 0.5
    b.consts[1] = 7.25
    b.n_const = 2

    b.ops[0] = op_econst()
    b.dsts[0] = 0
    b.as_[0] = 0
    b.bs_[0] = 0

    b.ops[1] = op_econst()
    b.dsts[1] = 1
    b.as_[1] = 1
    b.bs_[1] = 0

    b.ops[2] = op_emul()
    b.dsts[2] = 2
    b.as_[2] = 0
    b.bs_[2] = 1

    b.ops[3] = op_egate()
    b.dsts[3] = 2
    b.as_[3] = 0
    b.bs_[3] = 0

    b.ops[4] = op_estore()
    b.dsts[4] = 2
    b.as_[4] = 0
    b.bs_[4] = 0

    b.n_code = 5
    b
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0

    // U1: loop v1 + fuel accounting exacta.
    let u1_img = eisax_encode(build_u1_loop())
    if eisax_validate(u1_img) != 0 { fails = fails + 1 }
    var u1 = evm_load(u1_img)
    if evm_run(&!u1) != 0 { fails = fails + 1 }
    if evm_version(&u1) != 1 { fails = fails + 1 }
    if evm_stop_kind(&u1) != 0 { fails = fails + 1 }
    if evm_frail_count(&u1) != 0 { fails = fails + 1 }
    if evm_gate_count(&u1) != 1 { fails = fails + 1 }
    if !f64_bits_eq(evm_reg_val(&u1, 3), 3.0) { fails = fails + 1 }
    if evm_fuel_left(&u1) != 22 { fails = fails + 1 }

    // U2: emov bit-faithful (-0.0 em val) e cópia de poison.
    let u2_img = eisax_encode(build_u2_emov())
    if eisax_validate(u2_img) != 0 { fails = fails + 1 }
    var u2 = evm_load(u2_img)
    if evm_run(&!u2) != 0 { fails = fails + 1 }
    let inv_src = 1.0 / evm_reg_val(&u2, 3)
    let inv_dst = 1.0 / evm_reg_val(&u2, 4)
    if inv_src >= 0.0 { fails = fails + 1 }
    if inv_dst >= 0.0 { fails = fails + 1 }
    if !f64_bits_eq(evm_reg_val(&u2, 6), evm_reg_val(&u2, 7)) { fails = fails + 1 }
    if !f64_bits_eq(evm_reg_ehi(&u2, 6), evm_reg_ehi(&u2, 7)) { fails = fails + 1 }
    if !f64_bits_eq(evm_reg_elo(&u2, 6), evm_reg_elo(&u2, 7)) { fails = fails + 1 }
    if !f64_bits_eq(evm_reg_u(&u2, 6), evm_reg_u(&u2, 7)) { fails = fails + 1 }
    if evm_reg_poison(&u2, 6) != 1 { fails = fails + 1 }
    if evm_reg_poison(&u2, 7) != 1 { fails = fails + 1 }

    // U3: I6 branch-on-poison cai no fall-through.
    let u3_img = eisax_encode(build_u3_i6())
    if eisax_validate(u3_img) != 0 { fails = fails + 1 }
    var u3 = evm_load(u3_img)
    if evm_run(&!u3) != 0 { fails = fails + 1 }
    if evm_reg_poison(&u3, 2) != 1 { fails = fails + 1 }
    if !f64_bits_eq(evm_reg_val(&u3, 3), 5.0) { fails = fails + 1 }
    if evm_reg_poison(&u3, 3) != 0 { fails = fails + 1 }

    // U4: branch frágil conta 1.
    let u4_img = eisax_encode(build_u4_frail())
    if eisax_validate(u4_img) != 0 { fails = fails + 1 }
    var u4 = evm_load(u4_img)
    if evm_run(&!u4) != 0 { fails = fails + 1 }
    if evm_frail_count(&u4) != 1 { fails = fails + 1 }
    if evm_gate_count(&u4) != 1 { fails = fails + 1 }
    if !f64_bits_eq(evm_reg_val(&u4, 3), 0.0) { fails = fails + 1 }
    if f64_parts(evm_reg_ehi(&u4, 3)).exp == 0 { fails = fails + 1 }

    // U5: exact-case exclusion (frail fica 0).
    let u5_img = eisax_encode(build_u5_exact_zero())
    if eisax_validate(u5_img) != 0 { fails = fails + 1 }
    var u5 = evm_load(u5_img)
    if evm_run(&!u5) != 0 { fails = fails + 1 }
    if evm_frail_count(&u5) != 0 { fails = fails + 1 }
    if evm_gate_count(&u5) != 1 { fails = fails + 1 }

    // U6: esgotamento de fuel.
    let u6_img = eisax_encode(build_u6_fuel())
    if eisax_validate(u6_img) != 0 { fails = fails + 1 }
    var u6 = evm_load(u6_img)
    if evm_run(&!u6) != 0 { fails = fails + 1 }
    if evm_stop_kind(&u6) != 1 { fails = fails + 1 }
    if evm_fuel_left(&u6) != 0 { fails = fails + 1 }
    if evm_gate_count(&u6) != 0 { fails = fails + 1 }
    if (5 - evm_fuel_left(&u6)) != 5 { fails = fails + 1 }

    // U7: regressão v0 inline (sem semântica v1).
    let u7_b = build_u7_v0()
    let u7_img = eisax_encode(u7_b)
    if eisax_validate(u7_img) != 0 { fails = fails + 1 }
    var u7 = evm_load(u7_img)
    if evm_run(&!u7) != 0 { fails = fails + 1 }
    if evm_version(&u7) != 0 { fails = fails + 1 }
    if evm_stop_kind(&u7) != 0 { fails = fails + 1 }
    if evm_frail_count(&u7) != 0 { fails = fails + 1 }
    if !f64_bits_eq(evm_mem_val(&u7, 0), 3.625) { fails = fails + 1 }

    var isa_m = emachine_new()
    var prog: [EInstr; 32] = [instr(op_econst(), 0, 0, 0, 0.0); 32]
    prog[0] = instr(op_econst(), 0, 0, 0, 0.5)
    prog[1] = instr(op_econst(), 1, 0, 0, 7.25)
    prog[2] = instr(op_emul(), 2, 0, 1, 0.0)
    prog[3] = instr(op_egate(), 2, 0, 0, 0.0)
    prog[4] = instr(op_estore(), 2, 0, 0, 0.0)
    if eisa_run(&!isa_m, &prog, 5) != 0 { fails = fails + 1 }
    var r = 0
    while r < 16 {
        if !f64_bits_eq(isa_m.reg_val[r as usize], evm_reg_val(&u7, r)) { fails = fails + 1 }
        if !f64_bits_eq(isa_m.reg_ehi[r as usize], evm_reg_ehi(&u7, r)) { fails = fails + 1 }
        if !f64_bits_eq(isa_m.reg_elo[r as usize], evm_reg_elo(&u7, r)) { fails = fails + 1 }
        if !f64_bits_eq(isa_m.reg_u[r as usize], evm_reg_u(&u7, r)) { fails = fails + 1 }
        if isa_m.reg_poison[r as usize] != evm_reg_poison(&u7, r) { fails = fails + 1 }
        r = r + 1
    }

    // U8: determinismo v1 (estado final bit-a-bit).
    let u8_img = eisax_encode(build_u1_loop())
    var u8a = evm_load(u8_img)
    var u8b = evm_load(u8_img)
    if evm_run(&!u8a) != 0 { fails = fails + 1 }
    if evm_run(&!u8b) != 0 { fails = fails + 1 }
    if evm_prog_hash(&u8a) != evm_prog_hash(&u8b) { fails = fails + 1 }
    if evm_fuel_left(&u8a) != evm_fuel_left(&u8b) { fails = fails + 1 }
    if evm_frail_count(&u8a) != evm_frail_count(&u8b) { fails = fails + 1 }
    if evm_gate_count(&u8a) != evm_gate_count(&u8b) { fails = fails + 1 }
    if evm_stop_kind(&u8a) != evm_stop_kind(&u8b) { fails = fails + 1 }
    r = 0
    while r < 64 {
        if !f64_bits_eq(evm_reg_val(&u8a, r), evm_reg_val(&u8b, r)) { fails = fails + 1 }
        if !f64_bits_eq(evm_reg_ehi(&u8a, r), evm_reg_ehi(&u8b, r)) { fails = fails + 1 }
        if !f64_bits_eq(evm_reg_elo(&u8a, r), evm_reg_elo(&u8b, r)) { fails = fails + 1 }
        if !f64_bits_eq(evm_reg_u(&u8a, r), evm_reg_u(&u8b, r)) { fails = fails + 1 }
        if evm_reg_poison(&u8a, r) != evm_reg_poison(&u8b, r) { fails = fails + 1 }
        r = r + 1
    }
    var s = 0
    while s < 32 {
        if !f64_bits_eq(evm_mem_val(&u8a, s), evm_mem_val(&u8b, s)) { fails = fails + 1 }
        if !f64_bits_eq(evm_mem_ehi(&u8a, s), evm_mem_ehi(&u8b, s)) { fails = fails + 1 }
        if !f64_bits_eq(evm_mem_elo(&u8a, s), evm_mem_elo(&u8b, s)) { fails = fails + 1 }
        if !f64_bits_eq(evm_mem_u(&u8a, s), evm_mem_u(&u8b, s)) { fails = fails + 1 }
        if evm_mem_poison(&u8a, s) != evm_mem_poison(&u8b, s) { fails = fails + 1 }
        s = s + 1
    }

    assert(fails == 0)
    println("ALL PASS: eisa evm v1 U1 ... U8")
    0
}
