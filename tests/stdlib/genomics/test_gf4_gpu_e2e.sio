//@ check-only
//@ expect-stdout: GF4_GPU_OK

use genomics::gpu::gf4::*

fn main() -> i32 with IO, Mut, Panic, Div {
    let rc = genomics::gpu::gf4::gf4_self_test()
    if rc == 0 {
        println("GF4_GPU_OK")
        return 0
    }
    print("GF4_GPU_FAIL ")
    print_int(rc as i64)
    println("")
    return 1
}