//@ run-pass
//! tests/stdlib/encoding/test_encoding_e2e.sio
//!
//! E2E tests for encoding::base64 and encoding::hex (RFC 4648).

use encoding::base64::{base64_encode, base64_decode, base64_encode_url_safe}
use encoding::hex::{hex_encode, hex_encode_upper, hex_encode_with_prefix, hex_decode}

// =============================================================================
// Helpers
// =============================================================================

fn u8_eq(a: u8, b: u8) -> bool { a == b }

// =============================================================================
// Base64 — Encode
// =============================================================================

fn test_base64_encode_man() with Mut, Div, Panic {
    // RFC 4648 §9 test vector: "Man" → "TWFu"
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 256] = [0; 256]
    input[0] = (77 as u8)   // 'M'
    input[1] = (97 as u8)   // 'a'
    input[2] = (110 as u8)  // 'n'

    let n = base64_encode(&input, 3, &!out)
    assert(n == 4)
    assert(out[0] == (84 as u8))   // 'T'
    assert(out[1] == (87 as u8))   // 'W'
    assert(out[2] == (70 as u8))   // 'F'
    assert(out[3] == (117 as u8))  // 'u'
}

fn test_base64_encode_one_byte_padding() with Mut, Div, Panic {
    // "M" → "TQ=="
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 256] = [0; 256]
    input[0] = (77 as u8)  // 'M'

    let n = base64_encode(&input, 1, &!out)
    assert(n == 4)
    assert(out[0] == (84 as u8))   // 'T'
    assert(out[1] == (81 as u8))   // 'Q'
    assert(out[2] == (61 as u8))   // '='
    assert(out[3] == (61 as u8))   // '='
}

fn test_base64_encode_two_byte_padding() with Mut, Div, Panic {
    // "Ma" → "TWE="
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 256] = [0; 256]
    input[0] = (77 as u8)   // 'M'
    input[1] = (97 as u8)   // 'a'

    let n = base64_encode(&input, 2, &!out)
    assert(n == 4)
    assert(out[0] == (84 as u8))   // 'T'
    assert(out[1] == (87 as u8))   // 'W'
    assert(out[2] == (69 as u8))   // 'E'
    assert(out[3] == (61 as u8))   // '='
}

fn test_base64_encode_empty() with Mut, Div, Panic {
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 256] = [0; 256]
    let n = base64_encode(&input, 0, &!out)
    assert(n == 0)
}

fn test_base64_encode_error_overflow() with Mut, Div, Panic {
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 256] = [0; 256]
    let n = base64_encode(&input, 193, &!out)
    assert(n == 0 - 1)
}

// =============================================================================
// Base64 — URL-safe Encode
// =============================================================================

fn test_base64_url_safe_no_padding() with Mut, Div, Panic {
    // URL-safe: no '=' padding for 1-byte input
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 256] = [0; 256]
    input[0] = (77 as u8)  // 'M'

    let n = base64_encode_url_safe(&input, 1, &!out)
    assert(n == 2)       // no padding
    assert(out[0] == (84 as u8))   // 'T'
    assert(out[1] == (81 as u8))   // 'Q'
}

// =============================================================================
// Base64 — Decode
// =============================================================================

fn test_base64_decode_man() with Mut, Div, Panic {
    // "TWFu" → "Man" = [77, 97, 110]
    var enc: [u8; 256] = [0; 256]
    var out: [u8; 256] = [0; 256]
    enc[0] = (84 as u8)    // 'T'
    enc[1] = (87 as u8)    // 'W'
    enc[2] = (70 as u8)    // 'F'
    enc[3] = (117 as u8)   // 'u'

    let n = base64_decode(&enc, 4, &!out)
    assert(n == 3)
    assert(out[0] == (77 as u8))
    assert(out[1] == (97 as u8))
    assert(out[2] == (110 as u8))
}

fn test_base64_decode_padded() with Mut, Div, Panic {
    // "TQ==" → [77]
    var enc: [u8; 256] = [0; 256]
    var out: [u8; 256] = [0; 256]
    enc[0] = (84 as u8)   // 'T'
    enc[1] = (81 as u8)   // 'Q'
    enc[2] = (61 as u8)   // '='
    enc[3] = (61 as u8)   // '='

    let n = base64_decode(&enc, 4, &!out)
    assert(n == 1)
    assert(out[0] == (77 as u8))
}

// =============================================================================
// Hex — Encode lowercase
// =============================================================================

fn test_hex_encode_deadbeef() with Mut, Div, Panic {
    // [0xDE, 0xAD] → "dead"
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 512] = [0; 512]
    input[0] = (222 as u8)   // 0xDE
    input[1] = (173 as u8)   // 0xAD

    let n = hex_encode(&input, 2, &!out)
    assert(n == 4)
    assert(out[0] == (100 as u8))  // 'd'
    assert(out[1] == (101 as u8))  // 'e'
    assert(out[2] == (97 as u8))   // 'a'
    assert(out[3] == (100 as u8))  // 'd'
}

fn test_hex_encode_ff00() with Mut, Div, Panic {
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 512] = [0; 512]
    input[0] = (255 as u8)  // 0xFF
    input[1] = (0 as u8)    // 0x00

    let n = hex_encode(&input, 2, &!out)
    assert(n == 4)
    assert(out[0] == (102 as u8))  // 'f'
    assert(out[1] == (102 as u8))  // 'f'
    assert(out[2] == (48 as u8))   // '0'
    assert(out[3] == (48 as u8))   // '0'
}

fn test_hex_encode_empty() with Mut, Div, Panic {
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 512] = [0; 512]
    let n = hex_encode(&input, 0, &!out)
    assert(n == 0)
}

// =============================================================================
// Hex — Encode uppercase
// =============================================================================

fn test_hex_encode_upper_deadbeef() with Mut, Div, Panic {
    // [0xDE, 0xAD] → "DEAD"
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 512] = [0; 512]
    input[0] = (222 as u8)   // 0xDE
    input[1] = (173 as u8)   // 0xAD

    let n = hex_encode_upper(&input, 2, &!out)
    assert(n == 4)
    assert(out[0] == (68 as u8))   // 'D'
    assert(out[1] == (69 as u8))   // 'E'
    assert(out[2] == (65 as u8))   // 'A'
    assert(out[3] == (68 as u8))   // 'D'
}

// =============================================================================
// Hex — Encode with prefix
// =============================================================================

fn test_hex_encode_prefix() with Mut, Div, Panic {
    // [0xFF] → "0xff"
    var input: [u8; 256] = [0; 256]
    var out:   [u8; 512] = [0; 512]
    input[0] = (255 as u8)

    let n = hex_encode_with_prefix(&input, 1, &!out)
    assert(n == 4)
    assert(out[0] == (48 as u8))   // '0'
    assert(out[1] == (120 as u8))  // 'x'
    assert(out[2] == (102 as u8))  // 'f'
    assert(out[3] == (102 as u8))  // 'f'
}

// =============================================================================
// Hex — Decode
// =============================================================================

fn test_hex_decode_lowercase() with Mut, Div, Panic {
    // "dead" → [0xDE, 0xAD]
    var hex: [u8; 512] = [0; 512]
    var out: [u8; 256] = [0; 256]
    hex[0] = (100 as u8)   // 'd'
    hex[1] = (101 as u8)   // 'e'
    hex[2] = (97 as u8)    // 'a'
    hex[3] = (100 as u8)   // 'd'

    let n = hex_decode(&hex, 4, &!out)
    assert(n == 2)
    assert(out[0] == (222 as u8))  // 0xDE
    assert(out[1] == (173 as u8))  // 0xAD
}

fn test_hex_decode_uppercase() with Mut, Div, Panic {
    // "DEAD" → [0xDE, 0xAD]
    var hex: [u8; 512] = [0; 512]
    var out: [u8; 256] = [0; 256]
    hex[0] = (68 as u8)    // 'D'
    hex[1] = (69 as u8)    // 'E'
    hex[2] = (65 as u8)    // 'A'
    hex[3] = (68 as u8)    // 'D'

    let n = hex_decode(&hex, 4, &!out)
    assert(n == 2)
    assert(out[0] == (222 as u8))
    assert(out[1] == (173 as u8))
}

fn test_hex_decode_with_0x_prefix() with Mut, Div, Panic {
    // "0xff" → [0xFF]
    var hex: [u8; 512] = [0; 512]
    var out: [u8; 256] = [0; 256]
    hex[0] = (48 as u8)    // '0'
    hex[1] = (120 as u8)   // 'x'
    hex[2] = (102 as u8)   // 'f'
    hex[3] = (102 as u8)   // 'f'

    let n = hex_decode(&hex, 4, &!out)
    assert(n == 1)
    assert(out[0] == (255 as u8))
}

fn test_hex_decode_odd_length_error() with Mut, Div, Panic {
    // Odd length → error (-1)
    var hex: [u8; 512] = [0; 512]
    var out: [u8; 256] = [0; 256]
    hex[0] = (97 as u8)   // 'a'

    let n = hex_decode(&hex, 1, &!out)
    assert(n == 0 - 1)
}

// =============================================================================
// Main
// =============================================================================

pub fn main() with Mut, Div, Panic {
    test_base64_encode_man()
    test_base64_encode_one_byte_padding()
    test_base64_encode_two_byte_padding()
    test_base64_encode_empty()
    test_base64_encode_error_overflow()
    test_base64_url_safe_no_padding()
    test_base64_decode_man()
    test_base64_decode_padded()
    test_hex_encode_deadbeef()
    test_hex_encode_ff00()
    test_hex_encode_empty()
    test_hex_encode_upper_deadbeef()
    test_hex_encode_prefix()
    test_hex_decode_lowercase()
    test_hex_decode_uppercase()
    test_hex_decode_with_0x_prefix()
    test_hex_decode_odd_length_error()
}
