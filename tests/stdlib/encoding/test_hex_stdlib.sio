// Run-proof for stdlib encoding::hex. By-reference API -> default Madaros.
use encoding::hex::*
fn main() -> i32 with IO, Mut, Div, Panic {
    var data: [u8; 256] = [0; 256]
    data[0] = 255   // 0xff
    data[1] = 16    // 0x10
    var out: [u8; 512] = [0; 512]
    // encode -> "ff10" = bytes 'f','f','1','0' = 102,102,49,48
    let n = hex_encode(&data, 2, &!out)
    if n != 4 { print("FAIL enc_len\n"); return 1 }
    if out[0] as i64 != 102 { print("FAIL e0\n"); return 2 }
    if out[1] as i64 != 102 { print("FAIL e1\n"); return 3 }
    if out[2] as i64 != 49  { print("FAIL e2\n"); return 4 }
    if out[3] as i64 != 48  { print("FAIL e3\n"); return 5 }
    // uppercase -> "FF10" = 70,70,49,48
    var outu: [u8; 512] = [0; 512]
    let nu = hex_encode_upper(&data, 2, &!outu)
    if nu != 4 { print("FAIL up_len\n"); return 6 }
    if outu[0] as i64 != 70 { print("FAIL up0\n"); return 7 }
    if outu[1] as i64 != 70 { print("FAIL up1\n"); return 8 }
    // encode with 0x prefix -> "0xff10" = 48,120,102,102,49,48
    var outp: [u8; 512] = [0; 512]
    let np = hex_encode_with_prefix(&data, 2, &!outp)
    if np != 6 { print("FAIL pref_len\n"); return 9 }
    if outp[0] as i64 != 48  { print("FAIL p0\n"); return 10 }
    if outp[1] as i64 != 120 { print("FAIL p1\n"); return 11 }
    if outp[2] as i64 != 102 { print("FAIL p2\n"); return 12 }
    if outp[5] as i64 != 48  { print("FAIL p5\n"); return 13 }
    // decode round-trip: hex "abcd" (bytes 0xab,0xcd = 171,205)
    var hx: [u8; 512] = [0; 512]
    hx[0] = 97   // a
    hx[1] = 98   // b
    hx[2] = 99   // c
    hx[3] = 100  // d
    var dec: [u8; 256] = [0; 256]
    let m = hex_decode(&hx, 4, &!dec)
    if m != 2 { print("FAIL dec_len\n"); return 14 }
    if dec[0] as i64 != 171 { print("FAIL d0\n"); return 15 }
    if dec[1] as i64 != 205 { print("FAIL d1\n"); return 16 }
    // decode uppercase ("FF10") and 0x-prefixed ("0xff10")
    var decu: [u8; 256] = [0; 256]
    let mu = hex_decode(&outu, 4, &!decu)
    if mu != 2 || decu[0] as i64 != 255 || decu[1] as i64 != 16 { print("FAIL dec_up\n"); return 17 }
    var decp: [u8; 256] = [0; 256]
    let mp = hex_decode(&outp, 6, &!decp)
    if mp != 2 || decp[0] as i64 != 255 || decp[1] as i64 != 16 { print("FAIL dec_pref\n"); return 18 }
    // error boundaries: out-of-range lengths, odd hex length, invalid hex digit
    if hex_encode(&data, 0 - 1, &!out) != (0 - 1) { print("FAIL err_enc_neg\n"); return 19 }
    if hex_encode(&data, 257, &!out) != (0 - 1) { print("FAIL err_enc_max\n"); return 20 }
    if hex_encode_with_prefix(&data, 256, &!outp) != (0 - 1) { print("FAIL err_pref_max\n"); return 21 }
    if hex_decode(&hx, 3, &!dec) != (0 - 1) { print("FAIL err_dec_odd\n"); return 22 }
    hx[0] = 103  // 'g' (invalid hex digit)
    if hex_decode(&hx, 2, &!dec) != (0 - 1) { print("FAIL err_dec_inv\n"); return 23 }
    print("HEX_STDLIB_OK\n")
    return 0
}
