//@ run-pass
// E2E test for stdlib/special/erf
// Tests: erf, erfc, erfinv, normal_cdf, normal_quantile

use special::erf::{erf, erfc, erfinv, normal_cdf, normal_quantile}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // --- erf ---

    // Test 1: erf(0) == 0
    let v1 = erf(0.0)
    if check_near(v1, 0.0, 1.0e-10) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 2: erf(1) ≈ 0.8427007929...
    let v2 = erf(1.0)
    if check_near(v2, 0.8427007929497148, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 3: erf(-1) ≈ -0.8427007929...
    let v3 = erf(0.0 - 1.0)
    if check_near(v3, 0.0 - 0.8427007929497148, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 4: erf(2) ≈ 0.9953222650...
    let v4 = erf(2.0)
    if check_near(v4, 0.9953222650189527, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 5: erf(3) ≈ 0.9999779095...
    let v5 = erf(3.0)
    if check_near(v5, 0.9999779095030014, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 6: erf odd symmetry — erf(-2) == -erf(2)
    let v6a = erf(0.0 - 2.0)
    let v6b = erf(2.0)
    if check_near(v6a, 0.0 - v6b, 1.0e-10) { pass = pass + 1 } else { fail = fail + 1 }

    // --- erfc ---

    // Test 7: erfc(0) == 1
    let v7 = erfc(0.0)
    if check_near(v7, 1.0, 1.0e-10) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 8: erfc(1) ≈ 0.1572992070...
    let v8 = erfc(1.0)
    if check_near(v8, 0.15729920705028513, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 9: erfc(x) + erf(x) == 1 for x = 0.5
    let v9a = erf(0.5)
    let v9b = erfc(0.5)
    if check_near(v9a + v9b, 1.0, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 10: erfc large x — erfc(5) should be very small but positive
    let v10 = erfc(5.0)
    if v10 > 0.0 && v10 < 1.0e-10 { pass = pass + 1 } else { fail = fail + 1 }

    // --- erfinv ---

    // Test 11: erfinv(0) == 0
    let v11 = erfinv(0.0)
    if check_near(v11, 0.0, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 12: erfinv(erf(0.5)) ≈ 0.5
    let erf_half = erf(0.5)
    let v12 = erfinv(erf_half)
    if check_near(v12, 0.5, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 13: erf(erfinv(0.3)) ≈ 0.3 — round-trip
    let v13 = erf(erfinv(0.3))
    if check_near(v13, 0.3, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 14: erfinv(-0.5) ≈ -erfinv(0.5) — odd symmetry
    let v14a = erfinv(0.5)
    let v14b = erfinv(0.0 - 0.5)
    if check_near(v14a + v14b, 0.0, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 15: erfinv of large-region value — erfinv(erf(1.2)) ≈ 1.2
    let v15 = erfinv(erf(1.2))
    if check_near(v15, 1.2, 1.0e-5) { pass = pass + 1 } else { fail = fail + 1 }

    // --- normal_cdf ---

    // Test 16: normal_cdf(0) == 0.5
    let v16 = normal_cdf(0.0)
    if check_near(v16, 0.5, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 17: normal_cdf(1.96) ≈ 0.975
    let v17 = normal_cdf(1.96)
    if check_near(v17, 0.9750021048517795, 1.0e-4) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 18: normal_cdf(-1.96) ≈ 0.025
    let v18 = normal_cdf(0.0 - 1.96)
    if check_near(v18, 0.024997895148220488, 1.0e-4) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 19: normal_cdf symmetry: cdf(-x) + cdf(x) == 1
    let v19a = normal_cdf(1.0)
    let v19b = normal_cdf(0.0 - 1.0)
    if check_near(v19a + v19b, 1.0, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }

    // --- normal_quantile ---

    // Test 20: normal_quantile(0.5) ≈ 0.0
    let v20 = normal_quantile(0.5)
    if check_near(v20, 0.0, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 21: normal_quantile(0.975) ≈ 1.96
    let v21 = normal_quantile(0.975)
    if check_near(v21, 1.959963985, 1.0e-3) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 22: round-trip — normal_cdf(normal_quantile(0.9)) ≈ 0.9
    let v22 = normal_cdf(normal_quantile(0.9))
    if check_near(v22, 0.9, 1.0e-5) { pass = pass + 1 } else { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
