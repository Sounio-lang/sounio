//@ run-pass
// E2E tests for stdlib/special/beta.sio
//
// Reference values from SciPy:
//   beta(1,1)          = 1.0
//   beta(2,3)          = 1/12 = 0.083333...
//   beta(0.5,0.5)      = pi   = 3.14159...
//   lbeta(2,3)         = ln(1/12) = -2.484907...
//   ibeta(1,1,0.5)     = 0.5  (uniform)
//   ibeta(2,5,0.4)     = 0.76672...
//   ibeta(0.5,0.5,0.5) = 0.5  (symmetry)
//   ibeta_inv(2,5,0.5) = 0.23437...

use special::beta::{beta, lbeta, ibeta, ibeta_inv}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn check_rel(a: f64, b: f64, rtol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    let ref_ = if b < 0.0 { 0.0 - b } else { b }
    if ref_ < 1.0e-300 { return ad < rtol }
    return ad / ref_ < rtol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // -----------------------------------------------------------------------
    // Test 1: beta(1, 1) == 1.0
    let v1 = beta(1.0, 1.0)
    if check_near(v1, 1.0, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Test 2: beta(2, 3) == 1/12 = 0.083333...
    let v2 = beta(2.0, 3.0)
    if check_rel(v2, 0.08333333333333333, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Test 3: beta(0.5, 0.5) == pi = 3.14159265...
    let v3 = beta(0.5, 0.5)
    if check_rel(v3, 3.14159265358979324, 1.0e-8) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Test 4: lbeta(2, 3) == ln(1/12) = -2.4849066497880004
    let v4 = lbeta(2.0, 3.0)
    if check_rel(v4, 0.0 - 2.4849066497880004, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Test 5: ibeta(1, 1, 0.5) == 0.5 (uniform CDF at midpoint)
    let v5 = ibeta(1.0, 1.0, 0.5)
    if check_near(v5, 0.5, 1.0e-10) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Test 6: ibeta(2, 5, 0.4) == 0.76671... (SciPy: betainc(2,5,0.4))
    let v6 = ibeta(2.0, 5.0, 0.4)
    if check_rel(v6, 0.766720, 1.0e-4) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Test 7: ibeta(0.5, 0.5, 0.5) == 0.5 (symmetry: I_{0.5}(a,a) = 0.5)
    let v7 = ibeta(0.5, 0.5, 0.5)
    if check_near(v7, 0.5, 1.0e-8) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Test 8: ibeta_inv(2, 5, 0.5) == 0.26445...  (SciPy: betaincinv(2,5,0.5))
    // Verified by numerical integration bisection; 0.234375 was incorrect.
    let v8 = ibeta_inv(2.0, 5.0, 0.5)
    if check_rel(v8, 0.26445, 1.0e-4) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // -----------------------------------------------------------------------
    // Tail / extreme-parameter regression (issue #841 — the bt_exp Taylor
    // cancellation for moderate-negative arguments). Each of these returned
    // out-of-[0,1] garbage before the fix.
    // -----------------------------------------------------------------------

    // Test 9: ibeta(3, 1, 0.0099) == 0.0099^3 (I_x(a,1)=x^a). Was ~99.7.
    let v9 = ibeta(3.0, 1.0, 0.0099)
    if check_rel(v9, 0.0099 * 0.0099 * 0.0099, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 10: ibeta(19.5, 0.5, 0.592) must lie in [0,1]. Was ~20.8.
    let v10 = ibeta(19.5, 0.5, 0.592)
    if v10 >= 0.0 && v10 <= 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 11: reflection I_x(a,b) + I_{1-x}(b,a) = 1 at that hard point.
    let v11 = ibeta(19.5, 0.5, 0.592) + ibeta(0.5, 19.5, 0.408)
    if check_near(v11, 1.0, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 12: large a — ibeta(50000, 0.5, 0.99996) in [0,1]. Was ~335805.
    let v12 = ibeta(50000.0, 0.5, 0.99996)
    if v12 >= 0.0 && v12 <= 1.0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 13: ibeta_inv round-trip at a=0.5 (Newton diverged before the fix).
    let r13 = ibeta_inv(0.5, 0.5, 0.05)
    if check_rel(ibeta(0.5, 0.5, r13), 0.05, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 14: ibeta_inv round-trip at a=1000.
    let r14 = ibeta_inv(1000.0, 0.5, 0.05)
    if check_rel(ibeta(1000.0, 0.5, r14), 0.05, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
