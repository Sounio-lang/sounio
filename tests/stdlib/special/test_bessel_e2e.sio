//@ run-pass
// E2E test for stdlib/special/bessel
// Tests: bessel_j0, bessel_j1, bessel_y0, bessel_i0, bessel_k0

use special::bessel::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: J0(0) = 1.0
    let j0_zero = bessel_j0(0.0)
    if check_near(j0_zero, 1.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: J1(0) = 0.0
    let j1_zero = bessel_j1(0.0)
    if check_near(j1_zero, 0.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: J0(2.4048) approx 0.0 (first zero of J0)
    let j0_first_zero = bessel_j0(2.4048)
    if check_near(j0_first_zero, 0.0, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: J0(1.0) approx 0.7652 (known value)
    let j0_one = bessel_j0(1.0)
    if check_near(j0_one, 0.7652, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: J1(1.0) approx 0.4401 (known value)
    let j1_one = bessel_j1(1.0)
    if check_near(j1_one, 0.4401, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: I0(0) = 1.0
    let i0_zero = bessel_i0(0.0)
    if check_near(i0_zero, 1.0, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: Jn(0, x) == J0(x)
    let jn0 = bessel_jn(0, 1.5)
    let j0_15 = bessel_j0(1.5)
    if check_near(jn0, j0_15, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
