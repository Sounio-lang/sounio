//@ run-pass
// E2E tests for stdlib/special/igamma and stdlib/special/bessel
//
// Reference values:
//   igamma_lower(1, 1) = 1 - e^{-1}       ≈ 0.63212055882...
//   igamma_lower(2, 1) = 1 - 2*e^{-1}     ≈ 0.26424111765...
//   igamma_upper(1, 1) = e^{-1}            ≈ 0.36787944117...
//   chi2_cdf(3.841, 1) ≈ 0.95              (chi2 p-value 5% threshold)
//   bessel_j0(0)       = 1.0
//   bessel_j0(2.4048)  ≈ 0.0              (first zero of J0)
//   bessel_j1(0)       = 0.0
//   bessel_j1(3.8317)  ≈ 0.0              (first zero of J1)
//   bessel_jn(2, 5.0)  ≈ 0.04656511628...

use special::igamma::{igamma_lower, igamma_upper, chi2_cdf}
use special::bessel::{bessel_j0, bessel_j1, bessel_jn}

// Absolute-value helper
fn t_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Check that |a - b| < tol
fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // ------------------------------------------------------------------
    // igamma_lower tests
    // ------------------------------------------------------------------

    // T1: igamma_lower(1, 1) = 1 - e^{-1} ≈ 0.63212
    let p11 = igamma_lower(1.0, 1.0)
    if check_near(p11, 0.6321205588285578, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T2: igamma_lower(2, 1) ≈ 0.26424
    let p21 = igamma_lower(2.0, 1.0)
    if check_near(p21, 0.2642411176571153, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T3: igamma_lower(0.5, 1) — a < 1, uses series; roughly 0.8427...
    // erf(1) = 0.8427007929..., P(0.5, 1) = erf(1) ≈ 0.8427
    let p05_1 = igamma_lower(0.5, 1.0)
    if check_near(p05_1, 0.8427007929497148, 1.0e-5) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T4: igamma_lower(5, 1) ≈ 0.003659846... (very small, x << a)
    let p51 = igamma_lower(5.0, 1.0)
    if check_near(p51, 0.003659846827343713, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // igamma_upper tests
    // ------------------------------------------------------------------

    // T5: igamma_upper(1, 1) = e^{-1} ≈ 0.36788
    let q11 = igamma_upper(1.0, 1.0)
    if check_near(q11, 0.36787944117144233, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T6: igamma_lower + igamma_upper = 1 for (3, 2)
    let pv = igamma_lower(3.0, 2.0)
    let qv = igamma_upper(3.0, 2.0)
    if check_near(pv + qv, 1.0, 1.0e-12) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T7: igamma_upper(2, 5) — x >> a, Q should be small
    let q25 = igamma_upper(2.0, 5.0)
    // Q(2,5) = e^{-5}*(1+5) = 6*e^{-5} ≈ 0.04042...
    if check_near(q25, 0.04042768199451344, 1.0e-5) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // chi2_cdf tests
    // ------------------------------------------------------------------

    // T8: chi2_cdf(3.841, 1) ≈ 0.95  (standard 5% critical value)
    let c2 = chi2_cdf(3.841, 1.0)
    if check_near(c2, 0.95, 5.0e-3) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T9: chi2_cdf(0, k) = 0 for any k
    let c2_zero = chi2_cdf(0.0, 2.0)
    if check_near(c2_zero, 0.0, 1.0e-12) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T10: chi2_cdf(9.488, 4) ≈ 0.95
    let c2_k4 = chi2_cdf(9.488, 4.0)
    if check_near(c2_k4, 0.95, 5.0e-3) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // bessel_j0 tests
    // ------------------------------------------------------------------

    // T11: J0(0) = 1.0 (polynomial approximation; tolerance 1e-7)
    let j0_0 = bessel_j0(0.0)
    if check_near(j0_0, 1.0, 1.0e-7) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T12: J0(2.4048) ≈ 0.0 (first zero of J0)
    let j0_z1 = bessel_j0(2.4048)
    if check_near(j0_z1, 0.0, 1.0e-3) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T13: J0(1.0) ≈ 0.7651976...
    let j0_1 = bessel_j0(1.0)
    if check_near(j0_1, 0.7651976865579666, 1.0e-5) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T14: J0(10.0) ≈ -0.2459357644...
    let j0_10 = bessel_j0(10.0)
    if check_near(j0_10, 0.0 - 0.2459357644513483, 1.0e-4) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // bessel_j1 tests
    // ------------------------------------------------------------------

    // T15: J1(0) = 0.0 exactly (x=0 makes p=0 exactly)
    let j1_0 = bessel_j1(0.0)
    if check_near(j1_0, 0.0, 1.0e-7) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T16: J1(3.8317) ≈ 0.0 (first zero of J1)
    let j1_z1 = bessel_j1(3.8317)
    if check_near(j1_z1, 0.0, 1.0e-3) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T17: J1(1.0) ≈ 0.4400505857...
    let j1_1 = bessel_j1(1.0)
    if check_near(j1_1, 0.4400505857449335, 1.0e-5) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T18: J1(-1.0) = -J1(1.0)  (odd function)
    let j1_neg1 = bessel_j1(0.0 - 1.0)
    if check_near(j1_neg1, 0.0 - 0.4400505857449335, 1.0e-5) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // ------------------------------------------------------------------
    // bessel_jn tests
    // ------------------------------------------------------------------

    // T19: Jn(0, x) == J0(x)
    let jn0 = bessel_jn(0, 1.0)
    if check_near(jn0, bessel_j0(1.0), 1.0e-7) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T20: Jn(1, x) == J1(x)
    let jn1 = bessel_jn(1, 1.0)
    if check_near(jn1, bessel_j1(1.0), 1.0e-7) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T21: Jn(2, 5.0) ≈ 0.04656511628... (DLMF 10.2)
    let jn2_5 = bessel_jn(2, 5.0)
    if check_near(jn2_5, 0.04656511628246888, 1.0e-5) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // T22: Jn(3, 1.0) ≈ 0.01956335398...
    let jn3_1 = bessel_jn(3, 1.0)
    if check_near(jn3_1, 0.019563353982668403, 1.0e-6) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    return run_tests()
}
