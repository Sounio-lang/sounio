//@ run-pass
// E2E test for stdlib/special/airy
// Tests: airy_ai, airy_bi, airy_ai_prime, airy_bi_prime

use special::airy::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: Ai(0) = 1/(3^{2/3} * Gamma(2/3)) approx 0.35503
    let ai0 = airy_ai(0.0)
    if check_near(ai0, 0.35503, 0.001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: Bi(0) = sqrt(3) * Ai(0) approx 0.6149
    let bi0 = airy_bi(0.0)
    if check_near(bi0, 0.6149, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: Ai(1.0) approx 0.1353 (from DLMF tables)
    let ai1 = airy_ai(1.0)
    if check_near(ai1, 0.1353, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: Bi(1.0) approx 1.2074
    let bi1 = airy_bi(1.0)
    if check_near(bi1, 1.2074, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: Ai'(0) approx -0.25882
    let aip0 = airy_ai_prime(0.0)
    if check_near(aip0, 0.0 - 0.25882, 0.01) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: Ai is decreasing for positive x: Ai(2) < Ai(1)
    let ai2 = airy_ai(2.0)
    if ai2 < ai1 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    return run_tests()
}
