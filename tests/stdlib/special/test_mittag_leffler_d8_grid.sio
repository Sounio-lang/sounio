//@ run-pass
// D.8 negative-real Mittag-Leffler grid regression.

use special::caputo::{
    mittag_leffler_e_alpha
}

fn ml_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn ml_rel_close(got: f64, expected: f64, rtol: f64) -> bool with Div {
    let scale = if ml_abs(expected) > 1.0 { ml_abs(expected) } else { 1.0 }
    return ml_abs(got - expected) / scale <= rtol
}

fn check(alpha: f64, z: f64, expected: f64) -> bool with Mut, Div, Panic {
    return ml_rel_close(mittag_leffler_e_alpha(alpha, z), expected, 1.0e-8)
}

fn run_grid() -> bool with Mut, Div, Panic {
    var ok = true

    ok = check(0.5, -10.0, 0.056140992743822586) && ok
    ok = check(0.5, -20.0, 0.028174348741051319) && ok
    ok = check(0.5, -50.0, 0.011281536265323773) && ok
    ok = check(0.5, -100.0, 0.005641613782989433) && ok

    ok = check(0.7, -10.0, 0.07736295200035552) && ok
    ok = check(0.7, -20.0, 0.04519513856549234) && ok
    ok = check(0.7, -50.0, 0.022762834959846902) && ok
    ok = check(0.7, -100.0, 0.013738939227872674) && ok

    ok = check(0.8, -10.0, 0.04297930131770153) && ok
    ok = check(0.8, -20.0, 0.022381088674434894) && ok
    ok = check(0.8, -50.0, 0.010076920355356178) && ok
    ok = check(0.8, -100.0, 0.005648323672033756) && ok

    ok = check(0.9, -10.0, 0.0172593795136312) && ok
    ok = check(0.9, -20.0, 0.008036851226133939) && ok
    ok = check(0.9, -50.0, 0.003272422290569466) && ok
    ok = check(0.9, -100.0, 0.0017113705332184073) && ok

    return ok
}

fn main() -> i32 with IO, Mut, Div, Panic {
    if !run_grid() {
        println("ML_NEGATIVE_Z_FIX_FAIL")
        return 1
    }
    println("ML_NEGATIVE_Z_FIX_PASS")
    return 0
}
