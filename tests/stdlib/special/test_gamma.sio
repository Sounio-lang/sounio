//@ run-pass
// E2E test for stdlib/special/gamma
// Validates lgamma, gamma, and digamma against known reference values.

use special::gamma::*

fn gm_abs_local(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn check_near(label: i32, got: f64, expected: f64, tol: f64) -> bool {
    let diff = gm_abs_local(got - expected)
    return diff < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // ---- lgamma tests ----

    // lgamma(1) = ln(Γ(1)) = ln(1) = 0.0
    let lg1 = lgamma(1.0)
    if check_near(1, lg1, 0.0, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // lgamma(2) = ln(Γ(2)) = ln(1) = 0.0
    let lg2 = lgamma(2.0)
    if check_near(2, lg2, 0.0, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // lgamma(0.5) = ln(√π) ≈ 0.5723649429247001
    let lg_half = lgamma(0.5)
    if check_near(3, lg_half, 0.5723649429247001, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // lgamma(5) = ln(4!) = ln(24) ≈ 3.1780538303479458
    let lg5 = lgamma(5.0)
    if check_near(4, lg5, 3.1780538303479458, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // lgamma(10) = ln(9!) = ln(362880) ≈ 12.801827480081470
    let lg10 = lgamma(10.0)
    if check_near(5, lg10, 12.801827480081470, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // ---- gamma tests ----

    // gamma(5) = 4! = 24.0
    let g5 = gamma(5.0)
    if check_near(6, g5, 24.0, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }

    // gamma(0.5) = √π ≈ 1.7724538509055159
    let g_half = gamma(0.5)
    if check_near(7, g_half, 1.7724538509055159, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }

    // gamma(1) = 1.0
    let g1 = gamma(1.0)
    if check_near(8, g1, 1.0, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // gamma(2) = 1.0
    let g2 = gamma(2.0)
    if check_near(9, g2, 1.0, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // ---- digamma tests ----

    // digamma(1) = -γ ≈ -0.5772156649015329 (Euler–Mascheroni constant)
    let dg1 = digamma(1.0)
    if check_near(10, dg1, 0.0 - 0.5772156649015329, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // digamma(2) = 1 - γ ≈ 0.4227843350984671
    let dg2 = digamma(2.0)
    if check_near(11, dg2, 0.4227843350984671, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    // digamma(10) ≈ 2.251752589066721
    let dg10 = digamma(10.0)
    if check_near(12, dg10, 2.251752589066721, 1.0e-9) { pass = pass + 1 } else { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
