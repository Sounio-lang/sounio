// Deepened run-proof for stdlib special::beta — log-beta and additional regularized-incomplete-beta
// anchors (uniform CDF, arcsine law) beyond test_beta_stdlib.sio. lean_single engine.
use special::beta::*
fn ae(a: f64, b: f64) -> f64 { if a > b { a - b } else { b - a } }
fn main() -> i32 with IO, Mut, Div, Panic {
    // lbeta(a,b) = ln B(a,b): B(2,3)=1/12 -> ln = -2.484906650 ; B(1,1)=1 -> ln = 0
    if ae(lbeta(2.0, 3.0), 0.0 - 2.484906650) >= 1.0e-5 { print("FAIL lbeta23\n"); return 1 }
    if ae(lbeta(1.0, 1.0), 0.0) >= 1.0e-9 { print("FAIL lbeta11\n"); return 2 }
    // I_x(1,1) = x  (the Beta(1,1)=Uniform CDF)
    if ae(ibeta(1.0, 1.0, 0.3), 0.3) >= 1.0e-6 { print("FAIL ibeta_unif03\n"); return 3 }
    if ae(ibeta(1.0, 1.0, 0.75), 0.75) >= 1.0e-6 { print("FAIL ibeta_unif75\n"); return 4 }
    // I_0.5(1/2,1/2) = (2/pi) arcsin(sqrt 0.5) = 0.5  (arcsine law)
    if ae(ibeta(0.5, 0.5, 0.5), 0.5) >= 1.0e-5 { print("FAIL ibeta_arcsine\n"); return 5 }
    print("BETA_DEEP_STDLIB_OK\n")
    return 0
}
