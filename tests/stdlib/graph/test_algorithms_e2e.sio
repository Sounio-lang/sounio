//@ run-pass
//@ expect-stdout: ALL PASS
// E2E test for stdlib/graph/algorithms — WeightedGraph-based API.
// Rewrites the original [[usize]]-based tests using WeightedGraph/ShortestPathResult.

use graph::algorithms::*

fn main() with IO, Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: BFS on path graph 0-1-2-3 (unit weights), distances from 0
    print("Test 1 [bfs path graph]: ")
    var g1 = wgraph_new(4, 0)
    g1 = wgraph_add_edge(g1, 0, 1, 1.0, 0.0)
    g1 = wgraph_add_edge(g1, 1, 2, 1.0, 0.0)
    g1 = wgraph_add_edge(g1, 2, 3, 1.0, 0.0)
    let r1 = graph_bfs(&g1, 0)
    if r1.distances[0] == 0.0 && r1.distances[1] == 1.0 && r1.distances[2] == 2.0 && r1.distances[3] == 3.0 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 2: BFS on triangle, distance 0→2 should be 1
    print("Test 2 [bfs triangle dist 0->2 = 1]: ")
    var g2 = wgraph_new(3, 0)
    g2 = wgraph_add_edge(g2, 0, 1, 1.0, 0.0)
    g2 = wgraph_add_edge(g2, 0, 2, 1.0, 0.0)
    g2 = wgraph_add_edge(g2, 1, 2, 1.0, 0.0)
    let r2 = graph_bfs(&g2, 0)
    if r2.distances[2] == 1.0 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 3: two disconnected components (0-1 and 2-3) → num_components = 2
    print("Test 3 [dfs components = 2]: ")
    var g3 = wgraph_new(4, 0)
    g3 = wgraph_add_edge(g3, 0, 1, 1.0, 0.0)
    g3 = wgraph_add_edge(g3, 2, 3, 1.0, 0.0)
    let nc = graph_dfs_connected(&g3)
    if nc == 2 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 4: connected graph → num_components = 1
    print("Test 4 [dfs connected = 1]: ")
    var g4 = wgraph_new(3, 0)
    g4 = wgraph_add_edge(g4, 0, 1, 1.0, 0.0)
    g4 = wgraph_add_edge(g4, 1, 2, 1.0, 0.0)
    let nc4 = graph_dfs_connected(&g4)
    if nc4 == 1 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    // Test 5: isolated node → components = 2
    print("Test 5 [dfs isolated node = 2]: ")
    var g5 = wgraph_new(3, 0)
    g5 = wgraph_add_edge(g5, 0, 1, 1.0, 0.0)
    let nc5 = graph_dfs_connected(&g5)
    if nc5 == 2 {
        println("PASS")
        pass = pass + 1
    } else {
        println("FAIL")
        fail = fail + 1
    }

    println("")
    print("Passed: ")
    print(pass)
    print("  Failed: ")
    println(fail)
    println("")
    if fail == 0 {
        println("ALL PASS")
    }
}
