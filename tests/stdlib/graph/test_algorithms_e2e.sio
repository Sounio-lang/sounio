//@ run-pass
//@ known-failure: Requires implementation
// E2E test for stdlib/graph/algorithms
//
// Tests BFS, shortest path distance, connected components,
// and connectivity checking on small graphs.

use graph::algorithms::*

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: BFS on path graph 0-1-2-3, distances from 0
    print("Test 1: bfs path graph... ")
    var adj1: [[usize]] = [[], [], [], []]
    adj1[0].push(1)
    adj1[1].push(0)
    adj1[1].push(2)
    adj1[2].push(1)
    adj1[2].push(3)
    adj1[3].push(2)
    let r1 = bfs(&adj1, 0)
    let d0: i64 = 0
    let d1: i64 = 1
    let d2: i64 = 2
    let d3: i64 = 3
    if r1.distances[0] == d0 && r1.distances[1] == d1 && r1.distances[2] == d2 && r1.distances[3] == d3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: Shortest path distance in triangle
    print("Test 2: shortest_path_distance triangle... ")
    var adj2: [[usize]] = [[], [], []]
    adj2[0].push(1)
    adj2[0].push(2)
    adj2[1].push(0)
    adj2[1].push(2)
    adj2[2].push(0)
    adj2[2].push(1)
    let spd = shortest_path_distance(&adj2, 0, 2)
    let expected_spd: i64 = 1
    if spd == expected_spd {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: Connected components - two disconnected edges
    print("Test 3: num_components=2... ")
    var adj3: [[usize]] = [[], [], [], []]
    adj3[0].push(1)
    adj3[1].push(0)
    adj3[2].push(3)
    adj3[3].push(2)
    let nc = num_components(&adj3)
    let expected_nc: usize = 2
    if nc == expected_nc {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: is_connected on connected graph
    print("Test 4: is_connected true... ")
    var adj4: [[usize]] = [[], [], []]
    adj4[0].push(1)
    adj4[1].push(0)
    adj4[1].push(2)
    adj4[2].push(1)
    if is_connected(&adj4) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: is_connected on disconnected graph
    print("Test 5: is_connected false... ")
    var adj5: [[usize]] = [[], [], []]
    adj5[0].push(1)
    adj5[1].push(0)
    // node 2 is isolated
    if !is_connected(&adj5) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
