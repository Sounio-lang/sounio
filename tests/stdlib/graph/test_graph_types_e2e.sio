//@ run-pass
//@ expect-stdout: GRAPH_TYPES_OK
// Exercises graph::types after the Seq migration. The adjacency used to be
// [[NodeId]] built with slice .push, which the compiler rejects (E019); it is
// now Seq<Seq<NodeId>>. Seq.get returns a handle sharing storage, so pushing
// into a row obtained from the outer Seq has to be visible through the graph --
// that is the property this test pins, not merely that the module type-checks.
use graph::types::*;

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var g = Graph::new(4)
    g.add_edge(0, 1)
    g.add_edge(0, 2)
    g.add_edge(0, 3)
    g.add_edge(1, 2)

    if g.num_nodes() != 4 { println("FAIL num_nodes"); return 1 }
    if g.num_edges() != 4 { println("FAIL num_edges"); return 1 }

    // Degrees read back through the outer Seq: this is the mutation-visibility
    // property. Node 0 has three neighbours, node 3 exactly one.
    if g.degree(0) != 3 { println("FAIL degree(0)"); return 1 }
    if g.degree(1) != 2 { println("FAIL degree(1)"); return 1 }
    if g.degree(3) != 1 { println("FAIL degree(3)"); return 1 }

    if !g.has_edge(0, 3) { println("FAIL has_edge(0,3)"); return 1 }
    if g.has_edge(2, 3) { println("FAIL has_edge(2,3) should be absent"); return 1 }

    // Undirected edges are stored on both endpoints and reported once.
    let es: Seq<Edge> = g.edges()
    let n_edges: i64 = es.len().unwrap("edges")
    if n_edges != 4 { println("FAIL edges count"); return 1 }

    let nb: Seq<NodeId> = g.neighbors(3)
    let n_nb: i64 = nb.len().unwrap("neighbors")
    if n_nb != 1 { println("FAIL neighbors(3)"); return 1 }
    if nb.get(0) != 0 { println("FAIL neighbors(3) content"); return 1 }

    println("GRAPH_TYPES_OK")
    0
}
