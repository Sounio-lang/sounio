//@ run-pass
// tests/stdlib/graph/test_algorithms.sio
//
// Tests for stdlib/graph/algorithms.sio:
//   WeightedGraph construction, Dijkstra (with GUM uncertainty), BFS hop-count,
//   PageRank, connected-components, Kruskal MST, topological sort, cycle detection.
//
// All 8 tests must PASS.

use graph::algorithms::*

// ---------------------------------------------------------------------------
// Tiny helpers (must precede main to avoid forward-ref issues)
// ---------------------------------------------------------------------------

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn print_pass(ok: bool) with IO, Mut {
    if ok { print(" PASS\n") } else { print(" FAIL\n") }
}

// ---------------------------------------------------------------------------
// Test 1 — Dijkstra: triangle A→B(1)→C(2), A→C(4) → shortest A→C = 3
// ---------------------------------------------------------------------------

fn test_dijkstra_triangle() -> bool with Mut, Div, Panic {
    // 3 nodes: 0=A, 1=B, 2=C
    var g = wgraph_new(3, 0)                         // undirected
    g = wgraph_add_edge(g, 0, 1, 1.0, 0.0)           // A-B weight=1
    g = wgraph_add_edge(g, 1, 2, 2.0, 0.0)           // B-C weight=2
    g = wgraph_add_edge(g, 0, 2, 4.0, 0.0)           // A-C weight=4 (direct)

    let r = dijkstra(&g, 0)

    // distance A→A = 0, A→B = 1, A→C = min(4, 1+2) = 3
    let d0_ok = abs_f64(r.distances[0] - 0.0) < 1e-9
    let d1_ok = abs_f64(r.distances[1] - 1.0) < 1e-9
    let d2_ok = abs_f64(r.distances[2] - 3.0) < 1e-9
    let r0_ok = r.reachable[0] == 1
    let r1_ok = r.reachable[1] == 1
    let r2_ok = r.reachable[2] == 1

    d0_ok && d1_ok && d2_ok && r0_ok && r1_ok && r2_ok
}

// ---------------------------------------------------------------------------
// Test 2 — Dijkstra uncertainty: GUM quadrature u(d(v))=sqrt(u(d(u))²+u(w)²)
// ---------------------------------------------------------------------------

fn test_dijkstra_uncertainty() -> bool with Mut, Div, Panic {
    // 3 nodes, directed chain 0→1→2
    // edge 0→1: weight=1.0, unc=0.1
    // edge 1→2: weight=2.0, unc=0.2
    // expected: d(2)=3.0, u(2)=sqrt(0.1^2+0.2^2)=sqrt(0.05)≈0.2236
    var g = wgraph_new(3, 1)                           // directed
    g = wgraph_add_edge(g, 0, 1, 1.0, 0.1)
    g = wgraph_add_edge(g, 1, 2, 2.0, 0.2)

    let r = dijkstra(&g, 0)

    let d2_ok  = abs_f64(r.distances[2] - 3.0) < 1e-9
    // u(d(1)) = sqrt(0 + 0.1^2) = 0.1
    let u1_ok  = abs_f64(r.dist_unc[1] - 0.1) < 1e-6
    // u(d(2)) = sqrt(0.1^2 + 0.2^2) = sqrt(0.05) ≈ 0.22360679...
    let expected_u2: f64 = 0.22360679774997896
    let u2_ok  = abs_f64(r.dist_unc[2] - expected_u2) < 1e-6

    d2_ok && u1_ok && u2_ok
}

// ---------------------------------------------------------------------------
// Test 3 — BFS: 4-node chain 0-1-2-3 → hop distances [0,1,2,3]
// ---------------------------------------------------------------------------

fn test_bfs_chain() -> bool with Mut, Div, Panic {
    var g = wgraph_new(4, 0)
    g = wgraph_add_edge(g, 0, 1, 1.0, 0.0)
    g = wgraph_add_edge(g, 1, 2, 1.0, 0.0)
    g = wgraph_add_edge(g, 2, 3, 1.0, 0.0)

    let r = graph_bfs(&g, 0)

    let d0 = abs_f64(r.distances[0] - 0.0) < 1e-9
    let d1 = abs_f64(r.distances[1] - 1.0) < 1e-9
    let d2 = abs_f64(r.distances[2] - 2.0) < 1e-9
    let d3 = abs_f64(r.distances[3] - 3.0) < 1e-9

    d0 && d1 && d2 && d3
}

// ---------------------------------------------------------------------------
// Test 4 — PageRank: star graph hub(0)→3 leaves → hub has highest rank
// ---------------------------------------------------------------------------

fn test_pagerank_star() -> bool with Mut, Div, Panic {
    // 4 nodes: 0=hub, 1/2/3=leaves. Directed: leaves point to hub.
    var g = wgraph_new(4, 1)
    g = wgraph_add_edge(g, 1, 0, 1.0, 0.0)
    g = wgraph_add_edge(g, 2, 0, 1.0, 0.0)
    g = wgraph_add_edge(g, 3, 0, 1.0, 0.0)

    let r = pagerank(&g, 0.85, 20, 1e-6)

    // Hub (0) should accumulate rank from all 3 leaves
    let hub_best = r.scores[0] > r.scores[1] &&
                   r.scores[0] > r.scores[2] &&
                   r.scores[0] > r.scores[3]
    hub_best
}

// ---------------------------------------------------------------------------
// Test 5 — Connected components: 2 disconnected pairs → count = 2
// ---------------------------------------------------------------------------

fn test_connected_components() -> bool with Mut, Div, Panic {
    // 4 nodes: edges 0-1 and 2-3, no cross edges
    var g = wgraph_new(4, 0)
    g = wgraph_add_edge(g, 0, 1, 1.0, 0.0)
    g = wgraph_add_edge(g, 2, 3, 1.0, 0.0)

    let nc = graph_dfs_connected(&g)
    nc == 2
}

// ---------------------------------------------------------------------------
// Test 6 — Kruskal MST: 4-node complete graph → MST weight = 3 cheapest edges
//
// Nodes 0,1,2,3. Weights: 0-1=1, 0-2=4, 0-3=3, 1-2=2, 1-3=5, 2-3=6.
// Cheapest 3: 0-1=1, 1-2=2, 0-3=3 → MST total = 6
// ---------------------------------------------------------------------------

fn test_kruskal_mst() -> bool with Mut, Div, Panic {
    var g = wgraph_new(4, 0)
    g = wgraph_add_edge(g, 0, 1, 1.0, 0.0)
    g = wgraph_add_edge(g, 0, 2, 4.0, 0.0)
    g = wgraph_add_edge(g, 0, 3, 3.0, 0.0)
    g = wgraph_add_edge(g, 1, 2, 2.0, 0.0)
    g = wgraph_add_edge(g, 1, 3, 5.0, 0.0)
    g = wgraph_add_edge(g, 2, 3, 6.0, 0.0)

    let mst = kruskal_mst(&g)

    // Sum all MST edge weights (upper triangle only for undirected)
    var total: f64 = 0.0
    var i: i32 = 0
    while i < 4 {
        var j: i32 = i + 1
        while j < 4 {
            total = total + mst.weights[(i * 32 + j) as usize]
            j = j + 1
        }
        i = i + 1
    }

    // MST weight = 1 + 2 + 3 = 6
    abs_f64(total - 6.0) < 1e-9
}

// ---------------------------------------------------------------------------
// Test 7 — Topo sort: DAG 0→1→2 → order = [0,1,2]
// ---------------------------------------------------------------------------

fn test_topo_sort_dag() -> bool with Mut, Div, Panic {
    var g = wgraph_new(3, 1)
    g = wgraph_add_edge(g, 0, 1, 1.0, 0.0)
    g = wgraph_add_edge(g, 1, 2, 1.0, 0.0)

    let r = topo_sort(&g)

    r.count == 3 && r.order[0] == 0 && r.order[1] == 1 && r.order[2] == 2
}

// ---------------------------------------------------------------------------
// Test 8 — Topo sort cycle detection: 0→1→0 → returns -1
// ---------------------------------------------------------------------------

fn test_topo_sort_cycle() -> bool with Mut, Div, Panic {
    var g = wgraph_new(2, 1)
    g = wgraph_add_edge(g, 0, 1, 1.0, 0.0)
    g = wgraph_add_edge(g, 1, 0, 1.0, 0.0)

    let r = topo_sort(&g)

    r.count == -1
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    print("=== graph::algorithms tests ===\n")

    var passed: i32 = 0
    var failed: i32 = 0

    let t1 = test_dijkstra_triangle()
    print("Test 1 [dijkstra triangle]:")
    print_pass(t1)
    if t1 { passed = passed + 1 } else { failed = failed + 1 }

    let t2 = test_dijkstra_uncertainty()
    print("Test 2 [dijkstra uncertainty]:")
    print_pass(t2)
    if t2 { passed = passed + 1 } else { failed = failed + 1 }

    let t3 = test_bfs_chain()
    print("Test 3 [bfs chain]:")
    print_pass(t3)
    if t3 { passed = passed + 1 } else { failed = failed + 1 }

    let t4 = test_pagerank_star()
    print("Test 4 [pagerank star]:")
    print_pass(t4)
    if t4 { passed = passed + 1 } else { failed = failed + 1 }

    let t5 = test_connected_components()
    print("Test 5 [connected components]:")
    print_pass(t5)
    if t5 { passed = passed + 1 } else { failed = failed + 1 }

    let t6 = test_kruskal_mst()
    print("Test 6 [kruskal mst]:")
    print_pass(t6)
    if t6 { passed = passed + 1 } else { failed = failed + 1 }

    let t7 = test_topo_sort_dag()
    print("Test 7 [topo sort dag]:")
    print_pass(t7)
    if t7 { passed = passed + 1 } else { failed = failed + 1 }

    let t8 = test_topo_sort_cycle()
    print("Test 8 [topo sort cycle]:")
    print_pass(t8)
    if t8 { passed = passed + 1 } else { failed = failed + 1 }

    print("---\n")
    print("Passed: ")
    print(passed)
    print("  Failed: ")
    print(failed)
    print("\n")

    if failed == 0 {
        print("ALL PASS\n")
        0
    } else {
        print("SOME FAIL\n")
        1
    }
}
