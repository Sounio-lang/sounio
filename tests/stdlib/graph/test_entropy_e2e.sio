//@ run-pass
//@ expect-stdout: GRAPH_ENTROPY_OK
// Exercises graph::entropy after the Seq migration. The adjacency parameters
// were &[[usize]] and the degree histogram was a slice built with .push; both
// are Seq now, taken by value because reading a Seq through a reference
// parameter is broken (BLK-20260904-seq-f64-element-scalar-kind).
//
// Asserts numbers with closed forms rather than "it type-checks". If the
// migration had corrupted the degree histogram, the star would not land on its
// analytic value.
//
// Note `entropy()` is structural entropy, not degree entropy -- for a regular
// graph it is log2(n), its maximum, not zero.
use graph::entropy::*;
use graph::random::*;

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    // Regular graphs: every degree identical, so the degree distribution is a
    // point mass and its entropy is exactly zero.
    let k4: Seq<Seq<usize>> = complete_graph(4)
    let h_k4: f64 = degree_entropy(k4).value
    if h_k4 > 0.001 || h_k4 < 0.0 - 0.001 {
        println("FAIL K4 degree entropy should be zero")
        return 1
    }

    let c5: Seq<Seq<usize>> = cycle_graph(5)
    let h_c5: f64 = degree_entropy(c5).value
    if h_c5 > 0.001 || h_c5 < 0.0 - 0.001 {
        println("FAIL cycle degree entropy should be zero")
        return 1
    }

    // Star on 5 nodes: degrees are one 4 and four 1s, so the distribution is
    // (1/5, 4/5) and its entropy is -0.2*log2(0.2) - 0.8*log2(0.8) = 0.721928.
    let st: Seq<Seq<usize>> = star_graph(5)
    let h_st: f64 = degree_entropy(st).value
    if h_st < 0.7209 || h_st > 0.7229 {
        println("FAIL star degree entropy off its closed form")
        return 1
    }

    // Structural entropy of a 4-node graph is log2(4) = 2 at its maximum.
    let s_k4: f64 = entropy(complete_graph(4))
    if s_k4 < 1.999 || s_k4 > 2.001 {
        println("FAIL K4 structural entropy should be log2(4)")
        return 1
    }

    // The uncertainty pair travels the same path and must agree.
    let pair = entropy_with_uncertainty(complete_graph(4))
    let val: f64 = pair.0
    let err: f64 = pair.1
    if val < 1.999 || val > 2.001 { println("FAIL pair value"); return 1 }
    if err < 0.0 { println("FAIL negative std_err"); return 1 }

    println("GRAPH_ENTROPY_OK")
    0
}
