// ============================================================================
// TESTS — AST (ObservationNode)
// ============================================================================

fn test_ast_obs_additive_variance() -> bool  with Mut{
    let obs = observation_additive(0, 1, 0);
    var params: [f64; 20] = [0.0; 20];
    params[0] = 2.0;  // sigma = 2.0
    let v = observation_variance(obs, 10.0, params);
    near(v, 4.0, 0.001)  // sigma^2 = 4
}

fn test_ast_obs_proportional_variance() -> bool  with Mut, Div{
    let obs = observation_proportional(0, 1, 0);
    var params: [f64; 20] = [0.0; 20];
    params[0] = 0.1;  // sigma = 0.1
    let v = observation_variance(obs, 50.0, params);
    near(v, 0.01 * 2500.0, 0.01)  // (0.1*50)^2 = 25
}

fn test_ast_obs_combined_variance() -> bool  with Mut, Div{
    let obs = observation_combined(0, 1, 0, 1);
    var params: [f64; 20] = [0.0; 20];
    params[0] = 1.0;   // add sigma
    params[1] = 0.1;   // prop sigma
    // pred = 10 => var = 1 + (0.1*10)^2 = 1 + 1 = 2
    let v = observation_variance(obs, 10.0, params);
    near(v, 2.0, 0.001)
}

// ============================================================================
// TESTS — AST (CovariateEffect)
// ============================================================================

fn test_ast_covariate_linear_at_ref() -> bool {
    let eff = covariate_linear(0, 0, 0, 70.0);
    // at reference value, no change
    let result = apply_covariate(10.0, eff, 70.0, 0.5);
    near(result, 10.0, 0.001)
}

fn test_ast_covariate_linear_away() -> bool {
    let eff = covariate_linear(0, 0, 0, 70.0);
    // cov=80, theta=0.5: 10 * (1 + 0.5 * (80-70)) = 10 * 6 = 60
    let result = apply_covariate(10.0, eff, 80.0, 0.5);
    near(result, 60.0, 0.01)
}

fn test_ast_covariate_power() -> bool {
    let eff = covariate_power(0, 0, 0, 70.0);
    // weight 80kg, ref 70kg, theta 0.75
    let result = apply_covariate(10.0, eff, 80.0, 0.75);
    // 10 * (80/70)^0.75 — should be between 10.5 and 12.0
    result > 10.5 && result < 12.0
}

// ============================================================================
// TESTS — ModelAST templates
// ============================================================================

fn test_ast_template_one_comp_iv() -> bool  with IO, Mut, Panic, Div{
    let model = template_one_comp_iv();
    if model.n_params < 3 { return false }
    if model.n_compartments < 1 { return false }
    if model.n_flows < 1 { return false }
    // Central compartment: comp_type = 0
    if model.compartments[0].comp_type != 0 { return false }
    // Elimination flow: to_comp = -1
    if model.flows[0].to_comp != -1 { return false }
    // Observation is proportional (error_type=1)
    if model.observation.error_type != 1 { return false }
    true
}

fn test_ast_template_one_comp_oral() -> bool  with IO, Mut, Panic, Div{
    let model = template_one_comp_oral();
    if model.n_params < 5 { return false }
    if model.n_compartments < 2 { return false }
    if model.n_flows < 2 { return false }
    // First compartment should be depot (comp_type=3)
    if model.compartments[0].comp_type != 3 { return false }
    // Second compartment should be central (comp_type=0)
    if model.compartments[1].comp_type != 0 { return false }
    true
}

fn test_ast_model_add_dose() -> bool  with Mut{
    var model = model_ast_new();
    let dose1 = dosing_iv_bolus(0.0, 100.0, 0);
    let dose2 = dosing_iv_bolus(24.0, 100.0, 0);
    model = model_add_dose(model, dose1);
    model = model_add_dose(model, dose2);
    if model.n_doses != 2 { return false }
    if !near(model.doses[1].time, 24.0, 0.001) { return false }
    true
}

// ============================================================================
// TESTS — integrate
// ============================================================================

fn test_integrate_trapezoidal_constant() -> bool with Mut, Div, Panic {
    // f(x) = 5.0 over [0,10], dt=1.0, n=11 => AUC = 50
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 11 {
        y[i] = 5.0
        i = i + 1
    }
    let result = integrate_trapezoidal(&y, 1.0, 11)
    integ_abs(result - 50.0) < 0.01
}

fn test_integrate_trapezoidal_linear() -> bool with Mut, Div, Panic {
    // f(x) = x over [0,10], dt=1.0, n=11 => AUC = 50
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 11 {
        y[i] = i as f64
        i = i + 1
    }
    let result = integrate_trapezoidal(&y, 1.0, 11)
    integ_abs(result - 50.0) < 0.01
}

fn test_integrate_trapezoidal_degenerate() -> bool with Mut, Div, Panic {
    // n < 2 => 0
    var y: [f64; 256] = [0.0; 256]
    y[0] = 99.0
    let result = integrate_trapezoidal(&y, 1.0, 1)
    integ_abs(result - 0.0) < 0.001
}

fn test_integrate_simpson_constant() -> bool with Mut, Div, Panic {
    // f(x) = 3.0 over [0,10], dt=1.0, n=11 => AUC = 30
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 11 {
        y[i] = 3.0
        i = i + 1
    }
    let result = integrate_simpson(&y, 1.0, 11)
    integ_abs(result - 30.0) < 0.01
}

fn test_integrate_simpson_quadratic() -> bool with Mut, Div, Panic {
    // f(x) = x^2 over [0,4], dt=0.5, n=9 => exact = 64/3 ≈ 21.333
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 9 {
        let x = i as f64 * 0.5
        y[i] = x * x
        i = i + 1
    }
    let result = integrate_simpson(&y, 0.5, 9)
    integ_abs(result - 21.333) < 0.1
}

fn test_integrate_nonuniform() -> bool with Mut, Div, Panic {
    // f(x) = 1 at t = 0, 1, 3, 6 with non-uniform spacing
    // AUC = (1+1)/2*1 + (1+1)/2*2 + (1+1)/2*3 = 0.5 + 2 + 3 = 5.5 (trapz since f=const=1)
    // Actually trapz of constant=1 over total 6h = 6
    var times: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    times[0] = 0.0; times[1] = 1.0; times[2] = 3.0; times[3] = 6.0
    y[0] = 1.0; y[1] = 1.0; y[2] = 1.0; y[3] = 1.0
    let result = integrate_trapezoidal_nonuniform(&times, &y, 4)
    integ_abs(result - 6.0) < 0.001
}

fn test_integrate_cumulative() -> bool with Mut, Div, Panic {
    // Verify cumulative trapezoidal by computing manually:
    // f = 2.0, dt = 1.0, 5 points: AUC from 0..4 should be 8.0
    // Use trapezoidal on full range as proxy (known-good path)
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 5 {
        y[i] = 2.0
        i = i + 1
    }
    // Trapezoidal over [0,4] dt=1 n=5 should give 8
    let total = integrate_trapezoidal(&y, 1.0, 5)
    integ_abs(total - 8.0) < 0.01
}

fn test_integrate_cumulative_midpoint() -> bool with Mut, Div, Panic {
    // Verify cumulative trapezoidal at midpoint by summing partial windows:
    // f = 4.0, dt = 0.5, 3 points: AUC from 0..1 should be 4.0
    var y: [f64; 256] = [0.0; 256]
    var i = 0
    while i < 3 {
        y[i] = 4.0
        i = i + 1
    }
    // Trapezoidal: (4+4)/2*0.5 + (4+4)/2*0.5 = 2 + 2 = 4
    let result = integrate_trapezoidal(&y, 0.5, 3)
    integ_abs(result - 4.0) < 0.01
}

// ============================================================================
// TESTS — parse_int_simple / parse_float_simple
// ============================================================================

fn test_parse_int_simple() -> bool  with IO, Mut, Panic, Div{
    var buf: [i8; 64] = [0; 64];
    // "1234"
    buf[0] = 49; buf[1] = 50; buf[2] = 51; buf[3] = 52;
    parse_int_simple(buf, 4) == 1234
}

fn test_parse_float_simple_integer_part() -> bool  with IO, Mut, Panic, Div{
    var buf: [i8; 64] = [0; 64];
    // "42.0"
    buf[0] = 52; buf[1] = 50; buf[2] = 46; buf[3] = 48;
    let v = parse_float_simple(buf, 4);
    near(v, 42.0, 0.001)
}

fn test_parse_float_simple_fraction() -> bool  with Mut, Div{
    var buf: [i8; 64] = [0; 64];
    // "0.25"
    buf[0] = 48; buf[1] = 46; buf[2] = 50; buf[3] = 53;
    let v = parse_float_simple(buf, 4);
    near(v, 0.25, 0.001)
}

// ============================================================================
// TESTS — is_digit / is_alpha / is_whitespace helpers
// ============================================================================

fn test_char_classification() -> bool {
    if !is_digit(48 as i8) { return false }   // '0'
    if !is_digit(57 as i8) { return false }   // '9'
    if is_digit(65 as i8) { return false }    // 'A'
    if !is_alpha(65 as i8) { return false }   // 'A'
    if !is_alpha(97 as i8) { return false }   // 'a'
    if !is_alpha(95 as i8) { return false }   // '_'
    if is_alpha(48 as i8) { return false }    // '0'
    if !is_whitespace(32 as i8) { return false } // space
    if !is_whitespace(9 as i8) { return false }  // tab
    if is_whitespace(65 as i8) { return false }  // 'A'
    true
}

// ============================================================================
// MAIN — run all tests, return 0 on all pass, 1 on any fail
// ============================================================================

fn main() -> i32 with Mut, Div, Panic {
    var fail = 0

    // Lexer tests
    if !test_lexer_model_keyword() { println("FAIL: lexer_model_keyword"); fail = fail + 1 } else { println("PASS: lexer_model_keyword") }
    if !test_lexer_integer() { println("FAIL: lexer_integer"); fail = fail + 1 } else { println("PASS: lexer_integer") }
    if !test_lexer_float() { println("FAIL: lexer_float"); fail = fail + 1 } else { println("PASS: lexer_float") }
    if !test_lexer_arrow_operator() { println("FAIL: lexer_arrow_operator"); fail = fail + 1 } else { println("PASS: lexer_arrow_operator") }
    if !test_lexer_dotdot_operator() { println("FAIL: lexer_dotdot_operator"); fail = fail + 1 } else { println("PASS: lexer_dotdot_operator") }
    if !test_lexer_tilde_operator() { println("FAIL: lexer_tilde_operator"); fail = fail + 1 } else { println("PASS: lexer_tilde_operator") }
    if !test_lexer_unit_mg() { println("FAIL: lexer_unit_mg"); fail = fail + 1 } else { println("PASS: lexer_unit_mg") }
    if !test_lexer_unit_L() { println("FAIL: lexer_unit_L"); fail = fail + 1 } else { println("PASS: lexer_unit_L") }
    if !test_lexer_keyword_param() { println("FAIL: lexer_keyword_param"); fail = fail + 1 } else { println("PASS: lexer_keyword_param") }
    if !test_lexer_keyword_compartment() { println("FAIL: lexer_keyword_compartment"); fail = fail + 1 } else { println("PASS: lexer_keyword_compartment") }
    if !test_lexer_comment_skip() { println("FAIL: lexer_comment_skip"); fail = fail + 1 } else { println("PASS: lexer_comment_skip") }
    if !test_lexer_per_h_unit() { println("FAIL: lexer_per_h_unit"); fail = fail + 1 } else { println("PASS: lexer_per_h_unit") }
    if !test_lexer_string_literal() { println("FAIL: lexer_string_literal"); fail = fail + 1 } else { println("PASS: lexer_string_literal") }

    // AST ParamNode tests
    if !test_ast_param_defaults() { println("FAIL: ast_param_defaults"); fail = fail + 1 } else { println("PASS: ast_param_defaults") }
    if !test_ast_param_fixed() { println("FAIL: ast_param_fixed"); fail = fail + 1 } else { println("PASS: ast_param_fixed") }
    if !test_ast_param_with_bounds() { println("FAIL: ast_param_with_bounds"); fail = fail + 1 } else { println("PASS: ast_param_with_bounds") }
    if !test_ast_param_normal_prior() { println("FAIL: ast_param_normal_prior"); fail = fail + 1 } else { println("PASS: ast_param_normal_prior") }
    if !test_ast_param_lognormal_prior() { println("FAIL: ast_param_lognormal_prior"); fail = fail + 1 } else { println("PASS: ast_param_lognormal_prior") }
    if !test_ast_param_uniform_prior() { println("FAIL: ast_param_uniform_prior"); fail = fail + 1 } else { println("PASS: ast_param_uniform_prior") }
    if !test_ast_log_prior_normal_at_mean() { println("FAIL: ast_log_prior_normal_at_mean"); fail = fail + 1 } else { println("PASS: ast_log_prior_normal_at_mean") }
    if !test_ast_log_prior_normal_one_sigma() { println("FAIL: ast_log_prior_normal_one_sigma"); fail = fail + 1 } else { println("PASS: ast_log_prior_normal_one_sigma") }
    if !test_ast_log_prior_below_bound() { println("FAIL: ast_log_prior_below_bound"); fail = fail + 1 } else { println("PASS: ast_log_prior_below_bound") }
    if !test_ast_log_prior_fixed_at_value() { println("FAIL: ast_log_prior_fixed_at_value"); fail = fail + 1 } else { println("PASS: ast_log_prior_fixed_at_value") }
    if !test_ast_log_prior_fixed_off_value() { println("FAIL: ast_log_prior_fixed_off_value"); fail = fail + 1 } else { println("PASS: ast_log_prior_fixed_off_value") }

    // AST CompartmentNode tests
    if !test_ast_compartment_central() { println("FAIL: ast_compartment_central"); fail = fail + 1 } else { println("PASS: ast_compartment_central") }
    if !test_ast_compartment_peripheral() { println("FAIL: ast_compartment_peripheral"); fail = fail + 1 } else { println("PASS: ast_compartment_peripheral") }
    if !test_ast_compartment_depot() { println("FAIL: ast_compartment_depot"); fail = fail + 1 } else { println("PASS: ast_compartment_depot") }
    if !test_ast_compartment_effect() { println("FAIL: ast_compartment_effect"); fail = fail + 1 } else { println("PASS: ast_compartment_effect") }

    // AST FlowNode tests
    if !test_ast_flow_elimination() { println("FAIL: ast_flow_elimination"); fail = fail + 1 } else { println("PASS: ast_flow_elimination") }
    if !test_ast_flow_distribution() { println("FAIL: ast_flow_distribution"); fail = fail + 1 } else { println("PASS: ast_flow_distribution") }
    if !test_ast_flow_absorption() { println("FAIL: ast_flow_absorption"); fail = fail + 1 } else { println("PASS: ast_flow_absorption") }
    if !test_ast_flow_saturable() { println("FAIL: ast_flow_saturable"); fail = fail + 1 } else { println("PASS: ast_flow_saturable") }

    // AST DosingNode tests
    if !test_ast_dosing_iv_bolus() { println("FAIL: ast_dosing_iv_bolus"); fail = fail + 1 } else { println("PASS: ast_dosing_iv_bolus") }
    if !test_ast_dosing_iv_infusion_rate() { println("FAIL: ast_dosing_iv_infusion_rate"); fail = fail + 1 } else { println("PASS: ast_dosing_iv_infusion_rate") }
    if !test_ast_dosing_oral() { println("FAIL: ast_dosing_oral"); fail = fail + 1 } else { println("PASS: ast_dosing_oral") }

    // AST ObservationNode tests
    if !test_ast_obs_additive_variance() { println("FAIL: ast_obs_additive_variance"); fail = fail + 1 } else { println("PASS: ast_obs_additive_variance") }
    if !test_ast_obs_proportional_variance() { println("FAIL: ast_obs_proportional_variance"); fail = fail + 1 } else { println("PASS: ast_obs_proportional_variance") }
    if !test_ast_obs_combined_variance() { println("FAIL: ast_obs_combined_variance"); fail = fail + 1 } else { println("PASS: ast_obs_combined_variance") }

    // AST CovariateEffect tests
    if !test_ast_covariate_linear_at_ref() { println("FAIL: ast_covariate_linear_at_ref"); fail = fail + 1 } else { println("PASS: ast_covariate_linear_at_ref") }
    if !test_ast_covariate_linear_away() { println("FAIL: ast_covariate_linear_away"); fail = fail + 1 } else { println("PASS: ast_covariate_linear_away") }
    if !test_ast_covariate_power() { println("FAIL: ast_covariate_power"); fail = fail + 1 } else { println("PASS: ast_covariate_power") }

    // AST ModelAST tests
    if !test_ast_template_one_comp_iv() { println("FAIL: ast_template_one_comp_iv"); fail = fail + 1 } else { println("PASS: ast_template_one_comp_iv") }
    if !test_ast_template_one_comp_oral() { println("FAIL: ast_template_one_comp_oral"); fail = fail + 1 } else { println("PASS: ast_template_one_comp_oral") }
    if !test_ast_model_add_dose() { println("FAIL: ast_model_add_dose"); fail = fail + 1 } else { println("PASS: ast_model_add_dose") }

    // Integrate tests
    if !test_integrate_trapezoidal_constant() { println("FAIL: integrate_trapezoidal_constant"); fail = fail + 1 } else { println("PASS: integrate_trapezoidal_constant") }
    if !test_integrate_trapezoidal_linear() { println("FAIL: integrate_trapezoidal_linear"); fail = fail + 1 } else { println("PASS: integrate_trapezoidal_linear") }
    if !test_integrate_trapezoidal_degenerate() { println("FAIL: integrate_trapezoidal_degenerate"); fail = fail + 1 } else { println("PASS: integrate_trapezoidal_degenerate") }
    if !test_integrate_simpson_constant() { println("FAIL: integrate_simpson_constant"); fail = fail + 1 } else { println("PASS: integrate_simpson_constant") }
    if !test_integrate_simpson_quadratic() { println("FAIL: integrate_simpson_quadratic"); fail = fail + 1 } else { println("PASS: integrate_simpson_quadratic") }
    if !test_integrate_nonuniform() { println("FAIL: integrate_nonuniform"); fail = fail + 1 } else { println("PASS: integrate_nonuniform") }
    if !test_integrate_cumulative() { println("FAIL: integrate_cumulative"); fail = fail + 1 } else { println("PASS: integrate_cumulative") }
    if !test_integrate_cumulative_midpoint() { println("FAIL: integrate_cumulative_midpoint"); fail = fail + 1 } else { println("PASS: integrate_cumulative_midpoint") }

    // Parser helper tests
    if !test_parse_int_simple() { println("FAIL: parse_int_simple"); fail = fail + 1 } else { println("PASS: parse_int_simple") }
    if !test_parse_float_simple_integer_part() { println("FAIL: parse_float_simple_integer_part"); fail = fail + 1 } else { println("PASS: parse_float_simple_integer_part") }
    if !test_parse_float_simple_fraction() { println("FAIL: parse_float_simple_fraction"); fail = fail + 1 } else { println("PASS: parse_float_simple_fraction") }

    // Character classification
    if !test_char_classification() { println("FAIL: char_classification"); fail = fail + 1 } else { println("PASS: char_classification") }

    if fail == 0 {
        println("ALL PASS")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}
