use genomics::io::count_tsv::{count_tsv_new,count_tsv_feed_slot,count_tsv_feed_into,count_tsv_finish_into,count_tsv_feed,count_tsv_finish,count_tsv_ack_row}
fn main()->i32 with IO,Mut,Div,Panic {
 var slot=count_tsv_feed_slot()
 var bytes:[i64;256]=[0;256]
 var state=count_tsv_new(1)
 bytes[0]=49;bytes[1]=10;bytes[2]=50
 let snapshot=count_tsv_feed(&!state,&bytes,3)
 assert(snapshot.status==0 && snapshot.consumed==2 && snapshot.position==2 && snapshot.row_ready)
 slot.status=99;slot.consumed=99;slot.row_ready=false;slot.finished=true;slot.position=99;slot.error_position=99
 let code_1:i64=count_tsv_feed_into(&!state,&bytes,3,&!slot)
 assert(code_1==0)
 assert(slot.status==0 && slot.consumed==0 && slot.row_ready && !slot.finished && slot.position==2 && slot.error_position==0)
 let code_2:i64=count_tsv_finish_into(&!state,&!slot)
 assert(code_2==0 && slot.row_ready && !slot.finished)
 assert(count_tsv_ack_row(&!state))
 bytes[0]=50
 let code_3:i64=count_tsv_feed_into(&!state,&bytes,1,&!slot)
 assert(code_3==0 && slot.consumed==1 && slot.position==3 && !slot.row_ready && !slot.finished)
 let code_4:i64=count_tsv_finish_into(&!state,&!slot)
 assert(code_4==0 && slot.row_ready && slot.finished && slot.consumed==0 && slot.position==3)
 assert(count_tsv_ack_row(&!state))
 let code_5:i64=count_tsv_finish_into(&!state,&!slot)
 assert(code_5==0 && !slot.row_ready && slot.finished)
 assert(snapshot.status==0 && snapshot.consumed==2 && snapshot.position==2 && snapshot.row_ready && !snapshot.finished)
 let finished_snapshot=count_tsv_finish(&!state)
 let code_6:i64=count_tsv_feed_into(&!state,&bytes,1,&!slot)
 assert(code_6==6)
 assert(slot.status==6 && slot.consumed==0 && !slot.row_ready && slot.finished && slot.position==3 && slot.error_position==3)
 assert(finished_snapshot.status==0 && finished_snapshot.finished && finished_snapshot.position==3)
 var bad=count_tsv_new(1);bytes[0]=45
 let code_7:i64=count_tsv_feed_into(&!bad,&bytes,1,&!slot)
 assert(code_7==3 && slot.status==3 && slot.consumed==0 && slot.position==0 && slot.error_position==0 && !slot.finished)
 var good=count_tsv_new(1);bytes[0]=55
 let code_8:i64=count_tsv_feed_into(&!good,&bytes,1,&!slot)
 assert(code_8==0 && slot.status==0 && slot.consumed==1 && !slot.row_ready && !slot.finished && slot.position==1 && slot.error_position==0)
 var length=count_tsv_new(1)
 let code_9:i64=count_tsv_feed_into(&!length,&bytes,257,&!slot)
 assert(code_9==2 && slot.consumed==0 && slot.position==0 && slot.error_position==0 && !slot.row_ready && !slot.finished)
 var cr=count_tsv_new(1);bytes[0]=49;bytes[1]=13
 let code_10:i64=count_tsv_feed_into(&!cr,&bytes,2,&!slot)
 assert(code_10==0 && !slot.row_ready && slot.position==2)
 let code_11:i64=count_tsv_finish_into(&!cr,&!slot)
 assert(code_11==3 && slot.consumed==0 && slot.error_position==2 && !slot.finished)
 var shape=count_tsv_new(1);shape.columns=1
 let code_12:i64=count_tsv_feed_into(&!shape,&bytes,0,&!slot)
 assert(code_12==6 && slot.position==0 && slot.consumed==0)
 var position=count_tsv_new(1);position.position=9223372036854775807
 let code_13:i64=count_tsv_feed_into(&!position,&bytes,1,&!slot)
 assert(code_13==7 && slot.position==9223372036854775807 && slot.error_position==9223372036854775807 && slot.consumed==0)
 println("TOKEN_SLOT_PASS")
 0
}
