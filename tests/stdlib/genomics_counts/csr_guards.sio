use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use genomics::count_csr::{count_csr_payload,count_csr_build,count_csr_status,count_csr_at,count_csr_close,count_csr_size_factors_into}
use genomics::dynamic_normalization::{dynamic_size_factors_slot,dynamic_size_factors_snapshot}
fn guard(kind:i64) with Alloc,Mut,Div,Panic,IO {
 var offsets=integer_buffer_new(3,24);var columns=integer_buffer_new(2,16);var values=integer_buffer_new(2,16)
 integer_buffer_set(&!offsets,0,0);integer_buffer_set(&!offsets,1,2);integer_buffer_set(&!offsets,2,2)
 integer_buffer_set(&!columns,0,0);integer_buffer_set(&!columns,1,1)
 integer_buffer_set(&!values,0,1);integer_buffer_set(&!values,1,2)
 var expected:i64=0;var policy:i64=0
 if kind==0 {integer_buffer_set(&!columns,1,0);expected=3}
 if kind==1 {integer_buffer_set(&!columns,1,0);integer_buffer_set(&!values,0,9223372036854775807);integer_buffer_set(&!values,1,1);policy=1;expected=4}
 if kind==2 {integer_buffer_set(&!values,1,-1);expected=2}
 if kind==3 {integer_buffer_set(&!columns,0,1);integer_buffer_set(&!columns,1,0);expected=2}
 if kind==4 {integer_buffer_set(&!columns,1,2);expected=2}
 if kind==5 {integer_buffer_set(&!offsets,1,3);expected=2}
 if kind==6 {integer_buffer_set(&!offsets,0,1);expected=2}
 if kind==7 {integer_buffer_set(&!values,0,9007199254740993)}
 if kind==8 {integer_buffer_set(&!values,0,0);integer_buffer_set(&!values,1,0)}
 let c=count_csr_build(2,2,2,offsets,columns,values,policy)
 let status:i64=count_csr_status(&c)
 assert(status==expected)
 if expected!=0 {assert(count_csr_at(&c,0,0)== -1)}
 var factors=numeric_buffer_new(2,16);var logs=numeric_buffer_new(2,16);var work=numeric_buffer_new(8,64);var anchors=integer_buffer_new(2,16)
 numeric_buffer_set(&!factors,0,7.0);numeric_buffer_set(&!factors,1,7.0);numeric_buffer_set(&!logs,0,8.0);numeric_buffer_set(&!logs,1,8.0)
 var slot=dynamic_size_factors_slot()
 let code=count_csr_size_factors_into(&c,0,&!factors,&!logs,&!work,&!anchors,&!slot)
 let fit=dynamic_size_factors_snapshot(&slot)
 let expected_norm=if kind<7 {1}else{if kind==7 {5}else{3}}
 assert(code==expected_norm && fit.status==expected_norm)
 assert(numeric_buffer_at(&factors,0)==7.0 && numeric_buffer_at(&factors,1)==7.0 && numeric_buffer_at(&logs,0)==8.0 && numeric_buffer_at(&logs,1)==8.0)
 println("CSR_GUARD {} {} {}",kind,status,code)
 count_csr_close(c);numeric_buffer_close(factors);numeric_buffer_close(logs);numeric_buffer_close(work);integer_buffer_close(anchors)
}
fn empty() with Alloc,Mut,Div,Panic {
 var rp=integer_buffer_new(1,8);var ci=integer_buffer_new(0,0);var vv=integer_buffer_new(0,0)
 integer_buffer_set(&!rp,0,0)
 let c=count_csr_build(0,512,0,rp,ci,vv,0)
 assert(count_csr_status(&c)==0)
 count_csr_close(c)
}
fn main() with Alloc,Mut,Div,Panic,IO {
 assert(count_csr_payload(-1,2,1).status==1)
 assert(count_csr_payload(9223372036854775807,2,0).status==1)
 assert(count_csr_payload(1,2,9223372036854775807).status==1)
 var i:i64=0;while i<9 {guard(i);i=i+1}
 empty()
 println("CSR_GUARDS_PASS")
}
