// Harness concatenates this common body with the frozen canonical parser.
// TOKEN_FEED is replaced with old snapshot or retained-slot scalar call.
fn main()->i32 with IO,Mut,Div,Panic {
 var state=count_tsv_new(1)
 TOKEN_SLOT_DECL
 var bytes:[i64;256]=[0;256]
 let n:i64=TOKEN_COUNT
 var i:i64=0;var total:i64=0
 while i<n {
  bytes[0]=49
  TOKEN_FEED
  bytes[0]=10
  TOKEN_FEED
  assert(state.ready && state.status==0 && state.row[0]==1)
  total=total+state.row[0]
  assert(count_tsv_ack_row(&!state));i=i+1
 }
 TOKEN_FINISH
 let rows:i64=state.rows;let position:i64=state.position;let code:i64=state.status
 let finished:i64=if state.finished {1}else{0}
 println("TOKEN_BENCH {} {} {} {} {} {}",n,rows,position,total,finished,code)
 println("TOKEN_BENCH_PASS")
 0
}
