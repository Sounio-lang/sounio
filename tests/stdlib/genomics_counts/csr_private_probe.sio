use collections::integer_buffer::{integer_buffer_new,integer_buffer_set}
use genomics::count_csr::{CountCSR,count_csr_build,count_csr_close}
fn peek(c:&CountCSR)->i64 {c.nnz}
fn main()->i32 with Alloc,Mut,Div,Panic,IO {
 var rp=integer_buffer_new(1,8);let ci=integer_buffer_new(0,0);let vv=integer_buffer_new(0,0)
 integer_buffer_set(&!rp,0,0)
 let c=count_csr_build(0,1,0,rp,ci,vv,0)
 let n:i64=peek(&c)
 println("FORBIDDEN_CSR_FIELD {}",n)
 count_csr_close(c);0
}
