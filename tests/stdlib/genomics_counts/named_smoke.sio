use collections::integer_buffer::{integer_buffer_new,integer_buffer_at,integer_buffer_close}
use genomics::io::named_count_tsv::{named_count_tsv_new,named_count_tsv_feed,named_count_tsv_ack,named_count_tsv_finish}
fn main() with Alloc,Mut,Div,Panic,IO {
 var state=named_count_tsv_new(2,64)
 var id=integer_buffer_new(64,512)
 var row=integer_buffer_new(2,16)
 let bytes:[i64;16]=[103,9,65,9,66,13,10,120,9,48,9,49,50,13,10,0]
 var chunk:[i64;256]=[0;256]
 var i:i64=0
 var headers:i64=0
 var rows:i64=0
 while i<15 {
  chunk[0]=bytes[i as usize]
  let result=named_count_tsv_feed(&!state,&chunk,1,&!id,&!row)
  assert(result.status==0 && result.consumed==1)
  if result.kind==1 {headers=headers+1;assert(result.id_len==1);assert(integer_buffer_at(&id,0)==65+result.index);assert(named_count_tsv_ack(&!state))}
  if result.kind==2 {rows=rows+1;assert(integer_buffer_at(&id,0)==120 && result.id_len==1);assert(integer_buffer_at(&row,0)==0 && integer_buffer_at(&row,1)==12);assert(named_count_tsv_ack(&!state))}
  i=i+1
 }
 let end=named_count_tsv_finish(&!state,&id,&!row)
 assert(end.status==0 && end.finished && headers==2 && rows==1 && end.position==15)
 integer_buffer_close(id);integer_buffer_close(row)
 println("NAMED_COUNT_SMOKE_PASS")
}
