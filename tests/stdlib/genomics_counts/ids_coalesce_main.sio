use collections::integer_buffer::{IntegerBuffer,integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use genomics::count_identities::{CountIdentities,count_identities_build,count_identities_unique,count_identities_close}
use genomics::count_csr::{CountCSR,count_csr_build,count_csr_status,count_csr_rows,count_csr_samples,count_csr_nnz,count_csr_at,count_csr_row_start,count_csr_close}
use genomics::count_identity_coalesce::{count_identity_coalesce_build,count_coalesced_status,count_coalesced_required_nnz,count_coalesced_required_known,count_coalesced_point_work,count_coalesced_take}
fn co_ids(mode:i64)->CountIdentities with Alloc,Mut,Div,Panic {
 let n=if mode==0 {5}else if mode==1 || mode==2 {2}else{0}
 var bytes=integer_buffer_new(n,n*8);var offsets=integer_buffer_new(n+1,(n+1)*8)
 var order=integer_buffer_new(n,n*8);var groups=integer_buffer_new(n,n*8)
 let names:[i64;5]=[98,97,98,97,99]
 var i:i64=0
 while i<n {integer_buffer_set(&!bytes,i,if mode==0 {names[i as usize]}else{120});integer_buffer_set(&!offsets,i,i);i=i+1}
 integer_buffer_set(&!offsets,n,n)
 count_identities_build(bytes,offsets,order,groups,1,10000)
}
fn co_source(mode:i64)->CountCSR with Alloc,Mut,Div,Panic {
 let n=if mode==0 {5}else if mode==1 || mode==2 {2}else{0}
 let samples=if mode==1 || mode==2 {1}else{4}
 let nnz=if mode==0 {8}else if mode==1 || mode==2 {2}else{0}
 var offsets=integer_buffer_new(n+1,(n+1)*8);var columns=integer_buffer_new(nnz,nnz*8);var values=integer_buffer_new(nnz,nnz*8)
 if mode==0 {
  let ro:[i64;6]=[0,2,3,6,8,8];let col:[i64;8]=[0,2,1,0,2,3,1,3];let val:[i64;8]=[2,3,5,7,1,4,6,8]
  var i:i64=0;while i<=n {integer_buffer_set(&!offsets,i,ro[i as usize]);i=i+1}
  i=0;while i<nnz {integer_buffer_set(&!columns,i,col[i as usize]);integer_buffer_set(&!values,i,val[i as usize]);i=i+1}
 } else if mode==1 || mode==2 {
  integer_buffer_set(&!offsets,0,0);integer_buffer_set(&!offsets,1,1);integer_buffer_set(&!offsets,2,2)
  integer_buffer_set(&!columns,0,0);integer_buffer_set(&!columns,1,0)
  integer_buffer_set(&!values,0,if mode==1 {9223372036854775807}else{9223372036854775806})
  let ignored:i64=integer_buffer_set(&!values,1,1)
 } else {let ignored:i64=integer_buffer_set(&!offsets,0,0)}
 count_csr_build(n,samples,nnz,offsets,columns,values,0)
}
fn co_case(mode:i64,capacity:i64,budget:i64,tag:i64,expect:i64) with Alloc,Mut,Div,Panic,IO {
 let ids=co_ids(mode);let source=co_source(mode)
 assert(count_csr_status(&source)==0)
 let groups=count_identities_unique(&ids);let samples=count_csr_samples(&source)
 var sums=integer_buffer_new(samples,samples*8)
 var offsets=integer_buffer_new(groups+1,(groups+1)*8)
 var columns=integer_buffer_new(capacity,capacity*8);var values=integer_buffer_new(capacity,capacity*8)
 var i:i64=0;while i<samples {integer_buffer_set(&!sums,i,1234);i=i+1}
 let grouped=count_identity_coalesce_build(&ids,&source,&!sums,offsets,columns,values,budget)
 let code:i64=count_coalesced_status(&grouped);let needed:i64=count_coalesced_required_nnz(&grouped)
 let known:bool=count_coalesced_required_known(&grouped);let work:i64=count_coalesced_point_work(&grouped)
 assert(code==expect)
 let known_flag:i64=if known {1}else{0}
 println("COALESCE {} {} {} {} {}",tag,code,needed,known_flag,work)
 let counts=count_coalesced_take(grouped)
 if code==0 {
  assert(count_csr_status(&counts)==0 && count_csr_rows(&counts)==groups)
  let nnz:i64=count_csr_nnz(&counts);println("COALESCE_SHAPE {} {} {} {}",tag,groups,samples,nnz)
  var row:i64=0
  while row<groups {
   let start:i64=count_csr_row_start(&counts,row);println("COALESCE_OFFSET {} {} {}",tag,row,start)
   var sample:i64=0
   while sample<samples {let value:i64=count_csr_at(&counts,row,sample);println("COALESCE_VALUE {} {} {} {}",tag,row,sample,value);sample=sample+1}
   row=row+1
  }
  let last:i64=count_csr_row_start(&counts,groups);println("COALESCE_OFFSET {} {} {}",tag,groups,last)
  if mode==0 {i=0;while i<samples {assert(integer_buffer_at(&sums,i)==0);i=i+1}}
 } else {assert(count_csr_status(&counts)!=0 && count_csr_at(&counts,0,0)==-1)}
 // Original inputs are borrowed and remain available after every result.
 assert(count_csr_status(&source)==0)
 if mode==0 {assert(count_csr_at(&source,0,0)==2 && count_csr_at(&source,2,0)==7 && count_csr_at(&source,4,0)==0)}
 count_csr_close(counts);integer_buffer_close(sums);count_identities_close(ids);count_csr_close(source)
}
fn main()->i32 with Alloc,Mut,Div,Panic,IO {
 co_case(0,5,74,0,0)
 co_case(0,4,10000,1,5)
 co_case(0,5,36,2,3)
 co_case(0,5,37,3,3)
 co_case(0,5,73,4,3)
 co_case(1,1,10000,5,4)
 co_case(2,1,12,6,0)
 co_case(3,0,0,7,0)
 println("COUNT_IDENTITY_COALESCE_PASS")
 0
}
