use collections::integer_buffer::{integer_buffer_new,integer_buffer_at,integer_buffer_close}
use genomics::io::named_count_tsv::{named_count_tsv_new,named_count_tsv_feed_slot,named_count_tsv_feed_into,named_count_tsv_finish_into,named_count_tsv_feed,named_count_tsv_ack}
fn main() with Alloc,Mut,Div,Panic,IO {
 var state=named_count_tsv_new(2,8)
 var id=integer_buffer_new(8,64);var row=integer_buffer_new(2,16)
 var result=named_count_tsv_feed_slot()
 assert(result.status==0 && result.consumed==0 && result.kind==0 && result.index==0 && result.id_len==0 && result.rows==0 && !result.header_complete && !result.finished && result.position==0 && result.error_position==0)
 var chunk:[i64;256]=[0;256]
 chunk[0]=103;chunk[1]=9;chunk[2]=65;chunk[3]=9
 let snapshot=named_count_tsv_feed(&!state,&chunk,4,&!id,&!row)
 assert(snapshot.status==0 && snapshot.consumed==4 && snapshot.kind==1 && snapshot.index==0 && snapshot.id_len==1 && snapshot.rows==0 && !snapshot.header_complete && !snapshot.finished && snapshot.position==4 && snapshot.error_position==0)
 result.status=99;result.consumed=99;result.kind=99;result.index=99;result.id_len=99;result.rows=99;result.header_complete=true;result.finished=true;result.position=99;result.error_position=99
 let paused=named_count_tsv_feed_into(&!state,&chunk,4,&!id,&!row,&!result)
 assert(paused==0 && result.status==0 && result.consumed==0 && result.kind==1 && result.index==0 && result.id_len==1 && result.rows==0 && !result.header_complete && !result.finished && result.position==4 && result.error_position==0)
 assert(named_count_tsv_ack(&!state))
 chunk[0]=66;chunk[1]=10
 let second=named_count_tsv_feed_into(&!state,&chunk,2,&!id,&!row,&!result)
 assert(second==0 && result.status==0 && result.consumed==2 && result.kind==1 && result.index==1 && result.id_len==1 && result.rows==0 && result.header_complete && !result.finished && result.position==6 && result.error_position==0)
 assert(named_count_tsv_ack(&!state))
 chunk[0]=120;chunk[1]=9;chunk[2]=49;chunk[3]=9;chunk[4]=50
 let body=named_count_tsv_feed_into(&!state,&chunk,5,&!id,&!row,&!result)
 assert(body==0 && result.kind==0 && result.consumed==5 && result.position==11)
 let finish=named_count_tsv_finish_into(&!state,&id,&!row,&!result)
 assert(finish==0 && result.status==0 && result.consumed==0 && result.kind==2 && result.index==0 && result.id_len==1 && result.rows==1 && result.header_complete && result.finished && result.position==11 && result.error_position==0)
 assert(integer_buffer_at(&row,0)==1 && integer_buffer_at(&row,1)==2)
 assert(snapshot.kind==1 && snapshot.index==0 && snapshot.consumed==4 && snapshot.position==4 && !snapshot.finished && !snapshot.header_complete)
 assert(named_count_tsv_ack(&!state))
 let end=named_count_tsv_finish_into(&!state,&id,&!row,&!result)
 assert(end==0 && result.kind==0 && result.id_len==0 && result.consumed==0 && result.rows==1 && result.finished && result.position==11)
 chunk[0]=65
 let refused=named_count_tsv_feed_into(&!state,&chunk,1,&!id,&!row,&!result)
 assert(refused==6 && result.status==6 && result.consumed==0 && result.kind==0 && result.error_position==11 && result.position==11 && result.finished)
 let sticky=named_count_tsv_finish_into(&!state,&id,&!row,&!result)
 assert(sticky==6 && result.status==6 && result.consumed==0 && result.error_position==11)
 integer_buffer_close(id);integer_buffer_close(row)
 println("NAMED_SLOT_PASS")
}
