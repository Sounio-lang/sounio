//@ run-pass
//@ requires: madaros
use viz::colormap::{viridis_approx_u32,plasma_approx_u32,inferno_approx_u32,magma_approx_u32}
fn main() with IO,Mut,Div,Panic {
 var p:i64=1
 while p<=4 {
  var i:i64=0
  while i<256 {
   let t=((i as f64)+0.5)/256.0
   let rgb:i64=(if p==1 {viridis_approx_u32(t)}else if p==2 {plasma_approx_u32(t)}else if p==3 {inferno_approx_u32(t)}else{magma_approx_u32(t)}) as i64
   print("PALETTE_LEGACY ");print(p);print(" ");print(i);print(" ");println(rgb)
   i=i+1
  }
  p=p+1
 }
 println("PALETTE_LEGACY_ROWS_COMPLETE")
 println("PALETTE_APPROX_PASS")
}
