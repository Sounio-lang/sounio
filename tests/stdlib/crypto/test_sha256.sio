//@ run-pass
//@ known-failure: Requires implementation
//! tests/stdlib/crypto/test_sha256.sio
//!
//! NIST FIPS 180-4 test vectors for SHA-256 and RFC 2104 HMAC-SHA256.
//!
//! Test vectors:
//!   T1: SHA-256("") = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
//!   T2: SHA-256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//!   T3: HMAC-SHA256(key="key", msg="The quick brown fox...") — RFC 2104 example

use crypto::sha256::{
    SHA256State, SHA256Digest,
    sha256_init, sha256_update, sha256_finalize, sha256_hash,
    hmac_sha256,
}

// ============================================================================
// HELPERS
// ============================================================================

// Build a [u8; 256] from a Sounio string literal stored as explicit bytes.
// Returns count of bytes filled.
fn make_buf_empty() -> [u8; 256] {
    let b: [u8; 256] = [0; 256]
    return b
}

// "abc" = 0x61, 0x62, 0x63
fn make_buf_abc() -> [u8; 256] {
    var b: [u8; 256] = [0; 256]
    b[0] = 0x61 as u8
    b[1] = 0x62 as u8
    b[2] = 0x63 as u8
    return b
}

// "The quick brown fox jumps over the lazy dog" (43 bytes)
fn make_buf_fox() -> [u8; 256] {
    var b: [u8; 256] = [0; 256]
    b[ 0] = 0x54 as u8   // T
    b[ 1] = 0x68 as u8   // h
    b[ 2] = 0x65 as u8   // e
    b[ 3] = 0x20 as u8   //
    b[ 4] = 0x71 as u8   // q
    b[ 5] = 0x75 as u8   // u
    b[ 6] = 0x69 as u8   // i
    b[ 7] = 0x63 as u8   // c
    b[ 8] = 0x6b as u8   // k
    b[ 9] = 0x20 as u8   //
    b[10] = 0x62 as u8   // b
    b[11] = 0x72 as u8   // r
    b[12] = 0x6f as u8   // o
    b[13] = 0x77 as u8   // w
    b[14] = 0x6e as u8   // n
    b[15] = 0x20 as u8   //
    b[16] = 0x66 as u8   // f
    b[17] = 0x6f as u8   // o
    b[18] = 0x78 as u8   // x
    b[19] = 0x20 as u8   //
    b[20] = 0x6a as u8   // j
    b[21] = 0x75 as u8   // u
    b[22] = 0x6d as u8   // m
    b[23] = 0x70 as u8   // p
    b[24] = 0x73 as u8   // s
    b[25] = 0x20 as u8   //
    b[26] = 0x6f as u8   // o
    b[27] = 0x76 as u8   // v
    b[28] = 0x65 as u8   // e
    b[29] = 0x72 as u8   // r
    b[30] = 0x20 as u8   //
    b[31] = 0x74 as u8   // t
    b[32] = 0x68 as u8   // h
    b[33] = 0x65 as u8   // e
    b[34] = 0x20 as u8   //
    b[35] = 0x6c as u8   // l
    b[36] = 0x61 as u8   // a
    b[37] = 0x7a as u8   // z
    b[38] = 0x79 as u8   // y
    b[39] = 0x20 as u8   //
    b[40] = 0x64 as u8   // d
    b[41] = 0x6f as u8   // o
    b[42] = 0x67 as u8   // g
    return b
}

// "key" = 0x6b, 0x65, 0x79
fn make_key_key() -> [u8; 256] {
    var b: [u8; 256] = [0; 256]
    b[0] = 0x6b as u8   // k
    b[1] = 0x65 as u8   // e
    b[2] = 0x79 as u8   // y
    return b
}

// ============================================================================
// T1: SHA-256("") — NIST FIPS 180-4 example
// Expected: e3b0c442 98fc1c14 9afbf4c8 996fb924 27ae41e4 649b934c a495991b 7852b855
// ============================================================================

fn test_sha256_empty() -> bool with Mut, Panic, Div {
    let data = make_buf_empty()
    let d = sha256_hash(data, 0)

    // Check first 8 bytes of the digest.
    if d.bytes[0] != (0xe3 as u8) { return false }
    if d.bytes[1] != (0xb0 as u8) { return false }
    if d.bytes[2] != (0xc4 as u8) { return false }
    if d.bytes[3] != (0x42 as u8) { return false }
    if d.bytes[4] != (0x98 as u8) { return false }
    if d.bytes[5] != (0xfc as u8) { return false }
    if d.bytes[6] != (0x1c as u8) { return false }
    if d.bytes[7] != (0x14 as u8) { return false }

    // Check last 8 bytes.
    if d.bytes[24] != (0xa4 as u8) { return false }
    if d.bytes[25] != (0x95 as u8) { return false }
    if d.bytes[26] != (0x99 as u8) { return false }
    if d.bytes[27] != (0x1b as u8) { return false }
    if d.bytes[28] != (0x78 as u8) { return false }
    if d.bytes[29] != (0x52 as u8) { return false }
    if d.bytes[30] != (0xb8 as u8) { return false }
    if d.bytes[31] != (0x55 as u8) { return false }

    return true
}

// ============================================================================
// T2: SHA-256("abc") — NIST FIPS 180-4 example
// Expected: ba7816bf 8f01cfea 414140de 5dae2223 b00361a3 96177a9c b410ff61 f20015ad
// ============================================================================

fn test_sha256_abc() -> bool with Mut, Panic, Div {
    let data = make_buf_abc()
    let d = sha256_hash(data, 3)

    if d.bytes[0] != (0xba as u8) { return false }
    if d.bytes[1] != (0x78 as u8) { return false }
    if d.bytes[2] != (0x16 as u8) { return false }
    if d.bytes[3] != (0xbf as u8) { return false }
    if d.bytes[4] != (0x8f as u8) { return false }
    if d.bytes[5] != (0x01 as u8) { return false }
    if d.bytes[6] != (0xcf as u8) { return false }
    if d.bytes[7] != (0xea as u8) { return false }

    if d.bytes[ 8] != (0x41 as u8) { return false }
    if d.bytes[ 9] != (0x41 as u8) { return false }
    if d.bytes[10] != (0x40 as u8) { return false }
    if d.bytes[11] != (0xde as u8) { return false }
    if d.bytes[12] != (0x5d as u8) { return false }
    if d.bytes[13] != (0xae as u8) { return false }
    if d.bytes[14] != (0x22 as u8) { return false }
    if d.bytes[15] != (0x23 as u8) { return false }

    if d.bytes[24] != (0xb4 as u8) { return false }
    if d.bytes[25] != (0x10 as u8) { return false }
    if d.bytes[26] != (0xff as u8) { return false }
    if d.bytes[27] != (0x61 as u8) { return false }
    if d.bytes[28] != (0xf2 as u8) { return false }
    if d.bytes[29] != (0x00 as u8) { return false }
    if d.bytes[30] != (0x15 as u8) { return false }
    if d.bytes[31] != (0xad as u8) { return false }

    return true
}

// ============================================================================
// T3: Streaming SHA-256("abc") using update/finalize
// Same expected digest as T2, but verifying the streaming API.
// ============================================================================

fn test_sha256_streaming() -> bool with Mut, Panic, Div {
    var s = sha256_init()
    let data = make_buf_abc()
    s = sha256_update(s, data, 3)
    let d = sha256_finalize(s)

    if d.bytes[0] != (0xba as u8) { return false }
    if d.bytes[1] != (0x78 as u8) { return false }
    if d.bytes[2] != (0x16 as u8) { return false }
    if d.bytes[3] != (0xbf as u8) { return false }
    if d.bytes[31] != (0xad as u8) { return false }
    return true
}

// ============================================================================
// T4: HMAC-SHA256(key="key", msg="The quick brown fox jumps over the lazy dog")
// Expected: f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8
// (RFC 2104 / Wikipedia test vector)
// ============================================================================

fn test_hmac_sha256_fox() -> bool with Mut, Panic, Div {
    let key = make_key_key()
    let msg = make_buf_fox()
    let d = hmac_sha256(key, 3, msg, 43)

    if d.bytes[0] != (0xf7 as u8) { return false }
    if d.bytes[1] != (0xbc as u8) { return false }
    if d.bytes[2] != (0x83 as u8) { return false }
    if d.bytes[3] != (0xf4 as u8) { return false }
    if d.bytes[4] != (0x30 as u8) { return false }
    if d.bytes[5] != (0x53 as u8) { return false }
    if d.bytes[6] != (0x84 as u8) { return false }
    if d.bytes[7] != (0x24 as u8) { return false }

    if d.bytes[ 8] != (0xb1 as u8) { return false }
    if d.bytes[ 9] != (0x32 as u8) { return false }
    if d.bytes[10] != (0x98 as u8) { return false }
    if d.bytes[11] != (0xe6 as u8) { return false }
    if d.bytes[12] != (0xaa as u8) { return false }
    if d.bytes[13] != (0x6f as u8) { return false }
    if d.bytes[14] != (0xb1 as u8) { return false }
    if d.bytes[15] != (0x43 as u8) { return false }

    if d.bytes[28] != (0x2d as u8) { return false }
    if d.bytes[29] != (0x1a as u8) { return false }
    if d.bytes[30] != (0x3c as u8) { return false }
    if d.bytes[31] != (0xd8 as u8) { return false }

    return true
}

// ============================================================================
// RUNNER
// ============================================================================

fn main() with Mut, Panic, Div, IO {
    var passed: i32 = 0
    var failed: i32 = 0

    if test_sha256_empty() {
        print("T1 PASS: SHA-256(\"\") correct\n")
        passed = passed + 1
    } else {
        print("T1 FAIL: SHA-256(\"\") mismatch\n")
        failed = failed + 1
    }

    if test_sha256_abc() {
        print("T2 PASS: SHA-256(\"abc\") correct\n")
        passed = passed + 1
    } else {
        print("T2 FAIL: SHA-256(\"abc\") mismatch\n")
        failed = failed + 1
    }

    if test_sha256_streaming() {
        print("T3 PASS: streaming SHA-256(\"abc\") correct\n")
        passed = passed + 1
    } else {
        print("T3 FAIL: streaming SHA-256(\"abc\") mismatch\n")
        failed = failed + 1
    }

    if test_hmac_sha256_fox() {
        print("T4 PASS: HMAC-SHA256(key,fox) correct\n")
        passed = passed + 1
    } else {
        print("T4 FAIL: HMAC-SHA256(key,fox) mismatch\n")
        failed = failed + 1
    }

    print("Results: ")
    print(passed)
    print(" passed, ")
    print(failed)
    print(" failed\n")

    assert(failed == 0)
}
