//@ run-pass
// Tests for stdlib/darwin/atlas.sio — evolutionary/genomics atlas kernels.
//
// Coverage:
//   T1.  complement_base: A<->T, C<->G via XOR-3
//   T2.  sequence_complement: all-A becomes all-T
//   T3.  sequence_reverse: reversal correctness
//   T4.  sequence_reverse_complement: palindrome check
//   T5.  sequences_equal: same/different sequences
//   T6.  hamming_distance: known distance
//   T7.  cyclic_period: period-1 vs period-4 sequences
//   T8.  rotational_symmetries: uniform sequence has n symmetries
//   T9.  has_reflective_symmetry: palindrome is reflective
//   T10. orbit_size: orbit of uniform sequence
//   T11. orbit_ratio: in [0,1]
//   T12. is_palindrome: palindrome and non-palindrome
//   T13. is_rc_fixed: RC-fixed point check
//   T14. compute_symmetry_stats: struct fields populated correctly
//   T15. run_atlas_metrics: pipeline_ok guard passes
//   T16. dmin: perfect repeat has dmin=0
//   T17. dmin_normalized: in [0,1]
//   T18. sin_approx / cos_approx: sin(0)≈0, cos(0)≈1
//   T19. quaternion_mul: identity law q*identity=q
//   T20. verify_double_cover: Dic_2 double cover holds

// =============================================================================
// INLINE SOURCE (atlas.sio inlined — no module/use system for stdlib files)
// =============================================================================

let BASE_A: u8 = 0
let BASE_C: u8 = 1
let BASE_G: u8 = 2
let BASE_T: u8 = 3

let PI: f64 = 3.14159265358979323846

fn abs_f64(x: f64) -> f64 with Mut, Div, Panic {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn normalize_angle(x: f64) -> f64 with Mut, Div, Panic {
    var angle = x
    while angle > PI { angle = angle - 2.0 * PI }
    while angle < 0.0 - PI { angle = angle + 2.0 * PI }
    return angle
}

fn sin_approx(x: f64) -> f64 with Mut, Div, Panic {
    let angle = normalize_angle(x)
    let x2 = angle * angle
    let x3 = angle * x2
    let x5 = x3 * x2
    let x7 = x5 * x2
    return angle - x3 / 6.0 + x5 / 120.0 - x7 / 5040.0
}

fn cos_approx(x: f64) -> f64 with Mut, Div, Panic {
    let angle = normalize_angle(x)
    let x2 = angle * angle
    let x4 = x2 * x2
    let x6 = x4 * x2
    return 1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0
}

fn atan(x: f64) -> f64 with Mut, Div, Panic {
    let ax = abs_f64(x)
    if ax <= 1.0 {
        let x2 = x * x
        return x * (1.0 - x2 * (1.0 / 3.0 - x2 * (1.0 / 5.0 - x2 * (1.0 / 7.0))))
    }
    let sign = if x > 0.0 { 1.0 } else { 0.0 - 1.0 }
    let inv = 1.0 / x
    let inv2 = inv * inv
    return sign * (PI / 2.0 - inv * (1.0 - inv2 * (1.0 / 3.0 - inv2 * (1.0 / 5.0))))
}

fn atan2(y: f64, x: f64) -> f64 with Mut, Div, Panic {
    if x > 0.0 { return atan(y / x) }
    if x < 0.0 && y >= 0.0 { return atan(y / x) + PI }
    if x < 0.0 && y < 0.0 { return atan(y / x) - PI }
    if x == 0.0 && y > 0.0 { return PI / 2.0 }
    if x == 0.0 && y < 0.0 { return 0.0 - PI / 2.0 }
    return 0.0
}

fn sequence_shift(seq: [u8], k: usize) -> [u8] with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return [] }
    let k_mod = k % n
    var result: [u8] = []
    var i: usize = 0
    while i < n {
        let idx = (i + k_mod) % n
        result.push(seq[idx])
        i = i + 1
    }
    return result
}

fn sequence_reverse(seq: [u8]) -> [u8] with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return [] }
    var result: [u8] = []
    var i: usize = 0
    while i < n {
        result.push(seq[n - 1 - i])
        i = i + 1
    }
    return result
}

fn complement_base(b: u8) -> u8 with Mut, Div, Panic {
    return b ^ 3
}

fn sequence_complement(seq: [u8]) -> [u8] with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return [] }
    var result: [u8] = []
    var i: usize = 0
    while i < n {
        result.push(complement_base(seq[i]))
        i = i + 1
    }
    return result
}

fn sequence_reverse_complement(seq: [u8]) -> [u8] with Mut, Div, Panic {
    let rev = sequence_reverse(seq)
    return sequence_complement(rev)
}

fn sequences_equal(a: [u8], b: [u8]) -> bool with Mut, Div, Panic {
    let len_a = a.len()
    let len_b = b.len()
    if len_a != len_b { return false }
    var i: usize = 0
    while i < len_a {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

fn hamming_distance(a: [u8], b: [u8]) -> usize with Mut, Div, Panic {
    let len_a = a.len()
    let len_b = b.len()
    if len_a != len_b { return 0 }
    var count: usize = 0
    var i: usize = 0
    while i < len_a {
        if a[i] != b[i] { count = count + 1 }
        i = i + 1
    }
    return count
}

fn cyclic_period(seq: [u8]) -> usize with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return 1 }
    var k: usize = 1
    while k <= n {
        if n % k == 0 {
            let shifted = sequence_shift(seq, k)
            if sequences_equal(seq, shifted) { return k }
        }
        k = k + 1
    }
    return n
}

fn rotational_symmetries(seq: [u8]) -> usize with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return 1 }
    return n / cyclic_period(seq)
}

fn has_reflective_symmetry(seq: [u8]) -> bool with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return true }
    let rev = sequence_reverse(seq)
    var k: usize = 0
    while k < n {
        let shifted_rev = sequence_shift(rev, k)
        if sequences_equal(seq, shifted_rev) { return true }
        k = k + 1
    }
    return false
}

fn orbit_size(seq: [u8]) -> usize with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return 1 }
    let group_order = 2 * n
    let rot_sym = rotational_symmetries(seq)
    let ref_factor: usize = if has_reflective_symmetry(seq) { 2 } else { 1 }
    let stabilizer_size = rot_sym * ref_factor
    return group_order / stabilizer_size
}

fn orbit_ratio(seq: [u8]) -> f64 with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return 1.0 }
    return (orbit_size(seq) as f64) / ((2 * n) as f64)
}

fn is_palindrome(seq: [u8]) -> bool with Mut, Div, Panic {
    let rev = sequence_reverse(seq)
    return sequences_equal(seq, rev)
}

fn is_rc_fixed(seq: [u8]) -> bool with Mut, Div, Panic {
    let rc = sequence_reverse_complement(seq)
    return sequences_equal(seq, rc)
}

fn rotational_period(seq: [u8]) -> usize with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return 1 }
    var k: usize = 1
    while k <= n {
        if n % k == 0 {
            let shifted = sequence_shift(seq, k)
            if sequences_equal(seq, shifted) { return k }
        }
        k = k + 1
    }
    return n
}

struct SymmetryStats {
    length: usize,
    orbit_size: usize,
    orbit_ratio: f64,
    is_palindrome: bool,
    is_rc_fixed: bool,
    rotational_period: usize,
}

fn compute_symmetry_stats(seq: [u8]) -> SymmetryStats with Mut, Div, Panic {
    SymmetryStats {
        length: seq.len(),
        orbit_size: orbit_size(seq),
        orbit_ratio: orbit_ratio(seq),
        is_palindrome: is_palindrome(seq),
        is_rc_fixed: is_rc_fixed(seq),
        rotational_period: rotational_period(seq),
    }
}

fn dmin(seq: [u8], include_rc: bool) -> usize with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return 0 }
    var min_dist = n
    var k: usize = 1
    while k < n {
        let shifted = sequence_shift(seq, k)
        let d = hamming_distance(seq, shifted)
        if d < min_dist { min_dist = d }
        k = k + 1
    }
    let rev = sequence_reverse(seq)
    k = 0
    while k < n {
        let shifted_rev = sequence_shift(rev, k)
        let d = hamming_distance(seq, shifted_rev)
        if d < min_dist { min_dist = d }
        k = k + 1
    }
    if include_rc {
        let rc = sequence_reverse_complement(seq)
        k = 0
        while k < n {
            let shifted_rc = sequence_shift(rc, k)
            let d = hamming_distance(seq, shifted_rc)
            if d < min_dist { min_dist = d }
            k = k + 1
        }
    }
    return min_dist
}

fn dmin_normalized(seq: [u8], include_rc: bool) -> f64 with Mut, Div, Panic {
    let n = seq.len()
    if n == 0 { return 0.0 }
    return (dmin(seq, include_rc) as f64) / (n as f64)
}

struct Quaternion {
    w: f64,
    x: f64,
    y: f64,
    z: f64,
}

fn quaternion_new(w: f64, x: f64, y: f64, z: f64) -> Quaternion with Mut, Div, Panic {
    Quaternion { w: w, x: x, y: y, z: z }
}

fn quaternion_identity() -> Quaternion with Mut, Div, Panic {
    quaternion_new(1.0, 0.0, 0.0, 0.0)
}

fn quaternion_neg(q: &Quaternion) -> Quaternion with Mut, Div, Panic {
    quaternion_new(0.0 - q.w, 0.0 - q.x, 0.0 - q.y, 0.0 - q.z)
}

fn quaternion_mul(a: &Quaternion, b: &Quaternion) -> Quaternion with Mut, Div, Panic {
    quaternion_new(
        a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
        a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
        a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
        a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
    )
}

fn quaternion_approx_eq(a: &Quaternion, b: &Quaternion, tol: f64) -> bool with Mut, Div, Panic {
    abs_f64(a.w - b.w) < tol
        && abs_f64(a.x - b.x) < tol
        && abs_f64(a.y - b.y) < tol
        && abs_f64(a.z - b.z) < tol
}

struct DicyclicGroup {
    n: usize,
}

fn dicyclic_group_new(n: usize) -> DicyclicGroup with Mut, Div, Panic {
    DicyclicGroup { n: n }
}

fn dicyclic_order(g: &DicyclicGroup) -> usize with Mut, Div, Panic {
    return 4 * g.n
}

struct DicyclicElement {
    q: Quaternion,
}

fn dicyclic_element(g: &DicyclicGroup, k: usize, is_reflection: bool) -> DicyclicElement with Mut, Div, Panic {
    let n = g.n
    let theta = PI * (k as f64) / (n as f64)
    let a_k = quaternion_new(cos_approx(theta), sin_approx(theta), 0.0, 0.0)
    if is_reflection {
        let b = quaternion_new(0.0, 0.0, 1.0, 0.0)
        return DicyclicElement { q: quaternion_mul(&a_k, &b) }
    }
    return DicyclicElement { q: a_k }
}

fn project_to_dihedral(elem: &DicyclicElement, g: &DicyclicGroup) -> (usize, bool) with Mut, Div, Panic {
    let q = &elem.q
    let n = g.n
    let is_reflection = abs_f64(q.y) > 0.0000000001 || abs_f64(q.z) > 0.0000000001
    let angle = atan2(q.x, q.w)
    let k_float = angle * (n as f64) / PI
    let k_raw: i64 = if k_float >= 0.0 { (k_float + 0.5) as i64 } else { (k_float - 0.5) as i64 }
    let n_i64 = n as i64
    let k_mod = ((k_raw % n_i64) + n_i64) % n_i64
    let k = k_mod as usize
    return (k, is_reflection)
}

fn verify_double_cover(g: &DicyclicGroup) -> bool with Mut, Div, Panic {
    let n = g.n
    var k: usize = 0
    while k < 2 * n {
        var is_ref_idx: usize = 0
        while is_ref_idx < 2 {
            let is_ref = is_ref_idx == 1
            let elem = dicyclic_element(g, k, is_ref)
            let neg_elem = DicyclicElement { q: quaternion_neg(&elem.q) }
            let proj1 = project_to_dihedral(&elem, g)
            let proj2 = project_to_dihedral(&neg_elem, g)
            if proj1.0 != proj2.0 || proj1.1 != proj2.1 { return false }
            is_ref_idx = is_ref_idx + 1
        }
        k = k + 1
    }
    return true
}

struct AtlasMetrics {
    length: usize,
    orbit_size: usize,
    orbit_ratio: f64,
    dmin: usize,
    dmin_normalized: f64,
    is_palindrome: bool,
    is_rc_fixed: bool,
    rotational_period: usize,
    double_cover_ok: bool,
}

fn run_atlas_metrics(seq: [u8], include_rc: bool, dicyclic_n: usize) -> AtlasMetrics with Mut, Div, Panic {
    let stats = compute_symmetry_stats(seq)
    let dmin_value = dmin(seq, include_rc)
    let dmin_norm = if stats.length == 0 { 0.0 } else { (dmin_value as f64) / (stats.length as f64) }
    let g = dicyclic_group_new(dicyclic_n)
    let double_cover_ok = verify_double_cover(&g)
    AtlasMetrics {
        length: stats.length,
        orbit_size: stats.orbit_size,
        orbit_ratio: stats.orbit_ratio,
        dmin: dmin_value,
        dmin_normalized: dmin_norm,
        is_palindrome: stats.is_palindrome,
        is_rc_fixed: stats.is_rc_fixed,
        rotational_period: stats.rotational_period,
        double_cover_ok: double_cover_ok,
    }
}

fn pipeline_ok(metrics: AtlasMetrics) -> bool with Mut, Div, Panic {
    if metrics.length == 0 { return false }
    if metrics.orbit_size < 1 { return false }
    if metrics.orbit_ratio < 0.0 || metrics.orbit_ratio > 1.0 { return false }
    if metrics.dmin > metrics.length { return false }
    if metrics.dmin_normalized < 0.0 || metrics.dmin_normalized > 1.0 { return false }
    if !metrics.double_cover_ok { return false }
    return true
}

fn sample_sequence() -> [u8] with Mut, Div, Panic {
    [BASE_A, BASE_C, BASE_G, BASE_T, BASE_A, BASE_C, BASE_G, BASE_T]
}

// =============================================================================
// HELPER
// =============================================================================

fn near_f64(a: f64, b: f64, tol: f64) -> bool with Mut, Div, Panic {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

// =============================================================================
// TESTS
// =============================================================================

fn main() -> i32 with Mut, Div, Panic {
    var fail = 0

    // T1. complement_base: A(0)^3=3=T, C(1)^3=2=G, G(2)^3=1=C, T(3)^3=0=A
    if complement_base(BASE_A) != BASE_T { fail = fail + 1 }
    if complement_base(BASE_T) != BASE_A { fail = fail + 1 }
    if complement_base(BASE_C) != BASE_G { fail = fail + 1 }
    if complement_base(BASE_G) != BASE_C { fail = fail + 1 }

    // T2. sequence_complement: [A,A,A] -> [T,T,T]
    let all_a: [u8] = [BASE_A, BASE_A, BASE_A]
    let comp_a = sequence_complement(all_a)
    if comp_a[0] != BASE_T { fail = fail + 1 }
    if comp_a[1] != BASE_T { fail = fail + 1 }
    if comp_a[2] != BASE_T { fail = fail + 1 }

    // T3. sequence_reverse: [A,C,G,T] -> [T,G,C,A]
    let acgt: [u8] = [BASE_A, BASE_C, BASE_G, BASE_T]
    let rev_acgt = sequence_reverse(acgt)
    if rev_acgt[0] != BASE_T { fail = fail + 1 }
    if rev_acgt[1] != BASE_G { fail = fail + 1 }
    if rev_acgt[2] != BASE_C { fail = fail + 1 }
    if rev_acgt[3] != BASE_A { fail = fail + 1 }

    // T4. sequence_reverse_complement: RC([A,T,G,C]) should equal [G,C,A,T]
    // RC = reverse then complement
    // reverse([A,T,G,C]) = [C,G,T,A], complement = [G,C,A,T]
    let atgc: [u8] = [BASE_A, BASE_T, BASE_G, BASE_C]
    let rc = sequence_reverse_complement(atgc)
    if rc[0] != BASE_G { fail = fail + 1 }
    if rc[1] != BASE_C { fail = fail + 1 }
    if rc[2] != BASE_A { fail = fail + 1 }
    if rc[3] != BASE_T { fail = fail + 1 }

    // T5. sequences_equal: same and different
    let s1: [u8] = [BASE_A, BASE_C]
    let s2: [u8] = [BASE_A, BASE_C]
    let s3: [u8] = [BASE_A, BASE_G]
    if !sequences_equal(s1, s2) { fail = fail + 1 }
    if sequences_equal(s1, s3) { fail = fail + 1 }

    // T6. hamming_distance: [A,C,G,T] vs [A,G,G,T] = 1
    let ha: [u8] = [BASE_A, BASE_C, BASE_G, BASE_T]
    let hb: [u8] = [BASE_A, BASE_G, BASE_G, BASE_T]
    if hamming_distance(ha, hb) != 1 { fail = fail + 1 }
    // Same sequence -> distance 0
    if hamming_distance(ha, ha) != 0 { fail = fail + 1 }

    // T7. cyclic_period: uniform [A,A,A,A] has period 1
    let uniform: [u8] = [BASE_A, BASE_A, BASE_A, BASE_A]
    if cyclic_period(uniform) != 1 { fail = fail + 1 }
    // ACGT repeated: period 4 (no smaller period divides cleanly with equal shift)
    let acgt4: [u8] = [BASE_A, BASE_C, BASE_G, BASE_T]
    let p4 = cyclic_period(acgt4)
    if p4 < 1 { fail = fail + 1 }  // Must be at least 1

    // T8. rotational_symmetries: uniform [A,A,A,A] has 4 rotational symmetries
    if rotational_symmetries(uniform) != 4 { fail = fail + 1 }

    // T9. has_reflective_symmetry: palindrome [A,C,C,A] is reflective
    let palindrome: [u8] = [BASE_A, BASE_C, BASE_C, BASE_A]
    if !has_reflective_symmetry(palindrome) { fail = fail + 1 }
    // [A,C,G,T] is NOT a palindrome
    if is_palindrome(acgt) { fail = fail + 1 }

    // T10. orbit_size: uniform sequence orbit_size >= 1
    let os = orbit_size(uniform)
    if os < 1 { fail = fail + 1 }

    // T11. orbit_ratio: must be in [0,1]
    let or_val = orbit_ratio(acgt4)
    if or_val < 0.0 || or_val > 1.0 { fail = fail + 1 }

    // T12. is_palindrome: [A,C,C,A] is palindrome, [A,C,G,T] is not
    if !is_palindrome(palindrome) { fail = fail + 1 }
    if is_palindrome(acgt) { fail = fail + 1 }

    // T13. is_rc_fixed: [A,C,G,T] RC is [A,C,G,T] — check ACGT self-RC property
    // RC([A,C,G,T]) = comp(rev([A,C,G,T])) = comp([T,G,C,A]) = [A,C,G,T]
    // A(0)^3=3=T, T(3)^3=0=A, G(2)^3=1=C, C(1)^3=2=G
    // comp([T,G,C,A]) = [A,C,G,T] — YES, ACGT is RC-fixed!
    if !is_rc_fixed(acgt) { fail = fail + 1 }

    // T14. compute_symmetry_stats: fields match independent calls
    let seq8 = sample_sequence()
    let stats = compute_symmetry_stats(seq8)
    if stats.length != seq8.len() { fail = fail + 1 }
    if stats.orbit_size != orbit_size(seq8) { fail = fail + 1 }
    if !near_f64(stats.orbit_ratio, orbit_ratio(seq8), 0.000001) { fail = fail + 1 }
    if stats.is_palindrome != is_palindrome(seq8) { fail = fail + 1 }
    if stats.is_rc_fixed != is_rc_fixed(seq8) { fail = fail + 1 }
    if stats.rotational_period != rotational_period(seq8) { fail = fail + 1 }

    // T15. run_atlas_metrics + pipeline_ok: sample sequence passes pipeline guard
    let metrics = run_atlas_metrics(seq8, true, 4)
    if !pipeline_ok(metrics) { fail = fail + 1 }

    // T16. dmin: perfect repeat [A,C,A,C] shifted by 2 should give hamming 0
    let repeat_ac: [u8] = [BASE_A, BASE_C, BASE_A, BASE_C]
    let d_repeat = dmin(repeat_ac, false)
    if d_repeat != 0 { fail = fail + 1 }

    // T17. dmin_normalized: must be in [0.0, 1.0]
    let dn = dmin_normalized(acgt4, false)
    if dn < 0.0 || dn > 1.0 { fail = fail + 1 }

    // T18. sin_approx(0)≈0, cos_approx(0)≈1
    if !near_f64(sin_approx(0.0), 0.0, 0.000001) { fail = fail + 1 }
    if !near_f64(cos_approx(0.0), 1.0, 0.000001) { fail = fail + 1 }
    // sin(PI/2) ≈ 1 (7-term Taylor is accurate near 0, less so at PI/2 — use 0.003 tol)
    if !near_f64(sin_approx(PI / 2.0), 1.0, 0.003) { fail = fail + 1 }
    // cos(PI/3) = 0.5 — stays in the accurate range of the polynomial
    if !near_f64(cos_approx(PI / 3.0), 0.5, 0.003) { fail = fail + 1 }

    // T19. quaternion_mul: q * identity = q
    let q = quaternion_new(0.5, 0.5, 0.5, 0.5)
    let id = quaternion_identity()
    let q_id = quaternion_mul(&q, &id)
    if !quaternion_approx_eq(&q, &q_id, 0.000001) { fail = fail + 1 }
    // identity * q = q
    let id_q = quaternion_mul(&id, &q)
    if !quaternion_approx_eq(&q, &id_q, 0.000001) { fail = fail + 1 }
    // dicyclic_order(Dic_2) = 8
    let g2 = dicyclic_group_new(2)
    if dicyclic_order(&g2) != 8 { fail = fail + 1 }

    // T20. verify_double_cover: Dic_2 and Dic_4 satisfy double cover property
    if !verify_double_cover(&g2) { fail = fail + 1 }
    let g4 = dicyclic_group_new(4)
    if !verify_double_cover(&g4) { fail = fail + 1 }

    return fail
}
