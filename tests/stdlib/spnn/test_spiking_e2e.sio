//@ run-pass
//@ expect-stdout: HYPER_SPNN_OK

use spnn::mod::*

fn emit_metric(name: string, value: f64) with IO {
    print("HYPER_METRIC spnn ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO {
    print("HYPER_SPNN_START\n")

    let n0 = spiking_neuron_new(1.0, 0.5)
    let n1 = spiking_step(n0, 0.6)
    let n2 = spiking_step(n1, 0.8)

    let fired_first = spiking_fired(n1)
    let fired_second = spiking_fired(n2)
    let membrane_reset = spiking_membrane(n2) < 0.000001

    emit_metric("fired_first", bool_to_f64(fired_first))
    emit_metric("fired_second", bool_to_f64(fired_second))
    emit_metric("membrane_reset", bool_to_f64(membrane_reset))

    if fired_first { return 2 }
    if !fired_second { return 3 }
    if !membrane_reset { return 4 }

    print("HYPER_SPNN_OK\n")
    0
}
