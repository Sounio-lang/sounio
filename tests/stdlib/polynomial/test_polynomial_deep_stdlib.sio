// Deepened run-proof for stdlib polynomial::lib. Imports the library.
// Horner eval of (x-1)(x-2), derivative of x^2, quadratic roots of x^2-2.
// lean_single. A passing sentinel is these inputs, not a module validation.
use polynomial::lib::*

fn ae(a: f64, b: f64) -> f64 {
    if a > b { a - b } else { b - a }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // (x-1)(x-2) = x^2 - 3x + 2
    let p = poly_quadratic(1.0, 0.0 - 3.0, 2.0)
    if ae(poly_eval(p, 0.0), 2.0) >= 1.0e-12 { print("FAIL eval0\n"); return 1 }
    if ae(poly_eval(p, 1.5), 0.0 - 0.25) >= 1.0e-12 { print("FAIL eval15\n"); return 2 }
    if poly_degree(p) != 2 { print("FAIL degree\n"); return 3 }

    // d/dx x^2 = 2x
    let q = poly_monomial(1.0, 2)
    let dq = poly_derivative(q)
    if poly_degree(dq) != 1 { print("FAIL deriv_degree\n"); return 4 }
    if ae(poly_coeff(dq, 0), 0.0) >= 1.0e-12 { print("FAIL deriv_c0\n"); return 5 }
    if ae(poly_coeff(dq, 1), 2.0) >= 1.0e-12 { print("FAIL deriv_c1\n"); return 6 }
    if ae(poly_eval(dq, 3.0), 6.0) >= 1.0e-12 { print("FAIL deriv_eval\n"); return 7 }

    // x^2 - 2 = 0. r1 is the +sqrt branch, r2 the -sqrt branch.
    let roots = poly_roots_quadratic(1.0, 0.0, 0.0 - 2.0)
    if !roots.has_real_roots { print("FAIL quad_flag\n"); return 8 }
    if ae(roots.discriminant, 8.0) >= 1.0e-12 { print("FAIL quad_disc\n"); return 9 }
    if ae(roots.r1, 1.41421356237) >= 1.0e-9 { print("FAIL quad_r1\n"); return 10 }
    if ae(roots.r2, 0.0 - 1.41421356237) >= 1.0e-9 { print("FAIL quad_r2\n"); return 11 }

    // Claims formerly checked only by the inlined copy.
    let sum = poly_add(poly_quadratic(1.0, 0.0, 1.0), poly_linear(2.0, 3.0))
    if poly_degree(sum) != 2 { print("FAIL add_deg\n"); return 12 }
    if ae(poly_coeff(sum, 0), 4.0) >= 1.0e-12 { print("FAIL add_c0\n"); return 13 }
    if ae(poly_coeff(sum, 1), 2.0) >= 1.0e-12 { print("FAIL add_c1\n"); return 14 }
    if ae(poly_coeff(sum, 2), 1.0) >= 1.0e-12 { print("FAIL add_c2\n"); return 15 }

    let prod = poly_mul(poly_linear(1.0, 1.0), poly_linear(1.0, 0.0 - 1.0))
    if poly_degree(prod) != 2 { print("FAIL mul_deg\n"); return 16 }
    if ae(poly_coeff(prod, 0), 0.0 - 1.0) >= 1.0e-12 { print("FAIL mul_c0\n"); return 17 }
    if ae(poly_coeff(prod, 1), 0.0) >= 1.0e-12 { print("FAIL mul_c1\n"); return 18 }
    if ae(poly_coeff(prod, 2), 1.0) >= 1.0e-12 { print("FAIL mul_c2\n"); return 19 }

    let diff = poly_sub(poly_linear(2.0, 3.0), poly_linear(1.0, 1.0))
    if ae(poly_eval(diff, 4.0), 6.0) >= 1.0e-12 { print("FAIL sub\n"); return 20 }
    let neg = poly_neg(poly_linear(2.0, 3.0))
    if ae(poly_eval(neg, 4.0), 0.0 - 11.0) >= 1.0e-12 { print("FAIL neg\n"); return 21 }
    let scaled = poly_scale(poly_linear(2.0, 1.0), 3.0)
    if ae(poly_eval(scaled, 2.0), 15.0) >= 1.0e-12 { print("FAIL scale\n"); return 22 }

    let cube = poly_monomial(1.0, 3)
    let dcube = poly_derivative(cube)
    if poly_degree(dcube) != 2 { print("FAIL cube_deg\n"); return 23 }
    if ae(poly_eval(dcube, 2.0), 12.0) >= 1.0e-12 { print("FAIL cube_deriv\n"); return 24 }
    let integ = poly_integral(poly_linear(2.0, 0.0), 0.0)
    if ae(poly_eval(integ, 3.0), 9.0) >= 1.0e-12 { print("FAIL integral\n"); return 25 }
    let round = poly_derivative(poly_integral(poly_quadratic(3.0, 0.0 - 2.0, 5.0), 0.0))
    if ae(poly_eval(round, 1.0), poly_eval(poly_quadratic(3.0, 0.0 - 2.0, 5.0), 1.0)) >= 1.0e-9 {
        print("FAIL roundtrip\n"); return 26
    }

    let none = poly_roots_quadratic(1.0, 0.0, 1.0)
    if none.has_real_roots { print("FAIL no_real\n"); return 27 }
    if none.discriminant >= 0.0 { print("FAIL no_real_disc\n"); return 28 }
    let repeated = poly_roots_quadratic(1.0, 0.0 - 2.0, 1.0)
    if ae(repeated.r1, 1.0) >= 1.0e-12 || ae(repeated.r2, 1.0) >= 1.0e-12 { print("FAIL repeated\n"); return 29 }

    var froots: [f64; 32] = [0.0; 32]
    froots[0] = 1.0; froots[1] = 2.0; froots[2] = 3.0
    let built = poly_from_roots(froots, 3)
    if ae(poly_eval(built, 0.0), 0.0 - 6.0) >= 1.0e-8 { print("FAIL from_roots0\n"); return 30 }
    if ae(poly_eval(built, 2.0), 0.0) >= 1.0e-8 { print("FAIL from_roots2\n"); return 31 }

    let quad = poly_quadratic(1.0, 0.0 - 5.0, 6.0)
    let deflated = poly_deflate(quad, 2.0)
    if poly_degree(deflated) != 1 { print("FAIL deflate_deg\n"); return 32 }
    if ae(poly_coeff(deflated, 0), 0.0 - 3.0) >= 1.0e-8 { print("FAIL deflate_c0\n"); return 33 }
    if ae(poly_coeff(deflated, 1), 1.0) >= 1.0e-8 { print("FAIL deflate_c1\n"); return 34 }

    let found = poly_find_real_roots(quad)
    if found.count != 2 { print("FAIL find_count\n"); return 35 }
    var saw2 = 0
    var saw3 = 0
    var ri = 0
    while ri < found.count {
        if ae(found.roots[ri], 2.0) < 1.0e-5 { saw2 = 1 }
        if ae(found.roots[ri], 3.0) < 1.0e-5 { saw3 = 1 }
        ri = ri + 1
    }
    if saw2 == 0 || saw3 == 0 { print("FAIL find_roots\n"); return 36 }

    print("POLY_DEEP_STDLIB_OK\n")
    return 0
}
