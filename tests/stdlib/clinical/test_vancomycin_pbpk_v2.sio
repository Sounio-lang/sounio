//@ run-pass
//@ expect-stdout: VANCO V2 PASS

// M3 — Stdlib clinical test for vancomycin PBPK Knightian.
// Mirrors tests/run-pass/vancomycin_propagation_v2.sio but lives
// under tests/stdlib/ for the stdlib gate.

use clinical::vancomycin_pbpk::*
use epistemic::knightian::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let pre = predict_cmin_knightian(78.5, 65.0, 1000.0, 12.0, 0)
    let post = predict_cmin_knightian(78.5, 65.0, 1000.0, 12.0, 3)
    let bad = predict_cmin_knightian(15.0, 65.0, 1000.0, 12.0, 0)

    let safe_pre = is_safe_dose(&pre, 10.0, 20.0, 800)
    let safe_post = is_safe_dose(&post, 10.0, 20.0, 800)
    let bad_blocked = pb_confidence(&bad) == 0

    // Knightian width monotonicity: pre-TDM gap > post-TDM gap
    let monotone = pb_gap(&pre) > pb_gap(&post)

    if !safe_pre && safe_post && bad_blocked && monotone {
        println("VANCO V2 PASS")
    } else {
        println("VANCO V2 FAIL")
    }
    0
}
