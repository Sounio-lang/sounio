//@ run-pass
// Vancomycin AUC/MIC TDM decision E2E (lean_single; self-contained).
//
// Structural claim: GUM → AUC24/MIC → Knightian p-box decision
//   0 = Recommend, 1 = Adjust, 2 = Refuse
// ASHP/SIDP/IDSA 2020 target band 400–600 h at MIC=1 mg/L.
//
// Fixed cases (same formulas as stdlib/darwin_pbpk/pd/vancomycin_auc_gum.sio):
//   Standard: CrCl=90, wt=70, dose=15*70, MIC=1 → decision ∈ {0,1}, u_ratio>50, mic_frac>0.30
//   Renal:    CrCl=20, wt=70, dose=15*70, MIC=1 → Refuse (2)
//
// Engine: lean_single
// Gate:   bash scripts/clinical_vanco_tdm_e2e_gate.sh
//
// claims_not_made: bedside dosing product, NONMEM FOCE, Madaros multi-module,
//                  MIMIC/real TDM calibration

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_nr(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn fail(code: i32) -> i32 with IO {
    print("FAIL code ")
    print(code)
    print("\n")
    return code
}

struct VancoGUM {
    ratio: f64,
    u_ratio: f64,
    u_cl: f64,
    u_crcl: f64,
    u_vc: f64,
    u_vp: f64,
    u_fu: f64,
    u_mic: f64,
    u_num: f64,
}

// Mirror of vg_gum (stdlib/darwin_pbpk/pd/vancomycin_auc_gum.sio)
fn vg_gum(crcl: f64, weight: f64, dose_mg: f64, mic: f64) -> VancoGUM with Mut, Div, Panic {
    let cl_lh = (0.689 * crcl + 3.66) * 0.06
    let vc_l = 0.40 * weight
    let vp_l = 0.30 * weight
    let auc24 = 2.0 * dose_mg / cl_lh
    let ratio = auc24 / mic

    let sigma_cl = 0.25 * cl_lh
    let sigma_crcl = 0.15 * crcl
    let sigma_vc = 0.25 * vc_l
    let sigma_vp = 0.25 * vp_l
    let sigma_mic = 0.30 * mic
    let sigma_num = 0.02 * auc24

    let dq_dcl = 0.0 - 2.0 * dose_mg / (cl_lh * cl_lh * mic)
    let dcl_dccl = 0.04134
    let dq_dcrcl = dq_dcl * dcl_dccl
    let dq_dmic = 0.0 - auc24 / (mic * mic)
    let dq_dvc = 0.05 * ratio / vc_l
    let dq_dvp = 0.05 * ratio / vp_l

    let u_cl = abs_f64(dq_dcl) * sigma_cl
    let u_crcl = abs_f64(dq_dcrcl) * sigma_crcl
    let u_vc = abs_f64(dq_dvc) * sigma_vc
    let u_vp = abs_f64(dq_dvp) * sigma_vp
    let u_fu = 0.0
    let u_mic = abs_f64(dq_dmic) * sigma_mic
    let u_num = sigma_num / mic

    let sq = u_cl * u_cl + u_crcl * u_crcl + u_vc * u_vc + u_vp * u_vp
        + u_fu * u_fu + u_mic * u_mic + u_num * u_num
    let u_tot = sqrt_nr(sq)

    return VancoGUM {
        ratio: ratio,
        u_ratio: u_tot,
        u_cl: u_cl,
        u_crcl: u_crcl,
        u_vc: u_vc,
        u_vp: u_vp,
        u_fu: u_fu,
        u_mic: u_mic,
        u_num: u_num,
    }
}

// 0=Recommend, 1=Adjust, 2=Refuse
fn vg_knightian(crcl: f64, weight: f64, dose_mg: f64, mic: f64) -> i32 with Mut, Div, Panic {
    let cl_lh = (0.689 * crcl + 3.66) * 0.06
    let sigma_cl = 0.25 * cl_lh
    let cl_hi = cl_lh + sigma_cl
    let cl_lo = cl_lh - sigma_cl
    if cl_lo <= 0.0 { return 2 }
    let auc_lo = 2.0 * dose_mg / cl_hi / mic
    let auc_hi = 2.0 * dose_mg / cl_lo / mic
    if auc_lo > 600.0 { return 2 }
    if auc_hi > 600.0 { return 1 }
    return 0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let wt = 70.0
    let dose = 15.0 * wt
    let mic = 1.0

    // --- Standard patient CrCl=90 ---
    let g_std = vg_gum(90.0, wt, dose, mic)
    let d_std = vg_knightian(90.0, wt, dose, mic)
    if g_std.u_ratio <= 50.0 { return fail(1) }
    if g_std.ratio <= 0.0 { return fail(2) }
    if d_std != 0 && d_std != 1 { return fail(3) }

    let sq = g_std.u_cl * g_std.u_cl + g_std.u_crcl * g_std.u_crcl
        + g_std.u_vc * g_std.u_vc + g_std.u_vp * g_std.u_vp
        + g_std.u_fu * g_std.u_fu + g_std.u_mic * g_std.u_mic
        + g_std.u_num * g_std.u_num
    let mic_frac = g_std.u_mic * g_std.u_mic / sq
    if mic_frac <= 0.30 { return fail(4) }

    print("VANCO_TDM_E2E std_ratio=")
    print(g_std.ratio)
    print(" std_u=")
    print(g_std.u_ratio)
    print(" std_dec=")
    print(d_std)
    print(" mic_frac=")
    print(mic_frac)
    print("\n")

    // --- Renal-impaired CrCl=20 → Refuse ---
    let g_ren = vg_gum(20.0, wt, dose, mic)
    let d_ren = vg_knightian(20.0, wt, dose, mic)
    if d_ren != 2 { return fail(10) }
    if g_ren.ratio <= 600.0 { return fail(11) }  // point estimate supra-therapeutic

    print("VANCO_TDM_E2E ren_ratio=")
    print(g_ren.ratio)
    print(" ren_u=")
    print(g_ren.u_ratio)
    print(" ren_dec=")
    print(d_ren)
    print("\n")

    // --- Budget dominance print (std case) ---
    print("VANCO_TDM_E2E budget_u_cl=")
    print(g_std.u_cl)
    print(" budget_u_mic=")
    print(g_std.u_mic)
    print(" budget_u_crcl=")
    print(g_std.u_crcl)
    print("\n")

    print("CLINICAL_VANCO_TDM_E2E_OK\n")
    return 0
}
