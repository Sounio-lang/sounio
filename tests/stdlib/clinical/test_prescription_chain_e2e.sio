//@ run-pass
// Epistemic Prescription Chain E2E — default Madaros multi-module.
//
// OUSADIA: incerteza chega à decisão; overclaim de confiança falha em compile-fail.
//
// Chain:
//   GUM (Type A + Type B) → AUC24/MIC → expanded U95 (correct k95 under Madaros)
//   → GUM band decision (U95 vs ASHP 400–600) + Knightian CL prior
//   → ADMIT/ADJUST/REFUSE
//
// Engine: **default** ./bin/souc (Madaros native multi-module import of epistemic::gum)
// Compile-fail siblings: tests/compile-fail/med/vancomycin_*_refusal.sio
//
// Literature: Matzke 1984 CL (mL/min → L/h via *0.06); ASHP/SIDP/IDSA 2020 AUC/MIC 400–600
// claims_not_made: bedside product; Knowledge<T> import (still D3); NONMEM FOCE;
//                  full Madaros Knowledge path; numpy; patient-specific Bayesian TDM

use epistemic::gum::{
    gum_type_a,
    gum_type_b,
    gum_combine2,
    gum_value,
    gum_std_u,
    gum_k95,
    gum_u95,
    gum_dof,
    GUMResult
}

// Avoid print(i32) under Madaros multi-module (can SIGSEGV); use string codes.
fn fail(code: i32) -> i32 with IO {
    if code == 1 { print("FAIL code=1 dof_out_of_range\n"); return 1 }
    if code == 2 { print("FAIL code=2 k95_out_of_range\n"); return 2 }
    if code == 3 { print("FAIL code=3 decide_std_unexpected\n"); return 3 }
    if code == 4 { print("FAIL code=4 gum_band_unexpected\n"); return 4 }
    if code == 10 { print("FAIL code=10 renal_not_refuse\n"); return 10 }
    if code == 11 { print("FAIL code=11 renal_q_not_high\n"); return 11 }
    if code == 12 { print("FAIL code=12 renal_gum_not_refuse\n"); return 12 }
    print("FAIL code=unknown\n")
    return code
}

// CL (L/h) from CrCl (mL/min) — Matzke 1984: CL(mL/min) = 0.689*CrCl + 3.66,
// then *0.06 converts mL/min → L/h. Illustrative 1-cmt scaffold, not bedside.
fn cl_lh(crcl: f64) -> f64 {
    return (0.689 * crcl + 3.66) * 0.06
}

// Q = AUC24/MIC with 2 doses/day: AUC24 = 2*dose/CL (mg·h/L if dose mg, CL L/h)
fn auc_mic(dose_mg: f64, crcl: f64, mic: f64) -> f64 with Mut, Div, Panic {
    let cl = cl_lh(crcl)
    return (2.0 * dose_mg / cl) / mic
}

// GUM U95 vs ASHP/SIDP/IDSA 2020 AUC/MIC band [400, 600].
// 0=ADMIT (interval inside band), 1=ADJUST (touches boundary), 2=REFUSE (wholly out).
fn gum_band_decide(q: f64, u95: f64) -> i32 {
    let lo = q - u95
    let hi = q + u95
    if lo > 600.0 { return 2 }
    if hi < 400.0 { return 2 }
    if hi > 600.0 { return 1 }
    if lo < 400.0 { return 1 }
    return 0
}

// Knightian ±1σ on CL — ILLUSTRATIVE prior (CV=0.25), not patient-level evidence.
// 0=ADMIT, 1=ADJUST, 2=REFUSE. Upper-band safety only (toxicity edge).
fn knightian_decide(dose_mg: f64, crcl: f64, mic: f64) -> i32 with Mut, Div, Panic {
    let cl = cl_lh(crcl)
    let sigma = 0.25 * cl
    let cl_hi = cl + sigma
    let cl_lo = cl - sigma
    if cl_lo <= 0.0 { return 2 }
    let q_lo = (2.0 * dose_mg / cl_hi) / mic
    let q_hi = (2.0 * dose_mg / cl_lo) / mic
    if q_lo > 600.0 { return 2 }
    if q_hi > 600.0 { return 1 }
    return 0
}

// Conservative merge: max severity wins (REFUSE > ADJUST > ADMIT).
fn merge_decide(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let wt = 70.0
    let dose = 15.0 * wt
    let mic = 1.0

    // ----- Case A: standard CrCl=90 — GUM U95 drives ADJUST -----
    let q_std = auc_mic(dose, 90.0, mic)
    // Type-A-dominant budget (n=5 → ν=4) so Welch–Satterthwaite keeps finite ν_eff.
    // Zero Type-B term: proves Madaros multi-module k95 uses Student-t (~2.776),
    // not the D1-corrupt constant 1.960.
    let u_a = gum_type_a(0.15 * q_std, 5)
    let u_b = gum_type_b(0.0)
    let gum_std: GUMResult = gum_combine2(q_std, u_a, u_b)

    let k95 = gum_k95(gum_std)
    let dof = gum_dof(gum_std)
    let u95 = gum_u95(gum_std)
    // D1 fix proof: ν_eff≈4 → k95 ≈ t_0.975,4 ∈ (2.5, 3.0)
    if dof < 3.5 || dof > 4.5 { return fail(1) }
    if k95 < 2.5 || k95 > 3.0 { return fail(2) }

    let dec_gum = gum_band_decide(gum_value(gum_std), u95)
    let dec_kn = knightian_decide(dose, 90.0, mic)
    let dec_std = merge_decide(dec_gum, dec_kn)
    // q≈533, u95≈99 → hi≈632 > 600 → GUM band ADJUST
    if dec_gum != 1 { return fail(4) }
    if dec_std != 1 { return fail(3) }

    print("RX_CHAIN q_std=")
    print(gum_value(gum_std))
    print(" u_c=")
    print(gum_std_u(gum_std))
    print(" k95=")
    print(k95)
    print(" u95=")
    print(u95)
    print(" dof=")
    print(dof)
    print(" decide=ADJUST\n")

    // ----- Case B: renal CrCl=20 — REFUSE on both paths -----
    let q_ren = auc_mic(dose, 20.0, mic)
    let u_a_r = gum_type_a(0.15 * q_ren, 5)
    let gum_ren: GUMResult = gum_combine2(q_ren, u_a_r, u_b)
    let dec_ren_gum = gum_band_decide(gum_value(gum_ren), gum_u95(gum_ren))
    let dec_ren_kn = knightian_decide(dose, 20.0, mic)
    let dec_ren = merge_decide(dec_ren_gum, dec_ren_kn)
    if dec_ren != 2 { return fail(10) }
    if q_ren <= 600.0 { return fail(11) }
    if dec_ren_gum != 2 { return fail(12) }

    print("RX_CHAIN q_ren=")
    print(q_ren)
    print(" decide=REFUSE\n")

    print("RX_CHAIN labels=0:ADMIT 1:ADJUST 2:REFUSE\n")
    print("RX_CHAIN engine=madaros_default multi_module=epistemic_gum\n")
    print("RX_CHAIN compile_fail_witnesses=vancomycin_low_conf_refusal,vancomycin_weak_evidence_refusal\n")
    print("EPISTEMIC_PRESCRIPTION_CHAIN_E2E_OK\n")
    return 0
}
