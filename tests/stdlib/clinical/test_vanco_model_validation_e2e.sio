//@ run-pass
// Vancomycin as PRIMARY clinical model-validation drug (lean_single; self-contained).
//
// DRUG SWITCH: predicted-vs-observed PBPK28 rapamycin (Ferron 1997) is deferred —
// open web/MCP search found no free digitizable C(t) series (paywall Wiley/Ovid;
// scaffold citation 61:696-708 is wrong paper). Vancomycin has open literature
// endpoints and a closed 2-comp IV model already in-tree.
//
// This E2E validates the MODEL against literature *parameter/endpoint bands*
// (Matzke 1984 CL; Roberts 2011 Vc/Vp/Q; ASHP/SIDP/IDSA 2020 AUC targets),
// not a fabricated C(t) table.
//
// Standard patient: 70 kg, CrCl=90 mL/min, 15 mg/kg (=1050 mg) q12h, 1 h infusion.
// Formulas match stdlib/darwin_pbpk/validation/vancomycin_icu_pbpk.sio.
//
// Gate: bash scripts/clinical_vanco_model_validation_e2e_gate.sh
// claims_not_made: Ferron C(t) digitization, NONMEM FOCE, bedside product,
//                  Madaros multi-module, PBPK28 rapamycin GMFE

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_nr(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 16 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn ln_nr(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 999.0 }
    // ln via atanh series after range reduction to [1,2)
    var v = x
    var e = 0.0
    while v >= 2.0 { v = v * 0.5; e = e + 1.0 }
    while v < 1.0 { v = v * 2.0; e = e - 1.0 }
    let y = (v - 1.0) / (v + 1.0)
    var y2 = y * y
    var sum = 0.0
    var term = y
    var k = 0
    while k < 30 {
        sum = sum + term / (2.0 * (k as f64) + 1.0)
        term = term * y2
        k = k + 1
    }
    return 2.0 * sum + e * 0.6931471805599453
}

fn fail(code: i32) -> i32 with IO {
    print("FAIL code ")
    print(code)
    print("\n")
    return code
}

struct VancoState { cc: f64, cp: f64 }
struct VancoODE { cl_lh: f64, vc_l: f64, vp_l: f64, q_lh: f64 }
struct VancoSimOut { cmax: f64, trough: f64 }

fn vc_rhs(st: VancoState, r_mg_h: f64, p: VancoODE) -> VancoState with Mut, Div, Panic {
    let dcc = r_mg_h / p.vc_l
        - p.cl_lh / p.vc_l * st.cc
        - p.q_lh / p.vc_l * (st.cc - st.cp)
    let dcp = p.q_lh / p.vp_l * (st.cc - st.cp)
    return VancoState { cc: dcc, cp: dcp }
}

fn vc_add(s: VancoState, ds: VancoState, h: f64) -> VancoState {
    return VancoState { cc: s.cc + h * ds.cc, cp: s.cp + h * ds.cp }
}

fn vc_rk4(st: VancoState, r: f64, dt: f64, p: VancoODE) -> VancoState with Mut, Div, Panic {
    let k1 = vc_rhs(st, r, p)
    let k2 = vc_rhs(vc_add(st, k1, 0.5 * dt), r, p)
    let k3 = vc_rhs(vc_add(st, k2, 0.5 * dt), r, p)
    let k4 = vc_rhs(vc_add(st, k3, dt), r, p)
    return VancoState {
        cc: st.cc + dt * (k1.cc + 2.0 * k2.cc + 2.0 * k3.cc + k4.cc) / 6.0,
        cp: st.cp + dt * (k1.cp + 2.0 * k2.cp + 2.0 * k3.cp + k4.cp) / 6.0,
    }
}

fn cl_lh_from_crcl(crcl: f64) -> f64 {
    // Matzke 1984: CL (mL/min) = 0.689*CrCl + 3.66 → L/h
    return (0.689 * crcl + 3.66) * 0.06
}

// Steady-state AUC24 for intermittent infusion: AUC24 = Dose24 / CL
fn auc24_ss(crcl: f64, dose_mg: f64, doses_per_24: f64) -> f64 with Mut, Div, Panic {
    let cl = cl_lh_from_crcl(crcl)
    return (dose_mg * doses_per_24) / cl
}

fn vc_simulate(crcl: f64, weight: f64, dose_mg: f64, inf_h: f64) -> VancoSimOut
    with Mut, Div, Panic
{
    let cl_lh = cl_lh_from_crcl(crcl)
    let vc_l = 0.40 * weight
    let vp_l = 0.30 * weight
    let p = VancoODE { cl_lh: cl_lh, vc_l: vc_l, vp_l: vp_l, q_lh: 2.99 }
    let r_on = dose_mg / inf_h
    let dt = 0.5
    var st = VancoState { cc: 0.0, cp: 0.0 }
    var t = 0.0
    var cmax = 0.0
    var trough = 0.0
    while t < 24.0 {
        let r = if t < inf_h {
            r_on
        } else {
            if t >= 12.0 && t < 12.0 + inf_h { r_on } else { 0.0 }
        }
        if t >= 11.0 && t < 12.0 { trough = st.cc }
        st = vc_rk4(st, r, dt, p)
        t = t + dt
        if st.cc > cmax { cmax = st.cc }
    }
    return VancoSimOut { cmax: cmax, trough: trough }
}

fn vc_thalf(crcl: f64, weight: f64, dose_mg: f64, inf_h: f64) -> f64
    with Mut, Div, Panic
{
    let cl_lh = cl_lh_from_crcl(crcl)
    let vc_l = 0.40 * weight
    let vp_l = 0.30 * weight
    let p = VancoODE { cl_lh: cl_lh, vc_l: vc_l, vp_l: vp_l, q_lh: 2.99 }
    let r_on = dose_mg / inf_h
    let dt = 0.5
    var st = VancoState { cc: 0.0, cp: 0.0 }
    var t = 0.0
    var c12 = 0.0
    var c24 = 0.0
    while t < 24.0 {
        let r = if t < inf_h { r_on } else { 0.0 }
        st = vc_rk4(st, r, dt, p)
        t = t + dt
        if t >= 12.0 && t < 12.0 + dt { c12 = st.cc }
        if t >= 24.0 - 1.0e-9 { c24 = st.cc }
    }
    if c12 <= 0.0 || c24 <= 0.0 { return 0.0 }
    let ratio = c12 / c24
    if ratio <= 1.0 { return 0.0 }
    let lz = ln_nr(ratio) / 12.0
    if lz <= 0.0 { return 0.0 }
    return 0.6931471805599453 / lz
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let wt = 70.0
    let dose = 15.0 * wt
    let inf_h = 1.0
    let crcl90 = 90.0
    let crcl20 = 20.0

    // --- AUC24 steady-state (ASHP 2020 band via analytical Dose/CL) ---
    let auc90 = auc24_ss(crcl90, dose, 2.0)
    let auc20 = auc24_ss(crcl20, dose, 2.0)
    if auc90 < 400.0 { return fail(1) }
    if auc90 > 700.0 { return fail(2) }
    if auc20 <= 1.5 * auc90 { return fail(3) }

    // --- RK4 Cmax / trough ---
    let sim = vc_simulate(crcl90, wt, dose, inf_h)
    if sim.cmax < 15.0 || sim.cmax > 55.0 { return fail(4) }
    if sim.trough < 5.0 || sim.trough > 25.0 { return fail(5) }

    // --- terminal t½ band ---
    let th = vc_thalf(crcl90, wt, dose, inf_h)
    if th < 4.0 || th > 18.0 { return fail(6) }

    print("VANCO_MODEL_VAL auc24_crcl90=")
    print(auc90)
    print(" auc24_crcl20=")
    print(auc20)
    print(" cmax=")
    print(sim.cmax)
    print(" trough=")
    print(sim.trough)
    print(" t_half=")
    print(th)
    print("\n")

    print("VANCO_MODEL_VAL drug=vancomycin source=Matzke1984+Roberts2011+ASHP2020\n")
    print("VANCO_MODEL_VAL deferred=rapamycin_Ferron1997_Ct_paywall\n")
    print("CLINICAL_VANCO_MODEL_VALIDATION_E2E_OK\n")
    return 0
}
