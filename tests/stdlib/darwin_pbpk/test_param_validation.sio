//@ run-pass
//@ expect-stdout: PARAM_VALIDATION_OK
// Unit tests for pbpk_params_validate parameter validation function.

use darwin_pbpk::tsit5_pbpk14::*

fn main() -> i32 with IO, Mut, Div, Panic {
    // 1. Default params should be valid (returns 0)
    let prm = default_pbpk_params()
    if pbpk_params_validate(prm) != 0 { return 1 }

    // 2. v_liver <= 0 should return error code 2
    var prm2 = default_pbpk_params()
    prm2.v_liver = -1.0
    if pbpk_params_validate(prm2) != 2 { return 2 }

    // 3. q_brain < 0 should return error code 17
    var prm3 = default_pbpk_params()
    prm3.q_brain = -1.0
    if pbpk_params_validate(prm3) != 17 { return 3 }

    // 4. kp_skin <= 0 should return error code 36
    var prm4 = default_pbpk_params()
    prm4.kp_skin = 0.0
    if pbpk_params_validate(prm4) != 36 { return 4 }

    // 5. cl_hepatic < 0 should return error code 41
    var prm5 = default_pbpk_params()
    prm5.cl_hepatic = -1.0
    if pbpk_params_validate(prm5) != 41 { return 5 }

    // 6. fu_plasma > 1 should return error code 43
    var prm6 = default_pbpk_params()
    prm6.fu_plasma = 1.5
    if pbpk_params_validate(prm6) != 43 { return 6 }

    // 7. rb_ratio <= 0 should return error code 44
    var prm7 = default_pbpk_params()
    prm7.rb_ratio = 0.0
    if pbpk_params_validate(prm7) != 44 { return 7 }

    // 8. fu_plasma <= 0 should return error code 43
    var prm8 = default_pbpk_params()
    prm8.fu_plasma = 0.0
    if pbpk_params_validate(prm8) != 43 { return 8 }

    println("PARAM_VALIDATION_OK")
    0
}
