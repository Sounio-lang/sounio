//@ run-pass
// E2E test for darwin_pbpk — tests Tsit5 PBPK integrator constants
use darwin_pbpk::tsit5_pbpk14::*;

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    // Test 1: Tsit5 Butcher tableau c-coefficients
    let c2 = tsit5_c2()
    let c3 = tsit5_c3()
    let c6 = tsit5_c6()
    let c7 = tsit5_c7()
    if c6 < 0.9 { return 1 }
    if c7 < 0.9 { return 1 }

    // Test 2: Butcher a-coefficients
    let a21 = tsit5_a21()
    if check_near(a21, 0.161, 0.001) == false { return 2 }

    // Test 3: Negative coefficient
    let a31 = tsit5_a31()
    if a31 > 0.0 { return 3 }

    // Test 4: Create a 14-compartment PBPK state
    let state = PBPKState14 {
        blood: 0.0, liver: 0.0, kidney: 0.0, brain: 0.0,
        heart: 0.0, lung: 0.0, muscle: 0.0, adipose: 0.0,
        gut: 0.0, skin: 0.0, bone: 0.0, spleen: 0.0,
        pancreas: 0.0, other: 0.0
    }
    if state.lung > 0.001 { return 4 }
    if state.skin > 0.001 { return 5 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
