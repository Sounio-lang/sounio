//@ run-pass
// @ timeout: 60
//@ expect-stdout: BRAIN_PLASMA_TAC_OK
// Canonical brain/plasma trajectory test for darwin_pbpk.

use darwin_pbpk::brain_plasma_tac::*
use darwin_pbpk::export::brain_plasma_measurements::*

fn abs_f64_local(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn near_f64(a: f64, b: f64, tol: f64) -> bool {
    abs_f64_local(a - b) < tol
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let table = rapamycin_brain_plasma_reference_tac()
    if table.success == false { return 1 }
    if table.n_points != 8 { return 2 }

    // Golden checkpoint times
    if near_f64(table.times_h[0], 0.0, 1.0e-9) == false { return 3 }
    if near_f64(table.times_h[4], 8.0, 1.0e-9) == false { return 4 }
    if near_f64(table.times_h[7], 168.0, 1.0e-9) == false { return 5 }

    // Stable domain invariants
    if table.blood_values[0] <= 0.0 { return 6 }
    if abs_f64_local(table.brain_values[0]) > 1.0e-9 { return 7 }
    if table.blood_values[7] >= table.blood_values[0] { return 8 }
    if table.brain_values[1] <= 0.0 { return 9 }
    if table.brain_values[1] >= table.blood_values[1] { return 10 }
    if table.blood_uncertainties[7] <= 0.0 { return 11 }
    if table.brain_uncertainties[7] <= 0.0 { return 12 }

    // Seeded golden checkpoints from the canonical rapamycin reference TAC.
    // Regenerated after fixing the PBPKState14 struct field hash collision
    // (lung/skin both hashed to 4033616; the old compiler aliased them,
    // corrupting the entire PBPK circulation model).
    if near_f64(table.blood_values[1], 0.058166, 0.0001) == false { return 13 }
    if near_f64(table.brain_values[1], 0.001652, 0.0001) == false { return 14 }
    if near_f64(table.blood_values[3], 0.028998, 0.0001) == false { return 15 }
    if near_f64(table.brain_values[3], 0.003776, 0.0001) == false { return 16 }
    if near_f64(table.blood_uncertainties[7], 0.006891, 0.0001) == false { return 17 }
    if near_f64(table.brain_uncertainties[7], 0.001334, 0.0001) == false { return 18 }
    if near_f64(table.brain_values[7], 0.001496, 0.00001) == false { return 19 }

    print_brain_plasma_measurements_csv(table)
    println("BRAIN_PLASMA_TAC_OK")
    0
}
