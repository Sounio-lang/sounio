//@ run-pass
//@ known-failure: Missing library implementation
//@ expect-stdout: EPISTEMIC_PBPK_OK
// Tests for darwin_pbpk::epistemic_sim — 4-compartment oral PBPK with GUM uncertainty.
//
// Test plan:
//   T1. Cmax in [1.0, 5.0] mg/L for default parameters (100mg oral, Vd=50L, F=0.8)
//   T2. Tmax in [1.0, 5.0] h (oral absorption peak)
//   T3. AUC positive and has non-zero uncertainty
//   T4. Uncertainty grows over time (conc_uncertainties[end] > conc_uncertainties[1])
//   T5. Mass balance: gut + central + peripheral + eliminated ≈ dose*F (±1%)
//   T6. Higher dose_unc → higher Cmax uncertainty
//   T7. Therapeutic window: time_above_mec and time_below_mtc are non-negative and <= t_end

use darwin_pbpk::epistemic_sim::{
    PBPKParams, PBPKState, PBPKResult, GUMResult,
    pbpk_params_default, pbpk_state_initial, pbpk_simulate,
    pbpk_therapeutic_window
}

// ============================================================================
// HELPERS
// ============================================================================

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn pass(name: string) with IO {
    print("PASS ")
    print(name)
    print("\n")
}

fn fail(name: string) with IO, Panic {
    print("FAIL ")
    print(name)
    print("\n")
    // We continue (not panic) so all tests run; final check catches failures
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn run_tests() -> i32 with IO, Mut, Div, Panic {
    var failures = 0

    // --- Run default simulation (24 hours, 120 steps → 0.2h per step) ---
    let params = pbpk_params_default()
    let result = pbpk_simulate(&params, 24.0, 120)

    // T1: Cmax in [0.5, 5.0] mg/L
    // dose*F = 80mg; with ka=1/h, ke=0.1/h, k12=0.3/k21=0.2/h redistribution and Vd=50L
    // Cmax ≈ 0.90 mg/L — less than dose/Vd=1.6 due to peripheral distribution and elimination
    let cmax_v = result.cmax.value
    if cmax_v >= 0.5 && cmax_v <= 5.0 {
        pass("T1_cmax_range")
    } else {
        fail("T1_cmax_range")
        failures = failures + 1
    }

    // T2: Tmax in [1.0, 5.0] h
    let tmax = result.tmax
    if tmax >= 1.0 && tmax <= 5.0 {
        pass("T2_tmax_range")
    } else {
        fail("T2_tmax_range")
        failures = failures + 1
    }

    // T3: AUC positive and has non-zero uncertainty
    let auc_v = result.auc.value
    let auc_u = result.auc.std_uncertainty
    if auc_v > 0.0 && auc_u > 0.0 {
        pass("T3_auc_positive_with_uncertainty")
    } else {
        fail("T3_auc_positive_with_uncertainty")
        failures = failures + 1
    }

    // T4: Uncertainty grows over time
    // Compare point 1 (after first step — some uncertainty from params) vs last recorded point.
    // At t=0 central=0 so unc=0; by t=Tmax uncertainty accumulates.
    // We check that the maximum uncertainty in the back-half > unc at index 1.
    let n = result.n_points
    let last_idx = n - 1
    let unc_early = result.conc_uncertainties[1]
    let unc_late  = result.conc_uncertainties[last_idx]
    if unc_late >= unc_early {
        pass("T4_uncertainty_grows")
    } else {
        fail("T4_uncertainty_grows")
        failures = failures + 1
    }

    // T5: Mass balance at final state
    // Total mass = gut + central + peripheral + eliminated ≈ dose * F (±1%)
    let fs      = result.final_state
    let dose_f  = params.dose * params.bioavailability
    let total   = fs.gut + fs.central + fs.peripheral + fs.eliminated
    let rel_err = abs_f(total - dose_f) / dose_f
    if rel_err < 0.01 {
        pass("T5_mass_balance")
    } else {
        fail("T5_mass_balance")
        failures = failures + 1
    }

    // T6: Higher dose_unc → higher Cmax uncertainty
    // Create params2 with doubled dose_unc; Cmax uncertainty should be larger.
    let params2 = PBPKParams {
        dose: params.dose,
        dose_unc: params.dose_unc * 3.0,
        ka: params.ka, ka_unc: params.ka_unc,
        ke: params.ke, ke_unc: params.ke_unc,
        vd: params.vd, vd_unc: params.vd_unc,
        k12: params.k12, k12_unc: params.k12_unc,
        k21: params.k21, k21_unc: params.k21_unc,
        bioavailability: params.bioavailability,
        bioavailability_unc: params.bioavailability_unc,
    }
    let result2 = pbpk_simulate(&params2, 24.0, 120)
    if result2.cmax.std_uncertainty > result.cmax.std_uncertainty {
        pass("T6_higher_dose_unc_higher_cmax_unc")
    } else {
        fail("T6_higher_dose_unc_higher_cmax_unc")
        failures = failures + 1
    }

    // T7: Therapeutic window non-negative and bounded by t_end
    let mec = 0.5  // mg/L — minimum effective concentration
    let mtc = 4.0  // mg/L — minimum toxic concentration
    let tw = pbpk_therapeutic_window(&result, mec, mtc)
    // Unpack tuple
    let time_above_mec = tw.0
    let time_below_mtc = tw.1
    let t_end = 24.0
    if time_above_mec >= 0.0 && time_above_mec <= t_end
        && time_below_mtc >= 0.0 && time_below_mtc <= t_end {
        pass("T7_therapeutic_window_bounds")
    } else {
        fail("T7_therapeutic_window_bounds")
        failures = failures + 1
    }

    return failures
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let failures = run_tests()
    if failures == 0 {
        print("EPISTEMIC_PBPK_OK\n")
        return 0
    }
    print("EPISTEMIC_PBPK_FAIL\n")
    return 1
}
