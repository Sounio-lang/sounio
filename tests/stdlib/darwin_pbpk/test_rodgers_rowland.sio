//@ run-pass
//@ expect-stdout-contains: RR_KP_UNITS_OK

// CI-collected regression fixture for core/rodgers_rowland.sio.
//
// The module carries its own //@ run-pass annotations, but it lives under
// stdlib/ and scripts/dev/run_sio_test_suite_v2.sh collects only
// tests/run-pass/*.sio, tests/compile-fail/*.sio, tests/ui/*/*.sio,
// tests/stdlib/*/test_*.sio and tests/gpu/*.sio -- so those tests never ran in
// CI and the Kpu->Kp conversion could regress unnoticed. This file is the
// collected mirror of the two scale-SENSITIVE properties; the module's own
// T1-T4 are scale-invariant and cannot detect the defect this guards.
//
// R1  Kp increases with fu_plasma. Kp = Kpu*fu_p and Kpu does not depend on
//     fu_p, so this is monotone by construction. Dividing instead of
//     multiplying (the pre-2026-09-26 body) inverts it.
// R2  A drug with negligible lipid affinity can at most fill tissue water, so
//     Kp = fu_p*(fw_e + fw_i) <= 1. At logP = -3, P = 1e-3.
// R3  The log-sensitivity is independent of fu_plasma. This is what leaves
//     rr_scaled_uncertainty -- the only consumer of the module's own output,
//     from its main(); the module has no .sio caller at all -- unaffected by
//     the conversion fix, so it is asserted rather than claimed.
// R4  Volume-fraction feasibility of the composition table the conversion is
//     applied to: no organ may assign negative protein volume, i.e.
//     f_ew + f_iw + f_nl + f_np <= 1. MEASURED 2026-09-26: 13/14, the single
//     violation being adipose at 1.0070 (0.70% over), documented in the module
//     header and deliberately not closed by inventing a replacement value. R4
//     therefore accepts 14/14 or 13/14-with-adipose and fails if a second or a
//     different organ goes infeasible.

// RRResult's fields are private and Madaros enforces that (E259), so the checks
// are exposed by the module as functions rather than read out of the struct.
use darwin_pbpk::core::rodgers_rowland::{rr_check_monotone_fu, rr_check_hydrophilic_bounded, rr_check_logsens_fu_invariant, rr_check_volume_feasible, rr_volume_sum}

fn main() -> i32 with IO, Mut, Div, Panic {
    let mono = rr_check_monotone_fu()
    let bounded = rr_check_hydrophilic_bounded()
    let ls_same = rr_check_logsens_fu_invariant()
    let feasible = rr_check_volume_feasible()
    let adipose_sum = rr_volume_sum(7)
    let feas_ok = feasible == 14 || (feasible == 13 && adipose_sum > 1.0)

    print("R1 Kp monotone in fu_plasma      : ") print(mono) println("/14")
    print("R2 hydrophilic Kp <= 1           : ") print(bounded) println("/14")
    print("R3 log-sens independent of fu    : ") print(ls_same) println("/14")
    print("R4 volume fractions feasible     : ") print(feasible) println("/14")
    print("R4 adipose fraction sum          : ") println(adipose_sum)

    if mono == 14 && bounded == 14 && ls_same == 14 && feas_ok {
        println("RR_KP_UNITS_OK")
        return 0
    }
    println("RR_KP_UNITS_FAIL")
    return 1
}
