//@ run-pass
//@ requires: madaros
//@ expect-stdout: MASSIVE_COLLECTIONS_OK
use collections::dynamic_deque::{dynamic_deque_new,dynamic_deque_len,dynamic_deque_push_back,dynamic_deque_push_front,dynamic_deque_pop_front,dynamic_deque_pop_back,dynamic_deque_get,dynamic_deque_close}
use collections::dynamic_map::{dynamic_map_new,dynamic_map_len,dynamic_map_put,dynamic_map_get,dynamic_map_remove,dynamic_map_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    var d=dynamic_deque_new(80000)
    var i:i64=0
    while i<6000 {assert(dynamic_deque_push_back(&!d,i)==0);i=i+1}
    i=0
    while i<3000 {assert(dynamic_deque_pop_front(&!d).value==i);i=i+1}
    assert(dynamic_deque_push_front(&!d,0)==0)
    assert(dynamic_deque_pop_front(&!d).status==0)
    assert(dynamic_deque_pop_back(&!d).value==5999)
    assert(dynamic_deque_get(&d,0).value==3000)
    assert(dynamic_deque_len(&d)==2999)
    dynamic_deque_close(d)
    var m=dynamic_map_new(240000)
    i=0
    while i<5000 {assert(dynamic_map_put(&!m,i*16,i)==0);i=i+1}
    i=0
    while i<5000 {assert(dynamic_map_get(&m,i*16).value==i);i=i+1}
    assert(dynamic_map_get(&m,0).status==0)
    assert(dynamic_map_get(&m,1).status==4)
    assert(dynamic_map_remove(&!m,0).status==0)
    assert(dynamic_map_get(&m,16).value==1)
    assert(dynamic_map_put(&!m,0,123)==0)
    assert(dynamic_map_get(&m,0).value==123)
    assert(dynamic_map_len(&m)==5000)
    dynamic_map_close(m)
    var tiny=dynamic_map_new(24)
    assert(dynamic_map_put(&!tiny,0,0)==0)
    assert(dynamic_map_put(&!tiny,0,9)==0)
    assert(dynamic_map_put(&!tiny,1,2)==2)
    assert(dynamic_map_get(&tiny,0).value==9)
    dynamic_map_close(tiny)
    println("MASSIVE_COLLECTIONS_OK")
    return 0
}
