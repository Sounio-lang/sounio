//@ run-pass
//@ requires: madaros
//@ expect-stdout: CSV_CHECKED_NUMERIC_OK
use data::csv_reader::{csv_open,csv_next_row,csv_int,csv_f64_scaled,csv_ok}
fn integer(text:string,expected:i64,valid:bool) with Mut,Div,Panic {
 var r=csv_open(text)
 assert(csv_next_row(&!r))
 assert(csv_int(&!r,0)==expected)
 assert(csv_ok(&r)==valid)
}
fn scaled(text:string,decimals:i64,expected:i64,valid:bool) with Mut,Div,Panic {
 var r=csv_open(text)
 assert(csv_next_row(&!r))
 assert(csv_f64_scaled(&!r,0,decimals)==expected)
 assert(csv_ok(&r)==valid)
}
fn main()->i32 with IO,Mut,Div,Panic {
 integer("v\n9223372036854775807\n",9223372036854775807,true)
 integer("v\n-9223372036854775808\n",0-9223372036854775807-1,true)
 integer("v\n9223372036854775808\n",0,false)
 integer("v\n-9223372036854775809\n",0,false)
 integer("v\n1.0\n",0,false)
 integer("v\n+7\n",7,true)
 integer("v\n-\n",0,false)
 scaled("v\n92233720368547758.07\n",2,9223372036854775807,true)
 scaled("v\n-92233720368547758.08\n",2,0-9223372036854775807-1,true)
 scaled("v\n92233720368547758.08\n",2,0,false)
 scaled("v\n-92233720368547758.09\n",2,0,false)
 scaled("v\n1.12345\n",2,112,true)
 scaled("v\n.5\n",2,50,true)
 scaled("v\n.\n",2,0,false)
 scaled("v\n1\n",-1,0,false)
 scaled("v\n1\n",19,0,false)
 var r=csv_open("v\n99999999999999999999\n3\n")
 assert(csv_next_row(&!r));assert(csv_int(&!r,0)==0 && !csv_ok(&r))
 assert(csv_next_row(&!r));assert(csv_int(&!r,0)==3 && csv_ok(&r))
 println("CSV_CHECKED_NUMERIC_OK")
 return 0
}
