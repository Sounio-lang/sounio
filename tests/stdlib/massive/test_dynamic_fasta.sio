//@ run-pass
//@ requires: madaros
//@ expect-stdout: DYNAMIC_FASTA_OK
use genomics::io::dynamic_fasta::{dynamic_fasta_parse,dynamic_fasta_status,dynamic_fasta_len,dynamic_fasta_record,dynamic_fasta_header,dynamic_fasta_sequence,dynamic_fasta_close}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_len,byte_buffer_get,byte_buffer_push,byte_buffer_close}
fn append(b:&!ByteBuffer,text:string) with Alloc,Mut,Div,Panic {var i:i64=0;while str_char_at(text,i)>0 {assert(byte_buffer_push(b,str_char_at(text,i))==0);i=i+1}}
fn invalid(text:string) with Alloc,Mut,Div,Panic {
 var b=byte_buffer_new(1000);append(&!b,text)
 let d=dynamic_fasta_parse(&b,10000)
 assert(dynamic_fasta_status(&d)==22)
 dynamic_fasta_close(d);byte_buffer_close(b)
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var input=byte_buffer_new(20000)
 append(&!input,">first long sequence\r\n")
 var i:i64=0
 while i<4096 {assert(byte_buffer_push(&!input,if i%2==0 {97} else {110})==0);i=i+1}
 append(&!input,"\r\n>second\r\nacgtry swkmbdhvnu\r\n")
 let d=dynamic_fasta_parse(&input,30000)
 assert(dynamic_fasta_status(&d)==0 && dynamic_fasta_len(&d)==2)
 byte_buffer_close(input)
 assert(dynamic_fasta_record(&d,0).bases==4096)
 assert(dynamic_fasta_record(&d,1).bases==16)
 var sequence=byte_buffer_new(4096)
 assert(dynamic_fasta_sequence(&d,0,&!sequence)==0)
 assert(byte_buffer_len(&sequence)==4096)
 assert(byte_buffer_get(&sequence,0).value==65 && byte_buffer_get(&sequence,1).value==78)
 byte_buffer_close(sequence)
 var header=byte_buffer_new(100)
 assert(dynamic_fasta_header(&d,1,&!header)==0)
 assert(byte_buffer_len(&header)==6 && byte_buffer_get(&header,0).value==115)
 byte_buffer_close(header)
 var tiny=byte_buffer_new(1)
 assert(dynamic_fasta_sequence(&d,1,&!tiny)==105)
 byte_buffer_close(tiny)
 dynamic_fasta_close(d)
 invalid("");invalid("ACGT\n");invalid(">\nAC\n");invalid(">a\n>b\nAC\n");invalid(">a\nACX\n")
 var many=byte_buffer_new(10000)
 i=0
 while i<300 {append(&!many,">record\nN\n");i=i+1}
 let indexed=dynamic_fasta_parse(&many,30000)
 assert(dynamic_fasta_status(&indexed)==0 && dynamic_fasta_len(&indexed)==300)
 assert(dynamic_fasta_record(&indexed,299).bases==1)
 dynamic_fasta_close(indexed)
 let budget=dynamic_fasta_parse(&many,3001)
 assert(dynamic_fasta_status(&budget)==105)
 dynamic_fasta_close(budget);byte_buffer_close(many)
 println("DYNAMIC_FASTA_OK")
 return 0
}
