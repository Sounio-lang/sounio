//@ run-pass
//@ expect-stdout: ACTIVE_LOG_CONCORDANCE_OK
use math::pure::{ln_checked}
use epistemic::knowledge::{ep_new}
use epistemic::active::{expected_free_energy}
fn log_row(x:f64) with IO,Mut,Div,Panic {
 let checked=ln_checked(x)
 assert(checked.status==0)
 let prior=ep_new(0.0,x,1000)
 let efe=expected_free_energy(&prior,1.0,0.0,1.0)
 print("ACTIVE_LOG ");print_int(f64_to_bits(x));print(" ")
 print_int(f64_to_bits(checked.value));print(" ");print_int(f64_to_bits(efe.epistemic));print("\n")
}
fn domain_row(x:f64) with IO,Mut,Div,Panic {
 let prior=ep_new(0.0,x,1000)
 let efe=expected_free_energy(&prior,1.0,0.0,1.0)
 print("ACTIVE_DOMAIN ");print_int(f64_to_bits(x));print(" ");print_int(f64_to_bits(efe.epistemic));print("\n")
}
fn main()->i32 with IO,Mut,Div,Panic {
 log_row(bits_to_f64(1));log_row(bits_to_f64(2))
 log_row(bits_to_f64(4503599627370495));log_row(bits_to_f64(4503599627370496))
 log_row(1e-300);log_row(1e-200);log_row(1e-100);log_row(1e-20);log_row(1e-7)
 log_row(0.01);log_row(0.1);log_row(0.25)
 log_row(0.49999999999999994);log_row(0.5);log_row(0.5000000000000001)
 log_row(0.9999999999999999);log_row(1.0);log_row(1.0000000000000002)
 log_row(1.5);log_row(1.9999999999999998);log_row(2.0);log_row(2.0000000000000004)
 log_row(4.0);log_row(16.0);log_row(1e6);log_row(1e20)
 log_row(1e100);log_row(1e200);log_row(1e300);log_row(bits_to_f64(9218868437227405311))
 assert(ln_checked(0.0).status==1)
 assert(ln_checked(0.0-1.0).status==1)
 assert(ln_checked(bits_to_f64(9218868437227405312)).status==2)
 assert(ln_checked(bits_to_f64(9221120237041090560)).status==2)
 domain_row(0.0);domain_row(0.0-1.0)
 domain_row(bits_to_f64(9218868437227405312));domain_row(bits_to_f64(9221120237041090560))
 println("ACTIVE_LOG_CONCORDANCE_OK")
 0
}
