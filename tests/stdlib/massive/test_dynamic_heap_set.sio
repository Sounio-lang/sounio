//@ run-pass
//@ requires: madaros
//@ expect-stdout: DYNAMIC_HEAP_SET_OK
use collections::dynamic_heap::{dynamic_heap_new,dynamic_heap_push,dynamic_heap_pop,dynamic_heap_len,dynamic_heap_close}
use collections::dynamic_set::{dynamic_set_new,dynamic_set_insert,dynamic_set_remove,dynamic_set_contains,dynamic_set_len,dynamic_set_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var h=dynamic_heap_new(32768)
 assert(dynamic_heap_pop(&!h).status==4)
 var i:i64=2048
 while i>0 {i=i-1;assert(dynamic_heap_push(&!h,i)==0)}
 i=0
 while i<2048 {let r=dynamic_heap_pop(&!h);assert(r.status==0 && r.value==i);i=i+1}
 assert(dynamic_heap_len(&h)==0)
 assert(dynamic_heap_push(&!h,0-9223372036854775807-1)==0)
 assert(dynamic_heap_push(&!h,9223372036854775807)==0)
 assert(dynamic_heap_push(&!h,0)==0)
 assert(dynamic_heap_push(&!h,0)==0)
 assert(dynamic_heap_pop(&!h).value==0-9223372036854775807-1)
 assert(dynamic_heap_pop(&!h).value==0)
 assert(dynamic_heap_pop(&!h).value==0)
 assert(dynamic_heap_pop(&!h).value==9223372036854775807)
 dynamic_heap_close(h)
 var tiny=dynamic_heap_new(8)
 assert(dynamic_heap_push(&!tiny,7)==0)
 assert(dynamic_heap_push(&!tiny,1)==2)
 assert(dynamic_heap_len(&tiny)==1)
 assert(dynamic_heap_pop(&!tiny).value==7)
 dynamic_heap_close(tiny)
 var s=dynamic_set_new(49152)
 i=0
 while i<1024 {assert(dynamic_set_insert(&!s,i)==0);i=i+1}
 assert(dynamic_set_len(&s)==1024)
 i=0
 while i<1024 {assert(dynamic_set_contains(&s,i));assert(dynamic_set_insert(&!s,i)==0);assert(dynamic_set_remove(&!s,i)==0);assert(!dynamic_set_contains(&s,i));i=i+1}
 assert(dynamic_set_len(&s)==0)
 assert(dynamic_set_insert(&!s,0-1)==0)
 assert(dynamic_set_contains(&s,0-1))
 assert(dynamic_set_remove(&!s,77)==4)
 dynamic_set_close(s)
 println("DYNAMIC_HEAP_SET_OK")
 return 0
}
