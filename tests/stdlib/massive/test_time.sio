//@ run-pass
//@ requires: madaros
//@ expect-stdout: MASSIVE_TIME_OK
use ffi::platform::{platform_open,platform_status,platform_close}
use time::instant::{instant_now,instant_status,instant_elapsed_ns,instant_elapsed_ms}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let p=platform_open()
    assert(platform_status(&p)==0)
    let start=instant_now(&p)
    let end=instant_now(&p)
    assert(instant_status(&start)==0)
    assert(instant_status(&end)==0)
    let elapsed=instant_elapsed_ns(&start,&end)
    assert(elapsed.status==0)
    assert(elapsed.value>=0)
    assert(instant_elapsed_ns(&start,&start).value==0)
    assert(instant_elapsed_ms(&start,&end).status==0)
    platform_close(p)
    println("MASSIVE_TIME_OK")
    return 0
}
