//@ run-pass
//@ expect-stdout: PAC_ACTIVE_CONTROLS_OK
use ml::pac::{decision_stump_vc_dim,sample_complexity}
use epistemic::knowledge::{Epistemic,ep_new}
use epistemic::active::{exploration_score,update_belief,expected_free_energy}
fn main()->i32 with IO,Mut,Div,Panic {
 let low=ep_new(1.0,0.0,0)
 let mid=ep_new(1.0,0.0,250)
 let high=ep_new(1.0,0.0,1000)
 let a=(exploration_score(&low,1.0)*4.0) as i64
 let b=(exploration_score(&mid,1.0)*4.0) as i64
 let c=(exploration_score(&high,1.0)*4.0) as i64
 let prior=ep_new(10.0,4.0,800)
 let posterior=update_belief(&prior,14.0,4.0)
 assert(posterior.val==12.0 && posterior.variance==2.0 && posterior.confidence==800)
 let efe=expected_free_energy(&prior,4.0,2.0,3.0)
 assert(efe.epistemic==0.0 && efe.pragmatic==6.0 && efe.total==0.0-6.0)
 assert(decision_stump_vc_dim()==1)
 let first=sample_complexity(1,0.5,0.5)
 let second=sample_complexity(10,0.1,0.1)
 let third=sample_complexity(2,0.25,0.25)
 print("ACTIVE_CONTROL ");print(a);print(" ");print(b);print(" ");print(c);print(" ")
 print(posterior.val as i64);print(" ");print(posterior.variance as i64);print(" ");print(posterior.confidence)
 print(" ");print(first);print(" ");print(second);print(" ");println(third)
 println("PAC_ACTIVE_CONTROLS_OK")
 0
}
