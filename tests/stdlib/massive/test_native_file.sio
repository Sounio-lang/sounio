//@ run-pass
//@ requires: madaros
//@ expect-stdout: NATIVE_FILE_OK
use ffi::platform::{platform_open,platform_status,platform_close}
use io::native_file::{native_file_open,native_file_status,native_file_read,native_file_write_all,native_file_seek,native_file_sync,native_file_close}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_push,byte_buffer_get,byte_buffer_len,byte_buffer_close}
fn path_buffer(text:string)->ByteBuffer with Alloc,Mut,Div,Panic {
 var b=byte_buffer_new(256)
 var i:i64=0
 while str_char_at(text,i)>0 {assert(byte_buffer_push(&!b,str_char_at(text,i))==0);i=i+1}
 return b
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let path=path_buffer("native-file-sounio.tmp")
 let writer=native_file_open(&p,&path,1)
 assert(native_file_status(&writer)==0)
 var source=byte_buffer_new(10)
 var i:i64=0
 while i<10 {assert(byte_buffer_push(&!source,i*17)==0);i=i+1}
 let written=native_file_write_all(&p,&writer,&source,0,10)
 assert(written.status==0 && written.value==10)
 assert(native_file_write_all(&p,&writer,&source,9,2).status==22)
 assert(native_file_sync(&p,&writer)==0)
 assert(native_file_close(&p,writer)==0)
 let reader=native_file_open(&p,&path,0)
 assert(native_file_status(&reader)==0)
 var output=byte_buffer_new(11)
 assert(native_file_read(&p,&reader,&!output,12).status==105)
 assert(byte_buffer_len(&output)==0)
 assert(native_file_read(&p,&reader,&!output,5).value==5)
 assert(native_file_read(&p,&reader,&!output,5).value==5)
 let eof=native_file_read(&p,&reader,&!output,1)
 assert(eof.status==0 && eof.value==0)
 assert(byte_buffer_len(&output)==10)
 i=0
 while i<10 {assert(byte_buffer_get(&output,i).value==i*17);i=i+1}
 assert(native_file_seek(&p,&reader,0,7).status==22)
 assert(native_file_seek(&p,&reader,0,0).status==0)
 assert(native_file_write_all(&p,&reader,&source,0,1).status==9)
 assert(native_file_close(&p,reader)==0)
 let append=native_file_open(&p,&path,2)
 assert(native_file_write_all(&p,&append,&source,0,2).value==2)
 assert(native_file_close(&p,append)==0)
 let missing=path_buffer("directory-that-does-not-exist/input")
 let absent=native_file_open(&p,&missing,0)
 assert(native_file_status(&absent)==2)
 assert(native_file_close(&p,absent)==2)
 byte_buffer_close(missing);byte_buffer_close(output);byte_buffer_close(source);byte_buffer_close(path)
 platform_close(p)
 println("NATIVE_FILE_OK")
 return 0
}
