//@ run-pass
//@ requires: madaros
//@ expect-stdout: MASSIVE_BINARY_OK
use io::binary::{Endian,binary_read_checked,match_bytes_at}
fn main()->i32 with IO,Mut,Div,Panic {
    let bytes:[u8;8]=[120,86,52,18,0,0,0,0]
    assert(binary_read_checked(&bytes,0,4,Endian::Little).value==305419896)
    assert(binary_read_checked(&bytes,0,4,Endian::Big).value==2018915346)
    let zero=binary_read_checked(&bytes,4,4,Endian::Little)
    assert(zero.status==0)
    assert(zero.value==0)
    assert(binary_read_checked(&bytes,7,2,Endian::Little).status==1)
    assert(binary_read_checked(&bytes,0,3,Endian::Little).status==2)
    assert(binary_read_checked(&bytes,0-1,1,Endian::Little).status==1)
    assert(binary_read_checked(&bytes,9223372036854775807,1,Endian::Little).status==1)
    let pattern:[u8;1]=[0]
    assert(!match_bytes_at(&bytes,9223372036854775807,&pattern))
    assert(match_bytes_at(&bytes,4,&pattern))
    println("MASSIVE_BINARY_OK")
    return 0
}
