use collections::byte_buffer::{byte_buffer_new, byte_buffer_budget, byte_buffer_len, byte_buffer_capacity, byte_buffer_reserve, byte_buffer_close}
fn main() -> i32 with IO, Alloc, Mut, Panic {
    var b = byte_buffer_new(137)
    assert(byte_buffer_budget(&b) == 137)
    assert(byte_buffer_len(&b) == 0)
    assert(byte_buffer_capacity(&b) == 0)
    assert(byte_buffer_reserve(&!b, 17) == 0)
    assert(byte_buffer_budget(&b) == 137)
    assert(byte_buffer_capacity(&b) >= 17)
    assert(byte_buffer_reserve(&!b, 138) != 0)
    assert(byte_buffer_budget(&b) == 137)
    assert(byte_buffer_len(&b) == 0)
    byte_buffer_close(b)
    println("BYTE_BUFFER_BUDGET_OK")
    0
}
