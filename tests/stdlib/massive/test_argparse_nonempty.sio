use io::argparse::{parse, num_args, has_arg, is_verbose, is_help, is_quiet, get_arg, get_first_positional}
fn main() -> i32 with IO, Mut, Panic {
    let empty = parse([])
    assert(empty.program == "")
    assert(num_args(empty) == 0)
    assert(get_arg(empty, 0) == "")
    assert(get_first_positional(empty) == "")
    let a = parse(["program", "--verbose", "-h", "-q", "input.dat"])
    assert(a.program == "program")
    assert(num_args(a) == 4)
    assert(has_arg(a, "--verbose"))
    assert(!has_arg(a, "program"))
    assert(!has_arg(a, "--missing"))
    assert(is_verbose(a))
    assert(is_help(a))
    assert(is_quiet(a))
    assert(get_arg(a, 0) == "--verbose")
    assert(get_arg(a, 3) == "input.dat")
    assert(get_arg(a, 4) == "")
    assert(get_first_positional(a) == "input.dat")
    // The legacy simplified policy skips known flags only.
    let unknown = parse(["p", "--unknown", "file"])
    assert(get_first_positional(unknown) == "--unknown")
    assert(!is_verbose(unknown))
    println("ARGPARSE_NONEMPTY_OK")
    0
}
