//@ run-pass
//@ requires: madaros
//@ expect-stdout: MASSIVE_PLATFORM_OK
use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
use sync::native_atomic::{native_atomic_new,native_atomic_status,native_atomic_load,native_atomic_store,native_atomic_fetch_add,native_atomic_compare_exchange,native_atomic_close}
use thread::native::{native_thread_spawn,native_thread_status,native_thread_join,native_thread_close}
use collections::byte_buffer::{byte_buffer_new,byte_buffer_push,byte_buffer_get,byte_buffer_len,byte_buffer_system_random,byte_buffer_close}
use net::native::{native_tcp_listen,native_socket_status,native_socket_port,native_tcp_connect,native_tcp_accept,native_socket_send,native_socket_receive,native_socket_shutdown,native_socket_close,native_udp_bind,native_udp_send_loopback,native_udp_receive}
fn task(argument:i64)->i64 {return argument+7}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    println("PLATFORM_STAGE_LOADER")
    let p=platform_open()
    print("PLATFORM_LOADER_STATUS ");println(platform_status(&p))
    assert(platform_status(&p)==0)
    let a=native_atomic_new(&p,0)
    assert(native_atomic_status(&a)==0)
    assert(native_atomic_load(&p,&a).value==0)
    assert(native_atomic_fetch_add(&p,&a,7).value==0)
    assert(native_atomic_load(&p,&a).value==7)
    assert(native_atomic_compare_exchange(&p,&a,7,11).value==1)
    assert(native_atomic_store(&p,&a,0)==0)
    assert(native_atomic_close(&p,a)==0)
    println("PLATFORM_ATOMICS_OK")
    var t=native_thread_spawn(&p,task,35)
    assert(native_thread_status(&t)==0)
    assert(native_thread_join(&p,&!t).value==42)
    assert(native_thread_join(&p,&!t).status==22)
    assert(native_thread_close(&p,t)==0)
    println("PLATFORM_THREAD_OK")
    var entropy=byte_buffer_new(128)
    assert(byte_buffer_system_random(&p,&!entropy,64).status==0)
    assert(byte_buffer_len(&entropy)==64)
    byte_buffer_close(entropy)
    println("PLATFORM_ENTROPY_OK")
    let listener=native_tcp_listen(&p,2130706433,0,8)
    assert(native_socket_status(&listener)==0)
    let port=native_socket_port(&p,&listener)
    assert(port.status==0)
    let client=native_tcp_connect(&p,2130706433,port.value,1000)
    assert(native_socket_status(&client)==0)
    let server=native_tcp_accept(&p,&listener,1000)
    assert(native_socket_status(&server)==0)
    var bytes=byte_buffer_new(32)
    assert(byte_buffer_push(&!bytes,65)==0)
    assert(byte_buffer_push(&!bytes,0)==0)
    assert(byte_buffer_push(&!bytes,255)==0)
    let sent=native_socket_send(&p,&client,&bytes,0,3,1000)
    assert(sent.status==0)
    assert(sent.value==3)
    var incoming=byte_buffer_new(32)
    let received=native_socket_receive(&p,&server,&!incoming,32,1000)
    assert(received.status==0)
    assert(received.value==3)
    assert(byte_buffer_get(&incoming,0).value==65)
    assert(byte_buffer_get(&incoming,1).value==0)
    assert(byte_buffer_get(&incoming,2).value==255)
    assert(native_socket_shutdown(&p,&client,1)==0)
    assert(native_socket_receive(&p,&server,&!incoming,1,1000).value==0)
    byte_buffer_close(bytes)
    byte_buffer_close(incoming)
    assert(native_socket_close(&p,server)==0)
    assert(native_socket_close(&p,client)==0)
    assert(native_socket_close(&p,listener)==0)
    let udp_receiver=native_udp_bind(&p,2130706433,0)
    let udp_sender=native_udp_bind(&p,2130706433,0)
    assert(native_socket_status(&udp_receiver)==0)
    assert(native_socket_status(&udp_sender)==0)
    let udp_port=native_socket_port(&p,&udp_receiver).value
    var packet=byte_buffer_new(3)
    assert(byte_buffer_push(&!packet,65)==0)
    assert(byte_buffer_push(&!packet,0)==0)
    assert(byte_buffer_push(&!packet,255)==0)
    var datagram=byte_buffer_new(3)
    assert(native_udp_send_loopback(&p,&udp_sender,&packet,0,3,udp_port).status==0)
    let truncated=native_udp_receive(&p,&udp_receiver,&!datagram,2,1000)
    assert(truncated.status==90)
    assert(truncated.value==2)
    assert(byte_buffer_len(&datagram)==0)
    assert(native_udp_send_loopback(&p,&udp_sender,&packet,0,3,udp_port).status==0)
    assert(native_udp_receive(&p,&udp_receiver,&!datagram,3,1000).status==0)
    assert(byte_buffer_len(&datagram)==3)
    assert(byte_buffer_get(&datagram,2).value==255)
    assert(native_udp_receive(&p,&udp_receiver,&!datagram,1,1).status==105)
    byte_buffer_close(packet)
    byte_buffer_close(datagram)
    assert(native_socket_close(&p,udp_sender)==0)
    assert(native_socket_close(&p,udp_receiver)==0)
    assert(platform_call(&p,3,0,0,0,0).value==0)
    platform_close(p)
    println("MASSIVE_PLATFORM_OK")
    return 0
}
