//@ run-pass
//@ expect-stdout: CSV_STRICT_OFFSETS_OK
use data::csv_reader::{csv_open,csv_ok,csv_next_row,csv_int,csv_syntax_status,csv_error_offset,csv_validate_syntax}
fn at(text:string,prefix:string) with Mut,Panic,Div {
    let syntax=csv_validate_syntax(text)
    assert(syntax.status==22 && syntax.error_offset==str_len(prefix))
    let r=csv_open(text)
    assert(csv_syntax_status(&r)==22)
    assert(csv_error_offset(&r)==str_len(prefix))
}
fn main()->i32 with IO,Mut,Panic,Div {
    at("a,b\n1,\"x","a,b\n1,\"x")
    at("a,b\n1,x\"y\n","a,b\n1,x")
    at("a,b\n1,\"x\"tail\n","a,b\n1,\"x\"")
    at("a,b\r1,2\n","a,b")
    at("α,b\n1,x\"y\n","α,b\n1,x")
    var r=csv_open("x,y\nnot-an-integer,1\n2,3\n")
    assert(csv_syntax_status(&r)==0 && csv_error_offset(&r)==0)
    assert(csv_next_row(&!r))
    assert(csv_int(&!r,0)==0 && !csv_ok(&r))
    assert(csv_syntax_status(&r)==0)
    assert(csv_next_row(&!r))
    assert(csv_int(&!r,0)==2 && csv_ok(&r))
    assert(!csv_next_row(&!r))
    println("CSV_STRICT_OFFSETS_OK")
    0
}

