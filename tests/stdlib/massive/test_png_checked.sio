//@ run-pass
//@ requires: madaros
//@ expect-stdout: PNG_CHECKED_OK
use graphics::png::{png_write_chunk,png_write_ihdr,png_write_sig,png_encode_surface,png_encode_surface_rgba}
use graphics::surface::{surface_new}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var data:[i8;32800]=[0;32800]
 let kind:[i8;4]=[73 as i8,68 as i8,65 as i8,84 as i8]
 assert(!png_write_chunk("must-not-be-created.png",kind,&data,32789))
 assert(!png_write_chunk("must-not-be-created.png",kind,&data,0-1))
 assert(!png_write_ihdr("must-not-be-created.png",0,10,2 as i8))
 assert(!png_write_ihdr("must-not-be-created.png",10,10,3 as i8))
 let invalid=surface_new(65536,65536)
 assert(!png_encode_surface(&invalid,"must-not-be-created.png"))
 assert(!png_encode_surface_rgba(&invalid,"must-not-be-created.png"))
 let row=surface_new(32768,2)
 assert(!png_encode_surface(&row,"must-not-be-created.png"))
 assert(!png_write_sig("directory-that-does-not-exist/output.png"))
 println("PNG_CHECKED_OK")
 return 0
}
