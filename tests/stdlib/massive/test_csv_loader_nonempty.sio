//@ run-pass
//@ expect-stdout: CSV_LOADER_NONEMPTY_OK
use data::csv_loader::*;
fn abs(x:f64)->f64 {if x<0.0 {0.0-x} else {x}}
fn edges_len(edges:[Edge])->usize {edges.len()}
fn neighbors_len(neighbors:[usize])->usize {neighbors.len()}
fn weighted_len(neighbors:[WeightedEdge])->usize {neighbors.len()}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let empty=parse_edge_list("# comment\n\n")
 assert(empty.num_nodes==0 && edges_len(empty.edges)==0)
 let net=parse_edge_list(" # comment\n 0 , 1 , 0.5 \n1,2,0.7\n2,0,-0.3\n")
 assert(net.num_nodes==3 && edges_len(net.edges)==3 && net.weighted)
 assert(abs(net.edges[0].weight-0.5)<0.000000000001)
 assert(abs(net.edges[1].weight-0.7)<0.000000000001)
 assert(abs(net.edges[2].weight+0.3)<0.000000000001)
 assert(validate_edge_list(&net))
 let adjacency=to_adjacency_list(&net)
 assert(adjacency.len()==3 && neighbors_len(adjacency[0])==2 && neighbors_len(adjacency[1])==2 && neighbors_len(adjacency[2])==2)
 let weighted=to_weighted_adjacency(&net)
 assert(weighted.len()==3 && weighted_len(weighted[0])==2)
 assert(weighted[0][0].neighbor==1 && abs(weighted[0][0].weight-0.5)<0.000000000001)
 assert(weighted[0][1].neighbor==2 && abs(weighted[0][1].weight+0.3)<0.000000000001)
 let plain=parse_edge_list("0,1\n1,2\n")
 assert(!plain.weighted && plain.num_nodes==3 && edges_len(plain.edges)==2)
 var invalid=plain
 invalid.num_nodes=1
 assert(!validate_edge_list(&invalid))
 let content="0,1\n1,2\n"
 var raw:[i8;64]=[0;64]
 var i:i64=0
 while i<str_len(content) {raw[i]=str_char_at(content,i) as i8;i=i+1}
 assert(write_file("/tmp/sounio_api_csv_loader.csv",raw,str_len(content))==str_len(content))
 let loaded=load_edge_list("/tmp/sounio_api_csv_loader.csv")
 assert(loaded.num_nodes==3 && edges_len(loaded.edges)==2 && !loaded.weighted)
 println("CSV_LOADER_NONEMPTY_OK")
 0
}
