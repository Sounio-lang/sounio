//@ run-pass
//@ expect-stdout: DATABASE_CONTROLS_OK
use database::pure::types::{InMemoryDB,in_memory_db_new}
use database::pure::engine::{engine_create_table,engine_insert_row,engine_get_cell,engine_table_row_count,engine_drop_table}
fn main()->i32 with IO,Mut,Panic {
 var db=in_memory_db_new()
 assert(engine_create_table(&!db,"users")==1)
 assert(engine_create_table(&!db,"users")==0)
 assert(engine_table_row_count(&db,"missing")<0)
 assert(engine_insert_row(&!db,"missing",1,2)==0-1)
 assert(engine_insert_row(&!db,"users",7,42)==1)
 assert(engine_get_cell(&db,"users",0,0)==7 && engine_get_cell(&db,"users",0,1)==42)
 assert(engine_get_cell(&db,"users",99,1)==0-1)
 assert(engine_get_cell(&db,"users",0,4)==0-1 && engine_get_cell(&db,"users",0-1,0)==0-1)
 assert(engine_drop_table(&!db,"users")==1)
 assert(engine_drop_table(&!db,"users")==0-1)
 println("DATABASE_CONTROLS_OK")
 0
}
