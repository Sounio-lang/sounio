//@ run-pass
//@ expect-stdout: CSV_STRICT_OK
use data::csv_reader::{csv_open,csv_ok,csv_next_row}
fn rejected(text:string)->bool with Mut,Panic,Div {
    var r=csv_open(text)
    if csv_ok(&r) { return false }
    return !csv_next_row(&!r)
}
fn accepted(text:string)->bool with Mut,Panic,Div {
    let r=csv_open(text)
    return csv_ok(&r)
}
fn main()->i32 with IO,Mut,Panic,Div {
    assert(rejected("a,b\n1,\"x"))
    assert(rejected("a,b\n1,x\"y\n"))
    assert(rejected("a,b\n1,\"x\"tail\n"))
    assert(rejected("a,b\r1,2\n"))
    assert(rejected("\"a\"x,b\n1,2\n"))
    assert(accepted(""))
    assert(accepted("a,b\n1,2"))
    assert(accepted("a,b\r\n1,\"x,y\"\r\n"))
    assert(accepted("a,b\n1,\"a\"\"b\"\n"))
    assert(accepted("a,b\n1,\"a\nb\"\n"))
    assert(accepted("a,b\n1,"))
    assert(accepted("a,b\n1,2,3\n"))
    println("CSV_STRICT_OK")
    0
}

