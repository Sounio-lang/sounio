//@ run-pass
//@ expect-stdout: LOGIC_BOX_PROJECTION_OK
use logic::pure::types::{Proposition,assignment_new,assignment_set,proposition_evaluate}
fn main()->i32 with IO,Alloc,Mut,Panic {
 var a=assignment_new()
 assignment_set(&!a,"flag",true);assignment_set(&!a,"other",true)
 let leaf=Proposition::Var("flag")
 let neg=Proposition::Not(Box::new(leaf))
 assert(!proposition_evaluate(&neg,&a))
 let both=Proposition::And(Box::new(neg),Box::new(Proposition::Var("other")))
 assert(!proposition_evaluate(&both,&a))
 assignment_set(&!a,"flag",false)
 assert(proposition_evaluate(&both,&a))
 assignment_set(&!a,"other",false)
 assert(!proposition_evaluate(&both,&a))
 println("LOGIC_BOX_PROJECTION_OK");0
}
