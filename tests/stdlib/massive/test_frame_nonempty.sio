//@ run-pass
//@ expect-stdout: FRAME_NONEMPTY_OK
use data::frame::*;
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let empty=dataframe_new()
 var df=empty
 var xs:[f64]=[]
 xs=xs ++ [1.0,2.0,3.0]
 var ids:[i64]=[]
 ids=ids ++ [10,20,30]
 var labels:[string]=[]
 labels=labels ++ ["a","b","c"]
 df=dataframe_add_column(df,column_float("x",xs))
 df=dataframe_add_column(df,column_int("id",ids))
 df=dataframe_add_column(df,column_string("label",labels))
 assert(dataframe_ncols(empty)==0)
 assert(dataframe_ncols(df)==3 && dataframe_nrows(df)==3)
 assert(dataframe_col_sum(df,"x")==6.0 && dataframe_col_sum(df,"id")==60.0)
 assert(dataframe_col_mean(df,"x")==2.0)
 let row=dataframe_get_row(df,1)
 assert(row_get_float(row,"x")==2.0 && row_get_string(row,"label")=="b")
 assert(row_get_float(row,"absent")==0.0)
 assert(!dataframe_has_column(df,"absent") && column_len(dataframe_get_column(df,"absent"))==0)
 let cut=dataframe_slice(df,1,3)
 assert(dataframe_nrows(cut)==2 && row_get_float(dataframe_get_row(cut,0),"x")==2.0)
 var mask:[bool]=[]
 mask=mask ++ [false,true,false]
 let filtered=dataframe_filter(df,mask)
 assert(dataframe_nrows(filtered)==1 && row_get_string(dataframe_get_row(filtered,0),"label")=="b")
 assert(dataframe_ncols(dataframe_drop_column(df,"x"))==2)
 assert(dataframe_ncols(dataframe_drop_column(df,"absent"))==3)
 assert(dataframe_nrows(dataframe_head(df,10))==3)
 assert(row_get_float(dataframe_get_row(dataframe_tail(df,1),0),"x")==3.0)
 assert(str_len(dataframe_info(df))>0)
 var wide=dataframe_new()
 var i:i64=0
 while i<80 {
  var one:[i64]=[]
  one=one ++ [i]
  wide=dataframe_add_column(wide,column_int("value",one))
  i=i+1
 }
 assert(dataframe_ncols(wide)==80 && dataframe_nrows(wide)==1)
 assert(dataframe_get_column_idx(wide,0).int_data[0]==0)
 assert(dataframe_get_column_idx(wide,40).int_data[0]==40)
 assert(dataframe_get_column_idx(wide,79).int_data[0]==79)
 println("FRAME_NONEMPTY_OK")
 0
}
