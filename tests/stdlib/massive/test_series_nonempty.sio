//@ run-pass
use data::series::{float_series_from, float_series_push, float_series_len, float_series_get, float_series_sum, float_series_mean, float_series_variance, float_series_min, float_series_max, int_series_new, int_series_push, int_series_len, int_series_get, int_series_sum, int_series_to_float, string_series_new, string_series_push, string_series_len, string_series_get, bool_series_from, bool_series_count_true, float_series_filter}
fn main() -> i32 with IO, Mut, Panic, Div {
    let a = float_series_from("a", [1.0, 2.0, 3.0])
    let b = float_series_push(a, 4.0)
    assert(float_series_len(a) == 3)
    assert(float_series_len(b) == 4)
    assert(float_series_get(b, 3) == 4.0)
    assert(float_series_sum(b) == 10.0)
    assert(float_series_mean(a) == 2.0)
    assert(float_series_variance(a) == 1.0)
    assert(float_series_min(a) == 1.0)
    assert(float_series_max(a) == 3.0)
    assert(float_series_get(a, 99) == 0.0)
    let selected = float_series_filter(a, bool_series_from("mask", [true, false, true]))
    assert(float_series_len(selected) == 2)
    assert(float_series_get(selected, 1) == 3.0)
    assert(bool_series_count_true(bool_series_from("mask", [true, false, true])) == 2)
    var ints = int_series_new("wide")
    var i:i64 = 0
    while i < 80 { ints = int_series_push(ints, i); i = i + 1 }
    assert(int_series_len(ints) == 80)
    assert(int_series_get(ints, 0) == 0)
    assert(int_series_get(ints, 40) == 40)
    assert(int_series_get(ints, 79) == 79)
    assert(int_series_get(ints, 80) == 0)
    assert(int_series_sum(ints) == 3160)
    assert(float_series_get(int_series_to_float(ints), 79) == 79.0)
    let s0 = string_series_new("text")
    let s1 = string_series_push(s0, "alpha")
    let s2 = string_series_push(s1, "beta")
    assert(string_series_len(s0) == 0)
    assert(string_series_len(s1) == 1)
    assert(string_series_len(s2) == 2)
    assert(string_series_get(s2, 1) == "beta")
    assert(string_series_get(s2, 2) == "")
    println("SERIES_NONEMPTY_OK")
    0
}
