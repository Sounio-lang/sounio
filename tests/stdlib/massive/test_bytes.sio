//@ run-pass
//@ requires: madaros
//@ expect-stdout: MASSIVE_BYTES_OK
use collections::byte_buffer::{byte_buffer_new, byte_buffer_len, byte_buffer_capacity, byte_buffer_push, byte_buffer_get, byte_buffer_utf8_count, byte_buffer_clear, byte_buffer_close}

fn main() -> i32 with IO, Alloc, Mut, Div, Panic {
    var b = byte_buffer_new(8192)
    var i:i64 = 0
    while i < 5000 { assert(byte_buffer_push(&!b, 65) == 0); i = i + 1 }
    assert(byte_buffer_len(&b) == 5000)
    assert(byte_buffer_get(&b, 4999).value == 65)
    assert(byte_buffer_get(&b, 5000).status == 4)
    assert(byte_buffer_utf8_count(&b).value == 5000)
    let old_capacity = byte_buffer_capacity(&b)
    assert(byte_buffer_push(&!b, 256) == 1)
    assert(byte_buffer_len(&b) == 5000)
    assert(byte_buffer_capacity(&b) == old_capacity)
    byte_buffer_clear(&!b)
    assert(byte_buffer_push(&!b, 240) == 0)
    assert(byte_buffer_push(&!b, 159) == 0)
    assert(byte_buffer_push(&!b, 152) == 0)
    assert(byte_buffer_push(&!b, 128) == 0)
    assert(byte_buffer_utf8_count(&b).value == 1)
    byte_buffer_clear(&!b)
    assert(byte_buffer_push(&!b, 192) == 0)
    assert(byte_buffer_utf8_count(&b).status == 5)
    byte_buffer_close(b)
    var empty = byte_buffer_new(0)
    assert(byte_buffer_push(&!empty, 0) == 2)
    byte_buffer_close(empty)
    println("MASSIVE_BYTES_OK")
    return 0
}
