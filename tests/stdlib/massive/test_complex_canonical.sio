//@ run-pass
//@ requires: madaros
//@ expect-stdout: COMPLEX_CANONICAL_OK
use complex::lib::*
use io::sci_print::{print_f64_sci,println_f64_sci}
fn emit(tag:string,z:Complex) with IO,Mut {
 print(tag);print(" ");print_f64_sci(z.re,14);print(" ");println_f64_sci(z.im,14)
}
fn main()->i32 with IO,Mut,Div,Panic {
 let a=complex_new(1.0,2.0);let b=complex_new(3.0,4.0)
 emit("MUL",complex_mul(a,b));emit("DIV",complex_div(a,b))
 emit("EULER",complex_add(complex_exp(complex_new(0.0,3.141592653589793)),complex_one()))
 emit("EXP10",complex_exp(complex_new(10.0,0.5)))
 emit("LN_E",complex_log(complex_new(2.718281828459045,0.0)))
 emit("SQ_NEG",complex_sqrt(complex_new(0.0-1.0,0.0)))
 emit("SQ_GENERAL",complex_sqrt(complex_new(3.0,4.0)))
 emit("SIN_I",complex_sin(complex_new(0.0,1.0)))
 emit("COS_GENERAL",complex_cos(complex_new(0.5,0.75)))
 emit("POW_REAL",complex_pow_real(complex_new(1.5,0.0-0.25),2.5))
 emit("HYPER_SIN",complex_sinh(complex_new(0.25,0.75)))
 let roots=complex_quadratic_roots(1.0,0.0,1.0)
 emit("QUAD1",roots.r1);emit("QUAD2",roots.r2)
 println("COMPLEX_CANONICAL_OK");return 0
}

