//@ run-pass
//@ ignore
// Tests for stdlib/constants/lib.sio
// Validates mathematical and physical constants against known identities.

use constants::*

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn check_near(got: f64, expected: f64, tol: f64) -> bool {
    let d = got - expected
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn check_rel(got: f64, expected: f64, rel_tol: f64) -> bool {
    let d = got - expected
    let ad = if d < 0.0 { 0.0 - d } else { d }
    let scale = if expected < 0.0 { 0.0 - expected } else { expected }
    if scale < 1.0e-300 { return ad < 1.0e-10 }
    return ad / scale < rel_tol
}

fn run_tests() -> i32 with Mut, Panic {
    var fail = 0

    // ---- Mathematical constants ----

    // PI ≈ 3.14159265358979
    if !check_near(PI, 3.141592653589793, 1.0e-13) { fail = fail + 1 }

    // E ≈ 2.71828182845905
    if !check_near(E, 2.718281828459045, 1.0e-13) { fail = fail + 1 }

    // LN2 ≈ 0.693147
    if !check_near(LN2, 0.6931471805599453, 1.0e-14) { fail = fail + 1 }

    // LN10 ≈ 2.302585
    if !check_near(LN10, 2.302585092994046, 1.0e-13) { fail = fail + 1 }

    // SQRT2 ≈ 1.41421
    if !check_near(SQRT2, 1.4142135623730951, 1.0e-13) { fail = fail + 1 }

    // SQRT3 ≈ 1.73205
    if !check_near(SQRT3, 1.7320508075688772, 1.0e-13) { fail = fail + 1 }

    // PHI = (1 + sqrt(5)) / 2 ≈ 1.61803
    if !check_near(PHI, 1.618033988749895, 1.0e-13) { fail = fail + 1 }

    // ---- Physical constants ----

    // SPEED_OF_LIGHT = exactly 299792458.0 m/s
    if SPEED_OF_LIGHT != 299792458.0 { fail = fail + 1 }

    // PLANCK ≈ 6.62607015e-34 J·s
    if !check_rel(PLANCK, 6.62607015e-34, 1.0e-10) { fail = fail + 1 }

    // HBAR = h / (2π): verify ħ = h/(2π) identity
    // Expected: 6.62607015e-34 / (2 * 3.141592653589793) ≈ 1.054571817e-34
    let hbar_derived = PLANCK / (2.0 * PI)
    if !check_rel(HBAR, hbar_derived, 1.0e-8) { fail = fail + 1 }

    // BOLTZMANN ≈ 1.380649e-23 J/K
    if !check_rel(BOLTZMANN, 1.380649e-23, 1.0e-10) { fail = fail + 1 }

    // AVOGADRO ≈ 6.02214076e23 1/mol
    if !check_rel(AVOGADRO, 6.02214076e23, 1.0e-10) { fail = fail + 1 }

    // GAS_CONSTANT: R = k_B * N_A (molar gas constant identity)
    // R = 1.380649e-23 * 6.02214076e23 = 8.314462618 J/(mol·K)
    let r_derived = BOLTZMANN * AVOGADRO
    if !check_rel(GAS_CONSTANT, r_derived, 1.0e-6) { fail = fail + 1 }

    // GAS_CONSTANT ≈ 8.314462618
    if !check_near(GAS_CONSTANT, 8.314462618, 1.0e-7) { fail = fail + 1 }

    // ELECTRON_MASS ≈ 9.1093837015e-31 kg
    if !check_rel(ELECTRON_MASS, 9.1093837015e-31, 1.0e-10) { fail = fail + 1 }

    // PROTON_MASS ≈ 1.67262192369e-27 kg
    if !check_rel(PROTON_MASS, 1.67262192369e-27, 1.0e-10) { fail = fail + 1 }

    // ELEMENTARY_CHARGE ≈ 1.602176634e-19 C
    if !check_rel(ELEMENTARY_CHARGE, 1.602176634e-19, 1.0e-10) { fail = fail + 1 }

    // GRAVITATIONAL ≈ 6.67430e-11 m³/(kg·s²)
    if !check_rel(GRAVITATIONAL, 6.67430e-11, 1.0e-5) { fail = fail + 1 }

    // VACUUM_PERMITTIVITY ≈ 8.8541878128e-12 F/m
    if !check_rel(VACUUM_PERMITTIVITY, 8.8541878128e-12, 1.0e-10) { fail = fail + 1 }

    // ---- Conversion factors ----

    // DEG_TO_RAD * 180 ≈ PI
    let pi_from_deg = DEG_TO_RAD * 180.0
    if !check_near(pi_from_deg, PI, 1.0e-12) { fail = fail + 1 }

    // RAD_TO_DEG * PI ≈ 180
    let deg_from_rad = RAD_TO_DEG * PI
    if !check_near(deg_from_rad, 180.0, 1.0e-10) { fail = fail + 1 }

    // DEG_TO_RAD * RAD_TO_DEG ≈ 1 (inverse relationship)
    let product = DEG_TO_RAD * RAD_TO_DEG
    if !check_near(product, 1.0, 1.0e-13) { fail = fail + 1 }

    // ATM_TO_PA = exactly 101325.0
    if ATM_TO_PA != 101325.0 { fail = fail + 1 }

    // EV_TO_JOULE ≈ 1.602176634e-19 J (same as elementary charge in SI)
    if !check_rel(EV_TO_JOULE, 1.602176634e-19, 1.0e-10) { fail = fail + 1 }

    // EV_TO_JOULE = ELEMENTARY_CHARGE (by definition)
    if !check_rel(EV_TO_JOULE, ELEMENTARY_CHARGE, 1.0e-13) { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Panic {
    return run_tests()
}
