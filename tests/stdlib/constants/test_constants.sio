//@ run-pass
// Tests for stdlib/constants/lib.sio
// Validates mathematical and physical constants against known identities.
// Note: constants use a units-aware type; cast to f64 for comparison.

use constants::lib::*

fn check_near(got: f64, expected: f64, tol: f64) -> bool {
    let d = got - expected
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn check_rel(got: f64, expected: f64, rel_tol: f64) -> bool with Div {
    let d = got - expected
    let ad = if d < 0.0 { 0.0 - d } else { d }
    let scale = if expected < 0.0 { 0.0 - expected } else { expected }
    if scale < 1.0e-300 { return ad < 1.0e-10 }
    return ad / scale < rel_tol
}

fn run_tests() -> i32 with IO, Mut, Div, Panic {
    var fail: i32 = 0

    // ---- Mathematical constants ----

    // PI ≈ 3.14159265358979
    if !check_near(PI as f64, 3.141592653589793, 1.0e-13) {
        println("FAIL: PI")
        fail = fail + 1
    }

    // E ≈ 2.71828182845905
    if !check_near(E as f64, 2.718281828459045, 1.0e-13) {
        println("FAIL: E")
        fail = fail + 1
    }

    // LN_2 ≈ 0.693147
    if !check_near(LN_2 as f64, 0.6931471805599453, 1.0e-14) {
        println("FAIL: LN_2")
        fail = fail + 1
    }

    // LN_10 ≈ 2.302585
    if !check_near(LN_10 as f64, 2.302585092994046, 1.0e-13) {
        println("FAIL: LN_10")
        fail = fail + 1
    }

    // SQRT_2 ≈ 1.41421
    if !check_near(SQRT_2 as f64, 1.4142135623730951, 1.0e-13) {
        println("FAIL: SQRT_2")
        fail = fail + 1
    }

    // SQRT_3 ≈ 1.73205
    if !check_near(SQRT_3 as f64, 1.7320508075688772, 1.0e-13) {
        println("FAIL: SQRT_3")
        fail = fail + 1
    }

    // PHI = (1 + sqrt(5)) / 2 ≈ 1.61803
    if !check_near(PHI as f64, 1.618033988749895, 1.0e-13) {
        println("FAIL: PHI")
        fail = fail + 1
    }

    // ---- Physical constants ----

    // C = speed of light = exactly 299792458.0 m/s
    let c_val: f64 = C as f64
    if c_val != 299792458.0 {
        println("FAIL: C")
        fail = fail + 1
    }

    // H (Planck) ≈ 6.62607015e-34 J·s
    if !check_rel(H as f64, 6.62607015e-34, 1.0e-10) {
        println("FAIL: H")
        fail = fail + 1
    }

    // HBAR = h / (2PI): verify identity
    let pi_val: f64 = PI as f64
    let h_val: f64 = H as f64
    let hbar_derived = h_val / (2.0 * pi_val)
    if !check_rel(HBAR as f64, hbar_derived, 1.0e-8) {
        println("FAIL: HBAR")
        fail = fail + 1
    }

    // K_B (Boltzmann) ≈ 1.380649e-23 J/K
    if !check_rel(K_B as f64, 1.380649e-23, 1.0e-10) {
        println("FAIL: K_B")
        fail = fail + 1
    }

    // N_A (Avogadro) ≈ 6.02214076e23 1/mol
    if !check_rel(N_A as f64, 6.02214076e23, 1.0e-10) {
        println("FAIL: N_A")
        fail = fail + 1
    }

    // R_GAS = K_B * N_A (molar gas constant identity)
    let kb_val: f64 = K_B as f64
    let na_val: f64 = N_A as f64
    let r_derived = kb_val * na_val
    if !check_rel(R_GAS as f64, r_derived, 1.0e-12) {
        println("FAIL: R_GAS identity")
        fail = fail + 1
    }

    // R_GAS = 8.31446261815324 (exact by SI 2019 definition)
    if !check_near(R_GAS as f64, 8.31446261815324, 1.0e-13) {
        println("FAIL: R_GAS value")
        fail = fail + 1
    }

    // GAS_CONSTANT alias matches R_GAS
    let gas_const: f64 = GAS_CONSTANT as f64
    if !check_near(gas_const, 8.31446261815324, 1.0e-13) {
        println("FAIL: GAS_CONSTANT alias")
        fail = fail + 1
    }

    // M_ELECTRON ≈ 9.1093837015e-31 kg
    if !check_rel(M_ELECTRON as f64, 9.1093837015e-31, 1.0e-10) {
        println("FAIL: M_ELECTRON")
        fail = fail + 1
    }

    // M_PROTON ≈ 1.67262192369e-27 kg
    if !check_rel(M_PROTON as f64, 1.67262192369e-27, 1.0e-10) {
        println("FAIL: M_PROTON")
        fail = fail + 1
    }

    // E_CHARGE ≈ 1.602176634e-19 C
    if !check_rel(E_CHARGE as f64, 1.602176634e-19, 1.0e-10) {
        println("FAIL: E_CHARGE")
        fail = fail + 1
    }

    // G (Gravitational) ≈ 6.67430e-11 m^3/(kg*s^2)
    if !check_rel(G as f64, 6.67430e-11, 1.0e-5) {
        println("FAIL: G")
        fail = fail + 1
    }

    // EPSILON_0 (Vacuum permittivity) ≈ 8.8541878128e-12 F/m
    if !check_rel(EPSILON_0 as f64, 8.8541878128e-12, 1.0e-10) {
        println("FAIL: EPSILON_0")
        fail = fail + 1
    }

    // ---- Conversion factors ----

    // DEG_TO_RAD * 180 ≈ PI
    let dtr: f64 = DEG_TO_RAD as f64
    let rtd: f64 = RAD_TO_DEG as f64
    let pi_from_deg = dtr * 180.0
    if !check_near(pi_from_deg, pi_val, 1.0e-12) {
        println("FAIL: DEG_TO_RAD")
        fail = fail + 1
    }

    // RAD_TO_DEG * PI ≈ 180
    let deg_from_rad = rtd * pi_val
    if !check_near(deg_from_rad, 180.0, 1.0e-10) {
        println("FAIL: RAD_TO_DEG")
        fail = fail + 1
    }

    // DEG_TO_RAD * RAD_TO_DEG ≈ 1 (inverse relationship)
    let product = dtr * rtd
    if !check_near(product, 1.0, 1.0e-13) {
        println("FAIL: DEG/RAD inverse")
        fail = fail + 1
    }

    // ATM_TO_PA = exactly 101325.0
    let atm: f64 = ATM_TO_PA as f64
    if atm != 101325.0 {
        println("FAIL: ATM_TO_PA")
        fail = fail + 1
    }

    // EV_TO_JOULE ≈ 1.602176634e-19 J (same as elementary charge in SI)
    if !check_rel(EV_TO_JOULE as f64, 1.602176634e-19, 1.0e-10) {
        println("FAIL: EV_TO_JOULE")
        fail = fail + 1
    }

    // EV_TO_JOULE = E_CHARGE (by definition)
    let echarge_val: f64 = E_CHARGE as f64
    if !check_rel(EV_TO_JOULE as f64, echarge_val, 1.0e-13) {
        println("FAIL: EV_TO_JOULE == E_CHARGE")
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let result = run_tests()
    if result == 0 {
        println("constants: all tests PASSED")
    } else {
        println("constants: some tests FAILED")
    }
    return result
}
