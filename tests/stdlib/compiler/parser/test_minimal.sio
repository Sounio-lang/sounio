//@ run-pass
// Minimal parser test

fn TK_EOF() -> i32 { 0 }
fn TK_INT() -> i32 { 201 }
fn TK_PLUS() -> i32 { 220 }

fn PREC_NONE() -> i32 { 0 }
fn PREC_ADD() -> i32 { 10 }

fn get_prec(kind: i32) -> i32 {
    if kind == TK_PLUS() {
        return PREC_ADD()
    }
    PREC_NONE()
}

struct Token {
    kind: i32,
    val: i64,
}

fn token_new() -> Token {
    Token { kind: TK_EOF(), val: 0 }
}

struct State {
    tokens: [Token; 16],
    n: i64,
    pos: i64,
}

fn state_new() -> State {
    State {
        tokens: [token_new(); 16],
        n: 0,
        pos: 0,
    }
}

fn peek(s: State) -> i32 {
    if s.pos < s.n {
        s.tokens[s.pos as usize].kind
    } else {
        TK_EOF()
    }
}

fn advance(s: State) -> State  with Mut{
    var new_s = s;
    if new_s.pos < new_s.n {
        new_s.pos = new_s.pos + 1;
    }
    new_s
}

struct Expr {
    is_binary: bool,
    val: i64,
}

fn expr_lit(v: i64) -> Expr {
    Expr { is_binary: false, val: v }
}

fn expr_bin() -> Expr {
    Expr { is_binary: true, val: 0 }
}

struct ParseResult {
    state: State,
    expr: Expr,
    ok: bool,
}

fn parse_ok(s: State, e: Expr) -> ParseResult {
    ParseResult { state: s, expr: e, ok: true }
}

fn parse_err(s: State) -> ParseResult {
    ParseResult { state: s, expr: expr_lit(0), ok: false }
}

fn parse_primary(s: State) -> ParseResult  with IO, Mut, Panic, Div{
    var st = s;
    let curr = peek(st);
    print("  parse_primary: kind=");
    if curr == TK_INT() {
        print("INT\n");
        let v = st.tokens[st.pos as usize].val;
        st = advance(st);
        return parse_ok(st, expr_lit(v))
    }
    if curr == TK_EOF() {
        print("EOF\n");
    } else {
        print("OTHER\n");
    }
    parse_err(st)
}

fn parse_expr_prec(s: State, min_prec: i32) -> ParseResult  with IO, Mut, Panic, Div{
    var st = s;

    let left = parse_primary(st);
    if !left.ok {
        return left
    }
    st = left.state;
    var left_expr = left.expr;

    while true {
        let op = peek(st);
        let prec = get_prec(op);

        if prec < min_prec {
            break
        }

        st = advance(st);

        let right = parse_expr_prec(st, prec + 1);
        if !right.ok {
            return right
        }
        st = right.state;

        left_expr = expr_bin();
    }

    parse_ok(st, left_expr)
}

fn parse_expr(s: State) -> ParseResult  with IO, Mut, Panic, Div{
    parse_expr_prec(s, 1)
}

fn make_int_token(v: i64) -> Token {
    Token { kind: TK_INT(), val: v }
}

fn make_plus_token() -> Token {
    Token { kind: TK_PLUS(), val: 0 }
}

fn test_simple() -> bool  with IO, Mut, Panic, Div{
    var st = state_new();
    // Construct tokens and assign whole struct
    st.tokens[0] = make_int_token(1);
    st.tokens[1] = make_plus_token();
    st.tokens[2] = make_int_token(2);
    st.n = 3;

    print("  setup: tokens[0].kind = ");
    if st.tokens[0].kind == TK_INT() {
        print("INT\n");
    } else {
        print("OTHER\n");
    }

    let result = parse_expr(st);

    if !result.ok {
        print("  Parse failed\n");
        return false
    }

    if !result.expr.is_binary {
        print("  Expected binary\n");
        return false
    }

    true
}

fn main() -> i32 with IO {
    print("Minimal parser test...\n");

    if test_simple() {
        print("PASS\n");
        0
    } else {
        print("FAIL\n");
        1
    }
}
