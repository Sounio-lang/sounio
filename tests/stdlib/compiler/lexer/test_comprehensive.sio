// TEST 8: LINEAR TYPES
// ============================================================================

/// Test: "linear struct FileHandle { fd: i32 }"
fn test_linear_types() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "linear struct FileHandle { fd: i32 }"
    // l=108, i=105, n=110, e=101, a=97, r=114
    source[0] = 108; source[1] = 105; source[2] = 110;
    source[3] = 101; source[4] = 97; source[5] = 114;  // linear
    source[6] = 32;  // space
    source[7] = 115; source[8] = 116; source[9] = 114;
    source[10] = 117; source[11] = 99; source[12] = 116;  // struct
    source[13] = 32;  // space
    // FileHandle
    source[14] = 70; source[15] = 105; source[16] = 108; source[17] = 101;  // File
    source[18] = 72; source[19] = 97; source[20] = 110;
    source[21] = 100; source[22] = 108; source[23] = 101;  // Handle
    source[24] = 32; source[25] = 123; source[26] = 32;  // space { space
    source[27] = 102; source[28] = 100;  // fd
    source[29] = 58; source[30] = 32;  // : space
    source[31] = 105; source[32] = 51; source[33] = 50;  // i32
    source[34] = 32; source[35] = 125;  // space }
    let source_len: i64 = 36;

    // Expected: linear (TK_LINEAR), struct, FileHandle, {, fd, :, i32, }, EOF
    true
}

// ============================================================================
// TEST 9: MATCH EXPRESSIONS WITH PATTERNS
// ============================================================================

/// Test: "match x { 0 => false, _ => true }"
fn test_match_expression() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "match x { 0 => false, _ => true }"
    source[0] = 109; source[1] = 97; source[2] = 116;
    source[3] = 99; source[4] = 104;  // match
    source[5] = 32;  // space
    source[6] = 120;  // x
    source[7] = 32; source[8] = 123; source[9] = 32;  // space { space
    source[10] = 48;  // 0
    source[11] = 32;  // space
    source[12] = 61; source[13] = 62;  // =>
    source[14] = 32;  // space
    source[15] = 102; source[16] = 97; source[17] = 108;
    source[18] = 115; source[19] = 101;  // false
    source[20] = 44; source[21] = 32;  // , space
    source[22] = 95;  // _
    source[23] = 32;  // space
    source[24] = 61; source[25] = 62;  // =>
    source[26] = 32;  // space
    source[27] = 116; source[28] = 114; source[29] = 117; source[30] = 101;  // true
    source[31] = 32; source[32] = 125;  // space }
    let source_len: i64 = 33;

    // Expected: match, x, {, 0 (INT_LIT), => (FAT_ARROW), false, ,,
    //          _ (IDENT), =>, true, }, EOF
    true
}

// ============================================================================
// TEST 10: COMPLEX OPERATORS
// ============================================================================

/// Test: "a && b || c == d != e <= f >= g"
fn test_complex_operators() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "a && b || c == d != e <= f >= g"
    source[0] = 97; source[1] = 32;  // a space
    source[2] = 38; source[3] = 38;  // &&
    source[4] = 32;  // space
    source[5] = 98; source[6] = 32;  // b space
    source[7] = 124; source[8] = 124;  // ||
    source[9] = 32;  // space
    source[10] = 99; source[11] = 32;  // c space
    source[12] = 61; source[13] = 61;  // ==
    source[14] = 32;  // space
    source[15] = 100; source[16] = 32;  // d space
    source[17] = 33; source[18] = 61;  // !=
    source[19] = 32;  // space
    source[20] = 101; source[21] = 32;  // e space
    source[22] = 60; source[23] = 61;  // <=
    source[24] = 32;  // space
    source[25] = 102; source[26] = 32;  // f space
    source[27] = 62; source[28] = 61;  // >=
    source[29] = 32;  // space
    source[30] = 103;  // g
    let source_len: i64 = 31;

    // Expected: a, && (AMP_AMP), b, || (PIPE_PIPE), c, == (EQ_EQ),
    //          d, != (NE), e, <= (LE), f, >= (GE), g, EOF
    true
}

// ============================================================================
// TEST 11: SCIENTIFIC DSL KEYWORDS
// ============================================================================

/// Test: "ode Decay { state { x } params { k } }"
fn test_scientific_dsl() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "ode Decay { state { x } params { k } }"
    source[0] = 111; source[1] = 100; source[2] = 101;  // ode
    source[3] = 32;  // space
    source[4] = 68; source[5] = 101; source[6] = 99;
    source[7] = 97; source[8] = 121;  // Decay
    source[9] = 32; source[10] = 123; source[11] = 32;  // space { space
    source[12] = 115; source[13] = 116; source[14] = 97;
    source[15] = 116; source[16] = 101;  // state
    source[17] = 32; source[18] = 123; source[19] = 32;  // space { space
    source[20] = 120;  // x
    source[21] = 32; source[22] = 125; source[23] = 32;  // space } space
    source[24] = 112; source[25] = 97; source[26] = 114;
    source[27] = 97; source[28] = 109; source[29] = 115;  // params
    source[30] = 32; source[31] = 123; source[32] = 32;  // space { space
    source[33] = 107;  // k
    source[34] = 32; source[35] = 125; source[36] = 32; source[37] = 125;  // space } space }
    let source_len: i64 = 38;

    // Expected: ode (TK_ODE), Decay, {, state, {, x, }, params, {, k, }, }, EOF
    true
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> i32 with IO {
    print("Running comprehensive lexer tests...\n\n");

    var passed: i64 = 0;
    var failed: i64 = 0;

    if test_function_signature() {
        print("PASS: test_function_signature\n");
        passed = passed + 1;
    } else {
        print("FAIL: test_function_signature\n");
        failed = failed + 1;
    }

    if test_struct_definition() {
        print("PASS: test_struct_definition\n");
        passed = passed + 1;
    } else {
