// Doc comments
fn TK_DOC_COMMENT_OUTER() -> i32 { 310 }
fn TK_DOC_COMMENT_INNER() -> i32 { 311 }
fn TK_DOC_BLOCK_OUTER() -> i32 { 312 }
fn TK_DOC_BLOCK_INNER() -> i32 { 313 }

// Core keywords
fn TK_MODULE() -> i32 { 10 }
fn TK_IMPORT() -> i32 { 11 }
fn TK_USE() -> i32 { 12 }
fn TK_FN() -> i32 { 14 }
fn TK_LET() -> i32 { 15 }
fn TK_VAR() -> i32 { 16 }
fn TK_CONST() -> i32 { 17 }
fn TK_STRUCT() -> i32 { 20 }
fn TK_ENUM() -> i32 { 21 }
fn TK_TRAIT() -> i32 { 22 }
fn TK_IMPL() -> i32 { 23 }
fn TK_IF() -> i32 { 24 }
fn TK_ELSE() -> i32 { 25 }
fn TK_MATCH() -> i32 { 26 }
fn TK_FOR() -> i32 { 27 }
fn TK_WHILE() -> i32 { 28 }
fn TK_LOOP() -> i32 { 29 }
fn TK_BREAK() -> i32 { 30 }
fn TK_CONTINUE() -> i32 { 31 }
fn TK_RETURN() -> i32 { 32 }
fn TK_TRUE() -> i32 { 39 }
fn TK_FALSE() -> i32 { 40 }
fn TK_PUB() -> i32 { 41 }
fn TK_EXTERN() -> i32 { 45 }

// Effect and linear type keywords
fn TK_EFFECT() -> i32 { 50 }
fn TK_HANDLER() -> i32 { 51 }
fn TK_WITH() -> i32 { 53 }
fn TK_LINEAR() -> i32 { 54 }
fn TK_AFFINE() -> i32 { 55 }
