//@ run-pass
// compiler::lexer::test_comprehensive — Comprehensive lexer test suite
//
// This module provides extensive tests for the self-hosted Sounio lexer
// to ensure it produces identical output to the Rust-based lexer.
//
// Tests cover:
// - Sounio-specific syntax (not Rust patterns)
// - Effect annotations (with IO, Mut, Alloc)
// - Unit literals (500_mg, 10.5_mL)
// - Mutable references (&! not &mut)
// - Kernel syntax for GPU
// - Doc comments (///, //!, /**, /*!)
// - Edge cases and complex tokenization

// ============================================================================
// TOKEN KIND CONSTANTS
// ============================================================================

// Special tokens
fn TK_EOF() -> i32 { 0 }
fn TK_ERROR() -> i32 { 1 }

// Literals
fn TK_IDENT() -> i32 { 200 }
fn TK_INT_LIT() -> i32 { 201 }
fn TK_HEX_LIT() -> i32 { 202 }
fn TK_BIN_LIT() -> i32 { 203 }
fn TK_OCT_LIT() -> i32 { 204 }
fn TK_FLOAT_LIT() -> i32 { 205 }
fn TK_STRING_LIT() -> i32 { 206 }
fn TK_CHAR_LIT() -> i32 { 207 }
fn TK_INT_UNIT_LIT() -> i32 { 208 }
fn TK_FLOAT_UNIT_LIT() -> i32 { 209 }

// Operators
fn TK_PLUS() -> i32 { 220 }
fn TK_MINUS() -> i32 { 221 }
fn TK_STAR() -> i32 { 222 }
fn TK_SLASH() -> i32 { 223 }
