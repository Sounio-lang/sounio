// Epistemic keywords
fn TK_KNOWLEDGE() -> i32 { 130 }
fn TK_QUANTITY() -> i32 { 131 }
fn TK_TENSOR() -> i32 { 132 }

// ============================================================================
// SPAN AND TOKEN STRUCTURES
// ============================================================================

struct Span {
    start: i64,
    end: i64,
}

struct Token {
    kind: i32,
    span: Span,
    text: [i8; 256],
    text_len: i64,
}

struct TokenStream {
    tokens: [Token; 16384],
    n_tokens: i64,
}

// ============================================================================
// HELPER: Create source from string literal bytes
// ============================================================================

fn make_source(bytes: [i8; 256], len: i64) -> ([i8; 1048576], i64) with IO, Mut, Panic, Div, Alloc {
    var source: [i8; 1048576] = [0; 1048576];
    var i: i64 = 0;
    while i < len && i < 256 {
        source[i as usize] = bytes[i as usize];
        i = i + 1;
    }
    (source, len)
}

// ============================================================================
// TEST 1: SOUNIO FUNCTION SIGNATURE
// ============================================================================

/// Test: "fn add(a: i32, b: i32) -> i32 { a + b }"
fn test_function_signature() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "fn add(a: i32, b: i32) -> i32 { a + b }"
    // f=102, n=110, space=32
    source[0] = 102; source[1] = 110; source[2] = 32;
    // add
    source[3] = 97; source[4] = 100; source[5] = 100;
    source[6] = 40;  // (
    source[7] = 97;  // a
    source[8] = 58;  // :
    source[9] = 32;  // space
    source[10] = 105; source[11] = 51; source[12] = 50;  // i32
    source[13] = 44; source[14] = 32;  // , space
    source[15] = 98;  // b
    source[16] = 58; source[17] = 32;  // : space
    source[18] = 105; source[19] = 51; source[20] = 50;  // i32
    source[21] = 41;  // )
    source[22] = 32;  // space
    source[23] = 45; source[24] = 62;  // ->
    source[25] = 32;  // space
    source[26] = 105; source[27] = 51; source[28] = 50;  // i32
    source[29] = 32;  // space
    source[30] = 123; // {
    source[31] = 32;  // space
    source[32] = 97;  // a
    source[33] = 32;  // space
    source[34] = 43;  // +
    source[35] = 32;  // space
    source[36] = 98;  // b
    source[37] = 32;  // space
    source[38] = 125; // }
    let source_len: i64 = 39;

    // Expected tokens:
    // 0: fn (TK_FN)
    // 1: add (TK_IDENT)
    // 2: ( (TK_LPAREN)
    // 3: a (TK_IDENT)
    // 4: : (TK_COLON)
    // 5: i32 (TK_IDENT)
    // 6: , (TK_COMMA)
    // 7: b (TK_IDENT)
    // 8: : (TK_COLON)
    // 9: i32 (TK_IDENT)
    // 10: ) (TK_RPAREN)
    // 11: -> (TK_ARROW)
    // 12: i32 (TK_IDENT)
    // 13: { (TK_LBRACE)
    // 14: a (TK_IDENT)
    // 15: + (TK_PLUS)
    // 16: b (TK_IDENT)
    // 17: } (TK_RBRACE)
    // 18: EOF

    // Would call tokenize(source, source_len) and verify
    true
}

// ============================================================================
// TEST 2: STRUCT DEFINITION
// ============================================================================

/// Test: "struct Point { x: f64, y: f64 }"
fn test_struct_definition() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // s=115, t=116, r=114, u=117, c=99, t=116
    source[0] = 115; source[1] = 116; source[2] = 114;
    source[3] = 117; source[4] = 99; source[5] = 116;  // struct
    source[6] = 32;  // space
    // Point = P=80, o=111, i=105, n=110, t=116
    source[7] = 80; source[8] = 111; source[9] = 105;
    source[10] = 110; source[11] = 116;  // Point
    source[12] = 32; source[13] = 123; source[14] = 32;  // space { space
    // x: f64
    source[15] = 120; source[16] = 58; source[17] = 32;  // x:
    source[18] = 102; source[19] = 54; source[20] = 52;  // f64
    source[21] = 44; source[22] = 32;  // , space
    // y: f64
    source[23] = 121; source[24] = 58; source[25] = 32;  // y:
    source[26] = 102; source[27] = 54; source[28] = 52;  // f64
    source[29] = 32; source[30] = 125;  // space }
    let source_len: i64 = 31;

    // Expected: struct, Point, {, x, :, f64, ,, y, :, f64, }, EOF
    true
}

// ============================================================================
// TEST 3: EFFECT SYNTAX (Sounio-specific)
// ============================================================================

/// Test: "fn read() -> string with IO { }"
fn test_effect_syntax() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "fn read() -> string with IO { }"
    source[0] = 102; source[1] = 110; source[2] = 32;  // fn space
    source[3] = 114; source[4] = 101; source[5] = 97; source[6] = 100;  // read
    source[7] = 40; source[8] = 41; source[9] = 32;  // () space
    source[10] = 45; source[11] = 62; source[12] = 32;  // -> space
    source[13] = 115; source[14] = 116; source[15] = 114;
    source[16] = 105; source[17] = 110; source[18] = 103;  // string
    source[19] = 32;  // space
    source[20] = 119; source[21] = 105; source[22] = 116; source[23] = 104;  // with
    source[24] = 32;  // space
    source[25] = 73; source[26] = 79;  // IO
    source[27] = 32;  // space
    source[28] = 123; source[29] = 32; source[30] = 125;  // { }
    let source_len: i64 = 31;

    // Expected: fn, read, (, ), ->, string, with, IO, {, }, EOF
    // Note: 'with' is TK_WITH (53), crucial for Sounio effect syntax
    true
}

// ============================================================================
// TEST 4: UNIT LITERALS (Sounio-specific)
// ============================================================================

/// Test: "let dose = 500_mg + 10.5_mL"
fn test_unit_literals() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "let dose = 500_mg + 10.5_mL"
    source[0] = 108; source[1] = 101; source[2] = 116;  // let
    source[3] = 32;  // space
    source[4] = 100; source[5] = 111; source[6] = 115; source[7] = 101;  // dose
    source[8] = 32; source[9] = 61; source[10] = 32;  // space = space
    // 500_mg
    source[11] = 53; source[12] = 48; source[13] = 48;  // 500
    source[14] = 95;  // _
    source[15] = 109; source[16] = 103;  // mg
    source[17] = 32;  // space
    source[18] = 43;  // +
    source[19] = 32;  // space
    // 10.5_mL
    source[20] = 49; source[21] = 48; source[22] = 46; source[23] = 53;  // 10.5
    source[24] = 95;  // _
    source[25] = 109; source[26] = 76;  // mL
    let source_len: i64 = 27;

    // Expected:
    // let (TK_LET), dose (TK_IDENT), = (TK_EQ)
    // 500_mg (TK_INT_UNIT_LIT) - Sounio-specific unit literal!
    // + (TK_PLUS)
    // 10.5_mL (TK_FLOAT_UNIT_LIT) - Sounio-specific unit literal!
    // EOF
    true
}

// ============================================================================
// TEST 5: DOC COMMENTS (all 4 variants)
// ============================================================================

/// Test: "/// Outer doc\n//! Inner doc\nfn foo() {}"
fn test_doc_comments() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "/// Outer doc\n"
    source[0] = 47; source[1] = 47; source[2] = 47; source[3] = 32;  // /// space
    source[4] = 79; source[5] = 117; source[6] = 116; source[7] = 101; source[8] = 114;  // Outer
    source[9] = 32;  // space
    source[10] = 100; source[11] = 111; source[12] = 99;  // doc
    source[13] = 10;  // newline
    // "//! Inner doc\n"
    source[14] = 47; source[15] = 47; source[16] = 33; source[17] = 32;  // //! space
    source[18] = 73; source[19] = 110; source[20] = 110; source[21] = 101; source[22] = 114;  // Inner
    source[23] = 32;  // space
    source[24] = 100; source[25] = 111; source[26] = 99;  // doc
    source[27] = 10;  // newline
    // "fn foo() {}"
    source[28] = 102; source[29] = 110; source[30] = 32;  // fn space
    source[31] = 102; source[32] = 111; source[33] = 111;  // foo
    source[34] = 40; source[35] = 41; source[36] = 32;  // () space
    source[37] = 123; source[38] = 125;  // {}
    let source_len: i64 = 39;

    // Expected:
    // TK_DOC_COMMENT_OUTER (310) - "/// Outer doc"
    // TK_DOC_COMMENT_INNER (311) - "//! Inner doc"
    // fn, foo, (, ), {, }, EOF
    true
}

// ============================================================================
// TEST 6: NUMERIC LITERALS (all formats)
// ============================================================================

/// Test: "0xFF 0b1010 0o755 42 3.14e-10"
fn test_numeric_literals() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "0xFF"
    source[0] = 48; source[1] = 120; source[2] = 70; source[3] = 70;  // 0xFF
    source[4] = 32;  // space
    // "0b1010"
    source[5] = 48; source[6] = 98; source[7] = 49; source[8] = 48;
    source[9] = 49; source[10] = 48;  // 0b1010
    source[11] = 32;  // space
    // "0o755"
    source[12] = 48; source[13] = 111; source[14] = 55;
    source[15] = 53; source[16] = 53;  // 0o755
    source[17] = 32;  // space
    // "42"
    source[18] = 52; source[19] = 50;  // 42
    source[20] = 32;  // space
    // "3.14e-10"
    source[21] = 51; source[22] = 46; source[23] = 49; source[24] = 52;  // 3.14
    source[25] = 101;  // e
    source[26] = 45;   // -
    source[27] = 49; source[28] = 48;  // 10
    let source_len: i64 = 29;

    // Expected:
    // TK_HEX_LIT (202), TK_BIN_LIT (203), TK_OCT_LIT (204)
    // TK_INT_LIT (201), TK_FLOAT_LIT (205), EOF
    true
}

// ============================================================================
// TEST 7: KERNEL SYNTAX (GPU kernels)
// ============================================================================

/// Test: "kernel fn vec_add(a: &[f32], b: &![f32]) { }"
fn test_kernel_syntax() -> bool  with Mut{
    var source: [i8; 1048576] = [0; 1048576];

    // "kernel fn vec_add(a: &[f32], b: &![f32]) { }"
    // k=107, e=101, r=114, n=110, l=108
    source[0] = 107; source[1] = 101; source[2] = 114;
    source[3] = 110; source[4] = 101; source[5] = 108;  // kernel
    source[6] = 32;  // space
    source[7] = 102; source[8] = 110;  // fn
    source[9] = 32;  // space
    // vec_add
    source[10] = 118; source[11] = 101; source[12] = 99;  // vec
    source[13] = 95;  // _
    source[14] = 97; source[15] = 100; source[16] = 100;  // add
    source[17] = 40;  // (
    source[18] = 97; source[19] = 58; source[20] = 32;  // a: space
    source[21] = 38;  // &
    source[22] = 91;  // [
    source[23] = 102; source[24] = 51; source[25] = 50;  // f32
    source[26] = 93;  // ]
    source[27] = 44; source[28] = 32;  // , space
    source[29] = 98; source[30] = 58; source[31] = 32;  // b: space
    source[32] = 38; source[33] = 33;  // &!  (Sounio mutable reference!)
    source[34] = 91;  // [
    source[35] = 102; source[36] = 51; source[37] = 50;  // f32
    source[38] = 93;  // ]
    source[39] = 41;  // )
    source[40] = 32;  // space
    source[41] = 123; source[42] = 32; source[43] = 125;  // { }
    let source_len: i64 = 44;

    // Expected:
    // kernel (TK_KERNEL), fn, vec_add, (, a, :, & (TK_AMP), [, f32, ], ,
    // b, :, & (TK_AMP), ! (TK_BANG), [, f32, ], ), {, }, EOF
    // Note: &! is TWO tokens in Sounio (& followed by !) - the exclusive reference
    true
}

