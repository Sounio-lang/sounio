//@ run-pass
//@ expect-stdout: KNIGHTIAN GUM COMPOSE PASS

// C1 (deep, most reveladora) — Knightian beyond classical GUM + composability + type-safety.
// 
// Probes (per user BC plan Fase 1.1 + research/knightian_operator_*):
// - pb_from_knowledge lifts GUM (zero gap, recovers val/var/conf) — seamless compose.
// - pb_add / pb_mul widen the band (gap >0) while preserving GUM var arithmetic (with documented cross-term honesty note in mul).
// - pb_apply2_monotone_inc_dec (Fréchet M2.5) gives sound outer enclosure for monotone-in-each-arg f over ANY joint (any copula, even Knightian-unknown) — the clinical novelty vs pure GUM delta.
// - Gap/dispersion monotonicity under composition (add is additive for bands; mul uses corners).
// - Confidence decay is monotone non-increasing.
// - Post-compose gates (pb_within, pb_is_credible) remain conservative (band must not cross).
// - "Knightian dominates": large gap forces wide output even if classical var small.
// - Integration surface: PBox works with same numeric style as Epistemic; hand-off to Beta/provenance not direct here (layer separation) but provenance-style metadata via conf.
// - Fragility surfaced (comment): marginal p-box + Fréchet is sound outer for monotone 2-arg but conservative for non-monotone multivariate with correlation Knightian (see consensus review + vancomycin Cmin(Vc,CL) note).
//
// Reuses patterns from test_knightian_band.sio, test_walley_frechet_compose.sio, stdlib/clinical/vancomycin_pbpk.sio::predict_cmin_knightian (corner enum + Fréchet theorem comment).
// Mirrors formal/lean4/SounioKnightian.lean + SounioWalley.lean structural claims (gap, enclosure).
// 
// No overclaim: this is outer enclosure (sound but not tight under positive correlation).
// Numeric expectations are derived from interval arithmetic + GUM formulas (no retrofitted tol).
//
// References:
// - docs/research/knightian_operator_choice.md (Ferson p-box decision, GUM compat, Lean tractability)
// - docs/research/knightian_operator_consensus_2026-04-30.md (joint/copula pushback — reproduced here as "conservative for non-monotone")
// - stdlib/epistemic/knightian.sio:259 (Fréchet theorem statement, pb_apply2_*)
// - stdlib/epistemic/walley.sio:216 (why support_pbox for value enclosure)

use epistemic::knightian::*;

fn k_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn k_near(a: f64, b: f64, tol: f64) -> bool {
    let d = if a > b { a - b } else { b - a };
    d <= tol
}

fn k_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn k_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

// Test f: ratio x/y , increasing in x, decreasing in y (like Cmin ~ dose / (CL * f(Vc,CL)) style).
fn ratio(x: f64, y: f64) -> f64 with Div, Panic { x / y }

// Cmin-point style (increasing Vc, decreasing CL) — mirrors vancomycin_pbpk.vp_cmin_point simplified.
fn cmin_like(vc: f64, cl: f64) -> f64 with Div, Panic {
    // simplified steady-state-ish: dose fixed, tau fixed; cmin ~ 1 / (cl/vc * factor)
    // here monotonic inc in vc, dec in cl for positive domain
    (10.0 / vc) / (cl / 5.0 + 0.1)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fail: bool = false;

    // 1. Lift pure GUM (zero Knightian gap) — composes with classical.
    let g = pb_from_knowledge(15.0, 0.25, 920);
    let lift_ok = (pb_gap(&g) == 0.0)
               && k_near(pb_lo_mean(&g), 15.0, 1e-12)
               && k_near(pb_hi_mean(&g), 15.0, 1e-12)
               && k_near(pb_variance(&g), 0.25, 1e-12)
               && (pb_confidence(&g) == 920);
    if !lift_ok {
        println("LIFT FAIL");
        fail = true;
    }

    // 2. Compose with Knightian bias band (assay + physio uncertainty).
    // gap should be additive on add for aligned bands.
    let bias = pb_new(0.0 - 0.1, 0.1, 0.001, 950);
    let banded = pb_add(&g, &bias);
    let gap_add = pb_gap(&banded);
    let gap_add_ok = k_near(gap_add, 0.2, 1e-9);  // 0.2 + 0.0
    let lo_add_ok = k_near(pb_lo_mean(&banded), 14.9, 1e-9);
    let hi_add_ok = k_near(pb_hi_mean(&banded), 15.1, 1e-9);
    let var_add_ok = k_near(pb_variance(&banded), 0.251, 1e-9);
    let conf_add_ok = pb_confidence(&banded) <= 920;  // decayed
    if !(gap_add_ok && lo_add_ok && hi_add_ok && var_add_ok && conf_add_ok) {
        println("ADD COMPOSE FAIL");
        println(gap_add);
        fail = true;
    }

    // 3. Mul compose: 4-corner band + GUM mid variance (cross term present per code honesty note).
    let scale = pb_new(0.95, 1.05, 0.0004, 900);
    let scaled = pb_mul(&banded, &scale);
    let gap_mul = pb_gap(&scaled);
    // For positive bands mul gap widens (lo*lo to hi*hi approx).
    let gap_mul_ok = gap_mul > 0.19 && gap_mul < 0.35;  // derived conservative
    if !gap_mul_ok {
        println("MUL COMPOSE GAP FAIL");
        println(gap_mul);
        fail = true;
    }

    // 4. Fréchet monotone inc-dec (the clinical novelty).
    // X ~ [10,20] mean~15 var small, Y ~ [2,4] mean~3.
    let vx = pb_new(10.0, 20.0, 0.25, 880);
    let vy = pb_new(2.0, 4.0, 0.04, 900);
    let vz = pb_apply2_monotone_inc_dec(ratio, &vx, &vy);
    // Enclosure corners: 10/4=2.5 , 20/2=10.0
    let fr_lo_ok = k_near(pb_lo_mean(&vz), 2.5, 1e-9);
    let fr_hi_ok = k_near(pb_hi_mean(&vz), 10.0, 1e-9);
    if !(fr_lo_ok && fr_hi_ok) {
        println("FRECHET RATIO FAIL");
        println(pb_lo_mean(&vz));
        println(pb_hi_mean(&vz));
        fail = true;
    }

    // Verify every grid point inside (sound outer for any copula).
    var i: i64 = 0;
    var enc_ok: bool = true;
    while i < 5 {
        var j: i64 = 0;
        while j < 5 {
            let x = 10.0 + (i as f64) * (10.0 / 4.0);
            let y = 2.0 + (j as f64) * (2.0 / 4.0);
            let z = ratio(x, y);
            if z < pb_lo_mean(&vz) - 1e-9 { enc_ok = false; }
            if z > pb_hi_mean(&vz) + 1e-9 { enc_ok = false; }
            j = j + 1;
        }
        i = i + 1;
    }
    if !enc_ok {
        println("FRECHET ENCLOSURE GRID FAIL");
        fail = true;
    }

    // 5. Cmin-like Fréchet (inc Vc, dec CL) — mirrors vancomycin pattern.
    let vc = pb_new(15.0, 25.0, 1.0, 850);
    let cl = pb_new(2.5, 5.5, 0.25, 870);
    let cmin = pb_apply2_monotone_inc_dec(cmin_like, &vc, &cl);
    // Corners: cmin_like(15,5.5) low? Wait inc vc dec cl => min at low vc high cl, max high vc low cl.
    // But apply already does lo = f(lo_x, hi_y), hi = f(hi_x, lo_y) then min/max.
    let cmin_gap_ok = pb_gap(&cmin) > 0.0;
    if !cmin_gap_ok {
        println("FRECHET CMIN GAP FAIL");
        fail = true;
    }

    // 6. Gates post-compose: band must not cross for "safe".
    let safe_gate = pb_within(&banded, 14.5, 15.5) && pb_is_credible(&banded, 800);
    if !safe_gate {
        println("GATE POST COMPOSE FAIL");
        fail = true;
    }

    // 7. Knightian dominates classical: large gap + tiny var still wide band.
    let almost_certain = pb_from_knowledge(15.0, 0.0001, 990);
    let huge_amb = pb_new(5.0, 25.0, 0.0001, 600);
    let dom = pb_add(&almost_certain, &huge_amb);
    let dom_gap_ok = pb_gap(&dom) > 19.9;
    let dom_gate_fails = !pb_within(&dom, 14.0, 16.0);  // band crosses even if mean ok
    if !(dom_gap_ok && dom_gate_fails) {
        println("KNIGHTIAN DOMINATE FAIL");
        println(pb_gap(&dom));
        fail = true;
    }

    // 8. Dispersion (gap + 2σ) grows; conf decayed.
    let disp0 = pb_dispersion(&g);
    let disp_b = pb_dispersion(&banded);
    let disp_ok = disp_b > disp0;
    let conf_dec = pb_confidence(&banded) < 920;
    if !(disp_ok && conf_dec) {
        println("DISPERSION/CONF DECAY FAIL");
        fail = true;
    }

    if fail {
        println("KNIGHTIAN GUM COMPOSE FAIL");
        return 1;
    }
    println("KNIGHTIAN GUM COMPOSE PASS");
    0
}
