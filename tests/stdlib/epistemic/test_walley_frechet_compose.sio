//@ run-pass
//@ expect-stdout: WALLEY FRECHET COMPOSE PASS

// M3.5 — Composition: support-lift two credal sets, feed into the
// Fréchet enclosure for a monotone-(↑x, ↓y) function, verify the
// enclosure encloses every realisation.
//
// Mirrors formal/lean4/SounioWalley.lean :: walley_frechet_composition_holds.

use epistemic::knightian::*
use epistemic::walley::*

fn pb_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// Test function: f(x, y) = x / y (increasing in x, decreasing in y).
// For x ∈ [10, 30], y ∈ [1, 5]:
//   Fréchet corner enclosure = [10/5, 30/1] = [2.0, 30.0]
fn ratio(x: f64, y: f64) -> f64 with Div, Panic { x / y }

fn main() -> i32 with IO, Mut, Div, Panic {
    // Credal set X: mean=20, ε=0.3, support=[10,30]
    let cx = cs_neighborhood(20.0, 4.0, 0.3, 10.0, 30.0, 900)
    // Credal set Y: mean=3, ε=0.2, support=[1,5]
    let cy = cs_neighborhood(3.0, 0.5, 0.2, 1.0, 5.0, 900)

    // Lift to SUPPORT pboxes (the correct lift for nonlinear monotone f).
    let px = credal_to_support_pbox(&cx)
    let py = credal_to_support_pbox(&cy)

    // Apply Fréchet enclosure for f(x, y) = x/y (↑x, ↓y).
    let pz = pb_apply2_monotone_inc_dec(ratio, &px, &py)

    let lo_expected = 2.0   // 10 / 5
    let hi_expected = 30.0  // 30 / 1
    let lo_ok = pb_abs(pb_lo_mean(&pz) - lo_expected) < 1.0e-9
    let hi_ok = pb_abs(pb_hi_mean(&pz) - hi_expected) < 1.0e-9

    // Now sample 16 grid points and verify every f(x,y) ∈ [lo, hi].
    var i: i64 = 0
    var enc_ok: bool = true
    while i < 4 {
        var j: i64 = 0
        while j < 4 {
            let x = 10.0 + (i as f64) * (20.0 / 3.0)
            let y = 1.0 + (j as f64) * (4.0 / 3.0)
            let z = ratio(x, y)
            if z < pb_lo_mean(&pz) - 1.0e-9 { enc_ok = false }
            if z > pb_hi_mean(&pz) + 1.0e-9 { enc_ok = false }
            j = j + 1
        }
        i = i + 1
    }

    if lo_ok && hi_ok && enc_ok {
        println("WALLEY FRECHET COMPOSE PASS")
    } else {
        println("WALLEY FRECHET COMPOSE FAIL")
    }
    0
}
