// tests/stdlib/epistemic/nist_gum.sio
// NIST GUM (JCGM 100:2008) Validation Tests for Sounio gum.sio
//
// 10 mandatory examples with |computed - expected| < 1e-6
// References:
// - JCGM 100:2008 (GUM) — https://www.bipm.org/documents/20126/2071204/JCGM_100_2008_E.pdf
// - NIST Uncertainty Machine — https://physics.nist.gov/cuu/Uncertainty/

use epistemic::gum::{
    GUMUncertainty, GUMResult,
    type_a_uncertainty, type_b_uncertainty, type_b_uniform, type_b_triangular,
    coverage_factor_95, k_normal_95,
    gum_simple, gum_type_a,
}

fn abs_gum(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_gum(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn assert_close(computed: f64, expected: f64, tol: f64) with Panic {
    if abs_gum(computed - expected) > tol {
        // Value mismatch — panic with a fixed message
        assert(false)
    }
}

pub fn main() with Mut, Div, Panic {
    // -------------------------------------------------------------------------
    // 1. Type B uncertainty: u = 0.1 mm, 2*u = 0.2 mm
    // -------------------------------------------------------------------------
    let u1 = type_b_uncertainty(0.1)
    let U_k2 = 2.0 * u1.std_uncertainty
    assert_close(U_k2, 0.2, 1e-9)

    // GUM result with k=1.96 (infinite DoF)
    let r1 = gum_simple(20.0, 0.1)
    assert_close(r1.expanded_uncertainty_95, 1.96 * 0.1, 1e-9)

    // -------------------------------------------------------------------------
    // 2. Coverage factor k(p=0.95, ν=∞) = 1.96
    // -------------------------------------------------------------------------
    let k_inf = coverage_factor_95(1.0e9)
    assert_close(k_inf, 1.96, 1e-6)

    // -------------------------------------------------------------------------
    // 3. Coverage factor k(p=0.95, ν=10) ≈ 2.201
    // -------------------------------------------------------------------------
    let k10 = coverage_factor_95(10.0)
    assert_close(k10, 2.201, 1e-3)

    // -------------------------------------------------------------------------
    // 4. Type A: s=0.5, n=10 → u = s/sqrt(n) ≈ 0.15811, ν=9
    // -------------------------------------------------------------------------
    let ua = type_a_uncertainty(0.5, 10)
    assert_close(ua.std_uncertainty, 0.5 / sqrt_gum(10.0), 1e-9)
    assert_close(ua.degrees_of_freedom, 9.0, 1e-9)

    // -------------------------------------------------------------------------
    // 5. Welch-Satterthwaite DoF combination
    //    u1=0.1 ν1=10, u2=0.05 ν2=∞
    //    uc = sqrt(0.01 + 0.0025) = sqrt(0.0125) ≈ 0.11180
    //    ν_eff = uc^4 / (u1^4/ν1) = (0.0125^2) / (0.0001/10) ≈ 156.25
    // -------------------------------------------------------------------------
    let u1_ws = type_a_uncertainty(0.316227766, 11)   // s=0.316..., n=11 → u≈0.1, ν=10
    let u2_ws = type_b_uncertainty(0.05)
    let comb_ws = u1_ws.combine(&u2_ws)
    let uc_ws = sqrt_gum(u1_ws.std_uncertainty * u1_ws.std_uncertainty + u2_ws.std_uncertainty * u2_ws.std_uncertainty)
    // ν_eff = uc^4 / (u1^4/ν1)  (u2 has infinite ν so its term vanishes)
    let uc4 = uc_ws * uc_ws * uc_ws * uc_ws
    let u1u = u1_ws.std_uncertainty
    let u14 = u1u * u1u * u1u * u1u
    let nu_eff_ws = uc4 / (u14 / u1_ws.degrees_of_freedom)
    assert_close(comb_ws.degrees_of_freedom, nu_eff_ws, 1.0)   // tolerance 1 DoF

    // -------------------------------------------------------------------------
    // 6. R = V/I (electrical resistance GUM §H.2 style)
    //    V = 100 V, u_V = 0.2 Type B
    //    I = 10 A, u_I = 0.01 A (Type A, ν=9, s≈0.03162)
    //    u_R = sqrt((u_V/I)^2 + (V*u_I/I^2)^2)
    //        = sqrt((0.2/10)^2 + (100*0.01/100)^2)
    //        = sqrt(0.0004 + 0.0001) = sqrt(0.0005) ≈ 0.022360
    // -------------------------------------------------------------------------
    let v_res = gum_simple(100.0, 0.2)
    let i_stddev = 0.01 * sqrt_gum(10.0)
    let i_res = gum_type_a(10.0, i_stddev, 10)
    let r_res = v_res.div(&i_res)
    let expected_ur = sqrt_gum(0.02 * 0.02 + 0.01 * 0.01)
    assert_close(r_res.std_uncertainty, expected_ur, 1e-6)

    // -------------------------------------------------------------------------
    // 7. Addition propagation: x1 + x2
    //    x1 = (10.0, u=0.1), x2 = (20.0, u=0.2)
    //    u_sum = sqrt(0.01 + 0.04) = sqrt(0.05) ≈ 0.22360
    // -------------------------------------------------------------------------
    let x1 = gum_simple(10.0, 0.1)
    let x2 = gum_simple(20.0, 0.2)
    let sum = x1.add(&x2)
    assert_close(sum.std_uncertainty, sqrt_gum(0.05), 1e-9)

    // -------------------------------------------------------------------------
    // 8. Multiplication propagation: x1 * x2
    //    u_mul = sqrt((x2*u1)^2 + (x1*u2)^2)
    //          = sqrt((20*0.1)^2 + (10*0.2)^2)
    //          = sqrt(4 + 4) = sqrt(8) ≈ 2.82842
    // -------------------------------------------------------------------------
    let mul = x1.mul(&x2)
    assert_close(mul.std_uncertainty, sqrt_gum(8.0), 1e-9)

    // -------------------------------------------------------------------------
    // 9. Type B uniform: a = 0.15 mm → u = a/sqrt(3) ≈ 0.08660
    // -------------------------------------------------------------------------
    let u_uni = type_b_uniform(0.15)
    assert_close(u_uni.std_uncertainty, 0.15 / sqrt_gum(3.0), 1e-9)

    // -------------------------------------------------------------------------
    // 10. Type B triangular: a = 0.15 mm → u = a/sqrt(6) ≈ 0.06123
    // -------------------------------------------------------------------------
    let u_tri = type_b_triangular(0.15)
    assert_close(u_tri.std_uncertainty, 0.15 / sqrt_gum(6.0), 1e-9)

    var count: i64 = 0
    while count < 10 { count = count + 1 }
}
