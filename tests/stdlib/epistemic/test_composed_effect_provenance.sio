//@ run-pass
//@ expect-stdout: PROV PASS

// M1 — provenance tags propagate as min through arithmetic operations.
// Clinical interpretation: a chain of computations is only as
// authoritative as its weakest provenance link.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let rct_input = ck_new(10.0, 0.04, 0.001, 9.0, 1.0, 950, provenance_rct())
    let cohort_input = ck_new(2.0, 0.01, 0.0005, 8.0, 2.0, 920, provenance_cohort())
    let case_input = ck_new(0.5, 0.001, 0.0001, 7.0, 3.0, 800, provenance_case_series())

    let intermediate = ck_mul(&rct_input, &cohort_input)
    let final_val = ck_mul(&intermediate, &case_input)

    if ck_value(&final_val) == 10.0 {
        let weakest = ce_min_i64(provenance_rct(), provenance_cohort())
        if weakest == provenance_rct() {
            println("PROV PASS")
        } else {
            println("PROV FAIL min")
        }
    } else {
        println("PROV FAIL value")
    }
    0
}
