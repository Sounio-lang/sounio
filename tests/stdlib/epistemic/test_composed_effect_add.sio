//@ run-pass
//@ expect-stdout: ADD PASS

// M1 — addition GUM variance propagation: Var(X+Y) = Var(X) + Var(Y).

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let a = ck_new(10.0, 0.04, 0.001, 9.0, 1.0, 950, 1)
    let b = ck_new(2.0, 0.01, 0.0005, 8.0, 2.0, 920, 1)
    let s = ck_add(&a, &b)
    if ck_value(&s) == 12.0 && ck_variance(&s) == 0.05 {
        println("ADD PASS")
    } else {
        println("ADD FAIL")
    }
    0
}
