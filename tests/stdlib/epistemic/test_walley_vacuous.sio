//@ run-pass
//@ expect-stdout: WALLEY VACUOUS PASS

// M3.5 — Walley credal set: vacuous-at-ε=1 yields full-support p-box.
// Mirrors the structural claim of
// formal/lean4/SounioWalley.lean :: walley_vacuous_gap_at_one_nat.

use epistemic::knightian::*
use epistemic::walley::*

fn pb_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Div, Panic {
    // ε=1 ⇒ lifted lo == s_lo, hi == s_hi (band = full support).
    let c = cs_vacuous(5.0, 25.0, 800)
    let p = credal_to_pbox(&c)

    let lo_ok = pb_lo_mean(&p) == 5.0
    let hi_ok = pb_hi_mean(&p) == 25.0
    let gap_ok = pb_gap(&p) == 20.0

    // Variance bound at ε=1 with μ=mid: R = 10, so var ≤ 100.
    // The exact formula gives R² = 10² = 100.
    let r_sq = 100.0
    let var_ok = pb_abs(pb_variance(&p) - r_sq) < 1.0e-9

    if lo_ok && hi_ok && gap_ok && var_ok {
        println("WALLEY VACUOUS PASS")
    } else {
        println("WALLEY VACUOUS FAIL")
    }
    0
}
