//@ run-pass
//@ expect-stdout: ALL PASS
//
// Vertical smoke test for stdlib/epistemic:
//   Epistemic -> BetaConfidence -> propagate -> meta (FE / RE / Bayes)
//
// Exercises every layer added/restored by the aspirational tier work so
// the whole stack stays import-clean and numerically sane.

use epistemic::knowledge::{
    Epistemic,
    epistemic_new, epistemic_certain,
    BetaConfidence, beta_confidence, beta_uniform, confidence_to_beta,
    Provenance, provenance_new, PROV_SOURCE_MEASUREMENT,
}
use epistemic::propagate::{exp, ln, linear_combo, propagate_2d_analytic}
use epistemic::meta::{
    fixed_effects, random_effects, bayesian_pool, auto_pool,
    META_METHOD_FIXED, META_METHOD_RANDOM,
}

var CNT: [i64; 2] = [0; 2]

fn chk(label: i64, ok: i64) with IO, Mut, Panic {
    if ok == 1 {
        print("  PASS ["); print(label); print("]\n")
        CNT[0] = CNT[0] + 1
    } else {
        print("  FAIL ["); print(label); print("]\n")
        CNT[1] = CNT[1] + 1
    }
}

fn near(a: f64, b: f64, tol: f64) -> i64 {
    let d = a - b
    let d2 = if d < 0.0 { 0.0 - d } else { d }
    if d2 <= tol { 1 } else { 0 }
}

fn test_constructors_and_certain() with IO, Mut, Div, Panic {
    let c = epistemic_certain(42.0)
    chk(1, near(c.val(), 42.0, 1e-12))
    chk(2, near(c.variance(), 0.0, 1e-12))
    chk(3, if c.confidence() == 1000 { 1 } else { 0 })
}

fn test_beta_confidence() with IO, Mut, Div, Panic {
    let bc = beta_confidence(8.0, 2.0)
    // mean = 0.8, concentration = 10
    chk(4, near(bc.mean(), 0.8, 1e-9))
    chk(5, near(bc.concentration(), 10.0, 1e-12))

    let merged = bc.combine(&beta_confidence(2.0, 8.0))
    // (10,10) -> mean 0.5
    chk(6, near(merged.mean(), 0.5, 1e-9))

    let bu = beta_uniform()
    chk(7, near(bu.mean(), 0.5, 1e-9))
}

fn test_propagate() with Prob, IO, Mut, Div, Panic {
    let x = epistemic_new(2.0, 0.04, 900)   // val=2, σ²=0.04, σ=0.2
    let y = epistemic_new(3.0, 0.09, 900)   // val=3, σ²=0.09, σ=0.3

    // linear_combo 2x + 1y → val=7, var = 4·0.04 + 1·0.09 = 0.16+0.09 = 0.25
    let lc = linear_combo(2.0, x, 1.0, y)
    chk(8, near(lc.val(), 7.0, 1e-12))
    chk(9, near(lc.variance(), 0.25, 1e-12))

    // propagate_2d_analytic f=x+y, df/dx=df/dy=1 → val=5, var=0.04+0.09=0.13
    let s = propagate_2d_analytic(5.0, 1.0, x, 1.0, y)
    chk(10, near(s.val(), 5.0, 1e-12))
    chk(11, near(s.variance(), 0.13, 1e-12))
}

fn test_meta_fixed_effects() with IO, Mut, Div, Panic {
    // Three identical studies: pooled mean = 1.0, pooled var = 0.01/3.
    let s1 = epistemic_new(1.0, 0.01, 900)
    let s2 = epistemic_new(1.0, 0.01, 900)
    let s3 = epistemic_new(1.0, 0.01, 900)
    let arr: [Epistemic; 3] = [s1, s2, s3]
    let fe = fixed_effects(&arr)
    chk(12, if fe.k == 3 { 1 } else { 0 })
    chk(13, if fe.method == META_METHOD_FIXED { 1 } else { 0 })
    chk(14, near(fe.pooled.val, 1.0, 1e-10))
    chk(15, near(fe.pooled.variance, 0.01 / 3.0, 1e-10))
    // Q should be ~0 (no heterogeneity)
    chk(16, near(fe.heterogeneity.q, 0.0, 1e-9))
}

fn test_meta_random_effects() with IO, Mut, Div, Panic {
    // Heterogeneous studies: τ² > 0 expected.
    let s1 = epistemic_new(0.30, 0.01, 800)
    let s2 = epistemic_new(0.50, 0.01, 800)
    let s3 = epistemic_new(0.70, 0.01, 800)
    let arr: [Epistemic; 3] = [s1, s2, s3]
    let re = random_effects(&arr)
    chk(17, if re.k == 3 { 1 } else { 0 })
    chk(18, if re.method == META_METHOD_RANDOM { 1 } else { 0 })
    // Pooled mean ≈ 0.5
    chk(19, near(re.pooled.val, 0.5, 1e-9))
    // τ² should be strictly positive given the spread
    chk(20, if re.heterogeneity.tau_squared > 0.0 { 1 } else { 0 })
}

fn test_meta_bayesian() with IO, Mut, Div, Panic {
    // Single study, weak prior.
    let s1 = epistemic_new(2.0, 0.04, 850)
    let arr: [Epistemic; 1] = [s1]
    let post = bayesian_pool(&arr, 0.0, 100.0)
    // Posterior mean dominated by likelihood (variance ≪ prior variance).
    chk(21, near(post.pooled.val, 2.0, 1e-3))
    // BetaConfidence should be moved away from uniform.
    chk(22, if post.confidence.concentration() > 2.0 { 1 } else { 0 })
}

fn test_provenance() with IO, Mut, Div, Panic {
    let p = provenance_new(PROV_SOURCE_MEASUREMENT)
    chk(23, if p.source == PROV_SOURCE_MEASUREMENT { 1 } else { 0 })
    chk(24, if p.step_count == 0 { 1 } else { 0 })
}

pub fn main() -> i32 with Prob, IO, Mut, Div, Panic {
    CNT[0] = 0; CNT[1] = 0
    print("─── stdlib/epistemic vertical smoke ───\n")
    test_constructors_and_certain()
    test_beta_confidence()
    test_propagate()
    test_meta_fixed_effects()
    test_meta_random_effects()
    test_meta_bayesian()
    test_provenance()
    print("─── "); print(CNT[0]); print("/"); print(CNT[0]+CNT[1]); print(" PASS ───\n")
    if CNT[1] == 0 { print("ALL PASS\n"); 0 } else { 1 }
}
