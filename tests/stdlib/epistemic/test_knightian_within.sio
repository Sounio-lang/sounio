//@ run-pass
//@ expect-stdout: KNIGHTIAN WITHIN PASS

// M2 — Knightian within-gate: a band straddling a therapeutic boundary
// must FAIL the within-check (Knightian conservativeness).
// This is the operational difference vs Bayesian point-estimate gating:
// a CI that crosses the boundary is rejected even if its mean is safe.

use epistemic::knightian::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let safe_band = pb_new(12.0, 18.0, 0.04, 920)
    let crosses_low = pb_new(9.5, 18.0, 0.04, 920)
    let crosses_high = pb_new(12.0, 20.5, 0.04, 920)

    let p_safe = pb_within(&safe_band, 10.0, 20.0)
    let p_low = pb_within(&crosses_low, 10.0, 20.0)
    let p_high = pb_within(&crosses_high, 10.0, 20.0)

    if p_safe && !p_low && !p_high {
        println("KNIGHTIAN WITHIN PASS")
    } else {
        println("KNIGHTIAN WITHIN FAIL")
    }
    0
}
