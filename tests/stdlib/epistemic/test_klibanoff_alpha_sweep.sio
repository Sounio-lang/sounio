//@ run-pass
//@ expect-stdout: KL ALPHA SWEEP PASS

// M3.5+ — Klibanoff CE_α monotonicity in α.
// Verifies that for the same (c, λ), CE_α is monotone-non-increasing
// in α: more ambiguity aversion never raises the certainty
// equivalent. Standard CARA result (Cauchy–Schwarz on negative-
// exponent moments), confirmed by math-review 2026-05-01.

use epistemic::knightian::*
use epistemic::walley::*
use epistemic::klibanoff::*

fn ks_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn ce_at(c: &CredalSet, alpha: f64) -> f64 with Mut, Div, Panic {
    if alpha <= 0.0 { return kl_precise_ce(c, 1.0) }
    kl_smooth_ce(c, alpha, 1.0)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // CredalSet: μ_0 = 15, σ² = 1, ε = 0.2, support [10, 20]
    let c = cs_neighborhood(15.0, 1.0, 0.2, 10.0, 20.0, 900)

    // α sweep: 0.0, 0.05, 0.1, 0.25, 0.5, 1.0, 2.0, 5.0
    let v0 = ce_at(&c, 0.0)
    let v1 = ce_at(&c, 0.05)
    let v2 = ce_at(&c, 0.1)
    let v3 = ce_at(&c, 0.25)
    let v4 = ce_at(&c, 0.5)
    let v5 = ce_at(&c, 1.0)
    let v6 = ce_at(&c, 2.0)
    let v7 = ce_at(&c, 5.0)

    // Monotone-non-increasing in α.
    let mono_ok = v0 >= v1 && v1 >= v2 && v2 >= v3 && v3 >= v4
               && v4 >= v5 && v5 >= v6 && v6 >= v7

    // α=0 should equal kl_precise_ce(c, 1.0) = (1-0.2)*15 + 0.2*10 = 14.0
    let v0_ok = ks_abs(v0 - 14.0) < 1.0e-9

    // As α grows, CE should approach the Walley min = 10.
    // At α=5 with support range 10, the Walley dominance should be very strong.
    let limit_close = ks_abs(v7 - 10.0) < 1.0   // within 1 mg/L of Walley

    // Sandwich at every α: walley ≤ CE_α ≤ precise.
    let walley = kl_walley_ce(&c, 1.0)
    let precise = kl_precise_ce(&c, 1.0)
    let sandwich_ok = walley <= v1 && v1 <= precise + 1.0e-6
                   && walley <= v3 && v3 <= precise + 1.0e-6
                   && walley <= v5 && v5 <= precise + 1.0e-6
                   && walley <= v7 && v7 <= precise + 1.0e-6

    if mono_ok && v0_ok && limit_close && sandwich_ok {
        println("KL ALPHA SWEEP PASS")
    } else {
        println("KL ALPHA SWEEP FAIL")
        if !mono_ok {
            println("monotonicity broken")
            println(v0)
            println(v1)
            println(v2)
            println(v3)
            println(v4)
            println(v5)
            println(v6)
            println(v7)
        }
        if !v0_ok { println("alpha=0 not 14.0") }
        if !limit_close { println("alpha=5 not approaching walley") }
        if !sandwich_ok { println("sandwich broken at some alpha") }
    }
    0
}
