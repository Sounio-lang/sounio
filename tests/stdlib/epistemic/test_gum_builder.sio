// tests/stdlib/epistemic/test_gum_builder.sio — Tests for GUM Builder Pattern
//
// Tests for the new builder pattern and method chaining API in epistemic/gum.sio.

use epistemic::gum::{
    GUMUncertainty, GUMResult,
    type_a_uncertainty, type_b_uncertainty, type_b_uniform, type_b_triangular, type_b_from_expanded,
    gum_simple, gum_type_a,
    gum_add, gum_sub, gum_mul, gum_div,
    coverage_factor_95, k_normal_95,
}

// =============================================================================
// Test: GUMUncertainty Builder Pattern
// =============================================================================

fn test_gum_uncertainty_type_a() with Mut, Div, Panic {
    // New builder pattern
    let u = type_a_uncertainty(0.1, 10)
    
    // Standard uncertainty of mean = s / sqrt(n) = 0.1 / sqrt(10) ≈ 0.0316
    let expected_u = 0.1 / 3.16227766  // sqrt(10)
    
    assert(u.std_uncertainty > expected_u - 0.001 && u.std_uncertainty < expected_u + 0.001)
    
    // Degrees of freedom = n - 1 = 9
    assert(u.degrees_of_freedom == 9.0)
    
    // Default sensitivity = 1.0
    assert(u.sensitivity == 1.0)
}

fn test_gum_uncertainty_type_b() with Mut, Div, Panic {
    // New builder pattern
    let u = type_b_uncertainty(0.05)
    
    assert(u.std_uncertainty == 0.05)
    
    // Type B has infinite DoF (represented as 1e9)
    assert(u.degrees_of_freedom == 1.0e9)
    
    assert(u.sensitivity == 1.0)
}

fn test_gum_uncertainty_type_b_uniform() with Mut, Div, Panic {
    // Uniform distribution: u = a / sqrt(3)
    let u = type_b_uniform(1.0)
    
    // u = 1.0 / sqrt(3) ≈ 0.577
    let expected = 1.0 / 1.732050808
    assert(u.std_uncertainty > expected - 0.001 && u.std_uncertainty < expected + 0.001)
}

fn test_gum_uncertainty_type_b_triangular() with Mut, Div, Panic {
    // Triangular distribution: u = a / sqrt(6)
    let u = type_b_triangular(1.0)
    
    // u = 1.0 / sqrt(6) ≈ 0.408
    let expected = 1.0 / 2.449489743
    assert(u.std_uncertainty > expected - 0.001 && u.std_uncertainty < expected + 0.001)
}

fn test_gum_uncertainty_with_sensitivity() with Mut, Div, Panic {
    // Method chaining for sensitivity
    let u = type_a_uncertainty(0.1, 10)
        .with_sensitivity(2.0)
    
    assert(u.sensitivity == 2.0)
}

fn test_gum_uncertainty_combine() with Mut, Div, Panic {
    let u1 = type_b_uncertainty(0.1).with_sensitivity(1.0)
    let u2 = type_b_uncertainty(0.2).with_sensitivity(1.0)
    
    let combined = u1.combine(&u2)
    
    // Combined: u_c = sqrt(0.1^2 + 0.2^2) = sqrt(0.05) ≈ 0.224
    let expected = 0.223606797  // sqrt(0.05)
    assert(combined.std_uncertainty > expected - 0.001 && combined.std_uncertainty < expected + 0.001)
}

// =============================================================================
// Test: GUMResult Builder Pattern
// =============================================================================

fn test_gum_result_simple() with Mut, Div, Panic {
    // New builder pattern
    let result = gum_simple(10.0, 0.1)
    
    assert(result.value == 10.0)
    assert(result.std_uncertainty == 0.1)
    
    // Type B has infinite DoF
    assert(result.degrees_of_freedom == 1.0e9)
    
    // Expanded uncertainty at 95%: U = 1.96 * 0.1 = 0.196
    assert(result.expanded_uncertainty_95 > 0.195 && result.expanded_uncertainty_95 < 0.197)
}

fn test_gum_result_type_a() with Mut, Div, Panic {
    // New builder pattern
    let result = gum_type_a(10.0, 0.5, 10)
    
    assert(result.value == 10.0)
    
    // u = s / sqrt(n) = 0.5 / sqrt(10) ≈ 0.158
    let expected_u = 0.5 / 3.16227766
    assert(result.std_uncertainty > expected_u - 0.01 && result.std_uncertainty < expected_u + 0.01)
    
    // DoF = n - 1 = 9
    assert(result.degrees_of_freedom == 9.0)
}

fn test_gum_result_from_value() with Mut, Div, Panic {
    let result = gum_simple(10.0)
    
    assert(result.value == 10.0)
    assert(result.std_uncertainty == 0.0)
    assert(result.expanded_uncertainty_95 == 0.0)
}

fn test_gum_result_with_uncertainty() with Mut, Div, Panic {
    let result = gum_simple(10.0)
        .with_uncertainty(0.2)
    
    assert(result.std_uncertainty == 0.2)
    assert(result.expanded_uncertainty_95 > 0.39 && result.expanded_uncertainty_95 < 0.40)
}

fn test_gum_result_with_dof() with Mut, Div, Panic {
    let result = gum_simple(10.0, 0.1)
        .with_dof(9.0)
    
    assert(result.degrees_of_freedom == 9.0)
    
    // k for 9 DoF at 95% = 2.262
    assert(result.coverage_factor_95 > 2.26 && result.coverage_factor_95 < 2.27)
}

// =============================================================================
// Test: GUMResult Method Chaining Operations
// =============================================================================

fn test_gum_result_add() with Mut, Div, Panic {
    let a = gum_simple(10.0, 0.1)
    let b = gum_simple(5.0, 0.2)
    
    let c = a.add(&b)
    
    // Value: 10 + 5 = 15
    assert(c.value == 15.0)
    
    // Uncertainty: sqrt(0.1^2 + 0.2^2) = sqrt(0.05) ≈ 0.224
    let expected_u = 0.223606797
    assert(c.std_uncertainty > expected_u - 0.01 && c.std_uncertainty < expected_u + 0.01)
}

fn test_gum_result_sub() with Mut, Div, Panic {
    let a = gum_simple(10.0, 0.1)
    let b = gum_simple(3.0, 0.2)
    
    let c = a.sub(&b)
    
    // Value: 10 - 3 = 7
    assert(c.value == 7.0)
    
    // Uncertainty: sqrt(0.1^2 + 0.2^2) ≈ 0.224
    let expected_u = 0.223606797
    assert(c.std_uncertainty > expected_u - 0.01 && c.std_uncertainty < expected_u + 0.01)
}

fn test_gum_result_mul() with Mut, Div, Panic {
    let a = gum_simple(10.0, 0.1)
    let b = gum_simple(2.0, 0.1)
    
    let c = a.mul(&b)
    
    // Value: 10 * 2 = 20
    assert(c.value == 20.0)
    
    // Uncertainty: sqrt((2*0.1)^2 + (10*0.1)^2) = sqrt(0.04 + 1.0) ≈ 1.02
    assert(c.std_uncertainty > 1.0 && c.std_uncertainty < 1.1)
}

fn test_gum_result_scale() with Mut, Div, Panic {
    let a = gum_simple(10.0, 0.1)
    
    let c = a.scale(3.0)
    
    // Value: 10 * 3 = 30
    assert(c.value == 30.0)
    
    // Uncertainty: |3| * 0.1 = 0.3
    assert(c.std_uncertainty == 0.3)
}

fn test_gum_result_relative_uncertainty() with Mut, Div, Panic {
    let result = gum_simple(100.0, 5.0)
    
    // Relative uncertainty: 5 / 100 = 0.05 = 5%
    let rel = result.relative_uncertainty()
    assert(rel == 0.05)
}

// =============================================================================
// Test: Complex Chain Operations
// =============================================================================

fn test_gum_result_complex_chain() with Mut, Div, Panic {
    // Chain: (a + b).scale(0.5).add(&c)
    let a = gum_simple(10.0, 0.1)
    let b = gum_simple(5.0, 0.2)
    let c = gum_simple(2.0, 0.05)
    
    let result = a.add(&b).scale(0.5).add(&c)
    
    // Value: ((10 + 5) * 0.5) + 2 = 7.5 + 2 = 9.5
    assert(result.value == 9.5)
    
    // Uncertainty should propagate through chain
    assert(result.std_uncertainty > 0.0)
}

// =============================================================================
// Test: Backward Compatibility
// =============================================================================

fn test_gum_backward_compatibility_type_a() with Mut, Div, Panic {
    // Old API should still work
    let u = type_a_uncertainty(0.1, 10)
    
    let expected_u = 0.1 / 3.16227766
    assert(u.std_uncertainty > expected_u - 0.001 && u.std_uncertainty < expected_u + 0.001)
    assert(u.degrees_of_freedom == 9.0)
}

fn test_gum_backward_compatibility_type_b() with Mut, Div, Panic {
    // Old API should still work
    let u = type_b_uncertainty(0.05)
    assert(u.std_uncertainty == 0.05)
    
    let u_uniform = type_b_uniform(1.0)
    let expected = 1.0 / 1.732050808
    assert(u_uniform.std_uncertainty > expected - 0.001 && u_uniform.std_uncertainty < expected + 0.001)
    
    let u_tri = type_b_triangular(1.0)
    let expected_tri = 1.0 / 2.449489743
    assert(u_tri.std_uncertainty > expected_tri - 0.001 && u_tri.std_uncertainty < expected_tri + 0.001)
    
    let u_exp = type_b_from_expanded(0.196, 1.96)
    assert(u_exp.std_uncertainty == 0.1)
}

fn test_gum_backward_compatibility_gum_simple() with Mut, Div, Panic {
    // Old API should still work
    let result = gum_simple(10.0, 0.1)
    
    assert(result.value == 10.0)
    assert(result.std_uncertainty == 0.1)
}

fn test_gum_backward_compatibility_gum_ops() with Mut, Div, Panic {
    // Old API for operations should still work
    let a = gum_simple(10.0, 0.1)
    let b = gum_simple(5.0, 0.2)
    
    let c_add = gum_add(a, b)
    assert(c_add.value == 15.0)
    
    let c_sub = gum_sub(a, b)
    assert(c_sub.value == 5.0)
    
    let a2 = gum_simple(10.0, 0.1)
    let b2 = gum_simple(2.0, 0.1)
    let c_mul = gum_mul(a2, b2)
    assert(c_mul.value == 20.0)
}

// =============================================================================
// Main test runner
// =============================================================================

pub fn main() with Mut, Div, Panic {
    test_gum_uncertainty_type_a()
    test_gum_uncertainty_type_b()
    test_gum_uncertainty_type_b_uniform()
    test_gum_uncertainty_type_b_triangular()
    test_gum_uncertainty_with_sensitivity()
    test_gum_uncertainty_combine()
    
    test_gum_result_simple()
    test_gum_result_type_a()
    test_gum_result_from_value()
    test_gum_result_with_uncertainty()
    test_gum_result_with_dof()
    
    test_gum_result_add()
    test_gum_result_sub()
    test_gum_result_mul()
    test_gum_result_scale()
    test_gum_result_relative_uncertainty()
    
    test_gum_result_complex_chain()
    
    test_gum_backward_compatibility_type_a()
    test_gum_backward_compatibility_type_b()
    test_gum_backward_compatibility_gum_simple()
    test_gum_backward_compatibility_gum_ops()
    
    // Success indicator
    var i: i64 = 0
    while i < 3 {
        i = i + 1
    }
}
