//@ run-pass
// E2E test for stdlib/epistemic/core
// Tests: uncertainty_exact, epistemic_std, epistemic_exact, add_epistemic,
//        get_value, get_confidence, check_invariants

use epistemic::lib::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32  with Mut{
    var pass = 0
    var fail = 0

    // Test 1: uncertainty_exact() has tag 0
    let ue = uncertainty_exact()
    if ue.tag == 0 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 2: epistemic_exact creates value with conf=1.0
    let e1 = epistemic_exact(42.0, 1.0)
    let v1 = get_value(e1)
    if check_near(v1, 42.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 3: confidence is preserved
    let c1 = get_confidence(e1)
    if check_near(c1, 1.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 4: epistemic_std with uncertainty
    let e2 = epistemic_std(100.0, 5.0, 0.9)
    let v2 = get_value(e2)
    if check_near(v2, 100.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 5: std uncertainty is stored correctly
    let u2 = get_std_uncertainty(e2)
    if check_near(u2, 5.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 6: add_epistemic sums values
    let e3 = epistemic_exact(10.0, 0.8)
    let e4 = epistemic_exact(20.0, 0.9)
    let sum = add_epistemic(e3, e4)
    let sum_val = get_value(sum)
    if check_near(sum_val, 30.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 7: confidence monotonicity: result.conf <= min(a.conf, b.conf)
    let sum_conf = get_confidence(sum)
    if sum_conf <= 0.8001 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 8: invariants hold
    let inv = check_invariants(e2)
    if inv {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    // Test 9: confidence clamped to [0, 1]
    let e_over = epistemic_exact(1.0, 5.0)
    let c_over = get_confidence(e_over)
    if check_near(c_over, 1.0, 0.0001) {
        pass = pass + 1
    } else {
        fail = fail + 1
    }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
