//@ run-pass
//@ expect-stdout: KNIGHTIAN BAND PASS

// M2 — Knightian band addition: gap monotonically widens under
// repeated addition with non-degenerate p-boxes.

use epistemic::knightian::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let a = pb_new(10.0, 11.0, 0.04, 950)
    let b = pb_new(2.0, 3.0, 0.01, 920)
    let s = pb_add(&a, &b)

    // Sum gap: (11+3) - (10+2) = 2.0
    let expected_gap = 2.0
    let gap = pb_gap(&s)
    let dgap = if gap > expected_gap { gap - expected_gap } else { expected_gap - gap }

    let var_correct = pb_variance(&s) == 0.05
    let lo_correct = pb_lo_mean(&s) == 12.0
    let hi_correct = pb_hi_mean(&s) == 14.0

    if dgap < 0.001 && var_correct && lo_correct && hi_correct {
        println("KNIGHTIAN BAND PASS")
    } else {
        println("KNIGHTIAN BAND FAIL")
    }
    0
}
