//@ run-pass
//@ expect-stdout: MUL PASS

// M1 — multiplication delta-method variance:
// Var(XY) ≈ y² Var(X) + x² Var(Y) for X=10±0.2, Y=2±0.1
// = 4 · 0.04 + 100 · 0.01 = 0.16 + 1.0 = 1.16

use epistemic::composed_effects::*

fn ce_abs2(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let a = ck_new(10.0, 0.04, 0.001, 9.0, 1.0, 950, 1)
    let b = ck_new(2.0, 0.01, 0.0005, 8.0, 2.0, 920, 1)
    let p = ck_mul(&a, &b)
    let v = ck_variance(&p)
    let dv = ce_abs2(v - 1.16)
    if ck_value(&p) == 20.0 && dv < 0.001 {
        println("MUL PASS")
    } else {
        println("MUL FAIL")
    }
    0
}
