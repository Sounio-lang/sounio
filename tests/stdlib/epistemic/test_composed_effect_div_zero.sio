//@ run-pass
//@ expect-stdout: DIV-ZERO PASS

// M1 — division by zero falls back to vacuous knowledge (no panic).
// Critical for clinical safety: a degenerate input must not crash the
// pipeline; it must produce a clearly-marked low-confidence result.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let a = ck_new(10.0, 0.04, 0.001, 9.0, 1.0, 950, 1)
    let zero = ck_new(0.0, 0.0, 0.0, 9.0, 1.0, 1000, 1)
    let q = ck_div(&a, &zero)
    if ck_confidence(&q) == 0 && ck_value(&q) == 0.0 {
        println("DIV-ZERO PASS")
    } else {
        println("DIV-ZERO FAIL")
    }
    0
}
