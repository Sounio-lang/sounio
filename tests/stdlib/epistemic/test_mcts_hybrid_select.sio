//@ run-pass
//@ expect-stdout: MCTS_HYBRID_SELECT_PASS

use epistemic::mcts_hybrid::{initial_arm_variance, puct_select_two_actions}

fn main() with IO {
    let v = initial_arm_variance()
    let pick = puct_select_two_actions(0.3, 2.0, v, 0.7, 2.0, 0.01, 0.5, 1.4, 0.8)
    println(pick)
    if pick == 0 {
        println("MCTS_HYBRID_SELECT_PASS")
    } else {
        println("MCTS_HYBRID_SELECT_FAIL")
    }
}