//@ run-pass
//@ expect-stdout: LIFT PASS

// M1 — lifting a Knowledge<f64>-style triple into ComposedKnowledge
// preserves the GUM data and produces vacuous Causal/Approx channels.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let lifted = ck_from_knowledge(15.0, 0.25, 920)
    let preserved = ck_value(&lifted) == 15.0 && ck_variance(&lifted) == 0.25 && ck_confidence(&lifted) == 920
    let vacuous_approx = ck_approx_bound(&lifted) == 0.0
    if preserved && vacuous_approx {
        println("LIFT PASS")
    } else {
        println("LIFT FAIL")
    }
    0
}
