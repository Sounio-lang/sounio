//@ run-pass
//@ expect-stdout: KNIGHTIAN BASIC PASS

// M2 — Knightian basic: lift Knowledge to PBox preserves data and
// produces zero gap.

use epistemic::knightian::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let g = pb_from_knowledge(15.0, 0.25, 920)
    let zero_gap = pb_gap(&g) == 0.0
    let preserved = pb_lo_mean(&g) == 15.0 && pb_hi_mean(&g) == 15.0 && pb_variance(&g) == 0.25
    if zero_gap && preserved {
        println("KNIGHTIAN BASIC PASS")
    } else {
        println("KNIGHTIAN BASIC FAIL")
    }
    0
}
