//@ run-pass
//@ expect-stdout: VACUOUS PASS

// M1 — vacuous knowledge has wide bounds and zero confidence.
// Used as the safe fallback when input data is unrecoverable.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let v = ck_vacuous(0.0)
    let huge = ck_variance(&v) > 1.0e6
    let no_confidence = ck_confidence(&v) == 0
    if huge && no_confidence {
        println("VACUOUS PASS")
    } else {
        println("VACUOUS FAIL")
    }
    0
}
