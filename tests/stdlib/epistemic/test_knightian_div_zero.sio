//@ run-pass
//@ expect-stdout: KNIGHTIAN DIVZERO PASS

// M2 — Knightian division by a band straddling zero falls back to vacuous.
// Critical for clinical safety: degenerate denominator (e.g., a CrCl
// estimate that bounds [-5, +120] mL/min) must not produce a finite
// dose recommendation; it must produce a vacuous (refused) result.

use epistemic::knightian::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let numerator = pb_new(10.0, 11.0, 0.04, 950)
    let straddles_zero = pb_new(0.0 - 5.0, 120.0, 1.0, 700)
    let q = pb_div(&numerator, &straddles_zero)
    if pb_confidence(&q) == 0 {
        println("KNIGHTIAN DIVZERO PASS")
    } else {
        println("KNIGHTIAN DIVZERO FAIL")
    }
    0
}
