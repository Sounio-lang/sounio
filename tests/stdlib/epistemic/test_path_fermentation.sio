//@ run-pass
//@ expect-stdout: EPISTEMIC_PATH_SURFACE_PASS

use epistemic::path::*

fn main() -> i32 with IO, Panic {
    let measured = ep_measured_gum_i64(42000, 980)
    let imputed = ep_imputed_model_i64(42000, 980)
    let simulation = ep_simulation_i64(42000, 995)

    let measured_payload = ep_payload_from_measured_gum(measured)
    let imputed_payload = ep_payload_from_imputed_model(imputed)
    let simulation_payload = ep_payload_from_simulation(simulation)

    let same_surface = ep_same_value_confidence(measured_payload, imputed_payload)
    let same_path = ep_same_fermentation(measured_payload, imputed_payload)
    let same_knowledge = ep_same_knowledge(measured_payload, imputed_payload)

    let measured_gate = ep_accept_measured_payload(measured_payload)
    let imputed_gate = ep_accept_measured_payload(imputed_payload)
    let simulation_gate = ep_accept_measured_payload(simulation_payload)
    let simulation_own_gate = ep_accept_simulation(simulation)

    let erased = ep_discharge_path(imputed_payload, ep_discharge_reason_display())
    let erasure_ok = ep_accept_erased_for_display(erased)
    let erasure_kept_lineage = ep_erased_source_family(erased) == ep_path_imputed_model() && ep_erased_reason_tag(erased) == ep_discharge_reason_display() && ep_erased_has_discharge(erased)

    if same_surface && same_path == false && same_knowledge == false && measured_gate && imputed_gate == false && simulation_gate == false && simulation_own_gate && erasure_ok && erasure_kept_lineage {
        println("EPISTEMIC_PATH_SURFACE_PASS")
        return 0
    }

    println("EPISTEMIC_PATH_SURFACE_FAIL")
    return 1
}
