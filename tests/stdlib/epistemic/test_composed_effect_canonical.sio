//@ run-pass
//@ expect-stdout: CANONICAL PASS

// M1 — canonical_discharge of all three handlers is the identity
// on the data channels (handlers are operationally identity, anchors
// for effect-row inference only).

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let original = ck_new(15.0, 0.25, 0.01, 9.0, 1.0, 920, 1)
    let discharged = canonical_discharge(original)
    let same_value = ck_value(&discharged) == 15.0
    let same_variance = ck_variance(&discharged) == 0.25
    let same_confidence = ck_confidence(&discharged) == 920
    if same_value && same_variance && same_confidence {
        println("CANONICAL PASS")
    } else {
        println("CANONICAL FAIL")
    }
    0
}
