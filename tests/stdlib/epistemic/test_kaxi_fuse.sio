//@ run-pass
//@ description: stdlib/epistemic/kaxi.sio — kaxi_fuse inverse-variance fusion over Seq<Knowledge<f64>>
use epistemic::kaxi::*;

fn main() with IO, Alloc, Mut, Epistemic, Div, Panic {
    var s: Seq<Knowledge<f64>> = seq_new()
    s.push(measure(10.0, uncertainty: 2.0))
    s.push(measure(12.0, uncertainty: 1.0))
    let f: Knowledge<f64> = kaxi_fuse(s)
    let m: f64 = acknowledge(f, "fused mean")
    let u: f64 = uncertainty_of(f)
    var ok: i64 = 1
    // precision-weighted: mean=11.6, var=0.8 -> sigma=0.894427
    if m < 11.5999 { ok = 0 }
    if m > 11.6001 { ok = 0 }
    if u < 0.8943 { ok = 0 }
    if u > 0.8946 { ok = 0 }
    // fusing more precise data must not increase uncertainty below the best single sigma (1.0)
    if u >= 1.0 { ok = 0 }
    if ok == 1 { print("kaxi_fuse: PASS\n") } else { print("kaxi_fuse: FAIL m="); print_f64(m); print(" u="); print_f64(u); print("\n") }
}
