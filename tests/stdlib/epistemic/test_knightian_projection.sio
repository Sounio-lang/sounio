//@ run-pass
//@ expect-stdout: KNIGHTIAN PROJ PASS

// M2 — Knightian directional projection (parenthesization-invariance lever).
// Connects to HYPER_UNCERTAINTY_PARENTHESIZATION_REPORT.md: trace ties
// can be broken by a directional readout. This test verifies that
// pb_project_band scales the gap linearly with |q| and flips
// orientation correctly for q < 0.

use epistemic::knightian::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let p = pb_new(0.0 - 1.0, 3.0, 0.04, 920)

    let proj_pos = pb_project_band(&p, 2.0)
    let proj_neg = pb_project_band(&p, 0.0 - 2.0)

    let pos_correct = pb_lo_mean(&proj_pos) == 0.0 - 2.0 && pb_hi_mean(&proj_pos) == 6.0
    // Negative scalar flips orientation: lo' = -2 * 3 = -6; hi' = -2 * -1 = 2
    let neg_correct = pb_lo_mean(&proj_neg) == 0.0 - 6.0 && pb_hi_mean(&proj_neg) == 2.0

    if pos_correct && neg_correct {
        println("KNIGHTIAN PROJ PASS")
    } else {
        println("KNIGHTIAN PROJ FAIL")
    }
    0
}
