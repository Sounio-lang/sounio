// M1 — composed_effects basic constructor + accessor smoke.
// Tests ck_new, ck_value, ck_variance, ck_confidence round-trip.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let c = ck_new(15.0, 0.25, 0.01, 9.0, 1.0, 920, 1)
    if ck_value(&c) == 15.0 && ck_variance(&c) == 0.25 && ck_confidence(&c) == 920 {
        println("BASIC PASS")
    } else {
        println("BASIC FAIL")
    }
    0
}
