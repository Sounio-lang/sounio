//@ run-pass
//@ expect-stdout: KL LAMBDA SWEEP PASS

// M3.5+ — Klibanoff CE behaviour as λ varies.
//
// At α=0 (precise), CE is linear in λ:
//   CE_0(λ) = (1-ε)·μ_0 + ε·(λ·s_lo + (1-λ)·s_hi)
//          = (1-ε)·μ_0 + ε·s_hi + ε·λ·(s_lo - s_hi)
// Since s_lo < s_hi, the slope ε·(s_lo - s_hi) is negative.
// Therefore CE_0 is monotone-decreasing in λ.
//
// At λ=0: CE_0 = (1-ε)·μ_0 + ε·s_hi (upper Walley mean-band endpoint)
// At λ=1: CE_0 = (1-ε)·μ_0 + ε·s_lo (lower Walley mean-band endpoint)

use epistemic::knightian::*
use epistemic::walley::*
use epistemic::klibanoff::*

fn kls_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Div, Panic {
    let c = cs_neighborhood(15.0, 1.0, 0.2, 10.0, 20.0, 900)

    // Linear λ-sweep at α=0 (precise CE).
    let p0 = kl_precise_ce(&c, 0.0)    // λ=0 → upper endpoint
    let p_25 = kl_precise_ce(&c, 0.25)
    let p_5 = kl_precise_ce(&c, 0.5)
    let p_75 = kl_precise_ce(&c, 0.75)
    let p1 = kl_precise_ce(&c, 1.0)    // λ=1 → lower endpoint

    // Monotone-decreasing in λ.
    let mono_ok = p0 >= p_25 && p_25 >= p_5 && p_5 >= p_75 && p_75 >= p1

    // Endpoints match Walley credal_to_pbox.
    //   credal_to_pbox(c).hi_mean = 0.8·15 + 0.2·20 = 16.0
    //   credal_to_pbox(c).lo_mean = 0.8·15 + 0.2·10 = 14.0
    let p_box = credal_to_pbox(&c)
    let walley_lo = pb_lo_mean(&p_box)
    let walley_hi = pb_hi_mean(&p_box)

    let endpoint_ok = kls_abs(p0 - walley_hi) < 1.0e-9
                   && kls_abs(p1 - walley_lo) < 1.0e-9

    // Linearity: midpoint should be exact average.
    let p_mid_expected = 0.5 * (p0 + p1)
    let linearity_ok = kls_abs(p_5 - p_mid_expected) < 1.0e-9

    // At α > 0 (smooth), λ=1 should still be ≤ λ=0 (concavity of φ).
    let s_lam0 = kl_smooth_ce(&c, 1.0, 0.0)
    let s_lam1 = kl_smooth_ce(&c, 1.0, 1.0)
    let smooth_mono_ok = s_lam0 >= s_lam1

    if mono_ok && endpoint_ok && linearity_ok && smooth_mono_ok {
        println("KL LAMBDA SWEEP PASS")
    } else {
        println("KL LAMBDA SWEEP FAIL")
        if !mono_ok { println("alpha=0 mono failed") }
        if !endpoint_ok { println("walley endpoint mismatch") }
        if !linearity_ok { println("linearity failed") }
        if !smooth_mono_ok { println("smooth lambda mono failed") }
    }
    0
}
