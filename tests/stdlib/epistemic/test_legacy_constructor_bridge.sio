//@ run-pass
//@ expect-stdout: EPISTEMIC_BRIDGE_OK
use epistemic::knowledge::{Epistemic,epistemic_new,ep_val,ep_variance,ep_confidence}
use epistemic::propagate::{monte_carlo,monte_carlo_identity,monte_carlo_square,monte_carlo_2d}
use epistemic::walley::{cs_neighborhood}
use epistemic::klibanoff::{klibanoff_compose_with_active}
fn bridge_ctor(v:f64,u:f64,c:i64) with IO,Mut,Div,Panic {
 let x=epistemic_new(v,u,c)
 print("CTOR ");print_int(f64_to_bits(ep_val(&x)));print(" ")
 print_int(f64_to_bits(ep_variance(&x)));print(" ");println(ep_confidence(&x))
}
fn bridge_mc(name:string,x:&Epistemic) with IO,Mut,Div,Panic {
 print("MC ");print(name);print(" ");print_int(f64_to_bits(ep_val(x)));print(" ")
 print_int(f64_to_bits(ep_variance(x)));print(" ");println(ep_confidence(x))
}
fn bridge_identity(v:f64)->f64 with Mut,Div,Panic {v}
fn bridge_square(v:f64)->f64 with Mut,Div,Panic {v*v}
fn bridge_add(a:f64,b:f64)->f64 with Mut,Div,Panic {a+b}
fn main()->i32 with IO,Prob,Mut,Div,Panic {
 bridge_ctor(3.25,0.25,850)
 bridge_ctor(0.0-1.5,0.5,0-1)
 bridge_ctor(0.125,0.0,1001)
 bridge_ctor(0.0,1.0,500)
 let x=epistemic_new(3.0,1.0,850)
 let identity=monte_carlo_identity(x,64)
 let generic=monte_carlo(x,bridge_identity,64)
 let square=monte_carlo_square(x,64)
 let generic_square=monte_carlo(x,bridge_square,64)
 let y=epistemic_new(1.0,1.0,800)
 let sum=monte_carlo_2d(x,y,bridge_add,64)
 assert(ep_val(&identity)==ep_val(&generic))
 assert(ep_variance(&identity)==ep_variance(&generic))
 assert(ep_val(&square)==ep_val(&generic_square))
 assert(ep_variance(&square)==ep_variance(&generic_square))
 bridge_mc("identity",&identity)
 bridge_mc("generic",&generic)
 bridge_mc("square",&square)
 bridge_mc("generic_square",&generic_square)
 bridge_mc("sum",&sum)
 let reward=cs_neighborhood(10.0,0.25,0.25,6.0,15.0,800)
 let risk=klibanoff_compose_with_active(&reward,2.0,1.0,&x,0.25,1.5)
 let precise=klibanoff_compose_with_active(&reward,0.0,1.0,&x,0.25,1.5)
 assert(risk.pragmatic<precise.pragmatic)
 assert(risk.total==(0.0-risk.epistemic)-risk.pragmatic)
 print("BRIDGE risk ");print_int(f64_to_bits(risk.epistemic));print(" ")
 print_int(f64_to_bits(risk.pragmatic));print(" ");print_int(f64_to_bits(risk.total));print("\n")
 print("BRIDGE precise ");print_int(f64_to_bits(precise.epistemic));print(" ")
 print_int(f64_to_bits(precise.pragmatic));print(" ");print_int(f64_to_bits(precise.total));print("\n")
 println("EPISTEMIC_BRIDGE_OK")
 0
}
