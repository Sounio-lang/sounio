//@ run-pass
//@ expect-stdout: WALLEY WIDTH MONOTONE PASS

// M3.5 — Walley credal set: gap monotone-non-decreasing in ε.
// Mirrors the structural claim of
// formal/lean4/SounioWalley.lean :: walley_gap_monotone_in_epsilon_nat.
//
// Eleven discrete ε-values in [0, 1]: gap must be non-decreasing.

use epistemic::knightian::*
use epistemic::walley::*

fn make_at(eps: f64) -> CredalSet with Mut {
    cs_neighborhood(50.0, 25.0, eps, 20.0, 100.0, 900)
}

fn gap_at(eps: f64) -> f64 with Mut, Div, Panic {
    let c = make_at(eps)
    let p = credal_to_pbox(&c)
    pb_gap(&p)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let g0 = gap_at(0.0)
    let g1 = gap_at(0.1)
    let g2 = gap_at(0.2)
    let g3 = gap_at(0.3)
    let g4 = gap_at(0.4)
    let g5 = gap_at(0.5)
    let g6 = gap_at(0.6)
    let g7 = gap_at(0.7)
    let g8 = gap_at(0.8)
    let g9 = gap_at(0.9)
    let g10 = gap_at(1.0)

    // Each step: g_{i+1} >= g_i (strict given positive support width).
    let monotone_ok = g0 <= g1 && g1 <= g2 && g2 <= g3 && g3 <= g4 && g4 <= g5
                   && g5 <= g6 && g6 <= g7 && g7 <= g8 && g8 <= g9 && g9 <= g10

    // Endpoints: gap(0)=0, gap(1)=80 (= 100 − 20).
    let endpoints_ok = g0 == 0.0 && g10 == 80.0

    // Linear scaling: gap(0.5) ≈ 40, gap(0.25-ish) etc.
    // Use g5 (eps=0.5) ≈ 40 with float tolerance.
    let mid_ok = g5 > 39.999 && g5 < 40.001

    if monotone_ok && endpoints_ok && mid_ok {
        println("WALLEY WIDTH MONOTONE PASS")
    } else {
        println("WALLEY WIDTH MONOTONE FAIL")
    }
    0
}
