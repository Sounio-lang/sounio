//@ run-pass
//@ expect-stdout: KL BOUNDARY PASS

// M3.5+ — Klibanoff smooth-ambiguity boundary tests.
// Mirrors structural claims of formal/lean4/SounioKlibanoff.lean:
//   - kl_precise_ce_collapse_at_zero_eps
//   - kl_walley_ce_at_lambda_one
//   - kl_walley_ce_at_lambda_zero
//   - kl_precise_ce_at_lambda_one_equals_lift_lo

use epistemic::knightian::*
use epistemic::walley::*
use epistemic::klibanoff::*

fn kb_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Div, Panic {
    // 1. ε=0 collapse: precise CE = nominal mean regardless of λ.
    let cprec = cs_precise(15.0, 1.0, 10.0, 20.0, 950)
    let p_lam0 = kl_precise_ce(&cprec, 0.0)
    let p_lam05 = kl_precise_ce(&cprec, 0.5)
    let p_lam1 = kl_precise_ce(&cprec, 1.0)
    let collapse_ok = p_lam0 == 15.0 && p_lam05 == 15.0 && p_lam1 == 15.0

    // 2. λ=1 with s_lo ≤ μ_0: Walley CE = s_lo.
    let c = cs_neighborhood(15.0, 1.0, 0.2, 10.0, 20.0, 900)
    let w_lam1 = kl_walley_ce(&c, 1.0)
    let lambda1_ok = w_lam1 == 10.0

    // 3. λ=0 with μ_0 ≤ s_hi: Walley CE = μ_0 (NOT s_lo!).
    //    The math-review correction: with no contamination weight on
    //    s_lo, the minimum is over {μ_0, s_hi}, hence μ_0.
    let w_lam0 = kl_walley_ce(&c, 0.0)
    let lambda0_ok = w_lam0 == 15.0

    // 4. λ=1 precise CE on a non-degenerate CredalSet coincides with
    //    Walley lift_lo. For c (ε=0.2):
    //      (1-0.2)·15 + 0.2·10 = 14.0  (= credal_to_pbox(c).lo_mean)
    let p_c_lam1 = kl_precise_ce(&c, 1.0)
    let pb = credal_to_pbox(&c)
    let coincide_ok = kb_abs(p_c_lam1 - pb_lo_mean(&pb)) < 1.0e-9
                   && kb_abs(p_c_lam1 - 14.0) < 1.0e-9

    // 5. CE_α at α=0.5 should sit between walley and precise.
    let smooth = kl_smooth_ce(&c, 0.5, 1.0)
    let walley = kl_walley_ce(&c, 1.0)
    let precise = kl_precise_ce(&c, 1.0)
    let sandwich_ok = walley <= smooth && smooth <= precise + 1.0e-6

    if collapse_ok && lambda1_ok && lambda0_ok && coincide_ok && sandwich_ok {
        println("KL BOUNDARY PASS")
    } else {
        println("KL BOUNDARY FAIL")
        if !collapse_ok { println("eps=0 collapse failed") }
        if !lambda1_ok { println("lambda=1 walley failed") }
        if !lambda0_ok { println("lambda=0 walley failed") }
        if !coincide_ok { println("walley coincide failed") }
        if !sandwich_ok { println("sandwich failed") }
    }
    0
}
