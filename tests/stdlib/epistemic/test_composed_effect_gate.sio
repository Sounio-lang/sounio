//@ run-pass
//@ expect-stdout: GATE PASS

// M1 — composite gate enforces all three channels (confidence, causal,
// approx) simultaneously. Failing any one should block the gate.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let high_quality = ck_new(15.0, 0.04, 0.001, 9.0, 1.0, 950, 1)
    let low_confidence = ck_new(15.0, 0.04, 0.001, 9.0, 1.0, 500, 1)
    let high_approx = ck_new(15.0, 0.04, 5.0, 9.0, 1.0, 950, 1)
    let low_causal = ck_new(15.0, 0.04, 0.001, 1.0, 9.0, 950, 1)

    let p1 = ck_passes_gate(&high_quality, 800, 0.5, 1.0)
    let p2 = ck_passes_gate(&low_confidence, 800, 0.5, 1.0)
    let p3 = ck_passes_gate(&high_approx, 800, 0.5, 1.0)
    let p4 = ck_passes_gate(&low_causal, 800, 0.5, 1.0)

    if p1 && !p2 && !p3 && !p4 {
        println("GATE PASS")
    } else {
        println("GATE FAIL")
    }
    0
}
