//@ run-pass
//@ expect-stdout: KNIGHTIAN_EXPANDED_SCALE_PASS

// Scale witness for pb_expanded: the band must be value +- k*sqrt(variance)
// across 24 decades of variance, with the variance moved into the band.
// References are exact (sqrt of 1e-12, 0.25, 1e12 = 1e-6, 0.5, 1e6), so no
// independent sqrt is needed. Before the range-reduced pb_sqrt, v = 1e-12
// gave a half-width of 7.32e-4 instead of 3e-6 (~244x).

use epistemic::knightian::*

fn rel_ok(got: f64, want: f64) -> bool {
    let d = if got > want { got - want } else { want - got }
    let w = if want < 0.0 { 0.0 - want } else { want }
    d <= 1.0e-12 * w
}

fn check(v: f64, half: f64) -> bool with Mut, Div, Panic {
    let p = pb_expanded(0.0, v, 3.0, 1000)
    rel_ok(pb_lo_mean(&p), 0.0 - 3.0 * half) && rel_ok(pb_hi_mean(&p), 3.0 * half) && pb_variance(&p) == 0.0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var ok = true
    if !check(1.0e-12, 1.0e-6) { println("FAIL v=1e-12"); ok = false }
    if !check(0.25, 0.5) { println("FAIL v=0.25"); ok = false }
    if !check(1.0e12, 1.0e6) { println("FAIL v=1e12"); ok = false }
    // v = 0 and negative variance collapse to the point value.
    let z = pb_expanded(2.0, 0.0, 3.0, 1000)
    if pb_lo_mean(&z) != 2.0 || pb_hi_mean(&z) != 2.0 { println("FAIL v=0"); ok = false }
    let n = pb_expanded(2.0, 0.0 - 1.0, 3.0, 1000)
    if pb_lo_mean(&n) != 2.0 || pb_hi_mean(&n) != 2.0 { println("FAIL v<0"); ok = false }
    // k = 0 and negative k recover the zero-gap lift.
    let k0 = pb_expanded(2.0, 4.0, 0.0, 1000)
    if pb_lo_mean(&k0) != 2.0 || pb_hi_mean(&k0) != 2.0 { println("FAIL k=0"); ok = false }
    let kn = pb_expanded(2.0, 4.0, 0.0 - 1.0, 1000)
    if pb_lo_mean(&kn) != 2.0 || pb_hi_mean(&kn) != 2.0 { println("FAIL k<0"); ok = false }
    if !ok { return 1 }
    println("KNIGHTIAN_EXPANDED_SCALE_PASS")
    0
}
