//@ run-pass
//@ expect-stdout: CHAIN PASS

// M1 — long chain of operations exhibits monotonic confidence decay
// and bounded variance growth. This is the operational soundness
// test that all four arithmetic ops compose without exploding.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    var c = ck_new(1.0, 0.001, 0.0001, 9.0, 1.0, 990, 1)
    let step = ck_new(1.01, 0.0001, 0.00001, 9.0, 1.0, 990, 1)

    var i: i64 = 0
    while i < 5 {
        c = ck_mul(&c, &step)
        i = i + 1
    }
    let final_conf = ck_confidence(&c)
    let final_var_ok = ck_variance(&c) > 0.0 && ck_variance(&c) < 1.0
    let monotonic_decay = final_conf < 990 && final_conf > 800

    if monotonic_decay && final_var_ok {
        println("CHAIN PASS")
    } else {
        println("CHAIN FAIL")
    }
    0
}
