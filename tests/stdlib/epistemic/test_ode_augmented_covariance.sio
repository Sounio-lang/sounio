//@ run-pass
//@ timeout: 120
// tests/stdlib/epistemic/test_ode_augmented_covariance.sio
//
// solve_ode's variances must be the first-order GUM variance of the actual
// solution, including state-parameter correlation. Closed form, evaluated in
// Sounio (sounio_native_expected):
//
//   dy/dt = -k y,  y(0) = y0 +- u0,  k +- uk, independent inputs
//   y(t)   = y0 exp(-k t)
//   Var(t) = exp(-2kt) u0^2 + (y0 t exp(-kt))^2 uk^2
//
// RK4 at k dt = 0.01 matches exp(-k t) to ~1e-11 relative, so the only
// tolerance needed is the central-difference Jacobian's (h = 1e-7 relative).
// The diagonal I + dt*J scheme this replaces rebuilds the state-parameter
// correlation from zero at every step and misses the (y0 t)^2 growth.

use epistemic::ode::*

fn absf(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn expn(x: f64) -> f64 with Mut, Div, Panic {
    // exp(-x), x >= 0, halving and squaring
    var y = x
    var k = 0
    while y > 0.5 {
        y = y / 2.0
        k = k + 1
    }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i < 30 {
        term = 0.0 - term * y / (i as f64)
        sum = sum + term
        i = i + 1
    }
    while k > 0 {
        sum = sum * sum
        k = k - 1
    }
    sum
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fail: i32 = 0
    let y0 = 1.0
    let u0 = 0.1
    let kk = 0.1
    let uk = 0.01
    let dt = 0.1
    let nsteps = 20
    let t_end = dt * (nsteps as f64)

    var init = estate_new(1)
    estate_set(&!init, 0, y0, u0 * u0)
    var p = ode_params_new()
    ode_params_set(&!p, 0, kk, uk * uk)
    let sol = solve_ode(ode_system_exp_decay(), init, p, 0.0, t_end, solver_options_fixed(dt, nsteps))
    let last = sol.n_steps - 1

    let e1 = expn(kk * t_end)
    let v_exact = e1 * e1 * u0 * u0 + (y0 * t_end * e1) * (y0 * t_end * e1) * uk * uk
    let y_exact = y0 * e1
    let y = solution_get_value(&sol, last, 0)
    let v = solution_get_variance(&sol, last, 0)
    // without the parameter term, for discrimination
    let v_no_param = e1 * e1 * u0 * u0

    print("y=") print(y) print(" exact=") print(y_exact) println("")
    print("var=") print(v) print(" exact=") print(v_exact) print(" state-only=") print(v_no_param) println("")
    print("covariance_mode=") print(sol.covariance_mode) println("")

    if !(absf(y - y_exact) <= 0.000000001) { fail = fail + 1 println("FAIL value") }
    if !(absf(v / v_exact - 1.0) <= 0.00001) { fail = fail + 1 println("FAIL variance vs closed form") }
    // the parameter contribution here is 4% of the total, 4000x the tolerance
    if absf(v / v_no_param - 1.0) < 0.01 { fail = fail + 1 println("FAIL test cannot see the parameter term") }
    if sol.covariance_mode != 1 { fail = fail + 1 println("FAIL covariance mode") }

    if fail == 0 { println("ODE AUGMENTED COVARIANCE PASS") }
    fail
}
