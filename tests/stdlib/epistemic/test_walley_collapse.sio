//@ run-pass
//@ expect-stdout: WALLEY COLLAPSE PASS

// M3.5 — Walley credal set: collapse-at-ε=0 yields precise p-box.
// Mirrors the structural claim of
// formal/lean4/SounioWalley.lean :: walley_collapse_at_zero_nat.

use epistemic::knightian::*
use epistemic::walley::*

fn main() -> i32 with IO, Mut, Div, Panic {
    // ε=0 ⇒ lifted lo == hi == nominal_mean, var == nominal_variance.
    let c = cs_precise(15.0, 0.25, 5.0, 25.0, 950)
    let p = credal_to_pbox(&c)

    let lo_ok = pb_lo_mean(&p) == 15.0
    let hi_ok = pb_hi_mean(&p) == 15.0
    let var_ok = pb_variance(&p) == 0.25
    let gap_ok = pb_gap(&p) == 0.0

    if lo_ok && hi_ok && var_ok && gap_ok {
        println("WALLEY COLLAPSE PASS")
    } else {
        println("WALLEY COLLAPSE FAIL")
    }
    0
}
