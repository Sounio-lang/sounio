//@ run-pass
//@ expect-stdout: WALLEY SUPPORT LIFT PASS

// M3.5 — Walley credal set: credal_to_support_pbox produces the
// vacuous worst-case p-box [s_lo, s_hi] regardless of (μ_0, σ²_0, ε).
// This is the lift to use when feeding into Fréchet enclosure for
// nonlinear monotone propagation.

use epistemic::knightian::*
use epistemic::walley::*

fn pb_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Mut, Div, Panic {
    // Three credal sets sharing the same support but different
    // nominal/ε. The support lifts must be IDENTICAL.
    let c_a = cs_neighborhood(50.0, 25.0, 0.05, 20.0, 100.0, 900)
    let c_b = cs_neighborhood(80.0,  5.0, 0.50, 20.0, 100.0, 900)
    let c_c = cs_vacuous(20.0, 100.0, 900)

    let p_a = credal_to_support_pbox(&c_a)
    let p_b = credal_to_support_pbox(&c_b)
    let p_c = credal_to_support_pbox(&c_c)

    let same_lo = pb_lo_mean(&p_a) == pb_lo_mean(&p_b) && pb_lo_mean(&p_b) == pb_lo_mean(&p_c)
    let same_hi = pb_hi_mean(&p_a) == pb_hi_mean(&p_b) && pb_hi_mean(&p_b) == pb_hi_mean(&p_c)
    let support_band_ok = pb_lo_mean(&p_a) == 20.0 && pb_hi_mean(&p_a) == 100.0

    // Variance is Popoviciu maximum: ((100-20)/2)² = 40² = 1600.
    let popoviciu = 1600.0
    let var_ok = pb_abs(pb_variance(&p_a) - popoviciu) < 1.0e-9

    if same_lo && same_hi && support_band_ok && var_ok {
        println("WALLEY SUPPORT LIFT PASS")
    } else {
        println("WALLEY SUPPORT LIFT FAIL")
    }
    0
}
