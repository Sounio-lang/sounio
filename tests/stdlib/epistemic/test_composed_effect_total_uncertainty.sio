//@ run-pass
//@ expect-stdout: TOTAL PASS

// M1 — total uncertainty aggregates GUM σ + Approx + causal-doubt.
// For confident inputs (high alpha, low beta), causal_doubt is small.
// For high-Approx inputs, total dominated by approx.

use epistemic::composed_effects::*

fn main() -> i32 with IO, Mut, Div, Panic, Approx, Causal {
    let confident = ck_new(10.0, 0.04, 0.001, 99.0, 1.0, 950, 1)
    let approx_heavy = ck_new(10.0, 0.04, 5.0, 99.0, 1.0, 950, 1)

    let u1 = ck_total_uncertainty(&confident)
    let u2 = ck_total_uncertainty(&approx_heavy)

    if u2 > u1 + 4.0 && u1 < 1.0 {
        println("TOTAL PASS")
    } else {
        println("TOTAL FAIL")
    }
    0
}
