//@ run-pass
use algebra::xor_convolution::{
    xor_convolution_evaluate,
    xor_digest_nonzero,
    xor_convolution_matches_frozen_semantics,
}

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let result = xor_convolution_evaluate(4)
    if !result.contract.valid { return 1 }
    if result.mismatch_count != 0 { return 2 }
    if result.negatives.passed != result.negatives.total { return 3 }
    if !xor_digest_nonzero(&result.contract_digest) { return 4 }
    if !xor_digest_nonzero(&result.input_digest) { return 5 }
    if !xor_digest_nonzero(&result.direct_digest) { return 6 }
    if !xor_digest_nonzero(&result.horizontal_digest) { return 7 }
    if !xor_digest_nonzero(&result.twist_table_digest) { return 8 }
    if !xor_digest_nonzero(&result.property_digest) { return 9 }
    if !xor_digest_nonzero(&result.witness_digest) { return 10 }
    if result.failures != 0 { return 11 }
    if !xor_convolution_matches_frozen_semantics(&result) { return 12 }
    print("XOR_CONVOLUTION_OK\n")
    0
}
