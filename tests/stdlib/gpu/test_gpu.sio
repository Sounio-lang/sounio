// =============================================================================
// Tilelang — pure struct returns, safe across call boundaries
// =============================================================================

fn test_tilelang_block_spec_new() -> i32 {
    // T38
    let bs = block_spec_new(64, 32, 16)
    if bs.blk_m != 64 { return 1 }
    if bs.blk_n != 32 { return 2 }
    if bs.blk_k != 16 { return 3 }
    return 0
}

fn test_tilelang_preset_specs() -> i32 {
    // T39
    let mm = block_spec_matmul()
    if mm.blk_m != 128 { return 1 }
    if mm.blk_n != 128 { return 2 }
    if mm.blk_k != 32 { return 3 }

    let att = block_spec_attention()
    if att.blk_m != 64 { return 4 }
    if att.blk_k != 64 { return 5 }

    let ew = block_spec_elementwise()
    if ew.blk_m != 256 { return 6 }

    let red = block_spec_reduction()
    if red.blk_m != 1024 { return 7 }
    return 0
}

fn test_tilelang_schedule_default() -> i32 {
    // T40
    let s = schedule_default()
    if s.block.dim_x != 128 { return 1 }
    if s.block.dim_y != 1 { return 2 }
    if s.n_warps != 4 { return 3 }
    if s.use_tensor_cores { return 4 }
    if s.loops.unroll_factor != 4 { return 5 }
    if s.memory.prefetch_depth != 1 { return 6 }
    return 0
}

fn test_tilelang_schedule_matmul() -> i32 {
    // T41
    let s = schedule_matmul(256, 256, 256)
    if s.block.dim_x != 16 { return 1 }
    if s.block.dim_y != 16 { return 2 }
    if s.n_warps != 8 { return 3 }
    if !s.memory.use_async_copy { return 4 }
    if s.memory.prefetch_depth != 2 { return 5 }
    if s.loops.pipeline_depth != 2 { return 6 }
    return 0
}

fn test_tilelang_schedule_attention_large() -> i32 {
    // T42 — seq_len > 128 => block_m capped at 128
    let s = schedule_attention(512, 64)
    if s.block.dim_x != 128 { return 1 }
    if !s.use_tensor_cores { return 2 }
    if s.loops.pipeline_depth != 3 { return 3 }
    if s.loops.unroll_factor != 8 { return 4 }
    return 0
}

fn test_tilelang_schedule_attention_small() -> i32 {
    // T43 — seq_len <= 128 => block_m = seq_len
    let s = schedule_attention(64, 64)
    if s.block.dim_x != 64 { return 1 }
    if !s.use_tensor_cores { return 2 }
    return 0
}

fn test_tilelang_schedule_elementwise() -> i32 {
    // T44
    let s = schedule_elementwise(1024)
    if s.block.dim_x != 256 { return 1 }
    if s.memory.shared_mem_bytes != 0 { return 2 }
    if s.loops.vectorize_width != 8 { return 3 }
    if s.n_warps != 8 { return 4 }
    if s.use_tensor_cores { return 5 }
    return 0
}

fn test_tilelang_kernel_matmul() -> i32 {
    // T45
    let k = kernel_matmul(256, 256, 128)
    if k.m != 256 { return 1 }
    if k.n != 256 { return 2 }
    if k.k != 128 { return 3 }
    if k.dtype != 1 { return 4 }
    if k.block.blk_m != 128 { return 5 }
    if k.block.blk_k != 32 { return 6 }
    return 0
}

fn test_tilelang_kernel_attention() -> i32 {
    // T46
    let k = kernel_attention(256, 64)
    if k.m != 256 { return 1 }
    if k.n != 256 { return 2 }
    if k.k != 64 { return 3 }
    if k.block.blk_m != 64 { return 4 }
    if k.block.blk_k != 64 { return 5 }
    return 0
}

fn test_tilelang_kernel_elementwise() -> i32 {
    // T47
    let k = kernel_elementwise(512)
    if k.m != 512 { return 1 }
    if k.n != 1 { return 2 }
    if k.k != 1 { return 3 }
    if k.block.blk_m != 256 { return 4 }
    return 0
}

fn test_tilelang_compute_grid_matmul() -> i32 with Panic {
    // T48 — 256×512 / (128×128) tile => grid 2×4
    let k = kernel_matmul(256, 512, 128)
    let g = compute_grid(&k)
    if g.grid_x != 2 { return 1 }
    if g.grid_y != 4 { return 2 }
    if g.grid_z != 1 { return 3 }
    if g.block_x != 16 { return 4 }
    if g.block_y != 16 { return 5 }
    return 0
}

fn test_tilelang_compute_grid_elementwise() -> i32 with Panic {
    // T49 — 1024 elements / 256-wide tile => grid_x=4
    let k = kernel_elementwise(1024)
    let g = compute_grid(&k)
    if g.grid_x != 4 { return 1 }
    if g.grid_y != 1 { return 2 }
    if g.shared_mem != 0 { return 3 }
    return 0
}

fn test_tilelang_grid_shared_mem() -> i32 with Panic {
    // T50 — matmul shared mem = 16*16*8*2 = 4096 bytes
    let k = kernel_matmul(128, 128, 64)
    let g = compute_grid(&k)
    if g.shared_mem != 4096 { return 1 }
    return 0
}

fn test_tilelang_compute_grid_exact_tile() -> i32 with Panic {
    // T51 — m=128=blk_m exactly => grid_x=1
    let k = kernel_matmul(128, 128, 32)
    let g = compute_grid(&k)
    if g.grid_x != 1 { return 1 }
    if g.grid_y != 1 { return 2 }
    return 0
}

fn test_tilelang_attention_shared_mem() -> i32 with Panic {
    // T52 — attention schedule uses 96KB shared mem
    let k = kernel_attention(256, 64)
    let g = compute_grid(&k)
    if g.shared_mem != 98304 { return 1 }
    return 0
}

// =============================================================================
// Runner
// =============================================================================

fn run_all() -> i32 with IO, Mut, Panic, Div {
    var fail: i32 = 0

    // FFT helpers
    if test_fft_log2() != 0 { fail = fail + 1 }
    if test_fft_bit_reverse() != 0 { fail = fail + 1 }
    if test_fft_sin_cos_identity() != 0 { fail = fail + 1 }
    if test_fft_sin_known_values() != 0 { fail = fail + 1 }
    if test_fft_cos_known_values() != 0 { fail = fail + 1 }

    // FFT forward (inlined)
    if test_fft_dc_component() != 0 { fail = fail + 1 }
    if test_fft_roundtrip_4() != 0 { fail = fail + 1 }
    if test_fft_single_element() != 0 { fail = fail + 1 }
    if test_fft_n2_real_signal() != 0 { fail = fail + 1 }

    // Smooth (inlined)
    if test_gaussian_constant_signal() != 0 { fail = fail + 1 }
    if test_gaussian_zero_sigma_copies() != 0 { fail = fail + 1 }
    if test_moving_avg_constant() != 0 { fail = fail + 1 }
    if test_moving_avg_window_1() != 0 { fail = fail + 1 }
    if test_bilateral_constant_signal() != 0 { fail = fail + 1 }
    if test_bilateral_zero_sigma_copies() != 0 { fail = fail + 1 }
    if test_ema_constant() != 0 { fail = fail + 1 }
    if test_ema_monotone_rise() != 0 { fail = fail + 1 }

    // Stats (shared-ref, safe)
    if test_stats_sum_empty() != 0 { fail = fail + 1 }
    if test_stats_sum() != 0 { fail = fail + 1 }
    if test_stats_mean() != 0 { fail = fail + 1 }
    if test_stats_mean_single() != 0 { fail = fail + 1 }
    if test_stats_mean_empty() != 0 { fail = fail + 1 }
    if test_stats_variance() != 0 { fail = fail + 1 }
    if test_stats_variance_constant() != 0 { fail = fail + 1 }
    if test_stats_stddev() != 0 { fail = fail + 1 }
    if test_stats_min_max() != 0 { fail = fail + 1 }
    if test_stats_min_single() != 0 { fail = fail + 1 }
    if test_stats_histogram() != 0 { fail = fail + 1 }
    if test_stats_histogram_clamp() != 0 { fail = fail + 1 }
    if test_stats_compute_stats() != 0 { fail = fail + 1 }
    if test_stats_compute_stats_empty() != 0 { fail = fail + 1 }
    if test_stats_dot_product() != 0 { fail = fail + 1 }
    if test_stats_dot_orthogonal() != 0 { fail = fail + 1 }
    if test_stats_norm_l2() != 0 { fail = fail + 1 }
    if test_stats_norm_l2_unit() != 0 { fail = fail + 1 }
    if test_stats_norm_l1() != 0 { fail = fail + 1 }
    if test_stats_norm_l1_zero() != 0 { fail = fail + 1 }

    // Tilelang (pure struct returns)
    if test_tilelang_block_spec_new() != 0 { fail = fail + 1 }
    if test_tilelang_preset_specs() != 0 { fail = fail + 1 }
    if test_tilelang_schedule_default() != 0 { fail = fail + 1 }
    if test_tilelang_schedule_matmul() != 0 { fail = fail + 1 }
    if test_tilelang_schedule_attention_large() != 0 { fail = fail + 1 }
    if test_tilelang_schedule_attention_small() != 0 { fail = fail + 1 }
    if test_tilelang_schedule_elementwise() != 0 { fail = fail + 1 }
    if test_tilelang_kernel_matmul() != 0 { fail = fail + 1 }
    if test_tilelang_kernel_attention() != 0 { fail = fail + 1 }
    if test_tilelang_kernel_elementwise() != 0 { fail = fail + 1 }
    if test_tilelang_compute_grid_matmul() != 0 { fail = fail + 1 }
    if test_tilelang_compute_grid_elementwise() != 0 { fail = fail + 1 }
    if test_tilelang_grid_shared_mem() != 0 { fail = fail + 1 }
    if test_tilelang_compute_grid_exact_tile() != 0 { fail = fail + 1 }
    if test_tilelang_attention_shared_mem() != 0 { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    return run_all()
}
