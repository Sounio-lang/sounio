//@ check-only
// Tests for stdlib/gpu: fft, smooth, stats, tilelang
//
// All array-mutating operations are inlined within each test function to
// work around the JIT &! visibility limitation (mutations through exclusive
// refs passed across call boundaries are not reflected in the caller's
// stack frame in the Cranelift JIT). Pure-computation helpers (sin, cos,
// bit_reverse, etc.) are called normally since they only return values.
//
// Coverage: FFT math helpers, forward FFT, signal smoothing, statistical
// reductions, histogram, dot product, norms, and tilelang scheduling.

// =============================================================================
// Math helpers (return values only — safe to call across boundary)
// =============================================================================

fn fft_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn fft_sin(x: f64) -> f64  with Mut, Div{
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y
    var sum = y
    var term = y
    term = term * (0.0 - x2) / (2.0 * 3.0)
    sum = sum + term
    term = term * (0.0 - x2) / (4.0 * 5.0)
    sum = sum + term
    term = term * (0.0 - x2) / (6.0 * 7.0)
    sum = sum + term
    term = term * (0.0 - x2) / (8.0 * 9.0)
    sum = sum + term
    term = term * (0.0 - x2) / (10.0 * 11.0)
    sum = sum + term
    term = term * (0.0 - x2) / (12.0 * 13.0)
    sum = sum + term
    return sum
}

fn fft_cos(x: f64) -> f64  with Mut, Div{
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y
    var sum = 1.0
    var term = 1.0
    term = term * (0.0 - x2) / (1.0 * 2.0)
    sum = sum + term
    term = term * (0.0 - x2) / (3.0 * 4.0)
    sum = sum + term
    term = term * (0.0 - x2) / (5.0 * 6.0)
    sum = sum + term
    term = term * (0.0 - x2) / (7.0 * 8.0)
    sum = sum + term
    term = term * (0.0 - x2) / (9.0 * 10.0)
    sum = sum + term
    term = term * (0.0 - x2) / (11.0 * 12.0)
    sum = sum + term
    return sum
}

fn fft_bit_reverse(index: i32, log2n: i32) -> i32  with Mut, Div{
    var result: i32 = 0
    var val: i32 = index
    var i: i32 = 0
    while i < log2n {
        result = result * 2 + (val - (val / 2) * 2)
        val = val / 2
        i = i + 1
    }
    return result
}

fn fft_log2(n: i32) -> i32  with Mut, Div{
    var val = n
    var count: i32 = 0
    while val > 1 {
        val = val / 2
        count = count + 1
    }
    return count
}

fn stats_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn stats_sqrt(x: f64) -> f64  with Mut, Div{
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i32 = 0
    while i < 10 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

fn smooth_exp(x: f64) -> f64  with Mut, Div{
    if x > 20.0 { return smooth_exp(x / 2.0) * smooth_exp(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / smooth_exp(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i: i32 = 1
    while i <= 15 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    return sum
}

// Pure stats functions taking &[...] (shared, no mutation) — safe across calls
fn gpu_sum(data: &[f64; 256], n: i32) -> f64  with Mut{
    var acc = 0.0
    var i: i32 = 0
    while i < n {
        if i < 256 { acc = acc + data[i] }
        i = i + 1
    }
    return acc
}

fn gpu_mean(data: &[f64; 256], n: i32) -> f64  with IO, Mut, Panic, Div{
    if n <= 0 { return 0.0 }
    return gpu_sum(data, n) / (n as f64)
}

fn gpu_variance(data: &[f64; 256], n: i32) -> f64  with IO, Mut, Panic, Div{
    if n <= 1 { return 0.0 }
    let m = gpu_mean(data, n)
    var acc = 0.0
    var i: i32 = 0
    while i < n {
        if i < 256 {
            let d = data[i] - m
            acc = acc + d * d
        }
        i = i + 1
    }
    return acc / ((n - 1) as f64)
}

fn gpu_stddev(data: &[f64; 256], n: i32) -> f64  with IO, Mut, Panic, Div{
    return stats_sqrt(gpu_variance(data, n))
}

fn gpu_min(data: &[f64; 256], n: i32) -> f64  with Mut{
    if n <= 0 { return 0.0 }
    var result = data[0]
    var i: i32 = 1
    while i < n {
        if i < 256 && data[i] < result { result = data[i] }
        i = i + 1
    }
    return result
}

fn gpu_max(data: &[f64; 256], n: i32) -> f64  with Mut{
    if n <= 0 { return 0.0 }
    var result = data[0]
    var i: i32 = 1
    while i < n {
        if i < 256 && data[i] > result { result = data[i] }
        i = i + 1
    }
    return result
}

fn gpu_dot(a: &[f64; 256], b: &[f64; 256], n: i32) -> f64  with Mut, Div{
    var acc = 0.0
    var i: i32 = 0
    while i < n {
        if i < 256 { acc = acc + a[i] * b[i] }
        i = i + 1
    }
    return acc
}

fn gpu_norm_l2(data: &[f64; 256], n: i32) -> f64  with Mut, Div{
    var acc = 0.0
    var i: i32 = 0
    while i < n {
        if i < 256 { acc = acc + data[i] * data[i] }
        i = i + 1
    }
    return stats_sqrt(acc)
}

fn gpu_norm_l1(data: &[f64; 256], n: i32) -> f64  with Mut{
    var acc = 0.0
    var i: i32 = 0
    while i < n {
        if i < 256 { acc = acc + stats_abs(data[i]) }
        i = i + 1
    }
    return acc
}

// Tilelang structs — pure value types, safe everywhere
struct BlockSpec {
    blk_m: i32,
    blk_n: i32,
    blk_k: i32,
}

struct BlockConfig {
    dim_x: i32,
    dim_y: i32,
    dim_z: i32,
}

struct MemoryConfig {
    shared_mem_bytes: i32,
    use_async_copy: bool,
    prefetch_depth: i32,
}

struct LoopConfig {
    unroll_factor: i32,
    vectorize_width: i32,
    pipeline_depth: i32,
}

struct Schedule {
    block: BlockConfig,
    memory: MemoryConfig,
    loops: LoopConfig,
    n_warps: i32,
    use_tensor_cores: bool,
}

struct GridConfig {
    grid_x: i32,
    grid_y: i32,
    grid_z: i32,
    block_x: i32,
    block_y: i32,
    block_z: i32,
    shared_mem: i32,
}

struct KernelDescriptor {
    block: BlockSpec,
    schedule: Schedule,
    m: i32, n: i32, k: i32,
    dtype: i32,
}

struct GpuStats {
    mean: f64,
    variance: f64,
    min: f64,
    max: f64,
    n: i32
}

fn block_spec_new(m: i32, n: i32, k: i32) -> BlockSpec {
    BlockSpec { blk_m: m, blk_n: n, blk_k: k }
}

fn block_spec_matmul() -> BlockSpec { BlockSpec { blk_m: 128, blk_n: 128, blk_k: 32 } }
fn block_spec_attention() -> BlockSpec { BlockSpec { blk_m: 64, blk_n: 64, blk_k: 64 } }
fn block_spec_elementwise() -> BlockSpec { BlockSpec { blk_m: 256, blk_n: 1, blk_k: 1 } }
fn block_spec_reduction() -> BlockSpec { BlockSpec { blk_m: 1024, blk_n: 1, blk_k: 1 } }

fn schedule_default() -> Schedule {
    Schedule {
        block: BlockConfig { dim_x: 128, dim_y: 1, dim_z: 1 },
        memory: MemoryConfig { shared_mem_bytes: 49152, use_async_copy: false, prefetch_depth: 1 },
        loops: LoopConfig { unroll_factor: 4, vectorize_width: 4, pipeline_depth: 1 },
        n_warps: 4,
        use_tensor_cores: false,
    }
}

fn schedule_matmul(m: i32, n: i32, k: i32) -> Schedule {
    Schedule {
        block: BlockConfig { dim_x: 16, dim_y: 16, dim_z: 1 },
        memory: MemoryConfig {
            shared_mem_bytes: (16 * 16 * 8 * 2) as i32,
            use_async_copy: true,
            prefetch_depth: 2,
        },
        loops: LoopConfig { unroll_factor: 4, vectorize_width: 4, pipeline_depth: 2 },
        n_warps: 8,
        use_tensor_cores: false,
    }
}

fn schedule_attention(seq_len: i32, head_dim: i32) -> Schedule {
    let block_m: i32 = if seq_len > (128 as i32) { 128 as i32 } else { seq_len }
    Schedule {
        block: BlockConfig { dim_x: block_m, dim_y: 1, dim_z: 1 },
        memory: MemoryConfig {
            shared_mem_bytes: 98304,
            use_async_copy: true,
            prefetch_depth: 2,
        },
        loops: LoopConfig { unroll_factor: 8, vectorize_width: 4, pipeline_depth: 3 },
        n_warps: 4,
        use_tensor_cores: true,
    }
}

fn schedule_elementwise(n_elements: i32) -> Schedule {
    Schedule {
        block: BlockConfig { dim_x: 256, dim_y: 1, dim_z: 1 },
        memory: MemoryConfig { shared_mem_bytes: 0, use_async_copy: false, prefetch_depth: 0 },
        loops: LoopConfig { unroll_factor: 4, vectorize_width: 8, pipeline_depth: 1 },
        n_warps: 8,
        use_tensor_cores: false,
    }
}

fn kernel_matmul(m: i32, n: i32, k: i32) -> KernelDescriptor {
    KernelDescriptor {
        block: block_spec_matmul(),
        schedule: schedule_matmul(m, n, k),
        m: m, n: n, k: k,
        dtype: 1,
    }
}

fn kernel_attention(seq_len: i32, head_dim: i32) -> KernelDescriptor {
    KernelDescriptor {
        block: block_spec_attention(),
        schedule: schedule_attention(seq_len, head_dim),
        m: seq_len, n: seq_len, k: head_dim,
        dtype: 1,
    }
}

fn kernel_elementwise(n: i32) -> KernelDescriptor {
    KernelDescriptor {
        block: block_spec_elementwise(),
        schedule: schedule_elementwise(n),
        m: n, n: 1, k: 1,
        dtype: 1,
    }
}

fn compute_grid(desc: &KernelDescriptor) -> GridConfig with Panic {
    let grid_x = (desc.m + desc.block.blk_m - 1) / desc.block.blk_m
    let grid_y = (desc.n + desc.block.blk_n - 1) / desc.block.blk_n
    GridConfig {
        grid_x: grid_x,
        grid_y: grid_y,
        grid_z: 1,
        block_x: desc.schedule.block.dim_x,
        block_y: desc.schedule.block.dim_y,
        block_z: desc.schedule.block.dim_z,
        shared_mem: desc.schedule.memory.shared_mem_bytes,
    }
}

fn gpu_compute_stats(data: &[f64; 256], n: i32) -> GpuStats  with Mut, Div{
    if n <= 0 {
        return GpuStats { mean: 0.0, variance: 0.0, min: 0.0, max: 0.0, n: 0 }
    }
    var s = 0.0
    var mn = data[0]
    var mx = data[0]
    var i: i32 = 0
    while i < n {
        if i < 256 {
            s = s + data[i]
            if data[i] < mn { mn = data[i] }
            if data[i] > mx { mx = data[i] }
        }
        i = i + 1
    }
    let m = s / (n as f64)
    var var_acc = 0.0
    i = 0
    while i < n {
        if i < 256 {
            let d = data[i] - m
            var_acc = var_acc + d * d
        }
        i = i + 1
    }
    var v = 0.0
    if n > 1 { v = var_acc / ((n - 1) as f64) }
    return GpuStats { mean: m, variance: v, min: mn, max: mx, n: n }
}

// =============================================================================
// FFT math helper tests (pure computation — no &! arrays)
// =============================================================================

fn test_fft_log2() -> i32  with IO, Mut, Panic, Div{
    // T01
    if fft_log2(1) != 0 { return 1 }
    if fft_log2(2) != 1 { return 2 }
    if fft_log2(4) != 2 { return 3 }
    if fft_log2(8) != 3 { return 4 }
    if fft_log2(16) != 4 { return 5 }
    if fft_log2(256) != 8 { return 6 }
    return 0
}

fn test_fft_bit_reverse() -> i32  with IO, Mut, Panic, Div{
    // T02 — n=8 (log2n=3): reverse(1)=4, reverse(3)=6, reverse(7)=7
    if fft_bit_reverse(0, 3) != 0 { return 1 }
    if fft_bit_reverse(1, 3) != 4 { return 2 }
    if fft_bit_reverse(3, 3) != 6 { return 3 }
    if fft_bit_reverse(7, 3) != 7 { return 4 }
    // n=4 (log2n=2): reverse(1)=2, reverse(2)=1
    if fft_bit_reverse(1, 2) != 2 { return 5 }
    if fft_bit_reverse(2, 2) != 1 { return 6 }
    return 0
}

fn test_fft_sin_cos_identity() -> i32  with Mut, Div{
    // T03 — sin^2 + cos^2 = 1
    let pi = 3.141592653589793
    let angles = [0.0, pi / 6.0, pi / 4.0, pi / 3.0, pi / 2.0, pi, 2.0 * pi / 3.0]
    var i: i32 = 0
    while i < 7 {
        let a = angles[i]
        let s = fft_sin(a)
        let c = fft_cos(a)
        let identity = s * s + c * c
        if fft_abs(identity - 1.0) > 0.001 { return (i + 1) as i32 }
        i = i + 1
    }
    return 0
}

fn test_fft_sin_known_values() -> i32  with IO, Mut, Panic, Div{
    // T04 — sin(0)=0, sin(pi/2)≈1, sin(pi)≈0
    let pi = 3.141592653589793
    if fft_abs(fft_sin(0.0)) > 0.001 { return 1 }
    if fft_abs(fft_sin(pi / 2.0) - 1.0) > 0.001 { return 2 }
    if fft_abs(fft_sin(pi)) > 0.001 { return 3 }
    return 0
}

fn test_fft_cos_known_values() -> i32  with IO, Mut, Panic, Div{
    // T05 — cos(0)=1, cos(pi/2)≈0, cos(pi)≈-1
    let pi = 3.141592653589793
    if fft_abs(fft_cos(0.0) - 1.0) > 0.001 { return 1 }
    if fft_abs(fft_cos(pi / 2.0)) > 0.001 { return 2 }
    if fft_abs(fft_cos(pi) + 1.0) > 0.001 { return 3 }
    return 0
}

// =============================================================================
// FFT forward — fully inlined to avoid &! call-boundary issue
// =============================================================================

// Shared inline macro for the butterfly kernel used in several tests
// (Sounio has no macros — each test inlines the FFT loop directly)

fn test_fft_dc_component() -> i32 with Mut, Div, Panic {
    // T06 — FFT of [5,5,5,5]: DC bin = 20, rest ≈ 0
    var real = [0.0; 256]
    var imag = [0.0; 256]
    real[0] = 5.0
    real[1] = 5.0
    real[2] = 5.0
    real[3] = 5.0
    let n: i32 = 4
    let log2n: i32 = fft_log2(n)
    let pi = 3.141592653589793

    // Bit-reversal inline
    var bi: i32 = 0
    while bi < n {
        let bj = fft_bit_reverse(bi, log2n)
        if bj > bi && bi < 256 && bj < 256 {
            let tr = real[bi]; real[bi] = real[bj]; real[bj] = tr
            let ti = imag[bi]; imag[bi] = imag[bj]; imag[bj] = ti
        }
        bi = bi + 1
    }

    // Butterfly inline
    var stage: i32 = 1
    while stage <= log2n {
        var block_size: i32 = 1
        var s: i32 = 0
        while s < stage { block_size = block_size * 2; s = s + 1 }
        let half: i32 = block_size / 2
        var k: i32 = 0
        while k < n {
            var j: i32 = 0
            while j < half {
                let angle = 0.0 - 2.0 * pi * (j as f64) / (block_size as f64)
                let wr = fft_cos(angle)
                let wi = fft_sin(angle)
                let itop = k + j
                let ibot = k + j + half
                if itop < 256 && ibot < 256 {
                    let tr = wr * real[ibot] - wi * imag[ibot]
                    let ti = wr * imag[ibot] + wi * real[ibot]
                    real[ibot] = real[itop] - tr
                    imag[ibot] = imag[itop] - ti
                    real[itop] = real[itop] + tr
                    imag[itop] = imag[itop] + ti
                }
                j = j + 1
            }
            k = k + block_size
        }
        stage = stage + 1
    }

    if fft_abs(real[0] - 20.0) > 0.01 { return 1 }
    if fft_abs(real[1]) > 0.01 { return 2 }
    if fft_abs(real[2]) > 0.01 { return 3 }
    if fft_abs(imag[0]) > 0.01 { return 4 }
    return 0
}

fn test_fft_roundtrip_4() -> i32 with Mut, Div, Panic {
    // T07 — FFT then IFFT of [1,2,3,4] recovers original
    var real = [0.0; 256]
    var imag = [0.0; 256]
    real[0] = 1.0; real[1] = 2.0; real[2] = 3.0; real[3] = 4.0
    let n: i32 = 4
    let log2n = fft_log2(n)
    let pi = 3.141592653589793

    // Forward FFT inline
    var bi: i32 = 0
    while bi < n {
        let bj = fft_bit_reverse(bi, log2n)
        if bj > bi && bi < 256 && bj < 256 {
            let tr = real[bi]; real[bi] = real[bj]; real[bj] = tr
            let ti = imag[bi]; imag[bi] = imag[bj]; imag[bj] = ti
        }
        bi = bi + 1
    }
    var stage: i32 = 1
    while stage <= log2n {
        var block_size: i32 = 1
        var s: i32 = 0
        while s < stage { block_size = block_size * 2; s = s + 1 }
        let half: i32 = block_size / 2
        var k: i32 = 0
        while k < n {
            var j: i32 = 0
            while j < half {
                let angle = 0.0 - 2.0 * pi * (j as f64) / (block_size as f64)
                let wr = fft_cos(angle)
                let wi = fft_sin(angle)
                let itop = k + j; let ibot = k + j + half
                if itop < 256 && ibot < 256 {
                    let tr = wr * real[ibot] - wi * imag[ibot]
                    let ti = wr * imag[ibot] + wi * real[ibot]
                    real[ibot] = real[itop] - tr; imag[ibot] = imag[itop] - ti
                    real[itop] = real[itop] + tr; imag[itop] = imag[itop] + ti
                }
                j = j + 1
            }
            k = k + block_size
        }
        stage = stage + 1
    }

    // Inverse FFT inline: conjugate
    var ci: i32 = 0
    while ci < n {
        if ci < 256 { imag[ci] = 0.0 - imag[ci] }
        ci = ci + 1
    }
    // Forward FFT again (on conjugated)
    bi = 0
    while bi < n {
        let bj = fft_bit_reverse(bi, log2n)
        if bj > bi && bi < 256 && bj < 256 {
            let tr = real[bi]; real[bi] = real[bj]; real[bj] = tr
            let ti = imag[bi]; imag[bi] = imag[bj]; imag[bj] = ti
        }
        bi = bi + 1
    }
    stage = 1
    while stage <= log2n {
        var block_size: i32 = 1
        var s: i32 = 0
        while s < stage { block_size = block_size * 2; s = s + 1 }
        let half: i32 = block_size / 2
        var k: i32 = 0
        while k < n {
            var j: i32 = 0
            while j < half {
                let angle = 0.0 - 2.0 * pi * (j as f64) / (block_size as f64)
                let wr = fft_cos(angle)
                let wi = fft_sin(angle)
                let itop = k + j; let ibot = k + j + half
                if itop < 256 && ibot < 256 {
                    let tr = wr * real[ibot] - wi * imag[ibot]
                    let ti = wr * imag[ibot] + wi * real[ibot]
                    real[ibot] = real[itop] - tr; imag[ibot] = imag[itop] - ti
                    real[itop] = real[itop] + tr; imag[itop] = imag[itop] + ti
                }
                j = j + 1
            }
            k = k + block_size
        }
        stage = stage + 1
    }
    // Conjugate and scale by 1/n
    let inv_n = 1.0 / (n as f64)
    ci = 0
    while ci < n {
        if ci < 256 {
            real[ci] = real[ci] * inv_n
            imag[ci] = 0.0 - imag[ci] * inv_n
        }
        ci = ci + 1
    }

    if fft_abs(real[0] - 1.0) > 0.01 { return 1 }
    if fft_abs(real[1] - 2.0) > 0.01 { return 2 }
    if fft_abs(real[2] - 3.0) > 0.01 { return 3 }
    if fft_abs(real[3] - 4.0) > 0.01 { return 4 }
    // Imaginary parts negligible after roundtrip on real input
    if fft_abs(imag[0]) > 0.01 { return 5 }
    if fft_abs(imag[2]) > 0.01 { return 6 }
    return 0
}

fn test_fft_single_element() -> i32 with Mut, Div, Panic {
    // T08 — n=1: FFT is identity (no butterfly stages)
    var real = [0.0; 256]
    var imag = [0.0; 256]
    real[0] = 42.0
    let n: i32 = 1
    // n <= 1 => no-op
    if n > 1 {
        // would do butterfly here
    }
    if fft_abs(real[0] - 42.0) > 1.0e-10 { return 1 }
    return 0
}

fn test_fft_n2_real_signal() -> i32 with Mut, Div, Panic {
    // T09 — FFT of [1,0]: real[0]=1, real[1]=1 (sum, difference)
    var real = [0.0; 256]
    var imag = [0.0; 256]
    real[0] = 1.0
    real[1] = 0.0
    let n: i32 = 2
    let log2n: i32 = fft_log2(n)
    let pi = 3.141592653589793

    var bi: i32 = 0
    while bi < n {
        let bj = fft_bit_reverse(bi, log2n)
        if bj > bi && bi < 256 && bj < 256 {
            let tr = real[bi]; real[bi] = real[bj]; real[bj] = tr
            let ti = imag[bi]; imag[bi] = imag[bj]; imag[bj] = ti
        }
        bi = bi + 1
    }
    var stage: i32 = 1
    while stage <= log2n {
        var block_size: i32 = 1
        var s: i32 = 0
        while s < stage { block_size = block_size * 2; s = s + 1 }
        let half: i32 = block_size / 2
        var k: i32 = 0
        while k < n {
            var j: i32 = 0
            while j < half {
                let angle = 0.0 - 2.0 * pi * (j as f64) / (block_size as f64)
                let wr = fft_cos(angle); let wi = fft_sin(angle)
                let itop = k + j; let ibot = k + j + half
                if itop < 256 && ibot < 256 {
                    let tr = wr * real[ibot] - wi * imag[ibot]
                    let ti = wr * imag[ibot] + wi * real[ibot]
                    real[ibot] = real[itop] - tr; imag[ibot] = imag[itop] - ti
                    real[itop] = real[itop] + tr; imag[itop] = imag[itop] + ti
                }
                j = j + 1
            }
            k = k + block_size
        }
        stage = stage + 1
    }

    // FFT([1,0]) = [1,1] (both bins = 1 for unit impulse)
    if fft_abs(real[0] - 1.0) > 0.01 { return 1 }
    if fft_abs(real[1] - 1.0) > 0.01 { return 2 }
    return 0
}

// =============================================================================
// Smooth — inlined to avoid &! boundary issue
// =============================================================================

fn test_gaussian_constant_signal() -> i32 with Mut, Div, Panic {
    // T10 — Gaussian of [7,...,7] = 7 everywhere (interior)
    var input = [0.0; 256]
    var output = [0.0; 256]
    var i: i32 = 0
    while i < 16 { input[i] = 7.0; i = i + 1 }
    let n: i32 = 16
    let sigma = 2.0
    var radius = (sigma * 3.0) as i32
    if radius > 32 { radius = 32 }
    if radius < 1 { radius = 1 }
    let inv_2sigma2 = 0.0 - 1.0 / (2.0 * sigma * sigma)
    i = 0
    while i < n {
        var acc = 0.0
        var weight_sum = 0.0
        var k: i32 = 0 - radius
        while k <= radius {
            let j = i + k
            if j >= 0 && j < n && j < 256 {
                let dist2 = (k as f64) * (k as f64)
                let w = smooth_exp(dist2 * inv_2sigma2)
                acc = acc + w * input[j]
                weight_sum = weight_sum + w
            }
            k = k + 1
        }
        if i < 256 {
            if weight_sum > 1.0e-15 {
                output[i] = acc / weight_sum
            } else {
                output[i] = input[i]
            }
        }
        i = i + 1
    }
    if stats_abs(output[8] - 7.0) > 0.01 { return 1 }
    if stats_abs(output[4] - 7.0) > 0.01 { return 2 }
    return 0
}

fn test_gaussian_zero_sigma_copies() -> i32 with Mut, Div, Panic {
    // T11 — sigma=0 copies input to output
    var input = [0.0; 256]
    var output = [0.0; 256]
    input[0] = 1.0; input[1] = 2.0; input[2] = 3.0
    let n: i32 = 3
    let sigma = 0.0
    if sigma <= 0.0 {
        var i: i32 = 0
        while i < n {
            if i < 256 { output[i] = input[i] }
            i = i + 1
        }
    }
    if stats_abs(output[0] - 1.0) > 1.0e-10 { return 1 }
    if stats_abs(output[1] - 2.0) > 1.0e-10 { return 2 }
    if stats_abs(output[2] - 3.0) > 1.0e-10 { return 3 }
    return 0
}

fn test_moving_avg_constant() -> i32 with Mut, Div, Panic {
    // T12 — Moving average of constant signal = constant
    var input = [0.0; 256]
    var output = [0.0; 256]
    var i: i32 = 0
    while i < 12 { input[i] = 4.0; i = i + 1 }
    let n: i32 = 12
    let win: i32 = 5
    let half: i32 = win / 2
    i = 0
    while i < n {
        var acc = 0.0
        var count: i32 = 0
        var k: i32 = 0 - half
        while k <= half {
            let j = i + k
            if j >= 0 && j < n && j < 256 {
                acc = acc + input[j]
                count = count + 1
            }
            k = k + 1
        }
        if i < 256 {
            if count > 0 {
                output[i] = acc / (count as f64)
            } else {
                output[i] = input[i]
            }
        }
        i = i + 1
    }
    if stats_abs(output[6] - 4.0) > 0.01 { return 1 }
    if stats_abs(output[3] - 4.0) > 0.01 { return 2 }
    return 0
}

fn test_moving_avg_window_1() -> i32 with Mut, Div, Panic {
    // T13 — Window=1 is identity (half=0, only element i itself)
    var input = [0.0; 256]
    var output = [0.0; 256]
    input[0] = 10.0; input[1] = 20.0; input[2] = 30.0
    let n: i32 = 3
    let win: i32 = 1
    let half: i32 = win / 2
    var i: i32 = 0
    while i < n {
        var acc = 0.0
        var count: i32 = 0
        var k: i32 = 0 - half
        while k <= half {
            let j = i + k
            if j >= 0 && j < n && j < 256 {
                acc = acc + input[j]
                count = count + 1
            }
            k = k + 1
        }
        if i < 256 {
            if count > 0 { output[i] = acc / (count as f64) } else { output[i] = input[i] }
        }
        i = i + 1
    }
    if stats_abs(output[0] - 10.0) > 0.01 { return 1 }
    if stats_abs(output[1] - 20.0) > 0.01 { return 2 }
    if stats_abs(output[2] - 30.0) > 0.01 { return 3 }
    return 0
}

fn test_bilateral_constant_signal() -> i32 with Mut, Div, Panic {
    // T14 — Bilateral filter on constant signal is identity
    var input = [0.0; 256]
    var output = [0.0; 256]
    var i: i32 = 0
    while i < 10 { input[i] = 9.0; i = i + 1 }
    let n: i32 = 10
    let sigma_s = 2.0
    let sigma_r = 1.0
    var radius = (sigma_s * 3.0) as i32
    if radius > 32 { radius = 32 }
    if radius < 1 { radius = 1 }
    let inv_2ss = 0.0 - 1.0 / (2.0 * sigma_s * sigma_s)
    let inv_2sr = 0.0 - 1.0 / (2.0 * sigma_r * sigma_r)
    i = 0
    while i < n {
        if i < 256 {
            var acc = 0.0
            var weight_sum = 0.0
            let center_val = input[i]
            var k: i32 = 0 - radius
            while k <= radius {
                let j = i + k
                if j >= 0 && j < n && j < 256 {
                    let spatial_d2 = (k as f64) * (k as f64)
                    let range_d = input[j] - center_val
                    let range_d2 = range_d * range_d
                    let w = smooth_exp(spatial_d2 * inv_2ss + range_d2 * inv_2sr)
                    acc = acc + w * input[j]
                    weight_sum = weight_sum + w
                }
                k = k + 1
            }
            if weight_sum > 1.0e-15 {
                output[i] = acc / weight_sum
            } else {
                output[i] = center_val
            }
        }
        i = i + 1
    }
    if stats_abs(output[5] - 9.0) > 0.01 { return 1 }
    return 0
}

fn test_bilateral_zero_sigma_copies() -> i32 with Mut, Div, Panic {
    // T15 — sigma_s=0: early-return copy path
    var input = [0.0; 256]
    var output = [0.0; 256]
    input[0] = 5.0; input[1] = 3.0
    let n: i32 = 2
    let sigma_s = 0.0
    let sigma_r = 1.0
    if sigma_s <= 0.0 || sigma_r <= 0.0 {
        var i: i32 = 0
        while i < n {
            if i < 256 { output[i] = input[i] }
            i = i + 1
        }
    }
    if stats_abs(output[0] - 5.0) > 1.0e-10 { return 1 }
    if stats_abs(output[1] - 3.0) > 1.0e-10 { return 2 }
    return 0
}

fn test_ema_constant() -> i32 with Mut, Div, Panic {
    // T16 — EMA of constant signal = constant
    var input = [0.0; 256]
    var output = [0.0; 256]
    var i: i32 = 0
    while i < 8 { input[i] = 6.0; i = i + 1 }
    let n: i32 = 8
    let alpha = 0.3
    output[0] = input[0]
    i = 1
    while i < n {
        if i < 256 {
            output[i] = alpha * input[i] + (1.0 - alpha) * output[i - 1]
        }
        i = i + 1
    }
    if stats_abs(output[0] - 6.0) > 0.01 { return 1 }
    if stats_abs(output[7] - 6.0) > 0.01 { return 2 }
    return 0
}

fn test_ema_monotone_rise() -> i32 with Mut, Div, Panic {
    // T17 — EMA of step-up signal rises monotonically
    var input = [0.0; 256]
    var output = [0.0; 256]
    input[0] = 0.0; input[1] = 0.0; input[2] = 10.0; input[3] = 10.0; input[4] = 10.0
    let n: i32 = 5
    let alpha = 0.5
    output[0] = input[0]
    var i: i32 = 1
    while i < n {
        if i < 256 {
            output[i] = alpha * input[i] + (1.0 - alpha) * output[i - 1]
        }
        i = i + 1
    }
    if output[3] < output[2] { return 1 }
    if output[4] < output[3] { return 2 }
    return 0
}

