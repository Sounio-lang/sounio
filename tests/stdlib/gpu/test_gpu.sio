fn test_stats_histogram() -> i32 with Mut, Div, Panic {
    // T28 — inlined histogram (writes to &!hist across call boundary problematic)
    var data = [0.0; 256]
    data[0] = 0.5; data[1] = 1.5; data[2] = 2.5; data[3] = 0.8
    let n: i32 = 4
    let lo = 0.0
    let hi = 3.0
    let nbins: i32 = 3
    var hist = [0; 256]
    // Inline histogram
    var i: i32 = 0
    while i < nbins { if i < 256 { hist[i] = 0 }; i = i + 1 }
    let range = hi - lo
    i = 0
    while i < n {
        if i < 256 {
            let val = data[i]
            var bin = ((val - lo) / range * (nbins as f64)) as i32
            if bin < 0 { bin = 0 }
            if bin >= nbins { bin = (nbins - 1) as i32 }
            if bin < 256 { hist[bin] = hist[bin] + 1 }
        }
        i = i + 1
    }
    // bin 0: [0,1) => 0.5, 0.8 => 2; bin 1: 1.5 => 1; bin 2: 2.5 => 1
    if hist[0] != 2 { return 1 }
    if hist[1] != 1 { return 2 }
    if hist[2] != 1 { return 3 }
    return 0
}

fn test_stats_histogram_clamp() -> i32 with Mut, Div, Panic {
    // T29 — values outside [lo,hi] clamped to first/last bin
    var data = [0.0; 256]
    data[0] = 0.0 - 5.0   // below lo => bin 0
    data[1] = 100.0        // above hi => bin 3 (last)
    let n: i32 = 2
    let lo = 0.0
    let hi = 1.0
    let nbins: i32 = 4
    var hist = [0; 256]
    var i: i32 = 0
    while i < nbins { if i < 256 { hist[i] = 0 }; i = i + 1 }
    let range = hi - lo
    i = 0
    while i < n {
        if i < 256 {
            let val = data[i]
            var bin = ((val - lo) / range * (nbins as f64)) as i32
            if bin < 0 { bin = 0 }
            if bin >= nbins { bin = (nbins - 1) as i32 }
            if bin < 256 { hist[bin] = hist[bin] + 1 }
        }
        i = i + 1
    }
    if hist[0] != 1 { return 1 }
    if hist[3] != 1 { return 2 }
    return 0
}

fn test_stats_compute_stats() -> i32  with IO, Mut, Panic, Div{
    // T30
    var data = [0.0; 256]
    data[0] = 1.0; data[1] = 2.0; data[2] = 3.0
    let st = gpu_compute_stats(&data, 3)
    if stats_abs(st.mean - 2.0) > 0.001 { return 1 }
    if stats_abs(st.min - 1.0) > 0.001 { return 2 }
    if stats_abs(st.max - 3.0) > 0.001 { return 3 }
    if st.n != 3 { return 4 }
    return 0
}

