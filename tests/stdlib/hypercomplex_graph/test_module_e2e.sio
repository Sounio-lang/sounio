//@ run-pass
//@ expect-stdout: HYPERCOMPLEX_GRAPH_OK

use hypercomplex_graph::orc::{
    bg_new, bg_set_edge, bg_degree, bg_common_neighbors, orc_lly_edge
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var g = bg_new(3)
    g = bg_set_edge(g, 0, 1)
    g = bg_set_edge(g, 1, 2)
    g = bg_set_edge(g, 0, 2)

    if bg_degree(g, 0) != 2 { return 1 }
    if bg_common_neighbors(g, 0, 1) != 1 { return 2 }
    if !near(orc_lly_edge(g, 0, 1), 1.0, 0.0001) { return 3 }

    println("HYPERCOMPLEX_GRAPH_OK")
    return 0
}
