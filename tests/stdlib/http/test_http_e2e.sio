//@ run-pass
// E2E: stdlib/http/mod.sio — HttpRequest/HttpResponse

use http::*;

fn run_tests(req: &! HttpRequest, resp: &! HttpResponse) -> i32 {
    // Request
    if !req.is_get() { return 1 }
    if req.is_post() { return 2 }

    // Add headers
    req.add_header(1, 100)
    req.add_header(2, 200)
    if req.header_count != 2 { return 3 }

    // Response 200
    if !resp.is_ok() { return 4 }
    if resp.is_error() { return 5 }

    // Response 404
    let err_resp = http_response_new(404)
    if err_resp.is_ok() { return 6 }
    if !err_resp.is_error() { return 7 }

    // POST request
    let post = http_request_new(HTTP_POST)
    if !post.is_post() { return 8 }
    if post.is_get() { return 9 }

    return 0
}

fn main() -> i32 {
    var req = http_request_new(HTTP_GET)
    var resp = http_response_new(200)
    return run_tests(&! req, &! resp)
}
