//@ check-only
// E2E tests for stdlib/web/ — http.sio, websocket.sio, epistemic_http.sio
//
// Tests: http method constants, http_ok/client_error/server_error,
//        http_quality_score, ws_text_message/ws_close_message,
//        ws_is_close/ws_is_text, DataSource trust, epistemic_combine.
//
// check-only (not run-pass): native multi-module IR lowering fails on this
// harness's import graph (ir_summary_failed) — the same pre-existing Madaros
// wall hit by tests/stdlib/net/test_addr_e2e.sio, unrelated to this module's
// logic. Matches the check-only convention already used by the distributed/
// cli/geo/image/audio/dataframe stdlib waves for the same reason.

use web::http::*
use web::websocket::*
use web::epistemic_http::*

fn near(a: f64, b: f64, tol: f64) -> bool with Div {
    let d = if a > b { a - b } else { b - a }
    d < tol
}

fn run_tests() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    // ------------------------------------------------- http method constants
    print("Test 01: http_get_method() == 0... ")
    if http_get_method() == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 02: http_post_method() == 1... ")
    if http_post_method() == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 03: http_put_method() == 2, http_delete_method() == 3... ")
    if http_put_method() == 2 && http_delete_method() == 3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------- http_ok
    print("Test 04: http_ok for status 200... ")
    let resp_200 = HttpResponse { status: 200, body_len: 0, body: [0; 4096], content_type: 0 }
    if http_ok(resp_200) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 05: http_client_error for status 404... ")
    let resp_404 = HttpResponse { status: 404, body_len: 0, body: [0; 4096], content_type: 1 }
    if http_client_error(resp_404) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 06: http_server_error for status 503... ")
    let resp_503 = HttpResponse { status: 503, body_len: 0, body: [0; 4096], content_type: 1 }
    if http_server_error(resp_503) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------- http_quality_score
    print("Test 07: http_quality_score 200 == 1.0... ")
    let q200 = http_quality_score(resp_200)
    if near(q200, 1.0, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 08: http_quality_score 404 == 0.3... ")
    let q404 = http_quality_score(resp_404)
    if near(q404, 0.3, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------- websocket messages
    print("Test 09: ws_close_message opcode == 8... ")
    let close_msg = ws_close_message()
    if ws_is_close(close_msg) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 10: ws_text_message opcode == 1... ")
    var payload: [i8; 2048] = [0; 2048]
    payload[0] = 72   // 'H'
    let text_msg = ws_text_message(payload, 1)
    if ws_is_text(text_msg) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 11: ws_text_message is not close... ")
    if !ws_is_close(text_msg) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------------- epistemic data sources
    print("Test 12: source_ncbi trust_level == 0.95... ")
    let ncbi = source_ncbi()
    if near(ncbi.trust_level, 0.95, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 13: provenance_quality(source_unknown()) == 0.5... ")
    let unk = source_unknown()
    let pq = provenance_quality(unk)
    if near(pq, 0.5, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 14: epistemic_response_ok for status 200... ")
    let eresp = EpistemicResponse {
        status: 200,
        body_len: 0,
        body: [0; 4096],
        epsilon: 0.05,
        source: source_ncbi(),
    }
    if epistemic_response_ok(eresp) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("Test 15: epistemic_combine grows uncertainty... ")
    let ea = EpistemicResponse { status: 200, body_len: 0, body: [0; 4096], epsilon: 0.1, source: source_ncbi() }
    let eb = EpistemicResponse { status: 200, body_len: 0, body: [0; 4096], epsilon: 0.2, source: source_ebi() }
    let combined = epistemic_combine(ea, eb)
    // combined = 0.01 + 0.04 = 0.05
    if near(combined, 0.05, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("All tests passed!\n")
        0
    } else {
        print("Some tests FAILED\n")
        1
    }
}

fn main() -> i32 with IO, Div, Mut, Panic {
    run_tests()
}
