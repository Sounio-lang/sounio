//@ run-pass
//@ requires: madaros
//@ expect-stdout: GENOMICS_BATCH_SCALE_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set}
use genomics::count_csr::{count_csr_build}
use genomics::count_identities::{CountIdentities,count_identities_build,count_identities_close}
use genomics::count_pipeline::{count_pipeline_workspace,count_pipeline_new,count_pipeline_prepare,count_pipeline_point_batch,count_pipeline_point_batch_seeded,count_pipeline_shrink,count_pipeline_refit_batch,count_pipeline_adjust,count_pipeline_status,count_pipeline_phase,count_pipeline_eligible,count_pipeline_prior_status,count_pipeline_prior_a0,count_pipeline_prior_a1,count_pipeline_prior_variance,count_pipeline_point_evaluations,count_pipeline_refit_evaluations,count_pipeline_value,count_pipeline_gene_status,count_pipeline_adjusted,count_pipeline_factor,count_pipeline_offset,count_pipeline_point_done,count_pipeline_gene_id_byte,count_pipeline_coefficient_available,count_pipeline_coefficient,count_pipeline_close}
use genomics::count_pipeline_report::{count_gene_report_slot,count_pipeline_report_into,count_pipeline_write_tsv}
use stats::regression::dynamic_dispersion::{DispersionSearchOptions}
use io::sci_print::{println_f64_sci}
fn make_ids_at(n:i64,prefix:i64,reverse:bool,start:i64)->CountIdentities with Alloc,Mut,Div,Panic {
 var bytes=integer_buffer_new(n*5,n*40)
 var offsets=integer_buffer_new(n+1,(n+1)*8)
 var order=integer_buffer_new(n,n*8);var groups=integer_buffer_new(n,n*8)
 var i:i64=0
 while i<n {
  let j=start+(if reverse {n-1-i}else{i})
  integer_buffer_set(&!offsets,i,i*5)
  integer_buffer_set(&!bytes,i*5,prefix)
  integer_buffer_set(&!bytes,i*5+1,65+j/17576)
  integer_buffer_set(&!bytes,i*5+2,65+(j/676)%26)
  integer_buffer_set(&!bytes,i*5+3,65+(j/26)%26)
  integer_buffer_set(&!bytes,i*5+4,65+j%26);i=i+1
 }
 integer_buffer_set(&!offsets,n,n*5)
 count_identities_build(bytes,offsets,order,groups,0,10000000)
}
fn scale_start()->i64 with IO,Mut,Div,Panic {
 let text=read_file("shard_start.txt");let size=str_len(text)
 if size<1 || size>5 {return -1}
 var i:i64=0;var value:i64=0
 while i<size {let byte=text[i as usize] as i64;if byte<48 || byte>57 {return -1};value=value*10+byte-48;i=i+1}
 if value>19000 || value%1000!=0 {return -1};value
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let g:i64=1000;let n:i64=512;let p:i64=2;let start=scale_start();let limit:i64=1000;assert(start>=0)
 var offsets=integer_buffer_new(g+1,(g+1)*8)
 var columns=integer_buffer_new(g*n,g*n*8)
 var values=integer_buffer_new(g*n,g*n*8)
 var i:i64=0
 while i<g {
  integer_buffer_set(&!offsets,i,i*n)
  var j:i64=0;while j<n {
   let y=((start+i)%7+1)*(if j>=256 {2}else{1})
   integer_buffer_set(&!columns,i*n+j,j);integer_buffer_set(&!values,i*n+j,y);j=j+1
  };i=i+1
 }
 integer_buffer_set(&!offsets,g,g*n)
 let csr=count_csr_build(g,n,g*n,offsets,columns,values,0)
 let genes=make_ids_at(g,71,false,start);let samples=make_ids_at(n,83,false,0);let metadata=make_ids_at(n,83,true,0)
 let options=DispersionSearchOptions{method:0,log_alpha_lower: -8.0,log_alpha_upper:1.0,outer_tolerance:1e-4,max_outer_evaluations:64,rcond:0.0,inner_iterations:100,inner_tolerance:1e-8,prior_active:false,prior_center:0.0,prior_variance:1.0,compute_curvature:false}
 let query=count_pipeline_workspace(g,n,p,0);assert(query.status==0)
 var w=count_pipeline_new(csr,genes,samples,p,options,query.payload_bytes);assert(count_pipeline_status(&w)==0)
 var design=numeric_buffer_new(n*p,n*p*8);var exposure=numeric_buffer_new(n,n*8)
 var initial=numeric_buffer_new(p,p*8);var contrast=numeric_buffer_new(p,p*8)
 i=0;while i<n {let original=n-1-i
  numeric_buffer_set(&!design,i*p,1.0);numeric_buffer_set(&!design,i*p+1,if original>=256 {1.0}else{0.0})
  numeric_buffer_set(&!exposure,i,0.0);i=i+1
 }
 numeric_buffer_set(&!initial,0,1.0);numeric_buffer_set(&!initial,1,0.0)
 numeric_buffer_set(&!contrast,0,0.0);numeric_buffer_set(&!contrast,1,1.0)
 assert(count_pipeline_prepare(&!w,&metadata,&design,&exposure,&initial,&contrast,1,10000000,true,true)==0)
 println("SCALE_LAYOUT {} {} {} {} {}",20000,g,n,p,query.payload_bytes)
 println("SCALE_RANGE {} {}",start,start+limit)
 var done:i64=0
 while done<limit {assert(count_pipeline_point_batch_seeded(&!w,16,0.0)==0);done=count_pipeline_point_done(&w);println("SCALE_PROGRESS {}",done)}
 i=0;while i<limit {
  let status=count_pipeline_gene_status(&w,i,0)
  println("SCALE_POINT {} {} {}",start+i,status,count_pipeline_gene_status(&w,i,2))
  println("SCALE_ID {} {} {} {} {} {}",start+i,count_pipeline_gene_id_byte(&w,i,0),count_pipeline_gene_id_byte(&w,i,1),count_pipeline_gene_id_byte(&w,i,2),count_pipeline_gene_id_byte(&w,i,3),count_pipeline_gene_id_byte(&w,i,4))
  assert(status==0 && count_pipeline_coefficient_available(&w,i,false))
  println_f64_sci(count_pipeline_value(&w,i,1),15)
  println_f64_sci(count_pipeline_coefficient(&w,i,0,false),15)
  println_f64_sci(count_pipeline_coefficient(&w,i,1,false),15)
  i=i+1
 }
 println("SCALE_EVALUATIONS {}",count_pipeline_point_evaluations(&w))
 println("SCALE_STATE {} {} {}",count_pipeline_point_done(&w),count_pipeline_phase(&w),count_pipeline_eligible(&w))
 assert(count_pipeline_eligible(&w)==0)
 count_pipeline_close(w);count_identities_close(metadata)
 numeric_buffer_close(design);numeric_buffer_close(exposure);numeric_buffer_close(initial);numeric_buffer_close(contrast)
 println("GENOMICS_BATCH_SCALE_PASS");0
}
