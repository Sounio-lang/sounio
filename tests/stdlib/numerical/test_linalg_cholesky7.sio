//@ run-pass

use numerical::linalg::*

fn chol7_lcg_next(seed: i64) -> i64 {
    return (1664525 * seed + 1013904223) % 4294967296
}

fn chol7_lcg_val(seed: i64) -> f64 {
    let pos = if seed < 0 { seed + 4294967296 } else { seed }
    return (pos as f64) / 4294967296.0
}

fn build_spd(seed0: i64) -> [f64; 49] with Mut, Div, Panic {
    var seed = seed0
    var b = mat7_zero()
    var i: i32 = 0
    while i < 7 {
        var j: i32 = 0
        while j < 7 {
            seed = chol7_lcg_next(seed)
            let u = chol7_lcg_val(seed) * 2.0 - 1.0
            b = mat7_set(b, i, j, u)
            j = j + 1
        }
        i = i + 1
    }

    var a = mat7_zero()
    i = 0
    while i < 7 {
        var j: i32 = 0
        while j < 7 {
            var s = 0.0
            var k: i32 = 0
            while k < 7 {
                s = s + mat7_get(b, i, k) * mat7_get(b, j, k)
                k = k + 1
            }
            if i == j { s = s + 1.0e-3 }
            a = mat7_set(a, i, j, s)
            j = j + 1
        }
        i = i + 1
    }
    return a
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("M1 Cholesky 7x7 regression: A=B*B^T+eps*I, rel reconstruction <= 1e-10")
    var ok_all = true
    var case_i: i32 = 0
    while case_i < 5 {
        let a = build_spd(1729 + (case_i as i64) * 97)
        let ch = cholesky7_banachiewicz(a)
        let rel = mat7_reconstruction_relative_error(a, ch.l)
        print("case="); print_f64(case_i as f64)
        print(" rel="); print_f64(rel)
        print(" min_pivot="); print_f64(ch.min_pivot)
        println("")
        if !ch.ok || rel > 1.0e-10 {
            ok_all = false
        }
        case_i = case_i + 1
    }
    let eye_flat = mat7_identity()
    let eye_nested = mat7_to_nested(eye_flat)
    let l_nested = cholesky(eye_nested)
    print("nested_eye_l00="); print_f64(l_nested[0][0])
    print(" nested_eye_l66="); print_f64(l_nested[6][6])
    println("")
    if l_nested[0][0] < 0.9999999999 || l_nested[0][0] > 1.0000000001 {
        ok_all = false
    }
    if l_nested[6][6] < 0.9999999999 || l_nested[6][6] > 1.0000000001 {
        ok_all = false
    }
    if ok_all {
        println("M1_COPULA_CHOLESKY_PASS")
        println("ALL PASS")
        return 0
    }
    println("M1_COPULA_CHOLESKY_FAIL")
    return 1
}
