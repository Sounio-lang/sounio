// Deepened run-proof for interpolation::spline epistemic eval.
// espline_eval_val must match the value spline. espline_eval_unc is a
// separate non-negative lane and must not be folded into the value.
// lean_single. Not a claim about Epistemic.variance.
use interpolation::spline::*

fn ae(a: f64, b: f64) -> f64 {
    if a > b { a - b } else { b - a }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var xs: [f64; 64] = [0.0; 64]
    var ys: [f64; 64] = [0.0; 64]
    var uz: [f64; 64] = [0.0; 64]
    var up: [f64; 64] = [0.0; 64]
    xs[0] = 0.0; ys[0] = 0.0; up[0] = 0.2
    xs[1] = 1.0; ys[1] = 1.0; up[1] = 0.2
    xs[2] = 2.0; ys[2] = 2.0; up[2] = 0.2
    xs[3] = 3.0; ys[3] = 3.0; up[3] = 0.2

    let plain = spline_fit(&xs, &ys, 4)
    let quiet = espline_fit(&xs, &ys, &uz, 4)
    let noisy = espline_fit(&xs, &ys, &up, 4)

    let x = 1.5
    let plain_v = spline_eval(&plain, x)
    let quiet_v = espline_eval_val(&quiet, x)
    let noisy_v = espline_eval_val(&noisy, x)
    let quiet_u = espline_eval_unc(&quiet, x)
    let noisy_u = espline_eval_unc(&noisy, x)

    // Affine data, so the value spline is y = x.
    if ae(plain_v, 1.5) >= 1.0e-9 { print("FAIL plain\n"); return 1 }
    if ae(quiet_v, plain_v) >= 1.0e-9 { print("FAIL quiet_val\n"); return 2 }
    if ae(noisy_v, plain_v) >= 1.0e-9 { print("FAIL noisy_val\n"); return 3 }
    if quiet_u < 0.0 { print("FAIL quiet_unc_neg\n"); return 4 }
    if noisy_u < 0.0 { print("FAIL noisy_unc_neg\n"); return 5 }
    // Zero data uncertainty must not invent a width, and a positive width
    // must not move the value.
    if quiet_u >= 1.0e-8 { print("FAIL quiet_unc\n"); return 6 }
    if noisy_u <= quiet_u { print("FAIL unc_separate\n"); return 7 }
    if ae(noisy_v, quiet_v) >= 1.0e-9 { print("FAIL folded\n"); return 8 }

    print("ESPLINE_DEEP_STDLIB_OK\n")
    return 0
}
