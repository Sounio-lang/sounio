//@ check-only
// E2E test for stdlib/interpolation (mod.sio)
// Tests: PiecewiseLinear, NaturalSpline, LagrangeInterp, AkimaSpline,
//        piecewise_linear_new, piecewise_linear_eval,
//        cubic_spline_fit, cubic_spline_eval, cubic_spline_derivative,
//        lagrange_new, lagrange_eval,
//        akima_fit, akima_eval

use interpolation::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Panic, Div {
    // Set up data: y = 2x for x in {0, 1, 2, 3, 4}
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    xs[0] = 0.0; ys[0] = 0.0
    xs[1] = 1.0; ys[1] = 2.0
    xs[2] = 2.0; ys[2] = 4.0
    xs[3] = 3.0; ys[3] = 6.0
    xs[4] = 4.0; ys[4] = 8.0

    // Test 1: Piecewise linear interpolation at midpoint
    let pw = piecewise_linear_new(xs, ys, 5)
    let val_pw = piecewise_linear_eval(pw, 1.5)
    if check_near(val_pw, 3.0, 0.001) == false { return 1 }

    // Test 2: Cubic spline fit and eval at data point
    let spline = cubic_spline_fit(xs, ys, 5)
    let val_sp = cubic_spline_eval(spline, 2.0)
    if check_near(val_sp, 4.0, 0.001) == false { return 1 }

    // Test 3: Cubic spline derivative (should be ~2.0 for y=2x)
    let deriv = cubic_spline_derivative(spline, 2.0)
    if check_near(deriv, 2.0, 0.1) == false { return 1 }

    // Test 4: Lagrange interpolation
    var xs64: [f64; 64] = [0.0; 64]
    var ys64: [f64; 64] = [0.0; 64]
    xs64[0] = 0.0; ys64[0] = 0.0
    xs64[1] = 1.0; ys64[1] = 2.0
    xs64[2] = 2.0; ys64[2] = 4.0
    let lag = lagrange_new(xs64, ys64, 3)
    let val_lag = lagrange_eval(lag, 1.5)
    if check_near(val_lag, 3.0, 0.001) == false { return 1 }

    // Test 5: Akima spline
    let ak = akima_fit(xs, ys, 5)
    let val_ak = akima_eval(ak, 2.5)
    if check_near(val_ak, 5.0, 0.1) == false { return 1 }

    return 0
}

fn main() -> i32 with Mut, Panic, Div {
    return run_tests()
}
