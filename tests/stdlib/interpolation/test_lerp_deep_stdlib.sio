// Deepened run-proof for interpolation::lib. The existing e2e file only prints
// a marker. This driver calls the library. lean_single.
use interpolation::lib::*

fn ae(a: f64, b: f64) -> f64 {
    if a > b { a - b } else { b - a }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    if ae(lerp(0.0, 10.0, 0.25), 2.5) >= 1.0e-12 { print("FAIL lerp\n"); return 1 }
    if ae(inverse_lerp(0.0, 10.0, 2.5), 0.25) >= 1.0e-12 { print("FAIL inv\n"); return 2 }
    if ae(inverse_lerp(3.0, 3.0, 9.0), 0.0) >= 1.0e-12 { print("FAIL inv_zero\n"); return 3 }
    if ae(remap(2.5, 0.0, 10.0, 0.0, 100.0), 25.0) >= 1.0e-12 { print("FAIL remap\n"); return 4 }
    if ae(lerp_clamped(0.0, 10.0, 2.0), 10.0) >= 1.0e-12 { print("FAIL clamp\n"); return 5 }
    // smoothstep at t=0.5 is the midpoint: 3t^2-2t^3 = 0.5
    if ae(smoothstep(0.0, 10.0, 0.5), 5.0) >= 1.0e-12 { print("FAIL smooth\n"); return 6 }
    if ae(bilerp(0.0, 2.0, 4.0, 6.0, 0.5, 0.5), 3.0) >= 1.0e-12 { print("FAIL bilerp\n"); return 7 }
    print("LERP_DEEP_STDLIB_OK\n")
    return 0
}
