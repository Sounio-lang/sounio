//@ run-pass
//@ known-failure: Missing library implementation
//@ expect-stdout: HYPER_SNN_OK

use snn::*
use math::sedenion::*

fn emit_metric(name: string, value: f64) with IO {
    print("HYPER_METRIC snn ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let z = sedenion_zero()
    let one = sedenion_one()
    let sum = sedenion_add(one, one)
    let diff = sedenion_sub(sum, one)

    let add_ok = diff.e0 == 1.0
    let nsq = sedenion_norm_sq(one)

    let layer = sedenion_layer_new(2, 3, SedenionActivation::None)
    let pc = sedenion_layer_param_count(layer)

    emit_metric("sed_norm_sq", nsq as f64)
    emit_metric("layer_param_count", pc as f64)
    emit_metric("add_contract_ok", bool_to_f64(add_ok))

    if z.e0 != 0.0 { return 2 }
    if !add_ok { return 3 }
    if pc != 144 { return 4 }

    print("HYPER_SNN_OK\n")
    0
}
