//@ check-only
// E2E test for stdlib/snn (Sedenion Neural Networks)
// Tests: sedenion_layer_core functions and sedenion_similarity functions
// Uses Sedenion types from math::sedenion

use snn::*;
use math::sedenion::*;

fn check_near_f32(a: f32, b: f32, tol: f32) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: sedenion_zero has all components zero
    let z = sedenion_zero()
    if check_near_f32(z.e0, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 2: sedenion_one has e0=1, rest zero
    let one = sedenion_one()
    if check_near_f32(one.e0, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 3: sedenion_add
    let a = sedenion_one()
    let b = sedenion_one()
    let sum = sedenion_add(a, b)
    if check_near_f32(sum.e0, 2.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 4: sedenion_sub
    let diff = sedenion_sub(sum, a)
    if check_near_f32(diff.e0, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 5: sedenion_scale
    let scaled = sedenion_scale(one, 3.0)
    if check_near_f32(scaled.e0, 3.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 6: sedenion_norm_sq of one = 1.0
    let nsq = sedenion_norm_sq(one)
    if check_near_f32(nsq, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 7: sedenion_mul of one * one = one
    let prod = sedenion_mul(one, one)
    if check_near_f32(prod.e0, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 8: sed_cosine_similarity of identical vectors = 1.0
    let cs = sed_cosine_similarity(one, one)
    if check_near_f32(cs, 1.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 9: sed_euclidean_distance of identical vectors = 0.0
    let ed = sed_euclidean_distance(one, one)
    if check_near_f32(ed, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 10: sed_euclidean_distance_sq
    let ed2 = sed_euclidean_distance_sq(one, z)
    if check_near_f32(ed2, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 11: sed_cayley_score
    let score = sed_cayley_score(one, one, one)
    if check_near_f32(score, 1.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 12: sed_bilinear_score
    let bs = sed_bilinear_score(one, one, one)
    if check_near_f32(bs, 1.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 13: sed_distmult_score
    let dms = sed_distmult_score(one, one, one)
    if check_near_f32(dms, 1.0, 0.01) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 14: sed_margin_loss with positive margin
    let ml = sed_margin_loss(1.0, 0.5, 0.5)
    if check_near_f32(ml, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 15: sed_margin_loss when negative closer to positive
    let ml2 = sed_margin_loss(0.5, 0.8, 1.0)
    if ml2 > 0.0 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 16: sed_to_semantic_distance of similarity=1.0 -> 0.0
    let sd = sed_to_semantic_distance(1.0)
    if check_near_f32(sd, 0.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 17: sed_to_semantic_distance of similarity=-1.0 -> 1.0
    let sd2 = sed_to_semantic_distance(0.0 - 1.0)
    if check_near_f32(sd2, 1.0, 0.001) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 18: sedenion_layer_param_count basic check
    let layer = sedenion_layer_new(2, 3, SedenionActivation::None)
    let pc = sedenion_layer_param_count(layer)
    // (2*3 + 3) * 16 = 9 * 16 = 144
    if pc == 144 { pass = pass + 1 } else { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
