//@ run-pass
// tests/stdlib/iter/test_iter.sio
//
// Tests for stdlib/iter/lib.sio:
//   - map square [1,2,3] -> [1,4,9]
//   - filter positive [-1,2,-3,4] -> [2,4]
//   - reduce sum [1,2,3,4,5] -> 15
//   - zip_add [1,2,3] + [4,5,6] -> [5,7,9]
//   - take/skip

use iter::lib::{
    ArrayView, array_view_new,
    iter_map_id,
    iter_filter_positive, iter_filter_gt,
    iter_reduce_sum, iter_reduce_product, iter_reduce_max, iter_reduce_min,
    iter_zip_add, iter_zip_mul,
    iter_take, iter_skip,
    iter_enumerate_sum_indexed,
    iter_all_positive, iter_any_negative,
    iter_count_gt,
}

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < 0.0001
}

fn run_tests() -> i32 with IO, Mut, Panic, Div{
    var pass: i32 = 0
    var fail: i32 = 0

    // -------------------------------------------------------------------------
    // Test 1: map square [1,2,3] -> [1,4,9]
    // -------------------------------------------------------------------------
    print("Test 1: map square... ")
    var raw1: [f64; 256] = [0.0; 256]
    raw1[0] = 1.0
    raw1[1] = 2.0
    raw1[2] = 3.0
    let v1 = array_view_new(&raw1, 3)
    let sq = iter_map_id(v1, 0)
    if sq.len == 3 && near(sq.data[0], 1.0) && near(sq.data[1], 4.0) && near(sq.data[2], 9.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 2: map double [1,2,3] -> [2,4,6]
    // -------------------------------------------------------------------------
    print("Test 2: map double... ")
    let dbl = iter_map_id(v1, 1)
    if dbl.len == 3 && near(dbl.data[0], 2.0) && near(dbl.data[1], 4.0) && near(dbl.data[2], 6.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 3: filter positive [-1,2,-3,4] -> [2,4]
    // -------------------------------------------------------------------------
    print("Test 3: filter positive... ")
    var raw3: [f64; 256] = [0.0; 256]
    raw3[0] = 0.0 - 1.0
    raw3[1] = 2.0
    raw3[2] = 0.0 - 3.0
    raw3[3] = 4.0
    let v3 = array_view_new(&raw3, 4)
    let pos3 = iter_filter_positive(v3)
    if pos3.len == 2 && near(pos3.data[0], 2.0) && near(pos3.data[1], 4.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 4: filter_gt threshold=1.5 on [1,2,3] -> [2,3]
    // -------------------------------------------------------------------------
    print("Test 4: filter_gt... ")
    let gt4 = iter_filter_gt(v1, 1.5)
    if gt4.len == 2 && near(gt4.data[0], 2.0) && near(gt4.data[1], 3.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 5: reduce sum [1,2,3,4,5] -> 15
    // -------------------------------------------------------------------------
    print("Test 5: reduce sum... ")
    var raw5: [f64; 256] = [0.0; 256]
    raw5[0] = 1.0
    raw5[1] = 2.0
    raw5[2] = 3.0
    raw5[3] = 4.0
    raw5[4] = 5.0
    let v5 = array_view_new(&raw5, 5)
    let s5 = iter_reduce_sum(&v5)
    if near(s5, 15.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 6: reduce product [1,2,3,4] -> 24
    // -------------------------------------------------------------------------
    print("Test 6: reduce product... ")
    var raw6: [f64; 256] = [0.0; 256]
    raw6[0] = 1.0
    raw6[1] = 2.0
    raw6[2] = 3.0
    raw6[3] = 4.0
    let v6 = array_view_new(&raw6, 4)
    let p6 = iter_reduce_product(&v6)
    if near(p6, 24.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 7: reduce max [3,1,4,1,5] -> 5
    // -------------------------------------------------------------------------
    print("Test 7: reduce max... ")
    var raw7: [f64; 256] = [0.0; 256]
    raw7[0] = 3.0
    raw7[1] = 1.0
    raw7[2] = 4.0
    raw7[3] = 1.0
    raw7[4] = 5.0
    let v7 = array_view_new(&raw7, 5)
    let mx7 = iter_reduce_max(&v7)
    if near(mx7, 5.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 8: reduce min [3,1,4,1,5] -> 1
    // -------------------------------------------------------------------------
    print("Test 8: reduce min... ")
    let mn8 = iter_reduce_min(&v7)
    if near(mn8, 1.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 9: zip_add [1,2,3] + [4,5,6] -> [5,7,9]
    // -------------------------------------------------------------------------
    print("Test 9: zip_add... ")
    var rawA: [f64; 256] = [0.0; 256]
    rawA[0] = 1.0
    rawA[1] = 2.0
    rawA[2] = 3.0
    var rawB: [f64; 256] = [0.0; 256]
    rawB[0] = 4.0
    rawB[1] = 5.0
    rawB[2] = 6.0
    let vA = array_view_new(&rawA, 3)
    let vB = array_view_new(&rawB, 3)
    let za = iter_zip_add(&vA, &vB)
    if za.len == 3 && near(za.data[0], 5.0) && near(za.data[1], 7.0) && near(za.data[2], 9.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 10: zip_mul [2,3,4] * [1,2,3] -> [2,6,12]
    // -------------------------------------------------------------------------
    print("Test 10: zip_mul... ")
    var rawC: [f64; 256] = [0.0; 256]
    rawC[0] = 2.0
    rawC[1] = 3.0
    rawC[2] = 4.0
    let vC = array_view_new(&rawC, 3)
    let zm = iter_zip_mul(&vC, &vA)
    if zm.len == 3 && near(zm.data[0], 2.0) && near(zm.data[1], 6.0) && near(zm.data[2], 12.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 11: take first 2 of [1,2,3,4,5]
    // -------------------------------------------------------------------------
    print("Test 11: take 2... ")
    let tk = iter_take(v5, 2)
    if tk.len == 2 && near(tk.data[0], 1.0) && near(tk.data[1], 2.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 12: skip first 3 of [1,2,3,4,5] -> [4,5]
    // -------------------------------------------------------------------------
    print("Test 12: skip 3... ")
    let sk = iter_skip(v5, 3)
    if sk.len == 2 && near(sk.data[0], 4.0) && near(sk.data[1], 5.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 13: enumerate_sum_indexed [1,2,3] -> 0*1+1*2+2*3 = 8
    // -------------------------------------------------------------------------
    print("Test 13: enumerate_sum_indexed... ")
    let esi = iter_enumerate_sum_indexed(&v1)
    if near(esi, 8.0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 14: all_positive [1,2,3] = true, [-1,2,3] = false
    // -------------------------------------------------------------------------
    print("Test 14: all_positive... ")
    let ap_true = iter_all_positive(&v1)
    let ap_false = iter_all_positive(&v3)
    if ap_true && !ap_false {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 15: any_negative [1,2,3] = false, [-1,2,-3,4] = true
    // -------------------------------------------------------------------------
    print("Test 15: any_negative... ")
    let an_false = iter_any_negative(&v1)
    let an_true = iter_any_negative(&v3)
    if !an_false && an_true {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Test 16: count_gt threshold=2.0 on [1,2,3,4,5] -> 3
    // -------------------------------------------------------------------------
    print("Test 16: count_gt... ")
    let cg = iter_count_gt(&v5, 2.0)
    if cg == 3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------------------------
    // Summary
    // -------------------------------------------------------------------------
    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")
    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Panic, Div {
    return run_tests()
}
