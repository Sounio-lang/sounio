//@ run-pass
//@ expect-stdout: SIO183_MEASUREMENT_FOUR_SOURCES_OK
use particle_physics::systematics::{measurement_new, total_error}
fn main() -> i32 with IO, Mut, Div, Panic {
    let m = measurement_new(12.0, 2.0, 1.0, 2.0, 2.0, 4.0)
    assert(m.value == 12.0 && m.stat_err == 2.0)
    assert(m.syst_errs[0] == 1.0 && m.syst_errs[1] == 2.0)
    assert(m.syst_errs[2] == 2.0 && m.syst_errs[3] == 4.0)
    let got = total_error(m)
    let expected = sqrt(29.0)
    let difference = if got > expected { got - expected } else { expected - got }
    assert(difference < 1.0e-12)
    print("SIO183_MEASUREMENT total_error=")
    print(got)
    print("\nSIO183_MEASUREMENT_FOUR_SOURCES_OK\n")
    return 0
}
