// Appended to legacy source. Valid calls retain the fixed-array conventions.
fn main()->i32 with IO,Mut,Div,Panic {
    var input:[f64;4096]=[0.0;4096]
    var zero:[f64;4096]=[0.0;4096]
    var a:[f64;4096]=[0.0;4096]
    var b:[f64;4096]=[0.0;4096]
    input[0]=1.0
    a[0]=1.0
    fft(&!a,&!b,8)
    var i:i32=0
    while i<8 {if a[i]!=1.0 || b[i]!=0.0 {return 1};i=i+1}
    ifft(&!a,&!b,8)
    if a[0]!=1.0 || b[0]!=0.0 {return 2}
    i=1
    while i<8 {if a[i]>1.0e-12 || a[i]<0.0-1.0e-12 || b[i]>1.0e-12 || b[i]<0.0-1.0e-12 {return 3};i=i+1}
    fft_convolve(&input,&zero,&input,&zero,&!a,&!b,8)
    if a[0]!=1.0 {return 4}
    power_spectrum(&input,&zero,&!a,8)
    i=0
    while i<8 {if a[i]!=1.0 {return 5};i=i+1}
    var re:[f64;2048]=[987.0;2048]
    var im:[f64;2048]=[654.0;2048]
    fft_real(&input,&!re,&!im,2048)
    i=0
    while i<=1024 {if re[i]!=1.0 || im[i]!=0.0 {return 6};i=i+1}
    while i<2048 {if re[i]!=987.0 || im[i]!=654.0 {return 7};i=i+1}
    fft(&!input,&!zero,1)
    if input[0]!=1.0 || zero[0]!=0.0 {return 8}
    if next_power_of_2(1073741825)!=0 {return 9}
    println("FFT_LEGACY_VALID_PASS")
    0
}
