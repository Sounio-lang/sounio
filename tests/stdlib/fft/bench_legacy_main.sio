// Appended to frozen legacy fft.sio: same input and32 forward/inverse pairs.
fn main()->i32 with IO,Mut,Div,Panic {
    var ar:[f64;4096]=[0.0;4096]
    var ai:[f64;4096]=[0.0;4096]
    var i:i32=0
    while i<4096 {
        var r=((i%16-8) as f64)/8.0
        if i==37 {r=r+0.5}
        ar[i]=r
        ai[i]=((i%8-4) as f64)/16.0
        i=i+1
    }
    var repeat:i32=0
    while repeat<32 {fft(&!ar,&!ai,4096);ifft(&!ar,&!ai,4096);repeat=repeat+1}
    var energy:f64=0.0
    i=0
    while i<4096 {let r=ar[i];let v=ai[i];energy=energy+r*r+v*v;i=i+1}
    println(energy)
    println("FFT_BENCH_PASS n=4096 roundtrip_pairs=32")
    0
}
