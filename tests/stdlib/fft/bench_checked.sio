use math::fft_checked::{fft_plan_new,fft_plan_status,fft_plan_close,fft_forward_into,fft_inverse_into}
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use io::sci_print::{println_f64_sci}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let p=fft_plan_new(4096,65536)
    assert(!(fft_plan_status(&p)!=0))
    var ar=numeric_buffer_new(4096,32768)
    var ai=numeric_buffer_new(4096,32768)
    var br=numeric_buffer_new(4096,32768)
    var bi=numeric_buffer_new(4096,32768)
    var work=numeric_buffer_new(8192,65536)
    var i:i64=0
    while i<4096 {
        var r=((i%16-8) as f64)/8.0
        if i==37 {r=r+0.5}
        numeric_buffer_set(&!ar,i,r)
        numeric_buffer_set(&!ai,i,((i%8-4) as f64)/16.0)
        i=i+1
    }
    var repeat:i64=0
    while repeat<32 {
        assert(!(fft_forward_into(&p,&ar,&ai,&!work,&!br,&!bi)!=0))
        assert(!(fft_inverse_into(&p,&br,&bi,&!work,&!ar,&!ai)!=0))
        repeat=repeat+1
    }
    var energy:f64=0.0
    i=0
    while i<4096 {
        let r=numeric_buffer_at(&ar,i)
        let v=numeric_buffer_at(&ai,i)
        energy=energy+r*r+v*v
        i=i+1
    }
    println_f64_sci(energy,15)
    println("FFT_BENCH_PASS n=4096 roundtrip_pairs=32")
    numeric_buffer_close(ar);numeric_buffer_close(ai);numeric_buffer_close(br);numeric_buffer_close(bi);numeric_buffer_close(work);fft_plan_close(p)
    0
}
