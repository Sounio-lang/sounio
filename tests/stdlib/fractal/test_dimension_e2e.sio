//@ run-pass
//@ ignore
// E2E test for stdlib/fractal/dimension
//
// Tests the Higuchi fractal dimension estimator with known signals.
// A pure sine wave should have Higuchi dimension close to 1.0 (smooth curve).
// A more complex signal should yield higher dimension.

use fractal::dimension::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn sin_approx(x: f64) -> f64 {
    let pi = 3.141592653589793
    var y = x
    while y > pi { y = y - 2.0 * pi }
    while y < 0.0 - pi { y = y + 2.0 * pi }
    let x2 = y * y
    var sum = y
    var term = y
    term = term * (0.0 - x2) / 6.0
    sum = sum + term
    term = term * (0.0 - x2) / 20.0
    sum = sum + term
    term = term * (0.0 - x2) / 42.0
    sum = sum + term
    return sum
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: Higuchi dimension of a smooth sine wave should be near 1.0
    print("Test 1: higuchi_dimension sine ~1.0... ")
    var series: Vec<f64> = vec![]
    var i = 0
    while i < 200 {
        let t = (i as f64) * 0.05
        series.push(sin_approx(t))
        i = i + 1
    }
    let result1 = higuchi_dimension(&series, 8)
    // Smooth curve: dimension should be around 1.0 (between 0.8 and 1.3)
    if result1.dimension > 0.8 && result1.dimension < 1.5 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: r_squared should be positive for a reasonable signal
    print("Test 2: r_squared > 0... ")
    if result1.r_squared > 0.0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: num_scales = k_max provided
    print("Test 3: num_scales=8... ")
    let expected_scales: u32 = 8
    if result1.num_scales == expected_scales {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: Constant series should have dimension near 1.0 or lower
    print("Test 4: constant series dim <= 1.5... ")
    var const_series: Vec<f64> = vec![]
    var j = 0
    while j < 100 {
        const_series.push(5.0)
        j = j + 1
    }
    let result2 = higuchi_dimension(&const_series, 4)
    // Constant signal has zero length variation, dimension ill-defined
    // but should not be unreasonably large
    if result2.dimension < 2.0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    return run_tests()
}
