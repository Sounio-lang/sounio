    ArrowBatch,
    ArrowBuf,
    arrow_batch_f64,
    arrow_batch_i64,
    arrow_batch_is_null,
    arrow_batch_new,
    arrow_batch_set_f64,
    arrow_batch_set_i64,
    arrow_batch_set_list,
    arrow_batch_set_node_len,
    arrow_batch_set_str,
    arrow_batch_shape,
    arrow_batch_str_byte,
    arrow_batch_str_len,
    arrow_buf_new,
    arrow_codec_lz4,
    arrow_codec_zstd,
    arrow_cursor_new,
    arrow_dict_str_byte,
    arrow_dict_str_len,
    arrow_dicts_new,
    arrow_feature_compressed,
    arrow_field_set_extension,
    arrow_ipc_file_begin,
    arrow_ipc_file_end,
    arrow_ipc_file_push,
    arrow_ipc_file_push_dict,
    arrow_ipc_next_ex,
    arrow_ipc_open,
    arrow_ipc_open_ex,
    arrow_ipc_read,
    arrow_ipc_stream_begin,
    arrow_ipc_stream_end,
    arrow_ipc_stream_push,
    arrow_ipc_stream_push_dict,
    arrow_ipc_view,
    arrow_schema_add,
    arrow_schema_add_child,
    arrow_schema_add_meta,
    arrow_schema_add_msg_meta,
    arrow_schema_new,
    arrow_schema_set_dict,
    arrow_schema_set_endian,
    arrow_schema_set_feature,
    arrow_schema_set_timezone,
    arrow_spans_new,
    arrow_type_float,
    arrow_type_int,
