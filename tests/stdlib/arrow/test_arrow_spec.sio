    arrow_type_run_end,
    arrow_type_struct,
    arrow_type_timestamp,
    arrow_type_utf8,
    arrow_type_utf8_view,
}

fn byte_of(v: i64) -> i64 {
    if v < 0 { v + 256 } else { v }
}

fn meta_key_is(bytes: &[u8; 128], lens: &[i64; 4], i: i64, text: string) -> i64 with Panic {
    let n = str_len(text)
    if lens[i as usize] != n { return 0 }
    var k: i64 = 0
    while k < n {
        var want = text[k as usize] as i64
        want = byte_of(want)
        let got = byte_of(bytes[(i * 32 + k) as usize] as i64)
        if got != want { return 0 }
        k = k + 1
    }
    1
}

fn str_eq(batch: &ArrowBatch, col: i64, row: i64, text: string) -> i64 with Panic {
    let n = str_len(text)
    if arrow_batch_str_len(batch, col, row) != n { return 0 }
    var i: i64 = 0
    while i < n {
        var want = text[i as usize] as i64
        want = byte_of(want)
        if arrow_batch_str_byte(batch, col, row, i) != want { return 0 }
        i = i + 1
    }
    1
}

fn test_nested() -> i64 with IO, Mut, Panic, Div {
    var schema = arrow_schema_new()
    if arrow_schema_add(&!schema, "col1", 1, arrow_type_struct(), 0, 0, 0) != 0 { return 1 }
    if arrow_schema_add_child(&!schema, 0, "a", 1, arrow_type_int(), 32, 1, 0) != 1 { return 2 }
    if arrow_schema_add_child(&!schema, 0, "b", 1, arrow_type_list(), 0, 0, 0) != 2 { return 3 }
    if arrow_schema_add_child(&!schema, 2, "item", 1, arrow_type_int(), 64, 1, 0) != 3 { return 4 }
    if arrow_schema_add_child(&!schema, 0, "c", 1, arrow_type_float(), 0, 0, 2) != 4 { return 5 }
    if arrow_schema_add(&!schema, "col2", 1, arrow_type_utf8(), 0, 0, 0) != 0 { return 6 }
    if arrow_schema_add_meta(&!schema, "app:ns", "s") != 0 { return 7 }
    if arrow_schema_add_msg_meta(&!schema, "k", "m") != 0 { return 8 }
    if arrow_field_set_extension(&!schema, 5, "myorg.word", "v1") != 0 { return 9 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 2, 2) != 0 { return 10 }
    if arrow_batch_set_i64(&!batch, 1, 0, 1, 0) != 0 { return 11 }
    if arrow_batch_set_i64(&!batch, 1, 1, 0, 1) != 0 { return 12 }
    if arrow_batch_set_list(&!batch, 2, 0, 2) != 0 { return 13 }
    if arrow_batch_set_list(&!batch, 2, 1, 1) != 0 { return 14 }
    if arrow_batch_set_i64(&!batch, 3, 0, 10, 0) != 0 { return 15 }
    if arrow_batch_set_i64(&!batch, 3, 1, 11, 0) != 0 { return 16 }
    if arrow_batch_set_i64(&!batch, 3, 2, 12, 0) != 0 { return 17 }
    if arrow_batch_set_f64(&!batch, 4, 0, 1.5, 0) != 0 { return 18 }
    if arrow_batch_set_f64(&!batch, 4, 1, 0.0, 1) != 0 { return 19 }
    if arrow_batch_set_str(&!batch, 5, 0, "ab", 0) != 0 { return 20 }
    if arrow_batch_set_str(&!batch, 5, 1, "no", 1) != 0 { return 21 }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 22 }
    let view = arrow_ipc_view(&buf, 0)
    if view.header_type != 1 || view.body_len != 0 || view.status != 0 { return 23 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 24 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 25 }
    let n = write_file("/tmp/sounio_arrow_nested.arrows", buf.data, buf.len)
    if n != buf.len { return 26 }
    var schema2 = arrow_schema_new()
    var got = arrow_batch_new()
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 27 }
    if schema2.n_fields != 2 || schema2.n_nodes != 6 { return 28 }
    if schema2.type_tag[0] != arrow_type_struct() { return 29 }
    if schema2.n_child[0] != 3 || schema2.parent[3] != 2 { return 30 }
    if arrow_batch_i64(&got, 1, 0) != 1 { return 31 }
    if arrow_batch_is_null(&got, 1, 1) != 1 { return 32 }
    if got.list_n[2 * 16] != 2 || got.list_n[2 * 16 + 1] != 1 { return 33 }
    if arrow_batch_i64(&got, 3, 0) != 10 || arrow_batch_i64(&got, 3, 2) != 12 { return 34 }
    if arrow_batch_f64(&got, 4, 0) != 1.5 { return 35 }
    if arrow_batch_is_null(&got, 4, 1) != 1 { return 36 }
    if str_eq(&got, 5, 0, "ab") == 0 { return 37 }
    if schema2.smeta_n != 1 { return 38 }
    if meta_key_is(&schema2.smeta_k, &schema2.smeta_kl, 0, "app:ns") == 0 { return 39 }
    if schema2.mmeta_n != 1 { return 40 }
    if schema2.meta_n[5] != 2 { return 41 }
    if meta_key_is(&schema2.mmeta_k, &schema2.mmeta_kl, 0, "k") == 0 { return 42 }
    var spans = arrow_spans_new()
    if arrow_ipc_file_begin(&schema, &!buf) != 0 { return 43 }
    if arrow_ipc_file_push(&schema, &batch, &!buf, &!spans) != 0 { return 44 }
    if arrow_ipc_file_end(&schema, &!buf, &spans) != 0 { return 45 }
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 46 }
    if arrow_batch_i64(&got, 3, 1) != 11 { return 47 }
    if schema2.mmeta_n != 1 { return 48 }
    0
}

fn test_dict() -> i64 with IO, Mut, Panic, Div {
    var schema = arrow_schema_new()
    if arrow_schema_add(&!schema, "s", 1, arrow_type_utf8(), 0, 0, 0) != 0 { return 50 }
    if arrow_schema_set_dict(&!schema, 0, 0, 32, 1, 0) != 0 { return 51 }
    var dict = arrow_batch_new()
    if arrow_batch_shape(&!dict, 3, 1) != 0 { return 52 }
    if arrow_batch_set_str(&!dict, 0, 0, "A", 0) != 0 { return 53 }
    if arrow_batch_set_str(&!dict, 0, 1, "B", 0) != 0 { return 54 }
    if arrow_batch_set_str(&!dict, 0, 2, "C", 0) != 0 { return 55 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 4, 1) != 0 { return 56 }
    if arrow_batch_set_i64(&!batch, 0, 0, 0, 0) != 0 { return 57 }
    if arrow_batch_set_i64(&!batch, 0, 1, 1, 0) != 0 { return 58 }
    if arrow_batch_set_i64(&!batch, 0, 2, 2, 0) != 0 { return 59 }
    if arrow_batch_set_i64(&!batch, 0, 3, 1, 0) != 0 { return 60 }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 61 }
    if arrow_ipc_stream_push_dict(&schema, 0, 0, &dict, &!buf) != 0 { return 62 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 63 }
    if arrow_batch_shape(&!dict, 2, 1) != 0 { return 64 }
    if arrow_batch_set_str(&!dict, 0, 0, "D", 0) != 0 { return 65 }
    if arrow_batch_set_str(&!dict, 0, 1, "E", 0) != 0 { return 66 }
    if arrow_ipc_stream_push_dict(&schema, 0, 1, &dict, &!buf) != 0 { return 67 }
    if arrow_batch_set_i64(&!batch, 0, 0, 3, 0) != 0 { return 68 }
    if arrow_batch_set_i64(&!batch, 0, 1, 2, 0) != 0 { return 69 }
    if arrow_batch_set_i64(&!batch, 0, 2, 4, 0) != 0 { return 70 }
    if arrow_batch_set_i64(&!batch, 0, 3, 0, 0) != 0 { return 71 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 72 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 73 }
    let ns = write_file("/tmp/sounio_arrow_dict.arrows", buf.data, buf.len)
    if ns != buf.len { return 74 }
    var schema2 = arrow_schema_new()
    var got = arrow_batch_new()
    var dicts = arrow_dicts_new()
    var cur = arrow_cursor_new()
    if arrow_ipc_open(&buf, &!schema2, &!cur) != 0 { return 75 }
    if schema2.dict_id[0] != 0 || schema2.dict_width[0] != 32 { return 76 }
    if arrow_ipc_next_ex(&buf, &schema2, &!cur, &!got, &!dicts) != 0 { return 77 }
    if arrow_batch_i64(&got, 0, 0) != 0 || arrow_batch_i64(&got, 0, 3) != 1 { return 78 }
    if dicts.n != 1 || dicts.n_rows[0] != 3 { return 79 }
    if arrow_dict_str_len(&dicts, 0, 0) != 1 { return 80 }
    if arrow_dict_str_byte(&dicts, 0, 1, 0) != 66 { return 81 }
    if arrow_ipc_next_ex(&buf, &schema2, &!cur, &!got, &!dicts) != 0 { return 82 }
    if dicts.n_rows[0] != 5 { return 83 }
    if arrow_dict_str_byte(&dicts, 0, 3, 0) != 68 { return 84 }
    if arrow_dict_str_byte(&dicts, 0, 4, 0) != 69 { return 85 }
    if arrow_batch_i64(&got, 0, 0) != 3 || arrow_batch_i64(&got, 0, 2) != 4 { return 86 }
    if arrow_ipc_next_ex(&buf, &schema2, &!cur, &!got, &!dicts) != 1 { return 87 }
    var spans = arrow_spans_new()
    if arrow_ipc_file_begin(&schema, &!buf) != 0 { return 88 }
    if arrow_batch_shape(&!dict, 3, 1) != 0 { return 89 }
    if arrow_batch_set_str(&!dict, 0, 0, "A", 0) != 0 { return 90 }
    if arrow_batch_set_str(&!dict, 0, 1, "B", 0) != 0 { return 91 }
    if arrow_batch_set_str(&!dict, 0, 2, "C", 0) != 0 { return 92 }
    if arrow_ipc_file_push_dict(&schema, 0, 0, &dict, &!buf, &!spans) != 0 { return 93 }
    if arrow_batch_shape(&!dict, 1, 1) != 0 { return 94 }
    if arrow_batch_set_str(&!dict, 0, 0, "Z", 0) != 0 { return 95 }
    if arrow_ipc_file_push_dict(&schema, 0, 0, &dict, &!buf, &!spans) != -4 { return 96 }
    0
}

fn test_view_codec() -> i64 with IO, Mut, Panic, Div {
    var schema = arrow_schema_new()
    if arrow_schema_set_feature(&!schema, arrow_feature_compressed()) != 0 { return 100 }
    if arrow_schema_add(&!schema, "v", 1, arrow_type_utf8_view(), 0, 0, 0) != 0 { return 101 }
    if arrow_schema_add(&!schema, "id", 0, arrow_type_int(), 64, 1, 0) != 0 { return 102 }
    if arrow_schema_add(&!schema, "ts", 0, arrow_type_timestamp(), 0, 0, 3) != 0 { return 103 }
    if arrow_schema_set_timezone(&!schema, 2, "UTC") != 0 { return 104 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 2, 3) != 0 { return 105 }
    if arrow_batch_set_str(&!batch, 0, 0, "hi", 0) != 0 { return 106 }
    if arrow_batch_set_str(&!batch, 0, 1, "abcdefghijklm", 0) != 0 { return 107 }
    if arrow_batch_set_i64(&!batch, 1, 0, 1, 0) != 0 { return 108 }
    if arrow_batch_set_i64(&!batch, 1, 1, 2, 0) != 0 { return 109 }
    if arrow_batch_set_i64(&!batch, 2, 0, 7, 0) != 0 { return 110 }
    if arrow_batch_set_i64(&!batch, 2, 1, 8, 0) != 0 { return 111 }
    var buf = arrow_buf_new()
    if arrow_batch_set_codec(&!batch, arrow_codec_lz4()) != 0 { return 112 }
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 113 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 114 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 115 }
    let n = write_file("/tmp/sounio_arrow_lz4.arrows", buf.data, buf.len)
    if n != buf.len { return 116 }
    var schema2 = arrow_schema_new()
    var got = arrow_batch_new()
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 117 }
    if str_eq(&got, 0, 0, "hi") == 0 { return 118 }
    if str_eq(&got, 0, 1, "abcdefghijklm") == 0 { return 119 }
    if arrow_batch_i64(&got, 1, 1) != 2 { return 120 }
    if schema2.precision[2] != 3 || schema2.tz_lens[2] != 3 { return 121 }
    if arrow_batch_set_codec(&!batch, arrow_codec_zstd()) != 0 { return 122 }
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 123 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 124 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 125 }
    let nz = write_file("/tmp/sounio_arrow_zstd.arrows", buf.data, buf.len)
    if nz != buf.len { return 126 }
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 127 }
    if arrow_batch_i64(&got, 1, 0) != 1 || arrow_batch_i64(&got, 2, 1) != 8 { return 128 }
    if arrow_schema_set_endian(&!schema, 1) != 0 { return 129 }
    if arrow_ipc_stream_begin(&schema, &!buf) != -4 { return 130 }
    0
}

fn test_ree() -> i64 with Mut, Panic, Div {
    var schema = arrow_schema_new()
    if arrow_schema_add(&!schema, "r", 0, arrow_type_run_end(), 0, 0, 0) != 0 { return 140 }
    if arrow_schema_add_child(&!schema, 0, "run_ends", 0, arrow_type_int(), 32, 1, 0) != 1 { return 141 }
    if arrow_schema_add_child(&!schema, 0, "values", 1, arrow_type_int(), 64, 1, 0) != 2 { return 142 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 4, 1) != 0 { return 143 }
    if arrow_batch_set_node_len(&!batch, 1, 2) != 0 { return 144 }
    if arrow_batch_set_node_len(&!batch, 2, 2) != 0 { return 145 }
    if arrow_batch_set_i64(&!batch, 1, 0, 2, 0) != 0 { return 146 }
    if arrow_batch_set_i64(&!batch, 1, 1, 4, 0) != 0 { return 147 }
    if arrow_batch_set_i64(&!batch, 2, 0, 7, 0) != 0 { return 148 }
    if arrow_batch_set_i64(&!batch, 2, 1, 9, 0) != 0 { return 149 }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 150 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 151 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 152 }
    var schema2 = arrow_schema_new()
    var got = arrow_batch_new()
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 153 }
    if got.n_rows != 4 || got.node_len[1] != 2 { return 154 }
    if arrow_batch_i64(&got, 1, 0) != 2 || arrow_batch_i64(&got, 1, 1) != 4 { return 155 }
    if arrow_batch_i64(&got, 2, 0) != 7 || arrow_batch_i64(&got, 2, 1) != 9 { return 156 }
    0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = test_nested()
    if a != 0 {
        print("FAIL nested ")
        println(a)
        return 1
    }
    let b = test_dict()
    if b != 0 {
        print("FAIL dict ")
        println(b)
        return 1
    }
    let c = test_view_codec()
    if c != 0 {
        print("FAIL view ")
        println(c)
        return 1
    }
    let d = test_ree()
    if d != 0 {
        print("FAIL ree ")
        println(d)
        return 1
    }
    println("ARROW_SPEC_OK")
    0
}
