//@ run-pass
//@ requires: madaros
//@ expect-stdout: ARROW_EXT_OK
// Canonical Arrow extension types.
// https://arrow.apache.org/docs/format/CanonicalExtensions.html

use arrow::ext::{
    arrow_ext_bool8,
    arrow_ext_check,
    arrow_ext_fixed_tensor,
    arrow_ext_json,
    arrow_ext_kind,
    arrow_ext_meta_is,
    arrow_ext_opaque,
    arrow_ext_set_bool8,
    arrow_ext_set_fixed_tensor,
    arrow_ext_set_json,
    arrow_ext_set_opaque,
    arrow_ext_set_ts_offset,
    arrow_ext_set_uuid,
    arrow_ext_set_var_tensor,
    arrow_ext_set_variant,
    arrow_ext_ts_offset,
    arrow_ext_uuid,
    arrow_ext_var_tensor,
    arrow_ext_variant,
}

use arrow::lib::{
    arrow_batch_i64,
    arrow_batch_new,
    arrow_field_set_extension,
    arrow_batch_set_i64,
    arrow_batch_set_str,
    arrow_batch_shape,
    arrow_batch_str_byte,
    arrow_buf_new,
    arrow_ipc_read,
    arrow_ipc_stream_begin,
    arrow_ipc_stream_end,
    arrow_ipc_stream_push,
    arrow_schema_add,
    arrow_schema_add_child,
    arrow_schema_new,
    arrow_schema_set_extra,
    arrow_schema_set_timezone,
    arrow_type_binary,
    arrow_type_fixed_binary,
    arrow_type_fixed_list,
    arrow_type_int,
    arrow_type_list,
    arrow_type_null,
    arrow_type_struct,
    arrow_type_timestamp,
    arrow_type_utf8,
}

fn put_name(dst: &![u8; 64], lens: &![i64; 4], i: i64, text: string) with Mut, Panic {
    let n = str_len(text)
    lens[i as usize] = n
    var k: i64 = 0
    while k < n {
        var ch = text[k as usize] as i64
        if ch < 0 { ch = ch + 256 }
        dst[(i * 16 + k) as usize] = (ch as i32) as u8
        k = k + 1
    }
}

fn test_simple() -> i64 with IO, Mut, Panic, Div {
    var schema = arrow_schema_new()
    if arrow_schema_add(&!schema, "id", 0, arrow_type_fixed_binary(), 0, 0, 0) != 0 { return 1 }
    if arrow_schema_set_extra(&!schema, 0, 16, 0) != 0 { return 2 }
    if arrow_ext_set_uuid(&!schema, 0) != 0 { return 3 }
    if arrow_schema_add(&!schema, "j", 1, arrow_type_utf8(), 0, 0, 0) != 0 { return 4 }
    if arrow_ext_set_json(&!schema, 1) != 0 { return 5 }
    if arrow_schema_add(&!schema, "ok", 0, arrow_type_int(), 8, 1, 0) != 0 { return 6 }
    if arrow_ext_set_bool8(&!schema, 2) != 0 { return 7 }
    if arrow_schema_add(&!schema, "g", 1, arrow_type_binary(), 0, 0, 0) != 0 { return 8 }
    if arrow_ext_set_opaque(&!schema, 3, "geometry", "PostGIS") != 0 { return 9 }
    if arrow_ext_kind(&schema, 0) != arrow_ext_uuid() { return 10 }
    if arrow_ext_kind(&schema, 1) != arrow_ext_json() { return 11 }
    if arrow_ext_kind(&schema, 2) != arrow_ext_bool8() { return 12 }
    if arrow_ext_kind(&schema, 3) != arrow_ext_opaque() { return 13 }
    if arrow_ext_check(&!schema, 0) != 0 { return 14 }
    if arrow_ext_check(&!schema, 3) != 0 { return 15 }
    if arrow_ext_meta_is(&schema, 3, "{\"type_name\":\"geometry\",\"vendor_name\":\"PostGIS\"}") == 0 { return 16 }
    if arrow_ext_set_uuid(&!schema, 1) != -6 { return 17 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 2, 4) != 0 { return 18 }
    if arrow_batch_set_str(&!batch, 0, 0, "0123456789abcdef", 0) != 0 { return 19 }
    if arrow_batch_set_str(&!batch, 0, 1, "0123456789abcdef", 0) != 0 { return 20 }
    if arrow_batch_set_str(&!batch, 1, 0, "{\"a\":1}", 0) != 0 { return 21 }
    if arrow_batch_set_str(&!batch, 1, 1, "null", 0) != 0 { return 22 }
    if arrow_batch_set_i64(&!batch, 2, 0, 0, 0) != 0 { return 23 }
    if arrow_batch_set_i64(&!batch, 2, 1, 2, 0) != 0 { return 24 }
    if arrow_batch_set_str(&!batch, 3, 0, "xy", 0) != 0 { return 25 }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 26 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 27 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 28 }
    let n = write_file("/tmp/sounio_arrow_ext.arrows", buf.data, buf.len)
    if n != buf.len { return 29 }
    var schema2 = arrow_schema_new()
    var got = arrow_batch_new()
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 30 }
    if arrow_ext_kind(&schema2, 0) != arrow_ext_uuid() { return 31 }
    if arrow_ext_kind(&schema2, 2) != arrow_ext_bool8() { return 32 }
    if arrow_ext_check(&!schema2, 0) != 0 { return 33 }
    if arrow_ext_check(&!schema2, 1) != 0 { return 34 }
    if arrow_ext_check(&!schema2, 2) != 0 { return 35 }
    if arrow_ext_check(&!schema2, 3) != 0 { return 36 }
    if arrow_batch_i64(&got, 2, 0) != 0 || arrow_batch_i64(&got, 2, 1) != 2 { return 37 }
    if arrow_batch_str_byte(&got, 1, 0, 0) != 123 { return 38 }
    var other = arrow_schema_new()
    if arrow_schema_add(&!other, "n", 0, arrow_type_int(), 32, 1, 0) != 0 { return 39 }
    if arrow_field_set_extension(&!other, 0, "myorg.point", "") != 0 { return 139 }
    if arrow_ext_kind(&other, 0) != 9 { return 140 }
    if arrow_ext_check(&!other, 0) != 0 { return 141 }
    0
}

fn test_tensor() -> i64 with IO, Mut, Panic, Div {
    var schema = arrow_schema_new()
    if arrow_schema_add(&!schema, "t", 1, arrow_type_fixed_list(), 0, 0, 0) != 0 { return 40 }
    if arrow_schema_set_extra(&!schema, 0, 10, 0) != 0 { return 41 }
    if arrow_schema_add_child(&!schema, 0, "item", 1, arrow_type_int(), 32, 1, 0) != 1 { return 42 }
    var shape: [i64; 4] = [2, 5, 0, 0]
    var perm: [i64; 4] = [0, 0, 0, 0]
    var names: [u8; 64] = [0; 64]
    var nl: [i64; 4] = [0; 4]
    if arrow_ext_set_fixed_tensor(&!schema, 0, &shape, 2, &perm, 0, &names, &nl, 0) != 0 { return 43 }
    if arrow_ext_meta_is(&schema, 0, "{\"shape\":[2,5]}") == 0 { return 44 }
    if arrow_ext_check(&!schema, 0) != 0 { return 45 }
    var shape2: [i64; 4] = [2, 3, 0, 0]
    if arrow_schema_set_extra(&!schema, 0, 6, 0) != 0 { return 46 }
    var perm2: [i64; 4] = [1, 0, 0, 0]
    put_name(&!names, &!nl, 0, "a")
    put_name(&!names, &!nl, 1, "b")
    if arrow_ext_set_fixed_tensor(&!schema, 0, &shape2, 2, &perm2, 2, &names, &nl, 2) != 0 { return 47 }
    if arrow_ext_meta_is(&schema, 0, "{\"shape\":[2,3],\"permutation\":[1,0],\"dim_names\":[\"a\",\"b\"]}") == 0 { return 48 }
    if arrow_ext_check(&!schema, 0) != 0 { return 49 }
    if arrow_ext_kind(&schema, 0) != arrow_ext_fixed_tensor() { return 50 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 1, 1) != 0 { return 51 }
    var k: i64 = 0
    while k < 6 {
        if arrow_batch_set_i64(&!batch, 1, k, k + 1, 0) != 0 { return 52 }
        k = k + 1
    }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 53 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 54 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 55 }
    let n = write_file("/tmp/sounio_arrow_ext_tensor.arrows", buf.data, buf.len)
    if n != buf.len { return 56 }
    var schema2 = arrow_schema_new()
    var got = arrow_batch_new()
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 57 }
    if arrow_ext_kind(&schema2, 0) != arrow_ext_fixed_tensor() { return 58 }
    if arrow_ext_check(&!schema2, 0) != 0 { return 59 }
    if arrow_batch_i64(&got, 1, 5) != 6 { return 60 }
    if arrow_schema_add(&!schema, "v", 1, arrow_type_struct(), 0, 0, 0) != 0 { return 61 }
    let root = schema.n_nodes - 1
    if arrow_schema_add_child(&!schema, root, "data", 1, arrow_type_list(), 0, 0, 0) < 0 { return 62 }
    let data = schema.n_nodes - 1
    if arrow_schema_add_child(&!schema, data, "item", 1, arrow_type_int(), 32, 1, 0) < 0 { return 63 }
    if arrow_schema_add_child(&!schema, root, "shape", 0, arrow_type_fixed_list(), 0, 0, 0) < 0 { return 64 }
    let sh = schema.n_nodes - 1
    if arrow_schema_set_extra(&!schema, sh, 2, 0) != 0 { return 65 }
    if arrow_schema_add_child(&!schema, sh, "item", 0, arrow_type_int(), 32, 1, 0) < 0 { return 66 }
    var uni: [i64; 4] = [400, -1, 0, 0]
    var nm: [u8; 64] = [0; 64]
    var nll: [i64; 4] = [0; 4]
    put_name(&!nm, &!nll, 0, "H")
    put_name(&!nm, &!nll, 1, "W")
    if arrow_ext_set_var_tensor(&!schema, root, &perm, 0, &nm, &nll, 2, &uni, 2) != 0 { return 67 }
    if arrow_ext_kind(&schema, root) != arrow_ext_var_tensor() { return 68 }
    if arrow_ext_check(&!schema, root) != 0 { return 69 }
    if arrow_ext_meta_is(&schema, root, "{\"dim_names\":[\"H\",\"W\"],\"uniform_shape\":[400,null]}") == 0 { return 70 }
    0
}

fn test_struct_ext() -> i64 with IO, Mut, Panic, Div {
    var schema = arrow_schema_new()
    if arrow_schema_add(&!schema, "p", 1, arrow_type_struct(), 0, 0, 0) != 0 { return 80 }
    if arrow_schema_add_child(&!schema, 0, "metadata", 0, arrow_type_binary(), 0, 0, 0) != 1 { return 81 }
    if arrow_schema_add_child(&!schema, 0, "value", 1, arrow_type_binary(), 0, 0, 0) != 2 { return 82 }
    if arrow_ext_set_variant(&!schema, 0) != 0 { return 83 }
    if arrow_ext_kind(&schema, 0) != arrow_ext_variant() { return 84 }
    if arrow_ext_check(&!schema, 0) != 0 { return 85 }
    if arrow_schema_add(&!schema, "when", 1, arrow_type_struct(), 0, 0, 0) != 0 { return 86 }
    let root = schema.n_nodes - 1
    if arrow_schema_add_child(&!schema, root, "timestamp", 0, arrow_type_timestamp(), 0, 0, 3) < 0 { return 87 }
    let ts = schema.n_nodes - 1
    if arrow_schema_set_timezone(&!schema, ts, "UTC") != 0 { return 88 }
    if arrow_schema_add_child(&!schema, root, "offset_minutes", 0, arrow_type_int(), 16, 1, 0) < 0 { return 89 }
    let off = schema.n_nodes - 1
    if arrow_ext_set_ts_offset(&!schema, root) != 0 { return 90 }
    if arrow_ext_kind(&schema, root) != arrow_ext_ts_offset() { return 91 }
    if arrow_ext_check(&!schema, root) != 0 { return 92 }
    if arrow_schema_add(&!schema, "bad", 1, arrow_type_null(), 0, 0, 0) != 0 { return 93 }
    let bad = schema.n_nodes - 1
    if arrow_ext_set_variant(&!schema, bad) != -6 { return 94 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 1, 3) != 0 { return 95 }
    if arrow_batch_set_str(&!batch, 1, 0, "m", 0) != 0 { return 96 }
    if arrow_batch_set_str(&!batch, 2, 0, "v", 0) != 0 { return 97 }
    if arrow_batch_set_i64(&!batch, ts, 0, 5, 0) != 0 { return 98 }
    if arrow_batch_set_i64(&!batch, off, 0, -300, 0) != 0 { return 99 }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 100 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 101 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 102 }
    let n = write_file("/tmp/sounio_arrow_ext_struct.arrows", buf.data, buf.len)
    if n != buf.len { return 103 }
    var schema2 = arrow_schema_new()
    var got = arrow_batch_new()
    if arrow_ipc_read(&buf, &!schema2, &!got) != 0 { return 104 }
    if arrow_ext_kind(&schema2, 0) != arrow_ext_variant() { return 105 }
    if arrow_ext_check(&!schema2, 0) != 0 { return 106 }
    if arrow_ext_kind(&schema2, 3) != arrow_ext_ts_offset() { return 107 }
    if arrow_ext_check(&!schema2, 3) != 0 { return 108 }
    if arrow_batch_i64(&got, ts, 0) != 5 { return 109 }
    0
}

fn test_review() with IO, Mut, Panic, Div {
    var s = arrow_schema_new()
    assert(arrow_schema_add(&!s, "t", 1, arrow_type_fixed_list(), 0, 0, 0) == 0)
    assert(arrow_schema_set_extra(&!s, 0, 10, 0) == 0)
    assert(arrow_schema_add_child(&!s, 0, "item", 1, arrow_type_int(), 32, 1, 0) == 1)
    assert(arrow_field_set_extension(&!s, 0, "arrow.fixed_shape_tensor", " { \"dim_names\" : [\"a\\\"b\", \"c\\\\d\"], \"permutation\": [1, 0], \"shape\": [2, 5] } ") == 0)
    assert(arrow_ext_check(&!s, 0) == 0)
    assert(arrow_field_set_extension(&!s, 0, "arrow.fixed_shape_tensor", "{\"shape\":[2,5],\"permutation\":[0,0]}") == 0)
    assert(arrow_ext_check(&!s, 0) == -6)
    assert(arrow_field_set_extension(&!s, 0, "arrow.fixed_shape_tensor", "{\"shape\":[2,5],\"dim_names\":[\"a\\q\",\"b\"]}") == 0)
    assert(arrow_ext_check(&!s, 0) == -6)
    assert(arrow_field_set_extension(&!s, 0, "arrow.fixed_shape_tensor", "{\"shape\":[18446744073709551618,5]}") == 0)
    assert(arrow_ext_check(&!s, 0) == -6)
    assert(arrow_field_set_extension(&!s, 0, "arrow.fixed_shape_tensor", "{\"shape\":[02,5]}") == 0)
    assert(arrow_ext_check(&!s, 0) == -6)
    assert(arrow_field_set_extension(&!s, 0, "arrow.fixed_shape_tensor", "{\"shape\":[2,5],") == 0)
    assert(arrow_ext_check(&!s, 0) == -6)
    var shape: [i64; 4] = [2, 5, 0, 0]
    var perm: [i64; 4] = [1, 0, 0, 0]
    var names: [u8; 64] = [0; 64]
    var lens: [i64; 4] = [0; 4]
    put_name(&!names, &!lens, 0, "a\"b\n")
    put_name(&!names, &!lens, 1, "c\\d\t")
    assert(arrow_ext_set_fixed_tensor(&!s, 0, &shape, 2, &perm, 2, &names, &lens, 2) == 0)
    assert(arrow_ext_meta_is(&s, 0, "{\"shape\":[2,5],\"permutation\":[1,0],\"dim_names\":[\"a\\\"b\\u000a\",\"c\\\\d\\u0009\"]}") == 1)
    assert(arrow_ext_check(&!s, 0) == 0)
    var buf = arrow_buf_new()
    assert(arrow_ipc_stream_begin(&s, &!buf) == 0)
    assert(arrow_ipc_stream_end(&!buf) == 0)
    var got = arrow_schema_new()
    var batch = arrow_batch_new()
    assert(arrow_ipc_read(&buf, &!got, &!batch) == 0)
    assert(arrow_ext_check(&!got, 0) == 0)
    assert(write_file("/tmp/sounio_arrow_ext_escaped.arrows", buf.data, buf.len) == buf.len)
    lens[0] = -1
    assert(arrow_ext_set_fixed_tensor(&!s, 0, &shape, 2, &perm, 0, &names, &lens, 2) == -7)
    lens[0] = 17
    assert(arrow_ext_set_fixed_tensor(&!s, 0, &shape, 2, &perm, 0, &names, &lens, 2) == -7)
    lens[0] = 65
    assert(arrow_ext_set_fixed_tensor(&!s, 0, &shape, 2, &perm, 0, &names, &lens, 2) == -7)

    var v = arrow_schema_new()
    assert(arrow_schema_add(&!v, "v", 1, arrow_type_struct(), 0, 0, 0) == 0)
    assert(arrow_schema_add_child(&!v, 0, "data", 1, arrow_type_list(), 0, 0, 0) == 1)
    assert(arrow_schema_add_child(&!v, 1, "item", 1, arrow_type_int(), 32, 1, 0) == 2)
    assert(arrow_schema_add_child(&!v, 0, "shape", 0, arrow_type_fixed_list(), 0, 0, 0) == 3)
    assert(arrow_schema_set_extra(&!v, 3, 2, 0) == 0)
    assert(arrow_schema_add_child(&!v, 3, "item", 0, arrow_type_int(), 32, 1, 0) == 4)
    var uniform: [i64; 4] = [9223372036854775807, -1, 0, 0]
    assert(arrow_ext_set_var_tensor(&!v, 0, &perm, 0, &names, &lens, 0, &uniform, 2) == 0)
    assert(arrow_ext_meta_is(&v, 0, "{\"uniform_shape\":[9223372036854775807,null]}") == 1)
    assert(arrow_ext_check(&!v, 0) == 0)
    lens[0] = 65
    assert(arrow_ext_set_var_tensor(&!v, 0, &perm, 0, &names, &lens, 2, &uniform, 0) == -7)
    lens[0] = -1
    assert(arrow_ext_set_var_tensor(&!v, 0, &perm, 0, &names, &lens, 2, &uniform, 0) == -7)
    lens[0] = 17
    assert(arrow_ext_set_var_tensor(&!v, 0, &perm, 0, &names, &lens, 2, &uniform, 0) == -7)
    lens[0] = 4
    assert(arrow_ext_set_var_tensor(&!v, 0, &perm, 2, &names, &lens, 2, &uniform, 0) == 0)
    assert(arrow_ext_check(&!v, 0) == 0)
    assert(arrow_field_set_extension(&!v, 0, "arrow.variable_shape_tensor", "{ ") == 0)
    assert(arrow_ext_check(&!v, 0) == -6)
    assert(arrow_field_set_extension(&!v, 0, "arrow.variable_shape_tensor", "{\"uniform_shape\":[400,null],") == 0)
    assert(arrow_ext_check(&!v, 0) == -6)
    assert(arrow_field_set_extension(&!v, 0, "arrow.variable_shape_tensor", " { \"uniform_shape\" : [400, null], \"dim_names\" : [\"a\\\"b\", \"c\\\\d\"] } ") == 0)
    assert(arrow_ext_check(&!v, 0) == 0)
    v.type_tag[4] = arrow_type_utf8()
    assert(arrow_ext_set_var_tensor(&!v, 0, &perm, 0, &names, &lens, 0, &uniform, 0) == -6)
    assert(arrow_ext_check(&!v, 0) == -6)
    v.type_tag[4] = arrow_type_int()
    v.is_signed[4] = 0
    assert(arrow_ext_check(&!v, 0) == -6)
    v.is_signed[4] = 1
    v.bit_width[4] = 64
    assert(arrow_ext_check(&!v, 0) == -6)
    v.bit_width[4] = 32
    v.n_nodes = 4
    assert(arrow_ext_check(&!v, 0) == -6)
    v.n_nodes = 5
    assert(arrow_schema_add_child(&!v, 3, "extra", 0, arrow_type_int(), 32, 1, 0) == 5)
    assert(arrow_ext_check(&!v, 0) == -6)

    var o = arrow_schema_new()
    assert(arrow_schema_add(&!o, "o", 1, arrow_type_utf8(), 0, 0, 0) == 0)
    assert(arrow_field_set_extension(&!o, 0, "arrow.json", " \n{ \t }\r ") == 0)
    assert(arrow_ext_check(&!o, 0) == 0)
    assert(arrow_field_set_extension(&!o, 0, "arrow.json", "{} true") == 0)
    assert(arrow_ext_check(&!o, 0) == -6)
    assert(arrow_field_set_extension(&!o, 0, "arrow.opaque", " { \"vendor_name\": \"PostGIS\", \"future\": {\"x\": [true, null, -1.2e+3]}, \"type_name\": \"geometry\" } ") == 0)
    assert(arrow_ext_check(&!o, 0) == 0)
    assert(arrow_field_set_extension(&!o, 0, "arrow.opaque", "{\"vendor_name\":\"a\",\"type_name\":123}") == 0)
    assert(arrow_ext_check(&!o, 0) == -6)
    assert(arrow_field_set_extension(&!o, 0, "arrow.opaque", "{\"vendor_name\":\"a\",\"type_name\":\"b\",}") == 0)
    assert(arrow_ext_check(&!o, 0) == -6)
    assert(arrow_ext_set_opaque(&!o, 0, "a\n", "b\t") == 0)
    assert(arrow_ext_meta_is(&o, 0, "{\"type_name\":\"a\\u000a\",\"vendor_name\":\"b\\u0009\"}") == 1)
    assert(arrow_ext_check(&!o, 0) == 0)
    var control: i64 = 0
    lens[0] = 1
    lens[1] = 1
    while control < 32 {
        names[0] = (control as i32) as u8
        assert(arrow_ext_set_fixed_tensor(&!s, 0, &shape, 2, &perm, 0, &names, &lens, 2) == 0)
        assert(arrow_ext_check(&!s, 0) == 0)
        var slot: i64 = 0
        while slot < s.meta_n[0] {
            var k: i64 = 0
            while k < s.meta_vl[slot as usize] {
                assert((s.meta_v[(slot * 128 + k) as usize] as i64) >= 32)
                k = k + 1
            }
            slot = slot + 1
        }
        control = control + 1
    }

    var p = arrow_schema_new()
    assert(arrow_schema_add(&!p, "p", 1, arrow_type_struct(), 0, 0, 0) == 0)
    assert(arrow_ext_set_variant(&!p, 0) == -6)
    assert(arrow_field_set_extension(&!p, 0, "arrow.parquet.variant", "") == 0)
    assert(arrow_ext_check(&!p, 0) == -6)
    assert(arrow_schema_add_child(&!p, 0, "metadata", 0, arrow_type_binary(), 0, 0, 0) == 1)
    assert(arrow_ext_set_variant(&!p, 0) == -6)
    assert(arrow_schema_add_child(&!p, 0, "typed_value", 1, arrow_type_int(), 32, 1, 0) == 2)
    assert(arrow_ext_set_variant(&!p, 0) == 0)
    assert(arrow_ext_check(&!p, 0) == 0)
    p.type_tag[2] = arrow_type_null()
    assert(arrow_ext_check(&!p, 0) == -6)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    test_review()
    let a = test_simple()
    if a != 0 {
        print("FAIL simple ")
        println(a)
        return 1
    }
    let b = test_tensor()
    if b != 0 {
        print("FAIL tensor ")
        println(b)
        return 1
    }
    let c = test_struct_ext()
    if c != 0 {
        print("FAIL struct ")
        println(c)
        return 1
    }
    println("ARROW_EXT_OK")
    0
}
