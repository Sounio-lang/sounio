//@ run-pass
//@ requires: madaros
//@ expect-stdout: ARROW_FEED_OK
// The device slab is one matrix. IPC records stay at 16 rows and are assembled.

use arrow::feed::{
    ArrowFeedBatch,
    arrow_feed_alloc,
    arrow_feed_copy_bytes,
    arrow_feed_encode,
    arrow_feed_free,
    arrow_feed_label,
    arrow_feed_load,
    arrow_feed_max_bytes,
    arrow_feed_new,
    arrow_feed_next,
    arrow_feed_open,
    arrow_feed_payload_bytes,
    arrow_feed_put,
    arrow_feed_put_label,
    arrow_feed_rows_for_payload,
    arrow_feed_u32,
    arrow_feed_u8,
}
use arrow::lib::{
    ArrowSchema,
    arrow_batch_new,
    arrow_batch_set_i64,
    arrow_batch_shape,
    arrow_buf_new,
    arrow_ipc_stream_begin,
    arrow_ipc_stream_end,
    arrow_ipc_stream_push,
    arrow_ipc_write_file,
    arrow_schema_add,
    arrow_schema_new,
    arrow_type_float,
    arrow_type_int,
}

fn f32_bits(n: i64) -> i64 {
    if n == 1 { return 1065353216 }
    if n == 2 { return 1073741824 }
    if n == 3 { return 1077936128 }
    if n == 4 { return 1082130432 }
    if n == 5 { return 1084227584 }
    if n == 6 { return 1086324736 }
    if n == 7 { return 1088421888 }
    if n == 8 { return 1090519040 }
    0
}

fn add_f32(schema: &!ArrowSchema, name: string) -> i64 with Mut, Panic {
    arrow_schema_add(schema, name, 0, arrow_type_float(), 0, 0, 1)
}

fn fail(code: i64) -> i64 with IO {
    print("ARROW_FEED_FAIL ")
    print_int(code)
    println("")
    code
}

fn test_sizes() -> i64 with Div, Panic {
    if arrow_feed_max_bytes() != 8388608 { return 10 }
    if arrow_feed_rows_for_payload(8, 8388608) != 262144 { return 11 }
    if arrow_feed_rows_for_payload(8, 8388609) != -7 { return 12 }
    if arrow_feed_rows_for_payload(8, 32) != 1 { return 13 }
    if arrow_feed_rows_for_payload(8, 33) != 2 { return 14 }
    if arrow_feed_rows_for_payload(9, 32) != -7 { return 15 }
    if arrow_feed_payload_bytes(16, 8) != 512 { return 16 }
    if arrow_feed_payload_bytes(262144, 8) != 8388608 { return 17 }
    if arrow_feed_payload_bytes(32, 8) != 1024 { return 18 }
    0
}

fn test_roundtrip_past_one_record() -> i64 with Alloc, Mut, Div, Panic {
    var feed = arrow_feed_new()
    if arrow_feed_alloc(&!feed, 8, 32, 0) != 0 { return 20 }
    var r: i64 = 0
    while r < 32 {
        var c: i64 = 0
        while c < 8 {
            let bits = f32_bits(((r + c) % 8) + 1)
            if arrow_feed_put(&!feed, c, r, bits) != 0 { return 21 }
            c = c + 1
        }
        r = r + 1
    }
    let enc = arrow_feed_encode(&!feed)
    if enc != 0 { return enc }
    if feed.n_batches != 2 { return 24 }
    if arrow_feed_put(&!feed, 0, 0, 0) != 0 { return 25 }
    if arrow_feed_load(&!feed) != 0 { return 26 }
    if feed.rows != 32 || feed.cols != 8 || feed.has_label != 0 { return 27 }
    if feed.features_bytes != 1024 { return 28 }
    if arrow_feed_copy_bytes(&feed) != 1024 { return 29 }
    if arrow_feed_u32(&feed, 0) != f32_bits(1) { return 30 }
    if arrow_feed_u32(&feed, 16 * 4) != f32_bits(1) { return 31 }
    if arrow_feed_u32(&feed, (7 * 32 + 31) * 4) != f32_bits(7) { return 32 }
    var step = ArrowFeedBatch {
        index: 0,
        rows: 0,
        cols: 0,
        offset: 0,
        features_bytes: 0,
        nbytes: 0,
        has_label: 0,
    }
    if arrow_feed_next(&!feed, &!step) != 0 { return 36 }
    if step.rows != 32 || step.nbytes != arrow_feed_copy_bytes(&feed) { return 37 }
    if arrow_feed_next(&!feed, &!step) != 1 { return 38 }
    arrow_feed_free(&!feed)
    0
}

fn test_label_roundtrip() -> i64 with Alloc, Mut, Div, Panic {
    var feed = arrow_feed_new()
    if arrow_feed_alloc(&!feed, 2, 20, 1) != 0 { return 80 }
    var r: i64 = 0
    while r < 20 {
        if arrow_feed_put(&!feed, 0, r, f32_bits((r % 8) + 1)) != 0 { return 81 }
        if arrow_feed_put(&!feed, 1, r, f32_bits(((r + 3) % 8) + 1)) != 0 { return 82 }
        let lab = if r == 16 { -3 } else { 100 + r }
        if arrow_feed_put_label(&!feed, r, lab) != 0 { return 83 }
        r = r + 1
    }
    if arrow_feed_encode(&!feed) != 0 { return 84 }
    if feed.n_batches != 2 { return 85 }
    if arrow_feed_load(&!feed) != 0 { return 86 }
    if feed.rows != 20 || feed.features_bytes != 160 { return 87 }
    if arrow_feed_u32(&feed, 16 * 4) != f32_bits(1) { return 88 }
    if arrow_feed_u32(&feed, (1 * 20 + 16) * 4) != f32_bits(4) { return 89 }
    if arrow_feed_label(&feed, 16) != -3 || arrow_feed_label(&feed, 19) != 119 { return 90 }
    if arrow_feed_u8(&feed, 160 + 16 * 8) != 253 { return 91 }
    arrow_feed_free(&!feed)
    0
}

fn test_open_assembles_records() -> i64 with Alloc, IO, Mut, Div, Panic {
    var schema = arrow_schema_new()
    if add_f32(&!schema, "a") != 0 { return 40 }
    if add_f32(&!schema, "b") != 0 { return 41 }
    if arrow_schema_add(&!schema, "label", 0, arrow_type_int(), 64, 1, 0) != 0 { return 42 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 4, 3) != 0 { return 43 }
    var r: i64 = 0
    while r < 4 {
        if arrow_batch_set_i64(&!batch, 0, r, f32_bits(r + 1), 0) != 0 { return 44 }
        if arrow_batch_set_i64(&!batch, 1, r, f32_bits(r + 5), 0) != 0 { return 45 }
        if arrow_batch_set_i64(&!batch, 2, r, 100 + r, 0) != 0 { return 46 }
        r = r + 1
    }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 47 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 48 }
    if arrow_batch_shape(&!batch, 2, 3) != 0 { return 49 }
    if arrow_batch_set_i64(&!batch, 0, 0, f32_bits(1), 0) != 0 { return 50 }
    if arrow_batch_set_i64(&!batch, 0, 1, f32_bits(2), 0) != 0 { return 51 }
    if arrow_batch_set_i64(&!batch, 1, 0, f32_bits(3), 0) != 0 { return 52 }
    if arrow_batch_set_i64(&!batch, 1, 1, f32_bits(4), 0) != 0 { return 53 }
    if arrow_batch_set_i64(&!batch, 2, 0, -3, 0) != 0 { return 54 }
    if arrow_batch_set_i64(&!batch, 2, 1, 8, 0) != 0 { return 55 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 56 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 57 }
    var feed = arrow_feed_new()
    let opened = arrow_feed_open(&buf, &!feed)
    if opened != 0 { return 58 }
    if feed.rows != 6 || feed.cols != 2 || feed.has_label != 1 { return 59 }
    if feed.features_bytes != 48 || arrow_feed_copy_bytes(&feed) != 96 { return 60 }
    if arrow_feed_u32(&feed, 0) != f32_bits(1) { return 61 }
    if arrow_feed_u32(&feed, 4 * 4) != f32_bits(1) { return 62 }
    if arrow_feed_u32(&feed, 6 * 4) != f32_bits(5) { return 63 }
    if arrow_feed_u32(&feed, 10 * 4) != f32_bits(3) { return 64 }
    if arrow_feed_label(&feed, 0) != 100 || arrow_feed_label(&feed, 3) != 103 { return 65 }
    if arrow_feed_label(&feed, 4) != -3 || arrow_feed_label(&feed, 5) != 8 { return 66 }
    if arrow_feed_u8(&feed, 48 + 4 * 8) != 253 { return 67 }
    arrow_feed_free(&!feed)
    0
}

fn test_align_and_file() -> i64 with Alloc, Mut, Div, Panic {
    var schema = arrow_schema_new()
    if add_f32(&!schema, "a") != 0 { return 70 }
    if arrow_schema_add(&!schema, "label", 0, arrow_type_int(), 64, 1, 0) != 0 { return 71 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 1, 2) != 0 { return 72 }
    if arrow_batch_set_i64(&!batch, 0, 0, f32_bits(1), 0) != 0 { return 73 }
    if arrow_batch_set_i64(&!batch, 1, 0, 7, 0) != 0 { return 74 }
    var buf = arrow_buf_new()
    if arrow_ipc_write_file(&schema, &batch, &!buf) != 0 { return 75 }
    var feed = arrow_feed_new()
    if arrow_feed_open(&buf, &!feed) != 0 { return 76 }
    if feed.rows != 1 || feed.cols != 1 { return 77 }
    if feed.features_bytes != 4 || arrow_feed_copy_bytes(&feed) != 16 { return 78 }
    if arrow_feed_u32(&feed, 0) != f32_bits(1) { return 79 }
    if arrow_feed_u8(&feed, 4) != 0 || arrow_feed_u8(&feed, 7) != 0 { return 92 }
    if arrow_feed_label(&feed, 0) != 7 || arrow_feed_u8(&feed, 8) != 7 { return 93 }
    arrow_feed_free(&!feed)
    0
}

fn test_refusals() -> i64 with Alloc, Mut, Div, Panic {
    var schema = arrow_schema_new()
    if arrow_schema_add(&!schema, "x", 0, arrow_type_float(), 0, 0, 2) != 0 { return 90 }
    var batch = arrow_batch_new()
    if arrow_batch_shape(&!batch, 1, 1) != 0 { return 91 }
    if arrow_batch_set_i64(&!batch, 0, 0, 1, 0) != 0 { return 92 }
    var buf = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema, &!buf) != 0 { return 93 }
    if arrow_ipc_stream_push(&schema, &batch, &!buf) != 0 { return 94 }
    if arrow_ipc_stream_end(&!buf) != 0 { return 95 }
    var feed = arrow_feed_new()
    if arrow_feed_open(&buf, &!feed) != -4 { return 96 }
    var schema2 = arrow_schema_new()
    if arrow_schema_add(&!schema2, "x", 0, arrow_type_float(), 0, 0, 1) != 0 { return 97 }
    var batch2 = arrow_batch_new()
    if arrow_batch_shape(&!batch2, 2, 1) != 0 { return 98 }
    if arrow_batch_set_i64(&!batch2, 0, 0, f32_bits(1), 0) != 0 { return 99 }
    if arrow_batch_set_i64(&!batch2, 0, 1, f32_bits(2), 1) != 0 { return 100 }
    var buf2 = arrow_buf_new()
    if arrow_ipc_stream_begin(&schema2, &!buf2) != 0 { return 101 }
    if arrow_ipc_stream_push(&schema2, &batch2, &!buf2) != 0 { return 102 }
    if arrow_ipc_stream_end(&!buf2) != 0 { return 103 }
    if arrow_feed_open(&buf2, &!feed) != -4 { return 104 }
    arrow_feed_free(&!feed)
    0
}

fn main() -> i32 with Alloc, IO, Mut, Panic, Div {
    let s = test_sizes()
    if s != 0 {
        let _ = fail(s)
        return 1
    }
    let a = test_roundtrip_past_one_record()
    if a != 0 {
        let _ = fail(a)
        return 1
    }
    let lab = test_label_roundtrip()
    if lab != 0 {
        let _ = fail(lab)
        return 1
    }
    let b = test_open_assembles_records()
    if b != 0 {
        let _ = fail(b)
        return 1
    }
    let c = test_align_and_file()
    if c != 0 {
        let _ = fail(c)
        return 1
    }
    let d = test_refusals()
    if d != 0 {
        let _ = fail(d)
        return 1
    }
    println("ARROW_FEED_OK")
    0
}
