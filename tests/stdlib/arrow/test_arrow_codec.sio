//@ run-pass
//@ requires: madaros
//@ expect-stdout: CODEC_OK
// LZ4 frame and Zstandard body codecs.

use arrow::compress::{
    codec_buf_new,
    codec_compress_lz4,
    codec_compress_zstd,
    codec_decompress_lz4,
    codec_decompress_zstd,
}

fn put(dst: &![u8; 4096], i: i64, v: i64) with Mut, Panic {
    dst[i as usize] = (v as i32) as u8
}

fn get(src: &[u8; 4096], i: i64) -> i64 with Panic {
    let v = src[i as usize] as i64
    if v < 0 { v + 256 } else { v }
}

fn fill_i64(buf: &![u8; 4096], n: i64, a: i64, b: i64, c: i64) with Mut, Panic {
    var xs: [i64; 3] = [a, b, c]
    var i: i64 = 0
    while i < n {
        let v = xs[i as usize]
        put(buf, i * 8, v)
        put(buf, i * 8 + 1, v >> 8)
        put(buf, i * 8 + 2, v >> 16)
        put(buf, i * 8 + 3, v >> 24)
        put(buf, i * 8 + 4, v >> 32)
        put(buf, i * 8 + 5, v >> 40)
        put(buf, i * 8 + 6, v >> 48)
        put(buf, i * 8 + 7, v >> 56)
        i = i + 1
    }
}

fn same(a: &[u8; 4096], b: &[u8; 4096], n: i64) -> i64 with Panic {
    var i: i64 = 0
    while i < n {
        if get(a, i) != get(b, i) { return 0 }
        i = i + 1
    }
    1
}

fn load_hex_at(dst: &![u8; 4096], text: string, at: i64) -> i64 with Mut, Panic {
    let n = str_len(text)
    var i: i64 = 0
    var o = at
    while i + 1 < n {
        var h0 = text[i as usize] as i64
        var h1 = text[(i + 1) as usize] as i64
        if h0 < 0 { h0 = h0 + 256 }
        if h1 < 0 { h1 = h1 + 256 }
        if h0 >= 97 { h0 = h0 - 87 }
        else { h0 = h0 - 48 }
        if h1 >= 97 { h1 = h1 - 87 }
        else { h1 = h1 - 48 }
        put(dst, o, h0 * 16 + h1)
        o = o + 1
        i = i + 2
    }
    o
}

fn load_hex(dst: &![u8; 4096], text: string) -> i64 with Mut, Panic {
    load_hex_at(dst, text, 0)
}

fn test_round() -> i64 with Mut, Panic {
    var src: [u8; 4096] = [0; 4096]
    fill_i64(&!src, 3, 1, 2, 3)
    var frame = codec_buf_new()
    if codec_compress_lz4(&src, 24, &!frame) != 0 { return 1 }
    var back = codec_buf_new()
    if codec_decompress_lz4(&frame.data, frame.len, &!back) != 0 { return 2 }
    if back.len != 24 { return 3 }
    if same(&src, &back.data, 24) == 0 { return 4 }
    if codec_compress_zstd(&src, 24, &!frame) != 0 { return 5 }
    if codec_decompress_zstd(&frame.data, frame.len, &!back) != 0 { return 6 }
    if back.len != 24 { return 7 }
    if same(&src, &back.data, 24) == 0 { return 8 }
    0
}

fn test_pyarrow() -> i64 with Mut, Panic {
    var src: [u8; 4096] = [0; 4096]
    let n = load_hex(&!src, "28b52ffd2018a5000060010002000300000000000000020060e0016001")
    var back = codec_buf_new()
    if codec_decompress_zstd(&src, n, &!back) != 0 { return 10 }
    if back.len != 24 { return 11 }
    var expect: [u8; 4096] = [0; 4096]
    fill_i64(&!expect, 3, 1, 2, 3)
    if same(&expect, &back.data, 24) == 0 { return 12 }
    let n2 = load_hex(&!src, "28b52ffd2080750100640207000700070007000700070007000700070007000700070007000700070007000000000000000f5402000301")
    if codec_decompress_zstd(&src, n2, &!back) != 0 { return 13 }
    if back.len != 128 { return 14 }
    var i: i64 = 0
    while i < 16 {
        if get(&back.data, i * 8) != 7 { return 15 }
        if get(&back.data, i * 8 + 1) != 0 { return 16 }
        i = i + 1
    }
    let n3 = load_hex(&!src, "04224d18604082130000002201000100120207009000030000000000000000000000")
    if codec_decompress_lz4(&src, n3, &!back) != 0 { return 17 }
    if back.len != 24 { return 18 }
    if same(&expect, &back.data, 24) == 0 { return 19 }
    0
}

fn byte_sum(src: &[u8; 4096], n: i64) -> i64 with Panic {
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        s = s + get(src, i)
        i = i + 1
    }
    s
}

fn test_huff() -> i64 with Mut, Panic {
    var src: [u8; 4096] = [0; 4096]
    var back = codec_buf_new()
    let n = load_hex(&!src, "28b52ffd6000007501006244090710f8cc01132353ff2e77abcd62afd62a752a8d429fce2673a94c228fc62271280c02df011f5402000301")
    if codec_decompress_zstd(&src, n, &!back) != 0 { return 20 }
    if back.len != 256 { return 21 }
    if byte_sum(&back.data, 256) != 496 { return 22 }
    if get(&back.data, 8) != 1 { return 23 }
    if get(&back.data, 248) != 31 { return 24 }
    let n2 = load_hex(&!src, "28b52ffd205465010042050a11a0e71c28288aa228aadc4764761f9179293f6ebc38f1e1c283037f776f675f574f473f372f271f00")
    if codec_decompress_zstd(&src, n2, &!back) != 0 { return 25 }
    if back.len != 84 { return 26 }
    if byte_sum(&back.data, 84) != 1050 { return 27 }
    if get(&back.data, 80) != 100 { return 28 }
    let n3 = load_hex(&!src, "28b52ffd60800155040002071923802f3406cb3019e8276882e650344193f01a322490400209249040429284c11a609702c79aaac73e66fb58b66f65fbce559e72949fdce42527f9c8451e72907fdce31de7f84693c15c2c15ca4412813c1c0dc64291401c0c05c24010009c2f97aa96064ea810c03ee0d71012c93703721fe85ba634dba9874e7aa9d3b44825ac9b1e71a0d45a")
    if codec_decompress_zstd(&src, n3, &!back) != 0 { return 29 }
    if back.len != 640 { return 30 }
    if byte_sum(&back.data, 640) != 13013 { return 31 }
    if get(&back.data, 14) != 224 { return 32 }
    if get(&back.data, 15) != 63 { return 33 }
    let n4 = load_hex(&!src, "28b52ffd60f4004d00001000000100ef2ac002")
    if codec_decompress_zstd(&src, n4, &!back) != 0 { return 34 }
    if back.len != 500 { return 35 }
    if byte_sum(&back.data, 500) != 0 { return 36 }
    var o = load_hex_at(&!src, "", 0)
    o = load_hex_at(&!src, "", o)
    o = load_hex_at(&!src, "73354f73343f73332f73321f73310f7330ff722fef722e0100", o)
    if codec_decompress_zstd(&src, o, &!back) != 0 { return 37 }
    if back.len != 800 { return 38 }
    if byte_sum(&back.data, 800) != 19900 { return 39 }
    if get(&back.data, 796) != 199 { return 40 }
    0
}

fn test_edges() -> i64 with Mut, Panic {
    var src: [u8; 4096] = [0; 4096]
    var back = codec_buf_new()
    var frame = codec_buf_new()
    if codec_compress_zstd(&src, 0, &!frame) != 0 { return 50 }
    if codec_decompress_zstd(&frame.data, frame.len, &!back) != 0 { return 51 }
    if back.len != 0 { return 52 }
    if codec_compress_lz4(&src, 0, &!frame) != 0 { return 53 }
    if codec_decompress_lz4(&frame.data, frame.len, &!back) != 0 { return 54 }
    if back.len != 0 { return 55 }
    src[0] = 122 as u8
    if codec_compress_lz4(&src, 1, &!frame) != 0 { return 56 }
    if codec_decompress_lz4(&frame.data, frame.len, &!back) != 0 { return 57 }
    if back.len != 1 || get(&back.data, 0) != 122 { return 58 }
    if codec_decompress_lz4(&frame.data, frame.len - 4, &!back) != -6 { return 59 }
    if codec_decompress_zstd(&src, 4, &!back) != -6 { return 60 }
    if codec_decompress_lz4(&src, 4, &!back) != -6 { return 61 }
    let n = load_hex(&!src, "28b52ffd2004230000ab")
    if codec_decompress_zstd(&src, n, &!back) != 0 { return 62 }
    if back.len != 4 || byte_sum(&back.data, 4) != 684 { return 63 }
    let n2 = load_hex(&!src, "28b52ffd200510000061621b000063")
    if codec_decompress_zstd(&src, n2, &!back) != 0 { return 64 }
    if back.len != 5 { return 65 }
    if get(&back.data, 0) != 97 || get(&back.data, 1) != 98 { return 66 }
    if get(&back.data, 2) != 99 || get(&back.data, 4) != 99 { return 67 }
    let n3 = load_hex(&!src, "28b52ffd00001100006869")
    if codec_decompress_zstd(&src, n3, &!back) != 0 { return 68 }
    if back.len != 2 || get(&back.data, 0) != 104 || get(&back.data, 1) != 105 { return 69 }
    let n4 = load_hex(&!src, "28b52ffd20044500004200018111110100")
    if codec_decompress_zstd(&src, n4, &!back) != 0 { return 70 }
    if back.len != 4 { return 71 }
    if get(&back.data, 0) != 0 || get(&back.data, 1) != 1 { return 72 }
    if get(&back.data, 2) != 0 || get(&back.data, 3) != 1 { return 73 }
    let n5 = load_hex(&!src, "28b52ffd24466d00003861626364656667010094548ca94a4754")
    if codec_decompress_zstd(&src, n5, &!back) != 0 { return 74 }
    if back.len != 70 || get(&back.data, 0) != 97 || get(&back.data, 6) != 103 { return 75 }
    if codec_decompress_zstd(&src, n5 - 4, &!back) != -6 { return 76 }
    src[4] = 33 as u8
    if codec_decompress_zstd(&src, n5, &!back) != -4 { return 77 }
    src[4] = 40 as u8
    if codec_decompress_zstd(&src, n5, &!back) != -6 { return 78 }
    let n6 = load_hex(&!src, "28b52ffd00006d00003861626364656667010094548c")
    if codec_decompress_zstd(&src, n6, &!back) != 0 { return 79 }
    if back.len != 70 || get(&back.data, 69) != 103 { return 80 }
    let n7 = load_hex(&!src, "04224d186040820600000030616263030000000000")
    if codec_decompress_lz4(&src, n7, &!back) != 0 { return 81 }
    if back.len != 7 { return 82 }
    if get(&back.data, 0) != 97 || get(&back.data, 3) != 97 || get(&back.data, 6) != 97 { return 83 }
    let n8 = load_hex(&!src, "04224d186040820300008078797a00000000")
    if codec_decompress_lz4(&src, n8, &!back) != 0 { return 84 }
    if back.len != 3 || get(&back.data, 0) != 120 || get(&back.data, 2) != 122 { return 85 }
    let n9 = load_hex(&!src, "04224d186440a70200008061620000000053fc9949")
    if codec_decompress_lz4(&src, n9, &!back) != 0 { return 86 }
    if back.len != 2 || get(&back.data, 0) != 97 || get(&back.data, 1) != 98 { return 87 }
    src[(n9 - 1) as usize] = 0 as u8
    if codec_decompress_lz4(&src, n9, &!back) != -6 { return 88 }
    var i: i64 = 0
    while i < 4086 {
        src[i as usize] = ((i & 255) as i32) as u8
        i = i + 1
    }
    if codec_compress_zstd(&src, 300, &!frame) != 0 { return 89 }
    if codec_decompress_zstd(&frame.data, frame.len, &!back) != 0 { return 90 }
    if back.len != 300 || get(&back.data, 0) != 0 || get(&back.data, 299) != 43 { return 91 }
    if codec_compress_lz4(&src, 100, &!frame) != 0 { return 92 }
    if codec_decompress_lz4(&frame.data, frame.len, &!back) != 0 { return 93 }
    if back.len != 100 || get(&back.data, 99) != 99 { return 94 }
    if codec_compress_zstd(&src, 4086, &!frame) != 0 { return 95 }
    if codec_decompress_zstd(&frame.data, frame.len, &!back) != 0 { return 96 }
    if back.len != 4086 || get(&back.data, 4085) != 245 { return 97 }
    if codec_compress_zstd(&src, 4087, &!frame) != -1 { return 98 }
    if codec_compress_zstd(&src, 4097, &!frame) != -7 { return 99 }
    if codec_compress_lz4(&src, -1, &!frame) != -7 { return 100 }
    let nr = load_hex(&!src, "28b52ffd20010d000003")
    if codec_decompress_zstd(&src, nr, &!back) != -4 { return 101 }
    let ns = load_hex(&!src, "28b52ffd20001d0000000101")
    if codec_decompress_zstd(&src, ns, &!back) != -6 { return 102 }
    let n4s = load_hex(&!src, "28b52ffda0020000001100006869")
    if codec_decompress_zstd(&src, n4s, &!back) != 0 { return 103 }
    if back.len != 2 || get(&back.data, 0) != 104 || get(&back.data, 1) != 105 { return 104 }
    let n8s = load_hex(&!src, "28b52ffde002000000000000001100006869")
    if codec_decompress_zstd(&src, n8s, &!back) != 0 { return 105 }
    if back.len != 2 || get(&back.data, 0) != 104 { return 106 }
    let ncs = load_hex(&!src, "04224d1878400300000000000000f00300008078797a0000000000000000")
    if codec_decompress_lz4(&src, ncs, &!back) != 0 { return 107 }
    if back.len != 3 || get(&back.data, 0) != 120 || get(&back.data, 2) != 122 { return 108 }
    // Two compressed blocks. The second match uses the repeat offset set by the first.
    let nrep = load_hex(&!src, "28b52ffd20094c00001001020154020200054500000809015401000001")
    if codec_decompress_zstd(&src, nrep, &!back) != 0 { return 109 }
    if back.len != 9 { return 110 }
    if get(&back.data, 0) != 1 || get(&back.data, 1) != 2 || get(&back.data, 4) != 1 { return 111 }
    if get(&back.data, 5) != 9 || get(&back.data, 6) != 1 || get(&back.data, 8) != 1 { return 112 }
    // The offset bits live only in the sequence bitstream. Dropping them must
    // not borrow the preceding RLE symbol byte.
    let ncut = load_hex(&!src, "28b52ffd20094c00001001020154020200014500000809015401000001")
    if codec_decompress_zstd(&src, ncut, &!back) != -6 { return 113 }
    0
}

fn main() -> i32 with IO, Mut, Panic {
    let a = test_round()
    if a != 0 {
        print("FAIL round ")
        println(a)
        return 1
    }
    let b = test_pyarrow()
    if b != 0 {
        print("FAIL py ")
        println(b)
        return 1
    }
    let c = test_huff()
    if c != 0 {
        print("FAIL huff ")
        println(c)
        return 1
    }
    let d = test_edges()
    if d != 0 {
        print("FAIL edges ")
        println(d)
        return 1
    }
    println("CODEC_OK")
    0
}
