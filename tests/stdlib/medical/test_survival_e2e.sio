//@ run-pass
//@ expect-stdout: MEDICAL_SURVIVAL_OK
use medical::survival::*;
fn main() -> i32 with IO {
    let e = make_event(1.0, true)
    if e.time != 1.0 { return 1 }
    if !e.observed { return 1 }
    let c = make_event(2.0, false)
    if c.time != 2.0 { return 1 }
    if c.observed { return 1 }
    println("MEDICAL_SURVIVAL_OK")
    0
}
