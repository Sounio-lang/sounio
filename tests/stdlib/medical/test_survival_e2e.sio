//@ check-only
// E2E test for stdlib/medical/survival
// Tests: SurvivalEvent, SurvivalData, KMEstimate, NelsonAalenEst,
//        CoxModel, HazardRatio, LogRankResult, RMSTResult,
//        km_estimate, nelson_aalen, km_median_survival, km_rmst

use medical::survival::*

fn make_event(t: f64, obs: bool) -> SurvivalEvent {
    return SurvivalEvent {
        time: t,
        observed: obs,
        covariates: [0.0; 16],
    }
}

fn run_tests() -> i32 with Mut, Div, Panic {
    // Build a small dataset: 5 patients
    var data = SurvivalData {
        events: [SurvivalEvent { time: 0.0, observed: false, covariates: [0.0; 16] }; 2048],
        n: 5,
    }
    data.events[0] = make_event(1.0, true)
    data.events[1] = make_event(2.0, true)
    data.events[2] = make_event(3.0, false)
    data.events[3] = make_event(4.0, true)
    data.events[4] = make_event(5.0, false)

    // Test 1: Kaplan-Meier estimate
    let km = km_estimate(&! data)
    if km.n_points < 1 { return 1 }

    // Test 2: Median survival
    let med = km_median_survival(&km)
    // med is either a valid time or -1 (not reached)

    // Test 3: RMST up to tau=6
    let rmst = km_rmst(&km, 6.0)
    if rmst.rmst < 0.0 { return 1 }

    // Test 4: Nelson-Aalen (need mutable data again)
    var data2 = SurvivalData {
        events: [SurvivalEvent { time: 0.0, observed: false, covariates: [0.0; 16] }; 2048],
        n: 3,
    }
    data2.events[0] = make_event(1.0, true)
    data2.events[1] = make_event(2.0, true)
    data2.events[2] = make_event(3.0, true)

    let na = nelson_aalen(&! data2)
    if na.n_points < 1 { return 1 }

    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    return run_tests()
}
