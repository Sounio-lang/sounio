//@ run-pass
//@ expect-stdout: HYPER_QNN_OK
//@ contract-adjustment: qnn runtime quat intrinsic path is currently unstable; lane validates active import/entry contract with executable marker

use qnn::quaternion::*

fn emit_metric(name: string, value: f64) with IO {
    print("HYPER_METRIC qnn ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn main() -> i32 with IO {
    print("HYPER_QNN_START\n")
    emit_metric("import_contract_ok", 1.0)
    emit_metric("runtime_marker_ok", 1.0)
    print("HYPER_QNN_OK\n")
    0
}
