//@ run-pass
//@ expect-stdout: HELIOBIOLOGY_OK
// Test suite for stdlib/heliobiology: geomagnetic indices, solar events,
// unit conversions, and the published effect estimates in effects.sio.
//
// The effect estimates are checked against an independent transcription of
// the source tables (#2835): Zilli Vieira et al. 2019, Environ Health 18:83,
// Tables 2 and 3 (doi:10.1186/s12940-019-0516-0), and Zilli Vieira et al.
// 2022, Sci Total Environ 839:156235, abstract (doi:10.1016/j.scitotenv.
// 2022.156235). For every row: the module value equals the published point
// estimate, its standard uncertainty equals (upper - lower) / (2 z_0.975),
// and value +- z_0.975 u reproduces the published 95 % bounds to within
// 0.016 (the published bounds are rounded to two decimals and some point
// estimates to one, so a bound and the midpoint can differ by that much; the
// largest deviation over all 34 rows is printed and asserted).

use heliobiology::indices::*
use heliobiology::solar::*
use heliobiology::units::*
use heliobiology::effects::*
use epistemic::knowledge::{Epistemic, ep_val, ep_std}

// ============================================================================
// SOURCE TABLES, transcribed independently of stdlib/heliobiology/effects.sio
// ============================================================================

struct HbRow {
    point: f64,
    lower: f64,
    upper: f64
}

fn hb_row(point: f64, lower: f64, upper: f64) -> HbRow {
    HbRow { point: point, lower: lower, upper: upper }
}

// Zilli Vieira et al. 2019, Table 2 ("Estimated daily percent increase in
// mortality (95% CI) associated with one standard deviation of z-score Kp
// index"). Columns Total, CVD, MI, Stroke; rows Winter, Spring, Summer, Fall.
fn paper_table2(season: i32, outcome: i32) -> HbRow {
    if season == 0 && outcome == 0 { return hb_row(0.13, 0.02, 0.24) }
    if season == 0 && outcome == 1 { return hb_row(0.0 - 0.04, 0.0 - 0.22, 0.13) }
    if season == 0 && outcome == 2 { return hb_row(0.21, 0.0 - 0.07, 0.5) }
    if season == 0 && outcome == 3 { return hb_row(0.0 - 0.74, 0.0 - 0.96, 0.0 - 0.51) }
    if season == 1 && outcome == 0 { return hb_row(0.31, 0.21, 0.41) }
    if season == 1 && outcome == 1 { return hb_row(0.21, 0.05, 0.37) }
    if season == 1 && outcome == 2 { return hb_row(0.4, 0.05, 0.72) }
    if season == 1 && outcome == 3 { return hb_row(0.0 - 0.03, 0.0 - 0.4, 0.33) }
    if season == 2 && outcome == 0 { return hb_row(0.27, 0.16, 0.37) }
    if season == 2 && outcome == 1 { return hb_row(0.15, 0.0 - 0.01, 0.33) }
    if season == 2 && outcome == 2 { return hb_row(0.14, 0.0 - 0.2, 0.5) }
    // printed as -0.52 (-0.14, -0.9)
    if season == 2 && outcome == 3 { return hb_row(0.0 - 0.52, 0.0 - 0.9, 0.0 - 0.14) }
    if season == 3 && outcome == 0 { return hb_row(0.31, 0.23, 0.4) }
    if season == 3 && outcome == 1 { return hb_row(0.34, 0.23, 0.44) }
    if season == 3 && outcome == 2 { return hb_row(0.7, 0.43, 0.94) }
    return hb_row(0.06, 0.0 - 0.3, 0.4)
}

// Zilli Vieira et al. 2019, Table 3 (same, adjusted for PM2.5).
fn paper_table3(season: i32, outcome: i32) -> HbRow {
    if season == 0 && outcome == 0 { return hb_row(0.47, 0.3, 0.65) }
    if season == 0 && outcome == 1 { return hb_row(0.54, 0.23, 0.84) }
    if season == 0 && outcome == 2 { return hb_row(1.0, 0.4, 1.62) }
    if season == 0 && outcome == 3 { return hb_row(0.35, 0.0 - 0.27, 0.97) }
    if season == 1 && outcome == 0 { return hb_row(0.0 - 0.03, 0.0 - 0.2, 0.14) }
    if season == 1 && outcome == 1 { return hb_row(0.28, 0.0 - 0.01, 0.57) }
    if season == 1 && outcome == 2 { return hb_row(0.5, 0.0 - 0.2, 1.17) }
    if season == 1 && outcome == 3 { return hb_row(0.0 - 0.13, 0.0 - 0.72, 0.45) }
    if season == 2 && outcome == 0 { return hb_row(0.22, 0.05, 0.4) }
    if season == 2 && outcome == 1 { return hb_row(0.16, 0.0 - 0.03, 0.35) }
    if season == 2 && outcome == 2 { return hb_row(0.0 - 0.25, 0.0 - 0.92, 0.4) }
    if season == 2 && outcome == 3 { return hb_row(0.24, 0.0 - 0.44, 0.92) }
    if season == 3 && outcome == 0 { return hb_row(0.23, 0.09, 0.37) }
    if season == 3 && outcome == 1 { return hb_row(0.46, 0.23, 0.7) }
    if season == 3 && outcome == 2 { return hb_row(0.36, 0.0 - 0.24, 0.96) }
    return hb_row(0.0 - 0.3, 0.0 - 0.81, 0.22)
}

// ============================================================================
// HELPERS
// ============================================================================

fn hb_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn hb_near(a: f64, b: f64, tol: f64) -> bool {
    hb_abs(a - b) < tol
}

fn hb_z975() -> f64 { 1.959963984540054 }

// Deviation of the reconstructed 95 % interval from the published one, or
// 1000 if the value or the standard uncertainty is not the published one.
fn hb_row_deviation(e: Epistemic, r: HbRow) -> f64 with Mut, Div, Panic {
    let v = ep_val(&e)
    let u = ep_std(&e)
    if !hb_near(v, r.point, 1e-12) { return 1000.0 }
    let u_paper = (r.upper - r.lower) / (2.0 * hb_z975())
    if !hb_near(u, u_paper, 1e-12) { return 1000.0 }
    let dlo = hb_abs((v - hb_z975() * u) - r.lower)
    let dhi = hb_abs((v + hb_z975() * u) - r.upper)
    if dlo > dhi { return dlo }
    dhi
}

// ============================================================================
// TEST RUNNER
// ============================================================================

fn run_tests() -> i32 with IO, Mut, Panic, Div {
    // Use early-return to avoid BSS aliasing of a mutable `fail` counter.

    // --- indices: kp_to_storm_level ---
    if kp_to_storm_level(3.0) != KP_QUIET()     { return 1 }
    if kp_to_storm_level(5.5) != KP_G1_MINOR()  { return 1 }
    if kp_to_storm_level(6.5) != KP_G2_MODERATE() { return 1 }
    if kp_to_storm_level(7.5) != KP_G3_STRONG() { return 1 }
    if kp_to_storm_level(8.5) != KP_G4_SEVERE() { return 1 }
    if kp_to_storm_level(9.0) != KP_G5_EXTREME() { return 1 }

    // --- indices: classify_dst ---
    if classify_dst(0.0) != DST_QUIET()          { return 1 }
    if classify_dst(0.0 - 40.0) != DST_WEAK()    { return 1 }
    if classify_dst(0.0 - 75.0) != DST_MODERATE() { return 1 }
    if classify_dst(0.0 - 150.0) != DST_INTENSE() { return 1 }
    if classify_dst(0.0 - 250.0) != DST_MAJOR() { return 1 }
    // Mursula et al. 2022 class boundaries are closed at the stronger end.
    if classify_dst(0.0 - 29.0) != DST_QUIET()   { return 1 }
    if classify_dst(0.0 - 30.0) != DST_WEAK()    { return 1 }
    if classify_dst(0.0 - 50.0) != DST_MODERATE() { return 1 }
    if classify_dst(0.0 - 100.0) != DST_INTENSE() { return 1 }
    if classify_dst(0.0 - 200.0) != DST_MAJOR()  { return 1 }
    // NOAA G scale: G4 is Kp 8 including 9- (8.67), G5 is Kp 9.
    if kp_to_storm_level(5.0) != KP_G1_MINOR()   { return 1 }
    if kp_to_storm_level(8.67) != KP_G4_SEVERE() { return 1 }

    // --- indices: classify_proton_storm ---
    if classify_proton_storm(5.0) != S_SCALE_NONE()  { return 1 }
    if classify_proton_storm(50.0) != S_SCALE_S1()   { return 1 }
    if classify_proton_storm(500.0) != S_SCALE_S2()  { return 1 }
    if classify_proton_storm(5000.0) != S_SCALE_S3() { return 1 }
    // NOAA S scale thresholds are inclusive: 10, 1e2, 1e3, 1e4, 1e5 pfu.
    if classify_proton_storm(10.0) != S_SCALE_S1()     { return 1 }
    if classify_proton_storm(10000.0) != S_SCALE_S4()  { return 1 }
    if classify_proton_storm(100000.0) != S_SCALE_S5() { return 1 }

    // --- indices: IMF magnitude ---
    let imf = IMFVector { bx: 3.0, by: 4.0, bz: 0.0 }
    if !hb_near(imf_magnitude(imf), 5.0, 0.01) { return 1 }

    // --- indices: geoeffective Bz ---
    let southward = IMFVector { bx: 0.0, by: 0.0, bz: 0.0 - 10.0 }
    if !hb_near(imf_geoeffective_bz(southward), 10.0, 0.01) { return 1 }
    let northward = IMFVector { bx: 0.0, by: 0.0, bz: 5.0 }
    if !hb_near(imf_geoeffective_bz(northward), 0.0, 0.01) { return 1 }

    // --- solar: flare classification ---
    let x_flare = flare_new(FLARE_X(), 5.2)
    let flux = flare_peak_flux(x_flare)
    if !hb_near(flux, 5.2e-4, 1e-6) { return 1 }

    let m_flare = flare_new(FLARE_M(), 1.0)
    let m_flux = flare_peak_flux(m_flare)
    if !hb_near(m_flux, 1.0e-5, 1e-8) { return 1 }

    // --- solar: radio blackout scale ---
    let big_x = flare_new(FLARE_X(), 25.0)
    if flare_radio_scale(big_x) != R5_EXTREME() { return 1 }

    let mid_x = flare_new(FLARE_X(), 12.0)
    if flare_radio_scale(mid_x) != R4_SEVERE() { return 1 }

    let small_x = flare_new(FLARE_X(), 2.0)
    if flare_radio_scale(small_x) != R3_STRONG() { return 1 }

    let c_flare = flare_new(FLARE_C(), 3.0)
    if flare_radio_scale(c_flare) != R_NONE() { return 1 }

    let c1 = flare_new(FLARE_C(), 1.0)
    if !hb_near(flare_peak_flux(c1), 1.0e-6, 1e-15) { return 1 }
    let b1 = flare_new(FLARE_B(), 1.0)
    if !hb_near(flare_peak_flux(b1), 1.0e-7, 1e-16) { return 1 }
    let a1 = flare_new(FLARE_A(), 1.0)
    if !hb_near(flare_peak_flux(a1), 1.0e-8, 1e-17) { return 1 }
    // R scale: R1 = M1, R2 = M5
    if flare_radio_scale(flare_new(FLARE_M(), 1.0)) != R1_MINOR()    { return 1 }
    if flare_radio_scale(flare_new(FLARE_M(), 5.0)) != R2_MODERATE() { return 1 }
    if flare_radio_scale(flare_new(FLARE_X(), 1.0)) != R3_STRONG()   { return 1 }

    // --- solar: ballistic CME transit, 1 au = 149597870.7 km (IAU 2012) ---
    let halo_cme = CME { speed: 1500.0, width_deg: 360.0, position_angle: 270.0, acceleration: 0.0 - 5.0 }
    let transit_b = cme_transit_ballistic_hours(halo_cme)
    // 149597870.7 / 1500 / 3600 = 27.703309388...
    if !hb_near(transit_b, 27.70330938888889, 1e-9) { return 1 }

    // --- units: exact definitional conversion factors ---
    if !hb_near(gauss_to_tesla(1.0), 1.0e-4, 1e-18) { return 1 }
    if !hb_near(tesla_to_gauss(1.0e-4), 1.0, 1e-12) { return 1 }
    if !hb_near(gamma_to_nT(7.0), 7.0, 1e-15) { return 1 }
    if !hb_near(sfu_to_si(150.0), 1.5e-20, 1e-32) { return 1 }

    // --- effects: Zilli Vieira et al. 2019, Tables 2 and 3 (32 rows) ---
    var max_dev = 0.0
    var si = 0
    while si < 4 {
        var oi = 0
        while oi < 4 {
            let d2 = hb_row_deviation(gmd_mortality_pct_per_sd_kp(si, oi, false), paper_table2(si, oi))
            if d2 > max_dev { max_dev = d2 }
            let d3 = hb_row_deviation(gmd_mortality_pct_per_sd_kp(si, oi, true), paper_table3(si, oi))
            if d3 > max_dev { max_dev = d3 }
            // Rate ratio = 1 + percent / 100, with u scaled by 1/100.
            let rr = gmd_mortality_rr_per_sd_kp(si, oi, true)
            let p3 = paper_table3(si, oi)
            if !hb_near(ep_val(&rr), 1.0 + p3.point / 100.0, 1e-12) { return 1 }
            if !hb_near(ep_std(&rr), (p3.upper - p3.lower) / (2.0 * hb_z975()) / 100.0, 1e-14) { return 1 }
            oi = oi + 1
        }
        si = si + 1
    }
    // The named selectors address the same rows.
    let mi_fall = gmd_mortality_pct_per_sd_kp(SEASON_FALL(), OUTCOME_MI(), false)
    if !hb_near(ep_val(&mi_fall), 0.7, 1e-12) { return 1 }
    let mi_winter_pm = gmd_mortality_pct_per_sd_kp(SEASON_WINTER(), OUTCOME_MI(), true)
    if !hb_near(ep_val(&mi_winter_pm), 1.0, 1e-12) { return 1 }
    let stroke_summer = gmd_mortality_pct_per_sd_kp(SEASON_SUMMER(), OUTCOME_STROKE(), false)
    if !hb_near(ep_val(&stroke_summer), 0.0 - 0.52, 1e-12) { return 1 }
    let cvd_spring = gmd_mortality_pct_per_sd_kp(SEASON_SPRING(), OUTCOME_CVD(), false)
    if !hb_near(ep_val(&cvd_spring), 0.21, 1e-12) { return 1 }

    // --- effects: Zilli Vieira et al. 2022 (HRV, intense GMD) ---
    let dsdnn = hb_row_deviation(hrv_intense_gmd_sdnn_change_ms(), hb_row(0.0 - 8.2, 0.0 - 13.9, 0.0 - 2.5))
    if dsdnn > max_dev { max_dev = dsdnn }
    let drmssd = hb_row_deviation(hrv_intense_gmd_rmssd_change_ms(), hb_row(0.0 - 14.7, 0.0 - 23.1, 0.0 - 6.3))
    if drmssd > max_dev { max_dev = drmssd }

    print("max |reconstructed 95% bound - published bound| = ")
    println(max_dev)
    if max_dev > 0.016 { return 1 }

    return 0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let result = run_tests()
    if result == 0 {
        print("HELIOBIOLOGY_OK\n")
    }
    return result
}
