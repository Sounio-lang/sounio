//@ run-pass
use core::result::{Result}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_len,byte_buffer_push,byte_buffer_close}
use text::utf8_bytes::{Utf8Bytes,utf8_bytes_len,utf8_bytes_get,utf8_bytes_slice}
use text::{utf8_text_from_string,utf8_text_as_bytes,utf8_text_byte_len,utf8_text_close}
fn probe_dump_bytes(view:&Utf8Bytes)->i64 with IO,Alloc,Mut,Panic,Div {
 let count=utf8_bytes_len(view)
 if utf8_bytes_get(view,0-1).status!=4 || utf8_bytes_get(view,count).status!=4 {return 4}
 var i:i64=0
 while i<count {
  let byte=utf8_bytes_get(view,i)
  if byte.status!=0 {return byte.status}
  print("RUNTIME_PROBE_BYTE ");print_int(i);print(" ");print_int(byte.value);print("\n")
  i=i+1
 }
 0
}
fn main()->i32 with IO,Alloc,Mut,Panic,Div {
 if arg_count()!=0 {return 64}
 print("RUNTIME_PROBE_LITERAL_START\n")
 let text=utf8_text_from_string("literal_probe",128)
 var failure:i64=0
 match utf8_text_as_bytes(&text) {
  Result::Ok(bytes)=>{
   assert(utf8_bytes_len(&bytes)==utf8_text_byte_len(&text))
   print("RUNTIME_PROBE_LITERAL_LEN ");print_int(utf8_bytes_len(&bytes));print("\n")
   if probe_dump_bytes(&bytes)!=0 {failure=1}
  },
  Result::Err(code)=>{print("RUNTIME_PROBE_ERROR ");print_int(code);print("\n");failure=1},
 }
 utf8_text_close(text)
 if failure==0 {print("RUNTIME_PROBE_LITERAL_AFTER\n")}
 failure as i32
}
