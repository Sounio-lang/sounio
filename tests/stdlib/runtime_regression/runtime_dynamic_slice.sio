fn main() -> i32 with IO, Panic {
    print("RUNTIME_PROBE_SLICE_START\n")
    let raw = read_file("tests/fixtures/fmri/tiny_real_motion.tsv")
    let bytes = raw.as_bytes()
    let n = bytes.len() as i64
    let cap = if n > 8 { 8 } else { n }
    let head = &bytes[..cap as usize]
    print("RUNTIME_PROBE_SLICE_LEN ")
    print(head.len() as i64)
    print("\n")
    print("RUNTIME_PROBE_SLICE_AFTER\n")
    0
}
