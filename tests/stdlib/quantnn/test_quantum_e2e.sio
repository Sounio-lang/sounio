//@ run-pass
//@ expect-stdout: HYPER_QUANTNN_OK

use quantnn::mod::*

fn emit_metric(name: string, value: f64) with IO {
    print("HYPER_METRIC quantnn ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO {
    print("HYPER_QUANTNN_START\n")

    let q = quant_state_hadamard_zero()
    let norm_sq = quant_state_norm_sq(q)
    let prob_one = quant_state_prob_one(q)

    let norm_ok = norm_sq > 0.999999 && norm_sq < 1.000001
    let prob_ok = prob_one > 0.499999 && prob_one < 0.500001

    emit_metric("norm_sq", norm_sq)
    emit_metric("prob_one", prob_one)
    emit_metric("state_contract_ok", bool_to_f64(norm_ok && prob_ok))

    if !norm_ok { return 2 }
    if !prob_ok { return 3 }

    print("HYPER_QUANTNN_OK\n")
    0
}
