//@ run-pass
//@ expect-stdout: ARENA_ALIGNMENT_OK
use mem::arena::*
fn main()->i32 with IO,Alloc,Mut,Panic,Div {
    var arena=arena_with_chunk_size(4096)
    var align:usize=1
    while align<=256 {
        let ptr=arena_alloc_raw(&!arena,3,align)
        if (ptr as i64)==0 {return 1}
        if ((ptr as usize)&(align-1))!=0 {return 2}
        align=align*2
    }
    let allocated=arena_allocated_bytes(&arena)
    let available=arena_available(&arena)
    if (arena_alloc_raw(&!arena,1,0) as i64)!=0 {return 3}
    if (arena_alloc_raw(&!arena,1,3) as i64)!=0 {return 4}
    if (arena_alloc_raw(&!arena,4097,1) as i64)!=0 {return 5}
    if arena_allocated_bytes(&arena)!=allocated {return 6}
    if arena_available(&arena)!=available {return 7}
    arena_drop(&!arena)
    if (arena_alloc_raw(&!arena,1,1) as i64)!=0 {return 8}
    arena_drop(&!arena)
    println("ARENA_ALIGNMENT_OK")
    0
}
