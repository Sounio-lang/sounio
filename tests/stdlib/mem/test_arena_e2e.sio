//@ check-only
// E2E test for stdlib/mem/arena
use mem::arena::*;

fn test_and_drop(a: &! Arena) -> i32  with IO, Mut, Panic, Div, Alloc{
    // Test 1: chunk size default
    let cs = arena_chunk_size(a)
    if cs != 65536 { return 1 }

    // Test 2: allocated_bytes is 0
    let ab = arena_allocated_bytes(a)
    if ab != 0 { return 2 }

    // Test 3: alloc_bytes
    let ptr = arena_alloc_bytes(a, 128)
    let ab2 = arena_allocated_bytes(a)
    if ab2 != 128 { return 3 }

    // Test 4: reset clears allocations
    arena_reset(a)
    let ab3 = arena_allocated_bytes(a)
    if ab3 != 0 { return 4 }

    // Test 5: cleanup
    arena_drop(a)

    return 0
}

fn main() -> i32 {
    var a = arena_new()
    return test_and_drop(&! a)
}
