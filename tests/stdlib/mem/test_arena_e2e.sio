//@ run-pass
//@ requires: madaros
// SIO-60: lean_single newly refuses E001 call-argument mismatch in stdlib/mem/arena.sio:108; Madaros runs this.
//@ requires: madaros
// SIO-60: lean_single newly refuses E001 call-argument mismatch in stdlib/mem/arena.sio:108; Madaros runs this.
//@ expect-stdout: MEM_ARENA_OK
use mem::arena::*;

fn main() -> i32 with IO, Mut, Alloc {
    var a = arena_new()
    if arena_allocated_bytes(&a) != 0 { return 1 }
    arena_drop(&!a)
    println("MEM_ARENA_OK")
    0
}
