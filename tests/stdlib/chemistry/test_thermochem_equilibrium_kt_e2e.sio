//@ check-only
//@ expect-stdout: SCIENCE_CHEMISTRY_OK
// Coupled K(T) lane: thermochem ΔG(T) → equilibrium::k_from_delta_g cross-check.

use chemistry::thermochem
use chemistry::equilibrium
use chemistry::stoichiometry

fn kt_emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC chemistry ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn kt_bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let _stoi = stoichiometry::moles_from_mass(18.0, 18.0)
    var ok: i32 = 0

    if thermochem::test_kt_coupling_const_hs_witness() { ok = ok + 1 }
    if thermochem::test_kt_coupling_kirchhoff_band() { ok = ok + 1 }

    let (dh, udh) = thermochem::water_formation_enthalpy()
    let (ds, uds) = thermochem::water_formation_entropy()
    let (dcp, udcp) = thermochem::water_formation_dcp()
    let t1 = 298.15
    let t2 = 350.0

    let (dg298, udg298) = thermochem::delta_g_from_h_s(dh, udh, ds, uds, t1, 0.5)
    let (dg350k, udg350) = thermochem::delta_g_at_t_kirchhoff(dh, udh, ds, uds, dcp, udcp, t1, t2, 0.5)

    let (k298_th, _) = thermochem::thermo_k_from_delta_g(dg298, udg298, t1, 0.5)
    let (k298_eq, _) = equilibrium::k_from_delta_g(dg298, udg298, t1, 0.5)
    let (k350k_eq, _) = equilibrium::k_from_delta_g(dg350k, udg350, t2, 0.5)

    let ln_k298 = thermochem::ln_k_from_delta_g(dg298, t1)
    let k_ratio = if k298_eq > 0.0 { k350k_eq / k298_eq } else { 0.0 }

    let cross_ok = thermochem::test_kt_coupling_const_hs_witness()
        && k298_th > 0.0
        && k298_eq > 0.0
        && k350k_eq > 0.0
        && k350k_eq < k298_eq
        && k_ratio < 1.0

    kt_emit_metric("ln_k_water_298", ln_k298)
    kt_emit_metric("k_ratio_350_298", k_ratio)
    kt_emit_metric("kt_coupling_ok", kt_bool_to_f64(cross_ok))
    kt_emit_metric("kt_cross_module_ok", kt_bool_to_f64(k298_th > 0.0 && k298_eq > 0.0))
    kt_emit_metric("tests_passed", ok as f64)

    if ok < 2 || !cross_ok {
        return 1
    }

    print("SCIENCE_CHEMISTRY_OK\n")
    return 0
}