//@ run-pass
// tests/stdlib/chemistry/test_kinetics_epistemic_ensemble.sio
//
// Epistemic general CRN + structural/fractional ensembles that RESPECT the
// user-supplied stoichiometry (regression coverage for the nu-ignoring bug).
// Expectations cross-checked against an independent Python delta-method replica.
// lean_single engine.
use chemistry::kinetics::*
fn main() -> i32 with IO, Mut, Div, Panic, Prob, Observe {
    if !test_sounio_epistemic_general() { print("FAIL epistemic_general\n"); return 1 }
    if !test_structural_ensemble() { print("FAIL structural_ensemble\n"); return 2 }
    if !test_fractional_ensemble() { print("FAIL fractional_ensemble\n"); return 3 }
    if !test_bench_frac_ensemble() { print("FAIL bench_frac_ensemble\n"); return 4 }
    if !test_sensitivity() { print("FAIL sensitivity\n"); return 5 }
    print("EPISTEMIC ENSEMBLE PASS\n")
    0
}
