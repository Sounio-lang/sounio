//@ run-pass
//@ timeout: 300
// tests/stdlib/chemistry/test_gri30_h2_adiabatic.sio
//
// Adiabatic (constant-U,V) extension of the GRI-Mech 3.0 H/O sub-mechanism:
// NASA-7 cp/h, the coupled energy equation dT/dt = -T*sum(h_rt-1)*omega /
// sum c*(cp_r-1) with Kc recomputed every RHS from one shared g_rt pass, and
// a 1000-step pre-front RK4 checkpoint (the ignition front itself is
// exponentially phase-sensitive and not cross-language parity-testable).
// All expectations cross-checked against the independent Python replica and
// Cantera 3.2.0 (constant-V IdealGasReactor). lean_single/native engine (the
// CI suite runs the native stage2 compiler): on madaros the 1000-step loop
// miscompiles (deterministic wrong values even at 100 steps; the isothermal
// test_gri30_h2.sio hits the same engine class of bug as rc=182).
use chemistry::gri30_h2::*
fn main() -> i32 with IO, Mut, Div, Panic {
    if !test_g30_uv_thermo() { print("FAIL g30_uv_thermo\n"); return 1 }
    if !test_g30_uv_rhs() { print("FAIL g30_uv_rhs\n"); return 2 }
    if !test_g30_uv_short() { print("FAIL g30_uv_short\n"); return 3 }
    print("GRI30 H2 ADIABATIC PASS\n")
    0
}
