//@ run-pass
//@ timeout: 240
// Cantera 3.2.0 / gri30.yaml reference: filtered 10-species/29-reaction
// mechanism, IdealGasReactor with energy="on" and constant volume, T=1500 K,
// 2% H2 / 1% O2 / 97% N2 at 1 atm, [H]=1e-11 mol/cm3, rtol=1e-12,
// atol=1e-22, advanced to t=1e-4 s.
use chemistry::gri30_h2::*

fn absf(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn rel(a: f64, b: f64, tol: f64) -> bool { absf(a - b) < tol * absf(b) }

fn main() -> i32 with Mut, Div, Panic {
    let t = 1500.0;
    // The exact Cantera pressure conversion. As of this commit the isothermal
    // path uses it too -- the 82.057 shorthand it used to retain ran 4.461e-06
    // high, which the 1e-4 gates could not see.
    let m = 101325.0 / (8.31446261815324 * t) * 1.0e-6;
    var c0: [f64; 10] = [0.0; 10];
    c0[0] = m * 0.02;
    c0[1] = 1.0e-11;
    c0[3] = m * 0.01;
    c0[8] = m * 0.97;
    let (y, tout) = simulate_gri30_h2_adiabatic(&c0, t, 1.0e-8, 10000 as i64);
    let (yhalf, thalf) = simulate_gri30_h2_adiabatic(&c0, t, 5.0e-9, 20000 as i64);
    if !rel(tout, 1501.545290113, 2.0e-6) { return 1 }
    if !rel(y[0], 1.45128206604e-7, 2.0e-4) { return 2 }
    if !rel(y[1], 9.82282916698e-9, 2.0e-4) { return 3 }
    if !rel(y[2], 1.45919114310e-9, 2.0e-4) { return 4 }
    if !rel(y[3], 7.39668214022e-8, 2.0e-4) { return 5 }
    if !rel(y[4], 1.23219544099e-9, 2.0e-4) { return 6 }
    if !rel(y[5], 1.18283614793e-8, 2.0e-4) { return 7 }
    if !rel(y[6], 1.70182996855e-11, 2.0e-4) { return 8 }
    if !rel(y[7], 1.62098405597e-13, 2.0e-2) { return 9 }
    if !rel(thalf, tout, 1.0e-6) { return 10 }
    var i: i64 = 0;
    while i < 8 {
        if !rel(yhalf[i], y[i], 2.0e-5) { return 11 }
        i = i + 1;
    }
    0
}
