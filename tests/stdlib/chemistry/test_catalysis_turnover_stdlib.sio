// tests/stdlib/chemistry/test_catalysis_turnover_stdlib.sio
//
// Turnover-bookkeeping driver for stdlib/chemistry/catalysis.sio, split out
// of test_catalysis_stdlib.sio for a measured reason, not a stylistic one:
// Madaros's generated runtime bump-allocates a 2 GiB arena that never
// reclaims, and simulate_mechanistic_crn costs ~2.7 MiB per RK4 step (a
// 32 KiB MatNM copied ~20x per derivative evaluation, 4 evaluations per
// step). Ten tests in one binary exhaust it; eight plus these two do not fit
// together. See test_catalysis_stdlib.sio's header for the full measurement.
//
// test_turnover_bookkeeping is the specific test the lean_single engine could
// not link at all -- it is the `&![f64;16]` caller that catalysis.sio's own
// header records as a standing limitation. On Madaros v0.80.0 it links, runs,
// and passes. That limitation is an engine property, not a language one.

use chemistry::catalysis::*

fn main() -> i32 with IO, Mut, Div, Panic {
    var fail: i32 = 0
    if !test_turnover_bookkeeping() { fail = fail + 1; println("FAIL turnover_bookkeeping") }
    if !test_turnover_carbonic_anhydrase() { fail = fail + 1; println("FAIL turnover_carbonic_anhydrase") }
    if fail == 0 {
        println("CATALYSIS_TURNOVER_OK")
        return 0
    }
    print("CATALYSIS_TURNOVER: ") print(fail) println(" failures")
    fail
}
