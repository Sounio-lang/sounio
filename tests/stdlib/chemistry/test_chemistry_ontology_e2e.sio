//@ check-only
//@ expect-stdout: SCIENCE_CHEMISTRY_OK
// P2: chemistry ontology export lane (import-free ChEBI/GO anchors).

use chemistry::ontology

fn ont_emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC chemistry ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn ont_bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Mut {
    var ok: i32 = 0

    if test_chebi_water_nominal() { ok = ok + 1 }
    if test_chebi_crn_species_mapping() { ok = ok + 1 }
    if test_all_compounds_chebi() { ok = ok + 1 }
    if test_go_redox_process() { ok = ok + 1 }
    if test_attach_chebi_crn() { ok = ok + 1 }

    let iris = attach_chebi_crn_ids(0)
    let cross_ok = iris[0] == hydrogen_atom_iri() && iris[1] == dioxygen_iri()

    ont_emit_metric("chebi_water_id", water_iri() as f64)
    ont_emit_metric("go_redox_id", reaction_oxidation_reduction_iri() as f64)
    ont_emit_metric("water_conc_mol_L", knowledge_water_conc_value(0.18))
    ont_emit_metric("ontology_cross_module_ok", ont_bool_to_f64(cross_ok))
    ont_emit_metric("tests_passed", ok as f64)

    if ok < 5 || !cross_ok {
        return 1
    }

    print("SCIENCE_CHEMISTRY_OK\n")
    return 0
}