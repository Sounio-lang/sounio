//@ run-pass
//@ timeout: 120
// tests/stdlib/chemistry/test_gri30_h2.sio
//
// Complete GRI-Mech 3.0 H/O sub-mechanism (10 species, 28 reactions): modified-
// Arrhenius rates, three-body efficiencies, Troe falloff, NASA-7 thermochemistry
// with reverse rates from detailed balance (k_rev = k_fwd / Kc), plus native
// first-order GUM uncertainty propagation on the rate constants. All expectations
// cross-checked against an independent Python replication of the same mechanism
// (pre-ignition-front checkpoint only: the ignition front itself is exponentially
// phase-sensitive and not cross-language parity-testable). lean_single engine.
use chemistry::gri30_h2::*
fn main() -> i32 with IO, Mut, Div, Panic {
    if !test_g30_rates() { print("FAIL g30_rates\n"); return 1 }
    if !test_g30_thermo() { print("FAIL g30_thermo\n"); return 2 }
    if !test_g30_sim() { print("FAIL g30_sim\n"); return 3 }
    if !test_g30_epistemic() { print("FAIL g30_epistemic\n"); return 4 }
    print("GRI30 H2 PASS\n")
    0
}
