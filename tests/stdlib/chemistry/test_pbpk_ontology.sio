//@ check-only
//@ requires: madaros
// SIO-60: lean_single newly refuses return-type/E218 diagnostics in stdlib/chemistry/equilibrium.sio:61,66; Madaros runs this.
// tests/stdlib/chemistry/test_pbpk_ontology.sio
//
// PBPK bridge, ontology, and literature-validation harness.

use chemistry::kinetics::*

fn assert_all() -> i32 with IO, Mut, Div, Panic, Prob, Observe {
    var fail: i32 = 0
    if !test_pbpk_bridge() { fail = fail + 1; println("FAIL pbpk_bridge") }
    if !test_pbpk_metabolic_crn_ontology() { fail = fail + 1; println("FAIL pbpk_metabolic_crn_ontology") }
    if !test_chemistry_chebi_ontology() { fail = fail + 1; println("FAIL chemistry_chebi_ontology") }
    if !test_lit_validation() { fail = fail + 1; println("FAIL lit_validation") }
    fail
}

fn main() -> i32 with IO, Mut, Div, Panic, Prob, Observe {
    assert_all()
}