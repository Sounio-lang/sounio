//@ run-pass
//@ exit-code: 1
//@ timeout: 60
// tests/stdlib/chemistry/test_pbpk_clearance_incomplete_panics.sio
//
// simulate_pbpk_clearance_full used to discard the solver's completion status. A fixed-step
// solve whose first step is non-finite (an infinite rate) records nothing past the initial
// state, so the wrapper returned the INITIAL state as if it were the final one. It must
// fail instead. This program runs one valid call (which must succeed), then the invalid one,
// which must panic: exit code 1, and the line after it must never print.

use chemistry::kinetics::*

fn inf_val() -> f64 { let big = 1.0e308; big * 10.0 }

fn main() -> i32 with IO, Mut, Div, Panic {
    let init: [f64; 4] = [1.0, 0.0, 0.0, 0.0]
    let no_var: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    let ok_k: [f64; 3] = [0.05, 0.02, 0.01]
    let no_u: [f64; 3] = [0.0, 0.0, 0.0]
    let (v, _u) = simulate_pbpk_clearance_full(&init, &no_var, &ok_k, &no_u, 0.33, 72)
    if v[1] > 0.4 { println("VALID CALL OK") } else { println("VALID CALL WRONG") }

    let bad_k: [f64; 3] = [inf_val(), 0.02, 0.01]
    println("CALLING INVALID")
    let (w, _x) = simulate_pbpk_clearance_full(&init, &no_var, &bad_k, &no_u, 0.33, 72)
    println("UNREACHABLE: the invalid solve returned instead of failing")
    println(w[0])
    0
}
