//@ check-only
//@ expect-stdout: SCIENCE_CHEMISTRY_OK
// Science pipeline lane: chemistry foundations (acids + equilibrium).
// CHECK-ONLY in E2E harness until Madaros run stops SIGSEGV on imported modules.
// Foundations gate still attempts full run under soft mode.

use chemistry::acids
use chemistry::equilibrium

fn emit_metric(name: string, value: f64) with IO {
    print("SCIENCE_METRIC chemistry ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var ok: i32 = 0

    if acids::test_ph() { ok = ok + 1 }
    if acids::test_hh() { ok = ok + 1 }
    if acids::test_titration() { ok = ok + 1 }
    if acids::test_calib() { ok = ok + 1 }
    if acids::test_mm() { ok = ok + 1 }
    if equilibrium::test_k_dg() { ok = ok + 1 }
    if equilibrium::test_nernst() { ok = ok + 1 }
    if equilibrium::test_ab_c() { ok = ok + 1 }

    let (ph_val, _) = acids::ph(1.0e-3, 1e-5)
    emit_metric("ph_milli", ph_val)

    let (hh_val, _) = acids::henderson_hasselbalch(4.76, 0.01, 1.0, 0.05)
    emit_metric("hh_acetate", hh_val)

    let tit_ph = acids::titration_ph(0.1, 0.1, 0.05, 0.1)
    emit_metric("titration_ph", tit_ph)

    var xs: [f64; 5] = [0.0, 1.0, 2.0, 3.0, 4.0]
    var ys: [f64; 5] = [0.1, 1.1, 2.0, 3.1, 4.0]
    let (cal_slope, _, _, _) = acids::calibrate(&xs, &ys, 0.0, 0.1)
    emit_metric("calib_slope", cal_slope)

    let (mm_r, _) = acids::mm_rate(10.0, 0.1, 1.0, 0.05, 1.0, 0.05)
    emit_metric("mm_rate", mm_r)

    let (k_val, _) = equilibrium::k_from_delta_g(0.0 - 5000.0, 100.0, 298.0, 1.0)
    emit_metric("k_from_dg_neg5k", k_val)

    let (nernst_e, _) = equilibrium::nernst(1.0, 0.01, 1, 1.0, 0.1, 298.0, 1.0)
    emit_metric("nernst_E_V", nernst_e)

    let (x_ab, _) = equilibrium::solve_ab_c_equil(1.0, 0.01, 1.0, 0.01, 10.0, 0.1)
    emit_metric("ab_c_extent", x_ab)

    emit_metric("acids_ok", bool_to_f64(acids::test_ph() && acids::test_hh() && acids::test_titration() && acids::test_calib() && acids::test_mm()))
    emit_metric("equilibrium_ok", bool_to_f64(equilibrium::test_k_dg() && equilibrium::test_nernst() && equilibrium::test_ab_c()))
    emit_metric("tests_passed", ok as f64)

    if ok < 8 {
        return 1
    }

    print("SCIENCE_CHEMISTRY_OK\n")
    return 0
}