use chemistry::gri30_h2::*

fn main() -> i32 with IO, Mut, Div, Panic {
    if test_g30_uv_rhs() { println("PASS uv_rhs") } else { println("FAIL uv_rhs") }
    if test_g30_uv_short() { println("PASS uv_short (1000-step tuple-array RK4)") } else { println("FAIL uv_short") }
    0
}
