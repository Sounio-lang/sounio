//@ check-only
// tests/stdlib/chemistry/test_kinetics_core.sio
//
// Core kinetics harness via qualified chemistry module paths.
//
// WHY THIS IS STILL check-only, measured 2026-09-09 rather than assumed.
// The sibling driver test_catalysis_stdlib.sio used to cite a native
// "thin-link" limitation as its reason and no longer does: that limitation is
// a property of the lean_single engine, and on Madaros v0.80.0 catalysis.sio
// links and runs as a single binary. This file is blocked by something else,
// and the distinction is recorded in
// docs/audit/CHEMISTRY_MADAROS_ENGINE_MEASUREMENT_2026-09-09.md.
//
// kinetics.sio type-checks clean under lean_single (0 errors) and fails under
// Madaros with 43 errors, all in chemistry/ontology.sio and its callers:
// 32 x E004 "expected &str, found &string" and 11 x E009 argument/function-
// pointer type mismatches. The E004 sites are a workaround written FOR
// lean_single's checker (bind a literal to a `string` local, compare its
// reference against a `&str` parameter) which Madaros rejects. The two engines
// disagree on whether `&str` and `&string` are the same type; satisfying both
// from one source is not obviously possible, so this is an engine-level
// incompatibility, not a patchable typo.
//
// Consequence: the tests below are type-checked and NOT executed. That is not
// free. test_enzyme_crn in this file asserted a value wrong by a factor of 4.5
// and survived merge for exactly this reason -- see its own comment for the
// derivation and the four independent confirmations of the correct value.

use chemistry::kinetics::*

fn assert_all() -> i32 with IO, Mut, Div, Panic {
    var fail: i32 = 0
    if !test_arrhenius() { fail = fail + 1; println("FAIL arrhenius") }
    if !test_real_arrhenius() { fail = fail + 1; println("FAIL real_arrhenius") }
    if !test_ode_first_order() { fail = fail + 1; println("FAIL ode_first_order") }
    if !test_crn() { fail = fail + 1; println("FAIL crn") }
    if !test_crn_epistemic() { fail = fail + 1; println("FAIL crn_epistemic") }
    if !test_chem_full() { fail = fail + 1; println("FAIL chem_full") }
    if !test_transport_rd() { fail = fail + 1; println("FAIL transport_rd") }
    if !test_general_crn() { fail = fail + 1; println("FAIL general_crn") }
    if !test_stoich_linalg() { fail = fail + 1; println("FAIL stoich_linalg") }
    if !test_stoich_matrix() { fail = fail + 1; println("FAIL stoich_matrix") }
    fail
}

fn main() -> i32 with IO, Mut, Div, Panic {
    assert_all()
}