//@ check-only
// tests/stdlib/chemistry/test_kinetics_core.sio
//
// Core kinetics harness via qualified chemistry module paths.
//
// WHY THIS IS STILL check-only, measured 2026-09-09 rather than assumed.
// The sibling driver test_catalysis_stdlib.sio used to cite a native
// "thin-link" limitation as its reason and no longer does: that limitation is
// a property of the lean_single engine, and on Madaros v0.80.0 catalysis.sio
// links and runs as a single binary. This file is blocked by something else,
// and the distinction is recorded in
// docs/audit/CHEMISTRY_MADAROS_ENGINE_MEASUREMENT_2026-09-09.md.
//
// kinetics.sio used to fail Madaros type-checking with 61 errors. All 61 are
// now fixed, and three of them were real defects lean_single let through:
//
//   61 -> 43  a stdlib visibility defect (constants/physical.sio declared 23
//             functions and zero `pub`, while six chemistry/ and physics/
//             modules imported it)
//   43 ->  5  a `&str`/`&string` workaround written FOR lean_single's checker,
//             which is precisely what Madaros rejected -- deleted, not made
//             conditional, since `mechanism: string` compared against bare
//             literals is accepted by both engines
//    5 ->  4  an OUT-OF-BOUNDS READ: simulate_big_crn returns [f64; 6] and was
//             passed to a &[f64; 8] parameter that copies all eight
//    4 ->  0  an effect-system violation: stdlib/ode/rk4.sio declared its
//             callback `with Mut` while every rhs passed to it is
//             `with Mut, Div, Panic`. Madaros is right to reject that; the
//             effect row is now honest
//
// So this file now TYPE-CHECKS on both engines. It stays `//@ check-only` for
// a different and better-characterised reason: `bin/souc run` on it reaches
// codegen and stops at `multimodule native thin-link compilation failed` --
// a Madaros codegen scale limit on large import graphs (the issue #901
// family), not a type or effect error, and not something this file can route
// around. demos/hydrogen/uhs_brine_calcite.sio and site_screening.sio are in
// exactly the same state and for the same reason.
//
// The cost of a test that is checked and never run is not hypothetical.
// test_enzyme_crn in this file asserted a value wrong by a factor of 4.5 and
// survived merge for exactly this reason -- see its own comment for the
// derivation and the four independent confirmations of the correct value.

use chemistry::kinetics::*

fn assert_all() -> i32 with IO, Mut, Div, Panic {
    var fail: i32 = 0
    if !test_arrhenius() { fail = fail + 1; println("FAIL arrhenius") }
    if !test_real_arrhenius() { fail = fail + 1; println("FAIL real_arrhenius") }
    if !test_ode_first_order() { fail = fail + 1; println("FAIL ode_first_order") }
    if !test_crn() { fail = fail + 1; println("FAIL crn") }
    if !test_crn_epistemic() { fail = fail + 1; println("FAIL crn_epistemic") }
    if !test_chem_full() { fail = fail + 1; println("FAIL chem_full") }
    if !test_transport_rd() { fail = fail + 1; println("FAIL transport_rd") }
    if !test_general_crn() { fail = fail + 1; println("FAIL general_crn") }
    if !test_stoich_linalg() { fail = fail + 1; println("FAIL stoich_linalg") }
    if !test_stoich_matrix() { fail = fail + 1; println("FAIL stoich_matrix") }
    fail
}

fn main() -> i32 with IO, Mut, Div, Panic {
    assert_all()
}