// tests/stdlib/chemistry/test_catalysis_stdlib.sio
//
// Rate-law and invariant driver for stdlib/chemistry/catalysis.sio.
//
// THIS FILE USED TO BE `//@ check-only`. It is not any more, and the reason
// is worth stating precisely, because the old header's explanation was
// measured against the wrong compiler.
//
// The old header said importing the chemistry module graph "through bin/souc
// run currently fails at the native thin-link stage", and that a function
// taking a `&![T;N]` mutable-array-reference parameter (simulate_catalytic_
// cycle) "breaks the native thin-link stage when called from anything other
// than main()". Both statements were true of the lean_single engine, which is
// what `bin/souc` resolved to at the time that header was written.
//
// Measured 2026-09-09 against Madaros v0.80.0 (bin/madaros-linux-x86_64,
// md5 92f2c566, the committed gate-receipted ELF, receipt
// artifacts/self-hosted/madaros.gate-receipt, source_commit 67caef4b74):
// the thin-link limitation DOES NOT EXIST on this engine. catalysis.sio
// compiles to a single 131 KB native ELF, and every one of the ten tests --
// test_turnover_bookkeeping, the `&![f64;16]` caller, included -- runs and
// passes. Nothing in catalysis.sio was changed to achieve this.
//
// What DOES bound this file is a different, measured limit, and it is why the
// suite is split across two drivers rather than one. Madaros's generated
// runtime is a bump allocator over a 2 GiB arena that never reclaims
// (self-hosted/native/codegen_x86_linux.sio:4177, "Its arena never refills").
// MatNM carries `data: [f64; 4096]` -- 32 KiB per value -- and
// catalysis.sio's mechanistic_dc allocates about twenty of them per call
// (matnm_new + 16 matnm_set + matnm_mul + the by-value `nu`), four calls per
// RK4 step. Measured cost: ~2.7 MiB per RK4 step, so ~800 steps of
// simulate_mechanistic_crn per process. Bisected: 750 steps run, 850 exhaust
// the arena; the eight tests below fit, and adding the two turnover tests
// does not. Those two live in test_catalysis_turnover_stdlib.sio.
//
// That budget is a real property of this stack and is recorded rather than
// hidden. It is a stdlib-efficiency finding as much as a compiler one: a
// 32 KiB fixed-capacity matrix copied twenty times per derivative evaluation
// is the cost driver, not the integrator.
//
// Independent, executed, non-Sounio cross-checks live in
// stdlib/chemistry/oracles/ (C++23, Koka) and formal/lean4/ -- see
// catalysis.sio's own header for what each one covers.

use chemistry::catalysis::*

fn assert_all() -> i32 with IO, Mut, Div, Panic {
    var fail: i32 = 0
    if !test_mass_action_exact() { fail = fail + 1; println("FAIL mass_action_exact") }
    if !test_mm_matches_baseline() { fail = fail + 1; println("FAIL mm_matches_baseline") }
    if !test_mm_saturation_is_kcat() { fail = fail + 1; println("FAIL mm_saturation_is_kcat") }
    if !test_hill_identities() { fail = fail + 1; println("FAIL hill_identities") }
    if !test_langmuir_hinshelwood_asymptotics() { fail = fail + 1; println("FAIL lh_asymptotics") }
    if !test_enzyme_conservation() { fail = fail + 1; println("FAIL enzyme_conservation") }
    if !test_catalyst_conserved_cycle() { fail = fail + 1; println("FAIL catalyst_conserved_cycle") }
    if !test_qssa_checkpoint() { fail = fail + 1; println("FAIL qssa_checkpoint") }
    fail
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let fail = assert_all()
    if fail == 0 {
        println("CATALYSIS_STDLIB_OK")
        return 0
    }
    print("CATALYSIS_STDLIB: ") print(fail) println(" failures")
    fail
}
