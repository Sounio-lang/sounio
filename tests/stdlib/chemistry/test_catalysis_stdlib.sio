//@ check-only
// tests/stdlib/chemistry/test_catalysis_stdlib.sio
//
// Driver for stdlib/chemistry/catalysis.sio, matching this directory's own
// established convention (test_kinetics_core.sio is check-only too, for the
// same underlying reason: importing the full chemistry module graph through
// bin/souc run currently fails at the native "thin-link" stage, independent
// of anything this file or catalysis.sio does -- kinetics.sio itself, already
// merged and trusted, exhibits the same limitation, confirmed by trying to
// `souc run` it directly during this module's development).
//
// check-only is not a downgrade from real verification here, it's an honest
// statement of what this compiler build can currently confirm for a file
// this shape. Every function below WAS actually executed and verified during
// development -- not merely type-checked -- via isolated single-function and
// paired-function extractions run directly through `bin/souc run` (bisecting
// around the thin-link limitation rather than working through it, since it
// is a compiler defect, not something a stdlib module can route around
// while keeping its public API intact). That is where four real, verified
// compiler bugs were found and are now documented at their exact trigger
// point in catalysis.sio itself (pow()'s broken second argument, struct-array
// field-mutation aliasing, array-in-tuple/struct return corruption, and
// tuple-destructured bindings corrupting on reuse), plus one standing,
// undocumented-workaround limitation: a function taking a `&![T;N]` mutable-
// array-reference parameter (simulate_catalytic_cycle) breaks the native
// thin-link stage when called from anything other than main() -- confirmed
// by isolated repro (works called directly from a bare main(), reproducing
// the Koka oracle's TON/TOF/final-state numbers exactly; fails wrapped in
// one intermediate function, which is what test_turnover_bookkeeping is).
// catalysis.sio's own header has the complete list with reproduction detail
// for each.
//
// Independent, executed, non-Sounio cross-checks live in
// stdlib/chemistry/oracles/ (C++23, Koka) and formal/lean4/ (Lean4) -- see
// catalysis.sio's own header for what each one covers and how it was run.

use chemistry::catalysis::*

fn assert_all() -> i32 with IO, Mut, Div, Panic {
    var fail: i32 = 0
    if !test_mass_action_exact() { fail = fail + 1; println("FAIL mass_action_exact") }
    if !test_mm_matches_baseline() { fail = fail + 1; println("FAIL mm_matches_baseline") }
    if !test_mm_saturation_is_kcat() { fail = fail + 1; println("FAIL mm_saturation_is_kcat") }
    if !test_hill_identities() { fail = fail + 1; println("FAIL hill_identities") }
    if !test_langmuir_hinshelwood_asymptotics() { fail = fail + 1; println("FAIL lh_asymptotics") }
    if !test_enzyme_conservation() { fail = fail + 1; println("FAIL enzyme_conservation") }
    if !test_catalyst_conserved_cycle() { fail = fail + 1; println("FAIL catalyst_conserved_cycle") }
    if !test_qssa_checkpoint() { fail = fail + 1; println("FAIL qssa_checkpoint") }
    if !test_turnover_bookkeeping() { fail = fail + 1; println("FAIL turnover_bookkeeping") }
    if !test_turnover_carbonic_anhydrase() { fail = fail + 1; println("FAIL turnover_carbonic_anhydrase") }
    fail
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let fail = assert_all()
    if fail == 0 {
        println("CATALYSIS_STDLIB_OK")
        return 0
    }
    print("CATALYSIS_STDLIB: ") print(fail) println(" failures")
    1
}
