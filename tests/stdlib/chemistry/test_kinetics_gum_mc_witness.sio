//@ check-only
// Eixo B: GUM Jacobian propagation vs Monte Carlo witness for epistemic CRN (import-free core).

use chemistry::kinetics
use chemistry::stoichiometry

fn main() -> i32 with IO, Mut, Div, Panic {
    let _stoi = stoichiometry::test_moles_basic()
    if !kinetics::test_gum_mc_agreement_witness() {
        return 1
    }
    if !kinetics::test_crn_epistemic() {
        return 1
    }
    return 0
}