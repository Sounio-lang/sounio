//@ run-pass
//@ timeout: 600
// tests/stdlib/chemistry/test_gri30_full.sio
//
// FULL GRI-Mech 3.0 mechanism (53 species, 325 reactions): modified-Arrhenius
// rates, three-body efficiencies, Troe + Lindemann falloff, 16 irreversible
// reactions, NASA-7 thermochemistry with reverse rates from detailed balance
// (k_rev = k_fwd / Kc). All expectations cross-checked against an independent
// Python replication of the same mechanism
// (benchmarks/chemistry/gri30_full_python_replica.py; pre-ignition-front
// checkpoint only: the ignition front itself is exponentially phase-sensitive
// and not cross-language parity-testable). lean_single engine.
//
// The GUM/epistemic layer is exercised only in the module's own main
// (test_g30f_epistemic_smoke, 200 steps) — a suite-length epistemic run for
// 325 reactions / 53 species is too slow for CI.
use chemistry::gri30_full::*
fn main() -> i32 with IO, Mut, Div, Panic {
    if !test_g30f_rates() { print("FAIL g30f_rates\n"); return 1 }
    if !test_g30f_thermo() { print("FAIL g30f_thermo\n"); return 2 }
    if !test_g30f_sim() { print("FAIL g30f_sim\n"); return 3 }
    print("GRI30 FULL PASS\n")
    0
}
