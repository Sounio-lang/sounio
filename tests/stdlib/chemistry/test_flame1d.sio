//@ run-pass
//@ timeout: 300
// tests/stdlib/chemistry/test_flame1d.sio
//
// 1-D premixed H2/air flame solver: transport helper pins (unity-Lewis
// D(T) power law, rho/cp mixture helpers) and stage-clamped isobaric RK4
// chemistry substep pins. All expectations from the independent pure-Python
// replica (benchmarks/chemistry/flame1d_replica.py), which is validated
// against Cantera 3.2.0 (same 29-reaction sub-mechanism, same unity-Lewis
// transport). The full 0.4 ms flame run lives in
// examples/chemistry/h2_flame_speed_demo.sio (~1 h, not a suite test).
use chemistry::flame1d::*
fn main() -> i32 with IO, Mut, Div, Panic {
    if !test_fl1d_transport() { print("FAIL fl1d_transport\n"); return 1 }
    if !test_fl1d_substep() { print("FAIL fl1d_substep\n"); return 2 }
    print("FLAME1D PASS\n")
    0
}
