//@ run-pass
//@ timeout: 300
// tests/stdlib/chemistry/test_gri30_h2_adiabatic_delay.sio
//
// Full adiabatic ignition-front delays for the GRI-Mech 3.0 H/O
// sub-mechanism at T0=2000K (~46 us front) and T0=1500K (~126 us front).
// Expectations from the fixed Python replica and Cantera 3.2.0 (constant-V
// IdealGasReactor); the Sounio module, replica, and Cantera agree to ~0.1%
// on these delays (see benchmarks/chemistry/README.md).
use chemistry::gri30_h2::*
fn main() -> i32 with IO, Mut, Div, Panic {
    if !test_g30_uv_delay() { print("FAIL g30_uv_delay\n"); return 1 }
    print("GRI30 H2 ADIABATIC DELAY PASS\n")
    0
}
