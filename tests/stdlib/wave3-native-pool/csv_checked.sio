//@ run-pass
//@ expect-stdout: CSV_ROW_I64_CHECKED_OK
use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
use collections::byte_buffer::{ByteBuffer,byte_buffer_new,byte_buffer_push,byte_buffer_len,byte_buffer_close}
use io::native_file::{native_file_open,native_file_write_all,native_file_close}
use io::buffered_reader::{buffered_reader_new}
use data::csv_stream::{csv_stream_new,csv_stream_next,csv_stream_close,csv_owned_row_new,csv_owned_row_close,csv_row_i64_checked}
fn bytes(s:string)->ByteBuffer with Alloc,Mut,Div,Panic {
 var b=byte_buffer_new(1024)
 var i:i64=0
 while i<str_len(s){assert(byte_buffer_push(&!b,str_char_at(s,i))==0);i=i+1}
 return b
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let path=bytes("adc_checked_integers.csv")
 let contents=bytes("9223372036854775807\n-9223372036854775808\n+0\n-0\n9223372036854775808\n-9223372036854775809\n+\n1e2\n")
 let file=native_file_open(&p,&path,1)
 assert(native_file_write_all(&p,&file,&contents,0,byte_buffer_len(&contents)).status==0)
 assert(native_file_close(&p,file)==0)
 byte_buffer_close(contents)
 let input=native_file_open(&p,&path,0)
 var stream=csv_stream_new(buffered_reader_new(input,1,1),1)
 var row=csv_owned_row_new(64,1)
 var statuses:[i64;8]=[0,0,0,0,34,34,22,22]
 var values:[i64;8]=[9223372036854775807,0-9223372036854775807-1,0,0,0,0,0,0]
 var i:i64=0
 while i<8 {
  assert(csv_stream_next(&p,&!stream,&!row)==0)
  let got=csv_row_i64_checked(&row,0)
  assert(got.status==statuses[i as usize])
  assert(got.value==values[i as usize])
  assert(csv_row_i64_checked(&row,1).status==4)
  i=i+1
 }
 assert(csv_stream_next(&p,&!stream,&!row)==1)
 csv_owned_row_close(row)
 assert(csv_stream_close(&p,stream)==0)
 byte_buffer_close(path)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("CSV_ROW_I64_CHECKED_OK")
 return 0
}

