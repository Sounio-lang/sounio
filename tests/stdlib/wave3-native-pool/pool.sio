//@ run-pass
//@ expect-stdout: NATIVE_THREAD_POOL_OK
use ffi::platform::{platform_open,platform_status,platform_call,platform_close}
use thread::native_pool::{native_pool_new,native_pool_status,native_pool_reservation,native_pool_submit,native_pool_result,native_pool_outstanding,native_pool_shutdown,native_pool_join,native_pool_close}
fn square(x:i64)->i64 {x*x}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let p=platform_open()
 assert(platform_status(&p)==0)
 let bytes=native_pool_reservation(&p,2,4)
 assert(bytes.status==0)
 var pool=native_pool_new(&p,worker_fn_i64(square),2,4,bytes.value)
 assert(native_pool_status(&pool)==0)
 assert(native_pool_submit(&p,&!pool,0,1000).value==0)
 assert(native_pool_submit(&p,&!pool,0-7,1000).value==1)
 assert(native_pool_submit(&p,&!pool,11,1000).value==2)
 assert(native_pool_submit(&p,&!pool,1000000,1000).value==3)
 assert(native_pool_outstanding(&p,&pool).value==4)
 assert(native_pool_submit(&p,&!pool,8,0).status==11)
 assert(native_pool_result(&p,&!pool,3,5000).value==1000000000000)
 let zero=native_pool_result(&p,&!pool,0,5000)
 assert(zero.status==0 && zero.value==0 && zero.task_id==0)
 assert(native_pool_result(&p,&!pool,1,5000).value==49)
 assert(native_pool_result(&p,&!pool,2,5000).value==121)
 assert(native_pool_result(&p,&!pool,2,0).status==2)
 assert(native_pool_shutdown(&p,&!pool,false).status==0)
 assert(native_pool_submit(&p,&!pool,1,0).status==32)
 assert(native_pool_join(&p,&!pool)==0)
 assert(native_pool_join(&p,&!pool)==22)
 assert(native_pool_close(&p,pool)==0)
 let invalid=native_pool_new(&p,worker_fn_i64(square),2,4,bytes.value-1)
 assert(native_pool_status(&invalid)==105)
 assert(native_pool_close(&p,invalid)==105)
 assert(platform_call(&p,3,0,0,0,0).value==0)
 platform_close(p)
 println("NATIVE_THREAD_POOL_OK")
 return 0
}

