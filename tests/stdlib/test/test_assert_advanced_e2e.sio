//@ run-pass
// tests/stdlib/test/test_assert_advanced_e2e.sio — E2E tests for test::assert_advanced
//
// Covers: SoftAssertions collector, AsserterF64, AsserterI64, AsserterBool

use test::assert_advanced::{
    SoftAssertions,
    soft_assertions_new, soft_assertions_labeled,
    soft_assert_near_f64, soft_assert_eq_i64, soft_assert_true, soft_assert_false,
    soft_assert_in_range_f64, soft_assert_positive, soft_assert_non_negative,
    soft_assert_count, soft_assert_all,
    AsserterF64,
    asserter_f64, asserter_f64_described_as,
    asserter_f64_is_equal_to, asserter_f64_is_near, asserter_f64_is_greater_than,
    asserter_f64_is_less_than, asserter_f64_is_in_range,
    asserter_f64_is_positive, asserter_f64_is_non_negative,
    AsserterI64,
    asserter_i64, asserter_i64_described_as,
    asserter_i64_is_equal_to, asserter_i64_is_greater_than, asserter_i64_is_less_than,
    asserter_i64_is_in_range, asserter_i64_is_non_negative,
    AsserterBool,
    asserter_bool, asserter_bool_described_as,
    asserter_bool_is_true, asserter_bool_is_false,
}

// ============================================================================
// SoftAssertions — new, count, no failures
// ============================================================================

fn test_soft_assertions_empty() with Mut, Div, Panic, IO {
    let sa = soft_assertions_new()
    assert(soft_assert_count(sa) == 0)
    // all-passed: soft_assert_all returns 0
    assert(soft_assert_all(sa) == 0)
}

fn test_soft_assertions_labeled() with Mut, Div, Panic, IO {
    let sa = soft_assertions_labeled("my-suite")
    assert(soft_assert_count(sa) == 0)
}

fn test_soft_assert_near_f64_pass() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_near_f64(&!sa, 1.0, 1.0, 1.0e-9, "near 1.0")
    assert(soft_assert_count(sa) == 0)
}

fn test_soft_assert_near_f64_fail() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_near_f64(&!sa, 1.0, 2.0, 1.0e-9, "near 2.0 fails")
    assert(soft_assert_count(sa) == 1)
}

fn test_soft_assert_eq_i64_pass() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_eq_i64(&!sa, 42, 42, "eq 42")
    assert(soft_assert_count(sa) == 0)
}

fn test_soft_assert_eq_i64_fail() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_eq_i64(&!sa, 42, 43, "eq 43 fails")
    assert(soft_assert_count(sa) == 1)
}

fn test_soft_assert_true_pass() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_true(&!sa, 5 > 3, "5 > 3")
    assert(soft_assert_count(sa) == 0)
}

fn test_soft_assert_false_fail() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_false(&!sa, true, "true should be false — expected fail")
    assert(soft_assert_count(sa) == 1)
}

fn test_soft_assert_in_range_pass() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_in_range_f64(&!sa, 0.5, 0.0, 1.0, "0.5 in [0,1]")
    assert(soft_assert_count(sa) == 0)
}

fn test_soft_assert_in_range_fail() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_in_range_f64(&!sa, 2.0, 0.0, 1.0, "2.0 outside [0,1]")
    assert(soft_assert_count(sa) == 1)
}

fn test_soft_assert_positive_pass() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_positive(&!sa, 3.14, "pi positive")
    assert(soft_assert_count(sa) == 0)
}

fn test_soft_assert_non_negative_fail() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_non_negative(&!sa, 0.0 - 1.0, "negative — expected fail")
    assert(soft_assert_count(sa) == 1)
}

fn test_soft_assert_all_fail_count() with Mut, Div, Panic, IO {
    var sa = soft_assertions_new()
    soft_assert_eq_i64(&!sa, 1, 2, "fail1")
    soft_assert_eq_i64(&!sa, 3, 4, "fail2")
    // soft_assert_all prints failures and returns count
    let n = soft_assert_all(sa)
    assert(n == 2)
}

// ============================================================================
// AsserterF64
// ============================================================================

fn test_asserter_f64_equal_pass() with IO, Panic {
    let a = asserter_f64(3.14)
    assert(asserter_f64_is_equal_to(a, 3.14))
}

fn test_asserter_f64_near_pass() with IO, Panic {
    let a = asserter_f64_described_as(asserter_f64(1.0000001), "approx 1")
    assert(asserter_f64_is_near(a, 1.0, 1.0e-5))
}

fn test_asserter_f64_near_fail() with IO, Panic {
    let a = asserter_f64(2.0)
    assert(!asserter_f64_is_near(a, 1.0, 1.0e-9))
}

fn test_asserter_f64_greater_than() with IO, Panic {
    let a = asserter_f64(5.0)
    assert(asserter_f64_is_greater_than(a, 4.0))
    assert(!asserter_f64_is_greater_than(a, 6.0))
}

fn test_asserter_f64_less_than() with IO, Panic {
    let a = asserter_f64(2.0)
    assert(asserter_f64_is_less_than(a, 3.0))
    assert(!asserter_f64_is_less_than(a, 1.0))
}

fn test_asserter_f64_in_range() with IO, Panic {
    let a = asserter_f64(0.5)
    assert(asserter_f64_is_in_range(a, 0.0, 1.0))
    assert(!asserter_f64_is_in_range(a, 0.6, 1.0))
}

fn test_asserter_f64_positive_non_negative() with IO, Panic {
    let a = asserter_f64(1.0)
    assert(asserter_f64_is_positive(a))
    assert(asserter_f64_is_non_negative(a))

    let b = asserter_f64(0.0 - 1.0)
    assert(!asserter_f64_is_positive(b))
    assert(!asserter_f64_is_non_negative(b))
}

// ============================================================================
// AsserterI64
// ============================================================================

fn test_asserter_i64_equal_pass() with IO, Panic {
    let a = asserter_i64(42)
    assert(asserter_i64_is_equal_to(a, 42))
    assert(!asserter_i64_is_equal_to(a, 43))
}

fn test_asserter_i64_bounds() with IO, Panic {
    let a = asserter_i64(10)
    assert(asserter_i64_is_greater_than(a, 5))
    assert(!asserter_i64_is_greater_than(a, 15))
    assert(asserter_i64_is_less_than(a, 20))
    assert(!asserter_i64_is_less_than(a, 5))
}

fn test_asserter_i64_in_range() with IO, Panic {
    let a = asserter_i64_described_as(asserter_i64(5), "five")
    assert(asserter_i64_is_in_range(a, 1, 10))
    assert(!asserter_i64_is_in_range(a, 6, 10))
}

fn test_asserter_i64_non_negative() with IO, Panic {
    let a = asserter_i64(0)
    assert(asserter_i64_is_non_negative(a))

    let b = asserter_i64(0 - 1)
    assert(!asserter_i64_is_non_negative(b))
}

// ============================================================================
// AsserterBool
// ============================================================================

fn test_asserter_bool_true() with IO, Panic {
    let a = asserter_bool(true)
    assert(asserter_bool_is_true(a))
    assert(!asserter_bool_is_false(a))
}

fn test_asserter_bool_false() with IO, Panic {
    let a = asserter_bool_described_as(asserter_bool(false), "should be false")
    assert(asserter_bool_is_false(a))
    assert(!asserter_bool_is_true(a))
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with IO, Mut, Div, Panic {
    test_soft_assertions_empty()
    test_soft_assertions_labeled()
    test_soft_assert_near_f64_pass()
    test_soft_assert_near_f64_fail()
    test_soft_assert_eq_i64_pass()
    test_soft_assert_eq_i64_fail()
    test_soft_assert_true_pass()
    test_soft_assert_false_fail()
    test_soft_assert_in_range_pass()
    test_soft_assert_in_range_fail()
    test_soft_assert_positive_pass()
    test_soft_assert_non_negative_fail()
    test_soft_assert_all_fail_count()
    test_asserter_f64_equal_pass()
    test_asserter_f64_near_pass()
    test_asserter_f64_near_fail()
    test_asserter_f64_greater_than()
    test_asserter_f64_less_than()
    test_asserter_f64_in_range()
    test_asserter_f64_positive_non_negative()
    test_asserter_i64_equal_pass()
    test_asserter_i64_bounds()
    test_asserter_i64_in_range()
    test_asserter_i64_non_negative()
    test_asserter_bool_true()
    test_asserter_bool_false()
    println("PASS: test/assert_advanced — all tests passed")
}
