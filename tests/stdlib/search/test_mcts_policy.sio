//@ run-pass
//@ expect-stdout: MCTS_POLICY_EPISTEMIC_PASS

use search::mcts::policy::puct_epistemic

fn main() with IO {
    let low = puct_epistemic(0.5, 5, 100, 0.25, 0.01, 1.4, 0.8)
    let high = puct_epistemic(0.5, 5, 100, 0.25, 0.25, 1.4, 0.8)
    let adv = high - low
    println(adv)
    if adv > 0.01 {
        println("MCTS_POLICY_EPISTEMIC_PASS")
    } else {
        println("MCTS_POLICY_EPISTEMIC_FAIL")
    }
}