//@ run-pass
//@ expect-stdout: BIDI_SMOKE_OK
use text::unicode_bidi::{unicode_bidi_resolve,unicode_bidi_status,unicode_bidi_scalar_len,unicode_bidi_visual_to_logical,unicode_bidi_level,unicode_bidi_paragraph_count,unicode_bidi_paragraph,unicode_bidi_close,unicode_bidi_line_reorder,unicode_bidi_line_status,unicode_bidi_line_close,unicode_bidi_mirroring}
use text::utf8::{utf8_text_from_string,utf8_text_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let text=utf8_text_from_string("abc",16)
 let resolved=unicode_bidi_resolve(&text,2,4096,16384)
 utf8_text_close(text)
 assert(unicode_bidi_status(&resolved)==0)
 assert(unicode_bidi_scalar_len(&resolved)==3)
 assert(unicode_bidi_paragraph_count(&resolved)==1)
 assert(unicode_bidi_paragraph(&resolved,0).base==0)
 assert(unicode_bidi_level(&resolved,0).value==0)
 assert(unicode_bidi_visual_to_logical(&resolved,2).value==2)
 let line=unicode_bidi_line_reorder(&resolved,0,2,4096)
 assert(unicode_bidi_line_status(&line)==0)
 unicode_bidi_close(resolved)
 unicode_bidi_line_close(line)
 let mirror=unicode_bidi_mirroring(40,1)
 assert(mirror.status==0 && mirror.codepoint==41 && mirror.mirror_glyph)
 println("BIDI_SMOKE_OK")
 0
}
