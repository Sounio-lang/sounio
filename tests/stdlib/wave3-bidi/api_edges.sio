//@ run-pass
//@ expect-stdout: BIDI_API_EDGES_OK
use text::utf8::{utf8_text_from_string,utf8_text_close}
use text::unicode_bidi::{unicode_bidi_resolve,unicode_bidi_status,unicode_bidi_scalar_len,unicode_bidi_visual_len,unicode_bidi_paragraph_count,unicode_bidi_paragraph,unicode_bidi_level,unicode_bidi_close,unicode_bidi_line_reorder,unicode_bidi_line_status,unicode_bidi_line_visual_len,unicode_bidi_line_close,unicode_bidi_mirroring}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let empty=utf8_text_from_string("",0)
 let none=unicode_bidi_resolve(&empty,3,0,0)
 utf8_text_close(empty)
 assert(unicode_bidi_status(&none)==0)
 assert(unicode_bidi_scalar_len(&none)==0 && unicode_bidi_visual_len(&none)==0)
 assert(unicode_bidi_paragraph_count(&none)==0 && unicode_bidi_paragraph(&none,0).status==4)
 assert(unicode_bidi_level(&none,0).status==4)
 let empty_line=unicode_bidi_line_reorder(&none,0,0,0)
 unicode_bidi_close(none)
 assert(unicode_bidi_line_status(&empty_line)==0 && unicode_bidi_line_visual_len(&empty_line)==0)
 unicode_bidi_line_close(empty_line)
 // With no strong character, autoRTL uses RTL and autoLTR uses LTR.
 var mode:i64=0
 while mode<4 {
  let punctuation=utf8_text_from_string(".",1)
  let resolved=unicode_bidi_resolve(&punctuation,mode,96,4160)
  utf8_text_close(punctuation)
  let expected=if mode==1 || mode==3 {1} else {0}
  assert(unicode_bidi_status(&resolved)==0)
  assert(unicode_bidi_paragraph(&resolved,0).base==expected)
  assert(unicode_bidi_level(&resolved,0).value==expected)
  let negative=unicode_bidi_line_reorder(&resolved,0-1,1,56)
  assert(unicode_bidi_line_status(&negative)==4)
  unicode_bidi_line_close(negative)
  unicode_bidi_close(resolved)
  mode=mode+1
 }
 // A real strong character supersedes the autoRTL fallback.
 let latin=utf8_text_from_string("a",1)
 let strong=unicode_bidi_resolve(&latin,3,96,4160)
 assert(unicode_bidi_status(&strong)==0 && unicode_bidi_paragraph(&strong,0).base==0)
 unicode_bidi_close(strong)
 let negative_result=unicode_bidi_resolve(&latin,0,0-1,4160)
 let negative_work=unicode_bidi_resolve(&latin,0,96,0-1)
 utf8_text_close(latin)
 assert(unicode_bidi_status(&negative_result)==1 && unicode_bidi_scalar_len(&negative_result)==0)
 assert(unicode_bidi_status(&negative_work)==1 && unicode_bidi_scalar_len(&negative_work)==0)
 unicode_bidi_close(negative_result);unicode_bidi_close(negative_work)
 let surrogate=unicode_bidi_mirroring(0xD800,1)
 let too_large=unicode_bidi_mirroring(0x110000,1)
 let bad_level=unicode_bidi_mirroring(40,127)
 assert(surrogate.status==1 && too_large.status==1 && bad_level.status==1)
 println("BIDI_API_EDGES_OK")
 0
}
