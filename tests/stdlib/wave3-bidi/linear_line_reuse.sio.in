use text::utf8::{utf8_text_from_string,utf8_text_close}
use text::unicode_bidi::{unicode_bidi_resolve,unicode_bidi_close,unicode_bidi_line_reorder,unicode_bidi_line_close}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let input=utf8_text_from_string("a",1)
 let result=unicode_bidi_resolve(&input,0,96,4160)
 utf8_text_close(input)
 let line=unicode_bidi_line_reorder(&result,0,1,56)
 unicode_bidi_close(result)
 unicode_bidi_line_close(line)
 unicode_bidi_line_close(line)
 0
}
