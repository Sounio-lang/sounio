//@ run-pass
// E2E tests for stdlib/io/io.sio
//
// Tests: io_buf_new, io_buf_write, io_buf_read, io_buf_remaining,
//        io_buf_capacity, io_buf_is_empty, io_buf_reset

use io::io::*

fn run_tests() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    // -------------------------------------------------------- io_buf_new
    print("Test 01: io_buf_new initialises with len=0 pos=0... ")
    let b0 = io_buf_new()
    if b0.len == 0 && b0.pos == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_is_empty
    print("Test 02: io_buf_is_empty on fresh buffer... ")
    if io_buf_is_empty(&b0) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_capacity
    print("Test 03: io_buf_capacity on fresh buffer is 4096... ")
    if io_buf_capacity(&b0) == 4096 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_write
    print("Test 04: io_buf_write stores 3 bytes... ")
    var data: [u8; 256] = [0; 256]
    data[0] = 65
    data[1] = 66
    data[2] = 67
    let b1 = io_buf_write(b0, &data, 3)
    if b1.len == 3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_is_empty after write
    print("Test 05: io_buf_is_empty false after write... ")
    if !io_buf_is_empty(&b1) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_remaining
    print("Test 06: io_buf_remaining equals len after write... ")
    if io_buf_remaining(&b1) == 3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_capacity after write
    print("Test 07: io_buf_capacity decreases after write... ")
    if io_buf_capacity(&b1) == 4093 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_read count matches
    print("Test 08: io_buf_read returns count=3 for 3-byte buffer... ")
    var out: [u8; 256] = [0; 256]
    var b1_r = b1
    let n1 = io_buf_read(&!b1_r, &!out, 3)
    if n1 == 3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_read partial count
    print("Test 09: io_buf_read partial returns count=2... ")
    var data2: [u8; 256] = [0; 256]
    data2[0] = 10
    data2[1] = 20
    data2[2] = 30
    var b2 = io_buf_write(io_buf_new(), &data2, 3)
    var out2: [u8; 256] = [0; 256]
    let n2 = io_buf_read(&!b2, &!out2, 2)
    if n2 == 2 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_remaining after partial read
    print("Test 10: io_buf_remaining after partial read... ")
    if io_buf_remaining(&b2) == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_reset
    print("Test 11: io_buf_reset clears len and pos... ")
    let b4 = io_buf_reset(b1)
    if b4.len == 0 && b4.pos == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // -------------------------------------------------------- io_buf_is_empty after reset
    print("Test 12: io_buf_is_empty true after reset... ")
    if io_buf_is_empty(&b4) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("All tests passed!\n")
        0
    } else {
        print("Some tests FAILED\n")
        1
    }
}

fn main() -> i32 with Mut, Panic, Div {
    run_tests()
}
