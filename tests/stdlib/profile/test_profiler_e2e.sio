//@ run-pass
//@ requires: madaros
//@ expect-stdout: PROFILE_CONTRACT_OK
use ffi::platform::{platform_open,platform_status,platform_close}
use profile::profiler::{profiler_new,profiler_begin,profiler_end,profiler_slot_calls,profiler_slot_total_ms,profiler_slot_count}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let platform=platform_open()
    assert(platform_status(&platform)==0)
    var p=profiler_new()
    assert(profiler_slot_count(p)==0)
    assert(profiler_end(&platform,&!p,"missing")==2)
    assert(profiler_begin(&platform,&!p,"work")==0)
    assert(profiler_begin(&platform,&!p,"work")==114)
    assert(profiler_end(&platform,&!p,"work")==0)
    assert(profiler_end(&platform,&!p,"work")==22)
    assert(profiler_slot_count(p)==1)
    assert(profiler_slot_calls(p,"work")==1)
    assert(profiler_slot_total_ms(p,"work")>=0.0)
    platform_close(platform)
    println("PROFILE_CONTRACT_OK")
    return 0
}
