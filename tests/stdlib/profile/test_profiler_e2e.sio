// tests/stdlib/profile/test_profiler_e2e.sio — E2E tests for profile::profiler
//
// Tests profiler creation, begin/end timing, reset, slot queries.
// Uses POSIX clock_gettime(CLOCK_MONOTONIC) — always available on Linux.

use profile::profiler::{
    ProfileSlot, Profiler,
    profiler_new, profiler_begin, profiler_end, profiler_reset, profiler_report,
    profiler_slot_total_ms, profiler_slot_calls, profiler_slot_avg_us,
    profiler_slot_count,
}

// ============================================================================
// Construction
// ============================================================================

fn test_profiler_new() with Panic, Div {
    let p = profiler_new()
    assert(profiler_slot_count(p) == 0)
}

// ============================================================================
// Begin / End — basic timing
// ============================================================================

fn test_profiler_begin_end_single() with Mut, IO, Panic {
    var p = profiler_new()
    profiler_begin(&!p, "alpha")
    profiler_end(&!p, "alpha")

    assert(profiler_slot_count(p) == 1)
    assert(profiler_slot_calls(p, "alpha") == 1)
    // total_ms should be >= 0.0 (monotonic)
    let ms = profiler_slot_total_ms(p, "alpha")
    assert(ms >= 0.0)
}

fn test_profiler_multiple_slots() with Mut, IO, Panic {
    var p = profiler_new()
    profiler_begin(&!p, "fast")
    profiler_end(&!p, "fast")
    profiler_begin(&!p, "slow")
    profiler_end(&!p, "slow")

    assert(profiler_slot_count(p) == 2)
    assert(profiler_slot_calls(p, "fast") == 1)
    assert(profiler_slot_calls(p, "slow") == 1)
}

fn test_profiler_repeated_calls() with Mut, IO, Panic {
    var p = profiler_new()
    profiler_begin(&!p, "iter")
    profiler_end(&!p, "iter")
    profiler_begin(&!p, "iter")
    profiler_end(&!p, "iter")
    profiler_begin(&!p, "iter")
    profiler_end(&!p, "iter")

    assert(profiler_slot_count(p) == 1)
    assert(profiler_slot_calls(p, "iter") == 3)
}

// ============================================================================
// Unknown slot queries return zero
// ============================================================================

fn test_profiler_unknown_slot() with Panic {
    let p = profiler_new()
    assert(profiler_slot_calls(p, "nonexistent") == 0)
    assert(profiler_slot_total_ms(p, "nonexistent") == 0.0)
    assert(profiler_slot_avg_us(p, "nonexistent") == 0.0)
}

// ============================================================================
// avg_us — returns 0.0 when no calls
// ============================================================================

fn test_profiler_avg_us_no_calls() with Panic {
    let p = profiler_new()
    // slot doesn't exist → 0.0
    assert(profiler_slot_avg_us(p, "ghost") == 0.0)
}

fn test_profiler_avg_us_after_calls() with Mut, IO, Panic {
    var p = profiler_new()
    profiler_begin(&!p, "task")
    profiler_end(&!p, "task")
    profiler_begin(&!p, "task")
    profiler_end(&!p, "task")
    // avg_us >= 0.0 after 2 calls
    let avg = profiler_slot_avg_us(p, "task")
    assert(avg >= 0.0)
    assert(profiler_slot_calls(p, "task") == 2)
}

// ============================================================================
// Reset
// ============================================================================

fn test_profiler_reset_clears_totals() with Mut, IO, Div, Panic {
    var p = profiler_new()
    profiler_begin(&!p, "work")
    profiler_end(&!p, "work")
    assert(profiler_slot_calls(p, "work") == 1)

    profiler_reset(&!p)
    // After reset: slot still exists but count is zeroed
    assert(profiler_slot_calls(p, "work") == 0)
    assert(profiler_slot_total_ms(p, "work") == 0.0)
}

// ============================================================================
// end without begin — graceful error handling (prints warning, no crash)
// ============================================================================

fn test_profiler_end_without_begin() with Mut, IO, Panic {
    var p = profiler_new()
    // Should print error message but not crash
    profiler_end(&!p, "ghost")
    assert(profiler_slot_count(p) == 0)
}

// ============================================================================
// Report
// ============================================================================

fn test_profiler_report() with Mut, IO, Div, Panic {
    var p = profiler_new()
    profiler_begin(&!p, "section1")
    profiler_end(&!p, "section1")
    profiler_begin(&!p, "section2")
    profiler_end(&!p, "section2")
    // Just verifies report doesn't crash
    profiler_report(p)
}

// ============================================================================
// Main
// ============================================================================

pub fn main() with IO, Mut, Div, Panic {
    test_profiler_new()
    test_profiler_begin_end_single()
    test_profiler_multiple_slots()
    test_profiler_repeated_calls()
    test_profiler_unknown_slot()
    test_profiler_avg_us_no_calls()
    test_profiler_avg_us_after_calls()
    test_profiler_reset_clears_totals()
    test_profiler_end_without_begin()
    test_profiler_report()
    println("PASS: profile/profiler — all tests passed")
}
