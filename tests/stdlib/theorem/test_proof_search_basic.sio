//@ run-pass
//@ known-failure: Requires implementation

use theorem::search::*

fn proof_matches_goal(ctx: &ProofContext, proof_id: i64, goal: i64) -> bool {
    if proof_id < 0 { return false }
    let proof = ctx_get_proof(ctx, proof_id)
    let lhs = ctx_get_prop(ctx, proof.prop_id)
    let rhs = ctx_get_prop(ctx, goal)
    return prop_eq_check(lhs, rhs)
}

fn has_empty_clause(ctx: &ProofContext) -> bool with Mut {
    var i: i32 = 0
    while i < ctx.clause_count {
        if ctx.clause_len[i] == 0 { return true }
        i = i + 1
    }
    return false
}

fn main() -> i32 with IO, Mut, Div {
    var pass: i32 = 0
    var fail: i32 = 0

    var ctx1 = proof_context_new()
    let a1 = ctx_prop(&! ctx1, prop_custom(10))
    let b1 = ctx_prop(&! ctx1, prop_custom(20))
    assume(&! ctx1, 1, a1)
    assume(&! ctx1, 2, b1)
    let goal1 = ctx_prop(&! ctx1, prop_and(a1, b1))
    let prf1 = auto_prove(&! ctx1, goal1, 4)
    if proof_matches_goal(&ctx1, prf1, goal1) {
        println("T1 PASS: A and B")
        pass = pass + 1
    } else {
        println("T1 FAIL")
        fail = fail + 1
    }

    var ctx2 = proof_context_new()
    let a2 = ctx_prop(&! ctx2, prop_custom(11))
    let b2 = ctx_prop(&! ctx2, prop_custom(22))
    assume(&! ctx2, 3, a2)
    let ab2 = ctx_prop(&! ctx2, prop_implies(a2, b2))
    assume(&! ctx2, 4, ab2)
    let prf2 = auto_prove(&! ctx2, b2, 4)
    if proof_matches_goal(&ctx2, prf2, b2) {
        println("T2 PASS: modus ponens")
        pass = pass + 1
    } else {
        println("T2 FAIL")
        fail = fail + 1
    }

    var ctx3 = proof_context_new()
    let a3 = ctx_prop(&! ctx3, prop_custom(12))
    let b3 = ctx_prop(&! ctx3, prop_custom(24))
    assume(&! ctx3, 5, a3)
    let goal3 = ctx_prop(&! ctx3, prop_or(a3, b3))
    let prf3 = auto_prove(&! ctx3, goal3, 4)
    if proof_matches_goal(&ctx3, prf3, goal3) {
        println("T3 PASS: or-intro")
        pass = pass + 1
    } else {
        println("T3 FAIL")
        fail = fail + 1
    }

    var ctx4 = proof_context_new()
    let a4 = ctx_prop(&! ctx4, prop_custom(13))
    let na4 = ctx_prop(&! ctx4, prop_not(a4))
    let nna4 = ctx_prop(&! ctx4, prop_not(na4))
    let goal4 = ctx_prop(&! ctx4, prop_implies(nna4, a4))
    let prf4 = auto_prove(&! ctx4, goal4, 6)
    if proof_matches_goal(&ctx4, prf4, goal4) {
        println("T4 PASS: double negation")
        pass = pass + 1
    } else {
        println("T4 FAIL")
        fail = fail + 1
    }

    var ctx5 = proof_context_new()
    let a5 = ctx_prop(&! ctx5, prop_custom(14))
    let b5 = ctx_prop(&! ctx5, prop_custom(15))
    let c5 = ctx_prop(&! ctx5, prop_custom(16))
    let ab5 = ctx_prop(&! ctx5, prop_implies(a5, b5))
    let bc5 = ctx_prop(&! ctx5, prop_implies(b5, c5))
    let ac5 = ctx_prop(&! ctx5, prop_implies(a5, c5))
    let inner5 = ctx_prop(&! ctx5, prop_implies(bc5, ac5))
    let goal5 = ctx_prop(&! ctx5, prop_implies(ab5, inner5))
    let prf5 = auto_prove(&! ctx5, goal5, 6)
    if proof_matches_goal(&ctx5, prf5, goal5) {
        println("T5 PASS: implication transitivity")
        pass = pass + 1
    } else {
        println("T5 FAIL")
        fail = fail + 1
    }

    var ctx6 = proof_context_new()
    let a6 = ctx_prop(&! ctx6, prop_custom(17))
    let b6 = ctx_prop(&! ctx6, prop_custom(18))
    let na6 = ctx_prop(&! ctx6, prop_not(a6))
    let nb6 = ctx_prop(&! ctx6, prop_not(b6))
    let na_or_b6 = ctx_prop(&! ctx6, prop_or(na6, b6))
    assume(&! ctx6, 6, a6)
    assume(&! ctx6, 7, na_or_b6)
    assume(&! ctx6, 8, nb6)
    let false6 = ctx_prop(&! ctx6, prop_false())
    let res61 = resolve(&! ctx6, a6, na_or_b6, a6)
    let res62 = resolve(&! ctx6, res61, nb6, b6)
    if prop_eq_check(ctx_get_prop(&ctx6, res62), ctx_get_prop(&ctx6, false6)) {
        println("T6 PASS: resolution contradiction")
        pass = pass + 1
    } else {
        println("T6 FAIL")
        fail = fail + 1
    }

    var ctx7 = proof_context_new()
    let a7 = ctx_prop(&! ctx7, prop_custom(19))
    let b7 = ctx_prop(&! ctx7, prop_custom(21))
    let and7 = ctx_prop(&! ctx7, prop_and(a7, b7))
    let not_and7 = ctx_prop(&! ctx7, prop_not(and7))
    let not_a7 = ctx_prop(&! ctx7, prop_not(a7))
    let not_b7 = ctx_prop(&! ctx7, prop_not(b7))
    let left_or7 = ctx_prop(&! ctx7, prop_or(not_a7, not_b7))
    let left_impl7 = ctx_prop(&! ctx7, prop_implies(not_and7, left_or7))
    let right_impl7 = ctx_prop(&! ctx7, prop_implies(left_or7, not_and7))
    let goal7 = ctx_prop(&! ctx7, prop_and(left_impl7, right_impl7))
    let prf7 = tactic_or(&! ctx7, goal7, 0, 6)
    if proof_matches_goal(&ctx7, prf7, goal7) {
        println("T7 PASS: De Morgan")
        pass = pass + 1
    } else {
        println("T7 FAIL")
        fail = fail + 1
    }

    println("---")
    if fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
