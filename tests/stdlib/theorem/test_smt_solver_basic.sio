//@ run-pass

use theorem::smt::*

fn lcg_next(state: &!i64) -> i64 with Mut, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    var next = (*state * a + c) % m
    if next < 0 { next = next + m }
    *state = next
    return next
}

fn main() -> i32 with IO, Mut, Div {
    var pass: i32 = 0
    var fail: i32 = 0

    var ctx = smt_new()
    var c1: [i32; 8] = [0 as i32; 8]
    c1[0] = 0
    c1[1] = 2
    smt_add_clause(&! ctx, &c1, 2)
    var c2: [i32; 8] = [0 as i32; 8]
    c2[0] = 1
    c2[1] = 2
    smt_add_clause(&! ctx, &c2, 2)
    let t1 = smt_solve(&! ctx)
    if t1 == 1 && smt_get_assignment(&ctx, 1) == 1 {
        println("T1 PASS: simple SAT")
        pass = pass + 1
    } else {
        println("T1 FAIL")
        fail = fail + 1
    }

    var ctx2 = smt_new()
    var c3: [i32; 8] = [0 as i32; 8]
    c3[0] = 0
    smt_add_clause(&! ctx2, &c3, 1)
    var c4: [i32; 8] = [0 as i32; 8]
    c4[0] = 1
    smt_add_clause(&! ctx2, &c4, 1)
    if smt_solve(&! ctx2) == 0 {
        println("T2 PASS: simple UNSAT")
        pass = pass + 1
    } else {
        println("T2 FAIL")
        fail = fail + 1
    }

    var ctx3 = smt_new()
    var lia1: [i64; 16] = [0; 16]
    lia1[0] = 0 - 1
    smt_add_lia(&! ctx3, &lia1, 0)
    var lia2: [i64; 16] = [0; 16]
    lia2[0] = 1
    smt_add_lia(&! ctx3, &lia2, 5)
    var lia3: [i64; 16] = [0; 16]
    lia3[0] = 0 - 1
    smt_add_lia(&! ctx3, &lia3, 0 - 3)
    if smt_solve(&! ctx3) == 1 {
        println("T3 PASS: pure LIA SAT")
        pass = pass + 1
    } else {
        println("T3 FAIL")
        fail = fail + 1
    }

    var ctx4 = smt_new()
    var lia4: [i64; 16] = [0; 16]
    lia4[0] = 0 - 1
    smt_add_lia(&! ctx4, &lia4, 0)
    var lia5: [i64; 16] = [0; 16]
    lia5[0] = 1
    smt_add_lia(&! ctx4, &lia5, 2)
    var lia6: [i64; 16] = [0; 16]
    lia6[0] = 0 - 1
    smt_add_lia(&! ctx4, &lia6, 0 - 5)
    if smt_solve(&! ctx4) == 0 {
        println("T4 PASS: pure LIA UNSAT")
        pass = pass + 1
    } else {
        println("T4 FAIL")
        fail = fail + 1
    }

    var ctx5 = smt_new()
    var seed: i64 = 1234567
    var clause_idx: i32 = 0
    while clause_idx < 42 {
        var clause: [i32; 8] = [0 as i32; 8]
        var lit_idx: i32 = 0
        while lit_idx < 3 {
            let raw_var = lcg_next(&! seed) % 10
            let raw_pol = lcg_next(&! seed) % 2
            clause[lit_idx] = (raw_var as i32) * 2 + (raw_pol as i32)
            lit_idx = lit_idx + 1
        }
        smt_add_clause(&! ctx5, &clause, 3)
        clause_idx = clause_idx + 1
    }
    let t5 = smt_solve(&! ctx5)
    if t5 == 0 || t5 == 1 {
        println("T5 PASS: bounded 3-SAT smoke test")
        pass = pass + 1
    } else {
        println("T5 FAIL")
        fail = fail + 1
    }

    println("---")
    if fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
