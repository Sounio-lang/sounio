//@ run-pass
//@ known-failure: Requires implementation
// E2E tests for stdlib/string/string.sio
//
// Tests: str_is_continuation, str_char_count, str_buf_eq, str_starts_with,
//        str_find_byte, str_trim_start, str_trim_end,
//        str_to_upper_byte, str_to_lower_byte

use string::string::*

fn buf_from_ascii(a: u8, b: u8, c: u8) -> [u8; 256] {
    var buf: [u8; 256] = [0; 256]
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // ------------------------------------------- str_is_continuation: ASCII byte
    print("Test 01: str_is_continuation ASCII 'A' (65) == 0... ")
    if str_is_continuation(65) == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_is_continuation: continuation byte
    print("Test 02: str_is_continuation 0x80 (128) == 1... ")
    if str_is_continuation(128) == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_is_continuation: lead byte 0xC2 not a continuation
    print("Test 03: str_is_continuation 0xC2 (194) == 0... ")
    if str_is_continuation(194) == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_char_count ASCII
    print("Test 04: str_char_count 3 ASCII bytes == 3... ")
    let buf_abc = buf_from_ascii(65, 66, 67)
    if str_char_count(buf_abc, 3) == 3 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_char_count empty
    print("Test 05: str_char_count 0 bytes == 0... ")
    let buf_empty: [u8; 256] = [0; 256]
    if str_char_count(buf_empty, 0) == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_buf_eq equal buffers
    print("Test 06: str_buf_eq equal 3-byte buffers == 1... ")
    let ba = buf_from_ascii(72, 105, 0)
    let bb = buf_from_ascii(72, 105, 0)
    if str_buf_eq(ba, 2, bb, 2) == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_buf_eq different lengths
    print("Test 07: str_buf_eq different lengths == 0... ")
    if str_buf_eq(ba, 2, bb, 1) == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_buf_eq different content
    print("Test 08: str_buf_eq different content == 0... ")
    let bc = buf_from_ascii(72, 106, 0)
    if str_buf_eq(ba, 2, bc, 2) == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_starts_with true
    print("Test 09: str_starts_with prefix present == 1... ")
    let buf_hello = buf_from_ascii(72, 101, 108)   // "Hel"
    let prefix_h = buf_from_ascii(72, 0, 0)        // "H"
    if str_starts_with(buf_hello, 3, prefix_h, 1) == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_starts_with too long prefix
    print("Test 10: str_starts_with prefix longer than buf == 0... ")
    if str_starts_with(prefix_h, 1, buf_hello, 3) == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_find_byte found
    print("Test 11: str_find_byte finds byte at index 1... ")
    let buf_xy = buf_from_ascii(88, 89, 90)   // "XYZ"
    if str_find_byte(buf_xy, 3, 89) == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_find_byte not found
    print("Test 12: str_find_byte absent byte returns -1... ")
    if str_find_byte(buf_xy, 3, 65) == 0 - 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_trim_start no leading space
    print("Test 13: str_trim_start no leading spaces returns 0... ")
    if str_trim_start(buf_xy, 3) == 0 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_trim_start with spaces
    print("Test 14: str_trim_start with 2 leading spaces returns 2... ")
    var buf_sp: [u8; 256] = [0; 256]
    buf_sp[0] = 32   // space
    buf_sp[1] = 32   // space
    buf_sp[2] = 65   // 'A'
    if str_trim_start(buf_sp, 3) == 2 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_trim_end
    print("Test 15: str_trim_end strips trailing spaces... ")
    var buf_te: [u8; 256] = [0; 256]
    buf_te[0] = 65   // 'A'
    buf_te[1] = 32   // space
    buf_te[2] = 32   // space
    if str_trim_end(buf_te, 3) == 1 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_to_upper_byte
    print("Test 16: str_to_upper_byte 'a' -> 'A'... ")
    if str_to_upper_byte(97) == 65 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_to_upper_byte non-alpha unchanged
    print("Test 17: str_to_upper_byte '0' unchanged... ")
    if str_to_upper_byte(48) == 48 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // ------------------------------------------- str_to_lower_byte
    print("Test 18: str_to_lower_byte 'Z' -> 'z'... ")
    if str_to_lower_byte(90) == 122 {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    if fail == 0 {
        print("All tests passed!\n")
        0
    } else {
        print("Some tests FAILED\n")
        1
    }
}

fn main() -> i32 {
    run_tests()
}
