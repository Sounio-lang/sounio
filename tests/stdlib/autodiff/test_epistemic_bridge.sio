//@ run-pass
// Tests for epistemic bridge: EpistemicDual <-> GUMUncertainty / GUMResult
//
// Verifies that AD uncertainty propagation matches direct GUM formula (GUM §5.1):
//   u(y) = |∂f/∂x| · u(x)

use autodiff::epistemic_bridge::{
    edual_to_gum_uncertainty,
    gum_to_edual,
    edual_to_gum_result,
    gum_result_to_edual,
    edual_combine_gum,
}
use epistemic::gum::{GUMUncertainty, GUMResult, type_b_uncertainty, gum_simple}
use autodiff::epistemic_dual::EpistemicDual

// =============================================================================
// Local test helpers
// =============================================================================

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn sqrt_f(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    abs_f(a - b) < tol
}

// =============================================================================
// Test: edual_to_gum_uncertainty — GUM §5.1 propagation
// f(x) = 2x, x=5, u(x)=0.1 => u(f) = |2| * 0.1 = 0.2
// EpistemicDual: val=10, dot=2.0, unc=0.1, unc_dot=0.0
// =============================================================================

fn test_edual_to_gum_uncertainty() with Mut, Div, Panic {
    let d = EpistemicDual { val: 10.0, dot: 2.0, unc: 0.1, unc_dot: 0.0 }
    let u = edual_to_gum_uncertainty(d)
    // u.std_uncertainty = |dot| * unc = 2.0 * 0.1 = 0.2
    assert(near(u.std_uncertainty, 0.2, 1.0e-9))
    // sensitivity = dot = 2.0
    assert(near(u.sensitivity, 2.0, 1.0e-9))
    // dof = 1e9 (Type B)
    assert(near(u.degrees_of_freedom, 1.0e9, 1.0))
    print("PASS: edual_to_gum_uncertainty\n")
}

// =============================================================================
// Test: gum_to_edual — inverse direction
// GUMUncertainty{std_u=0.15, dof=1e9, sensitivity=1.0} at val=42.0
// => EpistemicDual{val=42.0, dot=1.0, unc=0.15, unc_dot=0.0}
// =============================================================================

fn test_gum_to_edual_conversion() with Mut, Div, Panic {
    let u = type_b_uncertainty(0.15)
    let d = gum_to_edual(42.0, u)
    assert(near(d.val, 42.0, 1.0e-9))
    assert(near(d.unc, 0.15, 1.0e-9))
    assert(near(d.dot, 1.0, 1.0e-9))  // sensitivity defaults to 1.0
    assert(near(d.unc_dot, 0.0, 1.0e-9))
    print("PASS: gum_to_edual\n")
}

// =============================================================================
// Test: edual_to_gum_result
// dual: val=100, dot=1.0, unc=0.2, unc_dot=0.0
// => GUMResult{value=100, std_uncertainty=0.2, expanded=1.96*0.2}
// =============================================================================

fn test_edual_to_gum_result() with Mut, Div, Panic {
    let d = EpistemicDual { val: 100.0, dot: 1.0, unc: 0.2, unc_dot: 0.0 }
    let r = edual_to_gum_result(d, 1.0e9)
    assert(near(r.value, 100.0, 1.0e-9))
    assert(near(r.std_uncertainty, 0.2, 1.0e-9))
    // expanded = k * std_unc; k_normal_95 = 1.96
    let expected_expanded = 1.96 * 0.2
    assert(near(r.expanded_uncertainty_95, expected_expanded, 1.0e-6))
    assert(near(r.coverage_factor_95, 1.96, 1.0e-9))
    print("PASS: edual_to_gum_result\n")
}

// =============================================================================
// Test: gum_result_to_edual
// Round-trip: GUMResult -> EpistemicDual
// =============================================================================

fn test_gum_result_to_edual() with Mut, Div, Panic {
    let r = gum_simple(55.0, 0.3)
    let d = gum_result_to_edual(r)
    assert(near(d.val, 55.0, 1.0e-9))
    assert(near(d.unc, 0.3, 1.0e-9))
    assert(near(d.dot, 1.0, 1.0e-9))
    assert(near(d.unc_dot, 0.0, 1.0e-9))
    print("PASS: gum_result_to_edual\n")
}

// =============================================================================
// Test: edual_combine_gum — combine two independent uncertainty contributions
// d1: dot=2.0, unc=0.1 => u1=0.2
// d2: dot=3.0, unc=0.1 => u2=0.3
// combined = sqrt(0.2^2 + 0.3^2) = sqrt(0.04 + 0.09) = sqrt(0.13)
// =============================================================================

fn test_edual_combine_gum() with Mut, Div, Panic {
    let d1 = EpistemicDual { val: 10.0, dot: 2.0, unc: 0.1, unc_dot: 0.0 }
    let d2 = EpistemicDual { val: 15.0, dot: 3.0, unc: 0.1, unc_dot: 0.0 }
    let u = edual_combine_gum(d1, d2)
    let u1 = 0.2
    let u2 = 0.3
    let expected = sqrt_f(u1 * u1 + u2 * u2)
    assert(near(u.std_uncertainty, expected, 1.0e-9))
    print("PASS: edual_combine_gum\n")
}

// =============================================================================
// Test: negative sensitivity — abs(dot) used for uncertainty magnitude
// dot = -3.0, unc = 0.05 => std_unc = |-3.0| * 0.05 = 0.15
// =============================================================================

fn test_negative_sensitivity() with Mut, Div, Panic {
    let d = EpistemicDual { val: 7.0, dot: 0.0 - 3.0, unc: 0.05, unc_dot: 0.0 }
    let u = edual_to_gum_uncertainty(d)
    assert(near(u.std_uncertainty, 0.15, 1.0e-9))
    // sensitivity carries sign (it's the partial derivative, not its absolute value)
    assert(near(u.sensitivity, 0.0 - 3.0, 1.0e-9))
    print("PASS: negative sensitivity\n")
}

// =============================================================================
// Test: zero uncertainty input => zero output uncertainty
// =============================================================================

fn test_zero_uncertainty() with Mut, Div, Panic {
    let d = EpistemicDual { val: 5.0, dot: 10.0, unc: 0.0, unc_dot: 0.0 }
    let u = edual_to_gum_uncertainty(d)
    assert(near(u.std_uncertainty, 0.0, 1.0e-15))
    print("PASS: zero uncertainty\n")
}

// =============================================================================
// Entry point
// =============================================================================

pub fn main() with Mut, Div, Panic {
    test_edual_to_gum_uncertainty()
    test_gum_to_edual_conversion()
    test_edual_to_gum_result()
    test_gum_result_to_edual()
    test_edual_combine_gum()
    test_negative_sensitivity()
    test_zero_uncertainty()
    print("All bridge tests passed.\n")
}
