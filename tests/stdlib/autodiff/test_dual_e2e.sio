//@ run-pass
// E2E test for stdlib/autodiff/dual
//
// Tests dual number arithmetic for automatic differentiation.
// Core test: f(x) = x^2, f'(3) = 6.

use autodiff::dual::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with IO, Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // Test 1: f(x) = x^2 at x=3 => f(3) = 9, f'(3) = 6
    // Compute as dual_mul(x, x) where x = dual_var(3.0)
    print("Test 1: x^2 at x=3, f=9, f'=6... ")
    let x1 = dual_var(3.0)
    let r1 = dual_mul(x1, x1)
    if check_near(r1.val, 9.0, 0.0001) && check_near(r1.dot, 6.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: f(x) = 2*x + 3 at x=5 => f(5) = 13, f'(5) = 2
    print("Test 2: 2*x+3 at x=5, f=13, f'=2... ")
    let x2 = dual_var(5.0)
    let two = dual_const(2.0)
    let three = dual_const(3.0)
    let r2 = dual_add(dual_mul(two, x2), three)
    if check_near(r2.val, 13.0, 0.0001) && check_near(r2.dot, 2.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: exp(x) at x=0 => f(0)=1, f'(0)=1
    print("Test 3: exp(0)=1, exp'(0)=1... ")
    let x3 = dual_var(0.0)
    let r3 = dual_exp(x3)
    if check_near(r3.val, 1.0, 0.001) && check_near(r3.dot, 1.0, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: sin(x) at x=0 => f(0)=0, f'(0)=cos(0)=1
    print("Test 4: sin(0)=0, sin'(0)=1... ")
    let x4 = dual_var(0.0)
    let r4 = dual_sin(x4)
    if check_near(r4.val, 0.0, 0.001) && check_near(r4.dot, 1.0, 0.001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: dual_sub: f(x) = x - 1 at x=4 => f(4)=3, f'(4)=1
    print("Test 5: x-1 at x=4, f=3, f'=1... ")
    let x5 = dual_var(4.0)
    let one = dual_const(1.0)
    let r5 = dual_sub(x5, one)
    if check_near(r5.val, 3.0, 0.0001) && check_near(r5.dot, 1.0, 0.0001) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    return run_tests()
}
