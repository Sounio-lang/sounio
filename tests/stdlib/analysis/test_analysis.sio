//@ run-pass
// Tests for stdlib/analysis/lib.sio — Numerical Analysis
//
// Covers:
//   numerical_derivative      — central difference, d/dx(x²) at x=3 ≈ 6
//   numerical_integral_trapezoid — ∫₀¹ x² dx ≈ 1/3
//   numerical_integral_simpson   — ∫₀^π sin(x) dx ≈ 2, and Simpson > trapezoid accuracy
//   richardson_extrapolation  — 4th-order accurate derivative
//   romberg_integration       — Romberg convergence on smooth functions

use analysis::{
    ConvergenceResult,
    numerical_derivative,
    numerical_integral_trapezoid,
    numerical_integral_simpson,
    richardson_extrapolation,
    romberg_integration
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn check_near(got: f64, expected: f64, tol: f64) -> bool {
    return abs_f64(got - expected) < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var pass = 0
    var fail = 0

    // ---- numerical_derivative (f_id=0: x²) ----

    // Test 1: d/dx(x²) at x=3 ≈ 6  (h=1e-4)
    let d1 = numerical_derivative(0, 3.0, 0.0001)
    if check_near(d1, 6.0, 1.0e-7) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 2: d/dx(x²) at x=0 ≈ 0
    let d2 = numerical_derivative(0, 0.0, 0.0001)
    if check_near(d2, 0.0, 1.0e-7) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 3: d/dx(x²) at x=-2 ≈ -4
    let d3 = numerical_derivative(0, 0.0 - 2.0, 0.0001)
    if check_near(d3, 0.0 - 4.0, 1.0e-7) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 4: d/dx(exp(x)) at x=0 ≈ 1  (f_id=2)
    let d4 = numerical_derivative(2, 0.0, 0.0001)
    if check_near(d4, 1.0, 1.0e-7) { pass = pass + 1 } else { fail = fail + 1 }

    // ---- numerical_integral_trapezoid (f_id=0: x², f_id=1: sin) ----

    // Test 5: ∫₀¹ x² dx = 1/3 ≈ 0.33333...  (n=1000 trapezoids)
    let t5 = numerical_integral_trapezoid(0, 0.0, 1.0, 1000)
    if check_near(t5, 0.3333333333333333, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 6: ∫₀^π sin(x) dx = 2  (n=1000 trapezoids, π≈3.14159265358979)
    let pi = 3.14159265358979323846
    let t6 = numerical_integral_trapezoid(1, 0.0, pi, 1000)
    if check_near(t6, 2.0, 1.0e-5) { pass = pass + 1 } else { fail = fail + 1 }

    // ---- numerical_integral_simpson (f_id=0: x², f_id=1: sin) ----

    // Test 7: ∫₀¹ x² dx = 1/3, Simpson exact for polynomials ≤ degree 3
    let s7 = numerical_integral_simpson(0, 0.0, 1.0, 10)
    if check_near(s7, 0.3333333333333333, 1.0e-12) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 8: ∫₀^π sin(x) dx ≈ 2  (n=100 intervals with Simpson, tolerance 1e-6
    // due to internal Taylor-series sin having finite precision)
    let s8 = numerical_integral_simpson(1, 0.0, pi, 100)
    if check_near(s8, 2.0, 1.0e-6) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 9: Simpson is more accurate than trapezoid for sin(x) on same n=100
    let trap9  = numerical_integral_trapezoid(1, 0.0, pi, 100)
    let simp9  = numerical_integral_simpson(1, 0.0, pi, 100)
    let err_trap = abs_f64(trap9 - 2.0)
    let err_simp = abs_f64(simp9 - 2.0)
    if err_simp < err_trap { pass = pass + 1 } else { fail = fail + 1 }

    // ---- richardson_extrapolation ----

    // Test 10: Richardson on x² at x=3 gives accurate 6.0 with small error estimate
    let r10 = richardson_extrapolation(0, 3.0, 0.01)
    if check_near(r10.value, 6.0, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }
    if r10.error_estimate < 1.0e-4 { pass = pass + 1 } else { fail = fail + 1 }
    if r10.iterations == 2 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 11: Richardson on exp(x) at x=1 gives accurate e ≈ 2.71828...
    let r11 = richardson_extrapolation(2, 1.0, 0.001)
    if check_near(r11.value, 2.71828182845904523536, 1.0e-7) { pass = pass + 1 } else { fail = fail + 1 }

    // ---- romberg_integration ----

    // Test 12: Romberg on x² over [0,1] converges to 1/3
    let rb12 = romberg_integration(0, 0.0, 1.0, 6)
    if check_near(rb12.value, 0.3333333333333333, 1.0e-8) { pass = pass + 1 } else { fail = fail + 1 }
    if rb12.converged == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // Test 13: Romberg on exp(x) over [0,1] → e-1 ≈ 1.71828...
    let rb13 = romberg_integration(2, 0.0, 1.0, 8)
    if check_near(rb13.value, 1.71828182845904523536, 1.0e-7) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 14: Romberg on sin(x) over [0,π] → 2 (within reasonable tolerance)
    let rb14 = romberg_integration(1, 0.0, pi, 7)
    if check_near(rb14.value, 2.0, 1.0e-7) { pass = pass + 1 } else { fail = fail + 1 }

    // Test 15: Romberg iterations are positive
    if rb12.iterations > 0 { pass = pass + 1 } else { fail = fail + 1 }

    // Summary
    if fail == 0 { 0 } else { fail }
}

fn main() -> i32 with Mut, Div, Panic {
    run_tests()
}
