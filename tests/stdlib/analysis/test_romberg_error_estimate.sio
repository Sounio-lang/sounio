//@ run-pass
//@ expect-stdout: ANALYSIS_ROMBERG_ERROR_ESTIMATE_OK
// A finite exhausted Romberg budget must retain the last observed change.
use analysis::lib::{romberg_integration}

fn main() -> i32 with IO, Mut, Div, Panic {
    let short = romberg_integration(2, 0.0, 1.0, 2)
    let next = romberg_integration(2, 0.0, 1.0, 3)
    let exact = romberg_integration(0, 0.0, 1.0, 8)
    if short.converged != 0 || short.iterations != 2 { return 1 }
    if short.error_estimate <= 0.0 { return 2 }
    if next.error_estimate <= 0.0 { return 3 }
    if next.error_estimate >= short.error_estimate { return 4 }
    if exact.converged != 1 || exact.error_estimate < 0.0 { return 5 }
    if exact.value < 0.3333333333333 || exact.value > 0.3333333333334 { return 6 }
    print("ANALYSIS_ROMBERG_ERROR_ESTIMATE_OK\n")
    return 0
}
