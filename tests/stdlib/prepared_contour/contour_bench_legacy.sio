use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use display::canvas::{Canvas,canvas_clear}
use viz::dynamic_plot::{DynamicPlotSpec}
use viz::dynamic_contour::{dynamic_contour_canvas,dynamic_contour_svg}
fn main() with IO,Alloc,Mut,Div,Panic {
 let side:i64=256
 let points=(side+1)*(side+1)
 var xs=numeric_buffer_new(side+1,(side+1)*8);var ys=numeric_buffer_new(side+1,(side+1)*8)
 var data=numeric_buffer_new(points,points*8);var levels=numeric_buffer_new(1,8)
 var mask=integer_buffer_new(side*side,side*side*8)
 var i:i64=0
 while i<=side {let a=numeric_buffer_set(&!xs,i,i as f64);let b=numeric_buffer_set(&!ys,i,i as f64);i=i+1}
 var row:i64=0
 while row<=side {
  var col:i64=0
  while col<=side {let a=numeric_buffer_set(&!data,row*(side+1)+col,(row+col) as f64);col=col+1}
  row=row+1
 }
 i=0
 while i<side*side {let a=integer_buffer_set(&!mask,i,1);i=i+1}
 let level=numeric_buffer_set(&!levels,0,(side as f64)+0.25)
 let m=numeric_matrix(points,side+1,side+1,side+1,1,0)
 let s=DynamicPlotSpec{x:0,y:0,w:256,h:256,xmin:0.0,xmax:side as f64,ymin:0.0,ymax:side as f64,r:70,g:180,b:235,interval_kind:0,level:0.0}
 let pixels=heap_alloc(257*257*8) as *mut i64
 assert((pixels as i64)>0)
 var c=Canvas{pixels:pixels,width:257,height:257}
 canvas_clear(&!c,0,0,0)
  let canvas=dynamic_contour_canvas(&!c,&s,&xs,&ys,&data,&m,&mask,&levels,side*side,side*4)
  assert(canvas.status==0)
  let svg=dynamic_contour_svg(&s,&xs,&ys,&data,&m,&mask,&levels,side*side,side*4,1)
  assert(svg.status==0 && svg.painted==canvas.painted)
  let painted:i64=svg.painted
  print("BENCH_DIRECT ");print(side);print(" ");println(painted)
 var checksum:i64=0;i=0
 while i<257*257 {checksum=(checksum+read_i64(c.pixels,i))%1000000007;i=i+1}
 print("BENCH_CANVAS ");println(checksum)
 numeric_buffer_close(xs);numeric_buffer_close(ys);numeric_buffer_close(data);numeric_buffer_close(levels);integer_buffer_close(mask)
 heap_free(c.pixels as *mut i8)
 println("PREPARED_CONTOUR_BENCH_PASS")
}
