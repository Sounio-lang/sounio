//@ run-pass
//@ requires: madaros
//@ expect-stdout: TYPE_A_BOUNDARY_OK
// Independent examples for GUM 4.2.2–4.2.3; no private field access.
use metrology::mod::{type_a_eval, type_a_is_valid, type_a_mean, type_a_stddev, type_a_uncertainty, type_a_count}

fn type_a_close(actual: f64, expected: f64, relative: f64) -> bool {
    let d = actual - expected
    let absolute = if d < 0.0 { 0.0 - d } else { d }
    absolute <= relative * expected
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var a: [f64; 16] = [0.0; 16]
    a[0] = 0.0 - 2.0
    a[1] = 0.0 - 1.0
    a[3] = 1.0
    a[4] = 2.0
    let symmetric = type_a_eval(&a, 5)
    if !type_a_is_valid(&symmetric) { return 1 }
    if type_a_count(&symmetric) != 5 || type_a_mean(&symmetric) != 0.0 { return 2 }
    if !type_a_close(type_a_stddev(&symmetric), 1.5811388300841897, 1.0e-12) { return 3 }
    if !type_a_close(type_a_uncertainty(&symmetric), 0.7071067811865475, 1.0e-12) { return 4 }

    var constant: [f64; 16] = [4.0; 16]
    let identical = type_a_eval(&constant, 16)
    if !type_a_is_valid(&identical) || type_a_mean(&identical) != 4.0 { return 5 }
    if type_a_stddev(&identical) != 0.0 || type_a_uncertainty(&identical) != 0.0 { return 6 }

    var pair: [f64; 16] = [0.0; 16]
    pair[0] = 1.0e-12
    pair[1] = 2.0e-12
    let small = type_a_eval(&pair, 2)
    if !type_a_is_valid(&small) { return 7 }
    if !type_a_close(type_a_mean(&small), 1.5e-12, 1.0e-12) { return 8 }
    if !type_a_close(type_a_uncertainty(&small), 5.0e-13, 1.0e-12) { return 9 }

    pair[0] = 0.0 - 1.0e150
    pair[1] = 1.0e150
    let large = type_a_eval(&pair, 2)
    if !type_a_is_valid(&large) { return 10 }
    if !type_a_close(type_a_uncertainty(&large), 1.0e150, 1.0e-12) { return 11 }

    // The represented variance is subnormal: test retained nonzero uncertainty,
    // not a full-precision equality claim for the already-rounded variance.
    pair[0] = 0.0 - 1.0e-161
    pair[1] = 1.0e-161
    let subnormal = type_a_eval(&pair, 16)
    if !type_a_is_valid(&subnormal) || type_a_uncertainty(&subnormal) <= 0.0 { return 12 }

    let zero_count = type_a_eval(&constant, 0)
    let one_count = type_a_eval(&constant, 1)
    let over_count = type_a_eval(&constant, 17)
    let negative_count = type_a_eval(&constant, 0 - 1)
    if type_a_is_valid(&zero_count) || type_a_is_valid(&one_count) || type_a_is_valid(&over_count) || type_a_is_valid(&negative_count) { return 13 }
    if type_a_count(&over_count) != 0 { return 14 }

    pair[0] = 1.0e308
    pair[1] = 1.0e308
    let overflow = type_a_eval(&pair, 2)
    if type_a_is_valid(&overflow) { return 15 }
    pair[0] = 0.0 - 1.0e308
    let square_overflow = type_a_eval(&pair, 2)
    if type_a_is_valid(&square_overflow) { return 16 }

    pair[0] = 0.0 - 1.0e-200
    pair[1] = 1.0e-200
    let square_underflow = type_a_eval(&pair, 2)
    if type_a_is_valid(&square_underflow) { return 17 }

    var zero: f64 = 0.0
    pair[0] = zero / zero
    let nan_input = type_a_eval(&pair, 2)
    if type_a_is_valid(&nan_input) { return 18 }
    pair[0] = 1.0 / zero
    let inf_input = type_a_eval(&pair, 2)
    if type_a_is_valid(&inf_input) { return 19 }

    print("TYPE_A_BOUNDARY_OK\n")
    0
}
