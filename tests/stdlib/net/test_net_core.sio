//@ check-only
// tests/stdlib/net/test_net_core.sio

fn assert_addr() -> bool {
    let lo = net::addr::ipv4_loopback()
    if !lo.is_loopback() { return false }
    let any = net::addr::ipv4_any()
    if !any.is_any() { return false }
    let priv_ip = net::addr::ipv4_new(192, 168, 1, 100)
    if !priv_ip.is_private() { return false }
    let addr = net::addr::socket_addr_new(net::addr::ipv4_loopback(), 8080)
    if addr.port() != 8080 { return false }
    true
}

fn assert_config() -> bool {
    let tcp = net::tcp::tcp_config_default()
    if tcp.port != 8080 { return false }
    let udp = net::udp::udp_config_default()
    if udp.max_packet_size != 65507 { return false }
    true
}

fn main() -> i32 {
    if !assert_addr() { return 1 }
    if !assert_config() { return 1 }
    if net::ffi::bindings::raw_socket_available() { return 1 }
    if net::ffi::wrapper::tcp_connect(&net::addr::socket_addr_new(net::addr::ipv4_loopback(), 8080)) >= 0 { return 1 }
    0
}
