//@ check-only
// tests/stdlib/net/test_net_core.sio

use net::addr::*
use net::tcp::*
use net::udp::*
use net::ffi::bindings::*
use net::ffi::wrapper::*

fn assert_addr() -> bool {
    let lo = ipv4_loopback()
    if !lo.is_loopback() { return false }
    let any = ipv4_any()
    if !any.is_any() { return false }
    let priv_ip = ipv4_new(192, 168, 1, 100)
    if !priv_ip.is_private() { return false }
    let sa = socket_addr_new(ipv4_loopback(), 8080)
    if sa.port() != 8080 { return false }
    true
}

fn assert_config() -> bool {
    let tcp_cfg = tcp_config_default()
    if tcp_cfg.port != 8080 { return false }
    let udp_cfg = udp_config_default()
    if udp_cfg.max_packet_size != 65507 { return false }
    true
}

fn main() -> i32 {
    if !assert_addr() { return 1 }
    if !assert_config() { return 1 }
    if raw_socket_available() { return 1 }
    if tcp_connect(127, 0, 0, 1, 8080) >= 0 { return 1 }
    if udp_send(127, 0, 0, 1, 8080, 4) { return 1 }
    0
}
