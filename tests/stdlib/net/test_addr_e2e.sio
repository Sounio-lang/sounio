//@ run-pass
//@ known-failure: Requires implementation
// E2E: stdlib/net/addr.sio — IPv4Addr, SocketAddr

use net::addr::*;

fn run_tests() -> i32 {
    // Loopback
    let lo = ipv4_loopback()
    if !lo.is_loopback() { return 1 }
    if lo.is_private() { return 2 }

    // Any
    let any = ipv4_any()
    if !any.is_any() { return 3 }

    // Custom IP
    let ip = ipv4_new(192, 168, 1, 100)
    if !ip.is_private() { return 4 }
    if ip.is_loopback() { return 5 }

    // Public IP
    let pub_ip = ipv4_new(8, 8, 8, 8)
    if pub_ip.is_private() { return 6 }
    if pub_ip.is_loopback() { return 7 }

    // to_u32
    let lo_u32 = lo.to_u32()
    // 127.0.0.1 = 127*16777216 + 1 = 2130706433
    if lo_u32 != 2130706433 { return 8 }

    // Equals
    let lo2 = ipv4_loopback()
    if !lo.equals(&lo2) { return 9 }

    // SocketAddr
    let addr = socket_addr_new(ipv4_loopback(), 8080)
    if addr.port() != 8080 { return 10 }
    if !addr.is_loopback() { return 11 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
