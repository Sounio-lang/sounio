// Deepened run-proof for stdlib math::dd64 (double-double) — the error-free-transform primitives
// and division/scalar ops left untested by test_dd64_stdlib.sio. lean_single engine.
use math::dd64::*
fn ae(a: f64, b: f64) -> f64 { if a > b { a - b } else { b - a } }
fn main() -> i32 with IO, Mut, Div, Panic {
    // Error-free two_sum: (1 + 1e-20) keeps the low bits that plain f64 addition discards.
    let s = two_sum(1.0, 1.0e-20)
    if s.hi != 1.0 { print("FAIL twosum_hi\n"); return 1 }
    let recovered = dd_to_f64(dd_sub(s, dd_from_f64(1.0)))
    if recovered < 0.9e-20 || recovered > 1.1e-20 { print("FAIL twosum_recover\n"); return 2 }
    // Contrast: plain f64 loses it entirely.
    if (1.0 + 1.0e-20) - 1.0 != 0.0 { print("FAIL f64_contrast\n"); return 3 }
    // Error-free two_prod: 3*7 = 21 exactly (no rounding remainder).
    let p = two_prod(3.0, 7.0)
    if p.hi != 21.0 { print("FAIL twoprod_hi\n"); return 4 }
    if p.lo != 0.0 { print("FAIL twoprod_lo\n"); return 5 }
    // Division carries >f64 precision: |(1/3)*3 - 1| far below f64 eps (2.2e-16).
    let third = dd_div(dd_from_f64(1.0), dd_from_f64(3.0))
    let resid = dd_to_f64(dd_abs(dd_sub(dd_mul(third, dd_from_f64(3.0)), dd_from_f64(1.0))))
    if resid >= 1.0e-25 { print("FAIL div_precision\n"); return 6 }
    // Scalar ops + neg/abs
    if ae(dd_to_f64(dd_mul_f64(dd_from_f64(2.0), 3.0)), 6.0) >= 1.0e-12 { print("FAIL mul_f64\n"); return 7 }
    if ae(dd_to_f64(dd_abs(dd_neg(dd_from_f64(5.0)))), 5.0) >= 1.0e-12 { print("FAIL abs_neg\n"); return 8 }
    // Comparators
    if dd_cmp(dd_from_f64(1.0), dd_from_f64(2.0)) != (0 - 1) { print("FAIL cmp_lt\n"); return 9 }
    if dd_cmp(dd_from_f64(2.0), dd_from_f64(1.0)) != 1 { print("FAIL cmp_gt\n"); return 10 }
    if !dd_eq(dd_from_f64(3.0), dd_from_f64(3.0)) { print("FAIL eq\n"); return 11 }
    print("DD64_DEEP_STDLIB_OK\n")
    return 0
}
