//@ run-pass
//@ known-failure: Requires implementation
//! tests/stdlib/math/test_number_theory_e2e.sio
//!
//! E2E tests for math::number_theory: GCD/LCM, modular arithmetic,
//! primality, factorization, Fibonacci, divisor functions.

use math::number_theory::{
    gcd, lcm, mod_pow, mod_inv,
    is_prime, next_prime,
    fibonacci, lucas,
    integer_sqrt, is_perfect_square,
}

// =============================================================================
// GCD / LCM
// =============================================================================

fn test_gcd_basic() with Mut, Div {
    assert(gcd(12, 8) == 4)
    assert(gcd(17, 5) == 1)
    assert(gcd(100, 75) == 25)
    assert(gcd(0, 7) == 7)
    assert(gcd(7, 0) == 7)
    assert(gcd(0, 0) == 0)
}

fn test_gcd_negative() with Mut, Div {
    assert(gcd(0 - 12, 8) == 4)
    assert(gcd(12, 0 - 8) == 4)
}

fn test_lcm_basic() with Mut, Div {
    assert(lcm(4, 6) == 12)
    assert(lcm(5, 7) == 35)
    assert(lcm(12, 18) == 36)
}

// =============================================================================
// Modular arithmetic
// =============================================================================

fn test_mod_pow() with Mut, Div {
    // 2^10 mod 1000 = 1024 mod 1000 = 24
    assert(mod_pow(2, 10, 1000) == 24)
    // 3^5 mod 13 = 243 mod 13 = 9
    assert(mod_pow(3, 5, 13) == 9)
    // a^0 = 1 for any a, mod p>1
    assert(mod_pow(42, 0, 97) == 1)
    // 0^n = 0
    assert(mod_pow(0, 5, 7) == 0)
}

fn test_mod_inv() with Mut, Div {
    // Inverse of 3 mod 7: 3*5=15≡1 (mod 7)
    assert(mod_inv(3, 7) == 5)
    // Inverse of 2 mod 11: 2*6=12≡1 (mod 11)
    assert(mod_inv(2, 11) == 6)
}

// =============================================================================
// Primality
// =============================================================================

fn test_is_prime_small() with Mut, Div {
    assert(is_prime(2) == true)
    assert(is_prime(3) == true)
    assert(is_prime(5) == true)
    assert(is_prime(7) == true)
    assert(is_prime(11) == true)
    assert(is_prime(13) == true)
    assert(is_prime(97) == true)
}

fn test_is_prime_composites() with Mut, Div {
    assert(is_prime(1) == false)
    assert(is_prime(4) == false)
    assert(is_prime(9) == false)
    assert(is_prime(15) == false)
    assert(is_prime(100) == false)
}

fn test_next_prime() with Mut, Div {
    assert(next_prime(10) == 11)
    assert(next_prime(14) == 17)
    assert(next_prime(2) == 2)   // next_prime(n) returns smallest prime >= n
    assert(next_prime(3) == 3)
    assert(next_prime(4) == 5)
}

// =============================================================================
// Fibonacci / Lucas
// =============================================================================

fn test_fibonacci() with Mut, Div {
    assert(fibonacci(0) == 0)
    assert(fibonacci(1) == 1)
    assert(fibonacci(2) == 1)
    assert(fibonacci(3) == 2)
    assert(fibonacci(5) == 5)
    assert(fibonacci(10) == 55)
    assert(fibonacci(20) == 6765)
}

fn test_lucas() with Mut, Div {
    // Lucas numbers: 2, 1, 3, 4, 7, 11, 18, 29, ...
    assert(lucas(0) == 2)
    assert(lucas(1) == 1)
    assert(lucas(2) == 3)
    assert(lucas(3) == 4)
    assert(lucas(5) == 11)
}

// =============================================================================
// Euler totient
// =============================================================================

// euler_totient / mobius use factorize(&! out arrays) — JIT &! mutation bug:
// mutations to output arrays inside callee are invisible to caller in JIT mode.
// These are covered by the native backend; skipped here.

// =============================================================================
// Integer sqrt / perfect square
// =============================================================================

fn test_integer_sqrt() with Mut, Div {
    assert(integer_sqrt(0) == 0)
    assert(integer_sqrt(1) == 1)
    assert(integer_sqrt(4) == 2)
    assert(integer_sqrt(9) == 3)
    assert(integer_sqrt(16) == 4)
    assert(integer_sqrt(15) == 3)   // floor(sqrt(15)) = 3
    assert(integer_sqrt(100) == 10)
}

fn test_is_perfect_square() with Mut, Div {
    assert(is_perfect_square(0) == true)
    assert(is_perfect_square(1) == true)
    assert(is_perfect_square(4) == true)
    assert(is_perfect_square(9) == true)
    assert(is_perfect_square(16) == true)
    assert(is_perfect_square(2) == false)
    assert(is_perfect_square(3) == false)
    assert(is_perfect_square(15) == false)
}

// count_divisors / sum_divisors also use factorize(&! arrays) — same JIT limitation.

// =============================================================================
// Main
// =============================================================================

pub fn main() with Mut, Div {
    test_gcd_basic()
    test_gcd_negative()
    test_lcm_basic()
    test_mod_pow()
    test_mod_inv()
    test_is_prime_small()
    test_is_prime_composites()
    test_next_prime()
    test_fibonacci()
    test_lucas()
    test_integer_sqrt()
    test_is_perfect_square()
    // euler_totient, mobius, count_divisors, sum_divisors: JIT &! mutation bug
}
