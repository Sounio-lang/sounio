//@ run-pass
//@ contract-adjustment: replaced deprecated *_f64 symbol expectations with current stdlib/math/core callable API
// Tests current stdlib/math/core function names.
// Note: math/core.sio does not exist; math::pure provides the canonical math functions.

use math::pure::*

fn deg_to_rad(degrees: f64) -> f64 {
    degrees * 0.017453292519943295
}

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 with Mut, Div, Panic {
    var fail = 0

    if !check_near(sqrt(4.0), 2.0, 1e-10) { fail = fail + 1 }
    if !check_near(exp(0.0), 1.0, 1e-10) { fail = fail + 1 }
    if !check_near(ln(1.0), 0.0, 1e-10) { fail = fail + 1 }
    if !check_near(sin(0.0), 0.0, 1e-10) { fail = fail + 1 }
    if !check_near(cos(0.0), 1.0, 1e-10) { fail = fail + 1 }
    if !check_near(abs(0.0 - 5.0), 5.0, 1e-10) { fail = fail + 1 }
    if !check_near(max(1.0, 2.0), 2.0, 1e-10) { fail = fail + 1 }
    if !check_near(min(1.0, 2.0), 1.0, 1e-10) { fail = fail + 1 }
    if !check_near(pow(2.0, 3.0), 8.0, 1e-10) { fail = fail + 1 }
    if !check_near(floor(1.7), 1.0, 1e-10) { fail = fail + 1 }
    if !check_near(ceil(1.3), 2.0, 1e-10) { fail = fail + 1 }
    if !check_near(deg_to_rad(180.0), pi(), 1e-10) { fail = fail + 1 }

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 with Mut, Div, Panic {
    return run_tests()
}
