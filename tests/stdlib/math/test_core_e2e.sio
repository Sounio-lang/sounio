//@ run-pass
//@ description: math::core unified extern math layer tests
/// Tests for stdlib/math/core canonical math functions
///
/// Verifies that the unified math extern layer produces correct values
/// for basic trigonometric, exponential, and utility functions.

use math::core::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn run_tests() -> i32 {
    var pass = 0
    var fail = 0

    // Test 1: sqrt_f64
    print("Test 1: sqrt_f64(4.0)=2.0... ")
    if check_near(sqrt_f64(4.0), 2.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 2: exp_f64
    print("Test 2: exp_f64(0.0)=1.0... ")
    if check_near(exp_f64(0.0), 1.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 3: ln_f64
    print("Test 3: ln_f64(1.0)=0.0... ")
    if check_near(ln_f64(1.0), 0.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 4: sin_f64 and cos_f64
    print("Test 4: sin_f64(0.0)=0.0... ")
    if check_near(sin_f64(0.0), 0.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 5: cos_f64
    print("Test 5: cos_f64(0.0)=1.0... ")
    if check_near(cos_f64(0.0), 1.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 6: abs_f64
    print("Test 6: abs_f64(-5.0)=5.0... ")
    if check_near(abs_f64(0.0 - 5.0), 5.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 7: max_f64
    print("Test 7: max_f64(1.0, 2.0)=2.0... ")
    if check_near(max_f64(1.0, 2.0), 2.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 8: min_f64
    print("Test 8: min_f64(1.0, 2.0)=1.0... ")
    if check_near(min_f64(1.0, 2.0), 1.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 9: tanh_f64
    print("Test 9: tanh_f64(0.0)=0.0... ")
    if check_near(tanh_f64(0.0), 0.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 10: sigmoid_f64
    print("Test 10: sigmoid_f64(0.0)=0.5... ")
    if check_near(sigmoid_f64(0.0), 0.5, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 11: relu_f64
    print("Test 11: relu_f64(-1.0)=0.0... ")
    if check_near(relu_f64(0.0 - 1.0), 0.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 12: relu_f64 positive
    print("Test 12: relu_f64(3.0)=3.0... ")
    if check_near(relu_f64(3.0), 3.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 13: erf_f64 at 0
    print("Test 13: erf_f64(0.0)=0.0... ")
    if check_near(erf_f64(0.0), 0.0, 1e-6) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 14: pow_f64
    print("Test 14: pow_f64(2.0, 3.0)=8.0... ")
    if check_near(pow_f64(2.0, 3.0), 8.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 15: floor_f64 and ceil_f64
    print("Test 15: floor_f64(1.7)=1.0... ")
    if check_near(floor_f64(1.7), 1.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    // Test 16: ceil_f64
    print("Test 16: ceil_f64(1.3)=2.0... ")
    if check_near(ceil_f64(1.3), 2.0, 1e-10) {
        print("PASS\n")
        pass = pass + 1
    } else {
        print("FAIL\n")
        fail = fail + 1
    }

    print("\nPassed: ")
    print(pass)
    print(" Failed: ")
    print(fail)
    print("\n")

    if fail > 0 { return 1 }
    return 0
}

fn main() -> i32 {
    run_tests()
}
