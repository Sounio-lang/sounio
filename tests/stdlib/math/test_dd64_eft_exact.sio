//@ run-pass
// validated_lane: lean_single (default/Madaros blocked by BLK-MADAROS-SEED-BEGIN,
//   see docs/audit/MADAROS_SEED_BEGIN_RECHECK_2026-07-05.md)
// T1 — EFT bit-exactness witnesses for stdlib/math/dd64.sio
//
// These checks are exact equality, not tolerance-based: TwoSum/TwoProd are
// error-free transformations and any deviation means the compiler reordered
// or contracted the float expressions (reassociation / FMA), which breaks
// the dd64 contract.  See EISA precision track, Phase 1.

use math::dd64::*

fn main() with Mut, Div, Panic, IO {
    var fails = 0

    // --- two_sum(1e16, 1.0) ---
    // ulp(1e16) = 2; 1e16 + 1 is a tie, round-to-even keeps 1e16 (even
    // mantissa), so hi == 1e16 and the error term is exactly 1.0.
    let s1 = two_sum(10000000000000000.0, 1.0)
    if s1.hi != 10000000000000000.0 { fails = fails + 1 }
    if s1.lo != 1.0 { fails = fails + 1 }

    // --- two_prod(2^27+1, 2^27+1) ---
    // (2^27+1)^2 = 2^54 + 2^28 + 1.  ulp(2^54) = 4, remainder 1 rounds down:
    // hi = 2^54 + 2^28 = 18014398777917440, lo = 1.0 exactly.
    let p1 = two_prod(134217729.0, 134217729.0)
    if p1.hi != 18014398777917440.0 { fails = fails + 1 }
    if p1.lo != 1.0 { fails = fails + 1 }

    // --- quick_two_sum(2.0, 2^-60) ---
    // fl(2 + 2^-60) = 2, so lo must carry 2^-60 exactly.
    let tiny = 1.0 / 1152921504606846976.0
    let q1 = quick_two_sum(2.0, tiny)
    if q1.hi != 2.0 { fails = fails + 1 }
    if q1.lo != tiny { fails = fails + 1 }

    // --- two_sum symmetry: order must not change the represented value ---
    let ab = two_sum(0.1, 0.2)
    let ba = two_sum(0.2, 0.1)
    if ab.hi != ba.hi { fails = fails + 1 }
    if ab.lo != ba.lo { fails = fails + 1 }

    // --- split reconstruction: hi + lo == a exactly, hi has <= 26 bits ---
    let sp = dd_split(3.141592653589793)
    if sp.hi + sp.lo != 3.141592653589793 { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: dd64 EFT bit-exact witnesses (two_sum, two_prod, quick_two_sum, split)")
}
