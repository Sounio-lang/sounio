//@ run-pass
//@ expect-stdout: HYPER_MATH_OK

use math::octonion::*
use math::sedenion::*

fn emit_metric(name: string, value: f64) with IO {
    print("HYPER_METRIC math ")
    print(name)
    print(" ")
    print(value)
    print("\n")
}

fn bool_to_f64(v: bool) -> f64 {
    if v { 1.0 } else { 0.0 }
}

fn main() -> i32 with IO, Panic {
    print("HYPER_MATH_START\n")

    let o = oct(1.0, 2.0, 3.0, 4.0, 0.0, 0.0, 0.0, 0.0)
    let op = oct_mul(o, oct_conj(o))

    let zd = sed_is_zero_divisor(sed_known_zero_divisor())
    let pair = sed_mul(sed_known_zero_divisor(), sed_complementary_zero_divisor())
    let pair_zero = sed_norm_sq(pair) < 0.000001

    emit_metric("oct_mul_real_ok", bool_to_f64(op.a > 29.9 && op.a < 30.1))
    emit_metric("sed_zero_divisor_flag", bool_to_f64(zd))
    emit_metric("sed_pair_zero_flag", bool_to_f64(pair_zero))

    if !pair_zero { return 2 }

    print("HYPER_MATH_OK\n")
    0
}
