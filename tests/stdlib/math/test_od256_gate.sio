//@ run-pass
// od256 unit-gate: exact-limb equality vs the mpmath-validated Python reference
// (scripts/ci/od256_mpmath_gate.py). All expected limbs are exact powers of two.
use math::od256::*

fn main() with Mut, Div, Panic, IO {
    var fails = 0

    // add(1,2) = 3
    let c1 = od_add(od_from_f64(1.0), od_from_f64(2.0))
    if c1.x0 != 3.0 { fails = fails + 1 }
    if c1.x1 != 0.0 { fails = fails + 1 }

    // add(2^53, 1) -> x0=2^53, x1=1 (tie-even keeps 2^53; error carries 1)
    let c2 = od_add(od_from_f64(9007199254740992.0), od_from_f64(1.0))
    if c2.x0 != 9007199254740992.0 { fails = fails + 1 }
    if c2.x1 != 1.0 { fails = fails + 1 }

    // cancellation: (1 + 2^-60) - 1 = 2^-60 recovered exactly
    let p60 = 1.0 / 1152921504606846976.0
    let c3 = od_sub(od_add(od_from_f64(1.0), od_from_f64(p60)), od_from_f64(1.0))
    if c3.x0 != p60 { fails = fails + 1 }
    if c3.x1 != 0.0 { fails = fails + 1 }

    // mul(3,5) = 15
    let c4 = od_mul(od_from_f64(3.0), od_from_f64(5.0))
    if c4.x0 != 15.0 { fails = fails + 1 }

    // mul((1+2^-27)^2) = 1 + 2^-26 + 2^-54  -> x0=1+2^-26, x1=2^-54
    let p27 = 1.0 / 134217728.0
    let u = od_add(od_from_f64(1.0), od_from_f64(p27))
    let c5 = od_mul(u, u)
    let e_x0 = 1.0 + 1.0 / 67108864.0
    let e_x1 = 1.0 / 18014398509481984.0
    if c5.x0 != e_x0 { fails = fails + 1 }
    if c5.x1 != e_x1 { fails = fails + 1 }

    // neg / abs
    let n = od_neg(od_from_f64(3.0))
    if n.x0 != 0.0 - 3.0 { fails = fails + 1 }
    if od_abs(n).x0 != 3.0 { fails = fails + 1 }

    // div (Newton reciprocal) — exact results for power-of-2 divisors
    let d1 = od_div(od_from_f64(6.0), od_from_f64(2.0))
    if d1.x0 != 3.0 { fails = fails + 1 }
    if d1.x1 != 0.0 { fails = fails + 1 }
    let d2 = od_div(od_from_f64(7.0), od_from_f64(4.0))
    if d2.x0 != 1.75 { fails = fails + 1 }
    let d3 = od_div(od_from_f64(10.0), od_from_f64(8.0))
    if d3.x0 != 1.25 { fails = fails + 1 }

    // sqrt (Newton inverse-sqrt) — exact results for perfect squares
    let s1 = od_sqrt(od_from_f64(4.0))
    if s1.x0 != 2.0 { fails = fails + 1 }
    if s1.x1 != 0.0 { fails = fails + 1 }
    let s2 = od_sqrt(od_from_f64(16.0))
    if s2.x0 != 4.0 { fails = fails + 1 }
    let s3 = od_sqrt(od_from_f64(0.25))
    if s3.x0 != 0.5 { fails = fails + 1 }
    let s4 = od_sqrt(od_from_f64(64.0))
    if s4.x0 != 8.0 { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: od256 unit-gate vs Python/mpmath reference (add/sub/mul/div/sqrt/neg/abs, exact limbs)")
}
