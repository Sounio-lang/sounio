//@ run-pass
// libm_sin / libm_cos against glibc, held to 1 ulp at points that include
// exact-double multiples of pi/2 (where the native sin/cos builtins lose ~1e-4).
// Reference bit patterns: tests/oracles/libm_trig_glibc.cpp (C++23).

use math::libm::{libm_sin, libm_cos}

fn ulp_close(got: f64, want_bits: i64) -> bool {
    let d = f64_to_bits(got) - want_bits
    d <= 1 && d >= 0 - 1
}

fn check(x: f64, sin_bits: i64, cos_bits: i64) -> i64 with IO {
    var bad: i64 = 0
    if !ulp_close(libm_sin(x), sin_bits) { print("FAIL sin at "); print_f64(x); print("\n"); bad = bad + 1 }
    if !ulp_close(libm_cos(x), cos_bits) { print("FAIL cos at "); print_f64(x); print("\n"); bad = bad + 1 }
    bad
}

fn main() -> i32 with IO, Mut {
    var fail: i64 = 0
    fail = fail + check(0.0, 0, 4607182418800017408)
    fail = fail + check(1.0e-8, 4487126258331716666, 4607182418800017408)
    fail = fail + check(0.5, 4602308182625945072, 4606079780542709072)
    fail = fail + check(0.7853981633974483, 4604544271217802188, 4604544271217802189)
    fail = fail + check(1.0, 4605754516372524270, 4603041830072026764)
    fail = fail + check(1.5707963267948966, 4607182418800017408, 4364452196894661639)
    fail = fail + check(2.0, 4606365442650518598, -4622203781984849403)
    fail = fail + check(3.0, 4594252404416238939, -4616279757631920686)
    fail = fail + check(3.141592653589793, 4368955796522032135, -4616189618054758400)
    fail = fail + check(4.71238898038469, -4616189618054758400, -4851932361532732918)
    fail = fail + check(5.0, -4616559595297400525, 4598781623568911065)
    fail = fail + check(6.283185307179586, -4849912640705373177, 4607182418800017408)
    fail = fail + check(10.0, -4620296710764933294, -4617639132858127585)
    fail = fail + check(314.1592653589793, 4386982749450322133, 4607182418800017408)
    fail = fail + check(1000.0, 4605623088326516843, 4603240679942123963)
    fail = fail + check(12345.678, -4618855016624982875, 4604571406103880888)
    fail = fail + check(1000000.0, -4623395494513026969, 4606612732610269996)
    fail = fail + check(0.0 - 1.0, -4617617520482251538, 4603041830072026764)
    fail = fail + check(0.0 - 3.141592653589793, -4854416240332743673, -4616189618054758400)
    fail = fail + check(0.0 - 1000.0, -4617748948528258965, 4603240679942123963)
    // Refusals: NaN in, and |x| >= 1e18 (the quotient would overflow i64).
    let nan = libm_sin(1.0e18)
    if nan == nan { print("FAIL sin(1e18) is not NaN\n"); fail = fail + 1 }
    let nan2 = libm_cos(0.0 - 1.0e18)
    if nan2 == nan2 { print("FAIL cos(-1e18) is not NaN\n"); fail = fail + 1 }
    if fail != 0 { return 1 }
    print("PASS\n")
    return 0
}
