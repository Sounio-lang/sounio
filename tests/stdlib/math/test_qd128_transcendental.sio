//@ run-pass
//@ expect-stdout: QD128_TRANSCENDENTAL_OK
// Run-proof for math::qd128 transcendentals (exp / log / pow / log10).
//
// This file is the cheap in-tree proof: identities, round trips, domain edges,
// and the Van't Hoff / Arrhenius / pH shapes the geochemistry model needs.
// The ACCURACY MEASUREMENT against an independent oracle is a separate thing
// and lives in tests/vectors/qd128_transcendental/ (mpmath 1.3.0 at 400 bits),
// driven by scripts/ci/qd128_transcendental_accuracy_gate.sh.
//
// Thresholds here are deliberately loose relative to what is measured (core
// corpus lands in [0.0, 3.5] quad-double ulps, i.e. <= 5.4e-64 relative): a
// run-pass gate should catch a regression, not re-measure precision.
//
// Note on literals: souc's decimal literal parser is not correctly rounded, so
// every threshold below is either applied to an exactly representable argument
// (1000.0, 10.0, 1024.0) or is loose enough that a 1-ulp parse difference in
// the input cannot reach it.
use math::qd128::*

fn relerr(got: Qd128, want: Qd128) -> f64 with Mut, Div, Panic {
    qd_to_f64(qd_div(qd_abs(qd_sub(got, want)), qd_abs(want)))
}

fn mag(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let one = qd_from_f64(1.0)

    // --- exp(0) == 1 exactly -------------------------------------------------
    if qd_eq(qd_exp(qd_zero()), one) == false {
        print("FAIL exp0\n")
        return 1
    }

    // --- round trip log(exp(x)) == x over the whole useful range ------------
    var xs: [f64; 9] = [0.0; 9]
    xs[0] = 0.0 - 500.0
    xs[1] = 0.0 - 37.5
    xs[2] = 0.0 - 1.0
    xs[3] = 0.0 - 0.25
    xs[4] = 0.25
    xs[5] = 1.0
    xs[6] = 37.5
    xs[7] = 300.0
    xs[8] = 690.0
    var i = 0
    while i < 9 {
        let x = qd_from_f64(xs[i])
        if relerr(qd_log(qd_exp(x)), x) >= 1.0e-50 {
            print("FAIL roundtrip\n")
            return 2
        }
        i = i + 1
    }

    // --- exp(log(10)) == 10 --------------------------------------------------
    let ten = qd_from_f64(10.0)
    if relerr(qd_exp(qd_log(ten)), ten) >= 1.0e-60 {
        print("FAIL explog10\n")
        return 3
    }

    // --- log10 on exactly representable powers of ten ------------------------
    if relerr(qd_log10(qd_from_f64(1000.0)), qd_from_f64(3.0)) >= 1.0e-60 {
        print("FAIL log10_1000\n")
        return 4
    }
    if relerr(qd_log10(qd_from_f64(100.0)), qd_from_f64(2.0)) >= 1.0e-60 {
        print("FAIL log10_100\n")
        return 5
    }

    // --- pow: exact integer exponent must take the binary-exponentiation path
    if qd_eq(qd_pow(qd_from_f64(2.0), qd_from_f64(10.0)), qd_from_f64(1024.0)) == false {
        print("FAIL pow_int\n")
        return 6
    }
    if qd_eq(qd_powi(qd_from_f64(2.0), 10), qd_from_f64(1024.0)) == false {
        print("FAIL powi\n")
        return 7
    }
    // negative base with an odd integer exponent stays real
    if qd_eq(qd_powi(qd_neg(qd_from_f64(2.0)), 3), qd_neg(qd_from_f64(8.0))) == false {
        print("FAIL powi_neg_base\n")
        return 8
    }
    // pow(2, 1/2) must agree with the independent sqrt path
    let half = qd_from_f64(0.5)
    if relerr(qd_pow(qd_from_f64(2.0), half), qd_sqrt(qd_from_f64(2.0))) >= 1.0e-60 {
        print("FAIL pow_sqrt\n")
        return 9
    }

    // --- ln2 / ln10 constants round trip through exp -------------------------
    if relerr(qd_exp(qd_ln2()), qd_from_f64(2.0)) >= 1.0e-60 {
        print("FAIL ln2\n")
        return 10
    }
    if relerr(qd_exp(qd_ln10()), ten) >= 1.0e-60 {
        print("FAIL ln10\n")
        return 11
    }

    // --- Van't Hoff: K(T)/K(T0) = exp(-dH/R * (1/T - 1/T0)) ------------------
    // dH = -40000 J/mol, R = 8.31446261815324 J/(mol K), T0 = 298.15 K.
    let rgas = qd_from_f64(8.31446261815324)
    let dh = qd_neg(qd_from_f64(40000.0))
    let t0 = qd_from_f64(298.15)
    let coeff = qd_neg(qd_div(dh, rgas))
    var ts: [f64; 5] = [0.0; 5]
    ts[0] = 310.0
    ts[1] = 323.15
    ts[2] = 348.0
    ts[3] = 373.15
    ts[4] = 393.0
    var j = 0
    while j < 5 {
        let t = qd_from_f64(ts[j])
        let dinv = qd_sub(qd_div(one, t), qd_div(one, t0))
        let arg = qd_mul(coeff, dinv)
        let kk = qd_exp(arg)
        // exp/log are inverse at this magnitude to quad-double precision
        if relerr(qd_log(kk), arg) >= 1.0e-50 {
            print("FAIL vant_hoff_roundtrip\n")
            return 12
        }
        // physical sanity: exothermic, so K falls as T rises above T0
        if qd_to_f64(kk) >= 1.0 {
            print("FAIL vant_hoff_monotone\n")
            return 13
        }
        j = j + 1
    }

    // --- Arrhenius: k = A exp(-Ea/(R T)), Ea = 65000 J/mol -------------------
    var tas: [f64; 3] = [0.0; 3]
    tas[0] = 298.15
    tas[1] = 348.0
    tas[2] = 393.0
    var m = 0
    while m < 3 {
        let t = qd_from_f64(tas[m])
        let arg = qd_neg(qd_div(qd_from_f64(65000.0), qd_mul(rgas, t)))
        let rate = qd_exp(arg)
        if relerr(qd_log(rate), arg) >= 1.0e-50 {
            print("FAIL arrhenius\n")
            return 14
        }
        m = m + 1
    }

    // --- pH = -log10[H+] ----------------------------------------------------
    // The literal is not exactly 1e-7 in binary64, so this is a physical bound,
    // not a precision bound; the precision measurement is in the corpus.
    let ph = qd_to_f64(qd_neg(qd_log10(qd_from_f64(1.0e-7))))
    if mag(ph - 7.0) >= 1.0e-12 {
        print("FAIL ph\n")
        return 15
    }

    // --- domain edges follow the module's finite-domain convention ----------
    if qd_eq(qd_log(qd_zero()), qd_zero()) == false {
        print("FAIL log_zero\n")
        return 16
    }
    if qd_eq(qd_log(qd_neg(one)), qd_zero()) == false {
        print("FAIL log_negative\n")
        return 17
    }
    if qd_eq(qd_log10(qd_neg(one)), qd_zero()) == false {
        print("FAIL log10_negative\n")
        return 18
    }
    if qd_eq(qd_pow(qd_neg(one), half), qd_zero()) == false {
        print("FAIL pow_negative_base_fractional\n")
        return 19
    }
    if qd_eq(qd_pow(qd_from_f64(7.0), qd_zero()), one) == false {
        print("FAIL pow_zero_exponent\n")
        return 20
    }

    print("QD128_TRANSCENDENTAL_OK\n")
    return 0
}
