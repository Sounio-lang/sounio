//@ run-pass
// validated_lane: lean_single (default/Madaros blocked by BLK-MADAROS-SEED-BEGIN,
//   see docs/audit/MADAROS_SEED_BEGIN_RECHECK_2026-07-05.md)
// T2/T3 — catastrophic cancellation witnesses for stdlib/math/dd64.sio
//
// Part A (rescue): Horner evaluation of (x-1)^4 expanded, at x = 1 + 2^-20.
//   True value 2^-80.  Plain f64 Horner loses essentially all relative
//   accuracy; dd64 recovers it to < 1e-12 relative error.
//
// Part B (honest boundary): Rump (1988) f(77617, 33096).
//   Exact value -54767/66192 = -0.827396059946821368...
//   The inner cancellation needs ~122 significand bits; dd64 carries 106,
//   so dd64 is NOT expected to produce the correct value — but it must
//   reduce the absolute error from f64's ~1e21 to below 1e5 (>16 orders of
//   magnitude), and this boundary is the measured motivation for qd128.
//
// Part C: (1e16 + pi) - 1e16 recovers pi in dd64.

use math::dd64::*

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn rump_f64() -> f64 with Div {
    let a = 77617.0
    let b = 33096.0
    let b2 = b * b
    let b4 = b2 * b2
    let b6 = b4 * b2
    let b8 = b4 * b4
    let a2 = a * a
    333.75 * b6 + a2 * (11.0 * a2 * b2 - b6 - 121.0 * b4 - 2.0) + 5.5 * b8 + a / (2.0 * b)
}

fn rump_dd() -> Dd64 with Div {
    let a = dd_from_f64(77617.0)
    let b = dd_from_f64(33096.0)
    let b2 = dd_mul(b, b)
    let b4 = dd_mul(b2, b2)
    let b6 = dd_mul(b4, b2)
    let b8 = dd_mul(b4, b4)
    let a2 = dd_mul(a, a)
    let t1 = dd_mul_f64(b6, 333.75)
    let inner1 = dd_mul_f64(dd_mul(a2, b2), 11.0)
    let inner2 = dd_sub(inner1, b6)
    let inner3 = dd_sub(inner2, dd_mul_f64(b4, 121.0))
    let inner4 = dd_sub(inner3, dd_from_f64(2.0))
    let t2 = dd_mul(a2, inner4)
    let t3 = dd_mul_f64(b8, 5.5)
    let t4 = dd_div(a, dd_mul_f64(b, 2.0))
    dd_add(dd_add(dd_add(t1, t2), t3), t4)
}

fn main() with Mut, Div, Panic, IO {
    var fails = 0

    // --- Part A: quartic rescue ---
    let x = 1.0 + 1.0 / 1048576.0
    let truth = 0.00000000000000000000000082718061255302767  // 2^-80

    let pf = ((((x - 4.0) * x + 6.0) * x - 4.0) * x) + 1.0
    let f64_rel = abs_f64((pf - truth) / truth)

    let dx = dd_from_f64(x)
    var acc = dd_from_f64(1.0)
    acc = dd_add_f64(dd_mul(acc, dx), 0.0 - 4.0)
    acc = dd_add_f64(dd_mul(acc, dx), 6.0)
    acc = dd_add_f64(dd_mul(acc, dx), 0.0 - 4.0)
    acc = dd_add_f64(dd_mul(acc, dx), 1.0)
    let dd_rel = abs_f64((dd_to_f64(acc) - truth) / truth)

    // f64 Horner is off by a large relative factor; dd64 is near machine-exact
    if f64_rel < 0.01 { fails = fails + 1 }
    if dd_rel > 0.000000000001 { fails = fails + 1 }

    // --- Part B: Rump boundary ---
    let expected = 0.0 - 0.8273960599468214
    let rf_err = abs_f64(rump_f64() - expected)
    let rd_err = abs_f64(dd_to_f64(rump_dd()) - expected)

    if rf_err < 1000000000000000.0 { fails = fails + 1 }  // f64 must be garbage (>=1e15 off)
    if rd_err > 100000.0 { fails = fails + 1 }            // dd64 must land within 1e5
    // dd64 gains at least 10 orders of magnitude over f64 on this input
    if rd_err * 10000000000.0 > rf_err { fails = fails + 1 }

    // --- Part C: additive cancellation rescue ---
    let big = 10000000000000000.0
    let pi = 3.141592653589793
    let naive = (big + pi) - big                 // loses pi's low bits in f64
    let ddres = dd_to_f64(dd_add_f64(dd_add_f64(dd_from_f64(big), pi), 0.0 - big))
    if abs_f64(ddres - pi) > 0.000000000000002 { fails = fails + 1 }
    if abs_f64(naive - pi) < abs_f64(ddres - pi) { fails = fails + 1 }

    assert(fails == 0)
    println("ALL PASS: dd64 cancellation — quartic rescued, Rump boundary characterised, additive rescue")
}
