fn main()->i32 with IO,Mut,Div,Panic {
 var good=true;var mode:i32=0
 while mode<3 {
  var K:[f64;4096]=[0.0;4096]
  var F:[f64;256]=[0.0;256]
  var answer:[f64;256]=[7.0;256]
  var fit=FEResult{u:[0.0;256],residual:0.0,iterations:0,converged:false}
  let coefficient=if mode==0 {1.0}else if mode==1 {1.0e-300}else{1.0e300}
  var i:i32=0
  while i<3 {K[i*3+i]=coefficient;F[i]=(if i==0 {-1.0}else{(i+1) as f64})*1.0e-300;i=i+1}
  fem_solve_cg(&K,&F,3,&!answer,10,1.0e-12,&!fit)
  i=0
  while i<3 {
   let fb:i64=f64_to_bits(F[i]);let kb:i64=f64_to_bits(coefficient);let ub:i64=f64_to_bits(answer[i]);let available:bool=fit.converged;let result_bits:i64=f64_to_bits(fit.u[i]);let iterations:i32=fit.iterations
   println("FEM_CG {} {} {} {} {} {} {} {}",mode,i,available,kb,fb,ub,result_bits,iterations)
   if mode<2 {if !fit.converged || answer[i]==0.0 {good=false}}
   else {if fit.converged || answer[i]!=7.0 {good=false}}
   i=i+1
  }
  mode=mode+1
 }
 assert(good)
 println("FEM_LEGACY_CG_PASS")
 0
}
