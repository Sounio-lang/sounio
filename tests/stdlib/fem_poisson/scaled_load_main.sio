use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use math::fem_checked::{fem1d_solve_into}
fn main()->i32 with Alloc,Mut,Div,Panic,IO {
 var q:f64=1.0;var j:i64=0
 while j<1074 {q=q*0.5;j=j+1}
 assert(f64_to_bits(q)==1)
 var nodes=numeric_buffer_new(3,24)
 var ea=numeric_buffer_new(2,16)
 var loads=numeric_buffer_new(2,16)
 var answer=numeric_buffer_new(3,24)
 var diag=numeric_buffer_new(3,24)
 var upper=numeric_buffer_new(3,24)
 var rhs=numeric_buffer_new(3,24)
 var trial=numeric_buffer_new(3,24)
 numeric_buffer_set(&!nodes,0,0.0);numeric_buffer_set(&!nodes,1,5.0e307);numeric_buffer_set(&!nodes,2,1.0e308)
 numeric_buffer_set(&!ea,0,1.0e308);numeric_buffer_set(&!ea,1,1.0e308)
 numeric_buffer_set(&!loads,0,q);numeric_buffer_set(&!loads,1,q)
 let fit=fem1d_solve_into(&nodes,&ea,&loads,0.0,0.0,2,&!answer,&!diag,&!upper,&!rhs,&!trial)
 let qb:i64=f64_to_bits(q);let eab:i64=f64_to_bits(numeric_buffer_at(&ea,0));let ub:i64=f64_to_bits(numeric_buffer_at(&answer,1));let rb:i64=f64_to_bits(fit.residual_max)
 println("FEM_LOAD {} {} {} {} {}",fit.status,qb,eab,ub,rb)
 assert(fit.status==0 && numeric_buffer_at(&answer,1)>0.0)
 numeric_buffer_close(nodes);numeric_buffer_close(ea);numeric_buffer_close(loads);numeric_buffer_close(answer)
 numeric_buffer_close(diag);numeric_buffer_close(upper);numeric_buffer_close(rhs);numeric_buffer_close(trial)
 println("FEM_SCALED_LOAD_PASS")
 0
}
