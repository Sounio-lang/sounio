//@ check-only
// E2E test for stdlib/signal/spectral
// Tests: PSDResult, psd_result_new, periodogram, welch_config_default, welch,
//        band_power, eeg_band_power, peak_frequency, spectral_entropy,
//        FreqBand, band_delta, band_alpha, WINDOW_HANN

use signal::spectral::*

fn run_tests() -> i32 {
    // Test 1: Create empty PSD result
    let psd = psd_result_new()
    if psd.n_freqs != 0 { return 1 }

    // Test 2: Window type constants
    let wh = WINDOW_HANN()
    if wh != 0 { return 1 }

    // Test 3: Frequency band constructors
    let delta = band_delta()
    if delta.name_code != 0 { return 1 }

    let alpha = band_alpha()
    if alpha.name_code != 2 { return 1 }

    // Test 4: Default Welch config for 1024 samples
    let cfg = welch_config_default(1024)
    if cfg.segment_length != 256 { return 1 }

    // Test 5: band_power on empty PSD should return 0
    let bp = band_power(psd, 8.0, 13.0)
    if bp != 0.0 { return 1 }

    // Test 6: spectral_entropy on empty PSD should return 0
    let se = spectral_entropy(psd, 0.5, 100.0)
    if se != 0.0 { return 1 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
