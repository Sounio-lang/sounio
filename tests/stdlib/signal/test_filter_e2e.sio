//@ check-only
//@ contract-adjustment: renamed hamming_window expectation to active flt_hamming_window symbol in signal::filter
// E2E test for stdlib/signal/filter active API.

use signal::filter::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    let bw = butterworth_lowpass(1000.0, 100.0, 2)
    if bw.order != 2 { return 1 }

    let mag_dc = iir_magnitude_response(bw, 1000.0, 10.0)
    if check_near(mag_dc, 1.0, 0.15) == false { return 1 }

    let nf = notch_filter(1000.0, 60.0, 30.0)
    if nf.order != 2 { return 1 }

    let mag_notch = iir_magnitude_response(nf, 1000.0, 60.0)
    if mag_notch > 0.15 { return 1 }

    let fir = fir_lowpass(1000.0, 100.0, 31)
    if fir.length != 31 { return 1 }

    let w_mid = flt_hamming_window(31, 15)
    if check_near(w_mid, 1.0, 0.01) == false { return 1 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
