//@ check-only
// E2E test for stdlib/signal/filter
// Tests: IIRCoeffs, FIRCoeffs, butterworth_lowpass, notch_filter, fir_lowpass,
//        iir_magnitude_response, hamming_window

use signal::filter::*

fn check_near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    return ad < tol
}

fn run_tests() -> i32 {
    // Test 1: Create a 2nd-order Butterworth lowpass at 100 Hz, fs=1000 Hz
    let bw = butterworth_lowpass(1000.0, 100.0, 2)
    // Order should be 2
    if bw.order != 2 { return 1 }

    // Test 2: Magnitude response in passband should be near 1.0
    let mag_dc = iir_magnitude_response(bw, 1000.0, 10.0)
    if check_near(mag_dc, 1.0, 0.15) == false { return 1 }

    // Test 3: Create a notch filter at 60 Hz
    let nf = notch_filter(1000.0, 60.0, 30.0)
    if nf.order != 2 { return 1 }

    // Test 4: Notch depth should be near zero at 60 Hz
    let mag_notch = iir_magnitude_response(nf, 1000.0, 60.0)
    if mag_notch > 0.15 { return 1 }

    // Test 5: Create a 31-tap FIR lowpass
    let fir = fir_lowpass(1000.0, 100.0, 31)
    if fir.length != 31 { return 1 }

    // Test 6: Hamming window at midpoint should be close to 1.0
    let w_mid = hamming_window(31, 15)
    if check_near(w_mid, 1.0, 0.01) == false { return 1 }

    return 0
}

fn main() -> i32 {
    return run_tests()
}
