//@ run-pass
//! E2E tests for signal::fractal — HFD, DFA, Permutation Entropy.

use signal::fractal::{
    higuchi_fd,
    dfa,
    permutation_entropy,
}

fn near_f64(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn test_hfd_pseudo_random() -> i32 with Mut, Div, Panic {
    var signal: [f64; 1024] = [0.0; 1024]
    var lcg: i64 = 1234567
    var i: i64 = 0
    while i < 128 {
        lcg = (lcg * 1664525 + 1013904223) - (lcg * 1664525 + 1013904223) / 1000000000 * 1000000000
        signal[i] = (lcg as f64) / 500000000.0 - 1.0
        i = i + 1
    }
    let h = higuchi_fd(&signal, 128, 8)
    if h > 1.0 { return 0 }
    return 1
}

fn test_hfd_constant() -> i32 with Mut, Div, Panic {
    var signal: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 128 { signal[i] = 1.0; i = i + 1 }
    let h = higuchi_fd(&signal, 128, 8)
    if h >= 0.0 && h < 1.0 { return 0 }
    return 2
}

fn test_dfa_white_noise() -> i32 with Mut, Div, Panic {
    var signal: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 512 {
        signal[i] = if (i - i / 2 * 2) == 0 { 1.0 } else { 0.0 - 1.0 }
        i = i + 1
    }
    let alpha = dfa(&signal, 512)
    if alpha < 1.2 { return 0 }
    return 3
}

fn test_dfa_ramp() -> i32 with Mut, Div, Panic {
    var signal: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 256 { signal[i] = i as f64; i = i + 1 }
    let alpha = dfa(&signal, 256)
    if alpha > 1.0 { return 0 }
    return 4
}

fn test_pe_mixed() -> i32 with Mut, Div, Panic {
    var signal: [f64; 1024] = [0.0; 1024]
    var k: i64 = 0
    while k < 64 {
        let r = k - (k / 4) * 4
        signal[k] = if r == 0 { 1.0 } else if r == 1 { 3.0 } else if r == 2 { 2.0 } else { 4.0 }
        k = k + 1
    }
    let pe = permutation_entropy(&signal, 64, 3)
    if pe > 0.3 { return 0 }
    return 5
}

fn test_pe_constant() -> i32 with Mut, Div, Panic {
    var signal: [f64; 1024] = [0.0; 1024]
    var i: i64 = 0
    while i < 100 { signal[i] = 7.0; i = i + 1 }
    let pe = permutation_entropy(&signal, 100, 3)
    if pe >= 0.0 && pe < 0.5 { return 0 }
    return 6
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let r1 = test_hfd_pseudo_random()
    if r1 != 0 { return r1 }
    let r2 = test_hfd_constant()
    if r2 != 0 { return r2 }
    let r3 = test_dfa_white_noise()
    if r3 != 0 { return r3 }
    let r4 = test_dfa_ramp()
    if r4 != 0 { return r4 }
    let r5 = test_pe_mixed()
    if r5 != 0 { return r5 }
    let r6 = test_pe_constant()
    if r6 != 0 { return r6 }
    return 0
}
