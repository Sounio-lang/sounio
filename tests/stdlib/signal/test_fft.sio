//@ run-pass
// Tests for stdlib/signal/fft — Cooley-Tukey FFT
//
// Test suite:
//   T1  DC signal  [1,1,1,1,0,0,0,0]: X[0]=4, X[1..7]≈0
//   T2  Pure cosine x[k]=cos(2πk/8): peaks at X[1] and X[7]
//   T3  Parseval's theorem: Σ|x[n]|² = (1/N)Σ|X[k]|²
//   T4  Inverse FFT round-trip: IFFT(FFT(x)) ≈ x  (tol 1e-5)

use signal::fft::{
    ComplexArray,
    ca_load_real,
    fft_forward,
    fft_inverse,
    fft_magnitude,
    fft_power,
    fft_cos,
    fft_pi,
    fft_sqrt,
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn near_zero(x: f64, tol: f64) -> bool {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    ax < tol
}

fn test_dc_signal() -> i32 with IO, Mut, Panic, Div {
    var data: [f64; 256] = [0.0; 256]
    var fi: i32 = 0
    while fi < 8 {
        data[fi as usize] = 1.0
        fi = fi + 1
    }

    var input: ComplexArray = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!input, &data, 8)
    fft_forward(&!input)

    if near(input.re[0], 8.0, 1.0e-8) == false { return 11 }
    if near_zero(input.im[0], 1.0e-8) == false  { return 12 }

    var k: i32 = 1
    while k < 8 {
        if near_zero(input.re[k as usize], 1.0e-8) == false { return 13 }
        if near_zero(input.im[k as usize], 1.0e-8) == false { return 14 }
        k = k + 1
    }

    return 0
}

fn test_pure_cosine() -> i32 with IO, Mut, Panic, Div {
    let n: i32 = 8
    var data: [f64; 256] = [0.0; 256]
    var k: i32 = 0
    while k < n {
        data[k as usize] = fft_cos(2.0 * fft_pi() * (k as f64) / (n as f64))
        k = k + 1
    }

    var input: ComplexArray = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!input, &data, n as i64)
    fft_forward(&!input)

    var mag: [f64; 256] = [0.0; 256]
    fft_magnitude(&input, &!mag)

    if near(mag[1], 4.0, 1.0e-4) == false { return 21 }
    if near(mag[7], 4.0, 1.0e-4) == false { return 22 }

    if near_zero(mag[0], 1.0e-2) == false { return 23 }
    var j: i32 = 2
    while j < 7 {
        if near_zero(mag[j as usize], 1.0e-2) == false { return 24 }
        j = j + 1
    }

    return 0
}

fn test_parseval() -> i32 with IO, Mut, Panic, Div {
    let n: i32 = 8
    var data: [f64; 256] = [0.0; 256]
    data[0] = 1.0
    data[1] = 2.0
    data[2] = 3.0
    data[3] = 4.0
    data[4] = 0.0
    data[5] = 0.0 - 1.0
    data[6] = 0.0 - 2.0
    data[7] = 0.0

    var e_time = 0.0
    var i: i32 = 0
    while i < n {
        let x = data[i as usize]
        e_time = e_time + x * x
        i = i + 1
    }

    var input: ComplexArray = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!input, &data, n as i64)
    fft_forward(&!input)

    var power: [f64; 256] = [0.0; 256]
    fft_power(&input, &!power)

    var e_freq = 0.0
    var k: i32 = 0
    while k < n {
        e_freq = e_freq + power[k as usize]
        k = k + 1
    }
    e_freq = e_freq / (n as f64)

    if near(e_time, e_freq, 1.0e-5) == false { return 31 }

    return 0
}

fn test_roundtrip() -> i32 with IO, Mut, Panic, Div {
    let n: i32 = 8
    var data: [f64; 256] = [0.0; 256]
    data[0] = 1.5
    data[1] = 0.0 - 0.7
    data[2] = 3.14
    data[3] = 0.0 - 2.71
    data[4] = 0.5
    data[5] = 1.0
    data[6] = 0.0 - 0.3
    data[7] = 0.9

    var input: ComplexArray = ComplexArray { re: [0.0; 256], im: [0.0; 256], n: 0 }
    ca_load_real(&!input, &data, n as i64)
    fft_forward(&!input)
    fft_inverse(&!input)

    var i: i32 = 0
    while i < n {
        if near(input.re[i as usize], data[i as usize], 1.0e-5) == false { return 41 }
        if near_zero(input.im[i as usize], 1.0e-5) == false              { return 42 }
        i = i + 1
    }

    return 0
}

fn main() -> i32 {
    let r1 = test_dc_signal()
    if r1 != 0 { return r1 }

    let r2 = test_pure_cosine()
    if r2 != 0 { return r2 }

    let r3 = test_parseval()
    if r3 != 0 { return r3 }

    let r4 = test_roundtrip()
    if r4 != 0 { return r4 }

    return 0
}
