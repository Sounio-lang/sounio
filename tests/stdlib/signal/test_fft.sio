//@ run-pass
// Tests for stdlib/signal/fft — Cooley-Tukey FFT with epistemic uncertainty
//
// Test suite:
//   T1  DC signal  [1,1,1,1,0,0,0,0]: X[0]=4, X[1..7]≈0
//   T2  Pure cosine x[k]=cos(2πk/8): peaks at X[1] and X[7]
//   T3  Parseval's theorem: Σ|x[n]|² = (1/N)Σ|X[k]|²
//   T4  Inverse FFT round-trip: IFFT(FFT(x)) ≈ x  (tol 1e-10)
//   T5  Epistemic: uniform uncertainty → non-zero propagated uncertainty

use signal::fft::{
    ComplexArray,
    EpistemicSpectrum,
    complex_array_new,
    complex_array_from_real,
    fft_forward,
    fft_inverse,
    fft_magnitude,
    fft_phase,
    fft_power_spectrum,
    fft_epistemic,
    fft_sqrt,
    fft_cos,
    fft_pi,
}

// ============================================================================
// TOLERANCE HELPERS
// ============================================================================

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    ad < tol
}

fn near_zero(x: f64, tol: f64) -> bool {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    ax < tol
}

// ============================================================================
// TEST 1: DC signal — X[0] = N, X[k≠0] = 0
// ============================================================================
// Input: all ones x[n] = 1 for n = 0..N-1.  N = 8.
// Expected: X[0] = 8.0, X[k] = 0 for k = 1..7.
// Proof: X[k] = sum_{n=0}^{N-1} exp(-2πi·k·n/N) = N·δ[k]
//        (geometric series with ratio exp(-2πi·k/N) sums to 0 for k≠0).

fn test_dc_signal() -> i32  with IO, Mut, Panic, Div{
    var data: [f64; 256] = [0.0; 256]
    var fi: i32 = 0
    while fi < 8 {
        data[fi as usize] = 1.0
        fi = fi + 1
    }

    let input = complex_array_from_real(&data, 8)
    let spec  = fft_forward(&input)

    // X[0] must equal 8.0 (sum of all samples); tol 1e-8 allows Taylor trig rounding
    if near(spec.re[0], 8.0, 1.0e-8) == false { return 11 }
    if near_zero(spec.im[0], 1.0e-8) == false  { return 12 }

    // All other bins must be near zero
    var k: i32 = 1
    while k < 8 {
        if near_zero(spec.re[k as usize], 1.0e-8) == false { return 13 }
        if near_zero(spec.im[k as usize], 1.0e-8) == false { return 14 }
        k = k + 1
    }

    return 0
}

// ============================================================================
// TEST 2: Pure cosine — x[k] = cos(2πk/N), N = 8
// ============================================================================
// DFT of cos(2πk/N) for N samples: X[1] = N/2, X[N-1] = N/2, X[others] = 0
// i.e., magnitude at bin 1 and bin 7 each = 4.0, rest ≈ 0.

fn test_pure_cosine() -> i32  with IO, Mut, Panic, Div{
    let n: i32 = 8
    var data: [f64; 256] = [0.0; 256]
    var k: i32 = 0
    while k < n {
        data[k as usize] = fft_cos(2.0 * fft_pi() * (k as f64) / (n as f64))
        k = k + 1
    }

    let input = complex_array_from_real(&data, n)
    let spec  = fft_forward(&input)
    let mag   = fft_magnitude(&spec)

    // Bins 1 and 7 (= N-1) must have magnitude 4.0 (= N/2); tol 1e-4 for Taylor trig
    if near(mag[1], 4.0, 1.0e-4) == false { return 21 }
    if near(mag[7], 4.0, 1.0e-4) == false { return 22 }

    // DC and bins 2..6 must be near zero (tolerance 1e-4 covers Taylor trig errors)
    if near_zero(mag[0], 1.0e-4) == false { return 23 }
    var j: i32 = 2
    while j < 7 {
        if near_zero(mag[j as usize], 1.0e-4) == false { return 24 }
        j = j + 1
    }

    return 0
}

// ============================================================================
// TEST 3: Parseval's theorem — energy conservation
// ============================================================================
// Σ_{n=0}^{N-1} |x[n]|² = (1/N) Σ_{k=0}^{N-1} |X[k]|²

fn test_parseval() -> i32  with IO, Mut, Panic, Div{
    let n: i32 = 8
    var data: [f64; 256] = [0.0; 256]
    // Use a mixed signal: [1, 2, 3, 4, 0, -1, -2, 0]
    data[0] = 1.0
    data[1] = 2.0
    data[2] = 3.0
    data[3] = 4.0
    data[4] = 0.0
    data[5] = 0.0 - 1.0
    data[6] = 0.0 - 2.0
    data[7] = 0.0

    // Time-domain energy
    var e_time = 0.0
    var i: i32 = 0
    while i < n {
        let x = data[i as usize]
        e_time = e_time + x * x
        i = i + 1
    }

    // Frequency-domain energy
    let input = complex_array_from_real(&data, n)
    let spec  = fft_forward(&input)
    let power = fft_power_spectrum(&spec)

    var e_freq = 0.0
    var k: i32 = 0
    while k < n {
        e_freq = e_freq + power[k as usize]
        k = k + 1
    }
    e_freq = e_freq / (n as f64)

    // Parseval: e_time == e_freq  (tolerance 1e-5 for Taylor trig rounding)
    if near(e_time, e_freq, 1.0e-5) == false { return 31 }

    return 0
}

// ============================================================================
// TEST 4: Inverse FFT round-trip
// ============================================================================
// IFFT(FFT(x)) must recover x to within 1e-10.

fn test_roundtrip() -> i32  with IO, Mut, Panic, Div{
    let n: i32 = 8
    var data: [f64; 256] = [0.0; 256]
    data[0] = 1.5
    data[1] = 0.0 - 0.7
    data[2] = 3.14
    data[3] = 0.0 - 2.71
    data[4] = 0.5
    data[5] = 1.0
    data[6] = 0.0 - 0.3
    data[7] = 0.9

    let input = complex_array_from_real(&data, n)
    let spec  = fft_forward(&input)
    let recon = fft_inverse(&spec)

    // Tolerance 1e-5: Taylor-series trig accumulates ~1e-7 per stage; 3 stages for N=8
    var i: i32 = 0
    while i < n {
        if near(recon.re[i as usize], data[i as usize], 1.0e-5) == false { return 41 }
        if near_zero(recon.im[i as usize], 1.0e-5) == false              { return 42 }
        i = i + 1
    }

    return 0
}

// ============================================================================
// TEST 5: Epistemic uncertainty propagation
// ============================================================================
// Given uniform input uncertainty σ = 0.01 on each sample:
//   - Output uncertainty must be non-zero for all bins.
//   - For a DC signal the propagated uncertainty at bin 0 should be
//     approximately sqrt(N) * σ (each butterfly adds variances in quadrature).

fn test_epistemic() -> i32  with IO, Mut, Panic, Div{
    let n: i32 = 8
    var input_re: [f64; 256] = [0.0; 256]
    var input_unc: [f64; 256] = [0.0; 256]
    let sigma = 0.01

    var i: i32 = 0
    while i < n {
        input_re[i as usize] = 1.0   // DC signal
        input_unc[i as usize] = sigma
        i = i + 1
    }

    let espec = fft_epistemic(&input_re, &input_unc, n)

    // All magnitude uncertainties must be positive (uncertainty propagated)
    var k: i32 = 0
    while k < n {
        if espec.magnitude_unc[k as usize] <= 0.0 { return 51 }
        k = k + 1
    }

    // DC bin magnitude = N = 8; uncertainty ~sqrt(N)*σ = sqrt(8)*0.01
    let expected_u0 = fft_sqrt(8.0) * sigma   // ≈ 0.02828...
    // Allow factor-of-2 tolerance — exact value depends on butterfly ordering
    let u0 = espec.magnitude_unc[0]
    if u0 < expected_u0 * 0.5 { return 52 }
    if u0 > expected_u0 * 4.0 { return 53 }

    // DC bin magnitude itself must be correct
    if near(espec.magnitude[0], 8.0, 1.0e-9) == false { return 54 }

    return 0
}

// ============================================================================
// ENTRY POINT
// ============================================================================

fn main() -> i32 {
    let r1 = test_dc_signal()
    if r1 != 0 { return r1 }

    let r2 = test_pure_cosine()
    if r2 != 0 { return r2 }

    let r3 = test_parseval()
    if r3 != 0 { return r3 }

    let r4 = test_roundtrip()
    if r4 != 0 { return r4 }

    let r5 = test_epistemic()
    if r5 != 0 { return r5 }

    return 0
}
