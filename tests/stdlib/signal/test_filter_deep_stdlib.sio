// Deepened run-proof for stdlib signal::filter — frequency-selective behaviour left untested by
// test_filter_stdlib.sio (which only checked DC gains): IIR1 step responses, IIR2 notch/bandpass
// selectivity, FIR moving average. lean_single engine.
// The 50Hz test sine (fs=1000, w=0.1*pi) is generated by a trig-free resonator
// s[n]=2cos(w) s[n-1]-s[n-2] because the module's trig helpers are private.
use signal::filter::*
// Steady-state amplitude of an IIR2 notch (center f0) responding to a 50Hz sine.
fn notch_amp_at_50(f0: f64) -> f64 with Mut, Div, Panic {
    var flt = iir2_notch(f0, 10.0, 1000.0)
    let c = 1.9021130326
    var s2 = 0.0; var s1 = 0.3090169944
    var i: i64 = 0; var amp = 0.0
    while i < 800 {
        let x = s1
        let sn = c * s1 - s2
        s2 = s1; s1 = sn
        let y = iir2_step(&!flt, x)
        if i > 500 { let ay = if y < 0.0 { 0.0 - y } else { y }; if ay > amp { amp = ay } }
        i = i + 1
    }
    return amp
}
fn bp_amp_at_50() -> f64 with Mut, Div, Panic {
    var flt = iir2_bandpass(50.0, 10.0, 1000.0)
    let c = 1.9021130326
    var s2 = 0.0; var s1 = 0.3090169944
    var i: i64 = 0; var amp = 0.0
    while i < 800 {
        let x = s1
        let sn = c * s1 - s2
        s2 = s1; s1 = sn
        let y = iir2_step(&!flt, x)
        if i > 500 { let ay = if y < 0.0 { 0.0 - y } else { y }; if ay > amp { amp = ay } }
        i = i + 1
    }
    return amp
}
fn main() -> i32 with IO, Mut, Div, Panic {
    // IIR1 lowpass step -> settles to 1 (passes DC); highpass step -> settles to 0 (blocks DC)
    var lp = iir1_lowpass(50.0, 1000.0)
    var i: i64 = 0; var ylp = 0.0
    while i < 400 { ylp = iir1_step(&!lp, 1.0); i = i + 1 }
    if ylp < 0.999 || ylp > 1.001 { print("FAIL lp_step\n"); return 1 }
    var hp = iir1_highpass(50.0, 1000.0)
    i = 0; var yhp = 0.0
    while i < 400 { yhp = iir1_step(&!hp, 1.0); i = i + 1 }
    if (if yhp < 0.0 { 0.0 - yhp } else { yhp }) >= 1.0e-6 { print("FAIL hp_step\n"); return 2 }
    // IIR2 notch: passes DC (gain ~1), rejects its own centre frequency, passes off-centre tones
    var nt = iir2_notch(50.0, 10.0, 1000.0)
    i = 0; var ydc = 0.0
    while i < 600 { ydc = iir2_step(&!nt, 1.0); i = i + 1 }
    if ydc < 0.999 || ydc > 1.001 { print("FAIL notch_dc\n"); return 3 }
    if notch_amp_at_50(50.0) >= 1.0e-3 { print("FAIL notch_reject\n"); return 4 }   // 50Hz notch kills 50Hz
    if notch_amp_at_50(200.0) < 0.9 { print("FAIL notch_pass\n"); return 5 }         // 200Hz notch passes 50Hz
    // IIR2 bandpass: blocks DC (gain ~0), passes its centre frequency
    var bpf = iir2_bandpass(50.0, 10.0, 1000.0)
    i = 0; var ybdc = 0.0
    while i < 600 { ybdc = iir2_step(&!bpf, 1.0); i = i + 1 }
    if (if ybdc < 0.0 { 0.0 - ybdc } else { ybdc }) >= 1.0e-3 { print("FAIL bp_dc\n"); return 6 }
    if bp_amp_at_50() < 0.9 { print("FAIL bp_pass\n"); return 7 }
    // FIR moving average of a constant returns the constant
    var fir = fir64_ma(4)
    i = 0; var yf = 0.0
    while i < 20 { yf = fir64_step(&!fir, 2.0); i = i + 1 }
    if (if yf < 2.0 { 2.0 - yf } else { yf - 2.0 }) >= 1.0e-9 { print("FAIL fir_ma\n"); return 8 }
    print("FILTER_DEEP_STDLIB_OK\n")
    return 0
}
