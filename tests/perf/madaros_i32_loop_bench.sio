// Codegen benchmark (not a pass/fail test; see scripts/ci/madaros_int_overflow_gate.sh
// for the deterministic gate). A 28 x 28 matrix-vector product over i32 loop
// indices, repeated, with a call in the loop body. Two Madaros codegen
// regressions made it 2.5x slower than the compiler of 2026-11-09:
//   1. the i32 range guard was a five-op IR window (shl, sar, compare, branch,
//      panic call) after every i32 + - * (SIO-588 / ADR-031 R1, PR #3526);
//   2. loop regions (PR #3564) reset the region at every iteration end through
//      `rep stosq`, even when the iteration allocated nothing.
// Run: time ./bin/souc run tests/perf/madaros_i32_loop_bench.sio
// Expected stdout: 15907500.000000
fn dot_row(a: &[f64; 784], x: &[f64; 28], row: i32) -> f64 {
  var s: f64 = 0.0
  var j: i32 = 0
  while j < 28 {
    s = s + a[row * 28 + j] * x[j]
    j = j + 1
  }
  s
}

fn main() with IO {
  var a: [f64; 784] = [0.0; 784]
  var x: [f64; 28] = [0.0; 28]
  var y: [f64; 28] = [0.0; 28]
  var k: i32 = 0
  while k < 784 {
    a[k] = ((k % 7) as f64) * 0.25
    k = k + 1
  }
  var m: i32 = 0
  while m < 28 {
    x[m] = 1.0 + (m as f64) * 0.5
    m = m + 1
  }
  var rep: i32 = 0
  var acc: f64 = 0.0
  while rep < 90000 {
    var i: i32 = 0
    while i < 28 {
      y[i] = dot_row(&a, &x, i)
      i = i + 1
    }
    acc = acc + y[rep % 28]
    rep = rep + 1
  }
  println(acc)
}
