// Test equivalent function calls: reversed order with commutative addition
fn helper(x: i64) -> i64 {
    x * 2
}

fn compute(a: i64, b: i64) -> i64 {
    helper(b) + helper(a)
}

fn main() -> i32 with IO {
    let result = compute(3, 4)
    if result == 14 {
        0
    } else {
        1
    }
}
