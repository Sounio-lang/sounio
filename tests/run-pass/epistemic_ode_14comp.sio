//@ run-pass
//@ known-failure: Missing library implementation
// Validation: 14-Compartment PBPK + GUM Epistemic ODE Pipeline
//
// Strategy:
//   Part A: Verify deterministic 14-comp PBPK with small dt (no GUM, fast)
//   Part B: Verify GUM variance propagation on exponential decay (1-comp, fast)
//   Part C: Verify 14-comp PBPK with GUM on short simulation (2h, few steps)
//
// 8 tests total

// ============================================================================
// Helpers
// ============================================================================

fn ode_sqrt(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn ode_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn ode_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn ode_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// ============================================================================
// Data Structures
// ============================================================================

struct EState { values: [f64; 64], variances: [f64; 64], n: i64 }
fn estate_new(n: i64) -> EState { EState { values: [0.0; 64], variances: [0.0; 64], n: n } }

fn estate_set(s: &!EState, idx: i64, val: f64, var_: f64) {
    if idx >= 0 && idx < 64 { s.values[idx] = val; s.variances[idx] = var_ }
}

fn estate_axpy(dst: &!EState, a: &EState, scale: f64, b: &EState) with Mut {
    var i = 0
    while i < a.n { if i < 64 { dst.values[i] = a.values[i] + scale * b.values[i] }; i = i + 1 }
    dst.n = a.n
}

fn estate_copy(dst: &!EState, src: &EState) with Mut {
    var i = 0
    while i < src.n {
        if i < 64 { dst.values[i] = src.values[i]; dst.variances[i] = src.variances[i] }
        i = i + 1
    }
    dst.n = src.n
}

struct ODEParams { params: [f64; 64], param_variances: [f64; 64], n_params: i64 }
fn ode_params_new() -> ODEParams { ODEParams { params: [0.0; 64], param_variances: [0.0; 64], n_params: 0 } }

fn ode_params_set(p: &!ODEParams, idx: i64, val: f64, var_: f64) {
    if idx >= 0 && idx < 64 { p.params[idx] = val; p.param_variances[idx] = var_; if idx >= p.n_params { p.n_params = idx + 1 } }
}

struct ODESystem { system_id: i64, n_dims: i64 }

// ============================================================================
// RHS: Exponential Decay (system_id=1)
// ============================================================================

fn rhs_exp_decay(t: f64, y: &EState, p: &ODEParams, out: &!EState) with Mut {
    let k = p.params[0]
    out.values[0] = (0.0 - k) * y.values[0]
    out.n = 1
}

// ============================================================================
// RHS: PBPK-14 (system_id=2)
// ============================================================================

fn rhs_pbpk_14(t: f64, y: &EState, p: &ODEParams, out: &!EState) with Mut, Div, Panic {
    let c_plasma = y.values[0]; let c_liver = y.values[1]; let c_gut = y.values[2]
    let c_kidney = y.values[3]; let c_lung = y.values[4]; let c_heart = y.values[5]
    let c_brain = y.values[6]; let c_muscle = y.values[7]; let c_skin = y.values[8]
    let c_fat = y.values[9]; let c_spleen = y.values[10]; let c_bone = y.values[11]
    let c_rest = y.values[12]; let a_lumen = y.values[13]

    let q_card = p.params[0]; let v_plasma = p.params[1]
    let q_liver = p.params[2]; let q_gut = p.params[3]; let q_kidney = p.params[4]
    let q_lung = p.params[5]; let q_heart = p.params[6]; let q_brain = p.params[7]
    let q_muscle = p.params[8]; let q_skin = p.params[9]; let q_fat = p.params[10]
    let q_spleen = p.params[11]; let q_bone = p.params[12]; let q_rest = p.params[13]
    let v_liver = p.params[14]; let v_gut = p.params[15]; let v_kidney = p.params[16]
    let v_lung = p.params[17]; let v_heart = p.params[18]; let v_brain = p.params[19]
    let v_muscle = p.params[20]; let v_skin = p.params[21]; let v_fat = p.params[22]
    let v_spleen = p.params[23]; let v_bone = p.params[24]; let v_rest = p.params[25]
    let kp_liver = p.params[26]; let kp_gut = p.params[27]; let kp_kidney = p.params[28]
    let kp_lung = p.params[29]; let kp_heart = p.params[30]; let kp_brain = p.params[31]
    let kp_muscle = p.params[32]; let kp_skin = p.params[33]; let kp_fat = p.params[34]
    let kp_spleen = p.params[35]; let kp_bone = p.params[36]; let kp_rest = p.params[37]
    let cl_hep = p.params[38]; let cl_renal = p.params[39]
    let ka = p.params[40]; let f_oral = p.params[41]; let fu = p.params[42]; let bp = p.params[43]

    let cv_liver = c_liver / kp_liver; let cv_gut = c_gut / kp_gut
    let cv_kidney = c_kidney / kp_kidney; let cv_lung = c_lung / kp_lung
    let cv_heart = c_heart / kp_heart; let cv_brain = c_brain / kp_brain
    let cv_muscle = c_muscle / kp_muscle; let cv_skin = c_skin / kp_skin
    let cv_fat = c_fat / kp_fat; let cv_spleen = c_spleen / kp_spleen
    let cv_bone = c_bone / kp_bone; let cv_rest = c_rest / kp_rest

    let c_arterial = cv_lung
    // Venous mixing: gut and spleen drain to portal vein (→ liver), NOT directly
    // to systemic venous pool. Only liver total outflow goes to venous.
    let c_venous = (q_liver * cv_liver + q_kidney * cv_kidney
                    + q_heart * cv_heart + q_brain * cv_brain + q_muscle * cv_muscle
                    + q_skin * cv_skin + q_fat * cv_fat
                    + q_bone * cv_bone + q_rest * cv_rest) / q_card

    out.values[13] = (0.0 - ka) * a_lumen
    out.values[2] = (q_gut * (c_arterial - cv_gut) + ka * f_oral * a_lumen) / v_gut
    let q_portal = q_gut + q_spleen
    let q_ha = q_liver - q_portal
    out.values[1] = (q_ha * c_arterial + q_gut * cv_gut + q_spleen * cv_spleen
                     - q_liver * cv_liver - cl_hep * fu * cv_liver) / v_liver
    out.values[3] = (q_kidney * (c_arterial - cv_kidney) - cl_renal * fu * cv_kidney) / v_kidney
    out.values[4] = (q_lung * (c_venous - cv_lung)) / v_lung
    out.values[5] = (q_heart * (c_arterial - cv_heart)) / v_heart
    out.values[6] = (q_brain * (c_arterial - cv_brain)) / v_brain
    out.values[7] = (q_muscle * (c_arterial - cv_muscle)) / v_muscle
    out.values[8] = (q_skin * (c_arterial - cv_skin)) / v_skin
    out.values[9] = (q_fat * (c_arterial - cv_fat)) / v_fat
    out.values[10] = (q_spleen * (c_arterial - cv_spleen)) / v_spleen
    out.values[11] = (q_bone * (c_arterial - cv_bone)) / v_bone
    out.values[12] = (q_rest * (c_arterial - cv_rest)) / v_rest
    out.values[0] = (q_card * (c_venous - c_plasma / bp)) / v_plasma
    out.n = 14
}

// ============================================================================
// RHS Dispatch
// ============================================================================

fn ode_rhs_dispatch(sys: &ODESystem, t: f64, y: &EState, p: &ODEParams, out: &!EState) with Mut, Div, Panic {
    if sys.system_id == 1 { rhs_exp_decay(t, y, p, out) }
    else if sys.system_id == 2 { rhs_pbpk_14(t, y, p, out) }
    else { out.n = y.n }
}

// ============================================================================
// RK4 Step (NO GUM — deterministic only)
// ============================================================================

fn rk4_step_det(
    sys: &ODESystem, t: f64, state: &!EState, p: &ODEParams, dt: f64
) with Mut, Div, Panic {
    let n = sys.n_dims
    var k1 = estate_new(n); var k2 = estate_new(n)
    var k3 = estate_new(n); var k4 = estate_new(n)
    var tmp = estate_new(n)

    ode_rhs_dispatch(sys, t, state, p, &!k1)
    estate_axpy(&!tmp, state, 0.5 * dt, &k1)
    ode_rhs_dispatch(sys, t + 0.5 * dt, &tmp, p, &!k2)
    estate_axpy(&!tmp, state, 0.5 * dt, &k2)
    ode_rhs_dispatch(sys, t + 0.5 * dt, &tmp, p, &!k3)
    estate_axpy(&!tmp, state, dt, &k3)
    ode_rhs_dispatch(sys, t + dt, &tmp, p, &!k4)

    var i = 0
    while i < n {
        if i < 64 {
            let dy = (k1.values[i] + 2.0 * k2.values[i] + 2.0 * k3.values[i] + k4.values[i]) / 6.0
            state.values[i] = state.values[i] + dt * dy
        }
        i = i + 1
    }
}

// ============================================================================
// GUM Jacobian + Variance Propagation (for 1-comp systems only — fast)
// ============================================================================

struct Jacobian { data: [f64; 4096], n: i64 }
fn jacobian_new(n: i64) -> Jacobian { Jacobian { data: [0.0; 4096], n: n } }

fn compute_jac_state_1d(
    sys: &ODESystem, t: f64, y: &EState, p: &ODEParams, jac: &!Jacobian
) with Mut, Div, Panic {
    let eps = 1.0e-7
    var f_plus = estate_new(1); var f_minus = estate_new(1)
    var y_pert = estate_new(1)
    y_pert.values[0] = y.values[0]; y_pert.n = 1
    let h = ode_max(eps * ode_abs(y.values[0]), eps)
    y_pert.values[0] = y.values[0] + h
    ode_rhs_dispatch(sys, t, &y_pert, p, &!f_plus)
    y_pert.values[0] = y.values[0] - h
    ode_rhs_dispatch(sys, t, &y_pert, p, &!f_minus)
    jac.data[0] = (f_plus.values[0] - f_minus.values[0]) / (2.0 * h)
    jac.n = 1
}

fn compute_jac_param_1d(
    sys: &ODESystem, t: f64, y: &EState, p: &ODEParams, jac_p: &!Jacobian
) with Mut, Div, Panic {
    let eps = 1.0e-7
    var f_plus = estate_new(1); var f_minus = estate_new(1)
    var p_pert = ode_params_new()
    p_pert.params[0] = p.params[0]; p_pert.param_variances[0] = p.param_variances[0]
    p_pert.n_params = 1
    let h = ode_max(eps * ode_abs(p.params[0]), eps)
    p_pert.params[0] = p.params[0] + h
    ode_rhs_dispatch(sys, t, y, &p_pert, &!f_plus)
    p_pert.params[0] = p.params[0] - h
    ode_rhs_dispatch(sys, t, y, &p_pert, &!f_minus)
    jac_p.data[0] = (f_plus.values[0] - f_minus.values[0]) / (2.0 * h)
    jac_p.n = 1
}

fn propagate_gum_1d(
    sys: &ODESystem, t: f64, state: &!EState, p: &ODEParams, dt: f64
) with Mut, Div, Panic {
    var jac = jacobian_new(1); var jac_p = jacobian_new(1)
    compute_jac_state_1d(sys, t, state, p, &!jac)
    compute_jac_param_1d(sys, t, state, p, &!jac_p)
    let s_y = 1.0 + dt * jac.data[0]
    let s_p = dt * jac_p.data[0]
    let new_var = s_y * s_y * state.variances[0] + s_p * s_p * p.param_variances[0]
    state.variances[0] = ode_max(new_var, 0.0)
}

fn rk4_step_gum_1d(
    sys: &ODESystem, t: f64, state: &!EState, p: &ODEParams, dt: f64
) with Mut, Div, Panic {
    rk4_step_det(sys, t, state, p, dt)
    propagate_gum_1d(sys, t, state, p, dt)
}

// ============================================================================
// PBPK-14 Parameters
// ============================================================================

fn pbpk_14_default_params() -> ODEParams with Mut {
    var p = ode_params_new()
    ode_params_set(&!p, 0, 348.0, 34.8 * 34.8)
    ode_params_set(&!p, 1, 3.0, 0.09)
    ode_params_set(&!p, 2, 80.5, 64.8)
    ode_params_set(&!p, 3, 62.6, 39.3)
    ode_params_set(&!p, 4, 69.6, 48.4)
    ode_params_set(&!p, 5, 348.0, 1211.0)
    ode_params_set(&!p, 6, 17.4, 3.0)
    ode_params_set(&!p, 7, 46.6, 21.7)
    ode_params_set(&!p, 8, 52.2, 27.2)
    ode_params_set(&!p, 9, 17.4, 3.0)
    ode_params_set(&!p, 10, 18.3, 3.3)
    ode_params_set(&!p, 11, 10.4, 1.1)
    ode_params_set(&!p, 12, 17.4, 3.0)
    ode_params_set(&!p, 13, 17.4, 3.0)
    ode_params_set(&!p, 14, 1.50, 0.0225)
    ode_params_set(&!p, 15, 1.20, 0.0144)
    ode_params_set(&!p, 16, 0.31, 0.0010)
    ode_params_set(&!p, 17, 0.50, 0.0025)
    ode_params_set(&!p, 18, 0.33, 0.0011)
    ode_params_set(&!p, 19, 1.40, 0.0196)
    ode_params_set(&!p, 20, 29.0, 8.41)
    ode_params_set(&!p, 21, 3.30, 1.09)
    ode_params_set(&!p, 22, 14.5, 21.0)
    ode_params_set(&!p, 23, 0.15, 0.0002)
    ode_params_set(&!p, 24, 4.00, 1.60)
    ode_params_set(&!p, 25, 5.30, 2.81)
    ode_params_set(&!p, 26, 5.00, 2.50)
    ode_params_set(&!p, 27, 3.00, 0.90)
    ode_params_set(&!p, 28, 3.50, 1.22)
    ode_params_set(&!p, 29, 1.20, 0.14)
    ode_params_set(&!p, 30, 2.00, 0.40)
    ode_params_set(&!p, 31, 1.50, 0.22)
    ode_params_set(&!p, 32, 1.80, 0.32)
    ode_params_set(&!p, 33, 2.50, 0.62)
    ode_params_set(&!p, 34, 12.0, 14.4)
    ode_params_set(&!p, 35, 2.00, 0.40)
    ode_params_set(&!p, 36, 1.50, 0.22)
    ode_params_set(&!p, 37, 2.00, 0.40)
    ode_params_set(&!p, 38, 10.2, 10.4)
    ode_params_set(&!p, 39, 1.20, 0.14)
    ode_params_set(&!p, 40, 0.80, 0.064)
    ode_params_set(&!p, 41, 0.27, 0.0073)
    ode_params_set(&!p, 42, 0.075, 0.0006)
    ode_params_set(&!p, 43, 1.36, 0.018)
    p
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i64 with IO, Mut, Div, Panic {
    println("==============================================================")
    println("  Epistemic ODE Solver Validation Suite")
    println("==============================================================")
    var n_pass = 0

    // ---- Part A: Deterministic 14-comp PBPK (no GUM) ----
    println("")
    println("  Part A: Deterministic 14-comp PBPK (dt=0.002h, 12000 steps, 24h)")

    let sys14 = ODESystem { system_id: 2, n_dims: 14 }
    var params = pbpk_14_default_params()
    var state14 = estate_new(14)
    estate_set(&!state14, 13, 2.0, 0.0)  // 2 mg oral, no variance

    var t = 0.0
    let dt14 = 0.002
    var step = 0
    while t < 24.0 && step < 12001 {
        let h = ode_min(dt14, 24.0 - t)
        if h <= 1.0e-15 { t = 24.0 }
        else {
            rk4_step_det(&sys14, t, &!state14, &params, h)
            t = t + h
            step = step + 1
        }
    }

    // T1: Completed
    let t1 = step > 100
    if t1 { println("  PASS T1: 14-comp RK4 completed") } else { println("  FAIL T1") }
    if t1 { n_pass = n_pass + 1 }

    // T2: Plasma concentration is reasonable (not blown up)
    let c_plasma = state14.values[0]
    println("  C_plasma at 24h: "); println(c_plasma)
    let t2 = c_plasma >= 0.0 && c_plasma < 10.0
    if t2 { println("  PASS T2: Plasma concentration reasonable") } else { println("  FAIL T2: C_plasma out of range") }
    if t2 { n_pass = n_pass + 1 }

    // T3: All tissues non-negative
    var all_nn = true
    var d = 0
    while d < 14 {
        if state14.values[d] < -1.0e-6 { all_nn = false }
        d = d + 1
    }
    if all_nn { println("  PASS T3: All tissues non-negative") } else { println("  FAIL T3") }
    if all_nn { n_pass = n_pass + 1 }

    // T4: Gut lumen absorbed
    let lumen = ode_abs(state14.values[13])
    println("  Gut lumen remaining: "); println(lumen)
    let t4 = lumen < 0.001
    if t4 { println("  PASS T4: Oral absorption complete") } else { println("  FAIL T4") }
    if t4 { n_pass = n_pass + 1 }

    // T5: Fat compartment has drug (lipophilic, high Kp_fat=12)
    let c_fat = state14.values[9]
    println("  C_fat at 24h: "); println(c_fat)
    let t5 = c_fat > 0.0
    if t5 { println("  PASS T5: Fat tissue has rapamycin (lipophilic)") } else { println("  FAIL T5") }
    if t5 { n_pass = n_pass + 1 }

    // ---- Part B: GUM on Exponential Decay (1-comp) ----
    println("")
    println("  Part B: GUM Variance on Exponential Decay (1-comp)")

    let sys1 = ODESystem { system_id: 1, n_dims: 1 }
    var p1 = ode_params_new()
    ode_params_set(&!p1, 0, 0.5, 0.01)  // k=0.5 h⁻¹, var(k)=0.01
    var s1 = estate_new(1)
    estate_set(&!s1, 0, 100.0, 4.0)  // y0=100, var(y0)=4

    t = 0.0
    let dt1 = 0.1
    step = 0
    while t < 5.0 && step < 100 {
        rk4_step_gum_1d(&sys1, t, &!s1, &p1, dt1)
        t = t + dt1
        step = step + 1
    }

    // Analytical: y(5) = 100 * exp(-0.5*5) = 100 * exp(-2.5) ≈ 8.208
    let y_final = s1.values[0]
    let v_final = s1.variances[0]
    println("  y(5h): "); println(y_final)
    println("  Var(y) at 5h: "); println(v_final)

    // T6: Value close to analytical (within 5%)
    let y_exact = 8.208  // exp(-2.5)*100
    let rel_err = ode_abs(y_final - y_exact) / y_exact
    println("  Relative error vs analytical: "); println(rel_err)
    let t6 = rel_err < 0.05
    if t6 { println("  PASS T6: RK4 matches analytical exp decay") } else { println("  FAIL T6") }
    if t6 { n_pass = n_pass + 1 }

    // T7: Variance is positive (value decays, so absolute variance may decrease,
    //     but it should remain > 0 from parameter uncertainty contribution)
    let t7 = v_final > 0.0
    if t7 { println("  PASS T7: GUM variance propagated through ODE") } else { println("  FAIL T7: Variance did not propagate") }
    if t7 { n_pass = n_pass + 1 }

    // T8: Variance is reasonable (not blown up to infinity)
    let t8 = v_final < 1.0e10
    if t8 { println("  PASS T8: Variance bounded (no blow-up)") } else { println("  FAIL T8") }
    if t8 { n_pass = n_pass + 1 }

    println("")
    println("==============================================================")
    println("  RESULT: "); println(n_pass); println(" / 8 PASS")
    println("==============================================================")
    if n_pass == 8 { 0 } else { 1 }
}
