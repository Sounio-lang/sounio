//@ run-pass
//@ requires: madaros
//@ expect-stdout: UNIT_TRANSCENDENTAL_DIMENSIONLESS_PASS
// #3549: plain scalars, cancelled units, scaled ratios and measured scalars.

unit probability;

fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let x: f64 = 1.0
    let a: m = 4.0
    let b: m = 2.0
    let zero: m = 0.0
    let distance: km = 1.0
    let p: probability = 0.0
    let measured: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let plain: f64 = exp(x)
    let ratio: f64 = exp(a / b)
    // Zero keeps this acceptance check independent of unit-scale lowering.
    let scaled_ratio: f64 = exp(zero / distance)
    let branded: f64 = exp(p)
    let projected: f64 = exp(measured.value)
    let sine: f64 = sin(a / b)
    let cosine: f64 = cos(zero / distance)
    let logarithm: f64 = log(a / b)
    // sqrt still accepts units; its dimension transformation is out of scope.
    let root: f64 = sqrt(a)
    if plain < 2.718 || plain > 2.719 { return 1 }
    if ratio < 7.389 || ratio > 7.390 { return 1 }
    if scaled_ratio != 1.0 || branded != 1.0 { return 1 }
    if projected < 2.718 || projected > 2.719 { return 1 }
    if sine < 0.909 || sine > 0.910 { return 1 }
    if cosine != 1.0 { return 1 }
    if logarithm < 0.693 || logarithm > 0.694 { return 1 }
    if root != 2.0 { return 1 }
    print("UNIT_TRANSCENDENTAL_DIMENSIONLESS_PASS\n")
    return 0
}
