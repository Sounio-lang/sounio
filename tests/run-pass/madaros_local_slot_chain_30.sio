//@ run-pass
//@ expect-stdout: LOCAL_SLOT_CHAIN_30_OK
//@ description: one function binding 30 five-field struct locals through af_scale — 1 + 30×5 scalar slots (#2318 measured a crash at 30 on a stale build)
// Regression fixture for #2318 (docs/audit/MADAROS_LOCAL_SLOT_OVERFLOW_2026-08-31.md).
// The crash reported there came from a stale local build of 2026-08-16 that the
// bin/souc wrapper preferred over the committed ELF; every committed Madaros since
// 2026-08-15 and a fresh source build print 4634 / 8046 here. Expected: 4634, 8046.
struct Aff { v: f64, c0: f64, c1: f64, c2: f64, c3: f64 }
fn af_src(v: f64, sd: f64) -> Aff { Aff { v: v, c0: sd, c1: 0.0, c2: 0.0, c3: 0.0 } }
fn af_scale(a: &Aff, k: f64) -> Aff { Aff { v: a.v * k, c0: a.c0 * k, c1: a.c1 * k, c2: a.c2 * k, c3: a.c3 * k } }
fn af_var(a: &Aff) -> f64 { a.c0 * a.c0 + a.c1 * a.c1 + a.c2 * a.c2 + a.c3 * a.c3 }
fn ph(x: f64) -> Aff with Mut, Div, Panic {
    let l1 = af_src(x, 0.0897)
    let l2 = af_scale(&l1, 1.0)
    let l3 = af_scale(&l2, 1.0)
    let l4 = af_scale(&l3, 1.0)
    let l5 = af_scale(&l4, 1.0)
    let l6 = af_scale(&l5, 1.0)
    let l7 = af_scale(&l6, 1.0)
    let l8 = af_scale(&l7, 1.0)
    let l9 = af_scale(&l8, 1.0)
    let l10 = af_scale(&l9, 1.0)
    let l11 = af_scale(&l10, 1.0)
    let l12 = af_scale(&l11, 1.0)
    let l13 = af_scale(&l12, 1.0)
    let l14 = af_scale(&l13, 1.0)
    let l15 = af_scale(&l14, 1.0)
    let l16 = af_scale(&l15, 1.0)
    let l17 = af_scale(&l16, 1.0)
    let l18 = af_scale(&l17, 1.0)
    let l19 = af_scale(&l18, 1.0)
    let l20 = af_scale(&l19, 1.0)
    let l21 = af_scale(&l20, 1.0)
    let l22 = af_scale(&l21, 1.0)
    let l23 = af_scale(&l22, 1.0)
    let l24 = af_scale(&l23, 1.0)
    let l25 = af_scale(&l24, 1.0)
    let l26 = af_scale(&l25, 1.0)
    let l27 = af_scale(&l26, 1.0)
    let l28 = af_scale(&l27, 1.0)
    let l29 = af_scale(&l28, 1.0)
    let l30 = af_scale(&l29, 1.0)
    l30
}
fn main() -> i64 with IO, Mut, Div, Panic {
    let r = ph(0.4634)
    let a = (r.v * 10000.0) as i64
    let b = (af_var(&r) * 1000000.0) as i64
    println(a)
    println(b)
    if a == 4634 && b == 8046 { println("LOCAL_SLOT_CHAIN_30_OK") } else { println("LOCAL_SLOT_CHAIN_30_BAD") }
    0
}
