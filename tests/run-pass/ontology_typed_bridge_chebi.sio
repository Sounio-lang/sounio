//@ run-pass
//@ expect-stdout: ontology typed bridge chebi OK

// Generated by scripts/ontology/generate_dontology_stubs.sh
// Drives stdlib/ontology/typed/chebi.sio: a runtime IRI for CHEBI_23367 is coerced
// to its nominal type and upcast to its parent CHEBI_24431.
// Import the bridge ONLY for ontology types (see the one-bundle rule);
// model.sio has no ontology block, so importing iri_new/owl_class_new is safe.
// Build the IRI via iri_new (not a typed constructor) so the witness works
// for bundles whose class ids are non-numeric and thus have no _ID const.

use ontology::model::{iri_new, owl_class_new}
use ontology::typed::chebi::*

fn accept_chebi_parent(x: CHEBI_24431) -> i32 { 1 }

fn main() -> i32 with IO {
    let iri = iri_new(0)
    let c = iri_as_CHEBI_23367(&iri)
    let r = accept_chebi_parent(c)
    if r != 1 { return 1 }
    let cls = owl_class_new(iri_new(0))
    let c2 = owl_class_as_CHEBI_23367(&cls)
    let r2 = accept_chebi_parent(c2)
    if r2 != 1 { return 2 }
    print("ontology typed bridge chebi OK\n")
    0
}
