//@ run-pass
//@ expect-stdout: stdlib_os_process: PASS
// Smoke test for stdlib/os/process — getpid/getppid via extern "C" stubs.
// Integer-returning extern "C" functions now use the stub mechanism,
// which issues the correct Linux syscall and returns the result in RAX.

extern "C" {
    fn getpid() -> i64
    fn getppid() -> i64
}

fn main() -> i32 with IO, Panic {
    let pid = getpid()
    if pid > 0 {
        println("stdlib_os_process: PASS")
        return 0
    }
    println("stdlib_os_process: FAIL")
    return 1
}
