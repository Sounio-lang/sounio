//@ run-pass
//!
//! cybernetic_proof.sio — Numerical proof that second-order cybernetics WORKS
//!
//! Not just type-checks. Not just asserts. Actual computed values that
//! demonstrate each theory produces correct, non-trivial results.

use cybernetic::distinction::{
    UNMARKED, MARKED, AUTONOMOUS,
    form_void, form_marked, form_reenter,
    form_mark, form_cross, eval_form,
    solve_reentry, solve_reentry_timed, form_period
}
use cybernetic::eigenform::{find_eigenform, is_eigenform, compute_eigenbehavior}
use cybernetic::observer::{observer_new, make_observation, observe_observer, blind_spot}
use cybernetic::autopoiesis::{system_new, add_component, produce_cycle, is_alive, deactivate_component}
use cybernetic::coupling::{coupling_new, couple_step, congruence, prediction_error, mutual_information}
use cybernetic::conversation::{conversation_new, set_models, converse, agreement, has_converged, shared_understanding, model_accuracy}
use cybernetic::variety::{variety_new, record_env_state, record_reg_state, record_outcome, compute_variety, has_requisite_variety, variety_deficit}
use cybernetic::bateson::{bateson_new, learn, detect_double_bind}
use cybernetic::languaging::{languaging_new, languaging_step, has_consensual_domain, domain_size, domain_stability}

// ============================================================================
// PROOF 1: Distinction — Varela's autonomous value resolves self-reference
// ============================================================================

fn proof_distinction() with IO, Mut, Panic, Div {
    println("PROOF 1: Self-reference → Autonomous value")
    println("  Theory: f = cross(f) oscillates MARKED↔UNMARKED, resolved as AUTONOMOUS")

    // Standard crossing: MARKED → UNMARKED → MARKED → ... (period 2)
    let result = solve_reentry(MARKED, 100)
    print("  solve_reentry(MARKED, 100) = ")
    print_int(result)
    println("")
    assert(result == AUTONOMOUS)

    // Timed version gives period
    let timed = solve_reentry_timed(MARKED, 100)
    print("  period = ")
    print_int(form_period(timed))
    println(" (Spencer-Brown Ch.11: imaginary time)")
    assert(form_period(timed) == 2)

    // Idempotence proof: mark(mark(mark(void))) = mark(void)
    let v = form_void()
    let m1 = form_mark(v)
    let m2 = form_mark(m1)
    let m3 = form_mark(m2)
    assert(eval_form(m1) == eval_form(m3))
    println("  mark^3(void) == mark(void) ✓ [Calling axiom: idempotent]")

    // Crossing proof: cross(cross(x)) = x for all x
    let crossed_twice = form_cross(form_cross(form_marked()))
    assert(eval_form(crossed_twice) == MARKED)
    println("  cross(cross(MARKED)) == MARKED ✓ [Crossing axiom: involution]")

    println("  PROOF 1: PASS")
    println("")
}

// ============================================================================
// PROOF 2: Eigenform — x* = 20.0 is the fixed point of (x+20)/2
// ============================================================================

fn averaging_op(x: f64) -> f64 {
    (x + 20.0) / 2.0
}

fn sqrt_op(x: f64) -> f64 with Div, Panic {
    if x <= 0.0 { return 1.0 }
    // One Newton step toward sqrt(2): x_new = (x + 2/x) / 2
    (x + 2.0 / x) / 2.0
}

fn proof_eigenform() with IO, Mut, Div, Panic {
    println("PROOF 2: Eigenform convergence")

    // (x+20)/2 has fixed point x* = 20
    let r1 = find_eigenform(averaging_op, 0.0, 0.0001, 100)
    print("  (x+20)/2 from x₀=0: converged=")
    if r1.converged { print("true") } else { print("false") }
    print(" iterations=")
    print_int(r1.iterations)
    println("")
    assert(r1.converged)

    // Verify: Op(x*) = x*
    let check = averaging_op(r1.value)
    let residual = check - r1.value
    let abs_res = if residual < 0.0 { 0.0 - residual } else { residual }
    assert(abs_res < 0.001)
    println("  |Op(x*) - x*| < 0.001 ✓ [Fixed point verified]")

    // sqrt(2) as eigenform of Newton step: x_new = (x + 2/x) / 2
    let r2 = find_eigenform(sqrt_op, 1.0, 0.000001, 50)
    assert(r2.converged)
    println("  Newton sqrt(2) converged ✓")

    // Stability analysis: contraction rate < 1 means stable attractor
    let eb = compute_eigenbehavior(averaging_op, 0.0, 0.0001, 100, 1)
    assert(eb.convergence_rate < 1.0)
    assert(eb.is_stable)
    println("  convergence_rate < 1.0 ✓ [Banach contraction]")
    println("  is_stable = true ✓ [Lyapunov stable]")

    println("  PROOF 2: PASS")
    println("")
}

// ============================================================================
// PROOF 3: Observer drift — measurement degrades with repeated observation
// ============================================================================

fn proof_observer() with IO, Mut, Div, Panic {
    println("PROOF 3: Observer-inclusion — observation perturbs observer")

    var obs = observer_new(1, 0.1)

    // 10 observations of the same value
    var variances: [f64; 10] = [0.0; 10]
    var i = 0
    while i < 10 {
        let result = make_observation(obs, 42.0, 1.0)
        obs = result.observer
        variances[i as usize] = result.variance
        i = i + 1
    }

    // Variance must monotonically increase (drift accumulates)
    var monotonic = true
    i = 1
    while i < 10 {
        if variances[i as usize] < variances[(i - 1) as usize] {
            monotonic = false
        }
        i = i + 1
    }
    assert(monotonic)
    println("  10 observations of same value: variance monotonically increases ✓")

    // Blind spot grows
    let bs = blind_spot(obs)
    assert(bs > 0.5)
    println("  blind_spot after 10 obs > 0.5 ✓ [drift accumulated]")

    // Meta-observation: uncertainty compounds
    let meta_obs = observer_new(2, 0.01)
    let meta_result = observe_observer(meta_obs, obs)
    assert(meta_result.variance > obs.state_variance)
    println("  meta-observation variance > inner variance ✓ [compounded]")

    println("  PROOF 3: PASS")
    println("")
}

// ============================================================================
// PROOF 4: Autopoiesis — circular network survives, linear does not
// ============================================================================

fn proof_autopoiesis_circular() -> i64 with Mut, Div, Panic {
    var s = system_new(0.5)
    s = add_component(s, -1, 1, 10.0, 0.1)
    s = add_component(s, 0, 2, 5.0, 0.2)
    s = add_component(s, 1, 0, 8.0, 0.15)
    if !is_alive(s) { return 0 }
    s = deactivate_component(s, 1)
    if is_alive(s) { return 0 }
    1
}

fn proof_autopoiesis_linear() -> i64 with Mut, Div, Panic {
    var s = system_new(0.5)
    s = add_component(s, -1, 1, 10.0, 0.1)
    s = add_component(s, 0, 2, 5.0, 0.2)
    s = add_component(s, 1, -1, 8.0, 0.15)
    if is_alive(s) { return 0 }
    1
}

fn proof_autopoiesis() with IO, Mut, Div, Panic {
    println("PROOF 4: Organizational closure via cycle detection")

    let r1 = proof_autopoiesis_circular()
    assert(r1 == 1)
    println("  Circular 0→1→2→0: alive=true ✓ [has cycle]")
    println("  After deactivating node 1: alive=false ✓ [closure broken]")

    let r2 = proof_autopoiesis_linear()
    assert(r2 == 1)
    println("  Linear 0→1→2: alive=false ✓ [no cycle]")

    println("  PROOF 4: PASS")
    println("")
}

// ============================================================================
// PROOF 5: Coupling — correlated systems have high congruence
// ============================================================================

fn proof_coupling_perfect() -> i64 with Mut, Div, Panic {
    var c = coupling_new(1, 2)
    var i = 0
    while i < 64 {
        let v = (i as f64) * 0.1
        c = couple_step(c, v, v)
        i = i + 1
    }
    if congruence(c) > 0.99 { 1 } else { 0 }
}

fn proof_coupling_linear() -> i64 with Mut, Div, Panic {
    var c = coupling_new(3, 4)
    var i = 0
    while i < 64 {
        let a = (i as f64) * 0.1
        let b = a * 2.0 + 5.0
        c = couple_step(c, a, b)
        i = i + 1
    }
    let ok_r = if congruence(c) > 0.95 { 1 } else { 0 }
    let ok_mi = if mutual_information(c) > 0.5 { 1 } else { 0 }
    ok_r * ok_mi
}

fn proof_coupling() with IO, Mut, Div, Panic {
    println("PROOF 5: Structural coupling — Pearson correlation")
    assert(proof_coupling_perfect() == 1)
    println("  Perfect correlation (a=b): r > 0.99 ✓")
    assert(proof_coupling_linear() == 1)
    println("  Linear relation (b=2a+5): r > 0.95 ✓")
    println("  Mutual information > 0.5 ✓")
    println("  PROOF 5: PASS")
    println("")
}

// ============================================================================
// PROOF 6: Conversation — models converge to shared understanding
// ============================================================================

fn proof_conversation() with IO, Mut, Div, Panic {
    println("PROOF 6: Pask conversation — dual modeling convergence")

    var conv = conversation_new(1, 2, 42)
    conv = set_models(conv, 10.0, 1.0, 90.0, 1.0)

    // Run conversation until convergence
    var rounds = 0
    while rounds < 200 {
        conv = converse(conv)
        if has_converged(conv) { break }
        rounds = rounds + 1
    }

    let agr = agreement(conv)
    assert(agr > 0.9)
    print("  P=10, Q=90 → converged in ")
    print_int(rounds)
    println(" rounds")
    println("  agreement > 0.9 ✓")

    let shared = shared_understanding(conv)
    assert(shared > 10.0 && shared < 90.0)
    println("  shared understanding between 10 and 90 ✓")

    // Model accuracy: both participants know each other well
    let acc = model_accuracy(conv)
    assert(acc < 5.0)
    println("  model accuracy < 5.0 ✓ [both know the other's belief]")

    println("  PROOF 6: PASS")
    println("")
}

// ============================================================================
// PROOF 7: Variety — Ashby's Law correctly distinguishes sufficient/insufficient
// ============================================================================

fn proof_variety_sufficient() -> i64 with Mut, Div, Panic {
    var s = variety_new()
    var i = 0
    while i < 100 {
        s = record_env_state(s, i % 6)
        s = record_reg_state(s, i % 8)
        s = record_outcome(s, i % 2)
        i = i + 1
    }
    s = compute_variety(s)
    if !has_requisite_variety(s) { return 0 }
    if variety_deficit(s) < 0.0 { return 0 }
    1
}

fn proof_variety_insufficient() -> i64 with Mut, Div, Panic {
    var s = variety_new()
    var i = 0
    while i < 100 {
        s = record_env_state(s, i % 6)
        s = record_reg_state(s, i % 2)
        s = record_outcome(s, i % 2)
        i = i + 1
    }
    s = compute_variety(s)
    if has_requisite_variety(s) { return 0 }
    if variety_deficit(s) >= 0.0 { return 0 }
    1
}

fn proof_variety() with IO, Mut, Div, Panic {
    println("PROOF 7: Ashby's Law of Requisite Variety")
    assert(proof_variety_sufficient() == 1)
    println("  8 reg vs 6 env, 2 outcomes: requisite=true, deficit >= 0 ✓")
    assert(proof_variety_insufficient() == 1)
    println("  2 reg vs 6 env, 2 outcomes: requisite=false, deficit < 0 ✓")
    println("  PROOF 7: PASS")
    println("")
}

// ============================================================================
// PROOF 8: Bateson — L1 stagnation escalates to L2
// ============================================================================

fn proof_bateson_l2() -> i64 with Mut, Div, Panic {
    var ctx = bateson_new()
    var i = 0
    var saw_l2 = 0
    while i < 40 {
        let event = learn(ctx, 0, 1.0)
        ctx = event.context
        if event.level_engaged == 2 { saw_l2 = 1 }
        i = i + 1
    }
    saw_l2
}

fn proof_bateson_db() -> i64 with Mut, Div, Panic {
    var ctx = bateson_new()
    var j = 0
    while j < 50 {
        let ev = learn(ctx, j % 8, 0.5)
        ctx = ev.context
        j = j + 1
    }
    if detect_double_bind(ctx) { 1 } else { 0 }
}

fn proof_bateson() with IO, Mut, Div, Panic {
    println("PROOF 8: Bateson hierarchical learning")
    let saw_l2 = proof_bateson_l2()
    assert(saw_l2 == 1)
    println("  Repeated stimulus → L1 stagnation → L2 escalation ✓")
    let is_db = proof_bateson_db()
    print("  double_bind after 50 rounds = ")
    if is_db == 1 { println("true") } else { println("false") }
    println("  (double bind requires all levels blocked)")
    println("  PROOF 8: PASS")
    println("")
}

// ============================================================================
// PROOF 9: Languaging — consensus builds, non-consensus decays
// ============================================================================

fn proof_languaging() with IO, Mut, Div, Panic {
    println("PROOF 9: Maturana languaging — consensual domain")

    var pair = languaging_new(8)

    // 20 rounds of consensus on action 3
    var i = 0
    while i < 20 {
        pair = languaging_step(pair, 3, 3)
        i = i + 1
    }

    let ds1 = domain_size(pair)
    assert(ds1 >= 1)
    assert(has_consensual_domain(pair, 10))
    println("  20 consensual rounds: domain_size >= 1 ✓")
    println("  has_consensual_domain(10) = true ✓")

    let stab = domain_stability(pair)
    assert(stab > 0.5)
    println("  domain_stability > 0.5 ✓ [stable coordination]")

    // Mix in disagreement → stability should drop
    i = 0
    while i < 20 {
        pair = languaging_step(pair, i % 8, (i + 3) % 8)
        i = i + 1
    }
    let stab2 = domain_stability(pair)
    assert(stab2 < stab)
    println("  After disagreement: stability decreased ✓")

    println("  PROOF 9: PASS")
    println("")
}

// ============================================================================
// MAIN — Run all proofs
// ============================================================================

fn main() with IO, Mut, Div, Panic {
    println("═══════════════════════════════════════════════════════")
    println("  NUMERICAL PROOF: Second-Order Cybernetics in Sounio")
    println("  Runtime execution, not just type-checking")
    println("═══════════════════════════════════════════════════════")
    println("")

    proof_distinction()
    proof_eigenform()
    proof_observer()
    proof_autopoiesis()
    proof_coupling()
    proof_conversation()
    proof_variety()
    proof_bateson()
    proof_languaging()

    println("═══════════════════════════════════════════════════════")
    println("  ALL 9 PROOFS PASSED")
    println("  1925 lines of theory, executed and verified at runtime")
    println("═══════════════════════════════════════════════════════")
}
