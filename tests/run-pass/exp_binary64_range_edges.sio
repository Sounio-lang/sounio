//@ run-pass
//@ requires: madaros
//@ description: exp(x) at the edges of the binary64 range. NaN returns NaN, x above 709.782712893383973 returns +inf, x at or below -745.133219101941217 returns +0, and the subnormal results between -708.4 and -745.13 are produced by rounding once, not by adding n to the exponent field. Before the fix exp(-745), exp(-800) and exp(-1e19) printed -9223372036854775808 and exp(800) printed -0. Expected bits: tests/oracles/exp_binary64_range_edges.cpp ((double)expl(x), x87 long double, generated with the input list); finite non-zero results within 1 ulp.
//@ expect-stdout: EXP_BINARY64_RANGE_EDGES_OK

// The inputs are read from an array inside a loop so that no exp call can be
// folded at compile time: the code under test is the emitted builtin.
fn main() -> i32 with IO, Mut, Panic, Div {
    var bad: i64 = 0
    let xs: [i64; 33] = [0, 4607182418800017408, -4616189618054758400, 4621819117588971520, -4574003555920248832, 4649368480934526976, 4649447645771726848, 4649451428091726397, 4649452043818237952, 4649453803036842394, 4649454530587146735, 4649454530587146736, 4652007308841189376, 4891288408196988160, -4573930548348164506, -4573929756699792507, -4573929668738862285, -4573915594990026752, -4573827634059804672, -4573735275083071488, -4573651712199360512, -4573616527827271680, -4573612657546341908, -4573607731734249472, -4573606852124947251, -4573606559926636463, -4573606559926636462, -4573606559926636461, -4573123946618028032, -4526534890170089472, -4332083628657787648, 9218868437227405312, -4503599627370496]
    let want: [i64; 33] = [4607182418800017408, 4613303445314885481, 4600298746774613816, 4671783802770883936, 58915316498509951, 9155136748776909966, 9213593174447348891, 9216191307889332823, 9216650289746202825, 9218153404534156820, 9218868437227405098, 9218868437227405312, 9218868437227405312, 9218868437227405312, 4959453367363491, 4532599094331755, 4487498979794825, 906010418525123, 41132809365, 1132652, 85, 2, 1, 1, 1, 1, 0, 0, 0, 0, 0, 9218868437227405312, 0]
    let n: i64 = 33
    var i: i64 = 0
    while i < n {
        let x = bits_to_f64(xs[i as usize])
        let g = f64_to_bits(exp(x))
        let w = want[i as usize]
        var gap = g - w
        if gap < 0 { gap = 0 - gap }
        // +0 and +inf are exact; a finite non-zero result may sit one ulp away.
        let exact = w == 0 || w == 9218868437227405312
        if (exact && gap != 0) || gap > 1 || g < 0 {
            print("FAIL exp(") print_f64(x) print(") got=") print_int(g) print(" want=") print_int(w) print("\n")
            bad = bad + 1
        }
        i = i + 1
    }
    var nan_bits: i64 = 9221120237041090560
    if bad < 0 { nan_bits = 0 }
    let qnan = exp(bits_to_f64(nan_bits))
    if qnan == qnan {
        print("FAIL exp(NaN) is not NaN\n")
        bad = bad + 1
    }
    if bad > 0 { return 1 }
    print("EXP_BINARY64_RANGE_EDGES_OK\n")
    0
}
