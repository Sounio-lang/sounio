//@ run-pass
//@ expect-stdout: UNINIT_STRUCT_ARRAY_FIELD_OK
// #2966 (every gen2 `build` trapped in nc_flat_data_prepare_into): `var out: S`
// with no initializer allocated the struct but left each `[T; N]` field as
// handle 0, so `out.bytes[i] = ..` trapped on the null handle (string_table_new
// builds the .data table this way). lean_single lays the array inline, zeroed.
// Both the local and the global form now get zeroed array storage.
struct Tab {
    bytes: [i8; 64],
    words: [i64; 4],
    len: i64,
}

var G: Tab

fn tab_new() -> Tab with Mut {
    var out: Tab
    out.len = 0
    out
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var t = tab_new()
    let z = (t.bytes[3] as i64) + t.words[2]
    t.bytes[3] = 30
    t.words[2] = 10
    t.len = 1
    var u = t
    G.bytes[5] = 1
    G.words[1] = 1
    let s = z + (u.bytes[3] as i64) + u.words[2] + u.len + (G.bytes[5] as i64) + G.words[1]
    if s == 43 {
        println("UNINIT_STRUCT_ARRAY_FIELD_OK")
        return 0
    }
    print("UNINIT_STRUCT_ARRAY_FIELD_FAIL s=")
    print_int(s)
    println("")
    return 1
}
