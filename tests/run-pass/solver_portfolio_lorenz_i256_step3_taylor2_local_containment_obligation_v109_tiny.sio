//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v109 smoke for Lorenz i256 step-3 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2011
    receipt_fp = mix(receipt_fp, 360827572, 6007)
    receipt_fp = mix(receipt_fp, 456885748, 6007)
    receipt_fp = mix(receipt_fp, 79263008, 6007)
    receipt_fp = mix(receipt_fp, 324233200, 6007)
    receipt_fp = mix(receipt_fp, 437221035, 6007)
    receipt_fp = mix(receipt_fp, 143039100, 6007)
    receipt_fp = mix(receipt_fp, 570821279, 6007)
    receipt_fp = mix(receipt_fp, 420821728, 6007)
    receipt_fp = mix(receipt_fp, 3, 6007)
    receipt_fp = mix(receipt_fp, 13, 6007)
    receipt_fp = mix(receipt_fp, 255, 6007)
    if receipt_fp != 280440446 { return 1 }

    var audit_fp: i64 = 2017
    audit_fp = mix(audit_fp, receipt_fp, 6011)
    audit_fp = mix(audit_fp, 360827572, 6011)
    audit_fp = mix(audit_fp, 456885748, 6011)
    audit_fp = mix(audit_fp, 35554032, 6011)
    audit_fp = mix(audit_fp, 16664327, 6011)
    audit_fp = mix(audit_fp, 420916049, 6011)
    audit_fp = mix(audit_fp, 731007955, 6011)
    audit_fp = mix(audit_fp, 437221035, 6011)
    audit_fp = mix(audit_fp, 3, 6011)
    audit_fp = mix(audit_fp, 13, 6011)
    audit_fp = mix(audit_fp, 255, 6011)
    if audit_fp != 300531949 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 112, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 112, 1103)
    if entry_fp != 896565841 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 109, 1151)
    manifest_fp = mix(manifest_fp, 113, 1151)
    manifest_fp = mix(manifest_fp, 324233200, 1151)
    manifest_fp = mix(manifest_fp, 79263008, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 427093525 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 109, 1871)
    result_fp = mix(result_fp, 113, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 101, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 235684689 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 109, 1907)
    family_fp = mix(family_fp, 113, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 96, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 862894457 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 109, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 923119767 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 109, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 880977452 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 109, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 780008796 { return 9 }
    return 0
