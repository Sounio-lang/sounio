//@ run-pass
//@ expect-stdout: PASS: spilled local array

fn main() -> i32 with IO, Mut, Panic {
    var weights: [f64; 65536] = [0.0; 65536]
    weights[0] = 1.0
    weights[65535] = 2.0
    let sum = weights[0] + weights[65535]
    if sum > 2.9 && sum < 3.1 { println("PASS: spilled local array") }
    else { println("FAIL") }
    0
}
