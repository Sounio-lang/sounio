//@ run-pass
//@ expect-stdout: PLACE_COPY_MOVE_LAST_USE_OK
// SIO-278 value-copies `var c = p.s` when `s` holds a fixed array. The copy is
// elided only when it cannot be observed: `p` was bound by a call in the same
// block and is never mentioned again (move on last use, lower_place_move_ok).
// Each case below checks one side of that rule; every copy that IS observable
// must still happen.
struct Inner { arr: [i64; 4], k: i64 }
struct Outer { s: Inner, tag: i64 }

fn mk(v: i64) -> Outer with Mut, Panic, Div { Outer { s: Inner { arr: [v; 4], k: v }, tag: v } }

// 1. Move: `p` dies here, so `c` may take the field itself.
fn moved() -> i64 with Mut, Panic, Div {
    let p = mk(5)
    var c = p.s
    c.arr[0] = 9
    c.arr[0] + c.k
}

// 2. `p` is read after `c` is written: the copy is observable and must stay.
fn owner_read_later() -> i64 with Mut, Panic, Div {
    let p = mk(1)
    var c = p.s
    c.arr[0] = 70
    p.s.arr[0] + c.arr[0]
}

// 3. `p` is bound outside the loop: every iteration must see the original.
fn owner_outside_loop() -> i64 with Mut, Panic, Div {
    let p = mk(2)
    var acc: i64 = 0
    var i: i64 = 0
    while i < 3 {
        var c = p.s
        c.arr[0] = c.arr[0] + 10
        acc = acc + c.arr[0]
        i = i + 1
    }
    acc
}

// 5. Last use of the FIELD: `.0` moves even though `.1` is read afterwards
//    (Madaros's `let pair = self.check_x(..); var c = pair.0; let ty = pair.1`).
fn mk_pair(v: i64) -> (Inner, i64) with Mut, Panic, Div { (Inner { arr: [v; 4], k: v }, v * 10) }

fn tuple_moved() -> i64 with Mut, Panic, Div {
    let t = mk_pair(4)
    var c = t.0
    let n = t.1
    c.arr[1] = 6
    c.arr[1] + n
}

// 6. `t.0` is read again after the binding is written: the copy stays, so the
//    write is not visible through `t.0` (as in lean_single).
fn tuple_reread_after_move() -> i64 with Mut, Panic, Div {
    let t = mk_pair(2)
    var c = t.0
    c.arr[0] = 42
    t.0.arr[0] + t.1
}

// 7. Named field, the `pair.checker` / `pair.seen` shape: `p.s` moves while
//    `p.tag` is read afterwards.
fn named_field_moved() -> i64 with Mut, Panic, Div {
    let p = mk(7)
    var c = p.s
    let tag = p.tag
    c.arr[2] = 1
    c.arr[2] + tag
}

// 4. `p` comes from a struct literal, not a call: keep the copy.
fn owner_from_literal() -> i64 with Mut, Panic, Div {
    var p = Outer { s: Inner { arr: [3; 4], k: 3 }, tag: 3 }
    let c = p.s
    p.s.arr[0] = 99
    c.arr[0]
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = moved()               // 9 + 5 = 14
    let b = owner_read_later()    // 1 + 70 = 71
    let d = owner_outside_loop()  // 12 * 3 = 36
    let e = owner_from_literal()  // 3
    let g = tuple_moved()         // 6 + 40 = 46
    let h = tuple_reread_after_move() // 2 + 20 = 22
    let m = named_field_moved()   // 1 + 7 = 8
    if a == 14 && b == 71 && d == 36 && e == 3 && g == 46 && h == 22 && m == 8 {
        println("PLACE_COPY_MOVE_LAST_USE_OK")
    } else {
        print("PLACE_COPY_MOVE_LAST_USE_BAD ")
        print_int(a)
        print(" ")
        print_int(b)
        print(" ")
        print_int(d)
        print(" ")
        print_int(e)
        print(" ")
        print_int(g)
        print(" ")
        print_int(h)
        print(" ")
        print_int(m)
        println("")
    }
    0
}
