//@ run-pass
//@ description: `let o = f(..)` with `fn f(..) -> Option<P>` (P a struct) gives the `Some(p)` binder the payload type; only `Option<Box<T>>` returns were recorded, so `p` was bound as a Box handle and `p.y` crashed (SIGILL)
//@ expect-stdout: OPTION_STRUCT_RETURN_OK

struct P { x: i64, y: i64 }

fn find(k: i64) -> Option<P> {
    if k > 0 { return Some(P { x: k, y: k * 2 }) }
    None
}

fn y_or_zero(k: i64) -> i64 {
    let o = find(k)
    match o {
        Some(p) => p.y,
        None => 0,
    }
}

fn main() -> i32 with IO {
    if y_or_zero(3) != 6 { return 1 }
    if y_or_zero(0) != 0 { return 2 }
    let o = find(5)
    match o {
        Some(p) => { if p.x != 5 { return 3 } }
        None => { return 4 }
    }
    println("OPTION_STRUCT_RETURN_OK")
    0
}
