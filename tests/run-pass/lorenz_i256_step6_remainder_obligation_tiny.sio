//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 remainder obligation bounds

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn ceil_bound(n: i64, d: i64, q: i64) -> i64 {
    if (q - 1) * d >= n { return 0 }
    if q * d < n { return 0 }
    return 1
}

fn instance_fp() -> i64 {
    var fp: i64 = 401
    fp = mix(fp, 6, 3607)
    fp = mix(fp, 1000000, 3607)
    fp = mix(fp, 1, 3607)
    fp = mix(fp, 100, 3607)
    fp = mix(fp, 947760031, 3607)
    fp = mix(fp, 982064907, 3607)
    fp = mix(fp, 516981885, 3607)
    fp = mix(fp, 989033159, 3607)
    fp = mix(fp, 1047216, 3607)
    fp = mix(fp, 1646551, 3607)
    fp = mix(fp, 2263679, 3607)
    fp = mix(fp, 3042264, 3607)
    fp = mix(fp, 900658, 3607)
    fp = mix(fp, 1008677, 3607)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 827494918 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }
    var fp: i64 = 409
    fp = mix(fp, instance, 3623)
    fp = mix(fp, 27099342, 3623)
    fp = mix(fp, 46888150, 3623)
    fp = mix(fp, 47662713, 3623)
    fp = mix(fp, 5009243, 3623)
    fp = mix(fp, 2689806, 3623)
    fp = mix(fp, 7699049, 3623)
    fp = mix(fp, 945508630, 3623)
    fp = mix(fp, 1330977603, 3623)
    fp = mix(fp, 241656017, 3623)
    fp = mix(fp, 47276, 3623)
    fp = mix(fp, 66549, 3623)
    fp = mix(fp, 12083, 3623)
    fp = mix(fp, 50000, 3623)
    fp = mix(fp, 70000, 3623)
    fp = mix(fp, 15000, 3623)
    fp = mix(fp, 2724, 3623)
    fp = mix(fp, 3451, 3623)
    fp = mix(fp, 2917, 3623)
    fp = mix(fp, ok_mask, 3623)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 827494918 { return 0 - 1 }
    if certificate != 967484944 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }
    var fp: i64 = 419
    fp = mix(fp, instance, 3637)
    fp = mix(fp, certificate, 3637)
    fp = mix(fp, 5, 3637)
    fp = mix(fp, 6, 3637)
    fp = mix(fp, 47276, 3637)
    fp = mix(fp, 66549, 3637)
    fp = mix(fp, 12083, 3637)
    fp = mix(fp, 50000, 3637)
    fp = mix(fp, 70000, 3637)
    fp = mix(fp, 15000, 3637)
    fp = mix(fp, ok_mask, 3637)
    return fp
}

fn main() -> i64 {
    let scale: i64 = 1000000
    var ok_mask: i64 = 0
    if 27099342 == 28000000 - 900658 { ok_mask = ok_mask + 1 }
    if 46888150 == 10 * (1646551 + 3042264) { ok_mask = ok_mask + 2 }
    if ceil_bound(1646551 * 27099342, scale, 44620449) == 1 {
        if 47662713 == 44620449 + 3042264 { ok_mask = ok_mask + 4 }
    }
    if ceil_bound(1646551 * 3042264, scale, 5009243) == 1 {
        if ceil_bound(8069416, 3, 2689806) == 1 {
            if 7699049 == 5009243 + 2689806 { ok_mask = ok_mask + 8 }
        }
    }
    if 945508630 == 10 * (47662713 + 46888150) {
        if 1330977603 == 1270638013 + 12676877 + 47662713 {
            if 241656017 == 142646131 + 78479088 + 20530798 { ok_mask = ok_mask + 16 }
        }
    }
    if ceil_bound(945508630, 20000, 47276) == 1 {
        if ceil_bound(1330977603, 20000, 66549) == 1 {
            if ceil_bound(241656017, 20000, 12083) == 1 { ok_mask = ok_mask + 32 }
        }
    }
    if 50000 - 47276 == 2724 {
        if 70000 - 66549 == 3451 {
            if 15000 - 12083 == 2917 { ok_mask = ok_mask + 64 }
        }
    }
    if ok_mask != 127 { return 1 }
    let inst = instance_fp()
    if inst != 827494918 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 967484944 { return 3 }
    if artifact_fp(inst, cert, ok_mask) != 652877359 { return 4 }
    return 0
}
