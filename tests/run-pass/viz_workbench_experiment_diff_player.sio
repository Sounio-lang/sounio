    assert(evidence_cockpit.baseline_evidence_hash == recorder_evidence_package_initial.evidence_hash)
    assert(evidence_cockpit.compare_evidence_hash == recorder_evidence_package.evidence_hash)
    assert(evidence_cockpit.selected_event_delta == recorder_evidence_package.selected_event - recorder_evidence_package_initial.selected_event)
