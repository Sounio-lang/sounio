// tests/run-pass/viz_workbench_experiment_diff_player.sio - Workbench experiment diff scrubber proof
//
// Expected output includes:
//   workbench-experiment-diff-player
//   workbench-experiment-diff-overlay
//   workbench-experiment-diff-artifact
//   workbench-experiment-diff-library
//   workbench-experiment-diff-library-browser
//   VIZ_WORKBENCH_EXPERIMENT_DIFF_PLAYER_PASS
//   VIZ_WORKBENCH_EXPERIMENT_DIFF_OVERLAY_PASS
//   VIZ_WORKBENCH_EXPERIMENT_DIFF_ARTIFACT_PASS
//   VIZ_WORKBENCH_EXPERIMENT_DIFF_LIBRARY_PASS
//   VIZ_WORKBENCH_EXPERIMENT_DIFF_LIBRARY_BROWSER_PASS

use display::canvas::{Canvas, canvas_clear}
use display::event::{Event, EV_MOUSE_PRESS, MOUSE_LEFT}
use viz::ir::{viz_scene_new}
use viz::snapshot::{
    viz_scene_history_new, viz_scene_history_record,
    viz_scene_package_new,
    viz_scene_project_new, viz_scene_project_verify,
}
use viz::viz_app::{viz_app_frame_hash, viz_app_new}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use viz::workbench::{
    VizWorkbenchReplayStep,
    viz_workbench_build_scene,
    viz_workbench_experiment_diff_artifact_build,
    viz_workbench_experiment_diff_artifact_emit,
    viz_workbench_experiment_diff_artifact_hash,
    viz_workbench_experiment_diff_artifact_verify,
    viz_workbench_experiment_diff_library_add,
    viz_workbench_experiment_diff_library_browser_apply,
    viz_workbench_experiment_diff_library_browser_emit,
    viz_workbench_experiment_diff_library_browser_hash,
    viz_workbench_experiment_diff_library_browser_verify,
    viz_workbench_experiment_diff_library_emit,
    viz_workbench_experiment_diff_library_empty,
    viz_workbench_experiment_diff_library_hash,
    viz_workbench_experiment_diff_library_select,
    viz_workbench_experiment_diff_library_verify,
    viz_workbench_experiment_diff_overlay_apply,
    viz_workbench_experiment_diff_overlay_emit,
    viz_workbench_experiment_diff_overlay_hash,
    viz_workbench_experiment_diff_overlay_verify,
    viz_workbench_experiment_diff_player_emit,
    viz_workbench_experiment_diff_player_hash,
    viz_workbench_experiment_diff_player_select,
    viz_workbench_experiment_diff_player_verify,
    viz_workbench_notebook_add_archive,
    viz_workbench_notebook_empty,
    viz_workbench_notebook_emit,
    viz_workbench_notebook_select,
    viz_workbench_notebook_verify,
    viz_workbench_project_capture,
    viz_workbench_project_diff_empty,
    viz_workbench_replay_event,
    viz_workbench_replay_record_session,
    viz_workbench_replay_tick,
    viz_workbench_session_archive_build,
    viz_workbench_session_archive_emit,
    viz_workbench_session_timeline_from_session,
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn center_x(x: i64, w: i64) -> i64 {
    x + w / 2
}

fn center_y(y: i64, h: i64) -> i64 {
    y + h / 2
}

fn canvas_hash(c: &Canvas) -> i64 with Mut {
    var h: i64 = 31
    var i: i64 = 0
    let n = c.width * c.height
    while i < n {
        h = h * 131 + read_i64(c.pixels, i)
        i = i + 1
    }
    h
}

fn main() with IO, Alloc, Mut, Div {
    var scene_a = viz_scene_new()
    let ids_a = viz_workbench_build_scene(&!scene_a)
    var app_a = viz_app_new(10, 13, 18)
    var canvas_a = make_canvas(480, 320)

    var steps_a: [VizWorkbenchReplayStep; 32] = [viz_workbench_replay_tick(0); 32]
    let play_x_a = center_x(scene_a.nodes[ids_a.time_play as usize].layout.x, scene_a.nodes[ids_a.time_play as usize].layout.w)
    let play_y_a = center_y(scene_a.nodes[ids_a.time_play as usize].layout.y, scene_a.nodes[ids_a.time_play as usize].layout.h)
    let atom_tool_x_a = center_x(scene_a.nodes[ids_a.studio_atom as usize].layout.x, scene_a.nodes[ids_a.studio_atom as usize].layout.w)
    let atom_tool_y_a = center_y(scene_a.nodes[ids_a.studio_atom as usize].layout.y, scene_a.nodes[ids_a.studio_atom as usize].layout.h)
    let add_x_a = center_x(scene_a.nodes[ids_a.molecule as usize].layout.x, scene_a.nodes[ids_a.molecule as usize].layout.w)
    let add_y_a = center_y(scene_a.nodes[ids_a.molecule as usize].layout.y, scene_a.nodes[ids_a.molecule as usize].layout.h) + 21

    steps_a[0] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, play_x_a, play_y_a))
    steps_a[1] = viz_workbench_replay_tick(1000)
    steps_a[2] = viz_workbench_replay_tick(1000)
    steps_a[3] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, atom_tool_x_a, atom_tool_y_a))
    steps_a[4] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, add_x_a, add_y_a))

    let session_a = viz_workbench_replay_record_session(&!app_a, &!scene_a, &ids_a, &!canvas_a, &steps_a, 5)
    assert(session_a.frame_count == 6)
    var history_a = viz_scene_history_new()
    assert(viz_scene_history_record(&!history_a, &scene_a, 9501))
    canvas_clear(&!canvas_a, app_a.bg_r, app_a.bg_g, app_a.bg_b)
    viz_canvas_render_scene(&scene_a, &!canvas_a)
    var pkg_a = viz_scene_package_new()
    var project_a = viz_scene_project_new()
    viz_workbench_project_capture(&!project_a, &scene_a, &history_a, &!pkg_a, &session_a, canvas_hash(&canvas_a))
    assert(viz_scene_project_verify(&project_a))
    let timeline_a = viz_workbench_session_timeline_from_session(&session_a, 3)
    let diff_a = viz_workbench_project_diff_empty()
    let archive_a = viz_workbench_session_archive_build(&session_a, &project_a, &timeline_a, &diff_a)
    assert(archive_a.valid)

    var scene_b = viz_scene_new()
    let ids_b = viz_workbench_build_scene(&!scene_b)
    var app_b = viz_app_new(10, 13, 18)
    var canvas_b = make_canvas(480, 320)

    var steps_b: [VizWorkbenchReplayStep; 32] = [viz_workbench_replay_tick(0); 32]
    let play_x_b = center_x(scene_b.nodes[ids_b.time_play as usize].layout.x, scene_b.nodes[ids_b.time_play as usize].layout.w)
    let play_y_b = center_y(scene_b.nodes[ids_b.time_play as usize].layout.y, scene_b.nodes[ids_b.time_play as usize].layout.h)
    let atom_tool_x_b = center_x(scene_b.nodes[ids_b.studio_atom as usize].layout.x, scene_b.nodes[ids_b.studio_atom as usize].layout.w)
    let atom_tool_y_b = center_y(scene_b.nodes[ids_b.studio_atom as usize].layout.y, scene_b.nodes[ids_b.studio_atom as usize].layout.h)
    let add_x_b = center_x(scene_b.nodes[ids_b.molecule as usize].layout.x, scene_b.nodes[ids_b.molecule as usize].layout.w)
    let add_y_b = center_y(scene_b.nodes[ids_b.molecule as usize].layout.y, scene_b.nodes[ids_b.molecule as usize].layout.h) + 21

    steps_b[0] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, play_x_b, play_y_b))
    steps_b[1] = viz_workbench_replay_tick(1000)
    steps_b[2] = viz_workbench_replay_tick(1000)
    steps_b[3] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, atom_tool_x_b, atom_tool_y_b))
    steps_b[4] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, add_x_b, add_y_b))
    steps_b[5] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, add_x_b + 8, add_y_b + 4))

    let session_b = viz_workbench_replay_record_session(&!app_b, &!scene_b, &ids_b, &!canvas_b, &steps_b, 6)
    assert(session_b.frame_count == 7)
    var history_b = viz_scene_history_new()
    assert(viz_scene_history_record(&!history_b, &scene_b, 9502))
    canvas_clear(&!canvas_b, app_b.bg_r, app_b.bg_g, app_b.bg_b)
    viz_canvas_render_scene(&scene_b, &!canvas_b)
    var pkg_b = viz_scene_package_new()
    var project_b = viz_scene_project_new()
    viz_workbench_project_capture(&!project_b, &scene_b, &history_b, &!pkg_b, &session_b, canvas_hash(&canvas_b))
    assert(viz_scene_project_verify(&project_b))
    let timeline_b = viz_workbench_session_timeline_from_session(&session_b, 6)
    let diff_b = viz_workbench_project_diff_empty()
    let archive_b = viz_workbench_session_archive_build(&session_b, &project_b, &timeline_b, &diff_b)
    assert(archive_b.valid)

    var notebook = viz_workbench_notebook_empty()
    assert(viz_workbench_notebook_add_archive(&!notebook, &archive_a))
    assert(viz_workbench_notebook_add_archive(&!notebook, &archive_b))
    assert(viz_workbench_notebook_select(&!notebook, 1, 0, 1))
    assert(viz_workbench_notebook_verify(&notebook))

    var scene_left_same = viz_scene_new()
    let ids_left_same = viz_workbench_build_scene(&!scene_left_same)
    var app_left_same = viz_app_new(10, 13, 18)
    var canvas_left_same = make_canvas(480, 320)
    var scene_right_same = viz_scene_new()
    let ids_right_same = viz_workbench_build_scene(&!scene_right_same)
    var app_right_same = viz_app_new(10, 13, 18)
    var canvas_right_same = make_canvas(480, 320)

    let player_same = viz_workbench_experiment_diff_player_select(
        &notebook,
        &!app_left_same, &!scene_left_same, &ids_left_same, &!canvas_left_same, &session_a,
        &!app_right_same, &!scene_right_same, &ids_right_same, &!canvas_right_same, &session_b,
        1,
        1,
    )
    assert(player_same.valid)
    assert(player_same.left_frame == 1)
    assert(player_same.right_frame == 1)
    assert(player_same.frame_delta == 0)
    assert(player_same.time_delta_ms == 0)
    assert(player_same.left_frame_hash == session_a.frame_hashes[1])
    assert(player_same.right_frame_hash == session_b.frame_hashes[1])
    assert(player_same.player_hash == viz_workbench_experiment_diff_player_hash(&player_same))
    assert(viz_workbench_experiment_diff_player_verify(&player_same, &notebook, &session_a, &session_b))
    let before_same_overlay_frame_hash = viz_app_frame_hash(&app_right_same, &scene_right_same, &canvas_right_same)
    assert(before_same_overlay_frame_hash != 0)
    let overlay_same = viz_workbench_experiment_diff_overlay_apply(&!scene_right_same, &ids_right_same, &player_same)
    assert(overlay_same.valid)
    assert(viz_workbench_experiment_diff_overlay_verify(&overlay_same, &scene_right_same, &player_same))
    canvas_clear(&!canvas_right_same, app_right_same.bg_r, app_right_same.bg_g, app_right_same.bg_b)
    viz_canvas_render_scene(&scene_right_same, &!canvas_right_same)
    let after_same_overlay_frame_hash = viz_app_frame_hash(&app_right_same, &scene_right_same, &canvas_right_same)
    assert(after_same_overlay_frame_hash != 0)
    let artifact_same = viz_workbench_experiment_diff_artifact_build(&notebook, &player_same, &overlay_same, &scene_right_same, after_same_overlay_frame_hash)
    assert(artifact_same.valid)
    assert(viz_workbench_experiment_diff_artifact_verify(&artifact_same, &notebook, &player_same, &overlay_same, &scene_right_same))

    var scene_left_late = viz_scene_new()
    let ids_left_late = viz_workbench_build_scene(&!scene_left_late)
    var app_left_late = viz_app_new(10, 13, 18)
    var canvas_left_late = make_canvas(480, 320)
    var scene_right_late = viz_scene_new()
    let ids_right_late = viz_workbench_build_scene(&!scene_right_late)
    var app_right_late = viz_app_new(10, 13, 18)
    var canvas_right_late = make_canvas(480, 320)

    let player_late = viz_workbench_experiment_diff_player_select(
        &notebook,
        &!app_left_late, &!scene_left_late, &ids_left_late, &!canvas_left_late, &session_a,
        &!app_right_late, &!scene_right_late, &ids_right_late, &!canvas_right_late, &session_b,
        3,
        6,
    )
    assert(player_late.valid)
    assert(player_late.left_index == 0)
    assert(player_late.right_index == 1)
    assert(player_late.left_frame == 3)
    assert(player_late.right_frame == 6)
    assert(player_late.left_frame_count == 6)
    assert(player_late.right_frame_count == 7)
    assert(player_late.frame_delta == 3)
    assert(player_late.time_delta_ms == 0)
    assert(player_late.frame_hash_delta != 0)
    assert(player_late.audit_hash_delta != 0)
    assert(player_late.frame_hash_distance != 0)
    assert(player_late.audit_hash_distance != 0)
    assert(player_late.left_timeline_hash == archive_a.timeline_hash)
    assert(player_late.right_timeline_hash == archive_b.timeline_hash)
    assert(player_late.left_frame_hash == archive_a.selected_frame_hash)
    assert(player_late.right_frame_hash == archive_b.selected_frame_hash)
    assert(player_late.left_audit_hash == archive_a.selected_audit_hash)
    assert(player_late.right_audit_hash == archive_b.selected_audit_hash)
    assert(player_late.player_hash != player_same.player_hash)
    assert(player_late.player_hash == viz_workbench_experiment_diff_player_hash(&player_late))
    assert(viz_workbench_experiment_diff_player_verify(&player_late, &notebook, &session_a, &session_b))
    assert(scene_left_late.nodes[ids_left_late.studio_timeline as usize].value == 3.0)
    assert(scene_right_late.nodes[ids_right_late.studio_timeline as usize].value == 6.0)
    assert(viz_app_frame_hash(&app_left_late, &scene_left_late, &canvas_left_late) != 0)
    let before_overlay_frame_hash = viz_app_frame_hash(&app_right_late, &scene_right_late, &canvas_right_late)
    assert(before_overlay_frame_hash != 0)
    let overlay = viz_workbench_experiment_diff_overlay_apply(&!scene_right_late, &ids_right_late, &player_late)
    assert(overlay.valid)
    assert(overlay.player_hash == player_late.player_hash)
    assert(overlay.diff_node == ids_right_late.workspace_diff)
    assert(overlay.dt_node == ids_right_late.workspace_dt)
    assert(overlay.audit_node == ids_right_late.workspace_daudit)
    assert(overlay.frame_node == ids_right_late.workspace_dframe)
    assert(overlay.time_delta_ms == player_late.time_delta_ms)
    assert(overlay.frame_delta == player_late.frame_delta)
    assert(overlay.overlay_hash == viz_workbench_experiment_diff_overlay_hash(&overlay))
    assert(scene_right_late.nodes[overlay.diff_node as usize].value == overlay.diff_marker as f64)
    assert(scene_right_late.nodes[overlay.dt_node as usize].value == overlay.time_delta_ms as f64)
    assert(scene_right_late.nodes[overlay.audit_node as usize].value == overlay.audit_hash_marker as f64)
    assert(scene_right_late.nodes[overlay.frame_node as usize].value == overlay.frame_hash_marker as f64)
    assert(scene_right_late.selected_node == overlay.diff_node)
    assert(scene_right_late.focused_node == overlay.diff_node)
    assert(scene_right_late.nodes[overlay.diff_node as usize].selected)
    assert(scene_right_late.nodes[overlay.tooltip_node as usize].label_len == 12)
    assert(scene_right_late.nodes[overlay.tooltip_node as usize].label[0] == 100)
    assert(scene_right_late.nodes[overlay.tooltip_node as usize].label[5] == 111)
    assert(scene_right_late.nodes[overlay.diff_node as usize].style.r == 255)
    assert(scene_right_late.nodes[overlay.diff_node as usize].style.g == 170)
    assert(scene_right_late.nodes[overlay.diff_node as usize].style.b == 130)
    assert(viz_workbench_experiment_diff_overlay_verify(&overlay, &scene_right_late, &player_late))
    assert(scene_right_late.nodes[ids_right_late.workspace_diff as usize].selected)
    assert(scene_right_late.selected_node == ids_right_late.workspace_diff)
    assert(scene_right_late.focused_node == ids_right_late.workspace_diff)
    assert(scene_right_late.hovered_node == ids_right_late.workspace_dframe)
    assert(scene_right_late.nodes[ids_right_late.tooltip as usize].label_len == 12)
    assert(scene_right_late.nodes[ids_right_late.tooltip as usize].label[0] == 100)
    assert(scene_right_late.nodes[ids_right_late.tooltip as usize].label[5] == 111)
    assert(scene_right_late.nodes[ids_right_late.workspace_diff as usize].style.r == 255)
    assert(scene_right_late.nodes[ids_right_late.workspace_diff as usize].style.g == 170)
    assert(scene_right_late.nodes[ids_right_late.workspace_diff as usize].style.b == 130)
    canvas_clear(&!canvas_right_late, app_right_late.bg_r, app_right_late.bg_g, app_right_late.bg_b)
    viz_canvas_render_scene(&scene_right_late, &!canvas_right_late)
    let after_overlay_frame_hash = viz_app_frame_hash(&app_right_late, &scene_right_late, &canvas_right_late)
    assert(after_overlay_frame_hash != 0)
    assert(after_overlay_frame_hash != before_overlay_frame_hash)
    let artifact = viz_workbench_experiment_diff_artifact_build(&notebook, &player_late, &overlay, &scene_right_late, after_overlay_frame_hash)
    assert(artifact.valid)
    assert(artifact.notebook_hash == notebook.notebook_hash)
    assert(artifact.compare_hash == player_late.compare_hash)
    assert(artifact.player_hash == player_late.player_hash)
    assert(artifact.overlay_hash == overlay.overlay_hash)
    assert(artifact.left_archive_hash == notebook.baseline_archive_hash)
    assert(artifact.right_archive_hash == notebook.compare_archive_hash)
    assert(artifact.rendered_frame_hash == after_overlay_frame_hash)
    assert(artifact.selected_left_frame == player_late.left_frame)
    assert(artifact.selected_right_frame == player_late.right_frame)
    assert(artifact.frame_delta == player_late.frame_delta)
    assert(artifact.time_delta_ms == player_late.time_delta_ms)
    assert(artifact.frame_hash_delta == player_late.frame_hash_delta)
    assert(artifact.audit_hash_delta == player_late.audit_hash_delta)
    assert(artifact.artifact_hash == viz_workbench_experiment_diff_artifact_hash(&artifact))
    assert(viz_workbench_experiment_diff_artifact_verify(&artifact, &notebook, &player_late, &overlay, &scene_right_late))
    var library = viz_workbench_experiment_diff_library_empty()
    assert(viz_workbench_experiment_diff_library_add(&!library, &artifact_same))
    assert(viz_workbench_experiment_diff_library_add(&!library, &artifact))
    assert(viz_workbench_experiment_diff_library_select(&!library, 1, 0, 1))
    assert(viz_workbench_experiment_diff_library_verify(&library))
    assert(library.artifact_count == 2)
    assert(library.selected_index == 1)
    assert(library.baseline_index == 0)
    assert(library.compare_index == 1)
    assert(library.selected_artifact_hash == artifact.artifact_hash)
    assert(library.baseline_artifact_hash == artifact_same.artifact_hash)
    assert(library.compare_artifact_hash == artifact.artifact_hash)
    assert(library.artifact_hash_delta == artifact.artifact_hash - artifact_same.artifact_hash)
    assert(library.rendered_frame_hash_delta == artifact.rendered_frame_hash - artifact_same.rendered_frame_hash)
    assert(library.scene_audit_hash_delta == artifact.scene_audit_hash - artifact_same.scene_audit_hash)
    assert(library.library_hash == viz_workbench_experiment_diff_library_hash(&library))
    let before_library_browser_frame_hash = viz_app_frame_hash(&app_right_late, &scene_right_late, &canvas_right_late)
    assert(before_library_browser_frame_hash != 0)
    let library_browser = viz_workbench_experiment_diff_library_browser_apply(&library, &!scene_right_late, &ids_right_late)
    assert(library_browser.valid)
    assert(library_browser.library_hash == library.library_hash)
    assert(library_browser.artifact_count == library.artifact_count)
    assert(library_browser.selected_index == library.selected_index)
    assert(library_browser.baseline_index == library.baseline_index)
    assert(library_browser.compare_index == library.compare_index)
    assert(library_browser.selected_artifact_hash == library.selected_artifact_hash)
    assert(library_browser.baseline_artifact_hash == library.baseline_artifact_hash)
    assert(library_browser.compare_artifact_hash == library.compare_artifact_hash)
    assert(library_browser.artifact_hash_delta == library.artifact_hash_delta)
    assert(library_browser.rendered_frame_hash_delta == library.rendered_frame_hash_delta)
    assert(library_browser.scene_audit_hash_delta == library.scene_audit_hash_delta)
    assert(library_browser.artifact_delta_node == ids_right_late.workspace_diff)
    assert(library_browser.selected_node == ids_right_late.workspace_dt)
    assert(library_browser.rendered_delta_node == ids_right_late.workspace_dframe)
    assert(library_browser.audit_delta_node == ids_right_late.workspace_daudit)
    assert(scene_right_late.nodes[library_browser.artifact_delta_node as usize].value == library_browser.artifact_delta_marker as f64)
    assert(scene_right_late.nodes[library_browser.selected_node as usize].value == library_browser.selected_marker as f64)
    assert(scene_right_late.nodes[library_browser.rendered_delta_node as usize].value == library_browser.rendered_delta_marker as f64)
    assert(scene_right_late.nodes[library_browser.audit_delta_node as usize].value == library_browser.audit_delta_marker as f64)
    assert(scene_right_late.selected_node == ids_right_late.workspace_diff)
    assert(scene_right_late.focused_node == ids_right_late.workspace_diff)
    assert(scene_right_late.hovered_node == ids_right_late.workspace_dt)
    assert(scene_right_late.nodes[ids_right_late.tooltip as usize].label_len == 12)
    assert(scene_right_late.nodes[ids_right_late.tooltip as usize].label[0] == 100)
    assert(scene_right_late.nodes[ids_right_late.tooltip as usize].label[5] == 108)
    assert(library_browser.browser_hash == viz_workbench_experiment_diff_library_browser_hash(&library_browser))
    assert(viz_workbench_experiment_diff_library_browser_verify(&library_browser, &library, &scene_right_late))
    canvas_clear(&!canvas_right_late, app_right_late.bg_r, app_right_late.bg_g, app_right_late.bg_b)
    viz_canvas_render_scene(&scene_right_late, &!canvas_right_late)
    let after_library_browser_frame_hash = viz_app_frame_hash(&app_right_late, &scene_right_late, &canvas_right_late)
    assert(after_library_browser_frame_hash != 0)
    assert(after_library_browser_frame_hash != before_library_browser_frame_hash)

    viz_workbench_session_archive_emit(&archive_a)
    viz_workbench_session_archive_emit(&archive_b)
    viz_workbench_notebook_emit(&notebook)
    viz_workbench_experiment_diff_player_emit(&player_same)
    viz_workbench_experiment_diff_player_emit(&player_late)
    viz_workbench_experiment_diff_overlay_emit(&overlay)
    viz_workbench_experiment_diff_artifact_emit(&artifact_same)
    viz_workbench_experiment_diff_artifact_emit(&artifact)
    viz_workbench_experiment_diff_library_emit(&library)
    viz_workbench_experiment_diff_library_browser_emit(&library_browser)
    viz_html_emit_scene(&scene_right_late, 480, 320)

    heap_free(canvas_a.pixels as *mut i8)
    heap_free(canvas_b.pixels as *mut i8)
    heap_free(canvas_left_same.pixels as *mut i8)
    heap_free(canvas_right_same.pixels as *mut i8)
    heap_free(canvas_left_late.pixels as *mut i8)
    heap_free(canvas_right_late.pixels as *mut i8)
    println("VIZ_WORKBENCH_EXPERIMENT_DIFF_LIBRARY_BROWSER_PASS")
    println("VIZ_WORKBENCH_EXPERIMENT_DIFF_LIBRARY_PASS")
    println("VIZ_WORKBENCH_EXPERIMENT_DIFF_ARTIFACT_PASS")
    println("VIZ_WORKBENCH_EXPERIMENT_DIFF_OVERLAY_PASS")
    println("VIZ_WORKBENCH_EXPERIMENT_DIFF_PLAYER_PASS")
}
