    assert(evidence_cockpit.select_count == 1)
    assert(evidence_cockpit.last_action == 2)
    assert(viz_workbench_experiment_evidence_observatory_cockpit_verify(&evidence_cockpit, &evidence_observatory, &scene_right_late))
    let evidence_baseline_x = center_x(scene_right_late.nodes[evidence_cockpit.baseline_node as usize].layout.x, scene_right_late.nodes[evidence_cockpit.baseline_node as usize].layout.w)
