    assert(evidence_observatory.mouse_action_total == recorder_evidence_package_initial.mouse_action_count + recorder_evidence_package.mouse_action_count)
    assert(evidence_observatory.observatory_hash == viz_workbench_experiment_evidence_observatory_hash(&evidence_observatory))
    assert(viz_workbench_experiment_evidence_observatory_verify(&evidence_observatory))
    var evidence_cockpit = viz_workbench_experiment_evidence_observatory_cockpit_apply(&evidence_observatory, &!scene_right_late, &ids_right_late, 1, 0, 1)
    assert(evidence_cockpit.valid)
    assert(evidence_cockpit.observatory_hash == evidence_observatory.observatory_hash)
    assert(evidence_cockpit.package_count == evidence_observatory.package_count)
    assert(evidence_cockpit.selected_package == 1)
