//@ run-pass

// Task 8 Step 3: adversarial malformed-input coverage. Four independent
// cases, each its own scoped block inside `main` (matching this branch's
// established single-file-multi-case pattern, e.g.
// tests/run-pass/x509_verify_signature.sio's true/false-case-1/false-case-2
// split):
//
//   (a) outer signatureAlgorithm OID deliberately set to a DIFFERENT (but
//       still recognized) algorithm than the TBS's own inner one ->
//       x509_parse_certificate must return X509_ERR_SIG_ALG_MISMATCH.
//   (b) a single tampered byte inside tbs_start..tbs_start+tbs_len of an
//       otherwise-valid, REAL openssl-signed fixture (Task 7 Step 4's own
//       vector, reused byte-for-byte) -> x509_verify_signature must return
//       false.
//   (c) a fixture with 33 extensions (one over X509_MAX_EXTENSIONS=32) ->
//       x509_parse_extensions must return X509_ERR_TOO_MANY_ENTRIES, not
//       silently drop the 33rd.
//   (d) an RDN value 129 bytes long (one over X509_MAX_NAME_VALUE_LEN=128)
//       -> x509_parse_name must return X509_ERR_VALUE_TOO_LONG.
//
// (c) and (d) call x509_parse_extensions/x509_parse_name directly (the same
// unit-level entry points tests/run-pass/x509_parse_extensions.sio and the
// issuer/subject Name parsing inside x509_parse_tbs_core already exercise)
// rather than building a full outer Certificate wrapper around each --
// this is the natural unit boundary for these two error paths and keeps
// each fixture minimal and its length arithmetic easy to independently
// re-derive, matching this whole plan's per-field TLV-arithmetic discipline.

use asn1::der::*
use bignum::bigint::*
use net::socket::*
use x509::cert::*
use x509::oid::*

fn build_bigint_128(values: [u16; 128]) -> BigInt {
    var result = bigint_zero()
    var i: i64 = 0
    while i < 128 {
        result.limbs[i as usize] = values[i as usize]
        i = i + 1
    }
    result.len = 128
    result
}

// Task 7 Step 4's own real key pair's modulus limbs (see
// tests/run-pass/x509_verify_signature.sio's issuer_modulus_limbs for the
// full derivation comment -- reused byte-for-byte here per this task's
// brief instruction to reuse that vector for case (b)).
fn issuer_modulus_limbs() -> [u16; 128] {
    let r: [u16; 128] = [
        50309, 33971, 25228, 55056, 23810, 16895, 11725, 25180,
        62359, 36582, 34172, 17924, 29342, 62096, 1248, 11713,
        56054, 35180, 55879, 27305, 2024, 40477, 54987, 35878,
        32574, 36087, 62156, 34511, 39718, 28811, 58803, 45836,
        56340, 14378, 18957, 15991, 41343, 10878, 11150, 44588,
        18068, 47366, 21884, 52914, 36246, 58148, 41206, 43542,
        56555, 9296, 54339, 716, 30174, 2222, 9131, 9934,
        15109, 51715, 35455, 15671, 51837, 14301, 37649, 25725,
        57030, 52948, 34969, 53396, 60488, 5220, 11058, 1044,
        17153, 22269, 24615, 11590, 17204, 7391, 57833, 11445,
        24336, 20811, 2173, 174, 8983, 15988, 11840, 22676,
        40525, 63697, 54709, 52258, 46609, 33156, 10343, 43122,
        65471, 46314, 59745, 60011, 50115, 31612, 51714, 9546,
        35265, 43940, 51584, 16979, 24591, 24286, 20282, 60918,
        56214, 6958, 57198, 37746, 52719, 40703, 17767, 55894,
        45383, 28330, 31525, 46307, 42040, 43605, 21688, 50417,
    ]
    r
}

// ---- Case (a): outer signatureAlgorithm OID mismatch. ----
//
// Base fixture: Task 7's own x509_parse_full_certificate.sio 197-byte
// fixture (TBSCertificate's own inner signature algorithm is
// sha256WithRSAEncryption, OID last byte 0x0B, at wire offset 187, inside
// the outer AlgorithmIdentifier SEQUENCE at [175..190)). This is a
// PLAUSIBLE, structurally valid fixture (not cryptographically verified --
// x509_parse_certificate's own sig-alg cross-check happens BEFORE any
// signature verification, so this test never needs a real signature).
//
// The ONLY byte changed from that fixture: index 187, the outer
// signatureAlgorithm OID's last content byte, from 0x0B (sha256WithRSA,
// unchanged in the TBS's own copy at index ~27) to 0x05 (sha1WithRSA,
// oid_sha1_with_rsa() per stdlib/x509/oid.sio) -- still a recognized RFC
// 8017 arc 1.2.840.113549.1.1 algorithm, just a DIFFERENT one than the
// TBS's own, per this task's brief ("a different (but still recognized)
// algorithm").
fn case_a_sig_alg_mismatch() -> i64 with IO {
    let total_len: i64 = 197
    let buf = rawbuf_new(total_len + 8)

    let bytes: [i64; 197] = [
        0x30, 0x81, 0xC2, 0x30, 0x81, 0xA9, 0xA0, 0x03, 0x02, 0x01, 0x02, 0x02,
        0x02, 0x30, 0x39, 0x30, 0x0D, 0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7,
        0x0D, 0x01, 0x01, 0x0B, 0x05, 0x00, 0x30, 0x12, 0x31, 0x10, 0x30, 0x0E,
        0x06, 0x03, 0x55, 0x04, 0x03, 0x13, 0x07, 0x54, 0x65, 0x73, 0x74, 0x20,
        0x43, 0x41, 0x30, 0x1E, 0x17, 0x0D, 0x32, 0x35, 0x30, 0x31, 0x30, 0x31,
        0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x5A, 0x17, 0x0D, 0x32, 0x36, 0x30,
        0x31, 0x30, 0x31, 0x30, 0x30, 0x30, 0x30, 0x30, 0x30, 0x5A, 0x30, 0x14,
        0x31, 0x12, 0x30, 0x10, 0x06, 0x03, 0x55, 0x04, 0x03, 0x13, 0x09, 0x54,
        0x65, 0x73, 0x74, 0x20, 0x4C, 0x65, 0x61, 0x66, 0x30, 0x1B, 0x30, 0x0D,
        0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x01, 0x05,
        0x00, 0x03, 0x0A, 0x00, 0x30, 0x07, 0x02, 0x02, 0x0C, 0xA1, 0x02, 0x01,
        0x11, 0xA3, 0x28, 0x30, 0x26, 0x30, 0x12, 0x06, 0x03, 0x55, 0x1D, 0x13,
        0x01, 0x01, 0xFF, 0x04, 0x08, 0x30, 0x06, 0x01, 0x01, 0xFF, 0x02, 0x01,
        0x00, 0x30, 0x10, 0x06, 0x03, 0x55, 0x1D, 0x11, 0x04, 0x09, 0x30, 0x07,
        0x82, 0x05, 0x61, 0x2E, 0x63, 0x6F, 0x6D, 0x30, 0x0D, 0x06, 0x09, 0x2A,
        // Outer AlgorithmIdentifier starts at index 175 (0x30). Index 187
        // is the OID's last content byte -- CHANGED from 0x0B
        // (sha256WithRSAEncryption) to 0x05 (sha1WithRSAEncryption), the
        // ONE deliberate deviation from Task 7's own fixture bytes.
        0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x05, 0x05, 0x00, 0x03,
        0x05, 0x00, 0xDE, 0xAD, 0xBE, 0xEF,
    ]

    var i: i64 = 0
    while i < total_len {
        rawbuf_set(&buf, i, bytes[i as usize])
        i = i + 1
    }

    // Independently confirm, straight from the buffer (not through the
    // parser), that index 187 really is the byte that was changed, and
    // that it now reads 0x05 (not 0x0B).
    if (rawbuf_get(&buf, 187) & 255) != 0x05 {
        return 101
    }

    var cert = certificate_zero()
    let (cert_raw, status) = x509_parse_certificate(&buf, total_len)
    cert = cert_raw

    if status != X509_ERR_SIG_ALG_MISMATCH {
        return 102
    }
    assert(status == X509_ERR_SIG_ALG_MISMATCH)
    0
}

