        0xC9, 0xC1, 0x90, 0xBB, 0x5D, 0x7D, 0xAB, 0xA8, 0x3A, 0xA7, 0xAF, 0x6B,
        0xB7, 0x82, 0x7D, 0x37, 0x84, 0x3F, 0xEB, 0x77, 0xC4, 0x38, 0x62, 0x8F,
        0xEB, 0x8E, 0xCE, 0x1E, 0xF5, 0x13, 0xB3, 0xC8, 0x7D, 0x86, 0xAB, 0x86,
        0xCE, 0x20, 0x9A, 0xD1, 0xC9, 0xE5, 0xF9, 0xE7, 0xD3, 0x0D, 0x1D, 0xD6,
        0x20, 0xAB, 0x21, 0x34, 0x5A, 0x85, 0xCC, 0xD2, 0xDA, 0xE7, 0xDC, 0xEF,
        0x6F, 0x66, 0x05, 0xB6, 0xF6, 0x12, 0xF4, 0xA4, 0x03, 0x6F, 0xA7, 0xB6,
        0x8F, 0xEC, 0xBB, 0xAF, 0xEB, 0x90, 0xB5, 0x70, 0x53, 0x22, 0x83, 0xB8,
        0xF1, 0x46, 0xD9, 0xF2, 0xE5, 0xC0, 0xDE, 0xE1, 0xE1, 0x53, 0xB9, 0x86,
        0xAD, 0x73, 0x4E, 0x94, 0x58, 0x06, 0xD6, 0x72, 0x77, 0x00, 0x20, 0x5E,
        0xB1, 0x8F, 0x6D, 0xD4, 0xA4, 0xB1, 0x85, 0xFD, 0xC0, 0x68, 0xB8, 0xCE,
        0xFC, 0xE6, 0x15, 0x1C, 0xA4, 0xC9, 0x5D, 0xAC, 0x78, 0xC5, 0xE0, 0x16,
        0xC5, 0x49, 0x66, 0x58, 0xE5, 0x7E, 0x61, 0x79,
    ]

    var i: i64 = 0
    while i < total_len {
        rawbuf_set(&buf, i, bytes[i as usize])
        i = i + 1
    }

    var cert = certificate_zero()
    let (cert_raw, status) = x509_parse_certificate(&buf, total_len)
    cert = cert_raw
    if status != X509_OK {
        return 201
    }

    let issuer_modulus = build_bigint_128(issuer_modulus_limbs())
    let issuer_exponent = bigint_from_u32(65537)

    // Sanity: the UNMODIFIED bytes must still verify true (proves the
    // corruption below, not some unrelated setup mistake, is what flips
    // the result to false).
    let sanity_ok = x509_verify_signature(&buf, &cert, &issuer_modulus, &issuer_exponent)
    if sanity_ok == false {
        return 202
    }

    // Corrupt exactly one byte inside cert.tbs_start..cert.tbs_start+cert.tbs_len
    // (offset 4 + 20 = 24, inside the issuer Name's own CN OID bytes) in a
    // FRESH copy of the buffer, per this task's brief instruction to reuse
    // Task 7 Step 4's own vector for this exact case.
    let corrupted_buf = rawbuf_new(total_len + 8)
    var ci: i64 = 0
    while ci < total_len {
        rawbuf_set(&corrupted_buf, ci, bytes[ci as usize])
        ci = ci + 1
    }
    if 24 < cert.tbs_start || 24 >= (cert.tbs_start + cert.tbs_len) {
        return 203
    }
    let original_byte = rawbuf_get(&corrupted_buf, 24) & 255
    rawbuf_set(&corrupted_buf, 24, original_byte ^ 1)

    let tampered_ok = x509_verify_signature(&corrupted_buf, &cert, &issuer_modulus, &issuer_exponent)
    if tampered_ok == true {
        return 204
    }
    assert(tampered_ok == false)
    0
}

// ---- Case (c): 33 extensions (one over X509_MAX_EXTENSIONS = 32). ----
//
// 33 copies of the SAME minimal generic Extension SEQUENCE (OID 2.5.29.32
// certificatePolicies, 5 bytes; no critical field; extnValue OCTET STRING
// of a single byte 0xAA): `30 08 06 03 55 1D 20 04 01 AA` = 10 bytes each,
// 33 * 10 = 330 bytes total. Repeating the same OID 33 times is fine here
// -- x509_parse_extensions never checks OID uniqueness, only counts
// entries -- and keeps this fixture's derivation trivial to re-verify (a
// single 10-byte TLV, tiled).
fn case_c_too_many_extensions() -> i64 with IO {
    let total_len: i64 = 330
    let buf = rawbuf_new(total_len + 8)

    let bytes: [i64; 330] = [
        0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08,
        0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03,
        0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D,
        0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04,
        0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA,
        0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08,
        0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03,
        0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D,
        0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04,
        0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA,
        0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08,
        0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03,
        0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D,
        0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04,
        0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA,
        0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08,
        0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03,
        0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D,
        0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04,
        0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA,
        0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08,
        0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03,
        0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D,
        0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04,
        0x01, 0xAA, 0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA,
        0x30, 0x08, 0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08,
        0x06, 0x03, 0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA, 0x30, 0x08, 0x06, 0x03,
        0x55, 0x1D, 0x20, 0x04, 0x01, 0xAA,
    ]

    var i: i64 = 0
    while i < total_len {
        rawbuf_set(&buf, i, bytes[i as usize])
        i = i + 1
    }

    // Independently re-confirm the tile count from the byte length: 330 /
    // 10 = 33 extensions, one over X509_MAX_EXTENSIONS (32).
    if total_len / 10 != 33 {
        return 301
    }

    let r = der_reader_new(&buf, 0, total_len)
    let (extensions_raw, extension_count, is_ca, path_len_constraint, key_usage_bits, subject_key_id, subject_key_id_len, authority_key_id, authority_key_id_len, status) = x509_parse_extensions(&buf, &r)

    if status != X509_ERR_TOO_MANY_ENTRIES {
        return 302
    }
    assert(status == X509_ERR_TOO_MANY_ENTRIES)
    0
}

// ---- Case (d): RDN value 129 bytes long (one over X509_MAX_NAME_VALUE_LEN = 128). ----
//
// Name ::= SEQUENCE { RelativeDistinguishedName ::= SET { AttributeTypeAndValue
// ::= SEQUENCE { OID commonName (2.5.4.3), value PrintableString[129] } } }
//
//   value TLV:  0x13, 0x81, 0x81, <129 x 0x41>       = 3 + 129 = 132 bytes
//   ATV TLV:    0x30, 0x81, 0x89, <OID 5B> <value>   = 3 + 5 + 132 = 140 bytes
//   RDN TLV:    0x31, 0x81, 0x8C, <ATV>              = 3 + 140 = 143 bytes
//   Name TLV:   0x30, 0x81, 0x8F, <RDN>              = 3 + 143 = 146 bytes
//
// (All four long-form lengths use the 2-byte form since each content
// length exceeds 127: 129=0x81, 137=0x89, 140=0x8C, 143=0x8F -- confirmed
// independently via a Python `tlv()` helper re-implementation before
// transcription.)
fn case_d_rdn_value_too_long() -> i64 with IO {
    let total_len: i64 = 146
    let buf = rawbuf_new(total_len + 8)

    let bytes: [i64; 146] = [
        0x30, 0x81, 0x8F, 0x31, 0x81, 0x8C, 0x30, 0x81, 0x89, 0x06, 0x03, 0x55,
        0x04, 0x03, 0x13, 0x81, 0x81, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41, 0x41,
        0x41, 0x41,
    ]

    var i: i64 = 0
    while i < total_len {
        rawbuf_set(&buf, i, bytes[i as usize])
        i = i + 1
    }

    // Independently confirm the value payload really is 129 bytes: bytes
    // [17..146) are the value's payload (146 - 17 = 129).
    if total_len - 17 != 129 {
        return 401
    }

    let r = der_reader_new(&buf, 0, total_len)
    let (r2, name_tag, s0) = der_read_tlv(&r)
    if s0 != DER_OK {
        return 402
    }
    let (name, status) = x509_parse_name(&buf, &r, &name_tag)

    if status != X509_ERR_VALUE_TOO_LONG {
        return 403
    }
    assert(status == X509_ERR_VALUE_TOO_LONG)
    0
}

fn main() -> i64 with IO {
    let a = case_a_sig_alg_mismatch()
    if a != 0 {
        print_int(a)
        return 1
    }

    let b = case_b_tampered_tbs_byte()
    if b != 0 {
        print_int(b)
        return 1
    }

    let c = case_c_too_many_extensions()
    if c != 0 {
        print_int(c)
        return 1
    }

    let d = case_d_rdn_value_too_long()
    if d != 0 {
        print_int(d)
        return 1
    }

    println("x509_adversarial: sig-alg mismatch / tampered-TBS / too-many-extensions / RDN-value-too-long all correctly rejected")
    return 0
}
