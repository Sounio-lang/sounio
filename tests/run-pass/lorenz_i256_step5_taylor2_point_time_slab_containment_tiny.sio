//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 point time-slab containment seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 997
    fp = mix(fp, 931268564, 4673)
    fp = mix(fp, 900912795, 4673)
    fp = mix(fp, 5, 4673)
    fp = mix(fp, 256, 4673)
    fp = mix(fp, 32, 4673)
    fp = mix(fp, 1, 4673)
    fp = mix(fp, 100, 4673)
    fp = mix(fp, 9070400, 4673)
    fp = mix(fp, 28932778, 4673)
    fp = mix(fp, 189714, 4673)
    fp = mix(fp, 90704, 4673)
    fp = mix(fp, 289328, 4673)
    fp = mix(fp, 1898, 4673)
    fp = mix(fp, 91000, 4673)
    fp = mix(fp, 290000, 4673)
    fp = mix(fp, 2000, 4673)
    fp = mix(fp, 296, 4673)
    fp = mix(fp, 672, 4673)
    fp = mix(fp, 102, 4673)
    fp = mix(fp, 3, 4673)
    fp = mix(fp, 7, 4673)
    fp = mix(fp, 7, 4673)
    fp = mix(fp, 7, 4673)
    fp = mix(fp, 7, 4673)
    fp = mix(fp, 15, 4673)
    fp = mix(fp, 0, 4673)
    fp = mix(fp, 0, 4673)
    fp = mix(fp, 18, 4673)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 403599593 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1009
    fp = mix(fp, instance, 4679)
    fp = mix(fp, 9070400, 4679)
    fp = mix(fp, 28932778, 4679)
    fp = mix(fp, 189714, 4679)
    fp = mix(fp, 90704, 4679)
    fp = mix(fp, 289328, 4679)
    fp = mix(fp, 1898, 4679)
    fp = mix(fp, 296, 4679)
    fp = mix(fp, 672, 4679)
    fp = mix(fp, 102, 4679)
    fp = mix(fp, 3, 4679)
    fp = mix(fp, 7, 4679)
    fp = mix(fp, 7, 4679)
    fp = mix(fp, 7, 4679)
    fp = mix(fp, 7, 4679)
    fp = mix(fp, 15, 4679)
    fp = mix(fp, 0, 4679)
    fp = mix(fp, 0, 4679)
    fp = mix(fp, 18, 4679)
    fp = mix(fp, ok_mask, 4679)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 403599593 { return 0 - 1 }
    if certificate != 883271225 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1013
    fp = mix(fp, instance, 4691)
    fp = mix(fp, certificate, 4691)
    fp = mix(fp, 19, 4691)
    fp = mix(fp, 5, 4691)
    fp = mix(fp, 7, 4691)
    fp = mix(fp, 15, 4691)
    fp = mix(fp, 0, 4691)
    fp = mix(fp, 0, 4691)
    fp = mix(fp, 18, 4691)
    fp = mix(fp, ok_mask, 4691)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 693506658 { return 0 - 1 }
    if instance != 403599593 { return 0 - 1 }
    if certificate != 883271225 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1019
    fp = mix(fp, artifact, 4703)
    fp = mix(fp, instance, 4703)
    fp = mix(fp, certificate, 4703)
    fp = mix(fp, 931268564, 4703)
    fp = mix(fp, 900912795, 4703)
    fp = mix(fp, 9070400, 4703)
    fp = mix(fp, 28932778, 4703)
    fp = mix(fp, 189714, 4703)
    fp = mix(fp, 90704, 4703)
    fp = mix(fp, 289328, 4703)
    fp = mix(fp, 1898, 4703)
    fp = mix(fp, 91000, 4703)
    fp = mix(fp, 290000, 4703)
    fp = mix(fp, 2000, 4703)
    fp = mix(fp, 5, 4703)
    fp = mix(fp, 18, 4703)
    fp = mix(fp, ok_mask, 4703)
    return fp
}

fn time_slab_ok_mask(global_claim_mask: i64, status: i64) -> i64 {
    let scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let dy_scaled_q: i256 = 133081411987 as i256
    let beta_q: i256 = 10914629546 as i256
    let xy_scaled_q: i256 = 10099814960 as i256
    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let dy_num: i256 = dy_scaled_q - y4
    let dz_num: i256 = beta_q - xy_scaled_q

    var derivative_mask: i64 = 0
    if (9070399 as i256) * scale < dx_num * target_scale {
        if (9070400 as i256) * scale >= dx_num * target_scale { derivative_mask = derivative_mask + 1 }
    }
    if (28932777 as i256) * scale < dy_num * target_scale {
        if (28932778 as i256) * scale >= dy_num * target_scale { derivative_mask = derivative_mask + 2 }
    }
    if (189713 as i256) * scale < dz_num * target_scale {
        if (189714 as i256) * scale >= dz_num * target_scale { derivative_mask = derivative_mask + 4 }
    }

    var sweep_mask: i64 = 0
    if 90703 * 100 < 9070400 {
        if 90704 * 100 >= 9070400 { sweep_mask = sweep_mask + 1 }
    }
    if 289327 * 100 < 28932778 {
        if 289328 * 100 >= 28932778 { sweep_mask = sweep_mask + 2 }
    }
    if 1897 * 100 < 189714 {
        if 1898 * 100 >= 189714 { sweep_mask = sweep_mask + 4 }
    }

    let x_slack: i64 = 91000 - 90704
    let y_slack: i64 = 290000 - 289328
    let z_slack: i64 = 2000 - 1898
    var slab_margin_mask: i64 = 0
    if x_slack == 296 { slab_margin_mask = slab_margin_mask + 1 }
    if y_slack == 672 { slab_margin_mask = slab_margin_mask + 2 }
    if z_slack == 102 { slab_margin_mask = slab_margin_mask + 4 }

    var slab_mask: i64 = 0
    if 90704 <= 91000 { slab_mask = slab_mask + 1 }
    if 289328 <= 290000 { slab_mask = slab_mask + 2 }
    if 1898 <= 2000 { slab_mask = slab_mask + 4 }

    let seed_anchor_mask: i64 = 3
    var local_seed_mask: i64 = 0
    if seed_anchor_mask == 3 { local_seed_mask = local_seed_mask + 1 }
    if derivative_mask == 7 { local_seed_mask = local_seed_mask + 2 }
    if sweep_mask == 7 { local_seed_mask = local_seed_mask + 4 }
    if slab_margin_mask == 7 {
        if slab_mask == 7 { local_seed_mask = local_seed_mask + 8 }
    }

    var ok_mask: i64 = 0
    if seed_anchor_mask == 3 { ok_mask = ok_mask + 1 }
    if derivative_mask == 7 { ok_mask = ok_mask + 2 }
    if sweep_mask == 7 { ok_mask = ok_mask + 4 }
    if slab_margin_mask == 7 { ok_mask = ok_mask + 8 }
    if 1 == 1 {
        if 100 == 100 { ok_mask = ok_mask + 16 }
    }
    if local_seed_mask == 15 { ok_mask = ok_mask + 32 }
    if global_claim_mask == 0 {
        if status == 18 { ok_mask = ok_mask + 64 }
    }
    if local_seed_mask == 15 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = time_slab_ok_mask(0, 18)
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 403599593 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 883271225 { return 3 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 693506658 { return 4 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 389624150 { return 5 }
    if time_slab_ok_mask(1, 18) == 255 { return 6 }
    if certificate_fp(inst, 254) != (0 - 1) { return 7 }
    return 0
}
