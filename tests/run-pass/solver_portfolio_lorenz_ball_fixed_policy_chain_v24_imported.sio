//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v24 Lorenz ball-fixed full policy-chain receipt smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v24_lorenz_policy_chain_instance_fingerprint(
        1000000, 5, 70877465, 231786611, 494960746, 833881722)
    if instance_fp != 703368760 { return 1 }

    let certificate_fp = solver_portfolio_v24_lorenz_policy_chain_certificate_fingerprint(
        instance_fp, 21862303, 4, 15, 15, 1, 1, 1, 1)
    if certificate_fp != 606714830 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_ball_fixed_policy_chain(),
        instance_fp,
        certificate_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_ball_fixed_policy_chain())
    if entry_fp != 777068644 { return 3 }

    let manifest_fp = solver_portfolio_v24_lorenz_ball_fixed_policy_chain_bundle_fingerprint(
        70877465, 231786611, 494960746, 833881722, 21862303)
    if manifest_fp != 654522473 { return 4 }

    let result_coverage_fp = solver_portfolio_v24_result_coverage_fingerprint(
        24, 28, 8, 18, 1, 1, manifest_fp)
    if result_coverage_fp != 351276693 { return 5 }

    let family_coverage_fp = solver_portfolio_v24_checker_family_coverage_fingerprint(
        24, 28, 4, 3, 2, 1, 18, manifest_fp)
    if family_coverage_fp != 421318006 { return 6 }

    let acceptance_fp = solver_portfolio_v24_acceptance_receipt_fingerprint(
        24, manifest_fp, result_coverage_fp)
    if acceptance_fp != 977323540 { return 7 }

    let audit_fp = solver_portfolio_v24_audit_receipt_fingerprint(
        24, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 782172696 { return 8 }

    let readiness_fp = solver_portfolio_v24_readiness_fingerprint(
        24, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 327542064 { return 9 }

    if solver_portfolio_v24_lorenz_ball_fixed_policy_chain_bundle_fingerprint(
        70877465, 231786611, 494960746, 833881723, 21862303) != (0 - 1) { return 10 }
    if solver_portfolio_v24_lorenz_ball_fixed_policy_chain_bundle_fingerprint(
        70877465, 231786611, 494960746, 833881722, 21862304) != (0 - 1) { return 11 }
    if solver_portfolio_v24_result_coverage_fingerprint(
        24, 28, 8, 17, 1, 1, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v24_checker_family_coverage_fingerprint(
        24, 28, 4, 3, 2, 1, 17, manifest_fp) != (0 - 1) { return 13 }
    if solver_portfolio_v24_readiness_fingerprint(
        24, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 14 }

    return 0
}
