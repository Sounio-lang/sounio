//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz Taylor-2 step-request receipt over the v47 rational schedule

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn step_request_fingerprint(schedule_fp: i64, schedule_audit_fp: i64) -> i64 {
    if schedule_fp != 353612555 { return 0 - 1 }
    if schedule_audit_fp != 335541872 { return 0 - 1 }

    let v47_step_schedule_receipt_fp: i64 = 842631931
    let v47_step_schedule_portfolio_audit_fp: i64 = 13881891
    let v47_readiness_fp: i64 = 224324310
    let trajectory_manifest_fp: i64 = 214180161
    let final_enclosure_receipt_fp: i64 = 114244647
    let dependency_dag_fp: i64 = 713010204
    let step_index: i64 = 6
    let taylor_order: i64 = 2
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let scale_log2: i64 = 32
    let source_width_bits: i64 = 256
    let bit_headroom: i64 = 184
    let min_bit_headroom: i64 = 180
    let target_remainder_ppm: i64 = 15000
    let max_dt_den_cap: i64 = 200
    let schedule_mask: i64 = 127
    let request_status_pending: i64 = 1

    var request_mask: i64 = 0
    if step_index == 6 { request_mask = request_mask + 1 }
    if taylor_order == 2 { request_mask = request_mask + 2 }
    if selected_dt_num == 1 {
        if selected_dt_den == 100 {
            request_mask = request_mask + 4
        }
    }
    if source_width_bits == 256 {
        if scale_log2 == 32 {
            request_mask = request_mask + 8
        }
    }
    if bit_headroom >= min_bit_headroom { request_mask = request_mask + 16 }
    if target_remainder_ppm <= 15000 { request_mask = request_mask + 32 }
    if schedule_mask == 127 {
        if selected_dt_den <= max_dt_den_cap {
            request_mask = request_mask + 64
        }
    }
    if request_mask != 127 { return 0 - 1 }

    var fp: i64 = 593
    fp = quality_mix(fp, schedule_fp)
    fp = quality_mix(fp, schedule_audit_fp)
    fp = quality_mix(fp, v47_step_schedule_receipt_fp)
    fp = quality_mix(fp, v47_step_schedule_portfolio_audit_fp)
    fp = quality_mix(fp, v47_readiness_fp)
    fp = quality_mix(fp, trajectory_manifest_fp)
    fp = quality_mix(fp, final_enclosure_receipt_fp)
    fp = quality_mix(fp, dependency_dag_fp)
    fp = quality_mix(fp, step_index)
    fp = quality_mix(fp, taylor_order)
    fp = quality_mix(fp, selected_dt_num)
    fp = quality_mix(fp, selected_dt_den)
    fp = quality_mix(fp, scale_log2)
    fp = quality_mix(fp, source_width_bits)
    fp = quality_mix(fp, bit_headroom)
    fp = quality_mix(fp, min_bit_headroom)
    fp = quality_mix(fp, target_remainder_ppm)
    fp = quality_mix(fp, max_dt_den_cap)
    fp = quality_mix(fp, request_mask)
    fp = quality_mix(fp, request_status_pending)
    return fp
}

fn step_request_audit_fingerprint(request_fp: i64) -> i64 {
    if request_fp != 510353327 { return 0 - 1 }

    var fp: i64 = 599
    fp = quality_mix(fp, request_fp)
    fp = quality_mix(fp, 353612555)
    fp = quality_mix(fp, 335541872)
    fp = quality_mix(fp, 842631931)
    fp = quality_mix(fp, 13881891)
    fp = quality_mix(fp, 224324310)
    fp = quality_mix(fp, 6)
    fp = quality_mix(fp, 127)
    return fp
}

fn main() -> i64 {
    let fp = step_request_fingerprint(353612555, 335541872)
    if fp != 510353327 { return 1 }

    let audit_fp = step_request_audit_fingerprint(fp)
    if audit_fp != 465022480 { return 2 }

    if step_request_fingerprint(353612556, 335541872) != (0 - 1) { return 3 }
    if step_request_audit_fingerprint(510353328) != (0 - 1) { return 4 }
    return 0
}
