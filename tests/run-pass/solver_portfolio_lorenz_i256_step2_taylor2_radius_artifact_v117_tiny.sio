//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v117 smoke for Lorenz i256 step-2 Taylor-2 radius artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1811
    receipt_fp = mix(receipt_fp, 443171640, 5743)
    receipt_fp = mix(receipt_fp, 790224648, 5743)
    receipt_fp = mix(receipt_fp, 756645477, 5743)
    receipt_fp = mix(receipt_fp, 787573492, 5743)
