    receipt_fp = mix(receipt_fp, 905577950, 5743)
    receipt_fp = mix(receipt_fp, 812289972, 5743)
    receipt_fp = mix(receipt_fp, 554654324, 5743)
    receipt_fp = mix(receipt_fp, 135610689, 5743)
    receipt_fp = mix(receipt_fp, 2, 5743)
    receipt_fp = mix(receipt_fp, 2, 5743)
    receipt_fp = mix(receipt_fp, 127, 5743)
    if receipt_fp != 672985867 { return 1 }

    var audit_fp: i64 = 1823
    audit_fp = mix(audit_fp, receipt_fp, 5749)
    audit_fp = mix(audit_fp, 443171640, 5749)
    audit_fp = mix(audit_fp, 790224648, 5749)
    audit_fp = mix(audit_fp, 756645477, 5749)
    audit_fp = mix(audit_fp, 787573492, 5749)
    audit_fp = mix(audit_fp, 554654324, 5749)
    audit_fp = mix(audit_fp, 135610689, 5749)
    audit_fp = mix(audit_fp, 812289972, 5749)
    audit_fp = mix(audit_fp, 2, 5749)
    audit_fp = mix(audit_fp, 2, 5749)
    audit_fp = mix(audit_fp, 127, 5749)
    if audit_fp != 261444715 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 120, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 120, 1103)
    if entry_fp != 177395598 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 117, 1151)
    manifest_fp = mix(manifest_fp, 121, 1151)
    manifest_fp = mix(manifest_fp, 905577950, 1151)
    manifest_fp = mix(manifest_fp, 711786580, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 213780817 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 117, 1871)
    result_fp = mix(result_fp, 121, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 109, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 726523188 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 117, 1907)
    family_fp = mix(family_fp, 121, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 104, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 325150296 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 117, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 75038092 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 117, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 493806823 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 117, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
