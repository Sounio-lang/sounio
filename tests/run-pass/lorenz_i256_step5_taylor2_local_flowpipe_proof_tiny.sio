//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 local flowpipe proof receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1549
    fp = mix(fp, 5, 5413)
    fp = mix(fp, 108175917, 5413)
    fp = mix(fp, 495875254, 5413)
    fp = mix(fp, 253054033, 5413)
    fp = mix(fp, 661134385, 5413)
    fp = mix(fp, 291436394, 5413)
    fp = mix(fp, 876674722, 5413)
    fp = mix(fp, 422368008, 5413)
    fp = mix(fp, 577119901, 5413)
    fp = mix(fp, 69995750, 5413)
    fp = mix(fp, 380914208, 5413)
    fp = mix(fp, 931268564, 5413)
    fp = mix(fp, 900912795, 5413)
    fp = mix(fp, 7, 5413)
    fp = mix(fp, 7, 5413)
    fp = mix(fp, 127, 5413)
    fp = mix(fp, 127, 5413)
    fp = mix(fp, 15, 5413)
    fp = mix(fp, 15, 5413)
    fp = mix(fp, 15, 5413)
    fp = mix(fp, 0, 5413)
    fp = mix(fp, 21, 5413)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 251889352 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1553
    fp = mix(fp, instance, 5417)
    fp = mix(fp, 7, 5417)
    fp = mix(fp, 7, 5417)
    fp = mix(fp, 127, 5417)
    fp = mix(fp, 127, 5417)
    fp = mix(fp, 15, 5417)
    fp = mix(fp, 15, 5417)
    fp = mix(fp, 15, 5417)
    fp = mix(fp, 0, 5417)
    fp = mix(fp, 21, 5417)
    fp = mix(fp, ok_mask, 5417)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 251889352 { return 0 - 1 }
    if certificate != 67726687 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1559
    fp = mix(fp, instance, 5419)
    fp = mix(fp, certificate, 5419)
    fp = mix(fp, 16, 5419)
    fp = mix(fp, 5, 5419)
    fp = mix(fp, 15, 5419)
    fp = mix(fp, 15, 5419)
    fp = mix(fp, 0, 5419)
    fp = mix(fp, 21, 5419)
    fp = mix(fp, ok_mask, 5419)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 965829478 { return 0 - 1 }
    if instance != 251889352 { return 0 - 1 }
    if certificate != 67726687 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1567
    fp = mix(fp, artifact, 5431)
    fp = mix(fp, instance, 5431)
    fp = mix(fp, certificate, 5431)
    fp = mix(fp, 108175917, 5431)
    fp = mix(fp, 495875254, 5431)
    fp = mix(fp, 253054033, 5431)
    fp = mix(fp, 661134385, 5431)
    fp = mix(fp, 291436394, 5431)
    fp = mix(fp, 876674722, 5431)
    fp = mix(fp, 422368008, 5431)
    fp = mix(fp, 577119901, 5431)
    fp = mix(fp, 69995750, 5431)
    fp = mix(fp, 380914208, 5431)
    fp = mix(fp, 931268564, 5431)
    fp = mix(fp, 900912795, 5431)
    fp = mix(fp, 5, 5431)
    fp = mix(fp, 21, 5431)
    fp = mix(fp, ok_mask, 5431)
    return fp
}

fn proof_mask() -> i64 {
    let endpoint_mask: i64 = 7
    let slab_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_mask: i64 = 127
    var composition_mask: i64 = 0
    if endpoint_mask == 7 { composition_mask = composition_mask + 1 }
    if slab_mask == 7 { composition_mask = composition_mask + 2 }
    if response_mask == 127 { composition_mask = composition_mask + 4 }
    if remainder_mask == 127 { composition_mask = composition_mask + 8 }

    let local_obligation_mask: i64 = composition_mask
    let local_proof_mask: i64 = composition_mask
    let global_claim_mask: i64 = 0
    let status: i64 = 21

    var ok_mask: i64 = 0
    if 108175917 > 0 {
        if 495875254 > 0 { ok_mask = ok_mask + 1 }
    }
    if 253054033 > 0 {
        if 291436394 > 0 { ok_mask = ok_mask + 2 }
    }
    if 422368008 > 0 {
        if 69995750 > 0 { ok_mask = ok_mask + 4 }
    }
    if 931268564 > 0 { ok_mask = ok_mask + 8 }
    if local_obligation_mask == 15 {
        if local_proof_mask == 15 { ok_mask = ok_mask + 16 }
    }
    if global_claim_mask == 0 {
        if status == 21 { ok_mask = ok_mask + 32 }
    }
    if 2 == 2 {
        if 256 == 256 { ok_mask = ok_mask + 64 }
    }
    if local_proof_mask == 15 {
        if 500992858 > 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = proof_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 251889352 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 67726687 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 965829478 { return 4 }
    let audit = audit_fp(art, inst, cert, ok_mask)
    if audit != 618466007 { return 5 }
    if certificate_fp(inst, 254) != (0 - 1) { return 6 }
    return 0
}
