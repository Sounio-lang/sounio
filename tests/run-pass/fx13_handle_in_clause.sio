//@ run-pass
//@ requires: madaros
//@ expect-stdout: 5
//@ description: FX-9 a handle installed inside a clause body dispatches to its own frame, not the enclosing clause frame (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-9

effect A { fn a() -> i64 }
effect B { fn b() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<A> { perform A.a() } with {
        on a() -> {
            let q = handle<B> { perform B.b() } with { on b() -> 5 }
            resume(q)
        }
    }
    println(r)
    0
}
