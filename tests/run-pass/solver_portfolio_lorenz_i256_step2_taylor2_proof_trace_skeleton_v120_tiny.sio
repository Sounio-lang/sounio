//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v120 smoke for Lorenz i256 step-2 Taylor-2 proof-trace skeleton

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1919
    receipt_fp = mix(receipt_fp, 976546207, 5881)
    receipt_fp = mix(receipt_fp, 892326627, 5881)
    receipt_fp = mix(receipt_fp, 563006672, 5881)
    receipt_fp = mix(receipt_fp, 602593763, 5881)
    receipt_fp = mix(receipt_fp, 248874394, 5881)
    receipt_fp = mix(receipt_fp, 888484153, 5881)
    receipt_fp = mix(receipt_fp, 998736898, 5881)
    receipt_fp = mix(receipt_fp, 725374434, 5881)
    receipt_fp = mix(receipt_fp, 571048339, 5881)
    receipt_fp = mix(receipt_fp, 2, 5881)
    receipt_fp = mix(receipt_fp, 6, 5881)
    receipt_fp = mix(receipt_fp, 255, 5881)
    if receipt_fp != 723878614 { return 1 }

    var audit_fp: i64 = 1931
    audit_fp = mix(audit_fp, receipt_fp, 5897)
    audit_fp = mix(audit_fp, 976546207, 5897)
    audit_fp = mix(audit_fp, 892326627, 5897)
    audit_fp = mix(audit_fp, 563006672, 5897)
    audit_fp = mix(audit_fp, 602593763, 5897)
    audit_fp = mix(audit_fp, 725374434, 5897)
    audit_fp = mix(audit_fp, 571048339, 5897)
    audit_fp = mix(audit_fp, 998736898, 5897)
    audit_fp = mix(audit_fp, 2, 5897)
    audit_fp = mix(audit_fp, 6, 5897)
    audit_fp = mix(audit_fp, 255, 5897)
    if audit_fp != 661341285 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 123, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 123, 1103)
    if entry_fp != 73960392 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 120, 1151)
    manifest_fp = mix(manifest_fp, 124, 1151)
    manifest_fp = mix(manifest_fp, 888484153, 1151)
    manifest_fp = mix(manifest_fp, 248874394, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 787471364 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 120, 1871)
    result_fp = mix(result_fp, 124, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 112, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 189270428 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 120, 1907)
    family_fp = mix(family_fp, 124, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 107, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 902179049 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 120, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 383893026 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 120, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 492151843 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 120, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 558083306 { return 9 }
    return 0
}
