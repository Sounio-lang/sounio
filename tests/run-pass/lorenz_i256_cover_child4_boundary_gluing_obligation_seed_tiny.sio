//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 boundary-gluing obligation seed

fn child4_boundary_gluing_obligation_seed_check(
    child4_discharge_obligation_bundle_fp: i64,
    child4_discharge_obligation_bundle_audit_fp: i64,
    child4_promotion_guard_fp: i64,
    child4_promotion_guard_audit_fp: i64,
    required_boundary_gluing_mask: i64,
    missing_discharge_proof_mask: i64,
    pending_child_discharge_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    gluing_status: i64) -> i64 {
    if child4_discharge_obligation_bundle_fp != 741805623 { return 0 - 1 }
    if child4_discharge_obligation_bundle_audit_fp != 529164708 { return 0 - 1 }
    if child4_promotion_guard_fp != 657240918 { return 0 - 1 }
    if child4_promotion_guard_audit_fp != 312489670 { return 0 - 1 }
    if required_boundary_gluing_mask != 31 { return 0 - 1 }
    if missing_discharge_proof_mask != 255 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if gluing_status != 78 { return 0 - 1 }
    return 604182937
}

fn main() -> i64 {
    let artifact = child4_boundary_gluing_obligation_seed_check(
        741805623, 529164708, 657240918, 312489670, 31, 255, 255, 0, 0, 0, 0, 78)
    if artifact != 604182937 { return 1 }

    let audit_fp: i64 = 218570463
    let instance_fp: i64 = 785604219
    let certificate_fp: i64 = 140926774
    let boundary_face_count: i64 = 5
    let boundary_gluing_obligation_mask: i64 = 31
    let boundary_gluing_pending_mask: i64 = 31
    let boundary_gluing_verified_mask: i64 = 0
    let boundary_gluing_candidate_mask: i64 = 0
    let boundary_gluing_audit_mask: i64 = 31
    let solver_boundary_action_mask: i64 = 31
    let ready_for_child_discharge_mask: i64 = 0
    let ok_mask: i64 = 255

    if audit_fp != 218570463 { return 2 }
    if instance_fp != 785604219 { return 3 }
    if certificate_fp != 140926774 { return 4 }
    if boundary_face_count != 5 { return 5 }
    if boundary_gluing_obligation_mask != 31 { return 6 }
    if boundary_gluing_pending_mask != 31 { return 7 }
    if boundary_gluing_verified_mask != 0 { return 8 }
    if boundary_gluing_candidate_mask != 0 { return 9 }
    if boundary_gluing_audit_mask != 31 { return 10 }
    if solver_boundary_action_mask != 31 { return 11 }
    if ready_for_child_discharge_mask != 0 { return 12 }
    if ok_mask != 255 { return 13 }

    let wrong_bundle = child4_boundary_gluing_obligation_seed_check(
        1, 529164708, 657240918, 312489670, 31, 255, 255, 0, 0, 0, 0, 78)
    if wrong_bundle != 0 - 1 { return 14 }

    let fake_gluing_proof = child4_boundary_gluing_obligation_seed_check(
        741805623, 529164708, 657240918, 312489670, 31, 255, 255, 1, 0, 0, 0, 78)
    if fake_gluing_proof != 0 - 1 { return 15 }

    let fake_discharge_ready = child4_boundary_gluing_obligation_seed_check(
        741805623, 529164708, 657240918, 312489670, 31, 255, 0, 0, 0, 0, 0, 78)
    if fake_discharge_ready != 0 - 1 { return 16 }

    let fake_global = child4_boundary_gluing_obligation_seed_check(
        741805623, 529164708, 657240918, 312489670, 31, 255, 255, 0, 0, 0, 1, 78)
    if fake_global != 0 - 1 { return 17 }

    return 0
}
