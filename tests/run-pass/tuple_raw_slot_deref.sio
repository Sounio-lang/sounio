//@ run-pass
//@ expect-stdout: TUPLE_RAW_SLOT_OK
// #2966 (gen2 != gen3 in item_fn_def_ptr): opt_expr_managed_object_source
// returns `(*mut Expr, i64)` and its caller reads `&(*managed.0)`. A raw
// pointer from `v as *mut S` addresses the first field (object base + header),
// but a tuple slot was never known to be raw: `(*t.0).f` loaded word 0 and
// `&(*t.0)` handed a `&S` callee the payload one header late (ud2 here; in
// gen2 the cast operand lowered as a constant). A `*mut S` tuple slot is now
// recorded from the callee's return type and read as the raw payload it is.
struct Node { kind: i64, val: i64, w: i64 }

fn read_kind(n: &Node) -> i64 { n.kind * 100 + n.val }

fn mk(b: Box<Node>) -> (*mut Node, i64) { (b as *mut Node, 2) }

fn main() -> i32 with IO, Mut, Panic, Div {
    let t = mk(Box::new(Node { kind: 3, val: 4, w: 1 }))
    let direct = (*t.0).kind
    let reborrow = read_kind(&(*t.0))
    let q = t.0
    let via_let = read_kind(&(*q)) + (*q).w
    if direct == 3 && reborrow == 304 && via_let == 305 && t.1 == 2 {
        println("TUPLE_RAW_SLOT_OK")
    } else {
        print("TUPLE_RAW_SLOT_FAIL ")
        print_int(direct)
        print(" ")
        print_int(reborrow)
        print(" ")
        print_int(via_let)
        println("")
    }
    0
}
