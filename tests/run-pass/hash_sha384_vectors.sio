//@ run-pass
use hash::sha384::*
use net::socket::*

fn write_str(buf: &RawBuf, s: string) -> i64 with IO {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        rawbuf_set(buf, i, str_char_at(s, i))
        i = i + 1
    }
    n
}

fn hex_nibble_to_char(nibble: i64) -> i64 {
    if nibble < 10 {
        48 + nibble
    } else {
        87 + nibble
    }
}

// Compares all 48 bytes of `digest` against the 96-hex-char string
// `expected_hex`. SHA-384's 96-hex-char (98-byte) literals are safely
// under the ~126-content-character silent-truncation limit (Finding 17),
// so no split-literal workaround is needed here (unlike Task 5's
// 128-hex-char SHA-512 digests).
fn assert_digest_hex(digest: [u8; 48], expected_hex: string) with IO {
    var i: i64 = 0
    while i < 48 {
        let byte_val = digest[i as usize] as i64
        let hi_nibble = byte_val / 16
        let lo_nibble = byte_val - hi_nibble * 16
        let expected_hi = str_char_at(expected_hex, i * 2)
        let expected_lo = str_char_at(expected_hex, i * 2 + 1)
        assert(hex_nibble_to_char(hi_nibble) == expected_hi)
        assert(hex_nibble_to_char(lo_nibble) == expected_lo)
        i = i + 1
    }
}

fn main() with IO {
    let buf1 = rawbuf_new(1)
    let d1 = sha384(&buf1, 0)
    assert_digest_hex(
        d1,
        "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"
    )

    let buf2 = rawbuf_new(3)
    let len2 = write_str(&buf2, "abc")
    let d2 = sha384(&buf2, len2)
    assert_digest_hex(
        d2,
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"
    )

    let msg3 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    let buf3 = rawbuf_new(112)
    let len3 = write_str(&buf3, msg3)
    let d3 = sha384(&buf3, len3)
    assert_digest_hex(
        d3,
        "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039"
    )

    println("hash_sha384_vectors: all cases passed")
}
