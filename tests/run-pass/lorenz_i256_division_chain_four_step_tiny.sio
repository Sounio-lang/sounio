//@ run-pass
//@ requires: madaros
//@ description: Four-step Lorenz i256 quotient/remainder witness chain without source-level i256 division

fn chain_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn lorenz_i256_step4_certificate_fingerprint(start_x: i64, start_y: i64, start_z: i64,
                                             dy_scaled_q: i64, dy_scaled_r: i64,
                                             xy_scaled_q: i64, xy_scaled_r: i64,
                                             beta_q: i64, beta_r: i64,
                                             x_inc_q: i64, x_inc_r: i64,
                                             y_inc_q: i64, y_inc_r: i64,
                                             z_drop_q: i64, z_drop_r: i64,
                                             final_x: i64, final_y: i64, final_z: i64,
                                             all_divisions_ok: i64) -> i64 with Mod {
    if start_x != 4617762706 { return 0 - 1 }
    if start_y != 7643846696 { return 0 - 1 }
    if start_z != 4120687759 { return 0 - 1 }
    if dy_scaled_q != 124866970867 { return 0 - 1 }
    if dy_scaled_r != 1906281842 { return 0 - 1 }
    if xy_scaled_q != 8218332706 { return 0 - 1 }
    if xy_scaled_r != 3252936400 { return 0 - 1 }
    if beta_q != 10988500690 { return 0 - 1 }
    if beta_r != 2 { return 0 - 1 }
    if x_inc_q != 302608392 { return 0 - 1 }
    if x_inc_r != 1014364768 { return 0 - 1 }
    if y_inc_q != 1172231215 { return 0 - 1 }
    if y_inc_r != 2184377272 { return 0 - 1 }
    if z_drop_q != 27701679 { return 0 - 1 }
    if z_drop_r != 948411264 { return 0 - 1 }
    if final_x != 4920371098 { return 0 - 1 }
    if final_y != 8816077911 { return 0 - 1 }
    if final_z != 4092986080 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 197
    fp = chain_mix(fp, start_x, 1531)
    fp = chain_mix(fp, start_y, 1531)
    fp = chain_mix(fp, start_z, 1531)
    fp = chain_mix(fp, dy_scaled_q, 1531)
    fp = chain_mix(fp, dy_scaled_r, 1531)
    fp = chain_mix(fp, xy_scaled_q, 1531)
    fp = chain_mix(fp, xy_scaled_r, 1531)
    fp = chain_mix(fp, beta_q, 1531)
    fp = chain_mix(fp, beta_r, 1531)
    fp = chain_mix(fp, x_inc_q, 1531)
    fp = chain_mix(fp, x_inc_r, 1531)
    fp = chain_mix(fp, y_inc_q, 1531)
    fp = chain_mix(fp, y_inc_r, 1531)
    fp = chain_mix(fp, z_drop_q, 1531)
    fp = chain_mix(fp, z_drop_r, 1531)
    fp = chain_mix(fp, final_x, 1531)
    fp = chain_mix(fp, final_y, 1531)
    fp = chain_mix(fp, final_z, 1531)
    fp = chain_mix(fp, all_divisions_ok, 1531)
    return fp
}

fn lorenz_i256_four_step_chain_fingerprint(step_count: i64,
                                            step1_certificate_fp: i64,
                                            step2_certificate_fp: i64,
                                            step3_certificate_fp: i64,
                                            step4_certificate_fp: i64,
                                            final_x: i64, final_y: i64,
                                            final_z: i64) -> i64 with Mod {
    if step_count != 4 { return 0 - 1 }
    if step1_certificate_fp != 510854875 { return 0 - 1 }
    if step2_certificate_fp != 899209716 { return 0 - 1 }
    if step3_certificate_fp != 603078026 { return 0 - 1 }
    if step4_certificate_fp != 753371133 { return 0 - 1 }
    if final_x != 4920371098 { return 0 - 1 }
    if final_y != 8816077911 { return 0 - 1 }
    if final_z != 4092986080 { return 0 - 1 }

    var fp: i64 = 199
    fp = chain_mix(fp, step_count, 1543)
    fp = chain_mix(fp, step1_certificate_fp, 1543)
    fp = chain_mix(fp, step2_certificate_fp, 1543)
    fp = chain_mix(fp, step3_certificate_fp, 1543)
    fp = chain_mix(fp, step4_certificate_fp, 1543)
    fp = chain_mix(fp, final_x, 1543)
    fp = chain_mix(fp, final_y, 1543)
    fp = chain_mix(fp, final_z, 1543)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256

    let x3: i256 = 4617762706 as i256
    let y3: i256 = 7643846696 as i256
    let z3: i256 = 4120687759 as i256
    let rho: i256 = 28 as i256

    let dx_num: i256 = (10 as i256) * (y3 - x3)
    let rho_scale_minus_z: i256 = (rho * scale) - z3
    let dy_num: i256 = x3 * rho_scale_minus_z
    let xy_num: i256 = x3 * y3
    let beta_num_z: i256 = (8 as i256) * z3

    let dy_scaled_q: i256 = 124866970867 as i256
    let dy_scaled_r: i256 = 1906281842 as i256
    let xy_scaled_q: i256 = 8218332706 as i256
    let xy_scaled_r: i256 = 3252936400 as i256
    let beta_q: i256 = 10988500690 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 302608392 as i256
    let x_inc_r: i256 = 1014364768 as i256
    let y_inc_q: i256 = 1172231215 as i256
    let y_inc_r: i256 = 2184377272 as i256
    let z_drop_q: i256 = 27701679 as i256
    let z_drop_r: i256 = 948411264 as i256

    let dy: i256 = dy_scaled_q - y3
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dy_scaled_ok = check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r)

    var all_divisions_ok: i64 = 0
    if dy_scaled_ok == 1 {
        if xy_scaled_ok == 1 {
            if beta_ok == 1 {
                if x_inc_ok == 1 {
                    if y_inc_ok == 1 {
                        if z_drop_ok == 1 { all_divisions_ok = 1 }
                    }
                }
            }
        }
    }

    let x4: i256 = x3 + x_inc_q
    let y4: i256 = y3 + y_inc_q
    let z4: i256 = z3 - z_drop_q

    let step4_fp = lorenz_i256_step4_certificate_fingerprint(
        4617762706, 7643846696, 4120687759,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080, all_divisions_ok)
    let chain_fp = lorenz_i256_four_step_chain_fingerprint(
        4, 510854875, 899209716, 603078026, step4_fp,
        4920371098, 8816077911, 4092986080)

    if all_divisions_ok != 1 { return 1 }
    if dx_num != 30260839900 as i256 { return 2 }
    if dy != 117223124171 as i256 { return 3 }
    if dz_drop_num != 2770167984 as i256 { return 4 }
    if x4 != 4920371098 as i256 { return 5 }
    if y4 != 8816077911 as i256 { return 6 }
    if z4 != 4092986080 as i256 { return 7 }
    if step4_fp != 753371133 { return 8 }
    if chain_fp != 737039167 { return 9 }

    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, 3 as i256) != 0 { return 10 }
    if lorenz_i256_step4_certificate_fingerprint(
        4617762706, 7643846696, 4120687759,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411263,
        4920371098, 8816077911, 4092986080, all_divisions_ok) != (0 - 1) { return 11 }
    if lorenz_i256_four_step_chain_fingerprint(
        4, 510854875, 899209716, 603078026, step4_fp,
        4920371098, 8816077912, 4092986080) != (0 - 1) { return 12 }

    return 0
}
