//@ run-pass
//@ requires: madaros
//@ description: Lorenz fourth fixed-point ball transition with i128 centers

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let dt: i128 = 10000 as i128
    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    // Input is the step-3 ball certified by lorenz_i128_ball_three_step.sio.
    let x3: i128 = 1075156 as i128
    let y3: i128 = 1779721 as i128
    let z3: i128 = 959424 as i128
    let xr3: i64 = 20
    let yr3: i64 = 22
    let zr3: i64 = 13

    let dx3: i128 = sigma * (y3 - x3)
    let dy3: i128 = (x3 * ((rho * scale) - z3)) / scale - y3
    let dz3: i128 = (x3 * y3) / scale - (beta_num * z3) / beta_den
    let x4: i128 = x3 + (dt * dx3) / scale
    let y4: i128 = y3 + (dt * dy3) / scale
    let zdrop3: i128 = (dt * ((0 as i128) - dz3)) / scale
    let z4: i128 = z3 - zdrop3

    let dxr3: i64 = 10 * (yr3 + xr3)
    let x_rhoz_r3: i64 = ((1075156 * zr3) + (27040576 * xr3) + (xr3 * zr3)) / 1000000 + 1
    let dyr3: i64 = x_rhoz_r3 + yr3
    let xyr3: i64 = ((1075156 * yr3) + (1779721 * xr3) + (xr3 * yr3)) / 1000000 + 1
    let beta_zr3: i64 = ((8 * zr3) + 2) / 3
    let dzr3: i64 = xyr3 + beta_zr3
    let xr4: i64 = xr3 + (10000 * dxr3) / 1000000 + 1
    let yr4: i64 = yr3 + (10000 * dyr3) / 1000000 + 1
    let zr4: i64 = zr3 + (10000 * dzr3) / 1000000 + 1

    if dx3 != (7045650 as i128) { return 1 }
    if dy3 != (27293116 as i128) { return 2 }
    if dz3 != ((0 as i128) - (644987 as i128)) { return 3 }
    if x4 != (1145612 as i128) { return 4 }
    if y4 != (2052652 as i128) { return 5 }
    if z4 != (952975 as i128) { return 6 }

    if dxr3 != 420 { return 7 }
    if dyr3 != 577 { return 8 }
    if dzr3 != 95 { return 9 }
    if xr4 != 25 { return 10 }
    if yr4 != 28 { return 11 }
    if zr4 != 14 { return 12 }

    return 0
}
