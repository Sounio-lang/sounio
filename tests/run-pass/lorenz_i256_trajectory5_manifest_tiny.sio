//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 five-step quotient/remainder point-trajectory manifest

fn manifest_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn lorenz_i256_trajectory5_manifest_fingerprint(scale_log2: i64,
                                                 dt_q: i64, dt_r: i64,
                                                 step_count: i64,
                                                 initial_x: i64,
                                                 initial_y: i64,
                                                 initial_z: i64,
                                                 chain_anchor: i64,
                                                 final_step_certificate: i64,
                                                 final_x: i64,
                                                 final_y: i64,
                                                 final_z: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if initial_x != 4294967296 { return 0 - 1 }
    if initial_y != 4294967296 { return 0 - 1 }
    if initial_z != 4294967296 { return 0 - 1 }
    if chain_anchor != 23144051 { return 0 - 1 }
    if final_step_certificate != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 191
    fp = manifest_mix(fp, scale_log2, 1487)
    fp = manifest_mix(fp, dt_q, 1487)
    fp = manifest_mix(fp, dt_r, 1487)
    fp = manifest_mix(fp, step_count, 1487)
    fp = manifest_mix(fp, initial_x, 1487)
    fp = manifest_mix(fp, initial_y, 1487)
    fp = manifest_mix(fp, initial_z, 1487)
    fp = manifest_mix(fp, chain_anchor, 1487)
    fp = manifest_mix(fp, final_step_certificate, 1487)
    fp = manifest_mix(fp, final_x, 1487)
    fp = manifest_mix(fp, final_y, 1487)
    fp = manifest_mix(fp, final_z, 1487)
    return fp
}

fn lorenz_i256_trajectory5_manifest_valid(scale_log2: i64,
                                           dt_q: i64, dt_r: i64,
                                           step_count: i64,
                                           chain_anchor: i64,
                                           final_step_certificate: i64,
                                           manifest_fp: i64) -> i64 {
    if scale_log2 != 32 { return 0 }
    if dt_q != 42949672 { return 0 }
    if dt_r != 96 { return 0 }
    if step_count != 5 { return 0 }
    if chain_anchor != 23144051 { return 0 }
    if final_step_certificate != 561641681 { return 0 }
    if manifest_fp != 214180161 { return 0 }
    return 1
}

fn main() -> i64 with Mod {
    let scale: i64 = 4294967296
    let dt_q: i64 = 42949672
    let dt_r: i64 = 96
    let steps: i64 = 5
    let initial_x: i64 = scale
    let initial_y: i64 = scale
    let initial_z: i64 = scale
    let chain_anchor: i64 = 23144051
    let final_step_certificate: i64 = 561641681
    let final_x: i64 = 5309941770
    let final_y: i64 = 10058731223
    let final_z: i64 = 4084837935

    let manifest_fp = lorenz_i256_trajectory5_manifest_fingerprint(
        32, dt_q, dt_r, steps, initial_x, initial_y, initial_z,
        chain_anchor, final_step_certificate, final_x, final_y, final_z)

    if manifest_fp != 214180161 { return 1 }
    if lorenz_i256_trajectory5_manifest_valid(32, dt_q, dt_r, steps,
                                              chain_anchor, final_step_certificate,
                                              manifest_fp) != 1 { return 2 }
    if final_x - initial_x != 1014974474 { return 3 }
    if final_y - initial_y != 5763763927 { return 4 }
    if initial_z - final_z != 210129361 { return 5 }

    if lorenz_i256_trajectory5_manifest_fingerprint(
        32, dt_q, dt_r, steps, initial_x, initial_y, initial_z,
        chain_anchor + 1, final_step_certificate, final_x, final_y, final_z) == manifest_fp { return 6 }
    if lorenz_i256_trajectory5_manifest_fingerprint(
        32, dt_q, dt_r, steps, initial_x, initial_y, initial_z,
        chain_anchor, final_step_certificate, final_x, final_y + 1, final_z) != (0 - 1) { return 7 }
    if lorenz_i256_trajectory5_manifest_valid(32, dt_q, dt_r, steps + 1,
                                              chain_anchor, final_step_certificate,
                                              manifest_fp) != 0 { return 8 }
    if lorenz_i256_trajectory5_manifest_valid(32, dt_q, dt_r, steps,
                                              chain_anchor, final_step_certificate + 1,
                                              manifest_fp) != 0 { return 9 }

    return 0
}
