//@ run-pass
//@ requires: madaros
//@ expect-stdout: SLICE_ELEMENT_STRUCT_TYPE PASS
//
// A struct element taken from a slice parameter keeps its struct type.
// Madaros recorded no type for `entries: &[Entry]`, for `let e = entries[i]`,
// or for `let e: Entry = ...`, so a string field of the element had no string
// evidence: `print(e.label)` was refused at lowering ("unresolved scalar kind")
// and `e.label.len()` became a call to a body-less free fn `len` (ud2 stub).
struct Entry {
    label: string,
    value: f64,
}

fn total_len(entries: &[Entry], n: i64) -> i64 with Mut, Panic, IO {
    var acc: i64 = 0
    var i: i64 = 0
    while i < n {
        let e = entries[i as usize]
        print(e.label)
        acc = acc + e.label.len() as i64
        let t: Entry = entries[i as usize]
        acc = acc + t.label.len() as i64
        print(entries[i as usize].label)
        acc = acc + entries[i as usize].label.len() as i64
        i = i + 1
    }
    println("")
    acc
}

fn main() -> i32 with IO, Mut, Panic {
    let es = [Entry { label: "ab", value: 1.0 }, Entry { label: "cde", value: 2.0 }]
    let total = total_len(&es, 2)
    // (2 + 3) counted three times per element
    if total == 15 {
        println("SLICE_ELEMENT_STRUCT_TYPE PASS")
        return 0
    }
    1
}
