//@ run-pass
//@ description: Minimal HeapI64Vec test

fn main() -> i64 with IO, Alloc {
    // Direct heap allocation test (bypassing heap_vec for now)
    let ptr = heap_alloc(64)
    
    write_i64(ptr, 0, 42)
    let val = read_i64(ptr, 0)
    
    heap_free(ptr)
    
    if val == 42 {
        print("heap_vec_minimal: PASS\n")
        return 0
    } else {
        print("heap_vec_minimal: FAIL\n")
        return 1
    }
}
