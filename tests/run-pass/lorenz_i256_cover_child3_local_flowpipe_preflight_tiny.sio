//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-3 local-flowpipe preflight receipt

fn child3_local_flowpipe_preflight_check(
    child3_obligation_seed_fp: i64,
    child3_obligation_seed_audit_fp: i64,
    child2_discharge_preflight_fp: i64,
    child2_discharge_preflight_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    preflight_status: i64) -> i64 {
    if child3_obligation_seed_fp != 853502997 { return 0 - 1 }
    if child3_obligation_seed_audit_fp != 176202003 { return 0 - 1 }
    if child2_discharge_preflight_fp != 865117026 { return 0 - 1 }
    if child2_discharge_preflight_audit_fp != 22656757 { return 0 - 1 }
    if five_step_local_flowpipe_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_flowpipe_chain_audit_fp != 709377850 { return 0 - 1 }
    if child_index != 3 { return 0 - 1 }
    if slot_x != 1 { return 0 - 1 }
    if slot_y != 1 { return 0 - 1 }
    if slot_z != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if preflight_status != 69 { return 0 - 1 }
    return 730124563
}

fn main() -> i64 {
    let artifact = child3_local_flowpipe_preflight_check(
        853502997, 176202003, 865117026, 22656757, 911209450, 709377850,
        3, 1, 1, 0, 0, 69)
    if artifact != 730124563 { return 1 }

    let audit_fp: i64 = 713941204
    let instance_fp: i64 = 362477255
    let certificate_fp: i64 = 911332062
    let selected_child_mask: i64 = 8
    let prior_child_validated_mask: i64 = 7
    let pending_child_validation_mask: i64 = 24
    let local_flowpipe_preflight_mask: i64 = 31
    let proof_dependency_mask: i64 = 31
    let available_local_chain_mask: i64 = 31
    let pending_local_proof_mask: i64 = 31
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let preflight_status: i64 = 69
    let ok_mask: i64 = 255

    if audit_fp != 713941204 { return 2 }
    if instance_fp != 362477255 { return 3 }
    if certificate_fp != 911332062 { return 4 }
    if selected_child_mask != 8 { return 5 }
    if prior_child_validated_mask != 7 { return 6 }
    if pending_child_validation_mask != 24 { return 7 }
    if local_flowpipe_preflight_mask != 31 { return 8 }
    if proof_dependency_mask != 31 { return 9 }
    if available_local_chain_mask != 31 { return 10 }
    if pending_local_proof_mask != 31 { return 11 }
    if local_flowpipe_proof_mask != 0 { return 12 }
    if child_validated_mask != 0 { return 13 }
    if child_discharge_mask != 0 { return 14 }
    if global_cover_certificate_mask != 0 { return 15 }
    if global_flowpipe_claim_mask != 0 { return 16 }
    if preflight_status != 69 { return 17 }
    if ok_mask != 255 { return 18 }

    let wrong_slot = child3_local_flowpipe_preflight_check(
        853502997, 176202003, 865117026, 22656757, 911209450, 709377850,
        3, 0, 1, 0, 0, 69)
    if wrong_slot != 0 - 1 { return 19 }

    let wrong_chain = child3_local_flowpipe_preflight_check(
        853502997, 176202003, 865117026, 22656757, 1, 709377850,
        3, 1, 1, 0, 0, 69)
    if wrong_chain != 0 - 1 { return 20 }

    let overclaim = child3_local_flowpipe_preflight_check(
        853502997, 176202003, 865117026, 22656757, 911209450, 709377850,
        3, 1, 1, 0, 1, 69)
    if overclaim != 0 - 1 { return 21 }

    return 0
}
