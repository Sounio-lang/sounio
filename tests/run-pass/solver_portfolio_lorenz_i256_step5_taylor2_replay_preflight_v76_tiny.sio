//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v76 smoke for Lorenz i256 step-5 Taylor-2 replay preflight entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1307
    receipt_fp = mix(receipt_fp, 847188269, 5099)
    receipt_fp = mix(receipt_fp, 425385087, 5099)
    receipt_fp = mix(receipt_fp, 797401729, 5099)
    receipt_fp = mix(receipt_fp, 698709746, 5099)
    receipt_fp = mix(receipt_fp, 466346197, 5099)
    receipt_fp = mix(receipt_fp, 5, 5099)
    receipt_fp = mix(receipt_fp, 7, 5099)
    receipt_fp = mix(receipt_fp, 255, 5099)
    if receipt_fp != 513561777 { return 1 }

    var audit_fp: i64 = 1319
    audit_fp = mix(audit_fp, receipt_fp, 5101)
    audit_fp = mix(audit_fp, 847188269, 5101)
    audit_fp = mix(audit_fp, 425385087, 5101)
    audit_fp = mix(audit_fp, 722867370, 5101)
    audit_fp = mix(audit_fp, 605882312, 5101)
    audit_fp = mix(audit_fp, 466346197, 5101)
    audit_fp = mix(audit_fp, 5, 5101)
    audit_fp = mix(audit_fp, 7, 5101)
    audit_fp = mix(audit_fp, 255, 5101)
    if audit_fp != 3618606 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 79, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 79, 1103)
    if entry_fp != 851175202 { return 3 }

    let manifest_fp: i64 = 383424151
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 76, 1871)
    result_fp = mix(result_fp, 80, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 68, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 412391608 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 76, 1907)
    family_fp = mix(family_fp, 80, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 63, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 782504817 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 76, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 573836383 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 76, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 157740163 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 76, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 320835674 { return 8 }
    return 0
}
