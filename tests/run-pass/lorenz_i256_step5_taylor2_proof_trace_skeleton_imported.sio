//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-5 Taylor-2 proof-trace skeleton checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step5_taylor2_proof_trace_skeleton_check(
        989883403, 422368008, 171451971, 815806077, 69995750, 15, 15, 5, 0)
    if artifact_fp != 971755585 { return 1 }
    let audit_fp = lorenz_i256_step5_taylor2_proof_trace_skeleton_audit_fingerprint(
        artifact_fp, 991104836, 272679598, 989883403, 754841079, 5, 5, 255, 0, 0)
    if audit_fp != 205079086 { return 2 }
    return 0
}
