//@ run-pass
//@ expect-stdout-contains: struct repeat literal ok
//
// #1680: `[S { .. }; N]` in EXPRESSION position (here a function's tail
// expression) returned the wrong array base on lean_single x86-64 when the
// struct spans more than one qword. The element pointers were stored in
// slots base+N-1-i, but the literal's value was `lea [rbp - (base + N*nslots
// - 1)*8]`, past the pointer slots, so element i >= 1 read an unwritten
// slot and dereferenced null (rc=139). `madaros --self-test` crashed after
// T110 on exactly this shape (const_prop's cp_empty_instrs()).

struct I { op: i64, dst: i64 }

struct W { a: i64, b: i64, c: i64, d: i64 }

fn empty_i() -> [I; 8] { [I { op: 18, dst: -1 }; 8] }

fn empty_w() -> [W; 5] { [W { a: 1, b: 2, c: 3, d: 4 }; 5] }

fn main() -> i64 with IO, Mut, Panic, Div {
    var a = empty_i()
    var sum: i64 = 0
    var i: i64 = 0
    while i < 8 {
        sum = sum + a[i as usize].op + a[i as usize].dst
        i = i + 1
    }
    // Elements are distinct copies, not aliases of one element.
    a[3].op = 100
    var w = empty_w()
    w[4].d = 40
    if sum == 8 * 17 && a[2].op == 18 && a[3].op == 100 && a[4].op == 18
        && w[0].d == 4 && w[4].d == 40 && w[4].a == 1 && w[2].c == 3 {
        println("struct repeat literal ok")
        return 0
    }
    print("struct repeat literal FAIL sum=")
    print_int(sum)
    println("")
    1
}
