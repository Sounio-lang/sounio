//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v105 smoke for Lorenz i256 step-3 Taylor-2 proof-trace skeleton

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1919
    receipt_fp = mix(receipt_fp, 308150621, 5881)
    receipt_fp = mix(receipt_fp, 281860333, 5881)
    receipt_fp = mix(receipt_fp, 371983758, 5881)
    receipt_fp = mix(receipt_fp, 641476816, 5881)
    receipt_fp = mix(receipt_fp, 748010765, 5881)
    receipt_fp = mix(receipt_fp, 824838852, 5881)
    receipt_fp = mix(receipt_fp, 829136864, 5881)
    receipt_fp = mix(receipt_fp, 693283321, 5881)
    receipt_fp = mix(receipt_fp, 160292433, 5881)
    receipt_fp = mix(receipt_fp, 3, 5881)
    receipt_fp = mix(receipt_fp, 6, 5881)
    receipt_fp = mix(receipt_fp, 255, 5881)
    if receipt_fp != 514672660 { return 1 }

    var audit_fp: i64 = 1931
    audit_fp = mix(audit_fp, receipt_fp, 5897)
    audit_fp = mix(audit_fp, 308150621, 5897)
    audit_fp = mix(audit_fp, 281860333, 5897)
    audit_fp = mix(audit_fp, 371983758, 5897)
    audit_fp = mix(audit_fp, 641476816, 5897)
    audit_fp = mix(audit_fp, 693283321, 5897)
    audit_fp = mix(audit_fp, 160292433, 5897)
    audit_fp = mix(audit_fp, 829136864, 5897)
    audit_fp = mix(audit_fp, 3, 5897)
    audit_fp = mix(audit_fp, 6, 5897)
    audit_fp = mix(audit_fp, 255, 5897)
    if audit_fp != 758528823 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 108, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 108, 1103)
    if entry_fp != 918630049 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 105, 1151)
    manifest_fp = mix(manifest_fp, 109, 1151)
    manifest_fp = mix(manifest_fp, 824838852, 1151)
    manifest_fp = mix(manifest_fp, 748010765, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 543887870 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 105, 1871)
    result_fp = mix(result_fp, 109, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 97, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 500403434 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 105, 1907)
    family_fp = mix(family_fp, 109, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 92, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 641904525 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 105, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 206531377 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 105, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 238950575 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 105, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 139143245 { return 9 }
    return 0
}
