//@ run-pass
//@ description: Policy keyword tokens remain available as identifiers in expression context.

struct P {
    x: i64,
}

fn policy_sum(
    policy: P,
    acquisition_policy: P,
    recourse_policy: P,
    transition_policy: P,
    monitoring_policy: P,
    alternative_policy: P,
    decision_policy: P,
    deferral_policy: P,
) -> i64 {
    policy.x
        + acquisition_policy.x
        + recourse_policy.x
        + transition_policy.x
        + monitoring_policy.x
        + alternative_policy.x
        + decision_policy.x
        + deferral_policy.x
}

fn main() -> i64 {
    let _sum = policy_sum(
        P { x: 1 },
        P { x: 1 },
        P { x: 1 },
        P { x: 1 },
        P { x: 1 },
        P { x: 1 },
        P { x: 1 },
        P { x: 1 },
    )
    0
}
