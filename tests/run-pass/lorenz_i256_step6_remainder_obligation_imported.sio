//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 remainder obligation checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_remainder_obligation_check(50000, 70000, 15000)
    if artifact_fp != 652877359 { return 1 }
    let audit_fp = lorenz_i256_step6_remainder_obligation_audit_fingerprint(
        artifact_fp, 827494918, 967484944, 947760031, 516981885, 6, 5, 127)
    if audit_fp != 344816971 { return 2 }
    return 0
}
