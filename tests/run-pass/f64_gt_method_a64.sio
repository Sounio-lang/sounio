//@ run-pass
//@ description: f64_gt(a,b) method builtin returns a>b on a64 (cset hi, not le)
//
// Regression guard: the a64 f64_gt builtin emitted cset le (a<=b) instead of
// cset hi (a>b), so f64_gt was systematically inverted. The operator-form > was
// always correct; only the builtin was wrong. x86 (seta) was correct.

fn main() -> i32 with IO {
    var fail: i64 = 0
    let a: f64 = 5.0
    let b: f64 = 3.0
    if f64_gt(a, b) { } else { print("gt(5,3) FAIL\n"); fail = fail + 1 }   // true
    if f64_gt(b, a) { print("gt(3,5) FAIL\n"); fail = fail + 1 }            // false
    if f64_gt(a, a) { print("gt(5,5) FAIL\n"); fail = fail + 1 }            // false (equal)
    if fail == 0 { print("f64_gt_method_a64: ALL PASS\n"); return 0 }
    return 1 as i32
}
