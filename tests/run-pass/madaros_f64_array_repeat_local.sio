//@ run-pass
//@ requires: madaros
//@ expect-stdout: F64_ARRAY_REPEAT_LOCAL PASS
//
// `[x; N]` with an f64 LOCAL x. lower_array_repeat_literal_ref classified its
// element with the free fn lower_expr_has_float_source_ref, which sees float
// literals, casts and binary subtrees of them and returns false for a local.
// lower_array_literal_expr_ref routes every `Some(_)` repeat literal there, so
// the elementwise branch got the local-aware classifier and the repeat branch
// did not: `([x; 2])[0] * 2.0` stayed unmarked and converted the f64 bits as
// an i64. lean_single computes 3.0.
fn main() -> i32 with IO, Mut, Panic {
    let x: f64 = 1.5

    // Repeat literal indexed in place -- never passes through let metadata,
    // so the classifier inside the repeat lowering is the only thing that can
    // mark it.
    let direct: f64 = ([x; 2])[0] * 2.0

    // Let-bound repeat literal, read out of a later slot.
    let xs = [x; 3]
    let bound: f64 = xs[2] * 2.0

    // A repeat literal whose element is a computed f64 local.
    let y: f64 = x * 0.5
    let ys = [y; 2]
    var acc: f64 = 0.0
    var i: i64 = 0
    while i < 2 {
        acc = acc + ys[i]
        i = i + 1
    }

    if direct == 3.0 && bound == 3.0 && acc == 1.5 {
        println("F64_ARRAY_REPEAT_LOCAL PASS")
        return 0
    }
    1
}
