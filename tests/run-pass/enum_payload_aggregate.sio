//@ run-pass
//@ requires: madaros
//@ description: KL-20 -- enum payloads of struct, f64-array, i64-array and Box<Self> type (a recursive expression tree), matched by value and through `&`
//@ expect-stdout: pt=7
//@ expect-stdout: ptf=1.500000
//@ expect-stdout: arr=60
//@ expect-stdout: farr=4.500000
//@ expect-stdout: tree=17
//@ expect-stdout: depth=3

struct Point { x: i64, y: f64 }

enum Item { At(Point), Ints([i64; 3]), Floats([f64; 2]), Nothing }

enum Expr { Lit(i64), Add(Box<Expr>, Box<Expr>), Mul(Box<Expr>, Box<Expr>), Neg(Box<Expr>) }

fn eval(e: &Expr) -> i64 {
    match e {
        Expr::Lit(n) => n,
        Expr::Add(a, b) => eval(&(*a)) + eval(&(*b)),
        Expr::Mul(a, b) => eval(&(*a)) * eval(&(*b)),
        Expr::Neg(a) => 0 - eval(&(*a)),
    }
}

fn depth(e: &Expr) -> i64 {
    match e {
        Expr::Lit(_) => 1,
        Expr::Add(a, b) => { let da = depth(&(*a)); let db = depth(&(*b)); 1 + (if da > db { da } else { db }) }
        Expr::Mul(a, b) => { let da = depth(&(*a)); let db = depth(&(*b)); 1 + (if da > db { da } else { db }) }
        Expr::Neg(a) => 1 + depth(&(*a)),
    }
}

fn item_at(k: i64) -> Item {
    if k == 0 { Item::At(Point { x: 7, y: 1.5 }) }
    else if k == 1 { let a = [10, 20, 30]; Item::Ints(a) }
    else if k == 2 { Item::Floats([1.5, 3.0]) }
    else { Item::Nothing }
}

fn main() -> i32 with IO {
    match item_at(0) {
        Item::At(p) => { print("pt="); println(p.x); print("ptf="); println(p.y) }
        _ => println("bad"),
    }
    match item_at(1) {
        Item::Ints(a) => { print("arr="); println(a[0] + a[1] + a[2]) }
        _ => println("bad"),
    }
    match item_at(2) {
        Item::Floats(f) => { print("farr="); println(f[0] + f[1]) }
        _ => println("bad"),
    }
    // (2 + 3) * 4 + (-3) = 17
    let t = Expr::Add(
        Box::new(Expr::Mul(Box::new(Expr::Add(Box::new(Expr::Lit(2)), Box::new(Expr::Lit(3)))), Box::new(Expr::Lit(4)))),
        Box::new(Expr::Neg(Box::new(Expr::Lit(3)))))
    print("tree=")
    println(eval(&t))
    print("depth=")
    println(depth(&t) - 1)
    0
}
