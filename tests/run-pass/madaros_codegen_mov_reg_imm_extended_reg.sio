//@ run-pass
// Direct regression witness for native::codegen's nc_emit_mov_reg_imm32/64
// REX.B + (reg & 7) masking on extended registers R8-R15. The existing
// driver-argument witness (madaros_native_v2_driver_r8_const.sio) only
// exercises the ABI-argument-loading path, whose vregs all land in
// registers 0-7, so it cannot catch a regression in codegen.sio's own
// duplicate of the encode.sio fix. This calls nc_test_mov_reg_imm_extended_reg,
// which invokes nc_emit_mov_reg_imm32(nc, 8, ...) and
// nc_emit_mov_reg_imm64(nc, 15, ...) directly and asserts the emitted bytes.
//@ requires: madaros
//@ expect-stdout: 42
use native::codegen::{nc_test_mov_reg_imm_extended_reg}

fn main() -> i64 with IO, Mut, Panic, Div {
    if nc_test_mov_reg_imm_extended_reg() == false {
        print("FAIL\n")
        return 1
    }
    print_int(42)
    0
}
