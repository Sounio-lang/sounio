//@ run-pass
//@ description: #2249 control — prefix `!`/`~` still work, including at the start of a line after a complete statement, and `!=` / `^` are unaffected
//@ expect-stdout: 1
//@ expect-stdout: -21
//@ expect-stdout: 1
//@ expect-stdout: 2
//@ expect-stdout: PREFIX_BANG_TILDE_2249_OK

fn main() -> i64 with IO {
    let x = 20
    let y = 22
    var t = false
    t = !t
    if t { println(1) } else { println(0) }
    let n = ~x
    println(n)
    var c = 0
    c = c + 1
    !t
    println(c)
    let z = x ^ y
    println(z)
    if x != y { println("PREFIX_BANG_TILDE_2249_OK") }
    0
}
