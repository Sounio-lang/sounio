//@ run-pass
//@ expect-stdout: STATS_BROWN_FORSYTHE_LEGACY_PASS
use stats::epistemic::assumptions::{levene_test}
fn main() with IO,Mut,Div,Panic {
 var a:[f64;100]=[0.0;100]
 var b:[f64;100]=[0.0;100]
 a[0]=1.0e-200;a[1]=2.0e-200;a[2]=4.0e-200;a[3]=8.0e-200;a[4]=16.0e-200
 b[0]=2.0e-200;b[1]=3.0e-200;b[2]=4.0e-200;b[3]=5.0e-200;b[4]=6.0e-200;b[5]=8.0e-200
 let r=levene_test(a,5,b,6)
 assert(r.status==0 && r.df1==1 && r.df2==9)
 assert(r.f_stat>1.7191044677 && r.f_stat<1.7191044678)
 assert(r.p>0.2222721838 && r.p<0.2222721839)
 assert(levene_test(a,101,b,6).status==1)
 println("STATS_BROWN_FORSYTHE_LEGACY_PASS")
 0
}
