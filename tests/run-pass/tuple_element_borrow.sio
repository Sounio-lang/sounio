//@ run-pass
//@ description: borrowing a tuple element (&t.0, &t.1, &!t.0) must yield a reference to it
//
// lean_single's borrow path only resolved struct fields. A tuple index fell into
// the "field borrow requires struct base" arm, which only warned and emitted a
// null pointer, so the first read through the reference crashed. This is the
// shape sandbox_execute(...) callers use: `effect_vm_has_error(&exec.0)`.

struct S { a: i64, b: i64 }

fn mk() -> (S, i64) { return (S { a: 7, b: 8 }, 42) }
fn mk2() -> (i64, S) { return (5, S { a: 70, b: 80 }) }
fn mk3() -> (S, S) { return (S { a: 1, b: 2 }, S { a: 3, b: 4 }) }

fn geta(s: &S) -> i64 { return s.a }
fn getb(s: &S) -> i64 { return s.b }
fn rd(p: &i64) -> i64 { return *p }
fn seta(s: &!S, v: i64) with Mut { s.a = v }

fn main() -> i64 with IO, Mut, Panic {
    var bad = 0

    let t = mk()
    if geta(&t.0) != 7 { bad = bad + 1 }
    if getb(&t.0) != 8 { bad = bad + 1 }

    let u = mk2()
    if getb(&u.1) != 80 { bad = bad + 1 }
    if geta(&u.1) != 70 { bad = bad + 1 }

    let w = mk3()
    if geta(&w.0) != 1 { bad = bad + 1 }
    if geta(&w.1) != 3 { bad = bad + 1 }
    if getb(&w.1) != 4 { bad = bad + 1 }

    var m = mk3()
    seta(&!m.1, 99)
    if geta(&m.1) != 99 { bad = bad + 1 }
    if geta(&m.0) != 1 { bad = bad + 1 }

    if bad != 0 {
        print("tuple element borrow violations: ")
        println(bad)
        return 1
    }
    println("TUPLE_ELEMENT_BORROW_OK")
    return 0
}
