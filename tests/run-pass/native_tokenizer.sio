//@ run-pass
// Native tokenizer — demonstrates enums + match in a real compiler context
// Tokenizes a simple expression language: numbers, operators, parens
// Compiles to native ELF via lean driver

enum TokKind {
    TkNum,
    TkPlus,
    TkMinus,
    TkStar,
    TkSlash,
    TkLparen,
    TkRparen,
    TkEof,
    TkError,
}

var tok_kinds: [i64; 256] = [0; 256]
var tok_vals: [i64; 256] = [0; 256]
var tok_count: [i64; 1] = [0; 1]

fn is_digit(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return 1 } }
    return 0
}

fn is_space(c: i64) -> i64 {
    if c == 32 { return 1 }
    if c == 10 { return 1 }
    if c == 9 { return 1 }
    return 0
}

fn add_tok(kind: i64, val: i64) -> i64 {
    let idx = tok_count[0 as usize]
    tok_kinds[idx as usize] = kind
    tok_vals[idx as usize] = val
    tok_count[0 as usize] = idx + 1
    return idx
}

fn tokenize_expr(input: [i8; 1024], len: i64) -> i64 {
    var pos = 0
    tok_count[0 as usize] = 0

    while pos < len {
        let ch = input[pos as usize] as i64
        var c = ch
        if ch < 0 { c = ch + 256 }

        if is_space(c) == 1 {
            pos = pos + 1
        } else if is_digit(c) == 1 {
            var num = 0
            while pos < len {
                let d = input[pos as usize] as i64
                var dc = d
                if d < 0 { dc = d + 256 }
                if is_digit(dc) == 0 { break }
                num = num * 10 + (dc - 48)
                pos = pos + 1
            }
            add_tok(TokKind::TkNum, num)
        } else if c == 43 { add_tok(TokKind::TkPlus, 0); pos = pos + 1
        } else if c == 45 { add_tok(TokKind::TkMinus, 0); pos = pos + 1
        } else if c == 42 { add_tok(TokKind::TkStar, 0); pos = pos + 1
        } else if c == 47 { add_tok(TokKind::TkSlash, 0); pos = pos + 1
        } else if c == 40 { add_tok(TokKind::TkLparen, 0); pos = pos + 1
        } else if c == 41 { add_tok(TokKind::TkRparen, 0); pos = pos + 1
        } else {
            add_tok(TokKind::TkError, c)
            pos = pos + 1
        }
    }
    add_tok(TokKind::TkEof, 0)
    return tok_count[0 as usize]
}

fn print_tok_kind(kind: i64) -> i64 {
    match kind {
        TokKind::TkNum => print("NUM")
        TokKind::TkPlus => print("+")
        TokKind::TkMinus => print("-")
        TokKind::TkStar => print("*")
        TokKind::TkSlash => print("/")
        TokKind::TkLparen => print("(")
        TokKind::TkRparen => print(")")
        TokKind::TkEof => print("EOF")
        TokKind::TkError => print("ERR")
        _ => print("?")
    }
    return 0
}

// Simple recursive-descent evaluator (addition only for simplicity)
// expr = term (('+' | '-') term)*
// term = NUM

var eval_pos: [i64; 1] = [0; 1]

fn eval_term() -> i64 {
    let pos = eval_pos[0 as usize]
    let kind = tok_kinds[pos as usize]
    if kind == TokKind::TkNum {
        eval_pos[0 as usize] = pos + 1
        return tok_vals[pos as usize]
    }
    return 0
}

fn eval_expr() -> i64 {
    var result = eval_term()
    var done = 0
    while done == 0 {
        let pos = eval_pos[0 as usize]
        let kind = tok_kinds[pos as usize]
        if kind == TokKind::TkPlus {
            eval_pos[0 as usize] = pos + 1
            result = result + eval_term()
        } else if kind == TokKind::TkMinus {
            eval_pos[0 as usize] = pos + 1
            result = result - eval_term()
        } else {
            done = 1
        }
    }
    return result
}

fn main() -> i64 {
    // Tokenize "42 + 17 - 3"
    var input: [i8; 1024] = [0; 1024]
    input[0 as usize] = 52 as i8    // '4'
    input[1 as usize] = 50 as i8    // '2'
    input[2 as usize] = 32 as i8    // ' '
    input[3 as usize] = 43 as i8    // '+'
    input[4 as usize] = 32 as i8    // ' '
    input[5 as usize] = 49 as i8    // '1'
    input[6 as usize] = 55 as i8    // '7'
    input[7 as usize] = 32 as i8    // ' '
    input[8 as usize] = 45 as i8    // '-'
    input[9 as usize] = 32 as i8    // ' '
    input[10 as usize] = 51 as i8   // '3'

    let ntok = tokenize_expr(input, 11)

    // Print tokens
    print("tokens: ")
    print_int(ntok)
    print("\n")

    var i = 0
    while i < ntok {
        print("  ")
        print_tok_kind(tok_kinds[i as usize])
        let kind = tok_kinds[i as usize]
        if kind == TokKind::TkNum {
            print("(")
            print_int(tok_vals[i as usize])
            print(")")
        }
        print("\n")
        i = i + 1
    }

    // Evaluate
    eval_pos[0 as usize] = 0
    let result = eval_expr()
    print("42 + 17 - 3 = ")
    print_int(result)
    print("\n")

    // Validate
    if result == 56 {
        print("PASS: expression evaluator correct\n")
        return 0
    } else {
        print("FAIL: expected 56\n")
        return 1
    }
}
