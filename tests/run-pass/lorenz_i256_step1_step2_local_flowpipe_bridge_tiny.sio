//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1-to-step-2 local-flowpipe bridge keeps global claim closed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let proof_mask: i64 = 15
    let seed_mask: i64 = 15
    let chain_mask: i64 = 15
    var bridge_mask: i64 = 0
    bridge_mask = bridge_mask + 1
    bridge_mask = bridge_mask + 2
    bridge_mask = bridge_mask + 4
    bridge_mask = bridge_mask + 8
    if bridge_mask != 15 { return 1 }

    var extension_mask: i64 = 0
    if proof_mask == 15 { extension_mask = extension_mask + 1 }
    if seed_mask == 15 { extension_mask = extension_mask + 2 }
    if chain_mask == 15 { extension_mask = extension_mask + 4 }
    if bridge_mask == 15 { extension_mask = extension_mask + 8 }
    if extension_mask != 15 { return 2 }

    let global_claim_mask: i64 = 0
    let status: i64 = 22
    let ok_mask: i64 = 255
    if global_claim_mask != 0 { return 3 }

    var inst: i64 = 1571
    inst = mix(inst, 908974219, 5437)
    inst = mix(inst, 890221848, 5437)
    inst = mix(inst, 301347724, 5437)
    inst = mix(inst, 777254975, 5437)
    inst = mix(inst, 660429472, 5437)
    inst = mix(inst, 510854875, 5437)
    inst = mix(inst, 335080767, 5437)
    inst = mix(inst, 899209716, 5437)
    inst = mix(inst, 1, 5437)
    inst = mix(inst, 1, 5437)
    inst = mix(inst, 2, 5437)
    inst = mix(inst, 256, 5437)
    inst = mix(inst, 32, 5437)
    inst = mix(inst, 1, 5437)
    inst = mix(inst, 100, 5437)
    inst = mix(inst, 4294967296, 5437)
    inst = mix(inst, 4294967296, 5437)
    inst = mix(inst, 4294967296, 5437)
    inst = mix(inst, 4406636440, 5437)
    inst = mix(inst, 6517899153, 5437)
    inst = mix(inst, 4164877513, 5437)
    inst = mix(inst, proof_mask, 5437)
    inst = mix(inst, seed_mask, 5437)
    inst = mix(inst, chain_mask, 5437)
    inst = mix(inst, bridge_mask, 5437)
    inst = mix(inst, extension_mask, 5437)
    inst = mix(inst, global_claim_mask, 5437)
    inst = mix(inst, status, 5437)
    if inst != 148904669 { return 4 }

    var cert: i64 = 1579
    cert = mix(cert, inst, 5441)
    cert = mix(cert, proof_mask, 5441)
    cert = mix(cert, seed_mask, 5441)
    cert = mix(cert, chain_mask, 5441)
    cert = mix(cert, bridge_mask, 5441)
    cert = mix(cert, extension_mask, 5441)
    cert = mix(cert, global_claim_mask, 5441)
    cert = mix(cert, status, 5441)
    cert = mix(cert, 1, 5441)
    cert = mix(cert, 1, 5441)
    cert = mix(cert, 2, 5441)
    cert = mix(cert, 256, 5441)
    cert = mix(cert, 32, 5441)
    cert = mix(cert, 1, 5441)
    cert = mix(cert, 100, 5441)
    cert = mix(cert, ok_mask, 5441)
    if cert != 278828475 { return 5 }

    var artifact: i64 = 1583
    artifact = mix(artifact, inst, 5443)
    artifact = mix(artifact, cert, 5443)
    artifact = mix(artifact, 17, 5443)
    artifact = mix(artifact, 1, 5443)
    artifact = mix(artifact, 1, 5443)
    artifact = mix(artifact, 2, 5443)
    artifact = mix(artifact, proof_mask, 5443)
    artifact = mix(artifact, bridge_mask, 5443)
    artifact = mix(artifact, extension_mask, 5443)
    artifact = mix(artifact, global_claim_mask, 5443)
    artifact = mix(artifact, status, 5443)
    artifact = mix(artifact, ok_mask, 5443)
    if artifact != 595466240 { return 6 }

    var audit: i64 = 1597
    audit = mix(audit, artifact, 5449)
    audit = mix(audit, inst, 5449)
    audit = mix(audit, cert, 5449)
    audit = mix(audit, 908974219, 5449)
    audit = mix(audit, 890221848, 5449)
    audit = mix(audit, 301347724, 5449)
    audit = mix(audit, 777254975, 5449)
    audit = mix(audit, 660429472, 5449)
    audit = mix(audit, 510854875, 5449)
    audit = mix(audit, 335080767, 5449)
    audit = mix(audit, 899209716, 5449)
    audit = mix(audit, 1, 5449)
    audit = mix(audit, 1, 5449)
    audit = mix(audit, 2, 5449)
    audit = mix(audit, status, 5449)
    audit = mix(audit, ok_mask, 5449)
    if audit != 382059454 { return 7 }
    return 0
}
