//@ run-pass

// ---------------------------------------------------------------------------
// Airy Functions test suite -- all helpers inlined, no imports
//
// Functions tested (Taylor series implementations):
//   airy_f   -- auxiliary series f(x) = sum a_k, a_0=1, a_{k+1}=a_k*x^3/((3k+2)(3k+3))
//   airy_g   -- auxiliary series g(x) = sum b_k, b_0=x, b_{k+1}=b_k*x^3/((3k+3)(3k+4))
//   airy_ai  -- Airy function of the first kind:  Ai(x) = c1*f(x) - c2*g(x)
//   airy_bi  -- Airy function of the second kind: Bi(x) = sqrt(3)*(c1*f(x) + c2*g(x))
//   airy_ai_prime -- derivative Ai'(x) via differentiated series
//   airy_bi_prime -- derivative Bi'(x) via differentiated series
//
// Constants:
//   c1 = Ai(0)  = 1/(3^{2/3} * Gamma(2/3)) ~ 0.35502805388781724
//   c2 = -Ai'(0) = 1/(3^{1/3} * Gamma(1/3)) ~ 0.25881940379280680
//
// Series use 40 terms for convergence.
//
// References:
//   Abramowitz & Stegun (1964), Ch. 10
//   DLMF (https://dlmf.nist.gov) chapter 9
//   Vallee & Soares, "Airy Functions and Applications to Physics" (2004)
// ---------------------------------------------------------------------------

// ============================================================================
// HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var scaled = x
    var scale_back = 1.0
    while scaled < 1.0 {
        scaled = scaled * 4.0
        scale_back = scale_back * 2.0
    }
    while scaled > 4.0 {
        scaled = scaled * 0.25
        scale_back = scale_back * 0.5
    }
    var y = 1.5
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    return y / scale_back
}

fn pi_val() -> f64 {
    return 3.14159265358979323846
}

// ============================================================================
// AIRY SERIES CONSTANTS
// ============================================================================

// c1 = Ai(0) = 1 / (3^{2/3} * Gamma(2/3)) ~ 0.35502805388781724
fn airy_c1() -> f64 {
    return 0.35502805388781724
}

// c2 = -Ai'(0) = 1 / (3^{1/3} * Gamma(1/3)) ~ 0.25881940379280680
fn airy_c2() -> f64 {
    return 0.25881940379280680
}

// ============================================================================
// AIRY AUXILIARY SERIES (40 terms)
// ============================================================================

// f(x) = sum_{k=0}^{N} a_k
//   a_0 = 1
//   a_{k+1} = a_k * x^3 / ((3k+2)(3k+3))
fn airy_f(x: f64) -> f64 with Mut, Div {
    let x3 = x * x * x
    var sum = 1.0
    var term = 1.0
    var k = 0
    while k < 40 {
        let kf = k as f64
        let denom = (3.0 * kf + 2.0) * (3.0 * kf + 3.0)
        term = term * x3 / denom
        sum = sum + term
        k = k + 1
    }
    return sum
}

// g(x) = sum_{k=0}^{N} b_k
//   b_0 = x
//   b_{k+1} = b_k * x^3 / ((3k+3)(3k+4))
fn airy_g(x: f64) -> f64 with Mut, Div {
    let x3 = x * x * x
    var sum = x
    var term = x
    var k = 0
    while k < 40 {
        let kf = k as f64
        let denom = (3.0 * kf + 3.0) * (3.0 * kf + 4.0)
        term = term * x3 / denom
        sum = sum + term
        k = k + 1
    }
    return sum
}

// f'(x) = d/dx f(x)
// If f(x) = sum a_k where a_k involves x^{3k}, then
// f'(x) = sum_{k=1}^{N} a_k' where the derivative of each term contributes.
// More directly, differentiate the recurrence:
//   f(x) = 1 + x^3/6 + x^6/180 + ...
//   f'(x) = 0 + 3x^2/6 + 6x^5/180 + ...
//         = sum_{k=0}^{N-1} (3k+3) * a_{k+1} * x^{-1}  -- but that's tricky
//
// Better: use the series for f'(x) directly.
//   f'(x) = sum_{k=0}^{N} c_k where c_0 = 0, c_1 = x^2/2, ...
//   Actually: d/dx[a_k * (implicit x^{3k} structure)]
//
// Cleanest approach: f'(x) = sum_{k=1}^{N} (3k) * a_k / x
//   where a_k is the k-th term of f(x) divided by appropriate factorial factors.
//
// Even simpler: rebuild from scratch.
//   Let T_k = x^{3k} / prod_{j=0}^{k-1} ((3j+2)(3j+3))
//   Then T_k' = 3k * x^{3k-1} / prod_{j=0}^{k-1} ((3j+2)(3j+3))
//   f'(x) = sum_{k=1}^{N} 3k * T_k / x = sum_{k=1}^{N} 3k * a_k / x
//
// But we must handle x=0 carefully. At x=0, f'(0) = 0.
//
// Use the series: f'(x) = sum_{k=0}^{N} d_k
//   d_0 = 0
//   d_k = 3k * x^{3k-1} / prod_{j=0}^{k-1}((3j+2)(3j+3))
//       = (3k/(3k-1)) * ... this gets complicated.
//
// Simplest correct approach: compute f'(x) via the power series directly.
//   f(x) = sum_{k=0}^{N} t_k where t_0 = 1, t_{k+1} = t_k * x^3 / ((3k+2)(3k+3))
//   Each t_k is proportional to x^{3k}, so:
//   f'(x) = sum_{k=1}^{N} t_k * (3k) / x   for x != 0
//
// For x=0: f'(0) = 0 (all terms vanish).
fn airy_f_prime(x: f64) -> f64 with Mut, Div {
    if abs_f64(x) < 1.0e-30 { return 0.0 }
    let x3 = x * x * x
    var term = 1.0
    var sum = 0.0
    var k = 0
    while k < 40 {
        let kf = k as f64
        let denom = (3.0 * kf + 2.0) * (3.0 * kf + 3.0)
        term = term * x3 / denom
        // This term corresponds to t_{k+1} which is proportional to x^{3(k+1)}
        // Its derivative contributes (3(k+1)) * t_{k+1} / x
        let deriv_contrib = (3.0 * (kf + 1.0)) * term / x
        sum = sum + deriv_contrib
        k = k + 1
    }
    return sum
}

// g'(x) analogously.
//   g(x) = sum_{k=0}^{N} t_k where t_0 = x, t_{k+1} = t_k * x^3 / ((3k+3)(3k+4))
//   Each t_k is proportional to x^{3k+1}, so:
//   g'(x) = sum_{k=0}^{N} t_k * (3k+1) / x   for x != 0
//   g'(0) = t_0 * 1 / ... = 1 (since t_0 = x and (3*0+1)*t_0/x = 1*x/x = 1)
fn airy_g_prime(x: f64) -> f64 with Mut, Div {
    if abs_f64(x) < 1.0e-30 { return 1.0 }
    let x3 = x * x * x
    var term = x
    var sum = term * 1.0 / x   // k=0: (3*0+1) * x / x = 1
    var k = 0
    while k < 40 {
        let kf = k as f64
        let denom = (3.0 * kf + 3.0) * (3.0 * kf + 4.0)
        term = term * x3 / denom
        // term is now t_{k+1}, proportional to x^{3(k+1)+1}
        let deriv_contrib = (3.0 * (kf + 1.0) + 1.0) * term / x
        sum = sum + deriv_contrib
        k = k + 1
    }
    return sum
}

// ============================================================================
// AIRY FUNCTIONS
// ============================================================================

// Ai(x) = c1 * f(x) - c2 * g(x)
fn airy_ai(x: f64) -> f64 with Mut, Div {
    return airy_c1() * airy_f(x) - airy_c2() * airy_g(x)
}

// Bi(x) = sqrt(3) * (c1 * f(x) + c2 * g(x))
fn airy_bi(x: f64) -> f64 with Mut, Panic, Div {
    let sqrt3 = sqrt_f64(3.0)
    return sqrt3 * (airy_c1() * airy_f(x) + airy_c2() * airy_g(x))
}

// Ai'(x) = c1 * f'(x) - c2 * g'(x)
fn airy_ai_prime(x: f64) -> f64 with Mut, Div {
    return airy_c1() * airy_f_prime(x) - airy_c2() * airy_g_prime(x)
}

// Bi'(x) = sqrt(3) * (c1 * f'(x) + c2 * g'(x))
fn airy_bi_prime(x: f64) -> f64 with Mut, Panic, Div {
    let sqrt3 = sqrt_f64(3.0)
    return sqrt3 * (airy_c1() * airy_f_prime(x) + airy_c2() * airy_g_prime(x))
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

// Test 1: Ai(0) ~ 0.35502805388781724 (tol 1e-10)
fn test_ai_zero() -> bool with IO, Mut, Div {
    let got = airy_ai(0.0)
    let expected = 0.35502805388781724
    let tol = 1.0e-10
    print("  Ai(0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 2: Bi(0) ~ 0.61492662744600074 (tol 1e-10)
fn test_bi_zero() -> bool with IO, Mut, Panic, Div {
    let got = airy_bi(0.0)
    let expected = 0.61492662744600074
    let tol = 1.0e-10
    print("  Bi(0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 3: Ai(1) ~ 0.13529241631288141 (tol 1e-8)
fn test_ai_one() -> bool with IO, Mut, Div {
    let got = airy_ai(1.0)
    let expected = 0.13529241631288141
    let tol = 1.0e-8
    print("  Ai(1)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 4: Bi(1) ~ 1.20742359495287099 (tol 1e-8)
fn test_bi_one() -> bool with IO, Mut, Panic, Div {
    let got = airy_bi(1.0)
    let expected = 1.20742359495287099
    let tol = 1.0e-8
    print("  Bi(1)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 5: Ai(-1) ~ 0.53556088329235211 (tol 1e-8)
fn test_ai_neg_one() -> bool with IO, Mut, Div {
    let got = airy_ai(0.0 - 1.0)
    let expected = 0.53556088329235211
    let tol = 1.0e-8
    print("  Ai(-1)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 6: Bi(-1) ~ 0.10399738949694461 (tol 1e-8)
fn test_bi_neg_one() -> bool with IO, Mut, Panic, Div {
    let got = airy_bi(0.0 - 1.0)
    let expected = 0.10399738949694461
    let tol = 1.0e-8
    print("  Bi(-1)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 7: Ai(2) ~ 0.03492413042602169 (tol 1e-8)
fn test_ai_two() -> bool with IO, Mut, Div {
    let got = airy_ai(2.0)
    let expected = 0.03492413042602169
    let tol = 1.0e-8
    print("  Ai(2)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 8: Bi(2) ~ 3.29809499997821 (tol 1e-4)
fn test_bi_two() -> bool with IO, Mut, Panic, Div {
    let got = airy_bi(2.0)
    let expected = 3.29809499997821
    let tol = 1.0e-4
    print("  Bi(2)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 9: Ai(-2) ~ 0.22740742820168558 (tol 1e-6)
fn test_ai_neg_two() -> bool with IO, Mut, Div {
    let got = airy_ai(0.0 - 2.0)
    let expected = 0.22740742820168558
    let tol = 1.0e-6
    print("  Ai(-2)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 10: Bi(-2) ~ -0.41230258795639849 (tol 1e-6)
// NOTE: Bi(-2) is negative
fn test_bi_neg_two() -> bool with IO, Mut, Panic, Div {
    let got = airy_bi(0.0 - 2.0)
    let expected = 0.0 - 0.41230258795639849
    let tol = 1.0e-6
    print("  Bi(-2)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 11: Wronskian Ai(x)*Bi'(x) - Ai'(x)*Bi(x) = 1/pi at x=0 (tol 1e-6)
// The Wronskian of Ai and Bi is exactly 1/pi for all x.
fn test_wronskian() -> bool with IO, Mut, Panic, Div {
    let x = 0.0
    let ai_val = airy_ai(x)
    let bi_val = airy_bi(x)
    let ai_p = airy_ai_prime(x)
    let bi_p = airy_bi_prime(x)
    let wronskian = ai_val * bi_p - ai_p * bi_val
    let expected = 1.0 / pi_val()
    let tol = 1.0e-6
    print("  W[Ai,Bi](0)=")
    println(wronskian)
    print("  1/pi=")
    println(expected)
    return abs_f64(wronskian - expected) < tol
}

// Test 12: Ai(x) > 0 for x > 0, check Ai(0.5) > 0
fn test_ai_positive() -> bool with IO, Mut, Div {
    let got = airy_ai(0.5)
    print("  Ai(0.5)=")
    println(got)
    return got > 0.0
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Airy Functions Tests ===")
    println("")

    var passed = 0
    var failed = 0

    // Test 1
    print("Test  1: Ai(0) ~ 0.35503 .......... ")
    if test_ai_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 2
    print("Test  2: Bi(0) ~ 0.61493 .......... ")
    if test_bi_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 3
    print("Test  3: Ai(1) ~ 0.13529 .......... ")
    if test_ai_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 4
    print("Test  4: Bi(1) ~ 1.20742 .......... ")
    if test_bi_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 5
    print("Test  5: Ai(-1) ~ 0.53556 ......... ")
    if test_ai_neg_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 6
    print("Test  6: Bi(-1) ~ 0.10400 ......... ")
    if test_bi_neg_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 7
    print("Test  7: Ai(2) ~ 0.03492 .......... ")
    if test_ai_two() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 8
    print("Test  8: Bi(2) ~ 3.29809 .......... ")
    if test_bi_two() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 9
    print("Test  9: Ai(-2) ~ 0.22741 ......... ")
    if test_ai_neg_two() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 10
    print("Test 10: Bi(-2) ~ -0.41230 ........ ")
    if test_bi_neg_two() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 11
    print("Test 11: Wronskian = 1/pi .......... ")
    if test_wronskian() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 12
    print("Test 12: Ai(0.5) > 0 .............. ")
    if test_ai_positive() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    if failed == 0 {
        println("ALL 12 TESTS PASSED")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
