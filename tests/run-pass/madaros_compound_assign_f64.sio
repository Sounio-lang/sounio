//@ run-pass
//@ requires: madaros
//@ expect-stdout: COMPOUND_ASSIGN_F64_OK
//@ description: Madaros lowers f64 `+= -= *= /=` (local, struct field, array element, loop) with the f64 binop, not the integer one
// Regression: the compound path emitted an untyped ir_binop, so `x += 2.0` added
// the IEEE bit patterns as integers and printed -9223372036854775808.000000.
// f64 `%=` is refused (E050 on `%`); see tests/compile-fail/madaros_compound_assign_f64_rem_rejected.sio.

struct Acc { x: f64 }

fn main() with IO, Mut {
    var fail: i64 = 0

    var x = 1.5
    x += 2.0
    println(x)
    if x != 3.5 { fail = fail + 1 }
    x -= 0.25
    println(x)
    if x != 3.25 { fail = fail + 1 }
    x *= 4.0
    println(x)
    if x != 13.0 { fail = fail + 1 }
    x /= 2.0
    println(x)
    if x != 6.5 { fail = fail + 1 }

    // Typed local and an f64 local on the RHS.
    var y: f64 = 0.5
    let step: f64 = 0.25
    y += step
    println(y)
    if y != 0.75 { fail = fail + 1 }
    y /= step
    println(y)
    if y != 3.0 { fail = fail + 1 }

    var acc = Acc { x: 2.0 }
    acc.x *= 1.5
    println(acc.x)
    if acc.x != 3.0 { fail = fail + 1 }
    acc.x -= 0.5
    println(acc.x)
    if acc.x != 2.5 { fail = fail + 1 }

    var arr: [f64; 3] = [1.0, 2.0, 3.0]
    arr[1] *= 0.5
    println(arr[1])
    if arr[1] != 1.0 { fail = fail + 1 }
    arr[2] += 0.125
    println(arr[2])
    if arr[2] != 3.125 { fail = fail + 1 }

    // Across a loop back-edge.
    var total = 0.0
    var scale = 1.0
    var i: i64 = 0
    while i < 8 {
        total += 0.5
        scale *= 2.0
        i += 1
    }
    println(total)
    println(scale)
    if total != 4.0 { fail = fail + 1 }
    if scale != 256.0 { fail = fail + 1 }

    if fail == 0 {
        println("COMPOUND_ASSIGN_F64_OK")
    } else {
        println("COMPOUND_ASSIGN_F64_FAIL")
    }
}
