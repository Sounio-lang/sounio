//@ run-pass
//@ requires: madaros
use crypto::x25519::*

fn main() -> i64 with IO {
    // RFC 7748's own documented low-order point: the all-zero u-coordinate.
    // Any scalar multiplied against it produces an all-zero result --
    // x25519 must detect this and report ok=false, never silently accept
    // an all-zero "shared secret".
    var scalar: [u8;32] = [0;32]
    scalar[0] = 42   // an arbitrary, otherwise-unremarkable scalar
    let zero_point: [u8;32] = [0;32]

    let (_result, ok) = x25519(&scalar, &zero_point)
    if ok {
        print_int(1)
        return 1
    }

    println("x25519_low_order_point: all-zero input correctly rejected (ok=false)")
    return 0
}
