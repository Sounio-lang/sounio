//@ run-pass
//@ expect-stdout: user print ok
//@ description: A program's own `fn print_f64(x, decimals)` is the function called, on both engines. lean_single used to call its builtin instead, drop the second argument and print 6 decimals (examples/cayley_dickson_*.sio, stdlib/plot/bar.sio).

var CALLS: i64 = 0

fn print_f64(x: f64, decimals: i64) with IO, Mut {
    CALLS = CALLS + decimals
}

fn main() with IO, Mut {
    print_f64(2.5, 3)
    print_f64(1.0, 4)
    if CALLS == 7 {
        println("user print ok")
    } else {
        println("builtin was called")
    }
}
