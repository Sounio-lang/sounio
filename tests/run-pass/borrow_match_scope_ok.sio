//@ run-pass

fn read_shared(r: &i64) -> i64 {
    *r
}

fn main() -> i32 with Mut {
    var x: i64 = 21
    var sum: i64 = 0

    match 1 {
        0 => { sum = sum + 1 }
        _ => {
            // Borrow taken inside arm should not leak out of arm scope.
            let in_arm = read_shared(&x)
            sum = sum + in_arm
        }
    }

    let after_match = read_shared(&x)
    if sum + after_match > 0 {
        return 0
    }
    0
}
