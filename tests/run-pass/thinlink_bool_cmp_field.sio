//@ run-pass
//@ expect-stdout: BOOL_CMP_FIELD PASS

//! KL-12: struct literal may initialize ≥2 `bool` fields from f64 comparison
//! expressions in field position. Previously Madaros native-v2 failed closed
//! (rc=12) because `ensure_struct_literal_layout_ref` stamped `is_float=1` on
//! declared bool slots from float-operand cmps. Precomp locals remain a valid
//! style (`thinlink_bool_cmp_field_precomp_smoke.sio`). Gate:
//! `scripts/ci/madaros_thinlink_bool_cmp_field_gate.sh`.

struct Pair { a: bool, b: bool }

fn main() -> i32 with IO, Div, Panic {
    let p = Pair { a: 2.0 > 0.0, b: 3.0 > 0.0 }
    if p.a && p.b {
        println("BOOL_CMP_FIELD PASS")
        return 0
    }
    1
}
