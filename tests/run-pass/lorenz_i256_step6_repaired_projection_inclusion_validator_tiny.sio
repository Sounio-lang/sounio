//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 repaired projection inclusion validator

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 659
    fp = mix(fp, 6, 4177)
    fp = mix(fp, 617386880, 4177)
    fp = mix(fp, 478471574, 4177)
    fp = mix(fp, 975464919, 4177)
    fp = mix(fp, 376630542, 4177)
    fp = mix(fp, 641464796, 4177)
    fp = mix(fp, 299663, 4177)
    fp = mix(fp, 389292, 4177)
    fp = mix(fp, 55000, 4177)
    fp = mix(fp, 290642, 4177)
    fp = mix(fp, 386189, 4177)
    fp = mix(fp, 54531, 4177)
    fp = mix(fp, 9021, 4177)
    fp = mix(fp, 3103, 4177)
    fp = mix(fp, 469, 4177)
    fp = mix(fp, 7, 4177)
    fp = mix(fp, 0, 4177)
    fp = mix(fp, 7, 4177)
    fp = mix(fp, 10, 4177)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 241045434 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 661
    fp = mix(fp, instance, 4201)
    fp = mix(fp, 299663, 4201)
    fp = mix(fp, 389292, 4201)
    fp = mix(fp, 55000, 4201)
    fp = mix(fp, 290642, 4201)
    fp = mix(fp, 386189, 4201)
    fp = mix(fp, 54531, 4201)
    fp = mix(fp, 9021, 4201)
    fp = mix(fp, 3103, 4201)
    fp = mix(fp, 469, 4201)
    fp = mix(fp, 7, 4201)
    fp = mix(fp, 0, 4201)
    fp = mix(fp, 7, 4201)
    fp = mix(fp, 10, 4201)
    fp = mix(fp, ok_mask, 4201)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 241045434 { return 0 - 1 }
    if certificate != 533899248 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 673
    fp = mix(fp, instance, 4211)
    fp = mix(fp, certificate, 4211)
    fp = mix(fp, 11, 4211)
    fp = mix(fp, 6, 4211)
    fp = mix(fp, 7, 4211)
    fp = mix(fp, 0, 4211)
    fp = mix(fp, 7, 4211)
    fp = mix(fp, 10, 4211)
    fp = mix(fp, ok_mask, 4211)
    return fp
}

fn validator_mask() -> i64 {
    let x_margin: i64 = 299663
    let y_margin: i64 = 389292
    let z_margin: i64 = 55000
    let x_need: i64 = 290642
    let y_need: i64 = 386189
    let z_need: i64 = 54531

    var pass_mask: i64 = 0
    if x_need <= x_margin { pass_mask = pass_mask + 1 }
    if y_need <= y_margin { pass_mask = pass_mask + 2 }
    if z_need <= z_margin { pass_mask = pass_mask + 4 }

    var fail_mask: i64 = 0
    if x_need > x_margin { fail_mask = fail_mask + 1 }
    if y_need > y_margin { fail_mask = fail_mask + 2 }
    if z_need > z_margin { fail_mask = fail_mask + 4 }

    var ok_mask: i64 = 0
    if 617386880 > 0 { ok_mask = ok_mask + 1 }
    if x_margin == 299663 {
        if y_margin == 389292 {
            if z_margin == 55000 { ok_mask = ok_mask + 2 }
        }
    }
    if x_need == 290642 {
        if y_need == 386189 {
            if z_need == 54531 { ok_mask = ok_mask + 4 }
        }
    }
    if x_margin - x_need == 9021 {
        if y_margin - y_need == 3103 {
            if z_margin - z_need == 469 { ok_mask = ok_mask + 8 }
        }
    }
    if pass_mask == 7 {
        if fail_mask == 0 { ok_mask = ok_mask + 16 }
    }
    if 7 == 7 {
        if 10 == 10 { ok_mask = ok_mask + 32 }
    }
    if z_margin == 55000 {
        if z_margin - z_need == 469 { ok_mask = ok_mask + 64 }
    }
    if 975464919 > 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = validator_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 241045434 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 533899248 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 316597079 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
