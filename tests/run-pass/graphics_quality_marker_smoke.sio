//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_markers_raster_smooth, quality_marker_plot_config_default}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(72, 72)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]

    xs[0] = 0.0
    ys[0] = 0.20
    xs[1] = 1.0
    ys[1] = 0.80
    xs[2] = 2.0
    ys[2] = 0.50

    s = plot_markers_raster_smooth(s, &xs, &ys, 3, quality_marker_plot_config_default())

    let p0r = surface_get_pixel_r(&s, 20, 51)
    let p0g = surface_get_pixel_g(&s, 20, 51)
    let p1r = surface_get_pixel_r(&s, 36, 19)
    let p1g = surface_get_pixel_g(&s, 36, 19)
    let p2r = surface_get_pixel_r(&s, 52, 35)
    let p2g = surface_get_pixel_g(&s, 52, 35)
    if p0r < 150 || p0g > 120 || p1r < 150 || p1g > 120 || p2r < 150 || p2g > 120 {
        print("FAIL quality markers missing at mapped centers\n")
        return 1
    }

    var fill_pixels = 0
    var outline_pixels = 0
    var y = 14
    while y <= 56 {
        var x = 15
        while x <= 58 {
            let r = surface_get_pixel_r(&s, x, y)
            let g = surface_get_pixel_g(&s, x, y)
            let b = surface_get_pixel_b(&s, x, y)
            if r > 150 && g < 120 && b < 120 {
                fill_pixels = fill_pixels + 1
            }
            if r < 50 && g < 60 && b < 80 {
                outline_pixels = outline_pixels + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if fill_pixels < 60 {
        print("FAIL quality marker fill too sparse\n")
        return 2
    }
    if outline_pixels < 24 {
        print("FAIL quality marker outline too sparse\n")
        return 3
    }

    var outside_pixels = 0
    y = 0
    while y < 10 {
        var x2 = 0
        while x2 < 72 {
            if surface_get_pixel_r(&s, x2, y) < 240 {
                outside_pixels = outside_pixels + 1
            }
            x2 = x2 + 1
        }
        y = y + 1
    }
    if outside_pixels > 2 {
        print("FAIL quality marker plot painted outside expected area\n")
        return 4
    }

    print("PASS graphics_quality_marker_smoke\n")
    0
}
