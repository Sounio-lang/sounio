//@ run-pass
//@ expect-stdout: aarch64 sret ok
struct Point { x: i64, y: i64 }

fn make_point(x: i64, y: i64) -> Point {
    Point { x: x, y: y }
}

fn choose_first(a: Point, b: Point) -> Point {
    a
}

fn translate(p: Point, dx: i64, dy: i64) -> Point {
    Point { x: p.x + dx, y: p.y + dy }
}

fn pair_sum(a: Point, b: Point) -> i64 {
    a.x + a.y + b.x + b.y
}

fn main() -> i32 with IO, Panic {
    let a = make_point(2, 4)
    let b = make_point(6, 8)
    assert(a.x == 2)
    assert(a.y == 4)
    assert(b.x == 6)
    assert(b.y == 8)

    let picked = choose_first(make_point(10, 20), make_point(30, 40))
    assert(picked.x == 10)
    assert(picked.y == 20)

    let shifted = translate(choose_first(make_point(1, 3), make_point(5, 7)), 9, 11)
    assert(shifted.x == 10)
    assert(shifted.y == 14)

    let total = pair_sum(make_point(12, 14), choose_first(make_point(16, 18), make_point(20, 22)))
    assert(total == 60)

    print("aarch64 sret ok\n")
    0
}
