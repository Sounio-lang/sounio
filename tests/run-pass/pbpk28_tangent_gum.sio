//@ run-pass
//@ timeout: 300
//@ expect-stdout-contains: PBPK28_TANGENT_GUM_PASS

// Forward (tangent-linear) sensitivities carried through the PBPK28
// integrator (stdlib/darwin_pbpk/sens_pbpk28.sio) against the two
// independent references available for them:
//
//   1. the central-difference Jacobian of ep28_run (two complete simulations
//      per parameter) — an independent numerical route to the same four
//      end-point sensitivity columns;
//   2. the derivative of the exact ledger identity M(T) + CL·AUC_blood = Dose:
//      ∂M(T)/∂θ_j + CL·∂AUC_b/∂θ_j + (∂CL/∂θ_j)·AUC_b = 0 for every parameter.
//
// The tangent is the exact derivative of the discrete scheme, so (1) must
// agree to the finite difference's own error and (2) to rounding. (1) is
// also what found that the oral finite difference halved the cl_form column
// when cl_form = 0 (the "minus" run took no sink): midazolam −0.007708
// against −0.015557, haloperidol −0.013463 against −0.028800. A wrong
// sign, a missing start-up half step, or a forcing built from the wrong
// state shows up in at least one of the two.
//
// Cases, all at the production dt = 0.05 h:
//   IV bolus (ep28_run):       rapamycin 5 mg, semaglutide 0.5 mg, 168 h
//   oral + liver sink (ep28_run_oral):
//     venlafaxine XR 75 mg, 168 h  (matrix release, CYP2D6 formation sink)
//     midazolam IR 5 mg, 168 h     (cl_form = 0)
//     haloperidol IR 5 mg, 72 h    (cl_form = 0)
// The oral set-ups mirror tests/run-pass/gpu_pbpk28_gum_parity.sio.
//
// For the oral path the identity is
//   dM/dθ + CL·dAUC_b/dθ + (dCL/dθ)·AUC_b + cl_form·dAUC_liver/dθ
//         + (dcl_form/dθ)·AUC_liver = 0.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::epistemic_pbpk28::*
use darwin_pbpk::drugs::venlafaxine::*
use darwin_pbpk::drugs::midazolam::*
use darwin_pbpk::ddi::cyp3a_competitive::*
use darwin_pbpk::pgx::cyp2d6_venlafaxine::*
use darwin_pbpk::release::matrix_er::*
use darwin_pbpk::sens_pbpk28::{EpTangent28, ep28_tangent_run, ep28_tangent_run_oral}

fn tg_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn tg_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i: i32 = 0
    while i < 60 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    return y
}

// Largest |a − b| / max(|a|, |b|) over the columns whose magnitude is above
// `floor` (columns that are zero in both, or below the finite difference's
// rounding floor, carry no information about agreement). A parameter with
// zero prior variance is skipped: it has no weight in the GUM budget, and the
// central-difference route does not compute its column at all when its step
// h = max(1e-6·|mean|, 0.01·sigma) is zero (semaglutide cl_renal), while the
// tangent always does.
fn tg_col_rel(a: [f64; 8], b: [f64; 8], priors: EpPrior28, floor: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var worst = 0.0
    var j: i32 = 0
    while j < priors.n {
        let x = a[j]
        let y = b[j]
        let m = if tg_abs(x) > tg_abs(y) { tg_abs(x) } else { tg_abs(y) }
        if m > floor && priors.kn[j].variance > 0.0 {
            let r = tg_abs(x - y) / m
            if r > worst { worst = r }
        }
        j = j + 1
    }
    return worst
}

fn tg_var(d: [f64; 8], priors: EpPrior28) -> f64 with Mut, Div, Panic, Epistemic {
    var v = 0.0
    var j: i32 = 0
    while j < priors.n {
        v = v + d[j] * d[j] * priors.kn[j].variance
        j = j + 1
    }
    return v
}

fn tg_compare(tag: string, fd: EpJac28, tg: EpTangent28, priors: EpPrior28, dose_mg: f64, tol_col: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println(tag)
    if !fd.ok || !tg.jac.ok {
        println("  [FAIL] a run was rejected")
        return 1
    }
    let n = priors.n

    // (1) column agreement with the central-difference Jacobian
    let r_b = tg_col_rel(tg.jac.d_auc_b, fd.d_auc_b, priors, 1.0e-9)
    let r_c = tg_col_rel(tg.jac.d_cb24,  fd.d_cb24,  priors, 1.0e-12)
    let r_l = tg_col_rel(tg.jac.d_auc_l, fd.d_auc_l, priors, 1.0e-9)
    let r_k = tg_col_rel(tg.jac.d_auc_k, fd.d_auc_k, priors, 1.0e-9)
    print("  max rel column diff x 1e6  AUC_blood: "); println(r_b * 1.0e6)
    print("  max rel column diff x 1e6  C_brain24: "); println(r_c * 1.0e6)
    print("  max rel column diff x 1e6  AUC_liver: "); println(r_l * 1.0e6)
    print("  max rel column diff x 1e6  AUC_kidney: "); println(r_k * 1.0e6)
    print("  d AUC_blood / d theta_0   tangent: "); print_f64(tg.jac.d_auc_b[0]); print("   finite difference: "); print_f64(fd.d_auc_b[0]); println("")
    if r_b > tol_col || r_c > tol_col || r_l > tol_col || r_k > tol_col {
        println("  [FAIL] tangent and central-difference columns disagree")
        fails = fails + 1
    }

    // GUM variances built from either Jacobian
    let vb_t = tg_var(tg.jac.d_auc_b, priors)
    let vb_f = tg_var(fd.d_auc_b, priors)
    let vc_t = tg_var(tg.jac.d_cb24, priors)
    let vc_f = tg_var(fd.d_cb24, priors)
    let rv_b = tg_abs(vb_t - vb_f) / vb_f
    let rv_c = tg_abs(vc_t - vc_f) / vc_f
    print("  rel diff Var(AUC_blood) x 1e6: "); println(rv_b * 1.0e6)
    print("  rel diff Var(C_brain24) x 1e6: "); println(rv_c * 1.0e6)
    if rv_b > tol_col || rv_c > tol_col {
        println("  [FAIL] GUM variances disagree")
        fails = fails + 1
    }

    // (2) differentiated ledger identity. The residual is in mg per unit of
    // theta_j; multiplied by the parameter's standard uncertainty it is the
    // mass error a one-sigma change would carry, compared with the dose.
    // (A ratio to the identity's own terms is meaningless for the Kp columns
    // once the drug has been eliminated: every term is then rounding noise.)
    var worst_id = 0.0
    var j: i32 = 0
    while j < n {
        let r = tg_abs(tg.ident[j]) * tg_sqrt(priors.kn[j].variance) / dose_mg
        if r > worst_id { worst_id = r }
        j = j + 1
    }
    print("  differentiated mass identity, worst |residual|*sigma/Dose x 1e12: "); println(worst_id * 1.0e12)
    if worst_id > 1.0e-9 {
        println("  [FAIL] d/dtheta of M(T) + CL*AUC = Dose does not close")
        fails = fails + 1
    }

    // (3) the cone: samples present, u_c finite and non-negative, and the
    // blood u_c is not identically zero
    var any_pos = false
    var bad = false
    var k: i32 = 0
    while k < tg.cone.n {
        let u = tg.cone.u_blood[k]
        if u != u || u < 0.0 { bad = true }
        if u > 0.0 { any_pos = true }
        k = k + 1
    }
    print("  cone samples: "); println(tg.cone.n)
    if tg.cone.n < 32 || bad || !any_pos {
        println("  [FAIL] uncertainty cone malformed")
        fails = fails + 1
    }
    if fails == 0 { println("  [PASS]") }
    return fails
}

fn tg_case_iv(tag: string, prm: PBPKParams28, priors: EpPrior28, dose_mg: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    let fd = ep28_jacobian_columns(prm, priors, dose_mg, 168.0)
    let tg = ep28_tangent_run(prm, priors, dose_mg, 168.0)
    return tg_compare(tag, fd, tg, priors, dose_mg, 1.0e-3)
}

fn tg_case_oral(
    tag: string, prm: PBPKParams28, priors: EpPrior28, dose_mg: f64, t_end: f64,
    oi: OralInputs28, rel: MatrixReleaseModel, fu_ref: f64, gut0: f64, tol_col: f64
) -> i32 with IO, Mut, Div, Panic, Epistemic {
    let fd = ep28_jacobian_columns_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    let tg = ep28_tangent_run_oral(prm, priors, dose_mg, t_end, oi, rel, fu_ref, gut0)
    return tg_compare(tag, fd, tg, priors, dose_mg, tol_col)
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    fails = fails + tg_case_iv("rapamycin 5 mg IV, 168 h", ep28_rapamycin_params(), ep28_rapamycin_priors(), 5.0)
    fails = fails + tg_case_iv("semaglutide 0.5 mg IV, 168 h", ep28_semaglutide_params(), ep28_semaglutide_priors(), 0.5)

    let no_rel = matrix_korsmeyer_peppas(0.0, 0.199, 0.65)
    let oi_v = OralInputs28 { f_abs: venlafaxine_f_oral_xr(), ka: venlafaxine_ka_abs(), cl_form: vfx_cl_form_odv_nm() }
    fails = fails + tg_case_oral("venlafaxine XR 75 mg oral, 168 h", ep28_venlafaxine_params(), ep28_venlafaxine_priors(), 75.0, 168.0,
        oi_v, venlafaxine_xr_matrix_gohel2008(), venlafaxine_fu_parent(), 0.0, 1.0e-3)

    let sub = midazolam_cyp3a_substrate()
    let oi_m = OralInputs28 { f_abs: cyp3a_f_oral(sub, 1.0), ka: midazolam_absorption_params().ka, cl_form: 0.0 }
    fails = fails + tg_case_oral("midazolam IR 5 mg oral, 168 h", ep28_midazolam_params(), ep28_midazolam_priors(), 5.0, 168.0,
        oi_m, no_rel, 0.03, 5.0, 1.0e-3)

    // Haloperidol's cl_form column is taken at cl_form = 0 with the one-sided
    // second-order formula at h = 0.01·sigma = 0.16 L/h, whose truncation
    // error is 0.8% here: halving h gives −28.575, −28.738, −28.784, −28.796
    // (×1e-3, error ratio 4) against the tangent's −28.800 (measured
    // 2026-11-14). The column tolerance for this case covers that error; the
    // differentiated identity still pins the tangent to rounding.
    let oi_h = OralInputs28 { f_abs: 0.65, ka: 0.9, cl_form: 0.0 }
    fails = fails + tg_case_oral("haloperidol IR 5 mg oral, 72 h", ep28_haloperidol_params(), ep28_haloperidol_priors(), 5.0, 72.0,
        oi_h, no_rel, 0.08, 5.0, 2.0e-2)
    if fails == 0 {
        println("PBPK28_TANGENT_GUM_PASS")
        return 0
    }
    println("PBPK28_TANGENT_GUM_FAIL")
    return 1
}
