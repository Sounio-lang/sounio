//@ run-pass
//@ expect-stdout: GENOMICS_SIZE_FACTORS_STATUS_PASS
use genomics::normalization::{SizeFactorResult,median_ratio_size_factors,size_factor_normalized_count}
fn unavailable(r:&SizeFactorResult,status:i64,g:i64,s:i64) with Mut,Div,Panic {
 assert(r.status==status)
 assert(r.genes==g)
 assert(r.samples==s)
 assert(r.genes_used==0)
 assert(r.genes_excluded==0)
 assert(!r.composition_assumptions_assessed)
 var i=0
 while i<8 { assert(r.factors[i as usize]==0.0) assert(r.log_factors[i as usize]==0.0) i=i+1 }
}
fn main()->i32 with IO,Mut,Div,Panic {
 var c:[i64;2048]=[-1;2048]
 let a=median_ratio_size_factors(&c,0,2)
 unavailable(&a,1,0,2)
 let b=median_ratio_size_factors(&c,257,2)
 unavailable(&b,1,257,2)
 let d=median_ratio_size_factors(&c,2,0)
 unavailable(&d,1,2,0)
 let e=median_ratio_size_factors(&c,2,9)
 unavailable(&e,1,2,9)
 let f=median_ratio_size_factors(&c,1,1)
 unavailable(&f,2,1,1)
 c[0]=0 c[1]=2 c[8]=3 c[9]=-1
 let g=median_ratio_size_factors(&c,2,2)
 unavailable(&g,2,2,2)
 c[9]=0
 let h=median_ratio_size_factors(&c,2,2)
 unavailable(&h,3,2,2)
 let bad= size_factor_normalized_count(-1,&h,-1)
 assert(bad.status==1) assert(bad.value==0.0)
 c[0]=2 c[1]=4 c[8]=3 c[9]=6
 var ok=median_ratio_size_factors(&c,2,2)
 assert(ok.status==0) assert(ok.genes_used==2) assert(ok.genes_excluded==0)
 let below=size_factor_normalized_count(1,&ok,-1)
 assert(below.status==2) assert(below.value==0.0)
 let above=size_factor_normalized_count(1,&ok,2)
 assert(above.status==2) assert(above.value==0.0)
 let negative=size_factor_normalized_count(-1,&ok,0)
 assert(negative.status==3) assert(negative.value==0.0)
 let zero=size_factor_normalized_count(0,&ok,0)
 assert(zero.status==0) assert(zero.value==0.0)
 ok.factors[0]=0.0
 let factorzero=size_factor_normalized_count(1,&ok,0)
 assert(factorzero.status==4) assert(factorzero.value==0.0)
 ok.factors[0]=-1.0
 let factornegative=size_factor_normalized_count(1,&ok,0)
 assert(factornegative.status==4) assert(factornegative.value==0.0)
 ok.factors[0]=0.0/0.0
 let factornan=size_factor_normalized_count(1,&ok,0)
 assert(factornan.status==4) assert(factornan.value==0.0)
 ok.factors[0]=1.0e308*10.0
 let factorinf=size_factor_normalized_count(1,&ok,0)
 assert(factorinf.status==4) assert(factorinf.value==0.0)
 ok.factors[0]=1.0e-300
 let overflow=size_factor_normalized_count(9223372036854775807,&ok,0)
 assert(overflow.status==4) assert(overflow.value==0.0)
 ok.factors[0]=1.0
 ok.genes_excluded=1
 let header=size_factor_normalized_count(1,&ok,0)
 assert(header.status==1) assert(header.value==0.0)
 c[0]=0 c[8]=0 c[16]=17
 let single=median_ratio_size_factors(&c,3,1)
 assert(single.status==0) assert(single.genes_used==1) assert(single.genes_excluded==2)
 assert(single.factors[0]==1.0) assert(single.log_factors[0]==0.0)
 let value=size_factor_normalized_count(17,&single,0)
 assert(value.status==0) assert(value.value==17.0)
 println("GENOMICS_SIZE_FACTORS_STATUS_PASS")
 0
}
