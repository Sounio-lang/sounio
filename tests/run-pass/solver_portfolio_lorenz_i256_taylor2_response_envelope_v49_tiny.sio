//@ run-pass
//@ description: Tiny portfolio v49 smoke for Lorenz i256 Taylor-2 response-envelope entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 617
    receipt_fp = mix(receipt_fp, 506104143, 3137)
    receipt_fp = mix(receipt_fp, 956295573, 3137)
    receipt_fp = mix(receipt_fp, 333341021, 3137)
    receipt_fp = mix(receipt_fp, 59406573, 3137)
    receipt_fp = mix(receipt_fp, 38526066, 3137)
    receipt_fp = mix(receipt_fp, 6, 3137)
    receipt_fp = mix(receipt_fp, 127, 3137)
    receipt_fp = mix(receipt_fp, 127, 3137)
    if receipt_fp != 882801596 { return 1 }

    var audit_fp: i64 = 619
    audit_fp = mix(audit_fp, receipt_fp, 3163)
    audit_fp = mix(audit_fp, 506104143, 3163)
    audit_fp = mix(audit_fp, 956295573, 3163)
    audit_fp = mix(audit_fp, 185755530, 3163)
    audit_fp = mix(audit_fp, 167433392, 3163)
    audit_fp = mix(audit_fp, 38526066, 3163)
    audit_fp = mix(audit_fp, 6, 3163)
    audit_fp = mix(audit_fp, 127, 3163)
    audit_fp = mix(audit_fp, 127, 3163)
    if audit_fp != 961618971 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 52, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 52, 1103)
    if entry_fp != 120531857 { return 3 }

    if audit_fp == 961618972 { return 4 }
    return 0
}
