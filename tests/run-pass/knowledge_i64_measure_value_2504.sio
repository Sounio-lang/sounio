//@ run-pass
//@ description: #2504 Knowledge<i64>.value from measure(42, ..) is the integer 42 (annotated local, parameter, unannotated let), not the i64 bits read as an f64
//@ expect-stdout: let_eq42=true
//@ expect-stdout: let_eq0=false
//@ expect-stdout: let_print=42
//@ expect-stdout: let_sub=0
//@ expect-stdout: param_eq42=true
//@ expect-stdout: param_plus1=43
//@ expect-stdout: noann_eq7=true
//@ expect-stdout: f64_eq=true
//@ expect-stdout: f64_sq=6.250000
//@ expect-stdout: KNOWLEDGE_I64_2504_OK
//
// Before the fix Madaros printed eq42=false, eq0=false and `0.000000` for the
// same value: the synthetic Knowledge layout marks `value` as f64 for every T,
// so the stored i64 42 was compared and printed as the f64 with those bits (a
// subnormal). The Knowledge<f64> lines are the control that must not move.

fn param_value(k: Knowledge<i64>) -> i64 with IO, Epistemic {
    let v = k.value
    if v == 42 { println("param_eq42=true") } else { println("param_eq42=false") }
    v + 1
}

fn main() -> i64 with IO, Epistemic {
    var ok = true
    let observation: Knowledge<i64> = measure(42, uncertainty: 1.0)
    let v = observation.value
    if v == 42 { println("let_eq42=true") } else { println("let_eq42=false"); ok = false }
    if v == 0 { println("let_eq0=true"); ok = false } else { println("let_eq0=false") }
    print("let_print=")
    println(v)
    let x: i64 = 42
    print("let_sub=")
    println(v - x)
    if v - x != 0 { ok = false }
    let p = param_value(observation)
    print("param_plus1=")
    println(p)
    if p != 43 { ok = false }
    let u = measure(7, uncertainty: 0.5)
    if u.value == 7 { println("noann_eq7=true") } else { println("noann_eq7=false"); ok = false }
    let w: Knowledge<f64> = measure(2.5, uncertainty: 1.0)
    if w.value == 2.5 { println("f64_eq=true") } else { println("f64_eq=false"); ok = false }
    print("f64_sq=")
    println(w.value * w.value)
    if ok { println("KNOWLEDGE_I64_2504_OK") } else { println("KNOWLEDGE_I64_2504_FAIL") }
    0
}
