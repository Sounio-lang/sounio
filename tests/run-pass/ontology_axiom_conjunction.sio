//@ run-pass
// Test: conjunction of multiple property axioms discharges a refinement.
// Rapamycin has two properties: potency > 0.8 AND mw < 1500.0
// A function requiring { v: f64 | v > 0.5 } should be provable from
// the conjunction (potency > 0.8 implies potency > 0.5 by numeric entailment).
// This exercises the pred_and conjunction path built in the axiom injector.

ontology Pharma2 {
    class Compound {
        property potency: f64 where potency > 0.8
        property mw: f64 where mw < 1500.0
    }
    class mTORi subclass_of Compound
}

type PotentEnough = { v: f64 | v > 0.5 }

fn assert_potent(dose: PotentEnough) -> i32 with IO {
    println("potency proven")
    0
}

fn main() -> i32 with IO {
    let drug: mTORi = 1.2
    let result = assert_potent(drug)
    println("conjunction axiom proof OK")
    result
}
