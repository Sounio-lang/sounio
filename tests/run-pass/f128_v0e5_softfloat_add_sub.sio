//@ run-pass
//@ requires: madaros
//@ description: V0-E.5 — general IEEE binary128 add/sub in sio (not exact-case table)
//@ ladder-stage: V0-E.5
//@ semantic-lane: WS-G-V0E-STDLIB-GUM-SURFACE
//@ claim-clock: sounio_native_expected (ADR-008 / ADR-009)
//@ note: softfloat_limb.py is measurement-only; must not judge this claim
//@ note: language f128 Madaros-run desugar remains V0-E.4.1 fail-closed
//
// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0e5

use math::wide_float::{
    F128Bits,
    f128_bits_one,
    f128_bits_two,
    f128_bits_half,
    f128_bits_approx_1e_neg20,
    f128_bits_eq,
    f128_bits_exact_case_add,
    print_f128_bits_hex_wire,
}
use math::softfloat_f128::{f128_bits_soft_add, f128_bits_soft_sub}

fn f128_one_half() -> F128Bits {
    F128Bits { lo: 0, hi: 4611545280939032576 }
}

fn f128_one_plus_tiny() -> F128Bits {
    F128Bits { lo: 51922968585348, hi: 4611404543450677248 }
}

fn f128_recover() -> F128Bits {
    F128Bits { lo: 0, hi: 4592679628783035424 }
}

fn f128_two_plus_tiny() -> F128Bits {
    F128Bits { lo: 25961484292674, hi: 4611686018427387904 }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let one = f128_bits_one()
    let two = f128_bits_two()
    let half = f128_bits_half()
    let tiny = f128_bits_approx_1e_neg20()

    let one_plus_one = f128_bits_soft_add(one, one)
    if !f128_bits_eq(one_plus_one, two) {
        println("FAIL 1+1")
        return 1
    }

    // Outside the V0-E.4 exact-case table: 0.5+1 = 1.5
    let half_plus_one = f128_bits_soft_add(half, one)
    if !f128_bits_eq(half_plus_one, f128_one_half()) {
        println("FAIL half+one")
        return 1
    }

    let one_plus_tiny = f128_bits_soft_add(one, tiny)
    if !f128_bits_eq(one_plus_tiny, f128_one_plus_tiny()) {
        println("FAIL 1+tiny")
        return 1
    }

    let recover = f128_bits_soft_sub(one_plus_tiny, one)
    if f128_bits_eq(recover, f128_bits_one()) {
        println("FAIL f64_greenwash_identity")
        return 1
    }
    if recover.lo == 0 && recover.hi == 0 {
        println("FAIL f64_greenwash_zero")
        return 1
    }
    if !f128_bits_eq(recover, f128_recover()) {
        println("FAIL recover_mismatch")
        return 1
    }

    // exact_case refuses 2+tiny; general softfloat must not.
    let table = f128_bits_exact_case_add(two, tiny)
    if table.supported {
        println("FAIL exact_case_should_refuse_two+tiny")
        return 1
    }
    let two_plus_tiny = f128_bits_soft_add(two, tiny)
    if !f128_bits_eq(two_plus_tiny, f128_two_plus_tiny()) {
        println("FAIL two+tiny")
        return 1
    }

    print("wire_half+one=")
    print_f128_bits_hex_wire(half_plus_one)
    println("")
    print("wire_1+tiny=")
    print_f128_bits_hex_wire(one_plus_tiny)
    println("")
    print("wire_recover=")
    print_f128_bits_hex_wire(recover)
    println("")
    print("wire_two+tiny=")
    print_f128_bits_hex_wire(two_plus_tiny)
    println("")

    println("PASS f128_v0e5_softfloat_add_sub general=ieee754 rne anti_f64=green not_exact_case=two+tiny")
    return 0
}
