//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_METHOD_CALL_DESTRUCTURE PASS
//
// Copilot review (PR #2516) finding #5, ExprMethodCall half:
// `let (a, b) = obj.pair()` where `pair` is an impl method (not a free fn)
// returning `([f64; N], [f64; N])`. expr_result_tuple_arr_mask_ref only
// handled ExprKind::ExprCall, so a method-call tuple producer's destructured
// arrays never got f64-array-slot metadata and `a[0] * 2.0` misread the f64
// bit pattern as an i64.
struct Pairer {
    scale: f64,
}

impl Pairer {
    fn pair(self) -> ([f64; 2], [f64; 2]) with Mut, Panic {
        var a: [f64; 2] = [0.0; 2]
        var b: [f64; 2] = [0.0; 2]
        a[0] = 1.5 * self.scale
        a[1] = 0.25
        b[0] = 4.5
        (a, b)
    }
}

fn main() -> i32 with IO, Mut, Panic {
    let p = Pairer { scale: 1.0 }
    let (a, b) = p.pair()
    let s0: f64 = a[0] * 2.0
    let s1: f64 = 2.0 * b[0]
    var acc: f64 = 0.0
    var j: i64 = 0
    while j < 2 {
        acc = acc + 0.5 * a[j]
        j = j + 1
    }
    if s0 == 3.0 && s1 == 9.0 && acc == 0.875 {
        println("TUPLE_F64_ARRAY_METHOD_CALL_DESTRUCTURE PASS")
        return 0
    }
    1
}
