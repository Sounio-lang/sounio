//@ run-pass
//@ description: Imported bounded SMT/Farkas microkernel smoke

use theorem::smt_farkas_microkernel::*

fn main() -> i64 {
    let tiny_unsat = smt_farkas2_unsat_check(1, 0, 0 - 1, 0 - 1, 1, 1)
    if tiny_unsat != 1 { return 1 }

    let wrong_multiplier = smt_farkas2_unsat_check(1, 0, 0 - 1, 0 - 1, 1, 0)
    if wrong_multiplier != 0 { return 2 }

    let artifact = smt_farkas_microkernel_receipt_check(1, 1, 1, 1, 1, 3, 5, 0, 0, 100)
    if artifact != 583104927 { return 3 }

    let audit = smt_farkas_microkernel_audit_fingerprint(
        artifact, 284916705, 640271893, 1, 1, 1, 1, 1, 3, 5, 0, 0, 0, 100, 1023)
    if audit != 719460238 { return 4 }
    return 0
}
