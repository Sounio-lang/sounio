//@ run-pass
//
// Regression: Knowledge<Hyper<Octonion, f64>> multiplication reaches the
// hyper-expression metadata path that lowers to IrHyperEpistemicMul.

algebra Octonion over f64 {
    add: commutative, associative
    mul: alternative, non_commutative
    reassociate: fano_selective
}

fn fused(
    a: Knowledge<Hyper<Octonion, f64>>,
    b: Knowledge<Hyper<Octonion, f64>>,
) -> Knowledge<Hyper<Octonion, f64>> with Mut, Div, NonAssoc, Epistemic {
    a * b
}

fn main() -> i32 with IO {
    0
}
