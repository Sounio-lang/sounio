//@ run-pass
//@ requires: madaros
//@ expect-stdout: kl14c_dynlink_n_symbols: PASS
// KL-14c: N non-builtin externs from one DT_NEEDED library via GOT.
// Needs libkl14c_probe.so on LD_LIBRARY_PATH (Witness gate and
// madaros_changed_tests_gate.sh stage tests/fixtures/kl14c/kl14c_probe.c).
// Gate: scripts/ci/madaros_kl14c_dynlink_gate.sh

extern "C" {
    fn kl14c_add(a: i64, b: i64) -> i64
    fn kl14c_mul(a: i64, b: i64) -> i64
    fn kl14c_neg(a: i64) -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let s = kl14c_add(10, 5)
    let p = kl14c_mul(s, 2)
    let n = kl14c_neg(p)
    if n == 0 - 30 {
        println("kl14c_dynlink_n_symbols: PASS")
        return 0
    }
    println("kl14c_dynlink_n_symbols: FAIL")
    return 1
}
