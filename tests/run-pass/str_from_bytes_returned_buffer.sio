//@ run-pass
//@ description: str_from_bytes copies its bytes. A string built from a local byte array and returned must survive the callee's frame being reused (#1680: lean_single returned the array's address, so the Madaros contract JSON printed `"stack_map_records":,`).
//@ expect-stdout: PASS

fn digits(v: i64) -> string with Mut, Panic, Div {
    var out: [i8; 64] = [0; 64]
    var n = v
    var rev: [i8; 32] = [0; 32]
    var k: i64 = 0
    while n > 0 && k < 31 {
        rev[k as usize] = (48 + n % 10) as i8
        k = k + 1
        n = n / 10
    }
    var i: i64 = 0
    while i < k {
        out[i as usize] = rev[(k - 1 - i) as usize]
        i = i + 1
    }
    str_from_bytes(out, k)
}

// Reuses the stack below the caller after digits() has returned.
fn clobber(seed: i64) -> i64 with Mut, Panic, Div {
    var junk: [i64; 512] = [0; 512]
    var i: i64 = 0
    while i < 512 {
        junk[i as usize] = seed + i
        i = i + 1
    }
    junk[7] + junk[300]
}

fn main() with IO, Mut, Panic, Div {
    let a = digits(1234)
    let b = digits(98765)
    let c = clobber(3)
    var ok = true
    if str_len(a) != 4 { ok = false }
    if str_len(b) != 5 { ok = false }
    if !str_eq(a, "1234") { ok = false }
    if !str_eq(b, "98765") { ok = false }
    if c != 313 { ok = false }
    if ok { println("PASS") } else {
        print("FAIL a=")
        print(a)
        print(" b=")
        println(b)
    }
}
