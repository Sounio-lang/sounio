//@ run-pass
//@ description: Imported graph-colouring CNF manifest layout gate

use theorem::cardinality::*

fn main() -> i64 with Div {
    let n: i64 = 3
    let m: i64 = 3
    let k: i64 = 2

    if card_colour_vertex_block_count(n, k) != 6 { return 1 }
    if card_colour_edge_clause_count(m, k) != 6 { return 2 }
    if card_colour_total_clause_count(n, m, k) != 12 { return 3 }

    if card_colour_edge_base_id(n, k) != 7 { return 4 }
    if card_colour_clause_kind(n, m, k, 0) != 0 { return 5 }
    if card_colour_clause_kind(n, m, k, 1) != 1 { return 6 }
    if card_colour_clause_kind(n, m, k, 6) != 1 { return 7 }
    if card_colour_clause_kind(n, m, k, 7) != 2 { return 8 }
    if card_colour_clause_kind(n, m, k, 12) != 2 { return 9 }
    if card_colour_clause_kind(n, m, k, 13) != 0 { return 10 }

    if card_colour_vertex_from_clause(n, k, 1) != 0 { return 11 }
    if card_colour_vertex_local_clause_id(n, k, 1) != 1 { return 12 }
    if card_colour_vertex_from_clause(n, k, 2) != 0 { return 13 }
    if card_colour_vertex_local_clause_id(n, k, 2) != 2 { return 14 }
    if card_colour_vertex_from_clause(n, k, 3) != 1 { return 15 }
    if card_colour_vertex_local_clause_id(n, k, 3) != 1 { return 16 }
    if card_colour_vertex_from_clause(n, k, 6) != 2 { return 17 }
    if card_colour_vertex_local_clause_id(n, k, 6) != 2 { return 18 }

    if card_colour_edge_clause_id(n, k, 0, 0) != 7 { return 19 }
    if card_colour_edge_clause_id(n, k, 0, 1) != 8 { return 20 }
    if card_colour_edge_clause_id(n, k, 1, 0) != 9 { return 21 }
    if card_colour_edge_clause_id(n, k, 2, 1) != 12 { return 22 }

    if card_colour_edge_index_from_clause(n, m, k, 7) != 0 { return 23 }
    if card_colour_edge_colour_from_clause(n, m, k, 7) != 0 { return 24 }
    if card_colour_edge_index_from_clause(n, m, k, 8) != 0 { return 25 }
    if card_colour_edge_colour_from_clause(n, m, k, 8) != 1 { return 26 }
    if card_colour_edge_index_from_clause(n, m, k, 11) != 2 { return 27 }
    if card_colour_edge_colour_from_clause(n, m, k, 11) != 0 { return 28 }
    if card_colour_edge_index_from_clause(n, m, k, 12) != 2 { return 29 }
    if card_colour_edge_colour_from_clause(n, m, k, 12) != 1 { return 30 }

    if card_colour_vertex_from_clause(n, k, 7) != (0 - 1) { return 31 }
    if card_colour_edge_index_from_clause(n, m, k, 6) != (0 - 1) { return 32 }
    if card_colour_total_clause_count(n, 0 - 1, k) != (0 - 1) { return 33 }
    if card_colour_total_clause_count(n, m, 0) != (0 - 1) { return 34 }
    if card_colour_var_count(n, k) != 6 { return 35 }
    if card_colour_manifest_fingerprint(n, m, k) != 296728038 { return 36 }
    if card_colour_manifest_fingerprint(n, 2, k) != 760753411 { return 37 }
    if card_colour_first_derived_clause_id(n, m, k) != 13 { return 38 }
    if card_colour_final_derived_clause_id(n, m, k, 7) != 19 { return 39 }
    if card_colour_lrat_header_valid(n, m, k, 296728038, 13) != 1 { return 40 }
    if card_colour_lrat_header_valid(n, m, k, 296728039, 13) != 0 { return 41 }
    if card_colour_lrat_header_valid(n, m, k, 296728038, 12) != 0 { return 42 }
    if card_colour_final_derived_clause_id(n, m, k, 0) != (0 - 1) { return 43 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, 296728038, 13, 7, 19, 0) != 1 { return 44 }
    if card_colour_lrat_unsat_bundle_fingerprint(n, m, k, 296728038, 13, 7, 19, 0) != 500954697 { return 45 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, 296728038, 13, 7, 18, 0) != 0 { return 46 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, 296728038, 13, 7, 19, 1) != 0 { return 47 }
    if card_colour_lrat_unsat_bundle_fingerprint(n, m, k, 296728038, 13, 7, 19, 1) != (0 - 1) { return 48 }

    return 0
}
