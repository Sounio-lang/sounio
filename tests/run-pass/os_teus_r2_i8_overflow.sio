//@ run-pass
// R2 narrow-integer witness: i8 100 + 100 must wrap to -56 (two's complement).
//
// Before R2: declared `i8` was i64 with another name; 100 + 100 evaluated
// as 200 on the i64 register and printed as 200.
// After R2: the binop result type follows lhs_ty (i8); the binop emit
// applies the 8-bit mask, giving 200 & 0xFF = 0xC8 = -56 in i64.

fn main() with IO, Div, Panic {
    let x: i8 = 100 + 100
    if x == 0 - 56 {
        print("r2_i8_overflow: PASS\n")
    } else {
        print("r2_i8_overflow: FAIL got=")
        print_int(x)
        print("\n")
    }
}
