 inputs[43]=46
 inputs[44]=48
 inputs[45]=49
 viz_node_set_label(&!scene,xa,&xn,18)
 viz_node_set_label(&!scene,ya,&yn,20)
 assert(viz_add_label(&!scene,&title,35,viz_layout_rect(160,20,600,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,47,viz_layout_rect(160,48,600,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,curve,&nominal,23,viz_layout_rect(160,426,280,22))>=0)
 assert(viz_add_series_legend(&!scene,first_bar,&bars,29,viz_layout_rect(470,426,330,22))>=0)
 assert(viz_add_label(&!scene,&foot,54,viz_layout_rect(160,462,650,14),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_label(&!scene,&inputs,46,viz_layout_rect(160,490,650,14),viz_style_rgb(190,200,215))>=0)
 let u=axis_label(equal.standard_uncertainty)
 var eq:[i8;64]=[0;64]
 eq[0]=65
 eq[1]=116
 eq[2]=32
 eq[3]=86
 eq[4]=102
 eq[5]=61
 eq[6]=86
 eq[7]=105
 eq[8]=58
 eq[9]=32
 eq[10]=68
 eq[11]=101
 eq[12]=108
 eq[13]=116
 eq[14]=97
 eq[15]=32
 eq[16]=83
 eq[17]=61
 eq[18]=48
 eq[19]=59
 eq[20]=32
 eq[21]=117
 eq[22]=61
 i=0
 while i<u.n {eq[(i+23) as usize]=u.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&eq,u.n+23,viz_layout_rect(160,80,600,20),viz_style_rgb(230,235,245))>=0)
 assert(scene.series_count==6 && scene.node_count==15)
 let pixels=heap_alloc(960*520*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:960,height:520}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,360*960+138)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,960,520)
 println("VIZ_ISOTHERMAL_ENTROPY_PASS")
 0
}
