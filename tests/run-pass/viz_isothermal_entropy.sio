//@ run-pass
//@ expect-stdout: VIZ_ISOTHERMAL_ENTROPY_PASS
//@ expect-stdout: data-interval-kind="standard-uncertainty"
//@ expect-stdout: Independent standard uncertainties; first-order
use physics::entropy::{isothermal_entropy_independent}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_axis,viz_line_set_viewport,
 viz_add_label,viz_node_set_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb,
 viz_line_set_standard_uncertainty,VIZ_INTERVAL_STANDARD_UNCERTAINTY}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var xs:[f64;1024]=[0.0;1024]
 var ys:[f64;1024]=[0.0;1024]
 var i:i64=0
 while i<65 {
  let ratio=0.5+(i as f64)*1.5/64.0
  let r=isothermal_entropy_independent(1.0,0.01,ratio,0.01,1.0,0.01)
  assert(r.status==0 && r.first_order && r.uncertainty_model==1)
  xs[i as usize]=ratio
  ys[i as usize]=r.delta_s
  i=i+1
 }
 let equal=isothermal_entropy_independent(1.0,0.01,1.0,0.01,1.0,0.01)
 assert(equal.status==0 && equal.delta_s==0.0 && equal.standard_uncertainty>0.0)
 var scene=viz_scene_new()
 let curve=viz_add_line_chart(&!scene,&xs,&ys,65,viz_layout_rect(160,120,600,240),viz_style_rgb(70,180,235))
 assert(viz_line_set_viewport(&!scene,curve,0.5,2.0,-8.0,8.0))
 var ratios:[f64;5]=[0.5,0.75,1.0,1.5,2.0]
 var bar_x:[f64;1024]=[0.0;1024]
 var bar_y:[f64;1024]=[0.0;1024]
 var first_bar:i64=-1
 i=0
 while i<5 {
  let ratio=ratios[i as usize]
  let r=isothermal_entropy_independent(1.0,0.01,ratio,0.01,1.0,0.01)
  assert(r.status==0)
  let lower=r.delta_s-r.standard_uncertainty
  let upper=r.delta_s+r.standard_uncertainty
  assert(lower<=r.delta_s && r.delta_s<=upper)
  bar_x[0]=ratio
  bar_x[1]=ratio
  bar_y[0]=lower
  bar_y[1]=upper
  let bar=viz_add_line_chart(&!scene,&bar_x,&bar_y,2,viz_layout_rect(160,120,600,240),viz_style_rgb(245,170,65))
  assert(bar>=0 && viz_line_set_viewport(&!scene,bar,0.5,2.0,-8.0,8.0))
  assert(viz_line_set_standard_uncertainty(&!scene,bar,r.delta_s,r.standard_uncertainty))
  let slot:i64=scene.nodes[bar as usize].data_slot
  assert(scene.series[slot as usize].interval_kind==VIZ_INTERVAL_STANDARD_UNCERTAINTY)
  assert(scene.series[slot as usize].interval_level==0.0)
  assert(scene.series[slot as usize].lower[0]==lower)
  assert(scene.series[slot as usize].upper[0]==upper)
  if i==0 {first_bar=bar}
  i=i+1
 }
 let xa=viz_add_axis(&!scene,0.5,2.0,3,false,viz_layout_rect(160,378,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,-8.0,8.0,4,true,viz_layout_rect(140,120,1,240),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=73
 title[1]=100
 title[2]=101
 title[3]=97
 title[4]=108
 title[5]=45
 title[6]=103
 title[7]=97
 title[8]=115
 title[9]=32
 title[10]=105
