//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: MODULE_ARRAY_MUT_REF_OK
//@ description: a module-level array passed through &! is written and read back (stdlib/ontology/elplus.sio used to say this miscompiled)
var G: [i64; 16] = [0; 16]
fn fill(a: &! [i64; 16]) with Mut, Panic, Div {
    var i: i64 = 0
    while i < 10 { a[i as usize] = i + 1  i = i + 1 }
}
fn sum(a: &[i64; 16]) -> i64 with Mut, Panic, Div {
    var s: i64 = 0
    var i: i64 = 0
    while i < 16 { s = s + a[i as usize]  i = i + 1 }
    s
}
fn main() -> i32 with IO, Mut, Panic, Div {
    fill(&! G)
    if G[9] == 10 && sum(&G) == 55 { print("MODULE_ARRAY_MUT_REF_OK\n"); return 0 }
    print_int(G[9]) print(" ") print_int(sum(&G)) print("\n")
    1
}
