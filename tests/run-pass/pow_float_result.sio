//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS
//
// Regression (SIO-205): a bare `pow(x, y)` call compiled "successful" but the
// emitted binary died with SIGILL (rc=132). The checker pre-binds `pow` as a
// known import, yet native-v2 had no builtin for the plain name, so the call
// reached the empty-stub ud2 that guards missed declarations. The FO variance
// path already knew the way out ("a bare `pow` ir_call is an empty_stub_ud2")
// and routes through ffi_pow (builtin 49); plain calls now resolve to the
// same kernel. An extern "C" pow was never affected (libm PLT).

fn approx_eq(a: f64, b: f64, eps: f64) -> bool with Mut, Panic {
    let d = a - b
    if d < 0.0 { (0.0 - d) < eps } else { d < eps }
}

fn main() -> i64 with IO, Mut, Panic {
    let ok = approx_eq(pow(3.0, 2.0), 9.0, 0.000001)
        && approx_eq(pow(2.0, 10.0), 1024.0, 0.000001)
        && approx_eq(pow(9.0, 0.5), 3.0, 0.000001)
    if ok {
        println("PASS")
    } else {
        println("FAIL")
    }
    0
}
