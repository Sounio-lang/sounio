//@ run-pass
//@ expect-stdout: PRIVATE_FIELD_OWNER_BORROW_OK
use collections::numeric_buffer::{NumericValue,numeric_buffer_get,numeric_buffer_new,numeric_buffer_resize,numeric_buffer_len,numeric_buffer_close}
struct MyStruct {value:i64}
fn overwrite(x:&!i64) with Mut {*x=0}
fn public_status(v:&NumericValue)->i64 {v.status}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var local=MyStruct {value:7}
 overwrite(&!local.value)
 assert(local.value==0)
 var owner=numeric_buffer_new(1,16)
 assert(numeric_buffer_resize(&!owner,2)==0)
 assert(numeric_buffer_len(&owner)==2)
 let value=numeric_buffer_get(&owner,0)
 assert(public_status(&value)==0)
 numeric_buffer_close(owner)
 println("PRIVATE_FIELD_OWNER_BORROW_OK")
 return 0
}
