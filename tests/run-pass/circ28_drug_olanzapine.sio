//@ run-pass
//@ timeout: 300
//@ expect-stdout-contains: CIRC28_DRUG_OLANZAPINE_PASS
//
// Olanzapine (oral tablet) on the circ28 drug record (stdlib/darwin_pbpk/circ28_drug_olanzapine.sio;
// parameter table, sources and access levels in its header). Reference subject: healthy NON-SMOKING
// man. No intravenous data exist: CL/F and V_ss/F are apparent, F = 0.60 is a label input with a
// judgment uncertainty and is not identifiable from oral data.
//
// FITTED, hence NOT validations (one observable per fitted parameter, each pooled in Sounio):
//   hepatic clint <- pooled CL/F (Sun 2021 15.5, Li 2018 healthy 15.5, Bigos 2008 16.1 L/h; k 3, N 1146)
//   Kp scalar     <- pooled V_ss/F of the two-compartment popPK models (Sun 2021 881 L, Li 2018 684 L; k 2, N 623)
//   ka            <- pooled Tmax (Sun 2018 5.0 h, PMC3480756 5.0 h; k 2, N 66)
//   fm (CYP1A2 share of the hepatic clint, non-smoker) <- fluvoxamine AUC ratio in non-smokers / healthy
//                    volunteers (label female non-smokers 1.52, Wang 2004 1.76; k 2, unweighted: one n unknown)
//   DERIVED: renal clearance = fe x CL/F (fe 0.07); CD_FA = F / (1 - Eh) (pre-hepatic availability).
//   The smoker / non-smoker ratio is VALIDATION (the task allowed fitting fm to either). Disclosure: both
//   alternatives were worked by hand before the choice (see the report); the choice is on conditioning
//   (fm from the smoking ratio needs the induction fold and has u 0.45), but it was not blind. S5d prints
//   the smoking-fit alternative as a diagnostic.
//
// CRITERIA (fixed before the runs): an observation with a between-subject SD: |z| <= 2; an observation
// with no spread: prediction within the stated fold (1.5 unless said; 1.25 for label statements of a mean).
// A row whose study is inside a fit pool is a CONSISTENCY check and is marked (c).
//
// PREDICTIONS WRITTEN BEFORE ANY KERNEL RUN (hand arithmetic: Q_h 99.45 L/h, bp 0.62, fu 0.07, CL/F 15.75,
// V_ss/F 874; they are also in the report, section 3). [HIT] / [MISSED] were added after the first run and
// nothing above them was changed.
//   P0  input check: ln2 (V_ss/F) / (CL/F) = 38.5 h against the pooled NCA terminal half-life 33.7 h (Sun 2018
//       34.5, Kassahun 27): the mean-residence half-life EXCEEDS the terminal one, impossible for any
//       disposition: the popPK volumes and the NCA half-lives are mutually inconsistent. No structure added.
//   P1  Eh 0.135, Fh 0.865, CD_FA 0.69                                                    [HIT: 0.1356, 0.864, 0.694]
//   P2  F with complete absorption and hepatic first pass only: 0.81 (label 0.60), diagnostic
//   P3  AUCinf 10 mg 635 ng h/mL vs Sun 2018 632.6 (197.2) (c)                PASS
//   P4  terminal t1/2 (72-168 h) 45 h (40-52): vs Sun 2018 34.5 (8.7) z 1.2 PASS (borderline); vs label 30 h,
//       SD (54-21)/3.29 = 10.0, z 1.5 PASS; vs Kassahun 27 h fold 1.67 FAIL
//   P5  Cmax 10 mg 16 ng/mL (13-20): vs Sun 2018 16.6 (3.8) PASS; vs PMC3480756 14.47 (4.25) PASS
//   P6  Cmax 12.5 mg 20 (16-25) vs Kassahun 11 ng/mL: FAIL (fold about 1.8)
//   P7  Tmax 5.0 h (fitted) vs label "approximately 6 hours": fold 1.25 PASS (c)
//   P8  steady state 15 h after the dose, non-smoker: 2.5 (2.3-2.7) ng/mL per mg/day vs Citrome 2009
//       non-smokers 2.56 (1.23), 2.17 (1.24), 2.83 (1.10) at 10, 20, 40 mg/day: PASS x3
//   P9  same, smoker: 1.9 (1.7-2.0) vs Citrome smokers 1.65 (0.96), 1.71 (1.04), 1.52 (0.87): PASS x3
//   P10 steady-state trough, non-smoker: 2.2 (2.0-2.4) vs Skogh 2011 3.32 (fold 0.66, marginal FAIL at 1.5)
//       and Skogh 2002 2.87 (fold 0.77 PASS); sampling times are not in those abstracts
//   P11 fm 0.41 (0.36-0.46) vs in vitro 0.409 (Sun 2020 citing Korprasertthaworn 2015): fold 1.25 PASS
//   P12 smoker / non-smoker CL/F 1.33 (1.28-1.38) vs pooled 11 studies about 1.60 (u about 0.36): PASS, z about -0.75
//   P13 fluvoxamine AUC ratio in smokers 2.1 (1.9-2.3) vs label male smokers 2.08 (fold 1.25) PASS; vs Chiu
//       2004 at 100 mg/day 1.55 (fold 1.5) PASS
//   P14 fluvoxamine at steady state in patients vs the non-smoker value 1.64: Hiemke 1.81, Weigmann 2.3,
//       Gex-Fabry 1.74: PASS x3 at fold 1.5
//   P15 carbamazepine WHAT-IF (smoking fold borrowed): CL/F x1.33 vs label 1.5 (fold 1.25) PASS; vs Haslemo
//       2012 2.0 marginal FAIL (0.67); vs Gex-Fabry 1.67 PASS (fold 1.5)
//   P16 accumulation AUCinf / AUC0-24: 2.9 (2.6-3.3) vs label "approximately twice": fold 1.5, marginal PASS (1.45)
//   P17 CL/F 15.75 vs the label distribution, mean 25, SD (47-12)/3.29 = 10.6: z -0.87 PASS
//   P18 IM / oral AUC at the same dose = 1/F = 1.67 vs label "similar" (1.0): FAIL at 1.5 (the label
//       contradicts its own 40 % first pass)
//   P19 dose linearity: exact in a linear model (identity, not a test)
//   P20 share of F in var(AUC) and var(trough): below 1 %
//   P21 relative u(AUC) about 2 % (the uncertainty of the population-typical value, not the inter-individual CV 43 %)
//   P22 sex: NOT predicted (ICRP man; no sourced female CYP1A2 factor)
//
// RESULTS OF THE FIRST RUN (local Madaros; the predictions above were not edited afterwards). Every
// pre-registered row outcome was hit. Central values: Eh 0.1356, CD_FA 0.694, F(complete absorption) 0.811;
// AUCinf 634 ng h/mL; t1/2 47.5 h (z 1.49 and 1.75 PASS, fold 1.76 vs Kassahun FAIL); Cmax 13.2 ng/mL (z -0.89, -0.30);
// Cmax 12.5 mg 16.5 vs 11: fold 1.501, FAIL by a hair (predicted about 1.8: outcome hit, size over-stated);
// steady state 15 h: 2.53 (non-smoker), 1.87 (smoker); trough 2.05 (fold 0.62 FAIL vs Skogh 2011, 0.71 PASS vs
// Skogh 2002); fm 0.457 (predicted 0.41, range 0.36-0.46: inside, at its upper edge; the hand value ignored the
// renal clearance; the band first written for fm, 0.38-0.44, was wrong and was replaced by 0.44-0.47 AFTER the run);
// smoker ratio 1.33 against a pool of 1.53 (u 0.33; I had estimated 1.60 and 0.36 by hand): z -0.60; fluvoxamine
// in smokers 2.13; carbamazepine what-if 1.33 (fold 0.89, 0.66 FAIL, 0.80); accumulation 2.65 (fold 1.33 PASS;
// predicted 2.9); share of F 0 % (AUC) and 0.5 % (trough); relative u(AUC) 1.3 %.
// ROWS ADDED WITH THE CODE AND NOT PRE-REGISTERED (P13c, P13d, P13e): the fluvoxamine Cmax ratio is UNDER-predicted
// (1.12 vs 1.5 in non-smokers, 1.21 vs 1.77 in smokers; inside the 1.5 fold) while the half-life ratio is right
// (1.43 vs 1.40). Diagnosis: the record puts 31 % of the oral loss in a pre-hepatic term (CD_FA 0.69) that
// fluvoxamine does not touch and only 14 % in the liver, so inhibition barely raises F. The observed Cmax rise
// says the first pass IS CYP1A2-sensitive: it supports the label's 40 % being metabolic, which the fitted CL/F
// cannot give through the liver alone (Eh 0.19 at most with F = 1 - Eh). Not tuned.
// The asserted bands are those of this first run (written after it), so the test pins the measured discrepancies.
//
//
// ===== ROUND (transit input + gut-wall Kp test), 2026-11-15 ===================================================
// PRE-REGISTRATION, written BEFORE any run of the changed code (only `souc check` had been run). What I had seen
// before writing it: the first-round numbers above and the distribution-spectrum report (olanzapine IV alpha t1/2
// 4.2 h); nothing from a run of the transit or gut code.
// CHANGES UNDER TEST: (1) oral input = Erlang transit chain with ntr = 4 stages (published "3 transit
// compartments with Ka = Ktr" = 3 + 1 stages, rule 11; n = 3 is a DECLARED ASSUMPTION, no olanzapine transit model
// exists, transit_literature.md), tlag = 0.877 h (Li 2018 ALAG1, PMC6104801 Table 2, FT: 0.877, RSE 4.7 %, confirmed
// by opening the paper; replaces Sun 2018's 0.5 h), k (CD_KA, per stage) refitted to the SAME pooled Tmax 5.0 h.
// (2) gut variant: organ 8 left at its Rodgers-Rowland Kp, V_ss scalar refitted (circ28_kp_scale_for_vss_gutrr).
// Both are run with the full validation; the all-organ column is the one the module had.
//  R1  k (per stage) 0.85-1.35 /h (centre 1.05; mean transit time 3.0-4.7 h) for both gut variants
//  R2  AUCinf, terminal t1/2 (72-168 h), CL/F closed form, V_ss, Eh, CD_FA, fm, smoker ratio, fluvoxamine AUC ratios:
//      unchanged to 0.5 % (they do not depend on the input shape; AUC = dose/(CL/F) is an identity)
//  R3  Cmax 10 mg rises: 14.8-17.2 ng/mL (baseline 13.2; +12 to +30 %): P5a/P5b z move toward 0 (PASS stays)
//  R4  Cmax 12.5 mg 18.5-21.5 ng/mL, fold against Kassahun 11: 1.68-1.95, FAIL, WORSE than the baseline 1.50
//  R5  Cmax/AUC 0.0234-0.027 /h (observed Sun 2018 16.6/632.6 = 0.0262)
//  R6  steady state C(15 h) per mg/day within 5 % of the baseline (2.53 / 1.87), P8, P9 all PASS; trough within 2 %
//      (2.05): P10a FAIL (fold 0.62) stays, P10b PASS stays; accumulation 2.45-2.60 PASS
//  R7  fluvoxamine Cmax ratios stay BELOW the observed ones: non-smoker 1.10-1.18 (obs 1.515), smoker 1.19-1.26 (obs
//      1.77); folds stay inside 1.5 (PASS); the direction miss (too small) does not close: no gut metabolism in the
//      record, so the transit input cannot create a CYP1A2-sensitive first pass
//  R8  gut variant: scalar changes by +0.5 to +4 % (the gut wall is a small share of V_ss), k by under 6 %, Cmax by
//      under 3 % relative to the all-organ column; no validation row changes verdict; DECISION: not adopted (it does
//      not improve the failing peak rows by more than 3 %, the criterion of the brief is "improves")
//  R9  Tmax of the runs: 5.0 h by construction (fit); budget relative u(AUC) 1.2-1.5 %
//
// ===== SECOND PRE-REGISTRATION (coordinator request, 2026-11-15): chain WITHOUT lag ==============================
// Written BEFORE any run of tlag = 0 (only the first-round chain + lag results above were known). Reason: Li 2018's
// 0.877 h lag belongs to a first-order + lag structure; with a chain the two delays overlap. Columns: A first order +
// lag 0.5 (round 1), B chain + lag 0.877 (measured above), C chain, tlag 0, k refitted to the same pooled Tmax 5.0 h.
// Pre-registered for C (10 mg, non-smoker unless stated):
//  C1  k per stage 0.85-1.10 /h (mean transit time 3.6-4.7 h: the lag is gone, the chain must carry it)
//  C2  Cmax 15.5-19.5 ng/mL (between A 13.2 and B 20.6; centre 17.5); Cmax/AUC 0.0245-0.031 /h
//  C3  12.5 mg Cmax fold vs Kassahun 11: 1.76-2.22, FAIL (worse than A 1.50, better than B 2.34)
//  C4  fluvoxamine Cmax ratio non-smoker 1.09-1.13, smoker 1.17-1.21 (A 1.12 / 1.21; B 1.100 / 1.179); the smoker
//      verdict (PASS needs fold <= 1.5, i.e. ratio >= 1.18) is a coin flip, predicted FAIL at 1.18 or below
//  C5  AUC, t1/2, fm, smoker ratio, accumulation 2.45-2.62, C15 within 5 % of B, trough 1.97-2.05: unchanged in kind
//  C6  DECISION RULE (coordinator): adopt C unless it worsens a validation row beyond its stated uncertainty relative
//      to round 1 (A); if both chain columns worsen validation, say so and keep C as the declared structure.
//      Prediction: C worsens the 12.5 mg Cmax row (fold 1.50 -> about 2.0, beyond the row's own 1.5-fold tolerance)
//      and probably the smoker fluvoxamine Cmax ratio, so C is adopted as declared structure with the worsened rows
//      asserted as measured.
//
// RESULTS OF THE TRANSIT ROUND (run after the pre-registration above, which was not edited). Per row, hit or miss:
//  R1 HIT   k 1.2675 /h (mean transit time 3.16 h); gut variant 1.1318.
//  R2 HIT   AUCinf 633.97 (first round 634), t1/2 47.49 (47.5): unchanged to 0.03 %.
//  R3 MISSED Cmax 10 mg 20.61 ng/mL (predicted 14.8-17.2; +56 % over the first-round 13.2, not +12-30 %). Against Sun
//      2018 16.6 (3.8): z +1.06 (was -0.89), PASS; against PMC3480756 14.47 (4.25): z +1.45 (was -0.30), PASS. The model
//      now OVER-predicts the peak: Cmax/AUC 0.0325 /h against the observed 0.0262 (sharper input at the same Tmax, and a
//      lag 0.38 h longer, together fold the early absorption into a narrow pulse).
//  R4 HIT in outcome, MISSED in size: 12.5 mg Cmax 25.8 ng/mL, fold 2.34 against Kassahun 11 (predicted 1.68-1.95);
//      FAIL, worse than the first-round 1.50. This row fails more with the transit input.
//  R5 MISSED Cmax/AUC 0.0325 /h (predicted 0.0234-0.027).
//  R6 HIT (C15 non-smoker 2.453, smoker 1.799: -3.0 %, -3.8 %; accumulation 2.549), MISSED for the trough (-3.1 %,
//      predicted within 2 %): trough 1.986, fold 0.60 against Skogh 2011 (FAIL as before) and 0.69 against Skogh 2002 (PASS).
//  R7 MISSED (narrowly for the non-smoker): fluvoxamine Cmax ratio 1.0996 (range 1.10-1.18) and smoker 1.179 (1.19-1.26).
//      Direction hit: both below the observed 1.515 and 1.77. Verdict change: the smoker row (fold 0.666 against 1.77) goes
//      PASS -> FAIL at 1.5 (was 0.68); the non-smoker row stays PASS (0.726). The transit input does not repair the
//      CYP1A2-sensitive first pass, as predicted; it lowers the ratios slightly.
//  R8 PARTLY: scalar +2.1 % HIT, Cmax -1.9 % HIT (down, not up), k -10.7 % MISSED (predicted under 6 %); decision NOT
//      adopted HIT: no row improves beyond u(Cmax) = 14.5 % (B:P carries 48 % of var(Cmax)), the 12.5 mg fold 2.34 -> 2.30
//      stays FAIL, t1/2 +0.94 %, fluvoxamine Cmax ratios +0.005 and +0.010.
//  R9 HIT   Tmax 5.0 h, relative u(AUC) 1.27 %. u(k) 0.121 (9.5 %).
// VERDICT CHANGES against the first round (old -> new): P6 fold 1.50 -> 2.34 (FAIL stays, worse); P13c 0.68 PASS -> 0.666
// FAIL; P5a z -0.89 -> +1.06 and P5b z -0.30 -> +1.45 (PASS stays); P16 fold 1.33 -> 1.27 PASS; P20 share of F in var(trough) 0.5 %
// -> 6.3 % (the band was 1 %: it is now 5-8 %, because the trough now depends on F through k and the refit).
// Test bands were reset after this run to the measured values; the earlier asserted bands that the new input moved
// (P5a, P5b, P6, P16, k, u(k), P20) are the ones changed.
// Section SG is the gut-unscaled column. Madaros workaround added: the test is split into ot_gv0 (record and runs) and
// ot_sec_alt (second record), because main holding a record while a callee builds another segfaulted; values of the
// record are read through ot_v right after the record is built (the f64-before-record defect).
//
// RESULTS OF THE SECOND PRE-REGISTRATION (section SC; chain without lag, ADOPTED). Every row C1-C5 HIT.
//   A first order + lag 0.5 | B chain + lag 0.877 | C chain, tlag 0 (k per stage 1.0293 /h, mean transit time 3.89 h)
//   Cmax 10 mg ng/mL        13.21 | 20.61 | 18.59      Cmax/AUC 1/h  0.0208 | 0.0325 | 0.0293 (observed 0.0262)
//   P5a z (Sun 16.6)        -0.89 | +1.06 | +0.52      P5b z (14.47) -0.30 | +1.45 | +0.97
//   12.5 mg fold vs 11      1.50 | 2.34 | 2.11         fluvoxamine Cmax non-smoker 1.119 | 1.100 | 1.106 (obs 1.515)
//   fluvoxamine Cmax smoker 1.212 | 1.179 | 1.190 (obs 1.77; PASS needs a fold >= 0.667: 0.685 | 0.666 FAIL | 0.672 PASS)
//   trough 2.047 | 1.986 | 1.981      C15 non-smoker 2.527 | 2.453 | 2.447      AUCinf 633.97 in all three
// DECISION: C adopted. Against round 1 it worsens the 12.5 mg Cmax row beyond its tolerance (1.50 -> 2.11); the two Cmax
// rows with SDs stay PASS; the smoker fluvoxamine row stays PASS (B had flipped it). Both chain columns worsen the 12.5 mg row,
// so C is kept as the declared structure and the worsened row is asserted as measured. The gut variant stays rejected
// (Cmax -1.7 %, k 0.9388 vs 1.0293, scalar +2.1 %).
// The first-round pre-registered rows R1-R9 above are now evaluated on COLUMN B (their structure); SC prints them.
// tlag: the record has no lag (status unused); Li 2018's 0.877 h and Sun 2018's 0.5 h are comparison columns only.
//
// Compiler notes (workarounds, nothing fixed): kernel runs are made by one-level helpers called from main and
// return scalars through an out array (the pattern that works on lean_single); the record is filled by
// olz_drug_into in main's frame; guard rows compare the same quantity computed two ways (S2).

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_drug_olanzapine::*

fn ot_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn ot_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    let r = ot_abs(got - want) / ot_abs(want)
    print("  "); print(tag); print(": got "); print(got); print(" want "); print(want); print("  rel "); println(r)
    if !(r <= tol) {
        println("  [FAIL] above tolerance")
        return 1
    }
    return 0
}

fn ot_band(tag: string, v: f64, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    print("  "); print(tag); print(" = "); println(v)
    if v >= lo && v <= hi { return 0 }
    print("  [FAIL] outside ["); print(lo); print(", "); print(hi); println("]")
    return 1
}

// One validation row. sd > 0: criterion |z| <= 2 on the between-subject SD; sd = 0: within `fold`.
// pre: the outcome written before the run (1 pass, 0 fail). A missed prediction is printed, not hidden,
// and does not fail the test; the test fails only when the measured statistic (z, or pred/obs) leaves
// the band asserted after the first run.
fn ot_row(tag: string, pred: f64, obs: f64, sd: f64, fold: f64, pre: i32, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    var stat = pred / obs
    var pass = false
    if sd > 0.0 {
        stat = (pred - obs) / sd
        pass = ot_abs(stat) <= 2.0
    } else {
        pass = stat <= fold && stat >= 1.0 / fold
    }
    print("  "); print(tag); print(": pred "); print(pred); print("  obs "); print(obs)
    if sd > 0.0 {
        print("  SD "); print(sd); print("  z "); print(stat)
    } else {
        print("  fold "); print(stat)
    }
    if pass { print("  PASS") } else { print("  FAIL") }
    if pre == 2 {
        print("  [not pre-registered]")
    } else {
        if (pre == 1 && pass) || (pre == 0 && !pass) { print("  [prediction hit]") } else { print("  [prediction MISSED]") }
    }
    println("")
    if stat < lo || stat > hi {
        print("  [FAIL] statistic outside the asserted band ["); print(lo); print(", "); print(hi); println("]")
        return 1
    }
    return 0
}

fn ot_prt(tag: string, which: i32) -> i32 with IO, Mut, Div, Panic {
    let pl = olz_pool_of(which)
    print("  "); print(tag); print(": k "); print(pl.k); print("  N "); print(pl.n_tot); print("  n-weighted mean "); print(pl.mean)
    print("  unweighted "); print(pl.mean_unw); print("  sw "); print(pl.sw); print("  SE_w "); print(pl.se_w)
    print("  sb "); print(pl.sb); print("  SE_b "); print(pl.se_b); print("  u "); println(pl.u)
    return 0
}

// One 10 mg oral run of the record with the hepatic clint multiplied by `mult` (scenario) and the
// ps scalar set to `pssc` when positive (diagnostic; clint is then refitted for the new liver ps).
fn ot_run(d: &Circ28Drug, mult: f64, pssc: f64, res: &![f64; 16], gv: i32) with Mut, Div, Panic, Epistemic {
    var th = circ28_drug_theta(d)
    if pssc > 0.0 {
        th[CD_PSSC] = pssc
        th = olz_fit(th, olz_f_abs(), olz_obs_clf(), olz_obs_vssf(), olz_fe(), gv)
    }
    th[CD_CLINT] = th[CD_CLINT] * mult
    olz_run_th(th, 10.0, res, gv)
}

// Closed-form CL/F of the record with the hepatic clint multiplied by `mult`.
fn ot_clf(d: &Circ28Drug, mult: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var th = circ28_drug_theta(d)
    th[CD_CLINT] = th[CD_CLINT] * mult
    return olz_clf_closed(th, 0)
}

fn ot_v(d: &Circ28Drug, i: i32) -> f64 with Mut, Div, Panic, Epistemic { return circ28_drug_value(d, i) }

fn ot_eh(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic { return olz_eh(circ28_drug_theta(d), 0) }
fn ot_fcomplete(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic { return olz_f_if_complete(circ28_drug_theta(d), olz_obs_clf(), 0) }
fn ot_vss(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic { return circ28_vss_plasma(circ28_drug_params(d)) }
fn ot_fm_smoke(d: &Circ28Drug, ratio: f64) -> f64 with Mut, Div, Panic, Epistemic {
    // fm that the smoking ratio alone would give: CL/F ratio R = closed form with clint x (1 + fm (fold - 1));
    // solved by the same closed form as the fluvoxamine fit with AUC ratio 1/R and "residual" = fold.
    return olz_fm_fit(circ28_drug_theta(d), 1.0 / ratio, olz_fold_smoker(), 0)
}

fn ot_sec_pool() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S0 pooled observables (u = max(SE_w, SE_b))")
    fails = fails + ot_prt("CL/F, L/h (fit)", 0)
    fails = fails + ot_prt("V_ss/F, L (fit)", 1)
    fails = fails + ot_prt("Tmax, h (fit)", 2)
    fails = fails + ot_prt("fluvoxamine AUC ratio, non-smokers (fit; unweighted, u = SE_b)", 4)
    fails = fails + ot_prt("NCA terminal t1/2, h (validation, input check)", 3)
    fails = fails + ot_prt("smoker/non-smoker CL/F (validation)", 5)
    fails = fails + ot_rel("pooled CL/F", olz_obs_clf(), 15.7737, 1.0e-4)
    fails = fails + ot_rel("u(CL/F)", olz_u_clf(), 0.2010, 5.0e-3)
    fails = fails + ot_rel("pooled V_ss/F", olz_obs_vssf(), 874.05, 1.0e-4)
    fails = fails + ot_rel("u(V_ss/F)", olz_u_vssf(), 98.38, 1.0e-3)
    fails = fails + ot_rel("pooled Tmax", olz_obs_tmax(), 5.0, 1.0e-9)
    fails = fails + ot_rel("pooled fluvoxamine ratio", olz_obs_flv(), 1.64, 1.0e-9)
    fails = fails + ot_rel("u(fluvoxamine ratio)", olz_u_flv(), 0.12, 1.0e-6)
    print("  residual CYP1A2 activity under fluvoxamine 100 mg/day "); print(olz_flv_resid()); print("  u "); print(olz_u_flv_resid())
    print("  (Ki 0.87 -> "); print(olz_flv_resid_ki(0.8697)); print(", Ki 10 -> "); print(olz_flv_resid_ki(10.0)); println(")")
    println("S1 input consistency BEFORE the structure (lesson 2)")
    let mrt_half = 0.6931471805599453 * olz_obs_vssf() / olz_obs_clf()
    let tz = olz_pool_of(3).mean
    print("  ln2 (V_ss/F) / (CL/F) = "); print(mrt_half); print(" h;  pooled NCA terminal t1/2 = "); print(tz); println(" h")
    println("  the mean-residence half-life is LONGER than the NCA terminal half-life: the popPK volumes (their own")
    println("  terminal t1/2 is 49.8 h for Sun 2021) and the NCA half-lives are inconsistent. Nothing is added to the")
    println("  structure; the terminal half-life is a validation row and comes out long.")
    fails = fails + ot_band("ratio mean-residence / NCA terminal half-life", mrt_half / tz, 1.10, 1.18)
    return fails
}

fn ot_sec_fit(d: &Circ28Drug, b: &[f64; 16], fm: f64, ufm: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S2 fits (closed form) and what they recover")
    var i: i32 = 0
    while i < 18 {
        if (*d).status[i] != 0 {
            print("  slot "); print(i); print("  value "); print(circ28_drug_value(d, i)); print("  u "); print(cd_sqrt(circ28_drug_variance(d, i)))
            print("  status "); println((*d).status[i])
        }
        i = i + 1
    }
    let eh = ot_eh(d)
    fails = fails + ot_rel("closed-form CL/F = pooled CL/F", ot_clf(d, 1.0), olz_obs_clf(), 1.0e-9)
    fails = fails + ot_rel("kernel V_ss = F x pooled V_ss/F", ot_vss(d), olz_f_abs() * olz_obs_vssf(), 1.0e-9)
    fails = fails + ot_rel("kernel run: dose / AUCinf = pooled CL/F (guard: run against closed form)", 10.0 / (*b)[2], olz_obs_clf(), 2.0e-3)
    fails = fails + ot_rel("kernel run: Tmax = pooled Tmax", (*b)[1], olz_obs_tmax(), 5.0e-3)
    fails = fails + ot_band("mass-balance error of the run", (*b)[9], 0.0, 1.0e-9)
    fails = fails + ot_band("P1 Eh", eh, 0.130, 0.141)
    fails = fails + ot_band("P1 CD_FA = F / (1 - Eh) (pre-hepatic availability)", circ28_drug_value(d, CD_FA), 0.68, 0.71)
    fails = fails + ot_band("P2 F if absorption were complete and first pass hepatic only (label: 0.60)", ot_fcomplete(d), 0.79, 0.83)
    fails = fails + ot_band("Kp scalar on Rodgers-Rowland (fitted)", circ28_drug_value(d, CD_KPSC), 7.3, 7.6)
    fails = fails + ot_band("k per stage (ntr 4, tlag 0), 1/h (fitted)", circ28_drug_value(d, CD_KA), 1.0293, 1.0294)
    fails = fails + ot_band("u(k) (guard: the Tmax slope is engine-sensitive on lean_single, see olz_tmax_at)", cd_sqrt(circ28_drug_variance(d, CD_KA)), 0.0769, 0.0772)
    fails = fails + ot_band("fm, CYP1A2 share of the hepatic clint (fitted to fluvoxamine)", fm, 0.44, 0.47)
    fails = fails + ot_band("u(fm)", ufm, 0.045, 0.065)
    return fails
}

fn ot_sec_single(b: &[f64; 16]) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S3 single oral dose, non-smoker (10 mg unless stated)")
    let auc = (*b)[2] * 1000.0
    let cmax = (*b)[0] * 1000.0
    print("  10 mg: Cmax "); print(cmax); print(" ng/mL  Tmax "); print((*b)[1]); print(" h  AUCinf "); print(auc)
    print(" ng h/mL  t1/2 (72-168 h) "); print((*b)[3]); print(" h  t1/2 (240-408 h) "); print((*b)[10]); println(" h")
    fails = fails + ot_row("P3 (c) AUCinf vs Sun 2018 (n 48, inside the CL/F pool)", auc, 632.6, 197.2, 0.0, 1, 0.0 - 0.1, 0.1)
    fails = fails + ot_row("P4a t1/2 vs Sun 2018 34.5 (8.7), n 48", (*b)[3], 34.5, 8.7, 0.0, 1, 1.3, 1.7)
    fails = fails + ot_row("P4b t1/2 vs label mean 30 h, SD from 21-54 h", (*b)[3], 30.0, 10.0, 0.0, 1, 1.55, 1.95)
    fails = fails + ot_row("P4c t1/2 vs Kassahun 1997 27 h (n 6, no SD)", (*b)[3], 27.0, 0.0, 1.5, 0, 1.65, 1.87)
    fails = fails + ot_row("P5a Cmax vs Sun 2018 16.6 (3.8), n 48", cmax, 16.6, 3.8, 0.0, 1, 0.45, 0.60)
    fails = fails + ot_row("P5b Cmax vs PMC3480756 ODT 14.47 (4.25), n 18", cmax, 14.47, 4.25, 0.0, 1, 0.90, 1.05)
    fails = fails + ot_row("P6 Cmax 12.5 mg vs Kassahun 1997 11 ng/mL (n 6, no SD)", 1.25 * cmax, 11.0, 0.0, 1.5, 0, 2.08, 2.14)
    fails = fails + ot_row("P7 (c) Tmax vs label 6 h", (*b)[1], 6.0, 0.0, 1.25, 1, 0.82, 0.85)
    fails = fails + ot_row("P16 accumulation AUCinf/AUC0-24 vs label 'approximately twice'", (*b)[2] / (*b)[4], 2.0, 0.0, 1.5, 1, 1.25, 1.30)
    fails = fails + ot_row("P17 CL/F vs label mean 25 L/h, SD from 12-47", olz_obs_clf(), 25.0, 10.6, 0.0, 1, 0.0 - 0.9, 0.0 - 0.8)
    fails = fails + ot_row("P18 IM/oral AUC at the same dose = 1/F vs label 'similar'", 1.0 / olz_f_abs(), 1.0, 0.0, 1.5, 0, 1.6, 1.7)
    println("  P19 dose linearity 5-40 mg is exact in this linear model (5 mg: Cmax and AUC are half the 10 mg values);")
    println("      no healthy-volunteer 5 mg oral study with numbers was opened. Citrome 2009 C/dose 1.97, 1.90, 1.86 at 10, 20, 40 mg/day.")
    return fails
}

fn ot_sec_ss(b: &[f64; 16], s: &[f64; 16]) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S4 steady state, once daily, per mg/day (superposition of the single-dose curve)")
    let c15 = (*b)[7] * 100.0
    let ctr = (*b)[8] * 100.0
    let s15 = (*s)[7] * 100.0
    print("  non-smoker: C(15 h) "); print(c15); print("  trough "); print(ctr); print("  average "); print((*b)[2] * 100.0 / 24.0)
    print("  peak "); print((*b)[12] * 100.0); println(" ng/mL per mg/day")
    print("  smoker:     C(15 h) "); print(s15); print("  trough "); print((*s)[8] * 100.0); println(" ng/mL per mg/day")
    fails = fails + ot_row("P8a non-smokers 10 mg/day, Citrome 2009 2.56 (1.23)", c15, 2.56, 1.23, 0.0, 1, 0.0 - 0.15, 0.1)
    fails = fails + ot_row("P8b non-smokers 20 mg/day, 2.17 (1.235)", c15, 2.17, 1.235, 0.0, 1, 0.2, 0.4)
    fails = fails + ot_row("P8c non-smokers 40 mg/day, 2.83 (1.10)", c15, 2.83, 1.10, 0.0, 1, 0.0 - 0.4, 0.0 - 0.15)
    fails = fails + ot_row("P9a smokers 10 mg/day, 1.65 (0.96)", s15, 1.65, 0.96, 0.0, 1, 0.1, 0.35)
    fails = fails + ot_row("P9b smokers 20 mg/day, 1.71 (1.04)", s15, 1.71, 1.04, 0.0, 1, 0.05, 0.27)
    fails = fails + ot_row("P9c smokers 40 mg/day, 1.5225 (0.865)", s15, 1.5225, 0.865, 0.0, 1, 0.28, 0.52)
    fails = fails + ot_row("P10a trough vs Skogh 2011 non-smokers 3.32 (n 27, no SD)", ctr, 3.32, 0.0, 1.5, 0, 0.59, 0.65)
    fails = fails + ot_row("P10b trough vs Skogh 2002 non-smokers median 2.87 (no SD)", ctr, 9.2 * 0.31243, 0.0, 1.5, 1, 0.68, 0.74)
    return fails
}

fn ot_sec_scen(d: &Circ28Drug, b: &[f64; 16], s: &[f64; 16], f: &[f64; 16], sf: &[f64; 16], fm: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S5 CYP1A2 scenarios: HEPATIC FACTOR ONLY (multipliers of the hepatic clint)")
    let rs = (*b)[2] / (*s)[2]
    let rf = (*f)[2] / (*b)[2]
    let rsf = (*sf)[2] / (*s)[2]
    print("  multipliers: smoker "); print(olz_scenario_mult(fm, 1)); print("  fluvoxamine "); print(olz_scenario_mult(fm, 2))
    print("  smoker + fluvoxamine "); println(olz_scenario_mult(fm, 3))
    println("S5a fit recovery and guards")
    fails = fails + ot_rel("fluvoxamine AUC ratio of the runs = pooled ratio (fitted)", rf, olz_obs_flv(), 2.0e-3)
    fails = fails + ot_rel("smoker CL/F ratio: runs against closed form", rs, ot_clf(d, olz_scenario_mult(fm, 1)) / ot_clf(d, 1.0), 2.0e-3)
    println("S5b validation")
    fails = fails + ot_row("P11 fm vs in vitro CYP1A2 fraction 23.67/57.93 (Sun 2020)", fm, 23.67 / 57.93, 0.0, 1.25, 1, 1.08, 1.16)
    let ps = olz_pool_of(5)
    fails = fails + ot_row("P12 smoker/non-smoker CL/F vs pool of 11 studies (z on the pool u)", rs, ps.mean, ps.u, 0.0, 1, 0.0 - 0.7, 0.0 - 0.5)
    fails = fails + ot_row("P12b (c: Sun 2021 is in the CL/F pool) same vs Sun 2021 popPK 1.30 (CI 1.21-1.39), SD of the estimate 0.046", rs, 1.30, 0.046, 0.0, 1, 0.3, 1.0)
    fails = fails + ot_row("P12c same vs label 'about 40 % higher'", rs, 1.40, 0.0, 1.25, 1, 0.92, 0.98)
    fails = fails + ot_row("P12d same vs Tsuda 2014 meta-analysis 10/7 (secondary; its studies are in the pool)", rs, 10.0 / 7.0, 0.0, 1.25, 1, 0.90, 0.96)
    fails = fails + ot_row("P13a fluvoxamine AUC ratio in smokers vs label male smokers 2.08", rsf, 2.08, 0.0, 1.25, 1, 0.99, 1.06)
    fails = fails + ot_row("P13b same vs Chiu 2004 at 100 mg/day 1.55 (n 10 smokers)", rsf, 1.55, 0.0, 1.5, 1, 1.32, 1.42)
    fails = fails + ot_row("P13c (not pre-registered) fluvoxamine Cmax ratio in smokers vs label 1.77", (*sf)[0] / (*s)[0], 1.77, 0.0, 1.5, 2, 0.65, 0.72)
    fails = fails + ot_row("P13d (not pre-registered) fluvoxamine Cmax ratio, non-smokers, vs label 1.54 and Wang 1.49 (mean 1.515)", (*f)[0] / (*b)[0], 1.515, 0.0, 1.5, 2, 0.70, 0.78)
    fails = fails + ot_row("P13e (not pre-registered) fluvoxamine t1/2 ratio, non-smokers, vs Wang 2004 1.40", (*f)[3] / (*b)[3], 1.40, 0.0, 1.5, 2, 0.97, 1.07)
    fails = fails + ot_row("P14a steady-state ratio (non-smoker value) vs Hiemke 2002 1.81 (n 8)", rf, 56.0 / 31.0, 0.0, 1.5, 1, 0.88, 0.94)
    fails = fails + ot_row("P14b same vs Weigmann 2001 2.3 (n 10)", rf, 2.3, 0.0, 1.5, 1, 0.69, 0.74)
    fails = fails + ot_row("P14c same vs Gex-Fabry 2003 1.74", rf, 1.74, 0.0, 1.5, 1, 0.91, 0.97)
    println("S5c carbamazepine WHAT-IF: CYP1A2 fold BORROWED from smoking (no sourced fold; UGT1A4 induction not modelled)")
    fails = fails + ot_row("P15a CL/F ratio vs label 'approximately 50 % increase'", rs, 1.5, 0.0, 1.25, 1, 0.86, 0.91)
    fails = fails + ot_row("P15b same vs Haslemo 2012 C/D -50 % (n 8)", rs, 2.0, 0.0, 1.5, 0, 0.64, 0.69)
    fails = fails + ot_row("P15c same vs Gex-Fabry 2003 inducers -40 %", rs, 1.0 / 0.6, 0.0, 1.5, 1, 0.77, 0.82)
    print("      CYP1A2 fold that the label's +50 % would need with this fm: "); println(1.0 + 0.5 / fm)
    println("S5d diagnostic: had fm been fitted to the pooled SMOKING ratio instead (not used)")
    let fms = ot_fm_smoke(d, ps.mean)
    let fms_hi = ot_fm_smoke(d, ps.mean + ps.u)
    let fms_lo = ot_fm_smoke(d, ps.mean - ps.u)
    print("  fm = "); print(fms); print("  (pool mean +/- u: "); print(fms_lo); print(" .. "); print(fms_hi); println(")")
    print("  fluvoxamine CL/F ratio it would predict in non-smokers: "); print(ot_clf(d, 1.0) / ot_clf(d, 1.0 - fms * (1.0 - olz_flv_resid())))
    println("  (observed 1.52-1.76)")
    fails = fails + ot_band("fm from the smoking ratio", fms, 0.70, 0.77)
    println("  P22 sex: not predicted (ICRP man). Observed CL/F women vs men: x0.862 (Sun 2021), -30 % (label), men +38 % (Bigos 2008).")
    print("      CYP1A2 activity factor that -14 % and -30 % would need with this fm: "); print(1.0 - 0.138 / fm); print(" and "); println(1.0 - 0.30 / fm)
    return fails
}

fn ot_sec_bud(bu: &OlzBudget, b: &[f64; 16]) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S6 uncertainty budget, 10 mg oral and steady-state trough, refit at every perturbation")
    print("  kernel runs "); println((*bu).runs)
    let ua = cd_sqrt((*bu).vv[0])
    let uc = cd_sqrt((*bu).vv[1])
    let ut = cd_sqrt((*bu).vv[2])
    print("  AUCinf "); print((*bu).y[0] * 1000.0); print(" ng h/mL  u "); print(ua * 1000.0); print("  rel "); println(ua / (*bu).y[0])
    print("  Cmax   "); print((*bu).y[1] * 1000.0); print(" ng/mL  u "); print(uc * 1000.0); print("  rel "); println(uc / (*bu).y[1])
    print("  trough "); print((*bu).y[2] * 1000.0); print(" ng/mL per mg/day  u "); print(ut * 1000.0); print("  rel "); println(ut / (*bu).y[2])
    println("  input      u(input)     share of var(AUC) %   var(Cmax) %   var(trough) %")
    var i: i32 = 0
    while i < 10 {
        print("  "); print(olz_input_name(i)); print("  "); print((*bu).u_in[i]); print("   "); print(100.0 * (*bu).share[3 * i] / (*bu).vv[0])
        print("   "); print(100.0 * (*bu).share[3 * i + 1] / (*bu).vv[1]); print("   "); println(100.0 * (*bu).share[3 * i + 2] / (*bu).vv[2])
        i = i + 1
    }
    fails = fails + ot_rel("budget AUC = direct run (guard)", (*bu).y[0], (*b)[2], 1.0e-3)
    fails = fails + ot_rel("budget Cmax = direct run (guard)", (*bu).y[1], (*b)[0], 2.0e-3)
    fails = fails + ot_rel("budget trough = direct run (guard)", (*bu).y[2], (*b)[8] / 10.0, 2.0e-3)
    fails = fails + ot_band("P21 relative u(AUC)", ua / (*bu).y[0], 0.011, 0.014)
    fails = fails + ot_band("relative u(trough)", ut / (*bu).y[2], 0.04, 0.055)
    fails = fails + ot_band("P20 share of F in var(AUC), %", 100.0 * (*bu).share[12] / (*bu).vv[0], 0.0, 0.01)
    fails = fails + ot_band("P20 share of F in var(trough), %", 100.0 * (*bu).share[14] / (*bu).vv[2], 5.0, 8.0)
    println("  This u is that of the population-typical value. Between subjects the CV of CL/F is 43 % (Sun 2021).")
    return fails
}

fn ot_sec_ps(b: &[f64; 16], lo: &[f64; 16], hi: &[f64; 16]) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S7 diagnostic: tissue permeability scalar (default 1 = 20 x flow, a placeholder; nothing fitted)")
    print("  ps x 0.3: Cmax "); print((*lo)[0] * 1000.0); print("  Tmax "); print((*lo)[1]); print("  t1/2 (72-168) "); print((*lo)[3]); print("  trough "); println((*lo)[8] * 100.0)
    print("  ps x 1  : Cmax "); print((*b)[0] * 1000.0); print("  Tmax "); print((*b)[1]); print("  t1/2 (72-168) "); print((*b)[3]); print("  trough "); println((*b)[8] * 100.0)
    print("  ps x 3  : Cmax "); print((*hi)[0] * 1000.0); print("  Tmax "); print((*hi)[1]); print("  t1/2 (72-168) "); print((*hi)[3]); print("  trough "); println((*hi)[8] * 100.0)
    fails = fails + ot_band("t1/2 ratio ps x 0.3 / ps x 1", (*lo)[3] / (*b)[3], 1.0, 1.03)
    fails = fails + ot_band("Cmax ratio ps x 0.3 / ps x 1", (*lo)[0] / (*b)[0], 1.0, 1.05)
    return fails
}


// Pre-registered range of the transit round: printed HIT or MISSED, never asserted (the asserted bands are the
// measured ones, set after the run).
fn ot_pre(tag: string, v: f64, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    print("  "); print(tag); print(" = "); print(v); print("  pre-registered ["); print(lo); print(", "); print(hi); print("]  ")
    if v >= lo && v <= hi { println("[R hit]") } else { println("[R MISSED]") }
    return 0
}

fn ot_sec_round(kk: f64, tl: f64, b: &[f64; 16], s: &[f64; 16], f: &[f64; 16], sf: &[f64; 16]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("SR transit round: pre-registered rows R1-R9 against the first-round values (Cmax 13.2, trough 2.05, C15 2.53 / 1.87, fluvoxamine Cmax 1.12 / 1.21)")
    let cmax = (*b)[0] * 1000.0
    let auc = (*b)[2] * 1000.0
    print("  COLUMN B (chain + Li lag, the first-round adoption). stages ntr "); print(olz_ntr()); print(", tlag "); print(tl); print(" h (Li 2018 ALAG1, confirmed in the full text), k "); println(kk)
    print("  mean transit time ntr / k = "); print(circ28_transit_mtt(kk, olz_ntr())); print(" h; first-order equivalent 1/ka = 4.53 h (first round, ka 0.2205, lag 0.5)")
    println("")
    fails = fails + ot_pre("R1 k per stage, 1/h", kk, 0.85, 1.35)
    fails = fails + ot_pre("R2 AUCinf / 634 (first round)", auc / 634.0, 0.995, 1.005)
    fails = fails + ot_pre("R2 t1/2 (72-168 h) / 47.5 (first round)", (*b)[3] / 47.5, 0.995, 1.005)
    fails = fails + ot_pre("R3 Cmax 10 mg, ng/mL", cmax, 14.8, 17.2)
    fails = fails + ot_pre("R4 Cmax 12.5 mg fold against Kassahun 11", 1.25 * cmax / 11.0, 1.68, 1.95)
    fails = fails + ot_pre("R5 Cmax/AUC, 1/h", cmax / auc, 0.0234, 0.027)
    fails = fails + ot_pre("R6 C(15 h) non-smoker / 2.53", (*b)[7] * 100.0 / 2.53, 0.95, 1.05)
    fails = fails + ot_pre("R6 C(15 h) smoker / 1.87", (*s)[7] * 100.0 / 1.87, 0.95, 1.05)
    fails = fails + ot_pre("R6 trough / 2.05", (*b)[8] * 100.0 / 2.05, 0.98, 1.02)
    fails = fails + ot_pre("R6 accumulation", (*b)[2] / (*b)[4], 2.45, 2.60)
    fails = fails + ot_pre("R7 fluvoxamine Cmax ratio non-smoker", (*f)[0] / (*b)[0], 1.10, 1.18)
    fails = fails + ot_pre("R7 fluvoxamine Cmax ratio smoker", (*sf)[0] / (*s)[0], 1.19, 1.26)
    fails = fails + ot_pre("R9 Tmax, h", (*b)[1], 4.99, 5.01)
    fails = fails + ot_band("measured (column B): Cmax rise over the first round (20.6 / 13.2)", cmax / 13.2, 1.5, 1.62)
    fails = fails + ot_band("measured: trough change over the first round", (*b)[8] * 100.0 / 2.05, 0.95, 0.99)
    fails = fails + ot_band("measured: C(15 h) change non-smoker", (*b)[7] * 100.0 / 2.53, 0.95, 1.0)
    return fails
}

// Four runs (non-smoker, smoker, fluvoxamine, smoker + fluvoxamine; 10 mg) of the record with its own tlag, k and stage count.
fn ot_col4(d: &Circ28Drug, fm: f64, tlag: f64, ka: f64, ntr: i32, b: &![f64; 16], s: &![f64; 16], f: &![f64; 16], sf: &![f64; 16]) -> i32 with Mut, Div, Panic, Epistemic {
    var th = circ28_drug_theta(d)
    th[CD_TLAG] = tlag
    th[CD_KA] = ka
    let c0 = th[CD_CLINT]
    th[CD_CLINT] = c0
    olz_run_th_n(th, 10.0, b, 0, ntr)
    th[CD_CLINT] = c0 * olz_scenario_mult(fm, 1)
    olz_run_th_n(th, 10.0, s, 0, ntr)
    th[CD_CLINT] = c0 * olz_scenario_mult(fm, 2)
    olz_run_th_n(th, 10.0, f, 0, ntr)
    th[CD_CLINT] = c0 * olz_scenario_mult(fm, 3)
    olz_run_th_n(th, 10.0, sf, 0, ntr)
    return 0
}

// Three columns: A first order + Sun lag 0.5 (round 1), B chain + Li lag 0.877, C chain without lag (adopted; the
// record). rc* are the runs of the record (column C) already made by the caller.
fn ot_sec_cols(d: &Circ28Drug, fm: f64, rc: &[f64; 16], rcs: &[f64; 16], rcf: &[f64; 16], rcsf: &[f64; 16]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var ra: [f64; 16] = [0.0; 16]
    var ras: [f64; 16] = [0.0; 16]
    var raf: [f64; 16] = [0.0; 16]
    var rasf: [f64; 16] = [0.0; 16]
    var rb: [f64; 16] = [0.0; 16]
    var rbs: [f64; 16] = [0.0; 16]
    var rbf: [f64; 16] = [0.0; 16]
    var rbsf: [f64; 16] = [0.0; 16]
    ot_col4(d, fm, olz_tlag_sun(), olz_ka_first_order(), 1, &!ra, &!ras, &!raf, &!rasf)
    ot_col4(d, fm, olz_tlag_li(), olz_k_chain_lag(), olz_ntr(), &!rb, &!rbs, &!rbf, &!rbsf)
    println("SC three columns: A first order + lag 0.5 (round 1) | B chain + lag 0.877 | C chain, tlag 0 (ADOPTED); each k refitted to Tmax 5.0 h")
    print("  k per stage / ka: "); print(olz_ka_first_order()); print(" | "); print(olz_k_chain_lag()); print(" | "); println(olz_ka_fit(0))
    print("  mean transit time (A: 1/ka + lag): "); print(1.0 / olz_ka_first_order() + olz_tlag_sun()); print(" | "); print(olz_tlag_li() + circ28_transit_mtt(olz_k_chain_lag(), olz_ntr())); print(" | "); println(circ28_transit_mtt(olz_ka_fit(0), olz_ntr()))
    print("  Tmax h:                     "); print(ra[1]); print(" | "); print(rb[1]); print(" | "); println((*rc)[1])
    print("  Cmax 10 mg ng/mL:           "); print(ra[0] * 1000.0); print(" | "); print(rb[0] * 1000.0); print(" | "); println((*rc)[0] * 1000.0)
    print("  Cmax/AUC 1/h:               "); print(ra[0] / ra[2]); print(" | "); print(rb[0] / rb[2]); print(" | "); println((*rc)[0] / (*rc)[2])
    print("  P5a z vs 16.6 (3.8):        "); print((ra[0] * 1000.0 - 16.6) / 3.8); print(" | "); print((rb[0] * 1000.0 - 16.6) / 3.8); print(" | "); println(((*rc)[0] * 1000.0 - 16.6) / 3.8)
    print("  P5b z vs 14.47 (4.25):      "); print((ra[0] * 1000.0 - 14.47) / 4.25); print(" | "); print((rb[0] * 1000.0 - 14.47) / 4.25); print(" | "); println(((*rc)[0] * 1000.0 - 14.47) / 4.25)
    print("  P6 12.5 mg fold vs 11:      "); print(1.25 * ra[0] * 1000.0 / 11.0); print(" | "); print(1.25 * rb[0] * 1000.0 / 11.0); print(" | "); println(1.25 * (*rc)[0] * 1000.0 / 11.0)
    print("  fluvoxamine Cmax non-smoker (obs 1.515): "); print(raf[0] / ra[0]); print(" | "); print(rbf[0] / rb[0]); print(" | "); println((*rcf)[0] / (*rc)[0])
    print("  fluvoxamine Cmax smoker (obs 1.77):      "); print(rasf[0] / ras[0]); print(" | "); print(rbsf[0] / rbs[0]); print(" | "); println((*rcsf)[0] / (*rcs)[0])
    print("  smoker fluvoxamine fold vs 1.77 (PASS needs >= 0.667): "); print(rasf[0] / ras[0] / 1.77); print(" | "); print(rbsf[0] / rbs[0] / 1.77); print(" | "); println((*rcsf)[0] / (*rcs)[0] / 1.77)
    print("  C(15 h) per mg/day non-smoker / smoker: "); print(ra[7] * 100.0); print("/"); print(ras[7] * 100.0); print(" | "); print(rb[7] * 100.0); print("/"); print(rbs[7] * 100.0)
    print(" | "); print((*rc)[7] * 100.0); print("/"); println((*rcs)[7] * 100.0)
    print("  trough: "); print(ra[8] * 100.0); print(" | "); print(rb[8] * 100.0); print(" | "); println((*rc)[8] * 100.0)
    print("  accumulation: "); print(ra[2] / ra[4]); print(" | "); print(rb[2] / rb[4]); print(" | "); println((*rc)[2] / (*rc)[4])
    print("  AUCinf ng h/mL: "); print(ra[2] * 1000.0); print(" | "); print(rb[2] * 1000.0); print(" | "); print((*rc)[2] * 1000.0); print("   t1/2 h: "); print(ra[3]); print(" | "); print(rb[3]); print(" | "); println((*rc)[3])
    // column B: the first-round chain results, pre-registered rows R1-R9
    fails = fails + ot_sec_round(olz_k_chain_lag(), olz_tlag_li(), &rb, &rbs, &rbf, &rbsf)
    // guards: column A reproduces round 1 (Cmax 13.2 ng/mL, C15 2.53 / 1.87, trough 2.05); column C is the record's own run
    fails = fails + ot_band("guard A: Cmax 10 mg reproduces round 1 (13.2)", ra[0] * 1000.0, 13.1, 13.3)
    fails = fails + ot_band("guard A: C(15 h) non-smoker (round 1 2.53)", ra[7] * 100.0, 2.52, 2.54)
    fails = fails + ot_band("guard A: trough (round 1 2.05)", ra[8] * 100.0, 2.04, 2.06)
    fails = fails + ot_band("guard A: Tmax", ra[1], 4.995, 5.005)
    fails = fails + ot_band("guard B: Tmax", rb[1], 4.995, 5.005)
    fails = fails + ot_band("guard C: Tmax", (*rc)[1], 4.995, 5.005)
    fails = fails + ot_rel("guard: AUC A = C", ra[2], (*rc)[2], 1.0e-4)
    fails = fails + ot_rel("guard: AUC B = C", rb[2], (*rc)[2], 1.0e-4)
    // pre-registered rows C1-C5 (hit or missed) for column C
    println("  second pre-registration, column C (hit or missed, not asserted)")
    fails = fails + ot_pre("C1 k per stage, 1/h", olz_ka_fit(0), 0.85, 1.10)
    fails = fails + ot_pre("C2 Cmax 10 mg, ng/mL", (*rc)[0] * 1000.0, 15.5, 19.5)
    fails = fails + ot_pre("C2 Cmax/AUC, 1/h", (*rc)[0] / (*rc)[2], 0.0245, 0.031)
    fails = fails + ot_pre("C3 12.5 mg fold vs 11", 1.25 * (*rc)[0] * 1000.0 / 11.0, 1.76, 2.22)
    fails = fails + ot_pre("C4 fluvoxamine Cmax non-smoker", (*rcf)[0] / (*rc)[0], 1.09, 1.13)
    fails = fails + ot_pre("C4 fluvoxamine Cmax smoker", (*rcsf)[0] / (*rcs)[0], 1.17, 1.21)
    fails = fails + ot_pre("C5 accumulation", (*rc)[2] / (*rc)[4], 2.45, 2.62)
    fails = fails + ot_pre("C5 C(15 h) non-smoker / B", (*rc)[7] / rb[7], 0.95, 1.05)
    fails = fails + ot_pre("C5 trough", (*rc)[8] * 100.0, 1.97, 2.05)
    // measured bands of column C
    fails = fails + ot_band("measured C: Cmax 10 mg", (*rc)[0] * 1000.0, 18.4, 18.8)
    fails = fails + ot_band("measured C: 12.5 mg fold", 1.25 * (*rc)[0] * 1000.0 / 11.0, 2.08, 2.14)
    fails = fails + ot_band("measured C: smoker fluvoxamine Cmax fold vs 1.77", (*rcsf)[0] / (*rcs)[0] / 1.77, 0.668, 0.678)
    fails = fails + ot_band("measured B: smoker fluvoxamine Cmax fold vs 1.77 (FAIL below 0.6667)", rbsf[0] / rbs[0] / 1.77, 0.660, 0.667)
    println("  DECISION (rule of the coordinator): C is adopted. Relative to round 1 (A) it worsens the 12.5 mg Cmax row (fold 1.50 -> 2.11,")
    println("  beyond its 1.5-fold tolerance: a validation row worsened beyond its stated uncertainty) and the Cmax rows move from z -0.89 to +0.52")
    println("  (Sun 2018) and from -0.30 to +0.97 (PMC3480756): still PASS. The smoker fluvoxamine Cmax ratio stays PASS (fold 0.672; B failed at")
    println("  0.666), the non-smoker one stays PASS. Both chain columns worsen the 12.5 mg row; C is kept as the DECLARED structure (user")
    println("  decision: transit for every oral drug) and the worsened row is asserted as measured. C is better than B on every peak row.")
    return fails
}

// The gut-unscaled variant (gv 1): its own record (V_ss scalar, ka refitted to the same Tmax), the same runs, a
// column next to the all-organ column. DECISION RULE (brief): adopt only if the failing peak rows improve and no
// other row worsens by more than its stated uncertainty. u(Cmax) of the all-organ column is the yardstick.
fn ot_sec_alt(pk: &[f64; 80]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var d1 = circ28_drug_new()
    olz_drug_into_v(&!d1, 1)
    let fm1 = olz_fm(&d1, 1)
    let kp1 = ot_v(&d1, CD_KPSC)
    let k1 = ot_v(&d1, CD_KA)
    var ba: [f64; 16] = [0.0; 16]
    var sa: [f64; 16] = [0.0; 16]
    var fa: [f64; 16] = [0.0; 16]
    var sfa: [f64; 16] = [0.0; 16]
    var q: i32 = 0
    while q < 16 {
        ba[q] = (*pk)[q]
        sa[q] = (*pk)[16 + q]
        fa[q] = (*pk)[32 + q]
        sfa[q] = (*pk)[48 + q]
        q = q + 1
    }
    let k0 = (*pk)[64]
    let kp0 = (*pk)[65]
    let ucmax_rel = (*pk)[66]
    var b1: [f64; 16] = [0.0; 16]
    var s1: [f64; 16] = [0.0; 16]
    var f1: [f64; 16] = [0.0; 16]
    var sf1: [f64; 16] = [0.0; 16]
    let none = 0.0 - 1.0
    ot_run(&d1, 1.0, none, &!b1, 1)
    ot_run(&d1, olz_scenario_mult(fm1, 1), none, &!s1, 1)
    ot_run(&d1, olz_scenario_mult(fm1, 2), none, &!f1, 1)
    ot_run(&d1, olz_scenario_mult(fm1, 3), none, &!sf1, 1)
    println("SG gut-wall variant: organ 8 at its Rodgers-Rowland Kp, V_ss scalar refitted (column gut / column all-organ)")
    print("  V_ss scalar "); print(kp1); print(" / "); print(kp0); print("  (change "); print(kp1 / kp0 - 1.0); println(")")
    print("  k per stage "); print(k1); print(" / "); print(k0); print("  (change "); print(k1 / k0 - 1.0); println(")")
    print("  fm "); print(fm1); println(" (all-organ 0.4568)")
    print("  Cmax 10 mg "); print(b1[0] * 1000.0); print(" / "); print(ba[0] * 1000.0); print("  Tmax "); print(b1[1]); print(" / "); println(ba[1])
    print("  AUCinf "); print(b1[2] * 1000.0); print(" / "); print(ba[2] * 1000.0); print("  t1/2 "); print(b1[3]); print(" / "); println(ba[3])
    print("  Cmax 12.5 mg fold vs 11: "); print(1.25 * b1[0] * 1000.0 / 11.0); print(" / "); println(1.25 * ba[0] * 1000.0 / 11.0)
    print("  C(15 h) per mg/day non-smoker "); print(b1[7] * 100.0); print(" / "); print(ba[7] * 100.0); print("  smoker "); print(s1[7] * 100.0); print(" / "); println(sa[7] * 100.0)
    print("  trough "); print(b1[8] * 100.0); print(" / "); println(ba[8] * 100.0)
    print("  fluvoxamine Cmax ratio non-smoker "); print(f1[0] / b1[0]); print(" / "); print(fa[0] / ba[0])
    print("  smoker "); print(sf1[0] / s1[0]); print(" / "); println(sfa[0] / sa[0])
    print("  fluvoxamine AUC ratio non-smoker "); print(f1[2] / b1[2]); print(" / "); println(fa[2] / ba[2])
    print("  smoker/non-smoker AUC ratio "); print(b1[2] / s1[2]); print(" / "); println(ba[2] / sa[2])
    let dcmax = b1[0] / ba[0] - 1.0
    print("  Cmax change "); print(dcmax); print(" against u(Cmax) of the all-organ column "); println(ucmax_rel)
    fails = fails + ot_pre("R8 V_ss scalar change", kp1 / kp0 - 1.0, 0.005, 0.04)
    fails = fails + ot_pre("R8 |k change| under 6 %", ot_abs(k1 / k0 - 1.0), 0.0, 0.06)
    fails = fails + ot_pre("R8 |Cmax change| under 3 %", ot_abs(dcmax), 0.0, 0.03)
    fails = fails + ot_rel("gut variant: dose / AUCinf = pooled CL/F (guard)", 10.0 / b1[2], olz_obs_clf(), 2.0e-3)
    fails = fails + ot_rel("gut variant: Tmax = pooled Tmax (guard)", b1[1], olz_obs_tmax(), 5.0e-3)
    fails = fails + ot_band("gut variant: V_ss scalar", kp1, 7.5, 7.7)
    fails = fails + ot_band("gut variant: k per stage", k1, 0.938, 0.939)
    fails = fails + ot_band("gut variant: Cmax change", dcmax, 0.0 - 0.025, 0.0 - 0.012)
    fails = fails + ot_band("gut variant: AUC change", b1[2] / ba[2] - 1.0, 0.0 - 1.0e-4, 1.0e-4)
    fails = fails + ot_band("gut variant: t1/2 change", b1[3] / ba[3] - 1.0, 0.005, 0.015)
    fails = fails + ot_band("gut variant: trough change", b1[8] / ba[8] - 1.0, 0.0 - 0.01, 0.0)
    println("  DECISION: gut-unscaled variant NOT adopted. Its only change that bears on a failing peak row is a Cmax lower by")
    println("  about 1.7 % (the 12.5 mg fold 2.11 -> 2.08, still FAIL), far inside u(Cmax) of 14 %; the terminal half-life moves 0.9 %")
    println("  the wrong way. The gut wall is a small share of V_ss for this drug (no depot), unlike tacrolimus.")
    return fails
}

fn ot_gv0(pk: &![f64; 80]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var d = circ28_drug_new()
    olz_drug_into_v(&!d, 0)
    let kfit = ot_v(&d, CD_KA)
    let kpfit = ot_v(&d, CD_KPSC)
    let fm = olz_fm(&d, 0)
    let ufm = olz_u_fm(&d, 0)
    var rb: [f64; 16] = [0.0; 16]
    var rs: [f64; 16] = [0.0; 16]
    var rf: [f64; 16] = [0.0; 16]
    var rsf: [f64; 16] = [0.0; 16]
    var rlo: [f64; 16] = [0.0; 16]
    var rhi: [f64; 16] = [0.0; 16]
    let none = 0.0 - 1.0
    ot_run(&d, 1.0, none, &!rb, 0)
    ot_run(&d, olz_scenario_mult(fm, 1), none, &!rs, 0)
    ot_run(&d, olz_scenario_mult(fm, 2), none, &!rf, 0)
    ot_run(&d, olz_scenario_mult(fm, 3), none, &!rsf, 0)
    ot_run(&d, 1.0, 0.3, &!rlo, 0)
    ot_run(&d, 1.0, 3.0, &!rhi, 0)
    let bu = olz_budget(&d, 0)
    fails = fails + ot_sec_pool()
    fails = fails + ot_sec_fit(&d, &rb, fm, ufm)
    fails = fails + ot_sec_single(&rb)
    fails = fails + ot_sec_ss(&rb, &rs)
    fails = fails + ot_sec_scen(&d, &rb, &rs, &rf, &rsf, fm)
    fails = fails + ot_sec_bud(&bu, &rb)
    fails = fails + ot_sec_ps(&rb, &rlo, &rhi)
    fails = fails + ot_sec_cols(&d, fm, &rb, &rs, &rf, &rsf)
    var q: i32 = 0
    while q < 16 {
        (*pk)[q] = rb[q]
        (*pk)[16 + q] = rs[q]
        (*pk)[32 + q] = rf[q]
        (*pk)[48 + q] = rsf[q]
        q = q + 1
    }
    (*pk)[64] = kfit
    (*pk)[65] = kpfit
    (*pk)[66] = cd_sqrt(bu.vv[1]) / bu.y[1]
    return fails
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var pk: [f64; 80] = [0.0; 80]
    var fails: i32 = ot_gv0(&!pk)
    fails = fails + ot_sec_alt(&pk)
    if fails == 0 {
        println("CIRC28_DRUG_OLANZAPINE_PASS")
        return 0
    }
    println("CIRC28_DRUG_OLANZAPINE_FAIL")
    return 1
}
