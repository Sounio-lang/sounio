//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 point time-slab containment seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1621
    fp = mix(fp, 301347724, 5519)
    fp = mix(fp, 777254975, 5519)
    fp = mix(fp, 1, 5519)
    fp = mix(fp, 256, 5519)
    fp = mix(fp, 32, 5519)
    fp = mix(fp, 1, 5519)
    fp = mix(fp, 100, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 111669149696, 5519)
    fp = mix(fp, 7158278826, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 1116691497, 5519)
    fp = mix(fp, 71582789, 5519)
    fp = mix(fp, 1, 5519)
    fp = mix(fp, 1116691600, 5519)
    fp = mix(fp, 71582900, 5519)
    fp = mix(fp, 1, 5519)
    fp = mix(fp, 103, 5519)
    fp = mix(fp, 111, 5519)
    fp = mix(fp, 3, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 15, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 23, 5519)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 835733741 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1627
    fp = mix(fp, instance, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 111669149696, 5521)
    fp = mix(fp, 7158278826, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 1116691497, 5521)
    fp = mix(fp, 71582789, 5521)
    fp = mix(fp, 1, 5521)
    fp = mix(fp, 103, 5521)
    fp = mix(fp, 111, 5521)
    fp = mix(fp, 3, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 15, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 23, 5521)
    fp = mix(fp, ok_mask, 5521)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 835733741 { return 0 - 1 }
    if certificate != 776601529 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1637
    fp = mix(fp, instance, 5527)
    fp = mix(fp, certificate, 5527)
    fp = mix(fp, 19, 5527)
    fp = mix(fp, 1, 5527)
    fp = mix(fp, 7, 5527)
    fp = mix(fp, 15, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 23, 5527)
    fp = mix(fp, ok_mask, 5527)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    if artifact != 44353214 { return 0 - 1 }
    if instance != 835733741 { return 0 - 1 }
    if certificate != 776601529 { return 0 - 1 }

    var fp: i64 = 1657
    fp = mix(fp, artifact, 5531)
    fp = mix(fp, instance, 5531)
    fp = mix(fp, certificate, 5531)
    fp = mix(fp, 301347724, 5531)
    fp = mix(fp, 777254975, 5531)
    fp = mix(fp, 0, 5531)
    fp = mix(fp, 111669149696, 5531)
    fp = mix(fp, 7158278826, 5531)
    fp = mix(fp, 0, 5531)
    fp = mix(fp, 1116691497, 5531)
    fp = mix(fp, 71582789, 5531)
    fp = mix(fp, 1, 5531)
    fp = mix(fp, 1116691600, 5531)
    fp = mix(fp, 71582900, 5531)
    fp = mix(fp, 1, 5531)
    fp = mix(fp, 23, 5531)
    fp = mix(fp, 255, 5531)
    return fp
}

fn main() -> i64 {
    var derivative_mask: i64 = 0
    let dx_bound: i64 = 0
    let dy_bound: i64 = 115964116992 - 4294967296
    let dz_bound: i64 = 11453246122 - 4294967296
    if dx_bound == 0 {
        derivative_mask = derivative_mask + 1
    }
    if dy_bound == 111669149696 {
        derivative_mask = derivative_mask + 2
    }
    if dz_bound == 7158278826 {
        derivative_mask = derivative_mask + 4
    }
    if derivative_mask != 7 { return 1 }

    if 0 * 100 < dx_bound { return 2 }
    if 1116691497 * 100 < dy_bound { return 3 }
    if 71582789 * 100 < dz_bound { return 4 }
    let instance = instance_fp()
    if instance != 835733741 { return 5 }
    let certificate = certificate_fp(instance, 255)
    if certificate != 776601529 { return 6 }
    let artifact = artifact_fp(instance, certificate, 255)
    if artifact != 44353214 { return 7 }
    if audit_fp(artifact, instance, certificate) != 431845922 { return 8 }
    return 0
}
