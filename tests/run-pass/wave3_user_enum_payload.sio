//@ run-pass
//@ requires: madaros
//@ expect-stdout: USER_ENUM_PAYLOAD_OK
enum WaveLabel { Empty, Name(string), Count(i64), Ratio(f64), Pair(i64,i64), Unit(()) }
enum WaveNested { Empty, Keep(WaveLabel) }
fn label_text(x:&WaveLabel)->string {
    match x {WaveLabel::Name(text)=>text,_=>""}
}
fn label_number(x:&WaveLabel)->i64 {
    match x {
        WaveLabel::Count(n)=>n,
        WaveLabel::Pair(a,b)=>a+b,
        WaveLabel::Ratio(r)=>if r==1.25 {25} else {-1},
        WaveLabel::Unit(u)=>{let ignored:()=u;1},
        WaveLabel::Empty=>0,
        _=>-2,
    }
}
fn is_count_zero(x:&WaveLabel)->bool {match x {WaveLabel::Count(n)=>n==0,_=>false}}
fn make_label()->WaveLabel with Alloc,Mut {WaveLabel::Name("flag")}
fn make_nested()->WaveNested with Alloc,Mut {WaveNested::Keep(WaveLabel::Count(42))}
fn nested_read(x:WaveNested)->i64 {
    match x {
        WaveNested::Keep(WaveLabel::Count(n))=>n,
        WaveNested::Keep(_)=>-1,
        WaveNested::Empty=>0,
    }
}
fn main()->i32 with IO,Alloc,Mut,Panic,Div {
    let empty=WaveLabel::Empty
    let zero=WaveLabel::Count(0)
    let text=make_label()
    let ratio=WaveLabel::Ratio(1.25)
    let pair=WaveLabel::Pair(7,11)
    let unit=WaveLabel::Unit(())
    if label_number(&empty)!=0 || label_number(&zero)!=0 {return 1}
    if label_text(&text)!="flag" || is_count_zero(&empty) || !is_count_zero(&zero) {return 2}
    if label_number(&ratio)!=25 || label_number(&pair)!=7+11 || label_number(&unit)!=1 {return 3}
    let nested=make_nested()
    var i:i64=0
    while i<100 {let churn=WaveLabel::Count(i);if label_number(&churn)!=i {return 4};i=i+1}
    if label_text(&text)!="flag" || nested_read(nested)!=42 {return 5}
    if nested_read(WaveNested::Empty)!=0 {return 6}
    println("USER_ENUM_PAYLOAD_OK")
    0
}
