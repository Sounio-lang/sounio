//@ run-pass
//@ requires: madaros
//@ description: Lorenz third fixed-point ball transition with i128 centers

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let dt: i128 = 10000 as i128
    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    // Input is the step-2 ball certified by lorenz_i128_ball_two_step.sio.
    let x2: i128 = 1026000 as i128
    let y2: i128 = 1517566 as i128
    let z2: i128 = 969712 as i128
    let xr2: i64 = 16
    let yr2: i64 = 17
    let zr2: i64 = 12

    let dx2: i128 = sigma * (y2 - x2)
    let dy2: i128 = (x2 * ((rho * scale) - z2)) / scale - y2
    let dz2: i128 = (x2 * y2) / scale - (beta_num * z2) / beta_den
    let x3: i128 = x2 + (dt * dx2) / scale
    let y3: i128 = y2 + (dt * dy2) / scale
    let zdrop2: i128 = (dt * ((0 as i128) - dz2)) / scale
    let z3: i128 = z2 - zdrop2

    let dxr2: i64 = 10 * (yr2 + xr2)
    let x_rhoz_r2: i64 = ((1026000 * zr2) + (27030288 * xr2) + (xr2 * zr2)) / 1000000 + 1
    let dyr2: i64 = x_rhoz_r2 + yr2
    let xyr2: i64 = ((1026000 * yr2) + (1517566 * xr2) + (xr2 * yr2)) / 1000000 + 1
    let beta_zr2: i64 = ((8 * zr2) + 2) / 3
    let dzr2: i64 = xyr2 + beta_zr2
    let xr3: i64 = xr2 + (10000 * dxr2) / 1000000 + 1
    let yr3: i64 = yr2 + (10000 * dyr2) / 1000000 + 1
    let zr3: i64 = zr2 + (10000 * dzr2) / 1000000 + 1

    if dx2 != (4915660 as i128) { return 1 }
    if dy2 != (26215509 as i128) { return 2 }
    if dz2 != ((0 as i128) - (1028876 as i128)) { return 3 }
    if x3 != (1075156 as i128) { return 4 }
    if y3 != (1779721 as i128) { return 5 }
    if z3 != (959424 as i128) { return 6 }

    if dxr2 != 330 { return 7 }
    if dyr2 != 462 { return 8 }
    if dzr2 != 74 { return 9 }
    if xr3 != 20 { return 10 }
    if yr3 != 22 { return 11 }
    if zr3 != 13 { return 12 }

    return 0
}
