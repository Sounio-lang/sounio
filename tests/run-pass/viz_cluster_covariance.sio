 legend1[32]=114
 viz_node_set_label(&!scene,xa,&index,27)
 viz_node_set_label(&!scene,xb,&index,27)
 viz_node_set_label(&!scene,ya,&units,2)
 viz_node_set_label(&!scene,yb,&units,2)
 assert(viz_add_label(&!scene,&title,55,viz_layout_rect(140,20,1140,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&subtitle,46,viz_layout_rect(140,52,1140,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&headA,25,viz_layout_rect(140,94,480,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&headB,29,viz_layout_rect(800,94,480,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&note,47,viz_layout_rect(140,545,1140,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&factor,48,viz_layout_rect(140,580,1140,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_series_legend(&!scene,cr0_node,&legend0,18,viz_layout_rect(800,465,480,22))>=0)
 assert(viz_add_series_legend(&!scene,cr1s_node,&legend1,33,viz_layout_rect(800,500,480,22))>=0)
 assert(scene.node_count==15 && scene.series_count==3)
 assert(scene.series[0].n==2 && scene.series[1].n==2 && scene.series[2].n==2)
 let pixels=heap_alloc(1440*640*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:1440,height:640}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 let coefficient_y:i64=389-((coefficients[0]/16.0)*239.0) as i64
 let first_se_y:i64=389-(se0[0]*239.0) as i64
 let second_se_y:i64=389-(se1[0]*239.0) as i64
 assert(read_i64(canvas.pixels,coefficient_y*1440+300)==220*65536+135*256+225)
 assert(read_i64(canvas.pixels,first_se_y*1440+960)==70*65536+180*256+235)
 assert(read_i64(canvas.pixels,second_se_y*1440+960)==245*65536+170*256+65)
 viz_html_emit_scene(&scene,1440,640)
 println("VIZ_CLUSTER_COVARIANCE_PASS")
