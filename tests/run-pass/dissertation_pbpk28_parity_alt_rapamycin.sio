//@ run-pass
//@ timeout: 90
use darwin_pbpk::tmdd::fkbp12_mtorc1::*
use darwin_pbpk::pd::coronary_smc_prolif::*
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — RAPAMYCIN at literature PS
//
// Companion to website/src/lib/pbpk28_core.mjs and the parity gate at
// scripts/ci/dissertation_pbpk28_parity_gate.sh (Case 1: Node ↔ Sounio at
// literature parameters).
//
// Model: permeability-limited PBPK, 14 organs × {vascular, interstitial}.
//   V_v,i · dC_v,i/dt = Q_i·(C_blood - C_v,i) - PS_i·(C_v,i - C_t,i/Kp_i)
//   V_t,i · dC_t,i/dt = PS_i·(C_v,i - C_t,i/Kp_i)
//   V_b   · dC_b/dt   = sum_i Q_i·(C_v,i - C_b) - cl_hep·C_b
//
// Integrator: **fully-coupled Crank-Nicolson** on the 27-state system. No
// operator splitting — PS coupling and Q transport integrated implicitly in
// one CN step via per-organ Schur-complement elimination (organ 2×2 blocks
// inverted analytically) + scalar reduction for C_blood. A-stable, 2nd-order,
// O(N) per step. Eliminates the operator-splitting bias of the prior
// Strang(PS, CN-slow) scheme — required for the deep-degenerate (V_v→0, PS→∞)
// asymptotic regime and Stage G-δ semaglutide PS values.
//
// Compartment indexing matches website/src/components/dissertation/compartments.ts:
//   0=blood 1=liver 2=kidney 3=brain 4=heart 5=lung 6=muscle 7=adipose
//   8=gut   9=skin  10=bone   11=spleen 12=pancreas 13=other
//
// Bolus 0.05 mg into blood (C_blood(0) = 0.01 mg/L). cl_hep = 12.4 L/h. Stent off.
// Twelve log-spaced sample times. Emits PARITY|t / PARITY|i / PARITY|cv / PARITY|ct
// / PARITY|cavg records — the gate joins on (t, i) and compares against the
// Node runner's identical output.
// ============================================================================

// State: 14 organs × {Cv [mg/L], Ct [mg/L], Rfree [nmol/L], DR [nmol/L],
//                     A [0..1 mTORC1 activity], N [0..1 neointimal index]}.
// Rfree/DR populated at TMDD organs (1=liver, 4=heart, 8=gut).
// A/N populated at PD organs (4=heart, coronary_smc proxy).
struct Pbpk28 {
    cv: [f64; 14],
    ct: [f64; 14],
    rfree: [f64; 14],
    dr: [f64; 14],
    a: [f64; 14],
    n: [f64; 14]
}

fn pbpk28_zero() -> Pbpk28 {
    Pbpk28 {
        cv: [0.0; 14],
        ct: [0.0; 14],
        rfree: [0.0; 14],
        dr: [0.0; 14],
        a: [0.0; 14],
        n: [0.0; 14]
    }
}

// ─── TMDD + PD layers — sourced from stdlib/darwin_pbpk/{tmdd,pd}/ ──────────
// `use` lines above pull in:
//   tmdd/fkbp12_mtorc1 — fkbp12_mw_rapamycin_da, fkbp12_{kdeg,kon,kd,kint,koff,ksyn_at,rtotal0_at,is_tmdd_organ}
//   pd/coronary_smc_prolif — coronary_pd_{ka,kprolif,kapo}
// The Pbpk28-coupled step glue (`tmdd_step_organ`, `pd_step_organ`) stays
// local — it needs Pbpk28-vector unpacking + nmol/mg unit handling that the
// pure stdlib `tmdd_step`/`pd_step_rapamycin` kernels don't carry. Constants
// previously defined inline (mw_rapamycin, tmdd_kon_at, pd_ka_at, …) are now
// the single-source-of-truth from stdlib.
fn pd_is_organ(i: i64) -> bool {
    if i == 4 { return true }
    return false
}

// V_i, L, ICRP standard man 70 kg (matches pbpk14_core.mjs V_REF).
fn vref_at(i: i64) -> f64 {
    if i ==  0 { return 5.0 }
    if i ==  1 { return 1.8 }
    if i ==  2 { return 0.31 }
    if i ==  3 { return 1.45 }
    if i ==  4 { return 0.33 }
    if i ==  5 { return 1.1 }
    if i ==  6 { return 28.0 }
    if i ==  7 { return 20.0 }
    if i ==  8 { return 1.2 }
    if i ==  9 { return 3.6 }
    if i == 10 { return 6.6 }
    if i == 11 { return 0.18 }
    if i == 12 { return 0.09 }
    return 3.7
}

// Vascular volume fraction V_v,i / V_i. Brown 1997.
fn vasc_frac_at(i: i64) -> f64 {
    if i ==  0 { return 1.000 }
    if i ==  1 { return 0.210 }
    if i ==  2 { return 0.160 }
    if i ==  3 { return 0.037 }
    if i ==  4 { return 0.262 }
    if i ==  5 { return 0.262 }
    if i ==  6 { return 0.040 }
    if i ==  7 { return 0.050 }
    if i ==  8 { return 0.024 }
    if i ==  9 { return 0.019 }
    if i == 10 { return 0.041 }
    if i == 11 { return 0.282 }
    if i == 12 { return 0.180 }
    return 0.050
}

// Kp (rapamycin partition coefficient, tissue:vascular at equilibrium).
fn kp_at(i: i64) -> f64 {
    if i ==  0 { return 1.00 }
    if i ==  1 { return 5.40 }
    if i ==  2 { return 4.20 }
    if i ==  3 { return 0.10 }
    if i ==  4 { return 2.30 }
    if i ==  5 { return 3.10 }
    if i ==  6 { return 0.50 }
    if i ==  7 { return 0.30 }
    if i ==  8 { return 2.60 }
    if i ==  9 { return 0.80 }
    if i == 10 { return 0.20 }
    if i == 11 { return 2.10 }
    if i == 12 { return 1.80 }
    return 0.40
}

// Q (organ blood flow, L/h, 70 kg adult).
fn q_at(i: i64) -> f64 {
    if i ==  0 { return 350.0 }
    if i ==  1 { return 90.0 }
    if i ==  2 { return 74.0 }
    if i ==  3 { return 44.0 }
    if i ==  4 { return 16.0 }
    if i ==  5 { return 350.0 }
    if i ==  6 { return 42.0 }
    if i ==  7 { return 10.0 }
    if i ==  8 { return 55.0 }
    if i ==  9 { return 21.0 }
    if i == 10 { return 17.0 }
    if i == 11 { return 10.0 }
    if i == 12 { return 8.0 }
    return 13.0
}

// PS_i (L/h) for rapamycin. Identical to PS_RAPAMYCIN in pbpk28_core.mjs.
fn ps_at(i: i64) -> f64 {
    if i ==  0 { return 0.0 }
    if i ==  1 { return 1800.0 }
    if i ==  2 { return 1110.0 }
    if i ==  3 { return 88.0 }
    if i ==  4 { return 160.0 }
    if i ==  5 { return 10500.0 }
    if i ==  6 { return 336.0 }
    if i ==  7 { return 40.0 }
    if i ==  8 { return 660.0 }
    if i ==  9 { return 126.0 }
    if i == 10 { return 51.0 }
    if i == 11 { return 150.0 }
    if i == 12 { return 96.0 }
    return 78.0
}

fn cl_hep() -> f64 { return 12.4 }

// Taylor-series exp for the PS-relaxation analytical step. The argument is
// always non-positive (-λ·dt/2 with λ > 0, dt > 0); we range-reduce x → x/2^k
// until |x| ≤ 0.5, evaluate the truncated series to order 8, then square back
// k times. This gives ~14 digits of accuracy for the negative-x range we use.
fn exp_neg(x: f64) -> f64 with Mut, Div {
    if x == 0.0 { return 1.0 }
    var s = x
    var k = 0
    while s < (0.0 - 0.5) {
        s = s * 0.5
        k = k + 1
    }
    let s2 = s * s
    let s3 = s2 * s
    let s4 = s2 * s2
    let s5 = s4 * s
    let s6 = s3 * s3
    let s7 = s6 * s
    let s8 = s4 * s4
    var r = 1.0 + s + s2 / 2.0 + s3 / 6.0 + s4 / 24.0 + s5 / 120.0
              + s6 / 720.0 + s7 / 5040.0 + s8 / 40320.0
    var j = 0
    while j < k {
        r = r * r
        j = j + 1
    }
    return r
}

// Half-step exact PS-relaxation per organ. Equilibrium: Ct_eq = Kp · Cv_eq;
// mass conservation: V_v · Cv + V_t · Ct = M ⇒ Cv_eq = M / (V_v + V_t·Kp).
// Decay: z(τ) = z(0) · exp(-λ·τ) where z = Cv - Ct/Kp,
// λ = PS · (1/V_v + 1/(V_t·Kp)).
fn ps_relax(state: Pbpk28, dt: f64) -> Pbpk28 with Mut, Div {
    var r = state
    var i = 1
    while i < 14 {
        let vi = vref_at(i)
        let vf = vasc_frac_at(i)
        let vv = vi * vf
        let vt = vi * (1.0 - vf)
        let kp = kp_at(i)
        let ps = ps_at(i)
        if vv > 0.0 && vt > 0.0 && kp > 0.0 && ps > 0.0 {
            let mass = vv * r.cv[i] + vt * r.ct[i]
            let denom = vv + vt * kp
            let cv_eq = mass / denom
            let ct_eq = kp * cv_eq
            let lambda = ps * (1.0 / vv + 1.0 / (vt * kp))
            let decay = exp_neg(0.0 - lambda * dt)
            r.cv[i] = cv_eq + (r.cv[i] - cv_eq) * decay
            r.ct[i] = ct_eq + (r.ct[i] - ct_eq) * decay
        }
        i = i + 1
    }
    return r
}

// Fully-coupled Crank-Nicolson step on the **27-state** PBPK28 system.
// Replaces the prior Strang(PS, CN-slow) splitting — no operator splitting at
// all. PS-coupling and Q-transport are integrated implicitly in one CN step.
//
// State x = [C_blood, Cv_1, Ct_1, ..., Cv_13, Ct_13]; M is block-arrow.
// (I - dt·M/2)·x_new = (I + dt·M/2)·x_old + dt·f_mid
// Per-organ Schur elimination + scalar reduction for C_blood — O(N).
//
//   h = dt/2
//   p_i = 1 + h·(Q_i + PS_i)/V_v_i        (Cv self)
//   q_i = h·PS_i/(V_v_i·Kp_i)             (Cv ← Ct)
//   r_i = h·PS_i/V_t_i                    (Ct ← Cv)
//   s_i = 1 + h·PS_i/(V_t_i·Kp_i)         (Ct self)
//   D_i = p_i·s_i - q_i·r_i               (organ-block det)
//   γ_i = h·Q_i/V_v_i                     (Cv ← Cb)
//   β_i = h·Q_i/V_b                       (Cb ← Cv)
//   S   = h·(Σ Q_i + cl_hep)/V_b          (Cb self)
//
//   rhs0   = (1-S)·Cb_old + Σ β_i·Cv_i_old
//   rhsv_i = γ_i·Cb_old + (1 - h(Q+PS)/V_v)·Cv_i_old + q_i·Ct_i_old
//   rhst_i = r_i·Cv_i_old + (1 - h·PS/(V_t·Kp))·Ct_i_old
//
//   aV_i = (s_i·rhsv_i + q_i·rhst_i)/D_i
//   bV_i = s_i·γ_i / D_i
//   aT_i = (r_i·rhsv_i + p_i·rhst_i)/D_i
//   bT_i = r_i·γ_i / D_i
//   Cb_new = (rhs0 + Σ β_i·aV_i) / ((1+S) - Σ β_i·bV_i)
//   Cv_i_new = aV_i + bV_i·Cb_new
//   Ct_i_new = aT_i + bT_i·Cb_new
//
// A-stable, 2nd-order, no operator-splitting bias.
fn full_cn_step(state: Pbpk28, dt: f64) -> Pbpk28 with Mut, Div {
    let h = 0.5 * dt
    let vb = vref_at(0)

    var sum_q = 0.0
    var i = 1
    while i < 14 {
        sum_q = sum_q + q_at(i)
        i = i + 1
    }
    let big_s = h * (sum_q + cl_hep()) / vb

    let cb_old = state.cv[0]
    var rhs0 = (1.0 - big_s) * cb_old

    var a_v: [f64; 14] = [0.0; 14]
    var b_v: [f64; 14] = [0.0; 14]
    var a_t: [f64; 14] = [0.0; 14]
    var b_t: [f64; 14] = [0.0; 14]
    var sum_beta_a = 0.0
    var sum_beta_b = 0.0

    i = 1
    while i < 14 {
        let vi = vref_at(i)
        let vf = vasc_frac_at(i)
        let vv_raw = vi * vf
        let vt_raw = vi * (1.0 - vf)
        let vv = if vv_raw < 1.0e-30 { 1.0e-30 } else { vv_raw }
        let vt = if vt_raw < 1.0e-30 { 1.0e-30 } else { vt_raw }
        let kp = kp_at(i)
        let ps = ps_at(i)
        let qi = q_at(i)

        let beta = h * qi / vb
        let gamma = h * qi / vv
        let p = 1.0 + h * (qi + ps) / vv
        let q = h * ps / (vv * kp)
        let r = h * ps / vt
        let sb = 1.0 + h * ps / (vt * kp)
        let det = p * sb - q * r

        rhs0 = rhs0 + beta * state.cv[i]

        let rhs_v = gamma * cb_old + (1.0 - h * (qi + ps) / vv) * state.cv[i] + q * state.ct[i]
        let rhs_t = r * state.cv[i] + (1.0 - h * ps / (vt * kp)) * state.ct[i]

        let av = (sb * rhs_v + q * rhs_t) / det
        let bv = (sb * gamma) / det
        let at = (r * rhs_v + p * rhs_t) / det
        let bt = (r * gamma) / det

        a_v[i] = av
        b_v[i] = bv
        a_t[i] = at
        b_t[i] = bt

        sum_beta_a = sum_beta_a + beta * av
        sum_beta_b = sum_beta_b + beta * bv
        i = i + 1
    }

    let cb_new = (rhs0 + sum_beta_a) / ((1.0 + big_s) - sum_beta_b)
    var out = state                                          // inherits rfree/dr
    out.cv[0] = if cb_new < 0.0 { 0.0 } else { cb_new }
    i = 1
    while i < 14 {
        let cv = a_v[i] + b_v[i] * cb_new
        let ct = a_t[i] + b_t[i] * cb_new
        out.cv[i] = if cv < 0.0 { 0.0 } else { cv }
        out.ct[i] = if ct < 0.0 { 0.0 } else { ct }
        i = i + 1
    }
    return out
}

// ─── TMDD layer with back-reaction (G-β-2) ─────────────────────────────────
// Per-TMDD-organ 3-state implicit step on (C_t_nM, R_free, DR). All states in
// nmol/L; C_t converted from mass at start and back at end. Bilinear term
// k_on·C_t_nM·R_free Newton-linearized at start-of-step values for a single-
// iteration implicit CN solve (3×3 invert per organ).
//
//   dC_t_nM/dt = -k_on·C_t·R_free + k_off·DR
//   dR_free/dt =  k_syn - k_deg·R_free - k_on·C_t·R_free + k_off·DR
//   dDR/dt    =  k_on·C_t·R_free - (k_off + k_int)·DR
//
// Newton at (C_t_old, R_free_old):
//   k_on·C_t·R_free ≈ k_on·(C_t_old·R_free + R_free_old·C_t - C_t_old·R_free_old)
fn tmdd_step_organ(state: Pbpk28, i: i64, dt: f64) -> Pbpk28 with Mut, Div {
    if !fkbp12_is_tmdd_organ(i) { return state }
    var r = state
    let h = 0.5 * dt
    let mass_to_nm = 1.0e6 / fkbp12_mw_rapamycin_da()
    let nm_to_mass = fkbp12_mw_rapamycin_da() * 1.0e-6
    let ct_old_mass = r.ct[i]
    let ct_old_nm = if ct_old_mass < 0.0 { 0.0 } else { ct_old_mass * mass_to_nm }
    let rf_old = r.rfree[i]
    let dr_old = r.dr[i]

    let k_on = fkbp12_kon()
    let k_off = fkbp12_koff()
    let k_int = fkbp12_kint()
    let k_syn = fkbp12_ksyn_at(i)
    let k_deg = fkbp12_kdeg()

    let kon_rf  = k_on * rf_old
    let kon_ct  = k_on * ct_old_nm
    let bil_old = k_on * ct_old_nm * rf_old

    // M (3×3) Newton-linearized at (ct_old_nm, rf_old):
    let m00 = 0.0 - kon_rf
    let m01 = 0.0 - kon_ct
    let m02 = k_off
    let m10 = 0.0 - kon_rf
    let m11 = (0.0 - k_deg) - kon_ct
    let m12 = k_off
    let m20 = kon_rf
    let m21 = kon_ct
    let m22 = 0.0 - (k_off + k_int)

    let f0 = bil_old
    let f1 = k_syn + bil_old
    let f2 = 0.0 - bil_old

    // RHS = (I + h·M)·x_old + dt·f
    let rhs0 = (1.0 + h*m00) * ct_old_nm + (h*m01) * rf_old + (h*m02) * dr_old + dt * f0
    let rhs1 = (h*m10) * ct_old_nm + (1.0 + h*m11) * rf_old + (h*m12) * dr_old + dt * f1
    let rhs2 = (h*m20) * ct_old_nm + (h*m21) * rf_old + (1.0 + h*m22) * dr_old + dt * f2

    // A = I - h·M
    let a00 = 1.0 - h*m00
    let a01 = 0.0 - h*m01
    let a02 = 0.0 - h*m02
    let a10 = 0.0 - h*m10
    let a11 = 1.0 - h*m11
    let a12 = 0.0 - h*m12
    let a20 = 0.0 - h*m20
    let a21 = 0.0 - h*m21
    let a22 = 1.0 - h*m22

    // 3×3 invert via cofactor expansion
    let c00 = a11*a22 - a12*a21
    let c01 = a12*a20 - a10*a22
    let c02 = a10*a21 - a11*a20
    let det = a00*c00 + a01*c01 + a02*c02

    let c10 = a02*a21 - a01*a22
    let c11 = a00*a22 - a02*a20
    let c12 = a01*a20 - a00*a21
    let c20 = a01*a12 - a02*a11
    let c21 = a02*a10 - a00*a12
    let c22 = a00*a11 - a01*a10

    let ct_new_nm = (c00*rhs0 + c10*rhs1 + c20*rhs2) / det
    let rf_new    = (c01*rhs0 + c11*rhs1 + c21*rhs2) / det
    let dr_new    = (c02*rhs0 + c12*rhs1 + c22*rhs2) / det

    let ct_new_clamped = if ct_new_nm < 0.0 { 0.0 } else { ct_new_nm }
    r.ct[i] = ct_new_clamped * nm_to_mass
    r.rfree[i] = if rf_new < 0.0 { 0.0 } else { rf_new }
    r.dr[i] = if dr_new < 0.0 { 0.0 } else { dr_new }
    return r
}

// ─── PD step (G-γ): 1-state implicit CN on A, then on N at fixed A_new ────
fn pd_step_organ(state: Pbpk28, i: i64, dt: f64) -> Pbpk28 with Mut, Div {
    if !pd_is_organ(i) { return state }
    var r = state
    let h = 0.5 * dt
    let target_a = r.rfree[i] / fkbp12_rtotal0_at(i)
    let k_a = coronary_pd_ka()
    // CN on dA/dt = k_a · (target - A):  (1 + h·k_a)·A_new = (1 - h·k_a)·A_old + dt·k_a·target
    let a_new = ((1.0 - h * k_a) * r.a[i] + dt * k_a * target_a) / (1.0 + h * k_a)
    let a_clamped = if a_new < 0.0 { 0.0 } else { if a_new > 1.0 { 1.0 } else { a_new } }
    r.a[i] = a_clamped

    // CN on dN/dt = k_prolif · A - k_apo · (1-A) · N at fixed A_new:
    let one_minus_a = 1.0 - a_clamped
    let gamma_n = coronary_pd_kapo() * one_minus_a
    let n_new = ((1.0 - h * gamma_n) * r.n[i] + dt * coronary_pd_kprolif() * a_clamped) / (1.0 + h * gamma_n)
    r.n[i] = if n_new < 0.0 { 0.0 } else { n_new }
    return r
}

// One fully-coupled implicit PBPK step + per-TMDD-organ binding step
// + per-PD-organ (A, N) step. Lie split: PBPK → TMDD → PD.
fn strang_step(state: Pbpk28, dt: f64) -> Pbpk28 with Mut, Div {
    var s = full_cn_step(state, dt)
    s = tmdd_step_organ(s, 1, dt)
    s = tmdd_step_organ(s, 4, dt)
    s = tmdd_step_organ(s, 8, dt)
    s = pd_step_organ(s, 4, dt)
    return s
}

fn integrate_to(state: Pbpk28, t_start: f64, t_end: f64, dt: f64) -> Pbpk28 with Mut, Div {
    var C = state
    var t = t_start
    while t + dt * 0.5 < t_end {
        C = strang_step(C, dt)
        t = t + dt
    }
    return C
}

// Organ-average concentration C_avg = vasc_frac · Cv + (1 - vasc_frac) · Ct.
// (For blood at i=0, Cv[0] is the central concentration and Ct[0] is unused.)
fn c_avg_at(state: &Pbpk28, i: i64) -> f64 {
    if i == 0 { return state.cv[0] }
    let vf = vasc_frac_at(i)
    return vf * state.cv[i] + (1.0 - vf) * state.ct[i]
}

fn emit_at(state: &Pbpk28, t: f64) with IO, Mut {
    var i = 0
    while i < 14 {
        // PARITY|t / PARITY|i / PARITY|cv / PARITY|ct / PARITY|cavg per organ;
        // PARITY|rfree / PARITY|dr additionally for TMDD organs (1=liver,
        // 4=heart, 8=gut). Gate joins on (t, i).
        print("PARITY|t=")
        println(t)
        println("")
        print("PARITY|i=")
        println(i)
        print("PARITY|cv=")
        println(state.cv[i])
        println("")
        print("PARITY|ct=")
        println(state.ct[i])
        println("")
        print("PARITY|cavg=")
        let avg = if i == 0 { state.cv[0] } else { vasc_frac_at(i) * state.cv[i] + (1.0 - vasc_frac_at(i)) * state.ct[i] }
        println(avg)
        println("")
        if fkbp12_is_tmdd_organ(i) {
            print("PARITY|rfree=")
            println(state.rfree[i])
            println("")
            print("PARITY|dr=")
            println(state.dr[i])
            println("")
        }
        if pd_is_organ(i) {
            print("PARITY|pd_a=")
            println(state.a[i])
            println("")
            print("PARITY|pd_n=")
            println(state.n[i])
            println("")
        }
        i = i + 1
    }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_PARITY_ALT v1")
    println("compartments=14")
    println("states=28")
    println("dt=0.0005")
    println("bolus_mg=0.05")
    println("cl_hep_L_per_h=12.4")
    println("integrator=fully_coupled_CN_27state")
    println("drug=rapamycin")
    println("samples=12")

    var C = pbpk28_zero()
    C.cv[0] = 0.05 / vref_at(0)  // 0.01 mg/L initial blood concentration
    // TMDD organs: initialize R_free at baseline steady-state R_total_0,
    // DR at 0 (no drug bound at t=0).
    C.rfree[1] = fkbp12_rtotal0_at(1)
    C.rfree[4] = fkbp12_rtotal0_at(4)
    C.rfree[8] = fkbp12_rtotal0_at(8)
    // PD organs (heart only for G-γ-1): A = 1.0 (full mTORC1 activity at
    // baseline, no drug), N = 0 (no neointima at stent implant).
    C.a[4] = 1.0

    let dt = 0.0005
    var t = 0.0

    C = integrate_to(C, t,  0.1, dt); t =  0.1; emit_at(&C, t)
    C = integrate_to(C, t,  0.5, dt); t =  0.5; emit_at(&C, t)
    C = integrate_to(C, t,  1.0, dt); t =  1.0; emit_at(&C, t)
    C = integrate_to(C, t,  2.0, dt); t =  2.0; emit_at(&C, t)
    C = integrate_to(C, t,  4.0, dt); t =  4.0; emit_at(&C, t)
    C = integrate_to(C, t,  6.0, dt); t =  6.0; emit_at(&C, t)
    C = integrate_to(C, t,  8.0, dt); t =  8.0; emit_at(&C, t)
    C = integrate_to(C, t, 12.0, dt); t = 12.0; emit_at(&C, t)
    C = integrate_to(C, t, 16.0, dt); t = 16.0; emit_at(&C, t)
    C = integrate_to(C, t, 20.0, dt); t = 20.0; emit_at(&C, t)
    C = integrate_to(C, t, 24.0, dt); t = 24.0; emit_at(&C, t)
    C = integrate_to(C, t, 30.0, dt); t = 30.0; emit_at(&C, t)

    println("DISSERTATION_PBPK28_PARITY_DONE")
    return 0
}
