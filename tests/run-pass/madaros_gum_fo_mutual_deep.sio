//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_MUTUAL_DEEP_PASS

// Deep mutual FO via depth specialization (f_d0..f_d8).
// Const n at call site selects pre-folded transfer; n=0..5 match analytic peels.
//
// f/g alternate mul vs add of (a,b) by parity of n:
//   f(even) → a*b, f(odd) → a+b

fn f(n: i64, a: f64, b: f64) -> f64 {
    if n <= 0 { a * b } else { g(n - 1, a, b) }
}
fn g(n: i64, a: f64, b: f64) -> f64 {
    if n <= 0 { a + b } else { f(n - 1, a, b) }
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let ka: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value

    let v_mul = variance_of(a * b)
    let v_add = variance_of(a + b)

    let v0 = variance_of(f(0, a, b))
    let v1 = variance_of(f(1, a, b))
    let v2 = variance_of(f(2, a, b))
    let v3 = variance_of(f(3, a, b))
    let v4 = variance_of(f(4, a, b))
    let v5 = variance_of(f(5, a, b))

    print("v0="); print_f64(v0); print("\n")
    print("v1="); print_f64(v1); print("\n")
    print("v2="); print_f64(v2); print("\n")
    print("v3="); print_f64(v3); print("\n")
    print("v4="); print_f64(v4); print("\n")
    print("v5="); print_f64(v5); print("\n")

    let ok = abs_f(v0 - v_mul) < 1.0e-9
        && abs_f(v1 - v_add) < 1.0e-9
        && abs_f(v2 - v_mul) < 1.0e-9
        && abs_f(v3 - v_add) < 1.0e-9
        && abs_f(v4 - v_mul) < 1.0e-9
        && abs_f(v5 - v_add) < 1.0e-9
        && abs_f(v_mul - 0.25) < 1.0e-9
        && abs_f(v_add - 0.05) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_MUTUAL_DEEP_PASS\n")
    } else {
        print("MADAROS_GUM_FO_MUTUAL_DEEP_FAIL\n")
    }
}
