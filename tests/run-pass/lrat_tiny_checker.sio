//@ run-pass
//@ requires: madaros
//@ description: Scalar LRAT ID and RUP antecedent replay smoke

fn lrat_tiny_active(id: i64, deleted2: i64) -> i64 {
    if id == 1 { return 1 }
    if id == 2 {
        if deleted2 == 0 { return 1 }
        return 0
    }
    return 0
}

// Tiny fixed formula:
//   clause 1:  x
//   clause 2: -x
//
// Replay the hint IDs in order. State `assign` is 0 unknown, 1 x=true,
// -1 x=false. Return 1 iff the hints derive a conflict.
fn lrat_tiny_check_empty(h0: i64, h1: i64, hlen: i64, deleted2: i64) -> i64 {
    if hlen < 0 { return 0 }
    if hlen > 2 { return 0 }
    var assign: i64 = 0
    var step: i64 = 0
    while step < hlen {
        var id = h0
        if step == 1 { id = h1 }
        if lrat_tiny_active(id, deleted2) == 0 { return 0 }

        if id == 1 {
            if assign == (0 - 1) { return 1 }
            assign = 1
        } else {
            if id == 2 {
                if assign == 1 { return 1 }
                assign = 0 - 1
            } else {
                return 0
            }
        }
        step = step + 1
    }
    return 0
}

// A tautological lemma `(x OR -x)` is RUP because negating it asks for both
// `-x` and `x`, which is an immediate assignment conflict.
fn lrat_tiny_check_tautology() -> i64 {
    var assign: i64 = 0
    // Negate x.
    assign = 0 - 1
    // Negate -x, i.e. assign x=true.
    if assign == (0 - 1) { return 1 }
    return 0
}

fn main() -> i64 {
    if lrat_tiny_active(1, 0) != 1 { return 1 }
    if lrat_tiny_active(2, 0) != 1 { return 2 }
    if lrat_tiny_active(2, 1) != 0 { return 3 }
    if lrat_tiny_active(42, 0) != 0 { return 4 }

    if lrat_tiny_check_empty(1, 2, 2, 0) != 1 { return 5 }
    if lrat_tiny_check_empty(2, 1, 2, 0) != 1 { return 6 }
    if lrat_tiny_check_empty(1, 0, 1, 0) != 0 { return 7 }
    if lrat_tiny_check_empty(42, 0, 1, 0) != 0 { return 8 }
    if lrat_tiny_check_empty(1, 2, 2, 1) != 0 { return 9 }

    if lrat_tiny_check_tautology() != 1 { return 10 }
    return 0
}
