//@ run-pass
//@ requires: madaros
// Madaros native-v2 must honour global element-list initializers `[a, b, c]`.
// Residual after #1305 (repeat-only): distinct per-element words.
//@ expect-stdout: 10 20 30
//@ expect-stdout: 1.500000 2.500000
//@ expect-stdout: LIST_OK

var A: [i64; 3] = [10, 20, 30]
var B: [f64; 2] = [1.5, 2.5]

fn main() -> i64 with IO {
    print_int(A[0])
    print(" ")
    print_int(A[1])
    print(" ")
    print_int(A[2])
    print("\n")
    print(B[0])
    print(" ")
    print(B[1])
    print("\n")
    if A[0] != 10 { return 1 }
    if A[1] != 20 { return 2 }
    if A[2] != 30 { return 3 }
    if B[0] != 1.5 { return 4 }
    if B[1] != 2.5 { return 5 }
    print("LIST_OK\n")
    0
}
