//@ run-pass
//@ expect-stdout: LET_SCOPE_BINDING_OK
// `scope` remains a policy keyword and is contextual in local binding use.
struct ScopeBindingPayload {
    value: i32,
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let scope = ScopeBindingPayload { value: 42 }
    let copied = scope.value
    if copied != 42 {
        println("FAIL: scope as expression")
        return 1
    }
    println("LET_SCOPE_BINDING_OK")
    return scope.value - 42
}
