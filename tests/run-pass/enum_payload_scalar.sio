//@ run-pass
//@ requires: madaros
//@ description: KL-20 -- tuple and struct enum variants carry i64, f64, bool and string payloads through construction, match binding, function arguments and returns, and methods; unit variants of a payload enum still match
//@ expect-stdout: circle=12.500000
//@ expect-stdout: rect=12
//@ expect-stdout: empty=0
//@ expect-stdout: label=hello
//@ expect-stdout: flag=1
//@ expect-stdout: sum=42
//@ expect-stdout: method=6
//@ expect-stdout: chain=7

enum Shape { Circle(f64), Rect { w: i64, h: i64 }, Empty }
enum Tok { Num(i64), Word(string), Flag(bool), Pair(i64, i64) }

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 2.0 * r * r,
        Shape::Rect { w, h } => (w * h) as f64,
        Shape::Empty => 0.0,
    }
}

fn make(k: i64) -> Shape {
    if k == 0 { Shape::Circle(2.5) } else if k == 1 { Shape::Rect { w: 3, h: 4 } } else { Shape::Empty }
}

fn tok_value(t: &Tok) -> i64 {
    match t {
        Tok::Num(n) => n,
        Tok::Word(_) => 0 - 1,
        Tok::Flag(b) => if b { 1 } else { 0 },
        Tok::Pair(a, b) => a + b,
    }
}

impl Shape {
    fn sides(self) -> i64 {
        match self {
            Shape::Rect { w: _, h: _ } => 4,
            Shape::Circle(_) => 1,
            Shape::Empty => 1,
        }
    }
}

fn relay(t: Tok) -> Tok { t }

fn main() -> i32 with IO {
    print("circle=")
    println(area(make(0)))
    print("rect=")
    println(area(make(1)) as i64)
    print("empty=")
    println(area(make(2)) as i64)
    let w = Tok::Word("hello")
    match w {
        Tok::Word(s) => { print("label="); println(s) }
        _ => println("bad"),
    }
    print("flag=")
    println(tok_value(&Tok::Flag(true)))
    let p = Tok::Pair(40, 2)
    print("sum=")
    println(tok_value(&p))
    print("method=")
    println(make(1).sides() + make(0).sides() + make(2).sides())
    print("chain=")
    println(tok_value(&relay(relay(Tok::Num(7)))))
    0
}
