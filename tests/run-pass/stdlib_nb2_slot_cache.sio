//@ run-pass
//@ requires: madaros
//@ expect-stdout: NB2_SLOT_CACHE_PASS
use stats::regression::nb2_likelihood::{Nb2LikelihoodSlot,nb2_likelihood_slot,nb2_log_probability_into,nb2_likelihood_slot_reset,nb2_likelihood_slot_status,nb2_likelihood_slot_count,nb2_likelihood_slot_log_probability,nb2_likelihood_slot_normalizer_status,nb2_likelihood_slot_saturated_log_probability,nb2_likelihood_slot_residual_status,nb2_likelihood_slot_residual,nb2_likelihood_slot_deviance_status,nb2_likelihood_slot_deviance,nb2_likelihood_slot_poisson_limit,nb2_likelihood_slot_stirling_used,nb2_likelihood_slot_remainder_estimate,nb2_likelihood_slot_remainder_estimate_available,nb2_likelihood_slot_assumptions_assessed}
fn cache_record(id:i64,phase:i64,count:i64,mean:f64,alpha:f64,s:&Nb2LikelihoodSlot) with IO {
 let status:i64=nb2_likelihood_slot_status(s)
 let observed:i64=nb2_likelihood_slot_count(s)
 let logp:f64=nb2_likelihood_slot_log_probability(s)
 let ns:i64=nb2_likelihood_slot_normalizer_status(s)
 let sat:f64=nb2_likelihood_slot_saturated_log_probability(s)
 let rs:i64=nb2_likelihood_slot_residual_status(s)
 let residual:f64=nb2_likelihood_slot_residual(s)
 let ds:i64=nb2_likelihood_slot_deviance_status(s)
 let dev:f64=nb2_likelihood_slot_deviance(s)
 let poisson:i64=if nb2_likelihood_slot_poisson_limit(s) {1}else{0}
 let stirling:i64=if nb2_likelihood_slot_stirling_used(s) {1}else{0}
 let rem:f64=nb2_likelihood_slot_remainder_estimate(s)
 let ra:i64=if nb2_likelihood_slot_remainder_estimate_available(s) {1}else{0}
 let assessed:i64=if nb2_likelihood_slot_assumptions_assessed(s) {1}else{0}
 let mean_bits:i64=f64_to_bits(mean)
 let alpha_bits:i64=f64_to_bits(alpha)
 let logp_bits:i64=f64_to_bits(logp)
 let sat_bits:i64=f64_to_bits(sat)
 let residual_bits:i64=f64_to_bits(residual)
 let dev_bits:i64=f64_to_bits(dev)
 let rem_bits:i64=f64_to_bits(rem)
 println("CASE {} {}",id,phase)
 println("INPUT_COUNT {}",count)
 println("INPUT_MEAN {}",mean_bits)
 println("INPUT_ALPHA {}",alpha_bits)
 println("STATUS {}",status);println("COUNT {}",observed)
 println("LOGP {}",logp_bits);println("NORMALIZER {}",ns)
 println("SATURATED {}",sat_bits);println("RESIDUAL_STATUS {}",rs)
 println("RESIDUAL {}",residual_bits);println("DEVIANCE_STATUS {}",ds)
 println("DEVIANCE {}",dev_bits);println("POISSON {}",poisson)
 println("STIRLING {}",stirling);println("REMAINDER {}",rem_bits)
 println("REMAINDER_AVAILABLE {}",ra);println("ASSESSED {}",assessed)
}
fn cache_case(id:i64,count:i64,mean:f64,alpha:f64,s:&!Nb2LikelihoodSlot) with IO,Mut,Div,Panic {
 let first:i64=nb2_log_probability_into(count,mean,alpha,s)
 cache_record(id,0,count,mean,alpha,s)
 let again:i64=nb2_log_probability_into(count,mean,alpha,s)
 assert(first==again)
 cache_record(id,1,count,mean,alpha,s)
 var fresh=nb2_likelihood_slot()
 let rebuilt:i64=nb2_log_probability_into(count,mean,alpha,&!fresh)
 assert(first==rebuilt)
 cache_record(id,2,count,mean,alpha,&fresh)
}
fn main()->i32 with IO,Mut,Div,Panic {
 var slot=nb2_likelihood_slot()
 cache_case(0,1,1.0,1.0,&!slot)
 cache_case(1,2,1.0,1.0,&!slot)
 cache_case(2,2,1.0000000000000002,1.0,&!slot)
 cache_case(3,2,1.0000000000000002,1.0000000000000002,&!slot)
 cache_case(4,8,8.0,0.125,&!slot)
 cache_case(5,8,8.0,0.12500000000000003,&!slot)
 cache_case(6,8,8.0,0.12499999999999999,&!slot)
 cache_case(7,0,2.0,0.0,&!slot)
 cache_case(8,0,2.0,-0.0,&!slot)
 cache_case(9,0,1e308,0.0,&!slot)
 cache_case(10,-1,1.0,0.0,&!slot)
 cache_case(11,1,0.0,1.0,&!slot)
 cache_case(12,1,1.0,-1.0,&!slot)
 cache_case(13,9007199254740993,1.0,0.0,&!slot)
 let zero:f64=0.0
 let nan:f64=zero/zero
 let inf:f64=1.0/zero
 let nanbits:i64=f64_to_bits(nan);let infbits:i64=f64_to_bits(inf)
 assert((nanbits&9218868437227405312)==9218868437227405312 && (nanbits&4503599627370495)!=0)
 assert((infbits&9218868437227405312)==9218868437227405312 && (infbits&4503599627370495)==0)
 cache_case(14,1,nan,1.0,&!slot)
 cache_case(15,1,inf,1.0,&!slot)
 cache_case(16,1,1.0,nan,&!slot)
 cache_case(17,1,1.0,inf,&!slot)
 let quantum:f64=2.2250738585072014e-308/4503599627370496.0
 cache_case(18,1,1.0,quantum,&!slot)
 cache_case(19,0,1.0,quantum,&!slot)
 nb2_likelihood_slot_reset(&!slot)
 cache_record(20,0,0,1.0,1.0,&slot)
 assert(nb2_likelihood_slot_status(&slot)==5)
 cache_case(21,0,1.0,quantum,&!slot)
 println("NB2_SLOT_CACHE_PASS")
 0
}
