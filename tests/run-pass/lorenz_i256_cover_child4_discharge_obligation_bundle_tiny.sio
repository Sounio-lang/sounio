//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 discharge-obligation bundle receipt

fn child4_discharge_obligation_bundle_check(
    child4_promotion_guard_fp: i64,
    child4_promotion_guard_audit_fp: i64,
    child4_discharge_preflight_fp: i64,
    child4_discharge_preflight_audit_fp: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    promotion_allowed_mask: i64,
    finite_cover_candidate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    obligation_status: i64) -> i64 {
    if child4_promotion_guard_fp != 657240918 { return 0 - 1 }
    if child4_promotion_guard_audit_fp != 312489670 { return 0 - 1 }
    if child4_discharge_preflight_fp != 938615204 { return 0 - 1 }
    if child4_discharge_preflight_audit_fp != 405118337 { return 0 - 1 }
    if child_validated_mask != 31 { return 0 - 1 }
    if pending_child_validation_mask != 0 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if promotion_allowed_mask != 0 { return 0 - 1 }
    if finite_cover_candidate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if obligation_status != 77 { return 0 - 1 }
    return 741805623
}

fn main() -> i64 {
    let artifact = child4_discharge_obligation_bundle_check(
        657240918, 312489670, 938615204, 405118337, 31, 0, 255, 0, 0, 0, 0, 77)
    if artifact != 741805623 { return 1 }

    let audit_fp: i64 = 529164708
    let instance_fp: i64 = 364918255
    let certificate_fp: i64 = 971203684
    let discharge_obligation_mask: i64 = 255
    let required_child_discharge_proof_mask: i64 = 255
    let required_boundary_gluing_mask: i64 = 31
    let required_finite_cover_certificate_mask: i64 = 15
    let required_global_claim_review_mask: i64 = 15
    let missing_discharge_proof_mask: i64 = 255
    let missing_certificate_proof_mask: i64 = 15
    let solver_next_action_mask: i64 = 31
    let ready_for_promotion_mask: i64 = 0
    let ok_mask: i64 = 255

    if audit_fp != 529164708 { return 2 }
    if instance_fp != 364918255 { return 3 }
    if certificate_fp != 971203684 { return 4 }
    if discharge_obligation_mask != 255 { return 5 }
    if required_child_discharge_proof_mask != 255 { return 6 }
    if required_boundary_gluing_mask != 31 { return 7 }
    if required_finite_cover_certificate_mask != 15 { return 8 }
    if required_global_claim_review_mask != 15 { return 9 }
    if missing_discharge_proof_mask != 255 { return 10 }
    if missing_certificate_proof_mask != 15 { return 11 }
    if solver_next_action_mask != 31 { return 12 }
    if ready_for_promotion_mask != 0 { return 13 }
    if ok_mask != 255 { return 14 }

    let wrong_guard = child4_discharge_obligation_bundle_check(
        1, 312489670, 938615204, 405118337, 31, 0, 255, 0, 0, 0, 0, 77)
    if wrong_guard != 0 - 1 { return 15 }

    let fake_ready = child4_discharge_obligation_bundle_check(
        657240918, 312489670, 938615204, 405118337, 31, 0, 0, 0, 0, 0, 0, 77)
    if fake_ready != 0 - 1 { return 16 }

    let fake_promotion = child4_discharge_obligation_bundle_check(
        657240918, 312489670, 938615204, 405118337, 31, 0, 255, 1, 0, 0, 0, 77)
    if fake_promotion != 0 - 1 { return 17 }

    let fake_global = child4_discharge_obligation_bundle_check(
        657240918, 312489670, 938615204, 405118337, 31, 0, 255, 0, 0, 0, 1, 77)
    if fake_global != 0 - 1 { return 18 }

    return 0
}
