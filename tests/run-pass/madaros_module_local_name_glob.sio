//@ run-pass
//@ requires: madaros
//@ expect-stdout: GLOB_ENERGY=-7.250000
//@ expect-stdout: GLOB_SCALE=10.000000
//@ expect-stdout: A_TWICE=3.000000
//@ description: #2773 -- a glob import binds to the globbed module's same-named pub fns, not the first-loaded module's.
//
// Only nr_b is globbed; nr_a (loaded first, so it keeps the bare names) is
// imported for one unrelated fn. Before #2773: GLOB_ENERGY=1.5, GLOB_SCALE=2.0.
//
// Madaros only; lean_single still binds first-loaded (#2773, KNOWN_LIMITATIONS).
use testmod::nr_a::{nr_a_twice}
use testmod::nr_b::*

fn main() -> i32 with IO {
    print("GLOB_ENERGY=")
    print_f64(nr_energy())
    println("")
    print("GLOB_SCALE=")
    print_f64(nr_scale())
    println("")
    print("A_TWICE=")
    print_f64(nr_a_twice())
    println("")
    0
}
