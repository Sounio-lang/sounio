//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 enclosure validator guard preserves non-claim masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1381
    fp = mix(fp, 5, 5171)
    fp = mix(fp, 225293164, 5171)
    fp = mix(fp, 897523976, 5171)
    fp = mix(fp, 989883403, 5171)
    fp = mix(fp, 815806077, 5171)
    fp = mix(fp, 69995750, 5171)
    fp = mix(fp, 1000000, 5171)
    fp = mix(fp, 279000, 5171)
    fp = mix(fp, 370000, 5171)
    fp = mix(fp, 50000, 5171)
    fp = mix(fp, 242489, 5171)
    fp = mix(fp, 319183, 5171)
    fp = mix(fp, 42444, 5171)
    fp = mix(fp, 35793, 5171)
    fp = mix(fp, 50535, 5171)
    fp = mix(fp, 7132, 5171)
    fp = mix(fp, 7, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 8, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 658127438 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1399
    fp = mix(fp, instance, 5179)
    fp = mix(fp, 278282, 5179)
    fp = mix(fp, 369718, 5179)
    fp = mix(fp, 49576, 5179)
    fp = mix(fp, 279000, 5179)
    fp = mix(fp, 370000, 5179)
    fp = mix(fp, 50000, 5179)
    fp = mix(fp, 7, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 8, 5179)
    fp = mix(fp, ok_mask, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 658127438 { return 0 - 1 }
    if certificate != 85740445 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1409
    fp = mix(fp, instance, 5189)
    fp = mix(fp, certificate, 5189)
    fp = mix(fp, 9, 5189)
    fp = mix(fp, 5, 5189)
    fp = mix(fp, 7, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 8, 5189)
    fp = mix(fp, ok_mask, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    return fp
}

fn enclosure_guard_mask() -> i64 {
    let x_need_ppm: i64 = 278282
    let y_need_ppm: i64 = 369718
    let z_need_ppm: i64 = 49576
    let x_margin_ppm: i64 = 279000
    let y_margin_ppm: i64 = 370000
    let z_margin_ppm: i64 = 50000
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0

    var pass_mask: i64 = 0
    if x_need_ppm <= x_margin_ppm { pass_mask = pass_mask + 1 }
    if y_need_ppm <= y_margin_ppm { pass_mask = pass_mask + 2 }
    if z_need_ppm <= z_margin_ppm { pass_mask = pass_mask + 4 }

    var ok_mask: i64 = 0
    if 225293164 > 0 {
        if 989883403 > 0 { ok_mask = ok_mask + 1 }
    }
    if x_need_ppm == 242489 + 35793 {
        if y_need_ppm == 319183 + 50535 {
            if z_need_ppm == 42444 + 7132 { ok_mask = ok_mask + 2 }
        }
    }
    if pass_mask == 7 { ok_mask = ok_mask + 4 }
    if validated_mask == 0 { ok_mask = ok_mask + 8 }
    if x_margin_ppm - x_need_ppm == 718 {
        if y_margin_ppm - y_need_ppm == 282 {
            if z_margin_ppm - z_need_ppm == 424 { ok_mask = ok_mask + 16 }
        }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if local_containment_mask == 0 { ok_mask = ok_mask + 64 }
    if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = enclosure_guard_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 658127438 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 85740445 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 40755632 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
