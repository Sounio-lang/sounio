//@ run-pass
//@ description: Scalar LRAT binary-resolution unit proof step smoke

fn clause_active(id: i64, deleted1: i64, deleted2: i64, added3: i64) -> i64 {
    if id == 1 {
        if deleted1 == 0 { return 1 }
        return 0
    }
    if id == 2 {
        if deleted2 == 0 { return 1 }
        return 0
    }
    if id == 3 { return added3 }
    return 0
}

fn clause_len(id: i64) -> i64 {
    if id == 1 { return 2 }
    if id == 2 { return 2 }
    if id == 3 { return 1 }
    return 0 - 1
}

fn clause_lit(id: i64, pos: i64) -> i64 {
    if id == 1 {
        if pos == 0 { return 1 }
        if pos == 1 { return 2 }
    }
    if id == 2 {
        if pos == 0 { return 0 - 1 }
        if pos == 1 { return 2 }
    }
    if id == 3 {
        if pos == 0 { return 2 }
    }
    return 0
}

fn other_lit2(id: i64, pivot: i64, deleted1: i64, deleted2: i64,
              added3: i64) -> i64 {
    if clause_active(id, deleted1, deleted2, added3) == 0 { return 0 }
    if clause_len(id) != 2 { return 0 }
    let a = clause_lit(id, 0)
    let b = clause_lit(id, 1)
    if a == pivot { return b }
    if b == pivot { return a }
    return 0
}

fn check_binary_resolution_unit(left_id: i64, right_id: i64,
                                pivot_lit: i64, resolvent_lit: i64,
                                deleted1: i64, deleted2: i64,
                                added3: i64) -> i64 {
    if pivot_lit == 0 { return 0 }
    if resolvent_lit == 0 { return 0 }
    if other_lit2(left_id, pivot_lit, deleted1, deleted2, added3) != resolvent_lit {
        return 0
    }
    if other_lit2(right_id, 0 - pivot_lit, deleted1, deleted2, added3) != resolvent_lit {
        return 0
    }
    return 1
}

fn can_add_id(id: i64, used3: i64) -> i64 {
    if id <= 0 { return 0 }
    if id == 1 { return 0 }
    if id == 2 { return 0 }
    if id == 3 {
        if used3 == 1 { return 0 }
    }
    return 1
}

fn add_binary_resolution_unit(id: i64, left_id: i64, right_id: i64,
                              pivot_lit: i64, resolvent_lit: i64,
                              deleted1: i64, deleted2: i64,
                              used3: i64) -> i64 {
    if can_add_id(id, used3) == 0 { return 0 }
    if check_binary_resolution_unit(left_id, right_id, pivot_lit, resolvent_lit,
                                    deleted1, deleted2, used3) == 0 { return 0 }
    return 1
}

fn main() -> i64 {
    // Clauses 1=(x OR y) and 2=(-x OR y) resolve on x to derive y.
    if check_binary_resolution_unit(1, 2, 1, 2, 0, 0, 0) != 1 { return 1 }
    if check_binary_resolution_unit(2, 1, 0 - 1, 2, 0, 0, 0) != 1 { return 2 }
    if add_binary_resolution_unit(3, 1, 2, 1, 2, 0, 0, 0) != 1 { return 3 }

    if check_binary_resolution_unit(1, 2, 1, 1, 0, 0, 0) != 0 { return 4 }
    if check_binary_resolution_unit(1, 2, 2, 1, 0, 0, 0) != 0 { return 5 }
    if check_binary_resolution_unit(1, 2, 0, 2, 0, 0, 0) != 0 { return 6 }
    if check_binary_resolution_unit(1, 2, 1, 0, 0, 0, 0) != 0 { return 7 }
    if check_binary_resolution_unit(1, 2, 1, 2, 1, 0, 0) != 0 { return 8 }
    if check_binary_resolution_unit(1, 2, 1, 2, 0, 1, 0) != 0 { return 9 }
    if add_binary_resolution_unit(1, 1, 2, 1, 2, 0, 0, 0) != 0 { return 10 }
    if add_binary_resolution_unit(3, 1, 2, 1, 2, 0, 0, 1) != 0 { return 11 }

    return 0
}
