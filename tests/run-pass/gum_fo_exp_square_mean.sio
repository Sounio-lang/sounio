//@ run-pass
//@ requires: madaros
//@ expect-stdout: val 12.180705
//@ expect-stdout: mone 14.285865
//@ expect-stdout: msq 14.122522
//@ expect-stdout: vone 76.639194
//@ expect-stdout: vsq 47.305391
//@ expect-stdout: EXP_SQUARE_MEAN_OK
// exp(L) and exp(L/2)*exp(L/2) are the same value.
// second_order_mean(exp(L)) is the lognormal moment p*exp(s/2).
// The product uses f + (1/2)*H*sigma^2, which for this map is p*(1 + s/2).
// Before the inner exp stopped leaking its lognormal flag, the product
// printed 3.631991.

var R_GAS: f64 = 8.314462618
var T_HOT: f64 = 353.15
var DH: f64 = 30800.0
var DS: f64 = 108.0
var U_DH: f64 = 1500.0
var U_DS: f64 = 2.0

fn ln_p(dh: f64, ds: f64) -> f64 {
    ds / R_GAS - dh / (R_GAS * T_HOT)
}

fn p_one(dh: f64, ds: f64) -> f64 {
    exp(ln_p(dh, ds))
}

fn half(dh: f64, ds: f64) -> f64 {
    exp(ln_p(dh, ds) / 2.0)
}

fn s_ln2() -> f64 {
    let a = U_DS / R_GAS
    let b = U_DH / (R_GAS * T_HOT)
    a * a + b * b
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i64 with IO, Epistemic {
    let dh0: f64 = DH
    let ds0: f64 = DS
    let hk: Knowledge<f64> = measure(dh0, uncertainty: U_DH)
    let sk: Knowledge<f64> = measure(ds0, uncertainty: U_DS)
    let dh = hk.value
    let ds = sk.value
    let h = half(dh, ds)
    let sq = h * h
    let one = p_one(dh, ds)
    let mone = second_order_mean(one)
    let msq = second_order_mean(sq)
    let vone = variance_of(one)
    let vsq = variance_of(sq)
    let p0 = p_one(DH, DS)
    let sl2 = s_ln2()
    let e_sl = exp(sl2)
    let mean_logn = p0 * exp(0.5 * sl2)
    let mean_taylor = p0 * (1.0 + 0.5 * sl2)
    let var_logn = p0 * p0 * e_sl * (e_sl - 1.0)
    let var_lin = p0 * p0 * sl2
    print("val ")
    print_f64(sq)
    println("")
    print("mone ")
    print_f64(mone)
    println("")
    print("msq ")
    print_f64(msq)
    println("")
    print("vone ")
    print_f64(vone)
    println("")
    print("vsq ")
    print_f64(vsq)
    println("")
    var fails: i64 = 0
    if !near(sq, p0, 0.000001) { fails = fails + 1 }
    if !near(one, p0, 0.000001) { fails = fails + 1 }
    if !near(mone, mean_logn, 0.000001) { fails = fails + 1 }
    if !near(msq, mean_taylor, 0.000001) { fails = fails + 1 }
    if !near(vone, var_logn, 0.00001) { fails = fails + 1 }
    if !near(vsq, var_lin, 0.00001) { fails = fails + 1 }
    if fails == 0 {
        println("EXP_SQUARE_MEAN_OK")
        0
    } else {
        println("EXP_SQUARE_MEAN_FAIL")
        1
    }
}
