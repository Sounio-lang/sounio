//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_CALL_TWICE_DISJOINT_PASS
//
// Prediction (source identity across calls, aleatory disjoint):
// `twice(a)` carries `{a}` (opaque) and `twice(b)` carries `{b}` (opaque).
// Because `a` and `b` are disjoint, `twice(a) + twice(b)` must be accepted
// and compute value = 30.0, variance = 4*1 + 4*4 = 20.0.

fn twice(x: Knowledge<f64>) -> Knowledge<f64> {
    x * 2.0
}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 2.0)
    let s = twice(a) + twice(b)
    var dv = s.value - 30.0
    if dv < 0.0 { dv = 0.0 - dv }
    var dvar = s.variance - 20.0
    if dvar < 0.0 { dvar = 0.0 - dvar }
    if dv > 1.0e-12 || dvar > 1.0e-12 {
        return 1
    }
    println("IDENT_CALL_TWICE_DISJOINT_PASS")
    0
}
