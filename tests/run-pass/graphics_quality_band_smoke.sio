//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_band_raster_smooth, quality_band_plot_config_default}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(84, 84)
    var xs: [f64; 256] = [0.0; 256]
    var low: [f64; 256] = [0.0; 256]
    var high: [f64; 256] = [0.0; 256]

    xs[0] = 0.0
    low[0] = 0.20
    high[0] = 0.45
    xs[1] = 1.0
    low[1] = 0.30
    high[1] = 0.62
    xs[2] = 2.0
    low[2] = 0.24
    high[2] = 0.74
    xs[3] = 3.0
    low[3] = 0.34
    high[3] = 0.68
    xs[4] = 4.0
    low[4] = 0.28
    high[4] = 0.52

    s = plot_band_raster_smooth(s, &xs, &low, &high, 5, quality_band_plot_config_default())

    var filled_pixels = 0
    var y = 28
    while y <= 52 {
        var x = 32
        while x <= 52 {
            let r = surface_get_pixel_r(&s, x, y)
            let g = surface_get_pixel_g(&s, x, y)
            let b = surface_get_pixel_b(&s, x, y)
            if r < 255 && g < 255 && b < 255 {
                filled_pixels = filled_pixels + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if filled_pixels < 80 {
        print("FAIL uncertainty band fill missing\n")
        return 1
    }

    var outline_pixels = 0
    y = 20
    while y <= 60 {
        var x2 = 20
        while x2 <= 64 {
            let r2 = surface_get_pixel_r(&s, x2, y)
            let g2 = surface_get_pixel_g(&s, x2, y)
            let b2 = surface_get_pixel_b(&s, x2, y)
            if r2 < 80 && g2 < 140 && b2 < 160 && b2 > r2 {
                outline_pixels = outline_pixels + 1
            }
            x2 = x2 + 1
        }
        y = y + 1
    }
    if outline_pixels < 18 {
        print("FAIL uncertainty band outlines missing\n")
        return 2
    }

    var outside_pixels = 0
    y = 0
    while y < 16 {
        var x3 = 0
        while x3 < 84 {
            if surface_get_pixel_g(&s, x3, y) < 240 {
                outside_pixels = outside_pixels + 1
            }
            x3 = x3 + 1
        }
        y = y + 1
    }
    if outside_pixels > 4 {
        print("FAIL uncertainty band painted outside plot area\n")
        return 3
    }

    print("PASS graphics_quality_band_smoke\n")
    0
}
