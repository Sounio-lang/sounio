//@ run-pass
//@ expect-stdout: syscall ffi ok
fn main() -> i32 with IO, Panic {
    let path = "/tmp/sounio_syscall_ffi.txt"
    let msg = "hello from syscall6\n"
    let fd = syscall6(2, path, 577, 420, 0, 0, 0)
    assert(fd > 0)
    let wrote = syscall6(1, fd, msg, 20, 0, 0, 0)
    assert(wrote == 20)
    let closed = syscall6(3, fd, 0, 0, 0, 0, 0)
    assert(closed == 0)
    let contents = read_file(path)
    assert(str_eq(contents, msg))
    print("syscall ffi ok\n")
    0
}
