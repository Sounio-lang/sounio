//@ run-pass
//@ expect-stdout: LET_MATCH_SOME_PAYLOAD_TYPED_OK
// #2966 (gen3 ud2 in lower_fn_def_is_transparent_hof_ast): `let first = match
// h.list { Some(pl) => pl, None => .. }` yields the Box payload itself, but the
// arm binding is out of scope once lowered, so `first` stayed untyped and
// `(*first).head` did not take the Box field-0 read. The let path now types
// such a local as Box<T> from the scrutinee's Option<Box<T>>.
struct Item {
    tag: i64,
    weight: i64,
}

struct ItemList {
    head: Item,
    tail: Option<Box<ItemList> >,
}

struct Holder {
    pad: i64,
    list: Option<Box<ItemList> >,
}

fn first_two(h: &Holder) -> i64 with Mut, Panic, Div {
    let first = match (*h).list {
        Some(pl) => pl,
        None => { return 0 - 1 }
    }
    var total = (*first).head.weight
    var rest = (*first).tail
    match rest {
        Some(r) => { total = total + (*r).head.weight }
        None => {}
    }
    total
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let l2 = ItemList { head: Item { tag: 2, weight: 30 }, tail: None }
    let l1 = ItemList { head: Item { tag: 1, weight: 12 }, tail: Some(Box::new(l2)) }
    let h = Holder { pad: 7, list: Some(Box::new(l1)) }
    let s = first_two(&h)
    if s == 42 {
        println("LET_MATCH_SOME_PAYLOAD_TYPED_OK")
        return 0
    }
    print("LET_MATCH_SOME_PAYLOAD_TYPED_FAIL s=")
    print_int(s)
    println("")
    return 1
}
