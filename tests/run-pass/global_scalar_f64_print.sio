//@ run-pass
// Scalar global f64 must print via print_f64 under Madaros (not char* → SEGV).
// Residual after #1325 (array index path only).
//@ requires: madaros
//@ expect-stdout: 1.500000
//@ expect-stdout: 42
//@ expect-stdout: SCALAR_F64_PRINT_OK

var G: f64 = 1.5
var N: i64 = 42

fn main() -> i64 with IO {
    print(G)
    print("\n")
    println(G)
    print(N)
    print("\n")
    println(N)
    if G != 1.5 { return 1 }
    if N != 42 { return 2 }
    print("SCALAR_F64_PRINT_OK\n")
    0
}
