//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_FREEFN_FIELD_PASS

// Free-fn struct-arg field FO (symmetric to method self.field).
//   clearance_of(pk, η) = p.cl0 * exp(η)
//   css_of(make_pk(...), ...) via free nested helpers

struct Pk {
    cl0: f64
    v0: f64
}

fn make_pk(cl0: f64, v0: f64) -> Pk {
    Pk { cl0: cl0, v0: v0 }
}

fn clearance_of(p: Pk, eta: f64) -> f64 {
    p.cl0 * exp(eta)
}

fn rate_of(f: f64, dose: f64, tau: f64) -> f64 {
    (f * dose) / tau
}

fn css_of(p: Pk, f: f64, dose: f64, tau: f64, eta: f64) -> f64 {
    rate_of(f, dose, tau) / clearance_of(p, eta)
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let f = kF.value
    let dose = kDose.value
    let cl0 = kCL0.value
    let eta = kEta.value
    let tau = 12.0

    let pk_lit = Pk { cl0: cl0, v0: 50.0 }
    let v_lit = variance_of(clearance_of(pk_lit, eta))
    let v_call = variance_of(clearance_of(make_pk(cl0, 50.0), eta))
    let pk = make_pk(cl0, 50.0)
    let v_alias = variance_of(clearance_of(pk, eta))
    let v_peel = variance_of(cl0 * exp(eta))

    let v_css_call = variance_of(css_of(make_pk(cl0, 50.0), f, dose, tau, eta))
    let v_css_peel = variance_of(((f * dose) / tau) / (cl0 * exp(eta)))
    let m2_css = second_order_mean(css_of(make_pk(cl0, 50.0), f, dose, tau, eta))

    print("v_lit="); print_f64(v_lit); print("\n")
    print("v_call="); print_f64(v_call); print("\n")
    print("v_alias="); print_f64(v_alias); print("\n")
    print("v_css_call="); print_f64(v_css_call); print("\n")
    print("m2_css="); print_f64(m2_css); print("\n")

    let ok = abs_f(v_lit - v_peel) < 1.0e-9
        && abs_f(v_call - v_peel) < 1.0e-9
        && abs_f(v_alias - v_peel) < 1.0e-9
        && abs_f(v_lit - 0.34) < 1.0e-4
        && abs_f(v_css_call - v_css_peel) < 1.0e-9
        && abs_f(v_css_call - 0.795833) < 1.0e-4
        && abs_f(m2_css - 6.724) < 1.0e-3
    if ok {
        print("MADAROS_GUM_FO_FREEFN_FIELD_PASS\n")
    } else {
        print("MADAROS_GUM_FO_FREEFN_FIELD_FAIL\n")
    }
}
