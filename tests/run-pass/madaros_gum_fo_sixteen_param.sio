//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_SIXTEEN_PARAM_PASS

// Bold FO: pure helpers with up to 16 parameters (was 8).
// Multi-factor sum/product through inter-procedural FO bytecode.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn ten_sum(
    a: f64, b: f64, c: f64, d: f64, e: f64,
    f: f64, g: f64, h: f64, i: f64, j: f64
) -> f64 {
    a + b + c + d + e + f + g + h + i + j
}

fn sixteen_sum(
    a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64,
    i: f64, j: f64, k: f64, l: f64, m: f64, n: f64, o: f64, p: f64
) -> f64 {
    a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p
}

fn main() with IO, Mut, Div, Epistemic {
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k1: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k2: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k3: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k4: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k5: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k6: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k7: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k8: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k9: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k10: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k11: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k12: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k13: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k14: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k15: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let a = k0.value
    let b = k1.value
    let c = k2.value
    let d = k3.value
    let e = k4.value
    let f = k5.value
    let g = k6.value
    let h = k7.value
    let i = k8.value
    let j = k9.value
    let k = k10.value
    let l = k11.value
    let m = k12.value
    let n = k13.value
    let o = k14.value
    let p = k15.value

    // 10 independent unit vars: Var = 10 * 0.0025 = 0.025
    let v10 = variance_of(ten_sum(a, b, c, d, e, f, g, h, i, j))
    // 16-sum: 16 * 0.0025 = 0.04
    let v16 = variance_of(sixteen_sum(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p))

    print("v10="); print_f64(v10); print("\n")
    print("v16="); print_f64(v16); print("\n")

    let ok = abs_f(v10 - 0.025) < 1.0e-9
        && abs_f(v16 - 0.04) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_SIXTEEN_PARAM_PASS\n")
    } else {
        print("MADAROS_GUM_FO_SIXTEEN_PARAM_FAIL\n")
    }
}
