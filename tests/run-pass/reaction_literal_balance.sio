//@ run-pass
//@ expect-stdout: reactions balanced

reaction sulfate_reduction {
    4 H2(aq) + H+ + SO4-- -> HS- + 4 H2O
}

reaction methanogenesis {
    HCO3- + 4 H2(aq) + H+ -> CH4(aq) + 3 H2O
}

reaction calcite_dissolution {
    CaCO3 + H+ -> Ca++ + HCO3-
}

reaction dolomite_dissolution {
    CaMg(CO3)2 + 2 H+ -> Ca++ + Mg++ + 2 HCO3-
}

reaction bicarbonate_dissociation {
    HCO3- -> H+ + CO3--
}

reaction hydrogen_dissolution {
    H2(g) -> H2(aq)
}

fn main() with IO {
    println("reactions balanced")
}
