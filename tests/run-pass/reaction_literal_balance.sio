//@ run-pass
//@ expect-stdout: reactions balanced
// Compile-time mass and charge balance for chemical reaction literals.
//
// Every reaction below is transcribed unchanged from the reference material
// this feature exists to serve, and every balance is verified by hand in the
// comment above it. The declarations emit no code; reaching main at all is the
// evidence that Pass 0a accepted them.
//
// This checks CONSERVATION ONLY. Nothing here asserts that a reaction is
// thermodynamically favourable, elementary, written in the direction it runs,
// or that any rate law attached to it is sound.

// Verbatim from the USGS AuxVases GWB React script (kinetic microbe-SRB):
//   H  left 4x2 + 1 = 9   right 1 + 4x2 = 9
//   S  left 1            right 1
//   O  left 4            right 4
//   charge  left (+1) + (-2) = -1   right -1
reaction sulfate_reduction {
    4 H2(aq) + H+ + SO4-- -> HS- + 4 H2O
}

// Verbatim from the same script (kinetic microbe-MET):
//   H  left 1 + 4x2 + 1 = 10   right 4 + 3x2 = 10
//   C  left 1                  right 1
//   O  left 3                  right 3
//   charge  left (-1) + (+1) = 0   right 0
reaction methanogenesis {
    HCO3- + 4 H2(aq) + H+ -> CH4(aq) + 3 H2O
}

// Calcite dissolution, the mineral at the centre of the coupled study:
//   Ca 1/1   C 1/1   O 3/3   H 1/1   charge +1 / (+2-1) = +1
reaction calcite_dissolution {
    CaCO3 + H+ -> Ca++ + HCO3-
}

// Dolomite dissolution (Palandri-Kharaka). Exercises a parenthesised
// multiplier group, which is NOT a phase suffix: (CO3)2 counts C 2, O 6.
//   Ca 1/1   Mg 1/1   C 2/2   O 6/6   H 2/2
//   charge  left +2   right (+2) + (+2) + 2x(-1) = +2
reaction dolomite_dissolution {
    CaMg(CO3)2 + 2 H+ -> Ca++ + Mg++ + 2 HCO3-
}

// Bicarbonate dissociation:  H 1/1  C 1/1  O 3/3  charge -1 / (+1-2) = -1
reaction bicarbonate_dissociation {
    HCO3- -> H+ + CO3--
}

// Phase is part of species identity — H2(aq) and H2(g) are different species —
// but phase carries no mass and no charge, so it does not enter the balance.
//   H 2/2   charge 0/0
reaction hydrogen_dissolution {
    H2(g) -> H2(aq)
}

fn main() with IO {
    println("reactions balanced")
}
