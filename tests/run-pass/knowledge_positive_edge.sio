//@ run-pass
//@ requires: madaros
//@ expect-stdout: cold 1
//@ expect-stdout: mild 1
//@ expect-stdout: POSITIVE_EDGE_OK
// ln(P/100) = -1000/T. At 1 K the exponential underflows and the band
// is the point 0-0. At 20 K the pressure is small and still positive.

use epistemic::regression::plateau_pressure

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 400.0
    xs[1] = 1.0 / 450.0
    xs[2] = 1.0 / 500.0
    xs[3] = 1.0 / 550.0
    ys[0] = 0.0 - 1000.0 / 400.0
    ys[1] = 0.0 - 1000.0 / 450.0
    ys[2] = 0.0 - 1000.0 / 500.0
    ys[3] = 0.0 - 1000.0 / 550.0
    uln[0] = 0.2
    uln[1] = 0.2
    uln[2] = 0.2
    uln[3] = 0.2
    let cold = plateau_pressure(xs, ys, uln, 4, 1.0 / 1.0, 100.0)
    let mild = plateau_pressure(xs, ys, uln, 4, 1.0 / 20.0, 100.0)
    let cold_blank = !cold.open && !cold.refused && !(cold.lo == cold.lo) && !(cold.hi == cold.hi) && !(cold.lo == 0.0)
    let mild_ok = mild.open && mild.lo > 0.0 && mild.hi > mild.lo
    print("cold ")
    print_int(bit(cold_blank))
    println("")
    print("mild ")
    print_int(bit(mild_ok))
    println("")
    if cold_blank && mild_ok {
        println("POSITIVE_EDGE_OK")
        return 0
    }
    println("POSITIVE_EDGE_FAIL")
    1
}
