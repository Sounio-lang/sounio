//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v28 smoke for LRAT deletion lifecycle receipt

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 31 { return 0 - 1 }
    if instance_fp != 6950141 { return 0 - 1 }
    if certificate_fp != 9126320 { return 0 - 1 }
    if result_code != 0 { return 0 - 1 }
    if checker_code != 31 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn lifecycle_instance_fingerprint(original_clause_count: i64,
                                  derived_clause_count: i64,
                                  delete_count: i64,
                                  first_derived_id: i64,
                                  final_clause_id: i64,
                                  final_clause_len: i64) -> i64 with Mod {
    if original_clause_count != 3 { return 0 - 1 }
    if derived_clause_count != 2 { return 0 - 1 }
    if delete_count != 2 { return 0 - 1 }
    if first_derived_id != 4 { return 0 - 1 }
    if final_clause_id != 5 { return 0 - 1 }
    if final_clause_len != 0 { return 0 - 1 }

    var fp: i64 = 197
    fp = portfolio_mix(fp, original_clause_count, 2371)
    fp = portfolio_mix(fp, derived_clause_count, 2371)
    fp = portfolio_mix(fp, delete_count, 2371)
    fp = portfolio_mix(fp, first_derived_id, 2371)
    fp = portfolio_mix(fp, final_clause_id, 2371)
    fp = portfolio_mix(fp, final_clause_len, 2371)
    return fp
}

fn lifecycle_certificate_fingerprint(manifest_fp: i64,
                                     audit_fp: i64,
                                     final_clause_id: i64,
                                     final_clause_len: i64,
                                     delete_count: i64,
                                     lrat_empty_seen: i64) -> i64 with Mod {
    if manifest_fp != 6950141 { return 0 - 1 }
    if audit_fp != 109354544 { return 0 - 1 }
    if final_clause_id != 5 { return 0 - 1 }
    if final_clause_len != 0 { return 0 - 1 }
    if delete_count != 2 { return 0 - 1 }
    if lrat_empty_seen != 1 { return 0 - 1 }

    var fp: i64 = 211
    fp = portfolio_mix(fp, manifest_fp, 2399)
    fp = portfolio_mix(fp, audit_fp, 2399)
    fp = portfolio_mix(fp, final_clause_id, 2399)
    fp = portfolio_mix(fp, final_clause_len, 2399)
    fp = portfolio_mix(fp, delete_count, 2399)
    fp = portfolio_mix(fp, lrat_empty_seen, 2399)
    return fp
}

fn portfolio_v28_manifest_fingerprint(lifecycle_entry_fp: i64) -> i64 with Mod {
    if lifecycle_entry_fp != 620031252 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 28, 1151)
    fp = portfolio_mix(fp, 32, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
