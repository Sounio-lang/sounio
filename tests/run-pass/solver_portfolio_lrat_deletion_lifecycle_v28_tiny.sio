    fp = portfolio_mix(fp, 423305090, 1151)
    fp = portfolio_mix(fp, 63872871, 1151)
    fp = portfolio_mix(fp, 547731575, 1151)
    fp = portfolio_mix(fp, lifecycle_entry_fp, 1151)
    return fp
}

fn portfolio_v28_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 380302392 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 28, 1871)
    fp = portfolio_mix(fp, 32, 1871)
    fp = portfolio_mix(fp, 10, 1871)
    fp = portfolio_mix(fp, 20, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v28_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 380302392 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 28, 1907)
    fp = portfolio_mix(fp, 32, 1907)
    fp = portfolio_mix(fp, 6, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 20, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v28_readiness_fingerprint(manifest_fp: i64,
                                       result_coverage_fp: i64,
                                       family_coverage_fp: i64,
                                       acceptance_receipt_fp: i64,
                                       audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 380302392 { return 0 - 1 }
    if result_coverage_fp != 184362635 { return 0 - 1 }
    if family_coverage_fp != 644841534 { return 0 - 1 }
    if acceptance_receipt_fp != 790802629 { return 0 - 1 }
    if audit_receipt_fp != 16072096 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 28, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = lifecycle_instance_fingerprint(3, 2, 2, 4, 5, 0)
    if instance_fp != 6950141 { return 1 }

    let certificate_fp = lifecycle_certificate_fingerprint(instance_fp, 109354544, 5, 0, 2, 1)
    if certificate_fp != 9126320 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(31, instance_fp, certificate_fp, 0, 31)
    if entry_fp != 620031252 { return 3 }

    let manifest_fp = portfolio_v28_manifest_fingerprint(entry_fp)
    if manifest_fp != 380302392 { return 4 }

    let result_coverage_fp = portfolio_v28_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 184362635 { return 5 }

    let family_coverage_fp = portfolio_v28_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 644841534 { return 6 }

    if portfolio_v28_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        790802629, 16072096) != 413118064 { return 7 }

    if lifecycle_certificate_fingerprint(instance_fp, 109354544, 5, 0, 1, 1) != (0 - 1) { return 8 }
    if portfolio_entry_fingerprint(31, instance_fp, certificate_fp, 1, 31) != (0 - 1) { return 9 }
    if portfolio_v28_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 10 }
    if portfolio_v28_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        790802629, 16072097) != (0 - 1) { return 11 }

    return 0
}
