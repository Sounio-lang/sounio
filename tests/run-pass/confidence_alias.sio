//@ run-pass
// Gen 21 A″: Confidence(N) must be a live parser alias for Epistemic(N).
// Same FN_EPISTEMIC_MIN slot, same bit 512 in FN_EFFECTS.

fn certain_pure() -> i64 with Confidence(950) {
    let a: i64 = 1
    let b: i64 = 2
    a + b
}

fn main() with IO, Confidence(950) {
    let r = certain_pure()
    if r == 3 {
        print("CONFIDENCE_ALIAS_OK\n")
    } else {
        print("CONFIDENCE_ALIAS_FAIL\n")
    }
}
