//@ run-pass
//@ expect-stdout: soma = 10.000000
// causal_graph_dsep.sio
//
// A causal graph declared in source, and independence claims discharged against
// it by d-separation. Before this the claim was only checked for degeneracy: it
// could be written, never proven, and the composition law in
// stdlib/epistemic/graded_effects.sio would grant the tighter uncertainty bound
// to anything that type-checked.
//
//   `->`  a directed cause
//   `<->` an unmeasured common cause (confounding)
//
// Every claim below HOLDS in this graph, so the file compiles. The ones that do
// not hold are in tests/compile-fail/dsep_*.sio — including the case that makes
// d-separation more than a reachability check: conditioning on a collider OPENS
// a path instead of blocking it.

causal graph mundo {
    // Time of day drives both the body and the sky measurement. This is the
    // confounder pre-registered as D4 in HELIO-N1, and it is exactly why
    // hrv ⊥ kp is false while hrv ⊥ kp | hora is true.
    hora -> hrv
    hora -> kp

    // Pain and sleep both drive whether a note gets written: a collider.
    dor -> registro
    sono -> registro
    registro -> alerta

    // Heart rate and its variability share an unmeasured common cause.
    fc <-> hrv
}

fn main() -> i64 with IO {
    // Fork, blocked by conditioning on the shared cause.
    let a: IndepKnowledge<f64, hrv, kp | hora> = 1.0

    // Collider, left unconditioned: dor and sono are marginally independent.
    // Conditioning here would be the mistake, not the fix.
    let b: IndepKnowledge<f64, dor, sono> = 2.0

    // Chain hora -> hrv is direct, but hora and alerta have no open path at all.
    let c: IndepKnowledge<f64, hora, alerta> = 3.0

    // Order inside the conditioning set carries no meaning.
    let d: IndepKnowledge<f64, hrv, kp | {hora}> = 4.0

    // The claim is transparent to T: it is an obligation on the program, not a
    // value the program carries.
    //
    // The sum is PRINTED and checked by the harness rather than compared against
    // literals in this file. An earlier version compared `soma` to 9.5 and 10.5,
    // and when a compiler bug zeroed every literal after the graph block the
    // bounds were zeroed too: 0 < 0 || 0 > 0 is false, so the test passed while
    // measuring nothing. A test whose expected values travel the same corrupted
    // channel as the values under test cannot fail.
    let soma = a + b + c + d
    print("soma = ")
    println(soma)

    println("OK: d-separacao descarrega a alegacao contra o grafo declarado")
    println("  bifurcacao bloqueada por | hora")
    println("  colisor deixado sem condicionamento")
    0
}
