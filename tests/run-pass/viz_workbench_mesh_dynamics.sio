// tests/run-pass/viz_workbench_mesh_dynamics.sio - Workbench time-driven 3D mesh proof
//
// Expected output includes:
//   <!-- mesh slot=0 n=2 time-ms=5000 v0x-milli=-370 ... -->
//   VIZ_WORKBENCH_MESH_DYNAMICS_PASS

use display::canvas::{Canvas}
use display::event::{Event, EV_MOUSE_PRESS, EV_MOTION, MOUSE_LEFT}
use viz::audit::{viz_audit_hash}
use viz::ir::{viz_scene_new, VIZ_NODE_MESH}
use viz::viz_app::{viz_app_new, viz_app_render, viz_app_frame_hash}
use viz::viz_html::{viz_html_emit_scene}
use viz::workbench::{
    viz_workbench_build_scene, viz_workbench_constraint,
    viz_workbench_app_handle_event,
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn read_px(c: &Canvas, x: i64, y: i64) -> i64 {
    read_i64(c.pixels, y * c.width + x)
}

fn main() with IO, Alloc, Mut, Div {
    var scene = viz_scene_new()
    let ids = viz_workbench_build_scene(&!scene)
    var constraint = viz_workbench_constraint(&ids)
    var app = viz_app_new(10, 13, 18)
    var c = make_canvas(480, 320)

    assert(scene.nodes[ids.mesh as usize].kind == VIZ_NODE_MESH)
    assert(scene.mesh_count == 1)
    assert(scene.meshes[0].n == 2)
    let initial_v0x = scene.meshes[0].v0x[0]
    let initial_v1x = scene.meshes[0].v1x[0]
    let initial_nx = scene.meshes[0].nx[0]
    let initial_r = scene.meshes[0].base_r[0]
    let initial_audit = viz_audit_hash(&scene)

    viz_app_render(&!app, &!scene, &!c)
    let initial_frame_hash = viz_app_frame_hash(&app, &scene, &c)
    assert(read_px(&c, 370, 160) != 0)

    assert(viz_workbench_app_handle_event(&!app, &!scene, &!constraint, ev(EV_MOUSE_PRESS, MOUSE_LEFT, 46, 238)))
    assert(viz_workbench_app_handle_event(&!app, &!scene, &!constraint, ev(EV_MOTION, 0, 101, 238)))
    assert(scene.time == 5.0)
    assert(scene.meshes[0].n == 2)
    assert(scene.meshes[0].v0x[0] != initial_v0x)
    assert(scene.meshes[0].v1x[0] != initial_v1x)
    assert(scene.meshes[0].nx[0] != initial_nx)
    assert(scene.meshes[0].base_r[0] != initial_r)
    let v0x_milli = (scene.meshes[0].v0x[0] * 1000.0) as i64
    let v1x_milli = (scene.meshes[0].v1x[0] * 1000.0) as i64
    let v2x_milli = (scene.meshes[0].v2x[0] * 1000.0) as i64
    let nx_milli = (scene.meshes[0].nx[0] * 1000.0) as i64
    assert(v0x_milli == 0 - 370)
    assert(v1x_milli == 390)
    assert(v2x_milli == 0)
    assert(nx_milli == 90)
    assert(scene.meshes[0].base_r[0] == 180)
    assert(viz_audit_hash(&scene) != initial_audit)

    viz_app_render(&!app, &!scene, &!c)
    assert(viz_app_frame_hash(&app, &scene, &c) != initial_frame_hash)
    assert(read_px(&c, 370, 160) != 0)

    viz_html_emit_scene(&scene, 480, 320)
    heap_free(c.pixels as *mut i8)
    println("VIZ_WORKBENCH_MESH_DYNAMICS_PASS")
}
