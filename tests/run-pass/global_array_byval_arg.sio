//@ run-pass
//@ expect-stdout: GLOBAL_ARRAY_BYVAL_OK
// SIO-279: a global array passed BY VALUE to a user function (`a: [T; N]`)
// reached the callee as its data address V, and the callee indexed it as an
// object base, 4 words (one object header) late: `first(G)` read G[4], G[5].
// A local array was right, and so was `&G` (the ref path subtracts the header
// for a BSS address). The call site now passes the global's object base,
// V - header, for every parameter recorded as a by-value fixed array.
var G: [i64; 8] = [0; 8]
var F: [f64; 4] = [0.0; 4]
var B: [u8; 8] = [0; 8]

struct Acc { k: i64 }

impl Acc {
    fn weigh(self: &Acc, a: [i64; 8]) -> i64 { self.k * a[0] + a[7] }
}

fn first(a: [i64; 8]) -> i64 { a[0] * 10 + a[1] }

fn total(a: [i64; 8]) -> i64 with Mut, Panic, Div {
    var s: i64 = 0
    var i: i64 = 0
    while i < 8 { s = s + a[i as usize]; i = i + 1 }
    s
}

fn relay(a: [i64; 8]) -> i64 with Mut, Panic, Div { total(a) }

fn fsum(a: [f64; 4]) -> f64 { a[0] + a[1] + a[2] + a[3] }

fn bytes(a: [u8; 8]) -> i64 { (a[0] as i64) * 100 + (a[7] as i64) }

fn main() -> i32 with IO, Mut, Panic, Div {
    var i: i64 = 0
    while i < 8 { G[i as usize] = i + 1; i = i + 1 }
    F[0] = 0.5
    F[1] = 1.5
    F[2] = 2.5
    F[3] = 3.5
    B[0] = 7 as u8
    B[7] = 9 as u8
    let acc = Acc { k: 3 }
    let a = first(G)
    let t = total(G)
    let r = relay(G)
    let w = acc.weigh(G)
    let f = fsum(F)
    let b = bytes(B)
    if a == 12 && t == 36 && r == 36 && w == 11 && f == 8.0 && b == 709 {
        println("GLOBAL_ARRAY_BYVAL_OK")
    } else {
        print("GLOBAL_ARRAY_BYVAL_FAIL ")
        print_int(a); print(" "); print_int(t); print(" "); print_int(r); print(" ")
        print_int(w); print(" "); print_f64(f); print(" "); print_int(b)
        println("")
    }
    0
}
