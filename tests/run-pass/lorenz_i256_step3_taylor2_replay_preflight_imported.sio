//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-3 Taylor-2 replay preflight checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step3_taylor2_replay_preflight_check(
        308150621, 693283321, 15, 15, 15, 15, 6, 0)
    if artifact_fp != 488274627 { return 1 }
    let audit_fp = lorenz_i256_step3_taylor2_replay_preflight_audit_fingerprint(
        artifact_fp, 450583915, 995926925, 308150621, 281860333, 3, 6, 255, 0, 0)
    if audit_fp != 678589210 { return 2 }
    return 0
}
