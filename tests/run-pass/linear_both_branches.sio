//@ run-pass
//@ description: Linear value correctly consumed in all branches

linear struct Resource {
    data: i32,
}

fn release(r: Resource) -> i32 {
    r.data  // consumes resource by reading its data
}

fn process_and_release(r: Resource) -> i32 {
    r.data + 1  // also consumes resource
}

fn main() {
    let r = Resource { data: 100 }
    let cond = true
    let result = if cond {
        release(r)
    } else {
        process_and_release(r)
    }
}
