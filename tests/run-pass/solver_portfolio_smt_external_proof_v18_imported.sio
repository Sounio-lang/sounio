//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v18 SMT external proof reconstruction envelope smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let cert_fp = solver_portfolio_smt_external_proof_certificate_fingerprint(
        796206516, 106325289, 666359709, 1, 1, 1, portfolio_result_unsat())
    if cert_fp != 770769284 { return 1 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_smt_external_proof(),
        106325289,
        cert_fp,
        portfolio_result_unsat(),
        portfolio_checker_smt_alethe_reconstruction())
    if entry_fp != 46718256 { return 2 }

    let manifest_fp = solver_portfolio_v18_smt_external_proof_bundle_fingerprint(
        106325289, cert_fp)
    if manifest_fp != 265423024 { return 3 }

    let result_coverage_fp = solver_portfolio_v18_result_coverage_fingerprint(
        18, 22, 8, 12, 1, 1, manifest_fp)
    if result_coverage_fp != 184063844 { return 4 }

    let family_coverage_fp = solver_portfolio_v18_checker_family_coverage_fingerprint(
        18, 22, 4, 3, 2, 1, 12, manifest_fp)
    if family_coverage_fp != 22024619 { return 5 }

    let acceptance_fp = solver_portfolio_v18_acceptance_receipt_fingerprint(
        18, manifest_fp, result_coverage_fp)
    if acceptance_fp != 563343445 { return 6 }

    let audit_fp = solver_portfolio_v18_audit_receipt_fingerprint(
        18, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 637718997 { return 7 }

    let readiness_fp = solver_portfolio_v18_readiness_fingerprint(
        18, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 958828933 { return 8 }

    if solver_portfolio_smt_external_proof_certificate_fingerprint(
        796206516, 106325289, 666359709, 2, 1, 1,
        portfolio_result_unsat()) != (0 - 1) { return 9 }
    if solver_portfolio_v18_smt_external_proof_bundle_fingerprint(
        106325290, cert_fp) != (0 - 1) { return 10 }
    if solver_portfolio_v18_checker_family_coverage_fingerprint(
        18, 22, 4, 2, 2, 1, 12, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v18_readiness_fingerprint(
        18, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 12 }

    return 0
}
