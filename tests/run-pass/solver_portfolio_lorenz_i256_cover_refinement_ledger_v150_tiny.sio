    audit = mix(audit, 836439604, 6229)
    audit = mix(audit, 8, 6229)
    audit = mix(audit, 8, 6229)
    audit = mix(audit, 0, 6229)
    audit = mix(audit, 31, 6229)
    audit = mix(audit, 7, 6229)
    audit = mix(audit, 15, 6229)
    audit = mix(audit, 0, 6229)
    audit = mix(audit, 0, 6229)
    audit = mix(audit, 1, 6229)
    audit = mix(audit, 29, 6229)
