    manifest = mix(manifest, 527721765, 1151)
    manifest = mix(manifest, 820916947, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 568368767 { return 4 }

    var result: i64 = 131
    result = mix(result, 150, 1871)
    result = mix(result, 154, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 142, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 860734845 { return 5 }

    var family: i64 = 149
    family = mix(family, 150, 1907)
