//@ run-pass
// Test captured-variable closures in lean_single native compiler.
// Verifies: single capture, multi-capture, closure passed to HOF, fn ref wrapping.

fn apply(f: i64, x: i64) -> i64 {
    return f(x)
}

fn sum_map(f: i64) -> i64 with Mut {
    var s: i64 = 0
    var i: i64 = 0
    while i < 5 { s = s + f(i); i = i + 1 }
    return s
}

fn double(x: i64) -> i64 { return x * 2 }

fn main() -> i64 with IO, Mut {
    var pass: i64 = 1

    // Test 1: single capture
    let offset = 100
    let add_offset = |x| x + offset
    if add_offset(5) != 105 { pass = 0 }
    if add_offset(42) != 142 { pass = 0 }

    // Test 2: captured closure passed to HOF
    let scale = 10
    let scaled = |x| x * scale
    let r = sum_map(scaled)
    // (0+1+2+3+4)*10 = 100
    if r != 100 { pass = 0 }

    // Test 3: multiple captures
    let a = 3
    let b = 7
    let f = |x| x * a + b
    if f(4) != 19 { pass = 0 }

    // Test 4: fn ref passed to HOF (uniform closure convention)
    let r2 = sum_map(double)
    // (0+1+2+3+4)*2 = 20
    if r2 != 20 { pass = 0 }

    // Test 5: fn ref via apply
    if apply(double, 7) != 14 { pass = 0 }

    if pass == 1 { print("PASS\n") }
    else { print("FAIL\n") }
    return 0
}
