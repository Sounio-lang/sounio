//@ run-pass
//@ expect-stdout: PASS
// Test captured-variable closures in lean_single native compiler.
// Verifies: single capture, multi-capture, fn ref via direct call.
// Note: passing closures to HOF via i64 requires unified fn/closure ABI (not yet supported).

fn double(x: i64) -> i64 { return x * 2 }

fn main() -> i64 with IO, Mut {
    var pass: i64 = 1

    // Test 1: single capture
    let offset = 100
    let add_offset = |x| x + offset
    if add_offset(5) != 105 { pass = 0 }
    if add_offset(42) != 142 { pass = 0 }

    // Test 2: closure with capture, manual sum (replaces sum_map(scaled))
    let scale = 10
    let scaled = |x| x * scale
    var sum: i64 = 0
    var i: i64 = 0
    while i < 5 { sum = sum + scaled(i); i = i + 1 }
    // (0+1+2+3+4)*10 = 100
    if sum != 100 { pass = 0 }

    // Test 3: multiple captures
    let a = 3
    let b = 7
    let f = |x| x * a + b
    if f(4) != 19 { pass = 0 }

    // Test 4: fn ref direct call
    if double(7) != 14 { pass = 0 }

    if pass == 1 { print("PASS\n") }
    else { print("FAIL\n") }
    return 0
}
