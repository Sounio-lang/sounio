//@ run-pass
//@ requires: madaros
//@ description: Imported theorem::portfolio v17 Lorenz ball-fixed trajectory manifest smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_ball_fixed_trajectory(),
        236665224, 508132668,
        portfolio_result_validated(),
        portfolio_checker_lorenz_ball_fixed_trajectory())
    if entry_fp != 590228875 { return 1 }

    let manifest_fp = solver_portfolio_v17_ball_fixed_trajectory_bundle_fingerprint(
        236665224, 508132668)
    if manifest_fp != 247161833 { return 2 }

    let result_coverage_fp = solver_portfolio_v17_result_coverage_fingerprint(
        17, 21, 7, 12, 1, 1, manifest_fp)
    if result_coverage_fp != 575168545 { return 3 }

    let family_coverage_fp = solver_portfolio_v17_checker_family_coverage_fingerprint(
        17, 21, 4, 2, 2, 1, 12, manifest_fp)
    if family_coverage_fp != 805421150 { return 4 }

    let acceptance_fp = solver_portfolio_v17_acceptance_receipt_fingerprint(
        17, manifest_fp, result_coverage_fp)
    if acceptance_fp != 154169825 { return 5 }

    let audit_fp = solver_portfolio_v17_audit_receipt_fingerprint(
        17, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 426158721 { return 6 }

    let readiness_fp = solver_portfolio_v17_readiness_fingerprint(
        17, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 879808511 { return 7 }

    if portfolio_entry_fingerprint(
        portfolio_kind_lorenz_ball_fixed_trajectory(),
        236665224, 508132668,
        portfolio_result_unsat(),
        portfolio_checker_lorenz_ball_fixed_trajectory()) != (0 - 1) { return 8 }
    if solver_portfolio_v17_ball_fixed_trajectory_bundle_fingerprint(
        236665224, 508132669) != (0 - 1) { return 9 }
    if solver_portfolio_v17_result_coverage_fingerprint(
        17, 21, 7, 11, 1, 1, manifest_fp) != (0 - 1) { return 10 }
    if solver_portfolio_v17_checker_family_coverage_fingerprint(
        17, 21, 4, 2, 2, 1, 11, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v17_readiness_fingerprint(
        17, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 12 }

    return 0
}
