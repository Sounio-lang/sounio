//@ run-pass
//@ requires: madaros
//@ expect-stdout: 5
//@ description: FX-5 zero resume (affine teardown): the clause value becomes the handle value, the suspended body is abandoned deterministically, and code after the handle still runs (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-5

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        let v = perform Ask.get()
        v + 100
    } with { on get() -> 5 return(x) -> x }
    println(r)
    0
}
