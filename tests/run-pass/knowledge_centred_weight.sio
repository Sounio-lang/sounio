//@ run-pass
//@ requires: madaros
//@ expect-stdout: chi 0.000000
//@ expect-stdout: outside 0
//@ expect-stdout: CENTRED_WEIGHT_OK
// Four pressures sit on ln(P/100) = -1000/T. One parenthesis is 1e-6.
// The uncentred normal equation reported chi 967.372489 and, at 1e-8,
// a chi of 2.6e15 with no band. Centred at the weighted mean of 1/T,
// the residual stays a zero and the extrapolation is not refused.

use epistemic::regression::plateau_pressure

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 400.0
    xs[1] = 1.0 / 450.0
    xs[2] = 1.0 / 500.0
    xs[3] = 1.0 / 550.0
    ys[0] = 0.0 - 1000.0 / 400.0
    ys[1] = 0.0 - 1000.0 / 450.0
    ys[2] = 0.0 - 1000.0 / 500.0
    ys[3] = 0.0 - 1000.0 / 550.0
    uln[0] = 0.2
    uln[1] = 1.0e-6
    uln[2] = 0.2
    uln[3] = 0.2
    let inside = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    let outside = plateau_pressure(xs, ys, uln, 4, 1.0 / 300.0, 100.0)
    uln[1] = 1.0e-8
    let tighter = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    let centre = 12.451447
    let inside_ok = inside.open && !inside.refused && inside.lo < centre && centre < inside.hi && near(inside.chi, 0.0, 0.001)
    let outside_ok = outside.open && !outside.refused && near(outside.chi, 0.0, 0.001)
    let tight_ok = tighter.open && !tighter.refused && tighter.lo < centre && centre < tighter.hi && near(tighter.chi, 0.0, 0.001)
    print("chi ")
    print_f64(inside.chi)
    println("")
    print("outside ")
    print_int(bit(outside.refused))
    println("")
    if inside_ok && outside_ok && tight_ok {
        println("CENTRED_WEIGHT_OK")
        return 0
    }
    println("CENTRED_WEIGHT_FAIL")
    1
}
