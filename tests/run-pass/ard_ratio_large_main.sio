//@ run-pass
//@ requires: madaros
//@ expect-stdout: IF_SQRT_F64_RATIO_OK

use special::erf::*

fn check_ratio(ard: i64) -> i32 with Mut, Div {
    let arda = 5.0
    let k: i64 = 3
    let ardb = if ard == 1 { sqrt((arda - 1.0) * (arda - 2.0) / (k as f64)) } else { 0.0 }
    let nff = 2.0
    let m: i64 = 8
    let ratio = ardb / (nff + (m as f64) + arda + 1.0)
    if ard == 1 {
        if ardb != 2.0 { return 1 }
        if ratio != 0.125 { return 2 }
        if 16.0 / ardb != 8.0 { return 3 }
        if ardb + 1.0 != 3.0 { return 4 }
        if ardb - 1.0 != 1.0 { return 5 }
        if ardb * 2.0 != 4.0 { return 6 }
        if !(ardb > 1.0 && ardb < 3.0) { return 7 }
    } else {
        if ardb != 0.0 { return 8 }
        if ratio != 0.0 { return 9 }
    }
    let reverse = if ard == 1 { sqrt(4.0) } else { 0.0 }
    if reverse / 2.0 != ardb / 2.0 { return 10 }
    let nested = if ard == 1 { { sqrt(4.0) } } else { { 0.0 } }
    if nested / 2.0 != ardb / 2.0 { return 11 }
    let integer = if ard == 1 { 7 } else { 9 }
    if integer / 2 != (if ard == 1 { 3 } else { 4 }) { return 12 }
    0
}

fn main() -> i32 with IO, Mut, Div {
    let enabled = check_ratio(1)
    if enabled != 0 { return enabled }
    let disabled = check_ratio(0)
    if disabled != 0 { return disabled }
    println("IF_SQRT_F64_RATIO_OK")
    0
}
