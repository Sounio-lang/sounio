//@ run-pass
//@ requires: madaros
//@ description: #2760 review -- a parameter named like an effectful builtin (print_int) is the caller's function: it is called (result 107) and the builtin prints nothing. Lowering used to select the builtin by name before looking at locals.

fn leaf(print_int: fn(i64) -> i64 with Div) -> i64 with Div {
    print_int(7)
}

fn mine(x: i64) -> i64 with Div {
    x + 100
}

fn main() -> i32 with IO, Div {
    let r = leaf(mine)
    if r == 107 { 0 } else { 1 }
}
