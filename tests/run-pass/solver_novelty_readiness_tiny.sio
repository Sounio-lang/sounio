//@ run-pass
//@ description: Self-contained tiny solver novelty readiness gate blocks public claims without evidence

fn solver_novelty_private_gate(
    feature_present: i64,
    focused_tests_green: i64,
    proof_profile_green: i64,
    scope_gate_green: i64) -> i64 {
    if feature_present != 1 { return 0 }
    if focused_tests_green != 1 { return 0 }
    if proof_profile_green != 1 { return 0 }
    if scope_gate_green != 1 { return 0 }
    return 1
}

fn solver_novelty_public_gate(
    private_gate_ok: i64,
    baseline_ablation_green: i64,
    external_benchmark_green: i64,
    independent_checker_green: i64,
    literature_review_green: i64,
    compiler_path_stable: i64,
    public_claim_mask: i64) -> i64 {
    if private_gate_ok != 1 { return 0 }
    if baseline_ablation_green != 1 { return 0 }
    if external_benchmark_green != 1 { return 0 }
    if independent_checker_green != 1 { return 0 }
    if literature_review_green != 1 { return 0 }
    if compiler_path_stable != 1 { return 0 }
    if public_claim_mask == 0 { return 0 }
    return 1
}

fn solver_novelty_level(
    private_gate_ok: i64,
    public_gate_ok: i64,
    external_benchmark_green: i64) -> i64 {
    if public_gate_ok == 1 {
        if external_benchmark_green == 1 { return 3 }
    }
    if private_gate_ok == 1 { return 2 }
    return 1
}

fn solver_novelty_readiness_fingerprint(
    private_gate_ok: i64,
    public_gate_ok: i64,
    current_level: i64,
    missing_mask: i64) -> i64 with Mut {
    var fp: i64 = 173
    fp = (fp * 16777619 + private_gate_ok + 11) % 1000000007
    fp = (fp * 16777619 + public_gate_ok + 13) % 1000000007
    fp = (fp * 16777619 + current_level + 17) % 1000000007
    fp = (fp * 16777619 + missing_mask + 19) % 1000000007
    return fp
}

fn main() -> i64 with Mut {
    let private_ok = solver_novelty_private_gate(1, 1, 1, 1)
    if private_ok != 1 { return 1 }

    let private_missing_tests = solver_novelty_private_gate(1, 0, 1, 1)
    if private_missing_tests != 0 { return 2 }

    let public_blocked = solver_novelty_public_gate(
        private_ok,
        0,
        0,
        1,
        1,
        0,
        1)
    if public_blocked != 0 { return 3 }

    let public_no_claim = solver_novelty_public_gate(
        private_ok,
        1,
        1,
        1,
        1,
        1,
        0)
    if public_no_claim != 0 { return 4 }

    let public_ok = solver_novelty_public_gate(
        private_ok,
        1,
        1,
        1,
        1,
        1,
        1)
    if public_ok != 1 { return 5 }

    let level_now = solver_novelty_level(private_ok, public_blocked, 0)
    if level_now != 2 { return 6 }

    let level_public = solver_novelty_level(private_ok, public_ok, 1)
    if level_public != 3 { return 7 }

    let fp = solver_novelty_readiness_fingerprint(private_ok, public_blocked, level_now, 21)
    if fp != 402331456 { return 8 }

    return 0
}
