//@ run-pass
//@ requires: madaros
//@ expect-stdout: m0 0.090000
//@ expect-stdout: m3 0.180000
//@ expect-stdout: m12 1.530000
//@ expect-stdout: mneg 0.090000
//@ expect-stdout: RECUR_MIX_OK
// a = 5 +- 0.3, var = 0.09. b = 2 +- 0.1, var = 0.01. Independent.
// mix(a, b, n) = a + n*b for n >= 1, and a when n < 1.
// n = 12 is 0.09 + 144 * 0.01.

fn mix(x: f64, y: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        mix(x, y, n - 1) + y
    }
}

fn main() -> i64 with IO, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let a = kx.value
    let b = ky.value
    let m0 = variance_of(mix(a, b, 0))
    let m3 = variance_of(mix(a, b, 3))
    let m12 = variance_of(mix(a, b, 12))
    let mneg = variance_of(mix(a, b, 0 - 2))
    print("m0 ")
    print_f64(m0)
    println("")
    print("m3 ")
    print_f64(m3)
    println("")
    print("m12 ")
    print_f64(m12)
    println("")
    print("mneg ")
    print_f64(mneg)
    println("")
    var fails: i64 = 0
    if m0 < 0.089999 || m0 > 0.090001 { fails = fails + 1 }
    if m3 < 0.179999 || m3 > 0.180001 { fails = fails + 1 }
    if m12 < 1.529999 || m12 > 1.530001 { fails = fails + 1 }
    if mneg < 0.089999 || mneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_MIX_OK")
        0
    } else {
        println("RECUR_MIX_FAIL")
        1
    }
}
