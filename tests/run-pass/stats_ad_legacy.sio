//@ run-pass
//@ expect-stdout: STATS_AD_LEGACY_PASS
use stats::epistemic::assumptions::{anderson_darling_test}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;100]=[0.0;100]
 var i:i64=0
 while i<20 {x[i as usize]=i as f64;i=i+1}
 let r=anderson_darling_test(x,20)
 assert(r.status==0 && r.n==20 && !r.has_ties && r.p_approximate)
 assert(r.a2>0.22073784165 && r.a2<0.22073784167)
 assert(r.p>0.8063550612 && r.p<0.8063550615)
 assert(anderson_darling_test(x,101).status==1)
 assert(anderson_darling_test(x,4294967304).status==1)
 println("STATS_AD_LEGACY_PASS")
 0
}
