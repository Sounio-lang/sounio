//@ timeout: 120
// IGNORE REASON: this test requires preprocessed binary input at
// artifacts/research/abide/frames.bin, generated offline by
// scripts/research/abide_preprocess.py from the ABIDE-I dataset (~50 GB,
// IRB-restricted). CI cannot reproduce that artifact, so the test always
// reports `ERROR: frames.bin not found or too small`. Re-enable once the
// preprocessing step is wired into the CI artifact pipeline (or once a
// committed minimal fixture replaces the live dataset). See bin/souc run
// tests/run-pass/g2_abide_sounio.sio locally with frames.bin populated to
// validate end-to-end.
// G₂ Bridge Pipeline — ABIDE-I connectome analysis in pure Sounio.
//
// Reads preprocessed eigenvector frames from binary file (exported by
// scripts/research/abide_preprocess.py), computes optimal Fano labeling
// over 7! permutations per subject, runs permutation test ASD vs TD.
//
// Binary format (artifacts/research/abide/frames.bin):
//   Header: [n_asd: i64, n_td: i64]
//   Per subject: 7 × 200 × f64 = 11200 bytes (eigenvector frame)
//
// This is the same experiment as g2_optimal_labeling.py but in Sounio.

// === Fano structure ===
// 7 oriented Fano lines (1-indexed → 0-indexed triples)
// Line 0: (0,1,2), Line 1: (0,3,4), Line 2: (0,5,6)
// Line 3: (1,3,5), Line 4: (1,4,6), Line 5: (2,3,6), Line 6: (2,4,5)

fn fano_a(line: i32) -> i32 {
    if line == 0 { return 0 }
    if line == 1 { return 0 }
    if line == 2 { return 0 }
    if line == 3 { return 1 }
    if line == 4 { return 1 }
    if line == 5 { return 2 }
    2
}

fn fano_b(line: i32) -> i32 {
    if line == 0 { return 1 }
    if line == 1 { return 3 }
    if line == 2 { return 5 }
    if line == 3 { return 3 }
    if line == 4 { return 4 }
    if line == 5 { return 3 }
    4
}

fn fano_c(line: i32) -> i32 {
    if line == 0 { return 2 }
    if line == 1 { return 4 }
    if line == 2 { return 6 }
    if line == 3 { return 5 }
    if line == 4 { return 6 }
    if line == 5 { return 6 }
    5
}

// === Triple product computation ===
// For a 7×200 eigenvector frame, compute triple product:
//   tp(a,b,c) = Σ_{v=0..199} frame[a*200+v] * frame[b*200+v] * frame[c*200+v]
//
// We precompute all 35 unordered triples and store tp² values.

// All 35 triples: (a,b,c) with a<b<c, stored as flat arrays
// Triple index = position in lexicographic order

fn triple_a(idx: i32) -> i32 {
    // 35 triples of {0..6} with a<b<c
    if idx < 15 { // a=0
        if idx < 10 { return 0 }
        return 0
    }
    if idx < 25 { return 1 } // a=1
    if idx < 31 { return 2 } // a=2
    if idx < 34 { return 3 } // a=3
    4 // a=4
}

fn triple_b(idx: i32) -> i32 with Mut {
    // Hardcode all 35 b-values
    var bs: [i32; 35] = [0; 35]
    // a=0: (0,1,2),(0,1,3),(0,1,4),(0,1,5),(0,1,6),(0,2,3),(0,2,4),(0,2,5),(0,2,6),(0,3,4),(0,3,5),(0,3,6),(0,4,5),(0,4,6),(0,5,6)
    bs[0]=1; bs[1]=1; bs[2]=1; bs[3]=1; bs[4]=1
    bs[5]=2; bs[6]=2; bs[7]=2; bs[8]=2
    bs[9]=3; bs[10]=3; bs[11]=3
    bs[12]=4; bs[13]=4; bs[14]=5
    // a=1: (1,2,3),(1,2,4),(1,2,5),(1,2,6),(1,3,4),(1,3,5),(1,3,6),(1,4,5),(1,4,6),(1,5,6)
    bs[15]=2; bs[16]=2; bs[17]=2; bs[18]=2
    bs[19]=3; bs[20]=3; bs[21]=3
    bs[22]=4; bs[23]=4; bs[24]=5
    // a=2: (2,3,4),(2,3,5),(2,3,6),(2,4,5),(2,4,6),(2,5,6)
    bs[25]=3; bs[26]=3; bs[27]=3; bs[28]=4; bs[29]=4; bs[30]=5
    // a=3: (3,4,5),(3,4,6),(3,5,6)
    bs[31]=4; bs[32]=4; bs[33]=5
    // a=4: (4,5,6)
    bs[34]=5
    bs[idx]
}

fn triple_c(idx: i32) -> i32 with Mut {
    var cs: [i32; 35] = [0; 35]
    cs[0]=2; cs[1]=3; cs[2]=4; cs[3]=5; cs[4]=6
    cs[5]=3; cs[6]=4; cs[7]=5; cs[8]=6
    cs[9]=4; cs[10]=5; cs[11]=6
    cs[12]=5; cs[13]=6; cs[14]=6
    cs[15]=3; cs[16]=4; cs[17]=5; cs[18]=6
    cs[19]=4; cs[20]=5; cs[21]=6
    cs[22]=5; cs[23]=6; cs[24]=6
    cs[25]=4; cs[26]=5; cs[27]=6; cs[28]=5; cs[29]=6; cs[30]=6
    cs[31]=5; cs[32]=6; cs[33]=6
    cs[34]=6
    cs[idx]
}

// Map sorted triple to index (0..34)
fn triple_index(a: i32, b: i32, c: i32) -> i32 with Mut {
    var idx: i32 = 0
    while idx < 35 {
        if triple_a(idx) == a && triple_b(idx) == b && triple_c(idx) == c {
            return idx
        }
        idx = idx + 1
    }
    0
}

// Is this triple a Fano triple?
fn is_fano(a: i32, b: i32, c: i32) -> bool with Mut {
    var line: i32 = 0
    while line < 7 {
        let fa = fano_a(line)
        let fb = fano_b(line)
        let fc = fano_c(line)
        if (a == fa && b == fb && c == fc) { return true }
        line = line + 1
    }
    false
}

// === Permutation machinery ===

struct Perm7 { p0: i32, p1: i32, p2: i32, p3: i32, p4: i32, p5: i32, p6: i32 }

fn perm7_get(p: Perm7, i: i32) -> i32 {
    if i == 0 { return p.p0 }
    if i == 1 { return p.p1 }
    if i == 2 { return p.p2 }
    if i == 3 { return p.p3 }
    if i == 4 { return p.p4 }
    if i == 5 { return p.p5 }
    p.p6
}

fn perm7_identity() -> Perm7 {
    Perm7 { p0: 0, p1: 1, p2: 2, p3: 3, p4: 4, p5: 5, p6: 6 }
}

fn perm7_set(p: Perm7, i: i32, v: i32) -> Perm7 {
    Perm7 {
        p0: if i == 0 { v } else { p.p0 },
        p1: if i == 1 { v } else { p.p1 },
        p2: if i == 2 { v } else { p.p2 },
        p3: if i == 3 { v } else { p.p3 },
        p4: if i == 4 { v } else { p.p4 },
        p5: if i == 5 { v } else { p.p5 },
        p6: if i == 6 { v } else { p.p6 },
    }
}

fn perm7_swap(p: Perm7, i: i32, j: i32) -> Perm7 {
    let vi = perm7_get(p, i)
    let vj = perm7_get(p, j)
    perm7_set(perm7_set(p, i, vj), j, vi)
}

// Knuth Algorithm L: next lexicographic permutation
fn perm7_next(p: Perm7) -> Perm7 with Mut {
    // Find largest i with p[i] < p[i+1]
    var i: i32 = 5
    while i >= 0 && perm7_get(p, i) >= perm7_get(p, i + 1) { i = i - 1 }
    if i < 0 { return Perm7 { p0: 0-1, p1: 0, p2: 0, p3: 0, p4: 0, p5: 0, p6: 0 } } // sentinel: done
    // Find largest j with p[j] > p[i]
    var j: i32 = 6
    while perm7_get(p, j) <= perm7_get(p, i) { j = j - 1 }
    var r = perm7_swap(p, i, j)
    // Reverse suffix from i+1 to 6
    var lo = i + 1
    var hi: i32 = 6
    while lo < hi { r = perm7_swap(r, lo, hi); lo = lo + 1; hi = hi - 1 }
    r
}

// Inverse permutation: inv[perm[k]] = k
fn perm7_inv(p: Perm7) -> Perm7 with Mut {
    var inv = perm7_identity()
    var k: i32 = 0
    while k < 7 {
        inv = perm7_set(inv, perm7_get(p, k), k)
        k = k + 1
    }
    inv
}

// === Fano energy for a labeling ===
// Given 35 precomputed tp² values and a permutation (eigvec → basis),
// compute mean tp² over the 7 Fano triples under this labeling.
fn fano_energy(tp_sq: &[f64; 35], perm: Perm7) -> f64 with Mut {
    let inv = perm7_inv(perm)
    var sum: f64 = 0.0
    var line: i32 = 0
    while line < 7 {
        // Fano triple in basis space
        let bi = fano_a(line)
        let bj = fano_b(line)
        let bk = fano_c(line)
        // Map to eigenvector indices via inverse perm
        let ei = perm7_get(inv, bi)
        let ej = perm7_get(inv, bj)
        let ek = perm7_get(inv, bk)
        // Sort
        var a = ei
        var b = ej
        var c = ek
        if a > b { let t = a; a = b; b = t }
        if b > c { let t = b; b = c; c = t }
        if a > b { let t = a; a = b; b = t }
        let idx = triple_index(a, b, c)
        sum = sum + tp_sq[idx]
        line = line + 1
    }
    sum / 7.0
}

// === Optimal labeling search ===
// Returns best Fano energy over all 5040 permutations.
fn optimal_fano_energy(tp_sq: &[f64; 35]) -> f64 with Mut {
    var best: f64 = 0.0 - 1.0
    var perm = perm7_identity()
    var count: i32 = 0
    var done: bool = false
    while !done {
        let fe = fano_energy(tp_sq, perm)
        if fe > best { best = fe }
        count = count + 1
        perm = perm7_next(perm)
        if perm.p0 < 0 { done = true }
    }
    best
}

// === PRNG for permutation test ===
fn rng_next(state: i64) -> i64 with Div {
    let a: i64 = 16807
    let m: i64 = 2147483647
    let q: i64 = 127773
    let r: i64 = 2836
    let hi = state / q
    let lo = state - hi * q
    let t = a * lo - r * hi
    if t > 0 { t } else { t + m }
}

// === Main pipeline ===
fn main() -> i32 with IO, Mut, Div {
    // Read binary frames file
    let path = "artifacts/research/abide/frames.bin"
    let raw = read_file(path)
    let sz = file_size(path)
    if sz < 16 {
        println("ERROR: frames.bin not found or too small")
        println("Run: python3 scripts/research/abide_preprocess.py")
        return 1
    }

    let n_asd = read_i64(raw, 0)
    let n_td = read_i64(raw, 1)
    let n_total = n_asd + n_td
    println("G2 Bridge Pipeline — Pure Sounio")
    println("================================")
    print("ASD: "); print_int(n_asd); print("  TD: "); print_int(n_td); print("  Total: "); print_int(n_total); println("")

    // Each subject: 7 * 200 f64 = 1400 f64 values = 11200 bytes
    // Header: 16 bytes (2 i64)
    let header_offset: i64 = 2  // in i64 units = 16 bytes
    let frame_size: i64 = 1400  // f64 values per subject

    // Compute optimal Fano energy for each subject
    // Store results in BSS arrays (max 1024 subjects)
    var results: [f64; 1024] = [0.0; 1024]
    var subject: i64 = 0

    // Limit for speed: process up to 200 per group
    var max_asd = n_asd
    var max_td = n_td
    if max_asd > 200 { max_asd = 200 }
    if max_td > 200 { max_td = 200 }
    let max_total = max_asd + max_td

    print("Processing (max "); print_int(max_asd); print(" ASD + "); print_int(max_td); println(" TD)...")

    while subject < max_total {
        // Determine which original subject to read
        var orig_idx = subject
        if subject >= max_asd {
            // TD subject: offset into TD section
            orig_idx = n_asd + (subject - max_asd)
        }

        // Read frame: 7 eigenvectors × 200 components
        let frame_start = header_offset + orig_idx * frame_size

        // Compute all 35 triple products
        var tp_sq: [f64; 35] = [0.0; 35]
        var tidx: i32 = 0
        while tidx < 35 {
            let a = triple_a(tidx)
            let b = triple_b(tidx)
            let c = triple_c(tidx)
            // tp = Σ frame[a*200+v] * frame[b*200+v] * frame[c*200+v]
            var tp: f64 = 0.0
            var v: i32 = 0
            while v < 200 {
                let va = read_f64(raw, frame_start + (a as i64) * 200 + (v as i64))
                let vb = read_f64(raw, frame_start + (b as i64) * 200 + (v as i64))
                let vc = read_f64(raw, frame_start + (c as i64) * 200 + (v as i64))
                tp = tp + va * vb * vc
                v = v + 1
            }
            tp_sq[tidx] = tp * tp
            tidx = tidx + 1
        }

        // Find optimal Fano energy over 5040 labelings
        let best_fe = optimal_fano_energy(&tp_sq)
        results[subject] = best_fe

        if ((subject + 1) - ((subject + 1) / 50) * 50) == 0 {
            print("  "); print_int(subject + 1); print("/"); print_int(max_total); println("")
        }

        subject = subject + 1
    }
    println("Done computing.")

    // Compute group means
    var sum_asd: f64 = 0.0
    var i: i64 = 0
    while i < max_asd { sum_asd = sum_asd + results[i]; i = i + 1 }
    let mean_asd = sum_asd / (max_asd as f64)

    var sum_td: f64 = 0.0
    i = 0
    while i < max_td { sum_td = sum_td + results[max_asd + i]; i = i + 1 }
    let mean_td = sum_td / (max_td as f64)

    // Compute variances
    var var_asd: f64 = 0.0
    i = 0
    while i < max_asd {
        let d = results[i] - mean_asd
        var_asd = var_asd + d * d
        i = i + 1
    }
    if max_asd > 1 { var_asd = var_asd / ((max_asd - 1) as f64) }

    var var_td: f64 = 0.0
    i = 0
    while i < max_td {
        let d = results[max_asd + i] - mean_td
        var_td = var_td + d * d
        i = i + 1
    }
    if max_td > 1 { var_td = var_td / ((max_td - 1) as f64) }

    // Cohen's d
    let pooled_var = (var_asd + var_td) / 2.0
    let sp = sqrt(pooled_var)
    let d_val = if sp > 0.000001 { (mean_asd - mean_td) / sp } else { 0.0 }

    // Observed difference
    let obs_diff = abs(mean_asd - mean_td)

    // Permutation test (1000 permutations for speed)
    println("Permutation test (1000)...")
    var combined: [f64; 1024] = [0.0; 1024]
    i = 0
    while i < max_total { combined[i] = results[i]; i = i + 1 }

    var count_ge: i64 = 0
    var rng: i64 = 42
    var perm_iter: i64 = 0
    while perm_iter < 1000 {
        // Fisher-Yates shuffle
        var sh: [f64; 1024] = [0.0; 1024]
        i = 0
        while i < max_total { sh[i] = combined[i]; i = i + 1 }
        i = max_total - 1
        while i > 0 {
            rng = rng_next(rng)
            var j = rng
            if j < 0 { j = 0 - j }
            j = j - (j / (i + 1)) * (i + 1)
            let tmp = sh[i]
            sh[i] = sh[j]
            sh[j] = tmp
            i = i - 1
        }

        // Mean diff under permutation
        var sa: f64 = 0.0
        i = 0
        while i < max_asd { sa = sa + sh[i]; i = i + 1 }
        var sb: f64 = 0.0
        i = 0
        while i < max_td { sb = sb + sh[max_asd + i]; i = i + 1 }
        let pd = abs(sa / (max_asd as f64) - sb / (max_td as f64))
        if pd >= obs_diff { count_ge = count_ge + 1 }

        perm_iter = perm_iter + 1
    }
    let p_val = (count_ge as f64) / 1000.0

    // Report
    println("")
    println("========================================")
    println("RESULTS (Pure Sounio)")
    println("========================================")
    print("ASD n="); print_int(max_asd); print("  TD n="); print_int(max_td); println("")
    println("")
    println("Best Fano energy (max over 7!=5040 labelings):")
    print("  ASD: "); print_f64(mean_asd); println("")
    print("  TD:  "); print_f64(mean_td); println("")
    print("  Cohen d = "); print_f64(d_val); println("")
    print("  p = "); print_f64(p_val); println("")
    println("")

    if p_val < 0.05 {
        println("*** SIGNIFICANT ***")
    } else {
        println("Not significant at p<0.05.")
    }

    println("")
    println("Pipeline complete — pure Sounio, no Python.")
    0
}
