//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_REPEAT_F64_ARRAY_LOCALS PASS
//
// Copilot review (PR #2516) findings #3 and #5 combined:
//
// - `let (a, b) = ([x; 2], [y; 2])` is an ExprTupleLit whose elements are
//   repeat-array-literals built from f64 LOCALS. expr_result_tuple_arr_mask_ref
//   used to return 0 for anything that was not an ExprCall, so tuple literals
//   never got array-slot metadata at all (finding #5's ExprTupleLit half).
// - Independently, `[x; 2]` itself (the repeat-literal expression, whether
//   inside a tuple literal or lowered directly) used the free fn
//   lower_expr_has_float_source_ref in lower_array_repeat_literal_ref, which
//   does not know about f64 locals, so even a bare `([x; 2])[0] * 2.0` took
//   the integer path (finding #3).
//
// Both must be fixed for `a[0] * 2.0` / `2.0 * b[0]` below to read the
// correct f64 bits instead of misinterpreting them as i64.
fn main() -> i32 with IO, Mut, Panic {
    let x: f64 = 1.5
    let y: f64 = 0.25
    let (a, b) = ([x; 2], [y; 2])
    let s0: f64 = a[0] * 2.0
    let s1: f64 = 2.0 * b[0]
    var acc: f64 = 0.0
    var j: i64 = 0
    while j < 2 {
        acc = acc + 0.5 * a[j]
        j = j + 1
    }
    // Direct repeat-literal expression (finding #3 in isolation), no
    // intervening tuple destructure or local binding at all.
    let direct: f64 = ([x; 2])[0] * 2.0
    if s0 == 3.0 && s1 == 0.5 && acc == 1.5 && direct == 3.0 {
        println("TUPLE_LIT_REPEAT_F64_ARRAY_LOCALS PASS")
        return 0
    }
    1
}
