//@ check-only
// Imported API conformance for policy-observation associator D6.

use epistemic::proof_carrying_policy_state_feedback::*
use epistemic::proof_carrying_policy_observation_associator::*

fn main() with Panic {
    let low = declare_policy_target_hypothesis(510, 0, 520)
    let high = declare_policy_target_hypothesis(511, 1, 520)
    let family = declare_adaptive_observation_policy_family(520, 8400, low, high)
    let budget = declare_synthetic_observation_budget(8500, 8400)
    let anchor_provenance = record_policy_evidence_provenance(
        8101, 7001, 8400, 1, 0, 0, false,
    )
    let anchor = record_observed_anchor_value(7101, anchor_provenance)
    let initial = begin_policy_state_contest(6000, family, budget)
    let anchor_update = update_policy_state_contest_with_anchor(
        6101, 6102, initial, family, anchor,
    )
    let after_anchor = policy_state_transition_result(anchor_update)
    let summary = summarize_policy_state_after_anchor(8201, after_anchor)
    let decision = derive_adaptive_exploit_policy_decision(8102, summary)
    let gap = certify_policy_coverage_gap(8301, decision)
    let assignment = declare_synthetic_exogenous_coverage_assignment(
        8600, 8400, budget, gap,
    )
    let probe_provenance = record_policy_evidence_provenance(
        8103, 7003, 8400, 2, 8101, 8102, true,
    )

    let a = declare_d5_policy_context_atom(
        9101, family, budget, anchor, decision, gap,
    )
    let b = declare_d5_commit_boundary_atom(9102, family)
    let c = declare_d5_pending_probe_atom(
        9103, family, budget, assignment, probe_provenance, 8,
    )

    let gap_refusal = certify_policy_observation_noncomposable(9699, a, c)
    assert(!gap_refusal.adjacent_fragments && gap_refusal.disjoint_origins)
    assert(gap_refusal.same_family && gap_refusal.same_protocol)
    assert(gap_refusal.same_budget && gap_refusal.reason_code == 1)
    assert(gap_refusal.composition_refused)

    let ab_proof = certify_policy_observation_composable(9201, a, b)
    let ab = compose_policy_observation_carriers(9301, ab_proof, a, b)
    let left_proof = certify_policy_observation_composable(9202, ab, c)
    let left = compose_policy_observation_carriers(9302, left_proof, ab, c)

    let bc_proof = certify_policy_observation_composable(9203, b, c)
    let bc = compose_policy_observation_carriers(9303, bc_proof, b, c)
    let right_proof = certify_policy_observation_composable(9204, a, bc)
    let right = compose_policy_observation_carriers(9304, right_proof, a, bc)

    assert(policy_observation_carrier_flat_fingerprint(left) == 93767706)
    assert(policy_observation_carrier_flat_fingerprint(right) == 93767706)
    assert(policy_observation_carrier_tree_fingerprint(left) == 9037326)
    assert(policy_observation_carrier_tree_fingerprint(right) == 573396)
    assert(policy_observation_carrier_status(left) == 2)
    assert(policy_observation_carrier_status(right) == 3)
    assert(policy_observation_carrier_survivor_mask(left) == 3)
    assert(policy_observation_carrier_survivor_mask(right) == 2)
    assert(policy_observation_carrier_burden_spent(left) == 3)
    assert(policy_observation_carrier_burden_spent(right) == 7)
    assert(policy_observation_carrier_evidence_count(left) == 1)
    assert(policy_observation_carrier_evidence_count(right) == 2)
    assert(policy_observation_carrier_evidence_fingerprint(left) == 8101)
    assert(policy_observation_carrier_evidence_fingerprint(right) == 259234)
    assert(policy_observation_carrier_observed_target(left) == -1)
    assert(policy_observation_carrier_observed_target(right) == 8)

    let witness = certify_policy_observation_nonassociativity(
        9701, a, b, c, left, right,
    )
    assert(witness.operator_id == 9601)
    assert(witness.a_atom_id == 9101 && witness.b_atom_id == 9102)
    assert(witness.c_atom_id == 9103)
    assert(witness.ordered_atom_fingerprint == 93767706)
    assert(witness.difference_bitset == 15)
    assert(witness.same_typed_operands && witness.same_ordered_operands)
    assert(witness.same_partial_operator && witness.both_parenthesizations_defined)
    assert(witness.results_unequal)
    assert(witness.declared_partial_operator_nonassociative_on_witness)
    assert(!witness.total_magma_theorem_established)
    assert(!witness.ordinary_function_composition_targeted)
    assert(!witness.causal_feedback_mechanism_established)
    assert(!witness.empirical_psychiatric_order_effect_established)
    assert(!witness.clinical_authority)

    let control = certify_flat_trace_associative_control(9702, a, b, c)
    assert(control.left_grouped_fingerprint == 93767706)
    assert(control.right_grouped_fingerprint == 93767706)
    assert(control.exact_equal && control.concatenation_associative_on_witness)
    assert(control.all_six_frozen_label_orders_encoded)
    assert(control.frozen_label_order_checksums_distinct)
    assert(!control.semantic_carrier_associative_claimed)

    let rival = certify_grouping_retained_rival(9703, left, right)
    assert(rival.projected_flat_payloads_equal)
    assert(!rival.projected_receipt_identities_equal)
    assert(rival.expanded_grouping_states_distinct)
    assert(rival.frozen_outcomes_reproduced_from_grouping)
    assert(!rival.same_complete_state_claimed)
    assert(!rival.irreducible_memory_claimed)

    let monotone = certify_committed_evidence_monotonicity(9704, bc, right)
    assert(monotone.inner_target_value == 8 && monotone.outer_target_value == 8)
    assert(monotone.inner_probe_provenance_id == 8103)
    assert(monotone.outer_probe_provenance_id == 8103)
    assert(monotone.committed_before_outer_policy)
    assert(monotone.committed_after_outer_policy)
    assert(!monotone.retroactive_erasure_permitted)
    assert(monotone.monotone_only_in_declared_fixture)

    let withheld = project_policy_withheld_target(left)
    assert(withheld.target_candidate_value == 8 && !withheld.target_observed)
    assert(withheld.withheld_by_policy_scope)
    let committed = project_committed_synthetic_target(right)
    assert(committed.observed_value == 8 && committed.provenance_id == 8103)
    assert(committed.committed && committed.synthetic_fixture_only)
    assert(!committed.clinical_authority)

    let flat_left = flatten_policy_observation_trace(left)
    let flat_right = flatten_policy_observation_trace(right)
    assert(flat_left.fingerprint == flat_right.fingerprint)
    assert(flat_left.carrier_id != flat_right.carrier_id)
    assert(flat_left.grouping_erased && flat_right.grouping_erased)
    let grouped_left = retain_policy_observation_grouping(left)
    let grouped_right = retain_policy_observation_grouping(right)
    assert(grouped_left.grouping_tree_fingerprint !=
        grouped_right.grouping_tree_fingerprint)
    assert(grouped_left.grouping_retained && grouped_right.grouping_retained)
    assert(replay_frozen_grouping_probe_status(grouped_left) == 2)
    assert(replay_frozen_grouping_probe_status(grouped_right) == 3)

    let partial = declare_partial_policy_observation_operator()
    assert(partial.operator_id == 9601)
    assert(partial.adjacent_disjoint_fragments_only)
    assert(!partial.total_on_all_carriers)
}
