//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 local flowpipe seed receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn point_replay_mask() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let z4: i256 = 4092986080 as i256
    let dy_scaled_q: i256 = 133081411987 as i256
    let dy_scaled_r: i256 = 405415232 as i256
    let xy_scaled_q: i256 = 10099814960 as i256
    let xy_scaled_r: i256 = 2149068118 as i256
    let beta_q: i256 = 10914629546 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 389570672 as i256
    let x_inc_r: i256 = 2544410448 as i256
    let y_inc_q: i256 = 1242653312 as i256
    let y_inc_r: i256 = 4228538720 as i256
    let z_drop_q: i256 = 8148145 as i256
    let z_drop_r: i256 = 2911449872 as i256
    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let dy_num: i256 = x4 * ((28 as i256) * scale - z4)
    let xy_num: i256 = x4 * y4
    let beta_num_z: i256 = (8 as i256) * z4
    let dy: i256 = dy_scaled_q - y4
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    var mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { mask = mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 { mask = mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 { mask = mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 { mask = mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { mask = mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { mask = mask + 32 }
    if check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r) == 1 { mask = mask + 64 }
    return mask
}

fn instance_fp() -> i64 {
    var fp: i64 = 953
    fp = mix(fp, 214180161, 4603)
    fp = mix(fp, 23144051, 4603)
    fp = mix(fp, 561641681, 4603)
    fp = mix(fp, 881240986, 4603)
    fp = mix(fp, 732374685, 4603)
    fp = mix(fp, 5, 4603)
    fp = mix(fp, 5, 4603)
    fp = mix(fp, 6, 4603)
    fp = mix(fp, 256, 4603)
    fp = mix(fp, 32, 4603)
    fp = mix(fp, 1, 4603)
    fp = mix(fp, 100, 4603)
    fp = mix(fp, 4920371098, 4603)
    fp = mix(fp, 8816077911, 4603)
    fp = mix(fp, 4092986080, 4603)
    fp = mix(fp, 5309941770, 4603)
    fp = mix(fp, 10058731223, 4603)
    fp = mix(fp, 4084837935, 4603)
    fp = mix(fp, 133081411987, 4603)
    fp = mix(fp, 405415232, 4603)
    fp = mix(fp, 10099814960, 4603)
    fp = mix(fp, 2149068118, 4603)
    fp = mix(fp, 10914629546, 4603)
    fp = mix(fp, 2, 4603)
    fp = mix(fp, 389570672, 4603)
    fp = mix(fp, 2544410448, 4603)
    fp = mix(fp, 1242653312, 4603)
    fp = mix(fp, 4228538720, 4603)
    fp = mix(fp, 8148145, 4603)
    fp = mix(fp, 2911449872, 4603)
    fp = mix(fp, 127, 4603)
    fp = mix(fp, 7, 4603)
    fp = mix(fp, 7, 4603)
    fp = mix(fp, 3, 4603)
    fp = mix(fp, 15, 4603)
    fp = mix(fp, 0, 4603)
    fp = mix(fp, 0, 4603)
    fp = mix(fp, 17, 4603)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 629109830 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 967
    fp = mix(fp, instance, 4621)
    fp = mix(fp, 127, 4621)
    fp = mix(fp, 7, 4621)
    fp = mix(fp, 7, 4621)
    fp = mix(fp, 3, 4621)
    fp = mix(fp, 15, 4621)
    fp = mix(fp, 0, 4621)
    fp = mix(fp, 0, 4621)
    fp = mix(fp, 17, 4621)
    fp = mix(fp, ok_mask, 4621)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 629109830 { return 0 - 1 }
    if certificate != 993750007 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 971
    fp = mix(fp, instance, 4637)
    fp = mix(fp, certificate, 4637)
    fp = mix(fp, 18, 4637)
    fp = mix(fp, 5, 4637)
    fp = mix(fp, 127, 4637)
    fp = mix(fp, 15, 4637)
    fp = mix(fp, 0, 4637)
    fp = mix(fp, 0, 4637)
    fp = mix(fp, 17, 4637)
    fp = mix(fp, ok_mask, 4637)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 931268564 { return 0 - 1 }
    if instance != 629109830 { return 0 - 1 }
    if certificate != 993750007 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 977
    fp = mix(fp, artifact, 4643)
    fp = mix(fp, instance, 4643)
    fp = mix(fp, certificate, 4643)
    fp = mix(fp, 214180161, 4643)
    fp = mix(fp, 23144051, 4643)
    fp = mix(fp, 561641681, 4643)
    fp = mix(fp, 881240986, 4643)
    fp = mix(fp, 732374685, 4643)
    fp = mix(fp, 4920371098, 4643)
    fp = mix(fp, 8816077911, 4643)
    fp = mix(fp, 4092986080, 4643)
    fp = mix(fp, 5309941770, 4643)
    fp = mix(fp, 10058731223, 4643)
    fp = mix(fp, 4084837935, 4643)
    fp = mix(fp, 5, 4643)
    fp = mix(fp, 17, 4643)
    fp = mix(fp, ok_mask, 4643)
    return fp
}

fn seed_ok_mask(global_claim_mask: i64, status: i64) -> i64 {
    let replay_mask = point_replay_mask()
    let endpoint_mask: i64 = 7
    let trajectory_mask: i64 = 7
    let bridge_mask: i64 = 3
    let seed_mask: i64 = 15
    let local_proof_mask: i64 = 0

    var ok_mask: i64 = 0
    if replay_mask == 127 { ok_mask = ok_mask + 1 }
    if endpoint_mask == 7 { ok_mask = ok_mask + 2 }
    if trajectory_mask == 7 { ok_mask = ok_mask + 4 }
    if bridge_mask == 3 { ok_mask = ok_mask + 8 }
    if seed_mask == 15 { ok_mask = ok_mask + 16 }
    if global_claim_mask == 0 {
        if status == 17 { ok_mask = ok_mask + 32 }
    }
    if 5 + 1 == 6 { ok_mask = ok_mask + 64 }
    if local_proof_mask == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = seed_ok_mask(0, 17)
    if ok_mask != 255 { return 1 }
    if point_replay_mask() != 127 { return 2 }
    let inst = instance_fp()
    if inst != 629109830 { return 3 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 993750007 { return 4 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 931268564 { return 5 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 900912795 { return 6 }
    if seed_ok_mask(1, 17) == 255 { return 7 }
    if certificate_fp(inst, 254) != (0 - 1) { return 8 }
    return 0
}
