//@ run-pass
//@ contract-adjustment: native enum/match lane requires explicit IO effects on print paths
// Native enum basic — validates enum definition, variant expressions, match

enum Color { Red, Green, Blue }

fn color_to_int(c: i64) -> i64 {
    match c {
        Color::Red => 10
        Color::Green => 20
        Color::Blue => 30
        _ => 0
    }
}

fn main() -> i64 with IO {
    let r = Color::Red
    let g = Color::Green
    let b = Color::Blue

    // T1: variant values are sequential discriminants
    print("r=")
    print_int(r)
    print(" g=")
    print_int(g)
    print(" b=")
    print_int(b)
    print("\n")

    // T2: match dispatches correctly
    print("match_r=")
    print_int(color_to_int(r))
    print("\n")
    print("match_g=")
    print_int(color_to_int(g))
    print("\n")
    print("match_b=")
    print_int(color_to_int(b))
    print("\n")

    // T3: wildcard catches unknown
    print("match_99=")
    print_int(color_to_int(99))
    print("\n")

    0
}
