//@ run-pass
//@ expect-stdout: GUM_SO_ANALYTIC_HESSIAN_OK
//@ requires: madaros
// Second derivative through atan, at two points.
//
// H(atan(x)) = -2x/(1+x^2)^2   ->  x=2.0 gives -4/25 = -0.16
//
// A separate file from the x=0.5 case on purpose: the two measurements live in
// different channels, and asking hessian_of(expr, 0, 0) about a value carried by
// channel 1 correctly returns 0.0. That cost me a wrong reading once.
use math::pure::{atan}

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    if d < 0.0 { return 0.0 - d < 1.0e-6 }
    return d < 1.0e-6
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    let kb: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let y = kb.value
    let ok = near(hessian_of(atan(y), 0, 0), 0.0 - 0.16)
        && near(variance_of(atan(y)), 0.0004)
    if ok { print("GUM_SO_ANALYTIC_HESSIAN_OK\n") }
    else {
        print("GUM_SO_ANALYTIC_HESSIAN_FAIL\n")
        print("hess="); print_f64(hessian_of(atan(y), 0, 0)); print(" want -0.160000\n")
        print("var="); print_f64(variance_of(atan(y))); print(" want 0.000400\n")
    }
}
