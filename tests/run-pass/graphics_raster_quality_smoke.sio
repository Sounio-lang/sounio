//@ run-pass

use graphics::drawing::{Color, color_black, color_red, color_white}
use graphics::surface::{surface_new, surface_clear, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::raster::{surface_blend_pixel, surface_draw_line_smooth}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(12, 12)
    s = surface_clear(s, color_black())

    s = surface_blend_pixel(s, 2, 2, color_red(), 128)
    let half_r = surface_get_pixel_r(&s, 2, 2)
    if half_r < 127 || half_r > 129 {
        print("FAIL half alpha red blend\n")
        return 1
    }
    if surface_get_pixel_g(&s, 2, 2) != 0 || surface_get_pixel_b(&s, 2, 2) != 0 {
        print("FAIL alpha blend leaked red into other channels\n")
        return 2
    }

    s = surface_blend_pixel(s, -1, 0, color_white(), 255)
    if surface_get_pixel_r(&s, 0, 0) != 0 {
        print("FAIL out-of-bounds blend changed surface\n")
        return 3
    }

    s = surface_draw_line_smooth(s, 1, 6, 10, 6, color_white())
    if surface_get_pixel_r(&s, 1, 6) != 255 || surface_get_pixel_r(&s, 10, 6) != 255 {
        print("FAIL axis-aligned smooth line endpoints\n")
        return 10
    }

    s = surface_clear(s, color_black())
    s = surface_draw_line_smooth(s, 1, 1, 10, 5, color_white())

    var partial_count = 0
    var y = 0
    while y < 12 {
        var x = 0
        while x < 12 {
            let r = surface_get_pixel_r(&s, x, y)
            if r > 0 && r < 255 {
                partial_count = partial_count + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if partial_count < 4 {
        print("FAIL smooth diagonal did not produce enough partial coverage\n")
        return 20
    }

    let endpoint = surface_get_pixel_r(&s, 1, 1)
    if endpoint < 250 {
        print("FAIL smooth diagonal endpoint coverage too low\n")
        return 21
    }

    print("PASS graphics_raster_quality_smoke\n")
    0
}
