//@ run-pass
//@ requires: madaros
//@ expect-stdout: MODULE_QUALIFIED_CALL_MANGLED_COLLISION PASS
//
// PR #2515 review finding B (comment_id 4058669340): the lowercase-type
// exception in callee_path_module_stripped_name (self-hosted/ir/lower.sio)
// used to test whether ANY IR function named `<segment>_<terminal>` exists,
// not whether that name was actually registered as an impl method. If a
// program imports `mod::f` and ALSO happens to declare an unrelated
// top-level `fn <mod>_<f>(..)`, the bare-existence check mistook that
// unrelated collision for "this is a lowercase-typed impl method", and
// `mod::f(..)` called the wrong function.
//
// testmod::tc_c (stdlib/testmod/tc_c.sio) exports a free fn `tc_c_add(a, b)
// -> a + b + 100`. Mangling module segment `tc_c` with terminal `tc_c_add`
// (ir_mangle_method_name) collides exactly with the identifier
// `tc_c_tc_c_add`, which this file also declares as a wholly unrelated
// top-level function with a different, easily distinguished body. Before the
// fix, `tc_c::tc_c_add(2, 3)` resolved (via the buggy bare-existence check,
// and independently via expr_to_callee_name_ref's Type::method fallback) to
// the colliding `tc_c_tc_c_add`, returning 999 instead of 105.
use testmod::tc_c;

fn tc_c_tc_c_add(a: i64, b: i64) -> i64 with Mut, Panic {
    999
}

fn main() -> i64 with IO, Mut, Panic {
    let r = tc_c::tc_c_add(2, 3)
    if r == 105 {
        println("MODULE_QUALIFIED_CALL_MANGLED_COLLISION PASS")
        return 0
    }
    println("MODULE_QUALIFIED_CALL_MANGLED_COLLISION FAIL")
    return 1
}
