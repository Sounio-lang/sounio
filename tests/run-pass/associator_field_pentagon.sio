//@ run-pass
//@ expect-stdout: ALL PASS
//
// Window 6 acceptance — the associahedron K₄ (n=4 pentagon) as checked code.
//
// Encodes the plan VERDICT's hand-derivation: the order-ambiguity variance of
// w·x·y·z is classical operad theory, and two pentagon edges are EXACT under
// the octonion composition norm ‖ab‖ = ‖a‖‖b‖:
//
//   ‖((wx)y)z − (w(xy))z‖ = ‖[w,x,y]‖·‖z‖     (edge P0–P1)
//   ‖w((xy)z) − w(x(yz))‖ = ‖w‖·‖[x,y,z]‖     (edge P3–P4)
//
// No new mathematics, no GPU kernel — the "novelty" reduces to the associator
// norm scaled by composition. This test makes that reduction machine-checked.

use algebra::associator_field::{
    pentagon_products, pentagon_variance, pentagon_edge_norm, af_sqrt
}
use algebra::octonion::{oct_associator, oct_norm_sq, oct_basis, oct_real}

fn approx(x: f64, y: f64) -> bool {
    let d = if x > y { x - y } else { y - x }
    d < 0.0001
}

fn main() with Mut, Div, Panic, NonAssoc {
    var ok = true

    // Non-associative quad: w=e1, x=e2, y=e4 (the non-Fano triple (1,2,4)), z=e1.
    var w = oct_basis(1)
    var x = oct_basis(2)
    var y = oct_basis(4)
    var z = oct_basis(1)

    var ps: [f64; 40] = [0.0; 40]
    pentagon_products(&w, &x, &y, &z, &!ps)

    // --- Edge P0–P1 exact identity: ‖[w,x,y]‖·‖z‖ ---
    var wxy: [f64; 8] = [0.0; 8]
    oct_associator(&w, &x, &y, &!wxy)
    let edge01_expected = af_sqrt(oct_norm_sq(&wxy)) * af_sqrt(oct_norm_sq(&z))
    let edge01_actual = pentagon_edge_norm(&ps, 0, 1)
    if approx(edge01_actual, edge01_expected) { print("W6 edge P0-P1 = ||[w,x,y]||*||z||: PASS") }
    else { print("W6 edge P0-P1: FAIL"); ok = false }
    // concrete value: ||[e1,e2,e4]|| = 2, ||e1|| = 1 ⇒ 2.0
    if approx(edge01_actual, 2.0) { print("W6 edge P0-P1 = 2.0: PASS") }
    else { print("W6 edge P0-P1 value: FAIL"); ok = false }

    // --- Edge P3–P4 exact identity: ‖w‖·‖[x,y,z]‖ ---
    var xyz: [f64; 8] = [0.0; 8]
    oct_associator(&x, &y, &z, &!xyz)
    let edge34_expected = af_sqrt(oct_norm_sq(&w)) * af_sqrt(oct_norm_sq(&xyz))
    let edge34_actual = pentagon_edge_norm(&ps, 3, 4)
    if approx(edge34_actual, edge34_expected) { print("W6 edge P3-P4 = ||w||*||[x,y,z]||: PASS") }
    else { print("W6 edge P3-P4: FAIL"); ok = false }

    // --- Non-associative quad has positive variance ---
    let v_nonassoc = pentagon_variance(&ps)
    if v_nonassoc > 0.0001 { print("W6 nonassoc variance>0: PASS") }
    else { print("W6 nonassoc variance: FAIL"); ok = false }

    // --- Vanishing case: all-real (scalar) octonions associate ⇒ variance 0 ---
    var rw = oct_real(2.0)
    var rx = oct_real(3.0)
    var ry = oct_real(5.0)
    var rz = oct_real(7.0)
    var rps: [f64; 40] = [0.0; 40]
    pentagon_products(&rw, &rx, &ry, &rz, &!rps)
    let v_real = pentagon_variance(&rps)
    if approx(v_real, 0.0) { print("W6 associative variance=0: PASS") }
    else { print("W6 associative variance: FAIL"); ok = false }
    // all five vertices equal 2*3*5*7 = 210 in the real slot
    if approx(rps[0], 210.0) { print("W6 real product=210: PASS") }
    else { print("W6 real product: FAIL"); ok = false }

    if ok { print("ALL PASS") } else { print("SOME FAIL") }
}
