//@ run-pass
//@ expect-stdout: proof carrying inference ontology OK

ontology ProofCarryingInferenceTest {
    class EpistemicArtifact
    class Hypothesis subclass_of EpistemicArtifact
    class DeclaredModelFamily subclass_of EpistemicArtifact
    class ContestState subclass_of EpistemicArtifact
    class EvidenceArtifact subclass_of EpistemicArtifact
    class Observation subclass_of EvidenceArtifact
    class AdmissibleObservation subclass_of Observation
    class MissingObservation subclass_of Observation
    class UnauditedObservation subclass_of Observation
    class ProvenanceReceipt subclass_of EvidenceArtifact
    class DisconnectedProvenance subclass_of EvidenceArtifact
    class ProtocolInput subclass_of EpistemicArtifact
    class SyntheticProtocolInput subclass_of ProtocolInput
    class PhysicalIntervention subclass_of ProtocolInput
    class DeclaredProbeBurden subclass_of EpistemicArtifact
    class SubjectiveSufferingReceipt subclass_of EpistemicArtifact
    class InferenceReceipt subclass_of EpistemicArtifact
    class ContestTransition subclass_of InferenceReceipt
    class FiniteFamilyIdentification subclass_of InferenceReceipt
    class DeclaredFamilyRefutation subclass_of InferenceReceipt
    class EpistemicAbstention subclass_of InferenceReceipt
    class GlobalTruthReceipt subclass_of InferenceReceipt
    class CausalMechanismReceipt subclass_of InferenceReceipt
    class ClinicalAuthorityReceipt subclass_of InferenceReceipt
    role contains_hypothesis domain DeclaredModelFamily range Hypothesis
    role tests_hypothesis domain AdmissibleObservation range Hypothesis
    role has_provenance domain AdmissibleObservation range ProvenanceReceipt
    role updates_state domain ContestTransition range ContestState
    role uses_input domain ContestTransition range ProtocolInput
    role records_burden domain ProtocolInput range DeclaredProbeBurden
    role produces_inference domain ContestTransition range InferenceReceipt
    role precedes transitive
    role epistemically_related_to symmetric
}

fn accepts_observation(o: Observation) -> i32 { 0 }
fn accepts_inference(r: InferenceReceipt) -> i32 { 0 }
fn accepts_protocol_input(p: ProtocolInput) -> i32 { 0 }

fn admissible_bridge(o: AdmissibleObservation) -> i32 { accepts_observation(o) }
fn abstention_bridge(r: EpistemicAbstention) -> i32 { accepts_inference(r) }
fn refutation_bridge(r: DeclaredFamilyRefutation) -> i32 { accepts_inference(r) }
fn synthetic_bridge(p: SyntheticProtocolInput) -> i32 { accepts_protocol_input(p) }

fn main() -> i32 {
    print("proof carrying inference ontology OK\n")
    0
}
