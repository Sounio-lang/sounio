//@ run-pass
//@ description: Imported pseudo-Boolean row proof chain smoke

use theorem::pb::*

fn main() -> i32 with Div {
    let raw = pb_row3(5, 2, 7, 3, pb_sense_le())
    let sat = pb_row3(3, 2, 3, 3, pb_sense_le())
    if pb_row_check_saturation3(raw, sat) != 1 { return 1 }
    if pb_row_check_saturation3(raw, pb_row3(5, 2, 3, 3, pb_sense_le())) != 0 { return 2 }
    if pb_row_check_saturation3(pb_row3(5, 2, 7, 3, pb_sense_ge()), sat) != 0 { return 3 }

    let le = pb_row3(5, 2, 7, 8, pb_sense_le())
    let le_div = pb_row3(2, 1, 3, 4, pb_sense_le())
    if pb_row_check_divide3(le, 2, le_div) != 1 { return 4 }
    if pb_row_check_divide3(le, 2, pb_row3(3, 1, 3, 4, pb_sense_le())) != 0 { return 5 }

    let ge = pb_row3(5, 2, 7, 9, pb_sense_ge())
    let ge_div = pb_row3(3, 1, 4, 5, pb_sense_ge())
    if pb_row_check_divide3(ge, 2, ge_div) != 1 { return 6 }
    if pb_row_check_divide3(ge, 2, pb_row3(2, 1, 4, 5, pb_sense_ge())) != 0 { return 7 }

    let scaled = pb_row3(4, 2, 6, 8, pb_sense_le())
    if pb_row_check_scale3(le_div, 2, scaled) != 1 { return 8 }
    if pb_row_check_scale3(le_div, 2, pb_row3(4, 2, 7, 8, pb_sense_le())) != 0 { return 9 }

    let side = pb_row3(1, 4, 0, 2, pb_sense_le())
    let sum = pb_row3(3, 5, 3, 6, pb_sense_le())
    if pb_row_check_add3(le_div, side, sum) != 1 { return 10 }
    if pb_row_check_add3(le_div, side, pb_row3(3, 5, 4, 6, pb_sense_le())) != 0 { return 11 }
    if pb_row_check_add3(le_div, pb_row3(1, 4, 0, 2, pb_sense_ge()), sum) != 0 { return 12 }

    if pb_row_check_contradiction3(sum, 1, 1, 0 - 1) != 1 { return 13 }
    if pb_row_check_contradiction3(sum, 1, 0 - 1, 0) != 0 { return 14 }

    let prop_le = pb_row3(2, 3, 5, 6, pb_sense_le())
    if pb_row_check_forces3(prop_le, 1, 0 - 1, 0 - 1, 2, 0) != 1 { return 15 }
    if pb_row_check_forces3(prop_le, 1, 0 - 1, 0 - 1, 2, 1) != 0 { return 16 }

    let prop_ge = pb_row3(2, 3, 5, 7, pb_sense_ge())
    if pb_row_check_forces3(prop_ge, 0, 0 - 1, 0 - 1, 2, 1) != 1 { return 17 }
    if pb_row_check_forces3(prop_ge, 0, 0 - 1, 0 - 1, 2, 0) != 0 { return 18 }

    return 0
}
