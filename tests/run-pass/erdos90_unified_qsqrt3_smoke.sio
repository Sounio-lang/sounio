//@ run-pass
//@ expect-stdout: erdos90_unified_qsqrt3_smoke: PASS

// Smoke: Z(1,0)–E(0,0) is a cross-tag unit edge in the Q(sqrt3) encoding.

fn main() -> i32 with IO, Mut {
    let zpx = 2
    let zpu = 0
    let zpv = 0
    let epx = 0
    let epu = 0
    let epv = 0
    let dpx = zpx - epx
    let dpu = zpu - epu
    let dpv = zpv - epv
    let cross_ok = dpu * dpv
    let sq = dpx * dpx + dpu * dpu + 3 * dpv * dpv
    print("cross_term="); print_int(cross_ok)
    print(" sq="); print_int(sq); print("\n")
    if cross_ok == 0 && sq == 4 {
        print("erdos90_unified_qsqrt3_smoke: PASS\n")
        return 0
    }
    print("erdos90_unified_qsqrt3_smoke: FAIL\n")
    return 1
}