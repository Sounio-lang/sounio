//@ run-pass
//@ description: an integer or bool slot of a destructured tuple prints as an integer (was refused: "cannot safely lower print/println argument with unresolved scalar kind")
//@ expect-stdout: status=3 first=0.5
//@ expect-stdout: n=7 ok=1 x=2.25
//@ expect-stdout: m=11

fn solve(x: f64) -> (i64, [f64; 2], [f64; 2]) {
    let a: [f64; 2] = [x, x * 2.0]
    (3, a, a)
}

fn pair(x: f64) -> (i32, bool, f64) {
    (7, true, x * x)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let (st, v, _u) = solve(0.5)
    print("status=") print(st) print(" first=") println(v[0])
    let (n, ok, x) = pair(1.5)
    print("n=") print(n) print(" ok=") print(ok) print(" x=") println(x)
    let t = pair(2.0)
    let m = t.0 + 4
    print("m=") println(m)
    0
}
