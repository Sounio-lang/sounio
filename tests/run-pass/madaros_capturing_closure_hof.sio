//@ run-pass
//@ requires: madaros
//@ expect-stdout: CAPTURING_CLOSURE_HOF_OK
//@ description: a capturing closure passed to a forwarding HOF keeps its capture (#1542)
//
// lower_function_is_transparent_hof compared the indirect callee and its
// arguments against param_regs, but the body copies each parameter into a
// fresh register first (`r4 = copy r0; call_indirect r4`), so no HOF was ever
// recognised. The closure then took the escaping path, where captures are not
// scanned, and `bias` read as 0: apply2(|x, y| x * y + bias, 5, 6) gave 30.

fn apply1(f: fn(i64) -> i64, a: i64) -> i64 {
    f(a)
}

fn apply2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 with Mut, Panic, Div {
    f(a, b)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var bad = 0
    let bias = 100
    let r1 = apply1(|x: i64| x + bias, 5)
    if r1 != 105 { bad = bad + 1 }
    let r2 = apply2(|x: i64, y: i64| x * y + bias, 5, 6)
    if r2 != 130 { bad = bad + 1 }
    let k = |x: i64, y: i64| x - y + bias
    let r3 = apply2(k, 5, 6)
    if r3 != 99 { bad = bad + 1 }
    let r4 = apply2(|x: i64, y: i64| x + y * 2, 3, 4)
    if r4 != 11 { bad = bad + 1 }
    if bad != 0 {
        print("capturing closure HOF violations: ")
        print_int(bad)
        print("\n")
        return 1
    }
    print("CAPTURING_CLOSURE_HOF_OK\n")
    0
}
