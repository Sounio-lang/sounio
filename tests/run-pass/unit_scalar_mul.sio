//@ run-pass
//@ expect-stdout: unit scalar mul: PASS

// Multiplying a unit value by a scalar preserves the unit
fn main() -> i32 with IO, Mut, Panic, Div {
    let dose: mg = 500.0
    let doubled = dose * 2.0
    if doubled == 1000.0 {
        print("unit scalar mul: PASS\n")
    }
    return 0
}
