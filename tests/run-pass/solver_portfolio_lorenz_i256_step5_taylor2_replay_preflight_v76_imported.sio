    let audit_fp = solver_portfolio_v76_lorenz_i256_step5_taylor2_replay_preflight_audit_fingerprint(
        receipt_fp, 847188269, 425385087, 722867370, 605882312, 466346197, 5, 7, 255)
    if audit_fp != 3618606 { return 2 }
    let manifest_fp = solver_portfolio_v76_lorenz_i256_step5_taylor2_replay_preflight_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 383424151 { return 3 }
    let result_fp = solver_portfolio_v76_result_coverage_fingerprint(76, 80, 10, 68, 1, 1, manifest_fp)
