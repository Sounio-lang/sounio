//@ run-pass
//@ requires: madaros
//@ expect-stdout: RETURNED_ARRAY_SHAPES_AND_LIFETIME_OK
struct ReturnedPoint {value:f64}
fn returned_strings(prefix:string)->[string] with Mut,Alloc,Div {
    var parts:[string]=[]
    parts=parts++[prefix]
    parts=parts++[prefix+"tail"]
    parts
}
fn returned_numbers(value:i64)->[i64] with Mut,Div {
    var parts:[i64]=[]
    parts=parts++[value,value+1]
    parts
}
fn fixed_strings()->[string;2] {["fixed","tail"]}
fn scalar_string()->string {"scalar"}
fn tuple_strings()->([string],i64) with Mut,Alloc,Div {(returned_strings("tuple"),7)}
fn returned_points()->[ReturnedPoint] with Mut,Div {[ReturnedPoint{value:1.25}]}
fn string_cases()->bool with Mut,Alloc,Div,Panic {
    let first=returned_strings("first")
    let typed:[string]=returned_strings("typed")
    let third=returned_strings("third")
    if first.len()!=2 || typed.len()!=2 || third.len()!=2 {return false}
    if first[0]!="first" || first[1]!="firsttail" {return false}
    if typed[0]!="typed" || typed[1]!="typedtail" {return false}
    if third[0]!="third" || third[1]!="thirdtail" {return false}
    if returned_strings("direct").len()!=2 {return false}
    returned_strings("indexed")[1]=="indexedtail"
}
fn other_cases()->bool with Mut,Alloc,Div,Panic {
    let first=returned_numbers(7)
    let typed:[i64]=returned_numbers(11)
    let third=returned_numbers(19)
    if first.len()!=2 || typed.len()!=2 || third.len()!=2 {return false}
    if first[0]!=7 || first[1]!=8 || typed[0]!=11 || typed[1]!=12 {return false}
    let fixed=fixed_strings()
    if fixed.len()!=2 || fixed[0]!="fixed" || fixed[1]!="tail" {return false}
    let scalar=scalar_string()
    if scalar.len()!=6 || scalar!="scalar" {return false}
    let pair=tuple_strings()
    let words=pair.0
    if words.len()!=2 || words[0]!="tuple" || words[1]!="tupletail" || pair.1!=7 {return false}
    let points=returned_points()
    if points.len()!=1 || points[0].value!=1.25 {return false}
    returned_points()[0].value==1.25
}
fn main()->i32 with IO,Mut,Alloc,Div,Panic {
    if !string_cases() {return 1}
    if !other_cases() {return 2}
    println("RETURNED_ARRAY_SHAPES_AND_LIFETIME_OK")
    return 0
}

