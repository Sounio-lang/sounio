//@ run-pass
//@ requires: madaros
//@ expect-stdout: SHADOW_PURE_OK
//@ description: #2760 review -- a parameter or local that shadows a builtin name is the user's value, not the builtin. Calling a pure `fn(i64) -> i64` named `heap_alloc` does not owe Alloc. (lean_single attributes the builtin's effect here, so this is pinned to Madaros.)

fn id(x: i64) -> i64 { x }

fn via_param(heap_alloc: fn(i64) -> i64) -> i64 {
    heap_alloc(8)
}

fn via_local() -> i64 {
    let heap_alloc = id
    heap_alloc(9)
}

fn main() -> i32 with IO {
    if via_param(id) == 8 && via_local() == 9 {
        println("SHADOW_PURE_OK")
        return 0
    }
    1
}
