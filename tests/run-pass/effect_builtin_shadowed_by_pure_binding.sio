//@ run-pass
//@ requires: madaros
//@ expect-stdout: SHADOW_PURE_OK
//@ description: #2760 review -- a parameter or local that shadows a builtin name is the user's value, not the builtin. Calling a `fn(i64) -> i64 with Div` named `heap_alloc` owes Div (its own type), not Alloc. The parameter type carries `with Div` so the function-type effect ratchet does not count a new bare function type. (lean_single attributes the builtin's effect here, so this is pinned to Madaros.)

fn id(x: i64) -> i64 { x }

fn via_param(heap_alloc: fn(i64) -> i64 with Div) -> i64 with Div {
    heap_alloc(8)
}

fn via_local() -> i64 {
    let heap_alloc = id
    heap_alloc(9)
}

fn main() -> i32 with IO, Div {
    if via_param(id) == 8 && via_local() == 9 {
        println("SHADOW_PURE_OK")
        return 0
    }
    1
}
