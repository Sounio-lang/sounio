//@ run-pass
//@ expect-stdout: MATH_SQRT_RANGE_PASS
use math::pure::{sqrt}
fn close(g: f64, e: f64) -> bool {
 let scale = if e < 0.0 { 0.0-e } else { e }
 let delta = if g > e { g-e } else { e-g }
 delta <= 1.0e-12 * scale + 1.0e-290
}
fn main() with IO, Mut, Div, Panic {
 println("sqrt range")
 assert(close(sqrt(1.00000000000000000e-300), 1.00000000000000000e-150))
 println("sqrt range")
 assert(close(sqrt(1.00000000000000000e-100), 1.00000000000000000e-50))
 println("sqrt range")
 assert(close(sqrt(2.22507385850720140e-308), 1.49166814624004135e-154))
 println("sqrt range")
 assert(close(sqrt(1.00000000000000000), 1.00000000000000000))
 println("sqrt range")
 assert(close(sqrt(2.00000000000000000), 1.41421356237309505))
 println("sqrt range")
 assert(close(sqrt(1000000000000.00000), 1000000.00000000000))
 println("sqrt range")
 assert(close(sqrt(1.00000000000000000e+100), 1.00000000000000000e+50))
 println("sqrt range")
 assert(close(sqrt(1.00000000000000000e+300), 1.00000000000000000e+150))
 assert(sqrt(0.0) == 0.0)
 println("MATH_SQRT_RANGE_PASS")
 0
}
