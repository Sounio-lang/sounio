//@ run-pass

fn main() -> i32 with IO, Epistemic, Div, Panic, Mut {
    // x = 0.0: sin'(0)=cos(0)=1.0, cos'(0)=-sin(0)=0.0
    let x0 = measure(0.0, uncertainty: 0.1)

    let s0 = sin(x0.value)
    let ds_sin = sensitivity_of(s0, 0)
    // ∂sin(0)/∂x = cos(0) = 1.0
    assert(ds_sin > 0.999 && ds_sin < 1.001)

    let c0 = cos(x0.value)
    let ds_cos = sensitivity_of(c0, 0)
    // ∂cos(0)/∂x = -sin(0) = 0.0
    assert(ds_cos > -0.001 && ds_cos < 0.001)

    // x = π/6 ≈ 0.5236: sin'(π/6)=cos(π/6)≈0.866, cos'(π/6)=-sin(π/6)≈-0.5
    let xpi6 = measure(0.5235987756, uncertainty: 0.1)

    let sp6 = sin(xpi6.value)
    let ds_sinp6 = sensitivity_of(sp6, 1)
    // ∂sin(π/6)/∂x = cos(π/6) ≈ 0.866
    assert(ds_sinp6 > 0.865 && ds_sinp6 < 0.867)

    let cp6 = cos(xpi6.value)
    let ds_cosp6 = sensitivity_of(cp6, 1)
    // ∂cos(π/6)/∂x = -sin(π/6) ≈ -0.5
    assert(ds_cosp6 > -0.501 && ds_cosp6 < -0.499)

    0
}
