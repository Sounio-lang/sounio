//@ run-pass
//@ timeout: 180
//@ expect-stdout: CLZ_SMOKER_DISCRIMINANT_PASS
// ============================================================================
// DISSERTATION - CLOZAPINE SMOKER VARIANT (CYP1A2 induction follow-up)
// ============================================================================
// The smoker variant scales NM clearance by the documented 1.5 multiplier
// (drugs/clozapine.sio) and nothing else. This test runs NM and smoker side
// by side and requires: (a) smoker CL wire-through is exactly 30.0 L/h;
// (b) smoker plasma AUC is below NM AUC (ratio in [0.5, 0.8]);
// (c) total mass stays within [0, absorbed] for both arms (conservation).
// ============================================================================

use darwin_pbpk::scenarios::clozapine_oral::*

fn clz_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn run_arm(p: PBPKParams28, dt: f64, horizon: f64) -> f64 with Mut, Div {
    var scen = clz_scenario_init()
    var t = 0.0
    var auc = 0.0
    while t + dt * 0.5 < horizon {
        scen = clz_step(scen, p, t, dt)
        auc = auc + scen.pbpk.cv[0] * dt
        t = t + dt
    }
    return auc
}

fn main() -> i32 with IO, Mut, Div {
    let p_nm = clz_pbpk28_params()
    var p_sm = clz_pbpk28_params_smoker()
    print("CLZ|cl_nm=")
    println(p_nm.cl_central)
    print("CLZ|cl_smoker=")
    println(p_sm.cl_central)
    if p_sm.cl_central != 30.0 {
        println("CLZ_SMOKER_DISCRIMINANT_FAIL")
        return 1
    }
    let dt = 0.01
    let horizon = 24.0
    let auc_nm = run_arm(p_nm, dt, horizon)
    let auc_sm = run_arm(p_sm, dt, horizon)
    var scen_nm = clz_scenario_init()
    var scen_sm = clz_scenario_init()
    var t = 0.0
    var cum = 0.0
    while t + dt * 0.5 < horizon {
        cum = cum + clz_release_rate_at(t + 0.5 * dt) * dt
        scen_nm = clz_step(scen_nm, p_nm, t, dt)
        scen_sm = clz_step(scen_sm, p_sm, t, dt)
        t = t + dt
    }
    let m_nm = pbpk28_total_mass(scen_nm.pbpk, p_nm)
    let m_sm = pbpk28_total_mass(scen_sm.pbpk, p_sm)
    print("CLZ|auc_nm=")
    println(auc_nm)
    print("CLZ|auc_smoker=")
    println(auc_sm)
    print("CLZ|mass_nm=")
    println(m_nm)
    print("CLZ|mass_smoker=")
    println(m_sm)
    let ratio = auc_sm / auc_nm
    var ok = 1
    if ratio < 0.5 { ok = 0 }
    if ratio > 0.8 { ok = 0 }
    if m_nm < 0.0 { ok = 0 }
    if m_sm < 0.0 { ok = 0 }
    if m_nm > cum * 1.000001 + 0.000001 { ok = 0 }
    if m_sm > cum * 1.000001 + 0.000001 { ok = 0 }
    if ok == 1 {
        println("CLZ_SMOKER_DISCRIMINANT_PASS")
        return 0
    }
    println("CLZ_SMOKER_DISCRIMINANT_FAIL")
    return 1
}
