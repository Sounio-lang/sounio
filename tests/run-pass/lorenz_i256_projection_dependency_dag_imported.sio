//@ description: Imported Lorenz i256 projection dependency-DAG binds predecessor manifests and entries

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let fp = lorenz_i256_projection_certificate_dependency_dag_fingerprint(
        77888110, 245178976, 214180161,
        63872871, 326517892,
        547731575, 291678314,
        916832909, 137630154,
        116461241, 628994509,
        775818863, 601279541,
        585753742, 502768484,
        44126209, 490367409,
        297819393, 162915880,
        189652817, 622328210,
        836439604, 163659586,
        7, 10, 127)
    if fp != 713010204 { return 1 }

    let audit_fp = lorenz_i256_projection_certificate_dependency_dag_audit_fingerprint(
        fp, 77888110, 245178976, 214180161,
        63872871, 547731575, 916832909,
        116461241, 775818863, 585753742,
        44126209, 297819393, 189652817,
        836439604, 127)
    if audit_fp != 725222703 { return 2 }

