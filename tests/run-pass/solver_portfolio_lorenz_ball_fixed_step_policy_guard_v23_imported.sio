//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v23 Lorenz ball-fixed guard-band step-policy decision smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v23_lorenz_step_policy_guard_instance_fingerprint(
        1000000, 5, 494960746)
    if instance_fp != 554569097 { return 1 }

    let certificate_fp = solver_portfolio_v23_lorenz_step_policy_guard_certificate_fingerprint(
        instance_fp, 833881722, 1273, 0, 2000, 5000, 15, 1, 1, 1, 1)
    if certificate_fp != 414588992 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_ball_fixed_step_policy_guard(),
        instance_fp,
        certificate_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_ball_fixed_step_policy_guard())
    if entry_fp != 3812644 { return 3 }

    let manifest_fp = solver_portfolio_v23_lorenz_ball_fixed_step_policy_guard_bundle_fingerprint(
        494960746, 833881722)
    if manifest_fp != 193159026 { return 4 }

    let result_coverage_fp = solver_portfolio_v23_result_coverage_fingerprint(
        23, 27, 8, 17, 1, 1, manifest_fp)
    if result_coverage_fp != 926894353 { return 5 }

    let family_coverage_fp = solver_portfolio_v23_checker_family_coverage_fingerprint(
        23, 27, 4, 3, 2, 1, 17, manifest_fp)
    if family_coverage_fp != 291588905 { return 6 }

    let acceptance_fp = solver_portfolio_v23_acceptance_receipt_fingerprint(
        23, manifest_fp, result_coverage_fp)
    if acceptance_fp != 975493822 { return 7 }

    let audit_fp = solver_portfolio_v23_audit_receipt_fingerprint(
        23, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 718334294 { return 8 }

    let readiness_fp = solver_portfolio_v23_readiness_fingerprint(
        23, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 698832575 { return 9 }

    if solver_portfolio_v23_lorenz_ball_fixed_step_policy_guard_bundle_fingerprint(
        494960747, 833881722) != (0 - 1) { return 10 }
    if solver_portfolio_v23_result_coverage_fingerprint(
        23, 27, 8, 16, 1, 1, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v23_checker_family_coverage_fingerprint(
        23, 27, 4, 3, 2, 1, 16, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v23_readiness_fingerprint(
        23, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 13 }

    return 0
}
