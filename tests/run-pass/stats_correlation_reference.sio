//@ run-pass
//@ expect-stdout: STATS_CORRELATION_REFERENCE_PASS
// C++23 quadmath raw-moment and naive-rank reference.
use stats::correlation_core::{pearson_checked,spearman_checked}
use stats::correlation_inference::{pearson_inference,spearman_inference}
fn close(a:f64,b:f64,at:f64,rt:f64)->bool {let d=if a>b{a-b}else{b-a} let v=if b<0.0{-b}else{b} return d<=at+rt*v}
// ordinary
fn case_0() with Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 x[0]=1.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 x[2]=4.00000000000000000e+00
 x[3]=7.00000000000000000e+00
 x[4]=1.10000000000000000e+01
 var y:[f64;256]=[0.0;256]
 y[0]=2.00000000000000000e+00
 y[1]=1.00000000000000000e+00
 y[2]=5.00000000000000000e+00
 y[3]=4.00000000000000000e+00
 y[4]=1.00000000000000000e+01
 let r=pearson_checked(&x,&y,5)
 assert(r.status==0)
 assert(r.n==5)
 assert(close(r.coefficient,9.12533516142432832e-01,1.0e-12,0.0))
 assert(close(r.residual_ratio,4.09001933878958890e-01,0.0,1.0e-9))
 let r=spearman_checked(&x,&y,5)
 assert(r.status==0)
 assert(r.n==5)
 assert(close(r.coefficient,8.00000000000000044e-01,1.0e-12,0.0))
 assert(close(r.residual_ratio,5.99999999999999978e-01,0.0,1.0e-9))
}
