//@ run-pass
// Test: ontology transitive subsumption — A subclass_of B subclass_of C

ontology Classification {
    class Entity
    class LivingEntity subclass_of Entity
    class Animal subclass_of LivingEntity
    class Mammal subclass_of Animal
}

fn accept_entity(e: Entity) -> i32 with IO {
    println("entity accepted")
    1
}

fn main() -> i32 with IO {
    let m: Mammal = make_mammal()
    // Mammal -> Animal -> LivingEntity -> Entity (transitive chain)
    accept_entity(m)
    println("ontology transitive OK")
    0
}
