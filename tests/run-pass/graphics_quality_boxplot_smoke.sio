//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_boxplot_raster, quality_box_plot_config_default}

fn is_dark(r: i64, g: i64, b: i64) -> bool {
    r < 50 && g < 60 && b < 80
}

fn is_box_fill(r: i64, g: i64, b: i64) -> bool {
    r > 180 && g > 200 && b > 220
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(84, 84)
    var outliers: [f64; 256] = [0.0; 256]
    outliers[0] = 9.0

    s = plot_boxplot_raster(
        s,
        2.0,
        4.0,
        5.0,
        6.0,
        8.0,
        &outliers,
        1,
        quality_box_plot_config_default()
    )

    let fill_r = surface_get_pixel_r(&s, 42, 50)
    let fill_g = surface_get_pixel_g(&s, 42, 50)
    let fill_b = surface_get_pixel_b(&s, 42, 50)
    if !is_box_fill(fill_r, fill_g, fill_b) {
        print("FAIL boxplot box fill missing\n")
        return 1
    }

    let med_r = surface_get_pixel_r(&s, 42, 45)
    let med_g = surface_get_pixel_g(&s, 42, 45)
    let med_b = surface_get_pixel_b(&s, 42, 45)
    if !is_dark(med_r, med_g, med_b) {
        print("FAIL boxplot median line missing\n")
        return 2
    }

    var whisker_pixels = 0
    var y = 31
    while y <= 39 {
        let r1 = surface_get_pixel_r(&s, 42, y)
        let g1 = surface_get_pixel_g(&s, 42, y)
        let b1 = surface_get_pixel_b(&s, 42, y)
        if is_dark(r1, g1, b1) {
            whisker_pixels = whisker_pixels + 1
        }
        y = y + 1
    }
    y = 56
    while y <= 64 {
        let r2 = surface_get_pixel_r(&s, 42, y)
        let g2 = surface_get_pixel_g(&s, 42, y)
        let b2 = surface_get_pixel_b(&s, 42, y)
        if is_dark(r2, g2, b2) {
            whisker_pixels = whisker_pixels + 1
        }
        y = y + 1
    }
    if whisker_pixels < 8 {
        print("FAIL boxplot whiskers missing\n")
        return 3
    }

    var outlier_pixels = 0
    y = 18
    while y <= 23 {
        var x = 39
        while x <= 45 {
            let r3 = surface_get_pixel_r(&s, x, y)
            let g3 = surface_get_pixel_g(&s, x, y)
            let b3 = surface_get_pixel_b(&s, x, y)
            if is_dark(r3, g3, b3) {
                outlier_pixels = outlier_pixels + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if outlier_pixels < 5 {
        print("FAIL boxplot outlier marker missing\n")
        return 4
    }

    var outside_pixels = 0
    y = 0
    while y < 12 {
        var x2 = 0
        while x2 < 84 {
            if surface_get_pixel_r(&s, x2, y) < 240 {
                outside_pixels = outside_pixels + 1
            }
            x2 = x2 + 1
        }
        y = y + 1
    }
    if outside_pixels > 2 {
        print("FAIL boxplot painted outside expected area\n")
        return 5
    }

    print("PASS graphics_quality_boxplot_smoke\n")
    0
}
