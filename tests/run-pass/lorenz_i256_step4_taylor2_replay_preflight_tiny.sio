//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 replay preflight checks masks before validation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1291
    fp = mix(fp, 4, 5063)
    fp = mix(fp, 556038402, 5063)
    fp = mix(fp, 509176612, 5063)
    fp = mix(fp, 389227567, 5063)
    fp = mix(fp, 1, 5063)
    fp = mix(fp, 1, 5063)
    fp = mix(fp, 4, 5063)
    fp = mix(fp, 4, 5063)
    fp = mix(fp, 15, 5063)
    fp = mix(fp, 15, 5063)
    fp = mix(fp, 15, 5063)
    fp = mix(fp, 0, 5063)
    fp = mix(fp, 6, 5063)
    fp = mix(fp, 0, 5063)
    fp = mix(fp, 0, 5063)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 335114620 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1297
    fp = mix(fp, instance, 5077)
    fp = mix(fp, 4, 5077)
    fp = mix(fp, 4, 5077)
    fp = mix(fp, 15, 5077)
    fp = mix(fp, 15, 5077)
    fp = mix(fp, 15, 5077)
    fp = mix(fp, 15, 5077)
    fp = mix(fp, 0, 5077)
    fp = mix(fp, 6, 5077)
    fp = mix(fp, ok_mask, 5077)
    fp = mix(fp, 0, 5077)
    fp = mix(fp, 0, 5077)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 335114620 { return 0 - 1 }
    if certificate != 922120978 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1301
    fp = mix(fp, instance, 5081)
    fp = mix(fp, certificate, 5081)
    fp = mix(fp, 7, 5081)
    fp = mix(fp, 4, 5081)
    fp = mix(fp, 1, 5081)
    fp = mix(fp, 1, 5081)
    fp = mix(fp, 6, 5081)
    fp = mix(fp, ok_mask, 5081)
    fp = mix(fp, 0, 5081)
    fp = mix(fp, 0, 5081)
    return fp
}

fn replay_mask() -> i64 {
    let obligation_mask: i64 = 15
    let replay_order_mask: i64 = 15
    let replayed_node_mask: i64 = 15
    let predecessor_ready_mask: i64 = 15
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0
    let replay_status: i64 = 6

    var ok_mask: i64 = 0
    if 556038402 > 0 {
        if 389227567 > 0 { ok_mask = ok_mask + 1 }
    }
    if obligation_mask == 15 {
        if predecessor_ready_mask == 15 { ok_mask = ok_mask + 2 }
    }
    if replay_order_mask == obligation_mask {
        if replayed_node_mask == replay_order_mask { ok_mask = ok_mask + 4 }
    }
    if replay_status == 6 { ok_mask = ok_mask + 8 }
    if validated_mask == 0 { ok_mask = ok_mask + 16 }
    if 556038402 != 389227567 { ok_mask = ok_mask + 32 }
    if 1 == 1 { ok_mask = ok_mask + 64 }
    if local_containment_mask == 0 {
        if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = replay_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 335114620 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 922120978 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 525394039 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
