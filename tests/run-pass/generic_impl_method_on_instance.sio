//@ run-pass
//@ expect-stdout: generic impl methods: PASS
// Methods of an impl over a generic struct's own parameters, called on instances.
// The checker registered them under a `Pair__T__U` instance no value ever has, so
// every call on `Pair__i64__i64` failed E011 "no method named for this type". They
// now live on template `Pair`, and a call on an instance reads the signature with
// the instance's arguments -- including a parameter whose type is the generic
// struct itself and an associated fn reached through `Type::<Args>::name`.

struct Pair<T, U> {
    first: T,
    second: U,
}

impl Pair<T, U> {
    fn make(a: T, b: U) -> Pair<T, U> {
        Pair { first: a, second: b }
    }

    fn get_first(self: &Pair<T, U>) -> T {
        self.first
    }

    fn get_second(self: &Pair<T, U>) -> U {
        self.second
    }

    fn same_first(self: &Pair<T, U>, other: &Pair<T, U>) -> bool {
        true
    }
}

struct Map<K, V> {
    key: K,
    val: V,
}

impl Map<K, V> {
    fn get_key(self: &Map<K, V>) -> K {
        self.key
    }
}

fn main() -> i32 with IO {
    var ok: i64 = 0
    let p = Pair { first: 42, second: 99 }
    let f: i64 = p.get_first()
    if f == 42 { ok = ok + 1 }
    let s: i64 = p.get_second()
    if s == 99 { ok = ok + 1 }
    let q = Pair { first: 1, second: 2 }
    if p.same_first(&q) { ok = ok + 1 }
    let m = Map { key: 7, val: 8 }
    let k: i64 = m.get_key()
    if k == 7 { ok = ok + 1 }
    let r = Pair::<i64, i64>::make(5, 6)
    let rf: i64 = r.get_first()
    if rf == 5 { ok = ok + 1 }
    if ok == 5 {
        print("generic impl methods: PASS\n")
    }
    return 0
}
