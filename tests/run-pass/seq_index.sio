//@ run-pass
// Phase 4a of Seq<T>: subscript sugar. seq[i] is seq.get(i); seq[i] = v is
// seq.set(i, v). Local-variable receivers. (Field-receiver indexing is P4b.)

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var s: Seq<i64> = seq_new()
    var i = 0
    while i < 12 { seq_push(s, i * 3); i = i + 1 }   // grows past capacity 4

    // subscript read
    if s[0] != 0 { println("seq_index: FAIL (read 0)"); return 1 }
    if s[5] != 15 { println("seq_index: FAIL (read 5)"); return 1 }
    if s[11] != 33 { println("seq_index: FAIL (read 11)"); return 1 }

    // subscript write
    s[5] = 999
    if s[5] != 999 { println("seq_index: FAIL (write)"); return 1 }
    if s[4] != 12 { println("seq_index: FAIL (neighbor)"); return 1 }

    // index by a loop variable + accumulate
    var sum = 0
    var j = 0
    let n = s.len().unwrap("n")
    while j < n {
        sum = sum + s[j as i64]
        j = j + 1
    }
    // 0+3+6+9+12+999+18+21+24+27+30+33  (s[5] was overwritten to 999)
    if sum != 1182 { println("seq_index: FAIL (loop sum)"); return 1 }

    println("seq_index: PASS")
    return 0
}
