//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 53 }
    let return_early = false
    let prefix = if return_early {
        return spend(permit) as i32
    } else {
        0
    }
    let observed = prefix + spend(permit)
    assert(observed == 53)
    0
}
