//@ run-pass
//@ description: Lorenz i256 derivative-numerator smoke without wide division

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale
    let rho: i256 = 28 as i256

    let rho_scale_minus_z: i256 = (rho * scale) - z
    let dy_num: i256 = x * rho_scale_minus_z
    let xy_num: i256 = x * y
    let beta_num_z: i256 = (8 as i256) * z
    let expected_square: i256 = scale * scale

    if rho_scale_minus_z != (27 as i256) * scale { return 1 }
    if xy_num != expected_square { return 2 }
    if dy_num != (27 as i256) * expected_square { return 3 }
    if beta_num_z != (8 as i256) * scale { return 4 }
    if dy_num <= xy_num { return 5 }
    if expected_square <= scale { return 6 }

    return 0
}
