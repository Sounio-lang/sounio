//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz Taylor-2 adaptive step decision binds the v45 policy to a hold-dt action

use systems::ball_fixed::*

fn main() -> i64 {
    if ball_fixed_adaptive_step_action_code(
        13149, 20000, 5000,
        5225, 5000, 7000,
        19289, 19000, 25000,
        127) != 2 { return 1 }

    let decision_fp = ball_fixed_lorenz_taylor2_adaptive_step_decision_fingerprint(
        403306384, 635367450, 486061656, 85088711, 498384393, 2, 63)
    if decision_fp != 120259197 { return 2 }

    let audit_fp = ball_fixed_lorenz_taylor2_adaptive_step_decision_audit_fingerprint(
        decision_fp, 403306384, 635367450, 486061656, 85088711,
        498384393, 2, 63)
    if audit_fp != 471466754 { return 3 }
    return 0
}
