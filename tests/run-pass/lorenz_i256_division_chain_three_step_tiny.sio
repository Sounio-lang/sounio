//@ run-pass
//@ requires: madaros
//@ description: Three-step Lorenz i256 quotient/remainder witness chain without source-level i256 division

fn chain_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn lorenz_i256_step3_certificate_fingerprint(start_x: i64, start_y: i64, start_z: i64,
                                             dy_scaled_q: i64, dy_scaled_r: i64,
                                             xy_scaled_q: i64, xy_scaled_r: i64,
                                             beta_q: i64, beta_r: i64,
                                             x_inc_q: i64, x_inc_r: i64,
                                             y_inc_q: i64, y_inc_r: i64,
                                             z_drop_q: i64, z_drop_r: i64,
                                             final_x: i64, final_y: i64, final_z: i64,
                                             all_divisions_ok: i64) -> i64 with Mod {
    if start_x != 4406636440 { return 0 - 1 }
    if start_y != 6517899153 { return 0 - 1 }
    if start_z != 4164877513 { return 0 - 1 }
    if dy_scaled_q != 119112655997 { return 0 - 1 }
    if dy_scaled_r != 796606888 { return 0 - 1 }
    if xy_scaled_q != 6687364522 { return 0 - 1 }
    if xy_scaled_r != 1434262808 { return 0 - 1 }
    if beta_q != 11106340034 { return 0 - 1 }
    if beta_r != 2 { return 0 - 1 }
    if x_inc_q != 211126266 { return 0 - 1 }
    if x_inc_r != 2495204624 { return 0 - 1 }
    if y_inc_q != 1125947543 { return 0 - 1 }
    if y_inc_r != 1173001440 { return 0 - 1 }
    if z_drop_q != 44189754 { return 0 - 1 }
    if z_drop_r != 568146880 { return 0 - 1 }
    if final_x != 4617762706 { return 0 - 1 }
    if final_y != 7643846696 { return 0 - 1 }
    if final_z != 4120687759 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 173
    fp = chain_mix(fp, start_x, 1423)
    fp = chain_mix(fp, start_y, 1423)
    fp = chain_mix(fp, start_z, 1423)
    fp = chain_mix(fp, dy_scaled_q, 1423)
    fp = chain_mix(fp, dy_scaled_r, 1423)
    fp = chain_mix(fp, xy_scaled_q, 1423)
    fp = chain_mix(fp, xy_scaled_r, 1423)
    fp = chain_mix(fp, beta_q, 1423)
    fp = chain_mix(fp, beta_r, 1423)
    fp = chain_mix(fp, x_inc_q, 1423)
    fp = chain_mix(fp, x_inc_r, 1423)
    fp = chain_mix(fp, y_inc_q, 1423)
    fp = chain_mix(fp, y_inc_r, 1423)
    fp = chain_mix(fp, z_drop_q, 1423)
    fp = chain_mix(fp, z_drop_r, 1423)
    fp = chain_mix(fp, final_x, 1423)
    fp = chain_mix(fp, final_y, 1423)
    fp = chain_mix(fp, final_z, 1423)
    fp = chain_mix(fp, all_divisions_ok, 1423)
    return fp
}

fn lorenz_i256_three_step_chain_fingerprint(step_count: i64,
                                             step1_certificate_fp: i64,
                                             step2_certificate_fp: i64,
                                             step3_certificate_fp: i64,
                                             final_x: i64, final_y: i64,
                                             final_z: i64) -> i64 with Mod {
    if step_count != 3 { return 0 - 1 }
    if step1_certificate_fp != 510854875 { return 0 - 1 }
    if step2_certificate_fp != 899209716 { return 0 - 1 }
    if step3_certificate_fp != 603078026 { return 0 - 1 }
    if final_x != 4617762706 { return 0 - 1 }
    if final_y != 7643846696 { return 0 - 1 }
    if final_z != 4120687759 { return 0 - 1 }

    var fp: i64 = 179
    fp = chain_mix(fp, step_count, 1451)
    fp = chain_mix(fp, step1_certificate_fp, 1451)
    fp = chain_mix(fp, step2_certificate_fp, 1451)
    fp = chain_mix(fp, step3_certificate_fp, 1451)
    fp = chain_mix(fp, final_x, 1451)
    fp = chain_mix(fp, final_y, 1451)
    fp = chain_mix(fp, final_z, 1451)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256

    let x2: i256 = 4406636440 as i256
    let y2: i256 = 6517899153 as i256
    let z2: i256 = 4164877513 as i256
    let rho: i256 = 28 as i256

    let dx_num: i256 = (10 as i256) * (y2 - x2)
    let rho_scale_minus_z: i256 = (rho * scale) - z2
    let dy_num: i256 = x2 * rho_scale_minus_z
    let xy_num: i256 = x2 * y2
    let beta_num_z: i256 = (8 as i256) * z2

    let dy_scaled_q: i256 = 119112655997 as i256
    let dy_scaled_r: i256 = 796606888 as i256
    let xy_scaled_q: i256 = 6687364522 as i256
    let xy_scaled_r: i256 = 1434262808 as i256
    let beta_q: i256 = 11106340034 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 211126266 as i256
    let x_inc_r: i256 = 2495204624 as i256
    let y_inc_q: i256 = 1125947543 as i256
    let y_inc_r: i256 = 1173001440 as i256
    let z_drop_q: i256 = 44189754 as i256
    let z_drop_r: i256 = 568146880 as i256

    let dy: i256 = dy_scaled_q - y2
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dy_scaled_ok = check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r)

    var all_divisions_ok: i64 = 0
    if dy_scaled_ok == 1 {
        if xy_scaled_ok == 1 {
            if beta_ok == 1 {
                if x_inc_ok == 1 {
                    if y_inc_ok == 1 {
                        if z_drop_ok == 1 { all_divisions_ok = 1 }
                    }
                }
            }
        }
    }

    let x3: i256 = x2 + x_inc_q
    let y3: i256 = y2 + y_inc_q
    let z3: i256 = z2 - z_drop_q

    let step3_fp = lorenz_i256_step3_certificate_fingerprint(
        4406636440, 6517899153, 4164877513,
        119112655997, 796606888, 6687364522, 1434262808,
        11106340034, 2, 211126266, 2495204624,
        1125947543, 1173001440, 44189754, 568146880,
        4617762706, 7643846696, 4120687759, all_divisions_ok)
    let chain_fp = lorenz_i256_three_step_chain_fingerprint(
        3, 510854875, 899209716, step3_fp, 4617762706, 7643846696, 4120687759)

    if all_divisions_ok != 1 { return 1 }
    if dx_num != 21112627130 as i256 { return 2 }
    if dy != 112594756844 as i256 { return 3 }
    if dz_drop_num != 4418975512 as i256 { return 4 }
    if x3 != 4617762706 as i256 { return 5 }
    if y3 != 7643846696 as i256 { return 6 }
    if z3 != 4120687759 as i256 { return 7 }
    if step3_fp != 603078026 { return 8 }
    if chain_fp != 249889958 { return 9 }

    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, 3 as i256) != 0 { return 10 }
    if lorenz_i256_step3_certificate_fingerprint(
        4406636440, 6517899153, 4164877513,
        119112655997, 796606888, 6687364522, 1434262808,
        11106340034, 2, 211126266, 2495204624,
        1125947543, 1173001440, 44189754, 568146879,
        4617762706, 7643846696, 4120687759, all_divisions_ok) != (0 - 1) { return 11 }
    if lorenz_i256_three_step_chain_fingerprint(
        3, 510854875, 899209716, step3_fp, 4617762706, 7643846697, 4120687759) != (0 - 1) { return 12 }

    return 0
}
