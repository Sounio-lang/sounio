//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v70 smoke for Lorenz i256 step-5 Taylor-2 response envelope

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1061
    receipt_fp = mix(receipt_fp, 422368008, 4787)
    receipt_fp = mix(receipt_fp, 577119901, 4787)
    receipt_fp = mix(receipt_fp, 920537800, 4787)
    receipt_fp = mix(receipt_fp, 92616329, 4787)
    receipt_fp = mix(receipt_fp, 857456119, 4787)
    receipt_fp = mix(receipt_fp, 428032311, 4787)
    receipt_fp = mix(receipt_fp, 838284677, 4787)
    receipt_fp = mix(receipt_fp, 693506658, 4787)
    receipt_fp = mix(receipt_fp, 389624150, 4787)
    receipt_fp = mix(receipt_fp, 5, 4787)
    receipt_fp = mix(receipt_fp, 20, 4787)
    receipt_fp = mix(receipt_fp, 255, 4787)
    if receipt_fp != 98211696 { return 1 }

    var audit_fp: i64 = 1063
    audit_fp = mix(audit_fp, receipt_fp, 4789)
    audit_fp = mix(audit_fp, 422368008, 4789)
    audit_fp = mix(audit_fp, 577119901, 4789)
    audit_fp = mix(audit_fp, 920537800, 4789)
    audit_fp = mix(audit_fp, 92616329, 4789)
    audit_fp = mix(audit_fp, 693506658, 4789)
    audit_fp = mix(audit_fp, 389624150, 4789)
    audit_fp = mix(audit_fp, 838284677, 4789)
    audit_fp = mix(audit_fp, 5, 4789)
    audit_fp = mix(audit_fp, 20, 4789)
    audit_fp = mix(audit_fp, 255, 4789)
    if audit_fp != 336655077 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 73, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 73, 1103)
    if entry_fp != 64983941 { return 3 }

    let manifest_fp: i64 = 880702042
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 70, 1871)
    result_fp = mix(result_fp, 74, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 62, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 131556092 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 70, 1907)
    family_fp = mix(family_fp, 74, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 57, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 273106289 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 70, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 242887974 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 70, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 225019937 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 70, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 678530115 { return 8 }
    return 0
}
