//@ run-pass
// Acceptance test 2 for compiler prerequisite #2 (impl Trait for Type parsing).
// Tests multiple trait impls on same type, and trait impl alongside inherent impl.
// Expected output: 5, 7, 10, then "multi PASS"

trait TraitA {
    fn method_a(self) -> i64
}

trait TraitB {
    fn method_b(self) -> i64
}

struct P { x: i64 }

// First trait impl
impl TraitA for P {
    fn method_a(self) -> i64 { self.x + 2 }
}

// Second trait impl
impl TraitB for P {
    fn method_b(self) -> i64 { self.x + 4 }
}

// Inherent impl on the same type
impl P {
    fn method_c(self) -> i64 { self.x + 5 }
}

fn main() with IO {
    let p = P { x: 5 }
    println(p.method_a())
    println(p.method_b())
    println(p.method_c())
    println("multi PASS")
}
