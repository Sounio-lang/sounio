//@ run-pass
//@ expect-stdout: GLOBAL_STRUCT_ARRAY_OK 7,42 9,99 5,6 11 C
//@ description: storing a struct into a GLOBAL array round-trips (#1655)
//
// lean_single reserved the elements of a global `[S; N]` inline (esiz =
// nslots*8) while every store, read and field-store path treats the slots as
// element pointers (the layout of a local `[S; N]`). `G[i] = S {..}` wrote a
// pointer into the inline bytes and `G[i]` read a frame address back as the
// first field: GLOBAL_AGGREGATE_STORE_BROKEN tag=140732605267248. Global struct
// arrays now use the local layout: 8-byte slots pointing into a BSS backing
// block, wired at main's entry. An enum element (no struct layout) used to get
// zero bytes of storage and alias the next global; it is now an 8-byte slot.
struct Rec { tag: i64, val: i64 }
struct Wide { id: i64, bits: [i64; 4], tail: i64 }
enum K { A, B, C }

var G: [Rec; 64] = [Rec { tag: 0, val: 0 }; 64]
var W: [Wide; 8]
var GK: [K; 4] = [K::A; 4]
var AFTER: [i64; 4] = [11; 4]
var I: i64 = 0

fn main() -> i64 with IO, Mut, Panic, Div {
    I = 3
    G[I as usize] = Rec { tag: 7, val: 42 }
    let b = G[I as usize]
    G[5] = Rec { tag: 9, val: 99 }
    let c = G[5]
    W[2] = Wide { id: 5, bits: [1, 2, 3, 4], tail: 0 }
    W[2].tail = 6
    GK[2] = K::C
    var kc: i64 = 0
    match GK[2] { K::C => { kc = 1 }, _ => { kc = 0 } }
    if b.tag != 7 || b.val != 42 || c.tag != 9 || c.val != 99 { return 1 }
    if W[2].bits[3] != 4 || W[2].tail != 6 { return 1 }
    if kc != 1 || AFTER[0] != 11 { return 1 }
    print("GLOBAL_STRUCT_ARRAY_OK ")
    print_int(b.tag); print(","); print_int(b.val); print(" ")
    print_int(c.tag); print(","); print_int(c.val); print(" ")
    print_int(W[2].id); print(","); print_int(W[2].tail); print(" ")
    print_int(AFTER[3]); print(" ")
    if kc == 1 { print("C") }
    print("\n")
    0
}
