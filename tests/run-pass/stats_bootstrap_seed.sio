//@ run-pass
//@ expect-stdout: STATS_BOOTSTRAP_SEED_PASS
use stats::bootstrap::{bootstrap_mean}
use math::pure::{is_finite}
fn main() with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    x[0] = 1.0; x[1] = 3.0
    // The former f64 seed path sticks at state zero when seed == MINSTD modulus.
    let r = bootstrap_mean(&x, 2, 128, 0.95, 2147483647)
    assert(r.se > 0.0)
    assert(r.lo < r.hi)
    // The former unscaled sum overflows despite the finite mean and SE.
    x[0] = 1.0e308; x[1] = 1.2e308
    let large = bootstrap_mean(&x, 2, 128, 0.95, 42)
    assert(is_finite(large.mean) && is_finite(large.se))
    assert(large.mean > 1.09e308 && large.mean < 1.11e308)
    println("STATS_BOOTSTRAP_SEED_PASS")
    0
}
