//@ run-pass
//@ description: `Type::<Args>::assoc()` parses -- the turbofish binds the impl's type parameter as `Type::assoc::<Args>()` does; Madaros stopped at the trailing `::` ("expected expression, found `::`", tests/stdlib/collections/test_heap_vec_generic.sio)
//@ expect-stdout: TYPE_TURBOFISH_OK

struct Cell<T> { v: i64 }

impl Cell<T> {
    fn make(x: i64) -> Cell<T> {
        Cell { v: x }
    }
}

fn main() -> i32 with IO {
    let a = Cell::<i64>::make(5)
    if a.v != 5 { return 1 }
    println("TYPE_TURBOFISH_OK")
    0
}
