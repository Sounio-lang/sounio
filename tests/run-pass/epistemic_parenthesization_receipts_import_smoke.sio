//@ run-pass
//@ expect-stdout: EPISTEMIC_PARENTHESIZATION_RECEIPTS_IMPORT_SMOKE_PASS
// Synthetic import smoke for receipt boundaries. It makes no biological,
// psychiatric, causal, or clinical claim.

use epistemic::observation_provenance::*
use epistemic::parenthesization_receipts::*

fn main() with IO, Panic {
    let opportunity = op_observation_opportunity_i64(10, 11)
    let presence = op_encounter_presence_i64(20, 21)
    let selection = op_measurement_selection_i64(30, 31)
    let act = op_measurement_act_i64(40, 41)
    let recorded = op_record_measurement_i64(opportunity, presence, selection, act)
    let history = op_observation_history_from_recorded_i64(recorded, 1001)

    let path = pr_ordered_transformation_path_i64(history, 2001)
    let boundary = pr_aggregation_boundary_i64(path, 3001, 3002)
    let design = pr_bracketing_design_i64(boundary, 4001, 4002, 4003)
    let probe = pr_algebraic_associator_probe_i64(design, 5001, 5002)
    let comparison = pr_associativity_contest_i64(design, 6001, 6002, 6003, 6004)
    let feature = pr_bracket_discriminating_feature_i64(comparison, 7001, 7002)
    let sensitivity = pr_parenthesization_sensitivity_i64(comparison, feature)
    let abstention = pr_parenthesization_abstention_i64(comparison, 8001)

    let path_ok = pr_ordered_path_history_tag_i64(path) == 1001 &&
        pr_ordered_path_source_system_tag_i64(path) == 11 &&
        pr_ordered_path_tag_i64(path) == 2001
    let boundary_ok = pr_aggregation_boundary_tag_i64(boundary) == 3001 &&
        pr_aggregation_boundary_kind_tag_i64(boundary) == 3002 &&
        pr_aggregation_boundary_source_system_tag_i64(boundary) == 11
    let design_ok = pr_bracketing_design_left_grouping_tag_i64(design) == 4001 &&
        pr_bracketing_design_right_grouping_tag_i64(design) == 4002 &&
        pr_bracketing_design_target_feature_tag_i64(design) == 4003
    let contest_ok = pr_algebraic_associator_probe_tag_i64(probe) == 5002 &&
        pr_algebraic_associator_probe_source_system_tag_i64(probe) == 11 &&
        pr_associativity_contest_evidence_tag_i64(comparison) == 6004 &&
        pr_associativity_contest_source_system_tag_i64(comparison) == 11
    let outcome_ok = pr_bracket_discriminating_ordered_feature_tag_i64(feature) == 7001 &&
        pr_bracket_discriminating_feature_tag_i64(feature) == 7002 &&
        pr_bracket_discriminating_feature_source_system_tag_i64(feature) == 11 &&
        pr_parenthesization_sensitivity_feature_tag_i64(sensitivity) == 7002 &&
        pr_parenthesization_sensitivity_source_system_tag_i64(sensitivity) == 11 &&
        pr_parenthesization_abstention_reason_tag_i64(abstention) == 8001 &&
        pr_parenthesization_abstention_source_system_tag_i64(abstention) == 11

    if path_ok && boundary_ok && design_ok && contest_ok && outcome_ok {
        println("EPISTEMIC_PARENTHESIZATION_RECEIPTS_IMPORT_SMOKE_PASS")
    } else {
        println("EPISTEMIC_PARENTHESIZATION_RECEIPTS_IMPORT_SMOKE_FAIL")
    }
}
