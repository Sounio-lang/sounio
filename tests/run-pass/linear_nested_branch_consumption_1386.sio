//@ run-pass
//@ expect-stdout: 11 12 13 | 11002 2011
//@ description: a linear value consumed once on every path of a NESTED if/else, or bound to a branch-local `let`, is consumed exactly once
//
// lean_single kept ONE pre-branch snapshot of the linear-use counters, so an
// `if` nested in a then-branch overwrote the outer snapshot and `step` below
// read as "used more than once". Its then/else comparison also took a
// variable declared inside one branch (`let r = h(q0)`) for a pre-branch
// variable consumed on one side only. Once `pub linear struct` became linear
// on lean_single (#1386), stdlib/quantum/qasm_tape.sio hit both: its replay
// steps are this shape, and the quantum tests crashed.

linear struct Q { v: i64 }

fn h(x: Q) -> Q {
    Q { v: x.v + 10 }
}

fn eat(x: Q) -> i64 {
    x.v
}

fn step(q0: Q, kind: i64, a: i64) -> i64 {
    if kind == 1 {
        if a == 0 {
            eat(q0) + 10
        } else {
            eat(q0) + 11
        }
    } else {
        eat(q0) + 12
    }
}

fn swap_sum(q0: Q, q1: Q, a: i64) -> i64 {
    if a == 0 {
        let r = h(q0)
        eat(r) * 1000 + eat(q1)
    } else {
        let r = h(q1)
        eat(q0) * 1000 + eat(r)
    }
}

fn main() -> i32 with IO, Mut {
    print_int(step(Q { v: 1 }, 1, 0)) print(" ")
    print_int(step(Q { v: 1 }, 1, 1)) print(" ")
    print_int(step(Q { v: 1 }, 2, 0)) print(" | ")
    print_int(swap_sum(Q { v: 1 }, Q { v: 2 }, 0)) print(" ")
    print_int(swap_sum(Q { v: 2 }, Q { v: 1 }, 7)) print("\n")
    return 0
}
