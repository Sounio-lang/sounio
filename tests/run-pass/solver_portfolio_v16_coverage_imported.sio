//@ description: Imported theorem::portfolio v16 result-coverage fingerprint smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let coverage_fp = solver_portfolio_v16_result_coverage_fingerprint(
        16, 20, 7, 11, 1, 1, 320118125)
    if coverage_fp != 685105937 { return 1 }

    if solver_portfolio_v16_result_coverage_fingerprint(
        16, 20, 6, 12, 1, 1, 320118125) != (0 - 1) { return 2 }
    if solver_portfolio_v16_result_coverage_fingerprint(
        16, 20, 7, 11, 0, 2, 320118125) != (0 - 1) { return 3 }
    if solver_portfolio_v16_result_coverage_fingerprint(
        16, 19, 7, 11, 1, 1, 320118125) != (0 - 1) { return 4 }
    if solver_portfolio_v16_result_coverage_fingerprint(
        16, 20, 7, 11, 1, 1, 320118126) != (0 - 1) { return 5 }

    return 0
}
