//@ run-pass
//@ expect-stdout: LET_STUDY_BINDING_OK
// Regression: `study` remains a declaration keyword but is a local binding name.
struct StudyBindingPayload {
    value: i32,
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let study = StudyBindingPayload { value: 42 }
    let copied = study.value
    if copied != 42 {
        println("FAIL: study as expression")
        return 1
    }
    println("LET_STUDY_BINDING_OK")
    return study.value - 42
}
