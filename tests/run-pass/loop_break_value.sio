//@ run-pass
//@ requires: madaros
//@ expect-stdout: 14
//@ expect-stdout-contains: BREAK_VALUE: PASS
//@ description: `break v` gives a `loop` expression its value -- int, f64 and bool results, a break value read from a loop-body local, a nested `loop` whose value feeds the outer break, a `while` with a bare `break` inside a value loop, and a loop as a function's tail. The value used to be neither checked nor lowered: `let r = loop { .. break i * 2 }` typed `r` as `()`.

fn sum_to(n: i64) -> i64 {
    var i: i64 = 0
    var acc: i64 = 0
    loop {
        i = i + 1
        acc = acc + i
        if i == n { break acc }
    }
}

fn main() with IO {
    var ok: i64 = 1
    var i: i64 = 0
    let r = loop {
        i = i + 1
        if i == 7 { break i * 2 }
    }
    println(r)
    if r != 14 { ok = 0 }

    var j: i64 = 0
    let f = loop {
        j = j + 1
        if j == 4 { break 0.5 * (j as f64) }
    }
    if f != 2.0 { ok = 0 }

    var k: i64 = 0
    let b = loop {
        k = k + 1
        if k == 5 { break k > 3 }
    }
    if !b { ok = 0 }

    var m: i64 = 0
    let y_out = loop {
        m = m + 1
        let y = m * 3
        if y > 10 { break y }
    }
    if y_out != 12 { ok = 0 }

    let nested = loop {
        let inner = loop { break 10 }
        break inner + 1
    }
    if nested != 11 { ok = 0 }

    var w: i64 = 0
    let after_while = loop {
        while true {
            w = w + 1
            if w == 3 { break }
        }
        break w
    }
    if after_while != 3 { ok = 0 }

    if sum_to(5) != 15 { ok = 0 }

    var n: i64 = 0
    loop {
        n = n + 1
        if n == 2 { break }
    }
    if n != 2 { ok = 0 }

    if ok == 1 { print("BREAK_VALUE: PASS\n") } else { print("BREAK_VALUE: FAIL\n") }
}
