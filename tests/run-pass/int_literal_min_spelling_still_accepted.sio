//@ run-pass
//@ expect-stdout-contains: MIN: PASS
//@ description: ADR-015 row 1 must not break the way the corpus writes i64 MIN. `-9223372036854775808` is a prefix minus over a value that fits, so it stays accepted on both engines — 26 sites in stdlib and the f128/f256 oracle tables depend on it.

fn main() with IO {
    let min_i64 = -9223372036854775808
    if min_i64 == 0 - 9223372036854775807 - 1 { print("MIN: PASS\n") } else { print("MIN: FAIL\n") }
}
