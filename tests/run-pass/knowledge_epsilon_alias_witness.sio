//@ run-pass
//@ requires: madaros
//@ expect-stdout: EPSILON_ALIAS_OK
// Regression for #1499 -- `Knowledge { ..., epsilon: <e>, ... }` read back 0.0.
//
// `epsilon` and `confidence` name the SAME quantity. lean_single has always
// agreed at runtime; measured 2026-08-28 under bin/souc-lean-single-x86_64 this
// exact literal printed epsilon=0.500000 confidence=0.500000 value=12.500000.
// Madaros printed epsilon=0.000000: `epsilon` was absent from the synthetic
// Knowledge layout (ir_register_knowledge_layout, self-hosted/ir/lower.sio), so
// the name->index lookup fell through to the legacy `buf[0] % 64` hash and both
// the struct-literal WRITE and the field READ went to slot 101 % 64 = 37 --
// a slot nothing else touches. Round-tripping through it is why the value was
// lost silently rather than loudly.
//
// Pinned as `requires: madaros` on purpose: lean_single was already correct, so
// under that engine this file would pass without exercising the fix at all.
//
// This asserts the two spellings AGREE, which is the actual invariant -- a test
// that only checked `epsilon == 0.5` would still pass if a future change gave
// epsilon its own fourth slot and desynchronised it from confidence.

fn main() -> i64 with IO, Mut, Panic, Div, Epistemic {
    let k: Knowledge<f64> = Knowledge { value: 12.5, epsilon: 0.5, provenance: "probe" }
    print("epsilon=")
    print_f64(k.epsilon)
    print(" confidence=")
    print_f64(k.confidence)
    print(" value=")
    print_f64(k.value)
    print("\n")
    if k.epsilon == k.confidence && k.epsilon == 0.5 && k.value == 12.5 {
        print("EPSILON_ALIAS_OK\n")
        return 0
    }
    print("EPSILON_ALIAS_BROKEN\n")
    1
}
