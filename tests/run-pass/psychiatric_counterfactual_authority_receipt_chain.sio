//@ run-pass
// Synthetic library-protocol witness. It has no patient data, dose, or clinical action.

struct CounterfactualQuestionReceipt { question_id: i64 }
struct IdentificationReceipt { assumption_id: i64 }
struct TransportReceipt { target_context_id: i64 }
struct SelectiveRiskReceipt { calibration_id: i64 }
struct ResearchDecisionCandidate { research_id: i64 }
struct AbstentionReceipt { reason_id: i64 }

fn form_research_candidate(question: CounterfactualQuestionReceipt, identification: IdentificationReceipt, transport: TransportReceipt, selective_risk: SelectiveRiskReceipt) -> ResearchDecisionCandidate {
    ResearchDecisionCandidate { research_id: question.question_id + identification.assumption_id + transport.target_context_id + selective_risk.calibration_id }
}

fn abstain_for_missing_support(question: CounterfactualQuestionReceipt) -> AbstentionReceipt {
    AbstentionReceipt { reason_id: question.question_id + 9000 }
}

fn main() -> i64 {
    let question = CounterfactualQuestionReceipt { question_id: 10 }
    let identification = IdentificationReceipt { assumption_id: 30 }
    let transport = TransportReceipt { target_context_id: 40 }
    let selective_risk = SelectiveRiskReceipt { calibration_id: 50 }
    let candidate = form_research_candidate(question, identification, transport, selective_risk)
    let missing_support_question = CounterfactualQuestionReceipt { question_id: 10 }
    let abstention = abstain_for_missing_support(missing_support_question)

    println(candidate.research_id)
    println(abstention.reason_id)
    0
}
