//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_FITTED_AXIS_PASS
//@ expect-stdout: data-axis-layout="fitted"
//@ expect-stdout: data-axis-layout-status="3"
// Real public constructor -> shared IR -> Canvas and SVG, no manual renderer.
use viz::ir::{viz_scene_new,viz_add_axis,viz_add_fitted_axis,viz_layout_rect,viz_style_rgb}
use viz::scale::{ScaleSpec}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 let linear_scale=ScaleSpec{mode:0,constant:1.0}
 let rect=viz_layout_rect(100,40,160,1)
 let style=viz_style_rgb(70,180,235)
 var scene=viz_scene_new()
 // Preserve legacy fixed112 API; fitted constructor supports actual labels.
 assert(viz_add_axis(&!scene,-1e-8,1e-8,2,false,rect,style)==-1)
 assert(scene.node_count==0)
 let fit=viz_add_fitted_axis(&!scene,-1e-8,1e-8,8,false,rect,500,120,&linear_scale,style)
 assert(fit.status==0 && fit.node==0 && fit.intervals==2)
 assert(scene.nodes[0].min_value== -1e-8 && scene.nodes[0].max_value==1e-8)
 let before=scene.node_count
 let outside=viz_add_fitted_axis(&!scene,-1e-8,1e-8,8,false,viz_layout_rect(0,40,160,1),500,120,&linear_scale,style)
 assert(outside.status==3 && outside.node==-1 && outside.required_left>0 && scene.node_count==before)
 // A tight signed domain produces negative and negative-exponent labels.
 let pixels=heap_alloc(500*120*8) as *mut i64
 assert(pixels as i64!=0)
 var canvas=Canvas{pixels:pixels,width:500,height:120}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 viz_html_emit_scene(&scene,500,120)
 var y:i64=0
 var painted:i64=0
 while y<120 {
  var x:i64=0
  while x<500 {
   let color:i64=read_i64(canvas.pixels,y*500+x)
   if color!=0 {
    print("AXIS_PIXEL ");print(x);print(" ");print(y);print(" ");println(color)
    painted=painted+1
   }
   x=x+1
  }
  y=y+1
 }
 assert(painted>0)
 heap_free(canvas.pixels as *mut i8)
 // Fitted axes revalidate against the actual raster after a resize.
 let small=heap_alloc(100*120*8) as *mut i64
 assert(small as i64!=0)
 var reduced=Canvas{pixels:small,width:100,height:120}
 canvas_clear(&!reduced,0,0,0)
 viz_canvas_render_scene(&scene,&!reduced)
 y=0
 while y<120 {
  var x:i64=0
  while x<100 {assert(read_i64(reduced.pixels,y*100+x)==0);x=x+1}
  y=y+1
 }
 heap_free(reduced.pixels as *mut i8)
 viz_html_emit_scene(&scene,100,120)
 println("STDLIB_DEEP_VIZ_FITTED_AXIS_PASS")
 0
}
