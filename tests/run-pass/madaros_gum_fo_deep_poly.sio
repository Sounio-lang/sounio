//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_DEEP_POLY_PASS

// Deep FO residuals beyond multi-channel R1–R8:
//   D1 ≥9 independent seeds (channel table was 8 — expand to 16)
//   D2 a³ / a⁴ higher powers via product-rule sens
//   D4 (a+b)(a−b) = a²−b²
//   D5 algebraically-equal linear forms cancel (2a+b vs a+a+b)
//   D7 zero-uncertainty factor, D8 (a−b)*c

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    // D1: 9 independent unit seeds
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k1: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k2: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k3: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k4: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k5: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k6: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k7: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let k8: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let x0 = k0.value
    let x1 = k1.value
    let x2 = k2.value
    let x3 = k3.value
    let x4 = k4.value
    let x5 = k5.value
    let x6 = k6.value
    let x7 = k7.value
    let x8 = k8.value
    let s9 = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8
    let p8 = x0 * x1 * x2 * x3 * x4 * x5 * x6 * x7
    let p9 = p8 * x8
    // D2–D3 powers of a single seed (after 9 channels already live)
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let av = a.value
    let a3 = (av * av) * av
    let a4 = ((av * av) * av) * av
    // D4 difference of squares
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    let bv = b.value
    let v_diffsq = variance_of((av + bv) * (av - bv))
    // D5 equal linear forms
    let y1 = 2.0 * av + bv
    let y2 = av + av + bv
    let v_cancel = variance_of(y1 - y2)
    // D7 zero unc factor
    let z: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let zv = z.value
    let v_az = variance_of(av * zv)
    // D8
    let c: Knowledge<f64> = measure(4.0, uncertainty: 0.05)
    let cv = c.value
    let v_diffprod = variance_of((av - bv) * cv)

    print("D1_sum9="); print_f64(variance_of(s9)); print("\n")
    print("D1_prod8="); print_f64(variance_of(p8)); print("\n")
    print("D1_prod9="); print_f64(variance_of(p9)); print("\n")
    print("D2_a3="); print_f64(variance_of(a3)); print("\n")
    print("D3_a4="); print_f64(variance_of(a4)); print("\n")
    print("D4="); print_f64(v_diffsq); print("\n")
    print("D5="); print_f64(v_cancel); print("\n")
    print("D7="); print_f64(v_az); print("\n")
    print("D8="); print_f64(v_diffprod); print("\n")

    // truths: sum9=9*0.0025=0.0225; prod8=0.02; prod9=0.0225
    // a3: 9 a^4 Va = 0.36; a4: 16 a^6 Va = 2.56
    // diffsq: 4a²Va+4b²Vb=0.13; cancel 0; az: 25*0.0025=0.0625; diffprod 0.0825
    let ok = abs_f(variance_of(s9) - 0.0225) < 1.0e-9
        && abs_f(variance_of(p8) - 0.02) < 1.0e-9
        && abs_f(variance_of(p9) - 0.0225) < 1.0e-9
        && abs_f(variance_of(a3) - 0.36) < 1.0e-9
        && abs_f(variance_of(a4) - 2.56) < 1.0e-9
        && abs_f(v_diffsq - 0.13) < 1.0e-9
        && abs_f(v_cancel) < 1.0e-9
        && abs_f(v_az - 0.0625) < 1.0e-9
        && abs_f(v_diffprod - 0.0825) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_DEEP_POLY_PASS\n")
    } else {
        print("MADAROS_GUM_FO_DEEP_POLY_FAIL\n")
    }
}
