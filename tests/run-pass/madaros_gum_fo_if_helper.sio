//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_IF_HELPER_PASS

// FO through pure helpers whose bodies contain if-expressions.
// Const-bool if: taken arm only. Runtime if: dual-arm FO + 0/1 SELECT blend.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn id_if(x: f64) -> f64 {
    if true { x } else { x }
}

fn clamp_pos(x: f64) -> f64 {
    if x < 0.0 { 0.0 } else { x }
}

fn abs_like(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn pick_a(a: f64, b: f64) -> f64 {
    if true { a } else { b }
}

fn pick_b(a: f64, b: f64) -> f64 {
    if false { a } else { b }
}

fn scale_if(x: f64) -> f64 {
    if true {
        let two = 2.0
        two * x
    } else {
        x
    }
}

fn nest_if(x: f64) -> f64 {
    if true {
        if true { 2.0 * x } else { x }
    } else {
        x
    }
}

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    let av = a.value
    let bv = b.value
    let n: Knowledge<f64> = measure(0.0 - 2.0, uncertainty: 0.05)
    let nv = n.value

    let v1 = variance_of(id_if(av))
    let v2 = variance_of(clamp_pos(av))
    let v3 = variance_of(abs_like(av))
    let v3n = variance_of(abs_like(nv))
    let v4 = variance_of(pick_a(av, bv))
    let v5 = variance_of(pick_b(av, bv))
    let v6 = variance_of(scale_if(av))
    let v7 = variance_of(nest_if(av))
    // clamp negative: taken then-arm is 0 → Var≈0
    let v2n = variance_of(clamp_pos(nv))

    print("I1="); print_f64(v1); print("\n")
    print("I2="); print_f64(v2); print("\n")
    print("I2n="); print_f64(v2n); print("\n")
    print("I3="); print_f64(v3); print("\n")
    print("I3n="); print_f64(v3n); print("\n")
    print("I4="); print_f64(v4); print("\n")
    print("I5="); print_f64(v5); print("\n")
    print("I6="); print_f64(v6); print("\n")
    print("I7="); print_f64(v7); print("\n")

    // clamp_pos(negative) → then-arm 0 → Var≈0 under 0/1 SELECT
    let ok = abs_f(v1 - 0.0025) < 1.0e-9
        && abs_f(v2 - 0.0025) < 1.0e-9
        && abs_f(v2n) < 1.0e-9
        && abs_f(v3 - 0.0025) < 1.0e-9
        && abs_f(v3n - 0.0025) < 1.0e-9
        && abs_f(v4 - 0.0025) < 1.0e-9
        && abs_f(v5 - 0.0025) < 1.0e-9
        && abs_f(v6 - 0.01) < 1.0e-9
        && abs_f(v7 - 0.01) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_IF_HELPER_PASS\n")
    } else {
        print("MADAROS_GUM_FO_IF_HELPER_FAIL\n")
    }
}
