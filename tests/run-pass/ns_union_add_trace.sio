//@ run-pass
//@ known-failure: E245 (#1706) refuses Knowledge x Knowledge arithmetic on Madaros (no lowering) independently of the NS wire; this N2 witness is check-level only -- its NS_TRACE dataflow is asserted by scripts/ci/ns_dataflow_trace_gate.sh / ns_antigarbling_gate.sh
//@ requires: madaros
//@ expect-stdout: ns-union-add: PASS
//
// N2 witness (REQ-3, union, OpAdd): adding two independently-measured
// Knowledge values must UNION their noise-symbol sets -- neither source may
// be silently dropped. Observable only under SOUNIO_NS_TRACE=1: two
// "NS_TRACE measure=<h>" seed lines with DISTINCT handles, followed by one
// "NS_TRACE union=<h>" line for the sum.
//
// Re-run with SOUNIO_NS_SABOTAGE=1 as the N2 control: the file still checks
// and runs identically (rc=0, same stdout), but the union write is disabled,
// so the trace invariant ("union handle differs from either seed, encodes
// both") disappears -- the sum's noise_set_id falls back to the
// unpropagated default instead.

fn main() -> i64 with IO {
    let a: Knowledge[f64, Measured] = measure(1.0, uncertainty: 0.1)
    let b: Knowledge[f64, Measured] = measure(2.0, uncertainty: 0.1)
    let s: Knowledge[f64, Derived] = a + b
    println("ns-union-add: PASS")
    0
}
