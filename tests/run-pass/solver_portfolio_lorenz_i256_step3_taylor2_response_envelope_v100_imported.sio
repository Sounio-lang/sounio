        receipt_fp, 116883728, 84354264, 109993635, 39227174,
        417748218, 109213065, 295692487, 3, 20, 255)
    if audit_fp != 47474367 { return 2 }
    let manifest_fp = solver_portfolio_v100_lorenz_i256_step3_taylor2_response_envelope_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 763506498 { return 3 }
    let result_fp = solver_portfolio_v100_result_coverage_fingerprint(100, 104, 10, 92, 1, 1, manifest_fp)
