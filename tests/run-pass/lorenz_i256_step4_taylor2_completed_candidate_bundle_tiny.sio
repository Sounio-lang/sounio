//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 completed candidate bundle keeps proof gates separate

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1843
    fp = mix(fp, 4, 5813)
    fp = mix(fp, 575348777, 5813)
    fp = mix(fp, 417943295, 5813)
    fp = mix(fp, 450696904, 5813)
    fp = mix(fp, 780071782, 5813)
    fp = mix(fp, 749342117, 5813)
    fp = mix(fp, 185341710, 5813)
    fp = mix(fp, 700260810, 5813)
    fp = mix(fp, 747893368, 5813)
    fp = mix(fp, 15, 5813)
    fp = mix(fp, 15, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 4, 5813)
    fp = mix(fp, 0, 5813)
    fp = mix(fp, 0, 5813)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 387318912 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1847
    fp = mix(fp, instance, 5821)
    fp = mix(fp, 4, 5821)
    fp = mix(fp, 4, 5821)
    fp = mix(fp, 4, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 15, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, ok_mask, 5821)
    fp = mix(fp, 0, 5821)
    fp = mix(fp, 0, 5821)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 387318912 { return 0 - 1 }
    if certificate != 851913299 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1853
    fp = mix(fp, instance, 5827)
    fp = mix(fp, certificate, 5827)
    fp = mix(fp, 4, 5827)
    fp = mix(fp, 4, 5827)
    fp = mix(fp, 15, 5827)
    fp = mix(fp, 0, 5827)
    fp = mix(fp, 4, 5827)
    fp = mix(fp, 0, 5827)
    fp = mix(fp, ok_mask, 5827)
    fp = mix(fp, 0, 5827)
    fp = mix(fp, 0, 5827)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 389227567 { return 0 - 1 }
    if instance != 387318912 { return 0 - 1 }
    if certificate != 851913299 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1861
    fp = mix(fp, artifact, 5839)
    fp = mix(fp, instance, 5839)
    fp = mix(fp, certificate, 5839)
    fp = mix(fp, 575348777, 5839)
    fp = mix(fp, 450696904, 5839)
    fp = mix(fp, 749342117, 5839)
    fp = mix(fp, 700260810, 5839)
    fp = mix(fp, 4, 5839)
    fp = mix(fp, 4, 5839)
    fp = mix(fp, ok_mask, 5839)
    fp = mix(fp, 0, 5839)
    fp = mix(fp, 0, 5839)
    return fp
}

fn completed_mask() -> i64 {
    let required_mask: i64 = 15
    let provided_mask: i64 = 15
    let missing_mask: i64 = 0
    let complete_status: i64 = 4
    let validated_mask: i64 = 0
    let local_containment_proof_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0

    var ok_mask: i64 = 0
    if 575348777 > 0 {
        if 450696904 > 0 {
            if 749342117 > 0 {
                if 700260810 > 0 { ok_mask = ok_mask + 1 }
            }
        }
    }
    if 575348777 != 450696904 {
        if 749342117 != 700260810 { ok_mask = ok_mask + 2 }
    }
    if missing_mask == required_mask - provided_mask { ok_mask = ok_mask + 4 }
    if 4 == 4 {
        if 0 == 0 { ok_mask = ok_mask + 8 }
    }
    if complete_status == 4 {
        if missing_mask == 0 { ok_mask = ok_mask + 16 }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if provided_mask == required_mask {
        if provided_mask + missing_mask == required_mask { ok_mask = ok_mask + 64 }
    }
    if local_containment_proof_mask == 0 {
        if global_flowpipe_claim_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = completed_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 387318912 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 851913299 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 389227567 { return 4 }
    if audit_fp(art, inst, cert, ok_mask) != 234665993 { return 5 }
    if certificate_fp(inst, 254) != (0 - 1) { return 6 }
    return 0
}
