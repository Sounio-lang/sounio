//@ run-pass
//@ expect-stdout-contains: PBPK28_CORE_SMOKE_PASS

// Smoke test for stdlib/darwin_pbpk/tsit5_pbpk28.sio + core/pbpk28_params.sio
// (Stage G-ε-15).
//
// Runs the fully-coupled CN step on the rapamycin profile from a 0.05 mg
// IV bolus (= 0.01 mg/L blood C_v at t=0) for 30 h with dt = 0.1 h
// (300 steps, rel_mid = 0). Confirms:
//
//   1. Step is stable — no NaN / inf / negative concentrations.
//   2. Total mass strictly decays (the central CL drains the system,
//      no source).
//   3. Liver organ-average concentration tracks blood concentration with the
//      expected Kp=5.4 accumulation (peak C_liver,avg > 3× C_blood).
//   4. Brain organ-average stays low (Kp=0.10 + small PS → BBB barrier
//      keeps C_brain,avg < 0.2× C_blood).
//
// Math parity with the parity ref is enforced by case 1 of
// `dissertation_pbpk28_parity_gate.sh` once the parity ref is rewired to
// import this module (G-ζ-1).

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*

fn fmt_6(x: f64) -> i64 { return (x * 1000000.0) as i64 }

fn main() with Mut, Div, IO {
    let p = pbpk28_params_rapamycin()
    var s = pbpk28_state_zero()
    s.cv[0] = 0.01      // 0.05 mg / 5 L = 0.01 mg/L blood C_v at t=0

    let dt = 0.001     // matches parity ref's dt
    let n_steps = 30000   // 30 h

    let m_initial = pbpk28_total_mass(s, p)
    print("initial total mass (mg)*1e6=")
    println(fmt_6(m_initial))

    var step = 0
    var m_prev = m_initial
    var liver_peak = 0.0
    var brain_peak = 0.0
    while step < n_steps {
        s = pbpk28_full_cn_step(s, p, 0.0, dt)
        let m_now = pbpk28_total_mass(s, p)

        // Invariant 1: no NaN / inf / negative.
        let inv_ok = (s.cv[0] >= 0.0) && (s.cv[0] < 1.0e3)
        if !inv_ok {
            println("FAIL: blood C_v out of physical range")
            return
        }

        // Invariant 2: total mass decays.
        if m_now > m_prev * 1.0001 {
            print("FAIL: total mass grew at step="); print(step + 1)
            print(" m_prev*1e6="); print(fmt_6(m_prev))
            print(" m_now*1e6="); println(fmt_6(m_now))
            return
        }
        m_prev = m_now

        // Track peaks for liver / brain organ-averages.
        let cavg_liver = pbpk28_organ_average(s, p, 1)
        let cavg_brain = pbpk28_organ_average(s, p, 3)
        if cavg_liver > liver_peak { liver_peak = cavg_liver }
        if cavg_brain > brain_peak { brain_peak = cavg_brain }

        let report = (step + 1) == 100 || (step + 1) == 6000 || (step + 1) == 30000
        if report {
            print("step="); print(step + 1)
            print(" cb*1e6=");         print(fmt_6(s.cv[0]))
            print(" cliver_avg*1e6="); print(fmt_6(cavg_liver))
            print(" cbrain_avg*1e6="); println(fmt_6(cavg_brain))
        }
        step = step + 1
    }

    let m_final = pbpk28_total_mass(s, p)
    print("final total mass (mg)*1e6=")
    println(fmt_6(m_final))

    // Mass decayed monotonically and is essentially gone: with CL_hep=12.4
    // L/h on V_eff = V_b + Σ V_i·Kp_i ≈ 49 L, exp(-12.4·30/49) ≈ 5e-4 so
    // we expect m_final/m_initial ≈ 5e-4. Allow [1e-5, 0.1].
    let decay_ratio = m_final / m_initial
    let decay_ok = (decay_ratio > 1.0e-5) && (decay_ratio < 0.1)
    if !decay_ok {
        print("FAIL: mass decay outside band [1e-5, 0.1]: ratio*1e6=")
        println(fmt_6(decay_ratio))
        return
    }

    // Liver peak (Kp=5.4 + early high blood) > 3× initial blood. C_blood at
    // t=0 is 0.01 mg/L; liver organ-average reaches at least 0.005 mg/L.
    let liver_ok = liver_peak > 5.0e-3
    if !liver_ok {
        print("FAIL: liver peak too low: ")
        println(fmt_6(liver_peak))
        return
    }

    // Brain (Kp=0.10, PS=88) stays below 0.2× initial blood = 2e-3 mg/L.
    let brain_ok = brain_peak < 2.0e-3
    if !brain_ok {
        print("FAIL: brain peak too high (BBB leak?): ")
        println(fmt_6(brain_peak))
        return
    }

    println("PBPK28_CORE_SMOKE_PASS")
}
