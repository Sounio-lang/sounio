//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 projection roundoff budget into ball-fixed scale

fn budget_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn projection_roundoff_budget_fingerprint(
    trajectory_manifest_fp: i64,
    source_scale: i64,
    target_scale: i64,
    x_q: i64,
    x_r: i64,
    y_q: i64,
    y_r: i64,
    z_q: i64,
    z_r: i64,
    projection_inclusion_fp: i64,
    max_floor_error_target_units: i64,
    max_remainder: i64,
    min_lower_slack: i64,
    min_upper_slack_after_roundup: i64,
    inclusion_mask: i64) -> i64 {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if source_scale != 4294967296 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if x_q != 1236317 { return 0 - 1 }
    if x_r != 687511168 { return 0 - 1 }
    if y_q != 2341980 { return 0 - 1 }
    if y_r != 3715113920 { return 0 - 1 }
    if z_q != 951075 { return 0 - 1 }
    if z_r != 1913956800 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if max_floor_error_target_units != 1 { return 0 - 1 }
    if max_remainder != 3715113920 { return 0 - 1 }
    if min_lower_slack != 42445 { return 0 - 1 }
    if min_upper_slack_after_roundup != 42450 { return 0 - 1 }
    if inclusion_mask != 7 { return 0 - 1 }
    if x_r >= source_scale { return 0 - 1 }
    if y_r >= source_scale { return 0 - 1 }
    if z_r >= source_scale { return 0 - 1 }

    var fp: i64 = 313
    fp = budget_mix(fp, trajectory_manifest_fp, 2549)
    fp = budget_mix(fp, source_scale, 2549)
    fp = budget_mix(fp, target_scale, 2549)
    fp = budget_mix(fp, x_q, 2549)
    fp = budget_mix(fp, x_r, 2549)
    fp = budget_mix(fp, y_q, 2549)
    fp = budget_mix(fp, y_r, 2549)
    fp = budget_mix(fp, z_q, 2549)
    fp = budget_mix(fp, z_r, 2549)
    fp = budget_mix(fp, projection_inclusion_fp, 2549)
    fp = budget_mix(fp, max_floor_error_target_units, 2549)
    fp = budget_mix(fp, max_remainder, 2549)
    fp = budget_mix(fp, min_lower_slack, 2549)
    fp = budget_mix(fp, min_upper_slack_after_roundup, 2549)
    fp = budget_mix(fp, inclusion_mask, 2549)
    return fp
}

fn projection_roundoff_audit_fingerprint(
    roundoff_budget_fp: i64,
    range_budget_fp: i64,
    bridge_instance_fp: i64,
    ball_fixed_enclosure_fp: i64,
    bit_headroom: i64,
    readiness_mask: i64) -> i64 {
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if range_budget_fp != 87220662 { return 0 - 1 }
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if bit_headroom != 184 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 317
    fp = budget_mix(fp, roundoff_budget_fp, 2557)
    fp = budget_mix(fp, range_budget_fp, 2557)
    fp = budget_mix(fp, bridge_instance_fp, 2557)
    fp = budget_mix(fp, ball_fixed_enclosure_fp, 2557)
    fp = budget_mix(fp, bit_headroom, 2557)
    fp = budget_mix(fp, readiness_mask, 2557)
    return fp
}

fn main() -> i64 {
    let budget_fp = projection_roundoff_budget_fingerprint(
        214180161, 4294967296, 1000000,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        890086395, 1, 3715113920, 42445, 42450, 7)
    if budget_fp != 677514412 { return 1 }

    let audit_fp = projection_roundoff_audit_fingerprint(
        budget_fp, 87220662, 149359034, 166945519, 184, 31)
    if audit_fp != 159826781 { return 2 }

    if projection_roundoff_budget_fingerprint(
        214180161, 4294967296, 1000000,
        1236317, 687511168,
        2341980, 3715113921,
        951075, 1913956800,
        890086395, 1, 3715113920, 42445, 42450, 7) != (0 - 1) { return 3 }
    if projection_roundoff_budget_fingerprint(
        214180161, 4294967296, 1000000,
        1236317, 687511168,
        2341980, 3715113920,
        951075, 1913956800,
        890086395, 2, 3715113920, 42445, 42450, 7) != (0 - 1) { return 4 }
    if projection_roundoff_audit_fingerprint(
        budget_fp, 87220663, 149359034, 166945519, 184, 31) != (0 - 1) { return 5 }

    return 0
}
