//@ run-pass
//@ requires: madaros
//@ expect-stdout: three 0.810000
//@ expect-stdout: four 1.440000
//@ expect-stdout: WHILE_VAR_OK
// a = 5 +- 0.3, var = 0.09. Adding the same a on each iteration is one
// channel: three times is 9 * 0.09, four times is 16 * 0.09.

fn add3(x: f64) -> f64 {
    var acc = 0.0
    var i = 0
    while i < 3 {
        acc = acc + x
        i = i + 1
    }
    acc
}

fn add4(x: f64) -> f64 {
    var acc = 0.0
    var i = 0
    while i < 4 {
        acc = acc + x
        i = i + 1
    }
    acc
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let three = variance_of(add3(a))
    let four = variance_of(add4(a))
    print("three ")
    print_f64(three)
    println("")
    print("four ")
    print_f64(four)
    println("")
    var fails: i64 = 0
    if three < 0.809999 || three > 0.810001 { fails = fails + 1 }
    if four < 1.439999 || four > 1.440001 { fails = fails + 1 }
    if fails == 0 {
        println("WHILE_VAR_OK")
        0
    } else {
        println("WHILE_VAR_FAIL")
        1
    }
}
