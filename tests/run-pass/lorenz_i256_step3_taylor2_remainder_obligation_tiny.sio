//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var instance_fp: i64 = 1813
    instance_fp = mix(instance_fp, 3, 5753)
    instance_fp = mix(instance_fp, 4294967296, 5753)
    instance_fp = mix(instance_fp, 1000000, 5753)
    instance_fp = mix(instance_fp, 42949672, 5753)
    instance_fp = mix(instance_fp, 116883728, 5753)
    instance_fp = mix(instance_fp, 84354264, 5753)
    instance_fp = mix(instance_fp, 164784481, 5753)
    instance_fp = mix(instance_fp, 660765149, 5753)
    instance_fp = mix(instance_fp, 844877047, 5753)
    instance_fp = mix(instance_fp, 492955058, 5753)
    instance_fp = mix(instance_fp, 4617762706, 5753)
    instance_fp = mix(instance_fp, 7643846696, 5753)
    instance_fp = mix(instance_fp, 4120687759, 5753)
    instance_fp = mix(instance_fp, 212600882, 5753)
    instance_fp = mix(instance_fp, 1127428916, 5753)
    instance_fp = mix(instance_fp, 45097157, 5753)
    instance_fp = mix(instance_fp, 0, 5753)
    instance_fp = mix(instance_fp, 0, 5753)
    if instance_fp != 542114330 { return 1 }

    var certificate_fp: i64 = 1817
    certificate_fp = mix(certificate_fp, instance_fp, 5779)
    certificate_fp = mix(certificate_fp, 4830363588, 5779)
    certificate_fp = mix(certificate_fp, 8771275612, 5779)
    certificate_fp = mix(certificate_fp, 4165784916, 5779)
    certificate_fp = mix(certificate_fp, 116183493686, 5779)
    certificate_fp = mix(certificate_fp, 136016392000, 5779)
    certificate_fp = mix(certificate_fp, 139437815949, 5779)
    certificate_fp = mix(certificate_fp, 20973433339, 5779)
    certificate_fp = mix(certificate_fp, 2754542079490, 5779)
    certificate_fp = mix(certificate_fp, 3842415704665, 5779)
    certificate_fp = mix(certificate_fp, 490524458002, 5779)
    certificate_fp = mix(certificate_fp, 137727098, 5779)
    certificate_fp = mix(certificate_fp, 192120777, 5779)
    certificate_fp = mix(certificate_fp, 24526222, 5779)
    certificate_fp = mix(certificate_fp, 32068, 5779)
    certificate_fp = mix(certificate_fp, 44732, 5779)
    certificate_fp = mix(certificate_fp, 5711, 5779)
    certificate_fp = mix(certificate_fp, 40000, 5779)
    certificate_fp = mix(certificate_fp, 55000, 5779)
    certificate_fp = mix(certificate_fp, 10000, 5779)
    certificate_fp = mix(certificate_fp, 7932, 5779)
    certificate_fp = mix(certificate_fp, 10268, 5779)
    certificate_fp = mix(certificate_fp, 4289, 5779)
    certificate_fp = mix(certificate_fp, 127, 5779)
    certificate_fp = mix(certificate_fp, 0, 5779)
    certificate_fp = mix(certificate_fp, 0, 5779)
    if certificate_fp != 570828076 { return 2 }

    var artifact_fp: i64 = 1819
    artifact_fp = mix(artifact_fp, instance_fp, 5783)
    artifact_fp = mix(artifact_fp, certificate_fp, 5783)
    artifact_fp = mix(artifact_fp, 116883728, 5783)
    artifact_fp = mix(artifact_fp, 84354264, 5783)
    artifact_fp = mix(artifact_fp, 164784481, 5783)
    artifact_fp = mix(artifact_fp, 660765149, 5783)
    artifact_fp = mix(artifact_fp, 844877047, 5783)
    artifact_fp = mix(artifact_fp, 492955058, 5783)
    artifact_fp = mix(artifact_fp, 5, 5783)
    artifact_fp = mix(artifact_fp, 3, 5783)
    artifact_fp = mix(artifact_fp, 32068, 5783)
    artifact_fp = mix(artifact_fp, 44732, 5783)
    artifact_fp = mix(artifact_fp, 5711, 5783)
    artifact_fp = mix(artifact_fp, 40000, 5783)
    artifact_fp = mix(artifact_fp, 55000, 5783)
    artifact_fp = mix(artifact_fp, 10000, 5783)
    artifact_fp = mix(artifact_fp, 127, 5783)
    artifact_fp = mix(artifact_fp, 0, 5783)
    artifact_fp = mix(artifact_fp, 0, 5783)
    if artifact_fp != 693563916 { return 3 }

    var audit_fp: i64 = 1829
    audit_fp = mix(audit_fp, artifact_fp, 5791)
    audit_fp = mix(audit_fp, instance_fp, 5791)
    audit_fp = mix(audit_fp, certificate_fp, 5791)
    audit_fp = mix(audit_fp, 116883728, 5791)
    audit_fp = mix(audit_fp, 164784481, 5791)
    audit_fp = mix(audit_fp, 844877047, 5791)
    audit_fp = mix(audit_fp, 3, 5791)
    audit_fp = mix(audit_fp, 5, 5791)
    audit_fp = mix(audit_fp, 127, 5791)
    audit_fp = mix(audit_fp, 0, 5791)
    audit_fp = mix(audit_fp, 0, 5791)
    if audit_fp != 465507112 { return 4 }
    return 0
}
