//@ run-pass
//@ expect-stdout: 7
//@ expect-stdout: 8
//@ expect-stdout: 42
//@ expect-stdout: 3
//@ description: a binding from an indexed struct element uses that element's layout, not the first struct that shares a field name
struct IndexDecoy { tag: i64, slot: i64 }
struct IndexElem { slot: i64, extra: i64 }
struct IndexBox { items: [IndexElem; 2] }

fn main() -> i32 with IO, Mut, Panic, Alloc {
    let decoy = IndexDecoy { tag: 1, slot: 111 }
    var items: [IndexElem; 2] = [IndexElem { slot: 7, extra: 8 }, IndexElem { slot: 9, extra: 10 }]
    let from_local = items[0]
    println(from_local.slot)
    println(from_local.extra)
    let boxed = IndexBox { items: [IndexElem { slot: 42, extra: 3 }; 2] }
    let from_field = boxed.items[1]
    println(from_field.slot)
    println(from_field.extra)
    if decoy.slot != 111 { return 1 }
    return 0
}
