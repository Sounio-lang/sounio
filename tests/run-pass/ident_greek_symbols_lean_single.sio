//@ run-pass
//@ requires: lean_single
//@ expect-stdout-contains: IDENT: PASS
//@ description: ADR-015 row 11, first slice (probe id_epsilon) -- `ε`, `∂`, `∇` and `∞` are identifier characters, alone or inside a longer name. A name of exactly 256 bytes (probe id_long256) is still accepted.

fn main() with IO {
    let ε = 3
    let ∂x = 4
    let ∇f = 5
    let a∞ = 6
    let εε = ε + 1
    let bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb = 7
    var ok: i64 = 1
    if ε + ∂x + ∇f + a∞ != 18 { ok = 0 }
    if εε != 4 { ok = 0 }
    if bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb != 7 { ok = 0 }
    if ok == 1 { print("IDENT: PASS\n") } else { print("IDENT: FAIL\n") }
}
