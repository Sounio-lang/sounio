//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_SCATTER_FOOTPRINT_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use viz::dynamic_plot::{DynamicPlotSpec}
use viz::dynamic_fields::{dynamic_scatter_canvas,dynamic_scatter_svg}
use viz::scatter::{scatter_project}
use display::canvas::{Canvas,canvas_clear}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var x=numeric_buffer_new(4,32);var y=numeric_buffer_new(4,32);var a=integer_buffer_new(4,32)
 let xs:[f64;4]=[-1.5,9.5,4.0,4.0];let ys:[f64;4]=[4.0,4.0,-1.5,9.5]
 var i:i64=0
 while i<4 {let p=numeric_buffer_set(&!x,i,xs[i as usize]);let q=numeric_buffer_set(&!y,i,ys[i as usize]);let f=integer_buffer_set(&!a,i,1);i=i+1}
 let spec=DynamicPlotSpec{x:10,y:10,w:8,h:8,xmin:0.0,xmax:8.0,ymin:0.0,ymax:8.0,r:70,g:180,b:235,interval_kind:0,level:0.0}
 let pixels=heap_alloc(32*24*8) as *mut i64
 assert((pixels as i64)>0)
 var canvas=Canvas{pixels:pixels,width:32,height:24};canvas_clear(&!canvas,7,8,9)
 let drawn=dynamic_scatter_canvas(&!canvas,&spec,&x,&y,&a)
 let center=scatter_project(-1.5,4.0,0.0,8.0,0.0,8.0,10,10,8,8,false)
 let cx:i64=center.x;let cy:i64=center.y;let cs:i64=center.status
 print("FOOTPRINT_PROJECT ");print(cx);print(" ");print(cy);print(" ");println(cs)
 let status:i64=drawn.status;let painted:i64=drawn.painted;let outside:i64=drawn.outside
 print("FOOTPRINT_RESULT ");print(status);print(" ");print(painted);print(" ");println(outside)
 let left:i64=read_i64(canvas.pixels,14*32+10);let right:i64=read_i64(canvas.pixels,14*32+18)
 let bottom:i64=read_i64(canvas.pixels,18*32+14);let top:i64=read_i64(canvas.pixels,10*32+14)
 print("FOOTPRINT_BOUNDARY ");print(left);print(" ");print(right);print(" ");print(bottom);print(" ");println(top)
 assert(drawn.status==0 && drawn.painted==4)
 assert(left==4633835 && right==4633835 && bottom==4633835 && top==4633835)
 println("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"24\">")
 let shown=dynamic_scatter_svg(&spec,&x,&y,&a)
 println("</svg>")
 assert(shown.status==0 && shown.painted==4)
 heap_free(canvas.pixels as *mut i8);numeric_buffer_close(x);numeric_buffer_close(y);integer_buffer_close(a)
 println("STDLIB_DEEP_VIZ_SCATTER_FOOTPRINT_PASS");0
}
