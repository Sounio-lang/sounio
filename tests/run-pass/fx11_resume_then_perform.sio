//@ run-pass
//@ requires: madaros
//@ expect-stdout: 7
//@ description: FX-3 a perform reached after a resume is dispatched on the same driver; a non-resuming clause value becomes the handle answer (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-3

effect A { fn a() -> i64 fn b() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<A> { (perform A.a()) + (perform A.b()) } with {
        on a() -> resume(0) + 100
        on b() -> 7
    }
    println(r)
    0
}
