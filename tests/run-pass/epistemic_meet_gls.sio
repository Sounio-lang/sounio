//@ run-pass
//@ requires: madaros
//@ expect-stdout: EPISTEMIC_MEET_GLS_OK
//@ description: ADR-016 meet over GUM channels. meet(a, b) fuses by generalised least squares with the covariance the channels give, the fusion carries those channels (its covariance with a source equals its variance, the GLS identity), meet_birge expands three inconsistent sources by the Birge ratio, and en_of / birge_of / neff_of return the statistics. Expected values: tests/oracles/epistemic_meet/meet_cases.cpp (long double), relative 1e-12.

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-15 + 1.0e-12 * w
}

fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var bad: i64 = 0
    // A: independent sources.
    let k0 = measure(10.0, uncertainty: 0.3)
    let k1 = measure(10.4, uncertainty: 0.4)
    let a = k0.value
    let b = k1.value
    let mab = meet(a, b)
    bad = bad + report("A en_of", en_of(a, b), 0.4)
    bad = bad + report("A meet", mab, 10.144)
    bad = bad + report("A var", variance_of(mab), 0.0576)
    bad = bad + report("A neff", neff_of(a, b), 2.0)
    // B: a channel shared by both sources.
    let c0 = measure(0.0, uncertainty: 0.2)
    let c1 = measure(0.0, uncertainty: 0.3)
    let ks = measure(0.0, uncertainty: 0.25)
    let s = ks.value
    let p = 10.0 + c0.value + s
    let q = 10.3 + c1.value + 0.5 * s
    let mpq = meet(p, q)
    bad = bad + report("B en_of", en_of(p, q), 0.39307306924825102)
    bad = bad + report("B meet", mpq, 10.146781115879828)
    bad = bad + report("B var", variance_of(mpq), 0.067639484978540773)
    bad = bad + report("B cov(meet, p)", covariance_of(mpq, p), 0.067639484978540773)
    bad = bad + report("B neff", neff_of(p, q), 1.5380661874474379)
    // C: three independent, mutually inconsistent sources (E_n(x, y) = 1.06 > 1).
    let d0 = measure(1.0, uncertainty: 0.1)
    let d1 = measure(1.3, uncertainty: 0.1)
    let d2 = measure(0.8, uncertainty: 0.1)
    let x = d0.value
    let y = d1.value
    let z = d2.value
    let mb = meet_birge(x, y, z)
    bad = bad + report("C en_of", en_of(x, y), 1.0606601717798213)
    bad = bad + report("C birge_of", birge_of(x, y, z), 2.5166114784235832)
    bad = bad + report("C meet_birge", mb, 1.0333333333333333)
    bad = bad + report("C var", variance_of(mb), 0.021111111111111111)
    bad = bad + report("C neff", neff_of(x, y, z), 3.0)
    if bad == 0 {
        print("EPISTEMIC_MEET_GLS_OK\n")
        return 0
    }
    1
}
