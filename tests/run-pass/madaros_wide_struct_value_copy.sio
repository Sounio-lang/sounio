//@ run-pass
// Regression for the stale 64-field cap in emit_struct_value_copy (and
// emit_struct_value_copy_deep / struct_layout_field_pos's index-packing base)
// in self-hosted/ir/lower.sio -- PR #2667 review, comment 4104667818. Once
// struct_layout_slot_count was widened to allow 65-128-field structs (fixed
// alongside comment 4104342929), allocation for a wide struct worked, but the
// VALUE-COPY path (`var b = a` on a struct-typed local, or passing/returning by
// value) still only copied fields 0-63: fields 64-127 silently kept the fresh
// allocation's zero-initialized value instead of the source's. This is worse
// than the original segfault -- it is silent data corruption, not a crash. This
// test builds a 70-field struct (squarely in the previously-broken 65-128 range),
// value-copies it via a plain `let` binding of an existing local (which lowers
// through emit_struct_value_copy), and sums every field of the COPY, not the
// original -- so a truncated copy (fields 64+ read back as 0) changes the sum.
//@ requires: madaros
//@ expect-stdout: 2415

struct WideCopy70 {
    f0: i64,
    f1: i64,
    f2: i64,
    f3: i64,
    f4: i64,
    f5: i64,
    f6: i64,
    f7: i64,
    f8: i64,
    f9: i64,
    f10: i64,
    f11: i64,
    f12: i64,
    f13: i64,
    f14: i64,
    f15: i64,
    f16: i64,
    f17: i64,
    f18: i64,
    f19: i64,
    f20: i64,
    f21: i64,
    f22: i64,
    f23: i64,
    f24: i64,
    f25: i64,
    f26: i64,
    f27: i64,
    f28: i64,
    f29: i64,
    f30: i64,
    f31: i64,
    f32: i64,
    f33: i64,
    f34: i64,
    f35: i64,
    f36: i64,
    f37: i64,
    f38: i64,
    f39: i64,
    f40: i64,
    f41: i64,
    f42: i64,
    f43: i64,
    f44: i64,
    f45: i64,
    f46: i64,
    f47: i64,
    f48: i64,
    f49: i64,
    f50: i64,
    f51: i64,
    f52: i64,
    f53: i64,
    f54: i64,
    f55: i64,
    f56: i64,
    f57: i64,
    f58: i64,
    f59: i64,
    f60: i64,
    f61: i64,
    f62: i64,
    f63: i64,
    f64: i64,
    f65: i64,
    f66: i64,
    f67: i64,
    f68: i64,
    f69: i64,
}

fn make_wide_copy() -> WideCopy70 with Mut, Panic, Div {
    var w: WideCopy70
    w.f0 = 0
    w.f1 = 1
    w.f2 = 2
    w.f3 = 3
    w.f4 = 4
    w.f5 = 5
    w.f6 = 6
    w.f7 = 7
    w.f8 = 8
    w.f9 = 9
    w.f10 = 10
    w.f11 = 11
    w.f12 = 12
    w.f13 = 13
    w.f14 = 14
    w.f15 = 15
    w.f16 = 16
    w.f17 = 17
    w.f18 = 18
    w.f19 = 19
    w.f20 = 20
    w.f21 = 21
    w.f22 = 22
    w.f23 = 23
    w.f24 = 24
    w.f25 = 25
    w.f26 = 26
    w.f27 = 27
    w.f28 = 28
    w.f29 = 29
    w.f30 = 30
    w.f31 = 31
    w.f32 = 32
    w.f33 = 33
    w.f34 = 34
    w.f35 = 35
    w.f36 = 36
    w.f37 = 37
    w.f38 = 38
    w.f39 = 39
    w.f40 = 40
    w.f41 = 41
    w.f42 = 42
    w.f43 = 43
    w.f44 = 44
    w.f45 = 45
    w.f46 = 46
    w.f47 = 47
    w.f48 = 48
    w.f49 = 49
    w.f50 = 50
    w.f51 = 51
    w.f52 = 52
    w.f53 = 53
    w.f54 = 54
    w.f55 = 55
    w.f56 = 56
    w.f57 = 57
    w.f58 = 58
    w.f59 = 59
    w.f60 = 60
    w.f61 = 61
    w.f62 = 62
    w.f63 = 63
    w.f64 = 64
    w.f65 = 65
    w.f66 = 66
    w.f67 = 67
    w.f68 = 68
    w.f69 = 69
    w
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let original = make_wide_copy()
    // Value copy: a fresh local bound from an existing struct-typed local
    // lowers through emit_struct_value_copy (self-hosted/ir/lower.sio), which
    // is exactly the path this test is verifying.
    let copy = original
    var sum: i64 = 0
    sum = sum + copy.f0
    sum = sum + copy.f1
    sum = sum + copy.f2
    sum = sum + copy.f3
    sum = sum + copy.f4
    sum = sum + copy.f5
    sum = sum + copy.f6
    sum = sum + copy.f7
    sum = sum + copy.f8
    sum = sum + copy.f9
    sum = sum + copy.f10
    sum = sum + copy.f11
    sum = sum + copy.f12
    sum = sum + copy.f13
    sum = sum + copy.f14
    sum = sum + copy.f15
    sum = sum + copy.f16
    sum = sum + copy.f17
    sum = sum + copy.f18
    sum = sum + copy.f19
    sum = sum + copy.f20
    sum = sum + copy.f21
    sum = sum + copy.f22
    sum = sum + copy.f23
    sum = sum + copy.f24
    sum = sum + copy.f25
    sum = sum + copy.f26
    sum = sum + copy.f27
    sum = sum + copy.f28
    sum = sum + copy.f29
    sum = sum + copy.f30
    sum = sum + copy.f31
    sum = sum + copy.f32
    sum = sum + copy.f33
    sum = sum + copy.f34
    sum = sum + copy.f35
    sum = sum + copy.f36
    sum = sum + copy.f37
    sum = sum + copy.f38
    sum = sum + copy.f39
    sum = sum + copy.f40
    sum = sum + copy.f41
    sum = sum + copy.f42
    sum = sum + copy.f43
    sum = sum + copy.f44
    sum = sum + copy.f45
    sum = sum + copy.f46
    sum = sum + copy.f47
    sum = sum + copy.f48
    sum = sum + copy.f49
    sum = sum + copy.f50
    sum = sum + copy.f51
    sum = sum + copy.f52
    sum = sum + copy.f53
    sum = sum + copy.f54
    sum = sum + copy.f55
    sum = sum + copy.f56
    sum = sum + copy.f57
    sum = sum + copy.f58
    sum = sum + copy.f59
    sum = sum + copy.f60
    sum = sum + copy.f61
    sum = sum + copy.f62
    sum = sum + copy.f63
    sum = sum + copy.f64
    sum = sum + copy.f65
    sum = sum + copy.f66
    sum = sum + copy.f67
    sum = sum + copy.f68
    sum = sum + copy.f69
    print_int(sum)
    0
}
