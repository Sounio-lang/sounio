//@ run-pass
//@ known-failure: E230 under the default checker (the op this witnesses is refused by N3; N2 dataflow verified under SOUNIO_NS_DISABLE by scripts/ci/ns_dataflow_trace_gate.sh) and E245 (#1706, Knowledge x Knowledge arithmetic has no lowering on Madaros, independent of NS)
//@ requires: madaros
//@ expect-stdout: ns-unknown-absorb: PASS
//
// N2 witness (top absorption): union(unknown, X) = unknown for any X -- an
// unrepresentable/unknown source set must never be silently dropped in favour
// of the other operand (ns_union in self-hosted/check/noise_sets.sio already
// enforces this; this witness exercises it through the checker).
//
// mystery() is called with ZERO Knowledge arguments, so REQ-5 substitution
// has no evidence to draw from and the call keeps mystery's DECLARED return
// type's noise_set_id -- the unpropagated default (unknown, -1). This is the
// correct N2 behaviour, not a bug: call typing comes from the callee's
// SIGNATURE, not from re-deriving what the body happens to compute (the
// measure() inside mystery() gets its own real singleton, visible as its own
// "NS_TRACE measure=<h>" line, but that handle belongs to mystery's BODY
// check, not to the call expression's result).
//
// Observable only under SOUNIO_NS_TRACE=1: a "NS_TRACE measure=<h>" line for
// mystery's internal measure(), a "NS_TRACE call=-1" line for the mystery()
// call result, a second "NS_TRACE measure=<h2>" line for the fresh measured
// value, and a final "NS_TRACE union=-1" line -- unknown absorbs the real
// singleton rather than the union silently reverting to just h2.

fn mystery() -> Knowledge[f64, Measured] with IO {
    measure(9.0, uncertainty: 0.2)
}

fn main() -> i64 with IO {
    let u: Knowledge[f64, Measured] = mystery()
    let m: Knowledge[f64, Measured] = measure(5.0, uncertainty: 0.1)
    let s: Knowledge[f64, Derived] = u + m
    println("ns-unknown-absorb: PASS")
    0
}
