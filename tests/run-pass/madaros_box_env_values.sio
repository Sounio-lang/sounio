//@ run-pass
//@ expect-stdout-contains: BOX_ENV_VALUES_OK
// Both trace modes must preserve direct, boxed-field, and Box-param reads.
// The real imported call also exercises the multi-module counter boundary.
use fixtures::madaros_flat_arg_reset_leaf::{flat_reset_sum9}

struct BoxEnvDecoy { p: i64, q: i64, b: i64 }
struct BoxEnvInner { a: i64, b: i64, c: i64 }
struct BoxEnvOuter { boxed: Box<BoxEnvInner>, n: i64 }

fn box_env_via_param(value: Box<BoxEnvInner>) -> i64 with Mut, Panic, Div {
    (*value).b
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    if flat_reset_sum9(1, 2, 3, 4, 5, 6, 7, 8, 9) != 45 { return 1 }
    let decoy = BoxEnvDecoy { p: 1, q: 2, b: 3 }
    if decoy.b != 3 { return 2 }
    let direct = BoxEnvInner { a: 10, b: 20, c: 30 }
    if direct.b != 20 { return 3 }
    let outer = BoxEnvOuter { boxed: Box::new(BoxEnvInner { a: 10, b: 20, c: 30 }), n: 7 }
    if outer.boxed.b != 20 { return 4 }
    let through_param = box_env_via_param(Box::new(BoxEnvInner { a: 10, b: 20, c: 30 }))
    if through_param != 20 { return 5 }
    print("BOX_ENV_VALUES_OK\n")
    0
}
