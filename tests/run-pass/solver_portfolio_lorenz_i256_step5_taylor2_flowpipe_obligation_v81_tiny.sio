    audit_fp = mix(audit_fp, 246310129, 5407)
    audit_fp = mix(audit_fp, 5, 5407)
    audit_fp = mix(audit_fp, 15, 5407)
    audit_fp = mix(audit_fp, 255, 5407)
    if audit_fp != 622927323 { return 2 }

    var entry_fp: i64 = 101
