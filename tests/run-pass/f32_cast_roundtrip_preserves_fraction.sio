//@ run-pass
//@ expect-stdout: f32_cast_roundtrip: PASS
//@ description: PR #1737 w4b/w4 -- `as f32` must not fall through to float_to_int
// Regression port of tests/witness_matrix/cases/w4b_f32_roundtrip.sio and w4_f32_compare.sio
// into the standard suite, so the fix is guarded by `make test` and not only by the
// witness matrix's own gate.
//
// Pre-fix (pre-3d8cc0cb95) behavior: `as f32` matched neither the f64-target branch
// nor the integer classifier of lower_cast_expr_ref, so a float source fell through
// to the float_to_int arm: (1.5 as f32) became 1.0. The 1.5>1.0 comparison witness
// failed only as a side effect of that -- the comparison itself was measured correct
// in both directions, which is why both directions are asserted here too.
//
// The value-destroying truncation is closed; what `as f32` does NOT do (real IEEE
// binary32 narrowing) is pinned separately in f32_cast_no_real_narrowing_residual.sio.

fn main() -> i64 with IO, Mut, Div, Panic {
    var bad: i64 = 0

    // w4b, the root-cause shape: one f32 on a purely f64 arithmetic path.
    let x: f32 = 1.5 as f32
    let d: f64 = x as f64
    let t: f64 = d * 100.0
    if (t as i64) != 150 { bad = bad + 1 }   // pre-fix: 100 (truncated toward zero)

    // Same probe at 2.5: pre-fix gave 200, correct is 250.
    let u: f32 = 2.5 as f32
    let du: f64 = u as f64
    let tu: f64 = du * 100.0
    if (tu as i64) != 250 { bad = bad + 1 }  // pre-fix: 200

    // w4, the comparison both ways. These were correct pre-fix (they fail only via
    // the truncation above); asserted so a future change to either comparison arm
    // or to the cast cannot silently trade one defect for the other.
    let a: f32 = 1.5 as f32
    let b: f32 = 1.0 as f32
    if !(a > b) { bad = bad + 1 }
    if a < b { bad = bad + 1 }
    let e: f32 = 2.5 as f32
    let f: f32 = 1.0 as f32
    if !(e > f) { bad = bad + 1 }

    if bad != 0 {
        print("f32_cast_roundtrip: FAIL ")
        print_int(bad)
        print("\n")
        return 1
    }
    print("f32_cast_roundtrip: PASS\n")
    0
}
