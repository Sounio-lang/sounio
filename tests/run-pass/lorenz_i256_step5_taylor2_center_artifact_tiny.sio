//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 center candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn instance_fp() -> i64 {
    var fp: i64 = 1067
    fp = mix(fp, 5, 4799)
    fp = mix(fp, 10, 4799)
    fp = mix(fp, 28, 4799)
    fp = mix(fp, 8, 4799)
    fp = mix(fp, 3, 4799)
    fp = mix(fp, 4294967296, 4799)
    fp = mix(fp, 42949672, 4799)
    fp = mix(fp, 96, 4799)
    fp = mix(fp, 4920371098, 4799)
    fp = mix(fp, 8816077911, 4799)
    fp = mix(fp, 4092986080, 4799)
    fp = mix(fp, 5309941770, 4799)
    fp = mix(fp, 10058731223, 4799)
    fp = mix(fp, 4084837935, 4799)
    fp = mix(fp, 422368008, 4799)
    fp = mix(fp, 577119901, 4799)
    fp = mix(fp, 693506658, 4799)
    fp = mix(fp, 389624150, 4799)
    fp = mix(fp, 931268564, 4799)
    fp = mix(fp, 900912795, 4799)
    fp = mix(fp, 0, 4799)
    fp = mix(fp, 0, 4799)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 668835069 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1069
    fp = mix(fp, instance, 4801)
    fp = mix(fp, 133081411987, 4801)
    fp = mix(fp, 405415232, 4801)
    fp = mix(fp, 10099814960, 4801)
    fp = mix(fp, 2149068118, 4801)
    fp = mix(fp, 10914629546, 4801)
    fp = mix(fp, 2, 4801)
    fp = mix(fp, 389570672, 4801)
    fp = mix(fp, 2544410448, 4801)
    fp = mix(fp, 1242653312, 4801)
    fp = mix(fp, 4228538720, 4801)
    fp = mix(fp, 8148145, 4801)
    fp = mix(fp, 2911449872, 4801)
    fp = mix(fp, 5309941770, 4801)
    fp = mix(fp, 10058731223, 4801)
    fp = mix(fp, 4084837935, 4801)
    fp = mix(fp, 127, 4801)
    fp = mix(fp, 63, 4801)
    fp = mix(fp, 7, 4801)
    fp = mix(fp, 15, 4801)
    fp = mix(fp, 0, 4801)
    fp = mix(fp, 0, 4801)
    fp = mix(fp, ok_mask, 4801)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 668835069 { return 0 - 1 }
    if certificate != 823414876 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1079
    fp = mix(fp, instance, 4813)
    fp = mix(fp, certificate, 4813)
    fp = mix(fp, 422368008, 4813)
    fp = mix(fp, 577119901, 4813)
    fp = mix(fp, 693506658, 4813)
    fp = mix(fp, 389624150, 4813)
    fp = mix(fp, 931268564, 4813)
    fp = mix(fp, 900912795, 4813)
    fp = mix(fp, 1, 4813)
    fp = mix(fp, 5, 4813)
    fp = mix(fp, 5309941770, 4813)
    fp = mix(fp, 10058731223, 4813)
    fp = mix(fp, 4084837935, 4813)
    fp = mix(fp, 15, 4813)
    fp = mix(fp, 0, 4813)
    fp = mix(fp, 0, 4813)
    fp = mix(fp, ok_mask, 4813)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 171451971 { return 0 - 1 }
    if instance != 668835069 { return 0 - 1 }
    if certificate != 823414876 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1087
    fp = mix(fp, artifact, 4817)
    fp = mix(fp, instance, 4817)
    fp = mix(fp, certificate, 4817)
    fp = mix(fp, 422368008, 4817)
    fp = mix(fp, 577119901, 4817)
    fp = mix(fp, 693506658, 4817)
    fp = mix(fp, 389624150, 4817)
    fp = mix(fp, 931268564, 4817)
    fp = mix(fp, 900912795, 4817)
    fp = mix(fp, 5, 4817)
    fp = mix(fp, 1, 4817)
    fp = mix(fp, 127, 4817)
    fp = mix(fp, 63, 4817)
    fp = mix(fp, 7, 4817)
    fp = mix(fp, 15, 4817)
    fp = mix(fp, 0, 4817)
    fp = mix(fp, 0, 4817)
    fp = mix(fp, ok_mask, 4817)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let z4: i256 = 4092986080 as i256
    let dy_scaled_q: i256 = 133081411987 as i256
    let dy_scaled_r: i256 = 405415232 as i256
    let xy_scaled_q: i256 = 10099814960 as i256
    let xy_scaled_r: i256 = 2149068118 as i256
    let beta_q: i256 = 10914629546 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 389570672 as i256
    let x_inc_r: i256 = 2544410448 as i256
    let y_inc_q: i256 = 1242653312 as i256
    let y_inc_r: i256 = 4228538720 as i256
    let z_drop_q: i256 = 8148145 as i256
    let z_drop_r: i256 = 2911449872 as i256

    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let dy_num: i256 = x4 * ((28 as i256) * scale - z4)
    let xy_num: i256 = x4 * y4
    let beta_num_z: i256 = (8 as i256) * z4
    let dy: i256 = dy_scaled_q - y4
    let z_drop_num: i256 = beta_q - xy_scaled_q

    var point_replay_mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { point_replay_mask = point_replay_mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 { point_replay_mask = point_replay_mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { point_replay_mask = point_replay_mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { point_replay_mask = point_replay_mask + 32 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, z_drop_r) == 1 { point_replay_mask = point_replay_mask + 64 }
    if point_replay_mask != 127 { return 1 }

    var final_center_mask: i64 = 0
    if x4 + x_inc_q == 5309941770 as i256 { final_center_mask = final_center_mask + 1 }
    if y4 + y_inc_q == 10058731223 as i256 { final_center_mask = final_center_mask + 2 }
    if z4 - z_drop_q == 4084837935 as i256 { final_center_mask = final_center_mask + 4 }
    if final_center_mask != 7 { return 2 }

    let ok_mask: i64 = 255
    let inst = instance_fp()
    if inst != 668835069 { return 3 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 823414876 { return 4 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 171451971 { return 5 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 862108922 { return 6 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, scale) != 0 { return 7 }
    if certificate_fp(inst, 254) != (0 - 1) { return 8 }
    return 0
}
