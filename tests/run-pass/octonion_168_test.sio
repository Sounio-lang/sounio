//@ run-pass
// THE 168 THEOREM — Computational Verification
//
// Enumerate all ordered triples (i,j,k) of distinct imaginary
// octonion basis elements (i,j,k ∈ {1..7}, all different).
// Count: how many have zero associator (Fano) vs nonzero (non-Fano)?
//
// Expected: 210 distinct triples = 42 Fano + 168 non-Fano
//   42 = 7 lines × 3! orderings
//   168 = |PSL(2,7)| = the collineation group of the Fano plane
//
// This is the 168 theorem verified by the Sounio compiler.

// --- Integer XOR for 3-bit indices ---
fn xor3(a: i64, b: i64) -> i64 {
    let a0 = a - (a / 2) * 2
    let b0 = b - (b / 2) * 2
    let a1 = (a / 2) - (a / 4) * 2
    let b1 = (b / 2) - (b / 4) * 2
    let a2 = a / 4
    let b2 = b / 4
    let x0 = if a0 == b0 { 0 } else { 1 }
    let x1 = if a1 == b1 { 0 } else { 1 }
    let x2 = if a2 == b2 { 0 } else { 1 }
    x0 + 2 * x1 + 4 * x2
}

// --- Cayley-Dickson sign σ(a,b) at tower level `bits` ---
// Exact copy of the verified ir_cd_sigma from algebra.sio.
fn cdsig_r(a: i64, b: i64, bits: i64) -> i64 with Mut, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cdsig_r(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cdsig_r(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cdsig_r(a_lo, b_lo, bits - 1) }
        return 0 - cdsig_r(a_lo, b_lo, bits - 1)
    }
    // a_hi == 1, b_hi == 1
    if b_lo == 0 { return 0 - cdsig_r(b_lo, a_lo, bits - 1) }
    cdsig_r(b_lo, a_lo, bits - 1)
}

// Octonion sign: σ(a,b) at bits=3
fn cdsig(a: i64, b: i64) -> i64 with Mut, Div {
    cdsig_r(a, b, 3)
}

// --- Fano predicate: is (i,j,k) on a Fano line? ---
fn is_fano(i: i64, j: i64, k: i64) -> bool with Mut, Div {
    let ij = xor3(i, j)
    let a1 = cdsig(i, j)
    let a2 = cdsig(ij, k)
    let alpha = a1 * a2
    let jk = xor3(j, k)
    let b1 = cdsig(j, k)
    let b2 = cdsig(i, jk)
    let beta = b1 * b2
    alpha == beta
}

fn main() -> i32 with IO, Mut, Div {
    var fano_count: i64 = 0
    var nonfano_count: i64 = 0
    var total: i64 = 0

    var i: i64 = 1
    while i <= 7 {
        var j: i64 = 1
        while j <= 7 {
            var k: i64 = 1
            while k <= 7 {
                if i != j && j != k && i != k {
                    total = total + 1
                    if is_fano(i, j, k) {
                        fano_count = fano_count + 1
                    } else {
                        nonfano_count = nonfano_count + 1
                    }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    println("=== THE 168 THEOREM ===")
    println("Total distinct triples (i!=j!=k from {1..7}):")
    println(total)
    println("Fano (associative):")
    println(fano_count)
    println("Non-Fano (non-associative):")
    println(nonfano_count)
    println("")

    if total == 210 {
        println("PASS: 210 distinct triples")
    } else {
        println("FAIL: expected 210")
        return 1
    }

    if fano_count == 42 {
        println("PASS: 42 Fano triples (7 lines x 6 orderings)")
    } else {
        println("FAIL: expected 42 Fano")
        return 1
    }

    if nonfano_count == 168 {
        println("PASS: 168 = |PSL(2,7)| non-associative triples")
    } else {
        println("FAIL: expected 168")
        return 1
    }

    println("")
    println("The 168 theorem holds. The Fano plane governs.")

    0
}
