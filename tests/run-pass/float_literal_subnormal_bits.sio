//@ run-pass
//@ expect-stdout: PASS float_literal_subnormal_bits
// A subnormal float literal lowers to its correctly rounded binary64 value
// (gradual underflow, round half to even), whatever the engine.
//
// Madaros a1307ca6 lowered every literal in [2^-1075, 2^-1074) to 0.0: its
// bignum reader kept no significand bit there and returned zero instead of
// rounding. That band is at or above half the smallest subnormal, so all of it
// except the exact tie 2^-1075 rounds up to 2^-1074 (bits 1). 4.9e-324,
// 4.0e-324, 3.5e-324 and 2.4703282292062328e-324 came out 0; glibc strtod
// gives 1. 2.4703282292062327e-324 is just below 2^-1075 and is 0.
//
// Every expected value below was computed with exact integer arithmetic
// (N * 2^s / 10^k as big integers, then round half to even), not with a float.

const LIT_CONST_MIN_SUB: f64 = 4.9e-324
const LIT_CONST_1EM310: f64 = 1.0e-310

fn check(tag: string, x: f64, want: i64) -> i64 with IO {
    let got = f64_to_bits(x)
    if got != want {
        print("FAIL "); print(tag)
        print(" got="); print_int(got)
        print(" want="); print_int(want)
        println("")
        return 1
    }
    return 0
}

fn main() -> i64 with IO, Mut {
    var bad: i64 = 0
    // [2^-1075, 2^-1074): above half the smallest subnormal rounds up to it.
    bad = bad + check("4.9e-324", 4.9e-324, 1)
    bad = bad + check("4.0e-324", 4.0e-324, 1)
    bad = bad + check("3.5e-324", 3.5e-324, 1)
    bad = bad + check("0.49e-323", 0.49e-323, 1)
    bad = bad + check("2.4703282292062328e-324", 2.4703282292062328e-324, 1)
    // Below 2^-1075 (2.47032822920623272e-324): zero.
    bad = bad + check("2.4703282292062327e-324", 2.4703282292062327e-324, 0)
    bad = bad + check("2.4e-324", 2.4e-324, 0)
    bad = bad + check("1e-400", 1e-400, 0)
    // At and above the smallest subnormal.
    bad = bad + check("5e-324", 5e-324, 1)
    // Either side of 3 * 2^-1075, the tie between bits 1 and bits 2.
    bad = bad + check("7.4109846876186981e-324", 7.4109846876186981e-324, 1)
    bad = bad + check("7.4109846876186982e-324", 7.4109846876186982e-324, 2)
    bad = bad + check("9.8813129168249309e-324", 9.8813129168249309e-324, 2)
    bad = bad + check("1.0e-323", 1.0e-323, 2)
    bad = bad + check("2.0e-323", 2.0e-323, 4)
    bad = bad + check("3.0e-323", 3.0e-323, 6)
    // Deeper in the subnormal range.
    bad = bad + check("1.0e-320", 1.0e-320, 2024)
    bad = bad + check("1.23456789e-315", 1.23456789e-315, 249879323)
    bad = bad + check("1.0e-310", 1.0e-310, 20240225330731)
    // The subnormal/normal boundary: the largest subnormal, and the smallest
    // normal reached by rounding up from just below it.
    bad = bad + check("2.2250738585072011e-308", 2.2250738585072011e-308, 4503599627370495)
    bad = bad + check("2.2250738585072012e-308", 2.2250738585072012e-308, 4503599627370496)
    bad = bad + check("2.2250738585072014e-308", 2.2250738585072014e-308, 4503599627370496)
    bad = bad + check("4.4501477170144023e-308", 4.4501477170144023e-308, 9007199254740991)
    // A named const lowers through its own site.
    bad = bad + check("const 4.9e-324", LIT_CONST_MIN_SUB, 1)
    bad = bad + check("const 1.0e-310", LIT_CONST_1EM310, 20240225330731)
    if bad != 0 {
        println("FAIL float_literal_subnormal_bits")
        return 1
    }
    println("PASS float_literal_subnormal_bits")
    return 0
}
