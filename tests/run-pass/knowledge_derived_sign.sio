//@ run-pass
//@ requires: madaros
//@ expect-stdout: DERIVED_SIGN_OK
// The co-signed interval is Derived, not a fresh measurement.
// The variance is attached in this function: a returned f64 drops it.

ontology Lab {
    class Quantity { property amount: f64 where amount >= 0.0 }
    class Pressure subclass_of Quantity
}

fn read_var(p: Knowledge[Pressure, ValidUntil("2026-12-31"), epsilon < 0.05, Derived]) -> f64 with Epistemic, Mut, Div {
    variance_of(p.value)
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let origin = 0.0
    let noise: Knowledge<f64> = measure(origin, uncertainty: 0.5)
    let branded: Pressure = 10.5 + noise.value
    let leaving: Knowledge[Pressure, ValidUntil("2026-12-31"), epsilon < 0.05, Derived] = Knowledge {
        value: branded,
        epsilon: 0.01,
        validity: "2027-06-30",
        provenance: "cell"
    }
    let v = read_var(leaving)
    print("v ")
    print_f64(v)
    print("\n")
    let d = v - 0.25
    let ad = if d < 0.0 { 0.0 - d } else { d }
    if ad < 0.0001 {
        println("DERIVED_SIGN_OK")
        return 0
    }
    println("DERIVED_SIGN_FAIL")
    1
}
