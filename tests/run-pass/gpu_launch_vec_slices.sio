//@ run-pass
//@ expect-stdout: PASS: GPU launch vec_slices

kernel fn vec_mul_launch(n: i64, a: &[f64], b: &[f64], out: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        out[tid as usize] = a[tid as usize] * b[tid as usize]
    }
}

kernel fn vec_sub_in_place_launch(n: i64, a: &![f64], b: &[f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] - b[tid as usize]
    }
}

kernel fn vec_scale_out_launch(n: i64, input: &[f64], factor: f64, output: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        output[tid as usize] = input[tid as usize] * factor
    }
}

kernel fn vec_scale_in_place_launch(n: i64, a: &![f64], factor: f64) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] * factor
    }
}

kernel fn vec_add_scalar_in_place_launch(n: i64, a: &![f64], bias: f64) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] + bias
    }
}

kernel fn vec_div_scalar_out_launch(n: i64, input: &[f64], factor: f64, output: &![f64]) with GPU, Div {
    let tid = gpu_thread_id_x()
    if tid < n {
        output[tid as usize] = input[tid as usize] / factor
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU, Div {
    let n: i64 = 64
    let grid = (1, 1, 1)
    let block = (64, 1, 1)

    var mul_a: [f64; 64] = [0.0; 64]
    var mul_b: [f64; 64] = [0.0; 64]
    var mul_out: [f64; 64] = [0.0; 64]
    var sub_a: [f64; 64] = [0.0; 64]
    var sub_b: [f64; 64] = [0.0; 64]
    var scale_in: [f64; 64] = [0.0; 64]
    var scale_src: [f64; 64] = [0.0; 64]
    var scale_out: [f64; 64] = [0.0; 64]
    var scalar_add_in: [f64; 64] = [0.0; 64]
    var scalar_div_src: [f64; 64] = [0.0; 64]
    var scalar_div_out: [f64; 64] = [0.0; 64]

    var i: i64 = 0
    while i < n {
        mul_a[i as usize] = (i as f64) + 1.0
        mul_b[i as usize] = 2.0
        sub_a[i as usize] = 10.0 + i as f64
        sub_b[i as usize] = i as f64
        scale_in[i as usize] = (i as f64) + 1.0
        scale_src[i as usize] = (i as f64) + 2.0
        scalar_add_in[i as usize] = (i as f64) + 1.0
        scalar_div_src[i as usize] = (i as f64) + 8.0
        i = i + 1
    }

    perform GPU.launch(vec_mul_launch, grid, block)(n, &mul_a, &mul_b, &!mul_out)
    perform GPU.launch(vec_sub_in_place_launch, grid, block)(n, &!sub_a, &sub_b)
    perform GPU.launch(vec_scale_out_launch, grid, block)(n, &scale_src, 4.0, &!scale_out)
    perform GPU.launch(vec_scale_in_place_launch, grid, block)(n, &!scale_in, 3.0)
    perform GPU.launch(vec_add_scalar_in_place_launch, grid, block)(n, &!scalar_add_in, 2.5)
    perform GPU.launch(vec_div_scalar_out_launch, grid, block)(n, &scalar_div_src, 2.0, &!scalar_div_out)
    perform GPU.sync()

    if mul_out[0] > 1.99 && mul_out[0] < 2.01 &&
       mul_out[10] > 21.99 && mul_out[10] < 22.01 &&
       sub_a[0] > 9.99 && sub_a[0] < 10.01 &&
       sub_a[10] > 9.99 && sub_a[10] < 10.01 &&
       scale_out[0] > 7.99 && scale_out[0] < 8.01 &&
       scale_out[10] > 47.99 && scale_out[10] < 48.01 &&
       scale_in[0] > 2.99 && scale_in[0] < 3.01 &&
       scale_in[10] > 32.99 && scale_in[10] < 33.01 &&
       scalar_add_in[0] > 3.49 && scalar_add_in[0] < 3.51 &&
       scalar_add_in[10] > 13.49 && scalar_add_in[10] < 13.51 &&
       scalar_div_out[0] > 3.99 && scalar_div_out[0] < 4.01 &&
       scalar_div_out[10] > 8.99 && scalar_div_out[10] < 9.01 {
        println("PASS: GPU launch vec_slices")
    } else {
        println("FAIL: GPU launch vec_slices")
    }
    0
}
