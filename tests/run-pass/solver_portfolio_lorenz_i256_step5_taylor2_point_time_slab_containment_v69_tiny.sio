//@ run-pass
//@ description: Tiny portfolio v69 smoke for Lorenz i256 step-5 point time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1021
    receipt_fp = mix(receipt_fp, 693506658, 4721)
    receipt_fp = mix(receipt_fp, 389624150, 4721)
    receipt_fp = mix(receipt_fp, 807967578, 4721)
    receipt_fp = mix(receipt_fp, 446284704, 4721)
    receipt_fp = mix(receipt_fp, 565606826, 4721)
    receipt_fp = mix(receipt_fp, 219898081, 4721)
    receipt_fp = mix(receipt_fp, 144889913, 4721)
    receipt_fp = mix(receipt_fp, 931268564, 4721)
    receipt_fp = mix(receipt_fp, 900912795, 4721)
    receipt_fp = mix(receipt_fp, 5, 4721)
    receipt_fp = mix(receipt_fp, 19, 4721)
    receipt_fp = mix(receipt_fp, 255, 4721)
    if receipt_fp != 920537800 { return 1 }

    var audit_fp: i64 = 1031
    audit_fp = mix(audit_fp, receipt_fp, 4729)
    audit_fp = mix(audit_fp, 693506658, 4729)
    audit_fp = mix(audit_fp, 389624150, 4729)
    audit_fp = mix(audit_fp, 807967578, 4729)
    audit_fp = mix(audit_fp, 446284704, 4729)
    audit_fp = mix(audit_fp, 931268564, 4729)
    audit_fp = mix(audit_fp, 900912795, 4729)
    audit_fp = mix(audit_fp, 144889913, 4729)
    audit_fp = mix(audit_fp, 5, 4729)
    audit_fp = mix(audit_fp, 19, 4729)
    audit_fp = mix(audit_fp, 255, 4729)
    if audit_fp != 92616329 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 72, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 72, 1103)
    if entry_fp != 857456119 { return 3 }

    let manifest_fp: i64 = 428032311
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 69, 1871)
    result_fp = mix(result_fp, 73, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 61, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 715867468 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 69, 1907)
    family_fp = mix(family_fp, 73, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 56, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 485990494 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 69, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 103473156 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 69, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 10042504 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 69, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 838284677 { return 8 }
    return 0
}
