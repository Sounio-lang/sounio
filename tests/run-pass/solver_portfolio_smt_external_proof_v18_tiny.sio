//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v18 smoke for SMT external proof reconstruction entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn smt_external_proof_certificate_fingerprint(
    formula_fp: i64,
    assumptions_fp: i64,
    core_fp: i64,
    proof_format_code: i64,
    external_checker_code: i64,
    reconstruction_status: i64,
    solver_result: i64) -> i64 with Mod {
    if formula_fp != 796206516 { return 0 - 1 }
    if assumptions_fp != 106325289 { return 0 - 1 }
    if core_fp != 666359709 { return 0 - 1 }
    if proof_format_code != 1 { return 0 - 1 }
    if external_checker_code != 1 { return 0 - 1 }
    if reconstruction_status != 1 { return 0 - 1 }
    if solver_result != 0 { return 0 - 1 }

    var fp: i64 = 173
    fp = portfolio_mix(fp, formula_fp, 1999)
    fp = portfolio_mix(fp, assumptions_fp, 1999)
    fp = portfolio_mix(fp, core_fp, 1999)
    fp = portfolio_mix(fp, proof_format_code, 1999)
    fp = portfolio_mix(fp, external_checker_code, 1999)
    fp = portfolio_mix(fp, reconstruction_status, 1999)
    fp = portfolio_mix(fp, solver_result, 1999)
    return fp
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 21 { return 0 - 1 }
    if instance_fp != 106325289 { return 0 - 1 }
    if certificate_fp != 770769284 { return 0 - 1 }
    if result_code != 0 { return 0 - 1 }
    if checker_code != 21 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v18_manifest_fingerprint(smt_external_entry_fp: i64) -> i64 with Mod {
    if smt_external_entry_fp != 46718256 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 18, 1151)
    fp = portfolio_mix(fp, 22, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, smt_external_entry_fp, 1151)
    return fp
}

fn portfolio_v18_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 265423024 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 18, 1871)
    fp = portfolio_mix(fp, 22, 1871)
    fp = portfolio_mix(fp, 8, 1871)
    fp = portfolio_mix(fp, 12, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v18_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 265423024 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 18, 1907)
    fp = portfolio_mix(fp, 22, 1907)
    fp = portfolio_mix(fp, 4, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 12, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v18_readiness_fingerprint(
    manifest_fp: i64,
    result_coverage_fp: i64,
    family_coverage_fp: i64,
    acceptance_receipt_fp: i64,
    audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 265423024 { return 0 - 1 }
    if result_coverage_fp != 184063844 { return 0 - 1 }
    if family_coverage_fp != 22024619 { return 0 - 1 }
    if acceptance_receipt_fp != 563343445 { return 0 - 1 }
    if audit_receipt_fp != 637718997 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 18, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let cert_fp = smt_external_proof_certificate_fingerprint(
        796206516, 106325289, 666359709, 1, 1, 1, 0)
    if cert_fp != 770769284 { return 1 }

    let entry_fp = portfolio_entry_fingerprint(21, 106325289, cert_fp, 0, 21)
    if entry_fp != 46718256 { return 2 }

    let manifest_fp = portfolio_v18_manifest_fingerprint(entry_fp)
    if manifest_fp != 265423024 { return 3 }

    let result_coverage_fp = portfolio_v18_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 184063844 { return 4 }

    let family_coverage_fp = portfolio_v18_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 22024619 { return 5 }

    if portfolio_v18_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp, 563343445,
        637718997) != 958828933 { return 6 }

    if smt_external_proof_certificate_fingerprint(
        796206516, 106325289, 666359709, 2, 1, 1, 0) != (0 - 1) { return 7 }
    if portfolio_entry_fingerprint(21, 106325289, cert_fp, 1, 21) != (0 - 1) { return 8 }
    if portfolio_v18_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 9 }
    if portfolio_v18_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp, 563343445,
        637718998) != (0 - 1) { return 10 }

    return 0
}
