//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF_STRUCT_FIELD PASS
//
// Copilot review (PR #2516), finding on the twelfth review round: the
// single-array classifier's ExprIf/ExprMatch/ExprBlock recursion
// (expr_result_is_f64_array_ref, self-hosted/ir/lower.sio) re-enters
// itself for each arm/block-tail, but had no ExprFieldAccess arm -- so
// `(if cond { left.values } else { right.values }, 0)` (a struct-field
// f64 array) fell through to `false` for both arms, even though
// tuple_lit_slot_is_f64_array_ref already classifies `holder.values`
// directly via field_array_elem_is_float_for_base_ref. Fixed by
// delegating ExprFieldAccess in the control-flow recursion to that same
// classifier.
struct Holder {
    values: [f64; 2],
}

fn main() -> i32 with IO, Mut, Panic {
    var left = Holder { values: [0.0; 2] }
    var right = Holder { values: [0.0; 2] }
    left.values[0] = 1.5
    right.values[0] = 4.5

    let cond = true
    let (a, n) = (if cond { left.values } else { right.values }, 0)
    let s0: f64 = a[0] * 2.0

    if s0 == 3.0 && n == 0 {
        println("TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF_STRUCT_FIELD PASS")
        return 0
    }
    1
}
