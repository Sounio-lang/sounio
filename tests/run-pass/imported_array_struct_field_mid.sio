//@ ignore
// Helper module for tests/run-pass/imported_array_struct_field.sio -- not a
// standalone test. Reads `Owner.leaves[i].value_len` from a module that only
// IMPORTS Owner/Leaf. This is the read site that regressed: the external-item
// preseed used to register imported structs with an EMPTY array-element type
// name, so `o.leaves[i].value_len` here fell back to the name-only global field
// lookup and read Other's index 4.

use imported_array_struct_field_decl::*

pub fn mid_read_value_len(o: &Owner) -> i64 {
    o.leaves[0].value_len as i64
}

pub fn mid_read_tag(o: &Owner) -> i64 {
    o.leaves[0].tag as i64
}
