//@ run-pass
//@ expect-stdout-contains: self.n=7
//@ expect-stdout-contains: self.boxed.a=10
//@ expect-stdout-contains: self.boxed.b=20
//@ expect-stdout-contains: self.boxed.c=30
//
// `self.field.subfield` inside a method. The parser gives the receiver a
// dummy_type_expr() (parser/items.sio:1741) unless the source writes `self: T`,
// so struct_types[self] was empty and the chained field index fell to the
// cross-struct first-match scan.
//
// Measured before the fix, under Madaros:   7 / 1 / 0 / 0
// Measured before the fix, under lean_single: 7 / 10 / 30 / 30
// Both wrong, differently. A wrong NUMBER, never a diagnostic.
//
// `self.n` is the control: a direct field through the receiver was already
// right (first-match happened to agree), so a fix that breaks it broke the
// receiver binding rather than the chain.
//
// BOTH ENGINES now pass, by two different repairs: Madaros needed the receiver
// typed AND the Box field unwrapped; lean_single needed only the Box unwrap,
// because its `self` was already typed. run_pass_output_gate.sh in compare mode
// iterates the baseline, so a test absent from it is not enforced either way.

struct Decoy { p: i64, q: i64, b: i64 }
struct Inner { a: i64, b: i64, c: i64 }
struct Holder { boxed: Box<Inner>, n: i64 }

impl Holder {
    fn direct(self) -> i64 with Mut, Panic, Div, Alloc { self.n }
    fn chained_a(self) -> i64 with Mut, Panic, Div, Alloc { self.boxed.a }
    fn chained_b(self) -> i64 with Mut, Panic, Div, Alloc { self.boxed.b }
    fn chained_c(self) -> i64 with Mut, Panic, Div, Alloc { self.boxed.c }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let d = Decoy { p: 1, q: 2, b: 3 }
    print("decoy=") println(d.b)
    let h = Holder { boxed: Box::new(Inner { a: 10, b: 20, c: 30 }), n: 7 }
    print("self.n=") println(h.direct())
    print("self.boxed.a=") println(h.chained_a())
    print("self.boxed.b=") println(h.chained_b())
    print("self.boxed.c=") println(h.chained_c())
    println("PASS")
    0
}
