//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v114 smoke for Lorenz i256 step-2 Taylor-2 point time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2083
    receipt_fp = mix(receipt_fp, 268229078, 6101)
    receipt_fp = mix(receipt_fp, 223161586, 6101)
    receipt_fp = mix(receipt_fp, 149302752, 6101)
    receipt_fp = mix(receipt_fp, 253587342, 6101)
    receipt_fp = mix(receipt_fp, 727603483, 6101)
    receipt_fp = mix(receipt_fp, 766195979, 6101)
    receipt_fp = mix(receipt_fp, 908862257, 6101)
    receipt_fp = mix(receipt_fp, 633359277, 6101)
    receipt_fp = mix(receipt_fp, 421619310, 6101)
    receipt_fp = mix(receipt_fp, 2, 6101)
    receipt_fp = mix(receipt_fp, 19, 6101)
    receipt_fp = mix(receipt_fp, 255, 6101)
    if receipt_fp != 468517435 { return 1 }

    var audit_fp: i64 = 2087
    audit_fp = mix(audit_fp, receipt_fp, 6109)
    audit_fp = mix(audit_fp, 268229078, 6109)
    audit_fp = mix(audit_fp, 223161586, 6109)
    audit_fp = mix(audit_fp, 149302752, 6109)
    audit_fp = mix(audit_fp, 253587342, 6109)
    audit_fp = mix(audit_fp, 633359277, 6109)
    audit_fp = mix(audit_fp, 421619310, 6109)
    audit_fp = mix(audit_fp, 908862257, 6109)
    audit_fp = mix(audit_fp, 2, 6109)
    audit_fp = mix(audit_fp, 19, 6109)
    audit_fp = mix(audit_fp, 255, 6109)
    if audit_fp != 402376335 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 117, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 117, 1103)
    if entry_fp != 675936756 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 114, 1151)
    manifest_fp = mix(manifest_fp, 118, 1151)
    manifest_fp = mix(manifest_fp, 766195979, 1151)
    manifest_fp = mix(manifest_fp, 727603483, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 237552477 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 114, 1871)
    result_fp = mix(result_fp, 118, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 106, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 861238148 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 114, 1907)
    family_fp = mix(family_fp, 118, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 101, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 345583750 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 114, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 569422547 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 114, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 367930703 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 114, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
