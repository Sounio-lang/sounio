//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v173 smoke for Lorenz i256 cover child-1 validation guard non-claim

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let receipt: i64 = 703500225
    let audit: i64 = 906600492

    var entry: i64 = 101
    entry = mix(entry, 176, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 176, 1103)
    if entry != 595323045 { return 1 }

    var manifest: i64 = 107
    manifest = mix(manifest, 173, 1151)
    manifest = mix(manifest, 177, 1151)
    manifest = mix(manifest, 413882488, 1151)
    manifest = mix(manifest, 227808528, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 136253071 { return 2 }

    var result: i64 = 131
    result = mix(result, 173, 1871)
    result = mix(result, 177, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 165, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 578053856 { return 3 }

    var family: i64 = 149
    family = mix(family, 173, 1907)
    family = mix(family, 177, 1907)
    family = mix(family, 6, 1907)
    family = mix(family, 4, 1907)
    family = mix(family, 3, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, 160, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, manifest, 1907)
    if family != 976602400 { return 4 }

    var acceptance: i64 = 137
    acceptance = mix(acceptance, 173, 1889)
    acceptance = mix(acceptance, manifest, 1889)
    acceptance = mix(acceptance, result, 1889)
    if acceptance != 802326634 { return 5 }

    var audit_receipt: i64 = 157
    audit_receipt = mix(audit_receipt, 173, 1931)
    audit_receipt = mix(audit_receipt, manifest, 1931)
    audit_receipt = mix(audit_receipt, result, 1931)
    audit_receipt = mix(audit_receipt, family, 1931)
    audit_receipt = mix(audit_receipt, acceptance, 1931)
    if audit_receipt != 541445443 { return 6 }

    var readiness: i64 = 163
    readiness = mix(readiness, 173, 1951)
    readiness = mix(readiness, 31, 1951)
    readiness = mix(readiness, manifest, 1951)
    readiness = mix(readiness, result, 1951)
    readiness = mix(readiness, family, 1951)
    readiness = mix(readiness, acceptance, 1951)
    readiness = mix(readiness, audit_receipt, 1951)
    if readiness != 701839377 { return 7 }
    return 0
}
