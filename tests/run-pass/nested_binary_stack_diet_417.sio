//@ run-pass
//@ expect-stdout: NESTED_BINARY_STACK_DIET_OK
//@ description: Nested binary-operand check under the SIO-417 stack diet. The
// operand-type router used to hold every binary branch in one ~4.86 MB frame,
// so `foo(bar(x * x))` exercised the crashing check-time nesting path. The
// router now delegates each branch to its own helper frame with identical
// diagnostics; this pins the nested-call value through that path.
fn foo(x: f64) -> f64 with Div {
    x + 1.0
}

fn bar(x: f64) -> f64 with Div {
    x * 2.0
}

fn f_min6(x: f64, y: f64) -> f64 with Mut, Div, Panic {
    return foo(bar(x * x + y - y))
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let v = f_min6(2.0, 3.0)
    if v != 9.0 {
        println("FAIL nested binary value")
        return 1
    }
    println("NESTED_BINARY_STACK_DIET_OK")
    0
}
