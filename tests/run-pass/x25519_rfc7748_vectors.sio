//@ run-pass
//@ requires: madaros
// RFC 7748 section 5.2's two official X25519 test vectors. Fetched and
// independently byte-length-verified (64 hex chars == 32 bytes each) from
// https://www.rfc-editor.org/rfc/rfc7748.txt on 2026-08-25 -- not
// transcribed from memory or from this plan's own brief.
use crypto::x25519::*

fn main() -> i64 with IO {
    // Test vector 1 (RFC 7748 5.2, first example).
    let scalar1: [u8;32] = [165, 70, 227, 107, 240, 82, 124, 157, 59, 22, 21, 75, 130, 70, 94, 221, 98, 20, 76, 10, 193, 252, 90, 24, 80, 106, 34, 68, 186, 68, 154, 196]
    let u1: [u8;32] = [230, 219, 104, 103, 88, 48, 48, 219, 53, 148, 193, 164, 36, 177, 95, 124, 114, 102, 36, 236, 38, 179, 53, 59, 16, 169, 3, 166, 208, 171, 28, 76]
    let expected1: [u8;32] = [195, 218, 85, 55, 157, 233, 198, 144, 142, 148, 234, 77, 242, 141, 8, 79, 50, 236, 207, 3, 73, 28, 113, 247, 84, 180, 7, 85, 119, 162, 133, 82]

    let (out1, ok1) = x25519(&scalar1, &u1)
    if !ok1 {
        print_int(1)
        return 1
    }
    var i: i64 = 0
    while i < 32 {
        if out1[i as usize] != expected1[i as usize] {
            print_int(2)
            return 1
        }
        i = i + 1
    }

    // Test vector 2 (RFC 7748 5.2, second example).
    let scalar2: [u8;32] = [75, 102, 233, 212, 209, 180, 103, 60, 90, 210, 38, 145, 149, 125, 106, 245, 193, 27, 100, 33, 224, 234, 1, 212, 44, 164, 22, 158, 121, 24, 186, 13]
    let u2: [u8;32] = [229, 33, 15, 18, 120, 104, 17, 211, 244, 183, 149, 157, 5, 56, 174, 44, 49, 219, 231, 16, 111, 192, 60, 62, 252, 76, 213, 73, 199, 21, 164, 147]
    let expected2: [u8;32] = [149, 203, 222, 148, 118, 232, 144, 125, 122, 173, 228, 92, 180, 184, 115, 248, 139, 89, 90, 104, 121, 159, 161, 82, 230, 248, 247, 100, 122, 172, 121, 87]

    let (out2, ok2) = x25519(&scalar2, &u2)
    if !ok2 {
        print_int(3)
        return 1
    }
    var j: i64 = 0
    while j < 32 {
        if out2[j as usize] != expected2[j as usize] {
            print_int(4)
            return 1
        }
        j = j + 1
    }

    println("x25519_rfc7748_vectors: both RFC 7748 section 5.2 test vectors match")
    return 0
}
