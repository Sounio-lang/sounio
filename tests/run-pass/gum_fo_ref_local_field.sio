//@ run-pass
//@ requires: madaros
//@ expect-stdout: direct 0.090000
//@ expect-stdout: through 0.090000
//@ expect-stdout: copied 0.090000
//@ expect-stdout: deref 0.090000
//@ expect-stdout: REF_LOCAL_FIELD_OK
// A reference to a struct local is that local for field variance.
// uncertainty 0.3 -> variance 0.09. Before, r.cl0 read 0.

struct Pk { cl0: f64 }

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let p = Pk { cl0: k.value }
    let direct = variance_of(p.cl0)
    let r = &p
    let through = variance_of(r.cl0)
    let s = r
    let copied = variance_of(s.cl0)
    let deref = variance_of((*r).cl0)
    print("direct ")
    print_f64(direct)
    println("")
    print("through ")
    print_f64(through)
    println("")
    print("copied ")
    print_f64(copied)
    println("")
    print("deref ")
    print_f64(deref)
    println("")
    var fails: i64 = 0
    if direct < 0.089999 || direct > 0.090001 { fails = fails + 1 }
    if through < 0.089999 || through > 0.090001 { fails = fails + 1 }
    if copied < 0.089999 || copied > 0.090001 { fails = fails + 1 }
    if deref < 0.089999 || deref > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("REF_LOCAL_FIELD_OK")
        0
    } else {
        println("REF_LOCAL_FIELD_FAIL")
        1
    }
}
