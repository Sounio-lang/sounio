//@ run-pass
//@ description: V0-F.5 / KL-15a — general IEEE binary256 add/sub in sio
//@ ladder-stage: V0-F.5
//@ semantic-lane: WS-G-V0E-STDLIB-GUM-SURFACE
//@ claim-clock: sounio_native_expected (ADR-008 / ADR-009)
//@ note: softfloat_limb.py is measurement-only; must not judge this claim
//@ note: language f256 Madaros-run remains V0-E.4.1 fail-closed
//
// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0f5

use math::wide_float::{
    F256Bits,
    f256_bits_one,
    f256_bits_two,
    f256_bits_half,
    f256_bits_approx_1e_neg20,
    f256_bits_eq,
    print_f256_bits_hex_wire,
}
use math::softfloat_f256::{f256_bits_soft_add, f256_bits_soft_sub}

fn f256_one_half() -> F256Bits {
    F256Bits { l0: 0, l1: 0, l2: 0, l3: 4611677222334365696 }
}

fn f256_one_plus_tiny() -> F256Bits {
    F256Bits {
        l0: -876495070916766082,
        l1: 4930221287926428314,
        l2: 3245185536584,
        l3: 4611668426241343488,
    }
}

fn f256_recover() -> F256Bits {
    F256Bits {
        l0: 0,
        l1: -7011960567334128656,
        l2: 2548282155992323287,
        l3: 4610498119074615874,
    }
}

fn f256_two_plus_tiny() -> F256Bits {
    F256Bits {
        l0: 8785124501396392767,
        l1: 2465110643963214157,
        l2: 1622592768292,
        l3: 4611686018427387904,
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let one = f256_bits_one()
    let two = f256_bits_two()
    let half = f256_bits_half()
    let tiny = f256_bits_approx_1e_neg20()

    let one_plus_one = f256_bits_soft_add(one, one)
    if !f256_bits_eq(one_plus_one, two) {
        println("FAIL 1+1")
        return 1
    }

    let half_plus_one = f256_bits_soft_add(half, one)
    if !f256_bits_eq(half_plus_one, f256_one_half()) {
        println("FAIL half+one")
        return 1
    }

    let one_plus_tiny = f256_bits_soft_add(one, tiny)
    if !f256_bits_eq(one_plus_tiny, f256_one_plus_tiny()) {
        println("FAIL 1+tiny")
        return 1
    }

    let recover = f256_bits_soft_sub(one_plus_tiny, one)
    if f256_bits_eq(recover, f256_bits_one()) {
        println("FAIL f64_greenwash_identity")
        return 1
    }
    if recover.l0 == 0 && recover.l1 == 0 && recover.l2 == 0 && recover.l3 == 0 {
        println("FAIL f64_greenwash_zero")
        return 1
    }
    if !f256_bits_eq(recover, f256_recover()) {
        println("FAIL recover_mismatch")
        return 1
    }

    let two_plus_tiny = f256_bits_soft_add(two, tiny)
    if !f256_bits_eq(two_plus_tiny, f256_two_plus_tiny()) {
        println("FAIL two+tiny")
        return 1
    }

    print("wire_half+one=")
    print_f256_bits_hex_wire(half_plus_one)
    println("")
    print("wire_1+tiny=")
    print_f256_bits_hex_wire(one_plus_tiny)
    println("")
    print("wire_recover=")
    print_f256_bits_hex_wire(recover)
    println("")
    print("wire_two+tiny=")
    print_f256_bits_hex_wire(two_plus_tiny)
    println("")

    println("PASS f256_v0f5_softfloat_add_sub general=ieee754 rne anti_f64=green")
    return 0
}
