//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 five-step trajectory certificate composition smoke

fn cert_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn step5_certificate_fingerprint(start_x: i64, start_y: i64, start_z: i64,
                                 dy_scaled_q: i64, dy_scaled_r: i64,
                                 xy_scaled_q: i64, xy_scaled_r: i64,
                                 beta_q: i64, beta_r: i64,
                                 x_inc_q: i64, x_inc_r: i64,
                                 y_inc_q: i64, y_inc_r: i64,
                                 z_drop_q: i64, z_drop_r: i64,
                                 final_x: i64, final_y: i64, final_z: i64,
                                 all_divisions_ok: i64) -> i64 with Mod {
    if start_x != 4920371098 { return 0 - 1 }
    if start_y != 8816077911 { return 0 - 1 }
    if start_z != 4092986080 { return 0 - 1 }
    if dy_scaled_q != 133081411987 { return 0 - 1 }
    if dy_scaled_r != 405415232 { return 0 - 1 }
    if xy_scaled_q != 10099814960 { return 0 - 1 }
    if xy_scaled_r != 2149068118 { return 0 - 1 }
    if beta_q != 10914629546 { return 0 - 1 }
    if beta_r != 2 { return 0 - 1 }
    if x_inc_q != 389570672 { return 0 - 1 }
    if x_inc_r != 2544410448 { return 0 - 1 }
    if y_inc_q != 1242653312 { return 0 - 1 }
    if y_inc_r != 4228538720 { return 0 - 1 }
    if z_drop_q != 8148145 { return 0 - 1 }
    if z_drop_r != 2911449872 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 233
    fp = cert_mix(fp, start_x, 1601)
    fp = cert_mix(fp, start_y, 1601)
    fp = cert_mix(fp, start_z, 1601)
    fp = cert_mix(fp, dy_scaled_q, 1601)
    fp = cert_mix(fp, dy_scaled_r, 1601)
    fp = cert_mix(fp, xy_scaled_q, 1601)
    fp = cert_mix(fp, xy_scaled_r, 1601)
    fp = cert_mix(fp, beta_q, 1601)
    fp = cert_mix(fp, beta_r, 1601)
    fp = cert_mix(fp, x_inc_q, 1601)
    fp = cert_mix(fp, x_inc_r, 1601)
    fp = cert_mix(fp, y_inc_q, 1601)
    fp = cert_mix(fp, y_inc_r, 1601)
    fp = cert_mix(fp, z_drop_q, 1601)
    fp = cert_mix(fp, z_drop_r, 1601)
    fp = cert_mix(fp, final_x, 1601)
    fp = cert_mix(fp, final_y, 1601)
    fp = cert_mix(fp, final_z, 1601)
    fp = cert_mix(fp, all_divisions_ok, 1601)
    return fp
}

fn five_step_chain_fingerprint(step5_certificate_fp: i64,
                               final_x: i64, final_y: i64,
                               final_z: i64) -> i64 with Mod {
    if step5_certificate_fp != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 239
    fp = cert_mix(fp, 5, 1613)
    fp = cert_mix(fp, 510854875, 1613)
    fp = cert_mix(fp, 899209716, 1613)
    fp = cert_mix(fp, 603078026, 1613)
    fp = cert_mix(fp, 753371133, 1613)
    fp = cert_mix(fp, step5_certificate_fp, 1613)
    fp = cert_mix(fp, final_x, 1613)
    fp = cert_mix(fp, final_y, 1613)
    fp = cert_mix(fp, final_z, 1613)
    return fp
}

fn trajectory5_manifest_fingerprint(chain_anchor: i64,
                                    final_step_certificate: i64,
                                    final_x: i64,
                                    final_y: i64,
                                    final_z: i64) -> i64 with Mod {
    if chain_anchor != 23144051 { return 0 - 1 }
    if final_step_certificate != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 191
    fp = cert_mix(fp, 32, 1487)
    fp = cert_mix(fp, 42949672, 1487)
    fp = cert_mix(fp, 96, 1487)
    fp = cert_mix(fp, 5, 1487)
    fp = cert_mix(fp, 4294967296, 1487)
    fp = cert_mix(fp, 4294967296, 1487)
    fp = cert_mix(fp, 4294967296, 1487)
    fp = cert_mix(fp, chain_anchor, 1487)
    fp = cert_mix(fp, final_step_certificate, 1487)
    fp = cert_mix(fp, final_x, 1487)
    fp = cert_mix(fp, final_y, 1487)
    fp = cert_mix(fp, final_z, 1487)
    return fp
}

fn trajectory5_certificate_check(dt_q: i64, dt_r: i64,
                                 dy_scaled_q_i64: i64, dy_scaled_r_i64: i64,
                                 xy_scaled_q_i64: i64, xy_scaled_r_i64: i64,
                                 beta_q_i64: i64, beta_r_i64: i64,
                                 x_inc_q_i64: i64, x_inc_r_i64: i64,
                                 y_inc_q_i64: i64, y_inc_r_i64: i64,
                                 z_drop_q_i64: i64, z_drop_r_i64: i64,
                                 final_x_i64: i64, final_y_i64: i64,
                                 final_z_i64: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let z4: i256 = 4092986080 as i256
    let dt: i256 = dt_q as i256
    let dy_scaled_q: i256 = dy_scaled_q_i64 as i256
    let xy_scaled_q: i256 = xy_scaled_q_i64 as i256
    let beta_q: i256 = beta_q_i64 as i256
    let x_inc_q: i256 = x_inc_q_i64 as i256
    let y_inc_q: i256 = y_inc_q_i64 as i256
    let z_drop_q: i256 = z_drop_q_i64 as i256

    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let dy_num: i256 = x4 * ((28 as i256) * scale - z4)
    let xy_num: i256 = x4 * y4
    let beta_num_z: i256 = (8 as i256) * z4
    let dy: i256 = dy_scaled_q - y4
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    if check_div_witness_i256(scale, 100 as i256, dt, dt_r as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r_i64 as i256) != 1 { return 0 - 1 }
    if check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r_i64 as i256) != 1 { return 0 - 1 }

    if x4 + x_inc_q != final_x_i64 as i256 { return 0 - 1 }
    if y4 + y_inc_q != final_y_i64 as i256 { return 0 - 1 }
    if z4 - z_drop_q != final_z_i64 as i256 { return 0 - 1 }

    let step5_fp = step5_certificate_fingerprint(
        4920371098, 8816077911, 4092986080,
        dy_scaled_q_i64, dy_scaled_r_i64, xy_scaled_q_i64, xy_scaled_r_i64,
        beta_q_i64, beta_r_i64, x_inc_q_i64, x_inc_r_i64,
        y_inc_q_i64, y_inc_r_i64, z_drop_q_i64, z_drop_r_i64,
        final_x_i64, final_y_i64, final_z_i64, 1)
    let chain_anchor = five_step_chain_fingerprint(
        step5_fp, final_x_i64, final_y_i64, final_z_i64)
    let manifest_fp = trajectory5_manifest_fingerprint(
        chain_anchor, step5_fp, final_x_i64, final_y_i64, final_z_i64)
    if manifest_fp != 214180161 { return 0 - 1 }
    return manifest_fp
}

fn main() -> i64 with Mod {
    let manifest_fp = trajectory5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935)
    if manifest_fp != 214180161 { return 1 }

    if trajectory5_certificate_check(
        42949672, 95,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 2 }
    if trajectory5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 3, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 3 }
    if trajectory5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731224, 4084837935) != (0 - 1) { return 4 }

    return 0
}
