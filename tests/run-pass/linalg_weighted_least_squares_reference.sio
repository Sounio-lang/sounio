// C++23 quadmath weighted raw-design MGS reference; no inferential claim.
use linalg::weighted_least_squares::{weighted_qr_least_squares}
fn close(a:f64,b:f64,at:f64,rt:f64)->bool {let d=if a>b{a-b}else{b-a} let v=if b<0.0{-b}else{b} return d<=at+rt*v}
