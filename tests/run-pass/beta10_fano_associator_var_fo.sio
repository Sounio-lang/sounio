//@ run-pass
//@ expect-stdout: BETA10_FANO_FO_VAR_PASS

// β¹⁰ depth: FO GUM for the Fano associator closed form
//   A = ‖[e1,e2,e4]‖² with only a1 uncertain
//   A = 4 · a1²  at a1 = 1 + δ, so A(1) = 4
//   ∂A/∂a1 |_{1} = 8  →  Var(A) = 64 σ²
//
// Compiler path: measure(a1) → A = 4 * a.value * a.value → variance_of(A)
// Requires β⁴ product GUM + β¹⁰ awareness on any internal cancellation.
//
//   SOUNIO_SOUC_ENGINE=lean_single ./bin/souc run tests/run-pass/beta10_fano_associator_var_fo.sio

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let sigma = 0.05
    let sig2 = sigma * sigma
    let truth = 64.0 * sig2

    // a1 ~ measure(1.0, σ); closed form A = 4 a1² via (a1*a1) then *4
    // (associative chain 4*a1*a1 without intermediate loses same-ident FO)
    let a: Knowledge<f64> = measure(1.0, uncertainty: sigma)
    let a1 = a.value
    let aa = a1 * a1
    let A = 4.0 * aa
    let v = variance_of(A)

    print("fano_fo_A=")
    print_f64(A)
    print("\n")
    print("fano_fo_var=")
    print_f64(v)
    print("\n")
    print("fano_fo_truth=")
    print_f64(truth)
    print("\n")

    let rel = abs_f(v - truth) / truth
    print("fano_fo_rel_err=")
    print_f64(rel)
    print("\n")

    // Also d7 = 2 a1; A2 = d7²  → same FO
    let d7 = 2.0 * a1
    let A2 = d7 * d7
    let v2 = variance_of(A2)
    print("fano_fo_var_via_d7=")
    print_f64(v2)
    print("\n")

    let ok1 = rel < 0.05
    let rel2 = abs_f(v2 - truth) / truth
    let ok2 = rel2 < 0.05
    let a_ok = abs_f(A - 4.0) < 1.0e-9
    print("fano_fo_rel2=")
    print_f64(rel2)
    print("\n")

    if ok1 && ok2 && a_ok {
        print("BETA10_FANO_FO_VAR_PASS\n")
    } else {
        print("BETA10_FANO_FO_VAR_FAIL_HONEST\n")
        // Pre-β¹¹ residual: independent product gives 32σ² (= half of 64σ²) on a·a chains.
        let half = 32.0 * sig2
        let d_half = abs_f(v - half)
        if d_half < 1.0e-9 {
            print("BETA11_RESIDUAL_HALF_TRUTH_INDEPENDENT_PRODUCT\n")
        }
    }
}
