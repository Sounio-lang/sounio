//@ run-pass
// Regression test: 240-step ODE solver with struct mutation in while loop
// This pattern previously failed after 2-5 iterations (see stdlib/ode/PBPK_STABILITY_REPORT.md)
// Validates that struct reassignment inside while loops works for scientific computing

struct PBPKState {
    t: f64,
    gut: f64,
    central: f64,
    auc: f64
}

fn pbpk_euler_step(s: PBPKState, dt: f64) -> PBPKState {
    let ka = 1.0
    let ke = 0.1
    let d_gut = -ka * s.gut
    let d_central = ka * s.gut - ke * s.central

    PBPKState {
        t: s.t + dt,
        gut: s.gut + d_gut * dt,
        central: s.central + d_central * dt,
        auc: s.auc + s.central * dt
    }
}

fn main() -> i32 with IO {
    var s = PBPKState { t: 0.0, gut: 500.0, central: 0.0, auc: 0.0 }
    let dt = 0.1
    var i = 0

    while i < 240 {
        s = pbpk_euler_step(s, dt)
        i = i + 1
    }

    // Verify 240 iterations completed correctly:
    // t should be 24.0 (24 simulated hours)
    if s.t < 23.9 { return 1 }
    // gut should be near 0 (fully absorbed after 24h with ka=1.0)
    if s.gut > 1.0 { return 2 }
    // AUC should be positive
    if s.auc < 100.0 { return 3 }

    return 0
}
