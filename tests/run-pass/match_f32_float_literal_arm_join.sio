//@ run-pass
//@ description: #830 — an unsuffixed float literal match arm adopts the sibling arms' f32 type (literal first, literal last, literal block arm)
//@ expect-stdout: 0.000000
//@ expect-stdout: 2.500000
//@ expect-stdout: -1.500000
//@ expect-stdout: 2.500000
//@ expect-stdout: 1.000000
//@ expect-stdout: 2.500000
//@ expect-stdout: 0.250000

fn literal_first(k: i64, x: f32) -> f32 {
    match k {
        0 => 0.0,
        _ => x,
    }
}

fn literal_last(k: i64, x: f32) -> f32 {
    match k {
        0 => x,
        1 => -1.5,
        _ => 0.0,
    }
}

fn literal_block(k: i64, x: f32) -> f32 {
    match k {
        0 => { 1.0 }
        1 => x,
        _ => { 0.25 }
    }
}

fn main() -> i64 with IO {
    let a: f32 = 2.5
    println(literal_first(0, a) as f64)
    println(literal_first(1, a) as f64)
    println(literal_last(1, a) as f64)
    println(literal_last(0, a) as f64)
    println(literal_block(0, a) as f64)
    println(literal_block(1, a) as f64)
    println(literal_block(2, a) as f64)
    0
}
