//@ smoke: stats::validation linear_regression under default Madaros multi-module
use stats::validation::{linear_regression, r_squared}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    var y: [f64; 256] = [0.0; 256]
    x[0] = 1.0; x[1] = 2.0; x[2] = 3.0; x[3] = 4.0; x[4] = 5.0
    y[0] = 2.0; y[1] = 4.0; y[2] = 5.0; y[3] = 4.0; y[4] = 5.0
    let fit = linear_regression(&x, &y, 5)
    let rsq = r_squared(&x, &y, 5)
    // Textbook: slope=0.6, intercept=2.2, r²=0.6
    if near(fit.slope, 0.6, 1.0e-12) && near(fit.intercept, 2.2, 1.0e-12) &&
       near(rsq, 0.6, 1.0e-12) && near(fit.r_squared, 0.6, 1.0e-12) {
        println("VALIDATION_MADAROS_IMPORT PASS")
        return 0
    }
    1
}
