//@ run-pass
//@ expect-stdout-contains: knowledge_require_confidence: PASS
//@ description: require_confidence extracts value when confidence meets threshold

fn main() -> i64 with IO {
    var exit_fails: i64 = 0
    let k = measure(42.0, uncertainty: 2.5, confidence: 0.98)
    let v: f64 = require_confidence(k, 0.95)

    if v == 42.0 {
        print("knowledge_require_confidence: PASS\n")
    } else {
        print("knowledge_require_confidence: FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
