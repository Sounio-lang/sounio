//@ run-pass
//@ description: f64 bitcast/sitofp boundary — rows that must stay healthy (controls)
//
// Companion audit: docs/audit/MADAROS_F64_BITCAST_SITOFP_BOUNDARY_2026-08-17.md
// These shapes are NOT the F2 trigger. If any fails, the instrument is broken
// or a regression landed outside the Knowledge.confidence kind-split.

fn f64_to_i64(x: f64) -> i64 {
    return x as i64
}

fn cast_neg(x: f64) -> i64 {
    return x as i64
}

fn roundtrip(x: f64) -> f64 {
    let k = x as i64
    return k as f64
}

struct OneF {
    conf: f64,
}

struct TwoF {
    conf: f64,
    pad: f64,
}

struct EpLike {
    mean: f64,
    // Do not name a field `var` — lean_single treats it as the mutable-binding
    // keyword and reports "missing field in struct literal".
    variance: f64,
    conf: f64,
}

fn make_one() -> OneF {
    OneF { conf: 0.671038 }
}

fn make_two() -> TwoF {
    TwoF { conf: 0.671038, pad: 1.0 }
}

fn make_ep() -> EpLike {
    EpLike { mean: 12.5, variance: 0.01, conf: 0.671038 }
}

// Pure expression — no `var` / Mut — so lean_single and Madaros both accept it
// without an effect annotation (CI Full Test Suite runs stage2/lean family).
fn weighted_plain() -> f64 {
    0.80 * 0.50 + 0.60 * 0.30 + 0.40 * 0.20
}

fn main() -> i64 with IO, Mut, Div, Panic {
    // R01 local cast
    let x: f64 = 4.172
    let k1 = x as i64
    print("R01 ")
    print_int(k1)
    println("")
    if k1 != 4 {
        println("R01_FAIL")
        return 1
    }
    println("R01_OK")

    // R02 param cast
    let k2 = f64_to_i64(4.172)
    print("R02 ")
    print_int(k2)
    println("")
    if k2 != 4 {
        println("R02_FAIL")
        return 2
    }
    println("R02_OK")

    // R03 plain print_f64
    let c0: f64 = 0.671038
    print("R03 ")
    print_f64(c0)
    println("")
    if !(c0 > 0.20 && c0 < 0.90) {
        println("R03_FAIL")
        return 3
    }
    println("R03_OK")

    // R04 single-field struct
    let o = make_one()
    print("R04 ")
    print_f64(o.conf)
    println("")
    if !(o.conf > 0.20 && o.conf < 0.90) {
        println("R04_FAIL")
        return 4
    }
    println("R04_OK")

    // R05 two-field
    let t = make_two()
    print("R05 ")
    print_f64(t.conf)
    println("")
    if !(t.conf > 0.20 && t.conf < 0.90) {
        println("R05_FAIL")
        return 5
    }
    println("R05_OK")

    // R06 EpResult-like plain f64 fields
    let e = make_ep()
    print("R06 ")
    print_f64(e.conf)
    println("")
    if !(e.conf > 0.20 && e.conf < 0.90) {
        println("R06_FAIL")
        return 6
    }
    println("R06_OK")

    // R07 weighted plain f64
    let w = weighted_plain()
    print("R07 ")
    print_f64(w)
    println("")
    if !(w > 0.20 && w < 0.90) {
        println("R07_FAIL")
        return 7
    }
    println("R07_OK")

    // R08 local roundtrip f64→i64→f64
    let y8 = (4.172 as i64) as f64
    print("R08 ")
    print_f64(y8)
    println("")
    if !(y8 > 3.9 && y8 < 4.1) {
        println("R08_FAIL")
        return 8
    }
    println("R08_OK")

    // R09 param roundtrip
    let y9 = roundtrip(4.172)
    print("R09 ")
    print_f64(y9)
    println("")
    if !(y9 > 3.9 && y9 < 4.1) {
        println("R09_FAIL")
        return 9
    }
    println("R09_OK")

    // R10 print_int after print_f64
    print("R10_f ")
    print_f64(3.5)
    println("")
    print("R10_i ")
    print_int(42)
    println("")
    println("R10_OK")

    // R11 negative cast
    let kn = cast_neg(0.0 - 3.9)
    print("R11 ")
    print_int(kn)
    println("")
    if kn != (0 - 3) {
        println("R11_FAIL")
        return 11
    }
    println("R11_OK")

    // R12 field then cast
    let k12 = o.conf as i64
    // 0.671038 as i64 → 0
    print("R12 ")
    print_int(k12)
    println("")
    if k12 != 0 {
        println("R12_FAIL")
        return 12
    }
    println("R12_OK")

    // R13 ident copy then cast of 4.172
    let a: f64 = 4.172
    let b = a
    let k13 = b as i64
    print("R13 ")
    print_int(k13)
    println("")
    if k13 != 4 {
        println("R13_FAIL")
        return 13
    }
    println("R13_OK")

    println("CONTROLS_ALL_OK")
    return 0
}
