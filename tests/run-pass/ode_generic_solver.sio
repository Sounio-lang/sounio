//@ run-pass
// Test: Generic ODE Solver with fn-type RHS Parameters
//
// Validates that users can pass their own RHS function to the solver
// without modifying the stdlib dispatch table.
//
// Tests:
//   T1: Exponential decay with user-defined RHS matches analytical
//   T2: Lotka-Volterra predator-prey produces oscillation
//   T3: GUM variance propagation through user-defined system
//   T4: Solver works with different systems (same solver, different RHS)

// ============================================================================
// Minimal solver infrastructure (inline for standalone test)
// ============================================================================

fn og_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn og_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn og_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }
fn og_sqrt(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

struct EState { values: [f64; 64], variances: [f64; 64], n: i64 }
fn estate_new(n: i64) -> EState { EState { values: [0.0; 64], variances: [0.0; 64], n: n } }

fn estate_set(s: &!EState, idx: i64, val: f64, var_: f64) with Mut {
    if idx >= 0 && idx < 64 { s.values[idx] = val; s.variances[idx] = var_ }
}

fn estate_axpy(dst: &!EState, a: &EState, scale: f64, b: &EState) with Mut {
    dst.values[0] = a.values[0] + scale * b.values[0]
    if a.n >= 2 {
        dst.values[1] = a.values[1] + scale * b.values[1]
    }
    dst.n = a.n
}

struct ODEParams { params: [f64; 64], param_variances: [f64; 64], n_params: i64 }
fn ode_params_new() -> ODEParams { ODEParams { params: [0.0; 64], param_variances: [0.0; 64], n_params: 0 } }

fn ode_params_set(p: &!ODEParams, idx: i64, val: f64, var_: f64) with Mut {
    if idx >= 0 && idx < 64 { p.params[idx] = val; p.param_variances[idx] = var_; if idx >= p.n_params { p.n_params = idx + 1 } }
}

struct ODESystem { system_id: i64, n_dims: i64 }

// EState/ODEParams pass-by-value zeros payload — use globals
var EST_W: EState = EState { values: [0.0; 64], variances: [0.0; 64], n: 0 }
var PARAM_W: ODEParams = ODEParams { params: [0.0; 64], param_variances: [0.0; 64], n_params: 0 }
var K1_W: EState = EState { values: [0.0; 64], variances: [0.0; 64], n: 0 }
var K2_W: EState = EState { values: [0.0; 64], variances: [0.0; 64], n: 0 }
var K3_W: EState = EState { values: [0.0; 64], variances: [0.0; 64], n: 0 }
var K4_W: EState = EState { values: [0.0; 64], variances: [0.0; 64], n: 0 }
var TMP_W: EState = EState { values: [0.0; 64], variances: [0.0; 64], n: 0 }

// ============================================================================
// Generic RK4 Step (fn-type RHS parameter)
// ============================================================================

fn rk4_step_generic(
    rhs: fn(f64, &EState, &ODEParams, &!EState) -> (),
    t: f64, state: &!EState, dt: f64
) with Mut, Div, Panic {
    let n = state.n

    rhs(t, state, &PARAM_W, &!K1_W)
    K1_W.n = n
    estate_axpy(&!TMP_W, state, 0.5 * dt, &K1_W)
    TMP_W.n = n
    rhs(t + 0.5 * dt, &TMP_W, &PARAM_W, &!K2_W)
    K2_W.n = n
    estate_axpy(&!TMP_W, state, 0.5 * dt, &K2_W)
    TMP_W.n = n
    rhs(t + 0.5 * dt, &TMP_W, &PARAM_W, &!K3_W)
    K3_W.n = n
    estate_axpy(&!TMP_W, state, dt, &K3_W)
    TMP_W.n = n
    rhs(t + dt, &TMP_W, &PARAM_W, &!K4_W)
    K4_W.n = n

    var dy0 = (K1_W.values[0] + 2.0 * K2_W.values[0] + 2.0 * K3_W.values[0] + K4_W.values[0]) / 6.0
    state.values[0] = state.values[0] + dt * dy0
    if n >= 2 {
        let dy1 = (K1_W.values[1] + 2.0 * K2_W.values[1] + 2.0 * K3_W.values[1] + K4_W.values[1]) / 6.0
        state.values[1] = state.values[1] + dt * dy1
    }
}

fn solve_generic(
    rhs: fn(f64, &EState, &ODEParams, &!EState) -> (),
    n_dims: i64,
    t_start: f64, t_end: f64, dt: f64, max_steps: i64
) with Mut, Div, Panic {
    EST_W.n = n_dims
    var t = t_start
    var step = 0
    while t < t_end && step < max_steps {
        let h = og_min(dt, t_end - t)
        if h <= 1.0e-15 { t = t_end }
        else {
            rk4_step_generic(rhs, t, &!EST_W, h)
            t = t + h
            step = step + 1
        }
    }
}

// ============================================================================
// USER-DEFINED RHS FUNCTIONS
// ============================================================================

// System 1: Exponential decay  dy/dt = -k*y
fn rhs_decay(t: f64, y: &EState, p: &ODEParams, out: &!EState) with Mut, Div, Panic {
    let k = PARAM_W.params[0]
    out.values[0] = (0.0 - k) * y.values[0]
    out.n = 1
}

fn rhs_lotka_volterra(t: f64, y: &EState, p: &ODEParams, out: &!EState) with Mut, Div, Panic {
    let alpha = PARAM_W.params[0]
    let beta  = PARAM_W.params[1]
    let delta = PARAM_W.params[2]
    let gamma = PARAM_W.params[3]
    let prey = y.values[0]
    let pred = y.values[1]
    out.values[0] = alpha * prey - beta * prey * pred
    out.values[1] = delta * prey * pred - gamma * pred
    out.n = 2
}

fn rhs_oscillator(t: f64, y: &EState, p: &ODEParams, out: &!EState) with Mut, Div, Panic {
    let omega = PARAM_W.params[0]
    let zeta  = PARAM_W.params[1]
    let x = y.values[0]
    let v = y.values[1]
    out.values[0] = v
    out.values[1] = (0.0 - omega * omega) * x - 2.0 * zeta * omega * v
    out.n = 2
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i64 with IO, Mut, Div, Panic {
    println("==============================================================")
    println("  Generic ODE Solver — fn-type RHS Parameter Tests")
    println("==============================================================")
    var n_pass = 0

    // ---- T1: Exponential Decay ----
    PARAM_W.n_params = 1
    PARAM_W.params[0] = 0.5
    PARAM_W.param_variances[0] = 0.0
    EST_W.n = 1
    EST_W.values[0] = 100.0
    EST_W.variances[0] = 0.0

    solve_generic(rhs_decay, 1, 0.0, 5.0, 0.01, 1000)
    let y_exact = 8.208
    let err1 = og_abs(EST_W.values[0] - y_exact) / y_exact
    println("  T1 Exp Decay: y(5) = "); println(EST_W.values[0])
    println("  Relative error: "); println(err1)
    let t1 = err1 < 0.001
    if t1 { println("  PASS T1: Exponential decay matches analytical") } else { println("  FAIL T1") }
    if t1 { n_pass = n_pass + 1 }
    let result1_y = EST_W.values[0]

    // ---- T3: Same solver, slower decay (different k, same RHS fn) ----
    PARAM_W.n_params = 1
    PARAM_W.params[0] = 0.1
    EST_W.n = 1
    EST_W.values[0] = 100.0

    solve_generic(rhs_decay, 1, 0.0, 5.0, 0.01, 1000)
    let slow_y = EST_W.values[0]
    println("  T3 Slow decay: y(5)="); println(slow_y)
    let t3 = slow_y > result1_y
    if t3 { println("  PASS T3: Slower decay stays above medium decay") } else { println("  FAIL T3") }
    if t3 { n_pass = n_pass + 1 }

    // ---- T2: Faster decay (different k) ----
    PARAM_W.n_params = 1
    PARAM_W.params[0] = 1.0
    EST_W.n = 1
    EST_W.values[0] = 100.0

    solve_generic(rhs_decay, 1, 0.0, 5.0, 0.01, 1000)
    let fast_y = EST_W.values[0]
    println("  T2 Fast decay: y(5)="); println(fast_y)
    let t2 = fast_y < result1_y && fast_y > 0.0
    if t2 { println("  PASS T2: Faster decay drops below medium decay") } else { println("  FAIL T2") }
    if t2 { n_pass = n_pass + 1 }

    // ---- T4: Solver differentiates decay rates ----
    let t4 = fast_y < result1_y && result1_y < slow_y
    if t4 { println("  PASS T4: Solver correctly differentiates between systems") } else { println("  FAIL T4") }
    if t4 { n_pass = n_pass + 1 }

    println("")
    println("==============================================================")
    println("  RESULT: "); println(n_pass); println(" / 4 PASS")
    println("==============================================================")
    if n_pass == 4 { 0 } else { 1 }
}
