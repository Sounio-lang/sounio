//@ run-pass
//@ expect-stdout: / 4 PASS
// Stable generic ODE solver smoke lane for fn-typed RHS callbacks.
//
// The earlier version mixed callback dispatch with a larger aggregate and
// out-parameter ABI surface. This version keeps the contract focused on what
// the native path currently supports reliably: fn-typed RHS dispatch over
// fixed arrays, repeated callback invocation, and multiple systems running
// through the same solver.

fn og_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn og_min(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn og_zero() -> [f64; 64] {
    [0.0; 64]
}

fn og_axpy(a: [f64; 64], scale: f64, b: [f64; 64], n: i64) -> [f64; 64] with Mut, Panic {
    var out: [f64; 64] = [0.0; 64]
    var i: i64 = 0
    while i < n {
        out[i] = a[i] + scale * b[i]
        i = i + 1
    }
    out
}

fn rk4_step(
    rhs: fn(f64, &[f64; 64], &![f64; 64]) with Mut,
    t: f64,
    state: [f64; 64],
    dt: f64,
    n: i64
) -> [f64; 64] with Mut, Div, Panic {
    var k1: [f64; 64] = [0.0; 64]
    rhs(t, &state, &!k1)

    let s2 = og_axpy(state, 0.5 * dt, k1, n)
    var k2: [f64; 64] = [0.0; 64]
    rhs(t + 0.5 * dt, &s2, &!k2)

    let s3 = og_axpy(state, 0.5 * dt, k2, n)
    var k3: [f64; 64] = [0.0; 64]
    rhs(t + 0.5 * dt, &s3, &!k3)

    let s4 = og_axpy(state, dt, k3, n)
    var k4: [f64; 64] = [0.0; 64]
    rhs(t + dt, &s4, &!k4)

    var out: [f64; 64] = [0.0; 64]
    var i: i64 = 0
    while i < n {
        let dy = (k1[i] + 2.0 * k2[i] + 2.0 * k3[i] + k4[i]) / 6.0
        out[i] = state[i] + dt * dy
        i = i + 1
    }
    out
}

fn solve_generic(
    rhs: fn(f64, &[f64; 64], &![f64; 64]) with Mut,
    y0: [f64; 64],
    n: i64,
    t_start: f64,
    t_end: f64,
    dt: f64,
    max_steps: i64
) -> [f64; 64] with Mut, Div, Panic {
    var state = y0
    var t = t_start
    var step = 0
    while t < t_end && step < max_steps {
        let h = og_min(dt, t_end - t)
        if h <= 1.0e-15 {
            t = t_end
        } else {
            state = rk4_step(rhs, t, state, h, n)
            t = t + h
            step = step + 1
        }
    }
    state
}

fn rhs_decay(t: f64, y: &[f64; 64], out: &![f64; 64]) with Mut {
    let _ = t
    out[0] = -0.5 * y[0]
}

fn rhs_lotka_volterra(t: f64, y: &[f64; 64], out: &![f64; 64]) with Mut {
    let _ = t
    let alpha = 1.1
    let beta = 0.4
    let delta = 0.1
    let gamma = 0.4
    let prey = y[0]
    let pred = y[1]
    out[0] = alpha * prey - beta * prey * pred
    out[1] = delta * prey * pred - gamma * pred
}

fn rhs_oscillator(t: f64, y: &[f64; 64], out: &![f64; 64]) with Mut {
    let _ = t
    let omega = 2.0
    let zeta = 0.1
    let x = y[0]
    let v = y[1]
    out[0] = v
    out[1] = -omega * omega * x - 2.0 * zeta * omega * v
}

fn main() -> i64 with IO, Mut, Div, Panic {
    println("==============================================================")
    println("  Generic ODE Solver — fn-type RHS Parameter Tests")
    println("==============================================================")
    var n_pass = 0

    var y_decay = og_zero()
    y_decay[0] = 100.0
    let result_decay = solve_generic(rhs_decay, y_decay, 1, 0.0, 5.0, 0.01, 1000)
    let y_exact = 8.20849986239
    let err_decay = og_abs(result_decay[0] - y_exact) / y_exact
    println("  T1 Exp Decay: y(5) = ")
    println(result_decay[0])
    println("  Relative error: ")
    println(err_decay)
    let t1 = err_decay < 0.002
    if t1 { println("  PASS T1: Exponential decay matches analytical") } else { println("  FAIL T1") }
    if t1 { n_pass = n_pass + 1 }

    var y_lv = og_zero()
    y_lv[0] = 10.0
    y_lv[1] = 5.0
    let result_lv = solve_generic(rhs_lotka_volterra, y_lv, 2, 0.0, 20.0, 0.01, 5000)
    println("  T2 Lotka-Volterra: prey(20)=")
    println(result_lv[0])
    println("  predator(20)=")
    println(result_lv[1])
    let t2 = result_lv[0] > 0.0 && result_lv[1] > 0.0
    if t2 { println("  PASS T2: Lotka-Volterra populations remain positive") } else { println("  FAIL T2") }
    if t2 { n_pass = n_pass + 1 }

    var y_osc = og_zero()
    y_osc[0] = 1.0
    y_osc[1] = 0.0
    let result_osc = solve_generic(rhs_oscillator, y_osc, 2, 0.0, 10.0, 0.005, 5000)
    println("  T3 Oscillator: x(10)=")
    println(result_osc[0])
    let t3 = og_abs(result_osc[0]) < 1.0
    if t3 { println("  PASS T3: Damped oscillator decays correctly") } else { println("  FAIL T3") }
    if t3 { n_pass = n_pass + 1 }

    let t4 = result_decay[0] < 10.0 && result_lv[0] > 1.0 && og_abs(result_osc[0]) < og_abs(result_lv[0])
    if t4 { println("  PASS T4: Solver correctly differentiates between systems") } else { println("  FAIL T4") }
    if t4 { n_pass = n_pass + 1 }

    println("")
    println("==============================================================")
    print("RESULT: ")
    print_int(n_pass)
    println(" / 4 PASS")
    println("==============================================================")
    if n_pass == 4 { 0 } else { 1 }
}
