//@ run-pass
//@ expect-stdout-contains: METHOD_REF_RECEIVER_OK
// A method call whose receiver is a reference resolves on the pointee.
//
// `impl S { fn get(self: &S) }` declares the borrow on self, so a function
// holding `s: &S` and writing `s.get()` is the ordinary shape for code that
// does not own its argument. It used to fall through every branch of the
// method dispatch and report E019, "method calls are not supported for this
// type" -- about a struct that has an impl block.
//
// Measured before the fix on Madaros v0.80.0: the `&S` and `&!S` arms below
// were both rejected with E019; the by-value arm and a plain local receiver
// always worked.
//
// Related: tests/run-pass/method_on_deref_field.sio covers the same defect
// reached through `(*o).field.method()`, and was red on the committed binary.

struct S {
    a: i64,
}

impl S {
    fn get(self: &S) -> i64 { self.a }
    fn bump(self: &!S) with Mut { self.a = self.a + 1 }
}

fn by_value(s: S) -> i64 { s.get() }

fn by_ref(s: &S) -> i64 { s.get() }

fn by_excl_ref(s: &!S) with Mut { s.bump() }

fn main() -> i32 with IO, Mut {
    let a = S { a: 7 }
    if by_value(a) != 7 {
        print("method_ref_receiver: FAIL (by value)\n")
        return 1
    }

    let b = S { a: 7 }
    if by_ref(&b) != 7 {
        print("method_ref_receiver: FAIL (shared reference)\n")
        return 1
    }

    var c = S { a: 41 }
    by_excl_ref(&!c)
    if c.a != 42 {
        print("method_ref_receiver: FAIL (exclusive reference)\n")
        return 1
    }

    print("METHOD_REF_RECEIVER_OK\n")
    0
}
