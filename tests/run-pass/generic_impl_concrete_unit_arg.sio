//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_concrete_unit_arg
// A bare impl-target argument is a type parameter only when it is the target
// struct's own parameter. `impl Cell<mg>` on `struct Cell<T>` names the unit mg, but
// the impl scope took every bare argument for a parameter and a unit is looked up
// AFTER that scope, so mg became an opaque parameter: `k + k` on an mg was lowered
// as integer arithmetic and returned -0.0 (25 + 25 must be 50). The same holds for
// any unit (mg_dL here). The control, a parameter that is spelled like a unit and
// must stay a parameter, is generic_impl_param_spelled_like_unit.sio.

struct Cell<T> {
    v: T,
}

impl Cell<mg> {
    fn echo(self: &Cell<mg>, k: mg) -> mg {
        k
    }
    fn twice(self: &Cell<mg>, k: mg) -> mg {
        k + k
    }
}

struct Level<T> {
    v: T,
}

impl Level<mg_dL> {
    fn twice(self: &Level<mg_dL>, k: mg_dL) -> mg_dL {
        k + k
    }
}

fn main() -> i32 with IO {
    var ok: i64 = 0

    let c: Cell<mg> = Cell { v: 1.0 }
    let e: mg = 25.0
    let a: mg = c.echo(e)
    let b: mg = c.twice(e)
    if a as f64 == 25.0 { ok = ok + 1 }
    if b as f64 == 50.0 { ok = ok + 1 }

    let l: Level<mg_dL> = Level { v: 1.0 }
    let g: mg_dL = 90.0
    let d: mg_dL = l.twice(g)
    if d as f64 == 180.0 { ok = ok + 1 }

    if ok == 3 {
        println("PASS generic_impl_concrete_unit_arg")
    } else {
        println("FAIL generic_impl_concrete_unit_arg")
        print_int(ok)
        println("")
    }
    0
}
