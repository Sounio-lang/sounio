//@ run-pass
//@ expect-stdout-contains: TRIPLES 343 PASS
//@ expect-stdout-contains: NONFANO 168 PASS
//@ expect-stdout-contains: FANO 175 PASS
//@ expect-stdout-contains: BINARY-NORM {-2,0,+2} PASS
//@ expect-stdout-contains: FORWARD 84 PASS
//@ expect-stdout-contains: BACKWARD 84 PASS
//@ expect-stdout-contains: ARROW-SYMMETRY PASS
// The OTHER 168, EXECUTED. The 168-theorem has two faces the Lean bridge proves equal
// (formal/lean4/SounioZeroDivisorBridge.lean : nonfano_zd_bridge):
//   * the sedenion zero-divisor census  (168 projective ZD classes) — see sedenion_zd_census_168.sio
//   * the octonion NON-FANO census      (168 non-associative basis triples) — THIS file
// Both equal 168 = |PSL(2,7)|. Here Sounio computes the non-Fano side exactly, by decidable integer
// equality of associator signs (no tolerance), reproducing SounioCayleyDickson.lean's
// non_fano_count_168 / fano_count_175 / partition_343 (native_decide-proven).
//
// Self-contained (inline scalar cd_sigma_c) to avoid the cross-module aggregate lowering defect
// (issue #637). All-i64. Emits `TRIPLE i j k` for the 168 non-Fano triples for cross-toolchain diff.

// Cayley-Dickson sign at level `bits`; returns +/-1. Same recursion as stdlib cd_sigma.
fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}

fn oct_sigma(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 3) }

// Associator signs of the triple (i,j,k):
//   alpha = sigma(i,j)*sigma(i^j,k)  (left assoc)   beta = sigma(j,k)*sigma(i,j^k) (right assoc)
// The triple is non-Fano (non-associative) iff alpha != beta — decidable integer inequality.
fn alpha_sign(i: i64, j: i64, k: i64) -> i64 with Mut, Panic, Div {
    oct_sigma(i, j) * oct_sigma(i ^ j, k)
}
fn beta_sign(i: i64, j: i64, k: i64) -> i64 with Mut, Panic, Div {
    oct_sigma(j, k) * oct_sigma(i, j ^ k)
}
fn is_nonfano(i: i64, j: i64, k: i64) -> bool with Mut, Panic, Div {
    alpha_sign(i, j, k) != beta_sign(i, j, k)
}

fn main() with IO, Mut, Panic, Div {
    var total = 0
    var nonfano = 0
    var fwd = 0        // wave = alpha - beta = +2  (arrow_forward_84)
    var bwd = 0        // wave = -2                 (arrow_backward_84)
    var binary_ok = true   // Binary Norm Theorem: wave in {-2, 0, +2} for ALL triples
    var i = 1
    while i <= 7 {
        var j = 1
        while j <= 7 {
            var k = 1
            while k <= 7 {
                total = total + 1
                let wave = alpha_sign(i, j, k) - beta_sign(i, j, k)
                if wave == 2 { fwd = fwd + 1 }
                if wave == 0 - 2 { bwd = bwd + 1 }
                if wave != 2 && wave != 0 && wave != 0 - 2 { binary_ok = false }
                if is_nonfano(i, j, k) {
                    nonfano = nonfano + 1
                    print("TRIPLE ")
                    print_int(i)
                    print(" ")
                    print_int(j)
                    print(" ")
                    print_int(k)
                    print("\n")
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    let fano = total - nonfano
    if total == 343 { println("TRIPLES 343 PASS") } else { print("TRIPLES FAIL="); println(total) }
    if nonfano == 168 { println("NONFANO 168 PASS") } else { print("NONFANO FAIL="); println(nonfano) }
    if fano == 175 { println("FANO 175 PASS") } else { print("FANO FAIL="); println(fano) }
    // Binary Norm Theorem + arrow symmetry: wave in {-2,0,+2}; exactly 84 at +2, 84 at -2.
    if binary_ok { println("BINARY-NORM {-2,0,+2} PASS") } else { println("BINARY-NORM FAIL") }
    if fwd == 84 { println("FORWARD 84 PASS") } else { print("FORWARD FAIL="); println(fwd) }
    if bwd == 84 { println("BACKWARD 84 PASS") } else { print("BACKWARD FAIL="); println(bwd) }
    if fwd == bwd { println("ARROW-SYMMETRY PASS") } else { println("ARROW-SYMMETRY FAIL") }
}
