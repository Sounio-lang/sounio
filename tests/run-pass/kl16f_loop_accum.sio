//@ run-pass
// KL-16f: loop accumulation of FO SSHADOW (+ H[0,0]) on mut f64.
// Seed-only pin via scripts/ci/lean_single_kl16f_loop_accum_gate.sh —
// no Madaros sabotage.
//
// Mutable f64 vars already had a fixed variance slot, but FO SSHADOW and
// HSHADOW_00 were metadata pointers into ephemeral EXPR slots. `s = s + x`
// therefore kept the last iteration (or 0), not k.

fn main() with IO, Epistemic {
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let x = xm.value
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 3 { s = s + x; i = i + 1 }
    println(sensitivity_of(s, 0))  // 3.0
    println(hessian_of(s, 0, 0))   // 0.0
}
