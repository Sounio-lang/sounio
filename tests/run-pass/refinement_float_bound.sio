//@ run-pass
//@ expect-stdout: float refinement: PASS

// Refinement type with float base type and bound
type Probability = { p: f64 | p >= 0 };

fn main() -> i32 with IO, Mut, Panic, Div {
    let prob: Probability = 0.75    // 0.75 >= 0 — OK
    if prob >= 0.0 {
        print("float refinement: PASS\n")
    }
    return 0
}
