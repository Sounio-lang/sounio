//@ run-pass
// Mini-compiler struct test: large struct (>8 fields) parameter passing

struct BigStruct {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
    f: i64,
    g: i64,
    h: i64,
    i: i64,
    j: i64,
}

fn sum_big(s: BigStruct) -> i64 {
    s.a + s.b + s.c + s.d + s.e + s.f + s.g + s.h + s.i + s.j
}

fn main() -> i64 with IO {
    let s = BigStruct { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 }
    let total = sum_big(s)
    print_int(total)
    print("\n")
    0
}
