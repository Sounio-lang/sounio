//@ run-pass
//@ requires: madaros

// Parses a real openssl-generated EC (P-256) certificate and confirms the
// extracted public key point matches openssl's own reported value. Before
// this task, stdlib/x509/cert.sio's subjectPublicKeyInfo parser never
// inspected the AlgorithmIdentifier's OID at all -- it unconditionally
// assumed the BIT STRING held an RSAPublicKey SEQUENCE. A certificate
// presenting an ECDSA public key had nowhere to be stored (confirmed by
// grep: zero hits of the id-ecPublicKey OID anywhere in stdlib/x509/ before
// this task). This test exercises the new EC branch end to end.
//
// Certificate generated via (commands from this task's brief):
//   openssl ecparam -name prime256v1 -genkey -noout -out ec_test_key.pem
//   openssl req -new -x509 -key ec_test_key.pem -out ec_test_cert.pem \
//     -days 1 -subj "/CN=ec-test.example"
//   openssl x509 -in ec_test_cert.pem -outform DER -out ec_test_cert.der
//
// `openssl x509 -in ec_test_cert.pem -noout -text` reports:
//   Public Key Algorithm: id-ecPublicKey
//   Public-Key: (256 bit)
//   ASN1 OID: prime256v1
// `openssl ec -in ec_test_key.pem -text -noout` reports the same raw
// uncompressed point (`pub:` field, `04 || X || Y`) embedded below in
// `expected_x_limbs`/`expected_y_limbs`:
//   04:e1:05:21:19:f7:e1:fd:70:3b:05:d9:1c:c1:74:
//   4f:fc:bc:c4:bf:c0:54:da:df:e8:a1:18:10:ce:3b:
//   ce:0f:b8:72:a9:e2:06:af:5c:40:2f:60:33:87:24:
//   34:1e:ee:73:01:ad:14:3f:37:66:27:62:5f:89:db:
//   4a:55:e0:c4:ea
//
// Independently cross-checked against the certificate's own DER bytes via
// `openssl asn1parse -in ec_test_cert.der -inform DER`: the
// SubjectPublicKeyInfo SEQUENCE (`30 59`) contains an AlgorithmIdentifier
// SEQUENCE (`30 13`) with OID `06 07 2A 86 48 CE 3D 02 01` (id-ecPublicKey,
// 7 bytes) followed by curve OID `06 08 2A 86 48 CE 3D 03 01 07`
// (prime256v1, 8 bytes) -- both independently re-derived from their
// dotted-decimal form (1.2.840.10045.2.1 / 1.2.840.10045.3.1.7) via the
// standard ASN.1 OID base-128 encoding rule, and matching these real
// openssl-emitted bytes exactly (see stdlib/x509/oid.sio's own comment for
// the derivation). The BIT STRING (`03 42 00 04 ...`) has content_len 0x42
// = 66 bytes: 1 "unused bits" byte + 1 uncompressed-point prefix (0x04) +
// 32 bytes X + 32 bytes Y -- the same 65 raw point bytes reproduced above.

use x509::cert::*
use crypto::ecdsa_p256::*
use bignum::bigint::*
use net::socket::*

// Little-endian 16-bit limbs of the real certificate's EC public key X
// coordinate, independently regrouped (big-endian byte pairs -> u16,
// least-significant pair first) from the `pub:` bytes quoted above.
fn expected_x_limbs() -> [u16; 16] {
    let r: [u16; 16] = [
        4024, 15310, 4302, 41240, 57320, 21722, 49088, 48324,
        20476, 49524, 55580, 15109, 64880, 63457, 8473, 57605,
    ]
    r
}

fn expected_y_limbs() -> [u16; 16] {
    let r: [u16; 16] = [
        50410, 21984, 56138, 24457, 10082, 14182, 5183, 429,
        61043, 13342, 34596, 24627, 16431, 44892, 57862, 29353,
    ]
    r
}

fn build_bigint_16(values: [u16; 16]) -> BigInt {
    var result = bigint_zero()
    var i: i64 = 0
    while i < 16 {
        result.limbs[i as usize] = values[i as usize]
        i = i + 1
    }
    result.len = 16
    result
}

fn main() -> i64 with IO {
    let total_len: i64 = 398
    let buf = rawbuf_new(total_len + 8)

    let bytes: [i64; 398] = [
        0x30, 0x82, 0x01, 0x8A, 0x30, 0x82, 0x01, 0x2F, 0xA0, 0x03, 0x02, 0x01,
        0x02, 0x02, 0x14, 0x5D, 0x4F, 0x92, 0x4A, 0x65, 0x94, 0x37, 0x7A, 0x1B,
        0xCA, 0x8B, 0x62, 0x0F, 0x55, 0x03, 0xCB, 0x8F, 0x5D, 0xC8, 0x80, 0x30,
        0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x30,
        0x1A, 0x31, 0x18, 0x30, 0x16, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C, 0x0F,
        0x65, 0x63, 0x2D, 0x74, 0x65, 0x73, 0x74, 0x2E, 0x65, 0x78, 0x61, 0x6D,
        0x70, 0x6C, 0x65, 0x30, 0x1E, 0x17, 0x0D, 0x32, 0x36, 0x30, 0x38, 0x32,
        0x35, 0x32, 0x33, 0x35, 0x37, 0x34, 0x31, 0x5A, 0x17, 0x0D, 0x32, 0x36,
        0x30, 0x38, 0x32, 0x36, 0x32, 0x33, 0x35, 0x37, 0x34, 0x31, 0x5A, 0x30,
        0x1A, 0x31, 0x18, 0x30, 0x16, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C, 0x0F,
        0x65, 0x63, 0x2D, 0x74, 0x65, 0x73, 0x74, 0x2E, 0x65, 0x78, 0x61, 0x6D,
        0x70, 0x6C, 0x65, 0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2A, 0x86, 0x48,
        0xCE, 0x3D, 0x02, 0x01, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x03,
        0x01, 0x07, 0x03, 0x42, 0x00, 0x04, 0xE1, 0x05, 0x21, 0x19, 0xF7, 0xE1,
        0xFD, 0x70, 0x3B, 0x05, 0xD9, 0x1C, 0xC1, 0x74, 0x4F, 0xFC, 0xBC, 0xC4,
        0xBF, 0xC0, 0x54, 0xDA, 0xDF, 0xE8, 0xA1, 0x18, 0x10, 0xCE, 0x3B, 0xCE,
        0x0F, 0xB8, 0x72, 0xA9, 0xE2, 0x06, 0xAF, 0x5C, 0x40, 0x2F, 0x60, 0x33,
        0x87, 0x24, 0x34, 0x1E, 0xEE, 0x73, 0x01, 0xAD, 0x14, 0x3F, 0x37, 0x66,
        0x27, 0x62, 0x5F, 0x89, 0xDB, 0x4A, 0x55, 0xE0, 0xC4, 0xEA, 0xA3, 0x53,
        0x30, 0x51, 0x30, 0x1D, 0x06, 0x03, 0x55, 0x1D, 0x0E, 0x04, 0x16, 0x04,
        0x14, 0x5F, 0x4F, 0x0A, 0xF0, 0xBB, 0x04, 0xCC, 0x15, 0x12, 0xE0, 0x09,
        0x47, 0x2C, 0xE1, 0x31, 0xFD, 0xD9, 0x6E, 0x1C, 0xBD, 0x30, 0x1F, 0x06,
        0x03, 0x55, 0x1D, 0x23, 0x04, 0x18, 0x30, 0x16, 0x80, 0x14, 0x5F, 0x4F,
        0x0A, 0xF0, 0xBB, 0x04, 0xCC, 0x15, 0x12, 0xE0, 0x09, 0x47, 0x2C, 0xE1,
        0x31, 0xFD, 0xD9, 0x6E, 0x1C, 0xBD, 0x30, 0x0F, 0x06, 0x03, 0x55, 0x1D,
        0x13, 0x01, 0x01, 0xFF, 0x04, 0x05, 0x30, 0x03, 0x01, 0x01, 0xFF, 0x30,
        0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x03,
        0x49, 0x00, 0x30, 0x46, 0x02, 0x21, 0x00, 0xEA, 0xDD, 0x46, 0x34, 0x0E,
        0x05, 0xFE, 0x45, 0x3A, 0xFC, 0x88, 0x98, 0x50, 0xC3, 0x70, 0xF6, 0xAB,
        0x95, 0xD7, 0x9D, 0x8F, 0x73, 0xC8, 0x51, 0xBA, 0x89, 0x1B, 0xB7, 0x7A,
        0x10, 0x37, 0xEA, 0x02, 0x21, 0x00, 0xF2, 0xEE, 0x44, 0xD1, 0x97, 0x0A,
        0x4F, 0xF1, 0x03, 0x71, 0x13, 0xD6, 0x16, 0x56, 0x89, 0xFC, 0x65, 0x89,
        0x1A, 0x3E, 0xE0, 0x5D, 0x48, 0x29, 0xE9, 0x5E, 0x94, 0x99, 0x8E, 0x54,
        0x1A, 0x50,
    ]

    var i: i64 = 0
    while i < total_len {
        rawbuf_set(&buf, i, bytes[i as usize])
        i = i + 1
    }

    // Per Finding 25's workaround (tuple-destructured struct-typed local
    // does not propagate the struct type): declare `cert` first via
    // certificate_zero(), then overwrite its VALUE via assignment.
    var cert = certificate_zero()
    let (cert_raw, status) = x509_parse_certificate(&buf, total_len)
    cert = cert_raw

    if status != X509_OK {
        println("x509_ec_public_key_parsing: parse failed")
        return 1
    }

    if cert.public_key_algorithm != PUBKEY_ALG_EC_P256 {
        println("x509_ec_public_key_parsing: wrong algorithm detected")
        return 1
    }

    let expected_x = build_bigint_16(expected_x_limbs())
    let expected_y = build_bigint_16(expected_y_limbs())

    if bigint_cmp(&cert.ec_public_key.x, &expected_x) != 0 {
        println("x509_ec_public_key_parsing: X coordinate mismatch")
        return 1
    }
    if bigint_cmp(&cert.ec_public_key.y, &expected_y) != 0 {
        println("x509_ec_public_key_parsing: Y coordinate mismatch")
        return 1
    }

    // Negative/regression guard: an EC certificate must NOT populate the
    // RSA-only fields.
    if bigint_cmp(&cert.modulus, &bigint_zero()) != 0 {
        println("x509_ec_public_key_parsing: modulus unexpectedly non-zero for an EC certificate")
        return 1
    }
    if bigint_cmp(&cert.public_exponent, &bigint_zero()) != 0 {
        println("x509_ec_public_key_parsing: public_exponent unexpectedly non-zero for an EC certificate")
        return 1
    }

    println("x509_ec_public_key_parsing: EC public key extracted correctly")
    return 0
}
