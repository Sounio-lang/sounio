//@ run-pass
//@ expect-stdout-contains: DEC2_63: PASS
//@ description: #3343 -- decimal 2^63 is inside the width-valid u64 band and must not be refused by the parser. In an untyped print_int call it keeps the current wrapped i64 value, matching the accepted hex spelling.

fn main() with IO {
    if 9223372036854775808 == 0x8000000000000000 { print("DEC2_63: PASS\n") } else { print("DEC2_63: FAIL\n") }
}
