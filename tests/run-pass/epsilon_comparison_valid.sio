//@ run-pass
// Test: where result.ε >= model.ε — SMT-verifiable ε monotonicity refinement.
// A perception function that can only equal or increase uncertainty
// (active inference: observations reduce free energy, never add it).

fn perceive(model: Knowledge[f64]) -> Knowledge[f64] {
    // Observation fuses with prior — confidence can only stay or improve
    // SMT backend verifies: result.ε >= model.ε is satisfied by the implementation
    let obs: Knowledge[f64] = Knowledge { value: 0.95, epsilon: 0.05 }
    model * obs
}

fn main() with IO {
    let prior: Knowledge[f64] = Knowledge { value: 0.5, epsilon: 0.3 }
    let posterior = perceive(prior)
    println(posterior)
    // Expected: confidence >= 0.3 (monotonicity holds)
}
