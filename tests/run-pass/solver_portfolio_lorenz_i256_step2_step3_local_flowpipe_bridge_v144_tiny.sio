//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v144 smoke for Lorenz i256 step-2-to-step-3 local-flowpipe bridge

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt: i64 = 2087
    receipt = mix(receipt, 158202075, 6113)
    receipt = mix(receipt, 952956886, 6113)
    receipt = mix(receipt, 839567289, 6113)
    receipt = mix(receipt, 443349153, 6113)
    receipt = mix(receipt, 251844917, 6113)
    receipt = mix(receipt, 727603483, 6113)
    receipt = mix(receipt, 149302752, 6113)
    receipt = mix(receipt, 253587342, 6113)
    receipt = mix(receipt, 335080767, 6113)
    receipt = mix(receipt, 899209716, 6113)
    receipt = mix(receipt, 249889958, 6113)
    receipt = mix(receipt, 603078026, 6113)
    receipt = mix(receipt, 2, 6113)
    receipt = mix(receipt, 3, 6113)
    receipt = mix(receipt, 17, 6113)
    receipt = mix(receipt, 255, 6113)
    if receipt != 151952098 { return 1 }

    var audit: i64 = 2089
    audit = mix(audit, receipt, 6121)
    audit = mix(audit, 158202075, 6121)
    audit = mix(audit, 952956886, 6121)
    audit = mix(audit, 538682593, 6121)
    audit = mix(audit, 591327954, 6121)
    audit = mix(audit, 149302752, 6121)
    audit = mix(audit, 253587342, 6121)
    audit = mix(audit, 251844917, 6121)
    audit = mix(audit, 335080767, 6121)
    audit = mix(audit, 899209716, 6121)
    audit = mix(audit, 249889958, 6121)
    audit = mix(audit, 603078026, 6121)
    audit = mix(audit, 2, 6121)
    audit = mix(audit, 3, 6121)
    audit = mix(audit, 17, 6121)
    audit = mix(audit, 255, 6121)
    if audit != 395014347 { return 2 }

    var entry: i64 = 101
    entry = mix(entry, 147, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 147, 1103)
    if entry != 687754680 { return 3 }

    var manifest: i64 = 107
    manifest = mix(manifest, 144, 1151)
    manifest = mix(manifest, 148, 1151)
    manifest = mix(manifest, 183919651, 1151)
    manifest = mix(manifest, 961360409, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 658146531 { return 4 }

    var result: i64 = 131
    result = mix(result, 144, 1871)
    result = mix(result, 148, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 136, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 172399202 { return 5 }

    var family: i64 = 149
    family = mix(family, 144, 1907)
    family = mix(family, 148, 1907)
    family = mix(family, 6, 1907)
    family = mix(family, 4, 1907)
    family = mix(family, 3, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, 131, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, manifest, 1907)
    if family != 799559864 { return 6 }

    var acceptance: i64 = 137
    acceptance = mix(acceptance, 144, 1889)
    acceptance = mix(acceptance, manifest, 1889)
    acceptance = mix(acceptance, result, 1889)
    if acceptance != 543027310 { return 7 }

    var audit_receipt: i64 = 157
    audit_receipt = mix(audit_receipt, 144, 1931)
    audit_receipt = mix(audit_receipt, manifest, 1931)
    audit_receipt = mix(audit_receipt, result, 1931)
    audit_receipt = mix(audit_receipt, family, 1931)
    audit_receipt = mix(audit_receipt, acceptance, 1931)
    if audit_receipt != 612345619 { return 8 }

    var readiness: i64 = 163
    readiness = mix(readiness, 144, 1951)
    readiness = mix(readiness, 31, 1951)
    readiness = mix(readiness, manifest, 1951)
    readiness = mix(readiness, result, 1951)
    readiness = mix(readiness, family, 1951)
    readiness = mix(readiness, acceptance, 1951)
    readiness = mix(readiness, audit_receipt, 1951)
    if readiness != 509107988 { return 9 }
    return 0
}
