//@ run-pass
//@ description: #2504 `.value` of a Knowledge<i64> held in a struct field is the integer payload (compare, arithmetic, print), not its bits read as f64; Knowledge<f64> fields are the control
//@ expect-stdout: field_let=42
//@ expect-stdout: field_eq42=true
//@ expect-stdout: field_eq0=false
//@ expect-stdout: field_plus1=43
//@ expect-stdout: field_print=42
//@ expect-stdout: f64_field_eq=true
//@ expect-stdout: f64_field_sq=6.250000
//@ expect-stdout: KNOWLEDGE_I64_FIELD_2504_OK
//
// Before the fix Madaros printed field_eq42=false: the base of `h.k.value` is a
// field access, which field_base_kn_value_float_ref did not resolve, so the
// compare fell to the synthetic Knowledge layout's f64 `value` and compared the
// i64 42 as the f64 with those bits.

struct H { k: Knowledge<i64>, tag: i64 }

struct F { m: Knowledge<f64> }

fn main() -> i64 with IO, Epistemic {
    let a: Knowledge<i64> = measure(42, uncertainty: 1.0)
    let h = H { k: a, tag: 7 }
    let v: i64 = h.k.value
    print("field_let=")
    println(v)
    var fails: i64 = 0
    if h.k.value == 42 { println("field_eq42=true") } else { println("field_eq42=false"); fails = fails + 1 }
    if h.k.value == 0 { println("field_eq0=true"); fails = fails + 1 } else { println("field_eq0=false") }
    let p = h.k.value + 1
    print("field_plus1=")
    println(p)
    if p != 43 { fails = fails + 1 }
    print("field_print=")
    println(h.k.value)

    let b: Knowledge<f64> = measure(2.5, uncertainty: 0.1)
    let f = F { m: b }
    if f.m.value == 2.5 { println("f64_field_eq=true") } else { println("f64_field_eq=false"); fails = fails + 1 }
    print("f64_field_sq=")
    println(f.m.value * f.m.value)
    if h.tag != 7 { fails = fails + 1 }
    if fails == 0 { println("KNOWLEDGE_I64_FIELD_2504_OK") } else { println("KNOWLEDGE_I64_FIELD_2504_FAIL") }
    fails
}
