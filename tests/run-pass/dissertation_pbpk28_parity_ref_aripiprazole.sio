//@ run-pass
//@ timeout: 300
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — ARIPIPRAZOLE (SIO-523)
//
// Single 15 mg oral IR tablet (Abilify standard single dose): gut pool +
// first-order absorption (ka = 1.2/h, F = 0.87, first-pass loss) → parent
// PBPK28 CN with the summed parallel CYP sink (CYP3A4 1.92 + CYP2D6 1.81 x
// phenotype scale) solved implicitly on the liver. NM phenotype (2) is the
// parity reference. Extended 336 h horizon (4.5 parent half-lives).
//
// CL values DERIVED from label t1/2 + Vd (see drugs/aripiprazole.sio).
// Dehydro-aripiprazole (active) is explicitly out of scope (follow-up);
// this card tests the parallel pathways and the extended-horizon
// integration, not the metabolite.
//
// This ref runs the stdlib scenario ITSELF
// (scenarios/aripiprazole_oral.sio): its step, its gut law, its params.
// It holds no copy of the model. The companion is
// website/src/lib/pbpk28_core.mjs (runAripiprazoleScenario) via the
// dedicated runner scripts/dissertation/run_aripiprazole_node.mjs, and
// the gate case at scripts/ci/dissertation_pbpk28_parity_gate.sh.
//
// PK only, single dose, no LAI claim. No clinical-validity claim: parity
// only (ADR009).
//
// Integrator: fully-coupled CN on the 27-state arrow matrix, dt = 0.01,
// gut exact-split per step (same construction as the Node runner).
// ============================================================================

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::scenarios::aripiprazole_oral::*
use io::sci_print::*

fn nm() -> i32 { return 2 }

fn emit_at(scen: AripiprazoleScenario, t: f64) with IO, Mut, Div {
    let p = arp_pbpk28_params()
    var i = 0
    while i < 14 {
        print("ARIP|t=")
        println(t)
        println("")
        print("ARIP|i=")
        println(i)
        print("ARIP|cv=")
        println_f64_sci(scen.pbpk.cv[i], 10)
        print("ARIP|ct=")
        println_f64_sci(scen.pbpk.ct[i], 10)
        print("ARIP|cavg=")
        println_f64_sci(pbpk28_organ_average(scen.pbpk, p, i), 10)
        i = i + 1
    }
    print("AMASS|t=")
    println(t)
    println("")
    print("AMASS|m=")
    println(arp_mass(scen, p))
    println("")
    print("AREL|t=")
    println(t)
    println("")
    print("AREL|abs=")
    println(arp_cum_absorbed(scen))
    println("")
    print("AREL|cyp=")
    println(arp_cum_cyp(scen))
    println("")
    print("ARES|m=")
    println_f64_sci(arp_residual(scen, p), 10)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_ARIPIPRAZOLE_PARITY_REF v1")
    println("compartments=14")
    println("systems=1")
    println("dt=0.01")
    println("dose_mg=15.0")
    println("F_oral=0.87")
    println("ka_h_inv=1.2")
    println("cl_3a4_L_per_h=0.23")
    println("cl_2d6_nm_L_per_h=0.21")
    println("integrator=fully_coupled_CN_27state")
    println("drug=aripiprazole")
    println("metabolite=dehydro-aripiprazole OUT OF SCOPE")
    println("samples=12")
    println("formation=implicit_parallel_cyp_liver_sink")
    println("model=stdlib_scenario")

    let dt = 0.01
    var s = arp_scenario_init(nm())
    var t = 0.0

    var target = 1.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 2.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 4.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 8.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 12.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 24.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 48.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 72.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 120.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 168.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 240.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 336.0
    s = arp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)

    println("DISSERTATION_PBPK28_ARIPIPRAZOLE_PARITY_DONE")
    return 0
}
