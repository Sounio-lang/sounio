//@ run-pass
//@ expect-stdout-contains: SPECIALIZER_NESTED_TARG_OK
// Guards the instantiation-naming fix in check/specializer.sio.
//
// spec_render_type_name used to keep the head name of a single-segment named
// type and DROP its own arguments, so `Cell<i64>` rendered as `Cell`. Two
// instantiations whose arguments differed only inside the nesting therefore
// mangled identically, hashed equal, and shared one clone or one emitted
// struct — without ever tripping the second-instantiation poison guard.
//
// This file exercises the two shapes that must keep working. Each uses its own
// template, because poisoning is per template slot:
//   1. `hold` — one instantiation with a nested type argument;
//   2. `pick` — two instantiations with distinct *scalar* type arguments, the
//      only multi-instantiation shape monomorphization survives.
// The refused shape lives in
// tests/compile-fail/specializer_multi_instantiation_nonscalar.sio.
//
// See docs/handoff/BLK-20260903-specializer-nested-targ-collision.md.

struct Cell<T> {
    v: T,
}

fn hold<T>(a: T, b: T) -> T {
    a
}

fn pick<T>(a: T, b: T) -> T {
    a
}

fn main() -> i32 with IO {
    let ci: Cell<i64> = hold::<Cell<i64>>(Cell { v: 7 }, Cell { v: 9 })
    let vi: i64 = ci.v
    if vi != 7 {
        print("nested_targ: FAIL (nested single instantiation)\n")
        return 1
    }

    let a: i64 = pick::<i64>(7, 9)
    if a != 7 {
        print("nested_targ: FAIL (scalar i64 lane)\n")
        return 1
    }

    let b: f64 = pick::<f64>(1.5, 2.5)
    if b < 1.4 || b > 1.6 {
        print("nested_targ: FAIL (scalar f64 lane)\n")
        return 1
    }

    print("SPECIALIZER_NESTED_TARG_OK\n")
    0
}
