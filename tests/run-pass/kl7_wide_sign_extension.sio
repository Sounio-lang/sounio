//@ run-pass
//@ requires: madaros
//@ expect-stdout: KL7_WIDE_SIGN_EXTENSION_OK
//@ description: KL-7 signed i256/i512 values materialise every high limb
//@ sabotage: wide-mul

fn main() -> i64 with IO {
    let zero256: i256 = 0 as i256
    let one256: i256 = 1 as i256

    let literal_neg1: i256 = 0 - 1
    if (literal_neg1 >> 192) as i64 != 0 - 1 { return 11 }
    if literal_neg1 + one256 != zero256 { return 12 }

    let cast_neg1: i256 = (0 - 1) as i256
    if (cast_neg1 >> 192) as i64 != 0 - 1 { return 13 }
    if cast_neg1 + one256 != zero256 { return 14 }

    let two32: i256 = 4294967296 as i256
    let two64: i256 = two32 * two32
    let two70: i256 = two64 * (64 as i256)
    let neg_two70: i256 = -two70
    if (neg_two70 >> 192) as i64 != 0 - 1 { return 15 }
    if neg_two70 + two70 != zero256 { return 16 }

    let zero512: i512 = 0 as i512
    let one512: i512 = 1 as i512
    let neg512: i512 = 0 - 1
    if (neg512 >> 448) as i64 != 0 - 1 { return 17 }
    if neg512 + one512 != zero512 { return 18 }

    println("KL7_WIDE_SIGN_EXTENSION_OK")
    0
}
