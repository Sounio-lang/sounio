//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 projection certificate envelope receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn envelope_fingerprint(
    trajectory_manifest_fp: i64,
    projection_inclusion_fp: i64,
    projection_contract_fp: i64,
    projection_div_witness_fp: i64,
    directed_rounding_fp: i64,
    interval_containment_fp: i64,
    interval_containment_audit_fp: i64,
    bridge_instance_fp: i64,
    bridge_certificate_fp: i64,
    bridge_audit_fp: i64,
    final_enclosure_receipt_fp: i64,
    ball_fixed_enclosure_fp: i64,
    range_budget_fp: i64,
    roundoff_budget_fp: i64,
    projection_margin_budget_fp: i64,
    portfolio_v36_readiness_fp: i64) -> i64 {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if projection_contract_fp != 607091799 { return 0 - 1 }
    if projection_div_witness_fp != 693793961 { return 0 - 1 }
    if directed_rounding_fp != 80894555 { return 0 - 1 }
    if interval_containment_fp != 310218620 { return 0 - 1 }
    if interval_containment_audit_fp != 501185861 { return 0 - 1 }
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if bridge_certificate_fp != 138609006 { return 0 - 1 }
    if bridge_audit_fp != 488107916 { return 0 - 1 }
    if final_enclosure_receipt_fp != 114244647 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if range_budget_fp != 87220662 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }
    if portfolio_v36_readiness_fp != 19419291 { return 0 - 1 }

    var fp: i64 = 383
    fp = mix(fp, trajectory_manifest_fp, 2683)
    fp = mix(fp, 23144051, 2683)
    fp = mix(fp, 561641681, 2683)
    fp = mix(fp, projection_inclusion_fp, 2683)
    fp = mix(fp, projection_contract_fp, 2683)
    fp = mix(fp, projection_div_witness_fp, 2683)
    fp = mix(fp, directed_rounding_fp, 2683)
    fp = mix(fp, interval_containment_fp, 2683)
    fp = mix(fp, interval_containment_audit_fp, 2683)
    fp = mix(fp, bridge_instance_fp, 2683)
    fp = mix(fp, bridge_certificate_fp, 2683)
    fp = mix(fp, bridge_audit_fp, 2683)
    fp = mix(fp, final_enclosure_receipt_fp, 2683)
    fp = mix(fp, ball_fixed_enclosure_fp, 2683)
    fp = mix(fp, range_budget_fp, 2683)
    fp = mix(fp, roundoff_budget_fp, 2683)
    fp = mix(fp, projection_margin_budget_fp, 2683)
    fp = mix(fp, portfolio_v36_readiness_fp, 2683)
    return fp
}

fn envelope_audit_fingerprint(envelope_fp: i64) -> i64 {
    if envelope_fp != 77888110 { return 0 - 1 }

    var fp: i64 = 389
    fp = mix(fp, envelope_fp, 2699)
    fp = mix(fp, 214180161, 2699)
    fp = mix(fp, 890086395, 2699)
    fp = mix(fp, 607091799, 2699)
    fp = mix(fp, 693793961, 2699)
    fp = mix(fp, 80894555, 2699)
    fp = mix(fp, 310218620, 2699)
    fp = mix(fp, 501185861, 2699)
    fp = mix(fp, 149359034, 2699)
    fp = mix(fp, 138609006, 2699)
    fp = mix(fp, 488107916, 2699)
    fp = mix(fp, 114244647, 2699)
    fp = mix(fp, 166945519, 2699)
    fp = mix(fp, 87220662, 2699)
    fp = mix(fp, 677514412, 2699)
    fp = mix(fp, 69322697, 2699)
    fp = mix(fp, 31, 2699)
    return fp
}

fn main() -> i64 {
    let fp = envelope_fingerprint(
        214180161, 890086395, 607091799, 693793961,
        80894555, 310218620, 501185861,
        149359034, 138609006, 488107916,
        114244647, 166945519, 87220662,
        677514412, 69322697, 19419291)
    if fp != 77888110 { return 1 }
    let audit_fp = envelope_audit_fingerprint(fp)
    if audit_fp != 245178976 { return 2 }
    if envelope_fingerprint(
        214180161, 890086395, 607091799, 693793962,
        80894555, 310218620, 501185861,
        149359034, 138609006, 488107916,
        114244647, 166945519, 87220662,
        677514412, 69322697, 19419291) != (0 - 1) { return 3 }
    return 0
}
