//@ run-pass
//@ expect-stdout: aarch64 closure many params ok
struct Pair { left: i64, right: i64 }

fn pair_sum(p: Pair) -> i64 {
    p.left + p.right
}

fn main() -> i32 with IO, Panic {
    let bias = 3
    let sum9 = |a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64| -> i64 {
        a + b + c + d + e + f + g + h + i + bias
    }
    let make9 = |a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64| -> Pair {
        Pair {
            left: a + e + i + bias,
            right: c + f + h,
        }
    }

    assert(sum9(1, 2, 3, 4, 5, 6, 7, 8, 9) == 48)

    let p = make9(1, 2, 3, 4, 5, 6, 7, 8, 9)
    assert(p.left == 18)
    assert(p.right == 17)
    assert(pair_sum(make9(2, 3, 4, 5, 6, 7, 8, 9, 10)) == 41)

    print("aarch64 closure many params ok\n")
    0
}
