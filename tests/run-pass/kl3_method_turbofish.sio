//@ run-pass
//@ expect-stdout: KL3_METHOD_TURBOFISH_OK
//@ requires: madaros

struct Selector {
    tag: i64,
}

impl Selector {
    fn pick<T>(self: &Selector, a: T, b: T) -> T {
        a
    }
}

fn main() with IO {
    let s = Selector { tag: 0 }
    let got: i64 = s.pick::<i64>(7, 9)
    if got == 7 {
        println("KL3_METHOD_TURBOFISH_OK")
    }
}
