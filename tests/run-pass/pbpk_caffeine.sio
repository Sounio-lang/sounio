//@ run-pass
// One-compartment oral caffeine pharmacokinetic model
// Validates ODE bridge with user-defined RHS and physiological parameters
//
// Model: dA_gut/dt = -ka * A_gut, dA_central/dt = ka * A_gut - ke * A_central
// Parameters: 200 mg oral dose, healthy adult (70 kg)
//   ka = 4.4 /h, CL = 5.46 L/h, V = 42.0 L, ke = CL/V = 0.13 /h, F = 0.99

fn pk_rhs(t: f64, y: [f64]) -> [f64] {
    let ka = 4.4
    let ke = 0.13
    let dA_gut = 0.0 - ka * y[0]
    let dA_central = ka * y[0] - ke * y[1]
    return [dA_gut, dA_central]
}

fn main() {
    let dose = 200.0
    let F = 0.99
    let V = 42.0
    let y0 = [F * dose, 0.0]

    let sol = solve_ode(pk_rhs, y0, 0.0, 24.0, 0.01)

    // Validate against analytical Bateman function
    let idx_1h = 100
    let y_1h = sol.y[idx_1h]
    let Cp_1h = y_1h[1] / V

    let idx_6h = 600
    let y_6h = sol.y[idx_6h]
    let Cp_6h = y_6h[1] / V

    let idx_12h = 1200
    let y_12h = sol.y[idx_12h]
    let Cp_12h = y_12h[1] / V

    let err_1h = Cp_1h - 4.206
    if err_1h < 0.0 { err_1h = 0.0 - err_1h }
    assert(err_1h < 0.1)

    let err_6h = Cp_6h - 2.227
    if err_6h < 0.0 { err_6h = 0.0 - err_6h }
    assert(err_6h < 0.1)

    let err_12h = Cp_12h - 1.021
    if err_12h < 0.0 { err_12h = 0.0 - err_12h }
    assert(err_12h < 0.1)

    let y_final = sol.y[sol.y.len() - 1]
    let total_final = y_final[0] + y_final[1]
    assert(total_final < F * dose)

    println("PBPK caffeine test passed")
    println("  Cp(1h)  = ", Cp_1h, " mg/L (expected ~4.2)")
    println("  Cp(6h)  = ", Cp_6h, " mg/L (expected ~2.2)")
    println("  Cp(12h) = ", Cp_12h, " mg/L (expected ~1.0)")
    println("  Total remaining at 24h: ", total_final, " mg")
}
