//@ run-pass
// One-compartment oral caffeine pharmacokinetic model
// Validates ODE integration with physiological parameters
//
// Model: dA_gut/dt = -ka * A_gut, dA_central/dt = ka * A_gut - ke * A_central
// Parameters: 200 mg oral dose, healthy adult (70 kg)
//   ka = 4.4 /h, CL = 5.46 L/h, V = 42.0 L, ke = CL/V = 0.13 /h, F = 0.99
//
// Rewritten to avoid dynamic arrays and solve_ode builtin
// (lean_single only supports fixed-size arrays)

fn pk_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i64 with IO, Mut, Div, Panic {
    let ka = 4.4
    let ke = 0.13
    let dose = 200.0
    let F_oral = 0.99
    let V = 42.0
    let dt = 0.01

    // Initial conditions: gut has F*dose mg, central has 0
    var y0 = F_oral * dose   // A_gut
    var y1 = 0.0              // A_central

    // RK4 integration from t=0 to t=24h
    // 2400 steps of dt=0.01h
    // Check values at t=1h (step 100), t=6h (step 600), t=12h (step 1200)
    var Cp_1h = 0.0
    var Cp_6h = 0.0
    var Cp_12h = 0.0

    var step = 0
    while step < 2400 {
        // RK4 for 2D system: f0 = -ka*y0, f1 = ka*y0 - ke*y1
        let k1_0 = 0.0 - ka * y0
        let k1_1 = ka * y0 - ke * y1

        let y0h = y0 + 0.5 * dt * k1_0
        let y1h = y1 + 0.5 * dt * k1_1
        let k2_0 = 0.0 - ka * y0h
        let k2_1 = ka * y0h - ke * y1h

        let y0h2 = y0 + 0.5 * dt * k2_0
        let y1h2 = y1 + 0.5 * dt * k2_1
        let k3_0 = 0.0 - ka * y0h2
        let k3_1 = ka * y0h2 - ke * y1h2

        let y0e = y0 + dt * k3_0
        let y1e = y1 + dt * k3_1
        let k4_0 = 0.0 - ka * y0e
        let k4_1 = ka * y0e - ke * y1e

        y0 = y0 + (dt / 6.0) * (k1_0 + 2.0 * k2_0 + 2.0 * k3_0 + k4_0)
        y1 = y1 + (dt / 6.0) * (k1_1 + 2.0 * k2_1 + 2.0 * k3_1 + k4_1)

        step = step + 1
        if step == 100 { Cp_1h = y1 / V }
        if step == 600 { Cp_6h = y1 / V }
        if step == 1200 { Cp_12h = y1 / V }
    }

    // Validate against analytical Bateman function
    let err_1h = pk_abs(Cp_1h - 4.206)
    let err_6h = pk_abs(Cp_6h - 2.227)
    let err_12h = pk_abs(Cp_12h - 1.021)

    var n_pass = 0
    if err_1h < 0.1 { n_pass = n_pass + 1 }
    if err_6h < 0.1 { n_pass = n_pass + 1 }
    if err_12h < 0.1 { n_pass = n_pass + 1 }

    // Total remaining at 24h should be less than initial dose
    let total_final = y0 + y1
    if total_final < F_oral * dose { n_pass = n_pass + 1 }

    if n_pass == 4 {
        println("PBPK caffeine test passed")
        println("  Cp(1h)  correct (expected ~4.2 mg/L)")
        println("  Cp(6h)  correct (expected ~2.2 mg/L)")
        println("  Cp(12h) correct (expected ~1.0 mg/L)")
        println("  Total remaining at 24h < initial dose")
        return 0
    } else {
        println("PBPK caffeine test FAILED")
        return 1
    }
}
