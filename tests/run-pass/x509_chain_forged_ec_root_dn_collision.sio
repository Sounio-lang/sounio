    let hostname_len: i64 = 14
    let hostname_buf = rawbuf_new(32)
    var h: i64 = 0
    while h < hostname_len { rawbuf_set(&hostname_buf, h, hostname_text[h as usize] as i64); h = h + 1 }

    // Fixed literal inside every fixture's validity window (notBefore
    // 2026-08-27 09:15:51 UTC, notAfter 2049-08-26).
    let now_unix: i64 = 1787900000

    let result = x509_verify_chain(&fleaf_cert, &fleaf_buf, &intermediates, &intermediate_bufs, 1, &store, &hostname_buf, hostname_len, now_unix, &rawbuf_new(1), 0)
    if result == CHAIN_OK { print_int(12); return 1 }
    assert(result != CHAIN_OK)

    println("x509_chain_forged_ec_root_dn_collision: ok")
    0
}
