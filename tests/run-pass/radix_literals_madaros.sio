//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: RADIX: PASS
//@ description: ADR-015 row 5 (probes int_bin, int_oct) -- binary `0b` and octal `0o` integer literals, with separators, upper-case prefixes, an integer suffix, leading zeros, the exact 2^64-1 bound of each base, in a pattern and after `return`. Both engines used to read `0b101` as `0` followed by a name `b101`.

fn three() -> i64 {
    return 0b11
}

fn main() with IO {
    var ok: i64 = 1
    if 0b101 != 5 { ok = 0 }
    if 0B11 != 3 { ok = 0 }
    if 0b1010_0101 != 165 { ok = 0 }
    if 0o17 != 15 { ok = 0 }
    if 0O755 != 493 { ok = 0 }
    if 0o7_55 != 493 { ok = 0 }
    if 0o777 != 511 { ok = 0 }
    if -0b1 != -1 { ok = 0 }
    if 0o0000000000000000000000017 != 15 { ok = 0 }
    let byte: u8 = 0b1111_1111u8
    if byte as i64 != 255 { ok = 0 }
    // 2^64-1 in each base: the widest literal either accepts, read as i64 bits.
    if 0b1111111111111111111111111111111111111111111111111111111111111111 != -1 { ok = 0 }
    if 0o1777777777777777777777 != -1 { ok = 0 }
    let m = match 0b10 {
        2 => 1,
        _ => 0,
    }
    if m != 1 { ok = 0 }
    if three() != 3 { ok = 0 }
    if ok == 1 { print("RADIX: PASS\n") } else { print("RADIX: FAIL\n") }
}
