//@ run-pass
//@ requires: lean_single
//@ expect-stdout-contains: NAMES: PASS
//@ description: ADR-015 row 10 (probes kw_let_affine, kw_let_linear, kw_let_study) -- affine, linear and study are valid as binding names, struct fields and in expressions; they stay keywords before an item (`linear struct`, `affine fn`).

struct Rec {
    linear: i64,
    affine: i64,
}

fn main() with IO {
    let affine = 5
    let linear = 7
    let study = 11
    let r = Rec { linear: 1, affine: 2 }
    var ok: i64 = 1
    if affine + linear + study != 23 { ok = 0 }
    if r.linear + r.affine != 3 { ok = 0 }
    if ok == 1 { print("NAMES: PASS\n") } else { print("NAMES: FAIL\n") }
}
