//@ run-pass
//@ requires: madaros
//@ expect-stdout: CD_LEVEL_11_OK
//@ description: level 11 (2048 coefficients) is the largest level and still works through zero, split, embed and eq

use algebra::cayley_dickson::*
use algebra::cayley_dickson_tower::*

fn main() with IO, Mut, Panic, Div {
    let a = cd_zero(11)
    let h = cd_split(cd_one(11))
    let e = cd_embed(cd_one(10), 11)
    if cd_eq(a, cd_zero(11)) && cd_eq(e, cd_one(11)) && cd_eq(cd_join(h.low, h.high, 11), cd_one(11)) {
        println("CD_LEVEL_11_OK")
    }
}
