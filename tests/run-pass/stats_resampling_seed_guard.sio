//@ run-pass
//@ expect-stdout: STATS_RESAMPLING_SEED_GUARD_PASS
use stats::bootstrap::{BootResult,BcaResult,bootstrap_mean,bootstrap_bca_mean}
use stats::permutation::{PermutationResult,permutation_means}
fn same_boot(a:&BootResult,b:&BootResult)->bool {
 return a.status==b.status && a.seed_used==b.seed_used && a.b==b.b &&
 a.mean==b.mean && a.se==b.se && a.lo==b.lo && a.hi==b.hi
}
fn same_bca(a:&BcaResult,b:&BcaResult)->bool {
 return a.status==b.status && a.seed_used==b.seed_used && a.b==b.b &&
 a.mean==b.mean && a.se==b.se && a.lo==b.lo && a.hi==b.hi &&
 a.bias_p==b.bias_p && a.z0==b.z0 && a.acceleration==b.acceleration &&
 a.lower_p==b.lower_p && a.upper_p==b.upper_p &&
 a.less_count==b.less_count && a.equal_count==b.equal_count &&
 a.tail_resolved==b.tail_resolved
}
fn same_permutation(a:&PermutationResult,b:&PermutationResult)->bool {
 return a.status==b.status && a.method==b.method &&
 a.observed_diff==b.observed_diff && a.p_value==b.p_value &&
 a.hits==b.hits && a.draws==b.draws && a.seed_used==b.seed_used &&
 a.mc_available==b.mc_available && a.mc_se==b.mc_se &&
 a.mc_lo==b.mc_lo && a.mc_hi==b.mc_hi &&
 a.exchangeability_assessed==b.exchangeability_assessed
}
fn main() with IO,Mut,Div,Panic {
 // Safe first regression: the old implementation returns here before drawing
 // an index, exposing seed0 without allowing unsafe negative array access.
 var zero:[f64;256]=[0.0;256]
 let first=bootstrap_mean(&zero,6,128,0.95,-2147483646)
 assert(first.status==0)
 assert(first.seed_used==2147483646)
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 x[0]=-3.0;x[1]=-2.0;x[2]=-1.0;x[3]=1.0;x[4]=2.0;x[5]=3.0
 y[0]=-2.0;y[1]=-1.0;y[2]=0.0;y[3]=2.0;y[4]=4.0;y[5]=6.0
 let bp=bootstrap_mean(&x,6,128,0.95,2147483646)
 let bn=bootstrap_mean(&x,6,128,0.95,-2147483646)
 let ba=bootstrap_mean(&x,6,128,0.95,-4294967293)
 assert(bp.status==0 && bn.status==0 && ba.status==0)
 assert(bp.seed_used==2147483646)
 assert(same_boot(&bp,&bn) && same_boot(&bp,&ba))
 let cp=bootstrap_bca_mean(&x,6,128,0.95,2147483646)
 let cn=bootstrap_bca_mean(&x,6,128,0.95,-2147483646)
 let ca=bootstrap_bca_mean(&x,6,128,0.95,-4294967293)
 assert(cp.status==0 && cn.status==0 && ca.status==0)
 assert(cp.seed_used==2147483646)
 assert(same_bca(&cp,&cn) && same_bca(&cp,&ca))
 let pp=permutation_means(&x,6,&y,6,128,2147483646,false)
 let pn=permutation_means(&x,6,&y,6,128,-2147483646,false)
 let pa=permutation_means(&x,6,&y,6,128,-4294967293,false)
 assert(pp.status==0 && pn.status==0 && pa.status==0)
 assert(pp.seed_used==2147483646)
 assert(same_permutation(&pp,&pn) && same_permutation(&pp,&pa))
 println("STATS_RESAMPLING_SEED_GUARD_PASS")
}
