//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_GUM_FO_CORRELATE_LATENT_PASS
//@ sabotage: correlate-rho

// Distinct measures that share a latent — use correlate(a,b,ρ).
// Independent measure(0, σ) ×2 stay 2-channel until correlate; ρ=1 makes
// Var(a+b)=(σ+σ)² and matches shared-peel Var(η+η).
// Science path for two CL factors sharing η without a single peel.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    // Two independent measures of the same physical latent η
    let e1: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let e2: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let a = e1.value
    let b = e2.value

    let v_indep = variance_of(a + b)
    let _r = correlate(a, b, 1.0)
    let v_corr = variance_of(a + b)

    // Shared peel (single measure used twice)
    let e: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let eta = e.value
    let v_shared = variance_of(eta + eta)

    // PK-shaped: CL0·exp(η1) * V0·exp(η2) with ρ=1 on η
    let kCL: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let kV: Knowledge<f64> = measure(50.0, uncertainty: 0.0)
    let cl0 = kCL.value
    let v0 = kV.value
    let e3: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let e4: Knowledge<f64> = measure(0.0, uncertainty: 0.1)
    let n1 = e3.value
    let n2 = e4.value
    let v_prod_ind = variance_of((cl0 * exp(n1)) * (v0 * exp(n2)))
    let _r2 = correlate(n1, n2, 1.0)
    let v_prod_cor = variance_of((cl0 * exp(n1)) * (v0 * exp(n2)))
    // Shared η peel product
    let v_prod_shared = variance_of((cl0 * exp(eta)) * (v0 * exp(eta)))

    print("v_indep="); print_f64(v_indep); print("\n")
    print("v_corr="); print_f64(v_corr); print("\n")
    print("v_shared="); print_f64(v_shared); print("\n")
    print("v_prod_ind="); print_f64(v_prod_ind); print("\n")
    print("v_prod_cor="); print_f64(v_prod_cor); print("\n")
    print("v_prod_shared="); print_f64(v_prod_shared); print("\n")

    // σ=0.1: indep Var(a+b)=0.02; ρ=1 → 0.04 = shared
    // product CL·V·exp(η1+η2): at ρ=1 matches shared η
    let ok = abs_f(v_indep - 0.02) < 1.0e-9
        && abs_f(v_corr - 0.04) < 1.0e-9
        && abs_f(v_shared - 0.04) < 1.0e-9
        && abs_f(v_corr - v_shared) < 1.0e-9
        && abs_f(v_prod_cor - v_prod_shared) < 1.0e-6
        && v_prod_cor > v_prod_ind
        && v_prod_ind > 0.0
    if ok {
        print("MADAROS_GUM_FO_CORRELATE_LATENT_PASS\n")
    } else {
        print("MADAROS_GUM_FO_CORRELATE_LATENT_FAIL\n")
    }
}
