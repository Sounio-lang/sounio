//@ run-pass
//@ description: #2874 residual — a parameter or return typed with a BUILT-IN unit (kg, mg, m, K, s, mol) carries the f64 value, not its bits read as an integer
//@ expect-stdout: 2.500000
//@ expect-stdout: 0.125000
//@ expect-stdout: 1500.000000
//@ expect-stdout: 310.150000
//@ expect-stdout: 60.000000
//@ expect-stdout: 0.070000
//@ expect-stdout: 5.000000
//@ expect-stdout: BUILTIN_UNIT_PARAMS_2874_OK
//
// Before the fix Madaros printed 4612811918334230528.000000 for the first line:
// only units declared with `unit NAME;` reached the lowerer's float-unit
// registry, so a `kg` parameter was an integer slot holding the f64's bits.
// lean_single mis-passed them too (4.612812e18): it turned only `unit`
// declarations into f64 types. lean_single.sio now gives the same built-in
// names the f64 representation (unit_type_name_at_h), so this runs on both
// engines.
// A module that uses a unit's name as a struct generic parameter
// (`struct Map<K, V>`) keeps K a type variable there; that control is
// tests/run-pass/generic_struct_instantiate.sio.

fn as_f64_kg(x: kg) -> f64 { x as f64 }
fn as_f64_mg(x: mg) -> f64 { x as f64 }
fn as_f64_m(x: m) -> f64 { x as f64 }
fn as_f64_temp(t: K) -> f64 { t as f64 }
fn as_f64_s(t: s) -> f64 { t as f64 }
fn as_f64_mol(n: mol) -> f64 { n as f64 }
fn double_kg(x: kg) -> kg { x + x }

fn main() -> i64 with IO {
    let a: kg = 2.5
    let b: mg = 0.125
    let c: m = 1500.0
    let t: K = 310.15
    let d: s = 60.0
    let n: mol = 0.07
    var fails: i64 = 0
    let ra: f64 = as_f64_kg(a)
    println(ra)
    if ra != 2.5 { fails = fails + 1 }
    let rb: f64 = as_f64_mg(b)
    println(rb)
    let rc: f64 = as_f64_m(c)
    println(rc)
    let rt: f64 = as_f64_temp(t)
    println(rt)
    let rd: f64 = as_f64_s(d)
    println(rd)
    let rn: f64 = as_f64_mol(n)
    println(rn)
    if rn > 0.0700001 || rn < 0.0699999 { fails = fails + 1 }
    let dd: kg = double_kg(a)
    let rdd: f64 = dd as f64
    println(rdd)
    if rdd != 5.0 { fails = fails + 1 }
    if rt != 310.15 { fails = fails + 1 }
    if fails == 0 { println("BUILTIN_UNIT_PARAMS_2874_OK") } else { println("BUILTIN_UNIT_PARAMS_2874_FAIL") }
    fails
}
