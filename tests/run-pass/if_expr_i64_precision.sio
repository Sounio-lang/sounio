//@ run-pass
//@ expect-stdout: PASS
//
// Regression (SIO-204, #3212): a recursive factorial written with if/else as
// a value expression returned silently wrong i64 results for f(19) and f(20)
// (25617217285033984 / 45284158381054464 instead of 121645100408832000 /
// 2432902008176640000) on the committed Madaros v0.80.0 prebuilt. The
// if-expression merge value inherited a stale float classification from a
// discarded FO-inline, so integers above 2^53 lost precision. The source fix
// landed in 0a0f2d6354 (PR #3210, discarded FO-inline keeps its virtual
// registers); this test pins the acceptance shape so the value can never
// silently drift again. Early-return and while controls always agreed.

fn f(n: i64) -> i64 { if n <= 1 { 1 } else { n * f(n - 1) } }

fn f_early(n: i64) -> i64 with Mut, Panic {
    if n <= 1 {
        return 1
    }
    return n * f_early(n - 1)
}

fn main() -> i64 with IO, Mut, Panic {
    let ok = f(19) == 121645100408832000
        && f(20) == 2432902008176640000
        && f(20) == f_early(20)
    if ok {
        println("PASS")
    } else {
        println("FAIL")
    }
    0
}
