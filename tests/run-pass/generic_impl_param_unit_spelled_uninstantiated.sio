//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_param_unit_spelled_uninstantiated
// The uninstantiated twin of generic_impl_param_spelled_like_unit.sio. `impl Map<K, V>`
// declares K and V, and K is also kelvin's symbol; a type parameter in scope outranks a
// unit. That held for the struct's own fields and, on the by-value spine, for the impl
// -- but the *mut spine Madaros runs consulted only the struct-level scope, so in an
// impl nothing instantiated the method's `-> K` resolved to kelvin while the struct's
// field `key: K` stayed a parameter, and `self.key` was refused with E008 ("return
// value does not match function's declared return type"). Instantiating the struct
// hid it: the specializer then replaces the template method with a concrete clone and
// the checker never sees a K. The same program over `Pair<T, U>` always compiled.

struct Map<K, V> {
    key: K,
    val: V,
}

impl Map<K, V> {
    fn get_key(self: &Map<K, V>) -> K {
        self.key
    }
    fn get_val(self: &Map<K, V>) -> V {
        self.val
    }
}

fn main() -> i32 with IO {
    println("PASS generic_impl_param_unit_spelled_uninstantiated")
    0
}
