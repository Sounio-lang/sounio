//@ run-pass
//@ requires: madaros
//@ expect-stdout: kl14d_zstd_e2e: PASS
// KL-14d2: round-trip via libzstd.so.1 (DT_NEEDED + GOT).
// Gate: scripts/ci/madaros_kl14d_zstd_gate.sh

use compress::zstd::{zstd_compress, zstd_decompress, zstd_is_ok}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let n: i64 = 16
    let src = heap_alloc(n) as *mut u8
    let dst_cap: i64 = 128
    let dst = heap_alloc(dst_cap) as *mut u8
    let out_cap: i64 = 64
    let out = heap_alloc(out_cap) as *mut u8
    var i: i64 = 0
    while i < n {
        // 'A' + (i % 4)
        *(src + i) = (65 + (i - (i / 4) * 4)) as u8
        i = i + 1
    }
    let cr = zstd_compress(src, n, dst, dst_cap, 3 as i32)
    if !zstd_is_ok(cr) {
        println("kl14d_zstd_e2e: FAIL compress")
        return 1
    }
    if cr.size <= 0 {
        println("kl14d_zstd_e2e: FAIL empty")
        return 1
    }
    let dr = zstd_decompress(dst, cr.size, out, out_cap)
    if !zstd_is_ok(dr) {
        println("kl14d_zstd_e2e: FAIL decompress")
        return 1
    }
    if dr.size != n {
        println("kl14d_zstd_e2e: FAIL size")
        return 1
    }
    i = 0
    while i < n {
        if *(out + i) != *(src + i) {
            println("kl14d_zstd_e2e: FAIL mismatch")
            return 1
        }
        i = i + 1
    }
    println("kl14d_zstd_e2e: PASS")
    0
}
