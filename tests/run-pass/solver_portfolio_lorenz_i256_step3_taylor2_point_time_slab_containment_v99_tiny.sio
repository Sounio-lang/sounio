//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v99 smoke for Lorenz i256 step-3 Taylor-2 point time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1663
    receipt_fp = mix(receipt_fp, 417748218, 5557)
    receipt_fp = mix(receipt_fp, 109213065, 5557)
    receipt_fp = mix(receipt_fp, 9964953, 5557)
    receipt_fp = mix(receipt_fp, 847302474, 5557)
    receipt_fp = mix(receipt_fp, 904983474, 5557)
    receipt_fp = mix(receipt_fp, 142673235, 5557)
    receipt_fp = mix(receipt_fp, 96776847, 5557)
    receipt_fp = mix(receipt_fp, 389654052, 5557)
    receipt_fp = mix(receipt_fp, 790630993, 5557)
    receipt_fp = mix(receipt_fp, 3, 5557)
    receipt_fp = mix(receipt_fp, 19, 5557)
    receipt_fp = mix(receipt_fp, 255, 5557)
    if receipt_fp != 109993635 { return 1 }

    var audit_fp: i64 = 1667
    audit_fp = mix(audit_fp, receipt_fp, 5563)
    audit_fp = mix(audit_fp, 417748218, 5563)
    audit_fp = mix(audit_fp, 109213065, 5563)
    audit_fp = mix(audit_fp, 9964953, 5563)
    audit_fp = mix(audit_fp, 847302474, 5563)
    audit_fp = mix(audit_fp, 389654052, 5563)
    audit_fp = mix(audit_fp, 790630993, 5563)
    audit_fp = mix(audit_fp, 96776847, 5563)
    audit_fp = mix(audit_fp, 3, 5563)
    audit_fp = mix(audit_fp, 19, 5563)
    audit_fp = mix(audit_fp, 255, 5563)
    if audit_fp != 39227174 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 102, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 102, 1103)
    if entry_fp != 999870071 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 99, 1151)
    manifest_fp = mix(manifest_fp, 103, 1151)
    manifest_fp = mix(manifest_fp, 142673235, 1151)
    manifest_fp = mix(manifest_fp, 904983474, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 650273736 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 99, 1871)
    result_fp = mix(result_fp, 103, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 91, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 828675900 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 99, 1907)
    family_fp = mix(family_fp, 103, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 86, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 741613979 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 99, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 65010134 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 99, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 423857093 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 99, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 295692487 { return 9 }
    return 0
}
