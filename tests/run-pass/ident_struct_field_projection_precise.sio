//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_FIELD_PROJECTION_PRECISE_PASS
//
// Prediction (ADR-032 decision 3, field projection):
// A field access yields that field's source set, NOT the union over the
// aggregate. Storing a Knightian value in `h.k` and a precise deterministic
// value in `h.other` keeps `h.other`'s Knightian set empty, so passing
// `h.other` to a precise consumer (`ε < 0.5`) must succeed.

struct Holder {
    k: Knowledge<f64>,
    other: Knowledge[f64, ε < 0.5],
}

fn precise(x: Knowledge[f64, ε < 0.5]) -> f64 with Epistemic {
    x.value
}

fn main() -> i64 with IO, Epistemic {
    let a = knight("k", 0.0, 1.0)
    let p: Knowledge[f64, ε < 0.5] = measure(5.0, uncertainty: 0.1)
    let h = Holder { k: a, other: p }
    let v = precise(h.other)
    var d = v - 5.0
    if d < 0.0 { d = 0.0 - d }
    if d > 1.0e-12 { return 1 }
    println("IDENT_FIELD_PROJECTION_PRECISE_PASS")
    0
}
