//@ run-pass
//@ description: Imported solver proof-profile smoke for SAT/SMT/PB/Lorenz acceptance gates

use theorem::solver_proof_profile::*

fn main() -> i64 {
    if solver_proof_format_family(2) != 1 { return 1 }
    if solver_domain_accepts_proof_format(3, 5) != 1 { return 2 }

    let sat_lrat_gate = solver_proof_profile_unsat_acceptance(1, 2, 1, 1, 1, 1, 1)
    if sat_lrat_gate != 1 { return 3 }

    let solver_only = solver_proof_profile_unsat_acceptance(1, 2, 1, 1, 0, 0, 1)
    if solver_only != 0 { return 4 }

    let lorenz_gate = solver_proof_profile_lorenz_numeric_receipt_gate(1, 1, 1, 1, 1, 0)
    if lorenz_gate != 1 { return 5 }

    let fake_global_lorenz = solver_proof_profile_lorenz_numeric_receipt_gate(1, 1, 1, 1, 1, 1)
    if fake_global_lorenz != 0 { return 6 }

    let artifact = solver_proof_profile_receipt_check(1, 1, 1, 1, 1, 1, 88)
    if artifact != 964210753 { return 7 }

    let audit = solver_proof_profile_audit_fingerprint(
        artifact, 710284936, 295748103, 1, 1, 1, 1, 1, 1, 15, 48, 0, 0, 0, 88, 255)
    if audit != 526184309 { return 8 }

    return 0
}
