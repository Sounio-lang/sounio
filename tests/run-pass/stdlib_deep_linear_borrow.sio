//@ run-pass
//@ expect-stdout: STDLIB_DEEP_LINEAR_BORROW_PASS
pub linear struct DeepOwner { value:i64 }
fn issue()->DeepOwner {DeepOwner{value:7}}
fn inspect(owner:&DeepOwner)->i64 {owner.value}
fn update(owner:&!DeepOwner) with Mut {owner.value=9}
fn consume(owner:DeepOwner)->i64 {let DeepOwner{value}=owner;value}
fn main()->i32 with IO, Mut, Panic {
    var owner=issue()
    assert(inspect(&owner)==7)
    assert(inspect(&owner)==7)
    update(&!owner)
    assert(inspect(&owner)==9)
    assert(consume(owner)==9)
    print("STDLIB_DEEP_LINEAR_BORROW_PASS\n")
    return 0
}
