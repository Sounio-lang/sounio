//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz Taylor-2 response-envelope receipt over the v48 pending request

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn response_envelope_fingerprint(request_fp: i64, request_audit_fp: i64) -> i64 {
    if request_fp != 510353327 { return 0 - 1 }
    if request_audit_fp != 465022480 { return 0 - 1 }

    let v48_step_request_receipt_fp: i64 = 185755530
    let v48_step_request_portfolio_audit_fp: i64 = 167433392
    let v48_readiness_fp: i64 = 38526066
    let trajectory_manifest_fp: i64 = 214180161
    let dependency_dag_fp: i64 = 713010204
    let step_index: i64 = 6
    let taylor_order: i64 = 2
    let selected_dt_num: i64 = 1
    let selected_dt_den: i64 = 100
    let scale_log2: i64 = 32
    let source_width_bits: i64 = 256
    let request_mask: i64 = 127
    let response_status_candidate_required: i64 = 2
    let candidate_kind_ball_enclosure: i64 = 1
    let required_artifact_count: i64 = 4
    let required_center_artifact: i64 = 1
    let required_radius_artifact: i64 = 1
    let required_remainder_artifact: i64 = 1
    let required_proof_trace_artifact: i64 = 1

    var response_mask: i64 = 0
    if request_fp == 510353327 {
        if request_audit_fp == 465022480 {
            response_mask = response_mask + 1
        }
    }
    if v48_step_request_receipt_fp == 185755530 {
        if v48_readiness_fp == 38526066 {
            response_mask = response_mask + 2
        }
    }
    if step_index == 6 {
        if taylor_order == 2 {
            response_mask = response_mask + 4
        }
    }
    if selected_dt_num == 1 {
        if selected_dt_den == 100 {
            response_mask = response_mask + 8
        }
    }
    if source_width_bits == 256 {
        if scale_log2 == 32 {
            response_mask = response_mask + 16
        }
    }
    if candidate_kind_ball_enclosure == 1 {
        if required_artifact_count == 4 {
            response_mask = response_mask + 32
        }
    }
    if response_status_candidate_required == 2 {
        if request_mask == 127 {
            response_mask = response_mask + 64
        }
    }
    if response_mask != 127 { return 0 - 1 }

    var fp: i64 = 607
    fp = quality_mix(fp, request_fp)
    fp = quality_mix(fp, request_audit_fp)
    fp = quality_mix(fp, v48_step_request_receipt_fp)
    fp = quality_mix(fp, v48_step_request_portfolio_audit_fp)
    fp = quality_mix(fp, v48_readiness_fp)
    fp = quality_mix(fp, trajectory_manifest_fp)
    fp = quality_mix(fp, dependency_dag_fp)
    fp = quality_mix(fp, step_index)
    fp = quality_mix(fp, taylor_order)
    fp = quality_mix(fp, selected_dt_num)
    fp = quality_mix(fp, selected_dt_den)
    fp = quality_mix(fp, scale_log2)
    fp = quality_mix(fp, source_width_bits)
    fp = quality_mix(fp, request_mask)
    fp = quality_mix(fp, response_status_candidate_required)
    fp = quality_mix(fp, candidate_kind_ball_enclosure)
    fp = quality_mix(fp, required_artifact_count)
    fp = quality_mix(fp, required_center_artifact)
    fp = quality_mix(fp, required_radius_artifact)
    fp = quality_mix(fp, required_remainder_artifact)
    fp = quality_mix(fp, required_proof_trace_artifact)
    fp = quality_mix(fp, response_mask)
    return fp
}

fn response_envelope_audit_fingerprint(response_fp: i64) -> i64 {
    if response_fp != 506104143 { return 0 - 1 }

    var fp: i64 = 613
    fp = quality_mix(fp, response_fp)
    fp = quality_mix(fp, 510353327)
    fp = quality_mix(fp, 465022480)
    fp = quality_mix(fp, 185755530)
    fp = quality_mix(fp, 167433392)
    fp = quality_mix(fp, 38526066)
    fp = quality_mix(fp, 6)
    fp = quality_mix(fp, 127)
    fp = quality_mix(fp, 2)
    return fp
}

fn main() -> i64 {
    let fp = response_envelope_fingerprint(510353327, 465022480)
    if fp != 506104143 { return 1 }

    let audit_fp = response_envelope_audit_fingerprint(fp)
    if audit_fp != 956295573 { return 2 }

    if response_envelope_fingerprint(510353328, 465022480) != (0 - 1) { return 3 }
    if response_envelope_audit_fingerprint(506104144) != (0 - 1) { return 4 }
    return 0
}
