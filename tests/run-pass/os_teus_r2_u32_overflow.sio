//@ run-pass
// R2 narrow-integer witness: u32 3000000000 + 2000000000 must wrap to
// 705032704 (5000000000 mod 2^32 = 705032704).

fn main() with IO, Div, Panic {
    let x: u32 = 3000000000 + 2000000000
    if x == 705032704 {
        print("r2_u32_overflow: PASS\n")
    } else {
        print("r2_u32_overflow: FAIL got=")
        print_int(x)
        print("\n")
    }
}
