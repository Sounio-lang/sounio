//@ run-pass
//@ requires: madaros
//@ expect-stdout: 42
// The specializer's generic-call inference scope (spec_scope_bind/lookup) stored
// only ast_name_hash(name), not the name itself. `az` and `bY` are both two-letter
// names with the same DJB2 hash (110*33+70 == ... wait, this pair's own arithmetic:
// az = 97*33+122 after the seed step, bY = 98*33+89 -- both settle at 5863232), so
// binding `bY` after `az` made a hash-only lookup of `az` return `bY`'s type instead.
// `identify(az)` -- a turbofish-less generic call -- infers its type argument from
// `az`'s scope-bound type; with the collision, it inferred StructB instead of
// StructA, and `result.a_field` read a field that does not exist on the type the
// specializer actually instantiated.

struct StructA { a_field: i64 }
struct StructB { b_field: i64 }

fn identify<T>(x: T) -> T { x }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let az = StructA { a_field: 42 }
    let bY = StructB { b_field: 99 }
    let result = identify(az)
    print_int(result.a_field)
    print("\n")
    0
}
