//@ run-pass
//@ expect-stdout: study block parsed

study TestStudy {
    title: "Basic Test"
    design: parallel_rct
    participants {
        sample_size: 60
        power: 0.80
    }
    outcomes {
        primary: endpoint_a
    }
    analysis {
        hypothesis H1 {
            outcome: endpoint_a
            direction: greater
            effect_size: 0.5
        }
        alpha: 0.05
        correction: bonferroni
    }
}

fn main() -> i32 with IO {
    println("study block parsed")
    0
}
