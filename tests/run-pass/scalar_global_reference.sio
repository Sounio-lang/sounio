//@ run-pass
//@ requires: madaros
//@ expect-stdout: scalar_global_reference PASS
//@ description: Shared and exclusive references to declared integer and float globals address their BSS cells; writes through &! survive the call. Local and direct-global stores are controls.
var GLOBAL_VALUE: i64 = 3
var GLOBAL_DIRECT: i64 = 0
var GLOBAL_F64: f64 = 1.5
var GLOBAL_F32: f32 = 3.5
fn read_scalar(p: &i64) -> i64 {
    *p
}
fn write_scalar(p: &! i64) -> i64 with Mut {
    *p = 7
    *p
}
fn read_f64(p: &f64) -> f64 { *p }
fn write_f64(p: &! f64) with Mut { *p = 7.5 }
fn read_f32(p: &f32) -> f32 { *p }
fn write_f32(p: &! f32) with Mut { *p = 9.5 }
fn shadow_control() -> i64 with Mut {
    var GLOBAL_VALUE: i64 = 11
    let written = write_scalar(&! GLOBAL_VALUE)
    if written != 7 || GLOBAL_VALUE != 7 { return 0 - 1 }
    read_scalar(&GLOBAL_VALUE)
}
fn main() -> i32 with IO, Mut {
    var local: i64 = 3
    GLOBAL_DIRECT = 7
    if shadow_control() != 7 { return 10 }
    if read_scalar(&local) != 3 { return 11 }
    if read_scalar(&GLOBAL_VALUE) != 3 { return 12 }
    let local_return = write_scalar(&! local)
    let global_return = write_scalar(&! GLOBAL_VALUE)
    if local_return != 7 { return 13 }
    if global_return != 7 { return 14 }
    if local != 7 { return 15 }
    if GLOBAL_DIRECT != 7 { return 16 }
    if GLOBAL_VALUE != 7 { return 17 }
    if read_scalar(&local) != 7 { return 18 }
    if read_scalar(&GLOBAL_VALUE) != 7 { return 19 }
    // Both float spellings share the known float-global classification.
    // These halves are exact binary values; the oracle needs no tolerance.
    if read_f64(&GLOBAL_F64) != 1.5 { return 20 }
    if read_f32(&GLOBAL_F32) != 3.5 { return 21 }
    write_f64(&! GLOBAL_F64)
    write_f32(&! GLOBAL_F32)
    if GLOBAL_F64 != 7.5 || read_f64(&GLOBAL_F64) != 7.5 { return 22 }
    if GLOBAL_F32 != 9.5 || read_f32(&GLOBAL_F32) != 9.5 { return 23 }
    println("scalar_global_reference PASS")
    0
}
