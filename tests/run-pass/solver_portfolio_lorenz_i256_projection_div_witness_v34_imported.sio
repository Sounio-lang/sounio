    let manifest_fp = solver_portfolio_v34_lorenz_i256_projection_div_witness_bundle_fingerprint(
        693793961, audit_fp)
    if manifest_fp != 490367409 { return 2 }

    let result_fp = solver_portfolio_v34_result_coverage_fingerprint(
