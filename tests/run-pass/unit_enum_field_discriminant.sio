//@ run-pass
//@ expect-stdout: unit_enum_field_discriminant: PASS
//@ description: a unit-enum field stores a raw discriminant, not a handle
//
// StmtExpr and ItemEnum are both discriminant 2. A field load of that word
// must compare as an integer. Resolving 2 as a handle selects an unrelated
// slot and the next field load SIGSEGVs at address 0x20.
//
// Tag C is 2, the value that faulted. A and B cover 0 and 1, which are also
// inside the handle-id range.

enum Tag { A, B, C }

struct Node {
    kind: Tag,
}

fn tag_of(n: Node) -> i64 {
    let k = n.kind
    if k == Tag::A { return 0 }
    if k == Tag::B { return 1 }
    if k == Tag::C { return 2 }
    9
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let a = Node { kind: Tag::A }
    let b = Node { kind: Tag::B }
    let c = Node { kind: Tag::C }

    var bad: i64 = 0
    if tag_of(a) != 0 { bad = bad + 1 }
    if tag_of(b) != 1 { bad = bad + 1 }
    if tag_of(c) != 2 { bad = bad + 1 }

    // The field itself is the discriminant. Tag::C is 2, not a handle.
    let raw: i64 = c.kind
    if raw != 2 { bad = bad + 1 }

    if bad != 0 {
        print("unit_enum_field_discriminant: FAIL ")
        print_int(bad)
        print("\n")
        return 1
    }
    print("unit_enum_field_discriminant: PASS\n")
    0
}
