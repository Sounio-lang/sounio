//@ run-pass
//@ description: Lorenz i128 first-step enclosure contract with interval LTE budget

fn main() -> i64 {
    // This gate deliberately combines the already split first-step witnesses:
    // - i128 Euler center from lorenz_i128_ball_step.sio;
    // - interval LTE radii from lorenz_i128_euler_lte_interval_{xy,z}.sio.
    // Keeping this contract scalar avoids the current monolithic i128 lowering
    // failure while still pinning the final enclosure values.
    let center_x: i64 = 1000000
    let center_y: i64 = 1260000
    let center_z: i64 = 983334

    let euler_xr: i64 = 13
    let euler_yr: i64 = 13
    let euler_zr: i64 = 11

    let lte_x: i64 = 25439
    let lte_y: i64 = 32140
    let lte_z: i64 = 3362

    let final_xr: i64 = euler_xr + lte_x
    let final_yr: i64 = euler_yr + lte_y
    let final_zr: i64 = euler_zr + lte_z

    let x_lo: i64 = center_x - final_xr
    let x_hi: i64 = center_x + final_xr
    let y_lo: i64 = center_y - final_yr
    let y_hi: i64 = center_y + final_yr
    let z_lo: i64 = center_z - final_zr
    let z_hi: i64 = center_z + final_zr

    let euler_x_lo: i64 = center_x - euler_xr
    let euler_x_hi: i64 = center_x + euler_xr
    let euler_y_lo: i64 = center_y - euler_yr
    let euler_y_hi: i64 = center_y + euler_yr
    let euler_z_lo: i64 = center_z - euler_zr
    let euler_z_hi: i64 = center_z + euler_zr

    if final_xr != 25452 { return 1 }
    if final_yr != 32153 { return 2 }
    if final_zr != 3373 { return 3 }
    if x_lo != 974548 { return 4 }
    if x_hi != 1025452 { return 5 }
    if y_lo != 1227847 { return 6 }
    if y_hi != 1292153 { return 7 }
    if z_lo != 979961 { return 8 }
    if z_hi != 986707 { return 9 }

    // The final enclosure contains the next-state Euler ball and adds the LTE
    // margin around it; the interval tube used to bound LTE is checked in the
    // split interval gates.
    if x_lo > euler_x_lo { return 10 }
    if x_hi < euler_x_hi { return 11 }
    if y_lo > euler_y_lo { return 12 }
    if y_hi < euler_y_hi { return 13 }
    if z_lo > euler_z_lo { return 14 }
    if z_hi < euler_z_hi { return 15 }

    return 0
}
