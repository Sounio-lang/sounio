//@ run-pass
//@ requires: madaros
//@ expect-stdout: SIGN_BOTH_OK
// sign(a, b) is the knowledge contest: one Knowledge, variance = the shared
// interval. sign(x) is math/pure's unary f64, including tan's sign(sin(x)).
// The builtin must claim only the two-argument call.

use math::pure::{tan}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    let t = tan(0.0)
    let wide: Knowledge<f64> = measure(10.0, uncertainty: 2.0)
    let tight: Knowledge<f64> = measure(10.5, uncertainty: 0.5)
    let left = sign(wide, tight)
    let v = variance_of(left.value)
    print("t ")
    print_f64(t)
    print(" v ")
    print_f64(v)
    print("\n")
    let at = if t < 0.0 { 0.0 - t } else { t }
    if at < 0.000001 && near(v, 0.25, 0.0001) {
        println("SIGN_BOTH_OK")
        return 0
    }
    println("SIGN_BOTH_FAIL")
    1
}
