//@ run-pass
//@ requires: madaros
//@ expect-stdout: 9
// `var b: Box<A> = mk()` types `(*b).count` from the annotation. `count`
// sits at a different index in A, B and C, so the untyped vote has no
// majority and Stage 0 refused the access (reason 10, ADR-026 amendment).
struct A { pad: i64, count: i64 }
struct B { count: i64, pad: i64, z: i64 }
struct C { q: i64, r: i64, count: i64 }
fn mk() -> Box<A> with Alloc { Box::new(A { pad: 1, count: 2 }) }
fn main() -> i64 with IO, Mut, Alloc, Panic, Div {
    var b: Box<A> = mk()
    (*b).count = 9
    let bb = B { count: 3, pad: 4, z: 5 }
    let cc = C { q: 6, r: 7, count: 8 }
    println((*b).count + bb.count * 0 + cc.count * 0)
    0
}
