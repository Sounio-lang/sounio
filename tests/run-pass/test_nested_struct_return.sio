//@ run-pass
//@ expect-stdout: sret nested ok
struct Point { x: i64, y: i64 }

fn make_point(x: i64, y: i64) -> Point {
    Point { x: x, y: y }
}

fn pick_left(a: Point, b: Point) -> Point {
    a
}

fn shift_point(p: Point, dx: i64, dy: i64) -> Point {
    Point { x: p.x + dx, y: p.y + dy }
}

fn sum_points(a: Point, b: Point) -> i64 {
    a.x + a.y + b.x + b.y
}

fn main() -> i32 with IO, Panic {
    let a = make_point(10, 20)
    let b = make_point(30, 40)
    assert(a.x == 10)
    assert(a.y == 20)
    assert(b.x == 30)
    assert(b.y == 40)

    let nested = pick_left(make_point(1, 2), make_point(3, 4))
    assert(nested.x == 1)
    assert(nested.y == 2)

    let shifted = shift_point(pick_left(make_point(5, 6), make_point(7, 8)), 9, 10)
    assert(shifted.x == 14)
    assert(shifted.y == 16)

    let total = sum_points(make_point(11, 12), pick_left(make_point(13, 14), make_point(15, 16)))
    assert(total == 50)

    print("sret nested ok\n")
    0
}
