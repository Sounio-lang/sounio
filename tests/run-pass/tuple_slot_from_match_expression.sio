struct Thing {
    n: i64,
}

impl Thing {
    fn bump(self) -> (Thing, i64) with Mut, Panic, Div {
        var t = self
        t.n = t.n + 1
        (t, t.n)
    }

    fn clear(self) -> Thing with Mut, Panic, Div {
        var t = self
        t.n = 0
        t
    }

    fn get(self) -> i64 with Mut, Panic, Div {
        self.n
    }

    // The pair is bound from a MATCH expression whose arms disagree in shape:
    // one arm is a method call returning `(Thing, i64)`, the other is a tuple
    // LITERAL whose slot 0 is a method call. Requiring the same callee in every
    // arm would answer nothing here; what has to agree is the slot's type.
    fn drive(self, k: i64) -> i64 with Mut, Panic, Div {
        let pair = match k {
            0 => self.bump(),
            _ => (self.clear(), 0 - 1),
        }
        var t2 = pair.0
        t2.get()
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let t = Thing { n: 4 }
    print("got=")
    print_int(t.drive(0))
    print("\n")
    println("PASS")
    0
}
