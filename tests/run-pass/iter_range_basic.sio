//@ run-pass
// iter_range_basic.sio — Tests for Range iterator and RangeArr64 transforms
// All definitions inlined (tests cannot import stdlib).
//
// T1: range 0..5 collects [0,1,2,3,4], sum=10
// T2: range_len(0..5) == 5
// T3: range_step(0,10,2) collects [0,2,4,6,8], len=5
// T4: arr64_sum of [1,2,3,4,5] = 15
// T5: arr64_filter_gt([1,2,3,4,5], 3) = [4,5], len=2
// T6: arr64_max([3,1,4,1,5,9]) = 9

// ============================================================================
// Inlined definitions
// ============================================================================

struct Range { start: i64, end: i64, step: i64, current: i64 }
struct RangeArr64 { data: [i64; 64], len: i64 }

fn range_new(start: i64, end_val: i64) -> Range with Mut {
    Range { start: start, end: end_val, step: 1, current: start }
}

fn range_step(start: i64, end_val: i64, step: i64) -> Range with Mut {
    Range { start: start, end: end_val, step: step, current: start }
}

fn range_has_next(r: &Range) -> bool {
    r.current < r.end
}

fn range_next(r: &! Range) -> i64 with Mut {
    let v = r.current
    r.current = r.current + r.step
    v
}

fn range_reset(r: &! Range) with Mut {
    r.current = r.start
}

fn range_len(r: &Range) -> i64 with Div {
    let span = r.end - r.start
    if span <= 0 { return 0 }
    (span + r.step - 1) / r.step
}

fn range_collect(r: &! Range) -> RangeArr64 with Mut {
    var data: [i64; 64] = [0; 64]
    var len: i64 = 0
    range_reset(r)
    while range_has_next(r) && len < 64 {
        data[len as usize] = range_next(r)
        len = len + 1
    }
    RangeArr64 { data: data, len: len }
}

fn arr64_sum(arr: &RangeArr64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < arr.len { s = s + arr.data[i as usize]; i = i + 1 }
    s
}

fn arr64_max(arr: &RangeArr64) -> i64 {
    if arr.len == 0 { return 0 }
    var m: i64 = arr.data[0]
    var i: i64 = 1
    while i < arr.len {
        if arr.data[i as usize] > m { m = arr.data[i as usize] }
        i = i + 1
    }
    m
}

fn arr64_filter_gt(arr: &RangeArr64, threshold: i64) -> RangeArr64 {
    var data: [i64; 64] = [0; 64]
    var len: i64 = 0
    var i: i64 = 0
    while i < arr.len && len < 64 {
        if arr.data[i as usize] > threshold {
            data[len as usize] = arr.data[i as usize]
            len = len + 1
        }
        i = i + 1
    }
    RangeArr64 { data: data, len: len }
}

// ============================================================================
// Tests
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    var passed: i32 = 0
    var failed: i32 = 0

    // T1: range 0..5 collects [0,1,2,3,4], sum = 10
    var r1 = range_new(0, 5)
    let arr1 = range_collect(&! r1)
    let s1 = arr64_sum(&arr1)
    let t1_ok = arr1.len == 5 && arr1.data[0] == 0 && arr1.data[4] == 4 && s1 == 10
    if t1_ok { passed = passed + 1 } else { failed = failed + 1; println("FAIL T1") }

    // T2: range_len(0..5) == 5
    let r2 = range_new(0, 5)
    let l2 = range_len(&r2)
    if l2 == 5 { passed = passed + 1 } else { failed = failed + 1; println("FAIL T2") }

    // T3: range_step(0,10,2) collects [0,2,4,6,8], len=5
    var r3 = range_step(0, 10, 2)
    let arr3 = range_collect(&! r3)
    let t3_ok = arr3.len == 5 && arr3.data[0] == 0 && arr3.data[1] == 2 && arr3.data[4] == 8
    if t3_ok { passed = passed + 1 } else { failed = failed + 1; println("FAIL T3") }

    // T4: arr64_sum of [1,2,3,4,5] = 15
    var data4: [i64; 64] = [0; 64]
    data4[0] = 1; data4[1] = 2; data4[2] = 3; data4[3] = 4; data4[4] = 5
    let arr4 = RangeArr64 { data: data4, len: 5 }
    let s4 = arr64_sum(&arr4)
    if s4 == 15 { passed = passed + 1 } else { failed = failed + 1; println("FAIL T4") }

    // T5: arr64_filter_gt([1,2,3,4,5], 3) = [4,5], len=2
    let filtered5 = arr64_filter_gt(&arr4, 3)
    let t5_ok = filtered5.len == 2 && filtered5.data[0] == 4 && filtered5.data[1] == 5
    if t5_ok { passed = passed + 1 } else { failed = failed + 1; println("FAIL T5") }

    // T6: arr64_max([3,1,4,1,5,9]) = 9
    var data6: [i64; 64] = [0; 64]
    data6[0] = 3; data6[1] = 1; data6[2] = 4; data6[3] = 1; data6[4] = 5; data6[5] = 9
    let arr6 = RangeArr64 { data: data6, len: 6 }
    let m6 = arr64_max(&arr6)
    if m6 == 9 { passed = passed + 1 } else { failed = failed + 1; println("FAIL T6") }

    if failed == 0 {
        println("ALL 6 TESTS PASSED")
        return 0
    }
    return 1
}
