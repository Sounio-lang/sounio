//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 local containment obligation preserves non-claim masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let x_radius: i64 = 54480
    let y_radius: i64 = 267477
    let z_radius: i64 = 17173
    let x_lte: i64 = 29251
    let y_lte: i64 = 39980
    let z_lte: i64 = 4699
    let x_need: i64 = x_radius + x_lte
    let y_need: i64 = y_radius + y_lte
    let z_need: i64 = z_radius + z_lte
    let x_margin: i64 = 84000
    let y_margin: i64 = 308000
    let z_margin: i64 = 22000
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need
    if x_need != 83731 { return 1 }
    if y_need != 307457 { return 2 }
    if z_need != 21872 { return 3 }
    if x_slack != 269 { return 4 }
    if y_slack != 543 { return 5 }
    if z_slack != 128 { return 6 }

    var axis_containment_mask: i64 = 0
    if x_need <= x_margin { axis_containment_mask = axis_containment_mask + 1 }
    if y_need <= y_margin { axis_containment_mask = axis_containment_mask + 2 }
    if z_need <= z_margin { axis_containment_mask = axis_containment_mask + 4 }
    if axis_containment_mask != 7 { return 7 }

    let local_flowpipe_obligation_mask: i64 = 7
    let global_flowpipe_claim_mask: i64 = 0
    let obligation_status_local: i64 = 12
    let ok_mask: i64 = 255

    var instance_fp: i64 = 1433
    instance_fp = mix(instance_fp, 2, 5231)
    instance_fp = mix(instance_fp, 702220657, 5231)
    instance_fp = mix(instance_fp, 270117363, 5231)
    instance_fp = mix(instance_fp, 424013491, 5231)
    instance_fp = mix(instance_fp, 409402480, 5231)
    instance_fp = mix(instance_fp, 725374434, 5231)
    instance_fp = mix(instance_fp, 443171640, 5231)
    instance_fp = mix(instance_fp, 444092349, 5231)
    instance_fp = mix(instance_fp, 2, 5231)
    instance_fp = mix(instance_fp, 1000000, 5231)
    instance_fp = mix(instance_fp, 1, 5231)
    instance_fp = mix(instance_fp, 100, 5231)
    instance_fp = mix(instance_fp, x_radius, 5231)
    instance_fp = mix(instance_fp, y_radius, 5231)
    instance_fp = mix(instance_fp, z_radius, 5231)
    instance_fp = mix(instance_fp, x_lte, 5231)
    instance_fp = mix(instance_fp, y_lte, 5231)
    instance_fp = mix(instance_fp, z_lte, 5231)
    instance_fp = mix(instance_fp, x_need, 5231)
    instance_fp = mix(instance_fp, y_need, 5231)
    instance_fp = mix(instance_fp, z_need, 5231)
    instance_fp = mix(instance_fp, x_margin, 5231)
    instance_fp = mix(instance_fp, y_margin, 5231)
    instance_fp = mix(instance_fp, z_margin, 5231)
    instance_fp = mix(instance_fp, x_slack, 5231)
    instance_fp = mix(instance_fp, y_slack, 5231)
    instance_fp = mix(instance_fp, z_slack, 5231)
    instance_fp = mix(instance_fp, axis_containment_mask, 5231)
    instance_fp = mix(instance_fp, local_flowpipe_obligation_mask, 5231)
    instance_fp = mix(instance_fp, global_flowpipe_claim_mask, 5231)
    instance_fp = mix(instance_fp, obligation_status_local, 5231)
    if instance_fp != 861466922 { return 8 }

    var certificate_fp: i64 = 1439
    certificate_fp = mix(certificate_fp, instance_fp, 5233)
    certificate_fp = mix(certificate_fp, x_radius, 5233)
    certificate_fp = mix(certificate_fp, y_radius, 5233)
    certificate_fp = mix(certificate_fp, z_radius, 5233)
    certificate_fp = mix(certificate_fp, x_lte, 5233)
    certificate_fp = mix(certificate_fp, y_lte, 5233)
    certificate_fp = mix(certificate_fp, z_lte, 5233)
    certificate_fp = mix(certificate_fp, x_need, 5233)
    certificate_fp = mix(certificate_fp, y_need, 5233)
    certificate_fp = mix(certificate_fp, z_need, 5233)
    certificate_fp = mix(certificate_fp, x_margin, 5233)
    certificate_fp = mix(certificate_fp, y_margin, 5233)
    certificate_fp = mix(certificate_fp, z_margin, 5233)
    certificate_fp = mix(certificate_fp, x_slack, 5233)
    certificate_fp = mix(certificate_fp, y_slack, 5233)
    certificate_fp = mix(certificate_fp, z_slack, 5233)
    certificate_fp = mix(certificate_fp, axis_containment_mask, 5233)
    certificate_fp = mix(certificate_fp, local_flowpipe_obligation_mask, 5233)
    certificate_fp = mix(certificate_fp, global_flowpipe_claim_mask, 5233)
    certificate_fp = mix(certificate_fp, obligation_status_local, 5233)
    certificate_fp = mix(certificate_fp, ok_mask, 5233)
    if certificate_fp != 375889750 { return 9 }

    var artifact_fp: i64 = 1447
    artifact_fp = mix(artifact_fp, instance_fp, 5237)
    artifact_fp = mix(artifact_fp, certificate_fp, 5237)
    artifact_fp = mix(artifact_fp, 13, 5237)
    artifact_fp = mix(artifact_fp, 2, 5237)
    artifact_fp = mix(artifact_fp, axis_containment_mask, 5237)
    artifact_fp = mix(artifact_fp, local_flowpipe_obligation_mask, 5237)
    artifact_fp = mix(artifact_fp, global_flowpipe_claim_mask, 5237)
    artifact_fp = mix(artifact_fp, obligation_status_local, 5237)
    artifact_fp = mix(artifact_fp, ok_mask, 5237)
    if artifact_fp != 311696236 { return 10 }
    return 0
}
