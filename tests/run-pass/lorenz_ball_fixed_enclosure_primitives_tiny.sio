//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz ball-fixed enclosure containment smoke

fn bf_abs64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn bf_bound_lo(center: i64, radius: i64) -> i64 {
    return center - radius
}

fn bf_bound_hi(center: i64, radius: i64) -> i64 {
    return center + radius
}

fn bf_add_lte_radius(euler_radius: i64, lte_radius: i64) -> i64 {
    if euler_radius < 0 { return 0 - 1 }
    if lte_radius < 0 { return 0 - 1 }
    return euler_radius + lte_radius
}

fn bf_bounds_match(center: i64, radius: i64, lo: i64, hi: i64) -> i64 {
    if radius < 0 { return 0 }
    if lo != bf_bound_lo(center, radius) { return 0 }
    if hi != bf_bound_hi(center, radius) { return 0 }
    return 1
}

fn bf_contains_value(center: i64, radius: i64, value: i64) -> i64 {
    if radius < 0 { return 0 }
    if value < bf_bound_lo(center, radius) { return 0 }
    if value > bf_bound_hi(center, radius) { return 0 }
    return 1
}

fn bf_contains_ball(outer_center: i64, outer_radius: i64, inner_center: i64, inner_radius: i64) -> i64 {
    if outer_radius < 0 { return 0 }
    if inner_radius < 0 { return 0 }
    let center_delta: i64 = bf_abs64(inner_center - outer_center)
    if center_delta + inner_radius > outer_radius { return 0 }
    return 1
}

fn bf_enclosure_from_euler_lte(center: i64, euler_radius: i64, lte_radius: i64, lo: i64, hi: i64) -> i64 {
    let final_radius: i64 = bf_add_lte_radius(euler_radius, lte_radius)
    if final_radius < 0 { return 0 }
    return bf_bounds_match(center, final_radius, lo, hi)
}

fn bf_validated_step3(center_x: i64, center_y: i64, center_z: i64,
                      euler_xr: i64, euler_yr: i64, euler_zr: i64,
                      lte_xr: i64, lte_yr: i64, lte_zr: i64,
                      x_lo: i64, x_hi: i64,
                      y_lo: i64, y_hi: i64,
                      z_lo: i64, z_hi: i64) -> i64 {
    let final_xr: i64 = bf_add_lte_radius(euler_xr, lte_xr)
    let final_yr: i64 = bf_add_lte_radius(euler_yr, lte_yr)
    let final_zr: i64 = bf_add_lte_radius(euler_zr, lte_zr)
    if final_xr < 0 { return 0 }
    if final_yr < 0 { return 0 }
    if final_zr < 0 { return 0 }

    if bf_bounds_match(center_x, final_xr, x_lo, x_hi) == 0 { return 0 }
    if bf_bounds_match(center_y, final_yr, y_lo, y_hi) == 0 { return 0 }
    if bf_bounds_match(center_z, final_zr, z_lo, z_hi) == 0 { return 0 }

    if bf_contains_ball(center_x, final_xr, center_x, euler_xr) == 0 { return 0 }
    if bf_contains_ball(center_y, final_yr, center_y, euler_yr) == 0 { return 0 }
    if bf_contains_ball(center_z, final_zr, center_z, euler_zr) == 0 { return 0 }
    return 1
}

fn bf_step3_fingerprint_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 193) % 1000000007
}

fn bf_validated_step3_fingerprint(center_x: i64, center_y: i64, center_z: i64,
                                  euler_xr: i64, euler_yr: i64, euler_zr: i64,
                                  lte_xr: i64, lte_yr: i64, lte_zr: i64,
                                  x_lo: i64, x_hi: i64,
                                  y_lo: i64, y_hi: i64,
                                  z_lo: i64, z_hi: i64) -> i64 {
    if bf_validated_step3(center_x, center_y, center_z,
                          euler_xr, euler_yr, euler_zr,
                          lte_xr, lte_yr, lte_zr,
                          x_lo, x_hi, y_lo, y_hi, z_lo, z_hi) == 0 { return 0 - 1 }

    let final_xr: i64 = bf_add_lte_radius(euler_xr, lte_xr)
    let final_yr: i64 = bf_add_lte_radius(euler_yr, lte_yr)
    let final_zr: i64 = bf_add_lte_radius(euler_zr, lte_zr)
    var acc: i64 = 23
    acc = bf_step3_fingerprint_mix(acc, center_x)
    acc = bf_step3_fingerprint_mix(acc, center_y)
    acc = bf_step3_fingerprint_mix(acc, center_z)
    acc = bf_step3_fingerprint_mix(acc, euler_xr)
    acc = bf_step3_fingerprint_mix(acc, euler_yr)
    acc = bf_step3_fingerprint_mix(acc, euler_zr)
    acc = bf_step3_fingerprint_mix(acc, lte_xr)
    acc = bf_step3_fingerprint_mix(acc, lte_yr)
    acc = bf_step3_fingerprint_mix(acc, lte_zr)
    acc = bf_step3_fingerprint_mix(acc, x_lo)
    acc = bf_step3_fingerprint_mix(acc, x_hi)
    acc = bf_step3_fingerprint_mix(acc, y_lo)
    acc = bf_step3_fingerprint_mix(acc, y_hi)
    acc = bf_step3_fingerprint_mix(acc, z_lo)
    acc = bf_step3_fingerprint_mix(acc, z_hi)
    acc = bf_step3_fingerprint_mix(acc, final_xr)
    acc = bf_step3_fingerprint_mix(acc, final_yr)
    acc = bf_step3_fingerprint_mix(acc, final_zr)
    return acc
}

fn bf_step3_chain_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 241) % 1000000007
}

fn bf_validated_step3_chain_fingerprint(previous_anchor: i64, step_index: i64,
                                        scale: i64, dt: i64, step_fingerprint: i64) -> i64 {
    if previous_anchor < 0 { return 0 - 1 }
    if step_index <= 0 { return 0 - 1 }
    if scale <= 0 { return 0 - 1 }
    if dt < 0 { return 0 - 1 }
    if step_fingerprint < 0 { return 0 - 1 }

    var acc: i64 = 41
    acc = bf_step3_chain_mix(acc, previous_anchor)
    acc = bf_step3_chain_mix(acc, step_index)
    acc = bf_step3_chain_mix(acc, scale)
    acc = bf_step3_chain_mix(acc, dt)
    acc = bf_step3_chain_mix(acc, step_fingerprint)
    return acc
}

fn main() -> i64 {
    let scale: i64 = 1000000
    let dt: i64 = 10000

    let center_x: i64 = 1000000
    let center_y: i64 = 1260000
    let center_z: i64 = 983334

    let euler_xr: i64 = 13
    let euler_yr: i64 = 13
    let euler_zr: i64 = 11

    let lte_x: i64 = 25439
    let lte_y: i64 = 32140
    let lte_z: i64 = 3362

    let final_xr: i64 = bf_add_lte_radius(euler_xr, lte_x)
    let final_yr: i64 = bf_add_lte_radius(euler_yr, lte_y)
    let final_zr: i64 = bf_add_lte_radius(euler_zr, lte_z)

    if final_xr != 25452 { return 1 }
    if final_yr != 32153 { return 2 }
    if final_zr != 3373 { return 3 }

    if bf_bounds_match(center_x, final_xr, 974548, 1025452) != 1 { return 4 }
    if bf_bounds_match(center_y, final_yr, 1227847, 1292153) != 1 { return 5 }
    if bf_bounds_match(center_z, final_zr, 979961, 986707) != 1 { return 6 }

    if bf_contains_ball(center_x, final_xr, center_x, euler_xr) != 1 { return 7 }
    if bf_contains_ball(center_y, final_yr, center_y, euler_yr) != 1 { return 8 }
    if bf_contains_ball(center_z, final_zr, center_z, euler_zr) != 1 { return 9 }

    if bf_contains_value(center_x, final_xr, 974548) != 1 { return 10 }
    if bf_contains_value(center_x, final_xr, 1025452) != 1 { return 11 }
    if bf_contains_value(center_x, final_xr, 974547) != 0 { return 12 }
    if bf_contains_value(center_x, final_xr, 1025453) != 0 { return 13 }

    if bf_enclosure_from_euler_lte(center_x, euler_xr, lte_x, 974548, 1025452) != 1 { return 14 }
    if bf_enclosure_from_euler_lte(center_y, euler_yr, lte_y, 1227847, 1292153) != 1 { return 15 }
    if bf_enclosure_from_euler_lte(center_z, euler_zr, lte_z, 979961, 986707) != 1 { return 16 }
    if bf_validated_step3(center_x, center_y, center_z,
                          euler_xr, euler_yr, euler_zr,
                          lte_x, lte_y, lte_z,
                          974548, 1025452,
                          1227847, 1292153,
                          979961, 986707) != 1 { return 17 }
    if bf_validated_step3_fingerprint(center_x, center_y, center_z,
                                      euler_xr, euler_yr, euler_zr,
                                      lte_x, lte_y, lte_z,
                                      974548, 1025452,
                                      1227847, 1292153,
                                      979961, 986707) != 242670977 { return 18 }
    if bf_validated_step3_chain_fingerprint(0, 1, scale, dt, 242670977) != 447483934 { return 19 }

    if bf_contains_ball(center_x, euler_xr, center_x, final_xr) != 0 { return 20 }
    if bf_contains_ball(center_x, final_xr, center_x + 25440, euler_xr) != 0 { return 21 }
    if bf_contains_ball(center_x, final_xr, center_x + 25439, euler_xr) != 1 { return 22 }
    if bf_bounds_match(center_x, final_xr, 974549, 1025452) != 0 { return 23 }
    if bf_enclosure_from_euler_lte(center_x, euler_xr, lte_x, 974548, 1025453) != 0 { return 24 }
    if bf_enclosure_from_euler_lte(center_x, euler_xr, 0 - 1, 974548, 1025452) != 0 { return 25 }
    if bf_contains_value(center_x, 0 - 1, center_x) != 0 { return 26 }
    if bf_validated_step3(center_x, center_y, center_z,
                          euler_xr, euler_yr, euler_zr,
                          lte_x, lte_y, lte_z,
                          974549, 1025452,
                          1227847, 1292153,
                          979961, 986707) != 0 { return 27 }
    if bf_validated_step3(center_x, center_y, center_z,
                          euler_xr, euler_yr, euler_zr,
                          lte_x, 0 - 1, lte_z,
                          974548, 1025452,
                          1227847, 1292153,
                          979961, 986707) != 0 { return 28 }
    if bf_validated_step3_fingerprint(center_x, center_y, center_z,
                                      euler_xr, euler_yr, euler_zr,
                                      lte_x, 0 - 1, lte_z,
                                      974548, 1025452,
                                      1227847, 1292153,
                                      979961, 986707) != (0 - 1) { return 29 }
    if bf_validated_step3_chain_fingerprint(0, 0, scale, dt, 242670977) != (0 - 1) { return 30 }
    if bf_validated_step3_chain_fingerprint(0, 1, 0, dt, 242670977) != (0 - 1) { return 31 }
    if bf_validated_step3_chain_fingerprint(0, 1, scale, dt, 0 - 1) != (0 - 1) { return 32 }

    return 0
}
