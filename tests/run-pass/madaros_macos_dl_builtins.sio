//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_DL_BUILTINS_PASS

extern "C" {
    fn dlopen(filename: *mut u8, flags: i32) -> *mut u8
    fn dlsym(handle: *mut u8, symbol: *mut u8) -> *mut u8
    fn dlclose(handle: *mut u8) -> i32
}

fn main() -> i64 with IO, Alloc, Mut, Panic, Div {
    let handle = dlopen(0 as *mut u8, 1)
    if (handle as i64) == 0 { return 1 }
    let symbol = dlsym(handle, ("getpid" as i64) as *mut u8)
    if (symbol as i64) == 0 { return 2 }
    let missing = dlsym(handle, ("__sounio_dl_builtins_nonexistent_symbol" as i64) as *mut u8)
    if (missing as i64) != 0 { return 3 }
    let pid = (symbol as i64) as fn() -> i32
    if (pid() as i64) <= 0 { return 4 }
    if dlclose(handle) != 0 { return 5 }
    println("MADAROS_DL_BUILTINS_PASS")
    0
}
