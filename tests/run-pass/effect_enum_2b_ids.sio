//@ run-pass
//@ description: Phase 2b ids 23-28 + Confidence=Epistemic alias; Mod held at -1; 0-22 untouched
//@ expect-stdout: NEGATIVE_CONTROL_FIRED
//@ expect-stdout: MOD_HELD
//@ expect-stdout: EFFECT_ENUM_2B_IDS_OK

fn empty_name() -> [i8; 64] {
    // lean_single (CI souc-stage2) rejects a bare `[0; 64]` tail as
    // `-> [i8; 64]`. Same class as the #1960 equiv witness.
    var buf: [i8; 64] = [0; 64]
    buf
}

fn fill3(a: i8, b: i8, c: i8) -> ([i8; 64], i64) with Mut {
    var buf: [i8; 64] = empty_name()
    buf[0] = a
    buf[1] = b
    buf[2] = c
    (buf, 3)
}

fn fill6(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8) -> ([i8; 64], i64) with Mut {
    var buf: [i8; 64] = empty_name()
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf[4] = e
    buf[5] = f
    (buf, 6)
}

fn fill9(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8) -> ([i8; 64], i64) with Mut {
    var buf: [i8; 64] = empty_name()
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf[4] = e
    buf[5] = f
    buf[6] = g
    buf[7] = h
    buf[8] = i
    (buf, 9)
}

fn fill10(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8) -> ([i8; 64], i64) with Mut {
    var buf: [i8; 64] = empty_name()
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf[4] = e
    buf[5] = f
    buf[6] = g
    buf[7] = h
    buf[8] = i
    buf[9] = j
    (buf, 10)
}

fn fill12(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8) -> ([i8; 64], i64) with Mut {
    var buf: [i8; 64] = empty_name()
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf[4] = e
    buf[5] = f
    buf[6] = g
    buf[7] = h
    buf[8] = i
    buf[9] = j
    buf[10] = k
    buf[11] = l
    (buf, 12)
}

fn fill13(a: i8, b: i8, c: i8, d: i8, e: i8, f: i8, g: i8, h: i8, i: i8, j: i8, k: i8, l: i8, m: i8) -> ([i8; 64], i64) with Mut {
    var buf: [i8; 64] = empty_name()
    buf[0] = a
    buf[1] = b
    buf[2] = c
    buf[3] = d
    buf[4] = e
    buf[5] = f
    buf[6] = g
    buf[7] = h
    buf[8] = i
    buf[9] = j
    buf[10] = k
    buf[11] = l
    buf[12] = m
    (buf, 13)
}

enum EffectKind {
    EffIO, EffMut, EffAlloc, EffPanic, EffDiv, EffGPU, EffAsync, EffProb,
    EffEpistemic, EffCausal, EffNetwork, EffSensor, EffRender, EffObserve,
    EffNonAssoc, EffAudit, EffHypothesis, EffMultiTest, EffZD, EffWitness,
    EffTemporal, EffLearn, EffChaotic,
    EffApprox, EffNaturalityG2, EffDeterministic, EffPerturbative,
    EffNarrowWidthApproximation, EffNonUnitary,
    EffVar,
}

fn nlen(k: i64) -> i64 {
    if k == 8 { 9 }
    else if k == 22 { 7 }
    else if k == 23 { 6 }
    else if k == 24 { 12 }
    else if k == 25 { 13 }
    else if k == 26 { 12 }
    else if k == 27 { 24 }
    else if k == 28 { 10 }
    else { 0 }
}

fn nbyte(k: i64, i: i64) -> i8 {
    if k == 8 {
        if i == 0 { 69 as i8 } else if i == 1 { 112 as i8 } else if i == 2 { 105 as i8 } else if i == 3 { 115 as i8 } else if i == 4 { 116 as i8 } else if i == 5 { 101 as i8 } else if i == 6 { 109 as i8 } else if i == 7 { 105 as i8 } else { 99 as i8 }
    } else if k == 23 {
        if i == 0 { 65 as i8 } else if i == 1 { 112 as i8 } else if i == 2 { 112 as i8 } else if i == 3 { 114 as i8 } else if i == 4 { 111 as i8 } else { 120 as i8 }
    } else if k == 24 {
        if i == 0 { 78 as i8 } else if i == 1 { 97 as i8 } else if i == 2 { 116 as i8 } else if i == 3 { 117 as i8 } else if i == 4 { 114 as i8 } else if i == 5 { 97 as i8 } else if i == 6 { 108 as i8 } else if i == 7 { 105 as i8 } else if i == 8 { 116 as i8 } else if i == 9 { 121 as i8 } else if i == 10 { 71 as i8 } else { 50 as i8 }
    } else if k == 25 {
        if i == 0 { 68 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 116 as i8 } else if i == 3 { 101 as i8 } else if i == 4 { 114 as i8 } else if i == 5 { 109 as i8 } else if i == 6 { 105 as i8 } else if i == 7 { 110 as i8 } else if i == 8 { 105 as i8 } else if i == 9 { 115 as i8 } else if i == 10 { 116 as i8 } else if i == 11 { 105 as i8 } else { 99 as i8 }
    } else if k == 26 {
        if i == 0 { 80 as i8 } else if i == 1 { 101 as i8 } else if i == 2 { 114 as i8 } else if i == 3 { 116 as i8 } else if i == 4 { 117 as i8 } else if i == 5 { 114 as i8 } else if i == 6 { 98 as i8 } else if i == 7 { 97 as i8 } else if i == 8 { 116 as i8 } else if i == 9 { 105 as i8 } else if i == 10 { 118 as i8 } else { 101 as i8 }
    } else if k == 27 {
        if i == 0 { 78 as i8 } else if i == 1 { 97 as i8 } else if i == 2 { 114 as i8 } else if i == 3 { 114 as i8 } else if i == 4 { 111 as i8 } else if i == 5 { 119 as i8 } else if i == 6 { 87 as i8 } else if i == 7 { 105 as i8 } else if i == 8 { 100 as i8 } else if i == 9 { 116 as i8 } else if i == 10 { 104 as i8 } else if i == 11 { 65 as i8 } else if i == 12 { 112 as i8 } else if i == 13 { 112 as i8 } else if i == 14 { 114 as i8 } else if i == 15 { 111 as i8 } else if i == 16 { 120 as i8 } else if i == 17 { 105 as i8 } else if i == 18 { 109 as i8 } else if i == 19 { 97 as i8 } else if i == 20 { 116 as i8 } else if i == 21 { 105 as i8 } else if i == 22 { 111 as i8 } else { 110 as i8 }
    } else if k == 28 {
        if i == 0 { 78 as i8 } else if i == 1 { 111 as i8 } else if i == 2 { 110 as i8 } else if i == 3 { 85 as i8 } else if i == 4 { 110 as i8 } else if i == 5 { 105 as i8 } else if i == 6 { 116 as i8 } else if i == 7 { 97 as i8 } else if i == 8 { 114 as i8 } else { 121 as i8 }
    } else {
        0 as i8
    }
}

fn lookup(name_buf: [i8; 64], name_len: i64) -> i64 with Mut {
    if name_len == 10 {
        if name_buf[0] == 67 as i8 && name_buf[1] == 111 as i8 && name_buf[2] == 110 as i8
           && name_buf[3] == 102 as i8 && name_buf[4] == 105 as i8 && name_buf[5] == 100 as i8
           && name_buf[6] == 101 as i8 && name_buf[7] == 110 as i8 && name_buf[8] == 99 as i8
           && name_buf[9] == 101 as i8 {
            return 8
        }
    }
    var k: i64 = 8
    while k <= 28 {
        let L = nlen(k)
        if L == name_len {
            var i: i64 = 0
            var ok = true
            while i < L {
                if name_buf[i as usize] != nbyte(k, i) {
                    ok = false
                }
                i = i + 1
            }
            if ok { return k }
        }
        k = k + 1
    }
    0 - 1
}

fn expect(got: i64, want: i64, tag: i64) -> i64 with IO {
    if got != want {
        print("ID_MISMATCH tag=")
        print_int(tag)
        print(" got=")
        print_int(got)
        print(" want=")
        print_int(want)
        print("\n")
        return 1
    }
    0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var fails: i64 = 0

    let io = fill3(73 as i8, 79 as i8, 0 as i8)
    // IO is not in this file's partial table (starts at 8). Must stay -1 here
    // so we do not accidentally renumber 0-22.
    fails = fails + expect(lookup(io.0, 2), 0 - 1, 0)

    let approx = fill6(65 as i8, 112 as i8, 112 as i8, 114 as i8, 111 as i8, 120 as i8)
    fails = fails + expect(lookup(approx.0, approx.1), 23, 23)

    let nat = fill12(78 as i8, 97 as i8, 116 as i8, 117 as i8, 114 as i8, 97 as i8, 108 as i8, 105 as i8, 116 as i8, 121 as i8, 71 as i8, 50 as i8)
    fails = fails + expect(lookup(nat.0, nat.1), 24, 24)

    let det = fill13(68 as i8, 101 as i8, 116 as i8, 101 as i8, 114 as i8, 109 as i8, 105 as i8, 110 as i8, 105 as i8, 115 as i8, 116 as i8, 105 as i8, 99 as i8)
    fails = fails + expect(lookup(det.0, det.1), 25, 25)

    let pert = fill12(80 as i8, 101 as i8, 114 as i8, 116 as i8, 117 as i8, 114 as i8, 98 as i8, 97 as i8, 116 as i8, 105 as i8, 118 as i8, 101 as i8)
    fails = fails + expect(lookup(pert.0, pert.1), 26, 26)

    var nwa: [i8; 64] = empty_name()
    nwa[0] = 78 as i8
    nwa[1] = 97 as i8
    nwa[2] = 114 as i8
    nwa[3] = 114 as i8
    nwa[4] = 111 as i8
    nwa[5] = 119 as i8
    nwa[6] = 87 as i8
    nwa[7] = 105 as i8
    nwa[8] = 100 as i8
    nwa[9] = 116 as i8
    nwa[10] = 104 as i8
    nwa[11] = 65 as i8
    nwa[12] = 112 as i8
    nwa[13] = 112 as i8
    nwa[14] = 114 as i8
    nwa[15] = 111 as i8
    nwa[16] = 120 as i8
    nwa[17] = 105 as i8
    nwa[18] = 109 as i8
    nwa[19] = 97 as i8
    nwa[20] = 116 as i8
    nwa[21] = 105 as i8
    nwa[22] = 111 as i8
    nwa[23] = 110 as i8
    fails = fails + expect(lookup(nwa, 24), 27, 27)

    let nu = fill10(78 as i8, 111 as i8, 110 as i8, 85 as i8, 110 as i8, 105 as i8, 116 as i8, 97 as i8, 114 as i8, 121 as i8)
    fails = fails + expect(lookup(nu.0, nu.1), 28, 28)

    // Mod is held (founder hold_mod_claude1). Must stay -1.
    // A reserved hole would invite someone to fill it.
    var modn: [i8; 64] = empty_name()
    modn[0] = 77 as i8
    modn[1] = 111 as i8
    modn[2] = 100 as i8
    let mod_id = lookup(modn, 3)
    if mod_id != (0 - 1) {
        print("MOD_NOT_HELD id=")
        print_int(mod_id)
        print("\n")
        fails = fails + 1
    } else {
        print("MOD_HELD -1\n")
    }

    // Epistemic is filled in-place like NWA. A fill9 tuple passed into
    // nested `expect(lookup(epi.0, epi.1))` returns -1 under lean_single
    // in this file (isolated fill9 probe returns 8). Same engine as CI.
    var epi: [i8; 64] = empty_name()
    epi[0] = 69 as i8
    epi[1] = 112 as i8
    epi[2] = 105 as i8
    epi[3] = 115 as i8
    epi[4] = 116 as i8
    epi[5] = 101 as i8
    epi[6] = 109 as i8
    epi[7] = 105 as i8
    epi[8] = 99 as i8
    let epi_id = lookup(epi, 9)
    fails = fails + expect(epi_id, 8, 8)

    var conf: [i8; 64] = empty_name()
    conf[0] = 67 as i8
    conf[1] = 111 as i8
    conf[2] = 110 as i8
    conf[3] = 102 as i8
    conf[4] = 105 as i8
    conf[5] = 100 as i8
    conf[6] = 101 as i8
    conf[7] = 110 as i8
    conf[8] = 99 as i8
    conf[9] = 101 as i8
    let conf_id = lookup(conf, 10)
    fails = fails + expect(conf_id, 8, 80)
    if conf_id != epi_id {
        print("CONFIDENCE_NE_EPISTEMIC\n")
        fails = fails + 1
    }

    let disc: i64 = EffectKind::EffVar
    if disc != 29 {
        print("EFFVAR_NOT_29 disc=")
        print_int(disc)
        print("\n")
        fails = fails + 1
    }
    if disc == 22 {
        print("EFFVAR_COLLIDES_CHAOTIC\n")
        fails = fails + 1
    }

    let nosuch = fill13(78 as i8, 111 as i8, 83 as i8, 117 as i8, 99 as i8, 104 as i8, 69 as i8, 102 as i8, 102 as i8, 101 as i8, 99 as i8, 116 as i8, 88 as i8)
    if lookup(nosuch.0, nosuch.1) != (0 - 1) {
        print("NEGATIVE_CONTROL_DID_NOT_FIRE\n")
        fails = fails + 1
    } else {
        print("NEGATIVE_CONTROL_FIRED -1\n")
    }

    if fails == 0 {
        print("EFFECT_ENUM_2B_IDS_OK extras 23-28 Confidence=8 EffVar=29 Mod held\n")
        0
    } else {
        print("EFFECT_ENUM_2B_IDS_FAIL fails=")
        print_int(fails)
        print("\n")
        1
    }
}
