//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_QUERY_RESULT_KNOWN_OK
//@ description: A number read from the uncertainty budget (variance_of, covariance_of, en_of, ...) is known: GUM gives it no uncertainty of its own. A weight built from variance_of therefore carries no channel, and variance_of(w * a + (1 - w) * b) is the exact inverse-variance result. Before, the walk took variance_of for an unknown call with uncertain arguments and refused the query (KL-11). Expected: w = 0.16 / 0.25, variance 0.09 * 0.16 / 0.25.

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-15 + 1.0e-12 * w
}
fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var bad: i64 = 0
    let k0 = measure(10.0, uncertainty: 0.3)
    let k1 = measure(10.4, uncertainty: 0.4)
    let a = k0.value
    let b = k1.value
    let w = variance_of(b) / (variance_of(a) + variance_of(b))
    let f = w * a + (1.0 - w) * b
    bad = bad + report("w", w, 0.64)
    bad = bad + report("fused", f, 10.144)
    bad = bad + report("var", variance_of(f), 0.0576)
    bad = bad + report("var(w)", variance_of(w), 0.0)
    let g = covariance_of(a, b) + a
    bad = bad + report("var(cov + a)", variance_of(g), 0.09)
    if bad == 0 {
        print("GUM_QUERY_RESULT_KNOWN_OK\n")
        return 0
    }
    1
}
