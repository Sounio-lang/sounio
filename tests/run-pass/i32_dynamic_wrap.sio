//@ run-pass
//@ requires: madaros
//@ expect-stdout: -2147483648
//@ expect-stdout: 2147483647
//@ expect-stdout: -1294967296
//@ expect-stdout: 0
//@ expect-stdout: -2147483648
//@ expect-stdout: I32_WRAP_PASS

// SIO-588: dynamic i32/u32 arithmetic respects 32 bits. The id() wrappers
// keep the operands out of const folding so the runtime narrowing path is
// exercised: i32 results sign-extend the low 32 bits, u32 results mask
// them. Wrapping (not trapping, not 64-bit passthrough) is the defined
// narrow result; the SIO-207 i64 trap story is unchanged.
fn id32(x: i32) -> i32 { x }
fn idu32(x: u32) -> u32 { x }
fn bump(x: i32) -> i32 { x + 1 }

fn main() -> i32 with IO {
    let a: i32 = id32(2147483647)
    println(a + 1)
    let n: i32 = id32(-2147483648)
    println(n - 1)
    println(id32(1000000) * id32(3000))
    let w: u32 = idu32(4294967295)
    println(w + 1)
    println(bump(a))
    println(-n)
    if a + 1 == -2147483648 && n - 1 == 2147483647 && w + 1 == 0 && bump(a) == -2147483648 {
        print("I32_WRAP_PASS\n")
    }
    return 0
}
