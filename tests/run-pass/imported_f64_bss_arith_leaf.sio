//@ ignore
// Wave15 D — imported-module f64 BSS arithmetic residual.
// Module-level f64 constant used in SAME-module arithmetic (add/sub/mul).
// Pre-fix into-acc: empty global_types + skip re-record on seed-preseeded BSS
// → LoadGlobal without ir_mark_float_reg → cvtsi2sd of IEEE bits.

pub let DE_LN_SQRT_2PI: f64 = 0.9189385332046727

pub fn de_bits() -> i64 {
    f64_to_bits(DE_LN_SQRT_2PI)
}

// Science-critical: 0.0 - DE then used as f64 (lognormal path shape)
pub fn exp_neg_de_like() -> f64 {
    // Not full de_exp — just the subtraction that was mis-typed.
    0.0 - DE_LN_SQRT_2PI
}

pub fn de_plus_one() -> f64 {
    DE_LN_SQRT_2PI + 1.0
}

pub fn de_times_two() -> f64 {
    DE_LN_SQRT_2PI * 2.0
}
