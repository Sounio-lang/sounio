//@ run-pass
//@ requires: madaros
//@ description: `s.as_bytes()` is a `[u8]` of the string's bytes and `&b[lo..hi]` / `&b[..hi]` / `&b[lo..]` / `&b[..]` borrow ranges of it -- lengths, element values and a `&[u8]` parameter; Madaros typed as_bytes as `&i8` (E011/E019 on `.len()`), never parsed `[..n]`, and never reached its slice-borrow checker
//@ expect-stdout: AS_BYTES_RANGE_OK

fn byte_sum(s: &[u8]) -> i64 with Panic {
    var t: i64 = 0
    var i: i64 = 0
    while i < s.len() as i64 {
        t = t + s[i as usize] as i64
        i = i + 1
    }
    t
}

fn main() -> i32 with IO, Panic, Mut {
    let b = "AZaz".as_bytes()
    if b.len() as i64 != 4 { return 1 }
    if b[0] as i64 != 65 || b[3] as i64 != 122 { return 2 }
    let head = &b[..2]
    if head.len() as i64 != 2 { return 3 }
    if head[1] as i64 != 90 { return 4 }
    let tail = &b[2..]
    if tail.len() as i64 != 2 || tail[0] as i64 != 97 { return 5 }
    if byte_sum(&b[1..3]) != 187 { return 6 }
    if byte_sum(&b[..]) != 374 { return 7 }
    let n: i64 = 3
    let cap = if n > 8 { 8 } else { n }
    let capped = &b[..cap as usize]
    if capped.len() as i64 != 3 { return 8 }
    println("AS_BYTES_RANGE_OK")
    0
}
