//@ run-pass
//@ description: Imported pseudo-Boolean/cardinality AM2 bridge API smoke

use theorem::pb::*

fn main() -> i32 {
    let row = pb_card_at_most_two_row3()

    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 3, 0 - 4, 2, 3, 4) != 1 { return 1 }
    if pb_check_card_at_most_two_clause_conflict3(0 - 2, 0 - 3, 0 - 4, 2, 3, 4, 1, 1, 1) != 1 { return 2 }
    if pb_row_check_card_at_most_two_clause_conflict3(row, 0 - 2, 0 - 3, 0 - 4, 2, 3, 4, 1, 1, 1) != 1 { return 3 }

    if pb_check_card_at_most_two_clause_conflict3(0 - 2, 0 - 3, 0 - 4, 2, 3, 4, 1, 1, 0 - 1) != 0 { return 4 }
    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 2, 0 - 4, 2, 3, 4) != 0 { return 5 }
    if pb_card_at_most_two_clause_matches3(2, 0 - 3, 0 - 4, 2, 3, 4) != 0 { return 6 }
    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 3, 0 - 5, 2, 3, 4) != 0 { return 7 }
    if pb_card_at_most_two_clause_matches3(0 - 2, 0 - 3, 0 - 4, 2, 2, 4) != 0 { return 8 }
    if pb_row_check_card_at_most_two_clause_conflict3(pb_row3(1, 1, 1, 1, pb_sense_le()), 0 - 2, 0 - 3, 0 - 4, 2, 3, 4, 1, 1, 1) != 0 { return 9 }

    return 0
}
