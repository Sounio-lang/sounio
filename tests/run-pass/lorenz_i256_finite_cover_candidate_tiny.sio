//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 finite-cover candidate non-claim receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1777
    fp = mix(fp, 461075499, 5701)
    fp = mix(fp, 641858696, 5701)
    fp = mix(fp, 467412992, 5701)
    fp = mix(fp, 978167597, 5701)
    fp = mix(fp, 329959989, 5701)
    fp = mix(fp, 77888110, 5701)
    fp = mix(fp, 245178976, 5701)
    fp = mix(fp, 713010204, 5701)
    fp = mix(fp, 725222703, 5701)
    fp = mix(fp, 845057161, 5701)
    fp = mix(fp, 214180161, 5701)
    fp = mix(fp, 114244647, 5701)
    fp = mix(fp, 166945519, 5701)
    fp = mix(fp, 87220662, 5701)
    fp = mix(fp, 677514412, 5701)
    fp = mix(fp, 69322697, 5701)
    fp = mix(fp, 911209450, 5701)
    fp = mix(fp, 709377850, 5701)
    fp = mix(fp, 1, 5701)
    fp = mix(fp, 1, 5701)
    fp = mix(fp, 256, 5701)
    fp = mix(fp, 32, 5701)
    fp = mix(fp, 1000000, 5701)
    fp = mix(fp, 5, 5701)
    fp = mix(fp, 1, 5701)
    fp = mix(fp, 100, 5701)
    fp = mix(fp, 31, 5701)
    fp = mix(fp, 0, 5701)
    fp = mix(fp, 0, 5701)
    fp = mix(fp, 28, 5701)
    return fp
}

fn certificate_fp(instance: i64) -> i64 {
    var fp: i64 = 1783
    fp = mix(fp, instance, 5711)
    fp = mix(fp, 31, 5711)
    fp = mix(fp, 0, 5711)
    fp = mix(fp, 0, 5711)
    fp = mix(fp, 1, 5711)
    fp = mix(fp, 1, 5711)
    fp = mix(fp, 1, 5711)
    fp = mix(fp, 28, 5711)
    fp = mix(fp, 255, 5711)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1787
    fp = mix(fp, instance, 5717)
    fp = mix(fp, certificate, 5717)
    fp = mix(fp, 20, 5717)
    fp = mix(fp, 1, 5717)
    fp = mix(fp, 31, 5717)
    fp = mix(fp, 0, 5717)
    fp = mix(fp, 0, 5717)
    fp = mix(fp, 28, 5717)
    fp = mix(fp, 255, 5717)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1789
    fp = mix(fp, artifact, 5737)
    fp = mix(fp, instance, 5737)
    fp = mix(fp, certificate, 5737)
    fp = mix(fp, 461075499, 5737)
    fp = mix(fp, 641858696, 5737)
    fp = mix(fp, 467412992, 5737)
    fp = mix(fp, 978167597, 5737)
    fp = mix(fp, 329959989, 5737)
    fp = mix(fp, 77888110, 5737)
    fp = mix(fp, 245178976, 5737)
    fp = mix(fp, 713010204, 5737)
    fp = mix(fp, 725222703, 5737)
    fp = mix(fp, 845057161, 5737)
    fp = mix(fp, 214180161, 5737)
    fp = mix(fp, 114244647, 5737)
    fp = mix(fp, 166945519, 5737)
    fp = mix(fp, 87220662, 5737)
    fp = mix(fp, 677514412, 5737)
    fp = mix(fp, 69322697, 5737)
    fp = mix(fp, 911209450, 5737)
    fp = mix(fp, 709377850, 5737)
    fp = mix(fp, 1, 5737)
    fp = mix(fp, 1, 5737)
    fp = mix(fp, 256, 5737)
    fp = mix(fp, 32, 5737)
    fp = mix(fp, 1000000, 5737)
    fp = mix(fp, 5, 5737)
    fp = mix(fp, 1, 5737)
    fp = mix(fp, 100, 5737)
    fp = mix(fp, 31, 5737)
    fp = mix(fp, 0, 5737)
    fp = mix(fp, 0, 5737)
    fp = mix(fp, 28, 5737)
    fp = mix(fp, 255, 5737)
    return fp
}

fn main() -> i64 {
    let instance = instance_fp()
    if instance != 906677279 { return 1 }
    let certificate = certificate_fp(instance)
    if certificate != 409602997 { return 2 }
    let artifact = artifact_fp(instance, certificate)
    if artifact != 911169246 { return 3 }
    let audit = audit_fp(artifact, instance, certificate)
    if audit != 785916873 { return 4 }
    return 0
}
