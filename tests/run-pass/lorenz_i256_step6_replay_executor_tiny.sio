//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 replay executor receipt checks node and edge replay masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 563
    fp = mix(fp, 6, 4013)
    fp = mix(fp, 490362827, 4013)
    fp = mix(fp, 772468073, 4013)
    fp = mix(fp, 929938975, 4013)
    fp = mix(fp, 641464796, 4013)
    fp = mix(fp, 134624236, 4013)
    fp = mix(fp, 237534229, 4013)
    fp = mix(fp, 516981885, 4013)
    fp = mix(fp, 652877359, 4013)
    fp = mix(fp, 1, 4013)
    fp = mix(fp, 1, 4013)
    fp = mix(fp, 4, 4013)
    fp = mix(fp, 4, 4013)
    fp = mix(fp, 15, 4013)
    fp = mix(fp, 15, 4013)
    fp = mix(fp, 15, 4013)
    fp = mix(fp, 15, 4013)
    fp = mix(fp, 0, 4013)
    fp = mix(fp, 7, 4013)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 195235667 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 569
    fp = mix(fp, instance, 4019)
    fp = mix(fp, 4, 4019)
    fp = mix(fp, 4, 4019)
    fp = mix(fp, 15, 4019)
    fp = mix(fp, 15, 4019)
    fp = mix(fp, 15, 4019)
    fp = mix(fp, 15, 4019)
    fp = mix(fp, 0, 4019)
    fp = mix(fp, 7, 4019)
    fp = mix(fp, ok_mask, 4019)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 195235667 { return 0 - 1 }
    if certificate != 81302823 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 571
    fp = mix(fp, instance, 4021)
    fp = mix(fp, certificate, 4021)
    fp = mix(fp, 8, 4021)
    fp = mix(fp, 6, 4021)
    fp = mix(fp, 1, 4021)
    fp = mix(fp, 1, 4021)
    fp = mix(fp, 7, 4021)
    fp = mix(fp, ok_mask, 4021)
    return fp
}

fn replay_execution_mask() -> i64 {
    let node_receipt_mask: i64 = 15
    let edge_receipt_mask: i64 = 15
    let replayed_node_mask: i64 = 15
    let predecessor_ready_mask: i64 = 15
    let validated_mask: i64 = 0
    let replay_status: i64 = 7

    var ok_mask: i64 = 0
    if 490362827 > 0 {
        if 929938975 > 0 {
            if 641464796 > 0 { ok_mask = ok_mask + 1 }
        }
    }
    if node_receipt_mask == 15 { ok_mask = ok_mask + 2 }
    if edge_receipt_mask == node_receipt_mask { ok_mask = ok_mask + 4 }
    if replayed_node_mask == node_receipt_mask {
        if predecessor_ready_mask == edge_receipt_mask { ok_mask = ok_mask + 8 }
    }
    if replay_status == 7 { ok_mask = ok_mask + 16 }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if 490362827 != 929938975 {
        if 929938975 != 641464796 { ok_mask = ok_mask + 64 }
    }
    if 1 == 1 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = replay_execution_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 195235667 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 81302823 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 975464919 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
