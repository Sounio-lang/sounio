//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_IMPURE_CTOR_PASS

// Side-effecting pure-field constructors (Mut): FO of field slices is live
// when field inits are pure FO exprs of params. Effects on unrelated state
// (G counter) do not block FO registration of the returned struct's fields.
// No claim that FO tracks the effectful channel — only pure field FO.

struct Pk {
    cl0: f64
    tag: i64
}

var G: i64 = 0

fn make_mut(cl0: f64) -> Pk with Mut {
    G = G + 1
    Pk { cl0: cl0, tag: G }
}

fn make_mut_dbl(x: f64) -> Pk with Mut {
    G = G + 1
    Pk { cl0: x * 2.0, tag: G }
}

fn make_mut_let(x: f64) -> Pk with Mut {
    G = G + 1
    let y = x * 2.0
    Pk { cl0: y, tag: G }
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let x = kx.value

    let v_id = variance_of(make_mut(x).cl0)
    let v_dbl = variance_of(make_mut_dbl(x).cl0)
    let v_let = variance_of(make_mut_let(x).cl0)
    let v_peel = variance_of(x)
    let v_peel2 = variance_of(x * 2.0)

    let pk = make_mut_dbl(x)
    let v_alias = variance_of(pk.cl0)

    print("v_id="); print_f64(v_id); print("\n")
    print("v_dbl="); print_f64(v_dbl); print("\n")
    print("v_let="); print_f64(v_let); print("\n")
    print("v_alias="); print_f64(v_alias); print("\n")

    let ok = abs_f(v_id - v_peel) < 1.0e-9
        && abs_f(v_id - 0.09) < 1.0e-9
        && abs_f(v_dbl - v_peel2) < 1.0e-9
        && abs_f(v_dbl - 0.36) < 1.0e-9
        && abs_f(v_let - v_peel2) < 1.0e-9
        && abs_f(v_alias - v_peel2) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_IMPURE_CTOR_PASS\n")
    } else {
        print("MADAROS_GUM_FO_IMPURE_CTOR_FAIL\n")
    }
}
