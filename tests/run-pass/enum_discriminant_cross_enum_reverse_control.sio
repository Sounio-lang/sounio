//@ run-pass
//@ expect-stdout: enum_discriminant_reverse_control: PASS
//@ description: PR #1737 w7b CONTROL -- the OTHER direction of the w7 collision
// Regression port of tests/witness_matrix/cases/w7b_enum_reverse.sio into the
// standard suite.
//
// This is a CONTROL, not a witness: on the PRE-fix compiler it already passed,
// because Shape registers first in the enum-variant table and the name-only
// lookup therefore happened to return Shape::Mark's own discriminant. It exists
// to catch a pseudo-fix that merely reorders the table (or prefers the other
// enum): such a fix would close w7 and silently OPEN this direction, trading
// one miscompile for another. A fix is only correct if BOTH this file and
// enum_discriminant_cross_enum_collision.sio pass at the same time.
//
// Shape::Mark is 1 in Shape (Quad=0, Mark=1); Color::Mark is 2 in Color.
// EXPECT the match to run the Shape::Mark arm.

enum Shape { Quad{w: i64}, Mark }
enum Color { Red, Green, Mark }

fn shape_mark_match_arm() -> i64 {
    let s: Shape = Shape::Mark
    match s {
        Shape::Quad{w} => 99,
        Shape::Mark => 1,
        _ => 0,
    }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var bad: i64 = 0

    // Match arm: must be Shape's own 1, not Color::Mark's 2.
    if shape_mark_match_arm() != 1 { bad = bad + 1 }

    // Construction site: Shape::Mark mints 1 even with Color's Mark present.
    let constructed: i64 = Shape::Mark
    if constructed != 1 { bad = bad + 1 }

    // NOTE: the payload variant Shape::Quad{w} is deliberately exercised only
    // through the MATCH ARM above, exactly as w7b does. Constructing a payload
    // variant into an integer (`let q: i64 = Shape::Quad { w: 7 }`) was probed
    // while authoring this file and yields a garbage value under the current
    // compiler -- a separate defect class from the discriminant collision,
    // reported to the coord bus rather than folded in here.

    if bad != 0 {
        print("enum_discriminant_reverse_control: FAIL ")
        print_int(bad)
        print("\n")
        return 1
    }
    print("enum_discriminant_reverse_control: PASS\n")
    0
}
