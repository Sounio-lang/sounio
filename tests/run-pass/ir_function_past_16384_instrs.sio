//@ run-pass
//@ requires: madaros
//@ timeout: 120
//@ expect-stdout: ir16384_wall: PASS acc=577
//@ description: one function past the old 16384 IR_MAX_INSTRS / IR_MAX_VREGS cap lowers completely and keeps f64 typing for vregs past 16384
// IR_MAX_INSTRS and IR_MAX_VREGS were 16384. tests/stdlib/data/test_bigframe_ops_stdlib.sio
// has one `main` of 37526 IR instructions, so it was refused ("needs 37526 IR
// instructions but IR_MAX_INSTRS is 16384"). Both caps are 65536 now, with every
// native per-function tier sized from them (labels, return jumps, NC_IS_FLOAT_REG,
// NC_RAW_TAG_REG, NC_REG_CLASS, NC_HIGH_SEEN).
//
// The 1000-step chain below is ~25 IR instructions per step (measured: 700 steps
// gave 17585), i.e. ~25k, so under the old cap this function did not compile. The float tail then sits at
// vregs past 16384: NC_HIGH_SEEN used to hold 16384 bits, so a float mark there
// was dropped and negation of it compiled as integer `neg rax`.
// The expected acc is the same recurrence evaluated in shell arithmetic.
// This file must stay ONE function: the wall is per function.

fn past_old_wall(seed: i64) -> f64 with IO, Mut, Panic, Div {
    var acc: i64 = seed
    acc = (acc * 31 + 0) % 1009
    acc = (acc * 31 + 1) % 1009
    acc = (acc * 31 + 2) % 1009
    acc = (acc * 31 + 3) % 1009
    acc = (acc * 31 + 4) % 1009
    acc = (acc * 31 + 5) % 1009
    acc = (acc * 31 + 6) % 1009
    acc = (acc * 31 + 7) % 1009
    acc = (acc * 31 + 8) % 1009
    acc = (acc * 31 + 9) % 1009
    acc = (acc * 31 + 10) % 1009
    acc = (acc * 31 + 11) % 1009
    acc = (acc * 31 + 12) % 1009
    acc = (acc * 31 + 13) % 1009
    acc = (acc * 31 + 14) % 1009
    acc = (acc * 31 + 15) % 1009
    acc = (acc * 31 + 16) % 1009
    acc = (acc * 31 + 17) % 1009
    acc = (acc * 31 + 18) % 1009
    acc = (acc * 31 + 19) % 1009
    acc = (acc * 31 + 20) % 1009
    acc = (acc * 31 + 21) % 1009
    acc = (acc * 31 + 22) % 1009
    acc = (acc * 31 + 23) % 1009
    acc = (acc * 31 + 24) % 1009
    acc = (acc * 31 + 25) % 1009
    acc = (acc * 31 + 26) % 1009
