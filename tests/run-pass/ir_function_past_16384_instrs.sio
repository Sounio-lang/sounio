    let z = x
    var w = z
    w = w * 2.0
    let neg = -w
    var fs: [f64; 2] = [0.0, 0.0]
    fs[0] = neg
    let back = fs[0]
    print("acc=")
    print_int(acc)
    print("\n")
    back + 0.25 + (acc as f64)
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let r = past_old_wall(1)
    let want = -4.75 + (577 as f64)
    if r == want { print("ir16384_wall: PASS acc=577\n"); return 0 }
    print_f64(r)
    print("\nir16384_wall: FAIL\n")
    1
}
