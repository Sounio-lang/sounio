//@ run-pass
//@ requires: madaros
//@ expect-stdout: NATIVE_MATH_USER_DEFINITION_WINS_OK
// The implicit math::transcendental import must never shadow a program's own
// function (#2507).
//
// Madaros links calls by name and prefers any body over a stub, so a second
// `atan` body in the module graph could silently take over this file's calls.
// The driver therefore imports math::transcendental::<name> per name, and only
// when no loaded module defines that name. Here `atan` is defined locally with
// a value no real arctangent returns, while `tan` is not -- so tan must come
// from the implicit module and atan must stay 42.

fn atan(x: f64) -> f64 {
    42.0
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let a = atan(0.5)
    let t = tan(0.5)
    print("atan="); print_f64(a); print("\n")
    print("tan="); print_f64(t); print("\n")
    if a != 42.0 {
        print("NATIVE_MATH_USER_DEFINITION_WINS_FAIL local atan was shadowed\n")
        return 1
    }
    if abs_f(t - 0.5463024898437905) > 1.0e-14 {
        print("NATIVE_MATH_USER_DEFINITION_WINS_FAIL tan\n")
        return 1
    }
    print("NATIVE_MATH_USER_DEFINITION_WINS_OK\n")
    0
}
