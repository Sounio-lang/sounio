//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 enclosure projection checks directed rounding API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_enclosure_projection_artifact_check(
        1047216, 2263679, 900658, 1646551, 3042264, 1008677)
    if artifact_fp != 516981885 { return 1 }

    let audit_fp = lorenz_i256_step6_enclosure_projection_artifact_audit_fingerprint(
        artifact_fp, 35569102, 472466935, 134624236, 237534229, 6, 3, 127)
    if audit_fp != 989033159 { return 2 }
    return 0
}
