//@ run-pass
//@ description: Lorenz i128 Euler interval LTE bound for x/y over the first step box

fn main() -> i64 {
    // Box covering the initial ball and the one-step Euler ball:
    //   x in [999987,1000013]
    //   y in [999990,1260013]
    //   z in [983323,1000010]
    // The centers/radii come from lorenz_i128_ball_step.sio.
    let scale: i64 = 1000000
    let h2: i64 = 100000000
    let den: i64 = 2000000000000

    let x_abs: i64 = 1000013
    let y_abs: i64 = 1260013
    let z_low: i64 = 983323
    let z_high: i64 = 1000010

    let rho_s: i64 = 28000000
    let rhoz_low_abs: i64 = rho_s - z_low
    let rhoz_high_abs: i64 = rho_s - z_high
    var rhoz_abs: i64 = rhoz_low_abs
    if rhoz_high_abs > rhoz_abs { rhoz_abs = rhoz_high_abs }

    // Conservative derivative bounds over the whole box.
    let dx_abs: i64 = 10 * (y_abs + x_abs)
    let dy_abs: i64 = (x_abs * rhoz_abs + scale - 1) / scale + y_abs
    let dz_abs: i64 = (x_abs * y_abs + scale - 1) / scale + ((8 * 1000010) + 2) / 3

    // x'' = sigma * (y' - x').
    // y'' = x' * (rho - z) - x * z' - y'.
    let ddx_abs: i64 = 10 * (dy_abs + dx_abs)
    let ddy_abs: i64 = (dx_abs * rhoz_abs + scale - 1) / scale +
                       (x_abs * dz_abs + scale - 1) / scale +
                       dy_abs

    let lte_x: i64 = (h2 * ddx_abs + den - 1) / den
    let lte_y: i64 = (h2 * ddy_abs + den - 1) / den
    let total_xr: i64 = 13 + lte_x
    let total_yr: i64 = 13 + lte_y

    if rhoz_abs != 27016677 { return 1 }
    if dx_abs != 22600260 { return 2 }
    if dy_abs != 28277042 { return 3 }
    if dz_abs != 3926724 { return 4 }
    if ddx_abs != 508773020 { return 5 }
    if ddy_abs != 642787743 { return 6 }
    if lte_x != 25439 { return 7 }
    if lte_y != 32140 { return 8 }
    if total_xr != 25452 { return 9 }
    if total_yr != 32153 { return 10 }
    return 0
}
