//@ run-pass
//@ expect-stdout: unit derived binding: PASS
// A quantity derived by arithmetic rather than declared. The dimension m/s is
// composed by the division and has no unit name to be stored under, so the
// binding used to drop it. Scientific code produces most of its quantities this
// way, so this is the common case rather than the corner one.

unit velocity = m / s;

fn takes_velocity(v: velocity) -> f64 with Mut {
    v
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 10.0
    let time: s = 2.0
    let speed = distance / time
    let checked = takes_velocity(speed)
    if checked == 5.0 {
        print("unit derived binding: PASS\n")
    }
    return 0
}
