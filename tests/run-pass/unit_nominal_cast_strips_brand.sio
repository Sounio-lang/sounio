//@ run-pass
//@ expect-stdout: UNIT_NOMINAL_CALL_CAST_OK

//! Split out of tests/compile-fail/unit_nominal_bare_f64_arg.sio: a nominal
//! unit (`unit mg_dL;`, no dimensional right-hand side, dimension zero) still
//! takes an explicit `as f64` cast to enter a bare f64 parameter, exactly like
//! a dimensional unit does (unit_call_cast_strips_brand.sio). Kept here,
//! separate from the compile-fail fixture, so a regression in this accepted
//! path cannot mask a regression in the rejected one: both call
//! `takes_f64` with the same nominally-typed value, so if the explicit-cast
//! call also started emitting "unit mismatch in call argument" (e.g. `as f64`
//! stopped stripping the brand), the compile-fail fixture would still show
//! the expected error text from THIS call alone and hide that its own,
//! uncast call had silently stopped being rejected.

unit mg_dL;

fn takes_f64(x: f64) -> f64 { x * 2.0 }

fn main() -> i32 with IO, Div, Panic {
    let glucose: mg_dL = 140.0
    let a = takes_f64(glucose as f64)
    if a == 280.0 {
        println("UNIT_NOMINAL_CALL_CAST_OK")
        return 0
    }
    1
}
