//@ run-pass
// KL-16g: if/else join merges the full Hessian upper triangle (36 pairs),
// not only H[0,0]. Seed pin — no Madaros sabotage.
//
// Before this rung the join spilled FO ch0–7 + H[0,0] and then forced every
// other EXPR_HSHADOW_jk to -1, so hessian_of through `x*y` printed 0.0.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Epistemic, Mut, Div {
    let xm: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value

    // Two measures: ch0 = x, ch1 = y. ∂²(x*y)/∂x∂y = 1 on the live arm.
    let h_then = hessian_of(if true { x * y } else { 0.0 }, 0, 1)
    let h_else = hessian_of(if false { 0.0 } else { x * y }, 0, 1)
    // H[0,0] regression: ∂²(x*x)/∂x² = 2, still merged through the join.
    let h00 = hessian_of(if true { x * x } else { x * x }, 0, 0)

    println(h_then)
    println(h_else)
    println(h00)

    let ok = abs_f(h_then - 1.0) < 1.0e-9
        && abs_f(h_else - 1.0) < 1.0e-9
        && abs_f(h00 - 2.0) < 1.0e-9
    if ok {
        print("KL16G_IFELSE_H_TRIANGLE_PASS\n")
    } else {
        print("KL16G_IFELSE_H_TRIANGLE_FAIL\n")
    }
}
