//@ run-pass
//@ description: Scalar graph-colouring CNF manifest layout gate

fn card_exactly_one_clause_count(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return 1 + (n * (n - 1)) / 2
}

fn card_colour_vertex_clause_count(colour_count: i64) -> i64 {
    return card_exactly_one_clause_count(colour_count)
}

fn card_colour_edge_base_id(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex = card_colour_vertex_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex + 1
}

fn card_colour_vertex_block_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex = card_colour_vertex_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex
}

fn card_colour_edge_clause_count(edge_count: i64, colour_count: i64) -> i64 {
    if edge_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return edge_count * colour_count
}

fn card_colour_total_clause_count(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let vertex_block = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_block = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    return vertex_block + edge_block
}

fn card_colour_clause_kind(vertex_count: i64, edge_count: i64, colour_count: i64, clause_id: i64) -> i64 {
    if clause_id < 1 { return 0 }
    let vertex_block = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 }
    if clause_id <= vertex_block { return 1 }

    let total = card_colour_total_clause_count(vertex_count, edge_count, colour_count)
    if total < 0 { return 0 }
    if clause_id <= total { return 2 }
    return 0
}

fn card_colour_vertex_from_clause(vertex_count: i64, colour_count: i64, clause_id: i64) -> i64 with Div {
    if card_colour_clause_kind(vertex_count, 0, colour_count, clause_id) != 1 { return 0 - 1 }
    let per_vertex = card_colour_vertex_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return (clause_id - 1) / per_vertex
}

fn card_colour_vertex_local_clause_id(vertex_count: i64, colour_count: i64, clause_id: i64) -> i64 with Div {
    if card_colour_clause_kind(vertex_count, 0, colour_count, clause_id) != 1 { return 0 - 1 }
    let per_vertex = card_colour_vertex_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return ((clause_id - 1) % per_vertex) + 1
}

fn card_colour_edge_clause_id(vertex_count: i64, colour_count: i64, edge_index: i64, colour: i64) -> i64 {
    if edge_index < 0 { return 0 - 1 }
    if colour < 0 { return 0 - 1 }
    if colour >= colour_count { return 0 - 1 }
    let base = card_colour_edge_base_id(vertex_count, colour_count)
    if base < 1 { return 0 - 1 }
    return base + edge_index * colour_count + colour
}

fn card_colour_edge_index_from_clause(vertex_count: i64, edge_count: i64, colour_count: i64, clause_id: i64) -> i64 with Div {
    if card_colour_clause_kind(vertex_count, edge_count, colour_count, clause_id) != 2 { return 0 - 1 }
    let base = card_colour_edge_base_id(vertex_count, colour_count)
    if base < 1 { return 0 - 1 }
    return (clause_id - base) / colour_count
}

fn card_colour_edge_colour_from_clause(vertex_count: i64, edge_count: i64, colour_count: i64, clause_id: i64) -> i64 with Div {
    if card_colour_clause_kind(vertex_count, edge_count, colour_count, clause_id) != 2 { return 0 - 1 }
    let base = card_colour_edge_base_id(vertex_count, colour_count)
    if base < 1 { return 0 - 1 }
    return (clause_id - base) % colour_count
}

fn main() -> i64 with Div {
    let n: i64 = 3
    let m: i64 = 3
    let k: i64 = 2

    if card_colour_vertex_block_count(n, k) != 6 { return 1 }
    if card_colour_edge_clause_count(m, k) != 6 { return 2 }
    if card_colour_total_clause_count(n, m, k) != 12 { return 3 }

    if card_colour_edge_base_id(n, k) != 7 { return 4 }
    if card_colour_clause_kind(n, m, k, 0) != 0 { return 5 }
    if card_colour_clause_kind(n, m, k, 1) != 1 { return 6 }
    if card_colour_clause_kind(n, m, k, 6) != 1 { return 7 }
    if card_colour_clause_kind(n, m, k, 7) != 2 { return 8 }
    if card_colour_clause_kind(n, m, k, 12) != 2 { return 9 }
    if card_colour_clause_kind(n, m, k, 13) != 0 { return 10 }

    if card_colour_vertex_from_clause(n, k, 1) != 0 { return 11 }
    if card_colour_vertex_local_clause_id(n, k, 1) != 1 { return 12 }
    if card_colour_vertex_from_clause(n, k, 2) != 0 { return 13 }
    if card_colour_vertex_local_clause_id(n, k, 2) != 2 { return 14 }
    if card_colour_vertex_from_clause(n, k, 3) != 1 { return 15 }
    if card_colour_vertex_local_clause_id(n, k, 3) != 1 { return 16 }
    if card_colour_vertex_from_clause(n, k, 6) != 2 { return 17 }
    if card_colour_vertex_local_clause_id(n, k, 6) != 2 { return 18 }

    if card_colour_edge_clause_id(n, k, 0, 0) != 7 { return 19 }
    if card_colour_edge_clause_id(n, k, 0, 1) != 8 { return 20 }
    if card_colour_edge_clause_id(n, k, 1, 0) != 9 { return 21 }
    if card_colour_edge_clause_id(n, k, 2, 1) != 12 { return 22 }

    if card_colour_edge_index_from_clause(n, m, k, 7) != 0 { return 23 }
    if card_colour_edge_colour_from_clause(n, m, k, 7) != 0 { return 24 }
    if card_colour_edge_index_from_clause(n, m, k, 8) != 0 { return 25 }
    if card_colour_edge_colour_from_clause(n, m, k, 8) != 1 { return 26 }
    if card_colour_edge_index_from_clause(n, m, k, 11) != 2 { return 27 }
    if card_colour_edge_colour_from_clause(n, m, k, 11) != 0 { return 28 }
    if card_colour_edge_index_from_clause(n, m, k, 12) != 2 { return 29 }
    if card_colour_edge_colour_from_clause(n, m, k, 12) != 1 { return 30 }

    if card_colour_vertex_from_clause(n, k, 7) != (0 - 1) { return 31 }
    if card_colour_edge_index_from_clause(n, m, k, 6) != (0 - 1) { return 32 }
    if card_colour_total_clause_count(n, 0 - 1, k) != (0 - 1) { return 33 }
    if card_colour_total_clause_count(n, m, 0) != (0 - 1) { return 34 }

    return 0
}
