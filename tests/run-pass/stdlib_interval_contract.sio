//@ run-pass
//@ expect-stdout: INTERVAL_CONTRACT_PASS
use epistemic::interval_contract::{interval_contract64,interval_contract_status,interval_contract_decoration,interval_contract_lo,interval_contract_hi,interval_contract_empty,interval_contract_singleton,interval_contract_contains,interval_contract_less,interval_contract_hull}
fn main()->i32 with IO,Mut,Panic {
 let inf:f64=bits_to_f64(9218868437227405312)
 let nan:f64=bits_to_f64(9221120237041090560)
 let z=interval_contract64(0.0,-0.0,4)
 assert(interval_contract_status(z)==0)
 assert(f64_to_bits(interval_contract_lo(z))== -9223372036854775808)
 assert(f64_to_bits(interval_contract_hi(z))==0)
 assert(interval_contract_singleton(z))
 let entire=interval_contract64(-inf,inf,4)
 assert(interval_contract_decoration(entire)==3)
 assert(interval_contract_contains(entire,1.0))
 assert(!interval_contract_contains(entire,inf))
 assert(!interval_contract_contains(entire,-inf))
 assert(!interval_contract_contains(entire,nan))
 let empty=interval_contract64(3.0,2.0,4)
 assert(interval_contract_empty(empty))
 assert(interval_contract_decoration(empty)==1)
 assert(f64_to_bits(interval_contract_lo(empty))==9218868437227405312)
 assert(f64_to_bits(interval_contract_hi(empty))== -4503599627370496)
 assert(interval_contract_status(interval_contract64(nan,1.0,4))==1)
 assert(interval_contract_status(interval_contract64(inf,inf,4))==1)
 assert(interval_contract_status(interval_contract64(-inf,-inf,4))==1)
 assert(interval_contract_status(interval_contract64(0.0,1.0,0))==2)
 let a=interval_contract64(0.0,2.0,4)
 let b=interval_contract64(1.0,3.0,3)
 assert(interval_contract_less(a,b)==1)
 assert(interval_contract_less(z,b)==2)
 assert(interval_contract_less(b,z)==0)
 assert(interval_contract_less(empty,a)==3)
 let hull=interval_contract_hull(a,b)
 assert(interval_contract_lo(hull)==0.0)
 assert(interval_contract_hi(hull)==3.0)
 assert(interval_contract_decoration(hull)==3)
 assert(interval_contract_hi(interval_contract_hull(empty,b))==3.0)
 var endpoints:[f64;12]=[0.0;12]
 endpoints[0]= -inf
 endpoints[1]= -1.7976931348623157e308
 endpoints[2]= -1.0
 endpoints[3]=bits_to_f64(-9223372036854775807)
 endpoints[4]=bits_to_f64(-9223372036854775808)
 endpoints[5]=0.0
 endpoints[6]=bits_to_f64(1)
 endpoints[7]=1.0
 endpoints[8]=1.7976931348623157e308
 endpoints[9]=inf
 endpoints[10]=nan
 endpoints[11]=2.0
 var i:i64=0
 while i<12 {
  var j:i64=0
  while j<12 {
   var d:i64=0
   while d<6 {
    let x=interval_contract64(endpoints[i],endpoints[j],d)
    let y=interval_contract64(endpoints[j],endpoints[i],4)
    let h=interval_contract_hull(x,y)
    let xs:i64=interval_contract_status(x)
    let xd:i64=interval_contract_decoration(x)
    let xl:i64=f64_to_bits(interval_contract_lo(x))
    let xh:i64=f64_to_bits(interval_contract_hi(x))
    let comparison:i64=interval_contract_less(x,y)
    let hs:i64=interval_contract_status(h)
    let hd:i64=interval_contract_decoration(h)
    let hl:i64=f64_to_bits(interval_contract_lo(h))
    let hh:i64=f64_to_bits(interval_contract_hi(h))
    println("IC {} {} {} {} {} {} {} {} {} {} {} {}",i,j,d,xs,xd,xl,xh,comparison,hs,hd,hl,hh)
    d=d+1
   }
   j=j+1
  }
  i=i+1
 }
 println("INTERVAL_CONTRACT_PASS")
 0
}
