//@ run-pass
//@ description: #2507 — math::pure::atan is accurate near |x| = 1 (it returned 0.779149 for atan(1)), so a derivative taken through its body is the true one: lean_single's hessian_of(atan(x)) at x = 1 was -40 (the 39-term Taylor polynomial's), not atan''(1) = -0.5.
//@ expect-stdout: MATH_PURE_ATAN_2507_PASS
use math::pure::{atan}

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    if d < 0.0 { return 0.0 - d < tol }
    return d < tol
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    var bad: i64 = 0
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let x = xm.value
    // pi/4, and atan''(1) = -2x/(1+x^2)^2 = -0.5
    if !near(atan(x), 0.7853981633974483, 1.0e-15) { print("FAIL atan(1)\n"); bad = bad + 1 }
    if !near(hessian_of(atan(x), 0, 0), 0.0 - 0.5, 1.0e-9) { print("FAIL hessian atan(1)\n"); bad = bad + 1 }
    // Values on both sides of the tan(pi/8) and 1.0 reduction boundaries.
    if !near(atan(0.4), 0.3805063771123649, 1.0e-15) { print("FAIL atan(0.4)\n"); bad = bad + 1 }
    if !near(atan(0.5), 0.4636476090008061, 1.0e-15) { print("FAIL atan(0.5)\n"); bad = bad + 1 }
    if !near(atan(0.9), 0.7328151017865066, 1.0e-15) { print("FAIL atan(0.9)\n"); bad = bad + 1 }
    if !near(atan(0.0 - 0.7), 0.0 - 0.6107259643892086, 1.0e-15) { print("FAIL atan(-0.7)\n"); bad = bad + 1 }
    if !near(atan(1.1), 0.8329812666744317, 1.0e-15) { print("FAIL atan(1.1)\n"); bad = bad + 1 }
    if !near(atan(2.0), 1.1071487177940904, 1.0e-15) { print("FAIL atan(2)\n"); bad = bad + 1 }
    if bad == 0 { print("MATH_PURE_ATAN_2507_PASS\n") } else { print("MATH_PURE_ATAN_2507_FAIL\n") }
}
