//@ run-pass
// Test: confidence-gated code emission with runtime counter.
// The fn call result has unknown confidence, making downstream ops guarded.

fn uncertain_value(x: i64) -> i64 with Mut {
    return x * 2
}

fn main() with IO, Mut, Panic {
    let a = uncertain_value(21)
    let b = a + 10
    let c = b * 3
    let d = c - a
    print("gate test: ")
    print_int(d)
    print("\n")
}
