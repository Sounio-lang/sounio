//@ requires: madaros
//@ description: Imported portfolio v38 smoke for Lorenz i256 projection dependency-DAG entry

use theorem::portfolio::*

fn main() -> i64 {
    let audit_fp = solver_portfolio_v38_lorenz_i256_projection_dependency_dag_audit_fingerprint(
        713010204, 77888110, 245178976, 214180161,
        63872871, 547731575, 916832909,
        116461241, 775818863, 585753742,
        44126209, 297819393, 189652817,
        836439604, 127)
    if audit_fp != 725222703 { return 1 }

    let manifest_fp = solver_portfolio_v38_lorenz_i256_projection_dependency_dag_bundle_fingerprint(
        713010204, audit_fp)
    if manifest_fp != 731723710 { return 2 }

    let result_fp = solver_portfolio_v38_result_coverage_fingerprint(
        38, 42, 10, 30, 1, 1, manifest_fp)
    if result_fp != 165972953 { return 3 }

    let family_fp = solver_portfolio_v38_checker_family_coverage_fingerprint(
        38, 42, 6, 3, 2, 2, 29, manifest_fp)
    if family_fp != 160480532 { return 4 }

    let acceptance_fp = solver_portfolio_v38_acceptance_receipt_fingerprint(
        38, manifest_fp, result_fp)
    if acceptance_fp != 686410113 { return 5 }

    let audit_receipt_fp = solver_portfolio_v38_audit_receipt_fingerprint(
        38, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 87146991 { return 6 }

    let readiness_fp = solver_portfolio_v38_readiness_fingerprint(
        38, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 845057161 { return 7 }

