//@ run-pass
//@ expect-stdout-contains: heap_vec_pattern: PASS
//@ description: growable vec pattern using heap_alloc + write_i64 + read_i64 + heap_realloc

fn main() with IO, Alloc {
    // Simulate a growable i64 vec: alloc, push, grow, push more, verify
    var cap: i64 = 4
    var len: i64 = 0
    var data = heap_alloc(cap * 8)

    // Push 0..7
    var i: i64 = 0
    while i < 8 {
        if len >= cap {
            cap = cap * 2
            data = heap_realloc(data, cap * 8)
        }
        write_i64(data, len, i * 10)
        len = len + 1
        i = i + 1
    }

    // Verify
    var ok: i64 = 1
    i = 0
    while i < 8 {
        let v = read_i64(data, i)
        if v != i * 10 { ok = 0 }
        i = i + 1
    }

    if ok == 1 {
        print("heap_vec_pattern: PASS\n")
    } else {
        print("heap_vec_pattern: FAIL\n")
    }

    heap_free(data)
}
