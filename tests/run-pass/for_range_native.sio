//@ run-pass
//@ contract-adjustment: native range-for lane requires explicit Mut for accumulator updates
fn main() -> i32 with Mut {
    var sum: i64 = 0
    for i in 0..5 {
        sum = sum + i
    }
    if sum != 10 { return 1 }

    var sum2: i64 = 0
    for i in 0..=5 {
        sum2 = sum2 + i
    }
    if sum2 != 15 { return 2 }

    return 0
}
