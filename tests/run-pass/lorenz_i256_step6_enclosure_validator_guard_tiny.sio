//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 enclosure validator guard checks explicit inclusion masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 593
    fp = mix(fp, 6, 4073)
    fp = mix(fp, 975464919, 4073)
    fp = mix(fp, 376630542, 4073)
    fp = mix(fp, 641464796, 4073)
    fp = mix(fp, 516981885, 4073)
    fp = mix(fp, 652877359, 4073)
    fp = mix(fp, 1000000, 4073)
    fp = mix(fp, 299663, 4073)
    fp = mix(fp, 389292, 4073)
    fp = mix(fp, 54009, 4073)
    fp = mix(fp, 243366, 4073)
    fp = mix(fp, 319640, 4073)
    fp = mix(fp, 42448, 4073)
    fp = mix(fp, 47276, 4073)
    fp = mix(fp, 66549, 4073)
    fp = mix(fp, 12083, 4073)
    fp = mix(fp, 3, 4073)
    fp = mix(fp, 4, 4073)
    fp = mix(fp, 0, 4073)
    fp = mix(fp, 8, 4073)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 898897987 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 599
    fp = mix(fp, instance, 4079)
    fp = mix(fp, 290642, 4079)
    fp = mix(fp, 386189, 4079)
    fp = mix(fp, 54531, 4079)
    fp = mix(fp, 299663, 4079)
    fp = mix(fp, 389292, 4079)
    fp = mix(fp, 54009, 4079)
    fp = mix(fp, 3, 4079)
    fp = mix(fp, 4, 4079)
    fp = mix(fp, 0, 4079)
    fp = mix(fp, 8, 4079)
    fp = mix(fp, ok_mask, 4079)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 898897987 { return 0 - 1 }
    if certificate != 851507956 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 601
    fp = mix(fp, instance, 4091)
    fp = mix(fp, certificate, 4091)
    fp = mix(fp, 9, 4091)
    fp = mix(fp, 6, 4091)
    fp = mix(fp, 3, 4091)
    fp = mix(fp, 4, 4091)
    fp = mix(fp, 0, 4091)
    fp = mix(fp, 8, 4091)
    fp = mix(fp, ok_mask, 4091)
    return fp
}

fn guard_mask() -> i64 {
    let x_margin: i64 = 299663
    let y_margin: i64 = 389292
    let z_margin: i64 = 54009
    let x_need: i64 = 243366 + 47276
    let y_need: i64 = 319640 + 66549
    let z_need: i64 = 42448 + 12083
    let validated_mask: i64 = 0
    let status: i64 = 8

    var pass_mask: i64 = 0
    if x_need <= x_margin { pass_mask = pass_mask + 1 }
    if y_need <= y_margin { pass_mask = pass_mask + 2 }
    if z_need <= z_margin { pass_mask = pass_mask + 4 }

    var fail_mask: i64 = 0
    if x_need > x_margin { fail_mask = fail_mask + 1 }
    if y_need > y_margin { fail_mask = fail_mask + 2 }
    if z_need > z_margin { fail_mask = fail_mask + 4 }

    var ok_mask: i64 = 0
    if 975464919 > 0 { ok_mask = ok_mask + 1 }
    if x_margin == 299663 {
        if z_need == 54531 { ok_mask = ok_mask + 2 }
    }
    if pass_mask == 3 {
        if fail_mask == 4 { ok_mask = ok_mask + 4 }
    }
    if fail_mask != 0 {
        if validated_mask == 0 { ok_mask = ok_mask + 8 }
    }
    if z_need - z_margin == 522 { ok_mask = ok_mask + 16 }
    if y_need == 386189 { ok_mask = ok_mask + 32 }
    if validated_mask == 0 {
        if fail_mask == 4 { ok_mask = ok_mask + 64 }
    }
    if status == 8 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = guard_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 898897987 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 851507956 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 367562376 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
