//@ run-pass
// gpu_launch_surface.sio - public GPU launch surface accepted by the checked GPU artifact
//
// This fixture captures the GPU syntax that is currently public in the checked
// GPU profile:
// - `kernel fn`
// - `with GPU`
// - `perform GPU.launch(...)`
// - `perform GPU.sync()`
//
// It intentionally avoids `gpu.thread_id` and `gpu.alloc`, which are still
// source-tree/runtime surfaces rather than checked public artifact syntax.

kernel fn vec_add(n: i64) with GPU {
}

kernel fn scale_vector(factor: f64, n: i64) with GPU, Div {
}

fn main() with GPU, IO, Div {
    let n: i64 = 1024
    let grid = (16, 1, 1)
    let block = (64, 1, 1)

    perform GPU.launch(vec_add, grid, block)(n)
    perform GPU.launch(scale_vector, grid, block)(2.0, n)
    perform GPU.sync()
}
