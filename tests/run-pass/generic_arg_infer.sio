//@ run-pass
//@ expect-stdout-contains: infer_i64: PASS
//@ expect-stdout-contains: infer_wrap_i64: PASS
//@ expect-stdout-contains: turbofish_compat: PASS
// Generic type argument inference — requires rebuilt souc binary (feature in lean_single.sio only).
// To test manually: ./bin/souc run self-hosted/compiler/lean_single.sio -- <this_file> /tmp/out.elf
// identity(42) should infer T=i64; identity(3.14) should infer T=f64.
// No turbofish annotation required when the first argument is a literal.

fn identity<T>(x: T) -> T {
    x
}

fn wrap_value<T>(a: T, b: i64) -> T {
    a
}

fn main() with IO {
    // Infer i64 from integer literal
    let a = identity(42)
    if a == 42 {
        print("infer_i64: PASS\n")
    } else {
        print("infer_i64: FAIL\n")
    }

    // Infer i64 from wrap_value first arg
    let b = wrap_value(7, 99)
    if b == 7 {
        print("infer_wrap_i64: PASS\n")
    } else {
        print("infer_wrap_i64: FAIL\n")
    }

    // Explicit turbofish still works alongside inference
    let c = identity::<i64>(100)
    if c == 100 {
        print("turbofish_compat: PASS\n")
    } else {
        print("turbofish_compat: FAIL\n")
    }
}
