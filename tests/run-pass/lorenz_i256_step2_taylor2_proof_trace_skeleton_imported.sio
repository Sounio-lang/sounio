//@ description: Imported Lorenz i256 step-2 Taylor-2 proof-trace skeleton checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step2_taylor2_proof_trace_skeleton_check(
        725374434, 482555681, 554654324, 443171640, 444092349, 15, 15, 5, 0)
    if artifact_fp != 976546207 { return 1 }
    let audit_fp = lorenz_i256_step2_taylor2_proof_trace_skeleton_audit_fingerprint(
        artifact_fp, 865392417, 259997489, 725374434, 571048339, 2, 2, 255, 0, 0)
    if audit_fp != 892326627 { return 2 }
    return 0
}
