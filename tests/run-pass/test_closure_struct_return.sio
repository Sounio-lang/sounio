//@ run-pass
//@ expect-stdout: closure sret ok
struct Point { x: i64, y: i64 }

fn sum_point(p: Point) -> i64 {
    p.x + p.y
}

fn main() -> i32 with IO, Panic {
    let bias = 10
    let make = |x: i64| -> Point {
        Point { x: x + bias, y: x + bias + 1 }
    }

    let a = make(1)
    let b = make(5)
    assert(a.x == 11)
    assert(a.y == 12)
    assert(b.x == 15)
    assert(b.y == 16)

    let nested = make(make(2).y)
    assert(nested.x == 23)
    assert(nested.y == 24)

    let total = sum_point(make(7))
    assert(total == 35)

    print("closure sret ok\n")
    0
}
