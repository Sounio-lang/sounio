//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2-to-step-3 local-flowpipe bridge keeps global claim closed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let proof_mask: i64 = 15
    let seed_mask: i64 = 15
    let chain_mask: i64 = 15
    var bridge_mask: i64 = 0
    bridge_mask = bridge_mask + 1
    bridge_mask = bridge_mask + 2
    bridge_mask = bridge_mask + 4
    bridge_mask = bridge_mask + 8
    if bridge_mask != 15 { return 1 }

    var extension_mask: i64 = 0
    if proof_mask == 15 { extension_mask = extension_mask + 1 }
    if seed_mask == 15 { extension_mask = extension_mask + 2 }
    if chain_mask == 15 { extension_mask = extension_mask + 4 }
    if bridge_mask == 15 { extension_mask = extension_mask + 8 }
    if extension_mask != 15 { return 2 }

    let global_claim_mask: i64 = 0
    let status: i64 = 23
    let ok_mask: i64 = 255
    if global_claim_mask != 0 { return 3 }

    var inst: i64 = 1609
    inst = mix(inst, 418029869, 5483)
    inst = mix(inst, 518930343, 5483)
    inst = mix(inst, 633359277, 5483)
    inst = mix(inst, 421619310, 5483)
    inst = mix(inst, 335080767, 5483)
    inst = mix(inst, 899209716, 5483)
    inst = mix(inst, 249889958, 5483)
    inst = mix(inst, 603078026, 5483)
    inst = mix(inst, 2, 5483)
    inst = mix(inst, 2, 5483)
    inst = mix(inst, 3, 5483)
    inst = mix(inst, 256, 5483)
    inst = mix(inst, 32, 5483)
    inst = mix(inst, 1, 5483)
    inst = mix(inst, 100, 5483)
    inst = mix(inst, 4294967296, 5483)
    inst = mix(inst, 5411658768, 5483)
    inst = mix(inst, 4223384510, 5483)
    inst = mix(inst, 4406636440, 5483)
    inst = mix(inst, 6517899153, 5483)
    inst = mix(inst, 4164877513, 5483)
    inst = mix(inst, proof_mask, 5483)
    inst = mix(inst, seed_mask, 5483)
    inst = mix(inst, chain_mask, 5483)
    inst = mix(inst, bridge_mask, 5483)
    inst = mix(inst, extension_mask, 5483)
    inst = mix(inst, global_claim_mask, 5483)
    inst = mix(inst, status, 5483)
    if inst != 991315838 { return 4 }

    var cert: i64 = 1613
    cert = mix(cert, inst, 5501)
    cert = mix(cert, proof_mask, 5501)
    cert = mix(cert, seed_mask, 5501)
    cert = mix(cert, chain_mask, 5501)
    cert = mix(cert, bridge_mask, 5501)
    cert = mix(cert, extension_mask, 5501)
    cert = mix(cert, global_claim_mask, 5501)
    cert = mix(cert, status, 5501)
    cert = mix(cert, 2, 5501)
    cert = mix(cert, 2, 5501)
    cert = mix(cert, 3, 5501)
    cert = mix(cert, 256, 5501)
    cert = mix(cert, 32, 5501)
    cert = mix(cert, 1, 5501)
    cert = mix(cert, 100, 5501)
    cert = mix(cert, ok_mask, 5501)
    if cert != 951485822 { return 5 }

    var artifact: i64 = 1619
    artifact = mix(artifact, inst, 5503)
    artifact = mix(artifact, cert, 5503)
    artifact = mix(artifact, 17, 5503)
    artifact = mix(artifact, 2, 5503)
    artifact = mix(artifact, 2, 5503)
    artifact = mix(artifact, 3, 5503)
    artifact = mix(artifact, proof_mask, 5503)
    artifact = mix(artifact, bridge_mask, 5503)
    artifact = mix(artifact, extension_mask, 5503)
    artifact = mix(artifact, global_claim_mask, 5503)
    artifact = mix(artifact, status, 5503)
    artifact = mix(artifact, ok_mask, 5503)
    if artifact != 158202075 { return 6 }

    var audit: i64 = 1621
    audit = mix(audit, artifact, 5507)
    audit = mix(audit, inst, 5507)
    audit = mix(audit, cert, 5507)
    audit = mix(audit, 418029869, 5507)
    audit = mix(audit, 518930343, 5507)
    audit = mix(audit, 633359277, 5507)
    audit = mix(audit, 421619310, 5507)
    audit = mix(audit, 335080767, 5507)
    audit = mix(audit, 899209716, 5507)
    audit = mix(audit, 249889958, 5507)
    audit = mix(audit, 603078026, 5507)
    audit = mix(audit, 2, 5507)
    audit = mix(audit, 2, 5507)
    audit = mix(audit, 3, 5507)
    audit = mix(audit, status, 5507)
    audit = mix(audit, ok_mask, 5507)
    if audit != 952956886 { return 7 }
    return 0
}
