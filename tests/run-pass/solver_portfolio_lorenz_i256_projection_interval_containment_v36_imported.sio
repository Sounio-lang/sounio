//@ description: Imported portfolio v36 smoke for Lorenz i256 projection interval-containment entry

use theorem::portfolio::*

fn main() -> i64 {
    let audit_fp = solver_portfolio_v36_lorenz_i256_projection_interval_containment_audit_fingerprint(
        310218620, 192258040, 80894555, 890086395, 69322697, 31)
    if audit_fp != 501185861 { return 1 }

    let manifest_fp = solver_portfolio_v36_lorenz_i256_projection_interval_containment_bundle_fingerprint(
        310218620, audit_fp)
    if manifest_fp != 622328210 { return 2 }

    let result_fp = solver_portfolio_v36_result_coverage_fingerprint(
        36, 40, 10, 28, 1, 1, manifest_fp)
    if result_fp != 130539653 { return 3 }

    let family_fp = solver_portfolio_v36_checker_family_coverage_fingerprint(
        36, 40, 6, 3, 2, 2, 27, manifest_fp)
    if family_fp != 714353724 { return 4 }

    let acceptance_fp = solver_portfolio_v36_acceptance_receipt_fingerprint(
        36, manifest_fp, result_fp)
    if acceptance_fp != 649832602 { return 5 }

    let audit_receipt_fp = solver_portfolio_v36_audit_receipt_fingerprint(
        36, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 86586813 { return 6 }

    let readiness_fp = solver_portfolio_v36_readiness_fingerprint(
        36, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 19419291 { return 7 }

    return 0
}
