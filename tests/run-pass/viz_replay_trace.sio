//@ run-pass
// tests/run-pass/viz_replay_trace.sio - replay timeline proof
//
// Expected output:
//   VIZ_REPLAY_TRACE_PASS

use display::canvas::{Canvas}
use display::event::{Event, EV_KEY_PRESS, EV_MOUSE_PRESS, EV_MOUSE_RELEASE, EV_MOTION, KEY_TAB, KEY_SPACE, MOUSE_LEFT}
use viz::ir::{
    VizScene, viz_scene_new, viz_layout_rect, viz_style_rgb,
    viz_add_slider, viz_add_toggle, viz_scene_set_tag,
}
use viz::audit::{viz_audit_hash}
use viz::viz_app::{viz_app_new}
use viz::viz_replay::{viz_replay_trace_events}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn build_scene() -> VizScene with Mut {
    var scene = viz_scene_new()
    let slider = viz_add_slider(&!scene, viz_layout_rect(16, 16, 120, 18), 0.0, 0.0, 10.0, viz_style_rgb(90, 190, 255))
    let toggle = viz_add_toggle(&!scene, viz_layout_rect(152, 16, 26, 18), false, viz_style_rgb(120, 220, 150))
    viz_scene_set_tag(&!scene, slider, 5101)
    viz_scene_set_tag(&!scene, toggle, 5102)
    scene
}

fn main() with IO, Alloc, Mut, Div {
    var events: [Event; 32] = [ev(0, 0, 0, 0); 32]
    events[0] = ev(EV_MOUSE_PRESS, MOUSE_LEFT, 16, 24)
    events[1] = ev(EV_MOTION, 0, 76, 24)
    events[2] = ev(EV_MOUSE_RELEASE, MOUSE_LEFT, 76, 24)
    events[3] = ev(EV_KEY_PRESS, KEY_TAB, 0, 0)
    events[4] = ev(EV_MOTION, 0, 164, 24)
    events[5] = ev(EV_KEY_PRESS, KEY_SPACE, 0, 0)

    var scene = build_scene()
    var app = viz_app_new(8, 12, 18)
    var canvas = make_canvas(220, 64)
    let trace = viz_replay_trace_events(&!app, &!scene, &!canvas, &events, 6)

    assert(trace.count == 7)
    assert(trace.frames[0].frame == 1)
    assert(trace.frames[1].event_kind == EV_MOUSE_PRESS)
    assert(trace.frames[2].time_i == 5)
    assert(trace.frames[6].event_key == KEY_SPACE)
    assert(trace.frames[6].focused_node == 1)
    assert(trace.frames[6].selected_node < 0)
    assert(trace.frames[6].hovered_node == 1)
    assert(trace.frames[6].audit_hash == viz_audit_hash(&scene))
    assert(trace.frames[6].canvas_hash != trace.frames[0].canvas_hash)
    assert(scene.nodes[1].value == 1.0)

    heap_free(canvas.pixels as *mut i8)
    println("VIZ_REPLAY_TRACE_PASS")
}
