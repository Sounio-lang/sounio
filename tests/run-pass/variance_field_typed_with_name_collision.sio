//@ run-pass
//@ requires: madaros
//@ expect-stdout: VARIANCE_FIELD_TYPED_OK
// variance_of over a struct field must find the field in the receiver's own
// type. Madaros looked it up by name in the first struct declaring such a
// field: with the unrelated `struct X` below, `val` resolved to X's offset
// (8), which holds `other` = 0.0, so variance_of(s.val) printed 0.000000
// instead of 0.25 and the program exited 0. The same held for a nested
// chain (`o.inner.v` with X declaring `inner`). lean_single printed 0.25.
struct X { pad: f64, val: f64, inner: f64 }
struct Tbl { val: f64, other: f64 }
struct Inner { v: f64 }
struct Outer { inner: Inner, other: f64 }

fn main() with IO, Epistemic {
    let k: Knowledge<f64> = measure(10.0, uncertainty: 0.5)
    let s = Tbl { val: k.value, other: 0.0 }
    let v1 = variance_of(s.val)
    let o = Outer { inner: Inner { v: k.value }, other: 0.0 }
    let x = o.inner.v
    let v2 = variance_of(x)
    let d1 = v1 - 0.25
    let d2 = v2 - 0.25
    if d1 * d1 < 1.0e-18 && d2 * d2 < 1.0e-18 {
        println("VARIANCE_FIELD_TYPED_OK")
    } else {
        print("VARIANCE_FIELD_TYPED_FAIL v1=")
        print_f64(v1)
        print(" v2=")
        print_f64(v2)
        print("\n")
    }
}
