//@ run-pass
//@ requires: lean_single
//@ expect-stdout-contains: SEP: PASS
//@ description: ADR-015 row 8 (probes int_sep, flt_sep) -- `_` is a digit separator between two digits, in decimal and hex integers and in the integer part, fraction and exponent of a float. lean_single used to read `1_000_000` as `1` and an identifier `_000_000`.

fn main() with IO {
    var ok: i64 = 1
    if 1_000_000 != 1000000 { ok = 0 }
    if 0xFF_FF != 65535 { ok = 0 }
    if 9_223_372_036_854_775_807 != 9223372036854775807 { ok = 0 }
    let f: f64 = 1_000.000_5
    if f != 1000.0005 { ok = 0 }
    let g: f64 = 1_0e1_0
    if g != 1.0e11 { ok = 0 }
    if ok == 1 { print("SEP: PASS\n") } else { print("SEP: FAIL\n") }
}
