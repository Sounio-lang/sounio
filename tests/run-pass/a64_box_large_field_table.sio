//@ run-pass
//@ expect-stdout: 77
//@ description: by-value method preserves boxed array writes at offsets beyond 64 KiB
struct WideSlots { pad: [i64; 8192], keys: [i64; 4], values: [i64; 4] }
struct WideTable { slots: Box<WideSlots>, count: i64 }
impl WideTable {
    fn set(self, k: i64, v: i64) -> WideTable with Mut, Panic {
        var t = self
        (*t.slots).keys[t.count as usize] = k
        (*t.slots).values[t.count as usize] = v
        t.count = t.count + 1
        t
    }
    fn get(self, k: i64) -> i64 with Mut, Panic {
        var i: i64 = 0
        while i < self.count {
            if (*self.slots).keys[i as usize] == k { return (*self.slots).values[i as usize] }
            i = i + 1
        }
        -1
    }
}
fn main() with IO, Mut, Panic, Alloc {
    var t = WideTable { slots: Box::new(WideSlots { pad: [0; 8192], keys: [0; 4], values: [0; 4] }), count: 0 }
    t = t.set(1048576, 77)
    print_int(t.get(1048576))
    print("\n")
}
