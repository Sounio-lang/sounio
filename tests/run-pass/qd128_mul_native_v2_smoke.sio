//@ run-pass
//@ smoke: math::qd128::qd_mul under default Madaros native-v2
use math::qd128::{qd_from_f64, qd_mul, qd_to_f64}

fn main() -> i32 with IO, Mut, Panic {
    let a = qd_from_f64(2.0)
    let b = qd_from_f64(3.0)
    let p = qd_mul(a, b)
    let v = qd_to_f64(p)
    if v == 6.0 {
        println("QD128_MUL_NATIVE_V2 PASS")
        return 0
    }
    1
}
