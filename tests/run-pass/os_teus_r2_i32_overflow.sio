//@ run-pass
// R2 narrow-integer witness: i32 2000000000 + 2000000000 must wrap to
// -294967296 (4000000000 - 2^32 = -294967296).

fn main() with IO, Div, Panic {
    let x: i32 = 2000000000 + 2000000000
    if x == 0 - 294967296 {
        print("r2_i32_overflow: PASS\n")
    } else {
        print("r2_i32_overflow: FAIL got=")
        print_int(x)
        print("\n")
    }
}
