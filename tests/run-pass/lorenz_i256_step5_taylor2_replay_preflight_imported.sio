//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-5 Taylor-2 replay preflight checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step5_taylor2_replay_preflight_check(
        971755585, 989883403, 15, 15, 15, 15, 6, 0)
    if artifact_fp != 847188269 { return 1 }
    let audit_fp = lorenz_i256_step5_taylor2_replay_preflight_audit_fingerprint(
        artifact_fp, 282143781, 396051824, 971755585, 205079086, 5, 6, 255, 0, 0)
    if audit_fp != 425385087 { return 2 }
    return 0
}
