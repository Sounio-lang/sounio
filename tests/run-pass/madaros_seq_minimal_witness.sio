//@ run-pass
//@ expect-stdout-contains: PASS
//@ description: Minimal Seq surface witness — seq_new, .push, .count, index, acknowledge.
// Pre-fix (Madaros check): E137 seq_new / E011 methods / E013 index / E137 acknowledge.
// lean_single: check+run PASS (engine divergence — Seq is lean-only language surface).
// Post-fix target: Madaros check verdict=0 on this file (check path first).

fn main() -> i64 with IO, Alloc, Mut, Epistemic, Div, Panic {
    var exit_fails: i64 = 0
    var s: Seq<i64> = seq_new()
    s.push(10)
    s.push(20)
    let n: i64 = s.count()
    let a: i64 = s[0]
    let b: i64 = s[1]
    if n != 2 {
        println("FAIL count")
        return 1
    }
    if a != 10 {
        println("FAIL idx0")
        return 1
    }
    if b != 20 {
        println("FAIL idx1")
        return 1
    }

    var obs: Seq<Knowledge<f64>> = seq_new()
    obs.push(measure(12.4, uncertainty: 7.4))
    obs.push(measure(10.8, uncertainty: 3.0))
    let k0: Knowledge<f64> = obs[0]
    let v: f64 = acknowledge(k0, "witness elem")
    if v < 12.0 {
        println("FAIL acknowledge")
        return 1
    }
    if v > 13.0 {
        println("FAIL acknowledge")
        return 1
    }
    println("PASS")
    if exit_fails > 0 {
        return 1
    }
    return 0
}
