//@ run-pass
// Madaros Root 2: associated Type::method + same-module &self method calls.
// Note: chaining s.get() after s = a.add(&b) still SEGV at lower seed (residual);
// free helper used for the sum field read.
// Multi-module instance method remains residual — see gate.

pub struct E {
    v: f64,
}

impl E {
    pub fn of(v: f64) -> E {
        E { v: v }
    }
    pub fn get(self: &E) -> f64 {
        self.v
    }
    pub fn add(self: &E, other: &E) -> E {
        E { v: self.v + other.v }
    }
}

fn e_val(e: &E) -> f64 {
    e.v
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let a = E::of(3.0)
    let b = E::of(4.0)
    let va = a.get()
    let vb = b.get()
    if va < 2.5 || va > 3.5 { print("FAIL_A\n"); return 1 }
    if vb < 3.5 || vb > 4.5 { print("FAIL_B\n"); return 2 }
    let s = a.add(&b)
    let vs = e_val(&s)
    if vs < 6.5 || vs > 7.5 { print("FAIL_SUM\n"); return 3 }
    print("ROOT2_METHOD_ASSOCIATED_OK\n")
    return 0
}
