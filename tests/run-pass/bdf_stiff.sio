fn main() -> i64 with IO, Mut, Panic, Div {
    println("=== BDF Stiff ODE Solver Tests ===")
    println("")

    var passed: i64 = 0
    var failed: i64 = 0

    // Test 1
    print("Test 1: Exponential decay (y'=-1000y)... ")
    if test_exponential_decay() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 2
    print("Test 2: Robertson conservation... ")
    if test_robertson_conservation() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 3
    print("Test 3: Linear stiff 2x2... ")
    if test_linear_stiff() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 4
