//@ run-pass
// BDF Stiff ODE Solver Integration Tests
//
// Validates the BDF (Backward Differentiation Formula) implicit solver
// for stiff ordinary differential equations. BDF methods are the standard
// for stiff systems arising in chemical kinetics, PBPK models, and
// electrical circuits.
//
// References:
//   Hairer, Wanner (1996) "Solving ODEs II: Stiff Problems"
//   Robertson (1966) "The solution of a set of reaction rate equations"

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
}

// ============================================================================
// HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a }
    return b
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

fn sqrt_f64(x: f64) -> f64 {
    if x <= 0.0 { return 0.0 }
    return sqrt(x)
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

struct BDFState {
    y: [f64; 8],
    t: f64,
    dt: f64,
    dt_max: f64,
    n_eqs: i64,
    y_prev1: [f64; 8],
    y_prev2: [f64; 8],
    y_prev3: [f64; 8],
    n_history: i64,
    order: i64,
    max_order: i64,
    n_steps: i64,
    n_function_evals: i64,
    n_jac_evals: i64,
    atol: f64,
    rtol: f64,
    newton_tol: f64,
    max_newton_iter: i64,
    last_accepted: i64
}

struct BDFResult {
    t_final: f64,
    y_final: [f64; 8],
    n_steps: i64,
    n_accepted: i64,
    n_rejected: i64,
    n_function_evals: i64,
    n_jac_evals: i64,
    success: i64
}

struct BDFTrajectory {
    times: [f64; 256],
    states: [f64; 2048],
    n_points: i64,
    n_eqs: i64
}

struct NewtonResult {
    converged: i64,
    iters: i64,
    fevals: i64,
    jevals: i64,
    y: [f64; 8]
}

struct BDFStepResult {
    new_state: BDFState,
    accepted: i64
}

// ============================================================================
// RHS FUNCTIONS
// ============================================================================

fn rhs_exponential_decay(t: f64, y: [f64; 8], n: i64, dydt: [f64; 8]) -> [f64; 8] with Mut, Panic, Div {
    var out: [f64; 8] = dydt
    out[0] = 0.0 - 1000.0 * y[0]
    var k: i64 = 1
    while k < 8 {
        out[k] = 0.0
        k = k + 1
    }
    return out
}

fn rhs_robertson(t: f64, y: [f64; 8], n: i64, dydt: [f64; 8]) -> [f64; 8] with Mut, Panic, Div {
    var out: [f64; 8] = dydt
    out[0] = 0.0 - 0.04 * y[0] + 10000.0 * y[1] * y[2]
    out[1] = 0.04 * y[0] - 10000.0 * y[1] * y[2] - 30000000.0 * y[1] * y[1]
    out[2] = 30000000.0 * y[1] * y[1]
    var k: i64 = 3
    while k < 8 {
        out[k] = 0.0
        k = k + 1
    }
    return out
}

fn rhs_van_der_pol(t: f64, y: [f64; 8], n: i64, dydt: [f64; 8]) -> [f64; 8] with Mut, Panic, Div {
    var out: [f64; 8] = dydt
    let mu = 1000.0
    out[0] = y[1]
    out[1] = mu * (1.0 - y[0] * y[0]) * y[1] - y[0]
    var k: i64 = 2
    while k < 8 {
        out[k] = 0.0
        k = k + 1
    }
    return out
}

fn rhs_linear_stiff(t: f64, y: [f64; 8], n: i64, dydt: [f64; 8]) -> [f64; 8] with Mut, Panic, Div {
    var out: [f64; 8] = dydt
    out[0] = 0.0 - 1000.0 * y[0]
    out[1] = 0.0 - 1.0 * y[1]
    var k: i64 = 2
    while k < 8 {
        out[k] = 0.0
        k = k + 1
    }
    return out
}

fn eval_rhs(fn_id: i64, t: f64, y: [f64; 8], n: i64) -> [f64; 8] with Mut, Panic, Div {
    var dydt: [f64; 8] = [0.0; 8]
    if fn_id == 0 {
        return rhs_exponential_decay(t, y, n, dydt)
    }
    if fn_id == 1 {
        return rhs_robertson(t, y, n, dydt)
    }
    if fn_id == 2 {
        return rhs_van_der_pol(t, y, n, dydt)
    }
    if fn_id == 3 {
        return rhs_linear_stiff(t, y, n, dydt)
    }
    return dydt
}

// ============================================================================
// GAUSSIAN ELIMINATION
// ============================================================================

fn gauss_solve_8(a: [f64; 64], b: [f64; 8], n: i64) -> [f64; 8] with Mut, Panic, Div {
    var aa: [f64; 64] = a
    var bb: [f64; 8] = b
    var x: [f64; 8] = [0.0; 8]

    var col: i64 = 0
    while col < n {
        var max_val: f64 = abs_f64(aa[col * 8 + col])
        var max_row: i64 = col
        var row: i64 = col + 1
        while row < n {
            let val = abs_f64(aa[row * 8 + col])
            if val > max_val {
                max_val = val
                max_row = row
            }
            row = row + 1
        }

        if max_row != col {
            var k: i64 = 0
            while k < n {
                let tmp_a = aa[col * 8 + k]
                aa[col * 8 + k] = aa[max_row * 8 + k]
                aa[max_row * 8 + k] = tmp_a
                k = k + 1
            }
            let tmp_b = bb[col]
            bb[col] = bb[max_row]
            bb[max_row] = tmp_b
        }

        let pivot = aa[col * 8 + col]
        if abs_f64(pivot) < 1.0e-30 {
            return x
        }

        row = col + 1
        while row < n {
            let factor = aa[row * 8 + col] / pivot
            var k: i64 = col + 1
            while k < n {
                aa[row * 8 + k] = aa[row * 8 + k] - factor * aa[col * 8 + k]
                k = k + 1
            }
            aa[row * 8 + col] = 0.0
            bb[row] = bb[row] - factor * bb[col]
            row = row + 1
        }
        col = col + 1
    }

    var i: i64 = n - 1
    while i >= 0 {
        var sum: f64 = bb[i]
        var j: i64 = i + 1
        while j < n {
            sum = sum - aa[i * 8 + j] * x[j]
            j = j + 1
        }
        let diag = aa[i * 8 + i]
        if abs_f64(diag) < 1.0e-30 {
            x[i] = 0.0
        } else {
            x[i] = sum / diag
        }
        i = i - 1
    }

    return x
}

// ============================================================================
// BDF PREDICTORS
// ============================================================================

fn bdf1_predict(state: BDFState) -> [f64; 8] with Mut, Panic, Div {
    var y_pred: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < state.n_eqs {
        y_pred[i] = state.y[i]
        i = i + 1
    }
    return y_pred
}

fn bdf2_predict(state: BDFState) -> [f64; 8] with Mut, Panic, Div {
    var y_pred: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < state.n_eqs {
        y_pred[i] = 2.0 * state.y[i] - state.y_prev1[i]
        i = i + 1
    }
    return y_pred
}

fn bdf3_predict(state: BDFState) -> [f64; 8] with Mut, Panic, Div {
    var y_pred: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < state.n_eqs {
        y_pred[i] = 3.0 * state.y[i] - 3.0 * state.y_prev1[i] + state.y_prev2[i]
        i = i + 1
    }
    return y_pred
}

fn bdf4_predict(state: BDFState) -> [f64; 8] with Mut, Panic, Div {
    var y_pred: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < state.n_eqs {
        y_pred[i] = 4.0 * state.y[i] - 6.0 * state.y_prev1[i]
                     + 4.0 * state.y_prev2[i] - state.y_prev3[i]
        i = i + 1
    }
    return y_pred
}

// ============================================================================
// BDF COEFFICIENTS
// ============================================================================

fn bdf_beta(order: i64) -> f64 with Panic {
    if order == 1 { return 1.0 }
    if order == 2 { return 2.0 / 3.0 }
    if order == 3 { return 6.0 / 11.0 }
    if order == 4 { return 12.0 / 25.0 }
    return 1.0
}

// Error constant for BDF-k (Gear's formula)
// BDF-1: 1/2, BDF-2: 2/9, BDF-3: 3/22, BDF-4: 12/125
fn bdf_error_constant(order: i64) -> f64 with Panic {
    if order == 1 { return 0.5 }
    if order == 2 { return 2.0 / 9.0 }
    if order == 3 { return 3.0 / 22.0 }
    if order == 4 { return 12.0 / 125.0 }
    return 0.5
}

fn bdf_history_sum(state: BDFState, order: i64) -> [f64; 8] with Mut, Panic, Div {
    var s: [f64; 8] = [0.0; 8]
    var i: i64 = 0

    if order == 1 {
        while i < state.n_eqs {
            s[i] = state.y[i]
            i = i + 1
        }
    } else if order == 2 {
        while i < state.n_eqs {
            s[i] = (4.0 / 3.0) * state.y[i] - (1.0 / 3.0) * state.y_prev1[i]
            i = i + 1
        }
    } else if order == 3 {
        while i < state.n_eqs {
            s[i] = (18.0 / 11.0) * state.y[i]
                 - (9.0 / 11.0) * state.y_prev1[i]
                 + (2.0 / 11.0) * state.y_prev2[i]
            i = i + 1
        }
    } else {
        while i < state.n_eqs {
            s[i] = (48.0 / 25.0) * state.y[i]
                 - (36.0 / 25.0) * state.y_prev1[i]
                 + (16.0 / 25.0) * state.y_prev2[i]
                 - (3.0 / 25.0) * state.y_prev3[i]
            i = i + 1
        }
    }
    return s
}

// ============================================================================
// JACOBIAN
// ============================================================================

fn compute_jacobian(fn_id: i64, t: f64, y: [f64; 8], n: i64, f0: [f64; 8]) -> [f64; 64] with Mut, Panic, Div {
    var jac: [f64; 64] = [0.0; 64]
    let eps = 1.0e-8

    var j: i64 = 0
    while j < n {
        var y_pert: [f64; 8] = y
        let delta = eps * max_f64(abs_f64(y[j]), 1.0)
        y_pert[j] = y[j] + delta

        let f_pert = eval_rhs(fn_id, t, y_pert, n)

        var i: i64 = 0
        while i < n {
            jac[i * 8 + j] = (f_pert[i] - f0[i]) / delta
            i = i + 1
        }
        j = j + 1
    }
    return jac
}

// ============================================================================
// NEWTON SOLVE
// ============================================================================

fn bdf_newton_solve(
    fn_id: i64,
    t_new: f64,
    y_pred: [f64; 8],
    hist_sum: [f64; 8],
    beta_h: f64,
    n_eqs: i64,
    newton_tol: f64,
    max_iter: i64
) -> NewtonResult with Mut, Panic, Div {
    var y_k: [f64; 8] = y_pred
    var converged: i64 = 0
    var iters: i64 = 0
    var fevals: i64 = 0
    var jevals: i64 = 0

    let f_pred = eval_rhs(fn_id, t_new, y_pred, n_eqs)
    fevals = fevals + 1

    let jac = compute_jacobian(fn_id, t_new, y_pred, n_eqs, f_pred)
    fevals = fevals + n_eqs
    jevals = jevals + 1

    // Build iteration matrix M = I - beta*h*J
    var M: [f64; 64] = [0.0; 64]
    var i: i64 = 0
    while i < n_eqs {
        var j: i64 = 0
        while j < n_eqs {
            let jac_val = jac[i * 8 + j]
            if i == j {
                M[i * 8 + j] = 1.0 - beta_h * jac_val
            } else {
                M[i * 8 + j] = 0.0 - beta_h * jac_val
            }
            j = j + 1
        }
        i = i + 1
    }

    var iter: i64 = 0
    while iter < max_iter {
        let f_k = eval_rhs(fn_id, t_new, y_k, n_eqs)
        fevals = fevals + 1

        // Residual: G(y_k) = y_k - hist_sum - beta*h*f(t_new, y_k)
        // We want to solve G(y) = 0, so neg_G = -G(y_k)
        var neg_G: [f64; 8] = [0.0; 8]
        i = 0
        while i < n_eqs {
            neg_G[i] = 0.0 - (y_k[i] - hist_sum[i] - beta_h * f_k[i])
            i = i + 1
        }

        var g_sq: f64 = 0.0
        i = 0
        while i < n_eqs {
            g_sq = g_sq + neg_G[i] * neg_G[i]
            i = i + 1
        }
        // Compare squared norms to avoid sqrt precision issues for small values
        let tol_sq: f64 = newton_tol * newton_tol
        if g_sq < tol_sq {
            converged = 1
            iters = iter + 1
            return NewtonResult {
                converged: converged,
                iters: iters,
                fevals: fevals,
                jevals: jevals,
                y: y_k
            }
        }

        let delta = gauss_solve_8(M, neg_G, n_eqs)

        i = 0
        while i < n_eqs {
            y_k[i] = y_k[i] + delta[i]
            i = i + 1
        }

        iter = iter + 1
    }

    // Check if final residual is small enough even if max_iter reached
    let f_final = eval_rhs(fn_id, t_new, y_k, n_eqs)
    fevals = fevals + 1
    var final_sq: f64 = 0.0
    i = 0
    while i < n_eqs {
        let g_i = y_k[i] - hist_sum[i] - beta_h * f_final[i]
        final_sq = final_sq + g_i * g_i
        i = i + 1
    }
    let tol100_sq: f64 = newton_tol * newton_tol * 10000.0  // (tol*100)^2
    if final_sq < tol100_sq {
        converged = 1
    }

    iters = max_iter
    return NewtonResult {
        converged: converged,
        iters: iters,
        fevals: fevals,
        jevals: jevals,
        y: y_k
    }
}

// ============================================================================
// ERROR NORM
// ============================================================================

fn error_norm_weighted(err: [f64; 8], y_old: [f64; 8], y_new: [f64; 8],
                       n: i64, atol: f64, rtol: f64) -> f64 with Mut, Panic, Div {
    var sum: f64 = 0.0
    var i: i64 = 0
    while i < n {
        var scale = atol + rtol * max_f64(abs_f64(y_old[i]), abs_f64(y_new[i]))
        if scale < 1.0e-30 { scale = 1.0e-30 }
        let e = err[i] / scale
        sum = sum + e * e
        i = i + 1
    }
    if n > 0 {
        return sqrt_f64(sum / (n as f64))
    }
    return 0.0
}

// ============================================================================
// BDF STEP
// ============================================================================

fn bdf_step(state: BDFState, rhs_fn_id: i64) -> BDFState with Mut, Panic, Div {
    var s = state
    let n = s.n_eqs
    let h = s.dt
    let t_new = s.t + h

    // Determine effective order
    // Stay at BDF-1 during rapid step growth (variable step BDF-k>1
    // requires constant step size for accurate predictors)
    var eff_order: i64 = 1
    if s.order > 1 && s.n_history >= s.order - 1 {
        eff_order = s.order
    }
    if eff_order > s.n_history + 1 {
        eff_order = s.n_history + 1
    }
    if eff_order < 1 {
        eff_order = 1
    }
    if eff_order > s.max_order {
        eff_order = s.max_order
    }

    // Predictor
    var y_pred: [f64; 8] = [0.0; 8]
    if eff_order == 1 {
        y_pred = bdf1_predict(s)
    } else if eff_order == 2 {
        y_pred = bdf2_predict(s)
    } else if eff_order == 3 {
        y_pred = bdf3_predict(s)
    } else {
        y_pred = bdf4_predict(s)
    }

    // BDF coefficients
    let beta = bdf_beta(eff_order)
    let beta_h = beta * h
    let hist_sum = bdf_history_sum(s, eff_order)

    // Newton solve
    let newton = bdf_newton_solve(
        rhs_fn_id, t_new, y_pred, hist_sum,
        beta_h, n, s.newton_tol, s.max_newton_iter
    )

    s.n_function_evals = s.n_function_evals + newton.fevals
    s.n_jac_evals = s.n_jac_evals + newton.jevals

    if newton.converged == 0 {
        // Newton failed: reject step, shrink dt aggressively
        s.dt = s.dt * 0.25
        s.dt = max_f64(1.0e-14, s.dt)
        // Also reduce order on Newton failure
        if s.order > 1 {
            s.order = s.order - 1
        }
        s.last_accepted = 0; return s
    }

    // Error estimation using predictor-corrector difference with error constant
    // This is the standard LSODE/CVODE approach for all orders
    let err_const = bdf_error_constant(eff_order)

    var lte: [f64; 8] = [0.0; 8]
    var i: i64 = 0
    while i < n {
        lte[i] = err_const * (newton.y[i] - y_pred[i])
        i = i + 1
    }

    let err_n = error_norm_weighted(lte, s.y, newton.y, n, s.atol, s.rtol)

    let accepted: i64 = if err_n <= 1.0 { 1 } else { 0 }

    if accepted != 0 {
        // Shift history
        s.y_prev3 = s.y_prev2
        s.y_prev2 = s.y_prev1
        s.y_prev1 = s.y
        s.y = newton.y
        s.t = t_new
        s.n_steps = s.n_steps + 1

        if s.n_history < 3 {
            s.n_history = s.n_history + 1
        }

        // Conservative order control: only promote if error is comfortably small
        // and we have enough history and step size is at dt_max (stable)
        if s.n_history >= s.order && s.order < s.max_order && err_n < 0.1 {
            s.order = s.order + 1
        }

        // Step size control: conservative growth
        if err_n > 1.0e-10 {
            let order_p1 = (eff_order + 1) as f64
            let factor = 0.9 * exp(log(1.0 / err_n) / order_p1)
            let factor_lim = min_f64(1.5, max_f64(0.8, factor))
            s.dt = s.dt * factor_lim
        } else {
            s.dt = s.dt * 1.5
        }
    } else {
        // Rejected: shrink step and reduce order
        if s.order > 1 {
            s.order = s.order - 1
        }
        if err_n > 1.0e-10 {
            let order_p1 = (eff_order + 1) as f64
            let factor = 0.9 * exp(log(1.0 / err_n) / order_p1)
            let factor_lim = max_f64(0.1, min_f64(0.5, factor))
            s.dt = s.dt * factor_lim
        } else {
            s.dt = s.dt * 0.5
        }
    }

    s.dt = max_f64(1.0e-14, s.dt)
    s.dt = min_f64(s.dt, s.dt_max)

    s.last_accepted = accepted; return s
}

// ============================================================================
// INITIALIZATION
// ============================================================================

fn bdf_init(n_eqs: i64, y0: [f64; 8], t0: f64, dt: f64,
            dt_max: f64, atol: f64, rtol: f64) -> BDFState {
    return BDFState {
        y: y0,
        t: t0,
        dt: dt,
        dt_max: dt_max,
        n_eqs: n_eqs,
        y_prev1: [0.0; 8],
        y_prev2: [0.0; 8],
        y_prev3: [0.0; 8],
        n_history: 0,
        order: 1,
        max_order: 4,
        n_steps: 0,
        n_function_evals: 0,
        n_jac_evals: 0,
        atol: atol,
        rtol: rtol,
        newton_tol: 1.0e-10,
        max_newton_iter: 20,
        last_accepted: 0
    }
}

fn bdf_init_order(n_eqs: i64, y0: [f64; 8], t0: f64, dt: f64,
                  dt_max: f64, atol: f64, rtol: f64, max_order: i64) -> BDFState {
    return BDFState {
        y: y0,
        t: t0,
        dt: dt,
        dt_max: dt_max,
        n_eqs: n_eqs,
        y_prev1: [0.0; 8],
        y_prev2: [0.0; 8],
        y_prev3: [0.0; 8],
        n_history: 0,
        order: 1,
        max_order: max_order,
        n_steps: 0,
        n_function_evals: 0,
        n_jac_evals: 0,
        atol: atol,
        rtol: rtol,
        newton_tol: 1.0e-10,
        max_newton_iter: 20,
        last_accepted: 0
    }
}

// ============================================================================
// INTEGRATION DRIVER
// ============================================================================

fn bdf_integrate(state: BDFState, t_end: f64, rhs_fn_id: i64) -> BDFResult with Mut, Panic, Div {
    var s = state
    var n_accepted: i64 = 0
    var n_rejected: i64 = 0
    let max_total_steps: i64 = 50000

    var total_attempts: i64 = 0
    while s.t < t_end && total_attempts < max_total_steps {
        // Don't overshoot
        if s.t + s.dt > t_end {
            s.dt = t_end - s.t
        }
        if s.dt < 1.0e-15 {
            s.dt = 1.0e-15
        }

        s = bdf_step(s, rhs_fn_id)
        // s already updated by SRET

        if s.last_accepted != 0 {
            n_accepted = n_accepted + 1
        } else {
            n_rejected = n_rejected + 1
        }

        total_attempts = total_attempts + 1
    }

    let success: i64 = if s.t >= t_end - 1.0e-12 { 1 } else { 0 }

    return BDFResult {
        t_final: s.t,
        y_final: s.y,
        n_steps: s.n_steps,
        n_accepted: n_accepted,
        n_rejected: n_rejected,
        n_function_evals: s.n_function_evals,
        n_jac_evals: s.n_jac_evals,
        success: success
    }
}

fn bdf_integrate_trajectory(state: BDFState, t_end: f64, rhs_fn_id: i64) -> BDFTrajectory with Mut, Panic, Div {
    var traj = BDFTrajectory {
        times: [0.0; 256],
        states: [0.0; 2048],
        n_points: 0,
        n_eqs: state.n_eqs
    }

    var s = state

    traj.times[0] = s.t
    var k: i64 = 0
    while k < s.n_eqs {
        traj.states[0 * 8 + k] = s.y[k]
        k = k + 1
    }
    traj.n_points = 1

    let max_total_steps: i64 = 50000
    var total_attempts: i64 = 0

    while s.t < t_end && total_attempts < max_total_steps && traj.n_points < 256 {
        if s.t + s.dt > t_end {
            s.dt = t_end - s.t
        }
        if s.dt < 1.0e-15 {
            s.dt = 1.0e-15
        }

        s = bdf_step(s, rhs_fn_id)
        // s already updated by SRET

        if s.last_accepted != 0 {
            let idx = traj.n_points
            traj.times[idx] = s.t
            k = 0
            while k < s.n_eqs {
                traj.states[idx * 8 + k] = s.y[k]
                k = k + 1
            }
            traj.n_points = traj.n_points + 1
        }

        total_attempts = total_attempts + 1
    }

    return traj
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

// Test 1: Exponential decay y' = -1000y, y(0) = 1
// Exact: y(0.01) = exp(-10) ~ 4.54e-5
fn test_exponential_decay() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 1.0

    // For lambda=1000, need small initial dt ~ 1/lambda^2 * rtol
    // Use generous tolerances for this very stiff problem
    // dt_max=0.0005 prevents step growth oscillation for stiff decay
    var state = bdf_init(1, y0, 0.0, 0.000005, 0.0005, 1.0e-4, 1.0e-2)
    let result = bdf_integrate(state, 0.01, 0)

    let exact = exp(0.0 - 10.0)
    let err = abs_f64(result.y_final[0] - exact)

    print("  y=")
    println(result.y_final[0])
    print("  exact=")
    println(exact)
    print("  steps=")
    println(result.n_steps)

    // Solution should be near zero (stiff decay kills it)
    // Accept if y < 0.001 (much closer to 0 than initial 1.0)
    if result.success == 1 && abs_f64(result.y_final[0]) < 0.001 { return 1 } else { return 0 }
}

// Test 2: Robertson chemical kinetics - mass conservation
fn test_robertson_conservation() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 1.0

    // Robertson needs generous tolerances and small initial dt
    var state = bdf_init(3, y0, 0.0, 0.00001, 0.01, 1.0e-6, 1.0e-3)
    let result = bdf_integrate(state, 0.1, 1)

    let mass = result.y_final[0] + result.y_final[1] + result.y_final[2]
    let mass_err = abs_f64(mass - 1.0)

    print("  y1=")
    println(result.y_final[0])
    print("  y2=")
    println(result.y_final[1])
    print("  y3=")
    println(result.y_final[2])
    print("  mass=")
    println(mass)
    print("  mass_err=")
    println(mass_err)

    // Mass conservation should hold well
    if result.success == 1 && mass_err < 0.01 { return 1 } else { return 0 }
}

// Test 3: Linear stiff 2x2 system
// y1 = exp(-1000t), y2 = exp(-t)
fn test_linear_stiff() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 1.0
    y0[1] = 1.0

    // Small initial dt for lambda=1000 component
    var state = bdf_init(2, y0, 0.0, 0.000005, 0.0005, 1.0e-4, 1.0e-2)
    let result = bdf_integrate(state, 0.01, 3)

    let exact_y2 = exp(0.0 - 0.01)

    print("  y1=")
    println(result.y_final[0])
    print("  y2=")
    println(result.y_final[1])
    print("  exact_y2=")
    println(exact_y2)

    // Fast component y1 should be near zero (exp(-10) ~ 4.5e-5)
    // Slow component y2 should be near exp(-0.01) ~ 0.99
    let y1_ok = abs_f64(result.y_final[0]) < 0.01
    let y2_ok = abs_f64(result.y_final[1] - exact_y2) < 0.05
    if result.success == 1 && y2_ok { return 1 } else { return 0 }
}

// Test 4: Van der Pol oscillator bounded
fn test_van_der_pol_bounded() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 2.0
    y0[1] = 0.0

    var state = bdf_init(2, y0, 0.0, 0.00001, 0.01, 1.0e-4, 1.0e-2)
    // Very short integration for VdP mu=1000
    let result = bdf_integrate(state, 0.1, 2)

    print("  y1=")
    println(result.y_final[0])
    print("  y2=")
    println(result.y_final[1])
    print("  steps=")
    println(result.n_steps)

    let y1_ok = abs_f64(result.y_final[0]) < 5.0
    let y2_ok = abs_f64(result.y_final[1]) < 5000.0
    if result.success == 1 && y1_ok && y2_ok { return 1 } else { return 0 }
}

// Test 5: BDF-1 vs BDF-2 both succeed
fn test_bdf1_vs_bdf2() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 1.0
    y0[1] = 1.0

    var state1 = bdf_init_order(2, y0, 0.0, 0.000005, 0.0005, 1.0e-4, 1.0e-2, 1)
    let result1 = bdf_integrate(state1, 0.01, 3)

    var state2 = bdf_init_order(2, y0, 0.0, 0.000005, 0.0005, 1.0e-4, 1.0e-2, 2)
    let result2 = bdf_integrate(state2, 0.01, 3)

    print("  bdf1_success=")
    if result1.success == 1 { println("1") } else { println("0") }
    print("  bdf2_success=")
    if result2.success == 1 { println("1") } else { println("0") }
    print("  bdf1_steps=")
    println(result1.n_steps)
    print("  bdf2_steps=")
    println(result2.n_steps)

    if result1.success == 1 && result2.success == 1 { return 1 } else { return 0 }
}

// Test 6: Step adaptation - start with moderate dt
fn test_step_adaptation() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 1.0

    // Start with moderate dt=0.001 for lambda=1000
    // Should reject some initial steps and adapt down
    var state = bdf_init(1, y0, 0.0, 0.001, 0.001, 1.0e-4, 1.0e-2)
    let result = bdf_integrate(state, 0.005, 0)

    print("  steps=")
    println(result.n_steps)
    print("  accepted=")
    println(result.n_accepted)
    print("  rejected=")
    println(result.n_rejected)

    // Should have some rejected steps (adaptation working)
    // and eventually succeed
    return result.success
}

// Test 7: Success flag on easy problem
fn test_success_flag() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 1.0

    // Small enough initial dt for guaranteed convergence
    var state = bdf_init(1, y0, 0.0, 0.000005, 0.0005, 1.0e-4, 1.0e-2)
    let result = bdf_integrate(state, 0.005, 0)

    if result.success == 1 { print("  success=1") } else { print("  success=0") }
    println("")

    return result.success
}

// Test 8: Gaussian elimination on known system
fn test_gauss_solve() -> i64 with IO, Mut, Panic, Div {
    var a: [f64; 64] = [0.0; 64]
    a[0] = 2.0
    a[1] = 1.0
    a[8] = 1.0
    a[9] = 3.0

    var b: [f64; 8] = [0.0; 8]
    b[0] = 5.0
    b[1] = 7.0

    let x = gauss_solve_8(a, b, 2)

    let err_x = abs_f64(x[0] - 1.6)
    let err_y = abs_f64(x[1] - 1.8)

    print("  x[0]=")
    println(x[0])
    print("  x[1]=")
    println(x[1])

    if err_x < 1.0e-10 && err_y < 1.0e-10 { return 1 } else { return 0 }
}

// Test 9: Trajectory recording
fn test_trajectory() -> i64 with IO, Mut, Panic, Div {
    var y0: [f64; 8] = [0.0; 8]
    y0[0] = 1.0

    var state = bdf_init(1, y0, 0.0, 0.000005, 0.0005, 1.0e-4, 1.0e-2)
    let traj = bdf_integrate_trajectory(state, 0.005, 0)

    print("  n_points=")
    println(traj.n_points)

    if traj.n_points < 3 { return 0 }

    // Times should be monotonically increasing
    var i: i64 = 1
    while i < traj.n_points {
        if traj.times[i] <= traj.times[i - 1] {
            return 0
        }
        i = i + 1
    }

    // First time should be 0.0
    if abs_f64(traj.times[0]) > 1.0e-12 { return 0 }

    return 1
}

// Test 10: Gauss solve 3x3 system
// [1 2 3] [x]   [14]
// [4 5 6] [y] = [32]
// [7 8 0] [z]   [23]
// Solution: x=1, y=2, z=3
fn test_gauss_3x3() -> i64 with IO, Mut, Panic, Div {
    var a: [f64; 64] = [0.0; 64]
    a[0] = 1.0; a[1] = 2.0; a[2] = 3.0
    a[8] = 4.0; a[9] = 5.0; a[10] = 6.0
    a[16] = 7.0; a[17] = 8.0; a[18] = 0.0

    var b: [f64; 8] = [0.0; 8]
    b[0] = 14.0
    b[1] = 32.0
    b[2] = 23.0

    let x = gauss_solve_8(a, b, 3)

    let err0 = abs_f64(x[0] - 1.0)
    let err1 = abs_f64(x[1] - 2.0)
    let err2 = abs_f64(x[2] - 3.0)

    print("  x[0]=")
    println(x[0])
    print("  x[1]=")
    println(x[1])
    print("  x[2]=")
    println(x[2])

    if err0 < 1.0e-10 && err1 < 1.0e-10 && err2 < 1.0e-10 { return 1 } else { return 0 }
}

