    if test_van_der_pol_bounded() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 5
    print("Test 5: BDF-1 vs BDF-2... ")
    if test_bdf1_vs_bdf2() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 6
    print("Test 6: Step adaptation... ")
    if test_step_adaptation() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 7
    print("Test 7: Success flag... ")
    if test_success_flag() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 8
    print("Test 8: Gauss solve 2x2... ")
    if test_gauss_solve() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 9
    print("Test 9: Trajectory recording... ")
    if test_trajectory() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 10
    print("Test 10: Gauss solve 3x3... ")
    if test_gauss_3x3() == 1 {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed == 0 {
        println("ALL TESTS PASSED")
    } else {
        println("SOME TESTS FAILED")
    }

    return failed
}
