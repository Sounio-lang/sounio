    audit = mix(audit, 31177321, 6163)
    audit = mix(audit, 15, 6163)
    audit = mix(audit, 15, 6163)
    audit = mix(audit, 0, 6163)
    audit = mix(audit, 0, 6163)
    audit = mix(audit, 1, 6163)
    audit = mix(audit, 4, 6163)
    audit = mix(audit, 27, 6163)
    audit = mix(audit, 255, 6163)
    if audit != 772088455 { return 2 }

    var entry: i64 = 101
    entry = mix(entry, 151, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 151, 1103)
    if entry != 467412992 { return 3 }

    var manifest: i64 = 107
