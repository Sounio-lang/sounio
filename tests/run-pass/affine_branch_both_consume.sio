//@ run-pass

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 3 }
    let enabled = true
    let result = if enabled {
        spend(permit)
    } else {
        spend(permit)
    }
    assert(result == 3)
    0
}
