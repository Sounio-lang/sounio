//@ run-pass
//@ known-failure: source-level i128 Lorenz Euler LTE z-seed: main returns 2. Not a segfault/139
//@ requires: madaros
//@ description: Lorenz i128 Euler local-truncation-error seed for z at the initial point

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    let x: i128 = scale
    let y: i128 = scale
    let z: i128 = scale

    let dx: i128 = sigma * (y - x)
    let dy: i128 = (x * ((rho * scale) - z)) / scale - y
    let dz: i128 = (x * y) / scale - (beta_num * z) / beta_den
    let abs_dz: i128 = (0 as i128) - dz

    // z'' = x' y + x y' - beta z'. At the initial point z' is negative, so
    // the beta term is carried as a positive absolute contribution.
    let ddz_abs: i128 = (dx * y) / scale + (x * dy) / scale + (beta_num * abs_dz) / beta_den

    let den: i64 = 2000000000000
    let h2: i64 = 100000000
    let ddz_i64: i64 = 30444442
    let lte_z: i64 = (h2 * ddz_i64 + den - 1) / den

    // z radius from lorenz_i128_ball_step.sio plus this local truncation budget.
    let total_zr: i64 = 11 + lte_z

    if dx != (0 as i128) { return 1 }
    if dy != (26000000 as i128) { return 2 }
    if dz != ((0 as i128) - (1666666 as i128)) { return 3 }
    if ddz_abs != (30444442 as i128) { return 4 }
    if lte_z != 1523 { return 5 }
    if total_zr != 1534 { return 6 }
    return 0
}
