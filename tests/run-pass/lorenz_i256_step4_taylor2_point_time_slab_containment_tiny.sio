//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 point time-slab containment seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1621
    fp = mix(fp, 563331437, 5519)
    fp = mix(fp, 684718822, 5519)
    fp = mix(fp, 4, 5519)
    fp = mix(fp, 256, 5519)
    fp = mix(fp, 32, 5519)
    fp = mix(fp, 1, 5519)
    fp = mix(fp, 100, 5519)
    fp = mix(fp, 7045651, 5519)
    fp = mix(fp, 27293136, 5519)
    fp = mix(fp, 644980, 5519)
    fp = mix(fp, 70457, 5519)
    fp = mix(fp, 272932, 5519)
    fp = mix(fp, 6450, 5519)
    fp = mix(fp, 71000, 5519)
    fp = mix(fp, 273500, 5519)
    fp = mix(fp, 6500, 5519)
    fp = mix(fp, 543, 5519)
    fp = mix(fp, 568, 5519)
    fp = mix(fp, 50, 5519)
    fp = mix(fp, 3, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 15, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 23, 5519)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 338504427 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1627
    fp = mix(fp, instance, 5521)
    fp = mix(fp, 7045651, 5521)
    fp = mix(fp, 27293136, 5521)
    fp = mix(fp, 644980, 5521)
    fp = mix(fp, 70457, 5521)
    fp = mix(fp, 272932, 5521)
    fp = mix(fp, 6450, 5521)
    fp = mix(fp, 543, 5521)
    fp = mix(fp, 568, 5521)
    fp = mix(fp, 50, 5521)
    fp = mix(fp, 3, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 15, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 23, 5521)
    fp = mix(fp, ok_mask, 5521)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 338504427 { return 0 - 1 }
    if certificate != 904234352 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1637
    fp = mix(fp, instance, 5527)
    fp = mix(fp, certificate, 5527)
    fp = mix(fp, 19, 5527)
    fp = mix(fp, 4, 5527)
    fp = mix(fp, 7, 5527)
    fp = mix(fp, 15, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 23, 5527)
    fp = mix(fp, ok_mask, 5527)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 827089582 { return 0 - 1 }
    if instance != 338504427 { return 0 - 1 }
    if certificate != 904234352 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1657
    fp = mix(fp, artifact, 5531)
    fp = mix(fp, instance, 5531)
    fp = mix(fp, certificate, 5531)
    fp = mix(fp, 563331437, 5531)
    fp = mix(fp, 684718822, 5531)
    fp = mix(fp, 7045651, 5531)
    fp = mix(fp, 27293136, 5531)
    fp = mix(fp, 644980, 5531)
    fp = mix(fp, 70457, 5531)
    fp = mix(fp, 272932, 5531)
    fp = mix(fp, 6450, 5531)
    fp = mix(fp, 71000, 5531)
    fp = mix(fp, 273500, 5531)
    fp = mix(fp, 6500, 5531)
    fp = mix(fp, 4, 5531)
    fp = mix(fp, 23, 5531)
    fp = mix(fp, ok_mask, 5531)
    return fp
}

fn time_slab_ok_mask(global_claim_mask: i64, status: i64) -> i64 {
    let scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let x3: i256 = 4617762706 as i256
    let y3: i256 = 7643846696 as i256
    let dy_scaled_q: i256 = 124866970867 as i256
    let beta_q: i256 = 10988500690 as i256
    let xy_scaled_q: i256 = 8218332706 as i256
    let dx_num: i256 = (10 as i256) * (y3 - x3)
    let dy_num: i256 = dy_scaled_q - y3
    let dz_num: i256 = beta_q - xy_scaled_q

    var derivative_mask: i64 = 0
    if (7045650 as i256) * scale < dx_num * target_scale {
        if (7045651 as i256) * scale >= dx_num * target_scale { derivative_mask = derivative_mask + 1 }
    }
    if (27293135 as i256) * scale < dy_num * target_scale {
        if (27293136 as i256) * scale >= dy_num * target_scale { derivative_mask = derivative_mask + 2 }
    }
    if (644979 as i256) * scale < dz_num * target_scale {
        if (644980 as i256) * scale >= dz_num * target_scale { derivative_mask = derivative_mask + 4 }
    }

    var sweep_mask: i64 = 0
    if 70456 * 100 < 7045651 {
        if 70457 * 100 >= 7045651 { sweep_mask = sweep_mask + 1 }
    }
    if 272931 * 100 < 27293136 {
        if 272932 * 100 >= 27293136 { sweep_mask = sweep_mask + 2 }
    }
    if 6449 * 100 < 644980 {
        if 6450 * 100 >= 644980 { sweep_mask = sweep_mask + 4 }
    }

    let x_slack: i64 = 71000 - 70457
    let y_slack: i64 = 273500 - 272932
    let z_slack: i64 = 6500 - 6450
    var slab_margin_mask: i64 = 0
    if x_slack == 543 { slab_margin_mask = slab_margin_mask + 1 }
    if y_slack == 568 { slab_margin_mask = slab_margin_mask + 2 }
    if z_slack == 50 { slab_margin_mask = slab_margin_mask + 4 }

    var slab_mask: i64 = 0
    if 70457 <= 71000 { slab_mask = slab_mask + 1 }
    if 272932 <= 273500 { slab_mask = slab_mask + 2 }
    if 6450 <= 6500 { slab_mask = slab_mask + 4 }

    let seed_anchor_mask: i64 = 3
    var local_seed_mask: i64 = 0
    if seed_anchor_mask == 3 { local_seed_mask = local_seed_mask + 1 }
    if derivative_mask == 7 { local_seed_mask = local_seed_mask + 2 }
    if sweep_mask == 7 { local_seed_mask = local_seed_mask + 4 }
    if slab_margin_mask == 7 {
        if slab_mask == 7 { local_seed_mask = local_seed_mask + 8 }
    }

    var ok_mask: i64 = 0
    if seed_anchor_mask == 3 { ok_mask = ok_mask + 1 }
    if derivative_mask == 7 { ok_mask = ok_mask + 2 }
    if sweep_mask == 7 { ok_mask = ok_mask + 4 }
    if slab_margin_mask == 7 { ok_mask = ok_mask + 8 }
    if 1 == 1 {
        if 100 == 100 { ok_mask = ok_mask + 16 }
    }
    if local_seed_mask == 15 { ok_mask = ok_mask + 32 }
    if global_claim_mask == 0 {
        if status == 23 { ok_mask = ok_mask + 64 }
    }
    if local_seed_mask == 15 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = time_slab_ok_mask(0, 23)
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 338504427 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 904234352 { return 3 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 827089582 { return 4 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 688797663 { return 5 }
    if time_slab_ok_mask(1, 23) == 255 { return 6 }
    if certificate_fp(inst, 254) != (0 - 1) { return 7 }
    return 0
}
