//@ run-pass
//@ requires: madaros
//@ expect-stdout: CLAIM_SEAT_OK
// The band is the claim. A centre is a reading only when it sits in the band
// and the other centre does not. These bounds are the one-sigma bands, on the
// pressure scale, of the two residual-scaled fits of Kefi and Huot, Table 1,
// at 298.15 K. The arithmetic that produced them is not repeated here.

use epistemic::claim_meet::{centre_seat, held_centre, seat_code}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut {
    let revise = centre_seat(0.0, 1.0, 0.5, 3.0, 4.0, 3.5)
    let held_revise = held_centre(revise, 0.5, 3.5)

    let neither = centre_seat(
        0.1407835266028724, 0.21875745084503628, 0.17549200950646932,
        0.20101904080806268, 0.304578824308845, 0.24743917053088313,
    )
    let held_neither = held_centre(neither, 0.17549200950646932, 0.24743917053088313)

    let both = centre_seat(
        0.07066499185197346, 0.12283765127987058, 0.09316824366063585,
        0.08365053678778074, 0.1479253980468847, 0.11123865762929737,
    )
    let held_both = held_centre(both, 0.09316824366063585, 0.11123865762929737)

    let only_b = centre_seat(
        0.4372193808641805, 0.6586200793137377, 0.5366204089505634,
        0.5434085485562459, 0.7563200814613081, 0.6410856399193723,
    )
    let held_b = held_centre(only_b, 0.5366204089505634, 0.6410856399193723)

    print("revise ")
    print_int(seat_code(revise))
    print(" neither ")
    print_int(seat_code(neither))
    print(" both ")
    print_int(seat_code(both))
    print(" only_b ")
    print_int(seat_code(only_b))
    print("\n")

    if seat_code(revise) == 4 && !held_revise.held
        && seat_code(neither) == 3 && !held_neither.held
        && seat_code(both) == 0 && !held_both.held
        && seat_code(only_b) == 2 && held_b.held
        && near(held_b.centre, 0.6410856399193723, 0.000000000001)
    {
        println("CLAIM_SEAT_OK")
        return 0
    }
    println("CLAIM_SEAT_FAIL")
    1
}
