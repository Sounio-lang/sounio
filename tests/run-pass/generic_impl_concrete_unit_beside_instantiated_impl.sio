//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_concrete_unit_beside_instantiated_impl
// A concrete impl over a unit (`impl Cell<mg>`) in the same file as a generic impl that
// is instantiated (`impl Map<K, V>` with `Map { key: 42, val: 99 }`). Each half compiles
// and runs on its own (generic_impl_concrete_unit_arg.sio,
// generic_impl_param_spelled_like_unit.sio); together they failed with E001 on
// `let c: Cell<mg> = Cell { v: 1.0 }` and E011 on `c.twice(e)`.
//
// Cause: an instantiated generic impl makes the specializer rewrite `main`, and it replaced
// EVERY generic-struct application there by an instance, not only the structs that have a
// generic impl. `Cell` has none. The annotation `Cell<mg>` became `Cell__mg` (named after
// the argument's spelling) and the literal `Cell { v: 1.0 }` became `Cell__f64` (named after
// the inferred argument), so the binding compared two structs; and the checker, which mangles
// a unit as its carrier, had registered `impl Cell<mg>`'s methods on `Cell__f64`, so the
// receiver had none. It is not specific to K -- `Pair<T, U>` in place of `Map<K, V>` fails
// the same way -- nor to units in general: see
// generic_impl_concrete_arg_beside_instantiated_impl.sio. Only structs with a generic impl
// are rewritten in an ordinary fn now; the others stay for the checker, as when no generic
// impl is present.

struct Cell<T> {
    v: T,
}

impl Cell<mg> {
    fn twice(self: &Cell<mg>, k: mg) -> mg {
        k + k
    }
}

struct Mass<T> {
    v: T,
}

impl Mass<kg> {
    fn twice(self: &Mass<kg>, k: kg) -> kg {
        k + k
    }
}

struct Map<K, V> {
    key: K,
    val: V,
}

impl Map<K, V> {
    fn get_key(self: &Map<K, V>) -> K {
        self.key
    }
}

fn main() -> i32 with IO {
    var ok: i64 = 0

    let c: Cell<mg> = Cell { v: 1.0 }
    let e: mg = 25.0
    let b: mg = c.twice(e)
    if b as f64 == 50.0 { ok = ok + 1 }

    let w: Mass<kg> = Mass { v: 1.0 }
    let f: kg = 40.0
    let g: kg = w.twice(f)
    if g as f64 == 80.0 { ok = ok + 1 }

    let m = Map { key: 42, val: 99 }
    let a: i64 = m.get_key()
    if a == 42 { ok = ok + 1 }

    if ok == 3 {
        println("PASS generic_impl_concrete_unit_beside_instantiated_impl")
    } else {
        println("FAIL generic_impl_concrete_unit_beside_instantiated_impl")
        print_int(ok)
        println("")
    }
    0
}
