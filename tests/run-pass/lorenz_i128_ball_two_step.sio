//@ run-pass
//@ requires: madaros
//@ description: Lorenz second fixed-point ball transition with i128 centers

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let dt: i128 = 10000 as i128
    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    // Input is the step-1 ball certified by lorenz_i128_ball_step.sio.
    let x1: i128 = 1000000 as i128
    let y1: i128 = 1260000 as i128
    let z1: i128 = 983334 as i128
    let xr1: i64 = 13
    let yr1: i64 = 13
    let zr1: i64 = 11

    let dx1: i128 = sigma * (y1 - x1)
    let dy1: i128 = (x1 * ((rho * scale) - z1)) / scale - y1
    let dz1: i128 = (x1 * y1) / scale - (beta_num * z1) / beta_den
    let x2: i128 = x1 + (dt * dx1) / scale
    let y2: i128 = y1 + (dt * dy1) / scale
    let zdrop1: i128 = (dt * ((0 as i128) - dz1)) / scale
    let z2: i128 = z1 - zdrop1

    // Centers are positive in this smoke, so abs(center) is the center itself
    // in the product-radius formulas.
    let dxr1: i64 = 10 * (yr1 + xr1)
    let x_rhoz_r1: i64 = ((1000000 * zr1) + (27016666 * xr1) + (xr1 * zr1)) / 1000000 + 1
    let dyr1: i64 = x_rhoz_r1 + yr1
    let xyr1: i64 = ((1000000 * yr1) + (1260000 * xr1) + (xr1 * yr1)) / 1000000 + 1
    let beta_zr1: i64 = ((8 * zr1) + 2) / 3 + 1
    let dzr1: i64 = xyr1 + beta_zr1
    let xr2: i64 = xr1 + (10000 * dxr1) / 1000000 + 1
    let yr2: i64 = yr1 + (10000 * dyr1) / 1000000 + 1
    let zr2: i64 = zr1 + (10000 * dzr1) / 1000000 + 1

    if dx1 != (2600000 as i128) { return 1 }
    if dy1 != (25756666 as i128) { return 2 }
    if dz1 != ((0 as i128) - (1362224 as i128)) { return 3 }
    if x2 != (1026000 as i128) { return 4 }
    if y2 != (1517566 as i128) { return 5 }
    if z2 != (969712 as i128) { return 6 }

    if dxr1 != 260 { return 7 }
    if dyr1 != 376 { return 8 }
    if dzr1 != 61 { return 9 }
    if xr2 != 16 { return 10 }
    if yr2 != 17 { return 11 }
    if zr2 != 12 { return 12 }

    return 0
}
