//@ run-pass
//@ requires: madaros
//@ expect-stdout: EPI006_EXACT_CONTROLS_OK
// Positive controls for EPI-006 exact confidence (`ε = x`):
// - a constructor `Knowledge(v, ε = c)` meets `ε = c` exactly;
// - an exact confidence meets a floor at or below it (exact-to-floor).
// The compile-fail twin epi006_floor_is_not_exact_confidence refuses the
// reverse direction, a floor forwarded to an exact requirement.

fn floor(k: Knowledge[f64, ε >= 0.5]) -> f64 with Epistemic {
    k.value
}

fn exact(k: Knowledge[f64, ε = 0.75]) -> f64 with Epistemic {
    floor(k)
}

fn main() -> i64 with IO, Epistemic {
    let v = exact(Knowledge(2.0, ε = 0.75))
    if v != 2.0 {
        return 1
    }
    println("EPI006_EXACT_CONTROLS_OK")
    0
}
