//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: PBPK28_THETA_CLOSED_SYSTEM_MASS_PASS

// Madaros-qualified twin of pbpk28_theta_closed_system_mass.sio (identical
// body). The full suite runs lean_single; this copy puts the same θ /
// Rannacher / TR-BDF2 / routing checks in front of
// scripts/ci/madaros_changed_tests_gate.sh, because theta_pbpk28.sio carries
// Madaros-specific workarounds (in-place &! stepping, element-wise stage
// copies). Keep the two bodies in sync.

// Closed-system mass witness for stdlib/darwin_pbpk/theta_pbpk28.sio.
//
// With cl_central = 0 and no input, total body mass must stay at the dose.
// The published CN kernel (`pbpk28_full_cn_step`) does not: its negativity
// floors turn the sign-alternating stiff modes a bolus excites into mass —
// venlafaxine parent, 50 mg into blood, dt = 0.5 h: 85.065244 mg after one
// step, 89.100032 mg after eight. That kernel is left untouched for its
// parity gates; this test pins the clamp-free replacement:
//
//   1. Rannacher (2 start-up steps), TR-BDF2 and plain clamp-free CN keep
//      M_n = M_0 at every step, three drug profiles, dt ∈ {0.5, 0.1, 0.05} h.
//   2. Rannacher and TR-BDF2 book no visible negative mass in any returned
//      state (CN alone would: it rings to −9 mg/L here, which is why it is not
//      the production path). TR-BDF2's internal stage x_γ is printed as
//      stage_neg_mass and not gated.
//   3. With central clearance and an organ sink (venlafaxine CYP2D6 formation
//      clearance on the liver, CL_form·dt/V_liver ≈ 12 at dt = 0.5 h), the
//      ledger identity M(T) + eliminated + sink_removed − administered = M(0)
//      closes to rounding under a constant input.
//   4. The same with the input routed into the liver's vascular space
//      (portal first-pass, input_organ = 1): the identity still closes, and
//      routing through the liver raises the liver AUC over blood input.
//
// Bounds (theta_pbpk28 gate functions): |ΔM|/M_0 ≤ max(1e-12, steps·1e-15),
// a heuristic rounding budget for an identity that is exact in real
// arithmetic; booked negative mass ≤ 5e-7 mg, half the last digit of a
// 6-decimal mg print.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::theta_pbpk28::*

fn t_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// method: 0 = clamp-free CN, 1 = Rannacher, 2 = TR-BDF2
fn t_step(method: i32, st: &!PBPKState28, p: PBPKParams28, dt: f64, k: i32, led: &!PBPK28Ledger) with Mut, Div {
    if method == 0 {
        pbpk28_theta_step_mut(st, p, 0.0, dt, 0.5, led)
    } else {
        if method == 1 {
            pbpk28_rannacher_step_mut(st, p, 0.0, dt, k < pbpk28_rannacher_startup_steps(), led)
        } else {
            pbpk28_trbdf2_step_mut(st, p, 0.0, dt, led)
        }
    }
}

// Returns 1 on failure. Prints the worst per-step drift (x 1e12).
fn t_closed(tag: string, p0: PBPKParams28, dose: f64, dt: f64, nsteps: i32, method: i32, check_neg: bool) -> i32 with IO, Mut, Div {
    var p = p0
    p.cl_central = 0.0
    var st = pbpk28_state_zero()
    st.cv[0] = dose / p.v_ref[0]
    let m0 = pbpk28_total_mass(st, p)
    var led = pbpk28_ledger_zero()
    var worst = 0.0
    var ok = true
    var k: i32 = 0
    while k < nsteps {
        t_step(method, &!st, p, dt, k, &!led)
        let drift = t_abs(pbpk28_total_mass(st, p) - m0) / m0
        // NaN compares false against every bound: reject it explicitly.
        if drift != drift { ok = false }
        if drift > worst { worst = drift }
        if drift > pbpk28_mass_tol_rel(led.steps) { ok = false }
        k = k + 1
    }
    if check_neg && led.neg_mass > pbpk28_neg_mass_bound_mg() { ok = false }
    print(tag)
    print(" method=")
    print(method)
    print(" dt=")
    print(dt)
    print(" worst|dM|/M0 x1e12=")
    print(worst * 1.0e12)
    print(" M_end=")
    print(pbpk28_total_mass(st, p))
    print(" neg_mass x1e12=")
    print(led.neg_mass * 1.0e12)
    // TR-BDF2's internal stage x_γ: reported, not gated (it is not a returned
    // state; after a bolus its CN stage rings negative by design).
    print(" stage_neg_mass x1e12=")
    println(led.stage_neg_mass * 1.0e12)
    if ok { return 0 }
    println("  FAIL")
    return 1
}

fn t_profiles(dt: f64, nsteps: i32) -> i32 with IO, Mut, Div {
    var f: i32 = 0
    var m: i32 = 0
    while m < 3 {
        // CN alone conserves mass but rings negative: gate conservation only.
        let neg = m > 0
        f = f + t_closed("venlafaxine_parent", pbpk28_params_venlafaxine_parent(), 50.0, dt, nsteps, m, neg)
        f = f + t_closed("rapamycin", pbpk28_params_rapamycin(), 5.0, dt, nsteps, m, neg)
        f = f + t_closed("semaglutide", pbpk28_params_semaglutide(), 1.0, dt, nsteps, m, neg)
        m = m + 1
    }
    return f
}

// Open system: central CL + liver organ sink + constant input, 48 h.
fn t_sink(method: i32, dt: f64) -> i32 with IO, Mut, Div {
    let p = pbpk28_params_venlafaxine_parent()
    var st = pbpk28_state_zero()
    var led = pbpk28_ledger_zero()
    let cl_form = 43.0      // NM CYP2D6 formation clearance, L/h (Lessard 1999, oral/apparent)
    let rel = 3.0           // mg/h into blood
    var t = 0.0
    var k: i32 = 0
    while t < 48.0 - 0.5 * dt {
        if method == 1 {
            let _s = pbpk28_rannacher_step_sink_mut(&!st, p, rel, dt, k < pbpk28_rannacher_startup_steps(), 1, cl_form, &!led)
        } else {
            let _s = pbpk28_trbdf2_step_sink_mut(&!st, p, rel, dt, 1, cl_form, &!led)
        }
        t = t + dt
        k = k + 1
    }
    let r = pbpk28_ledger_residual(led, st, p, 0.0)
    if r != r {
        println("  FAIL: NaN residual")
        return 1
    }
    print("sink method=")
    print(method)
    print(" dt=")
    print(dt)
    print(" administered=")
    print(led.administered)
    print(" sink_removed=")
    print(led.sink_removed)
    print(" eliminated=")
    print(led.eliminated)
    print(" |res|/admin x1e12=")
    println(t_abs(r) / led.administered * 1.0e12)
    if t_abs(r) <= pbpk28_mass_tol_rel(led.steps) * led.administered && led.sink_removed > 0.0 {
        return 0
    }
    println("  FAIL")
    return 1
}

// Input routed into organ `route` (0 = blood). Returns the liver AUC, or −1
// when the ledger identity does not close.
fn t_route_run(method: i32, route: i32, dt: f64) -> f64 with IO, Mut, Div {
    let p = pbpk28_params_venlafaxine_parent()
    var st = pbpk28_state_zero()
    var led = pbpk28_ledger_zero()
    let cl_form = 43.0
    let rel = 3.0
    var t = 0.0
    var k: i32 = 0
    while t < 48.0 - 0.5 * dt {
        if method == 1 {
            // Rannacher: BE half-step pairs for the start-up, routed CN after.
            let _s = pbpk28_rannacher_step_routed_sink_mut(&!st, p, rel, route, dt, k < pbpk28_rannacher_startup_steps(), 1, cl_form, &!led)
        } else {
            let _s = pbpk28_trbdf2_step_routed_sink_mut(&!st, p, rel, route, dt, 1, cl_form, &!led)
        }
        t = t + dt
        k = k + 1
    }
    let r = pbpk28_ledger_residual(led, st, p, 0.0)
    if r != r { return 0.0 - 1.0 }
    print("route method=")
    print(method)
    print(" input_organ=")
    print(route)
    print(" sink_removed=")
    print(led.sink_removed)
    print(" auc_liver=")
    print(led.auc[1])
    print(" |res|/admin x1e12=")
    println(t_abs(r) / led.administered * 1.0e12)
    if t_abs(r) > pbpk28_mass_tol_rel(led.steps) * led.administered { return 0.0 - 1.0 }
    if led.neg_mass > pbpk28_neg_mass_bound_mg() { return 0.0 - 1.0 }
    return led.auc[1]
}

fn t_route(method: i32) -> i32 with IO, Mut, Div {
    let a_blood = t_route_run(method, 0, 0.5)
    let a_liver = t_route_run(method, 1, 0.5)
    if a_blood >= 0.0 && a_liver > a_blood { return 0 }
    println("  FAIL")
    return 1
}

// Input routed into a vascular space below the degenerate-volume floor
// (liver vasc_frac = 0): the step must refuse it -- inject nothing, book it
// as rejected_input rather than administered -- so the identity closes and
// the mass gate fails. `no_outflow` also zeroes the liver's Q and PS: that is
// the configuration where, before the refusal, all 12 mg booked were lost
// (residual -12 mg); with the liver's flows the input passed through and the
// identity closed (see p28t_route_rejected in theta_pbpk28.sio).
fn t_route_degenerate(method: i32, no_outflow: bool) -> i32 with IO, Mut, Div {
    var p = pbpk28_params_venlafaxine_parent()
    p.vasc_frac[1] = 0.0
    if no_outflow {
        p.q[1] = 0.0
        p.ps[1] = 0.0
    }
    var st = pbpk28_state_zero()
    var led = pbpk28_ledger_zero()
    let rel = 3.0
    let dt = 0.5
    var k: i32 = 0
    while k < 8 {
        if method == 1 {
            let _s = pbpk28_rannacher_step_routed_sink_mut(&!st, p, rel, 1, dt, k < pbpk28_rannacher_startup_steps(), 0, 0.0, &!led)
        } else {
            let _s = pbpk28_trbdf2_step_routed_sink_mut(&!st, p, rel, 1, dt, 0, 0.0, &!led)
        }
        k = k + 1
    }
    let r = pbpk28_ledger_residual(led, st, p, 0.0)
    let gate = pbpk28_mass_gate_ok(led, st, p, 0.0, 12.0)
    print("degenerate route method=")
    print(method)
    if no_outflow { print(" no_outflow") }
    print(" administered=")
    print(led.administered)
    print(" rejected_input=")
    print(led.rejected_input)
    print(" |res| x1e12=")
    println(t_abs(r) * 1.0e12)
    if led.administered == 0.0 && led.rejected_input == 12.0 && t_abs(r) <= 1.0e-12 && !gate { return 0 }
    println("  FAIL")
    return 1
}

fn main() -> i32 with IO, Mut, Div {
    var failed: i32 = 0
    failed = failed + t_profiles(0.5, 8)
    failed = failed + t_profiles(0.1, 40)
    failed = failed + t_profiles(0.05, 80)
    failed = failed + t_sink(1, 0.5)
    failed = failed + t_sink(2, 0.5)
    failed = failed + t_route(1)
    failed = failed + t_route(2)
    failed = failed + t_route_degenerate(1, false)
    failed = failed + t_route_degenerate(2, false)
    failed = failed + t_route_degenerate(1, true)
    failed = failed + t_route_degenerate(2, true)
    if failed == 0 {
        println("PBPK28_THETA_CLOSED_SYSTEM_MASS_PASS")
    } else {
        print("failed=")
        println(failed)
    }
    return failed
}
