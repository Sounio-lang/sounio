//@ run-pass
//@ description: Imported FRAT-to-LRAT elaboration envelope smoke

use theorem::lrat::*

fn main() -> i64 with Mod {
    let manifest_fp = lrat_frat_elaboration_manifest_fingerprint(3, 2, 1, 4, 5, 0)
    if manifest_fp != 975208343 { return 1 }

    let hint_trace_fp = lrat_frat_hint_trace_fingerprint(
        manifest_fp, 4, 5, 2, 2, 2, 2)
    if hint_trace_fp != 459486070 { return 2 }

    let envelope_fp = lrat_frat_unsat_envelope_fingerprint(
        manifest_fp, hint_trace_fp, 5, 0, 1)
    if envelope_fp != 86860040 { return 3 }

    if lrat_frat_elaboration_manifest_fingerprint(3, 2, 0, 4, 5, 0) != (0 - 1) { return 4 }
    if lrat_frat_hint_trace_fingerprint(
        manifest_fp, 4, 5, 3, 2, 2, 2) != (0 - 1) { return 5 }
    if lrat_frat_unsat_envelope_fingerprint(
        manifest_fp, hint_trace_fp, 5, 0, 0) != (0 - 1) { return 6 }

    return 0
}
