// channels: z1 0, z2 1, eps_O 2, sigma_O 3, R 4, T 5
fn hess_spce_small() -> i64 with IO, Epistemic, Mut, Div {
    var bad: i64 = 0
    let k1 = measure(0.0, uncertainty: 1.0)
    let k2 = measure(0.0, uncertainty: 1.0)
    let ke = measure(78.20, uncertainty: 0.0)
    let ks = measure(3.166, uncertainty: 0.0)
    let kr = measure(3.91, uncertainty: 0.0)
    let kt = measure(250.0, uncertainty: 0.0)
    let z1 = k1.value
    let z2 = k2.value
    let eh = 34.2 + 2.23364425696364341e+00 * z1
    let sh = 2.96 + -2.52912550826065453e-02 * z1 + 1.12653584638716957e-03 * z2
    bad = bad + report("spce_small d2/dT dz1", hessian_of(ln_langmuir(eh, sh, ke.value, ks.value, kr.value, kt.value, 20.0), 0, 5), -2.45736641754938736e-04)
    bad = bad + report("spce_small d2/dT dz2", hessian_of(ln_langmuir(eh, sh, ke.value, ks.value, kr.value, kt.value, 20.0), 1, 5), -5.63777346837548437e-06)
    bad = bad + report("spce_small d2/dR dz1", hessian_of(ln_langmuir(eh, sh, ke.value, ks.value, kr.value, kt.value, 20.0), 0, 4), -1.02653640756428774e-01)
    bad = bad + report("spce_small d2/dR dz2", hessian_of(ln_langmuir(eh, sh, ke.value, ks.value, kr.value, kt.value, 20.0), 1, 4), 1.63994934450928802e-03)
    bad
}

