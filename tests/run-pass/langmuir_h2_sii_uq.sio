fn main() -> i64 with IO, Epistemic, Mut, Div {
    var bad: i64 = 0
    bad = bad + uq_small()
    bad = bad + uq_large()
    bad = bad + hess_spce_small()
    bad = bad + hess_tip4pice_small()
    bad = bad + hess_tip5p_small()
    bad = bad + hess_spce_large()
    bad = bad + hess_tip4pice_large()
    bad = bad + hess_tip5p_large()
    if bad > 0 { return 1 }
    print("LANGMUIR_H2_SII_UQ_OK\n")
    0
}
