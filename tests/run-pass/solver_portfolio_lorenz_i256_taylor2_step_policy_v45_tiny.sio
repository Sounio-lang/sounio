//@ run-pass
//@ description: Tiny portfolio v45 smoke for Lorenz i256 Taylor-2 step-policy entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 541
    receipt_fp = mix(receipt_fp, 403306384, 3011)
    receipt_fp = mix(receipt_fp, 635367450, 3011)
    receipt_fp = mix(receipt_fp, 485944472, 3011)
    receipt_fp = mix(receipt_fp, 898788381, 3011)
    receipt_fp = mix(receipt_fp, 101774289, 3011)
    receipt_fp = mix(receipt_fp, 13149, 3011)
    receipt_fp = mix(receipt_fp, 63, 3011)
    if receipt_fp != 486061656 { return 1 }

    var audit_fp: i64 = 547
    audit_fp = mix(audit_fp, receipt_fp, 3023)
    audit_fp = mix(audit_fp, 403306384, 3023)
    audit_fp = mix(audit_fp, 635367450, 3023)
    audit_fp = mix(audit_fp, 873855189, 3023)
    audit_fp = mix(audit_fp, 311965616, 3023)
    audit_fp = mix(audit_fp, 101774289, 3023)
    audit_fp = mix(audit_fp, 13149, 3023)
    audit_fp = mix(audit_fp, 63, 3023)
    if audit_fp != 85088711 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 48, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 48, 1103)
    if entry_fp != 699995048 { return 3 }

    if audit_fp == 85088712 { return 4 }
    return 0
}
