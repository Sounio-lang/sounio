//@ run-pass
//@ expect-stdout: unit div cancel: PASS

// Dividing equal units cancels the dimension and produces a plain scalar.
fn main() -> i32 with IO, Mut, Panic, Div {
    let dose_a: mg = 500.0
    let dose_b: mg = 250.0
    let ratio = dose_a / dose_b
    let shifted = ratio + 1.0
    if shifted == 3.0 {
        print("unit div cancel: PASS\n")
    }
    return 0
}
