//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_CALL_TWICE_KNIGHT_IV_PASS
//
// Prediction (source identity across calls, Knightian runtime affine cancellation):
// Pure-Knightian `twice(a) - a` has empty aleatory noise set (no E230) and
// affine interval cancellation yields `[1.0, 3.0]`; `twice(a) + twice(b)` yields `[6.0, 16.0]`.

fn twice(x: Knowledge<f64>) -> Knowledge<f64> {
    x * 2.0
}

fn main() -> i64 with IO, Epistemic {
    let a = knight("a", 1.0, 3.0)
    let b = knight("b", 2.0, 5.0)
    let s = twice(a) + twice(b)
    let d = twice(a) - a
    if s.iv.0 > 6.0 || s.iv.1 < 16.0 { return 1 }
    if s.iv.0 < 5.999999 || s.iv.1 > 16.000001 { return 2 }
    if d.iv.0 > 1.0 || d.iv.1 < 3.0 { return 3 }
    if d.iv.0 < 0.999999 || d.iv.1 > 3.000001 { return 4 }
    println("IDENT_CALL_TWICE_KNIGHT_IV_PASS")
    0
}
