//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v47 smoke for Lorenz i256 Taylor-2 step-schedule entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v47_lorenz_i256_taylor2_step_schedule_fingerprint(
        353612555, 335541872, 889790136, 470000532, 984799877, 2, 127)
    if receipt_fp != 842631931 { return 1 }

    let audit_fp = solver_portfolio_v47_lorenz_i256_taylor2_step_schedule_audit_fingerprint(
        receipt_fp, 353612555, 335541872, 279109641, 207228249,
        984799877, 2, 127)
    if audit_fp != 13881891 { return 2 }

    let manifest_fp = solver_portfolio_v47_lorenz_i256_taylor2_step_schedule_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 189376492 { return 3 }

    let result_fp = solver_portfolio_v47_result_coverage_fingerprint(
        47, 51, 10, 39, 1, 1, manifest_fp)
    if result_fp != 290795842 { return 4 }

    let family_fp = solver_portfolio_v47_checker_family_coverage_fingerprint(
        47, 51, 6, 4, 3, 2, 34, 2, manifest_fp)
    if family_fp != 889521169 { return 5 }

    let acceptance_fp = solver_portfolio_v47_acceptance_receipt_fingerprint(
        47, manifest_fp, result_fp)
    if acceptance_fp != 361662795 { return 6 }

    let audit_receipt_fp = solver_portfolio_v47_audit_receipt_fingerprint(
        47, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 274212065 { return 7 }

    let readiness_fp = solver_portfolio_v47_readiness_fingerprint(
        47, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 224324310 { return 8 }

    return 0
}
