//@ run-pass
//@ requires: madaros
//@ expect-stdout: AGGREGATE_SELF_ASSIGN_OK
//@ description: aggregate self-assignment is a semantic no-op and does not perturb the value

struct S { a: [i64; 4], k: i64 }

fn main() -> i32 with IO, Mut {
    var x = S { a: [1, 2, 3, 4], k: 7 }
    var i: i64 = 0
    while i < 10000 {
        x = x
        i = i + 1
    }
    if x.a[0] == 1 && x.a[3] == 4 && x.k == 7 {
        println("AGGREGATE_SELF_ASSIGN_OK")
    } else {
        println("AGGREGATE_SELF_ASSIGN_FAIL")
    }
    0
}
