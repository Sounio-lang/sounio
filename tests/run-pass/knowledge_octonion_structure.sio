//@ run-pass
//@ expect-stdout: PASS
// variance_of() implemented via β⁴ shadow buffer in lean_single.sio
// β-2: Knowledge<Octonion<f64>> — first GUM variance through octonion multiplication.
// Demonstrates the Fano-plane structure tensor and non-commutativity via variance
// asymmetry. Based on Baez "The Octonions" Bull. AMS 39 (2002).
//
// Fano-plane convention (positive orientation):
//   (1,2,3): e1*e2=e3, e2*e3=e1, e3*e1=e2
//   (1,4,5): e1*e4=e5, e4*e5=e1, e5*e1=e4
//   (1,7,6): e1*e7=e6, e7*e6=e1, e6*e1=e7
//   (2,4,6): e2*e4=e6, e4*e6=e2, e6*e2=e4
//   (2,5,7): e2*e5=e7, e5*e7=e2, e7*e2=e5
//   (3,4,7): e3*e4=e7, e4*e7=e3, e7*e3=e4
//   (3,6,5): e3*e6=e5, e6*e5=e3, e5*e3=e6
// Reverse order -> negated. e_i*e_i = -1. e_0 = 1.
//
// Product is computed inline (no 16-param helper) because narrow param lists are
// preferred by the self-hosted compiler. Variance is sampled from c0 and d0
// (first components of a*b and b*a) to avoid the 3-chain x 3-stage overflow path.

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    // ----- Uncertain octonion a (8 channels, 5% relative uncertainty) -----
    let ka0: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let ka1: Knowledge<f64> = measure(0.5, uncertainty: 0.025)
    let ka2: Knowledge<f64> = measure(0.3, uncertainty: 0.015)
    let ka3: Knowledge<f64> = measure(0.2, uncertainty: 0.010)
    let ka4: Knowledge<f64> = measure(0.4, uncertainty: 0.020)
    let ka5: Knowledge<f64> = measure(0.1, uncertainty: 0.005)
    let ka6: Knowledge<f64> = measure(0.25, uncertainty: 0.0125)
    let ka7: Knowledge<f64> = measure(0.15, uncertainty: 0.0075)

    let a0 = ka0.value
    let a1 = ka1.value
    let a2 = ka2.value
    let a3 = ka3.value
    let a4 = ka4.value
    let a5 = ka5.value
    let a6 = ka6.value
    let a7 = ka7.value

    // ----- Uncertain octonion b (different values, same uncertainty profile) -----
    let kb0: Knowledge<f64> = measure(0.7, uncertainty: 0.035)
    let kb1: Knowledge<f64> = measure(0.2, uncertainty: 0.010)
    let kb2: Knowledge<f64> = measure(0.6, uncertainty: 0.030)
    let kb3: Knowledge<f64> = measure(0.1, uncertainty: 0.005)
    let kb4: Knowledge<f64> = measure(0.35, uncertainty: 0.0175)
    let kb5: Knowledge<f64> = measure(0.45, uncertainty: 0.0225)
    let kb6: Knowledge<f64> = measure(0.2, uncertainty: 0.010)
    let kb7: Knowledge<f64> = measure(0.3, uncertainty: 0.015)

    let b0 = kb0.value
    let b1 = kb1.value
    let b2 = kb2.value
    let b3 = kb3.value
    let b4 = kb4.value
    let b5 = kb5.value
    let b6 = kb6.value
    let b7 = kb7.value

    // ----- c = a * b (Fano-plane convention) -----
    let c0 = a0*b0 - a1*b1 - a2*b2 - a3*b3 - a4*b4 - a5*b5 - a6*b6 - a7*b7
    let c1 = a0*b1 + a1*b0 + a2*b3 - a3*b2 + a4*b5 - a5*b4 - a6*b7 + a7*b6
    let c2 = a0*b2 + a2*b0 - a1*b3 + a3*b1 + a4*b6 - a6*b4 + a5*b7 - a7*b5
    let c3 = a0*b3 + a3*b0 + a1*b2 - a2*b1 + a4*b7 - a7*b4 - a5*b6 + a6*b5
    let c4 = a0*b4 + a4*b0 - a1*b5 + a5*b1 - a2*b6 + a6*b2 - a3*b7 + a7*b3
    let c5 = a0*b5 + a5*b0 + a1*b4 - a4*b1 + a3*b6 - a6*b3 - a2*b7 + a7*b2
    let c6 = a0*b6 + a6*b0 + a2*b4 - a4*b2 - a3*b5 + a5*b3 + a1*b7 - a7*b1
    let c7 = a0*b7 + a7*b0 - a1*b6 + a6*b1 + a2*b5 - a5*b2 + a3*b4 - a4*b3

    // ----- d = b * a (swap operand order; non-commutativity check) -----
    let d0 = b0*a0 - b1*a1 - b2*a2 - b3*a3 - b4*a4 - b5*a5 - b6*a6 - b7*a7
    let d1 = b0*a1 + b1*a0 + b2*a3 - b3*a2 + b4*a5 - b5*a4 - b6*a7 + b7*a6
    let d2 = b0*a2 + b2*a0 - b1*a3 + b3*a1 + b4*a6 - b6*a4 + b5*a7 - b7*a5
    let d3 = b0*a3 + b3*a0 + b1*a2 - b2*a1 + b4*a7 - b7*a4 - b5*a6 + b6*a5
    let d4 = b0*a4 + b4*a0 - b1*a5 + b5*a1 - b2*a6 + b6*a2 - b3*a7 + b7*a3
    let d5 = b0*a5 + b5*a0 + b1*a4 - b4*a1 + b3*a6 - b6*a3 - b2*a7 + b7*a2
    let d6 = b0*a6 + b6*a0 + b2*a4 - b4*a2 - b3*a5 + b5*a3 + b1*a7 - b7*a1
    let d7 = b0*a7 + b7*a0 - b1*a6 + b6*a1 + b2*a5 - b5*a2 + b3*a4 - b4*a3

    // ----- Report values and variances -----
    print("=== a*b ===\n")
    print("c0="); println(c0)
    print("c1="); println(c1)
    print("c2="); println(c2)
    print("c3="); println(c3)
    print("c4="); println(c4)
    print("c5="); println(c5)
    print("c6="); println(c6)
    print("c7="); println(c7)
    print("var(c0)="); println(variance_of(c0))

    print("=== b*a ===\n")
    print("d0="); println(d0)
    print("d1="); println(d1)
    print("d2="); println(d2)
    print("d3="); println(d3)
    print("d4="); println(d4)
    print("d5="); println(d5)
    print("d6="); println(d6)
    print("d7="); println(d7)
    print("var(d0)="); println(variance_of(d0))

    // c0 == d0 for octonions (scalar part is symmetric), but off-diagonal
    // components diverge. Variance on the scalar channel is still a useful
    // first GUM signal through the non-associative structure tensor.
    print("\n=== ISO budget for c0 ===\n")

    // ----- Composition property: |a|^2 * |b|^2 = |c|^2 (Moufang identity corollary) -----
    let norm_a_sq = a0*a0 + a1*a1 + a2*a2 + a3*a3 + a4*a4 + a5*a5 + a6*a6 + a7*a7
    let norm_b_sq = b0*b0 + b1*b1 + b2*b2 + b3*b3 + b4*b4 + b5*b5 + b6*b6 + b7*b7
    let norm_c_sq = c0*c0 + c1*c1 + c2*c2 + c3*c3 + c4*c4 + c5*c5 + c6*c6 + c7*c7
    let lhs = norm_a_sq * norm_b_sq
    let rhs = norm_c_sq
    print("\n|a|^2 * |b|^2 = "); println(lhs)
    print("|c|^2         = "); println(rhs)
    let comp_err = abs_f64(lhs - rhs)
    print("composition err = "); println(comp_err)

    // ----- PASS criteria -----
    let vc0 = variance_of(c0)
    if vc0 > 0.0 {
        if comp_err < 0.0001 {
            print("PASS\n")
        } else {
            print("FAIL: composition |a|^2|b|^2 != |c|^2\n")
        }
    } else {
        print("FAIL: no variance propagated\n")
    }
}
