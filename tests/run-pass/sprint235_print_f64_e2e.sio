//@ run-pass
// Sprint 235: End-to-end print_f64 test
// Builds a minimal ELF containing print_f64 bytecode + main stub, writes to disk, executes

struct CodeBuffer {
    bytes: [i8; 4096],
    len: i64
}

fn code_buffer_new() -> CodeBuffer {
    CodeBuffer { bytes: [0; 4096], len: 0 }
}

fn emit_byte(buf: CodeBuffer, b: i64) -> CodeBuffer with Mut {
    var c = buf
    c.bytes[c.len as usize] = b as i8
    c.len = c.len + 1
    c
}

// Exact copy of ast_emit_print_f64_builtin
fn ast_emit_print_f64_builtin(code: CodeBuffer) -> CodeBuffer with Mut, Panic, Div {
    var c = code
    c = emit_byte(c, 0x55); c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xe5)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x83); c = emit_byte(c, 0xec); c = emit_byte(c, 0x50)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x6e); c = emit_byte(c, 0xc7)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x7e); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x85); c = emit_byte(c, 0xc0)
    let skip_neg = c.len
    c = emit_byte(c, 0x79); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xff); c = emit_byte(c, 0x2d)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xff)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x25); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff)
    c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0xff); c = emit_byte(c, 0x7f)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x6e); c = emit_byte(c, 0xc0)
    c.bytes[(skip_neg + 1) as usize] = ((c.len - (skip_neg + 2)) & 0xFF) as i8
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x2c); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x4c); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x55); c = emit_byte(c, 0xd8)
    c = emit_byte(c, 0x49); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc0)
    c = emit_byte(c, 0x41); c = emit_byte(c, 0x80); c = emit_byte(c, 0xc0); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x45); c = emit_byte(c, 0x88); c = emit_byte(c, 0x02)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xd8)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfe); c = emit_byte(c, 0x2e)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xfe)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x2a); c = emit_byte(c, 0xc8)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x5c); c = emit_byte(c, 0xc1)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x80); c = emit_byte(c, 0x84); c = emit_byte(c, 0x2e); c = emit_byte(c, 0x41)
    c = emit_byte(c, 0x66); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x6e); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x59); c = emit_byte(c, 0xc2)
    c = emit_byte(c, 0xf2); c = emit_byte(c, 0x48); c = emit_byte(c, 0x0f); c = emit_byte(c, 0x2c); c = emit_byte(c, 0xc8)
    // Extract 6 fractional digits from rcx (= frac * 1e6)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc8)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0xa0); c = emit_byte(c, 0x86); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xf7)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0x10); c = emit_byte(c, 0x27); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xf8)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0xe8); c = emit_byte(c, 0x03); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xf9)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0x64); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfa)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xd0)
    c = emit_byte(c, 0x31); c = emit_byte(c, 0xd2)
    c = emit_byte(c, 0xb9); c = emit_byte(c, 0x0a); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xf7); c = emit_byte(c, 0xf1)
    c = emit_byte(c, 0x04); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfb)
    c = emit_byte(c, 0x80); c = emit_byte(c, 0xc2); c = emit_byte(c, 0x30)
    c = emit_byte(c, 0x88); c = emit_byte(c, 0x55); c = emit_byte(c, 0xfc)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xf7)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x06); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xc6); c = emit_byte(c, 0x45); c = emit_byte(c, 0xfd); c = emit_byte(c, 0x0a)
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x8d); c = emit_byte(c, 0x75); c = emit_byte(c, 0xfd)
    c = emit_byte(c, 0xba); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x01); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c = emit_byte(c, 0xc9); c = emit_byte(c, 0xc3)
    c
}

// Build a main that loads f64 1.5 into rdi and calls print_f64, then exit(0)
fn emit_main(code: CodeBuffer, print_f64_off: i64) -> CodeBuffer with Mut {
    var c = code
    // mov rax, IEEE754(1.5) = 0x3FF8000000000000
    c = emit_byte(c, 0x48); c = emit_byte(c, 0xb8)
    c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0xf8); c = emit_byte(c, 0x3f)
    // mov rdi, rax
    c = emit_byte(c, 0x48); c = emit_byte(c, 0x89); c = emit_byte(c, 0xc7)
    // call print_f64 (rel32)
    let call_site = c.len
    c = emit_byte(c, 0xe8)
    let rel = print_f64_off - (call_site + 5)
    c = emit_byte(c, rel & 0xFF)
    c = emit_byte(c, (rel >> 8) & 0xFF)
    c = emit_byte(c, (rel >> 16) & 0xFF)
    c = emit_byte(c, (rel >> 24) & 0xFF)
    // mov edi, 0 (exit code)
    c = emit_byte(c, 0xbf); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    // mov eax, 60 (sys_exit)
    c = emit_byte(c, 0xb8); c = emit_byte(c, 0x3c); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00); c = emit_byte(c, 0x00)
    // syscall
    c = emit_byte(c, 0x0f); c = emit_byte(c, 0x05)
    c
}

fn emit_u16(buf: [i8; 4096], off: i64, v: i64) -> [i8; 4096] with Mut {
    var b = buf
    b[(off) as usize] = (v & 0xFF) as i8
    b[(off + 1) as usize] = ((v >> 8) & 0xFF) as i8
    b
}

fn emit_u32(buf: [i8; 4096], off: i64, v: i64) -> [i8; 4096] with Mut {
    var b = buf
    b[(off) as usize] = (v & 0xFF) as i8
    b[(off + 1) as usize] = ((v >> 8) & 0xFF) as i8
    b[(off + 2) as usize] = ((v >> 16) & 0xFF) as i8
    b[(off + 3) as usize] = ((v >> 24) & 0xFF) as i8
    b
}

fn emit_u64(buf: [i8; 4096], off: i64, v: i64) -> [i8; 4096] with Mut {
    var b = buf
    b[(off) as usize] = (v & 0xFF) as i8
    b[(off + 1) as usize] = ((v >> 8) & 0xFF) as i8
    b[(off + 2) as usize] = ((v >> 16) & 0xFF) as i8
    b[(off + 3) as usize] = ((v >> 24) & 0xFF) as i8
    b[(off + 4) as usize] = ((v >> 32) & 0xFF) as i8
    b[(off + 5) as usize] = ((v >> 40) & 0xFF) as i8
    b[(off + 6) as usize] = ((v >> 48) & 0xFF) as i8
    b[(off + 7) as usize] = ((v >> 56) & 0xFF) as i8
    b
}

fn main() -> i64 with IO, Mut, Panic, Div {
    // Build code: print_f64 at offset 0, then main stub
    var code = code_buffer_new()
    code = ast_emit_print_f64_builtin(code)
    let main_off = code.len
    code = emit_main(code, 0)  // print_f64 is at code offset 0

    let code_size = code.len
    let vaddr_base: i64 = 0x400000
    let code_file_off: i64 = 0x80  // After ELF header (64 bytes) + 1 program header (56 bytes) = 120 = 0x78, round up
    let entry_vaddr = vaddr_base + code_file_off + main_off

    // Build minimal ELF64 header
    var elf: [i8; 4096] = [0; 4096]

    // ELF magic: 7f 45 4c 46
    elf[0 as usize] = 0x7f as i8
    elf[1 as usize] = 0x45 as i8  // E
    elf[2 as usize] = 0x4c as i8  // L
    elf[3 as usize] = 0x46 as i8  // F

    // EI_CLASS=2 (64-bit), EI_DATA=1 (LE), EI_VERSION=1, EI_OSABI=0
    elf[4 as usize] = 2 as i8
    elf[5 as usize] = 1 as i8
    elf[6 as usize] = 1 as i8
    elf[7 as usize] = 0 as i8

    // e_type=2 (ET_EXEC), e_machine=0x3E (x86-64)
    elf = emit_u16(elf, 16, 2)
    elf = emit_u16(elf, 18, 0x3E)
    // e_version=1
    elf = emit_u32(elf, 20, 1)
    // e_entry
    elf = emit_u64(elf, 24, entry_vaddr)
    // e_phoff = 64 (right after ELF header)
    elf = emit_u64(elf, 32, 64)
    // e_shoff = 0 (no section headers)
    elf = emit_u64(elf, 40, 0)
    // e_flags = 0
    elf = emit_u32(elf, 48, 0)
    // e_ehsize = 64
    elf = emit_u16(elf, 52, 64)
    // e_phentsize = 56
    elf = emit_u16(elf, 54, 56)
    // e_phnum = 1
    elf = emit_u16(elf, 56, 1)
    // e_shentsize = 0
    elf = emit_u16(elf, 58, 0)
    // e_shnum = 0
    elf = emit_u16(elf, 60, 0)
    // e_shstrndx = 0
    elf = emit_u16(elf, 62, 0)

    // Program header (LOAD) at offset 64
    // p_type = 1 (PT_LOAD)
    elf = emit_u32(elf, 64, 1)
    // p_flags = 5 (PF_R | PF_X)
    elf = emit_u32(elf, 68, 5)
    // p_offset = 0
    elf = emit_u64(elf, 72, 0)
    // p_vaddr = vaddr_base
    elf = emit_u64(elf, 80, vaddr_base)
    // p_paddr = vaddr_base
    elf = emit_u64(elf, 88, vaddr_base)
    // p_filesz = code_file_off + code_size
    let total_file = code_file_off + code_size
    elf = emit_u64(elf, 96, total_file)
    // p_memsz = total_file
    elf = emit_u64(elf, 104, total_file)
    // p_align = 0x1000
    elf = emit_u64(elf, 112, 0x1000)

    // Copy code bytes into ELF at code_file_off
    var ci: i64 = 0
    while ci < code_size {
        elf[(code_file_off + ci) as usize] = code.bytes[ci as usize]
        ci = ci + 1
    }

    let elf_size = code_file_off + code_size

    // Write ELF to file using VM builtin
    let wr = write_file("/tmp/sprint235_f64.elf", elf, elf_size)
    if wr != 0 {
        print("FAIL: could not write ELF\n")
        return 1
    }

    print("PASS: ELF written size=")
    print_int(elf_size)
    print(" entry=0x")
    print_int(entry_vaddr)
    print(" code=")
    print_int(code_size)
    print("\n")
    0
}
