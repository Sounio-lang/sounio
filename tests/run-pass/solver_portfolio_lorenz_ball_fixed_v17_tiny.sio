//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v17 smoke for Lorenz ball-fixed trajectory manifest entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 20 { return 0 - 1 }
    if instance_fp != 236665224 { return 0 - 1 }
    if certificate_fp != 508132668 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 20 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v17_bundle_fingerprint(instance_fp: i64,
                                    trajectory_manifest_fp: i64) -> i64 with Mod {
    let ball_entry_fp = portfolio_entry_fingerprint(
        20, instance_fp, trajectory_manifest_fp, 1, 20)
    if ball_entry_fp != 590228875 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 17, 1151)
    fp = portfolio_mix(fp, 21, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, ball_entry_fp, 1151)
    return fp
}

fn portfolio_v17_result_coverage_fingerprint(version: i64,
                                             entry_count: i64,
                                             unsat_count: i64,
                                             validated_count: i64,
                                             optimal_count: i64,
                                             sat_count: i64,
                                             manifest_fp: i64) -> i64 with Mod {
    if version != 17 { return 0 - 1 }
    if entry_count != 21 { return 0 - 1 }
    if unsat_count != 7 { return 0 - 1 }
    if validated_count != 12 { return 0 - 1 }
    if optimal_count != 1 { return 0 - 1 }
    if sat_count != 1 { return 0 - 1 }
    if manifest_fp != 247161833 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, version, 1871)
    fp = portfolio_mix(fp, entry_count, 1871)
    fp = portfolio_mix(fp, unsat_count, 1871)
    fp = portfolio_mix(fp, validated_count, 1871)
    fp = portfolio_mix(fp, optimal_count, 1871)
    fp = portfolio_mix(fp, sat_count, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v17_checker_family_coverage_fingerprint(
    version: i64, entry_count: i64,
    sat_family_count: i64, smt_family_count: i64, pb_family_count: i64,
    graph_family_count: i64, lorenz_family_count: i64,
    manifest_fp: i64) -> i64 with Mod {
    if version != 17 { return 0 - 1 }
    if entry_count != 21 { return 0 - 1 }
    if sat_family_count != 4 { return 0 - 1 }
    if smt_family_count != 2 { return 0 - 1 }
    if pb_family_count != 2 { return 0 - 1 }
    if graph_family_count != 1 { return 0 - 1 }
    if lorenz_family_count != 12 { return 0 - 1 }
    if manifest_fp != 247161833 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, version, 1907)
    fp = portfolio_mix(fp, entry_count, 1907)
    fp = portfolio_mix(fp, sat_family_count, 1907)
    fp = portfolio_mix(fp, smt_family_count, 1907)
    fp = portfolio_mix(fp, pb_family_count, 1907)
    fp = portfolio_mix(fp, graph_family_count, 1907)
    fp = portfolio_mix(fp, lorenz_family_count, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v17_acceptance_receipt_fingerprint(version: i64,
                                                manifest_fp: i64,
                                                coverage_fp: i64) -> i64 with Mod {
    if version != 17 { return 0 - 1 }
    if manifest_fp != 247161833 { return 0 - 1 }
    if coverage_fp != 575168545 { return 0 - 1 }

    var fp: i64 = 137
    fp = portfolio_mix(fp, version, 1889)
    fp = portfolio_mix(fp, manifest_fp, 1889)
    fp = portfolio_mix(fp, coverage_fp, 1889)
    return fp
}

fn portfolio_v17_audit_receipt_fingerprint(version: i64,
                                           manifest_fp: i64,
                                           result_coverage_fp: i64,
                                           family_coverage_fp: i64,
                                           acceptance_receipt_fp: i64) -> i64 with Mod {
    if version != 17 { return 0 - 1 }
    if manifest_fp != 247161833 { return 0 - 1 }
    if result_coverage_fp != 575168545 { return 0 - 1 }
    if family_coverage_fp != 805421150 { return 0 - 1 }
    if acceptance_receipt_fp != 154169825 { return 0 - 1 }

    var fp: i64 = 157
    fp = portfolio_mix(fp, version, 1931)
    fp = portfolio_mix(fp, manifest_fp, 1931)
    fp = portfolio_mix(fp, result_coverage_fp, 1931)
    fp = portfolio_mix(fp, family_coverage_fp, 1931)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1931)
    return fp
}

fn portfolio_v17_readiness_fingerprint(version: i64,
                                       manifest_fp: i64,
                                       result_coverage_fp: i64,
                                       family_coverage_fp: i64,
                                       acceptance_receipt_fp: i64,
                                       audit_receipt_fp: i64) -> i64 with Mod {
    if version != 17 { return 0 - 1 }
    if manifest_fp != 247161833 { return 0 - 1 }
    if result_coverage_fp != 575168545 { return 0 - 1 }
    if family_coverage_fp != 805421150 { return 0 - 1 }
    if acceptance_receipt_fp != 154169825 { return 0 - 1 }
    if audit_receipt_fp != 426158721 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, version, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let entry_fp = portfolio_entry_fingerprint(20, 236665224, 508132668, 1, 20)
    if entry_fp != 590228875 { return 1 }

    let manifest_fp = portfolio_v17_bundle_fingerprint(236665224, 508132668)
    if manifest_fp != 247161833 { return 2 }

    let result_coverage_fp = portfolio_v17_result_coverage_fingerprint(
        17, 21, 7, 12, 1, 1, manifest_fp)
    if result_coverage_fp != 575168545 { return 3 }

    let family_coverage_fp = portfolio_v17_checker_family_coverage_fingerprint(
        17, 21, 4, 2, 2, 1, 12, manifest_fp)
    if family_coverage_fp != 805421150 { return 4 }

    let acceptance_fp = portfolio_v17_acceptance_receipt_fingerprint(
        17, manifest_fp, result_coverage_fp)
    if acceptance_fp != 154169825 { return 5 }

    let audit_fp = portfolio_v17_audit_receipt_fingerprint(
        17, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 426158721 { return 6 }

    let readiness_fp = portfolio_v17_readiness_fingerprint(
        17, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 879808511 { return 7 }

    if portfolio_entry_fingerprint(20, 236665224, 508132668, 0, 20) != (0 - 1) { return 8 }
    if portfolio_v17_bundle_fingerprint(236665224, 508132669) != (0 - 1) { return 9 }
    if portfolio_v17_result_coverage_fingerprint(
        17, 21, 7, 11, 1, 1, manifest_fp) != (0 - 1) { return 10 }
    if portfolio_v17_checker_family_coverage_fingerprint(
        17, 21, 4, 2, 2, 1, 11, manifest_fp) != (0 - 1) { return 11 }
    if portfolio_v17_readiness_fingerprint(
        17, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 12 }

    return 0
}
