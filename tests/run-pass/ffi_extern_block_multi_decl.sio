//@ run-pass
// A brace-form extern "C" block with TWO declarations — Track A dispatch M1.
//
// The parser used to retain only the FIRST declaration of a brace-form block
// (parse_extern_fn_item); every later name was dropped and failed at its
// call site with E137 use-of-undeclared-variable. This is the shape of
// stdlib/os/process.sio (getpid, getppid, exit, abort) and
// stdlib/sync/mutex.sio (malloc, free, pthread_mutex_*), which could not
// even type-check under the default engine. Track A rewrites every
// declaration into an ffi-forwarding wrapper, so both names must resolve
// and both calls must return real nonzero PIDs.

extern "C" {
    fn getpid() -> i64;
    fn getppid() -> i64;
}

fn main() -> i32 with IO, Panic {
    let pid = getpid()
    let ppid = getppid()
    if pid > 0 && ppid > 0 {
        println("ffi_extern_block_multi_decl: PASS")
        return 0
    }
    println("ffi_extern_block_multi_decl: FAIL")
    return 1
}
