//@ run-pass
//@ requires: madaros
// RFC 4231 Test Case 1 and Test Case 6 for HMAC-SHA-256 and HMAC-SHA-384.
//
// All hex vectors below were independently re-verified against Python's
// stdlib `hmac`/`hashlib` (a standards-conformant primary implementation)
// before being transcribed here -- not copied from the task brief as-is.
// That check caught a real transcription error in the brief's own
// `expected_sha384` array for Test Case 1 (an off-by-one-nibble slip
// starting at byte index 12); the value used below is the corrected one.
// Block sizes used by hkdf.sio (64 bytes for SHA-256, 128 for SHA-384)
// were confirmed against `hashlib.sha256().block_size` /
// `hashlib.sha384().block_size`.
use crypto::hkdf::*
use net::socket::*

fn write_str(buf: &RawBuf, s: string) -> i64 with IO {
    let n = str_len(s)
    var i: i64 = 0
    while i < n {
        rawbuf_set(buf, i, str_char_at(s, i))
        i = i + 1
    }
    n
}

fn assert_bytes32(actual: [u8; 32], expected: [u8; 32], case_id: i64) -> i64 with IO {
    var i: i64 = 0
    while i < 32 {
        if actual[i as usize] != expected[i as usize] {
            print_int(case_id)
            return 1
        }
        i = i + 1
    }
    0
}

fn assert_bytes48(actual: [u8; 48], expected: [u8; 48], case_id: i64) -> i64 with IO {
    var i: i64 = 0
    while i < 48 {
        if actual[i as usize] != expected[i as usize] {
            print_int(case_id)
            return 1
        }
        i = i + 1
    }
    0
}

fn main() -> i64 with IO {
    // ---- RFC 4231 Test Case 1 ----
    // Key = 0x0b repeated 20 times; Data = "Hi There" (ASCII, 8 bytes)
    var key_bytes1: [u8; 20] = [0x0b; 20]
    let key_buf1 = rawbuf_new(20)
    var i: i64 = 0
    while i < 20 {
        rawbuf_set(&key_buf1, i, key_bytes1[i as usize] as i64)
        i = i + 1
    }

    let msg_str1 = "Hi There"
    let msg_len1: i64 = 8
    let msg_buf1 = rawbuf_new(msg_len1)
    write_str(&msg_buf1, msg_str1)

    // HMAC-SHA-256: b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7
    let expected_sha256_1: [u8; 32] = [
        0xb0,0x34,0x4c,0x61,0xd8,0xdb,0x38,0x53,0x5c,0xa8,0xaf,0xce,0xaf,0x0b,0xf1,0x2b,
        0x88,0x1d,0xc2,0x00,0xc9,0x83,0x3d,0xa7,0x26,0xe9,0x37,0x6c,0x2e,0x32,0xcf,0xf7
    ]
    let result_sha256_1 = hmac_sha256_rawbuf(&key_buf1, 20, &msg_buf1, msg_len1)
    if assert_bytes32(result_sha256_1, expected_sha256_1, 1) != 0 {
        return 1
    }

    // HMAC-SHA-384: afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6
    // (corrected transcription -- see file header)
    let expected_sha384_1: [u8; 48] = [
        0xaf,0xd0,0x39,0x44,0xd8,0x48,0x95,0x62,0x6b,0x08,0x25,0xf4,0xab,0x46,0x90,0x7f,
        0x15,0xf9,0xda,0xdb,0xe4,0x10,0x1e,0xc6,0x82,0xaa,0x03,0x4c,0x7c,0xeb,0xc5,0x9c,
        0xfa,0xea,0x9e,0xa9,0x07,0x6e,0xde,0x7f,0x4a,0xf1,0x52,0xe8,0xb2,0xfa,0x9c,0xb6
    ]
    let result_sha384_1 = hmac_sha384_rawbuf(&key_buf1, 20, &msg_buf1, msg_len1)
    if assert_bytes48(result_sha384_1, expected_sha384_1, 2) != 0 {
        return 1
    }

    // ---- RFC 4231 Test Case 6 ----
    // Key = 0xaa repeated 131 times (> both SHA-256's 64-byte and
    // SHA-384's 128-byte block size, forcing the key-shortening-via-hash
    // step for both). Data = "Test Using Larger Than Block-Size Key - Hash
    // Key First" (54 bytes).
    var key_bytes6: [u8; 131] = [0xaa; 131]
    let key_buf6 = rawbuf_new(131)
    var k: i64 = 0
    while k < 131 {
        rawbuf_set(&key_buf6, k, key_bytes6[k as usize] as i64)
        k = k + 1
    }

    let msg_str6 = "Test Using Larger Than Block-Size Key - Hash Key First"
    let msg_len6: i64 = 54
    let msg_buf6 = rawbuf_new(msg_len6)
    write_str(&msg_buf6, msg_str6)

    // HMAC-SHA-256: 60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54
    let expected_sha256_6: [u8; 32] = [
        0x60,0xe4,0x31,0x59,0x1e,0xe0,0xb6,0x7f,0x0d,0x8a,0x26,0xaa,0xcb,0xf5,0xb7,0x7f,
        0x8e,0x0b,0xc6,0x21,0x37,0x28,0xc5,0x14,0x05,0x46,0x04,0x0f,0x0e,0xe3,0x7f,0x54
    ]
    let result_sha256_6 = hmac_sha256_rawbuf(&key_buf6, 131, &msg_buf6, msg_len6)
    if assert_bytes32(result_sha256_6, expected_sha256_6, 3) != 0 {
        return 1
    }

    // HMAC-SHA-384: 4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952
    let expected_sha384_6: [u8; 48] = [
        0x4e,0xce,0x08,0x44,0x85,0x81,0x3e,0x90,0x88,0xd2,0xc6,0x3a,0x04,0x1b,0xc5,0xb4,
        0x4f,0x9e,0xf1,0x01,0x2a,0x2b,0x58,0x8f,0x3c,0xd1,0x1f,0x05,0x03,0x3a,0xc4,0xc6,
        0x0c,0x2e,0xf6,0xab,0x40,0x30,0xfe,0x82,0x96,0x24,0x8d,0xf1,0x63,0xf4,0x49,0x52
    ]
    let result_sha384_6 = hmac_sha384_rawbuf(&key_buf6, 131, &msg_buf6, msg_len6)
    if assert_bytes48(result_sha384_6, expected_sha384_6, 4) != 0 {
        return 1
    }

    println("hmac_sha256_sha384_vectors: all cases match RFC 4231")
    return 0
}
