//@ run-pass
//@ expect-stdout: 1
//@ description: FX-9 nesting: frames nest dynamically and a perform selects the nearest enclosing frame for its effect (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-9

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        handle<Ask> { perform Ask.get() } with { on get() -> resume(1) return(x) -> x }
    } with { on get() -> resume(2) return(x) -> x }
    println(r)
    0
}
