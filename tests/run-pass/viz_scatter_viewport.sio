}
fn boundary_serialization() with IO,Mut,Div,Panic {
 var scene=viz_scene_new()
 let xs:[f64;1024]=[0.0;1024]
 let ys:[f64;1024]=[0.0;1024]
 let mark=viz_add_scatter_chart(&!scene,&xs,&ys,1,viz_layout_rect(999990,999990,10,10),viz_style_rgb(70,180,235))
 assert(mark==0 && viz_scatter_set_viewport(&!scene,mark,0.0,1.0,0.0,1.0))
 // Serialization only: no million-pixel Canvas allocation or rendering.
 viz_html_emit_scene(&scene,1000000,1000000)
}
fn main() with IO,Mut,Div,Alloc,Panic {
 transactions()
 exhaustive_disk()
 scientific_scene()
 boundary_serialization()
 println("VIZ_SCATTER_VIEWPORT_PASS")
 0
}
