 unit[11]=86
 unit[12]=41
 viz_node_set_label(&!scene,xa,&obs,17)
 viz_node_set_label(&!scene,ya,&unit,13)
 assert(viz_add_label(&!scene,&title,44,viz_layout_rect(100,20,900,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&subtitle,47,viz_layout_rect(100,52,900,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&zero_label,21,viz_layout_rect(440,94,240,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&huge_label,22,viz_layout_rect(740,94,240,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&mixed_label,44,viz_layout_rect(440,374,540,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&note,45,viz_layout_rect(100,625,900,20),viz_style_rgb(220,230,240))>=0)
 assert(scene.node_count==12 && scene.series_count==4)
 let pixels=heap_alloc(1040*680*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:1040,height:680}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,300*1040+100)==70*65536+180*256+235)
 assert(read_i64(canvas.pixels,140*1040+340)==70*65536+180*256+235)
 assert(read_i64(canvas.pixels,220*1040+520)==220*65536+135*256+225)
 assert(read_i64(canvas.pixels,220*1040+820)==245*65536+170*256+65)
 assert(read_i64(canvas.pixels,500*1040+520)==100*65536+220*256+170)
