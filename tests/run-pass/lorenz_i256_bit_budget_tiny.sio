//@ run-pass
//@ known-failure: source-level i256 Lorenz bit-budget tiny case: main returns 1. Not a segfault/139
//@ requires: madaros
//@ description: Lorenz i256 pre-division numerator bit-budget certificate

fn budget_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn fits_signed_i256_exponent(bound_exp: i64, signed_positive_limit_exp: i64) -> i64 {
    if bound_exp < 0 { return 0 }
    if signed_positive_limit_exp != 255 { return 0 }
    if bound_exp < signed_positive_limit_exp { return 1 }
    return 0
}

fn lorenz_i256_range_instance_fingerprint(scale_log2: i64, rho_bound_log2: i64,
                                          beta_bound_log2: i64, signed_bits: i64,
                                          signed_positive_limit_exp: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if rho_bound_log2 != 5 { return 0 - 1 }
    if beta_bound_log2 != 3 { return 0 - 1 }
    if signed_bits != 256 { return 0 - 1 }
    if signed_positive_limit_exp != 255 { return 0 - 1 }

    var fp: i64 = 127
    fp = budget_mix(fp, scale_log2, 1231)
    fp = budget_mix(fp, rho_bound_log2, 1231)
    fp = budget_mix(fp, beta_bound_log2, 1231)
    fp = budget_mix(fp, signed_bits, 1231)
    fp = budget_mix(fp, signed_positive_limit_exp, 1231)
    return fp
}

fn lorenz_i256_range_certificate_fingerprint(instance_fp: i64,
                                             scale_exp: i64,
                                             square_exp: i64,
                                             dy_exp_bound: i64,
                                             beta_exp: i64,
                                             signed_limit_exp: i64,
                                             dy_headroom: i64,
                                             linked_manifest_ok: i64,
                                             square_fits: i64,
                                             dy_fits: i64,
                                             beta_fits: i64) -> i64 with Mod {
    if instance_fp != 743388522 { return 0 - 1 }
    if scale_exp != 32 { return 0 - 1 }
    if square_exp != 64 { return 0 - 1 }
    if dy_exp_bound != 69 { return 0 - 1 }
    if beta_exp != 35 { return 0 - 1 }
    if signed_limit_exp != 255 { return 0 - 1 }
    if dy_headroom != 186 { return 0 - 1 }
    if linked_manifest_ok != 1 { return 0 - 1 }
    if square_fits != 1 { return 0 - 1 }
    if dy_fits != 1 { return 0 - 1 }
    if beta_fits != 1 { return 0 - 1 }

    var fp: i64 = 131
    fp = budget_mix(fp, instance_fp, 1277)
    fp = budget_mix(fp, scale_exp, 1277)
    fp = budget_mix(fp, square_exp, 1277)
    fp = budget_mix(fp, dy_exp_bound, 1277)
    fp = budget_mix(fp, beta_exp, 1277)
    fp = budget_mix(fp, signed_limit_exp, 1277)
    fp = budget_mix(fp, dy_headroom, 1277)
    fp = budget_mix(fp, linked_manifest_ok, 1277)
    fp = budget_mix(fp, square_fits, 1277)
    fp = budget_mix(fp, dy_fits, 1277)
    fp = budget_mix(fp, beta_fits, 1277)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale
    let rho: i256 = 28 as i256

    let rho_scale_minus_z: i256 = (rho * scale) - z
    let dy_num: i256 = x * rho_scale_minus_z
    let xy_num: i256 = x * y
    let beta_num_z: i256 = (8 as i256) * z
    let expected_square: i256 = scale * scale

    var linked_manifest_ok: i64 = 0
    if rho_scale_minus_z == (27 as i256) * scale {
        if xy_num == expected_square {
            if dy_num == (27 as i256) * expected_square {
                if beta_num_z == (8 as i256) * scale {
                    linked_manifest_ok = 1
                }
            }
        }
    }

    let scale_exp: i64 = 32
    let square_exp: i64 = scale_exp + scale_exp
    let rho_scale_minus_z_bound_exp: i64 = scale_exp + 5
    let dy_exp_bound: i64 = scale_exp + rho_scale_minus_z_bound_exp
    let beta_exp: i64 = scale_exp + 3
    let signed_limit_exp: i64 = 255
    let dy_headroom: i64 = signed_limit_exp - dy_exp_bound

    let square_fits = fits_signed_i256_exponent(square_exp, signed_limit_exp)
    let dy_fits = fits_signed_i256_exponent(dy_exp_bound, signed_limit_exp)
    let beta_fits = fits_signed_i256_exponent(beta_exp, signed_limit_exp)

    let instance_fp = lorenz_i256_range_instance_fingerprint(32, 5, 3, 256, 255)
    let cert_fp = lorenz_i256_range_certificate_fingerprint(
        instance_fp, scale_exp, square_exp, dy_exp_bound, beta_exp,
        signed_limit_exp, dy_headroom, linked_manifest_ok,
        square_fits, dy_fits, beta_fits)

    if linked_manifest_ok != 1 { return 1 }
    if square_exp != 64 { return 2 }
    if rho_scale_minus_z_bound_exp != 37 { return 3 }
    if dy_exp_bound != 69 { return 4 }
    if beta_exp != 35 { return 5 }
    if dy_headroom != 186 { return 6 }
    if square_fits != 1 { return 7 }
    if dy_fits != 1 { return 8 }
    if beta_fits != 1 { return 9 }
    if fits_signed_i256_exponent(255, signed_limit_exp) != 0 { return 10 }
    if instance_fp != 743388522 { return 11 }
    if cert_fp != 133303313 { return 12 }
    if lorenz_i256_range_certificate_fingerprint(
        instance_fp, scale_exp, square_exp, dy_exp_bound + 1, beta_exp,
        signed_limit_exp, dy_headroom, linked_manifest_ok,
        square_fits, dy_fits, beta_fits) != (0 - 1) { return 13 }
    if lorenz_i256_range_instance_fingerprint(32, 6, 3, 256, 255) != (0 - 1) { return 14 }

    return 0
}
