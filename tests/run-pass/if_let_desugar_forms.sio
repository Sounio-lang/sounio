//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: if_let bind: PASS
//@ expect-stdout-contains: if_let no-else taken: PASS
//@ expect-stdout-contains: if_let no-else skipped: PASS
//@ expect-stdout-contains: if_let else-if chain: PASS
//@ expect-stdout-contains: if_let nested: PASS
//@ expect-stdout-contains: if_let value: PASS
//@ expect-stdout-contains: if_let unit enum variant: PASS
//@ expect-stdout-contains: if_let literal: PASS
//@ description: P1.3 -- `if let` desugars to match (binding, no else, else-if chain, nesting, value position, unit enum variant, literal)

enum Light { Red, Amber, Green }

fn some_of(v: i64) -> Option<i64> with IO {
    Some(v)
}

fn none_of() -> Option<i64> with IO {
    None
}

fn classify(a: Option<i64>, b: Option<i64>) -> i64 with IO {
    if let Some(x) = a {
        x
    } else if let Some(y) = b {
        y + 100
    } else {
        999
    }
}

fn main() with IO, Mut {
    if let Some(x) = some_of(7) {
        if x + 1 == 8 { print("if_let bind: PASS\n") } else { print("if_let bind: FAIL\n") }
    } else {
        print("if_let bind: FAIL (branch not taken)\n")
    }

    var hits = 0
    if let Some(x) = some_of(5) {
        hits = hits + x
    }
    if hits == 5 { print("if_let no-else taken: PASS\n") } else { print("if_let no-else taken: FAIL\n") }

    var miss = 0
    if let Some(x) = none_of() {
        miss = miss + x + 1
    }
    if miss == 0 { print("if_let no-else skipped: PASS\n") } else { print("if_let no-else skipped: FAIL\n") }

    let c1 = classify(some_of(3), some_of(4))
    let c2 = classify(none_of(), some_of(4))
    let c3 = classify(none_of(), none_of())
    if c1 == 3 && c2 == 104 && c3 == 999 {
        print("if_let else-if chain: PASS\n")
    } else {
        print("if_let else-if chain: FAIL\n")
    }

    var nested = 0
    if let Some(x) = some_of(2) {
        if let Some(y) = some_of(30) {
            nested = x + y
        }
    }
    if nested == 32 { print("if_let nested: PASS\n") } else { print("if_let nested: FAIL\n") }

    let v = if let Some(x) = some_of(40) { x + 2 } else { 0 }
    if v == 42 { print("if_let value: PASS\n") } else { print("if_let value: FAIL\n") }

    let l = Light::Amber
    var lr = 0
    if let Light::Red = l { lr = 1 } else if let Light::Amber = l { lr = 2 } else { lr = 3 }
    if lr == 2 { print("if_let unit enum variant: PASS\n") } else { print("if_let unit enum variant: FAIL\n") }

    let n = 4
    var lit = 0
    if let 4 = n { lit = 1 }
    if lit == 1 { print("if_let literal: PASS\n") } else { print("if_let literal: FAIL\n") }
}
