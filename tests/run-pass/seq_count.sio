//@ run-pass
// Phase 4c-prep: seq_count(s) / s.count() — the plain i64 length (no epistemic
// wrapper, no `with Epistemic` needed). This is the natural loop bound; .len()
// stays as the Knowledge<i64> epistemic opt-in. Bind the count to a local before
// using it as a `0..n` range bound (the ontology's idiom).

struct Bag { items: Seq<i64>, tag: i64 }

fn main() -> i32 with IO, Mut, Panic {
    var s: Seq<i64> = seq_new()
    s.push(10); s.push(20); s.push(30)
    if seq_count(s) != 3 { return 1 }
    if s.count() != 3 { return 2 }

    // variable-bound loop (works without Epistemic)
    var sum = 0
    let n = s.count()
    var i = 0
    while i < n { sum = sum + s[i as i64]; i = i + 1 }
    if sum != 60 { return 3 }

    let m = s.count()
    var c = 0
    for j in 0..m { c = c + 1 }
    if c != 3 { return 4 }

    // count() on a struct field
    var b: Bag = Bag { items: seq_new(), tag: 0 }
    b.items.push(1); b.items.push(2)
    if b.items.count() != 2 { return 5 }

    return 0
}
