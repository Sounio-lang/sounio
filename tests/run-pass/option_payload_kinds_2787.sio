//@ run-pass
//@ requires: madaros
//@ description: #2787 Option<f64>/Option<bool>/Option<struct> payloads, nested matches, match as expression and statement, `_` arms and literal sub-patterns
//@ expect-stdout: f64_some0=1.000000
//@ expect-stdout: f64_some25=3.500000
//@ expect-stdout: f64_none=100.000000
//@ expect-stdout: f64_nf_some0=1.000000
//@ expect-stdout: f64_nf_none=100.000000
//@ expect-stdout: bool_false=0
//@ expect-stdout: bool_true=1
//@ expect-stdout: bool_none=100
//@ expect-stdout: struct_zero=0
//@ expect-stdout: struct_23=5
//@ expect-stdout: struct_none=100
//@ expect-stdout: nested_00=0
//@ expect-stdout: nested_1n=19
//@ expect-stdout: nested_n0=90
//@ expect-stdout: nested_nn=99
//@ expect-stdout: stmt_a=0
//@ expect-stdout: stmt_b=100
//@ expect-stdout: expr_a=1
//@ expect-stdout: expr_b=100
//@ expect-stdout: wild_none_first=7
//@ expect-stdout: lit_0=zero
//@ expect-stdout: lit_3=three
//@ expect-stdout: lit_9=other
//@ expect-stdout: lit_none=none
//@ expect-stdout: PAYLOAD_KINDS_2787_OK
//
// requires: madaros -- lean_single (the seed, not refreshed here) gets two of
// these wrong: it prints `nan` for a non-zero Option<f64> payload
// (f64_some25=nan) and ignores literal sub-patterns, so `Some(0) =>` matches
// every Some (lit_3=zero, lit_9=zero). Every other line matches lean_single.
// Recorded as KL-19 in docs/compiler/KNOWN_LIMITATIONS.md.

struct P { x: i64, y: i64 }

fn pick_f64(a: Option<f64>) -> f64 {
    match a {
        Some(x) => x + 1.0,
        None => 100.0,
    }
}

fn pick_f64_nf(a: Option<f64>) -> f64 {
    match a {
        None => 100.0,
        Some(x) => x + 1.0,
    }
}

fn pick_bool(a: Option<bool>) -> i64 {
    match a {
        Some(b) => if b { 1 } else { 0 },
        None => 100,
    }
}

fn pick_struct(a: Option<P>) -> i64 {
    match a {
        None => 100,
        Some(p) => p.x + p.y,
    }
}

fn both(a: Option<i64>, b: Option<i64>) -> i64 {
    match a {
        Some(x) => match b {
            Some(y) => x * 10 + y,
            None => x * 10 + 9,
        },
        None => match b {
            None => 99,
            Some(y) => 90 + y,
        },
    }
}

fn lit(a: Option<i64>) -> string {
    match a {
        Some(0) => "zero",
        Some(3) => "three",
        Some(_) => "other",
        None => "none",
    }
}

fn main() -> i32 with IO {
    var bad: i64 = 0

    let f0 = pick_f64(Some(0.0))
    print("f64_some0=")
    println(f0)
    if f0 != 1.0 { bad = bad + 1 }
    let f1 = pick_f64(Some(2.5))
    print("f64_some25=")
    println(f1)
    if f1 != 3.5 { bad = bad + 1 }
    let f2 = pick_f64(None)
    print("f64_none=")
    println(f2)
    if f2 != 100.0 { bad = bad + 1 }
    let f3 = pick_f64_nf(Some(0.0))
    print("f64_nf_some0=")
    println(f3)
    if f3 != 1.0 { bad = bad + 1 }
    let f4 = pick_f64_nf(None)
    print("f64_nf_none=")
    println(f4)
    if f4 != 100.0 { bad = bad + 1 }

    let b0 = pick_bool(Some(false))
    print("bool_false=")
    println(b0)
    if b0 != 0 { bad = bad + 1 }
    let b1 = pick_bool(Some(true))
    print("bool_true=")
    println(b1)
    if b1 != 1 { bad = bad + 1 }
    let b2 = pick_bool(None)
    print("bool_none=")
    println(b2)
    if b2 != 100 { bad = bad + 1 }

    let s0 = pick_struct(Some(P { x: 0, y: 0 }))
    print("struct_zero=")
    println(s0)
    if s0 != 0 { bad = bad + 1 }
    let s1 = pick_struct(Some(P { x: 2, y: 3 }))
    print("struct_23=")
    println(s1)
    if s1 != 5 { bad = bad + 1 }
    let s2 = pick_struct(None)
    print("struct_none=")
    println(s2)
    if s2 != 100 { bad = bad + 1 }

    let n0 = both(Some(0), Some(0))
    print("nested_00=")
    println(n0)
    if n0 != 0 { bad = bad + 1 }
    let n1 = both(Some(1), None)
    print("nested_1n=")
    println(n1)
    if n1 != 19 { bad = bad + 1 }
    let n2 = both(None, Some(0))
    print("nested_n0=")
    println(n2)
    if n2 != 90 { bad = bad + 1 }
    let n3 = both(None, None)
    print("nested_nn=")
    println(n3)
    if n3 != 99 { bad = bad + 1 }

    // match as a statement: arms are side effects, no value
    let oa: Option<i64> = Some(0)
    let ob: Option<i64> = None
    match oa {
        None => {
            print("stmt_a=")
            println(100)
            bad = bad + 1
        }
        Some(x) => {
            print("stmt_a=")
            println(x)
        }
    }
    match ob {
        None => {
            print("stmt_b=")
            println(100)
        }
        Some(x) => {
            print("stmt_b=")
            println(x)
            bad = bad + 1
        }
    }

    // match as an expression with `_` arms
    let r: i64 = match oa { Some(x) => x + 1, _ => 100 }
    print("expr_a=")
    println(r)
    if r != 1 { bad = bad + 1 }
    let q: i64 = match ob { Some(x) => x + 1, _ => 100 }
    print("expr_b=")
    println(q)
    if q != 100 { bad = bad + 1 }
    let t: i64 = match oa { None => 100, _ => 7 }
    print("wild_none_first=")
    println(t)
    if t != 7 { bad = bad + 1 }

    // literal sub-patterns used to be ignored, so `Some(0) =>` matched every Some
    print("lit_0=")
    println(lit(Some(0)))
    print("lit_3=")
    println(lit(Some(3)))
    print("lit_9=")
    println(lit(Some(9)))
    print("lit_none=")
    println(lit(None))

    if bad == 0 {
        println("PAYLOAD_KINDS_2787_OK")
    } else {
        println("PAYLOAD_KINDS_2787_FAIL")
    }
    0
}
