//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_FLOAT_MASK_SHADOW_REBIND PASS
//
// Scalar-slot counterpart of madaros_tuple_arr_mask_shadow_rebind.sio.
//
// Copilot review (PR #2516), comment 4115176690: expr_result_tuple_arr_
// mask_ref (the array-slot mask classifier) already propagates an
// unannotated tuple ALIAS's mask through its own ExprIdent arm, but its
// scalar-slot sibling, expr_result_tuple_float_mask_ref, had no such arm
// at all -- so for a same-name shadowing rebind (`let t = pair(); let t =
// t;`), the scalar tuple_float_mask was always recorded as 0 for the
// inner `t`, even though the outer `t` already had a nonzero mask
// tracked. A later `t.0` arithmetic read on the shadowed local could then
// take the integer path, reinterpreting the f64 bits.
fn pair() -> (f64, i64) with Mut, Panic {
    (1.5, 7)
}

fn main() -> i32 with IO, Mut, Panic {
    let t = pair()
    // Same-name shadowing rebind: `t` on the right is the OUTER tuple;
    // `t` on the left is a fresh binding that reuses the same slot row.
    let t = t
    let a: f64 = t.0
    let b: i64 = t.1
    let doubled: f64 = a * 2.0
    if doubled == 3.0 && b == 7 {
        println("TUPLE_FLOAT_MASK_SHADOW_REBIND PASS")
        return 0
    }
    1
}
