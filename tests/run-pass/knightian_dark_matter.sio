//@ run-pass
//@ expect-stdout: [PASS] Knightian dark matter demo complete.
// Knightian Uncertainty Demo: Dark Matter Candidates
//
// Frank Knight (1921) distinguished:
//   Risk        = unknown outcome, known probability distribution
//   Uncertainty = unknown outcome, unknown distribution (ε=⊥)
//
// Dark matter is the canonical example of Knightian uncertainty:
// - We know it exists (gravitational effects are real)
// - We have zero confidence in ANY model class: WIMPs, axions,
//   primordial black holes, modified gravity — all have been ruled out
//   or are severely constrained. The hypothesis SPACE is unknown.
//
// This is not "low confidence." This is "undefined confidence."
// ε=0.0 means "known to be wrong." ε=⊥ means "model space unknown."
//
// The Knightian distinction requires different decision theory:
//   Risk:        Bayesian updating, expected utility maximization
//   Uncertainty: Maximin strategies, robust optimization
//
// In Sounio: KnightianMode::Undefined propagates through computation.
// Any function of ε=⊥ must return ε=⊥.
// The distinction is enforced by the type system, not by convention.

// We model epistemic status with explicit Knightian tracking
struct EpistemicVal {
    value: f64,
    // confidence: f64 or -1.0 if Knightian (ε=⊥)
    // -1.0 is the sentinel for "undefined" in this runtime representation
    confidence: f64,
    knightian: bool
}

// Sentinel: ε=⊥ confidence is undefined, not zero
fn knightian_undefined(value: f64) -> EpistemicVal {
    return EpistemicVal {
        value: value,
        confidence: 0.0 - 1.0,  // sentinel: -1.0 means ε=⊥
        knightian: true
    }
}

// Standard Bayesian epistemic value
fn epistemic(value: f64, confidence: f64) -> EpistemicVal {
    return EpistemicVal {
        value: value,
        confidence: confidence,
        knightian: false
    }
}

// Knightian propagation rule:
// Any computation involving ε=⊥ must produce ε=⊥
// Cannot compute your way out of Knightian uncertainty without new information
fn ev_mul(a: EpistemicVal, b: EpistemicVal) -> EpistemicVal {
    if a.knightian || b.knightian {
        return knightian_undefined(a.value * b.value)
    }
    // Bayesian: confidence degrades multiplicatively (conservative)
    let combined_conf = a.confidence * b.confidence
    return EpistemicVal {
        value: a.value * b.value,
        confidence: combined_conf,
        knightian: false
    }
}

fn ev_add(a: EpistemicVal, b: EpistemicVal) -> EpistemicVal {
    if a.knightian || b.knightian {
        return knightian_undefined(a.value + b.value)
    }
    return EpistemicVal {
        value: a.value + b.value,
        confidence: a.confidence * b.confidence,
        knightian: false
    }
}

fn print_epistemic(name: EpistemicVal) -> i32 with IO {
    if name.knightian {
        println("  ε=⊥ (Knightian: model space unknown)")
    } else {
        println("  ε=")
        println(name.confidence)
    }
    return 0
}

fn main() -> i32 with IO {
    println("================================================================")
    println("  Knightian Uncertainty Demo: Dark Matter")
    println("================================================================")
    println("")

    // ============================================================
    // SCENARIO 1: Risk vs Knightian — the fundamental distinction
    // ============================================================

    println("--- SCENARIO 1: Risk vs. Knightian Uncertainty ---")
    println("")

    // Risk: I know the model (fair coin), just not the outcome
    // Confidence = 0.5 means "equally likely heads or tails"
    let coin_heads = epistemic(1.0, 0.5)
    println("  Coin flip (Risk): we know the distribution")
    println("  Confidence in heads:")
    print_epistemic(coin_heads)
    println("")

    // WIMP dark matter: we know WIMPs MIGHT exist, but:
    // - LHC hasn't found them
    // - XENON1T ruled out primary mass range
    // - Direct detection experiments give null results
    // - The prior probability over WIMP vs non-WIMP is undefined
    //   because we don't know the RIGHT model class at all
    let wimp = knightian_undefined(0.0)
    println("  WIMP dark matter (Knightian): model space unknown")
    println("  Confidence in WIMP hypothesis:")
    print_epistemic(wimp)
    println("  This is NOT 'confidence = 0.0' (known to be wrong)")
    println("  It is 'confidence = ⊥' (no probability model applies)")
    println("")

    // Axion dark matter: also Knightian — different model class
    let axion = knightian_undefined(0.0)
    println("  Axion dark matter (also Knightian):")
    print_epistemic(axion)
    println("")

    // ============================================================
    // SCENARIO 2: Knightian propagates through computation
    // ============================================================

    println("--- SCENARIO 2: Knightian Propagation ---")
    println("")
    println("  Computing 'dark matter abundance' from:")
    println("  - Relic density (Knightian: particle model unknown)")
    println("  - Annihilation cross-section (Knightian: depends on model)")
    println("")

    let relic_density = knightian_undefined(0.26)      // ~26% of energy density
    let annihilation_xs = knightian_undefined(3.0e-26)  // cm^3/s thermal relic

    let abundance = ev_mul(relic_density, annihilation_xs)

    println("  Relic density × annihilation cross-section:")
    println("  Result value:")
    println(abundance.value)
    println("  Result confidence:")
    print_epistemic(abundance)
    println("  [PROPAGATION] Knightian uncertainty propagates. The result")
    println("  is also ε=⊥, not a number. We cannot multiply our way")
    println("  to a Bayesian estimate from Knightian inputs.")
    println("")

    // ============================================================
    // SCENARIO 3: Mix of Knightian and Bayesian
    // ============================================================

    println("--- SCENARIO 3: Knightian + Bayesian = Knightian ---")
    println("")
    println("  Gravitational lensing measurement: well-understood, Bayesian")

    let lensing_confidence = epistemic(2.5, 0.97)   // 2.5 * critical density, 97% confidence
    println("  Lensing-inferred density (Bayesian):")
    println("  Value: 2.5x critical density")
    println("  Confidence:")
    print_epistemic(lensing_confidence)
    println("")

    // Now compute: DM density = lensing - baryonic
    // Baryonic matter: well measured (Bayesian)
    let baryonic = epistemic(0.049, 0.995)  // 4.9% of energy density, very well measured

    // DM density from lensing: still Bayesian (both inputs are Bayesian)
    let dm_density_bayesian = ev_add(lensing_confidence, epistemic(0.0 - baryonic.value, 0.995))
    println("  Dark matter density from lensing (Bayesian subtraction):")
    println("  Value:")
    println(dm_density_bayesian.value)
    println("  Confidence:")
    print_epistemic(dm_density_bayesian)
    println("  -> This IS a Bayesian estimate (density is known from gravity)")
    println("")

    // But: converting density to particle identity = Knightian
    // Because the particle model is unknown, any prediction about
    // particle properties is Knightian even though density is Bayesian
    let particle_identity = knightian_undefined(dm_density_bayesian.value)
    let detection_rate = ev_mul(dm_density_bayesian, particle_identity)

    println("  Detection rate = density × cross_section:")
    println("  (density is Bayesian, cross_section is Knightian)")
    println("  Result:")
    print_epistemic(detection_rate)
    println("  -> Detection rate is Knightian. The Bayesian density does")
    println("     not rescue the calculation. Knightian uncertainty")
    println("     propagates through one Bayesian input.")
    println("")

    // ============================================================
    // SCENARIO 4: Why this matters for decisions
    // ============================================================

    println("--- SCENARIO 4: Decision Theory Implications ---")
    println("")
    println("  Risk (coin flip, confidence=0.5):")
    println("  -> Optimal strategy: maximize expected utility")
    println("  -> Bet at fair odds, diversify, use Bayesian updating")
    println("")
    println("  Knightian (dark matter model, ε=⊥):")
    println("  -> Optimal strategy: maximin (maximize worst-case)")
    println("  -> Fund ALL candidate experiments (WIMPs, axions, PBHs, etc.)")
    println("  -> DO NOT allocate proportional to believed probability")
    println("     (there is no believed probability to proportion to)")
    println("")
    println("  Current physics funding TREATS dark matter as Risk:")
    println("  XENON/LZ experiments (WIMPs) dominated funding for 20 years")
    println("  while Knightian uncertainty demanded portfolio approach.")
    println("")
    println("  In Sounio: a policy optimizer that receives ε=⊥ inputs")
    println("  cannot produce a Bayesian-optimal allocation.")
    println("  The Knightian type forces the maximin decision procedure.")
    println("")

    // ============================================================
    // SUMMARY
    // ============================================================
    println("================================================================")
    println("  SUMMARY")
    println("================================================================")
    println("")
    println("  ε=0.0 (zero confidence):")
    println("    'We know this is wrong.' Bayesian. Updateable.")
    println("")
    println("  ε=⊥  (Knightian undefined):")
    println("    'We don't know what the probability model is.'")
    println("    Not updateable via Bayes (no prior to update).")
    println("    Requires model_discovery to transition to Bayesian.")
    println("")
    println("  Propagation: Knightian × Bayesian = Knightian.")
    println("  One unknown model class infects the whole computation.")
    println("")
    println("  Dark matter, pandemic novel pathogens, black swans:")
    println("  all are ε=⊥ — not low-confidence, genuinely undefined.")
    println("")
    println("  [PASS] Knightian dark matter demo complete.")

    return 0
}
