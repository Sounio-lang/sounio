//@ run-pass
//@ requires: madaros
//@ expect-stdout: LINEAR_NESTED_BRANCHES_OK
// Gated behind `requires: madaros`: CI's full-test-suite runs souc-stage2
// (lean_single), and the branch-aware merge of linear consumption is a modular
// Madaros guarantee the seed does not implement. The seed additionally carries
// the two front-end defects recorded in #1495, so a failure here would pin an
// unrelated bug rather than this contract.
// Nested `if`s: the branch-merge snapshots are per nesting level, so an inner
// `if` must not disturb the outer one's record. Every path consumes `t`
// exactly once, so this is sound and must type-check.

linear struct Token { id: i64 }

fn consume_a(t: Token) -> i64 { t.id }
fn consume_b(t: Token) -> i64 { t.id }
fn consume_c(t: Token) -> i64 { t.id }

fn main() with IO, Panic {
    let t = Token { id: 7 }
    if 1 > 0 {
        if 2 > 1 {
            consume_a(t)
        } else {
            consume_b(t)
        }
    } else {
        consume_c(t)
    }
    println("LINEAR_NESTED_BRANCHES_OK")
}
