//@ run-pass
// R5 positive control for mod_effect_propagates.sio: the same call is
// accepted once the caller declares `with Mod`. If this file ever fails,
// recognising Mod has over-refused rather than under-refused.
//
// The body multiplies before it takes the remainder, and asserts the exact
// value, so a sabotaged `mul` makes this witness FALL. A witness that only
// printed would pass under sabotage and measure nothing -- that is the
// vacuity this shape is written to avoid.

fn take_mod(a: i64, b: i64) -> i64 with Mod {
    (a * 3) % b
}

fn caller_with_mod(x: i64) -> i64 with Mod {
    take_mod(x, 7)
}

fn main() -> i64 with IO, Mod {
    let r = caller_with_mod(30)
    assert(r == 6)
    println("mod witness")
    0
}
