//@ run-pass
//@ requires: madaros
//@ description: Imported systems::lorenz_i256_cert single-step certificate contract smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 with Mod {
    if lorenz_i256_cert_ready() != 1 { return 1 }

    let instance_fp = lorenz_i256_step4_instance_fingerprint(
        4, 10, 28, 8, 3, 4294967296, 42949672, 96,
        4617762706, 7643846696, 4120687759)
    if instance_fp != 924803514 { return 2 }

    let cert_fp = lorenz_i256_step4_certificate_fingerprint(
        instance_fp,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080, 127)
    if cert_fp != 700498889 { return 3 }

    let contract_fp = lorenz_i256_step4_certificate_check(
        42949672, 96,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080)
    if contract_fp != 630097760 { return 4 }

    if lorenz_i256_step4_certificate_check(
        42949672, 95,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080) != (0 - 1) { return 5 }
    if lorenz_i256_step4_certificate_fingerprint(
        instance_fp,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080, 126) != (0 - 1) { return 6 }

    return 0
}
