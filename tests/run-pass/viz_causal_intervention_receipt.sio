//@ run-pass
// Expected output: VIZ_CAUSAL_INTERVENTION_RECEIPT_PASS

use causal::categorical::{
    CatCausalDAG,
    cat_causal_dag_new,
    cat_dag_add_edge,
    cat_dag_has_edge,
    cat_dag_is_intervened,
    cat_dag_is_observed,
    cat_dag_set_observed,
    cat_do_intervention,
    cat_satisfies_backdoor,
}
use display::canvas::{Canvas}
use viz::causal_canvas::{
    causal_candidate_adjustment_identified,
    causal_render_confounding_receipt,
}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pixels = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pixels, width: w, height: h }
}

fn receipt_dag() -> CatCausalDAG with Mut, Div, Panic {
    var dag = cat_causal_dag_new(4)
    cat_dag_set_observed(&!dag, 1, false)
    cat_dag_add_edge(&!dag, 0, 2)
    cat_dag_add_edge(&!dag, 0, 3)
    cat_dag_add_edge(&!dag, 1, 2)
    cat_dag_add_edge(&!dag, 1, 3)
    cat_dag_add_edge(&!dag, 2, 3)
    dag
}

fn main() with IO, Alloc, Mut, Div, Panic {
    let observed = receipt_dag()
    let intervened = cat_do_intervention(&observed, 2, 1.0)

    assert(cat_dag_has_edge(&observed, 0, 2))
    assert(cat_dag_has_edge(&observed, 1, 2))
    assert(cat_dag_has_edge(&observed, 2, 3))
    assert(cat_dag_has_edge(&intervened, 0, 2) == false)
    assert(cat_dag_has_edge(&intervened, 1, 2) == false)
    assert(cat_dag_has_edge(&intervened, 0, 3))
    assert(cat_dag_has_edge(&intervened, 1, 3))
    assert(cat_dag_has_edge(&intervened, 2, 3))
    assert(cat_dag_is_intervened(&intervened, 2))
    assert(cat_dag_is_observed(&observed, 1) == false)

    var z_only: [i32; 16] = [0; 16]
    z_only[0] = 0
    assert(cat_satisfies_backdoor(&observed, 2, 3, &z_only, 1) == false)
    var z_and_u: [i32; 16] = [0; 16]
    z_and_u[0] = 0
    z_and_u[1] = 1
    assert(cat_satisfies_backdoor(&observed, 2, 3, &z_and_u, 2))
    assert(causal_candidate_adjustment_identified(&observed, 2, 3, 0) == false)

    var a = make_canvas(480, 300)
    var b = make_canvas(480, 300)
    causal_render_confounding_receipt(&observed, &intervened, &!a)
    causal_render_confounding_receipt(&observed, &intervened, &!b)
    assert(a.width * a.height * 3 == 432000)

    var idx: i64 = 0
    var mismatch: i64 = 0
    var cyan: i64 = 0
    var amber: i64 = 0
    var intervention: i64 = 0
    while idx < a.width * a.height {
        let pa = read_i64(a.pixels, idx)
        let pb = read_i64(b.pixels, idx)
        if pa != pb { mismatch = mismatch + 1 }
        if pa == 0x69E1E0 { cyan = cyan + 1 }
        if pa == 0xEEB23E { amber = amber + 1 }
        if pa == 0xFA80B8 { intervention = intervention + 1 }
        idx = idx + 1
    }
    assert(mismatch == 0)
    assert(cyan > 0)
    assert(amber > 0)
    assert(intervention > 0)
    heap_free(a.pixels as *mut i8)
    heap_free(b.pixels as *mut i8)
    println("VIZ_CAUSAL_INTERVENTION_RECEIPT_PASS")
}
