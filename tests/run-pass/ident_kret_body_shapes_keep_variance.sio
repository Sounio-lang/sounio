//@ run-pass
//@ requires: madaros
//@ expect-stdout: IDENT_KRET_SHAPES_PASS
//
// Prediction: a Knowledge-returning helper keeps the propagated variance,
// whatever the shape of its body. With Var(x) = 0.01 and a factor of 2, each
// result must have Var = 4 * 0.01 = 0.04.
//
// Regression witness: the first version of #3748 sent every Knowledge return
// through the tangent path, and that path answered zero sensitivity for a body
// with a `let` or a struct-literal result. That zero then overrode the callee's
// runtime variance: `via_let` and `via_literal` printed 0.000000, and so did
// tests/run-pass/knowledge_branded_return.sio (0 instead of 4.04).
// `via_tail` is the positive control: the shape the tangent path reads exactly.

fn via_tail(x: Knowledge<f64>) -> Knowledge<f64> with Epistemic, Mut, Div {
    x * 2.0
}

fn via_let(x: Knowledge<f64>) -> Knowledge<f64> with Epistemic, Mut, Div {
    let g = x * 2.0
    g
}

fn via_literal(x: Knowledge<f64>) -> Knowledge<f64> with Epistemic, Mut, Div {
    let f: f64 = x.value
    Knowledge { value: f * 2.0 }
}

fn near(actual: f64, expected: f64) -> bool {
    var d = actual - expected
    if d < 0.0 { d = 0.0 - d }
    d < 1.0e-12
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let x: Knowledge<f64> = measure(10.0, uncertainty: 0.1)
    let t = via_tail(x)
    let l = via_let(x)
    let s = via_literal(x)
    let tv: f64 = t.value
    let lv: f64 = l.value
    let sv: f64 = s.value
    let vt = variance_of(tv)
    let vl = variance_of(lv)
    let vs = variance_of(sv)
    print("tail ")
    print_f64(vt)
    print(" let ")
    print_f64(vl)
    print(" literal ")
    print_f64(vs)
    print("\n")
    if near(vt, 0.04) && near(vl, 0.04) && near(vs, 0.04) {
        println("IDENT_KRET_SHAPES_PASS")
        return 0
    }
    println("IDENT_KRET_SHAPES_FAIL")
    1
}
