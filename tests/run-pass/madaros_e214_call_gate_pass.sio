//@ run-pass
//@ requires: madaros
//@ expect-stdout: dose=50.000000
// Control for madaros_e214_call_gate_reject.sio. measure(10.0, uncertainty: 0.5)
// has confidence exactly 950 and the clearance is a literal (1000), so the
// argument confidence is 950 * 1000 / 1000 = 950: not below Epistemic(950), and
// the gate must accept (the boundary is inclusive). Same call shape as the
// reject fixture, so a gate that refuses everything fails here.
fn safe_dosing(weight: f64, clearance: f64) -> f64 with Mut, Epistemic(950) {
    return weight * clearance
}

fn main() with IO, Mut, Epistemic {
    let kw: Knowledge<f64> = measure(10.0, uncertainty: 0.5)
    let w = kw.value
    let dose = safe_dosing(w, 5.0)
    print("dose="); println(dose)
}
