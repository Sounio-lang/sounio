//@ run-pass
//@ expect-stdout: t1=1007 u1=1009
//@ expect-stdout: a1=5 b1=9
//@ description: a tuple-typed var assigned from a call keeps its own value when another tuple is returned later; lean_single's arm64 backend stored a pointer to its single return buffer, so t read u's value (2026-11-15)

fn site3(x: i64) -> (bool, i64, i64) {
    (true, x + 1000, x + 2000)
}

fn site2(x: i64) -> (bool, i64) { (true, x) }

fn main() with IO, Mut {
    var t: (bool, i64, i64) = (false, 0, 0)
    var u: (bool, i64, i64) = (false, 0, 0)
    t = site3(7)
    u = site3(9)
    print("t1=")
    print_int(t.1)
    print(" u1=")
    print_int(u.1)
    println("")
    var a: (bool, i64) = (false, 0)
    var b: (bool, i64) = (false, 0)
    a = site2(5)
    b = site2(9)
    print("a1=")
    print_int(a.1)
    print(" b1=")
    print_int(b.1)
    println("")
}
