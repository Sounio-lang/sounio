//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_histogram_raster, quality_histogram_config_default}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(84, 72)
    var counts: [i64; 256] = [0; 256]
    counts[0] = 1
    counts[1] = 3
    counts[2] = 6
    counts[3] = 2

    s = plot_histogram_raster(s, &counts, 4, quality_histogram_config_default())

    let tall_r = surface_get_pixel_r(&s, 48, 24)
    let tall_g = surface_get_pixel_g(&s, 48, 24)
    let tall_b = surface_get_pixel_b(&s, 48, 24)
    if tall_r > 80 || tall_g < 80 || tall_b < 140 {
        print("FAIL histogram tall bar missing\n")
        return 1
    }

    let short_r = surface_get_pixel_r(&s, 36, 35)
    let short_g = surface_get_pixel_g(&s, 36, 35)
    if short_r < 240 || short_g < 240 {
        print("FAIL histogram short bar too tall\n")
        return 2
    }

    let short_fill_r = surface_get_pixel_r(&s, 36, 45)
    let short_fill_b = surface_get_pixel_b(&s, 36, 45)
    if short_fill_r > 90 || short_fill_b < 130 {
        print("FAIL histogram short bar fill missing\n")
        return 3
    }

    var outline_pixels = 0
    var x = 44
    while x <= 55 {
        if surface_get_pixel_r(&s, x, 21) < 50 {
            outline_pixels = outline_pixels + 1
        }
        x = x + 1
    }
    if outline_pixels < 6 {
        print("FAIL histogram tall bar outline missing\n")
        return 4
    }

    var outside_pixels = 0
    var y = 0
    while y < 12 {
        var x2 = 0
        while x2 < 84 {
            if surface_get_pixel_r(&s, x2, y) < 240 {
                outside_pixels = outside_pixels + 1
            }
            x2 = x2 + 1
        }
        y = y + 1
    }
    if outside_pixels > 2 {
        print("FAIL histogram painted outside expected area\n")
        return 5
    }

    print("PASS graphics_quality_histogram_smoke\n")
    0
}
