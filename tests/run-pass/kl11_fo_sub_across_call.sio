//@ run-pass
//@ requires: madaros
//@ expect-stdout: KL11_FO_SUB_ACROSS_CALL_PASS
// KL-11 (#1792): First-order uncertainty and variance must survive
// subtraction and negation across user function calls.
// Catalog miss previously dropped variance of user `x - y` and `0.0 - x` to silent 0.0.

fn sub2(x: f64, y: f64) -> f64 {
    x - y
}

fn neg1(x: f64) -> f64 {
    0.0 - x
}

fn sub_rev(x: f64, y: f64) -> f64 {
    y - x
}

fn sub_lit(x: f64) -> f64 {
    x - 3.0
}

fn lit_sub(x: f64) -> f64 {
    10.0 - x
}

fn sub_let(x: f64, y: f64) -> f64 {
    let r = x - y
    return r
}

fn check_close(v: f64, want: f64, tol: f64) -> bool {
    var diff = v - want
    if diff < 0.0 {
        diff = 0.0 - diff
    }
    diff <= tol
}

fn main() -> i64 with IO, Mut, Panic, Epistemic {
    let ka: Knowledge<f64> = measure(10.0, uncertainty: 1.0)
    let kb: Knowledge<f64> = measure(4.0, uncertainty: 1.0)
    let a = ka.value
    let b = kb.value

    let v_sub = variance_of(sub2(a, b))
    let v_neg = variance_of(neg1(a))
    let v_rev = variance_of(sub_rev(a, b))
    let v_slit = variance_of(sub_lit(a))
    let v_lsub = variance_of(lit_sub(a))
    let v_slet = variance_of(sub_let(a, b))

    if !check_close(v_sub, 2.0, 1.0e-9) {
        println("FAIL: v_sub")
        return 1
    }
    if !check_close(v_neg, 1.0, 1.0e-9) {
        println("FAIL: v_neg")
        return 1
    }
    if !check_close(v_rev, 2.0, 1.0e-9) {
        println("FAIL: v_rev")
        return 1
    }
    if !check_close(v_slit, 1.0, 1.0e-9) {
        println("FAIL: v_slit")
        return 1
    }
    if !check_close(v_lsub, 1.0, 1.0e-9) {
        println("FAIL: v_lsub")
        return 1
    }
    if !check_close(v_slet, 2.0, 1.0e-9) {
        println("FAIL: v_slet")
        return 1
    }

    println("KL11_FO_SUB_ACROSS_CALL_PASS")
    0
}
