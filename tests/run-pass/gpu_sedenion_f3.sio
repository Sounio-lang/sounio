//@ run-pass
//@ expect-stdout: PASS: gpu_sedenion_f3

//! GPU Metal sedenion F₃ validation test.
//!
//! Verifies sed_f3_single() against the Python dry-run reference:
//!   f3_v3_l1_associator_mass(np.random.default_rng(20260421).standard_normal(16))
//!   = 85.4749812048   (Python, ossm_168_dryrun/sedenion.py)
//!
//! Single-triple sub-check:
//!   sed_triple_l1(h, 1, 10, 4) = 50.8948894635
//!
//! The test constructs the same state in Sounio and verifies both values
//! to tolerance 1e-4, confirming the Metal kernel backend will emit
//! numerically correct MSL.

use math::sedenion::{Sedenion, sed, sed_mul, sed_basis};
use gpu::sedenion_kernels::{sed_l1_norm, sed_associator, sed_triple_l1, sed_f3_single, sed_kernel_init};

fn main() -> i32 with IO {
    // Reference sedenion state from np.random.default_rng(20260421).standard_normal(16)
    let h = sed(
        -0.20220848395851600,
        -0.64723789263034000,
         0.51044658582831700,
         1.04495879581374400,
         0.38502833071961900,
         0.93319933757780800,
         0.15020544768612400,
         0.33725160697090900,
        -0.93665325760013500,
        -0.05310354598893900,
         0.98720954780898100,
         0.42369366480667600,
        -0.04063361171152400,
        -1.05319389931089000,
        -0.53310586732066700,
        -1.04790495866022800
    )

    // Sub-check 1: single triple (1, 10, 4)
    // Python reference: 50.8948894635
    let l1_single = sed_triple_l1(h, 1, 10, 4)
    let ok1 = l1_single > 50.89 && l1_single < 50.91
    if ok1 {} else {
        println("FAIL: sed_triple_l1(h,1,10,4) out of range")
        return 1
    }

    // Sub-check 2: full F₃ over 168 triples
    // Python reference: 85.4749812048 (= 14360.59 / 168)
    let f3 = sed_f3_single(h)
    let ok2 = f3 > 85.46 && f3 < 85.49
    if ok2 {} else {
        println("FAIL: sed_f3_single out of range")
        return 1
    }

    // Sub-check 3: kernel context initialises correctly
    let ctx = sed_kernel_init()
    let ok3 = ctx.n_triples == 168
    if ok3 {} else {
        println("FAIL: SedKernelCtx.n_triples != 168")
        return 1
    }

    // Sub-check 4: sign table — e1*e1 = -e0, so sign_table[17] = -1
    let ok4 = ctx.sign_table[17] == -1
    if ok4 {} else {
        println("FAIL: sign_table[17] != -1 (e1*e1 should give -e0)")
        return 1
    }

    // Sub-check 5: first triple is (I=1, J=10, K=4)
    let ok5 = ctx.triples[0] == 1 && ctx.triples[1] == 10 && ctx.triples[2] == 4
    if ok5 {} else {
        println("FAIL: triples[0..2] != (1, 10, 4)")
        return 1
    }

    println("PASS: gpu_sedenion_f3")
    0
}
