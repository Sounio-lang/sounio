//@ run-pass
// Phase 3 demo: the typed epistemic boundary. `Proved` and the measurement variants are distinct;
// `requires_proof` accepts ONLY `Proved` — a measurement can NEVER be laundered into a proof (the
// type system blocks it). This is the load-bearing guarantee of the boundary.
//
// NOTE (souc compiler): `Verdict` is PAYLOAD-FREE here. The intended type carries the tolerance
// (`MeasuredF64 { eps: f64 }`, `MeasuredF256 { eps256: f64 }`) — but the current souc (the stage2
// compiler the CI full-suite builds) rejects data-carrying enum variants: it reports the field name
// as an undefined variable (E200). See docs/handoff/souc_v0800_defects.md (D7). The eps tolerance is
// carried alongside in practice; the boundary guarantee this test certifies (proof vs measurement)
// is unaffected by dropping the payload.

enum Verdict { Proved, MeasuredF64, MeasuredF256 }
fn verdict_proved() -> Verdict { Verdict::Proved }
fn verdict_measured_f64() -> Verdict { Verdict::MeasuredF64 }
fn verdict_measured_f256() -> Verdict { Verdict::MeasuredF256 }
fn requires_proof(v: Verdict) -> bool {
    match v { Verdict::Proved => true, Verdict::MeasuredF64 => false, Verdict::MeasuredF256 => false }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    // requires_proof is the load-bearing boundary: a measurement can NEVER pass as a proof.
    if requires_proof(verdict_proved()) { println("PROOF-ACCEPTED PASS") } else { println("PROOF-ACCEPTED FAIL") }
    if !requires_proof(verdict_measured_f64()) { println("MEASUREMENT-REJECTED PASS") } else { println("MEASUREMENT-REJECTED FAIL") }
    if !requires_proof(verdict_measured_f256()) { println("F256-REJECTED PASS") } else { println("F256-REJECTED FAIL") }
    0
}
