//@ run-pass
// Phase 3 demo: the typed epistemic boundary. `Proved` and `MeasuredF64` are distinct enum
// variants; the `requires_proof` sink accepts the exact proof and REJECTS the float measurement.
// There is NO function turning a measurement into a proof — the type system blocks the coercion.
//
// The `Verdict` enum + gates mirror stdlib/algebra/sedenion_verdict.sio (the reusable module,
// which `check`s OK). They are INLINED here and the engine is NOT imported, because souc v0.80.0
// (a) compact-stub-false-greens any test importing 2+ modules and (b) trips E035 when an enum is
// mixed with the aggregate engine calls in one module — both documented backend limitations, fixes
// in flight. The EXACT-GATE composition (a·b==0 → Proved on the canonical pair e3+e10, e6-e15) is
// exercised for real in tests/run-pass/sedenion_zd_exact_smoke.sio (prints ZD PROVED).

enum Verdict { Proved, MeasuredF64 { eps: f64 }, MeasuredF256 { eps256: f64 } }
fn verdict_proved() -> Verdict { Verdict::Proved }
fn verdict_measured_f64(e: f64) -> Verdict { Verdict::MeasuredF64 { eps: e } }
fn verdict_measured_f256(e: f64) -> Verdict { Verdict::MeasuredF256 { eps256: e } }
fn requires_proof(v: Verdict) -> bool {
    match v { Verdict::Proved => true, Verdict::MeasuredF64 { eps } => false, Verdict::MeasuredF256 { eps256 } => false }
}
fn main() with IO {
    // Each verdict is consumed by exactly one pass-by-value call (enum values move on use),
    // so construct a fresh one per check. `requires_proof` is the load-bearing boundary: a
    // measurement can NEVER be laundered into a proof. "Is a measurement" = its negation.
    if requires_proof(verdict_proved()) { println("PROOF-ACCEPTED PASS") } else { println("PROOF-ACCEPTED FAIL") }
    if !requires_proof(verdict_measured_f64(0.0000001)) { println("MEASUREMENT-REJECTED PASS") } else { println("MEASUREMENT-REJECTED FAIL") }
    if !requires_proof(verdict_measured_f256(0.0)) { println("F256-REJECTED PASS") } else { println("F256-REJECTED FAIL") }
}
