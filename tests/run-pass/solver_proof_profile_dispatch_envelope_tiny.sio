//@ run-pass
//@ description: Self-contained solver proof-profile dispatch envelope smoke (status 91)

fn main() -> i64 {
    let dispatch_mask: i64 = 63
    let envelope_fp: i64 = 964221344
    let dispatch_artifact_fp: i64 = 382940617
    let profile_artifact_fp: i64 = 964210753
    let accepted_profile_mask: i64 = 15
    let rejected_profile_mask: i64 = 48
    let profile_status: i64 = 88
    if dispatch_mask != 63 { return 1 }
    if envelope_fp != 964221344 { return 2 }
    if dispatch_artifact_fp != 382940617 { return 3 }
    if profile_artifact_fp != 964210753 { return 4 }
    if accepted_profile_mask != 15 { return 5 }
    if rejected_profile_mask != 48 { return 6 }
    if profile_status != 88 { return 7 }

    let public_claim_mask: i64 = 0
    let formal_theorem_ready: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let limb_base: i64 = 1000000000
    let bridge_status: i64 = 123
    if public_claim_mask != 0 { return 8 }
    if formal_theorem_ready != 0 { return 9 }
    if global_flowpipe_claim_mask != 0 { return 10 }
    if limb_base != 1000000000 { return 11 }
    if bridge_status != 123 { return 12 }

    let recomputed_envelope_fp: i64 =
        (profile_artifact_fp
            + (29 * dispatch_mask)
            + (31 * accepted_profile_mask)
            + (37 * profile_status)
            + (41 * bridge_status)) % limb_base
    if recomputed_envelope_fp != 964221344 { return 13 }
    return 0
}
