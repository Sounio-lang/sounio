//@ check-only
//@ requires: madaros
//@ description: Madaros type-check guard that reads every PBPK result-record field made pub in PR #2698 from outside its defining module and constructs HillEpParam, so making any of them private again fails the check
// Madaros type-check guard for the PBPK result records opened in PR #2698.
// Every field made `pub` there is read here from outside its defining
// module, and HillEpParam is constructed here, so a regression to private
// fields (E259) fails this file. Type-checking the imported closure also
// re-checks the module bodies fixed in the same PR: the undeclared
// print_i64 calls (E137) and the steady-state runner's return type (E008).
// lean_single tolerates type errors in imported modules, so only a Madaros
// check is evidence here. Runtime coverage of the BBB pipeline is blocked by
// Madaros handle exhaustion (rc=182), tracked separately.

use darwin_pbpk::bbb::bbb_gate::{BBBGateVerdict}
use darwin_pbpk::bbb::bbb_gum::{BBBGUMBudget}
use darwin_pbpk::bbb::bbb_voi::{BBBVoI}
use darwin_pbpk::ddi::polypharmacy_fano::{CypDDITriple}
use darwin_pbpk::pd::hill_mtor::{HillEpParam, HillPriors, PDEndpoint}
use darwin_pbpk::pd::pd_gate::{PDGateResult}
use darwin_pbpk::pd::pd_gum::{PDGUMBudget, PDPriors10, PDVoI10}
use darwin_pbpk::scenarios::oral_rapamycin_bbb::{OralBBBTrace}
use darwin_pbpk::scenarios::steady_state_runner::{SteadyStateReport}

fn read_bbbgumbudget(r: BBBGUMBudget) -> f64 {
    var s: f64 = 0.0
    s = s + (r.param_idx[0] as f64)
    s
}

fn read_bbbgateverdict(r: BBBGateVerdict) -> f64 {
    var s: f64 = 0.0
    if r.admitted { s = s + 1.0 }
    s = s + (r.driver_idx[0] as f64)
    s = s + (r.first_failing_idx as f64)
    s = s + (r.n_drivers as f64)
    s
}

fn read_bbbvoi(r: BBBVoI) -> f64 {
    var s: f64 = 0.0
    s = s + r.confidence[0]
    s = s + (r.n_rows as f64)
    s = s + (r.param_idx[0] as f64)
    s = s + (r.rank[0] as f64)
    s = s + r.sobol[0]
    s = s + (r.top_idx as f64)
    s = s + r.voi[0]
    s = s + r.voi_total
    s
}

fn read_cypdditriple(r: CypDDITriple) -> f64 {
    var s: f64 = 0.0
    s = s + (r.cyp_a as f64)
    s = s + (r.cyp_b as f64)
    s = s + (r.cyp_c as f64)
    s
}

fn read_hillepparam(r: HillEpParam) -> f64 {
    var s: f64 = 0.0
    s = s + r.confidence
    s = s + r.mean
    s = s + r.variance
    s
}

fn read_hillpriors(r: HillPriors) -> f64 {
    var s: f64 = 0.0
    s = s + r.ec50.mean + r.ec50.variance + r.ec50.confidence
    s = s + r.emax.mean + r.emax.variance + r.emax.confidence
    s = s + r.n.mean + r.n.variance + r.n.confidence
    s
}

fn read_oralbbbtrace(r: OralBBBTrace) -> f64 {
    var s: f64 = 0.0
    s = s + r.a_gut[0]
    s = s + r.auc_icf_u
    s = s + r.auc_isf_u
    s = s + r.auc_plasma_u
    s = s + r.icf_u[0]
    s = s + r.isf_u[0]
    s = s + r.kpuu_auc
    s = s + (r.n_points as f64)
    s = s + r.plasma[0]
    s = s + r.released[0]
    if r.success { s = s + 1.0 }
    s = s + r.times_h[0]
    s = s + r.total_released_end
    s
}

fn read_pdendpoint(r: PDEndpoint) -> f64 {
    var s: f64 = 0.0
    s = s + r.inhibition_auc
    s = s + r.max_inhibition
    s = s + r.mean_inhibition
    s = s + r.time_above_80pct
    s
}

fn read_pdgumbudget(r: PDGUMBudget) -> f64 {
    var s: f64 = 0.0
    s = s + r.y_stddev
    s
}

fn read_pdgateresult(r: PDGateResult) -> f64 {
    var s: f64 = 0.0
    s = s + (r.n_checked as f64)
    s = s + (r.n_violations as f64)
    if r.passed { s = s + 1.0 }
    s = s + r.worst_confidence
    s
}

fn read_pdpriors10(r: PDPriors10) -> f64 {
    var s: f64 = 0.0
    s = s + r.confidence[0]
    s = s + (r.n as f64)
    s
}

fn read_pdvoi10(r: PDVoI10) -> f64 {
    var s: f64 = 0.0
    s = s + r.confidence[0]
    s = s + (r.n_rows as f64)
    s = s + (r.param_idx[0] as f64)
    s = s + (r.rank[0] as f64)
    s = s + r.sobol[0]
    s = s + (r.top_idx as f64)
    s = s + r.voi[0]
    s = s + r.voi_total
    s
}

fn read_steadystatereport(r: SteadyStateReport) -> f64 {
    var s: f64 = 0.0
    s = s + r.auc_icf_tau_ss
    s = s + r.auc_tau_per_dose[0]
    s = s + r.auc_tau_ss
    s = s + r.c_max_per_dose[0]
    s = s + r.c_max_ss
    s = s + r.c_trough_per_dose[0]
    s = s + r.c_trough_ss
    s = s + (r.dose_of_ss as f64)
    s = s + (r.n_doses_run as f64)
    if r.reached_ss { s = s + 1.0 }
    s = s + r.t_to_90pct_h
    if r.success { s = s + 1.0 }
    s
}

fn make_hill_ep_param() -> HillEpParam {
    HillEpParam { mean: 1.0, variance: 0.01, confidence: 0.10 }
}

fn main() -> i32 {
    let p = make_hill_ep_param()
    if p.confidence > 0.5 { return 1 }
    0
}
