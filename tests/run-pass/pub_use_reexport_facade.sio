//@ description: a function reached only through an imported facade's `pub use` resolves (#842)
//
// The facade (fixtures/pub_use_reexport_facade.sio) re-exports
// pub_use_reexport_value from fixtures/pub_use_reexport_leaf.sio with a braced
// `pub use`. lean_single used to refuse the call with E200 (it never followed
// `pub use` lines); Madaros already forwarded.
use fixtures::pub_use_reexport_facade::{pub_use_reexport_value}

fn main() -> i64 with IO {
    if pub_use_reexport_value() != 842 { return 1 }
    print("PASS pub_use_reexport_facade ")
    print_int(pub_use_reexport_value())
    print("\n")
    0
}
