//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF_IDENT PASS
//
// Copilot review (PR #2516), finding 2 on the eleventh review round: round
// 10's ExprIf/ExprMatch/ExprBlock propagation on expr_result_is_f64_array_ref
// (the SINGLE-array tuple-literal-slot classifier) recurses into each
// arm/block-tail through that same function -- but it only ever recognised
// ExprCall/ExprMethodCall results, not a plain LOCAL VARIABLE tail. So
// `(if cond { xs } else { ys }, 0)`, where `xs`/`ys` are already-known
// f64-array locals (not calls), still fell through to `false` for both
// arms and `a[0]` took the integer conversion path. Fixed by checking
// ExprIdent (via lookup_local_array_elem_float) and direct array literals
// (via array_literal_elems_are_float_ref) at the top of
// expr_result_is_f64_array_ref itself, the same two forms
// tuple_lit_slot_is_f64_array_ref already classifies at its own top level
// -- so a recursive call from a block tail now sees the same answer a
// top-level slot would.
fn mk_a() -> [f64; 2] {
    var a: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    a
}

fn mk_b() -> [f64; 2] {
    var b: [f64; 2] = [0.0; 2]
    b[0] = 4.5
    b
}

fn main() -> i32 with IO, Mut, Panic {
    let cond = true
    let xs = mk_a()
    let ys = mk_b()
    let (a, n) = (if cond { xs } else { ys }, 0)
    let s0: f64 = a[0] * 2.0

    if s0 == 3.0 && n == 0 {
        println("TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF_IDENT PASS")
        return 0
    }
    1
}
