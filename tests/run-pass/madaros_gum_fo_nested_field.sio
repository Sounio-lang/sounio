//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_NESTED_FIELD_PASS

// Nested struct field FO — o.inner.cl0, let-bind of nested struct, call paths.

struct Inner {
    cl0: f64
}

struct Outer {
    inner: Inner
    v0: f64
}

fn make_outer(cl0: f64, v0: f64) -> Outer {
    Outer { inner: Inner { cl0: cl0 }, v0: v0 }
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let cl0 = kCL.value
    let v0 = kV.value

    let o = Outer { inner: Inner { cl0: cl0 }, v0: v0 }

    let v_chain = variance_of(o.inner.cl0)
    let v_flat = variance_of(o.v0)
    let inn = o.inner
    let v_let = variance_of(inn.cl0)
    let v_call_chain = variance_of(make_outer(cl0, v0).inner.cl0)
    let v_call_flat = variance_of(make_outer(cl0, v0).v0)
    let v_peel = variance_of(cl0)

    print("v_chain="); print_f64(v_chain); print("\n")
    print("v_let="); print_f64(v_let); print("\n")
    print("v_flat="); print_f64(v_flat); print("\n")
    print("v_call_chain="); print_f64(v_call_chain); print("\n")
    print("v_call_flat="); print_f64(v_call_flat); print("\n")

    let ok = abs_f(v_chain - v_peel) < 1.0e-9
        && abs_f(v_chain - 0.09) < 1.0e-9
        && abs_f(v_let - v_peel) < 1.0e-9
        && abs_f(v_flat - 4.0) < 1.0e-9
        && abs_f(v_call_chain - v_peel) < 1.0e-9
        && abs_f(v_call_flat - 4.0) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_NESTED_FIELD_PASS\n")
    } else {
        print("MADAROS_GUM_FO_NESTED_FIELD_FAIL\n")
    }
}
