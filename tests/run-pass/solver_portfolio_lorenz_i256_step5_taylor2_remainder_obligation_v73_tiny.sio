//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v73 smoke for Lorenz i256 step-5 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1193
    receipt_fp = mix(receipt_fp, 69995750, 4943)
    receipt_fp = mix(receipt_fp, 380914208, 4943)
    receipt_fp = mix(receipt_fp, 133743506, 4943)
    receipt_fp = mix(receipt_fp, 23671319, 4943)
    receipt_fp = mix(receipt_fp, 414316671, 4943)
    receipt_fp = mix(receipt_fp, 86228816, 4943)
    receipt_fp = mix(receipt_fp, 859564353, 4943)
    receipt_fp = mix(receipt_fp, 815806077, 4943)
    receipt_fp = mix(receipt_fp, 655666714, 4943)
    receipt_fp = mix(receipt_fp, 5, 4943)
    receipt_fp = mix(receipt_fp, 5, 4943)
    receipt_fp = mix(receipt_fp, 127, 4943)
    if receipt_fp != 825097798 { return 1 }

    var audit_fp: i64 = 1201
    audit_fp = mix(audit_fp, receipt_fp, 4951)
    audit_fp = mix(audit_fp, 69995750, 4951)
    audit_fp = mix(audit_fp, 380914208, 4951)
    audit_fp = mix(audit_fp, 133743506, 4951)
    audit_fp = mix(audit_fp, 23671319, 4951)
    audit_fp = mix(audit_fp, 815806077, 4951)
    audit_fp = mix(audit_fp, 655666714, 4951)
    audit_fp = mix(audit_fp, 859564353, 4951)
    audit_fp = mix(audit_fp, 5, 4951)
    audit_fp = mix(audit_fp, 5, 4951)
    audit_fp = mix(audit_fp, 127, 4951)
    if audit_fp != 397604716 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 76, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 76, 1103)
    if entry_fp != 220149970 { return 3 }

    let manifest_fp: i64 = 611181728
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 73, 1871)
    result_fp = mix(result_fp, 77, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 65, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 751092485 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 73, 1907)
    family_fp = mix(family_fp, 77, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 60, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 6924181 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 73, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 245041585 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 73, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 450254687 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 73, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 256503731 { return 8 }
    return 0
}
