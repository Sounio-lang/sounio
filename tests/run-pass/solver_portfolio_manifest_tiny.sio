//@ run-pass
//@ requires: madaros
//@ description: Tiny proof-certificate portfolio manifest smoke

fn portfolio_kind_lrat() -> i64 { return 1 }
fn portfolio_kind_smt() -> i64 { return 2 }
fn portfolio_kind_qflra() -> i64 { return 3 }
fn portfolio_kind_pb() -> i64 { return 4 }
fn portfolio_kind_lorenz() -> i64 { return 5 }
fn portfolio_kind_lorenz_i256_num() -> i64 { return 6 }
fn portfolio_kind_lorenz_i256_range() -> i64 { return 7 }

fn portfolio_result_unsat() -> i64 { return 0 }
fn portfolio_result_validated() -> i64 { return 1 }

fn portfolio_checker_lrat_replay() -> i64 { return 1 }
fn portfolio_checker_smt_core() -> i64 { return 2 }
fn portfolio_checker_qflra_farkas() -> i64 { return 3 }
fn portfolio_checker_pb_row_chain() -> i64 { return 4 }
fn portfolio_checker_lorenz_trajectory() -> i64 { return 5 }
fn portfolio_checker_lorenz_i256_num() -> i64 { return 6 }
fn portfolio_checker_lorenz_i256_range() -> i64 { return 7 }

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_valid(kind: i64, instance_fp: i64, certificate_fp: i64,
                         result_code: i64, checker_code: i64) -> i64 {
    if instance_fp <= 0 { return 0 }
    if certificate_fp <= 0 { return 0 }

    if kind == portfolio_kind_lrat() {
        if result_code != portfolio_result_unsat() { return 0 }
        if checker_code != portfolio_checker_lrat_replay() { return 0 }
        return 1
    }
    if kind == portfolio_kind_smt() {
        if result_code != portfolio_result_unsat() { return 0 }
        if checker_code != portfolio_checker_smt_core() { return 0 }
        return 1
    }
    if kind == portfolio_kind_qflra() {
        if result_code != portfolio_result_unsat() { return 0 }
        if checker_code != portfolio_checker_qflra_farkas() { return 0 }
        return 1
    }
    if kind == portfolio_kind_pb() {
        if result_code != portfolio_result_unsat() { return 0 }
        if checker_code != portfolio_checker_pb_row_chain() { return 0 }
        return 1
    }
    if kind == portfolio_kind_lorenz() {
        if result_code != portfolio_result_validated() { return 0 }
        if checker_code != portfolio_checker_lorenz_trajectory() { return 0 }
        return 1
    }
    if kind == portfolio_kind_lorenz_i256_num() {
        if result_code != portfolio_result_validated() { return 0 }
        if checker_code != portfolio_checker_lorenz_i256_num() { return 0 }
        return 1
    }
    if kind == portfolio_kind_lorenz_i256_range() {
        if result_code != portfolio_result_validated() { return 0 }
        if checker_code != portfolio_checker_lorenz_i256_range() { return 0 }
        return 1
    }
    return 0
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if portfolio_entry_valid(kind, instance_fp, certificate_fp, result_code, checker_code) == 0 {
        return 0 - 1
    }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn solver_portfolio_manifest_fingerprint(version: i64, entry_count: i64,
                                         lrat_entry_fp: i64, smt_entry_fp: i64,
                                         qflra_entry_fp: i64, pb_entry_fp: i64,
                                         lorenz_entry_fp: i64) -> i64 with Mod {
    if version != 1 { return 0 - 1 }
    if entry_count != 5 { return 0 - 1 }
    if lrat_entry_fp <= 0 { return 0 - 1 }
    if smt_entry_fp <= 0 { return 0 - 1 }
    if qflra_entry_fp <= 0 { return 0 - 1 }
    if pb_entry_fp <= 0 { return 0 - 1 }
    if lorenz_entry_fp <= 0 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, version, 1151)
    fp = portfolio_mix(fp, entry_count, 1151)
    fp = portfolio_mix(fp, lrat_entry_fp, 1151)
    fp = portfolio_mix(fp, smt_entry_fp, 1151)
    fp = portfolio_mix(fp, qflra_entry_fp, 1151)
    fp = portfolio_mix(fp, pb_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_entry_fp, 1151)
    return fp
}

fn known_solver_portfolio_manifest_valid(lrat_entry_fp: i64, smt_entry_fp: i64,
                                         qflra_entry_fp: i64, pb_entry_fp: i64,
                                         lorenz_entry_fp: i64,
                                         manifest_fp: i64) -> i64 {
    if lrat_entry_fp != 53646245 { return 0 }
    if smt_entry_fp != 528026990 { return 0 }
    if qflra_entry_fp != 301444501 { return 0 }
    if pb_entry_fp != 258927862 { return 0 }
    if lorenz_entry_fp != 388915166 { return 0 }
    if manifest_fp != 902469519 { return 0 }
    return 1
}

fn solver_portfolio_manifest_v2_fingerprint(version: i64, entry_count: i64,
                                            lrat_entry_fp: i64, smt_entry_fp: i64,
                                            qflra_entry_fp: i64, pb_entry_fp: i64,
                                            lorenz_entry_fp: i64,
                                            lorenz_i256_entry_fp: i64) -> i64 with Mod {
    if version != 2 { return 0 - 1 }
    if entry_count != 6 { return 0 - 1 }
    if lrat_entry_fp <= 0 { return 0 - 1 }
    if smt_entry_fp <= 0 { return 0 - 1 }
    if qflra_entry_fp <= 0 { return 0 - 1 }
    if pb_entry_fp <= 0 { return 0 - 1 }
    if lorenz_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_entry_fp <= 0 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, version, 1151)
    fp = portfolio_mix(fp, entry_count, 1151)
    fp = portfolio_mix(fp, lrat_entry_fp, 1151)
    fp = portfolio_mix(fp, smt_entry_fp, 1151)
    fp = portfolio_mix(fp, qflra_entry_fp, 1151)
    fp = portfolio_mix(fp, pb_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_entry_fp, 1151)
    return fp
}

fn known_solver_portfolio_manifest_v2_valid(lrat_entry_fp: i64, smt_entry_fp: i64,
                                            qflra_entry_fp: i64, pb_entry_fp: i64,
                                            lorenz_entry_fp: i64,
                                            lorenz_i256_entry_fp: i64,
                                            manifest_fp: i64) -> i64 {
    if lrat_entry_fp != 53646245 { return 0 }
    if smt_entry_fp != 528026990 { return 0 }
    if qflra_entry_fp != 301444501 { return 0 }
    if pb_entry_fp != 258927862 { return 0 }
    if lorenz_entry_fp != 388915166 { return 0 }
    if lorenz_i256_entry_fp != 900589789 { return 0 }
    if manifest_fp != 195085206 { return 0 }
    return 1
}

fn solver_portfolio_manifest_v3_fingerprint(version: i64, entry_count: i64,
                                            lrat_entry_fp: i64, smt_entry_fp: i64,
                                            qflra_entry_fp: i64, pb_entry_fp: i64,
                                            lorenz_entry_fp: i64,
                                            lorenz_i256_entry_fp: i64,
                                            lorenz_i256_range_entry_fp: i64) -> i64 with Mod {
    if version != 3 { return 0 - 1 }
    if entry_count != 7 { return 0 - 1 }
    if lrat_entry_fp <= 0 { return 0 - 1 }
    if smt_entry_fp <= 0 { return 0 - 1 }
    if qflra_entry_fp <= 0 { return 0 - 1 }
    if pb_entry_fp <= 0 { return 0 - 1 }
    if lorenz_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_entry_fp <= 0 { return 0 - 1 }
    if lorenz_i256_range_entry_fp <= 0 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, version, 1151)
    fp = portfolio_mix(fp, entry_count, 1151)
    fp = portfolio_mix(fp, lrat_entry_fp, 1151)
    fp = portfolio_mix(fp, smt_entry_fp, 1151)
    fp = portfolio_mix(fp, qflra_entry_fp, 1151)
    fp = portfolio_mix(fp, pb_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_entry_fp, 1151)
    fp = portfolio_mix(fp, lorenz_i256_range_entry_fp, 1151)
    return fp
}

fn known_solver_portfolio_manifest_v3_valid(lrat_entry_fp: i64, smt_entry_fp: i64,
                                            qflra_entry_fp: i64, pb_entry_fp: i64,
                                            lorenz_entry_fp: i64,
                                            lorenz_i256_entry_fp: i64,
                                            lorenz_i256_range_entry_fp: i64,
                                            manifest_fp: i64) -> i64 {
    if lrat_entry_fp != 53646245 { return 0 }
    if smt_entry_fp != 528026990 { return 0 }
    if qflra_entry_fp != 301444501 { return 0 }
    if pb_entry_fp != 258927862 { return 0 }
    if lorenz_entry_fp != 388915166 { return 0 }
    if lorenz_i256_entry_fp != 900589789 { return 0 }
    if lorenz_i256_range_entry_fp != 205040674 { return 0 }
    if manifest_fp != 278042210 { return 0 }
    return 1
}

fn main() -> i64 {
    let lrat_entry_fp = portfolio_entry_fingerprint(portfolio_kind_lrat(), 296728038, 891522734, portfolio_result_unsat(), portfolio_checker_lrat_replay())
    let smt_entry_fp = portfolio_entry_fingerprint(portfolio_kind_smt(), 796206516, 923659833, portfolio_result_unsat(), portfolio_checker_smt_core())
    let qflra_entry_fp = portfolio_entry_fingerprint(portfolio_kind_qflra(), 334817196, 13244761, portfolio_result_unsat(), portfolio_checker_qflra_farkas())
    let pb_entry_fp = portfolio_entry_fingerprint(portfolio_kind_pb(), 617917101, 624517492, portfolio_result_unsat(), portfolio_checker_pb_row_chain())
    let lorenz_entry_fp = portfolio_entry_fingerprint(portfolio_kind_lorenz(), 236665224, 508132668, portfolio_result_validated(), portfolio_checker_lorenz_trajectory())
    let lorenz_i256_entry_fp = portfolio_entry_fingerprint(portfolio_kind_lorenz_i256_num(), 300929056, 572148472, portfolio_result_validated(), portfolio_checker_lorenz_i256_num())
    let lorenz_i256_range_entry_fp = portfolio_entry_fingerprint(portfolio_kind_lorenz_i256_range(), 743388522, 133303313, portfolio_result_validated(), portfolio_checker_lorenz_i256_range())
    let manifest_fp = solver_portfolio_manifest_fingerprint(1, 5, lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp)
    let manifest_v2_fp = solver_portfolio_manifest_v2_fingerprint(2, 6, lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, lorenz_i256_entry_fp)
    let manifest_v3_fp = solver_portfolio_manifest_v3_fingerprint(3, 7, lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp)

    if lrat_entry_fp != 53646245 { return 1 }
    if smt_entry_fp != 528026990 { return 2 }
    if qflra_entry_fp != 301444501 { return 3 }
    if pb_entry_fp != 258927862 { return 4 }
    if lorenz_entry_fp != 388915166 { return 5 }
    if manifest_fp != 902469519 { return 6 }
    if known_solver_portfolio_manifest_valid(lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, manifest_fp) != 1 { return 7 }
    if lorenz_i256_entry_fp != 900589789 { return 14 }
    if manifest_v2_fp != 195085206 { return 15 }
    if known_solver_portfolio_manifest_v2_valid(lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, lorenz_i256_entry_fp, manifest_v2_fp) != 1 { return 16 }
    if lorenz_i256_range_entry_fp != 205040674 { return 20 }
    if manifest_v3_fp != 278042210 { return 21 }
    if known_solver_portfolio_manifest_v3_valid(lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp, manifest_v3_fp) != 1 { return 22 }

    if portfolio_entry_fingerprint(portfolio_kind_lrat(), 296728038, 891522734, portfolio_result_validated(), portfolio_checker_lrat_replay()) != (0 - 1) { return 8 }
    if portfolio_entry_fingerprint(portfolio_kind_lorenz(), 236665224, 508132668, portfolio_result_unsat(), portfolio_checker_lorenz_trajectory()) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(portfolio_kind_pb(), 617917101, 624517492, portfolio_result_unsat(), portfolio_checker_smt_core()) != (0 - 1) { return 10 }
    if solver_portfolio_manifest_fingerprint(2, 5, lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp) != (0 - 1) { return 11 }
    if solver_portfolio_manifest_fingerprint(1, 4, lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp) != (0 - 1) { return 12 }
    if known_solver_portfolio_manifest_valid(lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp + 1, lorenz_entry_fp, manifest_fp) != 0 { return 13 }
    if portfolio_entry_fingerprint(portfolio_kind_lorenz_i256_num(), 300929056, 572148472, portfolio_result_unsat(), portfolio_checker_lorenz_i256_num()) != (0 - 1) { return 17 }
    if solver_portfolio_manifest_v2_fingerprint(2, 6, lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, 0) != (0 - 1) { return 18 }
    if known_solver_portfolio_manifest_v2_valid(lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, lorenz_i256_entry_fp + 1, manifest_v2_fp) != 0 { return 19 }
    if portfolio_entry_fingerprint(portfolio_kind_lorenz_i256_range(), 743388522, 133303313, portfolio_result_unsat(), portfolio_checker_lorenz_i256_range()) != (0 - 1) { return 23 }
    if solver_portfolio_manifest_v3_fingerprint(3, 7, lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, lorenz_i256_entry_fp, 0) != (0 - 1) { return 24 }
    if known_solver_portfolio_manifest_v3_valid(lrat_entry_fp, smt_entry_fp, qflra_entry_fp, pb_entry_fp, lorenz_entry_fp, lorenz_i256_entry_fp, lorenz_i256_range_entry_fp + 1, manifest_v3_fp) != 0 { return 25 }

    return 0
}
