//@ run-pass
//@ requires: madaros
//@ expect-stdout: unit literal suffix and return: PASS
// `200.0<mg>` brands a literal; a return of equal dimension and scale is
// accepted even when the registry index differs (derived quotient vs named
// unit); energy units J/eV resolve lazily and `as` converts between them.

unit velocity = m / s;

fn takes_mg(dose: mg) -> f64 with Mut {
    dose
}

fn speed(d: m, t: s) -> velocity with Mut {
    d / t
}

fn same_ev(e: eV) -> eV with Mut {
    e
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let base = 200.0<mg>
    let extra = 300.0<mg>
    let total = base + extra
    let checked = takes_mg(total)
    let v = speed(10.0<m>, 2.0<s>)
    let joules: J = 1.0
    let ev = same_ev(joules as eV)
    let less = 3.0 < 4.0
    if checked == 500.0 && (v as f64) == 5.0 && (ev as f64) == 1.0 && less {
        print("unit literal suffix and return: PASS\n")
    }
    return 0
}
