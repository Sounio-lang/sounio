//@ run-pass
//@ requires: madaros
//@ exit-code: 0
//@ description: sedenion [e1+e10, e1+e10, e4] has nsq 4; octonion embed Artin is 0
// Full Test Suite CI uses souc-stage2 (lean_single). Madaros runs this graph.

use algebra::octonion::{oct_basis}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}
use algebra::sedenion_action::{
    sed_embed_oct, sed_lmul_artin_nsq, sed_artin_witness_a, sed_artin_witness_v,
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var a: [f64; 16] = [0.0; 16]
    var v: [f64; 16] = [0.0; 16]
    sed_artin_witness_a(&!a)
    sed_artin_witness_v(&!v)

    var ok: i64 = 1
    if abs_f(sed_lmul_artin_nsq(&a, &v) - 4.0) > 1.0e-9 { ok = 0 }

    var art_a = oct_basis(1)
    var art_v = oct_basis(2)
    art_a[4] = 1.0
    art_v[5] = 1.0
    var art_ae: [f64; 16] = [0.0; 16]
    var art_ve: [f64; 16] = [0.0; 16]
    sed_embed_oct(&art_a, &!art_ae)
    sed_embed_oct(&art_v, &!art_ve)
    if sed_lmul_artin_nsq(&art_ae, &art_ve) > 1.0e-9 { ok = 0 }

    if ok == 1 { 0 } else { 1 }
}
