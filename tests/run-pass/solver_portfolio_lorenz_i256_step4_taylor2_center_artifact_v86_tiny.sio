//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v86 smoke for Lorenz i256 step-4 Taylor-2 center artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1759
    receipt_fp = mix(receipt_fp, 450696904, 5689)
    receipt_fp = mix(receipt_fp, 780071782, 5689)
    receipt_fp = mix(receipt_fp, 574699726, 5689)
    receipt_fp = mix(receipt_fp, 858781339, 5689)
    receipt_fp = mix(receipt_fp, 676159538, 5689)
    receipt_fp = mix(receipt_fp, 767589932, 5689)
    receipt_fp = mix(receipt_fp, 661481028, 5689)
    receipt_fp = mix(receipt_fp, 575348777, 5689)
    receipt_fp = mix(receipt_fp, 417943295, 5689)
    receipt_fp = mix(receipt_fp, 4, 5689)
    receipt_fp = mix(receipt_fp, 1, 5689)
    receipt_fp = mix(receipt_fp, 255, 5689)
    if receipt_fp != 828962730 { return 1 }

    var audit_fp: i64 = 1777
    audit_fp = mix(audit_fp, receipt_fp, 5693)
    audit_fp = mix(audit_fp, 450696904, 5693)
    audit_fp = mix(audit_fp, 780071782, 5693)
    audit_fp = mix(audit_fp, 574699726, 5693)
    audit_fp = mix(audit_fp, 858781339, 5693)
    audit_fp = mix(audit_fp, 575348777, 5693)
    audit_fp = mix(audit_fp, 417943295, 5693)
    audit_fp = mix(audit_fp, 661481028, 5693)
    audit_fp = mix(audit_fp, 4, 5693)
    audit_fp = mix(audit_fp, 1, 5693)
    audit_fp = mix(audit_fp, 255, 5693)
    if audit_fp != 560222765 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 89, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 89, 1103)
    if entry_fp != 36838171 { return 3 }

    let manifest_fp: i64 = 620969911
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 86, 1871)
    result_fp = mix(result_fp, 90, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 78, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 280126368 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 86, 1907)
    family_fp = mix(family_fp, 90, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 73, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 364511259 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 86, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 643405834 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 86, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 824303685 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 86, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 580966337 { return 8 }
    return 0
}
