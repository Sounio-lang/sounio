//@ run-pass
// Issue #901 science graph — textbook values from the #901 / prob vertical body,
// under default Madaros multi-module native (not lean_single).
//
// Expected (within tolerances matching tests/stdlib/prob/test_prob_stdlib.sio):
//   dist_normal_pdf(0,0,1) ≈ 0.398942
//   normal_cdf_full(0)     ≈ 0.5
//   normal_cdf_full(1.96)  ≈ 0.975
//   exponential_mean(2)    ≈ 0.5
//   uniform_mean(0,10)     ≈ 5
//   poisson_variance(3)    ≈ 3
//
// Gate: scripts/madaros_native_multimodule_scale_901_gate.sh
// Sentinel: PROB_TEXTBOOK_OK
use prob::distributions::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let pdf0 = dist_normal_pdf(0.0, 0.0, 1.0)
    if (if pdf0 > 0.398942 { pdf0 - 0.398942 } else { 0.398942 - pdf0 }) >= 1.0e-5 {
        print("FAIL pdf0\n")
        return 1
    }
    let c0 = normal_cdf_full(0.0, 0.0, 1.0)
    if (if c0 > 0.5 { c0 - 0.5 } else { 0.5 - c0 }) >= 1.0e-6 {
        print("FAIL cdf0\n")
        return 2
    }
    let c196 = normal_cdf_full(1.96, 0.0, 1.0)
    if (if c196 > 0.975 { c196 - 0.975 } else { 0.975 - c196 }) >= 1.0e-3 {
        print("FAIL cdf196\n")
        return 3
    }
    let em = exponential_mean(2.0)
    if (if em > 0.5 { em - 0.5 } else { 0.5 - em }) >= 1.0e-6 {
        print("FAIL exp_mean\n")
        return 4
    }
    let um = uniform_mean(0.0, 10.0)
    if (if um > 5.0 { um - 5.0 } else { 5.0 - um }) >= 1.0e-6 {
        print("FAIL unif_mean\n")
        return 5
    }
    let pv = poisson_variance(3.0)
    if (if pv > 3.0 { pv - 3.0 } else { 3.0 - pv }) >= 1.0e-6 {
        print("FAIL pois_var\n")
        return 6
    }
    print("PROB_TEXTBOOK_OK\n")
    return 0
}
