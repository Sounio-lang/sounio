//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 cover child-0 local-flowpipe preflight non-claim receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1889
    fp = mix(fp, 577517715, 5867)
    fp = mix(fp, 49794723, 5867)
    fp = mix(fp, 441058878, 5867)
    fp = mix(fp, 752370901, 5867)
    fp = mix(fp, 960341230, 5867)
    fp = mix(fp, 239912256, 5867)
    fp = mix(fp, 937619929, 5867)
    fp = mix(fp, 911209450, 5867)
    fp = mix(fp, 709377850, 5867)
    fp = mix(fp, 657988743, 5867)
    fp = mix(fp, 867133305, 5867)
    fp = mix(fp, 31177321, 5867)
    fp = mix(fp, 713010204, 5867)
    fp = mix(fp, 725222703, 5867)
    fp = mix(fp, 77888110, 5867)
    fp = mix(fp, 245178976, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 8, 5867)
    fp = mix(fp, 1, 5867)
    fp = mix(fp, 8, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 256, 5867)
    fp = mix(fp, 32, 5867)
    fp = mix(fp, 1000000, 5867)
    fp = mix(fp, 5, 5867)
    fp = mix(fp, 1, 5867)
    fp = mix(fp, 7, 5867)
    fp = mix(fp, 31, 5867)
    fp = mix(fp, 31, 5867)
    fp = mix(fp, 31, 5867)
    fp = mix(fp, 31, 5867)
    fp = mix(fp, 31, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 0, 5867)
    fp = mix(fp, 31, 5867)
    return fp
}

fn certificate_fp(instance: i64) -> i64 {
    var fp: i64 = 1901
    fp = mix(fp, instance, 5879)
    fp = mix(fp, 1, 5879)
    fp = mix(fp, 7, 5879)
    fp = mix(fp, 31, 5879)
    fp = mix(fp, 31, 5879)
    fp = mix(fp, 31, 5879)
    fp = mix(fp, 31, 5879)
    fp = mix(fp, 31, 5879)
    fp = mix(fp, 0, 5879)
    fp = mix(fp, 0, 5879)
    fp = mix(fp, 0, 5879)
    fp = mix(fp, 0, 5879)
    fp = mix(fp, 1, 5879)
    fp = mix(fp, 31, 5879)
    fp = mix(fp, 255, 5879)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1907
    fp = mix(fp, instance, 5903)
    fp = mix(fp, certificate, 5903)
    fp = mix(fp, 23, 5903)
    fp = mix(fp, 0, 5903)
    fp = mix(fp, 31, 5903)
    fp = mix(fp, 31, 5903)
    fp = mix(fp, 0, 5903)
    fp = mix(fp, 0, 5903)
    fp = mix(fp, 0, 5903)
    fp = mix(fp, 0, 5903)
    fp = mix(fp, 31, 5903)
    fp = mix(fp, 255, 5903)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1913
    fp = mix(fp, artifact, 5923)
    fp = mix(fp, instance, 5923)
    fp = mix(fp, certificate, 5923)
    fp = mix(fp, 577517715, 5923)
    fp = mix(fp, 49794723, 5923)
    fp = mix(fp, 441058878, 5923)
    fp = mix(fp, 752370901, 5923)
    fp = mix(fp, 960341230, 5923)
    fp = mix(fp, 239912256, 5923)
    fp = mix(fp, 937619929, 5923)
    fp = mix(fp, 911209450, 5923)
    fp = mix(fp, 709377850, 5923)
    fp = mix(fp, 657988743, 5923)
    fp = mix(fp, 867133305, 5923)
    fp = mix(fp, 31177321, 5923)
    fp = mix(fp, 713010204, 5923)
    fp = mix(fp, 725222703, 5923)
    fp = mix(fp, 77888110, 5923)
    fp = mix(fp, 245178976, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 8, 5923)
    fp = mix(fp, 1, 5923)
    fp = mix(fp, 8, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 256, 5923)
    fp = mix(fp, 32, 5923)
    fp = mix(fp, 1000000, 5923)
    fp = mix(fp, 5, 5923)
    fp = mix(fp, 1, 5923)
    fp = mix(fp, 7, 5923)
    fp = mix(fp, 31, 5923)
    fp = mix(fp, 31, 5923)
    fp = mix(fp, 31, 5923)
    fp = mix(fp, 31, 5923)
    fp = mix(fp, 31, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 0, 5923)
    fp = mix(fp, 31, 5923)
    fp = mix(fp, 255, 5923)
    return fp
}

fn main() -> i64 {
    let instance = instance_fp()
    if instance != 338034581 { return 1 }
    let certificate = certificate_fp(instance)
    if certificate != 537778915 { return 2 }
    let artifact = artifact_fp(instance, certificate)
    if artifact != 687983672 { return 3 }
    let audit = audit_fp(artifact, instance, certificate)
    if audit != 401304676 { return 4 }
    return 0
}
