//@ run-pass
//@ description: Test heap allocation growth pattern

fn main() -> i64 with IO, Alloc {
    // Start with small allocation
    var cap: i64 = 4
    var len: i64 = 0
    var ptr = heap_alloc(cap * 8)
    
    // Push 0..20 with growth
    var i: i64 = 0
    while i < 20 {
        if len >= cap {
            cap = cap * 2
            ptr = heap_realloc(ptr, cap * 8)
        }
        write_i64(ptr, len, i * 10)
        len = len + 1
        i = i + 1
    }
    
    // Verify all values
    var ok: i64 = 1
    i = 0
    while i < 20 {
        let v = read_i64(ptr, i)
        if v != i * 10 { ok = 0 }
        i = i + 1
    }
    
    // Verify capacity grew
    if cap < 20 { ok = 0 }
    
    heap_free(ptr)
    
    if ok == 1 {
        print("heap_vec_growth: PASS\n")
        return 0
    } else {
        print("heap_vec_growth: FAIL\n")
        return 1
    }
}
