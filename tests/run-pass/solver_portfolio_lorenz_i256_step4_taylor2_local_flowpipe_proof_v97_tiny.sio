//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v97 smoke for Lorenz i256 step-4 Taylor-2 local flowpipe proof

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1571
    receipt_fp = mix(receipt_fp, 354200144, 5437)
    receipt_fp = mix(receipt_fp, 97568991, 5437)
    receipt_fp = mix(receipt_fp, 552117012, 5437)
    receipt_fp = mix(receipt_fp, 793336125, 5437)
    receipt_fp = mix(receipt_fp, 252299410, 5437)
    receipt_fp = mix(receipt_fp, 478988651, 5437)
    receipt_fp = mix(receipt_fp, 759673798, 5437)
    receipt_fp = mix(receipt_fp, 804311422, 5437)
    receipt_fp = mix(receipt_fp, 676159538, 5437)
    receipt_fp = mix(receipt_fp, 811695381, 5437)
    receipt_fp = mix(receipt_fp, 4, 5437)
    receipt_fp = mix(receipt_fp, 16, 5437)
    receipt_fp = mix(receipt_fp, 255, 5437)
    if receipt_fp != 494170390 { return 1 }

    var audit_fp: i64 = 1579
    audit_fp = mix(audit_fp, receipt_fp, 5441)
    audit_fp = mix(audit_fp, 354200144, 5441)
    audit_fp = mix(audit_fp, 97568991, 5441)
    audit_fp = mix(audit_fp, 774274238, 5441)
    audit_fp = mix(audit_fp, 762477887, 5441)
    audit_fp = mix(audit_fp, 262483726, 5441)
    audit_fp = mix(audit_fp, 260510831, 5441)
    audit_fp = mix(audit_fp, 367295300, 5441)
    audit_fp = mix(audit_fp, 113336557, 5441)
    audit_fp = mix(audit_fp, 258802509, 5441)
    audit_fp = mix(audit_fp, 583092751, 5441)
    audit_fp = mix(audit_fp, 574699726, 5441)
    audit_fp = mix(audit_fp, 858781339, 5441)
    audit_fp = mix(audit_fp, 526525910, 5441)
    audit_fp = mix(audit_fp, 109012640, 5441)
    audit_fp = mix(audit_fp, 252299410, 5441)
    audit_fp = mix(audit_fp, 4, 5441)
    audit_fp = mix(audit_fp, 16, 5441)
    audit_fp = mix(audit_fp, 255, 5441)
    if audit_fp != 781321526 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 100, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 100, 1103)
    if entry_fp != 95709658 { return 3 }

    let manifest_fp: i64 = 663928611
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 97, 1871)
    result_fp = mix(result_fp, 101, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 89, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 916292975 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 97, 1907)
    family_fp = mix(family_fp, 101, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 84, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 86376712 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 97, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 446588679 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 97, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 22871079 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 97, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 2491648 { return 8 }
    return 0
}
