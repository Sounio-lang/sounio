//@ run-pass
//@ expect-stdout: TUPLE_SLOT_TYPED_OK
// `let p = pair.1` where `pair = c.make()` returns `(Ctx, Pat)` must type `p` as
// Pat. Madaros recorded only the FIRST struct slot of a tuple return (Ctx), so
// `p.name` fell to the untyped-field majority. Here, as in the self-compile,
// more kind-tagged structs carry `name` in slot 1 than in slot 2 (Pat.name), so
// the majority read Pat.span (3) instead of Pat.name (#2966: gen2 stored a
// wrong Pattern field as every let's name).

struct A1 { name: i64, x: i64 }
struct A2 { name: i64, y: i64 }
struct A3 { name: i64, z: i64 }
struct A4 { name: i64, w: i64 }
struct K1 { kind: i64, name: i64 }
struct K2 { kind: i64, name: i64, extra: i64 }
struct Pat { kind: i64, span: i64, name: i64 }
struct Ctx { pos: i64 }

impl Ctx {
    fn make(self) -> (Ctx, Pat) with Mut, Panic, Div {
        (Ctx { pos: self.pos + 1 }, Pat { kind: 7, span: 3, name: 42 })
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a1 = A1 { name: 1, x: 0 }
    let a2 = A2 { name: 2, y: 0 }
    let a3 = A3 { name: 3, z: 0 }
    let a4 = A4 { name: 4, w: 0 }
    let k1 = K1 { kind: 1, name: 5 }
    let k2 = K2 { kind: 2, name: 6, extra: 0 }
    let c = Ctx { pos: 0 }
    let pair = c.make()
    let p = pair.1
    let c2 = pair.0
    if p.name != 42 || p.kind != 7 || c2.pos != 1 {
        println(p.name)
        return 1
    }
    if a1.name + a2.name + a3.name + a4.name != 10 { return 2 }
    if k1.name + k2.name != 11 { return 3 }
    println("TUPLE_SLOT_TYPED_OK")
    return 0
}
