//@ run-pass
//@ requires: madaros
//@ expect-stdout: 1:nested-binop-ok
// SIO-568: a BinOp passed as a nested call arg (and BinOp results combined
// outside) check, compile and run. The raw ELF self-elevates its stack
// address-space limit on Linux, so this no longer depends on the caller
// having reserved it via bin/madaros or the suite wrapper.
fn id2(a: i64) -> i64 {
    a
}
fn main() -> i64 with IO {
    let x = 100
    print_int(id2(x + 1) - x)
    print(":nested-binop-ok")
    println("")
    return 0
}
