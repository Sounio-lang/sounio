//@ run-pass
// Tests for epistemic confidence monotonicity and GUM uncertainty propagation
// Self-contained: sqrt via Newton's method, exp via argument-reduction + Taylor series

fn ep_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn ep_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

// sqrt via Newton's method (20 iterations)
fn ep_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var r = x
    var si = 0
    while si < 20 {
        r = 0.5 * (r + x / r)
        si = si + 1
    }
    return r
}

// exp(-x) for x >= 0 via argument reduction + Taylor series
// Strategy: split x = n_whole + x_rem where x_rem in [0,1)
//   e^(-x) = e^(-x_rem) * (e^(-1))^n_whole
fn ep_exp_neg(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 1.0 }
    // Count whole units
    var en_whole = 0
    var en_rem = x
    while en_rem >= 1.0 {
        en_whole = en_whole + 1
        en_rem = en_rem - 1.0
    }
    // Taylor series for e^(-en_rem), en_rem in [0,1) — fast convergence
    var en_result = 1.0
    var en_term = 1.0
    var ek = 1
    while ek <= 15 {
        let ekf = ek as f64
        en_term = en_term * (0.0 - en_rem) / ekf
        en_result = en_result + en_term
        ek = ek + 1
    }
    // Multiply by e^(-1)^n_whole; e^(-1) = 0.36787944117144232
    let e_inv = 0.36787944117
    var ei = 0
    while ei < en_whole {
        en_result = en_result * e_inv
        ei = ei + 1
    }
    return en_result
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var n_pass = 0

    // T1: confidence_monotone_add: min(0.9, 0.8) = 0.8
    let ep_add_conf = ep_min(0.9, 0.8)
    if ep_abs(ep_add_conf - 0.8) < 0.01 { n_pass = n_pass + 1 }

    // T2: confidence_monotone_mul: min(0.95, 0.85) = 0.85
    let ep_mul_conf = ep_min(0.95, 0.85)
    if ep_abs(ep_mul_conf - 0.85) < 0.01 { n_pass = n_pass + 1 }

    // T3: confidence_monotone_compose: 0.9 * 0.9 = 0.81
    let ep_comp_conf = 0.9 * 0.9
    if ep_abs(ep_comp_conf - 0.81) < 0.01 { n_pass = n_pass + 1 }

    // T4: GUM add: u(a+b) = sqrt(u_a² + u_b²) = sqrt(0.09 + 0.16) = sqrt(0.25) = 0.5
    let gum_add_u = ep_sqrt(0.3 * 0.3 + 0.4 * 0.4)
    if ep_abs(gum_add_u - 0.5) < 0.001 { n_pass = n_pass + 1 }

    // T5: GUM mul: u_rel = sqrt((u_a/a)² + (u_b/b)²)
    // a=10, u_a=1 => u_rel_a=0.1; b=5, u_b=0.5 => u_rel_b=0.1
    // u_rel = sqrt(0.01+0.01) = sqrt(0.02) ≈ 0.1414 > 0.1
    let u_rel_a = 1.0 / 10.0
    let u_rel_b = 0.5 / 5.0
    let gum_mul_u = ep_sqrt(u_rel_a * u_rel_a + u_rel_b * u_rel_b)
    if gum_mul_u >= 0.1 { n_pass = n_pass + 1 }

    // T6: decay_bound: eps_0*exp(-lambda*t) >= min_bound
    // eps_0=1.0, lambda=0.1, t=1.0 => exp(-0.1) ≈ 0.9048 >= 0.8 ✓
    let decay6 = 1.0 * ep_exp_neg(0.1 * 1.0)
    if decay6 >= 0.8 { n_pass = n_pass + 1 }

    // T7: when bound is met, proof confidence = 1.0 >= 0.99
    if decay6 >= 0.8 { n_pass = n_pass + 1 }

    // T8: decay_bound fails: 0.5*exp(-5) ≈ 0.00337 < 0.5 => near-zero confidence
    let decay8 = 0.5 * ep_exp_neg(1.0 * 5.0)
    if decay8 < 0.5 { n_pass = n_pass + 1 }

    // T9: Dempster-Shafer combination
    // m1(H)=0.7, m2(H)=0.8; conflict C = 0.7*0.2 + 0.3*0.8 = 0.38
    // combined(H) = 0.56 / (1-0.38) = 0.56/0.62 ≈ 0.903 > max(0.7,0.8)=0.8 ✓
    let m1h = 0.7; let m2h = 0.8
    let m1nh = 1.0 - m1h; let m2nh = 1.0 - m2h
    let ds_conflict = m1h * m2nh + m1nh * m2h
    let ds_combined = m1h * m2h / (1.0 - ds_conflict)
    if ds_combined > 0.8 { n_pass = n_pass + 1 }

    // T10: ds_vacuous_identity — combining with vacuous BPA preserves belief
    // DS(m1, vacuous): combined(H) = m1(H)*1 / 1 = 0.7
    let vac_combined = m1h * 1.0 / 1.0
    if ep_abs(vac_combined - 0.7) < 0.01 { n_pass = n_pass + 1 }

    // T11: fusion_narrows_uncertainty: u_fused < min(u1, u2)
    // u1=0.3, u2=0.4 => u_fused = sqrt(1/(1/0.09+1/0.16)) = sqrt(0.0576) = 0.24 < 0.3 ✓
    let fu1 = 0.3; let fu2 = 0.4
    let u_fused = ep_sqrt(1.0 / (1.0 / (fu1 * fu1) + 1.0 / (fu2 * fu2)))
    if u_fused < ep_min(fu1, fu2) { n_pass = n_pass + 1 }

    // T12: epistemic subtype K<T,0.9> <: K<T,0.8> iff 0.9 >= 0.8
    let sc_high = 0.9; let sc_low = 0.8
    if sc_high >= sc_low { n_pass = n_pass + 1 }

    if n_pass == 12 {
        println("theorem_epistemic_monotonicity: 12/12 PASS")
        return 0
    } else {
        println("theorem_epistemic_monotonicity: FAIL")
        return 1
    }
}
