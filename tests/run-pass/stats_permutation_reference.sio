//@ run-pass
//@ expect-stdout: STATS_PERMUTATION_REFERENCE_PASS
use stats::permutation::{permutation_means}
fn case_0() with Mut, Div, Panic {
var x:[f64;256]=[0.0;256]
var y:[f64;256]=[0.0;256]
x[0]=1.00000000000000000e+00
x[1]=2.00000000000000000e+00
x[2]=3.00000000000000000e+00
y[0]=7.00000000000000000e+00
y[1]=8.00000000000000000e+00
y[2]=9.00000000000000000e+00
let r=permutation_means(&x,3,&y,3,0,42,true)
assert(r.status == 0)
assert(r.method == 2)
assert(r.hits == 2)
assert(r.draws == 20)
assert(r.seed_used == 0)
assert(abs(r.observed_diff / -6.00000000000000000e+00 - 1.0) < 3.0e-12)
assert(abs(r.p_value - 1.00000000000000006e-01) < 3.0e-12)
assert(!r.exchangeability_assessed)
assert(r.mc_available == false)
assert(x[0] == 1.00000000000000000e+00 && y[0] == 7.00000000000000000e+00)
}
