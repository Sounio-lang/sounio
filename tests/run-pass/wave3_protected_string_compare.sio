//@ run-pass
//@ requires: madaros
//@ expect-stdout: PROTECTED_STRING_COMPARE_OK
fn str_eq(a:i64,b:i64)->bool {a==b}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
    assert(str_eq(4,4))
    assert(!str_eq(4,5))
    assert("a"=="a")
    assert("a"!="b")
    assert(""=="")
    let joined="ab"+"cd"
    assert(joined=="abcd")
    assert(joined!="abc")
    println("PROTECTED_STRING_COMPARE_OK")
    0
}
