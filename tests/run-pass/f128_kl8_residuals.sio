//@ run-pass
//@ requires: madaros
//@ description: KL-8 — f128 surface residuals (nested if tail, `%`, `+=`, builtin println)
//@ kl-rung: KL-8
//@ expect-stdout-contains: kl8_main_entered
//@ expect-stdout-contains: nested_if_one=ok
//@ expect-stdout-contains: nested_if_two=ok
//@ expect-stdout-contains: rem_8_mod_3=ok
//@ expect-stdout-contains: compound_add=ok
//@ expect-stdout-contains: 3.00000000000000000000000000000000000e+0000
//@ expect-stdout-contains: PASS f128_kl8_residuals
//
// Gate: scripts/ci/madaros_kl8_f128_residuals_gate.sh

use math::softfloat_f128::{f128_to_lo, f128_to_hi}

fn limbs_eq(x: f128, lo: i64, hi: i64) -> bool with Mut, Panic, Div {
    f128_to_lo(x) == lo && f128_to_hi(x) == hi
}

fn pick(cond: bool) -> f128 {
    if cond { 1.0 } else { 2.0 }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    println("kl8_main_entered")

    let one = pick(true)
    if !limbs_eq(one, 0, 4611404543450677248) {
        println("FAIL nested_if_one")
        return 11
    }
    println("nested_if_one=ok")

    let two = pick(false)
    if !limbs_eq(two, 0, 4611686018427387904) {
        println("FAIL nested_if_two")
        return 12
    }
    println("nested_if_two=ok")

    let eight: f128 = 8.0
    let three: f128 = 3.0
    let rem: f128 = eight % three
    if !limbs_eq(rem, 0, 4611686018427387904) {
        println("FAIL rem_8_mod_3")
        return 13
    }
    println("rem_8_mod_3=ok")

    var acc: f128 = 1.0
    let two: f128 = 2.0
    acc += two
    if !limbs_eq(acc, 0, 4611826755915743232) {
        println("FAIL compound_add")
        return 14
    }
    println("compound_add=ok")

    let v: f128 = 3.0
    println(v)

    println("PASS f128_kl8_residuals nested_if_tail=% compound_add=println_f128")
    return 0
}
