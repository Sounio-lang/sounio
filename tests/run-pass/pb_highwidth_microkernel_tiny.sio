//@ run-pass
//@ description: Self-contained bounded PB high-width microkernel smoke

fn pb_abs_i64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn pb_bool_or_unknown_ok(v: i64) -> i64 {
    if v == 0 - 1 { return 1 }
    if v == 0 { return 1 }
    if v == 1 { return 1 }
    return 0
}

fn pb_var_value(var_id: i64, x1: i64, x2: i64, x3: i64) -> i64 {
    if var_id == 1 { return x1 }
    if var_id == 2 { return x2 }
    if var_id == 3 { return x3 }
    return 0 - 2
}

fn pb_lit_value_partial(lit: i64, x1: i64, x2: i64, x3: i64) -> i64 {
    if lit == 0 { return 0 }
    let v = pb_var_value(pb_abs_i64(lit), x1, x2, x3)
    if v == 0 - 1 { return 0 - 1 }
    if v == 0 - 2 { return 0 - 2 }
    if lit > 0 { return v }
    if v == 0 { return 1 }
    return 0
}

fn pb_lit_value_with_forced_false(
    lit: i64,
    forced_lit: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 with Mut {
    let lit_var = pb_abs_i64(lit)
    let forced_var = pb_abs_i64(forced_lit)
    if lit_var == forced_var {
        var forced_var_value: i64 = 0
        if forced_lit < 0 { forced_var_value = 1 }
        if lit > 0 { return forced_var_value }
        if forced_var_value == 0 { return 1 }
        return 0
    }
    return pb_lit_value_partial(lit, x1, x2, x3)
}

fn pb_term_value(coeff: i64, lit: i64, x1: i64, x2: i64, x3: i64) -> i64 {
    if coeff < 0 { return 0 - 1 }
    if lit == 0 { return 0 }
    let v = pb_lit_value_partial(lit, x1, x2, x3)
    if v < 0 { return 0 - 1 }
    return coeff * v
}

fn pb_term_max_without_forced(
    coeff: i64,
    lit: i64,
    forced_lit: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 with Mut {
    if coeff < 0 { return 0 - 1 }
    if lit == 0 { return 0 }
    let v = pb_lit_value_with_forced_false(lit, forced_lit, x1, x2, x3)
    if v == 0 - 2 { return 0 - 1 }
    if v == 0 - 1 { return coeff }
    return coeff * v
}

fn pb_row3_sum_i64(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    if pb_bool_or_unknown_ok(x1) != 1 { return 0 - 1 }
    if pb_bool_or_unknown_ok(x2) != 1 { return 0 - 1 }
    if pb_bool_or_unknown_ok(x3) != 1 { return 0 - 1 }
    let t1 = pb_term_value(a1, l1, x1, x2, x3)
    let t2 = pb_term_value(a2, l2, x1, x2, x3)
    let t3 = pb_term_value(a3, l3, x1, x2, x3)
    if t1 < 0 { return 0 - 1 }
    if t2 < 0 { return 0 - 1 }
    if t3 < 0 { return 0 - 1 }
    return t1 + t2 + t3
}

fn pb_row3_ge_check(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    rhs: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    let sum = pb_row3_sum_i64(a1, l1, a2, l2, a3, l3, x1, x2, x3)
    if sum >= rhs { return 1 }
    return 0
}

fn pb_row3_conflict_check(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    rhs: i64,
    x1: i64,
    x2: i64,
    x3: i64) -> i64 {
    let sum = pb_row3_sum_i64(a1, l1, a2, l2, a3, l3, x1, x2, x3)
    if sum < 0 { return 0 }
    if sum < rhs { return 1 }
    return 0
}

fn pb_row3_forced_lit_check(
    a1: i64,
    l1: i64,
    a2: i64,
    l2: i64,
    a3: i64,
    l3: i64,
    rhs: i64,
    x1: i64,
    x2: i64,
    x3: i64,
    forced_lit: i64) -> i64 with Mut {
    let t1 = pb_term_max_without_forced(a1, l1, forced_lit, x1, x2, x3)
    let t2 = pb_term_max_without_forced(a2, l2, forced_lit, x1, x2, x3)
    let t3 = pb_term_max_without_forced(a3, l3, forced_lit, x1, x2, x3)
    if t1 < 0 { return 0 }
    if t2 < 0 { return 0 }
    if t3 < 0 { return 0 }
    if t1 + t2 + t3 < rhs { return 1 }
    return 0
}

fn main() -> i64 with Mut {
    let row_ok = pb_row3_ge_check(2, 1, 2, 2, 1, 3, 4, 1, 1, 0)
    if row_ok != 1 { return 1 }

    let forced_y = pb_row3_forced_lit_check(2, 1, 2, 2, 1, 3, 4, 1, 0 - 1, 0 - 1, 2)
    if forced_y != 1 { return 2 }

    let conflict = pb_row3_conflict_check(2, 1, 2, 2, 1, 3, 4, 1, 0, 1)
    if conflict != 1 { return 3 }

    let wrong_forced_z = pb_row3_forced_lit_check(2, 1, 2, 2, 1, 3, 4, 1, 0 - 1, 0 - 1, 3)
    if wrong_forced_z != 0 { return 4 }

    let wrong_conflict = pb_row3_conflict_check(2, 1, 2, 2, 1, 3, 4, 1, 1, 0)
    if wrong_conflict != 0 { return 5 }

    let artifact_fp: i64 = 671902843
    let audit_fp: i64 = 238570416
    let instance_fp: i64 = 914035627
    let certificate_fp: i64 = 506781239
    let proof_family_mask: i64 = 4
    let proof_format_mask: i64 = 4
    let target_integer_width: i64 = 128
    let native_i128_evidence_mask: i64 = 0
    let imported_runtime_evidence_mask: i64 = 0
    let public_claim_mask: i64 = 0
    let formal_theorem_ready: i64 = 0
    let microkernel_status: i64 = 99
    let ok_mask: i64 = 1023

    if artifact_fp != 671902843 { return 6 }
    if audit_fp != 238570416 { return 7 }
    if instance_fp != 914035627 { return 8 }
    if certificate_fp != 506781239 { return 9 }
    if proof_family_mask != 4 { return 10 }
    if proof_format_mask != 4 { return 11 }
    if target_integer_width != 128 { return 12 }
    if native_i128_evidence_mask != 0 { return 13 }
    if imported_runtime_evidence_mask != 0 { return 14 }
    if public_claim_mask != 0 { return 15 }
    if formal_theorem_ready != 0 { return 16 }
    if microkernel_status != 99 { return 17 }
    if ok_mask != 1023 { return 18 }
    return 0
}
