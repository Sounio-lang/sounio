//@ run-pass
//@ expect-stdout: PHYSICS_COMPTON_PASS
use physics::scattering::{electron_compton_shift, COMPTON_OK, COMPTON_INVALID_INPUT}
fn close(g: f64, e: f64) -> bool {
 let scale = if e < 0.0 { 0.0-e } else { e }
 let delta = if g > e { g-e } else { e-g }
 delta <= 1.0e-12 * scale + 1.0e-290
}
fn main() with IO, Mut, Div, Panic {
 let p0 = electron_compton_shift(0.00000000000000000, 0.01)
 assert(p0.status == COMPTON_OK)
 assert(close(p0.shift_m, 0.00000000000000000))
 assert(close(p0.angular_standard_uncertainty_m, 0.00000000000000000))
 let p1 = electron_compton_shift(1.00000000000000000e-12, 0.01)
 assert(p1.status == COMPTON_OK)
 assert(close(p1.shift_m, 1.21315511769015856e-36))
 assert(close(p1.angular_standard_uncertainty_m, 2.42631023538031712e-26))
 let p2 = electron_compton_shift(1.00000000000000000e-08, 0.01)
 assert(p2.status == COMPTON_OK)
 assert(close(p2.shift_m, 1.21315511769015855e-28))
 assert(close(p2.angular_standard_uncertainty_m, 2.42631023538031708e-22))
 let p3 = electron_compton_shift(0.523598775598298873, 0.01)
 assert(p3.status == COMPTON_OK)
 assert(close(p3.shift_m, 3.25063934078761610e-13))
 assert(close(p3.angular_standard_uncertainty_m, 1.21315511769015856e-14))
 let p4 = electron_compton_shift(1.57079632679489662, 0.01)
 assert(p4.status == COMPTON_OK)
 assert(close(p4.shift_m, 2.42631023538031712e-12))
 assert(close(p4.angular_standard_uncertainty_m, 2.42631023538031712e-14))
 let p5 = electron_compton_shift(3.14159265358979324, 0.01)
 assert(p5.status == COMPTON_OK)
 assert(close(p5.shift_m, 4.85262047076063423e-12))
 assert(p5.angular_standard_uncertainty_m < 1.0e-26)
 let bad = electron_compton_shift(-1.0, 0.01)
 assert(bad.status == COMPTON_INVALID_INPUT)
 let bad_u = electron_compton_shift(1.0, -0.1)
 assert(bad_u.status == COMPTON_INVALID_INPUT)
 println("PHYSICS_COMPTON_PASS")
 0
}
