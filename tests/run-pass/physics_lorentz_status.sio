//@ run-pass
//@ expect-stdout: PHYSICS_LORENTZ_STATUS_PASS
use physics::lorentz::{lorentz_force_independent,lorentz_force_scalar_independent}
fn main() with IO,Mut,Div,Panic {
 let z:[f64;3]=[0.0;3]
 let e:[f64;3]=[1.0,2.0,3.0]
 let u:[f64;3]=[1.0;3]
 let bad:[f64;3]=[-1.0,0.0,0.0]
 let nan:[f64;3]=[0.0/0.0,0.0,0.0]
 let exact=lorentz_force_independent(2.0,0.0,&e,&z,&z,&z,&z,&z)
 assert(exact.status==0 && exact.force[0]==2.0 && exact.force[1]==4.0 && exact.force[2]==6.0)
 assert(exact.vector_standard_uncertainty==0.0)
 let uncertain=lorentz_force_independent(0.0,1.0,&e,&z,&z,&z,&z,&z)
 assert(uncertain.status==0 && uncertain.force[0]==0.0)
 assert(uncertain.covariance[0]==1.0 && uncertain.covariance[1]==2.0 && uncertain.covariance[8]==9.0)
 assert(uncertain.component_standard_uncertainties[1]==2.0)
 assert(uncertain.vector_standard_uncertainty>3.74 && uncertain.vector_standard_uncertainty<3.75)
 assert(!(!uncertain.first_order) && uncertain.uncertainty_model==1)
 let isotropic=lorentz_force_independent(2.0,0.0,&e,&u,&z,&z,&z,&z)
 assert(isotropic.status==0 && isotropic.covariance[0]==4.0 && isotropic.covariance[4]==4.0 && isotropic.covariance[8]==4.0)
 assert(isotropic.covariance[1]==0.0)
 let invalid=lorentz_force_independent(1.0,0.0,&e,&bad,&z,&z,&z,&z)
 assert(invalid.status==3 && invalid.force[0]==0.0 && invalid.vector_standard_uncertainty==0.0)
 assert(invalid.uncertainty_model==1 && invalid.first_order)
 let finite_first=lorentz_force_independent(1.0,-1.0,&nan,&z,&z,&z,&z,&z)
 assert(finite_first.status==1)
 let scalar=lorentz_force_scalar_independent(1.0,1.0,-6.0,0.0,2.0,0.0,3.0,0.0)
 assert(scalar.status==0 && scalar.force==0.0 && scalar.standard_uncertainty==0.0)
 let shared=lorentz_force_scalar_independent(1.0,1.0,1.0,0.0,2.0,0.0,3.0,0.0)
 assert(shared.status==0 && shared.force==7.0 && shared.standard_uncertainty==7.0)
 let negative=lorentz_force_scalar_independent(1.0,0.0,1.0,-1.0,2.0,0.0,3.0,0.0)
 assert(negative.status==3 && negative.force==0.0 && negative.standard_uncertainty==0.0)
 println("PHYSICS_LORENTZ_STATUS_PASS")
 0
}
