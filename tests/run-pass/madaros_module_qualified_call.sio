//@ run-pass
//@ requires: madaros
//@ expect-stdout: MODULE_QUALIFIED_CALL PASS
//
// After `use a::b;`, `b::f(..)` and `a::b::f(..)` call the free fn `f`.
// Madaros mangled them like Type::method (`dd64_dd_from_f64`), a name with no
// body, and dead-code elimination dropped `dd_from_f64` itself; native codegen
// emitted a ud2 stub and the binary died with SIGILL while `check` passed.
// The values are nonzero so a stub that returns 0 cannot pass.
//
// The same resolver that strips leading module segments off a free-fn call
// must leave `mod::Type::method` and `a::mod::Type::method` alone: those are
// associated calls, not qualified free functions, and this PR relies on that
// distinction (callee_path_module_stripped_name breaks its stripping loop the
// moment a segment names a known type, per its own comment). AfNum::quad is
// af_mod's witness fixture (stdlib/testmod/af_mod.sio) for a related
// impl-body DCE bug, reused here because it is a real associated fn reachable
// through both forms — a regression that flattened either call to the bare
// free-fn name `quad` (or bound any other body-less stub) instead of the
// correct mangled impl symbol `AfNum_quad` would not otherwise be caught.
use math::dd64;
use testmod::af_mod::{AfNum};

fn main() -> i32 with IO, Mut, Panic {
    let a = dd64::dd_from_f64(2.5)
    let b = math::dd64::dd_from_f64(1.25)
    let s = dd64::dd_to_f64(dd64::dd_add(a, b))

    let r1 = af_mod::AfNum::quad(5.0)
    let r2 = testmod::af_mod::AfNum::quad(5.0)

    if s == 3.75 && r1 == 10.0 && r2 == 10.0 {
        println("MODULE_QUALIFIED_CALL PASS")
        return 0
    }
    1
}
