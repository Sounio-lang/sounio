//@ run-pass
//@ requires: madaros
//@ expect-stdout: MODULE_QUALIFIED_CALL PASS
//
// After `use a::b;`, `b::f(..)` and `a::b::f(..)` call the free fn `f`.
// Madaros mangled them like Type::method (`dd64_dd_from_f64`), a name with no
// body, and dead-code elimination dropped `dd_from_f64` itself; native codegen
// emitted a ud2 stub and the binary died with SIGILL while `check` passed.
// The values are nonzero so a stub that returns 0 cannot pass.
use math::dd64;

fn main() -> i32 with IO {
    let a = dd64::dd_from_f64(2.5)
    let b = math::dd64::dd_from_f64(1.25)
    let s = dd64::dd_to_f64(dd64::dd_add(a, b))
    if s == 3.75 {
        println("MODULE_QUALIFIED_CALL PASS")
        return 0
    }
    1
}
