//@ run-pass
//@ description: Parser frontier witness for enum tuple/struct data and construction.

enum Event {
    A,
    B(i64),
    C { x: i64 }
}

fn main() -> i64 {
    let b = Event::B(42)
    let c = Event::C { x: 9 }

    match b {
        Event::B(n) => {
            let from_tuple = n
        }
        Event::C { x: cx } => {
            let from_struct = cx
        }
        Event::A => {
            let from_unit = 0
        }
        _ => {
            let fallback = 0
        }
    }

    match c {
        Event::C { x: cy } => {
            let from_constructed_struct = cy
        }
        _ => {
            let fallback2 = 0
        }
    }

    0
}
