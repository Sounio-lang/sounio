//@ run-pass
// FIXED (A8, 2026-07-06). SIZE-INDEPENDENT witness (Small{c:[i64;4]}). RUN rc=0.
// Cross-module SMALL-struct (Small{c:[i64;4]}) that FORWARDS through an inner
// struct-returning call (`var r = small_zero(k); r.c[i]=1; return r`). SIGSEGVs
// exactly like big_basis — proving the fault is the forwarding lowering, NOT size.
// See docs/handoff/continuity/A8_CROSSMOD_FORWARDING_MISCOMPILE.md

use testmod::sret_min::{Small, small_basis_fwd}

fn main() -> i64 with IO, Mut, Panic {
    println("FWD_start")
    let s = small_basis_fwd(4, 1)
    println("FWD_after_call")
    print_int(s.c[1])
    print("\n")
    print_int(s.bits as i64)
    print("\n")
    println("FWD_done")
    return 0
}
