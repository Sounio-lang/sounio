//@ run-pass
//@ expect-stdout: IDAS_SOUNIO_WITNESS_PASS
// Independent analytic witness motivated by SUNDIALS IDAS #1065.
// This is neither an IDAS implementation nor an automatic differentiation test.

fn idas_power(t: f64, degree: i64) -> f64 {
    var value: f64 = 1.0
    var i: i64 = 0
    while i < degree {
        value = value * t
        i = i + 1
    }
    return value
}

fn idas_solution(t: f64, parameter: f64, factor: f64, degree: i64) -> f64 {
    return t + parameter * factor * idas_power(t, degree)
}

fn main() -> i32 with IO, Div, Panic {
    let scale: f64 = 1073741824.0
    let h: f64 = 0.0009765625
    println("IDAS_SOUNIO_GRID_V1")
    var degree_index: i64 = 0
    while degree_index < 3 {
        var degree: i64 = 1
        if degree_index == 1 { degree = 3 }
        if degree_index == 2 { degree = 5 }
        var factor_index: i64 = 0
        while factor_index < 3 {
            var factor: f64 = 1.0
            if factor_index == 1 { factor = -2.0 }
            if factor_index == 2 { factor = 0.5 }
            var time_index: i64 = 0
            while time_index < 4 {
                var t: f64 = 0.0
                if time_index == 1 { t = 0.25 }
                if time_index == 2 { t = 0.5 }
                if time_index == 3 { t = 1.0 }
                let sensitivity: f64 = factor * idas_power(t, degree)
                let sensitivity_derivative: f64 = factor * (degree as f64) * idas_power(t, degree - 1)
                let plus: f64 = idas_solution(t, h, factor, degree)
                let minus: f64 = idas_solution(t, -h, factor, degree)
                let finite_difference: f64 = (plus - minus) / (2.0 * h)
                assert(finite_difference == sensitivity)
                assert(idas_solution(t, 0.0, factor, degree) == t)
                println(degree)
                println(factor_index)
                println(time_index)
                println((sensitivity * scale) as i64)
                println((sensitivity_derivative * scale) as i64)
                time_index = time_index + 1
            }
            factor_index = factor_index + 1
        }
        degree_index = degree_index + 1
    }
    // One forward-Euler step sees the linear state exactly, but integrates
    // s_prime=3*t*t from t=0 to t=1 as zero instead of the analytic one.
    // This illustrates the information lost by state-only acceptance; it is
    // explicitly a toy method, not a reproduction of IDAS stepping internals.
    let coarse_state: f64 = 0.0 + 1.0 * 1.0
    let coarse_sensitivity: f64 = 0.0 + 1.0 * 3.0 * 0.0 * 0.0
    let exact_sensitivity: f64 = idas_power(1.0, 3)
    assert(coarse_state == idas_solution(1.0, 0.0, 1.0, 3))
    assert(exact_sensitivity == 1.0)
    assert(coarse_sensitivity == 0.0)
    assert(coarse_sensitivity != exact_sensitivity)
    println("IDAS_SOUNIO_WITNESS_PASS")
    return 0
}
