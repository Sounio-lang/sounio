//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: STDLIB_DEEP_DYNAMIC_QR_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_status,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close,numeric_matrix}
use linalg::dynamic_least_squares::{dynamic_qr_workspace,dynamic_qr_least_squares}
fn abs(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn main()->i32 with IO, Alloc, Mut, Div, Panic {
    let m:i64=8192
    let p:i64=64
    let need=dynamic_qr_workspace(m,p)
    assert(need>0)
    assert(dynamic_qr_workspace(9223372036854775807,2)==-1)
    var a=numeric_buffer_new(m*p,m*p*8)
    var b=numeric_buffer_new(m,m*8)
    var x=numeric_buffer_new(p,p*8)
    var work=numeric_buffer_new(need,need*8)
    assert(numeric_buffer_status(&a)==0 && numeric_buffer_status(&work)==0)
    var i:i64=0
    while i<m {
        let category=i%p
        numeric_buffer_set(&!a,i*p+category,1.0)
        numeric_buffer_set(&!b,i,(category+1) as f64)
        i=i+1
    }
    let layout=numeric_matrix(m*p,m,p,p,1,0)
    let fit=dynamic_qr_least_squares(&a,&layout,&b,&!x,&!work,0.0)
    assert(fit.status==0 && fit.rank==p && fit.df==m-p)
    assert(fit.residual_norm<1.0e-9)
    i=0
    while i<p {assert(abs(numeric_buffer_at(&x,i)-((i+1) as f64))<1.0e-10);i=i+1}
    // Deliberate dependence must preserve the caller's existing output.
    i=0
    while i<m {
        let duplicate=numeric_buffer_at(&a,i*p)
        numeric_buffer_set(&!a,i*p+1,duplicate)
        i=i+1
    }
    numeric_buffer_set(&!x,0,12345.0)
    let deficient=dynamic_qr_least_squares(&a,&layout,&b,&!x,&!work,0.0)
    assert(deficient.status==3)
    assert(numeric_buffer_at(&x,0)==12345.0)
    numeric_buffer_close(a)
    numeric_buffer_close(b)
    numeric_buffer_close(x)
    numeric_buffer_close(work)
    print("STDLIB_DEEP_DYNAMIC_QR_PASS\n")
    return 0
}
