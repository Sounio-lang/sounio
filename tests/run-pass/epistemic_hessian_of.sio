//@ run-pass
// Test hessian_of(y, j, k) for second-order AD
// f(x, y) = x * y  =>  H[0,1] = 1, H[0,0] = 0, H[1,1] = 0
// f(x) = x * x    =>  H[0,0] = 2
// f(x, y) = x * x * y  =>  H[0,0] = 2y, H[0,1] = 2x, H[1,1] = 0

fn test_xy() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    let z = x * y
    hessian_of(z, 0, 1)  // ∂²(x*y)/∂x∂y = 1
}

fn test_xx() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let x = xm.value
    let z = x * x
    hessian_of(z, 0, 0)  // ∂²(x²)/∂x² = 2
}

fn test_xxy() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    let z = x * x * y
    hessian_of(z, 0, 0)  // ∂²(x²y)/∂x² = 2y = 10.0
}

fn main() with IO, Epistemic {
    let h01 = test_xy()
    let h00_xx = test_xx()
    let h00_xxy = test_xxy()
    println(h01)      // expect 1.0
    println(h00_xx)   // expect 2.0
    println(h00_xxy)  // expect 10.0
}
