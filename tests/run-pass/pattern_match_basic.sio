//@ run-pass
//@ expect-stdout-contains: pattern_match_basic: PASS
// Basic match pattern coverage and binding

fn main() -> i64 with IO {
    var exit_fails: i64 = 0
    let x = 1
    let y = match x {
        0 => 10
        1 => 20
        _ => 30
    }

    if y == 20 {
        print("pattern_match_basic: PASS\n")
    } else {
        print("pattern_match_basic: FAIL\n")
        exit_fails = exit_fails + 1
    }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
