//@ run-pass
//@ description: Approx effect propagates through closures

fn approx_iter(x: f64) -> f64 with Approx, Mut, Div, Panic {
    var y: f64 = x
    var i: i64 = 0
    while i < 5 {
        y = y - (y * y - x) / (2.0 * y)
        i = i + 1
    }
    y
}

fn main() -> i64 with IO, Approx, Mut, Div, Panic {
    // Closure calling Approx function gets implicit Approx
    let f = |x: f64| -> f64 { approx_iter(x) }
    let r = f(2.0)
    println(r)
    0
}
