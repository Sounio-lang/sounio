//@ run-pass
//@ requires: madaros
//@ expect-stdout: 9223372036854775808
//@ expect-stdout: 9223372036854775808
//@ expect-stdout: 18446744073709551614
//@ expect-stdout: 18446744073709551615
//@ expect-stdout: U64_IN_RANGE_PASS

// ADR-031 R1: unsigned +, -, * fail only on UNSIGNED overflow. Each result
// below fits u64 but would overflow i64, so a guard on the signed condition
// (jo after add/sub/imul) would trap here by mistake. The id() indirection
// keeps the operands out of const folding so the runtime OpUAdd/OpUSub/
// OpUMul path is exercised. The panic cases (MAX+1, 0-1, MAX*2) are pinned
// by scripts/ci/madaros_int_overflow_gate.sh.
fn id(x: u64) -> u64 { x }

fn main() -> i32 with IO {
    let m: u64 = id(9223372036854775807)
    println(m + 1)
    let q: u64 = id(4611686018427387904)
    println(q * 2)
    let t: u64 = id(18446744073709551615)
    println(t - 1)
    let s: u64 = id(18446744073709551614)
    println(s + 1)
    if m + 1 == 9223372036854775808 && q * 2 == 9223372036854775808 && t - 1 == 18446744073709551614 {
        print("U64_IN_RANGE_PASS\n")
    }
    return 0
}
