//@ run-pass
// Native async runtime regression: spawned task must execute as a distinct
// clone-launched task and return its own PID through the shared task record.

fn raw_getpid() -> i64 with IO {
    return syscall6(39, 0, 0, 0, 0, 0, 0)
}

fn main() with IO, Async {
    let parent_pid = raw_getpid()
    let child_pid = spawn {
        raw_getpid()
    }.await

    if child_pid != parent_pid {
        print("spawn_pid: PASS\n")
    } else {
        print("spawn_pid: FAIL\n")
    }
}
