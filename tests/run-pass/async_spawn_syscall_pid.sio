//@ run-pass
//@ expect-stdout-contains: spawn_tid: PASS
// Native async runtime regression: spawned task must execute on a distinct
// clone-thread worker. PID stays shared, but TID must differ.

fn raw_getpid() -> i64 with IO {
    return syscall6(39, 0, 0, 0, 0, 0, 0)
}

fn raw_gettid() -> i64 with IO {
    return syscall6(186, 0, 0, 0, 0, 0, 0)
}

fn main() with IO, Async {
    let parent_pid = raw_getpid()
    let parent_tid = raw_gettid()
    let child_tid = spawn {
        raw_gettid()
    }.await

    if raw_getpid() == parent_pid && child_tid != parent_tid {
        print("spawn_tid: PASS\n")
    } else {
        print("spawn_tid: FAIL\n")
    }
}
