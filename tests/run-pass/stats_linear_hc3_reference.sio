fn case_18() with Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var row:i64=0
 while row<256 {
  var response=((row*7)%13-6) as f64
  response=response*0.125
  var j:i64=0
  while j<8 {
   var ti=row
   var tj=j
   var parity:i64=0
   while tj>0 {
    if ti%2==1 && tj%2==1 {parity=1-parity}
    ti=ti/2
    tj=tj/2
   }
   let x=if parity==1 {-1.0}else{1.0}
   a[(row*8+j) as usize]=x
   response=response+x*((j+1) as f64)
   j=j+1
  }
  b[row as usize]=response
  row=row+1
 }
