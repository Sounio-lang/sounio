//@ run-pass
//@ requires: madaros
//@ expect-stdout: LINEAR_AGGREGATE_BORROW_CLOSE_OK
linear struct WaveResource { id: i64 }
struct WaveWrapper { resource: WaveResource }
struct WaveNested { wrapper: WaveWrapper }
fn inspect(owner: &WaveNested) -> i64 { owner.wrapper.resource.id }
fn close(resource: WaveResource) -> i64 { resource.id }
fn close_wrapper(wrapper: WaveWrapper) -> i64 { close(wrapper.resource) }
fn close_nested(nested: WaveNested) -> i64 { close_wrapper(nested.wrapper) }
fn main() -> i32 with IO, Mut, Panic {
    let nested = WaveNested { wrapper: WaveWrapper { resource: WaveResource { id: 42 } } }
    let first = inspect(&nested)
    let second = inspect(&nested)
    let closed = close_nested(nested)
    if first != 42 { return 1 }
    if second != 42 { return 2 }
    if closed != 42 { return 3 }
    println("LINEAR_AGGREGATE_BORROW_CLOSE_OK")
    0
}
