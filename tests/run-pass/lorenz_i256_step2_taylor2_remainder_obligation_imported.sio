//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-2 Taylor-2 remainder obligation smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step2_taylor2_remainder_obligation_check(
        40000, 55000, 10000, 0)
    if artifact_fp != 444092349 { return 1 }
    let audit_fp = lorenz_i256_step2_taylor2_remainder_obligation_audit_fingerprint(
        artifact_fp, 272280595, 598358642, 482555681, 554654324,
        443171640, 2, 5, 127, 0, 0)
    if audit_fp != 625429438 { return 2 }
    return 0
}
