    let root_buf = rawbuf_new(root_der_len + 8)
    var i: i64 = 0
    while i < root_der_len { rawbuf_set(&root_buf, i, root_der_bytes[i as usize] as i64); i = i + 1 }

    let leaf_buf = rawbuf_new(leaf_der_len + 8)
    var j: i64 = 0
    while j < leaf_der_len { rawbuf_set(&leaf_buf, j, leaf_der_bytes[j as usize] as i64); j = j + 1 }

    let bad_buf = rawbuf_new(leaf_der_len + 8)
    var k: i64 = 0
    while k < leaf_der_len { rawbuf_set(&bad_buf, k, bad_leaf_der_bytes[k as usize] as i64); k = k + 1 }

    var root_cert = certificate_zero()
    let (root_raw, e1) = x509_parse_certificate(&root_buf, root_der_len)
    root_cert = root_raw
    if e1 != X509_OK { print_int(1); return 1 }

    var leaf_cert = certificate_zero()
    let (leaf_raw, e2) = x509_parse_certificate(&leaf_buf, leaf_der_len)
    leaf_cert = leaf_raw
    if e2 != X509_OK { print_int(2); return 1 }

    var bad_cert = certificate_zero()
    let (bad_raw, e3) = x509_parse_certificate(&bad_buf, leaf_der_len)
    bad_cert = bad_raw
    if e3 != X509_OK { print_int(3); return 1 }

    if root_cert.public_key_algorithm != PUBKEY_ALG_EC_P256 { print_int(4); return 1 }
    if leaf_cert.public_key_algorithm != PUBKEY_ALG_EC_P256 { print_int(5); return 1 }
    assert(leaf_cert.public_key_algorithm == PUBKEY_ALG_EC_P256)

    // ---- The self-signed ROOT's own ecdsa-with-SHA384 signature must
    // verify against its own P-256 key. Before this fix, false. ----
    let root_ok = x509_verify_signature(&root_buf, &root_cert, &root_cert)
    if root_ok == false { print_int(6); return 1 }
    assert(root_ok)

    // ---- The LEAF's ecdsa-with-SHA384 signature must verify against the
    // ROOT's P-256 key -- the cross-certificate case, and the one that
    // matters for real chains. ----
    let leaf_ok = x509_verify_signature(&leaf_buf, &leaf_cert, &root_cert)
    if leaf_ok == false { print_int(7); return 1 }
    assert(leaf_ok)

    // ---- One flipped bit inside the signature must be REJECTED. A
    // truncation bug that discarded the wrong end of the SHA-384 digest
    // could still pass the two checks above under a self-consistent
    // implementation; it must also reject genuine corruption. ----
    let bad_ok = x509_verify_signature(&bad_buf, &bad_cert, &root_cert)
    if bad_ok == true { print_int(8); return 1 }
    assert(bad_ok == false)

    // ---- The leaf must NOT verify against the wrong issuer key (itself),
    // even though both are P-256 and both are ecdsa-with-SHA384. ----
    let wrong_issuer = x509_verify_signature(&leaf_buf, &leaf_cert, &leaf_cert)
    if wrong_issuer == true { print_int(9); return 1 }
    assert(wrong_issuer == false)

    // ---- Full chain: root as the sole trust anchor, leaf as the target,
    // no intermediates. Previously CHAIN_ERR_BAD_SIGNATURE (-6). ----
    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = root_cert
    store.bufs[0] = root_buf

    var intermediates: [Certificate; 8] = [certificate_zero(); 8]
    var intermediate_bufs: [RawBuf; 8] = [rawbuf_new(1); 8]

    // "sha384-leaf-test.example" (24 bytes), zero-padded to 32.
    let hostname_text: [u8; 32] = [
        115, 104, 97, 51, 56, 52, 45, 108, 101, 97, 102, 45, 116, 101, 115, 116, 46, 101, 120, 97, 109, 112, 108, 101, 0, 0, 0, 0, 0, 0, 0, 0
    ]
    let hostname_len: i64 = 24
    let hostname_buf = rawbuf_new(32)
    var h: i64 = 0
    while h < hostname_len { rawbuf_set(&hostname_buf, h, hostname_text[h as usize] as i64); h = h + 1 }

    // Fixed timestamp inside the fixture's validity window (notBefore
    // Aug 27 14:02:03 2026 GMT, notAfter Aug 24 14:02:03 2036 GMT).
    let now_unix: i64 = 1787925723

    let result = x509_verify_chain(&leaf_cert, &leaf_buf, &intermediates, &intermediate_bufs, 0, &store, &hostname_buf, hostname_len, now_unix, &rawbuf_new(1), 0)
    if result != CHAIN_OK {
        print_int(result)
        return 1
    }
    assert(result == CHAIN_OK)

    // ---- The same chain with the corrupted leaf must be rejected. ----
    let bad_result = x509_verify_chain(&bad_cert, &bad_buf, &intermediates, &intermediate_bufs, 0, &store, &hostname_buf, hostname_len, now_unix, &rawbuf_new(1), 0)
    if bad_result == CHAIN_OK {
        print_int(10)
        return 1
    }
    assert(bad_result != CHAIN_OK)

    println("x509_chain_ecdsa_sha384_signature: real ecdsa-with-SHA384 P-256 chain verified, corrupted sig rejected")
    return 0
}
