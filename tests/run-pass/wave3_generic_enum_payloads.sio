//@ run-pass
//@ requires: madaros
//@ expect-stdout: GENERIC_ENUM_NOMINAL_PAYLOAD_OK
enum WaveOption<T> {Some(T),None}
enum WaveResult<T,E> {Ok(T),Err(E)}
fn make_i()->WaveOption<i64> {WaveOption::Some(7)}
fn make_f()->WaveOption<f64> {WaveOption::Some(1.25)}
fn empty_i()->WaveOption<i64> {WaveOption::None}
fn read_i(x:WaveOption<i64>)->i64 {match x {WaveOption::Some(v)=>v,WaveOption::None=>0}}
fn read_f(x:WaveOption<f64>)->f64 {match x {WaveOption::Some(v)=>v,WaveOption::None=>0.0}}
fn make_result()->WaveResult<i64,f64> {WaveResult::Err(2.5)}
fn read_result(x:WaveResult<i64,f64>)->f64 {match x {WaveResult::Ok(v)=>v as f64,WaveResult::Err(e)=>e}}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
    let ints=make_i()
    let floats=make_f()
    assert(read_i(ints)==7)
    assert(read_f(floats)==1.25)
    assert(read_i(empty_i())==0)
    assert(read_result(make_result())==2.5)
    println("GENERIC_ENUM_NOMINAL_PAYLOAD_OK")
    0
}
