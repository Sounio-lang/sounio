//@ run-pass
//@ known-failure: Epistemic runtime not implemented
//@ expect-stdout: ALL PASS

// Door 1 validation: real 64-input × 32-output dense layer with epistemic uncertainty.
// Exercises: 65K-element weight matrix, GUM uncertainty propagation, forward + backward + update.
// Total arrays: weights[2048], biases[32], uncertainties[2048], input[64], output[32],
//   grad_w[2048], grad_b[32], delta[32] — well within Door 1's 1024-variable limit.

// ─── Math helpers ───

fn sqrt_d1(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn abs_d1(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn exp_d1(x: f64) -> f64 with Mut, Div, Panic {
    if x > 20.0 { return exp_d1(10.0) * exp_d1(x - 10.0) }
    if x < 0.0 - 20.0 { return 0.0 }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 20 { term = term * x / (i as f64); sum = sum + term; i = i + 1 }
    sum
}

fn sigmoid_d1(x: f64) -> f64 with Mut, Div, Panic {
    1.0 / (1.0 + exp_d1(0.0 - x))
}

fn sigmoid_deriv_d1(y: f64) -> f64 {
    y * (1.0 - y)
}

// ─── Pseudo-random (LCG) ───

var RNG_STATE: i64 = 42

fn rng_next() -> f64 with Mut, Div, Panic {
    RNG_STATE = (RNG_STATE * 6364136223846793005 + 1442695040888963407)
    let bits = RNG_STATE
    var v = bits
    if v < 0 { v = 0 - v }
    let r = (v % 10000) as f64
    r / 10000.0
}

fn rng_normal_approx() -> f64 with Mut, Div, Panic {
    // Box-Muller-like: sum of 12 uniforms - 6 ≈ N(0,1)
    var sum = 0.0
    var i = 0
    while i < 12 { sum = sum + rng_next(); i = i + 1 }
    sum - 6.0
}

// ─── Layer dimensions ───
// 64 inputs → 32 outputs via 64×32 = 2048 weights
// This is a real layer size, not a toy 4×4.

fn INPUT_DIM() -> i64 { 64 }
fn OUTPUT_DIM() -> i64 { 32 }
fn WEIGHT_COUNT() -> i64 { 2048 }  // 64 × 32

// ─── Forward pass with GUM uncertainty propagation ───

struct ForwardResult {
    output: [f64; 32],
    output_unc: [f64; 32],
}

fn forward(
    input: &[f64; 64],
    weights: &[f64; 2048],
    biases: &[f64; 32],
    uncertainties: &[f64; 2048]
) -> ForwardResult with Mut, Div, Panic {
    var output: [f64; 32] = [0.0; 32]
    var output_unc: [f64; 32] = [0.0; 32]

    var j = 0
    while j < 32 {
        var sum = biases[j as usize]
        var var_sum = 0.0  // accumulated variance (GUM)

        var i = 0
        while i < 64 {
            let w_idx = i * 32 + j
            let w = weights[w_idx as usize]
            let x = input[i as usize]
            let u = uncertainties[w_idx as usize]

            sum = sum + w * x
            // GUM law of propagation: var(w*x) = x²·σ_w² + w²·σ_x²
            // Assuming input uncertainty = 0 for now: var = x²·σ_w²
            var_sum = var_sum + x * x * u * u
            i = i + 1
        }

        // Apply sigmoid activation
        let activated = sigmoid_d1(sum)
        output[j as usize] = activated

        // Propagate uncertainty through sigmoid: σ_out = |sigmoid'(z)| · σ_z
        let deriv = sigmoid_deriv_d1(activated)
        output_unc[j as usize] = abs_d1(deriv) * sqrt_d1(var_sum)

        j = j + 1
    }

    ForwardResult { output: output, output_unc: output_unc }
}

// ─── Backward pass (gradient computation) ───

struct GradResult {
    grad_w: [f64; 2048],
    grad_b: [f64; 32],
    delta: [f64; 32],
}

fn backward(
    input: &[f64; 64],
    output: &[f64; 32],
    target: &[f64; 32],
    weights: &[f64; 2048]
) -> GradResult with Mut, Div, Panic {
    var grad_w: [f64; 2048] = [0.0; 2048]
    var grad_b: [f64; 32] = [0.0; 32]
    var delta: [f64; 32] = [0.0; 32]

    // Compute delta = (output - target) * sigmoid'(output)
    var j = 0
    while j < 32 {
        let err = output[j as usize] - target[j as usize]
        let d = err * sigmoid_deriv_d1(output[j as usize])
        delta[j as usize] = d
        grad_b[j as usize] = d
        j = j + 1
    }

    // Compute weight gradients: grad_w[i,j] = input[i] * delta[j]
    var i = 0
    while i < 64 {
        j = 0
        while j < 32 {
            let w_idx = i * 32 + j
            grad_w[w_idx as usize] = input[i as usize] * delta[j as usize]
            j = j + 1
        }
        i = i + 1
    }

    GradResult { grad_w: grad_w, grad_b: grad_b, delta: delta }
}

// ─── Weight update with uncertainty tracking ───

struct UpdateResult {
    weights: [f64; 2048],
    biases: [f64; 32],
    uncertainties: [f64; 2048],
}

fn update_weights(
    weights: &[f64; 2048],
    biases: &[f64; 32],
    uncertainties: &[f64; 2048],
    grad_w: &[f64; 2048],
    grad_b: &[f64; 32],
    lr: f64
) -> UpdateResult with Mut, Div, Panic {
    var w_out: [f64; 2048] = [0.0; 2048]
    var u_out: [f64; 2048] = [0.0; 2048]
    var b_out: [f64; 32] = [0.0; 32]

    var i = 0
    while i < 2048 {
        let g = grad_w[i as usize]
        w_out[i as usize] = weights[i as usize] - lr * g
        let u = uncertainties[i as usize]
        var u_new = u * (1.0 - 0.01 * abs_d1(g))
        if u_new < 0.001 { u_new = 0.001 }
        u_out[i as usize] = u_new
        i = i + 1
    }

    var j = 0
    while j < 32 {
        b_out[j as usize] = biases[j as usize] - lr * grad_b[j as usize]
        j = j + 1
    }

    UpdateResult { weights: w_out, biases: b_out, uncertainties: u_out }
}

// ─── Loss computation (MSE) ───

fn mse_loss(output: &[f64; 32], target: &[f64; 32]) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var j = 0
    while j < 32 {
        let d = output[j as usize] - target[j as usize]
        sum = sum + d * d
        j = j + 1
    }
    sum / 32.0
}

// ─── Main: initialize, train, verify ───

fn main() -> i32 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    // === T1: Initialize 64×32 weight matrix with Xavier init ===
    var weights: [f64; 2048] = [0.0; 2048]
    var uncertainties: [f64; 2048] = [0.0; 2048]
    var biases: [f64; 32] = [0.0; 32]

    // Xavier: σ = sqrt(2 / (fan_in + fan_out)) = sqrt(2/96) ≈ 0.144
    var wi = 0
    while wi < 2048 {
        weights[wi as usize] = rng_normal_approx() * 0.144
        uncertainties[wi as usize] = 0.1  // initial uncertainty σ_w = 0.1
        wi = wi + 1
    }

    // Verify weights are initialized (not all zero)
    var nonzero = 0
    wi = 0
    while wi < 2048 {
        if abs_d1(weights[wi as usize]) > 0.001 { nonzero = nonzero + 1 }
        wi = wi + 1
    }
    if nonzero > 1900 { print("T1 PASS: Xavier init ("); print_int(nonzero); println(" nonzero weights)"); passed = passed + 1 }
    else { println("T1 FAIL: too many zero weights"); failed = failed + 1 }

    // === T2: Forward pass produces non-trivial output ===
    var input: [f64; 64] = [0.0; 64]

    // Set input to simple pattern
    var ii = 0
    while ii < 64 {
        input[ii as usize] = (ii as f64) / 64.0
        ii = ii + 1
    }

    var fwd = forward(&input, &weights, &biases, &uncertainties)

    // All outputs should be in (0, 1) due to sigmoid
    var all_valid = 1
    var j = 0
    while j < 32 {
        let v = fwd.output[j as usize]
        if v <= 0.0 || v >= 1.0 { all_valid = 0 }
        j = j + 1
    }
    if all_valid == 1 { println("T2 PASS: forward pass outputs in (0,1)"); passed = passed + 1 }
    else { println("T2 FAIL: output out of range"); failed = failed + 1 }

    // === T3: Uncertainty propagation produces non-zero values ===
    var unc_nonzero = 0
    j = 0
    while j < 32 {
        if fwd.output_unc[j as usize] > 0.0 { unc_nonzero = unc_nonzero + 1 }
        j = j + 1
    }
    if unc_nonzero == 32 { println("T3 PASS: GUM uncertainty propagated to all outputs"); passed = passed + 1 }
    else { print("T3 FAIL: only "); print_int(unc_nonzero); println("/32 outputs have uncertainty"); failed = failed + 1 }

    // === T4: Training reduces loss ===
    var target: [f64; 32] = [0.0; 32]
    j = 0
    while j < 32 {
        // Target: alternating 0.2 / 0.8
        if j % 2 == 0 { target[j as usize] = 0.2 }
        else { target[j as usize] = 0.8 }
        j = j + 1
    }

    let loss_before = mse_loss(&fwd.output, &target)

    // Train for 50 steps
    var step = 0
    while step < 50 {
        fwd = forward(&input, &weights, &biases, &uncertainties)
        let grads = backward(&input, &fwd.output, &target, &weights)
        let upd = update_weights(&weights, &biases, &uncertainties, &grads.grad_w, &grads.grad_b, 0.5)
        weights = upd.weights
        biases = upd.biases
        uncertainties = upd.uncertainties
        step = step + 1
    }

    fwd = forward(&input, &weights, &biases, &uncertainties)
    let loss_after = mse_loss(&fwd.output, &target)

    if loss_after < loss_before {
        print("T4 PASS: loss decreased (")
        print(loss_before)
        print(" -> ")
        print(loss_after)
        println(")")
        passed = passed + 1
    } else { println("T4 FAIL: loss did not decrease"); failed = failed + 1 }

    // === T5: Uncertainty decreased during training ===
    var unc_decreased = 0
    wi = 0
    while wi < 2048 {
        if uncertainties[wi as usize] < 0.1 { unc_decreased = unc_decreased + 1 }
        wi = wi + 1
    }
    if unc_decreased > 1500 {
        print("T5 PASS: uncertainty decreased for ")
        print_int(unc_decreased)
        println("/2048 weights")
        passed = passed + 1
    } else { println("T5 FAIL: uncertainty not decreasing"); failed = failed + 1 }

    // === T6: Array sizes are real (not toy) ===
    // 2048 weights + 2048 uncertainties + 64 input + 32×3 output/unc/target +
    // 2048 grad_w + 32 grad_b + 32 delta + 32 biases = 6,400 f64 values
    // = 51,200 bytes on stack/BSS. Door 1 makes this possible.
    let total_params = 2048 + 32  // weights + biases
    let total_epistemic = 2048    // uncertainty per weight
    if total_params == 2080 && total_epistemic == 2048 {
        print("T6 PASS: real layer size — ")
        print_int(total_params)
        print(" params, ")
        print_int(total_epistemic)
        println(" epistemic values")
        passed = passed + 1
    } else { println("T6 FAIL"); failed = failed + 1 }

    // === Summary ===
    println("")
    print("Passed: ")
    print_int(passed)
    println("")
    print("Failed: ")
    print_int(failed)
    println("")
    if failed == 0 { println("ALL PASS") }
    else { println("SOME TESTS FAILED") }

    failed
}
