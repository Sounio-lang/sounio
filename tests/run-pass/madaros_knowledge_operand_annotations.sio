//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: ANN 0.500000 0.062500
//
// Two Knowledge operands only need the same payload. A left operand with an
// unspecified epsilon and a right operand annotated eps=1000/1000 (the type of
// `Knowledge(v, e=1.0, ...)`) was E004 "these types cannot be combined".

fn main() -> i64 with IO, Epistemic, Panic {
    let w: Knowledge<f64> = measure(1.0, uncertainty: 0.5)
    let r = w / Knowledge(2.0, ε=1.0, prov="reference")
    print("ANN "); print_f64(r.value); print(" "); print_f64(r.variance); print("\n")
    0
}
