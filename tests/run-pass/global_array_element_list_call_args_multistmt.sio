//@ requires:madaros
// Wave15a: pure paramful MULTI-STMT call in global element-list init folds.
// Wave13e residual was fail-closed BSS zero (`[f(9), 2]` → `0 0`) because a
// `[*mut StmtList; N]` body-pointer registry poisoned same-module KIND 1/2.
// Wave15a stores body pointer bits as i64 in GLOBAL_VAR_INIT multi-word
// (seed-safe; same pattern as check/specializer SPEC_*_PTRS).
//
// Covered:
//   `{ let x = a + 1; x }`                — 1-param multi-stmt (mission shape)
//   `{ let x = a + 1; let y = x + 5; y }` — dependent lets (param/local + lit)
//   KIND 1 add2 coexists with KIND 3 (no poison)
//
// Explicit non-claims (still residual / fail-closed):
//   effectful multi-stmt, arbitrary recursion, >4 params, non-const args
//   Ident+Ident binary pure fold (`a + b` / `x + b`) — pre-existing Wave12
//   residual (both sides evaluate as the RHS Ident under pure_fn local lookup;
//   stock tip also fails zero-arg `let a=9; let b=5; a+b` → 10 not 14)

fn add2(a: i64, b: i64) -> i64 {
    a + b
}

fn f(a: i64) -> i64 {
    let x = a + 1
    x
}

fn g(a: i64) -> i64 {
    let x = a + 1
    let y = x + 5
    y
}

var A: [i64; 3] = [add2(10, 20), 1, 2]
var C: [i64; 2] = [f(9), 2]
var D: [i64; 3] = [g(9), 1, 2]

fn main() -> i64 with IO {
    print_int(A[0])
    print(" ")
    print_int(A[1])
    print(" ")
    print_int(A[2])
    print("\n")
    print_int(C[0])
    print(" ")
    print_int(C[1])
    print("\n")
    print_int(D[0])
    print(" ")
    print_int(D[1])
    print(" ")
    print_int(D[2])
    print("\n")
    if A[0] != 30 { return 1 }
    if A[1] != 1 { return 2 }
    if A[2] != 2 { return 3 }
    if C[0] != 10 { return 4 }
    if C[1] != 2 { return 5 }
    if D[0] != 15 { return 6 }
    if D[1] != 1 { return 7 }
    if D[2] != 2 { return 8 }
    0
}
