//@ run-pass
//@ expect-stdout: STATS_LINEAR_CLUSTER_STATUS_PASS
use stats::regression::robust_covariance::{LinearClusterResult,multiple_linear_cluster}
use math::pure::{is_finite}
fn mag(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn same(a:f64,b:f64) with Mut,Div,Panic {
 assert(is_finite(a) && is_finite(b))
 if b==0.0 {assert(a==0.0)} else {assert(a!=0.0) assert(mag((a-b)/b)<=2.0e-7)}
}
fn unavailable(r:&LinearClusterResult,fit:i64,status:i64,groups:i64,method:i64) with Mut,Div,Panic {
 assert(r.fit.status==fit && r.covariance_status==status)
 assert(r.clusters==groups && r.method==method && !r.assumptions_assessed)
 assert(r.correction_factor==0.0)
 var i:i64=0
 while i<64 {assert(r.covariance[i as usize]==0.0) i=i+1}
 i=0
 while i<8 {assert(r.standard_errors[i as usize]==0.0) i=i+1}
}
fn precedence() with Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var ids:[i64;256]=[0;256]
 let nan=0.0/0.0
 a[0]=nan
 let size=multiple_linear_cluster(&a,&b,&ids,0,1,nan,7)
 unavailable(&size,1,1,0,7)
 let rcond=multiple_linear_cluster(&a,&b,&ids,2,1,-1.0,7)
 unavailable(&rcond,5,1,0,7)
 let finite=multiple_linear_cluster(&a,&b,&ids,2,1,0.0,7)
 unavailable(&finite,2,1,0,7)
 a[0]=1.0 a[8]=1.0 a[16]=1.0 a[24]=1.0
 a[1]=1.0 a[9]=1.0 a[17]=1.0 a[25]=1.0
 let rank=multiple_linear_cluster(&a,&b,&ids,4,2,0.0,7)
 unavailable(&rank,3,1,0,7)
 let method=multiple_linear_cluster(&a,&b,&ids,4,1,0.0,7)
 unavailable(&method,0,5,0,7)
 let df=multiple_linear_cluster(&a,&b,&ids,1,1,0.0,0)
 unavailable(&df,0,2,0,0)
 let group=multiple_linear_cluster(&a,&b,&ids,4,1,0.0,0)
 unavailable(&group,0,3,1,0)
 ids[0]= -7 ids[1]= -7 ids[2]=9223372036854775807 ids[3]=9223372036854775807
 ids[255]=(0-9223372036854775807-1)
 a[2047]=nan b[255]=nan
 let zero=multiple_linear_cluster(&a,&b,&ids,4,1,0.0,1)
 assert(zero.fit.status==0 && zero.covariance_status==0 && zero.clusters==2)
 assert(zero.method==1 && !zero.assumptions_assessed)
 same(zero.correction_factor,2.0)
 var i:i64=0
 while i<64 {assert(zero.covariance[i as usize]==0.0) i=i+1}
 i=0
 while i<8 {assert(zero.standard_errors[i as usize]==0.0) i=i+1}
}
fn singleton_and_relabel() with Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var ids:[i64;256]=[0;256]
 var i:i64=0
 while i<4 {a[(i*8) as usize]=1.0 ids[i as usize]=i i=i+1}
 b[0]=1.0 b[1]=2.0 b[2]=3.0 b[3]=6.0
 let cr0=multiple_linear_cluster(&a,&b,&ids,4,1,0.0,0)
 let cr1s=multiple_linear_cluster(&a,&b,&ids,4,1,0.0,1)
 assert(cr0.fit.status==0 && cr0.covariance_status==0 && cr0.clusters==4)
 assert(cr1s.fit.status==0 && cr1s.covariance_status==0 && cr1s.clusters==4)
 same(cr0.correction_factor,1.0)
 same(cr1s.correction_factor,1.3333333333333333)
 // Independent C++23 exact singleton-intercept anchors: HC0 and HC1.
 same(cr0.fit.coefficients[0],3.0)
 same(cr0.covariance[0],0.875)
 same(cr1s.covariance[0],1.1666666666666667)
 ids[0]=(0-9223372036854775807-1)
 ids[1]= -900
 ids[2]=9223372036854775807
 ids[3]=17
 let relabeled=multiple_linear_cluster(&a,&b,&ids,4,1,0.0,1)
 assert(relabeled.covariance_status==0 && relabeled.clusters==4)
 same(relabeled.covariance[0],cr1s.covariance[0])
 same(relabeled.standard_errors[0],cr1s.standard_errors[0])
}
fn main()->i32 with IO,Mut,Div,Panic {
 precedence()
 singleton_and_relabel()
 println("STATS_LINEAR_CLUSTER_STATUS_PASS")
 0
}
