//@ run-pass
//@ requires: madaros
//@ expect-stdout: F64_BLOCK_METADATA_AUDIT_OK

struct FloatBox { sample: f64 }
fn value() -> f64 { 2.0 }

fn array_case(flag: bool) -> bool with Mut, Div, Panic {
    let result = if flag { let a: [f64; 2] = [2.0; 2] a[0] } else { 2.0 }
    result / 16.0 == 0.125
}
fn tuple_case(flag: bool) -> bool with Mut, Div {
    let result = if flag { let t: (i64, f64) = (7, 2.0) t.1 } else { 2.0 }
    result / 16.0 == 0.125
}
fn reference_case(flag: bool) -> bool with Mut, Div {
    let x: f64 = 2.0
    let result = if flag { let p: &f64 = &x; *p } else { 2.0 }
    result / 16.0 == 0.125
}
fn struct_case(flag: bool) -> bool with Mut, Div {
    let result = if flag { let b = FloatBox { sample: 2.0 } b.sample } else { 2.0 }
    result / 16.0 == 0.125
}
fn tuple_both(flag: bool) -> bool with Mut, Div {
    let result = if flag { let t: (i64, f64) = (7, 2.0) t.1 } else { let t: (i64, f64) = (9, 2.0) t.1 }
    result / 16.0 == 0.125
}
fn array_both(flag: bool) -> bool with Mut, Div, Panic {
    let result = if flag { let a: [f64; 2] = [2.0; 2] a[0] } else { let a: [f64; 2] = [2.0; 2] a[1] }
    result / 16.0 == 0.125
}
fn reference_both(flag: bool) -> bool with Mut, Div {
    let x: f64 = 2.0
    let result = if flag { let p: &f64 = &x; *p } else { let q: &f64 = &x; *q }
    result / 16.0 == 0.125
}
fn cast_control(flag: bool) -> bool with Mut, Div {
    let result = if flag { let x: i64 = 2 x as f64 } else { value() }
    result / 16.0 == 0.125
}
fn tuple_alias_case(flag: bool) -> bool with Mut, Div {
    let t: (i64, f64) = (7, 2.0)
    let result = if flag {
        let u = t
        u.1
    } else {
        let u = t
        u.1
    }
    result / 16.0 == 0.125
}
fn tuple_shadow_case(flag: bool) -> bool with Mut, Div {
    let t: (i64, f64) = (7, 2.0)
    let result = if flag { let t = t; t.1 } else { let t = t; t.1 }
    result / 16.0 == 0.125 && t.0 / 2 == 3 && t.1 / 16.0 == 0.125
}
fn reference_alias_case(flag: bool) -> bool with Mut, Div {
    let x: f64 = 2.0
    let result = if flag {
        let p: &f64 = &x
        let q = p
        *q
    } else {
        let p: &f64 = &x
        let q = p
        *q
    }
    result / 16.0 == 0.125
}
fn reference_shadow_case(flag: bool) -> bool with Mut, Div {
    let x: f64 = 2.0
    let p: &f64 = &x
    let result = if flag { let p = p; *p } else { let p = p; *p }
    result / 16.0 == 0.125 && *p / 16.0 == 0.125
}
fn reference_inferred_case(flag: bool) -> bool with Mut, Div {
    let x: f64 = 2.0
    let result = if flag { let p = &x; *p } else { let q = &x; *q }
    result / 16.0 == 0.125
}
fn reference_mut_case(flag: bool) -> bool with Mut, Div {
    var x: f64 = 2.0
    var y: f64 = 2.0
    let result = if flag { let p: &!f64 = &!x; *p } else { let q: &!f64 = &!y; *q }
    result / 16.0 == 0.125
}
fn integer_controls(flag: bool) -> bool with Mut, Div {
    let t: (i64, f64) = (7, 2.0)
    let integer_tuple = if flag { let t: (i64, i64) = (7, 9); t.0 } else { let t: (i64, i64) = (7, 9); t.0 }
    if integer_tuple / 2 != 3 || t.1 / 16.0 != 0.125 { return false }
    let x: i64 = 7
    let y: f64 = 2.0
    let p: &f64 = &y
    let integer_ref = if flag { let p: &i64 = &x; *p } else { let p: &i64 = &x; *p }
    if integer_ref / 2 != 3 || *p / 16.0 != 0.125 { return false }
    true
}
fn match_nested_case(flag: bool) -> bool with Mut, Div {
    let x: f64 = 2.0
    let t: (i64, f64) = (7, 2.0)
    let result = match flag {
        true => { let u = t; u.1 },
        false => { let p: &f64 = &x; let q = p; *q },
    }
    result / 16.0 == 0.125
}
fn main() -> i32 with IO, Mut, Div, Panic {
    var failed = 0
    var mode: i64 = 0
    while mode < 2 {
        let flag = mode == 1
        if array_case(flag) { println("array PASS") } else { println("array FAIL") failed = failed + 1 }
        if tuple_case(flag) { println("tuple PASS") } else { println("tuple FAIL") failed = failed + 1 }
        if reference_case(flag) { println("reference PASS") } else { println("reference FAIL") failed = failed + 1 }
        if struct_case(flag) { println("struct PASS") } else { println("struct FAIL") failed = failed + 1 }
        if array_both(flag) { println("array_both PASS") } else { println("array_both FAIL") failed = failed + 1 }
        if tuple_both(flag) { println("tuple_both PASS") } else { println("tuple_both FAIL") failed = failed + 1 }
        if reference_both(flag) { println("reference_both PASS") } else { println("reference_both FAIL") failed = failed + 1 }
        if cast_control(flag) { println("cast PASS") } else { println("cast FAIL") failed = failed + 1 }
        if tuple_alias_case(flag) { println("tuple_alias PASS") } else { println("tuple_alias FAIL") failed = failed + 1 }
        if tuple_shadow_case(flag) { println("tuple_shadow PASS") } else { println("tuple_shadow FAIL") failed = failed + 1 }
        if reference_alias_case(flag) { println("reference_alias PASS") } else { println("reference_alias FAIL") failed = failed + 1 }
        if reference_shadow_case(flag) { println("reference_shadow PASS") } else { println("reference_shadow FAIL") failed = failed + 1 }
        if reference_inferred_case(flag) { println("reference_inferred PASS") } else { println("reference_inferred FAIL") failed = failed + 1 }
        if reference_mut_case(flag) { println("reference_mut PASS") } else { println("reference_mut FAIL") failed = failed + 1 }
        if integer_controls(flag) { println("integer_controls PASS") } else { println("integer_controls FAIL") failed = failed + 1 }
        if match_nested_case(flag) { println("match_nested PASS") } else { println("match_nested FAIL") failed = failed + 1 }
        mode = mode + 1
    }
    if failed != 0 { return 1 }
    println("F64_BLOCK_METADATA_AUDIT_OK")
    0
}
