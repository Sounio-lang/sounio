//@ run-pass
//@ description: Lorenz i128 fourth-step enclosure contract from third validated enclosure

fn main() -> i64 {
    // The i128 center transition step3 -> step4 is already covered by
    // lorenz_i128_ball_four_step.sio. This contract carries the validated
    // third-step radius forward and adds a fourth interval LTE budget.
    let cx4: i64 = 1145612
    let cy4: i64 = 2052652
    let cz4: i64 = 952975

    // Third validated enclosure from lorenz_i128_validated_third_step.sio.
    let xr3: i64 = 104505
    let yr3: i64 = 136138
    let zr3: i64 = 15621

    // Radius propagation through one Euler vector-field evaluation at step 3.
    let dxr3: i64 = 10 * (yr3 + xr3)
    let x_rhoz_r3: i64 = ((1075156 * zr3) + (27040576 * xr3) + (xr3 * zr3)) / 1000000 + 1
    let dyr3: i64 = x_rhoz_r3 + yr3
    let xyr3: i64 = ((1075156 * yr3) + (1779721 * xr3) + (xr3 * yr3)) / 1000000 + 1
    let beta_zr3: i64 = ((8 * zr3) + 2) / 3
    let dzr3: i64 = xyr3 + beta_zr3

    let euler_xr4: i64 = xr3 + (10000 * dxr3) / 1000000 + 1
    let euler_yr4: i64 = yr3 + (10000 * dyr3) / 1000000 + 1
    let euler_zr4: i64 = zr3 + (10000 * dzr3) / 1000000 + 1

    // Tube covering the third validated enclosure and the fourth Euler ball:
    //   x in [970651, 1274182]
    //   y in [1643583, 2218595]
    //   z in [933471, 975045]
    let scale64: i64 = 1000000
    let h2: i64 = 100000000
    let lte_den: i64 = 2000000000000
    let x_abs: i64 = 1274182
    let y_abs: i64 = 2218595
    let z_abs: i64 = 975045
    let rhoz_abs: i64 = 27066529

    let f_x_abs: i64 = 10 * (y_abs + x_abs)
    let f_y_abs: i64 = (x_abs * rhoz_abs + scale64 - 1) / scale64 + y_abs
    let f_z_abs: i64 = (x_abs * y_abs + scale64 - 1) / scale64 + ((8 * z_abs) + 2) / 3

    let ddx_abs: i64 = 10 * (f_y_abs + f_x_abs)
    let ddy_abs: i64 = (f_x_abs * rhoz_abs + scale64 - 1) / scale64 +
                       (x_abs * f_z_abs + scale64 - 1) / scale64 +
                       f_y_abs
    let ddz_abs: i64 = (f_x_abs * y_abs + scale64 - 1) / scale64 +
                       (x_abs * f_y_abs + scale64 - 1) / scale64 +
                       ((8 * f_z_abs) + 2) / 3

    let lte_x: i64 = (h2 * ddx_abs + lte_den - 1) / lte_den
    let lte_y: i64 = (h2 * ddy_abs + lte_den - 1) / lte_den
    let lte_z: i64 = (h2 * ddz_abs + lte_den - 1) / lte_den

    let final_xr4: i64 = euler_xr4 + lte_x
    let final_yr4: i64 = euler_yr4 + lte_y
    let final_zr4: i64 = euler_zr4 + lte_z

    let x_lo: i64 = cx4 - final_xr4
    let x_hi: i64 = cx4 + final_xr4
    let y_lo: i64 = cy4 - final_yr4
    let y_hi: i64 = cy4 + final_yr4
    let z_lo: i64 = cz4 - final_zr4
    let z_hi: i64 = cz4 + final_zr4

    if dxr3 != 2406430 { return 1 }
    if x_rhoz_r3 != 2844303 { return 2 }
    if dyr3 != 2980441 { return 3 }
    if xyr3 != 346587 { return 4 }
    if beta_zr3 != 41656 { return 5 }
    if dzr3 != 388243 { return 6 }
    if euler_xr4 != 128570 { return 7 }
    if euler_yr4 != 165943 { return 8 }
    if euler_zr4 != 19504 { return 9 }

    if f_x_abs != 34927770 { return 10 }
    if f_y_abs != 36706280 { return 11 }
    if f_z_abs != 5427014 { return 12 }
    if ddx_abs != 716340500 { return 13 }
    if ddy_abs != 988994784 { return 14 }
    if ddz_abs != 138733096 { return 15 }
    if lte_x != 35818 { return 16 }
    if lte_y != 49450 { return 17 }
    if lte_z != 6937 { return 18 }

    if final_xr4 != 164388 { return 19 }
    if final_yr4 != 215393 { return 20 }
    if final_zr4 != 26441 { return 21 }
    if x_lo != 981224 { return 22 }
    if x_hi != 1310000 { return 23 }
    if y_lo != 1837259 { return 24 }
    if y_hi != 2268045 { return 25 }
    if z_lo != 926534 { return 26 }
    if z_hi != 979416 { return 27 }

    return 0
}
