//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 flowpipe obligation composition

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1493
    fp = mix(fp, 2, 5351)
    fp = mix(fp, 85766158, 5351)
    fp = mix(fp, 81234415, 5351)
    fp = mix(fp, 311696236, 5351)
    fp = mix(fp, 301485983, 5351)
    fp = mix(fp, 482555681, 5351)
    fp = mix(fp, 591288676, 5351)
    fp = mix(fp, 444092349, 5351)
    fp = mix(fp, 625429438, 5351)
    fp = mix(fp, 633359277, 5351)
    fp = mix(fp, 421619310, 5351)
    fp = mix(fp, 7, 5351)
    fp = mix(fp, 7, 5351)
    fp = mix(fp, 127, 5351)
    fp = mix(fp, 127, 5351)
    fp = mix(fp, 15, 5351)
    fp = mix(fp, 15, 5351)
    fp = mix(fp, 0, 5351)
    fp = mix(fp, 0, 5351)
    fp = mix(fp, 20, 5351)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 280255647 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1499
    fp = mix(fp, instance, 5381)
    fp = mix(fp, 7, 5381)
    fp = mix(fp, 7, 5381)
    fp = mix(fp, 127, 5381)
    fp = mix(fp, 127, 5381)
    fp = mix(fp, 15, 5381)
    fp = mix(fp, 15, 5381)
    fp = mix(fp, 0, 5381)
    fp = mix(fp, 0, 5381)
    fp = mix(fp, 20, 5381)
    fp = mix(fp, ok_mask, 5381)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 280255647 { return 0 - 1 }
    if certificate != 378373582 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1511
    fp = mix(fp, instance, 5387)
    fp = mix(fp, certificate, 5387)
    fp = mix(fp, 15, 5387)
    fp = mix(fp, 2, 5387)
    fp = mix(fp, 15, 5387)
    fp = mix(fp, 15, 5387)
    fp = mix(fp, 0, 5387)
    fp = mix(fp, 0, 5387)
    fp = mix(fp, 20, 5387)
    fp = mix(fp, ok_mask, 5387)
    return fp
}

fn obligation_mask() -> i64 {
    let endpoint_mask: i64 = 7
    let slab_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_mask: i64 = 127
    var composition_mask: i64 = 0
    if endpoint_mask == 7 { composition_mask = composition_mask + 1 }
    if slab_mask == 7 { composition_mask = composition_mask + 2 }
    if response_mask == 127 { composition_mask = composition_mask + 4 }
    if remainder_mask == 127 { composition_mask = composition_mask + 8 }

    let local_proof_mask: i64 = 0
    let global_claim_mask: i64 = 0
    let status: i64 = 20

    var ok_mask: i64 = 0
    if 85766158 > 0 {
        if 311696236 > 0 { ok_mask = ok_mask + 1 }
    }
    if 482555681 > 0 {
        if 444092349 > 0 { ok_mask = ok_mask + 2 }
    }
    if 633359277 > 0 { ok_mask = ok_mask + 4 }
    if composition_mask == 15 { ok_mask = ok_mask + 8 }
    if local_proof_mask == 0 {
        if global_claim_mask == 0 {
            if status == 20 { ok_mask = ok_mask + 16 }
        }
    }
    if 2 == 2 {
        if 100 == 100 { ok_mask = ok_mask + 32 }
    }
    if composition_mask == 15 {
        if response_mask == 127 { ok_mask = ok_mask + 64 }
    }
    if 633359277 > 0 {
        if global_claim_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = obligation_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 280255647 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 378373582 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 532518987 { return 4 }
    return 0
}
