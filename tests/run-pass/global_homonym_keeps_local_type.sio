//@ run-pass
//@ requires: madaros
//@ known-failure: measured 2026-11-26 on #3743 (a02d7ce756 + the scoped fixes) and on main 1fd49ba8b9: the CHECK part is fixed (no false E002/E001/E009), but two modules' same-named globals share one storage slot in lowering. The leaf's private i64 SCALE reads the root's f64 bits and the ADR-031 overflow trap fires (exit 1), so the third number never prints.
//@ xfail-expect: HOMONYM_OK 2.500000 5.000000
//@ xfail-expect: integer overflow (i64 *)
//@ xfail-exit: 1
//@ expect-stdout-contains: HOMONYM_OK 2.500000 5.000000 21
//
// Review of #3743, item 2: a module global with the same name as a private
// global of another loaded module keeps its own declared type. The leaf's
// `let SCALE: i64` overwrote this module's `var SCALE: f64` binding, so the
// assignment, the binding and the argument below were false E002/E001/E009.
use fixtures::scale_i64_leaf::{leaf_scaled}

var SCALE: f64 = 2.0

fn bump(v: f64) -> f64 { v * 2.0 }

fn main() -> i64 with IO, Mut {
    SCALE = 2.5
    let y: f64 = SCALE
    let z = bump(SCALE)
    print("HOMONYM_OK "); print_f64(y); print(" "); print_f64(z); print(" "); print_int(leaf_scaled(7)); print("\n")
    0
}
