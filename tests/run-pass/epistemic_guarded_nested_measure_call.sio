//@ run-pass
// Regression fixture for epistemic call-site confidence propagation:
// a low-confidence measure() used as a nested call argument must keep the
// user-call token guarded in the compiler's epistemic gate census.

fn consume(x: Knowledge<f64>) -> f64 with Epistemic {
    x.value + 1.0
}

fn main() -> i64 with IO, Epistemic {
    let y = consume(measure(10.0, uncertainty: 5.0))
    if y > 0.0 {
        print("OK\n")
    }
    0
}
