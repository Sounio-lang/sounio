//@ run-pass
//@ expect-stdout: VIZ_INFORMATION_CHANNELS_PASS
//@ expect-stdout: Memoryless binary symmetric channel
//@ expect-stdout: capacity (bits/use)
use math::channels::{bsc_capacity_bits}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_axis,viz_line_set_viewport,
 viz_add_label,viz_node_set_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var xs:[f64;1024]=[0.0;1024]
 var ys:[f64;1024]=[0.0;1024]
 var i:i64=0
 while i<129 {
  let p=(i as f64)/128.0
  let r=bsc_capacity_bits(p)
  assert(r.status==0 && !r.infinite && r.value>=0.0 && r.value<=1.0)
  xs[i as usize]=p
  ys[i as usize]=r.value
  i=i+1
 }
 assert(ys[0]==1.0 && ys[64]==0.0 && ys[128]==1.0)
 i=0
 while i<129 {
  let difference=ys[i as usize]-ys[(128-i) as usize]
  assert(difference> -1e-13 && difference<1e-13)
  if i<64 {assert(ys[(i+1) as usize]<=ys[i as usize])}
  i=i+1
 }
 var scene=viz_scene_new()
 let curve=viz_add_line_chart(&!scene,&xs,&ys,129,viz_layout_rect(160,110,600,240),viz_style_rgb(70,180,235))
 assert(curve>=0 && viz_line_set_viewport(&!scene,curve,0.0,1.0,0.0,1.0))
 let xa=viz_add_axis(&!scene,0.0,1.0,4,false,viz_layout_rect(160,368,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,1.0,4,true,viz_layout_rect(140,110,1,240),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=77
 title[1]=101
 title[2]=109
 title[3]=111
 title[4]=114
 title[5]=121
 title[6]=108
 title[7]=101
