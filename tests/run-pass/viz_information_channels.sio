 note[55]=121
 viz_node_set_label(&!scene,xa,&xn,23)
 viz_node_set_label(&!scene,ya,&yn,19)
 assert(viz_add_label(&!scene,&title,35,viz_layout_rect(160,22,600,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,32,viz_layout_rect(160,52,600,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,curve,&legend,13,viz_layout_rect(160,420,600,22))>=0)
 assert(viz_add_label(&!scene,&foot,54,viz_layout_rect(160,462,650,14),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_label(&!scene,&note,56,viz_layout_rect(160,490,650,14),viz_style_rgb(190,200,215))>=0)
 assert(scene.node_count==8 && scene.series_count==1)
 let pixels=heap_alloc(960*520*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:960,height:520}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,350*960+138)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,960,520)
 println("VIZ_INFORMATION_CHANNELS_PASS")
 0
}
