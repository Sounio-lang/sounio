//@ run-pass
//@ requires: madaros
//@ expect-stdout: 2
//@ expect-stdout: 34
//@ expect-stdout: 4
//@ expect-stdout: 1
// SIO-147: a value taken straight from sqrt/exp/log kept a raw-bits type,
// so `x as i64` reinterpreted the IEEE bits instead of converting (the
// workaround was `sqrt(..) * 1.0` before casting, as still seen in
// stdlib/stats/bayesian/psis_loo.sio). Fixed incidentally after v0.80.0;
// this test locks the acceptance -- builtin results cast to integers
// WITHOUT the `* 1.0` workaround, including the psis `30 + (sqn as i64)`
// shape.
fn main() -> i64 with IO, Mut, Div, Panic {
    println(sqrt(4.0) as i64)
    let n: i64 = 16
    let sqn = sqrt(n as f64)
    println(30 + (sqn as i64))
    println(((n as f64) / 4.0 + 0.5) as i64)
    println(log(2.718281828459045) as i64)
    return 0
}
