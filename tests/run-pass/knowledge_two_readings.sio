//@ run-pass
//@ requires: madaros
//@ expect-stdout: val 12.180705
//@ expect-stdout: mone 14.285865
//@ expect-stdout: msq 14.122522
//@ expect-stdout: seat 0
//@ expect-stdout: TWO_READINGS_OK
// exp(L) and exp(L/2)*exp(L/2) are one value and two means.
// seat_moments builds k=1 bands on the scale of those means.
// Both means sit in the overlap, so the language returns no centre.

use epistemic::claim_meet::{held_centre, seat_code, seat_moments}

var R_GAS: f64 = 8.314462618
var T_HOT: f64 = 353.15
var DH: f64 = 30800.0
var DS: f64 = 108.0
var U_DH: f64 = 1500.0
var U_DS: f64 = 2.0

fn ln_p(dh: f64, ds: f64) -> f64 {
    ds / R_GAS - dh / (R_GAS * T_HOT)
}

fn p_one(dh: f64, ds: f64) -> f64 {
    exp(ln_p(dh, ds))
}

fn half(dh: f64, ds: f64) -> f64 {
    exp(ln_p(dh, ds) / 2.0)
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let dh0: f64 = DH
    let ds0: f64 = DS
    let hk: Knowledge<f64> = measure(dh0, uncertainty: U_DH)
    let sk: Knowledge<f64> = measure(ds0, uncertainty: U_DS)
    let dh = hk.value
    let ds = sk.value
    let h = half(dh, ds)
    let sq = h * h
    let one = p_one(dh, ds)
    let mone = second_order_mean(one)
    let msq = second_order_mean(sq)
    let vone = variance_of(one)
    let vsq = variance_of(sq)
    let seat = seat_moments(mone, vone, msq, vsq)
    let held = held_centre(seat, mone, msq)
    print("val ")
    print_f64(sq)
    println("")
    print("mone ")
    print_f64(mone)
    println("")
    print("msq ")
    print_f64(msq)
    println("")
    print("seat ")
    print_int(seat_code(seat))
    println("")
    if near(sq, 12.180705, 0.000001) && near(one, 12.180705, 0.000001) && near(mone, 14.285865, 0.000001) && near(msq, 14.122522, 0.000001) && seat_code(seat) == 0 && !held.held {
        println("TWO_READINGS_OK")
        return 0
    }
    println("TWO_READINGS_FAIL")
    1
}
