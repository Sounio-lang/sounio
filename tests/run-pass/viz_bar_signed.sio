//@ run-pass
//@ expect-stdout: BAR_SIGNED_PASS
//@ expect-stdout: <rect x="39.500000" y="79.500000" width="40" height="40"
//@ expect-stdout: <rect x="139.500000" y="39.500000" width="40" height="40"
use viz::ir::{viz_scene_new,viz_add_bar_chart,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var scene=viz_scene_new()
 var xs:[f64;1024]=[0.0;1024]
 var ys:[f64;1024]=[0.0;1024]
 xs[0]=1.0
 xs[1]=3.0
 ys[0]= -1.0
 ys[1]=1.0
 let bars=viz_add_bar_chart(&!scene,&xs,&ys,2,viz_layout_rect(60,40,100,80),viz_style_rgb(70,180,235))
 assert(bars==0 && scene.node_count==1 && scene.series_count==1)
 let pixels=heap_alloc(220*160*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:220,height:160}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,90*220+50)==70*65536+180*256+235)
 assert(read_i64(canvas.pixels,50*220+150)==70*65536+180*256+235)
 viz_html_emit_scene(&scene,220,160)
 println("BAR_SIGNED_PASS")
 0
}
