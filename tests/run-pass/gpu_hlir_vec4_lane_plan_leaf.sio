//@ run-pass
//@ description: Leaf module for imported GPU Knowledge Vec4 lane-plan runtime fixture.

pub fn gpu_hlir_vec4_lane_plan_make() -> [f64; 4] with Mut, Panic, Div {
    var lanes: [f64; 4] = [0.0, 0.0, 0.0, 0.0]
    lanes[0] = 1.0
    lanes[1] = 2.0
    lanes[2] = 3.0
    lanes[3] = 4.0
    return lanes
}

pub fn gpu_hlir_vec4_lane_plan_sum(lanes: [f64; 4]) -> f64 with Mut, Panic, Div {
    return lanes[0] + lanes[1] + lanes[2] + lanes[3]
}

pub fn gpu_hlir_vec4_lane_plan_offset(lane: i64) -> i64 {
    return lane * 32
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let lanes = gpu_hlir_vec4_lane_plan_make()
    let sum = gpu_hlir_vec4_lane_plan_sum(lanes)
    if sum > 9.999 && sum < 10.001 { return 0 }
    return 1
}
