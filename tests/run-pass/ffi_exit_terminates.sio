//@ run-pass
// extern "C" exit() must actually terminate the process — Track A Fase 3.4.
//
// Before fail-closed + the ffi_exit emitter (id 34, exit_group syscall), an
// unimplemented extern compiled to a silent no-op returning 0: this program
// would print the FAIL line and exit 1. With a real exit(0), the FAIL line
// is unreachable and the process ends rc=0 immediately after PASS.

extern "C" {
    fn exit(code: i32);
    fn getpid() -> i64;
}

fn main() -> i32 with IO, Panic {
    if getpid() > 0 {
        println("ffi_exit_terminates: PASS")
    }
    exit(0 as i32)
    println("ffi_exit_terminates: FAIL silent-noop exit")
    return 1
}
