//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 enclosure validator guard preserves non-claim masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1381
    fp = mix(fp, 4, 5171)
    fp = mix(fp, 563122161, 5171)
    fp = mix(fp, 308331037, 5171)
    fp = mix(fp, 389227567, 5171)
    fp = mix(fp, 749342117, 5171)
    fp = mix(fp, 700260810, 5171)
    fp = mix(fp, 1000000, 5171)
    fp = mix(fp, 104000, 5171)
    fp = mix(fp, 319000, 5171)
    fp = mix(fp, 12500, 5171)
    fp = mix(fp, 71000, 5171)
    fp = mix(fp, 273500, 5171)
    fp = mix(fp, 6500, 5171)
    fp = mix(fp, 32524, 5171)
    fp = mix(fp, 45203, 5171)
    fp = mix(fp, 5836, 5171)
    fp = mix(fp, 7, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 8, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 265395467 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1399
    fp = mix(fp, instance, 5179)
    fp = mix(fp, 103524, 5179)
    fp = mix(fp, 318703, 5179)
    fp = mix(fp, 12336, 5179)
    fp = mix(fp, 104000, 5179)
    fp = mix(fp, 319000, 5179)
    fp = mix(fp, 12500, 5179)
    fp = mix(fp, 7, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 8, 5179)
    fp = mix(fp, ok_mask, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 265395467 { return 0 - 1 }
    if certificate != 669027086 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1409
    fp = mix(fp, instance, 5189)
    fp = mix(fp, certificate, 5189)
    fp = mix(fp, 9, 5189)
    fp = mix(fp, 4, 5189)
    fp = mix(fp, 7, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 8, 5189)
    fp = mix(fp, ok_mask, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    return fp
}

fn enclosure_guard_mask() -> i64 {
    let x_need_ppm: i64 = 103524
    let y_need_ppm: i64 = 318703
    let z_need_ppm: i64 = 12336
    let x_margin_ppm: i64 = 104000
    let y_margin_ppm: i64 = 319000
    let z_margin_ppm: i64 = 12500
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0

    var pass_mask: i64 = 0
    if x_need_ppm <= x_margin_ppm { pass_mask = pass_mask + 1 }
    if y_need_ppm <= y_margin_ppm { pass_mask = pass_mask + 2 }
    if z_need_ppm <= z_margin_ppm { pass_mask = pass_mask + 4 }

    var ok_mask: i64 = 0
    if 563122161 > 0 {
        if 389227567 > 0 { ok_mask = ok_mask + 1 }
    }
    if x_need_ppm == 71000 + 32524 {
        if y_need_ppm == 273500 + 45203 {
            if z_need_ppm == 6500 + 5836 { ok_mask = ok_mask + 2 }
        }
    }
    if pass_mask == 7 { ok_mask = ok_mask + 4 }
    if validated_mask == 0 { ok_mask = ok_mask + 8 }
    if x_margin_ppm - x_need_ppm == 476 {
        if y_margin_ppm - y_need_ppm == 297 {
            if z_margin_ppm - z_need_ppm == 164 { ok_mask = ok_mask + 16 }
        }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if local_containment_mask == 0 { ok_mask = ok_mask + 64 }
    if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = enclosure_guard_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 265395467 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 669027086 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 133410511 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
