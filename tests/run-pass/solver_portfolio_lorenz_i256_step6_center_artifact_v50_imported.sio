//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v50 smoke for Lorenz i256 step-6 center artifact entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v50_lorenz_i256_step6_center_artifact_fingerprint(
        134624236, 643317565, 120531857, 678566245, 367410832, 6, 1, 127)
    if receipt_fp != 40206573 { return 1 }

    let audit_fp = solver_portfolio_v50_lorenz_i256_step6_center_artifact_audit_fingerprint(
        receipt_fp, 134624236, 643317565, 882801596, 961618971, 367410832, 6, 1, 127)
    if audit_fp != 6362158 { return 2 }

    let manifest_fp = solver_portfolio_v50_lorenz_i256_step6_center_artifact_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 215425432 { return 3 }

    let result_fp = solver_portfolio_v50_result_coverage_fingerprint(
        50, 54, 10, 42, 1, 1, manifest_fp)
    if result_fp != 205901482 { return 4 }

    let family_fp = solver_portfolio_v50_checker_family_coverage_fingerprint(
        50, 54, 6, 4, 3, 2, 37, 2, manifest_fp)
    if family_fp != 918908315 { return 5 }

    let acceptance_fp = solver_portfolio_v50_acceptance_receipt_fingerprint(
        50, manifest_fp, result_fp)
    if acceptance_fp != 956399250 { return 6 }

    let audit_receipt_fp = solver_portfolio_v50_audit_receipt_fingerprint(
        50, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 269533180 { return 7 }

    let readiness_fp = solver_portfolio_v50_readiness_fingerprint(
        50, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 228451054 { return 8 }
    return 0
}
