//@ check-only
//@ requires: madaros
//@ description: #830 — by-value match joins inside ExprHandle normalize f32 literal arms in either order

fn handle_literal_first(k: i64, x: f32) -> f32 {
    handle<IO> {
        match k {
            0 => 0.0,
            _ => x,
        }
    } with {
        0
    }
}

fn handle_literal_last(k: i64, x: f32) -> f32 {
    handle<IO> {
        match k {
            0 => x,
            1 => -1.5,
            _ => 0.0,
        }
    } with {
        0
    }
}

fn handle_literal_block(k: i64, x: f32) -> f32 {
    handle<IO> {
        match k {
            0 => { 1.0 }
            1 => x,
            _ => { 0.25 }
        }
    } with {
        0
    }
}

fn main() -> i64 {
    let x: f32 = 2.5
    let a: f32 = handle_literal_first(0, x)
    let b: f32 = handle_literal_last(1, x)
    let c: f32 = handle_literal_block(2, x)
    0
}
