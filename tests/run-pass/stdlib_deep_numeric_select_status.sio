//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_NUMERIC_SELECT_STATUS_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use stats::dynamic_order::numeric_select
use math::pure::is_finite
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var a=numeric_buffer_new(8,64)
 numeric_buffer_set(&!a,0,3.0);numeric_buffer_set(&!a,1,-1.0)
 numeric_buffer_set(&!a,2,2.0);numeric_buffer_set(&!a,3,2.0)
 numeric_buffer_set(&!a,4,0.0);numeric_buffer_set(&!a,5,5.0)
 numeric_buffer_set(&!a,6,0.0/0.0);numeric_buffer_set(&!a,7,99.0)
 let badk=numeric_select(&!a,6,6,100)
 assert(badk.status==1 && badk.partition_work==0 && !badk.fallback && numeric_buffer_at(&a,0)==3.0)
 let negative=numeric_select(&!a,6,2,-1)
 assert(negative.status==1 && numeric_buffer_at(&a,1)==-1.0)
 let badn=numeric_select(&!a,9223372036854775807,0,100)
 assert(badn.status==1)
 let zero=numeric_select(&!a,0,0,100)
 assert(zero.status==1)
 let nonfinite=numeric_select(&!a,7,2,100)
 assert(nonfinite.status==2 && nonfinite.partition_work==0 && !nonfinite.fallback)
 assert(numeric_buffer_at(&a,0)==3.0 && numeric_buffer_at(&a,1)==-1.0 && numeric_buffer_at(&a,5)==5.0)
 let rank=numeric_select(&!a,6,2,100)
 assert(rank.status==0 && rank.value==2.0 && !rank.fallback && rank.partition_work<=100)
 assert(!is_finite(numeric_buffer_at(&a,6)) && numeric_buffer_at(&a,7)==99.0)
 let fallback=numeric_select(&!a,6,3,0)
 assert(fallback.status==0 && fallback.value==2.0 && fallback.fallback && fallback.partition_work==0 && fallback.partitions==0)
 var i:i64=1
 while i<6 {assert(numeric_buffer_at(&a,i-1)<=numeric_buffer_at(&a,i));i=i+1}
 let one=numeric_select(&!a,1,0,0)
 assert(one.status==0 && one.value==-1.0 && !one.fallback && one.partition_work==0)
 var ties=numeric_buffer_new(64,512)
 i=0
 while i<64 {numeric_buffer_set(&!ties,i,7.0);i=i+1}
 let equal=numeric_select(&!ties,64,32,64)
 assert(equal.status==0 && equal.value==7.0 && equal.partitions==1 && equal.partition_work==64 && !equal.fallback)
 let short_budget=numeric_select(&!ties,64,32,1)
 assert(short_budget.status==0 && short_budget.fallback && short_budget.partition_work==0)
 numeric_buffer_close(a);numeric_buffer_close(ties)
 println("STDLIB_DEEP_NUMERIC_SELECT_STATUS_PASS")
 0
}
