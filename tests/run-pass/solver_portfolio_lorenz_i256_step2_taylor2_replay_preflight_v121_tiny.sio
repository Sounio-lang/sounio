//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v121 smoke for Lorenz i256 step-2 Taylor-2 replay preflight

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1949
    receipt_fp = mix(receipt_fp, 939672637, 5903)
    receipt_fp = mix(receipt_fp, 69896373, 5903)
    receipt_fp = mix(receipt_fp, 723878614, 5903)
    receipt_fp = mix(receipt_fp, 661341285, 5903)
    receipt_fp = mix(receipt_fp, 73960392, 5903)
    receipt_fp = mix(receipt_fp, 787471364, 5903)
    receipt_fp = mix(receipt_fp, 558083306, 5903)
    receipt_fp = mix(receipt_fp, 976546207, 5903)
    receipt_fp = mix(receipt_fp, 892326627, 5903)
    receipt_fp = mix(receipt_fp, 725374434, 5903)
    receipt_fp = mix(receipt_fp, 2, 5903)
    receipt_fp = mix(receipt_fp, 7, 5903)
    receipt_fp = mix(receipt_fp, 255, 5903)
    if receipt_fp != 258028341 { return 1 }

    var audit_fp: i64 = 1951
    audit_fp = mix(audit_fp, receipt_fp, 5923)
    audit_fp = mix(audit_fp, 939672637, 5923)
    audit_fp = mix(audit_fp, 69896373, 5923)
    audit_fp = mix(audit_fp, 723878614, 5923)
    audit_fp = mix(audit_fp, 661341285, 5923)
    audit_fp = mix(audit_fp, 976546207, 5923)
    audit_fp = mix(audit_fp, 892326627, 5923)
    audit_fp = mix(audit_fp, 558083306, 5923)
    audit_fp = mix(audit_fp, 2, 5923)
    audit_fp = mix(audit_fp, 7, 5923)
    audit_fp = mix(audit_fp, 255, 5923)
    if audit_fp != 346887814 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 124, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 124, 1103)
    if entry_fp != 444019730 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 121, 1151)
    manifest_fp = mix(manifest_fp, 125, 1151)
    manifest_fp = mix(manifest_fp, 787471364, 1151)
    manifest_fp = mix(manifest_fp, 73960392, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 802098435 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 121, 1871)
    result_fp = mix(result_fp, 125, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 113, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 166916399 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 121, 1907)
    family_fp = mix(family_fp, 125, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 108, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 251252184 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 121, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 281483835 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 121, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 356474349 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 121, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
