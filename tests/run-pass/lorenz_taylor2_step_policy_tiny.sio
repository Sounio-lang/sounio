//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz Taylor-2 step-policy receipt over the v44 remainder margin

fn ceil_div_nonneg(n: i64, d: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if d <= 0 { return 0 - 1 }
    return (n + d - 1) / d
}

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn taylor2_step_policy_fingerprint(remainder_fp: i64, audit_fp: i64) -> i64 with Div {
    if remainder_fp != 320985955 { return 0 - 1 }
    if audit_fp != 980184978 { return 0 - 1 }

    let total_slack = 6634 + 5360 + 7552
    let total_remainder = 102 + 135 + 20
    let total_after_slack = 6532 + 5225 + 7532
    if total_slack != 19546 { return 0 - 1 }
    if total_remainder != 257 { return 0 - 1 }
    if total_after_slack != 19289 { return 0 - 1 }

    let remainder_fill_ppm = ceil_div_nonneg(total_remainder * 1000000, total_slack)
    let after_slack_ppm = (total_after_slack * 1000000) / total_slack
    if remainder_fill_ppm != 13149 { return 0 - 1 }
    if after_slack_ppm != 986851 { return 0 - 1 }

    let min_after_slack = 5225
    let max_axis_remainder = 135
    var policy_mask: i64 = 0
    if remainder_fill_ppm <= 15000 { policy_mask = policy_mask + 1 }
    if min_after_slack >= 5000 { policy_mask = policy_mask + 2 }
    if total_after_slack >= 19000 { policy_mask = policy_mask + 4 }
    if 127 == 127 { policy_mask = policy_mask + 8 }
    if remainder_fp == 320985955 { policy_mask = policy_mask + 16 }
    if audit_fp == 980184978 { policy_mask = policy_mask + 32 }
    if policy_mask != 63 { return 0 - 1 }

    var fp: i64 = 557
    fp = quality_mix(fp, remainder_fp)
    fp = quality_mix(fp, audit_fp)
    fp = quality_mix(fp, 979362768)
    fp = quality_mix(fp, 127)
    fp = quality_mix(fp, total_slack)
    fp = quality_mix(fp, total_remainder)
    fp = quality_mix(fp, total_after_slack)
    fp = quality_mix(fp, min_after_slack)
    fp = quality_mix(fp, max_axis_remainder)
    fp = quality_mix(fp, remainder_fill_ppm)
    fp = quality_mix(fp, after_slack_ppm)
    fp = quality_mix(fp, 15000)
    fp = quality_mix(fp, 5000)
    fp = quality_mix(fp, 19000)
    fp = quality_mix(fp, policy_mask)
    fp = quality_mix(fp, 1)
    fp = quality_mix(fp, 0)
    fp = quality_mix(fp, 1)
    fp = quality_mix(fp, 1)
    return fp
}

fn taylor2_step_policy_audit_fingerprint(policy_fp: i64) -> i64 {
    if policy_fp != 403306384 { return 0 - 1 }

    var fp: i64 = 563
    fp = quality_mix(fp, policy_fp)
    fp = quality_mix(fp, 320985955)
    fp = quality_mix(fp, 980184978)
    fp = quality_mix(fp, 873855189)
    fp = quality_mix(fp, 311965616)
    fp = quality_mix(fp, 101774289)
    fp = quality_mix(fp, 13149)
    fp = quality_mix(fp, 63)
    return fp
}

fn main() -> i64 with Div {
    if ceil_div_nonneg(257000000, 19546) != 13149 { return 1 }
    if (19289 * 1000000) / 19546 != 986851 { return 2 }

    let policy_fp = taylor2_step_policy_fingerprint(320985955, 980184978)
    if policy_fp != 403306384 { return 3 }
    let audit_fp = taylor2_step_policy_audit_fingerprint(policy_fp)
    if audit_fp != 635367450 { return 4 }

    if taylor2_step_policy_fingerprint(320985956, 980184978) != (0 - 1) { return 5 }
    if taylor2_step_policy_fingerprint(320985955, 980184979) != (0 - 1) { return 6 }
    if taylor2_step_policy_audit_fingerprint(403306385) != (0 - 1) { return 7 }
    return 0
}
