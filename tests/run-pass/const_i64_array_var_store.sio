//@ run-pass
//@ requires: madaros
// A mutable binding lowers the literal through the per-element store path.
// xs[0] = 100 must keep working and sum to 123.
fn main() -> i64 {
    var xs: [i64; 4] = [3, 5, 7, 11]
    xs[0] = 100
    let sum = xs[0] + xs[1] + xs[2] + xs[3]
    if sum == 123 { 0 } else { 1 }
}
