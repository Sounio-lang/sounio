 foot[54]=115

 viz_node_set_label(&!scene,xa,&xn,16)
 viz_node_set_label(&!scene,yy,&yn,28)
 assert(viz_add_label(&!scene,&title,53,viz_layout_rect(150,20,600,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,48,viz_layout_rect(150,48,600,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,ca,&fa,11,viz_layout_rect(150,412,280,22))>=0)
 assert(viz_add_series_legend(&!scene,cb,&fb,11,viz_layout_rect(460,412,290,22))>=0)
 assert(viz_add_series_legend(&!scene,la,&ma,16,viz_layout_rect(150,442,280,22))>=0)
 assert(viz_add_series_legend(&!scene,lb,&mb,16,viz_layout_rect(460,442,290,22))>=0)
 assert(viz_add_label(&!scene,&foot,55,viz_layout_rect(150,478,600,14),viz_style_rgb(190,200,215))>=0)
 let F=axis_label(r.f_stat)
 let p=axis_label(r.p)
 var ft:[i8;64]=[0;64]
 var pt:[i8;64]=[0;64]
 ft[0]=70;ft[1]=61;pt[0]=112;pt[1]=61
 i=0
 while i<F.n {ft[(i+2) as usize]=F.text[i as usize];i=i+1}
 i=0
 while i<p.n {pt[(i+2) as usize]=p.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&ft,F.n+2,viz_layout_rect(150,80,280,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&pt,p.n+2,viz_layout_rect(460,80,280,20),viz_style_rgb(230,235,245))>=0)
 assert(scene.node_count==15 && scene.series_count==4 && scene.series[0].n==5 && scene.series[1].n==6)
 let pixels=heap_alloc(900*500*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:900,height:500}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,340*900+128)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,900,500)
 println("VIZ_BROWN_FORSYTHE_PASS")
