//@ run-pass
//@ expect-stdout: VIZ_BROWN_FORSYTHE_PASS
//@ expect-stdout: synthetic A=5 B=6
//@ expect-stdout: reference is approximate
//@ expect-stdout: not variance estimates or CIs
use stats::brown_forsythe::{brown_forsythe}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_axis,viz_line_set_viewport,
 viz_add_label,viz_node_set_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn abs(v:f64)->f64 {if v<0.0{return -v} return v}
fn main() with IO,Mut,Div,Alloc,Panic {
 var a:[f64;100]=[0.0;100]
 var b:[f64;100]=[0.0;100]
 a[0]=1.0;a[1]=2.0;a[2]=4.0;a[3]=8.0;a[4]=16.0
 b[0]=2.0;b[1]=3.0;b[2]=4.0;b[3]=5.0;b[4]=6.0;b[5]=8.0
 let r=brown_forsythe(&a,5,&b,6)
 assert(r.status==0 && r.df1==1 && r.df2==9)
 assert(r.f_stat>1.7191044677 && r.f_stat<1.7191044678)
 assert(r.p>0.2222721838 && r.p<0.2222721839)
 let centerA=a[2]
 let centerB=b[2]+0.5*(b[3]-b[2])
 var xs:[f64;1024]=[0.0;1024]
 var ya:[f64;1024]=[0.0;1024]
 var yb:[f64;1024]=[0.0;1024]
 var meanA:[f64;1024]=[0.0;1024]
 var meanB:[f64;1024]=[0.0;1024]
 var i:i64=0
 var sumA=0.0
 var sumB=0.0
 while i<6 {
  xs[i as usize]=(i+1) as f64
  if i<5 {ya[i as usize]=abs(a[i as usize]-centerA)/r.deviation_scale;sumA=sumA+ya[i as usize]}
  yb[i as usize]=abs(b[i as usize]-centerB)/r.deviation_scale
  sumB=sumB+yb[i as usize]
  meanA[i as usize]=r.mean_abs_a_scaled
  meanB[i as usize]=r.mean_abs_b_scaled
  i=i+1
 }
 assert(abs(sumA/5.0-r.mean_abs_a_scaled)<1.0e-14)
 assert(abs(sumB/6.0-r.mean_abs_b_scaled)<1.0e-14)
 var scene=viz_scene_new()
 let ca=viz_add_line_chart(&!scene,&xs,&ya,5,viz_layout_rect(150,120,600,220),viz_style_rgb(70,180,235))
 let cb=viz_add_line_chart(&!scene,&xs,&yb,6,viz_layout_rect(150,120,600,220),viz_style_rgb(245,170,65))
 let la=viz_add_line_chart(&!scene,&xs,&meanA,6,viz_layout_rect(150,120,600,220),viz_style_rgb(65,115,150))
 let lb=viz_add_line_chart(&!scene,&xs,&meanB,6,viz_layout_rect(150,120,600,220),viz_style_rgb(150,115,65))
 assert(viz_line_set_viewport(&!scene,ca,0.0,6.0,0.0,1.0))
 assert(viz_line_set_viewport(&!scene,cb,0.0,6.0,0.0,1.0))
 assert(viz_line_set_viewport(&!scene,la,0.0,6.0,0.0,1.0))
 assert(viz_line_set_viewport(&!scene,lb,0.0,6.0,0.0,1.0))
 let xa=viz_add_axis(&!scene,0.0,6.0,3,false,viz_layout_rect(150,358,600,1),viz_style_rgb(190,200,215))
 let yy=viz_add_axis(&!scene,0.0,1.0,4,true,viz_layout_rect(130,120,1,220),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
