//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v42 smoke for SMT Alethe-style micro reconstruction receipt

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v42_smt_alethe_micro_reconstruction_fingerprint(
        580810113, 72583387, 46718256, 265423024,
        15302992, 752808158, 1, 63)
    if receipt_fp != 550418014 { return 1 }

    let audit_fp = solver_portfolio_v42_smt_alethe_micro_reconstruction_audit_fingerprint(
        receipt_fp, 580810113, 72583387, 958828933, 801644191, 1, 63)
    if audit_fp != 181685497 { return 2 }

    let manifest_fp = solver_portfolio_v42_smt_alethe_micro_reconstruction_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 977002972 { return 3 }

    let result_fp = solver_portfolio_v42_result_coverage_fingerprint(
        42, 46, 10, 34, 1, 1, manifest_fp)
    if result_fp != 263327815 { return 4 }

    let family_fp = solver_portfolio_v42_checker_family_coverage_fingerprint(
        42, 46, 6, 4, 3, 2, 29, 2, manifest_fp)
    if family_fp != 4917294 { return 5 }

    let acceptance_fp = solver_portfolio_v42_acceptance_receipt_fingerprint(
        42, manifest_fp, result_fp)
    if acceptance_fp != 750750705 { return 6 }

    let audit_receipt_fp = solver_portfolio_v42_audit_receipt_fingerprint(
        42, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 486030685 { return 7 }

    let readiness_fp = solver_portfolio_v42_readiness_fingerprint(
        42, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 584513793 { return 8 }
    return 0
}
