//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_error_bars_raster_smooth, quality_error_bar_plot_config_default}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(72, 72)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    var lo: [f64; 256] = [0.0; 256]
    var hi: [f64; 256] = [0.0; 256]

    xs[0] = 0.0
    ys[0] = 0.50
    lo[0] = 0.12
    hi[0] = 0.18
    xs[1] = 1.0
    ys[1] = 0.52
    lo[1] = 0.22
    hi[1] = 0.28
    xs[2] = 2.0
    ys[2] = 0.48
    lo[2] = 0.10
    hi[2] = 0.20

    s = plot_error_bars_raster_smooth(s, &xs, &ys, &lo, &hi, 3, quality_error_bar_plot_config_default())

    let center_r = surface_get_pixel_r(&s, 36, 38)
    let center_g = surface_get_pixel_g(&s, 36, 38)
    if center_r < 150 || center_g > 120 {
        print("FAIL error-bar marker center missing\n")
        return 1
    }

    var stem_pixels = 0
    var y = 22
    while y <= 51 {
        let r = surface_get_pixel_r(&s, 36, y)
        let g = surface_get_pixel_g(&s, 36, y)
        let b = surface_get_pixel_b(&s, 36, y)
        if r < 50 && g < 60 && b < 80 {
            stem_pixels = stem_pixels + 1
        }
        y = y + 1
    }
    if stem_pixels < 12 {
        print("FAIL error-bar vertical stem too sparse\n")
        return 2
    }

    var cap_pixels = 0
    var x = 32
    while x <= 40 {
        let top_r = surface_get_pixel_r(&s, x, 20)
        let bot_r = surface_get_pixel_r(&s, x, 51)
        if top_r < 60 {
            cap_pixels = cap_pixels + 1
        }
        if bot_r < 60 {
            cap_pixels = cap_pixels + 1
        }
        x = x + 1
    }
    if cap_pixels < 8 {
        print("FAIL error-bar caps too sparse\n")
        return 3
    }

    var outside_pixels = 0
    y = 0
    while y < 10 {
        var x2 = 0
        while x2 < 72 {
            if surface_get_pixel_r(&s, x2, y) < 240 {
                outside_pixels = outside_pixels + 1
            }
            x2 = x2 + 1
        }
        y = y + 1
    }
    if outside_pixels > 2 {
        print("FAIL error-bar plot painted outside expected area\n")
        return 4
    }

    print("PASS graphics_quality_error_bar_smoke\n")
    0
}
