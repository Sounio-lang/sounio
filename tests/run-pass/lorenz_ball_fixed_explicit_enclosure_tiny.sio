//@ run-pass
//@ requires: madaros
//@ description: Scalar explicit enclosure receipt for the Lorenz ball-fixed final box

fn bf_abs64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn bf_bound_lo(center: i64, radius: i64) -> i64 {
    return center - radius
}

fn bf_bound_hi(center: i64, radius: i64) -> i64 {
    return center + radius
}

fn bf_bounds_match(center: i64, radius: i64, lo: i64, hi: i64) -> i64 {
    if radius < 0 { return 0 }
    if lo != bf_bound_lo(center, radius) { return 0 }
    if hi != bf_bound_hi(center, radius) { return 0 }
    return 1
}

fn enclosure_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 353) % 1000000007
}

fn enclosure1_status_mask(scale: i64, center: i64, radius: i64,
                          lo: i64, hi: i64) -> i64 {
    var mask: i64 = 0
    if scale > 0 { mask = mask + 1 }
    if radius >= 0 { mask = mask + 2 }
    if bf_bounds_match(center, radius, lo, hi) == 1 { mask = mask + 4 }
    return mask
}

fn enclosure1_fingerprint(scale: i64, center: i64, radius: i64,
                          lo: i64, hi: i64,
                          expected_mask: i64) -> i64 {
    let mask = enclosure1_status_mask(scale, center, radius, lo, hi)
    if mask != expected_mask { return 0 - 1 }
    if mask != 7 { return 0 - 1 }

    var acc: i64 = 31
    acc = enclosure_mix(acc, scale)
    acc = enclosure_mix(acc, center)
    acc = enclosure_mix(acc, radius)
    acc = enclosure_mix(acc, lo)
    acc = enclosure_mix(acc, hi)
    acc = enclosure_mix(acc, mask)
    return acc
}

fn enclosure3_axis_mask(scale: i64,
                        center_x: i64, center_y: i64, center_z: i64,
                        radius_x: i64, radius_y: i64, radius_z: i64,
                        x_lo: i64, x_hi: i64,
                        y_lo: i64, y_hi: i64,
                        z_lo: i64, z_hi: i64) -> i64 {
    var mask: i64 = 0
    if enclosure1_status_mask(scale, center_x, radius_x, x_lo, x_hi) == 7 {
        mask = mask + 1
    }
    if enclosure1_status_mask(scale, center_y, radius_y, y_lo, y_hi) == 7 {
        mask = mask + 2
    }
    if enclosure1_status_mask(scale, center_z, radius_z, z_lo, z_hi) == 7 {
        mask = mask + 4
    }
    return mask
}

fn enclosure3_fingerprint(scale: i64,
                          center_x: i64, center_y: i64, center_z: i64,
                          radius_x: i64, radius_y: i64, radius_z: i64,
                          x_lo: i64, x_hi: i64,
                          y_lo: i64, y_hi: i64,
                          z_lo: i64, z_hi: i64,
                          expected_axis_mask: i64) -> i64 {
    let axis_mask = enclosure3_axis_mask(
        scale, center_x, center_y, center_z,
        radius_x, radius_y, radius_z,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi)
    if axis_mask != expected_axis_mask { return 0 - 1 }
    if axis_mask != 7 { return 0 - 1 }

    let x_fp = enclosure1_fingerprint(scale, center_x, radius_x, x_lo, x_hi, 7)
    let y_fp = enclosure1_fingerprint(scale, center_y, radius_y, y_lo, y_hi, 7)
    let z_fp = enclosure1_fingerprint(scale, center_z, radius_z, z_lo, z_hi, 7)
    if x_fp < 0 { return 0 - 1 }
    if y_fp < 0 { return 0 - 1 }
    if z_fp < 0 { return 0 - 1 }

    var acc: i64 = 47
    acc = enclosure_mix(acc, scale)
    acc = enclosure_mix(acc, axis_mask)
    acc = enclosure_mix(acc, x_fp)
    acc = enclosure_mix(acc, y_fp)
    acc = enclosure_mix(acc, z_fp)
    return acc
}

fn lorenz_final_enclosure_fingerprint(trajectory_manifest_fp: i64,
                                      quality_profile_fp: i64,
                                      radius_budget_fp: i64,
                                      scale: i64,
                                      final_x: i64, final_y: i64, final_z: i64,
                                      final_xr: i64, final_yr: i64, final_zr: i64,
                                      x_lo: i64, x_hi: i64,
                                      y_lo: i64, y_hi: i64,
                                      z_lo: i64, z_hi: i64,
                                      expected_axis_mask: i64) -> i64 {
    if trajectory_manifest_fp != 508132668 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }

    let enclosure_fp = enclosure3_fingerprint(
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi,
        expected_axis_mask)
    if enclosure_fp != 166945519 { return 0 - 1 }

    var acc: i64 = 181
    acc = enclosure_mix(acc, trajectory_manifest_fp)
    acc = enclosure_mix(acc, quality_profile_fp)
    acc = enclosure_mix(acc, radius_budget_fp)
    acc = enclosure_mix(acc, enclosure_fp)
    acc = enclosure_mix(acc, expected_axis_mask)
    return acc
}

fn main() -> i64 {
    let scale: i64 = 1000000
    let final_x: i64 = 1236316
    let final_y: i64 = 2341979
    let final_z: i64 = 951078
    let final_xr: i64 = 243366
    let final_yr: i64 = 319640
    let final_zr: i64 = 42448

    let x_lo: i64 = 992950
    let x_hi: i64 = 1479682
    let y_lo: i64 = 2022339
    let y_hi: i64 = 2661619
    let z_lo: i64 = 908630
    let z_hi: i64 = 993526

    if bf_abs64(x_lo - final_x) != final_xr { return 1 }
    if bf_abs64(y_hi - final_y) != final_yr { return 2 }
    if enclosure1_status_mask(scale, final_x, final_xr, x_lo, x_hi) != 7 { return 3 }
    if enclosure1_status_mask(scale, final_x, final_xr, x_lo + 1, x_hi) != 3 { return 4 }
    if enclosure1_fingerprint(scale, final_x, final_xr, x_lo, x_hi, 7) != 781503653 { return 5 }
    if enclosure1_fingerprint(scale, final_y, final_yr, y_lo, y_hi, 7) != 250710793 { return 6 }
    if enclosure1_fingerprint(scale, final_z, final_zr, z_lo, z_hi, 7) != 974315666 { return 7 }
    if enclosure3_axis_mask(
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi) != 7 { return 8 }
    if enclosure3_fingerprint(
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi, 7) != 166945519 { return 9 }

    let final_fp = lorenz_final_enclosure_fingerprint(
        508132668, 70877465, 565673886,
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi, 7)
    if final_fp != 114244647 { return 10 }

    if enclosure1_fingerprint(scale, final_x, final_xr, x_lo + 1, x_hi, 7) != (0 - 1) { return 11 }
    if enclosure3_fingerprint(
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo + 1, z_hi, 7) != (0 - 1) { return 12 }
    if enclosure3_fingerprint(
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi, 6) != (0 - 1) { return 13 }
    if lorenz_final_enclosure_fingerprint(
        508132669, 70877465, 565673886,
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi, 7) != (0 - 1) { return 14 }
    if lorenz_final_enclosure_fingerprint(
        508132668, 70877466, 565673886,
        scale, final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi, 7) != (0 - 1) { return 15 }

    return 0
}
