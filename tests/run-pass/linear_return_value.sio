//@ run-pass
//@ description: Linear value correctly consumed by returning it

linear struct Token {
    id: i32,
}

fn create_token() -> Token {
    Token { id: 1 }
}

fn pass_through(t: Token) -> Token {
    t
}

fn consume(t: Token) -> i32 {
    t.id  // actually use t to consume it
}

fn main() {
    let t = create_token()
    let t2 = pass_through(t)
    let result = consume(t2)
}
