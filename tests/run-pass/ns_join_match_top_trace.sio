//@ run-pass
//@ known-failure: E245 (#1706) refuses Knowledge x Knowledge arithmetic on Madaros (no lowering) independently of the NS wire; this N2 witness is check-level only -- its NS_TRACE dataflow is asserted by scripts/ci/ns_dataflow_trace_gate.sh / ns_antigarbling_gate.sh
//@ requires: madaros
//@ expect-stdout: ns-join-match: PASS
//
// N2 negative control (codex ruling 2026-08-23): before this fix
// checker_check_match_expr_inplace's result_ty was pinned to the FIRST arm's
// type forever -- every remaining arm was only compatibility-CHECKED, never
// merged. The fix accumulates each remaining arm's noise_set_id into the
// running result via ns_union (same top-absorbs semantics as the if/else
// join, REQ-4), so the match's result set genuinely covers every arm, not
// just the first.
//
// Observable only under SOUNIO_NS_TRACE=1: three "NS_TRACE measure=<h>" seed
// lines with DISTINCT handles (one per arm) interleaved with three
// "NS_TRACE union=<h>" lines (each arm's own laundering step), then one
// "NS_TRACE match_join=<h>" line whose handle differs from the FIRST arm's
// own union handle alone (i.e. it folds in arms 2 and 3 too).
//
// Per-rule sabotage: SOUNIO_NS_SABOTAGE_JOIN=1 skips the accumulation,
// reproducing the pre-fix "match_join equals the first arm's handle" bug.

fn main() -> i64 with IO {
    let choice: i64 = 1
    let r: Knowledge[f64, epsilon < 1.0] = match choice {
        0 => {
            let s: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
            let w: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
            s + w
        }
        1 => {
            let s2: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
            let w2: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
            s2 + w2
        }
        _ => {
            let s3: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
            let w3: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
            s3 + w3
        }
    }
    println("ns-join-match: PASS")
    0
}
