//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz i256-to-ball-fixed precision bridge receipt smoke

fn bridge_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn bridge_instance_fingerprint(scale_log2: i64,
                               source_scale: i64,
                               target_scale: i64,
                               trajectory_manifest_fp: i64,
                               final_x_2p32: i64,
                               final_y_2p32: i64,
                               final_z_2p32: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if source_scale != 4294967296 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if final_x_2p32 != 5309941770 { return 0 - 1 }
    if final_y_2p32 != 10058731223 { return 0 - 1 }
    if final_z_2p32 != 4084837935 { return 0 - 1 }

    var fp: i64 = 271
    fp = bridge_mix(fp, scale_log2, 2447)
    fp = bridge_mix(fp, source_scale, 2447)
    fp = bridge_mix(fp, target_scale, 2447)
    fp = bridge_mix(fp, trajectory_manifest_fp, 2447)
    fp = bridge_mix(fp, final_x_2p32, 2447)
    fp = bridge_mix(fp, final_y_2p32, 2447)
    fp = bridge_mix(fp, final_z_2p32, 2447)
    return fp
}

fn bridge_certificate_fingerprint(bridge_instance_fp: i64,
                                  projection_inclusion_fp: i64,
                                  projection_contract_fp: i64,
                                  final_enclosure_receipt_fp: i64,
                                  enclosure3_fp: i64,
                                  inclusion_mask: i64) -> i64 with Mod {
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if projection_contract_fp != 607091799 { return 0 - 1 }
    if final_enclosure_receipt_fp != 114244647 { return 0 - 1 }
    if enclosure3_fp != 166945519 { return 0 - 1 }
    if inclusion_mask != 7 { return 0 - 1 }

    var fp: i64 = 277
    fp = bridge_mix(fp, bridge_instance_fp, 2459)
    fp = bridge_mix(fp, projection_inclusion_fp, 2459)
    fp = bridge_mix(fp, projection_contract_fp, 2459)
    fp = bridge_mix(fp, final_enclosure_receipt_fp, 2459)
    fp = bridge_mix(fp, enclosure3_fp, 2459)
    fp = bridge_mix(fp, inclusion_mask, 2459)
    return fp
}

fn bridge_audit_fingerprint(bridge_instance_fp: i64,
                            bridge_certificate_fp: i64,
                            projection_portfolio_manifest_fp: i64,
                            enclosure_portfolio_manifest_fp: i64,
                            lifecycle_portfolio_readiness_fp: i64,
                            readiness_mask: i64) -> i64 with Mod {
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if bridge_certificate_fp != 138609006 { return 0 - 1 }
    if projection_portfolio_manifest_fp != 326517892 { return 0 - 1 }
    if enclosure_portfolio_manifest_fp != 291678314 { return 0 - 1 }
    if lifecycle_portfolio_readiness_fp != 413118064 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 281
    fp = bridge_mix(fp, bridge_instance_fp, 2473)
    fp = bridge_mix(fp, bridge_certificate_fp, 2473)
    fp = bridge_mix(fp, projection_portfolio_manifest_fp, 2473)
    fp = bridge_mix(fp, enclosure_portfolio_manifest_fp, 2473)
    fp = bridge_mix(fp, lifecycle_portfolio_readiness_fp, 2473)
    fp = bridge_mix(fp, readiness_mask, 2473)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = bridge_instance_fingerprint(
        32, 4294967296, 1000000, 214180161,
        5309941770, 10058731223, 4084837935)
    if instance_fp != 149359034 { return 1 }

    let certificate_fp = bridge_certificate_fingerprint(
        instance_fp, 890086395, 607091799, 114244647, 166945519, 7)
    if certificate_fp != 138609006 { return 2 }

    let audit_fp = bridge_audit_fingerprint(
        instance_fp, certificate_fp, 326517892, 291678314, 413118064, 31)
    if audit_fp != 488107916 { return 3 }

    if bridge_instance_fingerprint(
        32, 4294967296, 1000000, 214180161,
        5309941771, 10058731223, 4084837935) != (0 - 1) { return 4 }
    if bridge_certificate_fingerprint(
        instance_fp, 890086395, 607091800, 114244647, 166945519, 7) != (0 - 1) { return 5 }
    if bridge_audit_fingerprint(
        instance_fp, certificate_fp, 326517892, 291678314, 413118065, 31) != (0 - 1) { return 6 }

    return 0
}
