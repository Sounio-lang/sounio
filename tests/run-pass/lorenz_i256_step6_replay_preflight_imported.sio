//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 replay preflight checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_replay_preflight_check(
        929938975, 641464796, 15, 15, 15, 15, 6)
    if artifact_fp != 490362827 { return 1 }
    let audit_fp = lorenz_i256_step6_replay_preflight_audit_fingerprint(
        artifact_fp, 416249604, 539977104, 929938975, 531834411, 6, 6, 127)
    if audit_fp != 772468073 { return 2 }
    return 0
}
