//@ run-pass
//@ requires: madaros
use crypto::aead::*
use net::socket::*

// Final whole-plan review, Finding 4: AEAD_AES_256_GCM had zero test
// coverage through the aead_seal/aead_open dispatch interface (only
// AEAD_AES_128_GCM was exercised in tests/run-pass/aead_aes_gcm.sio, and
// AES-256-GCM was only exercised at the lower gcm_seal/gcm_open level in
// tests/run-pass/gcm_seal_open_256.sio). This test re-runs that same
// GCM Test Case 16 vector (McGrew & Viega, "The Galois/Counter Mode of
// Operation (GCM)") through aead_seal/aead_open with
// algo=AEAD_AES_256_GCM. Key/plaintext/AAD/nonce/expected-ciphertext/
// expected-tag are copied verbatim from gcm_seal_open_256.sio, not
// regenerated, so this proves the dispatch layer's AES-256 key-schedule
// call doesn't corrupt what gcm.sio already proved correct at the lower
// level -- and, per Finding 2, also exercises the corrected
// `else if algo == AEAD_AES_256_GCM` branch explicitly.
fn main() -> i64 with IO {
    let key: [u8;32] = [
        0xfe,0xff,0xe9,0x92,0x86,0x65,0x73,0x1c,
        0x6d,0x6a,0x8f,0x94,0x67,0x30,0x83,0x08,
        0xfe,0xff,0xe9,0x92,0x86,0x65,0x73,0x1c,
        0x6d,0x6a,0x8f,0x94,0x67,0x30,0x83,0x08
    ]
    let plaintext_bytes: [u8;60] = [
        0xd9,0x31,0x32,0x25,0xf8,0x84,0x06,0xe5,
        0xa5,0x59,0x09,0xc5,0xaf,0xf5,0x26,0x9a,
        0x86,0xa7,0xa9,0x53,0x15,0x34,0xf7,0xda,
        0x2e,0x4c,0x30,0x3d,0x8a,0x31,0x8a,0x72,
        0x1c,0x3c,0x0c,0x95,0x95,0x68,0x09,0x53,
        0x2f,0xcf,0x0e,0x24,0x49,0xa6,0xb5,0x25,
        0xb1,0x6a,0xed,0xf5,0xaa,0x0d,0xe6,0x57,
        0xba,0x63,0x7b,0x39
    ]
    let aad_bytes: [u8;20] = [
        0xfe,0xed,0xfa,0xce,0xde,0xad,0xbe,0xef,
        0xfe,0xed,0xfa,0xce,0xde,0xad,0xbe,0xef,
        0xab,0xad,0xda,0xd2
    ]
    let nonce: [u8;12] = [
        0xca,0xfe,0xba,0xbe,0xfa,0xce,0xdb,0xad,
        0xde,0xca,0xf8,0x88
    ]
    let expected_ciphertext: [u8;60] = [
        0x52,0x2d,0xc1,0xf0,0x99,0x56,0x7d,0x07,
        0xf4,0x7f,0x37,0xa3,0x2a,0x84,0x42,0x7d,
        0x64,0x3a,0x8c,0xdc,0xbf,0xe5,0xc0,0xc9,
        0x75,0x98,0xa2,0xbd,0x25,0x55,0xd1,0xaa,
        0x8c,0xb0,0x8e,0x48,0x59,0x0d,0xbb,0x3d,
        0xa7,0xb0,0x8b,0x10,0x56,0x82,0x88,0x38,
        0xc5,0xf6,0x1e,0x63,0x93,0xba,0x7a,0x0a,
        0xbc,0xc9,0xf6,0x62
    ]
    let expected_tag: [u8;16] = [
        0x76,0xfc,0x6e,0xce,0x0f,0x4e,0x17,0x68,
        0xcd,0xdf,0x88,0x53,0xbb,0x2d,0x55,0x1b
    ]

    let pt_buf = rawbuf_new(60 + 8)
    var i: i64 = 0
    while i < 60 { rawbuf_set(&pt_buf, i, plaintext_bytes[i as usize] as i64); i = i + 1 }
    let aad_buf = rawbuf_new(20 + 8)
    var a: i64 = 0
    while a < 20 { rawbuf_set(&aad_buf, a, aad_bytes[a as usize] as i64); a = a + 1 }

    let (sealed, sealed_len) = aead_seal(AEAD_AES_256_GCM, &key, &nonce, &pt_buf, 60, &aad_buf, 20)
    if sealed_len != 76 {   // 60 ciphertext + 16 tag
        print_int(1)
        return 1
    }
    var j: i64 = 0
    while j < 60 {
        if rawbuf_get(&sealed, j) != (expected_ciphertext[j as usize] as i64) {
            print_int(2)
            return 1
        }
        j = j + 1
    }
    var k: i64 = 0
    while k < 16 {
        if rawbuf_get(&sealed, 60 + k) != (expected_tag[k as usize] as i64) {
            print_int(3)
            return 1
        }
        k = k + 1
    }

    let (opened, ok) = aead_open(AEAD_AES_256_GCM, &key, &nonce, &sealed, sealed_len, &aad_buf, 20)
    if !ok {
        print_int(4)
        return 1
    }
    var m: i64 = 0
    while m < 60 {
        if rawbuf_get(&opened, m) != (plaintext_bytes[m as usize] as i64) {
            print_int(5)
            return 1
        }
        m = m + 1
    }

    println("aead_aes_256_gcm: AEAD_AES_256_GCM dispatch matches gcm_seal_open_256's own NIST test vector and round-trips")
    return 0
}
