//@ run-pass
//@ description: #2874 -- a module-level `kg` global passed to a `kg` parameter keeps its f64 value, and a struct generic parameter spelled like a built-in unit (`struct Box2<m, V>`) stays a type variable
//@ expect-stdout: 4.250000
//@ expect-stdout: 8.500000
//@ expect-stdout: 7
//@ expect-stdout: 11
//@ expect-stdout: UNIT_BUILTIN_GLOBAL_SHADOW_2874_OK
//
// lean_single turned only user-declared units (`unit NAME`) into f64 types, so
// `fn gk(x: kg)` had an integer slot and `var G: kg = 4.25` reached it as a
// unit-less value: the committed seed refused `gk(G)` ("unit mismatch in call
// argument"). Both built-in names in a parameter and the unit brand on a global
// read are fixed in self-hosted/compiler/lean_single.sio (unit_type_name_at_h,
// unit_type_brand_h). A file that uses a unit spelling as a struct generic
// parameter keeps it a type variable (`m` below), on both engines.

struct Box2<m, V> { a: m, b: V }

var G: kg = 4.25

fn gk(x: kg) -> f64 { x as f64 }
fn twice(x: kg) -> kg { x + x }
fn take_box(b: Box2<i64, i64>) -> i64 { b.a + b.b }

fn main() -> i64 with IO {
    var fails: i64 = 0
    let g = gk(G)
    println(g)
    if g != 4.25 { fails = fails + 1 }
    let t: kg = twice(G)
    let tf: f64 = t as f64
    println(tf)
    if tf != 8.5 { fails = fails + 1 }
    let b = Box2 { a: 3, b: 4 }
    let s = take_box(b)
    println(s)
    if s != 7 { fails = fails + 1 }
    let b2 = Box2 { a: 5, b: 6 }
    println(b2.a + b2.b)
    if fails == 0 { println("UNIT_BUILTIN_GLOBAL_SHADOW_2874_OK") } else { println("UNIT_BUILTIN_GLOBAL_SHADOW_2874_FAIL") }
    fails
}
