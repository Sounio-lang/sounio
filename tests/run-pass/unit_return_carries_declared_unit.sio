//@ run-pass
//@ expect-stdout: unit return: PASS
// A function declared to return a unit returns that unit, and the number
// survives the boundary. The value check matters: a brand that arrives while the
// number does not would be worse than no brand at all.

unit molal = mol / kg;

fn same(x: molal) -> molal with Mut {
    return x
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let m: molal = 2.5
    let r = same(m)
    if r == 2.5 {
        print("unit return: PASS\n")
    }
    return 0
}
