// Fixture: a PRIVATE enum named K, used only inside this module.
// It must not change what `K` means in a module that imports something else
// from here (there, `K` is still kelvin), and inside this module `K` is the
// enum, not kelvin.
enum K { A, B }

fn k_code(k: K) -> i64 { match k { K::A => 0, K::B => 1 } }

pub fn leaf_answer() -> i64 { k_code(K::B) + 41 }
