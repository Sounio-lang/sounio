// Middle module: compares against a sentinel-valued i64 it imports by glob,
// the shape of `use ir::ir::*` + `init_val == BSS_INIT_STRING_MAGIC` in the
// x86 codegen. See imported_string_magic_i64_const.sio.
use fixtures::imported_string_magic_i64_leaf::*

pub fn mid_is_sentinel(x: i64) -> bool with Mut, Panic, Div {
    x == SENTINEL_LIKE
}

pub fn mid_counter_matches() -> bool with Mut, Panic, Div {
    COUNTER_LIKE == SENTINEL_LIKE
}
