//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 trajectory5 to step-6 local flowpipe bridge receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 911
    fp = mix(fp, 214180161, 4547)
    fp = mix(fp, 23144051, 4547)
    fp = mix(fp, 561641681, 4547)
    fp = mix(fp, 134624236, 4547)
    fp = mix(fp, 643317565, 4547)
    fp = mix(fp, 813941448, 4547)
    fp = mix(fp, 693709162, 4547)
    fp = mix(fp, 5, 4547)
    fp = mix(fp, 6, 4547)
    fp = mix(fp, 6, 4547)
    fp = mix(fp, 256, 4547)
    fp = mix(fp, 32, 4547)
    fp = mix(fp, 1, 4547)
    fp = mix(fp, 100, 4547)
    fp = mix(fp, 5309941770, 4547)
    fp = mix(fp, 10058731223, 4547)
    fp = mix(fp, 4084837935, 4547)
    fp = mix(fp, 5309941770, 4547)
    fp = mix(fp, 10058731223, 4547)
    fp = mix(fp, 4084837935, 4547)
    fp = mix(fp, 5784820704, 4547)
    fp = mix(fp, 11394426024, 4547)
    fp = mix(fp, 4100266743, 4547)
    fp = mix(fp, 7, 4547)
    fp = mix(fp, 7, 4547)
    fp = mix(fp, 15, 4547)
    fp = mix(fp, 7, 4547)
    fp = mix(fp, 15, 4547)
    fp = mix(fp, 0, 4547)
    fp = mix(fp, 16, 4547)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 286435512 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 919
    fp = mix(fp, instance, 4561)
    fp = mix(fp, 7, 4561)
    fp = mix(fp, 7, 4561)
    fp = mix(fp, 15, 4561)
    fp = mix(fp, 7, 4561)
    fp = mix(fp, 15, 4561)
    fp = mix(fp, 0, 4561)
    fp = mix(fp, 16, 4561)
    fp = mix(fp, 5, 4561)
    fp = mix(fp, 6, 4561)
    fp = mix(fp, 6, 4561)
    fp = mix(fp, 256, 4561)
    fp = mix(fp, 32, 4561)
    fp = mix(fp, 1, 4561)
    fp = mix(fp, 100, 4561)
    fp = mix(fp, ok_mask, 4561)
    return fp
}

fn bridge_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 286435512 { return 0 - 1 }
    if certificate != 352296669 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 929
    fp = mix(fp, instance, 4567)
    fp = mix(fp, certificate, 4567)
    fp = mix(fp, 17, 4567)
    fp = mix(fp, 5, 4567)
    fp = mix(fp, 6, 4567)
    fp = mix(fp, 6, 4567)
    fp = mix(fp, 15, 4567)
    fp = mix(fp, 7, 4567)
    fp = mix(fp, 15, 4567)
    fp = mix(fp, 0, 4567)
    fp = mix(fp, 16, 4567)
    fp = mix(fp, ok_mask, 4567)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 881240986 { return 0 - 1 }
    if instance != 286435512 { return 0 - 1 }
    if certificate != 352296669 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 937
    fp = mix(fp, artifact, 4583)
    fp = mix(fp, instance, 4583)
    fp = mix(fp, certificate, 4583)
    fp = mix(fp, 214180161, 4583)
    fp = mix(fp, 23144051, 4583)
    fp = mix(fp, 561641681, 4583)
    fp = mix(fp, 134624236, 4583)
    fp = mix(fp, 643317565, 4583)
    fp = mix(fp, 813941448, 4583)
    fp = mix(fp, 693709162, 4583)
    fp = mix(fp, 5309941770, 4583)
    fp = mix(fp, 10058731223, 4583)
    fp = mix(fp, 4084837935, 4583)
    fp = mix(fp, 5784820704, 4583)
    fp = mix(fp, 11394426024, 4583)
    fp = mix(fp, 4100266743, 4583)
    fp = mix(fp, 6, 4583)
    fp = mix(fp, 16, 4583)
    fp = mix(fp, ok_mask, 4583)
    return fp
}

fn bridge_mask(global_claim_mask: i64, status: i64) -> i64 {
    var adjacency_mask: i64 = 0
    if 5309941770 == 5309941770 { adjacency_mask = adjacency_mask + 1 }
    if 10058731223 == 10058731223 { adjacency_mask = adjacency_mask + 2 }
    if 4084837935 == 4084837935 { adjacency_mask = adjacency_mask + 4 }

    let trajectory_mask: i64 = 7
    let center_mask: i64 = 7
    let local_proof_mask: i64 = 15
    var extension_mask: i64 = 0
    if trajectory_mask == 7 { extension_mask = extension_mask + 1 }
    if center_mask == 7 { extension_mask = extension_mask + 2 }
    if local_proof_mask == 15 { extension_mask = extension_mask + 4 }
    if adjacency_mask == 7 { extension_mask = extension_mask + 8 }

    var ok_mask: i64 = 0
    if 214180161 > 0 {
        if 23144051 > 0 { ok_mask = ok_mask + 1 }
    }
    if 134624236 > 0 {
        if 643317565 > 0 { ok_mask = ok_mask + 2 }
    }
    if 813941448 > 0 {
        if 693709162 > 0 { ok_mask = ok_mask + 4 }
    }
    if adjacency_mask == 7 { ok_mask = ok_mask + 8 }
    if 5 + 1 == 6 { ok_mask = ok_mask + 16 }
    if extension_mask == 15 { ok_mask = ok_mask + 32 }
    if global_claim_mask == 0 {
        if status == 16 { ok_mask = ok_mask + 64 }
    }
    if extension_mask == 15 {
        if 45315189 > 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = bridge_mask(0, 16)
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 286435512 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 352296669 { return 3 }
    let artifact = bridge_fp(inst, cert, ok_mask)
    if artifact != 881240986 { return 4 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 732374685 { return 5 }
    if bridge_mask(1, 16) == 255 { return 6 }
    if certificate_fp(inst, 254) != (0 - 1) { return 7 }
    return 0
}
