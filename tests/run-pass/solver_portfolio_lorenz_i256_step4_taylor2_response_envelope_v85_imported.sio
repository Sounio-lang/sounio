//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v85 smoke for Lorenz i256 step-4 Taylor-2 response envelope

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v85_lorenz_i256_step4_taylor2_response_envelope_fingerprint(
        575348777, 417943295, 414744732, 65508192, 600773460,
        157689400, 544039824, 827089582, 688797663, 4, 20, 255)
    if receipt_fp != 574699726 { return 1 }
    let audit_fp = solver_portfolio_v85_lorenz_i256_step4_taylor2_response_envelope_audit_fingerprint(
        receipt_fp, 575348777, 417943295, 414744732, 65508192,
        827089582, 688797663, 544039824, 4, 20, 255)
    if audit_fp != 858781339 { return 2 }
    let manifest_fp = solver_portfolio_v85_lorenz_i256_step4_taylor2_response_envelope_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 767589932 { return 3 }
    let result_fp = solver_portfolio_v85_result_coverage_fingerprint(85, 89, 10, 77, 1, 1, manifest_fp)
    if result_fp != 463727489 { return 4 }
    let family_fp = solver_portfolio_v85_checker_family_coverage_fingerprint(85, 89, 6, 4, 3, 2, 72, 2, manifest_fp)
    if family_fp != 176685209 { return 5 }
    let acceptance_fp = solver_portfolio_v85_acceptance_receipt_fingerprint(85, manifest_fp, result_fp)
    if acceptance_fp != 162558664 { return 6 }
    let audit_receipt_fp = solver_portfolio_v85_audit_receipt_fingerprint(85, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 69746315 { return 7 }
    let readiness_fp = solver_portfolio_v85_readiness_fingerprint(85, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 661481028 { return 8 }
    return 0
}
