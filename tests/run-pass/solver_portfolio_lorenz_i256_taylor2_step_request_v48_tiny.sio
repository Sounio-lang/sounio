//@ run-pass
//@ description: Tiny portfolio v48 smoke for Lorenz i256 Taylor-2 step-request entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 601
    receipt_fp = mix(receipt_fp, 510353327, 3109)
    receipt_fp = mix(receipt_fp, 465022480, 3109)
    receipt_fp = mix(receipt_fp, 222172950, 3109)
    receipt_fp = mix(receipt_fp, 189376492, 3109)
    receipt_fp = mix(receipt_fp, 224324310, 3109)
    receipt_fp = mix(receipt_fp, 6, 3109)
    receipt_fp = mix(receipt_fp, 127, 3109)
    if receipt_fp != 185755530 { return 1 }

    var audit_fp: i64 = 607
    audit_fp = mix(audit_fp, receipt_fp, 3121)
    audit_fp = mix(audit_fp, 510353327, 3121)
    audit_fp = mix(audit_fp, 465022480, 3121)
    audit_fp = mix(audit_fp, 842631931, 3121)
    audit_fp = mix(audit_fp, 13881891, 3121)
    audit_fp = mix(audit_fp, 224324310, 3121)
    audit_fp = mix(audit_fp, 6, 3121)
    audit_fp = mix(audit_fp, 127, 3121)
    if audit_fp != 167433392 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 51, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 51, 1103)
    if entry_fp != 333341021 { return 3 }

    if audit_fp == 167433393 { return 4 }
    return 0
}
