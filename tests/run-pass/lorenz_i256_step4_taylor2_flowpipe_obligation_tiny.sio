//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 flowpipe obligation composition

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1493
    fp = mix(fp, 4, 5351)
    fp = mix(fp, 110014281, 5351)
    fp = mix(fp, 651883944, 5351)
    fp = mix(fp, 37368367, 5351)
    fp = mix(fp, 94030837, 5351)
    fp = mix(fp, 575348777, 5351)
    fp = mix(fp, 417943295, 5351)
    fp = mix(fp, 700260810, 5351)
    fp = mix(fp, 747893368, 5351)
    fp = mix(fp, 563331437, 5351)
    fp = mix(fp, 684718822, 5351)
    fp = mix(fp, 7, 5351)
    fp = mix(fp, 7, 5351)
    fp = mix(fp, 127, 5351)
    fp = mix(fp, 127, 5351)
    fp = mix(fp, 15, 5351)
    fp = mix(fp, 15, 5351)
    fp = mix(fp, 0, 5351)
    fp = mix(fp, 0, 5351)
    fp = mix(fp, 20, 5351)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 887487060 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1499
    fp = mix(fp, instance, 5381)
    fp = mix(fp, 7, 5381)
    fp = mix(fp, 7, 5381)
    fp = mix(fp, 127, 5381)
    fp = mix(fp, 127, 5381)
    fp = mix(fp, 15, 5381)
    fp = mix(fp, 15, 5381)
    fp = mix(fp, 0, 5381)
    fp = mix(fp, 0, 5381)
    fp = mix(fp, 20, 5381)
    fp = mix(fp, ok_mask, 5381)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 887487060 { return 0 - 1 }
    if certificate != 311967295 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1511
    fp = mix(fp, instance, 5387)
    fp = mix(fp, certificate, 5387)
    fp = mix(fp, 15, 5387)
    fp = mix(fp, 4, 5387)
    fp = mix(fp, 15, 5387)
    fp = mix(fp, 15, 5387)
    fp = mix(fp, 0, 5387)
    fp = mix(fp, 0, 5387)
    fp = mix(fp, 20, 5387)
    fp = mix(fp, ok_mask, 5387)
    return fp
}

fn obligation_mask() -> i64 {
    let endpoint_mask: i64 = 7
    let slab_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_mask: i64 = 127
    var composition_mask: i64 = 0
    if endpoint_mask == 7 { composition_mask = composition_mask + 1 }
    if slab_mask == 7 { composition_mask = composition_mask + 2 }
    if response_mask == 127 { composition_mask = composition_mask + 4 }
    if remainder_mask == 127 { composition_mask = composition_mask + 8 }

    let local_proof_mask: i64 = 0
    let global_claim_mask: i64 = 0
    let status: i64 = 20

    var ok_mask: i64 = 0
    if 110014281 > 0 {
        if 37368367 > 0 { ok_mask = ok_mask + 1 }
    }
    if 575348777 > 0 {
        if 700260810 > 0 { ok_mask = ok_mask + 2 }
    }
    if 563331437 > 0 { ok_mask = ok_mask + 4 }
    if composition_mask == 15 { ok_mask = ok_mask + 8 }
    if local_proof_mask == 0 {
        if global_claim_mask == 0 {
            if status == 20 { ok_mask = ok_mask + 16 }
        }
    }
    if 2 == 2 {
        if 100 == 100 { ok_mask = ok_mask + 32 }
    }
    if composition_mask == 15 {
        if response_mask == 127 { ok_mask = ok_mask + 64 }
    }
    if 563331437 > 0 {
        if global_claim_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = obligation_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 887487060 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 311967295 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 555736781 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
