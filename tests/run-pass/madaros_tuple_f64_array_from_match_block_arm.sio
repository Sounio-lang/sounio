//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_FROM_MATCH_BLOCK_ARM PASS
//
// Copilot review (PR #2516), finding 2 on the sixth review round: a BRACED
// match arm (`0 => { pair1() }`) arrives at expr_result_tuple_arr_mask_ref
// as ExprBlock, not as the tail expression directly. match_arms_tuple_arr_
// mask_ref called expr_result_tuple_arr_mask_ref(&arm.body) on that
// ExprBlock, which had no case for it and fell through to 0 -- so every
// braced arm contributed mask 0 regardless of what it evaluated to, even
// though the arm's plain-expression sibling (`_ => pair2()`) classified
// correctly. Fixed by delegating ExprBlock to the same block-tail helper
// the ExprIf case already uses for its `then` branch.
fn pair1() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn pair2() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 4.5
    b[0] = 0.75
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let k: i64 = 0
    let (a, b) = match k {
        0 => { pair1() }
        _ => pair2(),
    }
    let s0: f64 = a[0] * 2.0
    let s1: f64 = 2.0 * b[0]

    if s0 == 3.0 && s1 == 0.5 {
        println("TUPLE_F64_ARRAY_FROM_MATCH_BLOCK_ARM PASS")
        return 0
    }
    1
}
