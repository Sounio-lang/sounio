//@ run-pass
// Expected value, derived BEFORE running (write the derivation, then run):
//   dead = measure(9.0) is never used: under positional indexing it would
//   take channel 0, so x would be channel 1 and y channel 2, and
//   hessian_of(z, 0, 1) would read H[dead, x] = ∂²(x*y)/∂dead∂x = 0
//   (or, if DCE drops the dead measure first, yet another numbering).
//   By source identity none of that matters:
//     z = x * y with x = 3, y = 5  =>  ∂²z/∂x∂y = 1 exactly,
//     ∂²z/∂x² = 0, ∂²z/∂y² = 0.
//   This test FAILS on main: hessian_wrt does not exist there, and the
//   positional form returns a renumbered (wrong) answer with no diagnostic.

fn main() -> i64 with IO, Epistemic {
    let _dead: Knowledge<f64> = measure(9.0, uncertainty: 0.0)
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    let z = x * y
    var fails: i64 = 0
    if hessian_wrt(z, xm, ym) != 1.0 { fails = fails + 1 }
    if hessian_wrt(z, xm, xm) != 0.0 { fails = fails + 1 }
    if hessian_wrt(z, ym, ym) != 0.0 { fails = fails + 1 }
    if fails == 0 {
        println("HESSIAN_WRT_DEAD_MEASURE_PASS")
    } else {
        println("HESSIAN_WRT_DEAD_MEASURE_FAIL")
    }
    return fails
}
