use theorem::portfolio::*

fn main() -> i64 {
    let audit_fp = solver_portfolio_v33_lorenz_i256_projection_margin_audit_fingerprint(
        69322697, 677514412, 159826781, 87220662, 166945519, 31)
    if audit_fp != 397379945 { return 1 }

    let manifest_fp = solver_portfolio_v33_lorenz_i256_projection_margin_bundle_fingerprint(
        69322697, audit_fp)
    if manifest_fp != 502768484 { return 2 }

    let result_fp = solver_portfolio_v33_result_coverage_fingerprint(
        33, 37, 10, 25, 1, 1, manifest_fp)
    if result_fp != 121923227 { return 3 }

    let family_fp = solver_portfolio_v33_checker_family_coverage_fingerprint(
        33, 37, 6, 3, 2, 2, 24, manifest_fp)
    if family_fp != 589697029 { return 4 }

    let acceptance_fp = solver_portfolio_v33_acceptance_receipt_fingerprint(
        33, manifest_fp, result_fp)
    if acceptance_fp != 632669050 { return 5 }

    let audit_receipt_fp = solver_portfolio_v33_audit_receipt_fingerprint(
        33, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 197884610 { return 6 }

    let readiness_fp = solver_portfolio_v33_readiness_fingerprint(
        33, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 593120310 { return 7 }

    if solver_portfolio_v33_lorenz_i256_projection_margin_audit_fingerprint(
        69322697, 677514412, 159826781, 87220663, 166945519, 31) != (0 - 1) { return 8 }
    if solver_portfolio_v33_result_coverage_fingerprint(
        33, 37, 11, 24, 1, 1, manifest_fp) != (0 - 1) { return 9 }

    return 0
}
