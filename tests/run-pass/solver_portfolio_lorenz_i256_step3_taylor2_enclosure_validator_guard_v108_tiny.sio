    audit_fp = mix(audit_fp, 3, 5981)
    audit_fp = mix(audit_fp, 9, 5981)
    audit_fp = mix(audit_fp, 255, 5981)
    if audit_fp != 16664327 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 111, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 111, 1103)
    if entry_fp != 79263008 { return 3 }

    var manifest_fp: i64 = 107
