//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz ball-fixed five-step trajectory manifest smoke

fn bf_abs64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn bf_bound_lo(center: i64, radius: i64) -> i64 {
    return center - radius
}

fn bf_bound_hi(center: i64, radius: i64) -> i64 {
    return center + radius
}

fn bf_bounds_match(center: i64, radius: i64, lo: i64, hi: i64) -> i64 {
    if radius < 0 { return 0 }
    if lo != bf_bound_lo(center, radius) { return 0 }
    if hi != bf_bound_hi(center, radius) { return 0 }
    return 1
}

fn bf_contains_value(center: i64, radius: i64, value: i64) -> i64 {
    if radius < 0 { return 0 }
    if value < bf_bound_lo(center, radius) { return 0 }
    if value > bf_bound_hi(center, radius) { return 0 }
    return 1
}

fn trajectory_manifest_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 701) % 1000000007
}

fn trajectory_manifest_fingerprint(scale: i64, dt: i64, steps: i64,
                                   initial_x: i64, initial_y: i64, initial_z: i64,
                                   chain_anchor: i64, final_step_fingerprint: i64,
                                   final_x: i64, final_y: i64, final_z: i64,
                                   final_xr: i64, final_yr: i64, final_zr: i64,
                                   x_lo: i64, x_hi: i64,
                                   y_lo: i64, y_hi: i64,
                                   z_lo: i64, z_hi: i64) -> i64 {
    if scale <= 0 { return 0 - 1 }
    if dt < 0 { return 0 - 1 }
    if steps <= 0 { return 0 - 1 }
    if chain_anchor < 0 { return 0 - 1 }
    if final_step_fingerprint < 0 { return 0 - 1 }
    if bf_bounds_match(final_x, final_xr, x_lo, x_hi) == 0 { return 0 - 1 }
    if bf_bounds_match(final_y, final_yr, y_lo, y_hi) == 0 { return 0 - 1 }
    if bf_bounds_match(final_z, final_zr, z_lo, z_hi) == 0 { return 0 - 1 }

    var acc: i64 = 61
    acc = trajectory_manifest_mix(acc, scale)
    acc = trajectory_manifest_mix(acc, dt)
    acc = trajectory_manifest_mix(acc, steps)
    acc = trajectory_manifest_mix(acc, initial_x)
    acc = trajectory_manifest_mix(acc, initial_y)
    acc = trajectory_manifest_mix(acc, initial_z)
    acc = trajectory_manifest_mix(acc, chain_anchor)
    acc = trajectory_manifest_mix(acc, final_step_fingerprint)
    acc = trajectory_manifest_mix(acc, final_x)
    acc = trajectory_manifest_mix(acc, final_y)
    acc = trajectory_manifest_mix(acc, final_z)
    acc = trajectory_manifest_mix(acc, final_xr)
    acc = trajectory_manifest_mix(acc, final_yr)
    acc = trajectory_manifest_mix(acc, final_zr)
    acc = trajectory_manifest_mix(acc, x_lo)
    acc = trajectory_manifest_mix(acc, x_hi)
    acc = trajectory_manifest_mix(acc, y_lo)
    acc = trajectory_manifest_mix(acc, y_hi)
    acc = trajectory_manifest_mix(acc, z_lo)
    acc = trajectory_manifest_mix(acc, z_hi)
    return acc
}

fn trajectory_manifest_valid(scale: i64, dt: i64, steps: i64,
                             chain_anchor: i64, final_step_fingerprint: i64,
                             manifest_fingerprint: i64) -> i64 {
    if scale != 1000000 { return 0 }
    if dt != 10000 { return 0 }
    if steps != 5 { return 0 }
    if chain_anchor != 484010018 { return 0 }
    if final_step_fingerprint != 236665224 { return 0 }
    if manifest_fingerprint != 508132668 { return 0 }
    return 1
}

fn main() -> i64 {
    let scale: i64 = 1000000
    let dt: i64 = 10000
    let steps: i64 = 5
    let initial_x: i64 = 1000000
    let initial_y: i64 = 1000000
    let initial_z: i64 = 1000000
    let chain_anchor: i64 = 484010018
    let final_step_fingerprint: i64 = 236665224

    let final_x: i64 = 1236316
    let final_y: i64 = 2341979
    let final_z: i64 = 951078
    let final_xr: i64 = 243366
    let final_yr: i64 = 319640
    let final_zr: i64 = 42448

    let x_lo: i64 = 992950
    let x_hi: i64 = 1479682
    let y_lo: i64 = 2022339
    let y_hi: i64 = 2661619
    let z_lo: i64 = 908630
    let z_hi: i64 = 993526

    let manifest: i64 = trajectory_manifest_fingerprint(
        scale, dt, steps,
        initial_x, initial_y, initial_z,
        chain_anchor, final_step_fingerprint,
        final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi)

    if bf_abs64(final_x - initial_x) != 236316 { return 1 }
    if bf_bounds_match(final_x, final_xr, x_lo, x_hi) != 1 { return 2 }
    if bf_bounds_match(final_y, final_yr, y_lo, y_hi) != 1 { return 3 }
    if bf_bounds_match(final_z, final_zr, z_lo, z_hi) != 1 { return 4 }
    if bf_contains_value(final_x, final_xr, x_lo) != 1 { return 5 }
    if bf_contains_value(final_y, final_yr, y_hi) != 1 { return 6 }
    if bf_contains_value(final_z, final_zr, z_lo - 1) != 0 { return 7 }
    if manifest != 508132668 { return 8 }
    if trajectory_manifest_valid(scale, dt, steps, chain_anchor, final_step_fingerprint, manifest) != 1 { return 9 }

    if trajectory_manifest_fingerprint(
        scale, dt, steps,
        initial_x, initial_y, initial_z,
        chain_anchor + 1, final_step_fingerprint,
        final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo, x_hi, y_lo, y_hi, z_lo, z_hi) == manifest { return 10 }
    if trajectory_manifest_fingerprint(
        scale, dt, steps,
        initial_x, initial_y, initial_z,
        chain_anchor, final_step_fingerprint,
        final_x, final_y, final_z,
        final_xr, final_yr, final_zr,
        x_lo + 1, x_hi, y_lo, y_hi, z_lo, z_hi) != (0 - 1) { return 11 }
    if trajectory_manifest_valid(scale, dt, steps + 1, chain_anchor, final_step_fingerprint, manifest) != 0 { return 12 }
    if trajectory_manifest_valid(scale, dt, steps, chain_anchor, final_step_fingerprint + 1, manifest) != 0 { return 13 }

    return 0
}
