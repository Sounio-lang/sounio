//@ run-pass
//@ description: #2388 — derived unit annotations with `^n` and parentheses: `m^2`, `mol/cm^3`, `cal/(mol*K)`
//@ expect-stdout: 12.000000
//@ expect-stdout: 0.500000
//@ expect-stdout: 1.987204

fn main() -> i32 with IO, Mut, Panic, Div {
    let w: m = 3.0
    let h: m = 4.0
    let area: m^2 = w * h
    print_f64(area); print("\n")
    let n: mol = 2.0
    let side: cm = 2.0
    let vol: cm^3 = side * side * side
    let c: mol/cm^3 = n / (vol / 2.0)
    print_f64(c); print("\n")
    let e: cal = 1.987204
    let amount: mol = 1.0
    let t: K = 1.0
    let r: cal/(mol*K) = e / (amount * t)
    print_f64(r); print("\n")
    return 0
}
