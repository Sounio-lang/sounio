    audit_fp = mix(audit_fp, 1, 6203)
    audit_fp = mix(audit_fp, 1, 6203)
    audit_fp = mix(audit_fp, 255, 6203)
    if audit_fp != 791962712 { return 2 }

    var entry_fp: i64 = 101
