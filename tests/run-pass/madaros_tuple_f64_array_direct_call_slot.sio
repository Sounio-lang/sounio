//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_DIRECT_CALL_SLOT PASS
//
// `let a = pair().0` -- slot access straight off a call, with no
// intervening tuple-destructure `let`, so `expr_is_tuple_slot_f64_array_ref`
// sees an ExprCall base rather than a local ExprIdent. The sibling
// regression (madaros_tuple_f64_array_destructure.sio) always binds via
// `let (a, b) = pair()`, which never exercises this path. Before the fix, a
// call base fell straight through to `return false`, so `a` took the
// integer path and the element reads below corrupted the f64 bits.
fn pair() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    a[1] = 0.25
    b[0] = 4.5
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let a = pair().0
    let s0: f64 = a[0] * 2.0
    let s1: f64 = 2.0 * a[1]
    var acc: f64 = 0.0
    var j: i64 = 0
    while j < 2 {
        acc = acc + 0.5 * a[j]
        j = j + 1
    }
    if s0 == 3.0 && s1 == 0.5 && acc == 0.875 {
        println("TUPLE_F64_ARRAY_DIRECT_CALL_SLOT PASS")
        return 0
    }
    1
}
