//@ run-pass
//@ description: Tiny pseudo-Boolean forced-literal propagation checker smoke

fn pb_bool_valid(x: i64) -> i64 {
    if x == 0 { return 1 }
    if x == 1 { return 1 }
    if x == (0 - 1) { return 1 }
    return 0
}

fn pb_min_term(w: i64, x: i64) -> i64 {
    if x == 1 { return w }
    return 0
}

fn pb_max_term(w: i64, x: i64) -> i64 {
    if x == 0 { return 0 }
    return w
}

fn pb_min_sum3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64) -> i64 {
    return pb_min_term(w0, x0) + pb_min_term(w1, x1) + pb_min_term(w2, x2)
}

fn pb_max_sum3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64) -> i64 {
    return pb_max_term(w0, x0) + pb_max_term(w1, x1) + pb_max_term(w2, x2)
}

fn pb_valid_slot3(slot: i64) -> i64 {
    if slot == 0 { return 1 }
    if slot == 1 { return 1 }
    if slot == 2 { return 1 }
    return 0
}

fn pb_slot_unknown3(x0: i64, x1: i64, x2: i64, slot: i64) -> i64 {
    if pb_valid_slot3(slot) == 0 { return 0 }
    if slot == 0 { if x0 == (0 - 1) { return 1 } }
    if slot == 1 { if x1 == (0 - 1) { return 1 } }
    if slot == 2 { if x2 == (0 - 1) { return 1 } }
    return 0
}

fn pb_weight_at3(w0: i64, w1: i64, w2: i64, slot: i64) -> i64 {
    if slot == 0 { return w0 }
    if slot == 1 { return w1 }
    if slot == 2 { return w2 }
    return 0 - 1
}

fn pb_check_le_forces_false3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64, rhs: i64, slot: i64) -> i64 {
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if pb_bool_valid(x0) == 0 { return 0 }
    if pb_bool_valid(x1) == 0 { return 0 }
    if pb_bool_valid(x2) == 0 { return 0 }
    if pb_slot_unknown3(x0, x1, x2, slot) == 0 { return 0 }
    if pb_min_sum3(w0, x0, w1, x1, w2, x2) + pb_weight_at3(w0, w1, w2, slot) > rhs { return 1 }
    return 0
}

fn pb_check_ge_forces_true3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64, rhs: i64, slot: i64) -> i64 {
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if pb_bool_valid(x0) == 0 { return 0 }
    if pb_bool_valid(x1) == 0 { return 0 }
    if pb_bool_valid(x2) == 0 { return 0 }
    if pb_slot_unknown3(x0, x1, x2, slot) == 0 { return 0 }
    if pb_max_sum3(w0, x0, w1, x1, w2, x2) - pb_weight_at3(w0, w1, w2, slot) < rhs { return 1 }
    return 0
}

fn main() -> i64 {
    // 2*x0 + 3*x1 + 5*x2 <= 6, with x0=true and x2 unknown:
    // setting x2=true gives 7 > 6, so x2 is forced false.
    if pb_check_le_forces_false3(2, 1, 3, 0 - 1, 5, 0 - 1, 6, 2) != 1 { return 1 }
    if pb_check_le_forces_false3(2, 1, 3, 0 - 1, 5, 0 - 1, 7, 2) != 0 { return 2 }
    if pb_check_le_forces_false3(2, 1, 3, 0 - 1, 5, 0, 6, 2) != 0 { return 3 }
    if pb_check_le_forces_false3(2, 1, 0 - 3, 0 - 1, 5, 0 - 1, 6, 2) != 0 { return 4 }
    if pb_check_le_forces_false3(2, 1, 3, 2, 5, 0 - 1, 6, 2) != 0 { return 5 }
    if pb_check_le_forces_false3(2, 1, 3, 0 - 1, 5, 0 - 1, 6, 4) != 0 { return 6 }

    // 2*x0 + 3*x1 + 5*x2 >= 7, with x0=false and x2 unknown:
    // setting x2=false leaves max 3 < 7, so x2 is forced true.
    if pb_check_ge_forces_true3(2, 0, 3, 0 - 1, 5, 0 - 1, 7, 2) != 1 { return 7 }
    if pb_check_ge_forces_true3(2, 0, 3, 0 - 1, 5, 0 - 1, 3, 2) != 0 { return 8 }
    if pb_check_ge_forces_true3(2, 0, 3, 0 - 1, 5, 1, 7, 2) != 0 { return 9 }
    if pb_check_ge_forces_true3(2, 0, 3, 0 - 1, 0 - 5, 0 - 1, 7, 2) != 0 { return 10 }
    if pb_check_ge_forces_true3(2, 0, 3, 4, 5, 0 - 1, 7, 2) != 0 { return 11 }
    if pb_check_ge_forces_true3(2, 0, 3, 0 - 1, 5, 0 - 1, 7, 4) != 0 { return 12 }

    return 0
}
