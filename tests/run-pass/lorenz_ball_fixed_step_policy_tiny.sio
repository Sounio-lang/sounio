//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz ball-fixed five-step step-policy smoke from quality profile

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn step_policy_fingerprint(quality_profile_fp: i64,
                           radius_fill_limit_ppm: i64,
                           min_slack_ppm: i64,
                           max_aspect_q: i64,
                           max_box_volume: i64) -> i64 {
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if radius_fill_limit_ppm != 970000 { return 0 - 1 }
    if min_slack_ppm != 30000 { return 0 - 1 }
    if max_aspect_q != 8 { return 0 - 1 }
    if max_box_volume != 27000000000000000 { return 0 - 1 }

    let radius_fill_ppm = 968726
    let slack_ppm = 31273
    let aspect_q = 7
    let aspect_r = 22504
    let box_volume = 26416072366172160

    var policy_mask: i64 = 0
    if radius_fill_ppm <= radius_fill_limit_ppm { policy_mask = policy_mask + 1 }
    if slack_ppm >= min_slack_ppm { policy_mask = policy_mask + 2 }
    if aspect_q <= max_aspect_q { policy_mask = policy_mask + 4 }
    if box_volume <= max_box_volume { policy_mask = policy_mask + 8 }
    if policy_mask != 15 { return 0 - 1 }

    let action_accept_same_dt: i64 = 1
    let next_dt_num: i64 = 1
    let next_dt_den: i64 = 1

    var acc: i64 = 97
    acc = quality_mix(acc, quality_profile_fp)
    acc = quality_mix(acc, radius_fill_limit_ppm)
    acc = quality_mix(acc, min_slack_ppm)
    acc = quality_mix(acc, max_aspect_q)
    acc = quality_mix(acc, max_box_volume)
    acc = quality_mix(acc, radius_fill_ppm)
    acc = quality_mix(acc, slack_ppm)
    acc = quality_mix(acc, aspect_q)
    acc = quality_mix(acc, aspect_r)
    acc = quality_mix(acc, box_volume)
    acc = quality_mix(acc, policy_mask)
    acc = quality_mix(acc, action_accept_same_dt)
    acc = quality_mix(acc, next_dt_num)
    acc = quality_mix(acc, next_dt_den)
    return acc
}

fn main() -> i64 {
    let fp = step_policy_fingerprint(
        70877465, 970000, 30000, 8, 27000000000000000)
    if fp != 231786611 { return 1 }

    if 968726 <= 970000 { } else { return 2 }
    if 31273 >= 30000 { } else { return 3 }
    if 7 <= 8 { } else { return 4 }
    if 26416072366172160 <= 27000000000000000 { } else { return 5 }

    if step_policy_fingerprint(
        70877466, 970000, 30000, 8, 27000000000000000) != (0 - 1) { return 6 }
    if step_policy_fingerprint(
        70877465, 968725, 30000, 8, 27000000000000000) != (0 - 1) { return 7 }
    if step_policy_fingerprint(
        70877465, 970000, 31274, 8, 27000000000000000) != (0 - 1) { return 8 }
    if step_policy_fingerprint(
        70877465, 970000, 30000, 6, 27000000000000000) != (0 - 1) { return 9 }
    if step_policy_fingerprint(
        70877465, 970000, 30000, 8, 26416072366172159) != (0 - 1) { return 10 }

    return 0
}
