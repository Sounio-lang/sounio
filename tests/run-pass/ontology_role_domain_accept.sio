//@ run-pass
//@ known-failure: Requires implementation
//@ expect-stdout: ontology role domain accept OK

ontology Bio {
    class Drug
    class Disease
    class Rapamycin subclass_of Drug
    role treats domain Drug range Disease
}

fn accept(d: Drug) -> i32 { 0 }

fn bridge(r: Rapamycin) -> i32 {
    accept(r)
}

fn main() -> i32 {
    print("ontology role domain accept OK\n")
    0
}
