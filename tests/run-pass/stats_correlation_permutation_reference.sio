//@ run-pass
//@ expect-stdout: STATS_CORRELATION_PERMUTATION_REFERENCE_PASS
// C++23 independent raw moments/ranks and labelled permutation oracle.
use stats::correlation_permutation::{correlation_permutation}
fn close(a:f64,b:f64)->bool {let d=if a>b{a-b}else{b-a} let v=if b<0.0{-b}else{b} return d<=1.0e-13+1.0e-11*v}
// n2_pearson
fn case_0() with Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 x[0]=1.00000000000000000e+00
 x[1]=2.00000000000000000e+00
 var y:[f64;256]=[0.0;256]
 y[0]=3.00000000000000000e+00
 y[1]=1.00000000000000000e+00
 let r=correlation_permutation(&x,&y,2,1,-99,(-9223372036854775807 - 1),true)
 assert(r.status==0)
 assert(r.statistic==1)
 assert(r.n==2)
 assert(r.method==2)
 assert(r.hits==2)
 assert(r.draws==2)
 assert(r.seed_used==0)
 assert(!r.mc_available)
 assert(!r.exchangeability_assessed)
 assert(close(r.coefficient,-1.00000000000000000e+00))
 assert(close(r.p_value,1.00000000000000000e+00))
 assert(r.mc_se==0.0)
 assert(r.mc_lo==0.0)
 assert(r.mc_hi==0.0)
}
