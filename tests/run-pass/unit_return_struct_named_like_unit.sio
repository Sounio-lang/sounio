//@ run-pass
//@ expect-stdout: struct named like a unit: PASS
// W (watt) and K (kelvin) are built-in unit names. A struct return type with
// such a name resolved its name hash to that unit's dimension, and the
// return-value unit check refused a struct value that carries no unit at all --
// on a tail value and on an explicit return alike. The call-argument check never
// did: it only looks at f64-kind parameters, and the return check now does the
// same.

struct W { c: [i64; 4], bits: i64 }
struct K { bits: i64 }

fn tail_w(p: i64, q: i64) -> W with Mut, Panic {
    W { c: [p, q, p + q, q], bits: q }
}

fn return_k(q: i64) -> K with Mut, Panic {
    return K { bits: q }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let w = tail_w(3, 5)
    let k = return_k(7)
    if w.c[2] == 8 && w.bits == 5 && k.bits == 7 {
        print("struct named like a unit: PASS\n")
        return 0
    }
    print("struct named like a unit: FAIL\n")
    return 1
}
