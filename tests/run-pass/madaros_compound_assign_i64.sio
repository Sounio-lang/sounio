//@ run-pass
//@ requires: madaros
//@ expect-stdout: COMPOUND_ASSIGN_I64_OK
//@ description: Madaros lowers i64 `+= -= *= /= %=` (local, struct field, array element, loop) as the written-out binary
// Regression: lower_assign_stmt_ref mapped every compound op except `+=` to
// OpSub, so `a *= 3` computed a - 3 and `a /= 5` computed a - 5.

struct Counter { n: i64 }

fn main() with IO, Mut {
    var fail: i64 = 0

    var a: i64 = 10
    a += 4
    println(a)
    if a != 14 { fail = fail + 1 }
    a -= 6
    println(a)
    if a != 8 { fail = fail + 1 }
    a *= 3
    println(a)
    if a != 24 { fail = fail + 1 }
    a /= 5
    println(a)
    if a != 4 { fail = fail + 1 }
    a %= 3
    println(a)
    if a != 1 { fail = fail + 1 }

    // Compound with a local on the RHS.
    var b: i64 = 7
    var k: i64 = 6
    b *= k
    println(b)
    if b != 42 { fail = fail + 1 }
    b %= k - 1
    println(b)
    if b != 2 { fail = fail + 1 }

    var c = Counter { n: 7 }
    c.n *= 6
    println(c.n)
    if c.n != 42 { fail = fail + 1 }
    c.n /= 4
    println(c.n)
    if c.n != 10 { fail = fail + 1 }

    var arr: [i64; 3] = [1, 2, 3]
    arr[1] *= 5
    println(arr[1])
    if arr[1] != 10 { fail = fail + 1 }
    arr[2] -= 10
    println(arr[2])
    if arr[2] != 0 - 7 { fail = fail + 1 }

    // Across a loop back-edge.
    var sum: i64 = 0
    var p: i64 = 1
    var i: i64 = 0
    while i < 10 {
        sum += i
        p *= 2
        i += 1
    }
    println(sum)
    println(p)
    if sum != 45 { fail = fail + 1 }
    if p != 1024 { fail = fail + 1 }

    if fail == 0 {
        println("COMPOUND_ASSIGN_I64_OK")
    } else {
        println("COMPOUND_ASSIGN_I64_FAIL")
    }
}
