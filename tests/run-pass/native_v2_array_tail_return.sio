//@ run-pass

fn basis(idx: i64) -> [f64; 8] with Mut {
    var out: [f64; 8] = [0.0; 8]
    out[idx] = 1.0
    out
}

fn main() -> i32 with IO, Mut {
    var e1 = basis(1)
    var e2 = basis(2)
    if e1[1] > 0.99 && e2[2] > 0.99 {
        println("ALL PASS")
        return 0
    }
    println("FAIL")
    1
}
