//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_LET_BYTECODE_PASS

// Inter-procedural FO through pure helpers with let-bindings and ≤4 params.
// kind-6 bytecode transfer: let-elim / nested arith at call sites.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn scale2_let(x: f64) -> f64 {
    let two = 2.0
    two * x
}

fn a2b_let(x: f64, y: f64) -> f64 {
    let xx = x * x
    xx * y
}

fn fma3(a: f64, b: f64, c: f64) -> f64 {
    a * b + c
}

fn scale_then_add(x: f64, y: f64) -> f64 {
    let s = 2.0 * x
    s + y
}

fn pipe(x: f64) -> f64 {
    scale2_let(x)
}

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    let c: Knowledge<f64> = measure(4.0, uncertainty: 0.05)
    let av = a.value
    let bv = b.value
    let cv = c.value

    let v1 = variance_of(scale2_let(av))
    let v2 = variance_of(a2b_let(av, bv))
    let v3 = variance_of(fma3(av, bv, cv))
    let v4 = variance_of(scale_then_add(av, bv))
    let v5 = variance_of(pipe(av))
    let t = scale2_let(av)
    let v6 = variance_of(t * bv)

    print("L1="); print_f64(v1); print("\n")
    print("L2="); print_f64(v2); print("\n")
    print("L4="); print_f64(v3); print("\n")
    print("L5="); print_f64(v4); print("\n")
    print("L7="); print_f64(v5); print("\n")
    print("L8="); print_f64(v6); print("\n")

    // truths:
    // L1: 4*0.0025=0.01
    // L2: a²b FO → 0.40
    // L4: ab+c → 0.035
    // L5: 2a+b → 0.0125
    // L7: pipe=scale2_let → 0.01
    // L8: (2a)*b → 0.13
    let ok = abs_f(v1 - 0.01) < 1.0e-9
        && abs_f(v2 - 0.40) < 1.0e-9
        && abs_f(v3 - 0.035) < 1.0e-9
        && abs_f(v4 - 0.0125) < 1.0e-9
        && abs_f(v5 - 0.01) < 1.0e-9
        && abs_f(v6 - 0.13) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_LET_BYTECODE_PASS\n")
    } else {
        print("MADAROS_GUM_FO_LET_BYTECODE_FAIL\n")
    }
}
