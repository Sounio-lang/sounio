//@ run-pass
//@ description: #2684 -- Option<Box<S>> of a struct imported from another module (ir::ir::IrRegList) keeps its payload
//@ expect-stdout-contains: len(args)=1
//@ expect-stdout-contains: IMPORTED_OPTION_BOX_2684_OK

use ir::ir::*

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let args: Option<Box<IrRegList>> = Some(Box::new(ir_reg_list_single(7)))
    let n_args = ir_reg_list_len(args)
    print("len(args)=") print_int(n_args) print("\n")
    let ins = ir_call_extern(3, ir_empty_name(), args, 1)
    print("ins.arg_count=") print_int(ins.arg_count) print("\n")
    let n_call = ir_reg_list_len(ins.call_args)
    print("len(ins.call_args)=") print_int(n_call) print("\n")
    if n_args == 1 && ins.arg_count == 1 && n_call == 1 {
        println("IMPORTED_OPTION_BOX_2684_OK")
    } else {
        println("IMPORTED_OPTION_BOX_2684_FAIL")
    }
    0
}
