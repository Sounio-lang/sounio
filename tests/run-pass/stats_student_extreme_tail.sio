//@ run-pass
//@ expect-stdout: STATS_STUDENT_EXTREME_TAIL_PASS
use stats::student_t::{t_two_tail}
use math::pure::{is_finite}
fn tail_abs(x:f64)->f64 {if x<0.0 {0.0-x}else{x}}
fn tail_close(actual:f64,expected:f64,tolerance:f64) with Mut,Div,Panic {
 assert(is_finite(actual) && actual>0.0)
 assert(tail_abs(actual/expected-1.0)<tolerance)
}
fn main() with IO,Mut,Div,Panic {
 // Independent analytic Cauchy limits, constants emitted by C++23 reference.
 tail_close(t_two_tail(1.0e200,1.0),6.36619772367581343e-201,2.0e-13)
 tail_close(t_two_tail(-1.0e200,1.0),6.36619772367581343e-201,2.0e-13)
 tail_close(t_two_tail(1.0e308,1.0),6.36619772367581343e-309,2.0e-13)
 tail_close(t_two_tail(1.0,1.0),0.5,2.0e-13)
 tail_close(t_two_tail(0.25,1.0),0.8440417392452613,2.0e-13)
 assert(t_two_tail(0.0,1.0)==1.0)
 // df2 tail is 1-t/sqrt(t*t+2); rationalized asymptote is 1/t^2.
 tail_close(t_two_tail(1.0e155,2.0),1.0e-310,2.0e-10)
 // C++23 analytic df2 near-origin tail; x=1 would lose this departure.
 assert(tail_abs(t_two_tail(1.0e-8,2.0)-0.99999999292893216)<2.0e-14)
 println("STATS_STUDENT_EXTREME_TAIL_PASS")
 0
}
