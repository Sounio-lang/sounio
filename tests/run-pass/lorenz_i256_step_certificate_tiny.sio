//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 single-step certificate contract with explicit dt and quotient/remainder witnesses

fn cert_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn lorenz_i256_step4_instance_fingerprint(step_index: i64,
                                          sigma: i64, rho: i64,
                                          beta_num: i64, beta_den: i64,
                                          scale: i64, dt_q: i64, dt_r: i64,
                                          start_x: i64, start_y: i64,
                                          start_z: i64) -> i64 with Mod {
    if step_index != 4 { return 0 - 1 }
    if sigma != 10 { return 0 - 1 }
    if rho != 28 { return 0 - 1 }
    if beta_num != 8 { return 0 - 1 }
    if beta_den != 3 { return 0 - 1 }
    if scale != 4294967296 { return 0 - 1 }
    if dt_q != 42949672 { return 0 - 1 }
    if dt_r != 96 { return 0 - 1 }
    if start_x != 4617762706 { return 0 - 1 }
    if start_y != 7643846696 { return 0 - 1 }
    if start_z != 4120687759 { return 0 - 1 }

    var fp: i64 = 223
    fp = cert_mix(fp, step_index, 1709)
    fp = cert_mix(fp, sigma, 1709)
    fp = cert_mix(fp, rho, 1709)
    fp = cert_mix(fp, beta_num, 1709)
    fp = cert_mix(fp, beta_den, 1709)
    fp = cert_mix(fp, scale, 1709)
    fp = cert_mix(fp, dt_q, 1709)
    fp = cert_mix(fp, dt_r, 1709)
    fp = cert_mix(fp, start_x, 1709)
    fp = cert_mix(fp, start_y, 1709)
    fp = cert_mix(fp, start_z, 1709)
    return fp
}

fn lorenz_i256_step4_certificate_fingerprint(instance_fp: i64,
                                             dy_scaled_q: i64, dy_scaled_r: i64,
                                             xy_scaled_q: i64, xy_scaled_r: i64,
                                             beta_q: i64, beta_r: i64,
                                             x_inc_q: i64, x_inc_r: i64,
                                             y_inc_q: i64, y_inc_r: i64,
                                             z_drop_q: i64, z_drop_r: i64,
                                             final_x: i64, final_y: i64,
                                             final_z: i64, ok_mask: i64) -> i64 with Mod {
    if instance_fp != 924803514 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 227
    fp = cert_mix(fp, instance_fp, 1721)
    fp = cert_mix(fp, dy_scaled_q, 1721)
    fp = cert_mix(fp, dy_scaled_r, 1721)
    fp = cert_mix(fp, xy_scaled_q, 1721)
    fp = cert_mix(fp, xy_scaled_r, 1721)
    fp = cert_mix(fp, beta_q, 1721)
    fp = cert_mix(fp, beta_r, 1721)
    fp = cert_mix(fp, x_inc_q, 1721)
    fp = cert_mix(fp, x_inc_r, 1721)
    fp = cert_mix(fp, y_inc_q, 1721)
    fp = cert_mix(fp, y_inc_r, 1721)
    fp = cert_mix(fp, z_drop_q, 1721)
    fp = cert_mix(fp, z_drop_r, 1721)
    fp = cert_mix(fp, final_x, 1721)
    fp = cert_mix(fp, final_y, 1721)
    fp = cert_mix(fp, final_z, 1721)
    fp = cert_mix(fp, ok_mask, 1721)
    return fp
}

fn lorenz_i256_step4_contract_fingerprint(instance_fp: i64,
                                          certificate_fp: i64,
                                          ok_mask: i64,
                                          local_step_fp: i64,
                                          chain_fp: i64) -> i64 with Mod {
    if instance_fp != 924803514 { return 0 - 1 }
    if certificate_fp != 700498889 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }
    if local_step_fp != 753371133 { return 0 - 1 }
    if chain_fp != 737039167 { return 0 - 1 }

    var fp: i64 = 229
    fp = cert_mix(fp, instance_fp, 1733)
    fp = cert_mix(fp, certificate_fp, 1733)
    fp = cert_mix(fp, ok_mask, 1733)
    fp = cert_mix(fp, local_step_fp, 1733)
    fp = cert_mix(fp, chain_fp, 1733)
    return fp
}

fn lorenz_i256_step4_certificate_check(dt_q: i64, dt_r: i64,
                                       dy_scaled_q_i64: i64, dy_scaled_r_i64: i64,
                                       xy_scaled_q_i64: i64, xy_scaled_r_i64: i64,
                                       beta_q_i64: i64, beta_r_i64: i64,
                                       x_inc_q_i64: i64, x_inc_r_i64: i64,
                                       y_inc_q_i64: i64, y_inc_r_i64: i64,
                                       z_drop_q_i64: i64, z_drop_r_i64: i64,
                                       final_x_i64: i64, final_y_i64: i64,
                                       final_z_i64: i64) -> i64 with Mod {
    let scale: i256 = 4294967296 as i256
    let x3: i256 = 4617762706 as i256
    let y3: i256 = 7643846696 as i256
    let z3: i256 = 4120687759 as i256

    let dt: i256 = dt_q as i256
    let dy_scaled_q: i256 = dy_scaled_q_i64 as i256
    let dy_scaled_r: i256 = dy_scaled_r_i64 as i256
    let xy_scaled_q: i256 = xy_scaled_q_i64 as i256
    let xy_scaled_r: i256 = xy_scaled_r_i64 as i256
    let beta_q: i256 = beta_q_i64 as i256
    let beta_r: i256 = beta_r_i64 as i256
    let x_inc_q: i256 = x_inc_q_i64 as i256
    let x_inc_r: i256 = x_inc_r_i64 as i256
    let y_inc_q: i256 = y_inc_q_i64 as i256
    let y_inc_r: i256 = y_inc_r_i64 as i256
    let z_drop_q: i256 = z_drop_q_i64 as i256
    let z_drop_r: i256 = z_drop_r_i64 as i256

    let dx_num: i256 = (10 as i256) * (y3 - x3)
    let dy_num: i256 = x3 * ((28 as i256) * scale - z3)
    let xy_num: i256 = x3 * y3
    let beta_num_z: i256 = (8 as i256) * z3
    let dy: i256 = dy_scaled_q - y3
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dt_ok = check_div_witness_i256(scale, 100 as i256, dt, dt_r as i256)
    let dy_scaled_ok = check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r)

    var ok_mask: i64 = 0
    if dt_ok == 1 { ok_mask = ok_mask + 1 }
    if dy_scaled_ok == 1 { ok_mask = ok_mask + 2 }
    if xy_scaled_ok == 1 { ok_mask = ok_mask + 4 }
    if beta_ok == 1 { ok_mask = ok_mask + 8 }
    if x_inc_ok == 1 { ok_mask = ok_mask + 16 }
    if y_inc_ok == 1 { ok_mask = ok_mask + 32 }
    if z_drop_ok == 1 { ok_mask = ok_mask + 64 }
    if ok_mask != 127 { return 0 - 1 }

    if x3 + x_inc_q != final_x_i64 as i256 { return 0 - 1 }
    if y3 + y_inc_q != final_y_i64 as i256 { return 0 - 1 }
    if z3 - z_drop_q != final_z_i64 as i256 { return 0 - 1 }

    let instance_fp = lorenz_i256_step4_instance_fingerprint(
        4, 10, 28, 8, 3, 4294967296, dt_q, dt_r, 4617762706, 7643846696, 4120687759)
    let certificate_fp = lorenz_i256_step4_certificate_fingerprint(
        instance_fp,
        dy_scaled_q_i64, dy_scaled_r_i64, xy_scaled_q_i64, xy_scaled_r_i64,
        beta_q_i64, beta_r_i64, x_inc_q_i64, x_inc_r_i64,
        y_inc_q_i64, y_inc_r_i64, z_drop_q_i64, z_drop_r_i64,
        final_x_i64, final_y_i64, final_z_i64, ok_mask)

    return lorenz_i256_step4_contract_fingerprint(
        instance_fp, certificate_fp, ok_mask, 753371133, 737039167)
}

fn main() -> i64 with Mod {
    let contract_fp = lorenz_i256_step4_certificate_check(
        42949672, 96,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080)

    if contract_fp != 630097760 { return 1 }
    if lorenz_i256_step4_certificate_check(
        42949672, 95,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080) != (0 - 1) { return 2 }
    if lorenz_i256_step4_certificate_check(
        42949672, 96,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 3, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077911, 4092986080) != (0 - 1) { return 3 }
    if lorenz_i256_step4_certificate_check(
        42949672, 96,
        124866970867, 1906281842, 8218332706, 3252936400,
        10988500690, 2, 302608392, 1014364768,
        1172231215, 2184377272, 27701679, 948411264,
        4920371098, 8816077912, 4092986080) != (0 - 1) { return 4 }
    if lorenz_i256_step4_contract_fingerprint(
        924803514, 700498889, 126, 753371133, 737039167) != (0 - 1) { return 5 }

    return 0
}
