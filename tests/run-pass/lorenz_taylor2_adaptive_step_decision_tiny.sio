//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz Taylor-2 adaptive step decision over the v45 policy guard

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn adaptive_step_action(
    remainder_fill_ppm: i64,
    shrink_limit_ppm: i64,
    grow_limit_ppm: i64,
    min_after_slack: i64,
    min_after_slack_limit: i64,
    grow_min_after_slack: i64,
    total_after_slack: i64,
    total_after_slack_limit: i64,
    grow_total_after_slack: i64,
    validation_mask: i64) -> i64 {
    if validation_mask != 127 { return 0 }
    if min_after_slack < 0 { return 0 }
    if total_after_slack < 0 { return 0 }
    if remainder_fill_ppm > shrink_limit_ppm { return 1 }
    if min_after_slack < min_after_slack_limit { return 1 }
    if total_after_slack < total_after_slack_limit { return 1 }
    if remainder_fill_ppm <= grow_limit_ppm {
        if min_after_slack >= grow_min_after_slack {
            if total_after_slack >= grow_total_after_slack {
                return 3
            }
        }
    }
    return 2
}

fn adaptive_step_decision_fingerprint(policy_fp: i64, audit_fp: i64) -> i64 {
    if policy_fp != 403306384 { return 0 - 1 }
    if audit_fp != 635367450 { return 0 - 1 }

    let action = adaptive_step_action(
        13149, 20000, 5000,
        5225, 5000, 7000,
        19289, 19000, 25000,
        127)
    if action != 2 { return 0 - 1 }

    var fp: i64 = 569
    fp = quality_mix(fp, policy_fp)
    fp = quality_mix(fp, audit_fp)
    fp = quality_mix(fp, 486061656)
    fp = quality_mix(fp, 85088711)
    fp = quality_mix(fp, 498384393)
    fp = quality_mix(fp, 13149)
    fp = quality_mix(fp, 986851)
    fp = quality_mix(fp, 63)
    fp = quality_mix(fp, 20000)
    fp = quality_mix(fp, 5000)
    fp = quality_mix(fp, 5225)
    fp = quality_mix(fp, 5000)
    fp = quality_mix(fp, 7000)
    fp = quality_mix(fp, 19289)
    fp = quality_mix(fp, 19000)
    fp = quality_mix(fp, 25000)
    fp = quality_mix(fp, action)
    fp = quality_mix(fp, 1)
    fp = quality_mix(fp, 1)
    fp = quality_mix(fp, 1)
    fp = quality_mix(fp, 2)
    fp = quality_mix(fp, 3)
    fp = quality_mix(fp, 2)
    return fp
}

fn adaptive_step_decision_audit_fingerprint(decision_fp: i64) -> i64 {
    if decision_fp != 120259197 { return 0 - 1 }

    var fp: i64 = 571
    fp = quality_mix(fp, decision_fp)
    fp = quality_mix(fp, 403306384)
    fp = quality_mix(fp, 635367450)
    fp = quality_mix(fp, 486061656)
    fp = quality_mix(fp, 85088711)
    fp = quality_mix(fp, 498384393)
    fp = quality_mix(fp, 2)
    fp = quality_mix(fp, 63)
    return fp
}

fn main() -> i64 {
    if adaptive_step_action(13149, 20000, 5000, 5225, 5000, 7000, 19289, 19000, 25000, 127) != 2 { return 1 }
    if adaptive_step_action(25000, 20000, 5000, 5225, 5000, 7000, 19289, 19000, 25000, 127) != 1 { return 2 }
    if adaptive_step_action(4000, 20000, 5000, 8000, 5000, 7000, 26000, 19000, 25000, 127) != 3 { return 3 }
    if adaptive_step_action(4000, 20000, 5000, 8000, 5000, 7000, 26000, 19000, 25000, 126) != 0 { return 4 }
    if adaptive_step_action(4000, 20000, 5000, 4000, 5000, 7000, 26000, 19000, 25000, 127) != 1 { return 5 }

    let fp = adaptive_step_decision_fingerprint(403306384, 635367450)
    if fp != 120259197 { return 6 }
    let audit_fp = adaptive_step_decision_audit_fingerprint(fp)
    if audit_fp != 471466754 { return 7 }

    if adaptive_step_decision_fingerprint(403306385, 635367450) != (0 - 1) { return 8 }
    if adaptive_step_decision_audit_fingerprint(120259198) != (0 - 1) { return 9 }
    return 0
}
