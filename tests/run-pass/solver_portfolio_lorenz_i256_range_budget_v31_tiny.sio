//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v31 smoke for Lorenz i256 range-budget entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 {
    if kind != 34 { return 0 - 1 }
    if instance_fp != 87220662 { return 0 - 1 }
    if certificate_fp != 323169628 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 34 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn range_budget_audit_fingerprint(range_budget_fp: i64,
                                  bridge_instance_fp: i64,
                                  projection_inclusion_fp: i64,
                                  ball_fixed_enclosure_fp: i64,
                                  bit_headroom: i64,
                                  readiness_mask: i64) -> i64 {
    if range_budget_fp != 87220662 { return 0 - 1 }
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if bit_headroom != 184 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 307
    fp = portfolio_mix(fp, range_budget_fp, 2531)
    fp = portfolio_mix(fp, bridge_instance_fp, 2531)
    fp = portfolio_mix(fp, projection_inclusion_fp, 2531)
    fp = portfolio_mix(fp, ball_fixed_enclosure_fp, 2531)
    fp = portfolio_mix(fp, bit_headroom, 2531)
    fp = portfolio_mix(fp, readiness_mask, 2531)
    return fp
}

fn portfolio_v31_fingerprint(range_budget_entry_fp: i64) -> i64 {
    if range_budget_entry_fp != 116461241 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 31, 1151)
    fp = portfolio_mix(fp, 35, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, 3812644, 1151)
    fp = portfolio_mix(fp, 777068644, 1151)
    fp = portfolio_mix(fp, 423305090, 1151)
    fp = portfolio_mix(fp, 63872871, 1151)
    fp = portfolio_mix(fp, 547731575, 1151)
    fp = portfolio_mix(fp, 620031252, 1151)
    fp = portfolio_mix(fp, 916832909, 1151)
    fp = portfolio_mix(fp, 786321129, 1151)
    fp = portfolio_mix(fp, range_budget_entry_fp, 1151)
    return fp
}

fn result_coverage_fingerprint(manifest_fp: i64) -> i64 {
    if manifest_fp != 628994509 { return 0 - 1 }
    var fp: i64 = 131
    fp = portfolio_mix(fp, 31, 1871)
    fp = portfolio_mix(fp, 35, 1871)
    fp = portfolio_mix(fp, 10, 1871)
    fp = portfolio_mix(fp, 23, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn family_coverage_fingerprint(manifest_fp: i64) -> i64 {
    if manifest_fp != 628994509 { return 0 - 1 }
    var fp: i64 = 149
    fp = portfolio_mix(fp, 31, 1907)
    fp = portfolio_mix(fp, 35, 1907)
    fp = portfolio_mix(fp, 6, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 22, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn main() -> i64 {
    let audit_fp = range_budget_audit_fingerprint(
        87220662, 149359034, 890086395, 166945519, 184, 31)
    if audit_fp != 323169628 { return 1 }

    let entry_fp = portfolio_entry_fingerprint(34, 87220662, audit_fp, 1, 34)
    if entry_fp != 116461241 { return 2 }

    let manifest_fp = portfolio_v31_fingerprint(entry_fp)
    if manifest_fp != 628994509 { return 3 }

    let result_fp = result_coverage_fingerprint(manifest_fp)
    if result_fp != 322111452 { return 4 }

    let family_fp = family_coverage_fingerprint(manifest_fp)
    if family_fp != 379191739 { return 5 }

    if portfolio_entry_fingerprint(34, 87220662, audit_fp, 0, 34) != (0 - 1) { return 6 }
    if range_budget_audit_fingerprint(
        87220662, 149359034, 890086396, 166945519, 184, 31) != (0 - 1) { return 7 }
    if result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 8 }

    return 0
}
