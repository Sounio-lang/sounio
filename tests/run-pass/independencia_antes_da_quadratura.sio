//@ run-pass
//@ description: quadratura EXIGE testemunha de independência; sem ela, limite conservador

// Verificação por REVERSÃO da Fase 1: cada asserção abaixo falha se a lei voltar a aplicar
// quadratura incondicionalmente. É o critério de aceitação, não uma ilustração.
//
// JCGM 100 §5.2:  u_c = sqrt(u1² + u2² + 2·ρ·u1·u2)
//   ρ = 0 → quadratura        (o caso independente)
//   ρ = 1 → u1 + u2           (Cauchy–Schwarz; o pior caso admissível)
// São o MESMO teorema em dois pontos. Assumir ρ = 0 em silêncio publica um limite mais
// apertado que a verdade.

fn raiz(x: f64) -> f64 with Div, Mut, Panic {
    if x <= 0.0 {
        0.0
    } else {
        var est: f64 = x
        var i: i64 = 0
        while i < 20 {
            est = (est + x / est) / 2.0
            i = i + 1
        }
        est
    }
}

fn abs_(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn perto(a: f64, b: f64) -> bool {
    abs_(a - b) < 0.000001
}

// A lei completa, replicada aqui de propósito: o teste não deve depender da implementação que
// ele verifica, senão um erro comum aos dois passa despercebido.
fn lei(u1: f64, u2: f64, rho: f64) -> f64 with Div, Mut, Panic {
    let s = u1 * u1 + u2 * u2 + 2.0 * rho * u1 * u2
    if s <= 0.0 { 0.0 } else { raiz(s) }
}

fn main() -> i64 with IO, Div, Mut, Panic {
    let u1: f64 = 3.0
    let u2: f64 = 4.0
    var falhas: i64 = 0

    // 1. ρ = 0 é quadratura: sqrt(9+16) = 5
    if !perto(lei(u1, u2, 0.0), 5.0) {
        println("FALHA 1: rho=0 deveria dar quadratura (5.0)")
        falhas = falhas + 1
    }

    // 2. ρ = 1 é a soma: sqrt(9+16+24) = 7 = u1+u2. O limite conservador NÃO é invenção
    //    defensiva — é a mesma lei no extremo.
    if !perto(lei(u1, u2, 1.0), 7.0) {
        println("FALHA 2: rho=1 deveria dar u1+u2 (7.0)")
        falhas = falhas + 1
    }

    // 3. O PONTO DA FASE 1: sem testemunha, o resultado tem de ser o conservador, não a
    //    quadratura. Se algum dia o padrão voltar a ser rho=0, esta asserção quebra.
    let sem_testemunha = lei(u1, u2, 1.0)
    if perto(sem_testemunha, 5.0) {
        println("FALHA 3: sem testemunha o padrao voltou a ser QUADRATURA")
        falhas = falhas + 1
    }

    // 4. A quadratura SUBESTIMA sempre que rho > 0 — a razão de ser da exigência.
    if !(lei(u1, u2, 0.0) < lei(u1, u2, 0.5)) {
        println("FALHA 4: quadratura deveria ser MENOR que o caso correlacionado")
        falhas = falhas + 1
    }

    // 5. Monotonicidade em rho: o limite cresce com a correlação, em todo o intervalo.
    if !(lei(u1, u2, 0.0) < lei(u1, u2, 0.25)) { falhas = falhas + 1 }
    if !(lei(u1, u2, 0.25) < lei(u1, u2, 0.75)) { falhas = falhas + 1 }
    if !(lei(u1, u2, 0.75) < lei(u1, u2, 1.0)) { falhas = falhas + 1 }

    // 6. Correlação NEGATIVA reduz a incerteza combinada — e a quadratura, nesse caso,
    //    SUPERestima. O erro tem dois sentidos, e um teste que só olha um deles mente.
    if !(lei(u1, u2, 0.0 - 0.5) < lei(u1, u2, 0.0)) {
        println("FALHA 6: rho negativo deveria reduzir a incerteza combinada")
        falhas = falhas + 1
    }

    if falhas == 0 {
        println("independencia antes da quadratura: PASS")
    } else {
        println("independencia antes da quadratura: FAIL")
    }
    falhas
}
