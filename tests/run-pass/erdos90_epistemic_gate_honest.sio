//@ run-pass
//@ expect-stdout: ERDOS90_EPISTEMIC_GATE_PASS

// Honest Epistemic(N) gate: precise coordinates (σ_coord=0.005) support a
// high-confidence summary at Epistemic(900).

fn certified_edge_ok() -> i64 with Epistemic(900), IO, Mut, Div, Epistemic {
    let unc = 0.005
    let ax = measure(2.0, uncertainty: unc)
    let ay = measure(2.0, uncertainty: unc)
    let bx = measure(3.0, uncertainty: unc)
    let by = measure(2.0, uncertainty: unc)
    let dx = ax.value - bx.value
    let dy = ay.value - by.value
    let d2 = dx * dx + dy * dy
    if d2 > 0.0 { return 1 } else { return 0 }
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let ok = certified_edge_ok()
    print("ERDOS90_EPISTEMIC_GATE_PASS\n")
    if ok == 1 { return 0 } else { return 1 }
}