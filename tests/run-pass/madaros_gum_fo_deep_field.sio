//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_DEEP_FIELD_PASS
//@ requires: madaros
// Madaros PASSES this as of the call-result FO work on #1706; lean_single does
// not. The annotation names a real engine boundary rather than hiding a failure:
// the fix lives in self-hosted/ir/lower.sio, and CI's suite compiles with
// souc-stage2, built from self-hosted/compiler/lean_single.sio -- a separate
// compiler that shares none of it.

// Deep call-result field FO — nests beyond the historical mid1/mid2 ceiling.
// Residual was make().c.b.a.x → FO 0 (three intermediate fields + leaf).
// Ident-rooted chains of any depth already peeled; this gate freezes Call paths.

struct A {
    x: f64
}

struct B {
    a: A
}

struct C {
    b: B
}

struct D {
    c: C
    v0: f64
}

struct Holder {
    seed: f64
}

fn make_d(x: f64, v0: f64) -> D {
    D { c: C { b: B { a: A { x: x } } }, v0: v0 }
}

fn id_d(d: D) -> D {
    d
}

impl Holder {
    fn make(self: &Holder, x: f64) -> C {
        C { b: B { a: A { x: x } } }
    }
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kv: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let x = kx.value
    let v0 = kv.value

    let d = D { c: C { b: B { a: A { x: x } } }, v0: v0 }
    let v_chain = variance_of(d.c.b.a.x)
    let v_flat = variance_of(d.v0)
    let v_call = variance_of(make_d(x, v0).c.b.a.x)
    let v_call_flat = variance_of(make_d(x, v0).v0)
    let v_id = variance_of(id_d(d).c.b.a.x)
    let v_id_nest = variance_of(id_d(make_d(x, v0)).c.b.a.x)
    let h = Holder { seed: 0.0 }
    let v_meth = variance_of(h.make(x).b.a.x)
    let v_peel = variance_of(x)

    print("v_chain="); print_f64(v_chain); print("\n")
    print("v_call="); print_f64(v_call); print("\n")
    print("v_call_flat="); print_f64(v_call_flat); print("\n")
    print("v_id="); print_f64(v_id); print("\n")
    print("v_id_nest="); print_f64(v_id_nest); print("\n")
    print("v_meth="); print_f64(v_meth); print("\n")
    print("v_flat="); print_f64(v_flat); print("\n")

    let ok = abs_f(v_chain - v_peel) < 1.0e-9
        && abs_f(v_chain - 0.09) < 1.0e-9
        && abs_f(v_call - v_peel) < 1.0e-9
        && abs_f(v_call_flat - 4.0) < 1.0e-9
        && abs_f(v_id - v_peel) < 1.0e-9
        && abs_f(v_id_nest - v_peel) < 1.0e-9
        && abs_f(v_meth - v_peel) < 1.0e-9
        && abs_f(v_flat - 4.0) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_DEEP_FIELD_PASS\n")
    } else {
        print("MADAROS_GUM_FO_DEEP_FIELD_FAIL\n")
    }
}
