        0x1A, 0x64, 0x62, 0x3C, 0x1A, 0x31, 0xD3, 0x6A, 0x8E, 0x74, 0xFF, 0xDC,
        0xA8, 0x6E, 0x96, 0x23, 0x72, 0x2D, 0xCD, 0xE9, 0x7F, 0x21, 0x94, 0x33,
        0x1B, 0xD7, 0x8C, 0x6C, 0x1D, 0x71, 0xB0, 0xED, 0xB2, 0x33, 0x1F, 0x71,
        0x13, 0xAA, 0x23, 0x43, 0x2A, 0x3C, 0x20, 0x2E, 0xAD, 0x95, 0x14, 0x22,
        0x25, 0xAC, 0x89, 0x55, 0x8E, 0x7A, 0xE6, 0x0B, 0x3F, 0x49, 0x89, 0xC7,
        0xE8, 0x6B, 0x03, 0x62, 0xD7, 0x10, 0xED, 0xE1, 0x21, 0x16, 0x5C, 0x20,
        0x61, 0x42, 0x68, 0xE8, 0x8A, 0xDB,
    ]

    let leaf_der_len: i64 = 826
    let leaf_der_bytes: [u8; 826] = [
        0x30, 0x82, 0x03, 0x36, 0x30, 0x82, 0x02, 0x1E, 0xA0, 0x03, 0x02, 0x01,
        0x02, 0x02, 0x14, 0x2D, 0xB4, 0xB7, 0x2D, 0x45, 0x16, 0x71, 0xEB, 0x18,
        0xCF, 0x27, 0x20, 0xD1, 0x93, 0x80, 0x36, 0x74, 0x5C, 0x89, 0x5C, 0x30,
        0x0D, 0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0B,
        0x05, 0x00, 0x30, 0x1F, 0x31, 0x1D, 0x30, 0x1B, 0x06, 0x03, 0x55, 0x04,
        0x03, 0x0C, 0x14, 0x54, 0x65, 0x73, 0x74, 0x20, 0x49, 0x6E, 0x74, 0x65,
