//@ run-pass
//@ requires: madaros

// Regression test for the combined Finding 1 + Finding 2 fix-round scenario
// (task-3-report.md fix round).
//
// Pool construction (all in-memory `Certificate` values built directly via
// `certificate_zero()` + field assignment for the synthetic links -- no
// second openssl invocation needed for those, since chain_build_candidates'
// issuer-matching logic here only inspects `subject`/`issuer`
// (`X509Name`) and AKI/SKI fields, never the raw DER buffer):
//
//   - `leaf`, `inter` (real intermediate), `root`: the SAME openssl-generated
//     3-level chain as x509_chain_path_building.sio.
//   - `c1`: adversarial, SELF-REFERENTIAL synthetic cert. `c1.subject`
//     is copied from `leaf.issuer` (so it collides with, and is scanned
//     before, the real intermediate as a candidate issuer for the leaf --
//     it occupies pool slot 0, `inter` occupies the LAST intermediate
//     slot). `c1.issuer` is ALSO set to that same value, i.e.
//     `c1.issuer == c1.subject`: a textbook self-referential cert
//     (matches itself as its own issuer).
//   - `c2`: shares `c1`'s Subject DN too (so `c1`, searching for its own
//     issuer, finds BOTH itself -- the Finding 2 bug -- and `c2` as
//     candidates), but `c2.issuer` is a fresh, unique synthetic DN that
//     only `c3` shares as its Subject.
//   - `c3..c9`: a strictly LINEAR, non-branching, non-terminating
//     synthetic chain (`c3.issuer == c4.subject`, `c4.issuer == c5.subject`,
//     ..., `c9.issuer` matches nothing at all -- a dead end).
//
// Why this exact shape and not N literal duplicates of one cert: an
// earlier draft of this test used 5 copies of a single self-referential
// cert. Empirically (`souc run`, see the fix report) that construction
// still failed as a regression test -- under the FIXED code it triggered a
// combinatorial explosion of candidate subsets/orderings across the 5
// interchangeable duplicates, filling `MAX_CHAIN_CANDIDATES` (16) before
// the direct `leaf -> inter -> root` path was ever reached, so the
// assertion below would have failed even on CORRECT code. The
// `c1`-self-plus-`c2` / `c3..c9`-strictly-linear shape used here bounds
// the branching to exactly two small decision points (depth 1: `c1` vs
// `inter`; depth 2, only reached via `c1`: self-match vs `c2`) while still
// reproducing the literal bug mechanics -- confirmed by hand-tracing AND
// by instrumented runs against both the pre-fix and post-fix `chain.sio`
// (see the fix report for the full trace and the actual debug output).
//
// Hand-traced/measured pre-fix (buggy) behavior: depth grows
// leaf(1) -> c1(2) -> c1 AGAIN via the Finding 2 self-match bug (3) ->
// c2(4) -> c3(5) -> c4(6) -> c5(7) -> c6(8) -> c7(9) -> c8(10) -> c9(11).
// At depth 11 (`> CHAIN_MAX_DEPTH`), the pre-fix outer while-loop condition
// `depth <= CHAIN_MAX_DEPTH` goes false and the WHOLE FUNCTION returns
// immediately -- Finding 1's bug -- with `result_count == 0`, even though
// `inter` (the real intermediate) was sitting untried as depth 1's second
// candidate the entire time. Confirmed empirically: running this exact
// pool against the pre-fix `chain.sio` (via `git show HEAD:...` before the
// fix commit) prints `7` (this test's `count < 1` failure branch) and
// exits 1.
//
// Post-fix, expected behavior: Finding 2's fix means `c1` can never match
// itself (excluded as soon as it's chosen), so the DFS finds `c2` directly
// instead of self-looping; Finding 1's fix means the `c3..c9` dead-end
// branch backtracks instead of aborting when it dead-ends (zero
// candidates at `c9`, `n == 0`, ordinary exhaustion, no depth-cap even
// invoved on THAT branch); backtracking eventually returns to depth 1 and
// finds `inter -> root` directly. This test asserts the real `len == 3`
// (`leaf -> inter -> root`) candidate is present in the result set.

use x509::chain::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

fn synth_name(tag: u8) -> X509Name {
    var n = x509_name_zero()
    var value: [u8; 128] = [0; 128]
    value[0] = tag
    n.entries[0] = RdnEntry { oid: [0; 20], oid_len: 0, value_tag: 12, value: value, value_len: 1 }
    n.count = 1
    n
}

