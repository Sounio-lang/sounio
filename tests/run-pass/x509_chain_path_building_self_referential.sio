        0x30, 0x09, 0x06, 0x03, 0x55, 0x1D, 0x13, 0x04, 0x02, 0x30, 0x00, 0x30,
        0x1D, 0x06, 0x03, 0x55, 0x1D, 0x11, 0x04, 0x16, 0x30, 0x14, 0x82, 0x12,
        0x63, 0x68, 0x61, 0x69, 0x6E, 0x2D, 0x74, 0x65, 0x73, 0x74, 0x2E, 0x65,
        0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65, 0x30, 0x1D, 0x06, 0x03, 0x55, 0x1D,
        0x0E, 0x04, 0x16, 0x04, 0x14, 0xB2, 0x49, 0x66, 0x66, 0x8B, 0x89, 0x8C,
        0xAB, 0x1B, 0xEA, 0x8A, 0x4E, 0xD9, 0xD2, 0xF5, 0xCF, 0xDE, 0x89, 0xC2,
        0x6F, 0x30, 0x1F, 0x06, 0x03, 0x55, 0x1D, 0x23, 0x04, 0x18, 0x30, 0x16,
        0x80, 0x14, 0x43, 0x43, 0x1F, 0x22, 0xC9, 0xFE, 0xAE, 0xFF, 0x70, 0x78,
        0xE7, 0xBD, 0xAC, 0xC8, 0xEC, 0x4B, 0xA3, 0xAC, 0x26, 0xA4, 0x30, 0x0D,
        0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D, 0x01, 0x01, 0x0B, 0x05,
        0x00, 0x03, 0x82, 0x01, 0x01, 0x00, 0x53, 0x8E, 0x24, 0xC0, 0xFB, 0xFD,
        0x07, 0xE8, 0x69, 0x34, 0xAF, 0x53, 0xB9, 0xE6, 0xA1, 0x35, 0x91, 0x5D,
        0xFA, 0x7F, 0x63, 0x4E, 0x0B, 0xD7, 0xBD, 0x53, 0x02, 0x6C, 0xED, 0x2F,
        0x65, 0xDB, 0x08, 0x2A, 0x70, 0x66, 0x1F, 0xCC, 0x13, 0x83, 0xD6, 0x79,
        0xC7, 0xAF, 0x44, 0x67, 0xF4, 0x09, 0xBF, 0x19, 0x72, 0xE1, 0xF6, 0xA0,
        0x95, 0x52, 0xE1, 0x1F, 0xB2, 0xB4, 0x24, 0x9B, 0xCB, 0xF9, 0xA2, 0xE1,
        0x47, 0xD7, 0x9C, 0xD1, 0x34, 0xFE, 0xCB, 0x4B, 0xA3, 0x17, 0xE0, 0x47,
        0x2F, 0x61, 0xBC, 0xF0, 0xA6, 0x76, 0xD9, 0x2A, 0x33, 0xEC, 0xE4, 0xF9,
        0x2E, 0xF4, 0x2E, 0xB3, 0x69, 0x6C, 0xAB, 0xC0, 0xF3, 0xE0, 0x53, 0xFE,
        0x1A, 0x46, 0x22, 0x5D, 0x61, 0x19, 0x00, 0x97, 0x23, 0xBC, 0xC1, 0x9B,
        0x85, 0x63, 0xE1, 0x80, 0xAC, 0x0B, 0x2A, 0x40, 0xD2, 0x95, 0xA2, 0xBB,
        0xD1, 0x42, 0x3F, 0x1A, 0x82, 0x3E, 0xEC, 0x42, 0x29, 0x9A, 0x5B, 0xFC,
        0x19, 0xFE, 0x53, 0x76, 0xBB, 0xCA, 0xD0, 0x54, 0xAE, 0x8B, 0x6D, 0xCD,
        0x87, 0xBC, 0xED, 0xE7, 0x1A, 0x55, 0x81, 0x57, 0x34, 0xC9, 0x0F, 0x4C,
        0xE4, 0x42, 0x6F, 0x45, 0xD1, 0x37, 0xCD, 0x1B, 0x8E, 0x3F, 0x2D, 0x6B,
        0x42, 0x43, 0x5C, 0x99, 0x68, 0x90, 0x4F, 0x64, 0xE5, 0x30, 0x0B, 0x20,
        0x36, 0xCE, 0x54, 0x38, 0x9D, 0x68, 0x91, 0xA9, 0x84, 0x6B, 0x09, 0x93,
        0xA6, 0xF6, 0xE2, 0x28, 0x0C, 0x5B, 0x99, 0xE5, 0x9C, 0x4A, 0x6F, 0x74,
        0xEA, 0xB0, 0xA0, 0x1C, 0xBE, 0x17, 0x8E, 0x32, 0x0A, 0x79, 0x73, 0x76,
        0xD1, 0x76, 0x48, 0x4D, 0x08, 0xEE, 0x1E, 0x54, 0x4A, 0xC3, 0x95, 0x27,
        0x0C, 0x47, 0xD7, 0x15, 0x8E, 0x8D, 0xF7, 0xEA, 0xDB, 0x4A, 0xAF, 0x2B,
        0x81, 0x9B, 0xFF, 0xC3, 0x78, 0x79, 0xA8, 0x53, 0x29, 0xE1,
    ]

    let root_buf = rawbuf_new(root_der_len + 8)
    var i: i64 = 0
    while i < root_der_len { rawbuf_set(&root_buf, i, root_der_bytes[i as usize] as i64); i = i + 1 }
    let inter_buf = rawbuf_new(inter_der_len + 8)
    var j: i64 = 0
    while j < inter_der_len { rawbuf_set(&inter_buf, j, inter_der_bytes[j as usize] as i64); j = j + 1 }
    let leaf_buf = rawbuf_new(leaf_der_len + 8)
    var k: i64 = 0
    while k < leaf_der_len { rawbuf_set(&leaf_buf, k, leaf_der_bytes[k as usize] as i64); k = k + 1 }

    var root_cert = certificate_zero()
    let (root_cert_raw, e1) = x509_parse_certificate(&root_buf, root_der_len)
    root_cert = root_cert_raw
    if e1 != X509_OK { print_int(1); return 1 }

    var inter_cert = certificate_zero()
    let (inter_cert_raw, e2) = x509_parse_certificate(&inter_buf, inter_der_len)
    inter_cert = inter_cert_raw
    if e2 != X509_OK { print_int(2); return 1 }

    var leaf_cert = certificate_zero()
    let (leaf_cert_raw, e3) = x509_parse_certificate(&leaf_buf, leaf_der_len)
    leaf_cert = leaf_cert_raw
    if e3 != X509_OK { print_int(3); return 1 }

    // dn0 is the REAL intermediate's own Subject DN (== leaf's Issuer DN).
    let dn0 = leaf_cert.issuer
    if !x509_name_eq(&dn0, &inter_cert.subject) { print_int(4); return 1 }

    let dn2 = synth_name(2)
    let dn3 = synth_name(3)
    let dn4 = synth_name(4)
    let dn5 = synth_name(5)
    let dn6 = synth_name(6)
    let dn7 = synth_name(7)
    let dn8 = synth_name(8)
    let dn9 = synth_name(9)

    // c1: self-referential adversarial cert -- subject == issuer == dn0.
    // Matches the leaf (subject == leaf.issuer) AND matches itself as its
    // own issuer (the Finding 2 bug).
    var c1 = certificate_zero()
    c1.subject = dn0
    c1.issuer = dn0

    // c2: also collides on dn0 (so c1's issuer search, once self-match is
    // correctly excluded, finds c2 as its ONLY remaining legitimate
    // candidate instead of looping), but has its OWN unique forward link.
    var c2 = certificate_zero()
    c2.subject = dn0
    c2.issuer = dn2

    // c3..c9: strictly linear, non-branching, non-terminating synthetic
    // chain. c9's issuer (dn9) matches nothing in the pool -- a dead end.
    var c3 = certificate_zero()
    c3.subject = dn2
    c3.issuer = dn3
    var c4 = certificate_zero()
    c4.subject = dn3
    c4.issuer = dn4
    var c5 = certificate_zero()
    c5.subject = dn4
    c5.issuer = dn5
    var c6 = certificate_zero()
    c6.subject = dn5
    c6.issuer = dn6
    var c7 = certificate_zero()
    c7.subject = dn6
    c7.issuer = dn7
    var c8 = certificate_zero()
    c8.subject = dn7
    c8.issuer = dn8
    var c9 = certificate_zero()
    c9.subject = dn8
    c9.issuer = dn9

    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = root_cert
    store.bufs[0] = root_buf
    // c8, c9 overflow into the trust_store tail of the pool (not
    // themselves trusted roots -- their subjects never match the store's
    // own root lookup -- this just reuses the pool-concatenation mechanism
    // to fit more than MAX_INTERMEDIATES=8 pool entries).
    store.certs[1] = c8
    store.bufs[1] = rawbuf_new(1)
    store.certs[2] = c9
    store.bufs[2] = rawbuf_new(1)
    store.count = 3

    // Pool order: c1 (adversarial, self-referential) is scanned FIRST,
    // well before the real intermediate (last intermediate slot).
    var intermediates: [Certificate; 8] = [certificate_zero(); 8]
    var intermediate_bufs: [RawBuf; 8] = [rawbuf_new(1); 8]
    intermediates[0] = c1
    intermediate_bufs[0] = rawbuf_new(1)
    intermediates[1] = c2
    intermediate_bufs[1] = rawbuf_new(1)
    intermediates[2] = c3
    intermediate_bufs[2] = rawbuf_new(1)
    intermediates[3] = c4
    intermediate_bufs[3] = rawbuf_new(1)
    intermediates[4] = c5
    intermediate_bufs[4] = rawbuf_new(1)
    intermediates[5] = c6
    intermediate_bufs[5] = rawbuf_new(1)
    intermediates[6] = c7
    intermediate_bufs[6] = rawbuf_new(1)
    intermediates[7] = inter_cert
    intermediate_bufs[7] = inter_buf

    let (candidates, count) = chain_build_candidates(&leaf_cert, &leaf_buf, &intermediates, &intermediate_bufs, 8, &store)
    if count < 1 {
        // This is exactly the pre-fix-round failure mode: a validly
        // chained leaf certificate producing ZERO candidates because the
        // adversarial self-referential entry drove the search past
        // CHAIN_MAX_DEPTH before the real intermediate was ever tried.
        print_int(7)
        return 1
    }

    // The real leaf -> real intermediate -> root candidate (len == 3) must
    // still be found despite the adversarial self-referential entry and
    // the long synthetic dead-end chain sitting ahead of it in the pool.
    var found_real_path: bool = false
    var c: i32 = 0
    while c < count {
        if candidates[c as usize].len == 3 {
            found_real_path = true
        }
        c = c + 1
    }
    if !found_real_path {
        print_int(8)
        return 1
    }

    println("x509_chain_path_building_self_referential: found real path despite adversarial self-referential entry")
    return 0
}
