//@ run-pass
//@ requires: madaros
//@ expect-stdout: r-origin: PASS
//
// Positive control for r_origin_measured_on_sum.sio. The SAME sum, ascribed
// Derived, is legal -- and must stay legal, or R-ORIGIN has banned arithmetic
// on Knowledge values instead of banning the false claim about it.
//
// Computed on an arithmetic result is a ruling owed and is deliberately NOT
// exercised here either way.

fn main() -> i64 with IO {
    let a: Knowledge[f64, Measured] = measure(1.0, uncertainty: 0.1)
    let b: Knowledge[f64, Measured] = measure(2.0, uncertainty: 0.1)
    let s: Knowledge[f64, Derived] = a + b
    println("r-origin: PASS")
    0
}
