//@ run-pass
//@ requires: madaros
//@ expect-stdout: b0 0.000000
//@ expect-stdout: b1 0.090000
//@ expect-stdout: b2 9.000000
//@ expect-stdout: b12 30899047851562496.000000
//@ expect-stdout: bneg 0.000000
//@ expect-stdout: d2 36.000000
//@ expect-stdout: RECUR_POWBASE_OK
// a = 5 +- 0.3, var = 0.09.
// Base 1 is a^n. n = 2 is (2*5)^2 * 0.09. n = 12 is (12 * 5^11)^2 * 0.09.
// Base 2 at n = 2 is (4*5)^2 * 0.09.

fn pb(x: f64, n: i64) -> f64 {
    if n < 1 {
        1.0
    } else {
        x * pb(x, n - 1)
    }
}

fn pb2(x: f64, n: i64) -> f64 {
    if n < 1 {
        2.0
    } else {
        x * pb2(x, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let b0 = variance_of(pb(a, 0))
    let b1 = variance_of(pb(a, 1))
    let b2 = variance_of(pb(a, 2))
    let b12 = variance_of(pb(a, 12))
    let bneg = variance_of(pb(a, 0 - 2))
    let d2 = variance_of(pb2(a, 2))
    print("b0 ")
    print_f64(b0)
    println("")
    print("b1 ")
    print_f64(b1)
    println("")
    print("b2 ")
    print_f64(b2)
    println("")
    print("b12 ")
    print_f64(b12)
    println("")
    print("bneg ")
    print_f64(bneg)
    println("")
    print("d2 ")
    print_f64(d2)
    println("")
    var fails: i64 = 0
    if b0 < 0.0 - 0.000001 || b0 > 0.000001 { fails = fails + 1 }
    if b1 < 0.089999 || b1 > 0.090001 { fails = fails + 1 }
    if b2 < 8.999999 || b2 > 9.000001 { fails = fails + 1 }
    if b12 < 30899047851562000.0 || b12 > 30899047851563000.0 { fails = fails + 1 }
    if bneg < 0.0 - 0.000001 || bneg > 0.000001 { fails = fails + 1 }
    if d2 < 35.999999 || d2 > 36.000001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_POWBASE_OK")
        0
    } else {
        println("RECUR_POWBASE_FAIL")
        1
    }
}
