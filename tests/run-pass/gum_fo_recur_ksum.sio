//@ run-pass
//@ requires: madaros
//@ expect-stdout: k1 0.810000
//@ expect-stdout: k2 7.290000
//@ expect-stdout: k12 25418658283.290001
//@ expect-stdout: q1 1.440000
//@ expect-stdout: kneg 0.090000
//@ expect-stdout: RECUR_KSUM_OK
// a = 5 +- 0.3, var = 0.09.
// A sum of k identical calls is k^n copies of a. k = 3 at n = 1 is 9 * 0.09.
// k = 3 at n = 12 is the same number as the literal coefficient 3.

fn tri(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        tri(x, n - 1) + tri(x, n - 1) + tri(x, n - 1)
    }
}

fn quad(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        quad(x, n - 1) + quad(x, n - 1) + quad(x, n - 1) + quad(x, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let k1 = variance_of(tri(a, 1))
    let k2 = variance_of(tri(a, 2))
    let k12 = variance_of(tri(a, 12))
    let q1 = variance_of(quad(a, 1))
    let kneg = variance_of(tri(a, 0 - 2))
    print("k1 ")
    print_f64(k1)
    println("")
    print("k2 ")
    print_f64(k2)
    println("")
    print("k12 ")
    print_f64(k12)
    println("")
    print("q1 ")
    print_f64(q1)
    println("")
    print("kneg ")
    print_f64(kneg)
    println("")
    var fails: i64 = 0
    if k1 < 0.809999 || k1 > 0.810001 { fails = fails + 1 }
    if k2 < 7.289999 || k2 > 7.290001 { fails = fails + 1 }
    if k12 < 25418658283.29 || k12 > 25418658283.30 { fails = fails + 1 }
    if q1 < 1.439999 || q1 > 1.440001 { fails = fails + 1 }
    if kneg < 0.089999 || kneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_KSUM_OK")
        0
    } else {
        println("RECUR_KSUM_FAIL")
        1
    }
}
