//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v145 smoke for Lorenz i256 step-3-to-step-4 local-flowpipe bridge

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt: i64 = 2087
    receipt = mix(receipt, 692714944, 6113)
    receipt = mix(receipt, 627937430, 6113)
    receipt = mix(receipt, 438456816, 6113)
    receipt = mix(receipt, 198078664, 6113)
