//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_SIZED_SCATTER_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use viz::dynamic_plot::{DynamicPlotSpec}
use viz::dynamic_fields::{dynamic_scatter_canvas_sized,dynamic_scatter_svg_sized}
use viz::scientific_document::{ScientificDocumentText,ScientificOverlayPlan,ScientificOverlayText,scientific_two_panel_plan,scientific_overlay_svg_sized,scientific_overlay_canvas_sized}
use display::canvas::{Canvas,canvas_clear}
fn run_line(radius:i64,index:i64,start:i64,length:i64,color:i64) with IO {
 print("SIZED_RUN ");print(radius);print(" ");print(index);print(" ");print(start);print(" ");print(length);print(" ");println(color)
}
fn raster(c:&Canvas,radius:i64,index:i64) with IO,Mut,Div,Panic {
 var start:i64=0;var color:i64=read_i64(c.pixels,0);var i:i64=1
 while i<32*24 {
  let next:i64=read_i64(c.pixels,i)
  if next!=color {run_line(radius,index,start,i-start,color);start=i;color=next}
  i=i+1
 }
 run_line(radius,index,start,32*24-start,color)
 print("SIZED_RASTER_END ");print(radius);print(" ");println(index)
}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 let xs:[f64;12]=[-1.5,9.5,4.0,4.0,0.0,8.0,4.0,-4.5,12.5,1e308,-1e308,0.0]
 let ys:[f64;12]=[4.0,4.0,-1.5,9.5,0.0,8.0,4.0,4.0,4.0,4.0,4.0,0.0]
 let spec=DynamicPlotSpec{x:10,y:8,w:8,h:8,xmin:0.0,xmax:8.0,ymin:0.0,ymax:8.0,r:70,g:180,b:235,interval_kind:0,level:0.0}
 var x=numeric_buffer_new(1,8);var y=numeric_buffer_new(1,8);var a=integer_buffer_new(1,8)
 let pixels=heap_alloc(32*24*8) as *mut i64;assert((pixels as i64)>0)
 var c=Canvas{pixels:pixels,width:32,height:24}
 var radius:i64=1
 while radius<=4 {
  var j:i64=0
  while j<12 {
   let vx=if j==11 {0.0/0.0}else{xs[j as usize]}
   let vy=if j==11 {0.0/0.0}else{ys[j as usize]}
   let w0=numeric_buffer_set(&!x,0,vx);let w1=numeric_buffer_set(&!y,0,vy);let w2=integer_buffer_set(&!a,0,if j==11 {0}else{1})
   canvas_clear(&!c,7,8,9)
   let result=dynamic_scatter_canvas_sized(&!c,&spec,&x,&y,&a,radius)
   assert(result.status==0)
   raster(&c,radius,j)
   print("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"24\" data-radius=\"");print(radius);print("\" data-case=\"");print(j);println("\">")
   let shown=dynamic_scatter_svg_sized(&spec,&x,&y,&a,radius)
   println("</svg>");assert(shown.status==0 && shown.painted==result.painted)
   j=j+1
  }
  radius=radius+1
 }
 let z0=numeric_buffer_set(&!x,0,4.0);let z1=numeric_buffer_set(&!y,0,4.0);let z2=integer_buffer_set(&!a,0,1)
 let invalid:[i64;3]=[0,5,9223372036854775807]
 canvas_clear(&!c,7,8,9)
 println("SIZED_INVALID_BEGIN")
 var k:i64=0
 while k<3 {
  let bad=dynamic_scatter_svg_sized(&spec,&x,&y,&a,invalid[k as usize])
  let no_paint=dynamic_scatter_canvas_sized(&!c,&spec,&x,&y,&a,invalid[k as usize])
  assert(bad.status==1 && no_paint.status==1);k=k+1
 }
 println("SIZED_INVALID_END")
 var i:i64=0
 while i<32*24 {assert(read_i64(c.pixels,i)==(7*65536+8*256+9));i=i+1}
 // Huge finite subtraction can overflow, but far-outside points never convert to int.
 let huge=DynamicPlotSpec{x:10,y:8,w:8,h:8,xmin:-1e308,xmax:0.0,ymin:0.0,ymax:8.0,r:70,g:180,b:235,interval_kind:0,level:0.0}
 let extreme=numeric_buffer_set(&!x,0,1e308)
 let outside=dynamic_scatter_canvas_sized(&!c,&huge,&x,&y,&a,4)
 assert(outside.status==0 && outside.outside==1 && outside.painted==0)
 // Every active row is preflighted before the first mark, including a late NaN.
 var xx=numeric_buffer_new(2,16);var yy=numeric_buffer_new(2,16);var aa=integer_buffer_new(2,16)
 let n0=numeric_buffer_set(&!xx,0,4.0);let n1=numeric_buffer_set(&!xx,1,0.0/0.0)
 let n2=numeric_buffer_set(&!yy,0,4.0);let n3=numeric_buffer_set(&!yy,1,4.0)
 let n4=integer_buffer_set(&!aa,0,1);let n5=integer_buffer_set(&!aa,1,1)
 println("SIZED_NAN_BEGIN")
 let bad_nan=dynamic_scatter_svg_sized(&spec,&xx,&yy,&aa,3)
 println("SIZED_NAN_END")
 let bad_raster=dynamic_scatter_canvas_sized(&!c,&spec,&xx,&yy,&aa,3)
 assert(bad_nan.status==3 && bad_raster.status==3)
 i=0
 while i<32*24 {assert(read_i64(c.pixels,i)==(7*65536+8*256+9));i=i+1}
 heap_free(c.pixels as *mut i8)
 numeric_buffer_close(xx);numeric_buffer_close(yy);integer_buffer_close(aa)
 // Full scientific composition: asymmetric sizes and global failure atomicity.
 var px=numeric_buffer_new(1,8);var py=numeric_buffer_new(1,8);var bx=numeric_buffer_new(1,8);var by=numeric_buffer_new(1,8)
 let s0=numeric_buffer_set(&!px,0,2.0);let s1=numeric_buffer_set(&!py,0,2.0)
 let s2=numeric_buffer_set(&!bx,0,6.0);let s3=numeric_buffer_set(&!by,0,6.0)
 var empty=integer_buffer_new(0,0)
 let chars:[i8;45]=[115,105,122,101,100,32,112,114,101,102,108,105,103,104,116,108,101,102,116,114,105,103,104,116,114,97,100,105,117,115,32,118,97,108,105,100,97,116,105,111,110,65,66,65,66]
 var bytes=integer_buffer_new(45,45*8);i=0
 while i<45 {let v=integer_buffer_set(&!bytes,i,chars[i as usize] as i64);i=i+1}
 let text=ScientificDocumentText{title_start:0,title_len:15,left_start:15,left_len:4,right_start:19,right_len:5,footer_start:24,footer_len:17};let labels=ScientificOverlayText{document:text,left_first_start:41,left_first_len:1,left_second_start:42,left_second_len:1,right_first_start:43,right_first_len:1,right_second_start:44,right_second_len:1}
 let plan=scientific_two_panel_plan(640,360,0.0,8.0,0.0,8.0,0.0,8.0,0.0,8.0);assert(plan.status==0)
 let overlay=ScientificOverlayPlan{document:plan,left_kind:0,right_kind:0}
 let big=heap_alloc(640*360*8) as *mut i64;assert((big as i64)>0)
 var canvas=Canvas{pixels:big,width:640,height:360};canvas_clear(&!canvas,7,8,9)
 println("GLOBAL_SIZE_INVALID_BEGIN")
 k=0
 while k<3 {
  let no_svg=scientific_overlay_svg_sized(&overlay,&labels,&bytes,&px,&py,&a,&px,&py,&a,&bx,&by,&a,&empty,0,&bx,&by,&a,&empty,0,3,invalid[k as usize])
  let no_canvas=scientific_overlay_canvas_sized(&!canvas,&overlay,&labels,&bytes,&px,&py,&a,&px,&py,&a,&bx,&by,&a,&empty,0,&bx,&by,&a,&empty,0,invalid[k as usize],3)
  assert(no_svg.status==33 && no_canvas.status==33);k=k+1
 }
 println("GLOBAL_SIZE_INVALID_END")
 i=0
 while i<640*360 {assert(read_i64(canvas.pixels,i)==(7*65536+8*256+9));i=i+1}
 let drawn=scientific_overlay_canvas_sized(&!canvas,&overlay,&labels,&bytes,&px,&py,&a,&px,&py,&a,&bx,&by,&a,&empty,0,&bx,&by,&a,&empty,0,2,4)
 assert(drawn.status==0)
 let p0:i64=read_i64(canvas.pixels,192*640+144);let p1:i64=read_i64(canvas.pixels,192*640+145)
 let p2:i64=read_i64(canvas.pixels,134*640+222);let p3:i64=read_i64(canvas.pixels,134*640+223)
 print("GLOBAL_SIZE_PIXELS ");print(p0);print(" ");print(p1);print(" ");print(p2);print(" ");println(p3)
 assert(p0==(70*65536+180*256+235) && p1==(22*65536+28*256+36))
 assert(p2==(235*65536+130*256+70) && p3==(22*65536+28*256+36))
 let svg=scientific_overlay_svg_sized(&overlay,&labels,&bytes,&px,&py,&a,&px,&py,&a,&bx,&by,&a,&empty,0,&bx,&by,&a,&empty,0,2,4);assert(svg.status==0)
 heap_free(canvas.pixels as *mut i8)
 numeric_buffer_close(x);numeric_buffer_close(y);integer_buffer_close(a)
 numeric_buffer_close(px);numeric_buffer_close(py);numeric_buffer_close(bx);numeric_buffer_close(by);integer_buffer_close(empty);integer_buffer_close(bytes)
 println("STDLIB_DEEP_VIZ_SIZED_SCATTER_PASS");0
}
