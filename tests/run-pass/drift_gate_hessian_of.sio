//@ run-pass
//@ requires: madaros

// Drift-gate fixture for the `hessian_of` builtin.
//
// Source marker `call_expr_is_builtin_hessian_of` lives in
// self-hosted/check/check.sio (predicate used at type-check time to
// recognise a Hessian-AD call expression). If the shipped Madaros
// predates that predicate, this fixture fails to type-check under
// `souc check`, and the drift gate row goes BEHIND on this branch.
//
// Hessian of x*x at (j=0, k=1) is 1.0 under the pure product rule; the
// numerical value is not asserted here -- only that the call parses,
// type-checks, and binds to the builtin.

fn main() with IO, Epistemic {
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let x = k.value
    let _h01 = hessian_of(x * x, 0, 1)
}