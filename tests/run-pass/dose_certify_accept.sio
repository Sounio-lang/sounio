//@ run-pass
//@ description: The honest accept path for the typed dose contract. The net's
//@ RUNTIME confidence decides eligibility (epi_runtime_certified); when it clears
//@ the ASHP ε≥0.82 bar, an explicit, source-visible, auditable LITERAL-ε
//@ certification enters the `with Epistemic(820)` prescription gate and compiles.
//@ When it does not clear the bar, the program ABSTAINS — refusal is a first-class
//@ outcome. Method demo of compile-time confidence gates; NOT a dosing engine.

use nn::epi_certify::{ashp_vanco_threshold, epi_runtime_certified}

// The prescription contract, gated at 820/1000 (ε ≥ 0.82). Only a LITERAL-ε
// certification — the clinician's auditable attestation that the net cleared the
// bar — can enter here. (Confirmed unbypassable by compile-fail/dose_contract_bypass.)
fn prescribe_vanco_dose() -> f64 with Epistemic(820), Mut, Div, Panic {
    let dose: Knowledge[f64] = Knowledge(450.0, ε=0.90, prov="net_output_clinician_certified");
    dose.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    let thr = ashp_vanco_threshold()

    // Case 1: a confident net prediction (runtime conf 0.91 ≥ 0.82) → certify+prescribe.
    if epi_runtime_certified(0.91, thr) {
        let d = prescribe_vanco_dose()
        println(d)
        println("PRESCRIBE_CERTIFIED")
    } else {
        println("ABSTAIN")
    }

    // Case 2: an under-confident prediction (runtime conf 0.55 < 0.82) → ABSTAIN.
    if epi_runtime_certified(0.55, thr) {
        println("PRESCRIBE_CERTIFIED")
    } else {
        println("ABSTAIN_LOW_CONFIDENCE")
    }

    println("DOSE_CERTIFY_ACCEPT_PASS")
}
