//@ run-pass
//@ expect-stdout: 42
//@ description: FX-2 capture: perform suspends the body, the clause resumes with 41, and the code after the perform runs with that value (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-2

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        let v = perform Ask.get()
        v + 1
    } with { on get() -> resume(41) return(x) -> x }
    println(r)
    0
}
