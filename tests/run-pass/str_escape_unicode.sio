//@ run-pass
//@ expect-stdout: A
//@ description: `\u{41}` is the Unicode scalar U+0041, written as UTF-8, not the text `u{41}`

fn byte_at(s: string, i: i64) -> i64 {
    let raw = s[i as usize] as i64
    if raw < 0 { raw + 256 } else { raw }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    println("\u{41}")
    let e = "\u{E9}"
    if byte_at(e, 0) != 195 { return 1 }
    if byte_at(e, 1) != 169 { return 1 }
    0
}
