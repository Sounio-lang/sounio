//@ run-pass

fn main() -> i32 with IO, Epistemic, Div, Panic, Mut {
    let x = measure(4.0, uncertainty: 0.1)
    let y_sq = measure(2.0, uncertainty: 0.1)
    let z_ln = measure(1.0, uncertainty: 0.1)

    // Test sqrt: ∂sqrt(x)/∂x = 1/(2·sqrt(x)) = 1/(2·2) = 0.25
    let sq = sqrt(x.value)
    let s_sq = sensitivity_of(sq, 0)
    assert(s_sq > 0.249 && s_sq < 0.251)

    // Test exp: ∂exp(y)/∂y = exp(y) = exp(2) ≈ 7.389
    let e = exp(y_sq.value)
    let s_exp = sensitivity_of(e, 1)
    assert(s_exp > 7.38 && s_exp < 7.40)

    // Test ln: ∂ln(x)/∂x = 1/x = 1/4 = 0.25
    let l = ln(x.value)
    let s_ln = sensitivity_of(l, 0)
    assert(s_ln > 0.249 && s_ln < 0.251)

    // Test ln at z=1: ∂ln(z)/∂z = 1/1 = 1.0
    let lz = ln(z_ln.value)
    let s_lz = sensitivity_of(lz, 2)
    assert(s_lz > 0.999 && s_lz < 1.001)

    0
}
