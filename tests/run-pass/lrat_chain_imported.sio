//@ run-pass
//@ description: Imported LRAT/RUP proof-chain smoke using derived unit and empty clause wrappers

use theorem::lrat::*

fn main() -> i64 with Mut {
    lrat_reset()

    if lrat_add_clause4(1, 1, 2, 0, 0, 2) != 1 { return 1 }       // x OR y
    if lrat_add_clause4(2, 0 - 1, 0, 0, 0, 1) != 1 { return 2 }   // -x
    if lrat_add_clause4(3, 0 - 2, 0, 0, 0, 1) != 1 { return 3 }   // -y

    if lrat_check_unit_rup4(2, 1, 2, 0, 0, 2) != 1 { return 4 }
    if lrat_add_unit_rup4(4, 2, 1, 2, 0, 0, 2) != 1 { return 5 }
    if lrat_has_active(4) != 1 { return 6 }

    if lrat_check_empty_rup4(4, 3, 0, 0, 2) != 1 { return 7 }
    if lrat_add_empty_rup4(5, 4, 3, 0, 0, 2) != 1 { return 8 }
    if lrat_has_active(5) != 1 { return 9 }

    return 0
}
