//@ run-pass
//@ requires: madaros
//@ expect-stdout: USER_STRUCT_BOX_OK
//@ description: a user `struct Box` is the user's type, not the builtin Box<T> (#2828)
//
// Madaros lowering recognised the builtin Box<T> by the bare name `Box`, so a
// user struct of that name had its first field dereferenced as a heap pointer:
// `var b = Box { v: 0.0, n: 0 }; b.v = 2.5` died with SIGSEGV (rc=139).

struct Box { v: f64, n: i64 }

fn make(v: f64, n: i64) -> Box { Box { v: v, n: n } }

fn total(b: Box) -> f64 { b.v + (b.n as f64) }

fn bump(b: &!Box) with Mut { (*b).n = (*b).n + 1 }

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    var bad = 0
    var b = Box { v: 0.0, n: 0 }
    b.v = 2.5
    b.n = 4
    if b.v != 2.5 || b.n != 4 { bad = bad + 1 }
    let c = make(1.5, 3)
    if total(c) != 4.5 { bad = bad + 1 }
    bump(&!b)
    if b.n != 5 { bad = bad + 1 }
    if bad != 0 {
        print("user struct Box violations: ")
        println(bad)
        return 1
    }
    println("USER_STRUCT_BOX_OK")
    return 0
}
