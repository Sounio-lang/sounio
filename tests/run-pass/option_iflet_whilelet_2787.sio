//@ run-pass
//@ description: #2787 `if let Some(x)` and `while let Some(v)` see Some(0) as Some, not None
//@ expect-stdout: iflet_some0=0
//@ expect-stdout: iflet_some4=4
//@ expect-stdout: iflet_none=100
//@ expect-stdout: ifletnone_some0=some
//@ expect-stdout: ifletnone_none=none
//@ expect-stdout: whilelet_iters=3
//@ expect-stdout: IFLET_WHILELET_2787_OK

fn f(a: Option<i64>) -> i64 {
    if let Some(x) = a { x } else { 100 }
}

fn g(a: Option<i64>) -> string {
    if let None = a { "none" } else { "some" }
}

// Yields Some(0), Some(1), Some(2), then None. Before #2787 the first item,
// Some(0), was None and the loop ran zero times.
fn next_item(i: i64) -> Option<i64> {
    if i < 3 { Some(i) } else { None }
}

fn main() -> i32 with IO {
    var bad: i64 = 0
    let a = f(Some(0))
    print("iflet_some0=")
    println(a)
    if a != 0 { bad = bad + 1 }
    let b = f(Some(4))
    print("iflet_some4=")
    println(b)
    if b != 4 { bad = bad + 1 }
    let c = f(None)
    print("iflet_none=")
    println(c)
    if c != 100 { bad = bad + 1 }
    print("ifletnone_some0=")
    println(g(Some(0)))
    print("ifletnone_none=")
    println(g(None))

    var i: i64 = 0
    var n: i64 = 0
    while let Some(_) = next_item(i) {
        n = n + 1
        i = i + 1
    }
    print("whilelet_iters=")
    println(n)
    if n != 3 { bad = bad + 1 }

    if bad == 0 {
        println("IFLET_WHILELET_2787_OK")
    } else {
        println("IFLET_WHILELET_2787_FAIL")
    }
    0
}
