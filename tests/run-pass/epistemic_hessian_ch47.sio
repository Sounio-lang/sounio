//@ run-pass
//@ sabotage: hessian-chain
// KL-16b: unary + two-arg Hessian on channels 4–7 (lean_single x86).

// Pad with four prior .value seeds so the live inputs land on ch 4+.

// atan(x) at x=1 on channel 4: H[4,4] = -0.5
fn test_atan_h44() -> f64 with IO, Epistemic {
    let m0: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let v0 = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let x = xm.value
    let z = atan(x) + (v0 + v1 + v2 + v3) * 0.0
    hessian_of(z, 4, 4)
}

// asin(x)*y at x=0, y=2 with channels 4,5: H[4,5] = 1.0
fn test_asin_cross_h45() -> f64 with IO, Epistemic {
    let m0: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let xm: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let v0 = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let x = xm.value
    let y = ym.value
    let z = asin(x) * y + (v0 + v1 + v2 + v3) * 0.0
    hessian_of(z, 4, 5)
}

// atan2(y, x) H[4,5] at y=0, x=1 on channels 4,5: -1.0
fn test_atan2_h45() -> f64 with IO, Epistemic {
    let m0: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let v0 = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let y = ym.value
    let x = xm.value
    let z = atan2(y, x) + (v0 + v1 + v2 + v3) * 0.0
    hessian_of(z, 4, 5)
}

// pow(x, 2.0) on channel 4: H[4,4] = 2.0
fn test_pow_h44() -> f64 with IO, Epistemic {
    let m0: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let v0 = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let x = xm.value
    let z = pow(x, 2.0) + (v0 + v1 + v2 + v3) * 0.0
    hessian_of(z, 4, 4)
}

fn main() with IO, Epistemic {
    let h_atan = test_atan_h44()       // expect -0.5
    let h_asin = test_asin_cross_h45() // expect  1.0
    let h_a2 = test_atan2_h45()        // expect -1.0
    let h_pow = test_pow_h44()         // expect  2.0
    println(h_atan)
    println(h_asin)
    println(h_a2)
    println(h_pow)
}
