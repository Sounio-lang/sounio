//@ run-pass
//@ expect-stdout: STDLIB_SURVIVAL_CHECKED_PASS
//@ timeout: 180
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use stats::checked_survival::{survival_workspace,survival_checked}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 assert(survival_workspace(1000000,1).status==6)
 assert(survival_workspace(1000001,1000000000).status==5)
 let q=survival_workspace(6,10000)
 assert(q.status==0 && q.payload_bytes==1776)
 var times=numeric_buffer_new(6,48);var event=integer_buffer_new(6,48);var group=integer_buffer_new(6,48)
 var order=integer_buffer_new(6,48);var curves=numeric_buffer_new(q.curve_len,q.curve_len*8);var counts=integer_buffer_new(q.count_len,q.count_len*8)
 var i:i64=0
 while i<6 {numeric_buffer_set(&!times,i,((i/2) as f64)+1.0);integer_buffer_set(&!event,i,1);integer_buffer_set(&!group,i,i%2);integer_buffer_set(&!order,i,-19);i=i+1}
 i=0
 while i<q.curve_len {numeric_buffer_set(&!curves,i,17.0);i=i+1}
 i=0
 while i<q.count_len {integer_buffer_set(&!counts,i,-23);i=i+1}
 numeric_buffer_set(&!times,5,0.0/0.0)
 let invalid=survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13)
 assert(invalid.status==2 && invalid.sort_comparisons==0 && invalid.critical_evaluations==0)
 i=0
 while i<6 {assert(integer_buffer_at(&order,i)== -19);i=i+1}
 i=0
 while i<q.curve_len {assert(numeric_buffer_at(&curves,i)==17.0);i=i+1}
 i=0
 while i<q.count_len {assert(integer_buffer_at(&counts,i)== -23);i=i+1}
 numeric_buffer_set(&!times,5,1.0e308*10.0)
 assert(survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13).status==2)
 numeric_buffer_set(&!times,5,-1.0)
 assert(survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13).status==1)
 numeric_buffer_set(&!times,5,3.0);integer_buffer_set(&!group,5,2)
 assert(survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13).status==1)
 integer_buffer_set(&!group,5,1)
 assert(survival_checked(&times,&event,&group,6,0.0,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13).status==1)
 assert(survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,1,1000,100000,100000,1.0e-13).status==6)
 let kernel_failure=survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,1,100000,1.0e-13)
 println("SURVIVAL_KERNEL_REFUSAL {} {}",kernel_failure.status,kernel_failure.critical_evaluations)
 assert(kernel_failure.status==3 && kernel_failure.critical_evaluations==0 && kernel_failure.rows==0)
 integer_buffer_set(&!event,5,2)
 assert(survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13).status==1)
 integer_buffer_set(&!event,5,1)
 let exhausted=survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,0,100000,100000,1.0e-13)
 assert(exhausted.status==3 && exhausted.rows==0 && exhausted.critical_evaluations>0)
 i=0
 while i<q.curve_len {assert(numeric_buffer_at(&curves,i)==17.0);i=i+1}
 let r=survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13)
 assert(r.status==0 && r.rows==3 && r.deaths==6 && r.censored==0 && r.risk_visits==6)
 assert(r.logrank.status==0 && r.logrank.available && r.logrank.chi2==0.0 && r.logrank.p_available && r.logrank.p==1.0 && r.logrank.log_p_available && r.logrank.log_p==0.0)
 assert(r.median_available && r.median==2.0 && r.median0_available && r.median1_available)
 assert(integer_buffer_at(&counts,0)==6 && integer_buffer_at(&counts,1)==2)
 assert(numeric_buffer_at(&curves,48+1)==0.0 && numeric_buffer_at(&curves,48+2)< -1.0e308)
 assert(integer_buffer_at(&counts,24+3)==35)
 i=0
 while i<6 {numeric_buffer_set(&!times,i,(i+1) as f64);i=i+1}
 let post_work=survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,1,1.0e-13)
 println("SURVIVAL_POST_WORK {} {} {} {} {} {}",post_work.status,post_work.rows,post_work.logrank.status,post_work.critical_evaluations,r.critical_evaluations,post_work.logrank.kernel_iterations)
 assert(post_work.status==0 && post_work.rows==6 && post_work.logrank.available && post_work.logrank.status==3 && !post_work.logrank.p_available && !post_work.logrank.log_p_available && post_work.critical_evaluations==r.critical_evaluations && post_work.logrank.kernel_iterations==1)
 i=0
 while i<6 {integer_buffer_set(&!event,i,0);i=i+1}
 let censored=survival_checked(&times,&event,&group,6,0.05,&!order,&!curves,&!counts,10000,1000,100000,100000,1.0e-13)
 assert(censored.status==0 && !censored.median_available && censored.logrank.status==5 && !censored.logrank.available && !censored.logrank.p_available)
 assert(numeric_buffer_at(&curves,1)==1.0 && integer_buffer_at(&counts,3)==47)
 print("SURVIVAL_SMOKE_WORK ");print(r.sort_comparisons);print(" ");print(r.critical_evaluations);print("\n")
 numeric_buffer_close(times);integer_buffer_close(event);integer_buffer_close(group);integer_buffer_close(order);numeric_buffer_close(curves);integer_buffer_close(counts)
 println("STDLIB_SURVIVAL_CHECKED_PASS");0
}
