//@ run-pass
//@ requires: madaros

linear struct Token {
    id: i64,
}

fn spend(token: Token) -> i64 {
    token.id
}

fn main() -> i32 with Panic {
    let token = Token { id: 41 }
    let selector = 0
    let result = match selector {
        0 => spend(token)
        _ => spend(token)
    }
    assert(result == 41)
    0
}
