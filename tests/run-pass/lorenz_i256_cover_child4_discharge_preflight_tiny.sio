//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 discharge preflight receipt

fn child4_discharge_preflight_check(
    child4_validation_core_fp: i64,
    child4_validation_core_audit_fp: i64,
    child3_discharge_preflight_fp: i64,
    child3_discharge_preflight_audit_fp: i64,
    child_index: i64,
    child_validated_mask: i64,
    global_flowpipe_claim_mask: i64,
    discharge_status: i64) -> i64 {
    if child4_validation_core_fp != 392846115 { return 0 - 1 }
    if child4_validation_core_audit_fp != 644973208 { return 0 - 1 }
    if child3_discharge_preflight_fp != 57643306 { return 0 - 1 }
    if child3_discharge_preflight_audit_fp != 784781218 { return 0 - 1 }
    if child_index != 4 { return 0 - 1 }
    if child_validated_mask != 31 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if discharge_status != 75 { return 0 - 1 }
    return 938615204
}

fn main() -> i64 {
    let artifact = child4_discharge_preflight_check(
        392846115, 644973208, 57643306, 784781218, 4, 31, 0, 75)
    if artifact != 938615204 { return 1 }

    let audit_fp: i64 = 405118337
    let instance_fp: i64 = 182647903
    let certificate_fp: i64 = 719306552
    let child_validated_mask: i64 = 31
    let pending_child_validation_mask: i64 = 0
    let remaining_child_validation_mask: i64 = 0
    let child_validation_dependency_mask: i64 = 63
    let child4_validation_receipt_mask: i64 = 31
    let child4_discharge_preflight_mask: i64 = 16
    let discharge_blocker_mask: i64 = 15
    let missing_child_validation_mask: i64 = 0
    let pending_child_discharge_mask: i64 = 255
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let finite_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let discharge_status: i64 = 75
    let ok_mask: i64 = 255

    if audit_fp != 405118337 { return 2 }
    if instance_fp != 182647903 { return 3 }
    if certificate_fp != 719306552 { return 4 }
    if child_validated_mask != 31 { return 5 }
    if pending_child_validation_mask != 0 { return 6 }
    if remaining_child_validation_mask != 0 { return 7 }
    if child_validation_dependency_mask != 63 { return 8 }
    if child4_validation_receipt_mask != 31 { return 9 }
    if child4_discharge_preflight_mask != 16 { return 10 }
    if discharge_blocker_mask != 15 { return 11 }
    if missing_child_validation_mask != 0 { return 12 }
    if pending_child_discharge_mask != 255 { return 13 }
    if child_discharge_mask != 0 { return 14 }
    if global_cover_certificate_mask != 0 { return 15 }
    if finite_cover_certificate_mask != 0 { return 16 }
    if global_flowpipe_claim_mask != 0 { return 17 }
    if discharge_status != 75 { return 18 }
    if ok_mask != 255 { return 19 }

    let wrong_child = child4_discharge_preflight_check(
        392846115, 644973208, 57643306, 784781218, 3, 31, 0, 75)
    if wrong_child != 0 - 1 { return 20 }

    let overclaim = child4_discharge_preflight_check(
        392846115, 644973208, 57643306, 784781218, 4, 31, 1, 75)
    if overclaim != 0 - 1 { return 21 }

    let incomplete_validation = child4_discharge_preflight_check(
        392846115, 644973208, 57643306, 784781218, 4, 15, 0, 75)
    if incomplete_validation != 0 - 1 { return 22 }

    return 0
}
