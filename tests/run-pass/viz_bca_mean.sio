//@ run-pass
//@ expect-stdout: BCA_FIGURE_PASS
//@ expect-stdout: Mean 95% CI: top percentile; bottom BCa; B=512
//@ expect-stdout: fill="rgb(80,180,240)"
use stats::bootstrap::{bootstrap_mean,bootstrap_bca_mean}
use display::canvas::{Canvas,canvas_clear}
use viz::ir::{viz_scene_new,viz_layout_rect,viz_style_rgb,viz_add_forest_interval_plot,
 VIZ_INTERVAL_CONFIDENCE,viz_add_axis,viz_node_set_label}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO,Alloc,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 x[0]=1.0;x[1]=2.0;x[2]=3.0;x[3]=4.0;x[4]=8.0;x[5]=10.0
 let p=bootstrap_mean(&x,6,512,0.95,42)
 let b=bootstrap_bca_mean(&x,6,512,0.95,42)
 assert(p.status==0 && b.status==0 && b.tail_resolved)
 assert(b.less_count==264 && b.equal_count==27)
 var estimates:[f64;1024]=[0.0;1024]
 var lower:[f64;1024]=[0.0;1024]
 var upper:[f64;1024]=[0.0;1024]
 estimates[0]=p.mean;estimates[1]=b.mean
 lower[0]=p.lo;lower[1]=b.lo
 upper[0]=p.hi;upper[1]=b.hi
 let lo=if p.lo<b.lo {p.lo}else{b.lo}
 let hi=if p.hi>b.hi {p.hi}else{b.hi}
 var scene=viz_scene_new()
 let forest=viz_add_forest_interval_plot(&!scene,&estimates,&lower,&upper,2,
  VIZ_INTERVAL_CONFIDENCE,0.95,viz_layout_rect(130,25,560,70),viz_style_rgb(80,180,240))
 assert(forest==0)
 assert(scene.series[0].lower[1]==b.lo && scene.series[0].upper[1]==b.hi)
 let axis=viz_add_axis(&!scene,lo,hi,4,false,viz_layout_rect(130,110,560,1),viz_style_rgb(180,190,210))
 assert(axis==1)
 var title:[i8;64]=[0;64]
 title[0]=77
 title[1]=101
 title[2]=97
 title[3]=110
 title[4]=32
 title[5]=57
 title[6]=53
 title[7]=37
 title[8]=32
 title[9]=67
 title[10]=73
 title[11]=58
 title[12]=32
 title[13]=116
 title[14]=111
 title[15]=112
 title[16]=32
 title[17]=112
 title[18]=101
 title[19]=114
 title[20]=99
 title[21]=101
 title[22]=110
 title[23]=116
 title[24]=105
 title[25]=108
 title[26]=101
 title[27]=59
 title[28]=32
 title[29]=98
 title[30]=111
 title[31]=116
 title[32]=116
 title[33]=111
 title[34]=109
 title[35]=32
 title[36]=66
 title[37]=67
 title[38]=97
 title[39]=59
 title[40]=32
 title[41]=66
 title[42]=61
 title[43]=53
 title[44]=49
 title[45]=50
 viz_node_set_label(&!scene,axis,&title,46)
 let pixels=heap_alloc(820*185*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:820,height:185}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,25*820+130)!=0)
 viz_html_emit_scene(&scene,820,185)
 println("BCA_FIGURE_PASS")
 0
}
