//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_STREAMING_BODY_LANE PASS
//
// Copilot review (PR #2516), finding A on the third review round, LATER
// CORRECTED by round 4's finding D: `madaros --probe-native-streaming
// <file>` calls the FLAT helper
// (lower_program_function_body_from_summary_FLAT_with_epistemic_ref),
// which delegates to lower_program_bodies_ref -- NOT
// lower_program_bodies_filtered_ref, the streaming single-function lane
// this PR's tuple-array fix actually needed wiring into. Only the NON-flat
// lower_program_function_body_from_summary_with_epistemic_ref reaches
// lower_program_bodies_filtered_ref, and nothing reachable from `souc run`
// or `--probe-native-streaming` drives that function. Real coverage of
// lower_program_bodies_filtered_ref comes from the dedicated
// --probe-filtered-body-lower CLI flag and
// scripts/ci/madaros_tuple_arr_filtered_body_lower_gate.sh, added in round
// 4 for exactly this reason -- see that gate, not this fixture, for the
// filtered-lane regression guard.
//
// What THIS fixture actually covers: the ordinary `madaros run` path
// (already covered by many other fixtures) plus a confirmation that
// `--probe-native-streaming` itself -- a single-module, no-import program
// lowered via the FLAT lane and then optionally native-streaming-codegen'd
// -- also classifies this function's `([f64; N], [f64; N])` destructure
// correctly and doesn't error. It does not exercise
// lower_program_bodies_filtered_ref.
fn pair() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let (oa, ob) = pair()
    let s0: f64 = oa[0] * 2.0
    let s1: f64 = 2.0 * ob[0]
    if s0 == 3.0 && s1 == 0.5 {
        println("TUPLE_F64_ARRAY_STREAMING_BODY_LANE PASS")
        return 0
    }
    1
}
