//@ check-only
// Imported API conformance, including private evidence and state flow.

use epistemic::proof_carrying_shift_robust_risk_transport::*

fn main() with Panic {
    let boundary = observe_d11_d10_source_boundary(31101)
    assert(boundary.d10_lease_id == 30821)
    assert(boundary.d10_evidence_id == 30301)
    assert(boundary.model_version_id == 30412)
    assert(boundary.site_id == 30461)
    assert(boundary.source_scope_count == 8)
    assert(boundary.target_scope_count == 4)
    assert(!boundary.d10_attests_d11_scope_subset)
    assert(boundary.canary_only)
    assert(!boundary.production_authority)
    assert(!boundary.clinical_action_authority)
    assert(!boundary.public_observation_is_authority)

    let covariate_observation = observe_d11_covariate_shift_transport(31201)
    let overlap_failure = observe_d11_covariate_overlap_failure(31202)
    assert(covariate_observation.source_mass_a == 3)
    assert(covariate_observation.source_mass_b == 9)
    assert(covariate_observation.target_mass_a == 6)
    assert(covariate_observation.target_mass_b == 6)
    assert(covariate_observation.source_risk_numerator == 1)
    assert(covariate_observation.source_risk_denominator == 4)
    assert(covariate_observation.target_risk_numerator == 1)
    assert(covariate_observation.target_risk_denominator == 2)
    assert(covariate_observation.weighted_source_risk_numerator == 1)
    assert(covariate_observation.weighted_source_risk_denominator == 2)
    assert(covariate_observation.joint_law_fingerprint == 92352734845403155)
    assert(covariate_observation.conditional_law_invariant)
    assert(covariate_observation.overlap_established)
    assert(!overlap_failure.overlap_established)
    assert(!overlap_failure.target_point_risk_identified)
    assert(overlap_failure.target_risk_upper_numerator == 1)
    assert(overlap_failure.target_risk_upper_denominator == 2)

    let label_observation = observe_d11_label_shift_transport(31301)
    let singular = observe_d11_label_shift_nonidentifiability(31302)
    assert(label_observation.confusion_determinant == 1)
    assert(label_observation.target_prior_identified)
    assert(label_observation.target_risk_numerator == 1)
    assert(label_observation.target_risk_denominator == 2)
    assert(label_observation.label_probe_id == 31311)
    assert(label_observation.evaluated_loss_id == 31711)
    assert(singular.confusion_determinant == 0)
    assert(singular.unlabeled_prediction_histogram_equal)
    assert(!singular.target_prior_identified)
    assert(singular.target_risk_world_a_numerator == 1)
    assert(singular.target_risk_world_b_numerator == 3)

    let stable = observe_d11_concept_stability(31401)
    let shifted = observe_d11_concept_shift_failure(31402)
    let ambiguity = observe_d11_unlabeled_target_ambiguity(31403)
    assert(stable.target_label_count == 12)
    assert(stable.conditional_law_invariant)
    assert(stable.target_risk_numerator == 1)
    assert(stable.target_risk_denominator == 2)
    assert(!shifted.conditional_law_invariant)
    assert(shifted.severe_target_breach)
    assert(shifted.target_risk_numerator == 4)
    assert(ambiguity.observed_target_label_count == 0)
    assert(ambiguity.observationally_equivalent_without_labels)
    assert(!ambiguity.target_point_risk_identified)

    let marginal = observe_d11_marginal_target_risk(31501)
    let balanced = observe_d11_balanced_subgroup_risk(31502)
    let hidden = observe_d11_hidden_subgroup_harm(31503)
    assert(marginal.total_error_count == 6 && marginal.total_case_count == 12)
    assert(!marginal.subgroup_bound_established)
    assert(balanced.marginal_error_count == hidden.marginal_error_count)
    assert(balanced.marginal_case_count == hidden.marginal_case_count)
    assert(balanced.worst_group_risk_denominator == 2)
    assert(hidden.worst_group_risk_denominator == 1)
    assert(balanced.bound_met && !hidden.subgroup_bound_met)

    let source_calibration = observe_d11_source_marginal_calibration(31601)
    let drift = observe_d11_target_calibration_drift(31602)
    let local = observe_d11_target_local_calibration(31603)
    assert(source_calibration.source_residual_numerator == 0)
    assert(source_calibration.marginally_calibrated_in_source)
    assert(!source_calibration.target_local_calibration_established)
    assert(drift.target_residual_numerator == 1)
    assert(drift.target_residual_denominator == 4)
    assert(drift.soft_drift_warning)
    assert(!drift.automatic_recalibration_authorized)
    assert(!drift.authorizes_state_transition)
    assert(local.target_cell_a_residual_numerator == 0)
    assert(local.target_cell_b_residual_numerator == 0)
    assert(local.target_local_calibration_established)
    assert(!local.universal_calibration_claimed)

    let source_risk_observation = observe_d11_source_conformal_risk(31701)
    let radius_observation = observe_d11_given_joint_tv_radius(31702)
    let estimated_weight = record_d11_estimated_shift_weight_point(31704)
    assert(source_risk_observation.source_risk_numerator == 1)
    assert(source_risk_observation.source_risk_denominator == 4)
    assert(!source_risk_observation.target_risk_established)
    assert(!source_risk_observation.general_conformal_theorem)
    assert(radius_observation.tv_radius_numerator == 1)
    assert(radius_observation.tv_radius_denominator == 4)
    assert(radius_observation.given_joint_radius)
    assert(!radius_observation.estimated_point_only)
    assert(!estimated_weight.uncertainty_interval_present)
    assert(!estimated_weight.joint_law_radius_given)

    let exact_law = certify_d11_labeled_exact_joint_fixture()
    let source_risk = certify_d11_source_conformal_risk(exact_law)
    let radius = certify_d11_joint_tv_radius(exact_law)
    let target_risk = transport_d11_shift_robust_target_risk(
        source_risk, radius,
    )
    let envelope = observe_d11_target_risk_envelope(31703, target_risk)
    assert(envelope.source_risk_numerator == 1)
    assert(envelope.source_risk_denominator == 4)
    assert(envelope.tv_radius_numerator == 1)
    assert(envelope.tv_radius_denominator == 4)
    assert(envelope.target_risk_bound_numerator == 1)
    assert(envelope.target_risk_bound_denominator == 2)
    assert(envelope.bound_attained_exactly)
    assert(!envelope.general_shift_robust_crc_theorem)

    let no_detected = record_d11_no_detected_target_shift(31808)
    assert(!no_detected.shift_detected)
    assert(!no_detected.absence_of_shift_proven)

    let target_evidence = replay_d11_complete_target_evidence()
    let target_evidence_observation = observe_d11_target_evidence_bound(
        31801, target_evidence,
    )
    assert(target_evidence_observation.complete_dimension_count == 6)
    assert(target_evidence_observation.all_target_bound)
    assert(!target_evidence_observation.external_validation)
    assert(target_evidence_observation.joint_fixture_id == 31131)
    assert(target_evidence_observation.evidence_window_id == 31121)
    assert(target_evidence_observation.model_version_id == 30412)
    assert(target_evidence_observation.site_id == 30461)
    assert(target_evidence_observation.workflow_version_id == 30471)
    assert(target_evidence_observation.loss_id == 31711)
    assert(target_evidence_observation.group_plan_id == 31512)
    assert(target_evidence_observation.calibrator_version_id == 30413)
    assert(target_evidence_observation.joint_law_fingerprint ==
        92352734845403155)
    assert(target_evidence_observation.source_scope_id == 31141)
    assert(target_evidence_observation.target_scope_id == 31142)
    assert(target_evidence_observation.subset_membership_count == 4)
    assert(target_evidence_observation.target_scope_subset_established)
    assert(!target_evidence_observation.external_origin_authenticated)

    let continuation = continue_d11_target_canary(target_evidence)
    let continuation_observation = observe_d11_target_canary_continuation(
        31802, continuation,
    )
    assert(continuation_observation.source_authority_rank == 3)
    assert(continuation_observation.target_authority_rank == 3)
    assert(continuation_observation.target_scope_count == 4)
    assert(continuation_observation.source_scope_count == 8)
    assert(continuation_observation.joint_fixture_id == 31131)
    assert(continuation_observation.evidence_window_id == 31121)
    assert(continuation_observation.loss_id == 31711)
    assert(continuation_observation.group_plan_id == 31512)
    assert(continuation_observation.calibrator_version_id == 30413)
    assert(continuation_observation.canary_only)
    assert(!continuation_observation.scope_widened)
    assert(!continuation_observation.production_authority)
    assert(!continuation_observation.clinical_action_authority)
    assert(continuation_observation.target_scope_subset_established)
    assert(continuation_observation.fixture_replayable)
    assert(!continuation_observation.single_chain_proven)
    assert(continuation_observation.current_labeled_snapshot_fingerprint ==
        92352734845403155)

    let active_drift = certify_d11_fixture_active_calibrator_drift(continuation)
    let degraded = degrade_d11_target_canary(continuation, active_drift)
    let degraded_observation = observe_d11_degraded_canary(31803, degraded)
    assert(degraded_observation.rank_before == 3)
    assert(degraded_observation.rank_after == 2)
    assert(degraded_observation.scope_before == 4)
    assert(degraded_observation.scope_after == 2)
    assert(degraded_observation.joint_fixture_id == 31131)
    assert(degraded_observation.evidence_window_id == 31122)
    assert(degraded_observation.prior_window_id == 31121)
    assert(degraded_observation.current_labeled_snapshot_fingerprint == 3162401)
    assert(!degraded_observation.authority_promoted)

    let ambiguity_trigger = certify_d11_fixture_target_ambiguity(degraded)
    let suspended = suspend_d11_target_canary(degraded, ambiguity_trigger)
    let suspended_observation = observe_d11_suspended_canary(31804, suspended)
    assert(suspended_observation.rank_before == 2)
    assert(suspended_observation.rank_after == 1)
    assert(suspended_observation.joint_fixture_id == 31131)
    assert(suspended_observation.evidence_window_id == 31123)
    assert(suspended_observation.prior_window_id == 31122)
    assert(suspended_observation.current_labeled_snapshot_fingerprint == 3162401)
    assert(!suspended_observation.target_labels_available)
    assert(!suspended_observation.predictions_served)
    assert(!suspended_observation.authority_promoted)

    let concept_trigger = certify_d11_fixture_concept_shift(suspended)
    let revoked = revoke_d11_target_canary(suspended, concept_trigger)
    let revoked_observation = observe_d11_revoked_canary(31805, revoked)
    assert(revoked_observation.rank_before == 1)
    assert(revoked_observation.rank_after == 0)
    assert(revoked_observation.joint_fixture_id == 31131)
    assert(revoked_observation.evidence_window_id == 31124)
    assert(revoked_observation.prior_window_id == 31123)
    assert(revoked_observation.current_labeled_snapshot_fingerprint == 3142401)
    assert(revoked_observation.nominal_trace_terminal)
    assert(!revoked_observation.globally_absorbing)
    assert(!revoked_observation.runtime_canary_disabled)
    assert(!revoked_observation.institutional_revocation_authority)
    assert(!revoked_observation.copied_stale_token_statically_invalidated)
    assert(revoked_observation.fixture_replayable)
    assert(!revoked_observation.single_chain_proven)

    let nominal_trace = bind_d11_nominal_trace(
        continuation, degraded, suspended, revoked,
    )
    let trace = observe_d11_authority_attenuation_trace(
        31806, nominal_trace,
    )
    assert(trace.source_rank == 3 && trace.continuation_rank == 3)
    assert(trace.degraded_rank == 2 && trace.suspended_rank == 1)
    assert(trace.revoked_rank == 0)
    assert(trace.every_transition_nonexpansive)
    assert(trace.upward_edge_count == 0)
    assert(!trace.live_reference_monitor_proven)
    assert(trace.continuation_window_id == 31121)
    assert(trace.degraded_window_id == 31122)
    assert(trace.suspended_window_id == 31123)
    assert(trace.revoked_window_id == 31124)
    assert(trace.fixture_replayable)
    assert(!trace.single_chain_proven)
    assert(trace.continuation_snapshot_fingerprint == 92352734845403155)
    assert(trace.degraded_snapshot_fingerprint == 3162401)
    assert(trace.suspended_snapshot_fingerprint == 3162401)
    assert(trace.revoked_snapshot_fingerprint == 3142401)

    let refusal = refuse_d11_automatic_authority_promotion(
        31807, continuation,
    )
    assert(refusal.requested_authority_rank == 4)
    assert(refusal.maximum_input_authority_rank == 3)
    assert(!refusal.production_promotion_issued)
    assert(!refusal.clinical_promotion_issued)

    let summary = summarize_d11_shift_robust_risk_transport(
        31901,
        target_evidence,
        continuation,
        nominal_trace,
        revoked,
    )
    assert(summary.exact_contest_count == 9)
    assert(summary.nominal_shift_class_count == 3)
    assert(summary.target_evidence_dimension_count == 6)
    assert(summary.private_typestate_count == 20)
    assert(summary.upward_edge_count == 0)
    assert(summary.external_validation_count == 0)
    assert(summary.production_authority_count == 0)
    assert(summary.patient_state_count == 0)
    assert(summary.clinical_action_authority_count == 0)
    assert(summary.compiler_rewrite_count == 0)
    assert(summary.exact_only_for_frozen_fixtures)
    assert(summary.target_scope_subset_established)
    assert(summary.nominal_trace_terminal)
    assert(!summary.globally_absorbing)
    assert(!summary.runtime_canary_disabled)
    assert(summary.fixture_replayable)
    assert(!summary.single_chain_proven)
    assert(!summary.external_origin_authenticated)
}
