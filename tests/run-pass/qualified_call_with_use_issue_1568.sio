//@ run-pass
//@ description: #1568 control — the same call with its `use` resolves and computes the true variance
//@ expect-stdout: 1.000000
use epistemic::sobol_indices::variance

var XS: [f64; 16384] = [0.0; 16384]

fn main() -> i64 with IO, Mut, Div {
    XS[0] = 1.0
    XS[1] = 2.0
    XS[2] = 3.0
    let v: f64 = variance(XS, 3)
    println(v)
    0
}
