//@ run-pass
//@ description: Imported Lorenz i256 bounded scaled-product bridge smoke

use systems::lorenz_i256_scaled_product_bridge::*

fn main() -> i64 with Div {
    let low = lorenz_i256_scaled_product_check(
        250000000, 0, 0, 0, 400000000, 0, 0, 0, 100000000, 0, 0, 0)
    if low != 1 { return 1 }

    let mixed = lorenz_i256_scaled_product_check(
        500000000, 1, 0, 0, 250000000, 2, 0, 0, 375000000, 3, 0, 0)
    if mixed != 1 { return 2 }

    let carry = lorenz_i256_scaled_product_check(
        500000000, 2, 0, 0, 500000000, 3, 0, 0, 750000000, 8, 0, 0)
    if carry != 1 { return 3 }

    let inexact = lorenz_dec2_scaled_product_limb(
        333333333, 0, 0, 0, 333333333, 0, 0, 0, 0)
    if inexact != 0 - 1 { return 4 }

    let upper = lorenz_dec2_scaled_product_limb(
        1, 0, 1, 0, 1, 0, 0, 0, 0)
    if upper != 0 - 1 { return 5 }

    let artifact = lorenz_i256_scaled_product_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 109)
    if artifact != 920174638 { return 6 }

    let audit = lorenz_i256_scaled_product_bridge_audit_fingerprint(
        artifact, 703918426, 268540197, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 109, 1023)
    if audit != 481036275 { return 7 }
    return 0
}
