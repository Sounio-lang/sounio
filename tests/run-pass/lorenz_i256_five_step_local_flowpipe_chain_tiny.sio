//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 five-step local-flowpipe chain-composition receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1709
    fp = mix(fp, 5, 5573)
    fp = mix(fp, 4, 5573)
    fp = mix(fp, 908974219, 5573)
    fp = mix(fp, 890221848, 5573)
    fp = mix(fp, 418029869, 5573)
    fp = mix(fp, 518930343, 5573)
    fp = mix(fp, 78860411, 5573)
    fp = mix(fp, 972719127, 5573)
    fp = mix(fp, 354200144, 5573)
    fp = mix(fp, 97568991, 5573)
    fp = mix(fp, 965829478, 5573)
    fp = mix(fp, 618466007, 5573)
    fp = mix(fp, 595466240, 5573)
    fp = mix(fp, 382059454, 5573)
    fp = mix(fp, 158202075, 5573)
    fp = mix(fp, 952956886, 5573)
    fp = mix(fp, 692714944, 5573)
    fp = mix(fp, 627937430, 5573)
    fp = mix(fp, 880867663, 5573)
    fp = mix(fp, 674753000, 5573)
    fp = mix(fp, 214180161, 5573)
    fp = mix(fp, 23144051, 5573)
    fp = mix(fp, 561641681, 5573)
    fp = mix(fp, 256, 5573)
    fp = mix(fp, 32, 5573)
    fp = mix(fp, 1, 5573)
    fp = mix(fp, 100, 5573)
    fp = mix(fp, 31, 5573)
    fp = mix(fp, 15, 5573)
    fp = mix(fp, 7, 5573)
    fp = mix(fp, 15, 5573)
    fp = mix(fp, 31, 5573)
    fp = mix(fp, 0, 5573)
    fp = mix(fp, 26, 5573)
    return fp
}

fn certificate_fp(instance: i64) -> i64 {
    var fp: i64 = 1721
    fp = mix(fp, instance, 5581)
    fp = mix(fp, 31, 5581)
    fp = mix(fp, 15, 5581)
    fp = mix(fp, 7, 5581)
    fp = mix(fp, 15, 5581)
    fp = mix(fp, 31, 5581)
    fp = mix(fp, 0, 5581)
    fp = mix(fp, 26, 5581)
    fp = mix(fp, 255, 5581)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1723
    fp = mix(fp, instance, 5591)
    fp = mix(fp, certificate, 5591)
    fp = mix(fp, 18, 5591)
    fp = mix(fp, 5, 5591)
    fp = mix(fp, 4, 5591)
    fp = mix(fp, 31, 5591)
    fp = mix(fp, 0, 5591)
    fp = mix(fp, 26, 5591)
    fp = mix(fp, 255, 5591)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    var fp: i64 = 1733
    fp = mix(fp, artifact, 5623)
    fp = mix(fp, instance, 5623)
    fp = mix(fp, certificate, 5623)
    fp = mix(fp, 5, 5623)
    fp = mix(fp, 4, 5623)
    fp = mix(fp, 908974219, 5623)
    fp = mix(fp, 890221848, 5623)
    fp = mix(fp, 418029869, 5623)
    fp = mix(fp, 518930343, 5623)
    fp = mix(fp, 78860411, 5623)
    fp = mix(fp, 972719127, 5623)
    fp = mix(fp, 354200144, 5623)
    fp = mix(fp, 97568991, 5623)
    fp = mix(fp, 965829478, 5623)
    fp = mix(fp, 618466007, 5623)
    fp = mix(fp, 595466240, 5623)
    fp = mix(fp, 382059454, 5623)
    fp = mix(fp, 158202075, 5623)
    fp = mix(fp, 952956886, 5623)
    fp = mix(fp, 692714944, 5623)
    fp = mix(fp, 627937430, 5623)
    fp = mix(fp, 880867663, 5623)
    fp = mix(fp, 674753000, 5623)
    fp = mix(fp, 214180161, 5623)
    fp = mix(fp, 23144051, 5623)
    fp = mix(fp, 561641681, 5623)
    fp = mix(fp, 256, 5623)
    fp = mix(fp, 32, 5623)
    fp = mix(fp, 1, 5623)
    fp = mix(fp, 100, 5623)
    fp = mix(fp, 31, 5623)
    fp = mix(fp, 15, 5623)
    fp = mix(fp, 7, 5623)
    fp = mix(fp, 15, 5623)
    fp = mix(fp, 31, 5623)
    fp = mix(fp, 0, 5623)
    fp = mix(fp, 26, 5623)
    fp = mix(fp, 255, 5623)
    return fp
}

fn main() -> i64 {
    let instance = instance_fp()
    if instance != 449273642 { return 1 }
    let certificate = certificate_fp(instance)
    if certificate != 114764949 { return 2 }
    let artifact = artifact_fp(instance, certificate)
    if artifact != 911209450 { return 3 }
    let audit = audit_fp(artifact, instance, certificate)
    if audit != 709377850 { return 4 }
    return 0
}
