//@ run-pass
//@ description: #2661 — a plain call `helper()` names the free function, not a same-named impl method declared earlier; also in a global initialiser and when the method has a receiver. lean_single bound the first fn with the name (printed 7 / refused get(1) with E001); Madaros prints 42 42 7 105 2.
//@ expect-stdout: 42 42 7 105 2
struct S { v: i64 }
impl S {
    fn helper() -> i64 { 7 }
    fn get(self: &S) -> i64 { self.v + 100 }
}
fn helper() -> i64 { 42 }
fn get(x: i64) -> i64 { x + 1 }
var G: i64 = helper()
fn main() -> i32 with IO, Mut {
    let s = S { v: 5 }
    print_int(G) print(" ")
    print_int(helper()) print(" ")
    print_int(S::helper()) print(" ")
    print_int(s.get()) print(" ")
    print_int(get(1)) print("\n")
    return 0
}
