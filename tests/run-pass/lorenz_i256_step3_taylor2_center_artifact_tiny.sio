//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 center candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn instance_fp() -> i64 {
    var fp: i64 = 1733
    fp = mix(fp, 3, 5657)
    fp = mix(fp, 10, 5657)
    fp = mix(fp, 28, 5657)
    fp = mix(fp, 8, 5657)
    fp = mix(fp, 3, 5657)
    fp = mix(fp, 4294967296, 5657)
    fp = mix(fp, 42949672, 5657)
    fp = mix(fp, 96, 5657)
    fp = mix(fp, 4406636440, 5657)
    fp = mix(fp, 6517899153, 5657)
    fp = mix(fp, 4164877513, 5657)
    fp = mix(fp, 4617762706, 5657)
    fp = mix(fp, 7643846696, 5657)
    fp = mix(fp, 4120687759, 5657)
    fp = mix(fp, 116883728, 5657)
    fp = mix(fp, 84354264, 5657)
    fp = mix(fp, 417748218, 5657)
    fp = mix(fp, 109213065, 5657)
    fp = mix(fp, 389654052, 5657)
    fp = mix(fp, 790630993, 5657)
    fp = mix(fp, 0, 5657)
    fp = mix(fp, 0, 5657)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 391525506 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1741
    fp = mix(fp, instance, 5659)
    fp = mix(fp, 119112655997, 5659)
    fp = mix(fp, 796606888, 5659)
    fp = mix(fp, 6687364522, 5659)
    fp = mix(fp, 1434262808, 5659)
    fp = mix(fp, 11106340034, 5659)
    fp = mix(fp, 2, 5659)
    fp = mix(fp, 211126266, 5659)
    fp = mix(fp, 2495204624, 5659)
    fp = mix(fp, 1125947543, 5659)
    fp = mix(fp, 1173001440, 5659)
    fp = mix(fp, 44189754, 5659)
    fp = mix(fp, 568146880, 5659)
    fp = mix(fp, 4617762706, 5659)
    fp = mix(fp, 7643846696, 5659)
    fp = mix(fp, 4120687759, 5659)
    fp = mix(fp, 127, 5659)
    fp = mix(fp, 63, 5659)
    fp = mix(fp, 7, 5659)
    fp = mix(fp, 15, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, ok_mask, 5659)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 391525506 { return 0 - 1 }
    if certificate != 653032557 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1747
    fp = mix(fp, instance, 5669)
    fp = mix(fp, certificate, 5669)
    fp = mix(fp, 116883728, 5669)
    fp = mix(fp, 84354264, 5669)
    fp = mix(fp, 417748218, 5669)
    fp = mix(fp, 109213065, 5669)
    fp = mix(fp, 389654052, 5669)
    fp = mix(fp, 790630993, 5669)
    fp = mix(fp, 1, 5669)
    fp = mix(fp, 3, 5669)
    fp = mix(fp, 4617762706, 5669)
    fp = mix(fp, 7643846696, 5669)
    fp = mix(fp, 4120687759, 5669)
    fp = mix(fp, 15, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, ok_mask, 5669)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 164784481 { return 0 - 1 }
    if instance != 391525506 { return 0 - 1 }
    if certificate != 653032557 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1753
    fp = mix(fp, artifact, 5683)
    fp = mix(fp, instance, 5683)
    fp = mix(fp, certificate, 5683)
    fp = mix(fp, 116883728, 5683)
    fp = mix(fp, 84354264, 5683)
    fp = mix(fp, 417748218, 5683)
    fp = mix(fp, 109213065, 5683)
    fp = mix(fp, 389654052, 5683)
    fp = mix(fp, 790630993, 5683)
    fp = mix(fp, 3, 5683)
    fp = mix(fp, 1, 5683)
    fp = mix(fp, 127, 5683)
    fp = mix(fp, 63, 5683)
    fp = mix(fp, 7, 5683)
    fp = mix(fp, 15, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, ok_mask, 5683)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x2: i256 = 4406636440 as i256
    let y2: i256 = 6517899153 as i256
    let z2: i256 = 4164877513 as i256
    let dy_scaled_q: i256 = 119112655997 as i256
    let dy_scaled_r: i256 = 796606888 as i256
    let xy_scaled_q: i256 = 6687364522 as i256
    let xy_scaled_r: i256 = 1434262808 as i256
    let beta_q: i256 = 11106340034 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 211126266 as i256
    let x_inc_r: i256 = 2495204624 as i256
    let y_inc_q: i256 = 1125947543 as i256
    let y_inc_r: i256 = 1173001440 as i256
    let z_drop_q: i256 = 44189754 as i256
    let z_drop_r: i256 = 568146880 as i256

    let dx_num: i256 = (10 as i256) * (y2 - x2)
    let dy_num: i256 = x2 * ((28 as i256) * scale - z2)
    let xy_num: i256 = x2 * y2
    let beta_num_z: i256 = (8 as i256) * z2
    let dy: i256 = dy_scaled_q - y2
    let z_drop_num: i256 = beta_q - xy_scaled_q

    var point_replay_mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { point_replay_mask = point_replay_mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 { point_replay_mask = point_replay_mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { point_replay_mask = point_replay_mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { point_replay_mask = point_replay_mask + 32 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, z_drop_r) == 1 { point_replay_mask = point_replay_mask + 64 }
    if point_replay_mask != 127 { return 1 }

    var final_center_mask: i64 = 0
    if x2 + x_inc_q == 4617762706 as i256 { final_center_mask = final_center_mask + 1 }
    if y2 + y_inc_q == 7643846696 as i256 { final_center_mask = final_center_mask + 2 }
    if z2 - z_drop_q == 4120687759 as i256 { final_center_mask = final_center_mask + 4 }
    if final_center_mask != 7 { return 2 }

    let ok_mask: i64 = 255
    let inst = instance_fp()
    if inst != 391525506 { return 3 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 653032557 { return 4 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 164784481 { return 5 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 660765149 { return 6 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, scale) != 0 { return 7 }
    if certificate_fp(inst, 254) != (0 - 1) { return 8 }
    return 0
}
