//@ run-pass
//@ requires: madaros
//@ expect-stdout: NONOWNING_WRAPPER_COPY_OK
struct WaveGeneric<T> { value: T }
struct WaveNode { next: *const WaveNode }
fn value(wrapper: WaveGeneric<i64>) -> i64 { wrapper.value }
fn main() -> i32 with IO, Mut, Panic {
    let wrapper = WaveGeneric { value: 42 }
    let first = value(wrapper)
    let second = value(wrapper)
    let node = WaveNode { next: 0 as *const WaveNode }
    let unused_copy = node
    if first != 42 || second != 42 { return 1 }
    println("NONOWNING_WRAPPER_COPY_OK")
    0
}
