    if acc > 145 { taken = taken + 1 }
    if acc > 146 { taken = taken + 1 }
    if acc > 147 { taken = taken + 1 }
    if acc > 148 { taken = taken + 1 }
    if acc > 149 { taken = taken + 1 }
    if taken != 150 {
        print("native_v2_label_capacity: FAIL taken=")
        print_int(taken)
        print("\n")
