//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v137 smoke for Lorenz i256 step-1 Taylor-2 replay executor

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1973
    receipt_fp = mix(receipt_fp, 815221512, 5939)
    receipt_fp = mix(receipt_fp, 981617998, 5939)
    receipt_fp = mix(receipt_fp, 570323855, 5939)
    receipt_fp = mix(receipt_fp, 922761694, 5939)
    receipt_fp = mix(receipt_fp, 947539911, 5939)
    receipt_fp = mix(receipt_fp, 665055088, 5939)
    receipt_fp = mix(receipt_fp, 245102468, 5939)
    receipt_fp = mix(receipt_fp, 261545659, 5939)
    receipt_fp = mix(receipt_fp, 928945135, 5939)
    receipt_fp = mix(receipt_fp, 174108453, 5939)
    receipt_fp = mix(receipt_fp, 620127047, 5939)
    receipt_fp = mix(receipt_fp, 1, 5939)
    receipt_fp = mix(receipt_fp, 8, 5939)
    receipt_fp = mix(receipt_fp, 255, 5939)
    if receipt_fp != 907464772 { return 1 }

    var audit_fp: i64 = 1979
    audit_fp = mix(audit_fp, receipt_fp, 5953)
    audit_fp = mix(audit_fp, 815221512, 5953)
    audit_fp = mix(audit_fp, 981617998, 5953)
    audit_fp = mix(audit_fp, 570323855, 5953)
    audit_fp = mix(audit_fp, 922761694, 5953)
    audit_fp = mix(audit_fp, 261545659, 5953)
    audit_fp = mix(audit_fp, 928945135, 5953)
    audit_fp = mix(audit_fp, 245102468, 5953)
    audit_fp = mix(audit_fp, 1, 5953)
    audit_fp = mix(audit_fp, 8, 5953)
    audit_fp = mix(audit_fp, 255, 5953)
    if audit_fp != 901239486 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 140, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 140, 1103)
    if entry_fp != 954097866 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 137, 1151)
    manifest_fp = mix(manifest_fp, 141, 1151)
    manifest_fp = mix(manifest_fp, 665055088, 1151)
    manifest_fp = mix(manifest_fp, 947539911, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 352621120 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 137, 1871)
    result_fp = mix(result_fp, 141, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 129, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 125741491 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 137, 1907)
    family_fp = mix(family_fp, 141, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 124, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 152911970 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 137, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 110303919 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 137, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 557268780 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 137, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 937727692 { return 9 }
    return 0
}
