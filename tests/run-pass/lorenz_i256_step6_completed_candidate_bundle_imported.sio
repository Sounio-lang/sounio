//@ description: Imported Lorenz i256 step-6 completed candidate bundle checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_completed_candidate_bundle_check(
        134624236, 237534229, 516981885, 652877359, 15, 15, 0, 4)
    if artifact_fp != 641464796 { return 1 }
    let audit_fp = lorenz_i256_step6_completed_candidate_bundle_audit_fingerprint(
        artifact_fp, 175122911, 425699291, 516981885, 652877359, 506104143, 6, 4, 127)
    if audit_fp != 222156824 { return 2 }
    return 0
}
