//@ run-pass

use graphics::drawing::{color_black}
use graphics::surface::{
    Surface, surface_new, surface_clear,
    surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b
}
use graphics::plot::{plot_line_raster, line_plot_config_default}
use graphics::scatter::{plot_scatter_raster, scatter_config_default}
use graphics::heatmap::{plot_heatmap_raster, heatmap_config_default}
use graphics::epistemic::{plot_epistemic_band_raster, epistemic_band_config_default}

fn assert_pixel_black(s: &Surface, x: i64, y: i64, code: i64) -> i64 {
    if surface_get_pixel_r(s, x, y) != 0 { return code }
    if surface_get_pixel_g(s, x, y) != 0 { return code + 1 }
    if surface_get_pixel_b(s, x, y) != 0 { return code + 2 }
    0
}

fn test_empty_line_plot_returns_input() -> i64 with Mut, Panic, Div {
    var s = surface_new(32, 32)
    s = surface_clear(s, color_black())
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    let out = plot_line_raster(s, &xs, &ys, 0, line_plot_config_default())
    assert_pixel_black(&out, 0, 0, 10)
}

fn test_empty_scatter_plot_returns_input() -> i64 with Mut, Panic, Div {
    var s = surface_new(32, 32)
    s = surface_clear(s, color_black())
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    let out = plot_scatter_raster(s, &xs, &ys, 0, scatter_config_default())
    assert_pixel_black(&out, 0, 0, 20)
}

fn test_empty_heatmap_returns_input() -> i64 with Mut, Panic, Div {
    var s = surface_new(32, 32)
    s = surface_clear(s, color_black())
    var data: [f64; 4096] = [0.0; 4096]
    let out1 = plot_heatmap_raster(s, &data, 0, 2, heatmap_config_default())
    let r1 = assert_pixel_black(&out1, 0, 0, 30)
    if r1 != 0 { return r1 }
    let out2 = plot_heatmap_raster(s, &data, 2, 0, heatmap_config_default())
    assert_pixel_black(&out2, 0, 0, 33)
}

fn test_empty_epistemic_band_returns_input() -> i64 with Mut, Panic, Div {
    var s = surface_new(32, 32)
    s = surface_clear(s, color_black())
    var xs: [f64; 256] = [0.0; 256]
    var center: [f64; 256] = [0.0; 256]
    var lower: [f64; 256] = [0.0; 256]
    var upper: [f64; 256] = [0.0; 256]
    let out = plot_epistemic_band_raster(s, &xs, &center, &lower, &upper, 0, epistemic_band_config_default())
    assert_pixel_black(&out, 0, 0, 40)
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let r1 = test_empty_line_plot_returns_input()
    if r1 != 0 { print("FAIL test_empty_line_plot_returns_input\n"); return r1 }

    let r2 = test_empty_scatter_plot_returns_input()
    if r2 != 0 { print("FAIL test_empty_scatter_plot_returns_input\n"); return r2 }

    let r3 = test_empty_heatmap_returns_input()
    if r3 != 0 { print("FAIL test_empty_heatmap_returns_input\n"); return r3 }

    let r4 = test_empty_epistemic_band_returns_input()
    if r4 != 0 { print("FAIL test_empty_epistemic_band_returns_input\n"); return r4 }

    print("PASS graphics_degenerate_smoke\n")
    0
}
