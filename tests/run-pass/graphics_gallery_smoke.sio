//@ run-pass

use graphics::drawing::{Color, color_black, color_white, color_red, color_blue}
use graphics::surface::{
    Surface, surface_new, surface_clear, surface_draw_line,
    surface_draw_rect, surface_get_pixel_r, surface_get_pixel_g,
    surface_get_pixel_b
}
use graphics::plot::{plot_line_raster, line_plot_config_default}
use graphics::scatter::{plot_scatter_raster, scatter_config_default}
use graphics::heatmap::{plot_heatmap_raster, heatmap_config_default}
use graphics::epistemic::{plot_epistemic_band_raster, epistemic_band_config_default}
use graphics::export::{export_png}

fn assert_non_white_pixel(s: &Surface, x0: i64, y0: i64, x1: i64, y1: i64, code: i64) -> i64 with Mut {
    var y = y0
    while y < y1 {
        var x = x0
        while x < x1 {
            if surface_get_pixel_r(s, x, y) != 255 ||
               surface_get_pixel_g(s, x, y) != 255 ||
               surface_get_pixel_b(s, x, y) != 255 {
                return 0
            }
            x = x + 1
        }
        y = y + 1
    }
    code
}

fn exercise_primitives() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    s = surface_clear(s, color_white())
    s = surface_draw_line(s, 4, 4, 59, 59, color_red())
    s = surface_draw_rect(s, 10, 40, 12, 6, color_blue())
    if surface_get_pixel_r(&s, 4, 4) != 255 { return 1 }
    if surface_get_pixel_b(&s, 10, 40) != 255 { return 2 }
    0
}

fn exercise_line_plot() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    xs[0] = 0.0
    ys[0] = 1.0
    xs[1] = 1.0
    ys[1] = 2.0
    xs[2] = 2.0
    ys[2] = 1.0
    s = plot_line_raster(s, &xs, &ys, 3, line_plot_config_default())
    assert_non_white_pixel(&s, 15, 15, 50, 50, 10)
}

fn exercise_scatter_plot() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    xs[0] = 0.2
    ys[0] = 0.2
    xs[1] = 0.5
    ys[1] = 0.8
    xs[2] = 0.8
    ys[2] = 0.4
    s = plot_scatter_raster(s, &xs, &ys, 3, scatter_config_default())
    assert_non_white_pixel(&s, 15, 15, 50, 50, 20)
}

fn exercise_heatmap_plot() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var data: [f64; 4096] = [0.0; 4096]
    data[0] = 0.0
    data[1] = 1.0
    data[2] = 0.4
    data[3] = 0.7
    s = plot_heatmap_raster(s, &data, 2, 2, heatmap_config_default())
    assert_non_white_pixel(&s, 15, 15, 50, 50, 30)
}

fn exercise_epistemic_band() -> i64 with Mut, Panic, Div {
    var s = surface_new(64, 64)
    var xs: [f64; 256] = [0.0; 256]
    var center: [f64; 256] = [0.0; 256]
    var lower: [f64; 256] = [0.0; 256]
    var upper: [f64; 256] = [0.0; 256]
    xs[0] = 0.0
    center[0] = 0.4
    lower[0] = 0.2
    upper[0] = 0.6
    xs[1] = 1.0
    center[1] = 0.7
    lower[1] = 0.5
    upper[1] = 0.9
    xs[2] = 2.0
    center[2] = 0.5
    lower[2] = 0.3
    upper[2] = 0.8
    s = plot_epistemic_band_raster(s, &xs, &center, &lower, &upper, 3, epistemic_band_config_default())
    assert_non_white_pixel(&s, 15, 15, 50, 50, 40)
}

fn exercise_png_export_contract() -> i64 with IO, Mut, Panic, Div {
    let s = surface_new(8, 8)
    let ok = export_png(&s, "/tmp/graphics_gallery_smoke.png")
    if !ok { return 50 }
    if file_size("/tmp/graphics_gallery_smoke.png") <= 0 { return 51 }
    0
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let r1 = exercise_primitives()
    if r1 != 0 { print("FAIL exercise_primitives\n"); return r1 }

    let r2 = exercise_line_plot()
    if r2 != 0 { print("FAIL exercise_line_plot\n"); return r2 }

    let r3 = exercise_scatter_plot()
    if r3 != 0 { print("FAIL exercise_scatter_plot\n"); return r3 }

    let r4 = exercise_heatmap_plot()
    if r4 != 0 { print("FAIL exercise_heatmap_plot\n"); return r4 }

    let r5 = exercise_epistemic_band()
    if r5 != 0 { print("FAIL exercise_epistemic_band\n"); return r5 }

    let r6 = exercise_png_export_contract()
    if r6 != 0 { print("FAIL exercise_png_export_contract\n"); return r6 }

    print("PASS graphics_gallery_smoke\n")
    0
}
