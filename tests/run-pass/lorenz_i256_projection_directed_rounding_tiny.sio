//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 directed projection rounding binds floor/ceil witnesses

fn cert_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn directed_rounding_fingerprint(
    trajectory_manifest_fp: i64,
    source_scale: i64,
    target_scale: i64,
    final_x_2p32: i64,
    final_y_2p32: i64,
    final_z_2p32: i64,
    x_floor: i64,
    x_remainder: i64,
    x_ceil: i64,
    y_floor: i64,
    y_remainder: i64,
    y_ceil: i64,
    z_floor: i64,
    z_remainder: i64,
    z_ceil: i64,
    generic_directed_rounding_fp: i64,
    projection_div_witness_fp: i64,
    roundoff_budget_fp: i64,
    projection_margin_budget_fp: i64) -> i64 {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if source_scale != 4294967296 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if final_x_2p32 != 5309941770 { return 0 - 1 }
    if final_y_2p32 != 10058731223 { return 0 - 1 }
    if final_z_2p32 != 4084837935 { return 0 - 1 }
    if x_floor != 1236317 { return 0 - 1 }
    if x_remainder != 687511168 { return 0 - 1 }
    if x_ceil != 1236318 { return 0 - 1 }
    if y_floor != 2341980 { return 0 - 1 }
    if y_remainder != 3715113920 { return 0 - 1 }
    if y_ceil != 2341981 { return 0 - 1 }
    if z_floor != 951075 { return 0 - 1 }
    if z_remainder != 1913956800 { return 0 - 1 }
    if z_ceil != 951076 { return 0 - 1 }
    if generic_directed_rounding_fp != 505163788 { return 0 - 1 }
    if projection_div_witness_fp != 693793961 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }

    var fp: i64 = 359
    fp = cert_mix(fp, trajectory_manifest_fp, 2633)
    fp = cert_mix(fp, source_scale, 2633)
    fp = cert_mix(fp, target_scale, 2633)
    fp = cert_mix(fp, final_x_2p32, 2633)
    fp = cert_mix(fp, final_y_2p32, 2633)
    fp = cert_mix(fp, final_z_2p32, 2633)
    fp = cert_mix(fp, x_floor, 2633)
    fp = cert_mix(fp, x_remainder, 2633)
    fp = cert_mix(fp, x_ceil, 2633)
    fp = cert_mix(fp, y_floor, 2633)
    fp = cert_mix(fp, y_remainder, 2633)
    fp = cert_mix(fp, y_ceil, 2633)
    fp = cert_mix(fp, z_floor, 2633)
    fp = cert_mix(fp, z_remainder, 2633)
    fp = cert_mix(fp, z_ceil, 2633)
    fp = cert_mix(fp, generic_directed_rounding_fp, 2633)
    fp = cert_mix(fp, projection_div_witness_fp, 2633)
    fp = cert_mix(fp, roundoff_budget_fp, 2633)
    fp = cert_mix(fp, projection_margin_budget_fp, 2633)
    return fp
}

fn directed_rounding_audit_fingerprint(
    directed_rounding_fp: i64,
    generic_directed_rounding_fp: i64,
    projection_div_witness_fp: i64,
    roundoff_budget_fp: i64,
    projection_margin_budget_fp: i64,
    readiness_mask: i64) -> i64 {
    if directed_rounding_fp != 80894555 { return 0 - 1 }
    if generic_directed_rounding_fp != 505163788 { return 0 - 1 }
    if projection_div_witness_fp != 693793961 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 367
    fp = cert_mix(fp, directed_rounding_fp, 2647)
    fp = cert_mix(fp, generic_directed_rounding_fp, 2647)
    fp = cert_mix(fp, projection_div_witness_fp, 2647)
    fp = cert_mix(fp, roundoff_budget_fp, 2647)
    fp = cert_mix(fp, projection_margin_budget_fp, 2647)
    fp = cert_mix(fp, readiness_mask, 2647)
    return fp
}

fn main() -> i64 {
    let fp = directed_rounding_fingerprint(
        214180161, 4294967296, 1000000,
        5309941770, 10058731223, 4084837935,
        1236317, 687511168, 1236318,
        2341980, 3715113920, 2341981,
        951075, 1913956800, 951076,
        505163788, 693793961, 677514412, 69322697)
    if fp != 80894555 { return 1 }

    let audit_fp = directed_rounding_audit_fingerprint(
        fp, 505163788, 693793961, 677514412, 69322697, 31)
    if audit_fp != 793284661 { return 2 }

    if directed_rounding_fingerprint(
        214180161, 4294967296, 1000000,
        5309941770, 10058731223, 4084837935,
        1236317, 687511168, 1236317,
        2341980, 3715113920, 2341981,
        951075, 1913956800, 951076,
        505163788, 693793961, 677514412, 69322697) != (0 - 1) { return 3 }

    return 0
}
