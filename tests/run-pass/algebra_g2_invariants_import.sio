//@ run-pass
use algebra::octonion::{cd_sigma, oct_xor, oct_mul, oct_norm_sq, oct_basis, oct_associator, is_fano_triple}

fn fano_line_i(n: i64) -> i64 {
    if n == 0 { return 1 }
    if n == 1 { return 1 }
    if n == 2 { return 1 }
    if n == 3 { return 2 }
    if n == 4 { return 2 }
    if n == 5 { return 3 }
    3
}

fn fano_line_j(n: i64) -> i64 {
    if n == 0 { return 2 }
    if n == 1 { return 4 }
    if n == 2 { return 7 }
    if n == 3 { return 4 }
    if n == 4 { return 5 }
    if n == 5 { return 4 }
    6
}

fn fano_line_k(n: i64) -> i64 {
    if n == 0 { return 3 }
    if n == 1 { return 5 }
    if n == 2 { return 6 }
    if n == 3 { return 6 }
    if n == 4 { return 7 }
    if n == 5 { return 7 }
    5
}

fn basis_assoc_norm_sq(i: i64, j: i64, k: i64) -> f64 with Mut, Div, NonAssoc {
    var a = oct_basis(i)
    var b = oct_basis(j)
    var c = oct_basis(k)
    var assoc: [f64; 8] = [0.0; 8]
    oct_associator(&a, &b, &c, &!assoc)
    oct_norm_sq(&assoc)
}

fn su3_block(k: i64) -> i64 {
    if k < 3 { return 0 }
    if k < 6 { return 1 }
    2
}

fn su3_quality_identity() -> f64 with Mut {
    var total = 0.0
    var off = 0.0
    var i: i64 = 0
    while i < 7 {
        var j: i64 = 0
        while j < 7 {
            var val = 0.0
            if i == j { val = 1.0 }
            total = total + val * val
            if su3_block(i) != su3_block(j) { off = off + val * val }
            j = j + 1
        }
        i = i + 1
    }
    1.0 - off / total
}

fn su3_quality_scrambled() -> f64 with Mut {
    var total = 0.0
    var off = 0.0
    var i: i64 = 0
    while i < 7 {
        var j: i64 = 0
        while j < 7 {
            var val = 0.0
            if i == j { val = 1.0 }
            if i == 0 && j == 3 { val = 0.5 }
            if i == 3 && j == 0 { val = 0.5 }
            total = total + val * val
            if su3_block(i) != su3_block(j) { off = off + val * val }
            j = j + 1
        }
        i = i + 1
    }
    1.0 - off / total
}

fn main() -> i32 with IO, Mut, Div, NonAssoc {
    var pass: i32 = 0
    var line: i64 = 0
    while line < 7 {
        if basis_assoc_norm_sq(fano_line_i(line), fano_line_j(line), fano_line_k(line)) == 0.0 { pass = pass + 1 }
        line = line + 1
    }
    if pass != 7 { return 1 }

    var non_fano: i32 = 0
    var i: i64 = 1
    while i <= 7 {
        var j: i64 = i + 1
        while j <= 7 {
            var k: i64 = j + 1
            while k <= 7 {
                if !is_fano_triple(i, j, k) {
                    if basis_assoc_norm_sq(i, j, k) == 4.0 { non_fano = non_fano + 1 }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if non_fano != 28 { return 2 }

    var phi = 0.0
    line = 0
    while line < 7 {
        if cd_sigma(fano_line_i(line), fano_line_j(line)) > 0 { phi = phi + 1.0 } else { phi = phi - 1.0 }
        line = line + 1
    }
    if phi != 7.0 { return 3 }
    if su3_quality_identity() != 1.0 { return 4 }
    if su3_quality_scrambled() >= 1.0 { return 5 }

    line = 0
    while line < 7 {
        let i = fano_line_i(line)
        let j = fano_line_j(line)
        let k = fano_line_k(line)
        let check = oct_xor(i, j)
        if check != k { return 6 }
        if !is_fano_triple(i, j, k) { return 6 }
        line = line + 1
    }

    println("ALL PASS")
    0
}
