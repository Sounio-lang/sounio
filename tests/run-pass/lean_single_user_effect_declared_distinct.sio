//@ run-pass
//@ requires: lean_single
//@ expect-stdout: USER_EFFECT_ALPHA_OK
//@ description: SIO-3336 — a declared user effect gets a stable bit and satisfies calls requiring the same effect.

effect Alpha {}

fn needs_alpha() -> i64 with Alpha {
    return 7
}

fn has_alpha() -> i64 with Alpha {
    return needs_alpha()
}

fn main() -> i64 with IO, Alpha {
    let x = has_alpha()
    if x == 7 {
        println("USER_EFFECT_ALPHA_OK")
        return 0
    }
    println("USER_EFFECT_ALPHA_FAIL")
    return 1
}
