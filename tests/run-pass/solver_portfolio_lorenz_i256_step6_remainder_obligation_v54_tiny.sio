//@ run-pass
//@ description: Tiny portfolio v54 smoke for Lorenz i256 step-6 remainder obligation entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 431
    receipt_fp = mix(receipt_fp, 652877359, 3671)
    receipt_fp = mix(receipt_fp, 344816971, 3671)
    receipt_fp = mix(receipt_fp, 72088078, 3671)
    receipt_fp = mix(receipt_fp, 145449, 3671)
    receipt_fp = mix(receipt_fp, 878999745, 3671)
    receipt_fp = mix(receipt_fp, 6, 3671)
    receipt_fp = mix(receipt_fp, 5, 3671)
    receipt_fp = mix(receipt_fp, 127, 3671)
    if receipt_fp != 40625512 { return 1 }

    var audit_fp: i64 = 433
    audit_fp = mix(audit_fp, receipt_fp, 3691)
    audit_fp = mix(audit_fp, 652877359, 3691)
    audit_fp = mix(audit_fp, 344816971, 3691)
    audit_fp = mix(audit_fp, 292824876, 3691)
    audit_fp = mix(audit_fp, 892715220, 3691)
    audit_fp = mix(audit_fp, 878999745, 3691)
    audit_fp = mix(audit_fp, 6, 3691)
    audit_fp = mix(audit_fp, 5, 3691)
    audit_fp = mix(audit_fp, 127, 3691)
    if audit_fp != 853998860 { return 2 }
    return 0
}
