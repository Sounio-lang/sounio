//@ expect-stdout-contains: KNIGHT_IMPORT_PASS

use fixtures::epi006_knight_leaf::{source}

fn main() -> i64 with IO, Epistemic {
    let x = source()
    let y = knight("imported", 0.0, 1.0)
    let z = x - y
    if z.iv.0 != 0.0 || z.iv.1 != 0.0 { return 1 }
    println("KNIGHT_IMPORT_PASS")
