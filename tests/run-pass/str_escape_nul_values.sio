//@ run-pass
//@ description: Embedded NUL survives string value flow, length, comparison, and construction.

struct Text {
    value: string,
}

fn identity(s: string) -> string {
    s
}
fn referenced(s: &string) -> string {
    *s
}

fn emit(s: string) with IO {
    print(s)
}

fn selected(which: bool) -> string {
    if which { "a\0b" } else { "\0xy\0" }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let s = selected(true)
    let alias = identity(referenced(&s))
    assert(str_len(alias) == 3)
    assert(str_char_at(alias, 1) == 0)
    assert(str_char_at(alias, 2) == 98)
    assert(str_eq(alias, "a\0b"))
    assert(!str_eq(alias, "a\0c"))
    assert(!str_eq(alias, "a"))
    assert(starts_with(alias, "a\0"))
    assert(!starts_with(alias, "a\0c"))
    let text = Text { value: alias }
    emit(text.value)
    println()
    var changing = alias
    changing = selected(false)
    assert(str_len(changing) == 4)
    println(changing)
    let joined = str_concat(alias, "\0c")
    assert(str_len(joined) == 5)
    println(joined)
    let part = str_slice(joined, 1, 4)
    assert(str_len(part) == 3)
    println(part)
    let suffix = str_slice(alias, 1)
    assert(str_len(suffix) == 2)
    println(suffix)
    assert(str_eq(str_slice(alias, -1, 99), alias))
    assert(str_len(str_slice(alias, 99)) == 0)
    assert(str_len(str_slice(alias, 2, 1)) == 0)
    let zeros = identity("\0\0\0")
    assert(str_len(zeros) == 3)
    assert(!str_eq(zeros, "\0"))
    assert(starts_with(zeros, "\0\0"))
    assert(str_eq(str_concat("", zeros), zeros))
    assert(str_eq(str_slice(zeros, 1), "\0\0"))
    assert(str_eq(str_slice(zeros, 0, 3), zeros))
    var bytes: [i8; 3] = [0; 3]
    bytes[0] = 97 as i8
    bytes[2] = 98 as i8
    let copied = str_from_bytes(bytes, 3)
    assert(str_len(copied) == 3)
    assert(str_eq(copied, alias))
    println(copied)
    let empty = identity("")
    assert(str_len(empty) == 0)
    println(empty)
    let unicode = identity("\u{e9}\0\u{1f600}")
    assert(str_len(unicode) == 7)
    println(unicode)
    println("END")
    0
}
