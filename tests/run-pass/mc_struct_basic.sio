//@ run-pass
// Mini-compiler struct test: basic struct declaration, literal, field access

struct Point {
    x: i64,
    y: i64,
}

fn manhattan(p: Point) -> i64 {
    p.x + p.y
}

fn main() -> i64 with IO {
    let p = Point { x: 10, y: 32 }
    let d = manhattan(p)
    print_int(d)
    print("\n")
    0
}
