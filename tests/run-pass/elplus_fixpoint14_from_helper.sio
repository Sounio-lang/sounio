//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: ELPLUS_HYDRATE_PROBE_OK
//@ description: the 14-parameter imported elplus_fixpoint called from a helper, not from main (stdlib/ontology/elplus.sio used to say such calls produced no ELF); 9 hand-derived subsumption and conflict answers
use ontology::elplus::{elplus_role_closure, elplus_seed, elplus_fixpoint_packed, elplus_fixpoint, elplus_subsumes_dense, elplus_conflict}

fn show(label: i64, got: bool, want: bool) -> i64 with IO {
    print("q")
    print_int(label)
    if got { print(" true") } else { print(" false") }
    if got == want { println(" ok"); return 0 }
    println(" MISMATCH")
    1
}

fn run() -> i32 with IO, Mut, Div, Panic {
    var s: [bool; 4096] = [false; 4096]
    var r: [bool; 32768] = [false; 32768]
    var disj: [bool; 4096] = [false; 4096]
    var rclos: [bool; 64] = [false; 64]
    var pack: [i64; 704] = [0; 704]
    var chains: [i64; 24] = [0; 24]
    var dims: [i64; 4] = [0; 4]
    // atoms 0 Cage 1 Small512 2 Large51264 3 Structure 4 sII 5 Guest 6 H2 7 Host ; 8 top
    // roles 0 hasCage 1 hasPart 2 occupiedBy 3 contains
    pack[8] = 1
    var i: i64 = 0
    while i < 512 { pack[192 + i] = 0 - 1; i = i + 1 }
    // ex concepts: id, role, filler
    pack[9] = 3;  pack[64 + 9] = 0;  pack[128 + 9] = 2;  pack[192 + 0 * 64 + 2] = 9
    pack[10] = 3; pack[64 + 10] = 0; pack[128 + 10] = 1; pack[192 + 0 * 64 + 1] = 10
    pack[11] = 3; pack[64 + 11] = 1; pack[128 + 11] = 0; pack[192 + 1 * 64 + 0] = 11
    pack[12] = 3; pack[64 + 12] = 2; pack[128 + 12] = 6; pack[192 + 2 * 64 + 6] = 12
    pack[13] = 3; pack[64 + 13] = 3; pack[128 + 13] = 5; pack[192 + 3 * 64 + 5] = 13
    pack[14] = 3; pack[64 + 14] = 3; pack[128 + 14] = 6; pack[192 + 3 * 64 + 6] = 14
    pack[15] = 3; pack[64 + 15] = 0; pack[128 + 15] = 0; pack[192 + 0 * 64 + 0] = 15
    pack[16] = 3; pack[64 + 16] = 1; pack[128 + 16] = 2; pack[192 + 1 * 64 + 2] = 16
    i = 0
    while i < 8 { pack[64 + i] = i; i = i + 1 }
    elplus_seed(&!s, 17, 8)
    s[1 * 64 + 0] = true
    s[2 * 64 + 0] = true
    s[4 * 64 + 3] = true
    s[6 * 64 + 5] = true
    s[4 * 64 + 9] = true
    s[4 * 64 + 10] = true
    s[2 * 64 + 12] = true
    rclos[0 * 8 + 1] = true
    elplus_role_closure(&!rclos, 4)
    chains[0] = 0; chains[8] = 2; chains[16] = 3
    dims[0] = 1; dims[1] = 17; dims[2] = 9; dims[3] = 4
    var ck: [i64; 64] = [0; 64]
    var a1: [i64; 64] = [0; 64]
    var a2: [i64; 64] = [0; 64]
    var ex: [i64; 512] = [0; 512]
    var c1: [i64; 8] = [0; 8]
    var c2: [i64; 8] = [0; 8]
    var c3: [i64; 8] = [0; 8]
    var q: i64 = 0
    while q < 64 { ck[q as usize] = pack[q as usize]  a1[q as usize] = pack[(64 + q) as usize]  a2[q as usize] = pack[(128 + q) as usize]  q = q + 1 }
    q = 0
    while q < 512 { ex[q as usize] = pack[(192 + q) as usize]  q = q + 1 }
    q = 0
    while q < 8 { c1[q as usize] = chains[q as usize]  c2[q as usize] = chains[(8 + q) as usize]  c3[q as usize] = chains[(16 + q) as usize]  q = q + 1 }
    let rounds = elplus_fixpoint(&!s, &!r, &ck, &a1, &a2, &ex, &rclos, &c1, &c2, &c3, dims[0], dims[1], dims[2], dims[3])
    disj[1 * 64 + 2] = true; disj[2 * 64 + 1] = true
    disj[5 * 64 + 7] = true; disj[7 * 64 + 5] = true
    print("rounds "); print_int(rounds); print("\n")
    var bad: i64 = 0
    bad = bad + show(1, elplus_subsumes_dense(&s, 4, 11), true)
    bad = bad + show(2, elplus_subsumes_dense(&s, 4, 13), true)
    bad = bad + show(3, elplus_subsumes_dense(&s, 4, 14), true)
    bad = bad + show(4, elplus_subsumes_dense(&s, 3, 9), false)
    bad = bad + show(5, elplus_subsumes_dense(&s, 4, 16), true)
    bad = bad + show(6, elplus_conflict(&s, &disj, 17, 1, 2), true)
    bad = bad + show(7, elplus_conflict(&s, &disj, 17, 6, 7), true)
    bad = bad + show(8, elplus_conflict(&s, &disj, 17, 4, 6), false)
    bad = bad + show(9, elplus_subsumes_dense(&s, 0, 2), false)
    if bad == 0 { println("ELPLUS_HYDRATE_PROBE_OK"); return 0 }
    println("ELPLUS_HYDRATE_PROBE_FAIL")
    1
}
fn main() -> i32 with IO, Mut, Div, Panic { run() }
