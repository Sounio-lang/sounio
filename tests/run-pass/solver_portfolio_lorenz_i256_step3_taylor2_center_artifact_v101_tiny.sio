//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v101 smoke for Lorenz i256 step-3 Taylor-2 center artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1759
    receipt_fp = mix(receipt_fp, 164784481, 5689)
    receipt_fp = mix(receipt_fp, 660765149, 5689)
    receipt_fp = mix(receipt_fp, 718264441, 5689)
    receipt_fp = mix(receipt_fp, 47474367, 5689)
    receipt_fp = mix(receipt_fp, 124115315, 5689)
    receipt_fp = mix(receipt_fp, 763506498, 5689)
    receipt_fp = mix(receipt_fp, 779852235, 5689)
    receipt_fp = mix(receipt_fp, 116883728, 5689)
    receipt_fp = mix(receipt_fp, 84354264, 5689)
    receipt_fp = mix(receipt_fp, 3, 5689)
    receipt_fp = mix(receipt_fp, 1, 5689)
    receipt_fp = mix(receipt_fp, 255, 5689)
    if receipt_fp != 256154724 { return 1 }

    var audit_fp: i64 = 1777
