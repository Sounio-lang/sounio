//@ run-pass
// Baseline: single-level &! struct field store through exclusive reference.
// This should already pass — serves as the bisect anchor for G1b.
// If this fails, the bug is wider (parameter-passing convention).

struct Outer { name: i64, value: i64 }

fn set_name(o: &!Outer, v: i64) with Mut { o.name = v }

fn main() with IO, Mut, Panic {
    var o = Outer { name: 0, value: 99 }
    set_name(&!o, 42)
    if o.name != 42 { panic("FAIL: single-level mut ref not propagated") }
    println("OK")
}
