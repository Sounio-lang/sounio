//@ run-pass
use darwin_pbpk::cumulants::*
use darwin_pbpk::epistemic_pbpk28::*

fn main() -> i32 with IO, Mut, Div, Panic {
    println("before extract")
    let der = extract_pbpk28_derivatives(ep28_rapamycin_params(), ep28_rapamycin_priors(), 5.0, 168.0)
    println("after extract")
    if der.success { println("ok") }
    return 0
}
