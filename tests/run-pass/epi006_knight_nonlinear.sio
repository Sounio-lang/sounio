//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: KNIGHT_NONLINEAR_PASS
//@ description: EPI-006 step 3b review 1: nonlinear mul/div, vacuous div-by-zero, independent remainder identity, and non-dyadic outward rounding

fn main() -> i64 with IO, Epistemic {
    // 1. x * x on [-1, 2]: exact range is [0, 4].
    let x = knight("sq", -1.0, 2.0)
    let sq = x * x
    let sq_lo = sq.iv.0
    let sq_hi = sq.iv.1
    if !(sq_lo == sq_lo) || !(sq_hi == sq_hi) || !(sq_lo <= sq_hi) { return 1 }
    if !(sq_lo <= 0.0) || !(sq_hi >= 4.0) { return 2 }

    // 2. Division by [2, 3]: [1, 2] / [2, 3] has exact range [1/3, 1].
    // Exact binary64 floor of 1/3 is 3.33333333333333315e-01.
    let a = knight("num", 1.0, 2.0)
    let d = knight("den", 2.0, 3.0)
    let q = a / d
    let q_lo = q.iv.0
    let q_hi = q.iv.1
    if !(q_lo == q_lo) || !(q_hi == q_hi) || !(q_lo <= q_hi) { return 3 }
    if !(q_lo <= 3.33333333333333315e-01) || !(q_hi >= 1.0) { return 4 }

    // 3. Division by [-1, 1] straddles zero -> vacuous [-inf, +inf].
    let z = knight("zero_straddle", -1.0, 1.0)
    let qv = a / z
    let qv_lo = qv.iv.0
    let qv_hi = qv.iv.1
    if !(qv_lo == qv_lo) || !(qv_hi == qv_hi) || !(qv_lo <= qv_hi) { return 5 }
    if !(qv_lo < -1.0e308) || !(qv_hi > 1.0e308) { return 6 }

    // 4. Independent remainder identity:
    //    let p = x * x; p - p cancels the shared fresh anonymous symbol to [0, 0];
    //    (x * x) - (x * x) allocates two distinct fresh symbols and does not cancel.
    let p = x * x
    let same = p - p
    if same.iv.0 != 0.0 || same.iv.1 != 0.0 { return 7 }
    let p1 = x * x
    let p2 = x * x
    let diff = p1 - p2
    let d_lo = diff.iv.0
    let d_hi = diff.iv.1
    if !(d_lo == d_lo) || !(d_hi == d_hi) || !(d_lo <= d_hi) { return 8 }
    if !(d_lo < 0.0) || !(d_hi > 0.0) { return 9 }

    // 5. Non-dyadic outward rounding:
    //    (a) [0.1, 0.2] + [0.2, 0.3]: exact binary64 sum 0.1 + 0.2 rounds up,
    //        so certified lower endpoint must be strictly below 0.1 + 0.2 (<= 2.99999999999999989e-01).
    let nd1 = knight("nd1", 0.1, 0.2)
    let nd2 = knight("nd2", 0.2, 0.3)
    let nds = nd1 + nd2
    let nd_rn = 0.1 + 0.2
    let nd_lo = nds.iv.0
    let nd_hi = nds.iv.1
    if !(nd_lo == nd_lo) || !(nd_hi == nd_hi) || !(nd_lo <= nd_hi) { return 10 }
    if !(nd_lo < nd_rn) || !(nd_lo <= 2.99999999999999989e-01) || !(nd_hi >= 0.5) { return 11 }

    //    (b) [1, 1] / [3, 3]: exact 1/3 lies strictly in (3.33333333333333315e-01, 3.33333333333333370e-01).
    let one = knight("one", 1.0, 1.0)
    let three = knight("three", 3.0, 3.0)
    let inv3 = one / three
    let i3_lo = inv3.iv.0
    let i3_hi = inv3.iv.1
    if !(i3_lo == i3_lo) || !(i3_hi == i3_hi) || !(i3_lo <= i3_hi) { return 12 }
    if !(i3_lo <= 3.33333333333333315e-01) || !(i3_hi >= 3.33333333333333370e-01) { return 13 }

    println("KNIGHT_NONLINEAR_PASS")
    0
}
