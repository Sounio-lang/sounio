//@ run-pass
//@ expect-stdout: ALL 6 TESTS PASSED
//@ expect-stdout: Failed: 0
// Stable MOR / DEIM smoke suite for the native compiler path.

fn mr_abs(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn mr_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn mr_norm2(v: [f64; 256], n: i64) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i: i64 = 0
    while i < n {
        sum = sum + v[i] * v[i]
        i = i + 1
    }
    mr_sqrt(sum)
}

fn build_test_basis_4x2() -> [f64; 4096] with Mut, Div, Panic {
    let inv = 1.0 / mr_sqrt(2.0)
    var V: [f64; 4096] = [0.0; 4096]
    V[0 * 2 + 0] = inv
    V[2 * 2 + 0] = inv
    V[1 * 2 + 1] = inv
    V[3 * 2 + 1] = inv
    V
}

fn build_spd_4x4(shift: f64) -> [f64; 4096] with Mut {
    var A: [f64; 4096] = [0.0; 4096]
    A[0 * 4 + 0] = 4.0 + shift; A[0 * 4 + 1] = -1.0
    A[1 * 4 + 0] = -1.0; A[1 * 4 + 1] = 4.0 + shift; A[1 * 4 + 2] = -1.0
    A[2 * 4 + 1] = -1.0; A[2 * 4 + 2] = 4.0 + shift; A[2 * 4 + 3] = -1.0
    A[3 * 4 + 2] = -1.0; A[3 * 4 + 3] = 4.0 + shift
    A
}

fn project_vector(V: [f64; 4096], u: [f64; 256], n_dof: i64, n_basis: i64) -> [f64; 64] with Mut, Panic {
    var out: [f64; 64] = [0.0; 64]
    var i: i64 = 0
    while i < n_basis {
        var sum = 0.0
        var k: i64 = 0
        while k < n_dof {
            sum = sum + V[k * n_basis + i] * u[k]
            k = k + 1
        }
        out[i] = sum
        i = i + 1
    }
    out
}

fn reconstruct(V: [f64; 4096], u_r: [f64; 64], n_dof: i64, n_basis: i64) -> [f64; 256] with Mut, Panic {
    var out: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < n_dof {
        var sum = 0.0
        var j: i64 = 0
        while j < n_basis {
            sum = sum + V[i * n_basis + j] * u_r[j]
            j = j + 1
        }
        out[i] = sum
        i = i + 1
    }
    out
}

fn project_matrix(V: [f64; 4096], A: [f64; 4096], n_dof: i64, n_basis: i64) -> [f64; 4096] with Mut, Panic {
    var AV: [f64; 4096] = [0.0; 4096]
    var i: i64 = 0
    while i < n_dof {
        var j: i64 = 0
        while j < n_basis {
            var sum = 0.0
            var k: i64 = 0
            while k < n_dof {
                sum = sum + A[i * n_dof + k] * V[k * n_basis + j]
                k = k + 1
            }
            AV[i * n_basis + j] = sum
            j = j + 1
        }
        i = i + 1
    }

    var A_r: [f64; 4096] = [0.0; 4096]
    i = 0
    while i < n_basis {
        var j: i64 = 0
        while j < n_basis {
            var sum = 0.0
            var k: i64 = 0
            while k < n_dof {
                sum = sum + V[k * n_basis + i] * AV[k * n_basis + j]
                k = k + 1
            }
            A_r[i * n_basis + j] = sum
            j = j + 1
        }
        i = i + 1
    }
    A_r
}

fn direct_solve(A_in: [f64; 4096], b_in: [f64; 256], n: i64) -> [f64; 256] with Mut, Div, Panic {
    var A = A_in
    var b = b_in
    var x: [f64; 256] = [0.0; 256]

    var col: i64 = 0
    while col < n {
        var pivot = col
        var pivot_val = mr_abs(A[col * n + col])
        var row = col + 1
        while row < n {
            let v = mr_abs(A[row * n + col])
            if v > pivot_val {
                pivot = row
                pivot_val = v
            }
            row = row + 1
        }

        if pivot != col {
            var k: i64 = 0
            while k < n {
                let tmp = A[col * n + k]
                A[col * n + k] = A[pivot * n + k]
                A[pivot * n + k] = tmp
                k = k + 1
            }
            let tmp_b = b[col]
            b[col] = b[pivot]
            b[pivot] = tmp_b
        }

        let diag = A[col * n + col]
        if mr_abs(diag) > 1.0e-30 {
            row = col + 1
            while row < n {
                let factor = A[row * n + col] / diag
                var k2 = col
                while k2 < n {
                    A[row * n + k2] = A[row * n + k2] - factor * A[col * n + k2]
                    k2 = k2 + 1
                }
                b[row] = b[row] - factor * b[col]
                row = row + 1
            }
        }
        col = col + 1
    }

    var i: i64 = n - 1
    while i >= 0 {
        var sum = b[i]
        var j: i64 = i + 1
        while j < n {
            sum = sum - A[i * n + j] * x[j]
            j = j + 1
        }
        let diag = A[i * n + i]
        if mr_abs(diag) > 1.0e-30 {
            x[i] = sum / diag
        }
        i = i - 1
    }
    x
}

fn reduced_solve(A_r: [f64; 4096], b_r: [f64; 64], n_basis: i64) -> [f64; 64] with Mut, Div, Panic {
    var x_red: [f64; 64] = [0.0; 64]
    if n_basis == 2 {
        let a = A_r[0]
        let b = A_r[1]
        let c = A_r[2]
        let d = A_r[3]
        let det = a * d - b * c
        if mr_abs(det) > 1.0e-30 {
            x_red[0] = (b_r[0] * d - b * b_r[1]) / det
            x_red[1] = (a * b_r[1] - b_r[0] * c) / det
        }
    } else {
        var b_full: [f64; 256] = [0.0; 256]
        var i: i64 = 0
        while i < n_basis {
            b_full[i] = b_r[i]
            i = i + 1
        }
        let x_full = direct_solve(A_r, b_full, n_basis)
        i = 0
        while i < n_basis {
            x_red[i] = x_full[i]
            i = i + 1
        }
    }
    x_red
}

fn error_estimate(A: [f64; 4096], b: [f64; 256], V: [f64; 4096], u_r: [f64; 64], n_dof: i64, n_basis: i64) -> f64 with Mut, Div, Panic {
    let u_full = reconstruct(V, u_r, n_dof, n_basis)
    var res: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < n_dof {
        var sum = 0.0
        var j: i64 = 0
        while j < n_dof {
            sum = sum + A[i * n_dof + j] * u_full[j]
            j = j + 1
        }
        res[i] = b[i] - sum
        i = i + 1
    }
    let res_norm = mr_norm2(res, n_dof)
    let b_norm = mr_norm2(b, n_dof)
    if b_norm < 1.0e-30 { res_norm } else { res_norm / b_norm }
}

fn deim_select(U: [f64; 4096], n_dof: i64, m: i64) -> [i64; 64] with Mut, Div, Panic {
    var P: [i64; 64] = [0; 64]
    if m <= 0 { return P }

    var best0 = 0
    var best0_val = mr_abs(U[0 * m + 0])
    var i: i64 = 1
    while i < n_dof {
        let v = mr_abs(U[i * m + 0])
        if v > best0_val {
            best0 = i
            best0_val = v
        }
        i = i + 1
    }
    P[0] = best0

    if m > 1 {
        let pivot0 = U[P[0] * m + 0]
        var best1 = 0
        var best1_val = -1.0
        i = 0
        while i < n_dof {
            let approx = if mr_abs(pivot0) > 1.0e-30 { U[i * m + 0] * (U[P[0] * m + 1] / pivot0) } else { 0.0 }
            let resid = mr_abs(U[i * m + 1] - approx)
            if resid > best1_val && i != P[0] {
                best1 = i
                best1_val = resid
            }
            i = i + 1
        }
        P[1] = best1
    }
    P
}

fn deim_approximate(U: [f64; 4096], P: [i64; 64], f_full: [f64; 256], n_dof: i64, m: i64) -> [f64; 256] with Mut, Div, Panic {
    var out: [f64; 256] = [0.0; 256]
    if m == 0 { return out }

    var coeff: [f64; 64] = [0.0; 64]
    if m == 1 {
        let p0 = P[0]
        let diag = U[p0 * m + 0]
        if mr_abs(diag) > 1.0e-30 { coeff[0] = f_full[p0] / diag }
    } else {
        let p0 = P[0]
        let p1 = P[1]
        let a = U[p0 * m + 0]
        let b = U[p0 * m + 1]
        let c = U[p1 * m + 0]
        let d = U[p1 * m + 1]
        let det = a * d - b * c
        if mr_abs(det) > 1.0e-30 {
            coeff[0] = (f_full[p0] * d - b * f_full[p1]) / det
            coeff[1] = (a * f_full[p1] - f_full[p0] * c) / det
        }
    }

    var i: i64 = 0
    while i < n_dof {
        var sum = 0.0
        var j: i64 = 0
        while j < m {
            sum = sum + U[i * m + j] * coeff[j]
            j = j + 1
        }
        out[i] = sum
        i = i + 1
    }
    out
}

fn test_basis_orthonormal() -> bool with Mut, Div, Panic {
    let V = build_test_basis_4x2()
    let dot00 = V[0] * V[0] + V[4] * V[4]
    let dot11 = V[3] * V[3] + V[7] * V[7]
    let dot01 = V[0] * V[1] + V[2] * V[3] + V[4] * V[5] + V[6] * V[7]
    mr_abs(dot00 - 1.0) < 1.0e-12 &&
    mr_abs(dot11 - 1.0) < 1.0e-12 &&
    mr_abs(dot01) < 1.0e-12
}

fn test_projection_roundtrip() -> bool with Mut, Div, Panic {
    let V = build_test_basis_4x2()
    var u_exact: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < 4 {
        u_exact[i] = 3.0 * V[i * 2 + 0] + 2.0 * V[i * 2 + 1]
        i = i + 1
    }
    let u_r = project_vector(V, u_exact, 4, 2)
    let u_rec = reconstruct(V, u_r, 4, 2)
    i = 0
    while i < 4 {
        if mr_abs(u_exact[i] - u_rec[i]) > 1.0e-8 { return false }
        i = i + 1
    }
    true
}

fn test_reduced_solve_matches_direct() -> bool with Mut, Div, Panic {
    let V = build_test_basis_4x2()
    let A = build_spd_4x4(0.5)
    var u_target: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < 4 {
        u_target[i] = 3.0 * V[i * 2 + 0] + 2.0 * V[i * 2 + 1]
        i = i + 1
    }

    var b: [f64; 256] = [0.0; 256]
    i = 0
    while i < 4 {
        var sum = 0.0
        var j: i64 = 0
        while j < 4 {
            sum = sum + A[i * 4 + j] * u_target[j]
            j = j + 1
        }
        b[i] = sum
        i = i + 1
    }

    let A_r = project_matrix(V, A, 4, 2)
    let b_r = project_vector(V, b, 4, 2)
    let u_r = reduced_solve(A_r, b_r, 2)
    let u_rec = reconstruct(V, u_r, 4, 2)
    let u_dir = direct_solve(A, b, 4)
    i = 0
    while i < 4 {
        if mr_abs(u_rec[i] - u_dir[i]) > 1.0e-8 { return false }
        i = i + 1
    }
    true
}

fn test_error_estimate_nonnegative() -> bool with Mut, Div, Panic {
    let V = build_test_basis_4x2()
    let A = build_spd_4x4(0.5)
    var b: [f64; 256] = [0.0; 256]
    b[0] = 1.0; b[1] = 2.0; b[2] = 3.0; b[3] = 4.0
    var u_r: [f64; 64] = [0.0; 64]
    u_r[0] = 1.0; u_r[1] = 0.5
    let err = error_estimate(A, b, V, u_r, 4, 2)
    err >= 0.0
}

fn test_deim_indices_valid() -> bool with Mut, Div, Panic {
    let U = build_test_basis_4x2()
    let P = deim_select(U, 4, 2)
    P[0] >= 0 && P[0] < 4 && P[1] >= 0 && P[1] < 4 && P[0] != P[1]
}

fn test_deim_exact_on_span() -> bool with Mut, Div, Panic {
    let U = build_test_basis_4x2()
    let P = deim_select(U, 4, 2)
    var f_full: [f64; 256] = [0.0; 256]
    var i: i64 = 0
    while i < 4 {
        f_full[i] = 2.0 * U[i * 2 + 0] + 3.0 * U[i * 2 + 1]
        i = i + 1
    }
    let approx = deim_approximate(U, P, f_full, 4, 2)
    i = 0
    while i < 4 {
        if mr_abs(f_full[i] - approx[i]) > 1.0e-8 { return false }
        i = i + 1
    }
    true
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var passed = 0
    var failed = 0

    print("=== MOR / DEIM Tests ===\n")

    print("T1: Basis orthonormal................. ")
    if test_basis_orthonormal() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T2: Projection roundtrip.............. ")
    if test_projection_roundtrip() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T3: Reduced solve matches direct...... ")
    if test_reduced_solve_matches_direct() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T4: Error estimate nonnegative........ ")
    if test_error_estimate_nonnegative() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T5: DEIM indices valid................ ")
    if test_deim_indices_valid() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("T6: DEIM exact on span................ ")
    if test_deim_exact_on_span() { println("PASS"); passed = passed + 1 } else { println("FAIL"); failed = failed + 1 }

    print("\nPassed: ")
    print_int(passed)
    print("\nFailed: ")
    print_int(failed)
    print("\n")

    if failed == 0 {
        print("ALL 6 TESTS PASSED\n")
        0
    } else {
        1
    }
}
