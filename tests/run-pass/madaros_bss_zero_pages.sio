//@ run-pass
//@ expect-stdout: BSS_ZERO_PAGES_OK
// Odd byte lengths exercise partial pages beside nonzero neighbors.
var LEFT_WORD: i64 = 2718
var ZERO_BYTES: [i8; 12293] = [0; 12293]
var MIDDLE_WORD: i64 = 31415
var ZERO_WORDS: [i64; 8193] = [0; 8193]
var RIGHT_WORD: i64 = 42
var FILLED_BYTES: [i8; 8193] = [7; 8193]
var DISTINCT_WORDS: [i64; 4] = [3, 0, 5, 0]

fn main() -> i32 with IO, Mut, Panic {
    if LEFT_WORD != 2718 || MIDDLE_WORD != 31415 || RIGHT_WORD != 42 { return 1 }
    var i: i64 = 0
    while i < 12293 {
        if ZERO_BYTES[i as usize] != 0 { return 2 }
        i = i + 1
    }
    i = 0
    while i < 8193 {
        if ZERO_WORDS[i as usize] != 0 { return 3 }
        if FILLED_BYTES[i as usize] != 7 { return 4 }
        i = i + 1
    }
    if DISTINCT_WORDS[0] != 3 || DISTINCT_WORDS[1] != 0 || DISTINCT_WORDS[2] != 5 || DISTINCT_WORDS[3] != 0 { return 5 }
    ZERO_BYTES[12292] = 17
    ZERO_WORDS[8192] = 23
    if ZERO_BYTES[12292] != 17 || ZERO_WORDS[8192] != 23 { return 6 }
    println("BSS_ZERO_PAGES_OK")
    0
}
