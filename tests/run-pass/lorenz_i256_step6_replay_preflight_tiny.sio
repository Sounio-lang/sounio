//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 replay preflight checks masks before validation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 509
    fp = mix(fp, 6, 3919)
    fp = mix(fp, 929938975, 3919)
    fp = mix(fp, 531834411, 3919)
    fp = mix(fp, 641464796, 3919)
    fp = mix(fp, 1, 3919)
    fp = mix(fp, 1, 3919)
    fp = mix(fp, 4, 3919)
    fp = mix(fp, 4, 3919)
    fp = mix(fp, 15, 3919)
    fp = mix(fp, 15, 3919)
    fp = mix(fp, 15, 3919)
    fp = mix(fp, 0, 3919)
    fp = mix(fp, 6, 3919)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 416249604 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 521
    fp = mix(fp, instance, 3931)
    fp = mix(fp, 4, 3931)
    fp = mix(fp, 4, 3931)
    fp = mix(fp, 15, 3931)
    fp = mix(fp, 15, 3931)
    fp = mix(fp, 15, 3931)
    fp = mix(fp, 15, 3931)
    fp = mix(fp, 0, 3931)
    fp = mix(fp, 6, 3931)
    fp = mix(fp, ok_mask, 3931)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 416249604 { return 0 - 1 }
    if certificate != 539977104 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 523
    fp = mix(fp, instance, 3947)
    fp = mix(fp, certificate, 3947)
    fp = mix(fp, 7, 3947)
    fp = mix(fp, 6, 3947)
    fp = mix(fp, 1, 3947)
    fp = mix(fp, 1, 3947)
    fp = mix(fp, 6, 3947)
    fp = mix(fp, ok_mask, 3947)
    return fp
}

fn replay_mask() -> i64 {
    let obligation_mask: i64 = 15
    let replay_order_mask: i64 = 15
    let replayed_node_mask: i64 = 15
    let predecessor_ready_mask: i64 = 15
    let validated_mask: i64 = 0
    let replay_status: i64 = 6

    var ok_mask: i64 = 0
    if 929938975 > 0 {
        if 641464796 > 0 { ok_mask = ok_mask + 1 }
    }
    if obligation_mask == 15 {
        if predecessor_ready_mask == 15 { ok_mask = ok_mask + 2 }
    }
    if replay_order_mask == obligation_mask {
        if replayed_node_mask == replay_order_mask { ok_mask = ok_mask + 4 }
    }
    if replay_status == 6 { ok_mask = ok_mask + 8 }
    if validated_mask == 0 { ok_mask = ok_mask + 16 }
    if 929938975 != 641464796 { ok_mask = ok_mask + 32 }
    if 1 == 1 { ok_mask = ok_mask + 64 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = replay_mask()
    if ok_mask != 127 { return 1 }
    let inst = instance_fp()
    if inst != 416249604 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 539977104 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 490362827 { return 4 }
    if certificate_fp(inst, 126) != (0 - 1) { return 5 }
    return 0
}
