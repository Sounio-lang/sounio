//@ run-pass
//@ requires: madaros
//@ known-failure: source-level i256 Lorenz high-scale numerator products: main returns 3. Not a segfault/139
//@ description: Lorenz i256 high-scale numerator smoke before multi-limb division

fn main() -> i64 {
    let ten10: i256 = 10000000000 as i256
    let scale: i256 = ten10 * ten10
    let dt: i256 = scale / (100 as i256)

    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale
    let rho: i256 = 28 as i256

    let rho_scale_minus_z: i256 = (rho * scale) - z
    let dy_num: i256 = x * rho_scale_minus_z
    let xy_num: i256 = x * y
    let beta_num_z: i256 = (8 as i256) * z
    let dt_dy_num: i256 = dt * ((26 as i256) * scale)

    if scale != ((10000000000 as i256) * (10000000000 as i256)) { return 1 }
    if dt != (1000000000000000000 as i256) { return 2 }
    if rho_scale_minus_z != (27 as i256) * scale { return 3 }
    if dy_num != (27 as i256) * scale * scale { return 4 }
    if xy_num != scale * scale { return 5 }
    if beta_num_z != (8 as i256) * scale { return 6 }
    if dt_dy_num != (26 as i256) * scale * (scale / (100 as i256)) { return 7 }
    if dy_num <= xy_num { return 8 }

    return 0
}
