//@ run-pass
// Phase 4b of Seq<T>: Seq as a struct field + field-receiver operations.
//   obj.field.push(v)   — grows and writes the moved pointer back into the field
//   obj.field.len()      obj.field.get(i)      obj.field[i]
// This is the access pattern the ontology stdlib uses (class.superclasses.push(...),
// class.superclasses[i] in for i in 0..n loops).

struct Bag { items: Seq<i64>, tag: i64 }

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var b: Bag = Bag { items: seq_new(), tag: 77 }

    // push directly to the field, across grows (forces realloc + writeback to field)
    var i = 0
    while i < 30 { b.items.push(i * 2); i = i + 1 }

    if b.tag != 77 { println("seq_field: FAIL (tag clobbered)"); return 1 }
    if b.items.len().unwrap("n") != 30 { println("seq_field: FAIL (field len)"); return 1 }
    if b.items.get(0) != 0 { println("seq_field: FAIL (field get 0)"); return 1 }
    if b.items.get(29) != 58 { println("seq_field: FAIL (field get last)"); return 1 }

    // field subscript read, including a for-style loop like the ontology
    if b.items[7] != 14 { println("seq_field: FAIL (field subscript)"); return 1 }
    var sum = 0
    var j = 0
    let n = b.items.len().unwrap("n")
    while j < n { sum = sum + b.items[j as i64]; j = j + 1 }
    // sum of 0,2,4,...,58 = 2*(0+1+...+29) = 2*435 = 870
    if sum != 870 { println("seq_field: FAIL (field loop sum)"); return 1 }

    println("seq_field: PASS")
    return 0
}
