//@ run-pass
//@ requires: madaros
//@ expect-stdout: measure variance joins: PASS

fn main() -> i32 with IO, Epistemic, Correlated, Mut, Panic, Div {
    let a = measure(1.0, uncertainty: 0.1)
    let b = measure(2.0, uncertainty: 0.2)
    let sum = a + b
    let bounded: Knowledge<f64, epsilon < 0.06> = sum
    let reverse = b + a
    let reverse_bounded: Knowledge<f64, epsilon < 0.06> = reverse
    let twice = a + a
    let twice_bounded: Knowledge<f64, epsilon < 0.05> = twice
    let unknown = measure(10.0, uncertainty: 2.5)
    let mixed = unknown + b
    let mixed_reverse = b + unknown
    assert(bounded.value == 3.0)
    assert(reverse_bounded.value == 3.0)
    assert(twice_bounded.value == 2.0)
    assert(mixed.value == 12.0)
    assert(mixed_reverse.value == 12.0)
    print("measure variance joins: PASS\n")
    0
}
