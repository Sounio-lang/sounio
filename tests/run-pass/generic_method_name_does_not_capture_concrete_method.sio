//@ run-pass
//@ description: a turbofish-less call `c.push(5)` on a concrete struct is not mistaken for the same-named method of an unrelated generic impl (`impl Gen<T> { fn push(.., v: T) }`); the AST-only specializer matched methods by name and failed the whole compile with "generic method specialization requires one unambiguous explicit turbofish" (tests/stdlib/collections/test_heap_vec_methods.sio, HeapI64Vec::push vs HeapVec<T>::push)
//@ expect-stdout: CONCRETE_PUSH_OK

struct Gen<T> { n: i64 }

impl Gen<T> {
    fn push(self: &!Gen<T>, v: T) with Mut {
        self.n = self.n + 1
    }
}

struct Conc { n: i64 }

impl Conc {
    fn push(self: &!Conc, v: i64) with Mut {
        self.n = self.n + v
    }
}

fn main() -> i32 with IO, Mut {
    var c = Conc { n: 0 }
    c.push(5)
    c.push(6)
    if c.n != 11 { return 1 }
    println("CONCRETE_PUSH_OK")
    0
}
