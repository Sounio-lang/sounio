//@ check-only
// Imported API conformance for proof-carrying policy-state feedback D5.

use epistemic::proof_carrying_policy_state_feedback::*

fn main() with Panic {
    let low = declare_policy_target_hypothesis(510, 0, 520)
    let high = declare_policy_target_hypothesis(511, 1, 520)
    let family = declare_adaptive_observation_policy_family(520, 8400, low, high)
    let budget = declare_synthetic_observation_budget(8500, 8400)

    assert(low.anchor_value == high.anchor_value)
    assert(low.hidden_target_value == 2 && high.hidden_target_value == 8)
    assert(!family.family_exhaustive_in_reality && family.synthetic_scope_only)
    assert(budget.capacity_units == 7)
    assert(!budget.consent_authority && !budget.ethics_approval)
    assert(!budget.subjective_suffering_measured && !budget.clinical_authority)

    let anchor_provenance = record_policy_evidence_provenance(
        8101, 7001, 8400, 1, 0, 0, false,
    )
    let anchor = record_observed_anchor_value(7101, anchor_provenance)
    assert(anchor.observed_value == 2 && anchor.value_present)
    assert(!anchor.target_tick_observed)

    let initial = begin_policy_state_contest(6000, family, budget)
    let anchor_update = update_policy_state_contest_with_anchor(
        6101, 6102, initial, family, anchor,
    )
    let after_anchor = policy_state_transition_result(anchor_update)
    assert(policy_state_survivor_mask(after_anchor) == 3)
    assert(policy_state_survivor_count(after_anchor) == 2)
    assert(policy_state_burden_spent(after_anchor) == 3)
    assert(policy_state_burden_remaining(after_anchor) == 4)
    assert(policy_state_provenance_fingerprint(after_anchor) == 8101)

    let summary = summarize_policy_state_after_anchor(8201, after_anchor)
    assert(summary.summary_code == 2)
    assert(summary.based_only_on_observed_anchor)
    assert(!summary.hidden_target_value_included && !summary.target_identified)

    let decision = derive_adaptive_exploit_policy_decision(8102, summary)
    assert(decision.candidate_considered)
    assert(!decision.eligible_under_adaptive_policy && !decision.scheduled)
    assert(decision.withheld_by_adaptive_policy)
    assert(!decision.observed_target_claimed)
    assert(!decision.participant_nonresponse_claimed)

    let gap = certify_policy_coverage_gap(8301, decision)
    assert(gap.eligible_opportunities == 0 && gap.observed_opportunities == 0)
    assert(!gap.discriminating_cell_covered)
    assert(!gap.support_for_policy_comparison_present)
    assert(!gap.statistical_positivity_established && !gap.global_overlap_established)

    let nonidentification = certify_policy_comparison_nonidentification(8302, gap)
    assert(!nonidentification.support_present)
    assert(!nonidentification.target_policy_value_identified)
    assert(!nonidentification.counterfactual_policy_order_identified)
    assert(!nonidentification.global_policy_claim_authorized)

    let feedback = certify_bounded_policy_state_feedback(8401, summary, decision)
    assert(feedback.bounded_iteration_count == 2)
    assert(feedback.first_summary_code == feedback.second_summary_code)
    assert(!feedback.first_probe_eligible && !feedback.second_probe_eligible)
    assert(!feedback.first_probe_scheduled && !feedback.second_probe_scheduled)
    assert(feedback.observed_trace_equal_across_hypotheses)
    assert(feedback.policy_trace_equal_across_hypotheses)
    assert(feedback.absorbing_within_frozen_fixture)
    assert(feedback.feedback_fingerprint == 259233)
    assert(!feedback.global_equilibrium_established)
    assert(!feedback.causal_feedback_mechanism_established)

    let ambiguity = certify_policy_induced_target_ambiguity(
        8402, low, high, family, after_anchor, summary, decision, gap,
    )
    assert(ambiguity.survivor_mask == 3 && ambiguity.survivor_count == 2)
    assert(ambiguity.low_hypothesis_survives && ambiguity.high_hypothesis_survives)
    assert(ambiguity.low_hidden_target_value == 2)
    assert(ambiguity.high_hidden_target_value == 8)
    assert(ambiguity.observed_anchor_traces_equal)
    assert(ambiguity.adaptive_policy_traces_equal)
    assert(ambiguity.coverage_gap_present)
    assert(!ambiguity.target_value_observed && !ambiguity.target_identified)

    let assignment = declare_synthetic_exogenous_coverage_assignment(
        8600, 8400, budget, gap,
    )
    assert(assignment.coverage_id == gap.coverage_id)
    assert(assignment.logging_policy_decision_id == decision.decision_id)
    assert(assignment.outside_adaptive_policy)
    assert(assignment.exogenous_within_frozen_fixture)
    assert(!assignment.real_person_randomization_claimed)
    assert(!assignment.consent_authority && !assignment.ethics_approval)

    let probe_provenance = record_policy_evidence_provenance(
        8103, 7003, 8400, 2, 8101, 8102, true,
    )
    let low_probe = admit_exogenous_coverage_probe(
        8701, family, assignment, gap, decision, probe_provenance, 2,
    )
    let low_observed = observed_target_from_probe(8801, low_probe)
    assert(low_observed.target_tick == 2 && low_observed.observed_value == 2)
    assert(low_observed.value_present && low_observed.synthetic_fixture_only)
    let low_update = update_policy_state_contest_with_probe(
        8901, 8902, after_anchor, family, low_probe,
    )
    let after_low = policy_state_transition_result(low_update)
    assert(policy_state_survivor_mask(after_low) == 1)
    assert(policy_state_survivor_count(after_low) == 1)
    assert(policy_state_burden_spent(after_low) == 7)
    assert(policy_state_burden_remaining(after_low) == 0)
    assert(policy_state_provenance_fingerprint(after_low) == 259234)
    let low_identification = certify_declared_within_family_target_identification(
        9001, low_update, family, low_observed,
    )
    assert(low_identification.selected_hypothesis_id == 510)
    assert(low_identification.selected_mode == 0)
    assert(low_identification.observed_target_value == 2)
    assert(low_identification.target_identified_within_declared_family)
    assert(!low_identification.policy_value_identified)
    assert(!low_identification.global_positivity_established)
    assert(!low_identification.empirical_model_established)
    assert(!low_identification.clinical_authority)

    let high_probe = admit_exogenous_coverage_probe(
        8702, family, assignment, gap, decision, probe_provenance, 8,
    )
    let high_observed = observed_target_from_probe(8802, high_probe)
    let high_update = update_policy_state_contest_with_probe(
        8903, 8904, after_anchor, family, high_probe,
    )
    let after_high = policy_state_transition_result(high_update)
    assert(policy_state_survivor_mask(after_high) == 2)
    let high_identification = certify_declared_within_family_target_identification(
        9002, high_update, family, high_observed,
    )
    assert(high_identification.selected_hypothesis_id == 511)
    assert(high_identification.selected_mode == 1)
    assert(high_identification.observed_target_value == 8)
    assert(!high_identification.policy_value_identified)

    let refused = refuse_observation_action_over_budget(9101, after_low, 4)
    assert(refused.capacity_units == 7 && refused.already_spent_units == 7)
    assert(refused.remaining_units == 0 && refused.requested_units == 4)
    assert(refused.excess_units == 4 && !refused.action_executed)
    assert(!refused.target_value_observed)
    assert(!refused.consent_withdrawal_claimed)
    assert(!refused.subjective_suffering_claimed)

    let disconnected = disconnect_coverage_probe(low_probe)
    let disconnected_abstention = abstain_on_disconnected_coverage_probe(
        9201, after_anchor, disconnected,
    )
    assert(disconnected_abstention.survivor_mask_unchanged == 3)
    assert(disconnected_abstention.hypotheses_eliminated == 0)
    assert(disconnected_abstention.inference_deferred)

    let erased = erase_policy_from_feedback(9301, feedback, decision)
    let erased_abstention = abstain_on_policy_erased_feedback(
        9302, after_anchor, erased,
    )
    assert(erased_abstention.survivor_mask_unchanged == 3)
    assert(erased_abstention.hypotheses_eliminated == 0)

    let relabeled_low = declare_policy_target_hypothesis(610, 0, 521)
    let relabeled_high = declare_policy_target_hypothesis(611, 1, 521)
    let relabeled = declare_adaptive_observation_policy_family(
        521, 8400, relabeled_low, relabeled_high,
    )
    let relabel = certify_policy_state_relabel_invariance(9401, family, relabeled)
    assert(relabel.corresponding_hypothesis_ids_changed)
    assert(relabel.anchor_predictions_equal && relabel.target_predictions_equal)
    assert(relabel.adaptive_policy_predictions_equal)
    assert(relabel.partitions_invariant)
}
