//@ run-pass
//@ requires: madaros
//@ expect-stdout: MODULE_DIRECTORY_FALLBACK_OK
// File wins over directory; mod.sio wins over legacy lib.sio within each search root.
use tests::fixtures::module_directory_fallback::mod_only::{directory_mod_value};
use tests::fixtures::module_directory_fallback::lib_only::{directory_lib_value};
use tests::fixtures::module_directory_fallback::both::{directory_both_value};
use tests::fixtures::module_directory_fallback::file_wins::{directory_file_value};
use tests::fixtures::module_directory_fallback::nested::inner::{directory_nested_value};
use tests::fixtures::module_directory_fallback::explicit_mod::mod::{directory_explicit_mod_value};
use tests::fixtures::module_directory_fallback::explicit_lib::lib::{directory_explicit_lib_value};

fn main() -> i32 with IO, Mut, Panic {
    if directory_mod_value() != 42 { return 1 }
    if directory_lib_value() != 43 { return 2 }
    if directory_both_value() != 11 { return 3 }
    if directory_file_value() != 31 { return 4 }
    if directory_nested_value() != 44 { return 5 }
    if directory_explicit_mod_value() != 61 { return 6 }
    if directory_explicit_lib_value() != 62 { return 7 }
    println("MODULE_DIRECTORY_FALLBACK_OK")
    0
}
