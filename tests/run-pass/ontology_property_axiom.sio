//@ run-pass
// Test: ontology property axioms discharge refinement obligations
// Drug.potency >= 0.0 is an axiom; Rapamycin.potency > 0.8 strengthens it.
// When a Rapamycin is passed where { v: f64 | v >= 0.0 } is expected,
// the property axiom proves the refinement.

ontology Pharma {
    class ChemicalEntity
    class Drug subclass_of ChemicalEntity {
        property potency: f64 where potency >= 0.0
        property half_life: f64 where half_life > 0.0
    }
    class Rapamycin subclass_of Drug {
        property potency: f64 where potency > 0.8
    }
}

fn main() -> i32 with IO {
    println("ontology property axioms OK")
    0
}
