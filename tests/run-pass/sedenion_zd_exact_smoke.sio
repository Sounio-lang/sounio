//@ run-pass
// Smoke test: EXACT i64 Cayley-Dickson engine (stdlib/algebra/cayley_dickson_exact_i64.sio).
//
// Proves, by DECIDABLE i64 equality (no tolerance, no float), that the canonical
// sedenion zero-divisor pair (e_3 + e_10)(e_6 - e_15) annihilates exactly.
// Also checks two controls: e_1 * e_1 == -1 (real part), and e_1 * e_2 != 0.

use algebra::cayley_dickson_exact_i64::{
    cd_basis_exact_i64, cd_add_exact_i64, cd_sub_exact_i64, cd_mul_exact_i64,
    cd_is_zero_exact_i64,
}

fn main() with IO, Mut, Panic, Div {
    let k: i32 = 4 // sedenions, dim 16

    // a = e_3 + e_10, b = e_6 - e_15
    let a = cd_add_exact_i64(cd_basis_exact_i64(k, 3), cd_basis_exact_i64(k, 10))
    let b = cd_sub_exact_i64(cd_basis_exact_i64(k, 6), cd_basis_exact_i64(k, 15))

    let r = cd_mul_exact_i64(a, b)

    if cd_is_zero_exact_i64(r) {
        println("ZD PROVED")
    } else {
        println("ZD FAIL")
        let n: i32 = 16
        var i: i32 = 0
        while i < n {
            if r.c[i as usize] != 0 {
                print("component ")
                print_int(i as i64)
                print(" = ")
                print_int(r.c[i as usize])
                print("\n")
            }
            i = i + 1
        }
    }

    // Control 1: e_1 * e_1 == -1 (real part).
    let u = cd_basis_exact_i64(k, 1)
    let w = cd_mul_exact_i64(u, u)
    if w.c[0] == (0 - 1) {
        println("SQ PASS")
    } else {
        println("SQ FAIL")
    }

    // Control 2: e_1 * e_2 is NOT zero.
    let e1 = cd_basis_exact_i64(k, 1)
    let e2 = cd_basis_exact_i64(k, 2)
    if !cd_is_zero_exact_i64(cd_mul_exact_i64(e1, e2)) {
        println("NONZERO PASS")
    } else {
        println("NONZERO FAIL")
    }
}
