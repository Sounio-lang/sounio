// ============================================================================
// Cross-phase: all three kernels produce valid PTX
// ============================================================================

fn test_all_three_kernels_nonzero() -> i64 {
    let s1 = hc_new()
    let r1 = hc_emit_oct_mul_tiled_kernel(s1, false)
    let s2 = hc_new()
    let r2 = hc_emit_oct_mul_dbuf_kernel(s2, false)
    let s3 = hc_new()
    let r3 = hc_emit_oct_mul_wmma_kernel(s3, false)
    let o1 = hc_get_output(r1)
    let o2 = hc_get_output(r2)
    let o3 = hc_get_output(r3)
    if o1.1 < 100 { return 1 }
    if o2.1 < 100 { return 2 }
    if o3.1 < 100 { return 3 }
    0
}

fn test_all_three_kernels_epistemic_nonzero() -> i64 {
    let s1 = hc_new()
    let r1 = hc_emit_oct_mul_tiled_kernel(s1, true)
    let s2 = hc_new()
    let r2 = hc_emit_oct_mul_dbuf_kernel(s2, true)
    let s3 = hc_new()
    let r3 = hc_emit_oct_mul_wmma_kernel(s3, true)
    let o1 = hc_get_output(r1)
    let o2 = hc_get_output(r2)
    let o3 = hc_get_output(r3)
    if o1.1 < 100 { return 1 }
    if o2.1 < 100 { return 2 }
    if o3.1 < 100 { return 3 }
    0
}

// ============================================================================
// Address arithmetic helper tests
// ============================================================================

fn test_add_u64_emits() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_add_u64(s, 0, 1, 2)
    let out = hc_get_output(s2)
    if out.1 < 10 { return 1 }
    0
}

fn test_mul_wide_u32_imm_emits() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_mul_wide_u32_imm(s, 0, 0, 32)
    let out = hc_get_output(s2)
    if out.1 < 10 { return 1 }
    0
}

fn test_st_global_f32_emits() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_st_global_f32(s, 0, 0)
    let out = hc_get_output(s2)
    if out.1 < 10 { return 1 }
    0
}

fn main() -> i64 {
    var fails: i64 = 0
    // Phase 2
    fails = fails + test_smem_decl_emits_shared()
    fails = fails + test_bar_sync_emits()
    fails = fails + test_ld_global_f32_emits()
    fails = fails + test_st_shared_f32_emits()
    fails = fails + test_ld_shared_f32_emits()
    fails = fails + test_tiled_kernel_emits_entry()
    fails = fails + test_tiled_kernel_epistemic_larger()
    fails = fails + test_tiled_kernel_has_smem_decl()
    // Phase 3
    fails = fails + test_cpasync_f32_emits()
    fails = fails + test_cpasync_commit_emits()
    fails = fails + test_cpasync_wait_emits()
    fails = fails + test_cpasync_wait_group_0()
    fails = fails + test_dbuf_kernel_emits_entry()
    fails = fails + test_dbuf_kernel_epistemic_larger()
    fails = fails + test_dbuf_kernel_larger_than_tiled()
    // Phase 6
    fails = fails + test_cvt_f16_f32_emits()
    fails = fails + test_cvt_f32_f16_emits()
    fails = fails + test_wmma_load_a_emits()
    fails = fails + test_wmma_load_b_emits()
    fails = fails + test_wmma_mma_emits()
    fails = fails + test_wmma_store_d_emits()
    fails = fails + test_wmma_kernel_emits_entry()
    fails = fails + test_wmma_kernel_epistemic_larger()
    // Cross-phase
    fails = fails + test_all_three_kernels_nonzero()
    fails = fails + test_all_three_kernels_epistemic_nonzero()
    // Helpers
    fails = fails + test_add_u64_emits()
    fails = fails + test_mul_wide_u32_imm_emits()
    fails = fails + test_st_global_f32_emits()

    fails
}
