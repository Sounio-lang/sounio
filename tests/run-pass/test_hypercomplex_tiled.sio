fn test_dbuf_kernel_emits_entry() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_oct_mul_dbuf_kernel(s, false)
    let out = hc_get_output(s2)
    // Double-buffered kernel should be substantial
    if out.1 < 500 { return 1 }
    0
}

fn test_dbuf_kernel_epistemic_larger() -> i64 {
    let s1 = hc_new()
    let r1 = hc_emit_oct_mul_dbuf_kernel(s1, false)
    let o1 = hc_get_output(r1)
    let s2 = hc_new()
    let r2 = hc_emit_oct_mul_dbuf_kernel(s2, true)
    let o2 = hc_get_output(r2)
    if o2.1 <= o1.1 { return 1 }
    0
}

fn test_dbuf_kernel_larger_than_tiled() -> i64 {
    let s1 = hc_new()
    let r1 = hc_emit_oct_mul_tiled_kernel(s1, false)
    let o1 = hc_get_output(r1)
    let s2 = hc_new()
    let r2 = hc_emit_oct_mul_dbuf_kernel(s2, false)
    let o2 = hc_get_output(r2)
    // dbuf kernel has 4 smem buffers vs 2, should be at least as large
    if o2.1 < o1.1 { return 1 }
    0
}

