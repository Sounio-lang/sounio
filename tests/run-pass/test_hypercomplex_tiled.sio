//@ run-pass
// Tests for Phase 2/3/6 tiled GEMM kernels in hypercomplex PTX emitter

// ============================================================================
// Phase 2: smem-tiled kernel tests
// ============================================================================

fn test_smem_decl_emits_shared() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_smem_decl(s, "tile_a", 131072)
    let out = hc_get_output(s2)
    let buf = out.0
    let len = out.1
    // Should have content
    if len < 10 { return 1 }
    0
}

fn test_bar_sync_emits() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_bar_sync(s)
    let out = hc_get_output(s2)
    if out.1 < 5 { return 1 }
    0
}

fn test_ld_global_f32_emits() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_ld_global_f32(s, 0, 0)
    let out = hc_get_output(s2)
    if out.1 < 10 { return 1 }
    0
}

fn test_st_shared_f32_emits() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_st_shared_f32(s, 0, 0)
    let out = hc_get_output(s2)
    if out.1 < 10 { return 1 }
    0
}

fn test_ld_shared_f32_emits() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_ld_shared_f32(s, 0, 0)
    let out = hc_get_output(s2)
    if out.1 < 10 { return 1 }
    0
}

fn test_tiled_kernel_emits_entry() -> i64 {
    let s = hc_new()
    let s2 = hc_emit_oct_mul_tiled_kernel(s, false)
    let out = hc_get_output(s2)
    // Tiled kernel should be substantial (many KB of PTX)
    if out.1 < 500 { return 1 }
    0
}

fn test_tiled_kernel_epistemic_larger() -> i64 {
    let s1 = hc_new()
    let r1 = hc_emit_oct_mul_tiled_kernel(s1, false)
    let o1 = hc_get_output(r1)
    let s2 = hc_new()
    let r2 = hc_emit_oct_mul_tiled_kernel(s2, true)
    let o2 = hc_get_output(r2)
    // Epistemic variant should be larger (extra params + eps handling)
    if o2.1 <= o1.1 { return 1 }
    0
}

fn test_tiled_kernel_has_smem_decl() -> i64 {
    // The tiled kernel should declare shared memory
    let s = hc_new()
    let s2 = hc_emit_oct_mul_tiled_kernel(s, false)
    let out = hc_get_output(s2)
    // Just check it produces >1KB of PTX (smem + loads + compute)
    if out.1 < 1000 { return 1 }
    0
}

