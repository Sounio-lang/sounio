//@ run-pass
//@ requires: madaros
//@ description: a user fn named str_eq with a different signature does not capture `string == string` (stdlib/str/lib.sio's pub str_eq(&Str, &Str) turned every string comparison of tests/stdlib/str/test_str.sio into a call with two string handles)
//@ expect-stdout: user str_eq ok
//@ expect-stdout: eq
//@ expect-stdout: ne ok
//@ expect-stdout: match ok

struct S { len: i64 }

fn str_eq(a: &S, b: &S) -> bool { a.len == b.len }

fn classify(s: string) -> i64 {
    match s {
        "42" => 1,
        _ => 0,
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let x = S { len: 1 }
    let y = S { len: 2 }
    if str_eq(&x, &x) && !str_eq(&x, &y) { print("user str_eq ok\n") }
    let s = "4" ++ "2"
    if s == "42" { print("eq\n") } else { return 1 }
    if s != "43" { print("ne ok\n") } else { return 2 }
    if classify(s) == 1 { print("match ok\n") } else { return 3 }
    0
}
