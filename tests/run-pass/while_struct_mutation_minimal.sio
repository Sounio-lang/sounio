//@ run-pass
// Minimal reproduction of while-loop struct mutation bug
// Expected: should complete 20 iterations
// Actual (BUG): freezes after 2-5 iterations

struct State {
    x: f64
}

fn main() -> i32 with IO, Div, Mut {
    var s = State { x: 0.0 }
    var i = 0

    while i < 20 {
        // Print iteration for debugging
        s = State { x: s.x + 1.0 }
        i = i + 1
    }

    // Should reach x = 20.0
    return 0
}
