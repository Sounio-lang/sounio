//@ run-pass
//@ description: Self-contained bounded SMT/Farkas microkernel smoke

fn smt_farkas2_lhs_sum(a1: i64, a2: i64, y1: i64, y2: i64) -> i64 {
    if y1 < 0 { return 0 - 9001 }
    if y2 < 0 { return 0 - 9001 }
    return (y1 * a1) + (y2 * a2)
}

fn smt_farkas2_rhs_sum(b1: i64, b2: i64, y1: i64, y2: i64) -> i64 {
    if y1 < 0 { return 0 - 9001 }
    if y2 < 0 { return 0 - 9001 }
    return (y1 * b1) + (y2 * b2)
}

fn smt_farkas2_unsat_check(
    a1: i64,
    b1: i64,
    a2: i64,
    b2: i64,
    y1: i64,
    y2: i64) -> i64 {
    if y1 < 0 { return 0 }
    if y2 < 0 { return 0 }
    let lhs = smt_farkas2_lhs_sum(a1, a2, y1, y2)
    if lhs != 0 { return 0 }
    let rhs = smt_farkas2_rhs_sum(b1, b2, y1, y2)
    if rhs < 0 { return 1 }
    return 0
}

fn main() -> i64 {
    let tiny_unsat = smt_farkas2_unsat_check(1, 0, 0 - 1, 0 - 1, 1, 1)
    if tiny_unsat != 1 { return 1 }

    let wrong_multiplier = smt_farkas2_unsat_check(1, 0, 0 - 1, 0 - 1, 1, 0)
    if wrong_multiplier != 0 { return 2 }

    let nonnegative_rhs = smt_farkas2_unsat_check(1, 0, 0 - 1, 1, 1, 1)
    if nonnegative_rhs != 0 { return 3 }

    let negative_multiplier = smt_farkas2_unsat_check(1, 0, 0 - 1, 0 - 1, 1, 0 - 1)
    if negative_multiplier != 0 { return 4 }

    let lhs = smt_farkas2_lhs_sum(1, 0 - 1, 1, 1)
    if lhs != 0 { return 5 }

    let rhs = smt_farkas2_rhs_sum(0, 0 - 1, 1, 1)
    if rhs != 0 - 1 { return 6 }

    let artifact_fp: i64 = 583104927
    let audit_fp: i64 = 719460238
    let instance_fp: i64 = 284916705
    let certificate_fp: i64 = 640271893
    let proof_family_mask: i64 = 3
    let proof_format_mask: i64 = 5
    let imported_runtime_evidence_mask: i64 = 0
    let public_claim_mask: i64 = 0
    let formal_theorem_ready: i64 = 0
    let microkernel_status: i64 = 100
    let ok_mask: i64 = 1023

    if artifact_fp != 583104927 { return 7 }
    if audit_fp != 719460238 { return 8 }
    if instance_fp != 284916705 { return 9 }
    if certificate_fp != 640271893 { return 10 }
    if proof_family_mask != 3 { return 11 }
    if proof_format_mask != 5 { return 12 }
    if imported_runtime_evidence_mask != 0 { return 13 }
    if public_claim_mask != 0 { return 14 }
    if formal_theorem_ready != 0 { return 15 }
    if microkernel_status != 100 { return 16 }
    if ok_mask != 1023 { return 17 }
    return 0
}
