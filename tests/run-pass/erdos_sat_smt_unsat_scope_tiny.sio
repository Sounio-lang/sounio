//@ run-pass
//@ description: Erdős SAT/SMT/UNSAT scope gates for #90 versus #508 claims

use theorem::erdos_scope::*

fn main() -> i64 {
    if erdos_problem_kind(90) != 1 { return 1 }
    if erdos_problem_kind(508) != 2 { return 2 }
    if erdos_problem_kind(704) != 3 { return 3 }

    let chi5_scope = erdos508_chi_lower_bound_preflight(508, 5, 1, 4, 31)
    if chi5_scope != 1 { return 4 }

    let chi6_scope = erdos508_chi6_preflight(508, 1, 5, 31)
    if chi6_scope != 1 { return 5 }

    let wrong_problem = erdos508_chi6_preflight(90, 1, 5, 31)
    if wrong_problem != 0 { return 6 }

    let missing_graph = erdos508_chi6_preflight(508, 0, 5, 31)
    if missing_graph != 0 { return 7 }

    let only_four_colour_unsat = erdos508_chi6_preflight(508, 1, 4, 31)
    if only_four_colour_unsat != 0 { return 8 }

    let weak_replay = erdos508_chi6_preflight(508, 1, 5, 15)
    if weak_replay != 0 { return 9 }

    let erdos90_external = erdos90_external_disproof_scope(90, 1, 1, 1, 0)
    if erdos90_external != 1 { return 10 }

    let erdos90_not_sounio_formalized = erdos90_external_disproof_scope(90, 1, 1, 1, 1)
    if erdos90_not_sounio_formalized != 0 { return 11 }

    let accepted_unsat = unsat_claim_acceptance_gate(0, 1, 1, 1, chi5_scope)
    if accepted_unsat != 1 { return 12 }

    let solver_only_unsat = unsat_claim_acceptance_gate(0, 1, 0, 0, chi5_scope)
    if solver_only_unsat != 0 { return 13 }

    let sat_result = unsat_claim_acceptance_gate(1, 1, 1, 1, chi5_scope)
    if sat_result != 0 { return 14 }

    return 0
}
