//@ run-pass
//@ requires: madaros
//@ expect-stdout: at 15.499224 1
//@ expect-stdout: far 3.546035 15.253116
//@ expect-stdout: EMPTY_INSIDE_OK
// At 450 K the pressure is twice the line and the parenthesis is 0.001.
// The two log bands do not meet, chi is 15.499224, and that used to
// come back unrefused because 450 K is inside the fitted 1/T values.
// Outside, the overlap is 3.546035-15.253116 and the chi-square refuses.

use epistemic::regression::plateau_pressure

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 400.0
    xs[1] = 1.0 / 450.0
    xs[2] = 1.0 / 500.0
    xs[3] = 1.0 / 550.0
    ys[0] = 0.0 - 1000.0 / 400.0
    ys[1] = 0.0 - 1000.0 / 450.0 + log(2.0)
    ys[2] = 0.0 - 1000.0 / 500.0
    ys[3] = 0.0 - 1000.0 / 550.0
    uln[0] = 0.2
    uln[1] = 0.001
    uln[2] = 0.2
    uln[3] = 0.2
    let at = plateau_pressure(xs, ys, uln, 4, 1.0 / 450.0, 100.0)
    let far = plateau_pressure(xs, ys, uln, 4, 1.0 / 300.0, 100.0)
    let at_blank = !at.open && at.refused && !(at.lo == at.lo) && !(at.hi == at.hi) && near(at.chi, 15.499224, 0.000001)
    let far_ok = far.open && far.refused && near(far.lo, 3.546035, 0.000001) && near(far.hi, 15.253116, 0.000001)
    print("at ")
    print_f64(at.chi)
    print(" ")
    print_int(bit(at.refused))
    println("")
    print("far ")
    print_f64(far.lo)
    print(" ")
    print_f64(far.hi)
    println("")
    if at_blank && far_ok {
        println("EMPTY_INSIDE_OK")
        return 0
    }
    println("EMPTY_INSIDE_FAIL")
    1
}
