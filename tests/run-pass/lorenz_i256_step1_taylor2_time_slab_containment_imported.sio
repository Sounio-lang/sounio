use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step1_taylor2_time_slab_containment_check(
        473585568, 790380830, 44353214, 431845922, 265853299, 0, 13)
    if artifact_fp != 180607828 { return 1 }
    let audit_fp = lorenz_i256_step1_taylor2_time_slab_containment_audit_fingerprint(
        artifact_fp, 781293646, 561666691, 473585568, 790380830,
        44353214, 431845922, 265853299, 1, 13, 255)
