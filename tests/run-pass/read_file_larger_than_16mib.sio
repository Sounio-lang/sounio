//@ run-pass
//@ description: #2832 — read_file returns the whole file when it is larger than 16 MiB (lean_single used one read() into a 16 MiB scratch and silently truncated to 16777216 bytes).
//@ expect-stdout: PASS

// formal/lean4/SounioSatG529.lean is a tracked, NUL-free 30.8 MB file (> 16 MiB)
// whose last line is `#print axioms g529_not_colourable`. The suite runs from the
// repository root.
fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    let path = "formal/lean4/SounioSatG529.lean"
    let want = file_size(path)
    if want <= 16777216 {
        print("FAIL setup: file_size=") print_int(want) print("\n")
        return 1
    }
    let s = read_file(path)
    let n = str_len(s)
    if n != want {
        print("FAIL read_file length=") print_int(n) print(" want=") print_int(want) print("\n")
        return 1
    }
    // last bytes: "colourable\n"
    if str_char_at(s, n - 1) != 10 || str_char_at(s, n - 2) != 101 || str_char_at(s, n - 11) != 99 {
        println("FAIL read_file tail bytes")
        return 1
    }
    println("PASS")
    return 0
}
