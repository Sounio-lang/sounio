//@ run-pass
// Scalarized native executor for the exact bounded synthetic D1 fixture.

struct Rational {
    numerator: i64,
    denominator: i64,
}

struct Bound {
    component_max: i64,
    carrier_max: i64,
    checked_before_multiplication: bool,
}

struct Rule {
    rule_id: i64,
    left_weight: i64,
    right_weight: i64,
    weight_denominator: i64,
    closes_intermediate_context: bool,
    empirically_calibrated: bool,
}

struct GroupedEvaluation {
    evaluation_id: i64,
    grouping_code: i64,
    intermediate: Rational,
    result: Rational,
    ordered_leaves_unchanged: bool,
}

struct AssociatorWitness {
    raw_numerator: i64,
    raw_denominator: i64,
    reduced_numerator: i64,
    reduced_denominator: i64,
    exact_nonzero: bool,
    grouping_only_difference: bool,
    ordinary_composition_claimed_nonassociative: bool,
    empirical_law_claimed: bool,
    causal_mechanism: bool,
    clinical_authority: bool,
}

struct AssociativeControl {
    left: Rational,
    right: Rational,
    exact_equal: bool,
    associator_zero: bool,
}

struct ExpandedStateRival {
    left_grouping_code: i64,
    right_grouping_code: i64,
    expanded_states_distinct: bool,
    frozen_transition_table_total: bool,
    exact_outputs_reproduced: bool,
    future_output_is_function_of_grouping_code: bool,
}

fn authorize_bound(component_max: i64, carrier_max: i64) -> Bound with Div, Panic {
    assert(component_max > 0 && carrier_max > 0)
    assert(component_max <= 1000000)
    assert(component_max <= carrier_max / component_max)
    let product_max = component_max * component_max
    assert(product_max <= carrier_max / 3)
    Bound {
        component_max: component_max,
        carrier_max: carrier_max,
        checked_before_multiplication: true,
    }
}

fn rational(numerator: i64, denominator: i64, bound: Bound) -> Rational with Panic {
    assert(numerator >= 0 && denominator > 0)
    assert(numerator <= bound.component_max)
    assert(denominator <= bound.component_max)
    Rational { numerator: numerator, denominator: denominator }
}

fn mediation_rule(rule_id: i64) -> Rule with Panic {
    assert(rule_id > 0)
    Rule {
        rule_id: rule_id,
        left_weight: 2,
        right_weight: 1,
        weight_denominator: 3,
        closes_intermediate_context: true,
        empirically_calibrated: false,
    }
}

fn checked_product(left: i64, right: i64, carrier_max: i64) -> i64 with Div, Panic {
    assert(left >= 0 && right >= 0 && carrier_max > 0)
    if right > 0 { assert(left <= carrier_max / right) }
    left * right
}

fn mediate(left: Rational, right: Rational, rule: Rule, bound: Bound) -> Rational with Div, Panic {
    let left_cross = checked_product(left.numerator, right.denominator, bound.carrier_max)
    let right_cross = checked_product(right.numerator, left.denominator, bound.carrier_max)
    let weighted_left = checked_product(rule.left_weight, left_cross, bound.carrier_max)
    let weighted_right = checked_product(rule.right_weight, right_cross, bound.carrier_max)
    assert(weighted_left <= bound.carrier_max - weighted_right)
    let denominator_cross = checked_product(left.denominator, right.denominator, bound.carrier_max)
    let denominator = checked_product(rule.weight_denominator, denominator_cross, bound.carrier_max)
    let numerator = weighted_left + weighted_right
    Rational { numerator: numerator, denominator: denominator }
}

fn left_grouped(a: Rational, b: Rational, c: Rational, rule: Rule, bound: Bound) -> GroupedEvaluation with Div, Panic {
    let ab = mediate(a, b, rule, bound)
    let result = mediate(ab, c, rule, bound)
    GroupedEvaluation {
        evaluation_id: 7201,
        grouping_code: 1,
        intermediate: ab,
        result: result,
        ordered_leaves_unchanged: true,
    }
}

fn right_grouped(a: Rational, b: Rational, c: Rational, rule: Rule, bound: Bound) -> GroupedEvaluation with Div, Panic {
    let bc = mediate(b, c, rule, bound)
    let result = mediate(a, bc, rule, bound)
    GroupedEvaluation {
        evaluation_id: 7202,
        grouping_code: 2,
        intermediate: bc,
        result: result,
        ordered_leaves_unchanged: true,
    }
}

fn gcd(a0: i64, b0: i64) -> i64 with Mut {
    var a = if a0 < 0 { -a0 } else { a0 }
    var b = if b0 < 0 { -b0 } else { b0 }
    while b != 0 {
        let r = a % b
        a = b
        b = r
    }
    if a == 0 { 1 } else { a }
}

fn prove_associator(left: GroupedEvaluation, right: GroupedEvaluation) -> AssociatorWitness with Div, Mut, Panic {
    assert(left.grouping_code == 1 && right.grouping_code == 2)
    let left_cross = checked_product(left.result.numerator, right.result.denominator, 9000000000000000000)
    let right_cross = checked_product(right.result.numerator, left.result.denominator, 9000000000000000000)
    let raw = left_cross - right_cross
    let denominator = checked_product(left.result.denominator, right.result.denominator, 9000000000000000000)
    assert(raw != 0)
    let divisor = gcd(raw, denominator)
    AssociatorWitness {
        raw_numerator: raw,
        raw_denominator: denominator,
        reduced_numerator: raw / divisor,
        reduced_denominator: denominator / divisor,
        exact_nonzero: true,
        grouping_only_difference: true,
        ordinary_composition_claimed_nonassociative: false,
        empirical_law_claimed: false,
        causal_mechanism: false,
        clinical_authority: false,
    }
}

fn add(left: Rational, right: Rational) -> Rational {
    Rational {
        numerator: left.numerator * right.denominator +
            right.numerator * left.denominator,
        denominator: left.denominator * right.denominator,
    }
}

fn equal(left: Rational, right: Rational) -> bool {
    left.numerator * right.denominator == right.numerator * left.denominator
}

fn associative_control(a: Rational, b: Rational, c: Rational) -> AssociativeControl with Panic {
    let left = add(add(a, b), c)
    let right = add(a, add(b, c))
    assert(equal(left, right))
    AssociativeControl {
        left: left,
        right: right,
        exact_equal: true,
        associator_zero: true,
    }
}

fn expanded_state_rival(left: GroupedEvaluation, right: GroupedEvaluation) -> ExpandedStateRival with Panic {
    assert(left.grouping_code != right.grouping_code)
    assert(left.grouping_code == 1 && right.grouping_code == 2)
    let predicted_left = Rational { numerator: 2550, denominator: 4500 }
    let predicted_right = Rational { numerator: 1950, denominator: 4500 }
    assert(equal(predicted_left, left.result))
    assert(equal(predicted_right, right.result))
    ExpandedStateRival {
        left_grouping_code: left.grouping_code,
        right_grouping_code: right.grouping_code,
        expanded_states_distinct: true,
        frozen_transition_table_total: true,
        exact_outputs_reproduced: true,
        future_output_is_function_of_grouping_code: true,
    }
}

fn main() with Div, Mut, Panic {
    let bound = authorize_bound(100000, 9000000000000000000)
    let rule = mediation_rule(7001)
    let a = rational(3, 10, bound)
    let b = rational(3, 5, bound)
    let c = rational(9, 10, bound)

    let left = left_grouped(a, b, c, rule, bound)
    let right = right_grouped(a, b, c, rule, bound)
    assert(left.intermediate.numerator == 60 && left.intermediate.denominator == 150)
    assert(right.intermediate.numerator == 105 && right.intermediate.denominator == 150)
    assert(left.result.numerator == 2550 && left.result.denominator == 4500)
    assert(right.result.numerator == 1950 && right.result.denominator == 4500)

    let witness = prove_associator(left, right)
    assert(witness.raw_numerator == 2700000)
    assert(witness.raw_denominator == 20250000)
    assert(witness.reduced_numerator == 2 && witness.reduced_denominator == 15)
    assert(!witness.ordinary_composition_claimed_nonassociative)
    assert(!witness.empirical_law_claimed)
    assert(!witness.causal_mechanism && !witness.clinical_authority)

    let control = associative_control(a, b, c)
    assert(control.exact_equal && control.associator_zero)
    assert(equal(control.left, Rational { numerator: 9, denominator: 5 }))
    assert(equal(control.right, Rational { numerator: 9, denominator: 5 }))

    let rival = expanded_state_rival(left, right)
    assert(rival.expanded_states_distinct)
    assert(rival.frozen_transition_table_total)
    assert(rival.exact_outputs_reproduced)
    assert(rival.future_output_is_function_of_grouping_code)
    assert(witness.exact_nonzero)

    println("D1-W0 left=2550/4500=17/30 right=1950/4500=13/30 associator=2700000/20250000=2/15")
    println("D1-W1 associative_control=9/5,9/5 associator=0")
    println("D1-W2 grouping=explicit same_rule=true same_ordered_leaves=true")
    println("D1-W3 expanded_grouping_state=distinct transition_table=total outputs=reproduced")
    println("boundary=synthetic empirical_law=false causal=false clinical=false irreducible_memory=false")
    println("SYNTHETIC DYADIC RELATIONAL ASSOCIATOR D1 PASS")
}
