// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Interpolation Algorithm Tests ===")
    println("")

    var passed: i32 = 0
    var failed: i32 = 0

    // Test 1
    print("Test  1: Piecewise linear exact..... ")
    if test_piecewise_linear_exact() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 2
    print("Test  2: Piecewise linear midpoint.. ")
    if test_piecewise_linear_midpoint() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 3
    print("Test  3: Piecewise linear clamp..... ")
    if test_piecewise_linear_extrapolate() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 4
    print("Test  4: Cubic spline exact......... ")
    if test_cubic_spline_exact() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 5
    print("Test  5: Cubic spline smooth........ ")
    if test_cubic_spline_smooth() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 6
    print("Test  6: Cubic spline quadratic..... ")
    if test_cubic_spline_quadratic() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 7
    print("Test  7: Cubic spline derivative.... ")
    if test_cubic_spline_derivative() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 8
    print("Test  8: Lagrange exact............. ")
    if test_lagrange_exact() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 9
    print("Test  9: Lagrange polynomial........ ")
    if test_lagrange_polynomial() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 10
    print("Test 10: Akima exact................ ")
    if test_akima_exact() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 11
    print("Test 11: Akima no wiggle............ ")
    if test_akima_no_wiggle() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed == 0 {
        println("ALL 11 TESTS PASSED")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
