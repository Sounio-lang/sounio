//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 local flowpipe proof receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1549
    fp = mix(fp, 2, 5413)
    fp = mix(fp, 532518987, 5413)
    fp = mix(fp, 763325627, 5413)
    fp = mix(fp, 85766158, 5413)
    fp = mix(fp, 81234415, 5413)
    fp = mix(fp, 311696236, 5413)
    fp = mix(fp, 301485983, 5413)
    fp = mix(fp, 482555681, 5413)
    fp = mix(fp, 591288676, 5413)
    fp = mix(fp, 444092349, 5413)
    fp = mix(fp, 625429438, 5413)
    fp = mix(fp, 633359277, 5413)
    fp = mix(fp, 421619310, 5413)
    fp = mix(fp, 7, 5413)
    fp = mix(fp, 7, 5413)
    fp = mix(fp, 127, 5413)
    fp = mix(fp, 127, 5413)
    fp = mix(fp, 15, 5413)
    fp = mix(fp, 15, 5413)
    fp = mix(fp, 15, 5413)
    fp = mix(fp, 0, 5413)
    fp = mix(fp, 21, 5413)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 420503797 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1553
    fp = mix(fp, instance, 5417)
    fp = mix(fp, 7, 5417)
    fp = mix(fp, 7, 5417)
    fp = mix(fp, 127, 5417)
    fp = mix(fp, 127, 5417)
    fp = mix(fp, 15, 5417)
    fp = mix(fp, 15, 5417)
    fp = mix(fp, 15, 5417)
    fp = mix(fp, 0, 5417)
    fp = mix(fp, 21, 5417)
    fp = mix(fp, ok_mask, 5417)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 420503797 { return 0 - 1 }
    if certificate != 884187166 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1559
    fp = mix(fp, instance, 5419)
    fp = mix(fp, certificate, 5419)
    fp = mix(fp, 16, 5419)
    fp = mix(fp, 2, 5419)
    fp = mix(fp, 15, 5419)
    fp = mix(fp, 15, 5419)
    fp = mix(fp, 0, 5419)
    fp = mix(fp, 21, 5419)
    fp = mix(fp, ok_mask, 5419)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 418029869 { return 0 - 1 }
    if instance != 420503797 { return 0 - 1 }
    if certificate != 884187166 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1567
    fp = mix(fp, artifact, 5431)
    fp = mix(fp, instance, 5431)
    fp = mix(fp, certificate, 5431)
    fp = mix(fp, 532518987, 5431)
    fp = mix(fp, 763325627, 5431)
    fp = mix(fp, 85766158, 5431)
    fp = mix(fp, 81234415, 5431)
    fp = mix(fp, 311696236, 5431)
    fp = mix(fp, 301485983, 5431)
    fp = mix(fp, 482555681, 5431)
    fp = mix(fp, 591288676, 5431)
    fp = mix(fp, 444092349, 5431)
    fp = mix(fp, 625429438, 5431)
    fp = mix(fp, 633359277, 5431)
    fp = mix(fp, 421619310, 5431)
    fp = mix(fp, 2, 5431)
    fp = mix(fp, 21, 5431)
    fp = mix(fp, ok_mask, 5431)
    return fp
}

fn proof_mask() -> i64 {
    let endpoint_mask: i64 = 7
    let slab_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_mask: i64 = 127
    var composition_mask: i64 = 0
    if endpoint_mask == 7 { composition_mask = composition_mask + 1 }
    if slab_mask == 7 { composition_mask = composition_mask + 2 }
    if response_mask == 127 { composition_mask = composition_mask + 4 }
    if remainder_mask == 127 { composition_mask = composition_mask + 8 }

    let local_obligation_mask: i64 = composition_mask
    let local_proof_mask: i64 = composition_mask
    let global_claim_mask: i64 = 0
    let status: i64 = 21

    var ok_mask: i64 = 0
    if 532518987 > 0 {
        if 763325627 > 0 { ok_mask = ok_mask + 1 }
    }
    if 85766158 > 0 {
        if 311696236 > 0 { ok_mask = ok_mask + 2 }
    }
    if 482555681 > 0 {
        if 444092349 > 0 { ok_mask = ok_mask + 4 }
    }
    if 633359277 > 0 { ok_mask = ok_mask + 8 }
    if local_obligation_mask == 15 {
        if local_proof_mask == 15 { ok_mask = ok_mask + 16 }
    }
    if global_claim_mask == 0 {
        if status == 21 { ok_mask = ok_mask + 32 }
    }
    if 2 == 2 {
        if 256 == 256 { ok_mask = ok_mask + 64 }
    }
    if local_proof_mask == 15 {
        if 67400844 > 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = proof_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 420503797 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 884187166 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 418029869 { return 4 }
    let audit = audit_fp(art, inst, cert, ok_mask)
    if audit != 518930343 { return 5 }
    if certificate_fp(inst, 254) != (0 - 1) { return 6 }
    return 0
}
