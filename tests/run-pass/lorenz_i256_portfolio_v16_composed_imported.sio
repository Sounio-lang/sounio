//@ run-pass
//@ requires: madaros
//@ description: Composed imported Lorenz i256 trajectory certificate into portfolio v16 bundle smoke

use systems::lorenz_i256_cert::*
use theorem::portfolio::*

fn main() -> i64 with Mod {
    let trajectory_manifest_fp = lorenz_i256_trajectory5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935)
    if trajectory_manifest_fp != 214180161 { return 1 }

    if lorenz_i256_trajectory5_manifest_valid(
        32, 42949672, 96, 5, 23144051, 561641681,
        trajectory_manifest_fp) != 1 { return 2 }

    let portfolio_fp = solver_portfolio_v16_lorenz_i256_trajectory5_bundle_fingerprint(
        660429472, trajectory_manifest_fp, 827916944)
    if portfolio_fp != 320118125 { return 3 }

    let result_coverage_fp = solver_portfolio_v16_result_coverage_fingerprint(
        16, 20, 7, 11, 1, 1, portfolio_fp)
    if result_coverage_fp != 685105937 { return 4 }

    let family_coverage_fp = solver_portfolio_v16_checker_family_coverage_fingerprint(
        16, 20, 4, 2, 2, 1, 11, portfolio_fp)
    if family_coverage_fp != 210011781 { return 5 }

    let acceptance_fp = solver_portfolio_v16_acceptance_receipt_fingerprint(
        16, portfolio_fp, result_coverage_fp)
    if acceptance_fp != 629028996 { return 6 }

    let audit_fp = solver_portfolio_v16_audit_receipt_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 932551699 { return 7 }

    let readiness_fp = solver_portfolio_v16_readiness_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 589844740 { return 8 }

    if solver_portfolio_v16_lorenz_i256_trajectory5_bundle_fingerprint(
        660429472, trajectory_manifest_fp + 1, 827916944) != (0 - 1) { return 9 }
    if solver_portfolio_v16_lorenz_i256_trajectory5_bundle_fingerprint(
        660429472, trajectory_manifest_fp, 827916945) != (0 - 1) { return 10 }
    if lorenz_i256_trajectory5_certificate_check(
        42949672, 95,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 11 }
    if lorenz_i256_trajectory5_certificate_check(
        42949672, 96,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731224, 4084837935) != (0 - 1) { return 12 }
    if solver_portfolio_v16_checker_family_coverage_fingerprint(
        16, 20, 4, 2, 2, 1, 10, portfolio_fp) != (0 - 1) { return 13 }
    if solver_portfolio_v16_readiness_fingerprint(
        16, portfolio_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 14 }

    return 0
}
