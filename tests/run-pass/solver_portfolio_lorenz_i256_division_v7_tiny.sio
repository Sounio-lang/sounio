//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v7 smoke for Lorenz i256 division witness certificate entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 11 { return 0 - 1 }
    if instance_fp <= 0 { return 0 - 1 }
    if certificate_fp <= 0 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 11 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v7_fingerprint(lorenz_i256_div_entry_fp: i64) -> i64 with Mod {
    if lorenz_i256_div_entry_fp <= 0 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 7, 1151)
    fp = portfolio_mix(fp, 11, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, lorenz_i256_div_entry_fp, 1151)
    return fp
}

fn main() -> i64 with Mod {
    let entry_fp = portfolio_entry_fingerprint(11, 660429472, 510854875, 1, 11)
    if entry_fp != 887056435 { return 1 }
    if portfolio_v7_fingerprint(entry_fp) != 35245852 { return 2 }

    if portfolio_entry_fingerprint(11, 660429472, 510854875, 0, 11) != (0 - 1) { return 3 }
    if portfolio_entry_fingerprint(10, 660429472, 510854875, 1, 11) != (0 - 1) { return 4 }
    if portfolio_entry_fingerprint(11, 660429472, 510854876, 1, 11) == 887056435 { return 5 }

    return 0
}
