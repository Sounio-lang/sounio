//@ known-failure: SRET forward-in-aggregate still miscompiled — tuple carries uninitialised memory (re-measured 2026-06-10)
//
// Regression pin: SRET forward-in-aggregate (2026-06-02 family).
// Forwarding a struct-returning call's result inside a tuple used to be a
// deterministic SIGSEGV (rc=139). As of the 2026-06-10 re-audit the crash is
// GONE but the value is still wrong: t.0.f0 reads uninitialised memory
// (e.g. 6.95e-310) and t.1 reads a garbage integer instead of 1. The plain
// (non-aggregate) forwarding shapes are fixed — see sret_forwarding_minimal.sio
// and sret_forwarding_cross_module_cd_mul.sio, both green.
// History: docs/audit/g1_wip/SRET_FORWARDING_CRASH_REPRO_2026-06-02.sio
// Audit:   docs/audit/MODULAR_COMPILER_AUDIT_2026-06-10.md

struct S { f0: f64 }

fn ctor() -> S with Mut {
    var p: S = S { f0: 7.0 }
    return p
}

fn make() -> (S, i64) with Mut {
    return (ctor(), 1)   // forward-in-aggregate: was SIGSEGV, now garbage values
}

fn main() -> i32 with IO, Mut {
    let t = make()
    if t.0.f0 > 6.9 && t.0.f0 < 7.1 && t.1 == 1 {
        println("SRET_FORWARDING_TUPLE_OK")
        return 0
    }
    println("SRET_FORWARDING_TUPLE_FAIL")
    1
}
