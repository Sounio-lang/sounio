//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v140 smoke for Lorenz i256 step-1 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt: i64 = 2027
    receipt = mix(receipt, 180607828, 6037)
    receipt = mix(receipt, 551960823, 6037)
    receipt = mix(receipt, 382273466, 6037)
    receipt = mix(receipt, 893496809, 6037)
    receipt = mix(receipt, 743392198, 6037)
    receipt = mix(receipt, 311818225, 6037)
    receipt = mix(receipt, 721641728, 6037)
    receipt = mix(receipt, 1, 6037)
    receipt = mix(receipt, 14, 6037)
    receipt = mix(receipt, 255, 6037)
    if receipt != 62233558 { return 1 }

    var audit: i64 = 2029
    audit = mix(audit, receipt, 6043)
    audit = mix(audit, 180607828, 6043)
    audit = mix(audit, 551960823, 6043)
    audit = mix(audit, 26998442, 6043)
    audit = mix(audit, 558635697, 6043)
    audit = mix(audit, 972140381, 6043)
    audit = mix(audit, 96825760, 6043)
    audit = mix(audit, 743392198, 6043)
    audit = mix(audit, 1, 6043)
    audit = mix(audit, 14, 6043)
    audit = mix(audit, 255, 6043)
    if audit != 104592626 { return 2 }

    var entry: i64 = 101
    entry = mix(entry, 143, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 143, 1103)
    if entry != 940931367 { return 3 }

    var manifest: i64 = 107
    manifest = mix(manifest, 140, 1151)
    manifest = mix(manifest, 144, 1151)
    manifest = mix(manifest, 893496809, 1151)
    manifest = mix(manifest, 382273466, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 788316508 { return 4 }

    var result: i64 = 131
    result = mix(result, 140, 1871)
    result = mix(result, 144, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 132, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 450493579 { return 5 }

    var family: i64 = 149
    family = mix(family, 140, 1907)
    family = mix(family, 144, 1907)
    family = mix(family, 6, 1907)
    family = mix(family, 4, 1907)
    family = mix(family, 3, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, 127, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, manifest, 1907)
    if family != 591945564 { return 6 }

    var acceptance: i64 = 137
    acceptance = mix(acceptance, 140, 1889)
    acceptance = mix(acceptance, manifest, 1889)
    acceptance = mix(acceptance, result, 1889)
    if acceptance != 95823883 { return 7 }

    var audit_receipt: i64 = 157
    audit_receipt = mix(audit_receipt, 140, 1931)
    audit_receipt = mix(audit_receipt, manifest, 1931)
    audit_receipt = mix(audit_receipt, result, 1931)
    audit_receipt = mix(audit_receipt, family, 1931)
    audit_receipt = mix(audit_receipt, acceptance, 1931)
    if audit_receipt != 978175425 { return 8 }

    var readiness: i64 = 163
    readiness = mix(readiness, 140, 1951)
    readiness = mix(readiness, 31, 1951)
    readiness = mix(readiness, manifest, 1951)
    readiness = mix(readiness, result, 1951)
    readiness = mix(readiness, family, 1951)
    readiness = mix(readiness, acceptance, 1951)
    readiness = mix(readiness, audit_receipt, 1951)
    if readiness != 191710845 { return 9 }
    return 0
}
