//@ run-pass
//@ requires: madaros
//@ description: `*acc += v` / `*acc -= v` / `*acc *= v` / `*acc /= v` on an &!f64 computes on the value, not on its IEEE-754 bit pattern
//@ expect-stdout: add_assign 2.000000
//@ expect-stdout: sub_assign 0.500000
//@ expect-stdout: mul_assign 3.000000
//@ expect-stdout: div_assign 0.750000
//@ expect-stdout: F64_DEREF_COMPOUND_PASS

// Companion to madaros_f64_deref_operand.sio. `t op= e` lowers as `t = t op e`
// (lower_assign_stmt_ref), so with t = `*acc` the synthesized binary has a
// dereference operand -- the shape that Madaros classified as an integer and
// computed on the bit pattern (1.0 += 1.0 printed 4607182418800017408.0).
// Madaros-only: lean_single refuses compound assignment (E260).

fn add_assign(acc: &!f64, v: f64) with Mut { *acc += v }
fn sub_assign(acc: &!f64, v: f64) with Mut { *acc -= v }
fn mul_assign(acc: &!f64, v: f64) with Mut { *acc *= v }
fn div_assign(acc: &!f64, v: f64) with Mut { *acc /= v }

fn main() -> i32 with IO, Mut, Div, Panic {
    var a: f64 = 1.0
    add_assign(&!a, 1.0)
    print("add_assign ") print_f64(a) println("")
    var b: f64 = 1.0
    sub_assign(&!b, 0.5)
    print("sub_assign ") print_f64(b) println("")
    var c: f64 = 1.5
    mul_assign(&!c, 2.0)
    print("mul_assign ") print_f64(c) println("")
    var d: f64 = 1.5
    div_assign(&!d, 2.0)
    print("div_assign ") print_f64(d) println("")
    if a == 2.0 && b == 0.5 && c == 3.0 && d == 0.75 {
        println("F64_DEREF_COMPOUND_PASS")
    } else {
        println("F64_DEREF_COMPOUND_FAIL")
    }
    0
}
