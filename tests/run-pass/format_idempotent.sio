// format_idempotent.sio — formatter test fixture
//
// This file contains intentionally messy formatting: mixed indentation,
// extra blank lines, trailing whitespace, and varied comma/arrow spacing.
// After one pass of `souc format`, the output must be stable (idempotent).
//
// NOTE: This file is a COMPILE-PASS fixture, not an executable. Its purpose
// is to supply real Sounio syntax for the idempotency discriminator.

//! doc-comment with https://example.com/path?a=1&b=2 preserved verbatim

// ============================================================================
// Structs
// ============================================================================

pub struct Point {
    pub x: f64
    pub y: f64
}

pub struct Segment {
    pub start: Point
    pub end:   Point
}

// ============================================================================
// Simple helpers (must precede callers)
// ============================================================================

fn abs_val(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn square(x: f64) -> f64 {
    x * x
}

fn sqrt_approx(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 40 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

// ============================================================================
// Geometry
// ============================================================================

fn distance(a: Point, b: Point) -> f64 with Mut, Div, Panic {
    let dx = a.x - b.x
    let dy = a.y - b.y
    sqrt_approx(square(dx) + square(dy))
}

fn midpoint(a: Point, b: Point) -> Point {
    Point { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }
}

fn segment_length(s: Segment) -> f64 with Mut, Div, Panic {
    distance(s.start, s.end)
}

// ============================================================================
// String-literal preservation check
// ============================================================================

fn label_for_quadrant(x: f64, y: f64) -> bool with IO {
    // Strings with commas, arrows, colons must not be altered.
    let msg = "key: value, next -> end"
    let url = "https://example.com/api?a=1,b=2"
    let esc = "quote: \"hello\", arrow: -> world"
    println(msg)
    println(url)
    println(esc)
    true
}

// ============================================================================
// Effects example
// ============================================================================

fn clamp(v: f64, lo: f64, hi: f64) -> f64 with Div, Panic {
    if v < lo { lo } else if v > hi { hi } else { v }
}

fn normalise(values: &[f64; 8], out: &![f64; 8]) with Mut, Div, Panic {
    var sum = 0.0
    var i = 0
    while i < 8 {
        sum = sum + (*values)[i]
        i = i + 1
    }
    if sum == 0.0 { return }
    var j = 0
    while j < 8 {
        (*out)[j] = (*values)[j] / sum
        j = j + 1
    }
}
