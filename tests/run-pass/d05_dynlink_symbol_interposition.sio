//@ run-pass
//@ requires: madaros
//@ expect-stdout: d05_dynlink_symbol_interposition: PASS
// D-05 (#2536): symbol interposition across DT_NEEDED libraries.
// Both libkl14d_a.so and libkl14d_b.so export `kl14d_interpose`.
// Under Option (A) ELF global scope order, the first DT_NEEDED library
// (libkl14d_a.so) provides the binding (101, not 202).

extern "C" {
    fn kl14d_a(x: i64) -> i64
    fn kl14d_b(x: i64) -> i64
    fn kl14d_interpose() -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = kl14d_a(10)
    let b = kl14d_b(10)
    let val = kl14d_interpose()
    if val == 101 {
        println("d05_dynlink_symbol_interposition: PASS")
        return 0
    }
    println("d05_dynlink_symbol_interposition: FAIL")
    return 1
}
