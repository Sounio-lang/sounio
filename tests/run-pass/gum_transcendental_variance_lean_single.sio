//@ run-pass
//@ requires: lean_single
//@ expect-stdout: var(sin a)=0.002919
//@ expect-stdout: var(exp a)=0.073891
//@ expect-stdout: var(log b)=0.010000
//@ expect-stdout: var(sqrt b)=0.005000
// #3551: first-order GUM, var(f(x)) = f'(x)^2 * var(x).
// exp deliberately uses first order here; Madaros uses exact lognormal variance.

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    let ka: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(2.0, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value
    print("var(sin a)="); print_f64(variance_of(sin(a))); print("\n")
    print("var(exp a)="); print_f64(variance_of(exp(a))); print("\n")
    print("var(log b)="); print_f64(variance_of(log(b))); print("\n")
    print("var(sqrt b)="); print_f64(variance_of(sqrt(b))); print("\n")
    return 0
}
