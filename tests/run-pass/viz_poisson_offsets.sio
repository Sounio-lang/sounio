//@ run-pass
//@ expect-stdout: VIZ_POISSON_OFFSETS_PASS
//@ expect-stdout: scatter n=8
//@ expect-stdout: Count model with known exposure offsets; log link
//@ expect-stdout: No intervals; Poisson assumptions and overdispersion unassessed
use stats::regression::poisson::{poisson_fit_offset}
use math::pure::{ln_checked,sqrt}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_scatter_chart,viz_add_line_chart,
 viz_line_set_viewport,viz_add_axis,viz_node_set_label,viz_add_label,
 viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var design:[f64;2048]=[0.0;2048]
 var counts:[i64;256]=[0;256]
 var offsets:[f64;256]=[0.0;256]
 var exposure:[f64;8]=[1.0,2.0,4.0,8.0,1.0,2.0,4.0,8.0]
 var events:[i64;8]=[1,3,5,9,3,5,9,17]
 var i:i64=0
 while i<8 {
  design[(8*i) as usize]=1.0
  design[(8*i+1) as usize]=if i<4 {0.0} else {1.0}
  counts[i as usize]=events[i as usize]
  let offset=ln_checked(exposure[i as usize])
  assert(offset.status==0)
  offsets[i as usize]=offset.value
  i=i+1
 }
 let fit=poisson_fit_offset(&design,&counts,&offsets,8,2,0.0,100,1e-10)
 assert(fit.status==0 && fit.rank==2 && fit.df==6 && fit.iterations<=100)
 assert(!fit.poisson_assumptions_assessed && fit.deviance>0.0)
 var order:[f64;1024]=[0.0;1024]
 var observed:[f64;1024]=[0.0;1024]
 var fitted:[f64;1024]=[0.0;1024]
 var pearson:[f64;1024]=[0.0;1024]
 var sum_a=0.0
 var sum_b=0.0
 var count_a=0.0
 var count_b=0.0
 i=0
 while i<8 {
  let mean=fit.means[i as usize]
  assert(mean>0.0)
  order[i as usize]=(i+1) as f64
  observed[i as usize]=(counts[i as usize] as f64)/exposure[i as usize]
  fitted[i as usize]=mean/exposure[i as usize]
  pearson[i as usize]=((counts[i as usize] as f64)-mean)/sqrt(mean)
  assert(observed[i as usize]>=0.0 && observed[i as usize]<=4.0)
  assert(fitted[i as usize]>0.0 && fitted[i as usize]<4.0)
  assert(pearson[i as usize]> -1.0 && pearson[i as usize]<1.0)
  if i<4 {sum_a=sum_a+mean;count_a=count_a+(counts[i as usize] as f64)}
  else {sum_b=sum_b+mean;count_b=count_b+(counts[i as usize] as f64)}
  i=i+1
 }
 assert(sum_a-count_a> -1e-7 && sum_a-count_a<1e-7)
 assert(sum_b-count_b> -1e-7 && sum_b-count_b<1e-7)
 var scene=viz_scene_new()
 let observed_node=viz_add_scatter_chart(&!scene,&order,&observed,8,viz_layout_rect(140,150,480,240),viz_style_rgb(70,180,235))
 let fitted_node=viz_add_scatter_chart(&!scene,&order,&fitted,8,viz_layout_rect(140,150,480,240),viz_style_rgb(245,170,65))
 assert(observed_node==0 && fitted_node==1)
 scene.series[0].x_min=0.0;scene.series[0].x_max=8.0
 scene.series[0].y_min=0.0;scene.series[0].y_max=4.0
 scene.series[1].x_min=0.0;scene.series[1].x_max=8.0
 scene.series[1].y_min=0.0;scene.series[1].y_max=4.0
 let residual_node=viz_add_scatter_chart(&!scene,&order,&pearson,8,viz_layout_rect(800,150,480,240),viz_style_rgb(220,135,225))
 let residual_slot:i64=scene.nodes[residual_node as usize].data_slot
 scene.series[residual_slot as usize].x_min=0.0;scene.series[residual_slot as usize].x_max=8.0
 scene.series[residual_slot as usize].y_min= -1.0;scene.series[residual_slot as usize].y_max=1.0
 var zx:[f64;1024]=[0.0;1024]
 var zy:[f64;1024]=[0.0;1024]
 zx[1]=8.0
 let zero=viz_add_line_chart(&!scene,&zx,&zy,2,viz_layout_rect(800,150,480,240),viz_style_rgb(180,185,195))
 assert(viz_line_set_viewport(&!scene,zero,0.0,8.0,-1.0,1.0))
 let xa=viz_add_axis(&!scene,0.0,8.0,4,false,viz_layout_rect(140,408,480,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,4.0,4,true,viz_layout_rect(120,150,1,240),viz_style_rgb(190,200,215))
 let xb=viz_add_axis(&!scene,0.0,8.0,4,false,viz_layout_rect(800,408,480,1),viz_style_rgb(190,200,215))
 let yb=viz_add_axis(&!scene,-1.0,1.0,4,true,viz_layout_rect(780,150,1,240),viz_style_rgb(190,200,215))
