 viz_node_set_label(&!scene,xb,&xn,17)
 viz_node_set_label(&!scene,ya,&rate,15)
 viz_node_set_label(&!scene,yb,&residual,27)
 assert(viz_add_label(&!scene,&title,42,viz_layout_rect(140,20,1140,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,49,viz_layout_rect(140,52,1140,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,observed_node,&obs,25,viz_layout_rect(140,470,340,22))>=0)
 assert(viz_add_series_legend(&!scene,fitted_node,&fitted_name,22,viz_layout_rect(500,470,340,22))>=0)
 assert(viz_add_series_legend(&!scene,residual_node,&resids,28,viz_layout_rect(900,470,380,22))>=0)
 assert(viz_add_label(&!scene,&foot,57,viz_layout_rect(140,550,1140,14),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_label(&!scene,&note,63,viz_layout_rect(140,580,1140,14),viz_style_rgb(190,200,215))>=0)
 let value0=axis_label(fitted[0])
 var text0:[i8;64]=[0;64]
