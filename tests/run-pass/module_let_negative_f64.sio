//@ run-pass
//@ description: a module-level `let` of type f64 keeps its sign and its whole initializer

// Both forms below produced a wrong number in silence, and only at module
// scope, only with `let`, only for f64:
//
//   let X: f64 = 0.0 - 1.25   became  0.0   -- the `- 1.25` was dropped, because
//                                            the scanner read the leading `0.0`
//                                            as the whole initializer
//   let X: f64 = -1.25        became +1.25  -- the sign was recorded in the
//                                            integer field, while the value is
//                                            rebuilt from the literal TOKEN,
//                                            whose text carries no sign
//
// `var` was correct at module scope, `i64` was correct at module scope, and
// `let` was correct inside a function, which is why this survived: every
// neighbouring form worked.
//
// Values are printed x100 so both sign and magnitude are visible, and compared
// against literals written INSIDE a function body -- the path that was never
// broken. Comparing against module-level constants would have compared the
// defect with itself.

let M_LET_EXPR: f64 = 0.0 - 1.25
let M_LET_LIT: f64 = -1.25
let M_LET_POS: f64 = 1.25
let M_LET_SCI: f64 = 0.0 - 1.5e2
var M_VAR_EXPR: f64 = 0.0 - 1.25
let M_INT_EXPR: i64 = 0 - 7

fn main() -> i64 with IO {
    let want_neg125: i64 = 0 - 125
    let want_neg15000: i64 = 0 - 15000
    let want_neg7: i64 = 0 - 7

    if (M_LET_EXPR * 100.0) as i64 != want_neg125 {
        println("FALHA: let f64 = 0.0 - 1.25")
        return 1
    }
    if (M_LET_LIT * 100.0) as i64 != want_neg125 {
        println("FALHA: let f64 = -1.25")
        return 1
    }
    if (M_LET_POS * 100.0) as i64 != 125 {
        println("FALHA: let f64 = 1.25 (positivo regrediu)")
        return 1
    }
    if (M_LET_SCI * 100.0) as i64 != want_neg15000 {
        println("FALHA: let f64 = 0.0 - 1.5e2")
        return 1
    }
    if (M_VAR_EXPR * 100.0) as i64 != want_neg125 {
        println("FALHA: var f64 = 0.0 - 1.25 (regressao no caminho que ja funcionava)")
        return 1
    }
    if M_INT_EXPR != want_neg7 {
        println("FALHA: let i64 = 0 - 7 (regressao no caminho que ja funcionava)")
        return 1
    }
    println("PASS module_let_negative_f64")
    0
}
