//@ run-pass
//@ description: Tiny portfolio v37 smoke for Lorenz i256 projection certificate-envelope entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var audit_fp: i64 = 389
    audit_fp = mix(audit_fp, 77888110, 2699)
    audit_fp = mix(audit_fp, 214180161, 2699)
    audit_fp = mix(audit_fp, 890086395, 2699)
    audit_fp = mix(audit_fp, 607091799, 2699)
    audit_fp = mix(audit_fp, 693793961, 2699)
    audit_fp = mix(audit_fp, 80894555, 2699)
    audit_fp = mix(audit_fp, 310218620, 2699)
    audit_fp = mix(audit_fp, 501185861, 2699)
    audit_fp = mix(audit_fp, 149359034, 2699)
    audit_fp = mix(audit_fp, 138609006, 2699)
    audit_fp = mix(audit_fp, 488107916, 2699)
    audit_fp = mix(audit_fp, 114244647, 2699)
    audit_fp = mix(audit_fp, 166945519, 2699)
    audit_fp = mix(audit_fp, 87220662, 2699)
    audit_fp = mix(audit_fp, 677514412, 2699)
    audit_fp = mix(audit_fp, 69322697, 2699)
    audit_fp = mix(audit_fp, 31, 2699)
    if audit_fp != 245178976 { return 1 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 40, 1103)
    entry_fp = mix(entry_fp, 77888110, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 40, 1103)
    if entry_fp != 836439604 { return 2 }

    if audit_fp == 245178977 { return 3 }
    return 0
}
