//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_DYNAMIC_FIELDS_PASS
//@ expect-stdout: data-source-index="4095"
//@ expect-stdout: data-source-row="8" data-source-col="10"
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close,numeric_matrix,numeric_matrix_set}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use display::canvas::{Canvas,canvas_clear}
use viz::dynamic_plot::{DynamicPlotSpec}
use viz::dynamic_fields::{DynamicHeatmapSpec,dynamic_scatter_canvas,dynamic_scatter_svg,dynamic_heatmap_canvas,dynamic_heatmap_svg}
fn fields(c:&!Canvas) with IO,Alloc,Mut,Div,Panic {
 var data=numeric_buffer_new(300,2400)
 let matrix=numeric_matrix(300,9,11,32,2,3)
 var mask=integer_buffer_new(99,792)
 var row:i64=0
 while row<9 {
  var col:i64=0
  while col<11 {
   let index=row*11+col
   let a=numeric_matrix_set(&!data,&matrix,row,col,(index%2) as f64)
   let b=integer_buffer_set(&!mask,index,if index%13==0 {0}else{1})
   col=col+1
  }
  row=row+1
 }
 let spec=DynamicHeatmapSpec{x:120,y:20,w:87,h:71,color_min:0.0,color_max:1.0}
 let painted=dynamic_heatmap_canvas(c,&spec,&data,&matrix,&mask)
 assert(painted.status==0 && painted.input_count==99 && painted.masked==8 && painted.painted==91)
 let emitted=dynamic_heatmap_svg(&spec,&data,&matrix,&mask)
 assert(emitted.status==0 && emitted.painted==91 && emitted.masked==8)
 let nan=0.0/0.0
 let changed=numeric_matrix_set(&!data,&matrix,8,10,nan)
 let unavailable=dynamic_heatmap_svg(&spec,&data,&matrix,&mask)
 assert(unavailable.status==3 && unavailable.painted==0)
 let tiny=DynamicHeatmapSpec{x:120,y:20,w:5,h:5,color_min:0.0,color_max:1.0}
 let dense=dynamic_heatmap_canvas(c,&tiny,&data,&matrix,&mask)
 assert(dense.status==6 && dense.painted==0)
 numeric_buffer_close(data);integer_buffer_close(mask)
}
fn main() with IO,Alloc,Mut,Div,Panic {
 var x=numeric_buffer_new(4096,32768);var y=numeric_buffer_new(4096,32768)
 var mask=integer_buffer_new(4096,32768)
 let nan=0.0/0.0
 var i:i64=0
 while i<4096 {
  let a=numeric_buffer_set(&!x,i,nan)
  let b=numeric_buffer_set(&!y,i,nan)
  let d=integer_buffer_set(&!mask,i,0)
  i=i+1
 }
 let indices:[i64;4]=[0,1024,2048,4095]
 let xs:[f64;4]=[0.0,-0.015625,0.5,1.015625]
 let ys:[f64;4]=[0.0,0.5,1.0,0.5]
 i=0
 while i<4 {
  let index=indices[i as usize]
  let a=numeric_buffer_set(&!x,index,xs[i as usize])
  let b=numeric_buffer_set(&!y,index,ys[i as usize])
  let d=integer_buffer_set(&!mask,index,1)
  i=i+1
 }
 let spec=DynamicPlotSpec{x:20,y:20,w:64,h:64,xmin:0.0,xmax:1.0,ymin:0.0,ymax:1.0,r:70,g:180,b:235,interval_kind:0,level:0.0}
 let pixels=heap_alloc(240*120*8) as *mut i64
 assert((pixels as i64)>0)
 var canvas=Canvas{pixels:pixels,width:240,height:120}
 canvas_clear(&!canvas,0,0,0)
 let painted=dynamic_scatter_canvas(&!canvas,&spec,&x,&y,&mask)
 assert(painted.status==0 && painted.input_count==4096 && painted.masked==4092 && painted.painted==4)
 println("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"240\" height=\"120\" viewBox=\"0 0 240 120\">")
 let emitted=dynamic_scatter_svg(&spec,&x,&y,&mask)
 assert(emitted.status==0 && emitted.painted==4 && emitted.masked==4092)
 let changed=numeric_buffer_set(&!x,4095,nan)
 let failed=dynamic_scatter_canvas(&!canvas,&spec,&x,&y,&mask)
 assert(failed.status==3 && failed.painted==0)
 let failed_svg=dynamic_scatter_svg(&spec,&x,&y,&mask)
 assert(failed_svg.status==3 && failed_svg.painted==0)
 fields(&!canvas)
 println("</svg>")
 var py:i64=0
 while py<120 {
  var px:i64=0
  while px<240 {
   let color:i64=read_i64(canvas.pixels,py*240+px)
   if color!=0 {print("FIELD_PIXEL ");print(px);print(" ");print(py);print(" ");println(color)}
   px=px+1
  }
  py=py+1
 }
 heap_free(canvas.pixels as *mut i8)
 numeric_buffer_close(x);numeric_buffer_close(y);integer_buffer_close(mask)
 println("STDLIB_DEEP_VIZ_DYNAMIC_FIELDS_PASS")
}
