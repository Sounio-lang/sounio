//@ run-pass
//@ expect-stdout: STDLIB_DEEP_ODE_GENERIC_PASS
use ode::checked64::{solve_dp54_64,solve_verlet64}
use ode::solver::{default_options}
fn constant_rhs(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {
 var i:i64=0
 while i<64 {dy[i as usize]=1.0;i=i+1}
}
fn zero_acc(t:f64,y:&[f64;64],a:&![f64;64]) with Mut,Div,Panic {
 var i:i64=0
 while i<64 {a[i as usize]=0.0;i=i+1}
}
fn harmonic_acc(t:f64,y:&[f64;64],a:&![f64;64]) with Mut,Div,Panic {
 var i:i64=0
 while i<64 {a[i as usize]= -y[i as usize];i=i+1}
}
fn incomplete_rhs(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {dy[0]=1.0}
fn bad_rhs(t:f64,y:&[f64;64],dy:&![f64;64]) with Mut,Div,Panic {dy[0]=1.0/0.0}
fn main()->i32 with IO,Mut,Div,Panic {
 var y:[f64;64]=[0.0;64]
 var v:[f64;64]=[0.0;64]
 var opts=default_options()
 opts.rtol=1.0e-8;opts.atol=1.0e-10
 let forward=solve_dp54_64(constant_rhs,&y,1,0.0,1.0,opts)
 assert(forward.status==0 && forward.t_final==1.0 && forward.steps>0 && forward.nfeval==forward.attempts*7)
 assert(forward.state[0]>0.9999999999 && forward.state[0]<1.0000000001)
 let too_large=solve_dp54_64(constant_rhs,&y,65,0.0,1.0,opts)
 assert(too_large.status==3 && too_large.nfeval==0)
 let short=solve_dp54_64(incomplete_rhs,&y,2,0.0,1.0,opts)
 assert(short.status==4 && short.nfeval==1 && short.steps==0 && short.t_final==0.0)
 let nonfinite=solve_dp54_64(bad_rhs,&y,1,0.0,1.0,opts)
 assert(nonfinite.status==4 && nonfinite.steps==0)
 opts.max_steps=1;opts.dt_init=0.01
 let budget=solve_dp54_64(constant_rhs,&y,1,0.0,1.0,opts)
 assert(budget.status==1 && budget.attempts==1 && budget.steps==1)
 opts=default_options()
 let time_stall=solve_dp54_64(constant_rhs,&y,1,1.0e300,1.0000000000000002e300,opts)
 assert(time_stall.status==2 && time_stall.steps==0)
 y[0]=2.0;v[0]=3.0
 let linear_motion=solve_verlet64(zero_acc,&y,&v,1,0.0,2.0,4)
 assert(linear_motion.status==0 && linear_motion.position[0]==8.0 && linear_motion.velocity[0]==3.0 && linear_motion.nfeval==5)
 y[0]=1.0;v[0]=0.0
 let harmonic=solve_verlet64(harmonic_acc,&y,&v,1,0.0,0.5,1)
 assert(harmonic.status==0 && harmonic.position[0]==0.875 && harmonic.velocity[0]== -0.46875)
 let invalid=solve_verlet64(zero_acc,&y,&v,1,0.0,1.0,0)
 assert(invalid.status==3 && invalid.steps==0 && invalid.nfeval==0)
 println("STDLIB_DEEP_ODE_GENERIC_PASS")
 0
}
