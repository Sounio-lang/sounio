//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_FO_TANGENT_CLONE_OK
//@ description: First-order GUM through user calls whose bodies reassign a var, loop, recurse, return early, call other helpers or measure inside. Each call goes through a tangent clone that returns its Jacobian row at run time; the caller applies the chain rule on its own channels. Before, every one of these read variance 0 on Madaros except the recursion (and `corr` read 9: the call lost its correlation with its own input). Expected values: tests/oracles/gum_fo_tangent_clone_calls.cpp.

ontology TgProbe {
    class Parameter { property amount: f64 where amount >= 0.0 }
    class WellDepth subclass_of Parameter
}

fn kn_noloop(k: Knowledge<f64>) -> f64 with Mut, Div, Epistemic {
    let e: f64 = k.value
    var s = 0.0
    s = s + e
    s = s + e * 2.0
    s
}

fn kn_loop(k: Knowledge<f64>) -> f64 with Mut, Div, Epistemic {
    let e: f64 = k.value
    var s = 0.0
    var i: i64 = 1
    while i <= 2 {
        s = s + e * (i as f64)
        i = i + 1
    }
    s
}

fn pw(x: f64, n: i64) -> f64 with Mut, Div {
    if n == 0 { 1.0 } else { x * pw(x, n - 1) }
}

fn lj_pair(rr: f64, eps: f64, sig: f64) -> f64 with Mut, Div {
    let q = sig / rr
    var q6 = 1.0
    var j: i64 = 0
    while j < 6 {
        q6 = q6 * q
        j = j + 1
    }
    4.0 * eps * (q6 * q6 - q6)
}

fn lj_shells(r: Knowledge<f64>, eps: Knowledge<f64>) -> f64 with Mut, Div, Epistemic {
    let rv: f64 = r.value
    let ev: f64 = eps.value
    var acc = 0.0
    var i: i64 = 1
    while i <= 3 {
        acc = acc + lj_pair((i as f64) * rv, ev, 1.0)
        i = i + 1
    }
    acc
}

fn noisy(x: f64) -> f64 with Mut, Div, Epistemic {
    let m = measure(2.0, uncertainty: 0.5)
    let mv: f64 = m.value
    x * mv
}

fn sq(x: f64) -> f64 with Mut, Div { x * x }

fn partition(beta: Knowledge<f64>, de: Knowledge<f64>) -> f64 with Mut, Div, Epistemic {
    let b: f64 = beta.value
    let d: f64 = de.value
    var z = 0.0
    var n: i64 = 0
    while n <= 5 {
        let t = exp(0.0 - b * (n as f64) * d)
        z = z + t
        if t < 0.001 { return z }
        n = n + 1
    }
    z
}

fn boltz_sum(eps: Knowledge<WellDepth>) -> f64 with Epistemic, Mut, Div {
    let e: f64 = eps.value
    var s = 0.0
    var i: i64 = 1
    while i <= 4 {
        s = s + exp(0.0 - e * (i as f64) / 100.0)
        i = i + 1
    }
    s
}

fn close(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-12 + 1.0e-12 * w
}

fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    var bad: i64 = 0
    let k = measure(10.0, uncertainty: 1.0)
    let e: f64 = k.value
    let a = kn_noloop(k)
    bad = bad + report("reassign", variance_of(a), 9.0)
    let b = kn_loop(k)
    bad = bad + report("loop", variance_of(b), 9.0)
    let c = b - 3.0 * e
    bad = bad + report("corr", variance_of(c), 0.0)
    let p = pw(e, 4)
    bad = bad + report("recur", variance_of(p), 16000000.0)
    let r = measure(1.12, uncertainty: 0.01)
    let ep = measure(0.997, uncertainty: 0.02)
    let en = lj_shells(r, ep)
    bad = bad + report("lj", variance_of(en), 0.00042781780426466852)
    let w = noisy(e)
    bad = bad + report("inner", variance_of(w), 29.0)
    let s1 = sq(e)
    let s2 = sq(e)
    let d5 = s1 - s2
    bad = bad + report("twice", variance_of(d5), 0.0)
    let be = measure(0.8, uncertainty: 0.05)
    let dd = measure(1.3, uncertainty: 0.1)
    let z = partition(be, dd)
    bad = bad + report("partition", variance_of(z), 0.0072456665533349573)
    let ev: WellDepth = 34.2
    let eps: Knowledge<WellDepth> = measure(ev, uncertainty: 1.0)
    let y = boltz_sum(eps)
    bad = bad + report("boltz", variance_of(y), 0.0014541360776012598)
    if bad == 0 {
        print("GUM_FO_TANGENT_CLONE_OK\n")
        return 0
    }
    1
}
