//@ run-pass
//@ expect-stdout-contains: stress_nested: PASS
//@ expect-stdout-contains: stress_nested_multi: PASS
// Stress: nested spawn — grandchild's mmap slot must survive through child's await

fn main() with IO, Async {
    // Outer spawn spawns an inner task and awaits it
    let h = spawn {
        let inner = spawn { 99 }
        inner.await
    }

    let result = h.await

    if result == 99 {
        print("stress_nested: PASS\n")
    } else {
        print("stress_nested: FAIL\n")
    }

    // Two levels deep with arithmetic
    let h2 = spawn {
        let a = spawn { 7 }
        let b = spawn { 8 }
        let ra = a.await
        let rb = b.await
        ra + rb
    }

    let result2 = h2.await

    if result2 == 15 {
        print("stress_nested_multi: PASS\n")
    } else {
        print("stress_nested_multi: FAIL\n")
    }
}
