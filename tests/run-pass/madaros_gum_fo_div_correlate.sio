//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_DIV_CORRELATE_PASS

// Quotient FO with correlation: off-diagonal H_ij for a/b.
// f = x/y at μx=2, μy=4, σx=0.1, σy=0.2
// s_x = 1/y = 0.25, s_y = −x/y² = −0.125
// Var ind = s_x²σx² + s_y²σy² = 0.0625*0.01 + 0.015625*0.04 = 0.000625 + 0.000625 = 0.00125
// Cov = ρ σx σy; ρ=1 → Cov=0.02
// Var cor = 0.00125 + 2 s_x s_y Cov = 0.00125 + 2*(0.25)*(-0.125)*0.02
//         = 0.00125 − 0.00125 = 0
// E2: Hxx=0, Hyy=2x/y³=2*2/64=0.0625, Hxy=−1/y²=−0.0625
// E2 ind = μ + ½ Hyy σy² = 0.5 + 0.5*0.0625*0.04 = 0.5 + 0.00125 = 0.50125
// E2 cor = 0.50125 + Hxy Cov = 0.50125 − 0.0625*0.02 = 0.50125 − 0.00125 = 0.5

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let ky: Knowledge<f64> = measure(4.0, uncertainty: 0.2)
    let x = kx.value
    let y = ky.value

    let v_ind = variance_of(x / y)
    let m2_ind = second_order_mean(x / y)

    let _r = correlate(x, y, 1.0)
    let v_cor = variance_of(x / y)
    let m2_cor = second_order_mean(x / y)

    print("v_ind="); print_f64(v_ind); print("\n")
    print("v_cor="); print_f64(v_cor); print("\n")
    print("m2_ind="); print_f64(m2_ind); print("\n")
    print("m2_cor="); print_f64(m2_cor); print("\n")

    let ok = abs_f(v_ind - 0.00125) < 1.0e-9
        && abs_f(v_cor - 0.0) < 1.0e-9
        && abs_f(m2_ind - 0.50125) < 1.0e-6
        && abs_f(m2_cor - 0.5) < 1.0e-6
    if ok {
        print("MADAROS_GUM_FO_DIV_CORRELATE_PASS\n")
    } else {
        print("MADAROS_GUM_FO_DIV_CORRELATE_FAIL\n")
    }
}
