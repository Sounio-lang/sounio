//@ run-pass
//@ expect-stdout: GUM_EXP_LOGNORMAL_OK
//@ requires: madaros
// variance_of(exp(u)) for u affine in a Gaussian channel is the exact lognormal
// variance, not the first-order delta-method value:
//   Var(exp(u)) = exp(2 mu + v) * (exp(v) - 1),  v = Var(u)
// (lower.sio fo_emit_lognormal_var). For exp(x * 0.5) at x = 2, u = 0.1 that is
// 0.0185420475..., while the first-order value (0.5 e 0.1)^2 = 0.018472640
// and exp(2) (exp(0.0025) - 1) = 0.018495750 are both different quantities. The
// reference values below come from bc at 24 digits; the tolerance is 1e-12
// relative. exp(1.0) is within 1 ulp of the correctly rounded constant.

fn near(a: f64, b: f64) -> bool {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    var m = b
    if m < 0.0 { m = 0.0 - m }
    d <= 1.0e-12 * m
}

fn t_exp_plain() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let x = k.value
    near(variance_of(exp(x)), 0.07500758634272782877)
}

fn t_exp_scaled() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let x = k.value
    near(variance_of(exp(x * 0.5)), 0.00682123808173485158)
}

fn t_exp_scaled_x2() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let x = k.value
    near(variance_of(exp(x * 0.5)), 0.018542047525172683)
}

fn t_exp_shifted() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let x = k.value
    near(variance_of(exp(x + 1.0)), 0.55423526333180040841)
}

fn t_exp_value() -> bool {
    var d = exp(1.0) - 2.718281828459045
    if d < 0.0 { d = 0.0 - d }
    d <= 4.5e-16
}

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var fails = 0
    if !t_exp_plain() { print("FAIL exp\n")
        fails = fails + 1 }
    if !t_exp_scaled() { print("FAIL exp_scaled\n")
        fails = fails + 1 }
    if !t_exp_scaled_x2() { print("FAIL exp_scaled_x2\n")
        fails = fails + 1 }
    if !t_exp_shifted() { print("FAIL exp_shifted\n")
        fails = fails + 1 }
    if !t_exp_value() { print("FAIL exp_value\n")
        fails = fails + 1 }
    if fails == 0 {
        print("GUM_EXP_LOGNORMAL_OK\n")
        return 0
    }
    1
}
