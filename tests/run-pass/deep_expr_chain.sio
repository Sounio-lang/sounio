//@ run-pass
//@ requires: madaros
//@ expect-stdout: 20:deep-expr-ok
// SIO-573: a 20-deep left-nested BinOp chain compiles and runs at the default
// compiler stack. Under an 8MB stack the same shape must refuse with the
// expression-nesting diagnostic (see
// scripts/ci/madaros_stack_reservation_gate.sh), never SIGSEGV.
fn f(x: i64) -> i64 {
    x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x + x
}
fn main() -> i64 with IO {
    print_int(f(1))
    print(":deep-expr-ok")
    println("")
    return 0
}
