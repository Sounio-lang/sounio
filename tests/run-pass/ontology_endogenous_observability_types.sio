//@ run-pass
//@ expect-stdout: endogenous observability ontology OK

ontology EndogenousObservabilityTest {
    class EpistemicArtifact
    class ObservationProcessArtifact subclass_of EpistemicArtifact
    class MeasurementIntent subclass_of ObservationProcessArtifact
    class ObservationPolicyDecision subclass_of ObservationProcessArtifact
    class DeliveryEvent subclass_of ObservationProcessArtifact
    class ResponseOpportunity subclass_of ObservationProcessArtifact
    class ParticipantResponseEvent subclass_of ObservationProcessArtifact
    class EvidenceArtifact subclass_of EpistemicArtifact
    class ContemporaneousObservedValue subclass_of EvidenceArtifact
    class WindowNonresponse subclass_of EvidenceArtifact
    class DelayedResponse subclass_of EvidenceArtifact
    class TimeAlignedObservedValue subclass_of EvidenceArtifact
    class LegacyCoarsenedMissingToken subclass_of EvidenceArtifact
    class AdmissibleObservationCustodyTrace subclass_of EvidenceArtifact
    class PolicyErasedCustodyTrace subclass_of EvidenceArtifact
    class EvidenceProvenanceReceipt subclass_of EvidenceArtifact
    class RetryTrace subclass_of EvidenceArtifact
    class DisconnectedRetryTrace subclass_of RetryTrace
    class InferenceArtifact subclass_of EpistemicArtifact
    class ObservedTraceEquivalence subclass_of InferenceArtifact
    class EndogenousObservabilityAmbiguity subclass_of InferenceArtifact
    class DeclaredResponseMechanismIdentification subclass_of InferenceArtifact
    class EmpiricalMissingnessTaxonomyReceipt subclass_of InferenceArtifact
    class GlobalRecoverabilityReceipt subclass_of InferenceArtifact
    class BiologicalResponseMechanismReceipt subclass_of InferenceArtifact
    class ClinicalAuthorityReceipt subclass_of InferenceArtifact
    class BurdenArtifact subclass_of EpistemicArtifact
    class DeclaredSyntheticBurden subclass_of BurdenArtifact
    class SubjectiveSuffering subclass_of BurdenArtifact
    role governed_by_policy domain EvidenceArtifact range ObservationPolicyDecision
    role has_provenance domain EvidenceArtifact range EvidenceProvenanceReceipt
    role creates_opportunity domain DeliveryEvent range ResponseOpportunity
    role temporally_aligns domain DelayedResponse range TimeAlignedObservedValue
    role supports_inference domain EvidenceArtifact range InferenceArtifact
    role observationally_equivalent_to symmetric
    role precedes transitive
}

fn accepts_process(a: ObservationProcessArtifact) -> i32 { 0 }
fn accepts_evidence(e: EvidenceArtifact) -> i32 { 0 }
fn accepts_inference(i: InferenceArtifact) -> i32 { 0 }
fn accepts_burden(b: BurdenArtifact) -> i32 { 0 }

fn policy_bridge(p: ObservationPolicyDecision) -> i32 { accepts_process(p) }
fn delayed_bridge(d: DelayedResponse) -> i32 { accepts_evidence(d) }
fn ambiguity_bridge(a: EndogenousObservabilityAmbiguity) -> i32 { accepts_inference(a) }
fn burden_bridge(b: DeclaredSyntheticBurden) -> i32 { accepts_burden(b) }

fn main() -> i32 {
    print("endogenous observability ontology OK\n")
    0
}
