//@ run-pass
// Acceptance test 2 for compiler prerequisite #1 (generic-struct-return monomorphization).
// Promotes spike_generic_struct_return.sio with REAL element-wise addition in cd_add.
// Expected output: 6, then "spike PASS"
//
// NOTE: bare generic-struct constructor literals in NON-generic code (e.g. directly
// inside main) are out of compiler scope. All `CDExact { ... }` construction below
// happens inside a generic helper fn (`make_cd4<F>`) reached via turbofish from main.

struct CDExact<F> {
    c: [F; 4],
    bits: i64,
}

// Generic constructor helper: builds a CDExact<F> literal from four components.
// This is the only place a `CDExact { ... }` literal is written; main only ever
// calls this (and cd_add) via explicit turbofish.
fn make_cd4<F>(c0: F, c1: F, c2: F, c3: F, bits: i64) -> CDExact<F> with Mut, Panic {
    CDExact { c: [c0, c1, c2, c3], bits: bits }
}

// The load-bearing shape: a function whose RETURN type is CDExact<F>.
// This implements REAL element-wise addition.
fn cd_add<F>(a: CDExact<F>, b: CDExact<F>) -> CDExact<F> with Mut, Panic {
    var out = CDExact { c: a.c, bits: a.bits }
    var i: i64 = 0
    while i < 4 {
        out.c[i as usize] = a.c[i as usize] + b.c[i as usize]
        i = i + 1
    }
    out
}

fn main() with IO, Mut, Panic {
    let a = make_cd4::<i64>(1, 2, 3, 4, 4)
    let b = make_cd4::<i64>(5, 6, 7, 8, 4)
    let r = cd_add::<i64>(a, b)
    println(r.c[0])
    println("spike PASS")
}
