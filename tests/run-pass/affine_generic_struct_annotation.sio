//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

struct Boxed<T> {
    value: T,
}

fn make_boxed<T>(value: T) -> Boxed<T> {
    Boxed { value: value }
}

fn open(boxed: Boxed<Permit>) -> i64 {
    boxed.value.id
}

fn main() -> i32 with Panic {
    let boxed = make_boxed::<Permit>(Permit { id: 67 })
    assert(open(boxed) == 67)
    0
}
