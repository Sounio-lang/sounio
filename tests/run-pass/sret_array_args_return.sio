//@ run-pass
struct W { c: [i64; 4], bits: i64 }
fn fw(p: i64, q: i64, r: i64) -> W with Mut, Panic {
    W { c: [p, q, r, p + q + r], bits: q }
}
fn main() with IO, Mut, Panic {
    let v = fw(3, 5, 7)
    assert(v.c[3] == 15)
    assert(v.bits == 5)
    assert(v.c[3] + v.bits == 20)
    print("sret_array_args_return: PASS\n")
}
