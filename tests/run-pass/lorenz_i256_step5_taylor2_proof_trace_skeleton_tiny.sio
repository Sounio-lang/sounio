//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 proof-trace skeleton keeps replay separate from validation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1249
    fp = mix(fp, 5, 5011)
    fp = mix(fp, 989883403, 5011)
    fp = mix(fp, 754841079, 5011)
    fp = mix(fp, 422368008, 5011)
    fp = mix(fp, 171451971, 5011)
    fp = mix(fp, 815806077, 5011)
    fp = mix(fp, 69995750, 5011)
    fp = mix(fp, 1, 5011)
    fp = mix(fp, 5, 5011)
    fp = mix(fp, 4, 5011)
    fp = mix(fp, 4, 5011)
    fp = mix(fp, 15, 5011)
    fp = mix(fp, 15, 5011)
    fp = mix(fp, 0, 5011)
    fp = mix(fp, 5, 5011)
    fp = mix(fp, 0, 5011)
    fp = mix(fp, 0, 5011)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 991104836 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1259
    fp = mix(fp, instance, 5021)
    fp = mix(fp, 4, 5021)
    fp = mix(fp, 4, 5021)
    fp = mix(fp, 15, 5021)
    fp = mix(fp, 15, 5021)
    fp = mix(fp, 15, 5021)
    fp = mix(fp, 0, 5021)
    fp = mix(fp, 5, 5021)
    fp = mix(fp, ok_mask, 5021)
    fp = mix(fp, 0, 5021)
    fp = mix(fp, 0, 5021)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 991104836 { return 0 - 1 }
    if certificate != 272679598 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1277
    fp = mix(fp, instance, 5023)
    fp = mix(fp, certificate, 5023)
    fp = mix(fp, 6, 5023)
    fp = mix(fp, 5, 5023)
    fp = mix(fp, 1, 5023)
    fp = mix(fp, 5, 5023)
    fp = mix(fp, ok_mask, 5023)
    fp = mix(fp, 0, 5023)
    fp = mix(fp, 0, 5023)
    return fp
}

fn skeleton_mask() -> i64 {
    let obligation_mask: i64 = 15
    let replay_order_mask: i64 = 15
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0
    let trace_status: i64 = 5

    var ok_mask: i64 = 0
    if 989883403 > 0 {
        if 422368008 > 0 {
            if 171451971 > 0 {
                if 815806077 > 0 {
                    if 69995750 > 0 { ok_mask = ok_mask + 1 }
                }
            }
        }
    }
    if 4 == 4 {
        if obligation_mask == 15 { ok_mask = ok_mask + 2 }
    }
    if replay_order_mask == obligation_mask { ok_mask = ok_mask + 4 }
    if 15 == obligation_mask { ok_mask = ok_mask + 8 }
    if trace_status == 5 { ok_mask = ok_mask + 16 }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if 989883403 != 422368008 { ok_mask = ok_mask + 64 }
    if local_containment_mask == 0 {
        if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = skeleton_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 991104836 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 272679598 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 971755585 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
