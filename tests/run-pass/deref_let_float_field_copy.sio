//@ run-pass
//@ expect-stdout: 11
// SIO-278: the loop-based flat copy behind `let saved = *b` moves raw
// words; an f64 field must still read back as a float through the copy
// (the native codegen tracks a field's float class per register+index,
// so the copy re-stores f64 fields through field_set).

struct M { x: f64, a: [i64; 2], n: i64 }

fn main() -> i32 with IO {
    var b = Box::new(M { x: 1.5, a: [7, 8], n: 1 })
    let saved = *b
    (*b).x = 9.5
    (*b).n = 99
    if saved.x == 1.5 { print_int(1) } else { print_int(0) }
    if saved.n == 1 { print_int(1) } else { print_int(0) }
    println("")
    return 0
}
