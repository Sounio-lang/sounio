//@ run-pass
//@ description: Self-contained imported runtime lift contract

fn imported_runtime_lift_contract_check(
    private_envelope_fp: i64,
    private_envelope_audit_fp: i64,
    multimodule_witness_pass_mask: i64,
    wide_call_runtime_pass_mask: i64,
    imported_solver_runtime_pass_mask: i64,
    imported_kernel_replay_pass_mask: i64,
    known_blocker_mask: i64,
    future_lift_requirement_mask: i64,
    current_missing_lift_mask: i64,
    ready_to_lift_mask: i64,
    imported_runtime_promotion_mask: i64,
    portable_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64,
    formal_theorem_ready: i64) -> i64 {
    if private_envelope_fp != 834620917 { return 0 - 1 }
    if private_envelope_audit_fp != 276591483 { return 0 - 1 }
    if multimodule_witness_pass_mask != 0 { return 0 - 1 }
    if wide_call_runtime_pass_mask != 0 { return 0 - 1 }
    if imported_solver_runtime_pass_mask != 0 { return 0 - 1 }
    if imported_kernel_replay_pass_mask != 0 { return 0 - 1 }
    if known_blocker_mask != 7 { return 0 - 1 }
    if future_lift_requirement_mask != 31 { return 0 - 1 }
    if current_missing_lift_mask != 31 { return 0 - 1 }
    if ready_to_lift_mask != 0 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if portable_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    return 642810357
}

fn main() -> i64 {
    let artifact = imported_runtime_lift_contract_check(
        834620917, 276591483, 0, 0, 0, 0, 7, 31, 31, 0, 0, 0, 0, 0, 0, 0,
        0)
    if artifact != 642810357 { return 1 }

    let audit_fp: i64 = 508176294
    let instance_fp: i64 = 276304915
    let certificate_fp: i64 = 819273604
    let private_envelope_status: i64 = 94
    let runtime_abi_blocker_status: i64 = 92
    let kernel_replay_router_status: i64 = 93
    let lift_anchor_mask: i64 = 63
    let required_future_lift_requirement_mask: i64 = 31
    let required_current_missing_lift_mask: i64 = 31
    let required_ready_to_lift_mask: i64 = 0
    let required_imported_runtime_promotion_mask: i64 = 0
    let required_portable_runtime_evidence_mask: i64 = 0
    let required_lift_contract_next_action_mask: i64 = 31
    let imported_lift_status: i64 = 95
    let ok_mask: i64 = 1023

    if audit_fp != 508176294 { return 2 }
    if instance_fp != 276304915 { return 3 }
    if certificate_fp != 819273604 { return 4 }
    if private_envelope_status != 94 { return 5 }
    if runtime_abi_blocker_status != 92 { return 6 }
    if kernel_replay_router_status != 93 { return 7 }
    if lift_anchor_mask != 63 { return 8 }
    if required_future_lift_requirement_mask != 31 { return 9 }
    if required_current_missing_lift_mask != 31 { return 10 }
    if required_ready_to_lift_mask != 0 { return 11 }
    if required_imported_runtime_promotion_mask != 0 { return 12 }
    if required_portable_runtime_evidence_mask != 0 { return 13 }
    if required_lift_contract_next_action_mask != 31 { return 14 }
    if imported_lift_status != 95 { return 15 }
    if ok_mask != 1023 { return 16 }

    let fake_multimodule_green = imported_runtime_lift_contract_check(
        834620917, 276591483, 1, 0, 0, 0, 7, 31, 31, 0, 0, 0, 0, 0, 0, 0,
        0)
    if fake_multimodule_green != 0 - 1 { return 17 }

    let fake_imported_solver_green = imported_runtime_lift_contract_check(
        834620917, 276591483, 0, 0, 1, 0, 7, 31, 31, 0, 0, 0, 0, 0, 0, 0,
        0)
    if fake_imported_solver_green != 0 - 1 { return 18 }

    let fake_ready_lift = imported_runtime_lift_contract_check(
        834620917, 276591483, 0, 0, 0, 0, 7, 31, 31, 1, 0, 0, 0, 0, 0, 0,
        0)
    if fake_ready_lift != 0 - 1 { return 19 }

    let fake_runtime_promotion = imported_runtime_lift_contract_check(
        834620917, 276591483, 0, 0, 0, 0, 7, 31, 31, 0, 1, 0, 0, 0, 0, 0,
        0)
    if fake_runtime_promotion != 0 - 1 { return 20 }

    let fake_public_claim = imported_runtime_lift_contract_check(
        834620917, 276591483, 0, 0, 0, 0, 7, 31, 31, 0, 0, 0, 1, 0, 0, 0,
        0)
    if fake_public_claim != 0 - 1 { return 21 }

    return 0
}
