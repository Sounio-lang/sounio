//@ run-pass
fn returned_string() -> string {
    "returned"
}

fn main() -> i32 with IO, Panic {
    let s = "hello"
    let empty = ""
    let long = "sounio language"
    let typed: string = "typed"
    assert(s.len() == 5)
    assert(empty.len() == 0)
    assert(long.len() == 15)
    assert(typed.len() == 5)
    assert("literal".len() == 7)
    assert(returned_string().len() == 8)
    print("string_len: PASS\n")
    0
}
