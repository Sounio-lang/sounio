//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v46 smoke for Lorenz i256 Taylor-2 adaptive step decision

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v46_lorenz_i256_taylor2_adaptive_step_decision_fingerprint(
        120259197, 471466754, 699995048, 975812377, 498384393, 2, 63)
    if receipt_fp != 279109641 { return 1 }

    let audit_fp = solver_portfolio_v46_lorenz_i256_taylor2_adaptive_step_decision_audit_fingerprint(
        receipt_fp, 120259197, 471466754, 486061656, 85088711,
        498384393, 2, 63)
    if audit_fp != 207228249 { return 2 }

    let manifest_fp = solver_portfolio_v46_lorenz_i256_taylor2_adaptive_step_decision_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 470000532 { return 3 }

    let result_fp = solver_portfolio_v46_result_coverage_fingerprint(
        46, 50, 10, 38, 1, 1, manifest_fp)
    if result_fp != 608400982 { return 4 }

    let family_fp = solver_portfolio_v46_checker_family_coverage_fingerprint(
        46, 50, 6, 4, 3, 2, 33, 2, manifest_fp)
    if family_fp != 835699138 { return 5 }

    let acceptance_fp = solver_portfolio_v46_acceptance_receipt_fingerprint(
        46, manifest_fp, result_fp)
    if acceptance_fp != 374332529 { return 6 }

    let audit_receipt_fp = solver_portfolio_v46_audit_receipt_fingerprint(
        46, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 326214432 { return 7 }

    let readiness_fp = solver_portfolio_v46_readiness_fingerprint(
        46, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 984799877 { return 8 }

    return 0
}
