//@ run-pass
// tests/run-pass/viz_html_identity.sio - HTML/SVG preserves Visual IR identity attributes
//
// Expected output includes:
//   data-viz-id="1"
//   data-viz-parent-id="1"
//   data-viz-tag="77"
//   VIZ_HTML_IDENTITY_PASS

use viz::ir::{
    viz_scene_new, viz_layout_rect, viz_style_rgb,
    viz_add_button, viz_add_slider, viz_scene_set_parent, viz_scene_set_tag,
}
use viz::viz_html::{viz_html_emit_scene}

fn main() with IO, Mut, Div {
    var scene = viz_scene_new()
    var label: [i8; 64] = [0; 64]
    label[0] = 82
    label[1] = 117
    label[2] = 110

    let button = viz_add_button(&!scene, &label, 3, viz_layout_rect(8, 8, 48, 18), viz_style_rgb(90, 180, 240))
    let slider = viz_add_slider(&!scene, viz_layout_rect(64, 8, 80, 18), 0.5, 0.0, 1.0, viz_style_rgb(240, 190, 80))
    viz_scene_set_parent(&!scene, slider, button)
    viz_scene_set_tag(&!scene, slider, 77)

    assert(scene.nodes[button as usize].id == 1)
    assert(scene.nodes[slider as usize].id == 2)
    assert(scene.nodes[slider as usize].parent_id == 1)
    assert(scene.nodes[slider as usize].tag == 77)

    viz_html_emit_scene(&scene, 160, 48)
    println("VIZ_HTML_IDENTITY_PASS")
}
