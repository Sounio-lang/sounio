//@ run-pass
// Sprint 228: First-class functions — named functions as values, higher-order patterns
//
// NOTE: Closure LITERALS (|x| x+1) type-check to Unit in the current $SOUC JIT binary.
// The self-hosted compiler (lower.sio, vm.sio) has been updated with IrLoadFnRef/IrCallIndirect
// for full closure support. This test validates the fn-ref patterns that work TODAY.
// Once $SOUC is rebuilt from the updated self-hosted sources, closure literals will work too.

fn double(x: i64) -> i64 { x * 2 }
fn triple(x: i64) -> i64 { x * 3 }
fn negate(x: i64) -> i64 { 0 - x }
fn square(x: i64) -> i64 { x * x }
fn add_one(x: i64) -> i64 { x + 1 }

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn apply2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 { f(a, b) }

fn add(a: i64, b: i64) -> i64 { a + b }

fn apply_f64(f: fn(f64) -> f64, x: f64) -> f64 { f(x) }
fn double_f64(x: f64) -> f64 { x * 2.0 }

fn select_op(which: i64) -> fn(i64) -> i64 with Mut, Panic, Div {
    if which == 0 { add_one }
    else if which == 1 { double }
    else { negate }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    // Test 1: Named function as argument
    let r1 = apply(double, 5)
    assert(r1 == 10)

    // Test 2: Different named function
    let r2 = apply(triple, 5)
    assert(r2 == 15)

    // Test 3: Named function stored in variable
    let f = double
    let r3 = f(21)
    assert(r3 == 42)

    // Test 4: Named fn passed as argument
    let r4 = apply(square, 7)
    assert(r4 == 49)

    // Test 5: Multi-argument fn
    let r5 = apply2(add, 30, 12)
    assert(r5 == 42)

    // Test 6: f64 function reference
    let r6 = apply_f64(double_f64, 3.14)
    assert(r6 > 6.27)
    assert(r6 < 6.29)

    // Test 7: Function returned from function
    let op0 = select_op(0)
    assert(op0(10) == 11)

    let op1 = select_op(1)
    assert(op1(10) == 20)

    let op2 = select_op(2)
    assert(op2(10) == -10)

    // Test 8: Dynamic function selection
    let op = if r1 > 5 { double } else { square }
    assert(op(3) == 6)

    print(0)
    0
}
