//@ run-pass
//@ expect-stdout: VIZ_CORRELATION_DIAGNOSTICS_PASS
//@ expect-stdout: Descriptive coefficients; no p-value or confidence interval
//@ expect-stdout: scatter n=6
//@ expect-stdout: <circle cx="460" cy="300" r="3" fill="rgb(70,180,235)"/>
use stats::correlation_core::{pearson_checked,spearman_checked}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_scatter_chart,viz_add_axis,
 viz_add_label,viz_node_set_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 var xs:[f64;1024]=[0.0;1024]
 var ys:[f64;1024]=[0.0;1024]
 var i:i64=0
 while i<6 {
  let v:f64=if i<5 {i as f64} else {4.0}
  x[i as usize]=v
  y[i as usize]=v*v
  xs[i as usize]=v
  ys[i as usize]=v*v
  i=i+1
 }
 let pearson=pearson_checked(&x,&y,6)
 let spearman=spearman_checked(&x,&y,6)
 assert(pearson.status==0 && spearman.status==0)
 assert(pearson.coefficient>0.0 && pearson.coefficient<1.0)
 assert(spearman.coefficient>1.0-1e-13 && spearman.coefficient<=1.0)
 var scene=viz_scene_new()
 let points=viz_add_scatter_chart(&!scene,&xs,&ys,6,viz_layout_rect(160,120,600,240),viz_style_rgb(70,180,235))
 assert(points>=0 && scene.series[0].n==6)
 // Auto domains match the explicitly displayed scientific axes exactly.
 assert(scene.series[0].x_min==0.0 && scene.series[0].x_max==4.0)
 assert(scene.series[0].y_min==0.0 && scene.series[0].y_max==16.0)
 let xa=viz_add_axis(&!scene,0.0,4.0,4,false,viz_layout_rect(160,378,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,16.0,4,true,viz_layout_rect(140,120,1,240),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=77
 title[1]=111
 title[2]=110
 title[3]=111
 title[4]=116
 title[5]=111
 title[6]=110
