 viz_node_set_label(&!scene,xa,&xn,22)
 viz_node_set_label(&!scene,ya,&yn,22)
 assert(viz_add_label(&!scene,&title,49,viz_layout_rect(160,20,650,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,59,viz_layout_rect(160,48,680,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,points,&legend,21,viz_layout_rect(160,426,600,22))>=0)
 assert(viz_add_label(&!scene,&foot,43,viz_layout_rect(160,462,650,14),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_label(&!scene,&note,53,viz_layout_rect(160,490,650,14),viz_style_rgb(190,200,215))>=0)
 let p=axis_label(pearson.coefficient)
 let s=axis_label(spearman.coefficient)
 var pt:[i8;64]=[0;64]
 var st:[i8;64]=[0;64]
 pt[0]=80
 pt[1]=101
 pt[2]=97
 pt[3]=114
 pt[4]=115
 pt[5]=111
 pt[6]=110
 pt[7]=32
 pt[8]=114
 pt[9]=61
 st[0]=83
 st[1]=112
 st[2]=101
 st[3]=97
 st[4]=114
 st[5]=109
 st[6]=97
 st[7]=110
 st[8]=32
 st[9]=114
 st[10]=104
 st[11]=111
 st[12]=61
 i=0
 while i<p.n {pt[(i+10) as usize]=p.text[i as usize];i=i+1}
 i=0
 while i<s.n {st[(i+13) as usize]=s.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&pt,p.n+10,viz_layout_rect(160,80,280,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&st,s.n+13,viz_layout_rect(490,80,280,20),viz_style_rgb(230,235,245))>=0)
 assert(scene.node_count==10 && scene.series_count==1)
 let pixels=heap_alloc(960*520*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:960,height:520}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,360*960+138)==190*65536+200*256+215)
 // The observed pair (2,4) maps to the center at (460,300).
 assert(read_i64(canvas.pixels,300*960+460)==70*65536+180*256+235)
 viz_html_emit_scene(&scene,960,520)
 println("VIZ_CORRELATION_DIAGNOSTICS_PASS")
