//@ run-pass
// Minimal: fn-HOF with mutable struct ref

struct Box4 { v: [f64; 4], n: i64 }

fn writer(out: &!Box4) with Mut { out.v[0] = 42.0 }

fn runner(f: fn(&!Box4) -> (), b: &!Box4) with Mut { f(b) }

fn main() -> i64 with IO, Mut {
    var b = Box4 { v: [0.0; 4], n: 0 }
    runner(writer, &!b)
    println(b.v[0])
    if b.v[0] == 42.0 { println("PASS T1") } else { println("FAIL T1") }

    // T2: fn-HOF with f64 + struct ref (matching rhs_decay pattern)
    0
}
