//@ run-pass
//@ expect-stdout: erdos90_eisenstein_subset_smoke: PASS

// Smoke: Eisenstein axial subset on n=9 (Lean greedy 4 9 → harb(9)=16 unit pairs).

fn isqrt(n: i64) -> i64 with Mut {
    if n < 0 { return 0 }
    var r = 0
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

fn harb(n: i64) -> i64 with Mut {
    let m = 12 * n - 3
    let s = isqrt(m)
    var c = s
    if s * s < m { c = s + 1 }
    return 3 * n - c
}

fn iabs(x: i64) -> i64 { if x < 0 { return 0 - x } else { return x } }

fn hexdist(a: i64, b: i64) -> i64 {
    return (iabs(a) + iabs(b) + iabs(a + b)) / 2
}

fn axial_d2(ai: i64, bi: i64, aj: i64, bj: i64) -> i64 {
    let x = ai - aj
    let y = bi - bj
    return x * x + x * y + y * y
}

fn main() -> i32 with IO, Mut, Div {
    let R = 4
    let n = 9
    var pn = 0
    var a = 0 - R
    while a <= R {
        var b = 0 - R
        while b <= R {
            if hexdist(a, b) <= R { pn = pn + 1 }
            b = b + 1
        }
        a = a + 1
    }
    let cells0a = 0; let cells0b = 0
    let cells1a = 0 - 1; let cells1b = 0
    let cells2a = 0 - 1; let cells2b = 1
    let cells3a = 0; let cells3b = 0 - 1
    let cells4a = 0; let cells4b = 1
    let cells5a = 1; let cells5b = 0 - 1
    let cells6a = 1; let cells6b = 0
    let cells7a = 0 - 2; let cells7b = 1
    let cells8a = 0 - 2; let cells8b = 0
    var cnt = 0
    var i = 0
    while i < n {
        var j = i + 1
        while j < n {
            var ai = 0; var bi = 0; var aj = 0; var bj = 0
            if i == 0 { ai = cells0a; bi = cells0b } else if i == 1 { ai = cells1a; bi = cells1b }
            else if i == 2 { ai = cells2a; bi = cells2b } else if i == 3 { ai = cells3a; bi = cells3b }
            else if i == 4 { ai = cells4a; bi = cells4b } else if i == 5 { ai = cells5a; bi = cells5b }
            else if i == 6 { ai = cells6a; bi = cells6b } else if i == 7 { ai = cells7a; bi = cells7b }
            else { ai = cells8a; bi = cells8b }
            if j == 0 { aj = cells0a; bj = cells0b } else if j == 1 { aj = cells1a; bj = cells1b }
            else if j == 2 { aj = cells2a; bj = cells2b } else if j == 3 { aj = cells3a; bj = cells3b }
            else if j == 4 { aj = cells4a; bj = cells4b } else if j == 5 { aj = cells5a; bj = cells5b }
            else if j == 6 { aj = cells6a; bj = cells6b } else if j == 7 { aj = cells7a; bj = cells7b }
            else { aj = cells8a; bj = cells8b }
            if axial_d2(ai, bi, aj, bj) == 1 { cnt = cnt + 1 }
            j = j + 1
        }
        i = i + 1
    }
    let h = harb(n)
    print("pool_cells="); print_int(pn)
    print(" greedy9="); print_int(cnt)
    print(" harb9="); print_int(h); print("\n")
    if cnt == h && cnt == 16 {
        print("erdos90_eisenstein_subset_smoke: PASS\n")
        return 0
    }
    print("erdos90_eisenstein_subset_smoke: FAIL\n")
    return 1
}