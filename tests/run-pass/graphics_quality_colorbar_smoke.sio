//@ run-pass

use graphics::drawing::{Color}
use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{draw_quality_colorbar}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(80, 72)
    let border = Color { r: 12, g: 14, b: 20, a: 255 }
    s = draw_quality_colorbar(s, 62, 18, 6, 36, 4, border)

    let top_r = surface_get_pixel_r(&s, 64, 18)
    let top_g = surface_get_pixel_g(&s, 64, 18)
    let top_b = surface_get_pixel_b(&s, 64, 18)
    if top_r < 180 || top_g < 160 || top_b > 90 {
        print("FAIL colorbar top should be viridis high/yellow\n")
        return 1
    }

    let bottom_r = surface_get_pixel_r(&s, 64, 53)
    let bottom_g = surface_get_pixel_g(&s, 64, 53)
    let bottom_b = surface_get_pixel_b(&s, 64, 53)
    if bottom_r < 40 || bottom_r > 90 || bottom_g > 40 || bottom_b < 60 {
        print("FAIL colorbar bottom should be viridis low/purple\n")
        return 2
    }

    let mid_r = surface_get_pixel_r(&s, 64, 36)
    let mid_g = surface_get_pixel_g(&s, 64, 36)
    let mid_b = surface_get_pixel_b(&s, 64, 36)
    if mid_g <= mid_r || mid_g < 90 || mid_b < 80 {
        print("FAIL colorbar middle should be teal/green\n")
        return 3
    }

    var border_pixels = 0
    var x = 61
    while x <= 68 {
        if surface_get_pixel_r(&s, x, 17) < 40 { border_pixels = border_pixels + 1 }
        if surface_get_pixel_r(&s, x, 54) < 40 { border_pixels = border_pixels + 1 }
        x = x + 1
    }
    if border_pixels < 10 {
        print("FAIL colorbar border missing\n")
        return 4
    }

    var tick_pixels = 0
    x = 69
    while x <= 72 {
        if surface_get_pixel_r(&s, x, 18) < 40 { tick_pixels = tick_pixels + 1 }
        if surface_get_pixel_r(&s, x, 29) < 40 { tick_pixels = tick_pixels + 1 }
        if surface_get_pixel_r(&s, x, 41) < 40 { tick_pixels = tick_pixels + 1 }
        if surface_get_pixel_r(&s, x, 53) < 40 { tick_pixels = tick_pixels + 1 }
        x = x + 1
    }
    if tick_pixels < 12 {
        print("FAIL colorbar ticks missing\n")
        return 5
    }

    print("PASS graphics_quality_colorbar_smoke\n")
    0
}
