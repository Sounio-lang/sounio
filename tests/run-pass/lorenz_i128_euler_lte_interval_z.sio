//@ run-pass
//@ description: Lorenz i128 Euler interval LTE bound for z over the first step box

fn main() -> i64 {
    // Same first-step box as lorenz_i128_euler_lte_interval_xy.sio.
    let scale: i64 = 1000000
    let h2: i64 = 100000000
    let den: i64 = 2000000000000

    let x_abs: i64 = 1000013
    let y_abs: i64 = 1260013
    let z_abs: i64 = 1000010
    let rhoz_abs: i64 = 27016677

    let dx_abs: i64 = 10 * (y_abs + x_abs)
    let dy_abs: i64 = (x_abs * rhoz_abs + scale - 1) / scale + y_abs
    let dz_abs: i64 = (x_abs * y_abs + scale - 1) / scale + ((8 * z_abs) + 2) / 3

    // z'' = x' * y + x * y' - beta * z'.
    let ddz_abs: i64 = (dx_abs * y_abs + scale - 1) / scale +
                       (x_abs * dy_abs + scale - 1) / scale +
                       ((8 * dz_abs) + 2) / 3

    let lte_z: i64 = (h2 * ddz_abs + den - 1) / den
    let total_zr: i64 = 11 + lte_z

    if dx_abs != 22600260 { return 1 }
    if dy_abs != 28277042 { return 2 }
    if dz_abs != 3926724 { return 3 }
    if ddz_abs != 67225296 { return 4 }
    if lte_z != 3362 { return 5 }
    if total_zr != 3373 { return 6 }
    return 0
}
