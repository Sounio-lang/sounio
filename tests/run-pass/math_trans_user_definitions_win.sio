//@ run-pass
//@ expect-stdout: MATH_TRANS_USER_DEFS_OK
//@ requires: madaros
// A program that DEFINES tan, atan, atan2, asin, acos, tanh or ln keeps its own
// definition. These names now have backend builtin ids (86..91, ln aliases log's
// 17); resolution must still prefer a function with a body. The bodies below are
// deliberately not the math functions, so a mis-bind to the builtin is visible.

fn tan(x: f64) -> f64 { x * 2.0 }
fn atan(x: f64) -> f64 { x + 100.0 }
fn atan2(y: f64, x: f64) -> f64 { y * 10.0 + x }
fn asin(x: f64) -> f64 { x - 1.0 }
fn acos(x: f64) -> f64 { x * x }
fn tanh(x: f64) -> f64 { 0.0 - x }
fn ln(x: f64) -> f64 { x + 0.5 }

fn main() -> i64 with IO, Mut, Div {
    let ok = tan(3.0) == 6.0
        && atan(1.0) == 101.0
        && atan2(2.0, 3.0) == 23.0
        && asin(5.0) == 4.0
        && acos(4.0) == 16.0
        && tanh(7.0) == 0.0 - 7.0
        && ln(1.0) == 1.5
    if ok {
        print("MATH_TRANS_USER_DEFS_OK\n")
        return 0
    }
    print("MATH_TRANS_USER_DEFS_FAIL\n")
    1
}
