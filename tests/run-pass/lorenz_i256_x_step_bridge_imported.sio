//@ run-pass
//@ description: Imported Lorenz i256 x-step bridge smoke

use systems::lorenz_i256_sigma_x_term_bridge::*
use systems::lorenz_i256_x_step_bridge::*

fn main() -> i64 with Div {
    let positive = lorenz_i256_x_step_check(
        950000000, 0, 0, 0, 150000000, 1, 0, 0, 950000000, 2, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_x_step_check(
        150000000, 3, 0, 0, 950000000, 2, 0, 0, 150000000, 1, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_x_step_check(
        950000000, 0, 0, 0, 950000000, 0, 0, 0, 950000000, 0, 0, 0)
    if zero != 1 { return 3 }

    let underflow = lorenz_i256_x_step_limb(950000000, 0, 0, 0, 150000000, 0, 0, 0, 0)
    if underflow != 0 - 1 { return 4 }

    let sigma_term = lorenz_i256_sigma_x_term_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 105)
    if sigma_term != 318704692 { return 5 }

    let sigma_term_audit = lorenz_i256_sigma_x_term_bridge_audit_fingerprint(
        sigma_term, 406827195, 982641307, 492681735, 837260419, 734815269,
        216903584, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 105, 1023)
    if sigma_term_audit != 729516083 { return 6 }

    let artifact = lorenz_i256_x_step_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 106)
    if artifact != 645218970 { return 7 }

    let audit = lorenz_i256_x_step_bridge_audit_fingerprint(
        artifact, 927405816, 360918274, sigma_term, sigma_term_audit,
        1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 106, 1023)
    if audit != 184760392 { return 8 }
    return 0
}
