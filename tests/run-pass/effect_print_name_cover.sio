//@ run-pass
//@ description: Phase 2b — every live effect id has a print name; Chaotic is 22; Mod held
//@ expect-stdout: EFFECT_PRINT_NAME_COVER_OK

// One table. If name_len(k)==0 for any live id, this test fails.
// That is worth more than the Chaotic print fix: a later id cannot
// fall through to Effect#N unnoticed. EffVar is structure and must
// have no name.

fn name_len(k: i64) -> i64 {
    if k == 0 { 2 }
    else if k == 1 { 3 }
    else if k == 2 { 5 }
    else if k == 3 { 5 }
    else if k == 4 { 3 }
    else if k == 5 { 3 }
    else if k == 6 { 5 }
    else if k == 7 { 4 }
    else if k == 8 { 9 }
    else if k == 9 { 6 }
    else if k == 10 { 7 }
    else if k == 11 { 6 }
    else if k == 12 { 6 }
    else if k == 13 { 7 }
    else if k == 14 { 8 }
    else if k == 15 { 5 }
    else if k == 16 { 10 }
    else if k == 17 { 9 }
    else if k == 18 { 2 }
    else if k == 19 { 7 }
    else if k == 20 { 8 }
    else if k == 21 { 5 }
    else if k == 22 { 7 }
    else if k == 23 { 6 }
    else if k == 24 { 12 }
    else if k == 25 { 13 }
    else if k == 26 { 12 }
    else if k == 27 { 24 }
    else if k == 28 { 10 }
    else { 0 }
}

fn name_byte(k: i64, i: i64) -> i8 {
    if k == 22 {
        if i == 0 { 67 as i8 } else if i == 1 { 104 as i8 } else if i == 2 { 97 as i8 } else if i == 3 { 111 as i8 } else if i == 4 { 116 as i8 } else if i == 5 { 105 as i8 } else { 99 as i8 }
    } else if k == 23 {
        if i == 0 { 65 as i8 } else if i == 1 { 112 as i8 } else if i == 2 { 112 as i8 } else if i == 3 { 114 as i8 } else if i == 4 { 111 as i8 } else { 120 as i8 }
    } else {
        0 as i8
    }
}

fn bytes_eq_chaotic(k: i64) -> bool {
    name_byte(k, 0) == 67 as i8 && name_byte(k, 1) == 104 as i8 && name_byte(k, 2) == 97 as i8
        && name_byte(k, 3) == 111 as i8 && name_byte(k, 4) == 116 as i8 && name_byte(k, 5) == 105 as i8
        && name_byte(k, 6) == 99 as i8
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var fails: i64 = 0
    var unnamed: i64 = 0
    var k: i64 = 0
    while k <= 28 {
        let n = name_len(k)
        if n <= 0 {
            print("UNNAMED_ID id=")
            print_int(k)
            print("\n")
            unnamed = unnamed + 1
            fails = fails + 1
        }
        k = k + 1
    }

    // Chaotic must exist as a name, not Effect#22.
    if name_len(22) != 7 {
        print("CHAOTIC_LEN_NOT_7\n")
        fails = fails + 1
    }
    if !bytes_eq_chaotic(22) {
        print("CHAOTIC_BYTES_WRONG\n")
        fails = fails + 1
    }

    // Generic fallback is only legal when name_len==0.
    if name_len(22) <= 0 {
        print("CHAOTIC_FALLS_TO_GENERIC\n")
        fails = fails + 1
    }
    if name_len(29) != 0 {
        print("EFFVAR_HAS_A_NAME\n")
        fails = fails + 1
    }
    if name_len(99) != 0 {
        print("UNKNOWN_ID_HAS_A_NAME\n")
        fails = fails + 1
    }

    if name_len(23) != 6 {
        print("APPROX_LEN\n")
        fails = fails + 1
    }
    // Mod is held: id 29 is EffVar (unnamed), not a reserved Mod hole.
    if name_len(29) != 0 {
        print("MOD_HOLE_NAMED\n")
        fails = fails + 1
    }

    if fails == 0 {
        print("EFFECT_PRINT_NAME_COVER_OK 0..=28 named, Chaotic exists, EffVar unnamed, Mod held\n")
        0
    } else {
        print("EFFECT_PRINT_NAME_COVER_FAIL unnamed=")
        print_int(unnamed)
        print(" fails=")
        print_int(fails)
        print("\n")
        1
    }
}
