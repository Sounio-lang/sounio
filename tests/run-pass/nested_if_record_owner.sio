//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: NESTED IF RECORD OWNER PASS
// Inferred owner of a nested if must be the returned record, not a majority
// field-name offset from unrelated layouts. This keeps inline reads observable.
struct OwnerFit {status:i64,rows:i64,a:i64,b:i64,c:i64,d:i64,e:i64,f:i64,point_available:bool,alpha:f64}
struct OtherAlphaA {status:i64,rows:i64,a:i64,b:i64,c:i64,d:i64,e:i64,f:i64,alpha:f64}
struct OtherAlphaB {status:i64,rows:i64,a:i64,b:i64,c:i64,d:i64,e:i64,f:i64,alpha:f64}
fn owner_left()->OwnerFit {OwnerFit{status:0,rows:16,a:0,b:0,c:0,d:0,e:0,f:0,point_available:true,alpha:1.25}}
fn owner_right()->OwnerFit {OwnerFit{status:0,rows:16,a:0,b:0,c:0,d:0,e:0,f:0,point_available:false,alpha:2.5}}
fn owner_alpha(value:&OwnerFit)->f64 {value.alpha}
fn owner_case(outer:bool,inner:bool) with IO,Mut,Div,Panic {
 let fit0=if outer {if inner {owner_left()}else{owner_right()}}else{if inner {owner_right()}else{owner_left()}}
 let expected:f64=if outer==inner {1.25}else{2.5}
 let before:i64=f64_to_bits(fit0.alpha)
 let borrowed_before:i64=f64_to_bits(owner_alpha(&fit0))
 let fit1=if inner {owner_left()}else{owner_right()}
 let after:i64=f64_to_bits(fit0.alpha)
 let borrowed_after:i64=f64_to_bits(owner_alpha(&fit0))
 let want:i64=f64_to_bits(expected)
 assert(borrowed_before==want && borrowed_after==want)
 assert(before==borrowed_before && after==borrowed_after)
 assert(fit0.status==0 && fit0.rows==16)
 assert(fit1.rows==16)
 let annotated:OwnerFit=if outer {if inner {owner_left()}else{owner_left()}}else{owner_left()}
 assert(f64_to_bits(annotated.alpha)==f64_to_bits(1.25))
 // One more recursive level and different callees with the same return owner.
 let deep=if outer {if inner {if outer {owner_left()}else{owner_right()}}else{owner_left()}}else{owner_left()}
 assert(f64_to_bits(deep.alpha)==f64_to_bits(1.25))
}
fn main()->i32 with IO,Mut,Div,Panic {
 let registered_a=OtherAlphaA{status:0,rows:16,a:0,b:0,c:0,d:0,e:0,f:0,alpha:3.0}
 let registered_b=OtherAlphaB{status:0,rows:16,a:0,b:0,c:0,d:0,e:0,f:0,alpha:4.0}
 assert(registered_a.rows==16 && registered_b.rows==16)
 owner_case(true,true)
 owner_case(true,false)
 owner_case(false,true)
 owner_case(false,false)
 println("NESTED IF RECORD OWNER PASS")
 0
}
