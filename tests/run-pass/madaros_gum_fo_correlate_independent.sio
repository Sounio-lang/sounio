//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_GUM_FO_CORRELATE_INDEPENDENT_PASS

// NEGATIVE control: two independent measurements must NOT correlate.
//
// Var(x+z) with distinct measure() seeds is σx²+σz², never (σx+σz)².
// A third channel that is actually correlated (x,y) does not leak onto z.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.2)
    let kz: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let x = kx.value
    let y = ky.value
    let z = kz.value

    // No correlate() at all: independent sum.
    let v_xz_before = variance_of(x + z)
    let v_xy_before = variance_of(x + y)

    // Correlate only (x, y). z stays independent of both.
    let _r = correlate(x, y, 1.0)
    let v_xy_after = variance_of(x + y)
    let v_xz_after = variance_of(x + z)
    let v_yz_after = variance_of(y + z)

    print("v_xz_before="); print_f64(v_xz_before); print("\n")
    print("v_xy_before="); print_f64(v_xy_before); print("\n")
    print("v_xy_after="); print_f64(v_xy_after); print("\n")
    print("v_xz_after="); print_f64(v_xz_after); print("\n")
    print("v_yz_after="); print_f64(v_yz_after); print("\n")

    // σx=0.1, σy=0.2, σz=0.1
    // Var(x+z) independent = 0.01+0.01 = 0.02  (NOT 0.04)
    // Var(x+y) independent = 0.01+0.04 = 0.05
    // Var(x+y) ρ=1         = (0.1+0.2)² = 0.09
    // Var(y+z) independent = 0.04+0.01 = 0.05  (NOT 0.09)
    let ok = abs_f(v_xz_before - 0.02) < 1.0e-9
        && abs_f(v_xy_before - 0.05) < 1.0e-9
        && abs_f(v_xy_after - 0.09) < 1.0e-9
        && abs_f(v_xz_after - 0.02) < 1.0e-9
        && abs_f(v_yz_after - 0.05) < 1.0e-9
        && abs_f(v_xz_after - v_xz_before) < 1.0e-12
    if ok {
        print("MADAROS_GUM_FO_CORRELATE_INDEPENDENT_PASS\n")
    } else {
        print("MADAROS_GUM_FO_CORRELATE_INDEPENDENT_FAIL\n")
    }
}
