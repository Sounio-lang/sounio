//@ run-pass
// FIXED (A8, 2026-07-06). Size-bracket witness (m16/m64 forwarding). RUN rc=0.
// Bracket the size threshold for cross-module forwarding-through-inner-call crash.
use testmod::sret_min::{M16, M64, m16_basis_fwd, m64_basis_fwd}

fn main() -> i64 with IO, Mut, Panic {
    println("SZ_start")
    let a = m16_basis_fwd(4, 1)
    println("SZ_after_m16")
    print_int(a.c[1]); print("\n")
    let b = m64_basis_fwd(4, 1)
    println("SZ_after_m64")
    print_int(b.c[1]); print("\n")
    println("SZ_done")
    return 0
}
