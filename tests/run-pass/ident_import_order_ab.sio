//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_IMPORT_ORDER_PASS
//
// Prediction (ADR-032 decision 3, canonical identity under import reordering):
// Importing (ident_order_a, ident_order_b) must yield identical source
// identities and runtime results as importing (ident_order_b, ident_order_a):
//   - shared named Knightian source cancels to [0.0, 0.0]
//   - fresh aleatory sources from both modules are disjoint (`fa + fb` variance 5.0)
//   - scaled parameter calls keep distinct sources (`scale_a(a) + scale_b(b)` variance 40.0).

use fixtures::ident_order_a::{scale_a, fresh_a, shared_knight_a}
use fixtures::ident_order_b::{scale_b, fresh_b, shared_knight_b}

fn main() -> i64 with IO, Epistemic {
    let ka = shared_knight_a()
    let kb = shared_knight_b()
    let kd = ka - kb
    if kd.iv.0 != 0.0 || kd.iv.1 != 0.0 { return 1 }

    let fa = fresh_a()
    let fb = fresh_b()
    let fs = fa + fb
    var df = fs.variance - 5.0
    if df < 0.0 { df = 0.0 - df }
    if df > 1.0e-12 { return 2 }

    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 2.0)
    let s = scale_a(a) + scale_b(b)
    var dv = s.variance - 40.0
    if dv < 0.0 { dv = 0.0 - dv }
    if dv > 1.0e-12 { return 3 }

    println("IDENT_IMPORT_ORDER_PASS")
    0
}
