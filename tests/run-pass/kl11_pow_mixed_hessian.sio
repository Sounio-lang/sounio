//@ run-pass
//@ requires: madaros
//@ expect-stdout: KL11_POW_MIXED_HESSIAN_PASS
//@ sabotage: hessian-chain
//@ description: KL-11 — mixed and pure exponent second derivatives for pow(x, y) on Madaros

// For f(x, y) = x^y:
//   ∂²f/∂x²   = y * (y - 1) * x^(y - 2)
//   ∂²f/∂y²   = x^y * (ln x)²
//   ∂²f/∂x∂y  = (x^y / x) * (1 + y * ln x)
//
// At x = 2.0, y = 3.0:
//   ∂²f/∂x²  = 3 * 2 * 2^1 = 12.0
//   ∂²f/∂y²  = 8 * (ln 2)² ≈ 8 * 0.4804530139182 = 3.8436241113456
//   ∂²f/∂x∂y = 4 * (1 + 3 * ln 2) ≈ 4 * (1 + 2.0794415416798) = 12.317766166719

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    if d < 0.0 { 0.0 - d < tol } else { d < tol }
}

fn main() -> i64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value

    let h_xx = hessian_of(pow(x, y), 0, 0)
    let h_yy = hessian_of(pow(x, y), 1, 1)
    let h_xy = hessian_of(pow(x, y), 0, 1)

    println(h_xx)
    println(h_yy)
    println(h_xy)

    let ok_xx = near(h_xx, 12.0, 1.0e-7)
    let ok_yy = near(h_yy, 3.84362411135, 1.0e-7)
    let ok_xy = near(h_xy, 12.3177661667, 1.0e-7)

    if ok_xx && ok_yy && ok_xy {
        println("KL11_POW_MIXED_HESSIAN_PASS")
        0
    } else {
        println("KL11_POW_MIXED_HESSIAN_FAIL")
        1
    }
}
