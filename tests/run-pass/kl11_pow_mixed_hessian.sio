//@ run-pass
//@ requires: madaros
//@ expect-stdout: KL11_POW_MIXED_HESSIAN_PASS
//@ description: KL-11 mixed Hessian of pow in the exponent
//
// kind 9 must emit d2/dx2, d2/dxdy and d2/dy2. At x=2, y=3:
//   d2/dx2 = y*(y-1)*x^(y-2) = 12
//   d2/dxdy = x^(y-1)*(1 + y*ln(x)) = 12.317766166719344
//   d2/dy2 = x^y*(ln(x))^2 = 3.843624111345611
// Channel 0 is the first measure (x). Channel 1 is y.
// Before the kind-9 exponent chain, the committed ELF from cef3709565 printed
// hxx 12.000000 hxy 0.000000 hyy 0.000000 and exited 1.

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    if d < 0.0 { 0.0 - d < tol } else { d < tol }
}

fn main() -> i64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value

    let hxx = hessian_of(pow(x, y), 0, 0)
    let hxy = hessian_of(pow(x, y), 0, 1)
    let hyy = hessian_of(pow(x, y), 1, 1)

    print("hxx ")
    print_f64(hxx)
    print(" hxy ")
    print_f64(hxy)
    print(" hyy ")
    print_f64(hyy)
    println("")

    let want_xx = 12.0
    let want_xy = 12.317766166719344
    let want_yy = 3.843624111345611
    if near(hxx, want_xx, 1.0e-6) && near(hxy, want_xy, 1.0e-6) && near(hyy, want_yy, 1.0e-6) {
        println("KL11_POW_MIXED_HESSIAN_PASS")
        return 0
    }
    println("KL11_POW_MIXED_HESSIAN_FAIL")
    println("expected hxx 12 hxy 12.317766166719344 hyy 3.843624111345611")
    1
}
