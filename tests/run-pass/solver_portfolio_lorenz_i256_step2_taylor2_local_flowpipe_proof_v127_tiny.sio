//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v127 smoke for Lorenz i256 step-2 Taylor-2 local flowpipe proof

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2063
    receipt_fp = mix(receipt_fp, 418029869, 6079)
    receipt_fp = mix(receipt_fp, 518930343, 6079)
    receipt_fp = mix(receipt_fp, 67400844, 6079)
    receipt_fp = mix(receipt_fp, 98914593, 6079)
    receipt_fp = mix(receipt_fp, 769602917, 6079)
    receipt_fp = mix(receipt_fp, 826067971, 6079)
    receipt_fp = mix(receipt_fp, 487184792, 6079)
    receipt_fp = mix(receipt_fp, 727603483, 6079)
    receipt_fp = mix(receipt_fp, 865711690, 6079)
    receipt_fp = mix(receipt_fp, 296443716, 6079)
    receipt_fp = mix(receipt_fp, 2, 6079)
    receipt_fp = mix(receipt_fp, 16, 6079)
    receipt_fp = mix(receipt_fp, 255, 6079)
    if receipt_fp != 538682593 { return 1 }

    var audit_fp: i64 = 2069
    audit_fp = mix(audit_fp, receipt_fp, 6089)
    audit_fp = mix(audit_fp, 418029869, 6089)
    audit_fp = mix(audit_fp, 518930343, 6089)
    audit_fp = mix(audit_fp, 137970857, 6089)
    audit_fp = mix(audit_fp, 927005854, 6089)
    audit_fp = mix(audit_fp, 175151226, 6089)
    audit_fp = mix(audit_fp, 959064070, 6089)
    audit_fp = mix(audit_fp, 7118356, 6089)
    audit_fp = mix(audit_fp, 340320797, 6089)
    audit_fp = mix(audit_fp, 149302752, 6089)
    audit_fp = mix(audit_fp, 253587342, 6089)
    audit_fp = mix(audit_fp, 867385129, 6089)
    audit_fp = mix(audit_fp, 50054842, 6089)
    audit_fp = mix(audit_fp, 264692547, 6089)
    audit_fp = mix(audit_fp, 82020601, 6089)
    audit_fp = mix(audit_fp, 769602917, 6089)
    audit_fp = mix(audit_fp, 2, 6089)
    audit_fp = mix(audit_fp, 16, 6089)
    audit_fp = mix(audit_fp, 255, 6089)
    if audit_fp != 591327954 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 130, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 130, 1103)
    if entry_fp != 839567289 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 127, 1151)
    manifest_fp = mix(manifest_fp, 131, 1151)
    manifest_fp = mix(manifest_fp, 98914593, 1151)
    manifest_fp = mix(manifest_fp, 67400844, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 443349153 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 127, 1871)
    result_fp = mix(result_fp, 131, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 119, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 586280524 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 127, 1907)
    family_fp = mix(family_fp, 131, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 114, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 899179321 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 127, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 957093564 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 127, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 978938017 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 127, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 251844917 { return 9 }
    return 0
}
