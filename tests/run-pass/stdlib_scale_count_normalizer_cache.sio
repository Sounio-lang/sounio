//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: CHECKED NORMALIZER CACHE PASS
use stats::regression::nb2_likelihood::{Nb2Likelihood,Nb2LikelihoodSlot,Nb2CachedLikelihoodSlot,nb2_likelihood_slot,nb2_log_probability_into,nb2_likelihood_snapshot,nb2_cached_likelihood_slot,nb2_cached_likelihood_slot_reset,nb2_cached_likelihood_slot_status,nb2_log_probability_cached_into,nb2_cached_likelihood_snapshot,nb2_cached_likelihood_normalizer_evaluated,nb2_cached_likelihood_cache_hit,nb2_cached_likelihood_cache_bypass,nb2_cached_likelihood_cache_capacity,nb2_cached_likelihood_cache_payload_bytes}
use stats::regression::count_fit_trace::{count_fit_trace_slot,count_fit_trace_bounded,count_fit_trace_status,count_fit_trace_metric,count_fit_trace_reset,count_fit_trace_snapshot,count_fit_trace_normalizer_add,count_fit_trace_normalizer_note,count_fit_trace_normalizer_evaluations,count_fit_trace_normalizer_cache_hits,count_fit_trace_normalizer_cache_bypasses}
fn cache_metadata_equal(a:&Nb2Likelihood,b:&Nb2Likelihood)->bool with Mut,Div {
 if a.status!=b.status {return false}
 if a.count!=b.count {return false}
 if a.normalizer_status!=b.normalizer_status {return false}
 if a.residual_status!=b.residual_status {return false}
 if a.deviance_status!=b.deviance_status {return false}
 if a.poisson_limit!=b.poisson_limit {return false}
 if a.stirling_used!=b.stirling_used {return false}
 if a.remainder_estimate_available!=b.remainder_estimate_available {return false}
 if a.assumptions_assessed!=b.assumptions_assessed {return false}
 let a0:f64=a.log_probability
 let b0:f64=b.log_probability
 if f64_to_bits(a0)!=f64_to_bits(b0) {return false}
 let a1:f64=a.saturated_log_probability
 let b1:f64=b.saturated_log_probability
 if f64_to_bits(a1)!=f64_to_bits(b1) {return false}
 let a2:f64=a.residual
 let b2:f64=b.residual
 if f64_to_bits(a2)!=f64_to_bits(b2) {return false}
 let a3:f64=a.deviance
 let b3:f64=b.deviance
 if f64_to_bits(a3)!=f64_to_bits(b3) {return false}
 let a4:f64=a.normalizer_remainder_estimate
 let b4:f64=b.normalizer_remainder_estimate
 if f64_to_bits(a4)!=f64_to_bits(b4) {return false}
 true
}
fn cache_one(count:i64,mean:f64,alpha:f64,evaluated:bool,hit:bool,bypass:bool,
 old:&!Nb2LikelihoodSlot,cache:&!Nb2CachedLikelihoodSlot) with Mut,Div,Panic {
 let old_status:i64=nb2_log_probability_into(count,mean,alpha,old)
 let cache_status:i64=nb2_log_probability_cached_into(count,mean,alpha,cache)
 assert(old_status==cache_status)
 let a=nb2_likelihood_snapshot(old)
 let b=nb2_cached_likelihood_snapshot(cache)
 assert(cache_metadata_equal(&a,&b))
 assert(nb2_cached_likelihood_normalizer_evaluated(cache)==evaluated)
 assert(nb2_cached_likelihood_cache_hit(cache)==hit)
 assert(nb2_cached_likelihood_cache_bypass(cache)==bypass)
}
fn main()->i32 with IO,Mut,Div,Panic {
 assert(nb2_cached_likelihood_cache_capacity()==64)
 assert(nb2_cached_likelihood_cache_payload_bytes()==2048)
 var old=nb2_likelihood_slot()
 var cache=nb2_cached_likelihood_slot()
 cache_one(3,4.0,0.5,true,false,false,&!old,&!cache)
 cache_one(3,8.0,0.5,false,true,false,&!old,&!cache)
 cache_one(3,0.0,0.5,false,false,false,&!old,&!cache)
 cache_one(3,4.0,0.5,false,true,false,&!old,&!cache)
 cache_one(3,4.0,0.75,true,false,false,&!old,&!cache)
 cache_one(3,4.0,0.5,true,false,false,&!old,&!cache)
 cache_one(63,63.5,0.2,true,false,false,&!old,&!cache)
 cache_one(63,65.0,0.2,false,true,false,&!old,&!cache)
 cache_one(64,65.0,0.2,true,false,true,&!old,&!cache)
 cache_one(64,68.0,0.2,true,false,true,&!old,&!cache)
 cache_one(7,8.0,0.5,true,false,false,&!old,&!cache)
 cache_one(7,9.0,0.5,false,true,false,&!old,&!cache)
 cache_one(8,9.0,0.5,true,false,false,&!old,&!cache)
 cache_one(8,12.0,0.5,false,true,false,&!old,&!cache)
 let negative_zero:f64=bits_to_f64(-9223372036854775808)
 cache_one(1,2.0,0.0,true,false,false,&!old,&!cache)
 cache_one(1,2.5,negative_zero,true,false,false,&!old,&!cache)
 cache_one(1,3.0,negative_zero,false,true,false,&!old,&!cache)
 cache_one(1,2.0,0.0,true,false,false,&!old,&!cache)
 let minimum:f64=2.2250738585072014e-308/4503599627370496.0
 cache_one(3,4.0,minimum,true,false,false,&!old,&!cache)
 cache_one(3,4.0,minimum,true,false,false,&!old,&!cache)
 cache_one(3,4.0,0.5,false,true,false,&!old,&!cache)
 cache_one(0,1.7976931348623157e308,0.0,true,false,false,&!old,&!cache)
 cache_one(0,minimum,0.0,false,true,false,&!old,&!cache)
 cache_one(9007199254740992,1e308,0.0,true,false,true,&!old,&!cache)
 cache_one(9007199254740993,1.0,0.0,false,false,false,&!old,&!cache)
 cache_one(-1,1.0,0.0,false,false,false,&!old,&!cache)
 let nan:f64=0.0/0.0
 let inf:f64=1.0/0.0
 cache_one(3,nan,0.5,false,false,false,&!old,&!cache)
 cache_one(3,1.0,inf,false,false,false,&!old,&!cache)
 cache_one(3,1.0,-0.5,false,false,false,&!old,&!cache)
 cache_one(3,4.0,0.5,false,true,false,&!old,&!cache)
 let saved=nb2_cached_likelihood_snapshot(&cache)
 let reference=nb2_likelihood_snapshot(&old)
 nb2_cached_likelihood_slot_reset(&!cache)
 assert(nb2_cached_likelihood_slot_status(&cache)==5)
 assert(!nb2_cached_likelihood_cache_hit(&cache))
 assert(!nb2_cached_likelihood_normalizer_evaluated(&cache))
 assert(!nb2_cached_likelihood_cache_bypass(&cache))
 assert(cache_metadata_equal(&saved,&reference))
 cache_one(3,4.0,0.5,true,false,false,&!old,&!cache)
 cache_one(3,4.125,0.5,false,true,false,&!old,&!cache)
 var trace=count_fit_trace_bounded(1)
 assert(count_fit_trace_normalizer_note(&!trace,1)==0)
 assert(count_fit_trace_normalizer_evaluations(&trace)==1)
 assert(count_fit_trace_normalizer_note(&!trace,1)==1)
 assert(count_fit_trace_normalizer_evaluations(&trace)==1)
 count_fit_trace_reset(&!trace)
 assert(count_fit_trace_status(&trace)==0 && count_fit_trace_normalizer_evaluations(&trace)==0)
 assert(count_fit_trace_normalizer_note(&!trace,2)==0)
 assert(count_fit_trace_normalizer_cache_hits(&trace)==1)
 assert(count_fit_trace_normalizer_note(&!trace,3)==0)
 assert(count_fit_trace_normalizer_cache_bypasses(&trace)==1)
 assert(count_fit_trace_metric(&trace,11)==-1)
 let snapshot=count_fit_trace_snapshot(&trace)
 assert(snapshot.fit_calls==0 && snapshot.full_logpmf_row_calls==0)
 count_fit_trace_reset(&!trace)
 assert(count_fit_trace_normalizer_cache_hits(&trace)==0 && count_fit_trace_normalizer_cache_bypasses(&trace)==0)
 assert(count_fit_trace_normalizer_note(&!trace,4)==2)
 var maximum=count_fit_trace_slot()
 assert(count_fit_trace_normalizer_add(&!maximum,1,9223372036854775807)==0)
 assert(count_fit_trace_normalizer_note(&!maximum,1)==1)
 assert(count_fit_trace_normalizer_evaluations(&maximum)==9223372036854775807)
 var zero=count_fit_trace_bounded(0)
 assert(count_fit_trace_normalizer_note(&!zero,3)==1)
 assert(count_fit_trace_normalizer_cache_bypasses(&zero)==0)
 println("CHECKED NORMALIZER CACHE PASS")
 0
}
