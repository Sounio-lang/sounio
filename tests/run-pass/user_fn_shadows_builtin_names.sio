//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: shadow sin: PASS
//@ expect-stdout-contains: shadow sqrt: PASS
//@ expect-stdout-contains: shadow variance_of: PASS
//@ expect-stdout-contains: shadow acknowledge: PASS
//@ expect-stdout-contains: shadow seq_new: PASS
//@ expect-stdout-contains: shadow assert: PASS
//@ expect-stdout-contains: shadow print_int: PASS
//@ expect-stdout-contains: shadow slice_len: PASS
//@ description: P1.4 -- private user fns named like compiler builtins (math, epistemic, seq, print, assert) are the ones called

fn sin(x: i64) -> i64 { x + 1000 }
fn sqrt(x: i64) -> i64 { x * 3 }
fn variance_of(x: i64) -> i64 { x - 1 }
fn acknowledge(x: i64, y: i64) -> i64 { x * y }
fn seq_new(n: i64) -> i64 { n + 7 }
fn assert(x: i64) -> i64 { x + 2 }
fn print_int(x: i64) -> i64 { x + 9 }
fn slice_len(x: i64) -> i64 { x * 10 }

fn report(name: string, ok: bool) with IO {
    print("shadow ")
    print(name)
    if ok { print(": PASS\n") } else { print(": FAIL\n") }
}

fn main() with IO {
    report("sin", sin(5) == 1005)
    report("sqrt", sqrt(5) == 15)
    report("variance_of", variance_of(5) == 4)
    report("acknowledge", acknowledge(6, 7) == 42)
    report("seq_new", seq_new(1) == 8)
    report("assert", assert(1) == 3)
    report("print_int", print_int(1) == 10)
    report("slice_len", slice_len(4) == 40)
}
