//@ check-only
// Imported API conformance for proof-carrying reflexive inquiry D3.

use epistemic::proof_carrying_reflexive_inquiry::*

fn main() with Panic {
    let h0 = declare_layered_inquiry_hypothesis(210, 0, 220)
    let h1 = declare_layered_inquiry_hypothesis(211, 1, 220)
    let h2 = declare_layered_inquiry_hypothesis(212, 2, 220)
    let family = declare_three_locus_inquiry_family(220, 8200, h0, h1, h2)
    let pair = declare_matched_synthetic_protocol_pair(400, 8200, 1, 0)

    let action_p = declare_synthetic_inquiry_action(301, 8200, 0)
    let action_q = declare_synthetic_inquiry_action(302, 8200, 1)
    let action_r = declare_synthetic_inquiry_action(303, 8200, 2)

    let h0_p = derive_inquiry_effect_footprint(501, h0, action_p)
    let h0_q = derive_inquiry_effect_footprint(502, h0, action_q)
    let h1_p = derive_inquiry_effect_footprint(503, h1, action_p)
    let h1_q = derive_inquiry_effect_footprint(504, h1, action_q)
    let h1_r = derive_inquiry_effect_footprint(505, h1, action_r)
    let h2_p = derive_inquiry_effect_footprint(506, h2, action_p)
    let h2_q = derive_inquiry_effect_footprint(507, h2, action_q)

    let passive_interference = record_potential_inquiry_interference(
        601, h0_p, h0_q,
    )
    let relational_interference = record_potential_inquiry_interference(
        602, h1_p, h1_q,
    )
    let instrument_interference = record_potential_inquiry_interference(
        603, h2_p, h2_q,
    )
    let overlapping_additive_interference = record_potential_inquiry_interference(
        604, h1_q, h1_r,
    )
    assert(!passive_interference.footprint_overlap)
    assert(relational_interference.writes_same_relational_layer)
    assert(instrument_interference.writes_same_instrument_layer)
    assert(overlapping_additive_interference.footprint_overlap)
    assert(!relational_interference.exact_noncommutation_established)

    // Passive P;Q and Q;P preserve both the full state and emitted observations.
    let passive_pq0 = begin_layered_inquiry_state(1001, family, h0, pair)
    let passive_pq1 = apply_synthetic_inquiry_action(
        1101, 1201, passive_pq0, action_p, 5101,
    )
    let passive_pq2 = apply_synthetic_inquiry_action(
        1102, 1202, layered_inquiry_transition_result(passive_pq1), action_q, 5102,
    )
    let passive_qp0 = begin_layered_inquiry_state(1002, family, h0, pair)
    let passive_qp1 = apply_synthetic_inquiry_action(
        1103, 1203, passive_qp0, action_q, 5201,
    )
    let passive_qp2 = apply_synthetic_inquiry_action(
        1104, 1204, layered_inquiry_transition_result(passive_qp1), action_p, 5202,
    )
    let passive_commutation = certify_passive_inquiry_commutation(
        1301, passive_pq1, passive_pq2, passive_qp1, passive_qp2,
    )
    assert(passive_commutation.final_process_and_instrument_layers_equal)
    assert(passive_commutation.emitted_observation_traces_equal)
    assert(passive_commutation.exact_commutation_on_witness)
    assert(!passive_commutation.universal_observation_commutation_claimed)
    let reorder = authorize_inquiry_reordering(1302, passive_commutation)
    assert(reorder.process_layers_and_emitted_values_commute)
    assert(!reorder.complete_ordered_state_equivalence_claimed)
    assert(reorder.declared_fixture_only)

    // Relational and instrument loci produce the same projected order trace.
    let relational_pq0 = begin_layered_inquiry_state(2001, family, h1, pair)
    let relational_pq1 = apply_synthetic_inquiry_action(
        2101, 2201, relational_pq0, action_p, 5301,
    )
    let relational_pq2 = apply_synthetic_inquiry_action(
        2102, 2202, layered_inquiry_transition_result(relational_pq1), action_q, 5302,
    )
    let relational_qp0 = begin_layered_inquiry_state(2002, family, h1, pair)
    let relational_qp1 = apply_synthetic_inquiry_action(
        2103, 2203, relational_qp0, action_q, 5401,
    )
    let relational_qp2 = apply_synthetic_inquiry_action(
        2104, 2204, layered_inquiry_transition_result(relational_qp1), action_p, 5402,
    )
    let relational_noncommutation = certify_exact_inquiry_noncommutation_witness(
        2301, relational_interference,
        relational_pq1, relational_pq2, relational_qp1, relational_qp2,
    )
    assert(relational_noncommutation.p_then_q_first_observation == 2)
    assert(relational_noncommutation.p_then_q_second_observation == 3)
    assert(relational_noncommutation.q_then_p_first_observation == 2)
    assert(relational_noncommutation.q_then_p_second_observation == 4)
    assert(relational_noncommutation.p_then_q_final_relational_state == 3)
    assert(relational_noncommutation.p_then_q_final_instrument_state == 0)
    assert(relational_noncommutation.projected_commutator == -1)
    assert(relational_noncommutation.exact_noncommutation_on_witness)
    assert(!relational_noncommutation.nonassociativity_established)
    assert(!relational_noncommutation.biological_reactivity_established)

    let instrument_pq0 = begin_layered_inquiry_state(3001, family, h2, pair)
    let instrument_pq1 = apply_synthetic_inquiry_action(
        3101, 3201, instrument_pq0, action_p, 5501,
    )
    let instrument_pq2 = apply_synthetic_inquiry_action(
        3102, 3202, layered_inquiry_transition_result(instrument_pq1), action_q, 5502,
    )
    let instrument_qp0 = begin_layered_inquiry_state(3002, family, h2, pair)
    let instrument_qp1 = apply_synthetic_inquiry_action(
        3103, 3203, instrument_qp0, action_q, 5601,
    )
    let instrument_qp2 = apply_synthetic_inquiry_action(
        3104, 3204, layered_inquiry_transition_result(instrument_qp1), action_p, 5602,
    )
    let instrument_noncommutation = certify_exact_inquiry_noncommutation_witness(
        3301, instrument_interference,
        instrument_pq1, instrument_pq2, instrument_qp1, instrument_qp2,
    )
    assert(instrument_noncommutation.p_then_q_first_observation == 2)
    assert(instrument_noncommutation.p_then_q_second_observation == 3)
    assert(instrument_noncommutation.q_then_p_first_observation == 2)
    assert(instrument_noncommutation.q_then_p_second_observation == 4)
    assert(instrument_noncommutation.p_then_q_final_relational_state == 1)
    assert(instrument_noncommutation.p_then_q_final_instrument_state == 2)
    assert(instrument_noncommutation.projected_commutator == -1)
    assert(!instrument_noncommutation.biological_reactivity_established)

    // Overlapping relational writes can commute on final state while the
    // emitted evidence trace remains order-sensitive.
    let additive_qr0 = begin_layered_inquiry_state(4001, family, h1, pair)
    let additive_qr1 = apply_synthetic_inquiry_action(
        4101, 4201, additive_qr0, action_q, 5701,
    )
    let additive_qr2 = apply_synthetic_inquiry_action(
        4102, 4202, layered_inquiry_transition_result(additive_qr1), action_r, 5702,
    )
    let additive_rq0 = begin_layered_inquiry_state(4002, family, h1, pair)
    let additive_rq1 = apply_synthetic_inquiry_action(
        4103, 4203, additive_rq0, action_r, 5801,
    )
    let additive_rq2 = apply_synthetic_inquiry_action(
        4104, 4204, layered_inquiry_transition_result(additive_rq1), action_q, 5802,
    )
    let additive_control = certify_overlapping_write_state_commutation(
        4301, overlapping_additive_interference,
        additive_qr1, additive_qr2, additive_rq1, additive_rq2,
    )
    assert(additive_control.write_footprints_overlap)
    assert(additive_control.final_process_and_instrument_layers_equal)
    assert(!additive_control.emitted_observation_traces_equal)
    assert(additive_control.state_commutator_zero)
    assert(!additive_control.full_inquiry_reordering_authorized)

    let expanded = record_full_state_expansion(4401, relational_noncommutation)
    assert(expanded.relational_layer_retained)
    assert(expanded.instrument_layer_retained)
    assert(expanded.action_history_retained)
    assert(expanded.transition_is_deterministic_on_expanded_state)
    assert(!expanded.observable_projection_markov_sufficient)
    assert(expanded.projected_order_effect_preserved)
    assert(!expanded.nonassociativity_established)

    // The order trace removes only the passive model. It cannot locate the
    // write without a separate layer audit.
    let initial = begin_reflexive_inquiry_contest(6001, family)
    let missing = record_missing_order_trace_observation(6002, family, 1)
    let unaudited = record_unaudited_order_trace_observation(6003, family, 1)
    let missing_abstention = abstain_on_missing_order_trace(6004, initial, missing)
    let unaudited_abstention = abstain_on_unaudited_order_trace(
        6005, initial, unaudited,
    )
    assert(missing_abstention.survivor_mask_unchanged == 7)
    assert(unaudited_abstention.survivor_mask_unchanged == 7)
    assert(missing_abstention.hypotheses_eliminated == 0)
    assert(unaudited_abstention.hypotheses_eliminated == 0)

    let order_provenance = record_inquiry_evidence_provenance(
        6101, 6201, 8200, 1, 0,
    )
    let observed_order = admit_order_trace_observation(
        6301, initial, family, pair, order_provenance, 2, 3, 2, 4,
    )
    let after_order = update_reflexive_contest_with_order_trace(
        6401, 6402, initial, family, observed_order,
    )
    let after_order_state = reflexive_contest_transition_result(after_order)
    assert(reflexive_contest_survivor_mask(after_order_state) == 6)
    assert(reflexive_contest_survivor_count(after_order_state) == 2)
    assert(reflexive_contest_burden_spent(after_order_state) == 4)
    assert(reflexive_contest_provenance_fingerprint(after_order_state) == 6101)
    let ambiguity = certify_reactive_locus_ambiguity(6501, after_order, family)
    assert(ambiguity.passive_hypothesis_eliminated)
    assert(ambiguity.relational_hypothesis_survives)
    assert(ambiguity.instrument_hypothesis_survives)
    assert(ambiguity.order_effect_established_within_family)
    assert(!ambiguity.reactivity_locus_identified)
    assert(!ambiguity.causal_mechanism_established)
    assert(!ambiguity.clinical_authority)

    let relational_audit = declare_synthetic_layer_audit_probe(6601, 8200, 0)
    let audit_provenance = record_inquiry_evidence_provenance(
        6102, 6202, 8200, 2, 6101,
    )
    let observed_audit = admit_layer_audit_observation(
        6701, after_order_state, family, relational_audit, audit_provenance, 3,
    )
    let after_audit = update_reflexive_contest_with_layer_audit(
        6801, 6802, after_order_state, family, observed_audit,
    )
    let after_audit_state = reflexive_contest_transition_result(after_audit)
    assert(reflexive_contest_survivor_mask(after_audit_state) == 2)
    assert(reflexive_contest_survivor_count(after_audit_state) == 1)
    assert(reflexive_contest_burden_spent(after_audit_state) == 7)
    assert(reflexive_contest_provenance_fingerprint(after_audit_state) == 195233)
    let identification = certify_declared_locus_identification(
        6901, after_audit, family,
    )
    assert(identification.selected_hypothesis_id == 211)
    assert(identification.selected_mode == 1)
    assert(identification.locus_identified_within_declared_family)
    assert(!identification.global_truth_established)
    assert(!identification.biological_mechanism_established)
    assert(!identification.clinical_authority)

    let q0 = declare_layered_inquiry_hypothesis(410, 0, 221)
    let q1 = declare_layered_inquiry_hypothesis(411, 1, 221)
    let q2 = declare_layered_inquiry_hypothesis(412, 2, 221)
    let relabeled = declare_three_locus_inquiry_family(221, 8200, q0, q1, q2)
    let relabel = certify_inquiry_relabel_invariance(7001, family, relabeled)
    assert(relabel.hypothesis_ids_distinct)
    assert(relabel.all_trace_and_audit_predictions_equal)
    assert(relabel.partitions_invariant)
}
