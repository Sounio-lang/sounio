//@ run-pass
//@ requires: madaros

// Parses a real openssl-generated EC (P-384) certificate and confirms the
// extracted public key point matches openssl's own reported value.
// Mirrors tests/run-pass/x509_ec_public_key_parsing.sio (the P-256
// analogue) exactly, but exercises the new PUBKEY_ALG_EC_P384 recognition
// and the 97-byte uncompressed-point (0x04 || 48-byte X || 48-byte Y)
// parse added to stdlib/x509/cert.sio in this task.
//
// Certificate generated via:
//   openssl ecparam -name secp384r1 -genkey -noout -out p384_test_key.pem
//   openssl req -new -x509 -key p384_test_key.pem -out p384_test_cert.pem \
//     -days 1 -subj "/CN=p384-test.example"
//   openssl x509 -in p384_test_cert.pem -outform DER -out p384_test_cert.der
//
// `openssl x509 -in p384_test_cert.pem -noout -text` reports:
//   Public Key Algorithm: id-ecPublicKey
//   Public-Key: (384 bit)
//   ASN1 OID: secp384r1
//   NIST CURVE: P-384
// `openssl ec -in p384_test_key.pem -text -noout` reports the same raw
// uncompressed point (`pub:` field, `04 || X || Y`) embedded below in
// `expected_x_limbs`/`expected_y_limbs`:
//   04:28:41:2a:79:56:45:98:1c:a8:c4:59:9d:50:cc:
//   c0:44:c4:51:75:21:98:70:c1:71:e1:78:ed:a9:fb:
//   49:29:67:10:8b:27:29:df:30:3e:42:90:50:f9:4c:
//   02:4d:39:7e:37:61:f6:07:d3:8f:8c:3b:70:0a:92:
//   eb:0e:15:c2:f4:2f:61:c7:90:c2:93:fb:c0:11:fe:
//   f3:30:ab:53:6e:e4:44:69:2b:8a:17:99:d6:dc:4d:
//   e9:8a:66:ec:1b:31:55
//
// Independently cross-checked against the certificate's own DER bytes via
// `openssl asn1parse -in p384_test_cert.der -inform DER`: the
// SubjectPublicKeyInfo SEQUENCE contains an AlgorithmIdentifier SEQUENCE
// with OID `06 07 2A 86 48 CE 3D 02 01` (id-ecPublicKey, 7 bytes) followed
// by curve OID `06 05 2B 81 04 00 22` (secp384r1, 5 bytes) -- both
// independently re-derived from their dotted-decimal form
// (1.2.840.10045.2.1 / 1.3.132.0.34) via the standard ASN.1 OID base-128
// encoding rule, matching stdlib/x509/oid.sio's own `oid_secp384r1`. The
// BIT STRING (`03 62 00 04 ...`) has content_len 0x62 = 98 bytes: 1
// "unused bits" byte + 1 uncompressed-point prefix (0x04) + 48 bytes X +
// 48 bytes Y -- the same 97 raw point bytes reproduced above. Full
// fixture-generation transcript in this task's own report
// (task-4-report.md).

use x509::cert::*
use crypto::ecdsa_p256::*
use bignum::bigint::*
use net::socket::*

// Little-endian 16-bit limbs of the real certificate's EC public key X
// coordinate, independently regrouped (big-endian byte pairs -> u16,
// least-significant pair first) from the `pub:` bytes quoted above.
fn expected_x_limbs() -> [u16; 24] {
    let r: [u16; 24] = [
        14718, 589, 63820, 36944, 15938, 57136, 10025, 4235,
        10599, 64329, 60841, 57720, 49521, 39024, 29985, 50257,
        49220, 20684, 22941, 43204, 38940, 22085, 10873, 10305,
    ]
    r
}

fn expected_y_limbs() -> [u16; 24] {
    let r: [u16; 24] = [
        12629, 60443, 35430, 19945, 55004, 6041, 11146, 17513,
        28388, 43859, 62256, 4606, 64448, 49811, 51088, 12129,
        49908, 3605, 37611, 28682, 35899, 54159, 62983, 14177,
    ]
    r
}

fn build_bigint_24(values: [u16; 24]) -> BigInt {
    var result = bigint_zero()
    var i: i64 = 0
    while i < 24 {
        result.limbs[i as usize] = values[i as usize]
        i = i + 1
    }
    result.len = 24
    result
}

fn main() -> i64 with IO {
    let total_len: i64 = 461
    let buf = rawbuf_new(total_len + 8)

    let bytes: [i64; 461] = [
        0x30, 0x82, 0x01, 0xC9, 0x30, 0x82, 0x01, 0x50, 0xA0, 0x03, 0x02, 0x01,
        0x02, 0x02, 0x14, 0x5A, 0xF6, 0x1E, 0x34, 0x5C, 0xC9, 0xCB, 0x63, 0xE3,
        0x5C, 0xB1, 0x9F, 0x59, 0x0C, 0x52, 0x3F, 0x29, 0xCA, 0x45, 0xB2, 0x30,
        0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x30,
        0x1C, 0x31, 0x1A, 0x30, 0x18, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C, 0x11,
        0x70, 0x33, 0x38, 0x34, 0x2D, 0x74, 0x65, 0x73, 0x74, 0x2E, 0x65, 0x78,
        0x61, 0x6D, 0x70, 0x6C, 0x65, 0x30, 0x1E, 0x17, 0x0D, 0x32, 0x36, 0x30,
        0x38, 0x32, 0x37, 0x31, 0x35, 0x34, 0x39, 0x35, 0x37, 0x5A, 0x17, 0x0D,
        0x32, 0x36, 0x30, 0x38, 0x32, 0x38, 0x31, 0x35, 0x34, 0x39, 0x35, 0x37,
        0x5A, 0x30, 0x1C, 0x31, 0x1A, 0x30, 0x18, 0x06, 0x03, 0x55, 0x04, 0x03,
        0x0C, 0x11, 0x70, 0x33, 0x38, 0x34, 0x2D, 0x74, 0x65, 0x73, 0x74, 0x2E,
        0x65, 0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65, 0x30, 0x76, 0x30, 0x10, 0x06,
        0x07, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01, 0x06, 0x05, 0x2B, 0x81,
        0x04, 0x00, 0x22, 0x03, 0x62, 0x00, 0x04, 0x28, 0x41, 0x2A, 0x79, 0x56,
        0x45, 0x98, 0x1C, 0xA8, 0xC4, 0x59, 0x9D, 0x50, 0xCC, 0xC0, 0x44, 0xC4,
        0x51, 0x75, 0x21, 0x98, 0x70, 0xC1, 0x71, 0xE1, 0x78, 0xED, 0xA9, 0xFB,
        0x49, 0x29, 0x67, 0x10, 0x8B, 0x27, 0x29, 0xDF, 0x30, 0x3E, 0x42, 0x90,
        0x50, 0xF9, 0x4C, 0x02, 0x4D, 0x39, 0x7E, 0x37, 0x61, 0xF6, 0x07, 0xD3,
        0x8F, 0x8C, 0x3B, 0x70, 0x0A, 0x92, 0xEB, 0x0E, 0x15, 0xC2, 0xF4, 0x2F,
        0x61, 0xC7, 0x90, 0xC2, 0x93, 0xFB, 0xC0, 0x11, 0xFE, 0xF3, 0x30, 0xAB,
        0x53, 0x6E, 0xE4, 0x44, 0x69, 0x2B, 0x8A, 0x17, 0x99, 0xD6, 0xDC, 0x4D,
        0xE9, 0x8A, 0x66, 0xEC, 0x1B, 0x31, 0x55, 0xA3, 0x53, 0x30, 0x51, 0x30,
        0x1D, 0x06, 0x03, 0x55, 0x1D, 0x0E, 0x04, 0x16, 0x04, 0x14, 0x33, 0x8E,
        0x5A, 0x26, 0xFD, 0x9A, 0xFA, 0x19, 0x74, 0x77, 0xCC, 0x2D, 0x6F, 0x5E,
        0x4D, 0x85, 0x5D, 0xA7, 0x98, 0x8C, 0x30, 0x1F, 0x06, 0x03, 0x55, 0x1D,
        0x23, 0x04, 0x18, 0x30, 0x16, 0x80, 0x14, 0x33, 0x8E, 0x5A, 0x26, 0xFD,
        0x9A, 0xFA, 0x19, 0x74, 0x77, 0xCC, 0x2D, 0x6F, 0x5E, 0x4D, 0x85, 0x5D,
        0xA7, 0x98, 0x8C, 0x30, 0x0F, 0x06, 0x03, 0x55, 0x1D, 0x13, 0x01, 0x01,
        0xFF, 0x04, 0x05, 0x30, 0x03, 0x01, 0x01, 0xFF, 0x30, 0x0A, 0x06, 0x08,
        0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x03, 0x67, 0x00, 0x30,
        0x64, 0x02, 0x30, 0x26, 0x97, 0xF5, 0x05, 0x5A, 0xD4, 0x97, 0x53, 0xED,
        0xCB, 0xAC, 0xCD, 0xE2, 0x92, 0xB5, 0x74, 0x95, 0x91, 0xA0, 0x44, 0xC4,
        0x71, 0x53, 0x5E, 0x80, 0x22, 0xF2, 0xEE, 0x26, 0x75, 0xCD, 0x67, 0xFE,
        0xFE, 0xA4, 0x52, 0x1E, 0xBC, 0xB2, 0x7A, 0xAA, 0x5A, 0x5A, 0xBB, 0x3F,
        0xE9, 0x70, 0xA7, 0x02, 0x30, 0x6E, 0xDA, 0x36, 0xFC, 0x9B, 0xB8, 0xBE,
        0x41, 0x82, 0x1D, 0x48, 0x7F, 0x3E, 0x91, 0x4D, 0xA6, 0x40, 0xD9, 0x51,
        0xC6, 0xBC, 0x69, 0xA6, 0xF5, 0x8C, 0x72, 0x26, 0x37, 0x5C, 0x5B, 0xE6,
        0xC3, 0x54, 0x4C, 0x53, 0xD0, 0x35, 0x2C, 0x62, 0x86, 0x50, 0x2B, 0x97,
        0xC5, 0xC5, 0xEB, 0x31, 0xD0,
    ]

    var i: i64 = 0
    while i < total_len {
        rawbuf_set(&buf, i, bytes[i as usize])
        i = i + 1
    }

    // Per Finding 25's workaround (tuple-destructured struct-typed local
    // does not propagate the struct type): declare `cert` first via
    // certificate_zero(), then overwrite its VALUE via assignment.
    var cert = certificate_zero()
    let (cert_raw, status) = x509_parse_certificate(&buf, total_len)
    cert = cert_raw

    if status != X509_OK {
        println("x509_parse_p384_public_key: parse failed")
        return 1
    }

    if cert.public_key_algorithm != PUBKEY_ALG_EC_P384 {
        println("x509_parse_p384_public_key: wrong algorithm detected")
        return 1
    }

    let expected_x = build_bigint_24(expected_x_limbs())
    let expected_y = build_bigint_24(expected_y_limbs())

    if bigint_cmp(&cert.ec_public_key.x, &expected_x) != 0 {
        println("x509_parse_p384_public_key: X coordinate mismatch")
        return 1
    }
    if bigint_cmp(&cert.ec_public_key.y, &expected_y) != 0 {
        println("x509_parse_p384_public_key: Y coordinate mismatch")
        return 1
    }

    // Negative/regression guard: an EC certificate must NOT populate the
    // RSA-only fields.
    if bigint_cmp(&cert.modulus, &bigint_zero()) != 0 {
        println("x509_parse_p384_public_key: modulus unexpectedly non-zero for an EC certificate")
        return 1
    }
    if bigint_cmp(&cert.public_exponent, &bigint_zero()) != 0 {
        println("x509_parse_p384_public_key: public_exponent unexpectedly non-zero for an EC certificate")
        return 1
    }

    println("x509_parse_p384_public_key: EC public key extracted correctly")
    return 0
}
