//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v22 smoke for Lorenz ball-fixed step-policy margin receipt

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 25 { return 0 - 1 }
    if instance_fp != 377517990 { return 0 - 1 }
    if certificate_fp != 250048780 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 25 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn margin_instance_fingerprint(scale: i64, steps: i64,
                              quality_profile_fp: i64,
                              step_policy_fp: i64) -> i64 with Mod {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if step_policy_fp != 231786611 { return 0 - 1 }

    var fp: i64 = 223
    fp = portfolio_mix(fp, scale, 2111)
    fp = portfolio_mix(fp, steps, 2111)
    fp = portfolio_mix(fp, quality_profile_fp, 2111)
    fp = portfolio_mix(fp, step_policy_fp, 2111)
    return fp
}

fn margin_certificate_fingerprint(instance_fp: i64, margin_fp: i64,
                                  fill_margin_ppm: i64,
                                  slack_margin_ppm: i64,
                                  aspect_margin_q: i64,
                                  volume_margin: i64,
                                  min_ppm_margin: i64,
                                  margin_mask: i64,
                                  action_code: i64) -> i64 with Mod {
    if instance_fp != 377517990 { return 0 - 1 }
    if margin_fp != 494960746 { return 0 - 1 }
    if fill_margin_ppm != 1274 { return 0 - 1 }
    if slack_margin_ppm != 1273 { return 0 - 1 }
    if aspect_margin_q != 1 { return 0 - 1 }
    if volume_margin != 583927633827840 { return 0 - 1 }
    if min_ppm_margin != 1273 { return 0 - 1 }
    if margin_mask != 15 { return 0 - 1 }
    if action_code != 1 { return 0 - 1 }

    var fp: i64 = 227
    fp = portfolio_mix(fp, instance_fp, 2131)
    fp = portfolio_mix(fp, margin_fp, 2131)
    fp = portfolio_mix(fp, fill_margin_ppm, 2131)
    fp = portfolio_mix(fp, slack_margin_ppm, 2131)
    fp = portfolio_mix(fp, aspect_margin_q, 2131)
    fp = portfolio_mix(fp, volume_margin, 2131)
    fp = portfolio_mix(fp, min_ppm_margin, 2131)
    fp = portfolio_mix(fp, margin_mask, 2131)
    fp = portfolio_mix(fp, action_code, 2131)
    return fp
}

fn portfolio_v22_manifest_fingerprint(margin_entry_fp: i64) -> i64 with Mod {
    if margin_entry_fp != 757892608 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 22, 1151)
    fp = portfolio_mix(fp, 26, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, margin_entry_fp, 1151)
    return fp
}

fn portfolio_v22_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 420758164 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 22, 1871)
    fp = portfolio_mix(fp, 26, 1871)
    fp = portfolio_mix(fp, 8, 1871)
    fp = portfolio_mix(fp, 16, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v22_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 420758164 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 22, 1907)
    fp = portfolio_mix(fp, 26, 1907)
    fp = portfolio_mix(fp, 4, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 16, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v22_readiness_fingerprint(
    manifest_fp: i64,
    result_coverage_fp: i64,
    family_coverage_fp: i64,
    acceptance_receipt_fp: i64,
    audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 420758164 { return 0 - 1 }
    if result_coverage_fp != 191474584 { return 0 - 1 }
    if family_coverage_fp != 850822389 { return 0 - 1 }
    if acceptance_receipt_fp != 338097733 { return 0 - 1 }
    if audit_receipt_fp != 589698637 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 22, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = margin_instance_fingerprint(1000000, 5, 70877465, 231786611)
    if instance_fp != 377517990 { return 1 }

    let certificate_fp = margin_certificate_fingerprint(
        instance_fp, 494960746, 1274, 1273, 1, 583927633827840, 1273, 15, 1)
    if certificate_fp != 250048780 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(25, instance_fp, certificate_fp, 1, 25)
    if entry_fp != 757892608 { return 3 }

    let manifest_fp = portfolio_v22_manifest_fingerprint(entry_fp)
    if manifest_fp != 420758164 { return 4 }

    let result_coverage_fp = portfolio_v22_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 191474584 { return 5 }

    let family_coverage_fp = portfolio_v22_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 850822389 { return 6 }

    if portfolio_v22_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        338097733, 589698637) != 356299987 { return 7 }

    if margin_instance_fingerprint(1000000, 5, 70877465, 231786612) != (0 - 1) { return 8 }
    if margin_certificate_fingerprint(
        instance_fp, 494960747, 1274, 1273, 1, 583927633827840, 1273, 15, 1) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(25, instance_fp, certificate_fp, 0, 25) != (0 - 1) { return 10 }
    if portfolio_v22_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 11 }
    if portfolio_v22_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 12 }
    if portfolio_v22_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 13 }
    if portfolio_v22_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        338097733, 589698638) != (0 - 1) { return 14 }

    return 0
}
