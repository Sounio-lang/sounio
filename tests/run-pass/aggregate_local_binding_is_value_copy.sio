//@ run-pass
//@ expect-stdout: AGGREGATE_LOCAL_COPY_OK
// Regression gate for #1475: binding an aggregate local to another local must
// VALUE-COPY, not alias. Before the fix Madaros lowered `var p2 = p1` to a bare
// IrCopy of the 64-bit HANDLE, so mutating the destination was observable
// through the source: `check` passed, the ELF ran, the answer was wrong, exit 0.
//
// lean_single always got this right (copy_struct_into_local_slot_a64, a flat
// nslots word copy); this file pins Madaros to the same semantics.
//
// SCOPE — this file pins the OUTER copy only, and runs on BOTH engines. When it
// was written the copy was flat, so a field holding an aggregate handle stayed
// shared. #1479 closed that WITHOUT the struct-layout representation change this
// note predicted, by following aggregate fields at the copy site; the nested-field
// assertions live in tests/run-pass/aggregate_nested_field_deep_copy.sio, which is
// gated to Madaros because the two engines still lay such a field out differently
// (handle here, inlined in lean_single).

struct P { x: i64, y: i64 }

struct F { a: f64, b: f64 }

fn mk() -> P with Mut, Div, Panic, Alloc {
    P { x: 1, y: 2 }
}

fn make_arr() -> [i64; 4] with Mut, Div, Panic, Alloc {
    var t: [i64; 4] = [1, 2, 3, 4]
    t
}

fn take(p: P) -> i64 with Mut, Div, Panic, Alloc {
    var q = p
    q.x = 99
    q.x + p.x
}

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    // 1. plain struct, var binding
    var p1 = P { x: 1, y: 2 }
    var p2 = p1
    p2.x = 99
    assert(p1.x == 1)
    assert(p2.x == 99)
    assert(p2.y == 2)

    // 2. `let` binding, then mutate the SOURCE — the binding own mutability says
    //    nothing about the source, so an alias would leak the later write.
    var p3 = P { x: 1, y: 2 }
    let p4 = p3
    p3.x = 99
    assert(p4.x == 1)

    // 3. struct returned from a call
    var s1 = mk()
    var s2 = s1
    s2.x = 77
    assert(s1.x == 1)
    assert(s2.x == 77)

    // 4. f64 fields — the copy must preserve the float payload bit-exactly AND
    //    keep the destination fields marked float.
    var f1 = F { a: 1.5, b: 2.5 }
    var f2 = f1
    f2.a = 99.0
    assert(f1.a < 2.0)
    assert(f2.a > 98.0)
    assert(f1.b > 2.0)

    // 5. nested struct: the OUTER slots are copied, so a scalar write to the copy
    //    is not visible through the source.
    var o1 = P { x: 3, y: 4 }
    var o2 = o1
    o2.y = 88
    assert(o1.y == 4)

    // 6. by-value struct param copied inside the callee
    var s3 = P { x: 1, y: 2 }
    let r = take(s3)
    assert(r == 100)
    assert(s3.x == 1)

    // 7. UNANNOTATED local bound from a fixed-array-returning call. The shape used
    //    to be unknown here (only the annotated form carried a length), so the
    //    copy below silently aliased.
    var a1 = make_arr()
    var a2 = a1
    a2[0] = 99
    assert(a1[0] == 1)
    assert(a2[0] == 99)

    // 8. previously-working array shapes must stay working
    var b1: [i64; 4] = [1, 2, 3, 4]
    var b2 = b1
    b2[0] = 99
    assert(b1[0] == 1)

    println("AGGREGATE_LOCAL_COPY_OK")
    return 0
}
