//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_renamed_header_binder
// A generic impl whose header binder is spelled differently from the target
// struct's own declared parameter: `impl<U> Cell<U>` on `struct Cell<T>`.
//
// The parser used to parse and then discard an impl header's `<...>` binder
// list (parse_impl_item). Downstream, generic-impl recognition fell back to
// guessing the parameter names from the target's own spelling instead: the
// checker (generic_impl_template_index) required the target's argument to
// spell the SAME name as the struct's own declared parameter, and the
// specializer (spec_impl_generic_struct_slot) required a single uppercase
// letter that is not a struct name. A renamed binder like `U` here satisfies
// neither guess, so the impl was treated as a concrete, unresolvable
// instantiation and any call to its methods failed to typecheck with E011,
// even though the program is valid.
//
// f64 is exercised (not just i64) so a fix that recognizes the impl as
// generic but corrupts substitution for a register-class-sensitive return
// type would still be caught here, not just one that silently reuses i64's
// representation by accident.

struct Cell<T> {
    v: T,
}

impl<U> Cell<U> {
    fn get(self: &Cell<U>) -> U {
        self.v
    }
    fn set(self: &!Cell<U>, x: U) with Mut {
        self.v = x
    }
}

fn main() -> i32 with IO, Mut {
    let ci = Cell { v: 42 }
    if ci.get() != 42 {
        print("FAIL i64 get\n")
        return 1
    }

    var cf = Cell { v: 1.25 }
    cf.set(3.5)
    let got = cf.get()
    if got < 3.49 || got > 3.51 {
        print("FAIL f64 get/set\n")
        return 1
    }

    print("PASS generic_impl_renamed_header_binder\n")
    return 0
}
