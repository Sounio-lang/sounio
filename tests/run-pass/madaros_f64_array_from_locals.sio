//@ run-pass
//@ requires: madaros
//@ expect-stdout: F64_ARRAY_FROM_LOCALS PASS
//
// An array literal built from f64 LOCALS (`[r0, r1, r2]`) is an f64 array.
// Madaros only recognised float literals/casts there, so `rates[k]` in
// arithmetic converted the f64 bits as an i64 (kinetics test_stoich_matrix:
// dc[0] = -9.18e18 instead of -0.2). lean_single computes -0.2.
fn dc_dt(c: &[f64; 4], ks: &[f64; 3]) -> [f64; 4] {
    let r0 = ks[0] * c[0]
    let r1 = ks[1] * c[1]
    let r2 = ks[2] * c[0] * c[1]
    let rates = [r0, r1, r2]
    [
        -1.0 * rates[0] - 1.0 * rates[2],
        rates[0] - rates[1] - rates[2],
        rates[1],
        rates[2]
    ]
}

fn main() -> i32 with IO, Mut, Panic {
    let c = [1.0, 0.5, 0.0, 0.0]
    let ks = [0.1, 0.05, 0.2]
    let dc = dc_dt(&c, &ks)
    let d0: f64 = dc[0]
    let d3: f64 = dc[3]
    if d0 > -0.2001 && d0 < -0.1999 && d3 > 0.0999 && d3 < 0.1001 {
        println("F64_ARRAY_FROM_LOCALS PASS")
        return 0
    }
    1
}
