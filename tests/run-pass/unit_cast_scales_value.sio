//@ run-pass
//@ requires: madaros
//@ expect-stdout: unit cast scale: PASS

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let a: m = 1.0
    let b: cm = 1.0
    let c = a + (b as m)
    let in_cm = (a as cm) as f64
    let in_km = (a as km) as f64
    let in_mm = (a as mm) as f64
    let dose: mg = 500.0
    let in_kg = (dose as kg) as f64
    print_f64(c)
    print("\n")
    if abs_f((c as f64) - 1.01) < 1.0e-9
        && abs_f(in_cm - 100.0) < 1.0e-9
        && abs_f(in_km - 0.001) < 1.0e-9
        && abs_f(in_mm - 1000.0) < 1.0e-9
        && abs_f(in_kg - 0.0005) < 1.0e-9 {
        print("unit cast scale: PASS\n")
        return 0
    }
    return 1
}
