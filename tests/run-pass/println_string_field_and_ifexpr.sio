//@ run-pass
//@ expect-stdout-contains: field=hello
//@ expect-stdout-contains: ifexpr=true
//@ expect-stdout-contains: int_field=42
//@ expect-stdout-contains: PASS
//
// Two shapes the string classifier could not see, and the controls that keep a
// fix from being a route-everything-to-print_int cheat.
//
// W1  `base.field` where the field is declared `string`. The classifier had no
//     ExprFieldAccess case at all, so the field arrived with scalar kind 0.
// W2  `if c { "a" } else { "b" }` bound to a local. The float classifier has had
//     this case forever; the string side had neither it nor a block-tail helper.
//
// NEGATIVE CONTROLS, both of which a careless fix breaks:
// N1  an i64 field must still print as a NUMBER (classifying every field as
//     string sends its VALUE to the char* printer and strlen dereferences it).
// N2  a plain string literal must still print as TEXT (routing kind 0 to
//     print_int passes W1/W2 while silently turning strings into numbers).
//
// Madaros-only: lean_single passes every line below unchanged.

struct Rec {
    msg: string,
    n: i64,
}

fn main() -> i64 with IO {
    let r = Rec { msg: "hello", n: 42 }

    print("field=")
    println(r.msg)

    let cond = true
    let lbl = if cond { "true" } else { "false" }
    print("ifexpr=")
    println(lbl)

    print("int_field=")
    println(r.n)

    println("PASS")
    0
}
