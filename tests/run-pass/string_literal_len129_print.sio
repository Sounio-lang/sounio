//@ run-pass
//@ description: 129-char literal must print all 129 — pre-fix Madaros silently printed 128
fn main() with IO {
    let s = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    println(s)
    println("LEN_EXPECT=129")
    println("PASS string_literal_len129_print")
}
