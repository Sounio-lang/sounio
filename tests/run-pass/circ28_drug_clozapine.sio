//@ run-pass
//@ timeout: 300
//@ expect-stdout-contains: CIRC28_DRUG_CLOZAPINE_PASS
//
// Clozapine (oral tablet) + N-desmethylclozapine (norclozapine) on the circ28 drug record, coupled by
// circ28_metab.sio (stdlib/darwin_pbpk/circ28_drug_clozapine.sio; parameter table, pooled study tables and
// sources with access level in its header).
//
// FITTED, hence NOT validations (one observable per fitted parameter):
//   P Kp scalar            -> V_ss 116.8 L (1.6 L/kg x 73 kg; Cheng 1988, intravenous, n 10, abstract)
//   P total hepatic clint  -> intravenous CL 13.05 L/h plasma (250 mL/min blood x B:P 0.87; Cheng 1988)
//   P split phi (clform)   -> pooled steady-state norclozapine:clozapine trough ratio (TDM, k 5)
//   P ka                   -> pooled steady-state Tmax, 100 mg b.i.d. (k 5)
//   CYP1A2 share f1A2      -> pooled clozapine exposure ratio with fluvoxamine (k 6)
//   M total CL             -> pooled norclozapine half-life (k 2)
//   NOT fitted: M Kp scalar = 1 (a declared prediction: no human volume of norclozapine; ACP-104 was dosed to
//   humans but no pharmacokinetic number was published), tissue permeability scalar (default), fa = 1.
//   The pool of intravenous studies has k = 1 (Cheng 1988): Choc 1987 and Choc 1990 are oral studies.
//
// VALIDATIONS (no number below enters a fit). Criteria fixed BEFORE the runs: |z| <= 2 where a between-subject
// or between-study SD exists (a label range is turned into SD = range/4 and said so); a factor 1.5 otherwise
// (a factor 2 for the urinary row, whose observation is derived from two abstracts).
//
// PREDICTIONS WRITTEN BEFORE ANY COUPLED RUN. What had been run when they were written: ONE scratch program with
// closed forms only (Qh 99.45 L/h, V_blood 5.30 L, Rodgers-Rowland V_ss with scalar 1: clozapine 258.0 L,
// norclozapine 182.2 L). Everything else is hand arithmetic:
//   kpsc 0.4428; CL_hep 13.01, bp Qh 86.52 -> Eh 0.150; tot fu = 15.43 -> tot 280.6 L/h; CL/F 15.36 L/h.
//   INPUT CONSISTENCY (lesson 2): V_ss ln2/CL = 6.20 h < terminal half-life 10.3 h (Cheng) and 8 h (label): the
//   inputs leave room for a distribution phase.
//   fits:  phi 0.50 (0.40-0.62); CL_M 10.5 L/h (9.4-12); ka 0.6 /h (0.35-1.0); f1A2 0.76 (0.70-0.82)
//   V1   F = fa (1 - Eh) = 0.85                         obs 0.27 (Cheng 1988)                 FAIL (fold 3.1)
//   V1b  same                                           obs upper quoted value 0.50           FAIL (fold 1.7)
//   V2   intravenous terminal t1/2 7.5 h (6.5-9.0)      obs 10.3 h (Cheng)                    PASS at 1.5 (borderline)
//   V3   oral single-dose t1/2 7.5 h (6.5-9.0)          obs 8 h, range 4-12 (label)           PASS
//   V3b  same                                           obs 13.7 +/- 9.9 h (Lin 1994)         PASS
//   V4   steady-state t1/2 = single-dose (linear model) obs 12 h (label)                      FAIL (fold 0.63; fails if < 8 h)
//   V4b  same                                           obs 15.8 h (Choc 1987)                FAIL
//   V5   single 100 mg AUCinf 6510 ng h/mL              obs 2390 +/- 1406 (Lin 1994, n 14)    FAIL (z +2.9)
//   V5b  CL/F 15.4 L/h                                  obs 55.4 +/- 29.7 (Lin 1994)          PASS (z -1.35, wide SD)
//   V5c  single-dose Tmax 2.5 h (2.3-2.9)               obs 3 h (Cheng)                       PASS
//   V6   steady-state AUC0-12 6510                      pooled 3715, between-study SD 787     FAIL (z +3.6)
//   V7   steady-state Cmax 680 ng/mL (600-760)          pooled 445, SD 104                    FAIL (z +2.3, borderline)
//   V8   steady-state trough 390 ng/mL (330-450)        obs 122, range 41-343 (label)         FAIL (z +3.6)
//   V9   trough per daily dose 1.95 (1.65-2.25) ng/mL per mg/day   UK TDM 1.017 [0.665, 1.542] FAIL
//   V10  single-dose AUC ratio norclozapine/clozapine 0.65 (0.58-0.72)   obs 0.314 (Lin 1994)  FAIL (fold 2.1)
//   V11  norclozapine in urine 8.4 % of the dose (6-11), molar           obs 3.5 % (Schaber 14 % x 1/4, Jann 1993)
//                                                                        FAIL at 2 (fold 2.4); below 14 %: PASS
//   V12  f1A2 0.76                                      "approximately 70 %" (Wagner 2020 introduction, secondary)  PASS at 1.25
//   V13  non-smoker/smoker ratio 1 + 0.76 x 0.55 = 1.42 (1.38-1.46)      pooled 1.37, between-study SD 0.22   PASS
//   V14  fluvoxamine steady-state TROUGH ratio 3.9 (3.5-4.3)             obs 3.0 (Wetzel; inside the fitted pool:
//                                                                        a consistency row)   PASS at 1.5
//   V15  fluvoxamine t1/2 ratio 2.7 (2.4-3.0)           obs 50/17 = 2.94 (Wetzel)             PASS
//   V15b same                                           obs 4.7 (Wang 2004, +370 %)           FAIL (fold 0.57)
//   V16  norclozapine trough ratio under fluvoxamine 1.1 (1.0-1.3)       obs about 3 (Wetzel)  FAIL
//   V16b same (AUC ratio 1.00)                          obs 0.91 (Chang 1999, -9 %)           PASS
//   V17  norclozapine:clozapine trough ratio, smokers/non-smokers 1.00 (0.93-1.03)   obs no difference (Wagner 2020)  PASS
//   V18  dose linearity 37.5/75/150 mg b.i.d. exact (structural)        obs linear (Choc 1987) PASS by construction
//   V19  dose-normalised AUC multiple/single 1.00       obs 1.27 (Choc 1990)                  PASS at 1.5, but the linear
//                                                       model cannot produce the 27 % (nor the longer half-life, V4)
//   V20  norclozapine t1/2 after oral clozapine = the fitted half-life (consistency, 5 %)
//   ONE CAUSE is expected behind V1, V5, V6, V7, V8, V9: the hepatic-only first pass gives F 0.85 where the
//   steady-state data need F = CL x AUC/dose = 13.05 x 3715/1e5 = 0.48 and Cheng's own patients had 0.27.
//   DIAGNOSTIC D1 (not a fit, not a validation): with the lumped presystemic availability 0.60 that the Simcyp
//   model of Lee 2021 obtained by optimising fa, every concentration scales by 0.60 exactly:
//   AUC 3906 (z +0.2), Cmax about 410, trough about 235 (z +1.5).
//
// RESULTS (first complete run, local Madaros; the predictions above were not edited afterwards).
//   DISCLOSURE: the three offline fits (CL_M, ka, phi) are kernel runs; they were made after the predictions were
//   written and printed only the fitted numbers. The test body was then run once and the rows below recorded.
//   fits:  CL_M 9.73 L/h (hit); ka 0.462 /h (hit); f1A2 0.768 (hit); phi 0.351 (MISS: predicted 0.40-0.62)
//   HITS (verdict as predicted): V1 0.850 fail; V1b fail; V3 6.77 h pass; V3b pass; V4 fold 0.56 fail; V4b fail;
//     V5 6511, z +2.93 fail; V5b z -1.35 pass; V5c 2.89 h pass; V6 z +3.53 fail; V7 718 ng/mL, z +2.60 fail;
//     V8 318 ng/mL, z +2.60 fail (value below my range 330-450); V9 1.59, outside [0.665, 1.542], fail (value below
//     my range 1.65-2.25); V10 0.479, fold 1.52 fail (value below my range 0.58-0.72); V11b pass; V12 fold 1.10 pass;
//     V13 1.416, z +0.22 pass; V15 2.76 pass; V15b fail; V16 1.05 fail; V16b 0.99 pass; V19 pass; V20 pass.
//   MISSES (kept, never erased):
//     V2  IV t1/2 6.77 h: inside my range but fold 0.658 against 10.3 h fails the factor 1.5 by 1.4 %. Predicted PASS.
//     V11 urinary norclozapine 6.3 % of the dose, fold 1.81: PASS. Predicted FAIL (8.4 %): phi was over-estimated.
//     V14 fluvoxamine trough ratio 4.67, fold 1.56: FAIL. Predicted PASS (3.9): the trough rises more than the AUC
//         (ratio 3.28) because the half-life is 2.8 times longer; the pool mixes trough and AUC ratios.
//     V17 norclozapine:clozapine ratio smokers/non-smokers 1.65: FAIL against "no difference". Predicted 1.00, an
//         error of reasoning (the mass of norclozapine formed is unchanged, clozapine falls 1.69-fold). Cause in the
//         model: norclozapine's own clearance is not induced, while Li 2012 (+54 %) and Ng 2009 (+29 %) say it is.
//         Row V17b (Wetzel 1998: ratio 20-50 % higher in smokers) was ADDED AFTER the run and passes (fold 1.22).
//   D1 measured: AUC 3906 (z +0.24), Cmax 431 (z -0.13), trough 191 (z +0.91).
//   D2 (added after V2 failed): the default tissue permeability does not carry the half-life (x0.3: +1 %, x0.1: +4 %);
//   10.3 h would need ps about 0.009 x default, which makes hepatic uptake rate-limiting: not fitted.
//
// Compiler workarounds kept (lessons 7): records are built by steps written in main; big structs live in
// the run function only; record arrays go to functions by value exactly as in the risperidone module, and a
// guard row compares the same quantity computed two ways (closed-form CL/F against the kernel AUC).

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_metab::*
use darwin_pbpk::circ28_drug_clozapine::*
use math::pure::{ln}

fn ct_fold(tag: string, pred: f64, obs: f64, fold: f64, expect_pass: i32) -> i32 with IO, Mut, Div, Panic {
    let r = pred / obs
    var ok: i32 = 0
    if r <= fold && r >= 1.0 / fold { ok = 1 }
    print("  "); print(tag); print("  pred "); print(pred); print("  obs "); print(obs); print("  fold "); print(r)
    if ok == 1 { println("  [pass]") } else { println("  [fail]") }
    if ok != expect_pass {
        println("  [FAIL] outcome differs from the recorded one")
        return 1
    }
    return 0
}

fn ct_z(tag: string, pred: f64, obs: f64, sd: f64, expect_pass: i32) -> i32 with IO, Mut, Div, Panic {
    let z = (pred - obs) / sd
    var ok: i32 = 0
    if z <= 2.0 && z >= 0.0 - 2.0 { ok = 1 }
    print("  "); print(tag); print("  pred "); print(pred); print("  obs "); print(obs); print("  SD "); print(sd); print("  z "); print(z)
    if ok == 1 { println("  [pass]") } else { println("  [fail]") }
    if ok != expect_pass {
        println("  [FAIL] outcome differs from the recorded one")
        return 1
    }
    return 0
}

fn ct_band(tag: string, v: f64, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    if v >= lo && v <= hi { return 0 }
    print("  [FAIL] "); print(tag); print(" = "); print(v); print(" outside ["); print(lo); print(", "); print(hi); println("]")
    return 1
}

fn ct_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    d = d / want
    print("  "); print(tag); print("  got "); print(got); print("  want "); print(want); print("  rel "); println(d)
    if d > tol {
        println("  [FAIL] above tolerance")
        return 1
    }
    return 0
}

fn ct_pool_row(tag: string, which: i32) with IO, Mut, Div, Panic {
    var o: [f64; 12] = [0.0; 12]
    clz_pool_of(which, &!o)
    print("  "); print(tag); print("  k "); print(o[7]); print("  N "); print(o[1]); print("  n-weighted mean "); print(o[0])
    print("  unweighted "); print(o[8]); print("  between-study SD "); print(o[4]); print("  u "); println(o[6])
}

fn ct_pools() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("P pooled observables (n-weighted mean; u = max(pooled SE, between-study SD/sqrt k))")
    ct_pool_row("(0) fluvoxamine exposure ratio [FITTED: f1A2]     ", 0)
    ct_pool_row("(1) non-smoker/smoker C/D ratio [validation]      ", 1)
    ct_pool_row("(2) norclozapine:clozapine trough [FITTED: phi]   ", 2)
    ct_pool_row("(3) norclozapine half-life, h [FITTED: CL_M]      ", 3)
    ct_pool_row("(4) steady-state Tmax, h [FITTED: ka]             ", 4)
    ct_pool_row("(5) steady-state AUC0-12, ng h/mL [validation]    ", 5)
    ct_pool_row("(6) steady-state Cmax, ng/mL [validation]         ", 6)
    ct_pool_row("(7) creatinine clearance, mL/min                  ", 7)
    fails = fails + ct_band("pool 0 mean", clz_pool_mean(0), 3.27, 3.29)
    fails = fails + ct_band("pool 1 mean", clz_pool_mean(1), 1.36, 1.38)
    fails = fails + ct_band("pool 2 mean", clz_pool_mean(2), 0.74, 0.76)
    fails = fails + ct_band("pool 3 mean", clz_pool_mean(3), 13.4, 13.6)
    fails = fails + ct_band("pool 4 mean", clz_pool_mean(4), 2.22, 2.24)
    fails = fails + ct_band("pool 5 mean", clz_pool_mean(5), 3700.0, 3730.0)
    fails = fails + ct_band("pool 6 mean", clz_pool_mean(6), 440.0, 450.0)
    fails = fails + ct_band("pool 7 mean", clz_pool_mean(7), 110.0, 113.0)
    print("  residual CYP1A2 activity under fluvoxamine r = 1/(1 + Iu/Ki) = "); print(clz_fvx_r()); print("  (Iu "); print(clz_fvx_iu_nm()); println(" nmol/L)")
    return fails
}

fn ct_show(tag: string, r: &[f64; 32]) with IO, Mut, Div, Panic {
    print(tag); print(": P Cmax "); print((*r)[0]); print(" Tmax "); print((*r)[1]); print(" AUCinf "); print((*r)[2]); print(" t1/2 "); println((*r)[3])
    print("      M Cmax "); print((*r)[4]); print(" Tmax "); print((*r)[5]); print(" AUCinf "); print((*r)[6]); print(" t1/2 "); println((*r)[7])
    print("      steady state (same dose every tau): P Cmax "); print((*r)[15]); print(" Tmax "); print((*r)[16]); print(" trough "); print((*r)[17])
    print("  M Cmax "); print((*r)[18]); print(" trough "); println((*r)[20])
    print("      balance P "); print((*r)[9]); print(" M "); print((*r)[10]); print(" grid/fit ok "); print((*r)[11]); print("/"); print((*r)[12]); print("/"); println((*r)[13])
}

fn ct_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    return cd_sqrt(x)
}

// One coupled oral or intravenous run of the record with the hepatic intrinsic clearances scaled by s.
fn ct_run(dp: &Circ28Drug, dm: &Circ28Drug, route: i32, dose: f64, s: f64, res: &![f64; 32]) with Mut, Div, Panic, Epistemic {
    let thp0 = circ28_drug_theta(dp)
    let thp = clz_scale_hep(thp0, s)
    let thm = circ28_drug_theta(dm)
    clz_run_th(thp, thm, route, dose, 0.1, 12.0, 24.0, 48.0, 96.0, 168.0, res)
}

fn ct_theta_p(dp: &Circ28Drug) -> [f64; 18] with Mut, Div, Panic, Epistemic {
    return circ28_drug_theta(dp)
}

fn ct_f1a2(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_f1a2(circ28_drug_theta(dp), clz_obs_fvx(), clz_fvx_r())
}

fn ct_clf(dp: &Circ28Drug, s: f64) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_cl_over_f(clz_scale_hep(circ28_drug_theta(dp), s))
}

fn ct_m_t12(dm: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_m_t12(circ28_drug_theta(dm))
}

// Steady-state Tmax at a given ka (for the slope used by the budget and the ka re-check).
fn ct_tmax_ss(dp: &Circ28Drug, dm: &Circ28Drug, ka: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var thp = circ28_drug_theta(dp)
    thp[CD_KA] = ka
    let thm = circ28_drug_theta(dm)
    var r: [f64; 32] = [0.0; 32]
    clz_run_th(thp, thm, 1, 100.0, 0.0, 12.0, 24.0, 48.0, 96.0, 168.0, &!r)
    return r[16]
}

// Guard: the norclozapine trough is linear in phi at fixed total hepatic clearance, and the clozapine curve
// does not depend on phi or on the metabolite record.
fn ct_guard(dp: &Circ28Drug, dm: &Circ28Drug, base: &[f64; 32]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var thp = circ28_drug_theta(dp)
    let tot = thp[CD_CLINT] + thp[CD_CLFORM]
    thp[CD_CLFORM] = 0.5 * thp[CD_CLFORM]
    thp[CD_CLINT] = tot - thp[CD_CLFORM]
    var thm = circ28_drug_theta(dm)
    thm[CD_FU] = 1.1 * thm[CD_FU]
    var r: [f64; 32] = [0.0; 32]
    clz_run_th(thp, thm, 1, 100.0, 0.0, 12.0, 24.0, 48.0, 96.0, 168.0, &!r)
    println("G guard rows (same quantity two ways)")
    fails = fails + ct_rel("clozapine trough unchanged by phi/2 and fu_M x 1.1", r[17], (*base)[17], 1.0e-9)
    fails = fails + ct_rel("mass given to M halves with phi/2                 ", r[14], 0.5 * (*base)[14], 1.0e-9)
    return fails
}

fn ct_budget(dp: &Circ28Drug, dm: &Circ28Drug, slope: f64, lo_rel: f64, hi_rel: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let b = clz_budget(dp, dm, slope)
    let t = clz_obs_ncratio()
    let ut = clz_u_ncratio()
    let u_p = ct_sqrt(b.var_trough)
    let sum = b.trough * (1.0 + t)
    let var_sum = (1.0 + t) * (1.0 + t) * b.var_trough + b.trough * b.trough * ut * ut
    print("S6 uncertainty budget with refit, steady-state trough, 100 mg b.i.d.: "); print(b.runs); println(" coupled runs, forward differences")
    print("  clozapine trough "); print(1000.0 * b.trough); print(" ng/mL  u "); print(1000.0 * u_p); print("  rel "); println(u_p / b.trough)
    print("  clozapine + norclozapine trough "); print(1000.0 * sum); print(" ng/mL  u "); print(1000.0 * ct_sqrt(var_sum)); print("  rel "); println(ct_sqrt(var_sum) / sum)
    println("  input          u(input)      share of var(clozapine trough) %    share of var(sum) %")
    var i: i32 = 0
    while i < 9 {
        print("  "); print(clz_input_name(i)); print("   "); print(b.u[i]); print("   "); print(100.0 * b.contrib[i] / b.var_trough)
        print("   "); println(100.0 * (1.0 + t) * (1.0 + t) * b.contrib[i] / var_sum)
        i = i + 1
    }
    print("  N:C ratio obs    "); print(ut); print("   0   "); println(100.0 * b.trough * b.trough * ut * ut / var_sum)
    fails = fails + ct_band("relative u of the clozapine trough", u_p / b.trough, lo_rel, hi_rel)
    return fails
}

fn ct_cl(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_cl(circ28_drug_theta(dp))
}

fn ct_eh(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_eh(circ28_drug_theta(dp))
}

fn ct_foral(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_f_oral(circ28_drug_theta(dp))
}

fn ct_pool_unw(which: i32) -> f64 with Mut, Div, Panic {
    var o: [f64; 12] = [0.0; 12]
    clz_pool_of(which, &!o)
    return o[8]
}

fn ct_s1(dp: &Circ28Drug, dm: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    // ---- input consistency (lesson 2), before any run
    let t_cons = 0.6931471805599453 * clz_obs_vss() / clz_obs_cl()
    print("C input consistency: V_ss ln2 / CL = "); print(t_cons); print(" h against the terminal half-life "); print(clz_obs_t12_iv()); println(" h (Cheng 1988) and 8 h (label, single dose)")
    fails = fails + ct_band("V_ss ln2/CL (h)", t_cons, 6.1, 6.3)
    fails = fails + ct_band("terminal / (V_ss ln2/CL)", clz_obs_t12_iv() / t_cons, 1.3, 2.0)
    // ---- S1: the fits reproduce their own observables
    println("S1 the fits reproduce their observables (NOT validations)")
    let pp = circ28_drug_params(dp)
    let pm = circ28_drug_params(dm)
    fails = fails + ct_rel("V_ss P (L)                 ", circ28_vss_plasma(pp), clz_obs_vss(), 1.0e-9)
    fails = fails + ct_rel("CL P total (L/h)           ", ct_cl(dp), clz_obs_cl(), 1.0e-9)
    fails = fails + ct_rel("CL M total (L/h)           ", circ28_splanchnic_clearance(pm) * pm.bp + circ28_drug_value(dm, CD_CLREN), clz_m_cl_fit(), 1.0e-9)
    fails = fails + ct_rel("M t1/2, M alone IV (h)     ", ct_m_t12(dm), clz_obs_m_t12(), 1.0e-4)
    let f1a2 = ct_f1a2(dp)
    let s_fvx = clz_scale_fvx(f1a2, clz_fvx_r())
    let s_smk = clz_scale_smoke(f1a2, clz_smoke_fold())
    fails = fails + ct_rel("fluvoxamine CL/F ratio     ", ct_clf(dp, 1.0) / ct_clf(dp, s_fvx), clz_obs_fvx(), 1.0e-6)
    print("  V_ss M (Rodgers-Rowland, scalar 1: a PREDICTION) = "); print(circ28_vss_plasma(pm)); println(" L")
    let tot = circ28_drug_value(dp, CD_CLINT) + circ28_drug_value(dp, CD_CLFORM)
    print("  kpsc "); print(circ28_drug_value(dp, CD_KPSC)); print("  tot "); print(tot); print("  phi "); print(circ28_drug_value(dp, CD_CLFORM) / tot)
    print("  Eh "); print(ct_eh(dp)); print("  f1A2 "); print(f1a2); print("  scale fluvoxamine "); print(s_fvx); print("  scale smoker "); println(s_smk)
    return fails
}

// D2: intravenous terminal half-life (24-48 h) with the tissue permeability scalar set to ps, the Kp scalar and
// the hepatic clearance refitted (V_ss and CL unchanged). A diagnosis, not a fit.
fn ct_t12_ps(dp: &Circ28Drug, ps: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var t = circ28_drug_theta(dp)
    t[CD_PSSC] = ps
    let clren = t[CD_CLREN]
    let phi = t[CD_CLFORM] / (t[CD_CLFORM] + t[CD_CLINT])
    let t2 = clz_fit_p(t, clz_obs_vss(), clz_obs_cl(), clren, phi)
    let r = circ28_run_theta(t2, circ28_dose_iv(100.0, 0.1, 0.1, 12.0, 1.0, 96.0, 24.0, 48.0))
    return r.thalf
}

fn ct_d2(dp: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let a = ct_t12_ps(dp, 1.0)
    let b = ct_t12_ps(dp, 0.3)
    let c = ct_t12_ps(dp, 0.1)
    let d = ct_t12_ps(dp, 0.01)
    println("D2 diagnosis of the half-life (V2, V4): IV terminal t1/2 against the tissue permeability scalar (default 1)")
    print("  ps x1 "); print(a); print(" h   x0.3 "); print(b); print(" h   x0.1 "); print(c); print(" h   x0.01 "); print(d); println(" h   (observed 10.3 h)")
    println("  10.3 h needs ps about 0.009 x default, where ps_liver (18 L/h) is as small as the hepatic clearance term (15.3 L/h): not fitted")
    fails = fails + ct_band("D2 ps x0.3 moves t1/2 by < 3 %", b / a, 1.0, 1.03)
    fails = fails + ct_band("D2 ps x0.1 moves t1/2 by < 8 %", c / a, 1.0, 1.08)
    fails = fails + ct_band("D2 ps x0.01 (h)", d, 9.0, 10.3)
    return fails
}

fn ct_runs(dp: &Circ28Drug, dm: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let f1a2 = ct_f1a2(dp)
    let s_fvx = clz_scale_fvx(f1a2, clz_fvx_r())
    let s_smk = clz_scale_smoke(f1a2, clz_smoke_fold())
    // ---- S2: intravenous
    var iv: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 0, 100.0, 1.0, &!iv)
    ct_show("S2 IV 100 mg over 0.1 h", &iv)
    fails = fails + ct_band("IV balance P", iv[9], 0.0, 1.0e-9)
    fails = fails + ct_band("IV balance M", iv[10], 0.0, 1.0e-9)
    fails = fails + ct_rel("guard: IV AUCinf x CL = dose (kernel vs closed form)", iv[2] * clz_obs_cl(), 100.0, 5.0e-3)
    // ---- S3: oral, single 100 mg and 100 mg b.i.d. by superposition
    var po: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 1, 100.0, 1.0, &!po)
    ct_show("S3 oral 100 mg", &po)
    fails = fails + ct_band("oral balance P", po[9], 0.0, 1.0e-9)
    fails = fails + ct_band("oral balance M", po[10], 0.0, 1.0e-9)
    fails = fails + ct_rel("guard: oral AUCinf x CL/F = dose                   ", po[2] * ct_clf(dp, 1.0), 100.0, 5.0e-3)
    fails = fails + ct_rel("steady-state Tmax = pooled 2.228 h [fitted, ka]    ", po[16], clz_obs_tmax_ss(), 2.0e-3)
    fails = fails + ct_rel("steady-state N:C trough ratio = pooled [fitted, phi]", po[20] / po[17], clz_obs_ncratio(), 2.0e-3)
    fails = fails + ct_guard(dp, dm, &po)
    println("V validation, predicted vs observed (criteria and expectations fixed before the runs: header)")
    let f_cf = ct_foral(dp)
    fails = fails + ct_fold("V1   F vs 0.27 (Cheng 1988)                      ", f_cf, clz_obs_f(), 1.5, 0)
    fails = fails + ct_fold("V1b  F vs 0.50 (upper quoted value)              ", f_cf, 0.50, 1.5, 0)
    fails = fails + ct_fold("V2   IV terminal t1/2 (h) vs 10.3 (Cheng)        ", iv[3], clz_obs_t12_iv(), 1.5, 0)
    // V2 was pre-registered PASS (7.5 h, range 6.5-9.0): measured 6.77 h is inside the range, fold 0.658 misses 1/1.5 by 1.4 %. MY MISS.
    fails = fails + ct_band("IV t1/2 band", iv[3], 6.6, 6.95)
    fails = fails + ct_z("V3   oral t1/2 (h) vs label 8, SD = range/4      ", po[3], 8.0, 2.0, 1)
    fails = fails + ct_z("V3b  oral t1/2 (h) vs Lin 1994 13.7 +/- 9.9     ", po[3], 13.7, 9.9, 1)
    fails = fails + ct_fold("V4   steady-state t1/2 (h) vs label 12           ", po[3], 12.0, 1.5, 0)
    fails = fails + ct_fold("V4b  steady-state t1/2 (h) vs Choc 1987 15.8     ", po[3], 15.8, 1.5, 0)
    fails = fails + ct_z("V5   single 100 mg AUCinf (ng h/mL) vs Lin 1994  ", 1000.0 * po[2], 2389.9, 1406.0, 0)
    fails = fails + ct_z("V5b  CL/F (L/h) vs Lin 1994 55.4 +/- 29.7       ", 100.0 / po[2], 55.4, 29.7, 1)
    fails = fails + ct_fold("V5c  single-dose Tmax (h) vs 3 (Cheng)           ", po[1], 3.0, 1.5, 1)
    fails = fails + ct_z("V6   steady-state AUC0-12 (ng h/mL) vs pool      ", 1000.0 * po[2], clz_pool_mean(5), clz_pool_sb(5), 0)
    fails = fails + ct_z("V7   steady-state Cmax (ng/mL) vs pool           ", 1000.0 * po[15], clz_pool_mean(6), clz_pool_sb(6), 0)
    fails = fails + ct_z("V8   steady-state trough (ng/mL) vs label 122    ", 1000.0 * po[17], 122.0, 75.5, 0)
    let cd = 1000.0 * po[17] / 200.0
    print("  V9   trough per daily dose (ng/mL per mg/day)  pred "); print(cd); println("  obs 1.017 [0.665, 1.542] (UK TDM, non-smoking man)")
    var v9: i32 = 0
    if cd >= 0.665 && cd <= 1.542 { v9 = 1 }
    if v9 != 0 { fails = fails + 1; println("  [FAIL] V9 outcome differs from the recorded one") }
    fails = fails + ct_fold("V10  single-dose AUC ratio N/C vs 0.314 (Lin)    ", po[6] / po[2], 751.1 / 2389.9, 1.5, 0)
    // urinary norclozapine, molar fraction of the oral dose; the run stops at 168 h, the rest is the tail
    let fe_m = (po[21] / (clz_m_mw() / clz_p_mw())) / 100.0
    fails = fails + ct_fold("V11  norclozapine in urine (% dose) vs 3.5       ", 100.0 * fe_m, 3.5, 2.0, 1)
    // V11 was pre-registered FAIL (8.4 %): measured 6.3 %, fold 1.81, PASS. MY MISS (phi came out 0.35, not 0.50).
    fails = fails + ct_band("urinary norclozapine band (% dose)", 100.0 * fe_m, 6.0, 6.7)
    fails = fails + ct_band("V11b norclozapine in urine below the 14 % of Schaber 1998", 100.0 * fe_m, 0.0, 14.0)
    fails = fails + ct_fold("V12  f1A2 vs about 0.70 (secondary)              ", f1a2, 0.70, 1.25, 1)
    // ---- S4: CYP1A2 scenarios
    let r_smk = ct_clf(dp, s_smk) / ct_clf(dp, 1.0)
    fails = fails + ct_z("V13  non-smoker/smoker C/D ratio vs pool         ", r_smk, clz_pool_mean(1), clz_pool_sb(1), 1)
    print("       (if the record is taken as the SMOKER instead: "); print(ct_clf(dp, 1.0) / ct_clf(dp, 1.0 - f1a2 * (1.0 - 1.0 / clz_smoke_fold()))); println(")")
    print("       share that the smoking pool alone would need: n-weighted "); print((clz_pool_mean(1) - 1.0) / (clz_smoke_fold() - 1.0))
    print(", unweighted "); println((ct_pool_unw(1) - 1.0) / (clz_smoke_fold() - 1.0))
    var fv: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 1, 100.0, s_fvx, &!fv)
    ct_show("S4a oral 100 mg with fluvoxamine", &fv)
    fails = fails + ct_fold("V14  fluvoxamine trough ratio vs 3.0 (Wetzel; in the pool)", fv[17] / po[17], 3.0, 1.5, 0)
    // V14 was pre-registered PASS (3.9, range 3.5-4.3): measured 4.67, fold 1.56, FAIL. MY MISS: the trough rises more than the AUC.
    fails = fails + ct_band("fluvoxamine trough ratio band", fv[17] / po[17], 4.5, 4.85)
    fails = fails + ct_band("fluvoxamine t1/2 ratio band", fv[3] / po[3], 2.65, 2.9)
    fails = fails + ct_fold("V15  fluvoxamine t1/2 ratio vs 2.94 (Wetzel)     ", fv[3] / po[3], 50.0 / 17.0, 1.5, 1)
    fails = fails + ct_fold("V15b fluvoxamine t1/2 ratio vs 4.7 (Wang)        ", fv[3] / po[3], 4.7, 1.5, 0)
    fails = fails + ct_fold("V16  norclozapine trough ratio vs 3 (Wetzel)     ", fv[20] / po[20], 3.0, 1.5, 0)
    fails = fails + ct_fold("V16b norclozapine AUC ratio vs 0.91 (Chang)      ", fv[6] / po[6], 0.91, 1.5, 1)
    var sk: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 1, 100.0, s_smk, &!sk)
    ct_show("S4b oral 100 mg, smoker", &sk)
    fails = fails + ct_fold("V17  N:C trough ratio smoker/non-smoker vs 1.0   ", (sk[20] / sk[17]) / (po[20] / po[17]), 1.0, 1.25, 0)
    // V17 was pre-registered PASS (1.00): measured 1.65, FAIL. MY MISS, an error of reasoning: with the same split in every enzyme the
    // MASS of norclozapine formed is unchanged, so its concentration is unchanged while clozapine falls 1.69-fold.
    fails = fails + ct_band("N:C smoker/non-smoker band", (sk[20] / sk[17]) / (po[20] / po[17]), 1.6, 1.7)
    // V17b ADDED AFTER THE RUN (disclosed): Wetzel 1998, N-demethylation ratios 20-50 % higher in smokers (mid 1.35)
    fails = fails + ct_fold("V17b same vs 1.35 (Wetzel 1998; row added after the run)", (sk[20] / sk[17]) / (po[20] / po[17]), 1.35, 1.25, 1)
    print("       trough non-smoker/smoker "); println(po[17] / sk[17])
    println("  V18  dose linearity: the kernel is linear in the dose (37.5, 75, 150 mg b.i.d. scale exactly); Choc 1987 observed linearity")
    fails = fails + ct_fold("V19  dose-normalised AUC multiple/single vs 1.27 ", 1.0, 1.27, 1.5, 1)
    fails = fails + ct_rel("V20  M t1/2 after oral clozapine = fitted         ", po[7], clz_obs_m_t12(), 0.05)
    // ---- S5: diagnostic D1 (not a fit): lumped presystemic availability 0.60 (Lee 2021, optimised fa)
    println("D1 diagnosis (not a validation): every concentration x 0.60 (Lee 2021 optimised fa; linear kernel)")
    print("  AUC0-12 "); print(600.0 * po[2]); print(" (z "); print((600.0 * po[2] - clz_pool_mean(5)) / clz_pool_sb(5))
    print(")  Cmax "); print(600.0 * po[15]); print(" (z "); print((600.0 * po[15] - clz_pool_mean(6)) / clz_pool_sb(6))
    print(")  trough "); print(600.0 * po[17]); print(" (z "); print((600.0 * po[17] - 122.0) / 75.5); println(")")
    print("  presystemic availability that each observation needs: Cheng F 0.27 -> "); print(clz_obs_f() / f_cf)
    print(";  pooled steady-state AUC -> "); println(clz_pool_mean(5) / (1000.0 * po[2]))
    fails = fails + ct_d2(dp)
    // bands around the measured outcomes of the failing rows (they are asserted as measured, not tuned)
    fails = fails + ct_band("F band", f_cf, 0.84, 0.86)
    fails = fails + ct_band("steady-state trough band (ng/mL)", 1000.0 * po[17], 300.0, 335.0)
    fails = fails + ct_band("steady-state Cmax band (ng/mL)", 1000.0 * po[15], 700.0, 735.0)
    fails = fails + ct_band("single-dose N:C AUC ratio band", po[6] / po[2], 0.46, 0.50)
    fails = fails + ct_band("f1A2 band (hand 0.76)", f1a2, 0.75, 0.78)
    fails = fails + ct_band("non-smoker/smoker band (hand 1.42)", r_smk, 1.40, 1.43)
    // ---- S6: budget
    let k0 = clz_ka_fit()
    let slope = (ct_tmax_ss(dp, dm, 1.05 * k0) - ct_tmax_ss(dp, dm, 0.95 * k0)) / (0.1 * k0)
    print("  d Tmax_ss / d ka = "); println(slope)
    fails = fails + ct_budget(dp, dm, slope, 0.30, 0.38)
    return fails
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var dm = circ28_drug_new()
    var dp = circ28_drug_new()
    // the steps of the record construction are written out in main (lean_single mis-forwards chained references)
    clz_measured_m(&!dm)
    clz_fit_record_m(&!dm)
    clz_measured_p(&!dp)
    clz_fit_record_p(&!dp)
    println("S0 record: P then M (value, status)")
    var i: i32 = 0
    while i < 18 {
        print("  P "); print(i); print(" "); print(circ28_drug_value(&dp, i)); print("  status "); print(dp.status[i])
        print("   |  M "); print(circ28_drug_value(&dm, i)); print("  status "); println(dm.status[i])
        i = i + 1
    }
    fails = fails + ct_s1(&dp, &dm)
    fails = fails + ct_runs(&dp, &dm)
    // the pooled tables are printed last: Madaros (local build) segfaults when ct_pools runs before the records are built in main
    fails = fails + ct_pools()
    if fails == 0 { println("CIRC28_DRUG_CLOZAPINE_PASS") } else { print("FAILS "); println(fails) }
}
