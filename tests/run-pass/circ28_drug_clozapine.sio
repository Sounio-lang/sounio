//@ run-pass
//@ timeout: 300
//@ expect-stdout-contains: CIRC28_DRUG_CLOZAPINE_PASS
//
// Clozapine (oral tablet) + N-desmethylclozapine (norclozapine) on the circ28 drug record, coupled by
// circ28_metab.sio (stdlib/darwin_pbpk/circ28_drug_clozapine.sio; parameter table, pooled study tables and
// sources with access level in its header). ROUND 2: the reference subject is the NON-SMOKING ADULT MAN and
// the model is fitted to pooled APPARENT ORAL observables. Round 1 fitted clint and the Kp scalar to one
// intravenous study (Cheng 1988, k = 1): F 0.85, steady-state trough 318 ng/mL against 122.
//
// FITTED, hence NOT validations (one observable per fitted parameter):
//   P total hepatic clint  -> pooled CL/F of the non-smoking man, pool 8 (k 5, N 720), closed form
//   P Kp scalar            -> pooled terminal half-life, pool 11 (k 6, N 79), corrected to the non-smoker
//   P split phi (clform)   -> pooled steady-state norclozapine:clozapine trough ratio, pool 2 (k 5)
//   P ka                   -> pooled steady-state Tmax, 100 mg b.i.d., pool 4 (k 5)
//   CYP1A2 share f1A2      -> pooled clozapine exposure ratio with fluvoxamine, pool 0 (k 8)
//   M total CL             -> pooled MODEL-BASED elimination half-life of norclozapine, pool 3 (k 2)
//   M CYP1A2 share fM      -> pooled norclozapine exposure ratio with fluvoxamine, pool 12 (k 4)
//   NOT fitted: M Kp scalar = 1 (declared prediction), tissue permeability scalar (default), fa = 1, no gut
//   clint (grapefruit juice, itraconazole, erythromycin, ketoconazole and nefazodone do not change clozapine).
//   Rows whose study is inside a fitted pool are CONSISTENCY rows and are marked [in pool].
//
// WHY THE Kp SCALAR GOES TO THE HALF-LIFE (decided from arithmetic on the pools, before any run): the published
// V/F are of mixed kinds (one-compartment volumes of sparse TDM data, an NPML median, two-compartment sums; a
// factor 4.7 between them) and (V/F) ln2/(CL/F) = 19.3 h (n-weighted) or 15.8 h (unweighted) is not shorter than
// the pooled terminal half-life 15.3 h: as V_ss/F they leave no room for a distribution phase (lesson 2). The
// pooled V/F is a validation row. V_ss = (V/F) F with F predicted; F does not depend on the Kp scalar, so the
// consistency needs no iteration.
//
// VALIDATIONS. Criteria fixed BEFORE the runs: |z| <= 2 where a between-subject or between-study SD exists (a
// label range is turned into SD = range/4 and said so); a factor 1.5 otherwise (2 for the urinary row, 1.25 for
// ratios of ratios).
//
// COORDINATOR'S PREDICTIONS (his, recorded before the runs):
//   C1 pooled non-smoker CL/F between 25 and 40 L/h
//   C2 F falls to 0.45-0.65 (inside the label's 50-60 %, above Cheng's 0.27)
//   C3 steady-state trough at 100 mg b.i.d. inside |z| < 2 of the label and of the TDM concentrations
//   C4 the IV clearance row FAILS high against Cheng (model 20-28 L/h plasma against 13)
//   C5 the IV half-life row stays failing
//
// MY PREDICTIONS, WRITTEN BEFORE ANY RUN OF THE NEW BASE (hand arithmetic from the pools and bp Qh = 86.52 L/h,
// V_ss(scalar 1) = 258 L of round 1):
//   pools: CL/F 27.2 L/h (u 1.7); half-life of mixed cohorts 15.3 h, target for the non-smoker 17.3 h
//   Eh 0.24; F 0.76 (0.73-0.79); IV CL 20.7 L/h; V_ss 470 L (430-520); kpsc 1.85 (1.6-2.1); V/F 620 L
//   fits: phi 0.29 (0.24-0.36); CL_M 10.3 L/h (9.5-11.5); ka 0.47 /h (0.40-0.60); f1A2 0.70 (0.68-0.72);
//         fM 0.68 (0.55-0.80)
//   V1   F 0.76                                   obs 0.27 (Cheng 1988)                        FAIL (fold 2.8)
//   V1b  F 0.76                                   obs 50-60 % (UK SmPC), mid 0.55              PASS at 1.5 (fold 1.38)
//        but OUTSIDE the stated range: I expect C2 to be MISSED
//   V1c  IV CL 20.7 L/h                           obs 13.05, u 2.6 assumed (Cheng)             FAIL (z +2.9)
//   V1d  V_ss 470 L                               obs 116.8 L (Cheng 1.6 L/kg; SmPC 1.6 L/kg)  FAIL (fold 4)
//   V1e  V/F 620 L                                obs 433 L = Cheng V_ss/F                     PASS at 1.5 (fold 1.43)
//   V1f  V/F 620 L                                pool 10: 757 L, between-study SD 361         PASS (z -0.4)
//   V2   IV terminal t1/2 17.3 h                  obs 10.3 h (Cheng)                           FAIL (fold 1.68)
//   V3   oral t1/2 17.3 h                         obs 8 h, range 4-12 (label; = Choc 1990 single dose 7.9 h)  FAIL (z +4.6)
//   V3b  same                                     obs 13.7 +/- 9.9 h (Lin 1994) [in pool]      PASS
//   V4   steady-state t1/2 17.3 h                 obs 12 h (label, SmPC)                       PASS at 1.5 (fold 1.44)
//   V4b  same                                     obs 15.8 h (Choc 1987) [in pool]             PASS
//   V5   single 100 mg AUCinf 3677 ng h/mL        obs 2390 +/- 1406 (Lin 1994, n 14)           PASS (z +0.9)
//   V5b  CL/F 27.2 L/h                            obs 55.4 +/- 29.7 (Lin 1994)                 PASS (z -0.95)
//   V5c  single-dose Tmax 3.0 h (2.9-3.2)         obs 3 h (Cheng)                              PASS
//   V5d  same                                     obs 1.4 +/- 0.7 h (Hagg 1999, 12.5 mg)       FAIL (z +2.3)
//   V5e  CL/F non-smoker 27.2 / smoker 37.7       pool 9 (habit not stated) 38, SD 7           PASS / PASS (z -1.5 / 0)
//   V6   steady-state AUC0-12 3677                pooled 3715, between-study SD 792            PASS (z -0.05)
//   V7   steady-state Cmax 370 ng/mL (330-410)    pooled 445, SD 105                           PASS (z -0.7)
//   V8   steady-state trough 245 ng/mL (215-275)  obs 122, range 41-343 (label)                PASS (z +1.6)
//   V9   trough per daily dose 1.22 ng/mL per mg/day   UK TDM 1.017 [0.665, 1.542] (non-smoking man, Couchman 2010) PASS
//   V9b  same                                     UK TDM 350/275 = 1.273 (Reeves 2023, non-smoking White man, 40 y) PASS
//   V10  single-dose AUC ratio norclozapine/clozapine 0.70 (0.62-0.78)   obs 0.314 (Lin 1994)  FAIL (fold 2.2)
//   V11  norclozapine in urine 5.4 % of the dose (4.5-6.5), molar        obs 3.5 % (derived)   PASS at 2 (fold 1.55)
//   V11b same                                     below the 14 % of Schaber 1998               PASS
//   V11c renal clearance of clozapine 0.0405 L/h  obs 0.8 +/- 0.5 L/h (Hagg 1999)              z -1.5 PASS, fold 0.05
//   V12  f1A2 0.70                                "approximately 70 %" (Wagner 2020, secondary) PASS
//   V13  non-smoker/smoker CL/F ratio 1.385       pooled 1.367, between-study SD 0.22          PASS
//   V14  fluvoxamine steady-state TROUGH ratio 3.16 (2.9-3.5)   obs 3.0 (Wetzel) [in pool]     PASS
//   V15  fluvoxamine t1/2 ratio 2.34 (2.2-2.5)    obs 50/17 = 2.94 (Wetzel)                    PASS (fold 0.80)
//   V15b same                                     obs 4.7 (Wang 2004, +370 %)                  FAIL (fold 0.50)
//   V16  norclozapine trough ratio under fluvoxamine = pooled 1.95 (fitted)   obs 3 (Wetzel) [in pool]   FAIL (fold 0.65)
//   V16b norclozapine AUC ratio 1.95              obs 0.91 (Chang 1999) [in pool]              FAIL (fold 2.1)
//   V16c N:C ratio with/without fluvoxamine 0.62  obs 0.74 (Augustin 2019, non-smokers) [in pool]   PASS at 1.25 (fold 0.83)
//   V17  N:C trough ratio smokers/non-smokers 1.14 (1.05-1.22)   obs no difference (Wagner 2020)   PASS at 1.25
//   V17b same                                     obs 1.35 (Wetzel 1998)                       PASS at 1.25
//   V17c norclozapine C/D non-smoker/smoker 1.27  pool 13: 1.46, between-study SD 0.44         PASS (z -0.4)
//   V18  dose linearity exact (structural)        obs linear (Choc 1987)                       by construction
//   V19  dose-normalised AUC multiple/single 1.00 obs 1.27 (Choc 1990)                         PASS at 1.5
//   V20  norclozapine t1/2 after ORAL CLOZAPINE = the parent's 17.3 h (formation-limited)   obs 19.2 h (Guitton 1999)  PASS
//   V21  fraction of the dose converted to norclozapine 0.29   obs 0.66 (Guitton 1998, model estimate)   FAIL (fold 0.44)
//
// DISCLOSURE. After the predictions were written the offline fits were run (scratch program, deleted): it printed
// the pools, kpsc 1.7268, ka 0.2951, CL_M 10.680, phi 0.2895, f1A2 0.7035, s_M 0.4503 and ONE check run (terminal
// half-life 17.259 h, steady-state trough 240.9 ng/mL). ka missed my range (0.40-0.60): the rows that depend on ka
// (V5c, V5d, V7) were predicted with 0.47 and are left as written. The test body was written afterwards.
//
// RESULTS OF ROUND 2 (first complete run, local Madaros; the predictions above were not edited afterwards; the
// bands at the end of ct_runs were set to the measured values after this run).
//   COORDINATOR: C1 HIT (27.20 L/h). C2 MISS (F 0.761, above 0.65 and above the SmPC 50-60 %): with a hepatic-only
//     first pass and a well-stirred liver F = bpQh/(bpQh + CL/F), so F <= 0.65 needs CL/F >= 46.6 L/h, a smoker's value.
//     C3 HIT (trough 240.9 ng/mL, z +1.57 against the label; 1.204 ng/mL per mg/day inside the UK TDM interval and
//     0.95-fold of Reeves 2023). C4 HIT (20.70 L/h, z +2.93, FAIL). C5 HIT (17.26 h against 10.3 h, fold 1.68, FAIL).
//   MINE, verdicts: all 43 verdict rows as predicted (V1 fail, V1b pass but outside the range, V1c fail, V1d fail 3.79, V1e pass 1.34,
//     V1f pass z -0.49, V2 fail, V3 fail z +4.63, V3b pass, V4 pass 1.44, V4b pass, V5 pass z +0.92, V5b pass, V5c pass
//     3.17 h, V5d fail z +2.53, V5e pass z -1.08 and -0.07, V6 pass z -0.05, V7 pass z -0.82, V8 pass z +1.57, V9 pass,
//     V9b pass, V10 fail 2.01, V11 pass 1.34, V11b pass, V11c z pass / fold fail, V12 pass, V13 pass z +0.06, V14 pass
//     3.15, V15 pass 0.72, V15b fail 0.45, V16 fail 0.65, V16b fail 2.05, V16c pass 0.84, V17 pass 1.11, V17b pass 0.82,
//     V17c pass z -0.33, V19 pass, V20 pass 18.05 h, V21 fail 0.44).
//   MINE, values outside my ranges (kept): ka 0.295 /h (0.40-0.60); fluvoxamine t1/2 ratio 2.125 (2.2-2.5); V_ss 442 L
//     against the point 470 (inside 430-520); urinary norclozapine 4.70 % against the point 5.4 (inside 4.5-6.5).
//   REMAINING FAILURES and cause: see the report (Round 2). In one line: every failing row is either Cheng 1988
//     (F, IV CL, V_ss, IV t1/2: the IV study is not compatible with the pooled oral clearance under a hepatic-only
//     first pass), a single-dose half-life with short sampling (V3), a study of the 12.5 mg dose (V5d), Lin 1994's
//     metabolite AUC (V10), Wang 2004's half-life ratio (V15b), disagreement INSIDE a fitted pool (V16, V16b), the
//     renal clearance of Hagg 1999 against Schaber 1998 (V11c, factor 20) or Guitton 1998's model estimate (V21).
//
// Compiler workarounds kept (lesson 7): records are built by steps written in main; big structs live in
// the run function only; record arrays go to functions by value exactly as in the risperidone module, and a
// guard row compares the same quantity computed two ways (closed-form CL/F against the kernel AUC). The pooled
// tables are printed AFTER the records are built (the local Madaros segfaults otherwise).

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_metab::*
use darwin_pbpk::circ28_drug_clozapine::*
use math::pure::{ln}

fn ct_fold(tag: string, pred: f64, obs: f64, fold: f64, expect_pass: i32) -> i32 with IO, Mut, Div, Panic {
    let r = pred / obs
    var ok: i32 = 0
    if r <= fold && r >= 1.0 / fold { ok = 1 }
    print("  "); print(tag); print("  pred "); print(pred); print("  obs "); print(obs); print("  fold "); print(r)
    if ok == 1 { println("  [pass]") } else { println("  [fail]") }
    if ok != expect_pass {
        println("  [FAIL] outcome differs from the recorded one")
        return 1
    }
    return 0
}

fn ct_z(tag: string, pred: f64, obs: f64, sd: f64, expect_pass: i32) -> i32 with IO, Mut, Div, Panic {
    let z = (pred - obs) / sd
    var ok: i32 = 0
    if z <= 2.0 && z >= 0.0 - 2.0 { ok = 1 }
    print("  "); print(tag); print("  pred "); print(pred); print("  obs "); print(obs); print("  SD "); print(sd); print("  z "); print(z)
    if ok == 1 { println("  [pass]") } else { println("  [fail]") }
    if ok != expect_pass {
        println("  [FAIL] outcome differs from the recorded one")
        return 1
    }
    return 0
}

fn ct_in(tag: string, pred: f64, lo: f64, hi: f64, expect_pass: i32) -> i32 with IO, Mut, Div, Panic {
    var ok: i32 = 0
    if pred >= lo && pred <= hi { ok = 1 }
    print("  "); print(tag); print("  pred "); print(pred); print("  interval ["); print(lo); print(", "); print(hi); print("]")
    if ok == 1 { println("  [pass]") } else { println("  [fail]") }
    if ok != expect_pass {
        println("  [FAIL] outcome differs from the recorded one")
        return 1
    }
    return 0
}

fn ct_band(tag: string, v: f64, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    if v >= lo && v <= hi { return 0 }
    print("  [FAIL] "); print(tag); print(" = "); print(v); print(" outside ["); print(lo); print(", "); print(hi); println("]")
    return 1
}

fn ct_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    d = d / want
    print("  "); print(tag); print("  got "); print(got); print("  want "); print(want); print("  rel "); println(d)
    if d > tol {
        println("  [FAIL] above tolerance")
        return 1
    }
    return 0
}

fn ct_pool_row(tag: string, which: i32) with IO, Mut, Div, Panic {
    var o: [f64; 12] = [0.0; 12]
    clz_pool_of(which, &!o)
    print("  "); print(tag); print("  k "); print(o[7]); print("  N "); print(o[1]); print("  n-weighted mean "); print(o[0])
    print("  unweighted "); print(o[8]); print("  SE_w "); print(o[3]); print("  between-study SD "); print(o[4]); print("  SE_b "); print(o[5]); print("  u "); println(o[6])
}

fn ct_pool_unw(which: i32) -> f64 with Mut, Div, Panic {
    var o: [f64; 12] = [0.0; 12]
    clz_pool_of(which, &!o)
    return o[8]
}

fn ct_pools() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("P pooled observables (n-weighted mean; u = max(SE_w, SE_b), SE_w = pooled within-study SD/sqrt N, SE_b = between-study SD/sqrt k)")
    ct_pool_row("(8) CL/F non-smoking man, L/h [FITTED: clint]          ", 8)
    ct_pool_row("(11) terminal t1/2, habit not stated, h [FITTED: kpsc] ", 11)
    ct_pool_row("(0) fluvoxamine exposure ratio [FITTED: f1A2]          ", 0)
    ct_pool_row("(2) norclozapine:clozapine trough [FITTED: phi]        ", 2)
    ct_pool_row("(3) norclozapine elimination t1/2, h [FITTED: CL_M]    ", 3)
    ct_pool_row("(4) steady-state Tmax, h [FITTED: ka]                  ", 4)
    ct_pool_row("(12) norclozapine ratio with fluvoxamine [FITTED: fM]  ", 12)
    ct_pool_row("(1) non-smoker/smoker C/D ratio [validation; t1/2 corr]", 1)
    ct_pool_row("(5) steady-state AUC0-12, ng h/mL [validation]         ", 5)
    ct_pool_row("(6) steady-state Cmax, ng/mL [validation]              ", 6)
    ct_pool_row("(9) CL/F, smoking habit not stated, L/h [validation]   ", 9)
    ct_pool_row("(10) V/F, mixed kinds, L [validation]                  ", 10)
    ct_pool_row("(13) norclozapine C/D non-smoker/smoker [validation]   ", 13)
    ct_pool_row("(7) creatinine clearance, mL/min                       ", 7)
    fails = fails + ct_band("pool 0 mean", clz_pool_mean(0), 2.73, 2.76)
    fails = fails + ct_band("pool 1 mean", clz_pool_mean(1), 1.36, 1.38)
    fails = fails + ct_band("pool 2 mean", clz_pool_mean(2), 0.74, 0.76)
    fails = fails + ct_band("pool 3 mean", clz_pool_mean(3), 12.3, 12.4)
    fails = fails + ct_band("pool 4 mean", clz_pool_mean(4), 2.22, 2.24)
    fails = fails + ct_band("pool 5 mean", clz_pool_mean(5), 3700.0, 3730.0)
    fails = fails + ct_band("pool 6 mean", clz_pool_mean(6), 440.0, 450.0)
    fails = fails + ct_band("pool 7 mean", clz_pool_mean(7), 110.0, 113.0)
    fails = fails + ct_band("pool 8 mean (coordinator C1: 25-40 L/h)", clz_pool_mean(8), 25.0, 40.0)
    fails = fails + ct_band("pool 8 mean (hand 27.2)", clz_pool_mean(8), 27.1, 27.3)
    fails = fails + ct_band("pool 8 u (hand 1.7)", clz_pool_u(8), 1.6, 1.8)
    fails = fails + ct_band("pool 9 mean", clz_pool_mean(9), 37.0, 39.0)
    fails = fails + ct_band("pool 10 mean (hand 757)", clz_pool_mean(10), 750.0, 765.0)
    fails = fails + ct_band("pool 11 mean (hand 15.3)", clz_pool_mean(11), 15.2, 15.4)
    fails = fails + ct_band("pool 12 mean (hand 1.946)", clz_pool_mean(12), 1.93, 1.96)
    fails = fails + ct_band("pool 13 mean (hand 1.46)", clz_pool_mean(13), 1.44, 1.49)
    print("  residual CYP1A2 activity under fluvoxamine r = 1/(1 + Iu/Ki) = "); print(clz_fvx_r()); print("  (Iu "); print(clz_fvx_iu_nm()); println(" nmol/L)")
    var o8: [f64; 12] = [0.0; 12]
    clz_pool_of(8, &!o8)
    let alt = (o8[0] * o8[1] - 22.5 * 197.0 + 36.7 * 278.0) / (o8[1] - 197.0 + 278.0)
    print("  sensitivity of pool 8: unweighted mean "); print(ct_pool_unw(8)); print(" L/h; with Ismail 2012 (men 36.7 L/h, n 278, smokers and non-smokers together, same database as Ng 2009) in place of Ng 2009: "); print(alt); println(" L/h (NOT used: not a non-smoker value)")
    fails = fails + ct_band("pool 8 with Ismail in place of Ng (L/h)", alt, 31.0, 32.5)
    return fails
}

fn ct_show(tag: string, r: &[f64; 32]) with IO, Mut, Div, Panic {
    print(tag); print(": P Cmax "); print((*r)[0]); print(" Tmax "); print((*r)[1]); print(" AUCinf "); print((*r)[2]); print(" t1/2 "); println((*r)[3])
    print("      M Cmax "); print((*r)[4]); print(" Tmax "); print((*r)[5]); print(" AUCinf "); print((*r)[6]); print(" t1/2 "); println((*r)[7])
    print("      steady state (same dose every tau): P Cmax "); print((*r)[15]); print(" Tmax "); print((*r)[16]); print(" trough "); print((*r)[17])
    print("  M Cmax "); print((*r)[18]); print(" trough "); println((*r)[20])
    print("      balance P "); print((*r)[9]); print(" M "); print((*r)[10]); print(" grid/fit ok "); print((*r)[11]); print("/"); print((*r)[12]); print("/"); println((*r)[13])
}

fn ct_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    return cd_sqrt(x)
}

// One coupled oral or intravenous run of the records with the hepatic intrinsic clearances of clozapine scaled
// by s and that of norclozapine by sm. Terminal windows: clozapine 48-120 h, norclozapine 96-168 h.
fn ct_run(dp: &Circ28Drug, dm: &Circ28Drug, route: i32, dose: f64, s: f64, sm: f64, res: &![f64; 32]) with Mut, Div, Panic, Epistemic {
    let thp0 = circ28_drug_theta(dp)
    let thp = clz_scale_hep(thp0, s)
    let thm0 = circ28_drug_theta(dm)
    let thm = clz_scale_m(thm0, sm)
    clz_run_th(thp, thm, route, dose, 0.1, 12.0, 48.0, 120.0, 96.0, 168.0, res)
}

fn ct_f1a2(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_f1a2(circ28_drug_theta(dp), clz_obs_fvx(), clz_fvx_r())
}

fn ct_clf(dp: &Circ28Drug, s: f64) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_cl_over_f(clz_scale_hep(circ28_drug_theta(dp), s))
}

fn ct_cls(dp: &Circ28Drug, s: f64) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_cl(clz_scale_hep(circ28_drug_theta(dp), s))
}

fn ct_m_t12(dm: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_m_t12(circ28_drug_theta(dm))
}

// Steady-state Tmax (which = 0) or terminal half-life (which = 1) with ka and the Kp scalar replaced (for the
// slopes used by the budget).
fn ct_probe(dp: &Circ28Drug, dm: &Circ28Drug, ka: f64, kp: f64, which: i32) -> f64 with Mut, Div, Panic, Epistemic {
    var thp = circ28_drug_theta(dp)
    thp[CD_KA] = ka
    thp[CD_KPSC] = kp
    let thm = circ28_drug_theta(dm)
    var r: [f64; 32] = [0.0; 32]
    clz_run_th(thp, thm, 1, 100.0, 0.0, 12.0, 48.0, 120.0, 96.0, 168.0, &!r)
    if which == 0 { return r[16] }
    return r[3]
}

// Guard: the norclozapine trough is linear in phi at fixed total hepatic clearance, and the clozapine curve
// does not depend on phi or on the metabolite record.
fn ct_guard(dp: &Circ28Drug, dm: &Circ28Drug, base: &[f64; 32]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var thp = circ28_drug_theta(dp)
    let tot = thp[CD_CLINT] + thp[CD_CLFORM]
    thp[CD_CLFORM] = 0.5 * thp[CD_CLFORM]
    thp[CD_CLINT] = tot - thp[CD_CLFORM]
    var thm = circ28_drug_theta(dm)
    thm[CD_FU] = 1.1 * thm[CD_FU]
    var r: [f64; 32] = [0.0; 32]
    clz_run_th(thp, thm, 1, 100.0, 0.0, 12.0, 48.0, 120.0, 96.0, 168.0, &!r)
    println("G guard rows (same quantity two ways)")
    fails = fails + ct_rel("clozapine trough unchanged by phi/2 and fu_M x 1.1", r[17], (*base)[17], 1.0e-9)
    fails = fails + ct_rel("mass given to M halves with phi/2                 ", r[14], 0.5 * (*base)[14], 1.0e-9)
    return fails
}

fn ct_budget(dp: &Circ28Drug, dm: &Circ28Drug, slope_ka: f64, slope_kp: f64, t12: f64, u_t12: f64, lo_rel: f64, hi_rel: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let b = clz_budget(dp, dm, slope_ka, slope_kp, t12, u_t12)
    let t = clz_obs_ncratio()
    let ut = clz_u_ncratio()
    let u_p = ct_sqrt(b.var_trough)
    let sum = b.trough * (1.0 + t)
    let var_sum = (1.0 + t) * (1.0 + t) * b.var_trough + b.trough * b.trough * ut * ut
    print("S6 uncertainty budget with refit, steady-state trough, 100 mg b.i.d.: "); print(b.runs); println(" coupled runs, forward differences")
    print("  clozapine trough "); print(1000.0 * b.trough); print(" ng/mL  u "); print(1000.0 * u_p); print("  rel "); println(u_p / b.trough)
    print("  clozapine + norclozapine trough "); print(1000.0 * sum); print(" ng/mL  u "); print(1000.0 * ct_sqrt(var_sum)); print("  rel "); println(ct_sqrt(var_sum) / sum)
    println("  input          u(input)      share of var(clozapine trough) %    share of var(sum) %")
    var i: i32 = 0
    while i < 9 {
        print("  "); print(clz_input_name(i)); print("   "); print(b.u[i]); print("   "); print(100.0 * b.contrib[i] / b.var_trough)
        print("   "); println(100.0 * (1.0 + t) * (1.0 + t) * b.contrib[i] / var_sum)
        i = i + 1
    }
    print("  N:C ratio obs    "); print(ut); print("   0   "); println(100.0 * b.trough * b.trough * ut * ut / var_sum)
    fails = fails + ct_band("relative u of the clozapine trough", u_p / b.trough, lo_rel, hi_rel)
    return fails
}

fn ct_cl(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_cl(circ28_drug_theta(dp))
}

fn ct_eh(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_eh(circ28_drug_theta(dp))
}

fn ct_foral(dp: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    return clz_f_oral(circ28_drug_theta(dp))
}

fn ct_s1(dp: &Circ28Drug, dm: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    // ---- input consistency (lesson 2), arithmetic on the pools only, before any run
    let ln2 = 0.6931471805599453
    let t_w = ln2 * clz_pool_mean(10) / clz_obs_clf()
    let t_u = ln2 * ct_pool_unw(10) / ct_pool_unw(8)
    println("C input consistency (pools only): (V/F) ln2 / (CL/F) against the pooled terminal half-life")
    print("  n-weighted "); print(t_w); print(" h   unweighted "); print(t_u); print(" h   pooled terminal half-life (habit not stated) "); print(clz_obs_t12_mixed()); println(" h")
    println("  -> the V/F pool does not leave room for a distribution phase: the Kp scalar is fitted to the half-life, V/F validates")
    fails = fails + ct_band("(V/F) ln2/(CL/F), n-weighted (hand 19.3 h)", t_w, 19.0, 19.6)
    fails = fails + ct_band("(V/F) ln2/(CL/F), unweighted (hand 15.8 h; measured 15.5)", t_u, 15.3, 15.9)
    fails = fails + ct_band("pooled half-life / n-weighted (V/F) ln2/(CL/F) below 1", clz_obs_t12_mixed() / t_w, 0.7, 1.0)
    // ---- S1: the fits reproduce their own observables
    println("S1 the fits reproduce their observables (NOT validations)")
    let pp = circ28_drug_params(dp)
    let pm = circ28_drug_params(dm)
    let bb = pp.bp * circ28_q_hepatic(pp)
    print("  half-life target of the non-smoker: R_CL "); print(clz_rcl(bb, clz_obs_clf())); print("  c = 1 + 0.5 (R_CL - 1)  target "); print(clz_obs_t12_ns(bb, clz_obs_clf()));
    print(" h  u "); println(clz_u_t12_ns(bb, clz_obs_clf()))
    fails = fails + ct_rel("CL/F P (L/h), closed form   ", ct_clf(dp, 1.0), clz_obs_clf(), 1.0e-9)
    fails = fails + ct_rel("CL M total (L/h)           ", circ28_splanchnic_clearance(pm) * pm.bp + circ28_drug_value(dm, CD_CLREN), clz_m_cl_fit(), 1.0e-9)
    fails = fails + ct_rel("M t1/2, M alone IV (h)     ", ct_m_t12(dm), clz_obs_m_t12(), 1.0e-4)
    let f1a2 = ct_f1a2(dp)
    let s_fvx = clz_scale_fvx(f1a2, clz_fvx_r())
    let s_smk = clz_scale_smoke(f1a2, clz_smoke_fold())
    fails = fails + ct_rel("fluvoxamine CL/F ratio     ", ct_clf(dp, 1.0) / ct_clf(dp, s_fvx), clz_obs_fvx(), 1.0e-6)
    print("  V_ss P "); print(circ28_vss_plasma(pp)); print(" L   V_ss M (Rodgers-Rowland, scalar 1: a PREDICTION) = "); print(circ28_vss_plasma(pm)); println(" L")
    let tot = circ28_drug_value(dp, CD_CLINT) + circ28_drug_value(dp, CD_CLFORM)
    print("  kpsc "); print(circ28_drug_value(dp, CD_KPSC)); print("  tot "); print(tot); print("  phi "); print(circ28_drug_value(dp, CD_CLFORM) / tot)
    print("  Eh "); print(ct_eh(dp)); print("  F "); print(ct_foral(dp)); print("  CL "); print(ct_cl(dp)); print("  f1A2 "); print(f1a2); print("  fM "); print(clz_fm())
    print("  scale fluvoxamine P "); print(s_fvx); print(" M "); print(clz_m_sfvx_fit()); print("  scale smoker P "); print(s_smk); print(" M "); println(clz_scale_smoke(clz_fm(), clz_smoke_fold()))
    return fails
}

// D2: intravenous terminal half-life (48-120 h) with the tissue permeability scalar set to ps, the hepatic
// clearance refitted to the same CL/F at the same Kp scalar. A diagnosis, not a fit.
fn ct_t12_ps(dp: &Circ28Drug, ps: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var t = circ28_drug_theta(dp)
    t[CD_PSSC] = ps
    let clren = t[CD_CLREN]
    let phi = t[CD_CLFORM] / (t[CD_CLFORM] + t[CD_CLINT])
    let t2 = clz_fit_p(t, clz_obs_clf(), clren, phi, t[CD_KPSC])
    let r = circ28_run_theta(t2, circ28_dose_iv(100.0, 0.1, 0.1, 12.0, 1.0, 168.0, 48.0, 120.0))
    return r.thalf
}

fn ct_d2(dp: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let a = ct_t12_ps(dp, 1.0)
    let b = ct_t12_ps(dp, 0.3)
    let c = ct_t12_ps(dp, 0.1)
    println("D2 diagnosis: IV terminal t1/2 against the tissue permeability scalar (default 1; NOT fitted, lesson 3)")
    print("  ps x1 "); print(a); print(" h   x0.3 "); print(b); print(" h   x0.1 "); print(c); println(" h")
    fails = fails + ct_band("D2 ps x0.3 moves t1/2 by < 3 %", b / a, 0.97, 1.03)
    fails = fails + ct_band("D2 ps x0.1 moves t1/2 by < 8 %", c / a, 0.92, 1.08)
    return fails
}

fn ct_runs(dp: &Circ28Drug, dm: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let f1a2 = ct_f1a2(dp)
    let s_fvx = clz_scale_fvx(f1a2, clz_fvx_r())
    let s_smk = clz_scale_smoke(f1a2, clz_smoke_fold())
    let sm_fvx = clz_m_sfvx_fit()
    let sm_smk = clz_scale_smoke(clz_fm(), clz_smoke_fold())
    let pp = circ28_drug_params(dp)
    let bb = pp.bp * circ28_q_hepatic(pp)
    let t12 = clz_obs_t12_ns(bb, clz_obs_clf())
    let u_t12 = clz_u_t12_ns(bb, clz_obs_clf())
    let vss = circ28_vss_plasma(pp)
    // ---- S2: intravenous
    var iv: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 0, 100.0, 1.0, 1.0, &!iv)
    ct_show("S2 IV 100 mg over 0.1 h", &iv)
    fails = fails + ct_band("IV balance P", iv[9], 0.0, 1.0e-9)
    fails = fails + ct_band("IV balance M", iv[10], 0.0, 1.0e-9)
    fails = fails + ct_rel("guard: IV AUCinf x CL = dose (kernel vs closed form)", iv[2] * ct_cl(dp), 100.0, 5.0e-3)
    // ---- S3: oral, single 100 mg and 100 mg b.i.d. by superposition
    var po: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 1, 100.0, 1.0, 1.0, &!po)
    ct_show("S3 oral 100 mg", &po)
    fails = fails + ct_band("oral balance P", po[9], 0.0, 1.0e-9)
    fails = fails + ct_band("oral balance M", po[10], 0.0, 1.0e-9)
    fails = fails + ct_rel("guard: oral AUCinf x CL/F = dose                        ", po[2] * ct_clf(dp, 1.0), 100.0, 5.0e-3)
    fails = fails + ct_rel("terminal t1/2 = non-smoker target [fitted, kpsc]        ", po[3], t12, 1.0e-3)
    fails = fails + ct_rel("steady-state Tmax = pooled 2.228 h [fitted, ka]         ", po[16], clz_obs_tmax_ss(), 2.0e-3)
    fails = fails + ct_rel("steady-state N:C trough ratio = pooled [fitted, phi]    ", po[20] / po[17], clz_obs_ncratio(), 2.0e-3)
    fails = fails + ct_guard(dp, dm, &po)
    println("V validation, predicted vs observed (criteria and expectations fixed before the runs: header)")
    let f_cf = ct_foral(dp)
    let cl_iv = ct_cl(dp)
    fails = fails + ct_fold("V1   F vs 0.27 (Cheng 1988)                           ", f_cf, clz_obs_f(), 1.5, 0)
    fails = fails + ct_fold("V1b  F vs 0.55 (UK SmPC 50-60 %, mid)                 ", f_cf, 0.55, 1.5, 1)
    fails = fails + ct_in("V1b' F inside the SmPC range 0.50-0.60                 ", f_cf, 0.50, 0.60, 0)
    fails = fails + ct_in("C2   F inside 0.45-0.65 (coordinator)                  ", f_cf, 0.45, 0.65, 0)
    fails = fails + ct_z("V1c  IV CL (L/h plasma) vs Cheng 13.05, u 20 % assumed", cl_iv, clz_chg_cl(), clz_chg_u_cl(), 0)
    fails = fails + ct_in("C4   IV CL inside 20-28 L/h (coordinator)              ", cl_iv, 20.0, 28.0, 1)
    fails = fails + ct_fold("V1d  V_ss (L) vs Cheng 1.6 L/kg x 73 kg               ", vss, clz_chg_vss(), 1.5, 0)
    fails = fails + ct_fold("V1e  V/F (L) vs Cheng V_ss/F                          ", vss / f_cf, clz_chg_vss() / clz_obs_f(), 1.5, 1)
    fails = fails + ct_z("V1f  V/F (L) vs pool 10                               ", vss / f_cf, clz_pool_mean(10), clz_pool_sb(10), 1)
    fails = fails + ct_fold("V2   IV terminal t1/2 (h) vs 10.3 (Cheng)  [C5]        ", iv[3], clz_obs_t12_iv(), 1.5, 0)
    fails = fails + ct_z("V3   oral t1/2 (h) vs label 8 (single dose), SD = range/4", po[3], 8.0, 2.0, 0)
    fails = fails + ct_z("V3b  oral t1/2 (h) vs Lin 1994 13.7 +/- 9.9 [in pool]", po[3], 13.7, 9.9, 1)
    fails = fails + ct_fold("V4   steady-state t1/2 (h) vs label 12                ", po[3], 12.0, 1.5, 1)
    fails = fails + ct_fold("V4b  steady-state t1/2 (h) vs Choc 1987 15.8 [in pool]", po[3], 15.8, 1.5, 1)
    fails = fails + ct_z("V5   single 100 mg AUCinf (ng h/mL) vs Lin 1994       ", 1000.0 * po[2], 2389.9, 1406.0, 1)
    fails = fails + ct_z("V5b  CL/F (L/h) vs Lin 1994 55.4 +/- 29.7            ", 100.0 / po[2], 55.4, 29.7, 1)
    fails = fails + ct_fold("V5c  single-dose Tmax (h) vs 3 (Cheng)                ", po[1], 3.0, 1.5, 1)
    fails = fails + ct_z("V5d  single-dose Tmax (h) vs Hagg 1999 1.4 +/- 0.7    ", po[1], 1.4, 0.7, 0)
    fails = fails + ct_z("V5e  CL/F non-smoker vs pool 9 (habit not stated)    ", ct_clf(dp, 1.0), clz_pool_mean(9), clz_pool_sb(9), 1)
    fails = fails + ct_z("V5e' CL/F SMOKER vs pool 9                            ", ct_clf(dp, s_smk), clz_pool_mean(9), clz_pool_sb(9), 1)
    fails = fails + ct_z("V6   steady-state AUC0-12 (ng h/mL) vs pool           ", 1000.0 * po[2], clz_pool_mean(5), clz_pool_sb(5), 1)
    fails = fails + ct_z("V7   steady-state Cmax (ng/mL) vs pool                ", 1000.0 * po[15], clz_pool_mean(6), clz_pool_sb(6), 1)
    fails = fails + ct_z("V8   steady-state trough (ng/mL) vs label 122  [C3]   ", 1000.0 * po[17], 122.0, 75.5, 1)
    let cd = 1000.0 * po[17] / 200.0
    fails = fails + ct_in("V9   trough per mg/day vs UK TDM 1.017 [0.665, 1.542] [C3]", cd, 0.665, 1.542, 1)
    fails = fails + ct_fold("V9b  trough per mg/day vs 350/275 (Reeves 2023)  [C3]  ", cd, 350.0 / 275.0, 1.5, 1)
    fails = fails + ct_fold("V10  single-dose AUC ratio N/C vs 0.314 (Lin)         ", po[6] / po[2], 751.1 / 2389.9, 1.5, 0)
    // urinary norclozapine, molar fraction of the oral dose; the run stops at 168 h
    let fe_m = (po[21] / (clz_m_mw() / clz_p_mw())) / 100.0
    fails = fails + ct_fold("V11  norclozapine in urine (% dose) vs 3.5            ", 100.0 * fe_m, 3.5, 2.0, 1)
    fails = fails + ct_band("V11b norclozapine in urine below the 14 % of Schaber 1998", 100.0 * fe_m, 0.0, 14.0)
    let clren_p = circ28_drug_value(dp, CD_CLREN)
    fails = fails + ct_z("V11c renal clearance of clozapine (L/h) vs Hagg 1999  ", clren_p, 0.8, 0.5, 1)
    fails = fails + ct_fold("V11c' same, as a fold                                 ", clren_p, 0.8, 1.5, 0)
    fails = fails + ct_fold("V12  f1A2 vs about 0.70 (secondary)                   ", f1a2, 0.70, 1.25, 1)
    // ---- S4: CYP1A2 scenarios
    let r_smk = ct_clf(dp, s_smk) / ct_clf(dp, 1.0)
    fails = fails + ct_z("V13  non-smoker/smoker C/D ratio vs pool 1            ", r_smk, clz_pool_mean(1), clz_pool_sb(1), 1)
    var fv: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 1, 100.0, s_fvx, sm_fvx, &!fv)
    ct_show("S4a oral 100 mg with fluvoxamine", &fv)
    fails = fails + ct_rel("norclozapine trough ratio with fluvoxamine = pooled [fitted, fM]", fv[20] / po[20], clz_obs_m_fvx(), 2.0e-3)
    fails = fails + ct_fold("V14  fluvoxamine trough ratio vs 3.0 (Wetzel) [in pool]", fv[17] / po[17], 3.0, 1.5, 1)
    fails = fails + ct_fold("V15  fluvoxamine t1/2 ratio vs 2.94 (Wetzel)          ", fv[3] / po[3], 50.0 / 17.0, 1.5, 1)
    fails = fails + ct_fold("V15b fluvoxamine t1/2 ratio vs 4.7 (Wang)             ", fv[3] / po[3], 4.7, 1.5, 0)
    fails = fails + ct_fold("V16  norclozapine trough ratio vs 3 (Wetzel) [in pool] ", fv[20] / po[20], 3.0, 1.5, 0)
    fails = fails + ct_fold("V16b norclozapine AUC ratio vs 0.91 (Chang) [in pool]  ", fv[6] / po[6], 0.91, 1.5, 0)
    fails = fails + ct_fold("V16c N:C ratio with/without fluvoxamine vs 0.74 (Augustin) [in pool]", (fv[20] / fv[17]) / (po[20] / po[17]), 1.608 / 2.179, 1.25, 1)
    var sk: [f64; 32] = [0.0; 32]
    ct_run(dp, dm, 1, 100.0, s_smk, sm_smk, &!sk)
    ct_show("S4b oral 100 mg, smoker", &sk)
    let ncs = (sk[20] / sk[17]) / (po[20] / po[17])
    fails = fails + ct_fold("V17  N:C trough ratio smoker/non-smoker vs 1.0 (Wagner)", ncs, 1.0, 1.25, 1)
    fails = fails + ct_fold("V17b same vs 1.35 (Wetzel 1998)                       ", ncs, 1.35, 1.25, 1)
    fails = fails + ct_z("V17c norclozapine C/D non-smoker/smoker vs pool 13    ", po[20] / sk[20], clz_pool_mean(13), clz_pool_sb(13), 1)
    print("       clozapine trough non-smoker/smoker "); print(po[17] / sk[17]); print("   smoker t1/2 "); print(sk[3]); print(" h, trough "); print(1000.0 * sk[17]); println(" ng/mL")
    println("  V18  dose linearity: the kernel is linear in the dose (37.5, 75, 150 mg b.i.d. scale exactly); Choc 1987 observed linearity")
    fails = fails + ct_fold("V19  dose-normalised AUC multiple/single vs 1.27      ", 1.0, 1.27, 1.5, 1)
    fails = fails + ct_fold("V20  M t1/2 after oral clozapine (h) vs 19.2 (Guitton 1999)", po[7], 19.2, 1.5, 1)
    let fconv = (po[14] / (clz_m_mw() / clz_p_mw())) / po[8]
    fails = fails + ct_fold("V21  fraction converted to norclozapine vs 0.66 (Guitton 1998)", fconv, 0.66, 1.5, 0)
    // ---- D1: what Cheng 1988 needs (not a fit, not a validation)
    println("D1 diagnosis: Cheng 1988 (IV + oral, n 10) under a hepatic-only first pass")
    let chg_clf = clz_chg_cl() / clz_obs_f()
    print("  Cheng's own CL/F = CL/F = "); print(chg_clf); print(" L/h (pool 9: "); print(clz_pool_mean(9)); print("); a well-stirred liver with that CL/F has CL = ")
    print(bb * chg_clf / (bb + chg_clf)); print(" L/h and F = "); print(bb / (bb + chg_clf)); println(", against the measured 13.05 L/h and 0.27")
    print("  presystemic availability outside the liver that F 0.27 needs with this record: "); print(clz_obs_f() / f_cf)
    print(";  that the SmPC mid 0.55 needs: "); println(0.55 / f_cf)
    fails = fails + ct_d2(dp)
    // bands around the measured outcomes (asserted as measured, not tuned)
    fails = fails + ct_band("F band (hand 0.76; measured 0.761)", f_cf, 0.75, 0.77)
    fails = fails + ct_band("IV CL band (hand 20.7; measured 20.70)", cl_iv, 20.4, 21.0)
    fails = fails + ct_band("V_ss band (hand 470; measured 442.1)", vss, 435.0, 450.0)
    fails = fails + ct_band("steady-state trough band (ng/mL; hand 245; measured 240.9)", 1000.0 * po[17], 236.0, 246.0)
    fails = fails + ct_band("steady-state Cmax band (ng/mL; hand 370; measured 359.3)", 1000.0 * po[15], 352.0, 366.0)
    fails = fails + ct_band("single-dose Tmax band (h; hand 3.0; measured 3.17)", po[1], 3.1, 3.25)
    fails = fails + ct_band("single-dose N:C AUC ratio band (hand 0.70; measured 0.630)", po[6] / po[2], 0.615, 0.645)
    fails = fails + ct_band("f1A2 band (hand 0.70; measured 0.7035)", f1a2, 0.695, 0.712)
    fails = fails + ct_band("fM band (hand 0.68; measured 0.604)", clz_fm(), 0.595, 0.613)
    fails = fails + ct_band("non-smoker/smoker band (hand 1.385; measured 1.379)", r_smk, 1.37, 1.39)
    fails = fails + ct_band("fluvoxamine trough ratio band (hand 3.16; measured 3.150)", fv[17] / po[17], 3.08, 3.22)
    fails = fails + ct_band("fluvoxamine t1/2 ratio band (hand 2.34, range 2.2-2.5: MY MISS; measured 2.125)", fv[3] / po[3], 2.08, 2.17)
    fails = fails + ct_band("N:C smoker/non-smoker band (hand 1.14; measured 1.111)", ncs, 1.09, 1.13)
    fails = fails + ct_band("fraction converted band (hand 0.29; measured 0.289)", fconv, 0.283, 0.295)
    fails = fails + ct_band("IV terminal t1/2 band (h; measured 17.26)", iv[3], 17.0, 17.5)
    fails = fails + ct_band("fluvoxamine norclozapine AUC ratio band (measured 1.862)", fv[6] / po[6], 1.82, 1.90)
    fails = fails + ct_band("urinary norclozapine band (% dose; hand 5.4; measured 4.70)", 100.0 * fe_m, 4.6, 4.8)
    // ---- S6: budget
    let k0 = clz_ka_fit()
    let kp0 = clz_kpsc_fit()
    let slope_ka = (ct_probe(dp, dm, 1.05 * k0, kp0, 0) - ct_probe(dp, dm, 0.95 * k0, kp0, 0)) / (0.1 * k0)
    let slope_kp = (ct_probe(dp, dm, k0, 1.05 * kp0, 1) - ct_probe(dp, dm, k0, 0.95 * kp0, 1)) / (0.1 * kp0)
    print("  d Tmax_ss / d ka = "); print(slope_ka); print("   d t1/2 / d kpsc = "); println(slope_kp)
    fails = fails + ct_budget(dp, dm, slope_ka, slope_kp, t12, u_t12, 0.065, 0.080)
    return fails
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var dm = circ28_drug_new()
    var dp = circ28_drug_new()
    // the steps of the record construction are written out in main (lean_single mis-forwards chained references)
    clz_measured_m(&!dm)
    clz_fit_record_m(&!dm)
    clz_measured_p(&!dp)
    clz_fit_record_p(&!dp)
    println("S0 record: P then M (value, status)")
    var i: i32 = 0
    while i < 18 {
        print("  P "); print(i); print(" "); print(circ28_drug_value(&dp, i)); print("  status "); print(dp.status[i])
        print("   |  M "); print(circ28_drug_value(&dm, i)); print("  status "); println(dm.status[i])
        i = i + 1
    }
    fails = fails + ct_s1(&dp, &dm)
    fails = fails + ct_runs(&dp, &dm)
    // the pooled tables are printed last: Madaros (local build) segfaults when ct_pools runs before the records are built in main
    fails = fails + ct_pools()
    if fails == 0 { println("CIRC28_DRUG_CLOZAPINE_PASS") } else { print("FAILS "); println(fails) }
}
