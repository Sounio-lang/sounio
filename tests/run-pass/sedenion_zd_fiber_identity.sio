//@ run-pass
//@ expect-stdout: FIBER_ID OK
// FRENTE B, third brick — the ISOMORPHISM TYPE of each sedenion ZD fiber, executed exactly.
//
// Brick 2 (sedenion_zd_fibers.sio) proved the 84 participating primitives split into 7 fibers of
// 12 vertices / 24 edges / degree 4. This proves WHAT each fiber IS: every fiber is isomorphic to
//   K_{6,6}  minus a 2-factor of three disjoint 4-cycles  (= K_{6,6} - 3*K_{2,2}),
// the bipartite "3-block color-mismatch" graph. We certify the identity by a BFS-free invariant:
// the COMMON-NEIGHBOR PROFILE. Over the 66 vertex-pairs of a fiber, the number of common annihilators
// is exactly:
//   * 4  for 6  pairs   (co-blocked: same side, same K_{2,2} block),
//   * 2  for 24 pairs   (same side, different block),
//   * 0  for 36 pairs   (opposite sides — bipartite, so no common neighbor).
// The profile (6, 24, 36) is the signature of K_{6,6}-3K_{2,2} given the fiber is 4-regular bipartite
// 6+6 (brick 2). (The rigorous "complement = three 4-cycles" isomorphism is confirmed by the Python
// oracle + Lean, which can traverse the graph; this test executes the profile, which needs none.)
//
// Decidable integer equality over Z, no float. SELF-CONTAINED (Lean-bridge prim_prod, no #637).
// Cross-verified vs scripts/research/sedenion_zd_fiber_identity_oracle.py by
// scripts/ci/sedenion_zd_fiber_identity_gate.sh, and by formal/lean4/SounioSedenionFiberIdentity.lean.

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}

fn sed_sigma(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }

fn prim_prod(ulo: i64, uhi: i64, uneg: i64, vlo: i64, vhi: i64, vneg: i64, k: i64) -> i64 with Mut, Panic, Div {
    let su = if uneg == 1 { 0 - 1 } else { 1 }
    let sv = if vneg == 1 { 0 - 1 } else { 1 }
    var acc = 0
    if (ulo ^ vlo) == k { acc = acc + sed_sigma(ulo, vlo) }
    if (ulo ^ vhi) == k { acc = acc + sv * sed_sigma(ulo, vhi) }
    if (uhi ^ vlo) == k { acc = acc + su * sed_sigma(uhi, vlo) }
    if (uhi ^ vhi) == k { acc = acc + su * sv * sed_sigma(uhi, vhi) }
    acc
}

fn is_zero_pair(ulo: i64, uhi: i64, uneg: i64, vlo: i64, vhi: i64, vneg: i64) -> bool with Mut, Panic, Div {
    var k = 0
    while k < 16 {
        if prim_prod(ulo, uhi, uneg, vlo, vhi, vneg, k) != 0 { return false }
        k = k + 1
    }
    true
}

fn main() with IO, Mut, Panic, Div {
    // Enumerate the 112, mark participation, collect the 84 participating into p-arrays with L=lo^hi.
    var clo = [0; 112]
    var chi = [0; 112]
    var cneg = [0; 112]
    var n = 0
    var lo = 1
    while lo <= 7 {
        var hi = 8
        while hi <= 15 {
            var neg = 0
            while neg <= 1 {
                clo[n as usize] = lo
                chi[n as usize] = hi
                cneg[n as usize] = neg
                n = n + 1
                neg = neg + 1
            }
            hi = hi + 1
        }
        lo = lo + 1
    }
    var plo = [0; 84]
    var phi = [0; 84]
    var png = [0; 84]
    var pL = [0; 84]
    var m = 0
    var i = 0
    while i < n {
        var parti = 0
        var j = 0
        while j < n {
            if is_zero_pair(clo[i as usize], chi[i as usize], cneg[i as usize],
                            clo[j as usize], chi[j as usize], cneg[j as usize]) { parti = 1 }
            j = j + 1
        }
        if parti == 1 && m < 84 {
            plo[m as usize] = clo[i as usize]
            phi[m as usize] = chi[i as usize]
            png[m as usize] = cneg[i as usize]
            pL[m as usize] = clo[i as usize] ^ chi[i as usize]
            m = m + 1
        }
        i = i + 1
    }

    // Per fiber L: common-neighbor profile over vertex-pairs. Assert (n4,n2,n0) = (6,24,36).
    var fibers_ok = 1
    var L = 9
    while L <= 15 {
        var n4 = 0
        var n2 = 0
        var n0 = 0
        var a = 0
        while a < m {
            if pL[a as usize] == L {
                var b = a + 1
                while b < m {
                    if pL[b as usize] == L {
                        // count common annihilators w in this fiber
                        var common = 0
                        var w = 0
                        while w < m {
                            if pL[w as usize] == L && w != a && w != b {
                                if is_zero_pair(plo[a as usize], phi[a as usize], png[a as usize],
                                                plo[w as usize], phi[w as usize], png[w as usize])
                                   && is_zero_pair(plo[b as usize], phi[b as usize], png[b as usize],
                                                   plo[w as usize], phi[w as usize], png[w as usize]) {
                                    common = common + 1
                                }
                            }
                            w = w + 1
                        }
                        if common == 4 { n4 = n4 + 1 }
                        else if common == 2 { n2 = n2 + 1 }
                        else if common == 0 { n0 = n0 + 1 }
                        else { fibers_ok = 0 }
                    }
                    b = b + 1
                }
            }
            a = a + 1
        }
        // one encoded int per fiber: L*1000000 + n4*10000 + n2*100 + n0
        print("FIBERID ")
        print_int(L * 1000000 + n4 * 10000 + n2 * 100 + n0)
        print("\n")
        if n4 != 6 || n2 != 24 || n0 != 36 { fibers_ok = 0 }
        L = L + 1
    }
    print("VERTICES ")
    print_int(m as i64)
    print("\n")
    if fibers_ok == 1 && m == 84 {
        println("FIBER_ID OK")
    } else {
        println("FIBER_ID FAIL")
    }
}
