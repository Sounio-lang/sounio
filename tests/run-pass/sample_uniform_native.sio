//@ run-pass
//@ description: native sample_uniform() PRNG under the Sampling effect — range + mean sanity
//
// Lane B (a): native MMIX/PCG-style LCG intrinsic. Draws lie in [0,1); the mean of many
// draws is ~0.5. Randomness is type-visible via `with Sampling`.

fn main() with IO, Sampling {
    var i: i64 = 0
    var sum: f64 = 0.0
    var in_range: i64 = 1
    var prev: f64 = -1.0
    var distinct: i64 = 1
    while i < 2000 {
        let u = sample_uniform()
        if u < 0.0 { in_range = 0 }
        if u >= 1.0 { in_range = 0 }
        if u == prev { distinct = 0 }
        prev = u
        sum = sum + u
        i = i + 1
    }
    let mean = sum / 2000.0
    var ok: i64 = 1
    if in_range == 0 { ok = 0 }
    if distinct == 0 { ok = 0 }
    if mean < 0.46 { ok = 0 }
    if mean > 0.54 { ok = 0 }
    if ok == 1 { print("sample_uniform_native: PASS\n") } else { print("sample_uniform_native: FAIL mean="); print_f64(mean); print("\n") }
}
