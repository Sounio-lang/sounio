//@ run-pass
// test_integral_eq.sio -- Tests for integral equations module
//
// Tests:
//  1.  GL nodes symmetric
//  2.  GL weights sum to 2
//  3.  GL integrates x^2 exactly
//  4.  Fredholm 2nd kind with known analytical solution
//  5.  Fredholm 2nd kind residual small
//  6.  Volterra 2nd kind: u'=u => exp(x)
//  7.  Volterra forward marching n_steps
//  8.  Green's function symmetry
//  9.  BVP via Green's: -u''=1
// 10.  Neumann series converges for small lambda
// 11.  Tikhonov regularization produces bounded solution
// 12.  Eigenvalue of K(x,t)=x*t on [0,1]

// ============================================================================
// HELPERS (copied from integral_eq.sio -- tests must be self-contained)
// ============================================================================

fn ie_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn ie_max(a: f64, b: f64) -> f64 { if a > b { a } else { b } }

fn ie_sqrt(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 20 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn ie_exp(x: f64) -> f64 with Mut, Div, Panic {
    if x > 500.0 { return 1.0e200 }
    if x < -500.0 { return 0.0 }
    var kf = x / 0.6931471805599453
    var k: i32 = 0
    if kf >= 0.0 { k = kf as i32 } else { k = (kf as i32) - 1 }
    let r = x - (k as f64) * 0.6931471805599453
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 25 { term = term * r / (n as f64); sum = sum + term; n = n + 1 }
    var result = sum
    if k >= 0 { var i = 0; while i < k { result = result * 2.0; i = i + 1 } }
    else { var i = 0; while i < (0 - k) { result = result / 2.0; i = i + 1 } }
    result
}

fn ie_sin(x: f64) -> f64 with Mut, Div, Panic {
    var a = x
    let tp = 6.28318530717958647692
    while a >= tp { a = a - tp }
    while a < 0.0 { a = a + tp }
    if a > 3.14159265358979323846 { a = a - tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 { term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64; sum = sum + term; n = n + 1 }
    sum
}

fn ie_cos(x: f64) -> f64 with Mut, Div, Panic {
    ie_sin(x + 1.57079632679489661923)
}

fn ie_ln(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 - 1.0e30 }
    if x == 1.0 { return 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 0.5 { m = m * 2.0; e = e - 1 }
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    var sum = t
    var term = t
    var k = 1
    while k < 30 { term = term * t2; sum = sum + term / ((2 * k + 1) as f64); k = k + 1 }
    2.0 * sum + (e as f64) * 0.6931471805599453
}

fn ie_pi() -> f64 { 3.14159265358979323846 }

fn ie_pow(base: f64, exp_val: f64) -> f64 with Mut, Div, Panic {
    if base <= 0.0 { return 0.0 }
    ie_exp(exp_val * ie_ln(base))
}

// ============================================================================
// LINEAR ALGEBRA HELPERS
// ============================================================================

fn ie_dot(a: &[f64; 128], b: &[f64; 128], n: i32) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var i = 0
    while i < n { sum = sum + a[i] * b[i]; i = i + 1 }
    sum
}

fn ie_mat_vec(A: &[f64; 512], x: &[f64; 128], y: &![f64; 128], m: i32, n: i32) with Mut, Div, Panic {
    var i = 0
    while i < m {
        var sum = 0.0
        var j = 0
        while j < n { sum = sum + A[i * n + j] * x[j]; j = j + 1 }
        y[i] = sum
        i = i + 1
    }
}

fn ie_gauss_solve(A: &![f64; 512], b: &![f64; 128], x: &![f64; 128], n: i32) with Mut, Div, Panic {
    var col = 0
    while col < n {
        var max_val = ie_abs(A[col * n + col])
        var max_row = col
        var row = col + 1
        while row < n {
            let v = ie_abs(A[row * n + col])
            if v > max_val { max_val = v; max_row = row }
            row = row + 1
        }
        if max_row != col {
            var j = 0
            while j < n {
                let tmp = A[col * n + j]
                A[col * n + j] = A[max_row * n + j]
                A[max_row * n + j] = tmp
                j = j + 1
            }
            let tmp_b = b[col]
            b[col] = b[max_row]
            b[max_row] = tmp_b
        }
        let pivot = A[col * n + col]
        if ie_abs(pivot) < 1.0e-30 {
            col = col + 1
        } else {
            row = col + 1
            while row < n {
                let factor = A[row * n + col] / pivot
                var j = col + 1
                while j < n {
                    A[row * n + j] = A[row * n + j] - factor * A[col * n + j]
                    j = j + 1
                }
                A[row * n + col] = 0.0
                b[row] = b[row] - factor * b[col]
                row = row + 1
            }
            col = col + 1
        }
    }
    var k = n - 1
    while k >= 0 {
        var s = b[k]
        var j = k + 1
        while j < n { s = s - A[k * n + j] * x[j]; j = j + 1 }
        if ie_abs(A[k * n + k]) > 1.0e-30 {
            x[k] = s / A[k * n + k]
        } else {
            x[k] = 0.0
        }
        k = k - 1
    }
}

// ============================================================================
// RESULT STRUCTS
// ============================================================================

struct IEResult {
    u: [f64; 128],
    nodes: [f64; 128],
    weights: [f64; 128],
    n: i32,
    residual: f64,
    converged: bool
}

struct IEEigenResult {
    eigenvalues: [f64; 64],
    eigenvectors: [f64; 512],
    n_found: i32,
    n_quad: i32
}

// ============================================================================
// GAUSS-LEGENDRE QUADRATURE
// ============================================================================

fn ie_gauss_legendre(n: i32, nodes: &![f64; 128], weights: &![f64; 128]) with Mut, Div, Panic {
    let n_half = (n + 1) / 2
    var i = 0
    while i < n_half {
        var x = ie_cos(ie_pi() * ((i as f64) + 0.75) / ((n as f64) + 0.5))
        var iter = 0
        while iter < 50 {
            var p0 = 1.0
            var p1 = x
            var k = 1
            while k < n {
                let p2 = ((2 * k + 1) as f64 * x * p1 - (k as f64) * p0) / ((k + 1) as f64)
                p0 = p1
                p1 = p2
                k = k + 1
            }
            let dp = (n as f64) * (x * p1 - p0) / (x * x - 1.0)
            let dx = p1 / dp
            x = x - dx
            if ie_abs(dx) < 1.0e-15 { iter = 50 }
            iter = iter + 1
        }
        nodes[i] = 0.0 - x
        nodes[n - 1 - i] = x
        var p0w = 1.0
        var p1w = x
        var k = 1
        while k < n {
            let p2 = ((2 * k + 1) as f64 * x * p1w - (k as f64) * p0w) / ((k + 1) as f64)
            p0w = p1w
            p1w = p2
            k = k + 1
        }
        let dpw = (n as f64) * (x * p1w - p0w) / (x * x - 1.0)
        let w = 2.0 / ((1.0 - x * x) * dpw * dpw)
        weights[i] = w
        weights[n - 1 - i] = w
        i = i + 1
    }
}

fn ie_gauss_legendre_ab(a: f64, b: f64, n: i32,
                        nodes: &![f64; 128], weights: &![f64; 128]) with Mut, Div, Panic {
    ie_gauss_legendre(n, nodes, weights)
    let half_len = 0.5 * (b - a)
    let midpoint = 0.5 * (a + b)
    var i = 0
    while i < n {
        nodes[i] = half_len * nodes[i] + midpoint
        weights[i] = weights[i] * half_len
        i = i + 1
    }
}

// ============================================================================
// FREDHOLM 2ND KIND -- NYSTROM
// ============================================================================

fn ie_residual_fredholm2_internal(K: fn(f64, f64) -> f64 with Mut, Div, Panic,
                                  f: fn(f64) -> f64 with Mut, Div, Panic,
                                  lambda: f64, result: &IEResult) -> f64 with Mut, Div, Panic {
    var max_res = 0.0
    var i = 0
    while i < result.n {
        var ku_i = 0.0
        var j = 0
        while j < result.n {
            ku_i = ku_i + result.weights[j] * K(result.nodes[i], result.nodes[j]) * result.u[j]
            j = j + 1
        }
        let expected = f(result.nodes[i]) + lambda * ku_i
        let res_i = ie_abs(result.u[i] - expected)
        if res_i > max_res { max_res = res_i }
        i = i + 1
    }
    max_res
}

fn fredholm2_nystrom(K: fn(f64, f64) -> f64 with Mut, Div, Panic,
                     f: fn(f64) -> f64 with Mut, Div, Panic,
                     a: f64, b: f64, lambda: f64, n: i32,
                     result: &!IEResult) with Mut, Div, Panic {
    ie_gauss_legendre_ab(a, b, n, &!result.nodes, &!result.weights)
    result.n = n
    var mat: [f64; 512] = [0.0; 512]
    var rhs: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n {
        rhs[i] = f(result.nodes[i])
        var j = 0
        while j < n {
            let kval = K(result.nodes[i], result.nodes[j])
            mat[i * n + j] = 0.0 - lambda * result.weights[j] * kval
            if i == j {
                mat[i * n + j] = mat[i * n + j] + 1.0
            }
            j = j + 1
        }
        i = i + 1
    }
    var sol: [f64; 128] = [0.0; 128]
    ie_gauss_solve(&!mat, &!rhs, &!sol, n)
    i = 0
    while i < n { result.u[i] = sol[i]; i = i + 1 }
    result.residual = ie_residual_fredholm2_internal(K, f, lambda, result)
    result.converged = result.residual < 1.0e-10
}

fn fredholm2_eval(K: fn(f64, f64) -> f64 with Mut, Div, Panic,
                  f: fn(f64) -> f64 with Mut, Div, Panic,
                  lambda: f64, result: &IEResult, x: f64) -> f64 with Mut, Div, Panic {
    var sum = 0.0
    var j = 0
    while j < result.n {
        sum = sum + result.weights[j] * K(x, result.nodes[j]) * result.u[j]
        j = j + 1
    }
    f(x) + lambda * sum
}

// ============================================================================
// FREDHOLM 1ST KIND -- TIKHONOV
// ============================================================================

fn fredholm1_tikhonov(K: fn(f64, f64) -> f64 with Mut, Div, Panic,
                      f: fn(f64) -> f64 with Mut, Div, Panic,
                      a: f64, b: f64, alpha: f64, n: i32,
                      result: &!IEResult) with Mut, Div, Panic {
    ie_gauss_legendre_ab(a, b, n, &!result.nodes, &!result.weights)
    result.n = n
    var kmat: [f64; 512] = [0.0; 512]
    var fvec: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n {
        fvec[i] = f(result.nodes[i])
        var j = 0
        while j < n {
            kmat[i * n + j] = result.weights[j] * K(result.nodes[i], result.nodes[j])
            j = j + 1
        }
        i = i + 1
    }
    var ata: [f64; 512] = [0.0; 512]
    var atf: [f64; 128] = [0.0; 128]
    var j = 0
    while j < n {
        var k = 0
        while k < n {
            var sum = 0.0
            i = 0
            while i < n {
                sum = sum + kmat[i * n + j] * kmat[i * n + k] * result.weights[i]
                i = i + 1
            }
            ata[j * n + k] = sum
            k = k + 1
        }
        var sumf = 0.0
        i = 0
        while i < n {
            sumf = sumf + kmat[i * n + j] * fvec[i] * result.weights[i]
            i = i + 1
        }
        atf[j] = sumf
        j = j + 1
    }
    i = 0
    while i < n {
        ata[i * n + i] = ata[i * n + i] + alpha
        i = i + 1
    }
    var sol: [f64; 128] = [0.0; 128]
    ie_gauss_solve(&!ata, &!atf, &!sol, n)
    i = 0
    while i < n { result.u[i] = sol[i]; i = i + 1 }
    var max_res = 0.0
    i = 0
    while i < n {
        var ku_i = 0.0
        j = 0
        while j < n {
            ku_i = ku_i + kmat[i * n + j] * sol[j]
            j = j + 1
        }
        let res_i = ie_abs(ku_i - fvec[i])
        if res_i > max_res { max_res = res_i }
        i = i + 1
    }
    result.residual = max_res
    result.converged = max_res < 1.0e-6
}

// ============================================================================
// VOLTERRA 2ND KIND
// ============================================================================

fn volterra2_solve(K: fn(f64, f64) -> f64 with Mut, Div, Panic,
                   f: fn(f64) -> f64 with Mut, Div, Panic,
                   a: f64, b: f64, n: i32,
                   result: &!IEResult) with Mut, Div, Panic {
    result.n = n
    let h = (b - a) / ((n - 1) as f64)
    var i = 0
    while i < n {
        result.nodes[i] = a + (i as f64) * h
        result.weights[i] = h
        i = i + 1
    }
    result.u[0] = f(a)
    i = 1
    while i < n {
        let xi = result.nodes[i]
        var sum = 0.5 * K(xi, result.nodes[0]) * result.u[0]
        var j = 1
        while j < i {
            sum = sum + K(xi, result.nodes[j]) * result.u[j]
            j = j + 1
        }
        let kii = K(xi, xi)
        let denom = 1.0 - 0.5 * h * kii
        let numer = f(xi) + h * sum
        if ie_abs(denom) < 1.0e-30 {
            result.u[i] = numer
        } else {
            result.u[i] = numer / denom
        }
        i = i + 1
    }
    var max_res = 0.0
    i = 1
    while i < n {
        let xi = result.nodes[i]
        var integral = 0.5 * K(xi, result.nodes[0]) * result.u[0]
        var j = 1
        while j < i {
            integral = integral + K(xi, result.nodes[j]) * result.u[j]
            j = j + 1
        }
        integral = integral + 0.5 * K(xi, result.nodes[i]) * result.u[i]
        integral = integral * h
        let res_i = ie_abs(result.u[i] - f(xi) - integral)
        if res_i > max_res { max_res = res_i }
        i = i + 1
    }
    result.residual = max_res
    result.converged = max_res < 1.0e-8
}

// ============================================================================
// GREEN'S FUNCTION
// ============================================================================

fn greens_poisson_1d(x: f64, t: f64, a: f64, b: f64) -> f64 with Mut, Div, Panic {
    let l = b - a
    if x <= t {
        (b - t) * (x - a) / l
    } else {
        (b - x) * (t - a) / l
    }
}

fn bvp_via_greens(G: fn(f64, f64) -> f64 with Mut, Div, Panic,
                  f: fn(f64) -> f64 with Mut, Div, Panic,
                  a: f64, b: f64, n: i32,
                  result: &!IEResult) with Mut, Div, Panic {
    ie_gauss_legendre_ab(a, b, n, &!result.nodes, &!result.weights)
    result.n = n
    var i = 0
    while i < n {
        let xi = result.nodes[i]
        var sum = 0.0
        var j = 0
        while j < n {
            sum = sum + result.weights[j] * G(xi, result.nodes[j]) * f(result.nodes[j])
            j = j + 1
        }
        result.u[i] = sum
        i = i + 1
    }
    result.residual = 0.0
    result.converged = true
}

// ============================================================================
// EIGENVALUE PROBLEMS
// ============================================================================

fn ie_eigenvalues(K: fn(f64, f64) -> f64 with Mut, Div, Panic,
                  a: f64, b: f64, n_quad: i32, n_eig: i32,
                  result: &!IEEigenResult) with Mut, Div, Panic {
    result.n_quad = n_quad
    result.n_found = 0
    var nodes: [f64; 128] = [0.0; 128]
    var weights: [f64; 128] = [0.0; 128]
    ie_gauss_legendre_ab(a, b, n_quad, &!nodes, &!weights)
    var bmat: [f64; 512] = [0.0; 512]
    var sqrt_w: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n_quad {
        sqrt_w[i] = ie_sqrt(weights[i])
        i = i + 1
    }
    i = 0
    while i < n_quad {
        var j = 0
        while j < n_quad {
            bmat[i * n_quad + j] = sqrt_w[i] * K(nodes[i], nodes[j]) * sqrt_w[j]
            j = j + 1
        }
        i = i + 1
    }
    var eig_idx = 0
    while eig_idx < n_eig {
        if eig_idx >= n_quad { eig_idx = n_eig }
        else {
            var v: [f64; 128] = [0.0; 128]
            i = 0
            while i < n_quad {
                let seed_val = (i as f64) * 0.618033988749895 + (eig_idx as f64) * 1.324717957244746
                v[i] = ie_sin(seed_val * 17.0 + 3.7)
                i = i + 1
            }
            var norm = 0.0
            i = 0
            while i < n_quad { norm = norm + v[i] * v[i]; i = i + 1 }
            norm = ie_sqrt(norm)
            if norm > 1.0e-30 {
                i = 0
                while i < n_quad { v[i] = v[i] / norm; i = i + 1 }
            }
            var lambda_est = 0.0
            var iter = 0
            while iter < 500 {
                var w: [f64; 128] = [0.0; 128]
                i = 0
                while i < n_quad {
                    var s = 0.0
                    var j = 0
                    while j < n_quad { s = s + bmat[i * n_quad + j] * v[j]; j = j + 1 }
                    w[i] = s
                    i = i + 1
                }
                var d = 0
                while d < eig_idx {
                    var proj = 0.0
                    i = 0
                    while i < n_quad {
                        proj = proj + w[i] * result.eigenvectors[d * n_quad + i]
                        i = i + 1
                    }
                    i = 0
                    while i < n_quad {
                        w[i] = w[i] - proj * result.eigenvectors[d * n_quad + i]
                        i = i + 1
                    }
                    d = d + 1
                }
                var lambda_new = 0.0
                i = 0
                while i < n_quad { lambda_new = lambda_new + v[i] * w[i]; i = i + 1 }
                norm = 0.0
                i = 0
                while i < n_quad { norm = norm + w[i] * w[i]; i = i + 1 }
                norm = ie_sqrt(norm)
                if norm < 1.0e-30 {
                    iter = 500
                } else {
                    i = 0
                    while i < n_quad { v[i] = w[i] / norm; i = i + 1 }
                }
                if ie_abs(lambda_new - lambda_est) < 1.0e-12 * ie_max(ie_abs(lambda_new), 1.0) {
                    lambda_est = lambda_new
                    iter = 500
                }
                lambda_est = lambda_new
                iter = iter + 1
            }
            result.eigenvalues[eig_idx] = lambda_est
            i = 0
            while i < n_quad {
                result.eigenvectors[eig_idx * n_quad + i] = v[i]
                i = i + 1
            }
            result.n_found = eig_idx + 1
            eig_idx = eig_idx + 1
        }
    }
}

// ============================================================================
// NEUMANN SERIES
// ============================================================================

fn fredholm2_neumann(K: fn(f64, f64) -> f64 with Mut, Div, Panic,
                     f: fn(f64) -> f64 with Mut, Div, Panic,
                     a: f64, b: f64, lambda: f64, n: i32,
                     max_iter: i32, tol: f64,
                     result: &!IEResult) with Mut, Div, Panic {
    ie_gauss_legendre_ab(a, b, n, &!result.nodes, &!result.weights)
    result.n = n
    var i = 0
    while i < n { result.u[i] = f(result.nodes[i]); i = i + 1 }
    var prev: [f64; 128] = [0.0; 128]
    i = 0
    while i < n { prev[i] = result.u[i]; i = i + 1 }
    var iter = 0
    result.converged = false
    while iter < max_iter {
        var max_diff = 0.0
        i = 0
        while i < n {
            var sum = 0.0
            var j = 0
            while j < n {
                sum = sum + result.weights[j] * K(result.nodes[i], result.nodes[j]) * prev[j]
                j = j + 1
            }
            result.u[i] = f(result.nodes[i]) + lambda * sum
            let diff = ie_abs(result.u[i] - prev[i])
            if diff > max_diff { max_diff = diff }
            i = i + 1
        }
        i = 0
        while i < n { prev[i] = result.u[i]; i = i + 1 }
        if max_diff < tol {
            result.converged = true
            result.residual = max_diff
            return
        }
        iter = iter + 1
    }
    result.residual = ie_residual_fredholm2_internal(K, f, lambda, result)
}

// ============================================================================
// KERNEL / RHS FUNCTIONS FOR TESTS
// ============================================================================

// K(x,t) = x * t  (separable kernel)
fn kernel_xt(x: f64, t: f64) -> f64 with Mut, Div, Panic { x * t }

// f(x) = 1  (constant RHS)
fn rhs_one(x: f64) -> f64 with Mut, Div, Panic { 1.0 }

// K(x,t) = 1 (constant kernel for Volterra: u'=u)
fn kernel_one(x: f64, t: f64) -> f64 with Mut, Div, Panic { 1.0 }

// f(x) = 1 (initial condition for Volterra exp test)
fn rhs_volterra_one(x: f64) -> f64 with Mut, Div, Panic { 1.0 }

// Green's function wrapper for [0,1] Poisson BVP
fn greens_01(x: f64, t: f64) -> f64 with Mut, Div, Panic {
    greens_poisson_1d(x, t, 0.0, 1.0)
}

// Source term f(x) = 1 for the BVP -u'' = 1
fn source_one(x: f64) -> f64 with Mut, Div, Panic { 1.0 }

// K(x,t) = exp(x*t) for Tikhonov test
fn kernel_exp_xt(x: f64, t: f64) -> f64 with Mut, Div, Panic {
    ie_exp(x * t)
}

// RHS for Tikhonov: integral_0^1 exp(x*t) * 1 dt = (exp(x) - 1) / x for x != 0
// For x near 0, use Taylor: 1 + x/2 + x^2/6 + ...
fn rhs_tikhonov(x: f64) -> f64 with Mut, Div, Panic {
    if ie_abs(x) < 1.0e-10 { return 1.0 }
    (ie_exp(x) - 1.0) / x
}

// Small-lambda kernel for Neumann convergence test
fn kernel_small(x: f64, t: f64) -> f64 with Mut, Div, Panic { x * t }

// ============================================================================
// TESTS
// ============================================================================

// Test 1: GL nodes symmetric -- nodes[i] = -nodes[n-1-i]
fn test_gl_nodes_symmetric() -> bool with Mut, Div, Panic {
    let n = 8
    var nodes: [f64; 128] = [0.0; 128]
    var weights: [f64; 128] = [0.0; 128]
    ie_gauss_legendre(n, &!nodes, &!weights)
    var ok = true
    var i = 0
    while i < n {
        let diff = ie_abs(nodes[i] + nodes[n - 1 - i])
        if diff > 1.0e-12 { ok = false }
        i = i + 1
    }
    ok
}

// Test 2: GL weights sum to 2 on [-1,1]
fn test_gl_weights_sum() -> bool with Mut, Div, Panic {
    let n = 12
    var nodes: [f64; 128] = [0.0; 128]
    var weights: [f64; 128] = [0.0; 128]
    ie_gauss_legendre(n, &!nodes, &!weights)
    var sum = 0.0
    var i = 0
    while i < n { sum = sum + weights[i]; i = i + 1 }
    ie_abs(sum - 2.0) < 1.0e-12
}

// Test 3: GL integrates x^2 exactly: integral_{-1}^{1} x^2 dx = 2/3
fn test_gl_integrates_x2() -> bool with Mut, Div, Panic {
    let n = 4
    var nodes: [f64; 128] = [0.0; 128]
    var weights: [f64; 128] = [0.0; 128]
    ie_gauss_legendre(n, &!nodes, &!weights)
    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + weights[i] * nodes[i] * nodes[i]
        i = i + 1
    }
    // 2-point GL is exact for polynomials up to degree 2n-1=3, so 4-point is exact for degree 7
    ie_abs(sum - 2.0 / 3.0) < 1.0e-12
}

// Test 4: Fredholm 2nd kind with known analytical solution
// u(x) = 1 + lambda * integral_0^1 x*t*u(t) dt
// With K(x,t)=x*t and f(x)=1, the solution is u(x) = 1 + lambda*x*C
// where C = integral_0^1 t * u(t) dt = integral_0^1 t*(1 + lambda*t*C) dt
//         = 1/2 + lambda*C/3
// So C(1 - lambda/3) = 1/2, i.e. C = 1 / (2*(1 - lambda/3)) = 3 / (2*(3 - lambda))
// Hence u(x) = 1 + 3*lambda*x / (2*(3 - lambda))
fn test_fredholm2_known_solution() -> bool with Mut, Div, Panic {
    let lambda = 0.5
    let n = 16
    var result = IEResult {
        u: [0.0; 128], nodes: [0.0; 128], weights: [0.0; 128],
        n: 0, residual: 0.0, converged: false
    }
    fredholm2_nystrom(kernel_xt, rhs_one, 0.0, 1.0, lambda, n, &!result)

    // Analytical: u(x) = 1 + 3*0.5*x / (2*(3-0.5)) = 1 + 1.5*x / 5.0 = 1 + 0.3*x
    var max_err = 0.0
    var i = 0
    while i < n {
        let x = result.nodes[i]
        let analytical = 1.0 + 0.3 * x
        let err = ie_abs(result.u[i] - analytical)
        if err > max_err { max_err = err }
        i = i + 1
    }
    max_err < 1.0e-10
}

// Test 5: Fredholm 2nd kind residual is small
fn test_fredholm2_residual_small() -> bool with Mut, Div, Panic {
    let lambda = 0.5
    let n = 16
    var result = IEResult {
        u: [0.0; 128], nodes: [0.0; 128], weights: [0.0; 128],
        n: 0, residual: 0.0, converged: false
    }
    fredholm2_nystrom(kernel_xt, rhs_one, 0.0, 1.0, lambda, n, &!result)
    result.residual < 1.0e-6
}

// Test 6: Volterra 2nd kind: u(x) = 1 + integral_0^x u(t) dt => u(x) = exp(x)
fn test_volterra2_exp() -> bool with Mut, Div, Panic {
    let n = 64
    var result = IEResult {
        u: [0.0; 128], nodes: [0.0; 128], weights: [0.0; 128],
        n: 0, residual: 0.0, converged: false
    }
    volterra2_solve(kernel_one, rhs_volterra_one, 0.0, 1.0, n, &!result)

    // Check at several interior nodes
    var max_err = 0.0
    var i = 0
    while i < n {
        let x = result.nodes[i]
        let exact = ie_exp(x)
        let err = ie_abs(result.u[i] - exact) / exact
        if err > max_err { max_err = err }
        i = i + 1
    }
    // Trapezoidal rule is O(h^2) so with 64 points on [0,1], h ~ 0.016, error ~ 2.5e-4
    max_err < 1.0e-2
}

// Test 7: Volterra forward marching -- result.n equals the number of steps passed in
fn test_volterra_n_steps() -> bool with Mut, Div, Panic {
    let n = 32
    var result = IEResult {
        u: [0.0; 128], nodes: [0.0; 128], weights: [0.0; 128],
        n: 0, residual: 0.0, converged: false
    }
    volterra2_solve(kernel_one, rhs_volterra_one, 0.0, 1.0, n, &!result)
    result.n == 32
}

// Test 8: Green's function symmetry: G(x,t) = G(t,x) for Poisson 1D on [0,1]
fn test_greens_symmetry() -> bool with Mut, Div, Panic {
    var ok = true
    // Test several pairs (x,t)
    var i = 1
    while i < 10 {
        let x = (i as f64) * 0.1
        var j = 1
        while j < 10 {
            let t = (j as f64) * 0.1
            let gxt = greens_poisson_1d(x, t, 0.0, 1.0)
            let gtx = greens_poisson_1d(t, x, 0.0, 1.0)
            if ie_abs(gxt - gtx) > 1.0e-14 { ok = false }
            j = j + 1
        }
        i = i + 1
    }
    ok
}

// Test 9: BVP via Green's: -u'' = 1 on [0,1], u(0)=u(1)=0
// Exact solution: u(x) = x*(1-x)/2
fn test_bvp_greens() -> bool with Mut, Div, Panic {
    let n = 20
    var result = IEResult {
        u: [0.0; 128], nodes: [0.0; 128], weights: [0.0; 128],
        n: 0, residual: 0.0, converged: false
    }
    bvp_via_greens(greens_01, source_one, 0.0, 1.0, n, &!result)

    var max_err = 0.0
    var i = 0
    while i < n {
        let x = result.nodes[i]
        let exact = x * (1.0 - x) / 2.0
        let err = ie_abs(result.u[i] - exact)
        if err > max_err { max_err = err }
        i = i + 1
    }
    // GL over [0,1] without splitting at t=x achieves O(1/n²) ≈ 2.5e-3 for piecewise-linear G.
    max_err < 1.0e-2
}

// Test 10: Neumann series converges for small lambda
// For K(x,t)=x*t on [0,1], ||K|| ~ 1/3, so |lambda|*||K|| < 1 when |lambda| < 3.
// Use lambda = 0.5, which gives |lambda|*||K|| ~ 0.167 < 1.
fn test_neumann_convergence() -> bool with Mut, Div, Panic {
    let lambda = 0.5
    let n = 16
    var result = IEResult {
        u: [0.0; 128], nodes: [0.0; 128], weights: [0.0; 128],
        n: 0, residual: 0.0, converged: false
    }
    fredholm2_neumann(kernel_small, rhs_one, 0.0, 1.0, lambda, n, 200, 1.0e-10, &!result)
    result.converged
}

// Test 11: Tikhonov regularization produces bounded solution
// Solve integral_0^1 exp(x*t)*u(t) dt = (exp(x)-1)/x with true solution u(t) = 1.
// The regularized solution should be close to 1 at all nodes.
fn test_tikhonov_bounded() -> bool with Mut, Div, Panic {
    let n = 12
    let alpha = 1.0e-6
    var result = IEResult {
        u: [0.0; 128], nodes: [0.0; 128], weights: [0.0; 128],
        n: 0, residual: 0.0, converged: false
    }
    fredholm1_tikhonov(kernel_exp_xt, rhs_tikhonov, 0.0, 1.0, alpha, n, &!result)

    // The solution should be bounded and roughly close to 1.0
    var max_val = 0.0
    var i = 0
    while i < n {
        let v = ie_abs(result.u[i])
        if v > max_val { max_val = v }
        i = i + 1
    }
    // The solution values should not blow up; they should remain bounded
    max_val < 100.0
}

// Test 12: Eigenvalue of K(x,t) = x*t on [0,1]
// This rank-1 kernel has exactly one nonzero eigenvalue.
// integral_0^1 x*t * phi(t) dt = lambda * phi(x)
// The eigenfunction is phi(t) = t, and lambda = integral_0^1 t^2 dt = 1/3.
fn test_eigenvalue_xt() -> bool with Mut, Div, Panic {
    var result = IEEigenResult {
        eigenvalues: [0.0; 64],
        eigenvectors: [0.0; 512],
        n_found: 0,
        n_quad: 0
    }
    ie_eigenvalues(kernel_xt, 0.0, 1.0, 20, 1, &!result)

    if result.n_found < 1 { return false }
    let lambda1 = result.eigenvalues[0]
    // The dominant eigenvalue should be 1/3
    ie_abs(lambda1 - 1.0 / 3.0) < 1.0e-4
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    println("=== Integral Equations Tests ===")
    println("")

    // Test 1
    print("Test  1: GL nodes symmetric .................. ")
    if test_gl_nodes_symmetric() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 2
    print("Test  2: GL weights sum to 2 ................. ")
    if test_gl_weights_sum() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 3
    print("Test  3: GL integrates x^2 exactly ........... ")
    if test_gl_integrates_x2() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 4
    print("Test  4: Fredholm 2nd kind known solution ..... ")
    if test_fredholm2_known_solution() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 5
    print("Test  5: Fredholm 2nd kind residual small ..... ")
    if test_fredholm2_residual_small() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 6
    print("Test  6: Volterra 2nd kind exp(x) ............ ")
    if test_volterra2_exp() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 7
    print("Test  7: Volterra forward marching n_steps .... ")
    if test_volterra_n_steps() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 8
    print("Test  8: Green's function symmetry ........... ")
    if test_greens_symmetry() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 9
    print("Test  9: BVP via Green's -u''=1 .............. ")
    if test_bvp_greens() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 10
    print("Test 10: Neumann series converges ............. ")
    if test_neumann_convergence() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 11
    print("Test 11: Tikhonov bounded solution ............ ")
    if test_tikhonov_bounded() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 12
    print("Test 12: Eigenvalue of K(x,t)=x*t ............ ")
    if test_eigenvalue_xt() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    println("")
    print("Results: ")
    println("")
    print("  Passed: ")
    println("")
    print("  Failed: ")
    println("")

    if fail > 0 { return 1 }
    return 0
}
