//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 787
    fp = mix(fp, 6, 4363)
    fp = mix(fp, 963265870, 4363)
    fp = mix(fp, 344106968, 4363)
    fp = mix(fp, 956152878, 4363)
    fp = mix(fp, 916252082, 4363)
    fp = mix(fp, 652877359, 4363)
    fp = mix(fp, 344816971, 4363)
    fp = mix(fp, 46888150, 4363)
    fp = mix(fp, 47662713, 4363)
    fp = mix(fp, 7699049, 4363)
    fp = mix(fp, 1, 4363)
    fp = mix(fp, 100, 4363)
    fp = mix(fp, 468882, 4363)
    fp = mix(fp, 476628, 4363)
    fp = mix(fp, 76991, 4363)
    fp = mix(fp, 470000, 4363)
    fp = mix(fp, 477000, 4363)
    fp = mix(fp, 80000, 4363)
    fp = mix(fp, 1118, 4363)
    fp = mix(fp, 372, 4363)
    fp = mix(fp, 3009, 4363)
    fp = mix(fp, 7, 4363)
    fp = mix(fp, 7, 4363)
    fp = mix(fp, 0, 4363)
    fp = mix(fp, 13, 4363)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 612699967 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 797
    fp = mix(fp, instance, 4373)
    fp = mix(fp, 46888150, 4373)
    fp = mix(fp, 47662713, 4373)
    fp = mix(fp, 7699049, 4373)
    fp = mix(fp, 1, 4373)
    fp = mix(fp, 100, 4373)
    fp = mix(fp, 468882, 4373)
    fp = mix(fp, 476628, 4373)
    fp = mix(fp, 76991, 4373)
    fp = mix(fp, 470000, 4373)
    fp = mix(fp, 477000, 4373)
    fp = mix(fp, 80000, 4373)
    fp = mix(fp, 1118, 4373)
    fp = mix(fp, 372, 4373)
    fp = mix(fp, 3009, 4373)
    fp = mix(fp, 7, 4373)
    fp = mix(fp, 7, 4373)
    fp = mix(fp, 0, 4373)
    fp = mix(fp, 13, 4373)
    fp = mix(fp, ok_mask, 4373)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 612699967 { return 0 - 1 }
    if certificate != 57659327 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 809
    fp = mix(fp, instance, 4391)
    fp = mix(fp, certificate, 4391)
    fp = mix(fp, 14, 4391)
    fp = mix(fp, 6, 4391)
    fp = mix(fp, 7, 4391)
    fp = mix(fp, 7, 4391)
    fp = mix(fp, 0, 4391)
    fp = mix(fp, 13, 4391)
    fp = mix(fp, ok_mask, 4391)
    return fp
}

fn time_slab_mask() -> i64 {
    let dx_bound: i64 = 46888150
    let dy_bound: i64 = 47662713
    let dz_bound: i64 = 7699049
    let dt_den: i64 = 100
    let x_sweep: i64 = 468882
    let y_sweep: i64 = 476628
    let z_sweep: i64 = 76991
    let x_margin: i64 = 470000
    let y_margin: i64 = 477000
    let z_margin: i64 = 80000
    let x_slack: i64 = x_margin - x_sweep
    let y_slack: i64 = y_margin - y_sweep
    let z_slack: i64 = z_margin - z_sweep

    var slab_mask: i64 = 0
    if x_sweep <= x_margin { slab_mask = slab_mask + 1 }
    if y_sweep <= y_margin { slab_mask = slab_mask + 2 }
    if z_sweep <= z_margin { slab_mask = slab_mask + 4 }

    var ok_mask: i64 = 0
    if 963265870 > 0 {
        if 956152878 > 0 { ok_mask = ok_mask + 1 }
    }
    if 652877359 > 0 { ok_mask = ok_mask + 2 }
    if (x_sweep - 1) * dt_den < dx_bound {
        if x_sweep * dt_den >= dx_bound {
            if (y_sweep - 1) * dt_den < dy_bound {
                if y_sweep * dt_den >= dy_bound {
                    if (z_sweep - 1) * dt_den < dz_bound {
                        if z_sweep * dt_den >= dz_bound { ok_mask = ok_mask + 4 }
                    }
                }
            }
        }
    }
    if slab_mask == 7 {
        if x_slack == 1118 {
            if y_slack == 372 {
                if z_slack == 3009 { ok_mask = ok_mask + 8 }
            }
        }
    }
    if 1 == 1 {
        if dt_den == 100 { ok_mask = ok_mask + 16 }
    }
    if slab_mask == 7 {
        if 13 == 13 { ok_mask = ok_mask + 32 }
    }
    if 0 == 0 { ok_mask = ok_mask + 64 }
    if 963265870 == 963265870 {
        if slab_mask == 7 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = time_slab_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 612699967 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 57659327 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 230532791 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
