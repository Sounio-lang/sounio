//@ run-pass
//@ requires: madaros

// TLS plan closeout: `x509_verify_signature` used to unconditionally
// reject any non-RSA signature algorithm ("see spec Non-Goals (no
// ECDSA/Ed25519)"), even though this same plan's earlier tasks already
// built full ECDSA P-256 verification (`stdlib/crypto/ecdsa_p256.sio`'s
// `ecdsa_p256_verify`) and EC public-key parsing
// (`Certificate.public_key_algorithm`/`.ec_public_key`). This test proves
// the closed gap: a REAL, openssl-signed self-signed ECDSA P-256
// certificate now verifies end-to-end through `x509_verify_chain`, where
// it previously would have failed with `CHAIN_ERR_BAD_SIGNATURE` (the old
// `x509_verify_signature` returning `false` for every ECDSA cert,
// regardless of whether the signature was actually valid).
//
// Fixture generation (2026-08-26):
//   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
//     -keyout ecdsa_chain_test_key.pem -out ecdsa_chain_test_cert.pem \
//     -days 3650 -nodes -subj "/CN=ecdsa-chain-test" \
//     -addext "subjectAltName=DNS:ecdsa-chain-test.example" \
//     -addext "basicConstraints=critical,CA:TRUE"
//   openssl x509 -in ecdsa_chain_test_cert.pem -outform DER \
//     -out ecdsa_chain_test_cert.der   # 435 bytes
//
// `openssl x509 -in ecdsa_chain_test_cert.pem -noout -text` confirms:
//   Signature Algorithm: ecdsa-with-SHA256 (both outer and TBS-inner copies)
//   Subject Public Key Info: id-ecPublicKey, ASN1 OID: prime256v1 (P-256)
//   Subject Alternative Name: DNS:ecdsa-chain-test.example
//   Basic Constraints: critical, CA:TRUE
//   Not Before: Aug 26 09:28:55 2026 GMT / Not After: Aug 23 09:28:55 2036 GMT
//
// DER bytes below are the real pipeline output, converted to a Sounio
// byte-array literal with a short Python script (equivalent to `xxd -i`).
// The "bad" variant flips exactly one byte inside the outer ECDSA
// signature's DER SEQUENCE (index 390 of 435, inside the `s` INTEGER),
// leaving every other byte -- including the TBSCertificate -- identical.

use x509::chain::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

fn main() -> i64 with IO, Mut {
    let cert_der_len: i64 = 435
    let cert_der_bytes: [u8; 435] = [
        0x30, 0x82, 0x01, 0xAF, 0x30, 0x82, 0x01, 0x56, 0xA0, 0x03, 0x02, 0x01,
        0x02, 0x02, 0x14, 0x22, 0x3B, 0x34, 0xDA, 0xFE, 0x66, 0xE0, 0xAD, 0xE3,
        0x13, 0xB7, 0xBD, 0x92, 0x8C, 0x85, 0xD6, 0x6C, 0xB8, 0x05, 0xF4, 0x30,
        0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x30,
        0x1B, 0x31, 0x19, 0x30, 0x17, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C, 0x10,
        0x65, 0x63, 0x64, 0x73, 0x61, 0x2D, 0x63, 0x68, 0x61, 0x69, 0x6E, 0x2D,
        0x74, 0x65, 0x73, 0x74, 0x30, 0x1E, 0x17, 0x0D, 0x32, 0x36, 0x30, 0x38,
        0x32, 0x36, 0x30, 0x39, 0x32, 0x38, 0x35, 0x35, 0x5A, 0x17, 0x0D, 0x33,
        0x36, 0x30, 0x38, 0x32, 0x33, 0x30, 0x39, 0x32, 0x38, 0x35, 0x35, 0x5A,
        0x30, 0x1B, 0x31, 0x19, 0x30, 0x17, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C,
        0x10, 0x65, 0x63, 0x64, 0x73, 0x61, 0x2D, 0x63, 0x68, 0x61, 0x69, 0x6E,
        0x2D, 0x74, 0x65, 0x73, 0x74, 0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2A,
        0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE,
        0x3D, 0x03, 0x01, 0x07, 0x03, 0x42, 0x00, 0x04, 0xC3, 0x7C, 0x24, 0x51,
        0x38, 0x86, 0xC3, 0xEB, 0xD1, 0x10, 0xF4, 0x6F, 0x01, 0x22, 0x24, 0xEC,
        0x6F, 0x34, 0x04, 0x05, 0x33, 0x1B, 0xDA, 0x77, 0x40, 0x20, 0xB4, 0x2D,
        0xA6, 0x5E, 0x5A, 0xB0, 0xC0, 0x50, 0x73, 0x1B, 0x7B, 0xDA, 0x88, 0xE5,
        0x40, 0xDE, 0xF2, 0xAF, 0x1C, 0x29, 0xA8, 0xEA, 0x96, 0x70, 0x5E, 0x60,
        0x90, 0xAF, 0xB4, 0x60, 0x61, 0x9C, 0x30, 0x2B, 0xB2, 0x69, 0xA3, 0xA3,
        0xA3, 0x78, 0x30, 0x76, 0x30, 0x1D, 0x06, 0x03, 0x55, 0x1D, 0x0E, 0x04,
        0x16, 0x04, 0x14, 0x76, 0xBA, 0x68, 0x7E, 0x2F, 0x93, 0xAF, 0x10, 0xBC,
        0x45, 0xFF, 0xDE, 0xAB, 0x48, 0xB8, 0xEF, 0xF6, 0xE4, 0x43, 0x0B, 0x30,
        0x1F, 0x06, 0x03, 0x55, 0x1D, 0x23, 0x04, 0x18, 0x30, 0x16, 0x80, 0x14,
        0x76, 0xBA, 0x68, 0x7E, 0x2F, 0x93, 0xAF, 0x10, 0xBC, 0x45, 0xFF, 0xDE,
        0xAB, 0x48, 0xB8, 0xEF, 0xF6, 0xE4, 0x43, 0x0B, 0x30, 0x23, 0x06, 0x03,
        0x55, 0x1D, 0x11, 0x04, 0x1C, 0x30, 0x1A, 0x82, 0x18, 0x65, 0x63, 0x64,
        0x73, 0x61, 0x2D, 0x63, 0x68, 0x61, 0x69, 0x6E, 0x2D, 0x74, 0x65, 0x73,
        0x74, 0x2E, 0x65, 0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65, 0x30, 0x0F, 0x06,
        0x03, 0x55, 0x1D, 0x13, 0x01, 0x01, 0xFF, 0x04, 0x05, 0x30, 0x03, 0x01,
        0x01, 0xFF, 0x30, 0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04,
        0x03, 0x02, 0x03, 0x47, 0x00, 0x30, 0x44, 0x02, 0x20, 0x57, 0x7C, 0xA8,
        0x5B, 0x52, 0xA1, 0x4A, 0x75, 0x2D, 0x98, 0xA6, 0x78, 0x5D, 0x55, 0x11,
        0xDA, 0x82, 0x91, 0xF4, 0xA9, 0xAF, 0x17, 0xCC, 0x30, 0x9A, 0x1B, 0x94,
        0xDE, 0x93, 0xD8, 0x08, 0x78, 0x02, 0x20, 0x37, 0xB4, 0x2A, 0xFE, 0x22,
        0x0B, 0xA1, 0x7F, 0xAB, 0xE7, 0x22, 0x83, 0x7D, 0x05, 0xB2, 0x1D, 0xF1,
        0x7E, 0x0F, 0xDB, 0xC5, 0x4E, 0x21, 0xCB, 0x5C, 0xBB, 0xCE, 0x2D, 0xE5,
        0x8A, 0xDE, 0xA9,
    ]

    // Same bytes with exactly one bit flipped at index 390 (inside the
    // outer ECDSA signature's `s` INTEGER: 0xAF -> 0xAE) -- everything
    // else, including the TBSCertificate, is byte-identical.
    let bad_der_bytes: [u8; 435] = [
        0x30, 0x82, 0x01, 0xAF, 0x30, 0x82, 0x01, 0x56, 0xA0, 0x03, 0x02, 0x01,
        0x02, 0x02, 0x14, 0x22, 0x3B, 0x34, 0xDA, 0xFE, 0x66, 0xE0, 0xAD, 0xE3,
        0x13, 0xB7, 0xBD, 0x92, 0x8C, 0x85, 0xD6, 0x6C, 0xB8, 0x05, 0xF4, 0x30,
        0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x30,
        0x1B, 0x31, 0x19, 0x30, 0x17, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C, 0x10,
        0x65, 0x63, 0x64, 0x73, 0x61, 0x2D, 0x63, 0x68, 0x61, 0x69, 0x6E, 0x2D,
        0x74, 0x65, 0x73, 0x74, 0x30, 0x1E, 0x17, 0x0D, 0x32, 0x36, 0x30, 0x38,
        0x32, 0x36, 0x30, 0x39, 0x32, 0x38, 0x35, 0x35, 0x5A, 0x17, 0x0D, 0x33,
        0x36, 0x30, 0x38, 0x32, 0x33, 0x30, 0x39, 0x32, 0x38, 0x35, 0x35, 0x5A,
        0x30, 0x1B, 0x31, 0x19, 0x30, 0x17, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0C,
        0x10, 0x65, 0x63, 0x64, 0x73, 0x61, 0x2D, 0x63, 0x68, 0x61, 0x69, 0x6E,
        0x2D, 0x74, 0x65, 0x73, 0x74, 0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2A,
        0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE,
        0x3D, 0x03, 0x01, 0x07, 0x03, 0x42, 0x00, 0x04, 0xC3, 0x7C, 0x24, 0x51,
        0x38, 0x86, 0xC3, 0xEB, 0xD1, 0x10, 0xF4, 0x6F, 0x01, 0x22, 0x24, 0xEC,
        0x6F, 0x34, 0x04, 0x05, 0x33, 0x1B, 0xDA, 0x77, 0x40, 0x20, 0xB4, 0x2D,
        0xA6, 0x5E, 0x5A, 0xB0, 0xC0, 0x50, 0x73, 0x1B, 0x7B, 0xDA, 0x88, 0xE5,
        0x40, 0xDE, 0xF2, 0xAF, 0x1C, 0x29, 0xA8, 0xEA, 0x96, 0x70, 0x5E, 0x60,
        0x90, 0xAF, 0xB4, 0x60, 0x61, 0x9C, 0x30, 0x2B, 0xB2, 0x69, 0xA3, 0xA3,
        0xA3, 0x78, 0x30, 0x76, 0x30, 0x1D, 0x06, 0x03, 0x55, 0x1D, 0x0E, 0x04,
        0x16, 0x04, 0x14, 0x76, 0xBA, 0x68, 0x7E, 0x2F, 0x93, 0xAF, 0x10, 0xBC,
        0x45, 0xFF, 0xDE, 0xAB, 0x48, 0xB8, 0xEF, 0xF6, 0xE4, 0x43, 0x0B, 0x30,
        0x1F, 0x06, 0x03, 0x55, 0x1D, 0x23, 0x04, 0x18, 0x30, 0x16, 0x80, 0x14,
        0x76, 0xBA, 0x68, 0x7E, 0x2F, 0x93, 0xAF, 0x10, 0xBC, 0x45, 0xFF, 0xDE,
        0xAB, 0x48, 0xB8, 0xEF, 0xF6, 0xE4, 0x43, 0x0B, 0x30, 0x23, 0x06, 0x03,
        0x55, 0x1D, 0x11, 0x04, 0x1C, 0x30, 0x1A, 0x82, 0x18, 0x65, 0x63, 0x64,
        0x73, 0x61, 0x2D, 0x63, 0x68, 0x61, 0x69, 0x6E, 0x2D, 0x74, 0x65, 0x73,
        0x74, 0x2E, 0x65, 0x78, 0x61, 0x6D, 0x70, 0x6C, 0x65, 0x30, 0x0F, 0x06,
        0x03, 0x55, 0x1D, 0x13, 0x01, 0x01, 0xFF, 0x04, 0x05, 0x30, 0x03, 0x01,
        0x01, 0xFF, 0x30, 0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04,
        0x03, 0x02, 0x03, 0x47, 0x00, 0x30, 0x44, 0x02, 0x20, 0x57, 0x7C, 0xA8,
        0x5B, 0x52, 0xA1, 0x4A, 0x75, 0x2D, 0x98, 0xA6, 0x78, 0x5D, 0x55, 0x11,
        0xDA, 0x82, 0x91, 0xF4, 0xA9, 0xAF, 0x16, 0xCC, 0x30, 0x9A, 0x1B, 0x94,
        0xDE, 0x93, 0xD8, 0x08, 0x78, 0x02, 0x20, 0x37, 0xB4, 0x2A, 0xFE, 0x22,
        0x0B, 0xA1, 0x7F, 0xAB, 0xE7, 0x22, 0x83, 0x7D, 0x05, 0xB2, 0x1D, 0xF1,
        0x7E, 0x0F, 0xDB, 0xC5, 0x4E, 0x21, 0xCB, 0x5C, 0xBB, 0xCE, 0x2D, 0xE5,
        0x8A, 0xDE, 0xA9,
    ]

    let good_buf = rawbuf_new(cert_der_len + 8)
    var i: i64 = 0
    while i < cert_der_len { rawbuf_set(&good_buf, i, cert_der_bytes[i as usize] as i64); i = i + 1 }

    let bad_buf = rawbuf_new(cert_der_len + 8)
    var j: i64 = 0
    while j < cert_der_len { rawbuf_set(&bad_buf, j, bad_der_bytes[j as usize] as i64); j = j + 1 }

    var good_cert = certificate_zero()
    let (good_cert_raw, e1) = x509_parse_certificate(&good_buf, cert_der_len)
    good_cert = good_cert_raw
    if e1 != X509_OK { print_int(1); return 1 }

    var bad_cert = certificate_zero()
    let (bad_cert_raw, e2) = x509_parse_certificate(&bad_buf, cert_der_len)
    bad_cert = bad_cert_raw
    if e2 != X509_OK { print_int(2); return 1 }

    if good_cert.public_key_algorithm != PUBKEY_ALG_EC_P256 { print_int(3); return 1 }
    assert(good_cert.public_key_algorithm == PUBKEY_ALG_EC_P256)

    // ---- Direct x509_verify_signature: real ECDSA P-256 signature over
    // real TBS bytes must verify against its own (self-signed) public key.
    let sig_ok = x509_verify_signature(&good_buf, &good_cert, &good_cert)
    if sig_ok == false { print_int(4); return 1 }
    assert(sig_ok)

    // ---- Corrupted signature (one flipped byte inside the DER
    // ECDSA-Sig-Value) must NOT verify, even though the TBS bytes and
    // issuer key are unchanged. ----
    let sig_bad = x509_verify_signature(&bad_buf, &bad_cert, &good_cert)
    if sig_bad == true { print_int(5); return 1 }
    assert(sig_bad == false)

    // ---- Full chain verification: trust this exact self-signed ECDSA
    // certificate as its own root, with zero intermediates. Before this
    // task, this would have failed with CHAIN_ERR_BAD_SIGNATURE (the old
    // x509_verify_signature returned false unconditionally for any
    // non-RSA signature algorithm).
    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = good_cert
    store.bufs[0] = good_buf

    var intermediates: [Certificate; 8] = [certificate_zero(); 8]
    var intermediate_bufs: [RawBuf; 8] = [rawbuf_new(1); 8]

    // "ecdsa-chain-test.example" (24 bytes), padded to 32 with zero bytes.
    let hostname_text: [u8; 32] = [
        101,99,100,115,97,45,99,104,97,105,110,45,116,101,115,116,46,101,120,97,109,112,108,101,
        0,0,0,0,0,0,0,0
    ]
    let hostname_len: i64 = 24
    let hostname_buf = rawbuf_new(32)
    var h: i64 = 0
    while h < hostname_len { rawbuf_set(&hostname_buf, h, hostname_text[h as usize] as i64); h = h + 1 }

    // A fixed timestamp inside the cert's validity window (captured via
    // `date -u +%s` right after generating the fixture; notBefore
    // 2026-08-26 09:28:55 UTC, notAfter 2036-08-23 09:28:55 UTC).
    let now_unix: i64 = 1787740000

    let result = x509_verify_chain(&good_cert, &good_buf, &intermediates, &intermediate_bufs, 0, &store, &hostname_buf, hostname_len, now_unix, &rawbuf_new(1), 0)
    if result != CHAIN_OK {
        print_int(result)
        return 1
    }
    assert(result == CHAIN_OK)

    // ---- The same chain, but with the corrupted-signature certificate as
    // the leaf, must be rejected (CHAIN_ERR_BAD_SIGNATURE), not silently
    // accepted. ----
    let bad_result = x509_verify_chain(&bad_cert, &bad_buf, &intermediates, &intermediate_bufs, 0, &store, &hostname_buf, hostname_len, now_unix, &rawbuf_new(1), 0)
    if bad_result == CHAIN_OK {
        print_int(6)
        return 1
    }
    assert(bad_result != CHAIN_OK)

    println("x509_ecdsa_chain_signature: ECDSA P-256 chain verified, corrupted sig rejected")
    return 0
}
