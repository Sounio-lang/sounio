//@ run-pass
//@ description: ABI-safe Lorenz fixed-point ball primitive smoke with guarded rounding

fn bf_abs64(x: i64) -> i64 {
    if x < 0 { return 0 - x }
    return x
}

fn bf_status_ok(radius: i64, scale: i64, limit: i64) -> i64 {
    if radius < 0 { return 0 }
    if scale <= 0 { return 0 }
    if radius > limit { return 0 }
    return 1
}

fn bf_floor_div_nonneg(n: i64, d: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if d <= 0 { return 0 - 1 }
    return n / d
}

fn bf_ceil_div_nonneg(n: i64, d: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if d <= 0 { return 0 - 1 }
    return (n + d - 1) / d
}

fn bf_mul_radius_guarded(abs_x: i64, rx: i64, abs_y: i64, ry: i64, scale: i64) -> i64 with Div {
    if abs_x < 0 { return 0 - 1 }
    if abs_y < 0 { return 0 - 1 }
    if bf_status_ok(rx, scale, 1000000000) == 0 { return 0 - 1 }
    if bf_status_ok(ry, scale, 1000000000) == 0 { return 0 - 1 }

    let total: i64 = (abs_x * ry) + (abs_y * rx) + (rx * ry)
    return bf_floor_div_nonneg(total, scale) + 1
}

fn bf_beta_radius_tight(zr: i64) -> i64 with Div {
    if zr < 0 { return 0 - 1 }
    return ((8 * zr) + 2) / 3
}

fn bf_beta_radius_guarded(zr: i64) -> i64 with Div {
    if zr < 0 { return 0 - 1 }
    return bf_beta_radius_tight(zr) + 1
}

fn bf_euler_radius_guarded(radius: i64, derivative_radius: i64, dt: i64, scale: i64) -> i64 with Div {
    if bf_status_ok(radius, scale, 1000000000) == 0 { return 0 - 1 }
    if derivative_radius < 0 { return 0 - 1 }
    if dt < 0 { return 0 - 1 }

    return radius + bf_floor_div_nonneg(dt * derivative_radius, scale) + 1
}

fn bf_lo(center: i64, radius: i64) -> i64 {
    return center - radius
}

fn bf_hi(center: i64, radius: i64) -> i64 {
    return center + radius
}

fn main() -> i64 with Div {
    let scale: i64 = 1000000
    let dt: i64 = 10000
    let xr: i64 = 10
    let yr: i64 = 10
    let zr: i64 = 10

    if bf_abs64(0 - 27) != 27 { return 1 }
    if bf_floor_div_nonneg(2000000, scale) != 2 { return 2 }
    if bf_ceil_div_nonneg(80, 3) != 27 { return 3 }
    if bf_status_ok(13, scale, 1000000000) != 1 { return 4 }
    if bf_status_ok(0 - 1, scale, 1000000000) != 0 { return 5 }
    if bf_status_ok(13, 0, 1000000000) != 0 { return 6 }
    if bf_status_ok(1000000001, scale, 1000000000) != 0 { return 7 }

    let dx_rad: i64 = 10 * (yr + xr)
    let x_rhoz_rad: i64 = bf_mul_radius_guarded(1000000, xr, 27000000, zr, scale)
    let dy_rad: i64 = x_rhoz_rad + yr
    let xy_rad: i64 = bf_mul_radius_guarded(1000000, xr, 1000000, yr, scale)
    let beta_z_rad_tight: i64 = bf_beta_radius_tight(zr)
    let beta_z_rad_guarded: i64 = bf_beta_radius_guarded(zr)
    let dz_rad: i64 = xy_rad + beta_z_rad_guarded

    let nx_rad: i64 = bf_euler_radius_guarded(xr, dx_rad, dt, scale)
    let ny_rad: i64 = bf_euler_radius_guarded(yr, dy_rad, dt, scale)
    let nz_rad: i64 = bf_euler_radius_guarded(zr, dz_rad, dt, scale)

    let ny_center: i64 = 1260000
    let ny_lo: i64 = bf_lo(ny_center, ny_rad)
    let ny_hi: i64 = bf_hi(ny_center, ny_rad)

    if dx_rad != 200 { return 8 }
    if x_rhoz_rad != 281 { return 9 }
    if dy_rad != 291 { return 10 }
    if xy_rad != 21 { return 11 }
    if beta_z_rad_tight != 27 { return 12 }
    if beta_z_rad_guarded != 28 { return 13 }
    if dz_rad != 49 { return 14 }
    if nx_rad != 13 { return 15 }
    if ny_rad != 13 { return 16 }
    if nz_rad != 11 { return 17 }
    if ny_lo != 1259987 { return 18 }
    if ny_hi != 1260013 { return 19 }

    return 0
}
