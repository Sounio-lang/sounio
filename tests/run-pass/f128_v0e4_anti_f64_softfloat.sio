//@ run-pass
//@ description: V0-E.4 — execute stdlib wide_float exact-case add/sub (anti-f64)
//@ ladder-stage: V0-E.4
//@ semantic-lane: WS-G-V0E-STDLIB-GUM-SURFACE
//@ claim-clock: sounio_native_expected (ADR-008 / ADR-009)
//@ note: softfloat_limb.py is measurement-only; must not judge this claim
//@ note: lean_single language `f128` greenwashes to f64 — not a claim path
//@ note: calls pub f128_bits_exact_case_* from stdlib (not a fixture-local copy)
//
// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0e4

use math::wide_float::{
    F128Bits,
    f128_bits_one,
    f128_bits_two,
    f128_bits_zero,
    f128_bits_approx_1e_neg20,
    f128_bits_eq,
    f128_bits_exact_case_add,
    f128_bits_exact_case_sub,
    print_f128_bits_hex_wire,
}

fn f128_one_plus_tiny() -> F128Bits {
    F128Bits { lo: 51922968585348, hi: 4611404543450677248 }
}

fn f128_recover() -> F128Bits {
    F128Bits { lo: 0, hi: 4592679628783035424 }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let one = f128_bits_one()
    let tiny = f128_bits_approx_1e_neg20()
    let sum = f128_bits_exact_case_add(one, tiny)
    if !sum.supported {
        println("FAIL unsupported_1+tiny")
        return 1
    }
    if !f128_bits_eq(sum.bits, f128_one_plus_tiny()) {
        println("FAIL 1+tiny")
        return 1
    }

    let back = f128_bits_exact_case_sub(sum.bits, one)
    if !back.supported {
        println("FAIL unsupported_recover")
        return 1
    }
    if f128_bits_eq(back.bits, f128_bits_zero()) {
        println("FAIL f64_greenwash")
        return 1
    }
    if !f128_bits_eq(back.bits, f128_recover()) {
        println("FAIL recover_mismatch")
        return 1
    }

    // Outside the tabulated domain must be unsupported — never a silent NaN claim.
    let junk = f128_bits_exact_case_add(f128_bits_two(), tiny)
    if junk.supported {
        println("FAIL unknown_pair_should_be_unsupported")
        return 1
    }

    print("wire_1+tiny=")
    print_f128_bits_hex_wire(sum.bits)
    println("")
    print("wire_recover=")
    print_f128_bits_hex_wire(back.bits)
    println("")

    println("PASS f128_v0e4_anti_f64_softfloat exact_case=stdlib anti_f64=green unsupported=explicit")
    return 0
}
