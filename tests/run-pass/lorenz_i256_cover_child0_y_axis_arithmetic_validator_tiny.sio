//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-0 Y-axis arithmetic validator receipt

fn main() -> i64 {
    let validator_instance: i64 = 278656756
    let validator_certificate: i64 = 11270473
    let validator_artifact: i64 = 99615754
    let validator_audit: i64 = 105297009

    if validator_instance != 278656756 { return 1 }
    if validator_certificate != 11270473 { return 2 }
    if validator_artifact != 99615754 { return 3 }
    if validator_audit != 105297009 { return 4 }

    let step1_need: i64 = 295701
    let step1_margin: i64 = 296000
    let step2_need: i64 = 307457
    let step2_margin: i64 = 308000
    let step3_need: i64 = 323361
    let step3_margin: i64 = 323500
    let step4_need: i64 = 318703
    let step4_margin: i64 = 319000
    let step5_need: i64 = 369718
    let step5_margin: i64 = 370000

    if step1_margin - step1_need != 299 { return 5 }
    if step2_margin - step2_need != 543 { return 6 }
    if step3_margin - step3_need != 139 { return 7 }
    if step4_margin - step4_need != 297 { return 8 }
    if step5_margin - step5_need != 282 { return 9 }

    let y_axis_pass_mask: i64 = 31
    let y_axis_fail_mask: i64 = 0
    let y_axis_slack_mask: i64 = 31
    let axis_validated_mask: i64 = 3
    let pending_axis_validation_mask: i64 = 28
    let remaining_axis_pending_mask: i64 = 4
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
