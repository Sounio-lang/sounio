//@ run-pass
//@ requires: lean_single
//@ expect-stdout: 10000000000000000000.000000
//@ expect-stdout: 1000000000000000019884624838656.000000
//@ expect-stdout: 18446744073709551616.000000
//@ expect-stdout: 10000000000000000159028911097599180468360808563945281389781327557747838772170381060813469985856815104.000000
//@ expect-stdout: .000000
//@ expect-stdout: 9223372036854777856.000000
//@ expect-stdout: -10000000000000000000.000000
//@ expect-stdout: 9200000000000000000.000000
//@ expect-stdout: 10000000000000000.000000
//@ expect-stdout: 1000000000000000.000000
//@ expect-stdout: 123456789012.500000
//@ expect-stdout: 0.000000
//@ expect-stdout: -0.000000
//@ expect-stdout: 0.000123
// ADR-031 R4 witness for lean_single: println of a finite f64 prints the
// digits of C++23 printf("%.6f") at every magnitude. Each expected line was
// produced by printf("%.6f") on the same double. Before the fix this engine
// printed 1.000000e19, 1.000000e16 and 1.000000e-9 for the first, ninth and
// twelfth values (scientific above 1e15 and below the rounding threshold).
// The Madaros twin is tests/run-pass/print_f64_large_magnitude_madaros.sio
// (#3506).
fn main() -> i32 with IO {
    println(1.0e19)
    println(1.0e30)
    println(18446744073709551616.0)
    println(1.0e100)
    println(1.7976931348623157e308)
    println(9223372036854777856.0)
    println(-1.0e19)
    println(9.2e18)
    println(1.0e16)
    println(1.0e15)
    println(123456789012.5)
    println(1.0e-9)
    println(-2.5e-8)
    println(0.000123)
    0
}
