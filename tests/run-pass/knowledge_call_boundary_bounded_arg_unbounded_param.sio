//@ run-pass
//@ expect-stdout: bounded into unbounded: PASS
// An argument that does carry an epsilon still satisfies a parameter with none.

fn take(x: Knowledge<f64>) -> i64 {
    return 3
}

fn main() -> i32 with IO {
    let k: Knowledge[f64, ε=0.90] = Knowledge(1.0, ε=0.90)
    if take(k) == 3 {
        print("bounded into unbounded: PASS\n")
    }
    return 0
}
