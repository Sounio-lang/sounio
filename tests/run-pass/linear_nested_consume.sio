//@ run-pass
//@ description: Linear value passed through multiple function calls

linear struct Secret {
    key: i32,
}

fn encrypt(s: Secret) -> i32 {
    s.key + 100
}

fn process_secret(s: Secret) -> i32 {
    encrypt(s)
}

fn main() {
    let secret = Secret { key: 42 }
    let result = process_secret(secret)
}
