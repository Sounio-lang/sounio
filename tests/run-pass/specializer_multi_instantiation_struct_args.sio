//@ run-pass
//@ requires: madaros
// Previously refused to prevent unspecialized aggregate wrong-code.
// Distinct concrete clones must now return the exact values below.

struct P {
    a: i64,
}

struct Q {
    b: i64,
}

fn pick<T>(x: T, y: T) -> T {
    x
}

fn main() -> i32 with IO {
    let p: P = pick::<P>(P { a: 7 }, P { a: 9 })
    println(p.a)

    let q: Q = pick::<Q>(Q { b: 3 }, Q { b: 4 })
    println(q.b)
    if p.a != 7 { return 1 }
    if q.b != 3 { return 2 }
    0
}
