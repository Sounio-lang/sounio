//@ run-pass
//@ expect-stdout: SPECIALIZER_MULTI_INSTANTIATION_STRUCT_ARGS_OK
//@ requires: madaros
// Two instantiations of one template with distinct plain struct type arguments
// (`pick::<P>`, `pick::<Q>`).
//
// This was the shape that produced WRONG CODE rather than a rejected program:
// the second instantiation poisoned the template back to its unspecialized body,
// and IR lowering has no notion of generics, so a struct-typed argument arrived
// as zero. Measured on the committed compiler at the time: rc=0, printed "0" and
// "0". The specializer then refused it, and this file was a compile-fail fixture
// discriminating on that verdict.
//
// Every distinct instantiation now gets its own clone (spec_ensure_instance in
// self-hosted/check/specializer.sio), so the program is correct and is accepted.
// Measured on the Madaros built from the change, same file: 7 and 3.
//
// The sibling fixture specializer_multi_instantiation_nonscalar.sio covers the
// nested shape (`Cell<i64>` / `Cell<f64>`).
//
// See docs/handoff/BLK-20260903-specializer-nested-targ-collision.md.

struct P {
    a: i64,
}

struct Q {
    b: i64,
}

fn pick<T>(x: T, y: T) -> T {
    x
}

fn main() -> i32 with IO {
    let p: P = pick::<P>(P { a: 7 }, P { a: 9 })
    let q: Q = pick::<Q>(Q { b: 3 }, Q { b: 4 })

    if p.a == 7 && q.b == 3 {
        println("SPECIALIZER_MULTI_INSTANTIATION_STRUCT_ARGS_OK")
    } else {
        println("SPECIALIZER_MULTI_INSTANTIATION_STRUCT_ARGS_FAIL")
    }
    0
}
