//@ check-only
// Imported API conformance for proof-carrying rebracketing protocol D7.

use epistemic::proof_carrying_policy_state_feedback::*
use epistemic::proof_carrying_policy_observation_associator::*
use epistemic::proof_carrying_rebracketing_protocol::*

fn main() with Panic {
    let low = declare_policy_target_hypothesis(510, 0, 520)
    let high = declare_policy_target_hypothesis(511, 1, 520)
    let family = declare_adaptive_observation_policy_family(520, 8400, low, high)
    let budget = declare_synthetic_observation_budget(8500, 8400)
    let anchor_provenance = record_policy_evidence_provenance(
        8101, 7001, 8400, 1, 0, 0, false,
    )
    let anchor = record_observed_anchor_value(7101, anchor_provenance)
    let initial = begin_policy_state_contest(6000, family, budget)
    let anchor_update = update_policy_state_contest_with_anchor(
        6101, 6102, initial, family, anchor,
    )
    let after_anchor = policy_state_transition_result(anchor_update)
    let state_summary = summarize_policy_state_after_anchor(8201, after_anchor)
    let policy_decision = derive_adaptive_exploit_policy_decision(8102, state_summary)
    let gap = certify_policy_coverage_gap(8301, policy_decision)
    let assignment = declare_synthetic_exogenous_coverage_assignment(
        8600, 8400, budget, gap,
    )
    let probe_provenance = record_policy_evidence_provenance(
        8103, 7003, 8400, 2, 8101, 8102, true,
    )

    let a = declare_d5_policy_context_atom(
        9101, family, budget, anchor, policy_decision, gap,
    )
    let b = declare_d5_commit_boundary_atom(9102, family)
    let c = declare_d5_pending_probe_atom(
        9103, family, budget, assignment, probe_provenance, 8,
    )

    let ab_proof = certify_policy_observation_composable(9201, a, b)
    let ab = compose_policy_observation_carriers(9301, ab_proof, a, b)
    let left_proof = certify_policy_observation_composable(9202, ab, c)
    let left = compose_policy_observation_carriers(9302, left_proof, ab, c)
    let bc_proof = certify_policy_observation_composable(9203, b, c)
    let bc = compose_policy_observation_carriers(9303, bc_proof, b, c)
    let right_proof = certify_policy_observation_composable(9204, a, bc)
    let right = compose_policy_observation_carriers(9304, right_proof, a, bc)

    let nonassoc = certify_policy_observation_nonassociativity(
        9701, a, b, c, left, right,
    )
    let control = certify_flat_trace_associative_control(9702, a, b, c)
    let rival = certify_grouping_retained_rival(9703, left, right)
    let monotonicity = certify_committed_evidence_monotonicity(9704, bc, right)

    let local_request = declare_local_flat_rebracketing_request(
        10101, 11001, control, nonassoc,
    )
    assert(local_request.protocol_id == 8700)
    assert(local_request.candidate_kind_code == 1)
    assert(local_request.operator_id == 9801)
    assert(local_request.source_tree_fingerprint == 9037326)
    assert(local_request.target_tree_fingerprint == 573396)
    assert(local_request.source_result_code == 93767706)
    assert(local_request.target_result_code == 93767706)
    assert(local_request.results_equal_on_supplied_evidence)
    assert(local_request.local_scope_requested)
    assert(!local_request.global_scope_requested)
    assert(local_request.exact_ordered_atom_ids_carried)
    assert(!local_request.fingerprint_used_as_identity)
    assert(local_request.public_model_receipt)
    assert(!local_request.compiler_capability_bound)
    assert(!local_request.native_contest_carrier_established)

    let local_decision = decide_local_flat_rebracketing_equality(
        10201, local_request, control,
    )
    assert(local_decision.request_id == 10101)
    assert(local_decision.protocol_id == 8700)
    assert(local_decision.fixture_occurrence_id == 11001)
    assert(local_decision.a_atom_id == 9101)
    assert(local_decision.b_atom_id == 9102)
    assert(local_decision.c_atom_id == 9103)
    assert(local_decision.decision_audit_checksum == 322833)
    assert(local_decision.exact_equal_on_frozen_occurrence)
    assert(local_decision.same_typed_operands)
    assert(local_decision.same_ordered_operands)
    assert(local_decision.same_operator && local_decision.both_trees_defined)
    assert(local_decision.exact_ordered_atom_ids_carried)
    assert(local_decision.fixture_occurrence_bound)
    assert(!local_decision.reusable_across_occurrences)
    assert(local_decision.model_equality_decision_only)
    assert(local_decision.public_model_receipt)
    assert(!local_decision.receipt_construction_sealed)
    assert(!local_decision.universal_associativity_law_established)
    assert(!local_decision.compiler_operator_admission_evidence_supplied)
    assert(!local_decision.compiler_capability_bound)
    assert(!local_decision.native_contest_carrier_established)

    let replay = replay_local_flat_rebracketing_model(10301, local_decision)
    assert(replay.replay_audit_checksum == 10018124)
    assert(replay.replayed_result_code == 93767706)
    assert(replay.exact_result_replayed && replay.fixture_occurrence_bound)
    assert(replay.model_replay_recorded && replay.model_replay_only)
    assert(!replay.compiler_capability_consumed)
    assert(!replay.source_ir_mutated)
    assert(!replay.compiler_pass_executed)
    let replay_refusal = refuse_mismatched_fixture_occurrence_replay(
        10801, 11003, local_decision,
    )
    assert(replay_refusal.reason_mask == 3)
    assert(replay_refusal.refusal_audit_checksum == 2174160852)
    assert(replay_refusal.occurrence_mismatch_observed)
    assert(replay_refusal.cross_occurrence_reuse_refused)
    assert(!replay_refusal.model_replay_recorded)
    assert(!replay_refusal.compiler_authority_issued)

    let semantic_request = declare_semantic_policy_rebracketing_request(
        10102, 11002, nonassoc,
    )
    assert(semantic_request.candidate_kind_code == 2)
    assert(semantic_request.operator_id == 9601)
    assert(semantic_request.source_result_code == 62559008101)
    assert(semantic_request.target_result_code == 91514259234)
    assert(!semantic_request.results_equal_on_supplied_evidence)

    let refusal = refuse_semantic_policy_rebracketing(
        10401, semantic_request, nonassoc, monotonicity, rival,
    )
    assert(refusal.reason_mask == 31)
    assert(refusal.refusal_audit_checksum == 310581870)
    assert(refusal.semantic_inequality_observed)
    assert(refusal.committed_evidence_would_change)
    assert(refusal.grouping_states_distinct)
    assert(refusal.operator_nonassociative_on_witness)
    assert(refusal.universal_law_absent)
    assert(!refusal.local_compiler_authority_issued && !refusal.global_compiler_authority_issued)

    let promotion = request_compiler_authority_promotion(10501, local_decision)
    assert(promotion.promotion_request_audit_checksum == 10018324)
    assert(promotion.global_scope_requested)
    assert(!promotion.universal_law_evidence_supplied)
    assert(!promotion.compiler_binding_evidence_supplied)
    assert(!promotion.sealed_capability_evidence_supplied)
    assert(!promotion.native_contest_evidence_supplied)
    assert(!promotion.compiler_operator_admission_evidence_supplied)
    let abstention = abstain_from_compiler_authority_promotion(
        10601, promotion, local_decision,
    )
    assert(abstention.reason_mask == 63)
    assert(abstention.abstention_audit_checksum == 39443487978)
    assert(abstention.evidence_is_local_only)
    assert(abstention.universal_quantification_absent)
    assert(abstention.compiler_binding_absent)
    assert(abstention.sealed_capability_absent)
    assert(abstention.native_contest_evidence_absent)
    assert(abstention.compiler_operator_admission_evidence_absent)
    assert(!abstention.global_law_issued)
    assert(!abstention.compiler_authority_issued)

    let summary = summarize_rebracketing_protocol(
        10701, local_decision, replay, replay_refusal, refusal, abstention,
    )
    assert(summary.decision_case_count == 3)
    assert(summary.local_equality_decision_count == 1)
    assert(summary.semantic_refusal_count == 1)
    assert(summary.compiler_promotion_abstention_count == 1)
    assert(summary.model_replay_count == 1)
    assert(summary.mismatched_fixture_replay_refusal_count == 1)
    assert(summary.compiler_capability_issue_count == 0)
    assert(summary.actual_compiler_rewrite_count == 0)
    assert(summary.native_contest_receipt_count == 0)
    assert(summary.all_three_declared_cases_recorded)
    assert(!summary.sealed_receipt_construction_established)
    assert(!summary.global_law_established)
    assert(!summary.canonical_compiler_authority_established)
    assert(!summary.native_contest_integration_established)
    assert(!summary.ontology_runtime_transport_established)
    assert(!summary.empirical_claim_established)
    assert(!summary.clinical_authority)
}
