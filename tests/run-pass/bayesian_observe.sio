//@ run-pass
// Test: Bayesian observation narrows variance
//
// A thermometer reads 37.2°C with variance 0.25 (±0.5°C).
// Our prior belief: body temperature is 37.0°C with variance 0.04 (±0.2°C).
// After observation: posterior should be closer to 37.0 with smaller variance.

fn bayesian_mean(val: f64, mv: f64, pm: f64, pv: f64) -> f64 with Div {
    let total = pv + mv
    if total == 0.0 { return val }
    let a = pv * val
    let b = mv * pm
    let sum = a + b
    sum / total
}

fn bayesian_var(mv: f64, pv: f64) -> f64 with Div {
    let total = pv + mv
    if total == 0.0 { return 0.0 }
    let prod = pv * mv
    prod / total
}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i32 with IO, Observe, Div, Mut {
    // Measurement: 37.2 ± 0.5 (variance = 0.25)
    let meas_val: f64 = 37.2
    let meas_var: f64 = 0.25

    // Prior: 37.0 ± 0.2 (variance = 0.04)
    let prior_mean: f64 = 37.0
    let prior_var: f64 = 0.04

    // Bayesian posterior
    let post_mean = bayesian_mean(meas_val, meas_var, prior_mean, prior_var)
    let post_var = bayesian_var(meas_var, prior_var)

    // Expected:
    //   post_mean = (0.04*37.2 + 0.25*37.0) / (0.04+0.25) = (1.488+9.25)/0.29 = 37.028
    //   post_var = (0.04*0.25) / 0.29 = 0.01/0.29 = 0.0345

    println("Posterior mean:")
    println(post_mean)
    println("Posterior variance:")
    println(post_var)

    // Variance MUST be less than both prior and measurement
    // (observation always narrows in normal-normal model)
    if post_var < prior_var {
        println("PASS: variance narrowed from prior")
    } else {
        println("FAIL: variance did not narrow")
        return 1
    }

    if post_var < meas_var {
        println("PASS: variance narrower than measurement alone")
    } else {
        println("FAIL: variance not narrower than measurement")
        return 1
    }

    // Posterior mean should be between prior and measurement
    let low = if prior_mean < meas_val { prior_mean } else { meas_val }
    let high = if prior_mean > meas_val { prior_mean } else { meas_val }
    if post_mean >= low {
        if post_mean <= high {
            println("PASS: posterior mean between prior and measurement")
        } else {
            println("FAIL: posterior mean out of range")
            return 1
        }
    } else {
        println("FAIL: posterior mean below range")
        return 1
    }

    println("ALL PASS: observation narrows uncertainty")
    0
}
