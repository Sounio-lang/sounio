//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 743
    fp = mix(fp, 6, 4297)
    fp = mix(fp, 956152878, 4297)
    fp = mix(fp, 916252082, 4297)
    fp = mix(fp, 316597079, 4297)
    fp = mix(fp, 476878195, 4297)
    fp = mix(fp, 652877359, 4297)
    fp = mix(fp, 344816971, 4297)
    fp = mix(fp, 617386880, 4297)
    fp = mix(fp, 478471574, 4297)
    fp = mix(fp, 2, 4297)
    fp = mix(fp, 1000000, 4297)
    fp = mix(fp, 1, 4297)
    fp = mix(fp, 100, 4297)
    fp = mix(fp, 243366, 4297)
    fp = mix(fp, 319640, 4297)
    fp = mix(fp, 42448, 4297)
    fp = mix(fp, 47276, 4297)
    fp = mix(fp, 66549, 4297)
    fp = mix(fp, 12083, 4297)
    fp = mix(fp, 290642, 4297)
    fp = mix(fp, 386189, 4297)
    fp = mix(fp, 54531, 4297)
    fp = mix(fp, 299663, 4297)
    fp = mix(fp, 389292, 4297)
    fp = mix(fp, 55000, 4297)
    fp = mix(fp, 9021, 4297)
    fp = mix(fp, 3103, 4297)
    fp = mix(fp, 469, 4297)
    fp = mix(fp, 7, 4297)
    fp = mix(fp, 7, 4297)
    fp = mix(fp, 0, 4297)
    fp = mix(fp, 12, 4297)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 325277065 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 751
    fp = mix(fp, instance, 4327)
    fp = mix(fp, 243366, 4327)
    fp = mix(fp, 319640, 4327)
    fp = mix(fp, 42448, 4327)
    fp = mix(fp, 47276, 4327)
    fp = mix(fp, 66549, 4327)
    fp = mix(fp, 12083, 4327)
    fp = mix(fp, 290642, 4327)
    fp = mix(fp, 386189, 4327)
    fp = mix(fp, 54531, 4327)
    fp = mix(fp, 299663, 4327)
    fp = mix(fp, 389292, 4327)
    fp = mix(fp, 55000, 4327)
    fp = mix(fp, 9021, 4327)
    fp = mix(fp, 3103, 4327)
    fp = mix(fp, 469, 4327)
    fp = mix(fp, 7, 4327)
    fp = mix(fp, 7, 4327)
    fp = mix(fp, 0, 4327)
    fp = mix(fp, 12, 4327)
    fp = mix(fp, ok_mask, 4327)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 325277065 { return 0 - 1 }
    if certificate != 986548614 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 757
    fp = mix(fp, instance, 4337)
    fp = mix(fp, certificate, 4337)
    fp = mix(fp, 13, 4337)
    fp = mix(fp, 6, 4337)
    fp = mix(fp, 7, 4337)
    fp = mix(fp, 7, 4337)
    fp = mix(fp, 0, 4337)
    fp = mix(fp, 12, 4337)
    fp = mix(fp, ok_mask, 4337)
    return fp
}

fn obligation_mask() -> i64 {
    let x_need: i64 = 243366 + 47276
    let y_need: i64 = 319640 + 66549
    let z_need: i64 = 42448 + 12083
    let x_margin: i64 = 299663
    let y_margin: i64 = 389292
    let z_margin: i64 = 55000
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var axis_mask: i64 = 0
    if x_need <= x_margin { axis_mask = axis_mask + 1 }
    if y_need <= y_margin { axis_mask = axis_mask + 2 }
    if z_need <= z_margin { axis_mask = axis_mask + 4 }

    var ok_mask: i64 = 0
    if 956152878 > 0 {
        if 316597079 > 0 { ok_mask = ok_mask + 1 }
    }
    if 652877359 > 0 {
        if 617386880 > 0 { ok_mask = ok_mask + 2 }
    }
    if x_need == 290642 {
        if y_need == 386189 {
            if z_need == 54531 { ok_mask = ok_mask + 4 }
        }
    }
    if axis_mask == 7 {
        if x_slack > 0 {
            if y_slack > 0 {
                if z_slack > 0 { ok_mask = ok_mask + 8 }
            }
        }
    }
    if 2 == 2 {
        if 1000000 == 1000000 { ok_mask = ok_mask + 16 }
    }
    if axis_mask == 7 {
        if 12 == 12 { ok_mask = ok_mask + 32 }
    }
    if 0 == 0 { ok_mask = ok_mask + 64 }
    if z_margin == 55000 {
        if z_slack == 469 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = obligation_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 325277065 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 986548614 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 963265870 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
