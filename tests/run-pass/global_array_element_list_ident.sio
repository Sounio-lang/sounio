//@ run-pass
//@ requires:madaros
// Wave9: element-list may reference an earlier scalar global by Ident.

var X: i64 = 7
var Y: i64 = 0 - 3
var A: [i64; 3] = [X, 20, Y]

fn main() -> i64 with IO {
    print_int(A[0])
    print(" ")
    print_int(A[1])
    print(" ")
    print_int(A[2])
    print("\n")
    if A[0] != 7 { return 1 }
    if A[1] != 20 { return 2 }
    if A[2] != 0 - 3 { return 3 }
    0
}
