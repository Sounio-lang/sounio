//@ run-pass
//@ requires: madaros
//@ description: methods of `impl Stack<T>` are called without a turbofish; the receiver's construction fixes T (`Stack::<i64>::new()`, `Stack::empty::<f64>()`, `let s: Stack<i64> = Stack { .. }`, a `&Stack<i64>` parameter, literal arguments of `Stack::of(7)`), and each instance gets its own `impl Stack__A`, so the i64 and f64 instances of `push`/`top` coexist. Madaros refused the whole compile with "generic method specialization requires one unambiguous explicit turbofish" (tests/stdlib/collections/test_heap_vec_generic.sio)
//@ expect-stdout: RECEIVER_INFERENCE_OK

struct Stack<T> { last: T, n: i64 }

impl Stack<T> {
    fn new() -> Stack<T> {
        Stack { last: 0 as T, n: 0 }
    }
    fn empty() -> Stack<T> {
        Stack { last: 0 as T, n: 0 }
    }
    fn of(x: T) -> Stack<T> {
        Stack { last: x, n: 1 }
    }
    fn push(self: &!Stack<T>, x: T) with Mut {
        self.last = x
        self.n = self.n + 1
    }
    fn top(self: &Stack<T>) -> T {
        self.last
    }
    fn size(self: &Stack<T>) -> i64 {
        self.n
    }
}

fn total(s: &Stack<i64>) -> i64 {
    s.top() + s.size()
}

fn main() -> i32 with IO, Mut {
    var a = Stack::<i64>::new()
    a.push(10)
    a.push(20)
    if a.top() != 20 { return 1 }
    if a.size() != 2 { return 2 }

    var b = Stack::empty::<f64>()
    b.push(1.5)
    b.push(2.25)
    let bt = b.top()
    if bt < 2.24 || bt > 2.26 { return 3 }
    if b.size() != 2 { return 4 }

    var c: Stack<i64> = Stack { last: 5, n: 1 }
    c.push(6)
    if c.top() != 6 { return 5 }

    let d = Stack::of(7)
    if d.top() != 7 { return 6 }
    if d.size() != 1 { return 7 }

    if total(&a) != 22 { return 8 }
    println("RECEIVER_INFERENCE_OK")
    0
}
