//@ run-pass
//@ expect-stdout: SHORT_CIRCUIT_OK
// `&&` and `||` short-circuit (ADR-014): the right operand runs only when the
// left one does not decide the result. Madaros used to evaluate both operands,
// so a guard such as `i < n.len && n.buf[i] == 7` read past the array and the
// call counter below reached 2, 4 and 6 instead of 1, 2 and 4.

var CALLS: i64 = 0

fn note(v: bool) -> bool with Mut {
    CALLS = CALLS + 1
    v
}

struct Small { len: i64, buf: [i64; 4] }

fn guarded(n: &Small, i: i64) -> bool with Mut, Panic, Div {
    i < (*n).len && (*n).buf[i as usize] == 7
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var bad: i64 = 0
    if note(false) && note(true) { bad = bad + 1 }
    if CALLS != 1 { bad = bad + 10 }
    if note(true) || note(false) {} else { bad = bad + 100 }
    if CALLS != 2 { bad = bad + 1000 }
    let both = note(true) && note(true)
    if !both { bad = bad + 10000 }
    if CALLS != 4 { bad = bad + 100000 }
    let n = Small { len: 2, buf: [7, 7, 0, 0] }
    if !guarded(&n, 1) { bad = bad + 1000000 }
    if guarded(&n, 1000000) { bad = bad + 10000000 }
    if bad != 0 {
        println(bad)
        return 1
    }
    println("SHORT_CIRCUIT_OK")
    return 0
}
