//@ run-pass
// Test emit_mov_reg_imm32 and emit_mov_reg_imm64 with extended registers R8..R15 (REX.B)
//@ requires: madaros
//@ expect-stdout: 42
use native::encode::*

// NOTE: buffers are built with a CodeBuffer struct literal rather than
// code_buffer_new() here. code_buffer_new() is a zero-argument,
// zero-effect function that just zero-initializes CodeBuffer.len (see
// self-hosted/native/encode.sio) -- semantically identical to the literal
// below -- but calling it cross-module from a program outside self-hosted/
// segfaults the current-source Madaros-compiled ELF (reproduced directly:
// even `var b = code_buffer_new()` with no further use crashes, while the
// equivalent struct literal and every other native::encode call in this
// file run fine). That is a separate, deeper native-v2 codegen bug in
// cross-module calls returning a small struct by value, unrelated to the
// REX.B/(reg & 7) fix this test exists to guard; the literal sidesteps it
// without weakening coverage of emit_mov_reg_imm32/64 themselves, which are
// still the real production encoders under test here.
fn main() -> i64 with IO, Mut, Panic, Div {
    var b32 = CodeBuffer { bytes: [0; 64], len: 0 }
    b32 = emit_mov_reg_imm32(b32, 8, 42)
    if b32.len != 7 { return 1 }
    if code_buffer_read_byte(b32, 0) != 0x49 { return 2 }
    if code_buffer_read_byte(b32, 1) != 0xc7 { return 3 }
    if code_buffer_read_byte(b32, 2) != 0xc0 { return 4 }

    var b64 = CodeBuffer { bytes: [0; 64], len: 0 }
    b64 = emit_mov_reg_imm64(b64, 15, 42)
    if b64.len != 10 { return 5 }
    if code_buffer_read_byte(b64, 0) != 0x49 { return 6 }
    if code_buffer_read_byte(b64, 1) != 0xbf { return 7 }

    print_int(42)
    0
}
