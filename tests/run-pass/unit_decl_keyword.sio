//@ run-pass
//@ expect-stdout: custom unit: PASS

// User-defined unit via the `unit` keyword
unit dosage;

fn main() -> i32 with IO, Mut, Panic, Div {
    let x: dosage = 42.0
    let y: dosage = 8.0
    let total = x + y
    if total == 50.0 {
        print("custom unit: PASS\n")
    }
    return 0
}
