//@ run-pass
// ISO/JCGM 100:2008 §8 uncertainty budget through ODE integration.
//
// System: dy/dt = -k·y (exponential decay)
//   y(0) = 100 ± 2    →  var(y0) = 4.0      (channel 0)
//   k    = 0.1 ± 0.01  →  var(k)  = 0.0001   (channel 1)
//
// 10 Euler steps, h = 0.1, t_final = 1.0
// Uses direct function call for RHS (variance flows through XFER).
// print_budget(y) decomposes total variance into y0-contribution vs k-contribution.

fn rhs(y: f64, k: f64) -> f64 with Mut {
    let dy = 0.0 - k * y
    return dy
}

// 🚨 `print_budget(x)` NÃO EXISTE — nem no compilador, nem no stdlib. O compilador emitia
// `xor eax,eax` no lugar, então este teste imprimia o cabeçalho do orçamento e nada embaixo.
// Achado pelo E201 (28-ago-2026).
//
// Agora o orçamento é computado com o maquinário que EXISTE: `variance_of` lê a sombra β⁴ e
// `sensitivity_of(x, k)` lê a sombra β⁶ do canal k. Oito chamadas literais em vez de laço,
// porque o intrínseco lê o índice direto do TOKEN — um `k` variável não resolveria.
//
// ⚠️ Observado ao ligar isto: as sensibilidades saem TODAS zero. `sensitivity_of` existe e
// devolve 0, ou seja, o orçamento POR CANAL não está sendo rastreado — só a variância total,
// que confere. Fica visível em vez de escondido.
fn print_budget(x: f64) with IO, Mut, Epistemic {
    print("  var_total="); println(variance_of(x))
    print("  ds/d0="); println(sensitivity_of(x, 0))
    print("  ds/d1="); println(sensitivity_of(x, 1))
    print("  ds/d2="); println(sensitivity_of(x, 2))
    print("  ds/d3="); println(sensitivity_of(x, 3))
    print("  ds/d4="); println(sensitivity_of(x, 4))
    print("  ds/d5="); println(sensitivity_of(x, 5))
    print("  ds/d6="); println(sensitivity_of(x, 6))
    print("  ds/d7="); println(sensitivity_of(x, 7))
}

fn main() with IO, Mut, Epistemic {
    let ky: Knowledge<f64> = measure(100.0, uncertainty: 2.0)
    let kk: Knowledge<f64> = measure(0.1, uncertainty: 0.01)
    var y = ky.value    // seeds ch0 = 4.0
    let k = kk.value    // seeds ch1 = 0.0001
    let h = 0.1

    // Integrate 10 Euler steps (t = 0 → 1), inline stepping
    var step: i64 = 0
    while step < 10 {
        let dy = rhs(y, k)
        let delta = h * dy
        y = y + delta
        step = step + 1
    }

    // Total variance
    let vy = variance_of(y)
    print("y_final="); println(y)
    print("var_total="); println(vy)

    // ISO budget decomposition
    print_budget(y)

    print("PASS\n")
}
