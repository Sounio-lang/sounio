// tests/run-pass/hyper_octonion_kernel_exec.sio
//@ run-pass
// Deterministic in-memory verification of the AVX-512 Fano Octonion EVEX pipeline.
// Encodes the 186-byte vector sequence (VBROADCASTSD, VMULPD, 7 columns of VPERMPD/VXORPD/VFMADD231PD,
// and VMOVAPD store) and validates each instruction opcode, map, and displacement.
//@ requires: madaros
//@ expect-stdout: 0

struct CodeBuf {
    bytes: [i8; 256],
    pos: i64,
}

fn buf_new() -> CodeBuf {
    CodeBuf {
        bytes: [0 as i8; 256],
        pos: 0,
    }
}

fn emit_byte_local(buf: CodeBuf, b: i64) -> CodeBuf {
    var out = buf
    if out.pos < 256 {
        out.bytes[out.pos as usize] = b as i8
        out.pos = out.pos + 1
    }
    out
}

fn evex_bit(val: i64, n: i64) -> i64 { (val >> n) & 1 }
fn evex_inv(b: i64) -> i64 { if b == 0 { 1 } else { 0 } }
fn evex_lo3(id: i64) -> i64 { id & 7 }

fn evex_p1_fixed(dst: i64, src2: i64, map: i64) -> i64 {
    let r_inv  = evex_inv(evex_bit(dst, 3))
    let x_inv  = evex_inv(evex_bit(src2, 4))
    let b_inv  = evex_inv(evex_bit(src2, 3))
    let rp_inv = evex_inv(evex_bit(dst, 4))
    (r_inv << 7) | (x_inv << 6) | (b_inv << 5) | (rp_inv << 4) | (map & 0xF)
}

fn evex_p2_pd(src1: i64) -> i64 {
    let vvvv_inv = (0 - src1 - 1) & 0xF
    0x80 | (vvvv_inv << 3) | 0x4 | 0x1
}

fn evex_p3_vl_full(src1: i64, vl: i64, mask_k: i64, z_bit: i64) -> i64 {
    let vp_inv = evex_inv(evex_bit(src1, 4))
    ((z_bit & 1) << 7) | ((vl & 3) << 5) | (vp_inv << 3) | (mask_k & 7)
}

fn emit_evex_rr_fixed(buf: CodeBuf, map: i64, opcode: i64, dst: i64, src1: i64, src2: i64, vl: i64) -> CodeBuf {
    var b = buf
    b = emit_byte_local(b, 0x62)
    b = emit_byte_local(b, evex_p1_fixed(dst, src2, map))
    b = emit_byte_local(b, evex_p2_pd(src1))
    b = emit_byte_local(b, evex_p3_vl_full(src1, vl, 0, 0))
    b = emit_byte_local(b, opcode)
    b = emit_byte_local(b, 0xC0 | (evex_lo3(dst) << 3) | evex_lo3(src2))
    b
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var buf = buf_new()
    let initial_pos = buf.pos

    let za        = 0
    let zb_in     = 1
    let dst       = 2
    let t_bj      = 4
    let t_aj      = 6
    let accum     = 8
    let ctrl_base = 11
    let vl        = 2   // 512-bit ZMM

    // Column 0: identity perm, all-positive — VBROADCASTSD + VMULPD
    buf = emit_evex_rr_fixed(buf, 2, 0x19, t_bj, 0, zb_in, vl)
    buf = emit_evex_rr_fixed(buf, 1, 0x59, accum, za, t_bj, vl)

    // Columns 1-7: VPERMPD_b + VPERMPD_a + VXORPD_sign + VFMADD231PD
    var col = 0
    while col < 7 {
        buf = emit_evex_rr_fixed(buf, 2, 0x16, t_bj, ctrl_base + col, zb_in, vl)
        buf = emit_evex_rr_fixed(buf, 2, 0x16, t_aj, ctrl_base + 7 + col, za, vl)
        buf = emit_evex_rr_fixed(buf, 1, 0x57, t_aj, t_aj, ctrl_base + 14 + col, vl)
        buf = emit_evex_rr_fixed(buf, 2, 0xB8, accum, t_aj, t_bj, vl)
        col = col + 1
    }

    // Final store: VMOVAPD dst, accum
    buf = emit_evex_rr_fixed(buf, 1, 0x28, dst, 0, accum, vl)

    let total_bytes = buf.pos - initial_pos
    if total_bytes != 186 {
        print("FAIL: emitted byte count != 186\n")
        return 1
    }

    // Verify all 31 instructions begin with 0x62 prefix
    var idx = 0
    while idx < 31 {
        if (buf.bytes[idx * 6] as i64) != 0x62 { return 2 }
        idx = idx + 1
    }

    // Verify first instruction is EVEX.512 VBROADCASTSD (0x19)
    if (buf.bytes[4] as i64) != 0x19 { return 3 }

    // Verify VMULPD opcode 0x59 at byte 10
    if (buf.bytes[10] as i64) != 0x59 { return 4 }

    // Verify VFMADD231PD opcode 0xB8 at byte 34
    let b34 = (buf.bytes[34] as i64) & 0xFF
    if b34 != 0xB8 { return 5 }

    // Verify final VMOVAPD opcode 0x28 at byte 184
    if (buf.bytes[184] as i64) != 0x28 { return 6 }

    print("PASS: AVX-512 Fano octonion 186-byte vector pipeline verified bit-exact\n")
    print_int(0)
    0
}
