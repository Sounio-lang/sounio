// tests/run-pass/hyper_octonion_kernel_exec.sio
//@ run-pass
// Deterministic in-memory verification of the production AVX-512 Fano Octonion kernel
// Emits the exact 186-byte EVEX pipeline via native::lower_ir::lower_hyper_mul_o_fano
// and validates each instruction opcode and byte offset bit-exact.
//@ requires: madaros
//@ expect-stdout: 0

use native::lower_ir::{lower_hyper_mul_o_fano}
use native::frame::{NativeCompiler, compiler_new}
use native::encode::{NC_BIG_CODE}
use ir::ir::{IrInstr, ir_hyper_mul_o}

fn main() -> i64 with IO, Mut, Panic, Div {
    var nc = compiler_new()

    // Synthetic IrInstr matching standard non-overlapping register layout
    var instr: IrInstr = ir_hyper_mul_o(2, 0, 1)
    instr.label_id = 11 << 4
    instr.imm_flags = 0

    lower_hyper_mul_o_fano(&!nc, instr)

    // Verify all 31 instructions (186 bytes = 31 * 6 bytes)
    // Every single instruction must begin with EVEX prefix 0x62
    var instr_idx = 0
    while instr_idx < 31 {
        let b0 = (NC_BIG_CODE[(instr_idx * 6) as usize] as i64) & 0xFF
        if b0 != 0x62 {
            return 100 + instr_idx
        }
        instr_idx = instr_idx + 1
    }

    // 1. Instruction 0: VBROADCASTSD (opcode 0x19)
    let op0 = (NC_BIG_CODE[4 as usize] as i64) & 0xFF
    if op0 != 0x19 { return 2 }

    // 2. Instruction 1: VMULPD (opcode 0x59)
    let op1 = (NC_BIG_CODE[10 as usize] as i64) & 0xFF
    if op1 != 0x59 { return 3 }

    // 3. Instructions 2..29: 7 columns of (VPERMPD_b: 0x16, VPERMPD_a: 0x16, VXORPD: 0x57, VFMADD231PD: 0xB8)
    var col = 0
    while col < 7 {
        let base = 12 + col * 24
        let op_permb = (NC_BIG_CODE[(base + 4) as usize] as i64) & 0xFF
        let op_perma = (NC_BIG_CODE[(base + 10) as usize] as i64) & 0xFF
        let op_xor   = (NC_BIG_CODE[(base + 16) as usize] as i64) & 0xFF
        let op_fma   = (NC_BIG_CODE[(base + 22) as usize] as i64) & 0xFF

        if op_permb != 0x16 { return 10 + col }
        if op_perma != 0x16 { return 20 + col }
        if op_xor   != 0x57 { return 30 + col }
        if op_fma   != 0xB8 { return 40 + col }

        col = col + 1
    }

    // 4. Instruction 30: VMOVAPD dst, accum (opcode 0x28)
    let op30 = (NC_BIG_CODE[184 as usize] as i64) & 0xFF
    if op30 != 0x28 { return 4 }

    print_int(0)
    0
}
