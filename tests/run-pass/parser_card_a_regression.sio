//@ run-pass
//@ description: Card A parser regression coverage for uninit var, array dimensions, sci notation, and const keyword items.

const PARSER_CARD_A_N: i64 = 4
type ParserCardAlias = i64;

fn main() -> i64 with Mut, Panic, Div {
    var x: ParserCardAlias
    x = 1
    var xs: [i64; 4] = [0; 4]
    let small: f64 = 1.0e-3
    if small < 1.0e-30 {
        xs[0] = x
    }
    if small < 1.0 {
        xs[0] = x
    }
    loop {
        x = xs[0]
        break
    }
    let _out = xs[0]
    0
}
