//@ run-pass
//@ description: `use X::*` loads a stdlib directory module through its root file -- stdlib/ffi/mod.sio (no stdlib/ffi.sio) and stdlib/cmp/lib.sio (no mod.sio either) -- and a qualified `X::f()` call reaches it
//@ expect-stdout: DIR_MODULE_ROOT_OK

use ffi::*
use cmp::*

fn main() -> i32 with IO, Mut {
    var value: i64 = 0
    let ptr = (&!value) as *mut i64
    ffi_i64_write(ptr, 42)
    if ffi_i64_read(ptr) != 42 { return 1 }
    if max_i64(3, 9) != 9 { return 2 }
    if cmp::min_i64(3, 9) != 3 { return 3 }
    if ffi_sizeof_f64() != 8 { return 4 }
    println("DIR_MODULE_ROOT_OK")
    0
}
