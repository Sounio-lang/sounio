//@ run-pass
//@ check-only
// Gate-owned runtime smoke: scripts/ci/graphics_companion_gate.sh compiles and verifies this.

use graphics::drawing::{color_black, color_blue, color_green, color_red, color_white}
use graphics::tile::{tiled_surface_new, tiled_clear, tiled_set_pixel, tiled_export_ppm}

fn main() -> i64 with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(4, 2, 2, 2)
    ts = tiled_clear(ts, color_black())

    ts = tiled_set_pixel(ts, 0, 0, color_red())
    ts = tiled_set_pixel(ts, 1, 0, color_green())
    ts = tiled_set_pixel(ts, 2, 0, color_blue())
    ts = tiled_set_pixel(ts, 3, 0, color_white())

    tiled_export_ppm(&ts)
    0
}
