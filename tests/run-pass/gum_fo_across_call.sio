//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_FO_ACROSS_CALL_OK
//@ description: Madaros FO/GUM variance must survive a user function call (Family A discriminant).
//@   This is CALCULATION, not print: CALL_var is exactly 0 (scaled *1e12 still 0).
//@   INLINE of the same arithmetic is live (~1e-3). Distinct from Family B emitter.
//@   Analytic (GUM): var(c_20) = 0.00211748756950975 (c_20 = 1.2 (1 - 0.02 cl fu)^20),
//@   from the C++23 dual-number oracle tests/oracles/gum_fo_across_call.cpp.
//@   Checked against it with a relative tolerance of 1e-9 (#1706: it used to
//@   accept any v > 1e-12, which a wrong 0.000160 also passed).

fn rhs(c: f64, cl: f64, fu: f64) -> f64 with Div {
    let cl_eff = cl * fu
    0.0 - cl_eff * c / 5.0
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let k_cl: Knowledge<f64> = measure(12.4, uncertainty: 1.24)
    let k_fu: Knowledge<f64> = measure(0.08, uncertainty: 0.008)
    let cl = k_cl.value
    let fu = k_fu.value
    var c = 1.2
    var step: i64 = 0
    while step < 20 {
        let d = rhs(c, cl, fu)
        c = c + 0.1 * d
        step = step + 1
    }
    let v = variance_of(c)
    let want = 0.00211748756950975
    print("CALL_var ")
    print_f64(v)
    print(" analytic=")
    print_f64(want)
    println("")
    var dv = v - want
    if dv < 0.0 { dv = 0.0 - dv }
    if dv <= 1.0e-9 * want {
        println("GUM_FO_ACROSS_CALL_OK")
        0
    } else {
        println("GUM_FO_ACROSS_CALL_MISMATCH")
        println("EPISTEMIC_FABRICATION: variance across a user fn call is not the analytic value")
        1
    }
}
