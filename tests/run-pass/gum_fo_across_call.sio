//@ run-pass
//@ known-failure: Madaros FO variance does not cross user fn calls (Family A); lean_single OK.
//@ expect-stdout: GUM_FO_ACROSS_CALL_OK
//@ description: Madaros FO/GUM variance must survive a user function call (Family A discriminant).
//@   This is CALCULATION, not print: CALL_var is exactly 0 (scaled *1e12 still 0).
//@   INLINE of the same arithmetic is live (~1e-3). Distinct from Family B emitter.

fn rhs(c: f64, cl: f64, fu: f64) -> f64 with Div {
    let cl_eff = cl * fu
    0.0 - cl_eff * c / 5.0
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let k_cl: Knowledge<f64> = measure(12.4, uncertainty: 1.24)
    let k_fu: Knowledge<f64> = measure(0.08, uncertainty: 0.008)
    let cl = k_cl.value
    let fu = k_fu.value
    var c = 1.2
    var step: i64 = 0
    while step < 20 {
        let d = rhs(c, cl, fu)
        c = c + 0.1 * d
        step = step + 1
    }
    let v = variance_of(c)
    print("CALL_var ")
    print_f64(v)
    println("")
    // Thesis bar: must be a live uncertainty, not a silent zero.
    if v > 1.0e-12 {
        println("GUM_FO_ACROSS_CALL_OK")
        0
    } else {
        println("GUM_FO_ACROSS_CALL_ZERO")
        println("EPISTEMIC_FABRICATION: variance lost across user fn call")
        1
    }
}
