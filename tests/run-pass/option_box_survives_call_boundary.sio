//@ run-pass
//@ expect-stdout: option box across call: PASS
// An Option<Box<T>> that matches Some in the caller must still match Some
// inside the function it is passed to. lean_single gets this right, which is
// why this test passes here.
//
// MADAROS GETS IT WRONG, measured on the same source: the caller prints some,
// and both callees print none. The discriminant is lost crossing the call
// boundary, for a one-argument function as much as a two-argument one.
//
// That is not a curiosity. lex_file_parse_items ends in
// reverse_item_list_opt(rev_items) -> reverse_item_list_loop(items, None), and
// under Madaros the loop sees None on its first call and returns the empty
// accumulator. So the modular parser returns ZERO items for every file --
// measured on hello.sio with token_count=17 and errors=0 -- and the two CI
// probes built on it, k2_knowledge_unit_constraint_probe and
// k2_unit_derived_ast_probe, have been validating empty lists.

struct Node {
    v: i64,
}

fn takes_one(current: Option<Box<Node> >) -> i64 with Mut, Alloc {
    match current {
        None => 0
        Some(n) => 1
    }
}

fn takes_two(current: Option<Box<Node> >, acc: Option<Box<Node> >) -> i64 with Mut, Alloc {
    match current {
        None => 0
        Some(n) => 1
    }
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let node = Node { v: 42 }
    let items = Some(Box::new(node))
    if takes_one(items) == 1 && takes_two(items, None) == 1 {
        print("option box across call: PASS\n")
    }
    return 0
}
