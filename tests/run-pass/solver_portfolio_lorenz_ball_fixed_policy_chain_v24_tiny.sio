//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v24 smoke for Lorenz ball-fixed full policy-chain receipt

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 27 { return 0 - 1 }
    if instance_fp != 703368760 { return 0 - 1 }
    if certificate_fp != 606714830 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 27 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn chain_instance_fingerprint(scale: i64, steps: i64, quality_profile_fp: i64,
                              step_policy_fp: i64, margin_fp: i64,
                              guard_decision_fp: i64) -> i64 with Mod {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if step_policy_fp != 231786611 { return 0 - 1 }
    if margin_fp != 494960746 { return 0 - 1 }
    if guard_decision_fp != 833881722 { return 0 - 1 }

    var fp: i64 = 239
    fp = portfolio_mix(fp, scale, 2179)
    fp = portfolio_mix(fp, steps, 2179)
    fp = portfolio_mix(fp, quality_profile_fp, 2179)
    fp = portfolio_mix(fp, step_policy_fp, 2179)
    fp = portfolio_mix(fp, margin_fp, 2179)
    fp = portfolio_mix(fp, guard_decision_fp, 2179)
    return fp
}

fn chain_certificate_fingerprint(instance_fp: i64,
                                 policy_chain_fp: i64,
                                 stage_count: i64,
                                 policy_mask: i64,
                                 margin_mask: i64,
                                 action_code: i64,
                                 guard_band_code: i64,
                                 next_dt_num: i64,
                                 next_dt_den: i64) -> i64 with Mod {
    if instance_fp != 703368760 { return 0 - 1 }
    if policy_chain_fp != 21862303 { return 0 - 1 }
    if stage_count != 4 { return 0 - 1 }
    if policy_mask != 15 { return 0 - 1 }
    if margin_mask != 15 { return 0 - 1 }
    if action_code != 1 { return 0 - 1 }
    if guard_band_code != 1 { return 0 - 1 }
    if next_dt_num != 1 { return 0 - 1 }
    if next_dt_den != 1 { return 0 - 1 }

    var fp: i64 = 241
    fp = portfolio_mix(fp, instance_fp, 2203)
    fp = portfolio_mix(fp, policy_chain_fp, 2203)
    fp = portfolio_mix(fp, stage_count, 2203)
    fp = portfolio_mix(fp, policy_mask, 2203)
    fp = portfolio_mix(fp, margin_mask, 2203)
    fp = portfolio_mix(fp, action_code, 2203)
    fp = portfolio_mix(fp, guard_band_code, 2203)
    fp = portfolio_mix(fp, next_dt_num, 2203)
    fp = portfolio_mix(fp, next_dt_den, 2203)
    return fp
}

fn portfolio_v24_manifest_fingerprint(policy_chain_entry_fp: i64) -> i64 with Mod {
    if policy_chain_entry_fp != 777068644 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 24, 1151)
    fp = portfolio_mix(fp, 28, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, 3812644, 1151)
    fp = portfolio_mix(fp, policy_chain_entry_fp, 1151)
    return fp
}

fn portfolio_v24_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 654522473 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 24, 1871)
    fp = portfolio_mix(fp, 28, 1871)
    fp = portfolio_mix(fp, 8, 1871)
    fp = portfolio_mix(fp, 18, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v24_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 654522473 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 24, 1907)
    fp = portfolio_mix(fp, 28, 1907)
    fp = portfolio_mix(fp, 4, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 18, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v24_readiness_fingerprint(
    manifest_fp: i64,
    result_coverage_fp: i64,
    family_coverage_fp: i64,
    acceptance_receipt_fp: i64,
    audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 654522473 { return 0 - 1 }
    if result_coverage_fp != 351276693 { return 0 - 1 }
    if family_coverage_fp != 421318006 { return 0 - 1 }
    if acceptance_receipt_fp != 977323540 { return 0 - 1 }
    if audit_receipt_fp != 782172696 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 24, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = chain_instance_fingerprint(
        1000000, 5, 70877465, 231786611, 494960746, 833881722)
    if instance_fp != 703368760 { return 1 }

    let certificate_fp = chain_certificate_fingerprint(
        instance_fp, 21862303, 4, 15, 15, 1, 1, 1, 1)
    if certificate_fp != 606714830 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(27, instance_fp, certificate_fp, 1, 27)
    if entry_fp != 777068644 { return 3 }

    let manifest_fp = portfolio_v24_manifest_fingerprint(entry_fp)
    if manifest_fp != 654522473 { return 4 }

    let result_coverage_fp = portfolio_v24_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 351276693 { return 5 }

    let family_coverage_fp = portfolio_v24_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 421318006 { return 6 }

    if portfolio_v24_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        977323540, 782172696) != 327542064 { return 7 }

    if chain_instance_fingerprint(
        1000000, 5, 70877465, 231786611, 494960746, 833881723) != (0 - 1) { return 8 }
    if chain_certificate_fingerprint(
        instance_fp, 21862304, 4, 15, 15, 1, 1, 1, 1) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(27, instance_fp, certificate_fp, 0, 27) != (0 - 1) { return 10 }
    if portfolio_v24_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 11 }
    if portfolio_v24_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 12 }
    if portfolio_v24_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 13 }
    if portfolio_v24_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        977323540, 782172697) != (0 - 1) { return 14 }

    return 0
}
