//@ run-pass
//@ expect-stdout: 77 77
//@ description: a field borrow through a reference addresses the pointee's field
struct BorrowNode { value: i64 }
struct BorrowRecord { tag: i64, list: Option<Box<BorrowNode>>, tail: i64 }
fn borrow_read(list: &Option<Box<BorrowNode>>) -> i64 with Panic {
    match *list { Some(n) => { n.value } None => { -1 } }
}
fn borrow_direct(r: &BorrowRecord) -> i64 with Panic { borrow_read(&r.list) }
fn borrow_owned(r: &BorrowRecord) -> i64 with Panic {
    let list = (*r).list
    borrow_read(&list)
}
fn main() with IO, Mut, Panic, Alloc {
    let r = BorrowRecord { tag: 123, list: Some(Box::new(BorrowNode { value: 77 })), tail: 456 }
    print_int(borrow_direct(&r))
    print(" ")
    print_int(borrow_owned(&r))
    print("\n")
}
