//@ run-pass
//@ expect-stdout: CLAIM_NATIVE_OK
// Native parser support for AST-native claims (future rung 1 of
// docs/research/ast_native_claims_spec_2026-07-25.md).
//
// `claim name { field = value, ... }` blocks are compile-time metadata for
// the falsification ledger. The parser records them in the AST claim
// registry and drops them from the item stream, so they must not affect
// codegen: this program compiles and runs exactly as if the claims were
// absent. Values exercise all four field kinds: string, path, int, float.

claim rupture_lstm_no_annihilation {
    hypothesis = "trained LSTM exhibits composed annihilation",
    falsifier  = "orientation_scramble produces equivalent gap_dominance",
    evidence   = Evidence::InstrumentControlled,
    harness    = "scripts/research/rupture_ord2_trained_lstm_probe.py",
    gate       = "scripts/ci/rupture_abcd_contracts_gate.sh",
    verdict    = Verdict::Negative,
    trial_count = 3,
    threshold  = 0.95,
}

// Empty claim body is legal (metadata placeholder).
claim placeholder_marker {
}

// Claim blocks may appear between other items without disturbing them.
fn answer() -> i64 {
    42
}

claim trailing_separator_ok {
    note = "trailing comma is fine",
}

fn main() -> i64 with IO {
    if answer() == 42 {
        print("CLAIM_NATIVE_OK\n")
    }
    0
}
