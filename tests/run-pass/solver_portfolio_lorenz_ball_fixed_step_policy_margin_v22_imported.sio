use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v22_lorenz_step_policy_margin_instance_fingerprint(
        1000000, 5, 70877465, 231786611)
    if instance_fp != 377517990 { return 1 }

    let certificate_fp = solver_portfolio_v22_lorenz_step_policy_margin_certificate_fingerprint(
        instance_fp, 494960746, 1274, 1273, 1, 583927633827840, 1273, 15, 1)
    if certificate_fp != 250048780 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_ball_fixed_step_policy_margin(),
        instance_fp,
        certificate_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_ball_fixed_step_policy_margin())
    if entry_fp != 757892608 { return 3 }

    let manifest_fp = solver_portfolio_v22_lorenz_ball_fixed_step_policy_margin_bundle_fingerprint(
        70877465, 231786611, 494960746)
    if manifest_fp != 420758164 { return 4 }

    let result_coverage_fp = solver_portfolio_v22_result_coverage_fingerprint(
        22, 26, 8, 16, 1, 1, manifest_fp)
    if result_coverage_fp != 191474584 { return 5 }

    let family_coverage_fp = solver_portfolio_v22_checker_family_coverage_fingerprint(
        22, 26, 4, 3, 2, 1, 16, manifest_fp)
    if family_coverage_fp != 850822389 { return 6 }

    let acceptance_fp = solver_portfolio_v22_acceptance_receipt_fingerprint(
        22, manifest_fp, result_coverage_fp)
    if acceptance_fp != 338097733 { return 7 }

    let audit_fp = solver_portfolio_v22_audit_receipt_fingerprint(
        22, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 589698637 { return 8 }

    let readiness_fp = solver_portfolio_v22_readiness_fingerprint(
        22, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 356299987 { return 9 }

    if solver_portfolio_v22_lorenz_ball_fixed_step_policy_margin_bundle_fingerprint(
        70877465, 231786611, 494960747) != (0 - 1) { return 10 }
    if solver_portfolio_v22_result_coverage_fingerprint(
        22, 26, 8, 15, 1, 1, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v22_checker_family_coverage_fingerprint(
        22, 26, 4, 3, 2, 1, 15, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v22_readiness_fingerprint(
        22, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 13 }

    return 0
