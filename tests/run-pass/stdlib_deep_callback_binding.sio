//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_CALLBACK_BINDING_PASS
use fixtures::deep_callback_binding::{deep_apply,deep_apply_phantom}
fn acceleration(x:i64)->i64 with Panic {assert(x>=0);x+100}
fn chosen(x:i64)->i64 with Panic {assert(x>=0);x+7}
fn main()->i32 with IO,Panic {
    assert(deep_apply(chosen,5)==12)
    assert(deep_apply(acceleration,5)==105)
    assert(deep_apply_phantom(chosen,5)==12)
    print("STDLIB_DEEP_CALLBACK_BINDING_PASS\n")
    return 0
}
