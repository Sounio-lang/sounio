//@ run-pass
//@ expect-stdout: not a suffix: PASS
// The disambiguation rule for the <unit> literal form, which is the subtle part
// of it. A `<` touching a number starts a unit ONLY when a closing `>` follows a
// valid name; otherwise it is still the less-than operator. Both spellings below
// must keep working, and the tight one is the one that would break first.

fn main() -> i32 with IO, Mut, Panic, Div {
    let a = 140.0
    let b = 200.0
    var ok: i64 = 0
    if a < b { ok = ok + 1 }
    if 140.0<b { ok = ok + 1 }
    if ok == 2 {
        print("not a suffix: PASS\n")
    }
    return 0
}
