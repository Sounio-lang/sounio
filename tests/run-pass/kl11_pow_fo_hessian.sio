//@ run-pass
//@ requires: madaros
//@ expect-stdout: KL11_POW_FO_HESSIAN_PASS
//@ sabotage: hessian-chain
//@ description: KL-11 — pow has FO/Hessian transfer on Madaros (no opaque zero)

// At x = 0.5: hessian_of(pow(x, 3.0), 0, 0) = d²/dx²(x³) = 6x = 3.0
// Before KL-11 this printed 0.000000 (structural opaque call).

fn near(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    if d < 0.0 { 0.0 - d < tol } else { d < tol }
}

fn main() -> i64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(0.5, uncertainty: 0.0)
    let x = xm.value
    let h = hessian_of(pow(x, 3.0), 0, 0)
    println(h)
    if near(h, 3.0, 1.0e-9) {
        println("KL11_POW_FO_HESSIAN_PASS")
        0
    } else {
        println("KL11_POW_FO_HESSIAN_FAIL")
        1
    }
}
