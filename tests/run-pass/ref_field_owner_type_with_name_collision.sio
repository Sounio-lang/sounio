//@ run-pass
//@ requires: madaros
//@ expect-stdout: REF_FIELD_OWNER_TYPE_OK
// A field declared `&!S` or `&S` gives `(*(*o).f).x` the owner type S. Madaros
// had no owner type there: a reference type expression has no named type, so
// `x` was looked up by name in the first struct that has such a field. With
// the unrelated `struct X` below, `count` resolved to X's offset (8), not
// Tbl's (0): the store went to the wrong word and both reads returned 0, with
// exit 0. lean_single printed the right values.
struct X { pad: i64, count: i64 }
struct Tbl { count: i64, entries: [i64; 4] }
struct Lw { t: &!Tbl }
struct Lr { t: &Tbl }

fn set_count(lo: &!Lw) with Mut { (*(*lo).t).count = 3 }
fn set_entry(lo: &!Lw) with Mut { (*(*lo).t).entries[2] = 9 }
fn get_count(lo: &!Lw) -> i64 { (*(*lo).t).count }
fn get_count_ro(lr: &Lr) -> i64 { (*(*lr).t).count }

fn main() -> i64 with IO, Mut {
    var bad: i64 = 0
    var t = Tbl { count: 0, entries: [0; 4] }
    var lo = Lw { t: &!t }
    set_count(&!lo)
    set_entry(&!lo)
    if get_count(&!lo) != 3 { bad = bad + 1 }
    if t.count != 3 { bad = bad + 1 }
    if t.entries[2] != 9 { bad = bad + 1 }
    let u = Tbl { count: 33, entries: [44, 0, 0, 0] }
    let lr = Lr { t: &u }
    if get_count_ro(&lr) != 33 { bad = bad + 1 }
    let x = X { pad: 1, count: 2 }
    if x.count != 2 { bad = bad + 1 }
    if bad == 0 {
        println("REF_FIELD_OWNER_TYPE_OK")
    } else {
        print("REF_FIELD_OWNER_TYPE_FAIL ")
        print_int(bad)
        println("")
    }
    0
}
