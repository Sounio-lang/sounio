//@ run-pass
//@ requires: madaros
//@ expect-stdout: LIVE_HEAP_STAMP_OK
//@ description: region+heap_cursor stamp using live __rgn_cursor (no imports — builtins bind on single-module)
//
// Multi-module `use` paths do not see __rgn_cursor (E137). This witness is
// single-module so the intrinsic binds, and mirrors EpistemicInRegion's shape.

struct Epistemic { val: f64, variance: f64, confidence: i64 }
struct EpistemicInRegion { value: Epistemic, region_id: i64, heap_cursor: i64 }
struct Scratch { a: f64, b: f64, c: f64 }

fn epr_measured_at(val: f64, std_dev: f64, region_id: i64, heap_cursor: i64) -> EpistemicInRegion {
    EpistemicInRegion {
        value: Epistemic { val: val, variance: std_dev * std_dev, confidence: 900 },
        region_id: region_id,
        heap_cursor: heap_cursor,
    }
}

fn main() -> i64 with IO, Mut, Panic, Div {
    let _force = Scratch { a: 1.0, b: 2.0, c: 3.0 }
    let c0 = __rgn_cursor()
    let sensor = epr_measured_at(10.0, 0.5, 2, c0)
    let _force2 = Scratch { a: 4.0, b: 5.0, c: 6.0 }
    let c1 = __rgn_cursor()
    let ode = epr_measured_at(10.0, 0.1, 5, c1)

    if sensor.heap_cursor < 0 { return 1 }
    if ode.heap_cursor < 0 { return 2 }
    if sensor.heap_cursor != c0 { return 3 }
    if ode.heap_cursor != c1 { return 4 }
    if c1 <= c0 { return 5 }
    if sensor.region_id == ode.region_id { return 6 }

    println("LIVE_HEAP_STAMP_OK")
    0
}
