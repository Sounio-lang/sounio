//@ run-pass
//@ description: Tiny portfolio v44 smoke for Lorenz i256 Taylor-2 remainder entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 521
    receipt_fp = mix(receipt_fp, 320985955, 2983)
    receipt_fp = mix(receipt_fp, 980184978, 2983)
    receipt_fp = mix(receipt_fp, 862964893, 2983)
    receipt_fp = mix(receipt_fp, 130892363, 2983)
    receipt_fp = mix(receipt_fp, 61654294, 2983)
    receipt_fp = mix(receipt_fp, 2, 2983)
    receipt_fp = mix(receipt_fp, 127, 2983)
    if receipt_fp != 873855189 { return 1 }

    var audit_fp: i64 = 523
    audit_fp = mix(audit_fp, receipt_fp, 2999)
    audit_fp = mix(audit_fp, 320985955, 2999)
    audit_fp = mix(audit_fp, 980184978, 2999)
    audit_fp = mix(audit_fp, 609891562, 2999)
    audit_fp = mix(audit_fp, 519708695, 2999)
    audit_fp = mix(audit_fp, 61654294, 2999)
    audit_fp = mix(audit_fp, 127, 2999)
    if audit_fp != 311965616 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 47, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 47, 1103)
    if entry_fp != 485944472 { return 3 }

    if audit_fp == 311965617 { return 4 }
    return 0
}
