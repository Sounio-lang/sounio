//@ run-pass
//@ requires: madaros
//@ expect-stdout: DEEP DYNAMIC ROBUST STATUS PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use stats::regression::dynamic_robust_covariance::{dynamic_robust_workspace,dynamic_linear_hc3,dynamic_linear_cluster}
fn robust_status(kind:i64) with Alloc,IO,Mut,Div,Panic {
 let n:i64=3
 let p:i64=1
 let query=dynamic_robust_workspace(n,p)
 var a=numeric_buffer_new(n,n*8)
 var y=numeric_buffer_new(n,n*8)
 var ids=integer_buffer_new(n,n*8)
 var beta=numeric_buffer_new(p,p*8)
 let covariance_len:i64=if kind==3 {0}else{1}
 var covariance=numeric_buffer_new(covariance_len,covariance_len*8)
 var se=numeric_buffer_new(1,8)
 var leverage=numeric_buffer_new(n,n*8)
 var work=numeric_buffer_new(query.numeric_elements,query.numeric_elements*8)
 var order=integer_buffer_new(query.integer_elements,query.integer_elements*8)
 let layout=numeric_matrix(n,n,p,p,1,0)
 var i:i64=0
 while i<n {
  var value:f64=1.0
  if kind==0 {if i>0 {value=0.0}}
  if kind==4 {value=0.0}
  if kind==5 {value=1e-200}
  if kind==6 {value=1e200}
  numeric_buffer_set(&!a,i,value)
  numeric_buffer_set(&!y,i,(i+1) as f64)
  integer_buffer_set(&!ids,i, -9)
  numeric_buffer_set(&!leverage,i,27.0)
  i=i+1
 }
 numeric_buffer_set(&!se,0,31.0)
 if covariance_len>0 {numeric_buffer_set(&!covariance,0,29.0)}
 let method:i64=if kind==2 {2}else{0}
 let result=if kind==1 || kind==2 {
  dynamic_linear_cluster(&a,&layout,&y,&ids,method,0.0,&!beta,&!covariance,&!se,&!leverage,&!work,&!order)
 }else{
  dynamic_linear_hc3(&a,&layout,&y,0.0,&!beta,&!covariance,&!se,&!leverage,&!work,&!order)
 }
 let status:i64=result.covariance_status
 let fit_status:i64=result.fit.status
 print("robust status kind: ");println(kind)
 print("robust status covariance: ");println(status)
 print("robust status fit: ");println(fit_status)
 if kind==0 || kind==1 {assert(status==3 && fit_status==0)}
 if kind==2 {assert(status==5)}
 if kind==3 {assert(status==2 && fit_status==0)}
 if kind==4 {assert(status==1 && fit_status==3)}
 if kind==5 || kind==6 {assert(status==4 && fit_status==0)}
 assert(result.correction_factor==0.0 && !result.assumptions_assessed && !result.finite_sample_calibrated)
 if covariance_len>0 {assert(numeric_buffer_at(&covariance,0)==29.0)}
 assert(numeric_buffer_at(&se,0)==31.0)
 i=0
 while i<n {assert(numeric_buffer_at(&leverage,i)==27.0);i=i+1}
 numeric_buffer_close(a)
 numeric_buffer_close(y)
 integer_buffer_close(ids)
 numeric_buffer_close(beta)
 numeric_buffer_close(covariance)
 numeric_buffer_close(se)
 numeric_buffer_close(leverage)
 numeric_buffer_close(work)
 integer_buffer_close(order)
}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 assert(dynamic_robust_workspace(1,1).status==1)
 var kind:i64=0
 while kind<7 {robust_status(kind);kind=kind+1}
 println("DEEP DYNAMIC ROBUST STATUS PASS")
 0
}
