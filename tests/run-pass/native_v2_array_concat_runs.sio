//@ run-pass
//@ requires: madaros
//@ expect-stdout: ARRAY_CONCAT_OK
// Dynamic + fixed array concatenation via the array_concat builtin
// (heap alloc + copy). Covers i64, f64 (float-marked), and empty sides.

fn sum_i64(xs: [i64]) -> i64 with Mut, Div {
    var acc: i64 = 0
    var i: i64 = 0
    while i < xs.len() with Mut {
        acc = acc + xs[i]
        i = i + 1
    }
    acc
}

fn sum_f64(xs: [f64]) -> f64 with Mut, Div {
    var acc: f64 = 0.0
    var i: i64 = 0
    while i < xs.len() with Mut {
        acc = acc + xs[i]
        i = i + 1
    }
    acc
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var a: [i64] = []
    a = a ++ [10]
    a = a ++ [20, 30]
    if a.len() != 3 { return 2 }
    if sum_i64(a) != 60 { return 3 }
    var e: [i64] = []
    let z = e ++ a
    if z.len() != 3 { return 4 }
    if z[0] != 10 { return 5 }
    if z[2] != 30 { return 6 }
    var f: [f64] = []
    f = f ++ [1.5]
    f = f ++ [2.5, 3.0]
    if f.len() != 3 { return 7 }
    let sf = sum_f64(f)
    if sf < 6.9 { return 8 }
    if sf > 7.1 { return 9 }
    print("ARRAY_CONCAT_OK\n")
    0
}
