//@ run-pass
//@ requires: madaros
//@ expect-stdout: ARRAY_CONCAT_OK
// Dynamic array concatenation via the array_concat builtin
// (heap alloc + copy). Covers i64, float-marked f64, and empty sides.

fn main() -> i32 with IO, Mut, Div, Panic {
    var a: [i64] = []
    a = a ++ [10]
    a = a ++ [20, 30]
    if a.len() != 3 { return 2 }
    var s: i64 = 0
    var i: i64 = 0
    while i < a.len() with Mut {
        s = s + a[i]
        i = i + 1
    }
    if s != 60 { return 3 }
    var e: [i64] = []
    let z = e ++ a
    if z.len() != 3 { return 4 }
    if z[0] != 10 { return 5 }
    if z[2] != 30 { return 6 }
    var f: [f64] = []
    f = f ++ [1.5]
    f = f ++ [2.5, 3.0]
    if f.len() != 3 { return 7 }
    let sf = f[0] + f[1] + f[2]
    if sf < 6.9 { return 8 }
    if sf > 7.1 { return 9 }
    print("ARRAY_CONCAT_OK\n")
    0
}
