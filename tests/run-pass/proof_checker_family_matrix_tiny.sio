//@ run-pass
//@ description: Self-contained proof-checker family runtime matrix

fn proof_checker_family_matrix_check(
    solver_proof_profile_fp: i64,
    solver_proof_profile_audit_fp: i64,
    imported_runtime_lift_contract_fp: i64,
    imported_runtime_lift_contract_audit_fp: i64,
    planned_family_mask: i64,
    sat_lrat_runtime_mask: i64,
    sat_frat_runtime_mask: i64,
    pb_veripb_runtime_mask: i64,
    smt_farkas_runtime_mask: i64,
    lorenz_i256_runtime_mask: i64,
    current_runtime_family_mask: i64,
    missing_runtime_family_mask: i64,
    imported_runtime_promotion_mask: i64,
    portable_runtime_evidence_mask: i64,
    public_claim_mask: i64,
    global_flowpipe_claim_mask: i64,
    finite_cover_certificate_mask: i64,
    boundary_gluing_proof_mask: i64,
    formal_theorem_ready: i64) -> i64 {
    if solver_proof_profile_fp != 964210753 { return 0 - 1 }
    if solver_proof_profile_audit_fp != 526184309 { return 0 - 1 }
    if imported_runtime_lift_contract_fp != 642810357 { return 0 - 1 }
    if imported_runtime_lift_contract_audit_fp != 508176294 { return 0 - 1 }
    if planned_family_mask != 31 { return 0 - 1 }
    if sat_lrat_runtime_mask != 0 { return 0 - 1 }
    if sat_frat_runtime_mask != 0 { return 0 - 1 }
    if pb_veripb_runtime_mask != 0 { return 0 - 1 }
    if smt_farkas_runtime_mask != 0 { return 0 - 1 }
    if lorenz_i256_runtime_mask != 0 { return 0 - 1 }
    if current_runtime_family_mask != 0 { return 0 - 1 }
    if missing_runtime_family_mask != 31 { return 0 - 1 }
    if imported_runtime_promotion_mask != 0 { return 0 - 1 }
    if portable_runtime_evidence_mask != 0 { return 0 - 1 }
    if public_claim_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if formal_theorem_ready != 0 { return 0 - 1 }
    return 193746582
}

fn main() -> i64 {
    let artifact = proof_checker_family_matrix_check(
        964210753, 526184309, 642810357, 508176294, 31, 0, 0, 0, 0, 0, 0,
        31, 0, 0, 0, 0, 0, 0, 0)
    if artifact != 193746582 { return 1 }

    let audit_fp: i64 = 682540913
    let instance_fp: i64 = 471829306
    let certificate_fp: i64 = 902174635
    let private_envelope_fp: i64 = 834620917
    let private_envelope_audit_fp: i64 = 276591483
    let solver_proof_profile_status: i64 = 88
    let imported_runtime_lift_status: i64 = 95
    let private_envelope_status: i64 = 94
    let family_anchor_mask: i64 = 63
    let required_planned_family_mask: i64 = 31
    let required_current_runtime_family_mask: i64 = 0
    let required_missing_runtime_family_mask: i64 = 31
    let required_imported_runtime_promotion_mask: i64 = 0
    let required_portable_runtime_evidence_mask: i64 = 0
    let required_family_matrix_next_action_mask: i64 = 31
    let family_matrix_status: i64 = 96
    let ok_mask: i64 = 1023

    if audit_fp != 682540913 { return 2 }
    if instance_fp != 471829306 { return 3 }
    if certificate_fp != 902174635 { return 4 }
    if private_envelope_fp != 834620917 { return 5 }
    if private_envelope_audit_fp != 276591483 { return 6 }
    if solver_proof_profile_status != 88 { return 7 }
    if imported_runtime_lift_status != 95 { return 8 }
    if private_envelope_status != 94 { return 9 }
    if family_anchor_mask != 63 { return 10 }
    if required_planned_family_mask != 31 { return 11 }
    if required_current_runtime_family_mask != 0 { return 12 }
    if required_missing_runtime_family_mask != 31 { return 13 }
    if required_imported_runtime_promotion_mask != 0 { return 14 }
    if required_portable_runtime_evidence_mask != 0 { return 15 }
    if required_family_matrix_next_action_mask != 31 { return 16 }
    if family_matrix_status != 96 { return 17 }
    if ok_mask != 1023 { return 18 }

    let fake_lrat_runtime = proof_checker_family_matrix_check(
        964210753, 526184309, 642810357, 508176294, 31, 1, 0, 0, 0, 0, 0,
        31, 0, 0, 0, 0, 0, 0, 0)
    if fake_lrat_runtime != 0 - 1 { return 19 }

    let fake_lorenz_runtime = proof_checker_family_matrix_check(
        964210753, 526184309, 642810357, 508176294, 31, 0, 0, 0, 0, 1, 0,
        31, 0, 0, 0, 0, 0, 0, 0)
    if fake_lorenz_runtime != 0 - 1 { return 20 }

    let fake_runtime_family = proof_checker_family_matrix_check(
        964210753, 526184309, 642810357, 508176294, 31, 0, 0, 0, 0, 0, 1,
        31, 0, 0, 0, 0, 0, 0, 0)
    if fake_runtime_family != 0 - 1 { return 21 }

    let fake_promotion = proof_checker_family_matrix_check(
        964210753, 526184309, 642810357, 508176294, 31, 0, 0, 0, 0, 0, 0,
        31, 1, 0, 0, 0, 0, 0, 0)
    if fake_promotion != 0 - 1 { return 22 }

    let fake_public_claim = proof_checker_family_matrix_check(
        964210753, 526184309, 642810357, 508176294, 31, 0, 0, 0, 0, 0, 0,
        31, 0, 0, 1, 0, 0, 0, 0)
    if fake_public_claim != 0 - 1 { return 23 }

    return 0
}
