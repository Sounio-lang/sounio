//@ run-pass
//@ requires: madaros
//@ description: KL-20 -- nested payload enums, a payload enum inside Option<T> and Option<T> inside a payload, unit-enum and literal sub-patterns, or-patterns over payload variants, guards, and payload enums stored in struct fields
//@ expect-stdout: inner=30
//@ expect-stdout: some_circle=3
//@ expect-stdout: opt_inside=8
//@ expect-stdout: opt_none=-1
//@ expect-stdout: color=2
//@ expect-stdout: lit=100
//@ expect-stdout: or=11
//@ expect-stdout: guard=5
//@ expect-stdout: field=9
//@ expect-stdout: kind_field=4

enum Color { Red, Green, Blue }
enum Leaf { Val(i64), Paint(Color), Nil }
enum Node { Wrap(Leaf), Two(Leaf, Leaf), MaybeN(Option<i64>), Code(i64) }
enum Shape { Circle(i64), Square(i64), Dot }
struct Holder { s: Shape, tag: i64 }
struct Tagged { kind: Shape, n: i64 }

fn inner_sum(n: Node) -> i64 {
    match n {
        Node::Two(Leaf::Val(a), Leaf::Val(b)) => a + b,
        Node::Wrap(Leaf::Val(a)) => a,
        _ => 0,
    }
}

fn opt_val(n: &Node) -> i64 {
    match n {
        Node::MaybeN(Some(v)) => v,
        Node::MaybeN(None) => 0 - 1,
        _ => 0 - 2,
    }
}

fn color_code(n: Node) -> i64 {
    match n {
        Node::Wrap(Leaf::Paint(Color::Red)) => 1,
        Node::Wrap(Leaf::Paint(Color::Green)) => 2,
        Node::Wrap(Leaf::Paint(_)) => 3,
        _ => 0,
    }
}

fn lit(n: Node) -> i64 {
    match n {
        Node::Code(0) => 0,
        Node::Code(7) => 100,
        Node::Code(_) => 50,
        _ => 0 - 1,
    }
}

fn round(s: Shape) -> i64 {
    match s {
        Shape::Circle(_) | Shape::Dot => 1,
        Shape::Square(_) => 10,
    }
}

fn big(s: Shape) -> i64 {
    match s {
        Shape::Square(k) if k > 3 => k,
        Shape::Square(_) => 0,
        _ => 0 - 1,
    }
}

fn main() -> i32 with IO {
    print("inner=")
    println(inner_sum(Node::Two(Leaf::Val(10), Leaf::Val(20))))
    let o: Option<Shape> = Some(Shape::Circle(3))
    match o {
        Some(Shape::Circle(r)) => { print("some_circle="); println(r) }
        Some(_) => println("bad"),
        None => println("bad"),
    }
    print("opt_inside=")
    println(opt_val(&Node::MaybeN(Some(8))))
    print("opt_none=")
    println(opt_val(&Node::MaybeN(None)))
    print("color=")
    println(color_code(Node::Wrap(Leaf::Paint(Color::Green))))
    print("lit=")
    println(lit(Node::Code(7)))
    print("or=")
    println(round(Shape::Dot) + round(Shape::Square(2)))
    print("guard=")
    println(big(Shape::Square(5)) + big(Shape::Square(2)))
    let h = Holder { s: Shape::Square(9), tag: 1 }
    print("field=")
    match h.s {
        Shape::Square(k) => println(k),
        _ => println(0),
    }
    let tg = Tagged { kind: Shape::Circle(4), n: 2 }
    print("kind_field=")
    match tg.kind {
        Shape::Circle(r) => println(r),
        _ => println(0),
    }
    0
}
