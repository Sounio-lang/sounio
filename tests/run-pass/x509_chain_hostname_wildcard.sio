        0x4C, 0x6D, 0x5D, 0x8C, 0xEE, 0xDB, 0xDF, 0x24, 0x14, 0x4E, 0x75, 0xDD,
        0xDF, 0xD6, 0xF7, 0xCC, 0xF1, 0x71, 0x84, 0x90, 0x07, 0xE9, 0x51, 0xFA,
        0x04, 0x57, 0x26, 0x9F, 0xC8, 0x8B, 0xCB, 0xDE, 0x36, 0xE0, 0xBC, 0xBA,
        0xFF, 0x79, 0x8B, 0xFC, 0x87, 0x26, 0x16, 0xFC, 0x87, 0x58, 0xFC, 0xAC,
        0x58, 0x48, 0xB9, 0xE8, 0xA8, 0xA3, 0xDF, 0x94, 0x0D, 0xA4, 0xE9,
    ]

    let buf = rawbuf_new(cf_der_len + 8)
    var i: i64 = 0
    while i < cf_der_len { rawbuf_set(&buf, i, cf_der_bytes[i as usize] as i64); i = i + 1 }
    let (cert, e) = x509_parse_certificate(&buf, cf_der_len)
    if e != X509_OK { panic("cf_leaf: parse failed") }
    cert
}

fn make_hostname(text: string, len: i64) -> RawBuf with IO, Mut {
    let buf = rawbuf_new(64)
    var i: i64 = 0
    while i < len {
        rawbuf_set(&buf, i, str_char_at(text, i))
        i = i + 1
    }
    buf
}

fn check(cert: &Certificate, hostname_text: string, hostname_len: i64, expect: bool, case_name: string) -> bool with IO, Mut {
    let buf = make_hostname(hostname_text, hostname_len)
    let got = x509_verify_hostname(cert, &buf, hostname_len)
    if got != expect {
        print("FAIL: "); println(case_name)
        false
    } else {
        true
    }
}

fn main() -> i64 with IO, Mut {
    let wc = wc_leaf()
    let cf = cf_leaf()

    var ok: bool = true

    // *.example.com vs foo.example.com (different lengths) -- match.
    if !check(&wc, "foo.example.com", 15, true, "wildcard vs foo.example.com") { ok = false }

    // *.example.com vs a.example.com -- SAME length as the pattern (13
    // bytes each): this is the case that was silently broken pre-fix
    // (exact-match branch ran instead of wildcard, byte-compare failed,
    // wildcard branch never reached).
    if !check(&wc, "a.example.com", 13, true, "wildcard vs a.example.com (same-length collision case)") { ok = false }

    // *.example.com vs foo.bar.example.com -- wildcard covers exactly one
    // label; must NOT match a deeper subdomain.
    if !check(&wc, "foo.bar.example.com", 19, false, "wildcard vs foo.bar.example.com (must not match)") { ok = false }

    // *.example.com vs example.com (bare domain) -- must NOT match; a
    // wildcard never matches the domain with no subdomain label at all.
    if !check(&wc, "example.com", 11, false, "wildcard vs bare example.com (must not match)") { ok = false }

    // www.example.com (exact, no wildcard) vs WWW.EXAMPLE.COM -- must
    // match via ASCII case-folding (Finding 3).
    if !check(&cf, "WWW.EXAMPLE.COM", 15, true, "case-fold WWW.EXAMPLE.COM vs www.example.com") { ok = false }

    if !ok {
        return 1
    }

    println("x509_chain_hostname_wildcard: same-length wildcard collision and case-folding both verified")
    return 0
}
