//@ run-pass
//@ requires: madaros

// Regression test for final-plan-review Findings 2 (IMPORTANT, real bug)
// and 3 (MINOR) in `x509_verify_hostname` (stdlib/x509/chain.sio).
//
// Finding 2: the original code used `if (san.value_len as i64) ==
// hostname_len { <exact match> } else if <wildcard prefix> { <wildcard
// match> }`. Whenever the SAN pattern and the checked hostname happened to
// be the SAME LENGTH -- e.g. "*.example.com" (13 bytes) vs
// "a.example.com" (13 bytes) -- only the exact-match branch ran, the
// byte-compare failed (they are not identical strings), and the wildcard
// branch that WOULD have matched was never even attempted. Fixed by
// trying both checks independently (no `else`).
//
// Finding 3: hostname comparison must be case-insensitive (DNS names are
// case-insensitive per RFC 1035 / RFC 6125); both branches now ASCII
// case-fold before comparing.
//
// Fixtures, real openssl (no fabricated bytes):
//
//   openssl genrsa -out root.key 2048
//   openssl req -x509 -new -key root.key -days 3650 -out root.pem \
//     -subj "/CN=Test Root CA HWC" -addext "basicConstraints=critical,CA:true"
//   openssl genrsa -out leaf.key 2048
//   openssl req -new -key leaf.key -out leaf.csr -subj "/CN=wildcard-host-test"
//   openssl x509 -req -in leaf.csr -CA root.pem -CAkey root.key -CAcreateserial \
//     -days 365 -out leaf.pem \
//     -extfile <(printf 'basicConstraints=CA:false\nsubjectAltName=DNS:*.example.com\n')
//   openssl x509 -in leaf.pem -outform DER -out leaf.der   # 817 bytes; SAN=DNS:*.example.com
//
//   openssl genrsa -out leaf2.key 2048
//   openssl req -new -key leaf2.key -out leaf2.csr -subj "/CN=case-fold-test"
//   openssl x509 -req -in leaf2.csr -CA root.pem -CAkey root.key -CAcreateserial \
//     -days 365 -out leaf2.pem \
//     -extfile <(printf 'basicConstraints=CA:false\nsubjectAltName=DNS:www.example.com\n')
//   openssl x509 -in leaf2.pem -outform DER -out leaf2.der # 815 bytes; SAN=DNS:www.example.com
//
// Only `x509_verify_hostname` itself is under test here (not the full
// chain), so no trust store / timestamp / signature plumbing is needed --
// just the parsed leaf certificate and a hostname buffer.

