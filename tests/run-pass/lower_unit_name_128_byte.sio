//@ run-pass
//@ requires: madaros
//@ expect-stdout: 250.000000
// lower_unit_names_add/_index stored unit names in 64-byte slots and refused
// (len > 64) anything longer -- but the parser accepts identifiers up to 128
// bytes (parser_name_at), and the checker stores/recognizes the full Name, so a
// 65-128 byte `unit X;` name reached the checker as a real f64-carrying unit
// while this lowering-side table silently dropped it. lower_type_expr_is_f64
// then answered "not float" for it, and a call returning that unit lowered as
// an integer: the exact corruption this table exists to prevent, just past a
// narrower-than-necessary width. Table now matches the parser's own 128-byte cap.
// Name is 100 bytes -- inside the parser's 128-byte cap, past the old 64.

unit Qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx;

fn g() -> Qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx with Mut {
    return 250.0
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let r = g()
    print_f64(r as f64)
    print("\n")
    return 0
}
