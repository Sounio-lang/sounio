//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-1 Taylor-2 replay preflight checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step1_taylor2_replay_preflight_check(
        174108453, 620127047, 15, 15, 15, 15, 6, 0)
    if artifact_fp != 261545659 { return 1 }
    let audit_fp = lorenz_i256_step1_taylor2_replay_preflight_audit_fingerprint(
        artifact_fp, 674339367, 972235050, 174108453, 516721287, 1, 6, 255, 0, 0)
    if audit_fp != 928945135 { return 2 }
    return 0
}
