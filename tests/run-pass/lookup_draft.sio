//@ run-pass
//
// M1 lookup drafter test: prompt-lookup draft from token history.
// No model needed: hand-built histories, exact draft assertions.
use llm::attn_gpu::llama_lookup_draft
use tensor2::cpu_kernel::{CpuBuf, ck_alloc, ck_get, ck_set}

fn main() with IO, Mut, Panic, Div, Alloc {
    var ok = true
    // hist [1,2,3,1,2]: suffix [1,2] matches at 0, draft [3,1,2]
    var h = ck_alloc(8)
    ck_set(&!h, 0, 1.0)
    ck_set(&!h, 1, 2.0)
    ck_set(&!h, 2, 3.0)
    ck_set(&!h, 3, 1.0)
    ck_set(&!h, 4, 2.0)
    var d = ck_alloc(4)
    if llama_lookup_draft(&h, 5, 4, &!d) != 3 { ok = false }
    if ck_get(&d, 0) as i64 != 3 { ok = false }
    if ck_get(&d, 1) as i64 != 1 { ok = false }
    if ck_get(&d, 2) as i64 != 2 { ok = false }
    // k cap: same hist, k=2 gives [3,1]
    var d2 = ck_alloc(4)
    if llama_lookup_draft(&h, 5, 2, &!d2) != 2 { ok = false }
    if ck_get(&d2, 0) as i64 != 3 { ok = false }
    if ck_get(&d2, 1) as i64 != 1 { ok = false }
    // all distinct [7,8,9,4]: no repeat, returns 0
    var h2 = ck_alloc(4)
    ck_set(&!h2, 0, 7.0)
    ck_set(&!h2, 1, 8.0)
    ck_set(&!h2, 2, 9.0)
    ck_set(&!h2, 3, 4.0)
    var d3 = ck_alloc(4)
    if llama_lookup_draft(&h2, 4, 4, &!d3) != 0 { ok = false }
    // degenerate: hlen < 2 returns 0
    var d4 = ck_alloc(4)
    if llama_lookup_draft(&h2, 1, 4, &!d4) != 0 { ok = false }
    if ok { print("LOOKUP PASS") } else { print("LOOKUP FAIL") }
    print("\n")
    if !ok { exit(1) }
    exit(0)
}
