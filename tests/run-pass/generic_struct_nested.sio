//@ run-pass
// Test: nested generic struct

struct Wrapper<T> {
    inner: T,
    tag: i64,
}

fn main() with IO {
    let w = Wrapper { inner: 99, tag: 1 }
    // Explicit annotations: a generic field print loses the scalar kind at
    // print dispatch (#2354); the typed binding restores it.
    let inner: i64 = w.inner
    let tag: i64 = w.tag
    println(inner)
    println(tag)
}
