//@ run-pass
//@ requires: madaros
//@ description: Five-step Lorenz i256 quotient/remainder witness chain without source-level i256 division

fn chain_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn lorenz_i256_step5_certificate_fingerprint(start_x: i64, start_y: i64, start_z: i64,
                                             dy_scaled_q: i64, dy_scaled_r: i64,
                                             xy_scaled_q: i64, xy_scaled_r: i64,
                                             beta_q: i64, beta_r: i64,
                                             x_inc_q: i64, x_inc_r: i64,
                                             y_inc_q: i64, y_inc_r: i64,
                                             z_drop_q: i64, z_drop_r: i64,
                                             final_x: i64, final_y: i64, final_z: i64,
                                             all_divisions_ok: i64) -> i64 with Mod {
    if start_x != 4920371098 { return 0 - 1 }
    if start_y != 8816077911 { return 0 - 1 }
    if start_z != 4092986080 { return 0 - 1 }
    if dy_scaled_q != 133081411987 { return 0 - 1 }
    if dy_scaled_r != 405415232 { return 0 - 1 }
    if xy_scaled_q != 10099814960 { return 0 - 1 }
    if xy_scaled_r != 2149068118 { return 0 - 1 }
    if beta_q != 10914629546 { return 0 - 1 }
    if beta_r != 2 { return 0 - 1 }
    if x_inc_q != 389570672 { return 0 - 1 }
    if x_inc_r != 2544410448 { return 0 - 1 }
    if y_inc_q != 1242653312 { return 0 - 1 }
    if y_inc_r != 4228538720 { return 0 - 1 }
    if z_drop_q != 8148145 { return 0 - 1 }
    if z_drop_r != 2911449872 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }
    if all_divisions_ok != 1 { return 0 - 1 }

    var fp: i64 = 233
    fp = chain_mix(fp, start_x, 1601)
    fp = chain_mix(fp, start_y, 1601)
    fp = chain_mix(fp, start_z, 1601)
    fp = chain_mix(fp, dy_scaled_q, 1601)
    fp = chain_mix(fp, dy_scaled_r, 1601)
    fp = chain_mix(fp, xy_scaled_q, 1601)
    fp = chain_mix(fp, xy_scaled_r, 1601)
    fp = chain_mix(fp, beta_q, 1601)
    fp = chain_mix(fp, beta_r, 1601)
    fp = chain_mix(fp, x_inc_q, 1601)
    fp = chain_mix(fp, x_inc_r, 1601)
    fp = chain_mix(fp, y_inc_q, 1601)
    fp = chain_mix(fp, y_inc_r, 1601)
    fp = chain_mix(fp, z_drop_q, 1601)
    fp = chain_mix(fp, z_drop_r, 1601)
    fp = chain_mix(fp, final_x, 1601)
    fp = chain_mix(fp, final_y, 1601)
    fp = chain_mix(fp, final_z, 1601)
    fp = chain_mix(fp, all_divisions_ok, 1601)
    return fp
}

fn lorenz_i256_five_step_chain_fingerprint(step_count: i64,
                                            step1_certificate_fp: i64,
                                            step2_certificate_fp: i64,
                                            step3_certificate_fp: i64,
                                            step4_certificate_fp: i64,
                                            step5_certificate_fp: i64,
                                            final_x: i64, final_y: i64,
                                            final_z: i64) -> i64 with Mod {
    if step_count != 5 { return 0 - 1 }
    if step1_certificate_fp != 510854875 { return 0 - 1 }
    if step2_certificate_fp != 899209716 { return 0 - 1 }
    if step3_certificate_fp != 603078026 { return 0 - 1 }
    if step4_certificate_fp != 753371133 { return 0 - 1 }
    if step5_certificate_fp != 561641681 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }

    var fp: i64 = 239
    fp = chain_mix(fp, step_count, 1613)
    fp = chain_mix(fp, step1_certificate_fp, 1613)
    fp = chain_mix(fp, step2_certificate_fp, 1613)
    fp = chain_mix(fp, step3_certificate_fp, 1613)
    fp = chain_mix(fp, step4_certificate_fp, 1613)
    fp = chain_mix(fp, step5_certificate_fp, 1613)
    fp = chain_mix(fp, final_x, 1613)
    fp = chain_mix(fp, final_y, 1613)
    fp = chain_mix(fp, final_z, 1613)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256

    let x4: i256 = 4920371098 as i256
    let y4: i256 = 8816077911 as i256
    let z4: i256 = 4092986080 as i256
    let rho: i256 = 28 as i256

    let dx_num: i256 = (10 as i256) * (y4 - x4)
    let rho_scale_minus_z: i256 = (rho * scale) - z4
    let dy_num: i256 = x4 * rho_scale_minus_z
    let xy_num: i256 = x4 * y4
    let beta_num_z: i256 = (8 as i256) * z4

    let dy_scaled_q: i256 = 133081411987 as i256
    let dy_scaled_r: i256 = 405415232 as i256
    let xy_scaled_q: i256 = 10099814960 as i256
    let xy_scaled_r: i256 = 2149068118 as i256
    let beta_q: i256 = 10914629546 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 389570672 as i256
    let x_inc_r: i256 = 2544410448 as i256
    let y_inc_q: i256 = 1242653312 as i256
    let y_inc_r: i256 = 4228538720 as i256
    let z_drop_q: i256 = 8148145 as i256
    let z_drop_r: i256 = 2911449872 as i256

    let dy: i256 = dy_scaled_q - y4
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    let dy_scaled_ok = check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r)
    let xy_scaled_ok = check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r)
    let beta_ok = check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r)
    let x_inc_ok = check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r)
    let y_inc_ok = check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r)
    let z_drop_ok = check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r)

    var all_divisions_ok: i64 = 0
    if dy_scaled_ok == 1 {
        if xy_scaled_ok == 1 {
            if beta_ok == 1 {
                if x_inc_ok == 1 {
                    if y_inc_ok == 1 {
                        if z_drop_ok == 1 { all_divisions_ok = 1 }
                    }
                }
            }
        }
    }

    let x5: i256 = x4 + x_inc_q
    let y5: i256 = y4 + y_inc_q
    let z5: i256 = z4 - z_drop_q

    let step5_fp = lorenz_i256_step5_certificate_fingerprint(
        4920371098, 8816077911, 4092986080,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449872,
        5309941770, 10058731223, 4084837935, all_divisions_ok)
    let chain_fp = lorenz_i256_five_step_chain_fingerprint(
        5, 510854875, 899209716, 603078026, 753371133, step5_fp,
        5309941770, 10058731223, 4084837935)

    if all_divisions_ok != 1 { return 1 }
    if dx_num != 38957068130 as i256 { return 2 }
    if dy != 124265334076 as i256 { return 3 }
    if dz_drop_num != 814814586 as i256 { return 4 }
    if x5 != 5309941770 as i256 { return 5 }
    if y5 != 10058731223 as i256 { return 6 }
    if z5 != 4084837935 as i256 { return 7 }
    if step5_fp != 561641681 { return 8 }
    if chain_fp != 23144051 { return 9 }

    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, 3 as i256) != 0 { return 10 }
    if lorenz_i256_step5_certificate_fingerprint(
        4920371098, 8816077911, 4092986080,
        133081411987, 405415232, 10099814960, 2149068118,
        10914629546, 2, 389570672, 2544410448,
        1242653312, 4228538720, 8148145, 2911449871,
        5309941770, 10058731223, 4084837935, all_divisions_ok) != (0 - 1) { return 11 }
    if lorenz_i256_five_step_chain_fingerprint(
        5, 510854875, 899209716, 603078026, 753371133, step5_fp,
        5309941770, 10058731224, 4084837935) != (0 - 1) { return 12 }

    return 0
}
