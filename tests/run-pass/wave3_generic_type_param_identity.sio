//@ run-pass
//@ requires: madaros
//@ expect-stdout: GENERIC_TYPE_PARAM_IDENTITY_OK
struct CollisionPair<ab,bA> {left:ab,right:bA}
fn context_identity<T>(value:T)->T {value}
fn main()->i32 with IO,Mut,Alloc,Div,Panic {
    let pair:CollisionPair<i64,f64> =CollisionPair{left:7,right:1.25}
    let result=context_identity::<CollisionPair<i64,f64>>(pair)
    if result.left!=7 || result.right!=1.25 {return 1}
    println("GENERIC_TYPE_PARAM_IDENTITY_OK")
    return 0
}

