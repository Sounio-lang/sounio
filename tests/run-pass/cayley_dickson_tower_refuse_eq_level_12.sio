//@ run-pass
//@ requires: madaros
//@ exit-code: 1
//@ description: cd_eq on two level-12 elements would walk 4096 slots of a 2048-slot array; cd_zero refuses the level (panic) before any loop or shift runs
// Without the cd_zero level check this program prints UNREACHED and exits 0.

use algebra::cayley_dickson::*
use algebra::cayley_dickson_tower::*

fn main() with IO, Mut, Panic, Div {
    let r = cd_eq(cd_zero(12), cd_zero(12))
    println("UNREACHED")
}
