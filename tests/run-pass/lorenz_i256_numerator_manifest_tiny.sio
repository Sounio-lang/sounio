//@ run-pass
//@ known-failure: source-level i256 Lorenz numerator manifest tiny case: main returns 1. Not a segfault/139
//@ requires: madaros
//@ description: Lorenz i256 pre-division numerator certificate manifest

fn manifest_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn lorenz_i256_numerator_instance_fingerprint(scale_log2: i64, rho: i64,
                                              beta_num: i64, variable_count: i64,
                                              x_is_scale: i64, y_is_scale: i64,
                                              z_is_scale: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if rho != 28 { return 0 - 1 }
    if beta_num != 8 { return 0 - 1 }
    if variable_count != 3 { return 0 - 1 }
    if x_is_scale != 1 { return 0 - 1 }
    if y_is_scale != 1 { return 0 - 1 }
    if z_is_scale != 1 { return 0 - 1 }

    var fp: i64 = 109
    fp = manifest_mix(fp, scale_log2, 1171)
    fp = manifest_mix(fp, rho, 1171)
    fp = manifest_mix(fp, beta_num, 1171)
    fp = manifest_mix(fp, variable_count, 1171)
    fp = manifest_mix(fp, x_is_scale, 1171)
    fp = manifest_mix(fp, y_is_scale, 1171)
    fp = manifest_mix(fp, z_is_scale, 1171)
    return fp
}

fn lorenz_i256_numerator_certificate_fingerprint(instance_fp: i64,
                                                 identity_count: i64,
                                                 rho_minus_ok: i64,
                                                 xy_ok: i64,
                                                 dy_ok: i64,
                                                 beta_ok: i64,
                                                 order_ok: i64) -> i64 with Mod {
    if instance_fp != 300929056 { return 0 - 1 }
    if identity_count != 5 { return 0 - 1 }
    if rho_minus_ok != 1 { return 0 - 1 }
    if xy_ok != 1 { return 0 - 1 }
    if dy_ok != 1 { return 0 - 1 }
    if beta_ok != 1 { return 0 - 1 }
    if order_ok != 1 { return 0 - 1 }

    var fp: i64 = 113
    fp = manifest_mix(fp, instance_fp, 1201)
    fp = manifest_mix(fp, identity_count, 1201)
    fp = manifest_mix(fp, rho_minus_ok, 1201)
    fp = manifest_mix(fp, xy_ok, 1201)
    fp = manifest_mix(fp, dy_ok, 1201)
    fp = manifest_mix(fp, beta_ok, 1201)
    fp = manifest_mix(fp, order_ok, 1201)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale
    let rho: i256 = 28 as i256

    let rho_scale_minus_z: i256 = (rho * scale) - z
    let dy_num: i256 = x * rho_scale_minus_z
    let xy_num: i256 = x * y
    let beta_num_z: i256 = (8 as i256) * z
    let expected_square: i256 = scale * scale

    var rho_minus_ok: i64 = 0
    var xy_ok: i64 = 0
    var dy_ok: i64 = 0
    var beta_ok: i64 = 0
    var order_ok: i64 = 0

    if rho_scale_minus_z == (27 as i256) * scale { rho_minus_ok = 1 }
    if xy_num == expected_square { xy_ok = 1 }
    if dy_num == (27 as i256) * expected_square { dy_ok = 1 }
    if beta_num_z == (8 as i256) * scale { beta_ok = 1 }
    if dy_num > xy_num {
        if expected_square > scale { order_ok = 1 }
    }

    let instance_fp = lorenz_i256_numerator_instance_fingerprint(32, 28, 8, 3, 1, 1, 1)
    let cert_fp = lorenz_i256_numerator_certificate_fingerprint(
        instance_fp, 5, rho_minus_ok, xy_ok, dy_ok, beta_ok, order_ok)

    if rho_minus_ok != 1 { return 1 }
    if xy_ok != 1 { return 2 }
    if dy_ok != 1 { return 3 }
    if beta_ok != 1 { return 4 }
    if order_ok != 1 { return 5 }
    if instance_fp != 300929056 { return 6 }
    if cert_fp != 572148472 { return 7 }
    if lorenz_i256_numerator_certificate_fingerprint(
        instance_fp, 5, rho_minus_ok, xy_ok, 0, beta_ok, order_ok) != (0 - 1) { return 8 }
    if lorenz_i256_numerator_instance_fingerprint(31, 28, 8, 3, 1, 1, 1) != (0 - 1) { return 9 }

    return 0
}
