//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 boundary face preflight bundle

fn child4_boundary_face_preflight_bundle_check(
    child4_boundary_face4_preflight_fp: i64,
    child4_boundary_face4_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    face_preflight_progress_mask: i64,
    face_verified_mask: i64,
    face_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    bundle_status: i64) -> i64 {
    if child4_boundary_face4_preflight_fp != 486720951 { return 0 - 1 }
    if child4_boundary_face4_preflight_audit_fp != 730519284 { return 0 - 1 }
    if child4_boundary_face_obligations_fp != 458306927 { return 0 - 1 }
    if child4_boundary_face_obligations_audit_fp != 766184391 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if face_obligation_mask != 31 { return 0 - 1 }
    if face_preflight_progress_mask != 31 { return 0 - 1 }
    if face_verified_mask != 0 { return 0 - 1 }
    if face_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if bundle_status != 86 { return 0 - 1 }
    return 812640573
}

fn main() -> i64 {
    let artifact = child4_boundary_face_preflight_bundle_check(
        486720951, 730519284, 458306927, 766184391, 31, 31, 31,
        0, 0, 0, 0, 0, 0, 0, 86)
    if artifact != 812640573 { return 1 }

    let audit_fp: i64 = 294736811
    let instance_fp: i64 = 673205948
    let certificate_fp: i64 = 138729456
    let boundary_face_count: i64 = 5
    let face_preflight_bundle_mask: i64 = 31
    let face_preflight_dependency_mask: i64 = 31
    let face_preflight_trace_mask: i64 = 31
    let face_preflight_ready_mask: i64 = 31
    let face_pending_proof_mask: i64 = 31
    let solver_boundary_next_action_mask: i64 = 31
    let ready_for_boundary_gluing_proof_mask: i64 = 0
    let ok_mask: i64 = 255

    if audit_fp != 294736811 { return 2 }
    if instance_fp != 673205948 { return 3 }
    if certificate_fp != 138729456 { return 4 }
    if boundary_face_count != 5 { return 5 }
    if face_preflight_bundle_mask != 31 { return 6 }
    if face_preflight_dependency_mask != 31 { return 7 }
    if face_preflight_trace_mask != 31 { return 8 }
    if face_preflight_ready_mask != 31 { return 9 }
    if face_pending_proof_mask != 31 { return 10 }
    if solver_boundary_next_action_mask != 31 { return 11 }
    if ready_for_boundary_gluing_proof_mask != 0 { return 12 }
    if ok_mask != 255 { return 13 }

    let wrong_face4 = child4_boundary_face_preflight_bundle_check(
        1, 730519284, 458306927, 766184391, 31, 31, 31,
        0, 0, 0, 0, 0, 0, 0, 86)
    if wrong_face4 != 0 - 1 { return 14 }

    let incomplete_preflight = child4_boundary_face_preflight_bundle_check(
        486720951, 730519284, 458306927, 766184391, 31, 31, 15,
        0, 0, 0, 0, 0, 0, 0, 86)
    if incomplete_preflight != 0 - 1 { return 15 }

    let fake_face_proof = child4_boundary_face_preflight_bundle_check(
        486720951, 730519284, 458306927, 766184391, 31, 31, 31,
        0, 1, 0, 0, 0, 0, 0, 86)
    if fake_face_proof != 0 - 1 { return 16 }

    let fake_boundary_gluing_proof = child4_boundary_face_preflight_bundle_check(
        486720951, 730519284, 458306927, 766184391, 31, 31, 31,
        0, 0, 0, 1, 0, 0, 0, 86)
    if fake_boundary_gluing_proof != 0 - 1 { return 17 }

    let fake_global = child4_boundary_face_preflight_bundle_check(
        486720951, 730519284, 458306927, 766184391, 31, 31, 31,
        0, 0, 0, 0, 0, 0, 1, 86)
    if fake_global != 0 - 1 { return 18 }

    return 0
}
