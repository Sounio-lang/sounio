//@ run-pass
struct Point { x: f64, y: f64 }
fn set_x(p: &! Point, v: f64) with Mut, Panic {
    (*p).x = v
}
fn set_y(p: &! Point, v: f64) with Mut, Panic {
    (*p).y = v
}
fn main() -> i32 with IO, Mut, Panic {
    var pt: Point = Point { x: 0.0, y: 0.0 }
    set_x(&! pt, 3.0)
    set_y(&! pt, 4.0)
    if pt.x == 3.0 && pt.y == 4.0 {
        println("explicit_deref_field: PASS")
        return 0
    }
    println("explicit_deref_field: FAIL")
    return 1
}
