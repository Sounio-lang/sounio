//@ run-pass
//@ expect-stdout: SCALED_PLOT_PASS
//@ expect-stdout: data-axis-scale="symlog"
//@ expect-stdout: data-axis-scale="log10"
//@ expect-stdout: data-x-scale="linear" data-y-scale="symlog"
//@ expect-stdout: DFFITS (symlog c=0.1)
//@ expect-stdout: theta (rad, log10)
use viz::plot::{viz_auto_plot_axes,viz_plot_share_domain}
use viz::scale::{ScaleSpec}
use viz::scaled_plot::{ScaledDomain,viz_add_scaled_plot}
use viz::ir::{viz_scene_new,viz_layout_rect,viz_style_rgb,viz_node_set_label,viz_add_series_legend,viz_line_set_viewport}
use viz::viz_html::{viz_html_emit_scene}
use viz::viz_canvas::{viz_canvas_render_scene}
use display::canvas::{Canvas,canvas_clear}
use stats::regression::ols::{ols_influence_simple}
use physics::scattering::{electron_compton_shift}
fn main() with IO, Mut, Div, Alloc, Panic {
    var x:[f64;100]=[0.0;100]
    var y:[f64;100]=[0.0;100]
    var i:i64=0
    while i < 8 {x[i as usize]=i as f64;y[i as usize]=2.0+3.0*(i as f64);i=i+1}
    y[1]=y[1]+0.5;y[4]=y[4]-0.25;y[7]=y[7]+2.0
    let d=ols_influence_simple(&x,&y,8)
    assert(d.status == 0)
    var xs:[f64;1024]=[0.0;1024]
    var ys:[f64;1024]=[0.0;1024]
    i=0
    while i < 8 {xs[i as usize]=(i+1) as f64;ys[i as usize]=d.dffits[i as usize];i=i+1}
    var scene=viz_scene_new()
    let domain=ScaledDomain{x_lo:0.0,x_hi:8.0,y_lo:-8.0,y_hi:8.0,
        x_scale:ScaleSpec{mode:0,constant:1.0},y_scale:ScaleSpec{mode:2,constant:0.1},
        x_intervals:4,y_intervals:4}
    let result=viz_add_scaled_plot(&!scene,&xs,&ys,8,&domain,
        viz_layout_rect(130,35,560,180),viz_style_rgb(80,180,240),viz_style_rgb(180,190,210))
    assert(result.status == 0 && result.chart == 0 && result.x_axis == 1 && result.y_axis == 2)
    assert(scene.node_count == 3 && scene.series_count == 1)
    assert(scene.nodes[2].flags == 5 && scene.nodes[2].min_value == -8.0)
    assert(scene.series[0].y_max > 4.39 && scene.series[0].y_max < 4.40)
    assert(ys[7] == d.dffits[7])
    assert(scene.nodes[2].value == 0.1)
    assert(!viz_line_set_viewport(&!scene,0,0.0,8.0,-8.0,8.0))
    assert(viz_auto_plot_axes(&!scene,0,viz_style_rgb(1,2,3)).status == 1)
    assert(!viz_plot_share_domain(&!scene,0,0))
    var xt:[i8;64]=[0;64]
    xt[0]=111
    xt[1]=98
    xt[2]=115
    xt[3]=101
    xt[4]=114
    xt[5]=118
    xt[6]=97
    xt[7]=116
    xt[8]=105
    xt[9]=111
    xt[10]=110
    var yt:[i8;64]=[0;64]
    yt[0]=68
    yt[1]=70
    yt[2]=70
    yt[3]=73
    yt[4]=84
    yt[5]=83
    yt[6]=32
    yt[7]=40
    yt[8]=115
    yt[9]=121
    yt[10]=109
    yt[11]=108
    yt[12]=111
    yt[13]=103
    yt[14]=32
    yt[15]=99
    yt[16]=61
    yt[17]=48
    yt[18]=46
    yt[19]=49
    yt[20]=41
    viz_node_set_label(&!scene,result.x_axis,&xt,11)
    viz_node_set_label(&!scene,result.y_axis,&yt,21)
    let pixels=heap_alloc(800*320*8) as *mut i64
    var canvas=Canvas{pixels:pixels,width:800,height:320}
    canvas_clear(&!canvas,0,0,0)
    viz_canvas_render_scene(&scene,&!canvas)
    assert(read_i64(canvas.pixels,215*800+112) == 180*65536+190*256+210)
    viz_html_emit_scene(&scene,800,320)
    let old_id:i64=scene.next_node_id
    ys[4]=0.0
    let invalid_log=ScaledDomain{x_lo:1.0,x_hi:10.0,y_lo:1.0,y_hi:10.0,
        x_scale:ScaleSpec{mode:1,constant:1.0},y_scale:ScaleSpec{mode:1,constant:1.0},
        x_intervals:4,y_intervals:4}
    let bad=viz_add_scaled_plot(&!scene,&xs,&ys,8,&invalid_log,
        viz_layout_rect(130,35,560,180),viz_style_rgb(1,2,3),viz_style_rgb(1,2,3))
    assert(bad.status == 5 && scene.node_count == 3 && scene.series_count == 1 && scene.next_node_id == old_id)
    scene.node_count=62
    let full=viz_add_scaled_plot(&!scene,&xs,&ys,8,&domain,
        viz_layout_rect(130,35,560,180),viz_style_rgb(1,2,3),viz_style_rgb(1,2,3))
    assert(full.status == 2 && scene.node_count == 62 && scene.series_count == 1 && scene.next_node_id == old_id)
    scene.node_count=0;scene.series_count=0
    var theta:f64=0.001
    i=0
    while i < 12 {
        let physical=electron_compton_shift(theta,0.0)
        assert(physical.status == 0)
        xs[i as usize]=theta;ys[i as usize]=physical.shift_m*1.0e12
        theta=theta*2.0;i=i+1
    }
    let physical_domain=ScaledDomain{x_lo:0.001,x_hi:10.0,y_lo:1.0e-6,y_hi:10.0,
        x_scale:ScaleSpec{mode:1,constant:1.0},y_scale:ScaleSpec{mode:1,constant:1.0},
        x_intervals:4,y_intervals:7}
    let physical_plot=viz_add_scaled_plot(&!scene,&xs,&ys,12,&physical_domain,
        viz_layout_rect(130,35,560,180),viz_style_rgb(80,180,240),viz_style_rgb(180,190,210))
    assert(physical_plot.status == 0)
    var theta_label:[i8;64]=[0;64]
    theta_label[0]=116
    theta_label[1]=104
    theta_label[2]=101
    theta_label[3]=116
    theta_label[4]=97
    theta_label[5]=32
    theta_label[6]=40
    theta_label[7]=114
    theta_label[8]=97
    theta_label[9]=100
    theta_label[10]=44
    theta_label[11]=32
    theta_label[12]=108
    theta_label[13]=111
    theta_label[14]=103
    theta_label[15]=49
    theta_label[16]=48
    theta_label[17]=41
    var shift_label:[i8;64]=[0;64]
    shift_label[0]=115
    shift_label[1]=104
    shift_label[2]=105
    shift_label[3]=102
    shift_label[4]=116
    shift_label[5]=32
    shift_label[6]=40
    shift_label[7]=112
    shift_label[8]=109
    shift_label[9]=44
    shift_label[10]=32
    shift_label[11]=108
    shift_label[12]=111
    shift_label[13]=103
    shift_label[14]=49
    shift_label[15]=48
    shift_label[16]=41
    var legend:[i8;64]=[0;64]
    legend[0]=101
    legend[1]=108
    legend[2]=101
    legend[3]=99
    legend[4]=116
    legend[5]=114
    legend[6]=111
    legend[7]=110
    legend[8]=32
    legend[9]=67
    legend[10]=111
    legend[11]=109
    legend[12]=112
    legend[13]=116
    legend[14]=111
    legend[15]=110
    legend[16]=32
    legend[17]=115
    legend[18]=104
    legend[19]=105
    legend[20]=102
    legend[21]=116
    viz_node_set_label(&!scene,physical_plot.x_axis,&theta_label,18)
    viz_node_set_label(&!scene,physical_plot.y_axis,&shift_label,17)
    assert(viz_add_series_legend(&!scene,physical_plot.chart,&legend,22,viz_layout_rect(130,275,300,22)) >= 0)
    canvas_clear(&!canvas,0,0,0)
    viz_canvas_render_scene(&scene,&!canvas)
    viz_html_emit_scene(&scene,800,320)
    println("SCALED_PLOT_PASS")
    0
}
