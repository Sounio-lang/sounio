//@ run-pass
//@ requires: madaros
//@ expect-stdout: l0 0.090000
//@ expect-stdout: l3 1.440000
//@ expect-stdout: l12 15.210000
//@ expect-stdout: lneg 0.090000
//@ expect-stdout: a1 0.810000
//@ expect-stdout: a2 4.410000
//@ expect-stdout: a12 6038323.290000
//@ expect-stdout: s1 9.000000
//@ expect-stdout: s2 22500.000000
//@ expect-stdout: RECUR_LET_OK
// a = 5 +- 0.3, var = 0.09.
// A let of the recursive call is the same derivative as the expression.
// n = 12 of t + x is 13 copies, 169 * 0.09.
// Two lets, u = t + t; u + x, is the affine factor 2^(n+1)-1.
// t * t is the square.

fn lin(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        let t = lin(x, n - 1)
        t + x
    }
}

fn aff(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        let t = aff(x, n - 1)
        let u = t + t
        u + x
    }
}

fn sq(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        let t = sq(x, n - 1)
        t * t
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let l0 = variance_of(lin(a, 0))
    let l3 = variance_of(lin(a, 3))
    let l12 = variance_of(lin(a, 12))
    let lneg = variance_of(lin(a, 0 - 2))
    let a1 = variance_of(aff(a, 1))
    let a2 = variance_of(aff(a, 2))
    let a12 = variance_of(aff(a, 12))
    let s1 = variance_of(sq(a, 1))
    let s2 = variance_of(sq(a, 2))
    print("l0 ")
    print_f64(l0)
    println("")
    print("l3 ")
    print_f64(l3)
    println("")
    print("l12 ")
    print_f64(l12)
    println("")
    print("lneg ")
    print_f64(lneg)
    println("")
    print("a1 ")
    print_f64(a1)
    println("")
    print("a2 ")
    print_f64(a2)
    println("")
    print("a12 ")
    print_f64(a12)
    println("")
    print("s1 ")
    print_f64(s1)
    println("")
    print("s2 ")
    print_f64(s2)
    println("")
    var fails: i64 = 0
    if l0 < 0.089999 || l0 > 0.090001 { fails = fails + 1 }
    if l3 < 1.439999 || l3 > 1.440001 { fails = fails + 1 }
    if l12 < 15.209999 || l12 > 15.210001 { fails = fails + 1 }
    if lneg < 0.089999 || lneg > 0.090001 { fails = fails + 1 }
    if a1 < 0.809999 || a1 > 0.810001 { fails = fails + 1 }
    if a2 < 4.409999 || a2 > 4.410001 { fails = fails + 1 }
    if a12 < 6038323.28 || a12 > 6038323.30 { fails = fails + 1 }
    if s1 < 8.999999 || s1 > 9.000001 { fails = fails + 1 }
    if s2 < 22499.999 || s2 > 22500.001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_LET_OK")
        0
    } else {
        println("RECUR_LET_FAIL")
        1
    }
}
