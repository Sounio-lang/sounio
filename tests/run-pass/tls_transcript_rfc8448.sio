fn rawbuf_eq(a: &RawBuf, b: &RawBuf, len: i64) -> bool with IO {
    var i: i64 = 0
    var ok = true
    while i < len {
        if rawbuf_get(a, i) != rawbuf_get(b, i) {
            ok = false
        }
        i = i + 1
    }
    ok
}

fn main() -> i64 with IO, Mut {
    var t = transcript_new(HKDF_HASH_SHA256)

    let client_hello = rfc_client_hello()
    let server_hello = rfc_server_hello()
    transcript_append(&!t, &client_hello, 196)
    transcript_append(&!t, &server_hello, 90)

    let hash_through_sh = transcript_current_hash(&t)
    let expected_sh_hash = rfc_sh_hash()
    if !rawbuf_eq(&hash_through_sh, &expected_sh_hash, 32) {
        println("FAIL: transcript hash through ServerHello does not match RFC 8448")
        return 1
    }

    let encrypted_extensions = rfc_encrypted_extensions()
    let certificate = rfc_certificate()
    let certificate_verify = rfc_certificate_verify()
    let server_finished = rfc_server_finished()
    transcript_append(&!t, &encrypted_extensions, 40)
    transcript_append(&!t, &certificate, 445)
    transcript_append(&!t, &certificate_verify, 136)
    transcript_append(&!t, &server_finished, 36)

    let hash_through_finished = transcript_current_hash(&t)
    let expected_sf_hash = rfc_sf_hash()
    if !rawbuf_eq(&hash_through_finished, &expected_sf_hash, 32) {
        println("FAIL: transcript hash through server Finished does not match RFC 8448")
        return 1
    }

    println("tls_transcript_rfc8448: transcript hash matches RFC 8448 at both checkpoints")
    return 0
}
