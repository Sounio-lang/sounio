//@ run-pass
//@ requires: madaros
// Accumulates real RFC 8448 handshake message bytes (fetched fresh from
// https://www.rfc-editor.org/rfc/rfc8448.txt on 2026-08-25, Section 3
// "Simple 1-RTT Handshake") and confirms the resulting transcript hash
// matches the RFC's own published values at two checkpoints:
//   - "hash through ServerHello" (Section 3, "{server} derive secret
//     \"tls13 c hs traffic\"", `hash (32 octets)`) -- the input consumed
//     by tls13_keyschedule_rfc8448.sio's own `sh_hash` for the handshake
//     traffic secrets. Independently re-verified against the raw RFC
//     text for THIS task's own use (not just copied from that file).
//   - "hash through server Finished" (Section 3, "{server} derive
//     secret \"tls13 c ap traffic\"", `hash (32 octets)`) -- the input
//     consumed by that same file's `sf_hash` for the application traffic
//     secrets.
//
// Every message-byte array below (ClientHello, ServerHello,
// EncryptedExtensions, Certificate, CertificateVerify, server Finished)
// is the full handshake-message-layer byte sequence (4-byte handshake
// header + body) as printed by the RFC's own `payload (N octets)`/
// `<MessageType> (N octets)` labels -- NOT the record layer's 5-byte
// TLSCiphertext/TLSPlaintext header. Byte counts were cross-checked
// programmatically against the RFC's own stated octet counts for every
// field before being transcribed here (196, 90, 40, 445, 136, 36).
use tls::transcript::*
use crypto::hkdf::*
use net::socket::*

fn write_bytes(buf: &RawBuf, values: [i64; 512], n: i64) with IO {
    var i: i64 = 0
    while i < n {
        rawbuf_set(buf, i, values[i as usize])
        i = i + 1
    }
}

