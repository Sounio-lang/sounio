//@ run-pass
//@ expect-stdout: STATS_BOOTSTRAP_STATUS_PASS
use stats::bootstrap::{bootstrap_mean}
fn main() with IO, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    x[0] = 1.0; x[1] = 3.0
    assert(bootstrap_mean(&x, 257, 10, 0.95, 1).status == 1)
    assert(bootstrap_mean(&x, 0, 10, 0.95, 1).status == 1)
    assert(bootstrap_mean(&x, 1, 10, 0.95, 1).status == 1)
    assert(bootstrap_mean(&x, 2, 1, 0.95, 1).status == 1)
    assert(bootstrap_mean(&x, 2, 1025, 0.95, 1).status == 1)
    assert(bootstrap_mean(&x, 2, 10, 0.0, 1).status == 2)
    assert(bootstrap_mean(&x, 2, 10, 1.0, 1).status == 2)
    let zero = 0.0
    let nan = zero / zero
    let inf = 1.0 / zero
    assert(bootstrap_mean(&x, 2, 10, nan, 1).status == 2)
    x[0] = inf
    assert(bootstrap_mean(&x, 2, 10, 0.95, 1).status == 3)
    x[0] = nan
    assert(bootstrap_mean(&x, 2, 10, 0.95, 1).status == 3)
    x[0] = 1.0; x[1] = 3.0
    let a = bootstrap_mean(&x, 2, 100, 0.95, 2147483647)
    let b = bootstrap_mean(&x, 2, 100, 0.95, 2147483646)
    assert(a.status == 0)
    assert(a.seed_used == 2147483646)
    assert(a.mean == b.mean && a.se == b.se && a.lo == b.lo && a.hi == b.hi)
    x[0] = 0.0; x[1] = 0.0
    let z = bootstrap_mean(&x, 2, 100, 0.95, 0)
    assert(z.status == 0 && z.b == 100)
    assert(z.mean == 0.0 && z.se == 0.0 && z.lo == 0.0 && z.hi == 0.0)
    println("STATS_BOOTSTRAP_STATUS_PASS")
    0
}
