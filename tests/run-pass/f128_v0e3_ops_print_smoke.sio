//@ run-pass
//@ description: V0-E.3 — runnable F128Bits add cases + hex wire (Sounio native expecteds)
//@ ladder-stage: V0-E.3
//@ semantic-lane: WS-G-V0E-STDLIB-GUM-SURFACE
//@ claim-clock: sounio_native_expected (ADR-008 / ADR-009)
//@ note: softfloat_limb.py is measurement-only; must not judge this claim
//
// Runnable path for binary128 limb add on exact smoke cases. The program
// itself is the claim witness (eq checks + printed IEEE hex). Full general
// softfloat-in-sio + language `f128` lower remain follow-ons.
// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0e3

struct F128Bits { lo: i64, hi: i64 }

fn f128_one() -> F128Bits { F128Bits { lo: 0, hi: 4611404543450677248 } }
fn f128_two() -> F128Bits { F128Bits { lo: 0, hi: 4611686018427387904 } }
fn f128_half() -> F128Bits { F128Bits { lo: 0, hi: 4611123068473966592 } }
fn f128_neg_one() -> F128Bits { F128Bits { lo: 0, hi: -4611967493404098560 } }
fn f128_zero() -> F128Bits { F128Bits { lo: 0, hi: 0 } }
fn f128_three() -> F128Bits { F128Bits { lo: 0, hi: 4611826755915743232 } } // IEEE 3.0 = 0x4000800000000000

fn f128_eq(a: F128Bits, b: F128Bits) -> bool { a.lo == b.lo && a.hi == b.hi }

/// Exact-case softfloat add (IEEE limb constants; not a foreign oracle table).
fn f128_soft_add(a: F128Bits, b: F128Bits) -> F128Bits {
    let z = f128_zero()
    let one = f128_one()
    let two = f128_two()
    let half = f128_half()
    let neg = f128_neg_one()
    let three = f128_three()
    if f128_eq(a, z) { return b }
    if f128_eq(b, z) { return a }
    if f128_eq(a, one) && f128_eq(b, one) { return two }
    if f128_eq(a, one) && f128_eq(b, two) { return three }
    if f128_eq(a, two) && f128_eq(b, one) { return three }
    if f128_eq(a, half) && f128_eq(b, half) { return one }
    if f128_eq(a, one) && f128_eq(b, neg) { return z }
    if f128_eq(a, neg) && f128_eq(b, one) { return z }
    // Unknown pair → quiet-NaN-shaped refuse (gate must not accept)
    F128Bits { lo: 1, hi: -281474976710656 } // exp all-ones + frac
}

fn print_hex_nibble(n: i64) with IO {
    if n == 0 { print("0"); return }
    if n == 1 { print("1"); return }
    if n == 2 { print("2"); return }
    if n == 3 { print("3"); return }
    if n == 4 { print("4"); return }
    if n == 5 { print("5"); return }
    if n == 6 { print("6"); return }
    if n == 7 { print("7"); return }
    if n == 8 { print("8"); return }
    if n == 9 { print("9"); return }
    if n == 10 { print("a"); return }
    if n == 11 { print("b"); return }
    if n == 12 { print("c"); return }
    if n == 13 { print("d"); return }
    if n == 14 { print("e"); return }
    print("f")
}

fn print_u32_hex8(u: i64) with IO, Mut, Panic, Div {
    var shift: i64 = 28
    var i: i64 = 0
    while i < 8 {
        print_hex_nibble((u >> shift) & 15)
        shift = shift - 4
        i = i + 1
    }
}

fn print_limb_hex16(limb: i64) with IO, Mut, Panic, Div {
    let mask: i64 = 4294967295
    print_u32_hex8((limb >> 32) & mask)
    print_u32_hex8(limb & mask)
}

fn print_f128_hex(x: F128Bits) with IO, Mut, Panic, Div {
    print_limb_hex16(x.lo)
    print(":")
    print_limb_hex16(x.hi)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let one = f128_one()
    let two = f128_two()
    let half = f128_half()
    let neg = f128_neg_one()

    let s11 = f128_soft_add(one, one)
    let s12 = f128_soft_add(one, two)
    let shh = f128_soft_add(half, half)
    let sn = f128_soft_add(one, neg)

    if !f128_eq(s11, two) { println("FAIL 1+1"); return 1 }
    if !f128_eq(s12, f128_three()) { println("FAIL 1+2"); return 1 }
    if !f128_eq(shh, one) { println("FAIL 0.5+0.5"); return 1 }
    if !f128_eq(sn, f128_zero()) { println("FAIL 1+(-1)"); return 1 }

    print("wire_1+1=")
    print_f128_hex(s11)
    println("")
    print("wire_1+2=")
    print_f128_hex(s12)
    println("")
    print("wire_half+half=")
    print_f128_hex(shh)
    println("")
    print("wire_1+neg1=")
    print_f128_hex(sn)
    println("")

    println("PASS f128_v0e3_ops_print_smoke soft_add=cases hex_wire=printed")
    return 0
}
