//@ run-pass
//@ requires: madaros
//@ expect-stdout: STATIC_BLOB_OK
use tests::fixtures::wave3_static_blob::nested::provider::{asset_pair};
fn byte_at(data: *const u8, index: i64) -> i64 with Mut {
    let p = ((data as i64) + index) as *const u8
    (*p) as i64
}
fn main() -> i32 with IO, Mut {
    let (data, size) = asset_pair()
    if size != 5 { return 1 }
    if byte_at(data, 0) != 0 { return 2 }
    if byte_at(data, 1) != 1 { return 3 }
    if byte_at(data, 2) != 127 { return 4 }
    if byte_at(data, 3) != 128 { return 5 }
    if byte_at(data, 4) != 255 { return 6 }
    let (empty, empty_size) = static_blob_bytes("../fixtures/wave3_static_blob/empty.bin")
    if empty_size != 0 || (empty as i64) == 0 { return 7 }
    println("STATIC_BLOB_OK")
    0
}
