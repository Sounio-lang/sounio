//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS imported_string_magic_i64_const
//@ description: An imported i64 global initialised to the BSS string-init sentinel stays an integer.
//
// A BSS global initialised from a string literal carries prof_counter_id ==
// BSS_INIT_STRING_MAGIC (-800001) and its payload in return_struct_name.
// bss_global_scalar_kind took the sentinel alone as "string", so an integer
// global whose value happens to be -800001 -- the compiler's own
// `pub let BSS_INIT_STRING_MAGIC: i64 = 0 - 800001`, imported into lower.sio
// and the x86 codegen -- was classified as a string. `x == SENTINEL` then
// lowered to str_eq on two integers and the self-compiled gen2 SIGSEGV'd
// (str_eq(3, 0xfffffffffff3caff)). The faulting comparison sits in a dependency
// (fixtures/imported_string_magic_i64_mid.sio): there the global type table
// has no entry for the glob-imported constant and only the slot metadata
// decides. Before the fix this binary died with SIGSEGV (rc=139).

use fixtures::imported_string_magic_i64_leaf::*
use fixtures::imported_string_magic_i64_mid::{mid_is_sentinel, mid_counter_matches}

fn is_sentinel(x: i64) -> bool with Mut, Panic, Div {
    x == SENTINEL_LIKE
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var ok = true
    if is_sentinel(3) { ok = false }
    if !is_sentinel(0 - 800001) { ok = false }
    if COUNTER_LIKE != SENTINEL_LIKE { ok = false }
    if mid_is_sentinel(3) { ok = false }
    if !mid_is_sentinel(0 - 800001) { ok = false }
    if !mid_counter_matches() { ok = false }
    if SENTINEL_LIKE + 1 != 0 - 800000 { ok = false }
    println(SENTINEL_LIKE)
    if ok { println("PASS imported_string_magic_i64_const") } else { println("FAIL imported_string_magic_i64_const") }
    return 0
}
