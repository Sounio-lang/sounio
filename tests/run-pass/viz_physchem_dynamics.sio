// tests/run-pass/viz_physchem_dynamics.sio - lattice/particle Visual IR proof
//
// Expected output:
//   VIZ_PHYSCHEM_DYNAMICS_PASS

use display::canvas::{Canvas, canvas_clear}
use viz::ir::{viz_scene_new, viz_layout_rect, viz_scene_set_time, viz_add_lattice_field, viz_add_particle_event, VIZ_NODE_LATTICE_FIELD, VIZ_NODE_PARTICLE_EVENT}
use viz::physchem::{lattice_field_phonon_demo, particle_event_view_demo}
use viz::viz_canvas::{viz_canvas_render_scene}

fn dyn_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn dyn_px(c: &Canvas, x: i64, y: i64) -> i64 {
    read_i64(c.pixels, y * c.width + x)
}

fn main() with IO, Alloc, Mut, Div {
    let lattice = lattice_field_phonon_demo(6, 6)
    let events = particle_event_view_demo(18)

    assert(lattice.rows == 6)
    assert(lattice.cols == 6)
    assert(lattice.displacement_x[0] != lattice.displacement_x[35])
    assert(lattice.displacement_y[0] != lattice.displacement_y[35])
    assert(lattice.phase[10] > lattice.phase[0])
    assert(lattice.variance[35] > lattice.variance[0])

    assert(events.n == 18)
    assert(events.energy[17] > events.energy[0])
    assert(events.kind[0] == 0)
    assert(events.kind[1] == 1)
    assert(events.kind[2] == 2)

    var scene = viz_scene_new()
    viz_scene_set_time(&!scene, 4.0)
    let lattice_node = viz_add_lattice_field(&!scene, lattice, viz_layout_rect(8, 8, 96, 96))
    let event_node = viz_add_particle_event(&!scene, events, viz_layout_rect(120, 8, 112, 96))

    assert(lattice_node == 0)
    assert(event_node == 1)
    assert(scene.node_count == 2)
    assert(scene.nodes[lattice_node as usize].kind == VIZ_NODE_LATTICE_FIELD)
    assert(scene.nodes[event_node as usize].kind == VIZ_NODE_PARTICLE_EVENT)
    assert(scene.lattice_count == 1)
    assert(scene.particle_event_count == 1)
    assert(scene.lattice_data[0].rows == 6)
    assert(scene.lattice_data[0].cols == 6)
    assert(scene.lattice_data[0].phase[10] == lattice.phase[10])
    assert(scene.particle_event_data[0].n == 18)
    assert(scene.particle_event_data[0].energy[17] == events.energy[17])

    var c = dyn_canvas(240, 120)
    canvas_clear(&!c, 0, 0, 0)
    viz_canvas_render_scene(&scene, &!c)

    assert(dyn_px(&c, 8, 8) != 0)
    assert(dyn_px(&c, 120, 8) != 0)
    assert(dyn_px(&c, 16, 16) != 0)
    assert(dyn_px(&c, 128, 96) != 0)

    heap_free(c.pixels as *mut i8)
    println("VIZ_PHYSCHEM_DYNAMICS_PASS")
}
