// tests/run-pass/test_octonion_fano_table.sio
//@ run-pass
// Validate that stdlib/math/octonion.sio oct_mul matches
// the formal generated Fano table for all 64 basis pairs.
//@ requires: madaros
//@ expect-stdout: 0

use stdlib::math::octonion::*

fn make_basis(idx: i64) -> Octonion {
    oct(
        if idx == 0 { 1.0 } else { 0.0 },
        if idx == 1 { 1.0 } else { 0.0 },
        if idx == 2 { 1.0 } else { 0.0 },
        if idx == 3 { 1.0 } else { 0.0 },
        if idx == 4 { 1.0 } else { 0.0 },
        if idx == 5 { 1.0 } else { 0.0 },
        if idx == 6 { 1.0 } else { 0.0 },
        if idx == 7 { 1.0 } else { 0.0 }
    )
}

fn oct_get_component(o: Octonion, idx: i64) -> f64 {
    if idx == 0 { return o.a }
    if idx == 1 { return o.b }
    if idx == 2 { return o.c }
    if idx == 3 { return o.d }
    if idx == 4 { return o.e }
    if idx == 5 { return o.f }
    if idx == 6 { return o.g }
    o.h
}

// Canonical Cayley-Dickson multiplication table for imaginary units e1..e7
// table[i-1][j-1] encodes sign * index (1..7), 0 means undefined
fn fano_product_index(i: i64, j: i64) -> i64 {
    if i == 0 { return j }
    if j == 0 { return i }
    if i == j { return 0 - 100 } // represents -e0

    // Full 7x7 multiplication table of imaginary units e1..e7
    // Derived from (a, b) * (c, d) = (a*c - d_conj*b, d*a + b*c_conj)
    // Row 1: e1 * ej
    if i == 1 {
        if j == 2 { return 3 }
        if j == 3 { return 0 - 2 }
        if j == 4 { return 5 }
        if j == 5 { return 0 - 4 }
        if j == 6 { return 0 - 7 }
        if j == 7 { return 6 }
    }
    // Row 2: e2 * ej
    if i == 2 {
        if j == 1 { return 0 - 3 }
        if j == 3 { return 1 }
        if j == 4 { return 6 }
        if j == 5 { return 7 }
        if j == 6 { return 0 - 4 }
        if j == 7 { return 0 - 5 }
    }
    // Row 3: e3 * ej
    if i == 3 {
        if j == 1 { return 2 }
        if j == 2 { return 0 - 1 }
        if j == 4 { return 7 }
        if j == 5 { return 0 - 6 }
        if j == 6 { return 5 }
        if j == 7 { return 0 - 4 }
    }
    // Row 4: e4 * ej
    if i == 4 {
        if j == 1 { return 0 - 5 }
        if j == 2 { return 0 - 6 }
        if j == 3 { return 0 - 7 }
        if j == 5 { return 1 }
        if j == 6 { return 2 }
        if j == 7 { return 3 }
    }
    // Row 5: e5 * ej
    if i == 5 {
        if j == 1 { return 4 }
        if j == 2 { return 0 - 7 }
        if j == 3 { return 6 }
        if j == 4 { return 0 - 1 }
        if j == 6 { return 0 - 3 }
        if j == 7 { return 2 }
    }
    // Row 6: e6 * ej
    if i == 6 {
        if j == 1 { return 7 }
        if j == 2 { return 4 }
        if j == 3 { return 0 - 5 }
        if j == 4 { return 0 - 2 }
        if j == 5 { return 3 }
        if j == 7 { return 0 - 1 }
    }
    // Row 7: e7 * ej
    if i == 7 {
        if j == 1 { return 0 - 6 }
        if j == 2 { return 5 }
        if j == 3 { return 4 }
        if j == 4 { return 0 - 3 }
        if j == 5 { return 0 - 2 }
        if j == 6 { return 1 }
    }
    0
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var i = 0
    while i < 8 {
        var j = 0
        while j < 8 {
            let ei = make_basis(i)
            let ej = make_basis(j)
            let prod = oct_mul(ei, ej)
            let target_code = fano_product_index(i, j)

            if target_code == 0 - 100 {
                // Expect -e0
                if oct_get_component(prod, 0) != -1.0 { return 100 + i * 8 + j }
                var k = 1
                while k < 8 {
                    if oct_get_component(prod, k) != 0.0 { return 200 + i * 8 + j }
                    k = k + 1
                }
            } else if target_code >= 0 {
                // Expect +e_{target_code}
                var k = 0
                while k < 8 {
                    let expected = if k == target_code { 1.0 } else { 0.0 }
                    if oct_get_component(prod, k) != expected { return 300 + i * 8 + j }
                    k = k + 1
                }
            } else {
                // Expect -e_{abs(target_code)}
                let abs_code = 0 - target_code
                var k = 0
                while k < 8 {
                    let expected = if k == abs_code { -1.0 } else { 0.0 }
                    if oct_get_component(prod, k) != expected { return 400 + i * 8 + j }
                    k = k + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    print("PASS: all 64 basis products verified bit-exact against Cayley-Dickson formal table\n")
    print_int(0)
    0
}
