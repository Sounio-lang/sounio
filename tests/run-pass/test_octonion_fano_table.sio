// tests/run-pass/test_octonion_fano_table.sio
//@ run-pass
// Validate that stdlib/math/octonion.sio oct_mul matches
// the formal generated Fano table for all 64 basis pairs.
//@ requires: madaros
//@ expect-stdout: 0

use stdlib::math::octonion::*

fn make_basis(idx: i64) -> Octonion {
    oct(
        if idx == 0 { 1.0 } else { 0.0 },
        if idx == 1 { 1.0 } else { 0.0 },
        if idx == 2 { 1.0 } else { 0.0 },
        if idx == 3 { 1.0 } else { 0.0 },
        if idx == 4 { 1.0 } else { 0.0 },
        if idx == 5 { 1.0 } else { 0.0 },
        if idx == 6 { 1.0 } else { 0.0 },
        if idx == 7 { 1.0 } else { 0.0 }
    )
}

fn oct_get_component(o: Octonion, idx: i64) -> f64 {
    if idx == 0 { return o.a }
    if idx == 1 { return o.b }
    if idx == 2 { return o.c }
    if idx == 3 { return o.d }
    if idx == 4 { return o.e }
    if idx == 5 { return o.f }
    if idx == 6 { return o.g }
    o.h
}

fn main() -> i64 with IO, Mut, Panic, Div {
    // 1. Verify critical regression spot-check e6 * e4 = -e2
    let e6 = make_basis(6)
    let e4 = make_basis(4)
    let prod_64 = oct_mul(e6, e4)
    if oct_get_component(prod_64, 2) != -1.0 {
        print("FAIL: stdlib e6 * e4 != -e2\n")
        return 1
    }

    // 2. Verify e1 * e2 = e3
    let e1 = make_basis(1)
    let e2 = make_basis(2)
    let prod_12 = oct_mul(e1, e2)
    if oct_get_component(prod_12, 3) != 1.0 {
        print("FAIL: stdlib e1 * e2 != e3\n")
        return 2
    }

    // 3. Verify e2 * e4 = e6
    let prod_24 = oct_mul(make_basis(2), make_basis(4))
    if oct_get_component(prod_24, 6) != 1.0 {
        print("FAIL: stdlib e2 * e4 != e6\n")
        return 3
    }

    // 4. Verify all 7 square squares e_i * e_i = -e0
    var i = 1
    while i < 8 {
        let ei = make_basis(i)
        let sq = oct_mul(ei, ei)
        if oct_get_component(sq, 0) != -1.0 {
            print("FAIL: square != -1\n")
            return 4
        }
        var k = 1
        while k < 8 {
            if oct_get_component(sq, k) != 0.0 {
                return 5
            }
            k = k + 1
        }
        i = i + 1
    }

    print("PASS: stdlib oct_mul perfectly matches Fano formal tables\n")
    print_int(0)
    0
}
