//@ run-pass
//@ expect-stdout: ALL 13 TESTS PASSED
// sparse_matrix.sio - Integration tests for sparse matrix library (CSR format)
//
// Tests CSR construction, SpMV, sparse-sparse operations, triangular solves,
// matrix properties, and the Conjugate Gradient iterative solver.
//
// All structs and functions are inlined since tests cannot import.

// ============================================================================
// HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var scaled = x
    var scale_back = 1.0
    while scaled < 1.0 {
        scaled = scaled * 4.0
        scale_back = scale_back * 2.0
    }
    while scaled > 4.0 {
        scaled = scaled * 0.25
        scale_back = scale_back * 0.5
    }
    var y = 1.5
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    y = 0.5 * (y + scaled / y)
    return y / scale_back
}

// ============================================================================
// DENSE VECTOR HELPERS
// ============================================================================

fn vec_dot(a: [f64; 128], b: [f64; 128], n: i32) -> f64 with Mut, Panic, Div {
    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + a[i] * b[i]
        i = i + 1
    }
    return sum
}

fn vec_copy(src: [f64; 128], n: i32) -> [f64; 128] with Mut, Panic, Div {
    var dst: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
    return dst
}

fn vec_sub(a: [f64; 128], b: [f64; 128], n: i32) -> [f64; 128] with Mut, Panic, Div {
    var result: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n {
        result[i] = a[i] - b[i]
        i = i + 1
    }
    return result
}

fn vec_norm(x: [f64; 128], n: i32) -> f64 with Mut, Panic, Div {
    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + x[i] * x[i]
        i = i + 1
    }
    return sqrt_f64(sum)
}

// ============================================================================
// DATA STRUCTURES
// ============================================================================

struct SparseCSR {
    values: [f64; 1024],
    col_idx: [i32; 1024],
    row_ptr: [i32; 129],
    nrows: i32,
    ncols: i32,
    nnz: i32
}

struct CGMeta {
    iterations: i32,
    residual: f64,
    converged: bool
}

fn cg_solve_into(
    out_x: &![f64; 128],
    out_meta: &!CGMeta,
    a: SparseCSR,
    b: [f64; 128],
    x0: [f64; 128],
    n: i32,
    tol: f64,
    max_iter: i32
) with Mut, Panic, Div {
    var x: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n {
        x[i] = x0[i]
        i = i + 1
    }

    let ax = sparse_matvec(a, x, n)
    var r = vec_sub(b, ax, n)
    var p = vec_copy(r, n)
    var rsold = vec_dot(r, r, n)

    if sqrt_f64(rsold) < tol {
        i = 0
        while i < n {
            out_x[i] = x[i]
            i = i + 1
        }
        out_meta.iterations = 0
        out_meta.residual = sqrt_f64(rsold)
        out_meta.converged = true
        return
    }

    var iter = 0
    var converged = false
    var done = false
    while iter < max_iter && !done {
        let ap = sparse_matvec(a, p, n)
        let pap = vec_dot(p, ap, n)
        if abs_f64(pap) < 1e-30 {
            done = true
        } else {
            let alpha = rsold / pap

            i = 0
            while i < n {
                x[i] = x[i] + alpha * p[i]
                i = i + 1
            }

            i = 0
            while i < n {
                r[i] = r[i] - alpha * ap[i]
                i = i + 1
            }

            let rsnew = vec_dot(r, r, n)

            if sqrt_f64(rsnew) < tol {
                converged = true
                done = true
            } else {
                let beta = rsnew / rsold
                i = 0
                while i < n {
                    p[i] = r[i] + beta * p[i]
                    i = i + 1
                }

                rsold = rsnew
            }
        }
        iter = iter + 1
    }

    let final_res = sqrt_f64(vec_dot(r, r, n))

    i = 0
    while i < n {
        out_x[i] = x[i]
        i = i + 1
    }

    out_meta.iterations = iter
    out_meta.residual = final_res
    out_meta.converged = converged
}

// ============================================================================
// CONSTRUCTION
// ============================================================================

fn sparse_new(nrows: i32, ncols: i32) -> SparseCSR with Mut, Panic, Div {
    var result = SparseCSR {
        values: [0.0; 1024],
        col_idx: [0; 1024],
        row_ptr: [0; 129],
        nrows: nrows,
        ncols: ncols,
        nnz: 0
    }
    var i = 0
    while i <= nrows {
        result.row_ptr[i] = 0
        i = i + 1
    }
    return result
}

fn sparse_from_triplets(
    rows: [i32; 1024],
    cols: [i32; 1024],
    vals: [f64; 1024],
    count: i32,
    nrows: i32,
    ncols: i32
) -> SparseCSR with Mut, Panic, Div {
    var s_rows: [i32; 1024] = rows
    var s_cols: [i32; 1024] = cols
    var s_vals: [f64; 1024] = vals

    // Insertion sort by (row, col)
    var i = 1
    while i < count {
        let r = s_rows[i]
        let c = s_cols[i]
        let v = s_vals[i]
        var j = i - 1
        var done = false
        while j >= 0 && !done {
            let should_shift = s_rows[j] > r || (s_rows[j] == r && s_cols[j] > c)
            if should_shift {
                s_rows[j + 1] = s_rows[j]
                s_cols[j + 1] = s_cols[j]
                s_vals[j + 1] = s_vals[j]
                j = j - 1
            } else {
                done = true
            }
        }
        s_rows[j + 1] = r
        s_cols[j + 1] = c
        s_vals[j + 1] = v
        i = i + 1
    }

    // Merge duplicates
    var m_rows: [i32; 1024] = [0; 1024]
    var m_cols: [i32; 1024] = [0; 1024]
    var m_vals: [f64; 1024] = [0.0; 1024]
    var m_count = 0

    if count > 0 {
        m_rows[0] = s_rows[0]
        m_cols[0] = s_cols[0]
        m_vals[0] = s_vals[0]
        m_count = 1

        i = 1
        while i < count {
            if s_rows[i] == m_rows[m_count - 1] && s_cols[i] == m_cols[m_count - 1] {
                m_vals[m_count - 1] = m_vals[m_count - 1] + s_vals[i]
            } else {
                m_rows[m_count] = s_rows[i]
                m_cols[m_count] = s_cols[i]
                m_vals[m_count] = s_vals[i]
                m_count = m_count + 1
            }
            i = i + 1
        }
    }

    var result = SparseCSR {
        values: [0.0; 1024],
        col_idx: [0; 1024],
        row_ptr: [0; 129],
        nrows: nrows,
        ncols: ncols,
        nnz: m_count
    }

    var row_count: [i32; 129] = [0; 129]
    i = 0
    while i < m_count {
        row_count[m_rows[i]] = row_count[m_rows[i]] + 1
        i = i + 1
    }

    result.row_ptr[0] = 0
    i = 0
    while i < nrows {
        result.row_ptr[i + 1] = result.row_ptr[i] + row_count[i]
        i = i + 1
    }

    i = 0
    while i < m_count {
        result.values[i] = m_vals[i]
        result.col_idx[i] = m_cols[i]
        i = i + 1
    }

    return result
}

fn sparse_identity(n: i32) -> SparseCSR with Mut, Panic, Div {
    var result = SparseCSR {
        values: [0.0; 1024],
        col_idx: [0; 1024],
        row_ptr: [0; 129],
        nrows: n,
        ncols: n,
        nnz: n
    }
    var i = 0
    while i < n {
        result.values[i] = 1.0
        result.col_idx[i] = i
        result.row_ptr[i] = i
        i = i + 1
    }
    result.row_ptr[n] = n
    return result
}

fn sparse_diagonal(diag: [f64; 128], n: i32) -> SparseCSR with Mut, Panic, Div {
    var result = SparseCSR {
        values: [0.0; 1024],
        col_idx: [0; 1024],
        row_ptr: [0; 129],
        nrows: n,
        ncols: n,
        nnz: n
    }
    var i = 0
    while i < n {
        result.values[i] = diag[i]
        result.col_idx[i] = i
        result.row_ptr[i] = i
        i = i + 1
    }
    result.row_ptr[n] = n
    return result
}

fn sparse_tridiagonal(
    lower: [f64; 128],
    main: [f64; 128],
    upper: [f64; 128],
    n: i32
) -> SparseCSR with Mut, Panic, Div {
    var result = SparseCSR {
        values: [0.0; 1024],
        col_idx: [0; 1024],
        row_ptr: [0; 129],
        nrows: n,
        ncols: n,
        nnz: 0
    }

    var pos = 0

    // Row 0
    result.row_ptr[0] = 0
    if n >= 1 {
        result.values[pos] = main[0]
        result.col_idx[pos] = 0
        pos = pos + 1
        if n > 1 {
            result.values[pos] = upper[0]
            result.col_idx[pos] = 1
            pos = pos + 1
        }
    }

    // Middle rows
    var i = 1
    while i < n - 1 {
        result.row_ptr[i] = pos
        result.values[pos] = lower[i - 1]
        result.col_idx[pos] = i - 1
        pos = pos + 1
        result.values[pos] = main[i]
        result.col_idx[pos] = i
        pos = pos + 1
        result.values[pos] = upper[i]
        result.col_idx[pos] = i + 1
        pos = pos + 1
        i = i + 1
    }

    // Last row
    if n > 1 {
        result.row_ptr[n - 1] = pos
        result.values[pos] = lower[n - 2]
        result.col_idx[pos] = n - 2
        pos = pos + 1
        result.values[pos] = main[n - 1]
        result.col_idx[pos] = n - 1
        pos = pos + 1
    }

    result.row_ptr[n] = pos
    result.nnz = pos

    return result
}

// ============================================================================
// ELEMENT ACCESS
// ============================================================================

fn sparse_get(a: SparseCSR, i: i32, j: i32) -> f64 with Mut, Panic, Div {
    let row_start = a.row_ptr[i]
    let row_end = a.row_ptr[i + 1]
    var k = row_start
    while k < row_end {
        if a.col_idx[k] == j {
            return a.values[k]
        }
        k = k + 1
    }
    return 0.0
}

fn sparse_nnz(a: SparseCSR) -> i32 {
    return a.nnz
}

fn sparse_row_nnz(a: SparseCSR, row: i32) -> i32 with Panic {
    return a.row_ptr[row + 1] - a.row_ptr[row]
}

// ============================================================================
// SPARSE-DENSE OPERATIONS
// ============================================================================

fn sparse_matvec(a: SparseCSR, x: [f64; 128], n: i32) -> [f64; 128] with Mut, Panic, Div {
    var y: [f64; 128] = [0.0; 128]
    var i = 0
    while i < a.nrows {
        var sum = 0.0
        var k = a.row_ptr[i]
        let row_end = a.row_ptr[i + 1]
        while k < row_end {
            let col = a.col_idx[k]
            sum = sum + a.values[k] * x[col]
            k = k + 1
        }
        y[i] = sum
        i = i + 1
    }
    return y
}

fn sparse_matvec_add(
    a: SparseCSR,
    x: [f64; 128],
    y: [f64; 128],
    alpha: f64,
    beta: f64,
    n: i32
) -> [f64; 128] with Mut, Panic, Div {
    var result: [f64; 128] = [0.0; 128]
    var i = 0
    while i < a.nrows {
        var sum = 0.0
        var k = a.row_ptr[i]
        let row_end = a.row_ptr[i + 1]
        while k < row_end {
            let col = a.col_idx[k]
            sum = sum + a.values[k] * x[col]
            k = k + 1
        }
        result[i] = alpha * sum + beta * y[i]
        i = i + 1
    }
    return result
}

// ============================================================================
// SPARSE-SPARSE OPERATIONS
// ============================================================================

fn sparse_add(a: SparseCSR, b: SparseCSR) -> SparseCSR with Mut, Panic, Div {
    var result = SparseCSR {
        values: [0.0; 1024],
        col_idx: [0; 1024],
        row_ptr: [0; 129],
        nrows: a.nrows,
        ncols: a.ncols,
        nnz: 0
    }

    var pos = 0
    var i = 0
    while i < a.nrows {
        result.row_ptr[i] = pos

        var ka = a.row_ptr[i]
        let ka_end = a.row_ptr[i + 1]
        var kb = b.row_ptr[i]
        let kb_end = b.row_ptr[i + 1]

        while ka < ka_end && kb < kb_end {
            if a.col_idx[ka] < b.col_idx[kb] {
                result.values[pos] = a.values[ka]
                result.col_idx[pos] = a.col_idx[ka]
                pos = pos + 1
                ka = ka + 1
            } else if a.col_idx[ka] > b.col_idx[kb] {
                result.values[pos] = b.values[kb]
                result.col_idx[pos] = b.col_idx[kb]
                pos = pos + 1
                kb = kb + 1
            } else {
                let sum = a.values[ka] + b.values[kb]
                if abs_f64(sum) > 1e-30 {
                    result.values[pos] = sum
                    result.col_idx[pos] = a.col_idx[ka]
                    pos = pos + 1
                }
                ka = ka + 1
                kb = kb + 1
            }
        }
        while ka < ka_end {
            result.values[pos] = a.values[ka]
            result.col_idx[pos] = a.col_idx[ka]
            pos = pos + 1
            ka = ka + 1
        }
        while kb < kb_end {
            result.values[pos] = b.values[kb]
            result.col_idx[pos] = b.col_idx[kb]
            pos = pos + 1
            kb = kb + 1
        }

        i = i + 1
    }
    result.row_ptr[a.nrows] = pos
    result.nnz = pos
    return result
}

fn sparse_scale(a: SparseCSR, alpha: f64) -> SparseCSR with Mut, Panic, Div {
    var result = a
    var i = 0
    while i < a.nnz {
        result.values[i] = alpha * a.values[i]
        i = i + 1
    }
    return result
}

fn sparse_transpose(a: SparseCSR) -> SparseCSR with Mut, Panic, Div {
    var result = SparseCSR {
        values: [0.0; 1024],
        col_idx: [0; 1024],
        row_ptr: [0; 129],
        nrows: a.ncols,
        ncols: a.nrows,
        nnz: a.nnz
    }

    var col_count: [i32; 129] = [0; 129]
    var k = 0
    while k < a.nnz {
        col_count[a.col_idx[k]] = col_count[a.col_idx[k]] + 1
        k = k + 1
    }

    result.row_ptr[0] = 0
    var i = 0
    while i < a.ncols {
        result.row_ptr[i + 1] = result.row_ptr[i] + col_count[i]
        i = i + 1
    }

    var pos: [i32; 129] = [0; 129]
    i = 0
    while i < a.ncols {
        pos[i] = result.row_ptr[i]
        i = i + 1
    }

    i = 0
    while i < a.nrows {
        k = a.row_ptr[i]
        let row_end = a.row_ptr[i + 1]
        while k < row_end {
            let col = a.col_idx[k]
            let dest = pos[col]
            result.values[dest] = a.values[k]
            result.col_idx[dest] = i
            pos[col] = pos[col] + 1
            k = k + 1
        }
        i = i + 1
    }

    return result
}

// ============================================================================
// TRIANGULAR SOLVES
// ============================================================================

fn sparse_lower_solve(l: SparseCSR, b: [f64; 128], n: i32) -> [f64; 128] with Mut, Panic, Div {
    var x: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n {
        x[i] = b[i]
        var k = l.row_ptr[i]
        let row_end = l.row_ptr[i + 1]
        var diag_val = 1.0

        while k < row_end {
            let col = l.col_idx[k]
            if col < i {
                x[i] = x[i] - l.values[k] * x[col]
            } else if col == i {
                diag_val = l.values[k]
            }
            k = k + 1
        }
        x[i] = x[i] / diag_val
        i = i + 1
    }
    return x
}

fn sparse_upper_solve(u: SparseCSR, b: [f64; 128], n: i32) -> [f64; 128] with Mut, Panic, Div {
    var x: [f64; 128] = [0.0; 128]
    var i = 0
    while i < n {
        x[i] = b[i]
        i = i + 1
    }

    i = n - 1
    while i >= 0 {
        var k = u.row_ptr[i]
        let row_end = u.row_ptr[i + 1]
        var diag_val = 1.0

        while k < row_end {
            let col = u.col_idx[k]
            if col > i {
                x[i] = x[i] - u.values[k] * x[col]
            } else if col == i {
                diag_val = u.values[k]
            }
            k = k + 1
        }
        x[i] = x[i] / diag_val
        i = i - 1
    }
    return x
}

// ============================================================================
// MATRIX PROPERTIES
// ============================================================================

fn sparse_frobenius_norm(a: SparseCSR) -> f64 with Mut, Panic, Div {
    var sum = 0.0
    var i = 0
    while i < a.nnz {
        sum = sum + a.values[i] * a.values[i]
        i = i + 1
    }
    return sqrt_f64(sum)
}

fn sparse_is_symmetric(a: SparseCSR, tol: f64) -> bool with Mut, Panic, Div {
    if a.nrows != a.ncols {
        return false
    }
    var i = 0
    while i < a.nrows {
        var k = a.row_ptr[i]
        let row_end = a.row_ptr[i + 1]
        while k < row_end {
            let j = a.col_idx[k]
            let aij = a.values[k]
            let aji = sparse_get(a, j, i)
            if abs_f64(aij - aji) > tol {
                return false
            }
            k = k + 1
        }
        i = i + 1
    }
    return true
}

