    if test_cg_tridiagonal() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 13
    print("Test 13: CG Poisson 1D.......... ")
    if test_cg_poisson() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed == 0 {
        println("ALL 13 TESTS PASSED")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
