//@ run-pass
//@ description: nested calls, builtin str_concat depth 6 plus user-fn depth 6 (SIO-378). checker_check_call_expr_inplace carried a ~1.3MB static frame (per-call-site SRET and materialize slots accumulated without reuse), so any nesting past depth 4-5 SIGSEGVd the checker at 8MB stack. Fixed by splitting the function into special-forms, resolve-callee, direct-sig and tyfn helpers behind a thin shell; pinned here through the engine-parity gate (both engines must AGREE on the outputs).
//@ expect-stdout: EXXXXXE
//@ expect-stdout: E
fn idf(s: string) -> string with Mut, Panic, Div, Alloc { s }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    println(str_concat(str_concat(str_concat(str_concat(str_concat(str_concat("E", "X"), "X"), "X"), "X"), "X"), "E"))
    println(idf(idf(idf(idf(idf(idf("E")))))))
    0
}
