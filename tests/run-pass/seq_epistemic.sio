//@ run-pass
// Phase 1b of Seq<T>: epistemic-length insertion.
//   seq_push_uncertain(s, v, confidence, variance) / s.push_uncertain(...)
// erodes the length's certainty by the GUM rules Knowledge add/sub use:
//   confidence = min(old, conf)   (weakest link)
//   variance   = old + var        (accumulates)
// A freshly created Seq, and ordinary push, keep confidence = 1.0.

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var s: Seq<i64> = seq_new()
    seq_push(s, 1)                       // deterministic: confidence stays 1.0
    let k0 = s.len()
    if k0.confidence < 0.99 { println("seq_epistemic: FAIL (fresh confidence)"); return 1 }

    // hedged insertion at confidence 0.5
    seq_push_uncertain(s, 2, 0.5, 0.25)
    let k1 = s.len()
    if k1.unwrap("len") != 2 { println("seq_epistemic: FAIL (len after uncertain)"); return 1 }
    if k1.confidence > 0.51 || k1.confidence < 0.49 {
        println("seq_epistemic: FAIL (confidence not 0.5)")
        return 1
    }

    // weakest-link: a higher-confidence insert does NOT raise confidence back up
    s.push_uncertain(3, 0.8, 0.25)
    let k2 = s.len()
    if k2.unwrap("len") != 3 { println("seq_epistemic: FAIL (len after method uncertain)"); return 1 }
    if k2.confidence > 0.51 || k2.confidence < 0.49 {
        println("seq_epistemic: FAIL (min-confidence rule)")
        return 1
    }
    // variance accumulated: 0.25 + 0.25 = 0.5
    if k2.variance > 0.51 || k2.variance < 0.49 {
        println("seq_epistemic: FAIL (variance accumulation)")
        return 1
    }

    println("seq_epistemic: PASS")
    return 0
}
