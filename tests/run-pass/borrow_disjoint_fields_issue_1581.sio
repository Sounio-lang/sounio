//@ run-pass
//@ description: #1581 — `&s.a` and `&!s.b` in one call are disjoint field borrows and are accepted on both engines (nested fields too)
//@ expect-stdout: 17.000000
//@ expect-stdout: 4.000000

struct In { u: [f64; 4], v: [f64; 4] }
struct St { a: [f64; 4], b: [f64; 4], n: In }

fn rd(x: &[f64; 4]) -> f64 { (*x)[0] }
fn sub(x: &[f64; 4], out: &![f64; 4]) with Mut { (*out)[0] = (*x)[0] * 2.0 }

fn main() -> i32 with IO, Mut {
    var s = St { a: [1.0, 2.0, 3.0, 4.0], b: [0.0; 4], n: In { u: [7.5, 0.0, 0.0, 0.0], v: [0.0; 4] } }
    sub(&s.a, &!s.b)
    sub(&s.n.u, &!s.n.v)
    println(s.b[0] + s.n.v[0])
    sub(&s.b, &!s.a)
    println(rd(&s.a))
    0
}
