//@ run-pass
// Madaros Root 2 multi-module: instance methods on imported Epistemic
// (associated + &self get/add, including print of method f64 result).

use epistemic::knowledge::{Epistemic}

fn main() -> i32 with IO, Mut, Div, Panic {
    let e = Epistemic::measured(10.0, 0.5)
    print(e.val())
    print("\n")
    let f = Epistemic::measured(4.0, 0.2)
    let s = e.add(&f)
    print(s.val())
    print("\n")
    // Variance of measured(10, 0.5) is 0.25; method std should be ~0.5
    let st = e.std()
    if st < 0.4 || st > 0.6 { print("FAIL_STD\n"); return 1 }
    print("ROOT2_MULTIMODULE_METHOD_OK\n")
    return 0
}
