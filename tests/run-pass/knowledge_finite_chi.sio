//@ run-pass
//@ requires: madaros
//@ expect-stdout: kept 11.243518 13.789148
//@ expect-stdout: small 0.000000
//@ expect-stdout: overflow 1
//@ expect-stdout: FINITE_CHI_OK
// u(ln P) = 1e-20 on a line used to overflow the chi-square and still
// return a band. Centred, that residual stays a zero. u = 1e-200 makes
// 1/u^2 infinite. That weight is not a chi-square, and it carries no band.

use epistemic::regression::plateau_pressure

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 400.0
    xs[1] = 1.0 / 450.0
    xs[2] = 1.0 / 500.0
    xs[3] = 1.0 / 550.0
    ys[0] = 0.0 - 1000.0 / 400.0
    ys[1] = 0.0 - 1000.0 / 450.0
    ys[2] = 0.0 - 1000.0 / 500.0
    ys[3] = 0.0 - 1000.0 / 550.0
    uln[0] = 0.2
    uln[1] = 0.2
    uln[2] = 0.2
    uln[3] = 0.2
    let kept = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    uln[1] = 1.0e-20
    let small = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    uln[1] = 1.0e-200
    let overflow = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    let centre = 12.451447
    let kept_ok = kept.open && !kept.refused && near(kept.lo, 11.243518, 0.000001) && near(kept.hi, 13.789148, 0.000001)
    let small_ok = small.open && !small.refused && small.lo < centre && centre < small.hi && near(small.chi, 0.0, 0.001)
    let gone = !overflow.open && !overflow.refused && !(overflow.lo == overflow.lo) && !(overflow.hi == overflow.hi) && !(overflow.chi == overflow.chi)
    print("kept ")
    print_f64(kept.lo)
    print(" ")
    print_f64(kept.hi)
    println("")
    print("small ")
    print_f64(small.chi)
    println("")
    print("overflow ")
    print_int(bit(gone))
    println("")
    if kept_ok && small_ok && gone {
        println("FINITE_CHI_OK")
        return 0
    }
    println("FINITE_CHI_FAIL")
    1
}
