//@ run-pass
//@ check-only
// Tests turbofish syntax: func::<T>() and .method::<T>()
// Parser must accept explicit type arguments at call sites.

fn identity<T>(x: T) -> T {
    x
}

fn wrap_pair<A, B>(a: A, b: B) -> A {
    a
}

fn main() with IO {
    // Function turbofish: identity::<i32>(42)
    let x = identity::<i32>(42)
    if x == 42 {
        print("turbofish_identity: PASS\n")
    } else {
        print("turbofish_identity: FAIL\n")
    }

    // Two-arg turbofish: wrap_pair::<i32, bool>(7, true)
    let y = wrap_pair::<i32, bool>(7, true)
    if y == 7 {
        print("turbofish_pair: PASS\n")
    } else {
        print("turbofish_pair: FAIL\n")
    }
}

