//@ run-pass
//@ expect-stdout-contains: turbofish_identity: PASS
//@ expect-stdout-contains: turbofish_value: PASS
//@ expect-stdout-contains: turbofish_simple_fn: PASS
// Tests turbofish syntax: func::<T>() and .method::<T>()
// Parser must accept explicit type arguments at call sites.

fn identity<T>(x: T) -> T {
    x
}

fn wrap_value<T>(a: T, b: i64) -> T {
    a
}

struct Wrapper<T> { val: T }

fn make_wrapper<T>(v: T) -> Wrapper<T> {
    Wrapper { val: v }
}

fn main() with IO {
    // Function turbofish: identity::<i32>(42)
    let x = identity::<i32>(42)
    if x == 42 {
        print("turbofish_identity: PASS\n")
    } else {
        print("turbofish_identity: FAIL\n")
    }

    // Turbofish with single type arg: wrap_value::<i32>(7, 99)
    let y = wrap_value::<i32>(7, 99)
    if y == 7 {
        print("turbofish_value: PASS\n")
    } else {
        print("turbofish_value: FAIL\n")
    }

    // Simple identifier turbofish: make_wrapper::<i64>(99)
    let w = make_wrapper::<i64>(99)
    if w.val == 99 {
        print("turbofish_simple_fn: PASS\n")
    } else {
        print("turbofish_simple_fn: FAIL\n")
    }
}

