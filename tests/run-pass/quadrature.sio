fn test_romberg_converged() -> bool with IO, Mut, Panic, Div {
    let result = romberg(0.0, 1.0, 10, 1.0e-8, f_x_squared)
    print("  converged=")
    if result.converged {
        println("true")
    } else {
        println("false")
    }
    return result.converged
}

