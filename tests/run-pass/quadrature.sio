}

// Test 20: All methods agree on sqrt(x) [0,1], expected 2/3, tol 1e-3
fn test_all_agree_sqrt() -> bool with IO, Mut, Panic, Div {
    let expected = 2.0 / 3.0

    let v_trap = trapezoid(0.0, 1.0, 200, f_sqrt)
    let v_simp = simpson(0.0, 1.0, 200, f_sqrt)
    let v_mid = midpoint(0.0, 1.0, 200, f_sqrt)
    let v_boole = boole(0.0, 1.0, 200, f_sqrt)
    let v_rom = romberg(0.0, 1.0, 12, 1.0e-6, f_sqrt)
    let v_adap = adaptive_simpson(0.0, 1.0, 1.0e-6, f_sqrt)

    let e_trap = abs_f64(v_trap - expected)
    let e_simp = abs_f64(v_simp - expected)
    let e_mid = abs_f64(v_mid - expected)
    let e_boole = abs_f64(v_boole - expected)
    let e_rom = abs_f64(v_rom.value - expected)
    let e_adap = abs_f64(v_adap - expected)

    print("  trap_err=")
    println(e_trap)
    print("  simp_err=")
    println(e_simp)
    print("  mid_err=")
    println(e_mid)
    print("  boole_err=")
    println(e_boole)
    print("  rom_err=")
    println(e_rom)
    print("  adap_err=")
    println(e_adap)

    return e_trap < 1.0e-3 && e_simp < 1.0e-3 && e_mid < 1.0e-3 && e_boole < 1.0e-3 && e_rom < 1.0e-3 && e_adap < 1.0e-3
}

