fn test_gl2_linear() -> bool with IO, Mut, Panic, Div {
    let result = gauss_legendre_2(0.0, 1.0, f_linear)
    let expected = 0.5
    let err = abs_f64(result - expected)
    print("  err=")
    println(err)
    return err < 1.0e-12
}

