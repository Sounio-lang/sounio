// Test 11: Composite GL exp on [0,1], m=4, 3-point, tol 1e-10
fn test_composite_gl_exp() -> bool with IO, Mut, Panic, Div {
    let result = composite_gauss_legendre(0.0, 1.0, 4, 3, f_exp)
    let expected = e_val() - 1.0
    let err = abs_f64(result - expected)
    print("  err=")
    println(err)
    return err < 1.0e-6
}

