//@ run-pass
//@ description: Lorenz i128 fifth-step enclosure contract from fourth validated enclosure

fn main() -> i64 {
    // The i128 center transition step4 -> step5 is already covered by
    // lorenz_i128_ball_five_step.sio. This contract carries the validated
    // fourth-step radius forward and adds a fifth interval LTE budget.
    let cx5: i64 = 1236316
    let cy5: i64 = 2341979
    let cz5: i64 = 951078

    // Fourth validated enclosure from lorenz_i128_validated_fourth_step.sio.
    let xr4: i64 = 164388
    let yr4: i64 = 215393
    let zr4: i64 = 26441

    // Radius propagation through one Euler vector-field evaluation at step 4.
    let dxr4: i64 = 10 * (yr4 + xr4)
    let x_rhoz_r4: i64 = ((1145612 * zr4) + (27047025 * xr4) + (xr4 * zr4)) / 1000000 + 1
    let dyr4: i64 = x_rhoz_r4 + yr4
    let xyr4: i64 = ((1145612 * yr4) + (2052652 * xr4) + (xr4 * yr4)) / 1000000 + 1
    let beta_zr4: i64 = ((8 * zr4) + 2) / 3
    let dzr4: i64 = xyr4 + beta_zr4

    let euler_xr5: i64 = xr4 + (10000 * dxr4) / 1000000 + 1
    let euler_yr5: i64 = yr4 + (10000 * dyr4) / 1000000 + 1
    let euler_zr5: i64 = zr4 + (10000 * dzr4) / 1000000 + 1

    // Tube covering the fourth validated enclosure and the fifth Euler ball:
    //   x in [981224, 1438683]
    //   y in [1837259, 2604335]
    //   z in [917735, 984421]
    let scale64: i64 = 1000000
    let h2: i64 = 100000000
    let lte_den: i64 = 2000000000000
    let x_abs: i64 = 1438683
    let y_abs: i64 = 2604335
    let z_abs: i64 = 984421
    let rhoz_abs: i64 = 27082265

    let f_x_abs: i64 = 10 * (y_abs + x_abs)
    let f_y_abs: i64 = (x_abs * rhoz_abs + scale64 - 1) / scale64 + y_abs
    let f_z_abs: i64 = (x_abs * y_abs + scale64 - 1) / scale64 + ((8 * z_abs) + 2) / 3

    let ddx_abs: i64 = 10 * (f_y_abs + f_x_abs)
    let ddy_abs: i64 = (f_x_abs * rhoz_abs + scale64 - 1) / scale64 +
                       (x_abs * f_z_abs + scale64 - 1) / scale64 +
                       f_y_abs
    let ddz_abs: i64 = (f_x_abs * y_abs + scale64 - 1) / scale64 +
                       (x_abs * f_y_abs + scale64 - 1) / scale64 +
                       ((8 * f_z_abs) + 2) / 3

    let lte_x: i64 = (h2 * ddx_abs + lte_den - 1) / lte_den
    let lte_y: i64 = (h2 * ddy_abs + lte_den - 1) / lte_den
    let lte_z: i64 = (h2 * ddz_abs + lte_den - 1) / lte_den

    let final_xr5: i64 = euler_xr5 + lte_x
    let final_yr5: i64 = euler_yr5 + lte_y
    let final_zr5: i64 = euler_zr5 + lte_z

    let x_lo: i64 = cx5 - final_xr5
    let x_hi: i64 = cx5 + final_xr5
    let y_lo: i64 = cy5 - final_yr5
    let y_hi: i64 = cy5 + final_yr5
    let z_lo: i64 = cz5 - final_zr5
    let z_hi: i64 = cz5 + final_zr5

    if dxr4 != 3797810 { return 1 }
    if x_rhoz_r4 != 4480845 { return 2 }
    if dyr4 != 4696238 { return 3 }
    if xyr4 != 619597 { return 4 }
    if beta_zr4 != 70510 { return 5 }
    if dzr4 != 690107 { return 6 }
    if euler_xr5 != 202367 { return 7 }
    if euler_yr5 != 262356 { return 8 }
    if euler_zr5 != 33343 { return 9 }

    if f_x_abs != 40430180 { return 10 }
    if f_y_abs != 41567130 { return 11 }
    if f_z_abs != 6371936 { return 12 }
    if ddx_abs != 819973100 { return 13 }
    if ddy_abs != 1145675176 { return 14 }
    if ddz_abs != 182087487 { return 15 }
    if lte_x != 40999 { return 16 }
    if lte_y != 57284 { return 17 }
    if lte_z != 9105 { return 18 }

    if final_xr5 != 243366 { return 19 }
    if final_yr5 != 319640 { return 20 }
    if final_zr5 != 42448 { return 21 }
    if x_lo != 992950 { return 22 }
    if x_hi != 1479682 { return 23 }
    if y_lo != 2022339 { return 24 }
    if y_hi != 2661619 { return 25 }
    if z_lo != 908630 { return 26 }
    if z_hi != 993526 { return 27 }

    return 0
}
