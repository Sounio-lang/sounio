 assert(viz_add_label(&!scene,&text_exact,value_exact.n+25,viz_layout_rect(180,395,900,14),viz_style_rgb(230,235,245))>=0)
 assert(scene.node_count==15 && scene.series_count==2)
 let pixels=heap_alloc(1180*450*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:1180,height:450}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,228*1180+180)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,1180,450)
 println("VIZ_CORRELATION_PERMUTATION_PASS")
