//@ run-pass
//@ expect-stdout: VIZ_CORRELATION_PERMUTATION_PASS
//@ expect-stdout: Wilson 95% intervals for q=hits/B; not correlation CIs
//@ expect-stdout: data-interval-kind="confidence"
//@ expect-stdout: Exchangeability unassessed; exact line is conditional
use stats::correlation_permutation::{correlation_permutation}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_forest_interval_plot,VIZ_INTERVAL_CONFIDENCE,
 viz_add_line_chart,viz_line_set_viewport,viz_add_axis,viz_node_set_label,
 viz_add_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 x[0]=0.0;x[1]=0.0;x[2]=1.0;x[3]=2.0;x[4]=3.0
 y[0]=0.0;y[1]=1.0;y[2]=1.0;y[3]=2.0;y[4]=3.0
 let a=correlation_permutation(&x,&y,5,2,64,7,false)
 let b=correlation_permutation(&x,&y,5,2,256,11,false)
 let c=correlation_permutation(&x,&y,5,2,1024,19,false)
 let exact=correlation_permutation(&x,&y,5,2,0,0,true)
 assert(a.status==0 && b.status==0 && c.status==0 && exact.status==0)
 assert(a.mc_available && b.mc_available && c.mc_available && !exact.mc_available)
 assert(!a.exchangeability_assessed && !exact.exchangeability_assessed)
 assert(a.draws==64 && b.draws==256 && c.draws==1024 && exact.draws==120)
 assert(a.p_value==((a.hits+1) as f64)/((a.draws+1) as f64))
 assert(b.p_value==((b.hits+1) as f64)/((b.draws+1) as f64))
 assert(c.p_value==((c.hits+1) as f64)/((c.draws+1) as f64))
 var q:[f64;1024]=[0.0;1024]
 var lower:[f64;1024]=[0.0;1024]
 var upper:[f64;1024]=[0.0;1024]
 q[0]=(a.hits as f64)/(a.draws as f64)
 q[1]=(b.hits as f64)/(b.draws as f64)
 q[2]=(c.hits as f64)/(c.draws as f64)
 lower[0]=a.mc_lo;lower[1]=b.mc_lo;lower[2]=c.mc_lo
 upper[0]=a.mc_hi;upper[1]=b.mc_hi;upper[2]=c.mc_hi
 var i:i64=0
 while i<3 {
  assert(lower[i as usize]>=0.0 && lower[i as usize]<=q[i as usize])
  assert(upper[i as usize]<=1.0 && upper[i as usize]>=q[i as usize])
  i=i+1
 }
 // No assertion that any finite Monte Carlo interval covers the exact value.
 var scene=viz_scene_new()
 let forest=viz_add_forest_interval_plot(&!scene,&q,&lower,&upper,3,
  VIZ_INTERVAL_CONFIDENCE,0.95,viz_layout_rect(180,120,560,88),viz_style_rgb(80,180,240))
 assert(forest==0)
 // Full probability domain makes every row and the exact reference comparable.
 scene.series[0].x_min=0.0
 scene.series[0].x_max=1.0
 assert(scene.series[0].interval_kind==VIZ_INTERVAL_CONFIDENCE)
 assert(scene.series[0].interval_level==0.95)
 assert(scene.series[0].lower[0]==a.mc_lo && scene.series[0].upper[2]==c.mc_hi)
 var rx:[f64;1024]=[0.0;1024]
 var ry:[f64;1024]=[0.0;1024]
 rx[0]=exact.p_value;rx[1]=exact.p_value
 ry[0]=0.0;ry[1]=1.0
 let reference=viz_add_line_chart(&!scene,&rx,&ry,2,viz_layout_rect(180,120,560,88),viz_style_rgb(220,135,225))
 assert(reference>=0 && viz_line_set_viewport(&!scene,reference,0.0,1.0,0.0,1.0))
 let axis=viz_add_axis(&!scene,0.0,1.0,4,false,viz_layout_rect(180,226,560,1),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=83
