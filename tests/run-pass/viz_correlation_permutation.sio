 while i<value_a.n {text_a[(i+12) as usize]=value_a.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&text_a,value_a.n+12,viz_layout_rect(780,121,340,14),viz_style_rgb(230,235,245))>=0)
 let value_b=axis_label(b.p_value)
 var text_b:[i8;64]=[0;64]
