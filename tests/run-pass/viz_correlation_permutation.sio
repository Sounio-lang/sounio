 viz_node_set_label(&!scene,axis,&axis_name,30)
 assert(viz_add_label(&!scene,&title,49,viz_layout_rect(180,20,900,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,54,viz_layout_rect(180,50,900,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_label(&!scene,&rowa,4,viz_layout_rect(60,121,100,14),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&rowb,5,viz_layout_rect(60,143,100,14),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&rowc,6,viz_layout_rect(60,165,100,14),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_series_legend(&!scene,reference,&legend,34,viz_layout_rect(180,285,700,22))>=0)
 assert(viz_add_label(&!scene,&foot,58,viz_layout_rect(180,335,900,14),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_label(&!scene,&note,53,viz_layout_rect(180,365,900,14),viz_style_rgb(190,200,215))>=0)
 let value_a=axis_label(a.p_value)
 var text_a:[i8;64]=[0;64]
 text_a[0]=99
 text_a[1]=111
 text_a[2]=114
 text_a[3]=114
 text_a[4]=101
