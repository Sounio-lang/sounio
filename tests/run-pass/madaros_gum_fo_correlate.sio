//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_GUM_FO_CORRELATE_PASS
//@ sabotage: correlate-rho

// Correlated FO: off-diagonal Hessian × Cov in Var and E₂.
// Independent: E₂[(x+y)²] = 9 + σx² + σy² = 9.05
// Fully correlated ρ=1: E₂ = 9 + σx² + σy² + 2 Cov = 9.09
//   Cov = ρ σx σy = 0.02
// Var(x+y) indep = 0.05; ρ=1 → (σx+σy)² = 0.09

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.2)
    let x = kx.value
    let y = ky.value

    // Independent baseline
    let m2_ind = second_order_mean((x + y) * (x + y))
    let v_ind = variance_of(x + y)
    let m2_prod_ind = second_order_mean(x * y)
    let v_prod_ind = variance_of(x * y)

    // Correlate fully (ρ=1)
    let _r = correlate(x, y, 1.0)
    let m2_cor = second_order_mean((x + y) * (x + y))
    let v_cor = variance_of(x + y)
    let m2_prod_cor = second_order_mean(x * y)
    let v_prod_cor = variance_of(x * y)

    print("m2_ind="); print_f64(m2_ind); print("\n")
    print("m2_cor="); print_f64(m2_cor); print("\n")
    print("v_ind="); print_f64(v_ind); print("\n")
    print("v_cor="); print_f64(v_cor); print("\n")
    print("m2_prod_ind="); print_f64(m2_prod_ind); print("\n")
    print("m2_prod_cor="); print_f64(m2_prod_cor); print("\n")
    print("v_prod_ind="); print_f64(v_prod_ind); print("\n")
    print("v_prod_cor="); print_f64(v_prod_cor); print("\n")

    // Analytic (σx=0.1, σy=0.2, Cov=ρ·σx·σy)
    // (x+y)²: μ=3, Hxx=Hyy=2, Hxy=2
    //   E2 ind = 9 + σx²+σy² = 9.05
    //   E2 cor ρ=1 = 9.05 + 2·0.02 = 9.09
    //   Var(x+y) ind = 0.05; ρ=1 → 0.09
    // product xy: Hxy=1; E2 ind=2; E2 cor=2+0.02=2.02
    //   Var ind = y²σx²+x²σy² = 0.08
    //   Var cor = 0.08 + 2·s_x·s_y·Cov = 0.08 + 2·2·1·0.02 = 0.16

    let ok = abs_f(m2_ind - 9.05) < 1.0e-6
        && abs_f(v_ind - 0.05) < 1.0e-9
        && abs_f(m2_cor - 9.09) < 1.0e-6
        && abs_f(v_cor - 0.09) < 1.0e-9
        && abs_f(m2_prod_ind - 2.0) < 1.0e-9
        && abs_f(m2_prod_cor - 2.02) < 1.0e-9
        && abs_f(v_prod_ind - 0.08) < 1.0e-9
        && abs_f(v_prod_cor - 0.16) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_CORRELATE_PASS\n")
    } else {
        print("MADAROS_GUM_FO_CORRELATE_FAIL\n")
    }
}
