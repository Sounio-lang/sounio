//@ run-pass
//@ requires: madaros
//@ expect-stdout: AGGREGATE_PLACE_ASSIGN_NO_ALIAS_OK
//@ description: aggregate assignment from field, deref and index places copies values instead of handles

struct Inner { v: [i64; 3] }
struct Host { inner: Inner, arr: [i64; 3] }

fn copy_from_deref(dst: &!Inner, src: &!Inner) with Mut {
    *dst = *src
}

fn bad(tag: i64) -> i64 with IO {
    print("BAD ")
    println(tag)
    1
}

fn main() -> i32 with IO, Mut {
    var fails: i64 = 0

    // Field PLACE -> local assignment.
    var h1 = Host { inner: Inner { v: [1, 1, 1] }, arr: [1, 1, 1] }
    var d1 = Inner { v: [0, 0, 0] }
    d1 = h1.inner
    h1.inner.v[0] = 9
    if d1.v[0] != 1 { fails = fails + bad(1) }

    // Field PLACE -> field store.
    var src2 = Host { inner: Inner { v: [2, 2, 2] }, arr: [2, 2, 2] }
    var dst2 = Host { inner: Inner { v: [0, 0, 0] }, arr: [0, 0, 0] }
    dst2.inner = src2.inner
    src2.inner.v[1] = 9
    if dst2.inner.v[1] != 2 { fails = fails + bad(2) }

    // Deref PLACE -> deref store.
    var s3 = Inner { v: [3, 3, 3] }
    var d3 = Inner { v: [0, 0, 0] }
    copy_from_deref(&!d3, &!s3)
    s3.v[2] = 9
    if d3.v[2] != 3 { fails = fails + bad(3) }

    // Fixed-array field PLACE -> local assignment.
    var h4 = Host { inner: Inner { v: [4, 4, 4] }, arr: [4, 4, 4] }
    var a4 = [0, 0, 0]
    a4 = h4.arr
    h4.arr[0] = 9
    if a4[0] != 4 { fails = fails + bad(4) }

    // Index PLACE of an annotated array of structs -> local assignment.
    var xs5: [Inner; 2] = [Inner { v: [5, 5, 5] }, Inner { v: [6, 6, 6] }]
    var d5 = Inner { v: [0, 0, 0] }
    d5 = xs5[0]
    xs5[0].v[0] = 9
    if d5.v[0] != 5 { fails = fails + bad(5) }

    // Reverse direction: mutating the copy must not mutate the owner.
    var h6 = Host { inner: Inner { v: [6, 6, 6] }, arr: [6, 6, 6] }
    var d6 = Inner { v: [0, 0, 0] }
    d6 = h6.inner
    d6.v[0] = 9
    if h6.inner.v[0] != 6 { fails = fails + bad(6) }

    if fails == 0 {
        println("AGGREGATE_PLACE_ASSIGN_NO_ALIAS_OK")
    } else {
        println("AGGREGATE_PLACE_ASSIGN_NO_ALIAS_FAIL")
    }
    0
}
