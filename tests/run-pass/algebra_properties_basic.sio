//@ run-pass

// Verify that algebra declarations with full property syntax parse correctly.
// The compiler should register the algebra as a struct with basis fields
// and store add/mul/reassociate properties for optimizer use.

algebra Quaternion over f64 {
    add: commutative, associative;
    mul: associative, non_commutative;
    reassociate: full;
    basis: e0, e1, e2, e3
}

algebra Octonion over f64 {
    add: commutative, associative;
    mul: alternative, non_commutative;
    reassociate: fano_selective;
    basis: e0, e1, e2, e3, e4, e5, e6, e7
}

fn make_quat() -> Quaternion {
    Quaternion { e0: 1.0, e1: 0.0, e2: 0.0, e3: 0.0 }
}

fn make_oct() -> Octonion {
    Octonion { e0: 1.0, e1: 0.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 }
}

fn main() -> i64 with IO {
    let q = make_quat()
    let o = make_oct()
    0
}
