//@ run-pass
//@ requires: madaros
//@ expect-stdout: xout 1
//@ expect-stdout: xin 0
//@ expect-stdout: edge 0
//@ expect-stdout: X_WINDOW_OK
// Cr10, chi 26.552100. The refusal follows the fitted 1/T values.
// Declaring 448 K while asking for 298.15 K used to leave the extrapolation
// unrefused. Declaring 298.15 K while asking for 448 K used to refuse
// an interpolation. An endpoint of the fitted 1/T range is inside.

use epistemic::regression::plateau_pressure

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 398.0
    xs[1] = 1.0 / 423.0
    xs[2] = 1.0 / 448.0
    xs[3] = 1.0 / 498.0
    ys[0] = log(42.0 / 100.0)
    ys[1] = log(103.0 / 100.0)
    ys[2] = log(182.0 / 100.0)
    ys[3] = log(610.0 / 100.0)
    uln[0] = 3.0 / 42.0
    uln[1] = 1.0 / 103.0
    uln[2] = 2.0 / 182.0
    uln[3] = 1.0 / 610.0
    let xout = plateau_pressure(xs, ys, uln, 4, 1.0 / 298.15, 100.0)
    let xin = plateau_pressure(xs, ys, uln, 4, 1.0 / 448.0, 100.0)
    let edge = plateau_pressure(xs, ys, uln, 4, 1.0 / 398.0, 100.0)
    print("xout ")
    print_int(bit(xout.refused))
    println("")
    print("xin ")
    print_int(bit(xin.refused))
    println("")
    print("edge ")
    print_int(bit(edge.refused))
    println("")
    if xout.refused && !xin.refused && !edge.refused && xout.open && xin.open {
        println("X_WINDOW_OK")
        return 0
    }
    println("X_WINDOW_FAIL")
    1
}
