//@ run-pass
// Sprint 231: Linear closures — closures capturing linear resources must be called once

linear struct FileHandle {
    fd: i64,
}

fn open_file(path: i64) -> FileHandle with IO {
    FileHandle { fd: path }
}

fn with_file(handle: FileHandle) -> fn() -> i64 with IO, Mut, Panic, Div {
    // Captures linear resource → closure is linear
    // Must be called exactly once
    || -> i64 with IO {
        handle.fd
    }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let reader = with_file(open_file(42))
    let result = reader()  // OK: linear closure consumed
    assert(result == 42)

    // reader()  // Would be COMPILE ERROR: linear closure already consumed (error 39)

    print(0)
    0
}
