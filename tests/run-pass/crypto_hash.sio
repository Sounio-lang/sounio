// Test 4: Determinism -- hashing the same input twice produces the same result
fn test_determinism() -> bool with IO, Mut, Panic, Div {
    var data1: [i64; 64] = [0; 64]
    data1[0] = 120  // 'x'
    data1[1] = 121  // 'y'
    data1[2] = 122  // 'z'
    let s1 = sha256_short(data1, 3)

    var data2: [i64; 64] = [0; 64]
    data2[0] = 120
    data2[1] = 121
    data2[2] = 122
    let s2 = sha256_short(data2, 3)

    return s1.h0 == s2.h0 && s1.h1 == s2.h1 && s1.h2 == s2.h2 && s1.h3 == s2.h3 &&
           s1.h4 == s2.h4 && s1.h5 == s2.h5 && s1.h6 == s2.h6 && s1.h7 == s2.h7
}

// Test 5: Avalanche -- changing one bit in input changes at least 25% of output bits
fn test_avalanche() -> bool with IO, Mut, Panic, Div {
    var data1: [i64; 64] = [0; 64]
    data1[0] = 0
    let s1 = sha256_short(data1, 1)

    var data2: [i64; 64] = [0; 64]
    data2[0] = 1  // differ by one bit
    let s2 = sha256_short(data2, 1)

    // Count differing bits in XOR of hash words
    var diff_bits = 0
    var xor_val = s1.h0 ^ s2.h0
    var j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }
    xor_val = s1.h1 ^ s2.h1
    j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }
    xor_val = s1.h2 ^ s2.h2
    j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }
    xor_val = s1.h3 ^ s2.h3
    j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }
    xor_val = s1.h4 ^ s2.h4
    j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }
    xor_val = s1.h5 ^ s2.h5
    j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }
    xor_val = s1.h6 ^ s2.h6
    j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }
    xor_val = s1.h7 ^ s2.h7
    j = 0
    while j < 32 {
        if (xor_val & 1) != 0 { diff_bits = diff_bits + 1 }
        xor_val = xor_val >> 1
        j = j + 1
    }

    // At least 64 of 256 bits should differ (25%)
    // In practice SHA-256 flips ~128 bits on average
    return diff_bits >= 64
}

// Test 6: Constant-time comparison works correctly
fn test_ct_equal() -> bool with IO, Mut, Panic, Div {
    var a: [i64; 64] = [0; 64]
    var b: [i64; 64] = [0; 64]
    var c: [i64; 64] = [0; 64]

    var i = 0
    while i < 32 {
        a[i] = (i * 17 + 3) as i64
        b[i] = (i * 17 + 3) as i64
        c[i] = (i * 17 + 4) as i64   // differ by 1 in every byte
        i = i + 1
    }

    let eq_ok = hash_equals_ct(a, b, 32)
    let neq_ok = hash_equals_ct(a, c, 32) == false

    return eq_ok && neq_ok
}

// Test 7: Constant-time comparison catches single-byte difference
fn test_ct_single_diff() -> bool with IO, Mut, Panic, Div {
    var a: [i64; 64] = [0; 64]
    var b: [i64; 64] = [0; 64]

    var i = 0
    while i < 32 {
        a[i] = 42
        b[i] = 42
        i = i + 1
    }

    // Identical should match
    let ok1 = hash_equals_ct(a, b, 32)

    // Change just the last byte
    b[31] = 43
    let ok2 = hash_equals_ct(a, b, 32) == false

    return ok1 && ok2
}

// Test 8: Different messages produce different hashes
fn test_collision_resistance() -> bool with IO, Mut, Panic, Div {
    var d1: [i64; 64] = [0; 64]
    d1[0] = 97  // "a"
    let s1 = sha256_short(d1, 1)

    var d2: [i64; 64] = [0; 64]
    d2[0] = 98  // "b"
    let s2 = sha256_short(d2, 1)

    // Hashes must differ in at least one word
    let any_diff = (s1.h0 != s2.h0) || (s1.h1 != s2.h1) || (s1.h2 != s2.h2) || (s1.h3 != s2.h3) ||
                   (s1.h4 != s2.h4) || (s1.h5 != s2.h5) || (s1.h6 != s2.h6) || (s1.h7 != s2.h7)
    return any_diff
}

// Test 9: Bit manipulation primitives -- rotr32 correctness
fn test_rotr32() -> bool with IO, Mut, Panic, Div {
    let mask = 4294967295

    // rotr32(1, 1) = 0x80000000 = 2147483648
    let ok1 = rotr32(1, 1) == 2147483648

    // rotr32(0x80000000, 1) = 0x40000000 = 1073741824
    let ok2 = rotr32(2147483648, 1) == 1073741824

    // rotr32(0xFF, 4) = 0x0F00000F
    // 0xFF = 255, rotated right 4: low 4 bits (0xF) go to high, rest shift right
    // 0x0F00000F = 251658255
    let ok3 = rotr32(255, 4) == 251658255

    return ok1 && ok2 && ok3
}

// Test 10: SHA-256 initial hash values match FIPS 180-4
fn test_init_values() -> bool with IO, Mut, Panic, Div {
    let s = sha256_init()
    let ok1 = s.h0 == 1779033703
    let ok2 = s.h1 == 3144134277
    let ok3 = s.h2 == 1013904242
    let ok4 = s.h3 == 2773480762
    let ok5 = s.h4 == 1359893119
    let ok6 = s.h5 == 2600822924
    let ok7 = s.h6 == 528734635
    let ok8 = s.h7 == 1541459225
    return ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8
}

