    expected[18] = 102  // f
    expected[19] = 98   // b
    expected[20] = 102  // f
    expected[21] = 52   // 4
    expected[22] = 99   // c
    expected[23] = 56   // 8
    expected[24] = 57   // 9
    expected[25] = 57   // 9
    expected[26] = 54   // 6
    expected[27] = 102  // f
    expected[28] = 98   // b
    expected[29] = 57   // 9
    expected[30] = 50   // 2
    expected[31] = 52   // 4
    expected[32] = 50   // 2
    expected[33] = 55   // 7
    expected[34] = 97   // a
    expected[35] = 101  // e
    expected[36] = 52   // 4
    expected[37] = 49   // 1
    expected[38] = 101  // e
    expected[39] = 49   // 1
    expected[40] = 55   // 7
    expected[41] = 99   // c
    expected[42] = 57   // 9
    expected[43] = 53   // 5
    expected[44] = 56   // 8
    expected[45] = 54   // 6
    expected[46] = 56   // 8
    expected[47] = 50   // 2
    expected[48] = 48   // 0
    expected[49] = 57   // 9
    expected[50] = 97   // a
    expected[51] = 48   // 0
