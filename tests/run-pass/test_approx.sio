//@ run-pass

// ---------------------------------------------------------------------------
// Approximation Theory test suite — all helpers inlined, no imports
//
// Functions tested:
//   cheb_coeffs_exp  — Chebyshev coefficients of exp(x) on [-1,1] via DCT
//   cheb_eval        — Clenshaw recurrence evaluation of Chebyshev series
//   pade_exp_22      — [2/2] Pade approximant of exp(x) at x=0
//
// References:
//   Mason & Handscomb, "Chebyshev Polynomials" (Chapman & Hall/CRC, 2003)
//   Trefethen, "Approximation Theory and Approximation Practice" (SIAM, 2013)
//   Baker & Graves-Morris, "Pade Approximants" (Cambridge, 1996)
//   DLMF (https://dlmf.nist.gov) chapter 3.11
// ---------------------------------------------------------------------------

// ============================================================================
// MATH HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn pi_val() -> f64 {
    3.14159265358979323846
}

// exp via Taylor series with range splitting for large arguments
fn exp_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x > 20.0 { return exp_f64(x / 2.0) * exp_f64(x / 2.0) }
    if x < 0.0 - 20.0 { return 1.0 / exp_f64(0.0 - x) }
    var sum = 1.0
    var term = 1.0
    var i = 1
    while i <= 30 {
        term = term * x / (i as f64)
        sum = sum + term
        i = i + 1
    }
    return sum
}

// cos via Taylor series with range reduction
fn cos_f64(x: f64) -> f64 with Mut, Panic, Div {
    let tp = 6.28318530717958647692
    let pi = pi_val()
    var a = x
    // range reduce to [-2pi, 2pi]
    if a > tp || a < 0.0 - tp {
        // floor via iterative subtraction
        var ratio = a / tp
        var n = 0.0
        if ratio >= 0.0 {
            var r = ratio
            var acc = 0.0
            var power = 1000000000000000.0
            while power >= 1.0 {
                while r >= power {
                    r = r - power
                    acc = acc + power
                }
                power = power / 10.0
            }
            n = acc
        } else {
            var r = 0.0 - ratio
            var acc = 0.0
            var power = 1000000000000000.0
            while power >= 1.0 {
                while r >= power {
                    r = r - power
                    acc = acc + power
                }
                power = power / 10.0
            }
            if (0.0 - ratio) > acc {
                n = 0.0 - acc - 1.0
            } else {
                n = 0.0 - acc
            }
        }
        a = a - n * tp
    }
    while a > pi { a = a - tp }
    while a < 0.0 - pi { a = a + tp }
    // Taylor series for cos(a)
    let a2 = a * a
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n < 20 {
        term = 0.0 - term * a2 / ((2 * n - 1) * (2 * n)) as f64
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn check_f64(got: f64, expected: f64, tol: f64, pass: &!i32, fail: &!i32) with IO {
    let diff = abs_f64(got - expected)
    if diff < tol {
        *pass = *pass + 1
    } else {
        *fail = *fail + 1
    }
}

// ============================================================================
// APPROXIMATION FUNCTIONS
// ============================================================================

// Chebyshev coefficients of exp(x) on [-1, 1] via DCT at Chebyshev nodes.
//
// c_k = (2/n) * sum_{j=0}^{n-1} f(cos(pi*(j+0.5)/n)) * cos(pi*k*(j+0.5)/n)
// with c_0 halved (standard normalization).
fn cheb_coeffs_exp(n: i32, out: &![f64; 64]) with Mut, Div, Panic {
    var k = 0
    while k < n {
        var sum = 0.0
        var j = 0
        while j < n {
            let theta = pi_val() * ((j as f64) + 0.5) / (n as f64)
            let x = cos_f64(theta)
            let fx = exp_f64(x)
            sum = sum + fx * cos_f64((k as f64) * theta)
            j = j + 1
        }
        out[k] = 2.0 * sum / (n as f64)
        k = k + 1
    }
    out[0] = out[0] / 2.0  // halve c_0
}

// Clenshaw recurrence: evaluate sum c_k * T_k(x) for k = 0..n-1
//
// Starting from k = n-1 down to 1:
//   b_0 = 2*x*b_1 - b_2 + c_k
// Result: x*b_1 - b_2 + c_0
fn cheb_eval(coeffs: &[f64; 64], n: i32, x: f64) -> f64 with Mut {
    var b1 = 0.0
    var b2 = 0.0
    var k = n - 1
    while k >= 1 {
        let b0 = 2.0 * x * b1 - b2 + coeffs[k]
        b2 = b1
        b1 = b0
        k = k - 1
    }
    x * b1 - b2 + coeffs[0]
}

// [2/2] Pade approximant of exp(x) centered at x = 0.
//
// exp(x) ~ (1 + x/2 + x^2/12) / (1 - x/2 + x^2/12)
//
// This is the optimal rational approximation of degree (2,2) matching
// the Taylor series through order 4 at the origin.
fn pade_exp_22(x: f64) -> f64 with Div {
    let x2 = x * x
    let num = 1.0 + x / 2.0 + x2 / 12.0
    let den = 1.0 - x / 2.0 + x2 / 12.0
    num / den
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Approximation Theory Tests ===")
    println("")

    var pass = 0
    var fail = 0

    // Compute Chebyshev coefficients with n=20
    var coeffs20: [f64; 64] = [0.0; 64]
    cheb_coeffs_exp(20, &!coeffs20)

    // -----------------------------------------------------------------------
    // Test 1: Chebyshev approx of exp(x), n=20, eval at x=0 ~ 1.0
    // -----------------------------------------------------------------------
    let prev1 = pass
    print("Test  1: Cheb exp(0) = 1.0 ......... ")
    let v1 = cheb_eval(&coeffs20, 20, 0.0)
    check_f64(v1, 1.0, 1.0e-12, &!pass, &!fail)
    if pass > prev1 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 2: Chebyshev approx of exp(0.5), n=20
    // -----------------------------------------------------------------------
    let prev2 = pass
    print("Test  2: Cheb exp(0.5) ............. ")
    let v2 = cheb_eval(&coeffs20, 20, 0.5)
    let e2 = exp_f64(0.5)
    check_f64(v2, e2, 1.0e-12, &!pass, &!fail)
    if pass > prev2 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 3: Chebyshev approx of exp(-0.8), n=20
    // -----------------------------------------------------------------------
    let prev3 = pass
    print("Test  3: Cheb exp(-0.8) ............ ")
    let v3 = cheb_eval(&coeffs20, 20, 0.0 - 0.8)
    let e3 = exp_f64(0.0 - 0.8)
    check_f64(v3, e3, 1.0e-10, &!pass, &!fail)
    if pass > prev3 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 4: Chebyshev approx of exp(1.0), n=20, expect e
    // -----------------------------------------------------------------------
    let prev4 = pass
    print("Test  4: Cheb exp(1.0) = e ......... ")
    let v4 = cheb_eval(&coeffs20, 20, 1.0)
    let e4 = exp_f64(1.0)
    check_f64(v4, e4, 1.0e-10, &!pass, &!fail)
    if pass > prev4 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 5: Chebyshev approx of exp(-1.0), n=20, expect 1/e
    // -----------------------------------------------------------------------
    let prev5 = pass
    print("Test  5: Cheb exp(-1.0) = 1/e ...... ")
    let v5 = cheb_eval(&coeffs20, 20, 0.0 - 1.0)
    let e5 = exp_f64(0.0 - 1.0)
    check_f64(v5, e5, 1.0e-10, &!pass, &!fail)
    if pass > prev5 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 6: Chebyshev approx error is small across [-1, 1]
    //
    // Sample 21 points and verify the maximum pointwise error is below 1e-10.
    // This validates the overall quality of the 20-term expansion.
    // -----------------------------------------------------------------------
    let prev6 = pass
    print("Test  6: Cheb max error < 1e-10 .... ")
    var max_err6 = 0.0
    var xi = 0
    while xi <= 20 {
        let xv = 0.0 - 1.0 + 0.1 * (xi as f64)
        let approx_val = cheb_eval(&coeffs20, 20, xv)
        let exact_val = exp_f64(xv)
        let err6 = abs_f64(approx_val - exact_val)
        if err6 > max_err6 { max_err6 = err6 }
        xi = xi + 1
    }
    check_f64(max_err6, 0.0, 1.0e-10, &!pass, &!fail)
    if pass > prev6 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 7: Pade [2/2] of exp(x) at x=0.1
    // -----------------------------------------------------------------------
    let prev7 = pass
    print("Test  7: Pade exp(0.1) ............. ")
    let v7 = pade_exp_22(0.1)
    let e7 = exp_f64(0.1)
    check_f64(v7, e7, 1.0e-6, &!pass, &!fail)
    if pass > prev7 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 8: Pade [2/2] of exp(x) at x=0.5
    // -----------------------------------------------------------------------
    let prev8 = pass
    print("Test  8: Pade exp(0.5) ............. ")
    let v8 = pade_exp_22(0.5)
    let e8 = exp_f64(0.5)
    check_f64(v8, e8, 1.0e-4, &!pass, &!fail)
    if pass > prev8 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 9: Pade [2/2] of exp(x) at x=0 is exactly 1.0
    // -----------------------------------------------------------------------
    let prev9 = pass
    print("Test  9: Pade exp(0) = 1.0 ......... ")
    let v9 = pade_exp_22(0.0)
    check_f64(v9, 1.0, 1.0e-12, &!pass, &!fail)
    if pass > prev9 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 10: Clenshaw eval of T_0 = 1 (coeffs = [1, 0, ...])
    //
    // The zeroth Chebyshev polynomial is the constant 1.
    // Evaluating at an arbitrary point should yield 1.0.
    // -----------------------------------------------------------------------
    let prev10 = pass
    print("Test 10: Clenshaw T_0 = 1 .......... ")
    var c_t0: [f64; 64] = [0.0; 64]
    c_t0[0] = 1.0
    let v10 = cheb_eval(&c_t0, 1, 0.73)
    check_f64(v10, 1.0, 1.0e-12, &!pass, &!fail)
    if pass > prev10 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 11: Clenshaw eval of T_1 = x (coeffs = [0, 1, 0, ...])
    //
    // The first Chebyshev polynomial is the identity T_1(x) = x.
    // -----------------------------------------------------------------------
    let prev11 = pass
    print("Test 11: Clenshaw T_1 = x .......... ")
    var c_t1: [f64; 64] = [0.0; 64]
    c_t1[1] = 1.0
    let test_x11 = 0.42
    let v11 = cheb_eval(&c_t1, 2, test_x11)
    check_f64(v11, test_x11, 1.0e-12, &!pass, &!fail)
    if pass > prev11 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Test 12: n=5 Chebyshev approximation is less accurate than n=20
    //
    // Verify that increasing the number of terms improves accuracy,
    // which is the fundamental property of spectral convergence.
    // -----------------------------------------------------------------------
    let prev12 = pass
    print("Test 12: n=5 less accurate than n=20 ")
    var coeffs5: [f64; 64] = [0.0; 64]
    cheb_coeffs_exp(5, &!coeffs5)
    // Evaluate both at x = 0.7 and compare errors
    let xtest = 0.7
    let exact12 = exp_f64(xtest)
    let approx5 = cheb_eval(&coeffs5, 5, xtest)
    let approx20 = cheb_eval(&coeffs20, 20, xtest)
    let err5 = abs_f64(approx5 - exact12)
    let err20 = abs_f64(approx20 - exact12)
    // n=20 should be strictly more accurate than n=5
    if err20 < err5 {
        pass = pass + 1
    } else {
        fail = fail + 1
    }
    if pass > prev12 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Summary
    // -----------------------------------------------------------------------
    println("")
    print("Passed: ")
    println(pass)
    print("Failed: ")
    println(fail)

    if fail > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 12 TESTS PASSED")
    return 0
}
