 assert(read_i64(canvas.pixels,210*1440+380)==70*65536+180*256+235)
 assert(read_i64(canvas.pixels,330*1440+1040)==245*65536+170*256+65)
 assert(read_i64(canvas.pixels,390*1440+118)==190*65536+200*256+215)
