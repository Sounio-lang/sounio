 assert(viz_add_label(&!scene,&note,51,viz_layout_rect(140,535,1140,20),viz_style_rgb(220,230,240))>=0)
 assert(scene.node_count==12 && scene.series_count==2)
 assert(scene.series[0].n==3 && scene.series[1].n==3)
 assert(scene.series[0].ys[1]==15.0 && scene.series[1].ys[1]==0.25)
 let pixels=heap_alloc(1440*600*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:1440,height:600}
 canvas_clear(&!canvas,0,0,0)
