 viz_node_set_label(&!scene,ya,&countunit,14)
 viz_node_set_label(&!scene,yb,&zerounit,24)
 assert(viz_add_label(&!scene,&title,46,viz_layout_rect(140,20,1140,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&subtitle,52,viz_layout_rect(140,52,1140,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&headA,22,viz_layout_rect(140,94,480,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&headB,44,viz_layout_rect(800,94,480,20),viz_style_rgb(220,230,240))>=0)
