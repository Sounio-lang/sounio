//@ run-pass
//@ expect-stdout: VIZ_COUNT_MATRIX_QC_PASS
//@ expect-stdout: scatter n=3
//@ expect-stdout: Counts parsed incrementally from synthetic TSV bytes
//@ expect-stdout: Zero fraction = zero counts / 4 feature rows
//@ expect-stdout: No intervals or biological quality assessment
use genomics::io::count_tsv::{count_tsv_new,count_tsv_feed,count_tsv_ack_row,count_tsv_finish,count_qc_new,count_qc_add_row}
use viz::ir::{viz_scene_new,viz_add_scatter_chart,viz_add_axis,viz_node_set_label,viz_add_label,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var bytes:[i64;256]=[0;256]
 bytes[0]=48
 bytes[1]=9
 bytes[2]=50
 bytes[3]=9
 bytes[4]=52
 bytes[5]=13
 bytes[6]=10
 bytes[7]=51
 bytes[8]=9
 bytes[9]=48
 bytes[10]=9
 bytes[11]=48
 bytes[12]=10
 bytes[13]=48
 bytes[14]=9
 bytes[15]=54
 bytes[16]=9
 bytes[17]=48
 bytes[18]=13
 bytes[19]=10
 bytes[20]=53
 bytes[21]=9
 bytes[22]=55
 bytes[23]=9
 bytes[24]=56
 var parser=count_tsv_new(3)
 var qc=count_qc_new(3)
 var cursor:i64=0
 while cursor<25 {
  var chunk:[i64;256]=[0;256]
  var length:i64=25-cursor
  if length>3 { length=3 }
  var j:i64=0
  while j<length { chunk[j as usize]=bytes[(cursor+j) as usize] j=j+1 }
  let event=count_tsv_feed(&!parser,&chunk,length)
  assert(event.status==0 && event.consumed>0 && event.consumed<=length)
  cursor=cursor+event.consumed
  assert(event.position==cursor)
  if event.row_ready {
   assert(count_qc_add_row(&!qc,&parser.row)==0)
   assert(count_tsv_ack_row(&!parser))
  }
 }
 let last=count_tsv_finish(&!parser)
 assert(last.status==0 && last.finished && last.row_ready && last.consumed==0)
 assert(count_qc_add_row(&!qc,&parser.row)==0)
 assert(count_tsv_ack_row(&!parser))
 let done=count_tsv_finish(&!parser)
 assert(done.status==0 && done.finished && !done.row_ready)
 assert(qc.status==0 && qc.rows==4 && parser.rows==4 && parser.position==25)
 assert(qc.totals[0]==8 && qc.totals[1]==15 && qc.totals[2]==12)
 assert(qc.zeros[0]==2 && qc.zeros[1]==1 && qc.zeros[2]==2)
 var order:[f64;1024]=[0.0;1024]
 var totals:[f64;1024]=[0.0;1024]
 var fractions:[f64;1024]=[0.0;1024]
 var i:i64=0
 while i<3 {
  // Exact plotted cast for this bounded fixture. General i64>2^53 may round.
  assert(qc.totals[i as usize]>=0 && qc.totals[i as usize]<=9007199254740992)
  order[i as usize]=(i+1) as f64
  totals[i as usize]=qc.totals[i as usize] as f64
  fractions[i as usize]=(qc.zeros[i as usize] as f64)/(qc.rows as f64)
  i=i+1
 }
 var scene=viz_scene_new()
 let a=viz_add_scatter_chart(&!scene,&order,&totals,3,viz_layout_rect(140,150,480,240),viz_style_rgb(70,180,235))
 let b=viz_add_scatter_chart(&!scene,&order,&fractions,3,viz_layout_rect(800,150,480,240),viz_style_rgb(245,170,65))
 assert(a==0 && b==1)
 scene.series[0].x_min=0.0
 scene.series[0].x_max=4.0
 scene.series[0].y_min=0.0
 scene.series[0].y_max=20.0
 scene.series[1].x_min=0.0
 scene.series[1].x_max=4.0
 scene.series[1].y_min=0.0
 scene.series[1].y_max=1.0
 let xa=viz_add_axis(&!scene,0.0,4.0,4,false,viz_layout_rect(140,408,480,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,20.0,4,true,viz_layout_rect(120,150,1,240),viz_style_rgb(190,200,215))
 let xb=viz_add_axis(&!scene,0.0,4.0,4,false,viz_layout_rect(800,408,480,1),viz_style_rgb(190,200,215))
 let yb=viz_add_axis(&!scene,0.0,1.0,4,true,viz_layout_rect(780,150,1,240),viz_style_rgb(190,200,215))
