//@ run-pass
//@ requires: madaros
//@ expect-stdout: DEEP DISPERSION PROFILE PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use stats::regression::dynamic_dispersion::{DispersionSearchOptions,dynamic_dispersion_workspace,dynamic_dispersion_fit}
use math::pure::{ln_checked,is_finite}
use io::sci_print::{println_f64_sci}
fn profile_case(case_id:i64,method:i64,prior:bool,variant:i64) with Alloc,IO,Mut,Div,Panic {
 let n:i64=16
 let p:i64=2
 let plan=dynamic_dispersion_workspace(n,p,method)
 assert(plan.status==0)
 var a=numeric_buffer_new(n*p,n*p*8)
 let layout=numeric_matrix(n*p,n,p,p,1,0)
 var counts=integer_buffer_new(n,n*8)
 var offsets=numeric_buffer_new(n,n*8)
 var initial=numeric_buffer_new(p,p*8)
 var coefficients=numeric_buffer_new(p,p*8)
 var means=numeric_buffer_new(n,n*8)
 var eta=numeric_buffer_new(n,n*8)
 var candidate_coefficients=numeric_buffer_new(p,p*8)
 var candidate_means=numeric_buffer_new(n,n*8)
 var candidate_eta=numeric_buffer_new(n,n*8)
 var best_coefficients=numeric_buffer_new(p,p*8)
 var best_means=numeric_buffer_new(n,n*8)
 var best_eta=numeric_buffer_new(n,n*8)
 var weighted=numeric_buffer_new(plan.count_design_elements,plan.count_design_elements*8)
 var response=numeric_buffer_new(n,n*8)
 var step=numeric_buffer_new(p,p*8)
 var qr=numeric_buffer_new(plan.qr_elements,plan.qr_elements*8)
 var stage=numeric_buffer_new(plan.count_stage_elements,plan.count_stage_elements*8)
 var r=numeric_buffer_new(plan.factor_r_elements,plan.factor_r_elements*8)
 var scales=numeric_buffer_new(plan.factor_scale_elements,plan.factor_scale_elements*8)
 var permutation=integer_buffer_new(plan.permutation_elements,plan.permutation_elements*8)
 let data:[i64;16]=[0,0,1,2,5,8,13,19,1,1,2,3,7,12,18,28]
 var i:i64=0
 while i<n {
  let group=i/8
  var value=data[i as usize]
  if variant==1 {value=if group==0 {4}else{8}}
  if variant==8 || variant==9 {value=0}
  integer_buffer_set(&!counts,i,value)
  numeric_buffer_set(&!means,i,77.0)
  numeric_buffer_set(&!eta,i,88.0)
  var j:i64=0
  while j<p {
   var coordinate=if group==j {1.0}else{0.0}
   if variant==7 {if j==1 {coordinate=0.0}}
   if variant==9 {coordinate=if j==0 {1.0}else{if group==1 {1.0}else{0.0}}}
   numeric_buffer_set(&!a,i*p+j,coordinate)
   j=j+1
  }
  i=i+1
 }
 if variant==6 {integer_buffer_set(&!counts,0,9007199254740993)}
 var group:i64=0
 while group<p {
  var sum:f64=0.0
  i=group*8
  while i<(group+1)*8 {sum=sum+(data[i as usize] as f64);i=i+1}
  if variant==1 {sum=if group==0 {32.0}else{64.0}}
  let logged=ln_checked(sum/8.0)
  assert(logged.status==0)
  numeric_buffer_set(&!initial,group,logged.value)
  numeric_buffer_set(&!coefficients,group,99.0)
  group=group+1
 }
 var lo:f64= -5.0
 var hi:f64=3.0
 if variant==2 {lo=2.0;hi=3.0}
 if variant==3 {lo= -5.0;hi= -4.0}
 var budget:i64=130
 if variant==4 {budget=10}
 var variance:f64=0.7
 if variant==5 {variance=0.0}
 let options=DispersionSearchOptions{method:method,log_alpha_lower:lo,log_alpha_upper:hi,
 outer_tolerance:1e-6,max_outer_evaluations:budget,rcond:0.0,inner_iterations:100,
 inner_tolerance:1e-9,prior_active:prior,prior_center: -1.0,prior_variance:variance,
 compute_curvature:true}
 let result=dynamic_dispersion_fit(&a,&layout,&counts,&offsets,&initial,&options,
 &!coefficients,&!means,&!eta,&!candidate_coefficients,&!candidate_means,&!candidate_eta,
 &!best_coefficients,&!best_means,&!best_eta,&!weighted,&!response,&!step,&!qr,&!stage,
 &!r,&!scales,&!permutation)
 let trace_status:i64=result.status
 let trace_profile:i64=result.profile_status
 let trace_inner:i64=result.inner_status
 print("profile trace case: ");println(case_id)
 print("profile trace status: ");println(trace_status)
 print("profile trace range: ");println(trace_profile)
 print("profile trace inner: ");println(trace_inner)
 assert(!result.inference_eligible && !result.global_optimality_assessed && !result.assumptions_assessed)
 if variant<4 {
  assert(result.status==0 && result.point_available)
  assert(result.evaluations<=budget)
  assert(is_finite(result.objective_mean))
  if variant==0 {
   assert(result.profile_status==0 && !result.boundary_candidate && !result.poisson_selected)
   assert(result.local_curvature_available && result.curvature_status==0)
   let report_status:i64=result.status
   let report_log_alpha:f64=result.log_alpha
   let report_criterion:f64=result.objective_mean
   let report_variance:f64=result.log_alpha_variance
   let report_curvature:i64=if result.local_curvature_available {1}else{0}
   print("profile case: ");println(case_id)
   print("profile status: ");println(report_status)
   print("profile log alpha: ");println_f64_sci(report_log_alpha,15)
   print("profile criterion: ");println_f64_sci(report_criterion,15)
   print("profile variance: ");println_f64_sci(report_variance,15)
   print("profile curvature available: ");println(report_curvature)
   group=0
   while group<p {print("profile beta: ");println_f64_sci(numeric_buffer_at(&coefficients,group),15);group=group+1}
  }
  if variant==1 {
   assert(result.poisson_selected && result.alpha==0.0 && !result.log_alpha_available)
   assert(result.boundary_candidate && result.left_censored && result.curvature_status==2)
  }
  if variant==2 {assert(result.left_censored && result.boundary_candidate)}
  if variant==3 {assert(result.right_censored && result.boundary_candidate)}
 } else {
  assert(!result.point_available && !result.local_curvature_available)
  if variant==4 {assert(result.status==5 && result.evaluations==10)}
  if variant==5 {assert(result.status==2 && result.evaluations==0)}
  if variant==6 {assert(result.status==3 && result.failure_stage==1 && result.inner_status==9)}
  if variant==7 {assert(result.status==3 && result.failure_stage==1 && result.inner_status==6)}
  // One-hot columns span an intercept but no single column is constant.
  // The deliberately limited sufficient diagnostic does not certify it.
  if variant==8 {assert(result.status==3 && result.failure_stage==1 && result.inner_status==7)}
  if variant==9 {assert(result.status==3 && result.failure_stage==1 && result.inner_status==8)}
  group=0
  while group<p {assert(numeric_buffer_at(&coefficients,group)==99.0);group=group+1}
  i=0
  while i<n {assert(numeric_buffer_at(&means,i)==77.0 && numeric_buffer_at(&eta,i)==88.0);i=i+1}
 }
 numeric_buffer_close(a);integer_buffer_close(counts);numeric_buffer_close(offsets)
 numeric_buffer_close(initial);numeric_buffer_close(coefficients);numeric_buffer_close(means)
 numeric_buffer_close(eta);numeric_buffer_close(candidate_coefficients)
 numeric_buffer_close(candidate_means);numeric_buffer_close(candidate_eta)
 numeric_buffer_close(best_coefficients);numeric_buffer_close(best_means);numeric_buffer_close(best_eta)
 numeric_buffer_close(weighted);numeric_buffer_close(response);numeric_buffer_close(step)
 numeric_buffer_close(qr);numeric_buffer_close(stage);numeric_buffer_close(r)
 numeric_buffer_close(scales);integer_buffer_close(permutation)
}
fn main()->i32 with Alloc,IO,Mut,Div,Panic {
 assert(dynamic_dispersion_workspace(2,2,0).status==1)
 assert(dynamic_dispersion_workspace(16,2,2).status==1)
 assert(dynamic_dispersion_workspace(1073741824,1073741823,1).status==1)
 profile_case(0,0,false,0)
 profile_case(1,1,false,0)
 profile_case(2,0,true,0)
 profile_case(3,1,true,0)
 profile_case(4,0,false,1)
 profile_case(5,0,false,2)
 profile_case(6,0,false,3)
 profile_case(7,0,false,4)
 profile_case(8,0,true,5)
 profile_case(9,0,false,6)
 profile_case(10,0,false,7)
 profile_case(11,0,false,8)
 profile_case(12,0,false,9)
 println("DEEP DISPERSION PROFILE PASS")
 0
}
