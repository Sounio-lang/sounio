//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_LET_CTOR_PASS

// Pure ctor with let-bound field inits:
//   let y = x * 2.0; Pk { cl0: y }
// FO projection compiles preceding lets then field expr.

struct Pk {
    cl0: f64
}

fn make_let(x: f64) -> Pk {
    let y = x * 2.0
    Pk { cl0: y }
}

fn make_let2(x: f64, s: f64) -> Pk {
    let y = x * s
    let z = y + 0.0
    Pk { cl0: z }
}

fn make_let_nested(x: f64) -> Pk {
    let t = x
    let u = t * 2.0
    Pk { cl0: u }
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let ks: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let x = kx.value
    let s = ks.value

    let v_let = variance_of(make_let(x).cl0)
    let v_let2 = variance_of(make_let2(x, s).cl0)
    let v_nest = variance_of(make_let_nested(x).cl0)
    let v_peel = variance_of(x * 2.0)
    let v_peel2 = variance_of(x * s)

    // Alias of let-ctor then field
    let pk = make_let(x)
    let v_alias = variance_of(pk.cl0)

    print("v_let="); print_f64(v_let); print("\n")
    print("v_let2="); print_f64(v_let2); print("\n")
    print("v_nest="); print_f64(v_nest); print("\n")
    print("v_alias="); print_f64(v_alias); print("\n")

    let ok = abs_f(v_let - v_peel) < 1.0e-9
        && abs_f(v_let - 0.36) < 1.0e-9
        && abs_f(v_let2 - v_peel2) < 1.0e-9
        && abs_f(v_nest - v_peel) < 1.0e-9
        && abs_f(v_alias - v_peel) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_LET_CTOR_PASS\n")
    } else {
        print("MADAROS_GUM_FO_LET_CTOR_FAIL\n")
    }
}
