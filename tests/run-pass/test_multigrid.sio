    else { println("FAIL"); fail = fail + 1 }

    // Test 3
    print("Test  3: Restriction/prolongation adjoint ..... ")
    if test_adjoint_relation() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 4
    print("Test  4: Jacobi smoother reduces residual ..... ")
    if test_jacobi_reduces_residual() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 5
    print("Test  5: Red-black GS reduces residual ....... ")
    if test_gs_rb_reduces_residual() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 6
    print("Test  6: Thomas algorithm exact solve ......... ")
    if test_thomas_exact() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 7
    print("Test  7: V-cycle convergence factor < 0.5 ..... ")
    if test_vcycle_convergence() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 8
    print("Test  8: Full 1D Poisson -u''=pi^2*sin(pi*x) . ")
    if test_full_poisson_1d() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 9
    print("Test  9: 2D restriction preserves constant .... ")
    if test_restrict_2d_preserves_constant() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 10
    print("Test 10: 2D Jacobi reduces residual ........... ")
    if test_jacobi_2d_reduces_residual() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 11
    print("Test 11: Convergence factor in (0, 1) ......... ")
    if test_convergence_factor() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    // Test 12
    print("Test 12: Default config values ................ ")
    if test_default_config() { println("PASS"); pass = pass + 1 }
    else { println("FAIL"); fail = fail + 1 }

    println("")
    print("Passed: "); println(pass)
    print("Failed: "); println(fail)
    println("")
    if fail == 0 {
        println("ALL 12 TESTS PASSED")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}
