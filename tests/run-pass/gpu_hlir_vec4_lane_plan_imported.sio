//@ run-pass
//@ description: Imported GPU Knowledge Vec4 lane-plan runtime fixture.

use gpu_hlir_vec4_lane_plan_leaf::{
    gpu_hlir_vec4_lane_plan_make,
    gpu_hlir_vec4_lane_plan_offset,
    gpu_hlir_vec4_lane_plan_sum,
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let lanes = gpu_hlir_vec4_lane_plan_make()
    let sum = gpu_hlir_vec4_lane_plan_sum(lanes)

    if !(sum > 9.999 && sum < 10.001) { return 1 }
    if gpu_hlir_vec4_lane_plan_offset(0) != 0 { return 2 }
    if gpu_hlir_vec4_lane_plan_offset(1) != 32 { return 3 }
    if gpu_hlir_vec4_lane_plan_offset(2) != 64 { return 4 }
    if gpu_hlir_vec4_lane_plan_offset(3) != 96 { return 5 }

    println("PASS gpu_hlir_vec4_lane_plan_imported offsets=0,32,64,96 values=1,2,3,4")
    return 0
}
