//@ run-pass
//@ expect-stdout: NATIVE_MATH_BUILTIN_CONTROL_OK
//@ requires: madaros
// Control for native_math_without_backend_builtin.sio: the five names E221
// refuses are absent from the backend, and these five are NOT. If this ever
// goes red the refusal has widened past its evidence, which matters more than
// the refusal itself -- a diagnostic that fires on working code is worse than
// the crash it replaced.

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    if d < 0.0 { return 0.0 - d < 1.0e-6 }
    return d < 1.0e-6
}

fn main() with IO, Mut, Div {
    let ok = near(sin(0.5), 0.479425538604203)
        && near(cos(0.5), 0.8775825618903728)
        && near(exp(0.5), 1.6487212707001282)
        && near(log(0.5), 0.0 - 0.6931471805599453)
        && near(sqrt(0.5), 0.7071067811865476)
    if ok { print("NATIVE_MATH_BUILTIN_CONTROL_OK\n") }
    else { print("NATIVE_MATH_BUILTIN_CONTROL_FAIL\n") }
}
