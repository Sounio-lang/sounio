//@ run-pass
//@ expect-stdout: NATIVE_MATH_BUILTIN_CONTROL_OK
//@ requires: madaros
// Control for the backend math builtins sqrt, exp, log, sin and cos. Historically
// tan, atan, tanh, asin and acos were refused with E221 because the backend had
// no code for them; that refusal is gone (see math_trans_values.sio), and this
// test stays as the control that the five original builtins are unaffected.

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    if d < 0.0 { return 0.0 - d < 1.0e-6 }
    return d < 1.0e-6
}

fn main() -> i64 with IO, Mut, Div {
    var exit_fails: i64 = 0
    let ok = near(sin(0.5), 0.479425538604203)
        && near(cos(0.5), 0.8775825618903728)
        && near(exp(0.5), 1.6487212707001282)
        && near(log(0.5), 0.0 - 0.6931471805599453)
        && near(sqrt(0.5), 0.7071067811865476)
    if ok { print("NATIVE_MATH_BUILTIN_CONTROL_OK\n") }
    else { print("NATIVE_MATH_BUILTIN_CONTROL_FAIL\n"); exit_fails = exit_fails + 1 }
    if exit_fails > 0 {
        return 1
    }
    return 0
}
