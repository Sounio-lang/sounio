//@ run-pass
//@ expect-stdout: NATIVE_MATH_BUILTIN_CONTROL_OK
//@ requires: madaros
// Control for the five math names that DO have backend kernels. tan, atan,
// tanh, asin and acos have none; Madaros serves those through the implicit
// math::transcendental import (#2507, native_math_transcendentals_values.sio).
// These five must stay on their native builtins -- the implicit import is keyed
// on its own five names and must not reach these. If this goes red, something
// displaced a native kernel.

fn near(a: f64, b: f64) -> bool {
    let d = a - b
    if d < 0.0 { return 0.0 - d < 1.0e-6 }
    return d < 1.0e-6
}

fn main() with IO, Mut, Div {
    let ok = near(sin(0.5), 0.479425538604203)
        && near(cos(0.5), 0.8775825618903728)
        && near(exp(0.5), 1.6487212707001282)
        && near(log(0.5), 0.0 - 0.6931471805599453)
        && near(sqrt(0.5), 0.7071067811865476)
    if ok { print("NATIVE_MATH_BUILTIN_CONTROL_OK\n") }
    else { print("NATIVE_MATH_BUILTIN_CONTROL_FAIL\n") }
}
