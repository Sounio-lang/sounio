//@ run-pass
//@ requires: madaros
//@ description: Whitespace before `!` also keeps a bang expression distinct from Rust macro syntax

// Companion to parser_spaced_bang_expression.sio, which covers `x! (y)`.
//
// #2247 tests the two adjacency boundaries separately — no space between the
// identifier and `!`, AND none between `!` and `(`. That witness pins only the
// right-hand boundary, so the left one was implemented and unwitnessed. This
// pins it.
//
// Measured on a Madaros built from current source, all four spellings:
//
//   x!(y)    -> error[E043]     both boundaries tight
//   x! (y)   -> accepted        right boundary spaced  (the sibling witness)
//   x !(y)   -> accepted        left boundary spaced   (this file)
//   x ! (y)  -> accepted        both spaced
fn main() {
    let x = 20
    let y = 22
    let value = x !(y)
    assert(value == 42)
}
