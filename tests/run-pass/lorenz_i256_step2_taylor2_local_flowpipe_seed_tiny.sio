//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 local flowpipe seed receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn point_replay_mask() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x1: i256 = 4294967296 as i256
    let y1: i256 = 5411658768 as i256
    let z1: i256 = 4223384510 as i256
    let dy_scaled_q: i256 = 116035699778 as i256
    let xy_scaled_q: i256 = 5411658768 as i256
    let beta_q: i256 = 11262358693 as i256
    let x_inc_q: i256 = 111669144 as i256
    let x_inc_r: i256 = 3023657216 as i256
    let y_inc_q: i256 = 1106240385 as i256
    let y_inc_r: i256 = 1604599760 as i256
    let z_drop_q: i256 = 58506997 as i256
    let z_drop_r: i256 = 4047004488 as i256
    let dx_num: i256 = (10 as i256) * (y1 - x1)
    let dy_num: i256 = x1 * ((28 as i256) * scale - z1)
    let xy_num: i256 = x1 * y1
    let beta_num_z: i256 = (8 as i256) * z1
    let dy: i256 = dy_scaled_q - y1
    let dz_drop_num: i256 = beta_q - xy_scaled_q

    var mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { mask = mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, 0 as i256) == 1 { mask = mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, 0 as i256) == 1 { mask = mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, 1 as i256) == 1 { mask = mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { mask = mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { mask = mask + 32 }
    if check_div_witness_i256(dt * dz_drop_num, scale, z_drop_q, z_drop_r) == 1 { mask = mask + 64 }
    return mask
}

fn instance_fp() -> i64 {
    var fp: i64 = 1583
    fp = mix(fp, 335080767, 5443)
    fp = mix(fp, 335080767, 5443)
    fp = mix(fp, 899209716, 5443)
    fp = mix(fp, 249889958, 5443)
    fp = mix(fp, 603078026, 5443)
    fp = mix(fp, 2, 5443)
    fp = mix(fp, 2, 5443)
    fp = mix(fp, 3, 5443)
    fp = mix(fp, 256, 5443)
    fp = mix(fp, 32, 5443)
    fp = mix(fp, 1, 5443)
    fp = mix(fp, 100, 5443)
    fp = mix(fp, 4294967296, 5443)
    fp = mix(fp, 5411658768, 5443)
    fp = mix(fp, 4223384510, 5443)
    fp = mix(fp, 4406636440, 5443)
    fp = mix(fp, 6517899153, 5443)
    fp = mix(fp, 4164877513, 5443)
    fp = mix(fp, 116035699778, 5443)
    fp = mix(fp, 0, 5443)
    fp = mix(fp, 5411658768, 5443)
    fp = mix(fp, 0, 5443)
    fp = mix(fp, 11262358693, 5443)
    fp = mix(fp, 1, 5443)
    fp = mix(fp, 111669144, 5443)
    fp = mix(fp, 3023657216, 5443)
    fp = mix(fp, 1106240385, 5443)
    fp = mix(fp, 1604599760, 5443)
    fp = mix(fp, 58506997, 5443)
    fp = mix(fp, 4047004488, 5443)
    fp = mix(fp, 127, 5443)
    fp = mix(fp, 7, 5443)
    fp = mix(fp, 7, 5443)
    fp = mix(fp, 3, 5443)
    fp = mix(fp, 15, 5443)
    fp = mix(fp, 0, 5443)
    fp = mix(fp, 0, 5443)
    fp = mix(fp, 22, 5443)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 551664923 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1597
    fp = mix(fp, instance, 5449)
    fp = mix(fp, 127, 5449)
    fp = mix(fp, 7, 5449)
    fp = mix(fp, 7, 5449)
    fp = mix(fp, 3, 5449)
    fp = mix(fp, 15, 5449)
    fp = mix(fp, 0, 5449)
    fp = mix(fp, 0, 5449)
    fp = mix(fp, 22, 5449)
    fp = mix(fp, ok_mask, 5449)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 551664923 { return 0 - 1 }
    if certificate != 87899344 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1601
    fp = mix(fp, instance, 5471)
    fp = mix(fp, certificate, 5471)
    fp = mix(fp, 18, 5471)
    fp = mix(fp, 2, 5471)
    fp = mix(fp, 127, 5471)
    fp = mix(fp, 15, 5471)
    fp = mix(fp, 0, 5471)
    fp = mix(fp, 0, 5471)
    fp = mix(fp, 22, 5471)
    fp = mix(fp, ok_mask, 5471)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 633359277 { return 0 - 1 }
    if instance != 551664923 { return 0 - 1 }
    if certificate != 87899344 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1607
    fp = mix(fp, artifact, 5477)
    fp = mix(fp, instance, 5477)
    fp = mix(fp, certificate, 5477)
    fp = mix(fp, 335080767, 5477)
    fp = mix(fp, 335080767, 5477)
    fp = mix(fp, 899209716, 5477)
    fp = mix(fp, 249889958, 5477)
    fp = mix(fp, 603078026, 5477)
    fp = mix(fp, 4294967296, 5477)
    fp = mix(fp, 5411658768, 5477)
    fp = mix(fp, 4223384510, 5477)
    fp = mix(fp, 4406636440, 5477)
    fp = mix(fp, 6517899153, 5477)
    fp = mix(fp, 4164877513, 5477)
    fp = mix(fp, 2, 5477)
    fp = mix(fp, 22, 5477)
    fp = mix(fp, ok_mask, 5477)
    return fp
}

fn seed_ok_mask(global_claim_mask: i64, status: i64) -> i64 {
    var ok_mask: i64 = 0
    if point_replay_mask() == 127 { ok_mask = ok_mask + 1 }
    if 7 == 7 { ok_mask = ok_mask + 2 }
    if 7 == 7 { ok_mask = ok_mask + 4 }
    if 3 == 3 { ok_mask = ok_mask + 8 }
    if 15 == 15 { ok_mask = ok_mask + 16 }
    if global_claim_mask == 0 {
        if status == 22 { ok_mask = ok_mask + 32 }
    }
    if 2 + 1 == 3 { ok_mask = ok_mask + 64 }
    if 0 == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = seed_ok_mask(0, 22)
    if ok_mask != 255 { return 1 }
    if point_replay_mask() != 127 { return 2 }
    let inst = instance_fp()
    if inst != 551664923 { return 3 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 87899344 { return 4 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 633359277 { return 5 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 421619310 { return 6 }
    if seed_ok_mask(1, 22) == 255 { return 7 }
    if certificate_fp(inst, 254) != (0 - 1) { return 8 }
    return 0
}
