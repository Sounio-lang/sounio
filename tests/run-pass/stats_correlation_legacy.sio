//@ run-pass
//@ expect-stdout: STATS_CORRELATION_LEGACY_PASS
use stats::correlation::{pearson,spearman,run_tests}
use stats::inferential::{spearman_rho,spearman_test}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 var xx:[f64;100]=[0.0;100]
 var yy:[f64;100]=[0.0;100]
 var i:i64=0
 while i<5 {
  x[i as usize]=i as f64;y[i as usize]=((i*i)%7) as f64
  xx[i as usize]=x[i as usize];yy[i as usize]=y[i as usize];i=i+1
 }
 assert(pearson(&x,&y,5,0.95).status==0)
 assert(spearman(&x,&y,5).status==0)
 assert(spearman_test(xx,yy,5).status==0)
 assert(spearman_rho(xx,yy,101)== -2.0)
 assert(spearman_test(xx,yy,101).status==1)
 assert(pearson(&x,&y,257,0.95).status==1)
 assert(spearman(&x,&y,257).status==1)
 i=0
 while i<5 {xx[i as usize]=1.0;i=i+1}
 assert(spearman_rho(xx,yy,5)== -2.0)
 let constant=spearman_test(xx,yy,5)
 assert(constant.status==3 && constant.p_value== -1.0 && constant.p_status!=0)
 assert(run_tests())
 println("STATS_CORRELATION_LEGACY_PASS")
 0
}
