//@ run-pass
// FFI ctypes test - pointer arithmetic and memory operations
//
// Self-contained test suite validating basic FFI type operations:
//   pointer offset calculation, c_int size assumptions,
//   null pointer detection, manual memset/memcmp
//
// All types and functions inlined since tests cannot import.

// ============================================================================
// C TYPE DEFINITIONS (mirrors ffi::ctypes)
// ============================================================================

// Standard C integer sizes (assuming LP64 / x86-64)
fn size_of_c_int() -> i32 {
    return 4
}

fn size_of_c_long() -> i32 {
    return 8
}

fn size_of_c_char() -> i32 {
    return 1
}

fn size_of_ptr() -> i32 {
    return 8
}

// ============================================================================
// POINTER ARITHMETIC HELPERS
// ============================================================================

// Compute byte offset for an array element: base + index * element_size
fn ptr_offset(base: i64, index: i32, element_size: i32) -> i64 {
    return base + (index as i64) * (element_size as i64)
}

// Compute the number of elements between two pointers
fn ptr_diff(p1: i64, p2: i64, element_size: i32) -> i32 with Panic {
    let byte_diff = p1 - p2
    return (byte_diff / (element_size as i64)) as i32
}

// Check if a pointer value is null (zero)
fn is_null_ptr(p: i64) -> bool {
    return p == 0
}

// Align a pointer up to a given alignment
fn align_up(addr: i64, alignment: i32) -> i64 {
    let a = alignment as i64
    let mask = a - 1
    return (addr + mask) & (0 - a)
}

// ============================================================================
// MANUAL MEMORY OPERATIONS (byte-level simulation)
// ============================================================================

// Simulated memory buffer: fixed-size array of bytes represented as i32
// (since Sounio uses i32 for small values)

struct MemBuffer {
    data: [i32; 256],
    size: i32,
}

fn membuf_new() -> MemBuffer with Mut {
    var data: [i32; 256] = [0; 256]
    MemBuffer { data: data, size: 256 }
}

// Set all bytes in buffer to a given value (simulated memset)
fn membuf_set(buf: MemBuffer, value: i32, count: i32) -> MemBuffer with Mut, Panic, Div {
    var i = 0
    while i < count {
        buf.data[i] = value
        i = i + 1
    }
    buf
}

// Compare two buffers byte-by-byte (simulated memcmp)
// Returns: 0 if equal, negative if a < b, positive if a > b
fn membuf_cmp(a: MemBuffer, b: MemBuffer, count: i32) -> i32 with Mut, Panic, Div {
    var i = 0
    while i < count {
        if a.data[i] < b.data[i] {
            return 0 - 1
        }
        if a.data[i] > b.data[i] {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Copy bytes from source to destination (simulated memcpy)
fn membuf_copy(dst: MemBuffer, src: MemBuffer, count: i32) -> MemBuffer with Mut, Panic, Div {
    var i = 0
    while i < count {
        dst.data[i] = src.data[i]
        i = i + 1
    }
    dst
}

// Find first occurrence of a byte value (simulated memchr)
// Returns index or -1 if not found
fn membuf_chr(buf: MemBuffer, value: i32, count: i32) -> i32 with Mut, Panic, Div {
    var i = 0
    while i < count && i < buf.size {
        if buf.data[i] == value {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

// Test 1: Pointer offset calculation for i32 array
fn test_ptr_offset_i32() -> bool with IO, Mut, Panic, Div {
    let base = 0x1000 as i64
    let elem_size = size_of_c_int()
    // Element 0 should be at base
    let p0 = ptr_offset(base, 0, elem_size)
    let ok1 = p0 == base
    // Element 5 should be at base + 5*4 = base + 20
    let p5 = ptr_offset(base, 5, elem_size)
    let ok2 = p5 == base + 20
    // Element 10 should be at base + 40
    let p10 = ptr_offset(base, 10, elem_size)
    let ok3 = p10 == base + 40
    return ok1 && ok2 && ok3
}

// Test 2: Pointer offset for byte array (c_char)
fn test_ptr_offset_char() -> bool with IO, Mut, Panic, Div {
    let base = 0x2000 as i64
    let elem_size = size_of_c_char()
    // For char arrays, offset == index
    let p3 = ptr_offset(base, 3, elem_size)
    let ok1 = p3 == base + 3
    let p100 = ptr_offset(base, 100, elem_size)
    let ok2 = p100 == base + 100
    return ok1 && ok2
}

// Test 3: Pointer difference (inverse of offset)
fn test_ptr_diff() -> bool with IO, Mut, Panic, Div {
    let base = 0x3000 as i64
    let elem_size = size_of_c_int()
    let p0 = base
    let p7 = ptr_offset(base, 7, elem_size)
    let diff = ptr_diff(p7, p0, elem_size)
    let ok1 = diff == 7
    // Diff of same pointer should be 0
    let diff0 = ptr_diff(p0, p0, elem_size)
    let ok2 = diff0 == 0
    return ok1 && ok2
}

// Test 4: c_int is 4 bytes (standard assumption on LP64)
fn test_c_int_size() -> bool with IO, Mut, Panic, Div {
    let s = size_of_c_int()
    return s == 4
}

// Test 5: c_long is 8 bytes on LP64
fn test_c_long_size() -> bool with IO, Mut, Panic, Div {
    let s = size_of_c_long()
    return s == 8
}

// Test 6: Pointer is 8 bytes on 64-bit
fn test_ptr_size() -> bool with IO, Mut, Panic, Div {
    let s = size_of_ptr()
    return s == 8
}

// Test 7: Null pointer detection
fn test_null_ptr() -> bool with IO, Mut, Panic, Div {
    let ok1 = is_null_ptr(0)
    let ok2 = is_null_ptr(1) == false
    let ok3 = is_null_ptr(0 - 1) == false
    let ok4 = is_null_ptr(0x1000) == false
    return ok1 && ok2 && ok3 && ok4
}

// Test 8: Pointer alignment
fn test_align_up() -> bool with IO, Mut, Panic, Div {
    // Align to 4 bytes
    let ok1 = align_up(1, 4) == 4
    let ok2 = align_up(4, 4) == 4
    let ok3 = align_up(5, 4) == 8
    let ok4 = align_up(0, 4) == 0
    // Align to 8 bytes
    let ok5 = align_up(1, 8) == 8
    let ok6 = align_up(8, 8) == 8
    let ok7 = align_up(9, 8) == 16
    // Align to 16 bytes
    let ok8 = align_up(17, 16) == 32
    return ok1 && ok2 && ok3 && ok4 && ok5 && ok6 && ok7 && ok8
}

// Test 9: Simulated memset - fill buffer with a value
fn test_memset() -> bool with IO, Mut, Panic, Div {
    var buf = membuf_new()
    buf = membuf_set(buf, 42, 10)
    // First 10 bytes should be 42
    let ok1 = buf.data[0] == 42
    let ok2 = buf.data[9] == 42
    // Byte 10 should still be 0
    let ok3 = buf.data[10] == 0
    return ok1 && ok2 && ok3
}

// Test 10: Simulated memcmp - compare equal buffers
fn test_memcmp_equal() -> bool with IO, Mut, Panic, Div {
    var a = membuf_new()
    var b = membuf_new()
    a = membuf_set(a, 7, 16)
    b = membuf_set(b, 7, 16)
    let result = membuf_cmp(a, b, 16)
    return result == 0
}

// Test 11: Simulated memcmp - compare different buffers
fn test_memcmp_diff() -> bool with IO, Mut, Panic, Div {
    var a = membuf_new()
    var b = membuf_new()
    a = membuf_set(a, 5, 16)
    b = membuf_set(b, 5, 16)
    // Make byte 8 different
    b.data[8] = 10
    let result = membuf_cmp(a, b, 16)
    // a[8]=5 < b[8]=10, so result should be negative
    let ok1 = result < 0
    // Reverse comparison
    let result2 = membuf_cmp(b, a, 16)
    let ok2 = result2 > 0
    return ok1 && ok2
}

// Test 12: Simulated memcpy
fn test_memcpy() -> bool with IO, Mut, Panic, Div {
    var src = membuf_new()
    var dst = membuf_new()
    // Fill source with pattern
    var i = 0
    while i < 20 {
        src.data[i] = i * 3
        i = i + 1
    }
    dst = membuf_copy(dst, src, 20)
    // Verify copy
    let ok1 = dst.data[0] == 0
    let ok2 = dst.data[1] == 3
    let ok3 = dst.data[5] == 15
    let ok4 = dst.data[19] == 57
    // Byte 20 should be unchanged (0)
    let ok5 = dst.data[20] == 0
    return ok1 && ok2 && ok3 && ok4 && ok5
}

// Test 13: Simulated memchr - find byte in buffer
fn test_memchr() -> bool with IO, Mut, Panic, Div {
    var buf = membuf_new()
    buf.data[0] = 1
    buf.data[1] = 2
    buf.data[2] = 3
    buf.data[3] = 4
    buf.data[4] = 5
    // Find value 3
    let idx = membuf_chr(buf, 3, 10)
    let ok1 = idx == 2
    // Find value not present
    let idx2 = membuf_chr(buf, 99, 10)
    let ok2 = idx2 == (0 - 1)
    // Find first occurrence
    buf.data[7] = 3
    let idx3 = membuf_chr(buf, 3, 10)
    let ok3 = idx3 == 2
    return ok1 && ok2 && ok3
}

// Test 14: Memset then memcmp roundtrip
fn test_memset_cmp_roundtrip() -> bool with IO, Mut, Panic, Div {
    var a = membuf_new()
    var b = membuf_new()
    // Set both to same pattern
    a = membuf_set(a, 0xFF, 64)
    b = membuf_set(b, 0xFF, 64)
    let ok1 = membuf_cmp(a, b, 64) == 0
    // Change one byte in a
    a.data[32] = 0
    let ok2 = membuf_cmp(a, b, 64) != 0
    return ok1 && ok2
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== FFI CTypes Tests ===")
    println("")

    var passed = 0
    var failed = 0

    print("Test  1: ptr offset i32............ ")
    if test_ptr_offset_i32() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  2: ptr offset char........... ")
    if test_ptr_offset_char() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  3: ptr diff.................. ")
    if test_ptr_diff() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  4: c_int size 4 bytes........ ")
    if test_c_int_size() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  5: c_long size 8 bytes....... ")
    if test_c_long_size() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  6: ptr size 8 bytes.......... ")
    if test_ptr_size() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  7: null ptr detection........ ")
    if test_null_ptr() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  8: pointer alignment......... ")
    if test_align_up() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  9: memset.................... ")
    if test_memset() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test 10: memcmp equal.............. ")
    if test_memcmp_equal() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test 11: memcmp different.......... ")
    if test_memcmp_diff() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test 12: memcpy.................... ")
    if test_memcpy() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test 13: memchr.................... ")
    if test_memchr() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test 14: memset-cmp roundtrip...... ")
    if test_memset_cmp_roundtrip() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 14 TESTS PASSED")
    return 0
}
