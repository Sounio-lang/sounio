        0x86, 0x2A, 0x68, 0x74, 0x74, 0x70, 0x3A, 0x2F, 0x2F, 0x63, 0x72, 0x6C,
        0x73, 0x2E, 0x73, 0x73, 0x6C, 0x2E, 0x63, 0x6F, 0x6D, 0x2F, 0x73, 0x73,
        0x6C, 0x2E, 0x63, 0x6F, 0x6D, 0x2D, 0x65, 0x63, 0x63, 0x2D, 0x52, 0x6F,
        0x6F, 0x74, 0x43, 0x41, 0x2E, 0x63, 0x72, 0x6C, 0x30, 0x1D, 0x06, 0x03,
        0x55, 0x1D, 0x0E, 0x04, 0x16, 0x04, 0x14, 0x0D, 0x74, 0x66, 0x0A, 0x5E,
        0x9F, 0xE2, 0x2C, 0xEC, 0xD5, 0xC2, 0x5D, 0x25, 0x04, 0x7F, 0x75, 0x32,
        0xBA, 0xFF, 0x7D, 0x30, 0x0E, 0x06, 0x03, 0x55, 0x1D, 0x0F, 0x01, 0x01,
        0xFF, 0x04, 0x04, 0x03, 0x02, 0x01, 0x86, 0x30, 0x0A, 0x06, 0x08, 0x2A,
        0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x03, 0x03, 0x69, 0x00, 0x30, 0x66,
        0x02, 0x31, 0x00, 0xC5, 0x8B, 0x7A, 0x62, 0x59, 0x3F, 0x37, 0xC1, 0x5C,
        0x87, 0xFD, 0xDF, 0x80, 0xA6, 0x0A, 0xC0, 0x8E, 0x40, 0xD3, 0x5D, 0x50,
        0x30, 0xA5, 0xB4, 0x87, 0x71, 0x7D, 0x25, 0x6F, 0xCD, 0x5F, 0xF1, 0x7B,
        0xA1, 0x8B, 0x56, 0xAF, 0x19, 0x63, 0x85, 0xE1, 0xFC, 0x9F, 0x60, 0x6B,
        0x90, 0x3C, 0x9B, 0x02, 0x31, 0x00, 0x94, 0x2C, 0x64, 0x2C, 0x4D, 0x2F,
        0x41, 0x36, 0x1C, 0x17, 0x3A, 0xD1, 0xDB, 0x8A, 0x28, 0x83, 0x2C, 0x3A,
        0x56, 0x48, 0x13, 0x9B, 0xDD, 0xBE, 0x8E, 0x2A, 0x89, 0x4C, 0xEE, 0x52,
        0x48, 0x0F, 0x50, 0x51, 0xAD, 0x3D, 0xD9, 0x2E, 0x5C, 0x4C, 0xA8, 0x87,
        0x90, 0x7D, 0x9C, 0x38, 0xCE, 0xA6,
    ]

    let leaf_buf = rawbuf_new(leaf_len + 8)
    var i: i64 = 0
    while i < leaf_len { rawbuf_set(&leaf_buf, i, leaf_bytes[i as usize] as i64); i = i + 1 }

    let inter_buf = rawbuf_new(inter_len + 8)
    var j: i64 = 0
    while j < inter_len { rawbuf_set(&inter_buf, j, inter_bytes[j as usize] as i64); j = j + 1 }

    // Both certificates must PARSE cleanly -- the rejection below has to be
    // the algorithm guard doing its job, not a parse failure masquerading
    // as one. (D15/D17/D18 each began with a symptom misattributed to the
    // parser; this check keeps that confusion out of this test.)
    var leaf = certificate_zero()
    let (lr, le) = x509_parse_certificate(&leaf_buf, leaf_len)
    leaf = lr
    if le != X509_OK { print_int(1); return 1 }

    var inter = certificate_zero()
    let (ir, ie) = x509_parse_certificate(&inter_buf, inter_len)
    inter = ir
    if ie != X509_OK { print_int(2); return 1 }

    // The leaf's own key is P-256 and IS recognized...
    if leaf.public_key_algorithm != PUBKEY_ALG_EC_P256 { print_int(3); return 1 }
    assert(leaf.public_key_algorithm == PUBKEY_ALG_EC_P256)

    // ...and the issuing intermediate's P-384 key IS now recognized as
    // such. `x509_parse_certificate` parses the 97-byte uncompressed
    // point against the secp384r1 OID and classifies it
    // `PUBKEY_ALG_EC_P384` (stdlib/x509/cert.sio, Task 4 of the P-384
    // plan) -- it no longer falls through to UNKNOWN for this curve.
    if inter.public_key_algorithm != PUBKEY_ALG_EC_P384 { print_int(4); return 1 }
    assert(inter.public_key_algorithm == PUBKEY_ALG_EC_P384)

    // The load-bearing assertion: a genuine, correctly-signed
    // ecdsa-with-SHA384 signature whose issuer key is P-384 must now
    // VERIFY, dispatched through real P-384 curve arithmetic
    // (`ecdsa_p384_verify_sha384`), not rejected and not run through
    // P-256 arithmetic.
    let ok = x509_verify_signature(&leaf_buf, &leaf, &inter)
    if ok == false { print_int(5); return 1 }
    assert(ok == true)

    println("x509_chain_ecdsa_p384_cloudflare_accepted: P-384 issuer key correctly verified (real Cloudflare 1.1.1.1 chain)")
    return 0
}
