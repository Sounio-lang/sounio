//@ run-pass
//@ requires: madaros
//@ expect-stdout: zero 1
//@ expect-stdout: neg 1
//@ expect-stdout: kept 11.243518 13.789148
//@ expect-stdout: POSITIVE_PRESSURE_OK
// P° = 0 published the point 0–0 with chi 0. P° = -100 published a
// missing band and a chi of 0, which reads as a perfect fit. A standard
// pressure that is not positive is not a fit. P° = 100 keeps the band.

use epistemic::regression::plateau_pressure

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn blank(lo: f64, hi: f64, chi: f64, open: bool, refused: bool) -> bool {
    if open || refused { return false }
    if lo == lo || hi == hi || chi == chi { return false }
    true
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 400.0
    xs[1] = 1.0 / 450.0
    xs[2] = 1.0 / 500.0
    xs[3] = 1.0 / 550.0
    ys[0] = 0.0 - 1000.0 / 400.0
    ys[1] = 0.0 - 1000.0 / 450.0
    ys[2] = 0.0 - 1000.0 / 500.0
    ys[3] = 0.0 - 1000.0 / 550.0
    uln[0] = 0.2
    uln[1] = 0.2
    uln[2] = 0.2
    uln[3] = 0.2
    let zero = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 0.0)
    let neg = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 0.0 - 100.0)
    let kept = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    let zero_ok = blank(zero.lo, zero.hi, zero.chi, zero.open, zero.refused)
    let neg_ok = blank(neg.lo, neg.hi, neg.chi, neg.open, neg.refused)
    let kept_ok = kept.open && !kept.refused && near(kept.lo, 11.243518, 0.000001) && near(kept.hi, 13.789148, 0.000001)
    print("zero ")
    print_int(bit(zero_ok))
    println("")
    print("neg ")
    print_int(bit(neg_ok))
    println("")
    print("kept ")
    print_f64(kept.lo)
    print(" ")
    print_f64(kept.hi)
    println("")
    if zero_ok && neg_ok && kept_ok {
        println("POSITIVE_PRESSURE_OK")
        return 0
    }
    println("POSITIVE_PRESSURE_FAIL")
    1
}
