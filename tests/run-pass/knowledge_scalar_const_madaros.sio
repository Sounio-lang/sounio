//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: MULR 6.000000 0.160000 1.000000
//@ expect-stdout-contains: MULL 6.000000 0.160000 1.000000
//@ expect-stdout-contains: ADDR 5.000000 0.040000 1.000000
//@ expect-stdout-contains: SUBR 1.000000 0.040000 1.000000
//@ expect-stdout-contains: SUBL -1.000000 0.040000 1.000000
//@ expect-stdout-contains: DIVR 1.500000 0.010000 1.000000
//@ expect-stdout-contains: DIVL 2.000000 0.017778 1.000000
//@ expect-stdout-contains: NEG -6.000000 0.160000 1.000000
//@ expect-stdout-contains: GLOBAL 6.000000 0.160000 1.000000
//@ expect-stdout-contains: CONF 10.000000 0.000000 0.700000
//@ expect-stdout-contains: CHAIN 7.000000 0.160000 1.000000
//
// Knowledge<f64> (op) exact constant on Madaros (was E004 for every mixed
// form). A compile-time constant -- a float literal, its negation, or a
// module-level `let`/`const` not shadowed by a local -- is exact: variance 0,
// confidence 1, no noise source. It goes through the same first-order GUM
// arm as Knowledge (x) Knowledge. Predicted before compiling, x = 3 +- 0.2
// (variance 0.04):
//   x*c, c*x : c^2 * 0.04        x+c, x-c, c-x : 0.04
//   x/c      : 0.04 / c^2        c/x           : c^2 * 0.04 / x^4 = 36*0.04/81
//   CONF     : confidence is min(0.7, 1) = 0.7, untouched by an exact factor
//   CHAIN    : (x*2.0) + 1.0 keeps 0.16
// A runtime f64 is NOT promoted (spec ch. 04: a Value does not establish an
// exact real value); see compile-fail/knowledge_scalar_runtime_f64.sio.

let SCALE: f64 = 2.0

fn show(tag: string, k: Knowledge<f64>) with IO, Epistemic {
    print(tag); print(" ")
    print_f64(k.value); print(" ")
    print_f64(k.variance); print(" ")
    print_f64(k.confidence); print("\n")
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let x: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    show("MULR", x * 2.0)
    show("MULL", 2.0 * x)
    show("ADDR", x + 2.0)
    show("SUBR", x - 2.0)
    show("SUBL", 2.0 - x)
    show("DIVR", x / 2.0)
    show("DIVL", 6.0 / x)
    show("NEG", x * -2.0)
    show("GLOBAL", x * SCALE)
    let c: Knowledge<f64> = Knowledge(5.0, ε=0.7, prov="ref")
    show("CONF", c * 2.0)
    show("CHAIN", x * 2.0 + 1.0)
    0
}
