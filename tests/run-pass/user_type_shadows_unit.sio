//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: SHADOW_OK 2 1
//
// A user-declared type shadows a unit of measure of the same spelling.
// `K` is also the SI symbol for kelvin, and the checker's unit branch used to
// fire first, so `var k: K = K::A` expected f64 (E001 on main 8178ea5070).
// The global is declared before the enum on purpose: the rule must not depend
// on declaration order.
var GK: [K; 4] = [K::A; 4]

enum K { A, B, C }

fn code(k: K) -> i64 {
    match k { K::A => 0, K::B => 1, K::C => 2 }
}

fn main() -> i64 with IO, Mut {
    var k: K = K::A
    k = K::B
    GK[2] = K::C
    print("SHADOW_OK "); print_int(code(GK[2])); print(" "); print_int(code(k)); print("\n")
    0
}
