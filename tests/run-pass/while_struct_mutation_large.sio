//@ run-pass
// Test with larger struct (similar to PBPK compartment models)
// PBPK models have 10+ compartments, this tests scalability

struct Compartment {
    plasma: f64,
    liver: f64,
    kidney: f64,
    muscle: f64,
    fat: f64,
    brain: f64
}

fn main() -> i32 with IO, Div, Mut {
    var comp = Compartment {
        plasma: 100.0,
        liver: 0.0,
        kidney: 0.0,
        muscle: 0.0,
        fat: 0.0,
        brain: 0.0
    }

    var step = 0
    let k_distribution = 0.1

    // Simulate drug distribution for 20 time steps
    while step < 20 {
        // Simple distribution model: plasma -> organs
        let dose_to_organs = comp.plasma * k_distribution

        comp = Compartment {
            plasma: comp.plasma - dose_to_organs,
            liver: comp.liver + dose_to_organs * 0.3,
            kidney: comp.kidney + dose_to_organs * 0.2,
            muscle: comp.muscle + dose_to_organs * 0.25,
            fat: comp.fat + dose_to_organs * 0.15,
            brain: comp.brain + dose_to_organs * 0.1
        }

        step = step + 1
    }

    return 0
}
