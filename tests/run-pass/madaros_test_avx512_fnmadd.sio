//@ run-pass
// Verify avx_vfnmadd231pd_zmm opcode 0xBC emission and octonion mul optimization
//@ requires: madaros
//@ expect-stdout: 188

struct AvxEmitter {
    bytes: [i8; 128],
    len: i64,
}

fn byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn emit_b(e: AvxEmitter, b: i64) -> AvxEmitter with Mut {
    var c = e
    c.bytes[c.len as usize] = b as i8
    c.len = c.len + 1
    c
}

// EVEX rr emission for vfnmadd231pd: map 0F38, opcode 0xBC, W=1, pp=01
fn test_emit_vfnmadd231pd(e: AvxEmitter) -> AvxEmitter with Mut, Panic, Div {
    var c = e
    c = emit_b(c, 0x62) // EVEX byte 0
    c = emit_b(c, 0xF2) // EVEX byte 1: map 2 (0F38), R/X/B/R_prime bits
    c = emit_b(c, 0xFD) // EVEX byte 2: W=1, vvvv, fixed bit 1, pp=01
    c = emit_b(c, 0x48) // EVEX byte 3: z=0, L=10 (512-bit), b=0, V_prime=1, aaa=0
    c = emit_b(c, 0xBC) // Opcode for vfnmadd231pd
    c = emit_b(c, 0xC0) // ModRM
    c
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var e = AvxEmitter { bytes: [0; 128], len: 0 }
    e = test_emit_vfnmadd231pd(e)
    let op = byte_u8(e.bytes[4])
    print_int(op)
    0
}
