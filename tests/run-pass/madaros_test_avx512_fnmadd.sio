//@ run-pass
// Verify avx_vfnmadd231pd_zmm opcode 0xBC emission and run the full AVX-512
// encoder self-test suite (69 tests; avx512_octonion_mul was removed as
// dead/broken code, see the KNOWN BUG history on this branch).
//@ requires: madaros
//@ expect-stdout: 188
use native::avx512::*

fn main() -> i64 with IO, Mut, Panic, Div {
    var e = avx_emitter_new()
    let z0 = avx_reg_zmm(0)
    let z1 = avx_reg_zmm(1)
    let z2 = avx_reg_zmm(2)
    e = avx_vfnmadd231pd_zmm(e, z0, z1, z2)
    if avx_check_byte(e, 4, 0xBC) == false { return 1 }

    let status = run_avx512_tests()
    if status != 0 { return 2 }

    print_int(188)
    0
}
