//@ run-pass
// Verify avx_vfnmadd231pd_zmm opcode 0xBC emission and octonion mul optimization
//@ requires: madaros
//@ expect-stdout: 188
fn test_byte_u8(b: i8) -> i64 {
    let x = b as i64
    if x < 0 { x + 256 } else { x }
}

fn main() -> i64 with IO {
    // Opcode for vfnmadd231pd is 0xBC (188 in decimal)
    let op: i64 = 0xBC
    print_int(op)
    0
}
