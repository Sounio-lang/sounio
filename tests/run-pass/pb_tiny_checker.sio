//@ run-pass
//@ description: Tiny pseudo-Boolean proof-checker smoke

fn pb_bool_valid(x: i64) -> i64 {
    if x == 0 { return 1 }
    if x == 1 { return 1 }
    if x == (0 - 1) { return 1 }
    return 0
}

fn pb_min_term(w: i64, x: i64) -> i64 {
    if x == 1 { return w }
    return 0
}

fn pb_max_term(w: i64, x: i64) -> i64 {
    if x == 0 { return 0 }
    return w
}

fn pb_min_sum3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64) -> i64 {
    return pb_min_term(w0, x0) + pb_min_term(w1, x1) + pb_min_term(w2, x2)
}

fn pb_max_sum3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64) -> i64 {
    return pb_max_term(w0, x0) + pb_max_term(w1, x1) + pb_max_term(w2, x2)
}

fn pb_check_le_contradiction3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64, rhs: i64) -> i64 {
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if pb_bool_valid(x0) == 0 { return 0 }
    if pb_bool_valid(x1) == 0 { return 0 }
    if pb_bool_valid(x2) == 0 { return 0 }
    if pb_min_sum3(w0, x0, w1, x1, w2, x2) > rhs { return 1 }
    return 0
}

fn pb_check_ge_contradiction3(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64, rhs: i64) -> i64 {
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if pb_bool_valid(x0) == 0 { return 0 }
    if pb_bool_valid(x1) == 0 { return 0 }
    if pb_bool_valid(x2) == 0 { return 0 }
    if pb_max_sum3(w0, x0, w1, x1, w2, x2) < rhs { return 1 }
    return 0
}

fn pb_check_exactly_one_false_conflict3(x0: i64, x1: i64, x2: i64) -> i64 {
    return pb_check_ge_contradiction3(1, x0, 1, x1, 1, x2, 1)
}

fn pb_check_at_most_one_true_conflict3(x0: i64, x1: i64, x2: i64) -> i64 {
    return pb_check_le_contradiction3(1, x0, 1, x1, 1, x2, 1)
}

fn pb_saturate_coeff(w: i64, rhs: i64) -> i64 {
    if w < 0 { return 0 - 1 }
    if rhs < 0 { return 0 - 1 }
    if w > rhs { return rhs }
    return w
}

fn pb_check_saturation3(w0: i64, w1: i64, w2: i64, rhs: i64,
                        s0: i64, s1: i64, s2: i64) -> i64 {
    if rhs < 0 { return 0 }
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if s0 != pb_saturate_coeff(w0, rhs) { return 0 }
    if s1 != pb_saturate_coeff(w1, rhs) { return 0 }
    if s2 != pb_saturate_coeff(w2, rhs) { return 0 }
    return 1
}

fn pb_floor_div_nonneg(n: i64, divisor: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if divisor <= 0 { return 0 - 1 }
    return n / divisor
}

fn pb_ceil_div_nonneg(n: i64, divisor: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if divisor <= 0 { return 0 - 1 }
    return (n + divisor - 1) / divisor
}

fn pb_check_divide_le3(w0: i64, w1: i64, w2: i64, rhs: i64, divisor: i64,
                       q0: i64, q1: i64, q2: i64, qrhs: i64) -> i64 with Div {
    if divisor <= 0 { return 0 }
    if rhs < 0 { return 0 }
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if q0 != pb_floor_div_nonneg(w0, divisor) { return 0 }
    if q1 != pb_floor_div_nonneg(w1, divisor) { return 0 }
    if q2 != pb_floor_div_nonneg(w2, divisor) { return 0 }
    if qrhs != pb_floor_div_nonneg(rhs, divisor) { return 0 }
    return 1
}

fn pb_check_divide_ge3(w0: i64, w1: i64, w2: i64, rhs: i64, divisor: i64,
                       q0: i64, q1: i64, q2: i64, qrhs: i64) -> i64 with Div {
    if divisor <= 0 { return 0 }
    if rhs < 0 { return 0 }
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if q0 != pb_ceil_div_nonneg(w0, divisor) { return 0 }
    if q1 != pb_ceil_div_nonneg(w1, divisor) { return 0 }
    if q2 != pb_ceil_div_nonneg(w2, divisor) { return 0 }
    if qrhs != pb_ceil_div_nonneg(rhs, divisor) { return 0 }
    return 1
}

fn main() -> i64 with Div {
    if pb_min_sum3(2, 1, 3, 0 - 1, 5, 0) != 2 { return 1 }
    if pb_max_sum3(2, 1, 3, 0 - 1, 5, 0) != 5 { return 2 }

    // 2*x0 + 3*x1 + 5*x2 <= 4 is impossible once x0=x1=true.
    if pb_check_le_contradiction3(2, 1, 3, 1, 5, 0 - 1, 4) != 1 { return 3 }
    if pb_check_le_contradiction3(2, 1, 3, 0 - 1, 5, 0, 4) != 0 { return 4 }

    // 2*x0 + 3*x1 + 5*x2 >= 6 is impossible once x0=x1=x2=false.
    if pb_check_ge_contradiction3(2, 0, 3, 0, 5, 0, 6) != 1 { return 5 }
    if pb_check_ge_contradiction3(2, 0 - 1, 3, 0, 5, 0, 2) != 0 { return 6 }

    // Exactly-one contradiction: all three false violates sum >= 1.
    if pb_check_exactly_one_false_conflict3(0, 0, 0) != 1 { return 7 }
    if pb_check_exactly_one_false_conflict3(0, 0 - 1, 0) != 0 { return 8 }

    // At-most-one contradiction: two true literals force sum > 1.
    if pb_check_at_most_one_true_conflict3(1, 1, 0) != 1 { return 9 }
    if pb_check_at_most_one_true_conflict3(1, 0 - 1, 0) != 0 { return 10 }

    // Bad assignments and negative weights are rejected rather than certified.
    if pb_check_le_contradiction3(1, 2, 1, 1, 1, 1, 1) != 0 { return 11 }
    if pb_check_le_contradiction3(0 - 1, 1, 1, 1, 1, 1, 1) != 0 { return 12 }

    // Saturation proof step: 5*x0 + 2*x1 + 7*x2 <= 3 saturates to
    // 3*x0 + 2*x1 + 3*x2 <= 3 for Boolean variables.
    if pb_saturate_coeff(5, 3) != 3 { return 13 }
    if pb_saturate_coeff(2, 3) != 2 { return 14 }
    if pb_check_saturation3(5, 2, 7, 3, 3, 2, 3) != 1 { return 15 }
    if pb_check_saturation3(5, 2, 7, 3, 5, 2, 3) != 0 { return 16 }
    if pb_check_saturation3(5, 2, 7, 0 - 1, 0, 0, 0) != 0 { return 17 }

    // Use the saturated inequality as a checked arithmetic certificate.
    // Under x0=x1=true, even the saturated minimum is 5 > 3.
    if pb_check_le_contradiction3(3, 1, 2, 1, 3, 0 - 1, 3) != 1 { return 18 }

    // Division proof steps. A <= row divides with floor rounding:
    // 5*x0 + 2*x1 + 7*x2 <= 8  ==>  2*x0 + 1*x1 + 3*x2 <= 4.
    if pb_floor_div_nonneg(7, 2) != 3 { return 19 }
    if pb_check_divide_le3(5, 2, 7, 8, 2, 2, 1, 3, 4) != 1 { return 20 }
    if pb_check_divide_le3(5, 2, 7, 8, 2, 3, 1, 3, 4) != 0 { return 21 }

    // A >= row divides with ceil rounding:
    // 5*x0 + 2*x1 + 7*x2 >= 9  ==>  3*x0 + 1*x1 + 4*x2 >= 5.
    if pb_ceil_div_nonneg(7, 2) != 4 { return 22 }
    if pb_check_divide_ge3(5, 2, 7, 9, 2, 3, 1, 4, 5) != 1 { return 23 }
    if pb_check_divide_ge3(5, 2, 7, 9, 2, 2, 1, 4, 5) != 0 { return 24 }
    if pb_check_divide_ge3(5, 2, 7, 9, 0, 3, 1, 4, 5) != 0 { return 25 }
    if pb_check_divide_le3(0 - 1, 2, 7, 8, 2, 0, 1, 3, 4) != 0 { return 26 }

    return 0
}
