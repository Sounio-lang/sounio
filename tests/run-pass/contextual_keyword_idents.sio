//@ run-pass
//@ expect-stdout: CONTEXTUAL_KEYWORD_IDENTS_OK
// Regression (#1454, #1194): item-introducer keywords must still be usable as
// ordinary identifiers in expression and pattern position.
//
// `expect_ident` already tolerated keywords, so a parameter DECLARATION like
// `fn f(policy: P)` parsed. Every later USE failed, because the expression
// parser and the pattern parser each carried their own ad-hoc allow-list of
// "keywords usable as identifiers" and neither included this family.
//
// Three positions are exercised for each name: binding (`let policy = ...`),
// bare expression use, and field access on a parameter.

struct Cfg {
    x: i64,
}

fn take_policy(policy: Cfg) -> i64 {
    // expression position: field access on a keyword-named parameter
    policy.x
}

// `policy` is the one member of the family that also appears in
// `at_item_start` (parser.sio), so pin that a bare use as the FIRST statement
// of a block is still parsed as an expression, not as an attempted item.
fn echo_policy(policy: i64) -> i64 {
    policy
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // binding position (pattern parser)
    let policy = 1
    let acquisition_policy = 2
    let recourse_policy = 3
    let transition_policy = 4
    let transition_protocol = 5
    let monitoring_policy = 6
    let alternative_policy = 7
    let alternative_frontier = 8
    let decision_policy = 9
    let deferral_policy = 10
    let models = 11
    let validation = 12

    // `contest` and `audit` are intentionally absent: `contest` has a real
    // expression form (`contest { ... }`) and `audit` is an infix operator
    // (`expr audit name`). Both stay hard keywords — see tk_is_contextual_ident.

    // bare expression position
    let part1 = policy + acquisition_policy + recourse_policy + transition_policy
    let part2 = transition_protocol + monitoring_policy + alternative_policy
    let part3 = alternative_frontier + decision_policy + deferral_policy
    let part4 = models + validation
    let total = part1 + part2 + part3 + part4
    if total != 78 {
        println("FAIL: contextual keyword expression use")
        return 1
    }

    if echo_policy(policy) != 1 {
        println("FAIL: policy as first statement of a block")
        return 3
    }

    let cfg = Cfg { x: 42 }
    if take_policy(cfg) != 42 {
        println("FAIL: keyword-named parameter field access")
        return 2
    }

    println("CONTEXTUAL_KEYWORD_IDENTS_OK")
    return 0
}
