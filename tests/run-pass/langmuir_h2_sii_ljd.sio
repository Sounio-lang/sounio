fn main() -> i64 with IO, Epistemic, Mut, Div {
    var bad: i64 = 0
    bad = bad + case_spce_small()
    bad = bad + case_tip4pice_small()
    bad = bad + case_tip5p_small()
    bad = bad + case_spce_large()
    bad = bad + case_tip4pice_large()
    bad = bad + case_tip5p_large()
    if bad > 0 { return 1 }
    print("LANGMUIR_H2_SII_OK\n")
    0
}
