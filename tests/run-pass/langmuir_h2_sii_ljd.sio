//@ run-pass
//@ requires: madaros
//@ description: Langmuir constant of H2 in the two sII cages (5^12: R 3.91 A, z 20; 5^12 6^4: R 4.73 A, z 28) from the Lennard-Jones-Devonshire spherical cell, single-site LJ guest, O-site LJ of SPC/E, TIP4P/Ice and TIP5P, Lorentz-Berthelot, quadratic Feynman-Hibbs, 250 K, 8-point Gauss-Legendre over 100 panels. ln C, its four first derivatives over (eps_O, sigma_O, R, T) and four Hessian entries, through the loops of the quadrature and the nested helpers, 54 values. Expected values: tests/oracles/langmuir_h2_sii/expect.cpp (C++23 long-double second-order jets, written and run before this program; 1e-10 relative).
//@ expect-stdout: LANGMUIR_H2_SII_OK

fn invpow(y: f64, k: i64) -> f64 with Mut, Div {
    var r = 1.0
    var i: i64 = 0
    while i < k {
        r = r / y
        i = i + 1
    }
    r
}

fn dk(x: f64, k: i64) -> f64 with Mut, Div {
    invpow(1.0 - x, k) - invpow(1.0 + x, k)
}

fn integrand(u: f64, eps: f64, a: f64, b: f64, rc: f64, t: f64, z: f64) -> f64 with Mut, Div {
    let r = rc * u
    let w0 = 2.0 * z * eps * (a * dk(u, 10) / (10.0 * r) - b * dk(u, 4) / (4.0 * r))
    let lap = 2.0 * z * eps / r * (a * 11.0 / (rc * rc) * dk(u, 12) - b * 5.0 / (rc * rc) * dk(u, 6))
    let w = w0 + 1.00263768431755956 / t * lap
    u * u * exp(0.0 - w / t)
}

fn ln_langmuir(eps_o: f64, sig_o: f64, rc: f64, t: f64, z: f64) -> f64 with Mut, Div {
    let eps = sqrt(34.2 * eps_o)
    let sig = 0.5 * (2.96 + sig_o)
    let s2 = sig * sig
    let s6 = s2 * s2 * s2
    let a = s6 * s6 * invpow(rc, 11)
    let b = s6 * invpow(rc, 5)
    let h = 0.97 / 100.0
    var acc = 0.0
    var p: i64 = 0
    while p < 100 {
        let c = (p as f64) * h + 0.5 * h
        let hh = 0.5 * h
        acc = acc + hh * 0.36268378337836198 * (integrand(c - hh * 0.18343464249564980, eps, a, b, rc, t, z) + integrand(c + hh * 0.18343464249564980, eps, a, b, rc, t, z))
        acc = acc + hh * 0.31370664587788729 * (integrand(c - hh * 0.52553240991632899, eps, a, b, rc, t, z) + integrand(c + hh * 0.52553240991632899, eps, a, b, rc, t, z))
        acc = acc + hh * 0.22238103445337447 * (integrand(c - hh * 0.79666647741362674, eps, a, b, rc, t, z) + integrand(c + hh * 0.79666647741362674, eps, a, b, rc, t, z))
        acc = acc + hh * 0.10122853629037626 * (integrand(c - hh * 0.96028985649753623, eps, a, b, rc, t, z) + integrand(c + hh * 0.96028985649753623, eps, a, b, rc, t, z))
        p = p + 1
    }
    log(0.910178518534339499 * rc * rc * rc / t * acc)
}

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-14 + 1.0e-10 * w
}

fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn case_spce_small() -> i64 with IO, Epistemic, Mut, Div {
    var bad: i64 = 0
    let ke = measure(78.20, uncertainty: 1.0)
    let ks = measure(3.166, uncertainty: 0.01)
    let kr = measure(3.91, uncertainty: 0.01)
    let kt = measure(250.0, uncertainty: 1.0)
    let e = ke.value
    let s = ks.value
    let r = kr.value
    let t = kt.value
    bad = bad + report("spce_small lnC", ln_langmuir(e, s, r, t, 20.0), -3.92316155982970874e+00)
    bad = bad + report("spce_small d/deps", sensitivity_of(ln_langmuir(e, s, r, t, 20.0), 0), 1.49476211971354180e-02)
    bad = bad + report("spce_small d/dsig", sensitivity_of(ln_langmuir(e, s, r, t, 20.0), 1), -1.71423321159449926e-01)
    bad = bad + report("spce_small d/dR", sensitivity_of(ln_langmuir(e, s, r, t, 20.0), 2), 1.07305243914585407e+00)
    bad = bad + report("spce_small d/dT", sensitivity_of(ln_langmuir(e, s, r, t, 20.0), 3), -1.30602402776529192e-02)
    bad = bad + report("spce_small h_eps_eps", hessian_of(ln_langmuir(e, s, r, t, 20.0), 0, 0), -7.37977352728543796e-05)
    bad = bad + report("spce_small h_R_R", hessian_of(ln_langmuir(e, s, r, t, 20.0), 2, 2), -2.60675885938606902e+00)
    bad = bad + report("spce_small h_eps_R", hessian_of(ln_langmuir(e, s, r, t, 20.0), 0, 2), -1.28904735103659071e-02)
    bad = bad + report("spce_small h_T_T", hessian_of(ln_langmuir(e, s, r, t, 20.0), 3, 3), 9.64411757882155118e-05)
    bad
}

