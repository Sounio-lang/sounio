//@ run-pass
//@ requires: madaros

// D19 regression pin -- decode_certificate_message -> x509_parse_certificate
// must return tbs_start/tbs_len pointing at the real TBSCertificate TLV when
// the leaf is a P-256 / ecdsa-with-SHA256 certificate with an EMPTY Subject
// and an iPAddress SAN, decoded from a real RFC 8446 Certificate message.
//
// WHY THIS TEST EXISTS. D18 (docs/audit/
// D18_CHAIN_CANDIDATE_SCALAR_FIELD_OFFSET_DISPATCH_2026-08-27.md, Part 3)
// reported that this exact call path returned tbs_start/tbs_len = 255/44
// against a true 4/295, and concluded a compiler defect in the imported-
// module native path blocked every real TLS handshake. D19 could not
// reproduce that on any surface -- offline here, and live against the very
// endpoint D18 measured, where the full handshake now returns CHAIN_OK. This
// test pins the offline half so the claim cannot silently drift again.
//
// PROVENANCE OF THE BYTES. The 385-byte DER below is the actual leaf served
// by the deployed SearXNG HTTPS front on 10.96.250.10:443, captured with
// `openssl s_client -showcerts` and converted with `openssl x509 -outform
// DER`. It is byte-identical to the certificate D18 measured: 385 bytes,
// byte-sum 30515. Reference values are from `openssl asn1parse -inform DER`:
//
//     0:d=0  hl=4 l= 381 cons: SEQUENCE
//     4:d=1  hl=4 l= 291 cons: SEQUENCE     <- TBSCertificate
//
// so the TBS TLV starts at offset 4 and is 4 + 291 = 295 bytes long.
//
// The certificate is wrapped here in a real RFC 8446 SS4.4.2 Certificate
// handshake message, reconciling exactly:
//     4 handshake header + 1 context length + 3 certificate_list length
//   + 3 CertificateEntry length + 385 cert_data + 2 extensions = 398.
//
// Only structural fields are asserted -- never the validity window -- so
// this test does not expire when the certificate does.

use asn1::der::*
use bignum::bigint::*
use net::socket::*
use x509::cert::*
use x509::oid::*
use tls::handshake::*

fn main() -> i64 with IO, Mut {
    let msg_len: i64 = 398
    let msg = rawbuf_new(msg_len + 8)
    let mb: [i64; 398] = [
        0x0B, 0x00, 0x01, 0x8A, 0x00, 0x00, 0x01, 0x86, 0x00, 0x01, 0x81, 0x30, 0x82, 0x01, 0x7D,
        0x30, 0x82, 0x01, 0x23, 0xA0, 0x03, 0x02, 0x01, 0x02, 0x02, 0x14, 0x23, 0x39, 0x71, 0x27,
        0x65, 0x4B, 0x23, 0x5C, 0xA6, 0xAF, 0x02, 0x5E, 0x51, 0x41, 0x43, 0x46, 0xBE, 0x84, 0xF5,
        0xBB, 0x30, 0x0A, 0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x30, 0x26,
        0x31, 0x24, 0x30, 0x22, 0x06, 0x03, 0x55, 0x04, 0x03, 0x13, 0x1B, 0x63, 0x6F, 0x6E, 0x63,
        0x6C, 0x61, 0x76, 0x65, 0x2D, 0x73, 0x65, 0x61, 0x72, 0x63, 0x68, 0x2D, 0x69, 0x6E, 0x74,
        0x65, 0x72, 0x6E, 0x61, 0x6C, 0x2D, 0x63, 0x61, 0x30, 0x1E, 0x17, 0x0D, 0x32, 0x36, 0x30,
        0x38, 0x32, 0x37, 0x30, 0x31, 0x30, 0x39, 0x33, 0x33, 0x5A, 0x17, 0x0D, 0x32, 0x36, 0x31,
        0x31, 0x32, 0x35, 0x30, 0x31, 0x30, 0x39, 0x33, 0x33, 0x5A, 0x30, 0x00, 0x30, 0x59, 0x30,
        0x13, 0x06, 0x07, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01, 0x06, 0x08, 0x2A, 0x86, 0x48,
        0xCE, 0x3D, 0x03, 0x01, 0x07, 0x03, 0x42, 0x00, 0x04, 0x06, 0x3A, 0x80, 0x5E, 0xF5, 0x76,
        0xA3, 0xB7, 0x27, 0x63, 0x27, 0x29, 0x98, 0x54, 0xB5, 0x78, 0xF7, 0xA6, 0x3F, 0xBA, 0x2F,
        0x33, 0x40, 0x44, 0x40, 0x14, 0x1D, 0x29, 0xA7, 0x17, 0xC2, 0x4C, 0xB0, 0x31, 0x92, 0x98,
        0x22, 0x79, 0xE9, 0x1E, 0x9E, 0x10, 0x83, 0x06, 0x7F, 0x44, 0xFD, 0xB8, 0x2D, 0x36, 0xB4,
        0x66, 0xDB, 0x9B, 0x61, 0x1A, 0xC9, 0xB4, 0x01, 0x34, 0xBC, 0xD5, 0x37, 0x4C, 0xA3, 0x55,
        0x30, 0x53, 0x30, 0x0E, 0x06, 0x03, 0x55, 0x1D, 0x0F, 0x01, 0x01, 0xFF, 0x04, 0x04, 0x03,
        0x02, 0x05, 0xA0, 0x30, 0x0C, 0x06, 0x03, 0x55, 0x1D, 0x13, 0x01, 0x01, 0xFF, 0x04, 0x02,
        0x30, 0x00, 0x30, 0x1F, 0x06, 0x03, 0x55, 0x1D, 0x23, 0x04, 0x18, 0x30, 0x16, 0x80, 0x14,
        0xD2, 0x52, 0x25, 0x80, 0x06, 0xB9, 0x43, 0x96, 0x04, 0x33, 0x8F, 0xB7, 0x6D, 0x7B, 0x65,
        0x7C, 0x08, 0x7C, 0xE7, 0xBA, 0x30, 0x12, 0x06, 0x03, 0x55, 0x1D, 0x11, 0x01, 0x01, 0xFF,
        0x04, 0x08, 0x30, 0x06, 0x87, 0x04, 0x0A, 0x60, 0xFA, 0x0A, 0x30, 0x0A, 0x06, 0x08, 0x2A,
        0x86, 0x48, 0xCE, 0x3D, 0x04, 0x03, 0x02, 0x03, 0x48, 0x00, 0x30, 0x45, 0x02, 0x20, 0x68,
        0x9D, 0xFE, 0xD2, 0x32, 0xEC, 0xE4, 0x87, 0xDD, 0x58, 0x2D, 0xDA, 0x02, 0xD7, 0x5C, 0x4E,
        0xEC, 0x0F, 0x48, 0x62, 0x2B, 0x81, 0xAA, 0x56, 0xDE, 0x18, 0x3E, 0x1B, 0xFB, 0xB5, 0xEF,
        0x33, 0x02, 0x21, 0x00, 0xBE, 0xAC, 0xCF, 0x69, 0x59, 0x5C, 0x12, 0x0A, 0xD5, 0x2F, 0x87,
        0x4D, 0xDE, 0xCC, 0x21, 0xAA, 0xD0, 0x86, 0xD8, 0x1D, 0x92, 0x58, 0x2B, 0xD9, 0x6B, 0x25,
        0x7F, 0x11, 0x38, 0x98, 0xE7, 0x05, 0x00, 0x00
    ]
    var i: i64 = 0
    while i < msg_len {
        rawbuf_set(&msg, i, mb[i as usize])
        i = i + 1
    }

    // The DER payload starts 11 bytes into the handshake message
    // (4 + 1 + 3 + 3), per the arithmetic in this file's header.
    let der_off: i64 = 11
    let der_len: i64 = 385
    let dbuf = rawbuf_new(der_len + 8)
    var j: i64 = 0
    var checksum: i64 = 0
    while j < der_len {
        let b = mb[(der_off + j) as usize]
        rawbuf_set(&dbuf, j, b)
        checksum = checksum + b
        j = j + 1
    }

    // Guard the fixture itself before trusting anything measured from it.
    if checksum != 30515 {
        print_int(1)
        return 1
    }
    assert(checksum == 30515)

    // --- Control: parse the DER directly. ---
    var direct = certificate_zero()
    let (direct_raw, dstatus) = x509_parse_certificate(&dbuf, der_len)
    direct = direct_raw
    if dstatus != X509_OK {
        print_int(2)
        return 1
    }
    assert(dstatus == X509_OK)
    if direct.tbs_start != 4 {
        print_int(3)
        return 1
    }
    assert(direct.tbs_start == 4)
    if direct.tbs_len != 295 {
        print_int(4)
        return 1
    }
    assert(direct.tbs_len == 295)

    // The byte at tbs_start must be the TBSCertificate SEQUENCE tag, read
    // back independently from the buffer rather than from the struct.
    if (rawbuf_get(&dbuf, direct.tbs_start) & 255) != 0x30 {
        print_int(5)
        return 1
    }
    assert((rawbuf_get(&dbuf, direct.tbs_start) & 255) == 0x30)

    // --- The path D18 Part 3 reported as corrupting. ---
    var leaf = certificate_zero()
    let (leaf_raw, leaf_buf, ints, int_bufs, icount, ok) =
        decode_certificate_message(&msg, msg_len)
    leaf = leaf_raw
    if !ok {
        print_int(6)
        return 1
    }
    assert(ok)
    if icount != 0 {
        print_int(7)
        return 1
    }
    assert(icount == 0)
    // 255/44 is D18 Part 3's reported failure signature; 4/295 is the truth.
    if leaf.tbs_start != 4 {
        print_int(8)
        return 1
    }
    assert(leaf.tbs_start == 4)
    if leaf.tbs_len != 295 {
        print_int(9)
        return 1
    }
    assert(leaf.tbs_len == 295)

    // A later scalar member of the same struct, to show the whole value
    // survives the decode and not merely its first fields.
    if leaf.public_key_algorithm != PUBKEY_ALG_EC_P256 {
        print_int(10)
        return 1
    }
    assert(leaf.public_key_algorithm == PUBKEY_ALG_EC_P256)

    println("tls_decode_certificate_message_p256_leaf: tbs_start=4 tbs_len=295 through decode_certificate_message")
    0
}
