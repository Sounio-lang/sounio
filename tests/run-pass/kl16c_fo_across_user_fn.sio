//@ run-pass
//@ expect-stdout: KL16C_FO_ACROSS_USER_FN_PASS
// KL-16c: inter-procedural FO ch0 + H[0,0] across user f64→f64 fns on lean_single.
// No Madaros sabotage tag — this pins the seed path, not lower.sio.

fn id(x: f64) -> f64 { x }
fn sq(x: f64) -> f64 { x * x }

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Epistemic, Mut, Div {
    let xm: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let x = xm.value

    // measure → .value → call: sensitivity_of(id(x), 0) = 1.0
    let s_id = sensitivity_of(id(x), 0)
    // at x=2: sensitivity_of(sq(x), 0) = 4.0
    let s_sq = sensitivity_of(sq(x), 0)
    // hessian_of(sq(x), 0, 0) = 2.0
    let h_sq = hessian_of(sq(x), 0, 0)

    println(s_id)
    println(s_sq)
    println(h_sq)

    let ok = abs_f(s_id - 1.0) < 1.0e-9
        && abs_f(s_sq - 4.0) < 1.0e-9
        && abs_f(h_sq - 2.0) < 1.0e-9
    if ok {
        print("KL16C_FO_ACROSS_USER_FN_PASS\n")
    } else {
        print("KL16C_FO_ACROSS_USER_FN_FAIL\n")
    }
}
