//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: KNIGHT_EXTREME_RANGES_PASS
//@ description: EPI-006 step 3b review 1: extreme binary64 ranges (underflow and overflow) remain ordered, non-NaN, and contain the exact rational range

fn main() -> i64 with IO, Epistemic {
    // 1. Underflow: x in [0, 1], y = (x * 1e-200) * 1e-200.
    // Exact rational upper endpoint (1e-200_f64)^2 is strictly positive (< 2^-1074).
    // Outward enclosure must be ordered, non-NaN, lo <= 0.0, and hi > 0.0 (never [0, 0]).
    let x = knight("tiny", 0.0, 1.0)
    let y = (x * 1.0e-200) * 1.0e-200
    let ylo = y.iv.0
    let yhi = y.iv.1
    if !(ylo == ylo) || !(yhi == yhi) || !(ylo <= yhi) { return 1 }
    if !(ylo <= 0.0) || !(yhi > 0.0) { return 2 }

    // 2. Overflow and scaling near DBL_MAX: b in [1e308, 1e308].
    // b + b has exact value 2e308 > DBL_MAX: lo must be <= DBL_MAX (finite or -inf),
    // hi must be +inf, ordered and non-NaN.
    let b = knight("big", 1.0e308, 1.0e308)
    let b2 = b + b
    let b2lo = b2.iv.0
    let b2hi = b2.iv.1
    if !(b2lo == b2lo) || !(b2hi == b2hi) || !(b2lo <= b2hi) { return 3 }
    let b2lo_le_max = (b2lo - b2lo == 0.0) || (b2lo < 0.0)
    let b2hi_pos_inf = (b2hi > 1.7e308) && (b2hi - b2hi != 0.0)
    if !b2lo_le_max || !b2hi_pos_inf { return 4 }

    // b * 0.5 has exact value 5.0e307 (finite): endpoints must be finite, ordered,
    // non-NaN, and enclose 5.0e307.
    let bh = b * 0.5
    let bhlo = bh.iv.0
    let bhhi = bh.iv.1
    if !(bhlo == bhlo) || !(bhhi == bhhi) || !(bhlo <= bhhi) { return 5 }
    if (bhlo - bhlo != 0.0) || (bhhi - bhhi != 0.0) { return 6 }
    if !(bhlo <= 5.0e307) || !(bhhi >= 5.0e307) { return 7 }

    println("KNIGHT_EXTREME_RANGES_PASS")
    0
}
