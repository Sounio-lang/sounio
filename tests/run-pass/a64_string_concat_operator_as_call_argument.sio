//@ run-pass
//@ description: string `++` as a call argument and in a let binding on aarch64 (the a64 additive loop never consumed token 74, so `f("a" ++ g())` was counted as three arguments (E006) and `let t = "a" ++ g()` silently kept only the left operand)
//@ expect-stdout: arg_len=4
//@ expect-stdout: let_len=4
//@ expect-stdout: chain_len=6
fn mk(s: string) -> i64 { str_len(s) }
fn tos(n: i64) -> string { "12" }

fn main() with IO {
    let a = mk("v_" ++ tos(7))
    print("arg_len=")
    print_int(a)
    print("\n")
    let t = "v_" ++ tos(7)
    print("let_len=")
    print_int(str_len(t))
    print("\n")
    let u = "ab" ++ "cd" ++ "ef"
    print("chain_len=")
    print_int(str_len(u))
    print("\n")
}
