//@ run-pass
//@ expect-stdout: 42
//@ description: FX-6 return clause: when the body completes with v, the handle value is the return clause applied to v (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-6

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> { 41 } with { return(x) -> x + 1 }
    println(r)
    0
}
