//@ run-pass
//@ requires: madaros
//@ description: V0-E.5.8 — print_f128: exact decimal (36 sig digits, round-half-even) and hex-float output of a language f128 from its limbs (no f64 anywhere)
//@ ladder-stage: V0-E.5.8
//@ semantic-lane: WS-G-V0E-STDLIB-GUM-SURFACE
//@ claim-clock: sounio_native_expected (ADR-008 / ADR-009)
//@ note: lean_single language f128 still greenwashes to f64 — not a claim path
//@ note: f128_from_limbs/to_lo/to_hi call sites are intercepted; bodies are placeholders
//@ expect-stdout-contains: dec_one=1.00000000000000000000000000000000000e+0000
//@ expect-stdout-contains: dec_third=3.33333333333333333333333333333333317e-0001
//@ expect-stdout-contains: dec_sq=1.00000000000000000001999999999999989e+0000
//@ expect-stdout-contains: dec_max=1.18973149535723176508575932662800702e+4932
//@ expect-stdout-contains: dec_sub=6.47517511943802511092443895822764655e-4966
//@ expect-stdout-contains: hex_sq=0x1.00000000000000005e7284324908p+0
//@ expect-stdout-contains: PASS f128_v0e58_print_f128
//
// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0e58
//
// `print_f128` / `println_f128` / `f128_to_string` render a language f128 as
// `[-]d.ddddddddddddddddddddddddddddddddddde[+-]dddd` — 36 significant digits,
// correctly rounded half-to-even, signed four-digit exponent; zeros as
// `0.0e+0000` / `-0.0e+0000`; `inf`, `-inf`, `nan`.
// `f128_to_hex_string` / `print_f128_hex` render the exact C99-style hex float
// `[-]0x1.<28 hex>p<±exp>` (subnormals `0x0.<28 hex>p-16382`, zeros `0x0p+0`).
// Both are stdlib Sounio (stdlib/math/softfloat_f128_fmt.sio) over the limbs
// from `f128_to_lo`/`f128_to_hi`: exact base-10^9 big-integer scaling by 2^e
// or 5^-e, then 37 digits + sticky → half-even. Host f64 is never touched, and
// the expected strings below were computed independently (exact rationals).
// Distinct non-zero exits:
// 11=one 12=neg_two 13=half 14=three 15=third 16=greenwash_sq 17=sq 18=max
// 19=min_normal 20=subnormal 21=inf 22=neg_inf 23=nan 24=zero 25=neg_zero
// 26=through_fn 27=struct_field 28=hex_one 29=hex_neg_two 30=hex_third
// 31=hex_sq 32=hex_max 33=hex_min_normal 34=hex_subnormal 35=hex_specials
// 36=hex_zeros 37=hex_through_fn_field 38=rollover_a 39=rollover_b

use math::softfloat_f128::{
    f128_from_limbs,
    f128_to_lo,
    f128_to_hi,
}
use math::softfloat_f128_fmt::{
    f128_to_string,
    f128_to_hex_string,
    print_f128,
    println_f128,
    print_f128_hex,
    println_f128_hex,
}

struct Cell { v: f128, tag: i64 }

fn twice(x: f128) -> f128 { x + x }
fn half_of(x: f128) -> f128 {
    let h: f128 = 0.5
    x * h
}

fn show(label: string, x: f128) with IO, Mut, Panic, Div {
    print("dec_")
    print(label)
    print("=")
    println_f128(x)
    print("hex_")
    print(label)
    print("=")
    println_f128_hex(x)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    println("v0e58_main_entered")
    let one: f128 = 1.0
    let two: f128 = 2.0
    let three: f128 = 3.0
    let half: f128 = 0.5
    let zero: f128 = 0.0
    let neg_two: f128 = -two
    let third: f128 = one / three
    let tiny: f128 = f128_from_limbs(3746994889972252672, 4592679628783035426)
    let one_plus_tiny: f128 = one + tiny
    let sq: f128 = one_plus_tiny * one_plus_tiny
    let max_finite: f128 = f128_from_limbs(-1, 9223090561878065151)
    let min_normal: f128 = f128_from_limbs(0, 281474976710656)
    let subnormal: f128 = f128_from_limbs(1, 0)
    let pos_inf: f128 = one / zero
    let neg_inf: f128 = neg_two / zero
    let nan: f128 = zero / zero
    let neg_zero: f128 = -zero
    let cell = Cell { v: half_of(third), tag: 6 }
    // Largest binary128 below 10^-4847 / 10^-2866: exact expansion 9.999…(>50
    // nines) so the 36-digit rounding carries all the way up to the next decade.
    let roll_a: f128 = f128_from_limbs(2635900317564430616, 79243946543460788)
    let roll_b: f128 = f128_from_limbs(-8653331365402388767, 1931559588162968882)

    show("one", one)
    show("neg_two", neg_two)
    show("half", half)
    show("three", three)
    show("third", third)
    show("sq", sq)
    show("max", max_finite)
    show("min_normal", min_normal)
    show("sub", subnormal)
    show("inf", pos_inf)
    show("neg_inf", neg_inf)
    show("nan", nan)
    show("zero", zero)
    show("neg_zero", neg_zero)
    show("twice_third", twice(third))
    show("field_sixth", cell.v)
    show("roll_a", roll_a)
    show("roll_b", roll_b)

    // ---- decimal ----
    if !str_eq(f128_to_string(one), "1.00000000000000000000000000000000000e+0000") {
        println("FAIL one")
        return 11
    }
    if !str_eq(f128_to_string(neg_two), "-2.00000000000000000000000000000000000e+0000") {
        println("FAIL neg_two")
        return 12
    }
    if !str_eq(f128_to_string(half), "5.00000000000000000000000000000000000e-0001") {
        println("FAIL half")
        return 13
    }
    if !str_eq(f128_to_string(three), "3.00000000000000000000000000000000000e+0000") {
        println("FAIL three")
        return 14
    }
    // 1/3 computed in-language: binary128 RNE quotient, then 36 digits of it.
    if !str_eq(f128_to_string(third), "3.33333333333333333333333333333333317e-0001") {
        println("FAIL third")
        return 15
    }
    // Anti-f64 control: (1+~1e-20)^2 must show the 2e-20 term in the decimal.
    if str_eq(f128_to_string(sq), "1.00000000000000000000000000000000000e+0000") {
        println("FAIL f64_greenwash_sq")
        return 16
    }
    if !str_eq(f128_to_string(sq), "1.00000000000000000001999999999999989e+0000") {
        println("FAIL sq")
        return 17
    }
    // Largest finite: 2^16384 − 2^16271 needs the full 2^e scaling path.
    if !str_eq(f128_to_string(max_finite), "1.18973149535723176508575932662800702e+4932") {
        println("FAIL max")
        return 18
    }
    if !str_eq(f128_to_string(min_normal), "3.36210314311209350626267781732175260e-4932") {
        println("FAIL min_normal")
        return 19
    }
    // Smallest subnormal 2^-16494: the largest 5^k scaling (11563 digits).
    if !str_eq(f128_to_string(subnormal), "6.47517511943802511092443895822764655e-4966") {
        println("FAIL subnormal")
        return 20
    }
    if !str_eq(f128_to_string(pos_inf), "inf") {
        println("FAIL inf")
        return 21
    }
    if !str_eq(f128_to_string(neg_inf), "-inf") {
        println("FAIL neg_inf")
        return 22
    }
    if !str_eq(f128_to_string(nan), "nan") {
        println("FAIL nan")
        return 23
    }
    if !str_eq(f128_to_string(zero), "0.0e+0000") {
        println("FAIL zero")
        return 24
    }
    if !str_eq(f128_to_string(neg_zero), "-0.0e+0000") {
        println("FAIL neg_zero")
        return 25
    }
    // Value returned from a user fn (V0-E.5.4 ABI) straight into the formatter.
    if !str_eq(f128_to_string(twice(third)), "6.66666666666666666666666666666666635e-0001") {
        println("FAIL through_fn")
        return 26
    }
    // Struct field (V0-E.5.5) straight into the formatter.
    if !str_eq(f128_to_string(cell.v), "1.66666666666666666666666666666666659e-0001") || cell.tag != 6 {
        println("FAIL struct_field")
        return 27
    }

    // ---- hex float ----
    if !str_eq(f128_to_hex_string(one), "0x1.0000000000000000000000000000p+0") {
        println("FAIL hex_one")
        return 28
    }
    if !str_eq(f128_to_hex_string(neg_two), "-0x1.0000000000000000000000000000p+1") {
        println("FAIL hex_neg_two")
        return 29
    }
    if !str_eq(f128_to_hex_string(third), "0x1.5555555555555555555555555555p-2") {
        println("FAIL hex_third")
        return 30
    }
    if !str_eq(f128_to_hex_string(sq), "0x1.00000000000000005e7284324908p+0") {
        println("FAIL hex_sq")
        return 31
    }
    if !str_eq(f128_to_hex_string(max_finite), "0x1.ffffffffffffffffffffffffffffp+16383") {
        println("FAIL hex_max")
        return 32
    }
    if !str_eq(f128_to_hex_string(min_normal), "0x1.0000000000000000000000000000p-16382") {
        println("FAIL hex_min_normal")
        return 33
    }
    if !str_eq(f128_to_hex_string(subnormal), "0x0.0000000000000000000000000001p-16382") {
        println("FAIL hex_subnormal")
        return 34
    }
    if !str_eq(f128_to_hex_string(pos_inf), "inf")
        || !str_eq(f128_to_hex_string(neg_inf), "-inf")
        || !str_eq(f128_to_hex_string(nan), "nan") {
        println("FAIL hex_specials")
        return 35
    }
    if !str_eq(f128_to_hex_string(zero), "0x0p+0") || !str_eq(f128_to_hex_string(neg_zero), "-0x0p+0") {
        println("FAIL hex_zeros")
        return 36
    }
    if !str_eq(f128_to_hex_string(twice(third)), "0x1.5555555555555555555555555555p-1")
        || !str_eq(f128_to_hex_string(cell.v), "0x1.5555555555555555555555555555p-3") {
        println("FAIL hex_through_fn_field")
        return 37
    }
    // 999…9 → 1.000…0e(n+1) carry out of the 36-digit mantissa.
    if !str_eq(f128_to_string(roll_a), "1.00000000000000000000000000000000000e-4847")
        || !str_eq(f128_to_hex_string(roll_a), "0x1.87f31452b1b42494995f8bc46918p-16102") {
        println("FAIL rollover_a")
        return 38
    }
    if !str_eq(f128_to_string(roll_b), "1.00000000000000000000000000000000000e-2866")
        || !str_eq(f128_to_hex_string(roll_b), "0x1.47362af41d3287e930f87171d6e1p-9521") {
        println("FAIL rollover_b")
        return 39
    }

    // The printing entry points themselves (no newline variants), one line.
    print("wire_print=")
    print_f128(sq)
    print("|")
    print_f128_hex(sq)
    println("")

    println("PASS f128_v0e58_print_f128 general=ieee754 anti_f64=green decimal=36sig_half_even hex=c99 print=madaros")
    return 0
}
