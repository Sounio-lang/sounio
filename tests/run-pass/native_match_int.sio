// Native integer literal match — validates PatIntLit codegen

fn classify(x: i64) -> i64 {
    match x {
        0 => { print("zero\n"); 0 }
        1 => { print("one\n"); 1 }
        42 => { print("answer\n"); 42 }
        _ => { print("other\n"); 99 }
    }
}

fn main() -> i64 {
    classify(0)
    classify(1)
    classify(42)
    classify(7)
    0
}
