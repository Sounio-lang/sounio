//@ run-pass
//@ description: user-struct confidence fields — f64 and i64 both healthy (#1496 twin)
//
// Positive controls for the Knowledge.confidence kind-split fix surface:
// a fix that re-marks every field named "confidence" as float must NOT break
// i64 confidence (0–1000 scale). A fix that forces every confidence to i64
// must NOT break f64 probability confidence on ordinary structs.

struct MiniF {
    confidence: f64,
}

struct MiniI {
    confidence: i64,
}

fn make_f() -> MiniF {
    MiniF { confidence: 0.671038 }
}

fn make_i() -> MiniI {
    MiniI { confidence: 800 }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    // R23 — user f64 confidence
    let mf = make_f()
    let cf = mf.confidence
    print("R23 ")
    print_f64(cf)
    println("")
    let half = cf * 0.5
    print("R23_half ")
    print_f64(half)
    println("")
    if !(cf > 0.20 && cf < 0.90 && half > 0.10 && half < 0.45) {
        if cf > 1.0e15 || half > 1.0e15 {
            println("R23_BITCAST_SITOFP")
        } else {
            println("R23_FAIL")
        }
        return 23
    }
    println("R23_OK")

    // R24 — user i64 confidence (integer scale; #1496 must stay integer path)
    let mi = make_i()
    let ci = mi.confidence
    print("R24 ")
    print_int(ci)
    println("")
    if ci < 800 {
        println("R24_GE_BAD")
        return 24
    }
    let d = ci - 100
    print("R24_sub ")
    print_int(d)
    println("")
    if ci != 800 || d != 700 {
        println("R24_FAIL")
        return 24
    }
    println("R24_OK")

    println("USER_CONF_ALL_OK")
    return 0
}
