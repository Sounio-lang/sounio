//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: ADD 5.000000 0.050000 1.000000
//@ expect-stdout-contains: SUB -1.000000 0.050000 1.000000
//@ expect-stdout-contains: MUL 6.000000 0.250000 1.000000
//@ expect-stdout-contains: DIV 0.666667 0.003086 1.000000
//@ expect-stdout-contains: CONF 8.000000 0.040000 0.700000
//@ expect-stdout-contains: NEST 6.000000 0.072000 1.000000
//@ expect-stdout-contains: CALL 9.000000 0.000000 0.700000
//@ expect-stdout-contains: LETCHAIN 5.000000 0.050000 1.000000
//@ expect-stdout-contains: NOMINAL
//@ expect-stdout-contains: 6.000000
//
// Knowledge<f64> (x) Knowledge<f64> arithmetic on Madaros (was E245). Operands
// are independent sources (E230 refuses pairs it cannot prove disjoint), so
// the first-order GUM variance has no covariance term:
//   a + b, a - b : va + vb            a * b : b^2 va + a^2 vb
//   a / b        : va / b^2 + a^2 vb / b^4
// confidence = min(ca, cb). Hand-computed with x = 2 +- 0.1, y = 3 +- 0.2:
//   x*y   : 9*0.01 + 4*0.04 = 0.25
//   x/y   : 0.01/9 + 4*0.04/81 = 0.0030864
//   (x+y)*Knowledge(1,e=..): see NEST/CALL below.

fn show(tag: string, k: Knowledge<f64>) with IO, Epistemic {
    print(tag); print(" ")
    print_f64(k.value); print(" ")
    print_f64(k.variance); print(" ")
    print_f64(k.confidence); print("\n")
}

fn mk() -> Knowledge<f64> with Epistemic {
    measure(4.0, uncertainty: 0.0)
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let x: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let y: Knowledge<f64> = measure(3.0, uncertainty: 0.2)
    show("ADD", x + y)
    show("SUB", x - y)
    show("MUL", x * y)
    show("DIV", x / y)

    let c: Knowledge<f64> = Knowledge(5.0, ε=0.7, prov="ref")
    show("CONF", y + c)

    // nested binary of two binaries: (x+y) = 5 var 0.05, times a point 1.2:
    // var = 1.44*0.05 + 25*0 = 0.072.
    let m: Knowledge<f64> = measure(1.2, uncertainty: 0.0)
    let n = (x + y) * m
    show("NEST", n)

    // a call result as an operand (c is a point value, empty source set).
    let w = c + mk()
    show("CALL", w)

    // a let-bound binary result is itself a Knowledge operand.
    let s = x + y
    let t = s - measure(0.0, uncertainty: 0.0)
    show("LETCHAIN", t)

    println("NOMINAL")
    println((x * y).value)
    0
}
