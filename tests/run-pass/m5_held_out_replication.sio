//@ run-pass
//
// Native-stage mirror for the M5 held-out replication smoke. The import-heavy
// version remains parked under tests/madaros/ocssm_imported/.

struct Trajectory {
    len: i64,
    speakers: [i64; 256],
    hashes: [i64; 256],
}

fn traj_empty() -> Trajectory {
    let zi: [i64; 256] = [0; 256]
    return Trajectory { len: 0, speakers: zi, hashes: zi }
}

fn traj_push(t: &Trajectory, speaker: i64, hash: i64) -> i64 with Mut {
    let i: i64 = t.len
    if i >= 256 { return i }
    t.speakers[i as usize] = speaker
    t.hashes[i as usize] = hash
    t.len = i + 1
    return t.len
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn mate(hash: i64) -> i64 {
    if hash == 7 { return 871 }
    if hash == 871 { return 7 }
    if hash == 16 { return 712 }
    if hash == 712 { return 16 }
    if hash == 54 { return 918 }
    if hash == 918 { return 54 }
    if hash == 63 { return 927 }
    if hash == 927 { return 63 }
    if hash == 107 { return 971 }
    if hash == 971 { return 107 }
    if hash == 108 { return 972 }
    if hash == 972 { return 108 }
    if hash == 128 { return 384 }
    if hash == 384 { return 128 }
    if hash == 132 { return 542 }
    if hash == 542 { return 132 }
    if hash == 139 { return 1003 }
    if hash == 1003 { return 139 }
    if hash == 190 { return 313 }
    if hash == 313 { return 190 }
    if hash == 250 { return 505 }
    if hash == 505 { return 250 }
    if hash == 489 { return 899 }
    if hash == 899 { return 489 }
    if hash == 547 { return 879 }
    if hash == 879 { return 547 }
    if hash == 574 { return 814 }
    if hash == 814 { return 574 }
    if hash == 599 { return 969 }
    if hash == 969 { return 599 }
    return -1
}

fn embed_axis(hash: i64) -> i64 {
    let r: i64 = hash - (hash / 7) * 7
    return 1 + r
}

fn embed_into(hash: i64, out: &![f64; 8]) with Mut {
    var i: i64 = 0
    while i < 8 {
        out[i as usize] = 0.0
        i = i + 1
    }
    let m: i64 = mate(hash)
    let canonical: i64 = if m >= 0 && hash > m { m } else { hash }
    let axis: i64 = embed_axis(canonical)
    let aux: i64 = if axis == 7 { 1 } else { axis + 1 }
    out[0] = 0.6
    if m >= 0 && hash > m {
        out[axis as usize] = 0.0 - 0.7745966692414834
        out[aux as usize] = 0.2
    } else {
        out[axis as usize] = 0.8
    }
}

fn conj(v: &[f64; 8], out: &![f64; 8]) with Mut {
    out[0] = v[0]
    var i: i64 = 1
    while i < 8 {
        out[i as usize] = 0.0 - v[i as usize]
        i = i + 1
    }
}

fn dist_sq(a: &[f64; 8], b: &[f64; 8]) -> f64 with Mut {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 {
        let d: f64 = a[i as usize] - b[i as usize]
        s = s + d * d
        i = i + 1
    }
    return s
}

fn pair_residual_sq(hash_a: i64, hash_b: i64) -> f64 with Mut {
    var ea: [f64; 8] = [0.0; 8]
    var eb: [f64; 8] = [0.0; 8]
    var ca: [f64; 8] = [0.0; 8]
    embed_into(hash_a, &!ea)
    embed_into(hash_b, &!eb)
    conj(&ea, &!ca)
    return dist_sq(&eb, &ca)
}

fn load_binary(t: &Trajectory, path: string) -> i64 with IO, Mut, Panic {
    let raw: string = read_file(path)
    let sz: i64 = file_size(path)
    if sz < 16 { return 0 }
    let version: i64 = read_i64(raw, 0)
    if version != 1 { return 0 }
    let n: i64 = read_i64(raw, 1)
    if n < 2 { return 0 }
    if sz < 16 + n * 40 { return 0 }
    var idx: i64 = 2
    var i: i64 = 0
    while i < n {
        let speaker: i64 = read_i64(raw, idx)
        let hash_val: i64 = read_i64(raw, idx + 1)
        let _len: i64 = traj_push(t, speaker, hash_val)
        idx = idx + 5
        i = i + 1
    }
    return n
}

fn paired_dist_sq_fold(t: &Trajectory, fold: i64) -> f64 with Mut, Div, Panic {
    if t.len < 2 { return 0.0 }
    var sum: f64 = 0.0
    var count: i64 = 0
    var i: i64 = 0
    var p: i64 = 0
    while i < t.len - 1 {
        if t.speakers[i as usize] != t.speakers[(i + 1) as usize] {
            let mod5: i64 = p - (p / 5) * 5
            var include: i64 = 0
            if fold == 0 { include = 1 }
            if fold == 1 && mod5 != 0 { include = 1 }
            if fold == 2 && mod5 == 0 { include = 1 }
            if include == 1 {
                sum = sum + pair_residual_sq(t.hashes[i as usize], t.hashes[(i + 1) as usize])
                count = count + 1
            }
            p = p + 1
        }
        i = i + 2
    }
    if count == 0 { return 0.0 }
    return sum / (count as f64)
}

fn random_dist_sq_fold(t: &Trajectory, fold: i64) -> f64 with Mut, Div, Panic {
    if t.len < 2 { return 0.0 }
    var sum: f64 = 0.0
    var count: i64 = 0
    var k: i64 = 0
    while k < t.len {
        let mod5: i64 = (k / 2) - ((k / 2) / 5) * 5
        var include: i64 = 0
        if fold == 0 { include = 1 }
        if fold == 1 && mod5 != 0 { include = 1 }
        if fold == 2 && mod5 == 0 { include = 1 }
        if include == 1 {
            let j: i64 = (k + 3) - ((k + 3) / t.len) * t.len
            if j != k {
                sum = sum + pair_residual_sq(t.hashes[k as usize], t.hashes[j as usize])
                count = count + 1
            }
        }
        k = k + 1
    }
    if count == 0 { return 0.0 }
    return sum / (count as f64)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var t: Trajectory = traj_empty()
    let loaded: i64 = load_binary(&t, "tests/fixtures/f2_swda.bin")
    if loaded < 2 {
        print("FAIL\n")
        return 1
    }

    let dp_train: f64 = paired_dist_sq_fold(&t, 1)
    let dr_train: f64 = random_dist_sq_fold(&t, 1)
    var ratio_train: f64 = 0.0
    if dp_train > 0.0 { ratio_train = dr_train / dp_train }

    let dp_held: f64 = paired_dist_sq_fold(&t, 2)
    let dr_held: f64 = random_dist_sq_fold(&t, 2)
    var ratio_held: f64 = 0.0
    if dp_held > 0.0 { ratio_held = dr_held / dp_held }

    let drift: f64 = abs_f64(dp_held - dp_train)
    let tolerance: f64 = 0.5 * dp_train

    var ok: i64 = 1
    if dp_train <= 0.0 { ok = 0 }
    if dp_train > 0.10 { ok = 0 }
    if ratio_train < 5.0 { ok = 0 }
    if dp_held <= 0.0 { ok = 0 }
    if dp_held > 0.10 { ok = 0 }
    if ratio_held < 5.0 { ok = 0 }
    if drift > tolerance { ok = 0 }

    if ok == 1 { print("PASS\n") } else { print("FAIL\n") }
    return 0
}
