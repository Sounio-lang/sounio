//@ run-pass
//@ expect-stdout: PASS: GPU vec_ops

kernel fn vec_sub_in_place(n: i64, a: &![f64], b: &[f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] - b[tid as usize]
    }
}

kernel fn vec_mul(n: i64, a: &[f64], b: &[f64], c: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        c[tid as usize] = a[tid as usize] * b[tid as usize]
    }
}

kernel fn vec_div_in_place(n: i64, a: &![f64], b: &[f64]) with GPU, Div {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] / b[tid as usize]
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU, Div {
    var sub_a: [f64; 128] = [0.0; 128]
    var sub_b: [f64; 128] = [0.0; 128]
    var mul_a: [f64; 128] = [0.0; 128]
    var mul_b: [f64; 128] = [0.0; 128]
    var mul_c: [f64; 128] = [0.0; 128]
    var div_a: [f64; 128] = [0.0; 128]
    var div_b: [f64; 128] = [0.0; 128]

    var i: i64 = 0
    while i < 128 {
        sub_a[i as usize] = 10.0 + i as f64
        sub_b[i as usize] = i as f64
        mul_a[i as usize] = (i as f64) + 1.0
        mul_b[i as usize] = 2.0
        div_a[i as usize] = 8.0 + i as f64
        div_b[i as usize] = 2.0
        i = i + 1
    }

    vec_sub_in_place(128, &!sub_a, &sub_b)
    vec_mul(128, &mul_a, &mul_b, &!mul_c)
    vec_div_in_place(128, &!div_a, &div_b)

    if sub_a[0] > 9.99 &&
       sub_a[64] > 9.99 &&
       mul_c[0] > 1.99 && mul_c[0] < 2.01 &&
       mul_c[63] > 127.99 && mul_c[63] < 128.01 &&
       div_a[0] > 3.99 && div_a[0] < 4.01 &&
       div_a[10] > 8.99 && div_a[10] < 9.01 {
        println("PASS: GPU vec_ops")
    } else {
        println("FAIL: GPU vec_ops")
    }
    0
}
