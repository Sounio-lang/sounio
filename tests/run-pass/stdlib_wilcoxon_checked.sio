//@ run-pass
//@ expect-stdout: STDLIB_WILCOXON_CHECKED_PASS
//@ timeout: 180
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use stats::checked_wilcoxon::{wilcoxon_rank_workspace,wilcoxon_rank_checked,wilcoxon_exact_workspace,wilcoxon_exact_ranked_checked,wilcoxon_normal_approx_checked}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 assert(wilcoxon_rank_workspace(1000000,1).status==6)
 assert(wilcoxon_rank_workspace(1000001,64000000).status==5)
 var d=numeric_buffer_new(5,40)
 var magnitude=numeric_buffer_new(5,40)
 var order=integer_buffer_new(5,40)
 var ranks=integer_buffer_new(5,40)
 var i:i64=0
 while i<5 {numeric_buffer_set(&!d,i,0.0);numeric_buffer_set(&!magnitude,i,17.0);integer_buffer_set(&!order,i,-19);integer_buffer_set(&!ranks,i,-23);i=i+1}
 numeric_buffer_set(&!d,0,1.0e-15);numeric_buffer_set(&!d,1,-2.0e-15);numeric_buffer_set(&!d,3,3.0e-15)
 numeric_buffer_set(&!d,4,0.0/0.0)
 let bad=wilcoxon_rank_checked(&d,5,0,true,&!magnitude,&!order,&!ranks,100)
 assert(bad.status==2 && bad.sort_comparisons==0)
 i=0
 while i<5 {assert(numeric_buffer_at(&magnitude,i)==17.0 && integer_buffer_at(&order,i)== -19 && integer_buffer_at(&ranks,i)== -23);i=i+1}
 numeric_buffer_set(&!d,4,-0.0)
 assert(wilcoxon_rank_checked(&d,5,2,true,&!magnitude,&!order,&!ranks,100).status==1)
 let exhausted=wilcoxon_rank_checked(&d,5,0,true,&!magnitude,&!order,&!ranks,0)
 assert(exhausted.status==3 && exhausted.sort_comparisons==0)
 i=0
 while i<5 {assert(integer_buffer_at(&ranks,i)== -23);i=i+1}
 let prepared=wilcoxon_rank_checked(&d,5,0,true,&!magnitude,&!order,&!ranks,100)
 assert(prepared.status==0 && prepared.n_eff==3 && prepared.n_zero==2)
 assert(prepared.rank_biserial_available && prepared.z_available)
 assert(integer_buffer_at(&ranks,3)== -23 && integer_buffer_at(&ranks,4)== -23)
 let payload=wilcoxon_exact_workspace(&ranks,prepared.n_eff,0,0,1000000)
 assert(payload.status==6 && payload.payload_bytes>0 && !payload.operation_bound_available)
 let query=wilcoxon_exact_workspace(&ranks,prepared.n_eff,0,8000,1000000)
 assert(query.status==0 && query.operation_bound_available)
 var counts=integer_buffer_new(1000,8000)
 var numerator=integer_buffer_new(8,64)
 i=0
 while i<1000 {integer_buffer_set(&!counts,i,-29);i=i+1}
 i=0
 while i<8 {integer_buffer_set(&!numerator,i,-31);i=i+1}
 let memory_refusal=wilcoxon_exact_ranked_checked(&ranks,prepared.n_eff,0,&!counts,&!numerator,0,1000000)
 assert(memory_refusal.status==6 && !memory_refusal.numerator_available && memory_refusal.count_operations==0)
 let work_refusal=wilcoxon_exact_ranked_checked(&ranks,prepared.n_eff,0,&!counts,&!numerator,8000,0)
 assert(work_refusal.status==3 && !work_refusal.numerator_available && work_refusal.count_operations==0)
 i=0
 while i<1000 {assert(integer_buffer_at(&counts,i)== -29);i=i+1}
 i=0
 while i<8 {assert(integer_buffer_at(&numerator,i)== -31);i=i+1}
 let saved=integer_buffer_at(&ranks,1)
 integer_buffer_set(&!ranks,1,0)
 assert(wilcoxon_exact_ranked_checked(&ranks,prepared.n_eff,0,&!counts,&!numerator,8000,1000000).status==1)
 assert(integer_buffer_at(&counts,0)== -29 && integer_buffer_at(&numerator,0)== -31)
 integer_buffer_set(&!ranks,1,saved)
 let exact=wilcoxon_exact_ranked_checked(&ranks,prepared.n_eff,0,&!counts,&!numerator,8000,query.operation_bound)
 assert(exact.status==0 && exact.method==1 && exact.numerator_available && exact.denominator_exponent==3)
 assert(exact.count_operations<=query.operation_bound && exact.value_available && exact.log_available)
 i=query.numerator_len
 while i<8 {assert(integer_buffer_at(&numerator,i)== -31);i=i+1}
 i=0
 while i<5 {numeric_buffer_set(&!d,i,0.0);i=i+1}
 let point=wilcoxon_rank_checked(&d,5,1,true,&!magnitude,&!order,&!ranks,100)
 assert(point.status==0 && point.n_eff==0 && point.n_zero==5 && !point.rank_biserial_available && !point.z_available)
 let point_probability=wilcoxon_exact_ranked_checked(&ranks,0,0,&!counts,&!numerator,8000,1000000)
 assert(point_probability.status==0 && point_probability.value==1.0 && point_probability.log_value==0.0 && point_probability.numerator_available)
 assert(integer_buffer_at(&numerator,0)==1)
 assert(wilcoxon_normal_approx_checked(&point,0,0,1.0e-11).status==1)
 assert(wilcoxon_normal_approx_checked(&point,0,100,0.0/0.0).status==2)
 let kernel_exhausted=wilcoxon_normal_approx_checked(&prepared,0,1,1.0e-11)
 assert(kernel_exhausted.status==3 && kernel_exhausted.normal_iterations==1 && kernel_exhausted.count_operations==0)
 assert(!kernel_exhausted.value_available && !kernel_exhausted.log_available)
 let approximate=wilcoxon_normal_approx_checked(&prepared,0,100,1.0e-11)
 assert(approximate.status==0 && approximate.method==2 && !approximate.numerator_available)
 numeric_buffer_set(&!d,0,1.0);numeric_buffer_set(&!d,1,-1.0)
 let balanced=wilcoxon_rank_checked(&d,5,0,true,&!magnitude,&!order,&!ranks,100)
 assert(balanced.status==0 && balanced.n_eff==2 && balanced.z_available && balanced.z==0.0)
 let balanced_normal=wilcoxon_normal_approx_checked(&balanced,0,100,1.0e-11)
 assert(balanced_normal.status==0 && balanced_normal.value_available && balanced_normal.log_available)
 assert(balanced_normal.value==1.0 && balanced_normal.value<=1.0 && balanced_normal.log_value==0.0 && balanced_normal.log_value<=0.0)
 numeric_buffer_close(d);numeric_buffer_close(magnitude)
 integer_buffer_close(order);integer_buffer_close(ranks);integer_buffer_close(counts);integer_buffer_close(numerator)
 println("STDLIB_WILCOXON_CHECKED_PASS")
 0
}
