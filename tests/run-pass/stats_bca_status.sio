//@ run-pass
//@ expect-stdout: STATS_BCA_STATUS_PASS
use stats::bootstrap::{bootstrap_bca_mean}
use stats::bca_normal::{bca_normal_cdf,bca_normal_quantile}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 x[0]=1.0;x[1]=2.0;x[2]=4.0
 assert(bootstrap_bca_mean(&x,0,10,0.95,1).status==1)
 assert(bootstrap_bca_mean(&x,257,10,0.95,1).status==1)
 assert(bootstrap_bca_mean(&x,3,1,0.95,1).status==1)
 assert(bootstrap_bca_mean(&x,3,1025,0.95,1).status==1)
 assert(bootstrap_bca_mean(&x,3,10,0.0,1).status==2)
 assert(bootstrap_bca_mean(&x,3,10,1.0,1).status==2)
 assert(bootstrap_bca_mean(&x,3,10,0.9999999,1).status==7)
 let zero=0.0
 let nan=zero/zero
 let inf=1.0/zero
 assert(bootstrap_bca_mean(&x,3,10,nan,1).status==2)
 x[0]=nan
 assert(bootstrap_bca_mean(&x,3,10,0.95,1).status==3)
 x[0]=inf
 assert(bootstrap_bca_mean(&x,3,10,0.95,1).status==3)
 x[0]=7.0;x[1]=7.0;x[2]=7.0
 let c=bootstrap_bca_mean(&x,3,100,0.95,1)
 assert(c.status==5 && c.b==0 && !c.tail_resolved)
 assert(c.lo==0.0 && c.hi==0.0 && c.se==0.0)
 assert(bca_normal_cdf(inf).status==1)
 assert(bca_normal_cdf(6.1).status==2)
 assert(bca_normal_quantile(nan).status==1)
 assert(bca_normal_quantile(1.0e-8).status==2)
 assert(bca_normal_quantile(0.5).value==0.0)
 println("STATS_BCA_STATUS_PASS")
 0
}
