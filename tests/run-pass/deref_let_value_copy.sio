//@ run-pass
//@ expect-stdout: 1
// SIO-278: `let saved = *b` must value-copy the aggregate, as `let copy = t`
// already does for a plain identifier. It bound the storage inside the Box,
// so the write through `(*b).a[0]` showed through `saved.a[0]` (99);
// lean_single prints 1.

struct T { a: [i64; 4], n: i64 }

fn main() -> i32 with IO {
    var b = Box::new(T { a: [1, 2, 3, 4], n: 1 })
    let saved = *b
    (*b).a[0] = 99
    print_int(saved.a[0])
    println("")
    return 0
}
