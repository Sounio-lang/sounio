//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-3 obligation seed receipt

fn child3_obligation_seed_check(
    child2_discharge_preflight_fp: i64,
    child2_discharge_preflight_audit_fp: i64,
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    seed_status: i64) -> i64 {
    if child2_discharge_preflight_fp != 865117026 { return 0 - 1 }
    if child2_discharge_preflight_audit_fp != 22656757 { return 0 - 1 }
    if child2_validation_core_fp != 173471211 { return 0 - 1 }
    if child2_validation_core_audit_fp != 173431050 { return 0 - 1 }
    if child_index != 3 { return 0 - 1 }
    if slot_x != 1 { return 0 - 1 }
    if slot_y != 1 { return 0 - 1 }
    if slot_z != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if seed_status != 68 { return 0 - 1 }
    return 853502997
}

fn main() -> i64 {
    let artifact = child3_obligation_seed_check(
        865117026, 22656757, 173471211, 173431050, 3, 1, 1, 0, 0, 68)
    if artifact != 853502997 { return 1 }

    let audit_fp: i64 = 176202003
    let instance_fp: i64 = 669599681
    let certificate_fp: i64 = 307153093
    let selected_child_mask: i64 = 8
    let prior_child_validated_mask: i64 = 7
    let pending_child_validation_mask: i64 = 24
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let seed_status: i64 = 68
    let ok_mask: i64 = 255

    if audit_fp != 176202003 { return 2 }
    if instance_fp != 669599681 { return 3 }
    if certificate_fp != 307153093 { return 4 }
    if selected_child_mask != 8 { return 5 }
    if prior_child_validated_mask != 7 { return 6 }
    if pending_child_validation_mask != 24 { return 7 }
    if local_flowpipe_proof_mask != 0 { return 8 }
    if child_validated_mask != 0 { return 9 }
    if child_discharge_mask != 0 { return 10 }
    if global_cover_certificate_mask != 0 { return 11 }
    if global_flowpipe_claim_mask != 0 { return 12 }
    if seed_status != 68 { return 13 }
    if ok_mask != 255 { return 14 }

    let wrong_child = child3_obligation_seed_check(
        865117026, 22656757, 173471211, 173431050, 2, 1, 1, 0, 0, 68)
    if wrong_child != 0 - 1 { return 15 }

    let wrong_slot = child3_obligation_seed_check(
        865117026, 22656757, 173471211, 173431050, 3, 0, 1, 0, 0, 68)
    if wrong_slot != 0 - 1 { return 16 }

    let overclaim = child3_obligation_seed_check(
        865117026, 22656757, 173471211, 173431050, 3, 1, 1, 0, 1, 68)
    if overclaim != 0 - 1 { return 17 }

    return 0
}
