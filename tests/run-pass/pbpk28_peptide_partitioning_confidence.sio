//@ run-pass
//@ description: PBPK28 peptide-partitioning priors as Knowledge<f64, ε>. A peptide
//@ tissue-Kp term declared at the HONEST ceiling (with Epistemic(450), the weakest =
//@ size-exclusion accessibility prior) compiles and runs; Epistemic(460) is rejected.
//@ Epistemic witness for stdlib/darwin_pbpk/core/peptide_partitioning.sio (Contribution 2).
//
// The stdlib module stores f_ew, MW and accessibility as plain f64 (Madaros-safe);
// here they are wrapped as Knowledge<f64, ε>, so the literature confidence flows
// into the compile-time gate. Tirzepatide (MW 4813) muscle Kp = f_ew(0.118) *
// accessibility(2000/(2000+4813)=0.2936) = 0.03466.
//   MW            eps=0.95  product monograph
//   f_ew          eps=0.85  ICRP 89
//   accessibility eps=0.45  phenomenological size-exclusion  <- weakest, ceiling 450

fn tirzepatide_muscle_kp() -> f64 with Epistemic(450), Mut, Div, Panic {
    let f_ew: Knowledge[f64] = Knowledge(0.118, ε=0.85, prov="ICRP89_muscle_ECW");
    let access: Knowledge[f64] = Knowledge(0.2936, ε=0.45, prov="two_pore_size_exclusion_MW4813");
    f_ew.value * access.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    println(tirzepatide_muscle_kp());
    println("PBPK28_PEPTIDE_PARTITIONING_GATE_PASS");
}
