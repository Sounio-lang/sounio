//@ run-pass
//@ expect-stdout-contains: VENLAFAXINE_XR_DOSE_BOUNDARY_PASS
//
// No dose releases mass before it is given. With τ = 24 h and dt = 24/17 h
// (a whole number of steps, but dt not exact in binary), reconstructing a
// dose's age as (n as f64)·dt − k·τ lands at ~1e-14 instead of 0, and the
// Korsmeyer-Peppas fraction, whose ported ln series floors it at ~7.9e-3 for
// tiny t > 0, turned that into 0.591 mg released in the step BEFORE each
// dose. vfx_released_qtau now counts the age in integer steps.
//
// Check, at every dose boundary j·S (j = 1…9, S = 17): the release over the
// step that ends at the dose, j·S − 1, is the same with and without dose j.
// The comparison is exact: a dose that has not started adds no term at all,
// so the two sums run over identical terms. A pre-dose release of even one
// ulp fails it.

use darwin_pbpk::scenarios::venlafaxine_xr::*
use darwin_pbpk::release::matrix_er::*

fn main() -> i64 with IO, Mut, Div, Panic {
    var exit_fails: i64 = 0
    let rel = venlafaxine_xr_matrix_gohel2008()
    let steps: i64 = 17
    let dt = 24.0 / 17.0
    var j: i32 = 1
    while j < 10 {
        let n = (j as i64) * steps - 1
        let with_j = vfx_released_qtau(rel, j + 1, steps, n, dt)
        let without_j = vfx_released_qtau(rel, j, steps, n, dt)
        let early = with_j - without_j
        println("dose, mass it released in the step before it (mg):")
        println(j)
        println(early)
        if !(early == 0.0) {
            println("FAIL: dose released mass before it was given")
            return 1
        }
        j = j + 1
    }
    println("VENLAFAXINE_XR_DOSE_BOUNDARY_PASS")
    if exit_fails > 0 {
        return 1
    }
    return 0
}
