//@ run-pass
//@ description: 128-char string literal must print all 128 bytes — silent truncation is a fail
// Exactly 128 'A' characters between quotes.
// Pre-fix Madaros printed 127 and exited 0 (lie). Post-fix: full 128 or refuse with E258.
fn main() with IO {
    let s = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    println(s)
    println("LEN_EXPECT=128")
    println("PASS string_literal_len128_print")
}
