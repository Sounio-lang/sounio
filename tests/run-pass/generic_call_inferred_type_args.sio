//@ run-pass
//@ expect-stdout: inferred calls: PASS
//@ requires: madaros
// Generic fn calls without a turbofish, their type arguments determined from the
// arguments: literals, annotated and unannotated locals, references, arrays, two
// parameters, and a generic fn calling another inside its own specialized body.
// Each inferred instantiation is specialized exactly like the turbofish form, so
// f64 values come back intact.

fn identity<T>(x: T) -> T {
    x
}

fn first_of<T>(a: [T; 3]) -> T {
    a[0]
}

fn deref_it<T>(r: &T) -> T {
    *r
}

fn pair_first<A, B>(a: A, b: B) -> A {
    a
}

fn twice<T>(x: T) -> T {
    identity(x)
}

fn main() -> i32 with IO {
    var ok: i64 = 0
    if identity(42) == 42 { ok = ok + 1 }
    if identity(2.5) == 2.5 { ok = ok + 1 }
    let xs: [f64; 3] = [1.5, 2.5, 3.5]
    if first_of(xs) == 1.5 { ok = ok + 1 }
    let v: i64 = 9
    if deref_it(&v) == 9 { ok = ok + 1 }
    if pair_first(7, true) == 7 { ok = ok + 1 }
    if twice(3.25) == 3.25 { ok = ok + 1 }
    let ys = [4, 5, 6]
    if first_of(ys) == 4 { ok = ok + 1 }
    if ok == 7 {
        print("inferred calls: PASS\n")
    }
    return 0
}
