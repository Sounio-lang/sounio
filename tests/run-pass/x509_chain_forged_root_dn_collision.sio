    let root_buf = rawbuf_new(genuine_root_der_len + 8)
    var i: i64 = 0
    while i < genuine_root_der_len { rawbuf_set(&root_buf, i, genuine_root_der_bytes[i as usize] as i64); i = i + 1 }
    let forged_root_buf = rawbuf_new(forged_root_der_len + 8)
    var j: i64 = 0
    while j < forged_root_der_len { rawbuf_set(&forged_root_buf, j, forged_root_der_bytes[j as usize] as i64); j = j + 1 }
    let leaf_buf = rawbuf_new(attacker_leaf_der_len + 8)
    var k: i64 = 0
    while k < attacker_leaf_der_len { rawbuf_set(&leaf_buf, k, attacker_leaf_der_bytes[k as usize] as i64); k = k + 1 }

    let (genuine_root_cert, e1) = x509_parse_certificate(&root_buf, genuine_root_der_len)
    if e1 != X509_OK { return 0 - 101 }
    let (forged_root_cert, e2) = x509_parse_certificate(&forged_root_buf, forged_root_der_len)
    if e2 != X509_OK { return 0 - 102 }
    let (attacker_leaf_cert, e3) = x509_parse_certificate(&leaf_buf, attacker_leaf_der_len)
    if e3 != X509_OK { return 0 - 103 }

    // Sanity: the two roots really do share a Subject DN but really do
    // have different keys -- otherwise this test would not be exercising
    // the DN-collision bypass at all.
    if !x509_name_eq(&genuine_root_cert.subject, &forged_root_cert.subject) {
        return 0 - 104
    }
    if bigint_cmp(&genuine_root_cert.modulus, &forged_root_cert.modulus) == 0 {
        return 0 - 105
    }

    // Trust store contains ONLY the genuine root.
    var store = TrustStore { certs: [certificate_zero(); 512], bufs: [rawbuf_new(1); 512], count: 1 }
    store.certs[0] = genuine_root_cert
    store.bufs[0] = root_buf

    // The forged root is presented exactly as an attacker would present
    // it: in the `intermediates` slot, alongside the attacker's own leaf.
    var intermediates: [Certificate; 8] = [certificate_zero(); 8]
    var intermediate_bufs: [RawBuf; 8] = [rawbuf_new(1); 8]
    intermediates[0] = forged_root_cert
    intermediate_bufs[0] = forged_root_buf

    let hostname_text: [u8; 40] = [
        102,111,114,103,101,100,45,114,111,111,116,45,100,110,45,99,111,108,
        108,105,115,105,111,110,46,101,120,97,109,112,108,101,
        0,0,0,0,0,0,0,0
    ]
    let hostname_len: i64 = 32
    let hostname_buf = rawbuf_new(40)
    var h: i64 = 0
    while h < hostname_len { rawbuf_set(&hostname_buf, h, hostname_text[h as usize] as i64); h = h + 1 }

    let result = x509_verify_chain(&attacker_leaf_cert, &leaf_buf, &intermediates, &intermediate_bufs, 1, &store, &hostname_buf, hostname_len, 1787659200, &rawbuf_new(1), 0)

    // The core security property: the forged chain must NEVER verify as
    // CHAIN_OK. See the header comment for why the measured rejection code
    // is CHAIN_ERR_BAD_SIGNATURE rather than the originally-expected
    // CHAIN_ERR_NO_PATH_TO_ROOT (both are acceptable "correctly rejected"
    // outcomes; CHAIN_OK is the one outcome that would mean the bypass is
    // still live).
    if result == CHAIN_OK {
        print_int(result)
        return 1
    }
    if result != CHAIN_ERR_BAD_SIGNATURE && result != CHAIN_ERR_NO_PATH_TO_ROOT {
        print_int(result)
        return 1
    }

    println("x509_chain_forged_root_dn_collision: forged self-signed root with genuine root's Subject DN correctly rejected")
    return 0
}
