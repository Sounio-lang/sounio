//@ run-pass
//@ description: Imported Lorenz i256 rho*x-y term bridge smoke

use systems::lorenz_i256_limb_scale_bridge::*
use systems::lorenz_i256_signed_delta_bridge::*
use systems::lorenz_i256_rho_x_minus_y_bridge::*

fn main() -> i64 with Div {
    let positive = lorenz_i256_rho_x_minus_y_term_check(
        100000000, 0, 0, 0, 800000000, 1, 0, 0, 1, 0, 1, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_rho_x_minus_y_term_check(
        50000000, 0, 0, 0, 0, 2, 0, 0, 0 - 1, 600000000, 0, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_rho_x_minus_y_term_check(
        50000000, 0, 0, 0, 400000000, 1, 0, 0, 0, 0, 0, 0, 0)
    if zero != 1 { return 3 }

    let invalid = lorenz_i256_rho_x_minus_y_term_abs_limb(
        1000000000, 0, 0, 0, 0, 0, 0, 0, 0)
    if invalid != 0 - 1 { return 4 }

    let scale_anchor = lorenz_i256_limb_scale_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 103)
    if scale_anchor != 734815269 { return 5 }

    let scale_audit = lorenz_i256_limb_scale_bridge_audit_fingerprint(
        scale_anchor, 508642719, 971304826, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 103, 1023)
    if scale_audit != 216903584 { return 6 }

    let delta_anchor = lorenz_i256_signed_delta_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 104)
    if delta_anchor != 492681735 { return 7 }

    let delta_audit = lorenz_i256_signed_delta_bridge_audit_fingerprint(
        delta_anchor, 604913728, 195740286, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 104, 1023)
    if delta_audit != 837260419 { return 8 }

    let artifact = lorenz_i256_rho_x_minus_y_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 107)
    if artifact != 570239184 { return 9 }

    let audit = lorenz_i256_rho_x_minus_y_bridge_audit_fingerprint(
        artifact, 314762905, 726591438, scale_anchor, scale_audit,
        delta_anchor, delta_audit, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 107, 1023)
    if audit != 908416527 { return 10 }
    return 0
}
