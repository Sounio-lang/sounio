//@ run-pass
//! Basic self-hosted smoke test for stdlib `math::sedenion`.
//!
//! This exercises:
//! - module loading from stdlib (math directory mode)
//! - sedenion multiplication via Cayley-Dickson construction
//! - zero-divisor detection logic
//! - float math intrinsics used by `sed_norm` (sqrt)

use math::sedenion::{
    sed_known_zero_divisor,
    sed_complementary_zero_divisor,
    sed_mul,
    sed_norm_sq,
    sed_norm,
    sed_is_zero_divisor,
}

fn main() with IO, Panic {
    let s = sed_known_zero_divisor()
    let t = sed_complementary_zero_divisor()
    let prod = sed_mul(s, t)

    println("sedenion prod norm_sq:")
    println(sed_norm_sq(prod))

    println("sedenion norm(s):")
    println(sed_norm(s))

    println("sedenion is_zero_divisor(s):")
    println(sed_is_zero_divisor(s))
}

