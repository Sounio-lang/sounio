//@ run-pass
//@ description: #2798 — the issue's own shape: an imported function returning (f64, i64, i64) (stdlib particle_physics::lattice_gauge::glueball_meff_best_tau) keeps its middle element i64 on lean_single (it was retyped f64 and the call refused with E001).
//@ expect-stdout: 0.500000 3 1

use particle_physics::lattice_gauge::{glueball_meff_best_tau}
fn idi(v: i64) -> i64 { v }
fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    var meff: [f64; 8] = [0.0; 8]
    var valid: [i64; 8] = [0; 8]
    meff[1] = 0.5
    meff[2] = 0.5
    meff[3] = 0.5
    valid[1] = 1
    valid[2] = 1
    valid[3] = 1
    let (m, t, w) = glueball_meff_best_tau(&meff, &valid, 8)
    print_f64(m) print(" ") print_int(idi(t)) print(" ") print_int(idi(w)) print("\n")
    return 0
}
