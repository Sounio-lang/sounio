//@ run-pass
//@ expect-stdout: GUM_XFER_TABLE_OK
//@ requires: madaros
// 100 pure scale helpers. The first-order transfer table held 64 entries (about
// 13 already taken by the builtin transcendentals) and dropped later helpers
// without a diagnostic, so a call to a late helper was treated as opaque and
// its variance was wrong with exit 0. s99(x) = x * 99.5, so with u = 0.1
// Var = (99.5 * 0.1)^2 = 99.0025; s60 gives (60.5 * 0.1)^2 = 36.6025.

fn s0(x: f64) -> f64 { x * 0.5 }
fn s1(x: f64) -> f64 { x * 1.5 }
