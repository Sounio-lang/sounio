fn s99(x: f64) -> f64 { x * 99.5 }

fn near(a: f64, b: f64) -> bool {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    var m = b
    if m < 0.0 { m = 0.0 - m }
    d <= 1.0e-9 * m + 1.0e-14
}

fn t_late() -> bool with IO, Epistemic {
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let x = k.value
    near(variance_of(s99(x)), 99.0025) && near(variance_of(s60(x)), 36.6025) && near(variance_of(s3(x)), 0.1225)
}

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    if t_late() {
        print("GUM_XFER_TABLE_OK\n")
        return 0
    }
    print("GUM_XFER_TABLE_FAIL\n")
    1
}
