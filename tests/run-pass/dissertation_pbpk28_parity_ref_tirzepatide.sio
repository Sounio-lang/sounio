//@ run-pass
//@ timeout: 90
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — TIRZEPATIDE (SIO-517)
//
// Dual GIP/GLP-1 receptor agonist peptide, MW = 4813 Da. Subcutaneous depot
// release with first-order absorption (k_a = 0.0164 /h, F = 0.80, 5 mg
// weekly maintenance; Urva 2022 popPK, FDA 2022 label). Proteolytic
// clearance CL = 0.061 L/h (Urva 2022). Per Martin 2024 (radiolabel ADME)
// no intact parent appears in excreta, so no renal clearance of parent is
// modeled — elimination here is central proteolytic only.
//
// This ref runs the stdlib scenario ITSELF
// (scenarios/tirzepatide_sc_depot.sio): its step, its depot model, its
// params. It holds no copy of the model (venlafaxine pattern, PR #2699
// review). The companion is website/src/lib/pbpk28_core.mjs
// (DEFAULT_PARAMS_TIRZEPATIDE) and the gate case at
// scripts/ci/dissertation_pbpk28_parity_gate.sh.
//
// PK only: no TMDD/PD layer. Receptor compartments are SIO-517 follow-up.
//
// Integrator: fully-coupled CN on the 27-state arrow matrix, dt = 0.001,
// same as the rapamycin/semaglutide refs. Release enters as dt*release/V_b
// in row 0 of rhs at the step midpoint.
// ============================================================================

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::scenarios::tirzepatide_sc_depot::*
use io::sci_print::*

fn emit_at(scen: TirzepatideScenario, p: PBPKParams28, t: f64, rel_cum: f64) with IO, Mut, Div {
    var i = 0
    while i < 14 {
        print("PARITY|t=")
        println(t)
        println("")
        print("PARITY|i=")
        println(i)
        print("PARITY|cv=")
        println_f64_sci(scen.pbpk.cv[i], 10)
        print("PARITY|ct=")
        println_f64_sci(scen.pbpk.ct[i], 10)
        print("PARITY|cavg=")
        println_f64_sci(pbpk28_organ_average(scen.pbpk, p, i), 10)
        i = i + 1
    }
    print("TMASS|t=")
    println(t)
    println("")
    print("TMASS|m=")
    println(pbpk28_total_mass(scen.pbpk, p))
    println("")
    print("TREL|t=")
    println(t)
    println("")
    print("TREL|cum=")
    println(rel_cum)
    println("")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_TIRZEPATIDE_PARITY_REF v1")
    println("compartments=14")
    println("states=28")
    println("dt=0.001")
    println("dose_mg=5.0")
    println("ka_h_inv=0.0164")
    println("F_bioavailability=0.80")
    println("cl_proteolytic_L_per_h=0.061")
    println("integrator=fully_coupled_CN_27state")
    println("drug=tirzepatide")
    println("release=sc_depot")
    println("samples=12")

    let p = tirz_pbpk28_params()
    var scen = tirz_scenario_init()
    let dt = 0.001
    var t = 0.0
    var rel_cum = 0.0

    var s = 0
    while s < 12 {
        var target = 0.1
        if s == 1 { target = 0.5 }
        if s == 2 { target = 1.0 }
        if s == 3 { target = 2.0 }
        if s == 4 { target = 4.0 }
        if s == 5 { target = 6.0 }
        if s == 6 { target = 8.0 }
        if s == 7 { target = 12.0 }
        if s == 8 { target = 16.0 }
        if s == 9 { target = 20.0 }
        if s == 10 { target = 24.0 }
        if s == 11 { target = 30.0 }
        while t + dt * 0.5 < target {
            rel_cum = rel_cum + tirz_release_rate_at(t + 0.5 * dt) * dt
            scen = tirz_step(scen, p, t, dt)
            t = t + dt
        }
        emit_at(scen, p, t, rel_cum)
        s = s + 1
    }

    println("DISSERTATION_PBPK28_TIRZEPATIDE_PARITY_DONE")
    return 0
}
