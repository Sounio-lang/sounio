//@ run-pass
//@ description: #2830 (content moved from #2825) — xorshift64* over u64: `r >> 33` must be a logical shift when r has bit 63 set; lean_single printed -212610827.
//@ expect-stdout: 1934872821

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    var s: u64 = 88172645463325252
    let m: u64 = 0x2545F4914F6CDD1D
    s = s ^ (s >> 12)
    s = s ^ (s << 25)
    s = s ^ (s >> 27)
    let r: u64 = s * m
    print_int((r >> 33) as i64)
    print("\n")
    return 0
}
