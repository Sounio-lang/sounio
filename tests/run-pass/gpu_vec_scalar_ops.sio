//@ run-pass
//@ expect-stdout: PASS: GPU vec_scalar_ops

kernel fn vec_add_scalar_in_place(n: i64, a: &![f64], bias: f64) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] + bias
    }
}

kernel fn vec_div_scalar_out(n: i64, input: &[f64], factor: f64, output: &![f64]) with GPU, Div {
    let tid = gpu_thread_id_x()
    if tid < n {
        output[tid as usize] = input[tid as usize] / factor
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU, Div {
    var add_in: [f64; 64] = [0.0; 64]
    var div_src: [f64; 64] = [0.0; 64]
    var div_out: [f64; 64] = [0.0; 64]

    var i: i64 = 0
    while i < 64 {
        add_in[i as usize] = (i as f64) + 1.0
        div_src[i as usize] = (i as f64) + 8.0
        i = i + 1
    }

    vec_add_scalar_in_place(64, &!add_in, 2.5)
    vec_div_scalar_out(64, &div_src, 2.0, &!div_out)

    if add_in[0] > 3.49 && add_in[0] < 3.51 &&
       add_in[10] > 13.49 && add_in[10] < 13.51 &&
       div_out[0] > 3.99 && div_out[0] < 4.01 &&
       div_out[10] > 8.99 && div_out[10] < 9.01 {
        println("PASS: GPU vec_scalar_ops")
    } else {
        println("FAIL: GPU vec_scalar_ops")
    }
    0
}
