//@ run-pass
//@ expect-stdout: inf
//@ expect-stdout: FAMILY_B_DOF_INF
//@ expect-stdout: PASS
//@ description: Type-B Budget64 Effective DOF must print as inf, not 2^63 (Family B).
//@   Madaros print_f64 saturates |x| ≳ 1e19 via cvttsd2si → 9223372036854775808.
//@   Distinct from April ζ variance_of slot OOB. See sweep 2026-08-18.

use epistemic::budget64::{
    Budget64,
    budget64_new,
    budget64_add_type_b,
    budget64_finalize,
    budget64_print_report,
}

fn main() with IO, Mut, Div {
    var b = budget64_new(1.0, 0.95)
    budget64_add_type_b(&!b, 0, 12.4, 1.24, 1.0)
    budget64_finalize(&!b)
    budget64_print_report(&b)
    // Stored sentinel remains 1e30 for coverage_factor; only the print is inf.
    if b.effective_dof > 1.0e20 {
        println("FAMILY_B_DOF_INF")
        println("PASS")
    } else {
        println("FAMILY_B_DOF_FINITE")
        println("FAIL")
    }
}
