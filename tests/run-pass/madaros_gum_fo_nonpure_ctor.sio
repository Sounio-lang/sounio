//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_NONPURE_CTOR_PASS

// Non-identity pure struct constructors: field FO via projected bytecode.
// Identity make_id(x).cl0 was already live; make_dbl(x) / make_scaled(x,s)
// compile FO of the field init expr under mangle(fn, field).

struct Pk {
    cl0: f64
}

fn make_id(cl0: f64) -> Pk {
    Pk { cl0: cl0 }
}

fn make_dbl(x: f64) -> Pk {
    Pk { cl0: x * 2.0 }
}

fn make_scaled(x: f64, s: f64) -> Pk {
    Pk { cl0: x * s }
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let ks: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let x = kx.value
    let s = ks.value

    let v_id = variance_of(make_id(x).cl0)
    let v_dbl = variance_of(make_dbl(x).cl0)
    let v_scaled = variance_of(make_scaled(x, s).cl0)
    let v_peel_id = variance_of(x)
    let v_peel_dbl = variance_of(x * 2.0)
    let v_peel_scaled = variance_of(x * s)

    // Call-result method path through computed field
    // (clearance uses self.cl0 from make_dbl)
    // Kept as free peel match only — method FO on nonpure ctor is bonus.

    print("v_id="); print_f64(v_id); print("\n")
    print("v_dbl="); print_f64(v_dbl); print("\n")
    print("v_scaled="); print_f64(v_scaled); print("\n")

    let ok = abs_f(v_id - v_peel_id) < 1.0e-9
        && abs_f(v_id - 0.09) < 1.0e-9
        && abs_f(v_dbl - v_peel_dbl) < 1.0e-9
        && abs_f(v_dbl - 0.36) < 1.0e-9
        && abs_f(v_scaled - v_peel_scaled) < 1.0e-9
        && v_scaled > 0.0
    if ok {
        print("MADAROS_GUM_FO_NONPURE_CTOR_PASS\n")
    } else {
        print("MADAROS_GUM_FO_NONPURE_CTOR_FAIL\n")
    }
}
