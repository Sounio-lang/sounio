//@ run-pass

use graphics::drawing::{color_red, color_white}
use graphics::surface::{surface_new, surface_clear, surface_set_pixel}
use graphics::export::{export_png}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(4, 4)
    s = surface_clear(s, color_white())
    s = surface_set_pixel(s, 1, 1, color_red())

    let ok = export_png(&s, "/tmp/graphics_png_export_smoke.png")
    if !ok {
        print("FAIL png export returned false\n")
        return 1
    }

    let sz = file_size("/tmp/graphics_png_export_smoke.png")
    if sz <= 0 {
        print("FAIL png export wrote empty file\n")
        return 2
    }

    print("PASS graphics_png_export_smoke\n")
    0
}
