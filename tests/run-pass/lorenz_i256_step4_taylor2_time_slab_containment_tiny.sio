//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 time-slab containment receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1469
    fp = mix(fp, 4, 5297)
    fp = mix(fp, 37368367, 5297)
    fp = mix(fp, 94030837, 5297)
    fp = mix(fp, 827089582, 5297)
    fp = mix(fp, 688797663, 5297)
    fp = mix(fp, 700260810, 5297)
    fp = mix(fp, 7045651, 5297)
    fp = mix(fp, 27293136, 5297)
    fp = mix(fp, 644980, 5297)
    fp = mix(fp, 1, 5297)
    fp = mix(fp, 100, 5297)
    fp = mix(fp, 70457, 5297)
    fp = mix(fp, 272932, 5297)
    fp = mix(fp, 6450, 5297)
    fp = mix(fp, 71000, 5297)
    fp = mix(fp, 273500, 5297)
    fp = mix(fp, 6500, 5297)
    fp = mix(fp, 543, 5297)
    fp = mix(fp, 568, 5297)
    fp = mix(fp, 50, 5297)
    fp = mix(fp, 7, 5297)
    fp = mix(fp, 7, 5297)
    fp = mix(fp, 0, 5297)
    fp = mix(fp, 13, 5297)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 519576522 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1471
    fp = mix(fp, instance, 5303)
    fp = mix(fp, 7045651, 5303)
    fp = mix(fp, 27293136, 5303)
    fp = mix(fp, 644980, 5303)
    fp = mix(fp, 1, 5303)
    fp = mix(fp, 100, 5303)
    fp = mix(fp, 70457, 5303)
    fp = mix(fp, 272932, 5303)
    fp = mix(fp, 6450, 5303)
    fp = mix(fp, 71000, 5303)
    fp = mix(fp, 273500, 5303)
    fp = mix(fp, 6500, 5303)
    fp = mix(fp, 543, 5303)
    fp = mix(fp, 568, 5303)
    fp = mix(fp, 50, 5303)
    fp = mix(fp, 7, 5303)
    fp = mix(fp, 7, 5303)
    fp = mix(fp, 0, 5303)
    fp = mix(fp, 13, 5303)
    fp = mix(fp, ok_mask, 5303)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 519576522 { return 0 - 1 }
    if certificate != 85884916 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1481
    fp = mix(fp, instance, 5309)
    fp = mix(fp, certificate, 5309)
    fp = mix(fp, 14, 5309)
    fp = mix(fp, 4, 5309)
    fp = mix(fp, 7, 5309)
    fp = mix(fp, 7, 5309)
    fp = mix(fp, 0, 5309)
    fp = mix(fp, 13, 5309)
    fp = mix(fp, ok_mask, 5309)
    return fp
}

fn time_slab_mask() -> i64 {
    let selected_dt_den: i64 = 100
    let dx_bound: i64 = 7045651
    let dy_bound: i64 = 27293136
    let dz_bound: i64 = 644980
    let x_sweep: i64 = 70457
    let y_sweep: i64 = 272932
    let z_sweep: i64 = 6450
    let x_margin: i64 = 71000
    let y_margin: i64 = 273500
    let z_margin: i64 = 6500
    let x_slack: i64 = x_margin - x_sweep
    let y_slack: i64 = y_margin - y_sweep
    let z_slack: i64 = z_margin - z_sweep

    var containment_mask: i64 = 0
    if x_sweep <= x_margin { containment_mask = containment_mask + 1 }
    if y_sweep <= y_margin { containment_mask = containment_mask + 2 }
    if z_sweep <= z_margin { containment_mask = containment_mask + 4 }

    var ok_mask: i64 = 0
    if 37368367 > 0 {
        if 827089582 > 0 { ok_mask = ok_mask + 1 }
    }
    if 700260810 > 0 { ok_mask = ok_mask + 2 }
    if (x_sweep - 1) * selected_dt_den < dx_bound {
        if x_sweep * selected_dt_den >= dx_bound {
            if (y_sweep - 1) * selected_dt_den < dy_bound {
                if y_sweep * selected_dt_den >= dy_bound {
                    if (z_sweep - 1) * selected_dt_den < dz_bound {
                        if z_sweep * selected_dt_den >= dz_bound { ok_mask = ok_mask + 4 }
                    }
                }
            }
        }
    }
    if x_slack == 543 {
        if y_slack == 568 {
            if z_slack == 50 { ok_mask = ok_mask + 8 }
        }
    }
    if 1 == 1 {
        if selected_dt_den == 100 { ok_mask = ok_mask + 16 }
    }
    if containment_mask == 7 {
        if 13 == 13 { ok_mask = ok_mask + 32 }
    }
    if 0 == 0 { ok_mask = ok_mask + 64 }
    if 37368367 > 0 {
        if containment_mask == 7 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = time_slab_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 519576522 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 85884916 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 110014281 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
