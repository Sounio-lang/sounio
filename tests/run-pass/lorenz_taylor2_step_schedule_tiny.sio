//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz Taylor-2 step schedule receipt over the v46 adaptive decision

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn rational_leq_nonneg(left_num: i64, left_den: i64, right_num: i64, right_den: i64) -> i64 {
    if left_num < 0 { return 0 }
    if right_num < 0 { return 0 }
    if left_den <= 0 { return 0 }
    if right_den <= 0 { return 0 }
    if left_num * right_den <= right_num * left_den { return 1 }
    return 0
}

fn step_schedule_fingerprint(decision_fp: i64, decision_audit_fp: i64) -> i64 {
    if decision_fp != 120259197 { return 0 - 1 }
    if decision_audit_fp != 471466754 { return 0 - 1 }

    let min_dt_num = 1
    let min_dt_den = 200
    let selected_dt_num = 1
    let selected_dt_den = 100
    let max_dt_num = 3
    let max_dt_den = 200
    let shrink_dt_num = 1
    let shrink_dt_den = 200
    let hold_dt_num = 1
    let hold_dt_den = 100
    let grow_dt_num = 3
    let grow_dt_den = 200

    var schedule_mask: i64 = 0
    if rational_leq_nonneg(min_dt_num, min_dt_den, selected_dt_num, selected_dt_den) == 1 {
        schedule_mask = schedule_mask + 1
    }
    if rational_leq_nonneg(selected_dt_num, selected_dt_den, max_dt_num, max_dt_den) == 1 {
        schedule_mask = schedule_mask + 2
    }
    if 2 == 2 { schedule_mask = schedule_mask + 4 }
    if selected_dt_num == hold_dt_num {
        if selected_dt_den == hold_dt_den {
            schedule_mask = schedule_mask + 8
        }
    }
    if rational_leq_nonneg(shrink_dt_num, shrink_dt_den, hold_dt_num, hold_dt_den) == 1 {
        if rational_leq_nonneg(hold_dt_num, hold_dt_den, grow_dt_num, grow_dt_den) == 1 {
            schedule_mask = schedule_mask + 16
        }
    }
    if decision_fp == 120259197 { schedule_mask = schedule_mask + 32 }
    if selected_dt_den <= 200 { schedule_mask = schedule_mask + 64 }
    if schedule_mask != 127 { return 0 - 1 }

    var fp: i64 = 577
    fp = quality_mix(fp, decision_fp)
    fp = quality_mix(fp, decision_audit_fp)
    fp = quality_mix(fp, 279109641)
    fp = quality_mix(fp, 207228249)
    fp = quality_mix(fp, 984799877)
    fp = quality_mix(fp, 2)
    fp = quality_mix(fp, 1)
    fp = quality_mix(fp, 100)
    fp = quality_mix(fp, min_dt_num)
    fp = quality_mix(fp, min_dt_den)
    fp = quality_mix(fp, selected_dt_num)
    fp = quality_mix(fp, selected_dt_den)
    fp = quality_mix(fp, max_dt_num)
    fp = quality_mix(fp, max_dt_den)
    fp = quality_mix(fp, shrink_dt_num)
    fp = quality_mix(fp, shrink_dt_den)
    fp = quality_mix(fp, hold_dt_num)
    fp = quality_mix(fp, hold_dt_den)
    fp = quality_mix(fp, grow_dt_num)
    fp = quality_mix(fp, grow_dt_den)
    fp = quality_mix(fp, schedule_mask)
    fp = quality_mix(fp, 200)
    return fp
}

fn step_schedule_audit_fingerprint(schedule_fp: i64) -> i64 {
    if schedule_fp != 353612555 { return 0 - 1 }

    var fp: i64 = 587
    fp = quality_mix(fp, schedule_fp)
    fp = quality_mix(fp, 120259197)
    fp = quality_mix(fp, 471466754)
    fp = quality_mix(fp, 279109641)
    fp = quality_mix(fp, 207228249)
    fp = quality_mix(fp, 984799877)
    fp = quality_mix(fp, 2)
    fp = quality_mix(fp, 127)
    return fp
}

fn main() -> i64 {
    if rational_leq_nonneg(1, 200, 1, 100) != 1 { return 1 }
    if rational_leq_nonneg(1, 100, 3, 200) != 1 { return 2 }
    if rational_leq_nonneg(3, 200, 1, 100) != 0 { return 3 }
    if rational_leq_nonneg(1, 0, 1, 100) != 0 { return 4 }

    let fp = step_schedule_fingerprint(120259197, 471466754)
    if fp != 353612555 { return 5 }
    let audit_fp = step_schedule_audit_fingerprint(fp)
    if audit_fp != 335541872 { return 6 }

    if step_schedule_fingerprint(120259198, 471466754) != (0 - 1) { return 7 }
    if step_schedule_audit_fingerprint(353612556) != (0 - 1) { return 8 }
    return 0
}
