//@ run-pass
//@ description: `return ()` in a unit function type-checks on aarch64 (the a64 paren handler ran compile_or_a64 on the `)` and kept the previous expression's type, so it failed "return type does not match function signature"; x86 was unaffected)
//@ expect-stdout: guarded=1
//@ expect-stdout: unit_return_ok
struct Counter { v: i64 }

fn bump(c: &!Counter, x: i64) with Mut {
    if x < 0 || x > 31 {
        c.v = c.v + 100
        return ()
    }
    c.v = c.v + 1
}

fn main() with IO, Mut {
    var c = Counter { v: 0 }
    bump(&!c, 5)
    bump(&!c, 5)
    print("guarded=")
    print_int(c.v - 1)
    print("\n")
    println("unit_return_ok")
}
