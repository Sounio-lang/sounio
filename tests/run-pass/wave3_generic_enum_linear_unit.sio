//@ run-pass
//@ requires: madaros
//@ expect-stdout: GENERIC_ENUM_NESTED_LINEAR_UNIT_BORROW_OK
linear struct OwnedToken {id:i64}
enum Option<T> {Some(T),None}
enum Result<T,E> {Ok(T),Err(E)}
fn wrap(value:OwnedToken)->Option<Result<OwnedToken,i64> > {Option::Some(Result::Ok(value))}
fn close(value:OwnedToken)->i64 {value.id}
fn unwrap(value:Option<Result<OwnedToken,i64> >)->i64 {
 match value {Option::Some(result)=>match result {Result::Ok(token)=>close(token),Result::Err(code)=>code},Option::None=>0}
}
fn borrow_read(value:&Option<i64>)->i64 {match value {Option::Some(n)=>n,Option::None=>0}}
fn unit_value()->Option<()> {Option::Some(())}
fn accept_unit(value:())->i64 {9}
fn read_unit(value:Option<()>)->i64 {match value {Option::Some(u)=>accept_unit(u),Option::None=>0}}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
 let token=OwnedToken{id:42}
 assert(unwrap(wrap(token))==42)
 let integer:Option<i64> =Option::Some(7)
 assert(borrow_read(&integer)==7)
 assert(read_unit(unit_value())==9)
 println("GENERIC_ENUM_NESTED_LINEAR_UNIT_BORROW_OK")
 0
}
