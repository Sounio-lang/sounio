//@ run-pass
// tests/run-pass/dossier_smoke.sio
//
// Smoke test for the regulatory dossier generator.  Builds a fully
// deterministic minimal DossierInput for rapamycin and emits the
// dossier to stdout.  The companion gate
// scripts/ci/dissertation_dossier_gate.sh diffs stdout bytewise
// against tests/golden/dissertation/dossier_rapamycin_snapshot.md.
//
// All inputs (including generated_at_utc and commit_sha) are
// deterministic constants, so the snapshot is fully reproducible
// without timestamp stripping.

use scripts::dissertation::dossier_generator::*

fn build_minimal_rapamycin_input() -> DossierInput with Mut, Div, Panic {
    var d = dossier_input_zero()
    d.drug_name        = "Rapamycin (Sirolimus)"
    d.model_name       = "PBPK14 + Cypher DES coupling"

    // Two parameters — keep the snapshot tight.
    d.n_params = 2
    d.params[0] = ParamRow {
        name: "CL_hep", units: "L/h",
        value: 12.6, rel_u: 0.18, confidence: 0.612,
    }
    d.params[1] = ParamRow {
        name: "Kpuu_brain", units: "-",
        value: 0.045, rel_u: 0.45, confidence: 0.503,
    }

    d.method_name = "Tsit5 adaptive"
    d.abs_tol = 0.000001
    d.rel_tol = 0.0001
    d.h_min   = 0.001
    d.h_max   = 0.5

    // §5: 1st-order budget — three rows from a Phase Y CSV.
    d.n_budget_rows_o1 = 3
    d.budget_o1[0] = BudgetRow {
        source: "rapamycin_iv_dose", type_a_or_b: "B",
        u_i: 0.300, contribution: 0.530,
    }
    d.budget_o1[1] = BudgetRow {
        source: "population_CL", type_a_or_b: "A",
        u_i: 0.226, contribution: 0.301,
    }
    d.budget_o1[2] = BudgetRow {
        source: "Kpuu_brain_extrap", type_a_or_b: "B",
        u_i: 0.205, contribution: 0.169,
    }
    d.u_c_o1  = 0.409
    d.u95_o1  = 0.818

    // §6: 2nd-order budget — present in this test fixture.
    d.n_budget_rows_o2 = 2
    d.budget_o2[0] = BudgetRow {
        source: "CL_x_Kpuu_cross", type_a_or_b: "B",
        u_i: 0.041, contribution: 0.620,
    }
    d.budget_o2[1] = BudgetRow {
        source: "Kpuu_x_fu_cross", type_a_or_b: "B",
        u_i: 0.032, contribution: 0.380,
    }
    d.u_c_o2 = 0.058
    d.u95_o2 = 0.116

    // §7
    d.phase_j_pass     = true
    d.phase_j_min_conf = 0.500
    d.phase_j_observed = 0.612

    // §8
    d.n_clinical = 1
    d.clinical[0] = ClinicalRow {
        endpoint: "AUC_brain", units: "ng·h/mL",
        sounio_value: 184.2, reference_value: 178.5, pct_diff: 3.19,
    }

    // §9 — fully deterministic
    d.commit_sha       = "0000000000000000000000000000000000000000"
    d.generated_at_utc = "2026-05-10T00:00:00Z"
    d.sounio_version   = "lane-8c-test"
    d
}

fn main() with IO, Mut, Panic, Div {
    let d = build_minimal_rapamycin_input()
    dossier_emit(d)
    println("PASS dossier_smoke")
}
