//@ run-pass
//@ requires: madaros
//@ expect-stdout: raw_f64_cast: PASS
//@ description: `as i64` on a read_f64 / bits_to_f64 result (direct or via a let) converts the f64 value instead of passing its IEEE-754 bits on
// read_f64 and bits_to_f64 are raw builtins with no IrFunction, so the Madaros
// lowerer classified their result as an integer word and lowered `as i64` as an
// identity cast: `read_f64(p, 3) as i64` with p[3] == 1.0 gave
// 4607182418800017408 (0x3ff0000000000000). stdlib/data/bigframe_ops.sio
// bf_join_inner indexes by `read_f64(ml, j) as i64`, so it read past the heap
// and SIGSEGV'd at row 1 (tests/stdlib/data/test_bigframe_ops_stdlib.sio).

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let p = heap_alloc(64) as *mut f64
    write_f64(p, 0, 0.0)
    write_f64(p, 1, 3.0)
    write_f64(p, 2, 7.0)
    write_f64(p, 3, 1.0)
    var bad: i64 = 0
    // direct cast of the call
    if read_f64(p, 2) as i64 != 7 { print("FAIL direct\n"); bad = bad + 1 }
    // cast of a local bound from the call (no annotation)
    let a = read_f64(p, 1)
    if a as i64 != 3 { print("FAIL let\n"); bad = bad + 1 }
    // the bf_join_inner shape: a cast result used as an index
    let b = read_f64(p, read_f64(p, 3) as i64)
    if b != 3.0 { print("FAIL nested index\n"); bad = bad + 1 }
    // arithmetic on the result was already right; keep it pinned
    if read_f64(p, 1) + read_f64(p, 2) != 10.0 { print("FAIL add\n"); bad = bad + 1 }
    // bits_to_f64: 0x4000000000000000 is 2.0
    if bits_to_f64(4611686018427387904) as i64 != 2 { print("FAIL bits_to_f64\n"); bad = bad + 1 }
    let h = bits_to_f64(4611686018427387904)
    if h as i64 != 2 { print("FAIL bits_to_f64 let\n"); bad = bad + 1 }
    heap_free(p as *mut i8)
    if bad == 0 { print("raw_f64_cast: PASS\n"); return 0 }
    print("raw_f64_cast: FAIL\n")
    1
}
