//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_GUM_FO_OFFDIAG_INDEPENDENT_PASS

// Independent seeds: diagonal second-order mean is complete.
// E2[a*b] = μa·μb  (H_aa=H_bb=0; cross H_ab needs Cov=0 → no bias)
// E2[(a+b)^2] = (μa+μb)^2 + σa² + σb²  (diagonal H_aa=H_bb=2)

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let ka: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(4.0, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value

    // Independent product: no 2nd-order bias
    let mab = second_order_mean(a * b)
    let vab = variance_of(a * b)
    // s_a=4, s_b=3 → Var = 16*0.01 + 9*0.04 = 0.16+0.36 = 0.52
    let vab_exp = 0.52

    // (a+b)^2: μ=7, E2 = 49 + 0.01 + 0.04 = 49.05
    let s = a + b
    let mss = second_order_mean(s * s)
    let vss = variance_of(s * s)
    // s_a=2*(a+b)=14, s_b=14 → Var = 196*0.01 + 196*0.04 = 1.96+7.84 = 9.8
    let vss_exp = 9.8
    let mss_exp = 49.05

    print("mab="); print_f64(mab); print("\n")
    print("vab="); print_f64(vab); print("\n")
    print("mss="); print_f64(mss); print("\n")
    print("vss="); print_f64(vss); print("\n")

    let ok = abs_f(mab - 12.0) < 1.0e-9
        && abs_f(vab - vab_exp) < 1.0e-9
        && abs_f(mss - mss_exp) < 1.0e-8
        && abs_f(vss - vss_exp) < 1.0e-8
    if ok {
        print("MADAROS_GUM_FO_OFFDIAG_INDEPENDENT_PASS\n")
    } else {
        print("MADAROS_GUM_FO_OFFDIAG_INDEPENDENT_FAIL\n")
    }
}
