//@ run-pass
// Sprint 235: Verify print_f64 bytecode construction
// Tests that ast_emit_print_f64_builtin produces the correct x86-64 machine code
// Rewritten to use global arrays (avoids struct-return SRET issues in lean_single)

var G_BYTES: [i64; 4096] = [0; 4096]
var G_LEN: i64 = 0

fn eb(b: i64) with Mut {
    G_BYTES[G_LEN] = b
    G_LEN = G_LEN + 1
}

// Exact copy of ast_emit_print_f64_builtin from lean driver
fn build_print_f64() with Mut, Panic, Div {
    G_LEN = 0
    eb(0x55); eb(0x48); eb(0x89); eb(0xe5)
    eb(0x48); eb(0x83); eb(0xec); eb(0x50)
    eb(0x66); eb(0x48); eb(0x0f); eb(0x6e); eb(0xc7)
    eb(0x66); eb(0x48); eb(0x0f); eb(0x7e); eb(0xc0)
    eb(0x48); eb(0x85); eb(0xc0)
    let skip_neg = G_LEN
    eb(0x79); eb(0x00)
    eb(0xc6); eb(0x45); eb(0xff); eb(0x2d)
    eb(0x48); eb(0x8d); eb(0x75); eb(0xff)
    eb(0xba); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xbf); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xb8); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0x0f); eb(0x05)
    eb(0x48); eb(0x25); eb(0xff); eb(0xff); eb(0xff); eb(0xff)
    eb(0xff); eb(0xff); eb(0xff); eb(0x7f)
    eb(0x66); eb(0x48); eb(0x0f); eb(0x6e); eb(0xc0)
    G_BYTES[(skip_neg + 1)] = (G_LEN - (skip_neg + 2)) & 0xFF
    eb(0xf2); eb(0x48); eb(0x0f); eb(0x2c); eb(0xc0)
    eb(0x4c); eb(0x8d); eb(0x55); eb(0xd8)
    eb(0x49); eb(0x89); eb(0xc0)
    eb(0x41); eb(0x89); eb(0xc0)
    eb(0x41); eb(0x80); eb(0xc0); eb(0x30)
    eb(0x45); eb(0x88); eb(0x02)
    eb(0x48); eb(0x8d); eb(0x75); eb(0xd8)
    eb(0xba); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xbf); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xb8); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0x0f); eb(0x05)
    eb(0xc6); eb(0x45); eb(0xfe); eb(0x2e)
    eb(0x48); eb(0x8d); eb(0x75); eb(0xfe)
    eb(0xba); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xbf); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xb8); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0x0f); eb(0x05)
    eb(0xf2); eb(0x48); eb(0x0f); eb(0x2a); eb(0xc8)
    eb(0xf2); eb(0x0f); eb(0x5c); eb(0xc1)
    eb(0x48); eb(0xb8); eb(0x00); eb(0x00); eb(0x00); eb(0x00)
    eb(0x80); eb(0x84); eb(0x2e); eb(0x41)
    eb(0x66); eb(0x48); eb(0x0f); eb(0x6e); eb(0xd0)
    eb(0xf2); eb(0x0f); eb(0x59); eb(0xc2)
    eb(0xf2); eb(0x48); eb(0x0f); eb(0x2c); eb(0xc8)
    eb(0xc6); eb(0x45); eb(0xf7); eb(0x30)
    eb(0xc6); eb(0x45); eb(0xf8); eb(0x30)
    eb(0xc6); eb(0x45); eb(0xf9); eb(0x30)
    eb(0xc6); eb(0x45); eb(0xfa); eb(0x30)
    eb(0xc6); eb(0x45); eb(0xfb); eb(0x30)
    eb(0xc6); eb(0x45); eb(0xfc); eb(0x30)
    eb(0x48); eb(0x8d); eb(0x75); eb(0xf7)
    eb(0xba); eb(0x06); eb(0x00); eb(0x00); eb(0x00)
    eb(0xbf); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xb8); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0x0f); eb(0x05)
    eb(0xc6); eb(0x45); eb(0xfd); eb(0x0a)
    eb(0x48); eb(0x8d); eb(0x75); eb(0xfd)
    eb(0xba); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xbf); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0xb8); eb(0x01); eb(0x00); eb(0x00); eb(0x00)
    eb(0x0f); eb(0x05)
    eb(0xc9); eb(0xc3)
}

fn main() -> i64 with IO, Mut, Panic, Div {
    build_print_f64()

    // Verify bytecode size and key bytes
    // Prologue: push rbp (0x55)
    assert(G_BYTES[0] == 0x55)

    // movq xmm0, rdi: 66 48 0F 6E C7
    assert(G_BYTES[8] == 0x66)
    assert(G_BYTES[9] == 0x48)
    assert(G_BYTES[10] == 0x0f)
    assert(G_BYTES[11] == 0x6e)
    assert(G_BYTES[12] == 0xc7)

    // Epilogue: leave (0xc9) + ret (0xc3) at end
    assert(G_BYTES[(G_LEN - 2)] == 0xc9)
    assert(G_BYTES[(G_LEN - 1)] == 0xc3)

    // Check total bytecode size is reasonable (should be ~200-250 bytes)
    assert(G_LEN > 100)
    assert(G_LEN < 400)

    print("PASS: print_f64 bytecode size=")
    print_int(G_LEN)
    print(" prologue=0x55 movq=66480F6EC7 epilogue=C9C3\n")

    // Verify jump patch: skip_neg offset should be non-zero
    // skip_neg is at byte index 23 (after prologue+movq+movq+test)
    // The jns displacement byte is at index 24
    let jns_disp = G_BYTES[24]
    assert(jns_disp > 0)
    print("PASS: jns displacement=")
    print_int(jns_disp)
    print("\n")

    print("PASS: all print_f64 bytecode checks\n")
    0
}
