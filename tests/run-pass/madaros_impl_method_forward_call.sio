//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS impl_method_forward_call
// Calls into impl methods whose bodies are lowered later than the caller.
// The single-module preseed never registered impl method summaries
// (return_struct_name, first_param_is_ref), so each case below crashed:
//   - PC::via calls PC::new, declared below it in the same impl: SIGILL
//     (`p.get()` became a body-less bare `get`);
//   - main, placed above `impl Late`, binds `Late::new()`: SIGILL;
//   - main, placed above `fn make_late`, calls `.get()` on its result: the
//     call to Late_get lost first_param_is_ref and segfaulted.

fn main() -> i32 with IO {
    let early = PC { n: 1 }
    if early.via() != 5 {
        print("FAIL PC::via\n")
        return 1
    }
    let a = Late::new()
    if a.get() != 7 {
        print("FAIL Late::new\n")
        return 1
    }
    let b = make_late()
    if b.get() != 8 {
        print("FAIL make_late\n")
        return 1
    }
    print("PASS impl_method_forward_call\n")
    return 0
}

struct PC {
    n: i64,
}

impl PC {
    fn via(self: &PC) -> i64 {
        let p = PC::new()
        p.get()
    }
    fn new() -> PC {
        PC { n: 5 }
    }
    fn get(self: &PC) -> i64 {
        self.n
    }
}

struct Late {
    n: i64,
}

impl Late {
    fn new() -> Late {
        Late { n: 7 }
    }
    fn get(self: &Late) -> i64 {
        self.n
    }
}

fn make_late() -> Late {
    Late { n: 8 }
}
