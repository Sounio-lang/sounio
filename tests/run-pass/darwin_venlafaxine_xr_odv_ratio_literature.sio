//@ run-pass
//@ known-failure: measured 2026-09-26 under SOUNIO_SOUC_ENGINE=lean_single — steady-state ODV/parent C_avg ratio PM 0.3465 (Shams 2006 band < 0.3) and UM 2.502 (band > 5.2) fall outside the published bands; IM 1.127 and NM 1.912 are inside. Hepatic flow (Q_liver = 90 L/h) caps formation, so scaling CL_form by the reference ratio cannot reach the UM band.
//@ xfail-expect: LITERATURE_FAIL_HONEST outside_mask=9
//@ expect-stdout-contains: VENLAFAXINE_XR_ODV_RATIO_LITERATURE_PASS
//
// Model steady-state ODV/parent ratio (vfx_ss_odv_parent_ratio, 75 mg XR q24h,
// dt = 0.5 h) against the steady-state serum ODV/V bands of Shams et al. 2006,
// J Clin Pharm Ther 31(5):493-502 (PubMed 16958828): PM < 0.3, IM 1.1 ± 0.8,
// UM > 5.2 (both strict), NM within the cohort's 10th-90th percentiles
// [0.3, 5.2]. The
// bands are the published values (vfx_ss_ratio_band_lo/hi); none is widened to
// fit the model. The smoke test certifies the readout itself to far better
// than any band width, so a failure here is a model-versus-data disagreement,
// not numerical error.

use darwin_pbpk::scenarios::venlafaxine_xr::*

fn main() -> i32 with Mut, Div, IO, Panic {
    let dt = 0.5
    var outside = 0
    var mask = 0
    var bit = 1
    var ph: i32 = 0
    while ph < 4 {
        let r = vfx_ss_odv_parent_ratio(ph, dt)
        let lo = vfx_ss_ratio_band_lo(ph)
        let hi = vfx_ss_ratio_band_hi(ph)
        println("pheno (0=PM 1=IM 2=NM 3=UM), model ratio, band lo, band hi:")
        println(ph)
        println(r)
        println(lo)
        println(hi)
        if !vfx_ss_ratio_in_band(ph, r) {
            println("  OUTSIDE published band")
            outside = outside + 1
            mask = mask + bit
        }
        bit = 2 * bit
        ph = ph + 1
    }
    if outside > 0 {
        // One line, so the known-failures manifest can pin which phenotypes
        // fail (PM=1 IM=2 NM=4 UM=8); any other pattern is a fresh failure.
        print("VENLAFAXINE_XR_ODV_RATIO_LITERATURE_FAIL_HONEST outside_mask=")
        println(mask)
        return 1
    }
    println("VENLAFAXINE_XR_ODV_RATIO_LITERATURE_PASS")
    return 0
}
