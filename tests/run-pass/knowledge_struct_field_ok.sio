//@ run-pass
//
// Struct-field Knowledge<T> — β¹⁰ run-pass (valid construction and access).
//
// A struct with a Knowledge<f64> field can be constructed with a Knowledge<f64>
// value and the field accessed via .value. Hessian of the field value is
// accepted when the channel is in the topology.

struct EpistemicPair { a: Knowledge<f64>, n: i64 }

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let p = EpistemicPair { a: k0, n: 42 }
    let v = p.a.value    // channel 0
    let h00 = hessian_of(v, 0, 0)
    println(h00)
}
