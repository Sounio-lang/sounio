//@ run-pass
//@ requires: madaros
//@ expect-stdout: unit-typed return is float: PASS
// A value whose declared type is a measurement unit is an f64 at run time, and it
// must survive a function boundary as one. The checker has always typed `mg` as
// f64 carrying a unit; the IR lowering classified only the names f64/f32 as float,
// so `-> mg` got returns_float=0 and the call result was read as an integer:
// `g() as f64` printed 4643000109586448384.0, the IEEE-754 bits of 250.0. A
// unit-typed runtime guard built on that value compared garbage and never trapped.

unit mg_dL;

struct Dose {
    amount: mg,
}

fn measured_dose() -> mg {
    return 250.0
}

fn measured_glucose() -> mg_dL {
    return 140.0 as mg_dL
}

fn main() -> i32 with IO {
    var ok: i64 = 0
    let x = measured_dose()
    if x as f64 == 250.0 { ok = ok + 1 }
    let d = Dose { amount: measured_dose() }
    let a: mg = d.amount
    if a as f64 == 250.0 { ok = ok + 1 }
    let t: mg = 500.0
    let r = a / t
    if r < 1.0 { ok = ok + 1 }
    let gl = measured_glucose()
    if gl as f64 == 140.0 { ok = ok + 1 }
    if ok == 4 {
        print("unit-typed return is float: PASS\n")
    }
    return 0
}
