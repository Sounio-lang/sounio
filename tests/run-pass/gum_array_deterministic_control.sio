//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS
// Regression for #3546: array elements must retain their source channels.

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    var arr: [f64; 4] = [0.0; 4]
    let ka: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    // A seed elsewhere must not taint an unrelated deterministic array.
    var i: i64 = 0
    let exact = 3.0
    arr[i] = exact
    let y = arr[i] * 2.0
    if variance_of(y) != 0.0 { return 1 }
    if uncertainty_of(arr[0]) != 0.0 { return 2 }
    print("PASS\n")
    return 0
}
