//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v119 smoke for Lorenz i256 step-2 Taylor-2 completed candidate bundle

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1867
    receipt_fp = mix(receipt_fp, 725374434, 5843)
    receipt_fp = mix(receipt_fp, 571048339, 5843)
    receipt_fp = mix(receipt_fp, 264692547, 5843)
    receipt_fp = mix(receipt_fp, 82020601, 5843)
    receipt_fp = mix(receipt_fp, 296443716, 5843)
    receipt_fp = mix(receipt_fp, 56035538, 5843)
    receipt_fp = mix(receipt_fp, 210859660, 5843)
    receipt_fp = mix(receipt_fp, 444092349, 5843)
    receipt_fp = mix(receipt_fp, 625429438, 5843)
    receipt_fp = mix(receipt_fp, 2, 5843)
    receipt_fp = mix(receipt_fp, 4, 5843)
    receipt_fp = mix(receipt_fp, 255, 5843)
    if receipt_fp != 563006672 { return 1 }

    var audit_fp: i64 = 1871
    audit_fp = mix(audit_fp, receipt_fp, 5849)
    audit_fp = mix(audit_fp, 725374434, 5849)
    audit_fp = mix(audit_fp, 571048339, 5849)
    audit_fp = mix(audit_fp, 264692547, 5849)
    audit_fp = mix(audit_fp, 82020601, 5849)
    audit_fp = mix(audit_fp, 444092349, 5849)
    audit_fp = mix(audit_fp, 625429438, 5849)
    audit_fp = mix(audit_fp, 210859660, 5849)
    audit_fp = mix(audit_fp, 2, 5849)
    audit_fp = mix(audit_fp, 4, 5849)
    audit_fp = mix(audit_fp, 255, 5849)
    if audit_fp != 602593763 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 122, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 122, 1103)
    if entry_fp != 248874394 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 119, 1151)
    manifest_fp = mix(manifest_fp, 123, 1151)
    manifest_fp = mix(manifest_fp, 56035538, 1151)
    manifest_fp = mix(manifest_fp, 296443716, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 888484153 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 119, 1871)
    result_fp = mix(result_fp, 123, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 111, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 327264317 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 119, 1907)
    family_fp = mix(family_fp, 123, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 106, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 668745767 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 119, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 100654283 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 119, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 576074392 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 119, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
