//@ run-pass

fn main() -> i32 with IO, Epistemic {
    let k0 = measure(2.0, uncertainty: 0.1)
    let k1 = measure(3.0, uncertainty: 0.1)
    let k2 = measure(5.0, uncertainty: 0.1)
    let k3 = measure(7.0, uncertainty: 0.1)

    // y = k0 * k1 + k2 * k3
    let y = k0.value * k1.value + k2.value * k3.value

    // ∂y/∂k0 = k1 = 3.0
    let s0 = sensitivity_of(y, 0)
    // ∂y/∂k1 = k0 = 2.0
    let s1 = sensitivity_of(y, 1)
    // ∂y/∂k2 = k3 = 7.0
    let s2 = sensitivity_of(y, 2)
    // ∂y/∂k3 = k2 = 5.0
    let s3 = sensitivity_of(y, 3)

    assert(s0 > 2.99 && s0 < 3.01)
    assert(s1 > 1.99 && s1 < 2.01)
    assert(s2 > 6.99 && s2 < 7.01)
    assert(s3 > 4.99 && s3 < 5.01)
    0
}
