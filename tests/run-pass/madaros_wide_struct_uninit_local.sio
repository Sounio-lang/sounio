//@ run-pass
// Regression for struct_layout_slot_count's stale 64-slot reject threshold
// (self-hosted/ir/lower.sio, fixed alongside a74aa956a3's uninitialized-struct-
// local allocation fix -- PR #2667 review, comment 4104342929). The struct
// layout registry supports up to 128 fields, but struct_layout_slot_count used
// to reject (return -1) anything past 64 slots, so a struct with 65-128 fields
// was silently treated as "not a registered struct type" by the uninitialized-
// struct-local allocation check -- meaning `var x: WideStruct` (no initializer)
// for a 70-field struct like this one still fell through to the generic no-init
// path (bare handle 0) and SIGSEGV'd on the first field write, exactly the bug
// a74aa956a3 was supposed to have closed.
//@ requires: madaros
//@ expect-stdout: 2415

struct WideStruct70 {
    f0: i64,
    f1: i64,
    f2: i64,
    f3: i64,
    f4: i64,
    f5: i64,
    f6: i64,
    f7: i64,
    f8: i64,
