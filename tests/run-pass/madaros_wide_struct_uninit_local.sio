    sum = sum + w.f55
    sum = sum + w.f56
    sum = sum + w.f57
    sum = sum + w.f58
    sum = sum + w.f59
    sum = sum + w.f60
    sum = sum + w.f61
    sum = sum + w.f62
    sum = sum + w.f63
