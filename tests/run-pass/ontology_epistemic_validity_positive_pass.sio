//@ requires: madaros
//@ expect-stdout: validity covariance OK
// Positive witness: ChEBI_0036060 is a subclass of CHEBI_15377,
// and the provided validity duration (60s) satisfies the required duration (30s).
// Subclassing + sufficient validity MUST SUCCEED.

ontology ChemicalOntology {
    class Chemical
    class CHEBI_25806 subclass_of Chemical
    class CHEBI_15377 subclass_of CHEBI_25806
    class ChEBI_0036060 subclass_of CHEBI_15377
}

fn require_stable_water(
    w: Knowledge[CHEBI_15377, Valid(30.0), Derived]
) -> i32 {
    1
}

fn test_validity_positive(fresh_water: Knowledge[ChEBI_0036060, Valid(60.0), Derived]) -> i32 {
    require_stable_water(fresh_water)
}

fn main() -> i32 {
    print("validity covariance OK\n")
    0
}
