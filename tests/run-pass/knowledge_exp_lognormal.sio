//@ run-pass
//@ requires: madaros
//@ expect-stdout: EXP_LOGNORMAL_OK
// exp of an affine gaussian exponent uses the lognormal moments.
// exp of a curved exponent stays on the tangent. sin stays on its derivative.
// The clock is the closed form written here. It does not call variance_of.

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let z0: f64 = 0.0
    let z: Knowledge<f64> = measure(z0, uncertainty: 0.5)
    let x: f64 = z.value
    let v = variance_of(exp(x))
    let m = second_order_mean(exp(x))
    let sv = 0.25
    let mean_form = exp(0.5 * sv)
    let var_form = exp(sv) * (exp(sv) - 1.0)
    let a0: f64 = 0.5
    let a: Knowledge<f64> = measure(a0, uncertainty: 0.1)
    let y: f64 = a.value
    let curved = variance_of(exp(y * y))
    let u = y * y
    let slope = exp(u) * (2.0 * y)
    let delta = slope * slope * 0.01
    let s0: f64 = 0.0
    let s: Knowledge<f64> = measure(s0, uncertainty: 0.1)
    let w: f64 = s.value
    let vs = variance_of(sin(w))
    print("var ")
    print_f64(v)
    print(" mean ")
    print_f64(m)
    print(" curved ")
    print_f64(curved)
    print(" sin ")
    print_f64(vs)
    print("\n")
    if near(v, var_form, 0.0001) && near(m, mean_form, 0.0001) && near(curved, delta, 0.0001) && near(vs, 0.01, 0.0001) && v > 0.3 {
        println("EXP_LOGNORMAL_OK")
        return 0
    }
    println("EXP_LOGNORMAL_FAIL")
    1
}
