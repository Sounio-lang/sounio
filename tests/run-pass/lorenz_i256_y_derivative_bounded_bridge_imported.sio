//@ run-pass
//@ description: Imported Lorenz i256 bounded x*(rho-z)-y derivative bridge smoke

use systems::lorenz_i256_scaled_product_bridge::*
use systems::lorenz_i256_signed_delta_bridge::*
use systems::lorenz_i256_y_derivative_bounded_bridge::*

fn main() -> i64 with Div {
    let positive = lorenz_i256_y_derivative_bounded_check(
        500000000, 1, 0, 0, 0, 26, 0, 0, 0, 1, 0, 0, 1, 0, 2, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_y_derivative_bounded_check(
        500000000, 0, 0, 0, 0, 27, 0, 0, 0, 1, 0, 0, 0 - 1, 500000000, 0, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_y_derivative_bounded_check(
        500000000, 0, 0, 0, 0, 27, 0, 0, 500000000, 0, 0, 0, 0, 0, 0, 0, 0)
    if zero != 1 { return 3 }

    let z_gt_rho = lorenz_i256_x_rho_minus_z_product_limb(
        500000000, 0, 0, 0, 0, 29, 0, 0, 0)
    if z_gt_rho != 0 - 1 { return 4 }

    let inexact = lorenz_i256_x_rho_minus_z_product_limb(
        333333333, 0, 0, 0, 666666667, 27, 0, 0, 0)
    if inexact != 0 - 1 { return 5 }

    let product_anchor = lorenz_i256_scaled_product_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 109)
    if product_anchor != 920174638 { return 6 }

    let product_audit = lorenz_i256_scaled_product_bridge_audit_fingerprint(
        product_anchor, 703918426, 268540197, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 109, 1023)
    if product_audit != 481036275 { return 7 }

    let delta_anchor = lorenz_i256_signed_delta_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 104)
    if delta_anchor != 492681735 { return 8 }

    let delta_audit = lorenz_i256_signed_delta_bridge_audit_fingerprint(
        delta_anchor, 604913728, 195740286, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 104, 1023)
    if delta_audit != 837260419 { return 9 }

    let artifact = lorenz_i256_y_derivative_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 110)
    if artifact != 742619083 { return 10 }

    let audit = lorenz_i256_y_derivative_bounded_bridge_audit_fingerprint(
        artifact, 815204637, 204973856, product_anchor, product_audit,
        delta_anchor, delta_audit, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 110, 1023)
    if audit != 396508712 { return 11 }
    return 0
}
