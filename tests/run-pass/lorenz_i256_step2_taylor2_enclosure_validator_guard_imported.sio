//@ description: Imported Lorenz i256 step-2 Taylor-2 enclosure validator guard checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step2_taylor2_enclosure_validator_guard_check(
        424013491, 725374434, 443171640, 444092349,
        84000, 308000, 22000, 83731, 307457, 21872, 7, 0, 0, 8, 0)
    if artifact_fp != 702220657 { return 1 }
    let audit_fp = lorenz_i256_step2_taylor2_enclosure_validator_guard_audit_fingerprint(
        artifact_fp, 672898502, 487522414, 424013491, 409402480,
        725374434, 443171640, 444092349, 2, 8, 255, 0, 0)
    if audit_fp != 270117363 { return 2 }
    return 0
}
