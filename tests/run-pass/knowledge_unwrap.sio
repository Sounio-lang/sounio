//@ run-pass
//@ expect-stdout-contains: knowledge_unwrap: PASS
// Explicit extraction from Knowledge[T] requires a reason string.

fn main() with IO, Epistemic {
    let k = Knowledge { value: 42.0 }
    let x: f64 = k.unwrap("accepted for demo")

    if x == 42.0 {
        print("knowledge_unwrap: PASS\n")
    } else {
        print("knowledge_unwrap: FAIL\n")
    }
}

