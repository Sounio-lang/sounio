//@ run-pass
//@ check-only
//@ requires: madaros
//@ description: A closure may consume its captured linear value exactly once

linear struct Permit {
    level: i32,
}

fn consume(p: Permit) -> i32 {
    p.level
}

fn main() -> i32 {
    let permit = Permit { level: 5 }
    let captured = || consume(permit)
    captured()
}
