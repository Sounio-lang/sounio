//@ run-pass
// Symbolic Differentiation Test Suite
//
// Tests arena-based expression trees with symbolic differentiation,
// evaluation, simplification, and comparison against numerical derivatives.
//
// Self-contained: all functions inlined (tests cannot import).
//
// References:
//   Griewank & Walther, "Evaluating Derivatives" (2nd ed., SIAM, 2008)

// ============================================================================
// MATH HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

fn floor_f64(x: f64) -> f64 with Mut, Panic, Div {
    let i = x as i32
    let f = i as f64
    if x < 0.0 && f != x { return f - 1.0 }
    return f
}

fn sin_f64(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    let two_pi = 6.283185307179586
    var t = x - floor_f64(x / two_pi) * two_pi
    if t > pi { t = t - two_pi }
    if t < 0.0 - pi { t = t + two_pi }
    var sum = t
    var term = t
    var n = 1
    while n <= 15 {
        term = 0.0 - term * t * t / (((2 * n) as f64) * ((2 * n + 1) as f64))
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn cos_f64(x: f64) -> f64 with Mut, Panic, Div {
    return sin_f64(x + 1.5707963267948966)
}

fn exp_f64(x: f64) -> f64 with Mut, Panic, Div {
    let ln2 = 0.6931471805599453
    let k_f = floor_f64(x / ln2 + 0.5)
    let k = k_f as i32
    let r = x - k_f * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 20 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k > 0 {
        var j = 0
        while j < k { result = result * 2.0; j = j + 1 }
    } else if k < 0 {
        var j = 0
        let neg_k = 0 - k
        while j < neg_k { result = result / 2.0; j = j + 1 }
    }
    return result
}

fn ln_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    var val = x
    var k = 0.0
    let e = 2.718281828459045
    while val > e {
        val = val / e
        k = k + 1.0
    }
    while val < 1.0 / e {
        val = val * e
        k = k - 1.0
    }
    let u = (val - 1.0) / (val + 1.0)
    let u2 = u * u
    var sum = u
    var term = u
    term = term * u2
    sum = sum + term / 3.0
    term = term * u2
    sum = sum + term / 5.0
    term = term * u2
    sum = sum + term / 7.0
    term = term * u2
    sum = sum + term / 9.0
    term = term * u2
    sum = sum + term / 11.0
    term = term * u2
    sum = sum + term / 13.0
    term = term * u2
    sum = sum + term / 15.0
    term = term * u2
    sum = sum + term / 17.0
    term = term * u2
    sum = sum + term / 19.0
    return 2.0 * sum + k
}

fn pow_f64(x: f64, n: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    return exp_f64(n * ln_f64(x))
}

// ============================================================================
// EXPRESSION ARENA
// ============================================================================

struct ExprArena {
    node_types: [i64; 64],
    values: [f64; 64],
    left: [i64; 64],
    right: [i64; 64],
    count: i64,
}

// Global arena — ExprResult { arena, idx } returns are zeroed by codegen
var SYMA: ExprArena = ExprArena {
    node_types: [0; 64],
    values: [0.0; 64],
    left: [-1; 64],
    right: [-1; 64],
    count: 0,
}

fn sym_reset() with Mut, Panic {
    SYMA = ExprArena {
        node_types: [0; 64],
        values: [0.0; 64],
        left: [-1; 64],
        right: [-1; 64],
        count: 0,
    }
}

// ============================================================================
// NODE CONSTRUCTORS (mutate SYMA, return node index only)
// ============================================================================

fn expr_const(value: f64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 0
    SYMA.values[idx] = value
    SYMA.left[idx] = -1
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

fn expr_var(var_idx: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 1
    SYMA.values[idx] = var_idx as f64
    SYMA.left[idx] = -1
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

fn expr_add(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 2
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = l
    SYMA.right[idx] = r
    SYMA.count = idx + 1
    return idx
}

fn expr_sub(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 3
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = l
    SYMA.right[idx] = r
    SYMA.count = idx + 1
    return idx
}

fn expr_mul(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 4
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = l
    SYMA.right[idx] = r
    SYMA.count = idx + 1
    return idx
}

fn expr_div(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 5
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = l
    SYMA.right[idx] = r
    SYMA.count = idx + 1
    return idx
}

fn expr_neg(child: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 6
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = child
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

fn expr_sin(child: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 7
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = child
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

fn expr_cos(child: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 8
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = child
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

fn expr_exp(child: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 9
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = child
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

fn expr_log(child: i64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 10
    SYMA.values[idx] = 0.0
    SYMA.left[idx] = child
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

fn expr_pow(child: i64, exponent: f64) -> i64 with Mut, Panic {
    let idx = SYMA.count
    SYMA.node_types[idx] = 11
    SYMA.values[idx] = exponent
    SYMA.left[idx] = child
    SYMA.right[idx] = -1
    SYMA.count = idx + 1
    return idx
}

// ============================================================================
// EVALUATION
// ============================================================================

fn expr_eval(node_idx: i64, vars: [f64; 16]) -> f64 with Mut, Panic, Div {
    let ntype = SYMA.node_types[node_idx]

    if ntype == 0 { return SYMA.values[node_idx] }
    if ntype == 1 {
        let vi = SYMA.values[node_idx] as i64
        return vars[vi]
    }

    let l = SYMA.left[node_idx]
    let r = SYMA.right[node_idx]

    if ntype == 2 {
        return expr_eval(l, vars) + expr_eval(r, vars)
    }
    if ntype == 3 {
        return expr_eval(l, vars) - expr_eval(r, vars)
    }
    if ntype == 4 {
        return expr_eval(l, vars) * expr_eval(r, vars)
    }
    if ntype == 5 {
        return expr_eval(l, vars) / expr_eval(r, vars)
    }
    if ntype == 6 {
        return 0.0 - expr_eval(l, vars)
    }
    if ntype == 7 {
        return sin_f64(expr_eval(l, vars))
    }
    if ntype == 8 {
        return cos_f64(expr_eval(l, vars))
    }
    if ntype == 9 {
        return exp_f64(expr_eval(l, vars))
    }
    if ntype == 10 {
        return ln_f64(expr_eval(l, vars))
    }
    if ntype == 11 {
        let base = expr_eval(l, vars)
        let exp = SYMA.values[node_idx]
        return pow_f64(base, exp)
    }
    return 0.0
}

// ============================================================================
// SYMBOLIC DIFFERENTIATION
// ============================================================================

fn expr_diff(node_idx: i64, var_idx: i64) -> i64 with Mut, Panic, Div {
    let ntype = SYMA.node_types[node_idx]

    // Const: d/dx(c) = 0
    if ntype == 0 {
        return expr_const(0.0)
    }

    // Var: d/dx(x) = 1 if same variable, else 0
    if ntype == 1 {
        let vi = SYMA.values[node_idx] as i64
        if vi == var_idx {
            return expr_const(1.0)
        }
        return expr_const(0.0)
    }

    // Add: d/dx(f+g) = df/dx + dg/dx
    if ntype == 2 {
        let l = SYMA.left[node_idx]
        let r = SYMA.right[node_idx]
        let dl = expr_diff(l, var_idx)
        let dr = expr_diff(r, var_idx)
        return expr_add(dl, dr)
    }

    // Sub: d/dx(f-g) = df/dx - dg/dx
    if ntype == 3 {
        let l = SYMA.left[node_idx]
        let r = SYMA.right[node_idx]
        let dl = expr_diff(l, var_idx)
        let dr = expr_diff(r, var_idx)
        return expr_sub(dl, dr)
    }

    // Mul: d/dx(f*g) = f*dg/dx + df/dx*g  (product rule)
    if ntype == 4 {
        let l = SYMA.left[node_idx]
        let r = SYMA.right[node_idx]
        let dl = expr_diff(l, var_idx)
        let dr = expr_diff(r, var_idx)
        let t1 = expr_mul(l, dr)
        let t2 = expr_mul(dl, r)
        return expr_add(t2, t1)
    }

    // Div: d/dx(f/g) = (g*df/dx - f*dg/dx) / g^2  (quotient rule)
    if ntype == 5 {
        let l = SYMA.left[node_idx]
        let r = SYMA.right[node_idx]
        let dl = expr_diff(l, var_idx)
        let dr = expr_diff(r, var_idx)
        let t1 = expr_mul(r, dl)
        let t2 = expr_mul(l, dr)
        let num = expr_sub(t1, t2)
        let g2 = expr_mul(r, r)
        return expr_div(num, g2)
    }

    // Neg: d/dx(-f) = -(df/dx)
    if ntype == 6 {
        let child = SYMA.left[node_idx]
        let dc = expr_diff(child, var_idx)
        return expr_neg(dc)
    }

    // Sin: d/dx(sin(f)) = cos(f) * df/dx
    if ntype == 7 {
        let child = SYMA.left[node_idx]
        let dc = expr_diff(child, var_idx)
        let cos_f = expr_cos(child)
        return expr_mul(cos_f, dc)
    }

    // Cos: d/dx(cos(f)) = -sin(f) * df/dx
    if ntype == 8 {
        let child = SYMA.left[node_idx]
        let dc = expr_diff(child, var_idx)
        let sin_f = expr_sin(child)
        let neg_sin = expr_neg(sin_f)
        return expr_mul(neg_sin, dc)
    }

    // Exp: d/dx(exp(f)) = exp(f) * df/dx
    if ntype == 9 {
        let child = SYMA.left[node_idx]
        let dc = expr_diff(child, var_idx)
        return expr_mul(node_idx, dc)
    }

    // Log: d/dx(ln(f)) = (1/f) * df/dx
    if ntype == 10 {
        let child = SYMA.left[node_idx]
        let dc = expr_diff(child, var_idx)
        let one = expr_const(1.0)
        let inv_f = expr_div(one, child)
        return expr_mul(inv_f, dc)
    }

    // Pow: d/dx(f^n) = n * f^(n-1) * df/dx
    if ntype == 11 {
        let child = SYMA.left[node_idx]
        let n = SYMA.values[node_idx]
        let dc = expr_diff(child, var_idx)
        let n_const = expr_const(n)
        let pow_nm1 = expr_pow(child, n - 1.0)
        let n_times_pow = expr_mul(n_const, pow_nm1)
        return expr_mul(n_times_pow, dc)
    }

    return expr_const(0.0)
}

// ============================================================================
// SIMPLIFICATION
// ============================================================================

fn is_const_zero(idx: i64) -> bool {
    SYMA.node_types[idx] == 0 && SYMA.values[idx] == 0.0
}

fn is_const_one(idx: i64) -> bool {
    SYMA.node_types[idx] == 0 && SYMA.values[idx] == 1.0
}

fn expr_simplify(node_idx: i64) -> i64 with Mut, Panic, Div {
    let ntype = SYMA.node_types[node_idx]

    if ntype == 0 { return node_idx }
    if ntype == 1 { return node_idx }

    let l = SYMA.left[node_idx]
    let r = SYMA.right[node_idx]

    if ntype == 2 {
        if SYMA.node_types[l] == 0 && SYMA.node_types[r] == 0 {
            return expr_const(SYMA.values[l] + SYMA.values[r])
        }
        if is_const_zero(l) { return r }
        if is_const_zero(r) { return l }
        return node_idx
    }
    if ntype == 3 {
        if SYMA.node_types[l] == 0 && SYMA.node_types[r] == 0 {
            return expr_const(SYMA.values[l] - SYMA.values[r])
        }
        if is_const_zero(r) { return l }
        return node_idx
    }
    if ntype == 4 {
        if SYMA.node_types[l] == 0 && SYMA.node_types[r] == 0 {
            return expr_const(SYMA.values[l] * SYMA.values[r])
        }
        if is_const_zero(l) { return expr_const(0.0) }
        if is_const_zero(r) { return expr_const(0.0) }
        if is_const_one(l) { return r }
        if is_const_one(r) { return l }
        return node_idx
    }
    if ntype == 5 {
        if SYMA.node_types[l] == 0 && SYMA.node_types[r] == 0 && SYMA.values[r] != 0.0 {
            return expr_const(SYMA.values[l] / SYMA.values[r])
        }
        if is_const_zero(l) { return expr_const(0.0) }
        if is_const_one(r) { return l }
        return node_idx
    }
    if ntype == 6 {
        if SYMA.node_types[l] == 0 {
            return expr_const(0.0 - SYMA.values[l])
        }
        return node_idx
    }

    return node_idx
}

// ============================================================================
// EXPRESSION PRINTING
// ============================================================================

fn expr_print(node_idx: i64) with IO, Mut, Panic, Div {
    let ntype = SYMA.node_types[node_idx]

    if ntype == 0 {
        print(SYMA.values[node_idx])
        return
    }
    if ntype == 1 {
        let vi = SYMA.values[node_idx] as i64
        if vi == 0 { print("x") }
        else if vi == 1 { print("y") }
        else if vi == 2 { print("z") }
        else { print("v"); print(vi) }
        return
    }
    if ntype == 2 {
        print("(")
        expr_print(SYMA.left[node_idx])
        print(" + ")
        expr_print(SYMA.right[node_idx])
        print(")")
        return
    }
    if ntype == 3 {
        print("(")
        expr_print(SYMA.left[node_idx])
        print(" - ")
        expr_print(SYMA.right[node_idx])
        print(")")
        return
    }
    if ntype == 4 {
        print("(")
        expr_print(SYMA.left[node_idx])
        print(" * ")
        expr_print(SYMA.right[node_idx])
        print(")")
        return
    }
    if ntype == 5 {
        print("(")
        expr_print(SYMA.left[node_idx])
        print(" / ")
        expr_print(SYMA.right[node_idx])
        print(")")
        return
    }
    if ntype == 6 {
        print("(-")
        expr_print(SYMA.left[node_idx])
        print(")")
        return
    }
    if ntype == 7 {
        print("sin(")
        expr_print(SYMA.left[node_idx])
        print(")")
        return
    }
    if ntype == 8 {
        print("cos(")
        expr_print(SYMA.left[node_idx])
        print(")")
        return
    }
    if ntype == 9 {
        print("exp(")
        expr_print(SYMA.left[node_idx])
        print(")")
        return
    }
    if ntype == 10 {
        print("ln(")
        expr_print(SYMA.left[node_idx])
        print(")")
        return
    }
    if ntype == 11 {
        print("(")
        expr_print(SYMA.left[node_idx])
        print("^")
        print(SYMA.values[node_idx])
        print(")")
        return
    }
    print("?")
}

// ============================================================================
// TESTS
// ============================================================================

// T1: d/dx(x^2) = 2*x, evaluate at x=3 -> 6
fn test_power_rule() -> bool with IO, Mut, Panic, Div {
    sym_reset()
    let vx = expr_var(0)
    let xsq = expr_pow(vx, 2.0)
    let d = expr_diff(xsq, 0)
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 3.0
    let result = expr_eval(d, vars)
    let expected = 6.0
    let tol = 1.0e-6
    print("  d/dx(x^2) at x=3 = ")
    println(result)
    return approx_eq(result, expected, tol)
}

// T2: d/dx(sin(x)) = cos(x), evaluate at x=0 -> 1
fn test_sin_derivative() -> bool with IO, Mut, Panic, Div {
    sym_reset()
    let vx = expr_var(0)
    let sinx = expr_sin(vx)
    let d = expr_diff(sinx, 0)
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 0.0
    let result = expr_eval(d, vars)
    let expected = 1.0
    let tol = 1.0e-6
    print("  d/dx(sin(x)) at x=0 = ")
    println(result)
    return approx_eq(result, expected, tol)
}

// T3: d/dx(x*y) with respect to x = y, evaluate at (x=2, y=5) -> 5
fn test_partial_derivative() -> bool with IO, Mut, Panic, Div {
    sym_reset()
    let vx = expr_var(0)
    let vy = expr_var(1)
    let xy = expr_mul(vx, vy)
    let d = expr_diff(xy, 0)
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 2.0
    vars[1] = 5.0
    let result = expr_eval(d, vars)
    let expected = 5.0
    let tol = 1.0e-6
    print("  d/dx(x*y) at (2,5) = ")
    println(result)
    return approx_eq(result, expected, tol)
}

// T4: Product rule: d/dx(x^2 * exp(x)) at x=1
fn test_product_rule() -> bool with IO, Mut, Panic, Div {
    sym_reset()
    let vx = expr_var(0)
    let xsq = expr_pow(vx, 2.0)
    let expx = expr_exp(vx)
    let product = expr_mul(xsq, expx)
    let d = expr_diff(product, 0)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 1.0
    let symbolic_deriv = expr_eval(d, vars)

    let h = 1.0e-7
    var vars_plus: [f64; 16] = [0.0; 16]
    vars_plus[0] = 1.0 + h
    var vars_minus: [f64; 16] = [0.0; 16]
    vars_minus[0] = 1.0 - h
    let f_plus = expr_eval(product, vars_plus)
    let f_minus = expr_eval(product, vars_minus)
    let numerical_deriv = (f_plus - f_minus) / (2.0 * h)

    let tol = 1.0e-4
    print("  d/dx(x^2*exp(x)) at x=1: symbolic=")
    print(symbolic_deriv)
    print(" numerical=")
    println(numerical_deriv)
    return approx_eq(symbolic_deriv, numerical_deriv, tol)
}

// T5: Constant folding: 2+3 simplifies to 5
fn test_constant_folding() -> bool with IO, Mut, Panic, Div {
    sym_reset()
    let c2 = expr_const(2.0)
    let c3 = expr_const(3.0)
    let sum = expr_add(c2, c3)
    let simplified = expr_simplify(sum)
    let is_const = SYMA.node_types[simplified] == 0
    let val = SYMA.values[simplified]
    print("  simplify(2+3): type=")
    print(SYMA.node_types[simplified])
    print(" value=")
    println(val)
    return is_const && approx_eq(val, 5.0, 1.0e-10)
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i64 with IO, Mut, Panic, Div {
    println("=== Symbolic Differentiation Tests ===")
    println("")

    var passed = 0
    var failed = 0

    print("T1: d/dx(x^2) = 2x at x=3 -> 6... ")
    if test_power_rule() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T2: d/dx(sin(x)) = cos(x) at x=0.. ")
    if test_sin_derivative() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T3: d/dx(x*y) = y at (2,5) -> 5... ")
    if test_partial_derivative() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T4: product rule x^2*exp(x)........ ")
    if test_product_rule() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T5: constant folding 2+3 = 5....... ")
    if test_constant_folding() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 5 TESTS PASSED")
    return 0
}
