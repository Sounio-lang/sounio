//@ run-pass
// Symbolic Differentiation Test Suite
//
// Tests arena-based expression trees with symbolic differentiation,
// evaluation, simplification, and comparison against numerical derivatives.
//
// Self-contained: all functions inlined (tests cannot import).
//
// References:
//   Griewank & Walther, "Evaluating Derivatives" (2nd ed., SIAM, 2008)

// ============================================================================
// MATH HELPERS
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    abs_f64(a - b) < tol
}

fn floor_f64(x: f64) -> f64 with Mut, Panic, Div {
    let i = x as i32
    let f = i as f64
    if x < 0.0 && f != x { return f - 1.0 }
    return f
}

fn sin_f64(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    let two_pi = 6.283185307179586
    var t = x - floor_f64(x / two_pi) * two_pi
    if t > pi { t = t - two_pi }
    if t < 0.0 - pi { t = t + two_pi }
    var sum = t
    var term = t
    var n = 1
    while n <= 15 {
        term = 0.0 - term * t * t / (((2 * n) as f64) * ((2 * n + 1) as f64))
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn cos_f64(x: f64) -> f64 with Mut, Panic, Div {
    return sin_f64(x + 1.5707963267948966)
}

fn exp_f64(x: f64) -> f64 with Mut, Panic, Div {
    let ln2 = 0.6931471805599453
    let k_f = floor_f64(x / ln2 + 0.5)
    let k = k_f as i32
    let r = x - k_f * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 20 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k > 0 {
        var j = 0
        while j < k { result = result * 2.0; j = j + 1 }
    } else if k < 0 {
        var j = 0
        let neg_k = 0 - k
        while j < neg_k { result = result / 2.0; j = j + 1 }
    }
    return result
}

fn ln_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 - 1000000.0 }
    var val = x
    var k = 0.0
    let e = 2.718281828459045
    while val > e {
        val = val / e
        k = k + 1.0
    }
    while val < 1.0 / e {
        val = val * e
        k = k - 1.0
    }
    let u = (val - 1.0) / (val + 1.0)
    let u2 = u * u
    var sum = u
    var term = u
    term = term * u2
    sum = sum + term / 3.0
    term = term * u2
    sum = sum + term / 5.0
    term = term * u2
    sum = sum + term / 7.0
    term = term * u2
    sum = sum + term / 9.0
    term = term * u2
    sum = sum + term / 11.0
    term = term * u2
    sum = sum + term / 13.0
    term = term * u2
    sum = sum + term / 15.0
    term = term * u2
    sum = sum + term / 17.0
    term = term * u2
    sum = sum + term / 19.0
    return 2.0 * sum + k
}

fn pow_f64(x: f64, n: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    return exp_f64(n * ln_f64(x))
}

// ============================================================================
// EXPRESSION ARENA
// ============================================================================

struct ExprArena {
    node_types: [i64; 64],
    values: [f64; 64],
    left: [i64; 64],
    right: [i64; 64],
    count: i64,
}

struct ExprResult {
    arena: ExprArena,
    idx: i64,
}

fn expr_arena_new() -> ExprArena with Mut, Panic {
    ExprArena {
        node_types: [0; 64],
        values: [0.0; 64],
        left: [-1; 64],
        right: [-1; 64],
        count: 0,
    }
}

// ============================================================================
// NODE CONSTRUCTORS
// ============================================================================

fn expr_const(arena: ExprArena, value: f64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 0
    a.values[idx] = value
    a.left[idx] = -1
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_var(arena: ExprArena, var_idx: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 1
    a.values[idx] = var_idx as f64
    a.left[idx] = -1
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_add(arena: ExprArena, l: i64, r: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 2
    a.values[idx] = 0.0
    a.left[idx] = l
    a.right[idx] = r
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_sub(arena: ExprArena, l: i64, r: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 3
    a.values[idx] = 0.0
    a.left[idx] = l
    a.right[idx] = r
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_mul(arena: ExprArena, l: i64, r: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 4
    a.values[idx] = 0.0
    a.left[idx] = l
    a.right[idx] = r
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_div(arena: ExprArena, l: i64, r: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 5
    a.values[idx] = 0.0
    a.left[idx] = l
    a.right[idx] = r
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_neg(arena: ExprArena, child: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 6
    a.values[idx] = 0.0
    a.left[idx] = child
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_sin(arena: ExprArena, child: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 7
    a.values[idx] = 0.0
    a.left[idx] = child
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_cos(arena: ExprArena, child: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 8
    a.values[idx] = 0.0
    a.left[idx] = child
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_exp(arena: ExprArena, child: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 9
    a.values[idx] = 0.0
    a.left[idx] = child
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_log(arena: ExprArena, child: i64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 10
    a.values[idx] = 0.0
    a.left[idx] = child
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

fn expr_pow(arena: ExprArena, child: i64, exponent: f64) -> ExprResult with Mut, Panic {
    var a = arena
    let idx = a.count
    a.node_types[idx] = 11
    a.values[idx] = exponent
    a.left[idx] = child
    a.right[idx] = -1
    a.count = idx + 1
    ExprResult { arena: a, idx: idx }
}

// ============================================================================
// EVALUATION
// ============================================================================

fn expr_eval(arena: ExprArena, node_idx: i64, vars: [f64; 16]) -> f64 with Mut, Panic, Div {
    let ntype = arena.node_types[node_idx]

    if ntype == 0 { return arena.values[node_idx] }
    if ntype == 1 {
        let vi = arena.values[node_idx] as i64
        return vars[vi]
    }

    let l = arena.left[node_idx]
    let r = arena.right[node_idx]

    if ntype == 2 {
        return expr_eval(arena, l, vars) + expr_eval(arena, r, vars)
    }
    if ntype == 3 {
        return expr_eval(arena, l, vars) - expr_eval(arena, r, vars)
    }
    if ntype == 4 {
        return expr_eval(arena, l, vars) * expr_eval(arena, r, vars)
    }
    if ntype == 5 {
        return expr_eval(arena, l, vars) / expr_eval(arena, r, vars)
    }
    if ntype == 6 {
        return 0.0 - expr_eval(arena, l, vars)
    }
    if ntype == 7 {
        return sin_f64(expr_eval(arena, l, vars))
    }
    if ntype == 8 {
        return cos_f64(expr_eval(arena, l, vars))
    }
    if ntype == 9 {
        return exp_f64(expr_eval(arena, l, vars))
    }
    if ntype == 10 {
        return ln_f64(expr_eval(arena, l, vars))
    }
    if ntype == 11 {
        let base = expr_eval(arena, l, vars)
        let exp = arena.values[node_idx]
        return pow_f64(base, exp)
    }
    return 0.0
}

// ============================================================================
// SYMBOLIC DIFFERENTIATION
// ============================================================================

fn expr_diff(arena: ExprArena, node_idx: i64, var_idx: i64) -> ExprResult with Mut, Panic, Div {
    let ntype = arena.node_types[node_idx]

    // Const: d/dx(c) = 0
    if ntype == 0 {
        return expr_const(arena, 0.0)
    }

    // Var: d/dx(x) = 1 if same variable, else 0
    if ntype == 1 {
        let vi = arena.values[node_idx] as i64
        if vi == var_idx {
            return expr_const(arena, 1.0)
        }
        return expr_const(arena, 0.0)
    }

    // Add: d/dx(f+g) = df/dx + dg/dx
    if ntype == 2 {
        let l = arena.left[node_idx]
        let r = arena.right[node_idx]
        let dl = expr_diff(arena, l, var_idx)
        let dr = expr_diff(dl.arena, r, var_idx)
        return expr_add(dr.arena, dl.idx, dr.idx)
    }

    // Sub: d/dx(f-g) = df/dx - dg/dx
    if ntype == 3 {
        let l = arena.left[node_idx]
        let r = arena.right[node_idx]
        let dl = expr_diff(arena, l, var_idx)
        let dr = expr_diff(dl.arena, r, var_idx)
        return expr_sub(dr.arena, dl.idx, dr.idx)
    }

    // Mul: d/dx(f*g) = f*dg/dx + df/dx*g  (product rule)
    if ntype == 4 {
        let l = arena.left[node_idx]
        let r = arena.right[node_idx]
        let dl = expr_diff(arena, l, var_idx)
        let dr = expr_diff(dl.arena, r, var_idx)
        // f * dg/dx
        let t1 = expr_mul(dr.arena, l, dr.idx)
        // df/dx * g
        let t2 = expr_mul(t1.arena, dl.idx, r)
        // df/dx*g + f*dg/dx
        return expr_add(t2.arena, t2.idx, t1.idx)
    }

    // Div: d/dx(f/g) = (g*df/dx - f*dg/dx) / g^2  (quotient rule)
    if ntype == 5 {
        let l = arena.left[node_idx]
        let r = arena.right[node_idx]
        let dl = expr_diff(arena, l, var_idx)
        let dr = expr_diff(dl.arena, r, var_idx)
        // g * df/dx
        let t1 = expr_mul(dr.arena, r, dl.idx)
        // f * dg/dx
        let t2 = expr_mul(t1.arena, l, dr.idx)
        // numerator = g*df - f*dg
        let num = expr_sub(t2.arena, t1.idx, t2.idx)
        // g^2
        let g2 = expr_mul(num.arena, r, r)
        return expr_div(g2.arena, num.idx, g2.idx)
    }

    // Neg: d/dx(-f) = -(df/dx)
    if ntype == 6 {
        let child = arena.left[node_idx]
        let dc = expr_diff(arena, child, var_idx)
        return expr_neg(dc.arena, dc.idx)
    }

    // Sin: d/dx(sin(f)) = cos(f) * df/dx
    if ntype == 7 {
        let child = arena.left[node_idx]
        let dc = expr_diff(arena, child, var_idx)
        let cos_f = expr_cos(dc.arena, child)
        return expr_mul(cos_f.arena, cos_f.idx, dc.idx)
    }

    // Cos: d/dx(cos(f)) = -sin(f) * df/dx
    if ntype == 8 {
        let child = arena.left[node_idx]
        let dc = expr_diff(arena, child, var_idx)
        let sin_f = expr_sin(dc.arena, child)
        let neg_sin = expr_neg(sin_f.arena, sin_f.idx)
        return expr_mul(neg_sin.arena, neg_sin.idx, dc.idx)
    }

    // Exp: d/dx(exp(f)) = exp(f) * df/dx
    if ntype == 9 {
        let child = arena.left[node_idx]
        let dc = expr_diff(arena, child, var_idx)
        return expr_mul(dc.arena, node_idx, dc.idx)
    }

    // Log: d/dx(ln(f)) = (1/f) * df/dx
    if ntype == 10 {
        let child = arena.left[node_idx]
        let dc = expr_diff(arena, child, var_idx)
        let one = expr_const(dc.arena, 1.0)
        let inv_f = expr_div(one.arena, one.idx, child)
        return expr_mul(inv_f.arena, inv_f.idx, dc.idx)
    }

    // Pow: d/dx(f^n) = n * f^(n-1) * df/dx
    if ntype == 11 {
        let child = arena.left[node_idx]
        let n = arena.values[node_idx]
        let dc = expr_diff(arena, child, var_idx)
        let n_const = expr_const(dc.arena, n)
        let pow_nm1 = expr_pow(n_const.arena, child, n - 1.0)
        let n_times_pow = expr_mul(pow_nm1.arena, n_const.idx, pow_nm1.idx)
        return expr_mul(n_times_pow.arena, n_times_pow.idx, dc.idx)
    }

    return expr_const(arena, 0.0)
}

// ============================================================================
// SIMPLIFICATION
// ============================================================================

fn is_const_zero(arena: ExprArena, idx: i64) -> bool {
    arena.node_types[idx] == 0 && arena.values[idx] == 0.0
}

fn is_const_one(arena: ExprArena, idx: i64) -> bool {
    arena.node_types[idx] == 0 && arena.values[idx] == 1.0
}

fn expr_simplify(arena: ExprArena, node_idx: i64) -> ExprResult with Mut, Panic, Div {
    let ntype = arena.node_types[node_idx]

    if ntype == 0 { return ExprResult { arena: arena, idx: node_idx } }
    if ntype == 1 { return ExprResult { arena: arena, idx: node_idx } }

    let l = arena.left[node_idx]
    let r = arena.right[node_idx]

    if ntype == 2 {
        if arena.node_types[l] == 0 && arena.node_types[r] == 0 {
            return expr_const(arena, arena.values[l] + arena.values[r])
        }
        if is_const_zero(arena, l) { return ExprResult { arena: arena, idx: r } }
        if is_const_zero(arena, r) { return ExprResult { arena: arena, idx: l } }
        return ExprResult { arena: arena, idx: node_idx }
    }
    if ntype == 3 {
        if arena.node_types[l] == 0 && arena.node_types[r] == 0 {
            return expr_const(arena, arena.values[l] - arena.values[r])
        }
        if is_const_zero(arena, r) { return ExprResult { arena: arena, idx: l } }
        return ExprResult { arena: arena, idx: node_idx }
    }
    if ntype == 4 {
        if arena.node_types[l] == 0 && arena.node_types[r] == 0 {
            return expr_const(arena, arena.values[l] * arena.values[r])
        }
        if is_const_zero(arena, l) { return expr_const(arena, 0.0) }
        if is_const_zero(arena, r) { return expr_const(arena, 0.0) }
        if is_const_one(arena, l) { return ExprResult { arena: arena, idx: r } }
        if is_const_one(arena, r) { return ExprResult { arena: arena, idx: l } }
        return ExprResult { arena: arena, idx: node_idx }
    }
    if ntype == 5 {
        if arena.node_types[l] == 0 && arena.node_types[r] == 0 && arena.values[r] != 0.0 {
            return expr_const(arena, arena.values[l] / arena.values[r])
        }
        if is_const_zero(arena, l) { return expr_const(arena, 0.0) }
        if is_const_one(arena, r) { return ExprResult { arena: arena, idx: l } }
        return ExprResult { arena: arena, idx: node_idx }
    }
    if ntype == 6 {
        if arena.node_types[l] == 0 {
            return expr_const(arena, 0.0 - arena.values[l])
        }
        return ExprResult { arena: arena, idx: node_idx }
    }

    return ExprResult { arena: arena, idx: node_idx }
}

// ============================================================================
// EXPRESSION PRINTING
// ============================================================================

fn expr_print(arena: ExprArena, node_idx: i64) -> ExprArena with IO, Mut, Panic, Div {
    let ntype = arena.node_types[node_idx]

    if ntype == 0 {
        print(arena.values[node_idx])
        return arena
    }
    if ntype == 1 {
        let vi = arena.values[node_idx] as i64
        if vi == 0 { print("x") }
        else if vi == 1 { print("y") }
        else if vi == 2 { print("z") }
        else { print("v"); print(vi) }
        return arena
    }
    if ntype == 2 {
        print("(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(" + ")
        let a3 = expr_print(a2, arena.right[node_idx])
        print(")")
        return a3
    }
    if ntype == 3 {
        print("(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(" - ")
        let a3 = expr_print(a2, arena.right[node_idx])
        print(")")
        return a3
    }
    if ntype == 4 {
        print("(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(" * ")
        let a3 = expr_print(a2, arena.right[node_idx])
        print(")")
        return a3
    }
    if ntype == 5 {
        print("(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(" / ")
        let a3 = expr_print(a2, arena.right[node_idx])
        print(")")
        return a3
    }
    if ntype == 6 {
        print("(-")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(")")
        return a2
    }
    if ntype == 7 {
        print("sin(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(")")
        return a2
    }
    if ntype == 8 {
        print("cos(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(")")
        return a2
    }
    if ntype == 9 {
        print("exp(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(")")
        return a2
    }
    if ntype == 10 {
        print("ln(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print(")")
        return a2
    }
    if ntype == 11 {
        print("(")
        let a2 = expr_print(arena, arena.left[node_idx])
        print("^")
        print(arena.values[node_idx])
        print(")")
        return a2
    }
    print("?")
    return arena
}

// ============================================================================
// TESTS
// ============================================================================

// T1: d/dx(x^2) = 2*x, evaluate at x=3 -> 6
fn test_power_rule() -> bool with IO, Mut, Panic, Div {
    var arena = expr_arena_new()
    // Build x^2
    let vx = expr_var(arena, 0)     // x = var 0
    let xsq = expr_pow(vx.arena, vx.idx, 2.0)  // x^2
    // Differentiate
    let d = expr_diff(xsq.arena, xsq.idx, 0)
    // Evaluate at x=3
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 3.0
    let result = expr_eval(d.arena, d.idx, vars)
    let expected = 6.0
    let tol = 1.0e-6
    print("  d/dx(x^2) at x=3 = ")
    println(result)
    return approx_eq(result, expected, tol)
}

// T2: d/dx(sin(x)) = cos(x), evaluate at x=0 -> 1
fn test_sin_derivative() -> bool with IO, Mut, Panic, Div {
    var arena = expr_arena_new()
    let vx = expr_var(arena, 0)
    let sinx = expr_sin(vx.arena, vx.idx)
    let d = expr_diff(sinx.arena, sinx.idx, 0)
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 0.0
    let result = expr_eval(d.arena, d.idx, vars)
    let expected = 1.0  // cos(0) = 1
    let tol = 1.0e-6
    print("  d/dx(sin(x)) at x=0 = ")
    println(result)
    return approx_eq(result, expected, tol)
}

// T3: d/dx(x*y) with respect to x = y, evaluate at (x=2, y=5) -> 5
fn test_partial_derivative() -> bool with IO, Mut, Panic, Div {
    var arena = expr_arena_new()
    let vx = expr_var(arena, 0)     // x = var 0
    let vy = expr_var(vx.arena, 1)  // y = var 1
    let xy = expr_mul(vy.arena, vx.idx, vy.idx)  // x*y
    let d = expr_diff(xy.arena, xy.idx, 0)  // d/dx(x*y) = y
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 2.0
    vars[1] = 5.0
    let result = expr_eval(d.arena, d.idx, vars)
    let expected = 5.0
    let tol = 1.0e-6
    print("  d/dx(x*y) at (2,5) = ")
    println(result)
    return approx_eq(result, expected, tol)
}

// T4: Product rule: d/dx(x^2 * exp(x)) at x=1
// f(x) = x^2 * exp(x)
// f'(x) = 2x*exp(x) + x^2*exp(x) = exp(x)*(2x + x^2)
// f'(1) = e*(2 + 1) = 3*e ~ 8.15485
// Compare to numerical derivative: (f(1+h) - f(1-h)) / (2*h)
fn test_product_rule() -> bool with IO, Mut, Panic, Div {
    var arena = expr_arena_new()
    let vx = expr_var(arena, 0)
    let xsq = expr_pow(vx.arena, vx.idx, 2.0)
    let expx = expr_exp(xsq.arena, vx.idx)
    let product = expr_mul(expx.arena, xsq.idx, expx.idx)
    let d = expr_diff(product.arena, product.idx, 0)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 1.0
    let symbolic_deriv = expr_eval(d.arena, d.idx, vars)

    // Numerical derivative for comparison
    let h = 1.0e-7
    var vars_plus: [f64; 16] = [0.0; 16]
    vars_plus[0] = 1.0 + h
    var vars_minus: [f64; 16] = [0.0; 16]
    vars_minus[0] = 1.0 - h
    let f_plus = expr_eval(product.arena, product.idx, vars_plus)
    let f_minus = expr_eval(product.arena, product.idx, vars_minus)
    let numerical_deriv = (f_plus - f_minus) / (2.0 * h)

    let tol = 1.0e-4
    print("  d/dx(x^2*exp(x)) at x=1: symbolic=")
    print(symbolic_deriv)
    print(" numerical=")
    println(numerical_deriv)
    return approx_eq(symbolic_deriv, numerical_deriv, tol)
}

// T5: Constant folding: 2+3 simplifies to 5
fn test_constant_folding() -> bool with IO, Mut, Panic, Div {
    var arena = expr_arena_new()
    let c2 = expr_const(arena, 2.0)
    let c3 = expr_const(c2.arena, 3.0)
    let sum = expr_add(c3.arena, c2.idx, c3.idx)
    let simplified = expr_simplify(sum.arena, sum.idx)
    // After simplification, the result should be a const node with value 5
    let is_const = simplified.arena.node_types[simplified.idx] == 0
    let val = simplified.arena.values[simplified.idx]
    print("  simplify(2+3): type=")
    print(simplified.arena.node_types[simplified.idx])
    print(" value=")
    println(val)
    return is_const && approx_eq(val, 5.0, 1.0e-10)
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i64 with IO, Mut, Panic, Div {
    println("=== Symbolic Differentiation Tests ===")
    println("")

    var passed = 0
    var failed = 0

    print("T1: d/dx(x^2) = 2x at x=3 -> 6... ")
    if test_power_rule() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T2: d/dx(sin(x)) = cos(x) at x=0.. ")
    if test_sin_derivative() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T3: d/dx(x*y) = y at (2,5) -> 5... ")
    if test_partial_derivative() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T4: product rule x^2*exp(x)........ ")
    if test_product_rule() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T5: constant folding 2+3 = 5....... ")
    if test_constant_folding() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 5 TESTS PASSED")
    return 0
}
