//@ run-pass
//@ requires: madaros
// Behavioral witness for an all-i64 array literal. Values must match the
// contiguous little-endian image native v2 appends to the flat rodata.
// scripts/check_const_i64_array_image.py checks that image in the ELF.
// This file does not: the committed madaros still initializes by index_set,
// and both paths have to produce 26.
fn main() -> i64 {
    let xs: [i64; 4] = [3, 5, 7, 11]
    let sum = xs[0] + xs[1] + xs[2] + xs[3]
    if sum == 26 { 0 } else { 1 }
}
