//@ requires: madaros
// Madaros-only, for the same reason as its sibling seq_f64_element_scalar_kind:
// the fix lives in the modular pipeline. The lean_single bootstrap seed has no
// reference-receiver method resolution at all -- it type-checks this file and
// then refuses to compile it with `error: unknown method` at every call through
// a reference receiver -- all five of them, `.len()`, `.count()` and `.get(i)`.
// (No line numbers here on purpose: they go stale the moment this file is
// edited, which is the failure mode scripts/ci/measured_claim_gate.sh exists
// to catch.)
// Resolving a method through a reference landed in self-hosted/check (#2413);
// the seed predates it, so the shape under test does not exist there.
//@ run-pass
//@ expect-stdout-contains: SEQ_REF_PARAM_OK
// A `&Seq<T>` parameter delivers the Seq.
//
// Seq methods are intrinsics that take the handle BY VALUE, but a `&Seq<T>`
// receiver holds the ADDRESS of the handle slot. lower.sio passed that address
// straight into __sounio_seq_get / IrArrayLen, so the callee read one
// indirection level off -- and the program still type-checked.
//
// Measured on Madaros built from e90e7307dd, Seq<i64> holding 10, 20, 30:
//   s.len()  through &Seq<i64> -> 4204832 (a static address, same every run)
//   s.get(0) through &Seq<i64> -> a stack address, different every run
//   a loop over both           -> SIGSEGV
//   the same shapes by value   -> 3, 10, 60 (correct)
//
// Reachable only since the checker began unwrapping a TyRef receiver to its
// TyNamed pointee: before that `s.len()` on a `&Seq<T>` was refused with E019.
// The type-level unwrap had no lowering-level counterpart; this pins the load.
//
// The by-value and `&Self`-field shapes are here as controls: both were always
// correct, and a fix that dereferenced them too would break them.

struct Holder { xs: Seq<i64> }

fn ref_len(s: &Seq<i64>) -> i64 with Panic, Epistemic { return s.len().unwrap("len") }
fn ref_count(s: &Seq<i64>) -> i64 with Panic, Epistemic { return s.count() }
fn ref_get0(s: &Seq<i64>) -> i64 with Panic, Epistemic { return s.get(0) }
fn ref_sum(s: &Seq<i64>) -> i64 with Panic, Epistemic {
    var t: i64 = 0
    let n: i64 = s.len().unwrap("len")
    var i: i64 = 0
    while i < n {
        t = t + s.get(i as usize)
        i = i + 1
    }
    return t
}
fn val_len(s: Seq<i64>) -> i64 with Panic, Epistemic { return s.len().unwrap("len") }
fn field_len(h: &Holder) -> i64 with Panic, Epistemic { return h.xs.len().unwrap("len") }

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var w: Seq<i64> = seq_new()
    w.push(10)
    w.push(20)
    w.push(30)

    if ref_len(&w) != 3 { print("FAIL ref_len\n"); return 1 }
    if ref_count(&w) != 3 { print("FAIL ref_count\n"); return 1 }
    if ref_get0(&w) != 10 { print("FAIL ref_get0\n"); return 1 }
    if ref_sum(&w) != 60 { print("FAIL ref_sum\n"); return 1 }

    // Controls: the two shapes that were always correct. A fix that also
    // dereferenced these would break them, so they are asserted, not assumed.
    // (The Holder is bound to a local first: a struct literal inside an `if`
    // condition does not parse.)
    let h: Holder = Holder { xs: w }
    let fl: i64 = field_len(&h)
    if fl != 3 { print("FAIL field_len\n"); return 1 }
    let vl: i64 = val_len(w)
    if vl != 3 { print("FAIL val_len\n"); return 1 }

    print("SEQ_REF_PARAM_OK\n")
    return 0
}
