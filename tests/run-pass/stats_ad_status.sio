//@ run-pass
//@ expect-stdout: STATS_AD_STATUS_PASS
use stats::anderson_darling::{anderson_darling}
use stats::order::{sort256}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 assert(anderson_darling(&x,-1).status==1)
 assert(anderson_darling(&x,257).status==1)
 assert(anderson_darling(&x,8).status==3)
 x[0]=0.0/0.0
 assert(anderson_darling(&x,8).status==2)
 assert(!sort256(&!x,8))
 x[0]=1.0e308*2.0
 assert(anderson_darling(&x,8).status==2)
 x[0]=2.0;x[1]=0.0;x[2]=1.0
 let small=anderson_darling(&x,3)
 assert(small.status==5 && small.p==0.0 && small.a2>0.18 && small.a2<0.20)
 assert(x[0]==2.0 && x[1]==0.0 && x[2]==1.0)
 var i:i32=0
 while i<256 {x[i as usize]=0.0;i=i+1}
 x[255]=1.0
 let extreme=anderson_darling(&x,256)
 assert(extreme.status==5 && extreme.has_ties && extreme.p==0.0)
 assert(extreme.a2>98.550315552 && extreme.a2<98.550315554)
 assert(extreme.a2_star>98.842420636 && extreme.a2_star<98.842420638)
 x[255]=0.0
 x[7]=1.0
 let repeated=anderson_darling(&x,8)
 assert(repeated.status==0 && repeated.has_ties && repeated.p_approximate)
 assert(repeated.p>7.88278330e-7 && repeated.p<7.88278332e-7)
 x[7]=0.0;x[19]=1.0
 let deep=anderson_darling(&x,20)
 assert(deep.status==0 && deep.p>2.84873787e-18 && deep.p<2.84873790e-18)
 assert(!sort256(&!x,257))
 println("STATS_AD_STATUS_PASS")
 0
}
