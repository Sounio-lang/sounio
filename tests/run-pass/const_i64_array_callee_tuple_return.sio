//@ run-pass
//@ requires: madaros
// Regression: an all-i64 array literal packed into a tuple is not the
// image-stamped shape, wherever the tuple comes from. The stamp covers a
// plain non-mut let whose RHS is the literal itself; every other position
// keeps the per-element store path. Both reads below must see 10 and 20.
fn make_pair() -> ([i64; 2], i64) with Mut, Panic, Div, Alloc { ([10, 20], 7) }
fn main() -> i64 with Mut, Panic, Div, Alloc {
    let (arr, scalar) = make_pair()
    let (arr2, scalar2) = ([10, 20], 7)
    if arr[0] + arr[1] == 30 && scalar == 7
        && arr2[0] + arr2[1] == 30 && scalar2 == 7 {
        0
    } else {
        1
    }
}
