//@ run-pass
//@ description: Test effects inference + sandbox codegen integration

use compiler::effects::infer::*
use compiler::effects::sandbox::*

fn main() with IO, Mut, Panic, Div {
    print("Testing effects inference...\n")
    let infer_fails = effects_infer_run_tests()
    if infer_fails == 0 {
        print("Effects inference tests: PASS\n")
    } else {
        print("Effects inference tests: FAIL\n")
    }

    print("\nTesting effects sandbox...\n")
    let sandbox_fails = effects_sandbox_run_tests()
    if sandbox_fails == 0 {
        print("Effects sandbox tests: PASS\n")
    } else {
        print("Effects sandbox tests: FAIL\n")
    }

    print("\nTesting sandbox policies...\n")
    let permissive = sandbox_policy_permissive()
    let mask_permissive = policy_to_effect_mask(permissive)
    print("Permissive policy mask: ")
    print_int(mask_permissive)
    print("\n")

    let restricted = sandbox_policy_restricted()
    let mask_restricted = policy_to_effect_mask(restricted)
    print("Restricted policy mask: ")
    print_int(mask_restricted)
    print("\n")

    let pure = sandbox_policy_pure()
    let mask_pure = policy_to_effect_mask(pure)
    print("Pure policy mask: ")
    print_int(mask_pure)
    print("\n")

    print("\nTesting effect VM with policies...\n")
    var bc_pure = bytecode_new()
    bc_pure = add_const_i64(bc_pure, 42)
    bc_pure = emit_op_i32(bc_pure, OP_PUSH_I64(), 0)
    bc_pure = emit_op(bc_pure, OP_HALT())

    let exec_pure = sandbox_execute(bc_pure, pure)
    let summary_pure = effect_vm_summary(exec_pure.0, exec_pure.1)
    print("Pure computation effects: ")
    print_int(summary_pure.effects_performed)
    print(" (expected 0)\n")

    var bc_effects = bytecode_new()
    bc_effects = add_const_i64(bc_effects, 10)
    bc_effects = add_const_i64(bc_effects, 20)
    bc_effects = emit_op_i32(bc_effects, OP_PUSH_I64(), 0)
    bc_effects = emit_op_i32(bc_effects, OP_PUSH_I64(), 1)
    bc_effects = emit_op(bc_effects, OP_ADD_I64())
    bc_effects = emit_op(bc_effects, OP_HALT())

    let exec_effects = sandbox_execute(bc_effects, permissive)
    let summary_effects = effect_vm_summary(exec_effects.0, exec_effects.1)
    print("Effectful computation instructions: ")
    print_int(summary_effects.instructions_executed)
    print("\n")

    print("\nAll integration tests completed.\n")
    0
}
