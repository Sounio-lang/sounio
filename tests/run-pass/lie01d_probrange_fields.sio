//@ run-pass
//@ expect-stdout: LIE01D_PROBRANGE_PASS
// lie corpus item 1d: iv_from_epistemic used to return an Interval, presenting
// a k-sigma probability range as a guaranteed enclosure. It now returns a
// ProbRange, which is not an Interval and cannot flow into containment.

use verify::interval::{probrange_from_epistemic, pr_mid, pr_half_width,
    pr_coverage_k, interval, iv_to_epistemic_u, iv_width}

fn main() -> i64 with IO, Mut, Panic, Div {
    var fails: i64 = 0

    // K=2.0, sigma=0.5: half-width exactly 1.0 around 10.0.
    let pr = probrange_from_epistemic(10.0, 0.5, 2.0)
    if pr_mid(pr) != 10.0 { fails = fails + 1 }
    if pr_half_width(pr) != 1.0 { fails = fails + 1 }
    if pr_coverage_k(pr) != 2.0 { fails = fails + 1 }

    // The range still projects back through the interval side:
    // width 2.0 at k=2.0 recovers u=0.5.
    let iv = interval(pr_mid(pr) - pr_half_width(pr), pr_mid(pr) + pr_half_width(pr))
    if iv_width(iv) != 2.0 { fails = fails + 1 }
    if iv_to_epistemic_u(iv, pr_coverage_k(pr)) != 0.5 { fails = fails + 1 }

    if fails == 0 {
        println("LIE01D_PROBRANGE_PASS")
    } else {
        println("LIE01D_PROBRANGE_FAIL")
    }
    return fails
}
