//@ run-pass
//@ requires: madaros
//@ exit-code: 0
//@ description: `as u8` / `as u16` / `as u32` mask to the destination width; u64 and signed targets are untouched
// Full Test Suite CI uses souc-stage2 (lean_single). Madaros runs this graph.
//
// Integer values live in 64-bit slots, so a cast to a narrow unsigned type has
// to mask explicitly (lower_cast_expr_ref, self-hosted/ir/lower.sio). Each check
// returns a distinct nonzero code so a failure names the broken case.
//
// Out of scope here, and still failing: arithmetic wrap (`u32` + `u32` past
// 2^32), see tests/known_failures/u32_u16_u8_width_wrap_known_failure.sio.
// Casts to i8/i16/i32 (sign extension) and float -> u8 are not masked.

fn main() -> i64 with IO, Div {
    let a: i64 = 256
    let big: i64 = 4294967301
    let m1: i64 = 0 - 1

    // Truncation to the destination width.
    let narrow: u8 = 300 as u8
    if narrow != 44 { return 1 }
    let mid: u16 = 70000 as u16
    if mid != 4464 { return 2 }
    let c: u8 = a as u8
    if c != 0 { return 3 }
    let d: u32 = big as u32
    if d != 5 { return 4 }

    // Two's-complement reinterpretation of -1.
    let neg8: u8 = m1 as u8
    if neg8 != 255 { return 5 }
    let neg16: u16 = m1 as u16
    if neg16 != 65535 { return 6 }
    let neg32: u32 = m1 as u32
    if neg32 != 4294967295 { return 7 }

    // Values already in range pass through unchanged.
    let ok16: u16 = 257 as u16
    if ok16 != 257 { return 8 }
    let max8: u8 = 255 as u8
    if max8 != 255 { return 9 }

    // The mask applies to the cast result inside a larger expression.
    let widened: i64 = (300 as u8) as i64
    if widened + 1 != 45 { return 10 }

    // Targets that must NOT be masked.
    let keep64: i64 = big as i64
    if keep64 != 4294967301 { return 11 }
    let s32: i32 = m1 as i32
    if s32 != m1 { return 12 }

    0
}
