//@ run-pass
//@ known-failure: source-level i128 Lorenz ball-step center dynamics: main returns 2. Not a segfault/139
//@ requires: madaros
//@ description: Lorenz one-step fixed-point ball enclosure with i128 centers

fn main() -> i64 {
    let scale: i128 = 1000000 as i128
    let dt: i128 = 10000 as i128

    let sigma: i128 = 10 as i128
    let rho: i128 = 28 as i128
    let beta_num: i128 = 8 as i128
    let beta_den: i128 = 3 as i128

    let x: i128 = scale
    let y: i128 = scale
    let z: i128 = scale

    // Center follows the already-green i128 Lorenz point step.
    let dx: i128 = sigma * (y - x)
    let dy: i128 = (x * ((rho * scale) - z)) / scale - y
    let dz: i128 = (x * y) / scale - (beta_num * z) / beta_den

    let nx: i128 = x + (dt * dx) / scale
    let ny: i128 = y + (dt * dy) / scale
    // Avoid signed negative wide division; signed i128 division is pinned as XFAIL.
    let z_drop: i128 = (dt * ((0 as i128) - dz)) / scale
    let nz: i128 = z - z_drop

    // Ball radii are small enough to compute in i64. This is intentional:
    // i128 centers exercise high-precision dynamics, while the current compiler
    // cannot yet carry a helper-heavy public i128 ball API.
    let xr: i64 = 10
    let yr: i64 = 10
    let zr: i64 = 10
    let dx_rad: i64 = 10 * (yr + xr)
    let x_rhoz_rad: i64 = ((1000000 * zr) + (27000000 * xr) + (xr * zr)) / 1000000 + 1
    let dy_rad: i64 = x_rhoz_rad + yr
    let xy_rad: i64 = ((1000000 * yr) + (1000000 * xr) + (xr * yr)) / 1000000 + 1
    let beta_z_rad: i64 = ((8 * zr) + 2) / 3 + 1
    let dz_rad: i64 = xy_rad + beta_z_rad

    let nx_rad: i64 = xr + (10000 * dx_rad) / 1000000 + 1
    let ny_rad: i64 = yr + (10000 * dy_rad) / 1000000 + 1
    let nz_rad: i64 = zr + (10000 * dz_rad) / 1000000 + 1

    if dx != (0 as i128) { return 1 }
    if dy != (26000000 as i128) { return 2 }
    if dz != ((0 as i128) - (1666666 as i128)) { return 3 }
    if nx != (1000000 as i128) { return 4 }
    if ny != (1260000 as i128) { return 5 }
    if nz != (983334 as i128) { return 6 }

    if dx_rad != 200 { return 7 }
    if dy_rad != 291 { return 8 }
    if dz_rad != 49 { return 9 }
    if nx_rad != 13 { return 10 }
    if ny_rad != 13 { return 11 }
    if nz_rad != 11 { return 12 }

    return 0
}
