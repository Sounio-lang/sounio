//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v32 smoke for Lorenz i256 projection-roundoff entry

use theorem::portfolio::*

fn main() -> i64 {
    let audit_fp = solver_portfolio_v32_lorenz_i256_projection_roundoff_audit_fingerprint(
        677514412, 87220662, 149359034, 166945519, 184, 31)
    if audit_fp != 159826781 { return 1 }

    let manifest_fp = solver_portfolio_v32_lorenz_i256_projection_roundoff_bundle_fingerprint(
        677514412, audit_fp)
    if manifest_fp != 601279541 { return 2 }

    let result_fp = solver_portfolio_v32_result_coverage_fingerprint(
        32, 36, 10, 24, 1, 1, manifest_fp)
    if result_fp != 257415384 { return 3 }

    let family_fp = solver_portfolio_v32_checker_family_coverage_fingerprint(
        32, 36, 6, 3, 2, 2, 23, manifest_fp)
    if family_fp != 19842425 { return 4 }

    let acceptance_fp = solver_portfolio_v32_acceptance_receipt_fingerprint(
        32, manifest_fp, result_fp)
    if acceptance_fp != 240886278 { return 5 }

    let audit_receipt_fp = solver_portfolio_v32_audit_receipt_fingerprint(
        32, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 666559707 { return 6 }

    let readiness_fp = solver_portfolio_v32_readiness_fingerprint(
        32, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 32963031 { return 7 }

    if solver_portfolio_v32_lorenz_i256_projection_roundoff_audit_fingerprint(
        677514412, 87220663, 149359034, 166945519, 184, 31) != (0 - 1) { return 8 }
    if solver_portfolio_v32_result_coverage_fingerprint(
        32, 36, 11, 23, 1, 1, manifest_fp) != (0 - 1) { return 9 }

    return 0
}
