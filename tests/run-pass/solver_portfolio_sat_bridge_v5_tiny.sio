//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v5 smoke for resolution-to-RUP bridge entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 9 { return 0 - 1 }
    if instance_fp != 829764719 { return 0 - 1 }
    if certificate_fp != 759705343 { return 0 - 1 }
    if result_code != 0 { return 0 - 1 }
    if checker_code != 9 { return 0 - 1 }

    var fp: i64 = 101
    fp = mix(fp, kind, 1103)
    fp = mix(fp, instance_fp, 1103)
    fp = mix(fp, certificate_fp, 1103)
    fp = mix(fp, result_code, 1103)
    fp = mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v5_fingerprint(bridge_entry_fp: i64) -> i64 with Mod {
    if bridge_entry_fp != 973127057 { return 0 - 1 }
    var fp: i64 = 107
    fp = mix(fp, 5, 1151)
    fp = mix(fp, 9, 1151)
    fp = mix(fp, 53646245, 1151)
    fp = mix(fp, 528026990, 1151)
    fp = mix(fp, 301444501, 1151)
    fp = mix(fp, 258927862, 1151)
    fp = mix(fp, 388915166, 1151)
    fp = mix(fp, 900589789, 1151)
    fp = mix(fp, 205040674, 1151)
    fp = mix(fp, 580031260, 1151)
    fp = mix(fp, bridge_entry_fp, 1151)
    return fp
}

fn main() -> i64 {
    let entry_fp = portfolio_entry_fingerprint(9, 829764719, 759705343, 0, 9)
    let manifest_fp = portfolio_v5_fingerprint(entry_fp)

    if entry_fp != 973127057 { return 1 }
    if manifest_fp != 535346450 { return 2 }
    if portfolio_entry_fingerprint(9, 829764719, 759705343, 1, 9) != (0 - 1) { return 3 }
    if portfolio_entry_fingerprint(9, 829764719, 759705344, 0, 9) != (0 - 1) { return 4 }
    if portfolio_v5_fingerprint(entry_fp + 1) != (0 - 1) { return 5 }
    return 0
}
