//@ run-pass
//@ requires: madaros
//@ expect-stdout: 11
//@ expect-stdout: 11
//@ expect-stdout: 11
//@ expect-stdout: 11
//@ expect-stdout: 33
//@ expect-stdout: 44
//@ expect-stdout: 55
//@ expect-stdout: 66
//@ description: implicit and explicit &T / &!T field load and store do not dereference a bare handle
// A local struct passed to `&T` is borrowed as a cell. A struct global is not:
// the callee receives the bare handle id. Always dereferencing that id faults
// at the small address. Explicit `&` / `&!` pass the address of the cell.
struct Pair { left: i64, right: i64 }

var G: Pair = Pair { left: 11, right: 22 }

fn load_shared(p: &Pair) -> i64 {
    p.left
}

fn store_mut(p: &!Pair, value: i64) with Mut {
    p.left = value
}

fn main() -> i32 with IO, Mut {
    var pair = Pair { left: 11, right: 22 }
    println(load_shared(pair))
    println(load_shared(&pair))
    println(load_shared(G))
    println(load_shared(&G))
    store_mut(pair, 33)
    println(pair.left)
    store_mut(&!pair, 44)
    println(pair.left)
    store_mut(G, 55)
    println(G.left)
    store_mut(&!G, 66)
    println(G.left)
    if pair.right != 22 || G.right != 22 {
        println(0)
        return 1
    }
    return 0
}
