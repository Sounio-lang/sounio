//@ run-pass
//@ requires: madaros
//@ description: -O must not propagate values across basic-block boundaries (#1667)
//
// Run this witness both with and without -O. The unoptimized build does not
// exercise the four propagation peels and is only the semantic control.

fn add3(a: i64, b: i64, c: i64) -> i64 {
    a + b + c
}

fn add4(a: i64, b: i64, c: i64, d: i64) -> i64 {
    a + b + c + d
}

fn branches() -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    if i < 1 { s = s + 1 } else { s = s + 2 }
    if i < 2 { s = s + 1 } else { s = s + 2 }
    if i < 3 { s = s + 1 } else { s = s + 2 }
    s
}

fn diamond(take_left: bool) -> i64 {
    var value: i64 = 0
    if take_left { value = 31 } else { value = 47 }
    value
}

fn invariant_loop() -> i64 {
    var acc: i64 = 0
    var i: i64 = 0
    while i < 4 {
        let k = 7
        let m = 9
        acc = acc + add3(k, m, i)
        i = i + 1
    }
    acc
}

fn main() -> i64 {
    if branches() != 3 { return 1 }
    if invariant_loop() != 70 { return 2 }
    if diamond(true) != 31 { return 3 }
    if diamond(false) != 47 { return 4 }
    if add3(1, 2, 3) != 6 { return 5 }
    if add4(1, 2, 3, 4) != 10 { return 6 }
    0
}
