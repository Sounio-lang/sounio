//@ run-pass
//@ description: #2826 long decimal literals decide both sides of binary64 midpoints exact from source digits, including a far nonzero tail, subnormal boundaries and overflow
//@ expect-stdout: LONG_DECIMAL_MIDPOINT_OK
// Expected bits come from tests/oracles/float_literal_long_decimal_oracle.py,
// an integer-rational oracle independent of both compilers. The old i64
// significand accumulation discarded every digit past the first 19, so a
// literal just above a midpoint could round down (PR #2904 P1: the founder
// counterexample below read 4609138141549945972, want ...973).

fn show(label: string, bits: i64) with IO {
    print(label)
    println(bits)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var bad: i64 = 0
    let a = f64_to_bits(1.00000000000000011102230246251565404236316680908203124999999e0)
    show("one_below=", a)
    if a != 4607182418800017408 { bad = bad + 1 }
    let b = f64_to_bits(1.00000000000000011102230246251565404236316680908203125e0)
    show("one_at=", b)
    if b != 4607182418800017408 { bad = bad + 1 }
    let c = f64_to_bits(1.00000000000000011102230246251565404236316680908203125000001e0)
    show("one_above=", c)
    if c != 4607182418800017409 { bad = bad + 1 }
    let d = f64_to_bits(1.)
    show("one_at_long_zero=", d)
    if d != 4607182418800017408 { bad = bad + 1 }
    let e = f64_to_bits(1.)
    show("one_above_far_tail=", e)
    if e != 4607182418800017409 { bad = bad + 1 }
    let f = f64_to_bits(1.43425768535078390630843614417244680225849151611328125000001)
    show("founder_midpoint_plus=", f)
    if f != 4609138141549945973 { bad = bad + 1 }
    let g = f64_to_bits(2.-324)
    show("half_sub_below=", g)
    if g != 0 { bad = bad + 1 }
    let h = f64_to_bits(2.-324)
    show("half_sub_at=", h)
    if h != 0 { bad = bad + 1 }
    let i = f64_to_bits(2.-324)
    show("half_sub_above=", i)
    if i != 1 { bad = bad + 1 }
    let j = f64_to_bits(2.-308)
    show("norm_below=", j)
    if j != 4503599627370495 { bad = bad + 1 }
    let k = f64_to_bits(2.-308)
    show("norm_at=", k)
    if k != 4503599627370496 { bad = bad + 1 }
    let l = f64_to_bits(2.-308)
    show("norm_above=", l)
    if l != 4503599627370496 { bad = bad + 1 }
    let m = f64_to_bits(1.)
    show("over_below=", m)
    if m != 9218868437227405311 { bad = bad + 1 }
    let n = f64_to_bits(1.)
    show("over_at=", n)
    if n != 9218868437227405312 { bad = bad + 1 }
    let o = f64_to_bits(1.)
    show("over_above=", o)
    if o != 9218868437227405312 { bad = bad + 1 }
    let p = f64_to_bits(0.0 - 1.43425768535078390630843614417244680225849151611328125000001)
    show("founder_negative=", p)
    if p != -4614233895304829835 { bad = bad + 1 }
    if bad == 0 { println("LONG_DECIMAL_MIDPOINT_OK") } else { println("LONG_DECIMAL_MIDPOINT_FAIL") }
    if bad != 0 { return 1 }
    0
}
