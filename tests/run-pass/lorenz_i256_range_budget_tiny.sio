//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 five-step trajectory range-budget certificate

fn budget_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn trajectory5_range_budget_fingerprint(
    scale_log2: i64,
    step_count: i64,
    state_bound_log2: i64,
    derivative_num_bound_log2: i64,
    quotient_product_bound_log2: i64,
    signed_positive_limit_exp: i64,
    trajectory_manifest_fp: i64,
    chain_anchor: i64,
    final_x: i64,
    final_y: i64,
    final_z: i64) -> i64 {
    if scale_log2 != 32 { return 0 - 1 }
    if step_count != 5 { return 0 - 1 }
    if state_bound_log2 != 34 { return 0 - 1 }
    if derivative_num_bound_log2 != 71 { return 0 - 1 }
    if quotient_product_bound_log2 != 71 { return 0 - 1 }
    if signed_positive_limit_exp != 255 { return 0 - 1 }
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if chain_anchor != 23144051 { return 0 - 1 }
    if final_x != 5309941770 { return 0 - 1 }
    if final_y != 10058731223 { return 0 - 1 }
    if final_z != 4084837935 { return 0 - 1 }
    if final_x >= 17179869184 { return 0 - 1 }
    if final_y >= 17179869184 { return 0 - 1 }
    if final_z >= 17179869184 { return 0 - 1 }
    if signed_positive_limit_exp - quotient_product_bound_log2 != 184 { return 0 - 1 }

    var fp: i64 = 293
    fp = budget_mix(fp, scale_log2, 2519)
    fp = budget_mix(fp, step_count, 2519)
    fp = budget_mix(fp, state_bound_log2, 2519)
    fp = budget_mix(fp, derivative_num_bound_log2, 2519)
    fp = budget_mix(fp, quotient_product_bound_log2, 2519)
    fp = budget_mix(fp, signed_positive_limit_exp, 2519)
    fp = budget_mix(fp, trajectory_manifest_fp, 2519)
    fp = budget_mix(fp, chain_anchor, 2519)
    fp = budget_mix(fp, final_x, 2519)
    fp = budget_mix(fp, final_y, 2519)
    fp = budget_mix(fp, final_z, 2519)
    return fp
}

fn trajectory5_range_audit_fingerprint(
    range_budget_fp: i64,
    bridge_instance_fp: i64,
    projection_inclusion_fp: i64,
    ball_fixed_enclosure_fp: i64,
    bit_headroom: i64,
    readiness_mask: i64) -> i64 {
    if range_budget_fp != 87220662 { return 0 - 1 }
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if bit_headroom != 184 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 307
    fp = budget_mix(fp, range_budget_fp, 2531)
    fp = budget_mix(fp, bridge_instance_fp, 2531)
    fp = budget_mix(fp, projection_inclusion_fp, 2531)
    fp = budget_mix(fp, ball_fixed_enclosure_fp, 2531)
    fp = budget_mix(fp, bit_headroom, 2531)
    fp = budget_mix(fp, readiness_mask, 2531)
    return fp
}

fn main() -> i64 {
    let budget_fp = trajectory5_range_budget_fingerprint(
        32, 5, 34, 71, 71, 255, 214180161, 23144051,
        5309941770, 10058731223, 4084837935)
    if budget_fp != 87220662 { return 1 }

    let audit_fp = trajectory5_range_audit_fingerprint(
        budget_fp, 149359034, 890086395, 166945519, 184, 31)
    if audit_fp != 323169628 { return 2 }

    if trajectory5_range_budget_fingerprint(
        32, 5, 33, 71, 71, 255, 214180161, 23144051,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 3 }
    if trajectory5_range_budget_fingerprint(
        32, 5, 34, 71, 72, 255, 214180161, 23144051,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 4 }
    if trajectory5_range_audit_fingerprint(
        budget_fp, 149359034, 890086395, 166945519, 183, 31) != (0 - 1) { return 5 }
    if trajectory5_range_audit_fingerprint(
        budget_fp, 149359034, 890086396, 166945519, 184, 31) != (0 - 1) { return 6 }

    return 0
}
