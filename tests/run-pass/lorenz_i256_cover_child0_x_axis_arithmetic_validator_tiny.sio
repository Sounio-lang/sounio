//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-0 X-axis arithmetic validator receipt

fn main() -> i64 {
    let validator_instance: i64 = 503013755
    let validator_certificate: i64 = 118280524
    let validator_artifact: i64 = 260549564
    let validator_audit: i64 = 90270943

    if validator_instance != 503013755 { return 1 }
    if validator_certificate != 118280524 { return 2 }
    if validator_artifact != 260549564 { return 3 }
    if validator_audit != 90270943 { return 4 }

    let step1_need: i64 = 26878
    let step1_margin: i64 = 27000
    let step2_need: i64 = 83731
    let step2_margin: i64 = 84000
    let step3_need: i64 = 112768
    let step3_margin: i64 = 113000
    let step4_need: i64 = 103524
    let step4_margin: i64 = 104000
    let step5_need: i64 = 278282
    let step5_margin: i64 = 279000

    if step1_margin - step1_need != 122 { return 5 }
    if step2_margin - step2_need != 269 { return 6 }
    if step3_margin - step3_need != 232 { return 7 }
    if step4_margin - step4_need != 476 { return 8 }
    if step5_margin - step5_need != 718 { return 9 }

    let x_axis_pass_mask: i64 = 31
    let x_axis_fail_mask: i64 = 0
    let x_axis_slack_mask: i64 = 31
    let axis_validated_mask: i64 = 1
    let pending_axis_validation_mask: i64 = 30
    let remaining_axis_pending_mask: i64 = 6
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0

    if x_axis_pass_mask != 31 { return 10 }
    if x_axis_fail_mask != 0 { return 11 }
    if x_axis_slack_mask != 31 { return 12 }
    if axis_validated_mask != 1 { return 13 }
    if pending_axis_validation_mask != 30 { return 14 }
    if remaining_axis_pending_mask != 6 { return 15 }
    if local_flowpipe_proof_mask != 0 { return 16 }
    if child_validated_mask != 0 { return 17 }
    if child_discharge_mask != 0 { return 18 }
    if global_cover_certificate_mask != 0 { return 19 }
    if global_flowpipe_claim_mask != 0 { return 20 }

    let total_need: i64 = step1_need + step2_need + step3_need + step4_need + step5_need
    if total_need != 605183 { return 21 }
    return 0
}
