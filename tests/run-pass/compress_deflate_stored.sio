//@ run-pass
// Round-trip test for stdlib/compress/deflate.sio — stored-block DEFLATE (RFC 1951 §3.2.4)
//
// Tests: deflate_stored → inflate_stored round-trip for a short byte sequence.
// No external library. Pure Sounio arithmetic encoding.

struct SrcBuf { data: [i64; 256] }
struct DstBuf { data: [i64; 512] }

struct DeflateResult {
    ok: bool,
    written: i64,
    error_code: i64,
}

// One's complement (16-bit) of len
fn nlen16(len: i64) -> i64 {
    65535 - len
}

fn len_lo(len: i64) -> i64 { len - ((len / 256) * 256) }
fn len_hi(len: i64) -> i64 { len / 256 }

fn deflate_stored(src: &SrcBuf, src_len: i64,
                  dst: &! DstBuf) -> DeflateResult with Mut, Panic {
    if src_len < 0 || src_len > 200 {
        return DeflateResult { ok: false, written: 0, error_code: 1 }
    }
    let required = 5 + src_len
    if required > 500 {
        return DeflateResult { ok: false, written: 0, error_code: 2 }
    }

    let n16 = nlen16(src_len)

    dst.data[0] = 1
    dst.data[1] = len_lo(src_len)
    dst.data[2] = len_hi(src_len)
    dst.data[3] = len_lo(n16)
    dst.data[4] = len_hi(n16)

    var i: i64 = 0
    while i < src_len {
        dst.data[5 + i as usize] = src.data[i as usize]
        i = i + 1
    }

    DeflateResult { ok: true, written: required, error_code: 0 }
}

fn inflate_stored(src: &DstBuf, src_len: i64,
                  dst: &! SrcBuf) -> DeflateResult with Mut, Panic {
    if src_len < 5 {
        return DeflateResult { ok: false, written: 0, error_code: 5 }
    }

    let header_byte = src.data[0]
    let btype = (header_byte / 2) - ((header_byte / 2 / 2) * 2)
    if btype != 0 {
        return DeflateResult { ok: false, written: 0, error_code: 3 }
    }

    let len = src.data[1] + src.data[2] * 256
    let nlen = src.data[3] + src.data[4] * 256

    if nlen != nlen16(len) {
        return DeflateResult { ok: false, written: 0, error_code: 4 }
    }

    if 5 + len > src_len || len > 200 {
        return DeflateResult { ok: false, written: 0, error_code: 5 }
    }

    var i: i64 = 0
    while i < len {
        dst.data[i as usize] = src.data[5 + i as usize]
        i = i + 1
    }

    DeflateResult { ok: true, written: len, error_code: 0 }
}

fn main() -> i32 with IO, Mut, Panic {
    // Test payload: ASCII values for "Hello, Sounio!"
    // H=72 e=101 l=108 l=108 o=111 ,=44 32 S=83 o=111 u=117 n=110 i=105 o=111 !=33
    let n: i64 = 14
    var src = SrcBuf { data: [0; 256] }
    src.data[0]  = 72
    src.data[1]  = 101
    src.data[2]  = 108
    src.data[3]  = 108
    src.data[4]  = 111
    src.data[5]  = 44
    src.data[6]  = 32
    src.data[7]  = 83
    src.data[8]  = 111
    src.data[9]  = 117
    src.data[10] = 110
    src.data[11] = 105
    src.data[12] = 111
    src.data[13] = 33

    var compressed = DstBuf { data: [0; 512] }
    let r1 = deflate_stored(&src, n, &!compressed)

    if r1.ok == false { print("FAIL: r1.ok\n"); return 1 as i32 }
    let comp_len = r1.written
    if comp_len == 5 + n { print("") } else { print("FAIL: comp_len\n"); return 2 as i32 }
    if compressed.data[0] == 1 { print("") } else { print("FAIL: data[0]\n"); return 3 as i32 }
    if compressed.data[1] == n { print("") } else { print("FAIL: data[1]\n"); return 4 as i32 }
    if compressed.data[2] == 0 { print("") } else { print("FAIL: data[2]\n"); return 5 as i32 }
    // NLEN = 65535 - 14 = 65521 = 0xFFF1: lo=0xF1=241, hi=0xFF=255
    if compressed.data[3] == 241 { print("") } else { print("FAIL: data[3]\n"); return 6 as i32 }
    if compressed.data[4] == 255 { print("") } else { print("FAIL: data[4]\n"); return 7 as i32 }

    // Round-trip: inflate back
    var recovered = SrcBuf { data: [0; 256] }
    let r2 = inflate_stored(&compressed, comp_len, &!recovered)

    if r2.ok == false { print("FAIL: r2.ok\n"); return 8 as i32 }
    let rec_len = r2.written
    if rec_len == n { print("") } else { print("FAIL: rec_len\n"); return 9 as i32 }

    // Verify byte equality
    var all_match: bool = true
    var i: i64 = 0
    while i < n {
        if recovered.data[i as usize] != src.data[i as usize] {
            all_match = false
        }
        i = i + 1
    }
    if all_match == false { print("FAIL: byte mismatch\n"); return 10 as i32 }

    // Edge case: empty block (LEN=0, NLEN=65535=0xFFFF)
    var empty_src = SrcBuf { data: [0; 256] }
    var empty_dst = DstBuf { data: [0; 512] }
    let r3 = deflate_stored(&empty_src, 0, &!empty_dst)
    if r3.ok == false { print("FAIL: r3.ok\n"); return 11 as i32 }
    if r3.written == 5 { print("") } else { print("FAIL: r3.written\n"); return 12 as i32 }
    if empty_dst.data[3] == 255 { print("") } else { print("FAIL: empty nlen lo\n"); return 13 as i32 }
    if empty_dst.data[4] == 255 { print("") } else { print("FAIL: empty nlen hi\n"); return 14 as i32 }

    var empty_rec = SrcBuf { data: [0; 256] }
    let r4 = inflate_stored(&empty_dst, 5, &!empty_rec)
    if r4.ok == false { print("FAIL: r4.ok\n"); return 15 as i32 }
    if r4.written == 0 { print("") } else { print("FAIL: r4.written\n"); return 16 as i32 }

    print("compress_deflate_stored: all tests passed\n")
    return 0 as i32
}
