//@ run-pass
//@ description: Arrays of Knowledge<T> — index, .value field access, struct field, and
//@ return-by-value across a stack-stomping call all work. Regression lock for the
//@ array-element-type fix (scan_type recursion + arr_ty_hash Knowledge preservation):
//@ `[Knowledge[f64]; N]` previously mis-parsed and `arr[i].value` gave "unknown field access".

struct Box { kn: [Knowledge[f64]; 4] }

fn mk() -> Box with Mut, Div, Panic, Epistemic {
    var a: [Knowledge[f64]; 4] = [Knowledge(0.0, ε=1.0, prov="init"); 4];
    a[0] = Knowledge(12.4, ε=0.65, prov="cl_hepatic");
    a[1] = Knowledge(0.08, ε=0.72, prov="fu_plasma");
    a[2] = Knowledge(5.40, ε=0.60, prov="kp_liver");
    Box { kn: a }
}

// Writes a large local array to overwrite mk()'s dead stack frame — proves the
// returned Knowledge array is stored by value, not as dangling stack pointers.
fn stomp(n: i64) -> i64 with Mut {
    var buf: [i64; 800] = [0; 800];
    var i: i64 = 0;
    var s: i64 = 0;
    while i < 800 { buf[i] = i + n; s = s + buf[i]; i = i + 1; }
    s
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    let b = mk();
    let _ = stomp(1000);
    let k0 = b.kn[0];
    let k1 = b.kn[1];
    let k2 = b.kn[2];
    // Survives the stomp ⇒ by-value storage.
    if k0.value == 12.4 && k1.value == 0.08 && k2.value == 5.40 {
        println("KNOWLEDGE_ARRAY_PASS");
    } else {
        println("KNOWLEDGE_ARRAY_FAIL");
    }
}
