//@ run-pass
//@ expect-stdout: SPECIALIZER_MULTI_INSTANTIATION_NONSCALAR_OK
//@ requires: madaros
// One generic template instantiated with two struct type arguments that differ
// only inside the nesting (`Cell<i64>`, `Cell<f64>`).
//
// This used to be a compile-fail fixture: monomorphization kept one
// instantiation per template, a second distinct one poisoned the template back
// to its unspecialized body, and lowering has no generics concept, so a
// struct-typed argument arrived as zero. The specializer refused the program
// rather than emit that ("more than one type-argument list in a single
// compilation unit").
//
// Every distinct instantiation now gets its own clone (spec_ensure_instance in
// self-hosted/check/specializer.sio), so the program is correct and is accepted.
// Measured on the Madaros built from the change, same file: 7 and 1.500000.
//
// See docs/handoff/BLK-20260903-specializer-nested-targ-collision.md.

struct Cell<T> {
    v: T,
}

fn pick<T>(a: T, b: T) -> T {
    a
}

fn main() -> i32 with IO {
    let ci: Cell<i64> = pick::<Cell<i64>>(Cell { v: 7 }, Cell { v: 9 })
    let vi: i64 = ci.v

    let cf: Cell<f64> = pick::<Cell<f64>>(Cell { v: 1.5 }, Cell { v: 2.5 })
    let vf: f64 = cf.v

    if vi == 7 && vf == 1.5 {
        println("SPECIALIZER_MULTI_INSTANTIATION_NONSCALAR_OK")
    } else {
        println("SPECIALIZER_MULTI_INSTANTIATION_NONSCALAR_FAIL")
    }
    0
}
