//@ run-pass
//@ requires: madaros
// Previously refused to prevent unspecialized aggregate wrong-code.
// Distinct concrete clones must now return the exact values below.

struct Cell<T> {
    v: T,
}

fn pick<T>(a: T, b: T) -> T {
    a
}

fn main() -> i32 with IO {
    let ci: Cell<i64> = pick::<Cell<i64>>(Cell { v: 7 }, Cell { v: 9 })
    let vi: i64 = ci.v
    println(vi)

    let cf: Cell<f64> = pick::<Cell<f64>>(Cell { v: 1.5 }, Cell { v: 2.5 })
    let vf: f64 = cf.v
    println(vf)
    if vi != 7 { return 1 }
    if vf != 1.5 { return 2 }
    0
}
