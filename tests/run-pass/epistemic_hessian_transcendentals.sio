//@ run-pass
//@ sabotage: hessian-chain
// Tier 1: Hessian chain rule for tan, atan, tanh, asin, acos
// Mathematical ground truth at each test point verified analytically.

// atan(x) at x=1: f''= -2x/(1+x²)² = -2·1/4 = -0.5
fn test_atan_h00() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let x = xm.value
    hessian_of(atan(x), 0, 0)
}

// tan(x) at x=0: f''= 2·tan·sec² = 0 (sanity — zero is exact)
fn test_tan_h00_zero() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let x = xm.value
    hessian_of(tan(x), 0, 0)
}

// x·atan(x) at x=1: H[0,1] requires 2 inputs; use H[0,0] of atan(x) then product rule
// f(x,y) = x * atan(y): H[0,1] = f'(atan)(y) = 1/(1+y²). At y=1 → 0.5
fn test_x_atan_y_h01() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    hessian_of(x * atan(y), 0, 1)
}

// tanh(x) at x=0: f''= -2·tanh·sech² = 0 (sanity)
fn test_tanh_h00_zero() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let x = xm.value
    hessian_of(tanh(x), 0, 0)
}

// asin(x)*y at x=0, y=2: H[0,1] = f'(asin)(0) = 1/sqrt(1-0) = 1.0
fn test_asin_cross() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    hessian_of(asin(x) * y, 0, 1)
}

// acos(x) at x=0: f''= -arg/(1-arg²)^(3/2) = 0 (sanity)
fn test_acos_h00_zero() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(0.0, uncertainty: 0.0)
    let x = xm.value
    hessian_of(acos(x), 0, 0)
}

fn main() with IO, Epistemic {
    let h_atan   = test_atan_h00()           // expect -0.5
    let h_tan0   = test_tan_h00_zero()       // expect  0.0
    let h_xatan  = test_x_atan_y_h01()      // expect  0.5
    let h_tanh0  = test_tanh_h00_zero()      // expect  0.0
    let h_asin   = test_asin_cross()         // expect  1.0
    let h_acos0  = test_acos_h00_zero()      // expect  0.0
    println(h_atan)
    println(h_tan0)
    println(h_xatan)
    println(h_tanh0)
    println(h_asin)
    println(h_acos0)
}
