//@ run-pass
//@ expect-stdout: DEREF_ARRAY_ELEM_OK
// `var prog = (*programs)[i]` with `programs: &![Pg; 4]` binds `prog` as a Pg,
// so `prog.items` reads Pg.items (index 1), not index 0 where the decoy structs
// keep their `items`. Madaros left the element untyped and the untyped field
// vote read Pg.path instead. The same shape is module_struct_identity_check in
// self-hosted/compiler/private_fn_identity.sio, where gen3 then followed a
// module-path byte buffer as a list and crashed (#2966).

struct D1 { items: i64, x: i64 }
struct D2 { items: i64, y: i64, z: i64 }
struct D3 { items: i64 }
struct Pg {
    path: i64,
    items: i64,
}

fn total(programs: &![Pg; 4], count: i64) -> i64 with Mut, Panic, Div {
    var acc: i64 = 0
    var i: i64 = 0
    while i < count {
        var prog = (*programs)[i as usize]
        acc = acc * 10 + prog.items
        i = i + 1
    }
    acc
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let a = D1 { items: 9, x: 0 }
    let b = D2 { items: 9, y: 0, z: 0 }
    let c = D3 { items: 9 }
    var ps = [Pg { path: 7, items: 1 }, Pg { path: 7, items: 2 }, Pg { path: 7, items: 3 }, Pg { path: 7, items: 4 }]
    let r = total(&!ps, 4) + a.items + b.items + c.items - 27
    if r != 1234 {
        println(r)
        return 1
    }
    println("DEREF_ARRAY_ELEM_OK")
    return 0
}
