//@ run-pass
//@ expect-stdout: STDLIB_DEEP_VIZ_CONTOUR_PREDICATE_PASS
use viz::contour_predicate::{contour_saddle_sign}
fn from_parts(sig:i64,exponent:i64)->f64 with Mut,Div {
 var value=sig as f64
 var e=exponent
 while e>0 {value=value*2.0;e=e-1}
 while e<0 {value=value/2.0;e=e+1}
 value
}
fn case_value(i:i64,j:i64)->f64 with Mut,Div {
 if i==0 {return 0.0}
 if i==1 {if j==4 {return 0.0};return if j%2==0 {1.0}else{-1.0}}
 if i>=2 && i<=7 {return from_parts(4503599627370496+(if j==4 {0}else{j*2-3+(if j==3 {i-4}else{0})}),if i%2==0 {971}else{-1074})}
 if i==8 {return from_parts(if j%2==0 {4503599627370496}else{-4503599627370496},-1126)}
 if i==9 {return if j==4 {-0.0}else{from_parts(4503599627370496+j,971)}}
 let sig=4503599627370496+(i*1000000007+j*100000000003)%4503599627370496
 let signed=if (i+j)%3==0 {-sig}else{sig}
 from_parts(signed,(i*37+j*251)%2046-1074)
}
fn main() with IO,Mut,Div,Panic {
 var i:i64=0
 while i<96 {
  let a=case_value(i,0);let b=case_value(i,1);let c=case_value(i,2);let d=case_value(i,3);let level=case_value(i,4)
  let result=contour_saddle_sign(a,b,c,d,level)
  let code:i64=result.status;let sign:i64=result.sign
  print("SADDLE_CASE ");print(i);print(" ");print(code);print(" ");println(sign)
  assert(code==0)
  i=i+1
 }
 let invalid=contour_saddle_sign(0.0/0.0,1.0,1.0,1.0,0.0)
 assert(invalid.status==1 && invalid.sign==0)
 println("STDLIB_DEEP_VIZ_CONTOUR_PREDICATE_PASS")
}
