//@ run-pass
//@ requires: madaros
//@ expect-stdout: EPISTEMIC_CONTEST_RETRACT_OK
//@ description: ADR-016 contests of measured values. contest(x, y, z) carries three sources that disagree without combining them; the statistics read its sources; retract(c, y, because: "...") is the only exit and removes one source, after which meet of the contest fuses what is left, and meet of a contest reduced to one source is that source with its channels. Expected values: tests/oracles/epistemic_meet/meet_cases.cpp, cases C and D.

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-15 + 1.0e-12 * w
}
fn report(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var bad: i64 = 0
    let k0 = measure(1.0, uncertainty: 0.1)
    let k1 = measure(1.3, uncertainty: 0.1)
    let k2 = measure(0.8, uncertainty: 0.1)
    let x = k0.value
    let y = k1.value
    let z = k2.value
    let c = contest(x, y, z)
    bad = bad + report("birge_of(c)", birge_of(c), 2.5166114784235832)
    bad = bad + report("neff_of(c)", neff_of(c), 3.0)
    let c2 = retract(c, y, because: "reference standard out of calibration on the day")
    bad = bad + report("birge_of(c2)", birge_of(c2), 1.414213562373095)
    bad = bad + report("en_of(c2)", en_of(c2), 0.70710678118654752)
    let m2 = meet(c2)
    bad = bad + report("meet(c2)", m2, 0.9)
    bad = bad + report("var", variance_of(m2), 0.005)
    bad = bad + report("cov(meet(c2), x)", covariance_of(m2, x), 0.005)
    let c3 = retract(c2, z, because: "superseded by the 2026 recalibration")
    let m3 = meet(c3)
    bad = bad + report("meet(c3)", m3, 1.0)
    bad = bad + report("var", variance_of(m3), 0.01)
    bad = bad + report("cov(meet(c3), x)", covariance_of(m3, x), 0.01)
    if bad == 0 {
        print("EPISTEMIC_CONTEST_RETRACT_OK\n")
        return 0
    }
    1
}
