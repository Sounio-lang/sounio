//@ run-pass
//@ description: Test effect handlers in sandbox

use compiler::effects::sandbox::*

fn main() with IO, Mut, Panic, Div {
    print("Testing effect handlers in sandbox...\n")

    // Test 1: Basic handler installation and perform
    print("\n1. Basic handler test...\n")
    let allowed = effect_bit(EFFECT_IO())
    var evm = effect_vm_new(allowed)
    evm = effect_vm_install_handler(evm, effect_bit(EFFECT_IO()), 50, false)
    print("Handler installed for IO at PC 50\n")
    evm = effect_vm_perform(evm, EFFECT_IO(), 10)
    if effect_vm_pc(&evm) == 50 {
        print("  PASS: Jumped to handler at PC 50\n")
    } else {
        print("  FAIL: PC is ")
        print_int(effect_vm_pc(&evm))
        print(" expected 50\n")
    }

    // Test 2: Nested handlers
    print("\n2. Nested handlers test...\n")
    var allowed2 = effect_add(effect_bit(EFFECT_IO()), EFFECT_MUT())
    var evm2 = effect_vm_new(allowed2)
    evm2 = effect_vm_install_handler(evm2, effect_bit(EFFECT_IO()), 100, false)
    evm2 = effect_vm_install_handler(evm2, effect_bit(EFFECT_MUT()), 200, false)
    evm2 = effect_vm_perform(evm2, EFFECT_MUT(), 10)
    if effect_vm_pc(&evm2) == 200 {
        print("  PASS: Nested handler caught Mut at PC 200\n")
    } else {
        print("  FAIL: PC is ")
        print_int(effect_vm_pc(&evm2))
        print(" expected 200\n")
    }

    // Test 3: Unhandled effect
    print("\n3. Unhandled effect test...\n")
    var evm3 = effect_vm_new(effect_bit(EFFECT_IO()))
    evm3 = effect_vm_perform(evm3, EFFECT_MUT(), 10)
    if effect_vm_has_error(&evm3) {
        print("  PASS: Unhandled effect caused error\n")
    } else {
        print("  FAIL: Unhandled effect did not error\n")
    }

    // Test 4: Policy denial
    print("\n4. Policy denial test...\n")
    var evm4 = effect_vm_new(effect_bit(EFFECT_MUT()))
    evm4 = effect_vm_perform(evm4, EFFECT_IO(), 10)
    if effect_vm_has_error(&evm4) {
        print("  PASS: Policy denied IO effect\n")
    } else {
        print("  FAIL: Policy should have denied IO\n")
    }

    // Test 5: Handler removal
    print("\n5. Handler removal test...\n")
    var evm5 = effect_vm_new(effect_bit(EFFECT_IO()))
    evm5 = effect_vm_install_handler(evm5, effect_bit(EFFECT_IO()), 100, false)
    evm5 = effect_vm_remove_handler(evm5)
    evm5 = effect_vm_perform(evm5, EFFECT_IO(), 10)
    if effect_vm_has_error(&evm5) {
        print("  PASS: Removed handler, effect unhandled\n")
    } else {
        print("  FAIL: Should have errored after handler removal\n")
    }

    // Test 6: Multi-shot handler
    print("\n6. Multi-shot handler test...\n")
    var evm6 = effect_vm_new(effect_bit(EFFECT_IO()))
    evm6 = effect_vm_install_handler(evm6, effect_bit(EFFECT_IO()), 300, true)
    evm6 = effect_vm_perform(evm6, EFFECT_IO(), 10)
    let pc1 = effect_vm_pc(&evm6)
    evm6 = effect_vm_perform(evm6, EFFECT_IO(), 20)
    let pc2 = effect_vm_pc(&evm6)
    if pc1 == 300 && pc2 == 300 {
        print("  PASS: Multi-shot handler resumed multiple times\n")
    } else {
        print("  FAIL: Multi-shot handler PCs: ")
        print_int(pc1)
        print(", ")
        print_int(pc2)
        print("\n")
    }

    // Test 7: Effect logging
    print("\n7. Effect logging test...\n")
    var allowed7 = effect_add(effect_bit(EFFECT_IO()), EFFECT_MUT())
    var evm7 = effect_vm_new(allowed7)
    evm7 = effect_vm_install_handler(evm7, allowed7, 400, true)
    evm7 = effect_vm_perform(evm7, EFFECT_IO(), 10)
    evm7 = effect_vm_perform(evm7, EFFECT_MUT(), 20)
    evm7 = effect_vm_perform(evm7, EFFECT_IO(), 30)
    if effect_vm_log_count(&evm7) == 3 {
        print("  PASS: Logged 3 effect performances\n")
        var i: i64 = 0
        while i < effect_vm_log_count(&evm7) {
            print("    Effect ")
            print_int(effect_vm_log_effect_id(&evm7, i))
            print(" at PC ")
            print_int(effect_vm_log_pc(&evm7, i))
            print("\n")
            i = i + 1
        }
    } else {
        print("  FAIL: Expected 3 log entries, got ")
        print_int(effect_vm_log_count(&evm7))
        print("\n")
    }

    // Test 8: Sandbox policies
    print("\n8. Sandbox policy tests...\n")
    var bc = bytecode_new()
    bc = add_const_i64(bc, 42)
    bc = emit_op_i32(bc, OP_PUSH_I64(), 0)
    bc = emit_op(bc, OP_HALT())

    let pure = sandbox_policy_pure()
    let exec_pure = sandbox_execute(bc, pure)
    if !effect_vm_has_error(&exec_pure.0) && exec_pure.1 == 2 {
        print("  PASS: Pure computation runs in pure sandbox\n")
    } else {
        print("  FAIL: Pure computation should run in pure sandbox\n")
    }

    let restricted = sandbox_policy_restricted()
    let exec_r = sandbox_execute(bc, restricted)
    if !effect_vm_has_error(&exec_r.0) {
        print("  PASS: Pure computation runs in restricted sandbox\n")
    } else {
        print("  FAIL: Pure computation should run in restricted sandbox\n")
    }

    print("\nAll effect handler tests completed.\n")
    0
}
