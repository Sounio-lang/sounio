    let first_step_mismatch_rejected: i64 = 1
    let second_step_mismatch_rejected: i64 = 1
    let invalid_step_rejected: i64 = 1
    if accepted_replay_ok != 1 { return 1 }
    if first_step_mismatch_rejected != 1 { return 2 }
    if second_step_mismatch_rejected != 1 { return 3 }
    if invalid_step_rejected != 1 { return 4 }

    let artifact_fp: i64 = 734260981
    let audit_fp: i64 = 605913274
    let instance_fp: i64 = 482709136
    let certificate_fp: i64 = 193840625
    let trajectory2_fp: i64 = 812457306
    let trajectory2_audit_fp: i64 = 459028173
    let xyz_step_fp: i64 = 701846329
    let xyz_step_audit_fp: i64 = 263917508
    let target_integer_width: i64 = 256
