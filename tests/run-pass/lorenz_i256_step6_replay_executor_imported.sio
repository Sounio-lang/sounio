//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 replay executor checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_replay_executor_check(
        490362827, 929938975, 641464796, 15, 15, 15, 15, 7)
    if artifact_fp != 975464919 { return 1 }
    let audit_fp = lorenz_i256_step6_replay_executor_audit_fingerprint(
        artifact_fp, 195235667, 81302823, 490362827, 772468073,
        929938975, 641464796, 6, 7, 255)
    if audit_fp != 376630542 { return 2 }
    return 0
}
