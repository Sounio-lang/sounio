//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v91 smoke for Lorenz i256 step-4 Taylor-2 replay preflight

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1949
    receipt_fp = mix(receipt_fp, 525394039, 5903)
    receipt_fp = mix(receipt_fp, 949135313, 5903)
    receipt_fp = mix(receipt_fp, 465157622, 5903)
    receipt_fp = mix(receipt_fp, 625996767, 5903)
    receipt_fp = mix(receipt_fp, 502064734, 5903)
    receipt_fp = mix(receipt_fp, 785386925, 5903)
    receipt_fp = mix(receipt_fp, 888891354, 5903)
    receipt_fp = mix(receipt_fp, 556038402, 5903)
    receipt_fp = mix(receipt_fp, 509176612, 5903)
    receipt_fp = mix(receipt_fp, 389227567, 5903)
    receipt_fp = mix(receipt_fp, 4, 5903)
    receipt_fp = mix(receipt_fp, 7, 5903)
    receipt_fp = mix(receipt_fp, 255, 5903)
    if receipt_fp != 968648040 { return 1 }

    var audit_fp: i64 = 1951
    audit_fp = mix(audit_fp, receipt_fp, 5923)
    audit_fp = mix(audit_fp, 525394039, 5923)
    audit_fp = mix(audit_fp, 949135313, 5923)
    audit_fp = mix(audit_fp, 465157622, 5923)
    audit_fp = mix(audit_fp, 625996767, 5923)
    audit_fp = mix(audit_fp, 556038402, 5923)
    audit_fp = mix(audit_fp, 509176612, 5923)
    audit_fp = mix(audit_fp, 888891354, 5923)
    audit_fp = mix(audit_fp, 4, 5923)
    audit_fp = mix(audit_fp, 7, 5923)
    audit_fp = mix(audit_fp, 255, 5923)
    if audit_fp != 611792998 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 94, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 94, 1103)
    if entry_fp != 666793345 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 91, 1151)
    manifest_fp = mix(manifest_fp, 95, 1151)
    manifest_fp = mix(manifest_fp, 785386925, 1151)
    manifest_fp = mix(manifest_fp, 502064734, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 271084941 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 91, 1871)
    result_fp = mix(result_fp, 95, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 83, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 745335905 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 91, 1907)
    family_fp = mix(family_fp, 95, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 78, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 686856637 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 91, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 915914304 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 91, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 520416831 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 91, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
