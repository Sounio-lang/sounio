//@ run-pass
//@ expect-stdout: PRIVATE_FIELD_BORROW_PUBLIC_PASS
use collections::numeric_buffer::{NumericValue}
struct LocalOwner { hidden:i64, other:i64 }
impl LocalOwner { fn reveal(self:&LocalOwner)->i64 { self.hidden } }
fn read(x:&i64)->i64 { *x }
fn write(x:&!i64,v:i64) with Mut { *x=v }
fn main()->i32 with IO,Mut,Panic {
 var owner=LocalOwner{hidden:11,other:22}
 write(&!owner.hidden,33)
 assert(read(&owner.hidden)==33&&owner.reveal()==33)
 // NumericBuffer.status in the SAME imported module is private; this typed
 // public receiver must not inherit its same-name field restriction.
 var public_value=NumericValue{value:1.0,status:7}
 write(&!public_value.status,9)
 assert(read(&public_value.status)==9)
 println("PRIVATE_FIELD_BORROW_PUBLIC_PASS");0
}
