//@ run-pass
// End-to-end GUM cross-function variance propagation test.
// Variance flows: measure() → .value → argument → callee parameter → return → caller.

fn add_values(x: f64, y: f64) -> f64 with Mut {
    // x and y carry variance via BSS shadow buffer
    let result = x + y   // GUM additive: var(x+y) = var(x) + var(y)
    return result
}

fn scale(x: f64, factor: f64) -> f64 with Mut {
    let result = x * factor  // GUM multiplicative: var(x*f) = x²·var(f) + f²·var(x)
    return result
}

fn main() with IO, Mut, Epistemic {
    let k1: Knowledge<f64> = measure(100.0, uncertainty: 2.0)
    let k2: Knowledge<f64> = measure(50.0, uncertainty: 1.0)
    let a = k1.value   // var(a) = 4.0
    let b = k2.value   // var(b) = 1.0

    // Cross-function additive: var should propagate through add_values
    let sum = add_values(a, b)

    // Cross-function multiplicative: scale(a, 2.0)
    // var(a*2) = a²·var(2) + 2²·var(a) = 0 + 4·4.0 = 16.0
    let scaled = scale(a, 2.0)

    // Introspect
    let va = variance_of(a)
    let vb = variance_of(b)
    let vs = variance_of(sum)
    let vsc = variance_of(scaled)

    print("var(a)="); println(va)
    print("var(b)="); println(vb)
    print("var(sum)="); println(vs)
    print("var(scaled)="); println(vsc)
    print("PASS\n")
}
