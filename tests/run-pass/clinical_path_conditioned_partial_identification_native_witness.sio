//@ run-pass
// Independent phased scalar executor for path-conditioned identification D8.

fn d8_native_bool(value: bool) -> i64 { if value { 1 } else { 0 } }

fn d8_native_has_a(mask: i64) -> bool {
    mask == 1 || mask == 3 || mask == 5 || mask == 7
}

fn d8_native_has_b(mask: i64) -> bool {
    mask == 2 || mask == 3 || mask == 6 || mask == 7
}

fn d8_native_has_c(mask: i64) -> bool {
    mask == 4 || mask == 5 || mask == 6 || mask == 7
}

fn d8_native_intersects(left: i64, right: i64) -> bool {
    (d8_native_has_a(left) && d8_native_has_a(right)) ||
    (d8_native_has_b(left) && d8_native_has_b(right)) ||
    (d8_native_has_c(left) && d8_native_has_c(right))
}

fn d8_native_ab_compatible(state_code: i64) -> bool with Panic {
    assert(state_code >= 1 && state_code <= 3)
    state_code == 1 || state_code == 2
}

fn d8_native_ba_compatible(state_code: i64) -> bool with Panic {
    assert(state_code >= 1 && state_code <= 3)
    state_code == 2 || state_code == 3
}

fn d8_native_evidence_compatible(state_code: i64) -> bool with Panic {
    assert(state_code >= 1 && state_code <= 3)
    state_code == 1 || state_code == 3
}

fn d8_native_summary_checksum() -> i64 {
    let step_0 = 13201 * 31 + 8800
    let step_1 = step_0 * 31 + 2
    let step_2 = step_1 * 31 + 4
    let step_3 = step_2 * 31 + 1
    step_3 * 31
}

fn d8_native_model_checksum() -> i64 {
    let step_0 = 12200 * 31 + 15001
    let step_1 = step_0 * 31 + 15002
    let step_2 = step_1 * 31 + 15003
    step_2 * 31 + 15004
}

fn d8_native_proxy_checksum() -> i64 {
    let step_0 = 12400 * 31 + 877
    step_0 * 31 + 13003
}

fn d8_native_phase_sets() with Panic {
    let a_state_id = 12001
    let b_state_id = 12002
    let c_state_id = 12003
    let family_fingerprint = (a_state_id * 31 + b_state_id) * 31 + c_state_id
    let collision_checksum = family_fingerprint * 31 + 877
    assert(family_fingerprint == 11917026)
    assert(collision_checksum == 369428683)

    let history_ab = 14001 * 31 + 14002
    let history_ba = 14002 * 31 + 14001
    assert(history_ab == 448033 && history_ba == 448063)
    assert(history_ab != history_ba)

    let initial_ab = d8_native_bool(d8_native_ab_compatible(1)) +
        2 * d8_native_bool(d8_native_ab_compatible(2)) +
        4 * d8_native_bool(d8_native_ab_compatible(3))
    let initial_ba = d8_native_bool(d8_native_ba_compatible(1)) +
        2 * d8_native_bool(d8_native_ba_compatible(2)) +
        4 * d8_native_bool(d8_native_ba_compatible(3))
    let evidence_mask = d8_native_bool(d8_native_evidence_compatible(1)) +
        2 * d8_native_bool(d8_native_evidence_compatible(2)) +
        4 * d8_native_bool(d8_native_evidence_compatible(3))
    assert(initial_ab == 3 && initial_ba == 6 && evidence_mask == 5)

    let refined_ab = d8_native_bool(
        d8_native_ab_compatible(1) && d8_native_evidence_compatible(1),
    ) + 2 * d8_native_bool(
        d8_native_ab_compatible(2) && d8_native_evidence_compatible(2),
    ) + 4 * d8_native_bool(
        d8_native_ab_compatible(3) && d8_native_evidence_compatible(3),
    )
    let refined_ba = d8_native_bool(
        d8_native_ba_compatible(1) && d8_native_evidence_compatible(1),
    ) + 2 * d8_native_bool(
        d8_native_ba_compatible(2) && d8_native_evidence_compatible(2),
    ) + 4 * d8_native_bool(
        d8_native_ba_compatible(3) && d8_native_evidence_compatible(3),
    )
    assert(refined_ab == 1 && refined_ba == 4)
    assert(!d8_native_intersects(refined_ab, refined_ba))

    let initial_ab_checksum = (12301 * 31 + history_ab) * 31 + initial_ab
    let initial_ba_checksum = (12302 * 31 + history_ba) * 31 + initial_ba
    let observation_checksum = (12401 * 31 + 15004) * 31 + evidence_mask
    let refined_ab_checksum = (initial_ab_checksum * 31 +
        observation_checksum) * 31 + refined_ab
    let refined_ba_checksum = (initial_ba_checksum * 31 +
        observation_checksum) * 31 + refined_ba
    assert(initial_ab_checksum == 25710287 && initial_ba_checksum == 25712181)
    assert(observation_checksum == 12382490)
    assert(refined_ab_checksum == 25091442998)
    assert(refined_ba_checksum == 25093263135)

    let ab_subset_checksum = (initial_ab * 31 + refined_ab) * 31 + 12601
    let ba_subset_checksum = (initial_ba * 31 + refined_ba) * 31 + 12602
    let ab_point_checksum = ((12501 * 31 + 12001) * 31 + 12101) * 31 + 12611
    let ba_point_checksum = ((12502 * 31 + 12003) * 31 + 12102) * 31 + 12612
    assert(ab_subset_checksum == 15515 && ba_subset_checksum == 18492)
    assert(ab_point_checksum == 384337994 && ba_point_checksum == 384369739)
}

fn d8_native_phase_overlap() with Panic {
    let common_checksum = (((12301 * 31 + 12302) * 31 + 12002) * 31 + 2)
    let initial_refusal_checksum = common_checksum * 7 + 3
    let separation_checksum = (12501 * 31 + 12502) * 31
    assert(common_checksum == 378653377)
    assert(initial_refusal_checksum == 2650573642)
    assert(separation_checksum == 12401023)

    let overlap_count =
        d8_native_bool(d8_native_intersects(1, 2)) +
        d8_native_bool(d8_native_intersects(1, 4)) +
        d8_native_bool(d8_native_intersects(1, 6)) +
        d8_native_bool(d8_native_intersects(2, 2)) +
        d8_native_bool(d8_native_intersects(2, 4)) +
        d8_native_bool(d8_native_intersects(2, 6)) +
        d8_native_bool(d8_native_intersects(3, 2)) +
        d8_native_bool(d8_native_intersects(3, 4)) +
        d8_native_bool(d8_native_intersects(3, 6))
    let completion_pairs = 9
    let disjoint_count = completion_pairs - overlap_count
    assert(overlap_count == 4 && disjoint_count == 5)
    let outer_ab_checksum = (12801 * 31 + 12301) * 31 + 3
    let outer_ba_checksum = (12802 * 31 + 12302) * 31 + 6
    let outer_step_0 = outer_ab_checksum * 31 + outer_ba_checksum
    let outer_step_1 = outer_step_0 * 31 + completion_pairs
    let outer_step_2 = outer_step_1 * 31 + overlap_count
    let outer_undecided_checksum = outer_step_2 * 31 + disjoint_count
    assert(outer_ab_checksum == 12683095 && outer_ba_checksum == 12684090)
    assert(outer_undecided_checksum == 12090976311463)
}

fn d8_native_phase_missing_conflict() with Panic {
    let missing_checksum = (12901 * 31 + 15004) * 31 + 12902
    let missing_abstention_checksum = (missing_checksum * 31 + 3) * 31 + 12903
    assert(missing_checksum == 12875887)
    assert(missing_abstention_checksum == 12373740403)

    let observation_provenance = ((16001 * 31 + 1) * 31 + 16101) * 31
    let missing_provenance = ((16002 * 31 + 2) * 31 + 16102) * 31 + 12351
    let conflict_provenance = ((16003 * 31 + 3) * 31 + 16103) * 31 + 12351
    assert(observation_provenance == 477185883)
    assert(missing_provenance == 477229017)
    assert(conflict_provenance == 477259800)
    let observation_decision = ((16101 * 31 + 15004) * 31 + 1) * 7
    let missing_decision = ((16102 * 31 + 15004) * 31 + 2) * 7 + 1
    let conflict_decision = ((16103 * 31 + 15004) * 31 + 3) * 7 + 2
    assert(observation_decision == 111567302)
    assert(missing_decision == 111574037)
    assert(conflict_decision == 111580772)

    let history_ab = 14001 * 31 + 14002
    let initial_ab_checksum = (12301 * 31 + history_ab) * 31 + 3
    let observation_checksum = (12401 * 31 + 15004) * 31 + 5
    let refined_ab_checksum = (initial_ab_checksum * 31 +
        observation_checksum) * 31 + 1
    let conflict_observation_checksum = (13101 * 31 + 15004) * 31 + 4
    let conflict_checksum = (refined_ab_checksum * 31 +
        conflict_observation_checksum) * 31
    assert(refined_ab_checksum == 25091442998)
    assert(conflict_observation_checksum == 13055189)
    assert(conflict_checksum == 24113281431937)
}

fn d8_native_phase_authority() with Panic {
    let d7_refusal_checksum = ((322833 * 31 + 17001) * 31 + 11901) * 7 + 3
    let model_checksum = d8_native_model_checksum()
    let association_checksum = (12301 * 31 + 12302) * 31 + 2
    let proxy_checksum = d8_native_proxy_checksum()
    let summary_checksum = d8_native_summary_checksum()
    assert(d7_refusal_checksum == 2175470118)
    assert(model_checksum == 11728748010)
    assert(association_checksum == 12202625)
    assert(proxy_checksum == 11956590)
    assert(summary_checksum == 386060470608)
}

fn main() with Panic {
    d8_native_phase_sets()
    d8_native_phase_overlap()
    d8_native_phase_missing_conflict()
    d8_native_phase_authority()

    println("D8-W0 states=3 scalar=877 collision_mask=7 family_fingerprint=11917026 collision_checksum=369428683")
    println("D8-W1 history_ab=448033 history_ba=448063 initial_ab=3 initial_ba=6 exact_intersection=2")
    print("D8-W2 evidence_mask=5 refined_ab=1 refined_ba=4 subset_checksums=15515,18492 ")
    println("point_checksums=384337994,384369739")
    println("D8-W3 initial_separation=false refusal_checksum=2650573642 refined_separation=true separation_checksum=12401023")
    println("D8-W4 outer_intersection=2 completion_pairs=9 overlap_completions=4 disjoint_completions=5 undecided_checksum=12090976311463")
    print("D8-W5 missing_result=3 missing_abstention_checksum=12373740403 ")
    println("conflict_result=0 conflict_checksum=24113281431937 nearest_state=false")
    print("D8-W6 provenance=477185883,477229017,477259800 ")
    println("policy_decisions=111567302,111574037,111580772")
    println("D8-W7 d7_cross_occurrence_refusal=2175470118")
    print("D8-W8 model_checksum=11728748010 ")
    println("rebracketing=false compiler_rewrites=0 contest_ir=0 ontology_transport=0")
    print("D8-W9 association=1 intervention=0 counterfactual=0 clinical_action=0 ")
    println("human_suffering=0 sealed=false summary_checksum=386060470608")
    println("PATH-CONDITIONED PARTIAL IDENTIFICATION D8 PASS")
}
