// Shared references stored in struct fields retain both reference and pointee metadata.
struct Buffer { x:i64, n:i64, data:[u8;16] }
struct Inputs { b:&Buffer }
struct Other { padding:i64, x:i64 }
struct OtherInput { b:&Other }
struct Envelope { input:&Inputs }
fn leaf(p:&Buffer)->i64 { assert(p.n==3); p.x }
fn read(p:&Inputs)->i64 {
    assert(p.b.x==7)
    assert(p.b.n==3)
    assert(leaf(p.b)==7)
    let r=p.b
    assert(r.x==7)
    { let r=r; assert(r.x==7) }
    p.b.x
}
fn other_read(p:&OtherInput)->i64 { p.b.x }
fn nested(p:&Envelope)->i64 { p.input.b.x }
fn main()->i32 with IO,Mut,Alloc,Panic {
    let b=Buffer{x:7,n:3,data:[0;16]}
    let p=Inputs{b:&b}
    assert(leaf(&b)==7)
    assert(read(&p)==7)
    let other=Other{padding:99,x:41}
    let different=OtherInput{b:&other}
    assert(other_read(&different)==41)
    let e=Envelope{input:&p}
    assert(nested(&e)==7)
    println("NAMED_REF_FIELDS_OK")
    0
}
