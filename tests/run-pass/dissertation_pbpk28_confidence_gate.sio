//@ run-pass
//@ description: PBPK28 rapamycin priors carried as Knowledge<f64> with literature ε.
//@ A dosing summary declared at the HONEST evidence ceiling (with Epistemic(400),
//@ the weakest prior) compiles and runs. The over-claim counterpart
//@ (with Epistemic(950)) is rejected — see compile-fail/dissertation_pbpk28_overclaim.sio.
//@ METHOD demonstration of compile-time confidence gates (dissertation Contribution 2);
//@ NOT a clinical dosing engine — ε is literature evidence-quality, not a probability.
//
// These are the real rapamycin priors from stdlib/darwin_pbpk/epistemic_pbpk28.sio
// (ep28_rapamycin_priors), where confidence was a plain f64 the type system could
// not see. Carried as Knowledge<f64, ε> they become first-class: the ε flows into
// the EpistemicComplete gate, so a function cannot claim more confidence than its
// weakest input supports.
//
//   cl_hepatic ε=0.65 (Jiao/Zhang 2009 pop-PK, CV≈38%)
//   fu_plasma  ε=0.72 (Schreiber 1991, CV≈25%)
//   kp_liver   ε=0.60 (Valoteau 1996, CV≈25%)
//   kp_adipose ε=0.40 (capped model, CV≈40%)   ← the weakest evidence
//
// Gate semantics (per-token, NOT combined): `with Epistemic(N)` requires EVERY
// input expression to individually carry confidence ≥ N. It does NOT certify the
// propagated/combined confidence of the result (that compounds far lower). So the
// maximum satisfiable N is the WEAKEST single prior, kp_adipose ε=0.40 → 400:
// verified that Epistemic(400) compiles but Epistemic(401) already rejects (and
// Epistemic(650) flags both kp_adipose and kp_liver). This is the type system
// refusing to let any under-evidenced input enter a high-confidence claim.

fn rapa_dosing_summary() -> f64 with Epistemic(400), Mut, Div, Panic {
    let cl_hepatic: Knowledge[f64] = Knowledge(12.4, ε=0.65, prov="Jiao2009_popPK_CV38");
    let fu_plasma:  Knowledge[f64] = Knowledge(0.08, ε=0.72, prov="Schreiber1991_CV25");
    let kp_liver:   Knowledge[f64] = Knowledge(5.40, ε=0.60, prov="Valoteau1996_CV25");
    let kp_adipose: Knowledge[f64] = Knowledge(0.30, ε=0.40, prov="capped_model_CV40");
    cl_hepatic.value + fu_plasma.value + kp_liver.value + kp_adipose.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    // Σ of the four prior central values (12.4 + 0.08 + 5.40 + 0.30 = 18.18),
    // proving the gated body actually compiled and executed.
    println(rapa_dosing_summary());
    println("PBPK28_CONFIDENCE_GATE_PASS");
}
