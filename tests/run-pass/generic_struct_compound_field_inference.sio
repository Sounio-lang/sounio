//@ run-pass
//@ requires: madaros
// A generic parameter nested in [F; N] must be inferred from the initializer.

struct Compound<F> {
    values: [F; 4],
    bits: i64,
}

fn main() -> i64 with Mut, Panic {
    let a = Compound { values: [1, 2, 3, 4], bits: 4 }
    if a.values[0] != 1 { return 1 }
    if a.values[3] != 4 { return 2 }
    if a.bits != 4 { return 3 }
    return 0
}
