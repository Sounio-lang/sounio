//@ run-pass
//@ requires: madaros
// A generic parameter nested in [F; N] must be inferred from the initializer.

struct Compound<F> {
    values: [F; 4],
    bits: i64,
}

fn copy_compound<F>(a: Compound<F>) -> Compound<F> with Mut, Panic {
    Compound { values: a.values, bits: a.bits }
}

fn main() -> i64 with Mut, Panic {
    let a = Compound { values: [1, 2, 3, 4], bits: 4 }
    let result = copy_compound::<i64>(a)
    if result.values[0] != 1 { return 1 }
    if result.values[3] != 4 { return 2 }
    if result.bits != 4 { return 3 }
    return 0
}
