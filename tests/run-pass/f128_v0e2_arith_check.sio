//@ run-pass
//@ check-only
//@ description: V0-E.2 — f128 source arithmetic typechecks on Madaros (no E004)
//@ ladder-stage: V0-E.2
//@ semantic-lane: WS-G-V0E-STDLIB-GUM-SURFACE
//
// Softfloat bit-identity remains V0-D; this stage admits source ops through
// `souc check`. Full Madaros-run lowering of ops is still progressive.
// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0e2

fn add128(a: f128, b: f128) -> f128 {
    a + b
}

fn sub128(a: f128, b: f128) -> f128 {
    a - b
}

fn mul128(a: f128, b: f128) -> f128 {
    a * b
}

fn div128(a: f128, b: f128) -> f128 {
    a / b
}

fn neg128(a: f128) -> f128 {
    -a
}

fn cmp128(a: f128, b: f128) -> bool {
    a < b
}

fn main() -> i32 {
    let _a = add128(1.0, 2.0)
    let _b = sub128(2.0, 1.0)
    let _c = mul128(2.0, 3.0)
    let _d = div128(4.0, 2.0)
    let _e = neg128(1.0)
    let _f = cmp128(1.0, 2.0)
    return 0
}
