//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v23 smoke for Lorenz ball-fixed guard-band step-policy decision

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 26 { return 0 - 1 }
    if instance_fp != 554569097 { return 0 - 1 }
    if certificate_fp != 414588992 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 26 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn guard_instance_fingerprint(scale: i64, steps: i64, margin_fp: i64) -> i64 with Mod {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if margin_fp != 494960746 { return 0 - 1 }

    var fp: i64 = 229
    fp = portfolio_mix(fp, scale, 2143)
    fp = portfolio_mix(fp, steps, 2143)
    fp = portfolio_mix(fp, margin_fp, 2143)
    return fp
}

fn guard_certificate_fingerprint(instance_fp: i64,
                                 guard_decision_fp: i64,
                                 min_ppm_margin: i64,
                                 shrink_threshold_ppm: i64,
                                 hold_threshold_ppm: i64,
                                 grow_threshold_ppm: i64,
                                 margin_mask: i64,
                                 action_code: i64,
                                 guard_band_code: i64,
                                 next_dt_num: i64,
                                 next_dt_den: i64) -> i64 with Mod {
    if instance_fp != 554569097 { return 0 - 1 }
    if guard_decision_fp != 833881722 { return 0 - 1 }
    if min_ppm_margin != 1273 { return 0 - 1 }
    if shrink_threshold_ppm != 0 { return 0 - 1 }
    if hold_threshold_ppm != 2000 { return 0 - 1 }
    if grow_threshold_ppm != 5000 { return 0 - 1 }
    if margin_mask != 15 { return 0 - 1 }
    if action_code != 1 { return 0 - 1 }
    if guard_band_code != 1 { return 0 - 1 }
    if next_dt_num != 1 { return 0 - 1 }
    if next_dt_den != 1 { return 0 - 1 }

    var fp: i64 = 233
    fp = portfolio_mix(fp, instance_fp, 2161)
    fp = portfolio_mix(fp, guard_decision_fp, 2161)
    fp = portfolio_mix(fp, min_ppm_margin, 2161)
    fp = portfolio_mix(fp, shrink_threshold_ppm, 2161)
    fp = portfolio_mix(fp, hold_threshold_ppm, 2161)
    fp = portfolio_mix(fp, grow_threshold_ppm, 2161)
    fp = portfolio_mix(fp, margin_mask, 2161)
    fp = portfolio_mix(fp, action_code, 2161)
    fp = portfolio_mix(fp, guard_band_code, 2161)
    fp = portfolio_mix(fp, next_dt_num, 2161)
    fp = portfolio_mix(fp, next_dt_den, 2161)
    return fp
}

fn portfolio_v23_manifest_fingerprint(guard_entry_fp: i64) -> i64 with Mod {
    if guard_entry_fp != 3812644 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 23, 1151)
    fp = portfolio_mix(fp, 27, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, guard_entry_fp, 1151)
    return fp
}

fn portfolio_v23_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 193159026 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 23, 1871)
    fp = portfolio_mix(fp, 27, 1871)
    fp = portfolio_mix(fp, 8, 1871)
    fp = portfolio_mix(fp, 17, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v23_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 193159026 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 23, 1907)
    fp = portfolio_mix(fp, 27, 1907)
    fp = portfolio_mix(fp, 4, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 17, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v23_readiness_fingerprint(
    manifest_fp: i64,
    result_coverage_fp: i64,
    family_coverage_fp: i64,
    acceptance_receipt_fp: i64,
    audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 193159026 { return 0 - 1 }
    if result_coverage_fp != 926894353 { return 0 - 1 }
    if family_coverage_fp != 291588905 { return 0 - 1 }
    if acceptance_receipt_fp != 975493822 { return 0 - 1 }
    if audit_receipt_fp != 718334294 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 23, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = guard_instance_fingerprint(1000000, 5, 494960746)
    if instance_fp != 554569097 { return 1 }

    let certificate_fp = guard_certificate_fingerprint(
        instance_fp, 833881722, 1273, 0, 2000, 5000, 15, 1, 1, 1, 1)
    if certificate_fp != 414588992 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(26, instance_fp, certificate_fp, 1, 26)
    if entry_fp != 3812644 { return 3 }

    let manifest_fp = portfolio_v23_manifest_fingerprint(entry_fp)
    if manifest_fp != 193159026 { return 4 }

    let result_coverage_fp = portfolio_v23_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 926894353 { return 5 }

    let family_coverage_fp = portfolio_v23_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 291588905 { return 6 }

    if portfolio_v23_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        975493822, 718334294) != 698832575 { return 7 }

    if guard_instance_fingerprint(1000000, 5, 494960747) != (0 - 1) { return 8 }
    if guard_certificate_fingerprint(
        instance_fp, 833881723, 1273, 0, 2000, 5000, 15, 1, 1, 1, 1) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(26, instance_fp, certificate_fp, 0, 26) != (0 - 1) { return 10 }
    if portfolio_v23_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 11 }
    if portfolio_v23_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 12 }
    if portfolio_v23_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 13 }
    if portfolio_v23_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        975493822, 718334295) != (0 - 1) { return 14 }

    return 0
}
