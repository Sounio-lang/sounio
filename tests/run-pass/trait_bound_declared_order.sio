//@ run-pass
//@ requires: madaros
//@ expect-stdout: TRAIT_BOUND_DECL_ORDER_OK

// Turbofish arguments bind to type parameters in the order of the `<...>`
// header, not in the order the parameters first appear in the signature;
// a trait bound is checked against the argument bound to its own parameter.
trait Lj { fn lj(self) -> f64 }
struct NaCl { pub z: i64 }
struct SrNa { pub z: i64 }
impl Lj for NaCl { fn lj(self) -> f64 { 0.300512 } }

fn pick<U, T>(a: T, b: U) -> U { b }
fn eps_second<U: Lj, T>(x: T, y: U) -> f64 { y.lj() }

fn main() -> i32 with IO {
    let r = pick::<i64, f64>(1.5, 7)
    let e = eps_second::<NaCl, SrNa>(SrNa { z: 0 }, NaCl { z: 0 })
    if r == 7 && e == 0.300512 { print("TRAIT_BOUND_DECL_ORDER_OK\n") }
    return 0
}
