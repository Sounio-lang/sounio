//@ run-pass
//@ description: #830 — an unsuffixed float literal arm adopts the sibling arm's f32 type at the if/else join
//@ expect-stdout: 2.500000
//@ expect-stdout: 0.000000
//@ expect-stdout: 1.000000
//@ expect-stdout: -1.500000

fn relu(x: f32) -> f32 {
    if x > 0.0 { x } else { 0.0 }
}

fn clamp_hi(x: f32) -> f32 {
    if x > 1.0 { 1.0 } else { x }
}

fn neg_or(x: f32, flag: bool) -> f32 {
    if flag { -1.5 } else { x }
}

fn main() -> i64 with IO {
    let a: f32 = 2.5
    let b: f32 = -3.0
    println(relu(a) as f64)
    println(relu(b) as f64)
    println(clamp_hi(a) as f64)
    println(neg_or(a, true) as f64)
    0
}
