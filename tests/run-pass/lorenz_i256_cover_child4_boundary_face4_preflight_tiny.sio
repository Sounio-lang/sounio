//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 boundary face4 preflight

fn child4_boundary_face4_preflight_check(
    child4_boundary_face3_preflight_fp: i64,
    child4_boundary_face3_preflight_audit_fp: i64,
    child4_boundary_face_obligations_fp: i64,
    child4_boundary_face_obligations_audit_fp: i64,
    boundary_gluing_obligation_mask: i64,
    face_obligation_mask: i64,
    prior_face_preflight_mask: i64,
    selected_face_index: i64,
    selected_face_mask: i64,
    face4_obligation_mask: i64,
    face4_verified_mask: i64,
    face4_proof_mask: i64,
    boundary_gluing_verified_mask: i64,
    boundary_gluing_proof_mask: i64,
    finite_cover_certificate_mask: i64,
    global_certificate_candidate_mask: i64,
    global_flowpipe_claim_mask: i64,
    face4_preflight_status: i64) -> i64 {
    if child4_boundary_face3_preflight_fp != 371946280 { return 0 - 1 }
    if child4_boundary_face3_preflight_audit_fp != 809527416 { return 0 - 1 }
    if child4_boundary_face_obligations_fp != 458306927 { return 0 - 1 }
    if child4_boundary_face_obligations_audit_fp != 766184391 { return 0 - 1 }
    if boundary_gluing_obligation_mask != 31 { return 0 - 1 }
    if face_obligation_mask != 31 { return 0 - 1 }
    if prior_face_preflight_mask != 15 { return 0 - 1 }
    if selected_face_index != 4 { return 0 - 1 }
    if selected_face_mask != 16 { return 0 - 1 }
    if face4_obligation_mask != 16 { return 0 - 1 }
    if face4_verified_mask != 0 { return 0 - 1 }
    if face4_proof_mask != 0 { return 0 - 1 }
    if boundary_gluing_verified_mask != 0 { return 0 - 1 }
    if boundary_gluing_proof_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_certificate_candidate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if face4_preflight_status != 85 { return 0 - 1 }
    return 486720951
}

fn main() -> i64 {
    let artifact = child4_boundary_face4_preflight_check(
        371946280, 809527416, 458306927, 766184391, 31, 31, 15, 4, 16, 16,
        0, 0, 0, 0, 0, 0, 0, 85)
    if artifact != 486720951 { return 1 }

    let audit_fp: i64 = 730519284
    let instance_fp: i64 = 918374062
    let certificate_fp: i64 = 604283791
    let boundary_face_count: i64 = 5
    let face4_topology_mask: i64 = 16
    let face4_orientation_mask: i64 = 16
    let face4_adjacency_mask: i64 = 16
    let face4_trace_mask: i64 = 16
    let face4_dependency_mask: i64 = 31
    let face4_preflight_mask: i64 = 16
    let face_preflight_progress_mask: i64 = 31
    let face4_pending_proof_mask: i64 = 16
    let solver_face4_action_mask: i64 = 16
    let ready_for_face4_proof_mask: i64 = 0
    let ok_mask: i64 = 255

    if audit_fp != 730519284 { return 2 }
    if instance_fp != 918374062 { return 3 }
    if certificate_fp != 604283791 { return 4 }
    if boundary_face_count != 5 { return 5 }
    if face4_topology_mask != 16 { return 6 }
    if face4_orientation_mask != 16 { return 7 }
    if face4_adjacency_mask != 16 { return 8 }
    if face4_trace_mask != 16 { return 9 }
    if face4_dependency_mask != 31 { return 10 }
    if face4_preflight_mask != 16 { return 11 }
    if face_preflight_progress_mask != 31 { return 12 }
    if face4_pending_proof_mask != 16 { return 13 }
    if solver_face4_action_mask != 16 { return 14 }
    if ready_for_face4_proof_mask != 0 { return 15 }
    if ok_mask != 255 { return 16 }

    let wrong_face3 = child4_boundary_face4_preflight_check(
        1, 809527416, 458306927, 766184391, 31, 31, 15, 4, 16, 16,
        0, 0, 0, 0, 0, 0, 0, 85)
    if wrong_face3 != 0 - 1 { return 17 }

    let wrong_prior = child4_boundary_face4_preflight_check(
        371946280, 809527416, 458306927, 766184391, 31, 31, 7, 4, 16, 16,
        0, 0, 0, 0, 0, 0, 0, 85)
    if wrong_prior != 0 - 1 { return 18 }

    let wrong_face_index = child4_boundary_face4_preflight_check(
        371946280, 809527416, 458306927, 766184391, 31, 31, 15, 3, 16, 16,
        0, 0, 0, 0, 0, 0, 0, 85)
    if wrong_face_index != 0 - 1 { return 19 }

    let fake_face4_proof = child4_boundary_face4_preflight_check(
        371946280, 809527416, 458306927, 766184391, 31, 31, 15, 4, 16, 16,
        0, 1, 0, 0, 0, 0, 0, 85)
    if fake_face4_proof != 0 - 1 { return 20 }

    let fake_global = child4_boundary_face4_preflight_check(
        371946280, 809527416, 458306927, 766184391, 31, 31, 15, 4, 16, 16,
        0, 0, 0, 0, 0, 0, 1, 85)
    if fake_global != 0 - 1 { return 21 }

    return 0
}
