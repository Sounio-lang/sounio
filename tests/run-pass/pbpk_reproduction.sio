//@ run-pass
// Reproduction of PBPK while-loop bug from PBPK_STABILITY_REPORT.md
// Pattern: struct mutation in while loop via intermediate Result struct

struct State {
    x: f64
}

struct StepResult {
    state_new: State
}

fn step(s: State) -> StepResult {
    return StepResult {
        state_new: State { x: s.x + 1.0 }
    }
}

fn main() -> i32 with IO {
    var st = State { x: 0.0 }
    var i = 0

    while i < 20 {
        let result = step(st)
        st = result.state_new  // BUG: Should update but report says freezes after ~2 iterations
        i = i + 1
    }

    // If bug exists: st.x will be ~2.0 instead of 20.0
    // If fixed: st.x will be 20.0
    return 0
}
