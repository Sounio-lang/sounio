//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v44 smoke for Lorenz i256 Taylor-2 remainder entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v44_lorenz_i256_taylor2_remainder_fingerprint(
        320985955, 980184978, 862964893, 130892363, 61654294, 2, 127)
    if receipt_fp != 873855189 { return 1 }

    let audit_fp = solver_portfolio_v44_lorenz_i256_taylor2_remainder_audit_fingerprint(
        receipt_fp, 320985955, 980184978, 609891562, 519708695, 61654294, 127)
    if audit_fp != 311965616 { return 2 }

    let manifest_fp = solver_portfolio_v44_lorenz_i256_taylor2_remainder_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 898788381 { return 3 }

    let result_fp = solver_portfolio_v44_result_coverage_fingerprint(
        44, 48, 10, 36, 1, 1, manifest_fp)
    if result_fp != 111151024 { return 4 }

    let family_fp = solver_portfolio_v44_checker_family_coverage_fingerprint(
        44, 48, 6, 4, 3, 2, 31, 2, manifest_fp)
    if family_fp != 595594845 { return 5 }

    let acceptance_fp = solver_portfolio_v44_acceptance_receipt_fingerprint(
        44, manifest_fp, result_fp)
    if acceptance_fp != 994398353 { return 6 }

    let audit_receipt_fp = solver_portfolio_v44_audit_receipt_fingerprint(
        44, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 193132116 { return 7 }

    let readiness_fp = solver_portfolio_v44_readiness_fingerprint(
        44, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 101774289 { return 8 }

    return 0
}
