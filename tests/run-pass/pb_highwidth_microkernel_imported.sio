//@ run-pass
//@ description: Imported bounded PB high-width microkernel smoke

use theorem::pb_highwidth_microkernel::*

fn main() -> i64 {
    let row_ok = pb_row3_ge_check(2, 1, 2, 2, 1, 3, 4, 1, 1, 0)
    if row_ok != 1 { return 1 }

    let forced_y = pb_row3_forced_lit_check(2, 1, 2, 2, 1, 3, 4, 1, 0 - 1, 0 - 1, 2)
    if forced_y != 1 { return 2 }

    let conflict = pb_row3_conflict_check(2, 1, 2, 2, 1, 3, 4, 1, 0, 1)
    if conflict != 1 { return 3 }

    let artifact = pb_highwidth_microkernel_receipt_check(1, 1, 1, 1, 1, 128, 0, 0, 0, 99)
    if artifact != 671902843 { return 4 }

    let audit = pb_highwidth_microkernel_audit_fingerprint(
        artifact, 914035627, 506781239, 1, 1, 1, 1, 1, 4, 4, 128, 0, 0, 0, 0, 99, 1023)
    if audit != 238570416 { return 5 }
    return 0
}
