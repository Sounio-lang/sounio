//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 radius candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1103
    fp = mix(fp, 5, 4843)
    fp = mix(fp, 4294967296, 4843)
    fp = mix(fp, 1000000, 4843)
    fp = mix(fp, 171451971, 4843)
    fp = mix(fp, 862108922, 4843)
    fp = mix(fp, 422368008, 4843)
    fp = mix(fp, 577119901, 4843)
    fp = mix(fp, 693506658, 4843)
    fp = mix(fp, 389624150, 4843)
    fp = mix(fp, 91000, 4843)
    fp = mix(fp, 290000, 4843)
    fp = mix(fp, 2000, 4843)
    fp = mix(fp, 390842024, 4843)
    fp = mix(fp, 1245540516, 4843)
    fp = mix(fp, 8589935, 4843)
    fp = mix(fp, 0, 4843)
    fp = mix(fp, 0, 4843)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 476305583 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 1109
    fp = mix(fp, instance, 4859)
    fp = mix(fp, 16363825400, 4859)
    fp = mix(fp, 10581737366, 4859)
    fp = mix(fp, 11827277882, 4859)
    fp = mix(fp, 2342514896, 4859)
    fp = mix(fp, 22906495, 4859)
    fp = mix(fp, 2365421391, 4859)
    fp = mix(fp, 554480275, 4859)
    fp = mix(fp, 1363813293, 4859)
    fp = mix(fp, 32244149, 4859)
    fp = mix(fp, 950000000, 4859)
    fp = mix(fp, 1800000000, 4859)
    fp = mix(fp, 100000000, 4859)
    fp = mix(fp, ok_mask, 4859)
    fp = mix(fp, 0, 4859)
    fp = mix(fp, 0, 4859)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 476305583 { return 0 - 1 }
    if certificate != 839289344 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 1117
    fp = mix(fp, instance, 4861)
    fp = mix(fp, certificate, 4861)
    fp = mix(fp, 171451971, 4861)
    fp = mix(fp, 862108922, 4861)
    fp = mix(fp, 2, 4861)
    fp = mix(fp, 5, 4861)
    fp = mix(fp, 554480275, 4861)
    fp = mix(fp, 1363813293, 4861)
    fp = mix(fp, 32244149, 4861)
    fp = mix(fp, 950000000, 4861)
    fp = mix(fp, 1800000000, 4861)
    fp = mix(fp, 100000000, 4861)
    fp = mix(fp, ok_mask, 4861)
    fp = mix(fp, 0, 4861)
    fp = mix(fp, 0, 4861)
    return fp
}

fn conversion_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let rx: i256 = 390842024 as i256
    let ry: i256 = 1245540516 as i256
    let rz: i256 = 8589935 as i256
    let x_conv_excess: i256 = rx * target_scale - (91000 as i256) * source_scale
    let y_conv_excess: i256 = ry * target_scale - (290000 as i256) * source_scale
    let z_conv_excess: i256 = rz * target_scale - (2000 as i256) * source_scale
    if x_conv_excess >= (0 as i256) {
        if y_conv_excess >= (0 as i256) {
            if z_conv_excess >= (0 as i256) {
                if x_conv_excess < target_scale {
                    if y_conv_excess < target_scale {
                        if z_conv_excess < target_scale { return 1 }
                    }
                }
            }
        }
    }
    return 0
}

fn xy_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x4_abs: i256 = 4920371098 as i256
    let z4: i256 = 4092986080 as i256
    let rhoz_abs: i256 = (28 as i256) * source_scale - z4
    let rx: i256 = 390842024 as i256
    let ry: i256 = 1245540516 as i256
    let rz: i256 = 8589935 as i256
    let dx_rad: i256 = 16363825400 as i256
    let prod_x_rhoz: i256 = 10581737366 as i256
    let dy_rad: i256 = 11827277882 as i256

    var mask: i64 = 0
    if dx_rad == (10 as i256) * (rx + ry) { mask = mask + 2 }

    let xrhoz_total: i256 =
        x4_abs * rz +
        rhoz_abs * rx +
        rx * rz
    if (prod_x_rhoz - (1 as i256)) * source_scale <= xrhoz_total {
        if prod_x_rhoz * source_scale > xrhoz_total { mask = mask + 4 }
    }
    if dy_rad == prod_x_rhoz + ry { mask = mask + 8 }
    return mask
}

fn z_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x4_abs: i256 = 4920371098 as i256
    let y4_abs: i256 = 8816077911 as i256
    let rx: i256 = 390842024 as i256
    let ry: i256 = 1245540516 as i256
    let rz: i256 = 8589935 as i256
    let prod_xy: i256 = 2342514896 as i256
    let beta_rad: i256 = 22906495 as i256
    let dz_rad: i256 = 2365421391 as i256
    let xy_total: i256 =
        x4_abs * ry +
        y4_abs * rx +
        rx * ry
    let beta_total: i256 = (8 as i256) * rz
    if (prod_xy - (1 as i256)) * source_scale <= xy_total {
        if prod_xy * source_scale > xy_total {
            if (beta_rad - (2 as i256)) * (3 as i256) < beta_total {
                if (beta_rad - (1 as i256)) * (3 as i256) >= beta_total {
                    if dz_rad == prod_xy + beta_rad { return 16 }
                }
            }
        }
    }
    return 0
}

fn next_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let dt_q: i256 = 42949672 as i256
    let rx: i256 = 390842024 as i256
    let ry: i256 = 1245540516 as i256
    let rz: i256 = 8589935 as i256
    let dx_rad: i256 = 16363825400 as i256
    let dy_rad: i256 = 11827277882 as i256
    let dz_rad: i256 = 2365421391 as i256
    let next_x: i256 = 554480275 as i256
    let next_y: i256 = 1363813293 as i256
    let next_z: i256 = 32244149 as i256
    let x_step_total: i256 = dt_q * dx_rad
    let y_step_total: i256 = dt_q * dy_rad
    let z_step_total: i256 = dt_q * dz_rad
    let x_step_lower: i256 = (next_x - rx - (1 as i256)) * source_scale
    let x_step_upper: i256 = (next_x - rx) * source_scale
    let y_step_lower: i256 = (next_y - ry - (1 as i256)) * source_scale
    let y_step_upper: i256 = (next_y - ry) * source_scale
    let z_step_lower: i256 = (next_z - rz - (1 as i256)) * source_scale
    let z_step_upper: i256 = (next_z - rz) * source_scale
    if x_step_lower <= x_step_total {
        if x_step_upper > x_step_total {
            if y_step_lower <= y_step_total {
                if y_step_upper > y_step_total {
                    if z_step_lower <= z_step_total {
                        if z_step_upper > z_step_total { return 32 }
                    }
                }
            }
        }
    }
    return 0
}

fn cap_mask() -> i64 {
    let next_x: i256 = 554480275 as i256
    let next_y: i256 = 1363813293 as i256
    let next_z: i256 = 32244149 as i256
    if next_x <= (950000000 as i256) {
        if next_y <= (1800000000 as i256) {
            if next_z <= (100000000 as i256) { return 64 }
        }
    }
    return 0
}

fn main() -> i64 {
    var ok_mask: i64 = 0
    ok_mask = ok_mask + conversion_mask()
    ok_mask = ok_mask + xy_radius_mask()
    ok_mask = ok_mask + z_radius_mask()
    ok_mask = ok_mask + next_radius_mask()
    ok_mask = ok_mask + cap_mask()
    if ok_mask != 127 { return 1 }

    let inst = instance_fp()
    if inst != 476305583 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 839289344 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 815806077 { return 4 }
    if certificate_fp(inst, 126) != (0 - 1) { return 5 }
    return 0
}
