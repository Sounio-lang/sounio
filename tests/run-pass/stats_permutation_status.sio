//@ run-pass
//@ expect-stdout: STATS_PERMUTATION_STATUS_PASS
use stats::permutation::{permutation_means,perm_test_means}
fn main() with IO, Mut, Div, Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 x[0]=1.0; x[1]=2.0; y[0]=7.0; y[1]=8.0
 assert(permutation_means(&x,0,&y,2,10,1,false).status == 1)
 assert(permutation_means(&x,257,&y,2,10,1,false).status == 1)
 assert(permutation_means(&x,128,&y,129,10,1,false).status == 1)
 assert(permutation_means(&x,2,&y,2,0,1,false).status == 2)
 assert(permutation_means(&x,2,&y,2,-1,1,false).status == 2)
 assert(permutation_means(&x,2,&y,2,100001,1,false).status == 2)
 assert(permutation_means(&x,10,&y,10,0,1,true).status == 4)
 let zero=0.0
 x[0]=zero/zero
 assert(permutation_means(&x,2,&y,2,10,1,false).status == 3)
 x[0]=1.0/zero
 assert(permutation_means(&x,2,&y,2,10,1,false).status == 3)
 x[0]=1.0e308; y[0]=0.0-1.0e308
 assert(permutation_means(&x,1,&y,1,10,1,false).status == 5)
 x[0]=1.0; y[0]=7.0
 let a=permutation_means(&x,2,&y,2,1000,2147483647,false)
 let b=permutation_means(&x,2,&y,2,1000,2147483646,false)
 assert(a.status == 0 && a.seed_used == 2147483646)
 assert(a.hits == b.hits && a.p_value == b.p_value)
 assert(perm_test_means(&x,2,&y,2,1000,2147483647) == a.p_value)
 assert(perm_test_means(&x,0,&y,2,1000,1) == 1.0)
 let e=permutation_means(&x,2,&y,2,0,0,true)
 assert(e.status == 0 && e.draws == 6 && e.hits == 2)
 assert(!e.mc_available && e.mc_lo == 0.0 && e.mc_hi == 0.0)
 println("STATS_PERMUTATION_STATUS_PASS")
 0
}
