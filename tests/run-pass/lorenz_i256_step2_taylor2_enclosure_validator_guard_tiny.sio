//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 Taylor-2 enclosure validator guard preserves non-claim masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1381
    fp = mix(fp, 2, 5171)
    fp = mix(fp, 424013491, 5171)
    fp = mix(fp, 409402480, 5171)
    fp = mix(fp, 725374434, 5171)
    fp = mix(fp, 443171640, 5171)
    fp = mix(fp, 444092349, 5171)
    fp = mix(fp, 1000000, 5171)
    fp = mix(fp, 84000, 5171)
    fp = mix(fp, 308000, 5171)
    fp = mix(fp, 22000, 5171)
    fp = mix(fp, 54480, 5171)
    fp = mix(fp, 267477, 5171)
    fp = mix(fp, 17173, 5171)
    fp = mix(fp, 29251, 5171)
    fp = mix(fp, 39980, 5171)
    fp = mix(fp, 4699, 5171)
    fp = mix(fp, 7, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 8, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 672898502 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1399
    fp = mix(fp, instance, 5179)
    fp = mix(fp, 83731, 5179)
    fp = mix(fp, 307457, 5179)
    fp = mix(fp, 21872, 5179)
    fp = mix(fp, 84000, 5179)
    fp = mix(fp, 308000, 5179)
    fp = mix(fp, 22000, 5179)
    fp = mix(fp, 7, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 8, 5179)
    fp = mix(fp, ok_mask, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 672898502 { return 0 - 1 }
    if certificate != 487522414 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1409
    fp = mix(fp, instance, 5189)
    fp = mix(fp, certificate, 5189)
    fp = mix(fp, 9, 5189)
    fp = mix(fp, 2, 5189)
    fp = mix(fp, 7, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 8, 5189)
    fp = mix(fp, ok_mask, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    return fp
}

fn enclosure_guard_mask() -> i64 {
    let x_need_ppm: i64 = 83731
    let y_need_ppm: i64 = 307457
    let z_need_ppm: i64 = 21872
    let x_margin_ppm: i64 = 84000
    let y_margin_ppm: i64 = 308000
    let z_margin_ppm: i64 = 22000
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0

    var pass_mask: i64 = 0
    if x_need_ppm <= x_margin_ppm { pass_mask = pass_mask + 1 }
    if y_need_ppm <= y_margin_ppm { pass_mask = pass_mask + 2 }
    if z_need_ppm <= z_margin_ppm { pass_mask = pass_mask + 4 }

    var ok_mask: i64 = 0
    if 424013491 > 0 {
        if 725374434 > 0 { ok_mask = ok_mask + 1 }
    }
    if x_need_ppm == 54480 + 29251 {
        if y_need_ppm == 267477 + 39980 {
            if z_need_ppm == 17173 + 4699 { ok_mask = ok_mask + 2 }
        }
    }
    if pass_mask == 7 { ok_mask = ok_mask + 4 }
    if validated_mask == 0 { ok_mask = ok_mask + 8 }
    if x_margin_ppm - x_need_ppm == 269 {
        if y_margin_ppm - y_need_ppm == 543 {
            if z_margin_ppm - z_need_ppm == 128 { ok_mask = ok_mask + 16 }
        }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if local_containment_mask == 0 { ok_mask = ok_mask + 64 }
    if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = enclosure_guard_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 672898502 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 487522414 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 702220657 { return 4 }
    if artifact_fp(inst, cert, 254) != (0 - 1) { return 5 }
    return 0
}
