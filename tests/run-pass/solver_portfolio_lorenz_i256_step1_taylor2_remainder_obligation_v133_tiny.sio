//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v133 smoke for Lorenz i256 step-1 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2221
    receipt_fp = mix(receipt_fp, 265853299, 6221)
    receipt_fp = mix(receipt_fp, 919608627, 6221)
    receipt_fp = mix(receipt_fp, 313127397, 6221)
    receipt_fp = mix(receipt_fp, 155192722, 6221)
    receipt_fp = mix(receipt_fp, 840177182, 6221)
    receipt_fp = mix(receipt_fp, 567532487, 6221)
    receipt_fp = mix(receipt_fp, 284405691, 6221)
    receipt_fp = mix(receipt_fp, 133154696, 6221)
    receipt_fp = mix(receipt_fp, 194048456, 6221)
    receipt_fp = mix(receipt_fp, 1, 6221)
    receipt_fp = mix(receipt_fp, 5, 6221)
    receipt_fp = mix(receipt_fp, 127, 6221)
    if receipt_fp != 993840454 { return 1 }

    var audit_fp: i64 = 2237
    audit_fp = mix(audit_fp, receipt_fp, 6229)
    audit_fp = mix(audit_fp, 265853299, 6229)
    audit_fp = mix(audit_fp, 919608627, 6229)
    audit_fp = mix(audit_fp, 313127397, 6229)
    audit_fp = mix(audit_fp, 155192722, 6229)
    audit_fp = mix(audit_fp, 133154696, 6229)
    audit_fp = mix(audit_fp, 194048456, 6229)
    audit_fp = mix(audit_fp, 284405691, 6229)
    audit_fp = mix(audit_fp, 1, 6229)
    audit_fp = mix(audit_fp, 5, 6229)
    audit_fp = mix(audit_fp, 127, 6229)
    if audit_fp != 232141983 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 136, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 136, 1103)
    if entry_fp != 721641728 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 133, 1151)
    manifest_fp = mix(manifest_fp, 137, 1151)
    manifest_fp = mix(manifest_fp, 567532487, 1151)
    manifest_fp = mix(manifest_fp, 840177182, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 656275273 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 133, 1871)
    result_fp = mix(result_fp, 137, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 125, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 577320044 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 133, 1907)
    family_fp = mix(family_fp, 137, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 120, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 118781846 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 133, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 223667055 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 133, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 850590681 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 133, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 551760019 { return 9 }
    return 0
