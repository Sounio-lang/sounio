//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz ball-fixed guard-band step-policy decision smoke

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn guard_decision_fingerprint(margin_fp: i64,
                              min_ppm_margin: i64,
                              hold_threshold_ppm: i64,
                              grow_threshold_ppm: i64) -> i64 {
    if margin_fp != 494960746 { return 0 - 1 }
    if min_ppm_margin != 1273 { return 0 - 1 }
    if hold_threshold_ppm != 2000 { return 0 - 1 }
    if grow_threshold_ppm != 5000 { return 0 - 1 }

    let shrink_threshold_ppm: i64 = 0
    let margin_mask: i64 = 15
    let action_hold_same_dt: i64 = 1
    let guard_band_hold_thin: i64 = 1
    let next_dt_num: i64 = 1
    let next_dt_den: i64 = 1
    if min_ppm_margin <= shrink_threshold_ppm { return 0 - 1 }
    if min_ppm_margin >= hold_threshold_ppm { return 0 - 1 }
    if min_ppm_margin >= grow_threshold_ppm { return 0 - 1 }

    var acc: i64 = 109
    acc = quality_mix(acc, margin_fp)
    acc = quality_mix(acc, min_ppm_margin)
    acc = quality_mix(acc, shrink_threshold_ppm)
    acc = quality_mix(acc, hold_threshold_ppm)
    acc = quality_mix(acc, grow_threshold_ppm)
    acc = quality_mix(acc, margin_mask)
    acc = quality_mix(acc, action_hold_same_dt)
    acc = quality_mix(acc, guard_band_hold_thin)
    acc = quality_mix(acc, next_dt_num)
    acc = quality_mix(acc, next_dt_den)
    return acc
}

fn main() -> i64 {
    let fp = guard_decision_fingerprint(494960746, 1273, 2000, 5000)
    if fp != 833881722 { return 1 }

    if 1273 <= 0 { return 2 }
    if 1273 >= 2000 { return 3 }
    if 1273 >= 5000 { return 4 }

    if guard_decision_fingerprint(494960747, 1273, 2000, 5000) != (0 - 1) { return 5 }
    if guard_decision_fingerprint(494960746, 1274, 2000, 5000) != (0 - 1) { return 6 }
    if guard_decision_fingerprint(494960746, 1273, 1999, 5000) != (0 - 1) { return 7 }
    if guard_decision_fingerprint(494960746, 1273, 2000, 4999) != (0 - 1) { return 8 }

    return 0
}
