//@ run-pass
//@ expect-stdout: STATS_PERMUTATION_UNITS_PASS
use stats::permutation::{perm_test_means}
fn main() with IO, Mut, Div, Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 x[0]=1.0e-20; x[1]=2.0e-20; x[2]=3.0e-20
 y[0]=7.0e-20; y[1]=8.0e-20; y[2]=9.0e-20
 let tiny=perm_test_means(&x,3,&y,3,2048,42)
 // The old fixed absolute tolerance treats every tiny statistic as a tie: p=1.
 assert(tiny < 0.25)
 x[0]=1.0; x[1]=2.0; x[2]=3.0
 y[0]=7.0; y[1]=8.0; y[2]=9.0
 let ordinary=perm_test_means(&x,3,&y,3,2048,42)
 assert(tiny == ordinary)
 println("STATS_PERMUTATION_UNITS_PASS")
 0
}
