//@ run-pass
//@ requires: madaros
//@ expect-stdout: zero 0.090000
//@ expect-stdout: other 0.360000
//@ expect-stdout: direct 0.090000
//@ expect-stdout: IF_CALL_COND_OK
// a = 5 +- 0.3, var = 0.09. flag(n) = n + 1.
// n = 0 takes the arm a. n = 5 takes 2*a.

fn flag(n: i64) -> i64 {
    n + 1
}

fn pick(x: f64, n: i64) -> f64 {
    if flag(n) < 2 {
        x
    } else {
        2.0 * x
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let zero = variance_of(pick(a, 0))
    let other = variance_of(pick(a, 5))
    let direct = variance_of(if flag(0) < 2 { a } else { 2.0 * a })
    print("zero ")
    print_f64(zero)
    println("")
    print("other ")
    print_f64(other)
    println("")
    print("direct ")
    print_f64(direct)
    println("")
    var fails: i64 = 0
    if zero < 0.089999 || zero > 0.090001 { fails = fails + 1 }
    if other < 0.359999 || other > 0.360001 { fails = fails + 1 }
    if direct < 0.089999 || direct > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("IF_CALL_COND_OK")
        0
    } else {
        println("IF_CALL_COND_FAIL")
        1
    }
}
