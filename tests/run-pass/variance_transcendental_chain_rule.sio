//@ run-pass
//@ requires: lean_single
//@ expect-stdout-contains: VARIANCE_TRANSCENDENTAL_CHAIN_RULE_OK
//@ description: first-order variance through sqrt/exp/ln/sin/tanh is f'(x)^2 Var(x), and a loop of exp terms in a helper matches the exact sum; expected values from an independent C++23 long-double oracle (0.004082 before the fix: the argument's own variance passed through unscaled)
ontology VT {
    class Parameter { property amount: f64 where amount >= 0.0 }
    class WellDepth subclass_of Parameter
}

fn boltz_sum(eps: Knowledge<WellDepth>) -> f64 with Epistemic, Mut, Div {
    let e: f64 = eps.value
    var s = 0.0
    var i: i64 = 1
    while i <= 4 {
        s = s + exp(0.0 - e * (i as f64) / 100.0)
        i = i + 1
    }
    s
}

fn close(got: f64, want: f64) -> bool {
    let d = got - want
    let a = if d < 0.0 { 0.0 - d } else { d }
    a <= 0.000000000001 * want
}

fn check(name: i64, got: f64, want: f64) -> i64 with IO {
    if close(got, want) { return 0 }
    print("FAIL case "); print_int(name); print(" got "); print_f64(got); print(" want "); print_f64(want); print("\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let ev: WellDepth = 34.2
    let eps: Knowledge<WellDepth> = measure(ev, uncertainty: 1.0)
    let e: f64 = eps.value
    var bad: i64 = 0
    bad = bad + check(1, variance_of(boltz_sum(eps)), 0.00145413607760126)
    bad = bad + check(2, variance_of(exp(0.0 - e / 100.0)), 0.00005045945719335512)
    bad = bad + check(3, variance_of(sqrt(e)), 0.007309941520467836)
    bad = bad + check(4, variance_of(ln(e)), 0.0008549639205225539)
    bad = bad + check(5, variance_of(sin(e / 10.0)), 0.009244714005817862)
    bad = bad + check(6, variance_of(tanh(e / 50.0)), 0.0001674585879291415)
    if bad == 0 { println("VARIANCE_TRANSCENDENTAL_CHAIN_RULE_OK"); return 0 }
    1
}
