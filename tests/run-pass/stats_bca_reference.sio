//@ run-pass
//@ expect-stdout: STATS_BCA_REFERENCE_PASS
use stats::bootstrap::{bootstrap_bca_mean}
use stats::bca_normal::{bca_normal_cdf,bca_normal_quantile}
use math::pure::{is_finite}
fn case_0() with Mut,Div,Panic {
var x:[f64;256]=[0.0;256]
x[0]=1.00000000000000000e+00
x[1]=2.00000000000000000e+00
x[2]=3.00000000000000000e+00
x[3]=4.00000000000000000e+00
x[4]=8.00000000000000000e+00
x[5]=1.00000000000000000e+01
let r=bootstrap_bca_mean(&x,6,512,9.49999999999999956e-01,42)
assert(r.status == 0)
assert(r.b == 512 && r.seed_used == 42)
assert(r.less_count == 264 && r.equal_count == 27)
assert(r.tail_resolved == true)
assert(is_finite(r.mean))
assert(abs(r.mean - 4.66666666666666696e+00) <= 2.70000000000000002e-08)
assert(is_finite(r.lo))
assert(abs(r.lo - 2.50000000000000000e+00) <= 2.70000000000000002e-08)
assert(is_finite(r.hi))
assert(abs(r.hi - 8.02926159609937784e+00) <= 2.70000000000000002e-08)
assert(abs(r.se / 1.37896731782839388e+00 - 1.0) < 3.0e-10)
assert(abs(r.bias_p - 5.41992187500000000e-01) < 3.0e-9)
assert(abs(r.z0 - 1.05453929524875312e-01) < 3.0e-9)
assert(abs(r.acceleration - 3.82112337388915216e-02) < 3.0e-9)
assert(abs(r.lower_p - 5.19390895140574640e-02) < 3.0e-9)
assert(abs(r.upper_p - 9.90558844572595465e-01) < 3.0e-9)
assert(x[0] == 1.00000000000000000e+00)
}
