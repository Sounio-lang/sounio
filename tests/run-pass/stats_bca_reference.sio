fn case_8() with Mut,Div,Panic {
var x:[f64;256]=[0.0;256]
x[0]=1.00000000000000000e+00
x[1]=2.00000000000000000e+00
x[2]=3.00000000000000000e+00
x[3]=4.00000000000000000e+00
x[4]=8.00000000000000000e+00
x[5]=1.00000000000000000e+01
let r=bootstrap_bca_mean(&x,6,8,9.49999999999999956e-01,42)
assert(r.status == 0)
assert(r.b == 8 && r.seed_used == 42)
assert(r.less_count == 4 && r.equal_count == 1)
assert(r.tail_resolved == false)
assert(is_finite(r.mean))
assert(abs(r.mean - 4.66666666666666696e+00) <= 2.70000000000000002e-08)
assert(is_finite(r.lo))
assert(abs(r.lo - 2.42236522358438089e+00) <= 2.70000000000000002e-08)
assert(is_finite(r.hi))
assert(abs(r.hi - 5.99191697101899834e+00) <= 2.70000000000000002e-08)
assert(abs(r.se / 1.46909296063391670e+00 - 1.0) < 3.0e-10)
assert(abs(r.bias_p - 5.62500000000000000e-01) < 3.0e-9)
assert(abs(r.z0 - 1.57310684610170698e-01) < 3.0e-9)
assert(abs(r.acceleration - 3.82112337388915216e-02) < 3.0e-9)
assert(abs(r.lower_p - 6.31105596697550814e-02) < 3.0e-9)
assert(abs(r.upper_p - 9.93071689444855688e-01) < 3.0e-9)
assert(x[0] == 1.00000000000000000e+00)
}
