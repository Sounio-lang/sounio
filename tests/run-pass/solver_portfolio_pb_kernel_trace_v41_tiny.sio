//@ run-pass
//@ description: Tiny portfolio v41 smoke for pseudo-Boolean kernel trace receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 443
    receipt_fp = mix(receipt_fp, 478581235, 2819)
    receipt_fp = mix(receipt_fp, 827870314, 2819)
    receipt_fp = mix(receipt_fp, 258927862, 2819)
    receipt_fp = mix(receipt_fp, 438043475, 2819)
    receipt_fp = mix(receipt_fp, 15302992, 2819)
    receipt_fp = mix(receipt_fp, 788938861, 2819)
    receipt_fp = mix(receipt_fp, 3, 2819)
    receipt_fp = mix(receipt_fp, 31, 2819)
    if receipt_fp != 666560586 { return 1 }

    var audit_fp: i64 = 449
    audit_fp = mix(audit_fp, receipt_fp, 2833)
    audit_fp = mix(audit_fp, 478581235, 2833)
    audit_fp = mix(audit_fp, 827870314, 2833)
    audit_fp = mix(audit_fp, 983550353, 2833)
    audit_fp = mix(audit_fp, 3, 2833)
    audit_fp = mix(audit_fp, 31, 2833)
    if audit_fp != 879678645 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 44, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 44, 1103)
    if entry_fp != 752808158 { return 3 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 41, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, 379464486, 1951)
    readiness_fp = mix(readiness_fp, 702770436, 1951)
    readiness_fp = mix(readiness_fp, 141353377, 1951)
    readiness_fp = mix(readiness_fp, 707086658, 1951)
    readiness_fp = mix(readiness_fp, 860179250, 1951)
    if readiness_fp != 801644191 { return 4 }
    return 0
}
