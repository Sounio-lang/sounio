//@ run-pass
// Door 2: minimal kernel fn — verifies keyword (TK=79), GPU effect (bit 13=8192),
// and FN_IS_KERNEL marking all work without a real GPU present.
// The kernel body is compiled but only dispatched if libcuda.so is available;
// on CPU-only machines the runtime skips silently and main() returns 0.

kernel fn add_scalar(n: i64, a: &[f64], b: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        b[tid as usize] = a[tid as usize] + 1.0
    }
}

fn main() -> i32 with IO {
    0
}
