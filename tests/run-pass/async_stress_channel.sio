//@ run-pass
//@ expect-stdout-contains: stress_channel: PASS
//@ native-pass
// Stress: many sequential sends through a single channel — probes pipe buffering

fn main() with IO, Async {
    let (tx, rx) = channel::<i32>()

    // Producer sends 8 values before parent reads any (tests pipe buffer)
    spawn {
        tx.send(10).await
        tx.send(20).await
        tx.send(30).await
        tx.send(40).await
        tx.send(50).await
        tx.send(60).await
        tx.send(70).await
        tx.send(80).await
    }

    let r1 = rx.recv().await
    let r2 = rx.recv().await
    let r3 = rx.recv().await
    let r4 = rx.recv().await
    let r5 = rx.recv().await
    let r6 = rx.recv().await
    let r7 = rx.recv().await
    let r8 = rx.recv().await

    if r1 == 10 && r2 == 20 && r3 == 30 && r4 == 40 {
        if r5 == 50 && r6 == 60 && r7 == 70 && r8 == 80 {
            print("stress_channel: PASS\n")
        } else {
            print("stress_channel: FAIL\n")
        }
    } else {
        print("stress_channel: FAIL\n")
    }
}
