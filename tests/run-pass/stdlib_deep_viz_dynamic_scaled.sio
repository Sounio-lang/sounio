//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_DYNAMIC_SCALED_PASS
//@ expect-stdout: data-x-scale="1" data-y-scale="2"
//@ expect-stdout: data-axis-layout="fitted"
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_at,integer_buffer_set,integer_buffer_close}
use display::canvas::{Canvas,canvas_clear}
use viz::scale::{ScaleSpec}
use viz::dynamic_plot::{DynamicPlotSpec}
use viz::dynamic_scaled_plot::{dynamic_scaled_plot,dynamic_scale_xy,dynamic_scale_intervals,dynamic_scaled_line_canvas,dynamic_scaled_line_svg,dynamic_scaled_interval_canvas,dynamic_scaled_interval_svg}
use viz::ir::{viz_scene_new,viz_add_fitted_axis,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn interval_panel(c:&!Canvas,xs:&ScaleSpec,ys:&ScaleSpec) with IO,Alloc,Mut,Div,Panic {
 var x=numeric_buffer_new(3,24);var mean=numeric_buffer_new(3,24)
 var lower=numeric_buffer_new(3,24);var upper=numeric_buffer_new(3,24)
 var tx=numeric_buffer_new(3,24);var tm=numeric_buffer_new(3,24)
 var tl=numeric_buffer_new(3,24);var tu=numeric_buffer_new(3,24)
 var mask=integer_buffer_new(3,24)
 let xv:[f64;3]=[1.0,20.0,1000.0]
 let mv:[f64;3]=[-9.0,0.0,9.0];let lv:[f64;3]=[-19.0,-1.0,3.0];let uv:[f64;3]=[-3.0,1.0,19.0]
 var i:i64=0
 while i<3 {
  let a=numeric_buffer_set(&!x,i,xv[i as usize]);let b=numeric_buffer_set(&!mean,i,mv[i as usize])
  let d=numeric_buffer_set(&!lower,i,lv[i as usize]);let e=numeric_buffer_set(&!upper,i,uv[i as usize])
  let f=integer_buffer_set(&!mask,i,1)
  let p=numeric_buffer_set(&!tx,i,777.0);let q=numeric_buffer_set(&!tm,i,777.0)
  let r=numeric_buffer_set(&!tl,i,777.0);let t=numeric_buffer_set(&!tu,i,777.0)
  i=i+1
 }
 // Nonpositive logarithmic lower bounds reject all four outputs atomically.
 let rejected=dynamic_scale_intervals(&x,&mean,&lower,&upper,&mask,&!tx,&!tm,&!tl,&!tu,xs,xs)
 assert(rejected.status==4 && rejected.written==0)
 i=0
 while i<3 {assert(numeric_buffer_at(&tx,i)==777.0 && numeric_buffer_at(&tm,i)==777.0 && numeric_buffer_at(&tl,i)==777.0 && numeric_buffer_at(&tu,i)==777.0);i=i+1}
 let raw=DynamicPlotSpec{x:500,y:20,w:180,h:100,xmin:1.0,xmax:1000.0,ymin:-9.0,ymax:9.0,r:230,g:120,b:40,interval_kind:1,level:0.95}
 let spec=dynamic_scaled_plot(&raw,xs,ys)
 assert(spec.status==0)
 let painted=dynamic_scaled_interval_canvas(c,&spec,&x,&mean,&lower,&upper,&mask,&!tx,&!tm,&!tl,&!tu)
 assert(painted.status==0 && painted.visible_primitives==10)
 let emitted=dynamic_scaled_interval_svg(&spec,&x,&mean,&lower,&upper,&mask,&!tx,&!tm,&!tl,&!tu,2)
 assert(emitted.status==0 && emitted.visible_primitives==10)
 numeric_buffer_close(x);numeric_buffer_close(mean);numeric_buffer_close(lower);numeric_buffer_close(upper)
 numeric_buffer_close(tx);numeric_buffer_close(tm);numeric_buffer_close(tl);numeric_buffer_close(tu);integer_buffer_close(mask)
}
fn main() with IO,Alloc,Mut,Div,Panic {
 let xs=ScaleSpec{mode:1,constant:1.0};let ys=ScaleSpec{mode:2,constant:1.0}
 var x=numeric_buffer_new(8,64);var y=numeric_buffer_new(8,64)
 var tx=numeric_buffer_new(8,64);var ty=numeric_buffer_new(8,64)
 var mask=integer_buffer_new(8,64);var indices=integer_buffer_new(8,64)
 let xv:[f64;8]=[1.0,2.0,5.0,-1.0,20.0,50.0,101.0,1000.0]
 let yv:[f64;8]=[-9.0,-3.0,-1.0,0.0,1.0,3.0,9.0,0.0]
 var i:i64=0
 while i<8 {
  let a=numeric_buffer_set(&!x,i,xv[i as usize]);let b=numeric_buffer_set(&!y,i,yv[i as usize])
  let d=integer_buffer_set(&!mask,i,if i==3 {0}else{1})
  let e=numeric_buffer_set(&!tx,i,777.0);let f=numeric_buffer_set(&!ty,i,777.0)
  i=i+1
 }
 let nan=0.0/0.0
 let inactive=numeric_buffer_set(&!y,3,nan)
 let invalid=numeric_buffer_set(&!x,7,0.0)
 let failed=dynamic_scale_xy(&x,&y,&mask,&!tx,&!ty,&xs,&ys)
 assert(failed.status==4 && failed.written==0)
 i=0
 while i<8 {assert(numeric_buffer_at(&tx,i)==777.0 && numeric_buffer_at(&ty,i)==777.0);i=i+1}
 let restore=numeric_buffer_set(&!x,7,1000.0)
 let raw=DynamicPlotSpec{x:100,y:20,w:180,h:100,xmin:1.0,xmax:1000.0,ymin:-9.0,ymax:9.0,r:70,g:180,b:235,interval_kind:0,level:0.0}
 let spec=dynamic_scaled_plot(&raw,&xs,&ys)
 assert(spec.status==0)
 let pixels=heap_alloc(800*200*8) as *mut i64
 assert((pixels as i64)>0)
 var canvas=Canvas{pixels:pixels,width:800,height:200}
 canvas_clear(&!canvas,0,0,0)
 let painted=dynamic_scaled_line_canvas(&!canvas,&spec,&x,&y,&mask,&!tx,&!ty,&!indices,3)
 assert(painted.status==0 && painted.stage==3 && painted.selected==7)
 assert(numeric_buffer_at(&tx,3)==777.0 && numeric_buffer_at(&ty,3)==777.0)
 println("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"800\" height=\"200\" viewBox=\"0 0 800 200\">")
 let emitted=dynamic_scaled_line_svg(&spec,&x,&y,&mask,&!tx,&!ty,&!indices,3,1)
 assert(emitted.status==0 && emitted.visible_primitives==painted.visible_primitives)
 interval_panel(&!canvas,&xs,&ys)
 println("</svg>")
 i=0
 while i<painted.selected {let index:i64=integer_buffer_at(&indices,i);print("SCALED_INDEX ");print(i);print(" ");println(index);i=i+1}
 // Public fitted axes receive exactly the same raw domains and ScaleSpecs.
 var axes=viz_scene_new()
 let horizontal=viz_add_fitted_axis(&!axes,1.0,1000.0,3,false,viz_layout_rect(100,130,180,1),800,200,&xs,viz_style_rgb(180,180,180))
 let vertical=viz_add_fitted_axis(&!axes,-9.0,9.0,2,true,viz_layout_rect(100,20,1,100),800,200,&ys,viz_style_rgb(180,180,180))
 assert(horizontal.status==0 && vertical.status==0)
 viz_canvas_render_scene(&axes,&!canvas)
 viz_html_emit_scene(&axes,800,200)
 var py:i64=0
 while py<200 {
  var px:i64=0
  while px<800 {
   let color:i64=read_i64(canvas.pixels,py*800+px)
   if color!=0 {print("SCALED_PIXEL ");print(px);print(" ");print(py);print(" ");println(color)}
   px=px+1
  }
  py=py+1
 }
 heap_free(canvas.pixels as *mut i8)
 numeric_buffer_close(x);numeric_buffer_close(y);numeric_buffer_close(tx);numeric_buffer_close(ty)
 integer_buffer_close(mask);integer_buffer_close(indices)
 println("STDLIB_DEEP_VIZ_DYNAMIC_SCALED_PASS")
}
