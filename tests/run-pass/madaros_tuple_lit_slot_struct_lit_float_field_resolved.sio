//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_STRUCT_LIT_FLOAT_FIELD_RESOLVED PASS
//
// Copilot review (PR #2516), round 12: the ExprStructLit arm
// expr_receiver_struct_type_ref (self-hosted/ir/lower.sio) gained alongside
// its ExprBlock/ExprIf/ExprMatch siblings had no regression witness --
// existing coverage (madaros_tuple_lit_slot_call_base_float_field_resolved.sio)
// only exercises a CALL/METHOD-CALL owner, so removing the ExprStructLit arm
// specifically would leave the suite green while a field read straight off
// an INLINE struct literal, like `(FloatHolder { values: [...] }.values, 0)`,
// silently regressed back to the integer-element path.
//
// IntNamesake exists ONLY to register a same-named `values: [i64; N]` field
// in the struct-layout table -- the exact shape the old by-name fallback
// (removed in round 9) used to match incorrectly -- proving this resolves
// via the struct LITERAL's own path-named type (ir_path_first_name), not a
// by-name scan that would also match IntNamesake and could get lucky for
// the wrong reason.
struct FloatHolder {
    values: [f64; 2],
}

struct IntNamesake {
    values: [i64; 2],
}

fn main() -> i32 with IO, Mut, Panic {
    let namesake = IntNamesake { values: [7, 11] }
    let extra: i64 = namesake.values[0]

    let (a, n) = (FloatHolder { values: [1.5, 0.25] }.values, 0)
    let s0: f64 = a[0] * 2.0

    if s0 == 3.0 && n == 0 && extra == 7 {
        println("TUPLE_LIT_SLOT_STRUCT_LIT_FLOAT_FIELD_RESOLVED PASS")
        return 0
    }
    1
}
