//@ run-pass
//@ requires: madaros
//@ description: Tiny SAT resolution proof-chain certificate

fn res_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn lit_abs(lit: i64) -> i64 {
    if lit < 0 { return 0 - lit }
    return lit
}

fn lit_complement(a: i64, b: i64) -> i64 {
    if a + b == 0 {
        if a != 0 { return 1 }
    }
    return 0
}

fn active_clause(id: i64, added5: i64, added6: i64, added7: i64) -> i64 {
    if id == 1 { return 1 } // x OR y
    if id == 2 { return 1 } // -x OR z
    if id == 3 { return 1 } // -y
    if id == 4 { return 1 } // -z
    if id == 5 { return added5 } // y OR z
    if id == 6 { return added6 } // z
    if id == 7 { return added7 } // empty
    return 0
}

fn clause_len(id: i64) -> i64 {
    if id == 1 { return 2 }
    if id == 2 { return 2 }
    if id == 3 { return 1 }
    if id == 4 { return 1 }
    if id == 5 { return 2 }
    if id == 6 { return 1 }
    if id == 7 { return 0 }
    return 0 - 1
}

fn clause_lit(id: i64, pos: i64) -> i64 {
    if id == 1 {
        if pos == 0 { return 1 }
        if pos == 1 { return 2 }
    }
    if id == 2 {
        if pos == 0 { return 0 - 1 }
        if pos == 1 { return 3 }
    }
    if id == 3 {
        if pos == 0 { return 0 - 2 }
    }
    if id == 4 {
        if pos == 0 { return 0 - 3 }
    }
    if id == 5 {
        if pos == 0 { return 2 }
        if pos == 1 { return 3 }
    }
    if id == 6 {
        if pos == 0 { return 3 }
    }
    return 0
}

fn contains_lit(id: i64, lit: i64) -> i64 {
    let n = clause_len(id)
    var i: i64 = 0
    while i < n {
        if clause_lit(id, i) == lit { return 1 }
        i = i + 1
    }
    return 0
}

fn output_contains(out0: i64, out1: i64, out_len: i64, lit: i64) -> i64 {
    if out_len >= 1 {
        if out0 == lit { return 1 }
    }
    if out_len >= 2 {
        if out1 == lit { return 1 }
    }
    return 0
}

fn output_tautology(out0: i64, out1: i64, out_len: i64) -> i64 {
    if out_len == 2 {
        return lit_complement(out0, out1)
    }
    return 0
}

fn output_duplicate(out0: i64, out1: i64, out_len: i64) -> i64 {
    if out_len == 2 {
        if out0 == out1 { return 1 }
    }
    return 0
}

fn check_resolution_step(p1: i64, p2: i64, pivot: i64,
                         out0: i64, out1: i64, out_len: i64,
                         added5: i64, added6: i64) -> i64 {
    if pivot <= 0 { return 0 }
    if out_len < 0 { return 0 }
    if out_len > 2 { return 0 }
    if active_clause(p1, added5, added6, 0) == 0 { return 0 }
    if active_clause(p2, added5, added6, 0) == 0 { return 0 }
    if output_tautology(out0, out1, out_len) == 1 { return 0 }
    if output_duplicate(out0, out1, out_len) == 1 { return 0 }

    var seen_pos: i64 = 0
    var seen_neg: i64 = 0
    if contains_lit(p1, pivot) == 1 { seen_pos = 1 }
    if contains_lit(p2, pivot) == 1 { seen_pos = 1 }
    if contains_lit(p1, 0 - pivot) == 1 { seen_neg = 1 }
    if contains_lit(p2, 0 - pivot) == 1 { seen_neg = 1 }
    if seen_pos != 1 { return 0 }
    if seen_neg != 1 { return 0 }

    var expected_count: i64 = 0
    var i: i64 = 0
    while i < clause_len(p1) {
        let lit = clause_lit(p1, i)
        if lit_abs(lit) != pivot {
            expected_count = expected_count + 1
            if output_contains(out0, out1, out_len, lit) == 0 { return 0 }
        }
        i = i + 1
    }
    i = 0
    while i < clause_len(p2) {
        let lit = clause_lit(p2, i)
        if lit_abs(lit) != pivot {
            expected_count = expected_count + 1
            if output_contains(out0, out1, out_len, lit) == 0 { return 0 }
        }
        i = i + 1
    }
    if expected_count != out_len { return 0 }
    return 1
}

fn sat_resolution_instance_fingerprint() -> i64 with Mod {
    var fp: i64 = 137
    fp = res_mix(fp, 3, 1301) // var count
    fp = res_mix(fp, 4, 1301) // base clause count
    fp = res_mix(fp, 3, 1301) // derived clause count
    fp = res_mix(fp, 0, 1301) // final clause length
    fp = res_mix(fp, 1, 1301) // pivots x,y,z
    fp = res_mix(fp, 2, 1301)
    fp = res_mix(fp, 3, 1301)
    return fp
}

fn sat_resolution_certificate_fingerprint(instance_fp: i64,
                                          ok5: i64, ok6: i64, ok7: i64) -> i64 with Mod {
    if instance_fp != 829764719 { return 0 - 1 }
    if ok5 != 1 { return 0 - 1 }
    if ok6 != 1 { return 0 - 1 }
    if ok7 != 1 { return 0 - 1 }

    var fp: i64 = 139
    fp = res_mix(fp, instance_fp, 1327)
    fp = res_mix(fp, 3, 1327)
    fp = res_mix(fp, 1, 1327)
    fp = res_mix(fp, 2, 1327)
    fp = res_mix(fp, 1, 1327)
    fp = res_mix(fp, 2, 1327)
    fp = res_mix(fp, 2, 1327)
    fp = res_mix(fp, 3, 1327)
    fp = res_mix(fp, 5, 1327)
    fp = res_mix(fp, 3, 1327)
    fp = res_mix(fp, 2, 1327)
    fp = res_mix(fp, 1, 1327)
    fp = res_mix(fp, 3, 1327)
    fp = res_mix(fp, 0, 1327)
    fp = res_mix(fp, 0, 1327)
    fp = res_mix(fp, 6, 1327)
    fp = res_mix(fp, 4, 1327)
    fp = res_mix(fp, 3, 1327)
    fp = res_mix(fp, 0, 1327)
    fp = res_mix(fp, 0, 1327)
    fp = res_mix(fp, 0, 1327)
    return fp
}

fn main() -> i64 {
    let ok5 = check_resolution_step(1, 2, 1, 2, 3, 2, 0, 0)
    let ok6 = check_resolution_step(5, 3, 2, 3, 0, 1, 1, 0)
    let ok7 = check_resolution_step(6, 4, 3, 0, 0, 0, 1, 1)
    let instance_fp = sat_resolution_instance_fingerprint()
    let cert_fp = sat_resolution_certificate_fingerprint(instance_fp, ok5, ok6, ok7)

    if ok5 != 1 { return 1 }
    if ok6 != 1 { return 2 }
    if ok7 != 1 { return 3 }
    if check_resolution_step(1, 2, 1, 3, 2, 2, 0, 0) != 1 { return 4 }
    if check_resolution_step(1, 2, 2, 2, 3, 2, 0, 0) != 0 { return 5 }
    if check_resolution_step(1, 2, 1, 2, 0 - 2, 2, 0, 0) != 0 { return 6 }
    if check_resolution_step(5, 3, 2, 3, 0, 1, 0, 0) != 0 { return 7 }
    if check_resolution_step(6, 4, 3, 0, 0, 0, 1, 0) != 0 { return 8 }
    if instance_fp != 829764719 { return 9 }
    if cert_fp != 177576187 { return 10 }
    if sat_resolution_certificate_fingerprint(instance_fp, ok5, 0, ok7) != (0 - 1) { return 11 }
    return 0
}
