        482555681, 591288676, 468517435, 402376335, 675936756,
        237552477, 373523570, 268229078, 223161586, 2, 20, 255)
    if receipt_fp != 867385129 { return 1 }
    let audit_fp = solver_portfolio_v115_lorenz_i256_step2_taylor2_response_envelope_audit_fingerprint(
        receipt_fp, 482555681, 591288676, 468517435, 402376335,
        268229078, 223161586, 373523570, 2, 20, 255)
    if audit_fp != 50054842 { return 2 }
    let manifest_fp = solver_portfolio_v115_lorenz_i256_step2_taylor2_response_envelope_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 242024859 { return 3 }
    let result_fp = solver_portfolio_v115_result_coverage_fingerprint(115, 119, 10, 107, 1, 1, manifest_fp)
    if result_fp != 828729430 { return 4 }
