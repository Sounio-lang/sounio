//@ run-pass
//@ timeout: 180
//@ expect-stdout: QTP_KETO_DISCRIMINANT_PASS
// ============================================================================
// DISSERTATION - QUETIAPINE KETOCONAZOLE VARIANT (static DDI follow-up)
// ============================================================================
// The inhibited profile is a full constant literal with CL 16.8 L/h
// (NM 84.0 / label AUCR 5.0, drugs/quetiapine.sio) and nothing else changed.
// Dynamic inhibitor PK is out of scope. This test runs NM and inhibited
// side by side and requires: (a) inhibited CL is exactly 16.8 L/h;
// (b) AUCR = inhibited AUC / NM AUC is in [4.0, 6.0] (label x5);
// (c) total mass stays within [0, absorbed] for both arms (conservation).
// ============================================================================

use darwin_pbpk::scenarios::quetiapine_oral::*

fn run_qtp_arm(p: PBPKParams28, dt: f64, horizon: f64) -> f64 with Mut, Div {
    var scen = qtp_scenario_init()
    var t = 0.0
    var auc = 0.0
    while t + dt * 0.5 < horizon {
        scen = qtp_step(scen, p, t, dt)
        auc = auc + scen.pbpk.cv[0] * dt
        t = t + dt
    }
    return auc
}

fn main() -> i32 with IO, Mut, Div {
    let p_nm = qtp_pbpk28_params()
    let p_keto = qtp_pbpk28_params_ketoconazole()
    print("QTP|cl_nm=")
    println(p_nm.cl_central)
    print("QTP|cl_keto=")
    println(p_keto.cl_central)
    if p_keto.cl_central != 16.8 {
        println("QTP_KETO_DISCRIMINANT_FAIL")
        return 1
    }
    let dt = 0.01
    let horizon = 120.0
    let auc_nm = run_qtp_arm(p_nm, dt, horizon)
    let auc_keto = run_qtp_arm(p_keto, dt, horizon)
    var scen_nm = qtp_scenario_init()
    var scen_keto = qtp_scenario_init()
    var t = 0.0
    var cum = 0.0
    while t + dt * 0.5 < horizon {
        cum = cum + qtp_release_rate_at(t + 0.5 * dt) * dt
        scen_nm = qtp_step(scen_nm, p_nm, t, dt)
        scen_keto = qtp_step(scen_keto, p_keto, t, dt)
        t = t + dt
    }
    let m_nm = pbpk28_total_mass(scen_nm.pbpk, p_nm)
    let m_keto = pbpk28_total_mass(scen_keto.pbpk, p_keto)
    print("QTP|auc_nm=")
    println(auc_nm)
    print("QTP|auc_keto=")
    println(auc_keto)
    print("QTP|mass_nm=")
    println(m_nm)
    print("QTP|mass_keto=")
    println(m_keto)
    let aucr = auc_keto / auc_nm
    var ok = 1
    if aucr < 4.5 { ok = 0 }
    if aucr > 5.5 { ok = 0 }
    if m_nm < 0.0 { ok = 0 }
    if m_keto < 0.0 { ok = 0 }
    if m_nm > cum * 1.000001 + 0.000001 { ok = 0 }
    if m_keto > cum * 1.000001 + 0.000001 { ok = 0 }
    if ok == 1 {
        println("QTP_KETO_DISCRIMINANT_PASS")
        return 0
    }
    println("QTP_KETO_DISCRIMINANT_FAIL")
    return 1
}
