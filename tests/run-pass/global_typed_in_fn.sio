//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: SCALED 4.000000
//@ expect-stdout-contains: VAR 3.000000
//@ expect-stdout-contains: INT 7
//
// Positive control: typed module-level globals keep their types and values
// inside functions, and a module-level `var` stays assignable.
let SCALE: f64 = 2.0
let N: i64 = 3
var S: f64 = 2.0

fn main() -> i64 with IO, Mut {
    let y: f64 = SCALE * 2.0
    print("SCALED "); print_f64(y); print("\n")
    S = 3.0
    print("VAR "); print_f64(S); print("\n")
    let m: i64 = N + 4
    print("INT "); print_int(m); print("\n")
    0
}
