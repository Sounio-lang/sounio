//@ run-pass
// Regression test: str_index_of / str_index_of_from string primitives.
//
// str_index_of(hay, needle) -> i64        first offset of needle, or -1
// str_index_of_from(hay, needle, from)    search at or after `from`
//
// Empty needle matches at `from` (when from <= len(hay)); a needle longer
// than the haystack yields -1. These primitives let userland compose split
// via str_index_of_from + str_slice until Seq<T> lands.

fn main() -> i32 with IO, Mut, Panic {
    // found at 0
    if str_index_of("hello world", "hello") != 0 {
        println("str_index_of: FAIL (found-at-0)")
        return 1
    }
    // found mid
    if str_index_of("hello world", "world") != 6 {
        println("str_index_of: FAIL (found-mid)")
        return 1
    }
    // single char
    if str_index_of("a:b", ":") != 1 {
        println("str_index_of: FAIL (single-char)")
        return 1
    }
    // not found
    if str_index_of("hello", "xyz") != -1 {
        println("str_index_of: FAIL (not-found)")
        return 1
    }
    // needle longer than haystack
    if str_index_of("hi", "hello") != -1 {
        println("str_index_of: FAIL (needle-longer)")
        return 1
    }
    // empty needle matches at 0
    if str_index_of("hello", "") != 0 {
        println("str_index_of: FAIL (empty-needle)")
        return 1
    }
    // from-offset: skip the first occurrence
    if str_index_of_from("ababab", "ab", 1) != 2 {
        println("str_index_of_from: FAIL (skip-first)")
        return 1
    }
    // from-offset landing exactly on a match
    if str_index_of_from("ababab", "ab", 2) != 2 {
        println("str_index_of_from: FAIL (on-match)")
        return 1
    }
    // from past last occurrence
    if str_index_of_from("ababab", "ab", 5) != -1 {
        println("str_index_of_from: FAIL (past-last)")
        return 1
    }

    // userland split loop: count tokens in "a,bb,ccc" split on ","
    var hay = "a,bb,ccc"
    var count = 0
    var pos = 0
    var hlen = str_len(hay)
    while pos <= hlen {
        let nxt = str_index_of_from(hay, ",", pos)
        if nxt < 0 {
            // last token: hay[pos..hlen]
            count = count + 1
            pos = hlen + 1
        } else {
            // token: hay[pos..nxt]
            count = count + 1
            pos = nxt + 1
        }
    }
    if count != 3 {
        println("str_index_of_from: FAIL (split-loop count)")
        return 1
    }

    println("str_index_of: PASS")
    return 0
}
