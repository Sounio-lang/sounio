//@ run-pass
//@ requires: lean_single
//@ expect-stdout: BORROW_INDEXED_STRUCT_INLINE_ARRAY_OK
// `&parent.items[i].xs` must be the inline array, not the pointer cell of the
// array-of-struct slot. The cell address made the callee read pointer bits as
// the first word and SIGSEGV (viz chart_line / chart_heatmap).

struct Row {
    xs: [i64; 4],
    n: i64,
}

struct Table {
    items: [Row; 2],
}

fn first(xs: &[i64; 4]) -> i64 {
    xs[0]
}

fn main() -> i64 with Mut, IO {
    var t = Table { items: [Row { xs: [0, 0, 0, 0], n: 0 }; 2] }
    t.items[1] = Row { xs: [1, 2, 3, 4], n: 1 }
    let v = first(&t.items[1].xs)
    if v != 1 {
        println("BORROW_INDEXED_STRUCT_INLINE_ARRAY_FAIL")
        return 1
    }
    println("BORROW_INDEXED_STRUCT_INLINE_ARRAY_OK")
    0
}
