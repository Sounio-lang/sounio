//@ run-pass
//@ description: len(x) and x.len() agree for array literals, variables, fixed params, and struct arrays

struct Beta {
    alpha: f64,
    beta: f64
}

fn len_i64_fixed(xs: [i64; 3]) -> i64 {
    return len(xs)
}

fn len_beta_fixed(xs: [Beta; 2]) -> i64 {
    return len(xs)
}

fn len_i64_slice(xs: &[i64]) -> i64 {
    return len(xs)
}

fn method_len_i64_slice(xs: &[i64]) -> i64 {
    return xs.len()
}

fn assert_eq(actual: i64, expected: i64, name: string) -> i64 with IO {
    if actual == expected {
        print("PASS: ")
        println(name)
        return 1
    }

    print("FAIL: ")
    print(name)
    print(" expected ")
    print(expected)
    print(" got ")
    println(actual)
    return 0
}

fn main() -> i32 {
    var passed: i64 = 0

    let xs = [1, 2, 3]
    let betas = [Beta { alpha: 1.0, beta: 2.0 }, Beta { alpha: 3.0, beta: 4.0 }]

    passed = passed + assert_eq(len([1, 2, 3]), 3, "array literal len")
    passed = passed + assert_eq(len(xs), 3, "array variable len")
    passed = passed + assert_eq(xs.len(), 3, "array variable method len")
    passed = passed + assert_eq(len_i64_fixed(xs), 3, "fixed i64 parameter len")
    passed = passed + assert_eq(len(betas), 2, "Beta struct array variable len")
    passed = passed + assert_eq(betas.len(), 2, "Beta struct array method len")
    passed = passed + assert_eq(len_beta_fixed(betas), 2, "fixed Beta struct parameter len")
    passed = passed + assert_eq(len_i64_slice(&xs[0..3]), 3, "slice parameter len")
    passed = passed + assert_eq(method_len_i64_slice(&xs[0..3]), 3, "slice parameter method len")

    if passed == 9 {
        println("array_len_consistency: PASS")
        return 0
    }

    println("array_len_consistency: FAIL")
    return 1
}
