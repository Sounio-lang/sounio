//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v21 smoke for Lorenz ball-fixed step-policy receipt

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 24 { return 0 - 1 }
    if instance_fp != 668252674 { return 0 - 1 }
    if certificate_fp != 702727574 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 24 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn step_policy_instance_fingerprint(scale: i64, steps: i64,
                                    trajectory_manifest_fp: i64,
                                    radius_budget_fp: i64,
                                    quality_profile_fp: i64) -> i64 with Mod {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if trajectory_manifest_fp != 508132668 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }

    var fp: i64 = 197
    fp = portfolio_mix(fp, scale, 2063)
    fp = portfolio_mix(fp, steps, 2063)
    fp = portfolio_mix(fp, trajectory_manifest_fp, 2063)
    fp = portfolio_mix(fp, radius_budget_fp, 2063)
    fp = portfolio_mix(fp, quality_profile_fp, 2063)
    return fp
}

fn step_policy_certificate_fingerprint(instance_fp: i64, step_policy_fp: i64,
                                       radius_fill_limit_ppm: i64,
                                       min_slack_ppm: i64,
                                       max_aspect_q: i64,
                                       max_box_volume: i64,
                                       policy_mask: i64,
                                       action_code: i64,
                                       next_dt_num: i64,
                                       next_dt_den: i64) -> i64 with Mod {
    if instance_fp != 668252674 { return 0 - 1 }
    if step_policy_fp != 231786611 { return 0 - 1 }
    if radius_fill_limit_ppm != 970000 { return 0 - 1 }
    if min_slack_ppm != 30000 { return 0 - 1 }
    if max_aspect_q != 8 { return 0 - 1 }
    if max_box_volume != 27000000000000000 { return 0 - 1 }
    if policy_mask != 15 { return 0 - 1 }
    if action_code != 1 { return 0 - 1 }
    if next_dt_num != 1 { return 0 - 1 }
    if next_dt_den != 1 { return 0 - 1 }

    var fp: i64 = 211
    fp = portfolio_mix(fp, instance_fp, 2081)
    fp = portfolio_mix(fp, step_policy_fp, 2081)
    fp = portfolio_mix(fp, radius_fill_limit_ppm, 2081)
    fp = portfolio_mix(fp, min_slack_ppm, 2081)
    fp = portfolio_mix(fp, max_aspect_q, 2081)
    fp = portfolio_mix(fp, max_box_volume, 2081)
    fp = portfolio_mix(fp, policy_mask, 2081)
    fp = portfolio_mix(fp, action_code, 2081)
    fp = portfolio_mix(fp, next_dt_num, 2081)
    fp = portfolio_mix(fp, next_dt_den, 2081)
    return fp
}

fn portfolio_v21_manifest_fingerprint(step_policy_entry_fp: i64) -> i64 with Mod {
    if step_policy_entry_fp != 988622529 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 21, 1151)
    fp = portfolio_mix(fp, 25, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, step_policy_entry_fp, 1151)
    return fp
}

fn portfolio_v21_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 999686282 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 21, 1871)
    fp = portfolio_mix(fp, 25, 1871)
    fp = portfolio_mix(fp, 8, 1871)
    fp = portfolio_mix(fp, 15, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v21_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 999686282 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 21, 1907)
    fp = portfolio_mix(fp, 25, 1907)
    fp = portfolio_mix(fp, 4, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 15, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v21_readiness_fingerprint(
    manifest_fp: i64,
    result_coverage_fp: i64,
    family_coverage_fp: i64,
    acceptance_receipt_fp: i64,
    audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 999686282 { return 0 - 1 }
    if result_coverage_fp != 807383802 { return 0 - 1 }
    if family_coverage_fp != 761384846 { return 0 - 1 }
    if acceptance_receipt_fp != 780868003 { return 0 - 1 }
    if audit_receipt_fp != 885886120 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 21, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = step_policy_instance_fingerprint(
        1000000, 5, 508132668, 565673886, 70877465)
    if instance_fp != 668252674 { return 1 }

    let certificate_fp = step_policy_certificate_fingerprint(
        instance_fp, 231786611, 970000, 30000, 8,
        27000000000000000, 15, 1, 1, 1)
    if certificate_fp != 702727574 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(24, instance_fp, certificate_fp, 1, 24)
    if entry_fp != 988622529 { return 3 }

    let manifest_fp = portfolio_v21_manifest_fingerprint(entry_fp)
    if manifest_fp != 999686282 { return 4 }

    let result_coverage_fp = portfolio_v21_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 807383802 { return 5 }

    let family_coverage_fp = portfolio_v21_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 761384846 { return 6 }

    if portfolio_v21_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        780868003, 885886120) != 174001552 { return 7 }

    if step_policy_instance_fingerprint(
        1000000, 5, 508132669, 565673886, 70877465) != (0 - 1) { return 8 }
    if step_policy_certificate_fingerprint(
        instance_fp, 231786612, 970000, 30000, 8,
        27000000000000000, 15, 1, 1, 1) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(24, instance_fp, certificate_fp, 0, 24) != (0 - 1) { return 10 }
    if portfolio_v21_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 11 }
    if portfolio_v21_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 12 }
    if portfolio_v21_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 13 }
    if portfolio_v21_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        780868003, 885886121) != (0 - 1) { return 14 }

    return 0
}
