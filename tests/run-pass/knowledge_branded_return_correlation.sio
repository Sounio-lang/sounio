//@ run-pass
//@ requires: madaros
//@ expect-stdout: BRANDED_RETURN_CORRELATION_OK
// Correlation is on the caller's channels. The Knowledge returned by the
// reaction has to be read with those channels, not with the independent
// variance baked inside the callee. rho = 1 adds 2*10*2*0.1*0.2 = 0.8.

ontology Reaction {
    class Substance { property amount: f64 where amount >= 0.0 }
    class FuelCarrier subclass_of Substance
    class OxidantCarrier subclass_of Substance
    class ProductWater subclass_of Substance
    disjoint FuelCarrier, OxidantCarrier
}

fn reaction_product(fuel: Knowledge<FuelCarrier>, oxidant: Knowledge<OxidantCarrier>) -> Knowledge<ProductWater> with Epistemic, Mut, Div {
    let f: f64 = fuel.value
    let o: f64 = oxidant.value
    let p: f64 = f * o
    Knowledge { value: p }
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let fuel_value: FuelCarrier = 10.0
    let oxidant_value: OxidantCarrier = 2.0
    let fuel: Knowledge<FuelCarrier> = measure(fuel_value, uncertainty: 0.1)
    let oxidant: Knowledge<OxidantCarrier> = measure(oxidant_value, uncertainty: 0.2)
    let f: f64 = fuel.value
    let o: f64 = oxidant.value
    let _rho = correlate(f, o, 1.0)
    let held = reaction_product(fuel, oxidant)
    let held_v = variance_of(held.value)
    let direct_v = variance_of(reaction_product(fuel, oxidant).value)

    print("held ")
    print_f64(held_v)
    print(" direct ")
    print_f64(direct_v)
    print("\n")

    if near(held_v, 4.84, 0.0001) && near(direct_v, 4.84, 0.0001) {
        println("BRANDED_RETURN_CORRELATION_OK")
        return 0
    }
    println("BRANDED_RETURN_CORRELATION_FAIL")
    1
}
