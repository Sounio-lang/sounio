//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_FACTOR_STATUS_PASS
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_status,numeric_buffer_at,numeric_buffer_set,numeric_buffer_close,numeric_matrix}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_status,integer_buffer_at,integer_buffer_set,integer_buffer_close}
use linalg::dynamic_factorize::{dynamic_factor_workspace,dynamic_lu,dynamic_cholesky,dynamic_lu_solve,dynamic_cholesky_solve}
fn main()->i32 with IO,Mut,Div,Panic,Alloc {
 let impossible=dynamic_factor_workspace(9223372036854775807)
 assert(impossible.status==1 && impossible.numeric_work==0)
 let query=dynamic_factor_workspace(2)
 assert(query.status==0 && query.numeric_work==4 && query.integer_work==2 && query.lu_solve_work==6)
 var a=numeric_buffer_new(4,32)
 var factor=numeric_buffer_new(4,32)
 var work=numeric_buffer_new(4,32)
 var pivots=integer_buffer_new(2,16)
 var pivot_work=integer_buffer_new(2,16)
 var b=numeric_buffer_new(2,16)
 var x=numeric_buffer_new(2,16)
 var solve_work=numeric_buffer_new(6,48)
 assert(numeric_buffer_status(&a)==0 && numeric_buffer_status(&factor)==0 && numeric_buffer_status(&work)==0 && integer_buffer_status(&pivots)==0 && integer_buffer_status(&pivot_work)==0 && numeric_buffer_status(&b)==0 && numeric_buffer_status(&x)==0 && numeric_buffer_status(&solve_work)==0)
 var i:i64=0
 while i<4 {numeric_buffer_set(&!a,i,0.0);numeric_buffer_set(&!factor,i,99.0);i=i+1}
 integer_buffer_set(&!pivots,0,99);integer_buffer_set(&!pivots,1,99)
 let layout=numeric_matrix(4,2,2,2,1,0)
 numeric_buffer_set(&!a,3,0.0/0.0)
 let bad=dynamic_lu(&a,&layout,&!factor,&!pivots,&!work,&!pivot_work,0.0)
 assert(bad.status==2 && numeric_buffer_at(&factor,0)==99.0 && integer_buffer_at(&pivots,0)==99)
 numeric_buffer_set(&!a,3,0.0)
 let singular=dynamic_lu(&a,&layout,&!factor,&!pivots,&!work,&!pivot_work,0.0)
 assert(singular.status==3 && singular.completed_pivots==0 && numeric_buffer_at(&factor,0)==99.0)
 numeric_buffer_set(&!a,1,2.0);numeric_buffer_set(&!a,2,1.0);numeric_buffer_set(&!a,3,3.0)
 let lu=dynamic_lu(&a,&layout,&!factor,&!pivots,&!work,&!pivot_work,0.0)
 assert(lu.status==0 && lu.completed_pivots==2 && lu.swaps==1 && integer_buffer_at(&pivots,0)==1 && integer_buffer_at(&pivots,1)==0)
 numeric_buffer_set(&!b,0,4.0);numeric_buffer_set(&!b,1,7.0)
 let solved=dynamic_lu_solve(&factor,&pivots,&lu,&b,&!x,&!solve_work)
 assert(solved.status==0)
 let first=numeric_buffer_at(&x,0);let second=numeric_buffer_at(&x,1)
 assert(first>0.99999999999 && first<1.00000000001 && second>1.99999999999 && second<2.00000000001)
 integer_buffer_set(&!pivots,1,1)
 numeric_buffer_set(&!x,0,99.0);numeric_buffer_set(&!x,1,99.0)
 let duplicate=dynamic_lu_solve(&factor,&pivots,&lu,&b,&!x,&!solve_work)
 assert(duplicate.status==1 && numeric_buffer_at(&x,0)==99.0 && numeric_buffer_at(&x,1)==99.0)
 numeric_buffer_set(&!a,0,4.0);numeric_buffer_set(&!a,1,1.0);numeric_buffer_set(&!a,2,1.0);numeric_buffer_set(&!a,3,3.0)
 let chol=dynamic_cholesky(&a,&layout,&!factor,&!work,0.0,0.0)
 assert(chol.status==0 && chol.method==1 && chol.completed_pivots==2 && numeric_buffer_at(&factor,1)==0.0)
 numeric_buffer_set(&!b,0,6.0);numeric_buffer_set(&!b,1,7.0)
 let chol_solution=dynamic_cholesky_solve(&factor,&chol,&b,&!x,&!solve_work)
 assert(chol_solution.status==0)
 assert(numeric_buffer_at(&x,0)>0.99999999999 && numeric_buffer_at(&x,0)<1.00000000001)
 numeric_buffer_set(&!a,2,2.0);numeric_buffer_set(&!factor,0,99.0)
 let asymmetric=dynamic_cholesky(&a,&layout,&!factor,&!work,0.0,0.0)
 assert(asymmetric.status==5 && numeric_buffer_at(&factor,0)==99.0)
 let midpoint=dynamic_cholesky(&a,&layout,&!factor,&!work,0.25,0.0)
 assert(midpoint.status==0 && midpoint.symmetry_error==0.25)
 numeric_buffer_set(&!a,0,1.0);numeric_buffer_set(&!a,1,2.0);numeric_buffer_set(&!a,2,2.0);numeric_buffer_set(&!a,3,1.0);numeric_buffer_set(&!factor,0,99.0)
 let indefinite=dynamic_cholesky(&a,&layout,&!factor,&!work,0.0,0.0)
 assert(indefinite.status==6 && indefinite.completed_pivots==1 && numeric_buffer_at(&factor,0)==99.0)
 numeric_buffer_set(&!a,0,1.0e308);numeric_buffer_set(&!a,1,0.0);numeric_buffer_set(&!a,2,0.0);numeric_buffer_set(&!a,3,1.0e308)
 let huge=dynamic_lu(&a,&layout,&!factor,&!pivots,&!work,&!pivot_work,0.0)
 assert(huge.status==0)
 let tiny=2.2250738585072014e-308/4503599627370496.0
 numeric_buffer_set(&!b,0,tiny);numeric_buffer_set(&!b,1,tiny)
 numeric_buffer_set(&!x,0,99.0);numeric_buffer_set(&!x,1,99.0)
 let underflow=dynamic_lu_solve(&factor,&pivots,&huge,&b,&!x,&!solve_work)
 assert(underflow.status==4 && numeric_buffer_at(&x,0)==99.0 && numeric_buffer_at(&x,1)==99.0)
 numeric_buffer_close(a);numeric_buffer_close(factor);numeric_buffer_close(work)
 integer_buffer_close(pivots);integer_buffer_close(pivot_work)
 numeric_buffer_close(b);numeric_buffer_close(x);numeric_buffer_close(solve_work)
 println("STDLIB_DEEP_FACTOR_STATUS_PASS")
 0
}
