//@ run-pass
//@ expect-stdout-contains: VENLAFAXINE_FU_ORIENTATION_PASS
//
// Pins the ORIENTATION of the venlafaxine/ODV unbound fractions against the
// primary source, so the bound/unbound confusion cannot return silently.
//
// Effexor XR label (FDA 020699s054/057), verbatim:
//   "Venlafaxine and ODV are minimally bound at therapeutic concentrations to
//    plasma proteins (27% and 30%, respectively)."
// The percentages are the BOUND fractions, so fu = 1 - 0.27 = 0.73 (parent)
// and fu = 1 - 0.30 = 0.70 (ODV). Corroborated independently by Lombardo 2018
// (httk chem.physical_and_invitro.data: 0.73 / 0.70).
//
// Until 2026-10-31 this stdlib returned 0.27 / 0.30 -- the bound fractions
// mislabelled as fu, a factor of 2.7x on the dissertation's primary drug.
// The two functions had no callers, so no published result depended on them;
// the defect was latent. It stops being latent the moment Kp prediction is
// wired, because Rodgers-Rowland has sensitivity d(ln Kpu)/d(fu) = -3.95.
//
// This test asserts the complement relation, not just the literal values:
// it fails for ANY pair that is not the complement of the label's bound
// fractions, which is what the original defect violated.

use darwin_pbpk::drugs::venlafaxine::*

fn close(a: f64, b: f64) -> bool { let d = a - b; if d < 0.0 { 0.0 - d < 1.0e-12 } else { d < 1.0e-12 } }

fn main() -> i32 with Div, IO, Panic {
    // Bound fractions as printed in the label.
    let bound_parent = 0.27
    let bound_odv    = 0.30

    let fu_parent = venlafaxine_fu_parent()
    let fu_odv    = venlafaxine_fu_odv()

    println("fu parent (expect 0.73):")
    println(fu_parent)
    println("fu ODV (expect 0.70):")
    println(fu_odv)

    // Orientation: fu must be the COMPLEMENT of the bound fraction.
    assert(close(fu_parent, 1.0 - bound_parent))
    assert(close(fu_odv, 1.0 - bound_odv))

    // A minimally-bound drug has fu > 0.5. This is the cheap sanity gate that
    // the original 0.27 / 0.30 would have failed on its own.
    assert(fu_parent > 0.5)
    assert(fu_odv > 0.5)

    // ODV is slightly more bound than the parent, so its fu is slightly lower.
    assert(fu_odv < fu_parent)

    println("VENLAFAXINE_FU_ORIENTATION_PASS")
    return 0
}
