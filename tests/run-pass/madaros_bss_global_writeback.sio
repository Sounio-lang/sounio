//@ run-pass
//@ requires: madaros

var BSS_COUNTER: i64 = 0
var BSS_RATIO: f64 = 0.0

fn increment() -> i64 with Mut {
    BSS_COUNTER = BSS_COUNTER + 1
    return BSS_COUNTER
}

fn increment_ratio() -> f64 with Mut {
    BSS_RATIO = BSS_RATIO + 1.0
    return BSS_RATIO
}

fn main() -> i64 with Mut {
    if increment() != 1 {
        return 1
    }
    if increment_ratio() != 1.0 {
        return 3
    }
    if BSS_COUNTER != 1 {
        return 2
    }
    if BSS_RATIO != 1.0 {
        return 4
    }
    return 0
}
