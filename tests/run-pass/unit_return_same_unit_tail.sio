//@ run-pass
//@ expect-stdout: unit tail return: PASS
// Control for unit_return_bare_number_tail.sio: a tail value that carries the
// declared unit is still accepted, and the number survives the trip -- through a
// parameter, and through a call result that takes the declared return unit.

unit molal = mol / kg;

fn same(x: molal) -> molal with Mut {
    x
}

fn forward(x: molal) -> molal with Mut {
    same(x)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let raw = 2.75
    let r = forward(raw as molal)
    if (r as f64) == 2.75 {
        print("unit tail return: PASS\n")
        return 0
    }
    print("unit tail return: FAIL\n")
    return 1
}
