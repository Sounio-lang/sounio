//@ run-pass
//@ expect-stdout: add=42
//@ expect-stdout: sub=-9223372036854775807
//@ expect-stdout: mul=-12
//@ expect-stdout: mulmax=9223372030926249001
//@ expect-stdout: neg=-9223372036854775807
//@ expect-stdout: min=-9223372036854775808
//@ expect-stdout: div=-9223372036854775808
//@ expect-stdout: divm1=-9223372036854775807
//@ expect-stdout: rem=-1
//@ expect-stdout: wadd=-9223372036854775808
//@ expect-stdout: wmul=-2
//@ description: ADR-031 R1/R2 guards leave in-range i64 results and wrapping_* untouched (both engines)
fn id(x: i64) -> i64 { x }
fn main() with IO {
    print("add=")
    print_int(id(40) + id(2))
    print("\n")
    print("sub=")
    print_int(id(0 - 9223372036854775807) - id(0))
    print("\n")
    print("mul=")
    print_int(id(0 - 3) * id(4))
    print("\n")
    print("mulmax=")
    print_int(id(3037000499) * id(3037000499))
    print("\n")
    print("neg=")
    print_int(-id(9223372036854775807))
    print("\n")
    print("min=")
    print_int(id(-9223372036854775808))
    print("\n")
    print("div=")
    print_int(id(-9223372036854775808) / id(1))
    print("\n")
    print("divm1=")
    print_int(id(9223372036854775807) / id(0 - 1))
    print("\n")
    print("rem=")
    print_int(id(0 - 7) % id(3))
    print("\n")
    print("wadd=")
    print_int(wrapping_add(id(9223372036854775807), 1))
    print("\n")
    print("wmul=")
    print_int(wrapping_mul(id(9223372036854775807), 2))
    print("\n")
}
