//@ run-pass
//@ known-failure: measured 2026-08-30 under SOUNIO_SOUC_ENGINE=lean_single — error[E218] tail type mismatch at <main>:19. Dormant since it carried no //@ annotation, so the breakage was never visible.
//@ requires:madaros
// Wave15e: module-level string literal globals must land a rodata pointer in BSS.
// Pre-fix: `let S: string = "hi"; println(S)` compiled but SEGV'd (null BSS word;
// "hi" never entered rodata). Runtime store `S = "hi"` already worked.
//
// Covers:
//   - immutable `let` string global + println
//   - `var` string global + println
//   - getter that returns the global string
//   - concat of global ++ literal
//
// Multi-mod import of a string global is a separate residual (thin-link/rc=12
// when combined with ++ in the dep); single-module is the SEGV class closed here.

let PREFIX: string = "hi"
var MUTABLE: string = "yo"

fn get_prefix() -> string {
    PREFIX
}

fn main() -> i64 with IO, Mut, Panic {
    println(PREFIX)
    println(MUTABLE)
    println(get_prefix())
    println(PREFIX ++ "!")
    0
}
