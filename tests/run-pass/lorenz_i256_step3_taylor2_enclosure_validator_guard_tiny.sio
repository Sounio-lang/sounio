//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-3 Taylor-2 enclosure validator guard preserves non-claim masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1381
    fp = mix(fp, 3, 5171)
    fp = mix(fp, 803328296, 5171)
    fp = mix(fp, 630199225, 5171)
    fp = mix(fp, 693283321, 5171)
    fp = mix(fp, 844877047, 5171)
    fp = mix(fp, 693563916, 5171)
    fp = mix(fp, 1000000, 5171)
    fp = mix(fp, 113000, 5171)
    fp = mix(fp, 323500, 5171)
    fp = mix(fp, 20500, 5171)
    fp = mix(fp, 80700, 5171)
    fp = mix(fp, 278629, 5171)
    fp = mix(fp, 14614, 5171)
    fp = mix(fp, 32068, 5171)
    fp = mix(fp, 44732, 5171)
    fp = mix(fp, 5711, 5171)
    fp = mix(fp, 7, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 8, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 166627559 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1399
    fp = mix(fp, instance, 5179)
    fp = mix(fp, 112768, 5179)
    fp = mix(fp, 323361, 5179)
    fp = mix(fp, 20325, 5179)
    fp = mix(fp, 113000, 5179)
    fp = mix(fp, 323500, 5179)
    fp = mix(fp, 20500, 5179)
    fp = mix(fp, 7, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 8, 5179)
    fp = mix(fp, ok_mask, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 166627559 { return 0 - 1 }
    if certificate != 623656248 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1409
    fp = mix(fp, instance, 5189)
    fp = mix(fp, certificate, 5189)
    fp = mix(fp, 9, 5189)
    fp = mix(fp, 3, 5189)
    fp = mix(fp, 7, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 8, 5189)
    fp = mix(fp, ok_mask, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    return fp
}

fn enclosure_guard_mask() -> i64 {
    let x_need_ppm: i64 = 112768
    let y_need_ppm: i64 = 323361
    let z_need_ppm: i64 = 20325
    let x_margin_ppm: i64 = 113000
    let y_margin_ppm: i64 = 323500
    let z_margin_ppm: i64 = 20500
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0

    var pass_mask: i64 = 0
    if x_need_ppm <= x_margin_ppm { pass_mask = pass_mask + 1 }
    if y_need_ppm <= y_margin_ppm { pass_mask = pass_mask + 2 }
    if z_need_ppm <= z_margin_ppm { pass_mask = pass_mask + 4 }

    var ok_mask: i64 = 0
    if 803328296 > 0 {
        if 693283321 > 0 { ok_mask = ok_mask + 1 }
    }
    if x_need_ppm == 80700 + 32068 {
        if y_need_ppm == 278629 + 44732 {
            if z_need_ppm == 14614 + 5711 { ok_mask = ok_mask + 2 }
        }
    }
    if pass_mask == 7 { ok_mask = ok_mask + 4 }
    if validated_mask == 0 { ok_mask = ok_mask + 8 }
    if x_margin_ppm - x_need_ppm == 232 {
        if y_margin_ppm - y_need_ppm == 139 {
            if z_margin_ppm - z_need_ppm == 175 { ok_mask = ok_mask + 16 }
        }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if local_containment_mask == 0 { ok_mask = ok_mask + 64 }
    if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = enclosure_guard_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 166627559 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 623656248 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 940966535 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
