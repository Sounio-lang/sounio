// #2966 (Lowerer_fo_inline_note): `var cur = HEAD` with a global
// `var HEAD: Option<Box<Link>>` left `cur` untyped, so in
// `match cur { Some(node) => (*node).next }` the field went to the untyped
// vote. Two decoys put `next` at index 1, so the vote read Link.def (index 1)
// instead of Link.next (index 2): a list of three counted as one.
struct DecoyA {
    tag: i64,
    next: i64,
}

struct DecoyB {
    tag: i64,
    next: i64,
    more: i64,
}

struct Link {
    id: i64,
    def: i64,
    next: Option<Box<Link> >,
}

var HEAD: Option<Box<Link> > = None

fn push(id: i64) with Mut, Alloc {
    HEAD = Some(Box::new(Link { id: id, def: 0, next: HEAD }))
}

fn count_and_sum() -> (i64, i64) with Mut, Panic, Div {
    var n: i64 = 0
    var s: i64 = 0
    var cur = HEAD
    while true {
        match cur {
            Some(node) => {
                n = n + 1
                s = s + (*node).id
                cur = (*node).next
            }
            None => break
        }
    }
    (n, s)
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let a = DecoyA { tag: 1, next: 2 }
    let b = DecoyB { tag: 3, next: 4, more: 5 }
    push(10)
    push(20)
    push(12)
    let r = count_and_sum()
    let n: i64 = r.0
    let s: i64 = r.1
    if n == 3 && s == 42 && a.next + b.next == 6 {
        println("GLOBAL_OPTION_LIST_MATCH_TYPED_OK")
        return 0
    }
    print("GLOBAL_OPTION_LIST_MATCH_TYPED_FAIL n=")
    print_int(n)
    print(" s=")
    print_int(s)
    println("")
    return 1
}
