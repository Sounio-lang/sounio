//@ run-pass
// Phase 0 of epistemic-length Seq<T>: heap-backed growable sequence.
//   seq_new() -> Seq          (capacity 4, len 0, confidence 1.0)
//   seq_push(s, v)            grow-on-full (mremap), pointer written back
//   seq_get(s, i) -> T
//   seq_set(s, i, v)
//   seq_len(s) -> Knowledge<i64>   (value = len, with epistemic confidence)
// Phase 0: elem_size fixed at 8 (scalar Seq<i64>); push receiver is a local var.

fn main() -> i32 with IO, Mut, Panic, Epistemic {
    var s: Seq<i64> = seq_new()
    seq_push(s, 10)
    seq_push(s, 20)
    seq_push(s, 30)

    if seq_get(s, 0) != 10 { println("seq_basic: FAIL (get 0)"); return 1 }
    if seq_get(s, 1) != 20 { println("seq_basic: FAIL (get 1)"); return 1 }
    if seq_get(s, 2) != 30 { println("seq_basic: FAIL (get 2)"); return 1 }

    let k = seq_len(s)
    if k.unwrap("len") != 3 { println("seq_basic: FAIL (len)"); return 1 }

    // seq_set overwrites in place
    seq_set(s, 1, 99)
    if seq_get(s, 1) != 99 { println("seq_basic: FAIL (set)"); return 1 }

    // ---- grow past initial capacity (4) to force mremap + pointer writeback ----
    var g: Seq<i64> = seq_new()
    var i = 0
    while i < 20 {
        seq_push(g, i * 7)
        i = i + 1
    }
    let gk = seq_len(g)
    if gk.unwrap("len") != 20 { println("seq_basic: FAIL (grow len)"); return 1 }
    // verify every element survived the realloc(s)
    var j = 0
    while j < 20 {
        if seq_get(g, j) != j * 7 {
            println("seq_basic: FAIL (grow element)")
            return 1
        }
        j = j + 1
    }

    println("seq_basic: PASS")
    return 0
}
