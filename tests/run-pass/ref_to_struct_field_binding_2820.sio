//@ run-pass
//@ description: #2820 -- `let ng = &result.negatives` borrows a struct; `ng.total` must read Neg's `total`, not the offset of another struct's field of the same name
//@ expect-stdout: 2526
//@ expect-stdout: 2526
//@ expect-stdout: 2526
//@ expect-stdout: 2526
//@ expect-stdout: 2526
//@ expect-stdout: 2526
//@ expect-stdout: 7
//@ expect-stdout: 2
//@ expect-stdout: REF_FIELD_BINDING_2820_OK
//
// Reduced from stdlib/hardware/pireus/operator_genome.sio
// pireus_operator_genome_frozen_mismatch_code: `let negatives = &result.negatives`
// followed by `negatives.passed != 25`. Madaros did not record the borrowed
// struct's type on `ng`, so `ng.passed` / `ng.total` were resolved by field
// NAME against the first registered struct with such a field (`Other` below,
// where they are fields 1 and 2) and read Neg's bool fields `b` and `c`
// instead: 101 in place of 2526, and the genome example's frozen check
// returned 12. lean_single printed 2526 throughout.

struct Other { x: i64, passed: i64, total: i64 }
struct Neg { a: bool, b: bool, c: bool, passed: i64, total: i64 }
struct Res { valid: bool, error: i64, negatives: Neg }
struct Pair { left: Neg, right: Neg }

fn via_ref_param(result: &Res) -> i64 {
    let ng = &result.negatives
    ng.passed * 100 + ng.total
}

fn via_annotated_ref(result: &Res) -> i64 {
    let ng: &Neg = &result.negatives
    ng.passed * 100 + ng.total
}

fn via_value_param(r: Res) -> i64 {
    let ng = &r.negatives
    ng.passed * 100 + ng.total
}

fn via_explicit_deref(result: &Res) -> i64 {
    let ng = &(*result).negatives
    ng.passed * 100 + ng.total
}

fn via_whole_struct(n: Neg) -> i64 {
    let ng = &n
    ng.passed * 100 + ng.total
}

fn main() -> i64 with IO {
    let o = Other { x: 1, passed: 2, total: 3 }
    let r = Res { valid: true, error: 0, negatives: Neg { a: true, b: true, c: true, passed: 25, total: 26 } }
    var fails: i64 = 0
    let a = via_ref_param(&r)
    println(a)
    if a != 2526 { fails = fails + 1 }
    let b = via_annotated_ref(&r)
    println(b)
    if b != 2526 { fails = fails + 1 }
    let c = via_value_param(r)
    println(c)
    if c != 2526 { fails = fails + 1 }
    let d = via_explicit_deref(&r)
    println(d)
    if d != 2526 { fails = fails + 1 }
    let e = via_whole_struct(r.negatives)
    println(e)
    if e != 2526 { fails = fails + 1 }
    let ng = &r.negatives
    let f = ng.passed * 100 + ng.total
    println(f)
    if f != 2526 { fails = fails + 1 }
    let p = Pair { left: Neg { a: false, b: true, c: false, passed: 3, total: 4 }, right: Neg { a: true, b: false, c: true, passed: 5, total: 7 } }
    let rt = &p.right
    println(rt.total)
    if rt.total != 7 || !rt.a || rt.b { fails = fails + 1 }
    println(o.passed)
    if fails == 0 { println("REF_FIELD_BINDING_2820_OK") } else { println("REF_FIELD_BINDING_2820_FAIL") }
    fails
}
