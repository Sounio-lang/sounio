//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF PASS
//
// Copilot review (PR #2516), finding 2 on the tenth review round:
// expr_result_is_f64_array_ref (the SINGLE-array classifier, used by
// tuple_lit_slot_is_f64_array_ref for a tuple-literal slot that's itself a
// plain array rather than a nested tuple) had no ExprIf/ExprMatch/
// ExprBlock arm, so a slot produced through control flow --
// `(if cond { mk_a() } else { mk_b() }, 0)` -- fell straight through to
// `false` even though both arms return [f64;N]. The tuple-VALUED
// classifier (expr_result_tuple_arr_mask_ref) already got this same
// ExprIf/ExprMatch/block-tail propagation in round 6/7 finding 2; this
// mirrors it for the single-array case.
fn mk_a() -> [f64; 2] {
    var a: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    a
}

fn mk_b() -> [f64; 2] {
    var b: [f64; 2] = [0.0; 2]
    b[0] = 4.5
    b
}

fn main() -> i32 with IO, Mut, Panic {
    let cond = true
    let (a, n) = (if cond { mk_a() } else { mk_b() }, 0)
    let s0: f64 = a[0] * 2.0

    if s0 == 3.0 && n == 0 {
        println("TUPLE_LIT_SLOT_SINGLE_ARRAY_FROM_IF PASS")
        return 0
    }
    1
}
