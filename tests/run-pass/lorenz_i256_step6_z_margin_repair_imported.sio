//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 z-margin repair checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_z_margin_repair_check(
        367562376, 516981885, 900658, 1008677, 899667, 1009668,
        55000, 54531, 0, 9)
    if artifact_fp != 617386880 { return 1 }
    let audit_fp = lorenz_i256_step6_z_margin_repair_audit_fingerprint(
        artifact_fp, 156039132, 264234495, 367562376, 814950326,
        516981885, 989033159, 6, 9, 255)
    if audit_fp != 478471574 { return 2 }
    return 0
}
