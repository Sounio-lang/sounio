//@ run-pass
// Regression test for uninitialized struct local variable allocation
//@ requires: madaros
//@ expect-stdout: 42

struct BufferTest {
    pub len: i64,
    pub flags: i64,
}

fn make_buffer() -> BufferTest {
    var out: BufferTest
    out.len = 42
    out.flags = 1
    out
}

fn main() -> i64 with IO {
    let buf = make_buffer()
    print_int(buf.len)
    0
}
