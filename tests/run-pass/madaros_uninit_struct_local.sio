//@ run-pass
// Direct regression for the uninitialized-struct-local lowering fix
// (self-hosted/ir/lower.sio, commit a74aa956a3): `var x: SomeStruct` with NO
// initializer must allocate the struct's backing handle, not fall through to
// the generic no-init path (which lowered to `ir_load_imm 0`, binding the
// local to the bare value 0 -- any subsequent field write/read then
// dereferenced handle 0 and SIGSEGV'd). This is the struct analogue of the
// pre-existing #1548 fix for `var arr: [f64; N]` immediately above it in
// lower.sio.
//
// Covers both shapes the original bug report named:
//   1. A same-module `var x: T` with no initializer, direct field write/read.
//   2. The cross-module case that actually surfaced this bug:
//      native::encode::code_buffer_new() is exactly `var out: CodeBuffer;
//      out.len = 0; out` -- calling it from a program outside self-hosted/
//      segfaulted (exit 139) before the lower.sio fix, confirmed by running
//      the compiled binary (not just type-checking it) against both a
//      pre-fix and post-fix current-source Madaros build. See
//      tests/run-pass/madaros_encode_extended_reg.sio, which also exercises
//      this constructor as part of testing emit_mov_reg_imm32/64.
//@ requires: madaros
//@ expect-stdout: 114
use native::encode::*

struct UninitProbe {
    a: i64,
    b: i64,
}

fn make_uninit_probe() -> UninitProbe with Mut, Panic, Div {
    var p: UninitProbe
    p.a = 1
    p.b = 41
    p
}

fn main() -> i64 with IO, Mut, Panic, Div {
    // Same-module: var x: T with no initializer, then field write + read.
    let p = make_uninit_probe()
    if p.a != 1 { return 1 }
    if p.b != 41 { return 2 }

    // Cross-module: native::encode::code_buffer_new() is `var out: CodeBuffer`
    // with no initializer, returned across the module boundary. Field write
    // (emit_mov_reg_imm32 stores into buf.bytes/buf.len) and read
    // (code_buffer_read_byte) must both succeed without segfaulting.
    var buf = code_buffer_new()
    buf = emit_mov_reg_imm32(buf, 0, 100)
    if buf.len != 7 { return 3 }
    let byte0 = code_buffer_read_byte(buf, 0)
    if byte0 != 0x48 { return 4 }

    print_int(p.a + p.b + byte0)
    0
}
