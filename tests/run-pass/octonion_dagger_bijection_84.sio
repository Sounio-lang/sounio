//@ run-pass
//@ expect-stdout-contains: DAGGER-REVERSAL 343 PASS
//@ expect-stdout-contains: FORWARD 84 PASS
//@ expect-stdout-contains: BACKWARD 84 PASS
//@ expect-stdout-contains: FWD->BWD 84 PASS
//@ expect-stdout-contains: BWD->FWD 84 PASS
//@ expect-stdout-contains: FREE-INVOLUTION (0 self-dual) PASS
//@ expect-stdout-contains: BIJECTION 84<->84 PASS
// The 84<->84 DUALITY, EXECUTED as an explicit bijection (not just equal counts).
// The 168 non-Fano triples split into 84 forward arrows (associator wave alpha-beta = +2) and 84
// backward arrows (wave = -2). The DAGGER  dag(i,j,k) = (k,j,i)  is the structural map that pairs
// them: it NEGATES the wave (SounioCayleyDickson.lean dagger_reversal) and is a FREE involution on
// the 168 non-Fano triples (no_nonfano_self_dual) — hence an explicit bijection forward <-> backward.
// This is the "why" behind 168 = 84 + 84. Executed exactly (integer associator signs, no tolerance);
// the 84 forward->backward arrows are emitted as `ARROW i j k  ki kj kk` for cross-toolchain diff.
//
// Self-contained (inline cd_sigma_c), all-i64 (avoids issues #637/#638).

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}
fn oct_sigma(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 3) }
fn alpha_sign(i: i64, j: i64, k: i64) -> i64 with Mut, Panic, Div { oct_sigma(i, j) * oct_sigma(i ^ j, k) }
fn beta_sign(i: i64, j: i64, k: i64) -> i64 with Mut, Panic, Div { oct_sigma(j, k) * oct_sigma(i, j ^ k) }
// wave(i,j,k) = alpha - beta ; dagger reverses the triple: dag(i,j,k) = (k,j,i).
fn wave(i: i64, j: i64, k: i64) -> i64 with Mut, Panic, Div { alpha_sign(i, j, k) - beta_sign(i, j, k) }

fn main() with IO, Mut, Panic, Div {
    var total = 0
    var reversal = 0     // wave(dag t) == -wave(t)                 (dagger_reversal, expect 343)
    var fwd = 0          // wave == +2                             (expect 84)
    var bwd = 0          // wave == -2                             (expect 84)
    var fwd_to_bwd = 0   // wave==+2 AND wave(dag)==-2             (expect 84: every fwd maps to a bwd)
    var bwd_to_fwd = 0   // wave==-2 AND wave(dag)==+2             (expect 84)
    var selfdual_nf = 0  // non-Fano AND wave(t)==wave(dag t)      (expect 0: free involution)
    var i = 1
    while i <= 7 {
        var j = 1
        while j <= 7 {
            var k = 1
            while k <= 7 {
                total = total + 1
                let w = wave(i, j, k)
                let wd = wave(k, j, i)                 // wave of the dagger (k,j,i)
                if wd == 0 - w { reversal = reversal + 1 }
                // dag(dag(i,j,k)) = dag(k,j,i) = (i,j,k): the involution is structural (double reversal).
                if w == 2 {
                    fwd = fwd + 1
                    if wd == 0 - 2 { fwd_to_bwd = fwd_to_bwd + 1 }
                    // emit the explicit arrow: forward triple -> its dagger (backward) image
                    print("ARROW ")
                    print_int(i)
                    print(" ")
                    print_int(j)
                    print(" ")
                    print_int(k)
                    print(" ")
                    print_int(k)
                    print(" ")
                    print_int(j)
                    print(" ")
                    print_int(i)
                    print("\n")
                }
                if w == 0 - 2 {
                    bwd = bwd + 1
                    if wd == 2 { bwd_to_fwd = bwd_to_fwd + 1 }
                }
                if w != 0 && w == wd { selfdual_nf = selfdual_nf + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    if reversal == 343 { println("DAGGER-REVERSAL 343 PASS") } else { print("DAGGER-REVERSAL FAIL="); println(reversal) }
    if fwd == 84 { println("FORWARD 84 PASS") } else { print("FORWARD FAIL="); println(fwd) }
    if bwd == 84 { println("BACKWARD 84 PASS") } else { print("BACKWARD FAIL="); println(bwd) }
    if fwd_to_bwd == 84 { println("FWD->BWD 84 PASS") } else { print("FWD->BWD FAIL="); println(fwd_to_bwd) }
    if bwd_to_fwd == 84 { println("BWD->FWD 84 PASS") } else { print("BWD->FWD FAIL="); println(bwd_to_fwd) }
    if selfdual_nf == 0 { println("FREE-INVOLUTION (0 self-dual) PASS") } else { print("SELF-DUAL FAIL="); println(selfdual_nf) }
    // fwd==bwd==fwd_to_bwd==bwd_to_fwd==84 with a free wave-negating involution => explicit bijection.
    if fwd == bwd && fwd_to_bwd == fwd && bwd_to_fwd == bwd { println("BIJECTION 84<->84 PASS") } else { println("BIJECTION FAIL") }
}
