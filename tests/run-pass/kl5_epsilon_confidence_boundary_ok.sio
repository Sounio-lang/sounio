//@ run-pass
//@ expect-stdout: KL5_EPSILON_CONFIDENCE_BOUNDARY_OK

fn require_confident(value: Knowledge[f64, ε >= 0.82]) -> f64 with Epistemic {
    value.value
}

fn main() -> i32 with IO, Epistemic {
    let confident: Knowledge[f64, ε = 0.90] = Knowledge {
        value: 500.0,
        epsilon: 0.90,
    }
    let accepted = require_confident(confident)
    if accepted != 500.0 {
        return 1
    }
    println("KL5_EPSILON_CONFIDENCE_BOUNDARY_OK")
    0
}
