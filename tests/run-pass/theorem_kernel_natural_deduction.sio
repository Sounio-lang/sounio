//@ run-pass
// Tests for stdlib/theorem/kernel.sio: natural deduction rules

use theorem::kernel::*;

// Helper: check confidence is close to expected
fn check_conf(actual: f64, expected: f64) -> bool {
    let diff = actual - expected
    let adiff = if diff < 0.0 { 0.0 - diff } else { diff }
    return adiff < 0.01
}

fn run_tests(ctx: &! ProofContext) -> i32 {
    // Test 1: true_intro produces confidence 1.0
    let t_id = true_intro(ctx)
    let t_conf = proof_confidence(ctx, t_id)
    if check_conf(t_conf, 1.0) == false {
        return 1
    }

    // Test 2: and_intro combines two proofs with min confidence
    let p_prop = ctx_prop(ctx, prop_true())
    let q_prop = ctx_prop(ctx, prop_true())
    let pq_prop = ctx_prop(ctx, prop_and(p_prop, q_prop))
    let p_prf = true_intro(ctx)
    let q_prf = true_intro(ctx)
    let pq_prf = and_intro(ctx, p_prf, q_prf, pq_prop)
    let pq_conf = proof_confidence(ctx, pq_prf)
    if check_conf(pq_conf, 1.0) == false {
        return 2
    }

    // Test 3: and_elim_left/right extract sub-proofs
    let p_from_pq = and_elim_left(ctx, pq_prf, p_prop)
    let vr = verify(ctx, p_from_pq)
    if vr.is_valid == false {
        return 3
    }
    let q_from_pq = and_elim_right(ctx, pq_prf, q_prop)
    let vr2 = verify(ctx, q_from_pq)
    if vr2.is_valid == false {
        return 4
    }

    // Test 4: or_intro_left produces valid proof
    let or_prop = ctx_prop(ctx, prop_or(p_prop, q_prop))
    let or_prf = or_intro_left(ctx, p_prf, or_prop)
    let or_vr = verify(ctx, or_prf)
    if or_vr.is_valid == false {
        return 5
    }

    // Test 5: impl_elim (modus ponens)
    let impl_prop = ctx_prop(ctx, prop_implies(p_prop, q_prop))
    let p_assume = assume(ctx, 42, p_prop)
    let impl_prf = impl_intro(ctx, p_assume, q_prf, impl_prop)
    let mp_result = impl_elim(ctx, impl_prf, p_prf, q_prop)
    let mp_conf = proof_confidence(ctx, mp_result)
    if check_conf(mp_conf, 1.0) == false {
        return 6
    }

    // Test 6: refl proves a = a with confidence 1.0
    let eq_prf = refl(ctx, 42)
    let eq_vr = verify(ctx, eq_prf)
    if eq_vr.is_valid == false {
        return 7
    }
    if eq_vr.confidence < 0.99 {
        return 8
    }

    // Test 7: trusted proof with partial confidence
    let custom_prop = ctx_prop(ctx, prop_custom(999))
    let partial_prf = trusted(ctx, 1, custom_prop, 0.75)
    let partial_conf = proof_confidence(ctx, partial_prf)
    if check_conf(partial_conf, 0.75) == false {
        return 9
    }

    // Test 8: proof_is_static returns false for trusted proof
    if proof_is_static(ctx, partial_prf) {
        return 10
    }

    return 0
}

fn main() -> i32 {
    var ctx = proof_context_new()
    return run_tests(&! ctx)
}
