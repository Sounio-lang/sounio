//@ run-pass
// Tests for natural deduction kernel properties
// Self-contained mini proof kernel using global flat arrays
// No use imports: simulates proof-kernel semantics directly

var KERN_CONF: [f64; 256] = [0.0; 256]
var KERN_TAG:  [i64; 256] = [0;   256]
var KERN_COUNT: i64 = 0

// tags: 1=TRUE 2=AND 3=OR 4=IMPL 5=EQ 6=TRUSTED 7=ASSUME
fn kern_new(tag: i64, conf: f64) -> i64 with Mut {
    let id = KERN_COUNT
    KERN_TAG[id]  = tag
    KERN_CONF[id] = conf
    KERN_COUNT = KERN_COUNT + 1
    return id
}

fn kern_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn kern_min(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn kern_conf(id: i64) -> f64 with Mut       { return KERN_CONF[id] }
fn kern_is_valid(id: i64) -> bool with Mut  { return KERN_CONF[id] > 0.5 }
fn kern_is_static(id: i64) -> bool with Mut { return KERN_TAG[id] != 6 }

fn kern_true_intro() -> i64 with Mut { return kern_new(1, 1.0) }
fn kern_refl() -> i64 with Mut       { return kern_new(5, 1.0) }
fn kern_assume(conf: f64) -> i64 with Mut { return kern_new(7, conf) }
fn kern_trusted(conf: f64) -> i64 with Mut { return kern_new(6, conf) }

fn kern_and_intro(p: i64, q: i64) -> i64 with Mut {
    let mc = kern_min(KERN_CONF[p], KERN_CONF[q])
    return kern_new(2, mc)
}

fn kern_or_intro_left(p: i64) -> i64 with Mut {
    return kern_new(3, KERN_CONF[p])
}

fn kern_impl_intro(assume_id: i64, q_id: i64) -> i64 with Mut {
    return kern_new(4, KERN_CONF[q_id])
}

fn kern_impl_elim(impl_id: i64, p_id: i64) -> i64 with Mut {
    let mc = kern_min(KERN_CONF[impl_id], KERN_CONF[p_id])
    return kern_new(4, mc)
}

// Simulates and_elim / projection: derives proof with same confidence
fn kern_elim(parent: i64) -> i64 with Mut {
    return kern_new(5, KERN_CONF[parent])
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var n_pass = 0

    // T1: true_intro has confidence 1.0
    let t_id = kern_true_intro()
    if kern_abs(kern_conf(t_id) - 1.0) < 0.01 { n_pass = n_pass + 1 }

    // T2: and_intro gives min(1.0, 1.0) = 1.0
    let p_prf = kern_true_intro()
    let q_prf = kern_true_intro()
    let pq_prf = kern_and_intro(p_prf, q_prf)
    if kern_abs(kern_conf(pq_prf) - 1.0) < 0.01 { n_pass = n_pass + 1 }

    // T3: and_elim_left — derived proof is valid
    let elim_l = kern_elim(pq_prf)
    if kern_is_valid(elim_l) { n_pass = n_pass + 1 }

    // T4: and_elim_right — derived proof is valid
    let elim_r = kern_elim(pq_prf)
    if kern_is_valid(elim_r) { n_pass = n_pass + 1 }

    // T5: or_intro_left — valid proof with confidence 1.0
    let or_prf = kern_or_intro_left(p_prf)
    if kern_is_valid(or_prf) { n_pass = n_pass + 1 }

    // T6: impl_elim (modus ponens): conf = min(impl_conf, p_conf) = 1.0
    let p_assume  = kern_assume(1.0)
    let impl_prf  = kern_impl_intro(p_assume, q_prf)
    let mp_result = kern_impl_elim(impl_prf, p_prf)
    if kern_abs(kern_conf(mp_result) - 1.0) < 0.01 { n_pass = n_pass + 1 }

    // T7+T8: refl produces confidence 1.0 and is valid
    let eq_prf = kern_refl()
    if kern_is_valid(eq_prf) && kern_conf(eq_prf) >= 0.99 { n_pass = n_pass + 1 }

    // T9: trusted proof with partial confidence 0.75
    let partial_prf = kern_trusted(0.75)
    if kern_abs(kern_conf(partial_prf) - 0.75) < 0.01 { n_pass = n_pass + 1 }

    // T10: proof_is_static is false for trusted proof (tag=6)
    if kern_is_static(partial_prf) == false { n_pass = n_pass + 1 }

    if n_pass == 9 {
        println("theorem_kernel_natural_deduction: 9/9 PASS")
        return 0
    } else {
        println("theorem_kernel_natural_deduction: FAIL")
        return 1
    }
}
