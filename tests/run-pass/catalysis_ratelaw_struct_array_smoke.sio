//@ run-pass
// Gate smoke test for stdlib/chemistry/catalysis.sio: local array-of-structs
// (RateLaw-shaped), populated then read back through a &[T;N] parameter with
// `as usize` indexing. array_elem_field_store.sio proves local/param arrays
// of structs work; global arrays of structs are a separate, documented
// limitation. This must pass before the real module is written.

struct RateLawProbe {
    kind: i64,
    k_rate: f64,
    vmax: f64,
    km1: f64,
    sub_idx: i64,
}

fn sum_kinds(laws: &[RateLawProbe; 4]) -> i64 with Mut {
    var total: i64 = 0
    var i: i64 = 0
    while i < 4 {
        total = total + laws[i as usize].kind
        i = i + 1
    }
    total
}

fn read_vmax(laws: &[RateLawProbe; 4], idx: i64) -> f64 with Mut {
    laws[idx as usize].vmax
}

fn main() -> i32 with IO, Mut, Panic {
    var laws: [RateLawProbe; 4] = [RateLawProbe { kind: 0, k_rate: 0.0, vmax: 0.0, km1: 0.0, sub_idx: -1 }; 4]

    laws[0 as usize] = RateLawProbe { kind: 1, k_rate: 1.2, vmax: 10.0, km1: 2.0, sub_idx: 0 }
    laws[1 as usize] = RateLawProbe { kind: 3, k_rate: 0.0, vmax: 5.0, km1: 1.5, sub_idx: 1 }
    laws[2 as usize] = RateLawProbe { kind: 4, k_rate: 0.7, vmax: 0.0, km1: 0.3, sub_idx: 2 }
    laws[3 as usize] = RateLawProbe { kind: 0, k_rate: 0.05, vmax: 0.0, km1: 0.0, sub_idx: -1 }

    // per-field mutation on an already-populated slot
    laws[1 as usize].vmax = 6.5

    if laws[0 as usize].kind != 1 || laws[0 as usize].sub_idx != 0 {
        println("SMOKE FAIL: slot 0 read back wrong")
        return 1
    }
    if laws[1 as usize].vmax != 6.5 {
        println("SMOKE FAIL: per-field mutation did not stick")
        return 1
    }
    if laws[3 as usize].sub_idx != -1 {
        println("SMOKE FAIL: sentinel -1 not preserved")
        return 1
    }

    let total = sum_kinds(&laws)
    if total != 8 {
        println("SMOKE FAIL: sum_kinds via &[T;N] param wrong")
        return 1
    }

    let vm = read_vmax(&laws, 2)
    if vm != 0.0 {
        println("SMOKE FAIL: read_vmax via &[T;N] param + runtime idx wrong")
        return 1
    }

    println("catalysis_ratelaw_struct_array_smoke: PASS")
    return 0
}
