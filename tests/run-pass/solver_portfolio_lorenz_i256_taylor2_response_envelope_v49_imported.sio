//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v49 smoke for Lorenz i256 Taylor-2 response-envelope entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v49_lorenz_i256_taylor2_response_envelope_fingerprint(
        506104143, 956295573, 333341021, 59406573, 38526066, 6, 127, 127)
    if receipt_fp != 882801596 { return 1 }

    let audit_fp = solver_portfolio_v49_lorenz_i256_taylor2_response_envelope_audit_fingerprint(
        receipt_fp, 506104143, 956295573, 185755530, 167433392, 38526066, 6, 127, 127)
    if audit_fp != 961618971 { return 2 }

    let manifest_fp = solver_portfolio_v49_lorenz_i256_taylor2_response_envelope_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 678566245 { return 3 }

    let result_fp = solver_portfolio_v49_result_coverage_fingerprint(
        49, 53, 10, 41, 1, 1, manifest_fp)
    if result_fp != 706023395 { return 4 }

    let family_fp = solver_portfolio_v49_checker_family_coverage_fingerprint(
        49, 53, 6, 4, 3, 2, 36, 2, manifest_fp)
    if family_fp != 47603050 { return 5 }

    let acceptance_fp = solver_portfolio_v49_acceptance_receipt_fingerprint(
        49, manifest_fp, result_fp)
    if acceptance_fp != 8653858 { return 6 }

    let audit_receipt_fp = solver_portfolio_v49_audit_receipt_fingerprint(
        49, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 117893216 { return 7 }

    let readiness_fp = solver_portfolio_v49_readiness_fingerprint(
        49, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 367410832 { return 8 }

    return 0
}
