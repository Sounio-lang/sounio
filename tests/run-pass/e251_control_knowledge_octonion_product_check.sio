//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: PASS
//
// Positive control for E251 (the Hurwitz boundary). The same product on
// Knowledge<Hyper<Octonion, f64>> is admitted: the octonion norm IS multiplicative
// (`octonion_norm_multiplicative`), so the variance shortcut equals the sensitivity
// propagator there (`octonion_shortcut_exact`). And a sedenion SUM stays admitted — the
// third axis is a property of the product's norm identity, not of the algebra as such.

fn oct_prod(a: Knowledge<Hyper<Octonion, f64>>, b: Knowledge<Hyper<Octonion, f64>>) -> Knowledge<Hyper<Octonion, f64>> with Epistemic, NonAssoc {
    a * b
}

fn sed_sum(a: Knowledge<Hyper<Sedenion, f64>>, b: Knowledge<Hyper<Sedenion, f64>>) -> Knowledge<Hyper<Sedenion, f64>> with Epistemic {
    a + b
}

fn main() -> i64 with IO {
    println("PASS")
    0
}
