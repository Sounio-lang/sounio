//@ run-pass
//@ expect-stdout: TAC GATE PASS

// Dissertation contribution #2 (compile-time confidence gate) — PASS path.
//
// `prescribe_tac` is annotated `with Confidence(800)`. Per the compiler's
// EpistemicComplete gate (lean_single.sio:20950-21020), every expression
// token inside the body must carry compile-time confidence ≥ 800/1000.
//
// `measure(8.0, uncertainty: 0.04)` produces a Knowledge<f64> with
// derived confidence = 1 − 0.04/8.0 = 0.995 = 995/1000, which exceeds
// the 800 threshold. The compiler emits binary code for this pathway.
//
// Clinical narrative: post-TDM (n=3 trough samples), the tacrolimus C24h
// estimate has tight epistemic uncertainty. The compile-time gate is the
// formal counterpart of the runtime is_safe_tac_dose() check in
// stdlib/clinical/tacrolimus_oral_safety.sio.
//
// Lean obligation: formal/lean4/SounioTacrolimusDosingSafety.lean ::
// `tac_c24h_within_implies_efficacy_and_safety`.

fn prescribe_tac(c24h_ng_ml: f64) -> f64 with Mut, Confidence(800) {
    // Linear dose-adjustment rule: target_C / current_C × current_dose,
    // with target=10 ng/mL (mid-window) and current_dose=7 mg q12h.
    let target = 10.0
    let scale = target / c24h_ng_ml
    let dose_mg = 7.0
    dose_mg * scale
}

fn main() with IO, Mut, Div, Panic, Confidence(800) {
    // Post-TDM (n=3): low-uncertainty measurement of C24h trough.
    let k_c24h: Knowledge<f64> = measure(8.0, uncertainty: 0.04)
    let c24h = k_c24h.value
    let new_dose = prescribe_tac(c24h)
    print("new_dose=")
    println(new_dose)
    println("TAC GATE PASS")
}
