fn reference_ticks() with IO, Mut, Div, Panic {
 { println("TICK_CASE_0")
 let plan = axis_ticks(-1.00000000000000001e+308, 1.00000000000000001e+308, 4)
 if plan.status == 1 { println("INVALID") }
 if plan.status == 2 { println("NONINCREASING") }
 if plan.status == 3 { println("DUPLICATE_LABEL") }
 var k:i64=0
 while k < plan.n {
 let label=axis_label(plan.values[k as usize])
 var j:i64=0
 while j < label.n { print_char(label.text[j as usize] as i64); j=j+1 }
 println(""); k=k+1
 }
 assert(plan.status == 0 && plan.n == 5)
 assert(close(plan.values[0], -1.00000000000000001e+308))
 assert(close(plan.values[1], -5.00000000000000005e+307))
 assert(close(plan.values[2], 0.00000000000000000e+00))
 assert(close(plan.values[3], 5.00000000000000005e+307))
 assert(close(plan.values[4], 1.00000000000000001e+308))
 }
 { println("TICK_CASE_1")
 let plan = axis_ticks(1.00000000000000003e-300, 9.00000000000000006e-300, 4)
 if plan.status == 1 { println("INVALID") }
 if plan.status == 2 { println("NONINCREASING") }
 if plan.status == 3 { println("DUPLICATE_LABEL") }
 var k:i64=0
 while k < plan.n {
 let label=axis_label(plan.values[k as usize])
 var j:i64=0
 while j < label.n { print_char(label.text[j as usize] as i64); j=j+1 }
 println(""); k=k+1
 }
 assert(plan.status == 0 && plan.n == 5)
 assert(close(plan.values[0], 1.00000000000000003e-300))
 assert(close(plan.values[1], 3.00000000000000024e-300))
 assert(close(plan.values[2], 4.99999999999999996e-300))
 assert(close(plan.values[3], 7.00000000000000034e-300))
 assert(close(plan.values[4], 9.00000000000000006e-300))
 }
 { println("TICK_CASE_2")
 let plan = axis_ticks(-7.00000000000000000e+00, 1.30000000000000000e+01, 4)
 if plan.status == 1 { println("INVALID") }
 if plan.status == 2 { println("NONINCREASING") }
 if plan.status == 3 { println("DUPLICATE_LABEL") }
 var k:i64=0
 while k < plan.n {
 let label=axis_label(plan.values[k as usize])
 var j:i64=0
 while j < label.n { print_char(label.text[j as usize] as i64); j=j+1 }
 println(""); k=k+1
 }
 assert(plan.status == 0 && plan.n == 5)
 assert(close(plan.values[0], -7.00000000000000000e+00))
 assert(close(plan.values[1], -2.00000000000000000e+00))
 assert(close(plan.values[2], 3.00000000000000000e+00))
 assert(close(plan.values[3], 8.00000000000000000e+00))
 assert(close(plan.values[4], 1.30000000000000000e+01))
 }
 { println("TICK_CASE_3")
 let plan = axis_ticks(1.00000000000000005e+300, 1.50000000000000008e+300, 4)
 if plan.status == 1 { println("INVALID") }
 if plan.status == 2 { println("NONINCREASING") }
 if plan.status == 3 { println("DUPLICATE_LABEL") }
 var k:i64=0
 while k < plan.n {
 let label=axis_label(plan.values[k as usize])
 var j:i64=0
 while j < label.n { print_char(label.text[j as usize] as i64); j=j+1 }
 println(""); k=k+1
 }
 assert(plan.status == 0 && plan.n == 5)
 assert(close(plan.values[0], 1.00000000000000005e+300))
 assert(close(plan.values[1], 1.12500000000000013e+300))
 assert(close(plan.values[2], 1.25000000000000007e+300))
 assert(close(plan.values[3], 1.37500000000000000e+300))
 assert(close(plan.values[4], 1.50000000000000008e+300))
 }
