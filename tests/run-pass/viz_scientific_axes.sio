//@ run-pass
//@ expect-stdout: SCIENTIFIC_AXES_PASS
//@ expect-stdout: -2.40044e+0
//@ expect-stdout: 4.40044e+0
//@ expect-stdout: mg&lt;&amp;&quot;
use viz::axis::{axis_ticks, axis_label, axis_offset}
use stats::inferential::{t_test_one_sample, T_TEST_OK}
use display::canvas::{Canvas, canvas_clear}
use viz::ir::{viz_scene_new, viz_layout_rect, viz_style_rgb, viz_add_forest_interval_plot, viz_add_axis, viz_node_set_label, VIZ_INTERVAL_CONFIDENCE}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn close(a: f64, b: f64) -> bool {
 let error = if a > b { a-b } else { b-a }
 let scale = if b < 0.0 { 0.0-b } else { b }
 error <= scale * 1.0e-13
}
fn main() with IO, Alloc, Mut, Div, Panic {
 reference_labels()
 reference_ticks()
 var huge = 1.0e308
 let inf = huge * 10.0
 let nan = inf - inf
 assert(axis_ticks(inf, 2.0, 4).status == 1)
 assert(axis_ticks(0.0, inf, 4).status == 1)
 assert(axis_ticks(nan, 2.0, 4).status == 1)
 assert(axis_label(inf).n == 0 && axis_label(nan).n == 0)
 assert(axis_ticks(1.0, 1.0, 4).n == 0)
 assert(axis_ticks(2.0, 1.0, 4).status == 1)
 assert(axis_ticks(0.0, 1.0, 0).status == 1)
 assert(axis_ticks(0.0, 1.0, 9).status == 1)
 assert(axis_ticks(1.0, 1.000000001, 4).status == 3)
 assert(axis_offset(3, 4, 561) == 420)
 var scene = viz_scene_new()
 let style = viz_style_rgb(80, 180, 240)
 let bad = viz_add_axis(&!scene, 0.0, 1.0, 4, false, viz_layout_rect(100,110,100,1), style)
 assert(bad == 0-1 && scene.node_count == 0 && scene.series_count == 0)
 var data: [f64;100] = [0.0;100]
 data[0]=1.0; data[1]=2.0; data[2]=4.0; data[3]=5.0; data[4]=8.0
 let result = t_test_one_sample(data, 5, 3.0)
 assert(result.status == T_TEST_OK)
 var estimates: [f64;1024] = [0.0;1024]
 var lower: [f64;1024] = [0.0;1024]
 var upper: [f64;1024] = [0.0;1024]
 estimates[0]=result.mean_diff; lower[0]=result.ci_lower; upper[0]=result.ci_upper
 let forest = viz_add_forest_interval_plot(&!scene, &estimates, &lower, &upper, 1,
 VIZ_INTERVAL_CONFIDENCE, result.confidence_level, viz_layout_rect(100,30,560,60), style)
 assert(forest == 0 && scene.series[0].n == 1)
 let axis = viz_add_axis(&!scene, result.ci_lower, result.ci_upper, 4, false,
     viz_layout_rect(100,110,560,1), style)
 assert(axis == 1 && scene.series_count == 1)
 var unit: [i8;64] = [0;64]
 unit[0]=109; unit[1]=103; unit[2]=60; unit[3]=38; unit[4]=34
 viz_node_set_label(&!scene, axis, &unit, 5)
 assert(scene.series[0].n == 1)
 let pixels = heap_alloc(760 * 180 * 8) as *mut i64
 var canvas = Canvas {pixels:pixels,width:760,height:180}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 let color: i64 = 240 | (180 << 8) | (80 << 16)
 assert(read_i64(canvas.pixels, 41*760+380) == color)
 assert(read_i64(canvas.pixels, 121*760+57) == color)
 assert(read_i64(canvas.pixels, 114*760+100) == color)
 assert(read_i64(canvas.pixels, 114*760+240) == color)
 assert(read_i64(canvas.pixels, 114*760+660) == color)
 // Exercise XML escaping, then export a figure with a meaningful axis title.
 viz_html_emit_scene(&scene,760,180)
 var title: [i8;64] = [0;64]
 title[0]=109;title[1]=101;title[2]=97;title[3]=110;title[4]=32
 title[5]=45;title[6]=32;title[7]=109;title[8]=117;title[9]=48
 viz_node_set_label(&!scene,axis,&title,10)
 viz_html_emit_scene(&scene,760,180)
 assert(scene.series[0].n == 1)
 // Independent vertical-axis raster and capacity checks on the reused scene.
 // This axis does not imply a numeric y domain for the categorical forest rows.
 scene.node_count=0; scene.series_count=0
 let y_axis = viz_add_axis(&!scene,0.0,1.0,4,true,viz_layout_rect(100,30,1,60),style)
 assert(y_axis == 0)
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,45*760+96) == color)
 var i:i64=scene.node_count
 while i < 64 {
   let filled = viz_add_axis(&!scene,0.0,1.0,4,false,viz_layout_rect(100,110,560,1),style)
   assert(filled == i)
   i=i+1
 }
 let full = viz_add_axis(&!scene,0.0,1.0,4,false,viz_layout_rect(100,110,560,1),style)
 assert(full == 0-1 && scene.node_count == 64 && scene.series_count == 0)
 println("SCIENTIFIC_AXES_PASS")
 0
}
