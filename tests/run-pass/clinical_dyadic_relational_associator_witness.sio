//@ check-only
// Imported API conformance for bounded synthetic relational associator D1.

use epistemic::dyadic_relational_associator::*

fn main() with Div, Mut, Panic {
    let bound = authorize_associator_products(100000, 9000000000000000000)
    let a = associator_rational(3, 10, bound)
    let b = associator_rational(3, 5, bound)
    let c = associator_rational(9, 10, bound)
    let leaves = declare_ordered_relational_leaves(7101, a, b, c)
    let rule = declare_mediation_rule(7001)
    let left = evaluate_left_grouped(7201, leaves, rule, bound)
    let right = evaluate_right_grouped(7202, leaves, rule, bound)
    let witness = certify_exact_relational_associator_witness(7301, left, right, bound)
    let control = prove_associative_control(7401, leaves)
    let rival = record_grouping_state_expansion(7501, left, right)

    assert(witness.reduced_signed_numerator == 2)
    assert(witness.reduced_denominator == 15)
    assert(control.addition_associator_zero)
    assert(rival.frozen_transition_table_total)
    assert(rival.exact_outputs_reproduced)
    assert(rival.future_output_is_function_of_grouping_code)
    assert(witness.exact_nonzero)
    assert(!witness.causal_mechanism_established)
    assert(!witness.clinical_authority)
}
