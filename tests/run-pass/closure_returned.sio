//@ run-pass
//@ expect-stdout: PASS
// Plan-named fixture: closure escapes its definition scope (Slice B SOTA gate).
// Distinct from closure_escape.sio: this exercises *multi-capture* escape
// (both `a` and `b` are copied into the env, must survive past make_affine's return).

fn make_affine(a: i64, b: i64) -> fn(i64) -> i64 with Mut, Panic, Div {
    |x: i64| -> i64 { x * a + b }
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let f = make_affine(3, 7)
    let g = make_affine(-2, 100)
    let r1 = f(4)     // 3*4 + 7 = 19
    let r2 = g(10)    // -2*10 + 100 = 80
    let r3 = f(0)     // 7
    assert(r1 == 19)
    assert(r2 == 80)
    assert(r3 == 7)
    print("PASS\n")
    0
}
