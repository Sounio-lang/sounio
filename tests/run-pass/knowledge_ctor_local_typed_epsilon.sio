//@ run-pass
//@ requires: madaros
//@ expect-stdout: 0.670000 0.670000 12.500000
// An unannotated `let k = Knowledge(v, e=c)` is a Knowledge: `k.epsilon` and
// `k.confidence` read slot 2. The builtin constructor has no fn id, so Madaros
// left the local untyped and resolved `.epsilon` by name; `Calib` below
// declares `epsilon` at index 0, won that vote, and the read returned the
// value slot: 12.5 instead of 0.67.
struct Calib { epsilon: f64, gain: f64, offset: f64 }

fn main() with IO, Mut, Epistemic {
    let c = Calib { epsilon: 0.001, gain: 2.0, offset: 0.5 }
    let k = Knowledge(12.5, e=0.67, prov="probe")
    print_f64(k.epsilon)
    print(" ")
    print_f64(k.confidence)
    print(" ")
    print_f64(k.value + c.epsilon * 0.0)
    println("")
}
