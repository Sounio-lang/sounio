//@ run-pass
//@ description: Tiny portfolio v47 smoke for Lorenz i256 Taylor-2 step-schedule entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 577
    receipt_fp = mix(receipt_fp, 353612555, 3079)
    receipt_fp = mix(receipt_fp, 335541872, 3079)
    receipt_fp = mix(receipt_fp, 889790136, 3079)
    receipt_fp = mix(receipt_fp, 470000532, 3079)
    receipt_fp = mix(receipt_fp, 984799877, 3079)
    receipt_fp = mix(receipt_fp, 2, 3079)
    receipt_fp = mix(receipt_fp, 127, 3079)
    if receipt_fp != 842631931 { return 1 }

    var audit_fp: i64 = 587
    audit_fp = mix(audit_fp, receipt_fp, 3089)
    audit_fp = mix(audit_fp, 353612555, 3089)
    audit_fp = mix(audit_fp, 335541872, 3089)
    audit_fp = mix(audit_fp, 279109641, 3089)
    audit_fp = mix(audit_fp, 207228249, 3089)
    audit_fp = mix(audit_fp, 984799877, 3089)
    audit_fp = mix(audit_fp, 2, 3089)
    audit_fp = mix(audit_fp, 127, 3089)
    if audit_fp != 13881891 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 50, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 50, 1103)
    if entry_fp != 222172950 { return 3 }

    if audit_fp == 13881892 { return 4 }
    return 0
}
