//@ run-pass
//@ requires: madaros
//@ expect-stdout: LOPT_REWRITE_TERM_STMT_OK
// Discriminator for the gen2 wall on lopt_ir_rewrite_function:
// `let term` must live in a statement `if`, not an if-expression arm.
// After the scanner split, gen1 reported `term` unresolved at 15349
// (into_acc_done=57). lopt_ir_build_cfg already uses this shape.

fn is_term(op: i64) -> bool {
    op == 1
}

fn rewrite_like(n: i64) -> i64 with Mut {
    var term_idx = 0 - 1
    if n > 0 {
        let term = n
        if is_term(term) {
            term_idx = n - 1
        }
    }
    term_idx
}

fn main() -> i64 with IO, Mut {
    let got = rewrite_like(1)
    if got == 0 {
        print("LOPT_REWRITE_TERM_STMT_OK\n")
        return 0
    }
    print("LOPT_REWRITE_TERM_STMT_FAIL\n")
    1
}
