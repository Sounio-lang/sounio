//@ run-pass
//@ description: Exact rational QF_LRA (Fourier-Motzkin) — 2 SAT, 1 UNSAT, Farkas cert verified
use theorem::qflra_exact::*
use math::rational::*

fn main() -> i64 with Mut, Div, Panic {
    // Instance 1 (SAT): x>=0, y>=0, x+y<=2, x+y>=1
    qf_reset(2);
    let a0 = qf_new_row(); qf_set_coeff(a0,0,0-1,1); qf_set_rhs(a0,0,1);      // -x <= 0
    let a1 = qf_new_row(); qf_set_coeff(a1,1,0-1,1); qf_set_rhs(a1,0,1);      // -y <= 0
    let a2 = qf_new_row(); qf_set_coeff(a2,0,1,1); qf_set_coeff(a2,1,1,1); qf_set_rhs(a2,2,1);   // x+y<=2
    let a3 = qf_new_row(); qf_set_coeff(a3,0,0-1,1); qf_set_coeff(a3,1,0-1,1); qf_set_rhs(a3,0-1,1); // -x-y<=-1
    if qf_decide() != 1 { return 1; }   // must be SAT

    // Instance 2 (SAT, rational): 2x<=1, -3x<=-1  => x in [1/3,1/2]
    qf_reset(1);
    let b0 = qf_new_row(); qf_set_coeff(b0,0,2,1); qf_set_rhs(b0,1,1);
    let b1 = qf_new_row(); qf_set_coeff(b1,0,0-3,1); qf_set_rhs(b1,0-1,1);
    if qf_decide() != 1 { return 2; }   // must be SAT

    // Instance 3 (UNSAT): x+y<=1, -x<=0, -y<=0, -x-y<=-2
    qf_reset(2);
    let c0 = qf_new_row(); qf_set_coeff(c0,0,1,1); qf_set_coeff(c0,1,1,1); qf_set_rhs(c0,1,1);
    let c1 = qf_new_row(); qf_set_coeff(c1,0,0-1,1); qf_set_rhs(c1,0,1);
    let c2 = qf_new_row(); qf_set_coeff(c2,1,0-1,1); qf_set_rhs(c2,0,1);
    let c3 = qf_new_row(); qf_set_coeff(c3,0,0-1,1); qf_set_coeff(c3,1,0-1,1); qf_set_rhs(c3,0-2,1);
    if qf_decide() != 0 { return 3; }   // must be UNSAT
    if qf_verify_farkas_unsat() != 1 { return 11; }

    // verify Farkas certificate y>=0, y.A==0 (each col), y.b < 0
    // original A: rows c0..c3 ; cols x,y ; b
    // y_k = qf_farkas(k)
    var y0 = qf_farkas(0); var y1 = qf_farkas(1); var y2 = qf_farkas(2); var y3 = qf_farkas(3);
    if y0.num < 0 { return 4; }
    if y1.num < 0 { return 5; }
    if y2.num < 0 { return 6; }
    if y3.num < 0 { return 7; }
    // col x: y0*1 + y1*(-1) + y2*0 + y3*(-1) == 0
    let cx = rat_add(rat_add(rat_mul(y0, rat_make(1,1)), rat_mul(y1, rat_make(0-1,1))),
                     rat_add(rat_mul(y2, rat_make(0,1)), rat_mul(y3, rat_make(0-1,1))));
    if rat_is_zero(cx) == false { return 8; }
    // col y: y0*1 + y1*0 + y2*(-1) + y3*(-1) == 0
    let cy = rat_add(rat_add(rat_mul(y0, rat_make(1,1)), rat_mul(y1, rat_make(0,1))),
                     rat_add(rat_mul(y2, rat_make(0-1,1)), rat_mul(y3, rat_make(0-1,1))));
    if rat_is_zero(cy) == false { return 9; }
    // y.b = y0*1 + y1*0 + y2*0 + y3*(-2) < 0
    let yb = rat_add(rat_add(rat_mul(y0, rat_make(1,1)), rat_mul(y1, rat_make(0,1))),
                     rat_add(rat_mul(y2, rat_make(0,1)), rat_mul(y3, rat_make(0-2,1))));
    if yb.num >= 0 { return 10; }   // must be < 0
    return 0;
}
