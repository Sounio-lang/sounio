//@ run-pass
//@ requires: madaros
//@ description: Self-contained i256 projection interval containment witness pack

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn interval_containment_fingerprint(lo0: i64) -> i64 with Mod {
    let tag: i64 = 39
    let source_scale: i64 = 4294967296
    let target_scale: i64 = 1000000
    let n0: i64 = 5309941770
    let q0: i64 = 1236317
    let r0: i64 = 687511168
    let ceil0: i64 = 1236318
    let hi0: i64 = 1479682
    let n1: i64 = 10058731223
    let q1: i64 = 2341980
    let r1: i64 = 3715113920
    let ceil1: i64 = 2341981
    let lo1: i64 = 2022339
    let hi1: i64 = 2661619
    let n2: i64 = 4084837935
    let q2: i64 = 951075
    let r2: i64 = 1913956800
    let ceil2: i64 = 951076
    let lo2: i64 = 908630
    let hi2: i64 = 993526
    if source_scale <= 0 { return 0 - 1 }
    if target_scale <= 0 { return 0 - 1 }
    if r0 <= 0 { return 0 - 1 }
    if r1 <= 0 { return 0 - 1 }
    if r2 <= 0 { return 0 - 1 }
    if ceil0 != q0 + 1 { return 0 - 1 }
    if ceil1 != q1 + 1 { return 0 - 1 }
    if ceil2 != q2 + 1 { return 0 - 1 }
    if lo0 > q0 { return 0 - 1 }
    if ceil0 > hi0 { return 0 - 1 }
    if lo1 > q1 { return 0 - 1 }
    if ceil1 > hi1 { return 0 - 1 }
    if lo2 > q2 { return 0 - 1 }
    if ceil2 > hi2 { return 0 - 1 }

    let lower_slack0 = q0 - lo0
    let upper_slack0 = hi0 - ceil0
    let lower_slack1 = q1 - lo1
    let upper_slack1 = hi1 - ceil1
    let lower_slack2 = q2 - lo2
    let upper_slack2 = hi2 - ceil2
    if lower_slack0 != 243367 { return 0 - 1 }
    if upper_slack0 != 243364 { return 0 - 1 }
    if lower_slack1 != 319641 { return 0 - 1 }
    if upper_slack1 != 319638 { return 0 - 1 }
    if lower_slack2 != 42445 { return 0 - 1 }
    if upper_slack2 != 42450 { return 0 - 1 }

    var fp: i64 = 239
    fp = mix(fp, tag, 1637)
    fp = mix(fp, source_scale, 1637)
    fp = mix(fp, target_scale, 1637)
    fp = mix(fp, n0, 1637)
    fp = mix(fp, q0, 1637)
    fp = mix(fp, r0, 1637)
    fp = mix(fp, ceil0, 1637)
    fp = mix(fp, lo0, 1637)
    fp = mix(fp, hi0, 1637)
    fp = mix(fp, lower_slack0, 1637)
    fp = mix(fp, upper_slack0, 1637)
    fp = mix(fp, n1, 1637)
    fp = mix(fp, q1, 1637)
    fp = mix(fp, r1, 1637)
    fp = mix(fp, ceil1, 1637)
    fp = mix(fp, lo1, 1637)
    fp = mix(fp, hi1, 1637)
    fp = mix(fp, lower_slack1, 1637)
    fp = mix(fp, upper_slack1, 1637)
    fp = mix(fp, n2, 1637)
    fp = mix(fp, q2, 1637)
    fp = mix(fp, r2, 1637)
    fp = mix(fp, ceil2, 1637)
    fp = mix(fp, lo2, 1637)
    fp = mix(fp, hi2, 1637)
    fp = mix(fp, lower_slack2, 1637)
    fp = mix(fp, upper_slack2, 1637)
    fp = mix(fp, 534190900, 1637)
    fp = mix(fp, 7, 1637)
    fp = mix(fp, 42445, 1637)
    fp = mix(fp, 42450, 1637)
    return fp
}

fn main() -> i64 with Mod {
    let fp = interval_containment_fingerprint(992950)
    if fp != 192258040 { return 1 }
    if interval_containment_fingerprint(1236318) != (0 - 1) { return 2 }
    return 0
}
