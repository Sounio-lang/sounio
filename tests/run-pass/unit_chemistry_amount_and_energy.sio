//@ run-pass
//@ expect-stdout: chem units: PASS

// Amount concentration, energy and pressure carry their unit through binding
// and same-unit addition, the same way mass units do. The values are exact
// binary fractions so the witness tests the units, not float rounding.
fn main() -> i32 with IO, Mut, Panic, Div {
    let c1: mol_L = 0.25
    let c2: mol_L = 0.25
    let e: kJ = 57.5
    let p: atm = 1.0
    let total = c1 + c2
    if total as f64 == 0.5 && e as f64 == 57.5 && p as f64 == 1.0 {
        print("chem units: PASS\n")
    }
    return 0
}
