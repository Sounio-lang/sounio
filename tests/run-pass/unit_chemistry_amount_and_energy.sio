//@ run-pass
//@ expect-stdout: chem units: PASS

// Amount concentration, energy and pressure carry their unit through binding
// and same-unit addition, the same way mass units do.
fn main() -> i32 with IO, Mut, Panic, Div {
    let c1: mol_L = 0.10
    let c2: mol_L = 0.05
    let e: kJ = 57.3
    let p: atm = 1.0
    let total = c1 + c2
    if total == 0.15 && e == 57.3 && p == 1.0 {
        print("chem units: PASS\n")
    }
    return 0
}
