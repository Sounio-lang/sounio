//@ run-pass
//@ expect-stdout: ALL PASS
//
// Acceptance for stdlib/dialogue/bracket.sio — bracket-sensitive dialogue
// composition over the octonions (the constructive counterpart of the SBMP
// bracket-blindness measurement).
//
// Checks:
//   W1  generic triple (e1,e2,e4): the two bracketings differ (nonzero
//       grouping effect; ‖[e1,e2,e4]‖² = 4 exactly)
//   W2  Fano triple (e1,e2,e3): bracketings coincide (associator = 0)
//   W3  anti-symmetry [a,b,c] = −[b,a,c] on a generic triple
//   W4  alternativity [a,a,b] = 0
//   W5  scaling: the grouping effect is quadratic-homogeneous witness —
//       [2a,b,c] has 4× the squared magnitude of [a,b,c]

use dialogue::bracket::{
    bracket_left, bracket_right, grouping_effect, grouping_magnitude_sq,
    associator_antisymmetric, associator_alternative,
}
use algebra::octonion::{oct_basis}

fn approx(x: f64, y: f64) -> bool {
    let d = if x > y { x - y } else { y - x }
    d < 0.0001
}

fn main() with Mut, Div, Panic, NonAssoc {
    var ok = true

    let e1 = oct_basis(1)
    let e2 = oct_basis(2)
    let e3 = oct_basis(3)
    let e4 = oct_basis(4)

    // --- W1: non-Fano triple — bracketings genuinely differ ---
    let m124: f64 = grouping_magnitude_sq(&e1, &e2, &e4)
    if approx(m124, 4.0) { print("W1 nonfano grouping ‖[e1,e2,e4]‖²=4: PASS") }
    else { print("W1 nonfano grouping: FAIL"); ok = false }

    var l: [f64; 8] = [0.0; 8]
    var r: [f64; 8] = [0.0; 8]
    bracket_left(&e1, &e2, &e4, &!l)
    bracket_right(&e1, &e2, &e4, &!r)
    var diff: f64 = 0.0
    var i: i64 = 0
    while i < 8 {
        let d: f64 = if l[i] > r[i] { l[i] - r[i] } else { r[i] - l[i] }
        if d > diff { diff = d }
        i = i + 1
    }
    if diff > 1.9 { print("W1 bracket_left ≠ bracket_right: PASS") }
    else { print("W1 bracket difference: FAIL"); ok = false }

    // --- W2: Fano triple — grouping-invariant (associative) ---
    let m123: f64 = grouping_magnitude_sq(&e1, &e2, &e3)
    if approx(m123, 0.0) { print("W2 fano grouping=0: PASS") }
    else { print("W2 fano grouping: FAIL"); ok = false }

    // --- W3: anti-symmetry on a generic triple ---
    if associator_antisymmetric(&e1, &e2, &e4, 0.0001) {
        print("W3 [a,b,c] = −[b,a,c]: PASS")
    } else { print("W3 anti-symmetry: FAIL"); ok = false }

    // --- W4: alternativity [a,a,b] = 0 ---
    if associator_alternative(&e1, &e4, 0.0001) {
        print("W4 [a,a,b] = 0: PASS")
    } else { print("W4 alternativity: FAIL"); ok = false }

    // --- W5: homogeneity witness — [2a,b,c] has 4× ‖[a,b,c]‖² ---
    var two_e1: [f64; 8] = [0.0; 8]
    var j: i64 = 0
    while j < 8 { two_e1[j] = 2.0 * e1[j]; j = j + 1 }
    let m2: f64 = grouping_magnitude_sq(&two_e1, &e2, &e4)
    if approx(m2, 4.0 * m124) { print("W5 homogeneity ×4: PASS") }
    else { print("W5 homogeneity: FAIL"); ok = false }

    if ok { print("ALL PASS") } else { print("SOME FAIL") }
}
