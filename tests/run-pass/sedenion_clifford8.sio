//@ run-pass
//@ expect-stdout: CL8 OK
// FRENTE B, vector 4/3 (physics) — the sedenion left-multiplication algebra is Cℓ(8), executed.
//
// Deep-research (peer-reviewed: Gresnigt et al., EPJC 2019 s10052-019-6967-1 / 2024 s10052-024-13476-0;
// arXiv 2306.13098) establishes: the left-multiplication algebra of the complexified sedenions ℂ⊗𝕊 is
// the Clifford algebra Cℓ(8) ≅ ℂ(16) (256 = 2^8 maps), the rank-4 step up from the octonionic Cℓ(6)
// (64 = 2^6) that underlies Furey's one-generation SM construction. This test certifies the Clifford
// PRESENTATION exactly: the eight left-multiplication operators L_1..L_8 pairwise anticommute and each
// squares to −I — eight anticommuting √(−I) generators = a Cℓ(8) presentation. The 8th generator is
// L_8 = e_8, the octonion→sedenion doubling unit (so e_8 is exactly the extra Clifford generator).
//
// Uses the SPARSE identity: e_i·e_k = σ(i,k)·e_{i⊕k}, so L_i has one entry σ(i,k) per column k at row
// i⊕k. Then (L_i L_j)[r][c] = σ(i,j⊕c)σ(j,c) at row r=i⊕j⊕c, giving:
//   {L_i,L_j}[i⊕j⊕c][c] = σ(i,j⊕c)σ(j,c) + σ(j,i⊕c)σ(i,c)   (anticommute ⟺ 0 ∀c)
//   (L_i²)[c][c] = σ(i,i⊕c)σ(i,c)                             (= −I ⟺ all −1)
// No matrix multiplication needed. Also verified: 42 of the 105 pairs {L_i,L_j} do NOT anticommute
// (the sedenion non-associativity signature), and ALL 42 are lower-upper (touch the doubling half);
// the maximal mutually-anticommuting set has 8 generators ⟹ ladder rank 4; and the Gresnigt
// S3-invariant charge Q_1 = (N_1+N_2+N_3 − 3 N_4)/3 on the 2^4 Fock space gives the SM electric-charge
// multiset {0, ±1/3, ±2/3, ±1}. (The physical THREE-GENERATION interpretation of Cℓ(8)/S3 is a
// modelling assumption, flagged OPEN — see docs/research/sedenion_clifford8.md.)
//
// Decidable integer arithmetic, no float. SELF-CONTAINED. Cross-verified vs the operator's numpy
// script and scripts/research/sedenion_clifford8_oracle.py by the gate + Lean.

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}
fn sg(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }

// {L_i, L_j} == 0 ? (sparse per-column identity)
fn anti0(i: i64, j: i64) -> bool with Mut, Panic, Div {
    var c = 0
    while c < 16 {
        if sg(i, j ^ c) * sg(j, c) + sg(j, i ^ c) * sg(i, c) != 0 { return false }
        c = c + 1
    }
    true
}
// L_i^2 == -I ?
fn sq_negI(i: i64) -> bool with Mut, Panic, Div {
    var c = 0
    while c < 16 {
        if sg(i, i ^ c) * sg(i, c) != (0 - 1) { return false }
        c = c + 1
    }
    true
}

fn main() with IO, Mut, Panic, Div {
    // (1) Cℓ(8) presentation: gamma_1..8 = L_1..L_8 each square -I, all 28 pairs anticommute.
    var sq_ok = 1
    var i = 1
    while i <= 8 {
        if !sq_negI(i) { sq_ok = 0 }
        i = i + 1
    }
    var anti28 = 0
    i = 1
    while i <= 8 {
        var j = i + 1
        while j <= 8 {
            if anti0(i, j) { anti28 = anti28 + 1 }
            j = j + 1
        }
        i = i + 1
    }

    // (2) full anticommutation fingerprint over all C(15,2)=105 pairs
    var anti_all = 0
    var nonanti = 0
    var nonanti_lohi = 0
    i = 1
    while i <= 15 {
        var j = i + 1
        while j <= 15 {
            if anti0(i, j) { anti_all = anti_all + 1 }
            else {
                nonanti = nonanti + 1
                let hi_i = if i >= 8 { 1 } else { 0 }
                let hi_j = if j >= 8 { 1 } else { 0 }
                if hi_i == 1 || hi_j == 1 { nonanti_lohi = nonanti_lohi + 1 }
            }
            j = j + 1
        }
        i = i + 1
    }

    // (3) ladder rank: greedy maximal mutually-anticommuting L_i (over 1..15).
    var chosen = [0; 16]
    var nch = 0
    i = 1
    while i <= 15 {
        var ok = 1
        var t = 0
        while t < nch {
            if !anti0(i, chosen[t as usize]) { ok = 0 }
            t = t + 1
        }
        if ok == 1 {
            chosen[nch as usize] = i
            nch = nch + 1
        }
        i = i + 1
    }
    let rank = nch / 2

    // (4) Gresnigt S3-invariant charge Q_1 = (N1+N2+N3 - 3 N4)/3 on the 2^4 Fock space.
    // 3*Q ranges over {-3,-2,-1,0,1,2,3}; count each. Expect {-3:1,-2:3,-1:3,0:2,1:3,2:3,3:1}.
    var qc = [0; 8]     // index by 3Q + 3  (0..6)
    var occ = 0
    while occ < 16 {
        let n1 = (occ >> 0) & 1
        let n2 = (occ >> 1) & 1
        let n3 = (occ >> 2) & 1
        let n4 = (occ >> 3) & 1
        let q3 = n1 + n2 + n3 - 3 * n4
        qc[(q3 + 3) as usize] = qc[(q3 + 3) as usize] + 1
        occ = occ + 1
    }
    var q_ok = 1
    if qc[0 as usize] != 1 { q_ok = 0 }   // 3Q=-3
    if qc[1 as usize] != 3 { q_ok = 0 }   // -2
    if qc[2 as usize] != 3 { q_ok = 0 }   // -1
    if qc[3 as usize] != 2 { q_ok = 0 }   //  0
    if qc[4 as usize] != 3 { q_ok = 0 }   //  1
    if qc[5 as usize] != 3 { q_ok = 0 }   //  2
    if qc[6 as usize] != 1 { q_ok = 0 }   //  3

    print("CL8_SQ_OK ")
    print_int(sq_ok as i64)
    print("\n")
    print("CL8_ANTI28 ")
    print_int(anti28 as i64)
    print("\n")
    print("NONANTI ")
    print_int(nonanti as i64)
    print("\n")
    print("NONANTI_LOHI ")
    print_int(nonanti_lohi as i64)
    print("\n")
    print("GENS ")
    print_int(nch as i64)
    print("\n")
    print("RANK ")
    print_int(rank as i64)
    print("\n")
    print("Q1_OK ")
    print_int(q_ok as i64)
    print("\n")
    // Cℓ(8): 8 anticommuting sqrt(-I) generators (28 pairs); 42 non-anti all lo-hi; ladder rank 4;
    // Gresnigt Q_1 gives SM electric charges.
    if sq_ok == 1 && anti28 == 28 && nonanti == 42 && nonanti_lohi == 42 && nch == 8 && rank == 4 && q_ok == 1 {
        println("CL8 OK")
    } else {
        println("CL8 FAIL")
    }
}
