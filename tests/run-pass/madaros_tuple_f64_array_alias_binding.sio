//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_ALIAS_BINDING PASS
//
// Copilot review (PR #2516), finding 1 on the seventh review round:
// expr_result_tuple_arr_mask_ref (the tuple-slot array-mask classifier)
// had no ExprIdent case, so an unannotated tuple ALIAS --
// `let t = pair(); let u = t` -- lost the mask entirely: `u`'s
// initializer is a plain identifier naming `t`, and this function runs at
// BIND time to compute the mask attached to `u` itself, so without
// propagating `t`'s already-tracked mask, `u` was bound with mask 0
// regardless of `t`'s correct one. Both `u.0` (direct field access) and
// `let (a, n) = u` (destructure) then fell back to the integer path.
fn pair() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let t = pair()
    let u = t

    // Direct field access on the ALIAS, not on `t` itself.
    let ua = u.0
    let s0: f64 = ua[0] * 2.0

    // Destructure the alias.
    let (a2, b2) = u
    let s1: f64 = a2[0] * 2.0
    let s2: f64 = 2.0 * b2[0]

    if s0 == 3.0 && s1 == 3.0 && s2 == 0.5 {
        println("TUPLE_F64_ARRAY_ALIAS_BINDING PASS")
        return 0
    }
    1
}
