//@ run-pass
//@ known-failure: signed negative i128 division is currently compiled as unsigned wide division; fix requires signedness through wide lowering/codegen
//@ description: Regression pin for signed i128 division used by future fixed-point Lorenz kernels

fn main() -> i64 {
    let numerator: i128 = (0 as i128) - (16666660000 as i128)
    let denominator: i128 = 1000000 as i128
    let q: i128 = numerator / denominator

    if q == ((0 as i128) - (16666 as i128)) { return 0 }
    return 1
}
