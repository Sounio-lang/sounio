//@ run-pass
use algebra::fano::{is_fano_line, non_fano_ordered_triples}

fn main() -> i32 with IO, Mut, Div, Panic {
    // The seven Fano lines must all be recognised.
    let f1 = is_fano_line(1, 2, 3)
    let f2 = is_fano_line(1, 4, 5)
    let f3 = is_fano_line(1, 6, 7)
    let f4 = is_fano_line(2, 4, 6)
    let f5 = is_fano_line(2, 5, 7)
    let f6 = is_fano_line(3, 4, 7)
    let f7 = is_fano_line(3, 5, 6)
    let all_lines = f1 && f2 && f3 && f4 && f5 && f6 && f7

    // Non-lines must be rejected.
    let n1 = is_fano_line(1, 2, 4)   // XOR = 7, not a line
    let n2 = is_fano_line(1, 2, 2)   // duplicate
    let n3 = is_fano_line(0, 1, 2)   // out of range
    let no_false_lines = !n1 && !n2 && !n3

    // Enumerated 168 non-Fano ordered triples.
    var oi: [i64; 200] = [0; 200]
    var oj: [i64; 200] = [0; 200]
    var ok: [i64; 200] = [0; 200]
    let n = non_fano_ordered_triples(&!oi, &!oj, &!ok)
    let count_ok = n == 168

    // Spot-check: each triple must be non-Fano with distinct entries.
    var t: i64 = 0
    var all_valid = true
    while t < n {
        let a = oi[t as usize]
        let b = oj[t as usize]
        let c = ok[t as usize]
        if a == b || b == c || a == c { all_valid = false }
        if a < 1 || a > 7 || b < 1 || b > 7 || c < 1 || c > 7 { all_valid = false }
        if is_fano_line(a, b, c) { all_valid = false }
        t = t + 1
    }

    if all_lines && no_false_lines && count_ok && all_valid {
        println("fano ALL PASS")
        0
    } else {
        println("fano FAIL")
        1
    }
}
