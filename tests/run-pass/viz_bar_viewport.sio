 viz_node_set_label(&!scene,xa,&pos,24)
 viz_node_set_label(&!scene,xb,&pos,24)
 viz_node_set_label(&!scene,ya,&unit,2)
 viz_node_set_label(&!scene,yb,&unit,2)
 assert(viz_add_label(&!scene,&title,51,viz_layout_rect(100,20,820,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&left,20,viz_layout_rect(164,94,340,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&right,32,viz_layout_rect(580,94,340,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&foot,55,viz_layout_rect(100,385,820,20),viz_style_rgb(220,230,240))>=0)
 assert(viz_add_label(&!scene,&note,49,viz_layout_rect(100,420,820,20),viz_style_rgb(220,230,240))>=0)
 assert(scene.node_count==11 && scene.series_count==2)
 let pixels=heap_alloc(960*480*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:960,height:480}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,250*960+169)==70*65536+180*256+235)
 assert(read_i64(canvas.pixels,200*960+294)==70*65536+180*256+235)
 assert(read_i64(canvas.pixels,270*960+580)==245*65536+170*256+65)
 assert(read_i64(canvas.pixels,150*960+760)==245*65536+170*256+65)
 viz_html_emit_scene(&scene,960,480)
 println("VIZ_BAR_VIEWPORT_PASS")
 0
}
