//@ run-pass
//@ description: Imported Lorenz i256 z=0 y-step bridge smoke

use systems::lorenz_i256_limb_bridge::*
use systems::lorenz_i256_rho_x_minus_y_bridge::*
use systems::lorenz_i256_y_step_z0_bridge::*

fn main() -> i64 with Div {
    let positive = lorenz_i256_y_step_z0_check(
        100000000, 0, 0, 0, 800000000, 1, 0, 0, 800000000, 2, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_y_step_z0_check(
        50000000, 0, 0, 0, 0, 2, 0, 0, 400000000, 1, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_y_step_z0_check(
        50000000, 0, 0, 0, 400000000, 1, 0, 0, 400000000, 1, 0, 0)
    if zero != 1 { return 3 }

    let invalid = lorenz_i256_y_step_z0_limb(
        1000000000, 0, 0, 0, 0, 0, 0, 0, 0)
    if invalid != 0 - 1 { return 4 }

    let rho_anchor = lorenz_i256_rho_x_minus_y_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 107)
    if rho_anchor != 570239184 { return 5 }

    let rho_audit = lorenz_i256_rho_x_minus_y_bridge_audit_fingerprint(
        rho_anchor, 314762905, 726591438, 734815269, 216903584,
        492681735, 837260419, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 107, 1023)
    if rho_audit != 908416527 { return 6 }

    let limb_anchor = lorenz_i256_limb_bridge_receipt_check(
        1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 102)
    if limb_anchor != 681429570 { return 7 }

    let limb_audit = lorenz_i256_limb_bridge_audit_fingerprint(
        limb_anchor, 905714263, 247816039, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 102, 1023)
    if limb_audit != 352908746 { return 8 }

    let artifact = lorenz_i256_y_step_z0_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 108)
    if artifact != 760481923 { return 9 }

    let audit = lorenz_i256_y_step_z0_bridge_audit_fingerprint(
        artifact, 619384257, 847205316, rho_anchor, rho_audit,
        limb_anchor, limb_audit, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 108, 1023)
    if audit != 135972604 { return 10 }
    return 0
}
