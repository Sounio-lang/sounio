//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1433
    fp = mix(fp, 5, 5231)
    fp = mix(fp, 40755632, 5231)
    fp = mix(fp, 556529793, 5231)
    fp = mix(fp, 225293164, 5231)
    fp = mix(fp, 897523976, 5231)
    fp = mix(fp, 989883403, 5231)
    fp = mix(fp, 815806077, 5231)
    fp = mix(fp, 69995750, 5231)
    fp = mix(fp, 2, 5231)
    fp = mix(fp, 1000000, 5231)
    fp = mix(fp, 1, 5231)
    fp = mix(fp, 100, 5231)
    fp = mix(fp, 242489, 5231)
    fp = mix(fp, 319183, 5231)
    fp = mix(fp, 42444, 5231)
    fp = mix(fp, 35793, 5231)
    fp = mix(fp, 50535, 5231)
    fp = mix(fp, 7132, 5231)
    fp = mix(fp, 278282, 5231)
    fp = mix(fp, 369718, 5231)
    fp = mix(fp, 49576, 5231)
    fp = mix(fp, 279000, 5231)
    fp = mix(fp, 370000, 5231)
    fp = mix(fp, 50000, 5231)
    fp = mix(fp, 718, 5231)
    fp = mix(fp, 282, 5231)
    fp = mix(fp, 424, 5231)
    fp = mix(fp, 7, 5231)
    fp = mix(fp, 7, 5231)
    fp = mix(fp, 0, 5231)
    fp = mix(fp, 12, 5231)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 289647059 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1439
    fp = mix(fp, instance, 5233)
    fp = mix(fp, 242489, 5233)
    fp = mix(fp, 319183, 5233)
    fp = mix(fp, 42444, 5233)
    fp = mix(fp, 35793, 5233)
    fp = mix(fp, 50535, 5233)
    fp = mix(fp, 7132, 5233)
    fp = mix(fp, 278282, 5233)
    fp = mix(fp, 369718, 5233)
    fp = mix(fp, 49576, 5233)
    fp = mix(fp, 279000, 5233)
    fp = mix(fp, 370000, 5233)
    fp = mix(fp, 50000, 5233)
    fp = mix(fp, 718, 5233)
    fp = mix(fp, 282, 5233)
    fp = mix(fp, 424, 5233)
    fp = mix(fp, 7, 5233)
    fp = mix(fp, 7, 5233)
    fp = mix(fp, 0, 5233)
    fp = mix(fp, 12, 5233)
    fp = mix(fp, ok_mask, 5233)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 289647059 { return 0 - 1 }
    if certificate != 886367159 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1447
    fp = mix(fp, instance, 5237)
    fp = mix(fp, certificate, 5237)
    fp = mix(fp, 13, 5237)
    fp = mix(fp, 5, 5237)
    fp = mix(fp, 7, 5237)
    fp = mix(fp, 7, 5237)
    fp = mix(fp, 0, 5237)
    fp = mix(fp, 12, 5237)
    fp = mix(fp, ok_mask, 5237)
    return fp
}

fn obligation_mask() -> i64 {
    let x_need: i64 = 242489 + 35793
    let y_need: i64 = 319183 + 50535
    let z_need: i64 = 42444 + 7132
    let x_margin: i64 = 279000
    let y_margin: i64 = 370000
    let z_margin: i64 = 50000
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var axis_mask: i64 = 0
    if x_need <= x_margin { axis_mask = axis_mask + 1 }
    if y_need <= y_margin { axis_mask = axis_mask + 2 }
    if z_need <= z_margin { axis_mask = axis_mask + 4 }

    var ok_mask: i64 = 0
    if 40755632 > 0 {
        if 225293164 > 0 { ok_mask = ok_mask + 1 }
    }
    if 989883403 > 0 {
        if 815806077 > 0 { ok_mask = ok_mask + 2 }
    }
    if x_need == 278282 {
        if y_need == 369718 {
            if z_need == 49576 { ok_mask = ok_mask + 4 }
        }
    }
    if axis_mask == 7 {
        if x_slack > 0 {
            if y_slack > 0 {
                if z_slack > 0 { ok_mask = ok_mask + 8 }
            }
        }
    }
    if 2 == 2 {
        if 1000000 == 1000000 { ok_mask = ok_mask + 16 }
    }
    if axis_mask == 7 {
        if 12 == 12 { ok_mask = ok_mask + 32 }
    }
    if 0 == 0 { ok_mask = ok_mask + 64 }
    if x_slack == 718 {
        if y_slack == 282 {
            if z_slack == 424 { ok_mask = ok_mask + 128 }
        }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = obligation_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 289647059 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 886367159 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 291436394 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
