//@ run-pass
//@ requires: madaros
//@ expect-stdout: USER_EFFECT_OK 42
//@ description: a declared `effect X {}` is a user effect on Madaros, not E246
// Until 2026-10-31 the Madaros *mut collect spine had no ItemEffect arm, so a
// declared effect never reached the user-effect registry and every `with HostT`
// below was refused with E246 ("not a declared user effect"). lean_single
// accepted this file all along. stdlib/coordination/loom_continuity.sio
// (`pub effect LoomHostTrust {}`) could not be checked by Madaros for the same
// reason.

effect HostT {}

effect Ledger {
    fn entry() -> i64
}

fn trusted_add(x: i64) -> i64 with HostT { x + 1 }

fn both(x: i64) -> i64 with HostT, Ledger { trusted_add(x) + 1 }

fn main() -> i64 with IO, HostT, Ledger {
    let v = both(40)
    print("USER_EFFECT_OK ")
    println(v)
    0
}
