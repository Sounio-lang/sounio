//@ run-pass
//@ requires: madaros
//@ expect-stdout: 18446744073709551615

// SIO-399: println of a u64 with the high bit set must print unsigned.
fn shr_u(x: u64) -> u64 { x >> 60 }
fn div_u(x: u64, y: u64) -> u64 { x / y }

fn main() -> i32 with IO {
    let top: u64 = 18446744073709551615
    println(top)
    println(shr_u(top))
    println(div_u(top, 2))
    if top == 18446744073709551615 && shr_u(top) == 15 && div_u(top, 2) == 9223372036854775807 {
        print("U64_PRINT_PASS\n")
    }
    return 0
}
