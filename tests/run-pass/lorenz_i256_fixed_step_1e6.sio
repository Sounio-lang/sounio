//@ run-pass
//@ known-failure: source-level i256 Lorenz fixed-point division path: main returns 1. Not a segfault/139
//@ description: Lorenz one-step fixed-point smoke over i256 arithmetic at scale 1e6

fn main() -> i64 {
    let scale: i256 = 1000000 as i256
    let dt: i256 = 10000 as i256

    let sigma: i256 = 10 as i256
    let rho: i256 = 28 as i256
    let beta_num: i256 = 8 as i256
    let beta_den: i256 = 3 as i256

    let x: i256 = scale
    let y: i256 = scale
    let z: i256 = scale

    // Same point contract as lorenz_i128_fixed_step, but through i256 lowering.
    let dx: i256 = sigma * (y - x)
    let dy: i256 = (x * ((rho * scale) - z)) / scale - y
    let dz: i256 = (x * y) / scale - (beta_num * z) / beta_den

    let nx: i256 = x + (dt * dx) / scale
    let ny: i256 = y + (dt * dy) / scale
    let z_drop: i256 = (dt * ((0 as i256) - dz)) / scale
    let nz: i256 = z - z_drop

    if dx != (0 as i256) { return 1 }
    if dy != (26000000 as i256) { return 2 }
    if dz != ((0 as i256) - (1666666 as i256)) { return 3 }
    if nx != (1000000 as i256) { return 4 }
    if ny != (1260000 as i256) { return 5 }
    if nz != (983334 as i256) { return 6 }
    return 0
}
