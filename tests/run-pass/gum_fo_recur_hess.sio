//@ run-pass
//@ requires: madaros
//@ expect-stdout: direct 2.000000
//@ expect-stdout: h1 2.000000
//@ expect-stdout: h2 300.000000
//@ expect-stdout: hl1 2.000000
//@ expect-stdout: hl2 300.000000
//@ expect-stdout: v1 9.000000
//@ expect-stdout: v2 22500.000000
//@ expect-stdout: RECUR_HESS_OK
// a = 5. H(a*a) = 2. H(a^4) = 12*a^2 = 300.
// The recurrence loop used to publish 0 for both.

fn sq(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        sq(x, n - 1) * sq(x, n - 1)
    }
}

fn sqlet(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        let t = sqlet(x, n - 1)
        t * t
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let direct = hessian_of(a * a, 0, 0)
    let h1 = hessian_of(sq(a, 1), 0, 0)
    let h2 = hessian_of(sq(a, 2), 0, 0)
    let hl1 = hessian_of(sqlet(a, 1), 0, 0)
    let hl2 = hessian_of(sqlet(a, 2), 0, 0)
    let v1 = variance_of(sq(a, 1))
    let v2 = variance_of(sq(a, 2))
    print("direct ")
    print_f64(direct)
    println("")
    print("h1 ")
    print_f64(h1)
    println("")
    print("h2 ")
    print_f64(h2)
    println("")
    print("hl1 ")
    print_f64(hl1)
    println("")
    print("hl2 ")
    print_f64(hl2)
    println("")
    print("v1 ")
    print_f64(v1)
    println("")
    print("v2 ")
    print_f64(v2)
    println("")
    var fails: i64 = 0
    if direct < 1.999999 || direct > 2.000001 { fails = fails + 1 }
    if h1 < 1.999999 || h1 > 2.000001 { fails = fails + 1 }
    if h2 < 299.999999 || h2 > 300.000001 { fails = fails + 1 }
    if hl1 < 1.999999 || hl1 > 2.000001 { fails = fails + 1 }
    if hl2 < 299.999999 || hl2 > 300.000001 { fails = fails + 1 }
    if v1 < 8.999999 || v1 > 9.000001 { fails = fails + 1 }
    if v2 < 22499.999 || v2 > 22500.001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_HESS_OK")
        0
    } else {
        println("RECUR_HESS_FAIL")
        1
    }
}
