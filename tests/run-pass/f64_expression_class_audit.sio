//@ run-pass
//@ requires: madaros
//@ expect-stdout: F64_EXPRESSION_CLASS_OK

use special::erf::*

struct FloatSource { sample: f64 }
struct IntegerSource { sample: i64 }

impl FloatSource {
    fn read(self: &FloatSource) -> f64 { self.sample }
}

fn float_value() -> f64 { 2.0 }

fn check_match(mode: i64) -> i32 with Mut, Div {
    let actual = match mode {
        1 => sqrt(4.0),
        _ => 0.0,
    }
    if mode == 1 {
        if actual / 16.0 != 0.125 { return 1 }
        if 16.0 / actual != 8.0 { return 2 }
        if actual + 1.0 != 3.0 { return 3 }
        if !(actual > 1.0 && actual < 3.0) { return 4 }
    } else {
        if actual / 16.0 != 0.0 { return 5 }
    }
    let literal = match mode { 1 => 2.0, _ => 4.0 }
    if mode == 1 {
        if literal / 16.0 != 0.125 { return 6 }
    } else {
        if literal / 16.0 != 0.25 { return 7 }
    }
    if (match mode { 1 => float_value(), _ => 2.0 }) / 16.0 != 0.125 { return 8 }
    let nested = match mode { 1 => { { float_value() } }, _ => { { 2.0 } } }
    if nested / 16.0 != 0.125 { return 9 }
    let source = FloatSource { sample: 2.0 }
    let method = match mode { 1 => source.read(), _ => 2.0 }
    if method / 16.0 != 0.125 { return 10 }
    0
}

fn check_scopes(mode: i64) -> i32 with Mut, Div {
    let actual = if mode == 1 {
        let local = sqrt(4.0)
        let alias = local
        alias
    } else {
        let local = 0.0
        local
    }
    if mode == 1 {
        if actual / 16.0 != 0.125 { return 11 }
    } else {
        if actual / 16.0 != 0.0 { return 12 }
    }
    let scoped_match = match mode {
        1 => { let local = float_value() local },
        _ => { var local: f64 = 2.0 local },
    }
    if scoped_match / 16.0 != 0.125 { return 13 }
    let outer: i64 = 7
    let shadow = if mode == 1 { let outer = 2.0 outer } else { let outer = 4.0 outer }
    if mode == 1 {
        if shadow / 16.0 != 0.125 { return 14 }
    } else {
        if shadow / 16.0 != 0.25 { return 15 }
    }
    if outer / 2 != 3 { return 16 }
    let single = { let local = float_value() local }
    if single / 16.0 != 0.125 { return 17 }
    let binary = if mode == 1 { let local = 1.0 local + 1.0 } else { let local = 3.0 local - 1.0 }
    if binary / 16.0 != 0.125 { return 18 }
    0
}

fn check_controls(mode: i64) -> i32 with Mut, Div, Alloc {
    let integer = match mode { 1 => 7, _ => 9 }
    if mode == 1 {
        if integer / 2 != 3 { return 21 }
    } else {
        if integer / 2 != 4 { return 22 }
    }
    let outer = 2.0
    let integer_shadow = if mode == 1 { let outer: i64 = 7 outer } else { let outer: i64 = 9 outer }
    if mode == 1 {
        if integer_shadow / 2 != 3 { return 23 }
    } else {
        if integer_shadow / 2 != 4 { return 24 }
    }
    if outer / 16.0 != 0.125 { return 25 }
    let boolean = match mode { 1 => float_value() > 1.0, _ => float_value() < 3.0 }
    if !boolean { return 26 }
    let casted = match mode { 1 => float_value() as i64, _ => 2 }
    if casted / 2 != 1 { return 27 }
    let option_outer = 2.0
    let option_source: Option<i64> = Some(7)
    let option_integer = match option_source { Some(option_outer) => option_outer, _ => 9 }
    if option_integer / 2 != 3 { return 28 }
    if (option_integer as f64) / 2.0 != 3.5 { return 29 }
    let binding_outer = 2.0
    let binding_integer = match 7 { binding_outer => binding_outer }
    if binding_integer / 2 != 3 { return 30 }
    if (binding_integer as f64) / 2.0 != 3.5 { return 31 }
    let field_outer = 2.0
    let field_source = IntegerSource { sample: 7 }
    let field_integer = match field_source { IntegerSource { sample: field_outer } => field_outer }
    if field_integer / 2 != 3 { return 32 }
    if (field_integer as f64) / 2.0 != 3.5 { return 33 }
    0
}

fn main() -> i32 with IO, Mut, Div, Alloc {
    let match_enabled = check_match(1)
    if match_enabled != 0 { return match_enabled }
    let match_disabled = check_match(0)
    if match_disabled != 0 { return match_disabled }
    let scopes_enabled = check_scopes(1)
    if scopes_enabled != 0 { return scopes_enabled }
    let scopes_disabled = check_scopes(0)
    if scopes_disabled != 0 { return scopes_disabled }
    let controls_enabled = check_controls(1)
    if controls_enabled != 0 { return controls_enabled }
    let controls_disabled = check_controls(0)
    if controls_disabled != 0 { return controls_disabled }
    println("F64_EXPRESSION_CLASS_OK")
    0
}
