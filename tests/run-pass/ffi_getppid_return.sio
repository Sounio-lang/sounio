//@ run-pass
// extern "C" getppid() under the default Madaros engine — Track A PR-A1.
//
// The parser rewrites this declaration into a wrapper fn forwarding to the
// ffi_getppid intrinsic (docs/audit/MADAROS_EXTERN_C_BUILTIN_PORT_DISPATCH_
// 2026-08-16.md); the native builtin registry emits it as syscall 110.
// Before Track A the bodyless declaration lowered as a shadow fn whose body
// returned a fabricated 0 — a real getppid() can never return 0 (PID 0 is
// not a valid parent PID for a normal process).

extern "C" {
    fn getppid() -> i64
}

fn main() -> i32 with IO, Panic {
    let ppid = getppid()
    if ppid > 0 {
        println("ffi_getppid_return: PASS")
        return 0
    }
    println("ffi_getppid_return: FAIL")
    return 1
}
