//@ description: Tiny portfolio v79 smoke for Lorenz i256 step-5 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1453
    receipt_fp = mix(receipt_fp, 291436394, 5273)
    receipt_fp = mix(receipt_fp, 876674722, 5273)
