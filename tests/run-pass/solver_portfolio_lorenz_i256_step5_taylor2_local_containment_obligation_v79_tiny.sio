    receipt_fp = mix(receipt_fp, 501874592, 5273)
    receipt_fp = mix(receipt_fp, 153536131, 5273)
    receipt_fp = mix(receipt_fp, 414316671, 5273)
    receipt_fp = mix(receipt_fp, 220149970, 5273)
    receipt_fp = mix(receipt_fp, 5, 5273)
    receipt_fp = mix(receipt_fp, 13, 5273)
    receipt_fp = mix(receipt_fp, 255, 5273)
    if receipt_fp != 590242925 { return 1 }

    var audit_fp: i64 = 1459
    audit_fp = mix(audit_fp, receipt_fp, 5279)
    audit_fp = mix(audit_fp, 291436394, 5279)
    audit_fp = mix(audit_fp, 876674722, 5279)
    audit_fp = mix(audit_fp, 276176246, 5279)
    audit_fp = mix(audit_fp, 305023267, 5279)
    audit_fp = mix(audit_fp, 362923525, 5279)
    audit_fp = mix(audit_fp, 495796683, 5279)
    audit_fp = mix(audit_fp, 501874592, 5279)
    audit_fp = mix(audit_fp, 5, 5279)
    audit_fp = mix(audit_fp, 13, 5279)
    audit_fp = mix(audit_fp, 255, 5279)
    if audit_fp != 820968143 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 82, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 82, 1103)
    if entry_fp != 22667633 { return 3 }

    let manifest_fp: i64 = 814116954
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 79, 1871)
    result_fp = mix(result_fp, 83, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 71, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 732141111 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 79, 1907)
    family_fp = mix(family_fp, 83, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 66, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 216535819 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 79, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 89796164 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 79, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 164051989 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 79, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 296359452 { return 8 }
    return 0
