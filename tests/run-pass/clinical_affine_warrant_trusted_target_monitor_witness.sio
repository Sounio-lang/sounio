//@ check-only
//@ description: Imported D12 API and private affine typestate conformance

use epistemic::proof_carrying_affine_warrant_trusted_target_monitor::*

fn main() -> i32 with IO, Panic {
    let trace = run_d12_fixture_affine_attenuation_trace()
    assert(trace.warrant_id == 31100)
    assert(trace.monitor_id == 32031 && trace.sink_id == 32032)
    assert(trace.resource_id == 32041)
    assert(trace.start_rank == 3 && trace.degraded_rank == 2)
    assert(trace.suspended_rank == 1 && trace.revoked_rank == 0)
    assert(trace.start_scope == 4 && trace.degraded_scope == 2)
    assert(trace.suspended_scope == 0 && trace.revoked_scope == 0)
    assert(trace.start_epoch == 1 && trace.final_epoch == 4)
    assert(trace.start_fence == 1 && trace.final_fence == 4)
    assert(trace.protected_effect_count == 3)
    assert(trace.durable_completion_count == 3)
    assert(trace.affine_capability_required)
    assert(!trace.rank_promoted && !trace.scope_widened)
    assert(!trace.production_authority && !trace.clinical_action_authority)

    let fencing = observe_d12_fencing_replay_contest()
    assert(fencing.first_operation_id == 32101)
    assert(fencing.second_operation_id == 32102)
    assert(fencing.third_operation_id == 32103)
    assert(fencing.first_effect_count == 1)
    assert(fencing.retry_effect_count == 1)
    assert(fencing.final_effect_count == 3)
    assert(fencing.final_completion_count == 3)
    assert(fencing.final_fence == 4)
    assert(fencing.exact_retry_returned_recorded_result)
    assert(fencing.historical_retry_returned_recorded_result)
    assert(fencing.historical_retry_effect_count == 3)
    assert(fencing.stale_fence_rejected)
    assert(fencing.wrong_payload_rejected)
    assert(fencing.historical_wrong_payload_rejected)
    assert(fencing.replay_with_new_fence_rejected)
    assert(fencing.wrong_model_rejected)
    assert(fencing.wrong_site_rejected)
    assert(fencing.wrong_population_rejected)
    assert(fencing.wrong_resource_rejected)
    assert(fencing.overflow_successor_rejected)
    assert(fencing.completion_capacity_rejected)
    assert(fencing.completion_records_retained == 3)
    assert(fencing.context_commitment == 423932683)
    assert(!fencing.context_commitment_is_cryptographic)
    assert(!fencing.protected_effect_repeated_on_retry)
    assert(!fencing.client_side_check_is_sufficient)
    assert(fencing.sink_mediation_required)
    assert(fencing.journal_fingerprint == 462281909)

    let crash = observe_d12_crash_recovery_contest()
    assert(crash.operation_id == 32101)
    assert(crash.effect_count_before_intent == 0)
    assert(crash.effect_count_after_intent_recovery == 1)
    assert(crash.effect_count_after_lost_reply_retry == 1)
    assert(crash.completion_count_after_retry == 1)
    assert(crash.crash_before_intent_recovers_prior_state)
    assert(crash.durable_intent_replay_applies_once)
    assert(crash.lost_reply_retry_returns_recorded_result)
    assert(crash.nontransactional_unknown_outcome_code == 3)
    assert(crash.nontransactional_unknown_is_indeterminate)
    assert(!crash.indeterminate_authorizes_continuation)
    assert(crash.backup_rollback_fence_rejected)
    assert(!crash.real_durable_storage_proven)
    assert(!crash.distributed_exactly_once_proven)

    let unavailable = observe_d12_monitor_unavailable_refusal()
    assert(!unavailable.monitor_reachable)
    assert(!unavailable.freshness_established)
    assert(!unavailable.protected_effect_applied)
    assert(!unavailable.continuation_authorized)
    assert(unavailable.failed_closed)

    let gc = observe_d12_premature_completion_gc_refusal()
    assert(gc.replay_horizon_epoch == 9 && gc.proposed_gc_epoch == 8)
    assert(gc.replay_still_possible)
    assert(!gc.completion_record_collected)
    assert(gc.premature_gc_rejected)

    let unlabeled = observe_d12_unlabeled_monitoring_boundary()
    assert(unlabeled.observed_label_count == 0)
    assert(unlabeled.unlabeled_shift_observed)
    assert(!unlabeled.labeled_performance_established)
    assert(!unlabeled.production_authority)
    assert(!unlabeled.clinical_action_authority)

    print("affine warrant trusted target monitor OK\n")
    0
}
