//@ run-pass
//@ requires: madaros
//@ expect-stdout: 0.002500
struct UserValue { value: f64, other: f64 }
fn mk(y: f64, u: f64) -> Knowledge<f64> with IO, Mut, Div, Panic, Alloc, Epistemic {
    print("CALL\n")
    let k: Knowledge<f64> = measure(y, uncertainty: u)
    k
}
fn user() -> UserValue with Mut, Alloc {
    UserValue { value: 0.25, other: 19.0 }
}
fn main() -> i32 with IO, Mut, Div, Panic, Alloc, Epistemic {
    let a = variance_of(mk(0.25, 0.05))
    print_f64(a); print("\n")
    if a < 0.002499999999 || a > 0.002500000001 { return 1 }
    let b = variance_of(mk(0.25, 0.05).value)
    print_f64(b); print("\n")
    if b < 0.002499999999 || b > 0.002500000001 { return 2 }
    let c = variance_of(user().value)
    print_f64(c); print("\n")
    if c != 0.0 { return 3 }
    return 0
}
