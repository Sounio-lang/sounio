//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: COUNT_DATASET_STATUS_PASS
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_at,integer_buffer_close}
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close}
use genomics::count_dataset::{count_dataset_align,count_dataset_gene,count_dataset_offsets,count_dataset_budget_new,count_dataset_reserve_gene,count_dataset_budget_info}
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
 var ck=integer_buffer_new(3,24)
 var mk=integer_buffer_new(3,24)
 var perm=integer_buffer_new(3,24)
 var co=integer_buffer_new(3,24)
 var mo=integer_buffer_new(3,24)
 var st=integer_buffer_new(3,24)
 var marks=integer_buffer_new(3,24)
 var counts=integer_buffer_new(6,48)
 var row=integer_buffer_new(3,24)
 var lf=numeric_buffer_new(3,24)
 var le=numeric_buffer_new(3,24)
 var off=numeric_buffer_new(3,24)
 var ns=numeric_buffer_new(3,24)
 integer_buffer_set(&!ck,0,9);integer_buffer_set(&!ck,1,-5);integer_buffer_set(&!ck,2,2)
 integer_buffer_set(&!mk,0,2);integer_buffer_set(&!mk,1,9);integer_buffer_set(&!mk,2,-5)
 var i:i64=0
 while i<3 {integer_buffer_set(&!perm,i,99);integer_buffer_set(&!row,i,77);numeric_buffer_set(&!off,i,88.0);i=i+1}
 let exhausted=count_dataset_align(&ck,&mk,0,&!perm,&!co,&!mo,&!st)
 assert(exhausted.status==6 && exhausted.comparisons==0)
 assert(integer_buffer_at(&perm,0)==99)
 let aligned=count_dataset_align(&ck,&mk,100,&!perm,&!co,&!mo,&!st)
 assert(aligned.status==0)
 assert(integer_buffer_at(&perm,0)==2 && integer_buffer_at(&perm,1)==0 && integer_buffer_at(&perm,2)==1)
 integer_buffer_set(&!mk,2,9)
 let dup=count_dataset_align(&ck,&mk,100,&!perm,&!co,&!mo,&!st)
 assert(dup.status==2 && integer_buffer_at(&perm,0)==2)
 integer_buffer_set(&!mk,2,123)
 let missing=count_dataset_align(&ck,&mk,100,&!perm,&!co,&!mo,&!st)
 assert(missing.status==3 && integer_buffer_at(&perm,1)==0)
 integer_buffer_set(&!mk,2,-5)
 i=0
 while i<6 {integer_buffer_set(&!counts,i,i+10);i=i+1}
 assert(count_dataset_gene(&counts,2,3,1,&perm,9007199254740992,&!row,&!marks)==0)
 assert(integer_buffer_at(&row,0)==15 && integer_buffer_at(&row,1)==13 && integer_buffer_at(&row,2)==14)
 integer_buffer_set(&!counts,4,-1)
 assert(count_dataset_gene(&counts,2,3,1,&perm,9007199254740992,&!row,&!marks)==4)
 assert(integer_buffer_at(&row,2)==14)
 integer_buffer_set(&!counts,4,14)
 integer_buffer_set(&!perm,2,0)
 assert(count_dataset_gene(&counts,2,3,1,&perm,9007199254740992,&!row,&!marks)==4)
 integer_buffer_set(&!perm,2,1)
 numeric_buffer_set(&!lf,0,0.25);numeric_buffer_set(&!lf,1,-0.5);numeric_buffer_set(&!lf,2,1.0)
 numeric_buffer_set(&!le,0,0.5);numeric_buffer_set(&!le,1,0.25);numeric_buffer_set(&!le,2,-0.25)
 assert(count_dataset_offsets(&lf,&le,&perm,&!off,&!ns,&!marks)==0)
 assert(numeric_buffer_at(&off,0)==1.5 && numeric_buffer_at(&off,1)==0.5 && numeric_buffer_at(&off,2)==-0.75)
 numeric_buffer_set(&!le,2,0.0/0.0)
 assert(count_dataset_offsets(&lf,&le,&perm,&!off,&!ns,&!marks)==5)
 assert(numeric_buffer_at(&off,0)==1.5 && numeric_buffer_at(&off,2)==-0.75)
 var budget=count_dataset_budget_new(2,20)
 assert(count_dataset_reserve_gene(&!budget,12)==0)
 assert(count_dataset_reserve_gene(&!budget,9)==6)
 assert(count_dataset_reserve_gene(&!budget,8)==0)
 assert(count_dataset_reserve_gene(&!budget,1)==6)
 let info=count_dataset_budget_info(&budget)
 assert(info.genes_charged==2 && info.evaluations_charged==20 && info.evaluations_left==0)
 integer_buffer_close(ck);integer_buffer_close(mk);integer_buffer_close(perm);integer_buffer_close(co);integer_buffer_close(mo);integer_buffer_close(st);integer_buffer_close(marks);integer_buffer_close(counts);integer_buffer_close(row)
 numeric_buffer_close(lf);numeric_buffer_close(le);numeric_buffer_close(off);numeric_buffer_close(ns)
 println("COUNT_DATASET_STATUS_PASS")
 return 0
}
