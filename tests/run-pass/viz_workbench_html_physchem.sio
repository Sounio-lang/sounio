// tests/run-pass/viz_workbench_html_physchem.sio - Workbench physchem HTML/export parity
//
// Expected output includes:
//   data-viz-tag="8405"
//   data-viz-tag="8406"
//   <!-- viz-audit ... time=5 ... -->
//   <!-- lattice-field slot=0 rows=6 cols=6 time-ms=5000 phase0-milli=1750 ... -->
//   <!-- particle-event slot=0 n=18 time-ms=5000 energy0-milli=1150 ... -->
//   VIZ_WORKBENCH_HTML_PHYSCHEM_PASS

use display::event::{Event, EV_MOUSE_PRESS, EV_MOTION, MOUSE_LEFT}
use viz::audit::{viz_audit_hash}
use viz::ir::{viz_scene_new, VIZ_NODE_LATTICE_FIELD, VIZ_NODE_PARTICLE_EVENT}
use viz::viz_app::{viz_app_new}
use viz::viz_html::{viz_html_emit_scene}
use viz::workbench::{
    viz_workbench_build_scene, viz_workbench_constraint,
    viz_workbench_app_handle_event,
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn main() with IO, Alloc, Mut, Div {
    var scene = viz_scene_new()
    let ids = viz_workbench_build_scene(&!scene)
    var constraint = viz_workbench_constraint(&ids)
    var app = viz_app_new(10, 13, 18)
    let initial_audit = viz_audit_hash(&scene)

    assert(scene.nodes[ids.lattice as usize].kind == VIZ_NODE_LATTICE_FIELD)
    assert(scene.nodes[ids.particle_event as usize].kind == VIZ_NODE_PARTICLE_EVENT)
    assert(scene.nodes[ids.lattice as usize].tag == 8405)
    assert(scene.nodes[ids.particle_event as usize].tag == 8406)

    assert(viz_workbench_app_handle_event(&!app, &!scene, &!constraint, ev(EV_MOUSE_PRESS, MOUSE_LEFT, 46, 238)))
    assert(viz_workbench_app_handle_event(&!app, &!scene, &!constraint, ev(EV_MOTION, 0, 101, 238)))

    assert(scene.time == 5.0)
    assert(scene.lattice_data[0].rows == 6)
    assert(scene.lattice_data[0].cols == 6)
    assert((scene.lattice_data[0].phase[0] * 1000.0) as i64 == 1750)
    assert((scene.lattice_data[0].displacement_x[0] * 1000.0) as i64 == 0 - 30)
    assert((scene.lattice_data[0].displacement_y[0] * 1000.0) as i64 == 0 - 80)
    assert((scene.lattice_data[0].variance[0] * 1000000.0) as i64 == 1100)
    assert(scene.particle_event_data[0].n == 18)
    assert((scene.particle_event_data[0].px[0] * 1000.0) as i64 == 125)
    assert((scene.particle_event_data[0].py[0] * 1000.0) as i64 == 75)
    assert((scene.particle_event_data[0].pz[0] * 1000.0) as i64 == 50)
    assert((scene.particle_event_data[0].energy[0] * 1000.0) as i64 == 1150)
    assert((scene.particle_event_data[0].variance[0] * 1000000.0) as i64 == 12500)
    assert(viz_audit_hash(&scene) != initial_audit)

    viz_html_emit_scene(&scene, 480, 320)
    println("VIZ_WORKBENCH_HTML_PHYSCHEM_PASS")
}
