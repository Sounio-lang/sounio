//@ run-pass
//@ description: #2388 — the issue's own spellings: `mL`, `L`, `mg/mL` and `mol/L` are units on both engines (Madaros refused `mL` with E001 "expected mL, found f64")
//@ expect-stdout: 250.000000
//@ expect-stdout: 2.000000
//@ expect-stdout: 0.500000
//@ expect-stdout: 4.000000

fn main() -> i32 with IO, Mut, Panic, Div {
    let volume: mL = 250.0
    print_f64(volume); print("\n")
    let dose: mg = 500.0
    let c: mg/mL = dose / volume
    print_f64(c); print("\n")
    let litres: L = 0.5
    print_f64(litres); print("\n")
    let n: mol = 2.0
    let molar: mol/L = n / litres
    print_f64(molar); print("\n")
    return 0
}
