//@ run-pass
// extern "C" malloc/free dispatch to the mmap-backed heap builtins
// (Track A Fase 3.4: ffi_malloc=id 36 -> heap_alloc, ffi_free=id 37 ->
// heap_free). A fabricated-0 malloc would fail the null check; a no-op
// pair would at least prove the calls dispatch and return real pointers.

extern "C" {
    fn malloc(n: i64) -> i64;
    fn free(p: i64);
}

fn main() -> i32 with IO, Panic {
    let p = malloc(64)
    if p == 0 {
        println("ffi_malloc_free_roundtrip: FAIL null")
        return 1
    }
    let q = malloc(128)
    if q == 0 || q == p {
        println("ffi_malloc_free_roundtrip: FAIL second alloc")
        return 1
    }
    free(p)
    free(q)
    println("ffi_malloc_free_roundtrip: PASS")
    return 0
}
