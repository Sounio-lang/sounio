//@ run-pass
//@ requires: madaros
//@ expect-stdout: kl14b_dynlink_one_symbol: PASS
// KL-14b: one non-builtin extern resolved via Madaros dynamic linking
// (PT_INTERP + PT_DYNAMIC + DT_NEEDED + GOT). Not an ffi_* intrinsic.
// Needs libkl14b_probe.so on LD_LIBRARY_PATH (Witness gate and
// madaros_changed_tests_gate.sh stage tests/fixtures/kl14b/kl14b_probe.c).
// Gate: scripts/ci/madaros_kl14b_dynlink_gate.sh

extern "C" {
    fn kl14b_add(a: i64, b: i64) -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let v = kl14b_add(40, 2)
    if v == 42 {
        println("kl14b_dynlink_one_symbol: PASS")
        return 0
    }
    println("kl14b_dynlink_one_symbol: FAIL")
    return 1
}
