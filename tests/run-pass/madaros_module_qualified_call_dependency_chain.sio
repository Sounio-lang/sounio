//@ run-pass
//@ requires: madaros
//@ expect-stdout: DEPENDENCY_CHAIN PASS
//
// PR #2515 review round 2, finding D (comment_id 4089110737): an earlier
// fix reset LOWER_USE_MODULE_HASH/LOWER_IMPL_METHOD_HASH inside
// lowerer_lower_program_bodies_mut (self-hosted/ir/lower.sio) right before
// lowering the seed module's own body -- discarding the registry the
// multi-module preregister pass (module_frontend.sio) had already built
// across the WHOLE loaded module graph, and rebuilding it from only the
// seed's own `use` items. A qualified call living inside a DEPENDENCY
// module (lowered later via lower_dep_program_items_into_acc_with_externs,
// which never recollects `use` paths on its own) whose module prefix the
// seed itself never `use`s directly then lost its registry entry and fell
// back to a mangled body-less stub (SIGILL).
//
// This file (the seed) `use`s ONLY testmod::dep_chain_mid. dep_chain_mid
// (stdlib/testmod/dep_chain_mid.sio) itself `use`s testmod::dep_chain_leaf
// and calls it through the module-qualified path
// `dep_chain_leaf::leaf_add(..)` -- the seed never imports dep_chain_leaf at
// all, so this call only resolves correctly if the registry entry for
// `dep_chain_leaf`, contributed solely by dep_chain_mid's own `use` line,
// survives all the way through to when dep_chain_mid's body is actually
// lowered as a dependency.
use testmod::dep_chain_mid;

fn main() -> i32 with IO, Mut, Panic {
    let r = dep_chain_mid::mid_call(5)
    if r == 10006 {
        println("DEPENDENCY_CHAIN PASS")
        return 0
    }
    println("DEPENDENCY_CHAIN FAIL")
    1
}
