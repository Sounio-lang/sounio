//@ run-pass

// ---------------------------------------------------------------------------
// Bessel Functions test suite -- all helpers inlined, no imports
//
// Functions tested (power-series implementations):
//   bessel_j0  -- Bessel function of the first kind, order 0
//   bessel_j1  -- Bessel function of the first kind, order 1
//   bessel_i0  -- Modified Bessel function of the first kind, order 0
//   bessel_i1  -- Modified Bessel function of the first kind, order 1
//
// Power series converge well for |x| < 10 with 30 terms.
//
// References:
//   Abramowitz & Stegun (1964), Ch. 9
//   DLMF (https://dlmf.nist.gov) chapters 10.2, 10.25
//   Watson, G.N. "A Treatise on the Theory of Bessel Functions" (1944)
// ---------------------------------------------------------------------------

// ============================================================================
// HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// ============================================================================
// BESSEL FUNCTIONS (power series, 30 terms)
// ============================================================================

// J_0(x) = sum_{k=0}^{N} (-1)^k (x/2)^{2k} / (k!)^2
fn bessel_j0(x: f64) -> f64 with Mut, Panic, Div {
    let z = x / 2.0
    let z2 = z * z
    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 30 {
        let kf = k as f64
        term = 0.0 - term * z2 / (kf * kf)
        sum = sum + term
        k = k + 1
    }
    return sum
}

// J_1(x) = sum_{k=0}^{N} (-1)^k (x/2)^{2k+1} / (k! (k+1)!)
//        = (x/2) * sum_{k=0}^{N} (-1)^k (x/2)^{2k} / (k! (k+1)!)
fn bessel_j1(x: f64) -> f64 with Mut, Panic, Div {
    let z = x / 2.0
    let z2 = z * z
    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 30 {
        let kf = k as f64
        // term_k = term_{k-1} * (-z^2) / (k * (k+1))
        term = 0.0 - term * z2 / (kf * (kf + 1.0))
        sum = sum + term
        k = k + 1
    }
    return z * sum
}

// I_0(x) = sum_{k=0}^{N} (x/2)^{2k} / (k!)^2
fn bessel_i0(x: f64) -> f64 with Mut, Panic, Div {
    // I_0 is even, so use |x|
    let ax = abs_f64(x)
    let z = ax / 2.0
    let z2 = z * z
    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 30 {
        let kf = k as f64
        term = term * z2 / (kf * kf)
        sum = sum + term
        k = k + 1
    }
    return sum
}

// I_1(x) = sum_{k=0}^{N} (x/2)^{2k+1} / (k! (k+1)!)
//        = (x/2) * sum_{k=0}^{N} (x/2)^{2k} / (k! (k+1)!)
fn bessel_i1(x: f64) -> f64 with Mut, Panic, Div {
    let z = x / 2.0
    let z2 = z * z
    var sum = 1.0
    var term = 1.0
    var k = 1
    while k <= 30 {
        let kf = k as f64
        term = term * z2 / (kf * (kf + 1.0))
        sum = sum + term
        k = k + 1
    }
    return z * sum
}

// J_n(x) for general integer order via forward recurrence from J_0, J_1
// Recurrence: J_{n+1}(x) = (2n/x) J_n(x) - J_{n-1}(x)
// NOTE: forward recurrence is unstable for large n, but fine for small n used here
fn bessel_jn(n: i32, x: f64) -> f64 with Mut, Panic, Div {
    if n == 0 { return bessel_j0(x) }
    if n == 1 { return bessel_j1(x) }
    var j_prev = bessel_j0(x)
    var j_curr = bessel_j1(x)
    var k = 1
    while k < n {
        let kf = k as f64
        let j_next = (2.0 * kf / x) * j_curr - j_prev
        j_prev = j_curr
        j_curr = j_next
        k = k + 1
    }
    return j_curr
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

// Test 1: J_0(0) = 1.0
fn test_j0_zero() -> bool with IO, Mut, Panic, Div {
    let got = bessel_j0(0.0)
    let expected = 1.0
    let tol = 1.0e-8
    print("  J_0(0)=")
    println(got)
    return abs_f64(got - expected) < tol
}

// Test 2: J_0(1.0) ~ 0.7651976865579666
