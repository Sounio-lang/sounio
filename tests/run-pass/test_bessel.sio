    // Test 18
    print("Test 18: J_0(-x) = J_0(x) ......... ")
    if test_j0_even() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    if failed == 0 {
        println("ALL 18 TESTS PASSED")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
