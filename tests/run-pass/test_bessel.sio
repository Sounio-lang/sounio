// Test 15: Neumann addition theorem (approximate)
// J_0(x)^2 + 2 * sum_{k=1}^{n} J_k(x)^2 ~ 1
// Use x = 1.0 and n = 5
fn test_neumann_addition() -> bool with IO, Mut, Panic, Div {
    let x = 1.0
    let j0 = bessel_j0(x)
    var sum = j0 * j0
    var k = 1
    while k <= 5 {
        let jk = bessel_jn(k, x)
        sum = sum + 2.0 * jk * jk
        k = k + 1
    }
    let tol = 1.0e-3
    print("  J_0^2 + 2*sum(J_k^2)=")
    println(sum)
    return abs_f64(sum - 1.0) < tol
}

// Test 16: J_0'(x) = -J_1(x), checked numerically at x = 1.0
// Use central finite difference: J_0'(x) ~ (J_0(x+h) - J_0(x-h)) / (2h)
fn test_j0_derivative() -> bool with IO, Mut, Panic, Div {
    let x = 1.0
    let h = 1.0e-6
    let deriv_num = (bessel_j0(x + h) - bessel_j0(x - h)) / (2.0 * h)
    let deriv_exact = 0.0 - bessel_j1(x)
    let tol = 1.0e-5
    print("  J_0'(1) numerical=")
    println(deriv_num)
    print("  -J_1(1)=")
    println(deriv_exact)
    return abs_f64(deriv_num - deriv_exact) < tol
}

// Test 17: I_0(-x) = I_0(x) (even function)
fn test_i0_even() -> bool with IO, Mut, Panic, Div {
    let x = 2.5
    let i0_pos = bessel_i0(x)
    let i0_neg = bessel_i0(0.0 - x)
    let tol = 1.0e-8
    print("  I_0(2.5)=")
    println(i0_pos)
    print("  I_0(-2.5)=")
    println(i0_neg)
    return abs_f64(i0_pos - i0_neg) < tol
}

// Test 18: J_0(-x) = J_0(x) (even function)
fn test_j0_even() -> bool with IO, Mut, Panic, Div {
    let x = 3.0
    let j0_pos = bessel_j0(x)
    let j0_neg = bessel_j0(0.0 - x)
    let tol = 1.0e-8
    print("  J_0(3)=")
    println(j0_pos)
    print("  J_0(-3)=")
    println(j0_neg)
    return abs_f64(j0_pos - j0_neg) < tol
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Bessel Functions Tests ===")
    println("")

    var passed = 0
    var failed = 0

    // Test 1
    print("Test  1: J_0(0) = 1 ................ ")
    if test_j0_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 2
    print("Test  2: J_0(1) ~ 0.76520 ......... ")
    if test_j0_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

