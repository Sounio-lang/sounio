    if test_j1_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 6
    print("Test  6: J_1(1) ~ 0.44005 ......... ")
    if test_j1_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 7
    print("Test  7: J_1(2) ~ 0.57672 ......... ")
    if test_j1_two() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 8
    print("Test  8: J_1(3.8317) ~ 0 .......... ")
    if test_j1_first_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 9
    print("Test  9: I_0(0) = 1 ................ ")
    if test_i0_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 10
    print("Test 10: I_0(1) ~ 1.26607 ......... ")
    if test_i0_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 11
    print("Test 11: I_0(2) ~ 2.27959 ......... ")
    if test_i0_two() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 12
    print("Test 12: I_1(0) = 0 ................ ")
    if test_i1_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 13
    print("Test 13: I_1(1) ~ 0.56516 ......... ")
    if test_i1_one() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 14
    print("Test 14: I_1(2) ~ 1.59064 ......... ")
    if test_i1_two() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 15
    print("Test 15: Neumann addition theorem .. ")
    if test_neumann_addition() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 16
    print("Test 16: J_0'(x) = -J_1(x) ........ ")
    if test_j0_derivative() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 17
    print("Test 17: I_0(-x) = I_0(x) ......... ")
