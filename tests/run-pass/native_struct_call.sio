//@ run-pass
// Sprint 224: Multi-struct function calls + struct return + mutation
// Validates patterns needed by rapamycin PBPK: multi-struct args, field mutation, loops

struct State {
    x: f64,
    v: f64,
}

struct Params {
    k: f64,
    damping: f64,
    dt: f64,
}

// Euler step for damped spring: dx/dt = v, dv/dt = -k*x - damping*v
fn neg(x: f64) -> f64 {
    return 0.0 - x
}

fn euler_step(s: State, p: Params) -> State {
    let ax = neg(p.k) * s.x - p.damping * s.v
    let new_x = s.x + s.v * p.dt
    let new_v = s.v + ax * p.dt
    return State { x: new_x, v: new_v }
}

fn f64_to_int_x1000(v: f64) -> i64 {
    return (v * 1000.0) as i64
}

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i64 {
    let prm = Params { k: 1.0, damping: 0.1, dt: 0.01 }

    // T1: basic struct creation + function call
    var s = State { x: 1.0, v: 0.0 }
    s = euler_step(s, prm)
    let t1_x = f64_to_int_x1000(s.x)
    print("T1_x=")
    print_int(t1_x)
    print("\n")

    // T2: 100-step simulation loop
    var s2 = State { x: 1.0, v: 0.0 }
    var i = 0
    while i < 100 {
        s2 = euler_step(s2, prm)
        i = i + 1
    }
    let t2_x = f64_to_int_x1000(s2.x)
    print("T2_x=")
    print_int(t2_x)
    print("\n")

    // T3: 1000-step simulation — should oscillate and damp
    var s3 = State { x: 1.0, v: 0.0 }
    var j = 0
    while j < 1000 {
        s3 = euler_step(s3, prm)
        j = j + 1
    }
    let t3_x = f64_to_int_x1000(s3.x)
    print("T3_x=")
    print_int(t3_x)
    print("\n")

    // T4: energy check — damped system should lose energy
    let e_init = 1.0 * 1.0 + 0.0 * 0.0
    let e_final = s3.x * s3.x + s3.v * s3.v
    let energy_ratio = f64_to_int_x1000(e_final / e_init)
    print("T4_eratio=")
    print_int(energy_ratio)
    print("\n")

    // T5: field mutation in loop
    var s5 = State { x: 0.0, v: 0.0 }
    var k = 0
    while k < 10 {
        s5.x = s5.x + 1.0
        s5.v = s5.v + 0.5
        k = k + 1
    }
    let t5_x = f64_to_int_x1000(s5.x)
    let t5_v = f64_to_int_x1000(s5.v)
    print("T5_x=")
    print_int(t5_x)
    print(" v=")
    print_int(t5_v)
    print("\n")

    0
}
