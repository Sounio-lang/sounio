//@ run-pass
//@ expect-stdout: LET_MATCH_STRUCT_TYPED_OK
// `let pair = match .. { .. => f(..) }` is typed by the arms' struct, as
// `let pair = f(..)` is. Untyped, `pair.params` went to the field vote, which
// the D structs below win with `params` at index 1: it read `count`. check.sio
// built every method FnSig that way, with the parameter count as the params
// list (gen3 ud2 in fn_param_list_clone, #2966).
struct R { params: i64, count: i64 }
struct D1 { kind: i64, params: i64 }
struct D2 { kind: i64, params: i64 }
struct D3 { kind: i64, params: i64 }

fn mk(p: i64, c: i64) -> R { R { params: p, count: c } }
fn d1(x: i64) -> D1 { D1 { kind: x, params: x } }
fn d2(x: i64) -> D2 { D2 { kind: x, params: x } }
fn d3(x: i64) -> D3 { D3 { kind: x, params: x } }

fn pick(o: Option<i64>, flag: bool) -> i64 with Mut, Panic, Div, Alloc {
    let pair = match o {
        Some(v) => {
            if flag { mk(v * 100, 7) } else { mk(v * 10, 8) }
        }
        None => mk(0, 9)
    }
    let via_if = if flag { mk(5, 6) } else { mk(4, 3) }
    pair.params * 10 + pair.count + via_if.params * 1000 + via_if.count * 10000
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let noise = d1(1).params + d2(2).params + d3(3).params
    let got = pick(Some(3), true)
    if got == 3007 + 5000 + 60000 && noise == 6 {
        println("LET_MATCH_STRUCT_TYPED_OK")
    } else {
        println(got)
    }
    return 0
}
