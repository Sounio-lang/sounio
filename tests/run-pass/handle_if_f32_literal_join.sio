//@ check-only
//@ requires: madaros
//@ description: #830 — ExprHandle forces the by-value if join to adopt the sibling f32 type
// Checker-only: this verifies the handler body's type, not effect execution.

fn handle_else_literal(x: f32, flag: bool) -> f32 {
    handle<IO> {
        if flag { x } else { 0.0 }
    } with {
        0
    }
}

fn handle_then_literal(x: f32, flag: bool) -> f32 {
    handle<IO> {
        if flag { -1.5 } else { x }
    } with {
        0
    }
}

fn main() -> i64 {
    let x: f32 = 2.5
    let a: f32 = handle_else_literal(x, true)
    let b: f32 = handle_then_literal(x, false)
    0
}
