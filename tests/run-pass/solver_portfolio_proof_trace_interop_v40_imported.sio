//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v40 smoke for proof-trace interop receipt

use theorem::portfolio::*

fn main() -> i64 {
    let interop_fp = solver_portfolio_v40_proof_trace_interop_fingerprint(
        53646245, 423305090, 620031252,
        258927862, 438043475, 46718256,
        786321129, 389121447, 528140838,
        409028717, 6, 8, 63)
    if interop_fp != 90120367 { return 1 }

    let audit_fp = solver_portfolio_v40_proof_trace_interop_audit_fingerprint(
        interop_fp, 812428526, 845057161, 6, 8, 63)
    if audit_fp != 336688074 { return 2 }

    let manifest_fp = solver_portfolio_v40_proof_trace_interop_bundle_fingerprint(
        interop_fp, audit_fp)
    if manifest_fp != 788938861 { return 3 }

    let result_fp = solver_portfolio_v40_result_coverage_fingerprint(
        40, 44, 10, 32, 1, 1, manifest_fp)
    if result_fp != 149225904 { return 4 }

    let family_fp = solver_portfolio_v40_checker_family_coverage_fingerprint(
        40, 44, 6, 3, 2, 2, 29, 2, manifest_fp)
    if family_fp != 166966176 { return 5 }

    let acceptance_fp = solver_portfolio_v40_acceptance_receipt_fingerprint(
        40, manifest_fp, result_fp)
    if acceptance_fp != 662126478 { return 6 }

    let audit_receipt_fp = solver_portfolio_v40_audit_receipt_fingerprint(
        40, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 255705570 { return 7 }

    let readiness_fp = solver_portfolio_v40_readiness_fingerprint(
        40, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 983550353 { return 8 }

    return 0
}
