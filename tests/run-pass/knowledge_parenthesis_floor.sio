//@ run-pass
//@ requires: madaros
//@ expect-stdout: band 11.243518 13.789148
//@ expect-stdout: zero 1
//@ expect-stdout: PARENTHESIS_FLOOR_OK
// Four pressures sit on ln(P/100) = -1000/T, each with u(ln P) = 0.2.
// The residual variance is zero. The published band is the propagation
// of those parentheses, not the point 12.451447. A zero uncertainty
// is not a weight.

use epistemic::regression::plateau_pressure

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 400.0
    xs[1] = 1.0 / 450.0
    xs[2] = 1.0 / 500.0
    xs[3] = 1.0 / 550.0
    ys[0] = 0.0 - 1000.0 / 400.0
    ys[1] = 0.0 - 1000.0 / 450.0
    ys[2] = 0.0 - 1000.0 / 500.0
    ys[3] = 0.0 - 1000.0 / 550.0
    uln[0] = 0.2
    uln[1] = 0.2
    uln[2] = 0.2
    uln[3] = 0.2
    let held = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    uln[1] = 0.0
    let bad = plateau_pressure(xs, ys, uln, 4, 1.0 / 480.0, 100.0)
    let point = 12.451447
    let wide = (held.hi - held.lo) > 2.0
    let inside = held.lo < point && point < held.hi
    let pinned = near(held.lo, 11.243518, 0.000001) && near(held.hi, 13.789148, 0.000001) && near(held.chi, 0.0, 0.000001)
    let bad_nan = !(bad.lo == bad.lo) && !(bad.hi == bad.hi) && !(bad.chi == bad.chi) && !bad.open && !bad.refused
    print("band ")
    print_f64(held.lo)
    print(" ")
    print_f64(held.hi)
    println("")
    print("zero ")
    print_int(bit(bad_nan))
    println("")
    if held.open && !held.refused && wide && inside && pinned && bad_nan {
        println("PARENTHESIS_FLOOR_OK")
        return 0
    }
    println("PARENTHESIS_FLOOR_FAIL")
    1
}
