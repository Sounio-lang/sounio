//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_LITERAL_ANNOTATED PASS
//
// `let t: ([f64; 2], i64) = (a, 0)` -- an explicitly typed tuple LITERAL
// local. expr_result_tuple_arr_mask_ref only reads a mask off a CALL
// initialiser's declared return type (lower_fn_tuple_f64_array_mask), and a
// tuple literal has no such tracking, so this local's array-slot mask was
// left at 0 despite the annotation spelling out `[f64; 2]` in slot 0.
// `let x = t.0; x[0] * 2.0` then took the integer path and corrupted the
// f64 bits. Fix: lower_opt_type_tuple_arr_mask reads the array mask
// straight off the annotated TYPE, mirroring how the scalar tuple_float_mask
// already preferred the annotation over the initialiser.
fn mk_arr() -> [f64; 2] with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    a[0] = 2.5
    a[1] = 4.5
    a
}

fn main() -> i32 with IO, Mut, Panic {
    let t: ([f64; 2], i64) = (mk_arr(), 0)
    let x = t.0
    let s0: f64 = x[0] * 2.0
    let s1: f64 = 2.0 * x[1]
    var acc: f64 = 0.0
    var j: i64 = 0
    while j < 2 {
        acc = acc + 0.5 * x[j]
        j = j + 1
    }
    if s0 == 5.0 && s1 == 9.0 && acc == 3.5 {
        println("TUPLE_F64_ARRAY_LITERAL_ANNOTATED PASS")
        return 0
    }
    1
}
