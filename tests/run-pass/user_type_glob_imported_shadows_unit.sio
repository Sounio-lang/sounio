//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: GLOB_SHADOW_OK 1 2
//
// Review of #3743, unit-shadowing scope, positive control for the glob case: a
// glob import of the module that declares the public enum K makes K visible
// here, so `K` is the enum, not kelvin. Its negative twin is
// unit_kelvin_beside_pub_enum_k_unrelated_glob.sio (a glob of another module).
use fixtures::kenum_pub_leaf::*

fn main() -> i64 with IO, Mut {
    var k: K = K::A
    k = K::B
    let c: K = K::C
    print("GLOB_SHADOW_OK "); print_int(k_code(k)); print(" "); print_int(k_code(c)); print("\n")
    0
}
