//@ run-pass
//@ requires: madaros
//@ expect-stdout: refinement return: PASS
//
// Positive control for refinement_holds_at_return.sio. A value that DOES
// satisfy the predicate must still be returnable, or the new check has banned
// returning a refined type at all instead of banning the false one.

type Fp = { n: i64 | n >= 0 && n < 1000000007 }

fn inside() -> Fp {
    return 5
}

fn main() -> i64 with IO {
    let a: Fp = inside()
    println("refinement return: PASS")
    0
}
