//@ run-pass
//@ requires: madaros
//@ expect-stdout: refinement return: PASS
//
// Positive control for refinement_holds_at_return.sio and
// refinement_holds_at_implicit_tail.sio. A value that DOES satisfy the
// predicate must still be returnable -- by both spellings -- or the new check
// has banned returning a refined type at all instead of banning the false one.
//
// `inside` uses the explicit return, `inside_tail` the implicit tail, so this
// file is the positive control for both call sites.

fn inside() -> { n: i64 | n >= 0 && n < 1000000007 } {
    return 5
}

fn inside_tail() -> { n: i64 | n >= 0 && n < 1000000007 } {
    7
}

fn main() -> i64 with IO {
    let a = inside()
    let b = inside_tail()
    println("refinement return: PASS")
    0
}
