//@ run-pass
//@ expect-stdout-contains: All match pattern tests passed
// Comprehensive match expression pattern test (Phase 1.3 completion).
//
// Tests all supported match patterns:
// 1. Integer literal patterns
// 2. Enum variant patterns (without payload)
// 3. Option patterns: Some(v), None
// 4. Result patterns: Ok(v), Err(e)
// 5. Wildcard pattern (_)
// 6. Variable binding pattern (v => ...)
// 7. Guard pattern (v if condition => ...)
// 8. Mixed patterns: literal + wildcard, enum + guard
// 9. Match as expression (yields value)

enum Color {
    Red,
    Green,
    Blue,
}

enum Shape {
    Circle,
    Square,
    Triangle,
}

fn abs_i32(x: i32) -> i32 {
    if x < 0 { -x } else { x }
}

fn assert_eq_i32(a: i32, b: i32, msg: str) with IO, Panic {
    if a != b {
        println("FAIL: " ++ msg)
        panic("assertion failed: values not equal")
    }
}

fn assert_eq_bool(a: bool, b: bool, msg: str) with IO, Panic {
    if a != b {
        println("FAIL: " ++ msg)
        panic("assertion failed: booleans not equal")
    }
}

fn assert_true(cond: bool, msg: str) with IO, Panic {
    if !cond {
        println("FAIL: " ++ msg)
        panic("assertion failed")
    }
}

fn main() with IO, Panic, Mut {
    println("=== Match Pattern Tests ===")

    // ---- Test 1: Integer literal patterns ----
    println("T01: Integer literal patterns")
    var x: i32 = 42
    var result: i32 = 0
    match x {
        0 => { result = 100 }
        1 => { result = 200 }
        42 => { result = 300 }
        _ => { result = 999 }
    }
    assert_eq_i32(result, 300, "literal 42 should match arm 3")

    x = 0
    result = 0
    match x {
        0 => { result = 100 }
        1 => { result = 200 }
        _ => { result = 999 }
    }
    assert_eq_i32(result, 100, "literal 0 should match arm 1")

    x = 99
    result = 0
    match x {
        0 => { result = 100 }
        1 => { result = 200 }
        _ => { result = 999 }
    }
    assert_eq_i32(result, 999, "unmatched literal should hit wildcard")
    println("  PASS")

    // ---- Test 2: Enum variant patterns ----
    println("T02: Enum variant patterns")
    let c = Color::Green
    var color_id: i32 = 0
    match c {
        Color::Red => { color_id = 1 }
        Color::Green => { color_id = 2 }
        Color::Blue => { color_id = 3 }
    }
    assert_eq_i32(color_id, 2, "Color::Green should give id=2")

    let s = Shape::Triangle
    var shape_sides: i32 = 0
    match s {
        Shape::Circle => { shape_sides = 0 }
        Shape::Square => { shape_sides = 4 }
        Shape::Triangle => { shape_sides = 3 }
    }
    assert_eq_i32(shape_sides, 3, "Shape::Triangle should give sides=3")
    println("  PASS")

    // ---- Test 3: Option patterns (Some/None) ----
    println("T03: Option patterns")
    let opt_some: ?i32 = Some(42)
    var opt_result: i32 = 0
    match opt_some {
        Some(v) => { opt_result = v }
        None => { opt_result = -1 }
    }
    assert_eq_i32(opt_result, 42, "Some(42) should bind v=42")

    let opt_none: ?i32 = None
    opt_result = 0
    match opt_none {
        Some(v) => { opt_result = v }
        None => { opt_result = -1 }
    }
    assert_eq_i32(opt_result, -1, "None should give -1")
    println("  PASS")

    // ---- Test 4: Result patterns (Ok/Err) ----
    println("T04: Result patterns")
    let res_ok: Result<i32, i32> = Ok(100)
    var res_result: i32 = 0
    match res_ok {
        Ok(v) => { res_result = v }
        Err(e) => { res_result = 0 - e }
    }
    assert_eq_i32(res_result, 100, "Ok(100) should bind v=100")

    let res_err: Result<i32, i32> = Err(5)
    res_result = 0
    match res_err {
        Ok(v) => { res_result = v }
        Err(e) => { res_result = 0 - e }
    }
    assert_eq_i32(res_result, -5, "Err(5) should give -5")
    println("  PASS")

    // ---- Test 5: Wildcard pattern ----
    println("T05: Wildcard pattern")
    var w: i32 = 777
    var wresult: i32 = 0
    match w {
        0 => { wresult = 1 }
        _ => { wresult = 2 }
    }
    assert_eq_i32(wresult, 2, "unmatched value should hit wildcard")

    w = 0
    wresult = 0
    match w {
        0 => { wresult = 1 }
        _ => { wresult = 2 }
    }
    assert_eq_i32(wresult, 1, "value 0 should match before wildcard")
    println("  PASS")

    // ---- Test 6: Variable binding pattern ----
    println("T06: Variable binding pattern")
    var vb_x: i32 = 55
    var vb_result: i32 = 0
    match vb_x {
        0 => { vb_result = 0 }
        n => { vb_result = n * 2 }
    }
    assert_eq_i32(vb_result, 110, "variable binding n should capture 55, n*2=110")

    // Variable binding with negative value
    var vb_neg: i32 = -3
    var vb_neg_result: i32 = 0
    match vb_neg {
        0 => { vb_neg_result = 0 }
        n => { vb_neg_result = abs_i32(n) }
    }
    assert_eq_i32(vb_neg_result, 3, "variable binding should capture -3, abs=-3=3")
    println("  PASS")

    // ---- Test 7: Guard pattern ----
    println("T07: Guard pattern (v if condition)")
    var g_x: i32 = 10
    var g_result: i32 = 0
    match g_x {
        n if n > 5 => { g_result = 1 }
        n => { g_result = 2 }
    }
    assert_eq_i32(g_result, 1, "guard n > 5 should match when x=10")

    g_x = 3
    g_result = 0
    match g_x {
        n if n > 5 => { g_result = 1 }
        n => { g_result = 2 }
    }
    assert_eq_i32(g_result, 2, "guard n > 5 should fail when x=3, fallthrough to binding arm")

    // Guard with equality check
    g_x = 7
    g_result = 0
    match g_x {
        n if n == 7 => { g_result = 77 }
        n => { g_result = n }
    }
    assert_eq_i32(g_result, 77, "guard n == 7 should match when x=7")
    println("  PASS")

    // ---- Test 8: Multiple guards on same scrutinee ----
    println("T08: Multiple guards (range-like dispatch)")
    var mg_x: i32 = 15
    var mg_result: i32 = 0
    match mg_x {
        n if n < 0 => { mg_result = -1 }
        n if n < 10 => { mg_result = 0 }
        n if n < 20 => { mg_result = 1 }
        n => { mg_result = 2 }
    }
    assert_eq_i32(mg_result, 1, "15 should fall in [10,20) range → result=1")

    mg_x = 5
    mg_result = 0
    match mg_x {
        n if n < 0 => { mg_result = -1 }
        n if n < 10 => { mg_result = 0 }
        n if n < 20 => { mg_result = 1 }
        n => { mg_result = 2 }
    }
    assert_eq_i32(mg_result, 0, "5 should fall in [0,10) range → result=0")

    mg_x = 99
    mg_result = 0
    match mg_x {
        n if n < 0 => { mg_result = -1 }
        n if n < 10 => { mg_result = 0 }
        n if n < 20 => { mg_result = 1 }
        n => { mg_result = 2 }
    }
    assert_eq_i32(mg_result, 2, "99 should fall through to catch-all → result=2")
    println("  PASS")

    // ---- Test 9: Match as expression ----
    println("T09: Match as expression")
    let expr_x: i32 = 3
    let expr_result: i32 = match expr_x {
        1 => 10
        2 => 20
        3 => 30
        _ => 0
    }
    assert_eq_i32(expr_result, 30, "match expression should yield 30 for x=3")
    println("  PASS")

    // ---- Test 10: Match with literal + guard combination ----
    println("T10: Literal patterns before guard patterns")
    var combo_x: i32 = 0
    var combo_result: i32 = 0
    match combo_x {
        0 => { combo_result = 100 }
        n if n > 0 => { combo_result = 200 }
        n => { combo_result = 300 }
    }
    assert_eq_i32(combo_result, 100, "literal 0 should take priority over guard")

    combo_x = 5
    combo_result = 0
    match combo_x {
        0 => { combo_result = 100 }
        n if n > 0 => { combo_result = 200 }
        n => { combo_result = 300 }
    }
    assert_eq_i32(combo_result, 200, "guard n>0 should match for x=5")

    combo_x = -3
    combo_result = 0
    match combo_x {
        0 => { combo_result = 100 }
        n if n > 0 => { combo_result = 200 }
        n => { combo_result = 300 }
    }
    assert_eq_i32(combo_result, 300, "fallthrough to binding arm for x=-3")
    println("  PASS")

    println("")
    println("=== All match pattern tests passed ===")
}
