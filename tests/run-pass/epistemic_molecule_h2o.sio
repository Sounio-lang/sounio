//@ run-pass
//@ expect-stdout: ALL 10 TESTS PASSED

// Epistemic Molecule H2O Test Suite
// Rewritten with global flat arrays (no local struct vars) to work with
// lean_single limitations (var = struct_fn() crashes compiler).

// ============================================================================
// GLOBAL MOLECULE STATE
// ============================================================================

var G_ATOM_Z:    [i64; 256] = [0; 256]  // atomic numbers
var G_ATOM_MASS: [i64; 256] = [0; 256]  // mass Q16.16
var G_ATOM_PROV: [i64; 256] = [0; 256]  // provenance
var G_ATOM_CNT:  i64 = 0

var G_BOND_SRC:  [i64; 512] = [0; 512]
var G_BOND_DST:  [i64; 512] = [0; 512]
var G_BOND_TYPE: [i64; 512] = [0; 512]
var G_BOND_PROV: [i64; 512] = [0; 512]
var G_BOND_VAR:  [i64; 512] = [0; 512]
var G_BOND_CONF: [i64; 512] = [0; 512]
var G_BOND_CNT:  i64 = 0
var G_MOL_PROV:  i64 = 0
var G_ATOM_ID:   i64 = 0  // last added atom id

// ============================================================================
// MERKLE / HASH (decimal salts to avoid hex literal issues)
// 0x4F4D4547 = 1330531655, 0x4147454E = 1095715150
// 0x45534953 = 1163347283, 0x76312E30 = 1983271984
// ============================================================================

fn m_mix(a: i64, b: i64, c: i64, salt: i64) -> i64 {
    ((a ^ b) + c + salt) ^ (a << 5) ^ (b >> 7)
}

fn m_root(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64) -> i64 {
    let h0 = m_mix(p0, p1, p2, 1330531655)
    let h1 = m_mix(p3, p4, h0, 1095715150)
    let h2 = m_mix(h0, h1, p0 ^ p3, 1163347283)
    m_mix(h1, h2, p1 ^ p2, 1983271984)
}

fn m_atom_hash(z: i64, mass: i64) -> i64 with Mut {
    var hash: i64 = 5381
    hash = hash * 33 + z
    hash = hash * 33 + mass
    hash & 9223372036854775807
}

fn m_bond_hash(src: i64, dst: i64, btype: i64) -> i64 with Mut {
    var hash: i64 = 5381
    hash = hash * 33 + src
    hash = hash * 33 + dst
    hash = hash * 33 + btype
    hash & 9223372036854775807
}

fn m_seed(h: i64) -> i64 { m_root(0, h, 0, 0, 1) }

fn m_merge(root: i64, h: i64, v: i64, c: i64) -> i64 {
    m_root(root, h, v, c, root ^ h)
}

fn m_delta32(fidelity: i64, provenance: i64, quantum: i64) -> i64 with Div {
    let frac_f = fidelity - (fidelity / 8) * 8
    let frac_p = provenance - (provenance / 16) * 16
    let frac_q = quantum - (quantum / 32) * 32
    frac_f * 4 + frac_p * 2 + frac_q
}

// ============================================================================
// MOLECULE OPERATIONS ON GLOBALS
// ============================================================================

fn g_mol_reset() with Mut, Panic {
    var i: i64 = 0
    while i < 256 { G_ATOM_Z[i] = 0; G_ATOM_MASS[i] = 0; G_ATOM_PROV[i] = 0; i = i + 1 }
    i = 0
    while i < 512 {
        G_BOND_SRC[i] = 0; G_BOND_DST[i] = 0; G_BOND_TYPE[i] = 0
        G_BOND_PROV[i] = 0; G_BOND_VAR[i] = 0; G_BOND_CONF[i] = 0
        i = i + 1
    }
    G_ATOM_CNT = 0
    G_BOND_CNT = 0
    G_MOL_PROV = 0
    G_ATOM_ID = 0
}

fn g_add_atom(z: i64, mass: i64) with Mut, Panic {
    if G_ATOM_CNT >= 256 { G_ATOM_ID = 0 - 1; return }
    let id = G_ATOM_CNT
    G_ATOM_Z[id] = z
    G_ATOM_MASS[id] = mass
    G_ATOM_PROV[id] = m_seed(m_atom_hash(z, mass))
    G_ATOM_CNT = G_ATOM_CNT + 1
    G_ATOM_ID = id
}

fn g_add_bond(src: i64, dst: i64, btype: i64) with Mut, Panic {
    if src < 0 { return }
    if src >= G_ATOM_CNT { return }
    if dst < 0 { return }
    if dst >= G_ATOM_CNT { return }
    if G_BOND_CNT >= 512 { return }
    let id = G_BOND_CNT
    G_BOND_SRC[id] = src
    G_BOND_DST[id] = dst
    G_BOND_TYPE[id] = btype
    G_BOND_PROV[id] = m_seed(m_bond_hash(src, dst, btype))
    G_BOND_VAR[id] = 0
    G_BOND_CONF[id] = 1
    G_BOND_CNT = G_BOND_CNT + 1
}

fn g_mol_degree(atom_id: i64) -> i64 with Mut, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < G_BOND_CNT {
        if G_BOND_SRC[i] == atom_id { count = count + 1 }
        if G_BOND_DST[i] == atom_id { count = count + 1 }
        i = i + 1
    }
    count
}

fn g_has_bond(src: i64, dst: i64) -> i64 with Mut, Div {
    var i: i64 = 0
    while i < G_BOND_CNT {
        if G_BOND_SRC[i] == src && G_BOND_DST[i] == dst { return 1 }
        i = i + 1
    }
    0
}

fn g_update_mol_prov() with Mut, Div {
    var root: i64 = 0
    var i: i64 = 0
    while i < G_BOND_CNT {
        root = m_mix(root, G_BOND_PROV[i], G_BOND_VAR[i], 1330531655)
        i = i + 1
    }
    G_MOL_PROV = root
}

// ============================================================================
// TESTS
// ============================================================================

fn test_01_empty() -> i64 with Mut, Panic {
    g_mol_reset()
    if G_ATOM_CNT != 0 { return 0 }
    if G_BOND_CNT != 0 { return 0 }
    if G_MOL_PROV != 0 { return 0 }
    1
}

fn test_02_add_atoms() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(1, 66060)
    let id_h1 = G_ATOM_ID
    g_add_atom(8, 1048510)
    let id_o = G_ATOM_ID
    g_add_atom(1, 66060)
    let id_h2 = G_ATOM_ID
    if G_ATOM_CNT != 3 { return 0 }
    if id_h1 != 0 { return 0 }
    if id_o != 1 { return 0 }
    if id_h2 != 2 { return 0 }
    1
}

fn test_03_add_bonds() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(1, 66060)
    g_add_atom(8, 1048510)
    g_add_atom(1, 66060)
    g_add_bond(0, 1, 1)
    g_add_bond(1, 2, 1)
    if G_BOND_CNT != 2 { return 0 }
    if g_has_bond(0, 1) == 0 { return 0 }
    if g_has_bond(1, 2) == 0 { return 0 }
    if g_has_bond(0, 2) != 0 { return 0 }
    1
}

fn test_04_degree_check() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(1, 66060)
    g_add_atom(8, 1048510)
    g_add_atom(1, 66060)
    g_add_bond(0, 1, 1)
    g_add_bond(1, 2, 1)
    let deg_o = g_mol_degree(1)
    let deg_h1 = g_mol_degree(0)
    let deg_h2 = g_mol_degree(2)
    if deg_o != 2 { return 0 }
    if deg_h1 != 1 { return 0 }
    if deg_h2 != 1 { return 0 }
    1
}

fn test_05_bond_prov_seeded() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(8, 1048510)
    g_add_atom(1, 66060)
    g_add_bond(0, 1, 1)
    if G_BOND_PROV[0] == 0 { return 0 }
    if G_BOND_VAR[0] != 0 { return 0 }
    if G_BOND_CONF[0] != 1 { return 0 }
    1
}

fn test_06_mol_prov_nonzero() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(1, 66060)
    g_add_atom(8, 1048510)
    g_add_atom(1, 66060)
    g_add_bond(0, 1, 1)
    g_add_bond(1, 2, 1)
    g_update_mol_prov()
    if G_MOL_PROV == 0 { return 0 }
    1
}

fn test_07_diff_bonds_diff_prov() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(1, 66060)
    g_add_atom(8, 1048510)
    g_add_atom(1, 66060)
    g_add_bond(0, 1, 1)
    g_add_bond(1, 2, 1)
    let p0 = G_BOND_PROV[0]
    let p1 = G_BOND_PROV[1]
    if p0 == 0 { return 0 }
    if p1 == 0 { return 0 }
    if p0 == p1 { return 0 }
    1
}

fn test_08_delta32_bound() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(8, 1048510)
    g_add_atom(1, 66060)
    g_add_bond(0, 1, 1)
    let delta = m_delta32(0, G_BOND_VAR[0], G_BOND_CONF[0])
    if delta < 0 { return 0 }
    if delta >= 96 { return 0 }
    1
}

fn test_09_atom_prov_nonzero() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_atom(1, 66060)
    g_add_atom(8, 1048510)
    let prov_h = G_ATOM_PROV[0]
    let prov_o = G_ATOM_PROV[1]
    if prov_h == 0 { return 0 }
    if prov_o == 0 { return 0 }
    if prov_h == prov_o { return 0 }
    1
}

fn test_10_invalid_bond_noop() -> i64 with Mut, Panic, Div {
    g_mol_reset()
    g_add_bond(0, 1, 1)
    if G_BOND_CNT != 0 { return 0 }
    1
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i64 with IO, Mut, Panic, Div {
    print("=== Epistemic Molecule H2O Tests ===\n")

    var passed: i64 = 0
    var failed: i64 = 0

    print("Test  1: Empty molecule.................. ")
    if test_01_empty() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  2: Add atoms (H, O, H)............ ")
    if test_02_add_atoms() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  3: Add bonds (H-O, O-H)........... ")
    if test_03_add_bonds() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  4: Degree check (O=2, H=1)........ ")
    if test_04_degree_check() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  5: Bond provenance seeded.......... ")
    if test_05_bond_prov_seeded() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  6: Molecule provenance non-zero.... ")
    if test_06_mol_prov_nonzero() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  7: Different bonds diff prov....... ")
    if test_07_diff_bonds_diff_prov() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  8: delta_32 bound [0, 96).......... ")
    if test_08_delta32_bound() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test  9: Atom provenance non-zero........ ")
    if test_09_atom_prov_nonzero() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("Test 10: Bond invalid atoms no-op........ ")
    if test_10_invalid_bond_noop() != 0 { print("PASS\n"); passed = passed + 1 } else { print("FAIL\n"); failed = failed + 1 }

    print("\nPassed: ")
    print_int(passed)
    print("\nFailed: ")
    print_int(failed)
    print("\n")

    if failed > 0 {
        print("SOME TESTS FAILED\n")
        return 1
    }
    print("ALL 10 TESTS PASSED\n")
    0
}
