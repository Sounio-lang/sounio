//@ run-pass
//@ expect-stdout: ALL 10 TESTS PASSED
//@ expect-stdout: Failed: 0
// Epistemic Molecule H2O Test Suite
//
// Self-contained tests for the epistemic chemical molecule graph.
// Every bond carries Merkle provenance, variance, and confidence.
// The hardware accumulator bound (delta_32 < 96) is verified.
//
// All functions inlined (tests cannot import stdlib).

// ============================================================================
// MERKLE INFRASTRUCTURE (inlined from hardware/rtl/kaxi/merkle_root_lane.sio)
// ============================================================================

let MOL_MERKLE_SALT_A: i64 = 0x4F4D4547
let MOL_MERKLE_SALT_B: i64 = 0x4147454E
let MOL_MERKLE_SALT_C: i64 = 0x45534953
let MOL_MERKLE_SALT_D: i64 = 0x76312E30

let MOL_MAX_ATOMS: i64 = 256
let MOL_MAX_BONDS: i64 = 512
let MOL_BOND_SINGLE: i64 = 1

fn mol_merkle_mix(a: i64, b: i64, c: i64, salt: i64) -> i64 {
    ((a ^ b) + c + salt) ^ (a << 5) ^ (b >> 7)
}

fn mol_merkle_root_lane_l64(
    p0: i64, p1: i64, p2: i64, p3: i64, p4: i64
) -> i64 {
    let h0 = mol_merkle_mix(p0, p1, p2, MOL_MERKLE_SALT_A)
    let h1 = mol_merkle_mix(p3, p4, h0, MOL_MERKLE_SALT_B)
    let h2 = mol_merkle_mix(h0, h1, p0 ^ p3, MOL_MERKLE_SALT_C)
    mol_merkle_mix(h1, h2, p1 ^ p2, MOL_MERKLE_SALT_D)
}

fn mol_atom_hash(atomic_number: i64, mass_q16_16: i64) -> i64 {
    var hash: i64 = 5381
    hash = hash * 33 + atomic_number
    hash = hash * 33 + mass_q16_16
    hash & 9223372036854775807
}

fn mol_bond_hash(src: i64, dst: i64, bond_type: i64) -> i64 {
    var hash: i64 = 5381
    hash = hash * 33 + src
    hash = hash * 33 + dst
    hash = hash * 33 + bond_type
    hash & 9223372036854775807
}

fn mol_provenance_seed(item_hash: i64) -> i64 {
    mol_merkle_root_lane_l64(0, item_hash, 0, 0, 1)
}

fn mol_provenance_merge(
    existing_root_l64: i64,
    item_hash: i64,
    variance_q32_32: i64,
    confidence_beta: i64
) -> i64 {
    mol_merkle_root_lane_l64(
        existing_root_l64,
        item_hash,
        variance_q32_32,
        confidence_beta,
        existing_root_l64 ^ item_hash
    )
}

fn mol_delta_32(fidelity: i64, provenance: i64, quantum: i64) -> i64 {
    let frac_f = fidelity - (fidelity / 8) * 8
    let frac_p = provenance - (provenance / 16) * 16
    let frac_q = quantum - (quantum / 32) * 32
    frac_f * 4 + frac_p * 2 + frac_q
}

// ============================================================================
// EPISTEMIC MOLECULE STRUCT (inlined)
// ============================================================================

struct EpistemicMolecule {
    atom_atomic_number: [i64; 256],
    atom_mass_q16_16: [i64; 256],
    atom_provenance_l64: [i64; 256],
    atom_count: i64,

    bond_src: [i64; 512],
    bond_dst: [i64; 512],
    bond_type: [i64; 512],
    bond_provenance_l64: [i64; 512],
    bond_variance_q32_32: [i64; 512],
    bond_confidence_beta: [i64; 512],
    bond_count: i64,

    mol_provenance_l64: i64,
}

fn mol_new() -> EpistemicMolecule {
    EpistemicMolecule {
        atom_atomic_number: [0; 256],
        atom_mass_q16_16: [0; 256],
        atom_provenance_l64: [0; 256],
        atom_count: 0,

        bond_src: [0; 512],
        bond_dst: [0; 512],
        bond_type: [0; 512],
        bond_provenance_l64: [0; 512],
        bond_variance_q32_32: [0; 512],
        bond_confidence_beta: [0; 512],
        bond_count: 0,

        mol_provenance_l64: 0,
    }
}

fn mol_add_atom(
    m: EpistemicMolecule,
    atomic_number: i64,
    mass_q16_16: i64
) -> (EpistemicMolecule, i64) with Mut, Panic {
    var mol = m
    if mol.atom_count >= MOL_MAX_ATOMS {
        return (mol, 0 - 1)
    }
    let id = mol.atom_count
    mol.atom_atomic_number[id] = atomic_number
    mol.atom_mass_q16_16[id] = mass_q16_16
    let ah = mol_atom_hash(atomic_number, mass_q16_16)
    mol.atom_provenance_l64[id] = mol_provenance_seed(ah)
    mol.atom_count = mol.atom_count + 1
    (mol, id)
}

fn mol_atom_count(m: EpistemicMolecule) -> i64 {
    m.atom_count
}

fn mol_atom_provenance_at(m: EpistemicMolecule, atom_id: i64) -> i64 with Panic, Div {
    if atom_id < 0 || atom_id >= m.atom_count {
        return 0
    }
    m.atom_provenance_l64[atom_id]
}

fn mol_valid_atom(m: EpistemicMolecule, atom_id: i64) -> bool {
    atom_id >= 0 && atom_id < m.atom_count
}

fn mol_add_bond(
    m: EpistemicMolecule,
    src: i64,
    dst: i64,
    btype: i64
) -> EpistemicMolecule with Mut, Panic {
    var mol = m
    if !mol_valid_atom(mol, src) {
        return mol
    }
    if !mol_valid_atom(mol, dst) {
        return mol
    }
    if mol.bond_count >= MOL_MAX_BONDS {
        return mol
    }
    let id = mol.bond_count
    mol.bond_src[id] = src
    mol.bond_dst[id] = dst
    mol.bond_type[id] = btype
    let bh = mol_bond_hash(src, dst, btype)
    mol.bond_provenance_l64[id] = mol_provenance_seed(bh)
    mol.bond_variance_q32_32[id] = 0
    mol.bond_confidence_beta[id] = 1
    mol.bond_count = mol.bond_count + 1
    mol
}

fn mol_bond_count(m: EpistemicMolecule) -> i64 {
    m.bond_count
}

fn mol_degree(m: EpistemicMolecule, atom_id: i64) -> i64 with Mut, Panic, Div {
    var count: i64 = 0
    var i: i64 = 0
    while i < m.bond_count {
        if m.bond_src[i] == atom_id || m.bond_dst[i] == atom_id {
            count = count + 1
        }
        i = i + 1
    }
    count
}

fn mol_has_bond(m: EpistemicMolecule, src: i64, dst: i64) -> bool with Mut, Panic, Div {
    var i: i64 = 0
    while i < m.bond_count {
        if m.bond_src[i] == src && m.bond_dst[i] == dst {
            return true
        }
        i = i + 1
    }
    false
}

fn mol_bond_provenance(m: EpistemicMolecule, bond_id: i64) -> i64 with Panic, Div {
    if bond_id < 0 || bond_id >= m.bond_count {
        return 0
    }
    m.bond_provenance_l64[bond_id]
}

fn mol_bond_variance(m: EpistemicMolecule, bond_id: i64) -> i64 with Panic, Div {
    if bond_id < 0 || bond_id >= m.bond_count {
        return 0
    }
    m.bond_variance_q32_32[bond_id]
}

fn mol_bond_confidence(m: EpistemicMolecule, bond_id: i64) -> i64 with Panic, Div {
    if bond_id < 0 || bond_id >= m.bond_count {
        return 0
    }
    m.bond_confidence_beta[bond_id]
}

fn mol_update_provenance(m: EpistemicMolecule) -> EpistemicMolecule with Mut, Panic, Div {
    var mol = m
    var root: i64 = 0
    var i: i64 = 0
    while i < mol.bond_count {
        root = mol_merkle_mix(
            root,
            mol.bond_provenance_l64[i],
            mol.bond_variance_q32_32[i],
            MOL_MERKLE_SALT_A
        )
        i = i + 1
    }
    mol.mol_provenance_l64 = root
    mol
}

fn mol_molecule_provenance(m: EpistemicMolecule) -> i64 {
    m.mol_provenance_l64
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

fn test_empty_molecule() -> bool {
    let mol = mol_new()
    mol_atom_count(mol) == 0 && mol_bond_count(mol) == 0
        && mol_molecule_provenance(mol) == 0
}

fn test_add_atoms() -> bool with Mut, Panic {
    var mol = mol_new()
    // H(Z=1, mass=1.008 as Q16.16 ~= 66060)
    let p1 = mol_add_atom(mol, 1, 66060)
    mol = p1.0
    // O(Z=8, mass=15.999 as Q16.16 ~= 1048510)
    let p2 = mol_add_atom(mol, 8, 1048510)
    mol = p2.0
    // H(Z=1)
    let p3 = mol_add_atom(mol, 1, 66060)
    mol = p3.0
    mol_atom_count(mol) == 3 && p1.1 == 0 && p2.1 == 1 && p3.1 == 2
}

fn test_add_bonds() -> bool with Mut, Panic, Div {
    var mol = mol_new()
    let p0 = mol_add_atom(mol, 1, 66060)
    mol = p0.0
    let p1 = mol_add_atom(mol, 8, 1048510)
    mol = p1.0
    let p2 = mol_add_atom(mol, 1, 66060)
    mol = p2.0
    mol = mol_add_bond(mol, 0, 1, MOL_BOND_SINGLE)
    mol = mol_add_bond(mol, 1, 2, MOL_BOND_SINGLE)
    let ok1 = mol_bond_count(mol) == 2
    let ok2 = mol_has_bond(mol, 0, 1)
    let ok3 = mol_has_bond(mol, 1, 2)
    let ok4 = !mol_has_bond(mol, 0, 2)
    ok1 && ok2 && ok3 && ok4
}

fn test_degree_check() -> bool with Mut, Panic, Div {
    var mol = mol_new()
    let p0 = mol_add_atom(mol, 1, 66060)
    mol = p0.0
    let p1 = mol_add_atom(mol, 8, 1048510)
    mol = p1.0
    let p2 = mol_add_atom(mol, 1, 66060)
    mol = p2.0
    mol = mol_add_bond(mol, 0, 1, MOL_BOND_SINGLE)
    mol = mol_add_bond(mol, 1, 2, MOL_BOND_SINGLE)
    let deg_o = mol_degree(mol, 1)
    let deg_h1 = mol_degree(mol, 0)
    let deg_h2 = mol_degree(mol, 2)
    deg_o == 2 && deg_h1 == 1 && deg_h2 == 1
}

fn test_bond_provenance_seeded() -> bool with Mut, Panic, Div {
    var mol = mol_new()
    let p0 = mol_add_atom(mol, 8, 1048510)
    mol = p0.0
    let p1 = mol_add_atom(mol, 1, 66060)
    mol = p1.0
    mol = mol_add_bond(mol, 0, 1, MOL_BOND_SINGLE)
    let prov = mol_bond_provenance(mol, 0)
    let var_v = mol_bond_variance(mol, 0)
    let conf = mol_bond_confidence(mol, 0)
    prov != 0 && var_v == 0 && conf == 1
}

fn test_molecule_provenance() -> bool with Mut, Panic, Div {
    var mol = mol_new()
    let p0 = mol_add_atom(mol, 1, 66060)
    mol = p0.0
    let p1 = mol_add_atom(mol, 8, 1048510)
    mol = p1.0
    let p2 = mol_add_atom(mol, 1, 66060)
    mol = p2.0
    mol = mol_add_bond(mol, 0, 1, MOL_BOND_SINGLE)
    mol = mol_add_bond(mol, 1, 2, MOL_BOND_SINGLE)
    mol = mol_update_provenance(mol)
    mol_molecule_provenance(mol) != 0
}

fn test_different_bonds_different_provenance() -> bool with Mut, Panic, Div {
    var mol = mol_new()
    let p0 = mol_add_atom(mol, 1, 66060)
    mol = p0.0
    let p1 = mol_add_atom(mol, 8, 1048510)
    mol = p1.0
    let p2 = mol_add_atom(mol, 1, 66060)
    mol = p2.0
    mol = mol_add_bond(mol, 0, 1, MOL_BOND_SINGLE)
    mol = mol_add_bond(mol, 1, 2, MOL_BOND_SINGLE)
    let prov_b0 = mol_bond_provenance(mol, 0)
    let prov_b1 = mol_bond_provenance(mol, 1)
    // Different endpoints produce different provenance roots
    prov_b0 != 0 && prov_b1 != 0 && prov_b0 != prov_b1
}

fn test_delta_32_bound() -> bool with Mut, Panic, Div {
    var mol = mol_new()
    let p0 = mol_add_atom(mol, 8, 1048510)
    mol = p0.0
    let p1 = mol_add_atom(mol, 1, 66060)
    mol = p1.0
    mol = mol_add_bond(mol, 0, 1, MOL_BOND_SINGLE)
    let var_v = mol_bond_variance(mol, 0)
    let conf = mol_bond_confidence(mol, 0)
    let delta = mol_delta_32(0, var_v, conf)
    delta >= 0 && delta < 96
}

fn test_atom_provenance_nonzero() -> bool with Mut, Panic, Div {
    var mol = mol_new()
    let p0 = mol_add_atom(mol, 1, 66060)
    mol = p0.0
    let p1 = mol_add_atom(mol, 8, 1048510)
    mol = p1.0
    let prov_h = mol_atom_provenance_at(mol, 0)
    let prov_o = mol_atom_provenance_at(mol, 1)
    prov_h != 0 && prov_o != 0 && prov_h != prov_o
}

fn test_bond_invalid_atoms_noop() -> bool with Mut, Panic {
    var mol = mol_new()
    // No atoms added — bond should be no-op
    mol = mol_add_bond(mol, 0, 1, MOL_BOND_SINGLE)
    mol_bond_count(mol) == 0
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Epistemic Molecule H2O Tests ===")
    println("")

    var passed = 0
    var failed = 0

    print("Test  1: Empty molecule.................. ")
    if test_empty_molecule() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  2: Add atoms (H, O, H)............ ")
    if test_add_atoms() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  3: Add bonds (H-O, O-H)........... ")
    if test_add_bonds() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  4: Degree check (O=2, H=1)........ ")
    if test_degree_check() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  5: Bond provenance seeded.......... ")
    if test_bond_provenance_seeded() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  6: Molecule provenance non-zero.... ")
    if test_molecule_provenance() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  7: Different bonds diff prov....... ")
    if test_different_bonds_different_provenance() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  8: delta_32 bound [0, 96).......... ")
    if test_delta_32_bound() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test  9: Atom provenance non-zero........ ")
    if test_atom_provenance_nonzero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("Test 10: Bond invalid atoms no-op........ ")
    if test_bond_invalid_atoms_noop() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 10 TESTS PASSED")
    return 0
}
