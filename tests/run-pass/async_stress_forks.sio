//@ run-pass
//@ expect-stdout-contains: stress_forks: PASS
// Stress: many concurrent spawns — probes fork rlimit and mmap slot reuse

async fn compute(n: i32) -> i32 with Async { n * 10 }

fn main() with IO, Async {
    let h1 = spawn { compute(1).await }
    let h2 = spawn { compute(2).await }
    let h3 = spawn { compute(3).await }
    let h4 = spawn { compute(4).await }
    let h5 = spawn { compute(5).await }
    let h6 = spawn { compute(6).await }
    let h7 = spawn { compute(7).await }
    let h8 = spawn { compute(8).await }
    let h9 = spawn { compute(9).await }
    let h10 = spawn { compute(10).await }

    let r1 = h1.await
    let r2 = h2.await
    let r3 = h3.await
    let r4 = h4.await
    let r5 = h5.await
    let r6 = h6.await
    let r7 = h7.await
    let r8 = h8.await
    let r9 = h9.await
    let r10 = h10.await

    if r1 == 10 && r2 == 20 && r3 == 30 && r4 == 40 && r5 == 50 {
        if r6 == 60 && r7 == 70 && r8 == 80 && r9 == 90 && r10 == 100 {
            print("stress_forks: PASS\n")
        } else {
            print("stress_forks: FAIL\n")
        }
    } else {
        print("stress_forks: FAIL\n")
    }
}
