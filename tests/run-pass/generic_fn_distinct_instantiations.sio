//@ run-pass
//@ expect-stdout: distinct instantiations: PASS
// One generic fn instantiated with several different type arguments in one
// program. The specializer used to keep a single clone per template: a second
// distinct instantiation poisoned it, and the template was lowered with its
// parameters erased -- right for i64 and bool, silently wrong for f64
// (`identity::<f64>(2.5)` returned garbage). Each instantiation now gets its own
// clone, including ones whose arguments are not plain names.

fn identity<T>(x: T) -> T {
    x
}

fn first_of<T>(a: [T; 3]) -> T {
    a[0]
}

fn deref_it<T>(r: &T) -> T {
    *r
}

fn main() -> i32 with IO {
    var ok: i64 = 0
    let a = identity::<i64>(5)
    if a == 5 { ok = ok + 1 }
    let b = identity::<f64>(2.5)
    if b == 2.5 { ok = ok + 1 }
    let c = identity::<bool>(true)
    if c { ok = ok + 1 }
    let xs: [f64; 3] = [1.5, 2.5, 3.5]
    let d = first_of::<f64>(xs)
    if d == 1.5 { ok = ok + 1 }
    let ys: [i64; 3] = [4, 5, 6]
    let e = first_of::<i64>(ys)
    if e == 4 { ok = ok + 1 }
    let v: f64 = 7.25
    let g = deref_it::<f64>(&v)
    if g == 7.25 { ok = ok + 1 }
    if ok == 6 {
        print("distinct instantiations: PASS\n")
    }
    return 0
}
