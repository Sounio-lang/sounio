//@ run-pass
//@ description: Feature C-b (firewalled heuristic) — causal-set provenance quasi-metric
// Importing experimental::heuristic from a TEST is allowed by the firewall gate
// (scripts/ci/heuristic_firewall_gate.sh); correctness-critical modules may not.
use experimental::heuristic::provenance::*

fn main() -> i64 with Mut, Panic, Div {
    // Provenance DAG: 0=evidence → 1=step1 → 2=step2 → 3=conclusion, plus a direct
    // shortcut 0→3; node 4 is unrelated (a claim with no shared derivation).
    var d = prov_new(5)
    prov_add_edge(&! d, 0, 1)
    prov_add_edge(&! d, 1, 2)
    prov_add_edge(&! d, 2, 3)
    prov_add_edge(&! d, 0, 3)

    // counting measure = LONGEST chain (0-1-2-3 = 3), not the direct shortcut (1)
    if prov_longest_chain(&d, 0, 3) != 3 { return 1 }
    if prov_longest_chain(&d, 0, 0) != 0 { return 2 }

    // causal order: conclusion is in the future of evidence, not vice versa
    if !prov_reachable(&d, 0, 3) { return 3 }
    if prov_reachable(&d, 3, 0) { return 4 }

    // the asymmetric quasi-metric: forward = chain length, backward = spacelike sentinel
    if prov_evidential_distance(&d, 0, 3) != 3 { return 5 }
    if prov_evidential_distance(&d, 3, 0) != prov_spacelike_sentinel() { return 6 }

    // timelike (properly derived) vs spacelike (unjustified leap)
    if !prov_is_timelike(&d, 0, 3) { return 7 }
    if prov_is_spacelike(&d, 0, 3) { return 8 }
    if !prov_is_spacelike(&d, 0, 4) { return 9 }
    if prov_is_timelike(&d, 0, 4) { return 10 }

    0
}
