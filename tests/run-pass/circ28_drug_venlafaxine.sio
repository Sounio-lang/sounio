//@ run-pass
//@ timeout: 300
//@ expect-stdout-contains: CIRC28_DRUG_VENLAFAXINE_PASS
//
// Venlafaxine (extended-release capsule XR, immediate-release tablet IR) + O-desmethylvenlafaxine (ODV) on the
// circ28 drug record, coupled by circ28_metab.sio. Module, parameter table and sources:
// stdlib/darwin_pbpk/circ28_drug_venlafaxine.sio. CYP2D6 extensive metaboliser (EM) unless stated; 73 kg.
//
// FITTED, hence NOT validations (one observable per fitted parameter; pools printed in S0):
//   R Kp scalar  -> V_ss 321.2 L (4.4 L/kg intravenous, one source)
//   R total hepatic intrinsic clearance -> POOLED oral clearance CL/F (k = 7)
//   R f2D6 (CYP2D6 share of the hepatic intrinsic clearance) -> POOLED PM/EM ratio of venlafaxine AUC (k = 3)
//   R q (share of the non-CYP2D6 clearance that forms ODV) -> ODV:venlafaxine AUC ratio in PM, 0.21 (one study)
//   R ka -> steady-state Tmax 2.0 h of the IR tablet 75 mg twice daily (one source)
//   XR t50 of the Weibull release -> POOLED XR Tmax (k = 4); lag and shape as published (Luecht 2025)
//   M Kp scalar -> V_ss 248.2 L; M clint, clren -> POOLED CL (k = 2) and fe 0.515, all of intravenous desvenlafaxine
//   MEASURED, not fitted: renal clearance of venlafaxine, fa, fu, B:P, logP, pKa.
//
// CRITERIA, fixed before the runs: an observation with a between-subject SD: |z| <= 2; an observation with no
// spread: within a factor 1.5. Rows whose study is inside a pool are CONSISTENCY checks and are marked [c].
//
// HAND PREDICTIONS written before any coupled run (closed forms of the fitted record evaluated in a Sounio scratch
// program, and one-compartment estimates with V = V_ss, k = CL/V_ss). Outcome after the run in brackets.
//   H1  F = fa (1 - Eh) = 0.511; intravenous CL 56.0 L/h; V_ss ln2/CL = 3.97 h                    [exact: closed forms]
//       F vs 0.42 +/- 0.15 (Australian PI): z 0.6 PASS; vs 0.40-0.45 (Patat 1998): fold 1.2 PASS     [hit]
//   H2  f2D6 = 0.783, q = 0.209                                                                     [exact]
//   H3  EM oral AUC ratio ODV/venlafaxine 3.70: PASS against the pool of six studies, FAIL (fold 0.60) against
//       Nichols 2011 alone (6.2)                                                                    [hit: 3.70 both]
//   H4  ODV AUC after 150 mg: 5065 ng h/mL; PASS vs He 2024 (6272 +/- 1665)                          [hit: 5065]
//   H5  PM/EM: ODV AUC 0.222 (PASS vs 0.183 and 0.294), active-moiety AUC 1.008 (PASS vs 0.92)      [hit]
//   H6  urine: venlafaxine unchanged 3.6 % of the dose (PASS at 1.5 vs 5 %), unconjugated ODV 34.6 % (PASS vs 29 %)
//                                                                                                   [hit]
//   H7  venlafaxine terminal half-life (IR) 4.0-5.5 h (PASS vs 5 +/- 2); ODV 9.5-11 h (PASS vs 11 +/- 2)
//                                                                                    [hit: 4.87 h IV, 5.09 h IR; ODV 9.81 h]
//   H8  XR 150 mg single dose, venlafaxine Cmax 75-95 ng/mL (one-compartment, ka = ke at Tmax 5.85 h)
//                                                                       [MISS: 101.4, 7 % above the range]
//   H9  XR 150 mg once daily steady state: venlafaxine Cmax 85-100 ng/mL, FAIL vs the label's 150 (fold 0.57-0.67)
//                                              [MISS twice: 108.3 ng/mL and fold 0.72, a PASS at 1.5]
//   H10 same, ODV Cmax 235-255 ng/mL (PASS vs 260), ODV Tmax 9-11 h (PASS vs 9)
//                                              [values MISSED narrowly: 263.9 ng/mL, 8.88 h; both verdicts hit]
//   H11 IR 75 mg twice daily steady state: venlafaxine Cmax 110-150 ng/mL, FAIL vs 225
//                                              [range MISSED (76.8 ng/mL); verdict FAIL hit, and worse than foreseen]
//   H12 XR apparent terminal half-life of venlafaxine 5.5-9 h; t50 of the release 3-4 h
//                                              [both MISSED: 4.90 h and t50 0.69 h; see the diagnosis in S8]
//   H13 end-stage renal disease, closed forms: desvenlafaxine AUC x2.06 (PASS vs 2.16); venlafaxine oral clearance
//       -7 % (FAIL vs -55 %, Troy 1994); ODV apparent clearance -53 % (PASS vs -55 %)             [hit]
//   H14 PM/EM venlafaxine Cmax 1.8-2.3 (PASS vs 2.8, Nichols 2011)                               [hit: 2.20]
//   NOT foreseen: the PM Cmax ratio ODV/venlafaxine (V12f) was expected to pass because the PM AUC ratio is fitted;
//   it is 0.125 against 0.22 (fold 0.57, FAIL): the ODV curve of the PM is flatter than observed.
// DISCLOSURE. Before the rows V8-V11, V13 and V15 were written, exploratory coupled runs made to choose the input
// structure (ka to the IR Tmax, then t50 to the XR Tmax; alternatively the published Weibull unchanged) had shown
// the XR and IR Cmax, Tmax and half-life values. Their pass/fail flags below are therefore records of the measured
// outcome, not pre-registrations, except where a hand prediction H8-H12 exists (misses recorded above).
// The published Weibull unchanged (t50 5.63 h) with ANY ka gives a single-dose XR Tmax >= 6.19 h (ka = 50 /h) and
// 11.3 h with the fitted ka: it cannot be kept together with the IR Tmax in this kernel (S8).
//
// COMPILER WORKAROUNDS (not fixed, recorded): a `main` holding two records, two parameter structs and several
// [f64; 18] / [f64; 8] arrays segfaulted at run time on Madaros (scratch program of this work): every section is
// its own function and `main` holds only the two records and small result arrays; the record fits are written out
// in `main` (lean_single mis-forwards chained record fits, risperidone test); arrays are passed by reference and
// big arrays live in the frame that runs the kernel. Guard rows compare the same quantity computed two ways.

// =====================================================================================================
// ROUND "TRANSIT" (2026-11-15). Everything above is the history of rounds 1-2 (first-order input); its numbers are the
// BASELINE of this round (IR ss Cmax R 76.8, XR 150 mg ss Cmax R 108.3, XR t50 0.689 h, ka 0.2597 /h, test 1.46 s compiled).
// CHANGE: the oral input is an Erlang chain of ntr = 4 stages (n = 3 transit compartments, a DECLARED ASSUMPTION, plus 1:
// common rules 11); CD_KA = k per stage, fitted to the IR steady-state Tmax 2.0 h (same observable as before); the XR keeps
// its Weibull release (lag 1.353 h, shape 0.92, Luecht 2025; t50 refitted to the pooled XR single-dose Tmax 5.846 h) and the
// released drug travels the SAME chain (convolution); tlag 0 (none sourced). Cmax, Cmax/AUC, MTT are validation rows.
// GUT Kp: the whole validation is run for gv 0 (V_ss scalar on every organ, gut included) and, in a compact column, for
// gv 1 (gut wall at its Rodgers-Rowland Kp, scalar refitted with circ28_kp_scale_for_vss_gutrr, k and t50 refitted).
//
// PRE-REGISTERED PREDICTIONS (written before any run of the changed code beyond `souc check`; ranges; outcomes are
// recorded in the RESULTS block at the end of this header, never edited here). The only runs before this block was
// written were the unchanged round-2 test (the baseline numbers above) and reading the cmax report (diagnostic of
// 2026-11-15: IR ss Cmax 119.5 ng/mL with 3 transit stages in a local stepper, Cavg 57.0).
//   T1  k (1/h per stage), gv 0                                   1.5 - 3.5 (point 2.3); MTT 4/k 1.1 - 2.7 h
//   T2  XR t50 refitted at that k                                 1.0 - 2.6 h (point 1.6; round 1: 0.689 h); V18 (vs Luecht
//       5.633 h) stays FAIL: fold 0.18 - 0.46
//   T3  IR single-dose Tmax R                                     2.2 - 2.8 h (round 1: 2.86 h)
//   T4  IR 75 mg q12h ss Cmax R                                   108 - 140 ng/mL (point 122; round 1: 76.8); V13 against 225
//       stays FAIL (fold 0.48 - 0.62, below 1/1.5)
//   T5  XR 150 mg single Cmax R 102 - 125 (101.4); XR 150 mg once daily ss Cmax R 112 - 135 (108.3); V10 (label 150) pass
//   T6  IR/XR ss Cmax ratio (75 mg q12h over 150 mg q24h)         0.85 - 1.25 (round 1: 0.71; diagnostic 1.10; label 1.50):
//       the inconsistency PERSISTS (ratio below 1.25 against 1.50) at the pooled CL/F
//   T7  CL/F that gives IR ss Cmax 225 (diagnostic, record not refitted)   42 - 54 L/h; at it the XR ss Cmax R 190 - 250 and
//       the ratio 0.85 - 1.25: no single CL/F fits both label rows
//   T8  AUC rows unchanged (oral AUC = dose/(CL/F)): XR 150 mg R AUCinf 1368.7 +/- 0.3 %, ODV 5065.7 +/- 0.3 % (closed forms
//       do not contain the input); F 0.5114, V_ss, IV rows, f2D6 0.7832, q 0.2089 identical to 6 digits
//   T9  ODV: XR 150 mg ss Cmax 255 - 280 ng/mL (263.9), Tmax 8.0 - 9.3 h (8.88); IR ss Cmax 225 - 262 (227.5), Tmax 3.0 - 3.9 h
//       (3.88); V13b, V13c, V10b, V10d keep passing
//   T10 PM vs EM, XR 75 mg: venlafaxine Cmax ratio 2.1 - 2.6 (2.196), ODV:R Cmax ratio 0.10 - 0.14 (0.125, V12f stays FAIL)
//   T11 R terminal half-life IR 5.09 +/- 0.15 h, XR apparent 4.90 +/- 0.15 h (V15b, V15c stay FAIL: flip-flop not reproduced)
//   T12 V5c Cmax ratio ODV/R after XR 75 mg 1.40 - 1.85 (1.815): stays FAIL
//   T13 gut Kp: R scalar 1.23 - 1.30 (1.235); every peak row (IR/XR Cmax R, ODV) changes by less than 2 % between gv 0 and
//       gv 1, AUC rows by less than 0.5 %; gv 1 is therefore NOT adopted (no failing peak row improves by more than 2 %)
//   T14 mass balance of the chain input (IR, XR) <= 1e-9; XR dose left in the chain at 132 h <= 1e-6 mg
//   T15 budget: AM AUC relative u 0.075 - 0.087 (0.081), AM ss Cmax relative u 0.07 - 0.10 (0.079); Tmax IR share of var(AM ss
//       Cmax) now 10 - 25 % (16 %)
//   T16 compiled run time 1.5 - 3.5 s (round 1: 1.46 s)
//
// RESULTS (recorded after the runs, 2026-11-15; Madaros, lean_single and the default engine print the marker):
//   T1 HIT  k 2.3753 /h (gv 1: 2.3237), MTT 4/k 1.684 h                T2 HIT  t50 2.4038 h (gv 1: 2.3874), V18 fold 0.427 (FAIL kept)
//   T3 MISS IR single-dose Tmax R 2.025 h (below 2.2; the first-order round gave 2.86 h)
//   T4 HIT  IR ss Cmax R 129.9 ng/mL, V13 fold 0.577 (FAIL kept; 76.8 in round 1, fold 0.34)
//   T5 HIT  XR 150 mg single Cmax R 106.5, ss 114.0 ng/mL; V10 PASS kept   T6 HIT  IR/XR ratio 1.140 (label 1.50): inconsistency PERSISTS
//   T7 HIT  CL/F for IR 225: 49.4 L/h; XR there 205.5 ng/mL, ratio 1.095; even-split CL/F 61.8 L/h (IR fold 0.86, XR fold 1.16)
//   T8 HIT  XR 150 mg AUCinf R 1368.72, ODV 5065.70; F, V_ss, f2D6, q identical to 6 digits (guards)
//   T9 HALF ODV XR ss Cmax 265.5 (HIT), Tmax 9.01 h (HIT); MISS IR ss Cmax ODV 264.2 (262 upper bound), MISS IR ss Tmax ODV 2.705 h
//           (below 3.0); V13b, V13c, V10b, V10d keep PASS (HIT)
//   T10 HIT PM/EM Cmax ratio 2.116, ODV:R Cmax ratio in PM 0.1236, V12f FAIL kept
//   T11 HALF XR apparent R half-life 4.95 h (HIT, 4.75-5.05), V15b/c FAIL kept (HIT); MISS R IR half-life 4.872 h (below 4.94)
//   T12 HIT V5c ratio 1.726, FAIL kept   T13 HIT R scalar 1.2427; gv 1 moves peak rows by at most 0.6 %, AUC rows by <= 1e-8 relative:
//           gv 1 NOT adopted   T14 HIT chain balance 0, left in the chain 0 mg
//   T15 HALF AM AUC rel u 0.0810 (HIT), Tmax IR share 19.2 % (HIT); MISS AM ss Cmax rel u 0.1010 (upper bound 0.10)
//   T16 HIT compiled run 2.13 s (Madaros ELF)
//   Verdict changes against round 1: none (V13 0.34 -> 0.58 and V18 0.12 -> 0.43 are still FAIL; V10 still PASS).
//   The rows marked [MISS] in the body are the pre-registered ranges that missed; each is paired with a regression band on the
//   measured value (narrow), so a later change of the model is visible.
// COMPILER WORKAROUNDS ADDED IN THIS ROUND: a fit that returns [f64; 18] (ven_fit_m_g, ven_fit_r_g, through the record wrappers)
// segfaulted on Madaros when called from any function other than `main` (scratch program of this work, 3 lines): the gv 1 records
// are therefore built in `main`, before the first section, and passed by reference. lean_single: kernel runs before closed forms
// give wrong closed forms (k2 is precomputed before the first run).
// =====================================================================================================

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_metab::*
use darwin_pbpk::circ28_drug_venlafaxine::*
use math::pure::{ln}

fn vt_fold(tag: string, pred: f64, obs: f64, fold: f64, expect_pass: i32) -> i32 with IO, Mut, Div, Panic {
    let r = pred / obs
    var ok: i32 = 0
    if r <= fold && r >= 1.0 / fold { ok = 1 }
    print("  "); print(tag); print("  pred "); print(pred); print("  obs "); print(obs); print("  fold "); print(r)
    if ok == 1 { println("  [pass]") } else { println("  [fail]") }
    if ok != expect_pass {
        println("  [FAIL] outcome differs from the recorded one")
        return 1
    }
    return 0
}

fn vt_z(tag: string, pred: f64, obs: f64, sd: f64, expect_pass: i32) -> i32 with IO, Mut, Div, Panic {
    let z = (pred - obs) / sd
    var ok: i32 = 0
    if z <= 2.0 && z >= 0.0 - 2.0 { ok = 1 }
    print("  "); print(tag); print("  pred "); print(pred); print("  obs "); print(obs); print("  SD "); print(sd); print("  z "); print(z)
    if ok == 1 { println("  [pass]") } else { println("  [fail]") }
    if ok != expect_pass {
        println("  [FAIL] outcome differs from the recorded one")
        return 1
    }
    return 0
}

fn vt_band(tag: string, v: f64, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    if v >= lo && v <= hi { return 0 }
    print("  [FAIL] "); print(tag); print(" = "); print(v); print(" outside ["); print(lo); print(", "); print(hi); println("]")
    return 1
}

// A pre-registered range: prints HIT or MISS and never fails; a miss is paired with a regression band on the measured value.
fn vt_pre(tag: string, v: f64, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    if v >= lo && v <= hi {
        print("  [HIT]  "); print(tag); print(" = "); println(v)
    } else {
        print("  [MISS] "); print(tag); print(" = "); print(v); print(" outside the pre-registered ["); print(lo); print(", "); print(hi); println("]")
    }
    return 0
}
fn vt_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    d = d / want
    print("  "); print(tag); print("  got "); print(got); print("  want "); print(want); print("  rel "); println(d)
    if d > tol {
        println("  [FAIL] above tolerance")
        return 1
    }
    return 0
}

fn vt_sqrt(x: f64) -> f64 with Mut, Div, Panic { return cd_sqrt(x) }

// q of the split (closed form of the module), from the two records.
fn vt_split(dr: &Circ28Drug, dm: &Circ28Drug, sp: &![f64; 8]) with Mut, Div, Panic, Epistemic {
    let thm = circ28_drug_theta(dm)
    let fsrc = ven_fsrc(thm)
    let clm = ven_cl_total(thm)
    let thr = circ28_drug_theta(dr)
    ven_split(thr, ven_obs_clf(), ven_obs_pmratio(), ven_obs_pm_odvratio(), ven_m_mw() / ven_r_mw(), fsrc, clm, sp)
}

// One coupled run and its steady state at interval tau. route 0 IV (0.5 h infusion), 1 IR, 2 XR.
// pm 1: the CYP2D6 formation is removed (clform = clint q/(1 - q)). gv: gut-wall Kp variant of the records and of the run;
// the input constants (k in the record, t50 here) are those fitted for that variant.
fn vt_run(dr: &Circ28Drug, dm: &Circ28Drug, route: i32, dose: f64, pm: i32, q: f64, tau: f64, lo: f64, hi: f64, gv: i32, res: &![f64; 24], ss: &![f64; 10]) with Mut, Div, Panic, Epistemic {
    var thr = circ28_drug_theta(dr)
    if pm == 1 { thr[CD_CLFORM] = thr[CD_CLINT] * q / (1.0 - q) }
    let thm = circ28_drug_theta(dm)
    var ts: [f64; 400] = [0.0; 400]
    var cr: [f64; 400] = [0.0; 400]
    var cm: [f64; 400] = [0.0; 400]
    ven_run_th_g(thr, thm, route, dose, 0.5, ven_t50_fit_g(gv), gv, lo, hi, 60.0, 120.0, &!ts, &!cr, &!cm, res)
    ven_ss(&cr, &cm, tau, ss)
}

fn vt_show(tag: string, r: &[f64; 24]) with IO, Mut, Div, Panic {
    print(tag); print(": R Cmax "); print(1000.0 * (*r)[0]); print(" ng/mL Tmax "); print((*r)[1]); print(" h AUCinf "); print(1000.0 * (*r)[2]); print(" ng h/mL t1/2 "); println((*r)[3])
    print("      M Cmax "); print(1000.0 * (*r)[5]); print(" Tmax "); print((*r)[6]); print(" AUCinf "); print(1000.0 * (*r)[7]); print(" t1/2 "); println((*r)[8])
    print("      balance R "); print((*r)[10]); print(" M "); print((*r)[11]); print(" grid/fits ok "); print((*r)[12]); print("/"); print((*r)[13]); print("/"); print((*r)[14]); print(" left in the chain (mg) "); println((*r)[23])
}

// ---- S0: pools, record, the transit constants
fn vt_s0(dr: &Circ28Drug, dm: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var o: [f64; 5] = [0.0; 5]
    println("S0 pooled observables (mean, u = max(pooled SE, between-study SD/sqrt k), the two terms, between-study SD)")
    ven_clf_pool(&!o)
    print("  CL/F venlafaxine (L/h), k 7: "); print(o[0]); print("  u "); print(o[1]); print("  between "); print(o[2]); print("  pooled SE "); print(o[3]); print("  SD "); println(o[4])
    fails = fails + vt_band("CL/F pool", o[0], 109.5, 109.7)
    fails = fails + vt_band("u CL/F pool", o[1], 19.6, 19.8)
    ven_pm_pool(&!o)
    print("  PM/EM venlafaxine AUC ratio, k 3: "); print(o[0]); print("  u "); print(o[1]); print("  SD "); println(o[4])
    ven_tmax_pool(&!o)
    print("  XR Tmax (h), k 4: "); print(o[0]); print("  u "); print(o[1]); print("  pooled SE "); print(o[3]); print("  SD "); println(o[4])
    ven_clm_pool(&!o)
    print("  CL ODV (L/h), k 2: "); print(o[0]); print("  u "); print(o[1]); print("  between "); print(o[2]); print("  pooled SE "); println(o[3])
    println("  oral input (round transit): ntr stages, k per stage (CD_KA), MTT = ntr/k, mode of the input rate (ntr - 1)/k, XR t50")
    let kk = ven_ka_fit_g(0)
    print("  ntr "); print(ven_ntr()); print("  k "); print(kk); print(" /h  MTT "); print(circ28_transit_mtt(kk, ven_ntr())); print(" h  mode "); print(circ28_transit_mode(kk, ven_ntr(), 0.0)); print(" h  XR t50 "); print(ven_t50_fit_g(0)); println(" h (lag 1.353 h, shape 0.92 as published)")
    print("  round 1 (first-order): ka 0.259729 /h (mean absorption time 3.85 h), t50 0.689116 h")
    println("  record: R then ODV (value, status)")
    var i: i32 = 0
    while i < 18 {
        print("  R "); print(i); print(" "); print(circ28_drug_value(dr, i)); print("  status "); print((*dr).status[i])
        print("   |  M "); print(circ28_drug_value(dm, i)); print("  status "); println((*dm).status[i])
        i = i + 1
    }
    fails = fails + vt_rel("record CD_KA = k of ven_ka_fit", circ28_drug_value(dr, CD_KA), kk, 1.0e-12)
    return fails
}

// Small wrappers: one closed form per frame (lean_single gave wrong values when a frame held a local [f64; 18] next
// to other arrays or a parameter struct: CL of ODV 24.17 instead of 18.89 L/h).
fn vt_cl(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params(d)
    return circ28_hepatic_extraction(p) * circ28_q_hepatic(p) * p.bp + circ28_drug_value(d, CD_CLREN)
}
fn vt_f(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params(d)
    let e = circ28_hepatic_extraction(p)
    return circ28_drug_value(d, CD_FA) * (1.0 - e)
}
fn vt_vss(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic { return circ28_vss_plasma(circ28_drug_params(d)) }
fn vt_bb(d: &Circ28Drug) -> f64 with Mut, Div, Panic, Epistemic {
    let p = circ28_drug_params(d)
    return p.bp * circ28_q_hepatic(p)
}

// Closed forms evaluated once, before any kernel run: k2[18] CL R, [19] F_src of ODV, [20] F, [21] bp Qh, [22] CL of ODV.
fn vt_cf(dr: &Circ28Drug, dm: &Circ28Drug, k2: &![f64; 24]) with Mut, Div, Panic, Epistemic {
    (*k2)[18] = vt_cl(dr)
    (*k2)[20] = vt_f(dr)
    (*k2)[21] = vt_bb(dr)
    let thm = circ28_drug_theta(dm)
    (*k2)[19] = ven_fsrc(thm)
    (*k2)[22] = ven_cl_total(thm)
}

// ---- S0b: the chain integrator against the closed form (before any kernel run)
fn vt_chain() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S0b the stage-amount chain (ven_chain_step) against the closed forms (guard: same quantity two ways)")
    let k = ven_ka_fit_g(0)
    let n = ven_ntr()
    var a: [f64; 8] = [0.0; 8]
    a[0] = 1.0
    var cum = 0.0
    var t = 0.0
    var wmax = 0.0
    var step: i32 = 0
    while step < 120 {
        let arr = ven_chain_step(&!a, k, n, 0.1, 0.0)
        cum = cum + arr
        t = t + 0.1
        var d = cum - (1.0 - circ28_oral_left_n(k, n, 0.0, t))
        if d < 0.0 { d = 0.0 - d }
        if d > wmax { wmax = d }
        step = step + 1
    }
    print("  impulse in stage 1, 120 steps of 0.1 h: max |arrived - (1 - S_4(t))| = "); println(wmax)
    fails = fails + vt_band("chain vs S_4 (max abs difference)", wmax, 0.0, 1.0e-13)
    var b: [f64; 8] = [0.0; 8]
    var arrived = 0.0
    step = 0
    while step < 40 {
        arrived = arrived + ven_chain_step(&!b, k, n, 0.5, 2.0)
        step = step + 1
    }
    var left = 0.0
    var j: i32 = 0
    while j < n {
        left = left + b[j]
        j = j + 1
    }
    print("  constant release 2 mg/h for 20 h: arrived "); print(arrived); print(" in the chain "); print(left); print(" sum "); println(arrived + left)
    fails = fails + vt_rel("mass conservation of the chain (40 mg)", arrived + left, 40.0, 1.0e-13)
    return fails
}

// ---- S1: the fits reproduce their observables; input consistency (lesson 2)
fn vt_s1(dr: &Circ28Drug, dm: &Circ28Drug, sp: &[f64; 8]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S1 the fits reproduce their observables (NOT validations)")
    let cl = vt_cl(dr)
    let f = vt_f(dr)
    let vss = vt_vss(dr)
    let clren = circ28_drug_value(dr, CD_CLREN)
    fails = fails + vt_rel("V_ss R (L)", vss, ven_obs_r_vss(), 1.0e-9)
    fails = fails + vt_rel("CL/F R (L/h), closed form = pool", cl / f, ven_obs_clf(), 1.0e-9)
    let bb = vt_bb(dr)
    let clfpm = ((*sp)[7] + clren * ((*sp)[7] + bb) / bb) / circ28_drug_value(dr, CD_FA)
    fails = fails + vt_rel("(CL/F)_EM/(CL/F)_PM, closed form = pool", (cl / f) / clfpm, ven_obs_pmratio(), 1.0e-9)
    print("  f2D6 "); print((*sp)[2]); print("  q "); print((*sp)[3]); print("  Eh EM "); print((*sp)[4]); print("  Eh PM "); println((*sp)[5])
    fails = fails + vt_band("f2D6 (hand 0.783)", (*sp)[2], 0.780, 0.786)
    fails = fails + vt_band("q (hand 0.209)", (*sp)[3], 0.206, 0.212)
    fails = fails + vt_rel("clform = (f + q(1-f)) tot", circ28_drug_value(dr, CD_CLFORM), ((*sp)[2] + (*sp)[3] * (1.0 - (*sp)[2])) * (*sp)[0], 1.0e-9)
    println("  input consistency (lesson 2): V_ss ln2/CL against the terminal half-life")
    let hl = vss * 0.6931471805599453 / cl
    print("  R: IV CL (predicted) "); print(cl); print(" L/h;  V_ss ln2/CL = "); print(hl); println(" h;  terminal 5 +/- 2 h (label), 3-4 h (Klamerus 1992)")
    fails = fails + vt_band("V_ss ln2/CL R", hl, 3.9, 4.05)
    let clm = vt_cl(dm)
    let vssm = vt_vss(dm)
    fails = fails + vt_rel("V_ss M (L)", vssm, ven_obs_m_vss(), 1.0e-9)
    fails = fails + vt_rel("CL M (L/h) = pool", clm, ven_obs_m_cl(), 1.0e-9)
    fails = fails + vt_rel("fe M", circ28_drug_value(dm, CD_CLREN) / clm, ven_obs_m_fe(), 1.0e-9)
    let hlm = vssm * 0.6931471805599453 / clm
    print("  M: V_ss ln2/CL = "); print(hlm); println(" h;  terminal 9.8 +/- 2.1 h IV (Nichols 2012), 11 +/- 2 h (label): the terminal phase is longer, as it must be")
    fails = fails + vt_band("V_ss ln2/CL M", hlm, 9.0, 9.2)
    print("  Kp scalar R (gv 0) "); print(circ28_drug_value(dr, CD_KPSC)); print("  M "); println(circ28_drug_value(dm, CD_KPSC))
    return fails
}

// ---- S2: intravenous run (F two ways, IV half-life). One kernel run per function (lean_single returned a
// different, wrong second run when two runs shared a frame).
fn vt_s2(dr: &Circ28Drug, dm: &Circ28Drug, cf: &[f64; 24], keep: &![f64; 32]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var iv: [f64; 24] = [0.0; 24]
    var ss: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 0, 10.0, 0, 0.0, 24.0, 12.0, 36.0, 0, &!iv, &!ss)
    vt_show("S2 IV 10 mg over 0.5 h", &iv)
    fails = fails + vt_band("IV balance R", iv[10], 0.0, 1.0e-9)
    fails = fails + vt_band("IV balance M", iv[11], 0.0, 1.0e-9)
    fails = fails + vt_rel("guard: IV AUC = dose/CL (closed form)", iv[2], 10.0 / (*cf)[18], 2.0e-3)
    (*keep)[0] = iv[2] / 10.0
    (*keep)[1] = iv[7] / 10.0
    (*keep)[2] = iv[3]
    return fails
}

// ---- S3a: XR 75 mg single dose
fn vt_s3a(dr: &Circ28Drug, dm: &Circ28Drug, keep: &![f64; 32]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var a: [f64; 24] = [0.0; 24]
    var sa: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 2, 75.0, 0, 0.0, 24.0, 30.0, 60.0, 0, &!a, &!sa)
    vt_show("S3 XR 75 mg single dose, EM", &a)
    fails = fails + vt_band("XR balance R", a[10], 0.0, 1.0e-9)
    fails = fails + vt_band("XR balance M", a[11], 0.0, 1.0e-9)
    fails = fails + vt_band("XR dose left in the chain at 132 h (mg)", a[23], 0.0 - 1.0e-6, 1.0e-6)
    fails = fails + vt_rel("fit: XR Tmax (h) = pooled Tmax", a[1], ven_obs_tmax_xr(), 2.0e-3)
    (*keep)[3] = a[0]
    (*keep)[4] = a[2]
    (*keep)[5] = a[5]
    (*keep)[6] = a[7]
    (*keep)[7] = a[3]
    (*keep)[8] = a[8]
    (*keep)[9] = a[19] / 75.0
    (*keep)[10] = a[20] / (75.0 * ven_m_mw() / ven_r_mw())
    (*keep)[11] = a[6]
    return fails
}

// ---- S3b: XR 150 mg single dose and once daily at steady state.
// k2: 0 Cmax R, 1 Tmax R, 2 AUC R, 3 t1/2 R, 4 Cmax M, 5 Tmax M, 6 AUC M, 7 t1/2 M, 8..17 = steady state (ven_ss)
fn vt_s3b(dr: &Circ28Drug, dm: &Circ28Drug, k2: &![f64; 24]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var b: [f64; 24] = [0.0; 24]
    var sb: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 2, 150.0, 0, 0.0, 24.0, 30.0, 60.0, 0, &!b, &!sb)
    vt_show("   XR 150 mg single dose, EM", &b)
    print("   XR 150 mg once daily, steady state (superposition): R Cmax "); print(1000.0 * sb[0]); print(" Tmax "); print(sb[1]); print(" Cmin "); print(1000.0 * sb[2]); print(" AUCtau "); println(1000.0 * sb[3])
    print("      M Cmax "); print(1000.0 * sb[4]); print(" Tmax "); print(sb[5]); print(" Cmin "); print(1000.0 * sb[6]); print(" AUCtau "); print(1000.0 * sb[7]); print("  R+M Cmax "); print(1000.0 * sb[8]); print(" at "); println(sb[9])
    fails = fails + vt_rel("guard: AUCtau,ss = AUCinf single dose, R", sb[3], b[2], 3.0e-3)
    fails = fails + vt_rel("guard: AUCtau,ss = AUCinf single dose, M", sb[7], b[7], 3.0e-3)
    fails = fails + vt_rel("guard: oral AUC = dose/(CL/F), R", b[2], 150.0 / ven_obs_clf(), 3.0e-3)
    (*k2)[0] = b[0]
    (*k2)[1] = b[1]
    (*k2)[2] = b[2]
    (*k2)[3] = b[3]
    (*k2)[4] = b[5]
    (*k2)[5] = b[6]
    (*k2)[6] = b[7]
    (*k2)[7] = b[8]
    var i: i32 = 0
    while i < 10 {
        (*k2)[8 + i] = sb[i]
        i = i + 1
    }
    return fails
}

// ---- S3v: XR validation rows (scalars only)
fn vt_s3v(keep: &[f64; 32], k2: &[f64; 24]) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("   dose linearity (the model is linear; label: linear 75 to 450 mg/day)")
    fails = fails + vt_rel("Cmax R 150/75", (*k2)[0] / (*keep)[3], 2.0, 1.0e-9)
    fails = fails + vt_rel("AUC M 150/75", (*k2)[6] / (*keep)[6], 2.0, 1.0e-9)
    let c75 = 1000.0 * (*keep)[3]
    let c150 = 1000.0 * (*k2)[0]
    let ssr = 1000.0 * (*k2)[8]
    let ssm = 1000.0 * (*k2)[12]
    println("V validation, XR (ng/mL, ng h/mL, h); [c] = the study is inside a fitted pool")
    fails = fails + vt_z("V8  75 mg Cmax R, de Souza Filho 34.47 +/- 20.64 [c]   ", c75, 34.47, 20.64, 1)
    fails = fails + vt_fold("V8b 75 mg Cmax R, Chenu 2009 36 (n 12)                 ", c75, 36.0, 1.5, 1)
    fails = fails + vt_z("V9  150 mg Cmax R, He 2024 165.69 +/- 53.33 [c]         ", c150, 165.69, 53.33, 1)
    fails = fails + vt_z("V9b 150 mg Cmax R, Jain 2011 129.72 +/- 43.07 [c]       ", c150, 129.72, 43.07, 1)
    fails = fails + vt_z("V9c 150 mg Cmax ODV, He 2024 204.95 +/- 59.75          ", 1000.0 * (*k2)[4], 204.95, 59.75, 1)
    fails = fails + vt_z("V6  150 mg AUCinf ODV, He 2024 6271.75 +/- 1665.12     ", 1000.0 * (*k2)[6], 6271.75, 1665.12, 1)
    fails = fails + vt_fold("V9d 150 mg Tmax ODV, He 2024 median 10 h               ", (*k2)[5], 10.0, 1.5, 1)
    fails = fails + vt_fold("V10 ss 150 mg/day Cmax R, label 150                    ", ssr, 150.0, 1.5, 1)
    fails = fails + vt_fold("V10b ss 150 mg/day Cmax ODV, label 260                 ", ssm, 260.0, 1.5, 1)
    fails = fails + vt_z("V10c ss Tmax R, PI 6.0 +/- 1.5 [c]                      ", (*k2)[9], 6.0, 1.5, 1)
    fails = fails + vt_z("V10d ss Tmax ODV, PI 8.8 +/- 2.2                        ", (*k2)[13], 8.8, 2.2, 1)
    fails = fails + vt_fold("V11 ss 225 mg/day Cmax R, Ermer 2013 180.7 [c]         ", 1.5 * ssr, 180.7, 1.5, 1)
    fails = fails + vt_fold("V11b ss 225 mg/day AUCtau ODV, Ermer 2013 8083         ", 1500.0 * (*k2)[15], 8083.0, 1.5, 1)
    fails = fails + vt_fold("V11c ss 225 mg/day Cmax R+ODV, Ermer 2013 593.1        ", 1500.0 * (*k2)[16], 593.1, 1.5, 1)
    fails = fails + vt_z("V15 XR apparent t1/2 R (30-60 h), PI 15 +/- 6           ", (*k2)[3], 15.0, 6.0, 1)
    fails = fails + vt_fold("V15b XR apparent t1/2 R, He 2024 9.15 h                ", (*k2)[3], 9.15, 1.5, 0)
    fails = fails + vt_fold("V15c XR apparent t1/2 R, Jain 2011 7.81 h              ", (*k2)[3], 7.81, 1.5, 0)
    fails = fails + vt_z("V4  ODV t1/2 (60-120 h), label 11 +/- 2                 ", (*k2)[7], 11.0, 2.0, 1)
    fails = fails + vt_z("V7  ODV apparent CL dose/AUC (L/h/kg), label 0.4 +/- 0.2", 150.0 / (*k2)[6] / 73.0, 0.4, 0.2, 1)
    fails = fails + vt_fold("V14 urine: venlafaxine unchanged, fraction of dose, label 0.05 ", (*keep)[9], 0.05, 1.5, 1)
    fails = fails + vt_fold("V14b urine: unconjugated ODV, molar fraction of dose, label 0.29", (*keep)[10], 0.29, 1.5, 1)
    // bands around the measured outcomes of this round (hand predictions T5, T9, T11 in the header)
    fails = fails + vt_band("XR 150 Cmax R (T5 102-125)", c150, 102.0, 125.0)
    fails = fails + vt_band("XR ss Cmax R (T5 112-135)", ssr, 112.0, 135.0)
    fails = fails + vt_band("XR ss Cmax ODV (T9 255-280)", ssm, 259.0, 269.0)
    fails = fails + vt_band("XR ss Tmax ODV (T9 8.0-9.3)", (*k2)[13], 8.6, 9.1)
    fails = fails + vt_band("XR apparent t1/2 R (T11 4.9 +/- 0.15)", (*k2)[3], 4.7, 5.1)
    fails = fails + vt_band("ODV t1/2 (hand 9.5-11)", (*k2)[7], 9.5, 11.0)
    fails = fails + vt_band("ODV AUC 150 mg (T8 5065.7 +/- 0.3 %)", 1000.0 * (*k2)[6], 5010.0, 5120.0)
    return fails
}

// ---- S4: ratios EM (oral, IV), F
fn vt_s4(cf: &[f64; 24], keep: &[f64; 32]) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("V validation, bioavailability and metabolite ratio, EM")
    let f_cf = (*cf)[20]
    let f_run = ((*keep)[4] / 75.0) / (*keep)[0]
    fails = fails + vt_rel("guard: F from the runs (AUC oral/AUC IV) = closed form", f_run, f_cf, 3.0e-3)
    fails = fails + vt_z("V1  F venlafaxine, PI 0.42 +/- 0.15                     ", f_cf, 0.42, 0.15, 1)
    fails = fails + vt_fold("V1b F venlafaxine, Patat 1998 0.40-0.45 (0.425)        ", f_cf, 0.425, 1.5, 1)
    fails = fails + vt_band("F (hand 0.511)", f_cf, 0.508, 0.514)
    let ratio = (*keep)[6] / (*keep)[4]
    // observed EM ratio pooled over six studies (none of these ratios enters a fit; Ermer, He and PMID 32974907
    // contribute their venlafaxine AUC to the CL/F pool: marked [c])
    var v: [f64; 8] = [0.0; 8]
    var se: [f64; 8] = [0.0; 8]
    v[0] = 6.2
    v[1] = 8083.0 / 2407.0
    v[2] = 6271.75 / 2596.75
    v[3] = (1971.0 + 2226.0) / (526.0 + 195.0)
    v[4] = 3.4
    v[5] = 2.5
    var o: [f64; 5] = [0.0; 5]
    ven_pool(&v, &se, 6, &!o)
    print("  observed EM oral AUC ratio ODV/venlafaxine, k 6 (6.2 Nichols 2011; 3.36 Ermer 2013; 2.42 He 2024; 5.82 PMID 32974907; 3.4 PMID 35132786; 2.5 Klamerus 1992): mean "); print(o[0]); print("  SD "); println(o[4])
    fails = fails + vt_z("V5  oral AUC ratio ODV/R vs the pool of six [c]         ", ratio, o[0], o[4], 1)
    fails = fails + vt_fold("V5b oral AUC ratio ODV/R, Nichols 2011 alone 6.2       ", ratio, 6.2, 1.5, 0)
    fails = fails + vt_fold("V5c Cmax ratio ODV/R after XR 75 mg, Nichols 2011 3.3  ", (*keep)[5] / (*keep)[3], 3.3, 1.5, 0)
    fails = fails + vt_band("V5c Cmax ratio ODV/R after XR 75 mg (T12 1.40-1.85)", (*keep)[5] / (*keep)[3], 1.40, 1.85)
    fails = fails + vt_band("EM AUC ratio (hand 3.70)", ratio, 3.66, 3.74)
    print("  IV AUC ratio ODV/R (no observation found): "); print((*keep)[1] / (*keep)[0]); print("; oral/IV = "); print(ratio / ((*keep)[1] / (*keep)[0])); println(" (first pass forms ODV: > 1)")
    return fails
}

// ---- S5: poor metaboliser
fn vt_s5(dr: &Circ28Drug, dm: &Circ28Drug, q: f64, keep: &![f64; 32]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var p: [f64; 24] = [0.0; 24]
    var sp: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 2, 75.0, 1, q, 24.0, 48.0, 96.0, 0, &!p, &!sp)
    vt_show("S5 XR 75 mg single dose, PM (CYP2D6 formation removed)", &p)
    fails = fails + vt_rel("fit: PM/EM venlafaxine AUC = pooled ratio", p[2] / (*keep)[4], ven_obs_pmratio(), 3.0e-3)
    fails = fails + vt_rel("fit: PM ODV/venlafaxine AUC = 0.21", p[7] / p[2], ven_obs_pm_odvratio(), 3.0e-3)
    println("V validation, PM against EM")
    fails = fails + vt_fold("V12 ODV AUC PM/EM, Nichols 2011 1/5.45 = 0.183         ", p[7] / (*keep)[6], 0.1835, 1.5, 1)
    fails = fails + vt_fold("V12b ODV AUC PM/EM, Lindh 2003 1/3.4 = 0.294           ", p[7] / (*keep)[6], 0.2941, 1.5, 1)
    fails = fails + vt_fold("V12c active-moiety AUC PM/EM, Nichols 2011 derived 0.92", (p[2] + p[7]) / ((*keep)[4] + (*keep)[6]), 0.92, 1.5, 1)
    fails = fails + vt_fold("V12d venlafaxine Cmax PM/EM, Nichols 2011 2.8          ", p[0] / (*keep)[3], 2.8, 1.5, 1)
    fails = fails + vt_fold("V12e ODV Cmax PM/EM, Nichols 2011 1/5.34 = 0.187       ", p[5] / (*keep)[5], 0.1873, 1.5, 1)
    fails = fails + vt_fold("V12f PM Cmax ratio ODV/R, Nichols 2011 0.22            ", p[5] / p[0], 0.22, 1.5, 0)
    fails = fails + vt_band("PM Cmax ratio ODV/R band (T10 0.10-0.14)", p[5] / p[0], 0.10, 0.14)
    fails = fails + vt_band("PM/EM venlafaxine Cmax (T10 2.1-2.6)", p[0] / (*keep)[3], 2.1, 2.6)
    print("  PM venlafaxine t1/2 (48-96 h) "); print(p[3]); println(" h (no observation with a number was read)")
    print("  consistency, not a row: quinidine in EM lowered CL/F 100 -> 17 L/h (x 5.9, Lessard 1999); the model's CYP2D6 removal gives x "); println(p[2] / (*keep)[4])
    fails = fails + vt_band("ODV AUC PM/EM (hand 0.222)", p[7] / (*keep)[6], 0.215, 0.230)
    fails = fails + vt_band("AM AUC PM/EM (hand 1.008)", (p[2] + p[7]) / ((*keep)[4] + (*keep)[6]), 0.99, 1.03)
    (*keep)[12] = p[0] / (*keep)[3]
    (*keep)[13] = p[0]
    return fails
}

// ---- S6: immediate release 75 mg every 12 h, steady state. keep[16] IR single Tmax, 17 ss Cmax R, 18 ss Cmax ODV, 19 ss Tmax ODV,
// 20 single Cmax R
fn vt_s6(dr: &Circ28Drug, dm: &Circ28Drug, keep: &![f64; 32]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var a: [f64; 24] = [0.0; 24]
    var s: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 1, 75.0, 0, 0.0, 12.0, 12.0, 36.0, 0, &!a, &!s)
    vt_show("S6 IR 75 mg single dose, EM", &a)
    print("   IR 75 mg every 12 h, steady state: R Cmax "); print(1000.0 * s[0]); print(" Tmax "); print(s[1]); print(" Cmin "); print(1000.0 * s[2]); print("  M Cmax "); print(1000.0 * s[4]); print(" Tmax "); println(s[5])
    fails = fails + vt_band("IR balance R", a[10], 0.0, 1.0e-9)
    fails = fails + vt_band("IR dose left in the chain at 132 h (mg)", a[23], 0.0 - 1.0e-6, 1.0e-6)
    fails = fails + vt_rel("fit: IR steady-state Tmax (h) = 2.0", s[1], ven_obs_tmax_ir(), 2.0e-3)
    println("V validation, IR (label Table 17, no spread)")
    fails = fails + vt_fold("V13 ss Cmax R, label 225                               ", 1000.0 * s[0], 225.0, 1.5, 0)
    fails = fails + vt_fold("V13b ss Cmax ODV, label 290                            ", 1000.0 * s[4], 290.0, 1.5, 1)
    fails = fails + vt_fold("V13c ss Tmax ODV, label 3 h                            ", s[5], 3.0, 1.5, 1)
    fails = fails + vt_z("V3  terminal t1/2 R (12-36 h), label 5 +/- 2            ", a[3], 5.0, 2.0, 1)
    fails = fails + vt_fold("V3b terminal t1/2 R, Klamerus 1992 3-4 h (3.5)         ", a[3], 3.5, 1.5, 1)
    fails = fails + vt_pre("IR single-dose Tmax R (T3 2.2-2.8)", a[1], 2.2, 2.8)
    fails = fails + vt_band("IR single-dose Tmax R, measured regression band", a[1], 2.00, 2.05)
    fails = fails + vt_band("IR ss Cmax R (T4 108-140)", 1000.0 * s[0], 108.0, 140.0)
    fails = fails + vt_pre("IR ss Cmax ODV (T9 225-262)", 1000.0 * s[4], 225.0, 262.0)
    fails = fails + vt_band("IR ss Cmax ODV, measured regression band", 1000.0 * s[4], 262.0, 266.0)
    fails = fails + vt_pre("IR ss Tmax ODV (T9 3.0-3.9)", s[5], 3.0, 3.9)
    fails = fails + vt_band("IR ss Tmax ODV, measured regression band", s[5], 2.65, 2.76)
    fails = fails + vt_pre("t1/2 R (T11 5.09 +/- 0.15)", a[3], 4.94, 5.24)
    fails = fails + vt_band("t1/2 R, measured regression band", a[3], 4.85, 4.90)
    (*keep)[16] = a[1]
    (*keep)[17] = s[0]
    (*keep)[18] = s[4]
    (*keep)[19] = s[5]
    (*keep)[20] = a[0]
    return fails
}

// ---- S7: end-stage renal disease, closed forms (renal clearance of both set to 0; nothing else changed)
// Scalars only (see vt_cf).
fn vt_s7(clm: f64, clrenm: f64, bb: f64, clren: f64, fa: f64, sp: &[f64; 8]) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S7 end-stage renal disease: renal clearance of R and ODV = 0, hepatic clearances unchanged (closed forms)")
    let clm0 = clm - clrenm
    fails = fails + vt_fold("V17 desvenlafaxine AUC ESRD/healthy, monograph 2.16    ", clm / clm0, 2.16, 1.5, 1)
    fails = fails + vt_fold("V17b desvenlafaxine t1/2 ESRD/healthy, 22.8/11.1       ", clm / clm0, 22.8 / 11.1, 1.5, 1)
    let y = (*sp)[6]
    let clf = (y + clren * (y + bb) / bb) / fa
    let clf0 = y / fa
    fails = fails + vt_fold("V17c venlafaxine CL/F dialysis/healthy, Troy 1994 0.45 ", clf0 / clf, 0.45, 1.5, 0)
    // ODV apparent clearance dose/AUC_ODV: AUC_ODV ~ formed/CL_M; formed fraction (Eh + (1-Eh) CLh/CL) -> 1
    let eh = (*sp)[4]
    let clh = bb * eh
    let formed = eh + (1.0 - eh) * clh / (clh + clren)
    fails = fails + vt_fold("V17d ODV apparent CL dialysis/healthy, Troy 1994 0.45  ", (clm0 / clm) * formed, 0.45, 1.5, 1)
    fails = fails + vt_band("venlafaxine CL/F ESRD/healthy (hand 0.93)", clf0 / clf, 0.92, 0.94)
    fails = fails + vt_band("desvenlafaxine AUC ESRD/healthy (hand 2.06)", clm / clm0, 2.05, 2.07)
    return fails
}

// ---- S8: the release description
fn vt_s8() -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S8 release description (consistency, not validation)")
    fails = fails + vt_fold("V18 fitted t50 (h) vs Luecht 2025 PK-Sim 5.633 h       ", ven_t50_fit(), ven_xr_t50_luecht(), 1.5, 0)
    fails = fails + vt_band("t50 (T2 1.0-2.6 h)", ven_t50_fit(), 1.0, 2.6)
    let t50 = ven_t50_fit()
    // Weibull release: time at which a fraction f is released after the lag: t50 (-ln(1 - f)/ln2)^(1/b)
    let t90 = ven_xr_lag() + t50 * 3.6917
    print("  fitted release: 50 % at "); print(ven_xr_lag() + t50); print(" h, 90 % at "); print(t90); print(" h; mean transit time of the chain ntr/k = "); print(circ28_transit_mtt(ven_ka_fit(), ven_ntr())); println(" h")
    println("  diagnosis: the IR steady-state Tmax of 2 h now fixes the chain (MTT 1.7 h instead of the 3.85 h mean absorption time of the")
    println("  first-order fit), which leaves more of the pooled XR Tmax to the release; t50 rises from 0.69 to 2.4 h but the published")
    println("  5.63 h would put the single-dose Tmax beyond 8 h. The flip-flop half-life (15 +/- 6 h, PI) is still not reproduced (V15).")
    return fails
}

// ---- S9: uncertainty budget
fn vt_s9(dr: &Circ28Drug, dm: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let b = ven_budget(dr, dm, 150.0)
    print("S9 uncertainty budget with refit, XR 150 mg, EM: "); print(b.runs); println(" coupled runs (forward differences)")
    let ua = vt_sqrt(b.var_auc)
    let uc = vt_sqrt(b.var_cmax)
    print("  active-moiety AUC (R + ODV) "); print(1000.0 * b.am_auc); print(" ng h/mL  u "); print(1000.0 * ua); print("  rel "); println(ua / b.am_auc)
    print("  active-moiety steady-state Cmax, 150 mg once daily "); print(1000.0 * b.am_cmax); print(" ng/mL  u "); print(1000.0 * uc); print("  rel "); println(uc / b.am_cmax)
    print("  venlafaxine AUC "); print(1000.0 * b.r_auc); print("  u "); print(1000.0 * vt_sqrt(b.var_r)); print("   ODV AUC "); print(1000.0 * b.m_auc); print("  u "); println(1000.0 * vt_sqrt(b.var_m))
    println("  input        u(input)    share of var(AM AUC) %    share of var(AM Cmax,ss) %")
    var i: i32 = 0
    while i < 19 {
        print("  "); print(ven_input_name(i)); print("  "); print(b.u[i]); print("    "); print(100.0 * b.contrib_auc[i] / b.var_auc); print("    "); println(100.0 * b.contrib_cmax[i] / b.var_cmax)
        i = i + 1
    }
    fails = fails + vt_band("AM AUC (ng h/mL)", 1000.0 * b.am_auc, 6300.0, 6560.0)
    fails = fails + vt_band("AM AUC relative u", ua / b.am_auc, 0.075, 0.087)
    fails = fails + vt_pre("AM Cmax,ss relative u (T15 0.07-0.10)", uc / b.am_cmax, 0.07, 0.10)
    fails = fails + vt_band("AM Cmax,ss relative u, measured regression band", uc / b.am_cmax, 0.098, 0.104)
    fails = fails + vt_band("share of Tmax IR in var(AM Cmax,ss) % (T15 10-25)", 100.0 * b.contrib_cmax[14] / b.var_cmax, 10.0, 25.0)
    return fails
}


// ---- S9b: the chords of the budget against a refit (one perturbation of each Tmax observable by its u)
fn vt_tmax_ir_at(dr: &Circ28Drug, dm: &Circ28Drug, k: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var thr = circ28_drug_theta(dr)
    thr[CD_KA] = k
    let thm = circ28_drug_theta(dm)
    var ts: [f64; 400] = [0.0; 400]
    var cr: [f64; 400] = [0.0; 400]
    var cm: [f64; 400] = [0.0; 400]
    var res: [f64; 24] = [0.0; 24]
    ven_run_th_g(thr, thm, 1, 75.0, 0.5, 1.0, 0, 12.0, 36.0, 60.0, 120.0, &!ts, &!cr, &!cm, &!res)
    var ss: [f64; 10] = [0.0; 10]
    ven_ss(&cr, &cm, 12.0, &!ss)
    return ss[1]
}

fn vt_tmax_xr_at(dr: &Circ28Drug, dm: &Circ28Drug, k: f64, t50: f64) -> f64 with Mut, Div, Panic, Epistemic {
    var thr = circ28_drug_theta(dr)
    thr[CD_KA] = k
    let thm = circ28_drug_theta(dm)
    var ts: [f64; 400] = [0.0; 400]
    var cr: [f64; 400] = [0.0; 400]
    var cm: [f64; 400] = [0.0; 400]
    var res: [f64; 24] = [0.0; 24]
    ven_run_th_g(thr, thm, 2, 75.0, 0.5, t50, 0, 30.0, 60.0, 60.0, 120.0, &!ts, &!cr, &!cm, &!res)
    return res[1]
}

fn vt_s9b(dr: &Circ28Drug, dm: &Circ28Drug) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S9b the chords of the budget against the refit (each Tmax observable moved by 0.1 u, the budget step scale; the cross term t50(k) included)")
    let k0 = ven_ka_fit()
    let uir = ven_u_tmax_ir()
    let kc = k0 + ven_dka_dtmax() * 0.1 * uir
    let tir = vt_tmax_ir_at(dr, dm, kc)
    print("  IR Tmax obs + 0.1 u = "); print(ven_obs_tmax_ir() + 0.1 * uir); print("  refit by the chord: k "); print(kc); print("  ss Tmax "); println(tir)
    fails = fails + vt_rel("chord k(Tmax IR), step 0.1 u", tir, ven_obs_tmax_ir() + 0.1 * uir, 1.5e-3)
    let uxr = ven_u_tmax_xr()
    let t50c = ven_t50_fit() + ven_dt50_dtmax() * 0.1 * uxr + ven_dt50_dk() * (kc - k0)
    let txr = vt_tmax_xr_at(dr, dm, kc, t50c)
    print("  XR Tmax obs + 0.1 u = "); print(ven_obs_tmax_xr() + 0.1 * uxr); print("  both chords: k "); print(kc); print("  t50 "); print(t50c); print("  single-dose Tmax "); println(txr)
    fails = fails + vt_rel("chord t50(Tmax XR, k), step 0.1 u", txr, ven_obs_tmax_xr() + 0.1 * uxr, 1.0e-3)
    return fails
}

// ---- S10: the two label rows of Table 17 (IR 75 mg q12h 225 ng/mL; XR 150 mg q24h 150 ng/mL) and their ratio.
// Diagnostic, the record is NOT refitted to them: at the pooled CL/F, then at the CL/F that would give 225 for the IR, then at the
// CL/F that splits the error evenly (product of the two folds = 1; added after the first run, not pre-registered).
// Each hypothetical record is the module's own refit (ven_fit_r_g) at the stated CL/F with the input constants (k, t50) held.
fn vt_cmax_at(dr: &Circ28Drug, dm: &Circ28Drug, route: i32, clf: f64, fsrc: f64, clm: f64) -> f64 with Mut, Div, Panic, Epistemic {
    let thr0 = circ28_drug_theta(dr)
    let thr = ven_fit_r_g(thr0, ven_obs_r_vss(), clf, ven_obs_pmratio(), ven_obs_pm_odvratio(), ven_m_mw() / ven_r_mw(), fsrc, clm, 0)
    let thm = circ28_drug_theta(dm)
    var ts: [f64; 400] = [0.0; 400]
    var cr: [f64; 400] = [0.0; 400]
    var cm: [f64; 400] = [0.0; 400]
    var res: [f64; 24] = [0.0; 24]
    var dose = 75.0
    var tau = 12.0
    if route == 2 {
        dose = 150.0
        tau = 24.0
    }
    ven_run_th_g(thr, thm, route, dose, 0.5, ven_t50_fit(), 0, 12.0, 36.0, 60.0, 120.0, &!ts, &!cr, &!cm, &!res)
    var ss: [f64; 10] = [0.0; 10]
    ven_ss(&cr, &cm, tau, &!ss)
    return 1000.0 * ss[0]
}

fn vt_s10(dr: &Circ28Drug, dm: &Circ28Drug, k2: &[f64; 24], keep: &[f64; 32]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S10 label rows of Table 17: IR 75 mg q12h parent Cmax 225 ng/mL, XR 150 mg q24h parent Cmax 150 ng/mL (ratio 1.50); diagnostic")
    let fsrc = (*k2)[19]
    let clm = (*k2)[22]
    let bb = (*k2)[21]
    let ir0 = 1000.0 * (*keep)[17]
    let xr0 = 1000.0 * (*k2)[8]
    print("  pooled CL/F "); print(ven_obs_clf()); print(" L/h: IR "); print(ir0); print(" (fold "); print(ir0 / 225.0); print(")  XR "); print(xr0); print(" (fold "); print(xr0 / 150.0); print(")  ratio IR/XR "); print(ir0 / xr0); println("  label 1.50; round 1 (first-order input) 76.8 / 108.3 = 0.71, diagnostic of the cmax report 1.10")
    fails = fails + vt_band("IR/XR ss Cmax ratio at the pooled CL/F (T6 0.85-1.25)", ir0 / xr0, 0.85, 1.25)
    fails = fails + vt_fold("IR/XR ratio against the label 1.50 (persists)", ir0 / xr0, 1.5, 1.2, 0)
    // CL/F for IR = 225 (secant)
    var a = 44.0
    var b = 52.0
    var fa = vt_cmax_at(dr, dm, 1, a, fsrc, clm) - 225.0
    var fb = vt_cmax_at(dr, dm, 1, b, fsrc, clm) - 225.0
    var it: i32 = 0
    while it < 12 && (fb > 1.0e-6 || fb < 0.0 - 1.0e-6) {
        let c = b - fb * (b - a) / (fb - fa)
        a = b
        fa = fb
        b = c
        fb = vt_cmax_at(dr, dm, 1, b, fsrc, clm) - 225.0
        it = it + 1
    }
    let clf225 = b
    let xr225 = vt_cmax_at(dr, dm, 2, clf225, fsrc, clm)
    let y225 = ven_y_for_clf(clf225, ven_r_fa(), ven_r_clren(), bb)
    let eh225 = y225 / (y225 + bb)
    print("  CL/F for IR = 225: "); print(clf225); print(" L/h (pooled "); print(ven_obs_clf()); print(", range of the seven studies 57.8 - 208)  F "); print(ven_r_fa() * (1.0 - eh225)); print("  Eh "); print(eh225); print("  IV CL "); println(ven_r_fa() * (1.0 - eh225) * clf225)
    print("    there: IR 225 (by construction)  XR "); print(xr225); print(" (fold "); print(xr225 / 150.0); print(")  ratio "); println(225.0 / xr225)
    fails = fails + vt_band("CL/F for IR 225 (T7 42-54)", clf225, 42.0, 54.0)
    fails = fails + vt_band("XR ss Cmax at that CL/F (T7 190-250)", xr225, 190.0, 250.0)
    fails = fails + vt_band("IR/XR ratio at that CL/F (T7 0.85-1.25)", 225.0 / xr225, 0.85, 1.25)
    // even split: (IR/225)(XR/150) = 1
    var c0 = 50.0
    var c1 = 70.0
    var g0 = (vt_cmax_at(dr, dm, 1, c0, fsrc, clm) / 225.0) * (vt_cmax_at(dr, dm, 2, c0, fsrc, clm) / 150.0) - 1.0
    var g1 = (vt_cmax_at(dr, dm, 1, c1, fsrc, clm) / 225.0) * (vt_cmax_at(dr, dm, 2, c1, fsrc, clm) / 150.0) - 1.0
    it = 0
    while it < 10 && (g1 > 1.0e-6 || g1 < 0.0 - 1.0e-6) {
        let c = c1 - g1 * (c1 - c0) / (g1 - g0)
        c0 = c1
        g0 = g1
        c1 = c
        g1 = (vt_cmax_at(dr, dm, 1, c1, fsrc, clm) / 225.0) * (vt_cmax_at(dr, dm, 2, c1, fsrc, clm) / 150.0) - 1.0
        it = it + 1
    }
    let irc = vt_cmax_at(dr, dm, 1, c1, fsrc, clm)
    let xrc = vt_cmax_at(dr, dm, 2, c1, fsrc, clm)
    print("  CL/F that splits the error evenly (IR fold x XR fold = 1): "); print(c1); print(" L/h: IR "); print(irc); print(" (fold "); print(irc / 225.0); print(")  XR "); print(xrc); print(" (fold "); print(xrc / 150.0); println(")")
    fails = fails + vt_band("even-split CL/F (L/h)", c1, 55.0, 80.0)
    fails = fails + vt_band("even-split IR fold", irc / 225.0, 0.80, 0.95)
    return fails
}

fn vt_vss_g(d: &Circ28Drug, gv: i32) -> f64 with Mut, Div, Panic, Epistemic {
    let th = circ28_drug_theta(d)
    let p = ven_params(th, gv)
    return circ28_vss_plasma(p)
}

// ---- S11: gut-wall Kp. Column gv 1: gut wall at its Rodgers-Rowland Kp, the V_ss scalar of R and of ODV refitted with
// circ28_kp_scale_for_vss_gutrr, k and t50 refitted offline to the SAME two observables (ven_ka_fit_g(1), ven_t50_fit_g(1)).
// Adopt gv 1 only if it improves the failing peak rows (V13, V5c, V12f, V12d) and worsens no AUC or other validation row by more
// than its stated uncertainty. g[]: 0 IV AUC R/dose, 1 XR 75 Cmax R, 2 XR 75 AUC R, 3 XR 75 Cmax ODV, 4 XR 75 Tmax R,
// 5 XR 150 ss Cmax R, 6 XR 150 ss Cmax ODV, 7 IR ss Cmax R, 8 IR ss Cmax ODV, 9 IR ss Tmax ODV, 10 PM XR 75 Cmax R,
// 11 IR single Tmax R, 12 XR 150 ss Tmax ODV, 13 XR 75 AUC ODV
fn vt_g_iv(dr: &Circ28Drug, dm: &Circ28Drug, g: &![f64; 16]) with Mut, Div, Panic, Epistemic {
    var iv: [f64; 24] = [0.0; 24]
    var ss: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 0, 10.0, 0, 0.0, 24.0, 12.0, 36.0, 1, &!iv, &!ss)
    (*g)[0] = iv[2] / 10.0
}

fn vt_g_xr75(dr: &Circ28Drug, dm: &Circ28Drug, g: &![f64; 16]) with Mut, Div, Panic, Epistemic {
    var a: [f64; 24] = [0.0; 24]
    var ss: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 2, 75.0, 0, 0.0, 24.0, 30.0, 60.0, 1, &!a, &!ss)
    (*g)[1] = a[0]
    (*g)[2] = a[2]
    (*g)[3] = a[5]
    (*g)[4] = a[1]
    (*g)[13] = a[7]
}

fn vt_g_xr150(dr: &Circ28Drug, dm: &Circ28Drug, g: &![f64; 16]) with Mut, Div, Panic, Epistemic {
    var a: [f64; 24] = [0.0; 24]
    var ss: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 2, 150.0, 0, 0.0, 24.0, 30.0, 60.0, 1, &!a, &!ss)
    (*g)[5] = ss[0]
    (*g)[6] = ss[4]
    (*g)[12] = ss[5]
}

fn vt_g_ir(dr: &Circ28Drug, dm: &Circ28Drug, g: &![f64; 16]) with Mut, Div, Panic, Epistemic {
    var a: [f64; 24] = [0.0; 24]
    var ss: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 1, 75.0, 0, 0.0, 12.0, 12.0, 36.0, 1, &!a, &!ss)
    (*g)[7] = ss[0]
    (*g)[8] = ss[4]
    (*g)[9] = ss[5]
    (*g)[11] = a[1]
}

fn vt_g_pm(dr: &Circ28Drug, dm: &Circ28Drug, q: f64, g: &![f64; 16]) with Mut, Div, Panic, Epistemic {
    var a: [f64; 24] = [0.0; 24]
    var ss: [f64; 10] = [0.0; 10]
    vt_run(dr, dm, 2, 75.0, 1, q, 24.0, 48.0, 96.0, 1, &!a, &!ss)
    (*g)[10] = a[0]
}

fn vt_gcol(dr1: &Circ28Drug, dm1: &Circ28Drug, q: f64, sc: &![f64; 4], g: &![f64; 16]) with Mut, Div, Panic, Epistemic {
    (*sc)[0] = circ28_drug_value(dr1, CD_KPSC)
    (*sc)[1] = circ28_drug_value(dm1, CD_KPSC)
    (*sc)[2] = vt_vss_g(dr1, 1)
    (*sc)[3] = vt_vss_g(dm1, 1)
    vt_g_iv(dr1, dm1, g)
    vt_g_xr75(dr1, dm1, g)
    vt_g_xr150(dr1, dm1, g)
    vt_g_ir(dr1, dm1, g)
    vt_g_pm(dr1, dm1, q, g)
}

fn vt_gut_row(tag: string, v0: f64, v1: f64, lo: f64, hi: f64) -> i32 with IO, Mut, Div, Panic {
    print("  "); print(tag); print("  gv0 "); print(v0); print("  gv1 "); print(v1); print("  gv1/gv0 "); println(v1 / v0)
    return vt_band(tag, v1 / v0, lo, hi)
}

fn vt_gut(dr0: &Circ28Drug, sc: &[f64; 4], g: &[f64; 16], keep: &[f64; 32], k2: &[f64; 24]) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S11 gut-wall Kp: column gv 1 (gut wall at its Rodgers-Rowland Kp; V_ss scalar of both records refitted; k and t50 refitted) against gv 0")
    print("  Kp scalar R: gv0 "); print(circ28_drug_value(dr0, CD_KPSC)); print("  gv1 "); print((*sc)[0]); print("   ODV: gv1 "); println((*sc)[1])
    print("  k: gv0 "); print(ven_ka_fit_g(0)); print("  gv1 "); print(ven_ka_fit_g(1)); print(" /h;  t50: gv0 "); print(ven_t50_fit_g(0)); print("  gv1 "); print(ven_t50_fit_g(1)); println(" h")
    let sc1 = (*sc)[0]
    fails = fails + vt_band("R scalar gv 1 (T13 1.23-1.30)", sc1, 1.23, 1.30)
    let vssr1 = (*sc)[2]
    fails = fails + vt_rel("V_ss R of the gv 1 record (L)", vssr1, ven_obs_r_vss(), 1.0e-9)
    let vssm1 = (*sc)[3]
    fails = fails + vt_rel("V_ss ODV of the gv 1 record (L)", vssm1, ven_obs_m_vss(), 1.0e-9)
    fails = fails + vt_band("gv 1 XR 75 Tmax = pooled (refit check)", (*g)[4], 5.8455, 5.8470)
    println("  validation rows, gv 0 | gv 1 | ratio (peak rows must move by less than 2 %, AUC rows by less than 0.5 % to leave the verdicts unchanged)")
    fails = fails + vt_gut_row("IV AUC R per mg (ng h/mL)       ", 1000.0 * (*keep)[0], 1000.0 * (*g)[0], 0.999, 1.001)
    fails = fails + vt_gut_row("XR 75 AUCinf R (ng h/mL)        ", 1000.0 * (*keep)[4], 1000.0 * (*g)[2], 0.995, 1.005)
    fails = fails + vt_gut_row("XR 75 AUCinf ODV (ng h/mL)      ", 1000.0 * (*keep)[6], 1000.0 * (*g)[13], 0.995, 1.005)
    fails = fails + vt_gut_row("XR 75 Cmax R (ng/mL)            ", 1000.0 * (*keep)[3], 1000.0 * (*g)[1], 0.98, 1.02)
    fails = fails + vt_gut_row("XR 75 Cmax ODV (ng/mL)          ", 1000.0 * (*keep)[5], 1000.0 * (*g)[3], 0.98, 1.02)
    fails = fails + vt_gut_row("XR 150 ss Cmax R (ng/mL)        ", 1000.0 * (*k2)[8], 1000.0 * (*g)[5], 0.98, 1.02)
    fails = fails + vt_gut_row("XR 150 ss Cmax ODV (ng/mL)      ", 1000.0 * (*k2)[12], 1000.0 * (*g)[6], 0.98, 1.02)
    fails = fails + vt_gut_row("XR 150 ss Tmax ODV (h)          ", (*k2)[13], (*g)[12], 0.98, 1.02)
    fails = fails + vt_gut_row("IR ss Cmax R, V13 (ng/mL)       ", 1000.0 * (*keep)[17], 1000.0 * (*g)[7], 0.98, 1.02)
    fails = fails + vt_gut_row("IR ss Cmax ODV (ng/mL)          ", 1000.0 * (*keep)[18], 1000.0 * (*g)[8], 0.98, 1.02)
    fails = fails + vt_gut_row("IR ss Tmax ODV (h)              ", (*keep)[19], (*g)[9], 0.98, 1.02)
    fails = fails + vt_gut_row("IR single-dose Tmax R (h)       ", (*keep)[16], (*g)[11], 0.98, 1.02)
    fails = fails + vt_gut_row("PM XR 75 Cmax R (ng/mL)         ", 1000.0 * (*keep)[13], 1000.0 * (*g)[10], 0.98, 1.02)
    let v5c0 = (*keep)[5] / (*keep)[3]
    let v5c1 = (*g)[3] / (*g)[1]
    let v12d0 = (*keep)[12]
    let v12d1 = (*g)[10] / (*g)[1]
    print("  failing peak rows: V13 fold "); print(1000.0 * (*keep)[17] / 225.0); print(" -> "); print(1000.0 * (*g)[7] / 225.0)
    print("   V5c ODV:R Cmax ratio "); print(v5c0); print(" -> "); print(v5c1); print(" (obs 3.3)")
    print("   V12d PM/EM Cmax "); print(v12d0); print(" -> "); print(v12d1); println(" (obs 2.8)")
    fails = fails + vt_band("V13 fold change", (1000.0 * (*g)[7] / 225.0) / (1000.0 * (*keep)[17] / 225.0), 0.98, 1.02)
    fails = fails + vt_band("V5c ratio change", v5c1 / v5c0, 0.98, 1.02)
    fails = fails + vt_band("V12d ratio change", v12d1 / v12d0, 0.98, 1.02)
    println("  DECISION: gv 1 is NOT adopted. No failing peak row improves by more than 2 % (above), no row is worse by more than its uncertainty,")
    println("  so the criterion 'adopt only if it improves the failing peak rows' is not met; gv 0 stays the module's variant. The gut Kp is not")
    println("  the cause of the low venlafaxine peak: the gut-wall scalar is 1.235 here (tacrolimus 102.2), a depot time constant of seconds.")
    return fails
}
fn main() with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var dm = circ28_drug_new()
    var dr = circ28_drug_new()
    ven_measured_m(&!dm)
    ven_fit_record_m_g(&!dm, 0)
    ven_measured_r(&!dr)
    ven_fit_record_r_g(&!dr, &dm, 0)
    ven_ka_record_g(&!dr, 0)
    var sp: [f64; 8] = [0.0; 8]
    vt_split(&dr, &dm, &!sp)
    var keep: [f64; 32] = [0.0; 32]
    // Every closed form is evaluated HERE, before the first kernel run: on lean_single the same wrappers return
    // different, wrong values once a kernel run has used the stack. Madaros is not affected.
    var k2: [f64; 24] = [0.0; 24]
    vt_cf(&dr, &dm, &!k2)
    var dm1 = circ28_drug_new()
    var dr1 = circ28_drug_new()
    ven_measured_m(&!dm1)
    ven_fit_record_m_g(&!dm1, 1)
    ven_measured_r(&!dr1)
    ven_fit_record_r_g(&!dr1, &dm1, 1)
    ven_ka_record_g(&!dr1, 1)
    var g1: [f64; 16] = [0.0; 16]
    var sc1: [f64; 4] = [0.0; 4]
    vt_gcol(&dr1, &dm1, sp[3], &!sc1, &!g1)
    fails = fails + vt_chain()
    fails = fails + vt_s0(&dr, &dm)
    fails = fails + vt_s1(&dr, &dm, &sp)
    fails = fails + vt_s2(&dr, &dm, &k2, &!keep)
    fails = fails + vt_s3a(&dr, &dm, &!keep)
    fails = fails + vt_s3b(&dr, &dm, &!k2)
    fails = fails + vt_s3v(&keep, &k2)
    fails = fails + vt_s4(&k2, &keep)
    fails = fails + vt_s5(&dr, &dm, sp[3], &!keep)
    fails = fails + vt_s6(&dr, &dm, &!keep)
    fails = fails + vt_s7(ven_obs_m_cl(), ven_obs_m_fe() * ven_obs_m_cl(), k2[21], ven_r_clren(), ven_r_fa(), &sp)
    fails = fails + vt_s8()
    fails = fails + vt_s9(&dr, &dm)
    fails = fails + vt_s9b(&dr, &dm)
    fails = fails + vt_s10(&dr, &dm, &k2, &keep)
    fails = fails + vt_gut(&dr, &sc1, &g1, &keep, &k2)
    if fails == 0 { println("CIRC28_DRUG_VENLAFAXINE_PASS") } else { print("FAILS "); println(fails) }
}
