//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 center artifact with quotient/remainder witnesses

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn center_instance_fp() -> i64 {
    var fp: i64 = 251
    fp = mix(fp, 6, 3203)
    fp = mix(fp, 10, 3203)
    fp = mix(fp, 28, 3203)
    fp = mix(fp, 8, 3203)
    fp = mix(fp, 3, 3203)
    fp = mix(fp, 4294967296, 3203)
    fp = mix(fp, 42949672, 3203)
    fp = mix(fp, 96, 3203)
    fp = mix(fp, 5309941770, 3203)
    fp = mix(fp, 10058731223, 3203)
    fp = mix(fp, 4084837935, 3203)
    fp = mix(fp, 214180161, 3203)
    fp = mix(fp, 506104143, 3203)
    fp = mix(fp, 956295573, 3203)
    return fp
}

fn center_certificate_fp(instance_fp: i64, ok_mask: i64) -> i64 {
    if instance_fp != 104233294 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 257
    fp = mix(fp, instance_fp, 3217)
    fp = mix(fp, 143628214324, 3217)
    fp = mix(fp, 3606116906, 3217)
    fp = mix(fp, 12435782019, 3217)
    fp = mix(fp, 2421034086, 3217)
    fp = mix(fp, 10892901160, 3217)
    fp = mix(fp, 0, 3217)
    fp = mix(fp, 474878934, 3217)
    fp = mix(fp, 2944751696, 3217)
    fp = mix(fp, 1335694801, 3217)
    fp = mix(fp, 665264776, 3217)
    fp = mix(fp, 15428808, 3217)
    fp = mix(fp, 1052865080, 3217)
    fp = mix(fp, 5784820704, 3217)
    fp = mix(fp, 11394426024, 3217)
    fp = mix(fp, 4100266743, 3217)
    fp = mix(fp, ok_mask, 3217)
    return fp
}

fn center_artifact_fp(instance_fp: i64, certificate_fp: i64) -> i64 {
    if instance_fp != 104233294 { return 0 - 1 }
    if certificate_fp != 366755610 { return 0 - 1 }

    var fp: i64 = 263
    fp = mix(fp, instance_fp, 3229)
    fp = mix(fp, certificate_fp, 3229)
    fp = mix(fp, 214180161, 3229)
    fp = mix(fp, 23144051, 3229)
    fp = mix(fp, 561641681, 3229)
    fp = mix(fp, 506104143, 3229)
    fp = mix(fp, 956295573, 3229)
    fp = mix(fp, 1, 3229)
    fp = mix(fp, 6, 3229)
    fp = mix(fp, 5784820704, 3229)
    fp = mix(fp, 11394426024, 3229)
    fp = mix(fp, 4100266743, 3229)
    fp = mix(fp, 127, 3229)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x5: i256 = 5309941770 as i256
    let y5: i256 = 10058731223 as i256
    let z5: i256 = 4084837935 as i256

    let dx_num: i256 = (10 as i256) * (y5 - x5)
    let dy_num: i256 = x5 * ((28 as i256) * scale - z5)
    let xy_num: i256 = x5 * y5
    let beta_num_z: i256 = (8 as i256) * z5
    let dy_scaled_q: i256 = 143628214324 as i256
    let dy_scaled_r: i256 = 3606116906 as i256
    let xy_scaled_q: i256 = 12435782019 as i256
    let xy_scaled_r: i256 = 2421034086 as i256
    let beta_q: i256 = 10892901160 as i256
    let beta_r: i256 = 0 as i256
    let x_inc_q: i256 = 474878934 as i256
    let x_inc_r: i256 = 2944751696 as i256
    let y_inc_q: i256 = 1335694801 as i256
    let y_inc_r: i256 = 665264776 as i256
    let z_inc_q: i256 = 15428808 as i256
    let z_inc_r: i256 = 1052865080 as i256

    let dy: i256 = dy_scaled_q - y5
    let z_inc_num: i256 = xy_scaled_q - beta_q
    if z_inc_num != 1542880859 as i256 { return 1 }

    var ok_mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { ok_mask = ok_mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 { ok_mask = ok_mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 { ok_mask = ok_mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 { ok_mask = ok_mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { ok_mask = ok_mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { ok_mask = ok_mask + 32 }
    if check_div_witness_i256(dt * z_inc_num, scale, z_inc_q, z_inc_r) == 1 { ok_mask = ok_mask + 64 }
    if ok_mask != 127 { return 2 }

    if x5 + x_inc_q != 5784820704 as i256 { return 3 }
    if y5 + y_inc_q != 11394426024 as i256 { return 4 }
    if z5 + z_inc_q != 4100266743 as i256 { return 5 }

    let instance_fp = center_instance_fp()
    if instance_fp != 104233294 { return 6 }
    let cert_fp = center_certificate_fp(instance_fp, ok_mask)
    if cert_fp != 366755610 { return 7 }
    let artifact_fp = center_artifact_fp(instance_fp, cert_fp)
    if artifact_fp != 134624236 { return 8 }

    if check_div_witness_i256(dt * z_inc_num, scale, z_inc_q, scale) != 0 { return 9 }
    if center_certificate_fp(instance_fp, 126) != (0 - 1) { return 10 }
    return 0
}
