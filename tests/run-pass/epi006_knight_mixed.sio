//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: variance 1; iv [10, 11]

fn main() -> i64 with IO, Epistemic {
    let z = measure(10.0, uncertainty: 1.0) + knight("k", 0.0, 1.0)
    if z.variance != 1.0 { return 1 }
    if z.iv.0 != 10.0 || z.iv.1 != 11.0 { return 1 }
    println("variance 1; iv [10, 11]")
    0
}
