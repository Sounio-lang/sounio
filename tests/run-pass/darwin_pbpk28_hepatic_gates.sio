//@ run-pass
//@ expect-stdout-contains: PBPK28_HEPATIC_GATES_PASS
//@ timeout: 60

// Runtime (2026-09-27): 5.1 s on lean_single (souc-stage2 engine, this
// workspace pod, run only). CI job 108525867166 put the Full Test Suite
// runner at 2.65-4.3x slower than the pod (hepatic 11.3 s timed out at
// 30 s; calibration 42 s passed within 180 s), so the timeout is about
// 2x the worst projected CI time, 4.3 x 5.1 s.
//
// Gates V0-V2 for stdlib/darwin_pbpk/pbpk28_hepatic.sio.
//
// V0  Reduction: with k_t = 0, in_t = 0 and portal = false the new step must be
//     BIT-IDENTICAL to pbpk28_full_cn_step (all 27 active states, every step),
//     including a nonzero blood input (in_b == rel_mid).
//
// V1  Mass balance: with portal routing, liver + gut tissue sinks, a residual
//     central clearance and an input into gut tissue,
//       M(t) + E(t) = D(t)
//     to relative 1e-10, where E accumulates pbpk28_hepatic_elim_step (the same
//     trapezoid the CN scheme integrates) and D the delivered dose. A second
//     configuration with portal routing and NO elimination checks that the
//     portal transport itself conserves mass.
//
// V2  Steady state against closed form. Elimination confined to the liver tissue
//     layer with sink k = fu·CLint/K_p. At steady state, liver tissue gives
//       PS (C_v - C_t/K_p) = k C_t   =>   k C_t = X · C_v,
//       X = fu·CLint·PS / (PS + fu·CLint)           (extended clearance model;
//                                                     PS -> inf: X -> fu·CLint)
//     Every organ without a sink has C_v = C_b (IV) and every splanchnic organ
//     returns its input to the liver, so:
//       IV infusion R into blood:        q_L C_b = (q_L + X) C_v,L,  X C_v,L = R
//                                        => C_b = R / CL_H,  CL_H = q_L X/(q_L + X)
//       portal infusion R into gut tissue (gut: q_g (C_b - C_v,g) + R = 0):
//                                        q_L C_b + R = (q_L + X) C_v,L, X C_v,L = R
//                                        => C_b = R / X
//     so C_b,portal / C_b,iv = CL_H / X = q_L/(q_L + X) = F_H emerges from the
//     physiology instead of being imposed. The CN fixed point is the continuous steady state
//     exactly, so the only error is residual transient plus round-off.
//
// VR  Clamp-free TR-BDF2 step (pbpk28_hepatic_trbdf2_step_ws) with the
//     backward-Euler restart (pbpk28_hepatic_be2_step_ws) on the first step and
//     on the step after the input switches off. (a) V1's open configuration
//     (portal, liver + gut sinks, residual CL, 10 mg/h into gut tissue for
//     2 h, dt = 0.05, 48 h), elimination booked with the steps' own weights
//     (TR-BDF2 (w, w, d), restart (0, 1/2, 1/2); pbpk28_hepatic_elim_quad_ws):
//     |M + E - D|/D <= max(1e-12, n·1e-15) at every step n -- the rounding
//     budget of the closed-system witness (the 1e-12 floor at 960 steps). The
//     identity is exact in real arithmetic (derivation in the kernel's TR-BDF2
//     section). (b) V2's steady states (IV: C_b = R/CL_H; portal: C_b = R/X)
//     to 1e-9, as V2, at dt = 0.1 over V2's 100 h: TR-BDF2's fixed point is
//     the continuous steady state (A x + b = 0 makes x_γ = x and
//     x_{n+1} = x), and being L-stable it damps the stiff transient at any
//     dt, so only the horizon matters. (V2 itself keeps dt = 0.01: CN's
//     stiff modes decay only by |R| per step, so CN needs the finer step.)
//     VR ran at dt = 0.01 until 2026-09-27; coarsened for runtime. A kernel that fails closed
//     on negativity would abort the run, so completion also checks that no
//     stage went below -tol·scale.
//
// VF  Fail-closed verdict (pbpk28_step_check_code, the check every TR-BDF2 /
//     restart stage panics on). After a real restart step: the step's own
//     state -> 0; one tissue entry set to +Inf -> 2; NaN -> 2; blood set to
//     -1 (far below -tol·scale) -> 1; the scale set to +Inf -> 2. Before
//     2026-09-27 the check tested sign and NaN only, so +Inf was accepted: the
//     restart with flows 1e-300, CL = 0, V_b = 1, dt = 2, in_b = 1e308
//     returned a blood concentration of +Inf. With finiteness removed from the
//     verdict, the +Inf cases return 0 and VF fails.
//
// VC  Certificate ceiling. The fail-closed tolerance tol = 1024u(1 + dt·λ)
//     must stay <= 1e-6 (derivation in the kernel's TR-BDF2 section), i.e.
//     dt <= dt_max(λ); beyond it a step panics as not certifiable. Checked:
//     (a) pbpk28_step_certifiable is false at the reported case, rapamycin at
//     dt = 2.3e8 h (dt·λ ≈ 8.7e12, tol ≈ 0.98), and true at dt = 0.5 h;
//     (b) tol at dt_max(λ) equals the ceiling to 1e-12 relative (the formula
//     is the inverse of the tolerance); (c) every profile and sink
//     configuration the PBPK28 gates step with TR-BDF2 -- the four stock
//     profiles and V1's liver + gut sinks with portal routing -- has
//     dt_max >= 100 x 0.5 h, the largest dt any gate or production caller
//     uses on this path (printed). Without the ceiling the predicate is true
//     at 2.3e8 h and (a) fails. (d) Domain (PR #2695 review): the predicate
//     is false for dt = 0, -1, -Inf, +Inf and NaN and for lam = -1 and NaN;
//     the ceiling test alone accepted dt = -1 and dt = -Inf (tol below the
//     ceiling), and (d) fails without the domain check.
//
// The V2 parameter set is the rapamycin transport profile with CL_central = 0 and
// a synthetic hepatic CLint: a kernel-correctness fixture, not a drug claim.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::pbpk28_hepatic::*

fn g_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn e12(x: f64) -> i64 { return (x * 1000000000000.0) as i64 }

// V0 --------------------------------------------------------------------------
fn states_differ(a: PBPKState28, b: PBPKState28) -> bool with Mut {
    var i: i32 = 0
    var diff = false
    while i < 14 {
        if a.cv[i] != b.cv[i] { diff = true }
        if a.ct[i] != b.ct[i] { diff = true }
        i = i + 1
    }
    return diff
}

fn gate_v0() -> bool with Mut, Div, Panic, IO {
    let p = pbpk28_params_rapamycin()
    var s_ref = pbpk28_state_zero()
    s_ref.cv[0] = 0.01
    var s_new = s_ref
    let hep = pbpk28_hepatic_none()
    let dt = 0.01
    var step: i32 = 0
    var mismatches: i32 = 0
    while step < 3000 {
        let rel = if step < 500 { 0.2 } else { 0.0 }
        var inp = pbpk28_input_none()
        inp.in_b = rel
        s_ref = pbpk28_full_cn_step(s_ref, p, rel, dt)
        s_new = pbpk28_hepatic_cn_step(s_new, p, hep, inp, dt)
        if states_differ(s_ref, s_new) { mismatches = mismatches + 1 }
        step = step + 1
    }
    print("V0 steps with any bit difference = ")
    println(mismatches)
    return mismatches == 0
}

// V1 --------------------------------------------------------------------------
fn mass_balance_max_rel(p: PBPKParams28, hep: PBPK28Hepatic, gut_rate: f64, t_input: f64, t_end: f64, dt: f64) -> f64 with Mut, Div, Panic {
    var s = pbpk28_state_zero()
    var dose = 0.0
    var elim = 0.0
    var worst = 0.0
    var t = 0.0
    while t < t_end - 0.5 * dt {
        var inp = pbpk28_input_none()
        if t < t_input - 0.5 * dt { inp.in_t[8] = gut_rate }
        let s_next = pbpk28_hepatic_cn_step(s, p, hep, inp, dt)
        dose = dose + dt * pbpk28_input_rate(inp)
        elim = elim + pbpk28_hepatic_elim_step(s, s_next, p, hep, dt)
        s = s_next
        let m = pbpk28_total_mass(s, p)
        if dose > 0.0 {
            let rel = g_abs(m + elim - dose) / dose
            // NaN-propagating max: `rel > worst` is false for NaN and would let a
            // blown-up run report a tiny error.
            if !(rel <= worst) { worst = rel }
        }
        t = t + dt
    }
    return worst
}

fn gate_v1() -> bool with Mut, Div, Panic, IO {
    var p = pbpk28_params_rapamycin()
    p.cl_central = 2.0
    var hep = pbpk28_hepatic_none()
    hep.portal = true
    hep.k_t[1] = pbpk28_sink_from_clint(500.0, 0.1, p.kp[1])
    hep.k_t[8] = pbpk28_sink_from_clint(30.0, 1.0, p.kp[8])
    let worst_sink = mass_balance_max_rel(p, hep, 10.0, 2.0, 48.0, 0.01)

    var p0 = pbpk28_params_rapamycin()
    p0.cl_central = 0.0
    var hep0 = pbpk28_hepatic_none()
    hep0.portal = true
    let worst_closed = mass_balance_max_rel(p0, hep0, 10.0, 2.0, 48.0, 0.01)

    print("V1 max |M+E-D|/D with sinks (x1e12) = ")
    println(e12(worst_sink))
    print("V1 max |M+E-D|/D portal, no elimination (x1e12) = ")
    println(e12(worst_closed))
    return worst_sink < 1.0e-10 && worst_closed < 1.0e-10
}

// V2 --------------------------------------------------------------------------
// Runs a constant infusion to steady state; returns (C_b at t_end, C_b 1 h before).
fn steady_blood(p: PBPKParams28, hep: PBPK28Hepatic, into_gut: bool, rate: f64, t_end: f64, dt: f64) -> (f64, f64) with Mut, Div, Panic {
    var s = pbpk28_state_zero()
    var inp = pbpk28_input_none()
    if into_gut { inp.in_t[8] = rate } else { inp.in_b = rate }
    var t = 0.0
    var cb_prev = 0.0
    while t < t_end - 0.5 * dt {
        s = pbpk28_hepatic_cn_step(s, p, hep, inp, dt)
        t = t + dt
        if t < t_end - 1.0 + 0.5 * dt && t > t_end - 1.0 - 0.5 * dt { cb_prev = s.cv[0] }
    }
    return (s.cv[0], cb_prev)
}

fn gate_v2() -> bool with Mut, Div, Panic, IO {
    var p = pbpk28_params_rapamycin()
    p.cl_central = 0.0
    let clint = 200.0
    let fu = 0.1
    var hep = pbpk28_hepatic_none()
    hep.portal = true
    hep.k_t[1] = pbpk28_sink_from_clint(clint, fu, p.kp[1])

    let x = pbpk28_ecm_x(clint, fu, p.ps[1])
    let clh = pbpk28_ecm_clh(p.q[1], x)
    let fh = pbpk28_ecm_fh(p.q[1], x)
    let rate = 1.0

    let (cb_iv, cb_iv_prev) = steady_blood(p, hep, false, rate, 100.0, 0.01)
    let (cb_po, cb_po_prev) = steady_blood(p, hep, true, rate, 100.0, 0.01)

    let err_iv = g_abs(cb_iv - rate / clh) / (rate / clh)
    let err_po = g_abs(cb_po - rate / x) / (rate / x)
    let fh_emergent = cb_po / cb_iv
    let err_fh = g_abs(fh_emergent - fh) / fh
    let drift = g_abs(cb_iv - cb_iv_prev) / cb_iv + g_abs(cb_po - cb_po_prev) / cb_po

    print("V2 X (L/h) = ") println(x)
    print("V2 CL_H (L/h) = ") println(clh)
    print("V2 F_H closed form = ") println(fh)
    print("V2 F_H emergent C_b,portal/C_b,iv = ") println(fh_emergent)
    print("V2 rel err IV C_b (x1e12) = ") println(e12(err_iv))
    print("V2 rel err portal C_b (x1e12) = ") println(e12(err_po))
    print("V2 rel err F_H (x1e12) = ") println(e12(err_fh))
    print("V2 last-hour drift (x1e12) = ") println(e12(drift))

    // Same liver sink WITHOUT portal routing: the sink now goes through the main
    // organ loop instead of the liver-portal block, and with every organ drawing
    // from blood the IV steady state is again C_b = R / CL_H.
    var hep_np = pbpk28_hepatic_none()
    hep_np.k_t[1] = hep.k_t[1]
    let (cb_np, cb_np_prev) = steady_blood(p, hep_np, false, rate, 100.0, 0.01)
    let err_np = g_abs(cb_np - rate / clh) / (rate / clh)
    let drift_np = g_abs(cb_np - cb_np_prev) / cb_np
    print("V2 rel err IV C_b, no portal (x1e12) = ") println(e12(err_np))
    print("V2 last-hour drift, no portal (x1e12) = ") println(e12(drift_np))

    return err_iv < 1.0e-9 && err_po < 1.0e-9 && err_fh < 1.0e-9 && drift < 1.0e-9 && err_np < 1.0e-9 && drift_np < 1.0e-9
}

// VT --------------------------------------------------------------------------
// θ-scheme: θ = 1/2 must agree with the CN step to round-off (same mathematics,
// different expression shapes) in EVERY active coordinate (C_v of all organs,
// C_t of organs 1..13; max deviation over the state scale, 1e-12); θ = 1
// (backward Euler) must conserve mass exactly
// after an IV bolus at a coarse dt, where CN + clamp does not.
fn gate_vt() -> bool with Mut, Div, Panic, IO {
    var p = pbpk28_params_rapamycin()
    p.cl_central = 2.0
    var hep = pbpk28_hepatic_none()
    hep.portal = true
    hep.k_t[1] = pbpk28_sink_from_clint(500.0, 0.1, p.kp[1])
    hep.k_t[8] = pbpk28_sink_from_clint(30.0, 1.0, p.kp[8])

    var s_cn = pbpk28_state_zero()
    var s_th = pbpk28_state_zero()
    var worst_dev = 0.0
    var step: i32 = 0
    while step < 2000 {
        var inp = pbpk28_input_none()
        if step < 200 { inp.in_t[8] = 10.0 }
        s_cn = pbpk28_hepatic_cn_step(s_cn, p, hep, inp, 0.01)
        s_th = pbpk28_hepatic_theta_step(s_th, p, hep, inp, 0.01, 0.5)
        // Every active coordinate (C_v of all 14 organs, C_t of organs 1..13),
        // normalised by the largest entry of the CN state at this step: a
        // per-coordinate relative error would blow up on entries still ~0.
        var scale = 0.0
        var dmax = 0.0
        var o: i32 = 0
        while o < 14 {
            if g_abs(s_cn.cv[o]) > scale { scale = g_abs(s_cn.cv[o]) }
            let dv = g_abs(s_cn.cv[o] - s_th.cv[o])
            if !(dv <= dmax) { dmax = dv }
            if o > 0 {
                if g_abs(s_cn.ct[o]) > scale { scale = g_abs(s_cn.ct[o]) }
                let dt_o = g_abs(s_cn.ct[o] - s_th.ct[o])
                if !(dt_o <= dmax) { dmax = dt_o }
            }
            o = o + 1
        }
        let d = dmax / (scale + 1.0e-300)
        if !(d <= worst_dev) { worst_dev = d }
        step = step + 1
    }

    var s = pbpk28_state_zero()
    s.cv[0] = 10.0 / p.v_ref[0]
    var elim = 0.0
    var worst_mb = 0.0
    step = 0
    while step < 1200 {
        let s1 = pbpk28_hepatic_theta_step(s, p, hep, pbpk28_input_none(), 0.02, 1.0)
        elim = elim + pbpk28_hepatic_elim_step_theta(s, s1, p, hep, 0.02, 1.0)
        s = s1
        let r = g_abs(pbpk28_total_mass(s, p) + elim - 10.0) / 10.0
        if !(r <= worst_mb) { worst_mb = r }
        step = step + 1
    }
    print("VT theta=1/2 vs CN max rel dev (x1e12) = ") println(e12(worst_dev))
    print("VT backward Euler, 10 mg bolus, dt=0.02: max mass residual (x1e12) = ") println(e12(worst_mb))
    return worst_dev < 1.0e-12 && worst_mb < 1.0e-12
}

// VR --------------------------------------------------------------------------
fn vr_mass_tol(n: i32) -> f64 {
    let t = (n as f64) * 1.0e-15
    if t > 1.0e-12 { return t }
    return 1.0e-12
}

// Worst (|M + E - D|/D) / vr_mass_tol(n); restart on step 0 and when the
// input switches off. Returns (worst ratio, blood C at t_end, 1 h before).
fn vr_run(p: PBPKParams28, hep: PBPK28Hepatic, into_gut: bool, rate: f64, t_input: f64, t_end: f64, dt: f64) -> (f64, f64, f64) with Mut, Div, Panic {
    var s = pbpk28_state_zero()
    var ws = pbpk28_work_new()
    let w = pbpk28_trbdf2_w()
    let d = pbpk28_trbdf2_d()
    let n = ((t_end / dt) + 0.5) as i32
    let n_in = ((t_input / dt) + 0.5) as i32
    let n_prev = ((t_end - 1.0) / dt + 0.5) as i32
    var dose = 0.0
    var elim = 0.0
    var worst = 0.0
    var cb_prev = 0.0
    var k: i32 = 0
    while k < n {
        var inp = pbpk28_input_none()
        if k < n_in {
            if into_gut { inp.in_t[8] = rate } else { inp.in_b = rate }
        }
        let restart = k == 0 || k == n_in
        if restart {
            pbpk28_hepatic_be2_step_ws(&!s, p, hep, inp, dt, &!ws)
            elim = elim + pbpk28_hepatic_elim_quad_ws(&s, &ws, p.cl_central, &hep, dt, 0.0, 0.5, 0.5)
        } else {
            pbpk28_hepatic_trbdf2_step_ws(&!s, p, hep, inp, dt, &!ws)
            elim = elim + pbpk28_hepatic_elim_quad_ws(&s, &ws, p.cl_central, &hep, dt, w, w, d)
        }
        dose = dose + dt * pbpk28_input_rate(inp)
        if dose > 0.0 {
            let r = g_abs(pbpk28_total_mass(s, p) + elim - dose) / dose / vr_mass_tol(k + 1)
            if !(r <= worst) { worst = r }
        }
        if k + 1 == n_prev { cb_prev = s.cv[0] }
        k = k + 1
    }
    return (worst, s.cv[0], cb_prev)
}

fn gate_vr() -> bool with Mut, Div, Panic, IO {
    var p = pbpk28_params_rapamycin()
    p.cl_central = 2.0
    var hep = pbpk28_hepatic_none()
    hep.portal = true
    hep.k_t[1] = pbpk28_sink_from_clint(500.0, 0.1, p.kp[1])
    hep.k_t[8] = pbpk28_sink_from_clint(30.0, 1.0, p.kp[8])
    let (mb, _cb1, _cb1p) = vr_run(p, hep, true, 10.0, 2.0, 48.0, 0.05)
    print("VR TR-BDF2 open system: worst |M+E-D|/D over its bound = ") println(mb)

    var p2 = pbpk28_params_rapamycin()
    p2.cl_central = 0.0
    let clint = 200.0
    let fu = 0.1
    var hep2 = pbpk28_hepatic_none()
    hep2.portal = true
    hep2.k_t[1] = pbpk28_sink_from_clint(clint, fu, p2.kp[1])
    let x = pbpk28_ecm_x(clint, fu, p2.ps[1])
    let clh = pbpk28_ecm_clh(p2.q[1], x)
    let (_m_iv, cb_iv, cb_iv_prev) = vr_run(p2, hep2, false, 1.0, 1000.0, 100.0, 0.1)
    let (_m_po, cb_po, cb_po_prev) = vr_run(p2, hep2, true, 1.0, 1000.0, 100.0, 0.1)
    let err_iv = g_abs(cb_iv - 1.0 / clh) * clh
    let err_po = g_abs(cb_po - 1.0 / x) * x
    let drift = g_abs(cb_iv - cb_iv_prev) / cb_iv + g_abs(cb_po - cb_po_prev) / cb_po
    print("VR TR-BDF2 steady state rel err IV, portal (x1e12) = ") print(e12(err_iv)) print("  ") println(e12(err_po))
    print("VR last-hour drift (x1e12) = ") println(e12(drift))
    return mb <= 1.0 && err_iv < 1.0e-9 && err_po < 1.0e-9 && drift < 1.0e-9
}

// VF --------------------------------------------------------------------------
fn gate_vf() -> bool with Mut, Div, Panic, IO {
    let p = pbpk28_params_rapamycin()
    var ws = pbpk28_work_new()
    var s = pbpk28_state_zero()
    s.cv[0] = 1.0
    pbpk28_hepatic_be2_step_ws(&!s, p, pbpk28_hepatic_none(), pbpk28_input_none(), 0.1, &!ws)
    let ok0 = pbpk28_step_check_code(&s, &ws)
    let keep = s.ct[5]
    s.ct[5] = 1.0e308 * 10.0
    let c_inf = pbpk28_step_check_code(&s, &ws)
    s.ct[5] = 0.0 * (1.0e308 * 10.0)
    let c_nan = pbpk28_step_check_code(&s, &ws)
    s.ct[5] = keep
    let keep_b = s.cv[0]
    s.cv[0] = 0.0 - 1.0
    let c_neg = pbpk28_step_check_code(&s, &ws)
    s.cv[0] = keep_b
    ws.scale = 1.0e308 * 10.0
    let c_sinf = pbpk28_step_check_code(&s, &ws)
    print("VF verdicts: valid, +Inf entry, NaN entry, -1 entry, +Inf scale = ")
    print(ok0) print(" ") print(c_inf) print(" ") print(c_nan) print(" ") print(c_neg) print(" ") println(c_sinf)
    return ok0 == 0 && c_inf == 2 && c_nan == 2 && c_neg == 1 && c_sinf == 2
}

// VC --------------------------------------------------------------------------
fn gate_vc() -> bool with Mut, Div, Panic, IO {
    let pr = pbpk28_params_rapamycin()
    let none = pbpk28_hepatic_none()
    let lam_r = pbpk28_lambda_max(pr, none)
    let a_ok = !pbpk28_step_certifiable(2.3e8, lam_r) && pbpk28_step_certifiable(0.5, lam_r)
    let inf = 1.0e308 * 10.0
    let nan = 0.0 * inf
    let d_bad = pbpk28_step_certifiable(0.0, lam_r) || pbpk28_step_certifiable(0.0 - 1.0, lam_r) || pbpk28_step_certifiable(0.0 - inf, lam_r) || pbpk28_step_certifiable(inf, lam_r) || pbpk28_step_certifiable(nan, lam_r) || pbpk28_step_certifiable(0.5, 0.0 - 1.0) || pbpk28_step_certifiable(0.5, nan)
    print("VC domain: any invalid dt or lambda certified = ") println(d_bad)
    let dm = pbpk28_dt_max(lam_r)
    let b_rel = g_abs(pbpk28_step_tol(dm, lam_r) - pbpk28_tol_ceiling()) / pbpk28_tol_ceiling()
    print("VC rapamycin lambda (1/h) = ") print(lam_r) print("  dt_max (h) = ") print(dm)
    print("  tol at 2.3e8 h = ") print(pbpk28_step_tol(2.3e8, lam_r)) print("  certifiable at 2.3e8, 0.5 h: ")
    print(pbpk28_step_certifiable(2.3e8, lam_r)) print(" ") println(pbpk28_step_certifiable(0.5, lam_r))
    var hep = pbpk28_hepatic_none()
    hep.portal = true
    hep.k_t[1] = pbpk28_sink_from_clint(500.0, 0.1, pr.kp[1])
    hep.k_t[8] = pbpk28_sink_from_clint(30.0, 1.0, pr.kp[8])
    let d1 = pbpk28_dt_max(lam_r)
    let d2 = pbpk28_dt_max(pbpk28_lambda_max(pbpk28_params_venlafaxine_parent(), none))
    let d3 = pbpk28_dt_max(pbpk28_lambda_max(pbpk28_params_venlafaxine_odv(), none))
    let d4 = pbpk28_dt_max(pbpk28_lambda_max(pbpk28_params_semaglutide(), none))
    let d5 = pbpk28_dt_max(pbpk28_lambda_max(pr, hep))
    print("VC dt_max (h): rapamycin ") print(d1) print(", venlafaxine ") print(d2) print(", ODV ") print(d3)
    print(", semaglutide ") print(d4) print(", rapamycin + V1 sinks ") println(d5)
    var c_min = d1
    if d2 < c_min { c_min = d2 }
    if d3 < c_min { c_min = d3 }
    if d4 < c_min { c_min = d4 }
    if d5 < c_min { c_min = d5 }
    return a_ok && !d_bad && b_rel < 1.0e-12 && c_min >= 50.0
}

fn main() -> i32 with Mut, Div, Panic, IO {
    let v0 = gate_v0()
    let v1 = gate_v1()
    let v2 = gate_v2()
    let vt = gate_vt()
    let vr = gate_vr()
    let vf = gate_vf()
    let vc = gate_vc()
    if v0 { println("V0 PASS") } else { println("V0 FAIL") }
    if v1 { println("V1 PASS") } else { println("V1 FAIL") }
    if v2 { println("V2 PASS") } else { println("V2 FAIL") }
    if vt { println("VT PASS") } else { println("VT FAIL") }
    if vr { println("VR PASS") } else { println("VR FAIL") }
    if vf { println("VF PASS") } else { println("VF FAIL") }
    if vc { println("VC PASS") } else { println("VC FAIL") }
    if v0 && v1 && v2 && vt && vr && vf && vc {
        println("PBPK28_HEPATIC_GATES_PASS")
        return 0
    }
    return 1
}
