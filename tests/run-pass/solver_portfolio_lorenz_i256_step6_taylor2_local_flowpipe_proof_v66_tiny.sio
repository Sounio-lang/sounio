    receipt_fp = mix(receipt_fp, 526492507, 4519)
    receipt_fp = mix(receipt_fp, 274272622, 4519)
    receipt_fp = mix(receipt_fp, 120531857, 4519)
    receipt_fp = mix(receipt_fp, 662934823, 4519)
    receipt_fp = mix(receipt_fp, 6, 4519)
    receipt_fp = mix(receipt_fp, 16, 4519)
    receipt_fp = mix(receipt_fp, 255, 4519)
    if receipt_fp != 323633258 { return 1 }

    var audit_fp: i64 = 907
    audit_fp = mix(audit_fp, receipt_fp, 4523)
    audit_fp = mix(audit_fp, 813941448, 4523)
    audit_fp = mix(audit_fp, 693709162, 4523)
    audit_fp = mix(audit_fp, 732204468, 4523)
    audit_fp = mix(audit_fp, 410079786, 4523)
    audit_fp = mix(audit_fp, 270619908, 4523)
    audit_fp = mix(audit_fp, 648925166, 4523)
    audit_fp = mix(audit_fp, 91311098, 4523)
    audit_fp = mix(audit_fp, 4135036, 4523)
    audit_fp = mix(audit_fp, 118962929, 4523)
    audit_fp = mix(audit_fp, 79381760, 4523)
    audit_fp = mix(audit_fp, 882801596, 4523)
    audit_fp = mix(audit_fp, 961618971, 4523)
    audit_fp = mix(audit_fp, 40625512, 4523)
    audit_fp = mix(audit_fp, 853998860, 4523)
    audit_fp = mix(audit_fp, 449901436, 4523)
    audit_fp = mix(audit_fp, 6, 4523)
    audit_fp = mix(audit_fp, 16, 4523)
    audit_fp = mix(audit_fp, 255, 4523)
    if audit_fp != 321037062 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 69, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 69, 1103)
    if entry_fp != 45315189 { return 3 }

    let manifest_fp: i64 = 525173872
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 66, 1871)
    result_fp = mix(result_fp, 70, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 58, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 923952329 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 66, 1907)
    family_fp = mix(family_fp, 70, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 53, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 579793849 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 66, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 907656427 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 66, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 703795364 { return 7 }

    var readiness_fp: i64 = 163
