//@ run-pass
//@ description: Tiny portfolio v66 smoke for Lorenz i256 step-6 Taylor-2 local flowpipe proof

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 887
    receipt_fp = mix(receipt_fp, 813941448, 4519)
    receipt_fp = mix(receipt_fp, 693709162, 4519)
    receipt_fp = mix(receipt_fp, 713556137, 4519)
    receipt_fp = mix(receipt_fp, 890903826, 4519)
