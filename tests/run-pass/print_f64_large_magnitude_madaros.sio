//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: 10000000000000000000.000000
//@ expect-stdout-contains: 1000000000000000019884624838656.000000
//@ expect-stdout-contains: 18446744073709551616.000000
//@ expect-stdout-contains: 10000000000000000159028911097599180468360808563945281389781327557747838772170381060813469985856815104.000000
//@ expect-stdout-contains: .000000
//@ expect-stdout-contains: 9223372036854777856.000000
//@ expect-stdout-contains: -10000000000000000000.000000
//@ expect-stdout-contains: -1000000000000000019884624838656.000000
//@ expect-stdout-contains: 9200000000000000000.000000
//@ expect-stdout-contains: 123456789012.500000
//@ expect-stdout-contains: 300000000549775575777803994281145270272.000000
// SIO-396 witness: println of an f64 with |x| >= 2^63 printed 9223372036854775808.000000
// (the cvttsd2si "indefinite" value) instead of the value. Expected lines are the exact
// decimal expansion C++23 prints for the same doubles (printf("%f") / std::format("{:f}")).
// Madaros only: lean_single prints these in exponent form (1.000000e19), which is a
// different, not wrong, rendering; see changelog.d/print-f64-large-magnitude.fixed.md.
fn main() -> i32 with IO {
    println(1.0e19)
    println(1.0e30)
    println(18446744073709551616.0)
    println(1.0e100)
    println(1.7976931348623157e308)
    println(9223372036854777856.0)
    println(-1.0e19)
    println(-1.0e30)
    println(9.2e18)
    println(123456789012.5)
    let big: f32 = 3.0e38
    println(big)
    0
}
