//@ run-pass

use graphics::drawing::{color_black, color_red}
use graphics::surface::{surface_new, surface_clear, surface_set_pixel}
use graphics::export::{export_ppm}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(2, 2)
    s = surface_clear(s, color_black())
    s = surface_set_pixel(s, 1, 0, color_red())
    export_ppm(&s)
    0
}
