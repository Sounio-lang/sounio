//@ run-pass
//@ expect-stdout-contains: INVARIANT 1: PASS
//@ expect-stdout-contains: INVARIANT 2: PASS
//@ expect-stdout-contains: INVARIANT 3: PASS
//@ expect-stdout-contains: INVARIANT 4: PASS
//@ expect-stdout-contains: INVARIANT 5: PASS
//@ expect-stdout-contains: INVARIANT 6: PASS
//@ expect-stdout-contains: INVARIANT 7: PASS
//@ expect-stdout-contains: INVARIANT 8: PASS
//@ expect-stdout-contains: INVARIANT 9: PASS
//@ expect-stdout-contains: INVARIANT 10: PASS
//@ expect-stdout-contains: PASS,
//! tests/run-pass/invariant_tests.sio
//!
//! Property-based invariant tests for the cybernetic module suite.
//! Each invariant is tested with multiple inputs and must ALWAYS hold.

use cybernetic::observer::{
    Observer, Observation, observer_new, observer_with_budget,
    make_observation, blind_spot, precision_remaining
}
use cybernetic::coupling::{
    Coupling, coupling_new, couple_step, congruence
}
use cybernetic::conversation::{
    Conversation, conversation_new, set_models, converse, agreement,
    has_converged
}
use cybernetic::variety::{
    VarietySystem, variety_new, record_env_state, record_reg_state,
    record_outcome, compute_variety
}
use cybernetic::autopoiesis::{
    AutopoieticSystem, system_new, add_component, produce_cycle,
    deactivate_component, is_alive
}
use cybernetic::eigenform::{
    EigenformResult, find_eigenform
}
use cybernetic::languaging::{
    LanguagingPair, languaging_new, languaging_step, domain_size
}
use cybernetic::distinction::{
    UNMARKED, MARKED, AUTONOMOUS,
    Form, form_void, form_marked, form_reenter,
    form_mark, form_cross, eval_form, form_pair, form_contain
}
use cybernetic::bateson::{
    LearningContext, LearningEvent, bateson_new, learn
}

// ============================================================================
// Helpers (must be at module level, not inside main)
// ============================================================================

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

// Eigenform operators (need to be top-level for fn ref)
fn op_avg(x: f64) -> f64 { (x + 20.0) / 2.0 }
fn op_100(x: f64) -> f64 { (x + 100.0) / 2.0 }
fn op_shrink(x: f64) -> f64 { x * 0.5 }

fn valid_eval(v: i64) -> bool {
    v == 0 || v == 1 || v == 2
}

// ============================================================================
// MAIN
// ============================================================================

fn main() with IO, Mut, Div, Panic {
    println("========================================================")
    println("  INVARIANT TESTS: Property-based cybernetic validation")
    println("========================================================")
    println("")

    var pass_count: i64 = 0
    var fail_count: i64 = 0

    // ========================================================================
    // INVARIANT 1: Observer variance is monotonically non-decreasing
    // ========================================================================
    println("Testing INVARIANT 1: Observer variance is monotonically non-decreasing")
    var inv1_ok = true
    var obs1 = observer_new(1, 0.01)
    var prev_var: f64 = 0.0
    var i: i64 = 0
    while i < 50 {
        let r = make_observation(obs1, 42.0, 0.5)
        obs1 = r.observer
        if r.variance < prev_var {
            inv1_ok = false
        }
        prev_var = r.variance
        i = i + 1
    }
    // Also test with different drift rates
    var obs1b = observer_new(2, 0.05)
    prev_var = 0.0
    i = 0
    while i < 30 {
        let r = make_observation(obs1b, 100.0, 1.0)
        obs1b = r.observer
        if r.variance < prev_var {
            inv1_ok = false
        }
        prev_var = r.variance
        i = i + 1
    }
    // Third test: zero drift rate
    var obs1c = observer_new(3, 0.0)
    prev_var = 0.0
    i = 0
    while i < 20 {
        let r = make_observation(obs1c, 0.0, 0.1)
        obs1c = r.observer
        if r.variance < prev_var - 0.0001 {
            inv1_ok = false
        }
        prev_var = r.variance
        i = i + 1
    }
    if inv1_ok { println("  INVARIANT 1: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 1: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 2: Congruence is always in [0, 1]
    // ========================================================================
    println("Testing INVARIANT 2: Congruence is always in [0, 1]")
    var inv2_ok = true
    var c2 = coupling_new(1, 2)
    // Negative values
    c2 = couple_step(c2, -100.0, -200.0)
    var cong2 = congruence(c2)
    if cong2 < 0.0 || cong2 > 1.0 { inv2_ok = false }
    // Zero values
    c2 = couple_step(c2, 0.0, 0.0)
    cong2 = congruence(c2)
    if cong2 < 0.0 || cong2 > 1.0 { inv2_ok = false }
    // Large values
    c2 = couple_step(c2, 999999.0, 999999.0)
    cong2 = congruence(c2)
    if cong2 < 0.0 || cong2 > 1.0 { inv2_ok = false }
    // Mixed sign
    c2 = couple_step(c2, -50.0, 50.0)
    cong2 = congruence(c2)
    if cong2 < 0.0 || cong2 > 1.0 { inv2_ok = false }
    // Tiny values
    c2 = couple_step(c2, 0.0001, 0.0002)
    cong2 = congruence(c2)
    if cong2 < 0.0 || cong2 > 1.0 { inv2_ok = false }
    // Run many steps with diverging values
    i = 0
    while i < 30 {
        let a_val = (i as f64) * 3.0 - 45.0
        let b_val = 0.0 - (i as f64) * 2.0 + 30.0
        c2 = couple_step(c2, a_val, b_val)
        cong2 = congruence(c2)
        if cong2 < 0.0 || cong2 > 1.0 { inv2_ok = false }
        i = i + 1
    }
    if inv2_ok { println("  INVARIANT 2: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 2: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 3: Agreement is always bounded after conversation
    // ========================================================================
    println("Testing INVARIANT 3: Agreement is bounded after conversation")
    var inv3_ok = true
    // Extreme starting values
    var conv3 = conversation_new(1, 2, 42)
    conv3 = set_models(conv3, 1000.0, 0.1, -1000.0, 0.1)
    i = 0
    while i < 100 {
        conv3 = converse(conv3)
        let agr = agreement(conv3)
        if agr < -1.1 || agr > 1.1 {
            inv3_ok = false
        }
        i = i + 1
    }
    // Test with zero values
    var conv3b = conversation_new(3, 4, 43)
    conv3b = set_models(conv3b, 0.0, 1.0, 0.0, 1.0)
    i = 0
    while i < 50 {
        conv3b = converse(conv3b)
        let agr = agreement(conv3b)
        if agr < -1.1 || agr > 1.1 {
            inv3_ok = false
        }
        i = i + 1
    }
    // Test with same starting values
    var conv3c = conversation_new(5, 6, 44)
    conv3c = set_models(conv3c, 50.0, 1.0, 50.0, 1.0)
    i = 0
    while i < 30 {
        conv3c = converse(conv3c)
        let agr = agreement(conv3c)
        if agr < -1.1 || agr > 1.1 {
            inv3_ok = false
        }
        i = i + 1
    }
    if inv3_ok { println("  INVARIANT 3: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 3: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 4: Variety is always >= 0
    // ========================================================================
    println("Testing INVARIANT 4: Variety (entropy) is always >= 0")
    var inv4_ok = true
    // Case 1: uniform distribution
    var vs4 = variety_new()
    i = 0
    while i < 100 {
        vs4 = record_env_state(vs4, i % 10)
        vs4 = record_reg_state(vs4, i % 5)
        vs4 = record_outcome(vs4, i % 3)
        i = i + 1
    }
    vs4 = compute_variety(vs4)
    if vs4.env_variety < 0.0 { inv4_ok = false }
    if vs4.env_entropy < 0.0 { inv4_ok = false }
    if vs4.reg_variety < 0.0 { inv4_ok = false }
    if vs4.reg_entropy < 0.0 { inv4_ok = false }

    // Case 2: single state (degenerate)
    var vs4b = variety_new()
    i = 0
    while i < 50 {
        vs4b = record_env_state(vs4b, 0)
        vs4b = record_reg_state(vs4b, 0)
        vs4b = record_outcome(vs4b, 0)
        i = i + 1
    }
    vs4b = compute_variety(vs4b)
    if vs4b.env_entropy < -0.001 { inv4_ok = false }

    // Case 3: all distinct states
    var vs4c = variety_new()
    i = 0
    while i < 32 {
        vs4c = record_env_state(vs4c, i)
        i = i + 1
    }
    vs4c = compute_variety(vs4c)
    if vs4c.env_variety < 0.0 { inv4_ok = false }
    if inv4_ok { println("  INVARIANT 4: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 4: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 5: Autopoietic closure is monotone-down on deactivation
    // ========================================================================
    println("Testing INVARIANT 5: Once dead, stays dead on further deactivation")
    var inv5_ok = true
    // Create a 3-component circular system
    var sys5 = system_new(0.5)
    sys5 = add_component(sys5, -1, 1, 10.0, 0.1)
    sys5 = add_component(sys5, 0, 2, 5.0, 0.1)
    sys5 = add_component(sys5, 1, 0, 8.0, 0.1)

    // Deactivate component 1 -- breaks cycle
    sys5 = deactivate_component(sys5, 1)
    let alive_after_1 = is_alive(sys5)

    // Deactivate component 2 -- should remain dead (or also die)
    sys5 = deactivate_component(sys5, 2)
    let alive_after_2 = is_alive(sys5)

    // If it was dead after removing 1, it must stay dead after removing 2
    if !alive_after_1 {
        if alive_after_2 {
            inv5_ok = false
        }
    }

    // Also test: deactivate all
    sys5 = deactivate_component(sys5, 0)
    if is_alive(sys5) && !alive_after_2 {
        inv5_ok = false
    }

    // Second system: deactivate in reverse order
    var sys5b = system_new(0.5)
    sys5b = add_component(sys5b, -1, 1, 1.0, 0.1)
    sys5b = add_component(sys5b, 0, 2, 2.0, 0.1)
    sys5b = add_component(sys5b, 1, 0, 3.0, 0.1)
    sys5b = deactivate_component(sys5b, 2)
    let dead_5b = !is_alive(sys5b)
    sys5b = deactivate_component(sys5b, 0)
    if dead_5b && is_alive(sys5b) {
        inv5_ok = false
    }
    if inv5_ok { println("  INVARIANT 5: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 5: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 6: Eigenform convergence implies |Op(x*) - x*| < tolerance
    // ========================================================================
    println("Testing INVARIANT 6: Eigenform residual < tolerance when converged")
    var inv6_ok = true

    // Operator 1: averaging toward 20
    let ef1 = find_eigenform(op_avg, 0.0, 0.001, 200)
    if ef1.converged {
        let residual = abs_f(op_avg(ef1.value) - ef1.value)
        if residual >= 0.01 {
            inv6_ok = false
        }
    }

    // Operator 2: averaging toward 100
    let ef2 = find_eigenform(op_100, 0.0, 0.001, 200)
    if ef2.converged {
        let residual = abs_f(op_100(ef2.value) - ef2.value)
        if residual >= 0.01 {
            inv6_ok = false
        }
    }

    // Operator 3: scaling toward 0
    let ef3 = find_eigenform(op_shrink, 100.0, 0.001, 200)
    if ef3.converged {
        let residual = abs_f(op_shrink(ef3.value) - ef3.value)
        if residual >= 0.01 {
            inv6_ok = false
        }
    }
    if inv6_ok { println("  INVARIANT 6: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 6: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 7: Domain size is always in [0, num_actions]
    // ========================================================================
    println("Testing INVARIANT 7: Domain size in [0, num_actions]")
    var inv7_ok = true

    // Test with 4 actions
    var pair7 = languaging_new(4)
    i = 0
    while i < 30 {
        pair7 = languaging_step(pair7, i % 4, i % 4)
        let ds = domain_size(pair7)
        if ds < 0 || ds > 4 {
            inv7_ok = false
        }
        i = i + 1
    }

    // Test with 8 actions
    var pair7b = languaging_new(8)
    i = 0
    while i < 40 {
        pair7b = languaging_step(pair7b, i % 8, (i + 1) % 8)
        let ds = domain_size(pair7b)
        if ds < 0 || ds > 8 {
            inv7_ok = false
        }
        i = i + 1
    }

    // Test with 1 action
    var pair7c = languaging_new(1)
    i = 0
    while i < 10 {
        pair7c = languaging_step(pair7c, 0, 0)
        let ds = domain_size(pair7c)
        if ds < 0 || ds > 1 {
            inv7_ok = false
        }
        i = i + 1
    }
    if inv7_ok { println("  INVARIANT 7: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 7: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 8: Shannon entropy is always >= 0
    // ========================================================================
    println("Testing INVARIANT 8: Shannon entropy >= 0 for all distributions")
    var inv8_ok = true

    // Case 1: highly skewed
    var vs8 = variety_new()
    vs8 = record_env_state(vs8, 0)
    vs8 = record_env_state(vs8, 0)
    vs8 = record_env_state(vs8, 0)
    vs8 = record_env_state(vs8, 1)
    vs8 = compute_variety(vs8)
    if vs8.env_entropy < -0.001 { inv8_ok = false }

    // Case 2: perfectly uniform over 4 states
    var vs8b = variety_new()
    i = 0
    while i < 40 {
        vs8b = record_env_state(vs8b, i % 4)
        i = i + 1
    }
    vs8b = compute_variety(vs8b)
    if vs8b.env_entropy < -0.001 { inv8_ok = false }

    // Case 3: single state (entropy should be 0 or very close)
    var vs8c = variety_new()
    i = 0
    while i < 20 {
        vs8c = record_env_state(vs8c, 5)
        i = i + 1
    }
    vs8c = compute_variety(vs8c)
    if vs8c.env_entropy < -0.001 { inv8_ok = false }
    // Single state entropy should be 0
    if vs8c.env_entropy > 0.01 { inv8_ok = false }
    if inv8_ok { println("  INVARIANT 8: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 8: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 9: Distinction eval is always in {UNMARKED, MARKED, AUTONOMOUS}
    // ========================================================================
    println("Testing INVARIANT 9: Distinction eval always in valid set")
    var inv9_ok = true

    // void
    let v9a = eval_form(form_void())
    if !valid_eval(v9a) { inv9_ok = false }

    // marked
    let v9b = eval_form(form_marked())
    if !valid_eval(v9b) { inv9_ok = false }

    // reenter
    let v9c = eval_form(form_reenter())
    if !valid_eval(v9c) { inv9_ok = false }

    // mark(void) = MARKED
    let v9d = eval_form(form_mark(form_void()))
    if !valid_eval(v9d) { inv9_ok = false }

    // cross(marked) = UNMARKED
    let v9e = eval_form(form_cross(form_marked()))
    if !valid_eval(v9e) { inv9_ok = false }

    // mark(mark(mark(void)))
    let v9f = eval_form(form_mark(form_mark(form_mark(form_void()))))
    if !valid_eval(v9f) { inv9_ok = false }

    // cross(cross(void))
    let v9g = eval_form(form_cross(form_cross(form_void())))
    if !valid_eval(v9g) { inv9_ok = false }

    // pair(void, marked)
    let pair_form = form_pair(form_void(), form_marked())
    let v9h = eval_form(pair_form)
    if !valid_eval(v9h) { inv9_ok = false }

    // contain(reenter)
    let cont_form = form_contain(form_reenter())
    let v9i = eval_form(cont_form)
    if !valid_eval(v9i) { inv9_ok = false }
    if inv9_ok { println("  INVARIANT 9: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 9: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // INVARIANT 10: Learning level is always in {0, 1, 2, 3}
    // ========================================================================
    println("Testing INVARIANT 10: Learning level always in {0, 1, 2, 3}")
    var inv10_ok = true
    var ctx10 = bateson_new()
    i = 0
    while i < 100 {
        let stimulus = i % 8
        // Vary outcome to trigger different learning behaviors
        var outcome = 0.5
        if i % 20 == 0 { outcome = 0.0 }
        if i % 30 == 0 { outcome = 1.0 }
        // Use very small outcome to force stagnation and L2/L3
        if i > 60 { outcome = 0.001 }
        let evt = learn(ctx10, stimulus, outcome)
        ctx10 = evt.context
        let level = evt.level_engaged
        if level < 0 || level > 3 {
            inv10_ok = false
        }
        i = i + 1
    }
    if inv10_ok { println("  INVARIANT 10: PASS") ; pass_count = pass_count + 1 } else { println("  INVARIANT 10: FAIL") ; fail_count = fail_count + 1 }

    // ========================================================================
    // SUMMARY
    // ========================================================================
    println("")
    println("========================================================")
    print("  RESULTS: ")
    print_int(pass_count)
    print(" PASS, ")
    print_int(fail_count)
    println(" FAIL")
    println("========================================================")

    assert(fail_count == 0)
    println("  All invariants verified.")
}
