//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_param_spelled_like_unit
// The control for generic_impl_concrete_unit_arg.sio: `struct Map<K, V>` and
// `impl Map<K, V>` declare K and V, and K is also kelvin's symbol. A bare impl-target
// argument that is the struct's OWN parameter stays a parameter even when it is
// spelled like a unit, so an i64 key round-trips and is not an f64 in kelvin.

struct Map<K, V> {
    key: K,
    val: V,
}

impl Map<K, V> {
    fn get_key(self: &Map<K, V>) -> K {
        self.key
    }
    fn get_val(self: &Map<K, V>) -> V {
        self.val
    }
}

fn main() -> i32 with IO {
    let m = Map { key: 42, val: 99 }
    let a: i64 = m.get_key()
    let b: i64 = m.get_val()
    if a + b == 141 {
        println("PASS generic_impl_param_spelled_like_unit")
    } else {
        println("FAIL generic_impl_param_spelled_like_unit")
    }
    0
}
