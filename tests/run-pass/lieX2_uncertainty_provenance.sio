//@ run-pass
//@ requires: madaros
//@ expect-stdout: LIEX2_UNCERTAINTY_PASS
// Same one-parameter model and data, different interpretations of sigma.
use stats::fit_uncertainty::{fit_type_a, fit_type_b, fit_a_slope, fit_b_slope, fit_a_u, fit_b_u, type_a_sigma, type_b_sigma}
use math::pure::{sqrt, abs}

fn main() -> i32 with IO, Mut, Div, Panic {
    let x = [1.0, 2.0, 3.0]
    let y = [2.0, 5.0, 5.0]
    let a = fit_type_a(x, y, 1.0)
    let a100 = fit_type_a(x, y, 100.0)
    let b = fit_type_b(x, y, 1.0)
    let b100 = fit_type_b(x, y, 100.0)
    let sa = type_a_sigma(fit_a_u(a))
    let sa100 = type_a_sigma(fit_a_u(a100))

    let sb = type_b_sigma(fit_b_u(b))
    let sb100 = type_b_sigma(fit_b_u(b100))
    // slope=27/14; RSS=54-729/14=27/14; uA=sqrt(RSS/(2*14)).
    let slope = 27.0 / 14.0
    let expected_a = sqrt(27.0 / 392.0)
    let expected_b = 1.0 / sqrt(14.0)
    if !(abs(fit_a_slope(a) - slope) <= 1.0e-10) { return 1 }
    if !(abs(fit_b_slope(b) - slope) <= 1.0e-10) { return 2 }
    if !(abs(fit_a_slope(a100) - slope) <= 1.0e-10) { return 3 }
    if !(abs(fit_b_slope(b100) - slope) <= 1.0e-10) { return 4 }
    if !(abs(sa - expected_a) <= 1.0e-10) { return 5 }
    if !(abs(sb - expected_b) <= 1.0e-10) { return 6 }
    if !(abs(sa100 - sa) <= 1.0e-10) { return 7 }
    if !(abs(sb100 - 100.0 * sb) <= 1.0e-10) { return 8 }
    println("LIEX2_UNCERTAINTY_PASS")
    return 0
}
