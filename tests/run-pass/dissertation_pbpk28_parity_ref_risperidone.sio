//@ run-pass
//@ timeout: 300
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — RISPERIDONE + 9-OH (SIO-522)
//
// Single 2 mg oral IR tablet (bioequivalence single-dose design):
// gut pool + first-order absorption (ka = 2.0/h, F = 0.70, tlag none —
// immediate gut availability) → parent PBPK28 CN with the CYP2D6
// formation sink solved implicitly on the liver → 9-OH PBPK28 CN fed
// the formed mass scaled by the MW ratio (molar convention:
// 426.48/410.49). NM phenotype (2) is the parity reference.
//
// CL values DERIVED from label t1/2 + Vd (see drugs/risperidone.sio):
// parent CL_other 3.6, CL_form_NM 20.7, 9-OH CL 14.7 L/h. Kp assumed
// patterns targeting label Vd (parent ~115 L, 9-OH ~480 L).
//
// This ref runs the stdlib scenario ITSELF
// (scenarios/risperidone_oral.sio): its step, its gut law, its params.
// It holds no copy of the model. The companion is
// website/src/lib/pbpk28_core.mjs (runRisperidoneScenario) via the
// dedicated runner scripts/dissertation/run_risperidone_node.mjs, and
// the gate case at scripts/ci/dissertation_pbpk28_parity_gate.sh.
//
// PK only, single dose, no LAI claim. No clinical-validity claim: parity
// only (ADR009).
//
// Integrator: fully-coupled CN on the 27-state arrow matrix x2 (parent +
// 9-OH), dt = 0.01, gut exact-split per step (same construction as the
// Node runner).
// ============================================================================

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::scenarios::risperidone_oral::*
use io::sci_print::*

fn nm() -> i32 { return 2 }

fn emit_state(prefix: i32, st: PBPKState28, p: PBPKParams28, t: f64) with IO, Mut, Div {
    var i = 0
    while i < 14 {
        if prefix == 0 { print("RISP|t=") } else { print("R9OH|t=") }
        println(t)
        println("")
        if prefix == 0 { print("RISP|i=") } else { print("R9OH|i=") }
        println(i)
        if prefix == 0 { print("RISP|cv=") } else { print("R9OH|cv=") }
        println_f64_sci(st.cv[i], 10)
        if prefix == 0 { print("RISP|ct=") } else { print("R9OH|ct=") }
        println_f64_sci(st.ct[i], 10)
        if prefix == 0 { print("RISP|cavg=") } else { print("R9OH|cavg=") }
        println_f64_sci(pbpk28_organ_average(st, p, i), 10)
        i = i + 1
    }
}

fn emit_at(scen: RisperidoneScenario, t: f64) with IO, Mut, Div, Panic {
    let pp = rsp_parent_params()
    let op = rsp_oh9_params()
    emit_state(0, scen.parent, pp, t)
    emit_state(1, scen.oh9, op, t)
    print("RMASS|t=")
    println(t)
    println("")
    print("RMASS|p=")
    println(rsp_parent_mass(scen, pp))
    println("")
    print("RMASS|o=")
    println(rsp_oh9_mass(scen, op))
    println("")
    print("RREL|t=")
    println(t)
    println("")
    print("RREL|abs=")
    println(rsp_cum_absorbed(scen))
    println("")
    print("RREL|form=")
    println(rsp_cum_formed(scen))
    println("")
    print("RRES|p=")
    println_f64_sci(rsp_residual_parent(scen, pp), 10)
    print("RRES|o=")
    println_f64_sci(rsp_residual_oh9(scen, op), 10)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_RISPERIDONE_PARITY_REF v1")
    println("compartments=14")
    println("systems=2")
    println("dt=0.01")
    println("dose_mg=2.0")
    println("F_oral=0.70")
    println("ka_h_inv=2.0")
    println("cl_form_nm_L_per_h=20.7")
    println("cl_oh9_L_per_h=14.7")
    println("integrator=fully_coupled_CN_27state_x2")
    println("drug=risperidone")
    println("metabolite=9-hydroxyrisperidone")
    println("molar_convention=formed_x_426.48_over_410.49")
    println("samples=12")
    println("formation=implicit_liver_sink")
    println("model=stdlib_scenario")

    let dt = 0.01
    var s = rsp_scenario_init(nm())
    var t = 0.0

    var target = 1.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 2.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 4.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 6.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 8.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 12.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 18.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 24.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 36.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 48.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 72.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)
    target = 96.0
    s = rsp_integrate_to(s, t, target, dt); t = target; emit_at(s, t)

    println("DISSERTATION_PBPK28_RISPERIDONE_PARITY_DONE")
    return 0
}
