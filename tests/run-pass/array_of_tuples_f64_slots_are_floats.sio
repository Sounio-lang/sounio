//@ run-pass
//@ requires: madaros
//@ description: f64 slots of a tuple element read through an array-of-tuples parameter or local (`xs[i].0 * xs[i].1`) are floats in arithmetic; they were integers to every arithmetic site, so the product of two IEEE bit patterns read 0.000000 and `xs[1].1 + 1.0` printed 4616189618054758400.000000
//@ expect-stdout: TUPLE_SLICE_F64_OK

fn dot(xs: &[(f64, f64)]) -> f64 with Panic, Mut {
    var t: f64 = 0.0
    var i: i64 = 0
    while i < xs.len() as i64 {
        t = t + xs[i as usize].0 * xs[i as usize].1
        i = i + 1
    }
    t
}

fn bump(xs: &[(f64, f64); 2]) -> f64 with Panic {
    xs[1].1 + 1.0
}

fn main() -> i32 with IO, Panic, Mut {
    let a: [(f64, f64); 2] = [(1.0, 2.0), (3.0, 4.0)]
    if dot(&a) != 14.0 { return 1 }
    if bump(&a) != 5.0 { return 2 }
    let local_sum: f64 = a[0].0 + a[1].1
    if local_sum != 5.0 { return 3 }
    println("TUPLE_SLICE_F64_OK")
    0
}
