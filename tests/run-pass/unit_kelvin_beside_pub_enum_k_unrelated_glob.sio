//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: KELVIN_GLOB_OK 6 3000.000000
//
// Review of #3743, unit-shadowing scope: a public `enum K` exists in a loaded
// module (fixtures::kenum_pub_leaf, loaded here for `k_code` only), and this
// module glob-imports an unrelated module that exports no `K`. Neither import
// makes the enum visible here, so `K` is still kelvin. The visibility test must
// ask whether the import reaches the exporter of `K`, not merely whether some
// public `K` exists and this module has some glob import.
use fixtures::kenum_pub_leaf::{k_code}
use fixtures::scale_i64_leaf::*

fn twice_k(t: K) -> K { t + t }

fn main() -> i64 with IO, Mut {
    let t: K = 1500.0
    let u = twice_k(t)
    print("KELVIN_GLOB_OK "); print_int(leaf_scaled(2)); print(" "); print_f64(u as f64); print("\n")
    0
}
