//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_FO_HOF_DRAWING_FNPTR_OK
//@ description: A function passed by name to a helper that calls it, where the pointed-to function measures inside itself and the argument is certain: the HOF specialisation resolves the target at compile time, the clone of the specialisation carries the internal measurement, and variance_of(apply1(noisy_f, a0)) is a0^2 u^2 = 4 * 0.09 = 0.36 (before, 0). Expected value: tests/oracles/gum_fo_hof_drawing_exact.cpp.

fn noisy_f(y: f64) -> f64 with Epistemic, Mut, Div {
    let km = measure(2.0, uncertainty: 0.3)
    let m: f64 = km.value
    y * m
}

fn apply1(f: fn(f64) -> f64 with Epistemic, Mut, Div, x: f64) -> f64 with Epistemic, Mut, Div {
    var s = 0.0
    var i: i64 = 0
    while i < 1 {
        s = s + f(x)
        i = i + 1
    }
    s
}

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    d <= 1.0e-14 + 1.0e-10 * want
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let a0: f64 = 2.0
    let r = apply1(noisy_f, a0)
    let v = variance_of(r)
    print_f64(v)
    print("\n")
    if close_rel(v, 0.36) {
        print("GUM_FO_HOF_DRAWING_FNPTR_OK\n")
        return 0
    }
    1
}
