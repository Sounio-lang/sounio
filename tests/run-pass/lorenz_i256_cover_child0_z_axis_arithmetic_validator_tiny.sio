//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-0 Z-axis arithmetic validator receipt

fn main() -> i64 {
    let validator_instance: i64 = 348416226
    let validator_certificate: i64 = 157818710
    let validator_artifact: i64 = 21090937
    let validator_audit: i64 = 972902456

    if validator_instance != 348416226 { return 1 }
    if validator_certificate != 157818710 { return 2 }
    if validator_artifact != 21090937 { return 3 }
    if validator_audit != 972902456 { return 4 }

    let step1_need: i64 = 20569
    let step1_margin: i64 = 21000
    let step2_need: i64 = 21872
    let step2_margin: i64 = 22000
    let step3_need: i64 = 20325
    let step3_margin: i64 = 20500
    let step4_need: i64 = 12336
    let step4_margin: i64 = 12500
    let step5_need: i64 = 49576
    let step5_margin: i64 = 50000

    if step1_margin - step1_need != 431 { return 5 }
    if step2_margin - step2_need != 128 { return 6 }
    if step3_margin - step3_need != 175 { return 7 }
    if step4_margin - step4_need != 164 { return 8 }
    if step5_margin - step5_need != 424 { return 9 }

    let z_axis_pass_mask: i64 = 31
    let z_axis_fail_mask: i64 = 0
    let z_axis_slack_mask: i64 = 31
    let axis_validated_mask: i64 = 7
    let pending_axis_validation_mask: i64 = 24
    let remaining_axis_pending_mask: i64 = 0
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0

    if z_axis_pass_mask != 31 { return 10 }
    if z_axis_fail_mask != 0 { return 11 }
    if z_axis_slack_mask != 31 { return 12 }
    if axis_validated_mask != 7 { return 13 }
    if pending_axis_validation_mask != 24 { return 14 }
    if remaining_axis_pending_mask != 0 { return 15 }
    if local_flowpipe_proof_mask != 0 { return 16 }
    if child_validated_mask != 0 { return 17 }
    if child_discharge_mask != 0 { return 18 }
    if global_cover_certificate_mask != 0 { return 19 }
    if global_flowpipe_claim_mask != 0 { return 20 }

    let total_need: i64 = step1_need + step2_need + step3_need + step4_need + step5_need
    if total_need != 124678 { return 21 }
    return 0
}
