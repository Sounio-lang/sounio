//@ run-pass
//@ description: Tiny portfolio v36 smoke for Lorenz i256 projection interval-containment entry

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var audit_fp: i64 = 379
    audit_fp = portfolio_mix(audit_fp, 310218620, 2671)
    audit_fp = portfolio_mix(audit_fp, 192258040, 2671)
    audit_fp = portfolio_mix(audit_fp, 80894555, 2671)
    audit_fp = portfolio_mix(audit_fp, 890086395, 2671)
    audit_fp = portfolio_mix(audit_fp, 69322697, 2671)
    audit_fp = portfolio_mix(audit_fp, 31, 2671)
    if audit_fp != 501185861 { return 1 }

    var entry_fp: i64 = 101
    entry_fp = portfolio_mix(entry_fp, 39, 1103)
    entry_fp = portfolio_mix(entry_fp, 310218620, 1103)
    entry_fp = portfolio_mix(entry_fp, audit_fp, 1103)
    entry_fp = portfolio_mix(entry_fp, 1, 1103)
    entry_fp = portfolio_mix(entry_fp, 39, 1103)
    if entry_fp != 189652817 { return 2 }

    if audit_fp == 501185862 { return 3 }
    return 0
}
