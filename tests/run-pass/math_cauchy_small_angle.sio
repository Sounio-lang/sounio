//@ run-pass
//@ expect-stdout: MATH_CAUCHY_SMALL_ANGLE_PASS
use math::pure::{tan}
use stats::student_t::{t_quantile}
fn close(g: f64, e: f64) -> bool {
 let scale = if e < 0.0 { 0.0-e } else { e }
 let delta = if g > e { g-e } else { e-g }
 delta <= 1.0e-12 * scale + 1.0e-290
}
fn main() with IO, Mut, Div, Panic {
 println("Cauchy quantile")
 assert(close(t_quantile(0.010000, 1.0), -31.8205159537739581))
 println("Cauchy quantile")
 assert(close(t_quantile(0.025000, 1.0), -12.7062047361747047))
 println("Cauchy quantile")
 assert(close(t_quantile(0.250000, 1.0), -1.00000000000000000))
 println("Cauchy quantile")
 assert(close(t_quantile(0.750000, 1.0), 1.00000000000000000))
 println("Cauchy quantile")
 assert(close(t_quantile(0.975000, 1.0), 12.7062047361747047))
 println("Cauchy quantile")
 assert(close(t_quantile(0.990000, 1.0), 31.8205159537739581))
 println("small tangent")
 assert(close(tan(1.00000000000000000e-12), 1.00000000000000000e-12))
 println("small tangent")
 assert(close(tan(-1.00000000000000000e-12), -1.00000000000000000e-12))
 println("small tangent")
 assert(close(tan(1.00000000000000000e-08), 1.00000000000000003e-08))
 println("small tangent")
 assert(close(tan(0.100000000000000000), 0.100334672085450545))
 println("MATH_CAUCHY_SMALL_ANGLE_PASS")
 0
}
