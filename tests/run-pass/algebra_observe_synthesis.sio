//@ run-pass
// SYNTHESIS TEST: algebra + observer in one program
//
// Demonstrates the B+D principle:
//   - algebra declares what's equivalent (the space of rewrites)
//   - Observe collapses to a definite value (the measurement)
//   - Bayesian update narrows uncertainty upon observation
//
// Spencer-Brown connection:
//   UNMARKED = Unobserved<T>  (no distinction drawn)
//   MARKED   = T              (distinction drawn, value fixed)

algebra Quaternion over f64 {
    add: commutative, associative
    mul: associative, non_commutative
    reassociate: free
}

algebra Octonion over f64 {
    add: commutative, associative
    mul: alternative, non_commutative
    reassociate: fano_selective
}

fn bayesian_mean(val: f64, mv: f64, pm: f64, pv: f64) -> f64 with Div {
    let total = pv + mv
    if total == 0.0 { return val }
    let a = pv * val
    let b = mv * pm
    let sum = a + b
    sum / total
}

fn bayesian_var(mv: f64, pv: f64) -> f64 with Div {
    let total = pv + mv
    if total == 0.0 { return 0.0 }
    let prod = pv * mv
    prod / total
}

fn simulate_sensor() -> Unobserved<f64> with Observe {
    42.7
}

fn main() -> i32 with IO, Observe, Div, Mut {
    // --- Act 1: The algebra exists ---
    println("Act 1: algebra declarations parsed")
    println("  Quaternion: mul associative, free reassociation")
    println("  Octonion: mul alternative, fano-selective reassociation")
    println("")

    // --- Act 2: A value is unobserved ---
    let raw = simulate_sensor()
    println("Act 2: sensor value exists but is Unobserved")

    // --- Act 3: Observation collapses the value ---
    if raw > 40.0 {
        println("Act 3: observation triggered by comparison (raw > 40)")
        println("  UNMARKED -> MARKED (Spencer-Brown)")
    }
    println("")

    // --- Act 4: Bayesian update narrows uncertainty ---
    let meas: f64 = 42.7
    let meas_v: f64 = 1.0
    let prior_m: f64 = 42.0
    let prior_v: f64 = 0.25

    let post_m = bayesian_mean(meas, meas_v, prior_m, prior_v)
    let post_v = bayesian_var(meas_v, prior_v)

    println("Act 4: Bayesian observation")
    println("  Prior: 42.0 +/- 0.5")
    println("  Measurement: 42.7 +/- 1.0")
    println("  Posterior mean:")
    println(post_m)
    println("  Posterior variance:")
    println(post_v)

    if post_v < prior_v {
        println("  Looking sharpened knowledge.")
    }
    println("")

    // --- Act 5: The principle ---
    println("Act 5: The principle")
    println("  Algebra = space of equivalent forms (e-graph superposition)")
    println("  Observe = collapse to definite value (codegen extraction)")
    println("  Knowledge = what sharpens when you look")

    0
}
