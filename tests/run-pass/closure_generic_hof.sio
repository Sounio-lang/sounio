//@ run-pass
//@ expect-stdout: generic PASS
// Generic HOF with fn-typed param: fn apply<T>(f: fn(T)->T, x: T)->T infers T from
// the literal second arg when the first param is fn(T)->T rather than T directly.

fn apply_t<T>(f: fn(T) -> T, x: T) -> T { f(x) }
fn double_i64(x: i64) -> i64 { x * 2 }

fn main() -> i32 with IO {
    // Closure: T inferred from literal second arg
    let r1 = apply_t(|x: i64| x * 2, 5)
    if r1 == 10 { print("generic PASS\n") }

    // Named fn ref: also works
    let r2 = apply_t(double_i64, 7)
    if r2 == 14 { print("named fn PASS\n") }

    0
}
