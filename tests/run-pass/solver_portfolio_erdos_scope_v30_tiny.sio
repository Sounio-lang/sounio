//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v30 smoke for Erdős/Hadwiger-Nelson scope audit

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 {
    if kind != 33 { return 0 - 1 }
    if instance_fp != 37553010 { return 0 - 1 }
    if certificate_fp != 180094659 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 33 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn erdos_scope_audit_fingerprint(current_scope_fp: i64,
                                 hn_chi6_preflight_ready: i64,
                                 hadwiger_nelson_erdos_id: i64,
                                 unit_distance_count_erdos_id: i64,
                                 current_scope_mask: i64) -> i64 {
    if current_scope_fp != 37553010 { return 0 - 1 }
    if hn_chi6_preflight_ready != 0 { return 0 - 1 }
    if hadwiger_nelson_erdos_id != 508 { return 0 - 1 }
    if unit_distance_count_erdos_id != 90 { return 0 - 1 }
    if current_scope_mask != 15 { return 0 - 1 }

    var fp: i64 = 283
    fp = portfolio_mix(fp, current_scope_fp, 2503)
    fp = portfolio_mix(fp, hn_chi6_preflight_ready, 2503)
    fp = portfolio_mix(fp, hadwiger_nelson_erdos_id, 2503)
    fp = portfolio_mix(fp, unit_distance_count_erdos_id, 2503)
    fp = portfolio_mix(fp, current_scope_mask, 2503)
    return fp
}

fn portfolio_v30_fingerprint(erdos_scope_audit_entry_fp: i64) -> i64 {
    if erdos_scope_audit_entry_fp != 786321129 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 30, 1151)
    fp = portfolio_mix(fp, 34, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, 3812644, 1151)
    fp = portfolio_mix(fp, 777068644, 1151)
    fp = portfolio_mix(fp, 423305090, 1151)
    fp = portfolio_mix(fp, 63872871, 1151)
    fp = portfolio_mix(fp, 547731575, 1151)
    fp = portfolio_mix(fp, 620031252, 1151)
    fp = portfolio_mix(fp, 916832909, 1151)
    fp = portfolio_mix(fp, erdos_scope_audit_entry_fp, 1151)
    return fp
}

fn result_coverage_fingerprint(manifest_fp: i64) -> i64 {
    if manifest_fp != 856410103 { return 0 - 1 }
    var fp: i64 = 131
    fp = portfolio_mix(fp, 30, 1871)
    fp = portfolio_mix(fp, 34, 1871)
    fp = portfolio_mix(fp, 10, 1871)
    fp = portfolio_mix(fp, 22, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn family_coverage_fingerprint(manifest_fp: i64) -> i64 {
    if manifest_fp != 856410103 { return 0 - 1 }
    var fp: i64 = 149
    fp = portfolio_mix(fp, 30, 1907)
    fp = portfolio_mix(fp, 34, 1907)
    fp = portfolio_mix(fp, 6, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 21, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn main() -> i64 {
    let scope_audit_fp = erdos_scope_audit_fingerprint(37553010, 0, 508, 90, 15)
    if scope_audit_fp != 180094659 { return 1 }

    let entry_fp = portfolio_entry_fingerprint(33, 37553010, scope_audit_fp, 1, 33)
    if entry_fp != 786321129 { return 2 }

    let manifest_fp = portfolio_v30_fingerprint(entry_fp)
    if manifest_fp != 856410103 { return 3 }

    let result_fp = result_coverage_fingerprint(manifest_fp)
    if result_fp != 586508146 { return 4 }

    let family_fp = family_coverage_fingerprint(manifest_fp)
    if family_fp != 938241679 { return 5 }

    if portfolio_entry_fingerprint(33, 37553010, scope_audit_fp, 0, 33) != (0 - 1) { return 6 }
    if erdos_scope_audit_fingerprint(37553010, 1, 508, 90, 15) != (0 - 1) { return 7 }
    if family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 8 }

    return 0
}
