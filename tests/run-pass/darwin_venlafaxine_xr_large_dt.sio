//@ run-pass
//@ expect-stdout-contains: VENLAFAXINE_XR_LARGE_DT_PASS
//
// Steady-state readout at step sizes where the absorption exponential needs
// range reduction (ka·dt > 0.5, i.e. dt > 0.79 h): dt = 1 h (one halving)
// and dt = 24 h (five halvings, x = −15.12). Before the reduction, the
// 19-term Taylor series returned −9.2e4 at dt = 24 h, and the gut released
// millions of mg per step.
//
//   1. Physical bound. At steady state everything the parent eliminates
//      through CL_c in one interval came from that interval's absorbed dose,
//      at most the 75 mg released, so CL_c·AUC_parent ≤ 75 mg; likewise
//      CL_odv·AUC_odv ≤ 75 mg. Both are checked against the UPPER end of each
//      AUC's certified interval (AUC + err): the whole interval, and so the
//      exact steady state, must respect the dose bound.
//   2. The closed-form steady state lies inside the run's certified interval.
//      At these dt the CN steps clamp heavily, so the interval is wide
//      (dt = 24: ±1.5 %), but it is derived, not chosen.

use darwin_pbpk::scenarios::venlafaxine_xr::*
use darwin_pbpk::release::matrix_er::*
use darwin_pbpk::drugs::venlafaxine::*

fn ldt_ok(pheno: i32, dt: f64) -> bool with IO, Mut, Div, Panic {
    let iv = vfx_ss_interval(pheno, venlafaxine_xr_matrix_gohel2008(), 10, 24.0, dt)
    let dose = 75.0
    let cf = vfx_ss_ratio_closed_form(pheno)
    let elim_p = venlafaxine_cl_parent_central_pgx(pheno) * (iv.auc_parent + iv.err_auc_parent)
    let elim_o = venlafaxine_cl_odv_pgx(pheno) * (iv.auc_odv + iv.err_auc_odv)
    println("pheno, dt, ratio, closed form, lo, CL_c*AUC_p upper (mg), CL_odv*AUC_o upper (mg):")
    println(pheno)
    println(dt)
    println(vfx_ss_ratio(iv))
    println(cf)
    println(vfx_ss_ratio_lo(iv))
    println(elim_p)
    println(elim_o)
    if !(elim_p <= dose && elim_o <= dose) {
        println("FAIL: steady-state elimination exceeds the dose per interval")
        return false
    }
    if !(vfx_ss_ratio_lo(iv) <= cf && cf <= vfx_ss_ratio_hi(iv)) {
        println("FAIL: closed form outside certified interval")
        return false
    }
    return true
}

fn main() with Mut, Div, IO, Panic {
    var ph: i32 = 0
    while ph < 4 {
        if !ldt_ok(ph, 1.0) { return }
        if !ldt_ok(ph, 24.0) { return }
        ph = ph + 1
    }
    println("VENLAFAXINE_XR_LARGE_DT_PASS")
}
