    receipt_fp = mix(receipt_fp, 106243394, 6007)
    receipt_fp = mix(receipt_fp, 366763865, 6007)
    receipt_fp = mix(receipt_fp, 177395598, 6007)
    receipt_fp = mix(receipt_fp, 296443716, 6007)
    receipt_fp = mix(receipt_fp, 2, 6007)
    receipt_fp = mix(receipt_fp, 13, 6007)
    receipt_fp = mix(receipt_fp, 255, 6007)
    if receipt_fp != 7118356 { return 1 }

    var audit_fp: i64 = 2017
    audit_fp = mix(audit_fp, receipt_fp, 6011)
    audit_fp = mix(audit_fp, 311696236, 6011)
    audit_fp = mix(audit_fp, 301485983, 6011)
    audit_fp = mix(audit_fp, 717525854, 6011)
