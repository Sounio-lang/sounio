//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v124 smoke for Lorenz i256 step-2 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2011
    receipt_fp = mix(receipt_fp, 311696236, 6007)
    receipt_fp = mix(receipt_fp, 301485983, 6007)
    receipt_fp = mix(receipt_fp, 247315677, 6007)
