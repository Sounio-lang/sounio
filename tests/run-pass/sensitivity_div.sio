//@ run-pass

fn main() -> i32 with IO, Epistemic {
    let a = measure(6.0, uncertainty: 0.1)
    let b = measure(2.0, uncertainty: 0.1)

    // y = a / b
    let y = a.value / b.value

    // ∂y/∂a = 1/b = 0.5
    let sa = sensitivity_of(y, 0)
    // ∂y/∂b = -a/b² = -6/4 = -1.5
    let sb = sensitivity_of(y, 1)

    assert(sa > 0.499 && sa < 0.501)
    assert(sb > -1.501 && sb < -1.499)
    0
}
