//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: STDLIB_DEEP_BUFFER_PASS
use collections::numeric_buffer::{NumericBuffer,numeric_buffer_new,numeric_buffer_status,numeric_buffer_len,numeric_buffer_capacity,numeric_buffer_get,numeric_buffer_at,numeric_buffer_set,numeric_buffer_push,numeric_buffer_reserve,numeric_buffer_resize,numeric_buffer_close,numeric_matrix,numeric_matrix_status,numeric_matrix_get,numeric_matrix_set}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_get,integer_buffer_set,integer_buffer_close}
fn main() -> i32 with IO, Alloc, Mut, Div, Panic {
    var b = numeric_buffer_new(4096, 131072)
    assert(numeric_buffer_status(&b) == 0)
    assert(numeric_buffer_len(&b) == 4096)
    assert(numeric_buffer_at(&b, 4095) == 0.0)
    assert(numeric_buffer_set(&!b, 4095, 7.25) == 0)
    assert(numeric_buffer_reserve(&!b, 10000) == 0)
    assert(numeric_buffer_at(&b, 4095) == 7.25)
    let old_cap = numeric_buffer_capacity(&b)
    assert(numeric_buffer_reserve(&!b, 20000) == 2)
    assert(numeric_buffer_capacity(&b) == old_cap)
    assert(numeric_buffer_at(&b, 4095) == 7.25)
    assert(numeric_buffer_get(&b, -1).status == 4)
    assert(numeric_buffer_get(&b, 4096).status == 4)
    assert(numeric_buffer_resize(&!b, 8192) == 0)
    assert(numeric_buffer_at(&b, 8191) == 0.0)
    assert(numeric_buffer_push(&!b, 12.5) == 0)
    assert(numeric_buffer_at(&b, 8192) == 12.5)
    let row = numeric_matrix(numeric_buffer_len(&b), 32, 128, 128, 1, 0)
    assert(numeric_matrix_status(&row) == 0)
    assert(numeric_matrix_get(&b, &row, 31, 127).value == 7.25)
    let transposed = numeric_matrix(numeric_buffer_len(&b), 128, 32, 1, 128, 0)
    assert(numeric_matrix_set(&!b, &transposed, 127, 31, -3.0) == 0)
    assert(numeric_buffer_at(&b, 4095) == -3.0)
    let bad = numeric_matrix(8, 9223372036854775807, 2, 8, 1, 0)
    assert(numeric_matrix_status(&bad) == 1)
    assert(numeric_buffer_resize(&!b, 8) == 0)
    assert(numeric_matrix_get(&b, &row, 0, 0).status == 4)
    numeric_buffer_close(b)
    let invalid = numeric_buffer_new(-1, 1024)
    assert(numeric_buffer_status(&invalid) == 1)
    numeric_buffer_close(invalid)
    let over_budget = numeric_buffer_new(129, 1024)
    assert(numeric_buffer_status(&over_budget) == 2)
    numeric_buffer_close(over_budget)
    var exact = integer_buffer_new(3, 24)
    assert(integer_buffer_set(&!exact, 0, 9007199254740993) == 0)
    assert(integer_buffer_get(&exact, 0).value == 9007199254740993)
    integer_buffer_close(exact)
    print("STDLIB_DEEP_BUFFER_PASS\n")
    return 0
}
