//@ run-pass
//@ expect-stdout: LET_IS_BINDING_OK
// Regression: `is` retains its token identity but is a local binding name.
struct IsBindingPayload {
    value: i32,
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let is = IsBindingPayload { value: 42 }
    let copied = is.value
    if copied != 42 {
        println("FAIL: is as expression")
        return 1
    }
    println("LET_IS_BINDING_OK")
    return is.value - 42
}
