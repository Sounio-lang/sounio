//@ run-pass
//@ requires: madaros
//@ expect-stdout: FN_POINTER_LAYOUT_OK
struct Earlier {value:i64,outcome:i64}
struct Later {state:i64,outcome:i64,value:i64,wake:i64}
fn make(state:i64)->Later {Later {state:state,outcome:1,value:42,wake:99}}
fn via_parameter(callback:fn(i64)->Later,state:i64)->i64 with Panic {
 let step=callback(state)
 assert(step.state==state)
 assert(step.outcome==1)
 assert(step.wake==99)
 return step.value
}
fn main()->i32 with IO,Mut,Panic,Div {
 let earlier=Earlier {value:5,outcome:7}
 assert(earlier.value==5)
 assert(via_parameter(make,13)==42)
 let typed=make
 let first=typed(17)
 assert(first.value==42 && first.state==17 && first.wake==99)
 let alias=typed
 let second=alias(23)
 assert(second.value==42 && second.state==23)
 let raw=make as i64
 let casted=raw as fn(i64)->Later
 let third=casted(29)
 assert(third.value==42 && third.state==29 && third.wake==99)
 {let typed=other;let fourth=typed(3);assert(fourth.value==3 && fourth.outcome==8)}
 let last=typed(31)
 assert(last.value==42 && last.state==31)
 println("FN_POINTER_LAYOUT_OK")
 return 0
}
fn other(state:i64)->Earlier {Earlier {value:state,outcome:8}}
