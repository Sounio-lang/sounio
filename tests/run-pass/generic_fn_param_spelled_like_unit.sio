//@ run-pass
//@ expect-stdout: generic fn param shadows unit: PASS
// A type parameter a fn declares is that parameter everywhere in the fn -- in its
// signature, its local annotations and its body -- even when it is spelled like a
// builtin unit. The parser used to drop a fn's `<K>` list, so nothing downstream
// could tell the declared K from kelvin. The same file uses K as kelvin outside
// the generic fns, which must keep typing and lowering as a float.

fn identity<K>(x: K) -> K {
    x
}

fn pick_first<K>(a: K, b: K) -> K {
    let t: K = a
    t
}

fn from_int<K>(x: i64) -> K {
    x
}

fn warm(t: K) -> K {
    let d: K = 1.5
    t + d
}

fn main() -> i32 with IO {
    var ok: i64 = 0
    let a = identity::<i64>(42)
    if a == 42 { ok = ok + 1 }
    let b = pick_first::<i64>(7, 9)
    if b == 7 { ok = ok + 1 }
    let c = from_int::<i64>(5)
    if c == 5 { ok = ok + 1 }
    let w = warm(300.0)
    if w as f64 == 301.5 { ok = ok + 1 }
    if ok == 4 {
        print("generic fn param shadows unit: PASS\n")
    }
    return 0
}
