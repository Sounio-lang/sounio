//@ run-pass
//@ description: Accessing a field of linear struct consumes the struct

linear struct Pair {
    first: i32,
    second: i32,
}

fn get_first(p: Pair) -> i32 {
    p.first  // only access one field to consume
}

fn main() {
    let pair = Pair { first: 10, second: 20 }
    let first = get_first(pair)
}
