//@ run-pass
//
// Regression pin: bin/souc SRET return-forwarding bug (2026-06-02).
// A function returning the struct result of another struct-returning call used
// to return a ZEROED struct (size-independent, 1-field repro). Fixed as of the
// 2026-06-10 re-audit (docs/audit/MODULAR_COMPILER_AUDIT_2026-06-10.md).
// History: docs/audit/g1_wip/SRET_FORWARDING_BUG_2026-06-02.md

struct S { f0: f64 }

fn ctor() -> S with Mut {
    var p: S = S { f0: 7.0 }
    return p
}

fn make() -> S with Mut {
    return ctor()   // return-position struct-returning call (the buggy forwarding shape)
}

fn make_via_var() -> S with Mut {
    var p = ctor()
    return p        // olanzapine_pbpk_params_smoker shape
}

fn make_tail() -> S with Mut {
    ctor()          // tail-position forward
}

fn main() -> i32 with IO, Mut {
    let a = make()
    let b = make_via_var()
    let c = make_tail()
    if a.f0 > 6.9 && b.f0 > 6.9 && c.f0 > 6.9 {
        println("SRET_FORWARDING_MINIMAL_OK")
        return 0
    }
    println("SRET_FORWARDING_MINIMAL_FAIL")
    1
}
