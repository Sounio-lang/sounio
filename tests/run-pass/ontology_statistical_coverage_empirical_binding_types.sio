//@ run-pass
//@ expect-stdout: statistical coverage empirical binding parallel ontology OK

ontology StatisticalCoverageEmpiricalBindingWitness {
    class EpistemicArtifact
    class IdentifiedSetArtifact subclass_of EpistemicArtifact
    class ExactIdentifiedSet subclass_of IdentifiedSetArtifact
    class StatisticalSetArtifact subclass_of EpistemicArtifact
    class ConfidenceRegion subclass_of StatisticalSetArtifact
    class PredictiveSet subclass_of StatisticalSetArtifact
    class CoverageEvidenceArtifact subclass_of EpistemicArtifact
    class WholeSetCoverage subclass_of CoverageEvidenceArtifact
    class MemberwiseCoverage subclass_of CoverageEvidenceArtifact
    class MarginalCoverage subclass_of CoverageEvidenceArtifact
    class SelectionConditionedCoverage subclass_of CoverageEvidenceArtifact
    class DataEvidenceArtifact subclass_of EpistemicArtifact
    class DeclaredLineage subclass_of DataEvidenceArtifact
    class IntegrityEvidence subclass_of DataEvidenceArtifact
    class ExternalDataCustody subclass_of DataEvidenceArtifact
    class ContextArtifact subclass_of EpistemicArtifact
    class SamplingDesign subclass_of ContextArtifact
    class TargetPopulation subclass_of ContextArtifact
    class StatisticalCoverageCalibration subclass_of ContextArtifact
    class InstrumentCalibration subclass_of ContextArtifact
    class SamplingPositivity subclass_of ContextArtifact
    class InstrumentPopulationCompatibility subclass_of ContextArtifact
    class BindingArtifact subclass_of EpistemicArtifact
    class DeclaredContextBinding subclass_of BindingArtifact
    class EmpiricalBinding subclass_of BindingArtifact
    class AbstentionArtifact subclass_of EpistemicArtifact
    class ExternalBindingAbstention subclass_of AbstentionArtifact
    class StateArtifact subclass_of EpistemicArtifact
    class PatientState subclass_of StateArtifact
    class ClinicalAuthorityArtifact subclass_of EpistemicArtifact
    class ClinicalActionAuthority subclass_of ClinicalAuthorityArtifact
    class CausalArtifact subclass_of EpistemicArtifact
    class AssociationEvidence subclass_of CausalArtifact
    class CausalTreatmentEffect subclass_of CausalArtifact
}

fn accept_identified(v: IdentifiedSetArtifact) -> i32 { 0 }
fn accept_statistical(v: StatisticalSetArtifact) -> i32 { 0 }
fn accept_coverage(v: CoverageEvidenceArtifact) -> i32 { 0 }
fn accept_data(v: DataEvidenceArtifact) -> i32 { 0 }
fn accept_context(v: ContextArtifact) -> i32 { 0 }
fn accept_binding(v: BindingArtifact) -> i32 { 0 }
fn accept_abstention(v: AbstentionArtifact) -> i32 { 0 }
fn accept_state(v: StateArtifact) -> i32 { 0 }
fn accept_authority(v: ClinicalAuthorityArtifact) -> i32 { 0 }
fn accept_causal(v: CausalArtifact) -> i32 { 0 }

fn exact_bridge(v: ExactIdentifiedSet) -> i32 { accept_identified(v) }
fn confidence_bridge(v: ConfidenceRegion) -> i32 { accept_statistical(v) }
fn whole_bridge(v: WholeSetCoverage) -> i32 { accept_coverage(v) }
fn lineage_bridge(v: DeclaredLineage) -> i32 { accept_data(v) }
fn population_bridge(v: TargetPopulation) -> i32 { accept_context(v) }
fn binding_bridge(v: DeclaredContextBinding) -> i32 { accept_binding(v) }
fn abstention_bridge(v: ExternalBindingAbstention) -> i32 {
    accept_abstention(v)
}
fn patient_bridge(v: PatientState) -> i32 { accept_state(v) }
fn action_bridge(v: ClinicalActionAuthority) -> i32 { accept_authority(v) }
fn causal_bridge(v: CausalTreatmentEffect) -> i32 { accept_causal(v) }

fn main() -> i32 {
    print("statistical coverage empirical binding parallel ontology OK\n")
    0
}
