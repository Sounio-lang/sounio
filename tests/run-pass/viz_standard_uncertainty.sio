//@ run-pass
//@ expect-stdout: VIZ_STANDARD_UNCERTAINTY_PASS
//@ expect-stdout: data-interval-kind="standard-uncertainty"
//@ expect-stdout: data-interval-level="0"
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_layout_rect,viz_style_rgb,
 viz_line_set_standard_uncertainty,VIZ_INTERVAL_STANDARD_UNCERTAINTY}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO,Mut,Div,Panic {
 var scene=viz_scene_new()
 var x:[f64;1024]=[0.0;1024]
 var y:[f64;1024]=[0.0;1024]
 y[0]=-1.0;y[1]=1.0
 let bar=viz_add_line_chart(&!scene,&x,&y,2,viz_layout_rect(20,20,100,80),viz_style_rgb(70,180,235))
 assert(viz_line_set_standard_uncertainty(&!scene,bar,0.0,1.0))
 assert(scene.series[0].interval_kind==VIZ_INTERVAL_STANDARD_UNCERTAINTY && scene.series[0].interval_level==0.0)
 assert(scene.series[0].lower[0]== -1.0 && scene.series[0].upper[1]==1.0)
 assert(!viz_line_set_standard_uncertainty(&!scene,-1,0.0,1.0))
 assert(!viz_line_set_standard_uncertainty(&!scene,64,0.0,1.0))
 assert(!viz_line_set_standard_uncertainty(&!scene,bar,0.0,-1.0))
 assert(!viz_line_set_standard_uncertainty(&!scene,bar,0.0/0.0,1.0))
 assert(!viz_line_set_standard_uncertainty(&!scene,bar,1e308,1e308))
 assert(!viz_line_set_standard_uncertainty(&!scene,bar,0.0,1e308*2.0))
 assert(!viz_line_set_standard_uncertainty(&!scene,bar,0.0,2.0))
 assert(scene.series[0].interval_kind==4 && scene.series[0].lower[0]== -1.0 && scene.series[0].upper[1]==1.0)
 x[1]=1.0
 let horizontal=viz_add_line_chart(&!scene,&x,&y,2,viz_layout_rect(20,20,100,80),viz_style_rgb(70,180,235))
 assert(!viz_line_set_standard_uncertainty(&!scene,horizontal,0.0,1.0))
 x[1]=0.0
 let curve=viz_add_line_chart(&!scene,&x,&y,3,viz_layout_rect(20,20,100,80),viz_style_rgb(70,180,235))
 assert(!viz_line_set_standard_uncertainty(&!scene,curve,0.0,1.0))
 scene.series[0].interval_kind=1
 assert(!viz_line_set_standard_uncertainty(&!scene,bar,0.0,1.0))
 assert(scene.series[0].interval_kind==1)
 scene.series[0].interval_kind=4
 assert(scene.node_count==3 && scene.series_count==3)
 viz_html_emit_scene(&scene,180,140)
 println("VIZ_STANDARD_UNCERTAINTY_PASS")
 0
}
