//@ run-pass
//@ expect-stdout: transparent PASS
// Effect-transparent HOF: a HOF with an unannotated fn-typed param is implicitly
// effect-polymorphic — calling it with an IO closure requires IO at the call site.
// This test is called from main() which has IO, so it compiles and runs correctly.

fn map_apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn fold2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 { f(a, b) }

fn main() -> i32 with IO, Mut {
    // IO closure through unannotated HOF — call site (main) has IO: OK
    let r = map_apply(|x: i64| -> i64 { print("x\n"); x * 2 }, 5)
    if r == 10 { print("transparent PASS\n") }

    // Pure closure through unannotated HOF — no effect propagation needed
    let r2 = map_apply(|x: i64| x + 3, 7)
    if r2 == 10 { print("pure PASS\n") }

    // Multi-arg: fold with IO closure
    let r3 = fold2(|a: i64, b: i64| -> i64 { print("fold\n"); a + b }, 3, 4)
    if r3 == 7 { print("fold PASS\n") }

    0
}
