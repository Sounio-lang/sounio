//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v94 smoke for Lorenz i256 step-4 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1453
    receipt_fp = mix(receipt_fp, 37368367, 5273)
    receipt_fp = mix(receipt_fp, 94030837, 5273)
    receipt_fp = mix(receipt_fp, 727133227, 5273)
