//@ run-pass
//@ expect-stdout: variance probe: done

struct Holder { k: Knowledge<f64>, n: i64 }
struct Mixer { bias: f64 }

impl Mixer {
    fn add_k(self: Mixer, offset: f64, k: Knowledge<f64, epsilon < 0.02>) -> f64 with Epistemic {
        self.bias + offset + k.value + variance_of(k)
    }
}

fn mixed_param(scale: f64, k: Knowledge<f64, epsilon < 0.01>) -> f64 with Epistemic {
    scale + k.value + variance_of(k)
}

fn main() -> i32 with IO, Epistemic, Panic, Mut {
    print("variance probe: start\n")
    let k: Knowledge<f64> = measure(3.0, uncertainty: 0.01)
    print("variance probe: measured\n")
    let direct_value = k.value
    print("variance probe: value\n")
    let direct_variance = variance_of(k)
    print("variance probe: variance\n")
    let observed = direct_value + direct_variance
    print("variance probe: direct\n")
    let k_exact: Knowledge<f64, epsilon < 0.01> = measure(3.0, uncertainty: 0.0)
    let mixed = mixed_param(1.0, k_exact)
    print("variance probe: fncall\n")
    let mixer = Mixer { bias: 0.5 }
    let k_method: Knowledge<f64, epsilon < 0.02> = measure(3.0, uncertainty: 0.01)
    let method_mixed = mixer.add_k(2.0, k_method)
    print("variance probe: method\n")
    let holder = Holder { k: k, n: 7 }
    let field_observed = holder.k.value + variance_of(holder.k.value)
    print("variance probe: field\n")
    let k2: Knowledge<f64> = measure(5.0, uncertainty: 0.02)
    let k_arr: [Knowledge<f64>; 2] = [k, k2]
    let arr_observed = k_arr[0].value + variance_of(k_arr[0].value)
    print("variance probe: array\n")
    var holder2 = Holder { k: k_exact, n: 9 }
    holder2.k = k2
    let reassigned = holder2.k.value + variance_of(holder2.k.value)
    print("variance probe: assign\n")
    if observed > 0.0 && mixed > 0.0 && method_mixed > 0.0 && field_observed > 0.0 && arr_observed > 0.0 && reassigned > 0.0 {
        print("variance probe: done\n")
        return 0
    }
    print("variance probe: fail\n")
    1
}
