//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_hexbin_raster, quality_hexbin_plot_config_default}

fn is_dark(r: i64, g: i64, b: i64) -> bool {
    r < 55 && g < 65 && b < 85
}

fn is_hot(r: i64, g: i64, b: i64) -> bool {
    r > 180 && g > 170 && b < 120
}

fn is_cool(r: i64, g: i64, b: i64) -> bool {
    r < 120 && g < 150 && b > 80
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(84, 84)
    var xs: [f64; 256] = [0.0; 256]
    var ys: [f64; 256] = [0.0; 256]
    var values: [f64; 256] = [0.0; 256]

    xs[0] = 0.0
    ys[0] = 0.0
    values[0] = 1.0

    xs[1] = 1.0
    ys[1] = 1.0
    values[1] = 2.0

    xs[2] = 0.5
    ys[2] = 0.5
    values[2] = 4.0

    s = plot_hexbin_raster(
        s,
        &xs,
        &ys,
        &values,
        3,
        quality_hexbin_plot_config_default()
    )

    let hot_r = surface_get_pixel_r(&s, 42, 41)
    let hot_g = surface_get_pixel_g(&s, 42, 41)
    let hot_b = surface_get_pixel_b(&s, 42, 41)
    if !is_hot(hot_r, hot_g, hot_b) {
        print("FAIL hexbin high-value fill missing\n")
        return 1
    }

    let cool_r = surface_get_pixel_r(&s, 20, 63)
    let cool_g = surface_get_pixel_g(&s, 20, 63)
    let cool_b = surface_get_pixel_b(&s, 20, 63)
    if !is_cool(cool_r, cool_g, cool_b) {
        print("FAIL hexbin low-value fill missing\n")
        return 2
    }

    var outline_pixels = 0
    var y = 38
    while y <= 44 {
        let r1 = surface_get_pixel_r(&s, 50, y)
        let g1 = surface_get_pixel_g(&s, 50, y)
        let b1 = surface_get_pixel_b(&s, 50, y)
        if is_dark(r1, g1, b1) {
            outline_pixels = outline_pixels + 1
        }
        y = y + 1
    }
    if outline_pixels < 1 {
        print("FAIL hexbin outline missing\n")
        return 3
    }

    let outside_r = surface_get_pixel_r(&s, 10, 10)
    let outside_g = surface_get_pixel_g(&s, 10, 10)
    let outside_b = surface_get_pixel_b(&s, 10, 10)
    if outside_r < 240 || outside_g < 240 || outside_b < 240 {
        print("FAIL hexbin painted outside plot region\n")
        return 4
    }

    print("PASS graphics_quality_hexbin_smoke\n")
    0
}
