//@ run-pass
//@ expect-stdout-contains: MRG32K3A_ORACLE_PASS

// Oracle test for stdlib/random/mrg32k3a.sio.
//
// Reference vectors generated by compiling L Ecuyer RngStream.c
// (streams00 package) with the workspace cc and dumping: first 8 U01,
// state after 8 steps, first-substream start (2^76 jump), first 2
// substream U01s, all from the default seed (12345 x 6). NOTE: the C dumper
// printed its two substream draws via one printf with two RandU01 call
// arguments; C argument order is unspecified and gcc evaluated them
// right-to-left, so the dumped pair is transposed relative to true draw
// order. The expectations below use the corrected (sequential) order.

use random::mrg32k3a::*

fn check_u(got: f64, want: f64, tag: i64) -> i64 with IO {
    if got != want {
        print("FAIL u")
        print(tag)
        print(": got ")
        print(got)
        print(" want ")
        println(want)
        return 1
    }
    return 0
}

fn check_s(got: i64, want: i64, tag: i64) -> i64 with IO {
    if got != want {
        print("FAIL s")
        print(tag)
        print(": got ")
        print(got)
        print(" want ")
        println(want)
        return 1
    }
    return 0
}

fn main() -> i64 with IO, Mut, Div {
    var exit_fails = 0
    var st = mrg32k3a_default_seed()
    exit_fails = exit_fails + check_s(st.s0, 12345, 100)
    exit_fails = exit_fails + check_s(st.s5, 12345, 101)

    let r0 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r0.0, 0.12701112204657714, 0)
    st = r0.1
    let r1 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r1.0, 0.3185275653967945, 1)
    st = r1.1
    let r2 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r2.0, 0.30918601558327008, 2)
    st = r2.1
    let r3 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r3.0, 0.82584686292711362, 3)
    st = r3.1
    let r4 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r4.0, 0.2216299157820229, 4)
    st = r4.1
    let r5 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r5.0, 0.53339538791827878, 5)
    st = r5.1
    let r6 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r6.0, 0.4807742033156181, 6)
    st = r6.1
    let r7 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(r7.0, 0.35555987943812623, 7)
    st = r7.1

    exit_fails = exit_fails + check_s(st.s0, 2462079208, 200)
    exit_fails = exit_fails + check_s(st.s1, 2386811717, 201)
    exit_fails = exit_fails + check_s(st.s2, 2989318136, 202)
    exit_fails = exit_fails + check_s(st.s3, 171163572, 203)
    exit_fails = exit_fails + check_s(st.s4, 321902337, 204)
    exit_fails = exit_fails + check_s(st.s5, 1462200156, 205)

    st = mrg32k3a_default_seed()
    st = mrg32k3a_next_substream(st)
    exit_fails = exit_fails + check_s(st.s0, 870504860, 300)
    exit_fails = exit_fails + check_s(st.s1, 2641697727, 301)
    exit_fails = exit_fails + check_s(st.s2, 884013853, 302)
    exit_fails = exit_fails + check_s(st.s3, 339352413, 303)
    exit_fails = exit_fails + check_s(st.s4, 2374306706, 304)
    exit_fails = exit_fails + check_s(st.s5, 3651603887, 305)

    let q0 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(q0.0, 0.079398989797334632, 400)
    st = q0.1
    let q1 = mrg32k3a_next_u01(st)
    exit_fails = exit_fails + check_u(q1.0, 0.48033950475757409, 401)

    if exit_fails == 0 {
        print("MRG32K3A_ORACLE_PASS\n")
        return 0
    }
    return 1
}
