//@ run-pass
//@ requires: madaros
//@ description: Tiny pseudo-Boolean proof-chain checker smoke

fn small_nonneg(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x > 1000000000 { return 0 }
    return 1
}

fn bool_valid(x: i64) -> i64 {
    if x == 0 { return 1 }
    if x == 1 { return 1 }
    if x == (0 - 1) { return 1 }
    return 0
}

fn min_term(w: i64, x: i64) -> i64 {
    if x == 1 { return w }
    return 0
}

fn max_term(w: i64, x: i64) -> i64 {
    if x == 0 { return 0 }
    return w
}

fn check_le_contradiction(w0: i64, x0: i64, w1: i64, x1: i64, w2: i64, x2: i64, rhs: i64) -> i64 {
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if bool_valid(x0) == 0 { return 0 }
    if bool_valid(x1) == 0 { return 0 }
    if bool_valid(x2) == 0 { return 0 }
    let m = min_term(w0, x0) + min_term(w1, x1) + min_term(w2, x2)
    if m > rhs { return 1 }
    return 0
}

fn check_saturation(w0: i64, w1: i64, w2: i64, rhs: i64, s0: i64, s1: i64, s2: i64) -> i64 {
    if rhs < 0 { return 0 }
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    var ew0 = w0
    var ew1 = w1
    var ew2 = w2
    if ew0 > rhs { ew0 = rhs }
    if ew1 > rhs { ew1 = rhs }
    if ew2 > rhs { ew2 = rhs }
    if ew0 != s0 { return 0 }
    if ew1 != s1 { return 0 }
    if ew2 != s2 { return 0 }
    return 1
}

fn floor_div(n: i64, d: i64) -> i64 with Div {
    if d <= 0 { return 0 - 1 }
    return n / d
}

fn ceil_div(n: i64, d: i64) -> i64 with Div {
    if d <= 0 { return 0 - 1 }
    return (n + d - 1) / d
}

fn check_divide_le(w0: i64, w1: i64, w2: i64, rhs: i64, divisor: i64,
                   q0: i64, q1: i64, q2: i64, qrhs: i64) -> i64 with Div {
    if divisor <= 0 { return 0 }
    if rhs < 0 { return 0 }
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if floor_div(w0, divisor) != q0 { return 0 }
    if floor_div(w1, divisor) != q1 { return 0 }
    if floor_div(w2, divisor) != q2 { return 0 }
    if floor_div(rhs, divisor) != qrhs { return 0 }
    return 1
}

fn check_divide_ge(w0: i64, w1: i64, w2: i64, rhs: i64, divisor: i64,
                   q0: i64, q1: i64, q2: i64, qrhs: i64) -> i64 with Div {
    if divisor <= 0 { return 0 }
    if rhs < 0 { return 0 }
    if w0 < 0 { return 0 }
    if w1 < 0 { return 0 }
    if w2 < 0 { return 0 }
    if ceil_div(w0, divisor) != q0 { return 0 }
    if ceil_div(w1, divisor) != q1 { return 0 }
    if ceil_div(w2, divisor) != q2 { return 0 }
    if ceil_div(rhs, divisor) != qrhs { return 0 }
    return 1
}

fn check_scale(w0: i64, w1: i64, w2: i64, rhs: i64, factor: i64,
               s0: i64, s1: i64, s2: i64, srhs: i64) -> i64 {
    if small_nonneg(factor) == 0 { return 0 }
    if small_nonneg(w0) == 0 { return 0 }
    if small_nonneg(w1) == 0 { return 0 }
    if small_nonneg(w2) == 0 { return 0 }
    if small_nonneg(rhs) == 0 { return 0 }
    if w0 * factor != s0 { return 0 }
    if w1 * factor != s1 { return 0 }
    if w2 * factor != s2 { return 0 }
    if rhs * factor != srhs { return 0 }
    return 1
}

fn check_add(a0: i64, a1: i64, a2: i64, arhs: i64,
             b0: i64, b1: i64, b2: i64, brhs: i64,
             c0: i64, c1: i64, c2: i64, crhs: i64) -> i64 {
    if small_nonneg(a0) == 0 { return 0 }
    if small_nonneg(a1) == 0 { return 0 }
    if small_nonneg(a2) == 0 { return 0 }
    if small_nonneg(arhs) == 0 { return 0 }
    if small_nonneg(b0) == 0 { return 0 }
    if small_nonneg(b1) == 0 { return 0 }
    if small_nonneg(b2) == 0 { return 0 }
    if small_nonneg(brhs) == 0 { return 0 }
    if a0 + b0 != c0 { return 0 }
    if a1 + b1 != c1 { return 0 }
    if a2 + b2 != c2 { return 0 }
    if arhs + brhs != crhs { return 0 }
    return 1
}

fn pb_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn sense_code(sense: i64) -> i64 {
    if sense == (0 - 1) { return 1 }
    if sense == 1 { return 2 }
    return 0
}

fn assign_code(x: i64) -> i64 {
    if x == 0 { return 1 }
    if x == 1 { return 2 }
    if x == (0 - 1) { return 3 }
    return 0
}

fn row_fingerprint(w0: i64, w1: i64, w2: i64, rhs: i64, sense: i64) -> i64 with Mod {
    if small_nonneg(w0) == 0 { return 0 }
    if small_nonneg(w1) == 0 { return 0 }
    if small_nonneg(w2) == 0 { return 0 }
    if small_nonneg(rhs) == 0 { return 0 }
    let sc = sense_code(sense)
    if sc == 0 { return 0 }
    var fp = 83
    fp = pb_mix(fp, w0, 941)
    fp = pb_mix(fp, w1, 941)
    fp = pb_mix(fp, w2, 941)
    fp = pb_mix(fp, rhs, 941)
    fp = pb_mix(fp, sc, 941)
    return fp
}

fn assignment_fingerprint(x0: i64, x1: i64, x2: i64) -> i64 with Mod {
    let a0 = assign_code(x0)
    let a1 = assign_code(x1)
    let a2 = assign_code(x2)
    if a0 == 0 { return 0 }
    if a1 == 0 { return 0 }
    if a2 == 0 { return 0 }
    var fp = 89
    fp = pb_mix(fp, a0, 977)
    fp = pb_mix(fp, a1, 977)
    fp = pb_mix(fp, a2, 977)
    return fp
}

fn bundle_fingerprint(row_a_fp: i64, row_b_fp: i64, row_c_fp: i64,
                      assignment_fp: i64, contradiction: i64) -> i64 with Mod {
    if row_a_fp <= 0 { return 0 }
    if row_b_fp <= 0 { return 0 }
    if row_c_fp <= 0 { return 0 }
    if assignment_fp <= 0 { return 0 }
    if contradiction != 1 { return 0 }
    var fp = 97
    fp = pb_mix(fp, row_a_fp, 1013)
    fp = pb_mix(fp, row_b_fp, 1013)
    fp = pb_mix(fp, row_c_fp, 1013)
    fp = pb_mix(fp, assignment_fp, 1013)
    fp = pb_mix(fp, contradiction, 1013)
    return fp
}

fn check_pb_add_contradiction_bundle() -> i64 with Mod {
    let le = 0 - 1
    let row_a_fp = row_fingerprint(2, 1, 3, 4, le)
    let row_b_fp = row_fingerprint(1, 4, 0, 2, le)
    let row_c_fp = row_fingerprint(3, 5, 3, 6, le)
    let assignment_fp = assignment_fingerprint(1, 1, 0 - 1)
    let contradiction = check_le_contradiction(3, 1, 5, 1, 3, 0 - 1, 6)
    if row_a_fp != 361051473 { return 0 }
    if row_b_fp != 46142869 { return 0 }
    if row_c_fp != 617917101 { return 0 }
    if assignment_fp != 123291979 { return 0 }
    if check_add(2, 1, 3, 4, 1, 4, 0, 2, 3, 5, 3, 6) != 1 { return 0 }
    if contradiction != 1 { return 0 }
    if bundle_fingerprint(row_a_fp, row_b_fp, row_c_fp, assignment_fp, contradiction) != 624517492 { return 0 }
    return 1
}

fn main() -> i32 with Div {
    if check_saturation(5, 2, 7, 3, 3, 2, 3) != 1 { return 1 }
    if check_saturation(5, 2, 7, 3, 5, 2, 3) != 0 { return 2 }

    if check_divide_le(5, 2, 7, 8, 2, 2, 1, 3, 4) != 1 { return 3 }
    if check_divide_le(5, 2, 7, 8, 2, 3, 1, 3, 4) != 0 { return 4 }

    if check_divide_ge(5, 2, 7, 9, 2, 3, 1, 4, 5) != 1 { return 5 }
    if check_divide_ge(5, 2, 7, 9, 2, 2, 1, 4, 5) != 0 { return 6 }

    if check_scale(2, 1, 3, 4, 2, 4, 2, 6, 8) != 1 { return 7 }
    if check_scale(2, 1, 3, 4, 2, 4, 2, 7, 8) != 0 { return 8 }

    if check_add(2, 1, 3, 4, 1, 4, 0, 2, 3, 5, 3, 6) != 1 { return 9 }
    if check_add(2, 1, 3, 4, 1, 4, 0, 2, 3, 5, 4, 6) != 0 { return 10 }

    if check_le_contradiction(3, 1, 5, 1, 3, 0 - 1, 6) != 1 { return 11 }
    if check_le_contradiction(3, 1, 5, 0 - 1, 3, 0, 6) != 0 { return 12 }
    if check_pb_add_contradiction_bundle() != 1 { return 13 }
    return 0
}
