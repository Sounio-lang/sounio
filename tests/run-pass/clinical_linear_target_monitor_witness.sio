//@ run-pass
// D12 positive witness: every produced monitoring observation is consumed
// exactly once, by exactly one of the three admissible dispositions.
//
// NOTE on style: observations are consumed inline rather than via a `let`
// binding. Under the modular Madaros checker the canonical pattern
// `let x = <linear>; use(x)` currently raises a spurious E039 — a
// pre-existing false positive that also affects the repo's own
// tests/run-pass/linear_struct_field_access.sio, linear_nested_consume.sio
// and linear_balanced_branches.sio (all of which run fine under lean_single).
// The inline form is accepted by both engines.
use epistemic::proof_carrying_linear_target_monitor::*

fn main() -> i32 with IO, Panic, Div {
    // W0: no drift observed -> renew. Observation consumed exactly once.
    let out_a = d12_account_renew(certify_d12_monitor_observation(31201, 0))
    // W1: degradation observed -> degrade.
    let out_b = d12_account_degrade(certify_d12_monitor_observation(31202, 1))
    // W2: revocation trigger -> revoke.
    let out_c = d12_account_revoke(certify_d12_monitor_observation(31203, 2))

    assert(d12_outcome_id(out_a) == 31201)
    assert(d12_outcome_disposition(out_a) == 1)
    assert(!d12_disposition_is_downward(out_a))

    assert(d12_outcome_id(out_b) == 31202)
    assert(d12_outcome_disposition(out_b) == 2)
    assert(d12_disposition_is_downward(out_b))

    assert(d12_outcome_id(out_c) == 31203)
    assert(d12_outcome_disposition(out_c) == 3)
    assert(d12_disposition_is_downward(out_c))

    println("D12-W0 observation=31201 drift=0 disposition=renewed downward=false consumed_once=true")
    println("D12-W1 observation=31202 drift=1 disposition=degraded downward=true consumed_once=true")
    println("D12-W2 observation=31203 drift=2 disposition=revoked downward=true consumed_once=true")
    println("D12-W3 barriers=target_authority,external_validation,production_authority,patient_state producible=false")
    println("PROOF-CARRYING LINEAR TARGET MONITOR D12 PASS")
    0
}
