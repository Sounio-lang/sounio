//@ run-pass
//@ requires: madaros
//@ expect-stdout: CLOSURE_IN_LOOP_OK
//@ description: #2760 review -- a closure created inside a `loop` body infers its own effects. The by-value closure checker did not raise the closure-body flag, so the builtin call inside the closure reported E035 even though the enclosing function declares IO.

fn main() -> i32 with IO {
    loop {
        let f = || { println("CLOSURE_IN_LOOP_OK") }
        f()
        break
    }
    0
}
