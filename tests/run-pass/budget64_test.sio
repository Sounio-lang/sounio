//@ run-pass
// Test: 64-Entry GUM Uncertainty Budget
//
// Validates:
//   T1: Budget with 10 entries computes correct combined variance (385)
//   T2: All Type B entries produce infinite effective DOF
//   T3: Ranking identifies dominant source (entry 10, idx=9)
//   T4: Percent contributions sum to 100%
//   T5: Type A entries produce finite Welch-Satterthwaite DOF
//
// Uses flat arrays inlined in main to avoid &!Struct write-through limitations.

fn b64_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i64 with IO, Mut, Div, Panic {
    println("==============================================================")
    println("  64-Entry GUM Uncertainty Budget Tests")
    println("==============================================================")
    var n_pass = 0

    // ---- T1 + T2 + T3 + T4: 10-entry budget, all Type B ----
    // contributions[k-1] = sensitivity^2 * std_uncert^2 = 1^2 * k^2 = k^2
    // k=1..10: contributions = 1, 4, 9, 16, 25, 36, 49, 64, 81, 100
    // sum = 385

    var contributions: [f64; 64] = [0.0; 64]
    var dofs: [f64; 64] = [0.0; 64]
    var rank_indices: [i64; 64] = [0; 64]

    // Init dofs to 1e30 (Type B = infinite DOF)
    var ki = 0
    while ki < 64 { dofs[ki] = 1.0e30; ki = ki + 1 }

    var entry_count: i64 = 0
    var k = 1
    while k <= 10 {
        let kf = k as f64
        let idx = k - 1
        contributions[idx] = kf * kf   // sensitivity=1, std_uncert=k
        dofs[idx] = 1.0e30
        entry_count = entry_count + 1
        k = k + 1
    }

    // Compute combined variance
    var combined_variance = 0.0
    var i = 0
    while i < entry_count {
        combined_variance = combined_variance + contributions[i]
        i = i + 1
    }

    // ---- T1: Combined variance = 385 ----
    println("  T1: Combined variance = "); println(combined_variance)
    let var_err = b64_abs(combined_variance - 385.0)
    let t1 = var_err < 0.01
    if t1 { println("  PASS T1: 10-entry budget computes correctly") } else { println("  FAIL T1") }
    if t1 { n_pass = n_pass + 1 }

    // ---- T2: Effective DOF = infinity (all Type B) ----
    let u_c4 = combined_variance * combined_variance
    var denom = 0.0
    i = 0
    while i < entry_count {
        if dofs[i] < 1.0e20 {
            let c4 = contributions[i] * contributions[i]
            denom = denom + c4 / dofs[i]
        }
        i = i + 1
    }
    var effective_dof = 0.0
    if denom > 1.0e-15 { effective_dof = u_c4 / denom } else { effective_dof = 1.0e30 }
    let t2 = effective_dof > 1.0e20
    if t2 { println("  PASS T2: Type B entries -> infinite DOF") } else { println("  FAIL T2") }
    if t2 { n_pass = n_pass + 1 }

    // ---- T3: Dominant source is entry k=10 (idx=9) ----
    // Initialize rank_indices
    i = 0
    while i < entry_count { rank_indices[i] = i; i = i + 1 }
    // Insertion sort descending by contributions
    var ri = 1
    while ri < entry_count {
        let key_idx = rank_indices[ri]
        let key_val = contributions[key_idx]
        var j = ri - 1
        var done = false
        while j >= 0 && !done {
            let rj = rank_indices[j]
            if contributions[rj] < key_val {
                rank_indices[j + 1] = rank_indices[j]
                j = j - 1
            } else { done = true }
        }
        rank_indices[j + 1] = key_idx
        ri = ri + 1
    }
    let dom_idx: i64 = rank_indices[0]  // explicit kind: an inferred let of an indexed expr loses the scalar kind at print dispatch (#2354)
    let dom_pct = 100.0 * contributions[dom_idx] / combined_variance
    println("  T3: Dominant idx="); println(dom_idx); println(" pct="); println(dom_pct)
    // Entry k=10 has index 9, contribution=100, pct = 100/385 ≈ 25.974%
    let t3 = dom_idx == 9 && b64_abs(dom_pct - 25.974) < 1.0
    if t3 { println("  PASS T3: Correctly identified dominant source") } else { println("  FAIL T3") }
    if t3 { n_pass = n_pass + 1 }

    // ---- T4: Percent contributions sum to 100% ----
    var pct_sum = 0.0
    i = 0
    while i < entry_count {
        pct_sum = pct_sum + 100.0 * contributions[i] / combined_variance
        i = i + 1
    }
    println("  T4: Sum of percent contributions: "); println(pct_sum)
    let t4 = b64_abs(pct_sum - 100.0) < 0.1
    if t4 { println("  PASS T4: Contributions sum to 100%") } else { println("  FAIL T4") }
    if t4 { n_pass = n_pass + 1 }

    // ---- T5: Type A entries → finite Welch-Satterthwaite DOF ----
    // Entry 0: std=2, sens=1, n=10  → dof=9,  contrib = 1^2 * 2^2 = 4
    // Entry 1: std=3, sens=1, n=20  → dof=19, contrib = 1^2 * 3^2 = 9
    // total_var = 13, u_c4 = 169
    // denom = 4^2/9 + 9^2/19 = 16/9 + 81/19 ≈ 1.778 + 4.263 = 6.041
    // eff_dof = 169 / 6.041 ≈ 27.97  (should be in 5..100)
    let c0 = 4.0
    let d0 = 9.0
    let c1 = 9.0
    let d1 = 19.0
    let cv2 = c0 + c1
    let uc4_2 = cv2 * cv2
    let denom2 = c0 * c0 / d0 + c1 * c1 / d1
    let eff_dof2 = uc4_2 / denom2
    println("  T5: Effective DOF with Type A: "); println(eff_dof2)
    let t5 = eff_dof2 > 5.0 && eff_dof2 < 100.0
    if t5 { println("  PASS T5: Welch-Satterthwaite DOF computed") } else { println("  FAIL T5") }
    if t5 { n_pass = n_pass + 1 }

    println("")
    println("==============================================================")
    println("  RESULT: "); println(n_pass); println(" / 5 PASS")
    println("==============================================================")
    if n_pass == 5 { 0 } else { 1 }
}
