//@ run-pass
//@ description: TCP loopback round-trip — server accepts a connection, client sends bytes, server receives identical bytes
//
// NOTE: every TcpSocket value that comes out of a tuple-destructuring
// `let (x, err) = tcp_something(...)` is rebuilt via an explicit struct
// literal (`TcpSocket { fd: x.fd }`) before being passed into another
// tcp_* call. This works around a compiler limitation discovered while
// writing this test: a struct value obtained from destructuring a
// function's tuple return loses its type tag for later call-argument
// type-checking (`error[E001]: Type mismatch in call argument`), even
// though reading a plain field off it works fine. Rebuilding a fresh
// struct literal from its fields sidesteps the bug. See the top-of-file
// comment in stdlib/net/socket.sio for the full writeup — this same
// workaround is required by any future caller of these functions.

use net::socket::*

fn main() -> i32 with IO, Mut {
    var server_ip = Buf4096 { data: [0; 4096] }
    server_ip.data[0] = 49   // "1"
    server_ip.data[1] = 50   // "2"
    server_ip.data[2] = 55   // "7"
    server_ip.data[3] = 46   // "."
    server_ip.data[4] = 48   // "0"
    server_ip.data[5] = 46   // "."
    server_ip.data[6] = 48   // "0"
    server_ip.data[7] = 46   // "."
    server_ip.data[8] = 49   // "1"
    let ip_len = 9

    let (listener_raw, listen_err) = tcp_listen(&server_ip, ip_len, 18080 as u16, 1)
    if listen_err != 0 {
        println("FAIL: tcp_listen returned error")
        return 1
    }
    let listener = TcpSocket { fd: listener_raw.fd }

    let (client_sock_raw, connect_err) = tcp_connect(&server_ip, ip_len, 18080 as u16)
    if connect_err != 0 {
        println("FAIL: tcp_connect returned error")
        return 1
    }
    let client_sock = TcpSocket { fd: client_sock_raw.fd }

    let (server_conn_raw, accept_err) = tcp_accept(&listener)
    if accept_err != 0 {
        println("FAIL: tcp_accept returned error")
        return 1
    }
    let server_conn = TcpSocket { fd: server_conn_raw.fd }

    var send_buf = Buf4096 { data: [0; 4096] }
    send_buf.data[0] = 72   // 'H'
    send_buf.data[1] = 73   // 'I'
    let (client_sock2_raw, sent) = tcp_send(client_sock, &send_buf, 2)
    if sent != 2 {
        println("FAIL: tcp_send did not send 2 bytes")
        return 1
    }
    let client_sock2 = TcpSocket { fd: client_sock2_raw.fd }

    var recv_buf = Buf4096 { data: [0; 4096] }
    let (server_conn2_raw, received) = tcp_recv(server_conn, &!recv_buf)
    if received != 2 {
        println("FAIL: tcp_recv did not receive 2 bytes")
        return 1
    }
    let server_conn2 = TcpSocket { fd: server_conn2_raw.fd }
    if recv_buf.data[0] != 72 {
        println("FAIL: byte 0 mismatch")
        return 1
    }
    if recv_buf.data[1] != 73 {
        println("FAIL: byte 1 mismatch")
        return 1
    }

    tcp_close(client_sock2)
    tcp_close(server_conn2)
    tcp_close(listener)

    println("PASS: loopback round-trip matched")
    return 0
}
