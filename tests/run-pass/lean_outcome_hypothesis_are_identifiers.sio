//@ run-pass
//@ expect-stdout: OUTCOME_HYPOTHESIS_IDENTIFIERS_OK
// `outcome` and `hypothesis` are soft keywords: they open a metadata sub-block
// only inside a `study` (`hypothesis H1 { ... }`). As ordinary identifiers they
// are code. lean_single used to treat ANY statement starting with either name
// as a sub-block and skip it to the next brace, so `outcome = outcome + 1`
// vanished (a `while outcome < 4` loop never ended) and a tail expression
// `outcome + n` returned garbage. Madaros was correct.

fn bump(outcome: i64, n: i64) -> i64 {
    outcome + n
}

fn count_loops() -> i64 with Mut {
    var total: i64 = 0
    var season: i64 = 0
    while season < 3 {
        var outcome: i64 = 0
        while outcome < 4 {
            total = total + 1
            outcome = outcome + 1
        }
        season = season + 1
    }
    total
}

fn hypothesis_sum() -> i64 with Mut {
    var hypothesis: i64 = 10
    hypothesis = hypothesis + 5
    hypothesis
}

fn main() -> i32 with IO, Mut {
    if bump(40, 2) != 42 { println("FAIL tail expression"); return 1 }
    if count_loops() != 12 { println("FAIL loop"); return 2 }
    if hypothesis_sum() != 15 { println("FAIL hypothesis"); return 3 }
    println("OUTCOME_HYPOTHESIS_IDENTIFIERS_OK")
    0
}
