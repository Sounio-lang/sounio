fn check_expected(bits: i32, expected: [f64; 64]) -> i32 with Mut, Panic, Div {
    if !product_matches_expected(bits, expected) { return 40 + bits }
    0
}

fn check_level(bits: i32) -> i32 with Mut, Panic, Div {
    let x = tower_vec(bits, 2)
    let y = tower_vec(bits, 5)
    if cd_level(&x) != bits { return 10 }

    // Splitting and joining are exact inverses at every seam.
    let halves = cd_split(x)
    if !cd_eq(cd_join(halves.low, halves.high, bits), x) { return 11 }

    // Conjugation respects the seam: conj(a,b) = (conj(a), -b).
    let seam_conj = cd_join(cd_conj(halves.low), cd_scale(halves.high, 0.0 - 1.0), bits)
    if !cd_eq(cd_conj(x), seam_conj) { return 12 }

    // The independent recursive-doubling product equals the XOR/sign product.
    let direct = cd_mul(x, y)
    if !cd_eq(cd_mul_doubling(x, y), direct) { return 20 }

    // Cayley-Dickson algebras remain power-associative at every tower level.
    let xx = cd_mul(x, x)
    if !cd_eq(cd_mul(xx, x), cd_mul(x, xx)) { return 21 }

    if bits < 6 {
        // The lower algebra embeds with a zero upper half, and the embedding is
        // multiplicative: eta(xy) = eta(x)eta(y).
        let ex = cd_embed(x, bits + 1)
        let ey = cd_embed(y, bits + 1)
        let embedded = cd_split(ex)
        if !cd_eq(embedded.low, x) { return 30 }
        if !cd_eq(embedded.high, cd_zero(bits)) { return 31 }
        if !cd_eq(cd_join(embedded.low, embedded.high, bits + 1), ex) { return 32 }
        if !cd_eq(cd_mul(ex, ey), cd_embed(direct, bits + 1)) { return 33 }
        if !cd_eq(cd_mul_doubling(ex, ey), cd_mul(ex, ey)) { return 34 }
    }
    0
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var bits: i32 = 1
    while bits <= 6 {
        let verdict = check_level(bits)
        if verdict != 0 {
            print("CAYLEY_DICKSON_TOWER_FAIL level=")
            print_int(bits)
            print(" code=")
            print_int(verdict)
            print("\n")
            return verdict
        }
        bits = bits + 1
    }

    // Cross-implementation parity at k=3, k=4 and k=6. These are not values
    // produced by cd_mul; they come from the independent integer model and
    // are assigned element-by-element in expected_k3/4/6 above.
    if check_expected(3, expected_k3()) != 0 { return 43 }
    if check_expected(4, expected_k4()) != 0 { return 44 }
    if check_expected(6, expected_k6()) != 0 { return 46 }

    // Sabotage control: changing one expected coefficient must be rejected.
    var sabotage = [0.0; 64]
    sabotage[0] = 2.0
    sabotage[1] = -3.0
    sabotage[2] = -22.0
    sabotage[3] = 8.0
    sabotage[4] = 19.0
    sabotage[5] = 16.0
    sabotage[6] = 0.0
    sabotage[7] = 3.0
    if product_matches_expected(3, sabotage) { return 47 }

    // cd_eq must also be able to say no. With only affirmative calls above, a
    // degenerate always-true cd_eq would satisfy every comparison, so pin both
    // negative shapes: a differing coefficient at the same level, and a level
    // mismatch.
    let same = tower_vec(3, 2)
    var mutated = tower_vec(3, 2)
    mutated.c[5 as usize] = mutated.c[5 as usize] + 1.0
    if cd_eq(same, mutated) { return 50 }
    if cd_eq(same, cd_embed(same, 4)) { return 51 }

    println("CAYLEY_DICKSON_TOWER_OK levels=6 max_dim=64")
    return 0
}
