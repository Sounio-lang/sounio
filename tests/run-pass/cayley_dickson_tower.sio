//@ run-pass
//@ expect-stdout: CAYLEY_DICKSON_TOWER_OK
// Unified Cayley-Dickson tower contracts, checked at levels 1..6 (2..64 dims).
// Coefficients are small integers exactly representable in f64, so cd_eq is an
// exact algebraic comparison here rather than a floating tolerance assertion.

use algebra::cayley_dickson_tower::*

fn tower_vec(bits: i32, seed: i32) -> CDElement with Mut, Panic, Div {
    let n = 1 << bits
    var x = cd_zero(bits)
    var i: i32 = 0
    while i < n {
        let coeff = (i * 17 + seed * 11 + bits * 7) % 7 - 3
        x.c[i as usize] = coeff as f64
        i = i + 1
    }
    x
}

// Exact expected coefficients generated independently by the Python oracle.
// Both public multiplication routes must match these values componentwise.
fn product_matches_expected(bits: i32, expected: [f64; 64]) -> bool with Mut, Panic, Div {
    let direct = cd_mul(tower_vec(bits, 2), tower_vec(bits, 5))
    let doubled = cd_mul_doubling(tower_vec(bits, 2), tower_vec(bits, 5))
    if !cd_eq(direct, doubled) { return false }
    var i: i32 = 0
    while i < 64 {
        if direct.c[i as usize] != expected[i as usize] { return false }
        i = i + 1
    }
    true
}

