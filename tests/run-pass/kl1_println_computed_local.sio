//@ run-pass
//@ expect-stdout: 20
//@ expect-stdout: 7
//@ expect-stdout: 42
//@ expect-stdout: 2.500000
//@ expect-stdout: KL1_PRINTLN_COMPUTED_OK

struct Record {
    ints: [i64; 3],
    field: i64,
    floats: [f64; 2],
}

struct Row {
    value: i64,
}

fn main() -> i64 with IO {
    let r = Record { ints: [10, 20, 30], field: 7, floats: [1.25, 2.5] }
    let rows: [Row; 2] = [Row { value: 11 }, Row { value: 42 }]
    let from_index = r.ints[1]
    let from_field = r.field
    let from_struct_array = rows[1].value
    let from_float_index = r.floats[1]
    println(from_index)
    println(from_field)
    println(from_struct_array)
    println(from_float_index)
    println("KL1_PRINTLN_COMPUTED_OK")
    0
}
