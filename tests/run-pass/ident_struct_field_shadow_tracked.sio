//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_FIELD_SHADOW_TRACKED_PASS
//
// Prediction (binding identity of struct fields, positive control):
// A shadowing `let h = Holder { k: c }` is tracked by its own struct literal:
// its `h.k` is {c}, which is disjoint from {a}. So `h.k + a` inside the block
// is accepted, and its variance is Var(c) + Var(a) = 1 + 1 = 2. The outer
// `h.k` = {a} does not leak into the inner binding.

struct Holder {
    k: Knowledge<f64>,
}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let c = measure(3.0, uncertainty: 1.0)
    let h = Holder { k: a }
    println(h.k.value)
    var ok = false
    let flag = 1
    if flag == 1 {
        let h = Holder { k: c }
        let s = h.k + a
        let v = variance_of(s.value)
        var d = v - 2.0
        if d < 0.0 { d = 0.0 - d }
        if d < 1.0e-12 { ok = true }
    }
    if !ok { return 1 }
    println("IDENT_FIELD_SHADOW_TRACKED_PASS")
    0
}
