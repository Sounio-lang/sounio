//@ run-pass
//@ known-failure: E245 (#1706) refuses Knowledge x Knowledge arithmetic on Madaros (no lowering), plus E002/E036 on the first-class function reassignment path this control documents as possibly unreachable; the direct ident() projection it also exercises is pinned by tests/compile-fail/ns_add_via_identity_rejected.sio
//@ requires: madaros
// N2 control (grok-4.6 re-review round 2): an INDIRECT call through a first-class
// function VALUE must default to top (-1), because assignment/CFG-join do not
// rebind the value's fn_sig_id — trusting it would be a projection oracle over
// the wrong callee. Only DIRECT named calls project. SOUNIO_NS_TRACE=1.
//
// If Sounio rejects first-class function assignment/reassignment, that path is
// simply unreachable (fail-closed by the language) and this control documents
// that; the direct ident() case below still proves projection is preserved.

fn ident(x: Knowledge<f64>) -> Knowledge<f64> { x }
fn add_noise(x: Knowledge<f64>) -> Knowledge<f64> with Mut, Panic, Div { x + measure(0.0, uncertainty: 0.1) }

fn main() -> i32 with IO, Mut, Panic, Div {
    let k = measure(1.0, uncertainty: 0.2)   // seed a source

    // DIRECT call to a proven projection: MUST preserve k's handle.
    let d = ident(k)

    // INDIRECT call through a reassigned function value: MUST be top (-1),
    // NOT id's projection, since the runtime callee is add_noise.
    var f = ident
    f = add_noise
    let r = f(k)

    println("ns-indirect-call: PASS")
    return 0
}
