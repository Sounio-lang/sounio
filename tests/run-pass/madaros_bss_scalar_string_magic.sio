//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: BSS SCALAR STRING MAGIC PASS

// #3572: the initializer word is not a string type tag. In the seed-built
// compiler the imported string magic can be zero; inferred integer globals
// must still use integer equality, while real strings use content equality.
var ZERO = 0
var NEGATIVE = 0 - 800001
var TEXT = "bss-string"
var TYPED_ZERO: i64 = 0

fn main() -> i64 with IO, Mut, Panic, Div {
    if ZERO != 0 { return 1 }
    if NEGATIVE != 0 - 800001 { return 2 }
    if TYPED_ZERO != 0 { return 3 }
    if TEXT != "bss-" + "string" { return 4 }
    if TEXT == "different" { return 5 }
    println("BSS SCALAR STRING MAGIC PASS")
    0
}
