//@ run-pass
//@ timeout: 90
//@ expect-stdout: HALO_KP_VD_DISCRIMINANT_PASS
// ============================================================================
// DISSERTATION — HALOPERIDOL Kp HEADER/CODE DISCRIMINANT (SIO-550)
// ============================================================================
// Implied steady-state volume Vss = V_blood + sum(V_t x Kp_t), computed from
// the LIVE haloperidol_pbpk_params(), must reproduce the Forsman 1977 label
// anchor Vd ~1400 L (20 L/kg, 70 kg) within 15%.
//
// Discriminant: the stale header-claimed R-R set (muscle 8, adipose 3)
// implies ~520 L and FAILS; the Vd-calibrated code set (muscle 35,
// adipose 12) implies ~1468 L (+4.9%) and PASSES. Any future Kp edit that
// breaks the label-Vd anchor fails here. See the calibrated-status header
// in stdlib/darwin_pbpk/drugs/haloperidol.sio and
// docs/dissertation/dossiers/kp_provenance_sio550.md.
// ============================================================================

use darwin_pbpk::tsit5_pbpk14::{PBPKParams14}
use darwin_pbpk::drugs::haloperidol::{haloperidol_pbpk_params}

fn halo_vss(p: PBPKParams14) -> f64 {
    return p.v_blood + p.v_liver * p.kp_liver + p.v_kidney * p.kp_kidney + p.v_brain * p.kp_brain + p.v_heart * p.kp_heart + p.v_lung * p.kp_lung + p.v_muscle * p.kp_muscle + p.v_adipose * p.kp_adipose + p.v_gut * p.kp_gut + p.v_skin * p.kp_skin + p.v_bone * p.kp_bone + p.v_spleen * p.kp_spleen + p.v_pancreas * p.kp_pancreas + p.v_other * p.kp_other
}

fn halo_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 with IO, Mut {
    let prm = haloperidol_pbpk_params()
    let vss = halo_vss(prm)
    let target = 1400.0
    let rel = halo_abs(vss - target) / target
    print("HALO|vss_L=")
    println(vss)
    print("HALO|rel_err=")
    println(rel)
    if rel <= 0.15 {
        println("HALO_KP_VD_DISCRIMINANT_PASS")
        return 0
    }
    println("HALO_KP_VD_DISCRIMINANT_FAIL")
    return 1
}
