//@ run-pass
//@ requires: madaros
use crypto::chacha20::*
use net::socket::*

// ChaCha20 is a stream cipher: ciphertext = plaintext XOR keystream, so
// XOR-ing the identical keystream in again recovers the plaintext exactly.
// 100 bytes is deliberately NOT a multiple of 64 (the block size), to
// exercise the final partial-block path in chacha20_encrypt's inner loop
// (`i < 64 && pos + i < data_len`).
fn main() -> i64 with IO {
    let key: [u8;32] = [
        0x00,0x01,0x02,0x03,0x04,0x05,0x06,0x07,
        0x08,0x09,0x0a,0x0b,0x0c,0x0d,0x0e,0x0f,
        0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,
        0x18,0x19,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f
    ]
    let nonce: [u8;12] = [
        0x00,0x00,0x00,0x09,0x00,0x00,0x00,0x4a,0x00,0x00,0x00,0x00
    ]
    let counter: i64 = 1
    let data_len: i64 = 100

    let plain = rawbuf_new(data_len + 8)
    var i: i64 = 0
    while i < data_len {
        rawbuf_set(&plain, i, (i * 7 + 3) & 255)
        i = i + 1
    }

    let ciphertext = chacha20_encrypt(&key, counter, &nonce, &plain, data_len)
    let recovered = chacha20_encrypt(&key, counter, &nonce, &ciphertext, data_len)

    var j: i64 = 0
    while j < data_len {
        if rawbuf_get(&recovered, j) != rawbuf_get(&plain, j) {
            println("MISMATCH")
            print_int(j)
            return 1
        }
        j = j + 1
    }

    println("chacha20_encrypt: 100-byte round-trip recovers original plaintext")
    return 0
}
