//@ run-pass
//@ ignore
//@ expect-stdout: PASS: GPU vec_unary

kernel fn vec_neg_in_place(n: i64, a: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = 0.0 - a[tid as usize]
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU {
    var a: [f64; 64] = [0.0; 64]

    var i: i64 = 0
    while i < 64 {
        a[i as usize] = (i as f64) + 1.0
        i = i + 1
    }

    vec_neg_in_place(64, &!a)

    if a[0] > -1.01 && a[0] < -0.99 &&
       a[10] > -11.01 && a[10] < -10.99 &&
       a[63] > -64.01 && a[63] < -63.99 {
        println("PASS: GPU vec_unary")
    } else {
        println("FAIL: GPU vec_unary")
    }
    0
}
