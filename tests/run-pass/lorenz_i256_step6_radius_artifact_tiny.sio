//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 radius artifact with conservative floor/ceil bounds

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 281
    fp = mix(fp, 6, 3319)
    fp = mix(fp, 4294967296, 3319)
    fp = mix(fp, 1000000, 3319)
    fp = mix(fp, 134624236, 3319)
    fp = mix(fp, 643317565, 3319)
    fp = mix(fp, 114244647, 3319)
    fp = mix(fp, 166945519, 3319)
    fp = mix(fp, 243366, 3319)
    fp = mix(fp, 319640, 3319)
    fp = mix(fp, 42448, 3319)
    fp = mix(fp, 1045249011, 3319)
    fp = mix(fp, 1372843347, 3319)
    fp = mix(fp, 182312772, 3319)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 399482214 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 283
    fp = mix(fp, instance, 3331)
    fp = mix(fp, 24180923580, 3331)
    fp = mix(fp, 28542626778, 3331)
    fp = mix(fp, 29915470125, 3331)
    fp = mix(fp, 4479326365, 3331)
    fp = mix(fp, 486167393, 3331)
    fp = mix(fp, 4965493758, 3331)
    fp = mix(fp, 1287058242, 3331)
    fp = mix(fp, 1671998042, 3331)
    fp = mix(fp, 231967709, 3331)
    fp = mix(fp, 1600000000, 3331)
    fp = mix(fp, 2600000000, 3331)
    fp = mix(fp, 500000000, 3331)
    fp = mix(fp, ok_mask, 3331)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 399482214 { return 0 - 1 }
    if certificate != 694298444 { return 0 - 1 }
    if ok_mask != 127 { return 0 - 1 }

    var fp: i64 = 293
    fp = mix(fp, instance, 3347)
    fp = mix(fp, certificate, 3347)
    fp = mix(fp, 134624236, 3347)
    fp = mix(fp, 643317565, 3347)
    fp = mix(fp, 2, 3347)
    fp = mix(fp, 6, 3347)
    fp = mix(fp, 1287058242, 3347)
    fp = mix(fp, 1671998042, 3347)
    fp = mix(fp, 231967709, 3347)
    fp = mix(fp, 1600000000, 3347)
    fp = mix(fp, 2600000000, 3347)
    fp = mix(fp, 500000000, 3347)
    fp = mix(fp, ok_mask, 3347)
    return fp
}

fn conversion_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let rx: i256 = 1045249011 as i256
    let ry: i256 = 1372843347 as i256
    let rz: i256 = 182312772 as i256
    let x_conv_excess: i256 = rx * target_scale - (243366 as i256) * source_scale
    let y_conv_excess: i256 = ry * target_scale - (319640 as i256) * source_scale
    let z_conv_excess: i256 = rz * target_scale - (42448 as i256) * source_scale
    if x_conv_excess >= (0 as i256) {
        if y_conv_excess >= (0 as i256) {
            if z_conv_excess >= (0 as i256) {
                if x_conv_excess < target_scale {
                    if y_conv_excess < target_scale {
                        if z_conv_excess < target_scale { return 1 }
                    }
                }
            }
        }
    }
    return 0
}

fn xy_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x5_abs: i256 = 5309941770 as i256
    let z5: i256 = 4084837935 as i256
    let rhoz_abs: i256 = (28 as i256) * source_scale - z5
    let rx: i256 = 1045249011 as i256
    let ry: i256 = 1372843347 as i256
    let rz: i256 = 182312772 as i256
    let dx_rad: i256 = 24180923580 as i256
    let prod_x_rhoz: i256 = 28542626778 as i256
    let dy_rad: i256 = 29915470125 as i256

    var mask: i64 = 0
    if dx_rad == (10 as i256) * (rx + ry) { mask = mask + 2 }

    let xrhoz_part1: i256 = x5_abs * rz
    let xrhoz_part2: i256 = rhoz_abs * rx
    let xrhoz_part3: i256 = rx * rz
    let xrhoz_total: i256 = xrhoz_part1 + xrhoz_part2 + xrhoz_part3
    if (prod_x_rhoz - (1 as i256)) * source_scale <= xrhoz_total {
        if prod_x_rhoz * source_scale > xrhoz_total { mask = mask + 4 }
    }
    if dy_rad == prod_x_rhoz + ry { mask = mask + 8 }
    return mask
}

fn z_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let x5_abs: i256 = 5309941770 as i256
    let y5_abs: i256 = 10058731223 as i256
    let rx: i256 = 1045249011 as i256
    let ry: i256 = 1372843347 as i256
    let rz: i256 = 182312772 as i256
    let prod_xy: i256 = 4479326365 as i256
    let beta_rad: i256 = 486167393 as i256
    let dz_rad: i256 = 4965493758 as i256
    let xy_part1: i256 = x5_abs * ry
    let xy_part2: i256 = y5_abs * rx
    let xy_part3: i256 = rx * ry
    let xy_total: i256 = xy_part1 + xy_part2 + xy_part3
    let beta_total: i256 = (8 as i256) * rz
    if (prod_xy - (1 as i256)) * source_scale <= xy_total {
        if prod_xy * source_scale > xy_total {
            if (beta_rad - (2 as i256)) * (3 as i256) < beta_total {
                if (beta_rad - (1 as i256)) * (3 as i256) >= beta_total {
                    if dz_rad == prod_xy + beta_rad { return 16 }
                }
            }
        }
    }
    return 0
}

fn next_radius_mask() -> i64 {
    let source_scale: i256 = 4294967296 as i256
    let dt_q: i256 = 42949672 as i256
    let rx: i256 = 1045249011 as i256
    let ry: i256 = 1372843347 as i256
    let rz: i256 = 182312772 as i256
    let dx_rad: i256 = 24180923580 as i256
    let dy_rad: i256 = 29915470125 as i256
    let dz_rad: i256 = 4965493758 as i256
    let next_x: i256 = 1287058242 as i256
    let next_y: i256 = 1671998042 as i256
    let next_z: i256 = 231967709 as i256
    let x_step_total: i256 = dt_q * dx_rad
    let y_step_total: i256 = dt_q * dy_rad
    let z_step_total: i256 = dt_q * dz_rad
    let x_step_lower: i256 = (next_x - rx - (1 as i256)) * source_scale
    let x_step_upper: i256 = (next_x - rx) * source_scale
    let y_step_lower: i256 = (next_y - ry - (1 as i256)) * source_scale
    let y_step_upper: i256 = (next_y - ry) * source_scale
    let z_step_lower: i256 = (next_z - rz - (1 as i256)) * source_scale
    let z_step_upper: i256 = (next_z - rz) * source_scale
    if x_step_lower <= x_step_total {
        if x_step_upper > x_step_total {
            if y_step_lower <= y_step_total {
                if y_step_upper > y_step_total {
                    if z_step_lower <= z_step_total {
                        if z_step_upper > z_step_total { return 32 }
                    }
                }
            }
        }
    }
    return 0
}

fn cap_mask() -> i64 {
    let next_x: i256 = 1287058242 as i256
    let next_y: i256 = 1671998042 as i256
    let next_z: i256 = 231967709 as i256
    if next_x <= (1600000000 as i256) {
        if next_y <= (2600000000 as i256) {
            if next_z <= (500000000 as i256) { return 64 }
        }
    }
    return 0
}

fn main() -> i64 {
    var ok_mask: i64 = 0
    ok_mask = ok_mask + conversion_mask()
    ok_mask = ok_mask + xy_radius_mask()
    ok_mask = ok_mask + z_radius_mask()
    ok_mask = ok_mask + next_radius_mask()
    ok_mask = ok_mask + cap_mask()
    if ok_mask != 127 { return 1 }

    let inst = instance_fp()
    if inst != 399482214 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 694298444 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 237534229 { return 4 }
    if certificate_fp(inst, 126) != (0 - 1) { return 5 }
    return 0
}
