//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_FIELD_CALL_PASS

// Non-Ident field FO — pure calls returning structs project FO to fields.
//   make_pk(cl0, v0).cl0  → FO of cl0
//   id_pk(pk).cl0         → FO of pk.cl0 (identity FWD)
// Nested: id_pk(make_pk(...)).cl0

struct Pk {
    cl0: f64
    v0: f64
}

fn make_pk(cl0: f64, v0: f64) -> Pk {
    Pk { cl0: cl0, v0: v0 }
}

fn id_pk(p: Pk) -> Pk {
    p
}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let kCL: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kV: Knowledge<f64> = measure(50.0, uncertainty: 2.0)
    let cl0 = kCL.value
    let v0 = kV.value
    let pk = Pk { cl0: cl0, v0: v0 }

    let v_ident = variance_of(pk.cl0)
    let v_call = variance_of(make_pk(cl0, v0).cl0)
    let v_call_v = variance_of(make_pk(cl0, v0).v0)
    let v_id = variance_of(id_pk(pk).cl0)
    let v_nest = variance_of(id_pk(make_pk(cl0, v0)).cl0)
    let v_sum = variance_of(make_pk(cl0, v0).cl0 + make_pk(cl0, v0).v0)
    let v_peel_sum = variance_of(cl0 + v0)

    print("v_ident="); print_f64(v_ident); print("\n")
    print("v_call="); print_f64(v_call); print("\n")
    print("v_call_v="); print_f64(v_call_v); print("\n")
    print("v_id="); print_f64(v_id); print("\n")
    print("v_nest="); print_f64(v_nest); print("\n")
    print("v_sum="); print_f64(v_sum); print("\n")

    let ok = abs_f(v_ident - 0.09) < 1.0e-9
        && abs_f(v_call - v_ident) < 1.0e-9
        && abs_f(v_call_v - 4.0) < 1.0e-9
        && abs_f(v_id - v_ident) < 1.0e-9
        && abs_f(v_nest - v_ident) < 1.0e-9
        && abs_f(v_sum - v_peel_sum) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_FIELD_CALL_PASS\n")
    } else {
        print("MADAROS_GUM_FO_FIELD_CALL_FAIL\n")
    }
}
