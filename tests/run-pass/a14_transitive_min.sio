//@ run-pass
// A14 minimal 3-module transitive-call repro. main -> tc_b_second (modB, non-first) -> tc_c_add (modC, transitive).
use testmod::tc_b::{tc_b_second}
fn main() -> i64 with IO, Mut, Panic, Div {
    let r = tc_b_second(10)
    print_int(r)
    print("\n")
    if r == 115 { return 0 }
    return 1
}
