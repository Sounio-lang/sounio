//@ run-pass
//@ description: R7 fusion — mixed origins become 0; (a+b)+a does not see shared a.

use eisa::core::*

fn main() -> i32 with IO, Mut, Div, Panic {
    if eisa_fuse_origin(1, 1) != 1 {
        println("EISA_ORIGIN_FUSION FAIL 1,1")
        return 1
    }
    if eisa_fuse_origin(1, 2) != 0 {
        println("EISA_ORIGIN_FUSION FAIL 1,2")
        return 1
    }
    if eisa_fuse_origin(0, 1) != 0 {
        println("EISA_ORIGIN_FUSION FAIL 0,1")
        return 1
    }
    if eisa_fuse_origin(1, 0) != 0 {
        println("EISA_ORIGIN_FUSION FAIL 1,0")
        return 1
    }
    if eisa_fuse_origin(0, 0) != 0 {
        println("EISA_ORIGIN_FUSION FAIL 0,0")
        return 1
    }
    if eisa_origins_correlated(0, 0) != 0 {
        println("EISA_ORIGIN_FUSION FAIL 0,0 must not fire")
        return 1
    }

    let a = ereg_origin(1.0, 3.0, 1)
    let b = ereg_origin(2.0, 4.0, 2)
    let ab = eadd(a, b)
    if ab.origin != 0 {
        println("EISA_ORIGIN_FUSION FAIL a+b origin")
        return 1
    }
    let aba = eadd(ab, a)
    if aba.origin != 0 {
        println("EISA_ORIGIN_FUSION FAIL (a+b)+a origin")
        return 1
    }
    // Silent miss: (a+b)+a does not fire, so u is RSS of {5-ish, 3}, not 2*3.
    // Do not require a tight u here — the origin sentinel is the contract.
    if eisa_origins_correlated(ab.origin, a.origin) != 0 {
        println("EISA_ORIGIN_FUSION FAIL (a+b)+a fired")
        return 1
    }

    // Constants cannot correlate.
    let c = ereg_exact(2.0)
    if c.origin != 0 {
        println("EISA_ORIGIN_FUSION FAIL exact origin")
        return 1
    }
    let cx = eadd(c, a)
    if cx.origin != 0 {
        println("EISA_ORIGIN_FUSION FAIL exact+measured origin")
        return 1
    }

    // Negative id is not legitimate — stored as 0.
    let bad = ereg_origin(1.0, 1.0, 0 - 1)
    if bad.origin != 0 {
        println("EISA_ORIGIN_FUSION FAIL negative id stored")
        return 1
    }

    println("EISA_ORIGIN_FUSION OK")
    0
}
