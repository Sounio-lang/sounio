//@ run-pass
//@ expect-stdout: ontology typed bridge go OK

// Exercises the runtime-model <-> generated-type bridge in ontology::typed::go:
// a runtime IRI is built for a deep GO class, coerced to its nominal compile-time
// type, then passed to functions that require ancestor classes. The calls only
// type-check because the compiler proves GO_0007166 <: GO_0007165 <: GO_0008150.
//
// NOTE: the bridge is the SINGLE import point — it transitively re-exports the
// generated GO types and `GO_*_ID` constants. Importing `generated::go` directly
// *as well* would place the `ontology { }` block in the unit twice; the compiler
// resets its subclass matrix per block, so the duplicate silently breaks
// subsumption (E001). Import the bridge only.

use ontology::model::{IRI, owl_class_new}
use ontology::typed::go::*

// Requires the GO "biological_process" root; any descendant must be accepted.
fn process_count(x: GO_0008150) -> i32 { 1 }

// Requires "signaling" (mid-tree); only signaling + descendants accepted.
fn signaling_count(x: GO_0007165) -> i32 { 1 }

fn main() -> i32 with IO {
    // Runtime IRI for GO_0007166 (signal transduction), via the typed constructor.
    let iri = go_signal_transduction()
    if iri.id != GO_0007166_ID { return 7 }

    // Coerce to the nominal type, then upcast through two subclass edges.
    let st = iri_as_go_signal_transduction(&iri)
    let a = process_count(st)     // GO_0007166 <: GO_0008150  (root)
    let st2 = iri_as_go_signal_transduction(&iri)
    let b = signaling_count(st2)  // GO_0007166 <: GO_0007165  (signaling)

    if a != 1 { return 1 }
    if b != 1 { return 2 }

    // OWLClass-level sugar: build a runtime OWLClass and coerce it directly.
    let cls = owl_class_new(go_signal_transduction())
    let st3 = owl_class_as_go_signal_transduction(&cls)
    let c = process_count(st3)    // GO_0007166 <: GO_0008150  (root)
    if c != 1 { return 3 }

    print("ontology typed bridge go OK\n")
    0
}
