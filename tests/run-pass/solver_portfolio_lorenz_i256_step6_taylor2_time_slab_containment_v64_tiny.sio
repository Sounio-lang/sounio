//@ run-pass
//@ description: Tiny portfolio v64 smoke for Lorenz i256 step-6 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 821
    receipt_fp = mix(receipt_fp, 230532791, 4409)
    receipt_fp = mix(receipt_fp, 370048214, 4409)
    receipt_fp = mix(receipt_fp, 526492507, 4409)
    receipt_fp = mix(receipt_fp, 536676300, 4409)
    receipt_fp = mix(receipt_fp, 262835863, 4409)
    receipt_fp = mix(receipt_fp, 274272622, 4409)
    receipt_fp = mix(receipt_fp, 662934823, 4409)
    receipt_fp = mix(receipt_fp, 6, 4409)
    receipt_fp = mix(receipt_fp, 14, 4409)
    receipt_fp = mix(receipt_fp, 255, 4409)
    if receipt_fp != 270619908 { return 1 }

    var audit_fp: i64 = 823
    audit_fp = mix(audit_fp, receipt_fp, 4421)
    audit_fp = mix(audit_fp, 230532791, 4421)
    audit_fp = mix(audit_fp, 370048214, 4421)
    audit_fp = mix(audit_fp, 91311098, 4421)
    audit_fp = mix(audit_fp, 4135036, 4421)
    audit_fp = mix(audit_fp, 118962929, 4421)
    audit_fp = mix(audit_fp, 79381760, 4421)
    audit_fp = mix(audit_fp, 40625512, 4421)
    audit_fp = mix(audit_fp, 853998860, 4421)
    audit_fp = mix(audit_fp, 262835863, 4421)
    audit_fp = mix(audit_fp, 6, 4421)
    audit_fp = mix(audit_fp, 14, 4421)
    audit_fp = mix(audit_fp, 255, 4421)
    if audit_fp != 648925166 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 67, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 67, 1103)
    if entry_fp != 562971755 { return 3 }

    let manifest_fp: i64 = 827592666
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 64, 1871)
    result_fp = mix(result_fp, 68, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 56, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 300333316 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 64, 1907)
    family_fp = mix(family_fp, 68, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 51, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 213320501 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 64, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 558014348 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 64, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 638977732 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 64, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 94199545 { return 8 }
    return 0
}
