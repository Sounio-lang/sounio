//@ run-pass
//@ expect-stdout: GENOMICS_TPM_PASS
use genomics::expression::{tpm_new, tpm_accumulate, tpm_value, EXPRESSION_OK, EXPRESSION_INVALID_INPUT, EXPRESSION_EMPTY_TOTAL}
fn close(g: f64, e: f64) -> bool {
 let scale = if e < 0.0 { 0.0-e } else { e }
 let delta = if g > e { g-e } else { e-g }
 delta <= 1.0e-12 * scale + 1.0e-290
}
fn main() with IO, Mut, Div, Panic {
 var state = tpm_new()
 assert(tpm_accumulate(&!state, 20.0000000000000000, 1000.00000000000000))
 assert(tpm_accumulate(&!state, 30.0000000000000000, 2000.00000000000000))
 assert(tpm_accumulate(&!state, 50.0000000000000000, 500.000000000000000))
 assert(state.features == 3)
 assert(state.status == EXPRESSION_OK)
 var total: f64 = 0.0
 let g0 = tpm_value(&state, 20.0000000000000000, 1000.00000000000000)
 assert(g0.status == EXPRESSION_OK)
 assert(close(g0.value, 148148.148148148148))
 total = total + g0.value
 let g1 = tpm_value(&state, 30.0000000000000000, 2000.00000000000000)
 assert(g1.status == EXPRESSION_OK)
 assert(close(g1.value, 111111.111111111111))
 total = total + g1.value
 let g2 = tpm_value(&state, 50.0000000000000000, 500.000000000000000)
 assert(g2.status == EXPRESSION_OK)
 assert(close(g2.value, 740740.740740740741))
 total = total + g2.value
 assert(close(total, 1000000.00000000000))
 var empty = tpm_new()
 let e = tpm_value(&empty, 0.0, 100.0)
 assert(e.status == EXPRESSION_EMPTY_TOTAL)
 assert(!tpm_accumulate(&!empty, 1.0, 0.0))
 assert(empty.status == EXPRESSION_INVALID_INPUT)
 assert(!tpm_accumulate(&!empty, 1.0, 1.0))
 assert(empty.features == 0)
 var streamed = tpm_new()
 var i: i64 = 0
 while i < 5000 {
 assert(tpm_accumulate(&!streamed, 1.0, 1000.0))
 i = i + 1
 }
 assert(streamed.features == 5000)
 let uniform = tpm_value(&streamed, 1.0, 1000.0)
 assert(close(uniform.value, 200.000000000000000))
 var compensated = tpm_new()
 assert(tpm_accumulate(&!compensated, 1.0e16, 1.0))
 i = 0
 while i < 10000 {
 assert(tpm_accumulate(&!compensated, 1.0, 1.0))
 i = i + 1
 }
 assert(compensated.rate_sum == 10000000000010000.0)
 var scaled = tpm_new()
 assert(tpm_accumulate(&!scaled, 200.000000000000000, 1000.00000000000000))
 assert(tpm_accumulate(&!scaled, 300.000000000000000, 2000.00000000000000))
 assert(tpm_accumulate(&!scaled, 500.000000000000000, 500.000000000000000))
 let scaled_first = tpm_value(&scaled, 200.0, 1000.0)
 assert(close(scaled_first.value, 148148.148148148148))
 let zero = tpm_value(&state, 0.0, 1000.0)
 assert(zero.value == 0.0)
 assert(zero.status == EXPRESSION_OK)
 println("GENOMICS_TPM_PASS")
 0
}
