//@ run-pass
// Acceptance test for compiler prerequisites #1+#2+#3 combined (generic-struct-return
// + impl Trait for Type + trait-bounded dispatch).
// Uses the GENERIC Cayley-Dickson exact engine from stdlib/algebra/cayley_dickson_exact.sio
// with CDElementExact<i64> via turbofish.
// Proves sedenion zero-divisor annihilation: (e_3 + e_10)(e_6 - e_15) = 0.
// Expected output: "ZD PROVED", "SQ PASS", "NONZERO PASS", then 16 lines "COMP <i> <val>"

use algebra::cayley_dickson_exact::{
    cd_basis_exact, cd_add_exact, cd_sub_exact, cd_mul_exact, cd_is_zero_exact,
}

fn main() with IO, Mut, Panic, Div {
    let k: i32 = 4
    let zero: i64 = 0
    let one: i64 = 1

    // a = e_3 + e_10
    let e3 = cd_basis_exact::<i64>(k, 3, zero, one)
    let e10 = cd_basis_exact::<i64>(k, 10, zero, one)
    let a = cd_add_exact::<i64>(e3, e10, zero)

    // b = e_6 - e_15
    let e6 = cd_basis_exact::<i64>(k, 6, zero, one)
    let e15 = cd_basis_exact::<i64>(k, 15, zero, one)
    let b = cd_sub_exact::<i64>(e6, e15, zero)

    // r = a * b
    let r = cd_mul_exact::<i64>(a, b, zero)

    // Check if r is zero
    if cd_is_zero_exact::<i64>(r) {
        println("ZD PROVED")
    } else {
        println("ZD FAIL")
    }

    // Control 1: e_1 * e_1 == -1 (real part)
    let e1 = cd_basis_exact::<i64>(k, 1, zero, one)
    let e1_sq = cd_mul_exact::<i64>(e1, e1, zero)
    if e1_sq.c[0] == (0 - 1) {
        println("SQ PASS")
    } else {
        println("SQ FAIL")
    }

    // Control 2: e_1 * e_2 is NOT zero
    let e2 = cd_basis_exact::<i64>(k, 2, zero, one)
    let e1e2 = cd_mul_exact::<i64>(e1, e2, zero)
    if !cd_is_zero_exact::<i64>(e1e2) {
        println("NONZERO PASS")
    } else {
        println("NONZERO FAIL")
    }

    // Print all 16 components of r = a * b
    let n: i32 = 16
    var i: i32 = 0
    while i < n {
        print("COMP ")
        print_int(i as i64)
        print(" ")
        print_int(r.c[i as usize])
        print("\n")
        i = i + 1
    }
}
