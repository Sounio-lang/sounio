fn main() -> i64 with IO, Mut, Panic, Div {
    let r = pad_then_float(0)
    print_f64(r)
    print("\n")
    if r == -4.75 { print("vreg2048_float: PASS\n"); return 0 }
    print("vreg2048_float: FAIL\n")
    1
}
