//@ run-pass
//@ expect-stdout: -5
//@ expect-stdout: 55
//@ description: ARM64 signed formatting, calls, loop branches and arithmetic
fn integer_sum(n: i64) -> i64 with Mut {
    var total: i64 = 0
    var i: i64 = 0
    while i <= n { total = total + i; i = i + 1 }
    total
}
fn main() with IO, Mut {
    print_int(-5)
    print("\n")
    print_int(integer_sum(10))
    print("\n")
}
