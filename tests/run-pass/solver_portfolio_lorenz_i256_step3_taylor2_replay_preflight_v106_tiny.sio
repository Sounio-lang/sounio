//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v106 smoke for Lorenz i256 step-3 Taylor-2 replay preflight

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1949
    receipt_fp = mix(receipt_fp, 488274627, 5903)
    receipt_fp = mix(receipt_fp, 678589210, 5903)
    receipt_fp = mix(receipt_fp, 514672660, 5903)
    receipt_fp = mix(receipt_fp, 758528823, 5903)
    receipt_fp = mix(receipt_fp, 918630049, 5903)
    receipt_fp = mix(receipt_fp, 543887870, 5903)
    receipt_fp = mix(receipt_fp, 139143245, 5903)
    receipt_fp = mix(receipt_fp, 308150621, 5903)
    receipt_fp = mix(receipt_fp, 281860333, 5903)
    receipt_fp = mix(receipt_fp, 693283321, 5903)
    receipt_fp = mix(receipt_fp, 3, 5903)
    receipt_fp = mix(receipt_fp, 7, 5903)
    receipt_fp = mix(receipt_fp, 255, 5903)
    if receipt_fp != 40958745 { return 1 }

    var audit_fp: i64 = 1951
    audit_fp = mix(audit_fp, receipt_fp, 5923)
    audit_fp = mix(audit_fp, 488274627, 5923)
    audit_fp = mix(audit_fp, 678589210, 5923)
    audit_fp = mix(audit_fp, 514672660, 5923)
    audit_fp = mix(audit_fp, 758528823, 5923)
    audit_fp = mix(audit_fp, 308150621, 5923)
    audit_fp = mix(audit_fp, 281860333, 5923)
    audit_fp = mix(audit_fp, 139143245, 5923)
    audit_fp = mix(audit_fp, 3, 5923)
    audit_fp = mix(audit_fp, 7, 5923)
    audit_fp = mix(audit_fp, 255, 5923)
    if audit_fp != 498799906 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 109, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 109, 1103)
    if entry_fp != 781301126 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 106, 1151)
    manifest_fp = mix(manifest_fp, 110, 1151)
    manifest_fp = mix(manifest_fp, 543887870, 1151)
    manifest_fp = mix(manifest_fp, 918630049, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 377115992 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 106, 1871)
    result_fp = mix(result_fp, 110, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 98, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 296650456 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 106, 1907)
    family_fp = mix(family_fp, 110, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 93, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 809578718 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 106, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 490704907 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 106, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 12824662 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 106, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 711276818 { return 9 }
    return 0
