//@ run-pass
//@ expect-stdout: ZERO_PROVENANCE PASS

//! Compact Madaros-native zero-provenance witness: sedenion annihilated zero
//! plus local f64 cancellation/resolution/rounding kinds in one CU.
//! Full eisa::core_v2 combined import remains fail-closed (see known_failures
//! probe + madaros_zero_provenance_failclosed_gate.sh).

use algebra::sedenion::{
    sed_canonical_zd_z, sed_canonical_zd_w, sed_mul, sed_norm_sq
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // kind 0 absent
    let a_val = 0.0
    let a_left = false
    let a_right = false
    // kind 1 cancelled
    let left = 3.25
    let right = 0.0 - 3.25
    let c_val = left + right
    // kind 2 annihilated (sedenion ZD)
    var z: [f64; 16] = [0.0; 16]
    var w: [f64; 16] = [0.0; 16]
    var out: [f64; 16] = [0.0; 16]
    sed_canonical_zd_z(&!z)
    sed_canonical_zd_w(&!w)
    sed_mul(&z, &w, &!out)
    let n_out = sed_norm_sq(&out)
    let n_z = sed_norm_sq(&z)
    let n_w = sed_norm_sq(&w)
    // kind 3 resolution
    let latent = 0.0004
    let resolution = 0.001
    let r_val = if latent < resolution { 0.0 } else { latent }
    // kind 4 rounded (f64 loses 1e-30 against 1.0)
    let tiny = 1.0e-30
    let recovered = (1.0 + tiny) - 1.0

    let all_surface_zero =
        a_val == 0.0 && c_val == 0.0 && n_out == 0.0 && r_val == 0.0 && recovered == 0.0
    let provenance_present =
        !a_left && !a_right &&
        left != 0.0 && right != 0.0 &&
        n_z > 0.0 && n_w > 0.0 &&
        latent != 0.0 && resolution != 0.0 &&
        tiny != 0.0

    if all_surface_zero && provenance_present {
        println("ZERO_PROVENANCE PASS")
        return 0
    }
    println("ZERO_PROVENANCE FAIL")
    1
}
