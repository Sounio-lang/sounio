    let root2_der_len: i64 = 414
    let root2_der_bytes: [u8; 414] = [
        0x30, 0x82, 0x01, 0x9A, 0x30, 0x82, 0x01, 0x41, 0xA0, 0x03, 0x02, 0x01,
        0x02, 0x02, 0x14, 0x44, 0xDF, 0xAA, 0xC3, 0xD7, 0xE4, 0x3E, 0x8D, 0xE6,
