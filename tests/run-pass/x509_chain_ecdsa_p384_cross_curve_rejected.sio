        0x5E, 0x3C, 0x7B, 0xCE, 0x9C, 0xD4, 0x6A, 0x60, 0x5B, 0x60, 0x51, 0x7E,
        0xB0, 0x9E, 0x30, 0x1F, 0x74, 0xF8, 0x8A, 0xA3, 0x79, 0x60, 0x56, 0x2D,
        0xBD, 0xF6, 0x82, 0xC6, 0xA1, 0x15,
    ]

    let leaf_buf = rawbuf_new(leaf_der_len + 8)
    var j: i64 = 0
    while j < leaf_der_len {
        rawbuf_set(&leaf_buf, j, leaf_der_bytes[j as usize] as i64)
        j = j + 1
    }
    let root2_buf = rawbuf_new(root2_der_len + 8)
    var k: i64 = 0
    while k < root2_der_len {
        rawbuf_set(&root2_buf, k, root2_der_bytes[k as usize] as i64)
        k = k + 1
    }

    var leaf_cert = certificate_zero()
    let (leaf_raw, leaf_status) = x509_parse_certificate(&leaf_buf, leaf_der_len)
    leaf_cert = leaf_raw
    if leaf_status != X509_OK { print_int(1); return 1 }

    var root2_cert = certificate_zero()
    let (root2_raw, root2_status) = x509_parse_certificate(&root2_buf, root2_der_len)
    root2_cert = root2_raw
    if root2_status != X509_OK { print_int(2); return 1 }
    if root2_cert.public_key_algorithm != PUBKEY_ALG_EC_P256 { print_int(3); return 1 }

    let verified = x509_verify_signature(&leaf_buf, &leaf_cert, &root2_cert)
    if verified == true { print_int(4); return 1 }
    assert(verified == false)

    println("x509_chain_ecdsa_p384_cross_curve_rejected: OK")
    return 0
}
