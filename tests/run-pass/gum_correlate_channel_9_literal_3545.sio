//@ run-pass
//@ requires: madaros
//@ expect-stdout: 0.030000
// #3545: channel 8 (the ninth source) is inside the 32x32 correlation table, for either rho form.
// Var(k7 + k8) = 0.01 + 0.01 + 2(0.5)(0.1)(0.1) = 0.03.

fn main() -> i64 with IO, Mut, Div, Panic, Epistemic {
    let k0: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k2: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k3: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k4: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k5: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k6: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k7: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let k8: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
    let r = correlate(k7.value, k8.value, 0.5)
    print_f64(variance_of(k7.value + k8.value))
    print("\n")
    return 0
}
