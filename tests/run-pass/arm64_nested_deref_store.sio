//@ run-pass

struct Inner {
    pub values: [i64; 4],
    pub count: i64,
}

struct Outer {
    pub inner: Inner,
}

fn update(state: &! Outer) with Mut, Panic {
    state.inner.count = 42
    state.inner.values[2] = 99
}

fn main() -> i32 with IO, Mut, Panic {
    var state = Outer { inner: Inner { values: [0; 4], count: 0 } }
    update(&! state)
    if state.inner.count != 42 {
        println("FAIL: nested field store not visible")
        return 1
    }
    if state.inner.values[2] != 99 {
        println("FAIL: nested field-array store not visible")
        return 2
    }
    println("PASS")
    return 0
}
