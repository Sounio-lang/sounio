//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: ARRAY_STRUCT_LITERAL_OK
//@ description: an array of structs and an array literal without splat initialisation (stdlib/ontology/elplus.sio used to say both segfaulted)
struct P { x: i64, y: i64 }
fn main() -> i32 with IO, Mut, Panic, Div {
    var ps: [P; 3] = [P { x: 1, y: 0 }, P { x: 2, y: 0 }, P { x: 3, y: 0 }]
    var t: i64 = 0
    var i: i64 = 0
    while i < 3 { t = t + ps[i as usize].x  i = i + 1 }
    let b: [i64; 5] = [1, 2, 3, 4, 5]
    let u = b[0] + b[1] + b[2] + b[3] + b[4]
    if t == 6 && u == 15 { print("ARRAY_STRUCT_LITERAL_OK\n"); return 0 }
    print_int(t) print(" ") print_int(u) print("\n")
    1
}
