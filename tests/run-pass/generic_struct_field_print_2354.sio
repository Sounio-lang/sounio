//@ run-pass
//@ description: #2354 leg 3 -- println of a field of a generic struct instance prints the value on Madaros (it refused: "unresolved scalar kind"), per instance, also when another instance of the same generic struct holds a float
//@ expect-stdout: 10
//@ expect-stdout: 21
//@ expect-stdout: 4
//@ expect-stdout: 21
//@ expect-stdout: 30
//@ expect-stdout: GENERIC_FIELD_PRINT_2354_OK
//
// `struct Pair<T>` has ONE layout on Madaros for every instantiation, so the
// field's declared type (`T`) said nothing about the instance: println(p.first)
// was refused with "cannot safely lower print/println argument with unresolved
// scalar kind". A let bound to a struct literal now records each type-variable
// field's kind for that local (ir/lower.sio LOWER_GFK_*). lean_single printed
// these all along.

struct Pair<T> { first: T, second: T }

fn main() -> i64 with IO {
    var fails: i64 = 0
    let p = Pair { first: 10, second: 20 }
    println(p.first)
    if p.first != 10 { fails = fails + 1 }
    println(p.second + 1)
    let q: Pair<i64> = Pair { first: 3, second: 4 }
    println(q.second)
    println(q.first * 7)
    let r = Pair { first: p.first + q.first, second: 0 }
    println(r.first + p.second - 3)
    if r.first != 13 { fails = fails + 1 }
    if fails == 0 { println("GENERIC_FIELD_PRINT_2354_OK") } else { println("GENERIC_FIELD_PRINT_2354_FAIL") }
    fails
}
