//@ run-pass
//@ requires: madaros
// A stamped literal passed to a function escapes: the heap payload is filled
// so the callee reads a real object. Sum through a callee must stay 26.
fn sum4(xs: [i64; 4]) -> i64 {
    xs[0] + xs[1] + xs[2] + xs[3]
}
fn main() -> i64 {
    let xs: [i64; 4] = [3, 5, 7, 11]
    if sum4(xs) == 26 { 0 } else { 1 }
}
