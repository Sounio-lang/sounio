//@ run-pass
//@ requires: madaros
//@ expect-stdout: 42 7.500000 joined
//@ expect-stdout: 3
//@ expect-stdout: 0.250000
//@ description: one-argument print/println of non-Knowledge values, and an explicit Knowledge field, are unchanged by E310
// print/println now finish in the checker's native branch, which types the
// argument once. Each argument below is a non-trivial expression: an integer
// call, an f64 sum, a string, a struct field and a projected Knowledge field.
struct P { a: i64, b: i64 }

fn twice(x: i64) -> i64 { x * 2 }

fn main() with IO, Epistemic {
    print(twice(21))
    print(" ")
    print(2.5 + 5.0)
    print(" ")
    println("joined")
    let p = P { a: 1, b: 3 }
    println(p.b)
    let k: Knowledge<f64> = measure(10.0, uncertainty: 0.5)
    println(k.variance)
}
