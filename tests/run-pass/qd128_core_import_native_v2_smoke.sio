//@ run-pass
//@ expect-stdout: QD128_CORE_IMPORT_NATIVE_V2 PASS

//! Thin qd128 constructor import under default Madaros native-v2.
//! Does not claim full math::qd128 arithmetic (see known_failures probe).

use math::qd128_core::{qd_zero}

fn main() -> i32 with IO {
    let z = qd_zero()
    if z.x0 == 0.0 && z.x1 == 0.0 && z.x2 == 0.0 && z.x3 == 0.0 {
        println("QD128_CORE_IMPORT_NATIVE_V2 PASS")
        return 0
    }
    1
}
