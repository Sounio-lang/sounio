 xn[18]=97
 xn[19]=110
 xn[20]=116
 xn[21]=105
 xn[22]=108
 xn[23]=101
 var yn:[i8;64]=[0;64]
 yn[0]=111
 yn[1]=114
 yn[2]=100
 yn[3]=101
 yn[4]=114
 yn[5]=101
 yn[6]=100
 yn[7]=32
 yn[8]=79
 yn[9]=76
 yn[10]=83
 yn[11]=32
 yn[12]=114
 yn[13]=101
 yn[14]=115
 yn[15]=105
 yn[16]=100
 yn[17]=117
 yn[18]=97
 yn[19]=108
 var lg:[i8;64]=[0;64]
 lg[0]=111
 lg[1]=114
 lg[2]=100
 lg[3]=101
 lg[4]=114
 lg[5]=101
 lg[6]=100
 lg[7]=32
 lg[8]=114
 lg[9]=101
 lg[10]=115
 lg[11]=105
 lg[12]=100
 lg[13]=117
 lg[14]=97
 lg[15]=108
 lg[16]=115
 var fit:[i8;64]=[0;64]
 fit[0]=81
 fit[1]=45
 fit[2]=81
 fit[3]=32
 fit[4]=102
 fit[5]=105
 fit[6]=116
 fit[7]=116
 fit[8]=101
 fit[9]=100
 fit[10]=32
 fit[11]=108
 fit[12]=105
 fit[13]=110
 fit[14]=101

 viz_node_set_label(&!scene,xa,&xn,24)
 viz_node_set_label(&!scene,ya,&yn,20)
 assert(viz_add_label(&!scene,&title,44,viz_layout_rect(140,20,600,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&method,45,viz_layout_rect(140,48,600,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,curve,&lg,17,viz_layout_rect(140,400,310,22))>=0)
 assert(viz_add_series_legend(&!scene,line,&fit,15,viz_layout_rect(470,400,270,22))>=0)
 let w=axis_label(model.shapiro.w)
 let p=axis_label(model.shapiro.p)
 var wt:[i8;64]=[0;64]
 var pt:[i8;64]=[0;64]
 wt[0]=87;wt[1]=61;pt[0]=112;pt[1]=61
 i=0
 while i<w.n {wt[(i+2) as usize]=w.text[i as usize];i=i+1}
 i=0
 while i<p.n {pt[(i+2) as usize]=p.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&wt,w.n+2,viz_layout_rect(140,74,280,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&pt,p.n+2,viz_layout_rect(470,74,280,20),viz_style_rgb(230,235,245))>=0)
 var foot:[i8;64]=[0;64]
 foot[0]=82
 foot[1]=111
 foot[2]=121
 foot[3]=115
 foot[4]=116
 foot[5]=111
 foot[6]=110
 foot[7]=32
 foot[8]=112
 foot[9]=32
 foot[10]=97
 foot[11]=112
 foot[12]=112
 foot[13]=114
 foot[14]=111
 foot[15]=120
 foot[16]=105
 foot[17]=109
 foot[18]=97
 foot[19]=116
 foot[20]=101
 foot[21]=59
 foot[22]=32
 foot[23]=114
 foot[24]=101
 foot[25]=115
 foot[26]=105
 foot[27]=100
 foot[28]=117
 foot[29]=97
 foot[30]=108
 foot[31]=32
 foot[32]=99
 foot[33]=97
 foot[34]=108
 foot[35]=105
 foot[36]=98
 foot[37]=114
 foot[38]=97
 foot[39]=116
 foot[40]=105
 foot[41]=111
 foot[42]=110
 foot[43]=32
 foot[44]=117
 foot[45]=110
 foot[46]=97
 foot[47]=115
 foot[48]=115
 foot[49]=101
 foot[50]=115
 foot[51]=115
 foot[52]=101
 foot[53]=100
 assert(viz_add_label(&!scene,&foot,54,viz_layout_rect(140,436,600,14),viz_style_rgb(190,200,215))>=0)
 assert(scene.node_count==11 && scene.series_count==2 && scene.series[0].n==20)
 let pixels=heap_alloc(860*450*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:860,height:450}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,330*860+118)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,860,450)
 println("VIZ_SHAPIRO_QQ_PASS")
 0
}
