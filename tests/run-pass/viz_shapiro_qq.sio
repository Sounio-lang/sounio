 method[23]=108
 method[24]=105
 method[25]=110
 method[26]=101
 method[27]=32
 method[28]=105
 method[29]=115
 method[30]=32
 method[31]=97
 method[32]=32
 method[33]=118
 method[34]=105
 method[35]=115
 method[36]=117
 method[37]=97
 method[38]=108
 method[39]=32
 method[40]=103
 method[41]=117
 method[42]=105
 method[43]=100
 method[44]=101
 var xn:[i8;64]=[0;64]
 xn[0]=115
 xn[1]=116
 xn[2]=97
 xn[3]=110
 xn[4]=100
 xn[5]=97
 xn[6]=114
 xn[7]=100
