//@ run-pass
//@ expect-stdout: VIZ_SHAPIRO_QQ_PASS
//@ expect-stdout: synthetic n=20
//@ expect-stdout: standard normal quantile
//@ expect-stdout: visual guide
//@ expect-stdout: residual calibration unassessed
use stats::regression::assessments::{assess_simple_linear}
use stats::regression::ols::{ols_fit_simple}
use stats::bca_normal::{bca_normal_quantile}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_axis,viz_line_set_viewport,
 viz_add_label,viz_node_set_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var x:[f64;100]=[0.0;100]
 var y:[f64;100]=[0.0;100]
 var i:i64=0
 while i<20 {
  x[i as usize]=i as f64
  let sign:f64=if i%2==0 {1.0} else {-1.0}
  y[i as usize]=2.0+3.0*(i as f64)+sign*(0.2+0.1*(i as f64))
  i=i+1
 }
 let model=assess_simple_linear(&x,&y,20)
 assert(model.fit.status==0 && model.shapiro.status==0)
 assert(model.shapiro.w>0.94117882980 && model.shapiro.w<0.94117882983)
 assert(model.shapiro.p>0.2523799854 && model.shapiro.p<0.2523799858)
 var ordered:[f64;100]=[0.0;100]
 i=0
 while i<20 {ordered[i as usize]=model.fit.residuals[i as usize];i=i+1}
 // Local small example sort; the library uses heapsort.
 i=1
 while i<20 {
  let v=ordered[i as usize]
  var j=i
  while j>0 && ordered[(j-1) as usize]>v {ordered[j as usize]=ordered[(j-1) as usize];j=j-1}
  ordered[j as usize]=v
  i=i+1
 }
 var quantiles:[f64;100]=[0.0;100]
 var xs:[f64;1024]=[0.0;1024]
 var ys:[f64;1024]=[0.0;1024]
 var reference:[f64;1024]=[0.0;1024]
 i=0
 while i<20 {
  let q=bca_normal_quantile(((i as f64)+0.625)/20.25)
  assert(q.status==0)
  quantiles[i as usize]=q.value
  xs[i as usize]=q.value
  ys[i as usize]=ordered[i as usize]
  i=i+1
 }
 let guide=ols_fit_simple(&quantiles,&ordered,20)
 assert(guide.status==0)
 i=0
 while i<20 {reference[i as usize]=guide.fitted[i as usize];i=i+1}
 var scene=viz_scene_new()
 let curve=viz_add_line_chart(&!scene,&xs,&ys,20,viz_layout_rect(140,110,600,220),viz_style_rgb(70,180,235))
 let line=viz_add_line_chart(&!scene,&xs,&reference,20,viz_layout_rect(140,110,600,220),viz_style_rgb(245,170,65))
 assert(viz_line_set_viewport(&!scene,curve,-2.0,2.0,-3.0,3.0))
 assert(viz_line_set_viewport(&!scene,line,-2.0,2.0,-3.0,3.0))
 let xa=viz_add_axis(&!scene,-2.0,2.0,4,false,viz_layout_rect(140,348,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,-3.0,3.0,6,true,viz_layout_rect(120,110,1,220),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=83
 title[1]=104
 title[2]=97
 title[3]=112
 title[4]=105
 title[5]=114
 title[6]=111
 title[7]=45
 title[8]=87
 title[9]=105
 title[10]=108
 title[11]=107
 title[12]=32
 title[13]=81
 title[14]=45
 title[15]=81
 title[16]=32
 title[17]=100
 title[18]=105
 title[19]=97
 title[20]=103
 title[21]=110
 title[22]=111
 title[23]=115
 title[24]=116
 title[25]=105
 title[26]=99
 title[27]=32
 title[28]=45
 title[29]=32
 title[30]=115
 title[31]=121
 title[32]=110
 title[33]=116
 title[34]=104
 title[35]=101
 title[36]=116
 title[37]=105
 title[38]=99
 title[39]=32
 title[40]=110
 title[41]=61
 title[42]=50
 title[43]=48
 var method:[i8;64]=[0;64]
 method[0]=66
 method[1]=108
 method[2]=111
 method[3]=109
 method[4]=32
 method[5]=112
 method[6]=111
 method[7]=115
 method[8]=105
 method[9]=116
 method[10]=105
 method[11]=111
 method[12]=110
 method[13]=115
 method[14]=59
 method[15]=32
 method[16]=102
 method[17]=105
 method[18]=116
 method[19]=116
 method[20]=101
