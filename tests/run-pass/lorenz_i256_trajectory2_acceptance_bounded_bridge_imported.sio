//@ run-pass
//@ description: Imported Lorenz i256 bounded trajectory acceptance envelope smoke

use systems::lorenz_i256_trajectory2_manifest_bounded_bridge::*
use systems::lorenz_i256_trajectory2_acceptance_bounded_bridge::*

fn main() -> i64 with Div {
    let manifest_anchor = lorenz_i256_trajectory2_manifest_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 119)
    if manifest_anchor != 846135279 { return 1 }

    let manifest_audit = lorenz_i256_trajectory2_manifest_bounded_bridge_audit_fingerprint(
        manifest_anchor, 314708592, 860125473, 918274650, 341902786,
        294601254, 734260981, 812457306, 73, 118, 2, 1, 1, 1, 1, 1,
        256, 1000000000, 0, 0, 0, 0, 119, 4095)
    if manifest_audit != 579264308 { return 2 }

    let mask = lorenz_i256_trajectory2_acceptance_bounded_mask(
        294601254, 1, 73, 118, 0, 0, 0, 0)
    if mask != 31 { return 3 }

    let bad_metadata_mask = lorenz_i256_trajectory2_acceptance_bounded_mask(
        294601254, 1, 74, 118, 0, 0, 0, 0)
    if bad_metadata_mask != 27 { return 4 }

    let bad_claim_mask = lorenz_i256_trajectory2_acceptance_bounded_mask(
        294601254, 1, 73, 118, 0, 0, 1, 0)
    if bad_claim_mask != 15 { return 5 }

    let readiness = lorenz_i256_trajectory2_acceptance_bounded_readiness_fingerprint(
        294601254, manifest_anchor, 918274650, mask, 73, 118, 120, 256, 1000000000)
    if readiness != 9371853 { return 6 }

    let readiness_reject = lorenz_i256_trajectory2_acceptance_bounded_readiness_fingerprint(
        294601254, manifest_anchor, 918274650, bad_metadata_mask, 74, 118, 120, 256, 1000000000)
    if readiness_reject != 0 - 1 { return 7 }

    let artifact = lorenz_i256_trajectory2_acceptance_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 120)
    if artifact != 769418205 { return 8 }

    let audit = lorenz_i256_trajectory2_acceptance_bounded_bridge_audit_fingerprint(
        artifact, 926035714, 158407263, manifest_anchor, manifest_audit,
        294601254, 918274650, readiness, mask, 73, 118, 1, 1, 1, 1, 1, 1,
        256, 1000000000, 0, 0, 0, 0, 120, 4095)
    if audit != 487690132 { return 9 }
    return 0
}
