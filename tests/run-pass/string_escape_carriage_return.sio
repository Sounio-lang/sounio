//@ run-pass
//@ expect-stdout: CR_ESCAPE_OK 4 13 10
//@ description: `\r` in a string literal is a carriage return (13) on both engines. lean_single used to stop with `lex error: invalid escape sequence`, which #842's `pub use` following exposed through stdlib/http/post.sio (tests/stdlib/http/test_http_e2e.sio).

fn main() -> i64 with IO, Mut, Panic, Div {
    let s = "a\r\nb"
    let n = str_len(s)
    let cr = str_char_at(s, 1) as i64
    let lf = str_char_at(s, 2) as i64
    if n == 4 && cr == 13 && lf == 10 {
        print("CR_ESCAPE_OK ")
    } else {
        print("CR_ESCAPE_FAIL ")
    }
    print_int(n)
    print(" ")
    print_int(cr)
    print(" ")
    print_int(lf)
    println("")
    0
}
