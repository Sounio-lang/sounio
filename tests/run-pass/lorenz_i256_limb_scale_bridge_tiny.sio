//@ run-pass
//@ description: Self-contained Lorenz i256 limb scalar bridge smoke

fn base() -> i64 { return 1000000000 }

fn limb_ok(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x >= base() { return 0 }
    return 1
}

fn mul_small_limb(l0: i64, l1: i64, l2: i64, l3: i64, scale: i64, limb_index: i64) -> i64 {
    if scale < 0 { return 0 - 1 }
    if scale > 1000000 { return 0 - 1 }
    if limb_ok(l0) != 1 { return 0 - 1 }
    if limb_ok(l1) != 1 { return 0 - 1 }
    if limb_ok(l2) != 1 { return 0 - 1 }
    if limb_ok(l3) != 1 { return 0 - 1 }
    let p0 = l0 * scale
    let r0 = p0 % base()
    let c0 = p0 / base()
    let p1 = l1 * scale + c0
    let r1 = p1 % base()
    let c1 = p1 / base()
    let p2 = l2 * scale + c1
    let r2 = p2 % base()
    let c2 = p2 / base()
    let p3 = l3 * scale + c2
    let r3 = p3 % base()
    let c3 = p3 / base()
    if c3 != 0 { return 0 - 1 }
    if limb_index == 0 { return r0 }
    if limb_index == 1 { return r1 }
    if limb_index == 2 { return r2 }
    if limb_index == 3 { return r3 }
    return 0 - 1
}

fn scale_check(
    l0: i64,
    l1: i64,
    l2: i64,
    l3: i64,
    scale: i64,
    e0: i64,
    e1: i64,
    e2: i64,
    e3: i64) -> i64 {
    if mul_small_limb(l0, l1, l2, l3, scale, 0) != e0 { return 0 }
    if mul_small_limb(l0, l1, l2, l3, scale, 1) != e1 { return 0 }
    if mul_small_limb(l0, l1, l2, l3, scale, 2) != e2 { return 0 }
    if mul_small_limb(l0, l1, l2, l3, scale, 3) != e3 { return 0 }
    return 1
}

fn main() -> i64 {
    let sigma_delta = scale_check(200000000, 0, 0, 0, 10, 0, 2, 0, 0)
    if sigma_delta != 1 { return 1 }

    let scale_carry = scale_check(150000000, 1, 0, 0, 10, 500000000, 11, 0, 0)
    if scale_carry != 1 { return 2 }

    let wrong_scale = scale_check(200000000, 0, 0, 0, 10, 1, 2, 0, 0)
    if wrong_scale != 0 { return 3 }

    let invalid_scale = mul_small_limb(1, 0, 0, 0, 1000001, 0)
    if invalid_scale != 0 - 1 { return 4 }

    let invalid_limb = mul_small_limb(1000000000, 0, 0, 0, 10, 0)
    if invalid_limb != 0 - 1 { return 5 }

    let artifact_fp: i64 = 734815269
    let audit_fp: i64 = 216903584
    let instance_fp: i64 = 508642719
    let certificate_fp: i64 = 971304826
    let target_integer_width: i64 = 256
    let limb_base_value: i64 = 1000000000
    let native_i256_evidence_mask: i64 = 0
    let imported_runtime_evidence_mask: i64 = 0
    let public_claim_mask: i64 = 0
    let formal_theorem_ready: i64 = 0
    let bridge_status: i64 = 103
    let ok_mask: i64 = 1023

    if artifact_fp != 734815269 { return 6 }
    if audit_fp != 216903584 { return 7 }
    if instance_fp != 508642719 { return 8 }
    if certificate_fp != 971304826 { return 9 }
    if target_integer_width != 256 { return 10 }
    if limb_base_value != 1000000000 { return 11 }
    if native_i256_evidence_mask != 0 { return 12 }
    if imported_runtime_evidence_mask != 0 { return 13 }
    if public_claim_mask != 0 { return 14 }
    if formal_theorem_ready != 0 { return 15 }
    if bridge_status != 103 { return 16 }
    if ok_mask != 1023 { return 17 }
    return 0
}
