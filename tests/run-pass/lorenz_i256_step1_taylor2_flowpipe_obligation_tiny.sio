//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 Taylor-2 flowpipe obligation stays local

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let endpoint_mask: i64 = 7
    let time_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_mask: i64 = 127
    var composition_mask: i64 = 0
    if endpoint_mask == 7 { composition_mask = composition_mask + 1 }
    if time_mask == 7 { composition_mask = composition_mask + 2 }
    if response_mask == 127 { composition_mask = composition_mask + 4 }
    if remainder_mask == 127 { composition_mask = composition_mask + 8 }
    if composition_mask != 15 { return 1 }

    let local_obligation_mask: i64 = composition_mask
    let local_proof_mask: i64 = 0
    let global_claim_mask: i64 = 0
    let status: i64 = 20
    let ok_mask: i64 = 255
    if local_obligation_mask != 15 { return 2 }
    if local_proof_mask != 0 { return 3 }
    if global_claim_mask != 0 { return 4 }

    var inst: i64 = 1493
    inst = mix(inst, 1, 5351)
    inst = mix(inst, 180607828, 5351)
    inst = mix(inst, 551960823, 5351)
    inst = mix(inst, 473585568, 5351)
    inst = mix(inst, 790380830, 5351)
    inst = mix(inst, 496675613, 5351)
    inst = mix(inst, 467471545, 5351)
    inst = mix(inst, 265853299, 5351)
    inst = mix(inst, 919608627, 5351)
    inst = mix(inst, 301347724, 5351)
    inst = mix(inst, 777254975, 5351)
    inst = mix(inst, endpoint_mask, 5351)
    inst = mix(inst, time_mask, 5351)
    inst = mix(inst, response_mask, 5351)
    inst = mix(inst, remainder_mask, 5351)
    inst = mix(inst, composition_mask, 5351)
    inst = mix(inst, local_obligation_mask, 5351)
    inst = mix(inst, local_proof_mask, 5351)
    inst = mix(inst, global_claim_mask, 5351)
    inst = mix(inst, status, 5351)
    if inst != 180287901 { return 5 }

    var cert: i64 = 1499
    cert = mix(cert, inst, 5381)
    cert = mix(cert, endpoint_mask, 5381)
    cert = mix(cert, time_mask, 5381)
    cert = mix(cert, response_mask, 5381)
    cert = mix(cert, remainder_mask, 5381)
    cert = mix(cert, composition_mask, 5381)
    cert = mix(cert, local_obligation_mask, 5381)
    cert = mix(cert, local_proof_mask, 5381)
    cert = mix(cert, global_claim_mask, 5381)
    cert = mix(cert, status, 5381)
    cert = mix(cert, ok_mask, 5381)
    if cert != 534209661 { return 6 }

    var artifact: i64 = 1511
    artifact = mix(artifact, inst, 5387)
    artifact = mix(artifact, cert, 5387)
    artifact = mix(artifact, 15, 5387)
    artifact = mix(artifact, 1, 5387)
    artifact = mix(artifact, composition_mask, 5387)
    artifact = mix(artifact, local_obligation_mask, 5387)
    artifact = mix(artifact, local_proof_mask, 5387)
    artifact = mix(artifact, global_claim_mask, 5387)
    artifact = mix(artifact, status, 5387)
    artifact = mix(artifact, ok_mask, 5387)
    if artifact != 90632144 { return 7 }

    var audit: i64 = 1523
    audit = mix(audit, artifact, 5393)
    audit = mix(audit, inst, 5393)
    audit = mix(audit, cert, 5393)
    audit = mix(audit, 180607828, 5393)
    audit = mix(audit, 551960823, 5393)
    audit = mix(audit, 473585568, 5393)
    audit = mix(audit, 790380830, 5393)
    audit = mix(audit, 496675613, 5393)
    audit = mix(audit, 467471545, 5393)
    audit = mix(audit, 265853299, 5393)
    audit = mix(audit, 919608627, 5393)
    audit = mix(audit, 301347724, 5393)
    audit = mix(audit, 777254975, 5393)
    audit = mix(audit, 1, 5393)
    audit = mix(audit, status, 5393)
    audit = mix(audit, ok_mask, 5393)
    if audit != 922642400 { return 8 }
    return 0
}
