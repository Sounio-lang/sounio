//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_heatmap_raster_smooth, quality_heatmap_config_default, quality_colormap_viridis}

fn main() -> i64 with IO, Mut, Panic, Div {
    var data: [f64; 4096] = [0.0; 4096]
    data[0] = 0.0
    data[1] = 0.25
    data[2] = 0.5
    data[3] = 0.75
    data[4] = 0.25
    data[5] = 0.5
    data[6] = 0.75
    data[7] = 1.0
    data[8] = 0.5
    data[9] = 0.75
    data[10] = 1.0
    data[11] = 0.75
    data[12] = 0.75
    data[13] = 1.0
    data[14] = 0.75
    data[15] = 1.0

    var s = surface_new(72, 72)
    let cfg = quality_heatmap_config_default()
    s = plot_heatmap_raster_smooth(s, &data, 4, 4, cfg)

    let low_r = surface_get_pixel_r(&s, 21, 50)
    let low_b = surface_get_pixel_b(&s, 21, 50)
    if low_b <= low_r {
        print("FAIL low heatmap corner should be purple/blue dominant\n")
        return 1
    }

    let high_r = surface_get_pixel_r(&s, 50, 21)
    let high_g = surface_get_pixel_g(&s, 50, 21)
    let high_b = surface_get_pixel_b(&s, 50, 21)
    if high_r <= 180 || high_g <= 160 || high_b >= 120 {
        print("FAIL high heatmap corner should be yellow-green dominant\n")
        return 2
    }

    let center_r = surface_get_pixel_r(&s, 36, 36)
    let center_g = surface_get_pixel_g(&s, 36, 36)
    let center_b = surface_get_pixel_b(&s, 36, 36)
    if center_g <= center_r || center_g <= center_b {
        print("FAIL bilinear center should land in green-dominant middle range\n")
        return 3
    }

    let axis_r = surface_get_pixel_r(&s, 20, 36)
    let axis_b = surface_get_pixel_b(&s, 20, 36)
    if axis_r > 80 || axis_b > 120 {
        print("FAIL quality heatmap vertical axis missing\n")
        return 4
    }

    let c0 = quality_colormap_viridis(0.0)
    let c1 = quality_colormap_viridis(1.0)
    if c0.b <= c0.r {
        print("FAIL colormap low endpoint\n")
        return 10
    }
    if c1.r <= 200 || c1.g <= 200 || c1.b >= 80 {
        print("FAIL colormap high endpoint\n")
        return 11
    }

    print("PASS graphics_quality_heatmap_smoke\n")
    0
}
