//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Mut, Panic {
    var i: i64 = 0
    var total: i64 = 0
    while i < 3 {
        let permit = Permit { id: i }
        total = total + spend(permit)
        i = i + 1
    }
    assert(total == 3)
    0
}
