//@ run-pass
//@ timeout: 60
//@ expect-stdout-contains: STRARR ref_index=abc|
//@ expect-stdout-contains: STRARR ref_let=abc|
//@ expect-stdout-contains: STRARR mut_index=xyz|
//@ expect-stdout-contains: STRARR value_index=abc|
//@ expect-stdout-contains: STRARR field_index=abc|
//@ expect-stdout-contains: STRARR let_ref_index=abc|
//@ expect-stdout-contains: STRARR int_ref_index=42|
//@ expect-stdout-contains: STRARR_DONE
//@ description: an element of a `[string; N]` parameter (by value, or through `&` / `&!` as `(*names)[i]`) or of `let r = &names` prints as a string, not as its pointer word
//
// `print((*names)[i])` with `names: &[string; 20]` printed an integer such
// as 4207508 (the address of the string) where `abc` was expected, and so did
// `let s = (*names)[i]; print(s)` and `print(names[i])` on a by-value
// `[string; 20]` parameter. The value was right (an annotated
// `let t: string = (*names)[i]` printed `abc`): the print dispatch had no
// evidence that the element is a string, because only `let` arrays recorded
// their element type, and the index classifier only accepted a bare array
// name, not `(*r)[i]`. The struct path `(*q).n[i]` already worked.

pub struct NS {
    pub n: [string; 20],
}

fn by_ref(names: &[string; 20], i: i32) with IO, Mut {
    print("STRARR ref_index=")
    print((*names)[i])
    println("|")
    let s = (*names)[i]
    print("STRARR ref_let=")
    print(s)
    println("|")
}

fn by_mut(names: &![string; 20], i: i32) with IO, Mut {
    (*names)[i] = "xyz"
    print("STRARR mut_index=")
    print((*names)[i])
    println("|")
}

fn by_value(names: [string; 20], i: i32) with IO, Mut {
    print("STRARR value_index=")
    print(names[i])
    println("|")
}

fn by_field(q: &NS, i: i32) with IO, Mut {
    print("STRARR field_index=")
    print((*q).n[i])
    println("|")
}

fn ints(xs: &[i64; 4], i: i32) with IO, Mut {
    print("STRARR int_ref_index=")
    print((*xs)[i])
    println("|")
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var names: [string; 20] = [""; 20]
    names[1] = "abc"
    by_ref(&names, 1)
    by_value(names, 1)
    let q = NS { n: names }
    by_field(&q, 1)
    by_mut(&!names, 2)
    let r = &names
    print("STRARR let_ref_index=")
    print((*r)[1])
    println("|")
    var xs: [i64; 4] = [0; 4]
    xs[3] = 42
    ints(&xs, 3)
    println("STRARR_DONE")
    return 0
}
