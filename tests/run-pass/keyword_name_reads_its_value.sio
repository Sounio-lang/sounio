//@ run-pass
//@ expect-stdout-contains: 1
//@ description: ADR-015 row 10 -- `affine`, `linear` and `study` are ordinary names outside keyword position. lean_single used to accept them as binding names and then read each use as 0 (`let affine = 1; println(affine)` printed 0); it was first made to refuse them, and now both engines read the value. Reverses the earlier refusal pinned here as keyword_name_not_read_as_zero.

fn main() with IO {
    let affine = 1
    println(affine)
}
