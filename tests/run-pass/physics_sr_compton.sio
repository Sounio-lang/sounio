//@ run-pass
//@ expect-stdout: PHYSICS_SR_COMPTON_PASS
use physics::sr::{compton_shift}
fn main() with IO, Mut, Div, Panic {
    let (shift, angular_u) = compton_shift(1.57079632679489661923, 0.01)
    let error = shift / 2.42631023538031712e-12 - 1.0
    assert(error < 1.0e-10 && error > 0.0 - 1.0e-10)
    let u_error = angular_u / 2.42631023538031712e-14 - 1.0
    assert(u_error < 1.0e-10 && u_error > 0.0 - 1.0e-10)
    println("PHYSICS_SR_COMPTON_PASS")
    0
}
