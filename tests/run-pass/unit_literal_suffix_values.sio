//@ run-pass
//@ requires: madaros
//@ expect-stdout: unit literal values: PASS

unit mg_dL;
unit ft;

fn glucose_value(x: mg_dL) -> f64 with Mut { x }

fn main() -> i32 with IO, Mut, Panic, Div {
    let glucose = 140.0<mg_dL>
    let distance = 10<m>
    // A bare redeclaration must preserve the builtin dimension and scale.
    let foot = 1.0<ft>
    let metres = (foot as m) as f64
    let delta = metres - 0.3048
    if glucose_value(glucose) == 140.0 && (distance as f64) == 10.0
        && delta > -1.0e-9 && delta < 1.0e-9 && 1.0 < 2.0 {
        print("unit literal values: PASS\n")
        return 0
    }
    return 1
}
