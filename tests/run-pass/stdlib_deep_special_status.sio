//@ run-pass
//@ expect-stdout: STDLIB_DEEP_SPECIAL_STATUS_PASS
use special::checked_gamma_beta::{gamma_pq_checked,beta_pq_checked,gamma_inverse_checked,beta_inverse_checked}
fn main()->i32 with IO,Mut,Div,Panic {
 let domain=gamma_pq_checked(0.0,1.0,1000,1.0e-12)
 assert(domain.status==1 && !domain.lower_available && !domain.log_upper_available)
 let nonfinite=beta_pq_checked(1.0,1.0,0.0/0.0,1000,1.0e-12)
 assert(nonfinite.status==2)
 let range=gamma_pq_checked(1000001.0,1.0,1000,1.0e-12)
 assert(range.status==5)
 let options=gamma_pq_checked(1.0,1.0,0,1.0e-12)
 assert(options.status==1)
 let exhausted=gamma_pq_checked(0.5,0.5,1,1.0e-12)
 assert(exhausted.status==3 && exhausted.iterations==1 && !exhausted.lower_available)
 let endpoint=gamma_pq_checked(2.0,0.0,1000,1.0e-12)
 assert(endpoint.status==0 && endpoint.lower==0.0 && endpoint.upper==1.0)
 assert(endpoint.lower_available && endpoint.upper_available && !endpoint.log_lower_available && endpoint.log_upper_available)
 let beta_end=beta_pq_checked(2.0,3.0,1.0,1000,1.0e-12)
 assert(beta_end.status==0 && beta_end.lower==1.0 && beta_end.log_lower_available && !beta_end.log_upper_available)
 let tiny=gamma_pq_checked(1.0,1000.0,1000,1.0e-12)
 assert(tiny.status==0 && !tiny.upper_available && tiny.log_upper_available && tiny.lower_available)
 assert(tiny.log_upper> -1000.00000001 && tiny.log_upper< -999.99999999)
 let unbounded=gamma_inverse_checked(1.0,0.0,true,1000,1.0e-10)
 assert(unbounded.status==5)
 let origin=gamma_inverse_checked(1.0,1.0,true,1000,1.0e-10)
 assert(origin.status==0 && origin.value==0.0 && origin.forward_log_available)
 let finite_end=beta_inverse_checked(1.0,1.0,0.0,true,1000,1.0e-10)
 assert(finite_end.status==0 && finite_end.value==1.0 && !finite_end.forward_log_available)
 let inverse_budget=gamma_inverse_checked(2.0,0.2,false,1,1.0e-10)
 assert(inverse_budget.status!=0)
 println("STDLIB_DEEP_SPECIAL_STATUS_PASS")
 0
}
