//@ run-pass
// Testemunha de que A1–A10 sao CONSISTENTES: uma operacao NAO-ASSOCIATIVA, estritamente
// monotona fora do aniquilador, positiva, com aniquilacao FINA (fronteira, nao regiao).
//
// Construcao: parte da forma de unidade de Cohen & Narens (1979, Thm 3.3), a∘b = b·f(a/b), em
// que a monotonicidade nos dois argumentos equivale a f crescente e f(t)/t decrescente, e a
// positividade a f(t) > 1 e f(t) > t. Escolhendo
//     f(t) = t + 1 + eps·t/(1+t)
// todas essas condicoes valem GLOBALMENTE, e a operacao resultante e
//     a ∘ b = a + b + eps·ab/(a+b)
// que NAO e associativa para eps > 0 (a adicao pura, eps = 0, e o caso degenerado associativo
// que ja era a testemunha de A1–A9 em CONSISTENCY.md).
//
// Teto: X = (0,1) uniao {z}. Vale o valor se < 1; vale z se = 1; indefinido se > 1. A
// aniquilacao e FINA porque ∘ e estritamente crescente em b, logo para cada a existe NO MAXIMO
// UM b com a∘b = 1.
//
// Verifica numericamente, e nao por algebra de cabeca.

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn op(a: f64, b: f64, eps: f64) -> f64 with Div, Panic {
    a + b + eps * a * b / (a + b)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let eps: f64 = 1.0
    var falhas: i64 = 0

    // ── 1. MONOTONICIDADE ESTRITA nos dois argumentos, em malha.
    var viol_mono: i64 = 0
    var i: i64 = 1
    while i < 40 {
        var j: i64 = 1
        while j < 40 {
            let a = (i as f64) / 100.0
            let b = (j as f64) / 100.0
            let da = a + 0.005
            let db = b + 0.005
            if !(op(da, b, eps) > op(a, b, eps)) { viol_mono = viol_mono + 1 }
            if !(op(a, db, eps) > op(a, b, eps)) { viol_mono = viol_mono + 1 }
            j = j + 1
        }
        i = i + 1
    }
    print("MONOTONICIDADE_VIOLACOES "); print_int(viol_mono)
    if viol_mono != 0 { falhas = falhas + 1 }

    // ── 2. POSITIVIDADE: a∘b > a e a∘b > b.
    var viol_pos: i64 = 0
    i = 1
    while i < 40 {
        var j2: i64 = 1
        while j2 < 40 {
            let a = (i as f64) / 100.0
            let b = (j2 as f64) / 100.0
            let v = op(a, b, eps)
            if !(v > a) { viol_pos = viol_pos + 1 }
            if !(v > b) { viol_pos = viol_pos + 1 }
            j2 = j2 + 1
        }
        i = i + 1
    }
    print("POSITIVIDADE_VIOLACOES "); print_int(viol_pos)
    if viol_pos != 0 { falhas = falhas + 1 }

    // ── 3. A10 — NAO-ASSOCIATIVIDADE. Testemunha explicita, com os dois lados definidos (< 1).
    let a: f64 = 1.0 / 9.0
    let b: f64 = 2.0 / 9.0
    let c: f64 = 3.0 / 9.0
    let esq = op(op(a, b, eps), c, eps)
    let dir = op(a, op(b, c, eps), eps)
    print("ESQUERDA_MILESIMOS "); print_int((esq * 1000.0) as i64)
    print("DIREITA_MILESIMOS "); print_int((dir * 1000.0) as i64)
    print("AMBOS_DEFINIDOS_ABAIXO_DE_1 "); print_int(if esq < 1.0 && dir < 1.0 { 1 } else { 0 })
    let difere = abs_f64(esq - dir) > 0.000001
    print("NAO_ASSOCIATIVO "); print_int(if difere { 1 } else { 0 })
    if !difere { println("FALHA: a testemunha associou — A10 nao demonstrado"); falhas = falhas + 1 }
    if !(esq < 1.0 && dir < 1.0) { println("FALHA: testemunha fora do dominio"); falhas = falhas + 1 }

    // ── 4. A9 — ANIQUILACAO FINA. Para cada a, quantos b na malha dao a∘b = 1?
    //     Como ∘ e estritamente crescente em b, tem de ser no maximo um. Conta as TRAVESSIAS
    //     do nivel 1, que e o teste discreto correto.
    var max_travessias: i64 = 0
    i = 1
    while i < 40 {
        let aa = (i as f64) / 100.0
        var travessias: i64 = 0
        var j3: i64 = 1
        while j3 < 200 {
            let b1 = (j3 as f64) / 100.0
            let b2 = ((j3 + 1) as f64) / 100.0
            let v1 = op(aa, b1, eps)
            let v2 = op(aa, b2, eps)
            if v1 < 1.0 && v2 >= 1.0 { travessias = travessias + 1 }
            j3 = j3 + 1
        }
        if travessias > max_travessias { max_travessias = travessias }
        i = i + 1
    }
    print("MAX_TRAVESSIAS_DO_NIVEL_1 "); print_int(max_travessias)
    if max_travessias > 1 { println("FALHA: aniquilacao nao e fina"); falhas = falhas + 1 }

    // ── 5. A8 — aniquilacao NAO VAZIA: existe a com a∘a = 1 exatamente.
    //     a∘a = 2a + eps·a/2, logo a = 1/(2 + eps/2). Confere que cai em (0,1).
    let a_star = 1.0 / (2.0 + eps / 2.0)
    let v_star = op(a_star, a_star, eps)
    print("A_ESTRELA_MILESIMOS "); print_int((a_star * 1000.0) as i64)
    print("A_ESTRELA_COMPOSTO_MILESIMOS "); print_int((v_star * 1000.0) as i64)
    if !(a_star > 0.0 && a_star < 1.0) { println("FALHA: a* fora de (0,1)"); falhas = falhas + 1 }
    if abs_f64(v_star - 1.0) > 0.000001 { println("FALHA: a*∘a* nao da 1"); falhas = falhas + 1 }

    // ── 6. A3 — DEFINIBILIDADE LOCAL: o dominio e fechado para baixo, por monotonicidade.
    //     Se a∘b <= 1 e w <= a, u <= b, entao w∘u <= a∘b <= 1.
    var viol_a3: i64 = 0
    i = 1
    while i < 30 {
        var j4: i64 = 1
        while j4 < 30 {
            let aa = (i as f64) / 50.0
            let bb = (j4 as f64) / 50.0
            if op(aa, bb, eps) <= 1.0 {
                let w = aa / 2.0
                let u = bb / 2.0
                if !(op(w, u, eps) <= 1.0) { viol_a3 = viol_a3 + 1 }
            }
            j4 = j4 + 1
        }
        i = i + 1
    }
    print("DEFINIBILIDADE_LOCAL_VIOLACOES "); print_int(viol_a3)
    if viol_a3 != 0 { falhas = falhas + 1 }

    if falhas == 0 { println("modelo A1-A10: PASS") } else { println("modelo A1-A10: FAIL") }
    falhas
}
