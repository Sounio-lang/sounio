//@ run-pass
//@ description: Tiny portfolio v40 smoke for proof-trace interop receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var interop_fp: i64 = 431
    interop_fp = mix(interop_fp, 53646245, 2767)
    interop_fp = mix(interop_fp, 423305090, 2767)
    interop_fp = mix(interop_fp, 620031252, 2767)
    interop_fp = mix(interop_fp, 258927862, 2767)
    interop_fp = mix(interop_fp, 438043475, 2767)
    interop_fp = mix(interop_fp, 46718256, 2767)
    interop_fp = mix(interop_fp, 786321129, 2767)
    interop_fp = mix(interop_fp, 389121447, 2767)
    interop_fp = mix(interop_fp, 528140838, 2767)
    interop_fp = mix(interop_fp, 409028717, 2767)
    interop_fp = mix(interop_fp, 6, 2767)
    interop_fp = mix(interop_fp, 8, 2767)
    interop_fp = mix(interop_fp, 63, 2767)
    if interop_fp != 90120367 { return 1 }

    var audit_fp: i64 = 439
    audit_fp = mix(audit_fp, interop_fp, 2777)
    audit_fp = mix(audit_fp, 812428526, 2777)
    audit_fp = mix(audit_fp, 845057161, 2777)
    audit_fp = mix(audit_fp, 6, 2777)
    audit_fp = mix(audit_fp, 8, 2777)
    audit_fp = mix(audit_fp, 63, 2777)
    if audit_fp != 336688074 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 43, 1103)
    entry_fp = mix(entry_fp, interop_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 43, 1103)
    if entry_fp != 15302992 { return 3 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 40, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, 788938861, 1951)
    readiness_fp = mix(readiness_fp, 149225904, 1951)
    readiness_fp = mix(readiness_fp, 166966176, 1951)
    readiness_fp = mix(readiness_fp, 662126478, 1951)
    readiness_fp = mix(readiness_fp, 255705570, 1951)
    if readiness_fp != 983550353 { return 4 }

    if interop_fp == 90120368 { return 5 }
    return 0
}
