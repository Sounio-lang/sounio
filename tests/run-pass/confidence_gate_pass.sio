//@ run-pass
// Confidence gate: high-confidence measurement passes the gate.
// measure(100.0, uncertainty: 0.5) → relative uncertainty = 0.5/100 = 0.005
// confidence = 1.0 - 0.005 = 0.995 (995/1000) → passes minconf: 0.95 (950/1000)

fn safe_dosing(weight: f64, clearance: f64) -> f64 with Mut, Epistemic(minconf: 0.95) {
    return weight * clearance
}

fn main() with IO, Mut, Epistemic {
    let kw: Knowledge<f64> = measure(70.0, uncertainty: 0.5)
    let kc: Knowledge<f64> = measure(5.0, uncertainty: 0.1)
    let w = kw.value
    let c = kc.value
    let dose = safe_dosing(w, c)
    print("dose="); println(dose)
    print("PASS\n")
}
