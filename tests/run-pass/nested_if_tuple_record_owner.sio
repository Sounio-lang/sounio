//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: NESTED IF TUPLE RECORD OWNER PASS
// A representative callee may be inferred only when both nested arms have the
// same record name in the same tuple slot; unrelated tuple fields remain scalar.
struct TupleOwner {alpha:f64,point_available:bool}
fn tuple_owner_left()->(TupleOwner,i64) {(TupleOwner{alpha:1.25,point_available:true},7)}
fn tuple_owner_right()->(TupleOwner,i64) {(TupleOwner{alpha:2.5,point_available:false},9)}
fn tuple_owner_second_left()->(i64,TupleOwner) {(11,TupleOwner{alpha:1.25,point_available:true})}
fn tuple_owner_second_right()->(i64,TupleOwner) {(13,TupleOwner{alpha:2.5,point_available:false})}
fn tuple_owner_read(owner:&TupleOwner)->f64 {owner.alpha}
fn tuple_owner_case(outer:bool,inner:bool) with Mut,Div,Panic {
 let pair=if outer {if inner {tuple_owner_left()}else{tuple_owner_right()}}else{if inner {tuple_owner_right()}else{tuple_owner_left()}}
 let expected:f64=if outer==inner {1.25}else{2.5}
 let owner=pair.0
 assert(f64_to_bits(owner.alpha)==f64_to_bits(expected))
 assert(f64_to_bits(tuple_owner_read(&owner))==f64_to_bits(expected))
 let second=if outer {if inner {tuple_owner_second_left()}else{tuple_owner_second_right()}}else{if inner {tuple_owner_second_right()}else{tuple_owner_second_left()}}
 let second_owner=second.1
 assert(f64_to_bits(second_owner.alpha)==f64_to_bits(expected))
 assert(f64_to_bits(tuple_owner_read(&second_owner))==f64_to_bits(expected))
 let scalar=if outer {if inner {7}else{9}}else{if inner {9}else{7}}
 let want:i64=if outer==inner {7}else{9}
 assert(pair.1==want && scalar==want)
}
fn main()->i32 with IO,Mut,Div,Panic {
 tuple_owner_case(true,true)
 tuple_owner_case(true,false)
 tuple_owner_case(false,true)
 tuple_owner_case(false,false)
 println("NESTED IF TUPLE RECORD OWNER PASS")
 0
}
