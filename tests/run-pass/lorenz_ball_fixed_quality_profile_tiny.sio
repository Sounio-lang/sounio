//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz ball-fixed five-step enclosure quality-profile smoke

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn max3_i64(a: i64, b: i64, c: i64) -> i64 {
    if a >= b {
        if a >= c { return a }
        return c
    }
    if b >= c { return b }
    return c
}

fn min3_i64(a: i64, b: i64, c: i64) -> i64 {
    if a <= b {
        if a <= c { return a }
        return c
    }
    if b <= c { return b }
    return c
}

fn quality_profile_fingerprint(scale: i64, steps: i64,
                               trajectory_manifest_fp: i64,
                               radius_budget_fp: i64,
                               final_xr: i64, final_yr: i64, final_zr: i64,
                               x_radius_cap: i64, y_radius_cap: i64, z_radius_cap: i64,
                               x_lo: i64, x_hi: i64,
                               y_lo: i64, y_hi: i64,
                               z_lo: i64, z_hi: i64) -> i64 with Div {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if trajectory_manifest_fp != 508132668 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    if final_xr < 0 { return 0 - 1 }
    if final_yr < 0 { return 0 - 1 }
    if final_zr < 0 { return 0 - 1 }
    if x_radius_cap < final_xr { return 0 - 1 }
    if y_radius_cap < final_yr { return 0 - 1 }
    if z_radius_cap < final_zr { return 0 - 1 }
    if x_hi < x_lo { return 0 - 1 }
    if y_hi < y_lo { return 0 - 1 }
    if z_hi < z_lo { return 0 - 1 }

    let x_slack = x_radius_cap - final_xr
    let y_slack = y_radius_cap - final_yr
    let z_slack = z_radius_cap - final_zr
    let total_slack = x_slack + y_slack + z_slack
    let radius_sum = final_xr + final_yr + final_zr
    let cap_sum = x_radius_cap + y_radius_cap + z_radius_cap
    if cap_sum <= 0 { return 0 - 1 }

    let max_radius = max3_i64(final_xr, final_yr, final_zr)
    let min_radius = min3_i64(final_xr, final_yr, final_zr)
    if min_radius <= 0 { return 0 - 1 }

    let aspect_q = max_radius / min_radius
    let aspect_r = max_radius - (aspect_q * min_radius)
    let radius_fill_ppm = (radius_sum * 1000000) / cap_sum
    let slack_ppm = (total_slack * 1000000) / cap_sum
    let x_width = x_hi - x_lo
    let y_width = y_hi - y_lo
    let z_width = z_hi - z_lo
    let box_volume = x_width * y_width * z_width

    if x_slack != 6634 { return 0 - 1 }
    if y_slack != 5360 { return 0 - 1 }
    if z_slack != 7552 { return 0 - 1 }
    if total_slack != 19546 { return 0 - 1 }
    if radius_sum != 605454 { return 0 - 1 }
    if max_radius != 319640 { return 0 - 1 }
    if min_radius != 42448 { return 0 - 1 }
    if aspect_q != 7 { return 0 - 1 }
    if aspect_r != 22504 { return 0 - 1 }
    if radius_fill_ppm != 968726 { return 0 - 1 }
    if slack_ppm != 31273 { return 0 - 1 }
    if x_width != 486732 { return 0 - 1 }
    if y_width != 639280 { return 0 - 1 }
    if z_width != 84896 { return 0 - 1 }
    if box_volume != 26416072366172160 { return 0 - 1 }

    var acc: i64 = 89
    acc = quality_mix(acc, scale)
    acc = quality_mix(acc, steps)
    acc = quality_mix(acc, trajectory_manifest_fp)
    acc = quality_mix(acc, radius_budget_fp)
    acc = quality_mix(acc, final_xr)
    acc = quality_mix(acc, final_yr)
    acc = quality_mix(acc, final_zr)
    acc = quality_mix(acc, x_radius_cap)
    acc = quality_mix(acc, y_radius_cap)
    acc = quality_mix(acc, z_radius_cap)
    acc = quality_mix(acc, x_slack)
    acc = quality_mix(acc, y_slack)
    acc = quality_mix(acc, z_slack)
    acc = quality_mix(acc, total_slack)
    acc = quality_mix(acc, radius_sum)
    acc = quality_mix(acc, max_radius)
    acc = quality_mix(acc, min_radius)
    acc = quality_mix(acc, aspect_q)
    acc = quality_mix(acc, aspect_r)
    acc = quality_mix(acc, radius_fill_ppm)
    acc = quality_mix(acc, slack_ppm)
    acc = quality_mix(acc, x_width)
    acc = quality_mix(acc, y_width)
    acc = quality_mix(acc, z_width)
    acc = quality_mix(acc, box_volume)
    return acc
}

fn main() -> i64 with Div {
    if 250000 - 243366 != 6634 { return 2 }
    if 325000 - 319640 != 5360 { return 3 }
    if 50000 - 42448 != 7552 { return 4 }
    if 243366 + 319640 + 42448 != 605454 { return 5 }
    if 319640 / 42448 != 7 { return 6 }
    if 319640 - (7 * 42448) != 22504 { return 7 }
    if ((605454 * 1000000) / 625000) != 968726 { return 8 }
    if ((19546 * 1000000) / 625000) != 31273 { return 9 }
    if 1479682 - 992950 != 486732 { return 10 }
    if 2661619 - 2022339 != 639280 { return 11 }
    if 993526 - 908630 != 84896 { return 12 }
    if (486732 * 639280) * 84896 != 26416072366172160 { return 16 }

    let fp = quality_profile_fingerprint(
        1000000, 5, 508132668, 565673886,
        243366, 319640, 42448,
        250000, 325000, 50000,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526)
    if fp == (0 - 1) { return 17 }
    if fp != 70877465 { return 1 }

    if quality_profile_fingerprint(
        1000000, 5, 508132669, 565673886,
        243366, 319640, 42448,
        250000, 325000, 50000,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526) != (0 - 1) { return 13 }
    if quality_profile_fingerprint(
        1000000, 5, 508132668, 565673886,
        243366, 319640, 42448,
        243365, 325000, 50000,
        992950, 1479682,
        2022339, 2661619,
        908630, 993526) != (0 - 1) { return 14 }
    if quality_profile_fingerprint(
        1000000, 5, 508132668, 565673886,
        243366, 319640, 42448,
        250000, 325000, 50000,
        1479682, 992950,
        2022339, 2661619,
        908630, 993526) != (0 - 1) { return 15 }

    return 0
}
