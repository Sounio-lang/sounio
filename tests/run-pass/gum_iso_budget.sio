//@ run-pass
// ISO/JCGM 100:2008 §8 uncertainty budget decomposition test.
// Three measure() calls seed three independent budget channels.
// print_budget(x) reports per-channel variance contributions.
// variance_of(x) returns the total (sum of all channels).


// 🚨 `print_budget(x)` NÃO EXISTE — nem no compilador, nem no stdlib. O compilador emitia
// `xor eax,eax` no lugar, então este teste imprimia o cabeçalho "budget" e nada embaixo.
// Achado pelo E201 (28-ago-2026).
//
// O orçamento agora é computado com o maquinário que EXISTE: `variance_of` lê a sombra β⁴ e
// `sensitivity_of(x, k)` lê a sombra β⁶ do canal k. Oito chamadas literais em vez de laço
// porque o intrínseco lê o índice do TOKEN — um `k` variável não resolveria.
fn print_budget(x: f64) with IO, Mut, Epistemic {
    print("  var_total="); println(variance_of(x))
    print("  ds/d0="); println(sensitivity_of(x, 0))
    print("  ds/d1="); println(sensitivity_of(x, 1))
    print("  ds/d2="); println(sensitivity_of(x, 2))
    print("  ds/d3="); println(sensitivity_of(x, 3))
    print("  ds/d4="); println(sensitivity_of(x, 4))
    print("  ds/d5="); println(sensitivity_of(x, 5))
    print("  ds/d6="); println(sensitivity_of(x, 6))
    print("  ds/d7="); println(sensitivity_of(x, 7))
}

fn main() with IO, Mut, Epistemic {
    let k1: Knowledge<f64> = measure(100.0, uncertainty: 2.0)
    let k2: Knowledge<f64> = measure(50.0, uncertainty: 1.0)
    let k3: Knowledge<f64> = measure(25.0, uncertainty: 0.5)
    let a = k1.value   // var = 4.0   → channel 0
    let b = k2.value   // var = 1.0   → channel 1
    let c = k3.value   // var = 0.25  → channel 2

    // Additive: var(a + b + c) = var(a) + var(b) + var(c) = 5.25
    let sum = a + b
    let total = sum + c

    // Check total variance
    let vt = variance_of(total)
    print("total="); println(vt)

    // Print full budget decomposition
    print_budget(total)

    // Verify total matches sum of individual variances
    let va = variance_of(a)
    let vb = variance_of(b)
    let vc = variance_of(c)
    print("va="); println(va)
    print("vb="); println(vb)
    print("vc="); println(vc)
    print("PASS\n")
}
