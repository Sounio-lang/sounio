//@ run-pass
//@ description: The string escape gate supplies a binary input path and UTF-8 argv.

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    // Standalone run-pass invocations do not supply the gate's input file.
    if arg_count() == 0 { return 0 }
    let path = get_arg(0)
    assert(str_len(path) > 0)
    let argument = get_arg(1)
    assert(str_len(argument) == 6)
    assert(str_eq(argument, "\u{e9}\u{1f600}"))
    let contents = read_file(path)
    assert(str_len(contents) == 5)
    assert(str_eq(contents, "\0a\0b\0"))
    println(contents)
    println(argument)
    0
}
