//@ run-pass
//@ description: Imported Lorenz i256 sigma*(y-x) term bridge smoke

use systems::lorenz_i256_signed_delta_bridge::*
use systems::lorenz_i256_limb_scale_bridge::*
use systems::lorenz_i256_sigma_x_term_bridge::*

fn main() -> i64 with Div {
    let positive = lorenz_i256_sigma_x_term_check(
        150000000, 1, 0, 0, 950000000, 0, 0, 0, 1, 0, 2, 0, 0)
    if positive != 1 { return 1 }

    let negative = lorenz_i256_sigma_x_term_check(
        950000000, 0, 0, 0, 150000000, 1, 0, 0, 0 - 1, 0, 2, 0, 0)
    if negative != 1 { return 2 }

    let zero = lorenz_i256_sigma_x_term_check(
        950000000, 0, 0, 0, 950000000, 0, 0, 0, 0, 0, 0, 0, 0)
    if zero != 1 { return 3 }

    let delta_anchor = lorenz_i256_signed_delta_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 104)
    if delta_anchor != 492681735 { return 4 }

    let delta_audit = lorenz_i256_signed_delta_bridge_audit_fingerprint(
        delta_anchor, 604913728, 195740286, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 104, 1023)
    if delta_audit != 837260419 { return 5 }

    let scale_anchor = lorenz_i256_limb_scale_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 103)
    if scale_anchor != 734815269 { return 6 }

    let scale_audit = lorenz_i256_limb_scale_bridge_audit_fingerprint(
        scale_anchor, 508642719, 971304826, 1, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 103, 1023)
    if scale_audit != 216903584 { return 7 }

    let artifact = lorenz_i256_sigma_x_term_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 105)
    if artifact != 318704692 { return 8 }

    let audit = lorenz_i256_sigma_x_term_bridge_audit_fingerprint(
        artifact, 406827195, 982641307, delta_anchor, delta_audit,
        scale_anchor, scale_audit, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 105, 1023)
    if audit != 729516083 { return 9 }
    return 0
}
