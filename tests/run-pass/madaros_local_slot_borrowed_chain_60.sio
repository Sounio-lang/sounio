struct Aff { v: f64, c0: f64, c1: f64, c2: f64, c3: f64 }
fn af_src(v: f64, sd: f64) -> Aff { Aff { v: v, c0: sd, c1: 0.0, c2: 0.0, c3: 0.0 } }
fn af_add(a: &Aff, b: &Aff) -> Aff { Aff { v: a.v + b.v, c0: a.c0 + b.c0, c1: a.c1 + b.c1, c2: a.c2 + b.c2, c3: a.c3 + b.c3 } }
fn af_mul(a: &Aff, b: &Aff) -> Aff { Aff { v: a.v * b.v, c0: a.c0 * b.v + b.c0 * a.v, c1: a.c1 * b.v + b.c1 * a.v, c2: a.c2 * b.v + b.c2 * a.v, c3: a.c3 * b.v + b.c3 * a.v } }
fn af_div(a: &Aff, b: &Aff) -> Aff with Div {
    let d = b.v * b.v
    Aff { v: a.v / b.v, c0: (a.c0 * b.v - b.c0 * a.v) / d, c1: (a.c1 * b.v - b.c1 * a.v) / d, c2: (a.c2 * b.v - b.c2 * a.v) / d, c3: (a.c3 * b.v - b.c3 * a.v) / d }
}
fn af_var(a: &Aff) -> f64 { a.c0 * a.c0 + a.c1 * a.c1 + a.c2 * a.c2 + a.c3 * a.c3 }
fn ph(x: f64, sd: f64, k1: f64, k0: f64, z: f64, w: f64) -> Aff with Mut, Div, Panic {
