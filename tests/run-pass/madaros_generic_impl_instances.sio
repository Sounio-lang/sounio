//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_instances
// Methods of a generic struct's impl, instantiated at two types in one unit.
// The specializer clones `impl Cell<T>` once per instance (Cell__i64,
// Cell__f64). Before, every method counted as a same-name generic method:
// `c.get()` demanded a turbofish, `Cell::<i64>::new()` did not parse,
// `impl<T>` did not parse, and a second instantiation poisoned the template.

struct Cell<T> {
    v: T,
    hits: i64,
}

impl<T> Cell<T> {
    pub fn new(v: T) -> Cell<T> {
        Cell { v: v, hits: 0 }
    }
    pub fn get(self: &!Cell<T>) -> T with Mut {
        self.hits = self.hits + 1
        self.v
    }
    pub fn set(self: &!Cell<T>, v: T) with Mut {
        self.v = v
    }
    pub fn hits(self: &Cell<T>) -> i64 {
        self.hits
    }
}

fn main() -> i32 with IO, Mut {
    var ci = Cell::<i64>::new(41)
    ci.set(ci.get() + 1)
    if ci.get() != 42 {
        print("FAIL i64 get\n")
        return 1
    }
    if ci.hits() != 2 {
        print("FAIL i64 hits\n")
        return 1
    }

    var cf = Cell::<f64>::new(1.5)
    cf.set(cf.get() * 2.0)
    let got = cf.get()
    if got < 2.99 || got > 3.01 {
        print("FAIL f64 get\n")
        return 1
    }
    if cf.hits() != 2 {
        print("FAIL f64 hits\n")
        return 1
    }

    print("PASS generic_impl_instances\n")
    return 0
}
