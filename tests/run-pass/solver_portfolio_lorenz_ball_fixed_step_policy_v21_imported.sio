//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v21 Lorenz ball-fixed step-policy smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v21_lorenz_step_policy_instance_fingerprint(
        1000000, 5, 508132668, 565673886, 70877465)
    if instance_fp != 668252674 { return 1 }

    let certificate_fp = solver_portfolio_v21_lorenz_step_policy_certificate_fingerprint(
        instance_fp, 231786611, 970000, 30000, 8,
        27000000000000000, 15, 1, 1, 1)
    if certificate_fp != 702727574 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_ball_fixed_step_policy(),
        instance_fp,
        certificate_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_ball_fixed_step_policy())
    if entry_fp != 988622529 { return 3 }

    let manifest_fp = solver_portfolio_v21_lorenz_ball_fixed_step_policy_bundle_fingerprint(
        70877465, 231786611)
    if manifest_fp != 999686282 { return 4 }

    let result_coverage_fp = solver_portfolio_v21_result_coverage_fingerprint(
        21, 25, 8, 15, 1, 1, manifest_fp)
    if result_coverage_fp != 807383802 { return 5 }

    let family_coverage_fp = solver_portfolio_v21_checker_family_coverage_fingerprint(
        21, 25, 4, 3, 2, 1, 15, manifest_fp)
    if family_coverage_fp != 761384846 { return 6 }

    let acceptance_fp = solver_portfolio_v21_acceptance_receipt_fingerprint(
        21, manifest_fp, result_coverage_fp)
    if acceptance_fp != 780868003 { return 7 }

    let audit_fp = solver_portfolio_v21_audit_receipt_fingerprint(
        21, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 885886120 { return 8 }

    let readiness_fp = solver_portfolio_v21_readiness_fingerprint(
        21, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 174001552 { return 9 }

    if solver_portfolio_v21_lorenz_ball_fixed_step_policy_bundle_fingerprint(
        70877466, 231786611) != (0 - 1) { return 10 }
    if solver_portfolio_v21_result_coverage_fingerprint(
        21, 25, 8, 14, 1, 1, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v21_checker_family_coverage_fingerprint(
        21, 25, 4, 3, 2, 1, 14, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v21_readiness_fingerprint(
        21, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 13 }

    return 0
}
