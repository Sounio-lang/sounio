//@ run-pass
// Test: Confidence Gates for Epistemic Computing
//
// Validates:
//   T1: Gate PASSES when all inputs meet threshold
//   T2: Gate FAILS when any input is below threshold
//   T3: CV% gate catches high-uncertainty parameters
//   T4: Clinical policy enforces both confidence and CV%
//   T5: Gate identifies worst offender correctly
//
// Uses inline logic to avoid lean_single's struct-value-chaining limitations.

fn cg_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn cg_sqrt(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 15 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}

fn confidence_gate(confidences: &[f64; 64], n: i64, min_confidence: f64) -> bool with Mut {
    var i = 0
    while i < n {
        if i < 64 { if confidences[i] < min_confidence { return false } }
        i = i + 1
    }
    true
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i64 with IO, Mut, Div, Panic {
    println("==============================================================")
    println("  Confidence Gate Tests")
    println("==============================================================")
    var n_pass = 0

    // ---- T1: All inputs meet threshold → PASS ----
    var confs: [f64; 64] = [0.0; 64]
    confs[0] = 0.95; confs[1] = 0.90; confs[2] = 0.88; confs[3] = 0.92
    let t1 = confidence_gate(&confs, 4, 0.85)
    if t1 { println("  PASS T1: Gate passes when all meet threshold") } else { println("  FAIL T1") }
    if t1 { n_pass = n_pass + 1 }

    // ---- T2: One input below threshold → FAIL ----
    confs[4] = 0.70  // Below 0.85
    let t2 = !confidence_gate(&confs, 5, 0.85)
    if t2 { println("  PASS T2: Gate fails when input below threshold") } else { println("  FAIL T2") }
    if t2 { n_pass = n_pass + 1 }

    // ---- T3: CV% gate catches high-uncertainty parameters ----
    // policy_cv: min_confidence=0.0, max_cv_percent=30.0
    // Check 0: value=100, std=10 → CV=10% (PASS)
    // Check 1: value=10, std=5 → CV=50% (FAIL, violation)
    var t3_n_violations: i64 = 0
    var t3_passed = true
    var t3_violation_idx: i64 = -1
    // Check 0: cv=10 < 30 → no violation
    let cv0 = 100.0 * 10.0 / cg_abs(100.0)  // = 10.0
    if cv0 > 30.0 { t3_n_violations = t3_n_violations + 1; t3_passed = false; t3_violation_idx = 0 }
    // Check 1: cv=50 > 30 → violation, param_idx=1
    let cv1 = 100.0 * 5.0 / cg_abs(10.0)  // = 50.0
    if cv1 > 30.0 { t3_n_violations = t3_n_violations + 1; t3_passed = false; t3_violation_idx = 1 }
    let t3 = !t3_passed && t3_n_violations == 1 && t3_violation_idx == 1
    if t3 { println("  PASS T3: CV% gate catches high-uncertainty param") } else { println("  FAIL T3") }
    if t3 { n_pass = n_pass + 1 }

    // ---- T4: Clinical policy (confidence + CV%) ----
    // policy_clin: min_confidence=0.90, max_cv_percent=40.0
    // Check 0: conf=0.95, CV=20% → no violations
    // Check 1: conf=0.80, CV=10% → confidence violation
    // Check 2: conf=0.95, CV=60% → CV violation
    var t4_n_violations: i64 = 0
    var t4_passed = true
    var t4_worst_conf = 1.0
    var t4_worst_idx: i64 = -1
    // Check 0
    let c0 = 0.95; let v0 = 50.0; let s0 = 10.0
    if c0 < t4_worst_conf { t4_worst_conf = c0; t4_worst_idx = 0 }
    if c0 < 0.90 { t4_n_violations = t4_n_violations + 1; t4_passed = false }
    let cv_0 = 100.0 * s0 / cg_abs(v0)
    if cv_0 > 40.0 { t4_n_violations = t4_n_violations + 1; t4_passed = false }
    // Check 1
    let c1 = 0.80; let v1 = 50.0; let s1 = 5.0
    if c1 < t4_worst_conf { t4_worst_conf = c1; t4_worst_idx = 1 }
    if c1 < 0.90 { t4_n_violations = t4_n_violations + 1; t4_passed = false }
    let cv_1 = 100.0 * s1 / cg_abs(v1)
    if cv_1 > 40.0 { t4_n_violations = t4_n_violations + 1; t4_passed = false }
    // Check 2
    let c2 = 0.95; let v2 = 10.0; let s2 = 6.0
    if c2 < t4_worst_conf { t4_worst_conf = c2; t4_worst_idx = 2 }
    if c2 < 0.90 { t4_n_violations = t4_n_violations + 1; t4_passed = false }
    let cv_2 = 100.0 * s2 / cg_abs(v2)
    if cv_2 > 40.0 { t4_n_violations = t4_n_violations + 1; t4_passed = false }
    let t4 = !t4_passed && t4_n_violations == 2
    if t4 { println("  PASS T4: Clinical policy enforces both criteria") } else { println("  FAIL T4") }
    if t4 { n_pass = n_pass + 1 }

    // ---- T5: Worst offender identification ----
    let t5 = t4_worst_conf < 0.81 && t4_worst_idx == 1
    println("  Worst confidence: "); println(t4_worst_conf); println(" at idx "); println(t4_worst_idx)
    if t5 { println("  PASS T5: Correctly identifies worst offender") } else { println("  FAIL T5") }
    if t5 { n_pass = n_pass + 1 }

    println("")
    println("==============================================================")
    println("  RESULT: "); println(n_pass); println(" / 5 PASS")
    println("==============================================================")
    if n_pass == 5 { 0 } else { 1 }
}
