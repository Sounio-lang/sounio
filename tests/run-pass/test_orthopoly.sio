//@ run-pass

// ---------------------------------------------------------------------------
// Orthogonal Polynomials test suite — all helpers inlined, no imports
//
// Functions tested (three-term recurrence implementations):
//   legendre_p   — Legendre P_n(x)
//   chebyshev_t  — Chebyshev T_n(x) (first kind)
//   hermite_h    — Hermite H_n(x)   (physicists')
//   laguerre_l   — Laguerre L_n(x)
//
// References:
//   Abramowitz & Stegun (1964), Ch. 22
//   DLMF (https://dlmf.nist.gov) chapters 18.3, 18.5, 18.7, 18.9
//   OEIS A008316 (Legendre triangle)
// ---------------------------------------------------------------------------

// ============================================================================
// HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn pi_val() -> f64 {
    3.14159265358979323846
}

// sin via Taylor series with range reduction
fn sin_f64(x: f64) -> f64 with Mut, Panic, Div {
    let tp = 6.28318530717958647692
    let pi = pi_val()
    var a = x
    if a > tp || a < 0.0 - tp {
        var n = 0.0
        let ratio = a / tp
        // floor via truncation toward zero then adjust
        if ratio >= 0.0 {
            var r = ratio
            var acc = 0.0
            var power = 1000000000000000.0
            while power >= 1.0 {
                while r >= power {
                    r = r - power
                    acc = acc + power
                }
                power = power / 10.0
            }
            n = acc
        } else {
            var r = 0.0 - ratio
            var acc = 0.0
            var power = 1000000000000000.0
            while power >= 1.0 {
                while r >= power {
                    r = r - power
                    acc = acc + power
                }
                power = power / 10.0
            }
            if (0.0 - ratio) > acc {
                n = 0.0 - acc - 1.0
            } else {
                n = 0.0 - acc
            }
        }
        a = a - n * tp
    }
    while a > pi { a = a - tp }
    while a < 0.0 - pi { a = a + tp }
    let a2 = a * a
    var sum = a
    var term = a
    var n = 1
    while n < 18 {
        term = 0.0 - term * a2 / ((2 * n) * (2 * n + 1)) as f64
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn cos_f64(x: f64) -> f64 with Mut, Panic, Div {
    return sin_f64(x + pi_val() / 2.0)
}

fn check_f64(got: f64, expected: f64, tol: f64, pass: &!i32, fail: &!i32) with IO {
    let diff = abs_f64(got - expected)
    if diff < tol {
        *pass = *pass + 1
    } else {
        *fail = *fail + 1
    }
}

// ============================================================================
// ORTHOGONAL POLYNOMIAL FUNCTIONS (three-term recurrence)
// ============================================================================

// Legendre P_n(x)
// Recurrence: (n+1) P_{n+1}(x) = (2n+1) x P_n(x) - n P_{n-1}(x)
// P_0(x) = 1, P_1(x) = x
fn legendre_p(n: i32, x: f64) -> f64 with Mut, Div {
    if n == 0 { return 1.0 }
    if n == 1 { return x }
    var p_prev = 1.0
    var p_curr = x
    var k = 1
    while k < n {
        let kf = k as f64
        let p_next = ((2.0 * kf + 1.0) * x * p_curr - kf * p_prev) / (kf + 1.0)
        p_prev = p_curr
        p_curr = p_next
        k = k + 1
    }
    return p_curr
}

// Chebyshev T_n(x) (first kind)
// Recurrence: T_{n+1}(x) = 2x T_n(x) - T_{n-1}(x)
// T_0(x) = 1, T_1(x) = x
fn chebyshev_t(n: i32, x: f64) -> f64 with Mut {
    if n == 0 { return 1.0 }
    if n == 1 { return x }
    var t_prev = 1.0
    var t_curr = x
    var k = 1
    while k < n {
        let t_next = 2.0 * x * t_curr - t_prev
        t_prev = t_curr
        t_curr = t_next
        k = k + 1
    }
    return t_curr
}

// Hermite H_n(x) (physicists' convention)
// Recurrence: H_{n+1}(x) = 2x H_n(x) - 2n H_{n-1}(x)
// H_0(x) = 1, H_1(x) = 2x
fn hermite_h(n: i32, x: f64) -> f64 with Mut {
    if n == 0 { return 1.0 }
    if n == 1 { return 2.0 * x }
    var h_prev = 1.0
    var h_curr = 2.0 * x
    var k = 1
    while k < n {
        let kf = k as f64
        let h_next = 2.0 * x * h_curr - 2.0 * kf * h_prev
        h_prev = h_curr
        h_curr = h_next
        k = k + 1
    }
    return h_curr
}

// Laguerre L_n(x)
// Recurrence: (n+1) L_{n+1}(x) = (2n+1-x) L_n(x) - n L_{n-1}(x)
// L_0(x) = 1, L_1(x) = 1 - x
fn laguerre_l(n: i32, x: f64) -> f64 with Mut, Div {
    if n == 0 { return 1.0 }
    if n == 1 { return 1.0 - x }
    var l_prev = 1.0
    var l_curr = 1.0 - x
    var k = 1
    while k < n {
        let kf = k as f64
        let l_next = ((2.0 * kf + 1.0 - x) * l_curr - kf * l_prev) / (kf + 1.0)
        l_prev = l_curr
        l_curr = l_next
        k = k + 1
    }
    return l_curr
}

// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Orthogonal Polynomials Tests ===")
    println("")

    var pass = 0
    var fail = 0
    let tol = 1.0e-10

    // -----------------------------------------------------------------------
    // Legendre P_n(x)
    // -----------------------------------------------------------------------

    // Test 1: P_0(x) = 1 for any x
    print("Test  1: P_0(0.7) = 1 ............. ")
    check_f64(legendre_p(0, 0.7), 1.0, tol, &!pass, &!fail)
    if pass == 1 { println("PASS") } else { println("FAIL") }

    // Test 2: P_1(0.5) = 0.5
    let prev_pass = pass
    print("Test  2: P_1(0.5) = 0.5 ........... ")
    check_f64(legendre_p(1, 0.5), 0.5, tol, &!pass, &!fail)
    if pass > prev_pass { println("PASS") } else { println("FAIL") }

    // Test 3: P_2(0.5) = -0.125
    let prev_pass3 = pass
    print("Test  3: P_2(0.5) = -0.125 ........ ")
    check_f64(legendre_p(2, 0.5), 0.0 - 0.125, tol, &!pass, &!fail)
    if pass > prev_pass3 { println("PASS") } else { println("FAIL") }

    // Test 4: P_3(0.5) = -0.4375
    let prev_pass4 = pass
    print("Test  4: P_3(0.5) = -0.4375 ....... ")
    check_f64(legendre_p(3, 0.5), 0.0 - 0.4375, tol, &!pass, &!fail)
    if pass > prev_pass4 { println("PASS") } else { println("FAIL") }

    // Test 5: P_10(0) = -0.24609375 (even-order Legendre at origin)
    let prev_pass5 = pass
    print("Test  5: P_10(0) = -0.24609375 .... ")
    check_f64(legendre_p(10, 0.0), 0.0 - 0.24609375, tol, &!pass, &!fail)
    if pass > prev_pass5 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Chebyshev T_n(x)
    // -----------------------------------------------------------------------

    // Test 6: T_0(x) = 1
    let prev_pass6 = pass
    print("Test  6: T_0(0.3) = 1 ............. ")
    check_f64(chebyshev_t(0, 0.3), 1.0, tol, &!pass, &!fail)
    if pass > prev_pass6 { println("PASS") } else { println("FAIL") }

    // Test 7: T_1(0.5) = 0.5
    let prev_pass7 = pass
    print("Test  7: T_1(0.5) = 0.5 ........... ")
    check_f64(chebyshev_t(1, 0.5), 0.5, tol, &!pass, &!fail)
    if pass > prev_pass7 { println("PASS") } else { println("FAIL") }

    // Test 8: T_2(0.5) = 2(0.5)^2 - 1 = -0.5
    let prev_pass8 = pass
    print("Test  8: T_2(0.5) = -0.5 .......... ")
    check_f64(chebyshev_t(2, 0.5), 0.0 - 0.5, tol, &!pass, &!fail)
    if pass > prev_pass8 { println("PASS") } else { println("FAIL") }

    // Test 9: T_3(0.5) = 4(0.5)^3 - 3(0.5) = -1.0
    let prev_pass9 = pass
    print("Test  9: T_3(0.5) = -1.0 .......... ")
    check_f64(chebyshev_t(3, 0.5), 0.0 - 1.0, tol, &!pass, &!fail)
    if pass > prev_pass9 { println("PASS") } else { println("FAIL") }

    // Test 10: T_n(1) = 1 for all n — check T_5(1) = 1
    let prev_pass10 = pass
    print("Test 10: T_5(1) = 1 ............... ")
    check_f64(chebyshev_t(5, 1.0), 1.0, tol, &!pass, &!fail)
    if pass > prev_pass10 { println("PASS") } else { println("FAIL") }

    // Test 11: T_n(-1) = (-1)^n — T_4(-1)=1, T_5(-1)=-1
    let prev_pass11 = pass
    print("Test 11: T_4(-1)=1, T_5(-1)=-1 .... ")
    check_f64(chebyshev_t(4, 0.0 - 1.0), 1.0, tol, &!pass, &!fail)
    if pass > prev_pass11 {
        let prev_pass11b = pass
        check_f64(chebyshev_t(5, 0.0 - 1.0), 0.0 - 1.0, tol, &!pass, &!fail)
        if pass > prev_pass11b { println("PASS") } else { println("FAIL") }
    } else {
        // first sub-check failed, also record second failure
        check_f64(chebyshev_t(5, 0.0 - 1.0), 0.0 - 1.0, tol, &!pass, &!fail)
        println("FAIL")
    }

    // -----------------------------------------------------------------------
    // Hermite H_n(x) (physicists')
    // -----------------------------------------------------------------------

    // Test 12: H_0(x) = 1
    let prev_pass12 = pass
    print("Test 12: H_0(2.0) = 1 ............. ")
    check_f64(hermite_h(0, 2.0), 1.0, tol, &!pass, &!fail)
    if pass > prev_pass12 { println("PASS") } else { println("FAIL") }

    // Test 13: H_1(x) = 2x, so H_1(1.5) = 3.0
    let prev_pass13 = pass
    print("Test 13: H_1(1.5) = 3.0 ........... ")
    check_f64(hermite_h(1, 1.5), 3.0, tol, &!pass, &!fail)
    if pass > prev_pass13 { println("PASS") } else { println("FAIL") }

    // Test 14: H_2(x) = 4x^2 - 2, so H_2(1.0) = 2.0
    let prev_pass14 = pass
    print("Test 14: H_2(1.0) = 2.0 ........... ")
    check_f64(hermite_h(2, 1.0), 2.0, tol, &!pass, &!fail)
    if pass > prev_pass14 { println("PASS") } else { println("FAIL") }

    // Test 15: H_3(x) = 8x^3 - 12x, so H_3(1.0) = -4.0
    let prev_pass15 = pass
    print("Test 15: H_3(1.0) = -4.0 .......... ")
    check_f64(hermite_h(3, 1.0), 0.0 - 4.0, tol, &!pass, &!fail)
    if pass > prev_pass15 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Laguerre L_n(x)
    // -----------------------------------------------------------------------

    // Test 16: L_0(x) = 1
    let prev_pass16 = pass
    print("Test 16: L_0(5.0) = 1 ............. ")
    check_f64(laguerre_l(0, 5.0), 1.0, tol, &!pass, &!fail)
    if pass > prev_pass16 { println("PASS") } else { println("FAIL") }

    // Test 17: L_1(x) = 1 - x, so L_1(2.0) = -1.0
    let prev_pass17 = pass
    print("Test 17: L_1(2.0) = -1.0 .......... ")
    check_f64(laguerre_l(1, 2.0), 0.0 - 1.0, tol, &!pass, &!fail)
    if pass > prev_pass17 { println("PASS") } else { println("FAIL") }

    // Test 18: L_2(x) = (x^2 - 4x + 2)/2, so L_2(1.0) = -0.5
    let prev_pass18 = pass
    print("Test 18: L_2(1.0) = -0.5 .......... ")
    check_f64(laguerre_l(2, 1.0), 0.0 - 0.5, tol, &!pass, &!fail)
    if pass > prev_pass18 { println("PASS") } else { println("FAIL") }

    // Test 19: L_3(x) = (-x^3 + 9x^2 - 18x + 6)/6, so L_3(1.0) = -2/3
    let prev_pass19 = pass
    print("Test 19: L_3(1.0) = -0.66666... ... ")
    let l3_expected = (0.0 - 1.0 + 9.0 - 18.0 + 6.0) / 6.0
    check_f64(laguerre_l(3, 1.0), l3_expected, tol, &!pass, &!fail)
    if pass > prev_pass19 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Cross-family identity
    // -----------------------------------------------------------------------

    // Test 20: T_n(cos(theta)) = cos(n*theta) — verify T_5(cos(0.3)) = cos(1.5)
    let prev_pass20 = pass
    print("Test 20: T_5(cos(0.3)) = cos(1.5) . ")
    let theta = 0.3
    let cos_theta = cos_f64(theta)
    let t5_val = chebyshev_t(5, cos_theta)
    let cos_5theta = cos_f64(5.0 * theta)
    check_f64(t5_val, cos_5theta, tol, &!pass, &!fail)
    if pass > prev_pass20 { println("PASS") } else { println("FAIL") }

    // -----------------------------------------------------------------------
    // Summary
    // -----------------------------------------------------------------------
    println("")
    print("Passed: ")
    println(pass)
    print("Failed: ")
    println(fail)

    if fail > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 21 TESTS PASSED")
    return 0
}
