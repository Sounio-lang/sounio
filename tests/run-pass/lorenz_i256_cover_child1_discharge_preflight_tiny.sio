//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-1 discharge preflight receipt

fn child1_discharge_preflight_check(
    child1_validation_core_fp: i64,
    child1_validation_core_audit_fp: i64,
    child0_discharge_preflight_fp: i64,
    child0_discharge_preflight_audit_fp: i64,
    child_index: i64,
    child_validated_mask: i64,
    global_flowpipe_claim_mask: i64,
    discharge_status: i64) -> i64 {
    if child1_validation_core_fp != 648831016 { return 0 - 1 }
    if child1_validation_core_audit_fp != 63312412 { return 0 - 1 }
    if child0_discharge_preflight_fp != 367693213 { return 0 - 1 }
    if child0_discharge_preflight_audit_fp != 255409323 { return 0 - 1 }
    if child_index != 1 { return 0 - 1 }
    if child_validated_mask != 3 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if discharge_status != 63 { return 0 - 1 }
    return 719480263
}

fn main() -> i64 {
    let artifact = child1_discharge_preflight_check(
        648831016, 63312412, 367693213, 255409323, 1, 3, 0, 63)
    if artifact != 719480263 { return 1 }

    let audit_fp: i64 = 602184970
    let instance_fp: i64 = 302491877
    let certificate_fp: i64 = 917204631
    let child_validated_mask: i64 = 3
    let pending_child_validation_mask: i64 = 28
    let remaining_child_validation_mask: i64 = 28
    let child_validation_dependency_mask: i64 = 63
    let child1_validation_receipt_mask: i64 = 31
    let child1_discharge_preflight_mask: i64 = 2
    let discharge_blocker_mask: i64 = 15
    let missing_child_validation_mask: i64 = 28
    let pending_child_discharge_mask: i64 = 255
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let finite_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let discharge_status: i64 = 63
    let ok_mask: i64 = 255

    if audit_fp != 602184970 { return 2 }
    if instance_fp != 302491877 { return 3 }
    if certificate_fp != 917204631 { return 4 }
    if child_validated_mask != 3 { return 5 }
    if pending_child_validation_mask != 28 { return 6 }
    if remaining_child_validation_mask != 28 { return 7 }
    if child_validation_dependency_mask != 63 { return 8 }
    if child1_validation_receipt_mask != 31 { return 9 }
    if child1_discharge_preflight_mask != 2 { return 10 }
    if discharge_blocker_mask != 15 { return 11 }
    if missing_child_validation_mask != 28 { return 12 }
    if pending_child_discharge_mask != 255 { return 13 }
    if child_discharge_mask != 0 { return 14 }
    if global_cover_certificate_mask != 0 { return 15 }
    if finite_cover_certificate_mask != 0 { return 16 }
    if global_flowpipe_claim_mask != 0 { return 17 }
    if discharge_status != 63 { return 18 }
    if ok_mask != 255 { return 19 }

    let wrong_child = child1_discharge_preflight_check(
        648831016, 63312412, 367693213, 255409323, 0, 3, 0, 63)
    if wrong_child != 0 - 1 { return 20 }

    let overclaim = child1_discharge_preflight_check(
        648831016, 63312412, 367693213, 255409323, 1, 3, 1, 63)
    if overclaim != 0 - 1 { return 21 }

    let incomplete_validation = child1_discharge_preflight_check(
        648831016, 63312412, 367693213, 255409323, 1, 1, 0, 63)
    if incomplete_validation != 0 - 1 { return 22 }

    return 0
}
