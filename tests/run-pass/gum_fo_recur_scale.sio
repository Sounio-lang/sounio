//@ run-pass
//@ requires: madaros
//@ expect-stdout: s0 0.090000
//@ expect-stdout: s3 5.760000
//@ expect-stdout: s12 1509949.440000
//@ expect-stdout: sneg 0.090000
//@ expect-stdout: RECUR_SCALE_OK
// a = 5 +- 0.3, var = 0.09.
// scale(a, n) = 2^n * a for n >= 0, and a when n < 1.
// n = 3 is 8^2 * 0.09. n = 12 is 4096^2 * 0.09.

fn scale(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        2.0 * scale(x, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let s0 = variance_of(scale(a, 0))
    let s3 = variance_of(scale(a, 3))
    let s12 = variance_of(scale(a, 12))
    let sneg = variance_of(scale(a, 0 - 2))
    print("s0 ")
    print_f64(s0)
    println("")
    print("s3 ")
    print_f64(s3)
    println("")
    print("s12 ")
    print_f64(s12)
    println("")
    print("sneg ")
    print_f64(sneg)
    println("")
    var fails: i64 = 0
    if s0 < 0.089999 || s0 > 0.090001 { fails = fails + 1 }
    if s3 < 5.759999 || s3 > 5.760001 { fails = fails + 1 }
    if s12 < 1509949.43 || s12 > 1509949.45 { fails = fails + 1 }
    if sneg < 0.089999 || sneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_SCALE_OK")
        0
    } else {
        println("RECUR_SCALE_FAIL")
        1
    }
}
