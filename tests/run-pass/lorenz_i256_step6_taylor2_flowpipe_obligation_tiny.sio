//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 Taylor-2 flowpipe obligation composition

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 827
    fp = mix(fp, 6, 4441)
    fp = mix(fp, 230532791, 4441)
    fp = mix(fp, 370048214, 4441)
    fp = mix(fp, 963265870, 4441)
    fp = mix(fp, 344106968, 4441)
    fp = mix(fp, 506104143, 4441)
    fp = mix(fp, 956295573, 4441)
    fp = mix(fp, 652877359, 4441)
    fp = mix(fp, 344816971, 4441)
    fp = mix(fp, 956152878, 4441)
    fp = mix(fp, 916252082, 4441)
    fp = mix(fp, 7, 4441)
    fp = mix(fp, 7, 4441)
    fp = mix(fp, 127, 4441)
    fp = mix(fp, 127, 4441)
    fp = mix(fp, 15, 4441)
    fp = mix(fp, 15, 4441)
    fp = mix(fp, 0, 4441)
    fp = mix(fp, 0, 4441)
    fp = mix(fp, 14, 4441)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 854680028 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 829
    fp = mix(fp, instance, 4447)
    fp = mix(fp, 7, 4447)
    fp = mix(fp, 7, 4447)
    fp = mix(fp, 127, 4447)
    fp = mix(fp, 127, 4447)
    fp = mix(fp, 15, 4447)
    fp = mix(fp, 15, 4447)
    fp = mix(fp, 0, 4447)
    fp = mix(fp, 0, 4447)
    fp = mix(fp, 14, 4447)
    fp = mix(fp, ok_mask, 4447)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 854680028 { return 0 - 1 }
    if certificate != 855359915 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 839
    fp = mix(fp, instance, 4451)
    fp = mix(fp, certificate, 4451)
    fp = mix(fp, 15, 4451)
    fp = mix(fp, 6, 4451)
    fp = mix(fp, 15, 4451)
    fp = mix(fp, 15, 4451)
    fp = mix(fp, 0, 4451)
    fp = mix(fp, 0, 4451)
    fp = mix(fp, 14, 4451)
    fp = mix(fp, ok_mask, 4451)
    return fp
}

fn obligation_mask() -> i64 {
    let endpoint_mask: i64 = 7
    let slab_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_mask: i64 = 127
    var composition_mask: i64 = 0
    if endpoint_mask == 7 { composition_mask = composition_mask + 1 }
    if slab_mask == 7 { composition_mask = composition_mask + 2 }
    if response_mask == 127 { composition_mask = composition_mask + 4 }
    if remainder_mask == 127 { composition_mask = composition_mask + 8 }

    let local_proof_mask: i64 = 0
    let global_claim_mask: i64 = 0
    let status: i64 = 14

    var ok_mask: i64 = 0
    if 230532791 > 0 {
        if 963265870 > 0 { ok_mask = ok_mask + 1 }
    }
    if 506104143 > 0 {
        if 652877359 > 0 { ok_mask = ok_mask + 2 }
    }
    if 956152878 > 0 { ok_mask = ok_mask + 4 }
    if composition_mask == 15 { ok_mask = ok_mask + 8 }
    if local_proof_mask == 0 {
        if global_claim_mask == 0 {
            if status == 14 { ok_mask = ok_mask + 16 }
        }
    }
    if 2 == 2 {
        if 100 == 100 { ok_mask = ok_mask + 32 }
    }
    if composition_mask == 15 {
        if response_mask == 127 { ok_mask = ok_mask + 64 }
    }
    if 956152878 > 0 {
        if global_claim_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = obligation_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 854680028 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 855359915 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 646304688 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
