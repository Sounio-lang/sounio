//@ run-pass
//@ expect-stdout: PASS: GPU param names read-mut

kernel fn names_read_mut(count: i64, x: &[f64], y: &![f64], out: &![f64]) with GPU {
    let idx = gpu_thread_id_x()
    if idx < count {
        out[idx as usize] = x[idx as usize] + y[idx as usize]
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU {
    var src: [f64; 96] = [0.0; 96]
    var scratch: [f64; 96] = [0.0; 96]
    var dst: [f64; 96] = [0.0; 96]

    var i: i64 = 0
    while i < 96 {
        src[i as usize] = (i as f64) + 2.0
        scratch[i as usize] = (i as f64) * 5.0
        i = i + 1
    }

    names_read_mut(96, &src, &!scratch, &!dst)

    if dst[0] > 1.99 && dst[0] < 2.01 &&
       dst[1] > 7.99 && dst[1] < 8.01 &&
       dst[95] > 571.99 && dst[95] < 572.01 {
        println("PASS: GPU param names read-mut")
    } else {
        println("FAIL: GPU param names read-mut")
    }
    0
}
