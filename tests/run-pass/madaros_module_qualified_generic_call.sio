//@ run-pass
//@ requires: madaros
//@ expect-stdout: MODULE_QUALIFIED_GENERIC_CALL PASS
//
// PR #2515 review finding A (comment_id 4058669312): `spec_call_expr_callee_name`
// (self-hosted/check/specializer.sio) returned empty_name() for every
// multi-segment path, so a module-qualified GENERIC call like
// `gen_big::gbig_basis::<i64>(..)` was never passed to spec_ensure_instance and
// its turbofish call site was never rewritten to the monomorphized symbol. The
// lowerer then targeted the un-instantiated generic template `gbig_basis`
// directly, which has no generated instance/body -- a body-less call.
//
// This reuses testmod::gen_big (stdlib/testmod/gen_big.sio), the existing
// witness fixture for generic cross-module struct returns
// (tests/run-pass/gen_dep_summary_min.sio calls the same functions via a bare
// imported name, not a module-qualified path), but calls `gbig_basis`
// through its module-qualified path with an explicit turbofish, which is the
// shape the review found broken.
use testmod::gen_big::{GBig};

fn main() -> i64 with IO, Mut, Panic {
    let zero: i64 = 0
    let one: i64 = 1
    let r = testmod::gen_big::gbig_basis::<i64>(4, 3, zero, one)
    if r.c[3] == 1 && r.c[0] == 0 && r.bits == 4 {
        println("MODULE_QUALIFIED_GENERIC_CALL PASS")
        return 0
    }
    println("MODULE_QUALIFIED_GENERIC_CALL FAIL")
    return 1
}
