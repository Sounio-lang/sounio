//@ run-pass
//@ requires: madaros
//@ expect-stdout: STATIC_ASSET_WIRE7_OK
use parser::ast::{Name, make_name};
use ir::ir::*;
use ir::serialize::*;
fn main() -> i32 with IO, Alloc, Mut, Panic, Div {
    var identity = Name { buf: [0; 384], len: 200 }
    var i: i64 = 0
    while i < identity.len { identity.buf[i as usize] = 97; i = i + 1 }
    identity.buf[135] = 0
    var module = ir_empty_module()
    module.fn_count = 1
    var func = ir_empty_function()
    func.name = make_name("asset")
    func.instr_count = 2
    func.reg_count = 1
    var region = ir_region_invalid()
    if ir_instr_arena_alloc(2, &!region) != IR_ARENA_OK { return 1 }
    func.region = region
    ir_arena_store(ir_region_slot_w(region, 0), ir_static_blob(0, 5, identity))
    ir_arena_store(ir_region_slot_w(region, 1), ir_return(0))
    ir_fn_set(&!module, 0, func)
    let pair = serialize_ir_module(module)
    if pair.1 <= 0 || pair.0[4] != 7 as i8 || pair.0[5] != 15 as i8 { return 2 }
    let restored = deserialize_ir_module(pair.0, pair.1)
    if restored.fn_count != 1 { return 3 }
    let result = ir_fn_get(&restored, 0)
    let slot = ir_region_slot_r(result.region, 0)
    if (IR_A_OP[slot as usize] as IrOpcode) != IrOpcode::IrStaticBlob { return 4 }
    if IR_A_IMM_I64[slot as usize] != 5 { return 5 }
    let name = ir_arena_name(slot)
    if name.len != identity.len { return 6 }
    i = 0
    while i < identity.len {
        if name.buf[i as usize] != identity.buf[i as usize] { return 7 }
        i = i + 1
    }
    // A v6 header must reject the v7 feature and long-name payload.
    var wrong = pair.0
    wrong[4] = 6 as i8
    let rejected = deserialize_ir_module(wrong, pair.1)
    if rejected.fn_count != 0 { return 8 }
    // Short-name records remain wire-compatible with genuine empty v6 modules.
    var legacy = ir_empty_module()
    let old_pair = serialize_ir_module(legacy)
    var old = old_pair.0
    old[4] = 6 as i8
    old[5] = 7 as i8
    let old_read = deserialize_ir_module(old, old_pair.1)
    if old_read.fn_count != 0 { return 9 }
    // Refusal counters make an empty-result false pass observable.
    let refusals = SOIR_DESER_REFUSAL_COUNT
    let again = deserialize_ir_module(old, old_pair.1)
    if again.fn_count != 0 || SOIR_DESER_REFUSAL_COUNT != refusals { return 10 }
    // The string-table's historical136-byte minimum must not authorize a clipped long record.
    var strings=ir_empty_module()
    strings.string_count=1
    strings.string_table[0]=identity
    let string_pair=serialize_ir_module(strings)
    if string_pair.1<=0 {return 11}
    let string_read=deserialize_ir_module(string_pair.0,string_pair.1)
    if string_read.string_count!=1 || string_read.string_table[0].len!=200 {return 12}
    i=0
    while i<identity.len {
        if string_read.string_table[0].buf[i as usize]!=identity.buf[i as usize] {return 13}
        i=i+1
    }
    let before_cut=SOIR_DESER_REFUSAL_COUNT
    let cut=deserialize_ir_module(string_pair.0,16+8+8+300)
    if cut.string_count!=0 || SOIR_DESER_REFUSAL_COUNT<=before_cut {return 14}

    // Nonempty v6/v5 functions keep their historical short-name wire layout.
    var old_module=ir_empty_module()
    old_module.fn_count=1
    var old_func=ir_empty_function()
    old_func.name=make_name("legacy")
    old_func.reg_count=1
    old_func.instr_count=2
    old_func.return_kn_value_float=2
    var old_region=ir_region_invalid()
    if ir_instr_arena_alloc(2,&!old_region)!=IR_ARENA_OK {return 15}
    old_func.region=old_region
    ir_arena_store(ir_region_slot_w(old_region,0),ir_load_imm(0,42))
    ir_arena_store(ir_region_slot_w(old_region,1),ir_return(0))
    ir_fn_set(&!old_module,0,old_func)
    let old_image=serialize_ir_module(old_module)
    if old_image.1<=0 {return 16}
    var v6=old_image.0
    v6[4]=6 as i8
    v6[5]=7 as i8
    let before_v6=SOIR_DESER_REFUSAL_COUNT
    let decoded_v6=deserialize_ir_module(v6,old_image.1)
    if decoded_v6.fn_count!=1 || SOIR_DESER_REFUSAL_COUNT!=before_v6 {return 17}
    let vf=ir_fn_get(&decoded_v6,0)
    if vf.return_kn_value_float!=2 || IR_A_IMM_I64[ir_region_slot_r(vf.region,0) as usize]!=42 {return 18}
    var v5=v6
    let marker=744+8*((old_func.reg_count+31)/32)
    var cursor=marker
    while cursor<old_image.1-8 {v5[cursor as usize]=v5[(cursor+8) as usize];cursor=cursor+1}
    v5[4]=5 as i8
    v5[5]=3 as i8
    let before_v5=SOIR_DESER_REFUSAL_COUNT
    let before_unknown=SOIR_DESER_V5_UNKNOWN_RETURN_METADATA_COUNT
    let decoded_v5=deserialize_ir_module(v5,old_image.1-8)
    if decoded_v5.fn_count!=1 || SOIR_DESER_REFUSAL_COUNT!=before_v5 {return 19}
    let v5f=ir_fn_get(&decoded_v5,0)
    if v5f.return_kn_value_float!= -2 || SOIR_DESER_V5_UNKNOWN_RETURN_METADATA_COUNT!=before_unknown+1 {return 20}
    if IR_A_IMM_I64[ir_region_slot_r(v5f.region,0) as usize]!=42 {return 21}
    println("STATIC_ASSET_WIRE7_OK")
    0
}
