//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-2 point time-slab containment seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1621
    fp = mix(fp, 633359277, 5519)
    fp = mix(fp, 421619310, 5519)
    fp = mix(fp, 2, 5519)
    fp = mix(fp, 256, 5519)
    fp = mix(fp, 32, 5519)
    fp = mix(fp, 1, 5519)
    fp = mix(fp, 100, 5519)
    fp = mix(fp, 2600000, 5519)
    fp = mix(fp, 25756667, 5519)
    fp = mix(fp, 1362223, 5519)
    fp = mix(fp, 26000, 5519)
    fp = mix(fp, 257567, 5519)
    fp = mix(fp, 13623, 5519)
    fp = mix(fp, 26100, 5519)
    fp = mix(fp, 257700, 5519)
    fp = mix(fp, 13700, 5519)
    fp = mix(fp, 100, 5519)
    fp = mix(fp, 133, 5519)
    fp = mix(fp, 77, 5519)
    fp = mix(fp, 3, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 7, 5519)
    fp = mix(fp, 15, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 0, 5519)
    fp = mix(fp, 23, 5519)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 910323405 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1627
    fp = mix(fp, instance, 5521)
    fp = mix(fp, 2600000, 5521)
    fp = mix(fp, 25756667, 5521)
    fp = mix(fp, 1362223, 5521)
    fp = mix(fp, 26000, 5521)
    fp = mix(fp, 257567, 5521)
    fp = mix(fp, 13623, 5521)
    fp = mix(fp, 100, 5521)
    fp = mix(fp, 133, 5521)
    fp = mix(fp, 77, 5521)
    fp = mix(fp, 3, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 7, 5521)
    fp = mix(fp, 15, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 0, 5521)
    fp = mix(fp, 23, 5521)
    fp = mix(fp, ok_mask, 5521)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 910323405 { return 0 - 1 }
    if certificate != 188845140 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1637
    fp = mix(fp, instance, 5527)
    fp = mix(fp, certificate, 5527)
    fp = mix(fp, 19, 5527)
    fp = mix(fp, 2, 5527)
    fp = mix(fp, 7, 5527)
    fp = mix(fp, 15, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 0, 5527)
    fp = mix(fp, 23, 5527)
    fp = mix(fp, ok_mask, 5527)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64) -> i64 {
    if artifact != 268229078 { return 0 - 1 }
    if instance != 910323405 { return 0 - 1 }
    if certificate != 188845140 { return 0 - 1 }

    var fp: i64 = 1657
    fp = mix(fp, artifact, 5531)
    fp = mix(fp, instance, 5531)
    fp = mix(fp, certificate, 5531)
    fp = mix(fp, 633359277, 5531)
    fp = mix(fp, 421619310, 5531)
    fp = mix(fp, 2600000, 5531)
    fp = mix(fp, 25756667, 5531)
    fp = mix(fp, 1362223, 5531)
    fp = mix(fp, 26000, 5531)
    fp = mix(fp, 257567, 5531)
    fp = mix(fp, 13623, 5531)
    fp = mix(fp, 26100, 5531)
    fp = mix(fp, 257700, 5531)
    fp = mix(fp, 13700, 5531)
    fp = mix(fp, 2, 5531)
    fp = mix(fp, 23, 5531)
    fp = mix(fp, 255, 5531)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let target_scale: i256 = 1000000 as i256
    let x1: i256 = 4294967296 as i256
    let y1: i256 = 5411658768 as i256
    let dx_num: i256 = (10 as i256) * (y1 - x1)
    let dy_num: i256 = (116035699778 as i256) - y1
    let dz_num: i256 = (11262358693 as i256) - (5411658768 as i256)

    var derivative_mask: i64 = 0
    if (2599999 as i256) * scale < dx_num * target_scale {
        if (2600000 as i256) * scale >= dx_num * target_scale { derivative_mask = derivative_mask + 1 }
    }
    if (25756666 as i256) * scale < dy_num * target_scale {
        if (25756667 as i256) * scale >= dy_num * target_scale { derivative_mask = derivative_mask + 2 }
    }
    if (1362222 as i256) * scale < dz_num * target_scale {
        if (1362223 as i256) * scale >= dz_num * target_scale { derivative_mask = derivative_mask + 4 }
    }
    if derivative_mask != 7 { return 1 }

    if 26000 * 100 < 2600000 { return 2 }
    if 257567 * 100 < 25756667 { return 3 }
    if 13623 * 100 < 1362223 { return 4 }
    let instance = instance_fp()
    if instance != 910323405 { return 5 }
    let certificate = certificate_fp(instance, 255)
    if certificate != 188845140 { return 6 }
    let artifact = artifact_fp(instance, certificate, 255)
    if artifact != 268229078 { return 7 }
    if audit_fp(artifact, instance, certificate) != 223161586 { return 8 }
    return 0
}
