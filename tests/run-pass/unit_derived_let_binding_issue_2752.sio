//@ run-pass
//@ description: #2752 — a let annotated with a derived unit accepts an expression of the same dimension
//@ expect-stdout: 10.438413
//@ expect-stdout: 10.438413
unit velocity = m / s;

fn main() -> i32 with IO, Mut, Panic, Div {
    let distance: m = 100.0
    let elapsed: s = 9.58
    let speed: velocity = distance / elapsed
    print_f64(speed); print("\n")
    var v2: velocity = speed
    v2 = distance / elapsed
    print_f64(v2); print("\n")
    return 0
}
