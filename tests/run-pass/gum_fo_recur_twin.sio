//@ run-pass
//@ requires: madaros
//@ expect-stdout: t0 0.090000
//@ expect-stdout: t1 0.360000
//@ expect-stdout: t2 1.440000
//@ expect-stdout: t3 5.760000
//@ expect-stdout: t12 1509949.440000
//@ expect-stdout: tneg 0.090000
//@ expect-stdout: RECUR_TWIN_OK
// a = 5 +- 0.3, var = 0.09.
// twin(a, n) = twin(a, n - 1) + twin(a, n - 1) is 2^n * a for n >= 0.
// n = 1 is 4 * 0.09. n = 2 is 16 * 0.09. n = 3 is 64 * 0.09.

fn twin(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        twin(x, n - 1) + twin(x, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let t0 = variance_of(twin(a, 0))
    let t1 = variance_of(twin(a, 1))
    let t2 = variance_of(twin(a, 2))
    let t3 = variance_of(twin(a, 3))
    let t12 = variance_of(twin(a, 12))
    let tneg = variance_of(twin(a, 0 - 2))
    print("t0 ")
    print_f64(t0)
    println("")
    print("t1 ")
    print_f64(t1)
    println("")
    print("t2 ")
    print_f64(t2)
    println("")
    print("t3 ")
    print_f64(t3)
    println("")
    print("t12 ")
    print_f64(t12)
    println("")
    print("tneg ")
    print_f64(tneg)
    println("")
    var fails: i64 = 0
    if t0 < 0.089999 || t0 > 0.090001 { fails = fails + 1 }
    if t1 < 0.359999 || t1 > 0.360001 { fails = fails + 1 }
    if t2 < 1.439999 || t2 > 1.440001 { fails = fails + 1 }
    if t3 < 5.759999 || t3 > 5.760001 { fails = fails + 1 }
    if t12 < 1509949.43 || t12 > 1509949.45 { fails = fails + 1 }
    if tneg < 0.089999 || tneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_TWIN_OK")
        0
    } else {
        println("RECUR_TWIN_FAIL")
        1
    }
}
