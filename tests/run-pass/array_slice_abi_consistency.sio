//@ run-pass
//@ description: [T], &[T], fixed arrays, literals, and struct arrays preserve pointer+length ABI

struct Point {
    x: i64,
    y: i64
}

fn len_i64_view(xs: [i64]) -> i64 {
    return len(xs)
}

fn method_len_i64_view(xs: [i64]) -> i64 {
    return xs.len()
}

fn sum_i64_view(xs: [i64]) -> i64 with Mut {
    var i: i64 = 0
    var total: i64 = 0
    while i < len(xs) {
        total = total + xs[i]
        i = i + 1
    }
    return total
}

fn second_i64_view(xs: [i64]) -> i64 {
    return xs[1]
}

fn len_i64_slice(xs: &[i64]) -> i64 {
    return len(xs)
}

fn sum_i64_slice(xs: &[i64]) -> i64 with Mut {
    var i: i64 = 0
    var total: i64 = 0
    while i < xs.len() {
        total = total + xs[i]
        i = i + 1
    }
    return total
}

fn len_point_view(xs: [Point]) -> i64 {
    return len(xs)
}

fn second_point_y(xs: [Point]) -> i64 {
    let p = xs[1]
    return p.y
}

fn assert_eq(actual: i64, expected: i64, name: string) -> i64 with IO {
    if actual == expected {
        print("PASS: ")
        println(name)
        return 1
    }

    print("FAIL: ")
    print(name)
    print(" expected ")
    print(expected)
    print(" got ")
    println(actual)
    return 0
}

fn main() -> i32 with Mut {
    var passed: i64 = 0

    let xs = [10, 20, 30]
    let n: i64 = 2
    let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]

    passed = passed + assert_eq(len([1, 2, 3]), 3, "array literal len")
    passed = passed + assert_eq(len(xs), 3, "fixed array variable len")
    passed = passed + assert_eq(len(&xs[0..n]), 2, "runtime slice len")
    passed = passed + assert_eq(len_i64_slice(&xs[0..n]), 2, "&[T] parameter len")
    passed = passed + assert_eq(sum_i64_slice(&xs[0..n]), 30, "&[T] parameter indexing")
    passed = passed + assert_eq(len_i64_view(xs), 3, "[T] parameter len")
    passed = passed + assert_eq(method_len_i64_view(xs), 3, "[T] parameter method len")
    passed = passed + assert_eq(sum_i64_view(xs), 60, "[T] parameter indexing")
    passed = passed + assert_eq(len_i64_view([4, 5, 6, 7]), 4, "array literal [T] len")
    passed = passed + assert_eq(second_i64_view([7, 8, 9]), 8, "array literal passed to [T]")
    passed = passed + assert_eq(len_point_view(points), 2, "struct array [T] len")
    passed = passed + assert_eq(second_point_y(points), 4, "struct array [T] indexing")

    if passed == 12 {
        println("array_slice_abi_consistency: PASS")
        return 0
    }

    println("array_slice_abi_consistency: FAIL")
    return 1
}
