//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_SLOT_DIRECT_INDEX_F64_ARRAY PASS
//
// Copilot review (PR #2516), "Previously missed" finding: index_base_elem_is_float_ref
// (self-hosted/ir/lower.sio) sent every ExprFieldAccess base straight to
// field_array_elem_is_float_for_base_ref, treating a numeric tuple-slot
// name (`.0`) the same as a real struct field name -- a tuple-returning
// call has no struct owner type, so that lookup always missed and fell
// back to the integer-element path, cvtsi2sd-ing the f64 bit pattern of
// the array's real values. Every existing tuple-slot test binds `.0` to
// an intermediate local (`let (a, b) = pair()`) before indexing, which
// takes a DIFFERENT, already-correct code path
// (lookup_local_tuple_arr_mask) and never exercised this one.
//
// `pair().0[0]` and `pair().1[0]` here go straight from the call through
// the field access to the index with no intervening `let` -- the exact
// shape index_base_elem_is_float_ref's ExprFieldAccess branch handles.
fn pair() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let s0: f64 = pair().0[0] * 2.0
    let s1: f64 = 2.0 * pair().1[0]
    if s0 == 3.0 && s1 == 0.5 {
        println("TUPLE_SLOT_DIRECT_INDEX_F64_ARRAY PASS")
        return 0
    }
    1
}
