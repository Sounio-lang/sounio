//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_ecdf_raster_smooth, quality_ecdf_plot_config_default}

fn is_blue(r: i64, g: i64, b: i64) -> bool {
    b > r && b > g && r < 90
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(84, 72)
    var xs: [f64; 256] = [0.0; 256]
    xs[0] = 0.0
    xs[1] = 1.0
    xs[2] = 3.0
    xs[3] = 4.0

    s = plot_ecdf_raster_smooth(s, &xs, 4, quality_ecdf_plot_config_default())

    let step1_r = surface_get_pixel_r(&s, 28, 43)
    let step1_g = surface_get_pixel_g(&s, 28, 43)
    let step1_b = surface_get_pixel_b(&s, 28, 43)
    if !is_blue(step1_r, step1_g, step1_b) {
        print("FAIL ECDF first plateau missing\n")
        return 1
    }

    let jump_r = surface_get_pixel_r(&s, 31, 39)
    let jump_g = surface_get_pixel_g(&s, 31, 39)
    let jump_b = surface_get_pixel_b(&s, 31, 39)
    if !is_blue(jump_r, jump_g, jump_b) {
        print("FAIL ECDF jump missing\n")
        return 2
    }

    let mid_r = surface_get_pixel_r(&s, 44, 35)
    let mid_g = surface_get_pixel_g(&s, 44, 35)
    let mid_b = surface_get_pixel_b(&s, 44, 35)
    if !is_blue(mid_r, mid_g, mid_b) {
        print("FAIL ECDF middle plateau missing\n")
        return 3
    }

    let top_r = surface_get_pixel_r(&s, 64, 19)
    let top_g = surface_get_pixel_g(&s, 64, 19)
    let top_b = surface_get_pixel_b(&s, 64, 19)
    if !is_blue(top_r, top_g, top_b) {
        print("FAIL ECDF final plateau missing\n")
        return 4
    }

    var outside_pixels = 0
    var y = 0
    while y < 12 {
        var x = 0
        while x < 84 {
            if surface_get_pixel_r(&s, x, y) < 240 {
                outside_pixels = outside_pixels + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    if outside_pixels > 2 {
        print("FAIL ECDF painted outside expected area\n")
        return 5
    }

    print("PASS graphics_quality_ecdf_smoke\n")
    0
}
