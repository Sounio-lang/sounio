//@ run-pass
//@ description: #2377 a bare match arm naming a module-level const/let is a value pattern (x == A), not a binding (Madaros: first arm matched everything) and not a miss (lean_single: never matched)
//@ expect-stdout: classify_2=20
//@ expect-stdout: classify_1=10
//@ expect-stdout: classify_7=30
//@ expect-stdout: let_const_3=3
//@ expect-stdout: let_const_9=0
//@ expect-stdout: shadowed=5
//@ expect-stdout: or_const_1=1
//@ expect-stdout: or_const_2=1
//@ expect-stdout: or_const_4=0
//@ expect-stdout: CONST_PATTERN_2377_OK
//
// Measured before the fix on the issue's classify(): Madaros printed 10 for
// every input (the `A` arm bound the scrutinee to a new local A), lean_single
// printed 30 for every input (both const arms were parsed as bindings and then
// never compared). `shadowed` pins that a LOCAL with the constant's name is
// still a binding, as it is in an expression. `or_const` is the or-pattern
// form (A | B): Madaros had no lowering for or-patterns at all (the arm was
// skipped, so it never matched), and the lean_single seed did not terminate
// compiling `A | B` over bare identifiers.

const A: i64 = 1
const B: i64 = 2
let C: i64 = 3

fn classify(x: i64) -> i64 {
    match x {
        A => 10,
        B => 20,
        _ => 30
    }
}

fn let_const(x: i64) -> i64 {
    match x {
        C => 3,
        _ => 0
    }
}

// A parameter named like the constant shadows it, so the arm is a BINDING
// again (of A + 4 = 5) -- not a comparison with the constant 1.
fn shadow_param(A: i64) -> i64 {
    match A + 4 {
        A => A,
        _ => 105
    }
}

fn or_const(x: i64) -> i64 {
    match x {
        A | B => 1,
        _ => 0
    }
}

fn main() -> i64 with IO {
    var ok = true
    let r2 = classify(2)
    let r1 = classify(1)
    let r7 = classify(7)
    print("classify_2=")
    println(r2)
    print("classify_1=")
    println(r1)
    print("classify_7=")
    println(r7)
    if r2 != 20 || r1 != 10 || r7 != 30 { ok = false }
    let c3 = let_const(3)
    let c9 = let_const(9)
    print("let_const_3=")
    println(c3)
    print("let_const_9=")
    println(c9)
    if c3 != 3 || c9 != 0 { ok = false }
    let s = shadow_param(1)
    print("shadowed=")
    println(s)
    if s != 5 { ok = false }
    let o1 = or_const(1)
    let o2 = or_const(2)
    let o4 = or_const(4)
    print("or_const_1=")
    println(o1)
    print("or_const_2=")
    println(o2)
    print("or_const_4=")
    println(o4)
    if o1 != 1 || o2 != 1 || o4 != 0 { ok = false }
    if ok { println("CONST_PATTERN_2377_OK") } else { println("CONST_PATTERN_2377_FAIL") }
    0
}
