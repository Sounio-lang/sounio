//@ run-pass
//@ description: #1263 — borrowing a linear value (`&p`) is not a use; consuming it afterwards is its one use (both engines)
//@ expect-stdout: 38

linear struct Handle {
    id: i64,
}

fn inspect(h: &Handle) -> i64 {
    h.id
}

fn close(h: Handle) -> i64 {
    h.id
}

fn main() -> i64 with IO {
    let h = Handle { id: 19 }
    let a = inspect(&h)
    let b = close(h)
    println(a + b)
    0
}
