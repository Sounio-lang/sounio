//@ run-pass
//@ requires: madaros
//@ expect-stdout: kl14d_multi_needed: PASS
// KL-14d1: two DT_NEEDED libs; each symbol resolves in its own .so.
// Needs libkl14d_a.so + libkl14d_b.so on LD_LIBRARY_PATH.
// Gate: scripts/ci/madaros_kl14d_multi_needed_gate.sh

extern "C" {
    fn kl14d_a(x: i64) -> i64
    fn kl14d_b(x: i64) -> i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    // (10+1)*3 = 33
    let v = kl14d_b(kl14d_a(10))
    if v == 33 {
        println("kl14d_multi_needed: PASS")
        return 0
    }
    println("kl14d_multi_needed: FAIL")
    return 1
}
