//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz Taylor-2 remainder radius receipt for the i256 ball bridge

fn ceil_div_nonneg(n: i64, d: i64) -> i64 with Div {
    if n < 0 { return 0 - 1 }
    if d <= 0 { return 0 - 1 }
    return (n + d - 1) / d
}

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn taylor2_remainder_den(step_den: i64) -> i64 {
    if step_den <= 0 { return 0 - 1 }
    return 6 * step_den * step_den * step_den
}

fn taylor2_remainder_radius(third_abs: i64, step_den: i64) -> i64 with Div {
    if third_abs < 0 { return 0 - 1 }
    let den = taylor2_remainder_den(step_den)
    if den <= 0 { return 0 - 1 }
    return ceil_div_nonneg(third_abs, den)
}

fn taylor2_remainder_fingerprint(bridge_fp: i64, validation_mask_expected: i64) -> i64 with Div {
    if bridge_fp != 979362768 { return 0 - 1 }
    if validation_mask_expected != 127 { return 0 - 1 }

    let rx = taylor2_remainder_radius(607000000, 100)
    let ry = taylor2_remainder_radius(809000000, 100)
    let rz = taylor2_remainder_radius(119000000, 100)
    if rx != 102 { return 0 - 1 }
    if ry != 135 { return 0 - 1 }
    if rz != 20 { return 0 - 1 }

    let x_slack = 250000 - 243366
    let y_slack = 325000 - 319640
    let z_slack = 50000 - 42448
    if x_slack != 6634 { return 0 - 1 }
    if y_slack != 5360 { return 0 - 1 }
    if z_slack != 7552 { return 0 - 1 }

    let x_after = x_slack - rx
    let y_after = y_slack - ry
    let z_after = z_slack - rz
    if x_after != 6532 { return 0 - 1 }
    if y_after != 5225 { return 0 - 1 }
    if z_after != 7532 { return 0 - 1 }

    var validation_mask: i64 = 0
    if rx == 102 { validation_mask = validation_mask + 1 }
    if ry == 135 { validation_mask = validation_mask + 2 }
    if rz == 20 { validation_mask = validation_mask + 4 }
    if x_after >= 0 { validation_mask = validation_mask + 8 }
    if y_after >= 0 { validation_mask = validation_mask + 16 }
    if z_after >= 0 { validation_mask = validation_mask + 32 }
    if bridge_fp == 979362768 { validation_mask = validation_mask + 64 }
    if validation_mask != validation_mask_expected { return 0 - 1 }

    var fp: i64 = 503
    fp = quality_mix(fp, bridge_fp)
    fp = quality_mix(fp, 1000000)
    fp = quality_mix(fp, 5)
    fp = quality_mix(fp, 2)
    fp = quality_mix(fp, 100)
    fp = quality_mix(fp, 607000000)
    fp = quality_mix(fp, 809000000)
    fp = quality_mix(fp, 119000000)
    fp = quality_mix(fp, rx)
    fp = quality_mix(fp, ry)
    fp = quality_mix(fp, rz)
    fp = quality_mix(fp, 243366)
    fp = quality_mix(fp, 319640)
    fp = quality_mix(fp, 42448)
    fp = quality_mix(fp, 250000)
    fp = quality_mix(fp, 325000)
    fp = quality_mix(fp, 50000)
    fp = quality_mix(fp, x_slack)
    fp = quality_mix(fp, y_slack)
    fp = quality_mix(fp, z_slack)
    fp = quality_mix(fp, x_after)
    fp = quality_mix(fp, y_after)
    fp = quality_mix(fp, z_after)
    fp = quality_mix(fp, validation_mask)
    return fp
}

fn taylor2_remainder_audit_fingerprint(remainder_fp: i64) -> i64 {
    if remainder_fp != 320985955 { return 0 - 1 }

    var fp: i64 = 509
    fp = quality_mix(fp, remainder_fp)
    fp = quality_mix(fp, 979362768)
    fp = quality_mix(fp, 70877465)
    fp = quality_mix(fp, 565673886)
    fp = quality_mix(fp, 114244647)
    fp = quality_mix(fp, 127)
    return fp
}

fn main() -> i64 with Div {
    if taylor2_remainder_den(100) != 6000000 { return 1 }
    if taylor2_remainder_radius(607000000, 100) != 102 { return 2 }
    if taylor2_remainder_radius(606000000, 100) != 101 { return 3 }
    if taylor2_remainder_radius(606000001, 100) != 102 { return 4 }

    let fp = taylor2_remainder_fingerprint(979362768, 127)
    if fp != 320985955 { return 5 }
    let audit_fp = taylor2_remainder_audit_fingerprint(fp)
    if audit_fp != 980184978 { return 6 }

    if taylor2_remainder_fingerprint(979362769, 127) != (0 - 1) { return 7 }
    if taylor2_remainder_fingerprint(979362768, 126) != (0 - 1) { return 8 }
    if taylor2_remainder_audit_fingerprint(320985956) != (0 - 1) { return 9 }
    return 0
}
