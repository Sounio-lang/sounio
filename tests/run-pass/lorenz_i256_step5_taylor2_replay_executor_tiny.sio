//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 replay executor receipt checks node and edge replay masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1321
    fp = mix(fp, 5, 5113)
    fp = mix(fp, 847188269, 5113)
    fp = mix(fp, 425385087, 5113)
    fp = mix(fp, 971755585, 5113)
    fp = mix(fp, 989883403, 5113)
    fp = mix(fp, 422368008, 5113)
    fp = mix(fp, 171451971, 5113)
    fp = mix(fp, 815806077, 5113)
    fp = mix(fp, 69995750, 5113)
    fp = mix(fp, 1, 5113)
    fp = mix(fp, 1, 5113)
    fp = mix(fp, 4, 5113)
    fp = mix(fp, 4, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 15, 5113)
    fp = mix(fp, 0, 5113)
    fp = mix(fp, 7, 5113)
    fp = mix(fp, 0, 5113)
    fp = mix(fp, 0, 5113)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 201510806 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1327
    fp = mix(fp, instance, 5119)
    fp = mix(fp, 4, 5119)
    fp = mix(fp, 4, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 15, 5119)
    fp = mix(fp, 0, 5119)
    fp = mix(fp, 7, 5119)
    fp = mix(fp, ok_mask, 5119)
    fp = mix(fp, 0, 5119)
    fp = mix(fp, 0, 5119)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 201510806 { return 0 - 1 }
    if certificate != 882863410 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1329
    fp = mix(fp, instance, 5123)
    fp = mix(fp, certificate, 5123)
    fp = mix(fp, 8, 5123)
    fp = mix(fp, 5, 5123)
    fp = mix(fp, 1, 5123)
    fp = mix(fp, 1, 5123)
    fp = mix(fp, 7, 5123)
    fp = mix(fp, ok_mask, 5123)
    fp = mix(fp, 0, 5123)
    fp = mix(fp, 0, 5123)
    return fp
}

fn replay_execution_mask() -> i64 {
    let node_receipt_mask: i64 = 15
    let edge_receipt_mask: i64 = 15
    let replayed_node_mask: i64 = 15
    let predecessor_ready_mask: i64 = 15
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0
    let replay_status: i64 = 7

    var ok_mask: i64 = 0
    if 847188269 > 0 {
        if 971755585 > 0 {
            if 989883403 > 0 { ok_mask = ok_mask + 1 }
        }
    }
    if node_receipt_mask == 15 { ok_mask = ok_mask + 2 }
    if edge_receipt_mask == node_receipt_mask { ok_mask = ok_mask + 4 }
    if replayed_node_mask == node_receipt_mask {
        if predecessor_ready_mask == edge_receipt_mask { ok_mask = ok_mask + 8 }
    }
    if replay_status == 7 { ok_mask = ok_mask + 16 }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if 847188269 != 971755585 {
        if 971755585 != 989883403 { ok_mask = ok_mask + 64 }
    }
    if local_containment_mask == 0 {
        if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = replay_execution_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 201510806 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 882863410 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 225293164 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
