//@ run-pass
//@ description: #2826 — the literal 1.0e-300 is the correctly rounded binary64 (significand 6032057205060441 x 2^-997) on both engines; lean_single's run-time divsd chain landed 13 ulps off (6032057205060454).
//@ expect-stdout: 6032057205060441 -997

fn main() -> i32 with IO, Mut, Div, Panic, Alloc {
    var a = 1.0e-300
    var e: i64 = 0
    while a < 1.0 { a = a * 2.0; e = e - 1 }
    print_int((a * 4503599627370496.0) as i64)
    print(" ")
    print_int(e)
    print("\n")
    return 0
}
