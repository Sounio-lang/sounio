//@ run-pass
//@ requires: madaros
//@ description: Scalar graph-colouring graph-instance fingerprint and UNSAT-claim gate

fn card_exactly_one_clause_count(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return 1 + (n * (n - 1)) / 2
}

fn card_colour_vertex_block_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex: i64 = card_exactly_one_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex
}

fn card_colour_edge_base_id(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    let per_vertex: i64 = card_exactly_one_clause_count(colour_count)
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex + 1
}

fn card_colour_edge_clause_count(edge_count: i64, colour_count: i64) -> i64 {
    if edge_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return edge_count * colour_count
}

fn card_colour_total_clause_count(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let vertex_block: i64 = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_block: i64 = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    return vertex_block + edge_block
}

fn card_colour_var_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return vertex_count * colour_count
}

fn card_colour_manifest_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 1315423911) + value + 97) % 1000000007
}

fn card_colour_manifest_fingerprint(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let var_count: i64 = card_colour_var_count(vertex_count, colour_count)
    if var_count < 0 { return 0 - 1 }
    let vertex_block: i64 = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_base: i64 = card_colour_edge_base_id(vertex_count, colour_count)
    if edge_base < 0 { return 0 - 1 }
    let edge_block: i64 = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    let total: i64 = card_colour_total_clause_count(vertex_count, edge_count, colour_count)
    if total < 0 { return 0 - 1 }

    var acc: i64 = 17
    acc = card_colour_manifest_mix(acc, vertex_count)
    acc = card_colour_manifest_mix(acc, edge_count)
    acc = card_colour_manifest_mix(acc, colour_count)
    acc = card_colour_manifest_mix(acc, var_count)
    acc = card_colour_manifest_mix(acc, vertex_block)
    acc = card_colour_manifest_mix(acc, edge_base)
    acc = card_colour_manifest_mix(acc, edge_block)
    acc = card_colour_manifest_mix(acc, total)
    return acc
}

fn graph_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn graph_edge_valid(vertex_count: i64, u: i64, v: i64) -> i64 {
    if vertex_count <= 0 { return 0 }
    if u < 0 { return 0 }
    if v < 0 { return 0 }
    if u >= vertex_count { return 0 }
    if v >= vertex_count { return 0 }
    if u == v { return 0 }
    if u > v { return 0 }
    return 1
}

fn graph3_edges_valid(vertex_count: i64, e0u: i64, e0v: i64,
                      e1u: i64, e1v: i64, e2u: i64, e2v: i64) -> i64 {
    if graph_edge_valid(vertex_count, e0u, e0v) == 0 { return 0 }
    if graph_edge_valid(vertex_count, e1u, e1v) == 0 { return 0 }
    if graph_edge_valid(vertex_count, e2u, e2v) == 0 { return 0 }
    if e0u > e1u { return 0 }
    if e0u == e1u {
        if e0v >= e1v { return 0 }
    }
    if e1u > e2u { return 0 }
    if e1u == e2u {
        if e1v >= e2v { return 0 }
    }
    return 1
}

fn graph3_fingerprint(vertex_count: i64, e0u: i64, e0v: i64,
                      e1u: i64, e1v: i64, e2u: i64, e2v: i64) -> i64 {
    if graph3_edges_valid(vertex_count, e0u, e0v, e1u, e1v, e2u, e2v) == 0 {
        return 0 - 1
    }

    var acc: i64 = 37
    acc = graph_mix(acc, vertex_count, 457)
    acc = graph_mix(acc, 3, 457)
    acc = graph_mix(acc, e0u, 457)
    acc = graph_mix(acc, e0v, 457)
    acc = graph_mix(acc, e1u, 457)
    acc = graph_mix(acc, e1v, 457)
    acc = graph_mix(acc, e2u, 457)
    acc = graph_mix(acc, e2v, 457)
    return acc
}

fn graph3_instance_fingerprint(vertex_count: i64, colour_count: i64,
                               e0u: i64, e0v: i64,
                               e1u: i64, e1v: i64,
                               e2u: i64, e2v: i64,
                               manifest_fingerprint: i64) -> i64 {
    let graph_fp: i64 = graph3_fingerprint(vertex_count, e0u, e0v, e1u, e1v, e2u, e2v)
    if graph_fp < 0 { return 0 - 1 }
    if manifest_fingerprint != card_colour_manifest_fingerprint(vertex_count, 3, colour_count) { return 0 - 1 }

    let var_count: i64 = card_colour_var_count(vertex_count, colour_count)
    if var_count < 0 { return 0 - 1 }
    let total: i64 = card_colour_total_clause_count(vertex_count, 3, colour_count)
    if total < 0 { return 0 - 1 }

    var acc: i64 = 41
    acc = graph_mix(acc, graph_fp, 463)
    acc = graph_mix(acc, colour_count, 463)
    acc = graph_mix(acc, manifest_fingerprint, 463)
    acc = graph_mix(acc, var_count, 463)
    acc = graph_mix(acc, total, 463)
    return acc
}

fn graph3_unsat_claim_fingerprint(instance_fingerprint: i64,
                                  unsat_bundle_fingerprint: i64,
                                  replay_anchor: i64,
                                  derived_count: i64,
                                  final_derived_id: i64,
                                  result_code: i64) -> i64 {
    if instance_fingerprint <= 0 { return 0 - 1 }
    if unsat_bundle_fingerprint <= 0 { return 0 - 1 }
    if replay_anchor <= 0 { return 0 - 1 }
    if derived_count <= 0 { return 0 - 1 }
    if final_derived_id <= 0 { return 0 - 1 }
    if result_code != 0 { return 0 - 1 }

    var acc: i64 = 43
    acc = graph_mix(acc, instance_fingerprint, 467)
    acc = graph_mix(acc, unsat_bundle_fingerprint, 467)
    acc = graph_mix(acc, replay_anchor, 467)
    acc = graph_mix(acc, derived_count, 467)
    acc = graph_mix(acc, final_derived_id, 467)
    acc = graph_mix(acc, result_code, 467)
    return acc
}

fn main() -> i64 {
    let manifest_fp: i64 = card_colour_manifest_fingerprint(3, 3, 2)
    let graph_fp: i64 = graph3_fingerprint(3, 0, 1, 0, 2, 1, 2)
    let instance_fp: i64 = graph3_instance_fingerprint(3, 2, 0, 1, 0, 2, 1, 2, manifest_fp)
    let claim_fp: i64 = graph3_unsat_claim_fingerprint(instance_fp, 500954697, 891522734, 7, 19, 0)

    if manifest_fp != 296728038 { return 1 }
    if graph_fp != 786487984 { return 2 }
    if instance_fp != 77085393 { return 3 }
    if claim_fp != 848522370 { return 4 }

    if graph3_edges_valid(3, 0, 0, 0, 2, 1, 2) != 0 { return 10 }
    if graph3_edges_valid(3, 0, 2, 0, 1, 1, 2) != 0 { return 11 }
    if graph3_fingerprint(3, 0, 1, 0, 2, 2, 1) != (0 - 1) { return 12 }
    if graph3_instance_fingerprint(3, 2, 0, 1, 0, 2, 1, 2, manifest_fp + 1) != (0 - 1) { return 13 }
    if graph3_unsat_claim_fingerprint(instance_fp, 500954697, 891522734, 7, 19, 1) != (0 - 1) { return 14 }
    if graph3_unsat_claim_fingerprint(instance_fp, 500954697, 891522734, 0, 19, 0) != (0 - 1) { return 15 }

    return 0
}
