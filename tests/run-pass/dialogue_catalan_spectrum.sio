//@ run-pass
//@ expect-stdout: ALL PASS
//
// Acceptance for stdlib/dialogue/catalan.sio — the 5-point Catalan spectrum
// of a four-turn trajectory.
//
//   W1  associative segment (all turns inside the quaternionic Fano
//       subalgebra e1,e2,e3): spectrum collapses — distinct = 1, diameter = 0
//   W2  non-associative segment (e1,e2,e4,e1): spectrum does NOT collapse —
//       distinct ≥ 2, diameter > 0
//   W3  every spectrum point is a signed basis octonion (norm = 1 exactly):
//       the spectrum lives on the unit basis sphere for basis turns
//   W4  self-consistency: B0 equals nested bracket evaluation via
//       bracket_left twice

use dialogue::catalan::{
    catalan_spectrum4, catalan_diameter4, catalan_distinct4,
}
use dialogue::bracket::{traj_turn_oct}
use algebra::octonion::{oct_mul}
use dialogue::trajectory::{
    Trajectory, traj_empty, traj_push, traj_set_payload,
}

fn approx(x: f64, y: f64) -> bool {
    let d = if x > y { x - y } else { y - x }
    d < 0.0001
}

fn push_basis_turn(t: &Trajectory, speaker: i64, idx: i64) with Mut {
    let i: i64 = traj_push(t, speaker, 0, 0, 0, 16)
    traj_set_payload(t, i - 1, idx, 1.0)
}

fn main() with Mut, Div, Panic, NonAssoc {
    var ok = true

    // --- W1: associative segment collapses (e1, e2, e3, e2) ---
    var ta: Trajectory = traj_empty()
    push_basis_turn(&!ta, 0, 1)
    push_basis_turn(&!ta, 1, 2)
    push_basis_turn(&!ta, 0, 3)
    push_basis_turn(&!ta, 1, 2)
    let da: f64 = catalan_diameter4(&ta)
    let na: i64 = catalan_distinct4(&ta, 0.0001)
    if na == 1 { print("W1 associative distinct=1: PASS") }
    else { print("W1 associative distinct: FAIL"); ok = false }
    if approx(da, 0.0) { print("W1 associative diameter=0: PASS") }
    else { print("W1 associative diameter: FAIL"); ok = false }

    // --- W2: non-associative segment (e1, e2, e4, e1) does not collapse ---
    var tb: Trajectory = traj_empty()
    push_basis_turn(&!tb, 0, 1)
    push_basis_turn(&!tb, 1, 2)
    push_basis_turn(&!tb, 0, 4)
    push_basis_turn(&!tb, 1, 1)
    let db: f64 = catalan_diameter4(&tb)
    let nb: i64 = catalan_distinct4(&tb, 0.0001)
    if nb >= 2 { print("W2 nonassoc distinct≥2: PASS") }
    else { print("W2 nonassoc distinct: FAIL"); ok = false }
    if db > 0.1 { print("W2 nonassoc diameter>0: PASS") }
    else { print("W2 nonassoc diameter: FAIL"); ok = false }

    // --- W3: every composite of basis turns is unit-norm ---
    var spec: [f64; 40] = [0.0; 40]
    catalan_spectrum4(&tb, &!spec)
    var unit: bool = true
    var b: i64 = 0
    while b < 5 {
        var nsq: f64 = 0.0
        var k: i64 = 0
        while k < 8 {
            nsq = nsq + spec[(b * 8 + k) as usize] * spec[(b * 8 + k) as usize]
            k = k + 1
        }
        if !approx(nsq, 1.0) { unit = false }
        b = b + 1
    }
    if unit { print("W3 spectrum on unit sphere: PASS") }
    else { print("W3 unit sphere: FAIL"); ok = false }

    // --- W4: B0 equals nested left multiplications (((u1u2)u3)u4) ---
    var u1: [f64; 8] = [0.0; 8]
    var u2: [f64; 8] = [0.0; 8]
    var u3: [f64; 8] = [0.0; 8]
    var u4: [f64; 8] = [0.0; 8]
    traj_turn_oct(&tb, 0, &!u1)
    traj_turn_oct(&tb, 1, &!u2)
    traj_turn_oct(&tb, 2, &!u3)
    traj_turn_oct(&tb, 3, &!u4)
    var t12: [f64; 8] = [0.0; 8]
    var t123: [f64; 8] = [0.0; 8]
    var nested: [f64; 8] = [0.0; 8]
    oct_mul(&u1, &u2, &!t12)
    oct_mul(&t12, &u3, &!t123)
    oct_mul(&t123, &u4, &!nested)
    var same: bool = true
    var k2: i64 = 0
    while k2 < 8 {
        if !approx(nested[k2], spec[k2]) { same = false }
        k2 = k2 + 1
    }
    if same { print("W4 B0 == nested left product: PASS") }
    else { print("W4 nested equality: FAIL"); ok = false }

    if ok { print("ALL PASS") } else { print("SOME FAIL") }
}
