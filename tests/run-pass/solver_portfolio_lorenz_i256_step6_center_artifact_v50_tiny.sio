//@ run-pass
//@ description: Tiny portfolio v50 smoke for Lorenz i256 step-6 center artifact entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 271
    receipt_fp = mix(receipt_fp, 134624236, 3271)
    receipt_fp = mix(receipt_fp, 643317565, 3271)
    receipt_fp = mix(receipt_fp, 120531857, 3271)
    receipt_fp = mix(receipt_fp, 678566245, 3271)
    receipt_fp = mix(receipt_fp, 367410832, 3271)
    receipt_fp = mix(receipt_fp, 6, 3271)
    receipt_fp = mix(receipt_fp, 1, 3271)
    receipt_fp = mix(receipt_fp, 127, 3271)
    if receipt_fp != 40206573 { return 1 }

    var audit_fp: i64 = 277
    audit_fp = mix(audit_fp, receipt_fp, 3299)
    audit_fp = mix(audit_fp, 134624236, 3299)
    audit_fp = mix(audit_fp, 643317565, 3299)
    audit_fp = mix(audit_fp, 882801596, 3299)
    audit_fp = mix(audit_fp, 961618971, 3299)
    audit_fp = mix(audit_fp, 367410832, 3299)
    audit_fp = mix(audit_fp, 6, 3299)
    audit_fp = mix(audit_fp, 1, 3299)
    audit_fp = mix(audit_fp, 127, 3299)
    if audit_fp != 6362158 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 53, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 53, 1103)
    if entry_fp != 649815843 { return 3 }
    return 0
}
