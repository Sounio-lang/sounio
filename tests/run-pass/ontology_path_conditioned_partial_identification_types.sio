//@ run-pass
//@ expect-stdout: path conditioned partial identification parallel ontology OK

ontology PathConditionedPartialIdentificationWitness {
    class EpistemicArtifact
    class ObservationArtifact subclass_of EpistemicArtifact
    class ScalarProjectionObservation subclass_of ObservationArtifact
    class ObservedFalse subclass_of ObservationArtifact
    class NotMeasured subclass_of ObservationArtifact
    class MissingUnderPolicy subclass_of ObservationArtifact
    class StateArtifact subclass_of EpistemicArtifact
    class LatentState subclass_of StateArtifact
    class IdentifiedSetArtifact subclass_of EpistemicArtifact
    class ExactIdentifiedSet subclass_of IdentifiedSetArtifact
    class SoundOuterIdentifiedSet subclass_of IdentifiedSetArtifact
    class StatisticalSetArtifact subclass_of EpistemicArtifact
    class ConfidenceRegion subclass_of StatisticalSetArtifact
    class PredictiveSet subclass_of StatisticalSetArtifact
    class OrderedHistoryArtifact subclass_of EpistemicArtifact
    class OrderedHistoryAB subclass_of OrderedHistoryArtifact
    class OrderedHistoryBA subclass_of OrderedHistoryArtifact
    class SetInferenceArtifact subclass_of EpistemicArtifact
    class OuterOnlyOverlapUndecided subclass_of SetInferenceArtifact
    class RealIdentifiedSetOverlap subclass_of SetInferenceArtifact
    class ModelEvidenceConflict subclass_of SetInferenceArtifact
    class CausalStatusArtifact subclass_of EpistemicArtifact
    class AssociationReceipt subclass_of CausalStatusArtifact
    class InterventionReceipt subclass_of CausalStatusArtifact
    class ContextArtifact subclass_of EpistemicArtifact
    class IndividualContext subclass_of ContextArtifact
    class DyadicContext subclass_of ContextArtifact
    class InterpretationArtifact subclass_of EpistemicArtifact
    class SufferingProxy subclass_of InterpretationArtifact
    class HumanSuffering subclass_of InterpretationArtifact
}

fn accept_observation(v: ObservationArtifact) -> i32 { 0 }
fn accept_state(v: StateArtifact) -> i32 { 0 }
fn accept_identified(v: IdentifiedSetArtifact) -> i32 { 0 }
fn accept_statistical(v: StatisticalSetArtifact) -> i32 { 0 }
fn accept_history(v: OrderedHistoryArtifact) -> i32 { 0 }
fn accept_inference(v: SetInferenceArtifact) -> i32 { 0 }
fn accept_causal_status(v: CausalStatusArtifact) -> i32 { 0 }
fn accept_context(v: ContextArtifact) -> i32 { 0 }
fn accept_interpretation(v: InterpretationArtifact) -> i32 { 0 }

fn exact_bridge(v: ExactIdentifiedSet) -> i32 { accept_identified(v) }
fn confidence_bridge(v: ConfidenceRegion) -> i32 { accept_statistical(v) }
fn history_bridge(v: OrderedHistoryAB) -> i32 { accept_history(v) }
fn undecided_bridge(v: OuterOnlyOverlapUndecided) -> i32 { accept_inference(v) }
fn association_bridge(v: AssociationReceipt) -> i32 { accept_causal_status(v) }
fn individual_bridge(v: IndividualContext) -> i32 { accept_context(v) }
fn proxy_bridge(v: SufferingProxy) -> i32 { accept_interpretation(v) }

fn main() -> i32 {
    print("path conditioned partial identification parallel ontology OK\n")
    0
}
