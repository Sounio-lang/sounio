//@ run-pass
// Dual-channel epistemic field renderer proof.
// Expected output: VIZ_EPISTEMIC_FIELD_RECEIPT_PASS

use display::canvas::{Canvas, canvas_clear}
use epistemic::knightian::{pb_new}
use viz::field_canvas::{field_epistemic_at, field_pbox_threshold_class, field_render_epistemic_frontier}
use viz::physchem::{scalar_field_radial}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pixels = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pixels, width: w, height: h }
}

fn main() with IO, Alloc, Mut, Div {
    var a = make_canvas(240, 140)
    var b = make_canvas(240, 140)
    canvas_clear(&!a, 8, 12, 20)
    canvas_clear(&!b, 8, 12, 20)
    let field = scalar_field_radial(32, 32)
    assert(field.rows == 32)
    assert(field.cols == 32)
    assert(field.variances[31 * 32 + 31] > field.variances[16 * 32 + 16])
    let center_epistemic = field_epistemic_at(&field, 16 * 32 + 16, 777)
    assert(center_epistemic.confidence() == 777)
    assert(center_epistemic.val() == field.values[16 * 32 + 16])
    let above = pb_new(0.8, 1.2, 0.04, 850)
    let ambiguous = pb_new(0.0 - 0.2, 0.3, 0.04, 850)
    let below = pb_new(0.0 - 1.2, 0.0 - 0.8, 0.04, 850)
    assert(field_pbox_threshold_class(&above, 0.0) == 1)
    assert(field_pbox_threshold_class(&ambiguous, 0.0) == 0)
    assert(field_pbox_threshold_class(&below, 0.0) == 0 - 1)
    field_render_epistemic_frontier(&field, &!a, 12, 16, 100, 84, 16, 250.0, 18.0)
    field_render_epistemic_frontier(&field, &!b, 12, 16, 100, 84, 16, 250.0, 18.0)

    var mismatch: i64 = 0
    var changed: i64 = 0
    var channel_difference: i64 = 0
    var i: i64 = 0
    while i < 240 * 140 {
        let pa = read_i64(a.pixels, i)
        let pb = read_i64(b.pixels, i)
        if pa != pb { mismatch = mismatch + 1 }
        if pa != (20 | (12 << 8) | (8 << 16)) { changed = changed + 1 }
        i = i + 1
    }
    var sample: i64 = 0
    while sample < 90 {
        let left = read_i64(a.pixels, (16 + sample) * 240 + 62)
        let right = read_i64(a.pixels, (16 + sample) * 240 + 178)
        if left != right { channel_difference = channel_difference + 1 }
        sample = sample + 1
    }
    assert(mismatch == 0)
    assert(changed > 18000)
    assert(channel_difference > 80)
    println("VIZ_EPISTEMIC_FIELD_RECEIPT_PASS")
    heap_free(a.pixels as *mut i8)
    heap_free(b.pixels as *mut i8)
}
