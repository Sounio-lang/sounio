//@ run-pass
//@ expect-stdout-contains: BOXMATRIX OK
// Regression witness for Box<T> auto-deref. The no-field call at the end guards
// against copying LowerLocalStack while consulting Box inner-layout metadata.
// label_id transport is not a fix: Box<T> is not marked is_ref, so the broken
// IrFieldGet already has no deref marker and the wrong field index before MIR.

struct Sp {
    a: i64,
    b: i64,
}

struct Ex {
    kind: i64,
    span: Sp,
    tag: i64,
}

struct HolderInline {
    inner: Ex,
    n: i64,
}

struct HolderBox {
    inner: Box<Ex>,
    n: i64,
}

fn mk() -> Ex {
    Ex { kind: 3, span: Sp { a: 111, b: 222 }, tag: 9 }
}

fn p_scalar_auto(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    b.tag
}

fn p_scalar_expl(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    (*b).tag
}

fn p_struct_auto(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    let s = b.span
    s.a
}

fn p_struct_expl(b: Box<Ex>) -> i64 with Mut, Panic, Div {
    let s = (*b).span
    s.a
}

fn p_ref(e: &Ex) -> i64 with Mut, Panic, Div {
    e.tag
}

fn takes_box(b: Box<Ex>) -> i64 {
    let _unused = b
    7
}

fn check(got: i64, want: i64, ok: bool) -> bool with IO, Mut, Panic, Div {
    if got == want {
        return ok
    }
    print("MISMATCH got=")
    print_int(got)
    print(" want=")
    print_int(want)
    print("\n")
    false
}

fn main() with IO, Mut, Panic, Div, Alloc {
    var ok = true
    ok = check(p_scalar_expl(Box::new(mk())), 9, ok)
    ok = check(p_scalar_auto(Box::new(mk())), 9, ok)
    ok = check(p_struct_expl(Box::new(mk())), 111, ok)
    ok = check(p_struct_auto(Box::new(mk())), 111, ok)
    let bl = Box::new(mk())
    ok = check((*bl).tag, 9, ok)
    let bl1 = Box::new(mk())
    ok = check(bl1.tag, 9, ok)
    let bl2 = Box::new(mk())
    let s2 = bl2.span
    ok = check(s2.a, 111, ok)
    var hi: HolderInline = HolderInline { inner: mk(), n: 1 }
    var hb: HolderBox = HolderBox { inner: Box::new(mk()), n: 2 }
    ok = check(hi.inner.tag, 9, ok)
    ok = check(hb.inner.tag, 9, ok)
    let bi = hb.inner
    ok = check(bi.tag, 9, ok)
    ok = check((*hb.inner).tag, 9, ok)
    let x = mk()
    ok = check(p_ref(&x), 9, ok)
    ok = check(takes_box(Box::new(mk())), 7, ok)
    let after_box_call = mk()
    ok = check(after_box_call.tag, 9, ok)
    if ok {
        println("BOXMATRIX OK")
    } else {
        println("BOXMATRIX FAIL")
    }
}
