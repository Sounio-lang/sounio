//@ run-pass
//@ description: ExactlyPrivate<T, A> accepts a well-formed ZD locus. Positive
//@ control for the locus interrogation: e3e10 names two distinct sedenion
//@ imaginary units with 1 <= 3 < 10 <= 15, so it must be ACCEPTED.

fn release(x: ExactlyPrivate<f64, e3e10>) -> f64 with ZD { 0.0 }

// The parameter type is only interrogated once the function has a LIVE caller:
// `fn f(x: T)` alone checks clean for every T, invented types included. An
// earlier revision of these witnesses omitted this and reported PASS for a
// refusal that never happened.
fn caller() -> f64 with ZD {
    let v: f64 = 1.0
    release(v)
}

fn main() -> i32 with IO {
    println("locus ok")
    0
}
