//@ run-pass
//@ requires: madaros
//@ expect-stdout: NESTED_ARRAY_FLOAT_FIELDS_OK
struct Earlier {weight:i64,padding:i64}
struct Weighted {neighbor:i64,weight:f64}
fn rows()->[[Weighted]] with Mut,Alloc,Panic,Div {
    var row:[Weighted]=[]
    row=row++[Weighted{neighbor:1,weight:0.5}]
    row=row++[Weighted{neighbor:2,weight:0.75}]
    var out:[[Weighted]]=[]
    out=out++[row]
    out
}
fn planes()->[[[Weighted]]] with Mut,Alloc,Panic,Div {
    var out:[[[Weighted]]]=[]
    out=out++[rows()]
    out
}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
    let first=rows()
    let later=rows()
    assert(first[0][0].neighbor==1)
    assert(first[0][0].weight==0.5)
    assert(first[0][1].weight==0.75)
    assert(later[0][1].neighbor==2)
    let deep=planes()
    assert(deep[0][0][1].neighbor==2)
    assert(deep[0][0][1].weight==0.75)
    var annotated:[[Weighted]]=rows()
    assert(annotated[0][0].weight==0.5)
    let local=first[0][1]
    assert(local.weight==0.75)
    println("NESTED_ARRAY_FLOAT_FIELDS_OK")
    0
}
