//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v111 smoke for Lorenz i256 step-3 Taylor-2 flowpipe obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2039
    receipt_fp = mix(receipt_fp, 743452338, 6067)
    receipt_fp = mix(receipt_fp, 255714212, 6067)
    receipt_fp = mix(receipt_fp, 739787906, 6067)
    receipt_fp = mix(receipt_fp, 767613887, 6067)
    receipt_fp = mix(receipt_fp, 843058093, 6067)
    receipt_fp = mix(receipt_fp, 896565841, 6067)
    receipt_fp = mix(receipt_fp, 124115315, 6067)
    receipt_fp = mix(receipt_fp, 420821728, 6067)
    receipt_fp = mix(receipt_fp, 904983474, 6067)
    receipt_fp = mix(receipt_fp, 3, 6067)
    receipt_fp = mix(receipt_fp, 15, 6067)
    receipt_fp = mix(receipt_fp, 255, 6067)
    if receipt_fp != 878835307 { return 1 }

    var audit_fp: i64 = 2053
    audit_fp = mix(audit_fp, receipt_fp, 6073)
    audit_fp = mix(audit_fp, 743452338, 6073)
    audit_fp = mix(audit_fp, 255714212, 6073)
    audit_fp = mix(audit_fp, 207736416, 6073)
    audit_fp = mix(audit_fp, 314571242, 6073)
    audit_fp = mix(audit_fp, 280440446, 6073)
    audit_fp = mix(audit_fp, 300531949, 6073)
    audit_fp = mix(audit_fp, 718264441, 6073)
    audit_fp = mix(audit_fp, 47474367, 6073)
    audit_fp = mix(audit_fp, 994004460, 6073)
    audit_fp = mix(audit_fp, 792236662, 6073)
    audit_fp = mix(audit_fp, 9964953, 6073)
    audit_fp = mix(audit_fp, 847302474, 6073)
    audit_fp = mix(audit_fp, 843058093, 6073)
    audit_fp = mix(audit_fp, 3, 6073)
    audit_fp = mix(audit_fp, 15, 6073)
    audit_fp = mix(audit_fp, 255, 6073)
    if audit_fp != 671919633 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 114, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 114, 1103)
    if entry_fp != 793359165 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 111, 1151)
    manifest_fp = mix(manifest_fp, 115, 1151)
    manifest_fp = mix(manifest_fp, 767613887, 1151)
    manifest_fp = mix(manifest_fp, 896565841, 1151)
    manifest_fp = mix(manifest_fp, 739787906, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 133350891 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 111, 1871)
    result_fp = mix(result_fp, 115, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 103, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 867979862 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 111, 1907)
    family_fp = mix(family_fp, 115, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 98, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 238043958 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 111, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 587282084 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 111, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
