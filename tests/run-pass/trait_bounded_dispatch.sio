//@ run-pass
// Acceptance test 1 for compiler prerequisite #3 (trait-bounded generic method dispatch).
// Spike verbatim from docs/handoff/spike_trait_bounded_dispatch.sio.
// Expected output: 5, then "spike PASS"

trait R {
    fn radd(self, o: Self) -> Self
}

impl R for i64 {
    fn radd(self, o: Self) -> Self { self + o }
}

fn use2<F: R>(a: F, b: F) -> F {
    a.radd(b)
}

fn main() with IO {
    let r = use2::<i64>(2, 3)
    println(r)
    println("spike PASS")
}
