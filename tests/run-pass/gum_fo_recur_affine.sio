//@ run-pass
//@ requires: madaros
//@ expect-stdout: a0 0.090000
//@ expect-stdout: a1 0.810000
//@ expect-stdout: a2 4.410000
//@ expect-stdout: a12 6038323.290000
//@ expect-stdout: aneg 0.090000
//@ expect-stdout: c2 15.210000
//@ expect-stdout: RECUR_AFFINE_OK
// a = 5 +- 0.3, var = 0.09.
// aff(a, n) = (2^(n+1) - 1) * a for n >= 0. n = 2 is 7^2 * 0.09.
// n = 12 is 8191^2 * 0.09. c = 3 at n = 2 is 13^2 * 0.09.

fn aff(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        2.0 * aff(x, n - 1) + x
    }
}

fn aff3(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        3.0 * aff3(x, n - 1) + x
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let a0 = variance_of(aff(a, 0))
    let a1 = variance_of(aff(a, 1))
    let a2 = variance_of(aff(a, 2))
    let a12 = variance_of(aff(a, 12))
    let aneg = variance_of(aff(a, 0 - 2))
    let c2 = variance_of(aff3(a, 2))
    print("a0 ")
    print_f64(a0)
    println("")
    print("a1 ")
    print_f64(a1)
    println("")
    print("a2 ")
    print_f64(a2)
    println("")
    print("a12 ")
    print_f64(a12)
    println("")
    print("aneg ")
    print_f64(aneg)
    println("")
    print("c2 ")
    print_f64(c2)
    println("")
    var fails: i64 = 0
    if a0 < 0.089999 || a0 > 0.090001 { fails = fails + 1 }
    if a1 < 0.809999 || a1 > 0.810001 { fails = fails + 1 }
    if a2 < 4.409999 || a2 > 4.410001 { fails = fails + 1 }
    if a12 < 6038323.28 || a12 > 6038323.30 { fails = fails + 1 }
    if aneg < 0.089999 || aneg > 0.090001 { fails = fails + 1 }
    if c2 < 15.209999 || c2 > 15.210001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_AFFINE_OK")
        0
    } else {
        println("RECUR_AFFINE_FAIL")
        1
    }
}
