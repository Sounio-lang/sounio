//@ run-pass
// Sprint 231: Effect-polymorphic closures — pure fn type blocks IO closure

fn apply_pure(f: fn(i64) -> i64, x: i64) -> i64 {
    // f has NO effects — this is a pure function call
    f(x)
}

fn apply_io(f: fn(i64) -> i64 with IO, x: i64) -> i64 with IO {
    // f has IO effect — caller must also have IO
    f(x)
}

fn pure_double(x: i64) -> i64 { x * 2 }

fn main() -> i32 with IO, Mut, Panic, Div {
    // Pure function passed to pure context — OK
    let r1 = apply_pure(pure_double, 5)
    assert(r1 == 10)

    // Pure function passed to IO context — OK (pure is subset of IO)
    let r2 = apply_io(pure_double, 5)
    assert(r2 == 10)

    // The reverse (IO fn to pure context) would be a compile error:
    // apply_pure(io_fn, 5)  // ERROR: IO effect not allowed in pure context

    print(0)
    0
}
