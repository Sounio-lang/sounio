//@ run-pass
// Tier 2: 8-input Hessian AD — arithmetic cross-pairs

// H[0,1](x*y) = 1 (sanity, idx 0 × idx 1)
fn test_h01_mul() -> f64 with IO, Epistemic {
    let xm: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let ym: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let x = xm.value
    let y = ym.value
    let z = x * y
    hessian_of(z, 0, 1)
}

// H[4,5](e*f) = 1 — inputs at index 4 and 5
fn test_h45_mul() -> f64 with IO, Epistemic {
    let m0: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(4.0, uncertainty: 0.0)
    let m4: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let m5: Knowledge<f64> = measure(6.0, uncertainty: 0.0)
    let v0 = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let e = m4.value
    let f = m5.value
    let z = e * f
    hessian_of(z, 4, 5)
}

// H[0,4](x*w) = 1 — inputs at index 0 and 4
fn test_h04_mul() -> f64 with IO, Epistemic {
    let m0: Knowledge<f64> = measure(2.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(4.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(5.0, uncertainty: 0.0)
    let m4: Knowledge<f64> = measure(7.0, uncertainty: 0.0)
    let x = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let w = m4.value
    let z = x * w
    hessian_of(z, 0, 4)
}

// H[7,7](x*x) = 2 — input at index 7
fn test_h77_xx() -> f64 with IO, Epistemic {
    let m0: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m1: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m2: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m3: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m4: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m5: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m6: Knowledge<f64> = measure(1.0, uncertainty: 0.0)
    let m7: Knowledge<f64> = measure(3.0, uncertainty: 0.0)
    let v0 = m0.value
    let v1 = m1.value
    let v2 = m2.value
    let v3 = m3.value
    let v4 = m4.value
    let v5 = m5.value
    let v6 = m6.value
    let x = m7.value
    let z = x * x
    hessian_of(z, 7, 7)
}

fn main() with IO, Epistemic {
    let h01 = test_h01_mul()    // expect 1.0
    let h45 = test_h45_mul()    // expect 1.0
    let h04 = test_h04_mul()    // expect 1.0
    let h77 = test_h77_xx()     // expect 2.0
    println(h01)
    println(h45)
    println(h04)
    println(h77)
}
