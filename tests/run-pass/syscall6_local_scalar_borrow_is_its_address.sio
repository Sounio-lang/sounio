//@ run-pass
//@ description: `&!x` of a local scalar passed to syscall6 is the address of x -- pipe() fills it, and write()/read() through two locals round-trip eight bytes; the borrow used to be stripped to x's VALUE (write(fd, 0x7, ..) = EFAULT, wait4(pid, &!status, ..) read every exit status as 0)
//@ expect-stdout: SYSCALL6_LOCAL_SCALAR_OK

fn main() -> i32 with IO, Mut {
    var fds: i64 = 0
    let piped: i64 = syscall6(22, &!fds, 0, 0, 0, 0, 0)
    if piped != 0 { return 1 }
    let rfd = fds & 4294967295
    let wfd = fds >> 32
    if rfd <= 2 || wfd <= 2 || rfd == wfd { return 2 }
    var out: i64 = 72623859790382856
    let wrote: i64 = syscall6(1, wfd, &!out, 8, 0, 0, 0)
    if wrote != 8 { return 3 }
    var got: i64 = 0
    let read_n: i64 = syscall6(0, rfd, &!got, 8, 0, 0, 0)
    if read_n != 8 { return 4 }
    if got != 72623859790382856 { return 5 }
    syscall6(3, rfd, 0, 0, 0, 0, 0)
    syscall6(3, wfd, 0, 0, 0, 0, 0)
    println("SYSCALL6_LOCAL_SCALAR_OK")
    0
}
