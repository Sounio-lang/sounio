//@ run-pass
//@ expect-stdout: per-instance generic impl: PASS
// Methods of a generic impl used with f64 and i64 in one program. They used to be
// lowered once with their type parameters erased, so an f64 argument or result
// travelled through the integer path and came back wrong. The specializer now
// emits the impl once per instance (`impl Cell__f64`, `impl Cell__i64`), and
// `into_word::<T>` / `from_word::<T>` store any 8-byte T as a word.

struct Cell<T> {
    word: i64,
}

impl Cell<T> {
    fn make(v: T) -> Cell<T> {
        Cell { word: into_word::<T>(v) }
    }

    fn get(self: &Cell<T>) -> T {
        from_word::<T>(self.word)
    }

    fn put(self: &!Cell<T>, v: T) with Mut {
        self.word = into_word::<T>(v)
    }
}

struct Pair<T, U> {
    first: T,
    second: U,
}

impl Pair<T, U> {
    fn swap_first(self: &!Pair<T, U>, v: T) -> T with Mut {
        let old = self.first
        self.first = v
        old
    }
}

fn main() -> i32 with IO, Mut {
    var ok: i64 = 0
    var cf = Cell::<f64>::make(2.5)
    if cf.get() == 2.5 { ok = ok + 1 }
    cf.put(7.25)
    if cf.get() == 7.25 { ok = ok + 1 }
    var ci = Cell::<i64>::make(41)
    ci.put(42)
    if ci.get() == 42 { ok = ok + 1 }
    var p = Pair { first: 1.5, second: 3 }
    let old = p.swap_first(4.5)
    if old == 1.5 { ok = ok + 1 }
    if p.first == 4.5 { ok = ok + 1 }
    if ok == 5 {
        print("per-instance generic impl: PASS\n")
    }
    return 0
}
