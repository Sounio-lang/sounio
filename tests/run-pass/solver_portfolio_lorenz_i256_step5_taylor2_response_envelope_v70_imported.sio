        422368008, 577119901, 920537800, 92616329, 857456119,
        428032311, 838284677, 693506658, 389624150, 5, 20, 255)
    if receipt_fp != 98211696 { return 1 }
    let audit_fp = solver_portfolio_v70_lorenz_i256_step5_taylor2_response_envelope_audit_fingerprint(
        receipt_fp, 422368008, 577119901, 920537800, 92616329,
        693506658, 389624150, 838284677, 5, 20, 255)
    if audit_fp != 336655077 { return 2 }
    let manifest_fp = solver_portfolio_v70_lorenz_i256_step5_taylor2_response_envelope_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 880702042 { return 3 }
    let result_fp = solver_portfolio_v70_result_coverage_fingerprint(70, 74, 10, 62, 1, 1, manifest_fp)
    if result_fp != 131556092 { return 4 }
    let family_fp = solver_portfolio_v70_checker_family_coverage_fingerprint(70, 74, 6, 4, 3, 2, 57, 2, manifest_fp)
    if family_fp != 273106289 { return 5 }
