    if acceptance_fp != 242887974 { return 6 }
    let audit_receipt_fp = solver_portfolio_v70_audit_receipt_fingerprint(70, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 225019937 { return 7 }
    let readiness_fp = solver_portfolio_v70_readiness_fingerprint(70, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 678530115 { return 8 }
    return 0
