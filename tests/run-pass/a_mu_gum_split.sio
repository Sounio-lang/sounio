//@ run-pass
//@ requires: madaros
//@ exit-code: 0
//@ description: a_μ GUM split — WP20 ≠ WP25; exp closer to WP25; Schwinger is α/2π
// Full Test Suite CI uses souc-stage2 (lean_single), which does not
// execute this imported Epistemic graph. Madaros does (rc=0).

use particle_physics::ew_precision::{
    a_mu_exp_fermilab_2025, a_mu_sm_wp20, a_mu_sm_wp25,
    a_mu_pull, a_mu_k95, g_minus_2_qed_schwinger_ep,
    a_mu_exp_combined_var,
    a_mu_ew_wp20, a_mu_hvp_wp20, a_mu_hlbl_wp20,
    a_mu_ew_wp25, a_mu_hvp_wp25, a_mu_hlbl_wp25,
    a_mu_sm_sum_wp20, a_mu_sm_sum_wp25,
    a_mu_hvp_lo_wp20, a_mu_hvp_lo_lattice_wp25, a_mu_hvp_wp25_assembled,
}
use particle_physics::sm_params::{alpha_em}
use epistemic::knowledge::{ep_val, ep_std, ep_sub}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { 0.0 - x } else { x }
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let exp = a_mu_exp_fermilab_2025()
    let wp20 = a_mu_sm_wp20()
    let wp25 = a_mu_sm_wp25()
    let k95 = a_mu_k95()

    let pull_exp_wp20 = a_mu_pull(exp, wp20)
    let pull_exp_wp25 = a_mu_pull(exp, wp25)
    let pull_split = a_mu_pull(wp25, wp20)

    var ok: i64 = 1
    // Citation order (published centrals). Not a fitted sigma.
    if ep_val(&wp20) >= ep_val(&wp25) { ok = 0 }
    if ep_val(&wp25) >= ep_val(&exp) { ok = 0 }
    // Split larger than exp-vs-WP25; exp-vs-WP20 larger than exp-vs-WP25.
    if abs_f(pull_split) <= abs_f(pull_exp_wp25) { ok = 0 }
    if abs_f(pull_exp_wp20) <= abs_f(pull_exp_wp25) { ok = 0 }
    if abs_f(pull_split) <= k95 { ok = 0 }
    if ep_std(&exp) <= 0.0 { ok = 0 }
    if ep_std(&wp20) <= 0.0 { ok = 0 }
    if ep_std(&wp25) <= 0.0 { ok = 0 }

    let schw = g_minus_2_qed_schwinger_ep()
    let pi = 3.141592653589793
    let schw_expect = alpha_em().val() / (2.0 * pi)
    if abs_f(ep_val(&schw) - schw_expect) > 1.0e-12 { ok = 0 }

    // Combined experimental σ is sqrt(stat²+syst²+ext²) inside measured.
    let qvar = a_mu_exp_combined_var()
    let s = ep_std(&exp)
    if qvar <= 0.0 { ok = 0 }
    if qvar > 0.0 {
        if abs_f(s * s - qvar) / qvar > 1.0e-5 { ok = 0 }
    }

    let sum20 = a_mu_sm_sum_wp20()
    let sum25 = a_mu_sm_sum_wp25()
    if abs_f(ep_val(&sum25) - ep_val(&wp25)) > 2.0 { ok = 0 }
    if abs_f(ep_val(&sum20) - ep_val(&wp20)) > 2.0 { ok = 0 }
    let d_hvp = ep_sub(&a_mu_hvp_wp25(), &a_mu_hvp_wp20())
    let d_hlbl = ep_sub(&a_mu_hlbl_wp25(), &a_mu_hlbl_wp20())
    let d_ew = ep_sub(&a_mu_ew_wp25(), &a_mu_ew_wp20())
    if abs_f(ep_val(&d_hvp)) <= abs_f(ep_val(&d_hlbl)) { ok = 0 }
    if abs_f(ep_val(&d_hlbl)) <= abs_f(ep_val(&d_ew)) { ok = 0 }

    let hvp_asm = a_mu_hvp_wp25_assembled()
    if abs_f(ep_val(&hvp_asm) - ep_val(&a_mu_hvp_wp25())) >= 2.0 { ok = 0 }
    let pull_lo = a_mu_pull(a_mu_hvp_lo_lattice_wp25(), a_mu_hvp_lo_wp20())
    if abs_f(pull_lo) <= k95 { ok = 0 }

    if ok == 1 { 0 } else { 1 }
}
