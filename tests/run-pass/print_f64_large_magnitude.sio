//@ run-pass
//@ requires: madaros
//@ known-failure: Madaros print_f64/println of |x| ≳ 1e19 saturates via cvttsd2si
//@   to 2^63 (9223372036854775808). lean_single prints scientific 1.000000e30.
//@   Family B emitter root — distinct from April ζ variance_of slot OOB.
//@ expect-stdout: 1.000000e30
//@ description: large-f64 print must not collapse to 2^63 (single-stage discriminant)

fn main() with IO {
    print("MAG15 ")
    print_f64(1.0e15)
    println("")
    print("MAG9E18 ")
    print_f64(9.0e18)
    println("")
    print("MAG1E19 ")
    print_f64(1.0e19)
    println("")
    print("MAG1E30 ")
    print_f64(1.0e30)
    println("")
}
