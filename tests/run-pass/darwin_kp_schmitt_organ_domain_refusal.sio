//@ run-pass
//@ expect-stdout-contains: KP_SCHMITT_ORGAN_DOMAIN_REFUSAL_PASS
//
// Witness for the per-organ Schmitt members of core/kp_methods.sio.
//
// kpm_schmitt_raw_organ and kpm_schmitt_pearce_organ must refuse BEFORE any
// arithmetic when the plasma unbound fraction is not positive (the core
// computes 1/fu_p, and the Pearce transform divides by fu_p again) and when
// the organ is unsupported (its composition is zero-filled, so the cell and
// interstitial fractions sum to zero).  A refused member has in_domain = false
// and a negative Kpu sentinel, so it can be neither mistaken for a prediction
// nor reported as a non-finite one.
//
// The same checks are T30 in the module's own main(), but no gate runs that
// main(); this file is what the suite executes.
//
// WHAT THIS TEST DOES NOT SHOW.  It pins the refusal behaviour only.  It says
// nothing about the accuracy of the values returned inside the domain; those
// are pinned by dissertation_kp_three_methods_parity.sio.

use darwin_pbpk::core::kp_methods::*

fn refused(m: KpMember) -> bool {
    if kpm_member_in_domain(m) { return false }
    if kpm_member_kpu(m) < 0.0 { return true }
    return false
}

fn admitted(m: KpMember) -> bool {
    if !kpm_member_in_domain(m) { return false }
    if kpm_member_kpu(m) > 0.0 { return true }
    return false
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails = 0

    // Haloperidol-like strong base with a measured log MA; only fu_p varies.
    let d_zero = kpm_inputs(4.30, 3.723, true, 8.66, true, 0.0, 1.08, 375.86)
    let d_neg  = kpm_inputs(4.30, 3.723, true, 8.66, true, 0.0 - 0.10, 1.08, 375.86)
    let d_ok   = kpm_inputs(4.30, 3.723, true, 8.66, true, 0.10, 1.08, 375.86)

    // T1 -- fu_p = 0 on a supported organ (6 = muscle) is refused by both members.
    if refused(kpm_schmitt_raw_organ(d_zero, 6)) {
        if refused(kpm_schmitt_pearce_organ(d_zero, 6)) {
            println("T1 PASS: fu_p = 0 refused by raw and Pearce members")
        } else { println("T1 FAIL: Pearce member admitted fu_p = 0"); fails = fails + 1 }
    } else { println("T1 FAIL: raw member admitted fu_p = 0"); fails = fails + 1 }

    // T2 -- a negative fu_p is refused by both members.
    if refused(kpm_schmitt_raw_organ(d_neg, 6)) {
        if refused(kpm_schmitt_pearce_organ(d_neg, 6)) {
            println("T2 PASS: negative fu_p refused by raw and Pearce members")
        } else { println("T2 FAIL: Pearce member admitted negative fu_p"); fails = fails + 1 }
    } else { println("T2 FAIL: raw member admitted negative fu_p"); fails = fails + 1 }

    // T3 -- an unsupported organ (10 = bone) is refused even for a valid drug.
    if refused(kpm_schmitt_raw_organ(d_ok, 10)) {
        if refused(kpm_schmitt_pearce_organ(d_ok, 10)) {
            println("T3 PASS: unsupported organ refused by raw and Pearce members")
        } else { println("T3 FAIL: Pearce member admitted bone"); fails = fails + 1 }
    } else { println("T3 FAIL: raw member admitted bone"); fails = fails + 1 }

    // T4 -- control: a valid drug on a supported organ stays in domain.
    if admitted(kpm_schmitt_raw_organ(d_ok, 6)) {
        if admitted(kpm_schmitt_pearce_organ(d_ok, 6)) {
            println("T4 PASS: valid inputs on muscle stay in domain")
        } else { println("T4 FAIL: Pearce member refused valid inputs"); fails = fails + 1 }
    } else { println("T4 FAIL: raw member refused valid inputs"); fails = fails + 1 }

    if fails == 0 {
        println("KP_SCHMITT_ORGAN_DOMAIN_REFUSAL_PASS")
        return 0
    }
    print("KP_SCHMITT_ORGAN_DOMAIN_REFUSAL_FAIL fails=")
    println(fails)
    return 1
}
