//@ run-pass
//@ requires: madaros
//@ expect-stdout: MODULE_QUALIFIED_AGGREGATE_RETURN PASS
//
// PR #2515 review finding D (comment_id 4058669358): the emitted call target for
// a module-qualified free-fn call is resolved through
// callee_path_module_stripped_name (via expr_to_callee_name_ref), but the
// call's RETURN metadata helpers -- expr_call_return_fixed_array_len_ref,
// expr_call_callee_fn_id_ref, and expr_call_return_struct_name_ref
// (self-hosted/ir/lower.sio) -- independently rebuilt the callee name as
// `ir_mangle_method_name(first_segment, last_segment)`, bypassing the
// qualified-call resolver entirely. For `mod::make_struct()` that mangled
// name (e.g. `sret_min_big_basis`) has no fn table entry, so the return
// struct's field layout / array length was lost even though the call itself
// dispatched correctly -- later field/index access on the result would use
// the wrong (or no) layout.
//
// Reuses testmod::sret_min (stdlib/testmod/sret_min.sio), the existing
// witness fixture for cross-module struct-by-value returns with a fixed
// [i64; 256] array field, but calls big_basis through its module-qualified
// path rather than an imported bare name.
use testmod::sret_min::{Big};

fn main() -> i64 with IO, Mut, Panic {
    let r = testmod::sret_min::big_basis(7, 3)
    if r.c[3] == 1 && r.c[0] == 0 && r.bits == 7 {
        println("MODULE_QUALIFIED_AGGREGATE_RETURN PASS")
        return 0
    }
    println("MODULE_QUALIFIED_AGGREGATE_RETURN FAIL")
    return 1
}
