//@ run-pass
//@ requires: madaros

// Final-plan-review Finding 4 (2026-08-25): the actual DFS that runs in
// production is the ~90-line copy INLINED into x509_verify_chain, not the
// standalone `pub fn chain_build_candidates` (which has zero production
// callers -- only tests call it directly). Attempting to consolidate the
// two by having x509_verify_chain call chain_build_candidates directly
// reproduced a fresh divergence (x509_chain_verify_positive.sio's
// known-good chain returned CHAIN_ERR_EXPIRED instead of CHAIN_OK), so the
// inline duplicate was kept -- see the comment above x509_verify_chain in
// stdlib/x509/chain.sio for the measured details. This file drives the
// same two adversarial DFS scenarios that x509_chain_path_building_self_referential.sio
// and x509_chain_path_building_reordered.sio already exercise against
// chain_build_candidates directly, but THROUGH the real, shipping
// x509_verify_chain entry point instead, so the inlined copy has its own
// direct test coverage rather than relying on the untested standalone
// function's tests as a proxy.
//
// Fixtures are byte-for-byte the same openssl-generated root/intermediate/
// leaf DER (plus the same synthetic self-referential/linear-chain
// Certificate values) as the two source tests -- see those files' header
// comments for the exact openssl commands and pool-construction rationale.
// now_unix (1787659200 = 2026-08-25T12:00:00Z) falls inside every
// certificate's validity window in both fixtures.

use x509::chain::*
use x509::trust_store::*
use x509::cert::*
use net::socket::*

fn synth_name(tag: u8) -> X509Name {
    var n = x509_name_zero()
    var value: [u8; 128] = [0; 128]
    value[0] = tag
    n.entries[0] = RdnEntry { oid: [0; 20], oid_len: 0, value_tag: 12, value: value, value_len: 1 }
    n.count = 1
    n
}

