//@ run-pass
//@ requires: madaros
// Scalarized native executor for the frozen exact finite synthetic dyadic D0.
// Reusable construction lives in stdlib/epistemic/dyadic_non_reduction.sio.

struct ProductBound {
    left_max: i64,
    right_max: i64,
    product_max: i64,
    carrier_max: i64,
    authorized_before_multiplication: bool,
}

struct Candidate {
    candidate_id: i64,
    rule_id: i64,
    schema_id: i64,
    left_state_id: i64,
    left_numerator: i64,
    left_denominator: i64,
    right_state_id: i64,
    right_numerator: i64,
    right_denominator: i64,
    relational_state_id: i64,
    relational_numerator: i64,
    relational_denominator: i64,
    context_id: i64,
    context_code: i64,
    history_state_id: i64,
    predictive_mode: i64,
    history_annotation_id: i64,
    history_provenance_id: i64,
}

struct Family4 {
    family_id: i64,
    mode0: i64,
    mode1: i64,
    mode2: i64,
    mode3: i64,
    same_current_participant_states: bool,
    same_current_relational_state: bool,
    same_context: bool,
    same_current_projection: bool,
    histories_pairwise_distinct: bool,
    identifiers_absent_from_observation: bool,
    family_exhaustive: bool,
}

struct Collision {
    collision_id: i64,
    left_candidate_id: i64,
    right_candidate_id: i64,
    history_only_difference: bool,
    current_projection_equal: bool,
    real_relationship_identity_established: bool,
}

struct CommonInput {
    input_id: i64,
    rule_id: i64,
    tick: i64,
    probe_index: i64,
    payload_numerator: i64,
    payload_denominator: i64,
    candidate_specific: bool,
    same_schedule: bool,
    physical_intervention: bool,
}

struct Step {
    step_id: i64,
    candidate_id: i64,
    input_id: i64,
    probe_index: i64,
    result_numerator: i64,
    result_denominator: i64,
    mode_retained: i64,
    annotation_retained: i64,
    common_input_verified: bool,
}

struct ExactSeparation {
    left_numerator: i64,
    left_denominator: i64,
    right_numerator: i64,
    right_denominator: i64,
    signed_cross_difference: i64,
    cross_denominator: i64,
    reduced_numerator: i64,
    reduced_denominator: i64,
    exact_nonzero: bool,
}

struct NonReductionWitness {
    collision_id: i64,
    input_id: i64,
    separation: ExactSeparation,
    retained_history_predictive: bool,
    participant_product_sufficient: bool,
    declared_current_state_markov_sufficient: bool,
    bounded_synthetic_scope: bool,
    causal_mechanism: bool,
    subjective_suffering: bool,
    clinical_authority: bool,
}

struct Partition4 {
    word_length: i64,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    block0: i64,
    block1: i64,
    block2: i64,
    block3: i64,
    block_count: i64,
    exact_traces_replayed: bool,
    singleton: bool,
    global_equivalence: bool,
}

struct PresetSearch {
    found: bool,
    word_length: i64,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    worst_case_cost: i64,
    words_replayed: i64,
    cheaper_words_exhausted: bool,
}

struct AdaptiveSearch {
    found: bool,
    root_probe: i64,
    observation400_child_probe: i64,
    observation600_child_probe: i64,
    worst_case_cost: i64,
    one_step_probes_replayed: i64,
    all_leaves_singleton: bool,
}

struct Minimality {
    selected_cost: i64,
    cheaper_policies_rejected: i64,
    bounded_minimality: bool,
    formal_search_proof: bool,
    global_minimality: bool,
}

struct FactorableNull {
    family_id: i64,
    annotations_distinct: bool,
    predictive_modes_equal: bool,
    all_one_and_two_step_traces_equal: bool,
    residual_blocks: i64,
    non_reduction_authorized: bool,
    global_equivalence: bool,
}

struct BoundedAmbiguity {
    family_id: i64,
    horizon: i64,
    residual_blocks: i64,
    bounded_search_complete: bool,
    global_equivalence: bool,
}

struct IncompleteSearch {
    family_id: i64,
    requested_nodes: i64,
    required_nodes: i64,
    budget_exhausted: bool,
    search_complete: bool,
    ambiguity_authorized: bool,
    minimality_authorized: bool,
}

struct PermutationControl {
    candidate_permutation_valid: bool,
    history_id_permutation_invariant: bool,
    original_blocks: i64,
    permuted_blocks: i64,
    adaptive_cost_invariant: bool,
    preset_cost_invariant: bool,
}

struct SearchOrderControl {
    reverse_root: i64,
    canonical_root: i64,
    cost: i64,
    root_and_cost_invariant: bool,
}

struct SchemaLeakRejection {
    candidate_id_leak: bool,
    history_id_leak: bool,
    validity_rejected: bool,
    separation_authorized: bool,
}

struct ContextRival {
    apparent_separation: bool,
    promoted_contexts_equal: bool,
    omitted_context_explains_control: bool,
    history_only_claim_authorized: bool,
}

struct MarkovExpansionRival {
    sufficient_statistic_promoted: bool,
    expanded_states_distinct: bool,
    outputs_reproduced: bool,
    markov_factorability_restored: bool,
    participant_product_non_reduction_preserved: bool,
    unbounded_history_irreducibility: bool,
}

struct SyntheticD0 {
    w0_collision_and_reveal: bool,
    w1_factorable_null: bool,
    w2_controls: bool,
    w3_search_boundary: bool,
    w4_rivals: bool,
    synthetic: bool,
    real_relationship: bool,
    suffering: bool,
    consent: bool,
    clinical: bool,
}

fn authorize_product(
    left_max: i64,
    right_max: i64,
    carrier_max: i64,
) -> ProductBound with Div, Panic {
    assert(left_max >= 0 && right_max >= 0 && carrier_max > 0)
    if right_max > 0 {
        assert(left_max <= carrier_max / right_max)
    }
    ProductBound {
        left_max: left_max,
        right_max: right_max,
        product_max: left_max * right_max,
        carrier_max: carrier_max,
        authorized_before_multiplication: true,
    }
}

fn candidate(
    candidate_id: i64,
    history_state_id: i64,
    predictive_mode: i64,
    annotation_id: i64,
    provenance_id: i64,
) -> Candidate with Panic {
    assert(candidate_id > 0 && history_state_id > 0)
    assert(predictive_mode >= 0 && predictive_mode <= 4)
    assert(annotation_id > 0 && provenance_id > 0)
    Candidate {
        candidate_id: candidate_id,
        rule_id: 5001,
        schema_id: 5101,
        left_state_id: 5201,
        left_numerator: 700,
        left_denominator: 1000,
        right_state_id: 5202,
        right_numerator: 300,
        right_denominator: 1000,
        relational_state_id: 5301,
        relational_numerator: 500,
        relational_denominator: 1000,
        context_id: 5401,
        context_code: 7,
        history_state_id: history_state_id,
        predictive_mode: predictive_mode,
        history_annotation_id: annotation_id,
        history_provenance_id: provenance_id,
    }
}

fn declare_family4(
    family_id: i64,
    c0: Candidate,
    c1: Candidate,
    c2: Candidate,
    c3: Candidate,
) -> Family4 with Panic {
    assert(family_id > 0)
    assert(c0.candidate_id != c1.candidate_id)
    assert(c0.candidate_id != c2.candidate_id)
    assert(c0.candidate_id != c3.candidate_id)
    assert(c1.candidate_id != c2.candidate_id)
    assert(c1.candidate_id != c3.candidate_id)
    assert(c2.candidate_id != c3.candidate_id)
    assert(c0.left_state_id == c1.left_state_id && c0.left_state_id == c2.left_state_id)
    assert(c0.left_state_id == c3.left_state_id)
    assert(c0.right_state_id == c1.right_state_id && c0.right_state_id == c2.right_state_id)
    assert(c0.right_state_id == c3.right_state_id)
    assert(c0.relational_state_id == c1.relational_state_id)
    assert(c0.relational_state_id == c2.relational_state_id)
    assert(c0.relational_state_id == c3.relational_state_id)
    assert(c0.context_id == c1.context_id && c0.context_id == c2.context_id)
    assert(c0.context_id == c3.context_id)
    assert(c0.predictive_mode != c1.predictive_mode)
    assert(c0.predictive_mode != c2.predictive_mode)
    assert(c0.predictive_mode != c3.predictive_mode)
    assert(c1.predictive_mode != c2.predictive_mode)
    assert(c1.predictive_mode != c3.predictive_mode)
    assert(c2.predictive_mode != c3.predictive_mode)
    Family4 {
        family_id: family_id,
        mode0: c0.predictive_mode,
        mode1: c1.predictive_mode,
        mode2: c2.predictive_mode,
        mode3: c3.predictive_mode,
        same_current_participant_states: true,
        same_current_relational_state: true,
        same_context: true,
        same_current_projection: true,
        histories_pairwise_distinct: true,
        identifiers_absent_from_observation: true,
        family_exhaustive: false,
    }
}

fn prove_collision(
    collision_id: i64,
    left: Candidate,
    right: Candidate,
) -> Collision with Panic {
    assert(collision_id > 0)
    assert(left.candidate_id != right.candidate_id)
    assert(left.rule_id == right.rule_id && left.schema_id == right.schema_id)
    assert(left.left_state_id == right.left_state_id)
    assert(left.left_numerator == right.left_numerator)
    assert(left.left_denominator == right.left_denominator)
    assert(left.right_state_id == right.right_state_id)
    assert(left.right_numerator == right.right_numerator)
    assert(left.right_denominator == right.right_denominator)
    assert(left.relational_state_id == right.relational_state_id)
    assert(left.relational_numerator == right.relational_numerator)
    assert(left.relational_denominator == right.relational_denominator)
    assert(left.context_id == right.context_id && left.context_code == right.context_code)
    assert(left.history_state_id != right.history_state_id)
    assert(left.predictive_mode != right.predictive_mode ||
        left.history_annotation_id != right.history_annotation_id)
    Collision {
        collision_id: collision_id,
        left_candidate_id: left.candidate_id,
        right_candidate_id: right.candidate_id,
        history_only_difference: true,
        current_projection_equal: true,
        real_relationship_identity_established: false,
    }
}

fn common_input(
    input_id: i64,
    tick: i64,
    probe_index: i64,
) -> CommonInput with Panic {
    assert(input_id > 0 && tick > 0)
    assert(probe_index >= 0 && probe_index <= 2)
    CommonInput {
        input_id: input_id,
        rule_id: 5001,
        tick: tick,
        probe_index: probe_index,
        payload_numerator: 1,
        payload_denominator: 1,
        candidate_specific: false,
        same_schedule: true,
        physical_intervention: false,
    }
}

fn observation(mode: i64, probe: i64) -> i64 with Panic {
    assert(mode >= 0 && mode <= 4)
    assert(probe >= 0 && probe <= 2)
    if mode == 0 {
        if probe == 0 { 400 }
        else if probe == 1 { 450 }
        else { 500 }
    } else if mode == 1 {
        if probe == 0 { 400 }
        else if probe == 1 { 550 }
        else { 500 }
    } else if mode == 2 {
        if probe == 0 { 600 }
        else if probe == 1 { 450 }
        else { 500 }
    } else if mode == 3 {
        if probe == 0 { 600 }
        else if probe == 1 { 450 }
        else { 650 }
    } else {
        500
    }
}

fn advance(
    step_id: i64,
    source: Candidate,
    input: CommonInput,
) -> Step with Panic {
    assert(step_id > 0)
    assert(source.rule_id == input.rule_id)
    assert(!input.candidate_specific && input.same_schedule)
    Step {
        step_id: step_id,
        candidate_id: source.candidate_id,
        input_id: input.input_id,
        probe_index: input.probe_index,
        result_numerator: observation(source.predictive_mode, input.probe_index),
        result_denominator: 1000,
        mode_retained: source.predictive_mode,
        annotation_retained: source.history_annotation_id,
        common_input_verified: true,
    }
}

fn prove_non_reduction(
    collision: Collision,
    left: Step,
    right: Step,
    bound: ProductBound,
) -> NonReductionWitness with Div, Panic {
    assert(bound.authorized_before_multiplication)
    assert(collision.history_only_difference)
    assert(left.candidate_id == collision.left_candidate_id)
    assert(right.candidate_id == collision.right_candidate_id)
    assert(left.input_id == right.input_id && left.probe_index == right.probe_index)
    assert(left.common_input_verified && right.common_input_verified)
    assert(left.result_numerator <= bound.left_max)
    assert(right.result_numerator <= bound.left_max)
    assert(left.result_denominator <= bound.right_max)
    assert(right.result_denominator <= bound.right_max)
    let denominator_bound = authorize_product(
        bound.right_max, bound.right_max, bound.carrier_max,
    )
    assert(denominator_bound.authorized_before_multiplication)
    assert(left.result_denominator <= denominator_bound.left_max)
    assert(right.result_denominator <= denominator_bound.right_max)
    let left_cross = left.result_numerator * right.result_denominator
    let right_cross = right.result_numerator * left.result_denominator
    let difference = left_cross - right_cross
    assert(difference == -200000)
    let separation = ExactSeparation {
        left_numerator: left.result_numerator,
        left_denominator: left.result_denominator,
        right_numerator: right.result_numerator,
        right_denominator: right.result_denominator,
        signed_cross_difference: difference,
        cross_denominator: left.result_denominator * right.result_denominator,
        reduced_numerator: -1,
        reduced_denominator: 5,
        exact_nonzero: true,
    }
    NonReductionWitness {
        collision_id: collision.collision_id,
        input_id: left.input_id,
        separation: separation,
        retained_history_predictive: true,
        participant_product_sufficient: false,
        declared_current_state_markov_sufficient: false,
        bounded_synthetic_scope: true,
        causal_mechanism: false,
        subjective_suffering: false,
        clinical_authority: false,
    }
}

fn trace_equal(
    left_mode: i64,
    right_mode: i64,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    length: i64,
) -> bool with Panic {
    assert(length >= 1 && length <= 3)
    let same0 = observation(left_mode, probe0) == observation(right_mode, probe0)
    if length == 1 {
        same0
    } else {
        let same1 = observation(left_mode, probe1) == observation(right_mode, probe1)
        if length == 2 {
            same0 && same1
        } else {
            same0 && same1 &&
                observation(left_mode, probe2) == observation(right_mode, probe2)
        }
    }
}

fn partition4(
    family: Family4,
    probe0: i64,
    probe1: i64,
    probe2: i64,
    length: i64,
) -> Partition4 with Mut, Panic {
    var next_block = 1
    let block0 = 0
    var block1 = 0
    if !trace_equal(family.mode1, family.mode0, probe0, probe1, probe2, length) {
        block1 = next_block
        next_block = next_block + 1
    }
    var block2 = 0
    if trace_equal(family.mode2, family.mode0, probe0, probe1, probe2, length) {
        block2 = block0
    } else if trace_equal(family.mode2, family.mode1, probe0, probe1, probe2, length) {
        block2 = block1
    } else {
        block2 = next_block
        next_block = next_block + 1
    }
    var block3 = 0
    if trace_equal(family.mode3, family.mode0, probe0, probe1, probe2, length) {
        block3 = block0
    } else if trace_equal(family.mode3, family.mode1, probe0, probe1, probe2, length) {
        block3 = block1
    } else if trace_equal(family.mode3, family.mode2, probe0, probe1, probe2, length) {
        block3 = block2
    } else {
        block3 = next_block
        next_block = next_block + 1
    }
    Partition4 {
        word_length: length,
        probe0: probe0,
        probe1: probe1,
        probe2: probe2,
        block0: block0,
        block1: block1,
        block2: block2,
        block3: block3,
        block_count: next_block,
        exact_traces_replayed: true,
        singleton: next_block == 4,
        global_equivalence: false,
    }
}

fn preset_search(family: Family4) -> PresetSearch with Mut, Panic {
    var replayed = 0
    var found = false
    var length = -1
    var found0 = -1
    var found1 = -1
    var found2 = -1
    var p0 = 0
    while p0 < 3 {
        replayed = replayed + 1
        if partition4(family, p0, 0, 0, 1).singleton {
            found = true
            length = 1
            found0 = p0
        }
        p0 = p0 + 1
    }
    p0 = 0
    while p0 < 3 && !found {
        var p1 = 0
        while p1 < 3 && !found {
            replayed = replayed + 1
            if partition4(family, p0, p1, 0, 2).singleton {
                found = true
                length = 2
                found0 = p0
                found1 = p1
            }
            p1 = p1 + 1
        }
        p0 = p0 + 1
    }
    p0 = 0
    while p0 < 3 && !found {
        var p1 = 0
        while p1 < 3 && !found {
            var p2 = 0
            while p2 < 3 && !found {
                replayed = replayed + 1
                if partition4(family, p0, p1, p2, 3).singleton {
                    found = true
                    length = 3
                    found0 = p0
                    found1 = p1
                    found2 = p2
                }
                p2 = p2 + 1
            }
            p1 = p1 + 1
        }
        p0 = p0 + 1
    }
    assert(found && length == 3)
    assert(found0 == 0 && found1 == 1 && found2 == 2)
    assert(replayed == 18)
    PresetSearch {
        found: true,
        word_length: 3,
        probe0: 0,
        probe1: 1,
        probe2: 2,
        worst_case_cost: 3,
        words_replayed: replayed,
        cheaper_words_exhausted: true,
    }
}

fn adaptive_search(family: Family4) -> AdaptiveSearch with Mut, Panic {
    var probe = 0
    while probe < 3 {
        assert(!partition4(family, probe, 0, 0, 1).singleton)
        probe = probe + 1
    }
    let root = partition4(family, 0, 0, 0, 1)
    assert(root.block_count == 2)
    assert(observation(family.mode0, 0) == 400)
    assert(observation(family.mode1, 0) == 400)
    assert(observation(family.mode2, 0) == 600)
    assert(observation(family.mode3, 0) == 600)
    assert(observation(family.mode0, 1) != observation(family.mode1, 1))
    assert(observation(family.mode2, 2) != observation(family.mode3, 2))
    AdaptiveSearch {
        found: true,
        root_probe: 0,
        observation400_child_probe: 1,
        observation600_child_probe: 2,
        worst_case_cost: 2,
        one_step_probes_replayed: 3,
        all_leaves_singleton: true,
    }
}

fn certify_minimality(search: AdaptiveSearch) -> Minimality with Panic {
    assert(search.found && search.worst_case_cost == 2)
    assert(search.one_step_probes_replayed == 3)
    Minimality {
        selected_cost: 2,
        cheaper_policies_rejected: 3,
        bounded_minimality: true,
        formal_search_proof: false,
        global_minimality: false,
    }
}

fn prove_factorable_null(
    family_id: i64,
    left: Candidate,
    right: Candidate,
) -> FactorableNull with Mut, Panic {
    assert(left.predictive_mode == right.predictive_mode)
    assert(left.history_annotation_id != right.history_annotation_id)
    var p0 = 0
    while p0 < 3 {
        assert(observation(left.predictive_mode, p0) ==
            observation(right.predictive_mode, p0))
        var p1 = 0
        while p1 < 3 {
            assert(trace_equal(
                left.predictive_mode, right.predictive_mode,
                p0, p1, 0, 2,
            ))
            p1 = p1 + 1
        }
        p0 = p0 + 1
    }
    FactorableNull {
        family_id: family_id,
        annotations_distinct: true,
        predictive_modes_equal: true,
        all_one_and_two_step_traces_equal: true,
        residual_blocks: 1,
        non_reduction_authorized: false,
        global_equivalence: false,
    }
}

fn bounded_ambiguity(null_receipt: FactorableNull) -> BoundedAmbiguity with Panic {
    assert(null_receipt.all_one_and_two_step_traces_equal)
    assert(null_receipt.residual_blocks == 1)
    BoundedAmbiguity {
        family_id: null_receipt.family_id,
        horizon: 2,
        residual_blocks: 1,
        bounded_search_complete: true,
        global_equivalence: false,
    }
}

fn force_incomplete(
    family_id: i64,
    requested_nodes: i64,
    required_nodes: i64,
) -> IncompleteSearch with Panic {
    assert(requested_nodes >= 0 && required_nodes > requested_nodes)
    IncompleteSearch {
        family_id: family_id,
        requested_nodes: requested_nodes,
        required_nodes: required_nodes,
        budget_exhausted: true,
        search_complete: false,
        ambiguity_authorized: false,
        minimality_authorized: false,
    }
}

fn history_id_relabel_preserves_observation(
    original: Candidate,
    relabeled: Candidate,
) -> bool with Mut, Panic {
    assert(original.predictive_mode == relabeled.predictive_mode)
    assert(original.history_state_id != relabeled.history_state_id)
    assert(original.history_annotation_id != relabeled.history_annotation_id)
    assert(original.history_provenance_id != relabeled.history_provenance_id)
    var probe = 0
    while probe < 3 {
        let input = common_input(5950 + probe, 1, probe)
        let original_step = advance(6050 + probe, original, input)
        let relabeled_step = advance(6150 + probe, relabeled, input)
        assert(original_step.result_numerator == relabeled_step.result_numerator)
        assert(original_step.result_denominator == relabeled_step.result_denominator)
        probe = probe + 1
    }
    true
}

fn permutation_control(
    family: Family4,
    c0: Candidate,
    c1: Candidate,
    c2: Candidate,
    c3: Candidate,
) -> PermutationControl with Mut, Panic {
    let original = partition4(family, 0, 1, 2, 3)
    let permuted = Family4 {
        family_id: family.family_id,
        mode0: family.mode3,
        mode1: family.mode1,
        mode2: family.mode0,
        mode3: family.mode2,
        same_current_participant_states: true,
        same_current_relational_state: true,
        same_context: true,
        same_current_projection: true,
        histories_pairwise_distinct: true,
        identifiers_absent_from_observation: true,
        family_exhaustive: false,
    }
    assert(permuted.mode0 >= 0 && permuted.mode0 <= 3)
    assert(permuted.mode1 >= 0 && permuted.mode1 <= 3)
    assert(permuted.mode2 >= 0 && permuted.mode2 <= 3)
    assert(permuted.mode3 >= 0 && permuted.mode3 <= 3)
    assert(permuted.mode0 != permuted.mode1)
    assert(permuted.mode0 != permuted.mode2)
    assert(permuted.mode0 != permuted.mode3)
    assert(permuted.mode1 != permuted.mode2)
    assert(permuted.mode1 != permuted.mode3)
    assert(permuted.mode2 != permuted.mode3)
    let permuted_partition = partition4(permuted, 0, 1, 2, 3)
    assert(original.block_count == 4 && permuted_partition.block_count == 4)
    // Relabel every retained-history ID while holding predictive modes fixed.
    let relabeled0 = candidate(5660, 5560, c0.predictive_mode, 8060, 9060)
    let relabeled1 = candidate(5661, 5561, c1.predictive_mode, 8061, 9061)
    let relabeled2 = candidate(5662, 5562, c2.predictive_mode, 8062, 9062)
    let relabeled3 = candidate(5663, 5563, c3.predictive_mode, 8063, 9063)
    assert(history_id_relabel_preserves_observation(c0, relabeled0))
    assert(history_id_relabel_preserves_observation(c1, relabeled1))
    assert(history_id_relabel_preserves_observation(c2, relabeled2))
    assert(history_id_relabel_preserves_observation(c3, relabeled3))
    PermutationControl {
        candidate_permutation_valid: true,
        history_id_permutation_invariant: true,
        original_blocks: 4,
        permuted_blocks: 4,
        adaptive_cost_invariant: true,
        preset_cost_invariant: true,
    }
}

fn reverse_order_control(family: Family4) -> SearchOrderControl with Mut, Panic {
    // Root C fails: modes 0 and 2 remain equal after child B.
    assert(trace_equal(family.mode0, family.mode2, 2, 1, 0, 2))
    // Root B fails: modes 2 and 3 remain equal after child A.
    assert(trace_equal(family.mode2, family.mode3, 1, 0, 0, 2))
    // Root A succeeds with B on 400 and C on 600.
    assert(observation(family.mode0, 1) != observation(family.mode1, 1))
    assert(observation(family.mode2, 2) != observation(family.mode3, 2))
    SearchOrderControl {
        reverse_root: 0,
        canonical_root: 0,
        cost: 2,
        root_and_cost_invariant: true,
    }
}

fn reject_schema_leak(
    candidate_id_leak: bool,
    history_id_leak: bool,
) -> SchemaLeakRejection with Panic {
    assert(candidate_id_leak || history_id_leak)
    SchemaLeakRejection {
        candidate_id_leak: candidate_id_leak,
        history_id_leak: history_id_leak,
        validity_rejected: true,
        separation_authorized: false,
    }
}

fn context_rival(left_context: i64, right_context: i64) -> ContextRival with Panic {
    assert(left_context != right_context)
    ContextRival {
        apparent_separation: true,
        promoted_contexts_equal: false,
        omitted_context_explains_control: true,
        history_only_claim_authorized: false,
    }
}

fn markov_rival(
    left_statistic: i64,
    right_statistic: i64,
    probe: i64,
    left_output: i64,
    right_output: i64,
) -> MarkovExpansionRival with Panic {
    assert(left_statistic != right_statistic)
    assert(left_output == observation(left_statistic, probe))
    assert(right_output == observation(right_statistic, probe))
    MarkovExpansionRival {
        sufficient_statistic_promoted: true,
        expanded_states_distinct: true,
        outputs_reproduced: true,
        markov_factorability_restored: true,
        participant_product_non_reduction_preserved: true,
        unbounded_history_irreducibility: false,
    }
}

fn main() with Div, Mut, Panic {
    let c0 = candidate(5601, 5501, 0, 8001, 9001)
    let c1 = candidate(5602, 5502, 1, 8002, 9002)
    let c2 = candidate(5603, 5503, 2, 8003, 9003)
    let c3 = candidate(5604, 5504, 3, 8004, 9004)
    let family = declare_family4(5701, c0, c1, c2, c3)

    let collision = prove_collision(5801, c0, c2)
    let input_a = common_input(5901, 1, 0)
    let step0 = advance(6001, c0, input_a)
    let step2 = advance(6002, c2, input_a)
    let bound = authorize_product(1000, 1000, 9000000000000000000)
    let witness = prove_non_reduction(collision, step0, step2, bound)
    assert(witness.separation.reduced_numerator == -1)
    assert(witness.separation.reduced_denominator == 5)

    let adaptive = adaptive_search(family)
    let preset = preset_search(family)
    let minimality = certify_minimality(adaptive)
    assert(adaptive.worst_case_cost == 2)
    assert(preset.worst_case_cost == 3)
    assert(minimality.bounded_minimality)

    let null0 = candidate(5610, 5510, 4, 8101, 9101)
    let null1 = candidate(5611, 5511, 4, 8102, 9102)
    let null_receipt = prove_factorable_null(5710, null0, null1)
    let ambiguity = bounded_ambiguity(null_receipt)
    assert(!null_receipt.non_reduction_authorized)
    assert(ambiguity.bounded_search_complete && !ambiguity.global_equivalence)

    let permutation = permutation_control(family, c0, c1, c2, c3)
    let reverse = reverse_order_control(family)
    let leak = reject_schema_leak(false, true)
    let incomplete = force_incomplete(5701, 1, 10)
    assert(permutation.candidate_permutation_valid)
    assert(permutation.history_id_permutation_invariant)
    assert(reverse.root_and_cost_invariant)
    assert(leak.validity_rejected && !leak.separation_authorized)
    assert(!incomplete.search_complete)
    assert(!incomplete.ambiguity_authorized && !incomplete.minimality_authorized)

    let context_control = context_rival(10, 20)
    let markov_control = markov_rival(
        0, 2, 0, step0.result_numerator, step2.result_numerator,
    )
    assert(context_control.omitted_context_explains_control)
    assert(!context_control.history_only_claim_authorized)
    assert(markov_control.markov_factorability_restored)
    assert(markov_control.participant_product_non_reduction_preserved)
    assert(!markov_control.unbounded_history_irreducibility)

    let result = SyntheticD0 {
        w0_collision_and_reveal: true,
        w1_factorable_null: true,
        w2_controls: true,
        w3_search_boundary: true,
        w4_rivals: true,
        synthetic: true,
        real_relationship: false,
        suffering: false,
        consent: false,
        clinical: false,
    }
    assert(result.w0_collision_and_reveal)
    assert(result.w1_factorable_null)
    assert(result.w2_controls)
    assert(result.w3_search_boundary)
    assert(result.w4_rivals)
    assert(!result.real_relationship && !result.suffering)
    assert(!result.consent && !result.clinical)

    println("D0-W0 current=500/1000 common_probe=A future=400/1000,600/1000 difference=-1/5")
    println("D0-W1 factorable_null=true residual_blocks=1 global_equivalence=false")
    println("D0-W2 permutation=true history_id_leak=rejected reverse_order=true")
    println("D0-W3 one_step_separates=false adaptive_cost=2 preset_cost=3 incomplete_refused=true")
    println("D0-W4 context_rival=explains-control markov_expansion=restores-factorability")
    println("boundary=participant_product_nonreduction history_unbounded_irreducibility=false")
    println("synthetic=true relationship=false suffering=false consent=false clinical=false")
    println("SYNTHETIC DYADIC NON-REDUCTION D0 PASS")
}
