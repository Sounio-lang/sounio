//@ run-pass
// A9' — COERENCIA (fecho superior da aniquilacao). O axioma que faltava, e sem o qual
// "o interior e uma PCS" e FALSO em geral.
//
//   se a∘b = z, a <= a', b <= b' e a'∘b' e definido, entao a'∘b' = z
//
// A testemunha deve satisfaze-lo, e por um motivo estrutural que vale a pena isolar: o conjunto
// de aniquilacao dela e uma CURVA DE NIVEL de funcao estritamente crescente. Como ∘ cresce nos
// dois argumentos, subir de (a,b) para (a',b') so pode levar o valor de 1 para >= 1; e "definido"
// significa <= 1; logo o valor e exatamente 1, que e z.
//
// O contramodelo do Fable mostra que os OUTROS axiomas nao forcam isso: bastava decretar
// a0∘b0 := z num ponto interior, preservando finura, para quebrar tudo. Aqui se verifica que a
// testemunha nao e um desses casos patologicos.

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn op(a: f64, b: f64, eps: f64) -> f64 with Div, Panic { a + b + eps * a * b / (a + b) }

fn main() -> i64 with IO, Mut, Div, Panic {
    let eps: f64 = 1.0
    var falhas: i64 = 0

    // Para cada a na malha, acha o b que aniquila (travessia do nivel 1) e testa a coerencia
    // subindo os dois argumentos.
    var pares_testados: i64 = 0
    var viol: i64 = 0
    var i: i64 = 5
    while i < 95 {
        let a = (i as f64) / 100.0
        // localiza o aniquilador de a por varredura fina
        var b_star: f64 = 0.0 - 1.0
        var j: i64 = 1
        while j < 2000 {
            let b1 = (j as f64) / 2000.0
            let b2 = ((j + 1) as f64) / 2000.0
            if op(a, b1, eps) < 1.0 && op(a, b2, eps) >= 1.0 { b_star = b2 }
            j = j + 1
        }
        if b_star > 0.0 {
            // sobe os dois argumentos e confere: o valor nao pode voltar para dentro de X*
            var da: i64 = 0
            while da < 6 {
                var db: i64 = 0
                while db < 6 {
                    let a2 = a + (da as f64) / 100.0
                    let b2 = b_star + (db as f64) / 100.0
                    if a2 < 1.0 && b2 < 1.0 {
                        pares_testados = pares_testados + 1
                        // a coerencia exige: se o valor e <= 1 (definido), tem de ser exatamente 1
                        let v = op(a2, b2, eps)
                        if v <= 1.0 && abs_f64(v - 1.0) > 0.002 { viol = viol + 1 }
                    }
                    db = db + 1
                }
                da = da + 1
            }
        }
        i = i + 1
    }
    print("PARES_TESTADOS "); print_int(pares_testados)
    print("COERENCIA_VIOLACOES "); print_int(viol)
    if viol != 0 { falhas = falhas + 1 }

    // Controle: a monotonicidade estrita e a RAZAO da coerencia. Confere que subir qualquer
    // argumento nunca DIMINUI o valor — se isso falhasse, a coerencia seria acidente.
    var viol_cresce: i64 = 0
    i = 1
    while i < 60 {
        var j2: i64 = 1
        while j2 < 60 {
            let a = (i as f64) / 100.0
            let b = (j2 as f64) / 100.0
            if !(op(a + 0.005, b, eps) > op(a, b, eps)) { viol_cresce = viol_cresce + 1 }
            if !(op(a, b + 0.005, eps) > op(a, b, eps)) { viol_cresce = viol_cresce + 1 }
            j2 = j2 + 1
        }
        i = i + 1
    }
    print("CRESCIMENTO_VIOLACOES "); print_int(viol_cresce)
    if viol_cresce != 0 { falhas = falhas + 1 }

    if falhas == 0 { println("coerencia da testemunha: PASS") } else { println("coerencia: FAIL") }
    falhas
}
