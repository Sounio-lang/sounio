//@ run-pass
//@ expect-stdout: ALL PASS
//
// Smoke test for score_mode=5 (Discounted Empirical-Bernstein UCB-V).
// Confirms the new branching mode produces valid SAT/UNSAT verdicts and does not
// crash or hang on small instances. NOT a quality test (the prototype disclaims
// that). See docs/research/act-var-redefinition-prototype-2026-06-28.md.

use theorem::smt::*

fn lcg_next(state: &!i64) -> i64 with Mut, Div {
    let a: i64 = 1103515245
    let c: i64 = 12345
    let m: i64 = 2147483648
    var next = (*state * a + c) % m
    if next < 0 { next = next + m }
    *state = next
    return next
}

fn main() -> i32 with IO, Mut, Div {
    var pass: i32 = 0
    var fail: i32 = 0

    // T1: simple SAT under mode 5
    var ctx = smt_new()
    smt_set_score_mode(&! ctx, 5)
    var c1: [i32; 8] = [0 as i32; 8]
    c1[0] = 0
    c1[1] = 2
    smt_add_clause(&! ctx, &c1, 2)
    var c2: [i32; 8] = [0 as i32; 8]
    c2[0] = 1
    c2[1] = 2
    smt_add_clause(&! ctx, &c2, 2)
    let t1 = smt_solve(&! ctx)
    if t1 == 1 {
        println("T1 PASS: mode5 simple SAT")
        pass = pass + 1
    } else {
        println("T1 FAIL: mode5 simple SAT")
        fail = fail + 1
    }

    // T2: simple UNSAT under mode 5
    var ctx2 = smt_new()
    smt_set_score_mode(&! ctx2, 5)
    var c3: [i32; 8] = [0 as i32; 8]
    c3[0] = 0
    smt_add_clause(&! ctx2, &c3, 1)
    var c4: [i32; 8] = [0 as i32; 8]
    c4[0] = 1
    smt_add_clause(&! ctx2, &c4, 1)
    if smt_solve(&! ctx2) == 0 {
        println("T2 PASS: mode5 simple UNSAT")
        pass = pass + 1
    } else {
        println("T2 FAIL: mode5 simple UNSAT")
        fail = fail + 1
    }

    // T3: a conflict-heavy instance so the disc accumulators actually fire,
    // then check that disc state is bounded (n_eff floor ~ 1/(1-0.99) = 100).
    var ctx3 = smt_new()
    smt_set_score_mode(&! ctx3, 5)
    var seed: i64 = 987654
    var clause_idx: i32 = 0
    while clause_idx < 42 {
        var clause: [i32; 8] = [0 as i32; 8]
        var lit_idx: i32 = 0
        while lit_idx < 3 {
            let raw_var = lcg_next(&! seed) % 8
            let raw_pol = lcg_next(&! seed) % 2
            clause[lit_idx] = (raw_var as i32) * 2 + (raw_pol as i32)
            lit_idx = lit_idx + 1
        }
        smt_add_clause(&! ctx3, &clause, 3)
        clause_idx = clause_idx + 1
    }
    let t3 = smt_solve(&! ctx3)
    if t3 == 0 || t3 == 1 {
        println("T3 PASS: mode5 bounded 3-SAT smoke returns a verdict")
        pass = pass + 1
    } else {
        println("T3 FAIL: mode5 bounded 3-SAT smoke")
        fail = fail + 1
    }

    // T4: disc accumulators are bounded (never blow up like the old growing act_var).
    var bounded = true
    var v: i32 = 0
    while v < 8 {
        let s0 = smt_get_disc_s0(&ctx3, v)
        // Steady-state S0 <= 1/(1-gamma) ~ 100; allow generous slack.
        if s0 > 1000.0 { bounded = false }
        if s0 < 0.0 { bounded = false }
        v = v + 1
    }
    if bounded {
        println("T4 PASS: disc accumulators bounded")
        pass = pass + 1
    } else {
        println("T4 FAIL: disc accumulators unbounded")
        fail = fail + 1
    }

    println("---")
    if fail == 0 {
        println("ALL PASS")
        return 0
    }
    println("SOME TESTS FAILED")
    return 1
}
