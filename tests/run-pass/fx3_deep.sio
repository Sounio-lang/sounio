//@ run-pass
//@ requires: madaros
//@ expect-stdout: 7
//@ description: FX-3 deep: a perform issued inside a clause is dispatched to the next enclosing (outer) handler, never to the clause's own handler (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-3

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        handle<Ask> { perform Ask.get() } with { on get() -> perform Ask.get() }
    } with { on get() -> resume(7) return(x) -> x }
    println(r)
    0
}
