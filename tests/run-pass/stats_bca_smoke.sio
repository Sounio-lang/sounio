//@ run-pass
//@ expect-stdout: STATS_BCA_SMOKE_PASS
use stats::bootstrap::{bootstrap_bca_mean}
use stats::bca_normal::{bca_normal_cdf,bca_normal_quantile}
use stats::epistemic::bootstrap::{bootstrap_ci_bca_mean}
use math::pure::{is_finite}
fn main() with IO,Mut,Div,Panic {
 let c=bca_normal_cdf(1.0)
 assert(c.status==0 && c.value>0.841344746068 && c.value<0.841344746069)
 let q=bca_normal_quantile(0.975)
 assert(q.status==0 && q.value>1.959963984 && q.value<1.959963985)
 var x:[f64;256]=[0.0;256]
 x[0]=1.0;x[1]=2.0;x[2]=3.0;x[3]=4.0;x[4]=8.0;x[5]=10.0
 let r=bootstrap_bca_mean(&x,6,512,0.95,42)
 assert(r.status==0 && r.se>0.0 && r.lo<r.hi)
 assert(r.acceleration>0.0)
 var old:[f64;100]=[0.0;100]
 old[0]=1.0e308;old[1]=1.1e308;old[2]=1.2e308;old[3]=1.3e308
 let adapter=bootstrap_ci_bca_mean(old,4,500,0.05,42)
 assert(is_finite(adapter.lower) && is_finite(adapter.upper) && is_finite(adapter.se_bootstrap))
 assert(adapter.lower>1.0e307 && adapter.upper<1.4e308)
 println("STATS_BCA_SMOKE_PASS")
 0
}
