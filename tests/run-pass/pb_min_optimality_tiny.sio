//@ run-pass
//@ requires: madaros
//@ description: Tiny pseudo-Boolean minimization optimality certificate smoke

fn small_nonneg(x: i64) -> i64 {
    if x < 0 { return 0 }
    if x > 1000000000 { return 0 }
    return 1
}

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn sense_ge() -> i64 { return 1 }

fn sense_code(sense: i64) -> i64 {
    if sense == (0 - 1) { return 1 }
    if sense == 1 { return 2 }
    return 0
}

fn assignment_valid(x0: i64, x1: i64, x2: i64) -> i64 {
    if x0 != 0 {
        if x0 != 1 { return 0 }
    }
    if x1 != 0 {
        if x1 != 1 { return 0 }
    }
    if x2 != 0 {
        if x2 != 1 { return 0 }
    }
    return 1
}

fn assignment_code(x: i64) -> i64 {
    if x == 0 { return 1 }
    if x == 1 { return 2 }
    return 0
}

fn row_valid(w0: i64, w1: i64, w2: i64, rhs: i64, sense: i64) -> i64 {
    if sense != (0 - 1) {
        if sense != sense_ge() { return 0 }
    }
    if small_nonneg(w0) == 0 { return 0 }
    if small_nonneg(w1) == 0 { return 0 }
    if small_nonneg(w2) == 0 { return 0 }
    if small_nonneg(rhs) == 0 { return 0 }
    return 1
}

fn objective_valid(c0: i64, c1: i64, c2: i64) -> i64 {
    if small_nonneg(c0) == 0 { return 0 }
    if small_nonneg(c1) == 0 { return 0 }
    if small_nonneg(c2) == 0 { return 0 }
    return 1
}

fn objective_value(c0: i64, c1: i64, c2: i64, x0: i64, x1: i64, x2: i64) -> i64 {
    if objective_valid(c0, c1, c2) == 0 { return 0 - 1 }
    if assignment_valid(x0, x1, x2) == 0 { return 0 - 1 }
    return c0 * x0 + c1 * x1 + c2 * x2
}

fn objective_lower_bound_row_matches(c0: i64, c1: i64, c2: i64,
                                     w0: i64, w1: i64, w2: i64,
                                     rhs: i64, sense: i64) -> i64 {
    if objective_valid(c0, c1, c2) == 0 { return 0 }
    if row_valid(w0, w1, w2, rhs, sense) == 0 { return 0 }
    if sense != sense_ge() { return 0 }
    if w0 != c0 { return 0 }
    if w1 != c1 { return 0 }
    if w2 != c2 { return 0 }
    return 1
}

fn check_min_objective_optimal(c0: i64, c1: i64, c2: i64,
                               w0: i64, w1: i64, w2: i64,
                               rhs: i64, sense: i64,
                               x0: i64, x1: i64, x2: i64) -> i64 {
    if objective_lower_bound_row_matches(c0, c1, c2, w0, w1, w2, rhs, sense) == 0 { return 0 }
    if objective_value(c0, c1, c2, x0, x1, x2) != rhs { return 0 }
    return 1
}

fn row_fingerprint(w0: i64, w1: i64, w2: i64, rhs: i64, sense: i64) -> i64 with Mod {
    if row_valid(w0, w1, w2, rhs, sense) == 0 { return 0 - 1 }
    let sc = sense_code(sense)
    if sc == 0 { return 0 - 1 }
    var fp: i64 = 83
    fp = mix(fp, w0, 941)
    fp = mix(fp, w1, 941)
    fp = mix(fp, w2, 941)
    fp = mix(fp, rhs, 941)
    fp = mix(fp, sc, 941)
    return fp
}

fn assignment_fingerprint(x0: i64, x1: i64, x2: i64) -> i64 with Mod {
    if assignment_valid(x0, x1, x2) == 0 { return 0 - 1 }
    var fp: i64 = 89
    fp = mix(fp, assignment_code(x0), 977)
    fp = mix(fp, assignment_code(x1), 977)
    fp = mix(fp, assignment_code(x2), 977)
    return fp
}

fn objective_fingerprint(c0: i64, c1: i64, c2: i64) -> i64 with Mod {
    if objective_valid(c0, c1, c2) == 0 { return 0 - 1 }
    var fp: i64 = 109
    fp = mix(fp, c0, 1217)
    fp = mix(fp, c1, 1217)
    fp = mix(fp, c2, 1217)
    return fp
}

fn min_objective_certificate_fingerprint(c0: i64, c1: i64, c2: i64,
                                         w0: i64, w1: i64, w2: i64,
                                         rhs: i64, sense: i64,
                                         x0: i64, x1: i64, x2: i64) -> i64 with Mod {
    if check_min_objective_optimal(c0, c1, c2, w0, w1, w2, rhs, sense, x0, x1, x2) == 0 { return 0 - 1 }
    let obj_fp = objective_fingerprint(c0, c1, c2)
    let row_fp = row_fingerprint(w0, w1, w2, rhs, sense)
    let assignment_fp = assignment_fingerprint(x0, x1, x2)
    let value = objective_value(c0, c1, c2, x0, x1, x2)
    var fp: i64 = 113
    fp = mix(fp, obj_fp, 1229)
    fp = mix(fp, row_fp, 1229)
    fp = mix(fp, assignment_fp, 1229)
    fp = mix(fp, value, 1229)
    fp = mix(fp, rhs, 1229)
    return fp
}

fn main() -> i64 with Mod {
    // Minimize 2*x0 + 3*x1 + 5*x2.  The proof row says every feasible solution
    // has objective >= 3; the incumbent assignment (0,1,0) has objective 3.
    if objective_fingerprint(2, 3, 5) != 910777053 { return 1 }
    if row_fingerprint(2, 3, 5, 3, sense_ge()) != 177229408 { return 2 }
    if assignment_fingerprint(0, 1, 0) != 625953239 { return 3 }
    if objective_value(2, 3, 5, 0, 1, 0) != 3 { return 4 }
    if check_min_objective_optimal(2, 3, 5, 2, 3, 5, 3, sense_ge(), 0, 1, 0) != 1 { return 5 }
    if min_objective_certificate_fingerprint(2, 3, 5, 2, 3, 5, 3, sense_ge(), 0, 1, 0) != 271184648 { return 6 }

    // Negative controls: a lower-bound row alone is not enough, and an
    // incumbent alone is not enough.  They must agree on coefficients and cost.
    if check_min_objective_optimal(2, 3, 5, 2, 3, 5, 4, sense_ge(), 0, 1, 0) != 0 { return 7 }
    if check_min_objective_optimal(2, 3, 5, 2, 3, 4, 3, sense_ge(), 0, 1, 0) != 0 { return 8 }
    if check_min_objective_optimal(2, 3, 5, 2, 3, 5, 3, 0 - 1, 0, 1, 0) != 0 { return 9 }
    if check_min_objective_optimal(2, 3, 5, 2, 3, 5, 3, sense_ge(), 1, 0, 0) != 0 { return 10 }
    if min_objective_certificate_fingerprint(2, 3, 5, 2, 3, 5, 3, sense_ge(), 1, 0, 0) != (0 - 1) { return 11 }

    return 0
}
