//@ run-pass
//@ expect-stdout: hierarchy role OK

ontology PharmaHierarchy {
    class ChemicalEntity
    class Drug subclass_of ChemicalEntity
    class Rapamycin subclass_of Drug
    class Disease
    role treats domain Drug range Disease
}

fn make_rapamycin() -> Rapamycin { 0 as Rapamycin }

fn accept_drug(d: Drug) -> i32 with IO {
    println("hierarchy role OK")
    0
}

fn main() -> i32 with IO {
    let r: Rapamycin = make_rapamycin()
    accept_drug(r)
    0
}
