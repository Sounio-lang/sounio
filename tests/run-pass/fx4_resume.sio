//@ run-pass
//@ requires: madaros
//@ expect-stdout: 11
//@ description: FX-4 resume: resume(w) continues the body with w; resume itself evaluates to the handle's final value when the resumed body completes (SIO-417)
//@ semantic-lane: SPEC-07-7.4-FX-4

effect Ask { fn get() -> i64 }

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = handle<Ask> {
        let v = perform Ask.get()
        v
    } with { on get() -> { let s = resume(10)
                           s + 1 } return(x) -> x }
    println(r)
    0
}
