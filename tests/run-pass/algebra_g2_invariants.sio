//@ run-pass
// Test: G₂ 3-form, SU(3) branching quality, and associator deviation field.
//
// Verifies:
//   T1: 7 Fano triples have associator norm 0
//   T2: 28 non-Fano triples have associator norm 4
//   T3: G₂ 3-form on identity frame has magnitude 7
//   T4: SU(3) branching quality on identity frame = 1.0
//   T5: Scrambled frame has Q < 1.0
//   T6: All 7 Fano line triples verified via is_fano_triple

algebra Octonion over f64 {
    add: commutative, associative
    mul: alternative, non_commutative
    reassociate: fano_selective
}

// === Octonion by-value (proven JIT-compatible pattern) ===

struct Oct {
    e0: f32, e1: f32, e2: f32, e3: f32,
    e4: f32, e5: f32, e6: f32, e7: f32,
}

fn oct_zero() -> Oct {
    Oct { e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0,
          e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 }
}

fn oct_basis(idx: i32) -> Oct {
    var o = oct_zero()
    if idx == 0 { return Oct { e0: 1.0, e1: 0.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 } }
    if idx == 1 { return Oct { e0: 0.0, e1: 1.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 } }
    if idx == 2 { return Oct { e0: 0.0, e1: 0.0, e2: 1.0, e3: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 } }
    if idx == 3 { return Oct { e0: 0.0, e1: 0.0, e2: 0.0, e3: 1.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 0.0 } }
    if idx == 4 { return Oct { e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0, e4: 1.0, e5: 0.0, e6: 0.0, e7: 0.0 } }
    if idx == 5 { return Oct { e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 1.0, e6: 0.0, e7: 0.0 } }
    if idx == 6 { return Oct { e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0, e6: 1.0, e7: 0.0 } }
    Oct { e0: 0.0, e1: 0.0, e2: 0.0, e3: 0.0, e4: 0.0, e5: 0.0, e6: 0.0, e7: 1.0 }
}

fn oct_get(o: Oct, idx: i32) -> f32 {
    if idx == 0 { return o.e0 }
    if idx == 1 { return o.e1 }
    if idx == 2 { return o.e2 }
    if idx == 3 { return o.e3 }
    if idx == 4 { return o.e4 }
    if idx == 5 { return o.e5 }
    if idx == 6 { return o.e6 }
    o.e7
}

fn oct_norm_sq(o: Oct) -> f32 {
    o.e0*o.e0 + o.e1*o.e1 + o.e2*o.e2 + o.e3*o.e3 +
    o.e4*o.e4 + o.e5*o.e5 + o.e6*o.e6 + o.e7*o.e7
}

fn oct_sub(a: Oct, b: Oct) -> Oct {
    Oct { e0: a.e0 - b.e0, e1: a.e1 - b.e1, e2: a.e2 - b.e2, e3: a.e3 - b.e3,
          e4: a.e4 - b.e4, e5: a.e5 - b.e5, e6: a.e6 - b.e6, e7: a.e7 - b.e7 }
}

// Full octonion multiplication (Cayley-Dickson, by value)
fn oct_mul(a: Oct, b: Oct) -> Oct {
    let c0 = a.e0*b.e0 - a.e1*b.e1 - a.e2*b.e2 - a.e3*b.e3 - a.e4*b.e4 - a.e5*b.e5 - a.e6*b.e6 - a.e7*b.e7
    let c1 = a.e0*b.e1 + a.e1*b.e0 + a.e2*b.e3 - a.e3*b.e2 + a.e4*b.e5 - a.e5*b.e4 - a.e6*b.e7 + a.e7*b.e6
    let c2 = a.e0*b.e2 + a.e2*b.e0 - a.e1*b.e3 + a.e3*b.e1 + a.e4*b.e6 - a.e6*b.e4 + a.e5*b.e7 - a.e7*b.e5
    let c3 = a.e0*b.e3 + a.e3*b.e0 + a.e1*b.e2 - a.e2*b.e1 + a.e4*b.e7 - a.e7*b.e4 - a.e5*b.e6 + a.e6*b.e5
    let c4 = a.e0*b.e4 + a.e4*b.e0 - a.e1*b.e5 + a.e5*b.e1 - a.e2*b.e6 + a.e6*b.e2 - a.e3*b.e7 + a.e7*b.e3
    let c5 = a.e0*b.e5 + a.e5*b.e0 + a.e1*b.e4 - a.e4*b.e1 - a.e2*b.e7 + a.e7*b.e2 + a.e3*b.e6 - a.e6*b.e3
    let c6 = a.e0*b.e6 + a.e6*b.e0 + a.e1*b.e7 - a.e7*b.e1 + a.e2*b.e4 - a.e4*b.e2 - a.e3*b.e5 + a.e5*b.e3
    let c7 = a.e0*b.e7 + a.e7*b.e0 - a.e1*b.e6 + a.e6*b.e1 + a.e2*b.e5 - a.e5*b.e2 + a.e3*b.e4 - a.e4*b.e3
    Oct { e0: c0, e1: c1, e2: c2, e3: c3, e4: c4, e5: c5, e6: c6, e7: c7 }
}

// Associator [a,b,c] = (a*b)*c - a*(b*c)
fn oct_associator(a: Oct, b: Oct, c: Oct) -> Oct {
    let ab_c = oct_mul(oct_mul(a, b), c)
    let a_bc = oct_mul(a, oct_mul(b, c))
    oct_sub(ab_c, a_bc)
}

// |[ei, ej, ek]|²
fn basis_assoc_norm_sq(i: i32, j: i32, k: i32) -> f32 {
    oct_norm_sq(oct_associator(oct_basis(i), oct_basis(j), oct_basis(k)))
}

// === Cayley-Dickson sign ===

fn cd_sigma_r(a: i32, b: i32, bits: i32) -> i32 with Mut, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_r(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_r(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_r(a_lo, b_lo, bits - 1) }
        return 0 - cd_sigma_r(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_r(b_lo, a_lo, bits - 1) }
    cd_sigma_r(b_lo, a_lo, bits - 1)
}

fn cd_sigma(a: i32, b: i32) -> i32 with Mut, Div {
    cd_sigma_r(a, b, 3)
}

// === XOR for 3-bit indices ===

fn oct_xor(a: i32, b: i32) -> i32 {
    let a0 = a - (a / 2) * 2
    let b0 = b - (b / 2) * 2
    let a1 = (a / 2) - (a / 4) * 2
    let b1 = (b / 2) - (b / 4) * 2
    let a2 = a / 4
    let b2 = b / 4
    let x0 = if a0 == b0 { 0 } else { 1 }
    let x1 = if a1 == b1 { 0 } else { 1 }
    let x2 = if a2 == b2 { 0 } else { 1 }
    x0 + 2 * x1 + 4 * x2
}

// === Fano predicate ===

fn is_fano_triple(i: i32, j: i32, k: i32) -> bool with Mut, Div {
    if i == 0 || j == 0 || k == 0 { return true }
    if i == j || j == k || i == k { return true }
    let alpha_1 = cd_sigma(i, j)
    let ij_xor = oct_xor(i, j)
    let alpha_2 = cd_sigma(ij_xor, k)
    let alpha = alpha_1 * alpha_2
    let beta_1 = cd_sigma(j, k)
    let jk_xor = oct_xor(j, k)
    let beta_2 = cd_sigma(i, jk_xor)
    let beta = beta_1 * beta_2
    alpha == beta
}

// === Fano line accessors ===

fn fano_line_i(n: i32) -> i32 {
    if n == 0 { return 1 }
    if n == 1 { return 1 }
    if n == 2 { return 1 }
    if n == 3 { return 2 }
    if n == 4 { return 2 }
    if n == 5 { return 3 }
    3
}

fn fano_line_j(n: i32) -> i32 {
    if n == 0 { return 2 }
    if n == 1 { return 4 }
    if n == 2 { return 7 }
    if n == 3 { return 4 }
    if n == 4 { return 5 }
    if n == 5 { return 4 }
    6
}

fn fano_line_k(n: i32) -> i32 {
    if n == 0 { return 3 }
    if n == 1 { return 5 }
    if n == 2 { return 6 }
    if n == 3 { return 6 }
    if n == 4 { return 7 }
    if n == 5 { return 7 }
    5
}

// === G₂ 3-form on identity frame ===
// For the identity frame (v_k = standard basis e_k in R^7),
// Gram(v_i, v_j) = δ_{ij}, so each Fano line's 3×3 Gram is I₃ (det=1).
// φ = Σ sign(line) * 1 = Σ cd_sigma(i,j) over 7 Fano lines.
fn g2_3form_identity() -> f32 with Mut, Div {
    var phi: f32 = 0.0
    var line: i32 = 0
    while line < 7 {
        let i = fano_line_i(line)
        let j = fano_line_j(line)
        let sign = cd_sigma(i, j)
        if sign > 0 { phi = phi + 1.0 } else { phi = phi - 1.0 }
        line = line + 1
    }
    phi
}

// === SU(3) branching quality ===
// For 7×7 identity Gram: perfect block-diagonal → Q = 1.0
// For scrambled Gram with cross-block entries: Q < 1.0
//
// Block assignment: {0,1,2} → triplet, {3,4,5} → anti-triplet, {6} → singlet
fn su3_block(k: i32) -> i32 {
    if k < 3 { return 0 }
    if k < 6 { return 1 }
    2
}

// Q = 1 - (off-block Frobenius)² / (total Frobenius)²
// For identity matrix I₇: total = 7, off-block = 0, Q = 1.0
// For a matrix with cross-block entries: off-block > 0, Q < 1.0
fn su3_quality_identity() -> f32 with Mut {
    // Identity Gram: g[i][j] = δ_{ij}
    var total: f32 = 0.0
    var off: f32 = 0.0
    var i: i32 = 0
    while i < 7 {
        var j: i32 = 0
        while j < 7 {
            var val: f32 = 0.0
            if i == j { val = 1.0 }
            total = total + val * val
            if su3_block(i) != su3_block(j) {
                off = off + val * val
            }
            j = j + 1
        }
        i = i + 1
    }
    1.0 - off / total
}

fn su3_quality_scrambled() -> f32 with Mut {
    // Gram with cross-block contamination: g[0][3] = g[3][0] = 0.5
    var total: f32 = 0.0
    var off: f32 = 0.0
    var i: i32 = 0
    while i < 7 {
        var j: i32 = 0
        while j < 7 {
            var val: f32 = 0.0
            if i == j { val = 1.0 }
            if i == 0 && j == 3 { val = 0.5 }
            if i == 3 && j == 0 { val = 0.5 }
            total = total + val * val
            if su3_block(i) != su3_block(j) {
                off = off + val * val
            }
            j = j + 1
        }
        i = i + 1
    }
    1.0 - off / total
}

// === Helpers ===

fn abs_f32(x: f32) -> f32 {
    if x < 0.0 { return 0.0 - x }
    x
}

// === MAIN ===

fn main() -> i32 with IO, Mut, Div {
    var pass: i32 = 0
    var fail: i32 = 0

    // T1: Count Fano triples (associator norm ≈ 0)
    var n_fano: i32 = 0
    var n_norm8: i32 = 0
    var i: i32 = 1
    while i <= 7 {
        var j: i32 = i + 1
        while j <= 7 {
            var k: i32 = j + 1
            while k <= 7 {
                let norm = basis_assoc_norm_sq(i, j, k)
                if norm < 0.01 { n_fano = n_fano + 1 }
                if abs_f32(norm - 4.0) < 0.01 { n_norm8 = n_norm8 + 1 }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }

    // Debug: check what the actual non-Fano norm is
    let test_norm = basis_assoc_norm_sq(1, 2, 4)


    if n_fano == 7 { pass = pass + 1; println("T1 PASS: 7 Fano triples (norm 0)") }
    else { fail = fail + 1; println("T1 FAIL: Fano count wrong") }

    if n_norm8 == 28 { pass = pass + 1; println("T2 PASS: 28 non-Fano triples (norm 4)") }
    else { fail = fail + 1; println("T2 FAIL: norm-4 count wrong") }

    // T3: G₂ 3-form magnitude on identity frame = 7
    let phi = g2_3form_identity()
    let phi_abs = abs_f32(phi)
    if phi_abs > 6.99 && phi_abs < 7.01 {
        pass = pass + 1; println("T3 PASS: G2 3-form |phi| = 7")
    } else {
        fail = fail + 1; println("T3 FAIL: G2 3-form unexpected")
    }

    // T4: SU(3) branching quality = 1.0 on identity frame
    let q1 = su3_quality_identity()
    if q1 > 0.99 {
        pass = pass + 1; println("T4 PASS: SU(3) Q = 1.0 on identity")
    } else {
        fail = fail + 1; println("T4 FAIL: SU(3) quality wrong on identity")
    }

    // T5: Scrambled frame has Q < 1.0
    let q2 = su3_quality_scrambled()
    if q2 < 0.99 {
        pass = pass + 1; println("T5 PASS: scrambled frame Q < 1.0")
    } else {
        fail = fail + 1; println("T5 FAIL: scrambled should have Q < 1.0")
    }

    // T6: All 7 Fano line triples are actually Fano
    var all_fano: i32 = 1
    var line: i32 = 0
    while line < 7 {
        if !is_fano_triple(fano_line_i(line), fano_line_j(line), fano_line_k(line)) {
            all_fano = 0
        }
        line = line + 1
    }
    if all_fano == 1 {
        pass = pass + 1; println("T6 PASS: all Fano line triples verified")
    } else {
        fail = fail + 1; println("T6 FAIL: Fano line not recognized")
    }

    println("---")
    if fail == 0 { println("ALL PASS") }
    else { println("SOME TESTS FAILED") }

    0
}
