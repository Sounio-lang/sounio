//@ run-pass
//@ expect-stdout: UNIT_CALL_CAST_OK

//! KL-13 escape hatch: explicit `as f64` still strips the unit brand so a
//! unit-typed value may enter a bare f64 parameter.

fn takes_f64(x: f64) -> f64 { x * 2.0 }

fn main() -> i32 with IO, Div, Panic {
    let t_k: K = 1500.0
    let a = takes_f64(t_k as f64)
    if a == 3000.0 {
        println("UNIT_CALL_CAST_OK")
        return 0
    }
    1
}
