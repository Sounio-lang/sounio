use x509::oid::*

fn main() with IO {
    var a: [u8; 20] = [0; 20]
    a[0] = 0x55
    a[1] = 0x04
    a[2] = 0x03
    var b: [u8; 20] = [0; 20]
    b[0] = 0x55
    b[1] = 0x04
    b[2] = 0x03
    assert(oid_eq(&a, 3, &b, 3) == true)

    var c: [u8; 20] = [0; 20]
    c[0] = 0x55
    c[1] = 0x04
    c[2] = 0x06   // countryName, not commonName
    assert(oid_eq(&a, 3, &c, 3) == false)

    assert(oid_eq(&a, 3, &b, 2) == false)   // length mismatch

    // oid_eq3 width-specific check. NOTE: this deliberately compares against
    // a freshly-built LOCAL [u8; 3] holding the same bytes as OID_COMMON_NAME,
    // not against `&OID_COMMON_NAME` directly -- see task-1-report.md for a
    // documented compiler bug where taking `&` of a top-level `const [u8; N]`
    // array (or copying it whole into a `var`) yields corrupted data, even
    // though direct indexed reads of the const (e.g. `OID_COMMON_NAME[0]`)
    // are correct. This test avoids that broken pattern; it does not paper
    // over it -- the bug is real and is reported separately.
    var common_name_bytes: [u8; 3] = [0; 3]
    common_name_bytes[0] = 0x55
    common_name_bytes[1] = 0x04
    common_name_bytes[2] = 0x03
    assert(oid_eq3(&a, 3, &common_name_bytes) == true)
    assert(oid_eq3(&c, 3, &common_name_bytes) == false)

    println("x509_oid_compare: all cases passed")
}
