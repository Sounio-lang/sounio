use x509::oid::*

fn main() with IO {
    var a: [u8; 20] = [0; 20]
    a[0] = 0x55
    a[1] = 0x04
    a[2] = 0x03
    var b: [u8; 20] = [0; 20]
    b[0] = 0x55
    b[1] = 0x04
    b[2] = 0x03
    assert(oid_eq(&a, 3, &b, 3) == true)

    var c: [u8; 20] = [0; 20]
    c[0] = 0x55
    c[1] = 0x04
    c[2] = 0x06   // countryName, not commonName
    assert(oid_eq(&a, 3, &c, 3) == false)

    assert(oid_eq(&a, 3, &b, 2) == false)   // length mismatch

    // oid_eq3 width-specific check, exercising the real accessor function
    // (Finding 18 fix: oid.sio's OIDs are now `pub fn oid_*() -> [u8;N]`
    // accessor functions, not top-level `const` arrays -- see
    // docs/audit/TLS_PREREQ_WIDE_INT_AND_RAW_BUFFERS_2026-08-23.md Finding 18
    // and task-1-report.md for why. The call-into-local-then-reference
    // pattern below is the one every future call site must use.)
    let cn = oid_common_name()
    assert(oid_eq3(&a, 3, &cn) == true)
    assert(oid_eq3(&c, 3, &cn) == false)

    // Broader coverage: oid_eq10 against the SCT-list extension OID,
    // following the same call-into-local-then-reference pattern.
    var d: [u8; 20] = [0; 20]
    d[0] = 0x2B
    d[1] = 0x06
    d[2] = 0x01
    d[3] = 0x04
    d[4] = 0x01
    d[5] = 0xD6
    d[6] = 0x79
    d[7] = 0x02
    d[8] = 0x04
    d[9] = 0x02
    let sct = oid_ext_sct_list()
    assert(oid_eq10(&d, 10, &sct) == true)
    assert(oid_eq10(&a, 3, &sct) == false)   // length mismatch

    println("x509_oid_compare: all cases passed")
}
