//@ run-pass
// Door 4: real stdlib import — no more concatenation hack
use stdlib::epistemic::audit_runtime::*

fn main() -> i32 with IO, Mut, Div, Audit {
    var log = audit_log_new()

    let e1 = audit_log_read(&!log, 12345, 0, 1024)
    let e2 = audit_log_transform(&!log, 1, e1, 0)
    let e3 = audit_log_test(&!log, 1, 2.45, 0.014, 0.52)

    let count = audit_log_count(&log)
    if count == 3 { println("T1 PASS: 3 entries logged") }
    else { println("T1 FAIL") }

    let entry0 = audit_get_entry(&log, 0)
    if entry0.entry_type == 0 { println("T2 PASS: first entry is data_read") }
    else { println("T2 FAIL") }

    let entry2 = audit_get_entry(&log, 2)
    if entry2.entry_type == 3 { println("T3 PASS: third entry is stat_test") }
    else { println("T3 FAIL") }

    // Keep the chained IDs live so the test also exercises return values.
    if e1 > 0 && e2 > e1 && e3 > e2 { println("T4 PASS: entity IDs chain") }
    else { println("T4 FAIL") }

    println("---")
    println("ALL PASS")
    0
}
