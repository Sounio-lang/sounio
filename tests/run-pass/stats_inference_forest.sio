//@ run-pass
//@ expect-stdout: INFERENTIAL_FOREST_PASS
//@ expect-stdout: data-interval-kind="confidence"
//@ expect-stdout: x1="10" y1="21" x2="130" y2="21"
use stats::inferential::{t_test_one_sample, T_TEST_OK}
use display::canvas::{Canvas, canvas_clear}
use viz::ir::{viz_scene_new, viz_layout_rect, viz_style_rgb, viz_add_forest_interval_plot, VIZ_INTERVAL_CONFIDENCE}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO, Alloc, Mut, Div, Panic {
    var samples: [f64; 100] = [0.0; 100]
    samples[0]=1.0; samples[1]=2.0; samples[2]=4.0; samples[3]=5.0; samples[4]=8.0
    let result = t_test_one_sample(samples, 5, 3.0)
    assert(result.status == T_TEST_OK)
    // Estimate is mean(data)-3, CI independently integrated in C++23.
    assert(result.ci_lower < -2.40043 && result.ci_lower > -2.40044)
    assert(result.ci_upper > 4.40043 && result.ci_upper < 4.40044)
    var estimates: [f64; 1024] = [0.0; 1024]
    var lower: [f64; 1024] = [0.0; 1024]
    var upper: [f64; 1024] = [0.0; 1024]
    estimates[0] = result.mean_diff
    lower[0] = result.ci_lower
    upper[0] = result.ci_upper
    var scene = viz_scene_new()
    let node = viz_add_forest_interval_plot(&!scene, &estimates, &lower, &upper, 1,
        VIZ_INTERVAL_CONFIDENCE, result.confidence_level,
        viz_layout_rect(10, 10, 120, 60), viz_style_rgb(80, 180, 240))
    assert(node == 0)
    assert(scene.series[0].lower[0] == result.ci_lower)
    assert(scene.series[0].upper[0] == result.ci_upper)
    let pixels = heap_alloc(144 * 80 * 8) as *mut i64
    var canvas = Canvas { pixels: pixels, width: 144, height: 80 }
    canvas_clear(&!canvas, 0, 0, 0)
    viz_canvas_render_scene(&scene, &!canvas)
    let estimate_color: i64 = 240 | (180 << 8) | (80 << 16)
    let interval_color: i64 = 220 | (180 << 8) | (180 << 16)
    assert(read_i64(canvas.pixels, 21 * 144 + 70) == estimate_color)
    assert(read_i64(canvas.pixels, 21 * 144 + 20) == interval_color)
    assert(read_i64(canvas.pixels, 21 * 144 + 120) == interval_color)
    viz_html_emit_scene(&scene, 144, 80)
    println("INFERENTIAL_FOREST_PASS")
    0
}
