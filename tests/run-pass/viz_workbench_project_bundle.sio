// tests/run-pass/viz_workbench_project_bundle.sio - Workbench Visual Project Format v0 proof
//
// Expected output includes:
//   viz-scene-project
//   viz-scene-package
//   workbench-replay-session
//   VIZ_WORKBENCH_PROJECT_BUNDLE_PASS

use display::canvas::{Canvas, canvas_clear}
use display::event::{Event, EV_MOUSE_PRESS, MOUSE_LEFT}
use viz::audit::{viz_audit_hash}
use viz::ir::{viz_scene_new}
use viz::snapshot::{
    viz_scene_history_new, viz_scene_history_record,
    viz_scene_package_new, viz_scene_package_verify, viz_scene_package_emit,
    viz_scene_project_new, viz_scene_project_verify, viz_scene_project_matches, viz_scene_project_emit,
}
use viz::viz_app::{viz_app_new}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use viz::workbench::{
    VizWorkbenchReplayStep,
    viz_workbench_build_scene,
    viz_workbench_project_capture,
    viz_workbench_project_restore,
    viz_workbench_project_verify_session,
    viz_workbench_replay_emit_html_archive,
    viz_workbench_replay_event,
    viz_workbench_replay_record_session,
    viz_workbench_replay_session_hash,
    viz_workbench_replay_tick,
}

fn ev(kind: i64, key: i64, x: i64, y: i64) -> Event {
    Event { kind: kind, key: key, x: x, y: y, mods: 0 }
}

fn make_canvas(w: i64, h: i64) -> Canvas with Alloc {
    let pix = heap_alloc(w * h * 8) as *mut i64
    Canvas { pixels: pix, width: w, height: h }
}

fn center_x(x: i64, w: i64) -> i64 {
    x + w / 2
}

fn center_y(y: i64, h: i64) -> i64 {
    y + h / 2
}

fn canvas_hash(c: &Canvas) -> i64 with Mut {
    var h: i64 = 19
    var i: i64 = 0
    let n = c.width * c.height
    while i < n {
        h = h * 131 + read_i64(c.pixels, i)
        i = i + 1
    }
    h
}

fn main() with IO, Alloc, Mut, Div {
    var scene_a = viz_scene_new()
    let ids_a = viz_workbench_build_scene(&!scene_a)
    scene_a.selected_node = ids_a.time_readout
    scene_a.focused_node = ids_a.time_readout
    scene_a.hovered_node = ids_a.time_readout
    var app_a = viz_app_new(10, 13, 18)
    var canvas_a = make_canvas(480, 320)

    var steps: [VizWorkbenchReplayStep; 32] = [viz_workbench_replay_tick(0); 32]
    let play_x = center_x(scene_a.nodes[ids_a.time_play as usize].layout.x, scene_a.nodes[ids_a.time_play as usize].layout.w)
    let play_y = center_y(scene_a.nodes[ids_a.time_play as usize].layout.y, scene_a.nodes[ids_a.time_play as usize].layout.h)
    let forward_x = center_x(scene_a.nodes[ids_a.time_forward as usize].layout.x, scene_a.nodes[ids_a.time_forward as usize].layout.w)
    let forward_y = center_y(scene_a.nodes[ids_a.time_forward as usize].layout.y, scene_a.nodes[ids_a.time_forward as usize].layout.h)

    steps[0] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, play_x, play_y))
    steps[1] = viz_workbench_replay_tick(1000)
    steps[2] = viz_workbench_replay_tick(1000)
    steps[3] = viz_workbench_replay_event(ev(EV_MOUSE_PRESS, MOUSE_LEFT, forward_x, forward_y))

    let session = viz_workbench_replay_record_session(&!app_a, &!scene_a, &ids_a, &!canvas_a, &steps, 4)
    assert(session.frame_count == 5)
    assert(scene_a.time == 5.0)
    assert(session.final_audit_hash == viz_audit_hash(&scene_a))

    var history = viz_scene_history_new()
    assert(viz_scene_history_record(&!history, &scene_a, 9001))

    canvas_clear(&!canvas_a, app_a.bg_r, app_a.bg_g, app_a.bg_b)
    viz_canvas_render_scene(&scene_a, &!canvas_a)
    let export_hash = canvas_hash(&canvas_a)
    assert(export_hash != 0)

    var pkg = viz_scene_package_new()
    var project = viz_scene_project_new()
    viz_workbench_project_capture(&!project, &scene_a, &history, &!pkg, &session, export_hash)
    assert(viz_scene_package_verify(&pkg))
    assert(viz_scene_project_verify(&project))
    assert(project.schema_version == 0)
    assert(project.package.package_hash == pkg.package_hash)
    assert(project.replay_signature == viz_workbench_replay_session_hash(&session))
    assert(project.final_frame_hash == session.final_frame_hash)
    assert(project.final_audit_hash == session.final_audit_hash)
    assert(project.final_time_ms == 5000)
    assert(project.export_hash == export_hash)
    assert(project.project_hash != 0)

    var scene_b = viz_scene_new()
    let ids_b = viz_workbench_build_scene(&!scene_b)
    assert(viz_workbench_project_restore(&!scene_b, &project))
    assert(scene_b.time == 5.0)
    assert(scene_b.nodes[ids_b.time_readout as usize].value == 5.0)
    assert(viz_audit_hash(&scene_b) == project.final_audit_hash)
    assert(viz_scene_project_matches(&scene_b, &project))

    var scene_c = viz_scene_new()
    let ids_c = viz_workbench_build_scene(&!scene_c)
    scene_c.selected_node = ids_c.time_readout
    scene_c.focused_node = ids_c.time_readout
    scene_c.hovered_node = ids_c.time_readout
    var app_c = viz_app_new(10, 13, 18)
    var canvas_c = make_canvas(480, 320)
    assert(viz_workbench_project_verify_session(&!app_c, &!scene_c, &ids_c, &!canvas_c, &project, &session))
    assert(viz_audit_hash(&scene_c) == project.final_audit_hash)

    viz_scene_project_emit(&project)
    viz_scene_package_emit(&pkg)
    viz_workbench_replay_emit_html_archive(&session)
    viz_html_emit_scene(&scene_b, 480, 320)

    heap_free(canvas_a.pixels as *mut i8)
    heap_free(canvas_c.pixels as *mut i8)
    println("VIZ_WORKBENCH_PROJECT_BUNDLE_PASS")
}
