//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS specializer_emitted_instance_hash_collision
// The specializer remembered which struct instances it had emitted by the DJB2 hash
// of the mangled name alone. `Cell<B0>` and `Cell<AQ>` mangle to `Cell__B0` and
// `Cell__AQ`, and those two valid names hash identically (66*33+48 == 65*33+81), so
// the second instance was taken for the first and never emitted. The cache now
// confirms the exact name after a hash match.
//
// The drop does not change what this program prints, so the count is asserted by
// scripts/ci/madaros_scalar_multi_instance_gate.sh, which reads the specializer
// trace: two instances must be emitted, and one was.

struct B0 {
    x: i64,
}

struct AQ {
    y: f64,
}

struct Cell<T> {
    v: T,
}

fn wrap<T>(x: T) -> Cell<T> {
    Cell { v: x }
}

fn tag_b0(c: Cell<B0>) -> i64 {
    1
}

fn tag_aq(c: Cell<AQ>) -> i64 {
    2
}

fn main() -> i32 with IO {
    let a: Cell<B0> = wrap::<B0>(B0 { x: 7 })
    let b: Cell<AQ> = wrap::<AQ>(AQ { y: 2.5 })
    if tag_b0(a) + tag_aq(b) == 3 {
        println("PASS specializer_emitted_instance_hash_collision")
    } else {
        println("FAIL specializer_emitted_instance_hash_collision")
    }
    0
}
