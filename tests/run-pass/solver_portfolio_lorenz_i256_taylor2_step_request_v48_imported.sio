//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v48 smoke for Lorenz i256 Taylor-2 step-request entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v48_lorenz_i256_taylor2_step_request_fingerprint(
        510353327, 465022480, 222172950, 189376492, 224324310, 6, 127)
    if receipt_fp != 185755530 { return 1 }

    let audit_fp = solver_portfolio_v48_lorenz_i256_taylor2_step_request_audit_fingerprint(
        receipt_fp, 510353327, 465022480, 842631931, 13881891, 224324310, 6, 127)
    if audit_fp != 167433392 { return 2 }

    let manifest_fp = solver_portfolio_v48_lorenz_i256_taylor2_step_request_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 59406573 { return 3 }

    let result_fp = solver_portfolio_v48_result_coverage_fingerprint(
        48, 52, 10, 40, 1, 1, manifest_fp)
    if result_fp != 123844823 { return 4 }

    let family_fp = solver_portfolio_v48_checker_family_coverage_fingerprint(
        48, 52, 6, 4, 3, 2, 35, 2, manifest_fp)
    if family_fp != 93997314 { return 5 }

    let acceptance_fp = solver_portfolio_v48_acceptance_receipt_fingerprint(
        48, manifest_fp, result_fp)
    if acceptance_fp != 924871762 { return 6 }

    let audit_receipt_fp = solver_portfolio_v48_audit_receipt_fingerprint(
        48, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 646035701 { return 7 }

    let readiness_fp = solver_portfolio_v48_readiness_fingerprint(
        48, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 38526066 { return 8 }

    return 0
}
