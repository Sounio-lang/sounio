//@ run-pass
//@ expect-stdout: ref inner field ok
struct BlockSpec { blk_m: i64, blk_n: i64 }

struct ScheduleSpec { block: BlockSpec, bias: i64 }

struct KernelDescriptor { schedule: ScheduleSpec, m: i64, n: i64 }

fn nested_sum(desc: &KernelDescriptor) -> i64 with Div {
    desc.schedule.block.blk_m + desc.schedule.block.blk_n + desc.schedule.bias + desc.m + desc.n
}

fn main() -> i32 with IO, Panic, Div {
    let desc = KernelDescriptor {
        schedule: ScheduleSpec {
            block: BlockSpec { blk_m: 10, blk_n: 11 },
            bias: 1,
        },
        m: 12,
        n: 8,
    }

    assert(nested_sum(&desc) == 42)
    print("ref inner field ok\n")
    0
}
