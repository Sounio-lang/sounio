//@ description: KL-21 -- a `pub fn` named like an intercepted builtin shadows the builtin inside its own module (was: builtin wins, E008 "expected Knowledge")

pub fn measure(x: i64) -> i64 { x + 1000 }

fn main() -> i64 {
    if measure(5) == 1005 { 0 } else { 1 }
}
