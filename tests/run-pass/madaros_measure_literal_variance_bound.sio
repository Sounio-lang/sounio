//@ run-pass
//@ expect-stdout: literal variance bound: PASS

fn loose(k: Knowledge<f64, epsilon < 0.1>) -> f64 with Epistemic { k.value }
fn main() -> i32 with IO, Mut, Panic, Div, Epistemic {
    let precise: Knowledge<f64, epsilon < 0.01> = measure(500.0, uncertainty: 0.05)
    assert(loose(precise) == 500.0)
    assert(precise.variance > 0.0024 && precise.variance < 0.0026)
    print("literal variance bound: PASS\n")
    0
}
