//@ run-pass
//@ expect-stdout: VIZ_KS_ECDF_PASS
//@ expect-stdout: Synthetic tied samples n=3 each
//@ expect-stdout: Asymptotic continuous null; ties unassessed
use stats::ks_test::{ks_two}
use viz::axis::{axis_label}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_axis,viz_line_set_viewport,
 viz_add_label,viz_node_set_label,viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 x[2]=1.0
 y[1]=1.0
 y[2]=1.0
 let r=ks_two(&x,3,&y,3)
 assert(r.status==0 && r.has_ties && r.asymptotic)
 assert(r.d>0.33333333333332 && r.d<0.33333333333335)
 assert(r.p>=0.0 && r.p<=1.0)
 var xs:[f64;1024]=[0.0;1024]
 var fx:[f64;1024]=[0.0;1024]
 var fy:[f64;1024]=[0.0;1024]
 // Duplicate x coordinates draw vertical jumps after all equal values.
 // Extend both tails so the full empirical distributions are visible.
 xs[0]=-0.25
 xs[1]=0.0
 xs[2]=0.0
 xs[3]=1.0
 xs[4]=1.0
 xs[5]=1.25
 fx[2]=2.0/3.0
 fx[3]=2.0/3.0
 fx[4]=1.0
 fx[5]=1.0
 fy[2]=1.0/3.0
 fy[3]=1.0/3.0
 fy[4]=1.0
 fy[5]=1.0
 assert(fx[2]-fy[2]>r.d-1e-14 && fx[2]-fy[2]<r.d+1e-14)
 var dx:[f64;1024]=[0.0;1024]
 var dy:[f64;1024]=[0.0;1024]
 dx[0]=0.5
 dx[1]=0.5
 dy[0]=fy[2]
 dy[1]=fy[2]+r.d
 var scene=viz_scene_new()
 let a=viz_add_line_chart(&!scene,&xs,&fx,6,viz_layout_rect(140,110,600,220),viz_style_rgb(70,180,235))
 let b=viz_add_line_chart(&!scene,&xs,&fy,6,viz_layout_rect(140,110,600,220),viz_style_rgb(245,170,65))
 let gap=viz_add_line_chart(&!scene,&dx,&dy,2,viz_layout_rect(140,110,600,220),viz_style_rgb(220,135,225))
 assert(viz_line_set_viewport(&!scene,a,-0.25,1.25,0.0,1.0))
 assert(viz_line_set_viewport(&!scene,b,-0.25,1.25,0.0,1.0))
 assert(viz_line_set_viewport(&!scene,gap,-0.25,1.25,0.0,1.0))
 let xa=viz_add_axis(&!scene,-0.25,1.25,4,false,viz_layout_rect(140,348,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,1.0,4,true,viz_layout_rect(120,110,1,220),viz_style_rgb(190,200,215))
 var title:[i8;64]=[0;64]
 title[0]=75
 title[1]=111
 title[2]=108
 title[3]=109
 title[4]=111
 title[5]=103
 title[6]=111
 title[7]=114
 title[8]=111
 title[9]=118
 title[10]=45
 title[11]=83
 title[12]=109
 title[13]=105
 title[14]=114
 title[15]=110
 title[16]=111
 title[17]=118
 title[18]=58
 title[19]=32
 title[20]=116
 title[21]=119
 title[22]=111
 title[23]=32
 title[24]=101
 title[25]=109
 title[26]=112
 title[27]=105
 title[28]=114
 title[29]=105
 title[30]=99
 title[31]=97
 title[32]=108
 title[33]=32
 title[34]=67
 title[35]=68
 title[36]=70
 title[37]=115
 var subtitle:[i8;64]=[0;64]
 subtitle[0]=83
 subtitle[1]=121
 subtitle[2]=110
 subtitle[3]=116
 subtitle[4]=104
 subtitle[5]=101
 subtitle[6]=116
 subtitle[7]=105
 subtitle[8]=99
 subtitle[9]=32
 subtitle[10]=116
 subtitle[11]=105
 subtitle[12]=101
 subtitle[13]=100
 subtitle[14]=32
 subtitle[15]=115
 subtitle[16]=97
 subtitle[17]=109
 subtitle[18]=112
 subtitle[19]=108
 subtitle[20]=101
 subtitle[21]=115
 subtitle[22]=32
 subtitle[23]=110
 subtitle[24]=61
 subtitle[25]=51
 subtitle[26]=32
 subtitle[27]=101
 subtitle[28]=97
 subtitle[29]=99
 subtitle[30]=104
 var xn:[i8;64]=[0;64]
 xn[0]=115
 xn[1]=97
 xn[2]=109
 xn[3]=112
 xn[4]=108
 xn[5]=101
 xn[6]=32
 xn[7]=118
 xn[8]=97
 xn[9]=108
 xn[10]=117
 xn[11]=101
 var yn:[i8;64]=[0;64]
 yn[0]=99
 yn[1]=117
 yn[2]=109
 yn[3]=117
 yn[4]=108
 yn[5]=97
 yn[6]=116
 yn[7]=105
 yn[8]=118
 yn[9]=101
 yn[10]=32
 yn[11]=112
 yn[12]=114
 yn[13]=111
 yn[14]=98
 yn[15]=97
 yn[16]=98
 yn[17]=105
 yn[18]=108
 yn[19]=105
 yn[20]=116
 yn[21]=121
 var lg:[i8;64]=[0;64]
 lg[0]=88
 lg[1]=32
 lg[2]=61
 lg[3]=32
 lg[4]=91
 lg[5]=48
 lg[6]=44
 lg[7]=32
 lg[8]=48
 lg[9]=44
 lg[10]=32
 lg[11]=49
 lg[12]=93
 var rg:[i8;64]=[0;64]
 rg[0]=89
 rg[1]=32
 rg[2]=61
 rg[3]=32
 rg[4]=91
 rg[5]=48
 rg[6]=44
 rg[7]=32
 rg[8]=49
 rg[9]=44
 rg[10]=32
 rg[11]=49
 rg[12]=93
 var foot:[i8;64]=[0;64]
 foot[0]=65
 foot[1]=115
 foot[2]=121
 foot[3]=109
 foot[4]=112
 foot[5]=116
 foot[6]=111
 foot[7]=116
 foot[8]=105
 foot[9]=99
 foot[10]=32
 foot[11]=99
 foot[12]=111
 foot[13]=110
 foot[14]=116
 foot[15]=105
 foot[16]=110
 foot[17]=117
 foot[18]=111
 foot[19]=117
 foot[20]=115
 foot[21]=32
 foot[22]=110
 foot[23]=117
 foot[24]=108
 foot[25]=108
 foot[26]=59
 foot[27]=32
 foot[28]=116
 foot[29]=105
 foot[30]=101
 foot[31]=115
 foot[32]=32
 foot[33]=117
 foot[34]=110
 foot[35]=97
 foot[36]=115
 foot[37]=115
 foot[38]=101
 foot[39]=115
 foot[40]=115
 foot[41]=101
 foot[42]=100
 viz_node_set_label(&!scene,xa,&xn,12)
 viz_node_set_label(&!scene,ya,&yn,22)
 assert(viz_add_label(&!scene,&title,38,viz_layout_rect(140,20,600,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&subtitle,31,viz_layout_rect(140,48,600,20),viz_style_rgb(190,200,215))>=0)
 assert(viz_add_series_legend(&!scene,a,&lg,13,viz_layout_rect(140,400,280,22))>=0)
 assert(viz_add_series_legend(&!scene,b,&rg,13,viz_layout_rect(470,400,270,22))>=0)
 assert(viz_add_label(&!scene,&foot,43,viz_layout_rect(140,436,600,14),viz_style_rgb(190,200,215))>=0)
 let dv=axis_label(r.d)
 let pv=axis_label(r.p)
 var dt:[i8;64]=[0;64]
 var pt:[i8;64]=[0;64]
 dt[0]=68
 dt[1]=61
 pt[0]=112
 pt[1]=61
 var i:i64=0
 while i<dv.n {dt[(i+2) as usize]=dv.text[i as usize];i=i+1}
 i=0
 while i<pv.n {pt[(i+2) as usize]=pv.text[i as usize];i=i+1}
 assert(viz_add_label(&!scene,&dt,dv.n+2,viz_layout_rect(140,74,280,20),viz_style_rgb(230,235,245))>=0)
 assert(viz_add_label(&!scene,&pt,pv.n+2,viz_layout_rect(470,74,280,20),viz_style_rgb(230,235,245))>=0)
 assert(scene.node_count==12 && scene.series_count==3)
 let pixels=heap_alloc(920*450*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:920,height:450}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 assert(read_i64(canvas.pixels,330*920+118)==190*65536+200*256+215)
 viz_html_emit_scene(&scene,920,450)
 println("VIZ_KS_ECDF_PASS")
 0
}
