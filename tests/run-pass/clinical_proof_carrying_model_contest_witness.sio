//@ check-only
// Imported API conformance for the bounded synthetic D2 contest.

use epistemic::proof_carrying_model_contest::*

fn main() with Mut, Panic {
    let h0 = declare_contest_hypothesis(110, 0, 1)
    let h1 = declare_contest_hypothesis(111, 1, 1)
    let h2 = declare_contest_hypothesis(112, 2, 2)
    let h3 = declare_contest_hypothesis(113, 3, 2)
    let family = declare_four_hypothesis_family(120, 8100, h0, h1, h2, h3)
    let probe_a = declare_synthetic_contest_probe(201, 8100, 0)
    let probe_b = declare_synthetic_contest_probe(202, 8100, 1)
    let probe_c = declare_synthetic_contest_probe(203, 8100, 2)
    let policy = certify_adaptive_burden_policy(301, family)
    let initial = begin_proof_carrying_contest(401, family)

    let missing = record_missing_contest_observation(501, 120, probe_a, 1)
    let missing_abstention = abstain_on_missing_observation(601, initial, missing)
    assert(missing_abstention.survivor_mask_unchanged == 15)
    assert(missing_abstention.survivor_count_unchanged == 4)
    assert(missing_abstention.hypotheses_eliminated == 0)
    assert(missing_abstention.inference_deferred)

    let unaudited = record_unaudited_contest_observation(502, 120, probe_a, 1, 600)
    let unaudited_abstention = abstain_on_unaudited_observation(602, initial, unaudited)
    assert(unaudited_abstention.survivor_mask_unchanged == 15)
    assert(unaudited_abstention.hypotheses_eliminated == 0)

    let disconnected = record_observation_provenance(9104, 9201, 8100, 1, 9999)
    let disconnected_abstention = abstain_on_disconnected_provenance(
        603, initial, 506, probe_a, disconnected,
    )
    assert(disconnected_abstention.reason_code == 3)
    assert(disconnected_abstention.survivor_mask_unchanged == 15)
    assert(disconnected_abstention.hypotheses_eliminated == 0)

    let provenance_a = record_observation_provenance(9101, 9201, 8100, 1, 0)
    let observed_a = admit_contest_observation(
        503, initial, family, probe_a, provenance_a, 600, 1000,
    )
    let after_a = update_proof_carrying_contest(
        701, 402, initial, family, observed_a,
    )
    let after_a_state = contest_transition_result(after_a)
    assert(contest_transition_source_survivor_mask(after_a) == 15)
    assert(contest_transition_result_survivor_mask(after_a) == 12)
    assert(contest_transition_probe_index(after_a) == 0)
    assert(contest_transition_observed_value_numerator(after_a) == 600)
    assert(contest_transition_eliminated_mask(after_a) == 3)
    assert(contest_transition_eliminated_count(after_a) == 2)
    assert(contest_transition_provenance_id(after_a) == 9101)
    assert(contest_transition_previous_provenance_id(after_a) == 0)
    assert(contest_transition_source_id(after_a) == 9201)
    assert(contest_transition_tick(after_a) == 1)
    assert(contest_state_survivor_count(after_a_state) == 2)
    assert(contest_state_burden_spent(after_a_state) == 2)
    assert(contest_state_provenance_fingerprint(after_a_state) == 9101)
    assert(contest_state_last_provenance_id(after_a_state) == 9101)

    let provenance_c = record_observation_provenance(9102, 9201, 8100, 2, 9101)
    let observed_c = admit_contest_observation(
        504, after_a_state, family, probe_c, provenance_c, 650, 1000,
    )
    let after_c = update_proof_carrying_contest(
        702, 403, after_a_state, family, observed_c,
    )
    let identification = certify_finite_family_identification(801, after_c, family)
    assert(contest_transition_result_survivor_mask(after_c) == 8)
    assert(identification.selected_hypothesis_id == 113)
    assert(identification.evidence_count == 2)
    assert(identification.burden_spent == 7)
    assert(identification.provenance_fingerprint == 291233)
    assert(identification.identification_within_declared_family)
    assert(!identification.global_truth_established)
    assert(!identification.causal_mechanism_established)
    assert(!identification.clinical_authority)

    assert(policy.root_probe_index == 0)
    assert(policy.observation400_child_probe == 1)
    assert(policy.observation600_child_probe == 2)
    assert(policy.worst_case_burden == 7)
    assert(policy.preset_burden == 10)
    assert(policy.declared_policy_space_exhausted)
    assert(policy.bounded_minimax_optimal)
    assert(!policy.outside_declared_policy_space_optimality_claimed)
    assert(!policy.burden_is_subjective_suffering)
    let refused = refuse_insufficient_burden_budget(policy, 6)
    assert(refused.budget_insufficient)
    assert(!refused.experiment_authorized)

    let q0 = declare_contest_hypothesis(310, 0, 1)
    let q1 = declare_contest_hypothesis(311, 1, 1)
    let q2 = declare_contest_hypothesis(312, 2, 2)
    let q3 = declare_contest_hypothesis(313, 3, 2)
    let relabeled = declare_four_hypothesis_family(121, 8100, q0, q1, q2, q3)
    let relabel_control = certify_hypothesis_relabel_invariance(901, family, relabeled)
    assert(relabel_control.hypothesis_ids_distinct)
    assert(relabel_control.all_probe_predictions_equal)
    assert(relabel_control.partition_and_policy_invariant)

    let refutation_initial = begin_proof_carrying_contest(404, family)
    let provenance_b = record_observation_provenance(9103, 9201, 8100, 1, 0)
    let contradictory_b = admit_contest_observation(
        505, refutation_initial, family, probe_b, provenance_b, 700, 1000,
    )
    let after_contradiction = update_proof_carrying_contest(
        703, 405, refutation_initial, family, contradictory_b,
    )
    let refutation = certify_declared_family_refutation(802, after_contradiction, family)
    assert(refutation.survivor_count == 0)
    assert(refutation.family_refuted)
    assert(!refutation.reality_refuted)
    assert(!refutation.nearest_model_selected)
    assert(!refutation.clinical_authority)
}
