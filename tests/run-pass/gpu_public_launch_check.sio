//@ run-pass
//@ check-only
//@ requires: madaros

kernel fn gpu_public_launch_kernel(n: i64) -> () with GPU {
    let tid = gpu.thread_id.x
    if tid < n {
    }
}

fn main() -> i32 with GPU, IO {
    let grid = (1, 1, 1)
    let block = (64, 1, 1)

    perform GPU.launch(gpu_public_launch_kernel, grid, block)(64)
    perform GPU.sync()
    0
}
