//@ run-pass
// Regression test: nested &! struct-field store propagation (G1b).
//
// Bug: mutation of a nested struct field through an exclusive reference (&!Outer)
// was not propagating to the caller. o.inner.x = v inside the callee did not
// update the caller's struct because codegen for nested field path lowering
// through a &! deref was not emitting the correct store sequence.
//
// This is the G1b fixture. The single-level baseline is nested_mut_ref_baseline.sio.

struct Inner { x: i64, y: i64 }
struct Outer { name: i64, inner: Inner }

fn set_x(o: &!Outer, v: i64) with Mut { o.inner.x = v }

fn main() with IO, Mut, Panic {
    var o = Outer { name: 1, inner: Inner { x: 0, y: 0 } }
    set_x(&!o, 42)
    if o.inner.x != 42 { panic("FAIL") }
    println("OK")
}
