//@ run-pass
//@ timeout: 180
//@ expect-stdout-contains: CIRC28_DRUG_EVEROLIMUS_PASS
//
// Everolimus on the circ28 drug record with LOCAL saturable erythrocyte binding
// (stdlib/darwin_pbpk/circ28_drug_everolimus.sio; shared helpers in circ28_drug_sirolimus.sio). WHOLE-BLOOD
// concentrations, oral tablet. Parameter table, sources, access levels, status: header of the module.
//
// NO INTRAVENOUS HUMAN DATA: CL and V are apparent, F = 0.16 is declared (UNSOURCED here, u 0.05).
//
// FITTED (so NOT validations), one observable each:
//   CL/F   pooled k = 5, N = 70 (healthy, 2 mg, Kovarik abstracts)            -> hepatic clint (with F)
//   t1/2   pooled k = 5, N = 64 (the terminal volume Vz/F = CL/F t1/2/ln 2)   -> Kp scalar, BY SIMULATION
//          (no V_ss/F exists in any source opened: the half-life is therefore NOT a validation and the
//          input-consistency check is an identity, printed as such)
//   F      0.16 (declared)                                                    -> gut-wall clint
//   Tmax   1.5 h (label: 1 to 2 hours)                                        -> ka
// NOT FITTED: the ps scalar stays at the placeholder 1 (no rate observable found that leaves Cmax free).
// DERIVED: Bmax 3365 ng/mL RBC and Kd 527 ng/mL plasma from the label's 17 % -> 73 % (read as the plasma share
//   of the drug in blood, 5 -> 5000 ng/mL); ps_gut 11.33 L/h (tacrolimus surrogate).
//
// CRITERION: as in the sirolimus test (|z| <= 2 with an inter-individual SD; a stated fold otherwise; every row
// asserts a band around its measured outcome; CONSISTENCY marks a row whose study is inside a fitted pool).
//
// PREDICTIONS, written before ANY everolimus quantity was computed (nothing of this drug had been run; the
// sirolimus test had been run and its lessons are used: under a gut-only factor the Cmax ratio is well below
// the AUC ratio; the gut wall also clears arterial drug, so the liver alone cannot give large AUC ratios).
//   E0  pooled CL/F 18.4 L/h (u 0.95), pooled t1/2 33.0 h (u 2.3), Vz/F 877 L (hand arithmetic).
//   E1  fitted V_ss/F 780 L (650-860), i.e. V_ss/Vz 0.89 (0.75-0.98).
//   E2  Cmax 2 mg at the default ps: 6 ng/mL (3-12) against the pooled 17.8 (inter-individual SD about 6):
//       z -2.0, FAIL expected, at the edge. With the sirolimus ps scalar 0.138 transferred (WHAT-IF, E11):
//       13 ng/mL (8-18), z -0.8 PASS.
//   E3  AUC_inf 2 mg = D/(CL/F) = 108.5 ng h/mL within 3 % (CONSISTENCY).
//   E4  steady state 0.75 mg twice daily (20 doses): AUC(0-12) 40.7 (39-42), Cmax 4.5 ng/mL (3-7), trough 2.9
//       (2.3-3.3). Label Table 4 (kidney recipients WITH ciclosporin): AUC 75 +/- 31 (z -1.1 PASS), Cmax 11.1
//       +/- 4.6 (z -1.4 PASS); both low, as expected without ciclosporin. What-if x 2.68 (label: Neoral raises
//       the single-dose AUC by 168 % in healthy subjects): AUC 109, z +1.1 PASS.
//   E5  plasma share of the drug in blood at the 2 mg peak and at the steady-state trough 0.170-0.172; Afinitor
//       label "approximately 20 %": fold 1.25 PASS (ratio 0.86; CONSISTENCY, same label family as the derivation).
//       Share at 100 ng/mL over share at 5 ng/mL: 1.05 (1.02-1.10): "constant over 5-100 ug/L" (van Erp 2016,
//       secondary, via the dossier), criterion 0.80-1.25 PASS.
//   E6  dose linearity 0.75 to 10 mg: dose-normalised Cmax ratio 0.995 (0.97-1.0), AUC 0.998 (0.98-1.0).
//   E7  intravenous what-if: simulated F within 0.9-1.1 of 0.16.
//   E8  interaction WHAT-IFS (single 2 mg dose in all studies; factor solved for the AUC ratio in closed form;
//       the Cmax ratio is the prediction, fold 1.3; the half-life ratio CL/CL' is a second prediction, fold 1.25):
//         verapamil    AUC 3.5, Cmax 2.3, t1/2 x 1.16:  gut only: Cmax 2.0 (1.7-2.6) PASS; t1/2 x 1.08 PASS
//         erythromycin AUC 4.4, Cmax 2.0, t1/2 x 1.39:  gut only: Cmax 2.3 (1.9-3.0) PASS; t1/2 x 1.12 PASS (edge)
//         ciclosporin  AUC 2.68, Cmax 1.82, t1/2 unchanged: gut only: Cmax 1.8 (1.5-2.2) PASS; t1/2 x 1.05 PASS
//         ketoconazole AUC 15.0, Cmax 3.9, t1/2 x 1.9:  gut alone cannot reach it (ceiling about 9.3); gut fully
//                      inhibited + hepatic factor: Cmax 3.0 (2.4-3.6), ratio 0.77: PASS at the edge; t1/2 x 2.4
//                      (2.0-2.9): FAIL at the edge (1.27)
//         rifampicin   AUC 0.37, Cmax 0.42, t1/2 x 0.75: gut only: Cmax 0.47 (0.38-0.55) PASS, t1/2 x 1.0 FAIL (1.33);
//                      same factor on gut and liver: Cmax 0.62 FAIL; liver only: 0.85 FAIL
//   E9  single-ratio module: |dCmax| < 1 %, |dAUC(0-72)| < 0.5 % (the binding is nearly linear here).
//   E10 budget (2 mg): u(AUC)/AUC 0.052 (0.045-0.065), CL/F above 95 % of the variance; u(Cmax)/Cmax 0.5
//       (0.3-0.8), the ps scalar above 50 % of the variance.
//   E11 what-if record with the sirolimus ps scalar: see E2.
//
//   E11b (ADDED after the first run had shown E11 wrong, and written BEFORE E11b was run): the comparable quantity is
//       not the scalar but the blood-referred permeability ps/(bp Q): the exchange term is ps (C/bp - T/kp). The
//       sirolimus value 0.138 at bp 12.58 corresponds here (bp 3.33) to s = 0.138 x 3.33/12.58 = 0.0366. Prediction:
//       Cmax 2 mg 8 ng/mL (5-12), z -1.6 PASS (sirolimus: Cmax V_ss/F / D = 3.2; 3.2 x 2 mg / 776 L = 8.3).
// RESULTS: block at the end of this header, written after the first run; nothing above was edited after it.
//
// RESULTS (first complete run, 2026-11-15; bands of rows whose outcome differed from the prediction were set AFTER the run)
//   HIT:  E0 18.45 L/h, 33.0 h, Vz/F 879 L; E1 V_ss/F 829 L (V_ss/Vz 0.94); E2 Cmax 3.69 ng/mL against 17.8 +/- 6.1:
//         z -2.34 FAIL as predicted (value inside the stated 3-12, below the central 6); E3 108.4; E4 AUC 40.4 (z -1.12),
//         Cmax,ss 4.10 (z -1.52), trough 2.81, x 2.68: 108 (z +1.07); E5 share 0.170 (ratio 0.85), share(100)/share(5) 1.047;
//         E6 0.994 / 0.997; E7 1.0002; E8a verapamil Cmax 2.55 (ratio 1.11), t1/2 1.37 against 1.16 (ratio 1.19);
//         E8c ciclosporin Cmax 2.15 (ratio 1.18), t1/2 1.249 against 1.0 (PASS by 0.001 of the fold); E8e rifampicin gut only
//         Cmax 0.41 (ratio 0.97), liver only 0.87 FAIL; E9 dCmax -0.002 %, dAUC +0.009 %; E10 u(AUC)/AUC 0.0515 (CL/F 100 %).
//   MISSED:
//     E11 the sirolimus ps scalar 0.138 transferred: Cmax 4.41 (predicted 13): z -2.22 FAIL. The scalar is not the comparable
//       quantity (see E11b). E11b (s 0.0366, same ps/(bp Q)): Cmax 5.81 (predicted 8, inside 5-12), z -1.99: PASS by 0.01.
//       Even there Cmax is a third of the observed: the ka that keeps Tmax at 1.5 h falls with s (0.96, 0.85, 0.64 /h).
//     E10 u(Cmax)/Cmax 0.14 (predicted 0.5) and the ps scalar carries 0.5 % of var(Cmax) (predicted > 50 %): near s = 1 Cmax
//       does not depend on ps (dlnCmax/dlns -0.04). Shares: F 49 %, ka 29 %, logP 11 %, V_ss/F 9 %. The budget (14 %) does
//       not cover the Cmax discrepancy (a factor 4.8): the failure is structural, not parametric.
//     E8b erythromycin gut only: Cmax 2.91 against 2.0, ratio 1.46 FAIL (predicted 2.3 PASS); t1/2 1.50 against 1.39 PASS.
//     E8d ketoconazole: predicted NOT reachable by the gut wall alone (ceiling 9.3). WRONG: the ceiling is 70, because the
//       gut wall carries 91 % of the SYSTEMIC clearance in this record (Q_gut Eg = 2.70 of 2.95 L/h; Eh 0.0026). Gut-only
//       solution (g 0.053; no prediction existed): Cmax 4.76 against 3.9 PASS (ratio 1.22); half-life 3.08 against 1.9 FAIL.
//     E8e rifampicin: gut-only half-life 0.91 against 0.75 PASS (predicted FAIL); same factor on both: Cmax 0.45 PASS
//       (predicted 0.62 FAIL).
//   STRUCTURAL FINDING: with ps_gut 11.33 L/h and B:P 3.3 the closed-form fit exists only for a declared F >= 0.148
//     (F = 0.16, u 0.05): the gut wall alone nearly exhausts CL(blood) = F CL/F. Printed by the test (S2).
//   WHICH NEED THE GUT PATHWAY: all; the liver alone cannot raise the AUC by more than 10 % (ceiling 1.097).
//   COMPILER (not fixed, worked around): three segmentation faults of the compiled test on the Madaros local build (a pool
//     struct declared late in main; three drug records in main; a record built in a helper function); lean_single: ka
//     solved inside a module function after record writes is wrong (0.9334 for 0.9572), the first read of a rewritten
//     record is stale, a budget called from a section function is off by 2.4 %. See the notes at each workaround.
//   RUNTIME: compiled 3.3 s.
//
// COMPILER WORKAROUNDS: as in the sirolimus test (big structs first in main, a discarded warm-up run on the
// fresh stepper, one run per helper function).
//
// Marker CIRC28_DRUG_EVEROLIMUS_PASS.

//
// =====================================================================================================================
// ROUND (transit): transit input + gut-Kp test, 2026-11-15.  PRE-REGISTERED: written before ANY run of this test with the
// transit input (only `souc check` had been run on the new code). Sirolimus ran first in this round; its results are used.
// =====================================================================================================================
// CHANGES: the oral input is an Erlang chain of 4 stages (n = 3 transit compartments DECLARED, +1 for the Savic convention
// with Ka = Ktr; no sourced n for everolimus: the Djebli 2006 value is a sirolimus k; MTT = 4/k). k (CD_KA, per stage) is refitted
// to the same pooled Tmax 1.5 h (the label's 1-2 h); tlag 0 (no sourced lag). Cmax, Cmax/AUC and MTT are VALIDATION rows.
// COLUMNS: A = all-organ Kp scalar (the record so far); B = gut wall at its Rodgers-Rowland Kp (circ28_drug_params_theta_gutrr,
// V_ss/F scalar refitted with the same half-life). B is adopted only if (i) Cmax(2 mg) AND Cmax,ss are higher in B, (ii)
// |dAUC_inf| < 13 % (the sirolimus verdict-log rule, same number), (iii) no row passes in A and fails in B.
// LABELLED DIAGNOSTICS (nothing adopted from them without its own observable):
//   D-E1  Dose/Cmax of the 2 mg arm: 112 L observed (2 mg / 17.8 ng/mL), 448 L modelled in round 1 (blood). Which ps scalar
//         would it need, is that physical (ps/(bp Q) = 20 s/bp per organ), and does a sourced RATE observable exist for it?
//   D-E2  F = 0.16 is UNSOURCED (a further search found no source); sensitivity of V_ss/F, Cmax, AUC_inf, Fg, Eh to F = 0.20, 0.30.
// PREDICTIONS (numbers; a miss is recorded, never erased):
//   T1  fitted k (A) 2.6 /h (1.9-3.5), MTT 1.5 h (1.1-2.1): with ps = 1 the distribution is fast, Tmax is set by the input; the
//       Erlang-4 input rate peaks at 3/k, the blood peak about 0.3 h later.
//   T2  Cmax 2 mg (A) 4.5 ng/mL (3.8-5.5) against 3.69 (first order, round 1); z about -2.2: FAIL still (observed 17.8 +/- 6.1).
//   T3  Column B: k 2.8 (2.0-3.8), Cmax 2 mg 4.6 (3.8-5.8), higher than A by less than 10 %; V_ss/F 810 (740-900).
//   T4  AUC_inf 2 mg = D/(CL/F) within 1 % in both columns (E3 PASS); t1/2 of the run = pooled t1/2 within 0.5 %.
//   T5  steady state 0.75 mg bid: AUC(0-12) 40.5 (39-42); Cmax,ss 4.8 (4.0-6.0), E4b z between -1.6 and -1.0 PASS; trough 2.8 (2.5-3.2).
//   T6  Cmax/AUC_inf (A) 0.042 (0.035-0.050) against the pooled 17.8/(2000/18.45) = 0.164: FAIL (ratio 0.26).
//   T7  DECISION: B is NOT adopted (at least one PASS -> FAIL flip, in the interaction rows: the gut Kp enters the gut-wall
//       inhibition rows). Verdicts changing A (old round-1 -> new): E8b erythromycin G Cmax stays FAIL; E8c half-life ratio
//       (PASS by 0.001 of the fold in round 1) flips to FAIL with probability 0.4; all others unchanged.
//   T8  D-E1: Cmax(2 mg) at s = 0.0366 (same ps/(bp Q) as sirolimus) 6.8 ng/mL (5.5-8.5) (round 1: 5.81, first order); at s = 0.01
//       8.0 (6.0-10); at s = 0.001 9.5 (7-13). The observed 17.8 is NOT reached for any s >= 0.001: the scalar it would need
//       (below 1e-3, ps/(bp Q) < 0.006) is not physical (the organs would be almost isolated) and the closed-form fit
//       exists only for s above a bound. NO sourced rate observable for everolimus exists in the abstracts opened
//       (no Q or V2, no alpha phase, no 24 h concentration): the ps scalar stays 1 and the rows are diagnostics.
//   T9  D-E2: F = 0.30 against 0.16: V_ss/F falls (the fit needs hepatic clint > 0 for F >= 0.148); Cmax(2 mg) within +/-15 %,
//       AUC_inf unchanged (it is D/(CL/F)); Fg 0.16/(1 - Eh) rises; Eh rises with F. F stays UNSOURCED.
// RESULTS OF THE ROUND (TRANSIT), first complete run 2026-11-15; written after it, nothing in the pre-registration above was
// edited. Bands of rows whose outcome differed from the prediction were set AFTER the run, around the measured value.
//   Fits. A: k 3.959 /h per stage (u 0.79), MTT 4/k 1.01 h, V_ss/F 828.8 L, Kp scalar 0.0381, gut-wall Kp 6.6. B: the record does
//   NOT reproduce the Tmax observable: k ends at its bound 10 /h with Tmax 4.03 h (gut-wall Kp 173: the gut tissue releases the
//   absorbed drug slowly whatever the chain rate), V_ss/F 1142 L, the half-life check 31.4 h against 33.0 (5 %).
//   HIT:  T2 Cmax 2 mg A 4.66 (4.5, 3.8-5.5), z -2.18 FAIL; T4 AUC_inf A and B within 5e-4 of D/(CL/F), t1/2 of the A run within
//         6e-6; T5 AUC(0-12),ss 40.37, Cmax,ss 4.46, trough 2.80, E4b z -1.44 PASS; T6 Cmax/AUC_inf A 0.0430 (0.035-0.050), FAIL ratio
//         0.26; T7 B NOT adopted, E8b stays FAIL; T9 hepatic clint > 0 from F 0.148, Fg and Eh rise with F (F 0.30: Fg 0.311, Eh
//         0.034), V_ss/F falls (772 L), AUC_inf unchanged (108.4).
//   MISSED: T1 k A 3.96 (predicted 2.6, 1.9-3.5), MTT 1.01 h (predicted 1.5, 1.1-2.1); T3 column B: k 10 (bound; predicted 2.8),
//         Cmax 2.54 (predicted 4.6 and higher than A: it is LOWER, 0.54 x A), V_ss/F 1142 (predicted 810); T4 t1/2 of B 31.4 h (5 % off);
//         T7 the PASS -> FAIL flips are NOT in the interaction rows (B's interaction rows are not run: its Tmax fit fails): they
//         are E1 (V_ss/F 1142 L) and the Tmax row (4.03 h); E8c half-life ratio did not flip (1.249 against fold 1.25, PASS by 0.001);
//         T8 Cmax 2 mg at s = 0.0366: 8.79 (predicted 6.8, 5.5-8.5), at s = 0.01: 15.98 (predicted 8.0, 6-10), at s = 0.001: 30.7
//         (predicted 9.5, 7-13). The sentence "the observed 17.8 is NOT reached for any s >= 0.001" is WRONG: Cmax 17.8 lies between
//         s = 0.01 and 0.001. T9 Cmax(2 mg) at F 0.30: 5.94 against 4.66 at F 0.16 (+27 %, predicted within +/-15 %).
//   D-E1 (diagnostic; the ps scalar is NOT adopted): s = 0.01 (ps/(bp Q) = 20 s/bp = 0.06, i.e. about 6 % extraction per pass in every
//         organ; sirolimus R24 fit: 0.45) gives Dose/Cmax 125 L against 112 L observed (z -0.31), but the V_ss/F fitted to the half-life
//         falls from 829 to 375 L (the terminal phase becomes permeability-limited) and Vz/F, the only volume observable, is 879 L;
//         at s = 0.001 the half-life fit ends at its lower bound (t1/2 53 h, V_ss/F 176 L): invalid record. s = 0.0366 (the sirolimus
//         ps/(bp Q) of the first-order round): Cmax 8.79, z -1.50, PASS, Dose/Cmax 228 L. A scalar that reproduces Dose/Cmax is a fit of a
//         RATE parameter to a VOLUME-type observable (rule: tissue ps only to a rate observable). No sourced rate observable exists
//         for everolimus in the abstracts opened (no Q or V2, no alpha phase, no 24 h concentration): not adopted, s stays 1.
//   D-E2 (diagnostic): declared F 0.16 stays UNSOURCED (a further search found no source). Closed form: the hepatic clint is positive for
//         every F from 0.15 to 0.30 (3.3 L/h at 0.16, 14.8 at 0.20, 44.5 at 0.30). Cmax(2 mg) 4.66 (F 0.16) -> 5.94 (F 0.30), AUC_inf
//         unchanged, F carries 53 % of var(Cmax) in the budget. A defect of this module found in the round: a record refitted at s = 1
//         after a what-if kept the earlier ps scalar (the first F runs, F 0.20 and 0.30, were made on a record that still carried
//         s = 0.001: AUC_inf 157 and 275 instead of 108); fixed in evr_drug_into_gfu, the F row now runs on a clean record.
//   Verdicts in A, old (first-order record) -> new: none changed (E2a FAIL z -2.18, E8b erythromycin Cmax FAIL, E8d ketoconazole half-life
//         FAIL, E8e rifampicin H FAIL; the other rows PASS as before). New rows: Cmax/AUC_inf FAIL (0.0430 against 0.1646), Tmax PASS.
//   Column B against A, rows compared (the first 14): PASS in A and FAIL in B: E1, Tmax. Decision: B NOT adopted; evr_gut() = 0.
//   REMAINING FAILURES: Cmax 2 mg (z -2.18, ratio 0.26), Cmax/AUC_inf (0.26), E8b erythromycin Cmax, E8d ketoconazole t1/2, E8e
//         rifampicin H, E10 u(Cmax)/Cmax 0.14 (budget does not cover the Cmax gap: structural), E10 ps share in var(Cmax) 0.6 %.
//   RUNTIME: compiled 4.2-4.8 s (original single-column test 3.0-3.2 s on the same machine and session): column B skips the numerical
//         checks and, because its Tmax fit fails, the interaction rows; the what-if records use short 4 h runs.

use darwin_pbpk::circ28::*
use darwin_pbpk::circ28_kp::*
use darwin_pbpk::circ28_drug::*
use darwin_pbpk::circ28_blood::*
use darwin_pbpk::circ28_nl::*
use darwin_pbpk::circ28_drug_sirolimus::*
use darwin_pbpk::circ28_drug_everolimus::*
use math::pure::{exp, ln}

fn et_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn et_rel(tag: string, got: f64, want: f64, tol: f64) -> i32 with IO, Mut, Div, Panic {
    let r = et_abs(got - want) / et_abs(want)
    print("  "); print(tag); print(": got "); print(got); print(" want "); print(want)
    print("  rel = "); println(r)
    if !(r <= tol) {
        println("  [FAIL]")
        return 1
    }
    return 0
}

// One validation row. sd > 0: |z| <= 2; sd = 0: within `fold`. expect 1 pass, 0 fail. band_lo..band_hi bound
// z (sd > 0) or the ratio pred/obs (sd = 0). Returns 1 if the test must fail.
fn et_row(ct: &![i32; 100], tag: string, pred: f64, obs: f64, sd: f64, fold: f64, expect: i32, band_lo: f64, band_hi: f64) -> i32 with IO, Mut, Div, Panic {
    var stat = pred / obs
    var pass = false
    if sd > 0.0 {
        stat = (pred - obs) / sd
        pass = et_abs(stat) <= 2.0
    } else {
        pass = stat <= fold && stat >= 1.0 / fold
    }
    print("  "); print(tag); print(": predicted "); print(pred); print("  observed "); print(obs)
    print("  ratio "); print(pred / obs)
    if sd > 0.0 {
        print("  z "); print(stat)
    }
    if pass { print("  PASS") } else { print("  FAIL") }
    // verdict log of this column (ct[0] = rows so far, ct[1 + i] = 1 when row i passes); ct[99] = 1: the column is the
    // ADOPTED one and its bands are asserted; 0: printed only (the verdicts are compared in main)
    let ri = ct[0]
    if ri < 90 {
        ct[1 + ri] = 0
        if pass { ct[1 + ri] = 1 }
    }
    ct[0] = ri + 1
    var bad = 0
    if ct[99] == 1 {
        if stat < band_lo || stat > band_hi {
            print("  [outside the asserted band]")
            bad = 1
        }
        if expect == 1 && !pass {
            print("  [expected pass]")
            bad = 1
        }
        if expect == 0 && pass {
            print("  [expected fail]")
            bad = 1
        }
    }
    println("")
    return bad
}

fn et_rname(i: i32) -> string {
    if i == 0 { return "MW" }
    if i == 1 { return "logP" }
    if i == 2 { return "pKa1" }
    if i == 3 { return "pKa2" }
    if i == 4 { return "ion class" }
    if i == 5 { return "fu" }
    if i == 6 { return "B:P at C_ref" }
    if i == 7 { return "clint (hep)" }
    if i == 8 { return "clform" }
    if i == 9 { return "clint (gut)" }
    if i == 10 { return "cl renal" }
    if i == 11 { return "cl plasma" }
    if i == 12 { return "Kp scalar" }
    if i == 13 { return "ps scalar" }
    if i == 14 { return "ka" }
    if i == 15 { return "fa" }
    if i == 16 { return "tlag" }
    return "ps gut"
}

fn et_bname(i: i32) -> string {
    if i == 0 { return "logP" }
    if i == 1 { return "fu" }
    if i == 2 { return "Hct" }
    if i == 3 { return "Bmax" }
    if i == 4 { return "Kd" }
    if i == 5 { return "ps_gut" }
    if i == 6 { return "fa" }
    if i == 7 { return "V_ss/F (from t1/2)" }
    if i == 8 { return "CL/F obs" }
    if i == 9 { return "F" }
    if i == 10 { return "ka" }
    return "ps scalar"
}

fn et_theta(d: &Circ28Drug, gs: f64, hs: f64) -> [f64; 18] with Mut, Div, Panic, Epistemic {
    var th: [f64; 18] = [0.0; 18]
    var i: i32 = 0
    while i < 18 {
        th[i] = circ28_drug_value(d, i)
        i = i + 1
    }
    th[CD_CLGUT] = th[CD_CLGUT] * gs
    th[CD_CLINT] = th[CD_CLINT] * hs
    return th
}

// Single oral dose on the standard grid (240 h).
fn et_oral(d: &Circ28Drug, gut: i32, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, 1.0, 1.0), gut)
    var dc = evr_cfg_n(dose, 240.0, evr_ntr())
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    return mtor_run(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysn)
}

fn et_oral_fine(d: &Circ28Drug, gut: i32, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, 1.0, 1.0), gut)
    var dc = evr_cfg_n(dose, 240.0, evr_ntr())
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt1 = 0.05
    dc.dt2 = 0.25
    dc.dt3 = 4.0
    return mtor_run(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysn)
}

// Budget grid: 0.2 h to 3 h, 3 h to 24 h, 8 h to 240 h.
fn et_cfg_budget(d: &Circ28Drug, dose: f64) -> MtorDose with Mut, Div, Panic, Epistemic {
    var dc = evr_cfg_n(dose, 240.0, evr_ntr())
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt1 = 0.2
    dc.dt2 = 3.0
    return dc
}

fn et_oral_budget_grid(d: &Circ28Drug, gut: i32, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, 1.0, 1.0), gut)
    let dc = et_cfg_budget(d, dose)
    return mtor_run(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysn)
}

// 4 h run (Cmax only) with scaled clearances.
fn et_oral_short(d: &Circ28Drug, gut: i32, dose: f64, gs: f64, hs: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, gs, hs), gut)
    var dc = mtor_cfg_oral(dose, 4.0, 100.0, 200.0)
    dc.ntr = evr_ntr()
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    return mtor_run(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysn)
}

// Steady state: 20 doses, one every 12 h (7 half-lives); grid 0.25 h to 3 h, 3 h to 12 h; last interval recorded.
fn et_ss(d: &Circ28Drug, gut: i32, dose: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, 1.0, 1.0), gut)
    var dc = mtor_cfg_oral(dose, 12.0, 100.0, 200.0)
    dc.ntr = evr_ntr()
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.ndose = 20
    dc.tau = 12.0
    dc.dt1 = 0.25
    dc.dt2 = 3.0
    dc.dt3 = 3.0
    return mtor_run(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysn)
}

// Intravenous what-if: 0.5 mg over 2 h.
fn et_iv(d: &Circ28Drug, gut: i32, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, 1.0, 1.0), gut)
    var dc = evr_cfg(0.5, 240.0)
    dc.route = 0
    dc.t_inf = 2.0
    return mtor_run(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysn)
}

fn et_cmp_cfg(d: &Circ28Drug, t_end: f64) -> MtorDose with Mut, Div, Panic, Epistemic {
    var dc = mtor_cfg_oral(2.0, t_end, 100.0, 200.0)
    dc.ntr = evr_ntr()
    dc.ka = circ28_drug_value(d, CD_KA)
    dc.fa = circ28_drug_value(d, CD_FA)
    dc.dt2 = 1.0
    dc.t2 = t_end
    dc.dt3 = 1.0
    return dc
}

fn et_cmp_nl(d: &Circ28Drug, gut: i32, t_end: f64, sysn: &!Nl28Sys) -> MtorRun with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, 1.0, 1.0), gut)
    let dc = et_cmp_cfg(d, t_end)
    return mtor_run(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysn)
}

fn et_cmp_single(d: &Circ28Drug, gut: i32, sysc: &!Circ28Sys) -> MtorSingle with Mut, Div, Panic, Epistemic {
    let p = mtor_params(et_theta(d, 1.0, 1.0), gut)
    let dc = et_cmp_cfg(d, 72.0)
    return mtor_run_single(p, mtor_hct(), evr_bmax(), evr_kd(), dc, sysc)
}

fn et_print_run(tag: string, r: &MtorRun) with IO, Mut, Div {
    print("  "); print(tag)
    print(": Cmax "); print(1000.0 * (*r).cmax); print(" ng/mL  Tmax "); print((*r).tmax)
    print(" h  C24 "); print(1000.0 * (*r).c24); print("  AUCinf "); print(1000.0 * (*r).auc_inf)
    print("  t1/2 "); print((*r).thalf); print(" h  bal "); print((*r).balance_err)
    print("  fails "); println((*r).nfail)
}

// Pooled observed Cmax (ng/mL) after 2 mg: mean, pooled inter-individual SD, u of the mean. In helper functions: a
// MtorPool declared late in the large main crashed the compiled test (segmentation fault, Madaros local build,
// 2026-11-15); the same code in a function works.
fn et_cm_mean() -> f64 with Mut, Div {
    var pc = mtor_pool_zero()
    evr_pool_cmax(&!pc)
    return 1000.0 * mtor_pool_mean(&pc)
}
fn et_cm_sd() -> f64 with Mut, Div {
    var pc = mtor_pool_zero()
    evr_pool_cmax(&!pc)
    return 1000.0 * mtor_pool_se(&pc) * cd_sqrt(62.0)
}
fn et_cm_u() -> f64 with Mut, Div {
    var pc = mtor_pool_zero()
    evr_pool_cmax(&!pc)
    return 1000.0 * mtor_pool_u(&pc)
}

fn et_sec_pool(ct: &![i32; 100], vssf: f64) -> i32 with IO, Mut, Div, Panic {
    var fails: i32 = 0
    println("S0 pooled observables (n-weighted mean; u = max(pooled standard error, between-study SD/sqrt k))")
    var a = mtor_pool_zero()
    evr_pool_clf(&!a)
    print("  CL/F (L/h), k = 5, N = 70: 22.22 (n 12), 17.24 (16), 17.39 (16), 17.54 (18), 19.4 (8): mean ")
    print(mtor_pool_mean(&a)); print("  pooled SE "); print(mtor_pool_se(&a)); print("  between/sqrt k "); print(mtor_pool_between(&a)); print("  u "); println(mtor_pool_u(&a))
    let m_hand = (12.0 * (2.0 / 0.090) + 16.0 * (2.0 / 0.116) + 16.0 * (2.0 / 0.115) + 18.0 * (2.0 / 0.114) + 8.0 * 19.4) / 70.0
    fails = fails + et_rel("guard: pooled CL/F mean, second computation", evr_obs_clf(), m_hand, 1.0e-12)
    var c = mtor_pool_zero()
    evr_pool_thalf(&!c)
    print("  t1/2 (h), k = 5, N = 64: 30, 32, 32, 43, 32: mean "); print(mtor_pool_mean(&c)); print("  pooled SE "); print(mtor_pool_se(&c)); print("  between/sqrt k "); print(mtor_pool_between(&c)); print("  u "); println(mtor_pool_u(&c))
    fails = fails + et_rel("guard: pooled t1/2 mean, second computation", evr_obs_thalf(), (12.0 * 30.0 + 16.0 * 32.0 + 16.0 * 32.0 + 8.0 * 43.0 + 12.0 * 32.0) / 64.0, 1.0e-12)
    fails = fails + et_row(ct, "E0 pooled CL/F (L/h)  pred 18.4", evr_obs_clf(), 18.4, 0.0, 1.02, 1, 0.98, 1.02)
    fails = fails + et_row(ct, "E0 pooled t1/2 (h)  pred 33.0  ", evr_obs_thalf(), 33.0, 0.0, 1.02, 1, 0.98, 1.02)
    println("S0b input-consistency check: DEGENERATE for this drug (declared)")
    print("  the only volume observable is Vz/F = (CL/F) t1/2/ln2 = "); print(evr_vzf()); println(" L, so V ln2/CL = t1/2 identically;")
    print("  the model's V_ss/F fitted to that half-life is "); print(vssf); print(" L: V_ss ln2/CL = "); print(vssf * 0.6931471805599453 / evr_obs_clf())
    print(" h against t1/2 "); print(evr_obs_thalf()); println(" h (a MODEL output, not an input check)")
    print("  patients on ciclosporin (label, NOT pooled): Vz/F 342 L, CL/F 8.8 L/h -> "); print(342.0 * 0.6931471805599453 / 8.8); println(" h against their 30 h")
    fails = fails + et_row(ct, "E1 fitted V_ss/F (L)  pred 780 (650-860)", vssf, 780.0, 0.0, 1.2, 1, 0.83, 1.11)
    return fails
}

// Smallest declared F for which the closed-form fit exists (hepatic clint > 0), V_ss/F and CL/F held: the gut wall
// clears arterial drug too (Q_gut Eg), and the hepatic clearance is what is left of CL(blood) = F CL/F.
fn et_f_min(th0: [f64; 18], vssf: f64, gut: i32) -> f64 with Mut, Div, Panic {
    var lo = 0.02
    var hi = 0.16
    var k: i32 = 0
    while k < 40 {
        let f = 0.5 * (lo + hi)
        let o = MtorObs { hct: mtor_hct(), bmax: evr_bmax(), kd: evr_kd(), vss: f * vssf, cl: f * evr_obs_clf(), f: f, cref: evr_cref() }
        let t = mtor_fit_g(th0, o, gut)
        if t[CD_CLINT] > 0.0 {
            hi = f
        } else {
            lo = f
        }
        k = k + 1
    }
    return hi
}

fn et_sec_fit(d: &Circ28Drug, gut: i32, vssf: f64, sysn: &!Nl28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S1 parameter record (value, standard uncertainty, status)")
    var i: i32 = 0
    while i < 18 {
        print("  "); print(i); print(" "); print(et_rname(i)); print("  value "); print(circ28_drug_value(d, i))
        print("  u "); print(cd_sqrt(circ28_drug_variance(d, i))); print("  status "); println((*d).status[i])
        i = i + 1
    }
    print("  binding (derived from the label endpoints): Bmax "); print(1000.0 * evr_bmax()); print(" ng/mL RBC, Kd "); print(1000.0 * evr_kd()); println(" ng/mL plasma (u 30 % each)")
    println("S2 the fits and derivations reproduce their inputs (these are NOT validations)")
    let hct = mtor_hct()
    let cp5 = nl28_plasma(hct, evr_bmax(), evr_kd(), 0.005)
    let cp5000 = nl28_plasma(hct, evr_bmax(), evr_kd(), 5.0)
    fails = fails + et_rel("plasma share at 5 ng/mL = 0.17 (derivation check)", (1.0 - hct) * cp5 / 0.005, 0.17, 1.0e-9)
    fails = fails + et_rel("plasma share at 5000 ng/mL = 0.73 (derivation check)", (1.0 - hct) * cp5000 / 5.0, 0.73, 1.0e-9)
    let o = evr_obs_at(vssf)
    let th = et_theta(d, 1.0, 1.0)
    let p = mtor_params(th, gut)
    print("  C_ref (ng/mL) "); print(1000.0 * o.cref); print("  bp_ref "); println(circ28_drug_value(d, CD_BP))
    fails = fails + et_rel("blood CL (L/h) = F x pooled CL/F", circ28_splanchnic_clearance(p), o.cl, 1.0e-9)
    let fcl = circ28_drug_value(d, CD_FA) * circ28_gut_availability(p) * (1.0 - circ28_hepatic_extraction(p))
    fails = fails + et_rel("F = fa Fg (1 - Eh) = 0.16", fcl, 0.16, 1.0e-9)
    print("  Fg "); print(circ28_gut_availability(p)); print("  Eh "); print(circ28_hepatic_extraction(p)); print("  Eg "); println(circ28_gut_extraction(p))
    print("  share of the systemic blood clearance carried by the gut wall, Q_gut Eg / CL: "); println(p.q[8] * circ28_gut_extraction(p) / o.cl)
    print("  the closed-form fit exists (hepatic clint > 0) only for a declared F above "); println(et_f_min(th, vssf, gut))
    let tm = mtor_tmax_at_n(p, o.hct, o.bmax, o.kd, 2.0, th[CD_FA], th[CD_KA], evr_ntr(), sysn)
    fails = fails + et_rel("Tmax at the record (fit check)", tm, evr_obs_tmax(), 1.0e-2)
    return fails
}

fn et_ddi(tag: string, d: &Circ28Drug, gut: i32, mode: i32, ra: f64, cbase: f64, sysn: &!Nl28Sys) -> f64 with IO, Mut, Div, Panic, Epistemic {
    let th = et_theta(d, 1.0, 1.0)
    let x = mtor_ddi_solve(th, mode, ra)
    print("  "); print(tag); print(": AUC ratio target "); print(ra)
    if x < 0.0 {
        println("  NOT REACHABLE")
        return 0.0 - 1.0
    }
    var g = x
    var h = 1.0
    if mode == 1 {
        g = 1.0
        h = x
    }
    if mode == 2 { h = x }
    if mode == 3 {
        g = 0.0
        h = x
    }
    let r = et_oral_short(d, gut, 2.0, g, h, sysn)
    print("  factor "); print(x); print("  AUC ratio closed form "); print(mtor_auc_ratio(th, g, h))
    print("  t1/2 ratio CL/CL' "); print(1.0 / mtor_cl_ratio(th, g, h)); print("  Cmax ratio simulated "); println(r.cmax / cbase)
    return r.cmax / cbase
}

fn et_unreach(tag: string, x: f64) -> i32 with IO, Mut, Div, Panic {
    if x < 0.0 {
        print("  "); print(tag); println(": not reachable, as asserted")
        return 0
    }
    print("  "); print(tag); println(": [FAIL] expected NOT reachable")
    return 1
}

fn et_sec_ddi(d: &Circ28Drug, gut: i32, ct: &![i32; 100], sysn: &!Nl28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("V8 interaction WHAT-IFS (single 2 mg dose; factor solved for the observed AUC ratio; Cmax ratio fold 1.3, half-life ratio fold 1.25)")
    println("   G: gut-wall clint x g, liver unchanged.  H: hepatic clint x h, gut unchanged.")
    let rb = et_oral_short(d, gut, 2.0, 1.0, 1.0, sysn)
    let cb = rb.cmax
    let th = et_theta(d, 1.0, 1.0)
    print("  ceilings of the AUC ratio: gut wall fully inhibited "); print(mtor_auc_ratio(th, 0.0, 1.0)); print(";  liver fully inhibited "); println(mtor_auc_ratio(th, 1.0, 0.0))
    let vg = et_ddi("verapamil G   ", d, gut, 0, 3.5, cb, sysn)
    let gv = mtor_ddi_solve(th, 0, 3.5)
    fails = fails + et_row(ct, "E8a verapamil G Cmax ratio  obs 2.3 (90 % CI 1.9-2.7)   pred 2.0", vg, 2.3, 0.0, 1.3, 1, 0.77, 1.3)
    fails = fails + et_row(ct, "E8a verapamil G t1/2 ratio  obs 37/32 = 1.16           pred 1.08", 1.0 / mtor_cl_ratio(th, gv, 1.0), 37.0 / 32.0, 0.0, 1.25, 1, 1.1, 1.25)
    let eg = et_ddi("erythromycin G", d, gut, 0, 4.4, cb, sysn)
    let ge = mtor_ddi_solve(th, 0, 4.4)
    fails = fails + et_row(ct, "E8b erythromycin G Cmax ratio  obs 2.0 (90 % CI 1.8-2.3)  pred 2.3", eg, 2.0, 0.0, 1.3, 0, 1.3001, 1.6)
    fails = fails + et_row(ct, "E8b erythromycin G t1/2 ratio  obs 44/32 = 1.39          pred 1.12", 1.0 / mtor_cl_ratio(th, ge, 1.0), 44.0 / 32.0, 0.0, 1.25, 1, 0.8, 1.25)
    let cg = et_ddi("ciclosporin G ", d, gut, 0, 2.68, cb, sysn)
    let gc = mtor_ddi_solve(th, 0, 2.68)
    fails = fails + et_row(ct, "E8c ciclosporin G Cmax ratio  obs 1.82                    pred 1.8", cg, 1.82, 0.0, 1.3, 1, 0.77, 1.3)
    fails = fails + et_row(ct, "E8c ciclosporin G t1/2 ratio  obs 1.0 (unchanged)         pred 1.05", 1.0 / mtor_cl_ratio(th, gc, 1.0), 1.0, 0.0, 1.25, 1, 1.2, 1.25)
    // E8d: the header predicted that the gut wall alone could NOT reach AUC x 15 (ceiling 9.3). WRONG: the ceiling is 70,
    // because in this record the gut wall carries 91 % of the SYSTEMIC clearance (Q_gut Eg against CL). The mixed row of
    // the header (gut fully inhibited + a hepatic factor) is meaningless here (it needs hepatic INDUCTION x 4.7; first
    // run: Cmax ratio 5.77, half-life ratio 2.43) and is replaced by the gut-only solution, for which no prediction existed.
    let kg = et_ddi("ketoconazole G", d, gut, 0, 15.0, cb, sysn)
    let gk = mtor_ddi_solve(th, 0, 15.0)
    if !(kg > 0.0) {
        println("  [FAIL] ketoconazole G must be reachable (ceiling 70)")
        fails = fails + 1
    }
    fails = fails + et_row(ct, "E8d ketoconazole G Cmax ratio  obs 3.9 (90 % CI 3.4-4.6)  (no prediction)", kg, 3.9, 0.0, 1.3, 1, 1.1, 1.3)
    fails = fails + et_row(ct, "E8d ketoconazole G t1/2 ratio  obs 1.9                    (no prediction)", 1.0 / mtor_cl_ratio(th, gk, 1.0), 1.9, 0.0, 1.25, 0, 1.5, 1.75)
    let rg = et_ddi("rifampicin G  ", d, gut, 0, 0.37, cb, sysn)
    let gr = mtor_ddi_solve(th, 0, 0.37)
    let rr = et_ddi("rifampicin, same factor on gut and liver", d, gut, 2, 0.37, cb, sysn)
    let rh = et_ddi("rifampicin H  ", d, gut, 1, 0.37, cb, sysn)
    fails = fails + et_row(ct, "E8e rifampicin G Cmax ratio  obs 0.42                     pred 0.47", rg, 0.42, 0.0, 1.3, 1, 0.77, 1.3)
    fails = fails + et_row(ct, "E8e rifampicin G t1/2 ratio  obs 24/32 = 0.75             pred 1.0", 1.0 / mtor_cl_ratio(th, gr, 1.0), 0.75, 0.0, 1.25, 1, 1.15, 1.25)
    fails = fails + et_row(ct, "E8e rifampicin both Cmax ratio  obs 0.42                  pred 0.62", rr, 0.42, 0.0, 1.3, 1, 1.0, 1.15)
    fails = fails + et_row(ct, "E8e rifampicin H Cmax ratio  obs 0.42                     pred 0.85", rh, 0.42, 0.0, 1.3, 0, 1.3001, 2.4)
    return fails
}

fn et_sec_cmp(d: &Circ28Drug, gut: i32, sysn: &!Nl28Sys, sysc: &!Circ28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("V9 single-ratio module (circ28_blood) against the local stepper, same parameters and grid, 2 mg")
    let cw = et_cmp_nl(d, gut, 12.0, sysn)
    let cn = et_cmp_nl(d, gut, 72.0, sysn)
    let cs = et_cmp_single(d, gut, sysc)
    print("  Cmax local "); print(1000.0 * cn.cmax); print("  single-ratio "); print(1000.0 * cs.cmax); print("  dCmax "); print(100.0 * (cs.cmax - cn.cmax) / cn.cmax); println(" %")
    print("  AUC(0-72) local "); print(1000.0 * cn.auc_t); print("  single-ratio "); print(1000.0 * cs.auc_t); print("  dAUC "); print(100.0 * (cs.auc_t - cn.auc_t) / cn.auc_t); println(" %")
    print("  single-ratio bp range used "); print(cs.bp_min); print(" - "); println(cs.bp_max)
    if !(et_abs(cs.cmax - cn.cmax) / cn.cmax < 0.01) {
        println("  [FAIL] |dCmax|/Cmax >= 1 %")
        fails = fails + 1
    }
    if !(et_abs(cs.auc_t - cn.auc_t) / cn.auc_t < 0.005) {
        println("  [FAIL] |dAUC|/AUC >= 0.5 %")
        fails = fails + 1
    }
    return fails
}

// The budget itself is computed in main (one frame less): called from this section function, lean_single returned a
// base run off by 2e-4 (sirolimus) and 2.4 % (everolimus), measured 2026-11-15; from main it agrees with Madaros.
fn et_sec_budget(ct: &![i32; 100], thb: [f64; 18], uka: f64, auc_std: f64, cmax_std: f64, rbp: &MtorRun, budp: &MtorBudget, u_v: f64, vssf: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    println("S4 uncertainty budget with refit, 2 mg oral (twelve inputs; closed-form fits redone at every perturbation; the")
    println("   V_ss/F fitted to the half-life enters as an input with the u propagated from u(t1/2))")
    fails = fails + et_rel("budget grid AUC_inf against the standard grid", (*rbp).auc_inf, auc_std, 5.0e-3)
    fails = fails + et_rel("budget grid Cmax against the standard grid", (*rbp).cmax, cmax_std, 1.0e-2)
    let z0 = evr_z0(thb, vssf)
    let u = evr_u_all(u_v, uka)
    print("  runs "); println((*budp).runs)
    print("  AUC_inf "); print((*budp).auc * 1000.0); print(" ng h/mL  u "); print(cd_sqrt((*budp).var_auc) * 1000.0); print("  (rel "); print(cd_sqrt((*budp).var_auc) / (*budp).auc); println(")")
    print("  Cmax    "); print((*budp).cmax * 1000.0); print(" ng/mL    u "); print(cd_sqrt((*budp).var_cmax) * 1000.0); print("  (rel "); print(cd_sqrt((*budp).var_cmax) / (*budp).cmax); println(")")
    println("  input       u          dlnAUC/dlnx   share of var(AUC) %   dlnCmax/dlnx  share of var(Cmax) %")
    var j: i32 = 0
    var sh_a = 0.0
    var sh_c = 0.0
    while j < 12 {
        let la = (*budp).sens_auc[j] * z0[j] / (*budp).auc
        let lc = (*budp).sens_cmax[j] * z0[j] / (*budp).cmax
        print("  "); print(et_bname(j)); print("   "); print(u[j]); print("   "); print(la); print("   "); print(100.0 * (*budp).contrib_auc[j] / (*budp).var_auc)
        print("   "); print(lc); print("   "); println(100.0 * (*budp).contrib_cmax[j] / (*budp).var_cmax)
        sh_a = sh_a + (*budp).contrib_auc[j] / (*budp).var_auc
        sh_c = sh_c + (*budp).contrib_cmax[j] / (*budp).var_cmax
        j = j + 1
    }
    fails = fails + et_rel("budget AUC = the 2 mg run (same grid, refit path)", (*budp).auc, (*rbp).auc_inf, 1.0e-6)
    fails = fails + et_rel("shares of var(AUC) add to 1", sh_a, 1.0, 1.0e-9)
    fails = fails + et_rel("shares of var(Cmax) add to 1", sh_c, 1.0, 1.0e-9)
    fails = fails + et_row(ct, "E10 u(AUC)/AUC   predicted 0.052 (0.045-0.065)", cd_sqrt((*budp).var_auc) / (*budp).auc, 0.052, 0.0, 1.25, 1, 0.8, 1.25)
    fails = fails + et_row(ct, "E10 u(Cmax)/Cmax predicted 0.5 (0.3-0.8)      ", cd_sqrt((*budp).var_cmax) / (*budp).cmax, 0.5, 0.0, 1.6, 0, 0.2, 0.35)
    fails = fails + et_row(ct, "E10 share of the ps scalar in var(Cmax)  predicted > 0.5", (*budp).contrib_cmax[11] / (*budp).var_cmax, 0.75, 0.0, 1.5, 0, 0.0, 0.03)
    return fails
}


// ---- one column: everything that depends on the gut variant (gut 0 = A, 1 = B) ------------------------------------------
// res: 0 Cmax 2 mg, 1 AUC_inf 2 mg, 2 t1/2, 3 Cmax,ss, 4 AUC(0-12),ss, 5 trough,ss, 6 B:P peak, 7 Tmax, 8 Cmax/AUC_inf,
//      9 k, 10 MTT, 11 V_ss/F, 12 gut-wall Kp, 13 Kp scalar, 14 simulated F, 15 Fg, 16 Eh, 17 |E8 rows| unused
fn et_col(d: &Circ28Drug, gut: i32, ct: &![i32; 100], res: &![f64; 40], vssf: f64, cm_obs: f64, cm_sd: f64, sysn: &!Nl28Sys, sysc: &!Circ28Sys) -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    let warm = et_oral_short(d, gut, 2.0, 1.0, 1.0, sysn)
    if gut == 0 { fails = fails + et_sec_cmp(d, gut, sysn, sysc) }
    fails = fails + et_sec_pool(ct, vssf)
    fails = fails + et_sec_fit(d, gut, vssf, sysn)

    println("R runs (whole blood; venous pool)")
    let r2 = et_oral(d, gut, 2.0, sysn)
    et_print_run("oral 2 mg ", &r2)
    var r2f = r2
    if gut == 0 {
        r2f = et_oral_fine(d, gut, 2.0, sysn)
        et_print_run("oral 2 mg, grid refined (numerical check, column A only)", &r2f)
    }
    let r075 = et_oral(d, gut, 0.75, sysn)
    et_print_run("oral 0.75 mg", &r075)
    let r10 = et_oral(d, gut, 10.0, sysn)
    et_print_run("oral 10 mg", &r10)
    let riv = et_iv(d, gut, sysn)
    et_print_run("IV what-if 0.5 mg over 2 h", &riv)
    let rss = et_ss(d, gut, 0.75, sysn)
    print("  steady state 0.75 mg twice daily, dose 20: Cmax "); print(1000.0 * rss.cmax); print(" ng/mL  Tmax "); print(rss.tmax); print(" h  trough C(12) "); print(1000.0 * rss.c_tau)
    print("  AUC(0-12) "); print(1000.0 * rss.auc_tau); print("  bal "); println(rss.balance_err)

    println("C numerical checks")
    fails = fails + et_rel("mass balance oral 2 mg", r2.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + et_rel("mass balance 10 mg", r10.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + et_rel("mass balance IV", riv.balance_err + 1.0, 1.0, 1.0e-9)
    fails = fails + et_rel("mass balance steady state", rss.balance_err + 1.0, 1.0, 1.0e-9)
    if !(r2.ok && r2f.ok && r10.ok && r075.ok && riv.ok && rss.ok && warm.ok) {
        println("  [FAIL] a run did not complete")
        fails = fails + 1
    }
    if !(r2.nfail == 0 && r10.nfail == 0 && rss.nfail == 0) {
        println("  [FAIL] failed Newton steps")
        fails = fails + 1
    }
    if !(r2.fit_ok && r10.fit_ok && riv.fit_ok) {
        println("  [FAIL] terminal fit not valid")
        fails = fails + 1
    }
    if gut == 0 {
        fails = fails + et_rel("grid refinement: Cmax", r2f.cmax, r2.cmax, 5.0e-3)
        fails = fails + et_rel("grid refinement: AUC_inf", r2f.auc_inf, r2.auc_inf, 5.0e-3)
        fails = fails + et_rel("grid refinement: t1/2", r2f.thalf, r2.thalf, 1.0e-2)
    }
    fails = fails + et_rel("t1/2 of the 2 mg run = pooled t1/2 (FIT CHECK, not a validation)", r2.thalf, evr_obs_thalf(), 5.0e-3)

    println("V validation, predicted against observed (whole blood)")
    fails = fails + et_row(ct, "E2a Cmax 2 mg (ng/mL)  pooled healthy, default ps        pred 4.5 (3.8-5.5)", 1000.0 * r2.cmax, cm_obs, cm_sd, 0.0, 0, -3.0, -2.0001)
    fails = fails + et_rel("E3 AUC_inf 2 mg against D/(CL/F) (the fit; CONSISTENCY)", r2.auc_inf, 2.0 / evr_obs_clf(), 3.0e-2)
    println("  steady state 0.75 mg twice daily against label Table 4 (kidney recipients WITH ciclosporin)")
    fails = fails + et_row(ct, "E4a AUC(0-12),ss (ng h/mL)  label 75 +/- 31              pred 40.5", 1000.0 * rss.auc_tau, 75.0, 31.0, 0.0, 1, -1.4, -0.8)
    fails = fails + et_row(ct, "E4b Cmax,ss (ng/mL)  label 11.1 +/- 4.6                  pred 4.8 (4.0-6.0)", 1000.0 * rss.cmax, 11.1, 4.6, 0.0, 1, -2.0, -0.8)
    fails = fails + et_row(ct, "E4c what-if AUC x 2.68 (ciclosporin, label)  75 +/- 31   pred 109", 2680.0 * rss.auc_tau, 75.0, 31.0, 0.0, 1, 0.8, 1.4)
    print("  trough C(12),ss "); print(1000.0 * rss.c_tau); println(" ng/mL (label target range with ciclosporin 3-8 ng/mL; pred 2.8)")
    println("V5 plasma share of the drug in blood, (1 - Hct)/B:P, venous pool")
    let hct = mtor_hct()
    let sh_peak = (1.0 - hct) / r2.bp_peak
    let sh_trough = (1.0 - hct) / rss.bp_end
    print("  at the 2 mg peak "); print(sh_peak); print("  at the steady-state trough "); print(sh_trough); print("  (B:P "); print(r2.bp_peak); print(" and "); print(rss.bp_end); println(")")
    fails = fails + et_row(ct, "E5a plasma share at the trough  Afinitor label about 0.20, fold 1.25 (CONSISTENCY)", sh_trough, 0.20, 0.0, 1.25, 1, 0.8, 0.95)
    let s5 = (1.0 - hct) / nl28_bp_local(hct, evr_bmax(), evr_kd(), 0.005)
    let s100 = (1.0 - hct) / nl28_bp_local(hct, evr_bmax(), evr_kd(), 0.100)
    fails = fails + et_row(ct, "E5b share(100 ng/mL)/share(5 ng/mL)  constant 5-100 (van Erp, secondary), 0.80-1.25", s100 / s5, 1.0, 0.0, 1.25, 1, 1.0, 1.12)
    println("V6 dose linearity (label: proportional 0.5-2 mg twice daily; single doses 0.75 and 2.5 mg linear)")
    fails = fails + et_row(ct, "E6a Cmax(10)/Cmax(0.75) dose-normalised  pred 0.995", (r10.cmax / 10.0) / (r075.cmax / 0.75), 1.0, 0.0, 1.25, 1, 0.97, 1.0)
    fails = fails + et_row(ct, "E6b AUC_inf(10)/AUC_inf(0.75) dose-normalised  pred 0.998", (r10.auc_inf / 10.0) / (r075.auc_inf / 0.75), 1.0, 0.0, 1.25, 1, 0.98, 1.0)
    println("V7 intravenous what-if (no observation exists)")
    let f_sim = (r2.auc_inf / 2.0) / (riv.auc_inf / 0.5)
    let th = et_theta(d, 1.0, 1.0)
    let p = mtor_params(th, gut)
    print("  simulated F "); print(f_sim); print("  IV CL (L/h) "); print(0.5 / riv.auc_inf); print("  V_ss by NCA (L blood) "); print(riv.vss_nca); print("  Fh "); println(1.0 - circ28_hepatic_extraction(p))
    fails = fails + et_row(ct, "E7 simulated F / 0.16", f_sim, 0.16, 0.0, 1.1, 1, 0.9, 1.1)

    println("V12 shape and input-rate rows (transit input)")
    let kfit = circ28_drug_value(d, CD_KA)
    print("  fitted k (1/h) "); print(kfit); print("  stages "); print(evr_ntr()); print("  MTT = stages/k (h) "); println((evr_ntr() as f64) / kfit)
    fails = fails + et_row(ct, "E12a Cmax/AUC_inf 2 mg (1/h)  pooled Cmax 17.8 over D/(CL/F), fold 1.3", r2.cmax / r2.auc_inf, (cm_obs / 1000.0) / (2.0 / evr_obs_clf()), 0.0, 1.3, 0, 0.0, 10.0)
    fails = fails + et_row(ct, "E12b Tmax 2 mg (h)  label 1-2 h, pooled 1.5 +/- 0.29 (CONSISTENCY: the fitted observable)", r2.tmax, 1.5, 0.29, 0.0, 1, -10.0, 10.0)
    res[0] = 1000.0 * r2.cmax
    res[1] = 1000.0 * r2.auc_inf
    res[2] = r2.thalf
    res[3] = 1000.0 * rss.cmax
    res[4] = 1000.0 * rss.auc_tau
    res[5] = 1000.0 * rss.c_tau
    res[6] = r2.bp_peak
    res[7] = r2.tmax
    res[8] = r2.cmax / r2.auc_inf
    res[9] = kfit
    res[10] = (evr_ntr() as f64) / kfit
    res[11] = vssf
    res[12] = p.kp[8]
    res[13] = circ28_drug_value(d, CD_KPSC)
    res[14] = f_sim
    res[15] = circ28_gut_availability(p)
    res[16] = circ28_hepatic_extraction(p)
    // a column whose record does not reproduce its own fitted observable (Tmax) is not run through the interaction rows
    if et_abs(r2.tmax - evr_obs_tmax()) < 0.05 {
        fails = fails + et_sec_ddi(d, gut, ct, sysn)
    } else {
        println("V8 interaction what-ifs NOT run for this column: the record does not reproduce Tmax 1.5 h (fit bound reached); no decision depends on them")
    }
    return fails
}

fn et_cmp_cols(ra: &[f64; 40], rb: &[f64; 40], cta: &[i32; 100], ctb: &[i32; 100]) -> i32 with IO, Mut, Div, Panic {
    println("COLUMNS A (all-organ Kp scalar) against B (gut wall at its Rodgers-Rowland Kp), everything refitted")
    println("  quantity                         A            B")
    print("  Cmax 2 mg (ng/mL)                "); print((*ra)[0]); print("   "); println((*rb)[0])
    print("  AUC_inf 2 mg (ng h/mL)           "); print((*ra)[1]); print("   "); println((*rb)[1])
    print("  t1/2 2 mg (h)                    "); print((*ra)[2]); print("   "); println((*rb)[2])
    print("  Cmax,ss 0.75 mg bid (ng/mL)      "); print((*ra)[3]); print("   "); println((*rb)[3])
    print("  AUC(0-12),ss (ng h/mL)           "); print((*ra)[4]); print("   "); println((*rb)[4])
    print("  trough ss (ng/mL)                "); print((*ra)[5]); print("   "); println((*rb)[5])
    print("  B:P at the 2 mg peak             "); print((*ra)[6]); print("   "); println((*rb)[6])
    print("  Tmax 2 mg (h)                    "); print((*ra)[7]); print("   "); println((*rb)[7])
    print("  Cmax/AUC_inf 2 mg (1/h)          "); print((*ra)[8]); print("   "); println((*rb)[8])
    print("  fitted k per stage (1/h)         "); print((*ra)[9]); print("   "); println((*rb)[9])
    print("  MTT = stages/k (h)               "); print((*ra)[10]); print("   "); println((*rb)[10])
    print("  V_ss/F fitted to t1/2 (L)        "); print((*ra)[11]); print("   "); println((*rb)[11])
    print("  gut-wall Kp                      "); print((*ra)[12]); print("   "); println((*rb)[12])
    print("  Kp scalar                        "); print((*ra)[13]); print("   "); println((*rb)[13])
    print("  simulated F                      "); print((*ra)[14]); print("   "); println((*rb)[14])
    print("  Fg, Eh                           "); print((*ra)[15]); print(" "); print((*ra)[16]); print("   "); print((*rb)[15]); print(" "); println((*rb)[16])
    var flips = 0
    var gains = 0
    var i: i32 = 0
    while i < (*cta)[0] && i < (*ctb)[0] && i < 90 {
        if (*cta)[1 + i] == 1 && (*ctb)[1 + i] == 0 {
            flips = flips + 1
            print("  PASS in A, FAIL in B: row "); println(i)
        }
        if (*cta)[1 + i] == 0 && (*ctb)[1 + i] == 1 {
            gains = gains + 1
            print("  FAIL in A, PASS in B: row "); println(i)
        }
        i = i + 1
    }
    print("  rows logged A "); print((*cta)[0]); print(", B "); print((*ctb)[0]); print(" (the interaction rows are not run for a column whose Tmax fit fails; rows compared: the first "); print((*ctb)[0]); print(")  PASS in A and FAIL in B: "); print(flips); print("  FAIL in A and PASS in B: "); println(gains)
    let c1 = (*rb)[0] > (*ra)[0] && (*rb)[3] > (*ra)[3]
    let dauc = et_abs((*rb)[1] / (*ra)[1] - 1.0)
    let c2 = dauc < 0.13
    let c3 = flips == 0
    print("  rule (i) Cmax and Cmax,ss of B higher: "); print(c1); print("   (ii) |dAUC| "); print(dauc); print(" < 0.13: "); print(c2); print("   (iii) no PASS -> FAIL: "); println(c3)
    var adopt = 0
    if c1 && c2 && c3 { adopt = 1 }
    print("  DECISION: gut variant adopted = "); println(adopt)
    return adopt
}

// the record at ps scalar s and declared F f, ka refitted to Tmax (in main-like straight line), one 2 mg run
fn et_whatif(d: &!Circ28Drug, tag: string, s: f64, f: f64, full: i32, gut: i32, sysr: &!Nl28Sys, sysn: &!Nl28Sys, cm_obs: f64, cm_sd: f64, ct: &![i32; 100], expect: i32, band_lo: f64, band_hi: f64) -> i32 with IO, Mut, Div, Panic, Epistemic {
    let fw = evr_drug_into_gfu(d, s, evr_ntr(), gut, f, 0, sysr)
    let thk = circ28_drug_theta(d)
    let pk = mtor_params(thk, gut)
    let ka = mtor_ka_solve_n(pk, mtor_hct(), evr_bmax(), evr_kd(), 2.0, thk[CD_FA], evr_obs_tmax(), 0.05, 10.0, evr_ntr(), sysr)
    evr_ka_set_g(d, ka, evr_ntr(), gut, sysr)
    var r = et_oral_short(d, gut, 2.0, 1.0, 1.0, sysn)
    if full == 1 { r = et_oral(d, gut, 2.0, sysn) }
    if full == 1 {
        et_print_run(tag, &r)
    } else {
        print("  "); print(tag); print(": Cmax (4 h run) "); print(1000.0 * r.cmax); print(" ng/mL  Tmax "); println(r.tmax)
    }
    let th = et_theta(d, 1.0, 1.0)
    let p = mtor_params(th, gut)
    print("    s "); print(s); print("  F "); print(f); print("  fitted V_ss/F "); print(fw.vssf); print(" L  k "); print(ka)
    print("  Dose/Cmax (blood, L) "); print(2.0 / r.cmax); print("  ps/(bp Q) = 20 s/bp "); print(20.0 * s / circ28_drug_value(d, CD_BP))
    print("  Fg "); print(circ28_gut_availability(p)); print("  Eh "); println(circ28_hepatic_extraction(p))
    if full == 1 { print("    AUC_inf (ng h/mL) "); println(1000.0 * r.auc_inf) }
    if mtor_abs(fw.vssf - 0.2 * evr_vzf()) < 1.0e-6 { println("    [the half-life fit ended at its lower bound 0.2 Vz/F: the pooled t1/2 is NOT reproduced by this record]") }
    if !r.ok { return 1 }
    return et_row(ct, tag, 1000.0 * r.cmax, cm_obs, cm_sd, 0.0, expect, band_lo, band_hi)
}


// D-E2, closed form only (no run): for declared F the hepatic clint left after the gut wall, the blood clearance the record
// reaches against its target F x pooled CL/F, and Fg, Eh; V_ss/F held at the fitted value of the record.
fn et_f_scan(th0: [f64; 18], vssf: f64, gut: i32) -> i32 with IO, Mut, Div, Panic, Epistemic {
    println("  D-E2 closed-form scan of the declared F (V_ss/F held at the record's value; no run)")
    var fails: i32 = 0
    var i: i32 = 0
    while i < 6 {
        var f = 0.15
        if i == 1 { f = 0.16 }
        if i == 2 { f = 0.17 }
        if i == 3 { f = 0.18 }
        if i == 4 { f = 0.20 }
        if i == 5 { f = 0.30 }
        let o = evr_obs_at_f(vssf, f)
        let t = mtor_fit_g(th0, o, gut)
        let p = mtor_params(t, gut)
        let cl = circ28_splanchnic_clearance(p)
        print("    F "); print(f); print("  hepatic clint (L/h) "); print(t[CD_CLINT]); print("  blood CL reached/target "); print(cl / o.cl)
        print("  Fg "); print(circ28_gut_availability(p)); print("  Eh "); println(circ28_hepatic_extraction(p))
        i = i + 1
    }
    return fails
}

fn et_pick(a: [f64; 18], b: [f64; 18], g: i32) -> [f64; 18] {
    if g == 1 { return b }
    return a
}

fn et_pickf(a: f64, b: f64, g: i32) -> f64 {
    if g == 1 { return b }
    return a
}

fn main() -> i32 with IO, Mut, Div, Panic, Epistemic {
    var fails: i32 = 0
    var sysr = nl28_sys_zero()
    var sysn = nl28_sys_zero()
    var sysc = circ28_sys_zero()
    var da = circ28_drug_new()
    var db = circ28_drug_new()
    // records: V_ss/F fitted to the half-life by simulation, then k (per stage) by a Tmax solve written here in main
    // (the lean_single workaround of the module header), for each gut variant
    let fita = evr_drug_into_g(&!da, 1.0, evr_ntr(), 0, &!sysr)
    let thka = circ28_drug_theta(&da)
    let pka = mtor_params(thka, 0)
    let kaa = mtor_ka_solve_n(pka, mtor_hct(), evr_bmax(), evr_kd(), 2.0, thka[CD_FA], evr_obs_tmax(), 0.05, 10.0, evr_ntr(), &!sysr)
    evr_ka_set_g(&!da, kaa, evr_ntr(), 0, &!sysr)
    let fitb = evr_drug_into_g(&!db, 1.0, evr_ntr(), 1, &!sysr)
    let thkb = circ28_drug_theta(&db)
    let pkb = mtor_params(thkb, 1)
    let kab = mtor_ka_solve_n(pkb, mtor_hct(), evr_bmax(), evr_kd(), 2.0, thkb[CD_FA], evr_obs_tmax(), 0.05, 10.0, evr_ntr(), &!sysr)
    evr_ka_set_g(&!db, kab, evr_ntr(), 1, &!sysr)
    var cta: [i32; 100] = [0; 100]
    var ctb: [i32; 100] = [0; 100]
    var ra: [f64; 40] = [0.0; 40]
    var rb: [f64; 40] = [0.0; 40]
    cta[99] = 0
    ctb[99] = 0
    if evr_gut() == 0 { cta[99] = 1 } else { ctb[99] = 1 }
    let cm_obs = et_cm_mean()
    let cm_sd = et_cm_sd()
    print("  pooled observed Cmax 2 mg (k = 4, N = 62): mean "); print(cm_obs); print(" ng/mL, pooled inter-individual SD "); print(cm_sd); print(", u of the mean "); println(et_cm_u())
    println("=== COLUMN A: all-organ Kp scalar, 4 stages ===")
    let fca = et_col(&da, 0, &!cta, &!ra, fita.vssf, cm_obs, cm_sd, &!sysn, &!sysc)
    if evr_gut() == 0 { fails = fails + fca }
    println("=== COLUMN B: gut wall at its Rodgers-Rowland Kp, 4 stages ===")
    let fcb = et_col(&db, 1, &!ctb, &!rb, fitb.vssf, cm_obs, cm_sd, &!sysn, &!sysc)
    if evr_gut() == 1 { fails = fails + fcb }
    let adopt = et_cmp_cols(&ra, &rb, &cta, &ctb)
    if adopt != evr_gut() {
        println("  [FAIL] the decision made by the rule differs from evr_gut() declared in the module")
        fails = fails + 1
    }
    // budget of the ADOPTED record, in main (see the workaround note at et_sec_budget)
    let g = evr_gut()
    let tha = et_theta(&da, 1.0, 1.0)
    let thb2 = et_theta(&db, 1.0, 1.0)
    let thb = et_pick(tha, thb2, g)
    let uka = et_pickf(cd_sqrt(circ28_drug_variance(&da, CD_KA)), cd_sqrt(circ28_drug_variance(&db, CD_KA)), g)
    let uvs = et_pickf(fita.u_vssf, fitb.u_vssf, g)
    let vss = et_pickf(fita.vssf, fitb.vssf, g)
    var rbg = et_oral_budget_grid(&da, 0, 2.0, &!sysn)
    if g == 1 { rbg = et_oral_budget_grid(&db, 1, 2.0, &!sysn) }
    let bud = mtor_budget_g(evr_z0(thb, vss), evr_u_all(uvs, uka), thb, evr_cref(), et_cfg_budget(&da, 2.0), g, &!sysn)
    var ctd: [i32; 100] = [0; 100]
    ctd[99] = 1
    fails = fails + et_sec_budget(&!ctd, thb, uka, 0.001 * et_pickf(ra[1], rb[1], g), 0.001 * et_pickf(ra[0], rb[0], g), &rbg, &bud, uvs, vss)
    // WHAT-IF records and diagnostics, LAST: the record da is refitted (three separate records in a main, or a record built
    // in a helper function, crashed the compiled test: segmentation fault, Madaros local build, 2026-11-15). Each refit is
    // followed by one dropped short run (lean_single: the first read of a rewritten record is stale).
    var ctw: [i32; 100] = [0; 100]
    ctw[99] = 1
    println("D-E2 (first, on the unrefitted record)")
    fails = fails + et_f_scan(thb, vss, g)
    println("V11 WHAT-IF records on the adopted gut variant (the ps scalar and F are NOT fitted: diagnostics, not validations)")
    println("D-E1 ps scalar scan: Dose/Cmax observed 2 mg / 17.8 ng/mL = 112 L")
    fails = fails + et_whatif(&!da, "E11b ps scalar 0.0366 (same ps/(bp Q) as sirolimus), oral 2 mg", 0.138 * 3.33 / 12.58, 0.16, 0, g, &!sysr, &!sysn, cm_obs, cm_sd, &!ctw, 1, -1.7, -1.3)
    fails = fails + et_whatif(&!da, "D-E1 ps scalar 0.01, oral 2 mg", 0.01, 0.16, 0, g, &!sysr, &!sysn, cm_obs, cm_sd, &!ctw, 1, -0.5, -0.1)
    fails = fails + et_whatif(&!da, "D-E1 ps scalar 0.001, oral 2 mg", 0.001, 0.16, 0, g, &!sysr, &!sysn, cm_obs, cm_sd, &!ctw, 0, 2.0001, 2.3)
    println("D-E2 declared F sensitivity (UNSOURCED F = 0.16; the closed-form fit needs F above the printed minimum)")
    fails = fails + et_whatif(&!da, "D-E2 F = 0.30, oral 2 mg", 1.0, 0.30, 1, g, &!sysr, &!sysn, cm_obs, cm_sd, &!ctw, 1, -2.0, -1.9)
    if fails == 0 {
        println("CIRC28_DRUG_EVEROLIMUS_PASS")
        return 0
    }
    println("CIRC28_DRUG_EVEROLIMUS_FAIL")
    return 1
}
