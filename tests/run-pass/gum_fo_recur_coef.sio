//@ run-pass
//@ requires: madaros
//@ expect-stdout: g0 0.090000
//@ expect-stdout: g2 7.290000
//@ expect-stdout: g12 25418658283.290001
//@ expect-stdout: gneg 0.090000
//@ expect-stdout: RECUR_COEF_OK
// a = 5 +- 0.3, var = 0.09.
// grow(a, n) = 3^n * a for n >= 0. n = 2 is 9^2 * 0.09.
// n = 12 is 531441^2 * 0.09.

fn grow(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        3.0 * grow(x, n - 1)
    }
}

fn main() -> i64 with IO, Epistemic {
    let k: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let a = k.value
    let g0 = variance_of(grow(a, 0))
    let g2 = variance_of(grow(a, 2))
    let g12 = variance_of(grow(a, 12))
    let gneg = variance_of(grow(a, 0 - 2))
    print("g0 ")
    print_f64(g0)
    println("")
    print("g2 ")
    print_f64(g2)
    println("")
    print("g12 ")
    print_f64(g12)
    println("")
    print("gneg ")
    print_f64(gneg)
    println("")
    var fails: i64 = 0
    if g0 < 0.089999 || g0 > 0.090001 { fails = fails + 1 }
    if g2 < 7.289999 || g2 > 7.290001 { fails = fails + 1 }
    if g12 < 25418658283.0 || g12 > 25418658284.0 { fails = fails + 1 }
    if gneg < 0.089999 || gneg > 0.090001 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_COEF_OK")
        0
    } else {
        println("RECUR_COEF_FAIL")
        1
    }
}
