//@ run-pass
// Epistemic kernel with Knowledge<f64> parameter triggers is_epistemic_kernel
// detection in the self-hosted checker. The --epistemic GPU pipeline generates
// shadow registers for uncertainty propagation.

kernel fn epistemic_add(n: i64, eps: Knowledge<f64>) -> () with GPU, Div {
    var i: i64 = 0
    while i < n {
        let x = 1.0 + 2.0
        i = i + 1
    }
}

fn main() -> i32 with IO {
    0
}
