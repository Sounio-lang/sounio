//@ run-pass
//@ expect-stdout: NESTED_READ_INDEX_CAST_OK
fn main() -> i32 with IO, Alloc, Mut, Div, Panic {
 let data = heap_alloc(16) as *mut f64
 let indices = heap_alloc(8) as *mut f64
 write_f64(data,0,10.0)
 write_f64(data,1,20.0)
 write_f64(indices,0,1.0)
 let value=read_f64(data,read_f64(indices,0) as i64)
 if value!=20.0 {return 21}
 heap_free(indices as *mut i8)
 heap_free(data as *mut i8)
 print("NESTED_READ_INDEX_CAST_OK\n")
 return 0
}
