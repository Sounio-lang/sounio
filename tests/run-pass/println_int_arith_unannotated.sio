//@ run-pass
// Residual: unannotated `let y = x + 1; println(y)` and `println(x + 1)`.
// Without positive kind-1 on Binary, Madaros routes through print_str → SEGV.
//
// Expected:
//   42
//   42
//   42
//   PASS

fn show_arith(x: i64) with IO {
    let y = x + 1
    println(y)
}

fn show_binop(x: i64) with IO {
    println(x + 1)
}

fn main() -> i64 with IO {
    show_arith(41)
    show_binop(41)
    let a = 20
    let b = a + 22
    println(b)
    println("PASS")
    0
}
