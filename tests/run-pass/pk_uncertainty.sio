//@ run-pass
// PK Domain Uncertainty Plugin Test Suite
//
// Validates WS2 Track 5 — PK-specific uncertainty analysis:
//   1.  Clearance dominance detection (CL contributes >70%)
//   2.  Volume dominance detection (V contributes most)
//   3.  Balanced contributions (no single dominant)
//   4.  SCr as proxy for clearance (Cockcroft-Gault scenario)
//   5.  Sensitivity index S_Ti > 0.7 triggers clearance dominance flag
//   6.  PK recommendations: clearance dominant -> TDM
//   7.  PK recommendations: absorption dominant -> bioequivalence
//   8.  Clinical significance: uncertainty > therapeutic window
//   9.  Clinical significance: uncertainty < therapeutic window
//  10.  Edge case: single parameter is 100% dominant
//  11.  Recommendation for SCr dominant -> cystatin C
//  12.  Sensitivity indices sum to 1.0
//
// Reference: Saltelli et al. (2008), FDA PopPK Guidance (2022)

// ============================================================================
// HELPERS
// ============================================================================

fn abs_val(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sqrt_val(x: f64) -> f64 with Div {
    if x <= 0.0 { return 0.0 }
    var guess = x / 2.0
    if guess < 0.001 { guess = 0.001 }
    var i = 0
    while i < 30 {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

// ============================================================================
// FLAT PKProfile STRUCT
// No nested structs — all parameter data in flat arrays.
// ============================================================================

struct PKProfile {
    n_params: i64,
    p_code: [i64; 8],
    p_value: [f64; 8],
    p_std_uncert: [f64; 8],
    p_sensitivity: [f64; 8],
    p_contribution: [f64; 8],
    p_source_type: [i64; 8],
    combined_variance: f64,
    combined_std_uncert: f64,
    clearance_contribution: f64,
    volume_contribution: f64,
    absorption_contribution: f64,
    is_cl_dominant: i64,
    dominant_idx: i64,
    dominant_pct: f64,
    r0: i64,
    r1: i64,
    r2: i64,
    r3: i64,
    n_rec: i64
}

fn empty_profile() -> PKProfile {
    PKProfile {
        n_params: 0,
        p_code: [0; 8],
        p_value: [0.0; 8],
        p_std_uncert: [0.0; 8],
        p_sensitivity: [0.0; 8],
        p_contribution: [0.0; 8],
        p_source_type: [0; 8],
        combined_variance: 0.0,
        combined_std_uncert: 0.0,
        clearance_contribution: 0.0,
        volume_contribution: 0.0,
        absorption_contribution: 0.0,
        is_cl_dominant: 0,
        dominant_idx: 0,
        dominant_pct: 0.0,
        r0: 0, r1: 0, r2: 0, r3: 0,
        n_rec: 0
    }
}

fn set_param(profile: PKProfile, idx: i64, code: i64, value: f64, std_uncert: f64, sensitivity: f64, source_type: i64) -> PKProfile with Mut {
    var r = profile
    let contrib = sensitivity * sensitivity * std_uncert * std_uncert
    r.p_code[idx as usize] = code
    r.p_value[idx as usize] = value
    r.p_std_uncert[idx as usize] = std_uncert
    r.p_sensitivity[idx as usize] = sensitivity
    r.p_contribution[idx as usize] = contrib
    r.p_source_type[idx as usize] = source_type
    return r
}

// ============================================================================
// FLAT PKSens STRUCT
// ============================================================================

struct PKSens {
    s_ti: [f64; 8],
    s_i: [f64; 8],
    n_params: i64,
    dom_idx: i64,
    dom_s_ti: f64,
    cl_dominant: i64
}

fn empty_sens() -> PKSens {
    PKSens {
        s_ti: [0.0; 8],
        s_i: [0.0; 8],
        n_params: 0,
        dom_idx: 0,
        dom_s_ti: 0.0,
        cl_dominant: 0
    }
}

// ============================================================================
// PARAMETER CLASSIFICATION
// ============================================================================

fn is_cl(code: i64) -> bool {
    if code == 0 { return true }
    if code == 3 { return true }
    if code == 7 { return true }
    if code == 6 { return true }
    return false
}

fn is_vol(code: i64) -> bool {
    if code == 1 { return true }
    if code == 6 { return true }
    return false
}

fn is_abs(code: i64) -> bool {
    if code == 2 { return true }
    if code == 4 { return true }
    return false
}

// ============================================================================
// ANALYSIS FUNCTIONS
// ============================================================================

fn compute_contributions(profile: PKProfile, n: i64) -> PKProfile with Mut, Div {
    var r = profile
    r.n_params = n

    var total: f64 = 0.0
    var i = 0
    while i < n {
        total = total + r.p_contribution[i as usize]
        i = i + 1
    }

    r.combined_variance = total
    r.combined_std_uncert = sqrt_val(total)

    if total < 1.0e-15 {
        return r
    }

    var cl: f64 = 0.0
    var v: f64 = 0.0
    var ab: f64 = 0.0
    var best_idx = 0
    var best_pct: f64 = 0.0

    i = 0
    while i < n {
        let contrib = r.p_contribution[i as usize]
        let code = r.p_code[i as usize]
        let pct = 100.0 * contrib / total

        if pct > best_pct {
            best_pct = pct
            best_idx = i
        }
        if is_cl(code) { cl = cl + pct }
        if is_vol(code) { v = v + pct }
        if is_abs(code) { ab = ab + pct }

        i = i + 1
    }

    r.clearance_contribution = cl
    r.volume_contribution = v
    r.absorption_contribution = ab
    r.dominant_idx = best_idx
    r.dominant_pct = best_pct

    if cl > 70.0 {
        r.is_cl_dominant = 1
    } else {
        r.is_cl_dominant = 0
    }

    return r
}

fn compute_sensitivity(profile: PKProfile, n: i64) -> PKSens with Mut, Div {
    var r = empty_sens()
    r.n_params = n

    var total: f64 = 0.0
    var i = 0
    while i < n {
        total = total + profile.p_contribution[i as usize]
        i = i + 1
    }

    if total < 1.0e-15 {
        return r
    }

    var best_idx = 0
    var best_s_ti: f64 = 0.0

    i = 0
    while i < n {
        let s_ti = profile.p_contribution[i as usize] / total
        r.s_ti[i as usize] = s_ti
        r.s_i[i as usize] = s_ti
        if s_ti > best_s_ti {
            best_s_ti = s_ti
            best_idx = i
        }
        i = i + 1
    }

    r.dom_idx = best_idx
    r.dom_s_ti = best_s_ti

    var cl_total: f64 = 0.0
    i = 0
    while i < n {
        if is_cl(profile.p_code[i as usize]) {
            cl_total = cl_total + profile.p_contribution[i as usize] / total
        }
        i = i + 1
    }

    if cl_total > 0.7 {
        r.cl_dominant = 1
    } else {
        r.cl_dominant = 0
    }

    return r
}

fn generate_rec(profile: PKProfile) -> PKProfile with Mut, Div {
    var r = profile
    var n_rec = 0

    if profile.is_cl_dominant != 0 {
        if n_rec == 0 { r.r0 = 10 }
        else if n_rec == 1 { r.r1 = 10 }
        else if n_rec == 2 { r.r2 = 10 }
        else if n_rec == 3 { r.r3 = 10 }
        n_rec = n_rec + 1
    }

    if profile.volume_contribution > 50.0 {
        if n_rec == 0 { r.r0 = 11 }
        else if n_rec == 1 { r.r1 = 11 }
        else if n_rec == 2 { r.r2 = 11 }
        else if n_rec == 3 { r.r3 = 11 }
        n_rec = n_rec + 1
    }

    if profile.absorption_contribution > 50.0 {
        if n_rec == 0 { r.r0 = 12 }
        else if n_rec == 1 { r.r1 = 12 }
        else if n_rec == 2 { r.r2 = 12 }
        else if n_rec == 3 { r.r3 = 12 }
        n_rec = n_rec + 1
    }

    if profile.is_cl_dominant != 0 {
        var scr_pct: f64 = 0.0
        var i = 0
        while i < profile.n_params {
            if profile.p_code[i as usize] == 7 {
                if profile.combined_variance > 1.0e-15 {
                    scr_pct = 100.0 * profile.p_contribution[i as usize] / profile.combined_variance
                }
            }
            i = i + 1
        }
        if scr_pct > 20.0 {
            if n_rec < 4 {
                if n_rec == 0 { r.r0 = 13 }
                else if n_rec == 1 { r.r1 = 13 }
                else if n_rec == 2 { r.r2 = 13 }
                else if n_rec == 3 { r.r3 = 13 }
                n_rec = n_rec + 1
            }
        }
    }

    if profile.combined_std_uncert > 0.0 {
        let dom_val = profile.p_value[profile.dominant_idx as usize]
        if abs_val(dom_val) > 1.0e-15 {
            let rel_uncert = 100.0 * profile.combined_std_uncert / abs_val(dom_val)
            if rel_uncert > 30.0 {
                if n_rec < 4 {
                    if n_rec == 0 { r.r0 = 14 }
                    else if n_rec == 1 { r.r1 = 14 }
                    else if n_rec == 2 { r.r2 = 14 }
                    else if n_rec == 3 { r.r3 = 14 }
                    n_rec = n_rec + 1
                }
            }
        }
    }

    if n_rec > 4 { r.n_rec = 4 } else { r.n_rec = n_rec }
    return r
}

fn pk_analyze(profile: PKProfile, n: i64) -> PKProfile with Mut, Div {
    var r = compute_contributions(profile, n)
    r = generate_rec(r)
    return r
}

fn is_clinically_sig(profile: PKProfile, tw: f64) -> i64 with Div {
    if tw <= 1.0 { return 1 }
    let half_width = 2.0 * profile.combined_std_uncert
    let dom_val = profile.p_value[profile.dominant_idx as usize]
    if abs_val(dom_val) < 1.0e-15 { return 1 }
    let rel_half = half_width / abs_val(dom_val)
    let margin = 1.0 - 1.0 / tw
    if rel_half > margin { return 1 }
    return 0
}

// ============================================================================
// TEST FUNCTIONS — each in its own function to avoid BSS collision
// ============================================================================

fn test1() -> i64 with IO, Mut, Div, Panic {
    println("TEST 1: Clearance dominance detection (CL > 70%)")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 2.0, 0.9, 0)
    p = set_param(p, 1, 1, 50.0, 2.0, 0.2, 1)
    p = set_param(p, 2, 2, 1.0, 0.1, 0.1, 0)
    p = pk_analyze(p, 3)
    if p.is_cl_dominant == 0 {
        println("FAIL: Should detect clearance dominance (CL > 70%)")
        return 0
    }
    if p.clearance_contribution < 70.0 {
        println("FAIL: CL contribution should be > 70%")
        return 0
    }
    println("[PASS] Clearance dominance correctly detected")
    return 1
}

fn test2() -> i64 with IO, Mut, Div, Panic {
    println("TEST 2: Volume dominance (V contributes most)")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 0.1, 0.1, 0)
    p = set_param(p, 1, 1, 50.0, 15.0, 0.9, 1)
    p = set_param(p, 2, 2, 1.0, 0.1, 0.1, 0)
    p = pk_analyze(p, 3)
    if p.is_cl_dominant != 0 {
        println("FAIL: Should NOT be clearance dominant when V dominates")
        return 0
    }
    if p.volume_contribution < 50.0 {
        println("FAIL: Volume contribution should be > 50%")
        return 0
    }
    println("[PASS] Volume dominance correctly detected")
    return 1
}

fn test3() -> i64 with IO, Mut, Div, Panic {
    println("TEST 3: Balanced contributions (no dominance)")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 1.0, 1.0, 0)
    p = set_param(p, 1, 1, 50.0, 1.0, 1.0, 1)
    p = set_param(p, 2, 2, 1.0, 1.0, 1.0, 0)
    p = pk_analyze(p, 3)
    if p.is_cl_dominant != 0 {
        println("FAIL: Should NOT be clearance dominant with balanced inputs")
        return 0
    }
    if p.dominant_pct > 50.0 {
        println("FAIL: No single param should dominate (>50%)")
        return 0
    }
    println("[PASS] Balanced contributions correctly identified")
    return 1
}

fn test4() -> i64 with IO, Mut, Div, Panic {
    println("TEST 4: SCr dominance (Cockcroft-Gault clearance)")
    let age_val = 60.0
    let wt_val = 70.0
    let scr_val = 1.2
    let s_scr = abs_val((140.0 - age_val) * wt_val / (72.0 * scr_val * scr_val))
    let s_wt = (140.0 - age_val) / (72.0 * scr_val)
    var p = empty_profile()
    p = set_param(p, 0, 7, scr_val, 0.3, s_scr, 0)
    p = set_param(p, 1, 6, wt_val, 2.0, s_wt, 0)
    p = set_param(p, 2, 1, 50.0, 1.0, 0.1, 1)
    p = pk_analyze(p, 3)
    if p.is_cl_dominant == 0 {
        println("FAIL: SCr+Weight should trigger clearance dominance")
        return 0
    }
    println("[PASS] SCr correctly identified as clearance proxy")
    return 1
}

fn test5() -> i64 with IO, Mut, Div, Panic {
    println("TEST 5: Sensitivity index S_Ti > 0.7 for CL dominance")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 2.0, 0.9, 0)
    p = set_param(p, 1, 1, 50.0, 2.0, 0.2, 1)
    p = set_param(p, 2, 2, 1.0, 0.1, 0.1, 0)
    let s = compute_sensitivity(p, 3)
    if s.cl_dominant == 0 {
        println("FAIL: CL S_Ti should trigger clearance dominance flag")
        return 0
    }
    if s.dom_s_ti < 0.7 {
        println("FAIL: Dominant S_Ti should be > 0.7")
        return 0
    }
    println("[PASS] S_Ti > 0.7 correctly triggers clearance dominance")
    return 1
}

fn test6() -> i64 with IO, Mut, Div, Panic {
    println("TEST 6: Clearance dominant -> TDM recommendation")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 2.0, 0.9, 0)
    p = set_param(p, 1, 1, 50.0, 2.0, 0.2, 1)
    p = set_param(p, 2, 2, 1.0, 0.1, 0.1, 0)
    p = pk_analyze(p, 3)
    if p.r0 != 10 {
        println("FAIL: CL dominant should recommend TDM (code 10)")
        return 0
    }
    println("[PASS] TDM correctly recommended for CL dominance")
    return 1
}

fn test7() -> i64 with IO, Mut, Div, Panic {
    println("TEST 7: Absorption dominant -> bioequivalence recommendation")
    var p = empty_profile()
    p = set_param(p, 0, 2, 1.0, 2.0, 0.9, 0)
    p = set_param(p, 1, 4, 0.8, 0.1, 0.5, 2)
    p = set_param(p, 2, 0, 5.0, 0.05, 0.1, 0)
    p = pk_analyze(p, 3)
    if p.r0 != 12 {
        println("FAIL: Absorption dominant should recommend bioequivalence (code 12)")
        return 0
    }
    println("[PASS] Bioequivalence correctly recommended for absorption dominance")
    return 1
}

fn test8() -> i64 with IO, Mut, Div, Panic {
    println("TEST 8: Clinical significance (uncertainty > therapeutic window)")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 2.0, 0.9, 0)
    p = set_param(p, 1, 1, 50.0, 2.0, 0.2, 1)
    p = set_param(p, 2, 2, 1.0, 0.1, 0.1, 0)
    p = pk_analyze(p, 3)
    let sig = is_clinically_sig(p, 2.0)
    if sig == 0 {
        println("FAIL: Should be clinically significant for narrow TW")
        return 0
    }
    println("[PASS] Correctly identifies clinically significant uncertainty")
    return 1
}

fn test9() -> i64 with IO, Mut, Div, Panic {
    println("TEST 9: Clinical significance (uncertainty < therapeutic window)")
    var p = empty_profile()
    p = set_param(p, 0, 0, 100.0, 1.0, 0.1, 0)
    p = compute_contributions(p, 1)
    let sig = is_clinically_sig(p, 10.0)
    if sig != 0 {
        println("FAIL: Should NOT be clinically significant for wide TW")
        return 0
    }
    println("[PASS] Correctly identifies non-significant uncertainty")
    return 1
}

fn test10() -> i64 with IO, Mut, Div, Panic {
    println("TEST 10: Single parameter (100% dominant)")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 1.0, 1.0, 0)
    p = pk_analyze(p, 1)
    if p.dominant_idx != 0 {
        println("FAIL: Single param should be at idx 0")
        return 0
    }
    if abs_val(p.dominant_pct - 100.0) > 0.1 {
        println("FAIL: Single param should be 100% dominant")
        return 0
    }
    println("[PASS] Single parameter correctly shows 100% dominance")
    return 1
}

fn test11() -> i64 with IO, Mut, Div, Panic {
    println("TEST 11: SCr dominant -> cystatin C recommendation")
    let age_val = 60.0
    let wt_val = 70.0
    let scr_val = 1.2
    let s_scr = abs_val((140.0 - age_val) * wt_val / (72.0 * scr_val * scr_val))
    let s_wt = (140.0 - age_val) / (72.0 * scr_val)
    var p = empty_profile()
    p = set_param(p, 0, 7, scr_val, 0.3, s_scr, 0)
    p = set_param(p, 1, 6, wt_val, 2.0, s_wt, 0)
    p = set_param(p, 2, 1, 50.0, 1.0, 0.1, 1)
    p = pk_analyze(p, 3)
    var has_rec = 0
    if p.r0 == 13 { has_rec = 1 }
    if p.r1 == 13 { has_rec = 1 }
    if p.r2 == 13 { has_rec = 1 }
    if p.r3 == 13 { has_rec = 1 }
    if has_rec == 0 {
        println("FAIL: SCr dominance should recommend cystatin C (code 13)")
        return 0
    }
    println("[PASS] Cystatin C correctly recommended for SCr dominance")
    return 1
}

fn test12() -> i64 with IO, Mut, Div, Panic {
    println("TEST 12: Sensitivity indices sum to 1.0")
    var p = empty_profile()
    p = set_param(p, 0, 0, 5.0, 2.0, 0.9, 0)
    p = set_param(p, 1, 1, 50.0, 2.0, 0.2, 1)
    p = set_param(p, 2, 2, 1.0, 0.1, 0.1, 0)
    let s = compute_sensitivity(p, 3)
    let sum_sti = s.s_ti[0 as usize] + s.s_ti[1 as usize] + s.s_ti[2 as usize]
    if abs_val(sum_sti - 1.0) > 0.01 {
        println("FAIL: Sensitivity indices should sum to 1.0")
        return 0
    }
    println("[PASS] Sensitivity indices correctly sum to 1.0")
    return 1
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i64 with IO, Mut, Div, Panic {
    println("======================================================================")
    println("  PK Domain Uncertainty Plugin Test Suite")
    println("  WS2 Track 5 — Pharmacokinetic Sensitivity Analysis")
    println("======================================================================")
    println("")

    var passed = 0
    var failed = 0

    if test1() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test2() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test3() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test4() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test5() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test6() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test7() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test8() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test9() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test10() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test11() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")
    if test12() != 0 { passed = passed + 1 } else { failed = failed + 1 }
    println("")

    println("======================================================================")
    println("  PK DOMAIN UNCERTAINTY PLUGIN — TEST SUMMARY")
    println("======================================================================")
    println("  Passed:")
    print_int(passed)
    println("")
    println("  Failed:")
    print_int(failed)
    println("")

    if failed == 0 {
        println("  ALL 12 TESTS PASSED")
        println("  PK uncertainty plugin validated for clinical pharmacology")
    } else {
        println("  SOME TESTS FAILED")
    }
    println("======================================================================")

    return failed
}
