//@ run-pass
//@ check-only
// Gate-owned runtime smoke: scripts/ci/graphics_companion_gate.sh compiles and runs this.

use graphics::drawing::{color_black, color_blue, color_green, color_red, color_white}
use graphics::tile::{
    tiled_surface_new, tiled_clear, tiled_set_pixel, tiled_draw_line,
    tiled_draw_rect, tiled_get_pixel_r, tiled_get_pixel_g, tiled_get_pixel_b
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var ts = tiled_surface_new(400, 400, 256, 256)
    ts = tiled_clear(ts, color_black())

    if tiled_get_pixel_r(&ts, 300, 300) != 0 {
        print("FAIL initial read in diagonal tile\n")
        return 99
    }

    ts = tiled_set_pixel(ts, 257, 1, color_red())
    if tiled_get_pixel_r(&ts, 257, 1) != 255 {
        print("FAIL tile pixel in second horizontal tile\n")
        return 1
    }
    if tiled_get_pixel_r(&ts, 1, 1) != 0 {
        print("FAIL unexpected write in first tile\n")
        return 2
    }
    if tiled_get_pixel_g(&ts, 257, 1) != 0 || tiled_get_pixel_b(&ts, 257, 1) != 0 {
        print("FAIL red pixel leaked into non-red channels\n")
        return 3
    }

    ts = tiled_set_pixel(ts, 1, 257, color_blue())
    if tiled_get_pixel_b(&ts, 1, 257) != 255 {
        print("FAIL blue pixel in first vertical tile\n")
        return 4
    }
    if tiled_get_pixel_r(&ts, 1, 257) != 0 || tiled_get_pixel_g(&ts, 1, 257) != 0 {
        print("FAIL blue pixel leaked into non-blue channels\n")
        return 5
    }

    ts = tiled_set_pixel(ts, 257, 257, color_green())
    if tiled_get_pixel_g(&ts, 257, 257) != 255 {
        print("FAIL green pixel in diagonal tile\n")
        return 6
    }
    if tiled_get_pixel_r(&ts, 257, 257) != 0 || tiled_get_pixel_b(&ts, 257, 257) != 0 {
        print("FAIL green pixel leaked into non-green channels\n")
        return 7
    }

    ts = tiled_draw_line(ts, 254, 254, 258, 258, color_white())
    if tiled_get_pixel_r(&ts, 254, 254) != 255 {
        print("FAIL line start before boundary\n")
        return 10
    }
    if tiled_get_pixel_r(&ts, 256, 256) != 255 {
        print("FAIL line at tile boundary\n")
        return 11
    }
    if tiled_get_pixel_r(&ts, 258, 258) != 255 {
        print("FAIL line after boundary\n")
        return 12
    }

    ts = tiled_draw_rect(ts, 255, 255, 4, 4, color_red())
    if tiled_get_pixel_r(&ts, 255, 255) != 255 {
        print("FAIL rect before boundary\n")
        return 20
    }
    if tiled_get_pixel_r(&ts, 256, 255) != 255 {
        print("FAIL rect horizontal crossing\n")
        return 21
    }
    if tiled_get_pixel_r(&ts, 255, 256) != 255 {
        print("FAIL rect vertical crossing\n")
        return 22
    }
    if tiled_get_pixel_r(&ts, 258, 258) != 255 {
        print("FAIL rect diagonal crossing\n")
        return 23
    }
    if tiled_get_pixel_r(&ts, 259, 259) != 0 {
        print("FAIL rect outside edge\n")
        return 24
    }

    ts = tiled_set_pixel(ts, -1, 0, color_red())
    ts = tiled_set_pixel(ts, 400, 0, color_red())
    ts = tiled_set_pixel(ts, 0, 400, color_red())
    if tiled_get_pixel_r(&ts, -1, 0) != 0 {
        print("FAIL negative read should be clipped\n")
        return 30
    }
    if tiled_get_pixel_r(&ts, 400, 0) != 0 {
        print("FAIL width-edge read should be clipped\n")
        return 31
    }

    print("PASS graphics_tile_smoke\n")
    0
}
