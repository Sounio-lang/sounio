//@ run-pass
// Complex Number Arithmetic Test Suite
//
// Self-contained test suite validating complex number operations:
//   add, sub, mul, div, abs, conj, neg, exp, log, sqrt, sin, cos,
//   sinh, cosh, polar conversion
//
// All functions are inlined since tests cannot import.
//
// References:
//   Ahlfors, "Complex Analysis" (3rd ed.)
//   NIST DLMF chapters 4, 10

// ============================================================================
// PURE MATH HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn floor_f64(x: f64) -> f64 with Mut, Panic, Div {
    let i = x as i32
    let f = i as f64
    if x < 0.0 && f != x { return f - 1.0 }
    return f
}

fn sqrt_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 }
    var g = x / 2.0
    if g < 1.0 { g = 1.0 }
    var i = 0
    while i < 60 {
        g = (g + x / g) / 2.0
        i = i + 1
    }
    return g
}

fn exp_f64(x: f64) -> f64 with Mut, Panic, Div {
    let ln2 = 0.6931471805599453
    let k_f = floor_f64(x / ln2 + 0.5)
    let k = k_f as i32
    let r = x - k_f * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 25 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k > 0 {
        var j = 0
        while j < k {
            result = result * 2.0
            j = j + 1
        }
    } else if k < 0 {
        var j = 0
        let neg_k = 0 - k
        while j < neg_k {
            result = result / 2.0
            j = j + 1
        }
    }
    return result
}

fn ln_f64(x: f64) -> f64 with Mut, Panic, Div {
    if x <= 0.0 { return 0.0 / 0.0 }
    var m = x
    var e = 0
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 1.0 { m = m * 2.0; e = e - 1 }
    let u = (m - 1.0) / (m + 1.0)
    let u2 = u * u
    var sum = u
    var power = u
    var k = 1
    while k <= 30 {
        power = power * u2
        let denom = (2 * k + 1) as f64
        sum = sum + power / denom
        k = k + 1
    }
    return 2.0 * sum + (e as f64) * 0.6931471805599453
}

fn sin_f64(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    let two_pi = 6.283185307179586
    var t = x - floor_f64(x / two_pi) * two_pi
    if t > pi { t = t - two_pi }
    if t < 0.0 - pi { t = t + two_pi }
    var sum = t
    var term = t
    var n = 1
    while n <= 20 {
        term = 0.0 - term * t * t / (((2 * n) as f64) * ((2 * n + 1) as f64))
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn cos_f64(x: f64) -> f64 with Mut, Panic, Div {
    return sin_f64(x + 1.5707963267948966)
}

// atan_f64 must precede atan2_f64 (no forward refs in Sounio)
fn atan_f64(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    if x > 1.0 { return pi / 2.0 - atan_f64(1.0 / x) }
    if x < -1.0 { return 0.0 - pi / 2.0 - atan_f64(1.0 / x) }
    var sum = x
    var term = x
    var n = 1
    while n <= 40 {
        term = 0.0 - term * x * x
        sum = sum + term / ((2 * n + 1) as f64)
        n = n + 1
    }
    return sum
}

fn atan2_f64(y: f64, x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    if x > 0.0 { return atan_f64(y / x) }
    if x < 0.0 && y >= 0.0 { return atan_f64(y / x) + pi }
    if x < 0.0 && y < 0.0 { return atan_f64(y / x) - pi }
    if y > 0.0 { return pi / 2.0 }
    if y < 0.0 { return 0.0 - pi / 2.0 }
    return 0.0
}

// ============================================================================
// COMPLEX STRUCT AND OPERATIONS
// ============================================================================

struct Complex {
    re: f64,
    im: f64,
}

fn complex_new(re: f64, im: f64) -> Complex with Mut, Panic, Div {
    Complex { re: re, im: im }
}

fn complex_add(a: Complex, b: Complex) -> Complex with Mut, Panic, Div {
    complex_new(a.re + b.re, a.im + b.im)
}

fn complex_sub(a: Complex, b: Complex) -> Complex with Mut, Panic, Div {
    complex_new(a.re - b.re, a.im - b.im)
}

fn complex_mul(a: Complex, b: Complex) -> Complex with Mut, Panic, Div {
    complex_new(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)
}

fn complex_div(a: Complex, b: Complex) -> Complex with Mut, Panic, Div {
    let denom = b.re * b.re + b.im * b.im
    complex_new((a.re * b.re + a.im * b.im) / denom, (a.im * b.re - a.re * b.im) / denom)
}

fn complex_abs(z: Complex) -> f64 with Mut, Panic, Div {
    sqrt_f64(z.re * z.re + z.im * z.im)
}

fn complex_conj(z: Complex) -> Complex with Mut, Panic, Div {
    complex_new(z.re, 0.0 - z.im)
}

fn complex_neg(z: Complex) -> Complex with Mut, Panic, Div {
    complex_new(0.0 - z.re, 0.0 - z.im)
}

fn complex_exp(z: Complex) -> Complex with Mut, Panic, Div {
    let e_a = exp_f64(z.re)
    complex_new(e_a * cos_f64(z.im), e_a * sin_f64(z.im))
}

fn complex_log(z: Complex) -> Complex with Mut, Panic, Div {
    complex_new(ln_f64(complex_abs(z)), atan2_f64(z.im, z.re))
}

fn complex_sqrt(z: Complex) -> Complex with Mut, Panic, Div {
    if z.re == 0.0 && z.im == 0.0 { return complex_new(0.0, 0.0) }
    let r = complex_abs(z)
    let theta = atan2_f64(z.im, z.re) / 2.0
    let s = sqrt_f64(r)
    complex_new(s * cos_f64(theta), s * sin_f64(theta))
}

fn complex_sin(z: Complex) -> Complex with Mut, Panic, Div {
    let eb = exp_f64(z.im)
    let enb = exp_f64(0.0 - z.im)
    complex_new(sin_f64(z.re) * (eb + enb) / 2.0, cos_f64(z.re) * (eb - enb) / 2.0)
}

fn complex_cos(z: Complex) -> Complex with Mut, Panic, Div {
    let eb = exp_f64(z.im)
    let enb = exp_f64(0.0 - z.im)
    complex_new(cos_f64(z.re) * (eb + enb) / 2.0, 0.0 - sin_f64(z.re) * (eb - enb) / 2.0)
}

fn complex_from_polar(r: f64, theta: f64) -> Complex with Mut, Panic, Div {
    complex_new(r * cos_f64(theta), r * sin_f64(theta))
}

fn complex_sinh(z: Complex) -> Complex with Mut, Panic, Div {
    let ep = complex_exp(z)
    let en = complex_exp(complex_neg(z))
    let d = complex_sub(ep, en)
    complex_new(d.re * 0.5, d.im * 0.5)
}

fn complex_cosh(z: Complex) -> Complex with Mut, Panic, Div {
    let ep = complex_exp(z)
    let en = complex_exp(complex_neg(z))
    let s = complex_add(ep, en)
    complex_new(s.re * 0.5, s.im * 0.5)
}

// ============================================================================
// TOLERANCE HELPER
// ============================================================================

fn approx_eq(a: f64, b: f64, tol: f64) -> bool with Mut, Panic, Div {
    abs_f64(a - b) < tol
}

// ============================================================================
// TEST FUNCTIONS
// ============================================================================

// Test 1: (1+2i) + (3+4i) = (4+6i)
fn test_add_basic() -> bool with IO, Mut, Panic, Div {
    let a = complex_new(1.0, 2.0)
    let b = complex_new(3.0, 4.0)
    let c = complex_add(a, b)
    let tol = 1.0e-8
    return approx_eq(c.re, 4.0, tol) && approx_eq(c.im, 6.0, tol)
}

// Test 2: (5+3i) - (2+1i) = (3+2i)
fn test_sub_basic() -> bool with IO, Mut, Panic, Div {
    let a = complex_new(5.0, 3.0)
    let b = complex_new(2.0, 1.0)
    let c = complex_sub(a, b)
    let tol = 1.0e-8
    return approx_eq(c.re, 3.0, tol) && approx_eq(c.im, 2.0, tol)
}

// Test 3: (1+2i) * (3+4i) = (-5+10i)
fn test_mul_basic() -> bool with IO, Mut, Panic, Div {
    let a = complex_new(1.0, 2.0)
    let b = complex_new(3.0, 4.0)
    let c = complex_mul(a, b)
    let tol = 1.0e-8
    return approx_eq(c.re, 0.0 - 5.0, tol) && approx_eq(c.im, 10.0, tol)
}

// Test 4: z * conj(z) = |z|^2 (purely real)
fn test_mul_conjugate() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(3.0, 4.0)
    let zc = complex_conj(z)
    let product = complex_mul(z, zc)
    let abs_sq = z.re * z.re + z.im * z.im
    let tol = 1.0e-8
    return approx_eq(product.re, abs_sq, tol) && approx_eq(product.im, 0.0, tol)
}

// Test 5: (z1 * z2) / z2 = z1
fn test_div_roundtrip() -> bool with IO, Mut, Panic, Div {
    let z1 = complex_new(2.0, 3.0)
    let z2 = complex_new(1.0, 1.0)
    let product = complex_mul(z1, z2)
    let back = complex_div(product, z2)
    let tol = 1.0e-8
    return approx_eq(back.re, z1.re, tol) && approx_eq(back.im, z1.im, tol)
}

// Test 6: z / z = 1+0i
fn test_div_self() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(3.0, 4.0)
    let one = complex_div(z, z)
    let tol = 1.0e-8
    return approx_eq(one.re, 1.0, tol) && approx_eq(one.im, 0.0, tol)
}

// Test 7: |1+0i| = 1
fn test_abs_unit() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(1.0, 0.0)
    let m = complex_abs(z)
    let tol = 1.0e-8
    return approx_eq(m, 1.0, tol)
}

// Test 8: |3+4i| = 5
fn test_abs_345() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(3.0, 4.0)
    let m = complex_abs(z)
    let tol = 1.0e-8
    return approx_eq(m, 5.0, tol)
}

// Test 9: conj(conj(z)) = z, z + conj(z) = 2*re
fn test_conj_properties() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(2.5, 3.7)
    let cc = complex_conj(complex_conj(z))
    let sum = complex_add(z, complex_conj(z))
    let tol = 1.0e-8
    let ok1 = approx_eq(cc.re, z.re, tol) && approx_eq(cc.im, z.im, tol)
    let ok2 = approx_eq(sum.re, 2.0 * z.re, tol) && approx_eq(sum.im, 0.0, tol)
    return ok1 && ok2
}

// Test 10: exp(0+0i) = 1+0i
fn test_exp_zero() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(0.0, 0.0)
    let e = complex_exp(z)
    let tol = 1.0e-8
    return approx_eq(e.re, 1.0, tol) && approx_eq(e.im, 0.0, tol)
}

// Test 11: Euler's identity: exp(i*pi) + 1 approx 0
fn test_euler_identity() -> bool with IO, Mut, Panic, Div {
    let pi = 3.141592653589793
    let i_pi = complex_new(0.0, pi)
    let e = complex_exp(i_pi)
    // e^(i*pi) = -1 + 0i, so e^(i*pi) + 1 should be ~0
    let tol = 1.0e-8
    return approx_eq(e.re + 1.0, 0.0, tol) && approx_eq(e.im, 0.0, tol)
}

// Test 12: log(exp(z)) approx z for z = 1+1i
fn test_exp_log_roundtrip() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(1.0, 1.0)
    let back = complex_log(complex_exp(z))
    let tol = 1.0e-8
    return approx_eq(back.re, z.re, tol) && approx_eq(back.im, z.im, tol)
}

// Test 13: sqrt(4+0i) approx 2+0i
fn test_sqrt_positive() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(4.0, 0.0)
    let s = complex_sqrt(z)
    let tol = 1.0e-8
    return approx_eq(s.re, 2.0, tol) && approx_eq(s.im, 0.0, tol)
}

// Test 14: sqrt(-1+0i) approx 0+1i
fn test_sqrt_negative() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(0.0 - 1.0, 0.0)
    let s = complex_sqrt(z)
    let tol = 1.0e-8
    return approx_eq(s.re, 0.0, tol) && approx_eq(s.im, 1.0, tol)
}

// Test 15: sin^2(z) + cos^2(z) approx 1
fn test_sin_cos_identity() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(1.0, 0.5)
    let sz = complex_sin(z)
    let cz = complex_cos(z)
    let s2 = complex_mul(sz, sz)
    let c2 = complex_mul(cz, cz)
    let sum = complex_add(s2, c2)
    let tol = 1.0e-8
    return approx_eq(sum.re, 1.0, tol) && approx_eq(sum.im, 0.0, tol)
}

// Test 16: from_polar(|z|, arg(z)) approx z
fn test_polar_roundtrip() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(3.0, 4.0)
    let r = complex_abs(z)
    let theta = atan2_f64(z.im, z.re)
    let back = complex_from_polar(r, theta)
    let tol = 1.0e-8
    return approx_eq(back.re, z.re, tol) && approx_eq(back.im, z.im, tol)
}

// Test 17: cosh^2(z) - sinh^2(z) approx 1
fn test_cosh_sinh_identity() -> bool with IO, Mut, Panic, Div {
    let z = complex_new(0.5, 0.8)
    // Inline hyperbolic defs — avoid returning computed Complex from helpers (codegen).
    let ep = complex_exp(z)
    let en = complex_exp(complex_neg(z))
    let sum = complex_add(ep, en)
    let diff_e = complex_sub(ep, en)
    let ch = complex_new(sum.re * 0.5, sum.im * 0.5)
    let sh = complex_new(diff_e.re * 0.5, diff_e.im * 0.5)
    let ch2 = complex_mul(ch, ch)
    let sh2 = complex_mul(sh, sh)
    let id = complex_sub(ch2, sh2)
    let tol = 1.0e-6
    return approx_eq(id.re, 1.0, tol) && approx_eq(id.im, 0.0, tol)
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    println("=== Complex Arithmetic Tests ===")
    println("")

    var passed = 0
    var failed = 0

    // Test 1
    print("Test  1: add basic.................. ")
    if test_add_basic() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 2
    print("Test  2: sub basic.................. ")
    if test_sub_basic() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 3
    print("Test  3: mul basic.................. ")
    if test_mul_basic() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 4
    print("Test  4: mul conjugate.............. ")
    if test_mul_conjugate() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 5
    print("Test  5: div roundtrip.............. ")
    if test_div_roundtrip() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 6
    print("Test  6: div self................... ")
    if test_div_self() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 7
    print("Test  7: abs unit................... ")
    if test_abs_unit() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 8
    print("Test  8: abs 3-4-5.................. ")
    if test_abs_345() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 9
    print("Test  9: conj properties............ ")
    if test_conj_properties() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 10
    print("Test 10: exp zero................... ")
    if test_exp_zero() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 11
    print("Test 11: Euler identity............. ")
    if test_euler_identity() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 12
    print("Test 12: exp-log roundtrip.......... ")
    if test_exp_log_roundtrip() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 13
    print("Test 13: sqrt positive.............. ")
    if test_sqrt_positive() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 14
    print("Test 14: sqrt negative.............. ")
    if test_sqrt_negative() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 15
    print("Test 15: sin-cos identity........... ")
    if test_sin_cos_identity() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 16
    print("Test 16: polar roundtrip............ ")
    if test_polar_roundtrip() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    // Test 17
    print("Test 17: cosh-sinh identity......... ")
    if test_cosh_sinh_identity() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 17 TESTS PASSED")
    return 0
}
