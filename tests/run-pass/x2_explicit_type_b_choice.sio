//@ run-pass
//@ expect-stdout: X2_TYPE_AB_PASS
// X2 positive control: explicit choice of provenance at the call.
// A measured (declared sigma, GUM Type B) value satisfies a Type B
// requirement directly. A residual-estimated (Type A) value does not:
// it becomes usable only where the caller explicitly takes declared
// responsibility for its uncertainty with type_b(...).

fn requires_type_b(k: Knowledge<f64>) -> f64 with Epistemic {
    k.value
}

fn main() -> i64 with IO, Epistemic {
    var fails: i64 = 0
    let declared = measure(2.0, uncertainty: 0.1)
    if requires_type_b(declared) != 2.0 { fails = fails + 1 }
    let fit = residual_knowledge(3.0, uncertainty: 0.2)
    if requires_type_b(type_b(fit)) != 3.0 { fails = fails + 1 }
    if fails == 0 {
        println("X2_TYPE_AB_PASS")
    } else {
        println("X2_TYPE_AB_FAIL")
    }
    return fails
}
