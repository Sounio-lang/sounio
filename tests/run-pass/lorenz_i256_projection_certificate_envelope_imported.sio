//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 projection certificate envelope binds trajectory, projection, bridge, and enclosure receipts

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let fp = lorenz_i256_projection_certificate_envelope_fingerprint(
        42949672, 96,
        133081411987, 405415232,
        10099814960, 2149068118,
        10914629546, 2,
        389570672, 2544410448,
        1242653312, 4228538720,
        8148145, 2911449872,
        5309941770, 10058731223, 4084837935,
        890086395, 607091799, 693793961, 80894555,
        310218620, 501185861,
        149359034, 138609006, 488107916,
        114244647, 166945519,
        87220662, 677514412, 69322697, 19419291)
    if fp != 77888110 { return 1 }

    let audit_fp = lorenz_i256_projection_certificate_envelope_audit_fingerprint(
        fp, 214180161, 890086395, 607091799, 693793961,
        80894555, 310218620, 501185861,
        149359034, 138609006, 488107916,
        114244647, 166945519,
        87220662, 677514412, 69322697, 31)
    if audit_fp != 245178976 { return 2 }

    return 0
}
