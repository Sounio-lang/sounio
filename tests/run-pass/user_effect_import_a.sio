//@ run-pass
//@ requires: madaros
// Library half of tests/run-pass/user_effect_import_main.sio.
// Standalone: the effect is declared after its first use, which the
// effects-first pre-pass must accept.

pub fn host_add(x: i64) -> i64 with HostT { x + 1 }

pub effect HostT {}

fn main() -> i64 with HostT {
    if host_add(1) == 2 { 0 } else { 1 }
}
