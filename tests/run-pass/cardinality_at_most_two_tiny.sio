//@ run-pass
//@ requires: madaros
//@ description: Tiny proof-logged at-most-two cardinality encoding gate

fn card_var(slot: i64) -> i64 {
    return slot + 1
}

fn card_valid_slot(n: i64, slot: i64) -> i64 {
    if slot < 0 { return 0 }
    if slot >= n { return 0 }
    return 1
}

fn card_at_most_two_clause_count(n: i64) -> i64 {
    if n < 3 { return 0 }
    return (n * (n - 1) * (n - 2)) / 6
}

fn card_at_most_two_clause_id(n: i64, a: i64, b: i64, c: i64) -> i64 {
    if card_valid_slot(n, a) == 0 { return 0 - 1 }
    if card_valid_slot(n, b) == 0 { return 0 - 1 }
    if card_valid_slot(n, c) == 0 { return 0 - 1 }
    if a == b { return 0 - 1 }
    if a == c { return 0 - 1 }
    if b == c { return 0 - 1 }

    var id: i64 = 1
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            var k: i64 = j + 1
            while k < n {
                var hit: i64 = 0
                if i == a {
                    if j == b {
                        if k == c { hit = 1 }
                    }
                    if j == c {
                        if k == b { hit = 1 }
                    }
                }
                if i == b {
                    if j == a {
                        if k == c { hit = 1 }
                    }
                    if j == c {
                        if k == a { hit = 1 }
                    }
                }
                if i == c {
                    if j == a {
                        if k == b { hit = 1 }
                    }
                    if j == b {
                        if k == a { hit = 1 }
                    }
                }
                if hit == 1 { return id }
                id = id + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return 0 - 1
}

fn card_at_most_two_clause_len(n: i64, clause_id: i64) -> i64 {
    if clause_id < 1 { return 0 }
    if clause_id <= card_at_most_two_clause_count(n) { return 3 }
    return 0
}

fn card_at_most_two_lit(n: i64, clause_id: i64, pos: i64) -> i64 {
    if pos < 0 { return 0 }
    if pos >= 3 { return 0 }
    if card_at_most_two_clause_len(n, clause_id) != 3 { return 0 }

    var id: i64 = 1
    var i: i64 = 0
    while i < n {
        var j: i64 = i + 1
        while j < n {
            var k: i64 = j + 1
            while k < n {
                if id == clause_id {
                    if pos == 0 { return 0 - card_var(i) }
                    if pos == 1 { return 0 - card_var(j) }
                    return 0 - card_var(k)
                }
                id = id + 1
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn card_lit_matches_one3(clause_lit: i64, lit_a: i64, lit_b: i64, lit_c: i64) -> i64 {
    if clause_lit + lit_a == 0 { return 1 }
    if clause_lit + lit_b == 0 { return 1 }
    if clause_lit + lit_c == 0 { return 1 }
    return 0
}

fn card_verify_at_most_two_conflict(n: i64, clause_id: i64, lit_a: i64, lit_b: i64, lit_c: i64) -> i64 {
    if lit_a <= 0 { return 0 }
    if lit_b <= 0 { return 0 }
    if lit_c <= 0 { return 0 }
    if lit_a == lit_b { return 0 }
    if lit_a == lit_c { return 0 }
    if lit_b == lit_c { return 0 }

    let a = lit_a - 1
    let b = lit_b - 1
    let c = lit_c - 1
    if card_valid_slot(n, a) == 0 { return 0 }
    if card_valid_slot(n, b) == 0 { return 0 }
    if card_valid_slot(n, c) == 0 { return 0 }
    if card_at_most_two_clause_id(n, a, b, c) != clause_id { return 0 }

    let c0 = card_at_most_two_lit(n, clause_id, 0)
    let c1 = card_at_most_two_lit(n, clause_id, 1)
    let c2 = card_at_most_two_lit(n, clause_id, 2)
    if card_lit_matches_one3(c0, lit_a, lit_b, lit_c) == 0 { return 0 }
    if card_lit_matches_one3(c1, lit_a, lit_b, lit_c) == 0 { return 0 }
    if card_lit_matches_one3(c2, lit_a, lit_b, lit_c) == 0 { return 0 }
    return 1
}

fn main() -> i64 {
    if card_at_most_two_clause_count(2) != 0 { return 1 }
    if card_at_most_two_clause_count(3) != 1 { return 2 }
    if card_at_most_two_clause_count(4) != 4 { return 3 }

    if card_at_most_two_clause_id(4, 0, 1, 2) != 1 { return 4 }
    if card_at_most_two_clause_id(4, 0, 1, 3) != 2 { return 5 }
    if card_at_most_two_clause_id(4, 0, 2, 3) != 3 { return 6 }
    if card_at_most_two_clause_id(4, 1, 2, 3) != 4 { return 7 }
    if card_at_most_two_clause_id(4, 3, 1, 2) != 4 { return 8 }
    if card_at_most_two_clause_id(4, 1, 1, 2) != (0 - 1) { return 9 }

    if card_at_most_two_clause_len(4, 4) != 3 { return 10 }
    if card_at_most_two_clause_len(4, 5) != 0 { return 11 }
    if card_at_most_two_lit(4, 4, 0) != (0 - 2) { return 12 }
    if card_at_most_two_lit(4, 4, 1) != (0 - 3) { return 13 }
    if card_at_most_two_lit(4, 4, 2) != (0 - 4) { return 14 }
    if card_at_most_two_lit(4, 4, 3) != 0 { return 15 }

    if card_verify_at_most_two_conflict(4, 4, 2, 3, 4) != 1 { return 16 }
    if card_verify_at_most_two_conflict(4, 4, 4, 2, 3) != 1 { return 17 }
    if card_verify_at_most_two_conflict(4, 3, 2, 3, 4) != 0 { return 18 }
    if card_verify_at_most_two_conflict(4, 4, 2, 2, 4) != 0 { return 19 }
    if card_verify_at_most_two_conflict(4, 4, 2, 3, 0 - 4) != 0 { return 20 }
    if card_verify_at_most_two_conflict(4, 4, 2, 3, 5) != 0 { return 21 }

    return 0
}
