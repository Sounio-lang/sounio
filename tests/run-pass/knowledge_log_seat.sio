//@ run-pass
//@ requires: madaros
//@ expect-stdout: neither 3
//@ expect-stdout: both 0
//@ expect-stdout: only_b 2
//@ expect-stdout: vhoff 0
//@ expect-stdout: LOG_SEAT_OK
// seat_log builds centre * exp(±u). The first three rows are the
// residual-scaled fits of Kefi and Huot, Table 1, at 298.15 K:
// centre and u(ln P) of the fitted mean. The fourth seats the two
// van't Hoff means of one shared ln-variance.

use epistemic::claim_meet::{held_centre, seat_code, seat_log}

var R_GAS: f64 = 8.314462618
var T_HOT: f64 = 353.15
var DH: f64 = 30800.0
var DS: f64 = 108.0
var U_DH: f64 = 1500.0
var U_DS: f64 = 2.0

fn ln_p(dh: f64, ds: f64) -> f64 {
    ds / R_GAS - dh / (R_GAS * T_HOT)
}

fn p_one(dh: f64, ds: f64) -> f64 {
    exp(ln_p(dh, ds))
}

fn half(dh: f64, ds: f64) -> f64 {
    exp(ln_p(dh, ds) / 2.0)
}

fn s_ln2() -> f64 {
    let a = U_DS / R_GAS
    let b = U_DH / (R_GAS * T_HOT)
    a * a + b * b
}

fn claim_sqrt(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 40 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let neither = seat_log(
        0.17549200950646932, 0.22037007367180467,
        0.24743917053088313, 0.2077651422073616,
    )
    let both = seat_log(
        0.09316824366063585, 0.2764566448586745,
        0.11123865762929737, 0.2850301174739897,
    )
    let only_b = seat_log(
        0.5366204089505634, 0.2048558862580151,
        0.6410856399193723, 0.1653016231375161,
    )
    let revise = seat_log(-1.0, 0.1, 1.0, 0.1)
    let dh0: f64 = DH
    let ds0: f64 = DS
    let hk: Knowledge<f64> = measure(dh0, uncertainty: U_DH)
    let sk: Knowledge<f64> = measure(ds0, uncertainty: U_DS)
    let dh = hk.value
    let ds = sk.value
    let h = half(dh, ds)
    let one = p_one(dh, ds)
    let mone = second_order_mean(one)
    let msq = second_order_mean(h * h)
    let u = claim_sqrt(s_ln2())
    let vhoff = seat_log(mone, u, msq, u)
    let held_n = held_centre(neither, 0.17549200950646932, 0.24743917053088313)
    let held_b = held_centre(only_b, 0.5366204089505634, 0.6410856399193723)
    let held_v = held_centre(vhoff, mone, msq)
    print("neither ")
    print_int(seat_code(neither))
    println("")
    print("both ")
    print_int(seat_code(both))
    println("")
    print("only_b ")
    print_int(seat_code(only_b))
    println("")
    print("vhoff ")
    print_int(seat_code(vhoff))
    println("")
    if seat_code(neither) == 3 && !held_n.held && seat_code(both) == 0 && seat_code(only_b) == 2 && held_b.held && seat_code(vhoff) == 0 && !held_v.held && seat_code(revise) == 4 {
        println("LOG_SEAT_OK")
        return 0
    }
    println("LOG_SEAT_FAIL")
    1
}
