//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 time-slab containment

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1469
    fp = mix(fp, 5, 5297)
    fp = mix(fp, 291436394, 5297)
    fp = mix(fp, 876674722, 5297)
    fp = mix(fp, 693506658, 5297)
    fp = mix(fp, 389624150, 5297)
    fp = mix(fp, 69995750, 5297)
    fp = mix(fp, 9070400, 5297)
    fp = mix(fp, 28932778, 5297)
    fp = mix(fp, 189714, 5297)
    fp = mix(fp, 1, 5297)
    fp = mix(fp, 100, 5297)
    fp = mix(fp, 90704, 5297)
    fp = mix(fp, 289328, 5297)
    fp = mix(fp, 1898, 5297)
    fp = mix(fp, 91000, 5297)
    fp = mix(fp, 290000, 5297)
    fp = mix(fp, 2000, 5297)
    fp = mix(fp, 296, 5297)
    fp = mix(fp, 672, 5297)
    fp = mix(fp, 102, 5297)
    fp = mix(fp, 7, 5297)
    fp = mix(fp, 7, 5297)
    fp = mix(fp, 0, 5297)
    fp = mix(fp, 13, 5297)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 513837001 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1471
    fp = mix(fp, instance, 5303)
    fp = mix(fp, 9070400, 5303)
    fp = mix(fp, 28932778, 5303)
    fp = mix(fp, 189714, 5303)
    fp = mix(fp, 1, 5303)
    fp = mix(fp, 100, 5303)
    fp = mix(fp, 90704, 5303)
    fp = mix(fp, 289328, 5303)
    fp = mix(fp, 1898, 5303)
    fp = mix(fp, 91000, 5303)
    fp = mix(fp, 290000, 5303)
    fp = mix(fp, 2000, 5303)
    fp = mix(fp, 296, 5303)
    fp = mix(fp, 672, 5303)
    fp = mix(fp, 102, 5303)
    fp = mix(fp, 7, 5303)
    fp = mix(fp, 7, 5303)
    fp = mix(fp, 0, 5303)
    fp = mix(fp, 13, 5303)
    fp = mix(fp, ok_mask, 5303)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 513837001 { return 0 - 1 }
    if certificate != 463594250 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1481
    fp = mix(fp, instance, 5309)
    fp = mix(fp, certificate, 5309)
    fp = mix(fp, 14, 5309)
    fp = mix(fp, 5, 5309)
    fp = mix(fp, 7, 5309)
    fp = mix(fp, 7, 5309)
    fp = mix(fp, 0, 5309)
    fp = mix(fp, 13, 5309)
    fp = mix(fp, ok_mask, 5309)
    return fp
}

fn time_slab_mask() -> i64 {
    let dx_bound: i64 = 9070400
    let dy_bound: i64 = 28932778
    let dz_bound: i64 = 189714
    let dt_den: i64 = 100
    let x_sweep: i64 = 90704
    let y_sweep: i64 = 289328
    let z_sweep: i64 = 1898
    let x_margin: i64 = 91000
    let y_margin: i64 = 290000
    let z_margin: i64 = 2000
    let x_slack: i64 = x_margin - x_sweep
    let y_slack: i64 = y_margin - y_sweep
    let z_slack: i64 = z_margin - z_sweep

    var slab_mask: i64 = 0
    if x_sweep <= x_margin { slab_mask = slab_mask + 1 }
    if y_sweep <= y_margin { slab_mask = slab_mask + 2 }
    if z_sweep <= z_margin { slab_mask = slab_mask + 4 }

    var ok_mask: i64 = 0
    if 291436394 > 0 {
        if 693506658 > 0 { ok_mask = ok_mask + 1 }
    }
    if 69995750 > 0 { ok_mask = ok_mask + 2 }
    if (x_sweep - 1) * dt_den < dx_bound {
        if x_sweep * dt_den >= dx_bound {
            if (y_sweep - 1) * dt_den < dy_bound {
                if y_sweep * dt_den >= dy_bound {
                    if (z_sweep - 1) * dt_den < dz_bound {
                        if z_sweep * dt_den >= dz_bound { ok_mask = ok_mask + 4 }
                    }
                }
            }
        }
    }
    if slab_mask == 7 {
        if x_slack == 296 {
            if y_slack == 672 {
                if z_slack == 102 { ok_mask = ok_mask + 8 }
            }
        }
    }
    if 1 == 1 {
        if dt_den == 100 { ok_mask = ok_mask + 16 }
    }
    if slab_mask == 7 {
        if 13 == 13 { ok_mask = ok_mask + 32 }
    }
    if 0 == 0 { ok_mask = ok_mask + 64 }
    if 291436394 == 291436394 {
        if slab_mask == 7 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = time_slab_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 513837001 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 463594250 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 253054033 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
