//@ run-pass
//@ expect-stdout: nested float array rank: PASS

fn matrix() -> [[f64; 2]; 2] with Mut, Panic {
    [[1.0, 2.0], [3.0, 4.0]]
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let m = matrix()
    let row = m[1 as usize]
    assert(m[0 as usize][0 as usize] == 1.0)
    assert(row[1 as usize] == 4.0)
    let cube = [[[1.5; 2]; 2]; 2]
    assert(cube[1 as usize][0 as usize][1 as usize] == 1.5)
    let integers = [[2; 2]; 2]
    assert(integers[0 as usize][1 as usize] == 2)
    print("nested float array rank: PASS\n")
    0
}
