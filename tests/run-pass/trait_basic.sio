//@ run-pass

// Basic struct + impl: struct declares data, impl provides associated function.
// Note: trait method dispatch via dot syntax (c.area()) is not yet supported;
//       we test the struct/impl definition and direct call path instead.

struct Circle { radius: f64 }

impl Circle {
    fn area(self: Circle) -> f64 {
        let r = self.radius
        f64_mul(f64_mul(r, r), 3.14159)
    }
}

fn main() -> i64 with IO {
    let c = Circle { radius: 5.0 }
    let a = area(c)
    if a > 78.0 && a < 79.0 {
        0
    } else {
        1
    }
}
