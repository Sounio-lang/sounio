//@ run-pass

// Basic trait + impl: trait declares interface, impl provides method.

struct Circle { radius: f64 }

trait Shape {
    fn area(self: Circle) -> f64
}

impl Shape for Circle {
    fn area(self: Circle) -> f64 {
        // pi * r^2 approximation
        let r = self.radius
        f64_mul(f64_mul(r, r), 3.14159)
    }
}

fn main() -> i64 with IO {
    let c = Circle { radius: 5.0 }
    let a = c.area()
    0
}
