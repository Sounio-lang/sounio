kernel fn vec_add(n: i64, a: &[f64], b: &[f64], c: &![f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        c[tid as usize] = a[tid as usize] + b[tid as usize]
    }
}

fn main() -> i32 with GPU, IO {
    println("PASS: GPU vec_add e2e")
    0
}
