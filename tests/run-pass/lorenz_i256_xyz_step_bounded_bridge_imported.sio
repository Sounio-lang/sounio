//@ run-pass
//@ known-failure: imported systems::lorenz_i256_xyz_step_bounded_bridge compiles and runs; main returns 3. Not 139
//@ description: Imported Lorenz i256 bounded xyz-step bridge smoke

use systems::lorenz_i256_x_step_bridge::*
use systems::lorenz_i256_y_step_bounded_bridge::*
use systems::lorenz_i256_z_step_bounded_bridge::*
use systems::lorenz_i256_xyz_step_bounded_bridge::*

fn main() -> i64 with Div {
    let vector = lorenz_i256_xyz_step_bounded_check(
        500000000, 1, 0, 0, 250000000, 2, 0, 0, 375000000, 0, 0, 0,
        0, 9, 0, 0, 437500000, 41, 0, 0, 750000000, 2, 0, 0)
    if vector != 1 { return 1 }

    let x_underflow = lorenz_i256_xyz_step_bounded_limb(
        500000000, 0, 0, 0, 0, 0, 0, 0, 375000000, 0, 0, 0, 0, 0)
    if x_underflow != 0 - 1 { return 2 }

    let y_underflow = lorenz_i256_xyz_step_bounded_limb(
        0, 0, 0, 0, 500000000, 0, 0, 0, 0, 27, 0, 0, 1, 0)
    if y_underflow != 0 - 1 { return 3 }

    let z_underflow = lorenz_i256_xyz_step_bounded_limb(
        500000000, 0, 0, 0, 500000000, 0, 0, 0, 375000000, 0, 0, 0, 2, 0)
    if z_underflow != 0 - 1 { return 4 }

    let x_anchor = lorenz_i256_x_step_bridge_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 106)
    if x_anchor != 645218970 { return 5 }

    let x_audit = lorenz_i256_x_step_bridge_audit_fingerprint(
        x_anchor, 927405816, 360918274, 318704692, 729516083,
        1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 106, 1023)
    if x_audit != 184760392 { return 6 }

    let y_anchor = lorenz_i256_y_step_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 111)
    if y_anchor != 286140975 { return 7 }

    let y_audit = lorenz_i256_y_step_bounded_bridge_audit_fingerprint(
        y_anchor, 731064852, 508216749, 742619083, 396508712,
        681429570, 352908746, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 111, 1023)
    if y_audit != 653928410 { return 8 }

    let z_anchor = lorenz_i256_z_step_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 114)
    if z_anchor != 902461738 { return 9 }

    let z_audit = lorenz_i256_z_step_bounded_bridge_audit_fingerprint(
        z_anchor, 658209431, 149372806, 471806392, 806135247,
        681429570, 352908746, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 114, 1023)
    if z_audit != 317604925 { return 10 }

    let artifact = lorenz_i256_xyz_step_bounded_bridge_receipt_check(
        1, 1, 1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 115)
    if artifact != 701846329 { return 11 }

    let audit = lorenz_i256_xyz_step_bounded_bridge_audit_fingerprint(
        artifact, 538104672, 916470253, x_anchor, x_audit,
        y_anchor, y_audit, z_anchor, z_audit, 1, 1, 1, 1, 256,
        1000000000, 0, 0, 0, 0, 115, 2047)
    if audit != 263917508 { return 12 }
    return 0
}
