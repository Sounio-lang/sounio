fn sum_to(n: i64) -> i64 with Mut {
    var acc: i64 = 0
    var i: i64 = 1
    while i <= n {
        acc = acc + i
        i = i + 1
    }
    acc
}

fn sign(x: i64) -> i64 with Mut {
    if x > 0 { 1 }
    else if x < 0 { 0 - 1 }
    else { 0 }
}

fn main() -> i64 with IO {
    let s = sum_to(10)
    print_int(s)
    print("\n")
    let sg = sign(0 - 7)
    print_int(sg)
    print("\n")
    0
}
