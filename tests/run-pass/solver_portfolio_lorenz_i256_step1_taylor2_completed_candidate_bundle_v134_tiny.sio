//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v134 smoke for Lorenz i256 step-1 Taylor-2 completed candidate bundle

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2251
    receipt_fp = mix(receipt_fp, 620127047, 6233)
    receipt_fp = mix(receipt_fp, 956998285, 6233)
