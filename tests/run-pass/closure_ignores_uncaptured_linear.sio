//@ run-pass
//@ requires: madaros

linear struct Ticket {
    id: i64,
}

fn consume(ticket: Ticket) -> i64 {
    ticket.id
}

fn main() -> i32 with Panic {
    let ticket = Ticket { id: 101 }
    let constant = || 7
    assert(constant() == 7)
    assert(constant() == 7)
    assert(consume(ticket) == 101)
    0
}
