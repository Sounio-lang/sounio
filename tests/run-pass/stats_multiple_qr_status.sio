//@ run-pass
//@ expect-stdout: STATS_MULTIPLE_QR_STATUS_PASS
use stats::regression::multiple::{multiple_linear_fit}
use linalg::least_squares::{LeastSquaresResult}
use math::pure::{is_finite}
fn zero_solution(r:&LeastSquaresResult)->bool with Mut,Div,Panic {
 if r.residual_norm!=0.0 || r.df!=0 {return false}
 var i:i64=0
 while i<8 {if r.coefficients[i as usize]!=0.0 {return false};i=i+1}
 i=0
 while i<256 {
  if r.fitted[i as usize]!=0.0 || r.residuals[i as usize]!=0.0 {return false}
  i=i+1
 }
 true
}
fn main() with IO,Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 let size=multiple_linear_fit(&a,&b,0,0,0.0)
 assert(size.status==1 && size.m==0 && size.p==0 && zero_solution(&size))
 let badtol=multiple_linear_fit(&a,&b,4,2,1.0)
 assert(badtol.status==5 && badtol.rank==0 && badtol.rcond_used==0.0)
 assert(zero_solution(&badtol))
 a[0]=1.0;a[1]=-1.0;a[8]=1.0;a[9]=0.0
 a[16]=1.0;a[17]=1.0;a[24]=1.0;a[25]=2.0
 b[0]=-1.0;b[1]=2.0;b[2]=5.0;b[3]=8.0
 // Inactive column and row poison are outside the borrowed active rectangle.
 a[7]=0.0/0.0;a[2047]=1.0e308*2.0;b[255]=0.0/0.0
 let fit=multiple_linear_fit(&a,&b,4,2,0.0)
 assert(fit.status==0 && fit.rank==2 && fit.df==2)
 assert(fit.coefficients[0]>1.99999999999 && fit.coefficients[0]<2.00000000001)
 assert(fit.coefficients[1]>2.99999999999 && fit.coefficients[1]<3.00000000001)
 assert(is_finite(fit.residual_norm) && fit.residual_norm<1.0e-11)
 var i:i64=4
 while i<256 {assert(fit.fitted[i as usize]==0.0 && fit.residuals[i as usize]==0.0);i=i+1}
 let rank=multiple_linear_fit(&a,&b,4,3,0.0)
 assert(rank.status==3 && rank.rank==2 && zero_solution(&rank))
 assert(rank.rcond_used>0.0)
 // Active nonfinite data outranks a zero column or rank-deficient design.
 a[0]=0.0/0.0
 let data=multiple_linear_fit(&a,&b,4,3,0.0)
 assert(data.status==2 && data.rank==0 && data.rcond_used==0.0)
 assert(zero_solution(&data))
 let precedence=multiple_linear_fit(&a,&b,4,3,-1.0)
 assert(precedence.status==5 && zero_solution(&precedence))
 println("STATS_MULTIPLE_QR_STATUS_PASS")
 0
}
