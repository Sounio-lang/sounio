//@ run-pass
//@ expect-stdout: 77 88
//@ description: nested Box array stores preserve scalar and aggregate elements
struct NestedSlot { n: i64 }
struct NestedNames { values: [NestedSlot; 4] }
struct NestedNumbers { values: [i64; 4] }
struct NestedTable { names: Box<NestedNames>, regs: Box<NestedNumbers> }
fn nested_bind(t: &!NestedTable) with Mut, Panic {
    (*(*t).names).values[1] = NestedSlot { n: 77 }
    (*(*t).regs).values[1] = 88
}
fn main() with IO, Mut, Panic, Alloc {
    var t = NestedTable { names: Box::new(NestedNames { values: [NestedSlot { n: 0 }; 4] }), regs: Box::new(NestedNumbers { values: [0; 4] }) }
    nested_bind(&!t)
    print_int((*t.names).values[1].n)
    print(" ")
    print_int((*t.regs).values[1])
    print("\n")
}
