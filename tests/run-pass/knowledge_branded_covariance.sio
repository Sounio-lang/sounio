//@ run-pass
//@ requires: madaros
//@ expect-stdout: BRANDED_COVARIANCE_OK
// Correlation is explicit and remains available after ontology branding.
// rho=1 gives Cov(f,o)=sigma_f*sigma_o=0.02.

ontology Reaction {
    class Substance { property amount: f64 where amount >= 0.0 }
    class FuelCarrier subclass_of Substance
    class OxidantCarrier subclass_of Substance
    disjoint FuelCarrier, OxidantCarrier
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let fuel_value: FuelCarrier = 10.0
    let oxidant_value: OxidantCarrier = 2.0
    let fuel: Knowledge<FuelCarrier> = measure(fuel_value, uncertainty: 0.1)
    let oxidant: Knowledge<OxidantCarrier> = measure(oxidant_value, uncertainty: 0.2)
    let f: f64 = fuel.value
    let o: f64 = oxidant.value

    let independent = variance_of(f * o)
    let _rho = correlate(f, o, 1.0)
    let correlated = variance_of(f * o)
    // Independent: 4.04. Correlated: 4.04 + 2*f'*o'*Cov = 4.84.
    let expected_covariance = 4.84

    print("independent ")
    print_f64(independent)
    print(" correlated ")
    print_f64(correlated)
    print("\n")

    if near(independent, 4.04, 0.0001) && near(correlated, expected_covariance, 0.0001) {
        println("BRANDED_COVARIANCE_OK")
        return 0
    }
    println("BRANDED_COVARIANCE_FAIL")
    1
}
