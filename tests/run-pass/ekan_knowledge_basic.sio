//@ run-pass
// Smoke test: measured/asserted edge coefficients → E-KAN → output conf ≤ 0.965

fn sqrt_t(x: f64) -> f64 with Mut, Div, Panic {
    if x <= 0.0 { return 0.0 }
    var y = x; var i = 0
    while i < 10 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
fn abs_t(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn hat(x: f64, k: i64) -> f64 with Mut, Div, Panic {
    let c = (k as f64) * 0.25
    let d = abs_t(x - c) / 0.25
    if d >= 1.0 { return 0.0 }
    1.0 - d
}

struct Ev { val: f64, unc: f64, conf: f64 }
fn edge_eval(coeffs: &[f64; 5], unc: &[f64; 5], e_conf: f64, x: f64) -> Ev with Mut, Div, Panic {
    var val = 0.0; var vs = 0.0; var k = 0
    while k < 5 {
        let b = hat(x, k)
        val = val + coeffs[k as usize] * b
        vs  = vs  + b*b * unc[k as usize]*unc[k as usize]
        k = k + 1
    }
    Ev { val: val, unc: sqrt_t(vs), conf: e_conf }
}

fn main() -> i32 with IO, Mut, Div, Panic {
    // Single edge: asserted (conf=0.965)
    let c: [f64; 5] = [0.1, 0.5, 0.0 - 0.3, 0.8, 0.2]
    let u: [f64; 5] = [0.01, 0.02, 0.01, 0.03, 0.01]
    let ev_meas   = edge_eval(&c, &u, 0.985, 0.5)  // measured
    let ev_assert = edge_eval(&c, &u, 0.965, 0.5)  // asserted

    // Min-propagation: output conf = min(measured, asserted) = 0.965
    var min_c = ev_meas.conf
    if ev_assert.conf < min_c { min_c = ev_assert.conf }

    if ev_meas.unc > 0.0 && abs_t(min_c - 0.965) < 0.001 {
        println("ekan_knowledge_basic: PASS")
        return 0
    }
    println("ekan_knowledge_basic: FAIL")
    return 1
}
