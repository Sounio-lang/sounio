//@ run-pass
//@ expect-stdout: FIRST_GLOBAL_ARRAY_REF_OK
// The first global sits at BSS_BASE_LINUX. Array element paths take base =
// V - header and read the descriptor word there for the packed-byte tag; for
// this global that word is below BSS, in the unmapped gap after the image, and
// the access died with SIGSEGV (stdlib_deep_eigen, #2966). Packed arrays are
// heap objects only, so such a base skips the tag read.
var FIRST: [i64; 4] = [0; 4]

fn sum4(a: &[i64; 4]) -> i64 with Mut, Panic, Div {
    (*a)[0] + (*a)[1] + (*a)[2] + (*a)[3]
}

fn fill(a: &![i64; 4]) with Mut, Panic, Div {
    (*a)[0] = 1
    (*a)[1] = 2
    (*a)[2] = 3
    (*a)[3] = 4
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    fill(&!FIRST)
    if sum4(&FIRST) == 10 { println("FIRST_GLOBAL_ARRAY_REF_OK") } else { println(sum4(&FIRST)) }
    return 0
}
