//@ run-pass

fn square(x: f64) -> f64 { x * x }
fn sum(a: f64, b: f64) -> f64 { a + b }
fn ratio(n: f64, d: f64) -> f64 with Div { n / d }

fn main() -> i64 with IO, Div {
    let s = square(3.0)
    let t = sum(2.5, 4.5)
    let q = ratio(12.0, 3.0)

    if s == 9.0 && t == 7.0 && q == 4.0 {
        0
    } else {
        1
    }
}
