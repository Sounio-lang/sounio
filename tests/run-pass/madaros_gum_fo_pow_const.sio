//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_POW_CONST_PASS

// FO pow(x,c) with working native pow + exp/log derivatives + mean rewrite.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let x = k.value

    // value path
    let p2 = pow(x, 2.0)
    let p3 = pow(x, 3.0)

    // FO var + mean for pow should match x*x / x^3
    let vp = variance_of(pow(x, 2.0))
    let mp = second_order_mean(pow(x, 2.0))
    let vx = variance_of(x * x)
    let mx = second_order_mean(x * x)
    let v3 = variance_of(pow(x, 3.0))
    let m3 = second_order_mean(pow(x, 3.0))
    let h2 = hessian_diag_of(pow(x, 2.0))
    let h3 = hessian_diag_of(pow(x, 3.0))

    // tan mean now works
    let kt: Knowledge<f64> = measure(0.3, uncertainty: 0.02)
    let xt = kt.value
    let t1 = tan(0.3)
    let fp = 1.0 + t1 * t1
    let f2 = 2.0 * t1 * fp
    let mt_e = t1 + 0.5 * f2 * 0.0004
    let mt = second_order_mean(tan(xt))
    let vt = variance_of(tan(xt))
    let vt_e = fp * fp * 0.0004

    print("p2="); print_f64(p2); print("\n")
    print("p3="); print_f64(p3); print("\n")
    print("vp="); print_f64(vp); print("\n")
    print("mp="); print_f64(mp); print("\n")
    print("v3="); print_f64(v3); print("\n")
    print("m3="); print_f64(m3); print("\n")
    print("h2="); print_f64(h2); print("\n")
    print("h3="); print_f64(h3); print("\n")
    print("mt="); print_f64(mt); print("\n")
    print("vt="); print_f64(vt); print("\n")

    let ok = abs_f(p2 - 4.0) < 1.0e-6
        && abs_f(p3 - 8.0) < 1.0e-3
        && abs_f(vp - 0.04) < 1.0e-8
        && abs_f(mp - 4.0025) < 1.0e-7
        && abs_f(mp - mx) < 1.0e-7
        && abs_f(vp - vx) < 1.0e-8
        && abs_f(v3 - 0.36) < 1.0e-6
        && abs_f(m3 - 8.015) < 1.0e-3
        && abs_f(h2 - 2.0) < 1.0e-7
        && abs_f(h3 - 12.0) < 1.0e-4
        && abs_f(mt - mt_e) < 1.0e-6
        && abs_f(vt - vt_e) < 1.0e-8
    if ok {
        print("MADAROS_GUM_FO_POW_CONST_PASS\n")
    } else {
        print("MADAROS_GUM_FO_POW_CONST_FAIL\n")
    }
}
