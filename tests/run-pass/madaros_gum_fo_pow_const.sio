//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_POW_CONST_PASS

// FO for pow(x, c) constant exponent (derivatives via exp/log).
// Note: native pow() value is stubbed 0 on Madaros; FO variance/hessian still track.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let x = k.value
    let vp = variance_of(pow(x, 2.0))
    let vx = variance_of(x * x)
    let v3 = variance_of(pow(x, 3.0))
    let h2 = hessian_diag_of(x * x)
    let h3 = hessian_diag_of((x * x) * x)
    let hp2 = hessian_diag_of(pow(x, 2.0))
    let hp3 = hessian_diag_of(pow(x, 3.0))
    // second_order mean on products (trustworthy values)
    let mx = second_order_mean(x * x)
    let m3 = second_order_mean((x * x) * x)

    print("vp="); print_f64(vp); print("\n")
    print("vx="); print_f64(vx); print("\n")
    print("v3="); print_f64(v3); print("\n")
    print("h2="); print_f64(h2); print("\n")
    print("hp2="); print_f64(hp2); print("\n")
    print("h3="); print_f64(h3); print("\n")
    print("hp3="); print_f64(hp3); print("\n")
    print("mx="); print_f64(mx); print("\n")
    print("m3="); print_f64(m3); print("\n")

    let ok = abs_f(vp - 0.04) < 1.0e-8
        && abs_f(vp - vx) < 1.0e-8
        && abs_f(v3 - 0.36) < 1.0e-7
        && abs_f(h2 - 2.0) < 1.0e-9
        && abs_f(hp2 - 2.0) < 1.0e-8
        && abs_f(h3 - 12.0) < 1.0e-8
        && abs_f(hp3 - 12.0) < 1.0e-7
        && abs_f(mx - 4.0025) < 1.0e-8
        && abs_f(m3 - 8.015) < 1.0e-7
    if ok {
        print("MADAROS_GUM_FO_POW_CONST_PASS\n")
    } else {
        print("MADAROS_GUM_FO_POW_CONST_FAIL\n")
    }
}
