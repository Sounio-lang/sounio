//@ run-pass
//@ expect-stdout-contains: if_let Some: PASS
//@ expect-stdout-contains: if_let None-else: PASS
//@ expect-stdout-contains: if_let None: PASS
//@ expect-stdout-contains: if_let wildcard: PASS
//@ description: Phase 1.3 — if let pattern matching (Some/None/Ok/Err/enum/wildcard)
// NOTE: if-let is implemented in lean_single.sio source; activates on Gen 23 rebuild.

fn get_some() -> Option<i64> with IO {
    Some(42)
}

fn get_none() -> Option<i64> with IO {
    None
}

fn main() with IO {
    // --- if let Some(x) ---
    let v = get_some()
    if let Some(x) = v {
        if x == 42 {
            print("if_let Some: PASS\n")
        } else {
            print("if_let Some: FAIL (wrong value)\n")
        }
    } else {
        print("if_let Some: FAIL (branch not taken)\n")
    }

    // --- if let None (should not enter branch) ---
    let v2 = get_some()
    if let None = v2 {
        print("if_let None wrongly triggered: FAIL\n")
    } else {
        print("if_let None-else: PASS\n")
    }

    // --- if let None (should enter branch) ---
    let v3 = get_none()
    if let None = v3 {
        print("if_let None: PASS\n")
    } else {
        print("if_let None: FAIL\n")
    }

    // --- if let with wildcard _ (always matches) ---
    let v4 = get_some()
    if let _ = v4 {
        print("if_let wildcard: PASS\n")
    } else {
        print("if_let wildcard: FAIL\n")
    }
}
