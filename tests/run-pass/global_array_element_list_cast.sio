//@ requires:madaros
// Wave9: global element-list slots with `as T` casts must const-fold.
// Pre-wave9 stock Madaros dropped cast slots entirely → zeros.

var A: [i64; 2] = [1 as i64, 2 as i64]
var B: [i64; 3] = [10 as i64, 0 - 2, 30 as i64]

fn main() -> i64 with IO {
    print_int(A[0])
    print(" ")
    print_int(A[1])
    print("\n")
    print_int(B[0])
    print(" ")
    print_int(B[1])
    print(" ")
    print_int(B[2])
    print("\n")
    if A[0] != 1 { return 1 }
    if A[1] != 2 { return 2 }
    if B[0] != 10 { return 3 }
    if B[1] != 0 - 2 { return 4 }
    if B[2] != 30 { return 5 }
    0
}
