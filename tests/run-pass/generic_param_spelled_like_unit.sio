//@ run-pass
//@ expect-stdout: generic param shadows unit: PASS
// A struct type parameter spelled like a builtin unit is that parameter inside its
// own struct and the unit everywhere else. The checker consulted the unit registry
// first, so `key: K` in `struct Map<K, V>` became f64 carrying kelvin and
// `Map { key: 42, val: 99 }` failed E016 "expected f64, found i64" (measured
// 2026-09-14). The same file uses K as kelvin outside the struct, which must keep
// typing and lowering as a float.

struct Map<K, V> {
    key: K,
    val: V,
}

struct Reading {
    temp: K,
}

fn body_temp() -> K {
    return 310.15
}

fn main() -> i32 with IO {
    var ok: i64 = 0
    let m = Map { key: 42, val: 99 }
    let mk: i64 = m.key
    let mv: i64 = m.val
    if mk + mv == 141 { ok = ok + 1 }
    let r = Reading { temp: body_temp() }
    let t: K = r.temp
    if t as f64 == 310.15 { ok = ok + 1 }
    let d: K = 1.5
    let s = t + d
    if s as f64 > 311.0 { ok = ok + 1 }
    if ok == 3 {
        print("generic param shadows unit: PASS\n")
    }
    return 0
}
