//@ run-pass
//@ expect-stdout: VIZ_ENTROPY_COVARIANCE_PASS
//@ expect-stdout: scatter n=5
//@ expect-stdout: rho is declared, not estimated; first-order propagation
use physics::entropy::{isothermal_entropy_correlated_volumes}
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_add_scatter_chart,
 viz_line_set_viewport,viz_add_axis,viz_node_set_label,viz_add_label,
 viz_add_series_legend,viz_layout_rect,viz_style_rgb}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
use display::canvas::{Canvas,canvas_clear}
fn main() with IO,Mut,Div,Alloc,Panic {
 var rho:[f64;5]=[-1.0,0.0,0.5,0.9,1.0]
 var xs:[f64;1024]=[0.0;1024]
 var ys:[f64;1024]=[0.0;1024]
 var i:i64=0
 while i<5 {
  let r=isothermal_entropy_correlated_volumes(1.0,0.0,2.0,0.02,1.0,0.01,rho[i as usize])
  assert(r.status==0 && r.uncertainty_model==2 && r.first_order)
  assert(r.delta_s>0.0 && r.standard_uncertainty>=0.0 && r.standard_uncertainty<0.2)
  xs[i as usize]=rho[i as usize]
  ys[i as usize]=r.standard_uncertainty
  i=i+1
 }
 assert(ys[4]==0.0)
 i=0
 while i<4 {assert(ys[i as usize]>ys[(i+1) as usize]);i=i+1}
 var scene=viz_scene_new()
 let curve=viz_add_line_chart(&!scene,&xs,&ys,5,viz_layout_rect(160,130,600,240),viz_style_rgb(220,135,225))
 assert(viz_line_set_viewport(&!scene,curve,-1.0,1.0,0.0,0.2))
 let points=viz_add_scatter_chart(&!scene,&xs,&ys,5,viz_layout_rect(160,130,600,240),viz_style_rgb(70,180,235))
 assert(points>=0)
 let slot:i64=scene.nodes[points as usize].data_slot
 scene.series[slot as usize].x_min= -1.0;scene.series[slot as usize].x_max=1.0
 scene.series[slot as usize].y_min=0.0;scene.series[slot as usize].y_max=0.2
 let xa=viz_add_axis(&!scene,-1.0,1.0,4,false,viz_layout_rect(160,388,600,1),viz_style_rgb(190,200,215))
 let ya=viz_add_axis(&!scene,0.0,0.2,4,true,viz_layout_rect(140,130,1,240),viz_style_rgb(190,200,215))
