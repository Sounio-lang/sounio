//@ run-pass
// FIXED (A8, 2026-07-06): Madaros cross-module `var r = <struct-returning call>` forwarding.
// Root cause was a lean_single by-value IrInstr miscompile in ir_module_finalize_merged_calls'
// call-target resolution; fixed by passing scalar (fn_id,name) fields instead. RUN rc=0 CROSS_SRET_MIN_OK.
//
// Minimal cross-module large-struct forwarding repro (A8). big_basis returns a
// Big { c: [i64;256], bits } by value across a module boundary via the shape
// `var r = big_zero(k); r.c[i]=1; return r`. Under Madaros this RUN-segfaults
// (rc=139); single-module lowering of the identical shape is correct.
// Root cause + IR/disasm evidence: docs/handoff/continuity/A8_CROSSMOD_FORWARDING_MISCOMPILE.md
// SIZE-INDEPENDENT: reproduces with Small { c:[i64;4] } too (see a8_diag_fwd.sio).

use testmod::sret_min::{Big, big_basis, big_add}

fn main() -> i64 with IO, Mut, Panic {
    let a = big_basis(4, 1)
    let b = big_basis(4, 2)
    let s = big_add(a, b)
    if s.c[1] == 1 && s.c[2] == 1 && s.c[0] == 0 && s.bits == 4 {
        println("CROSS_SRET_MIN_OK")
        return 0
    }
    println("CROSS_SRET_MIN_FAIL")
    return 1
}
