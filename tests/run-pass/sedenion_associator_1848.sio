//@ run-pass
//@ expect-stdout: ASSOC OK
// FRENTE B — the ASSOCIATOR side of the sedenion tower geometry, executed exactly.
//
// The ZD-geometry report (SEDENION_ZERO_DIVISOR_GEOMETRY_REPORT.md) left this OPEN: it found the
// zero-divisor side has no factor 11, and conjectured "the 11 in 1848 = 11*168 belongs to the
// associator side". This test EXECUTES the associator side and confirms it exactly.
//
// For sedenion basis units e_i, e_j, e_k the associator [e_i,e_j,e_k] = (e_i e_j)e_k - e_i(e_j e_k)
// is a single component e_(i^j^k) with integer coefficient
//   A(i,j,k) = sigma(i,j)*sigma(i^j,k) - sigma(j,k)*sigma(i,j^k)   in {-2, 0, +2}.
// A triple is non-associative iff A != 0. Over the 15*14*13 = 2730 ORDERED distinct triples of
// imaginary units {1..15}:
//   * exactly 1848 are non-associative, and 1848 = 11 * 168 = 11 * |PSL(2,7)|;
//   * by output grade s = i^j^k: each of the 14 grades s != 8 carries exactly 120, and the doubling
//     grade s = 8 carries 168 (= the octonion associator count). So 1848 = 14*120 + 168 = 10*168 + 168,
//     i.e. the "11" splits as 11 = 10 + 1 (the doubling grade contributes the +1*168);
//   * the octonion sub-tower {1..7} contributes exactly 168 ordered non-associative triples.
//
// Decidable integer arithmetic, no float. SELF-CONTAINED. Cross-verified vs
// scripts/research/sedenion_associator_1848_oracle.py by scripts/ci/sedenion_associator_1848_gate.sh
// and by formal/lean4/SounioSedenionAssociator1848.lean (native_decide).

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}

fn sig(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }

// Associator coefficient A(i,j,k) of e_(i^j^k). Nonzero <=> the ordered triple is non-associative.
fn assoc(i: i64, j: i64, k: i64) -> i64 with Mut, Panic, Div {
    sig(i, j) * sig(i ^ j, k) - sig(j, k) * sig(i, j ^ k)
}

fn main() with IO, Mut, Panic, Div {
    var total = 0
    var oct = 0
    var gradecount = [0; 16]   // count of non-associative ordered triples by output grade i^j^k
    var i = 1
    while i <= 15 {
        var j = 1
        while j <= 15 {
            var k = 1
            while k <= 15 {
                if i != j && j != k && i != k {
                    if assoc(i, j, k) != 0 {
                        total = total + 1
                        let s = i ^ j ^ k
                        gradecount[s as usize] = gradecount[s as usize] + 1
                        if i <= 7 && j <= 7 && k <= 7 { oct = oct + 1 }
                    }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    let grade8 = gradecount[8 as usize]
    var other = 0
    var grades_uniform = 1
    var s = 1
    while s <= 15 {
        if s != 8 {
            other = other + gradecount[s as usize]
            if gradecount[s as usize] != 120 { grades_uniform = 0 }
        }
        s = s + 1
    }

    // ── The ordering-class decomposition (the deeper structure of 1848) ──
    // Per UNORDERED triple {i<j<k}, count how many of its 6 orderings are non-associative.
    // Classes: 0 orderings (assoc) / 2 orderings (semi) / 6 orderings (full).
    // Grade 8 is distinguished: ALL its support-triples are FULLY non-associative (class 6),
    // which is why grade 8 carries 168 = 28*6 while other grades carry 120 = 16*6 + 12*2.
    var class0 = 0
    var class2 = 0
    var class6 = 0
    var g8_notfull = 0
    var ii = 1
    while ii <= 15 {
        var jj = ii + 1
        while jj <= 15 {
            var kk = jj + 1
            while kk <= 15 {
                var cnt = 0
                if assoc(ii, jj, kk) != 0 { cnt = cnt + 1 }
                if assoc(ii, kk, jj) != 0 { cnt = cnt + 1 }
                if assoc(jj, ii, kk) != 0 { cnt = cnt + 1 }
                if assoc(jj, kk, ii) != 0 { cnt = cnt + 1 }
                if assoc(kk, ii, jj) != 0 { cnt = cnt + 1 }
                if assoc(kk, jj, ii) != 0 { cnt = cnt + 1 }
                if cnt == 0 { class0 = class0 + 1 }
                else if cnt == 2 { class2 = class2 + 1 }
                else if cnt == 6 { class6 = class6 + 1 }
                if (ii ^ jj ^ kk) == 8 && cnt != 6 { g8_notfull = g8_notfull + 1 }
                kk = kk + 1
            }
            jj = jj + 1
        }
        ii = ii + 1
    }
    print("TOTAL ")
    print_int(total as i64)
    print("\n")
    print("GRADE8 ")
    print_int(grade8 as i64)
    print("\n")
    print("OTHER ")
    print_int(other as i64)
    print("\n")
    print("OCT ")
    print_int(oct as i64)
    print("\n")
    print("CLASS0 ")
    print_int(class0 as i64)
    print("\n")
    print("CLASS2 ")
    print_int(class2 as i64)
    print("\n")
    print("CLASS6 ")
    print_int(class6 as i64)
    print("\n")
    print("G8_NOTFULL ")
    print_int(g8_notfull as i64)
    print("\n")
    // 1848 = 11*168 ; grade8 = 168 ; other = 10*168 = 1680 ; all 14 non-8 grades = 120 ; octonion = 168.
    // Ordering-class decomposition of the 455 = C(15,3) unordered triples: 35 assoc + 168 semi + 252 full;
    // grade 8 is fully non-associative on all its support-triples (g8_notfull = 0).
    if total == 1848 && grade8 == 168 && other == 1680 && oct == 168 && grades_uniform == 1
       && class0 == 35 && class2 == 168 && class6 == 252 && g8_notfull == 0 {
        println("ASSOC OK")
    } else {
        println("ASSOC FAIL")
    }
}
