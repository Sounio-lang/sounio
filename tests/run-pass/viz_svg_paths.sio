//@ run-pass
//@ expect-stdout: SVG_PATHS_PASS
//@ expect-stdout: <path fill="none"
//@ expect-stdout: M140 70 L140 70
//@ expect-stdout: clipped-line visible=1023 outside=0 invalid=0
//@ expect-stdout: clipped-line visible=3 outside=1 invalid=2
use viz::ir::{viz_scene_new,viz_add_line_chart,viz_line_set_viewport,viz_layout_rect,viz_style_rgb}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO, Mut, Div, Panic {
    var xs:[f64;1024]=[0.0;1024]
    var ys:[f64;1024]=[0.0;1024]
    var i:i64=0
    while i < 1024 {
        xs[i as usize]=i as f64
        ys[i as usize]=((i%16) as f64)/8.0-1.0
        i=i+1
    }
    var scene=viz_scene_new()
    let dense=viz_add_line_chart(&!scene,&xs,&ys,1024,viz_layout_rect(40,30,600,160),viz_style_rgb(80,180,240))
    assert(viz_line_set_viewport(&!scene,dense,0.0,1023.0,-1.0,1.0))
    viz_html_emit_scene(&scene,700,240)
    var huge=1.0e308
    let inf=huge*10.0
    let nan=inf-inf
    i=0
    while i < 7 { ys[i as usize]=0.5;i=i+1 }
    xs[0]=-1.0;xs[1]=0.25;xs[2]=nan;xs[3]=0.75;xs[4]=2.0;xs[5]=2.5;xs[6]=0.5
    scene.node_count=0;scene.series_count=0
    let gap=viz_add_line_chart(&!scene,&xs,&ys,7,viz_layout_rect(40,30,200,80),viz_style_rgb(255,0,0))
    assert(viz_line_set_viewport(&!scene,gap,0.0,1.0,0.0,1.0))
    viz_html_emit_scene(&scene,320,160)
    xs[0]=0.5;xs[1]=0.5;ys[0]=0.5;ys[1]=0.5
    scene.node_count=0;scene.series_count=0
    let point=viz_add_line_chart(&!scene,&xs,&ys,2,viz_layout_rect(40,30,200,80),viz_style_rgb(255,0,0))
    assert(viz_line_set_viewport(&!scene,point,0.0,1.0,0.0,1.0))
    viz_html_emit_scene(&scene,320,160)
    xs[0]=2.0;xs[1]=3.0
    scene.node_count=0;scene.series_count=0
    let outside=viz_add_line_chart(&!scene,&xs,&ys,2,viz_layout_rect(40,30,200,80),viz_style_rgb(255,0,0))
    assert(viz_line_set_viewport(&!scene,outside,0.0,1.0,0.0,1.0))
    viz_html_emit_scene(&scene,320,160)
    xs[0]=nan;xs[1]=inf
    scene.node_count=0;scene.series_count=0
    let invalid=viz_add_line_chart(&!scene,&xs,&ys,2,viz_layout_rect(40,30,200,80),viz_style_rgb(255,0,0))
    assert(viz_line_set_viewport(&!scene,invalid,0.0,1.0,0.0,1.0))
    viz_html_emit_scene(&scene,320,160)
    scene.node_count=0;scene.series_count=0
    let empty=viz_add_line_chart(&!scene,&xs,&ys,0,viz_layout_rect(40,30,200,80),viz_style_rgb(255,0,0))
    assert(viz_line_set_viewport(&!scene,empty,0.0,1.0,0.0,1.0))
    viz_html_emit_scene(&scene,320,160)
    xs[0]=0.5;ys[0]=0.5
    scene.node_count=0;scene.series_count=0
    let single=viz_add_line_chart(&!scene,&xs,&ys,1,viz_layout_rect(40,30,200,80),viz_style_rgb(255,0,0))
    assert(viz_line_set_viewport(&!scene,single,0.0,1.0,0.0,1.0))
    viz_html_emit_scene(&scene,320,160)
    println("SVG_PATHS_PASS")
    0
}
