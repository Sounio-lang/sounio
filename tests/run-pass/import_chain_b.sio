//@ run-pass
// Middle module for 3-level import chain test.
// Tests that transitive imports resolve relative to this file's directory.

use import_chain_c::{chain_c_value}

fn chain_b_value() -> i64 {
    chain_c_value()
}

fn main() -> i64 with Panic {
    let v = chain_b_value()
    if v == 42 { return 0 } else { return 1 }
}
