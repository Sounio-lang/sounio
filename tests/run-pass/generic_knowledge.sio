//@ run-pass
// Test: Epistemic<T> — generic epistemic type (named to avoid built-in Knowledge<T> conflict)

struct BetaConf {
    alpha: f64,
    beta: f64,
}

struct Prov {
    source_id: i64,
}

struct Epistemic<T> {
    value: T,
    variance: f64,
    confidence: BetaConf,
    provenance: Prov,
}

fn main() with IO {
    // Epistemic<f64> — the classic case
    let dose = Epistemic {
        value: 15.0,
        variance: 0.5,
        confidence: BetaConf { alpha: 9.2, beta: 0.8 },
        provenance: Prov { source_id: 1 },
    }
    println(dose.value)
    println(dose.variance)

    // Epistemic<i64> — now possible with struct generics!
    let count = Epistemic {
        value: 42,
        variance: 1.0,
        confidence: BetaConf { alpha: 8.0, beta: 2.0 },
        provenance: Prov { source_id: 2 },
    }
    println(count.value)
}
