//@ run-pass
//@ expect-stdout: OCTCENSUS OK
// FRENTE B, vector 4/3 — the basis-aligned octonion census in the sedenion (a verified fingerprint).
//
// A basis-aligned octonion candidate is a 3-dim F₂ subspace of the sedenion index space F₂⁴ (its 7
// nonzero vectors, XOR-closed); there are 15. This test certifies three exact partitions of them:
//   * NSUB = 15 subspaces total;
//   * ZDFREE = 8 are zero-divisor-free (genuine octonion / division algebra); the other 7 contain a
//     zero divisor — the quasi-octonions (matches Cawagas, Discuss. Math. 2004: 7 quasi-octonions carry
//     the sedenion zero divisors);
//   * PURE = 1 is "Clifford-pure" — has ALL C(7,2)=21 internal ambient left-mult pairs anticommuting
//     ({L_i,L_j}=0 in the 16-dim Cℓ(8), see sedenion_clifford8.md): the base octonion {e_1..e_7}.
//   * Through the base quaternion ⟨e_1,e_2,e_3⟩={1,2,3}, the three copies (3rd generator c∈{4,8,12}) have
//     ambient-L non-anticommuting-pair counts {0, 6, 12}.
// These three properties are DISTINCT (8 ZD-free ⊋ 1 Clifford-pure); do not conflate them.
//
// INTERPRETATION (honest boundary). This fingerprint is CONSISTENT WITH — it illustrates, it does not
// prove — Erratum E1's claim that Gresnigt's three family-S₃ octonion copies are non-monomial: only the
// base octonion is Clifford-pure, so the ambient embedding already distinguishes it. The non-monomiality
// of the FAMILY S₃ rests on Brown's theorem (Aut(𝕊)=G₂×S₃), not on this census; and PSL(2,7) itself
// contains S₃ subgroups, so a basis-index census cannot by itself separate the family-S₃ from an S₃
// inside the monomial-168. Reported as an executed algebraic fingerprint, not a group-theoretic proof.
//
// Uses e_i·e_j = σ(i,j)·e_{i⊕j}; {L_i,L_j}=0 via σ(i,j⊕c)σ(j,c)+σ(j,i⊕c)σ(i,c)=0 ∀c; a zero-divisor
// pair (e_a±e_b)(e_c±e_d)=0 via componentwise integer zero. Decidable integer arithmetic, no float.
// SELF-CONTAINED. Cross-verified vs the oracle by the gate + Lean.

fn cd_sigma_c(a: i64, b: i64, bits: i64) -> i64 with Mut, Panic, Div {
    if a == 0 || b == 0 { return 1 }
    if bits <= 1 { return 0 - 1 }
    let half = 1 << (bits - 1)
    let a_hi = if a >= half { 1 } else { 0 }
    let b_hi = if b >= half { 1 } else { 0 }
    let a_lo = a & (half - 1)
    let b_lo = b & (half - 1)
    if a_hi == 0 && b_hi == 0 { return cd_sigma_c(a_lo, b_lo, bits - 1) }
    if a_hi == 0 && b_hi == 1 { return cd_sigma_c(b_lo, a_lo, bits - 1) }
    if a_hi == 1 && b_hi == 0 {
        if b_lo == 0 { return cd_sigma_c(a_lo, 0, bits - 1) }
        return 0 - cd_sigma_c(a_lo, b_lo, bits - 1)
    }
    if b_lo == 0 { return 0 - cd_sigma_c(0, a_lo, bits - 1) }
    cd_sigma_c(b_lo, a_lo, bits - 1)
}
fn sg(a: i64, b: i64) -> i64 with Mut, Panic, Div { cd_sigma_c(a, b, 4) }
fn antiL(i: i64, j: i64) -> bool with Mut, Panic, Div {
    var c = 0
    while c < 16 {
        if sg(i, j ^ c) * sg(j, c) + sg(j, i ^ c) * sg(i, c) != 0 { return false }
        c = c + 1
    }
    true
}
// (e_ulo + us*e_uhi)(e_vlo + vs*e_vhi) component on e_k
fn pprod(ulo: i64, uhi: i64, us: i64, vlo: i64, vhi: i64, vs: i64, k: i64) -> i64 with Mut, Panic, Div {
    var acc = 0
    if (ulo ^ vlo) == k { acc = acc + sg(ulo, vlo) }
    if (ulo ^ vhi) == k { acc = acc + vs * sg(ulo, vhi) }
    if (uhi ^ vlo) == k { acc = acc + us * sg(uhi, vlo) }
    if (uhi ^ vhi) == k { acc = acc + us * vs * sg(uhi, vhi) }
    acc
}
fn zero_pair(ulo: i64, uhi: i64, us: i64, vlo: i64, vhi: i64, vs: i64) -> bool with Mut, Panic, Div {
    var k = 0
    while k < 16 {
        if pprod(ulo, uhi, us, vlo, vhi, vs, k) != 0 { return false }
        k = k + 1
    }
    true
}
// does the 7-element set u[0..7] contain a zero-divisor pair (both 2-support primitives inside it)?
fn has_zd(u0: i64, u1: i64, u2: i64, u3: i64, u4: i64, u5: i64, u6: i64) -> bool with Mut, Panic, Div {
    var u = [0; 7]
    u[0 as usize] = u0
    u[1 as usize] = u1
    u[2 as usize] = u2
    u[3 as usize] = u3
    u[4 as usize] = u4
    u[5 as usize] = u5
    u[6 as usize] = u6
    // primitives: (a<b in S) x sign in {+1,-1}
    var a = 0
    while a < 7 {
        var b = a + 1
        while b < 7 {
            var us = 0 - 1
            while us <= 1 {
                if us != 0 {
                    // second primitive (c<d in S) x sign
                    var cc = 0
                    while cc < 7 {
                        var dd = cc + 1
                        while dd < 7 {
                            var vs = 0 - 1
                            while vs <= 1 {
                                if vs != 0 {
                                    if zero_pair(u[a as usize], u[b as usize], us, u[cc as usize], u[dd as usize], vs) {
                                        return true
                                    }
                                }
                                vs = vs + 1
                            }
                            dd = dd + 1
                        }
                        cc = cc + 1
                    }
                }
                us = us + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    false
}
fn nonanti_count(u0: i64, u1: i64, u2: i64, u3: i64, u4: i64, u5: i64, u6: i64) -> i64 with Mut, Panic, Div {
    var u = [0; 7]
    u[0 as usize] = u0
    u[1 as usize] = u1
    u[2 as usize] = u2
    u[3 as usize] = u3
    u[4 as usize] = u4
    u[5 as usize] = u5
    u[6 as usize] = u6
    var n = 0
    var a = 0
    while a < 7 {
        var b = a + 1
        while b < 7 {
            if !antiL(u[a as usize], u[b as usize]) { n = n + 1 }
            b = b + 1
        }
        a = a + 1
    }
    n
}

fn main() with IO, Mut, Panic, Div {
    var masks = [0; 20]
    var g0 = [0; 20]
    var g1 = [0; 20]
    var g2 = [0; 20]
    var nsub = 0
    var a = 1
    while a <= 15 {
        var b = a + 1
        while b <= 15 {
            let ab = a ^ b
            var cc = b + 1
            while cc <= 15 {
                if cc != ab {
                    let ac = a ^ cc
                    let bc = b ^ cc
                    let abc = ab ^ cc
                    var mask = 0
                    mask = mask | (1 << a)
                    mask = mask | (1 << b)
                    mask = mask | (1 << ab)
                    mask = mask | (1 << cc)
                    mask = mask | (1 << ac)
                    mask = mask | (1 << bc)
                    mask = mask | (1 << abc)
                    var seen = 0
                    var t = 0
                    while t < nsub {
                        if masks[t as usize] == mask { seen = 1 }
                        t = t + 1
                    }
                    if seen == 0 {
                        masks[nsub as usize] = mask
                        g0[nsub as usize] = a
                        g1[nsub as usize] = b
                        g2[nsub as usize] = cc
                        nsub = nsub + 1
                    }
                }
                cc = cc + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    // classify each unique subspace
    var pure = 0
    var pure_is_lower = 0
    var zdfree = 0
    var s = 0
    while s < nsub {
        let x = g0[s as usize]
        let y = g1[s as usize]
        let z = g2[s as usize]
        let xy = x ^ y
        let xz = x ^ z
        let yz = y ^ z
        let xyz = xy ^ z
        let non = nonanti_count(x, y, xy, z, xz, yz, xyz)
        if non == 0 {
            pure = pure + 1
            if masks[s as usize] == 254 { pure_is_lower = 1 }
        }
        if !has_zd(x, y, xy, z, xz, yz, xyz) { zdfree = zdfree + 1 }
        s = s + 1
    }
    let quasi = nsub - zdfree

    // quaternion-{1,2,3} triple counts
    let n_c4 = nonanti_count(1, 2, 3, 4, 5, 6, 7)
    let n_c8 = nonanti_count(1, 2, 3, 8, 9, 10, 11)
    let n_c12 = nonanti_count(1, 2, 3, 12, 13, 14, 15)
    var q_ok = 0
    if n_c4 == 0 && n_c8 == 6 && n_c12 == 12 { q_ok = 1 }

    print("NSUB ")
    print_int(nsub as i64)
    print("\n")
    print("ZDFREE ")
    print_int(zdfree as i64)
    print("\n")
    print("QUASI ")
    print_int(quasi as i64)
    print("\n")
    print("PURE ")
    print_int(pure as i64)
    print("\n")
    print("PURE_IS_LOWER ")
    print_int(pure_is_lower as i64)
    print("\n")
    print("QUAT_C4 ")
    print_int(n_c4 as i64)
    print("\n")
    print("QUAT_C8 ")
    print_int(n_c8 as i64)
    print("\n")
    print("QUAT_C12 ")
    print_int(n_c12 as i64)
    print("\n")
    // 15 index-subspaces; 8 ZD-free octonions / 7 quasi-octonions (Cawagas); exactly 1 Clifford-pure
    // (={1..7}); quaternion-triple {0,6,12}. Consistent with (illustrates) Erratum E1.
    if nsub == 15 && zdfree == 8 && quasi == 7 && pure == 1 && pure_is_lower == 1 && q_ok == 1 {
        println("OCTCENSUS OK")
    } else {
        println("OCTCENSUS FAIL")
    }
}
