//@ run-pass
//@ expect-stdout-contains: slot=hello
//@ expect-stdout-contains: slot_int=42
//@ expect-stdout-contains: PASS
//
// `pair.K.field` where the tuple slot holds a named struct. The slot's type is
// not the local's type, so the ident-based field case cannot see it; it has to
// come across the call boundary from the callee's declared return type.
//
// NEGATIVE CONTROL: an i64 field reached the same way must still print as a
// NUMBER. If the slot's type is resolved wrongly -- or resolved for the wrong
// slot -- this is the line that says so.

struct Res {
    msg: string,
    n: i64,
}

fn mk() -> (bool, Res) with Mut, Panic, Div, Alloc {
    let r = Res { msg: "hello", n: 42 }
    (true, r)
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let pair = mk()

    print("slot=")
    println(pair.1.msg)

    print("slot_int=")
    println(pair.1.n)

    println("PASS")
    0
}
