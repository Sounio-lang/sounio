//@ run-pass
//@ expect-stdout: STATS_KOENKER_STATUS_PASS
use stats::heteroscedasticity::{koenker_bp_simple}
use stats::regression::assessments::{assess_simple_linear}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;100]=[0.0;100]
 var e:[f64;100]=[0.0;100]
 assert(koenker_bp_simple(&e,&x,0).status==1)
 assert(koenker_bp_simple(&e,&x,101).status==1)
 assert(koenker_bp_simple(&e,&x,3).status==3)
 x[1]=1.0;x[2]=2.0
 assert(koenker_bp_simple(&e,&x,3).status==4)
 e[0]=2.0;e[1]=-2.0;e[2]=2.0
 let degenerate=koenker_bp_simple(&e,&x,3)
 assert(degenerate.status==4 && degenerate.p==0.0)
 e[2]=1.0e308*2.0
 assert(koenker_bp_simple(&e,&x,3).status==2)
 e[2]=0.0/0.0
 assert(koenker_bp_simple(&e,&x,3).status==2)
 e[2]=3.0
 x[1]=1.0e308*2.0
 assert(koenker_bp_simple(&e,&x,3).status==2)
 x[1]=1.0
 let good=koenker_bp_simple(&e,&x,3)
 assert(good.status==0 && good.n==3 && good.df==1 && good.asymptotic)
 var y:[f64;100]=[0.0;100]
 y[0]=2.0;y[1]=5.0;y[2]=8.0
 let perfect=assess_simple_linear(&x,&y,3)
 assert(perfect.fit.status==0)
 assert(perfect.normality.status==3 && perfect.heteroscedasticity.status==4)
 let invalid=assess_simple_linear(&x,&y,101)
 assert(invalid.fit.status==1 && invalid.normality.status!=0 && invalid.heteroscedasticity.status!=0)
 x[1]=0.0;x[2]=0.0
 let rank=assess_simple_linear(&x,&y,3)
 assert(rank.fit.status==3 && rank.normality.status!=0 && rank.heteroscedasticity.status!=0)
 println("STATS_KOENKER_STATUS_PASS")
 0
}
