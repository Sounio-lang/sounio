//@ run-pass
//@ requires: madaros
//@ expect-stdout: STR_SLICE_RANGE_OK

use testmod::tc_c::{tc_c_add}

fn main() with IO, Mut, Panic {
    assert(tc_c_add(1, 1) == 102)
    let middle = str_slice("0123456789", 2, 5)
    assert(str_eq(middle, "234"))
    assert(str_len(middle) == 3)
    println("STR_SLICE_RANGE_OK")
}
