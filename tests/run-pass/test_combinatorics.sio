//@ run-pass

// ---------------------------------------------------------------------------
// Combinatorics test suite — all helpers inlined, no imports
//
// Functions tested:
//   binomial, catalan_number, bell, partition_count, derangements,
//   falling_factorial, rising_factorial, harmonic
//
// References:
//   OEIS A000984 (central binomial), A000108 (Catalan), A000110 (Bell),
//   A000041 (partitions), A000166 (subfactorials)
// ---------------------------------------------------------------------------

// ============================================================================
// CHECKER HELPERS (must precede callers)
// ============================================================================

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn check_i64(got: i64, expected: i64, pass: &!i32, fail: &!i32) with IO {
    if got == expected {
        *pass = *pass + 1
    } else {
        *fail = *fail + 1
    }
}

fn check_f64(got: f64, expected: f64, tol: f64, pass: &!i32, fail: &!i32) with IO {
    let diff = abs_f64(got - expected)
    if diff < tol {
        *pass = *pass + 1
    } else {
        *fail = *fail + 1
    }
}

// ============================================================================
// COMBINATORICS FUNCTIONS
// ============================================================================

// Binomial coefficient C(n, k) via multiplicative formula.
// Returns i64. Assumes 0 <= k <= n.
fn binomial(n: i64, k: i64) -> i64 with Div {
    if k < 0 {
        return 0
    }
    if k > n {
        return 0
    }
    // Use symmetry: C(n, k) = C(n, n-k)
    var kk = k
    if kk > n - kk {
        kk = n - kk
    }
    var result: i64 = 1
    var i: i64 = 0
    while i < kk {
        result = result * (n - i)
        result = result / (i + 1)
        i = i + 1
    }
    result
}

// Catalan number C_n = binom(2n, n) / (n + 1)
fn catalan_number(n: i64) -> i64 with Div {
    if n < 0 {
        return 0
    }
    let b = binomial(2 * n, n)
    b / (n + 1)
}

// Bell number B(n) via Bell triangle.
// B(0) = 1, and uses the Bell triangle recurrence.
// Max n = 25 (fits in i64).
fn bell(n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    if n == 0 {
        return 1
    }
    // Bell triangle: row[0] = 1 initially
    // For each subsequent row, the first element is the last element of the
    // previous row, and each subsequent element is the sum of the element
    // to its left and the element above-left.
    //
    // We store only the current row in a flat array of size n+1.
    // B(n) is the first element of row n.
    var row: [i64; 26] = [0; 26]
    row[0] = 1
    var r: i64 = 1
    while r <= n {
        // Save row[r-1] as the new row[0]
        var prev_first = row[0]
        row[0] = row[r - 1]
        // Fill the rest of the row
        var j: i64 = 1
        while j <= r {
            var new_val = row[j - 1] + prev_first
            prev_first = row[j]
            row[j] = new_val
            j = j + 1
        }
        r = r + 1
    }
    row[0]
}

// Partition count p(n) via Euler's pentagonal number theorem.
// p(n) = sum_{k != 0} (-1)^{k+1} * p(n - k*(3k-1)/2)
// where k ranges over 1, -1, 2, -2, 3, -3, ...
fn partition_count(n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    if n == 0 {
        return 1
    }
    // Build table from 0..n
    var table: [i64; 256] = [0; 256]
    table[0] = 1
    var i: i64 = 1
    while i <= n {
        var sum: i64 = 0
        var k: i64 = 1
        var done = false
        while done == false {
            // Generalized pentagonal numbers: k*(3k-1)/2 and k*(3k+1)/2
            let pent1 = k * (3 * k - 1) / 2
            let pent2 = k * (3 * k + 1) / 2
            if pent1 > i {
                done = true
            } else {
                // sign: (-1)^{k+1} means + for odd k, - for even k
                let sign_val = if k % 2 == 1 { 1 } else { 0 - 1 }
                sum = sum + sign_val * table[i - pent1]
                if pent2 <= i {
                    sum = sum + sign_val * table[i - pent2]
                }
                k = k + 1
            }
        }
        table[i] = sum
        i = i + 1
    }
    table[n]
}

// Derangements (subfactorial) !n
// !0 = 1, !1 = 0, !n = (n-1) * (!(n-1) + !(n-2))
fn derangements(n: i64) -> i64 {
    if n == 0 {
        return 1
    }
    if n == 1 {
        return 0
    }
    var prev2: i64 = 1   // !(0)
    var prev1: i64 = 0   // !(1)
    var i: i64 = 2
    while i <= n {
        var current = (i - 1) * (prev1 + prev2)
        prev2 = prev1
        prev1 = current
        i = i + 1
    }
    prev1
}

// Falling factorial: n * (n-1) * ... * (n-k+1)
// Also written (n)_k or n^{underline k}
fn falling_factorial(n: i64, k: i64) -> i64 {
    if k <= 0 {
        return 1
    }
    var result: i64 = 1
    var i: i64 = 0
    while i < k {
        result = result * (n - i)
        i = i + 1
    }
    result
}

// Rising factorial (Pochhammer symbol): n * (n+1) * ... * (n+k-1)
// Also written n^{overline k} or (n)^(k)
fn rising_factorial(n: i64, k: i64) -> i64 {
    if k <= 0 {
        return 1
    }
    var result: i64 = 1
    var i: i64 = 0
    while i < k {
        result = result * (n + i)
        i = i + 1
    }
    result
}

// Harmonic number H_n = 1 + 1/2 + 1/3 + ... + 1/n
// Returns f64.
fn harmonic(n: i64) -> f64 {
    if n <= 0 {
        return 0.0
    }
    var sum = 0.0
    var i: i64 = 1
    while i <= n {
        sum = sum + 1.0 / (i as f64)
        i = i + 1
    }
    sum
}

// ============================================================================
// MAIN
// ============================================================================

fn main() -> i32 with IO, Mut, Panic, Div {
    var pass = 0
    var fail = 0

    // 1. binomial(10, 3) = 120
    check_i64(binomial(10, 3), 120, &!pass, &!fail)
    // 2. binomial(20, 10) = 184756
    check_i64(binomial(20, 10), 184756, &!pass, &!fail)
    // 3. binomial(0, 0) = 1
    check_i64(binomial(0, 0), 1, &!pass, &!fail)
    // 4. binomial(5, 0) = 1
    check_i64(binomial(5, 0), 1, &!pass, &!fail)
    // 5. binomial(5, 5) = 1
    check_i64(binomial(5, 5), 1, &!pass, &!fail)

    // 6. catalan_number(0) = 1
    check_i64(catalan_number(0), 1, &!pass, &!fail)
    // 7. catalan_number(5) = 42
    check_i64(catalan_number(5), 42, &!pass, &!fail)
    // 8. catalan_number(10) = 16796
    check_i64(catalan_number(10), 16796, &!pass, &!fail)

    // 9. bell(0) = 1
    check_i64(bell(0), 1, &!pass, &!fail)
    // 10. bell(5) = 52
    check_i64(bell(5), 52, &!pass, &!fail)
    // 11. bell(6) = 203
    check_i64(bell(6), 203, &!pass, &!fail)

    // 12. partition_count(0) = 1
    check_i64(partition_count(0), 1, &!pass, &!fail)
    // 13. partition_count(5) = 7
    check_i64(partition_count(5), 7, &!pass, &!fail)
    // 14. partition_count(10) = 42
    check_i64(partition_count(10), 42, &!pass, &!fail)

    // 15. derangements(0) = 1
    check_i64(derangements(0), 1, &!pass, &!fail)
    // 16. derangements(1) = 0
    check_i64(derangements(1), 0, &!pass, &!fail)
    // 17. derangements(5) = 44
    check_i64(derangements(5), 44, &!pass, &!fail)

    // 18. falling_factorial(5, 3) = 5*4*3 = 60
    check_i64(falling_factorial(5, 3), 60, &!pass, &!fail)

    // 19. rising_factorial(5, 3) = 5*6*7 = 210
    check_i64(rising_factorial(5, 3), 210, &!pass, &!fail)

    // 20. harmonic(1) = 1.0
    check_f64(harmonic(1), 1.0, 1.0e-10, &!pass, &!fail)
    // 21. harmonic(10) = 2.9289682539682538...
    check_f64(harmonic(10), 2.9289682539682538, 1.0e-10, &!pass, &!fail)

    if fail > 0 {
        return 1
    }
    0
}
