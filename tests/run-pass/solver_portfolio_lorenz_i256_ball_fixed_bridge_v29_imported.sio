//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v29 Lorenz i256-to-ball-fixed bridge receipt smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v29_lorenz_i256_ball_fixed_bridge_instance_fingerprint(
        32, 4294967296, 1000000, 214180161,
        5309941770, 10058731223, 4084837935)
    if instance_fp != 149359034 { return 1 }

    let certificate_fp = solver_portfolio_v29_lorenz_i256_ball_fixed_bridge_certificate_fingerprint(
        instance_fp, 890086395, 607091799, 114244647, 166945519, 7)
    if certificate_fp != 138609006 { return 2 }

    let audit_fp = solver_portfolio_v29_lorenz_i256_ball_fixed_bridge_audit_fingerprint(
        instance_fp, certificate_fp, 326517892, 291678314, 413118064, 31)
    if audit_fp != 488107916 { return 3 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lorenz_i256_ball_fixed_bridge(),
        instance_fp,
        audit_fp,
        portfolio_result_validated(),
        portfolio_checker_lorenz_i256_ball_fixed_bridge())
    if entry_fp != 916832909 { return 4 }

    let manifest_fp = solver_portfolio_v29_lorenz_i256_ball_fixed_bridge_bundle_fingerprint(
        instance_fp, audit_fp)
    if manifest_fp != 137630154 { return 5 }

    let result_coverage_fp = solver_portfolio_v29_result_coverage_fingerprint(
        29, 33, 10, 21, 1, 1, manifest_fp)
    if result_coverage_fp != 904709304 { return 6 }

    let family_coverage_fp = solver_portfolio_v29_checker_family_coverage_fingerprint(
        29, 33, 6, 3, 2, 1, 21, manifest_fp)
    if family_coverage_fp != 70534950 { return 7 }

    let acceptance_fp = solver_portfolio_v29_acceptance_receipt_fingerprint(
        29, manifest_fp, result_coverage_fp)
    if acceptance_fp != 685946948 { return 8 }

    let audit_receipt_fp = solver_portfolio_v29_audit_receipt_fingerprint(
        29, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_receipt_fp != 493502604 { return 9 }

    let readiness_fp = solver_portfolio_v29_readiness_fingerprint(
        29, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_receipt_fp)
    if readiness_fp != 182721636 { return 10 }

    if solver_portfolio_v29_lorenz_i256_ball_fixed_bridge_bundle_fingerprint(
        instance_fp, audit_fp + 1) != (0 - 1) { return 11 }
    if solver_portfolio_v29_result_coverage_fingerprint(
        29, 33, 10, 20, 1, 1, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v29_checker_family_coverage_fingerprint(
        29, 33, 6, 3, 2, 1, 20, manifest_fp) != (0 - 1) { return 13 }
    if solver_portfolio_v29_readiness_fingerprint(
        29, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_receipt_fp + 1) != (0 - 1) { return 14 }

    return 0
}
