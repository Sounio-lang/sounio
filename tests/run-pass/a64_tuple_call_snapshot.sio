//@ run-pass
//@ expect-stdout: 0 1
//@ description: tuple result scalars survive a later call of the same method
struct TupleCounter { n: i64 }
impl TupleCounter {
    fn fresh(self) -> (TupleCounter, i64) with Mut {
        var c = self
        let old = c.n
        c.n = old + 1
        (c, old)
    }
}
fn main() with IO, Mut, Panic {
    var c = TupleCounter { n: 0 }
    let a = c.fresh()
    c = a.0
    let b = c.fresh()
    c = b.0
    print_int(a.1)
    print(" ")
    print_int(b.1)
    print("\n")
}
