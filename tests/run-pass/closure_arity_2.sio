//@ run-pass
//@ expect-stdout: PASS
// Plan-named fixture: arity-2 closure literal (Slice B SOTA gate).
// Verifies `|x, y| body` parses, type-checks, and lowers correctly,
// both for direct call and when passed to a fn(i64,i64)->i64 HOF.

fn apply2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 with Mut, Panic, Div {
    f(a, b)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    // Direct call, no capture
    let f = |x: i64, y: i64| x + y * 2
    assert(f(3, 4) == 11)

    // Direct call with capture
    let scale = 3
    let g = |x: i64, y: i64| (x + y) * scale
    assert(g(2, 5) == 21)

    // Arity-2 closure passed to HOF (capture-free)
    let r1 = apply2(|x: i64, y: i64| x + y * 2, 3, 4)
    assert(r1 == 11)

    // Arity-2 closure passed to HOF (capturing)
    let bias = 100
    let r2 = apply2(|x: i64, y: i64| x * y + bias, 5, 6)
    assert(r2 == 130)

    print("PASS\n")
    0
}
