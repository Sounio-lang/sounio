//@ run-pass
// O 168 é estrutura ou coincidência? Mede a contagem de triplas com associador não nulo e o
// ESPECTRO da norma do associador, nos dois degraus da torre de Cayley-Dickson.
//
// O "Teorema 168" do projeto (citado em stdlib/cybernetic/psychiatry.sio) afirma, para
// OCTONIÕES: ‖[e_i, e_j, e_k]‖ ∈ {0, 2} exatamente — propriedade binária — e 168 triplas não
// nulas, que é |PSL(2,7)|, o grupo de automorfismos do plano de Fano.
//
// A medição em 𝕊 deu 1848 = 168 × 11. Este programa verifica se isso é relação real ou
// aritmética acidental, medindo os dois níveis com o MESMO código.

use algebra::sedenion::{sed_basis, sed_associator, sed_norm_sq}

fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

fn main() -> i64 with IO, Mut, Div, Panic {
    var ei: [f64; 16] = [0.0; 16]
    var ej: [f64; 16] = [0.0; 16]
    var ek: [f64; 16] = [0.0; 16]
    var assoc: [f64; 16] = [0.0; 16]

    // ── 1. OCTONIÕES, como subálgebra de 𝕊: índices 1..7.
    //     Deve reproduzir 168 se o Teorema 168 vale e se o embedding preserva o produto.
    var oct_nao_nulo: i64 = 0
    var oct_norma_4: i64 = 0        // ‖·‖² = 4 significa ‖·‖ = 2
    var oct_outra_norma: i64 = 0
    var i: i64 = 1
    while i < 8 {
        var j: i64 = 1
        while j < 8 {
            var k: i64 = 1
            while k < 8 {
                sed_basis(i, &!ei); sed_basis(j, &!ej); sed_basis(k, &!ek)
                sed_associator(&ei, &ej, &ek, &!assoc)
                let n2 = sed_norm_sq(&assoc)
                if n2 > 1.0e-18 {
                    oct_nao_nulo = oct_nao_nulo + 1
                    if abs_f64(n2 - 4.0) < 1.0e-9 { oct_norma_4 = oct_norma_4 + 1 }
                    else { oct_outra_norma = oct_outra_norma + 1 }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    print("OCT_TRIPLAS_NAO_NULAS "); print_int(oct_nao_nulo)
    print("OCT_COM_NORMA_2 "); print_int(oct_norma_4)
    print("OCT_COM_OUTRA_NORMA "); print_int(oct_outra_norma)

    // ── 2. SEDENIÕES: índices 1..15.
    var sed_nao_nulo: i64 = 0
    var sed_norma_4: i64 = 0
    var sed_outra: i64 = 0
    i = 1
    while i < 16 {
        var j2: i64 = 1
        while j2 < 16 {
            var k2: i64 = 1
            while k2 < 16 {
                sed_basis(i, &!ei); sed_basis(j2, &!ej); sed_basis(k2, &!ek)
                sed_associator(&ei, &ej, &ek, &!assoc)
                let n2 = sed_norm_sq(&assoc)
                if n2 > 1.0e-18 {
                    sed_nao_nulo = sed_nao_nulo + 1
                    if abs_f64(n2 - 4.0) < 1.0e-9 { sed_norma_4 = sed_norma_4 + 1 }
                    else { sed_outra = sed_outra + 1 }
                }
                k2 = k2 + 1
            }
            j2 = j2 + 1
        }
        i = i + 1
    }
    print("SED_TRIPLAS_NAO_NULAS "); print_int(sed_nao_nulo)
    print("SED_COM_NORMA_2 "); print_int(sed_norma_4)
    print("SED_COM_OUTRA_NORMA "); print_int(sed_outra)

    // ── 3. As razões, para separar estrutura de aritmética acidental.
    if oct_nao_nulo > 0 {
        print("RAZAO_SED_SOBRE_OCT "); print_int(sed_nao_nulo / oct_nao_nulo)
        print("RESTO_DA_DIVISAO "); print_int(sed_nao_nulo - (sed_nao_nulo / oct_nao_nulo) * oct_nao_nulo)
    }

    // ── 4. Quantas triplas de 𝕊 NÃO estão inteiramente na cópia octoniônica?
    //     Se a contagem sedeniônica fosse só "a octoniônica mais o resto", isso diria quanto
    //     do fenômeno nasce da duplicação e não da subálgebra.
    var sed_fora_da_copia: i64 = 0
    i = 1
    while i < 16 {
        var j3: i64 = 1
        while j3 < 16 {
            var k3: i64 = 1
            while k3 < 16 {
                if i >= 8 || j3 >= 8 || k3 >= 8 {
                    sed_basis(i, &!ei); sed_basis(j3, &!ej); sed_basis(k3, &!ek)
                    sed_associator(&ei, &ej, &ek, &!assoc)
                    if sed_norm_sq(&assoc) > 1.0e-18 { sed_fora_da_copia = sed_fora_da_copia + 1 }
                }
                k3 = k3 + 1
            }
            j3 = j3 + 1
        }
        i = i + 1
    }
    print("SED_NAO_NULAS_QUE_TOCAM_A_DUPLICACAO "); print_int(sed_fora_da_copia)

    println("associador 168: MEDIDO")
    0
}
