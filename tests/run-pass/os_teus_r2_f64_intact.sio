//@ run-pass
// R2 non-regression: f64 arithmetic must remain untouched. 0.1 + 0.2 on f64
// stays 0.30000000000000004 (no mask, no width rule).

fn main() with IO, Div, Panic {
    let x: f64 = 0.1 + 0.2
    let expected: f64 = 0.30000000000000004
    if x == expected {
        print("r2_f64_intact: PASS\n")
    } else {
        print("r2_f64_intact: FAIL\n")
    }
}
