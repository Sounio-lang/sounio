//@ run-pass
//@ requires: madaros
use crypto::aes::*
use crypto::gcm::*
use net::socket::*

fn main() -> i64 with IO {
    // GCM Test Case 16 (McGrew & Viega, "The Galois/Counter Mode of
    // Operation (GCM)"): AES-256, 96-bit IV, 60-byte plaintext, 20-byte
    // AAD -- the standard non-trivial AES-256-GCM vector.
    //
    // Independently re-verified 2026-08-25 directly against the
    // NIST-hosted primary source PDF (not from memory, not from a
    // secondhand transcription):
    //   https://csrc.nist.rip/groups/ST/toolkit/BCM/documents/proposedmodes/gcm/gcm-spec.pdf
    // Appendix "Test Case 16" table (K listed as two identical 16-byte
    // hex lines, i.e. a 256-bit key formed from the same 16-byte pattern
    // repeated twice; P/A/IV/C/T reassembled from the PDF's wrapped hex
    // columns and cross-checked for byte-length self-consistency: K=32B,
    // P=60B, A=20B, IV=12B, C=60B, T=16B, all as expected for this case).
    let key: [u8;32] = [
        0xfe,0xff,0xe9,0x92,0x86,0x65,0x73,0x1c,
        0x6d,0x6a,0x8f,0x94,0x67,0x30,0x83,0x08,
        0xfe,0xff,0xe9,0x92,0x86,0x65,0x73,0x1c,
        0x6d,0x6a,0x8f,0x94,0x67,0x30,0x83,0x08
    ]
    let plaintext_bytes: [u8;60] = [
        0xd9,0x31,0x32,0x25,0xf8,0x84,0x06,0xe5,
        0xa5,0x59,0x09,0xc5,0xaf,0xf5,0x26,0x9a,
        0x86,0xa7,0xa9,0x53,0x15,0x34,0xf7,0xda,
        0x2e,0x4c,0x30,0x3d,0x8a,0x31,0x8a,0x72,
        0x1c,0x3c,0x0c,0x95,0x95,0x68,0x09,0x53,
        0x2f,0xcf,0x0e,0x24,0x49,0xa6,0xb5,0x25,
        0xb1,0x6a,0xed,0xf5,0xaa,0x0d,0xe6,0x57,
        0xba,0x63,0x7b,0x39
    ]
    let aad_bytes: [u8;20] = [
        0xfe,0xed,0xfa,0xce,0xde,0xad,0xbe,0xef,
        0xfe,0xed,0xfa,0xce,0xde,0xad,0xbe,0xef,
        0xab,0xad,0xda,0xd2
    ]
    let nonce: [u8;12] = [
        0xca,0xfe,0xba,0xbe,0xfa,0xce,0xdb,0xad,
        0xde,0xca,0xf8,0x88
    ]
    let expected_ciphertext: [u8;60] = [
        0x52,0x2d,0xc1,0xf0,0x99,0x56,0x7d,0x07,
        0xf4,0x7f,0x37,0xa3,0x2a,0x84,0x42,0x7d,
        0x64,0x3a,0x8c,0xdc,0xbf,0xe5,0xc0,0xc9,
        0x75,0x98,0xa2,0xbd,0x25,0x55,0xd1,0xaa,
        0x8c,0xb0,0x8e,0x48,0x59,0x0d,0xbb,0x3d,
        0xa7,0xb0,0x8b,0x10,0x56,0x82,0x88,0x38,
        0xc5,0xf6,0x1e,0x63,0x93,0xba,0x7a,0x0a,
        0xbc,0xc9,0xf6,0x62
    ]
    let expected_tag: [u8;16] = [
        0x76,0xfc,0x6e,0xce,0x0f,0x4e,0x17,0x68,
        0xcd,0xdf,0x88,0x53,0xbb,0x2d,0x55,0x1b
    ]

    let round_keys = aes256_key_schedule(&key)

    let pt_buf = rawbuf_new(60 + 8)
    var i: i64 = 0
    while i < 60 { rawbuf_set(&pt_buf, i, plaintext_bytes[i as usize] as i64); i = i + 1 }
    let aad_buf = rawbuf_new(20 + 8)
    var a: i64 = 0
    while a < 20 { rawbuf_set(&aad_buf, a, aad_bytes[a as usize] as i64); a = a + 1 }

    let (sealed, sealed_len) = gcm_seal(&round_keys, &nonce, &pt_buf, 60, &aad_buf, 20)
    if sealed_len != 76 {   // 60 ciphertext + 16 tag
        print_int(1)
        return 1
    }
    var j: i64 = 0
    while j < 60 {
        if rawbuf_get(&sealed, j) != (expected_ciphertext[j as usize] as i64) {
            print_int(2)
            return 1
        }
        j = j + 1
    }
    var k: i64 = 0
    while k < 16 {
        if rawbuf_get(&sealed, 60 + k) != (expected_tag[k as usize] as i64) {
            print_int(3)
            return 1
        }
        k = k + 1
    }

    // Round-trip: gcm_open on our own sealed output must recover the
    // original plaintext and report ok=true.
    let (opened, ok) = gcm_open(&round_keys, &nonce, &sealed, sealed_len, &aad_buf, 20)
    if !ok {
        print_int(4)
        return 1
    }
    var m: i64 = 0
    while m < 60 {
        if rawbuf_get(&opened, m) != (plaintext_bytes[m as usize] as i64) {
            print_int(5)
            return 1
        }
        m = m + 1
    }

    // Adversarial: flip one tag byte, confirm gcm_open reports ok=false
    // and the returned plaintext is all-zero (fail-closed, per spec).
    rawbuf_set(&sealed, 60, (rawbuf_get(&sealed, 60) ^ 0xFF))
    let (opened_bad, ok_bad) = gcm_open(&round_keys, &nonce, &sealed, sealed_len, &aad_buf, 20)
    if ok_bad {
        print_int(6)
        return 1
    }
    var n: i64 = 0
    while n < 60 {
        if rawbuf_get(&opened_bad, n) != 0 {
            print_int(7)
            return 1
        }
        n = n + 1
    }

    println("gcm_seal_open_256: AES-256-GCM matches published test vector, round-trips, and fails closed on a tampered tag")
    return 0
}
