//@ run-pass
//
// Gradient Topology Types (GTT) — β⁹ week-7 stage-2 regression (match-arm union).
//
// Before this fix, `compile_stmt`'s match-expression handler (x86
// ~:16474, a64 ~:25456) compiled every arm body but did NOT propagate
// EXPR_CH_SET through them — each arm overwrote EXPR_CH_SET, so the
// result carried only the LAST-compiled arm's topology (typically the
// wildcard / else-like arm).
//
// Concretely, for
//
//     let k0 = measure(...)
//     let k1 = measure(...)
//     let opt: Option<i32> = Some(7)
//     let r = match opt {
//         Some(_) => k0.value,   // channel 0
//         None    => k1.value,   // channel 1
//     }
//     hessian_of(r, 0, 0)
//
// pre-fix left EXPR_CH_SET = {ch1} (last-compiled arm's), and H_{0,0}
// was REFUSED at type-check — a real soundness hole parallel to the
// week-6 `if`-arm leak.
//
// Post-fix: EXPR_CH_SET = match_scrut_ch_set | match_arms_ch_union.
// All three of H_{0,0}, H_{1,1}, H_{0,1} accepted.
//
// Theorem this commit catches up to: `Typing.tMatch` in
// formal/GradientTopology.lean §3 concludes at `Sc ∪ chsetUnionFin Ss`
// (week-7 stage 1, commit 58f14d44), which `gtt_sound` proves is a
// sound runtime-footprint upper bound via the n-ary analogue of the
// if-arm union proof.

fn main() with IO, Epistemic, Mut, Div {
    let k0: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let k1: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let x = k0.value       // channel 0
    let y = k1.value       // channel 1
    let opt: Option<i32> = Some(7)

    // Pre-fix: refused (channel 0 missing from leaked {ch1} tail).
    // Post-fix: accepted (union = {ch0, ch1}).
    let r = match opt {
        Some(_) => x,
        None    => y,
    }
    let h00 = hessian_of(r, 0, 0)
    let h11 = hessian_of(r, 1, 1)
    let h01 = hessian_of(r, 0, 1)

    println(h00)
    println(h11)
    println(h01)
}
