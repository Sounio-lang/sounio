//@ run-pass
//@ requires: madaros
//@ expect-stdout: ARRAY_CONCAT_OK
var GLOBAL_WORDS: [i64; 2] = [10,20]
struct Record { key:i64, values:[i64] }
fn integers()->bool with Mut,Alloc,Panic,Div {
    var a:[i64]=[1,2]
    var b:[i64]=[3,4]
    var joined=a++b
    if joined.len()!=4 {return false}
    joined[0]=99
    if a[0]!=1 || b[0]!=3 {return false}
    a[1]=88
    if joined[1]!=2 {return false}
    let from_global:[i64]=GLOBAL_WORDS++[30]
    if from_global.len()!=3 || from_global[0]!=10 || from_global[2]!=30 {return false}
    var many:[i64]=[]
    var i:i64=0
    while i<80 {many=many++[i];i=i+1}
    if many.len()!=80 {return false}
    i=0
    while i<80 {if many[i]!=i {return false};i=i+1}
    let empty:[i64]=[]
    let still_empty=empty++empty
    still_empty.len()==0
}
fn scalars()->bool with Mut,Alloc,Panic,Div {
    let f=[1.25,-2.5]++[6.25]
    let empty_first=[]++[1.25]
    if empty_first[0]!=1.25 {return false}
    var text_source:[string]=["first"]
    let text_copy=text_source++["last"]
    if text_copy[0]!="first" || text_copy[1]!="last" {return false}
    if f.len()!=3 || f[0]!=1.25 || f[1]!=-2.5 || f[2]!=6.25 {return false}
    let text=["first"]++["middle","last"]
    if text.len()!=3 {return false}
    text[0]=="first" && text[1]=="middle" && text[2]=="last"
}
fn make_records()->[Record] with Mut,Alloc,Panic,Div {
    var out:[Record]=[]
    var i:i64=0
    while i<80 {
        out=out++[Record{key:i,values:[i,i+100]}]
        i=i+1
    }
    out
}
fn records()->bool with Mut,Alloc,Panic,Div {
    var original:[Record]=[Record{key:7,values:[11,12]}]
    var copied=original++[]
    copied[0].values[0]=99
    if original[0].values[0]!=11 {return false}
    original[0].values[1]=88
    if copied[0].values[1]!=12 {return false}
    let rows=make_records()
    let churn=make_records()
    if rows.len()!=80 || churn.len()!=80 {return false}
    var i:i64=0
    while i<80 {
        if rows[i].key!=i || rows[i].values[0]!=i || rows[i].values[1]!=i+100 {return false}
        i=i+1
    }
    true
}
fn main()->i32 with IO,Mut,Alloc,Panic,Div {
    if !integers() {return 1}
    if !scalars() {return 2}
    if !records() {return 3}
    println("ARRAY_CONCAT_OK")
    0
}
