//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v118 smoke for Lorenz i256 step-2 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1831
    receipt_fp = mix(receipt_fp, 444092349, 5801)
    receipt_fp = mix(receipt_fp, 625429438, 5801)
    receipt_fp = mix(receipt_fp, 672985867, 5801)
    receipt_fp = mix(receipt_fp, 261444715, 5801)
    receipt_fp = mix(receipt_fp, 177395598, 5801)
    receipt_fp = mix(receipt_fp, 213780817, 5801)
    receipt_fp = mix(receipt_fp, 625305600, 5801)
    receipt_fp = mix(receipt_fp, 443171640, 5801)
    receipt_fp = mix(receipt_fp, 790224648, 5801)
    receipt_fp = mix(receipt_fp, 2, 5801)
    receipt_fp = mix(receipt_fp, 5, 5801)
    receipt_fp = mix(receipt_fp, 127, 5801)
    if receipt_fp != 264692547 { return 1 }

    var audit_fp: i64 = 1837
    audit_fp = mix(audit_fp, receipt_fp, 5807)
    audit_fp = mix(audit_fp, 444092349, 5807)
    audit_fp = mix(audit_fp, 625429438, 5807)
    audit_fp = mix(audit_fp, 672985867, 5807)
    audit_fp = mix(audit_fp, 261444715, 5807)
    audit_fp = mix(audit_fp, 443171640, 5807)
    audit_fp = mix(audit_fp, 790224648, 5807)
    audit_fp = mix(audit_fp, 625305600, 5807)
    audit_fp = mix(audit_fp, 2, 5807)
    audit_fp = mix(audit_fp, 5, 5807)
    audit_fp = mix(audit_fp, 127, 5807)
    if audit_fp != 82020601 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 121, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 121, 1103)
    if entry_fp != 296443716 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 118, 1151)
    manifest_fp = mix(manifest_fp, 122, 1151)
    manifest_fp = mix(manifest_fp, 213780817, 1151)
    manifest_fp = mix(manifest_fp, 177395598, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 56035538 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 118, 1871)
    result_fp = mix(result_fp, 122, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 110, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 531796809 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 118, 1907)
    family_fp = mix(family_fp, 122, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 105, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 501851088 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 118, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 206065887 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 118, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 838517422 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 118, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 210859660 { return 9 }
    return 0
}
