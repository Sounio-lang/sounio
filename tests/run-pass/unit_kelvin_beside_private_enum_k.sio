//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: KELVIN_OK 42 3000.000000
//
// Review of #3743, item 1: a user type shadows a unit only where the type is
// visible. The imported leaf declares a private `enum K` and uses it; here `K`
// is still kelvin. Before the scoped rule, the leaf's enum leaked into this
// module (`t + t` on K was E004), and on main the leaf's own `K` resolved as
// kelvin inside the leaf (E009).
use fixtures::kenum_private_leaf::{leaf_answer}

fn twice_k(t: K) -> K { t + t }

fn main() -> i64 with IO, Mut {
    let t: K = 1500.0
    let u = twice_k(t)
    print("KELVIN_OK "); print_int(leaf_answer()); print(" "); print_f64(u as f64); print("\n")
    0
}
