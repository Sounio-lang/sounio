//@ run-pass

extern "C" {
    fn sqrt(x: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn log(x: f64) -> f64;
}

fn math_wrapper(x: f64) -> f64 {
    let rooted = sqrt(x)
    let raised = exp(x)
    return rooted + log(raised)
}

fn main() -> i32 with IO, Mut, Div, Panic {
    let value = math_wrapper(1.0)
    if value <= 0.0 { return 1 }
    print("EXTERN_C_MATH_INTRINSICS_OK\n")
    return 0
}
