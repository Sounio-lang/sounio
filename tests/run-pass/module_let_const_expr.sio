//@ run-pass
// Module-level `let` constants with EXPRESSION initializers must carry the folded value.
// Found 2026-09-01 through the e-graph Q-certificate self-tests: the lean_single seed read
// `0 - 1` as 0 (dropping everything after the first literal), which made EG_INVALID == 0 in
// every source-built Madaros and silently discarded the first node of every small e-graph;
// Madaros' own folder lacked shifts (`1 << 3` -> BSS zero). Every case below is checked
// against an in-function computation of the same expression.
let C_NEG: i64 = 0 - 1
let C_NEGLIT: i64 = -1
let C_SUM: i64 = 1 + 1
let C_MULP: i64 = (2 + 3) * 4
let C_PREC: i64 = 2 + 3 * 4
let C_SHL: i64 = 1 << 3
let C_SHR: i64 = 256 >> 4
let C_REM: i64 = 7 % 4
let C_AND: i64 = 6 & 3
let C_OR: i64 = 6 | 1
let C_XOR: i64 = 6 ^ 3
let C_BIG: i64 = 0 - 800001
let C_CHAIN: i64 = 0 - 1 - 1

fn main() -> i32 with IO {
    var bad: i64 = 0
    if C_NEG != 0 - 1 { println("FAIL C_NEG"); bad = bad + 1 }
    if C_NEGLIT != 0 - 1 { println("FAIL C_NEGLIT"); bad = bad + 1 }
    if C_SUM != 2 { println("FAIL C_SUM"); bad = bad + 1 }
    if C_MULP != 20 { println("FAIL C_MULP"); bad = bad + 1 }
    if C_PREC != 14 { println("FAIL C_PREC"); bad = bad + 1 }
    if C_SHL != 8 { println("FAIL C_SHL"); bad = bad + 1 }
    if C_SHR != 16 { println("FAIL C_SHR"); bad = bad + 1 }
    if C_REM != 3 { println("FAIL C_REM"); bad = bad + 1 }
    if C_AND != 2 { println("FAIL C_AND"); bad = bad + 1 }
    if C_OR != 7 { println("FAIL C_OR"); bad = bad + 1 }
    if C_XOR != 5 { println("FAIL C_XOR"); bad = bad + 1 }
    if C_BIG != 0 - 800001 { println("FAIL C_BIG"); bad = bad + 1 }
    if C_CHAIN != 0 - 2 { println("FAIL C_CHAIN"); bad = bad + 1 }
    // The e-graph consequence, in miniature: an id of 0 must NOT compare equal to the sentinel.
    let id: i64 = 0
    if id == C_NEG { println("FAIL sentinel: 0 == C_NEG"); bad = bad + 1 }
    if bad == 0 { println("module_let_const_expr: OK") }
    bad as i32
}
