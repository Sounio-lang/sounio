//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: CHECKED CACHED RANK FAR PASS
use stats::regression::nb2_likelihood::{Nb2CachedLikelihoodDifferenceSlot,nb2_cached_likelihood_difference_slot,nb2_likelihood_difference_slot,nb2_log_probability_rank_cached_difference_into,nb2_log_probability_rank_difference_into,nb2_cached_likelihood_difference_snapshot,nb2_likelihood_difference_snapshot,nb2_cached_likelihood_difference_full_calls}
fn far(index:i64,count:i64,m0:f64,a0:f64,m1:f64,a1:f64,want:i64,slot:&!Nb2CachedLikelihoodDifferenceSlot) with IO,Mut,Div,Panic {
 var old=nb2_likelihood_difference_slot()
 let old_status:i64=nb2_log_probability_rank_difference_into(count,m0,a0,m1,a1,&!old)
 let status:i64=nb2_log_probability_rank_cached_difference_into(count,m0,a0,m1,a1,slot)
 let saved=nb2_cached_likelihood_difference_snapshot(slot)
 let baseline=nb2_likelihood_difference_snapshot(&old)
 assert(status==want && old_status==want)
 let value:f64=saved.value
 let old_value:f64=baseline.value
 assert(f64_to_bits(value)==f64_to_bits(old_value))
 assert(saved.status==baseline.status && saved.first_status==baseline.first_status && saved.second_status==baseline.second_status && saved.local_increment==baseline.local_increment)
 let bits:i64=f64_to_bits(value)
 let first:i64=saved.first_status
 let second:i64=saved.second_status
 let local:i64=if saved.local_increment {1}else{0}
 let calls:i64=nb2_cached_likelihood_difference_full_calls(slot)
 print("CACHED_FAR ");print(index);print(" ");print(status);print(" ");print(bits);print(" ");print(first);print(" ");print(second);print(" ");print(local);print(" ");println(calls)
}
fn main()->i32 with IO,Mut,Div,Panic {
 var slot=nb2_cached_likelihood_difference_slot()
 far(0,4,4.0,0.5,40.0,0.75,0,&!slot)
 far(1,4,5.0,0.5,50.0,0.75,0,&!slot)
 far(2,4,40.0,0.75,4.0,0.5,0,&!slot)
 far(3,63,4.0,0.5,40.0,0.75,0,&!slot)
 far(4,64,4.0,0.5,40.0,0.75,0,&!slot)
 far(5,1,1.0,1e-200,1.0,2e-200,5,&!slot)
 far(6,0,2.0,0.0,3.0,0.0,0,&!slot)
 far(7,0,3.0,0.0,2.0,0.0,0,&!slot)
 println("CHECKED CACHED RANK FAR PASS")
 0
}
