//@ run-pass
// FIXED (A8, 2026-07-06). Bisection witness (imported big_zero direct + big_basis forward). RUN rc=0.
// Cross-module, step-instrumented. Prints between each imported call so we can
// see WHICH cross-module large-struct-returning call segfaults. RESULT: big_zero
// (direct construct) prints OK; big_basis (forwards `var r = big_zero(k)`) SIGSEGVs.
// See docs/handoff/continuity/A8_CROSSMOD_FORWARDING_MISCOMPILE.md

use testmod::sret_min::{Big, big_zero, big_basis, big_add}

fn main() -> i64 with IO, Mut, Panic {
    println("STEP_start")
    let z = big_zero(4)
    println("STEP_after_big_zero")
    print_int(z.bits as i64)
    print("\n")
    print_int(z.c[0])
    print("\n")
    println("STEP_after_read_zero")
    let a = big_basis(4, 1)
    println("STEP_after_basis_a")
    print_int(a.c[1])
    print("\n")
    let b = big_basis(4, 2)
    println("STEP_after_basis_b")
    let s = big_add(a, b)
    println("STEP_after_add")
    print_int(s.c[1])
    print("\n")
    print_int(s.c[2])
    print("\n")
    println("STEP_done")
    return 0
}
