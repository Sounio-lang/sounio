//@ run-pass
// stack_basic.sio — Tests for Stack64 fixed-capacity stack
// All definitions inlined (tests cannot import stdlib).
//
// T1: new stack is empty
// T2: push 3 items, size=3
// T3: pop returns last pushed value
// T4: peek doesn't change size
// T5: pop on empty returns -1

// ============================================================================
// Inlined definitions
// ============================================================================

struct Stack64 { data: [i64; 64], top: i64 }

fn stack_new() -> Stack64 with Mut {
    Stack64 { data: [0; 64], top: 0 }
}

fn stack_push(s: &! Stack64, val: i64) -> bool with Mut {
    if s.top >= 64 { return false }
    s.data[s.top as usize] = val
    s.top = s.top + 1
    true
}

fn stack_pop(s: &! Stack64) -> i64 with Mut {
    if s.top <= 0 { return 0 - 1 }
    s.top = s.top - 1
    s.data[s.top as usize]
}

fn stack_peek(s: &Stack64) -> i64 {
    if s.top <= 0 { return 0 - 1 }
    s.data[(s.top - 1) as usize]
}

fn stack_empty(s: &Stack64) -> bool { s.top == 0 }

fn stack_size(s: &Stack64) -> i64 { s.top }

// ============================================================================
// Tests
// ============================================================================

fn main() -> i32 with IO, Mut, Panic {
    var passed: i32 = 0
    var failed: i32 = 0

    // T1: new stack is empty
    let s1 = stack_new()
    if stack_empty(&s1) { passed = passed + 1 } else { failed = failed + 1; println("FAIL T1") }

    // T2: push 3 items, size=3
    var s2 = stack_new()
    let _ = stack_push(&! s2, 10)
    let _ = stack_push(&! s2, 20)
    let _ = stack_push(&! s2, 30)
    if stack_size(&s2) == 3 { passed = passed + 1 } else { failed = failed + 1; println("FAIL T2") }

    // T3: pop returns last pushed value
    var s3 = stack_new()
    let _ = stack_push(&! s3, 100)
    let _ = stack_push(&! s3, 200)
    let _ = stack_push(&! s3, 300)
    let v3 = stack_pop(&! s3)
    if v3 == 300 { passed = passed + 1 } else { failed = failed + 1; println("FAIL T3") }

    // T4: peek doesn't change size
    var s4 = stack_new()
    let _ = stack_push(&! s4, 42)
    let _ = stack_push(&! s4, 99)
    let peeked = stack_peek(&s4)
    let sz4 = stack_size(&s4)
    if peeked == 99 && sz4 == 2 { passed = passed + 1 } else { failed = failed + 1; println("FAIL T4") }

    // T5: pop on empty returns -1
    var s5 = stack_new()
    let v5 = stack_pop(&! s5)
    if v5 == 0 - 1 { passed = passed + 1 } else { failed = failed + 1; println("FAIL T5") }

    if failed == 0 {
        println("ALL 5 TESTS PASSED")
        return 0
    }
    return 1
}
