//@ run-pass
//@ expect-stdout-contains: sret_8field: PASS
//@ native-pass

struct S8 { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64 }

fn make_s8(base: i64) -> S8 {
    S8 { a: base, b: base + 1, c: base + 2, d: base + 3, e: base + 4, f: base + 5, g: base + 6, h: base + 7 }
}

fn step(s: S8) -> S8 {
    S8 { a: s.a + 10, b: s.b + 10, c: s.c + 10, d: s.d + 10, e: s.e + 10, f: s.f + 10, g: s.g + 10, h: s.h + 10 }
}

fn main() with IO {
    var s = make_s8(0)
    s = step(s)
    s = step(s)
    if s.a == 20 && s.b == 21 && s.c == 22 && s.d == 23 && s.e == 24 && s.f == 25 && s.g == 26 && s.h == 27 {
        print("sret_8field: PASS\n")
    } else {
        print("sret_8field: FAIL\n")
    }
}
