//@ run-pass

use graphics::surface::{surface_new, surface_get_pixel_r, surface_get_pixel_g, surface_get_pixel_b}
use graphics::quality::{plot_violin_raster_smooth, quality_violin_plot_config_default}

fn is_dark(r: i64, g: i64, b: i64) -> bool {
    r < 55 && g < 65 && b < 85
}

fn is_violin_fill(r: i64, g: i64, b: i64) -> bool {
    r > 160 && r < 230 && g > 195 && b > 200
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var s = surface_new(84, 84)
    var ys: [f64; 256] = [0.0; 256]
    var density: [f64; 256] = [0.0; 256]
    ys[0] = 0.0
    ys[1] = 0.5
    ys[2] = 1.0
    density[0] = 0.2
    density[1] = 1.0
    density[2] = 0.2

    s = plot_violin_raster_smooth(
        s,
        &ys,
        &density,
        3,
        quality_violin_plot_config_default()
    )

    let mid_r = surface_get_pixel_r(&s, 42, 41)
    let mid_g = surface_get_pixel_g(&s, 42, 41)
    let mid_b = surface_get_pixel_b(&s, 42, 41)
    if !is_violin_fill(mid_r, mid_g, mid_b) {
        print("FAIL violin center fill missing\n")
        return 1
    }

    let left_fill_r = surface_get_pixel_r(&s, 30, 41)
    let left_fill_g = surface_get_pixel_g(&s, 30, 41)
    let left_fill_b = surface_get_pixel_b(&s, 30, 41)
    if !is_violin_fill(left_fill_r, left_fill_g, left_fill_b) {
        print("FAIL violin left lobe fill missing\n")
        return 2
    }

    let right_fill_r = surface_get_pixel_r(&s, 54, 41)
    let right_fill_g = surface_get_pixel_g(&s, 54, 41)
    let right_fill_b = surface_get_pixel_b(&s, 54, 41)
    if !is_violin_fill(right_fill_r, right_fill_g, right_fill_b) {
        print("FAIL violin right lobe fill missing\n")
        return 3
    }

    var outline_pixels = 0
    var y = 38
    while y <= 44 {
        let lr = surface_get_pixel_r(&s, 26, y)
        let lg = surface_get_pixel_g(&s, 26, y)
        let lb = surface_get_pixel_b(&s, 26, y)
        let rr = surface_get_pixel_r(&s, 58, y)
        let rg = surface_get_pixel_g(&s, 58, y)
        let rb = surface_get_pixel_b(&s, 58, y)
        if is_dark(lr, lg, lb) {
            outline_pixels = outline_pixels + 1
        }
        if is_dark(rr, rg, rb) {
            outline_pixels = outline_pixels + 1
        }
        y = y + 1
    }
    if outline_pixels < 2 {
        print("FAIL violin outline missing\n")
        return 4
    }

    let top_r = surface_get_pixel_r(&s, 42, 20)
    let top_g = surface_get_pixel_g(&s, 42, 20)
    let top_b = surface_get_pixel_b(&s, 42, 20)
    if !is_violin_fill(top_r, top_g, top_b) && !is_dark(top_r, top_g, top_b) {
        print("FAIL violin narrow top missing\n")
        return 5
    }

    let outside_l = surface_get_pixel_r(&s, 22, 41)
    let outside_r = surface_get_pixel_r(&s, 62, 41)
    if outside_l < 240 || outside_r < 240 {
        print("FAIL violin painted outside expected lobe\n")
        return 6
    }

    print("PASS graphics_quality_violin_smoke\n")
    0
}
