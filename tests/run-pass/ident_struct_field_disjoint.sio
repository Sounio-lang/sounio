//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_STRUCT_FIELD_DISJOINT_PASS
//
// Prediction (struct field round trip, aleatory disjoint):
// Storing `a` and `b` in distinct fields of `Holder` keeps per-field source
// sets on the binding `h`. Reading `h.k` and combining with `b` (or `h.other`)
// is provably disjoint and accepted; straight-line store `m.k = b` also tracks
// `{b}` so `m.k + a` is accepted.

struct Holder {
    k: Knowledge<f64>,
    other: Knowledge<f64>,
}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let b = measure(5.0, uncertainty: 2.0)
    let h = Holder { k: a, other: b }
    let r1 = h.k + b
    let r2 = h.k + h.other
    let z = Knowledge(0.0, ε = 0.05)
    var m = Holder { k: z, other: a }
    m.k = b
    let r3 = m.k + a
    var d1 = r1.variance - 5.0
    if d1 < 0.0 { d1 = 0.0 - d1 }
    var d2 = r2.variance - 5.0
    if d2 < 0.0 { d2 = 0.0 - d2 }
    var d3 = r3.variance - 5.0
    if d3 < 0.0 { d3 = 0.0 - d3 }
    if d1 > 1.0e-12 || d2 > 1.0e-12 || d3 > 1.0e-12 {
        return 1
    }
    println("IDENT_STRUCT_FIELD_DISJOINT_PASS")
    0
}
