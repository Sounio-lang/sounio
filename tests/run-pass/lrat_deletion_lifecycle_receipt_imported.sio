//@ run-pass
//@ description: Imported LRAT deletion lifecycle receipt smoke

use theorem::lrat::*

fn main() -> i64 with Mod {
    let manifest_fp = lrat_deletion_lifecycle_manifest_fingerprint(3, 2, 2, 4, 5, 0)
    if manifest_fp != 6950141 { return 1 }

    let audit_fp = lrat_deletion_lifecycle_audit_fingerprint(manifest_fp, 4, 5, 0, 1, 2, 1)
    if audit_fp != 109354544 { return 2 }

    let envelope_fp = lrat_deletion_lifecycle_unsat_envelope_fingerprint(manifest_fp, audit_fp, 5, 0, 2, 1)
    if envelope_fp != 9126320 { return 3 }

    if lrat_deletion_lifecycle_manifest_fingerprint(3, 2, 1, 4, 5, 0) != (0 - 1) { return 4 }
    if lrat_deletion_lifecycle_audit_fingerprint(manifest_fp, 4, 5, 0, 1, 1, 1) != (0 - 1) { return 5 }
    if lrat_deletion_lifecycle_unsat_envelope_fingerprint(manifest_fp, audit_fp, 5, 1, 2, 1) != (0 - 1) { return 6 }

    return 0
}
