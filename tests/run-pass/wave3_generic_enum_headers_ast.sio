//@ run-pass
//@ requires: madaros
//@ expect-stdout: GENERIC_ENUM_HEADERS_AST_OK
use compiler::module_parse::{load_module_file};
use parser::ast::*;
fn main()->i32 with IO,Alloc,Mut,Div,Panic {
    let program=load_module_file("tests/fixtures/wave3_generic_enum/headers.sio")
    match program.items {
        Some(first)=>{
            match (*first).head.enum_def {
                Some(ed)=>{
                    match (*ed).type_params {
                        Some(tp)=>{
                            if !name_eq((*tp).head.name,make_name("T")) {return 1}
                            match (*tp).tail {Some(_)=>{return 2},None=>{}}
                        }
                        None=>{return 3}
                    }
                }
                None=>{return 4}
            }
            match (*first).tail {
                Some(second)=>{
                    match (*second).head.enum_def {
                        Some(ed)=>{
                            match (*ed).type_params {
                                Some(t)=>{
                                    if !name_eq((*t).head.name,make_name("T")) {return 5}
                                    match (*t).tail {
                                        Some(e)=>{
                                            if !name_eq((*e).head.name,make_name("E")) {return 6}
                                            match (*e).tail {Some(_)=>{return 7},None=>{}}
                                        }
                                        None=>{return 8}
                                    }
                                }
                                None=>{return 9}
                            }
                        }
                        None=>{return 10}
                    }
                    match (*second).tail {
                        Some(third)=>{
                            match (*third).head.enum_def {
                                Some(ed)=>{
                                    match (*ed).variants {
                                        Some(v)=>{
                                            var fields=(*v).head.fields
                                            var i:i64=0
                                            while i<9 {
                                                match fields {
                                                    Some(f)=>{
                                                        var expected=make_name("_0")
                                                        expected.buf[1]=(48+i) as i8
                                                        if !name_eq((*f).head.name,expected) {return 11}
                                                        fields=(*f).tail
                                                    }
                                                    None=>{return 12}
                                                }
                                                i=i+1
                                            }
                                            match fields {Some(_)=>{return 13},None=>{}}
                                        }
                                        None=>{return 14}
                                    }
                                }
                                None=>{return 15}
                            }
                        }
                        None=>{return 16}
                    }
                }
                None=>{return 17}
            }
        }
        None=>{return 18}
    }
    println("GENERIC_ENUM_HEADERS_AST_OK")
    0
}
