//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v89 smoke for Lorenz i256 step-4 Taylor-2 completed candidate bundle

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1867
    receipt_fp = mix(receipt_fp, 389227567, 5843)
    receipt_fp = mix(receipt_fp, 234665993, 5843)
    receipt_fp = mix(receipt_fp, 526525910, 5843)
    receipt_fp = mix(receipt_fp, 109012640, 5843)
    receipt_fp = mix(receipt_fp, 347927442, 5843)
    receipt_fp = mix(receipt_fp, 2529965, 5843)
    receipt_fp = mix(receipt_fp, 328442325, 5843)
    receipt_fp = mix(receipt_fp, 700260810, 5843)
    receipt_fp = mix(receipt_fp, 747893368, 5843)
    receipt_fp = mix(receipt_fp, 4, 5843)
    receipt_fp = mix(receipt_fp, 4, 5843)
    receipt_fp = mix(receipt_fp, 255, 5843)
    if receipt_fp != 634222760 { return 1 }

    var audit_fp: i64 = 1871
    audit_fp = mix(audit_fp, receipt_fp, 5849)
    audit_fp = mix(audit_fp, 389227567, 5849)
    audit_fp = mix(audit_fp, 234665993, 5849)
    audit_fp = mix(audit_fp, 526525910, 5849)
    audit_fp = mix(audit_fp, 109012640, 5849)
    audit_fp = mix(audit_fp, 700260810, 5849)
    audit_fp = mix(audit_fp, 747893368, 5849)
    audit_fp = mix(audit_fp, 328442325, 5849)
    audit_fp = mix(audit_fp, 4, 5849)
    audit_fp = mix(audit_fp, 4, 5849)
    audit_fp = mix(audit_fp, 255, 5849)
    if audit_fp != 483096477 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 92, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 92, 1103)
    if entry_fp != 453220610 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 89, 1151)
    manifest_fp = mix(manifest_fp, 93, 1151)
    manifest_fp = mix(manifest_fp, 2529965, 1151)
    manifest_fp = mix(manifest_fp, 347927442, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 109460759 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 89, 1871)
    result_fp = mix(result_fp, 93, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 81, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 657673923 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 89, 1907)
    family_fp = mix(family_fp, 93, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 76, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 856340320 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 89, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 905773864 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 89, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 482417275 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 89, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 909105361 { return 9 }
    return 0
