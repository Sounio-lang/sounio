//@ run-pass
//@ expect-stdout: A_ENERGY=1.500000
//@ expect-stdout: A_TWICE=3.000000
//@ expect-stdout: B_OTHER=-14.500000
//@ expect-stdout: B_SHADOW=-62.500000
//@ description: #2773 -- a module's unqualified call to its own pub fn runs its own body, not a same-named fn the main file imported from another module.
//
// testmod::nr_a and testmod::nr_b (stdlib/testmod/) both define pub
// `nr_energy` and `nr_scale`. This file imports nr_a's `nr_energy`. Before
// #2773 the merged IR held ONE `nr_energy` (first-loaded: nr_a), so nr_b's own
// `nr_energy()` / `nr_scale()` calls ran nr_a's bodies: B_OTHER printed 3.0 and
// B_SHADOW 5.0 -- compiled clean, ran, plausible, wrong.
//
// B_SHADOW also pins local scoping in the rebinding pass: in nr_b,
// `let nr_energy = nr_energy() + 1.0` calls the fn in its initializer and then
// shadows it; the later `nr_energy` is the local.
//
// Both engines: lean_single resolves it too since its token-level pass
// (lmr_resolve in lean_single.sio) landed with this test.
use testmod::nr_a::{nr_energy, nr_a_twice}
use testmod::nr_b::{nr_b_other, nr_b_shadow}

fn main() -> i32 with IO {
    print("A_ENERGY=")
    print_f64(nr_energy())
    println("")
    print("A_TWICE=")
    print_f64(nr_a_twice())
    println("")
    print("B_OTHER=")
    print_f64(nr_b_other())
    println("")
    print("B_SHADOW=")
    print_f64(nr_b_shadow())
    println("")
    0
}
