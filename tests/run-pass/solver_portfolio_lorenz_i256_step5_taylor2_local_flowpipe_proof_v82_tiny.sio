//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v82 smoke for Lorenz i256 step-5 Taylor-2 local flowpipe proof

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1571
    receipt_fp = mix(receipt_fp, 965829478, 5437)
    receipt_fp = mix(receipt_fp, 618466007, 5437)
    receipt_fp = mix(receipt_fp, 500992858, 5437)
    receipt_fp = mix(receipt_fp, 827330719, 5437)
    receipt_fp = mix(receipt_fp, 555645792, 5437)
    receipt_fp = mix(receipt_fp, 380734589, 5437)
    receipt_fp = mix(receipt_fp, 22667633, 5437)
    receipt_fp = mix(receipt_fp, 565606826, 5437)
    receipt_fp = mix(receipt_fp, 64983941, 5437)
    receipt_fp = mix(receipt_fp, 220149970, 5437)
    receipt_fp = mix(receipt_fp, 5, 5437)
    receipt_fp = mix(receipt_fp, 16, 5437)
    receipt_fp = mix(receipt_fp, 255, 5437)
    if receipt_fp != 119372413 { return 1 }

    var audit_fp: i64 = 1579
    audit_fp = mix(audit_fp, receipt_fp, 5441)
    audit_fp = mix(audit_fp, 965829478, 5441)
    audit_fp = mix(audit_fp, 618466007, 5441)
    audit_fp = mix(audit_fp, 708518690, 5441)
    audit_fp = mix(audit_fp, 622927323, 5441)
    audit_fp = mix(audit_fp, 913907902, 5441)
    audit_fp = mix(audit_fp, 7937759, 5441)
    audit_fp = mix(audit_fp, 590242925, 5441)
    audit_fp = mix(audit_fp, 820968143, 5441)
    audit_fp = mix(audit_fp, 807967578, 5441)
    audit_fp = mix(audit_fp, 446284704, 5441)
    audit_fp = mix(audit_fp, 98211696, 5441)
    audit_fp = mix(audit_fp, 336655077, 5441)
    audit_fp = mix(audit_fp, 825097798, 5441)
    audit_fp = mix(audit_fp, 397604716, 5441)
    audit_fp = mix(audit_fp, 555645792, 5441)
    audit_fp = mix(audit_fp, 5, 5441)
    audit_fp = mix(audit_fp, 16, 5441)
    audit_fp = mix(audit_fp, 255, 5441)
    if audit_fp != 677090695 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 85, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 85, 1103)
    if entry_fp != 465537194 { return 3 }

    let manifest_fp: i64 = 572498026
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 82, 1871)
    result_fp = mix(result_fp, 86, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 74, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 379578883 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 82, 1907)
    family_fp = mix(family_fp, 86, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 69, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 978255104 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 82, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 940454269 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 82, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 277255258 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 82, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 271235202 { return 8 }
    return 0
}
