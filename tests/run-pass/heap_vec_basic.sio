//@ run-pass
// Tests heap-allocated vectors using raw pointer pattern

fn test_heap_vec_pattern() -> i64 with IO, Alloc, Mut {
    var cap: i64 = 4
    var len: i64 = 0
    var ptr = heap_alloc(cap * 8)
    
    // Push values
    var i: i64 = 0
    while i < 8 {
        if len >= cap {
            cap = cap * 2
            ptr = heap_realloc(ptr, cap * 8)
        }
        write_i64(ptr, len, i * 10)
        len = len + 1
        i = i + 1
    }
    
    // Verify
    if len != 8 { return 0 }
    
    i = 0
    while i < 8 {
        let v = read_i64(ptr, i)
        if v != i * 10 { return 0 }
        i = i + 1
    }
    
    heap_free(ptr)
    1
}

fn main() -> i64 with IO, Alloc, Mut {
    let r = test_heap_vec_pattern()
    
    if r == 1 {
        print("heap_vec_basic: PASS\n")
        return 0
    }
    print("heap_vec_basic: FAIL\n")
    1
}
