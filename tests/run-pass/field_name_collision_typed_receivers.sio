//@ run-pass
//@ description: ADR-026 amendment — `codec` has a different index in A, B and C; every read below must use its receiver's own layout, and first-order bookkeeping lookups for `let r = a.codec` must not be refused as if they were memory accesses
//@ expect-stdout: 20
//@ expect-stdout: 7
//@ expect-stdout: 7
//@ expect-stdout: 5
//@ expect-stdout: 20
struct A { x: i64, codec: i64 }
struct B { codec: i64, y: i64, z: i64 }
struct C { w: i64, v: i64, codec: i64 }

fn get_ref(a: &A) -> i64 { a.codec }

fn mk() -> B { B { codec: 7, y: 8, z: 9 } }

fn main() -> i64 with IO {
    let a = A { x: 1, codec: 20 }
    let c = C { w: 0, v: 0, codec: 5 }
    var b = mk()
    let r = a.codec
    println(r)
    println(b.codec)
    println(mk().codec)
    println(c.codec)
    println(get_ref(&a))
    0
}
