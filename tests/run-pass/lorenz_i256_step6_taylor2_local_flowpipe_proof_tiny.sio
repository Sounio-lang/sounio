//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 Taylor-2 local flowpipe proof receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 863
    fp = mix(fp, 6, 4493)
    fp = mix(fp, 646304688, 4493)
    fp = mix(fp, 65498507, 4493)
    fp = mix(fp, 230532791, 4493)
    fp = mix(fp, 370048214, 4493)
    fp = mix(fp, 963265870, 4493)
    fp = mix(fp, 344106968, 4493)
    fp = mix(fp, 506104143, 4493)
    fp = mix(fp, 956295573, 4493)
    fp = mix(fp, 652877359, 4493)
    fp = mix(fp, 344816971, 4493)
    fp = mix(fp, 956152878, 4493)
    fp = mix(fp, 916252082, 4493)
    fp = mix(fp, 7, 4493)
    fp = mix(fp, 7, 4493)
    fp = mix(fp, 127, 4493)
    fp = mix(fp, 127, 4493)
    fp = mix(fp, 15, 4493)
    fp = mix(fp, 15, 4493)
    fp = mix(fp, 15, 4493)
    fp = mix(fp, 0, 4493)
    fp = mix(fp, 15, 4493)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 820830981 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 877
    fp = mix(fp, instance, 4507)
    fp = mix(fp, 7, 4507)
    fp = mix(fp, 7, 4507)
    fp = mix(fp, 127, 4507)
    fp = mix(fp, 127, 4507)
    fp = mix(fp, 15, 4507)
    fp = mix(fp, 15, 4507)
    fp = mix(fp, 15, 4507)
    fp = mix(fp, 0, 4507)
    fp = mix(fp, 15, 4507)
    fp = mix(fp, ok_mask, 4507)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 820830981 { return 0 - 1 }
    if certificate != 807625549 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 881
    fp = mix(fp, instance, 4513)
    fp = mix(fp, certificate, 4513)
    fp = mix(fp, 16, 4513)
    fp = mix(fp, 6, 4513)
    fp = mix(fp, 15, 4513)
    fp = mix(fp, 15, 4513)
    fp = mix(fp, 0, 4513)
    fp = mix(fp, 15, 4513)
    fp = mix(fp, ok_mask, 4513)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 813941448 { return 0 - 1 }
    if instance != 820830981 { return 0 - 1 }
    if certificate != 807625549 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 883
    fp = mix(fp, artifact, 4517)
    fp = mix(fp, instance, 4517)
    fp = mix(fp, certificate, 4517)
    fp = mix(fp, 646304688, 4517)
    fp = mix(fp, 65498507, 4517)
    fp = mix(fp, 230532791, 4517)
    fp = mix(fp, 370048214, 4517)
    fp = mix(fp, 963265870, 4517)
    fp = mix(fp, 344106968, 4517)
    fp = mix(fp, 506104143, 4517)
    fp = mix(fp, 956295573, 4517)
    fp = mix(fp, 652877359, 4517)
    fp = mix(fp, 344816971, 4517)
    fp = mix(fp, 956152878, 4517)
    fp = mix(fp, 916252082, 4517)
    fp = mix(fp, 6, 4517)
    fp = mix(fp, 15, 4517)
    fp = mix(fp, ok_mask, 4517)
    return fp
}

fn proof_mask() -> i64 {
    let endpoint_mask: i64 = 7
    let slab_mask: i64 = 7
    let response_mask: i64 = 127
    let remainder_mask: i64 = 127
    var composition_mask: i64 = 0
    if endpoint_mask == 7 { composition_mask = composition_mask + 1 }
    if slab_mask == 7 { composition_mask = composition_mask + 2 }
    if response_mask == 127 { composition_mask = composition_mask + 4 }
    if remainder_mask == 127 { composition_mask = composition_mask + 8 }

    let local_obligation_mask: i64 = composition_mask
    let local_proof_mask: i64 = composition_mask
    let global_claim_mask: i64 = 0
    let status: i64 = 15

    var ok_mask: i64 = 0
    if 646304688 > 0 {
        if 65498507 > 0 { ok_mask = ok_mask + 1 }
    }
    if 230532791 > 0 {
        if 963265870 > 0 { ok_mask = ok_mask + 2 }
    }
    if 506104143 > 0 {
        if 652877359 > 0 { ok_mask = ok_mask + 4 }
    }
    if 956152878 > 0 { ok_mask = ok_mask + 8 }
    if local_obligation_mask == 15 {
        if local_proof_mask == 15 { ok_mask = ok_mask + 16 }
    }
    if global_claim_mask == 0 {
        if status == 15 { ok_mask = ok_mask + 32 }
    }
    if 2 == 2 {
        if 256 == 256 { ok_mask = ok_mask + 64 }
    }
    if local_proof_mask == 15 {
        if 713556137 > 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = proof_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 820830981 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 807625549 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 813941448 { return 4 }
    let audit = audit_fp(art, inst, cert, ok_mask)
    if audit != 693709162 { return 5 }
    if certificate_fp(inst, 254) != (0 - 1) { return 6 }
    return 0
}
