//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-4 finite-cover promotion guard receipt

fn child4_finite_cover_promotion_guard_check(
    child4_discharge_preflight_fp: i64,
    child4_discharge_preflight_audit_fp: i64,
    child4_validation_core_fp: i64,
    child4_validation_core_audit_fp: i64,
    child_validated_mask: i64,
    pending_child_validation_mask: i64,
    pending_child_discharge_mask: i64,
    child_discharge_mask: i64,
    finite_cover_certificate_mask: i64,
    global_cover_certificate_mask: i64,
    global_flowpipe_claim_mask: i64,
    guard_status: i64) -> i64 {
    if child4_discharge_preflight_fp != 938615204 { return 0 - 1 }
    if child4_discharge_preflight_audit_fp != 405118337 { return 0 - 1 }
    if child4_validation_core_fp != 392846115 { return 0 - 1 }
    if child4_validation_core_audit_fp != 644973208 { return 0 - 1 }
    if child_validated_mask != 31 { return 0 - 1 }
    if pending_child_validation_mask != 0 { return 0 - 1 }
    if pending_child_discharge_mask != 255 { return 0 - 1 }
    if child_discharge_mask != 0 { return 0 - 1 }
    if finite_cover_certificate_mask != 0 { return 0 - 1 }
    if global_cover_certificate_mask != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if guard_status != 76 { return 0 - 1 }
    return 657240918
}

fn main() -> i64 {
    let artifact = child4_finite_cover_promotion_guard_check(
        938615204, 405118337, 392846115, 644973208, 31, 0, 255, 0, 0, 0, 0, 76)
    if artifact != 657240918 { return 1 }

    let audit_fp: i64 = 312489670
    let instance_fp: i64 = 880163417
    let certificate_fp: i64 = 246971305
    let child_validation_closed_mask: i64 = 31
    let discharge_dependency_mask: i64 = 31
    let discharge_blocker_mask: i64 = 255
    let promotion_blocker_mask: i64 = 15
    let nonpromotion_guard_mask: i64 = 31
    let promotion_allowed_mask: i64 = 0
    let finite_cover_candidate_mask: i64 = 0
    let global_certificate_candidate_mask: i64 = 0
    let ok_mask: i64 = 255

    if audit_fp != 312489670 { return 2 }
    if instance_fp != 880163417 { return 3 }
    if certificate_fp != 246971305 { return 4 }
    if child_validation_closed_mask != 31 { return 5 }
    if discharge_dependency_mask != 31 { return 6 }
    if discharge_blocker_mask != 255 { return 7 }
    if promotion_blocker_mask != 15 { return 8 }
    if nonpromotion_guard_mask != 31 { return 9 }
    if promotion_allowed_mask != 0 { return 10 }
    if finite_cover_candidate_mask != 0 { return 11 }
    if global_certificate_candidate_mask != 0 { return 12 }
    if ok_mask != 255 { return 13 }

    let missing_discharge_blocker = child4_finite_cover_promotion_guard_check(
        938615204, 405118337, 392846115, 644973208, 31, 0, 0, 0, 0, 0, 0, 76)
    if missing_discharge_blocker != 0 - 1 { return 14 }

    let fake_child_discharge = child4_finite_cover_promotion_guard_check(
        938615204, 405118337, 392846115, 644973208, 31, 0, 255, 1, 0, 0, 0, 76)
    if fake_child_discharge != 0 - 1 { return 15 }

    let fake_finite_cover = child4_finite_cover_promotion_guard_check(
        938615204, 405118337, 392846115, 644973208, 31, 0, 255, 0, 1, 0, 0, 76)
    if fake_finite_cover != 0 - 1 { return 16 }

    let fake_global_claim = child4_finite_cover_promotion_guard_check(
        938615204, 405118337, 392846115, 644973208, 31, 0, 255, 0, 0, 0, 1, 76)
    if fake_global_claim != 0 - 1 { return 17 }

    return 0
}
