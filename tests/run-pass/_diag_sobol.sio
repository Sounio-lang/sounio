//@ run-pass
// Diagnostic: identify which sobol tests fail

fn sqrt_f64(x: f64) -> f64 with Mut {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 25 { y = 0.5 * (y + x / y); i = i + 1 }
    y
}
fn abs_f64(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn max_f64(a: f64, b: f64) -> f64 { if a > b { a } else { b } }
fn min_f64(a: f64, b: f64) -> f64 { if a < b { a } else { b } }

fn reverse_bits(n: i64) -> f64 with Mut {
    var result: f64 = 0.0
    var v = n
    var b: f64 = 0.5
    while v > 0 {
        if (v % 2) == 1 { result = result + b }
        v = v / 2
        b = b / 2.0
    }
    return result
}

struct SaltelliSamples {
    matrix_a: [f64; 5000],
    matrix_b: [f64; 5000],
    n_samples: i32,
    n_dims: i32,
}

fn saltelli_dim_prime(d: i32) -> i64 {
    if d == 0 { return 2 }
    if d == 1 { return 3 }
    if d == 2 { return 5 }
    if d == 3 { return 7 }
    if d == 4 { return 11 }
    if d == 5 { return 13 }
    if d == 6 { return 17 }
    if d == 7 { return 19 }
    if d == 8 { return 23 }
    return 29
}

fn saltelli_generate(n_samples: i32, n_dims: i32, seed: i64) -> SaltelliSamples with Mut {
    var result = SaltelliSamples {
        matrix_a: [0.0; 5000],
        matrix_b: [0.0; 5000],
        n_samples: n_samples,
        n_dims: n_dims,
    }
    var actual_samples = n_samples
    if n_dims > 0 {
        let max_rows = 5000 / n_dims
        if actual_samples > max_rows { actual_samples = max_rows }
    }
    result.n_samples = actual_samples
    var i: i32 = 0
    while i < actual_samples {
        let base_idx: i64 = (i as i64) + 1 + seed
        var d: i32 = 0
        while d < n_dims {
            let dim_mult = saltelli_dim_prime(d)
            let idx_a: i64 = base_idx * dim_mult + (d as i64)
            let idx_b: i64 = base_idx * dim_mult + (d as i64) + (actual_samples as i64) * 7 + 131
            let flat = i * n_dims + d
            result.matrix_a[flat] = reverse_bits(idx_a)
            result.matrix_b[flat] = reverse_bits(idx_b)
            d = d + 1
        }
        i = i + 1
    }
    return result
}

fn main() -> i32 with IO, Mut {
    // Diagnose: check if matrix_a[0] is in range after saltelli_generate(3, 3, 99)
    let s3 = saltelli_generate(3, 3, 99)
    println("=== saltelli_generate(3,3,99) ===")
    println("n_samples:")
    print_f64(s3.n_samples as f64)
    println(" n_dims:")
    print_f64(s3.n_dims as f64)
    println(" matrix_a[0]:")
    print_f64(s3.matrix_a[0])
    println(" matrix_a[1]:")
    print_f64(s3.matrix_a[1])
    println(" matrix_b[0]:")
    print_f64(s3.matrix_b[0])

    // Check sample range test
    let s100 = saltelli_generate(100, 4, 7)
    println("=== saltelli_generate(100,4,7) ===")
    println("n_samples:")
    print_f64(s100.n_samples as f64)
    println(" matrix_a[0]:")
    print_f64(s100.matrix_a[0])
    println(" in_range:")
    let in_range_val: f64 = if s100.matrix_a[0] >= 0.0 && s100.matrix_a[0] <= 1.0 { 1.0 } else { 0.0 }
    print_f64(in_range_val)

    return 0
}
