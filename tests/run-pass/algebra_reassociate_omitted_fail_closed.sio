//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: PASS
//
// Positive control for E252: OMITTING `reassociate:` on an alternative algebra is not a
// claim and is accepted — the checker derives the strategy the laws certify (octonion +
// alternative → fano_selective; anything non-associative elsewhere → blocked). Before
// 2026-09-01 the parser turned an omitted clause into `free` silently.

algebra Octonion over f64 {
    add: commutative, associative
    mul: alternative, non_commutative
}

fn main() -> i64 with IO {
    println("PASS")
    0
}
