//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v27 smoke for Lorenz ball-fixed explicit-enclosure receipt

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 30 { return 0 - 1 }
    if instance_fp != 808477419 { return 0 - 1 }
    if certificate_fp != 414432618 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 30 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn explicit_enclosure_instance_fingerprint(scale: i64,
                                           steps: i64,
                                           trajectory_manifest_fp: i64,
                                           enclosure3_fp: i64,
                                           axis_mask: i64) -> i64 with Mod {
    if scale != 1000000 { return 0 - 1 }
    if steps != 5 { return 0 - 1 }
    if trajectory_manifest_fp != 508132668 { return 0 - 1 }
    if enclosure3_fp != 166945519 { return 0 - 1 }
    if axis_mask != 7 { return 0 - 1 }

    var fp: i64 = 263
    fp = portfolio_mix(fp, scale, 2239)
    fp = portfolio_mix(fp, steps, 2239)
    fp = portfolio_mix(fp, trajectory_manifest_fp, 2239)
    fp = portfolio_mix(fp, enclosure3_fp, 2239)
    fp = portfolio_mix(fp, axis_mask, 2239)
    return fp
}

fn explicit_enclosure_certificate_fingerprint(instance_fp: i64,
                                              quality_profile_fp: i64,
                                              radius_budget_fp: i64,
                                              final_enclosure_receipt_fp: i64,
                                              enclosure3_fp: i64,
                                              axis_mask: i64) -> i64 with Mod {
    if instance_fp != 808477419 { return 0 - 1 }
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    if final_enclosure_receipt_fp != 114244647 { return 0 - 1 }
    if enclosure3_fp != 166945519 { return 0 - 1 }
    if axis_mask != 7 { return 0 - 1 }

    var fp: i64 = 269
    fp = portfolio_mix(fp, instance_fp, 2267)
    fp = portfolio_mix(fp, quality_profile_fp, 2267)
    fp = portfolio_mix(fp, radius_budget_fp, 2267)
    fp = portfolio_mix(fp, final_enclosure_receipt_fp, 2267)
    fp = portfolio_mix(fp, enclosure3_fp, 2267)
    fp = portfolio_mix(fp, axis_mask, 2267)
    return fp
}

fn portfolio_v27_manifest_fingerprint(explicit_enclosure_entry_fp: i64) -> i64 with Mod {
    if explicit_enclosure_entry_fp != 547731575 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 27, 1151)
    fp = portfolio_mix(fp, 31, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, 3812644, 1151)
    fp = portfolio_mix(fp, 777068644, 1151)
    fp = portfolio_mix(fp, 423305090, 1151)
    fp = portfolio_mix(fp, 63872871, 1151)
    fp = portfolio_mix(fp, explicit_enclosure_entry_fp, 1151)
    return fp
}

fn portfolio_v27_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 291678314 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 27, 1871)
    fp = portfolio_mix(fp, 31, 1871)
    fp = portfolio_mix(fp, 9, 1871)
    fp = portfolio_mix(fp, 20, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v27_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 291678314 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 27, 1907)
    fp = portfolio_mix(fp, 31, 1907)
    fp = portfolio_mix(fp, 5, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 20, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v27_readiness_fingerprint(manifest_fp: i64,
                                       result_coverage_fp: i64,
                                       family_coverage_fp: i64,
                                       acceptance_receipt_fp: i64,
                                       audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 291678314 { return 0 - 1 }
    if result_coverage_fp != 505104449 { return 0 - 1 }
    if family_coverage_fp != 475711309 { return 0 - 1 }
    if acceptance_receipt_fp != 609703723 { return 0 - 1 }
    if audit_receipt_fp != 377961680 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 27, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = explicit_enclosure_instance_fingerprint(1000000, 5, 508132668, 166945519, 7)
    if instance_fp != 808477419 { return 1 }

    let certificate_fp = explicit_enclosure_certificate_fingerprint(
        instance_fp, 70877465, 565673886, 114244647, 166945519, 7)
    if certificate_fp != 414432618 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(30, instance_fp, certificate_fp, 1, 30)
    if entry_fp != 547731575 { return 3 }

    let manifest_fp = portfolio_v27_manifest_fingerprint(entry_fp)
    if manifest_fp != 291678314 { return 4 }

    let result_coverage_fp = portfolio_v27_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 505104449 { return 5 }

    let family_coverage_fp = portfolio_v27_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 475711309 { return 6 }

    if portfolio_v27_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        609703723, 377961680) != 106882974 { return 7 }

    if explicit_enclosure_instance_fingerprint(1000000, 5, 508132668, 166945520, 7) != (0 - 1) { return 8 }
    if explicit_enclosure_certificate_fingerprint(
        instance_fp, 70877466, 565673886, 114244647, 166945519, 7) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(30, instance_fp, certificate_fp, 0, 30) != (0 - 1) { return 10 }
    if portfolio_v27_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 11 }
    if portfolio_v27_result_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 12 }
    if portfolio_v27_checker_family_coverage_fingerprint(manifest_fp + 1) != (0 - 1) { return 13 }
    if portfolio_v27_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        609703723, 377961681) != (0 - 1) { return 14 }

    return 0
}
