//@ description: Imported Lorenz i256 five-step trajectory range-budget certificate

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let budget_fp = lorenz_i256_trajectory5_range_budget_fingerprint(
        32, 5, 34, 71, 71, 255, 214180161, 23144051,
        5309941770, 10058731223, 4084837935)
    if budget_fp != 87220662 { return 1 }

    let audit_fp = lorenz_i256_trajectory5_range_audit_fingerprint(
        budget_fp, 149359034, 890086395, 166945519, 184, 31)
    if audit_fp != 323169628 { return 2 }

    if lorenz_i256_trajectory5_range_budget_fingerprint(
        32, 5, 33, 71, 71, 255, 214180161, 23144051,
        5309941770, 10058731223, 4084837935) != (0 - 1) { return 3 }
    if lorenz_i256_trajectory5_range_audit_fingerprint(
        budget_fp, 149359034, 890086395, 166945519, 183, 31) != (0 - 1) { return 4 }

    return 0
}
