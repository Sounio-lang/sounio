//@ run-pass
//@ expect-stdout-contains: PBPK28_MULTIDRUG_GATES_PASS
//@ timeout: 180

// Runtime (2026-09-27): 17.3 s on lean_single (souc-stage2 engine, this
// workspace pod, run only). CI job 108525867166 put the Full Test Suite
// runner at 2.65-4.3x slower than the pod (hepatic 11.3 s timed out at
// 30 s; calibration 42 s passed within 180 s), so the timeout is about
// 2x the worst projected CI time, 4.3 x 17.3 s.
//
// Gates for stdlib/darwin_pbpk/ddi/multidrug28.sio (dynamic multi-drug driver).
//
// M   Mass balance per drug under NONLINEAR coupling (two drugs, mutual CYP3A4
//     competition at liver and gut, oral + IV dosing, central clearance):
//       body + lumen + unabsorbed + eliminated = administered, to 1e-10,
//     and the clamped mass is exactly 0: the default transport (TR-BDF2 with
//     a backward-Euler restart) has no negativity floor; it panics instead
//     (pbpk28_hepatic.sio, TR-BDF2 section). Until 2026-09-27 the driver
//     stepped floored CN, and this gate bounded the clamped mass by
//     n_steps·27·eps·dose instead (floored round-off in the deep terminal
//     phase: V3 over 300 h, 1.3e-12 mg). The legacy path keeps that floor;
//     tests/run-pass/darwin_pbpk28_trbdf2_gates.sio (I) shows what it costs.
//
// V3  Static limit, exact. With a constant external inhibitor load L the factor
//     f = 1/(1+L) is constant and the system is linear. Integrating it to
//     infinity (portal routing; sinks k_L in liver tissue, k_g in gut tissue;
//     central clearance CL_c):
//       AUC_b = (D_iv + F_H · F_G · D_gut) / CL_sys
//       X_L = k_L·PS_L/(PS_L/Kp_L + k_L),  F_H = Q_L/(Q_L + X_L)
//       a   = (PS_g/Kp_g)/(PS_g/Kp_g + k_g), X_g = PS_g·k_g/(PS_g/Kp_g + k_g)
//       F_G = a · Q_g/(Q_g + X_g)
//       CL_sys = CL_c + Q_L·X_L/(Q_L + X_L) + F_H · Q_g·X_g/(Q_g + X_g)
//     with k = f·CLint·fu/K_p and D_gut = fa·D_oral. The last CL_sys term is gut
//     metabolism of SYSTEMIC drug (blood -> gut -> portal -> liver), which the
//     static well-stirred module (ddi/cyp3a_competitive.sio) does not have; its
//     AUCR is printed for context, not gated. Every step satisfies
//     x_{n+1} - x_n = dt·A·Q_n + dt·b exactly, where Q_n is the step's own
//     quadrature of the state (TR-BDF2 (w, w, d) on x_n, x_γ, x_{n+1}; the
//     backward-Euler restart (0, 1/2, 1/2) on x_n, midpoint, x_{n+1}), and the
//     AUC is accumulated with those weights; summing the steps gives
//     A·AUC = -(delivered mass) exactly for constant A, so the discrete AUC
//     equals the continuous one for ANY dt: the gate error is truncation
//     (residual mass at t_end) plus round-off only; the clamped mass must be
//     0 (as in M). Because the result is exact for any dt, V3 steps at
//     dt = 0.1 h (0.02 until 2026-09-27; changed for runtime; the 300 h
//     horizon that bounds the residual mass is kept). Q_g here is the whole gut blood flow
//     (q[8] = 55 L/h), not villous flow, and PS_g is large, so F_G is nearly
//     flow-limited: a kernel-identity fixture, not a gut-physiology claim.
//
// V4  Enzyme-site concentration convention, exact. The perpetrator has no
//     CLint, only central clearance CL_p, and is held at steady state by an IV
//     infusion R; every sink-free organ then has C_v = C_b = R/CL_p and
//     C_t = K_p·C_b, so the unbound site concentrations are known in closed
//     form: C_u,L = fu_p·C_b, C_u,g = fu_gut,p·C_b, and the victim's factors are
//     f_L = 1/(1 + C_u,L/Ki), f_g = 1/(1 + C_u,g/Ki) (different, because
//     fu_p != fu_gut,p). The victim, which carries its own Ki so that
//     self-inhibition would show, is dosed orally at 120 h (both phases at
//     dt = 0.1 h since 2026-09-27: the steady state is the scheme's exact
//     fixed point, and the victim under constant factors is linear, so its
//     quadrature AUC is exact for any dt; the 120 h and 300 h horizons are
//     kept) and its AUC must
//     equal the V3 closed form with site-specific f_L, f_g to 1e-9 (the
//     perpetrator's distance from steady state, ~1e-10, times a factor
//     sensitivity <= 1, plus V3's truncation). V3 alone cannot see the site
//     convention (its load is a constant). Adversarial review 2026-09-26,
//     sabotages of md_factors that pass M, V3, V5 and V6 but fail V4: gut-site
//     inhibition dropped (rel err 0.76), self-inhibition included (4.3e-4),
//     fu omitted (0.54), fu·C_t·K_p instead of fu·C_t/K_p (3.4).
//
// V5  Coupling order: moved to tests/run-pass/darwin_pbpk28_multidrug_order_gates.sio
//     (2026-09-27, runtime split; the checks are independent of the ones here).
//
// V6  Controls (by construction; they check plumbing, not conventions -- see V4).
//     (a) A co-administered CYP3A4 substrate that is NOT an inhibitor
//     (Ki unset) leaves the victim BIT-IDENTICAL to the victim alone. (b) The same
//     with Ki = 1e300. (c) Two identical drugs, identical doses, mutual Ki:
//     bit-identical trajectories (symmetry). (a)-(c) compare every per-drug
//     state and accounting field with md_same_drug (all 14 cv and 14 ct
//     entries, lumen, AUC, eliminated, clamped, administered, never absorbed;
//     exact ==, NaN fails). (d) A call that adds nothing is
//     not a dosing event: an oral dose of 0, a bolus of 0 and an infusion rate
//     set to its current value, all mid-run, leave the victim bit-identical
//     (md_same_drug) to the run without those calls; they must not schedule the
//     restart. A real rate change still does.
//     (e) The restart is per drug. A mid-run oral dose of a co-drug that is a
//     CYP3A4 substrate but NOT an inhibitor leaves the victim bit-identical
//     (md_same_drug) to the run without that dose. With the single global
//     restart flag this driver had before 2026-09-27, the co-drug's dose
//     switched the victim's next step to backward Euler and the gate failed
//     (measured: victim differs). Controls: right after the dose the
//     co-drug's own restart is pending and the victim's is not; when the
//     co-drug inhibits CYP3A4 (Ki > 0) and the victim has CYP3A4 CLint, the
//     victim's restart IS pending (the propagation rule in the driver header).
//
// V7  md_run_to reaches targets off the dt grid exactly. From t = 0 with
//     dt = 0.02: t_end = 0.61 must end at t == 0.61 with the drug's state and
//     accounting identical to the explicit sequence of 30 steps of 0.02 and one
//     of 0.01 (md_step); t_end = 0.005 (below one step) must take one 0.005
//     step; and t_end = 0.6 on the grid must take exactly 30 steps (no extra
//     vanishing step from accumulated round-off in t). "Identical" is exact
//     `==` on every per-drug state and accounting field: all 14 cv and 14 ct
//     entries, lumen, AUC, eliminated, clamped, administered and never-absorbed
//     mass (md_same_drug). A NaN on either side fails it; the only distinct bit
//     patterns `==` identifies are +0 and -0. A t_end not ahead of t
//     must leave t and the AUC untouched, whether it is below t by less than
//     tol (which the snap would otherwise move backwards) or well below it.
//     A step far larger than the span must still integrate: run_to(1.0) with
//     dt = 1e12 from t = 0 must end at t == 1.0 with a positive AUC for the
//     dosed drug, not merely move the clock (1e-9·dt exceeded the span).
//
// V8  Configuration. md_config_error, the check every md_step panics on,
//     returns 2 for md.iters < 0 (a negative count ran zero sweeps: silent Lie
//     coupling, bit-identical to iters = 0), 1 for an unknown md.method, and 0
//     for iters 0, 1, 12. Without the iters check it returns 0 for iters = -1
//     and this gate fails. (The panic itself is not observable by this
//     harness; measured by hand: md_step with iters = -1 exits 1 on both
//     engines.)
//
// Transport parameters are the rapamycin PBPK28 profile with synthetic CLint and
// Ki values: kernel/driver correctness fixtures, not drug claims.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::pbpk28_hepatic::*
use darwin_pbpk::ddi::multidrug28::*
use darwin_pbpk::ddi::cyp3a_competitive::*

fn g_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }
fn e12(x: f64) -> i64 { return (x * 1000000000000.0) as i64 }

// Victim fixture: liver + gut CYP3A4 substrate.
fn add_victim(md: &!MultiDrug28, cl_c: f64) -> i32 with Mut, Panic {
    var p = pbpk28_params_rapamycin()
    p.cl_central = cl_c
    let i = md_add_drug(md, p, 0.1, 0.95, 1.5)
    md_set_fu_site(md, i, md_site_gut(), 1.0)
    md_set_clint(md, i, md_site_liver(), md_cyp3a4(), 200.0)
    md_set_clint(md, i, md_site_gut(), md_cyp3a4(), 30.0)
    return i
}

// M ---------------------------------------------------------------------------
fn gate_mass() -> bool with Mut, Div, Panic, IO {
    var md = md_new(true)
    let a = add_victim(&!md, 1.5)
    let b = add_victim(&!md, 0.5)
    md_set_ki(&!md, a, md_cyp3a4(), 0.02)
    md_set_ki(&!md, b, md_cyp3a4(), 0.005)
    md_dose_oral(&!md, a, 5.0)
    md_set_iv_rate(&!md, a, 0.3)
    md_dose_oral(&!md, b, 100.0)
    md_dose_iv_bolus(&!md, b, 10.0)
    md_run_to(&!md, 48.0, 0.02)
    let ra = md_mass_residual(&md, a)
    let rb = md_mass_residual(&md, b)
    print("M residual A (x1e12) = ") println(e12(ra))
    print("M residual B (x1e12) = ") println(e12(rb))
    print("M victim factor at 48 h (liver, 3A4) = ") println(md_factor_now(&md, a, md_site_liver(), md_cyp3a4()))
    let cl = md_clamped(&md, a) + md_clamped(&md, b)
    print("M mass added by the negativity clamp (mg) = ") println(cl)
    let cl_ok = md_clamped(&md, a) == 0.0 && md_clamped(&md, b) == 0.0
    return ra < 1.0e-10 && rb < 1.0e-10 && cl_ok
}

// V3 --------------------------------------------------------------------------
fn closed_auc(f: f64, cl_c: f64, d_iv: f64, d_oral: f64) -> f64 with Div {
    let p = pbpk28_params_rapamycin()
    let fa = 0.95
    let k_l = f * 200.0 * 0.1 / p.kp[1]
    let k_g = f * 30.0 * 1.0 / p.kp[8]
    let ql = p.q[1]
    let qg = p.q[8]
    let x_l = k_l * p.ps[1] / (p.ps[1] / p.kp[1] + k_l)
    let a = (p.ps[8] / p.kp[8]) / (p.ps[8] / p.kp[8] + k_g)
    let x_g = p.ps[8] * k_g / (p.ps[8] / p.kp[8] + k_g)
    let fh = ql / (ql + x_l)
    let fg = a * qg / (qg + x_g)
    let cl_sys = cl_c + ql * x_l / (ql + x_l) + fh * qg * x_g / (qg + x_g)
    return (d_iv + fh * fg * fa * d_oral) / cl_sys
}

fn run_auc(load: f64, cl_c: f64, d_iv: f64, d_oral: f64, t_end: f64, dt: f64) -> (f64, f64, f64) with Mut, Div, Panic {
    var md = md_new(true)
    let v = add_victim(&!md, cl_c)
    md_set_ext_load(&!md, md_site_liver(), md_cyp3a4(), load)
    md_set_ext_load(&!md, md_site_gut(), md_cyp3a4(), load)
    if d_oral > 0.0 { md_dose_oral(&!md, v, d_oral) }
    if d_iv > 0.0 { md_dose_iv_bolus(&!md, v, d_iv) }
    md_run_to(&!md, t_end, dt)
    let left = (md_body_mass(&md, v) + md.lumen[v]) / md.dose_in[v]
    return (md.auc_b[v], left, md_clamped(&md, v))
}

fn gate_v3() -> bool with Mut, Div, Panic, IO {
    let cl_c = 1.5
    let load = 8.0
    let f = 1.0 / (1.0 + load)
    let t_end = 300.0
    let dt = 0.1

    let (po0, left_po0, cl_po0) = run_auc(0.0, cl_c, 0.0, 1.0, t_end, dt)
    let (poi, left_poi, cl_poi) = run_auc(load, cl_c, 0.0, 1.0, t_end, dt)
    let (iv0, left_iv0, cl_iv0) = run_auc(0.0, cl_c, 1.0, 0.0, t_end, dt)
    let (ivi, left_ivi, cl_ivi) = run_auc(load, cl_c, 1.0, 0.0, t_end, dt)

    let c_po0 = closed_auc(1.0, cl_c, 0.0, 1.0)
    let c_poi = closed_auc(f, cl_c, 0.0, 1.0)
    let c_iv0 = closed_auc(1.0, cl_c, 1.0, 0.0)
    let c_ivi = closed_auc(f, cl_c, 1.0, 0.0)

    let e1 = g_abs(po0 - c_po0) / c_po0
    let e2 = g_abs(poi - c_poi) / c_poi
    let e3 = g_abs(iv0 - c_iv0) / c_iv0
    let e4 = g_abs(ivi - c_ivi) / c_ivi
    let worst_left = left_po0 + left_poi + left_iv0 + left_ivi

    // Static well-stirred module with the same CLint/fu/flows (context only).
    let p = pbpk28_params_rapamycin()
    let sub = Cyp3aSubstrate { qh: p.q[1], qg: p.q[8], fu: 0.1, fu_gut: 1.0, fa: 0.95, clint_h: 200.0, clint_g: 30.0 }
    let static_aucr = cyp3a_aucr(sub, f)

    print("V3 oral AUCR dynamic = ") println(poi / po0)
    print("V3 oral AUCR closed form = ") println(c_poi / c_po0)
    print("V3 IV AUCR dynamic = ") println(ivi / iv0)
    print("V3 IV AUCR closed form = ") println(c_ivi / c_iv0)
    print("V3 oral AUCR static well-stirred module (context, not gated) = ") println(static_aucr)
    print("V3 worst rel AUC error (x1e12) = ")
    var worst = e1
    if e2 > worst { worst = e2 }
    if e3 > worst { worst = e3 }
    if e4 > worst { worst = e4 }
    println(e12(worst))
    print("V3 residual mass fraction at t_end (x1e12) = ") println(e12(worst_left))
    let clamped = cl_po0 + cl_poi + cl_iv0 + cl_ivi
    print("V3 mass added by the negativity clamp (mg) = ") println(clamped)
    return worst < 1.0e-9 && worst_left < 1.0e-12 && clamped == 0.0
}

// V4 --------------------------------------------------------------------------
// V3 closed form with separate liver and gut factors.
fn closed_auc_sites(f_l: f64, f_g: f64, cl_c: f64, d_oral: f64) -> f64 with Div {
    let p = pbpk28_params_rapamycin()
    let fa = 0.95
    let k_l = f_l * 200.0 * 0.1 / p.kp[1]
    let k_g = f_g * 30.0 * 1.0 / p.kp[8]
    let ql = p.q[1]
    let qg = p.q[8]
    let x_l = k_l * p.ps[1] / (p.ps[1] / p.kp[1] + k_l)
    let a = (p.ps[8] / p.kp[8]) / (p.ps[8] / p.kp[8] + k_g)
    let x_g = p.ps[8] * k_g / (p.ps[8] / p.kp[8] + k_g)
    let fh = ql / (ql + x_l)
    let fg = a * qg / (qg + x_g)
    let cl_sys = cl_c + ql * x_l / (ql + x_l) + fh * qg * x_g / (qg + x_g)
    return fh * fg * fa * d_oral / cl_sys
}

fn gate_v4() -> bool with Mut, Div, Panic, IO {
    var md = md_new(true)
    let v = add_victim(&!md, 1.5)
    md_set_ki(&!md, v, md_cyp3a4(), 1.0)
    var pp = pbpk28_params_rapamycin()
    let cl_p = 10.0
    pp.cl_central = cl_p
    let fu_p = 0.3
    let fu_gut_p = 1.0
    let x = md_add_drug(&!md, pp, fu_p, 1.0, 1.0)
    md_set_fu_site(&!md, x, md_site_gut(), fu_gut_p)
    let ki = 0.05
    md_set_ki(&!md, x, md_cyp3a4(), ki)
    let rate = 5.0
    md_set_iv_rate(&!md, x, rate)
    md_run_to(&!md, 120.0, 0.1)
    let cb = rate / cl_p
    let ss_err = g_abs(md.cv[x * 14] - cb) / cb
    let f_l = 1.0 / (1.0 + fu_p * cb / ki)
    let f_g = 1.0 / (1.0 + fu_gut_p * cb / ki)
    print("V4 perpetrator C_b vs R/CL at 120 h (rel x1e12) = ") println(e12(ss_err))
    print("V4 victim factors liver, gut: driver ") print(md_factor_now(&md, v, md_site_liver(), md_cyp3a4())) print("  ") print(md_factor_now(&md, v, md_site_gut(), md_cyp3a4()))
    print("  closed ") print(f_l) print("  ") println(f_g)
    md_dose_oral(&!md, v, 1.0)
    let auc0 = md.auc_b[v]
    md_run_to(&!md, 420.0, 0.1)
    let auc = md.auc_b[v] - auc0
    let closed = closed_auc_sites(f_l, f_g, 1.5, 1.0)
    let base = closed_auc_sites(1.0, 1.0, 1.5, 1.0)
    let err = g_abs(auc - closed) / closed
    let left = md_body_mass(&md, v) + md.lumen[v]
    let clamped = md_clamped(&md, v) + md_clamped(&md, x)
    print("V4 victim oral AUCR dynamic, closed form = ") print(auc / base) print("  ") println(closed / base)
    print("V4 victim AUC rel error (x1e12) = ") println(e12(err))
    print("V4 victim residual mass at t_end (x1e12) = ") println(e12(left))
    print("V4 mass added by the negativity clamp (mg) = ") println(clamped)
    let cl_ok = md_clamped(&md, v) == 0.0 && md_clamped(&md, x) == 0.0
    return ss_err < 1.0e-9 && err < 1.0e-9 && left < 1.0e-12 && cl_ok
}

// V6 --------------------------------------------------------------------------
// Exact equality of drug i in a and drug j in b over every per-drug state and
// accounting field. Each test is `!(x == y)`, so a NaN on either side fails
// rather than passing (NaN == NaN is false).
fn md_same_drug(a: &MultiDrug28, i: i32, b: &MultiDrug28, j: i32) -> bool with Mut {
    var ok = true
    var o: i32 = 0
    while o < 14 {
        if !((*a).cv[i * 14 + o] == (*b).cv[j * 14 + o]) { ok = false }
        if !((*a).ct[i * 14 + o] == (*b).ct[j * 14 + o]) { ok = false }
        o = o + 1
    }
    if !((*a).lumen[i] == (*b).lumen[j]) { ok = false }
    if !((*a).auc_b[i] == (*b).auc_b[j]) { ok = false }
    if !((*a).elim[i] == (*b).elim[j]) { ok = false }
    if !((*a).clamped[i] == (*b).clamped[j]) { ok = false }
    if !((*a).dose_in[i] == (*b).dose_in[j]) { ok = false }
    if !((*a).lost[i] == (*b).lost[j]) { ok = false }
    return ok
}

// The victim is drug 0 in every run.
fn victim_run(with_b: bool, ki_b: f64) -> MultiDrug28 with Mut, Div, Panic {
    var md = md_new(true)
    let a = add_victim(&!md, 1.5)
    md_dose_oral(&!md, a, 5.0)
    if with_b {
        let b = add_victim(&!md, 0.5)
        if ki_b > 0.0 { md_set_ki(&!md, b, md_cyp3a4(), ki_b) }
        md_dose_oral(&!md, b, 100.0)
    }
    md_run_to(&!md, 24.0, 0.05)
    return md
}

fn v6d_run(noop_calls: bool) -> MultiDrug28 with Mut, Div, Panic {
    var md = md_new(true)
    let v = add_victim(&!md, 1.5)
    md_dose_oral(&!md, v, 5.0)
    md_set_iv_rate(&!md, v, 2.0)
    md_run_to(&!md, 1.0, 0.02)
    if noop_calls {
        md_dose_oral(&!md, v, 0.0)
        md_dose_iv_bolus(&!md, v, 0.0)
        md_set_iv_rate(&!md, v, 2.0)
    }
    md_run_to(&!md, 2.0, 0.02)
    return md
}

fn gate_v6d() -> bool with Mut, Div, Panic {
    let a = v6d_run(false)
    let b = v6d_run(true)
    let same = a.t == b.t && md_same_drug(&a, 0, &b, 0)
    // Control: a real rate change is a discontinuity and schedules the start-up.
    var c = v6d_run(false)
    md_set_iv_rate(&!c, 0, 3.0)
    return same && md_restart_pending(&c, 0)
}

// Victim dosed at 0, run to 6 h; the co-drug (a CYP3A4 substrate; an
// inhibitor when ki_b > 0) is then dosed or not. The caller reads the restart
// flags and runs on to 12 h.
fn v6e_to_dose(dose_b: bool, ki_b: f64) -> MultiDrug28 with Mut, Div, Panic {
    var md = md_new(true)
    let v = add_victim(&!md, 1.5)
    let b = add_victim(&!md, 0.5)
    if ki_b > 0.0 { md_set_ki(&!md, b, md_cyp3a4(), ki_b) }
    md_dose_oral(&!md, v, 5.0)
    md_run_to(&!md, 6.0, 0.05)
    if dose_b { md_dose_oral(&!md, b, 50.0) }
    return md
}

fn gate_v6e() -> bool with Mut, Div, Panic, IO {
    var a = v6e_to_dose(false, 0.0)
    md_run_to(&!a, 12.0, 0.05)
    var b = v6e_to_dose(true, 0.0)
    let rb_v = md_restart_pending(&b, 0)
    let rb_b = md_restart_pending(&b, 1)
    md_run_to(&!b, 12.0, 0.05)
    let same = a.t == b.t && md_same_drug(&a, 0, &b, 0)
    let c = v6e_to_dose(true, 0.02)
    let rc_v = md_restart_pending(&c, 0)
    let rc_b = md_restart_pending(&c, 1)
    print("V6e non-inhibitor co-drug dosed at 6 h: victim bit-identical ") print(same)
    print("; restart pending victim, co-drug ") print(rb_v) print(" ") println(rb_b)
    print("V6e inhibitor co-drug dosed at 6 h: restart pending victim, co-drug ") print(rc_v) print(" ") println(rc_b)
    return same && !rb_v && rb_b && rc_v && rc_b
}

fn gate_v6() -> bool with Mut, Div, Panic, IO {
    let alone = victim_run(false, 0.0)
    let non_inh = victim_run(true, 0.0)
    let huge_ki = victim_run(true, 1.0e300)
    let ok_a = md_same_drug(&alone, 0, &non_inh, 0)
    let ok_b = md_same_drug(&alone, 0, &huge_ki, 0)

    var md = md_new(true)
    let x = add_victim(&!md, 1.5)
    let y = add_victim(&!md, 1.5)
    md_set_ki(&!md, x, md_cyp3a4(), 0.02)
    md_set_ki(&!md, y, md_cyp3a4(), 0.02)
    md_dose_oral(&!md, x, 20.0)
    md_dose_oral(&!md, y, 20.0)
    md_run_to(&!md, 24.0, 0.05)
    let ok_c = md_same_drug(&md, x, &md, y)

    if ok_a { println("V6a non-inhibitor co-drug: victim bit-identical") } else { println("V6a FAIL: non-inhibitor co-drug changed the victim") }
    if ok_b { println("V6b Ki=1e300 co-drug: victim bit-identical") } else { println("V6b FAIL: Ki=1e300 changed the victim") }
    if ok_c { println("V6c identical drugs: trajectories bit-identical") } else { println("V6c FAIL: symmetric pair diverged") }
    let ok_d = gate_v6d()
    if ok_d { println("V6d zero dose / unchanged rate: victim bit-identical, no restart") } else { println("V6d FAIL: a no-op dosing call changed the victim") }
    let ok_e = gate_v6e()
    if ok_e { println("V6e per-drug restart: uncoupled victim bit-identical, coupled victim restarted") } else { println("V6e FAIL: restart scheduling is not per drug") }
    return ok_a && ok_b && ok_c && ok_d && ok_e
}

// V7 --------------------------------------------------------------------------
fn v7_setup(md: &!MultiDrug28) -> i32 with Mut, Div, Panic {
    let i = add_victim(md, 1.5)
    md_dose_oral(md, i, 5.0)
    md_dose_iv_bolus(md, i, 1.0)
    return i
}

fn gate_v7() -> bool with Mut, Div, Panic, IO {
    var a = md_new(true)
    let i = v7_setup(&!a)
    md_run_to(&!a, 0.61, 0.02)
    var b = md_new(true)
    let j = v7_setup(&!b)
    var k: i32 = 0
    while k < 30 {
        md_step(&!b, 0.02)
        k = k + 1
    }
    md_step(&!b, 0.61 - b.t)
    let same = md_same_drug(&a, i, &b, j)
    print("V7 run_to(0.61, dt 0.02): t = ") print(a.t) print("  matches explicit 30 x 0.02 + remainder: ") println(same)

    var c = md_new(true)
    let ic = v7_setup(&!c)
    md_run_to(&!c, 0.005, 0.02)
    var d = md_new(true)
    let id = v7_setup(&!d)
    md_step(&!d, 0.005)
    let short_ok = c.t == 0.005 && md_same_drug(&c, ic, &d, id)
    print("V7 run_to(0.005, dt 0.02): t = ") print(c.t) print("  one 0.005 step: ") println(short_ok)

    var e = md_new(true)
    let ie = v7_setup(&!e)
    md_run_to(&!e, 0.6, 0.02)
    var f = md_new(true)
    let jf = v7_setup(&!f)
    k = 0
    while k < 30 {
        md_step(&!f, 0.02)
        k = k + 1
    }
    let grid_ok = e.t == 0.6 && md_same_drug(&e, ie, &f, jf)
    print("V7 run_to(0.6, dt 0.02) on the grid: exactly 30 steps: ") println(grid_ok)

    // A target not ahead of t must not move the clock: without the early
    // return, a t_end below t but within tol was snapped backwards.
    let auc_at_06 = e.auc_b[ie]
    md_run_to(&!e, 0.6 - 0.000000000001, 0.02)
    let back_ok = e.t == 0.6 && e.auc_b[ie] == auc_at_06
    md_run_to(&!e, 0.3, 0.02)
    let past_ok = e.t == 0.6 && e.auc_b[ie] == auc_at_06
    print("V7 run_to(t_end just below t) and run_to(0.3) are no-ops: ") print(back_ok) print(" ") println(past_ok)

    var g = md_new(true)
    let ig = v7_setup(&!g)
    md_run_to(&!g, 1.0, 1000000000000.0)
    let big_ok = g.t == 1.0 && g.auc_b[ig] > 0.0
    print("V7 run_to(1.0, dt 1e12): t = ") print(g.t) print("  AUC = ") print(g.auc_b[ig]) print("  integrated: ") println(big_ok)
    return a.t == 0.61 && same && short_ok && grid_ok && back_ok && past_ok && big_ok
}

// V8 --------------------------------------------------------------------------
fn gate_v8() -> bool with Mut, Div, Panic, IO {
    var md = md_new(true)
    let fresh = md_config_error(&md)
    md.iters = 0 - 1
    let neg = md_config_error(&md)
    md.iters = 0
    let lie = md_config_error(&md)
    md.iters = 12
    let many = md_config_error(&md)
    md.iters = 1
    md.method = 7
    let bad_m = md_config_error(&md)
    print("V8 md_config_error: default, iters -1, 0, 12, method 7 = ")
    print(fresh) print(" ") print(neg) print(" ") print(lie) print(" ") print(many) print(" ") println(bad_m)
    return fresh == 0 && neg == 2 && lie == 0 && many == 0 && bad_m == 1
}

fn main() -> i32 with Mut, Div, Panic, IO {
    let m = gate_mass()
    let v3 = gate_v3()
    let v4 = gate_v4()
    let v6 = gate_v6()
    let v7 = gate_v7()
    let v8 = gate_v8()
    if m { println("M PASS") } else { println("M FAIL") }
    if v3 { println("V3 PASS") } else { println("V3 FAIL") }
    if v4 { println("V4 PASS") } else { println("V4 FAIL") }
    if v6 { println("V6 PASS") } else { println("V6 FAIL") }
    if v7 { println("V7 PASS") } else { println("V7 FAIL") }
    if v8 { println("V8 PASS") } else { println("V8 FAIL") }
    if m && v3 && v4 && v6 && v7 && v8 {
        println("PBPK28_MULTIDRUG_GATES_PASS")
        return 0
    }
    return 1
}
