//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_GUM_FO_SECOND_ORDER_MEAN_PASS

// Second-order mean via diagonal FO Hessian:
//   E₂[f] ≈ f(μ) + ½ Σ_k H_kk σ²_k
// For f(x)=x²: E₂ = μ² + σ²  (exact for Gaussian; Taylor match).
// For f(x)=x³: E₂ = μ³ + 3μ σ².

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    // μ=2, σ=0.05 → σ²=0.0025
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let x = k.value

    // First-order mean of x² is just μ²=4.0 (point evaluation)
    let m1 = x * x
    // Second-order: μ² + σ² = 4.0 + 0.0025 = 4.0025
    let m2 = second_order_mean(x * x)
    // Variance still first-order FO: Var(x²) ≈ (2μ)² σ² = 16 * 0.0025 = 0.04
    let v2 = variance_of(x * x)

    // Cube: E₂[x³] = μ³ + 3μ σ² = 8 + 3*2*0.0025 = 8.015
    let m3 = second_order_mean((x * x) * x)

    // Two independent seeds: f=a*b, E₂ = μa·μb (H_aa=H_bb=0 for pure product of
    // independent linears) — bias 0; cross-term not on diagonal.
    let ka: Knowledge<f64> = measure(3.0, uncertainty: 0.1)
    let kb: Knowledge<f64> = measure(4.0, uncertainty: 0.2)
    let a = ka.value
    let b = kb.value
    let mab = second_order_mean(a * b)

    // Sum of squares: f=a²+b² → E₂ = μa²+σa² + μb²+σb²
    // = 9+0.01 + 16+0.04 = 25.05
    let mss = second_order_mean(a * a + b * b)

    print("m1="); print_f64(m1); print("\n")
    print("m2="); print_f64(m2); print("\n")
    print("v2="); print_f64(v2); print("\n")
    print("m3="); print_f64(m3); print("\n")
    print("mab="); print_f64(mab); print("\n")
    print("mss="); print_f64(mss); print("\n")

    let ok = abs_f(m1 - 4.0) < 1.0e-12
        && abs_f(m2 - 4.0025) < 1.0e-9
        && abs_f(v2 - 0.04) < 1.0e-9
        && abs_f(m3 - 8.015) < 1.0e-9
        && abs_f(mab - 12.0) < 1.0e-9
        && abs_f(mss - 25.05) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_SECOND_ORDER_MEAN_PASS\n")
    } else {
        print("MADAROS_GUM_FO_SECOND_ORDER_MEAN_FAIL\n")
    }
}
