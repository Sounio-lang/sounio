//@ run-pass
// Test nested struct mutation in while loop
// This pattern appears in ODE solvers (RK4 state updates)

struct Vec2 {
    x: f64,
    y: f64
}

struct ODEState {
    pos: Vec2,
    vel: Vec2,
    time: f64
}

fn main() -> i32 with IO {
    var state = ODEState {
        pos: Vec2 { x: 0.0, y: 0.0 },
        vel: Vec2 { x: 1.0, y: 0.0 },
        time: 0.0
    }

    var step = 0
    let dt = 0.1

    // Simulate 10 time steps
    while step < 10 {
        // Update position (Euler integration)
        let new_x = state.pos.x + state.vel.x * dt
        let new_y = state.pos.y + state.vel.y * dt

        state = ODEState {
            pos: Vec2 { x: new_x, y: new_y },
            vel: state.vel,
            time: state.time + dt
        }

        step = step + 1
    }

    // Should reach time = 1.0
    return 0
}
