//@ run-pass
//@ expect-stdout: STRING_ARRAY_STORE_OK
// `var paths: [string; 4]` records its element type, `string`, as the local's
// struct type; as a store target the array took the packed-string byte path and
// `paths[0] = first` wrote one byte through the array handle (gen2 SIGSEGV in
// module_frontend_compile_imported_to_file_target_impl on any program, #2966).
fn keep(first: string, second: string) -> i64 with IO, Mut, Panic, Div, Alloc {
    var paths: [string; 4] = [""; 4]
    paths[0] = first
    paths[2] = second
    let p0: string = paths[0]
    let p2: string = paths[2]
    if str_len(p0) != 5 || str_len(p2) != 4 { return 0 - 1 }
    str_len(paths[0]) * 10 + str_len(paths[2])
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if keep("alpha", "beta") == 54 { println("STRING_ARRAY_STORE_OK") } else { println(keep("alpha", "beta")) }
    return 0
}
