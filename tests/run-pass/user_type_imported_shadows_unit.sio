//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IMPORTED_SHADOW_OK 1 2
//
// Review of #3743, item 1, positive control: an enum K imported by name is
// visible here, so `K` is the enum, not kelvin.
use fixtures::kenum_pub_leaf::{K, k_code}

fn main() -> i64 with IO, Mut {
    var k: K = K::A
    k = K::B
    let c: K = K::C
    print("IMPORTED_SHADOW_OK "); print_int(k_code(k)); print(" "); print_int(k_code(c)); print("\n")
    0
}
