struct Thing {
    n: i64,
}

impl Thing {
    fn bump(self) -> (Thing, i64) with Mut, Panic, Div {
        var t = self
        t.n = t.n + 1
        (t, t.n)
    }

    fn jump(self) -> (Thing, i64) with Mut, Panic, Div {
        var t = self
        t.n = t.n + 10
        (t, t.n)
    }

    fn get(self) -> i64 with Mut, Panic, Div {
        self.n
    }

    // The real shape: the PAIR is bound from an if-EXPRESSION, and the receiver
    // is then rebound from slot 0 of it.
    fn drive(self, big: bool) -> i64 with Mut, Panic, Div {
        let pair = if big { self.jump() } else { self.bump() }
        var t2 = pair.0
        t2.get()
    }
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let t = Thing { n: 1 }
    print("got=")
    print_int(t.drive(false))
    print("\n")
    println("PASS")
    0
}
