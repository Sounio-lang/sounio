//@ run-pass
//@ expect-stdout: var name ok
//@ description: `var` is a contextual keyword, so `let var = 5` binds a name (Madaros, parser/patterns.sio). lean_single lexed it as the binding keyword and evaluated every use as 0, which made the p-box variance in stdlib/epistemic/knightian.sio 0.

fn twice(x: i64) -> i64 {
    x * 2
}

fn main() with IO {
    let var = 5
    let doubled = twice(var)
    if var == 5 && doubled == 10 {
        println("var name ok")
    } else {
        print("var=")
        print_int(var)
        print(" twice=")
        print_int(doubled)
        println("")
    }
}
