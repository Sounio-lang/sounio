//@ run-pass
//@ expect-stdout: var name ok
//@ description: `var` is a contextual keyword, so `let var = 5` binds a name (Madaros, parser/patterns.sio). lean_single lexed it as the binding keyword and evaluated every use as 0, which made the p-box variance in stdlib/epistemic/knightian.sio 0. A parameter named `var` was not registered at all, so its uses read 0 too.

fn twice(x: i64) -> i64 {
    x * 2
}

// `var` as a parameter: lean_single registered no parameter for it, so each
// use read 0 (tests/run-pass/rapamycin_epistemic_pbpk.sio, rp3_fdiff_h).
fn scaled(var: i64) -> i64 {
    3 * var
}

fn main() with IO {
    let var = 5
    let doubled = twice(var)
    let tripled = scaled(var)
    if var == 5 && doubled == 10 && tripled == 15 {
        println("var name ok")
    } else {
        print("var=")
        print_int(var)
        print(" twice=")
        print_int(doubled)
        print(" scaled=")
        print_int(tripled)
        println("")
    }
}
