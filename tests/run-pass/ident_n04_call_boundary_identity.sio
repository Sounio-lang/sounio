//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: IDENT_N04_CALL_BOUNDARY_PASS
//
// Prediction (N-04 runtime observation identity at a call boundary):
// `let t = twice(a)` through a Knowledge-returning helper must preserve `a`'s
// first-order sensitivity channel with partial derivative 2.0.
// Analytic:
//   Cov(t.value, a.value) == 2 * Var(a) == 2.0
//   Var(t.value - a.value) == Var(2*a - a) == Var(a) == 1.0.

fn twice(x: Knowledge<f64>) -> Knowledge<f64> {
    x * 2.0
}

fn main() -> i64 with IO, Epistemic {
    let a = measure(10.0, uncertainty: 1.0)
    let t = twice(a)
    let cov_ta = covariance_of(t.value, a.value)
    let var_diff = variance_of(t.value - a.value)
    var d1 = cov_ta - 2.0
    if d1 < 0.0 { d1 = 0.0 - d1 }
    var d2 = var_diff - 1.0
    if d2 < 0.0 { d2 = 0.0 - d2 }
    if d1 > 1.0e-12 || d2 > 1.0e-12 { return 1 }

    println("IDENT_N04_CALL_BOUNDARY_PASS")
    0
}
