//@ run-pass
//@ description: #2787 match on a scalar Option tests the discriminant, not the payload: a leading None arm does not catch Some, and Some(0) is not None
//@ expect-stdout: nf_some0=0
//@ expect-stdout: nf_some5=5
//@ expect-stdout: nf_none=100
//@ expect-stdout: sf_some0=0
//@ expect-stdout: sf_some5=5
//@ expect-stdout: sf_none=100
//@ expect-stdout: wl_some0=0
//@ expect-stdout: wl_none=100
//@ expect-stdout: i64_nf_some1=1
//@ expect-stdout: i64_nf_some0=0
//@ expect-stdout: i64_nf_none=100
//@ expect-stdout: i64_neg=-7
//@ expect-stdout: ISSUE_2787_OK
//
// The reproducer from #2787. Before the fix, Madaros printed
// `100 100 100 100 5 100 100 100` for the first eight lines (expected
// `0 5 100 0 5 100 0 100`, which lean_single already printed):
//   1. a bare `None =>` first arm was parsed as a catch-all binding;
//   2. Some(v) was lowered to v itself and `None` meant `== 0`, so Some(0)
//      took the None arm in every arm order.

fn none_first(a: Option<usize>) -> i64 {
    match a {
        None => 100,
        Some(x) => x as i64,
    }
}

fn some_first(a: Option<usize>) -> i64 {
    match a {
        Some(x) => x as i64,
        None => 100,
    }
}

fn wild_last(a: Option<usize>) -> i64 {
    match a {
        Some(x) => x as i64,
        _ => 100,
    }
}

fn none_first_i64(a: Option<i64>) -> i64 {
    match a {
        None => 100,
        Some(x) => x,
    }
}

fn main() -> i32 with IO {
    var bad: i64 = 0
    let a = none_first(Some(0 as usize))
    print("nf_some0=")
    println(a)
    if a != 0 { bad = bad + 1 }
    let b = none_first(Some(5 as usize))
    print("nf_some5=")
    println(b)
    if b != 5 { bad = bad + 1 }
    let c = none_first(None)
    print("nf_none=")
    println(c)
    if c != 100 { bad = bad + 1 }
    let d = some_first(Some(0 as usize))
    print("sf_some0=")
    println(d)
    if d != 0 { bad = bad + 1 }
    let e = some_first(Some(5 as usize))
    print("sf_some5=")
    println(e)
    if e != 5 { bad = bad + 1 }
    let f = some_first(None)
    print("sf_none=")
    println(f)
    if f != 100 { bad = bad + 1 }
    let g = wild_last(Some(0 as usize))
    print("wl_some0=")
    println(g)
    if g != 0 { bad = bad + 1 }
    let h = wild_last(None)
    print("wl_none=")
    println(h)
    if h != 100 { bad = bad + 1 }
    let i = none_first_i64(Some(1))
    print("i64_nf_some1=")
    println(i)
    if i != 1 { bad = bad + 1 }
    let j = none_first_i64(Some(0))
    print("i64_nf_some0=")
    println(j)
    if j != 0 { bad = bad + 1 }
    let k = none_first_i64(None)
    print("i64_nf_none=")
    println(k)
    if k != 100 { bad = bad + 1 }
    let m = none_first_i64(Some(-7))
    print("i64_neg=")
    println(m)
    if m != -7 { bad = bad + 1 }
    if bad == 0 {
        println("ISSUE_2787_OK")
    } else {
        println("ISSUE_2787_FAIL")
    }
    0
}
