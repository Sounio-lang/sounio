//@ run-pass
//@ description: Imported Lorenz i256 limb bridge smoke

use systems::lorenz_i256_limb_bridge::*

fn main() -> i64 with Div {
    let carry_l0 = lorenz_dec4_add_limb(950000000, 0, 0, 0, 200000000, 0, 0, 0, 0)
    if carry_l0 != 150000000 { return 1 }

    let carry_l1 = lorenz_dec4_add_limb(950000000, 0, 0, 0, 200000000, 0, 0, 0, 1)
    if carry_l1 != 1 { return 2 }

    let increment_ok = lorenz_i256_limb_increment_check(
        950000000, 0, 0, 0, 200000000, 0, 0, 0, 150000000, 1, 0, 0)
    if increment_ok != 1 { return 3 }

    let artifact = lorenz_i256_limb_bridge_receipt_check(1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 102)
    if artifact != 681429570 { return 4 }

    let audit = lorenz_i256_limb_bridge_audit_fingerprint(
        artifact, 905714263, 247816039, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 102, 1023)
    if audit != 352908746 { return 5 }
    return 0
}
