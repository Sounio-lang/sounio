//@ run-pass
//@ requires: madaros
//@ description: Lorenz i256 projection margin budget absorbs roundoff inside enclosure slack

fn margin_mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn projection_margin_budget_fingerprint(
    roundoff_budget_fp: i64,
    roundoff_audit_fp: i64,
    range_budget_fp: i64,
    radius_budget_fp: i64,
    step_policy_margin_fp: i64,
    policy_chain_fp: i64,
    max_floor_error_target_units: i64,
    min_lower_slack: i64,
    min_upper_slack_after_roundup: i64,
    lower_remaining_after_error: i64,
    min_ppm_margin: i64,
    inclusion_mask: i64,
    safety_mask: i64) -> i64 {
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if roundoff_audit_fp != 159826781 { return 0 - 1 }
    if range_budget_fp != 87220662 { return 0 - 1 }
    if radius_budget_fp != 565673886 { return 0 - 1 }
    if step_policy_margin_fp != 494960746 { return 0 - 1 }
    if policy_chain_fp != 21862303 { return 0 - 1 }
    if max_floor_error_target_units != 1 { return 0 - 1 }
    if min_lower_slack != 42445 { return 0 - 1 }
    if min_upper_slack_after_roundup != 42450 { return 0 - 1 }
    if lower_remaining_after_error != 42444 { return 0 - 1 }
    if min_ppm_margin != 1273 { return 0 - 1 }
    if inclusion_mask != 7 { return 0 - 1 }
    if safety_mask != 31 { return 0 - 1 }
    if lower_remaining_after_error != min_lower_slack - max_floor_error_target_units {
        return 0 - 1
    }
    if lower_remaining_after_error <= 0 { return 0 - 1 }
    if min_upper_slack_after_roundup <= 0 { return 0 - 1 }
    if min_ppm_margin <= max_floor_error_target_units { return 0 - 1 }

    var fp: i64 = 331
    fp = margin_mix(fp, roundoff_budget_fp, 2579)
    fp = margin_mix(fp, roundoff_audit_fp, 2579)
    fp = margin_mix(fp, range_budget_fp, 2579)
    fp = margin_mix(fp, radius_budget_fp, 2579)
    fp = margin_mix(fp, step_policy_margin_fp, 2579)
    fp = margin_mix(fp, policy_chain_fp, 2579)
    fp = margin_mix(fp, max_floor_error_target_units, 2579)
    fp = margin_mix(fp, min_lower_slack, 2579)
    fp = margin_mix(fp, min_upper_slack_after_roundup, 2579)
    fp = margin_mix(fp, lower_remaining_after_error, 2579)
    fp = margin_mix(fp, min_ppm_margin, 2579)
    fp = margin_mix(fp, inclusion_mask, 2579)
    fp = margin_mix(fp, safety_mask, 2579)
    return fp
}

fn projection_margin_audit_fingerprint(
    projection_margin_budget_fp: i64,
    roundoff_budget_fp: i64,
    roundoff_audit_fp: i64,
    range_budget_fp: i64,
    ball_fixed_enclosure_fp: i64,
    readiness_mask: i64) -> i64 {
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if roundoff_audit_fp != 159826781 { return 0 - 1 }
    if range_budget_fp != 87220662 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 337
    fp = margin_mix(fp, projection_margin_budget_fp, 2591)
    fp = margin_mix(fp, roundoff_budget_fp, 2591)
    fp = margin_mix(fp, roundoff_audit_fp, 2591)
    fp = margin_mix(fp, range_budget_fp, 2591)
    fp = margin_mix(fp, ball_fixed_enclosure_fp, 2591)
    fp = margin_mix(fp, readiness_mask, 2591)
    return fp
}

fn main() -> i64 {
    let budget_fp = projection_margin_budget_fingerprint(
        677514412, 159826781, 87220662, 565673886, 494960746, 21862303,
        1, 42445, 42450, 42444, 1273, 7, 31)
    if budget_fp != 69322697 { return 1 }

    let audit_fp = projection_margin_audit_fingerprint(
        budget_fp, 677514412, 159826781, 87220662, 166945519, 31)
    if audit_fp != 397379945 { return 2 }

    if projection_margin_budget_fingerprint(
        677514412, 159826781, 87220662, 565673886, 494960746, 21862303,
        1, 42445, 42450, 42443, 1273, 7, 31) != (0 - 1) { return 3 }
    if projection_margin_budget_fingerprint(
        677514412, 159826781, 87220662, 565673886, 494960746, 21862303,
        2, 42445, 42450, 42444, 1273, 7, 31) != (0 - 1) { return 4 }
    if projection_margin_audit_fingerprint(
        budget_fp, 677514412, 159826781, 87220663, 166945519, 31) != (0 - 1) { return 5 }

    return 0
}
