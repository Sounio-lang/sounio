//@ run-pass
//@ expect-stdout: STATS_LINEAR_CLUSTER_REFERENCE_PASS

// Independent raw-score-map / quad triangular-solve oracle.
// CR1S means G/(G-1)*(n-1)/(n-p), not clubSandwich's bare CR1.
use stats::regression::robust_covariance::{LinearClusterResult,multiple_linear_cluster}
use math::pure::{is_finite,sqrt}
fn magnitude(x:f64)->f64 {if x<0.0 {-x}else{x}}
fn relative(a:f64,b:f64,tolerance:f64) with Mut,Div,Panic {
 assert(is_finite(a) && is_finite(b))
 if b==0.0 {assert(a==0.0)} else {assert(a!=0.0) assert(magnitude((a-b)/b)<=tolerance)}
}
fn covariance_close(a:f64,b:f64,unit:f64) with Mut,Div,Panic {
 assert(is_finite(a) && is_finite(b) && is_finite(unit))
 if unit==0.0 {assert(a==0.0 && b==0.0)} else {assert(magnitude((a-b)/unit)<=2.0e-7)}
}
// Conditional on actual reported residuals: this analytically cancelling
// dataset does not force a rounded production fit to publish invented zeros.
fn group_zero_reported(r:&LinearClusterResult) with Mut,Div,Panic {
 let g0=(r.fit.residuals[0]+r.fit.residuals[1])/4.0
 let g1=(r.fit.residuals[2]+r.fit.residuals[3])/4.0
 let covariance=g0*g0+g1*g1
 relative(r.covariance[0],covariance,2.0e-7)
 relative(r.standard_errors[0],sqrt(covariance),2.0e-7)
 var i:i64=1
 while i<64 {assert(r.covariance[i as usize]==0.0) i=i+1}
 i=1
 while i<8 {assert(r.standard_errors[i as usize]==0.0) i=i+1}
}
// visual_CR0
fn case_0() with Mut,Div,Panic {
 var a:[f64;2048]=[0.0;2048]
 var b:[f64;256]=[0.0;256]
 var ids:[i64;256]=[0;256]
 a[0]=1.00000000000000000e+00
 a[1]=-1.00000000000000000e+00
 b[0]=8.00000000000000000e+00
 ids[0]=0
 a[8]=1.00000000000000000e+00
 a[9]=-1.00000000000000000e+00
 b[1]=1.00000000000000000e+01
 ids[1]=0
 a[16]=1.00000000000000000e+00
 a[17]=1.00000000000000000e+00
 b[2]=1.20000000000000000e+01
 ids[2]=1
 a[24]=1.00000000000000000e+00
 a[25]=1.00000000000000000e+00
 b[3]=1.40000000000000000e+01
 ids[3]=1
 a[32]=1.00000000000000000e+00
 a[33]=-1.00000000000000000e+00
 b[4]=9.00000000000000000e+00
 ids[4]=2
 a[40]=1.00000000000000000e+00
 a[41]=-1.00000000000000000e+00
 b[5]=1.10000000000000000e+01
 ids[5]=2
 a[48]=1.00000000000000000e+00
 a[49]=1.00000000000000000e+00
 b[6]=1.30000000000000000e+01
 ids[6]=3
 a[56]=1.00000000000000000e+00
 a[57]=1.00000000000000000e+00
 b[7]=1.50000000000000000e+01
 ids[7]=3
 let r=multiple_linear_cluster(&a,&b,&ids,8,2,0.00000000000000000e+00,0)
 assert(r.fit.status==0 && r.covariance_status==0)
 assert(r.clusters==4 && r.method==0 && !r.assumptions_assessed)
 relative(r.correction_factor,1.00000000000000000e+00,1.0e-13)
 relative(r.fit.coefficients[0],1.15000000000000000e+01,1.0e-9)
 relative(r.fit.coefficients[1],2.00000000000000000e+00,1.0e-9)
 relative(r.standard_errors[0],2.50000000000000000e-01,2.0e-7)
 covariance_close(r.covariance[0],6.25000000000000000e-02,6.25000000000000000e-02)
 assert(r.covariance[0]==r.covariance[0])
 relative(r.covariance[0],6.25000000000000000e-02,2.0e-7)
 covariance_close(r.covariance[1],0.00000000000000000e+00,6.25000000000000000e-02)
 assert(r.covariance[1]==r.covariance[8])
 relative(r.standard_errors[1],2.50000000000000000e-01,2.0e-7)
 covariance_close(r.covariance[8],0.00000000000000000e+00,6.25000000000000000e-02)
 assert(r.covariance[8]==r.covariance[1])
 covariance_close(r.covariance[9],6.25000000000000000e-02,6.25000000000000000e-02)
 assert(r.covariance[9]==r.covariance[9])
 relative(r.covariance[9],6.25000000000000000e-02,2.0e-7)
 var i:i64=0
 while i<8 {if i>=2 {assert(r.standard_errors[i as usize]==0.0)} var j:i64=0 while j<8 {if i>=2 || j>=2 {assert(r.covariance[(i*8+j) as usize]==0.0)} j=j+1} i=i+1}
}
