//@ run-pass
// Regression test: i32 implicit return from var binding.
//
// Bug: var bindings infer i64 by default; when the declared function return
// type is i32 and the trailing expression is such a var, the type checker
// should accept the implicit narrowing (i64 literal → i32 context).
//
// This file verifies that:
//   - A function declared `-> i32` whose last expression is a `var n = <literal>`
//     type-checks without error.
//   - The runtime value is correct (42 == 42).

fn get_count() -> i32 {
    var n = 42
    n
}

fn main() -> i64 with IO {
    let v = get_count()
    if v == 42 {
        return 0
    }
    return 1
}
