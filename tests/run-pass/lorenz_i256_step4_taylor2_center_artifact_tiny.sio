//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 center candidate artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn check_div_witness_i256(numerator: i256, denominator: i256,
                          quotient: i256, remainder: i256) -> i64 {
    if denominator <= (0 as i256) { return 0 }
    if quotient < (0 as i256) { return 0 }
    if remainder < (0 as i256) { return 0 }
    if remainder >= denominator { return 0 }
    if quotient * denominator + remainder != numerator { return 0 }
    return 1
}

fn instance_fp() -> i64 {
    var fp: i64 = 1733
    fp = mix(fp, 4, 5657)
    fp = mix(fp, 10, 5657)
    fp = mix(fp, 28, 5657)
    fp = mix(fp, 8, 5657)
    fp = mix(fp, 3, 5657)
    fp = mix(fp, 4294967296, 5657)
    fp = mix(fp, 42949672, 5657)
    fp = mix(fp, 96, 5657)
    fp = mix(fp, 4617762706, 5657)
    fp = mix(fp, 7643846696, 5657)
    fp = mix(fp, 4120687759, 5657)
    fp = mix(fp, 4920371098, 5657)
    fp = mix(fp, 8816077911, 5657)
    fp = mix(fp, 4092986080, 5657)
    fp = mix(fp, 575348777, 5657)
    fp = mix(fp, 417943295, 5657)
    fp = mix(fp, 827089582, 5657)
    fp = mix(fp, 688797663, 5657)
    fp = mix(fp, 563331437, 5657)
    fp = mix(fp, 684718822, 5657)
    fp = mix(fp, 0, 5657)
    fp = mix(fp, 0, 5657)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 625447576 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1741
    fp = mix(fp, instance, 5659)
    fp = mix(fp, 124866970867, 5659)
    fp = mix(fp, 1906281842, 5659)
    fp = mix(fp, 8218332706, 5659)
    fp = mix(fp, 3252936400, 5659)
    fp = mix(fp, 10988500690, 5659)
    fp = mix(fp, 2, 5659)
    fp = mix(fp, 302608392, 5659)
    fp = mix(fp, 1014364768, 5659)
    fp = mix(fp, 1172231215, 5659)
    fp = mix(fp, 2184377272, 5659)
    fp = mix(fp, 27701679, 5659)
    fp = mix(fp, 948411264, 5659)
    fp = mix(fp, 4920371098, 5659)
    fp = mix(fp, 8816077911, 5659)
    fp = mix(fp, 4092986080, 5659)
    fp = mix(fp, 127, 5659)
    fp = mix(fp, 63, 5659)
    fp = mix(fp, 7, 5659)
    fp = mix(fp, 15, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, 0, 5659)
    fp = mix(fp, ok_mask, 5659)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 625447576 { return 0 - 1 }
    if certificate != 54748178 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1747
    fp = mix(fp, instance, 5669)
    fp = mix(fp, certificate, 5669)
    fp = mix(fp, 575348777, 5669)
    fp = mix(fp, 417943295, 5669)
    fp = mix(fp, 827089582, 5669)
    fp = mix(fp, 688797663, 5669)
    fp = mix(fp, 563331437, 5669)
    fp = mix(fp, 684718822, 5669)
    fp = mix(fp, 1, 5669)
    fp = mix(fp, 4, 5669)
    fp = mix(fp, 4920371098, 5669)
    fp = mix(fp, 8816077911, 5669)
    fp = mix(fp, 4092986080, 5669)
    fp = mix(fp, 15, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, 0, 5669)
    fp = mix(fp, ok_mask, 5669)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 450696904 { return 0 - 1 }
    if instance != 625447576 { return 0 - 1 }
    if certificate != 54748178 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1753
    fp = mix(fp, artifact, 5683)
    fp = mix(fp, instance, 5683)
    fp = mix(fp, certificate, 5683)
    fp = mix(fp, 575348777, 5683)
    fp = mix(fp, 417943295, 5683)
    fp = mix(fp, 827089582, 5683)
    fp = mix(fp, 688797663, 5683)
    fp = mix(fp, 563331437, 5683)
    fp = mix(fp, 684718822, 5683)
    fp = mix(fp, 4, 5683)
    fp = mix(fp, 1, 5683)
    fp = mix(fp, 127, 5683)
    fp = mix(fp, 63, 5683)
    fp = mix(fp, 7, 5683)
    fp = mix(fp, 15, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, 0, 5683)
    fp = mix(fp, ok_mask, 5683)
    return fp
}

fn main() -> i64 {
    let scale: i256 = 4294967296 as i256
    let dt: i256 = 42949672 as i256
    let x3: i256 = 4617762706 as i256
    let y3: i256 = 7643846696 as i256
    let z3: i256 = 4120687759 as i256
    let dy_scaled_q: i256 = 124866970867 as i256
    let dy_scaled_r: i256 = 1906281842 as i256
    let xy_scaled_q: i256 = 8218332706 as i256
    let xy_scaled_r: i256 = 3252936400 as i256
    let beta_q: i256 = 10988500690 as i256
    let beta_r: i256 = 2 as i256
    let x_inc_q: i256 = 302608392 as i256
    let x_inc_r: i256 = 1014364768 as i256
    let y_inc_q: i256 = 1172231215 as i256
    let y_inc_r: i256 = 2184377272 as i256
    let z_drop_q: i256 = 27701679 as i256
    let z_drop_r: i256 = 948411264 as i256

    let dx_num: i256 = (10 as i256) * (y3 - x3)
    let dy_num: i256 = x3 * ((28 as i256) * scale - z3)
    let xy_num: i256 = x3 * y3
    let beta_num_z: i256 = (8 as i256) * z3
    let dy: i256 = dy_scaled_q - y3
    let z_drop_num: i256 = beta_q - xy_scaled_q

    var point_replay_mask: i64 = 0
    if check_div_witness_i256(scale, 100 as i256, dt, 96 as i256) == 1 { point_replay_mask = point_replay_mask + 1 }
    if check_div_witness_i256(dy_num, scale, dy_scaled_q, dy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 2 }
    if check_div_witness_i256(xy_num, scale, xy_scaled_q, xy_scaled_r) == 1 { point_replay_mask = point_replay_mask + 4 }
    if check_div_witness_i256(beta_num_z, 3 as i256, beta_q, beta_r) == 1 { point_replay_mask = point_replay_mask + 8 }
    if check_div_witness_i256(dt * dx_num, scale, x_inc_q, x_inc_r) == 1 { point_replay_mask = point_replay_mask + 16 }
    if check_div_witness_i256(dt * dy, scale, y_inc_q, y_inc_r) == 1 { point_replay_mask = point_replay_mask + 32 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, z_drop_r) == 1 { point_replay_mask = point_replay_mask + 64 }
    if point_replay_mask != 127 { return 1 }

    var final_center_mask: i64 = 0
    if x3 + x_inc_q == 4920371098 as i256 { final_center_mask = final_center_mask + 1 }
    if y3 + y_inc_q == 8816077911 as i256 { final_center_mask = final_center_mask + 2 }
    if z3 - z_drop_q == 4092986080 as i256 { final_center_mask = final_center_mask + 4 }
    if final_center_mask != 7 { return 2 }

    let ok_mask: i64 = 255
    let inst = instance_fp()
    if inst != 625447576 { return 3 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 54748178 { return 4 }
    let artifact = artifact_fp(inst, cert, ok_mask)
    if artifact != 450696904 { return 5 }
    let audit = audit_fp(artifact, inst, cert, ok_mask)
    if audit != 780071782 { return 6 }
    if check_div_witness_i256(dt * z_drop_num, scale, z_drop_q, scale) != 0 { return 7 }
    if certificate_fp(inst, 254) != (0 - 1) { return 8 }
    return 0
}
