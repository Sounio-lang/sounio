//@ run-pass
//@ requires: madaros
//@ expect-stdout: MADAROS_GUM_FO_FIELD_CHAIN_PASS

// FO through field chains: Knowledge.value binding + nested lets.
// Method path inherits receiver FO (view methods).

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let k: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    // Field chain: .value then let-bind then FO
    let v0 = k.value
    let v1 = v0
    let v2 = v1
    // E2[x^2] = 4 + 0.0025 = 4.0025
    let m2 = second_order_mean(v2 * v2)
    let vv = variance_of(v2 * v2)
    // (2μ)^2 σ² = 16 * 0.0025 = 0.04

    // Direct field in expression (no intermediate let)
    let md = second_order_mean(k.value * k.value)

    print("m2="); print_f64(m2); print("\n")
    print("vv="); print_f64(vv); print("\n")
    print("md="); print_f64(md); print("\n")

    let ok = abs_f(m2 - 4.0025) < 1.0e-9
        && abs_f(vv - 0.04) < 1.0e-9
        && abs_f(md - 4.0025) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_FIELD_CHAIN_PASS\n")
    } else {
        print("MADAROS_GUM_FO_FIELD_CHAIN_FAIL\n")
    }
}
