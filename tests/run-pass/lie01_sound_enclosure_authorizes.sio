//@ run-pass
//@ expect-stdout: LIE01_SOUND_ENCLOSURE_PASS
// Positive control for lie corpus item 1: the honest path still works.
//   - a sound enclosure computed with outward rounding authorizes when it fits
//   - it abstains inside the ep + al band
//   - a heuristic estimate of the same number only ever suggests refinement
//   - outward rounding really widens: 0.1 + 0.2 encloses both 0.3 and RN(0.1+0.2)

use epistemic::sound_enclosure::*

fn main() -> i64 with IO, Mut, Panic {
    var fails: i64 = 0

    // 0.1 + 0.2 in round-to-nearest is 0.30000000000000004; the exact sum of the
    // two doubles is slightly different. The enclosure must contain the RN result
    // and be strictly wider than a point.
    let s = se_add(se_point(0.1), se_point(0.2))
    if !(se_lo(s) < 0.1 + 0.2 && 0.1 + 0.2 < se_hi(s)) { fails = fails + 1 }

    // auc = 2 * 2.0015885 with outward rounding, decided against a window
    let auc = se_mul(se_point(2.0), se_point(2.0015885))
    if !se_fits_window(auc, 0.10, 0.05, 3.0, 5.0) { fails = fails + 1 }
    let token = se_authorize_window(auc, 0.10, 0.05, 3.0, 5.0)
    if sa_window_lo(token) != 3.0 { fails = fails + 1 }

    // inside the band: abstain, never decide
    if se_decide(auc, 0.10, 0.05, 4.0) != SE_ABSTAIN_BAND { fails = fails + 1 }
    if se_decide(auc, 0.10, 0.05, 3.0) != SE_DECIDED_ABOVE { fails = fails + 1 }
    if se_decide(auc, 0.10, 0.05, 5.0) != SE_DECIDED_BELOW { fails = fails + 1 }

    // the same number as a heuristic never decides
    let h = he_new(4.003177, 0.0042)
    if he_decide(h, 0.10, 0.05, 3.0) != SE_REFINE { fails = fails + 1 }
    if he_decide(h, 0.10, 0.05, 4.0) != HE_HEURISTIC_ONLY { fails = fails + 1 }

    if fails == 0 {
        println("LIE01_SOUND_ENCLOSURE_PASS")
    } else {
        println("LIE01_SOUND_ENCLOSURE_FAIL")
    }
    return fails
}
