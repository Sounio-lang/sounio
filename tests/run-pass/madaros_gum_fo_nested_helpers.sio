//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_NESTED_HELPERS_PASS

// Nested multi-helper FO: pure helper whose body only calls other FO helpers.
// Before expand: variance_of(css_h(...)) == 0 while call-site compose was live.
// After: nested body must match call-site compose (Var, E₂).

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn rate_h(f: f64, dose: f64, tau: f64) -> f64 {
    (f * dose) / tau
}

fn cl_h(cl0: f64, eta: f64) -> f64 {
    cl0 * exp(eta)
}

// Nested: body is only calls to FO-transferred helpers + arithmetic.
fn css_h(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    rate_h(f, dose, tau) / cl_h(cl0, eta)
}

// Deeper nest: wrapper around css_h
fn exposure_h(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    css_h(f, dose, tau, cl0, eta)
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kTau: Knowledge<f64> = measure(12.0, uncertainty: 0.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)

    let f = kF.value
    let dose = kDose.value
    let tau = kTau.value
    let cl0 = kCL0.value
    let eta = kEta.value

    let v_site = variance_of(rate_h(f, dose, tau) / cl_h(cl0, eta))
    let v_nest = variance_of(css_h(f, dose, tau, cl0, eta))
    let v_deep = variance_of(exposure_h(f, dose, tau, cl0, eta))
    let m_site = second_order_mean(rate_h(f, dose, tau) / cl_h(cl0, eta))
    let m_nest = second_order_mean(css_h(f, dose, tau, cl0, eta))
    let m_deep = second_order_mean(exposure_h(f, dose, tau, cl0, eta))
    let h_nest = hessian_diag_of(css_h(f, dose, tau, cl0, eta))

    print("v_site="); print_f64(v_site); print("\n")
    print("v_nest="); print_f64(v_nest); print("\n")
    print("v_deep="); print_f64(v_deep); print("\n")
    print("m_site="); print_f64(m_site); print("\n")
    print("m_nest="); print_f64(m_nest); print("\n")
    print("m_deep="); print_f64(m_deep); print("\n")
    print("h_nest="); print_f64(h_nest); print("\n")

    // Analytic anchors from pk_exposure
    let v_ok = abs_f(v_site - 0.795833) < 1.0e-4
    let nest_match = abs_f(v_nest - v_site) < 1.0e-9
        && abs_f(v_deep - v_site) < 1.0e-9
        && abs_f(m_nest - m_site) < 1.0e-7
        && abs_f(m_deep - m_site) < 1.0e-7
    let mean_moves = abs_f(m_nest - 6.666666) > 1.0e-4
    let hess_live = abs_f(h_nest) > 1.0e-9
    let live = v_nest > 0.1

    let ok = v_ok && nest_match && mean_moves && hess_live && live
    if ok {
        print("MADAROS_GUM_FO_NESTED_HELPERS_PASS\n")
    } else {
        print("MADAROS_GUM_FO_NESTED_HELPERS_FAIL\n")
        print("v_ok="); if v_ok { print("1\n") } else { print("0\n") }
        print("nest_match="); if nest_match { print("1\n") } else { print("0\n") }
        print("mean_moves="); if mean_moves { print("1\n") } else { print("0\n") }
        print("hess_live="); if hess_live { print("1\n") } else { print("0\n") }
        print("live="); if live { print("1\n") } else { print("0\n") }
    }
}
