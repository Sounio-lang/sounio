//@ run-pass
//@ description: Tiny portfolio v42 smoke for SMT Alethe-style micro reconstruction receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 457
    receipt_fp = mix(receipt_fp, 580810113, 2861)
    receipt_fp = mix(receipt_fp, 72583387, 2861)
    receipt_fp = mix(receipt_fp, 46718256, 2861)
    receipt_fp = mix(receipt_fp, 265423024, 2861)
    receipt_fp = mix(receipt_fp, 15302992, 2861)
    receipt_fp = mix(receipt_fp, 752808158, 2861)
    receipt_fp = mix(receipt_fp, 1, 2861)
    receipt_fp = mix(receipt_fp, 63, 2861)
    if receipt_fp != 550418014 { return 1 }

    var audit_fp: i64 = 461
    audit_fp = mix(audit_fp, receipt_fp, 2879)
    audit_fp = mix(audit_fp, 580810113, 2879)
    audit_fp = mix(audit_fp, 72583387, 2879)
    audit_fp = mix(audit_fp, 958828933, 2879)
    audit_fp = mix(audit_fp, 801644191, 2879)
    audit_fp = mix(audit_fp, 1, 2879)
    audit_fp = mix(audit_fp, 63, 2879)
    if audit_fp != 181685497 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 45, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 45, 1103)
    if entry_fp != 868378560 { return 3 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 42, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, 977002972, 1951)
    readiness_fp = mix(readiness_fp, 263327815, 1951)
    readiness_fp = mix(readiness_fp, 4917294, 1951)
    readiness_fp = mix(readiness_fp, 750750705, 1951)
    readiness_fp = mix(readiness_fp, 486030685, 1951)
    if readiness_fp != 584513793 { return 4 }
    return 0
}
