//@ run-pass
//@ expect-stdout: PASS: GPU param names readonly-pair

kernel fn names_readonly_pair(count: i64, x: &[f64], y: &[f64], out: &![f64]) with GPU {
    let idx = gpu_thread_id_x()
    if idx < count {
        out[idx as usize] = x[idx as usize] + y[idx as usize]
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU {
    var src: [f64; 96] = [0.0; 96]
    var other: [f64; 96] = [0.0; 96]
    var dst: [f64; 96] = [0.0; 96]

    var i: i64 = 0
    while i < 96 {
        src[i as usize] = (i as f64) + 3.0
        other[i as usize] = (i as f64) * 7.0
        i = i + 1
    }

    names_readonly_pair(96, &src, &other, &!dst)

    if dst[0] > 2.99 && dst[0] < 3.01 &&
       dst[1] > 10.99 && dst[1] < 11.01 &&
       dst[95] > 762.99 && dst[95] < 763.01 {
        println("PASS: GPU param names readonly-pair")
    } else {
        println("FAIL: GPU param names readonly-pair")
    }
    0
}
