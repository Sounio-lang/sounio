//@ run-pass
//@ requires: madaros
//@ expect-stdout: rw0 0.090000
//@ expect-stdout: rw1 0.810000
//@ expect-stdout: rw2 7.290000
//@ expect-stdout: rw12 25418658283.290001
//@ expect-stdout: rwneg 0.090000
//@ expect-stdout: sb0 0.090000
//@ expect-stdout: sb1 0.000000
//@ expect-stdout: sb2 0.090000
//@ expect-stdout: sb12 10.890000
//@ expect-stdout: sq1 9.000000
//@ expect-stdout: sq2 22500.000000
//@ expect-stdout: dv1 0.038125
//@ expect-stdout: dv2 0.021250
//@ expect-stdout: RECUR_STEP_OK
// a = 5 +- 0.3, var = 0.09. b = 2 +- 0.1, var = 0.01.
// 2*r + r is 3^n copies. r - a is (1-n)*a. r*r squares.
// r/b at n = 1 is 0.61/16. At n = 2 it is 0.02125.

fn rw(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        2.0 * rw(x, n - 1) + rw(x, n - 1)
    }
}

fn sb(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        sb(x, n - 1) - x
    }
}

fn sq(x: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        sq(x, n - 1) * sq(x, n - 1)
    }
}

fn dv(x: f64, y: f64, n: i64) -> f64 {
    if n < 1 {
        x
    } else {
        dv(x, y, n - 1) / y
    }
}

fn main() -> i64 with IO, Epistemic {
    let kx: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let ky: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
    let a = kx.value
    let b = ky.value
    let rw0 = variance_of(rw(a, 0))
    let rw1 = variance_of(rw(a, 1))
    let rw2 = variance_of(rw(a, 2))
    let rw12 = variance_of(rw(a, 12))
    let rwneg = variance_of(rw(a, 0 - 2))
    let sb0 = variance_of(sb(a, 0))
    let sb1 = variance_of(sb(a, 1))
    let sb2 = variance_of(sb(a, 2))
    let sb12 = variance_of(sb(a, 12))
    let sq1 = variance_of(sq(a, 1))
    let sq2 = variance_of(sq(a, 2))
    let dv1 = variance_of(dv(a, b, 1))
    let dv2 = variance_of(dv(a, b, 2))
    print("rw0 ")
    print_f64(rw0)
    println("")
    print("rw1 ")
    print_f64(rw1)
    println("")
    print("rw2 ")
    print_f64(rw2)
    println("")
    print("rw12 ")
    print_f64(rw12)
    println("")
    print("rwneg ")
    print_f64(rwneg)
    println("")
    print("sb0 ")
    print_f64(sb0)
    println("")
    print("sb1 ")
    print_f64(sb1)
    println("")
    print("sb2 ")
    print_f64(sb2)
    println("")
    print("sb12 ")
    print_f64(sb12)
    println("")
    print("sq1 ")
    print_f64(sq1)
    println("")
    print("sq2 ")
    print_f64(sq2)
    println("")
    print("dv1 ")
    print_f64(dv1)
    println("")
    print("dv2 ")
    print_f64(dv2)
    println("")
    var fails: i64 = 0
    if rw0 < 0.089999 || rw0 > 0.090001 { fails = fails + 1 }
    if rw1 < 0.809999 || rw1 > 0.810001 { fails = fails + 1 }
    if rw2 < 7.289999 || rw2 > 7.290001 { fails = fails + 1 }
    if rw12 < 25418658283.29 || rw12 > 25418658283.30 { fails = fails + 1 }
    if rwneg < 0.089999 || rwneg > 0.090001 { fails = fails + 1 }
    if sb0 < 0.089999 || sb0 > 0.090001 { fails = fails + 1 }
    if sb1 < 0.0 - 0.000001 || sb1 > 0.000001 { fails = fails + 1 }
    if sb2 < 0.089999 || sb2 > 0.090001 { fails = fails + 1 }
    if sb12 < 10.889999 || sb12 > 10.890001 { fails = fails + 1 }
    if sq1 < 8.999999 || sq1 > 9.000001 { fails = fails + 1 }
    if sq2 < 22499.999 || sq2 > 22500.001 { fails = fails + 1 }
    if dv1 < 0.038124 || dv1 > 0.038126 { fails = fails + 1 }
    if dv2 < 0.021249 || dv2 > 0.021251 { fails = fails + 1 }
    if fails == 0 {
        println("RECUR_STEP_OK")
        0
    } else {
        println("RECUR_STEP_FAIL")
        1
    }
}
