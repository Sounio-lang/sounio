//@ run-pass
//@ requires: madaros
//@ expect-stdout: refused 1 1 1 1
//@ expect-stdout: inside 0
//@ expect-stdout: TABLE1_REFUSED
// Kefi and Huot, Table 1, four alloys, at 298.15 K.
// Five pressures have 3 degrees of freedom. The 5% point of that
// chi-square is 7.814727903251172. All four fits are outside the
// measured temperatures and reject the parentheses.

use epistemic::regression::plateau_pressure

fn flag(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn row4(t0: f64, t1: f64, t2: f64, t3: f64, p0: f64, p1: f64, p2: f64, p3: f64, u0: f64, u1: f64, u2: f64, u3: f64, t_star: f64) -> i64 with Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / t0
    xs[1] = 1.0 / t1
    xs[2] = 1.0 / t2
    xs[3] = 1.0 / t3
    ys[0] = log(p0 / 100.0)
    ys[1] = log(p1 / 100.0)
    ys[2] = log(p2 / 100.0)
    ys[3] = log(p3 / 100.0)
    uln[0] = u0 / p0
    uln[1] = u1 / p1
    uln[2] = u2 / p2
    uln[3] = u3 / p3
    let published = plateau_pressure(xs, ys, uln, 4, 1.0 / t_star, 100.0)
    flag(published.refused)
}

fn row5(t_star: f64) -> i64 with Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 423.0
    xs[1] = 1.0 / 448.0
    xs[2] = 1.0 / 473.0
    xs[3] = 1.0 / 483.0
    xs[4] = 1.0 / 498.0
    ys[0] = log(27.0 / 100.0)
    ys[1] = log(95.0 / 100.0)
    ys[2] = log(154.0 / 100.0)
    ys[3] = log(457.0 / 100.0)
    ys[4] = log(638.0 / 100.0)
    uln[0] = 2.0 / 27.0
    uln[1] = 1.0 / 95.0
    uln[2] = 4.0 / 154.0
    uln[3] = 2.0 / 457.0
    uln[4] = 1.0 / 638.0
    let published = plateau_pressure(xs, ys, uln, 5, 1.0 / t_star, 100.0)
    flag(published.refused)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    let mn10 = row4(423.0, 448.0, 473.0, 498.0, 72.0, 172.0, 355.0, 630.0, 1.0, 1.0, 2.0, 1.0, 298.15)
    let mn66 = row5(298.15)
    let mn33 = row4(423.0, 448.0, 473.0, 498.0, 59.0, 155.0, 300.0, 629.0, 1.0, 1.0, 2.0, 2.0, 298.15)
    let cr = row4(398.0, 423.0, 448.0, 498.0, 42.0, 103.0, 182.0, 610.0, 3.0, 1.0, 2.0, 1.0, 298.15)
    let inside = row4(398.0, 423.0, 448.0, 498.0, 42.0, 103.0, 182.0, 610.0, 3.0, 1.0, 2.0, 1.0, 448.0)
    print("refused ")
    print_int(mn10)
    print(" ")
    print_int(mn66)
    print(" ")
    print_int(mn33)
    print(" ")
    print_int(cr)
    println("")
    print("inside ")
    print_int(inside)
    println("")
    if mn10 == 1 && mn66 == 1 && mn33 == 1 && cr == 1 && inside == 0 {
        println("TABLE1_REFUSED")
        return 0
    }
    println("TABLE1_FAIL")
    1
}
