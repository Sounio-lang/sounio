//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v75 smoke for Lorenz i256 step-5 Taylor-2 proof-trace skeleton

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1283
    receipt_fp = mix(receipt_fp, 971755585, 5051)
    receipt_fp = mix(receipt_fp, 205079086, 5051)
    receipt_fp = mix(receipt_fp, 762143588, 5051)
    receipt_fp = mix(receipt_fp, 258352795, 5051)
    receipt_fp = mix(receipt_fp, 758491585, 5051)
    receipt_fp = mix(receipt_fp, 522438539, 5051)
    receipt_fp = mix(receipt_fp, 635257553, 5051)
    receipt_fp = mix(receipt_fp, 989883403, 5051)
    receipt_fp = mix(receipt_fp, 754841079, 5051)
    receipt_fp = mix(receipt_fp, 5, 5051)
    receipt_fp = mix(receipt_fp, 6, 5051)
    receipt_fp = mix(receipt_fp, 255, 5051)
    if receipt_fp != 722867370 { return 1 }

    var audit_fp: i64 = 1289
    audit_fp = mix(audit_fp, receipt_fp, 5059)
    audit_fp = mix(audit_fp, 971755585, 5059)
    audit_fp = mix(audit_fp, 205079086, 5059)
    audit_fp = mix(audit_fp, 762143588, 5059)
    audit_fp = mix(audit_fp, 258352795, 5059)
    audit_fp = mix(audit_fp, 989883403, 5059)
    audit_fp = mix(audit_fp, 754841079, 5059)
    audit_fp = mix(audit_fp, 635257553, 5059)
    audit_fp = mix(audit_fp, 5, 5059)
    audit_fp = mix(audit_fp, 6, 5059)
    audit_fp = mix(audit_fp, 255, 5059)
    if audit_fp != 605882312 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 78, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 78, 1103)
    if entry_fp != 797401729 { return 3 }

    let manifest_fp: i64 = 698709746
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 75, 1871)
    result_fp = mix(result_fp, 79, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 67, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 764658303 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 75, 1907)
    family_fp = mix(family_fp, 79, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 62, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 763344341 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 75, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 980834451 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 75, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 340435167 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 75, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 466346197 { return 8 }
    return 0
}
