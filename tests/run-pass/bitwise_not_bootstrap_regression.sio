//@ run-pass

fn mask_subset(required: i64, available: i64) -> bool {
    (required & available) == required
}

fn effect_violation_shape(callee_eff: i64, caller_eff: i64, callee_is_import: bool, caller_is_import: bool) -> bool {
    (callee_eff & ~caller_eff) != 0 && !(callee_is_import && caller_is_import)
}

fn main() -> i64 {
    let all_basic: i64 = 31
    let io_mut: i64 = 3
    let extra_bit: i64 = 32

    if ~0 != -1 { return 10 }
    if ~all_basic != -32 { return 11 }
    if (all_basic & ~all_basic) != 0 { return 12 }
    if (io_mut & ~all_basic) != 0 { return 13 }
    if mask_subset(io_mut, all_basic) == false { return 14 }
    if mask_subset(extra_bit, all_basic) { return 15 }
    if effect_violation_shape(io_mut, all_basic, false, false) { return 16 }
    if effect_violation_shape(extra_bit, all_basic, false, false) == false { return 17 }
    if effect_violation_shape(extra_bit, io_mut, true, true) { return 18 }

    return 0
}
