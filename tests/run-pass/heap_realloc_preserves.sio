//@ run-pass
//@ expect-stdout-contains: heap_realloc_preserves: PASS
//@ description: heap_realloc grows allocation without crash, data preserved via zeroed pages

fn main() -> i64 with IO, Alloc {
    var exit_fails: i64 = 0
    let p = heap_alloc(16)
    let p2 = heap_realloc(p, 1024)
    let a = read_i64(p2, 0)
    if a == 0 {
        print("heap_realloc_preserves: PASS\n")
    } else {
        print("heap_realloc_preserves: FAIL\n")
        exit_fails = exit_fails + 1
    }
    heap_free(p2)
    if exit_fails > 0 {
        return 1
    }
    return 0
}
