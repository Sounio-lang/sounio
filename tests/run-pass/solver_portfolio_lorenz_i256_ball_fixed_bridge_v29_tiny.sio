//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v29 smoke for Lorenz i256-to-ball-fixed bridge receipt

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 32 { return 0 - 1 }
    if instance_fp != 149359034 { return 0 - 1 }
    if certificate_fp != 488107916 { return 0 - 1 }
    if result_code != 1 { return 0 - 1 }
    if checker_code != 32 { return 0 - 1 }

    var fp: i64 = 101
    fp = portfolio_mix(fp, kind, 1103)
    fp = portfolio_mix(fp, instance_fp, 1103)
    fp = portfolio_mix(fp, certificate_fp, 1103)
    fp = portfolio_mix(fp, result_code, 1103)
    fp = portfolio_mix(fp, checker_code, 1103)
    return fp
}

fn bridge_instance_fingerprint(scale_log2: i64,
                               source_scale: i64,
                               target_scale: i64,
                               trajectory_manifest_fp: i64,
                               final_x_2p32: i64,
                               final_y_2p32: i64,
                               final_z_2p32: i64) -> i64 with Mod {
    if scale_log2 != 32 { return 0 - 1 }
    if source_scale != 4294967296 { return 0 - 1 }
    if target_scale != 1000000 { return 0 - 1 }
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if final_x_2p32 != 5309941770 { return 0 - 1 }
    if final_y_2p32 != 10058731223 { return 0 - 1 }
    if final_z_2p32 != 4084837935 { return 0 - 1 }

    var fp: i64 = 271
    fp = portfolio_mix(fp, scale_log2, 2447)
    fp = portfolio_mix(fp, source_scale, 2447)
    fp = portfolio_mix(fp, target_scale, 2447)
    fp = portfolio_mix(fp, trajectory_manifest_fp, 2447)
    fp = portfolio_mix(fp, final_x_2p32, 2447)
    fp = portfolio_mix(fp, final_y_2p32, 2447)
    fp = portfolio_mix(fp, final_z_2p32, 2447)
    return fp
}

fn bridge_certificate_fingerprint(bridge_instance_fp: i64,
                                  projection_inclusion_fp: i64,
                                  projection_contract_fp: i64,
                                  final_enclosure_receipt_fp: i64,
                                  enclosure3_fp: i64,
                                  inclusion_mask: i64) -> i64 with Mod {
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if projection_inclusion_fp != 890086395 { return 0 - 1 }
    if projection_contract_fp != 607091799 { return 0 - 1 }
    if final_enclosure_receipt_fp != 114244647 { return 0 - 1 }
    if enclosure3_fp != 166945519 { return 0 - 1 }
    if inclusion_mask != 7 { return 0 - 1 }

    var fp: i64 = 277
    fp = portfolio_mix(fp, bridge_instance_fp, 2459)
    fp = portfolio_mix(fp, projection_inclusion_fp, 2459)
    fp = portfolio_mix(fp, projection_contract_fp, 2459)
    fp = portfolio_mix(fp, final_enclosure_receipt_fp, 2459)
    fp = portfolio_mix(fp, enclosure3_fp, 2459)
    fp = portfolio_mix(fp, inclusion_mask, 2459)
    return fp
}

fn bridge_audit_fingerprint(bridge_instance_fp: i64,
                            bridge_certificate_fp: i64,
                            projection_portfolio_manifest_fp: i64,
                            enclosure_portfolio_manifest_fp: i64,
                            lifecycle_portfolio_readiness_fp: i64,
                            readiness_mask: i64) -> i64 with Mod {
    if bridge_instance_fp != 149359034 { return 0 - 1 }
    if bridge_certificate_fp != 138609006 { return 0 - 1 }
    if projection_portfolio_manifest_fp != 326517892 { return 0 - 1 }
    if enclosure_portfolio_manifest_fp != 291678314 { return 0 - 1 }
    if lifecycle_portfolio_readiness_fp != 413118064 { return 0 - 1 }
    if readiness_mask != 31 { return 0 - 1 }

    var fp: i64 = 281
    fp = portfolio_mix(fp, bridge_instance_fp, 2473)
    fp = portfolio_mix(fp, bridge_certificate_fp, 2473)
    fp = portfolio_mix(fp, projection_portfolio_manifest_fp, 2473)
    fp = portfolio_mix(fp, enclosure_portfolio_manifest_fp, 2473)
    fp = portfolio_mix(fp, lifecycle_portfolio_readiness_fp, 2473)
    fp = portfolio_mix(fp, readiness_mask, 2473)
    return fp
}

fn portfolio_v29_manifest_fingerprint(bridge_entry_fp: i64) -> i64 with Mod {
    if bridge_entry_fp != 916832909 { return 0 - 1 }

    var fp: i64 = 107
    fp = portfolio_mix(fp, 29, 1151)
    fp = portfolio_mix(fp, 33, 1151)
    fp = portfolio_mix(fp, 53646245, 1151)
    fp = portfolio_mix(fp, 528026990, 1151)
    fp = portfolio_mix(fp, 301444501, 1151)
    fp = portfolio_mix(fp, 258927862, 1151)
    fp = portfolio_mix(fp, 388915166, 1151)
    fp = portfolio_mix(fp, 900589789, 1151)
    fp = portfolio_mix(fp, 205040674, 1151)
    fp = portfolio_mix(fp, 580031260, 1151)
    fp = portfolio_mix(fp, 973127057, 1151)
    fp = portfolio_mix(fp, 438043475, 1151)
    fp = portfolio_mix(fp, 887056435, 1151)
    fp = portfolio_mix(fp, 769531137, 1151)
    fp = portfolio_mix(fp, 579271506, 1151)
    fp = portfolio_mix(fp, 252932879, 1151)
    fp = portfolio_mix(fp, 838301653, 1151)
    fp = portfolio_mix(fp, 755389732, 1151)
    fp = portfolio_mix(fp, 521104746, 1151)
    fp = portfolio_mix(fp, 537394311, 1151)
    fp = portfolio_mix(fp, 827916944, 1151)
    fp = portfolio_mix(fp, 626160047, 1151)
    fp = portfolio_mix(fp, 590228875, 1151)
    fp = portfolio_mix(fp, 46718256, 1151)
    fp = portfolio_mix(fp, 295040814, 1151)
    fp = portfolio_mix(fp, 124720146, 1151)
    fp = portfolio_mix(fp, 988622529, 1151)
    fp = portfolio_mix(fp, 757892608, 1151)
    fp = portfolio_mix(fp, 3812644, 1151)
    fp = portfolio_mix(fp, 777068644, 1151)
    fp = portfolio_mix(fp, 423305090, 1151)
    fp = portfolio_mix(fp, 63872871, 1151)
    fp = portfolio_mix(fp, 547731575, 1151)
    fp = portfolio_mix(fp, 620031252, 1151)
    fp = portfolio_mix(fp, bridge_entry_fp, 1151)
    return fp
}

fn portfolio_v29_result_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 137630154 { return 0 - 1 }

    var fp: i64 = 131
    fp = portfolio_mix(fp, 29, 1871)
    fp = portfolio_mix(fp, 33, 1871)
    fp = portfolio_mix(fp, 10, 1871)
    fp = portfolio_mix(fp, 21, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, 1, 1871)
    fp = portfolio_mix(fp, manifest_fp, 1871)
    return fp
}

fn portfolio_v29_checker_family_coverage_fingerprint(manifest_fp: i64) -> i64 with Mod {
    if manifest_fp != 137630154 { return 0 - 1 }

    var fp: i64 = 149
    fp = portfolio_mix(fp, 29, 1907)
    fp = portfolio_mix(fp, 33, 1907)
    fp = portfolio_mix(fp, 6, 1907)
    fp = portfolio_mix(fp, 3, 1907)
    fp = portfolio_mix(fp, 2, 1907)
    fp = portfolio_mix(fp, 1, 1907)
    fp = portfolio_mix(fp, 21, 1907)
    fp = portfolio_mix(fp, manifest_fp, 1907)
    return fp
}

fn portfolio_v29_readiness_fingerprint(manifest_fp: i64,
                                       result_coverage_fp: i64,
                                       family_coverage_fp: i64,
                                       acceptance_receipt_fp: i64,
                                       audit_receipt_fp: i64) -> i64 with Mod {
    if manifest_fp != 137630154 { return 0 - 1 }
    if result_coverage_fp != 904709304 { return 0 - 1 }
    if family_coverage_fp != 70534950 { return 0 - 1 }
    if acceptance_receipt_fp != 685946948 { return 0 - 1 }
    if audit_receipt_fp != 493502604 { return 0 - 1 }

    var fp: i64 = 163
    fp = portfolio_mix(fp, 29, 1951)
    fp = portfolio_mix(fp, 31, 1951)
    fp = portfolio_mix(fp, manifest_fp, 1951)
    fp = portfolio_mix(fp, result_coverage_fp, 1951)
    fp = portfolio_mix(fp, family_coverage_fp, 1951)
    fp = portfolio_mix(fp, acceptance_receipt_fp, 1951)
    fp = portfolio_mix(fp, audit_receipt_fp, 1951)
    return fp
}

fn main() -> i64 with Mod {
    let instance_fp = bridge_instance_fingerprint(
        32, 4294967296, 1000000, 214180161,
        5309941770, 10058731223, 4084837935)
    if instance_fp != 149359034 { return 1 }

    let certificate_fp = bridge_certificate_fingerprint(
        instance_fp, 890086395, 607091799, 114244647, 166945519, 7)
    if certificate_fp != 138609006 { return 2 }

    let audit_fp = bridge_audit_fingerprint(
        instance_fp, certificate_fp, 326517892, 291678314, 413118064, 31)
    if audit_fp != 488107916 { return 3 }

    let entry_fp = portfolio_entry_fingerprint(32, instance_fp, audit_fp, 1, 32)
    if entry_fp != 916832909 { return 4 }

    let manifest_fp = portfolio_v29_manifest_fingerprint(entry_fp)
    if manifest_fp != 137630154 { return 5 }

    let result_coverage_fp = portfolio_v29_result_coverage_fingerprint(manifest_fp)
    if result_coverage_fp != 904709304 { return 6 }

    let family_coverage_fp = portfolio_v29_checker_family_coverage_fingerprint(manifest_fp)
    if family_coverage_fp != 70534950 { return 7 }

    if portfolio_v29_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        685946948, 493502604) != 182721636 { return 8 }

    if bridge_audit_fingerprint(
        instance_fp, certificate_fp, 326517892, 291678314, 413118065, 31) != (0 - 1) { return 9 }
    if portfolio_entry_fingerprint(32, instance_fp, audit_fp, 0, 32) != (0 - 1) { return 10 }
    if portfolio_v29_manifest_fingerprint(entry_fp + 1) != (0 - 1) { return 11 }
    if portfolio_v29_readiness_fingerprint(
        manifest_fp, result_coverage_fp, family_coverage_fp,
        685946948, 493502605) != (0 - 1) { return 12 }

    return 0
}
