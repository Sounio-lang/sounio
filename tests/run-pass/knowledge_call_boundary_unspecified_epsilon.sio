//@ run-pass
//@ expect-stdout: unspecified epsilon boundary: PASS
// A Knowledge<T> parameter with no epsilon bound states no confidence
// requirement, so an argument with no epsilon of its own satisfies it. Both the
// literal argument and the let-bound one were refused with E036 while the
// boundary tested the provided epsilon (-1.0, unspecified) before noticing that
// nothing was required.

struct Reading {
    age: i64,
}

fn take(p: Knowledge<Reading>) -> i64 {
    return 7
}

fn main() -> i32 with IO {
    let direct = take(Knowledge {
        value: Reading { age: 21 }
    })
    let k: Knowledge<Reading> = Knowledge {
        value: Reading { age: 30 }
    }
    let bound = take(k)
    if direct + bound == 14 {
        print("unspecified epsilon boundary: PASS\n")
    }
    return 0
}
