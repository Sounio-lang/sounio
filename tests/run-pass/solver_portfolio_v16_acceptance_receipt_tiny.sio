//@ run-pass
//@ requires: madaros
//@ description: Self-contained solver portfolio v16 acceptance receipt smoke

fn portfolio_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_v16_acceptance_receipt_fingerprint(version: i64,
                                                manifest_fp: i64,
                                                coverage_fp: i64) -> i64 with Mod {
    if version != 16 { return 0 - 1 }
    if manifest_fp != 320118125 { return 0 - 1 }
    if coverage_fp != 685105937 { return 0 - 1 }

    var fp: i64 = 137
    fp = portfolio_mix(fp, version, 1889)
    fp = portfolio_mix(fp, manifest_fp, 1889)
    fp = portfolio_mix(fp, coverage_fp, 1889)
    return fp
}

fn main() -> i64 with Mod {
    let receipt_fp = portfolio_v16_acceptance_receipt_fingerprint(
        16, 320118125, 685105937)
    if receipt_fp != 629028996 { return 1 }

    if portfolio_v16_acceptance_receipt_fingerprint(
        15, 320118125, 685105937) != (0 - 1) { return 2 }
    if portfolio_v16_acceptance_receipt_fingerprint(
        16, 320118126, 685105937) != (0 - 1) { return 3 }
    if portfolio_v16_acceptance_receipt_fingerprint(
        16, 320118125, 685105938) != (0 - 1) { return 4 }

    return 0
}
