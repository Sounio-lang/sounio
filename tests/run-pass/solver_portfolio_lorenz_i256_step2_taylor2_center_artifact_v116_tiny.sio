//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v116 smoke for Lorenz i256 step-2 Taylor-2 center artifact

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1759
    receipt_fp = mix(receipt_fp, 554654324, 5689)
    receipt_fp = mix(receipt_fp, 135610689, 5689)
    receipt_fp = mix(receipt_fp, 867385129, 5689)
    receipt_fp = mix(receipt_fp, 50054842, 5689)
    receipt_fp = mix(receipt_fp, 865711690, 5689)
    receipt_fp = mix(receipt_fp, 242024859, 5689)
    receipt_fp = mix(receipt_fp, 442225509, 5689)
    receipt_fp = mix(receipt_fp, 482555681, 5689)
    receipt_fp = mix(receipt_fp, 591288676, 5689)
    receipt_fp = mix(receipt_fp, 2, 5689)
    receipt_fp = mix(receipt_fp, 1, 5689)
    receipt_fp = mix(receipt_fp, 255, 5689)
    if receipt_fp != 756645477 { return 1 }

    var audit_fp: i64 = 1777
    audit_fp = mix(audit_fp, receipt_fp, 5693)
    audit_fp = mix(audit_fp, 554654324, 5693)
    audit_fp = mix(audit_fp, 135610689, 5693)
    audit_fp = mix(audit_fp, 867385129, 5693)
    audit_fp = mix(audit_fp, 50054842, 5693)
    audit_fp = mix(audit_fp, 482555681, 5693)
    audit_fp = mix(audit_fp, 591288676, 5693)
    audit_fp = mix(audit_fp, 442225509, 5693)
    audit_fp = mix(audit_fp, 2, 5693)
    audit_fp = mix(audit_fp, 1, 5693)
    audit_fp = mix(audit_fp, 255, 5693)
    if audit_fp != 787573492 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 119, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 119, 1103)
    if entry_fp != 711786580 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 116, 1151)
    manifest_fp = mix(manifest_fp, 120, 1151)
    manifest_fp = mix(manifest_fp, 242024859, 1151)
    manifest_fp = mix(manifest_fp, 865711690, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 905577950 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 116, 1871)
    result_fp = mix(result_fp, 120, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 108, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 455301414 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 116, 1907)
    family_fp = mix(family_fp, 120, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 103, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 682501358 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 116, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 947996951 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 116, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 624876688 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 116, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 812289972 { return 9 }
    return 0
