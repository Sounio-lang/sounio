//@ run-pass
//@ requires: madaros
//@ description: Scalar LRAT deletion lifecycle receipt smoke

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn lifecycle_manifest_fingerprint(original_clause_count: i64,
                                  derived_clause_count: i64,
                                  delete_count: i64,
                                  first_derived_id: i64,
                                  final_clause_id: i64,
                                  final_clause_len: i64) -> i64 with Mod {
    if original_clause_count != 3 { return 0 - 1 }
    if derived_clause_count != 2 { return 0 - 1 }
    if delete_count != 2 { return 0 - 1 }
    if first_derived_id != 4 { return 0 - 1 }
    if final_clause_id != 5 { return 0 - 1 }
    if final_clause_len != 0 { return 0 - 1 }

    var fp: i64 = 197
    fp = mix(fp, original_clause_count, 2371)
    fp = mix(fp, derived_clause_count, 2371)
    fp = mix(fp, delete_count, 2371)
    fp = mix(fp, first_derived_id, 2371)
    fp = mix(fp, final_clause_id, 2371)
    fp = mix(fp, final_clause_len, 2371)
    return fp
}

fn lifecycle_audit_fingerprint(manifest_fp: i64,
                               next_id_before_derivation: i64,
                               next_id_after_unit: i64,
                               next_id_after_empty: i64,
                               reused_id_blocked: i64,
                               deleted_hint_blocked_count: i64,
                               final_empty_seen: i64) -> i64 with Mod {
    if manifest_fp != 6950141 { return 0 - 1 }
    if next_id_before_derivation != 4 { return 0 - 1 }
    if next_id_after_unit != 5 { return 0 - 1 }
    if next_id_after_empty != 0 { return 0 - 1 }
    if reused_id_blocked != 1 { return 0 - 1 }
    if deleted_hint_blocked_count != 2 { return 0 - 1 }
    if final_empty_seen != 1 { return 0 - 1 }

    var fp: i64 = 199
    fp = mix(fp, manifest_fp, 2383)
    fp = mix(fp, next_id_before_derivation, 2383)
    fp = mix(fp, next_id_after_unit, 2383)
    fp = mix(fp, next_id_after_empty, 2383)
    fp = mix(fp, reused_id_blocked, 2383)
    fp = mix(fp, deleted_hint_blocked_count, 2383)
    fp = mix(fp, final_empty_seen, 2383)
    return fp
}

fn lifecycle_unsat_envelope_fingerprint(manifest_fp: i64,
                                        audit_fp: i64,
                                        final_clause_id: i64,
                                        final_clause_len: i64,
                                        delete_count: i64,
                                        lrat_empty_seen: i64) -> i64 with Mod {
    if manifest_fp != 6950141 { return 0 - 1 }
    if audit_fp != 109354544 { return 0 - 1 }
    if final_clause_id != 5 { return 0 - 1 }
    if final_clause_len != 0 { return 0 - 1 }
    if delete_count != 2 { return 0 - 1 }
    if lrat_empty_seen != 1 { return 0 - 1 }

    var fp: i64 = 211
    fp = mix(fp, manifest_fp, 2399)
    fp = mix(fp, audit_fp, 2399)
    fp = mix(fp, final_clause_id, 2399)
    fp = mix(fp, final_clause_len, 2399)
    fp = mix(fp, delete_count, 2399)
    fp = mix(fp, lrat_empty_seen, 2399)
    return fp
}

fn main() -> i64 with Mod {
    let manifest_fp = lifecycle_manifest_fingerprint(3, 2, 2, 4, 5, 0)
    if manifest_fp != 6950141 { return 1 }

    let audit_fp = lifecycle_audit_fingerprint(manifest_fp, 4, 5, 0, 1, 2, 1)
    if audit_fp != 109354544 { return 2 }

    let envelope_fp = lifecycle_unsat_envelope_fingerprint(manifest_fp, audit_fp, 5, 0, 2, 1)
    if envelope_fp != 9126320 { return 3 }

    if lifecycle_manifest_fingerprint(3, 2, 1, 4, 5, 0) != (0 - 1) { return 4 }
    if lifecycle_audit_fingerprint(manifest_fp, 4, 5, 0, 1, 1, 1) != (0 - 1) { return 5 }
    if lifecycle_unsat_envelope_fingerprint(manifest_fp, audit_fp, 5, 1, 2, 1) != (0 - 1) { return 6 }

    return 0
}
