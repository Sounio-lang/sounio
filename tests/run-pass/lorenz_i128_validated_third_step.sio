//@ run-pass
//@ description: Lorenz i128 third-step enclosure contract from second validated enclosure

fn main() -> i64 {
    // The i128 center transition step2 -> step3 is already covered by
    // lorenz_i128_ball_three_step.sio. This contract carries the validated
    // second-step radius forward and adds a third interval LTE budget.
    let cx3: i64 = 1075156
    let cy3: i64 = 1779721
    let cz3: i64 = 959424

    // Second validated enclosure from lorenz_i128_validated_second_step.sio.
    let xr2: i64 = 59353
    let yr2: i64 = 76456
    let zr2: i64 = 8313

    // Radius propagation through one Euler vector-field evaluation at step 2.
    let dxr2: i64 = 10 * (yr2 + xr2)
    let x_rhoz_r2: i64 = ((1026000 * zr2) + (27030288 * xr2) + (xr2 * zr2)) / 1000000 + 1
    let dyr2: i64 = x_rhoz_r2 + yr2
    let xyr2: i64 = ((1026000 * yr2) + (1517566 * xr2) + (xr2 * yr2)) / 1000000 + 1
    let beta_zr2: i64 = ((8 * zr2) + 2) / 3
    let dzr2: i64 = xyr2 + beta_zr2

    let euler_xr3: i64 = xr2 + (10000 * dxr2) / 1000000 + 1
    let euler_yr3: i64 = yr2 + (10000 * dyr2) / 1000000 + 1
    let euler_zr3: i64 = zr2 + (10000 * dzr2) / 1000000 + 1

    // Tube covering the second validated enclosure and the third Euler ball:
    //   x in [966647, 1148090]
    //   y in [1441110, 1873076]
    //   z in [949158, 978025]
    let scale64: i64 = 1000000
    let h2: i64 = 100000000
    let lte_den: i64 = 2000000000000
    let x_abs: i64 = 1148090
    let y_abs: i64 = 1873076
    let z_abs: i64 = 978025
    let rhoz_abs: i64 = 27050842

    let f_x_abs: i64 = 10 * (y_abs + x_abs)
    let f_y_abs: i64 = (x_abs * rhoz_abs + scale64 - 1) / scale64 + y_abs
    let f_z_abs: i64 = (x_abs * y_abs + scale64 - 1) / scale64 + ((8 * z_abs) + 2) / 3

    let ddx_abs: i64 = 10 * (f_y_abs + f_x_abs)
    let ddy_abs: i64 = (f_x_abs * rhoz_abs + scale64 - 1) / scale64 +
                       (x_abs * f_z_abs + scale64 - 1) / scale64 +
                       f_y_abs
    let ddz_abs: i64 = (f_x_abs * y_abs + scale64 - 1) / scale64 +
                       (x_abs * f_y_abs + scale64 - 1) / scale64 +
                       ((8 * f_z_abs) + 2) / 3

    let lte_x: i64 = (h2 * ddx_abs + lte_den - 1) / lte_den
    let lte_y: i64 = (h2 * ddy_abs + lte_den - 1) / lte_den
    let lte_z: i64 = (h2 * ddz_abs + lte_den - 1) / lte_den

    let final_xr3: i64 = euler_xr3 + lte_x
    let final_yr3: i64 = euler_yr3 + lte_y
    let final_zr3: i64 = euler_zr3 + lte_z

    let x_lo: i64 = cx3 - final_xr3
    let x_hi: i64 = cx3 + final_xr3
    let y_lo: i64 = cy3 - final_yr3
    let y_hi: i64 = cy3 + final_yr3
    let z_lo: i64 = cz3 - final_zr3
    let z_hi: i64 = cz3 + final_zr3

    if dxr2 != 1358090 { return 1 }
    if x_rhoz_r2 != 1613352 { return 2 }
    if dyr2 != 1689808 { return 3 }
    if xyr2 != 173054 { return 4 }
    if beta_zr2 != 22168 { return 5 }
    if dzr2 != 195222 { return 6 }
    if euler_xr3 != 72934 { return 7 }
    if euler_yr3 != 93355 { return 8 }
    if euler_zr3 != 10266 { return 9 }

    if f_x_abs != 30211660 { return 10 }
    if f_y_abs != 32929878 { return 11 }
    if f_z_abs != 4758527 { return 12 }
    if ddx_abs != 631415380 { return 13 }
    if ddy_abs != 855643938 { return 14 }
    if ddz_abs != 107084606 { return 15 }
    if lte_x != 31571 { return 16 }
    if lte_y != 42783 { return 17 }
    if lte_z != 5355 { return 18 }

    if final_xr3 != 104505 { return 19 }
    if final_yr3 != 136138 { return 20 }
    if final_zr3 != 15621 { return 21 }
    if x_lo != 970651 { return 22 }
    if x_hi != 1179661 { return 23 }
    if y_lo != 1643583 { return 24 }
    if y_hi != 1915859 { return 25 }
    if z_lo != 943803 { return 26 }
    if z_hi != 975045 { return 27 }

    return 0
}
