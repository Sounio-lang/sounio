//@ run-pass
//@ description: elements of a `[string; N]` local are strings -- a store `names[1] = "zeta"` and a read `names[i]` work; the array local was classified as a string itself, so the store wrote one byte into the GC handle (SIGSEGV) and a read printed the element pointer as an integer (stdlib/data/frame.sio worked around it with a FrameStr wrapper)
//@ expect-stdout: a
//@ expect-stdout: zeta
//@ expect-stdout: STRING_ARRAY_OK

fn main() -> i32 with IO, Mut, Panic {
    var names: [string; 3] = ["a", "b", "c"]
    println(names[0])
    names[1] = "zeta"
    println(names[1])
    if str_len(names[1]) != 4 { return 1 }
    if names[2] != "c" { return 2 }
    println("STRING_ARRAY_OK")
    0
}
