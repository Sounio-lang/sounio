//@ run-pass
//@ requires: madaros
//@ expect-stdout: flat 90.572934 110.408259
//@ expect-stdout: pair 100.000000 271.828183
//@ expect-stdout: df1 1 0
//@ expect-stdout: HAND_BAND_OK
// Three logs, all zero, uncertainties 1, 0.1 and 1. At the weighted
// mean the variance is 1/102, so the band is 100*exp(±sqrt(1/102)).
// Two logs 0 and 1 at the same x, and a third at (1, 0), give
// chi 50 and the band 100*exp(0.5±0.5). One degree of freedom refuses
// a chi of 4 outside the fitted x and does not refuse a chi of 3.

use epistemic::regression::plateau_pressure

fn sq(x: f64) -> f64 with Mut, Div {
    if x <= 0.0 { return 0.0 }
    var y = x
    var i = 0
    while i < 40 {
        y = 0.5 * (y + x / y)
        i = i + 1
    }
    y
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn bit(b: bool) -> i64 {
    if b { return 1 }
    0
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 0.0
    xs[1] = 1.0
    xs[2] = 2.0
    ys[0] = 0.0
    ys[1] = 0.0
    ys[2] = 0.0
    uln[0] = 1.0
    uln[1] = 0.1
    uln[2] = 1.0
    let flat = plateau_pressure(xs, ys, uln, 3, 1.0, 100.0)
    let sig = sq(1.0 / 102.0)
    let flat_lo = 100.0 * exp(0.0 - sig)
    let flat_hi = 100.0 * exp(sig)
    let flat_ok = flat.open && !flat.refused && near(flat.chi, 0.0, 0.000001) && near(flat.lo, flat_lo, 0.000001) && near(flat.hi, flat_hi, 0.000001)
    xs[0] = 0.0
    xs[1] = 0.0
    xs[2] = 1.0
    ys[0] = 0.0
    ys[1] = 1.0
    ys[2] = 0.0
    uln[0] = 0.1
    uln[1] = 0.1
    uln[2] = 0.1
    let pair = plateau_pressure(xs, ys, uln, 3, 0.0, 100.0)
    let pair_ok = pair.open && !pair.refused && near(pair.chi, 50.0, 0.000001) && near(pair.lo, 100.0, 0.000001) && near(pair.hi, 100.0 * exp(1.0), 0.000001)
    ys[1] = 0.28284271247
    ys[2] = 0.141421356235
    let above = plateau_pressure(xs, ys, uln, 3, 0.0 - 1.0, 100.0)
    ys[1] = 0.24494897428
    ys[2] = 0.12247448714
    let below = plateau_pressure(xs, ys, uln, 3, 0.0 - 1.0, 100.0)
    let df_ok = above.refused && !below.refused && near(above.chi, 4.0, 0.000001) && near(below.chi, 3.0, 0.000001)
    print("flat ")
    print_f64(flat.lo)
    print(" ")
    print_f64(flat.hi)
    println("")
    print("pair ")
    print_f64(pair.lo)
    print(" ")
    print_f64(pair.hi)
    println("")
    print("df1 ")
    print_int(bit(above.refused))
    print(" ")
    print_int(bit(below.refused))
    println("")
    if flat_ok && pair_ok && df_ok {
        println("HAND_BAND_OK")
        return 0
    }
    println("HAND_BAND_FAIL")
    1
}
