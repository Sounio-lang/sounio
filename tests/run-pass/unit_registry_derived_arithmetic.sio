//@ run-pass
//@ requires: madaros
//@ expect-stdout: unit registry derived: PASS
// #3548: the user declarations and valid arithmetic still work.

unit u0 = m * m;
unit u1 = m * m * m;
unit u2 = m * m * m * m;
unit u3 = m * m * m * m * m;
unit u4 = m * m * m * m * m * m;
unit u5 = m * m * m * m * m * m * m;
unit u6 = m * m * m * m * m * m * m * m;
unit u7 = m * m * m * m * m * m * m * m * m;
unit u8 = m * m * m * m * m * m * m * m * m * m;
unit u9 = m * m * m * m * m * m * m * m * m * m * m;
unit u10 = m * m * m * m * m * m * m * m * m * m * m * m;
unit u11 = m * m * m * m * m * m * m * m * m * m * m * m * m;
unit u12 = m * m * m * m * m * m * m * m * m * m * m * m * m * m;
unit u13 = m * m * m * m * m * m * m * m * m * m * m * m * m * m * m;
fn main() -> i32 with IO, Mut, Panic, Div {
    let a: m = 128.0
    let b: s = 2.0
    let c = a / b / b / b / b / b / b / b
    let sum = c + c
    if (sum as f64) != 2.0 { return 1 }
    print("unit registry derived: PASS\n")
    return 0
}
