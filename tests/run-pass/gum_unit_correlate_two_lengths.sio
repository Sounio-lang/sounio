//@ run-pass
//@ requires: madaros
//@ expect-stdout: UNIT_CORRELATE_PASS

// Two different inputs, each a Knowledge<m>: the value carries the unit
// and the standard uncertainty together. They are not the same variable.
//
//   independent: Var(a+b) = 0.2^2 + 0.1^2 = 0.05
//   correlate(a, b, 1.0): Var(a+b) = (0.2 + 0.1)^2 = 0.09
//   a - a stays at variance 0 (same value, not a second input)

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i64 with IO, Mut, Div, Epistemic {
    let left: Knowledge<m> = measure(10.0, uncertainty: 0.2)
    let right: Knowledge<m> = measure(4.0, uncertainty: 0.1)
    let a = left.value
    let b = right.value
    let v_ind = variance_of(a + b)
    let _r = correlate(a, b, 1.0)
    let v_cor = variance_of(a + b)
    let v_same = variance_of(a - a)
    print("v_ind=")
    print_f64(v_ind)
    print("\n")
    print("v_cor=")
    print_f64(v_cor)
    print("\n")
    print("var_same=")
    print_f64(v_same)
    print("\n")
    let ok = abs_f(v_ind - 0.05) < 1.0e-9 && abs_f(v_cor - 0.09) < 1.0e-9 && abs_f(v_same) < 1.0e-12
    if ok {
        print("UNIT_CORRELATE_PASS\n")
        return 0
    }
    print("UNIT_CORRELATE_FAIL\n")
    return 1
}
