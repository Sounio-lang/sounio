// A10 bisect v2: trait + impl-for-i64 + bounded-generic large-array dep.
use testmod::gen_big2::{GBig2, gbig2_basis}

fn main() -> i64 with IO, Mut, Panic {
    let zero: i64 = 0
    let one: i64 = 1
    let r = gbig2_basis::<i64>(4, 3, zero, one)
    if r.c[3] == 1 && r.c[0] == 0 && r.bits == 4 {
        println("GEN_DEP_SUMMARY2_OK")
        return 0
    }
    println("GEN_DEP_SUMMARY2_FAIL")
    return 1
}
