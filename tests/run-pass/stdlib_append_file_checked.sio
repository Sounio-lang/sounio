//@ run-pass
//@ expect-stdout: APPEND_FILE_CHECKED_OK
// Preserve binary NUL/high bytes, append mode, truncation and error returns.
fn main()->i32 with IO,Mut,Panic {
 let path="/tmp/stdlib_append_file_checked.bin"
 var first:[i8;3]=[0;3]
 first[0]=65 as i8;first[2]=255 as i8
 var tail:[i8;2]=[0;2]
 tail[0]=66 as i8;tail[1]=67 as i8
 assert(write_file(path,first,3)==3)
 assert(append_file(path,tail,2)==2)
 assert(append_file(path,tail,0)==0)
 assert(file_size(path)==5)
 assert(append_file("/stdlib-append-missing-parent/output.bin",tail,2)<0)
 let truncated="/tmp/stdlib_append_file_truncate.bin"
 assert(write_file(truncated,first,3)==3)
 assert(write_file(truncated,tail,1)==1)
 assert(file_size(truncated)==1)
 println("APPEND_FILE_CHECKED_OK")
 return 0
}
