//@ run-pass
//@ expect-stdout: SELF_FALSIFYING_COMPILER_TEST_OK
// Self-falsifying compiler rung
// (docs/research/self_falsifying_compiler_spec_2026-07-25.md).
//
// This file carries three claims: one whose gate passes, one whose gate
// fails, and one archived claim whose (failing) gate must be skipped. Under a
// normal compile/run (no --verify-claims) all claims are inert metadata and
// this program prints the marker below — that is what the run-pass suite
// checks. The compile-time gate behavior is exercised by
// scripts/ci/self_falsifying_compiler_gate.sh, which expects:
//   CLAIM_PASS  sfc_gate_pass
//   CLAIM_FAIL  sfc_gate_fail      (compilation aborts before codegen)
//   CLAIM_SKIP  sfc_archived       (archived verdict: gate never runs)

claim sfc_gate_pass {
    hypothesis = "a claim whose gate script exits 0 survives verification",
    falsifier  = "the gate script exits non-zero or times out",
    evidence   = Evidence::GateGreen,
    harness    = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_claim_gate_pass.sh",
    verdict    = Verdict::Alive,
}

claim sfc_gate_fail {
    hypothesis = "a claim whose gate script exits non-zero is falsified at compile time",
    falsifier  = "the gate script exits non-zero (it always does)",
    evidence   = Evidence::Implemented,
    harness    = "scripts/ci/fixtures/self_falsifying_claim_gate_fail.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_claim_gate_fail.sh",
    verdict    = Verdict::Alive,
}

claim sfc_archived {
    hypothesis = "archived claims are skipped even when their gate would fail",
    falsifier  = "the executor runs this gate anyway",
    evidence   = Evidence::Conceived,
    harness    = "scripts/ci/fixtures/self_falsifying_claim_gate_fail.sh",
    gate       = "scripts/ci/fixtures/self_falsifying_claim_gate_fail.sh",
    verdict    = Verdict::Archived,
    archive_reason = "superseded by sfc_gate_fail; kept to prove skip semantics",
}

fn main() -> i64 with IO {
    print("SELF_FALSIFYING_COMPILER_TEST_OK\n")
    0
}
