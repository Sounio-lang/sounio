//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-5 Taylor-2 completed candidate bundle keeps proof gates separate

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1213
    fp = mix(fp, 5, 4967)
    fp = mix(fp, 422368008, 4967)
    fp = mix(fp, 577119901, 4967)
    fp = mix(fp, 171451971, 4967)
    fp = mix(fp, 862108922, 4967)
    fp = mix(fp, 815806077, 4967)
    fp = mix(fp, 655666714, 4967)
    fp = mix(fp, 69995750, 4967)
    fp = mix(fp, 380914208, 4967)
    fp = mix(fp, 15, 4967)
    fp = mix(fp, 15, 4967)
    fp = mix(fp, 0, 4967)
    fp = mix(fp, 4, 4967)
    fp = mix(fp, 0, 4967)
    fp = mix(fp, 0, 4967)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 372232202 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1217
    fp = mix(fp, instance, 4973)
    fp = mix(fp, 4, 4973)
    fp = mix(fp, 4, 4973)
    fp = mix(fp, 4, 4973)
    fp = mix(fp, 0, 4973)
    fp = mix(fp, 15, 4973)
    fp = mix(fp, 0, 4973)
    fp = mix(fp, 0, 4973)
    fp = mix(fp, ok_mask, 4973)
    fp = mix(fp, 0, 4973)
    fp = mix(fp, 0, 4973)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 372232202 { return 0 - 1 }
    if certificate != 128376272 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1223
    fp = mix(fp, instance, 4987)
    fp = mix(fp, certificate, 4987)
    fp = mix(fp, 4, 4987)
    fp = mix(fp, 5, 4987)
    fp = mix(fp, 15, 4987)
    fp = mix(fp, 0, 4987)
    fp = mix(fp, 4, 4987)
    fp = mix(fp, 0, 4987)
    fp = mix(fp, ok_mask, 4987)
    fp = mix(fp, 0, 4987)
    fp = mix(fp, 0, 4987)
    return fp
}

fn audit_fp(artifact: i64, instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if artifact != 989883403 { return 0 - 1 }
    if instance != 372232202 { return 0 - 1 }
    if certificate != 128376272 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }
    var fp: i64 = 1229
    fp = mix(fp, artifact, 4993)
    fp = mix(fp, instance, 4993)
    fp = mix(fp, certificate, 4993)
    fp = mix(fp, 422368008, 4993)
    fp = mix(fp, 171451971, 4993)
    fp = mix(fp, 815806077, 4993)
    fp = mix(fp, 69995750, 4993)
    fp = mix(fp, 5, 4993)
    fp = mix(fp, 4, 4993)
    fp = mix(fp, ok_mask, 4993)
    fp = mix(fp, 0, 4993)
    fp = mix(fp, 0, 4993)
    return fp
}

fn completed_mask() -> i64 {
    let required_mask: i64 = 15
    let provided_mask: i64 = 15
    let missing_mask: i64 = 0
    let complete_status: i64 = 4
    let validated_mask: i64 = 0
    let local_containment_proof_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0

    var ok_mask: i64 = 0
    if 422368008 > 0 {
        if 171451971 > 0 {
            if 815806077 > 0 {
                if 69995750 > 0 { ok_mask = ok_mask + 1 }
            }
        }
    }
    if 422368008 != 171451971 {
        if 815806077 != 69995750 { ok_mask = ok_mask + 2 }
    }
    if missing_mask == required_mask - provided_mask { ok_mask = ok_mask + 4 }
    if 4 == 4 {
        if 0 == 0 { ok_mask = ok_mask + 8 }
    }
    if complete_status == 4 {
        if missing_mask == 0 { ok_mask = ok_mask + 16 }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if provided_mask == required_mask {
        if provided_mask + missing_mask == required_mask { ok_mask = ok_mask + 64 }
    }
    if local_containment_proof_mask == 0 {
        if global_flowpipe_claim_mask == 0 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = completed_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 372232202 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 128376272 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 989883403 { return 4 }
    if audit_fp(art, inst, cert, ok_mask) != 754841079 { return 5 }
    if certificate_fp(inst, 254) != (0 - 1) { return 6 }
    return 0
}
