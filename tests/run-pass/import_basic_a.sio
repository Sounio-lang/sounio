//@ run-pass
// Library file for selective import test.
// Standalone: verifies imported_add arithmetic.

// Cross-module selective imports require the imported symbol to be public.
pub fn imported_add(a: i64, b: i64) -> i64 {
    a + b
}

fn main() -> i64 with Panic {
    let r1 = imported_add(3, 4)
    let r2 = imported_add(10, 0)
    let r3 = imported_add(0, 0)
    if r1 == 7 && r2 == 10 && r3 == 0 { return 0 } else { return 1 }
}
