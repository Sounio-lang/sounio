//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v112 smoke for Lorenz i256 step-3 Taylor-2 local flowpipe proof

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2063
    receipt_fp = mix(receipt_fp, 78860411, 6079)
    receipt_fp = mix(receipt_fp, 972719127, 6079)
    receipt_fp = mix(receipt_fp, 793359165, 6079)
    receipt_fp = mix(receipt_fp, 133350891, 6079)
    receipt_fp = mix(receipt_fp, 146637720, 6079)
    receipt_fp = mix(receipt_fp, 739787906, 6079)
    receipt_fp = mix(receipt_fp, 896565841, 6079)
    receipt_fp = mix(receipt_fp, 904983474, 6079)
    receipt_fp = mix(receipt_fp, 124115315, 6079)
    receipt_fp = mix(receipt_fp, 420821728, 6079)
    receipt_fp = mix(receipt_fp, 3, 6079)
    receipt_fp = mix(receipt_fp, 16, 6079)
    receipt_fp = mix(receipt_fp, 255, 6079)
    if receipt_fp != 57785761 { return 1 }

    var audit_fp: i64 = 2069
    audit_fp = mix(audit_fp, receipt_fp, 6089)
    audit_fp = mix(audit_fp, 78860411, 6089)
    audit_fp = mix(audit_fp, 972719127, 6089)
    audit_fp = mix(audit_fp, 878835307, 6089)
    audit_fp = mix(audit_fp, 671919633, 6089)
    audit_fp = mix(audit_fp, 207736416, 6089)
    audit_fp = mix(audit_fp, 314571242, 6089)
    audit_fp = mix(audit_fp, 280440446, 6089)
    audit_fp = mix(audit_fp, 300531949, 6089)
    audit_fp = mix(audit_fp, 9964953, 6089)
    audit_fp = mix(audit_fp, 847302474, 6089)
    audit_fp = mix(audit_fp, 718264441, 6089)
    audit_fp = mix(audit_fp, 47474367, 6089)
    audit_fp = mix(audit_fp, 994004460, 6089)
    audit_fp = mix(audit_fp, 792236662, 6089)
    audit_fp = mix(audit_fp, 146637720, 6089)
    audit_fp = mix(audit_fp, 3, 6089)
    audit_fp = mix(audit_fp, 16, 6089)
    audit_fp = mix(audit_fp, 255, 6089)
    if audit_fp != 640219420 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 115, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 115, 1103)
    if entry_fp != 438456816 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 112, 1151)
    manifest_fp = mix(manifest_fp, 116, 1151)
    manifest_fp = mix(manifest_fp, 133350891, 1151)
    manifest_fp = mix(manifest_fp, 793359165, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 198078664 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 112, 1871)
    result_fp = mix(result_fp, 116, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 104, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 895726535 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 112, 1907)
    family_fp = mix(family_fp, 116, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 99, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 637217802 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 112, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 18878136 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 112, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 278163265 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 112, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 48841302 { return 9 }
    return 0
}
