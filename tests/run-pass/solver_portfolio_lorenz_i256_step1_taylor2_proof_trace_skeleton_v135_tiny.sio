//@ requires: madaros
//@ description: Tiny portfolio v135 smoke for Lorenz i256 step-1 Taylor-2 proof-trace skeleton

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2281
    receipt_fp = mix(receipt_fp, 174108453, 6257)
    receipt_fp = mix(receipt_fp, 516721287, 6257)
