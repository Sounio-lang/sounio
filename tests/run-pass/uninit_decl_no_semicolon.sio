//@ run-pass
//@ expect-stdout: UNINIT_DECL_OK
// #2817: a `var` declared without an initializer. lean_single used to compile
// the NEXT statement as its initializer when there was no `;` (E200 on the
// following line, for scalars as well as arrays), and with a `;` an
// uninitialized [T; N] held a garbage pointer and SIGSEGV'd on first access.
// Both engines must now read zeros before the first write.

// A following `[V; N]` expression statement is the next statement, not the
// array's initializer: the repeat-initializer path used to run before the
// `has_eq` check and take it.
fn repeat_stmt_not_swallowed() -> i64 {
    var a: [i64; 4]
    [1; 4]
    return a[0] + a[3]
}

fn main() -> i64 with IO, Mut, Div {
    var fails: i64 = 0

    var x: i64
    var y: f64
    var b: bool
    let after: i64 = 7
    if x != 0 { fails = fails + 1 }
    if y != 0.0 { fails = fails + 1 }
    if b { fails = fails + 1 }
    if after != 7 { fails = fails + 1 }

    var f: [f64; 16]
    var g: [i64; 8];
    var c: [i8; 24]
    var s: f64 = 0.0
    var t: i64 = 0
    var i: i64 = 0
    while i < 16 { s = s + f[i]; i = i + 1 }
    i = 0
    while i < 8 { t = t + g[i]; i = i + 1 }
    i = 0
    while i < 24 { t = t + c[i] as i64; i = i + 1 }
    if s != 0.0 { fails = fails + 1 }
    if t != 0 { fails = fails + 1 }

    x = x + 5
    f[3] = f[3] + 1.5
    g[7] = 42
    if x != 5 { fails = fails + 1 }
    if f[3] != 1.5 || f[2] != 0.0 { fails = fails + 1 }
    if g[7] != 42 || g[6] != 0 { fails = fails + 1 }

    // Zero-length `[T; 0]` binds as well (it used to fall through to the scalar
    // path and be refused), without swallowing the next statement or
    // disturbing its neighbours.
    var w: i64 = 11
    var e: [i64; 0]
    let after0: i64 = 9
    if after0 != 9 || w != 11 { fails = fails + 1 }

    // `u8` elements are integers too (type_name_kind does not list u8).
    var bytes: [u8; 4]
    let after8: i64 = 8
    if after8 != 8 || bytes[0] != 0 || bytes[3] != 0 { fails = fails + 1 }
    bytes[1] = 200
    if bytes[1] != 200 || bytes[2] != 0 { fails = fails + 1 }

    if repeat_stmt_not_swallowed() != 0 { fails = fails + 1 }

    // Re-declared each iteration: zeroed every time, not just the first.
    var tot: f64 = 0.0
    var k: i64 = 0
    while k < 3 {
        var acc: [f64; 4]
        acc[k] = acc[k] + 1.5
        tot = tot + acc[0] + acc[1] + acc[2] + acc[3]
        k = k + 1
    }
    if tot != 4.5 { fails = fails + 1 }

    if fails == 0 {
        println("UNINIT_DECL_OK")
        return 0
    }
    println("UNINIT_DECL_FAIL")
    return 1
}
