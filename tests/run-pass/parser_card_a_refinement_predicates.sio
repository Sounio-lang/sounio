//@ run-pass
//@ description: Parser regression for compound refinement predicates.

fn parser_card_a_bounded(x: { n: i32 | n > 0 && n < 100 }) -> i32 {
    x
}

fn parser_card_a_nonzero(x: { n: i32 | n != 0 }) -> i32 {
    x
}

fn parser_card_a_or_bound(x: { n: i32 | n < 0 || n > 10 }) -> i32 {
    x
}

fn main() -> i32 with Panic {
    let a = parser_card_a_bounded(42)
    let b = parser_card_a_nonzero(5)
    let c = parser_card_a_or_bound(11)
    let _sum = a + b + c
    0
}
