//@ run-pass
//@ requires: madaros
//@ expect-stdout: NAMED_ITEM_MODULE_COLLISION PASS
//
// PR #2515 review round 7 (review 5301534901), finding B (comment_id
// 4091287602, self-hosted/parser/ast.sio:1506, also line 1541): the round-6
// shared `lower_named_item_terminal_known`/`_note` registry (added to
// replace the round-5 "does this name collide with any function" heuristic
// with authoritative file-resolution data) keyed its entries by the BARE
// terminal segment name only. Two different modules whose same-named
// terminal resolves differently -- one a genuine named-function import, the
// other a real module -- collided in this shared registry and poisoned each
// other: recording `tc_c` as a named-item terminal (from
// stdlib/testmod/uses_named_tc_c.sio's `use testmod::named_item_holder::tc_c;`)
// would incorrectly exclude the bare segment `tc_c` from being trusted as a
// qualifier EVERYWHERE, including in stdlib/testmod/uses_real_tc_c_module.sio,
// which legitimately imports the REAL `testmod::tc_c` module and calls
// `tc_c::tc_c_add(..)` through it.
//
// The fix (self-hosted/parser/ast.sio's new `ast_path_prefix_name`) keys the
// registry by the FULL joined path ("testmod::named_item_holder::tc_c" vs
// "testmod::tc_c") instead of the bare terminal, so the two unrelated
// same-named resolutions no longer collide. Both modules below are compiled
// together in this one program and must resolve independently and
// correctly.
use testmod::uses_named_tc_c;
use testmod::uses_real_tc_c_module;

fn main() -> i32 with IO, Mut, Panic {
    let named = uses_named_tc_c::call_named_tc_c(10)
    let real = uses_real_tc_c_module::call_real_tc_c(2, 3)
    if named == 910 && real == 105 {
        println("NAMED_ITEM_MODULE_COLLISION PASS")
        return 0
    }
    println("NAMED_ITEM_MODULE_COLLISION FAIL")
    1
}
