//@ run-pass
//@ requires: madaros
//@ description: Scalar Lorenz ball-fixed full policy-chain receipt smoke

fn quality_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 811) % 1000000007
}

fn policy_chain_fingerprint(quality_profile_fp: i64,
                            step_policy_fp: i64,
                            margin_fp: i64,
                            guard_decision_fp: i64) -> i64 {
    if quality_profile_fp != 70877465 { return 0 - 1 }
    if step_policy_fp != 231786611 { return 0 - 1 }
    if margin_fp != 494960746 { return 0 - 1 }
    if guard_decision_fp != 833881722 { return 0 - 1 }

    let stage_count: i64 = 4
    let policy_mask: i64 = 15
    let margin_mask: i64 = 15
    let action_hold_same_dt: i64 = 1
    let guard_band_hold_thin: i64 = 1
    let next_dt_num: i64 = 1
    let next_dt_den: i64 = 1

    var acc: i64 = 127
    acc = quality_mix(acc, quality_profile_fp)
    acc = quality_mix(acc, step_policy_fp)
    acc = quality_mix(acc, margin_fp)
    acc = quality_mix(acc, guard_decision_fp)
    acc = quality_mix(acc, stage_count)
    acc = quality_mix(acc, policy_mask)
    acc = quality_mix(acc, margin_mask)
    acc = quality_mix(acc, action_hold_same_dt)
    acc = quality_mix(acc, guard_band_hold_thin)
    acc = quality_mix(acc, next_dt_num)
    acc = quality_mix(acc, next_dt_den)
    return acc
}

fn main() -> i64 {
    let fp = policy_chain_fingerprint(70877465, 231786611, 494960746, 833881722)
    if fp != 21862303 { return 1 }

    if policy_chain_fingerprint(70877466, 231786611, 494960746, 833881722) != (0 - 1) { return 2 }
    if policy_chain_fingerprint(70877465, 231786612, 494960746, 833881722) != (0 - 1) { return 3 }
    if policy_chain_fingerprint(70877465, 231786611, 494960747, 833881722) != (0 - 1) { return 4 }
    if policy_chain_fingerprint(70877465, 231786611, 494960746, 833881723) != (0 - 1) { return 5 }

    return 0
}
