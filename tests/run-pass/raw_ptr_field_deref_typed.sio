//@ run-pass
//@ expect-stdout: RAW_PTR_FIELD_DEREF_OK
// `(*(*c).tab).entries[i].vis.kind`: the deref operand is a field declared
// `*mut Tab`, so it holds a payload address like a raw local. Untyped, the
// generic deref loaded word 0 of the table and every read through it was
// another object's field (check phase: a 0 Visibility handle reached
// visibility_allows_access in checker_struct_visible_inplace, gen3 ud2, #2966).
struct Vis { kind: i64, depth: i64 }
struct Info { tag: i64, vis_kind: i64, owner: i64, vis: Vis }
struct Tab { entries: [Info; 64], count: i64 }
struct Ck { pad: i64, tab: *mut Tab, cur: i64 }

fn tab_add(t: *mut Tab, info: Info) with Mut, Panic, Div {
    let idx = (*t).count
    (*t).entries[idx as usize] = info
    (*t).count = idx + 1
}

fn vis_of(v: Vis) -> i64 with Mut, Panic, Div { v.kind * 10 + v.depth }

fn visible(c: *mut Ck, i: i64) -> i64 with Mut, Panic, Div {
    let k = (*(*c).tab).entries[i as usize].vis_kind
    if k == 9 { return 0 - 1 }
    vis_of((*(*c).tab).entries[i as usize].vis) + (*(*c).tab).entries[i as usize].owner * 100
}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    let c = heap_alloc(64) as *mut Ck
    (*c).tab = heap_alloc(65536) as *mut Tab
    var i: i64 = 0
    while i < 5 {
        tab_add((*c).tab, Info { tag: 7, vis_kind: i, owner: i + 1, vis: Vis { kind: i, depth: 2 } })
        i = i + 1
    }
    var acc: i64 = 0
    i = 0
    while i < 5 {
        acc = acc + visible(c, i)
        i = i + 1
    }
    if acc == 1610 { println("RAW_PTR_FIELD_DEREF_OK") } else { println(acc) }
    return 0
}
