//@ description: Imported Lorenz i256 step-2 Taylor-2 response-envelope public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step2_taylor2_response_envelope_check(
        268229078, 223161586, 633359277, 421619310, 0, 24)
    if artifact_fp != 482555681 { return 1 }
    let audit_fp = lorenz_i256_step2_taylor2_response_envelope_audit_fingerprint(
        artifact_fp, 929244479, 168526441, 268229078, 223161586,
        633359277, 421619310, 2, 127, 24, 255)
    if audit_fp != 591288676 { return 2 }
    return 0
}
