//@ run-pass
//@ expect-stdout: BETA10_PRODUCT_CANCEL_PASS

// β¹⁰ regression: Var(a·b − a·b) must be 0 under FO sensitivity GUM.
// Pre-fix residual (2026-04-13 diagnostic): observed 0.065 for a=2±0.05, b=3±0.05.

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    // Same SSA product, then cancel (fully correlated).
    let p = a.value * b.value
    let y = p - p
    let v = variance_of(y)
    print("beta10_var_ab_minus_ab=")
    print_f64(v)
    print("\n")
    // Two separately-bound products remain a FO residual on Madaros (distinct
    // variance SSA slots); lean_single FO sens cancels those too.
    let p1 = a.value * b.value
    let p2 = a.value * b.value
    let y2 = p1 - p2
    let v2 = variance_of(y2)
    print("beta10_var_p1_minus_p2=")
    print_f64(v2)
    print("\n")
    let ok = if v < 0.0 { 0.0 - v } else { v }
    if ok < 1.0e-12 {
        print("BETA10_PRODUCT_CANCEL_PASS\n")
    } else {
        print("BETA10_PRODUCT_CANCEL_FAIL\n")
        print("expected 0 got ")
        print_f64(v)
        print("\n")
    }
}
