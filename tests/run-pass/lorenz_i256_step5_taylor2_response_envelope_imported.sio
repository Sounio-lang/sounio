//@ description: Imported Lorenz i256 step-5 Taylor-2 response-envelope smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step5_taylor2_response_envelope_check(
        693506658, 389624150, 931268564, 900912795, 0, 19)
    if artifact_fp != 422368008 { return 1 }
    let audit_fp = lorenz_i256_step5_taylor2_response_envelope_audit_fingerprint(
        artifact_fp, 805286304, 160196187, 693506658, 389624150,
        931268564, 900912795, 5, 127, 19, 255)
    if audit_fp != 577119901 { return 2 }
    return 0
}
