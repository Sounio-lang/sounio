//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v107 smoke for Lorenz i256 step-3 Taylor-2 replay executor

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1973
    receipt_fp = mix(receipt_fp, 803328296, 5939)
    receipt_fp = mix(receipt_fp, 630199225, 5939)
    receipt_fp = mix(receipt_fp, 40958745, 5939)
    receipt_fp = mix(receipt_fp, 498799906, 5939)
    receipt_fp = mix(receipt_fp, 781301126, 5939)
    receipt_fp = mix(receipt_fp, 377115992, 5939)
    receipt_fp = mix(receipt_fp, 711276818, 5939)
    receipt_fp = mix(receipt_fp, 488274627, 5939)
    receipt_fp = mix(receipt_fp, 678589210, 5939)
    receipt_fp = mix(receipt_fp, 308150621, 5939)
    receipt_fp = mix(receipt_fp, 693283321, 5939)
    receipt_fp = mix(receipt_fp, 3, 5939)
    receipt_fp = mix(receipt_fp, 8, 5939)
    receipt_fp = mix(receipt_fp, 255, 5939)
    if receipt_fp != 420916049 { return 1 }

    var audit_fp: i64 = 1979
    audit_fp = mix(audit_fp, receipt_fp, 5953)
    audit_fp = mix(audit_fp, 803328296, 5953)
    audit_fp = mix(audit_fp, 630199225, 5953)
    audit_fp = mix(audit_fp, 40958745, 5953)
    audit_fp = mix(audit_fp, 498799906, 5953)
    audit_fp = mix(audit_fp, 488274627, 5953)
    audit_fp = mix(audit_fp, 678589210, 5953)
    audit_fp = mix(audit_fp, 711276818, 5953)
    audit_fp = mix(audit_fp, 3, 5953)
    audit_fp = mix(audit_fp, 8, 5953)
    audit_fp = mix(audit_fp, 255, 5953)
    if audit_fp != 731007955 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 110, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 110, 1103)
    if entry_fp != 143039100 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 107, 1151)
    manifest_fp = mix(manifest_fp, 111, 1151)
    manifest_fp = mix(manifest_fp, 377115992, 1151)
    manifest_fp = mix(manifest_fp, 781301126, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 947882987 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 107, 1871)
    result_fp = mix(result_fp, 111, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 99, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 830436351 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 107, 1907)
    family_fp = mix(family_fp, 111, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 94, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 714791777 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 107, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 634681668 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 107, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 109328435 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 107, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 517946998 { return 9 }
    return 0
