//@ run-pass
//@ requires: madaros

linear struct Token {
    id: i64,
}

fn spend(token: Token) -> i64 {
    token.id
}

fn main() -> i32 with Panic {
    let token = Token { id: 59 }
    let selector = 1
    let prefix = match selector {
        0 => return spend(token) as i32
        _ => 0
    }
    let observed = prefix + spend(token)
    assert(observed == 59)
    0
}
