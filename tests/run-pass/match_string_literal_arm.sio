//@ run-pass
//@ expect-stdout: y
// SIO-322: a string-literal match arm must content-compare (str_eq), like
// `s == "yes"`. It used to fall to the lowerer's "unsupported pattern" skip,
// so every string scrutinee silently took the wildcard arm.

fn main() -> i32 with IO {
    let s = "yes"
    match s {
        "yes" => println("y"),
        _ => println("not y"),
    }
    return 0
}
