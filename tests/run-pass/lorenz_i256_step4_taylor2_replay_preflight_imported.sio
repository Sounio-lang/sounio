//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-4 Taylor-2 replay preflight checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step4_taylor2_replay_preflight_check(
        556038402, 389227567, 15, 15, 15, 15, 6, 0)
    if artifact_fp != 525394039 { return 1 }
    let audit_fp = lorenz_i256_step4_taylor2_replay_preflight_audit_fingerprint(
        artifact_fp, 335114620, 922120978, 556038402, 509176612, 4, 6, 255, 0, 0)
    if audit_fp != 949135313 { return 2 }
    return 0
}
