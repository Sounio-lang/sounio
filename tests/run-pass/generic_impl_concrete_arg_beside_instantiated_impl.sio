//@ run-pass
//@ requires: madaros
//@ expect-stdout: PASS generic_impl_concrete_arg_beside_instantiated_impl
// The run-time face of generic_impl_concrete_unit_beside_instantiated_impl.sio, with no
// unit in sight. A concrete impl over a plain scalar (`impl Cell<i64>`, `impl Level<f64>`)
// in the same file as an instantiated generic impl (`impl Pair<T, U>` with
// `Pair { key: 42, val: 99 }`) compiled, and then died with SIGILL on the first call of a
// method of the concrete impl.
//
// The specializer rewrote `main` and named the instance of `Cell<i64>` `Cell__i64`, so the
// call `c.twice(25)` looked for the symbol `Cell__i64_twice`; the concrete impl is not an
// instance impl and lowers as `Cell_twice`. The call reached a body-less stub (ud2). Nothing
// printed after it, and the run exited 132. `Cell` has no generic impl, so nothing needed
// its instance: only structs with a generic impl are rewritten in an ordinary fn now.

struct Cell<T> {
    v: T,
}

impl Cell<i64> {
    fn twice(self: &Cell<i64>, k: i64) -> i64 {
        k + k
    }
}

struct Level<T> {
    v: T,
}

impl Level<f64> {
    fn twice(self: &Level<f64>, k: f64) -> f64 {
        k + k
    }
}

struct Pair<T, U> {
    key: T,
    val: U,
}

impl Pair<T, U> {
    fn get_key(self: &Pair<T, U>) -> T {
        self.key
    }
}

fn main() -> i32 with IO {
    var ok: i64 = 0

    let c: Cell<i64> = Cell { v: 1 }
    let a: i64 = c.twice(25)
    if a == 50 { ok = ok + 1 }

    let l: Level<f64> = Level { v: 1.0 }
    let b: f64 = l.twice(25.0)
    if b == 50.0 { ok = ok + 1 }

    let u = Cell { v: 3 }
    let d: i64 = u.twice(4)
    if d == 8 { ok = ok + 1 }

    let p = Pair { key: 42, val: 99 }
    let k: i64 = p.get_key()
    if k == 42 { ok = ok + 1 }

    if ok == 4 {
        println("PASS generic_impl_concrete_arg_beside_instantiated_impl")
    } else {
        println("FAIL generic_impl_concrete_arg_beside_instantiated_impl")
        print_int(ok)
        println("")
    }
    0
}
