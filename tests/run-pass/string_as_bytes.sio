//@ run-pass
//@ requires: madaros
//@ expect-stdout: 13:150:92:1
// SIO-312: `.as_bytes()` on a string is the packed-byte view of the same
// storage. Before: the checker typed the result as `&i8` (E019 on
// `.len()`) and the native lowerer invented a body-less `as_bytes` whose
// stub trapped with SIGILL. The view keeps the string paths, so length
// and byte reads observe the original bytes — including for the result
// of `read_file(..)`, which the checker now types as `string`.

fn main() -> i32 with IO {
    let lit = "literal_probe".as_bytes()
    print_int(lit.len())
    print(":")
    let txt = read_file("tests/fixtures/fmri/tiny_real_motion.tsv").as_bytes()
    print_int(txt.len())
    print(":")
    let raw = read_file("tests/fixtures/fmri/tiny_real_slice_nifti1.nii")
    let bin = raw.as_bytes()
    print_int(bin[0] as i64)
    print(":")
    print_int(bin[1] as i64)
    println("")
    return 0
}
