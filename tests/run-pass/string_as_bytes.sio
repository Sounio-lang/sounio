//@ run-pass
//@ requires: madaros
//@ expect-stdout: 13:150:384:92:1
// SIO-312: `.as_bytes()` on a string yields its bytes as `[u8]`, and the
// result of `read_file(..)` — which the checker now types as `string` —
// feeds it directly. Before the read_file typing, `raw.as_bytes()` on a
// file's contents refused with E011/E019 (the prelude bound the name
// unknown, so no method resolved on its result).

fn main() -> i32 with IO {
    let lit = "literal_probe".as_bytes()
    print_int(lit.len())
    print(":")
    let txt = read_file("tests/fixtures/fmri/tiny_real_motion.tsv").as_bytes()
    print_int(txt.len())
    print(":")
    let raw = read_file("tests/fixtures/fmri/tiny_real_slice_nifti1.nii")
    let bin = raw.as_bytes()
    print_int(bin.len())
    print(":")
    print_int(bin[0] as i64)
    print(":")
    print_int(bin[1] as i64)
    println("")
    return 0
}
