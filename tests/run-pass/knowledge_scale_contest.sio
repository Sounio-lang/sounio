//@ run-pass
//@ requires: madaros
//@ expect-stdout: cr_linear 0
//@ expect-stdout: cr_log 2
//@ expect-stdout: revoked 0.641086
//@ expect-stdout: SCALE_CONTEST_OK
// Ti30V60Cr10 at 298.15 K. Log scale would return the weighted centre.
// Linear scale, fed centre*u as a Gaussian width, keeps both centres
// and returns neither. The centre does not survive the second scale.

use epistemic::claim_meet::{held_across_scales, held_centre, scale_contest, seat_code}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i64 with IO, Mut, Div {
    let ca: f64 = 0.5366204089505634
    let ua: f64 = 0.2048558862580151
    let cb: f64 = 0.6410856399193723
    let ub: f64 = 0.1653016231375161
    let scales = scale_contest(ca, ua, cb, ub)
    let log_only = seat_log(ca, ua, cb, ub)
    let alone = held_centre(log_only, ca, cb)
    let across = held_across_scales(scales, ca, cb)
    print("cr_linear ")
    print_int(scales.linear_code)
    println("")
    print("cr_log ")
    print_int(scales.log_code)
    println("")
    print("revoked ")
    print_f64(alone.centre)
    println("")
    if scales.parted && scales.linear_code == 0 && scales.log_code == 2 && alone.held && !across.held && near(alone.centre, cb, 0.000000000001) {
        println("SCALE_CONTEST_OK")
        return 0
    }
    println("SCALE_CONTEST_FAIL")
    1
}
