//@ run-pass
//@ requires: madaros
//@ expect-stdout: cr_linear 0
//@ expect-stdout: cr_log 2
//@ expect-stdout: held 1
//@ expect-stdout: mn_which 0
//@ expect-stdout: CROSS_BAND_OK
// Ti30V60Cr10 at 298.15 K. The labels disagree: linear keeps both
// centres, log keeps only the second. The overlap of the two shared
// bands still contains only the second centre.

use epistemic::claim_meet::{cross_reading, held_across_scales, scale_contest}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i64 with IO, Mut, Div {
    let cr_a: f64 = 0.5366204089505634
    let cr_ua: f64 = 0.2048558862580151
    let cr_b: f64 = 0.6410856399193723
    let cr_ub: f64 = 0.1653016231375161
    let cr = scale_contest(cr_a, cr_ua, cr_b, cr_ub)
    let cr_held = held_across_scales(cr, cr_a, cr_b)

    let mn_a: f64 = 0.17549200950646932
    let mn_ua: f64 = 0.22037007367180467
    let mn_b: f64 = 0.24743917053088313
    let mn_ub: f64 = 0.2077651422073616
    let mn = scale_contest(mn_a, mn_ua, mn_b, mn_ub)
    let mn_held = held_across_scales(mn, mn_a, mn_b)
    let mn_read = cross_reading(mn, mn_a, mn_b)

    let both_a: f64 = 0.09316824366063585
    let both_ua: f64 = 0.2764566448586745
    let both_b: f64 = 0.11123865762929737
    let both_ub: f64 = 0.2850301174739897
    let both = scale_contest(both_a, both_ua, both_b, both_ub)
    let both_held = held_across_scales(both, both_a, both_b)
    let both_read = cross_reading(both, both_a, both_b)
    let cr_read = cross_reading(cr, cr_a, cr_b)
    let mn_nan = !(mn_held.centre == mn_held.centre)
    let mn_not_zero = !(mn_held.centre == 0.0)

    var held_flag: i64 = 0
    if cr_held.held { held_flag = 1 }
    print("cr_linear ")
    print_int(cr.linear_code)
    println("")
    print("cr_log ")
    print_int(cr.log_code)
    println("")
    print("held ")
    print_int(held_flag)
    println("")
    print("lo ")
    print_f64(cr.lo)
    println("")
    print("hi ")
    print_f64(cr.hi)
    println("")
    print("mn_which ")
    print_int(mn_read.which)
    println("")
    print("mn_lo ")
    print_f64(mn_read.lo)
    println("")
    print("mn_hi ")
    print_f64(mn_read.hi)
    println("")
    if cr.parted && cr.open && cr.linear_code == 0 && cr.log_code == 2 && cr_read.which == 2 && cr_held.held && near(cr_held.centre, cr_b, 0.000000000001) && near(cr.lo, 0.5434085485562459, 0.000000000001) && near(cr.hi, 0.6586200793137378, 0.000000000001) && mn.open && mn_read.which == 0 && mn_read.open && near(mn_read.lo, 0.20101904080806268, 0.000000000001) && near(mn_read.hi, 0.21875745084503628, 0.000000000001) && !mn_held.held && mn_nan && mn_not_zero && both.open && both_read.which == 3 && !both_held.held {
        println("CROSS_BAND_OK")
        return 0
    }
    println("CROSS_BAND_FAIL")
    1
}
