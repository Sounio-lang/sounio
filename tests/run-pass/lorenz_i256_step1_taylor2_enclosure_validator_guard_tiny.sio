//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 Taylor-2 enclosure validator guard preserves non-claim masks

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1381
    fp = mix(fp, 1, 5171)
    fp = mix(fp, 815221512, 5171)
    fp = mix(fp, 981617998, 5171)
    fp = mix(fp, 620127047, 5171)
    fp = mix(fp, 133154696, 5171)
    fp = mix(fp, 265853299, 5171)
    fp = mix(fp, 1000000, 5171)
    fp = mix(fp, 27000, 5171)
    fp = mix(fp, 296000, 5171)
    fp = mix(fp, 21000, 5171)
    fp = mix(fp, 1, 5171)
    fp = mix(fp, 260001, 5171)
    fp = mix(fp, 16667, 5171)
    fp = mix(fp, 26877, 5171)
    fp = mix(fp, 35700, 5171)
    fp = mix(fp, 3902, 5171)
    fp = mix(fp, 7, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 8, 5171)
    fp = mix(fp, 0, 5171)
    fp = mix(fp, 0, 5171)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 741550055 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1399
    fp = mix(fp, instance, 5179)
    fp = mix(fp, 26878, 5179)
    fp = mix(fp, 295701, 5179)
    fp = mix(fp, 20569, 5179)
    fp = mix(fp, 27000, 5179)
    fp = mix(fp, 296000, 5179)
    fp = mix(fp, 21000, 5179)
    fp = mix(fp, 7, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 8, 5179)
    fp = mix(fp, ok_mask, 5179)
    fp = mix(fp, 0, 5179)
    fp = mix(fp, 0, 5179)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 741550055 { return 0 - 1 }
    if certificate != 156734502 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1409
    fp = mix(fp, instance, 5189)
    fp = mix(fp, certificate, 5189)
    fp = mix(fp, 9, 5189)
    fp = mix(fp, 1, 5189)
    fp = mix(fp, 7, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 8, 5189)
    fp = mix(fp, ok_mask, 5189)
    fp = mix(fp, 0, 5189)
    fp = mix(fp, 0, 5189)
    return fp
}

fn enclosure_guard_mask() -> i64 {
    let x_need_ppm: i64 = 26878
    let y_need_ppm: i64 = 295701
    let z_need_ppm: i64 = 20569
    let x_margin_ppm: i64 = 27000
    let y_margin_ppm: i64 = 296000
    let z_margin_ppm: i64 = 21000
    let validated_mask: i64 = 0
    let local_containment_mask: i64 = 0
    let global_flowpipe_mask: i64 = 0

    var pass_mask: i64 = 0
    if x_need_ppm <= x_margin_ppm { pass_mask = pass_mask + 1 }
    if y_need_ppm <= y_margin_ppm { pass_mask = pass_mask + 2 }
    if z_need_ppm <= z_margin_ppm { pass_mask = pass_mask + 4 }

    var ok_mask: i64 = 0
    if 815221512 > 0 {
        if 620127047 > 0 { ok_mask = ok_mask + 1 }
    }
    if x_need_ppm == 1 + 26877 {
        if y_need_ppm == 260001 + 35700 {
            if z_need_ppm == 16667 + 3902 { ok_mask = ok_mask + 2 }
        }
    }
    if pass_mask == 7 { ok_mask = ok_mask + 4 }
    if validated_mask == 0 { ok_mask = ok_mask + 8 }
    if x_margin_ppm - x_need_ppm == 122 {
        if y_margin_ppm - y_need_ppm == 299 {
            if z_margin_ppm - z_need_ppm == 431 { ok_mask = ok_mask + 16 }
        }
    }
    if validated_mask == 0 { ok_mask = ok_mask + 32 }
    if local_containment_mask == 0 { ok_mask = ok_mask + 64 }
    if global_flowpipe_mask == 0 { ok_mask = ok_mask + 128 }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = enclosure_guard_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 741550055 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 156734502 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 737436919 { return 4 }
    if artifact_fp(inst, cert, 254) != (0 - 1) { return 5 }
    return 0
}
