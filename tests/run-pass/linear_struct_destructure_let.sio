//@ run-pass
//@ requires: madaros
//@ expect-stdout: LINEAR_DESTRUCTURE_OK
//@ description: destructuring a linear struct consumes it once, not once per field (#2766)
//
// `let Qubit { alpha_re, beta_re } = q` desugars to `let __tupN = q` plus one
// `let f = __tupN.f` per field. Madaros tracked the compiler temp as linear and
// reported the second field read as E039 "linear value has already been used".

linear struct Qubit { alpha_re: f64, beta_re: f64 }
linear struct Triple { x: i64, y: i64, z: i64 }

fn measure_z(q: Qubit) -> i64 {
    let Qubit { alpha_re, beta_re } = q
    if alpha_re * alpha_re >= beta_re * beta_re { 0 } else { 1 }
}

fn sum3(t: Triple) -> i64 {
    let Triple { x, y, z } = t
    x + y + z
}

fn main() -> i32 with IO {
    var bad = 0
    let m1 = measure_z(Qubit { alpha_re: 0.6, beta_re: 0.8 })
    if m1 != 1 { bad = bad + 1 }
    let m0 = measure_z(Qubit { alpha_re: 0.8, beta_re: 0.6 })
    if m0 != 0 { bad = bad + 1 }
    let s3 = sum3(Triple { x: 1, y: 2, z: 3 })
    if s3 != 6 { bad = bad + 1 }
    if bad != 0 {
        print("linear destructure violations: ")
        println(bad)
        return 1
    }
    println("LINEAR_DESTRUCTURE_OK")
    0
}
