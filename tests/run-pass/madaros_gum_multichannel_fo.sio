//@ run-pass
//@ expect-stdout: MADAROS_GUM_MULTICHANNEL_FO_PASS

// Madaros multi-channel FO GUM (lean_single β¹⁰/β¹¹ parity target):
//   Var(y) = Σ_k (∂y/∂x_k)² · σ²_k
//
// Closes residuals that scalar-variance algebra cannot:
//   R2 p1−p2 cancel for separately-bound identical products
//   R3 (a*b)*a partial correlation → a²b form
//   R7 ac−bc shared-factor correlation
//   R8 a*(a*b) right-assoc partial correlation

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    let c: Knowledge<f64> = measure(4.0, uncertainty: 0.05)
    let av = a.value
    let bv = b.value
    let cv = c.value

    // R1 independent product
    let v_ab = variance_of(av * bv)
    // R2 p1−p2 cancel
    let p1 = av * bv
    let p2 = av * bv
    let v_pp = variance_of(p1 - p2)
    // R3 partial correlation (a*b)*a = a²b
    // truth: 4 a² b² Va + a⁴ Vb = 0.40
    let v_aba = variance_of((av * bv) * av)
    let v_aab = variance_of((av * av) * bv)
    // R4 three-way independent
    let v_abc = variance_of((av * bv) * cv)
    // R5 (a+b)*c
    let v_sumprod = variance_of((av + bv) * cv)
    // R7 ac − bc = (a−b)c
    // truth: c²Va + c²Vb + (a−b)²Vc = 0.0825
    let q1 = av * cv
    let q2 = bv * cv
    let v_qdiff = variance_of(q1 - q2)
    // R8 a*(a*b)
    let v_xxy = variance_of(av * (av * bv))

    print("R1="); print_f64(v_ab); print("\n")
    print("R2="); print_f64(v_pp); print("\n")
    print("R3_aba="); print_f64(v_aba); print("\n")
    print("R3_aab="); print_f64(v_aab); print("\n")
    print("R4="); print_f64(v_abc); print("\n")
    print("R5="); print_f64(v_sumprod); print("\n")
    print("R7="); print_f64(v_qdiff); print("\n")
    print("R8="); print_f64(v_xxy); print("\n")

    let ok = abs_f(v_ab - 0.0325) < 1.0e-9
        && abs_f(v_pp) < 1.0e-9
        && abs_f(v_aba - 0.40) < 1.0e-9
        && abs_f(v_aab - 0.40) < 1.0e-9
        && abs_f(v_abc - 0.61) < 1.0e-9
        && abs_f(v_sumprod - 0.1425) < 1.0e-9
        && abs_f(v_qdiff - 0.0825) < 1.0e-9
        && abs_f(v_xxy - 0.40) < 1.0e-9
    if ok {
        print("MADAROS_GUM_MULTICHANNEL_FO_PASS\n")
    } else {
        print("MADAROS_GUM_MULTICHANNEL_FO_FAIL\n")
    }
}
