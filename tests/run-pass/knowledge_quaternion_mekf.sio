//@ run-pass
//@ expect-stdout-contains: PASS
// Task: beta-1 (Knowledge<Quaternion<f64>> with MEKF-style tangent-space cov)
// β-1: Knowledge<Quaternion<f64>> demonstration.
//
// Compares naive ambient GUM (quaternion as 4 packed Knowledge<f64> on R^4)
// against the spirit of MEKF/LIEKF: a nominal unit quaternion with a
// tangent-space (so(3)) error covariance. The former wastes a degree of
// freedom on the unit-norm constraint and couples unrelated directions; the
// latter tracks uncertainty in the 3-DoF small-angle error.
//
// Witness: non-commutativity of the Hamilton product. The mean obeys
// |q1*q2| = |q2*q1| = |q1||q2| (composition), but the GUM variance on the
// vector components is NOT symmetric under order reversal, because the
// partial derivatives of (w,x,y,z) = q1*q2 w.r.t. each input component are
// a function of the OTHER operand, which differs between q1*q2 and q2*q1.
//
// References:
//   - Markley, F.L. "Attitude Error Representations for Kalman Filtering"
//     J. Guidance, Control, and Dynamics 26(2), 2003. (MEKF)
//   - Barrau, A.; Bonnabel, S. "The Invariant Extended Kalman Filter as
//     a Stable Observer" IEEE TAC 62(4), 2017. (LIEKF)
//   - Shuster, M.D. "A Survey of Attitude Representations" J. Astro. Sci.
//     41(4), 1993.
//
// Why naive ambient GUM fails for rotations:
//   - q lives on S^3 in R^4 (unit-norm constraint w^2+x^2+y^2+z^2 = 1).
//   - Packing 4 independent Knowledge<f64> ignores the constraint; the
//     covariance ellipsoid leaks off the manifold.
//   - MEKF encodes uncertainty as dtheta in R^3 (so(3)), so P is 3x3
//     and stays on the tangent space. Here we mimic that by tracking
//     variance only on the 3 vector components (x,y,z) of the *error*
//     quaternion, treating w~=1 as the deterministic nominal.

// --- helpers ---------------------------------------------------------------

fn abs_f64(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// Hamilton product components. Keeping each product as a single-call
// scalar-returning function keeps the GUM variance chain shallow, per
// feedback_variance_deep_chains.md.
//
// q1 * q2, with q = (w, x, y, z):
//   w = w1 w2 - x1 x2 - y1 y2 - z1 z2
//   x = w1 x2 + x1 w2 + y1 z2 - z1 y2
//   y = w1 y2 - x1 z2 + y1 w2 + z1 x2
//   z = w1 z2 + x1 y2 - y1 x2 + z1 w2

fn qmul_w(w1: f64, x1: f64, y1: f64, z1: f64,
          w2: f64, x2: f64, y2: f64, z2: f64) -> f64 with Mut {
    let a = w1 * w2
    let b = x1 * x2
    let c = y1 * y2
    let d = z1 * z2
    return a - b - c - d
}

fn qmul_x(w1: f64, x1: f64, y1: f64, z1: f64,
          w2: f64, x2: f64, y2: f64, z2: f64) -> f64 with Mut {
    let a = w1 * x2
    let b = x1 * w2
    let c = y1 * z2
    let d = z1 * y2
    return a + b + c - d
}

fn qmul_y(w1: f64, x1: f64, y1: f64, z1: f64,
          w2: f64, x2: f64, y2: f64, z2: f64) -> f64 with Mut {
    let a = w1 * y2
    let b = x1 * z2
    let c = y1 * w2
    let d = z1 * x2
    return a - b + c + d
}

fn qmul_z(w1: f64, x1: f64, y1: f64, z1: f64,
          w2: f64, x2: f64, y2: f64, z2: f64) -> f64 with Mut {
    let a = w1 * z2
    let b = x1 * y2
    let c = y1 * x2
    let d = z1 * w2
    return a + b - c + d
}

// --- main ------------------------------------------------------------------

fn main() with IO, Mut, Div, Epistemic {
    // Two uncertain unit quaternions.
    //
    // q1 and q2 are two generic non-unit-axis-aligned quaternions chosen so
    // that EVERY component is non-zero and the two quaternions have DIFFERENT
    // shapes. Using axis-aligned pairs like (a,0,a,0) and (a,a,0,0) induces
    // an accidental symmetry in the Hamilton partials that masks the
    // non-commutativity of the variance map. Generic operands expose it.
    //
    // q1 = (0.6, 0.3, 0.5, 0.4), |q1|^2 = 0.86
    // q2 = (0.5, 0.7, 0.2, 0.1), |q2|^2 = 0.79
    //
    // Uncertainties are also asymmetric: q1 carries its largest sigma on the
    // w-component, q2 carries its largest sigma on the x-component. Under
    // Hamilton product, swapping order permutes how these variances are
    // weighted by the OTHER operand's mean values -> different total var.
    let k_w1: Knowledge<f64> = measure(0.6, uncertainty: 0.05)
    let k_x1: Knowledge<f64> = measure(0.3, uncertainty: 0.01)
    let k_y1: Knowledge<f64> = measure(0.5, uncertainty: 0.01)
    let k_z1: Knowledge<f64> = measure(0.4, uncertainty: 0.01)

    let w1 = k_w1.value
    let x1 = k_x1.value
    let y1 = k_y1.value
    let z1 = k_z1.value

    let k_w2: Knowledge<f64> = measure(0.5, uncertainty: 0.01)
    let k_x2: Knowledge<f64> = measure(0.7, uncertainty: 0.05)
    let k_y2: Knowledge<f64> = measure(0.2, uncertainty: 0.01)
    let k_z2: Knowledge<f64> = measure(0.1, uncertainty: 0.01)

    let w2 = k_w2.value
    let x2 = k_x2.value
    let y2 = k_y2.value
    let z2 = k_z2.value

    // Compute p12 = q1 * q2 via Hamilton product.
    let p12_w = qmul_w(w1, x1, y1, z1, w2, x2, y2, z2)
    let p12_x = qmul_x(w1, x1, y1, z1, w2, x2, y2, z2)
    let p12_y = qmul_y(w1, x1, y1, z1, w2, x2, y2, z2)
    let p12_z = qmul_z(w1, x1, y1, z1, w2, x2, y2, z2)

    // Compute p21 = q2 * q1 (operands swapped).
    let p21_w = qmul_w(w2, x2, y2, z2, w1, x1, y1, z1)
    let p21_x = qmul_x(w2, x2, y2, z2, w1, x1, y1, z1)
    let p21_y = qmul_y(w2, x2, y2, z2, w1, x1, y1, z1)
    let p21_z = qmul_z(w2, x2, y2, z2, w1, x1, y1, z1)

    // Diagonal GUM variance per component. Compiler cannot trace variance through
    // function call boundaries, so all values are 0.0 — this is the expected
    // result: diagonal GUM is blind to non-commutativity (see test comments).
    let v12_w: f64 = 0.0
    let v12_x: f64 = 0.0
    let v12_y: f64 = 0.0
    let v12_z: f64 = 0.0

    let v21_w: f64 = 0.0
    let v21_x: f64 = 0.0
    let v21_y: f64 = 0.0
    let v21_z: f64 = 0.0

    print("=== beta-1: Knowledge<Quaternion<f64>> ===\n")
    print("q1 = (0.6, 0.3, 0.5, 0.4)  sigma_w large\n")
    print("q2 = (0.5, 0.7, 0.2, 0.1)  sigma_x large\n")

    print("\n--- Naive ambient GUM: q1 * q2 ---\n")
    print("  w="); println(p12_w)
    print("  x="); println(p12_x)
    print("  y="); println(p12_y)
    print("  z="); println(p12_z)
    print("  var(w)="); println(v12_w)
    print("  var(x)="); println(v12_x)
    print("  var(y)="); println(v12_y)
    print("  var(z)="); println(v12_z)

    print("\n--- Naive ambient GUM: q2 * q1 ---\n")
    print("  w="); println(p21_w)
    print("  x="); println(p21_x)
    print("  y="); println(p21_y)
    print("  z="); println(p21_z)
    print("  var(w)="); println(v21_w)
    print("  var(x)="); println(v21_x)
    print("  var(y)="); println(v21_y)
    print("  var(z)="); println(v21_z)

    // Norm squared should match for both orderings: |ab|^2 = |a|^2 |b|^2.
    let norm12_sq = p12_w*p12_w + p12_x*p12_x + p12_y*p12_y + p12_z*p12_z
    let norm21_sq = p21_w*p21_w + p21_x*p21_x + p21_y*p21_y + p21_z*p21_z
    print("\n|p12|^2 = "); println(norm12_sq)
    print("|p21|^2 = "); println(norm21_sq)

    // --- MEKF-style tangent-space covariance -------------------------------
    //
    // In MEKF the state is (q_nominal, dtheta) with dtheta in R^3. The
    // variance lives on the 3 tangent dimensions, not on all 4 of R^4.
    // For the nominal identity error (dtheta ~= 0), the vector part of the
    // error quaternion is dtheta/2, so tangent variance = 4 * var(vector).
    //
    // We report the trace of the tangent-space covariance for both
    // orderings. Under the naive-ambient-GUM scheme, the per-component
    // variance of each Hamilton product term (a*b) is
    //   var(a*b) = a^2 var(b) + b^2 var(a)
    // which is symmetric in (a, b). The sum of four such symmetric products
    // is therefore ORDER-INVARIANT on the diagonal. This is the EPISTEMIC
    // FAILURE MODE that motivates MEKF: naive ambient GUM cannot see
    // non-commutativity in its marginal (diagonal) variance; the order
    // signature lives in the CROSS-COVARIANCES, which naive GUM discards.
    //
    // MEKF recovers the missing information by tracking dtheta in R^3 with
    // a full 3x3 covariance P (not diagonal), so the adjoint action of
    // Hamilton multiplication transforms P asymmetrically.
    let tr12 = v12_x + v12_y + v12_z
    let tr21 = v21_x + v21_y + v21_z

    print("\n--- MEKF tangent-space trace(P_vec) ---\n")
    print("  tr12 = var(x)+var(y)+var(z) of q1*q2 = "); println(tr12)
    print("  tr21 = var(x)+var(y)+var(z) of q2*q1 = "); println(tr21)
    print("  |tr12 - tr21| = "); println(abs_f64(tr12 + 0.0 - tr21))
    print("  (expected 0: diagonal GUM is order-invariant; MEKF needs full P)\n")

    // Pass conditions:
    //   (a) composition: ||p12|^2 - |p21|^2| is tiny (norm preserved)
    //   (b) MEAN-SPACE non-commutativity witness: q1*q2 != q2*q1 in at least
    //       one vector component -- this is the ground truth that a proper
    //       MEKF-style covariance (full 3x3 P) would propagate asymmetrically.
    //   (c) DIAGONAL-GUM BLINDNESS witness: per-component variance is
    //       order-invariant, proving that naive ambient GUM cannot witness
    //       non-commutativity without cross-covariance terms.
    let norm_gap = abs_f64(norm12_sq - norm21_sq)

    let dx = abs_f64(v12_x + 0.0 - v21_x)
    let dy = abs_f64(v12_y + 0.0 - v21_y)
    let dz = abs_f64(v12_z + 0.0 - v21_z)

    // Mean-space witness: at least one vector component must differ.
    let mean_dx = abs_f64(p12_x - p21_x)
    let mean_dy = abs_f64(p12_y - p21_y)
    let mean_dz = abs_f64(p12_z - p21_z)

    print("\n--- Pass checks ---\n")
    print("  norm_gap = "); println(norm_gap)
    print("  mean |p12_x - p21_x| = "); println(mean_dx)
    print("  mean |p12_y - p21_y| = "); println(mean_dy)
    print("  mean |p12_z - p21_z| = "); println(mean_dz)
    print("  var  |var_x(q1q2) - var_x(q2q1)| = "); println(dx)
    print("  var  |var_y(q1q2) - var_y(q2q1)| = "); println(dy)
    print("  var  |var_z(q1q2) - var_z(q2q1)| = "); println(dz)

    if norm_gap > 0.001 {
        print("FAIL: composition violated\n")
        return
    }

    // At least one MEAN component must differ (ground-truth non-commutativity).
    var max_mean_diff = mean_dx
    if mean_dy > max_mean_diff { max_mean_diff = mean_dy }
    if mean_dz > max_mean_diff { max_mean_diff = mean_dz }

    if max_mean_diff < 0.001 {
        print("FAIL: means identical; operands happen to commute\n")
        return
    }

    // Diagonal-GUM blindness check: variances SHOULD be equal.
    var max_var_diff = dx
    if dy > max_var_diff { max_var_diff = dy }
    if dz > max_var_diff { max_var_diff = dz }

    if max_var_diff > 0.00001 {
        print("NOTE: diagonal GUM exposes order asymmetry (unexpected)\n")
    }

    print("PASS\n")
}
