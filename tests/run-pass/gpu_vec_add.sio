//@ run-pass
//@ expect-stdout: PASS: GPU vec_add

// Keep this checked-artifact smoke on the narrow kernel ABI path. The
// out-of-place 3-buffer form is covered by GPU launch/golden lanes; this suite
// fixture stays in-place so the default native runner proves runtime behavior
// without tripping the wider slice-argument lowering boundary.
kernel fn vec_add_in_place(n: i64, a: &![f64], b: &[f64]) with GPU {
    let tid = gpu_thread_id_x()
    if tid < n {
        a[tid as usize] = a[tid as usize] + b[tid as usize]
    }
}

fn main() -> i32 with IO, Mut, Panic, GPU {
    var a: [f64; 1024] = [0.0; 1024]
    var b: [f64; 1024] = [0.0; 1024]

    var i: i64 = 0
    while i < 1024 {
        a[i as usize] = i as f64
        b[i as usize] = (i as f64) * 2.0
        i = i + 1
    }

    vec_add_in_place(1024, &!a, &b)

    if a[0] < 0.01 && a[1] > 2.99 && a[1] < 3.01 && a[1023] > 3068.0 {
        println("PASS: GPU vec_add")
    } else {
        println("FAIL: GPU vec_add")
    }
    0
}
