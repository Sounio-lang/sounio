//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-2 Taylor-2 replay preflight checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step2_taylor2_replay_preflight_check(
        976546207, 725374434, 15, 15, 15, 15, 6, 0)
    if artifact_fp != 939672637 { return 1 }
    let audit_fp = lorenz_i256_step2_taylor2_replay_preflight_audit_fingerprint(
        artifact_fp, 688535068, 118139253, 976546207, 892326627, 2, 6, 255, 0, 0)
    if audit_fp != 69896373 { return 2 }
    return 0
}
