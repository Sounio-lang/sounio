//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v143 smoke for Lorenz i256 step-1-to-step-2 local-flowpipe bridge

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt: i64 = 2081
    receipt = mix(receipt, 595466240, 6091)
    receipt = mix(receipt, 382059454, 6091)
    receipt = mix(receipt, 394497389, 6091)
    receipt = mix(receipt, 976586199, 6091)
    receipt = mix(receipt, 97103871, 6091)
    receipt = mix(receipt, 120130225, 6091)
    receipt = mix(receipt, 824834880, 6091)
    receipt = mix(receipt, 262282451, 6091)
    receipt = mix(receipt, 335080767, 6091)
    receipt = mix(receipt, 899209716, 6091)
    receipt = mix(receipt, 1, 6091)
    receipt = mix(receipt, 2, 6091)
    receipt = mix(receipt, 17, 6091)
    receipt = mix(receipt, 255, 6091)
    if receipt != 881374690 { return 1 }

    var audit: i64 = 2083
    audit = mix(audit, receipt, 6101)
    audit = mix(audit, 595466240, 6101)
    audit = mix(audit, 382059454, 6101)
    audit = mix(audit, 989878921, 6101)
    audit = mix(audit, 995615032, 6101)
    audit = mix(audit, 824834880, 6101)
    audit = mix(audit, 262282451, 6101)
    audit = mix(audit, 97103871, 6101)
    audit = mix(audit, 335080767, 6101)
    audit = mix(audit, 899209716, 6101)
    audit = mix(audit, 1, 6101)
    audit = mix(audit, 2, 6101)
    audit = mix(audit, 17, 6101)
    audit = mix(audit, 255, 6101)
    if audit != 145539674 { return 2 }

    var entry: i64 = 101
    entry = mix(entry, 146, 1103)
    entry = mix(entry, receipt, 1103)
    entry = mix(entry, audit, 1103)
    entry = mix(entry, 1, 1103)
    entry = mix(entry, 146, 1103)
    if entry != 961360409 { return 3 }

    var manifest: i64 = 107
    manifest = mix(manifest, 143, 1151)
    manifest = mix(manifest, 147, 1151)
    manifest = mix(manifest, 976586199, 1151)
    manifest = mix(manifest, 394497389, 1151)
    manifest = mix(manifest, entry, 1151)
    if manifest != 183919651 { return 4 }

    var result: i64 = 131
    result = mix(result, 143, 1871)
    result = mix(result, 147, 1871)
    result = mix(result, 10, 1871)
    result = mix(result, 135, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, 1, 1871)
    result = mix(result, manifest, 1871)
    if result != 735153429 { return 5 }

    var family: i64 = 149
    family = mix(family, 143, 1907)
    family = mix(family, 147, 1907)
    family = mix(family, 6, 1907)
    family = mix(family, 4, 1907)
    family = mix(family, 3, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, 130, 1907)
    family = mix(family, 2, 1907)
    family = mix(family, manifest, 1907)
    if family != 990886920 { return 6 }

    var acceptance: i64 = 137
    acceptance = mix(acceptance, 143, 1889)
    acceptance = mix(acceptance, manifest, 1889)
    acceptance = mix(acceptance, result, 1889)
    if acceptance != 751938858 { return 7 }

    var audit_receipt: i64 = 157
    audit_receipt = mix(audit_receipt, 143, 1931)
    audit_receipt = mix(audit_receipt, manifest, 1931)
    audit_receipt = mix(audit_receipt, result, 1931)
    audit_receipt = mix(audit_receipt, family, 1931)
    audit_receipt = mix(audit_receipt, acceptance, 1931)
    if audit_receipt != 619775358 { return 8 }

    var readiness: i64 = 163
    readiness = mix(readiness, 143, 1951)
    readiness = mix(readiness, 31, 1951)
    readiness = mix(readiness, manifest, 1951)
    readiness = mix(readiness, result, 1951)
    readiness = mix(readiness, family, 1951)
    readiness = mix(readiness, acceptance, 1951)
    readiness = mix(readiness, audit_receipt, 1951)
    if readiness != 659832949 { return 9 }
    return 0
}
