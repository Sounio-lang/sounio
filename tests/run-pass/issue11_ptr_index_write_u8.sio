//@ run-pass
//@ contract-adjustment: canonical lane uses by-value array updates to avoid stale nested mutable-borrow pattern
// Issue #11: indexed writes to integer array (u8 semantics via i64).
// Rewritten to avoid raw pointer ops unsupported by lean_single.

fn write_elem(arr: [i64; 8], idx: i64, value: i64) -> [i64; 8] with Mut, Panic {
    var out = arr
    out[idx] = value
    out
}

fn main() -> i64 with Panic, Mut {
    var arr: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    arr = write_elem(arr, 0, 1)
    arr = write_elem(arr, 1, 2)
    arr = write_elem(arr, 2, 3)
    arr = write_elem(arr, 3, 4)
    let total = arr[0] + arr[1] + arr[2] + arr[3]
    if total == 10 { return 0 } else { return 1 }
}
