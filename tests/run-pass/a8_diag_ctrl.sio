//@ run-pass
// Cross-module controls: scalar return and small-struct return.

use testmod::sret_min::{Small, imported_scalar, small_basis}

fn main() -> i64 with IO, Mut, Panic {
    println("CTRL_start")
    let y = imported_scalar(41)
    print_int(y)
    print("\n")
    println("CTRL_after_scalar")
    let s = small_basis(4, 1)
    println("CTRL_after_small_basis")
    print_int(s.c[1])
    print("\n")
    print_int(s.bits as i64)
    print("\n")
    println("CTRL_done")
    return 0
}
