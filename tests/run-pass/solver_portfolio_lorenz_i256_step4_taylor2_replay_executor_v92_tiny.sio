//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v92 smoke for Lorenz i256 step-4 Taylor-2 replay executor

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1973
    receipt_fp = mix(receipt_fp, 563122161, 5939)
    receipt_fp = mix(receipt_fp, 308331037, 5939)
    receipt_fp = mix(receipt_fp, 968648040, 5939)
    receipt_fp = mix(receipt_fp, 611792998, 5939)
    receipt_fp = mix(receipt_fp, 666793345, 5939)
    receipt_fp = mix(receipt_fp, 271084941, 5939)
    receipt_fp = mix(receipt_fp, 387466576, 5939)
    receipt_fp = mix(receipt_fp, 525394039, 5939)
    receipt_fp = mix(receipt_fp, 949135313, 5939)
    receipt_fp = mix(receipt_fp, 556038402, 5939)
    receipt_fp = mix(receipt_fp, 389227567, 5939)
    receipt_fp = mix(receipt_fp, 4, 5939)
    receipt_fp = mix(receipt_fp, 8, 5939)
    receipt_fp = mix(receipt_fp, 255, 5939)
    if receipt_fp != 143267578 { return 1 }

    var audit_fp: i64 = 1979
    audit_fp = mix(audit_fp, receipt_fp, 5953)
    audit_fp = mix(audit_fp, 563122161, 5953)
    audit_fp = mix(audit_fp, 308331037, 5953)
    audit_fp = mix(audit_fp, 968648040, 5953)
    audit_fp = mix(audit_fp, 611792998, 5953)
    audit_fp = mix(audit_fp, 525394039, 5953)
    audit_fp = mix(audit_fp, 949135313, 5953)
    audit_fp = mix(audit_fp, 387466576, 5953)
    audit_fp = mix(audit_fp, 4, 5953)
    audit_fp = mix(audit_fp, 8, 5953)
    audit_fp = mix(audit_fp, 255, 5953)
    if audit_fp != 89119858 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 95, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 95, 1103)
    if entry_fp != 722635913 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 92, 1151)
    manifest_fp = mix(manifest_fp, 96, 1151)
    manifest_fp = mix(manifest_fp, 271084941, 1151)
    manifest_fp = mix(manifest_fp, 666793345, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 164137752 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 92, 1871)
    result_fp = mix(result_fp, 96, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 84, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 601407616 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 92, 1907)
    family_fp = mix(family_fp, 96, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 79, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 914355519 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 92, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 91721995 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 92, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 507235414 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 92, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
