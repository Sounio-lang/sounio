//@ run-pass
//@ requires: lean_single
//@ expect-stdout-contains: OPS: PASS
//@ description: ADR-015 row 9 (probes op_lt_neg, op_lt_neg_sp, op_plus_neg_sp, op_bool_and_not) -- `<-` has no use of its own, so `x<-1` is `x < -1`; `a + -2` and `a&&!b` are unaffected.

fn main() with IO {
    var ok: i64 = 1
    let x: i64 = -5
    if x<-1 { } else { ok = 0 }
    if x < -1 { } else { ok = 0 }
    let a: i64 = 5
    if a + -2 != 3 { ok = 0 }
    let p = true
    let q = false
    if p&&!q { } else { ok = 0 }
    if ok == 1 { print("OPS: PASS\n") } else { print("OPS: FAIL\n") }
}
