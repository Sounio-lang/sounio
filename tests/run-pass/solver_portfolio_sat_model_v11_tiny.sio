//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v11 smoke for SAT model-witness entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn portfolio_entry_fingerprint(kind: i64, instance_fp: i64, certificate_fp: i64,
                               result_code: i64, checker_code: i64) -> i64 with Mod {
    if kind != 15 { return 0 - 1 }
    if instance_fp != 620950027 { return 0 - 1 }
    if certificate_fp != 701650234 { return 0 - 1 }
    if result_code != 3 { return 0 - 1 }
    if checker_code != 15 { return 0 - 1 }

    var fp: i64 = 101
    fp = mix(fp, kind, 1103)
    fp = mix(fp, instance_fp, 1103)
    fp = mix(fp, certificate_fp, 1103)
    fp = mix(fp, result_code, 1103)
    fp = mix(fp, checker_code, 1103)
    return fp
}

fn portfolio_v11_fingerprint(sat_model_entry_fp: i64) -> i64 with Mod {
    if sat_model_entry_fp != 838301653 { return 0 - 1 }

    var fp: i64 = 107
    fp = mix(fp, 11, 1151)
    fp = mix(fp, 15, 1151)
    fp = mix(fp, 53646245, 1151)
    fp = mix(fp, 528026990, 1151)
    fp = mix(fp, 301444501, 1151)
    fp = mix(fp, 258927862, 1151)
    fp = mix(fp, 388915166, 1151)
    fp = mix(fp, 900589789, 1151)
    fp = mix(fp, 205040674, 1151)
    fp = mix(fp, 580031260, 1151)
    fp = mix(fp, 973127057, 1151)
    fp = mix(fp, 438043475, 1151)
    fp = mix(fp, 887056435, 1151)
    fp = mix(fp, 769531137, 1151)
    fp = mix(fp, 579271506, 1151)
    fp = mix(fp, 252932879, 1151)
    fp = mix(fp, sat_model_entry_fp, 1151)
    return fp
}

fn main() -> i64 {
    let entry_fp = portfolio_entry_fingerprint(15, 620950027, 701650234, 3, 15)
    let manifest_fp = portfolio_v11_fingerprint(entry_fp)

    if entry_fp != 838301653 { return 1 }
    if manifest_fp != 210925933 { return 2 }
    if portfolio_entry_fingerprint(15, 620950027, 701650234, 0, 15) != (0 - 1) { return 3 }
    if portfolio_entry_fingerprint(15, 620950027, 701650235, 3, 15) != (0 - 1) { return 4 }
    if portfolio_v11_fingerprint(entry_fp + 1) != (0 - 1) { return 5 }
    return 0
}
