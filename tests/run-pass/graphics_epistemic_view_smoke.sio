//@ run-pass

use graphics::epistemic::{
    EpistemicGlyphSpec,
    add_glyph,
    new_epistemic_curve,
    provenance_kind_measured
}
use graphics::surface::{surface_new}
use graphics::view::{show_width, render_epistemic_kind_strip, show_epistemic, show_epistemic_lens}

fn main() -> i64 with IO, Mut, Panic, Div {
    let s = surface_new(4, 4)
    show_width(&s, 4)

    var kinds: [i64; 8] = [0; 8]
    var shapes: [i64; 8] = [0; 8]
    kinds[0] = 0
    shapes[0] = 0
    kinds[1] = 1
    shapes[1] = 0
    kinds[2] = 2
    shapes[2] = 1
    kinds[3] = 3
    shapes[3] = 2

    render_epistemic_kind_strip(&kinds, &shapes, 4)

    let xs: [f64; 256] = [0.0; 256]
    let ys: [f64; 256] = [0.0; 256]
    let conf: [f64; 256] = [1.0; 256]
    let fig0 = new_epistemic_curve(xs, ys, conf, 1)
    let spec = EpistemicGlyphSpec {
        data_index: 0,
        kind: provenance_kind_measured(),
        offset_x: 1,
        offset_y: 0,
    }
    let fig = add_glyph(fig0, spec)
    show_epistemic(&fig)

    // Exercise the unique Sounio epistemic instrument
    show_epistemic_lens(&fig)

    print("PASS graphics_epistemic_view_smoke\n")
    0
}
