//@ run-pass
//@ expect-stdout: LIE01D_IV_ADD_PASS
// lie corpus item 1d: outward rounding in verify::interval.
// [0.1,0.1]+[0.2,0.2] in round-to-nearest is the single point
// 0.30000000000000004, which EXCLUDES the true sum 0.3. The old code
// returned exactly that point (and tagged it IV_DERIVED). The enclosure
// must contain 0.3 and be strictly wider than round-to-nearest.
// (External struct fields are private — E259 — so this test uses only
// the public predicates; field-level pins live in the module self-test.)

use verify::interval::{iv_add, iv_sub, iv_mul, iv_div, interval,
    interval_from_measurement, iv_contains, iv_width, iv_is_empty}

fn main() -> i64 with IO, Mut, Panic, Div {
    var fails: i64 = 0

    // The headline case: true sum 0.3 must be inside.
    // (Old code: the point 0.30000000000000004, which excludes 0.3.)
    let a = interval(0.1, 0.1)
    let b = interval(0.2, 0.2)
    let s = iv_add(a, b)
    if !iv_contains(s, 0.3) { fails = fails + 1 }
    // Strictly wider than round-to-nearest (the push happened):
    // the old point interval has width exactly 0.
    if !(iv_width(s) > 0.0) { fails = fails + 1 }

    // Subtraction: [1,3]-[2,5] = [-4,1], widened past the exact ends.
    // (Old code: exactly [-4,1], width exactly 5.0.)
    let d = iv_sub(interval(1.0, 3.0), interval(2.0, 5.0))
    if !iv_contains(d, 0.0 - 4.0) { fails = fails + 1 }
    if !iv_contains(d, 1.0) { fails = fails + 1 }
    if !(iv_width(d) > 5.0) { fails = fails + 1 }

    // Multiplication: [0.1,0.1]*[0.1,0.1] is 0.010000000000000002 in
    // round-to-nearest, which excludes the true product 0.01.
    let m = iv_mul(interval(0.1, 0.1), interval(0.1, 0.1))
    if !iv_contains(m, 0.01) { fails = fails + 1 }
    if !(iv_width(m) > 0.0) { fails = fails + 1 }

    // Division stays ILL on zero divisor.
    let z = iv_div(interval(1.0, 2.0), interval(0.0 - 1.0, 1.0))
    if !iv_is_empty(z) { fails = fails + 1 }

    // Measurement constructor pushes its computed endpoints too:
    // 10.0 - 1.0 is exactly 9.0 in f64, so an unpushed width-2.0
    // interval is the lie; the pushed one is strictly wider.
    let mm = interval_from_measurement(10.0, 1.0)
    if !iv_contains(mm, 9.0) { fails = fails + 1 }
    if !iv_contains(mm, 11.0) { fails = fails + 1 }
    if !(iv_width(mm) > 2.0) { fails = fails + 1 }

    if fails == 0 {
        println("LIE01D_IV_ADD_PASS")
    } else {
        println("LIE01D_IV_ADD_FAIL")
    }
    return fails
}
