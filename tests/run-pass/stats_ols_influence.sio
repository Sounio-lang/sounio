//@ run-pass
//@ expect-stdout: OLS_QR_REFERENCE_PASS
use stats::regression::ols::{ols_fit_simple,ols_influence_simple}
fn near(a:f64,b:f64,unit:f64) -> bool with Div { let d=if a>b {a-b}else{b-a} d/unit < 2.0e-8 }
fn case_0() with IO, Mut, Div, Panic {
