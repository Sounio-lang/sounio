//@ run-pass
//@ requires: lean_single
//@ expect-stdout: deep stores ok
//@ description: Three assignment shapes had no lean_single handler and lost their store without a diagnostic: `(*c).a.b.c = v` (three field hops), `s.a.b.c = v` through a pointer root, and `(*(*lo).f).g = v`. The previous seed printed `0 0 0 (stores dropped)` here. Madaros's own source uses all three (24 sites in check/mod.sio, ir/lower.sio, hlir/lower.sio), so the Madaros a seed built was missing those writes.

struct Prof { is_el: bool, n: i64 }
struct Kern { classes: Prof, count: i64 }
struct Chk { kern: Kern, tag: i64 }
struct Fn { abi: i64, is_kernel: bool }
struct Bld { func: Fn }
struct St { builder: Bld }
struct Tbl { count: i64, entries: [i64; 4] }
struct Lw { t: &!Tbl }

fn set_deref(c: &!Chk) with Mut {
    (*c).kern.classes.n = 41
    (*c).kern.classes.n = (*c).kern.classes.n + 1
    (*c).kern.classes.is_el = true
}
fn set_ident(s: &!St) with Mut {
    s.builder.func.abi = 7
    s.builder.func.is_kernel = true
}
fn set_inner(lo: &!Lw) with Mut {
    (*(*lo).t).count = 3
    (*(*lo).t).entries[2] = 9
}
fn main() with IO, Mut {
    var c = Chk { kern: Kern { classes: Prof { is_el: false, n: 0 }, count: 0 }, tag: 0 }
    set_deref(&!c)
    var s = St { builder: Bld { func: Fn { abi: 0, is_kernel: false } } }
    set_ident(&!s)
    var t = Tbl { count: 0, entries: [0; 4] }
    var lo = Lw { t: &!t }
    set_inner(&!lo)
    if c.kern.classes.n == 42 && c.kern.classes.is_el && s.builder.func.abi == 7 && s.builder.func.is_kernel && t.count == 3 && t.entries[2] == 9 {
        println("deep stores ok")
    } else {
        print_int(c.kern.classes.n)
        print(" ")
        print_int(s.builder.func.abi)
        print(" ")
        print_int(t.count)
        println(" (stores dropped)")
    }
}
