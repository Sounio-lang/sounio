//@ run-pass
//@ expect-stdout: MATH_TRANS_VALUES_OK
//@ requires: madaros
// Value tests for tan, atan, atan2, asin, acos, tanh and ln (f64) on Madaros.
//
// Expected bit patterns are the correctly rounded binary64 of a __float128
// (libquadmath) evaluation of each function at the same argument; generated by
// scripts/dev/gen_math_trans_tests.cpp (g++ -std=c++23 gen_math_trans_tests.cpp -lquadmath), not typed. Generic points allow 3 ulp
// (measured maxima over 40000-point grids: atan 0.83, atan2 1.15, asin 2.02,
// acos 1.63, tan 2.38, tanh 2.16, ln 2.75). Special values (+-0, +-inf, NaN,
// results that are exactly 0 or +-1) must match BIT FOR BIT, including the sign of zero.

fn is_nan_bits(b: i64) -> bool { let a = b & 0x7FFFFFFFFFFFFFFF
    a > 0x7FF0000000000000 }

fn chk(id: i64, got: f64, want_bits: i64, tol: i64) -> bool with IO, Mut, Panic, Div {
    let gb = f64_to_bits(got)
    var good = false
    if is_nan_bits(want_bits) { good = is_nan_bits(gb) }
    else if is_nan_bits(gb) { good = false }
    else if gb == want_bits { good = true }
    else if tol == 0 { good = false }
    else if (gb ^ want_bits) < 0 { good = false }
    else {
        var d = gb - want_bits
        if d < 0 { d = 0 - d }
        good = d <= tol
    }
    if !good {
        print("MISMATCH id=")
        print_int(id)
        print(" got=")
        print_int(gb)
        print(" want=")
        print_int(want_bits)
        print("\n")
    }
    good
}

fn main() -> i64 with IO, Mut, Panic, Div {
    var ok = true
    ok = chk(1, atan(bits_to_f64(4602678819172646912)), 4602023952714414927, 3) && ok
