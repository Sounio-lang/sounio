//@ run-pass
//@ expect-stdout: STATS_NORMALITY_UNITS_PASS
use stats::normality::{normality}
fn abs(x:f64)->f64 {if x<0.0{return -x} return x}
fn main() with IO,Mut,Div,Panic {
 var x:[f64;256]=[0.0;256]
 x[0]=2.0;x[1]=4.0;x[2]=4.0;x[3]=4.0;x[4]=5.0;x[5]=5.0;x[6]=7.0;x[7]=9.0
 var tiny:[f64;256]=[0.0;256]
 var huge:[f64;256]=[0.0;256]
 var i=0
 while i<8 {tiny[i as usize]=x[i as usize]*1.0e-200;huge[i as usize]=x[i as usize]*1.0e200;i=i+1}
 let a=normality(&x,8)
 let b=normality(&tiny,8)
 assert(abs(a.p-b.p)<1.0e-12)
 let c=normality(&huge,8)
 assert(abs(a.jb-c.jb)<1.0e-12)
 assert(abs(a.skewness-b.skewness)<1.0e-12)
 println("STATS_NORMALITY_UNITS_PASS")
 0
}
