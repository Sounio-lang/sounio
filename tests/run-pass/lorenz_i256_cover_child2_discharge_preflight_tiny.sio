//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-2 discharge preflight receipt

fn child2_discharge_preflight_check(
    child2_validation_core_fp: i64,
    child2_validation_core_audit_fp: i64,
    child1_discharge_preflight_fp: i64,
    child1_discharge_preflight_audit_fp: i64,
    child_index: i64,
    child_validated_mask: i64,
    global_flowpipe_claim_mask: i64,
    discharge_status: i64) -> i64 {
    if child2_validation_core_fp != 173471211 { return 0 - 1 }
    if child2_validation_core_audit_fp != 173431050 { return 0 - 1 }
    if child1_discharge_preflight_fp != 719480263 { return 0 - 1 }
    if child1_discharge_preflight_audit_fp != 602184970 { return 0 - 1 }
    if child_index != 2 { return 0 - 1 }
    if child_validated_mask != 7 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if discharge_status != 67 { return 0 - 1 }
    return 865117026
}

fn main() -> i64 {
    let artifact = child2_discharge_preflight_check(
        173471211, 173431050, 719480263, 602184970, 2, 7, 0, 67)
    if artifact != 865117026 { return 1 }

    let audit_fp: i64 = 22656757
    let instance_fp: i64 = 362446006
    let certificate_fp: i64 = 449775673
    let child_validated_mask: i64 = 7
    let pending_child_validation_mask: i64 = 24
    let remaining_child_validation_mask: i64 = 24
    let child_validation_dependency_mask: i64 = 63
    let child2_validation_receipt_mask: i64 = 31
    let child2_discharge_preflight_mask: i64 = 4
    let discharge_blocker_mask: i64 = 15
    let missing_child_validation_mask: i64 = 24
    let pending_child_discharge_mask: i64 = 255
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let finite_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let discharge_status: i64 = 67
    let ok_mask: i64 = 255

    if audit_fp != 22656757 { return 2 }
    if instance_fp != 362446006 { return 3 }
    if certificate_fp != 449775673 { return 4 }
    if child_validated_mask != 7 { return 5 }
    if pending_child_validation_mask != 24 { return 6 }
    if remaining_child_validation_mask != 24 { return 7 }
    if child_validation_dependency_mask != 63 { return 8 }
    if child2_validation_receipt_mask != 31 { return 9 }
    if child2_discharge_preflight_mask != 4 { return 10 }
    if discharge_blocker_mask != 15 { return 11 }
    if missing_child_validation_mask != 24 { return 12 }
    if pending_child_discharge_mask != 255 { return 13 }
    if child_discharge_mask != 0 { return 14 }
    if global_cover_certificate_mask != 0 { return 15 }
    if finite_cover_certificate_mask != 0 { return 16 }
    if global_flowpipe_claim_mask != 0 { return 17 }
    if discharge_status != 67 { return 18 }
    if ok_mask != 255 { return 19 }

    let wrong_child = child2_discharge_preflight_check(
        173471211, 173431050, 719480263, 602184970, 1, 7, 0, 67)
    if wrong_child != 0 - 1 { return 20 }

    let overclaim = child2_discharge_preflight_check(
        173471211, 173431050, 719480263, 602184970, 2, 7, 1, 67)
    if overclaim != 0 - 1 { return 21 }

    let incomplete_validation = child2_discharge_preflight_check(
        173471211, 173431050, 719480263, 602184970, 2, 3, 0, 67)
    if incomplete_validation != 0 - 1 { return 22 }

    return 0
}
