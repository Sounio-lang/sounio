//@ run-pass
//@ requires: madaros
//@ expect-stdout: 45:45:45:7
// SIO-582: a borrow of a LOCAL struct (`let hh = &!w`) yields a slot
// address holding a GC handle, not a payload address. Struct locals are
// boxed, so the raw payload path read garbage (ASLR-varying). The
// raw-deref classifier must decline borrow-handle locals (direct,
// through casts, and through aliases) to the handle-resolving path.
struct W {
    val: i64,
}
fn via_alias() -> i64 with Mut {
    var w: W
    w.val = 45
    let hh = &!w
    let p = hh as *mut W
    (*p).val
}
fn via_cast() -> i64 with Mut {
    var w: W
    w.val = 45
    let hh = &!w
    (*((hh as i64) as *mut W)).val
}
fn via_realias() -> i64 with Mut {
    var w: W
    w.val = 45
    let hh = &!w
    let h2 = hh
    let p = h2 as *mut W
    (*p).val
}
fn via_store() -> i64 with Mut {
    var w: W
    w.val = 45
    let hh = &!w
    let p = hh as *mut W
    (*p).val = 7
    w.val
}
fn main() -> i64 with IO, Mut {
    print_int(via_alias())
    print(":")
    print_int(via_cast())
    print(":")
    print_int(via_realias())
    print(":")
    print_int(via_store())
    println("")
    return 0
}
