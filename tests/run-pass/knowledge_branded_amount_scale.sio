//@ run-pass
//@ requires: madaros
//@ expect-stdout: BRANDED_AMOUNT_SCALE_OK
// The GUM amount transfer is generic over ontology brands. Nothing here is
// named H2: a measured carrier enters a function, its branded amount is
// scaled by module constants, and the caller receives the propagated variance.

ontology Cell {
    class Substance { property amount: f64 where amount >= 0.0 }
    class FuelCarrier subclass_of Substance
    class ProductWater subclass_of Substance
    disjoint FuelCarrier, ProductWater
}

var CHARGE: f64 = 2.0
var VOLTAGE: f64 = 0.65

fn electrical_work(feed: Knowledge<FuelCarrier>) -> f64 with Epistemic, Mut, Div {
    let amount: f64 = feed.value
    amount * CHARGE * VOLTAGE
}

fn product_amount(product: Knowledge<ProductWater>) -> f64 with Epistemic, Mut, Div {
    product.value
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let carrier: FuelCarrier = 10.0
    let fuel: Knowledge<FuelCarrier> = measure(carrier, uncertainty: 0.1)
    let work = electrical_work(fuel)
    let expected_work_var = (0.1 * CHARGE * VOLTAGE) * (0.1 * CHARGE * VOLTAGE)

    let product: ProductWater = 10.0
    let water: Knowledge<ProductWater> = measure(product, uncertainty: 0.1)
    let water_amount = product_amount(water)
    let expected_amount_var = 0.1 * 0.1

    print("work ")
    print_f64(work)
    print(" var ")
    print_f64(variance_of(work))
    print(" water_var ")
    print_f64(variance_of(water_amount))
    print("\n")

    if near(work, 13.0, 0.0001) && near(variance_of(work), expected_work_var, 0.0001) && near(water_amount, 10.0, 0.0001) && near(variance_of(water_amount), expected_amount_var, 0.0001) {
        println("BRANDED_AMOUNT_SCALE_OK")
        return 0
    }
    println("BRANDED_AMOUNT_SCALE_FAIL")
    1
}
