//@ run-pass
//@ description: V0-E.1 — wide_float limb API + hex wire print (inlined; no cross-module)
//@ ladder-stage: V0-E
//@ semantic-lane: WS-G-V0E-STDLIB-GUM-SURFACE
//@ stdlib-mirror: stdlib/math/wide_float.sio
//
// Inlined mirror of wide_float.sio — Madaros still hits import/codegen walls
// on some stdlib cross-module shapes (same class as bignat #637 workaround).
// Gate also asserts stdlib/math/wide_float.sio exists as the API source of truth.
// Language f128 + remains E004.
// Gate: scripts/ci/madaros_f128_f256_ladder_gate.sh --stage v0e

struct F128Bits {
    lo: i64,
    hi: i64,
}

struct F256Bits {
    l0: i64,
    l1: i64,
    l2: i64,
    l3: i64,
}

fn f128_bits_zero() -> F128Bits {
    F128Bits { lo: 0, hi: 0 }
}

fn f128_bits_one() -> F128Bits {
    F128Bits { lo: 0, hi: 4611404543450677248 }
}

fn f128_bits_two() -> F128Bits {
    F128Bits { lo: 0, hi: 4611686018427387904 }
}

fn f128_bits_half() -> F128Bits {
    F128Bits { lo: 0, hi: 4611123068473966592 }
}

fn f128_bits_neg_one() -> F128Bits {
    F128Bits { lo: 0, hi: -4611967493404098560 }
}

fn f256_bits_one() -> F256Bits {
    F256Bits { l0: 0, l1: 0, l2: 0, l3: 4611668426241343488 }
}

fn f128_bits_eq(a: F128Bits, b: F128Bits) -> bool {
    a.lo == b.lo && a.hi == b.hi
}

fn f256_bits_eq(a: F256Bits, b: F256Bits) -> bool {
    a.l0 == b.l0 && a.l1 == b.l1 && a.l2 == b.l2 && a.l3 == b.l3
}

fn print_hex_nibble(n: i64) with IO {
    if n == 0 { print("0"); return }
    if n == 1 { print("1"); return }
    if n == 2 { print("2"); return }
    if n == 3 { print("3"); return }
    if n == 4 { print("4"); return }
    if n == 5 { print("5"); return }
    if n == 6 { print("6"); return }
    if n == 7 { print("7"); return }
    if n == 8 { print("8"); return }
    if n == 9 { print("9"); return }
    if n == 10 { print("a"); return }
    if n == 11 { print("b"); return }
    if n == 12 { print("c"); return }
    if n == 13 { print("d"); return }
    if n == 14 { print("e"); return }
    print("f")
}

fn print_u32_hex8(u: i64) with IO, Mut, Panic, Div {
    var shift: i64 = 28
    var i: i64 = 0
    while i < 8 {
        let nibble = (u >> shift) & 15
        print_hex_nibble(nibble)
        shift = shift - 4
        i = i + 1
    }
}

fn print_limb_hex16(limb: i64) with IO, Mut, Panic, Div {
    let mask: i64 = 4294967295
    let hi32 = (limb >> 32) & mask
    let lo32 = limb & mask
    print_u32_hex8(hi32)
    print_u32_hex8(lo32)
}

fn print_f128_bits_hex_wire(x: F128Bits) with IO, Mut, Panic, Div {
    print_limb_hex16(x.lo)
    print(":")
    print_limb_hex16(x.hi)
}

fn print_f256_bits_hex_wire(x: F256Bits) with IO, Mut, Panic, Div {
    print_limb_hex16(x.l0)
    print(":")
    print_limb_hex16(x.l1)
    print(":")
    print_limb_hex16(x.l2)
    print(":")
    print_limb_hex16(x.l3)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let z = f128_bits_zero()
    let one = f128_bits_one()
    let two = f128_bits_two()
    let half = f128_bits_half()
    let neg = f128_bits_neg_one()
    let one256 = f256_bits_one()

    if !f128_bits_eq(z, f128_bits_zero()) {
        println("FAIL wide_float zero")
        return 1
    }
    if one.lo != 0 || one.hi != 4611404543450677248 {
        println("FAIL wide_float one limbs")
        return 1
    }
    if two.hi != 4611686018427387904 {
        println("FAIL wide_float two limbs")
        return 1
    }
    if half.hi != 4611123068473966592 {
        println("FAIL wide_float half limbs")
        return 1
    }
    if neg.hi != -4611967493404098560 {
        println("FAIL wide_float neg_one limbs")
        return 1
    }
    if !f256_bits_eq(one256, f256_bits_one()) {
        println("FAIL wide_float f256 one")
        return 1
    }

    print("wire_one=")
    print_f128_bits_hex_wire(one)
    println("")
    print("wire_neg=")
    print_f128_bits_hex_wire(neg)
    println("")
    print("wire_f256_one=")
    print_f256_bits_hex_wire(one256)
    println("")

    println("PASS f128_v0e_stdlib_smoke limbs=exact hex_wire=printed surface=wide_float.sio")
    return 0
}
