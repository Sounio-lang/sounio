//@ run-pass
//@ expect-stdout: refinement: PASS
//@ ignore

// A refinement type constrains values — satisfied literal passes check
type Positive = { x: i64 | x > 0 }

fn main() -> i32 with IO, Mut, Panic, Div {
    let p: Positive = 42    // 42 > 0 — OK
    if p > 0 {
        print("refinement: PASS\n")
    }
    return 0
}
