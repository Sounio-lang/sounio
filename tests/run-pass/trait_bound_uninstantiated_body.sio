//@ run-pass
//@ requires: madaros
//@ expect-stdout: TRAIT_BOUND_UNINSTANTIATED_OK

// A generic function whose body calls a method of its trait bound is checked
// against the bound even when nothing instantiates it. Here no call site
// exists at all, so the specializer has nothing to clone and the body reaches
// the checker as written: the method must resolve through `T: Lj` (it used
// to fail E011, "no method named ... for this type").
trait Lj { fn lj(self) -> f64 }
struct NaCl { pub z: i64 }
impl Lj for NaCl { fn lj(self) -> f64 { 0.300512 } }

fn eps_of<T: Lj>(p: T) -> f64 { p.lj() }

fn main() -> i32 with IO {
    print("TRAIT_BOUND_UNINSTANTIATED_OK\n")
    return 0
}
