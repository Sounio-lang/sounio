//@ run-pass
//@ description: Tiny portfolio v61 smoke for Lorenz i256 step-6 repaired projection inclusion validator entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 683
    receipt_fp = mix(receipt_fp, 316597079, 4219)
    receipt_fp = mix(receipt_fp, 476878195, 4219)
    receipt_fp = mix(receipt_fp, 299367418, 4219)
    receipt_fp = mix(receipt_fp, 795358725, 4219)
    receipt_fp = mix(receipt_fp, 16326305, 4219)
    receipt_fp = mix(receipt_fp, 6, 4219)
    receipt_fp = mix(receipt_fp, 11, 4219)
    receipt_fp = mix(receipt_fp, 255, 4219)
    if receipt_fp != 258280637 { return 1 }

    var audit_fp: i64 = 691
