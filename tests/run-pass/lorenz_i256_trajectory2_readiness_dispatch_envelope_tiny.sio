//@ run-pass
//@ description: Self-contained Lorenz i256 bounded trajectory readiness dispatch envelope smoke (status 121)

fn main() -> i64 {
    let dispatch_mask: i64 = 63
    let envelope_fp: i64 = 9387383
    let dispatch_query_receipt: i64 = 9371853
    let dispatch_artifact_fp: i64 = 682914503
    let acceptance_mask: i64 = 31
    let acceptance_readiness_fp: i64 = 9371853
    let checker_family_id: i64 = 73
    let checker_kind_id: i64 = 118
    if dispatch_mask != 63 { return 1 }
    if envelope_fp != 9387383 { return 2 }
    if dispatch_query_receipt != 9371853 { return 3 }
    if dispatch_artifact_fp != 682914503 { return 4 }
    if acceptance_mask != 31 { return 5 }
    if acceptance_readiness_fp != 9371853 { return 6 }
    if checker_family_id != 73 { return 7 }
    if checker_kind_id != 118 { return 8 }

    let target_integer_width: i64 = 256
    let limb_base: i64 = 1000000000
    let native_i256_evidence_mask: i64 = 0
    let imported_runtime_evidence_mask: i64 = 0
    let public_claim_mask: i64 = 0
    let formal_theorem_ready: i64 = 0
    let bridge_status: i64 = 121
    if target_integer_width != 256 { return 9 }
    if limb_base != 1000000000 { return 10 }
    if native_i256_evidence_mask != 0 { return 11 }
    if imported_runtime_evidence_mask != 0 { return 12 }
    if public_claim_mask != 0 { return 13 }
    if formal_theorem_ready != 0 { return 14 }
    if bridge_status != 121 { return 15 }

    let recomputed_envelope_fp: i64 =
        (acceptance_readiness_fp
            + (29 * dispatch_mask)
            + (31 * acceptance_mask)
            + (37 * checker_family_id)
            + (41 * checker_kind_id)
            + (43 * bridge_status)) % limb_base
    if recomputed_envelope_fp != 9387383 { return 16 }
    return 0
}
