//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256-to-ball-fixed precision bridge smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 with Mod {
    let instance_fp = lorenz_i256_ball_fixed_bridge_instance_fingerprint(
        32, 4294967296, 1000000, 214180161,
        5309941770, 10058731223, 4084837935)
    if instance_fp != 149359034 { return 1 }

    let certificate_fp = lorenz_i256_ball_fixed_bridge_certificate_fingerprint(
        instance_fp, 890086395, 607091799, 114244647, 166945519, 7)
    if certificate_fp != 138609006 { return 2 }

    let audit_fp = lorenz_i256_ball_fixed_bridge_audit_fingerprint(
        instance_fp, certificate_fp, 326517892, 291678314, 413118064, 31)
    if audit_fp != 488107916 { return 3 }

    if lorenz_i256_ball_fixed_bridge_certificate_fingerprint(
        instance_fp, 890086395, 607091800, 114244647, 166945519, 7) != (0 - 1) { return 4 }
    if lorenz_i256_ball_fixed_bridge_audit_fingerprint(
        instance_fp, certificate_fp, 326517892, 291678314, 413118065, 31) != (0 - 1) { return 5 }

    return 0
}
