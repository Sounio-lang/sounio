//@ run-pass
//@ requires: madaros
//@ expect-stdout: TUPLE_F64_ARRAY_FROM_IF_AND_MATCH PASS
//
// Copilot review (PR #2516), finding 2 on the fifth review round:
// expr_result_tuple_arr_mask_ref (the tuple-slot array-mask classifier,
// extended across earlier rounds for ExprCall/ExprMethodCall/ExprTupleLit)
// returned 0 for every ExprIf and ExprMatch, so
// `let (a, b) = if cond { pair1() } else { pair2() }` (and the `match`
// equivalent) lost the array-slot mask entirely and `a[0]` fell back to
// the integer conversion path, even though both branches return the exact
// same `([f64; N], [f64; N])` tuple type (guaranteed by typecheck).
//
// This exercises destructuring straight off an if-expression AND a
// match-expression, each choosing between two functions that both return a
// tuple of two f64 arrays.
fn pair1() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 1.5
    b[0] = 0.25
    (a, b)
}

fn pair2() -> ([f64; 2], [f64; 2]) with Mut, Panic {
    var a: [f64; 2] = [0.0; 2]
    var b: [f64; 2] = [0.0; 2]
    a[0] = 4.5
    b[0] = 0.75
    (a, b)
}

fn main() -> i32 with IO, Mut, Panic {
    let big = true
    let (oa, ob) = if big { pair1() } else { pair2() }
    let s0: f64 = oa[0] * 2.0
    let s1: f64 = 2.0 * ob[0]

    let mode: i64 = 1
    let (ma, mb) = match mode {
        0 => pair1(),
        _ => pair2(),
    }
    let s2: f64 = ma[0] * 2.0
    let s3: f64 = 2.0 * mb[0]

    if s0 == 3.0 && s1 == 0.5 && s2 == 9.0 && s3 == 1.5 {
        println("TUPLE_F64_ARRAY_FROM_IF_AND_MATCH PASS")
        return 0
    }
    1
}
