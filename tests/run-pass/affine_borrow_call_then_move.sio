//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

fn inspect(permit: &Permit) -> i64 {
    permit.id
}

fn spend(permit: Permit) -> i64 {
    permit.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 19 }
    assert(inspect(&permit) == 19)
    assert(spend(permit) == 19)
    0
}
