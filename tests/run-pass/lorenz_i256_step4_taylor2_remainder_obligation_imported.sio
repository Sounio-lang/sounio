//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-4 Taylor-2 remainder obligation smoke

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step4_taylor2_remainder_obligation_check(
        40000, 55000, 10000, 0)
    if artifact_fp != 700260810 { return 1 }
    let audit_fp = lorenz_i256_step4_taylor2_remainder_obligation_audit_fingerprint(
        artifact_fp, 408418036, 166672715, 575348777, 450696904,
        749342117, 4, 5, 127, 0, 0)
    if audit_fp != 747893368 { return 2 }
    return 0
}
