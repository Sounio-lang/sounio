//@ run-pass
//@ requires: madaros
//@ expect-stdout: r-origin silence: PASS
//
// R-ORIGIN must be SILENT where it does not apply. `measure(...)` genuinely
// obtains a value, so ascribing Measured to it is a true claim and must not be
// refused. If this file ever fails, the rule has grown from "arithmetic may not
// claim an origin" into "nothing may claim an origin", which is the opposite of
// the point.

fn main() -> i64 with IO {
    let a: Knowledge[f64, Measured] = measure(1.0, uncertainty: 0.1)
    println("r-origin silence: PASS")
    0
}
