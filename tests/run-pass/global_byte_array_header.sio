//@ run-pass
//@ expect-stdout: GLOBAL_BYTE_ARRAY_HEADER_OK
// #2966 (gen3 SIGSEGV in write_file writing the 160 MB NC_BIG_ELF): a
// `[i8; N]` global is packed in BSS, but a callee receiving it by reference and
// the write_file / str_from_bytes copy loops tell packed from word arrays by
// the descriptor word at V - header -- for a global, the tail of the previous
// global. They read every 8th byte: 0 and an empty string here, and the 160 MB
// ELF buffer ran off the end of BSS. Packed byte globals now carry a real
// header, and a global buffer reaches the builtins as an object base. A word
// global next to them is unchanged.
var PAD: [i64; 4] = [0; 4]
var BIG: [i8; 64] = [0; 64]
var UB: [u8; 16] = [0; 16]
var WORDS: [i64; 3] = [0; 3]

fn second(b: &[i8; 64]) -> i64 {
    (*b)[1] as i64
}

fn third_u(b: &[u8; 16]) -> i64 {
    (*b)[2] as i64
}

fn main() -> i32 with IO, Mut, Panic, Div {
    BIG[0] = 65 as i8
    BIG[1] = 66 as i8
    UB[2] = 200 as u8
    WORDS[1] = 7
    PAD[3] = 1
    let a = second(&BIG)
    let c = third_u(&UB)
    let s = str_from_bytes(BIG, 2)
    if a == 66 && c == 200 && str_eq(s, "AB") && WORDS[1] == 7 && PAD[3] == 1 {
        println("GLOBAL_BYTE_ARRAY_HEADER_OK")
        return 0
    }
    print("GLOBAL_BYTE_ARRAY_HEADER_FAIL ")
    print_int(a)
    print(" ")
    print_int(c)
    println("")
    return 1
}
