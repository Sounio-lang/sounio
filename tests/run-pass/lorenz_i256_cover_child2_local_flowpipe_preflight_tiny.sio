//@ run-pass
//@ description: Self-contained Lorenz i256 cover child-2 local-flowpipe preflight receipt

fn child2_local_flowpipe_preflight_check(
    child2_obligation_seed_fp: i64,
    child2_obligation_seed_audit_fp: i64,
    child1_discharge_preflight_fp: i64,
    child1_discharge_preflight_audit_fp: i64,
    five_step_local_flowpipe_chain_fp: i64,
    five_step_local_flowpipe_chain_audit_fp: i64,
    child_index: i64,
    slot_x: i64,
    slot_y: i64,
    slot_z: i64,
    global_flowpipe_claim_mask: i64,
    preflight_status: i64) -> i64 {
    if child2_obligation_seed_fp != 844216507 { return 0 - 1 }
    if child2_obligation_seed_audit_fp != 781563019 { return 0 - 1 }
    if child1_discharge_preflight_fp != 719480263 { return 0 - 1 }
    if child1_discharge_preflight_audit_fp != 602184970 { return 0 - 1 }
    if five_step_local_flowpipe_chain_fp != 911209450 { return 0 - 1 }
    if five_step_local_flowpipe_chain_audit_fp != 709377850 { return 0 - 1 }
    if child_index != 2 { return 0 - 1 }
    if slot_x != 0 { return 0 - 1 }
    if slot_y != 1 { return 0 - 1 }
    if slot_z != 0 { return 0 - 1 }
    if global_flowpipe_claim_mask != 0 { return 0 - 1 }
    if preflight_status != 65 { return 0 - 1 }
    return 312780944
}

fn main() -> i64 {
    let artifact = child2_local_flowpipe_preflight_check(
        844216507, 781563019, 719480263, 602184970, 911209450, 709377850,
        2, 0, 1, 0, 0, 65)
    if artifact != 312780944 { return 1 }

    let audit_fp: i64 = 542916038
    let instance_fp: i64 = 586307202
    let certificate_fp: i64 = 103884775
    let selected_child_mask: i64 = 4
    let prior_child_validated_mask: i64 = 3
    let pending_child_validation_mask: i64 = 28
    let local_flowpipe_preflight_mask: i64 = 31
    let proof_dependency_mask: i64 = 31
    let available_local_chain_mask: i64 = 31
    let pending_local_proof_mask: i64 = 31
    let local_flowpipe_proof_mask: i64 = 0
    let child_validated_mask: i64 = 0
    let child_discharge_mask: i64 = 0
    let global_cover_certificate_mask: i64 = 0
    let global_flowpipe_claim_mask: i64 = 0
    let preflight_status: i64 = 65
    let ok_mask: i64 = 255

    if audit_fp != 542916038 { return 2 }
    if instance_fp != 586307202 { return 3 }
    if certificate_fp != 103884775 { return 4 }
    if selected_child_mask != 4 { return 5 }
    if prior_child_validated_mask != 3 { return 6 }
    if pending_child_validation_mask != 28 { return 7 }
    if local_flowpipe_preflight_mask != 31 { return 8 }
    if proof_dependency_mask != 31 { return 9 }
    if available_local_chain_mask != 31 { return 10 }
    if pending_local_proof_mask != 31 { return 11 }
    if local_flowpipe_proof_mask != 0 { return 12 }
    if child_validated_mask != 0 { return 13 }
    if child_discharge_mask != 0 { return 14 }
    if global_cover_certificate_mask != 0 { return 15 }
    if global_flowpipe_claim_mask != 0 { return 16 }
    if preflight_status != 65 { return 17 }
    if ok_mask != 255 { return 18 }

    let wrong_slot = child2_local_flowpipe_preflight_check(
        844216507, 781563019, 719480263, 602184970, 911209450, 709377850,
        2, 1, 0, 0, 0, 65)
    if wrong_slot != 0 - 1 { return 19 }

    let wrong_chain = child2_local_flowpipe_preflight_check(
        844216507, 781563019, 719480263, 602184970, 1, 709377850,
        2, 0, 1, 0, 0, 65)
    if wrong_chain != 0 - 1 { return 20 }

    let overclaim = child2_local_flowpipe_preflight_check(
        844216507, 781563019, 719480263, 602184970, 911209450, 709377850,
        2, 0, 1, 0, 1, 65)
    if overclaim != 0 - 1 { return 21 }

    return 0
}
