//@ run-pass
//@ expect-stdout: CAST_I8_OK
// #2966 (gen3 SIGSEGV on `mov %rax, 0x0(%rip)` in its entry trampoline): on
// Madaros `x as i8` was the identity, so `0x89 as i8` stayed 137 while an
// `[i8; N]` element reads back sign-extended (-119). apply_relocations_into
// recognises a patch site by comparing code bytes with `(0x89 as i8)`,
// `(0xe8 as i8)`, ...; for every opcode byte >= 0x80 the comparison failed and
// gen2 wrote gen3 with unpatched displacements. `as i8` is now the
// sign-extended low byte, as on lean_single.
var CODE: [i8; 16] = [0; 16]

fn main() -> i32 with IO, Mut, Panic, Div {
    CODE[3] = 0x89 as i8
    CODE[4] = 0xe8 as i8
    let c = 0x89 as i8
    let big: i64 = 300
    let w = big as i8
    let small = 0x7f as i8
    if CODE[3] == (0x89 as i8) && CODE[4] == (0xe8 as i8) && (c as i64) == 0 - 119
        && (w as i64) == 44 && (small as i64) == 127 {
        println("CAST_I8_OK")
        return 0
    }
    print("CAST_I8_FAIL ")
    print_int(c as i64)
    print(" ")
    print_int(w as i64)
    println("")
    return 1
}
