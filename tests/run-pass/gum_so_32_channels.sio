//@ run-pass
//@ requires: madaros
//@ expect-stdout: GUM_SO_32_CHANNELS_OK
//@ description: 32 measured quantities (the whole channel table, up from 8 for second order) carry through one expression: variance_of, hessian_of and second_order_mean are exact. The 33rd is refused at compile time (tests/compile-fail/gum_refuse_uncovered_hessian.sio). Expected values: tests/oracles/gum_so_32_channels.cpp.

fn close_rel(got: f64, want: f64) -> bool with Mut, Div {
    var d = got - want
    if d < 0.0 { d = 0.0 - d }
    var w = want
    if w < 0.0 { w = 0.0 - w }
    d <= 1.0e-14 + 1.0e-10 * w
}

fn report_rel(name: string, got: f64, want: f64) -> i64 with IO, Mut, Div {
    print(name)
    print(" ")
    print_f64(got)
    if close_rel(got, want) {
        print(" ok\n")
        return 0
    }
    print(" FAIL\n")
    1
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let k0 = measure(1.5, uncertainty: 0.1)
    let k1 = measure(2.5, uncertainty: 0.1)
    let k2 = measure(3.5, uncertainty: 0.1)
    let k3 = measure(4.5, uncertainty: 0.1)
    let k4 = measure(5.5, uncertainty: 0.1)
    let k5 = measure(6.5, uncertainty: 0.1)
    let k6 = measure(7.5, uncertainty: 0.1)
    let k7 = measure(8.5, uncertainty: 0.1)
    let k8 = measure(9.5, uncertainty: 0.1)
    let k9 = measure(10.5, uncertainty: 0.1)
    let k10 = measure(11.5, uncertainty: 0.1)
    let k11 = measure(12.5, uncertainty: 0.1)
    let k12 = measure(13.5, uncertainty: 0.1)
    let k13 = measure(14.5, uncertainty: 0.1)
    let k14 = measure(15.5, uncertainty: 0.1)
    let k15 = measure(16.5, uncertainty: 0.1)
    let k16 = measure(17.5, uncertainty: 0.1)
    let k17 = measure(18.5, uncertainty: 0.1)
    let k18 = measure(19.5, uncertainty: 0.1)
    let k19 = measure(20.5, uncertainty: 0.1)
    let k20 = measure(21.5, uncertainty: 0.1)
    let k21 = measure(22.5, uncertainty: 0.1)
    let k22 = measure(23.5, uncertainty: 0.1)
    let k23 = measure(24.5, uncertainty: 0.1)
    let k24 = measure(25.5, uncertainty: 0.1)
    let k25 = measure(26.5, uncertainty: 0.1)
    let k26 = measure(27.5, uncertainty: 0.1)
    let k27 = measure(28.5, uncertainty: 0.1)
    let k28 = measure(29.5, uncertainty: 0.1)
    let k29 = measure(30.5, uncertainty: 0.1)
    let k30 = measure(31.5, uncertainty: 0.1)
    let k31 = measure(32.5, uncertainty: 0.1)
    let r = k0.value * k1.value + k2.value * k2.value + k3.value * k3.value + k4.value * k4.value + k5.value * k5.value + k6.value * k6.value + k7.value * k7.value + k8.value * k8.value + k9.value * k9.value + k10.value * k10.value + k11.value * k11.value + k12.value * k12.value + k13.value * k13.value + k14.value * k14.value + k15.value * k15.value + k16.value * k16.value + k17.value * k17.value + k18.value * k18.value + k19.value * k19.value + k20.value * k20.value + k21.value * k21.value + k22.value * k22.value + k23.value * k23.value + k24.value * k24.value + k25.value * k25.value + k26.value * k26.value + k27.value * k27.value + k28.value * k28.value + k29.value * k29.value + k30.value * k30.value + k31.value * k31.value
    var bad: i64 = 0
    bad = bad + report_rel("variance", variance_of(r), 478.78500000000003)
    bad = bad + report_rel("hessian01", hessian_of(r, 0, 1), 1.0)
    bad = bad + report_rel("hessian_diag", hessian_of(r, 31, 31), 2.0)
    bad = bad + report_rel("mean", second_order_mean(r), 11971.549999999999)
    if bad == 0 {
        print("GUM_SO_32_CHANNELS_OK\n")
        return 0
    }
    1
}
