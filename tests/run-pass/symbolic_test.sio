//@ run-pass
// Symbolic differentiation test suite
//
// T1: eval(2*x + 3) at x=5 gives 13
// T2: d/dx(x*x) = 2*x, eval at x=3 gives 6
// T3: d/dx(sin(x)) = cos(x), eval at x=0 gives 1
// T4: d/dx(exp(x)) = exp(x), eval at x=0 gives 1
// T5: Product rule: d/dx(x * sin(x)) at x=pi/2 gives ~1

// =============================================================================
// Tag constants
// =============================================================================

fn TAG_CONST() -> i64 { 0 }
fn TAG_VAR() -> i64 { 1 }
fn TAG_ADD() -> i64 { 2 }
fn TAG_SUB() -> i64 { 3 }
fn TAG_MUL() -> i64 { 4 }
fn TAG_DIV() -> i64 { 5 }
fn TAG_NEG() -> i64 { 6 }
fn TAG_SIN() -> i64 { 7 }
fn TAG_COS() -> i64 { 8 }
fn TAG_EXP() -> i64 { 9 }
fn TAG_LOG() -> i64 { 10 }
fn TAG_POW() -> i64 { 11 }

// =============================================================================
// Expression Arena
// =============================================================================

struct ExprArena {
    tags: [i64; 256],
    left: [i64; 256],
    right: [i64; 256],
    values: [f64; 256],
    var_ids: [i64; 256],
    count: i64,
}

fn arena_new() -> ExprArena {
    ExprArena {
        tags: [0; 256],
        left: [0; 256],
        right: [0; 256],
        values: [0.0; 256],
        var_ids: [0; 256],
        count: 0,
    }
}

// =============================================================================
// Node constructors
// =============================================================================

fn expr_const(arena: &!ExprArena, value: f64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_CONST()
    arena.left[idx] = 0 - 1
    arena.right[idx] = 0 - 1
    arena.values[idx] = value
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_var(arena: &!ExprArena, var_id: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_VAR()
    arena.left[idx] = 0 - 1
    arena.right[idx] = 0 - 1
    arena.values[idx] = 0.0
    arena.var_ids[idx] = var_id
    arena.count = arena.count + 1
    idx
}

fn expr_add(arena: &!ExprArena, l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_ADD()
    arena.left[idx] = l
    arena.right[idx] = r
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_sub(arena: &!ExprArena, l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_SUB()
    arena.left[idx] = l
    arena.right[idx] = r
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_mul(arena: &!ExprArena, l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_MUL()
    arena.left[idx] = l
    arena.right[idx] = r
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_div(arena: &!ExprArena, l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_DIV()
    arena.left[idx] = l
    arena.right[idx] = r
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_neg(arena: &!ExprArena, child: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_NEG()
    arena.left[idx] = child
    arena.right[idx] = 0 - 1
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_sin(arena: &!ExprArena, child: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_SIN()
    arena.left[idx] = child
    arena.right[idx] = 0 - 1
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_cos(arena: &!ExprArena, child: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_COS()
    arena.left[idx] = child
    arena.right[idx] = 0 - 1
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_exp(arena: &!ExprArena, child: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_EXP()
    arena.left[idx] = child
    arena.right[idx] = 0 - 1
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

fn expr_log(arena: &!ExprArena, child: i64) -> i64 with Mut, Panic {
    let idx = arena.count
    arena.tags[idx] = TAG_LOG()
    arena.left[idx] = child
    arena.right[idx] = 0 - 1
    arena.values[idx] = 0.0
    arena.var_ids[idx] = 0 - 1
    arena.count = arena.count + 1
    idx
}

// =============================================================================
// Math helpers (Taylor series, self-contained)
// =============================================================================

fn sym_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sym_floor(x: f64) -> f64 with Mut, Panic, Div {
    let i = x as i32
    let f = i as f64
    if x < 0.0 && f != x { return f - 1.0 }
    return f
}

fn sym_sin(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    let two_pi = 6.283185307179586
    var t = x - sym_floor(x / two_pi) * two_pi
    if t > pi { t = t - two_pi }
    if t < 0.0 - pi { t = t + two_pi }
    var sum = t
    var term = t
    var n = 1
    while n <= 20 {
        term = 0.0 - term * t * t / (((2 * n) as f64) * ((2 * n + 1) as f64))
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn sym_cos(x: f64) -> f64 with Mut, Panic, Div {
    return sym_sin(x + 1.5707963267948966)
}

fn sym_exp(x: f64) -> f64 with Mut, Panic, Div {
    let ln2 = 0.6931471805599453
    let k_f = sym_floor(x / ln2 + 0.5)
    let k = k_f as i32
    let r = x - k_f * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 25 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k > 0 {
        var j = 0
        while j < k { result = result * 2.0; j = j + 1 }
    } else if k < 0 {
        var j = 0
        let neg_k = 0 - k
        while j < neg_k { result = result / 2.0; j = j + 1 }
    }
    return result
}

// =============================================================================
// Evaluation
// =============================================================================

fn expr_eval(arena: &ExprArena, idx: i64, vars: &[f64; 16], n_vars: i64) -> f64 with Mut, Panic, Div {
    let tag = arena.tags[idx]

    if tag == TAG_CONST() {
        return arena.values[idx]
    }
    if tag == TAG_VAR() {
        let vid = arena.var_ids[idx]
        if vid >= 0 && vid < n_vars {
            return (*vars)[vid]
        }
        return 0.0
    }
    if tag == TAG_ADD() {
        let lv = expr_eval(arena, arena.left[idx], vars, n_vars)
        let rv = expr_eval(arena, arena.right[idx], vars, n_vars)
        return lv + rv
    }
    if tag == TAG_SUB() {
        let lv = expr_eval(arena, arena.left[idx], vars, n_vars)
        let rv = expr_eval(arena, arena.right[idx], vars, n_vars)
        return lv - rv
    }
    if tag == TAG_MUL() {
        let lv = expr_eval(arena, arena.left[idx], vars, n_vars)
        let rv = expr_eval(arena, arena.right[idx], vars, n_vars)
        return lv * rv
    }
    if tag == TAG_DIV() {
        let lv = expr_eval(arena, arena.left[idx], vars, n_vars)
        let rv = expr_eval(arena, arena.right[idx], vars, n_vars)
        return lv / rv
    }
    if tag == TAG_NEG() {
        let cv = expr_eval(arena, arena.left[idx], vars, n_vars)
        return 0.0 - cv
    }
    if tag == TAG_SIN() {
        let cv = expr_eval(arena, arena.left[idx], vars, n_vars)
        return sym_sin(cv)
    }
    if tag == TAG_COS() {
        let cv = expr_eval(arena, arena.left[idx], vars, n_vars)
        return sym_cos(cv)
    }
    if tag == TAG_EXP() {
        let cv = expr_eval(arena, arena.left[idx], vars, n_vars)
        return sym_exp(cv)
    }
    return 0.0
}

// =============================================================================
// Symbolic differentiation
// =============================================================================

fn expr_diff(arena: &!ExprArena, idx: i64, var_id: i64) -> i64 with Mut, Panic, Div {
    let tag = arena.tags[idx]

    if tag == TAG_CONST() {
        return expr_const(arena, 0.0)
    }

    if tag == TAG_VAR() {
        if arena.var_ids[idx] == var_id {
            return expr_const(arena, 1.0)
        }
        return expr_const(arena, 0.0)
    }

    if tag == TAG_ADD() {
        let dl = expr_diff(arena, arena.left[idx], var_id)
        let dr = expr_diff(arena, arena.right[idx], var_id)
        return expr_add(arena, dl, dr)
    }

    if tag == TAG_SUB() {
        let dl = expr_diff(arena, arena.left[idx], var_id)
        let dr = expr_diff(arena, arena.right[idx], var_id)
        return expr_sub(arena, dl, dr)
    }

    if tag == TAG_MUL() {
        let l = arena.left[idx]
        let r = arena.right[idx]
        let dl = expr_diff(arena, l, var_id)
        let dr = expr_diff(arena, r, var_id)
        let t1 = expr_mul(arena, dl, r)
        let t2 = expr_mul(arena, l, dr)
        return expr_add(arena, t1, t2)
    }

    if tag == TAG_DIV() {
        let l = arena.left[idx]
        let r = arena.right[idx]
        let dl = expr_diff(arena, l, var_id)
        let dr = expr_diff(arena, r, var_id)
        let num_l = expr_mul(arena, dl, r)
        let num_r = expr_mul(arena, l, dr)
        let numer = expr_sub(arena, num_l, num_r)
        let denom = expr_mul(arena, r, r)
        return expr_div(arena, numer, denom)
    }

    if tag == TAG_NEG() {
        let dc = expr_diff(arena, arena.left[idx], var_id)
        return expr_neg(arena, dc)
    }

    // d/dx[sin(f)] = cos(f) * f'
    if tag == TAG_SIN() {
        let child = arena.left[idx]
        let dc = expr_diff(arena, child, var_id)
        let cos_node = expr_cos(arena, child)
        return expr_mul(arena, cos_node, dc)
    }

    // d/dx[cos(f)] = -sin(f) * f'
    if tag == TAG_COS() {
        let child = arena.left[idx]
        let dc = expr_diff(arena, child, var_id)
        let sin_node = expr_sin(arena, child)
        let neg_sin = expr_neg(arena, sin_node)
        return expr_mul(arena, neg_sin, dc)
    }

    // d/dx[exp(f)] = exp(f) * f'
    if tag == TAG_EXP() {
        let child = arena.left[idx]
        let dc = expr_diff(arena, child, var_id)
        let exp_node = expr_exp(arena, child)
        return expr_mul(arena, exp_node, dc)
    }

    // d/dx[log(f)] = f' / f
    if tag == TAG_LOG() {
        let child = arena.left[idx]
        let dc = expr_diff(arena, child, var_id)
        return expr_div(arena, dc, child)
    }

    return expr_const(arena, 0.0)
}

// =============================================================================
// Simplification (basic)
// =============================================================================

fn is_const_val(arena: &ExprArena, idx: i64, val: f64) -> bool with Panic {
    if arena.tags[idx] == TAG_CONST() {
        let diff = arena.values[idx] - val
        if diff < 0.0 { return (0.0 - diff) < 1.0e-15 }
        return diff < 1.0e-15
    }
    return false
}

fn expr_simplify(arena: &!ExprArena, idx: i64) -> i64 with Mut, Panic, Div {
    let tag = arena.tags[idx]

    if tag == TAG_CONST() { return idx }
    if tag == TAG_VAR() { return idx }

    if tag == TAG_NEG() {
        let sc = expr_simplify(arena, arena.left[idx])
        if arena.tags[sc] == TAG_CONST() {
            return expr_const(arena, 0.0 - arena.values[sc])
        }
        if arena.tags[sc] == TAG_NEG() {
            return arena.left[sc]
        }
        arena.left[idx] = sc
        return idx
    }

    if tag == TAG_ADD() {
        let sl = expr_simplify(arena, arena.left[idx])
        let sr = expr_simplify(arena, arena.right[idx])
        if arena.tags[sl] == TAG_CONST() && arena.tags[sr] == TAG_CONST() {
            return expr_const(arena, arena.values[sl] + arena.values[sr])
        }
        if is_const_val(arena, sl, 0.0) { return sr }
        if is_const_val(arena, sr, 0.0) { return sl }
        arena.left[idx] = sl
        arena.right[idx] = sr
        return idx
    }

    if tag == TAG_SUB() {
        let sl = expr_simplify(arena, arena.left[idx])
        let sr = expr_simplify(arena, arena.right[idx])
        if arena.tags[sl] == TAG_CONST() && arena.tags[sr] == TAG_CONST() {
            return expr_const(arena, arena.values[sl] - arena.values[sr])
        }
        if is_const_val(arena, sr, 0.0) { return sl }
        if is_const_val(arena, sl, 0.0) { return expr_neg(arena, sr) }
        arena.left[idx] = sl
        arena.right[idx] = sr
        return idx
    }

    if tag == TAG_MUL() {
        let sl = expr_simplify(arena, arena.left[idx])
        let sr = expr_simplify(arena, arena.right[idx])
        if arena.tags[sl] == TAG_CONST() && arena.tags[sr] == TAG_CONST() {
            return expr_const(arena, arena.values[sl] * arena.values[sr])
        }
        if is_const_val(arena, sl, 0.0) { return expr_const(arena, 0.0) }
        if is_const_val(arena, sr, 0.0) { return expr_const(arena, 0.0) }
        if is_const_val(arena, sl, 1.0) { return sr }
        if is_const_val(arena, sr, 1.0) { return sl }
        arena.left[idx] = sl
        arena.right[idx] = sr
        return idx
    }

    if tag == TAG_DIV() {
        let sl = expr_simplify(arena, arena.left[idx])
        let sr = expr_simplify(arena, arena.right[idx])
        if arena.tags[sl] == TAG_CONST() && arena.tags[sr] == TAG_CONST() {
            if sym_abs(arena.values[sr]) > 1.0e-30 {
                return expr_const(arena, arena.values[sl] / arena.values[sr])
            }
        }
        if is_const_val(arena, sl, 0.0) { return expr_const(arena, 0.0) }
        if is_const_val(arena, sr, 1.0) { return sl }
        arena.left[idx] = sl
        arena.right[idx] = sr
        return idx
    }

    return idx
}

// =============================================================================
// Print expression
// =============================================================================

fn print_f64_compact(v: f64) with IO, Mut, Panic, Div {
    if v < 0.0 {
        print("(0-")
        let neg_v = 0.0 - v
        let int_part = neg_v as i64
        let frac = ((neg_v - (int_part as f64)) * 1000000.0) as i64
        print_int(int_part)
        if frac > 0 {
            print(".")
            print_int(frac)
        }
        print(")")
        return
    }
    let int_part = v as i64
    let frac = ((v - (int_part as f64)) * 1000000.0) as i64
    print_int(int_part)
    if frac > 0 {
        print(".")
        print_int(frac)
    }
}

fn expr_print(arena: &ExprArena, idx: i64) with IO, Mut, Panic, Div {
    let tag = arena.tags[idx]
    if tag == TAG_CONST() {
        print_f64_compact(arena.values[idx])
        return
    }
    if tag == TAG_VAR() {
        print("x")
        print_int(arena.var_ids[idx])
        return
    }
    if tag == TAG_ADD() {
        print("(")
        expr_print(arena, arena.left[idx])
        print(" + ")
        expr_print(arena, arena.right[idx])
        print(")")
        return
    }
    if tag == TAG_SUB() {
        print("(")
        expr_print(arena, arena.left[idx])
        print(" - ")
        expr_print(arena, arena.right[idx])
        print(")")
        return
    }
    if tag == TAG_MUL() {
        print("(")
        expr_print(arena, arena.left[idx])
        print(" * ")
        expr_print(arena, arena.right[idx])
        print(")")
        return
    }
    if tag == TAG_DIV() {
        print("(")
        expr_print(arena, arena.left[idx])
        print(" / ")
        expr_print(arena, arena.right[idx])
        print(")")
        return
    }
    if tag == TAG_NEG() {
        print("(0-")
        expr_print(arena, arena.left[idx])
        print(")")
        return
    }
    if tag == TAG_SIN() {
        print("sin(")
        expr_print(arena, arena.left[idx])
        print(")")
        return
    }
    if tag == TAG_COS() {
        print("cos(")
        expr_print(arena, arena.left[idx])
        print(")")
        return
    }
    if tag == TAG_EXP() {
        print("exp(")
        expr_print(arena, arena.left[idx])
        print(")")
        return
    }
    if tag == TAG_LOG() {
        print("log(")
        expr_print(arena, arena.left[idx])
        print(")")
        return
    }
    print("?")
}

// =============================================================================
// Helpers
// =============================================================================

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < tol }
    return d < tol
}

fn print_f64_6(v: f64) -> i64 with IO, Mut, Panic, Div {
    if v < 0.0 {
        print("-")
        let neg_v = 0.0 - v
        let int_part = neg_v as i64
        let frac = ((neg_v - (int_part as f64)) * 1000000.0) as i64
        print_int(int_part)
        print(".")
        if frac < 100000 { print("0") }
        if frac < 10000 { print("0") }
        if frac < 1000 { print("0") }
        if frac < 100 { print("0") }
        if frac < 10 { print("0") }
        print_int(frac)
        return 0
    }
    let int_part = v as i64
    let frac = ((v - (int_part as f64)) * 1000000.0) as i64
    print_int(int_part)
    print(".")
    if frac < 100000 { print("0") }
    if frac < 10000 { print("0") }
    if frac < 1000 { print("0") }
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
    return 0
}

// =============================================================================
// Tests
// =============================================================================

// T1: eval(2*x + 3) at x=5 gives 13
fn test_eval_linear() -> bool with IO, Mut, Panic, Div {
    var arena = arena_new()
    // Build: 2*x0 + 3
    let two = expr_const(&! arena, 2.0)
    let x = expr_var(&! arena, 0)
    let three = expr_const(&! arena, 3.0)
    let prod = expr_mul(&! arena, two, x)
    let expr = expr_add(&! arena, prod, three)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 5.0
    let result = expr_eval(&arena, expr, &vars, 1)

    print("  eval(2*x+3) at x=5 = ")
    print_f64_6(result)
    println("")

    return approx_eq(result, 13.0, 1.0e-10)
}

// T2: d/dx(x*x) simplify+eval at x=3 gives 6
fn test_diff_x_squared() -> bool with IO, Mut, Panic, Div {
    var arena = arena_new()
    // Build: x0 * x0
    let x = expr_var(&! arena, 0)
    let x2 = expr_mul(&! arena, x, x)

    // Differentiate w.r.t. x0
    let dx2 = expr_diff(&! arena, x2, 0)

    // Simplify
    let sdx2 = expr_simplify(&! arena, dx2)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 3.0
    let result = expr_eval(&arena, sdx2, &vars, 1)

    print("  d/dx(x*x) at x=3 = ")
    print_f64_6(result)
    println("")

    print("  expr: ")
    expr_print(&arena, sdx2)
    println("")

    return approx_eq(result, 6.0, 1.0e-8)
}

// T3: d/dx(sin(x)) = cos(x), eval at x=0 gives 1
fn test_diff_sin() -> bool with IO, Mut, Panic, Div {
    var arena = arena_new()
    let x = expr_var(&! arena, 0)
    let sin_x = expr_sin(&! arena, x)

    let dsin = expr_diff(&! arena, sin_x, 0)
    let sdsin = expr_simplify(&! arena, dsin)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 0.0
    let result = expr_eval(&arena, sdsin, &vars, 1)

    print("  d/dx(sin(x)) at x=0 = ")
    print_f64_6(result)
    println("")

    return approx_eq(result, 1.0, 1.0e-8)
}

// T4: d/dx(exp(x)) = exp(x), eval at x=0 gives 1
fn test_diff_exp() -> bool with IO, Mut, Panic, Div {
    var arena = arena_new()
    let x = expr_var(&! arena, 0)
    let exp_x = expr_exp(&! arena, x)

    let dexp = expr_diff(&! arena, exp_x, 0)
    let sdexp = expr_simplify(&! arena, dexp)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 0.0
    let result = expr_eval(&arena, sdexp, &vars, 1)

    print("  d/dx(exp(x)) at x=0 = ")
    print_f64_6(result)
    println("")

    return approx_eq(result, 1.0, 1.0e-8)
}

// T5: Product rule: d/dx(x * sin(x)) at x=pi/2
// d/dx(x*sin(x)) = sin(x) + x*cos(x)
// At x=pi/2: sin(pi/2) + (pi/2)*cos(pi/2) = 1 + (pi/2)*0 = 1
fn test_product_rule() -> bool with IO, Mut, Panic, Div {
    var arena = arena_new()
    let x = expr_var(&! arena, 0)
    let sin_x = expr_sin(&! arena, x)
    let prod = expr_mul(&! arena, x, sin_x)

    let dprod = expr_diff(&! arena, prod, 0)
    let sdprod = expr_simplify(&! arena, dprod)

    let pi_half = 1.5707963267948966
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = pi_half
    let result = expr_eval(&arena, sdprod, &vars, 1)

    print("  d/dx(x*sin(x)) at x=pi/2 = ")
    print_f64_6(result)
    println("")

    // sin(pi/2) + (pi/2)*cos(pi/2) = 1 + ~0 = 1
    return approx_eq(result, 1.0, 1.0e-6)
}

// =============================================================================
// Main
// =============================================================================

fn main() -> i64 with IO, Mut, Div, Panic {
    println("=== Symbolic Differentiation Tests ===")
    println("")

    var passed: i64 = 0
    var failed: i64 = 0

    print("T1: eval(2*x+3) at x=5 = 13 ... ")
    if test_eval_linear() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T2: d/dx(x^2) = 2x ............ ")
    if test_diff_x_squared() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T3: d/dx(sin(x)) = cos(x) ..... ")
    if test_diff_sin() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T4: d/dx(exp(x)) = exp(x) ..... ")
    if test_diff_exp() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T5: product rule x*sin(x) ..... ")
    if test_product_rule() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 5 TESTS PASSED")
    return 0
}
