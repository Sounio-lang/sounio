//@ run-pass
// Symbolic differentiation test suite
//
// T1: eval(2*x + 3) at x=5 gives 13
// T2: d/dx(x*x) = 2*x, eval at x=3 gives 6
// T3: d/dx(sin(x)) = cos(x), eval at x=0 gives 1
// T4: d/dx(exp(x)) = exp(x), eval at x=0 gives 1
// T5: Product rule: d/dx(x * sin(x)) at x=pi/2 gives ~1
//
// Uses global flat arrays instead of ExprArena struct+references
// to avoid lean_single's &!Struct write-through limitation.

// =============================================================================
// Tag constants
// =============================================================================

fn TAG_CONST() -> i64 { 0 }
fn TAG_VAR() -> i64 { 1 }
fn TAG_ADD() -> i64 { 2 }
fn TAG_SUB() -> i64 { 3 }
fn TAG_MUL() -> i64 { 4 }
fn TAG_DIV() -> i64 { 5 }
fn TAG_NEG() -> i64 { 6 }
fn TAG_SIN() -> i64 { 7 }
fn TAG_COS() -> i64 { 8 }
fn TAG_EXP() -> i64 { 9 }
fn TAG_LOG() -> i64 { 10 }

// =============================================================================
// Global arena (flat arrays, BSS-allocated)
// =============================================================================

var AR_TAGS: [i64; 256] = [0; 256]
var AR_LEFT: [i64; 256] = [0; 256]
var AR_RIGHT: [i64; 256] = [0; 256]
var AR_VALS: [f64; 256] = [0.0; 256]
var AR_VIDS: [i64; 256] = [0; 256]
var AR_COUNT: i64 = 0

fn arena_reset() with Mut { AR_COUNT = 0 }

// =============================================================================
// Node constructors (operate on global arena)
// =============================================================================

fn expr_const(value: f64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 0  // TAG_CONST
    AR_LEFT[idx] = 0 - 1
    AR_RIGHT[idx] = 0 - 1
    AR_VALS[idx] = value
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_var(var_id: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 1  // TAG_VAR
    AR_LEFT[idx] = 0 - 1
    AR_RIGHT[idx] = 0 - 1
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = var_id
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_add(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 2  // TAG_ADD
    AR_LEFT[idx] = l
    AR_RIGHT[idx] = r
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_sub(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 3  // TAG_SUB
    AR_LEFT[idx] = l
    AR_RIGHT[idx] = r
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_mul(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 4  // TAG_MUL
    AR_LEFT[idx] = l
    AR_RIGHT[idx] = r
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_div(l: i64, r: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 5  // TAG_DIV
    AR_LEFT[idx] = l
    AR_RIGHT[idx] = r
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_neg(child: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 6  // TAG_NEG
    AR_LEFT[idx] = child
    AR_RIGHT[idx] = 0 - 1
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_sin(child: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 7  // TAG_SIN
    AR_LEFT[idx] = child
    AR_RIGHT[idx] = 0 - 1
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_cos(child: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 8  // TAG_COS
    AR_LEFT[idx] = child
    AR_RIGHT[idx] = 0 - 1
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_exp(child: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 9  // TAG_EXP
    AR_LEFT[idx] = child
    AR_RIGHT[idx] = 0 - 1
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

fn expr_log(child: i64) -> i64 with Mut, Panic {
    let idx = AR_COUNT
    AR_TAGS[idx] = 10  // TAG_LOG
    AR_LEFT[idx] = child
    AR_RIGHT[idx] = 0 - 1
    AR_VALS[idx] = 0.0
    AR_VIDS[idx] = 0 - 1
    AR_COUNT = AR_COUNT + 1
    idx
}

// =============================================================================
// Math helpers (Taylor series, self-contained)
// =============================================================================

fn sym_abs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn sym_floor(x: f64) -> f64 with Mut, Panic, Div {
    let i = x as i32
    let f = i as f64
    if x < 0.0 && f != x { return f - 1.0 }
    return f
}

fn sym_sin(x: f64) -> f64 with Mut, Panic, Div {
    let pi = 3.141592653589793
    let two_pi = 6.283185307179586
    var t = x - sym_floor(x / two_pi) * two_pi
    if t > pi { t = t - two_pi }
    if t < 0.0 - pi { t = t + two_pi }
    var sum = t
    var term = t
    var n = 1
    while n <= 20 {
        term = 0.0 - term * t * t / (((2 * n) as f64) * ((2 * n + 1) as f64))
        sum = sum + term
        n = n + 1
    }
    return sum
}

fn sym_cos(x: f64) -> f64 with Mut, Panic, Div {
    return sym_sin(x + 1.5707963267948966)
}

fn sym_exp(x: f64) -> f64 with Mut, Panic, Div {
    let ln2 = 0.6931471805599453
    let k_f = sym_floor(x / ln2 + 0.5)
    let k = k_f as i32
    let r = x - k_f * ln2
    var sum = 1.0
    var term = 1.0
    var n = 1
    while n <= 25 {
        term = term * r / (n as f64)
        sum = sum + term
        n = n + 1
    }
    var result = sum
    if k > 0 {
        var j = 0
        while j < k { result = result * 2.0; j = j + 1 }
    } else if k < 0 {
        var j = 0
        let neg_k = 0 - k
        while j < neg_k { result = result / 2.0; j = j + 1 }
    }
    return result
}

// =============================================================================
// Evaluation
// =============================================================================

fn expr_eval(idx: i64, vars: &[f64; 16], n_vars: i64) -> f64 with Mut, Panic, Div {
    let tag = AR_TAGS[idx]

    if tag == 0 {  // TAG_CONST
        return AR_VALS[idx]
    }
    if tag == 1 {  // TAG_VAR
        let vid = AR_VIDS[idx]
        if vid >= 0 && vid < n_vars {
            return vars[vid]
        }
        return 0.0
    }
    if tag == 2 {  // TAG_ADD
        let lv = expr_eval(AR_LEFT[idx], vars, n_vars)
        let rv = expr_eval(AR_RIGHT[idx], vars, n_vars)
        return lv + rv
    }
    if tag == 3 {  // TAG_SUB
        let lv = expr_eval(AR_LEFT[idx], vars, n_vars)
        let rv = expr_eval(AR_RIGHT[idx], vars, n_vars)
        return lv - rv
    }
    if tag == 4 {  // TAG_MUL
        let lv = expr_eval(AR_LEFT[idx], vars, n_vars)
        let rv = expr_eval(AR_RIGHT[idx], vars, n_vars)
        return lv * rv
    }
    if tag == 5 {  // TAG_DIV
        let lv = expr_eval(AR_LEFT[idx], vars, n_vars)
        let rv = expr_eval(AR_RIGHT[idx], vars, n_vars)
        return lv / rv
    }
    if tag == 6 {  // TAG_NEG
        let cv = expr_eval(AR_LEFT[idx], vars, n_vars)
        return 0.0 - cv
    }
    if tag == 7 {  // TAG_SIN
        let cv = expr_eval(AR_LEFT[idx], vars, n_vars)
        return sym_sin(cv)
    }
    if tag == 8 {  // TAG_COS
        let cv = expr_eval(AR_LEFT[idx], vars, n_vars)
        return sym_cos(cv)
    }
    if tag == 9 {  // TAG_EXP
        let cv = expr_eval(AR_LEFT[idx], vars, n_vars)
        return sym_exp(cv)
    }
    return 0.0
}

// =============================================================================
// Symbolic differentiation
// =============================================================================

fn expr_diff(idx: i64, var_id: i64) -> i64 with Mut, Panic, Div {
    let tag = AR_TAGS[idx]

    if tag == 0 {  // TAG_CONST
        return expr_const(0.0)
    }

    if tag == 1 {  // TAG_VAR
        if AR_VIDS[idx] == var_id {
            return expr_const(1.0)
        }
        return expr_const(0.0)
    }

    if tag == 2 {  // TAG_ADD
        let dl = expr_diff(AR_LEFT[idx], var_id)
        let dr = expr_diff(AR_RIGHT[idx], var_id)
        return expr_add(dl, dr)
    }

    if tag == 3 {  // TAG_SUB
        let dl = expr_diff(AR_LEFT[idx], var_id)
        let dr = expr_diff(AR_RIGHT[idx], var_id)
        return expr_sub(dl, dr)
    }

    if tag == 4 {  // TAG_MUL
        let l = AR_LEFT[idx]
        let r = AR_RIGHT[idx]
        let dl = expr_diff(l, var_id)
        let dr = expr_diff(r, var_id)
        let t1 = expr_mul(dl, r)
        let t2 = expr_mul(l, dr)
        return expr_add(t1, t2)
    }

    if tag == 5 {  // TAG_DIV
        let l = AR_LEFT[idx]
        let r = AR_RIGHT[idx]
        let dl = expr_diff(l, var_id)
        let dr = expr_diff(r, var_id)
        let num_l = expr_mul(dl, r)
        let num_r = expr_mul(l, dr)
        let numer = expr_sub(num_l, num_r)
        let denom = expr_mul(r, r)
        return expr_div(numer, denom)
    }

    if tag == 6 {  // TAG_NEG
        let dc = expr_diff(AR_LEFT[idx], var_id)
        return expr_neg(dc)
    }

    if tag == 7 {  // TAG_SIN — d/dx[sin(f)] = cos(f) * f'
        let child = AR_LEFT[idx]
        let dc = expr_diff(child, var_id)
        let cos_node = expr_cos(child)
        return expr_mul(cos_node, dc)
    }

    if tag == 8 {  // TAG_COS — d/dx[cos(f)] = -sin(f) * f'
        let child = AR_LEFT[idx]
        let dc = expr_diff(child, var_id)
        let sin_node = expr_sin(child)
        let neg_sin = expr_neg(sin_node)
        return expr_mul(neg_sin, dc)
    }

    if tag == 9 {  // TAG_EXP — d/dx[exp(f)] = exp(f) * f'
        let child = AR_LEFT[idx]
        let dc = expr_diff(child, var_id)
        let exp_node = expr_exp(child)
        return expr_mul(exp_node, dc)
    }

    if tag == 10 {  // TAG_LOG — d/dx[log(f)] = f' / f
        let child = AR_LEFT[idx]
        let dc = expr_diff(child, var_id)
        return expr_div(dc, child)
    }

    return expr_const(0.0)
}

// =============================================================================
// Simplification (basic)
// =============================================================================

fn is_const_val(idx: i64, val: f64) -> bool with Panic {
    if AR_TAGS[idx] == 0 {  // TAG_CONST
        let diff = AR_VALS[idx] - val
        if diff < 0.0 { return (0.0 - diff) < 1.0e-15 }
        return diff < 1.0e-15
    }
    return false
}

fn expr_simplify(idx: i64) -> i64 with Mut, Panic, Div {
    let tag = AR_TAGS[idx]

    if tag == 0 { return idx }  // TAG_CONST
    if tag == 1 { return idx }  // TAG_VAR

    if tag == 6 {  // TAG_NEG
        let sc = expr_simplify(AR_LEFT[idx])
        if AR_TAGS[sc] == 0 {  // TAG_CONST
            return expr_const(0.0 - AR_VALS[sc])
        }
        if AR_TAGS[sc] == 6 {  // TAG_NEG
            return AR_LEFT[sc]
        }
        AR_LEFT[idx] = sc
        return idx
    }

    if tag == 2 {  // TAG_ADD
        let sl = expr_simplify(AR_LEFT[idx])
        let sr = expr_simplify(AR_RIGHT[idx])
        if AR_TAGS[sl] == 0 && AR_TAGS[sr] == 0 {
            return expr_const(AR_VALS[sl] + AR_VALS[sr])
        }
        if is_const_val(sl, 0.0) { return sr }
        if is_const_val(sr, 0.0) { return sl }
        AR_LEFT[idx] = sl
        AR_RIGHT[idx] = sr
        return idx
    }

    if tag == 3 {  // TAG_SUB
        let sl = expr_simplify(AR_LEFT[idx])
        let sr = expr_simplify(AR_RIGHT[idx])
        if AR_TAGS[sl] == 0 && AR_TAGS[sr] == 0 {
            return expr_const(AR_VALS[sl] - AR_VALS[sr])
        }
        if is_const_val(sr, 0.0) { return sl }
        if is_const_val(sl, 0.0) { return expr_neg(sr) }
        AR_LEFT[idx] = sl
        AR_RIGHT[idx] = sr
        return idx
    }

    if tag == 4 {  // TAG_MUL
        let sl = expr_simplify(AR_LEFT[idx])
        let sr = expr_simplify(AR_RIGHT[idx])
        if AR_TAGS[sl] == 0 && AR_TAGS[sr] == 0 {
            return expr_const(AR_VALS[sl] * AR_VALS[sr])
        }
        if is_const_val(sl, 0.0) { return expr_const(0.0) }
        if is_const_val(sr, 0.0) { return expr_const(0.0) }
        if is_const_val(sl, 1.0) { return sr }
        if is_const_val(sr, 1.0) { return sl }
        AR_LEFT[idx] = sl
        AR_RIGHT[idx] = sr
        return idx
    }

    if tag == 5 {  // TAG_DIV
        let sl = expr_simplify(AR_LEFT[idx])
        let sr = expr_simplify(AR_RIGHT[idx])
        if AR_TAGS[sl] == 0 && AR_TAGS[sr] == 0 {
            if sym_abs(AR_VALS[sr]) > 1.0e-30 {
                return expr_const(AR_VALS[sl] / AR_VALS[sr])
            }
        }
        if is_const_val(sl, 0.0) { return expr_const(0.0) }
        if is_const_val(sr, 1.0) { return sl }
        AR_LEFT[idx] = sl
        AR_RIGHT[idx] = sr
        return idx
    }

    return idx
}

// =============================================================================
// Print expression
// =============================================================================

fn print_f64_compact(v: f64) with IO, Mut, Panic, Div {
    if v < 0.0 {
        print("(0-")
        let neg_v = 0.0 - v
        let int_part = neg_v as i64
        let frac = ((neg_v - (int_part as f64)) * 1000000.0) as i64
        print_int(int_part)
        if frac > 0 {
            print(".")
            print_int(frac)
        }
        print(")")
        return
    }
    let int_part = v as i64
    let frac = ((v - (int_part as f64)) * 1000000.0) as i64
    print_int(int_part)
    if frac > 0 {
        print(".")
        print_int(frac)
    }
}

fn expr_print(idx: i64) with IO, Mut, Panic, Div {
    let tag = AR_TAGS[idx]
    if tag == 0 {
        print_f64_compact(AR_VALS[idx])
        return
    }
    if tag == 1 {
        print("x")
        print_int(AR_VIDS[idx])
        return
    }
    if tag == 2 {
        print("(")
        expr_print(AR_LEFT[idx])
        print(" + ")
        expr_print(AR_RIGHT[idx])
        print(")")
        return
    }
    if tag == 3 {
        print("(")
        expr_print(AR_LEFT[idx])
        print(" - ")
        expr_print(AR_RIGHT[idx])
        print(")")
        return
    }
    if tag == 4 {
        print("(")
        expr_print(AR_LEFT[idx])
        print(" * ")
        expr_print(AR_RIGHT[idx])
        print(")")
        return
    }
    if tag == 5 {
        print("(")
        expr_print(AR_LEFT[idx])
        print(" / ")
        expr_print(AR_RIGHT[idx])
        print(")")
        return
    }
    if tag == 6 {
        print("(0-")
        expr_print(AR_LEFT[idx])
        print(")")
        return
    }
    if tag == 7 {
        print("sin(")
        expr_print(AR_LEFT[idx])
        print(")")
        return
    }
    if tag == 8 {
        print("cos(")
        expr_print(AR_LEFT[idx])
        print(")")
        return
    }
    if tag == 9 {
        print("exp(")
        expr_print(AR_LEFT[idx])
        print(")")
        return
    }
    if tag == 10 {
        print("log(")
        expr_print(AR_LEFT[idx])
        print(")")
        return
    }
    print("?")
}

// =============================================================================
// Helpers
// =============================================================================

fn approx_eq(a: f64, b: f64, tol: f64) -> bool {
    let d = a - b
    if d < 0.0 { return (0.0 - d) < tol }
    return d < tol
}

fn print_f64_6(v: f64) -> i64 with IO, Mut, Panic, Div {
    if v < 0.0 {
        print("-")
        let neg_v = 0.0 - v
        let int_part = neg_v as i64
        let frac = ((neg_v - (int_part as f64)) * 1000000.0) as i64
        print_int(int_part)
        print(".")
        if frac < 100000 { print("0") }
        if frac < 10000 { print("0") }
        if frac < 1000 { print("0") }
        if frac < 100 { print("0") }
        if frac < 10 { print("0") }
        print_int(frac)
        return 0
    }
    let int_part = v as i64
    let frac = ((v - (int_part as f64)) * 1000000.0) as i64
    print_int(int_part)
    print(".")
    if frac < 100000 { print("0") }
    if frac < 10000 { print("0") }
    if frac < 1000 { print("0") }
    if frac < 100 { print("0") }
    if frac < 10 { print("0") }
    print_int(frac)
    return 0
}

// =============================================================================
// Tests
// =============================================================================

// T1: eval(2*x + 3) at x=5 gives 13
fn test_eval_linear() -> bool with IO, Mut, Panic, Div {
    arena_reset()
    // Build: 2*x0 + 3
    let two = expr_const(2.0)
    let x = expr_var(0)
    let three = expr_const(3.0)
    let prod = expr_mul(two, x)
    let expr = expr_add(prod, three)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 5.0
    let result = expr_eval(expr, &vars, 1)

    print("  eval(2*x+3) at x=5 = ")
    print_f64_6(result)
    println("")

    return approx_eq(result, 13.0, 1.0e-10)
}

// T2: d/dx(x*x) simplify+eval at x=3 gives 6
fn test_diff_x_squared() -> bool with IO, Mut, Panic, Div {
    arena_reset()
    // Build: x0 * x0
    let x = expr_var(0)
    let x2 = expr_mul(x, x)

    // Differentiate w.r.t. x0
    let dx2 = expr_diff(x2, 0)

    // Simplify
    let sdx2 = expr_simplify(dx2)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 3.0
    let result = expr_eval(sdx2, &vars, 1)

    print("  d/dx(x*x) at x=3 = ")
    print_f64_6(result)
    println("")

    print("  expr: ")
    expr_print(sdx2)
    println("")

    return approx_eq(result, 6.0, 1.0e-8)
}

// T3: d/dx(sin(x)) = cos(x), eval at x=0 gives 1
fn test_diff_sin() -> bool with IO, Mut, Panic, Div {
    arena_reset()
    let x = expr_var(0)
    let sin_x = expr_sin(x)

    let dsin = expr_diff(sin_x, 0)
    let sdsin = expr_simplify(dsin)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 0.0
    let result = expr_eval(sdsin, &vars, 1)

    print("  d/dx(sin(x)) at x=0 = ")
    print_f64_6(result)
    println("")

    return approx_eq(result, 1.0, 1.0e-8)
}

// T4: d/dx(exp(x)) = exp(x), eval at x=0 gives 1
fn test_diff_exp() -> bool with IO, Mut, Panic, Div {
    arena_reset()
    let x = expr_var(0)
    let exp_x = expr_exp(x)

    let dexp = expr_diff(exp_x, 0)
    let sdexp = expr_simplify(dexp)

    var vars: [f64; 16] = [0.0; 16]
    vars[0] = 0.0
    let result = expr_eval(sdexp, &vars, 1)

    print("  d/dx(exp(x)) at x=0 = ")
    print_f64_6(result)
    println("")

    return approx_eq(result, 1.0, 1.0e-8)
}

// T5: Product rule: d/dx(x * sin(x)) at x=pi/2 gives ~1
fn test_product_rule() -> bool with IO, Mut, Panic, Div {
    arena_reset()
    let x = expr_var(0)
    let sin_x = expr_sin(x)
    let prod = expr_mul(x, sin_x)

    let dprod = expr_diff(prod, 0)
    let sdprod = expr_simplify(dprod)

    let pi_half = 1.5707963267948966
    var vars: [f64; 16] = [0.0; 16]
    vars[0] = pi_half
    let result = expr_eval(sdprod, &vars, 1)

    print("  d/dx(x*sin(x)) at x=pi/2 = ")
    print_f64_6(result)
    println("")

    // sin(pi/2) + (pi/2)*cos(pi/2) = 1 + ~0 = 1
    return approx_eq(result, 1.0, 1.0e-6)
}

// =============================================================================
// Main
// =============================================================================

fn main() -> i64 with IO, Mut, Div, Panic {
    println("=== Symbolic Differentiation Tests ===")
    println("")

    var passed: i64 = 0
    var failed: i64 = 0

    print("T1: eval(2*x+3) at x=5 = 13 ... ")
    if test_eval_linear() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T2: d/dx(x^2) = 2x ............ ")
    if test_diff_x_squared() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T3: d/dx(sin(x)) = cos(x) ..... ")
    if test_diff_sin() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T4: d/dx(exp(x)) = exp(x) ..... ")
    if test_diff_exp() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    print("T5: product rule x*sin(x) ..... ")
    if test_product_rule() {
        println("PASS")
        passed = passed + 1
    } else {
        println("FAIL")
        failed = failed + 1
    }

    println("")
    print("Passed: ")
    println(passed)
    print("Failed: ")
    println(failed)

    if failed > 0 {
        println("SOME TESTS FAILED")
        return 1
    }
    println("ALL 5 TESTS PASSED")
    return 0
}
