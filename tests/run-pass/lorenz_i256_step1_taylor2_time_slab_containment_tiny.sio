//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-1 Taylor-2 time-slab containment keeps global claim mask closed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    let dx_bound: i64 = 0
    let dy_bound: i64 = 111669149696
    let dz_bound: i64 = 7158278826
    let selected_dt_den: i64 = 100
    let x_sweep: i64 = 0
    let y_sweep: i64 = 1116691497
    let z_sweep: i64 = 71582789

    if x_sweep * selected_dt_den < dx_bound { return 1 }
    if (y_sweep - 1) * selected_dt_den >= dy_bound { return 2 }
    if y_sweep * selected_dt_den < dy_bound { return 3 }
    if (z_sweep - 1) * selected_dt_den >= dz_bound { return 4 }
    if z_sweep * selected_dt_den < dz_bound { return 5 }

    let x_slab_margin: i64 = 1
    let y_slab_margin: i64 = 1116691600
    let z_slab_margin: i64 = 71582900
    let x_slack: i64 = x_slab_margin - x_sweep
    let y_slack: i64 = y_slab_margin - y_sweep
    let z_slack: i64 = z_slab_margin - z_sweep
    if x_slack != 1 { return 6 }
    if y_slack != 103 { return 7 }
    if z_slack != 111 { return 8 }

    var mask: i64 = 0
    if x_sweep <= x_slab_margin { mask = mask + 1 }
    if y_sweep <= y_slab_margin { mask = mask + 2 }
    if z_sweep <= z_slab_margin { mask = mask + 4 }
    if mask != 7 { return 9 }

    var inst: i64 = 1469
    inst = mix(inst, 1, 5297)
    inst = mix(inst, 473585568, 5297)
    inst = mix(inst, 790380830, 5297)
    inst = mix(inst, 44353214, 5297)
    inst = mix(inst, 431845922, 5297)
    inst = mix(inst, 265853299, 5297)
    inst = mix(inst, dx_bound, 5297)
    inst = mix(inst, dy_bound, 5297)
    inst = mix(inst, dz_bound, 5297)
    inst = mix(inst, 1, 5297)
    inst = mix(inst, selected_dt_den, 5297)
    inst = mix(inst, x_sweep, 5297)
    inst = mix(inst, y_sweep, 5297)
    inst = mix(inst, z_sweep, 5297)
    inst = mix(inst, x_slab_margin, 5297)
    inst = mix(inst, y_slab_margin, 5297)
    inst = mix(inst, z_slab_margin, 5297)
    inst = mix(inst, x_slack, 5297)
    inst = mix(inst, y_slack, 5297)
    inst = mix(inst, z_slack, 5297)
    inst = mix(inst, mask, 5297)
    inst = mix(inst, 7, 5297)
    inst = mix(inst, 0, 5297)
    inst = mix(inst, 13, 5297)
    if inst != 781293646 { return 10 }

    var cert: i64 = 1471
    cert = mix(cert, inst, 5303)
    cert = mix(cert, dx_bound, 5303)
    cert = mix(cert, dy_bound, 5303)
    cert = mix(cert, dz_bound, 5303)
    cert = mix(cert, 1, 5303)
    cert = mix(cert, selected_dt_den, 5303)
    cert = mix(cert, x_sweep, 5303)
    cert = mix(cert, y_sweep, 5303)
    cert = mix(cert, z_sweep, 5303)
    cert = mix(cert, x_slab_margin, 5303)
    cert = mix(cert, y_slab_margin, 5303)
    cert = mix(cert, z_slab_margin, 5303)
    cert = mix(cert, x_slack, 5303)
    cert = mix(cert, y_slack, 5303)
    cert = mix(cert, z_slack, 5303)
    cert = mix(cert, mask, 5303)
    cert = mix(cert, 7, 5303)
    cert = mix(cert, 0, 5303)
    cert = mix(cert, 13, 5303)
    cert = mix(cert, 255, 5303)
    if cert != 561666691 { return 11 }

    var artifact: i64 = 1481
    artifact = mix(artifact, inst, 5309)
    artifact = mix(artifact, cert, 5309)
    artifact = mix(artifact, 14, 5309)
    artifact = mix(artifact, 1, 5309)
    artifact = mix(artifact, mask, 5309)
    artifact = mix(artifact, 7, 5309)
    artifact = mix(artifact, 0, 5309)
    artifact = mix(artifact, 13, 5309)
    artifact = mix(artifact, 255, 5309)
    if artifact != 180607828 { return 12 }

    var audit: i64 = 1483
    audit = mix(audit, artifact, 5323)
    audit = mix(audit, inst, 5323)
    audit = mix(audit, cert, 5323)
    audit = mix(audit, 473585568, 5323)
    audit = mix(audit, 790380830, 5323)
    audit = mix(audit, 44353214, 5323)
    audit = mix(audit, 431845922, 5323)
    audit = mix(audit, 265853299, 5323)
    audit = mix(audit, 1, 5323)
    audit = mix(audit, 13, 5323)
    audit = mix(audit, 255, 5323)
    if audit != 551960823 { return 13 }
    return 0
}
