//@ run-pass
//@ description: PBPK28 tissue-composition priors carried as Knowledge<f64, ε> with
//@ literature evidence ε. The mechanistic lipid-composite term declared at the
//@ HONEST ceiling (with Epistemic(550), the weakest = phospholipid prior) compiles
//@ and runs; demanding Epistemic(560) is rejected (EpistemicComplete violation).
//@ Epistemic witness for stdlib/darwin_pbpk/core/tissue_composition.sio
//@ (dissertation Contribution 2). NOT a clinical engine — ε is evidence-quality.
//
// Mirrors tests/run-pass/dissertation_pbpk28_confidence_gate.sio: the stdlib
// module stores composition fractions + their ε as plain f64 (Madaros-safe);
// here they are wrapped as Knowledge<f64, ε> so the literature confidence flows
// into the compile-time gate.
//
// Tissue composition evidence ε (from tissue_composition.sio):
//   water (f_ew+f_iw)   ε=0.85  ICRP 89 reference man
//   neutral lipid (f_nl) ε=0.70  Poulin & Theil 2002
//   phospholipid (f_np)  ε=0.55  Rodgers & Rowland 2006   ← weakest → ceiling 550
//
// Liver (organ 1) fractions, copied from tissue_composition.sio::tc_comp(1):
//   f_nl = 0.0348, f_np = 0.0252

// Rodgers-Rowland neutral-partition lipid composite (f_nl + 0.3·f_np) for liver,
// with every input carrying its tissue-composition evidence ε. Epistemic(550)
// is the maximum this term may claim: the phospholipid prior (ε=0.55) is weakest.
fn tc_liver_lipid_composite() -> f64 with Epistemic(550), Mut, Div, Panic {
    let f_nl: Knowledge[f64] = Knowledge(0.0348, ε=0.70, prov="PoulinTheil2002_gravimetric");
    let f_np: Knowledge[f64] = Knowledge(0.0252, ε=0.55, prov="RodgersRowland2006_CVhigh");
    f_nl.value + 0.3 * f_np.value
}

fn main() with IO, Mut, Div, Panic, Epistemic {
    // The gated body compiled at the honest ceiling and runs: 0.0348 + 0.3·0.0252.
    println(tc_liver_lipid_composite());
    println("PBPK28_TISSUE_COMPOSITION_GATE_PASS");
}
