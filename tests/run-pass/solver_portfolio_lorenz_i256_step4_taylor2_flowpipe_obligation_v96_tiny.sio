    audit_fp = mix(audit_fp, 258802509, 5407)
    audit_fp = mix(audit_fp, 583092751, 5407)
    audit_fp = mix(audit_fp, 506674456, 5407)
    audit_fp = mix(audit_fp, 4, 5407)
    audit_fp = mix(audit_fp, 15, 5407)
    audit_fp = mix(audit_fp, 255, 5407)
    if audit_fp != 762477887 { return 2 }

    var entry_fp: i64 = 101
