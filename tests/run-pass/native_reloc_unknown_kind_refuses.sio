//@ run-pass
//@ requires: madaros
//@ expect-stdout: RELOC_UNKNOWN_KIND_REFUSES_OK
// apply_relocations_into (self-hosted/native/codegen_x86_linux.sio) patches
// kind codes 1-4. Any other kind used to fall through the chain silently: the
// rel32 site stayed at its placeholder and the ELF was still written, so the
// program jumped through garbage at run time. It must now latch
// reloc_overflow (every writer refuses with rc=20) and count the site in
// NC_RELOC_UNKNOWN_KIND_COUNT.
//
// No emitter produces an unknown kind, so no user program can reach the
// refusal; the self-test constructs the relocation directly. It also checks a
// control: a KNOWN kind on a site its shape check rejects is unchanged
// behaviour (no refusal), and compiler_new clears the counter.
use native::codegen_x86_linux::{native_v2_reloc_unknown_kind_selftest}

fn main() -> i32 with IO, Mut, Panic, Div, Alloc {
    if native_v2_reloc_unknown_kind_selftest() {
        println("RELOC_UNKNOWN_KIND_REFUSES_OK")
        return 0
    }
    println("RELOC_UNKNOWN_KIND_REFUSES_FAIL")
    1
}
