//@ run-pass
//@ expect-stdout: PERMUTATION_MC_FIGURE_PASS
//@ expect-stdout: MC q: Wilson 95%; top B=256; bottom B=2048
//@ expect-stdout: fill="rgb(80,180,240)"
use stats::permutation::{permutation_means}
use display::canvas::{Canvas,canvas_clear}
use viz::ir::{viz_scene_new,viz_layout_rect,viz_style_rgb,viz_add_forest_interval_plot,
 VIZ_INTERVAL_CONFIDENCE,viz_add_axis,viz_node_set_label}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO, Alloc, Mut, Div, Panic {
 var x:[f64;256]=[0.0;256]
 var y:[f64;256]=[0.0;256]
 x[0]=1.0; x[1]=2.0; x[2]=3.0
 y[0]=7.0; y[1]=8.0; y[2]=9.0
 let a=permutation_means(&x,3,&y,3,256,42,false)
 let b=permutation_means(&x,3,&y,3,2048,42,false)
 let exact=permutation_means(&x,3,&y,3,0,0,true)
 assert(a.status == 0 && b.status == 0 && exact.status == 0)
 assert(a.hits == 20 && b.hits == 195 && exact.hits == 2 && exact.draws == 20)
 assert(a.mc_available && b.mc_available && !exact.mc_available)
 var estimates:[f64;1024]=[0.0;1024]
 var lower:[f64;1024]=[0.0;1024]
 var upper:[f64;1024]=[0.0;1024]
 estimates[0]=(a.hits as f64)/(a.draws as f64)
 estimates[1]=(b.hits as f64)/(b.draws as f64)
 lower[0]=a.mc_lo; lower[1]=b.mc_lo
 upper[0]=a.mc_hi; upper[1]=b.mc_hi
 let lo=if a.mc_lo < b.mc_lo {a.mc_lo}else{b.mc_lo}
 let hi=if a.mc_hi > b.mc_hi {a.mc_hi}else{b.mc_hi}
 var scene=viz_scene_new()
 let forest=viz_add_forest_interval_plot(&!scene,&estimates,&lower,&upper,2,
  VIZ_INTERVAL_CONFIDENCE,0.95,viz_layout_rect(130,25,560,70),viz_style_rgb(80,180,240))
 assert(forest == 0)
 assert(scene.series[0].lower[0] == a.mc_lo && scene.series[0].upper[1] == b.mc_hi)
 let axis=viz_add_axis(&!scene,lo,hi,4,false,viz_layout_rect(130,110,560,1),viz_style_rgb(180,190,210))
 assert(axis == 1)
 var title:[i8;64]=[0;64]
 title[0]=77
 title[1]=67
 title[2]=32
 title[3]=113
 title[4]=58
 title[5]=32
 title[6]=87
 title[7]=105
 title[8]=108
 title[9]=115
 title[10]=111
 title[11]=110
 title[12]=32
 title[13]=57
 title[14]=53
 title[15]=37
 title[16]=59
 title[17]=32
 title[18]=116
 title[19]=111
 title[20]=112
 title[21]=32
 title[22]=66
 title[23]=61
 title[24]=50
 title[25]=53
 title[26]=54
 title[27]=59
 title[28]=32
 title[29]=98
 title[30]=111
 title[31]=116
 title[32]=116
 title[33]=111
 title[34]=109
 title[35]=32
 title[36]=66
 title[37]=61
 title[38]=50
 title[39]=48
 title[40]=52
 title[41]=56
 viz_node_set_label(&!scene,axis,&title,42)
 let pixels=heap_alloc(820*185*8) as *mut i64
 var canvas=Canvas{pixels:pixels,width:820,height:185}
 canvas_clear(&!canvas,0,0,0)
 viz_canvas_render_scene(&scene,&!canvas)
 // First Wilson interval establishes the displayed lower endpoint.
 assert(read_i64(canvas.pixels,36*820+130) != 0)
 viz_html_emit_scene(&scene,820,185)
 println("PERMUTATION_MC_FIGURE_PASS")
 0
}
