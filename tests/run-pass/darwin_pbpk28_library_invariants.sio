//@ run-pass
//@ expect-stdout-contains: PBPK28_LIBRARY_INVARIANTS_PASS
//@ timeout: 300
//
// Structural invariants of every PBPK28 parameter set in the library, and the
// moment-theory quantities they imply, measured without simulating. This is the
// re-runnable command behind docs/audit/PBPK28_LIBRARY_AUDIT_2026-11-08.md.
//
// Hard gates, per parameter set (14 organs x {vascular, interstitial} = 28
// compartments; blood has no tissue layer):
//   I1  v_ref[i] > 0 for all 14 organs.
//   I2  q[i] > 0 and ps[i] > 0 for every exchanging organ (i = 1..13). A tissue
//       layer with ps = 0 never exchanges and holds no drug (the lung PS = 0 of
//       the sedation-weaning morphine template broke exactly this).
//   I3  kp[i] > 0 for all 14 organs.
//   I4  vasc_frac[i] in [0, 1] for all 14 organs.
//   I5  V_ss = V_b + sum_i V_i*(fv_i + (1-fv_i)*Kp_i) over reachable layers is
//       finite and > V_b.
// Printed, NOT gated: V_ss, V_ss/CL (MRT) where cl_central > 0. Whether a V_ss
// matches a published value is a literature question, not an invariant; it is
// gated per drug where a verified reference exists (morphine, fentanyl tests).
// aripiprazole carries its elimination as organ sinks (cl_central = 0 by design),
// so no MRT is printed for it.
//
// Decision-support parity card (ADR009); no clinical-validity claim.

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::drugs::semaglutide::*
use darwin_pbpk::drugs::morphine::*
use darwin_pbpk::drugs::fentanyl::*
use darwin_pbpk::scenarios::clozapine_oral::*
use darwin_pbpk::scenarios::olanzapine_oral::*
use darwin_pbpk::scenarios::quetiapine_oral::*
use darwin_pbpk::scenarios::aripiprazole_oral::*
use darwin_pbpk::scenarios::lithium_oral::*
use darwin_pbpk::scenarios::tacrolimus_oral::*
use darwin_pbpk::scenarios::everolimus_des::*
use darwin_pbpk::scenarios::vancomycin_iv::*
use darwin_pbpk::scenarios::tirzepatide_sc_depot::*
use darwin_pbpk::scenarios::risperidone_oral::*

// Returns true when every invariant holds; prints one AUDIT line per set.
fn audit(name: string, p: PBPKParams28) -> bool with IO, Mut, Div, Panic {
    var good = true
    var vss = p.v_ref[0]
    var i: i32 = 0
    while i < 14 {
        if p.v_ref[i] <= 0.0 { print("  I1 FAIL v_ref organ ") println(i) good = false }
        if p.kp[i] <= 0.0 { print("  I3 FAIL kp organ ") println(i) good = false }
        if p.vasc_frac[i] < 0.0 || p.vasc_frac[i] > 1.0 { print("  I4 FAIL vasc_frac organ ") println(i) good = false }
        if i > 0 {
            if p.q[i] <= 0.0 { print("  I2 FAIL q organ ") println(i) good = false }
            if p.ps[i] <= 0.0 { print("  I2 FAIL ps organ ") println(i) good = false }
            let fv = p.vasc_frac[i]
            if p.ps[i] > 0.0 {
                vss = vss + p.v_ref[i] * (fv + (1.0 - fv) * p.kp[i])
            } else {
                vss = vss + p.v_ref[i] * fv
            }
        }
        i = i + 1
    }
    if !(vss > p.v_ref[0]) { println("  I5 FAIL V_ss not above V_b") good = false }
    print("AUDIT|") print(name)
    print("|Vss=") print(vss)
    print("|CL=") print(p.cl_central)
    print("|MRT=")
    if p.cl_central > 0.0 { println(vss / p.cl_central) } else { println("n/a") }
    return good
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("PBPK28_LIBRARY_INVARIANTS v1")
    var ok = true
    if !audit("clozapine", clz_pbpk28_params()) { ok = false }
    if !audit("olanzapine", olz_pbpk28_params()) { ok = false }
    if !audit("quetiapine", qtp_pbpk28_params()) { ok = false }
    if !audit("aripiprazole", arp_pbpk28_params()) { ok = false }
    if !audit("lithium", li_pbpk28_params()) { ok = false }
    if !audit("tacrolimus", tac_pbpk28_params()) { ok = false }
    if !audit("everolimus", evr_pbpk28_params()) { ok = false }
    if !audit("vancomycin", vnc_pbpk28_params()) { ok = false }
    if !audit("tirzepatide", tirz_pbpk28_params()) { ok = false }
    if !audit("risperidone_parent", rsp_parent_params()) { ok = false }
    if !audit("risperidone_9OH", rsp_oh9_params()) { ok = false }
    if !audit("rapamycin", pbpk28_params_rapamycin()) { ok = false }
    if !audit("venlafaxine_parent", pbpk28_params_venlafaxine_parent()) { ok = false }
    if !audit("venlafaxine_ODV", pbpk28_params_venlafaxine_odv()) { ok = false }
    if !audit("semaglutide_core", pbpk28_params_semaglutide()) { ok = false }
    if !audit("semaglutide_drugs", semaglutide_pbpk28_params()) { ok = false }
    if !audit("morphine", pbpk28_params_morphine()) { ok = false }
    if !audit("fentanyl", pbpk28_params_fentanyl()) { ok = false }
    if ok {
        println("PBPK28_LIBRARY_INVARIANTS_PASS")
        return 0
    }
    println("PBPK28_LIBRARY_INVARIANTS_FAIL")
    return 1
}
