//@ run-pass
//@ requires: madaros
//@ description: Scalar FRAT-to-LRAT elaboration envelope smoke

fn lrat_mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn frat_manifest_fingerprint(original_clause_count: i64,
                             add_count: i64,
                             delete_count: i64,
                             first_derived_id: i64,
                             final_clause_id: i64,
                             final_clause_len: i64) -> i64 with Mod {
    if original_clause_count != 3 { return 0 - 1 }
    if add_count != 2 { return 0 - 1 }
    if delete_count != 1 { return 0 - 1 }
    if first_derived_id != 4 { return 0 - 1 }
    if final_clause_id != 5 { return 0 - 1 }
    if final_clause_len != 0 { return 0 - 1 }

    var fp: i64 = 173
    fp = lrat_mix(fp, original_clause_count, 2309)
    fp = lrat_mix(fp, add_count, 2309)
    fp = lrat_mix(fp, delete_count, 2309)
    fp = lrat_mix(fp, first_derived_id, 2309)
    fp = lrat_mix(fp, final_clause_id, 2309)
    fp = lrat_mix(fp, final_clause_len, 2309)
    return fp
}

fn frat_hint_trace_fingerprint(manifest_fp: i64,
                               derived_unit_id: i64,
                               derived_empty_id: i64,
                               deleted_clause_id: i64,
                               unit_hint_count: i64,
                               empty_hint_count: i64,
                               rup_step_count: i64) -> i64 with Mod {
    if manifest_fp != 975208343 { return 0 - 1 }
    if derived_unit_id != 4 { return 0 - 1 }
    if derived_empty_id != 5 { return 0 - 1 }
    if deleted_clause_id != 2 { return 0 - 1 }
    if unit_hint_count != 2 { return 0 - 1 }
    if empty_hint_count != 2 { return 0 - 1 }
    if rup_step_count != 2 { return 0 - 1 }

    var fp: i64 = 181
    fp = lrat_mix(fp, manifest_fp, 2333)
    fp = lrat_mix(fp, derived_unit_id, 2333)
    fp = lrat_mix(fp, derived_empty_id, 2333)
    fp = lrat_mix(fp, deleted_clause_id, 2333)
    fp = lrat_mix(fp, unit_hint_count, 2333)
    fp = lrat_mix(fp, empty_hint_count, 2333)
    fp = lrat_mix(fp, rup_step_count, 2333)
    return fp
}

fn frat_unsat_envelope_fingerprint(manifest_fp: i64,
                                   hint_trace_fp: i64,
                                   final_clause_id: i64,
                                   final_clause_len: i64,
                                   lrat_empty_seen: i64) -> i64 with Mod {
    if manifest_fp != 975208343 { return 0 - 1 }
    if hint_trace_fp != 459486070 { return 0 - 1 }
    if final_clause_id != 5 { return 0 - 1 }
    if final_clause_len != 0 { return 0 - 1 }
    if lrat_empty_seen != 1 { return 0 - 1 }

    var fp: i64 = 191
    fp = lrat_mix(fp, manifest_fp, 2351)
    fp = lrat_mix(fp, hint_trace_fp, 2351)
    fp = lrat_mix(fp, final_clause_id, 2351)
    fp = lrat_mix(fp, final_clause_len, 2351)
    fp = lrat_mix(fp, lrat_empty_seen, 2351)
    return fp
}

fn main() -> i64 with Mod {
    let manifest_fp = frat_manifest_fingerprint(3, 2, 1, 4, 5, 0)
    if manifest_fp != 975208343 { return 1 }

    let hint_trace_fp = frat_hint_trace_fingerprint(
        manifest_fp, 4, 5, 2, 2, 2, 2)
    if hint_trace_fp != 459486070 { return 2 }

    let envelope_fp = frat_unsat_envelope_fingerprint(
        manifest_fp, hint_trace_fp, 5, 0, 1)
    if envelope_fp != 86860040 { return 3 }

    if frat_manifest_fingerprint(3, 2, 0, 4, 5, 0) != (0 - 1) { return 4 }
    if frat_manifest_fingerprint(3, 2, 1, 4, 5, 1) != (0 - 1) { return 5 }
    if frat_hint_trace_fingerprint(
        manifest_fp, 4, 5, 3, 2, 2, 2) != (0 - 1) { return 6 }
    if frat_hint_trace_fingerprint(
        manifest_fp, 4, 5, 2, 1, 2, 2) != (0 - 1) { return 7 }
    if frat_unsat_envelope_fingerprint(
        manifest_fp, hint_trace_fp, 5, 1, 1) != (0 - 1) { return 8 }
    if frat_unsat_envelope_fingerprint(
        manifest_fp, hint_trace_fp, 5, 0, 0) != (0 - 1) { return 9 }

    return 0
}
