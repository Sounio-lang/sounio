//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v28 LRAT deletion lifecycle receipt smoke

use theorem::portfolio::*

fn main() -> i64 with Mod {
    let instance_fp = solver_portfolio_v28_lrat_deletion_lifecycle_instance_fingerprint(
        3, 2, 2, 4, 5, 0)
    if instance_fp != 6950141 { return 1 }

    let certificate_fp = solver_portfolio_v28_lrat_deletion_lifecycle_certificate_fingerprint(
        instance_fp, 109354544, 5, 0, 2, 1)
    if certificate_fp != 9126320 { return 2 }

    let entry_fp = portfolio_entry_fingerprint(
        portfolio_kind_lrat_deletion_lifecycle(),
        instance_fp,
        certificate_fp,
        portfolio_result_unsat(),
        portfolio_checker_lrat_deletion_lifecycle())
    if entry_fp != 620031252 { return 3 }

    let manifest_fp = solver_portfolio_v28_lrat_deletion_lifecycle_bundle_fingerprint(
        6950141, 109354544)
    if manifest_fp != 380302392 { return 4 }

    let result_coverage_fp = solver_portfolio_v28_result_coverage_fingerprint(
        28, 32, 10, 20, 1, 1, manifest_fp)
    if result_coverage_fp != 184362635 { return 5 }

    let family_coverage_fp = solver_portfolio_v28_checker_family_coverage_fingerprint(
        28, 32, 6, 3, 2, 1, 20, manifest_fp)
    if family_coverage_fp != 644841534 { return 6 }

    let acceptance_fp = solver_portfolio_v28_acceptance_receipt_fingerprint(
        28, manifest_fp, result_coverage_fp)
    if acceptance_fp != 790802629 { return 7 }

    let audit_fp = solver_portfolio_v28_audit_receipt_fingerprint(
        28, manifest_fp, result_coverage_fp, family_coverage_fp, acceptance_fp)
    if audit_fp != 16072096 { return 8 }

    let readiness_fp = solver_portfolio_v28_readiness_fingerprint(
        28, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp)
    if readiness_fp != 413118064 { return 9 }

    if solver_portfolio_v28_lrat_deletion_lifecycle_bundle_fingerprint(
        6950141, 109354545) != (0 - 1) { return 10 }
    if solver_portfolio_v28_result_coverage_fingerprint(
        28, 32, 9, 20, 1, 1, manifest_fp) != (0 - 1) { return 11 }
    if solver_portfolio_v28_checker_family_coverage_fingerprint(
        28, 32, 5, 3, 2, 1, 20, manifest_fp) != (0 - 1) { return 12 }
    if solver_portfolio_v28_readiness_fingerprint(
        28, manifest_fp, result_coverage_fp, family_coverage_fp,
        acceptance_fp, audit_fp + 1) != (0 - 1) { return 13 }

    return 0
}
