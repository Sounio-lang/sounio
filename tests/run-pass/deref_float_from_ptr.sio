//@ run-pass
//@ requires: madaros
//@ expect-stdout: 100:102:102000007:102102007:200:201
// SIO-556: direct deref of a raw *mut f64 — via cast, via param, via
// struct-array-element field address arithmetic, and via a declared
// *mut f64 field read directly — yields the float.
struct Buf {
    ptr: *mut u8,
    len: i64,
}
struct FHold556 {
    p: *mut f64,
}
extern fn heap_alloc(n: i64) -> *mut u8
fn balloc(n: i64) -> Buf with Mut {
    Buf { ptr: heap_alloc(n * 8), len: n }
}
fn w64(b: &Buf, i: i64, v: f64) with Mut {
    let cell = ((b.ptr as i64) + i * 8) as *mut f64
    *cell = v
}
fn via_param(p: *mut f64) -> i64 {
    *p as i64
}
fn small(b: &![Buf; 4], k: i64) -> i64 with Mut {
    let f2 = *(((b[0].ptr as i64) + 16) as *mut f64) as i64
    f2 * 1000000 + k
}
fn bigd(a: &![i64; 4], b: &![Buf; 4], c: &![i64; 4], d: &![i64; 4], e: &![i64; 4], f: &![i64; 4], g: &![i64; 4], h: &![Buf; 8], k: &![i64; 8], l: &![i64; 8], m: i64) -> i64 with Mut {
    let f2 = *(((b[0].ptr as i64) + 16) as *mut f64) as i64
    a[0] + c[0] * 1000 + f2 * 1000000 + m
}
fn wfield(h: &!FHold556, v: f64) with Mut {
    *(h.p) = v
}
fn rfield(h: &FHold556) -> i64 {
    *(h.p) as i64
}
fn rarr(hs: &![FHold556; 2]) -> i64 {
    *(hs[1].p) as i64
}
fn main() -> i64 with IO, Mut {
    var z = balloc(1)
    var a: [i64; 4] = [7; 4]
    var b: [Buf; 4] = [z; 4]
    var c: [i64; 4] = [102; 4]
    var d: [i64; 4] = [0; 4]
    var e: [i64; 4] = [0; 4]
    var f: [i64; 4] = [0; 4]
    var g: [i64; 4] = [0; 4]
    var h: [Buf; 8] = [z; 8]
    var k: [i64; 8] = [5; 8]
    var l: [i64; 8] = [0; 8]
    var cp = balloc(4)
    var i: i64 = 0
    while i < 4 {
        w64(&cp, i, 100.0 + i as f64)
        i = i + 1
    }
    b[0] = cp
    let direct = *((cp.ptr as i64) as *mut f64) as i64
    let by_param = via_param(((cp.ptr as i64) + 16) as *mut f64)
    let sm = small(&!b, 7)
    let bg = bigd(&!a, &!b, &!c, &!d, &!e, &!f, &!g, &!h, &!k, &!l, 0)
    var fh0 = FHold556 { p: (heap_alloc(8) as i64) as *mut f64 }
    var fh1 = FHold556 { p: (heap_alloc(8) as i64) as *mut f64 }
    wfield(&!fh0, 200.0)
    wfield(&!fh1, 201.0)
    let rd = rfield(&fh0)
    var ha: [FHold556; 2] = [fh0, fh1]
    let ra = rarr(&!ha)
    print_int(direct)
    print(":")
    print_int(by_param)
    print(":")
    print_int(sm)
    print(":")
    print_int(bg)
    print(":")
    print_int(rd)
    print(":")
    print_int(ra)
    println("")
    return 0
}
