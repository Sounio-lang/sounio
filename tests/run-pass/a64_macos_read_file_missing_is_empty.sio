//@ run-pass
//@ description: read_file on a path that cannot be opened returns an empty string on every target (a64-macos once spun to the 4 MiB limit and exited 1: the Darwin svc error convention is carry + positive errno, not negative errno)
//@ expect-stdout: missing_len=0
//@ expect-stdout: after_missing_ok
fn main() with IO {
    let s = read_file("/nonexistent/sounio_a64_macos_read_file_missing_probe.sio")
    print("missing_len=")
    print_int(str_len(s))
    print("\n")
    println("after_missing_ok")
}
