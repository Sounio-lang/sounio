//@ run-pass
//@ expect-stdout: CONSUMED=1 OTHERS=0
//@ description: `(*c).f1.f2[i].f3 = v` stores through the pointer (#1495, defect 1)
//
// Two field hops before the index plus a trailing field. lean_single refused
// it with `error[E200]: undefined identifier consumed`: a second, stricter
// definition of stmt_is_deref_field_field_array_store (it matched any
// `(*p).f1.f2[`) shadowed the real one and routed this shape to the
// `(*p).f1.f2[i] = v` handler, which then read `consumed` as a value. This is
// the shape behind #1471, where the error was tolerated (#1494) and became a
// wild store.
struct E { consumed: bool, v: i64 }
struct B { entries: [E; 4], n: i64 }
struct C { k: i64, borrows: B }

fn mark(c: &!C, i: i64) with Mut {
    (*c).borrows.entries[i].consumed = true
}

fn main() -> i32 with IO, Mut {
    // Distinct element literals: a variable repeated in an array list literal
    // shares one element on both engines, which is a separate defect.
    var c = C { k: 1, borrows: B { entries: [E { consumed: false, v: 0 }, E { consumed: false, v: 1 }, E { consumed: false, v: 2 }, E { consumed: false, v: 3 }], n: 4 } }
    mark(&!c, 2)
    var others: i64 = 0
    if c.borrows.entries[0].consumed { others = others + 1 }
    if c.borrows.entries[3].consumed { others = others + 1 }
    if c.borrows.entries[2].consumed { print("CONSUMED=1") } else { print("CONSUMED=0") }
    print(" OTHERS=")
    print_int(others)
    print("\n")
    return 0
}
