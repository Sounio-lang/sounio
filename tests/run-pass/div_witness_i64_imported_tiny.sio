//@ run-pass
//@ description: Imported theorem::div_witness i64 quotient/remainder smoke

use theorem::div_witness::*

fn main() -> i64 with Mod {
    let ok0 = div_witness_check_i64(100, 7, 14, 2)
    let ok1 = div_witness_check_i64(100, 11, 9, 1)
    let ok2 = div_witness_check_i64(1000, 8, 125, 0)
    let bundle_fp = div_witness_pack3_fingerprint(
        64, 14, 2, 9, 1, 125, 0, ok0, ok1, ok2)

    if ok0 != 1 { return 1 }
    if ok1 != 1 { return 2 }
    if ok2 != 1 { return 3 }
    if div_witness_all3(ok0, ok1, ok2) != 1 { return 4 }
    if bundle_fp != 963466398 { return 5 }

    if div_witness_check_i64(100, 7, 14, 3) != 0 { return 6 }
    if div_witness_check_i64(100, 7, 15, 2) != 0 { return 7 }
    if div_witness_check_i64(100, 0, 14, 2) != 0 { return 8 }
    if div_witness_check_i64(100, 7, 14, 7) != 0 { return 9 }
    if div_witness_pack3_fingerprint(
        64, 14, 2, 9, 1, 125, 0, ok0, 0, ok2) != (0 - 1) { return 10 }

    return 0
}
