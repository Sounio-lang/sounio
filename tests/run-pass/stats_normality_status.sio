//@ run-pass
//@ expect-stdout: STATS_NORMALITY_STATUS_PASS
use stats::normality::{normality,run_tests}
fn main() with IO,Mut,Div,Panic {
 assert(run_tests())
 var x:[f64;256]=[2.0;256]
 let a=normality(&x,0)
 assert(a.status==1 && a.p==0.0)
 let b=normality(&x,257)
 assert(b.status==1)
 let c=normality(&x,256)
 assert(c.status==3 && c.p==0.0 && c.asymptotic)
 x[3]=1.0e308*2.0
 let d=normality(&x,4)
 assert(d.status==2 && d.p==0.0)
 x[3]=0.0/0.0
 let e=normality(&x,4)
 assert(e.status==2)
 let f=normality(&x,2)
 assert(f.status==3)
 x[1]=3.0
 let g=normality(&x,2)
 assert(g.status==0 && g.n==2 && g.asymptotic)
 println("STATS_NORMALITY_STATUS_PASS")
 0
}
