//@ run-pass
struct Point { x: i64, y: i64 }
struct Color { r: i64, g: i64, b: i64 }

fn main() -> i32 with IO, Panic {
    let p = Point { x: 3, y: 4 }
    let Point { x, y } = p
    assert(x == 3)
    assert(y == 4)

    let c = Color { r: 255, g: 128, b: 0 }
    let Color { r, g, b } = c
    assert(r == 255)
    assert(g == 128)
    assert(b == 0)

    print("struct_pattern_destructure: PASS\n")
    0
}
