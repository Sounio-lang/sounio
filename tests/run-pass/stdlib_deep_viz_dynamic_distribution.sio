//@ run-pass
//@ requires: madaros
//@ expect-stdout: STDLIB_DEEP_VIZ_DYNAMIC_DISTRIBUTION_PASS
//@ expect-stdout: data-height-kind="count"
//@ expect-stdout: data-quantile-method="7"
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_close}
use collections::integer_buffer::{integer_buffer_new,integer_buffer_set,integer_buffer_close}
use display::canvas::{Canvas,canvas_clear}
use viz::dynamic_plot::{DynamicPlotSpec}
use viz::dynamic_distribution_plot::{DynamicBoxPolicy,dynamic_histogram_canvas,dynamic_histogram_svg,dynamic_box_canvas,dynamic_box_svg}
fn histogram(c:&!Canvas) with IO,Alloc,Mut,Div,Panic {
 var edges=numeric_buffer_new(6,48);var heights=numeric_buffer_new(5,40);var mask=integer_buffer_new(5,40)
 let ev:[f64;6]=[-1.0,0.0,1.0,3.0,4.0,6.0];let hv:[f64;5]=[2.0,0.0,3.0,0.0,1.0]
 var i:i64=0
 while i<6 {let a=numeric_buffer_set(&!edges,i,ev[i as usize]);i=i+1}
 i=0
 while i<5 {let a=numeric_buffer_set(&!heights,i,hv[i as usize]);let b=integer_buffer_set(&!mask,i,if i==3 {0}else{1});i=i+1}
 let nan=0.0/0.0;let ignored=numeric_buffer_set(&!heights,3,nan)
 let spec=DynamicPlotSpec{x:20,y:20,w:100,h:80,xmin:0.0,xmax:5.0,ymin:0.0,ymax:4.0,r:70,g:180,b:235,interval_kind:0,level:0.0}
 let drawn=dynamic_histogram_canvas(c,&spec,&edges,&heights,&mask,1)
 assert(drawn.status==0 && drawn.painted==2 && drawn.empty==2 && drawn.masked==1)
 let emitted=dynamic_histogram_svg(&spec,&edges,&heights,&mask,1)
 assert(emitted.status==0 && emitted.painted==2)
 let invalid=numeric_buffer_set(&!heights,4,-1.0)
 let failed=dynamic_histogram_canvas(c,&spec,&edges,&heights,&mask,1)
 assert(failed.status==3 && failed.painted==0)
 let failed_svg=dynamic_histogram_svg(&spec,&edges,&heights,&mask,1)
 assert(failed_svg.status==3 && failed_svg.painted==0)
 numeric_buffer_close(edges);numeric_buffer_close(heights);integer_buffer_close(mask)
}
fn boxes(c:&!Canvas) with IO,Alloc,Mut,Div,Panic {
 var group=numeric_buffer_new(3,24);var q1=numeric_buffer_new(3,24);var median=numeric_buffer_new(3,24)
 var q3=numeric_buffer_new(3,24);var lo=numeric_buffer_new(3,24);var hi=numeric_buffer_new(3,24)
 var mask=integer_buffer_new(3,24)
 let a1:[f64;3]=[1.0,3.0,7.0];let mv:[f64;3]=[2.0,4.0,7.5];let a3:[f64;3]=[3.0,5.0,8.0]
 let lv:[f64;3]=[-2.0,1.0,6.0];let uv:[f64;3]=[4.0,7.0,10.0]
 var i:i64=0
 while i<3 {
  let a=numeric_buffer_set(&!group,i,i as f64);let b=numeric_buffer_set(&!q1,i,a1[i as usize]);let d=numeric_buffer_set(&!median,i,mv[i as usize])
  let e=numeric_buffer_set(&!q3,i,a3[i as usize]);let f=numeric_buffer_set(&!lo,i,lv[i as usize]);let g=numeric_buffer_set(&!hi,i,uv[i as usize])
  let h=integer_buffer_set(&!mask,i,1)
  i=i+1
 }
 let spec=DynamicPlotSpec{x:160,y:20,w:100,h:80,xmin:0.0,xmax:2.0,ymin:0.0,ymax:8.0,r:230,g:120,b:40,interval_kind:0,level:0.0}
 let policy=DynamicBoxPolicy{width:16,quantile_method:7,whisker_policy:2}
 let drawn=dynamic_box_canvas(c,&spec,&policy,&group,&q1,&median,&q3,&lo,&hi,&mask)
 assert(drawn.status==0 && drawn.painted==3 && drawn.masked==0)
 let emitted=dynamic_box_svg(&spec,&policy,&group,&q1,&median,&q3,&lo,&hi,&mask)
 assert(emitted.status==0 && emitted.painted==3)
 let changed=numeric_buffer_set(&!q1,0,0.5)
 let invalid=numeric_buffer_set(&!q3,2,6.0)
 let failed=dynamic_box_canvas(c,&spec,&policy,&group,&q1,&median,&q3,&lo,&hi,&mask)
 assert(failed.status==3 && failed.painted==0)
 let failed_svg=dynamic_box_svg(&spec,&policy,&group,&q1,&median,&q3,&lo,&hi,&mask)
 assert(failed_svg.status==3 && failed_svg.painted==0)
 numeric_buffer_close(group);numeric_buffer_close(q1);numeric_buffer_close(median);numeric_buffer_close(q3);numeric_buffer_close(lo);numeric_buffer_close(hi);integer_buffer_close(mask)
}
fn main() with IO,Alloc,Mut,Div,Panic {
 let pixels=heap_alloc(300*130*8) as *mut i64
 assert((pixels as i64)>0)
 var canvas=Canvas{pixels:pixels,width:300,height:130}
 canvas_clear(&!canvas,0,0,0)
 println("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"300\" height=\"130\" viewBox=\"0 0 300 130\">")
 histogram(&!canvas);boxes(&!canvas)
 println("</svg>")
 var y:i64=0
 while y<130 {
  var x:i64=0
  while x<300 {
   let color:i64=read_i64(canvas.pixels,y*300+x)
   if color!=0 {print("DISTRIBUTION_PIXEL ");print(x);print(" ");print(y);print(" ");println(color)}
   x=x+1
  }
  y=y+1
 }
 heap_free(canvas.pixels as *mut i8)
 println("STDLIB_DEEP_VIZ_DYNAMIC_DISTRIBUTION_PASS")
}
