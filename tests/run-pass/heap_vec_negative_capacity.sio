//@ run-pass
//@ requires: madaros
//@ expect-stdout: NEG_CAP_OK
// with_capacity(cap) for a non-positive cap now normalizes to the same empty
// state new() uses, matching the doubling growth path's own zero-cap check
// (`if self.cap == 0 { new_cap = 4 } else { new_cap = self.cap * 2 }`) instead
// of letting a negative cap survive into the struct, where len(0) >= a
// negative cap is already true and the very first push() takes the growth
// branch with whatever heap_alloc(cap*8) produced for a negative byte count.

use collections::heap_vec::*;

fn main() -> i32 with IO, Alloc, Mut, Panic, Div {
    var v = HeapVec::<i64>::with_capacity(0 - 5)
    if v.cap() != 0 { print("FAIL: negative cap not normalized to 0\n"); return 1 }
    v.push(1)
    v.push(2)
    v.push(3)
    if v.get(0) != 1 { print("FAIL get(0)\n"); return 1 }
    if v.get(1) != 2 { print("FAIL get(1)\n"); return 1 }
    if v.get(2) != 3 { print("FAIL get(2)\n"); return 1 }
    if v.len() != 3 { print("FAIL len\n"); return 1 }
    v.free()

    var vi = heap_i64_vec_with_capacity(0 - 1)
    if vi.cap() != 0 { print("FAIL: HeapI64Vec negative cap not normalized\n"); return 1 }
    heap_i64_vec_push(&! vi, 7)
    if heap_i64_vec_get(&vi, 0) != 7 { print("FAIL HeapI64Vec after normalize\n"); return 1 }
    heap_i64_vec_free(&! vi)

    var vf = heap_f64_vec_with_capacity(0 - 1)
    if vf.cap() != 0 { print("FAIL: HeapF64Vec negative cap not normalized\n"); return 1 }
    heap_f64_vec_push(&! vf, 2.5)
    if heap_f64_vec_get(&vf, 0) != 2.5 { print("FAIL HeapF64Vec after normalize\n"); return 1 }
    heap_f64_vec_free(&! vf)

    print("NEG_CAP_OK\n")
    return 0
}
