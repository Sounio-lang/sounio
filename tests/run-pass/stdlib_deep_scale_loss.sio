//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: STDLIB_DEEP_SCALE_LOSS_PASS
use linalg::least_squares::{qr_least_squares}
use collections::numeric_buffer::{numeric_buffer_new,numeric_buffer_set,numeric_buffer_at,numeric_buffer_close,numeric_matrix}
use linalg::dynamic_least_squares::{dynamic_qr_workspace,dynamic_qr_least_squares}
fn main()->i32 with IO, Alloc, Mut, Div, Panic {
    var a:[f64;2048]=[0.0;2048]
    var b:[f64;256]=[0.0;256]
    // Exactly known solution x=(1,1); finite inputs with incompatible RHS scales.
    a[0]=1.0e200
    a[9]=1.0e-200
    b[0]=a[0]
    b[1]=a[9]
    let old=qr_least_squares(&a,&b,2,2,0.0)
    assert(old.status==4)
    var da=numeric_buffer_new(4,32)
    var db=numeric_buffer_new(2,16)
    var dx=numeric_buffer_new(2,16)
    let need=dynamic_qr_workspace(2,2)
    var work=numeric_buffer_new(need,need*8)
    numeric_buffer_set(&!da,0,1.0e200)
    numeric_buffer_set(&!da,3,1.0e-200)
    numeric_buffer_set(&!db,0,1.0e200)
    numeric_buffer_set(&!db,1,1.0e-200)
    numeric_buffer_set(&!dx,0,99.0)
    numeric_buffer_set(&!dx,1,99.0)
    let layout=numeric_matrix(4,2,2,2,1,0)
    let fit=dynamic_qr_least_squares(&da,&layout,&db,&!dx,&!work,0.0)
    assert(fit.status==4)
    assert(numeric_buffer_at(&dx,0)==99.0 && numeric_buffer_at(&dx,1)==99.0)
    numeric_buffer_close(da)
    numeric_buffer_close(db)
    numeric_buffer_close(dx)
    numeric_buffer_close(work)
    print("STDLIB_DEEP_SCALE_LOSS_PASS\n")
    return 0
}
