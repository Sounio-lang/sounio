//@ run-pass
//@ requires: madaros
//@ expect-stdout-contains: KNIGHT_BOTTOM_PASS

fn accept(x: Knowledge[f64, ε=⊥]) -> Knowledge[f64, ε=⊥] {
    x
}

fn main() -> i64 with IO, Epistemic {
    let x = accept(knight("k", 0.0, 1.0))
    let precise = accept(measure(10.0, uncertainty: 0.1))
    if x.iv.0 != 0.0 || x.iv.1 != 1.0 { return 1 }
    if precise.variance < 0.0099 || precise.variance > 0.0101 { return 1 }
    println("KNIGHT_BOTTOM_PASS")
    0
}
