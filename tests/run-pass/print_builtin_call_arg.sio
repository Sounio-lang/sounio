//@ run-pass
//@ requires: madaros
//@ expect-stdout: 1.414214
//@ expect-stdout: 2.000000
// SIO-206: passing a builtin call directly as a print argument used to
// fail lowering with "unresolved scalar kind" (Madaros v0.80.0); only a
// `let s: f64` temporary worked around it. Fixed incidentally after
// v0.80.0 (sibling of #2354); this test locks the acceptance -- builtin
// calls as print/println arguments compile and print the right values.
fn main() -> i64 with IO, Mut, Div, Panic {
    let x: f64 = 2.0
    print(sqrt(x))
    print("\n")
    println(sqrt(4.0))
    return 0
}
