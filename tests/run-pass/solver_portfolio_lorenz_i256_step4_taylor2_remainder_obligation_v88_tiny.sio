//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v88 smoke for Lorenz i256 step-4 Taylor-2 remainder obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1831
    receipt_fp = mix(receipt_fp, 700260810, 5801)
    receipt_fp = mix(receipt_fp, 747893368, 5801)
    receipt_fp = mix(receipt_fp, 950328729, 5801)
    receipt_fp = mix(receipt_fp, 922054061, 5801)
    receipt_fp = mix(receipt_fp, 249654257, 5801)
    receipt_fp = mix(receipt_fp, 370584026, 5801)
    receipt_fp = mix(receipt_fp, 322940586, 5801)
    receipt_fp = mix(receipt_fp, 749342117, 5801)
    receipt_fp = mix(receipt_fp, 185341710, 5801)
    receipt_fp = mix(receipt_fp, 4, 5801)
    receipt_fp = mix(receipt_fp, 5, 5801)
    receipt_fp = mix(receipt_fp, 127, 5801)
    if receipt_fp != 526525910 { return 1 }

    var audit_fp: i64 = 1837
    audit_fp = mix(audit_fp, receipt_fp, 5807)
    audit_fp = mix(audit_fp, 700260810, 5807)
    audit_fp = mix(audit_fp, 747893368, 5807)
    audit_fp = mix(audit_fp, 950328729, 5807)
    audit_fp = mix(audit_fp, 922054061, 5807)
    audit_fp = mix(audit_fp, 749342117, 5807)
    audit_fp = mix(audit_fp, 185341710, 5807)
    audit_fp = mix(audit_fp, 322940586, 5807)
    audit_fp = mix(audit_fp, 4, 5807)
    audit_fp = mix(audit_fp, 5, 5807)
    audit_fp = mix(audit_fp, 127, 5807)
    if audit_fp != 109012640 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 91, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 91, 1103)
    if entry_fp != 347927442 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 88, 1151)
    manifest_fp = mix(manifest_fp, 92, 1151)
    manifest_fp = mix(manifest_fp, 370584026, 1151)
    manifest_fp = mix(manifest_fp, 249654257, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 2529965 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 88, 1871)
    result_fp = mix(result_fp, 92, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 80, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 587724229 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 88, 1907)
    family_fp = mix(family_fp, 92, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 75, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 414963455 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 88, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 229944247 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 88, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 782243093 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 88, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 328442325 { return 9 }
    return 0
}
