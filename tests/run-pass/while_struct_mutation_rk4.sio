//@ run-pass
// Regression test: RK4 integrator with nested struct returns in while loop
// 480 steps of a 3-compartment model using Runge-Kutta 2nd order

struct Conc {
    gut: f64,
    liver: f64,
    central: f64
}

struct StepResult {
    state: Conc,
    dt_used: f64
}

fn rk2_step(s: Conc, dt: f64) -> StepResult {
    // k1 derivatives
    let k1_gut = -1.0 * s.gut
    let k1_liver = 0.5 * s.gut - 0.3 * s.liver
    let k1_central = 0.3 * s.liver - 0.1 * s.central

    // k2 at midpoint
    let mid_gut = s.gut + 0.5 * dt * k1_gut
    let mid_liver = s.liver + 0.5 * dt * k1_liver
    let mid_central = s.central + 0.5 * dt * k1_central
    let k2_gut = -1.0 * mid_gut
    let k2_liver = 0.5 * mid_gut - 0.3 * mid_liver
    let k2_central = 0.3 * mid_liver - 0.1 * mid_central

    StepResult {
        state: Conc {
            gut: s.gut + dt * k2_gut,
            liver: s.liver + dt * k2_liver,
            central: s.central + dt * k2_central
        },
        dt_used: dt
    }
}

fn main() -> i32 with IO, Div, Mut {
    var s = Conc { gut: 500.0, liver: 0.0, central: 0.0 }
    let dt = 0.05
    var t = 0.0
    var i = 0

    while i < 480 {
        let result = rk2_step(s, dt)
        s = result.state
        t = t + result.dt_used
        i = i + 1
    }

    // After 24h: gut fully absorbed
    if s.gut > 1.0 { return 1 }
    // Time should be 24.0
    if t < 23.0 { return 2 }
    // 480 iterations completed
    if i != 480 { return 3 }

    return 0
}
