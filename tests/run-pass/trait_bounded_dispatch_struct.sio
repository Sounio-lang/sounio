//@ run-pass
// Acceptance test 2 for compiler prerequisite #3 (trait-bounded generic method dispatch).
// Tests trait-bounded dispatch with struct type parameter.
// Expected output: 35, then "struct PASS"

struct Frac {
    num: i64,
    den: i64,
}

trait R {
    fn radd(self, o: Self) -> Self
}

impl R for Frac {
    fn radd(self, o: Self) -> Self {
        Frac {
            num: self.num * o.den + o.num * self.den,
            den: self.den * o.den,
        }
    }
}

fn use2<F: R>(a: F, b: F) -> F {
    a.radd(b)
}

fn main() with IO {
    let f1 = Frac { num: 1, den: 2 }
    let f2 = Frac { num: 3, den: 4 }
    let result = use2::<Frac>(f1, f2)
    println(result.num)
    println("struct PASS")
}
