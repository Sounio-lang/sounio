//@ run-pass
//@ expect-stdout: MATH_PURE_EXP_FULL_RANGE_OK
// #846: math::pure::exp is the one exp every stdlib helper now delegates to,
// so it must be right over the whole f64 range, not only near 0.
//
// Reference values are C++23 std::exp (glibc libm, correctly rounded to
// < 1 ulp), printed with %.17g. Tolerance: 1e-14 relative.
//
// Before #846 math::pure::exp clamped |x| > 500 (exp(700) returned 1.0e200,
// exp(-700) returned 0), so the +-700 and +-500 rows failed on both engines.
use math::pure::{exp}

fn rel_err(a: f64, b: f64) -> f64 {
    let d = a - b
    let ad = if d < 0.0 { 0.0 - d } else { d }
    let ab = if b < 0.0 { 0.0 - b } else { b }
    ad / ab
}

fn rel_check(x: f64, want: f64) -> i64 with IO, Mut, Div, Panic {
    let got = exp(x)
    let e = rel_err(got, want)
    if e <= 1.0e-14 { return 0 }
    print("EXP_MISMATCH x=")
    print_f64(x)
    print(" rel_err*1e14=")
    print_f64(e * 1.0e14)
    print("\n")
    return 1
}

fn main() -> i32 with IO, Mut, Div, Panic {
    var fails: i64 = 0
    fails = fails + rel_check(0.0 - 700.0, 9.8596765437597708e-305)
    fails = fails + rel_check(0.0 - 500.0, 7.1245764067412855e-218)
    fails = fails + rel_check(0.0 - 100.0, 3.7200759760208361e-44)
    fails = fails + rel_check(0.0 - 50.0, 1.9287498479639178e-22)
    fails = fails + rel_check(0.0 - 30.0, 9.3576229688401748e-14)
    fails = fails + rel_check(0.0 - 20.0, 2.0611536224385579e-09)
    fails = fails + rel_check(0.0 - 15.0, 3.0590232050182579e-07)
    fails = fails + rel_check(0.0 - 13.855, 9.6128010309800673e-07)
    fails = fails + rel_check(0.0 - 10.0, 4.5399929762484854e-05)
    fails = fails + rel_check(0.0 - 5.0, 0.006737946999085467)
    fails = fails + rel_check(0.0 - 1.0, 0.36787944117144233)
    fails = fails + rel_check(0.0 - 0.5, 0.60653065971263342)
    fails = fails + rel_check(0.0 - 1e-08, 0.99999999000000006)
    fails = fails + rel_check(0.0, 1.0)
    fails = fails + rel_check(1e-08, 1.0000000099999999)
    fails = fails + rel_check(0.5, 1.6487212707001282)
    fails = fails + rel_check(1.0, 2.7182818284590451)
    fails = fails + rel_check(2.5, 12.182493960703473)
    fails = fails + rel_check(5.0, 148.4131591025766)
    fails = fails + rel_check(10.0, 22026.465794806718)
    fails = fails + rel_check(13.855, 1040279.5155930172)
    fails = fails + rel_check(20.0, 485165195.40979028)
    fails = fails + rel_check(30.0, 10686474581524.463)
    fails = fails + rel_check(50.0, 5.184705528587072e+21)
    fails = fails + rel_check(100.0, 2.6881171418161356e+43)
    fails = fails + rel_check(500.0, 1.4035922178528375e+217)
    fails = fails + rel_check(700.0, 1.0142320547350045e+304)
    fails = fails + rel_check(709.0, 8.2184074615549724e+307)
    // exp(-13.855) is the #841/#846 witness argument.
    // Overflow / underflow / NaN edges.
    let big = exp(710.0)
    if big < 1.0e308 { print("EXP_OVERFLOW_NOT_INF\n"); fails = fails + 1 }
    if exp(0.0 - 746.0) != 0.0 { print("EXP_UNDERFLOW_NOT_ZERO\n"); fails = fails + 1 }
    let z = 0.0
    let nan = z / z
    let en = exp(nan)
    if en == en { print("EXP_NAN_NOT_NAN\n"); fails = fails + 1 }
    if fails == 0 {
        print("MATH_PURE_EXP_FULL_RANGE_OK\n")
        return 0
    }
    print("MATH_PURE_EXP_FULL_RANGE_FAIL\n")
    return 1
}
