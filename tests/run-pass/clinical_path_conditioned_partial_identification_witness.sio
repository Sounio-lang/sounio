//@ check-only
// Imported API conformance for path-conditioned partial identification D8.

use epistemic::proof_carrying_rebracketing_protocol::*
use epistemic::proof_carrying_path_conditioned_identification::*

fn main() with Panic {
    // D7 construction is intentionally public and unsealed. D8 consumes the
    // nominal type only to record that its fixture-bound decision cannot be
    // reused for the new D8 occurrence.
    let d7_decision = LocalRebracketingEqualityDecisionReceipt {
        decision_id: 10201,
        request_id: 10101,
        protocol_id: 8700,
        fixture_occurrence_id: 11001,
        operator_id: 9801,
        a_atom_id: 9101,
        b_atom_id: 9102,
        c_atom_id: 9103,
        source_tree_fingerprint: 9037326,
        target_tree_fingerprint: 573396,
        source_result_code: 93767706,
        target_result_code: 93767706,
        evidence_control_id: 9702,
        decision_audit_checksum: 322833,
        exact_equal_on_frozen_occurrence: true,
        same_typed_operands: true,
        same_ordered_operands: true,
        same_operator: true,
        both_trees_defined: true,
        exact_ordered_atom_ids_carried: true,
        fixture_occurrence_bound: true,
        reusable_across_occurrences: false,
        model_equality_decision_only: true,
        public_model_receipt: true,
        receipt_construction_sealed: false,
        universal_associativity_law_established: false,
        compiler_operator_admission_evidence_supplied: false,
        compiler_capability_bound: false,
        native_contest_carrier_established: false,
    }
    let d7_refusal = refuse_d7_cross_occurrence_reuse(
        11901, 17001, d7_decision,
    )
    assert(d7_refusal.d7_decision_id == 10201)
    assert(d7_refusal.d7_bound_fixture_occurrence_id == 11001)
    assert(d7_refusal.requested_d8_occurrence_id == 17001)
    assert(d7_refusal.reason_mask == 3)
    assert(d7_refusal.refusal_audit_checksum == 2175470118)
    assert(d7_refusal.d7_local_equality_preserved)
    assert(d7_refusal.cross_occurrence_reuse_refused)
    assert(!d7_refusal.d8_rebracketing_performed)
    assert(!d7_refusal.path_order_substitution_authorized)
    assert(!d7_refusal.compiler_authority_issued)

    let state_a = declare_d8_latent_state(12001, 1)
    let state_b = declare_d8_latent_state(12002, 2)
    let state_c = declare_d8_latent_state(12003, 3)
    assert(state_a.scalar_projection == 877)
    assert(state_b.scalar_projection == 877)
    assert(state_c.scalar_projection == 877)
    assert(state_a.state_id != state_b.state_id)
    assert(state_b.state_id != state_c.state_id)

    let scalar = record_scalar_projection_collision(
        12400, state_a, state_b, state_c,
    )
    assert(scalar.scalar_value == 877)
    assert(scalar.compatible_state_mask == 7)
    assert(scalar.compatible_state_count == 3)
    assert(!scalar.observation_is_state)
    assert(!scalar.unique_state_identified)
    let collision = certify_projection_collision(
        11902, scalar, state_a, state_b, state_c,
    )
    assert(collision.collision_mask == 7 && collision.compatible_state_count == 3)
    assert(collision.state_family_fingerprint == 11917026)
    assert(collision.collision_audit_checksum == 369428683)
    assert(!collision.scalar_identifies_state)

    let history_ab = declare_ordered_history_ab(12101)
    let history_ba = declare_ordered_history_ba(12102)
    assert(history_ab.path_code == 1 && history_ab.history_fingerprint == 448033)
    assert(history_ba.path_code == 2 && history_ba.history_fingerprint == 448063)
    let context = declare_individual_context(12150)
    assert(context.individual_context && !context.dyadic_context)
    assert(context.synthetic_context)
    let model = declare_path_conditioned_finite_model(
        12200, context, history_ab, history_ba, collision, d7_refusal,
    )
    assert(model.protocol_id == 8800 && model.model_version == 1)
    assert(model.universe_mask == 7 && model.universe_count == 3)
    assert(model.model_audit_checksum == 11728748010)
    assert(model.path_conditioning_enabled)
    assert(!model.histories_interchangeable)
    assert(model.d7_cross_occurrence_reuse_refused)
    assert(model.public_model_receipt && !model.receipt_construction_sealed)
    assert(!model.empirical_adequacy_established && !model.clinical_authority)

    let ab = identify_exact_ab_set(12301, model, history_ab)
    let ba = identify_exact_ba_set(12302, model, history_ba)
    assert(ab.member_mask == 3 && ab.member_count == 2)
    assert(ba.member_mask == 6 && ba.member_count == 2)
    assert(ab.set_audit_checksum == 25710287)
    assert(ba.set_audit_checksum == 25712181)
    assert(ab.exact_within_frozen_family && ba.exact_within_frozen_family)
    assert(ab.sound_outer && ba.sound_outer)
    assert(ab.witnessed_inner && ba.witnessed_inner)
    assert(!ab.heuristic && !ba.heuristic)
    assert(!ab.point_identified && !ba.point_identified)
    assert(!ab.confidence_region && !ba.confidence_region)
    assert(!ab.predictive_set && !ba.predictive_set)

    let compatibility = witness_initial_exact_compatibility(12701, ab, ba, state_b)
    assert(compatibility.common_state_id == 12002)
    assert(compatibility.exact_intersection_mask == 2)
    assert(compatibility.compatibility_audit_checksum == 378653377)
    assert(compatibility.common_member_witnessed && compatibility.exact_sets_overlap)
    assert(!compatibility.guaranteed_separation)
    let initial_refusal = refuse_initial_exact_separation(12702, compatibility)
    assert(initial_refusal.reason_mask == 3)
    assert(initial_refusal.refusal_audit_checksum == 2650573642)
    assert(initial_refusal.nonempty_intersection_observed)
    assert(initial_refusal.common_member_witnessed)
    assert(!initial_refusal.guaranteed_separation_issued)

    let ab_outer = forget_ab_exactness_to_sound_outer(12801, ab)
    let ba_outer = forget_ba_exactness_to_sound_outer(12802, ba)
    assert(ab_outer.member_mask == 3 && ba_outer.member_mask == 6)
    assert(ab_outer.sound_outer && ba_outer.sound_outer)
    assert(!ab_outer.exactness_retained && !ba_outer.exactness_retained)
    assert(!ab_outer.witnessed_inner && !ba_outer.witnessed_inner)
    let inner = witness_common_member_inner(12804, compatibility)
    assert(inner.witnessed_member_mask == 2 && inner.witnessed_state_id == 12002)
    assert(inner.inner_audit_checksum == 11738267491)
    assert(inner.witnessed_inner && !inner.complete_identified_set_claimed)
    let outer_undecided = record_outer_overlap_as_undecided(
        12803, ab_outer, ba_outer,
    )
    assert(outer_undecided.outer_intersection_mask == 2)
    assert(outer_undecided.admissible_completion_pair_count == 9)
    assert(outer_undecided.overlapping_completion_pair_count == 4)
    assert(outer_undecided.disjoint_completion_pair_count == 5)
    assert(outer_undecided.undecided_audit_checksum == 12090976311463)
    assert(outer_undecided.outer_overlap_observed)
    assert(!outer_undecided.real_overlap_certified)
    assert(!outer_undecided.real_separation_certified)
    assert(outer_undecided.undecided)

    let observation_decision = declare_d8_synthetic_policy_decision(16101, 1, 0)
    let missing_decision = declare_d8_synthetic_policy_decision(16102, 2, 1)
    let conflict_decision = declare_d8_synthetic_policy_decision(16103, 3, 2)
    assert(observation_decision.decision_audit_checksum == 111567302)
    assert(missing_decision.decision_audit_checksum == 111574037)
    assert(conflict_decision.decision_audit_checksum == 111580772)
    assert(!observation_decision.real_policy_decision)
    assert(!observation_decision.receipt_construction_sealed)
    let observation_provenance = declare_d8_root_observation_provenance(
        12351, 16001, observation_decision,
    )
    let missing_provenance = declare_d8_child_observation_provenance(
        12352, 16002, missing_decision, observation_provenance,
    )
    let conflict_provenance = declare_d8_child_observation_provenance(
        12353, 16003, conflict_decision, observation_provenance,
    )
    assert(observation_provenance.provenance_fingerprint == 477185883)
    assert(missing_provenance.provenance_fingerprint == 477229017)
    assert(conflict_provenance.provenance_fingerprint == 477259800)
    assert(observation_provenance.declared_within_frozen_fixture)
    assert(observation_provenance.fixture_source_audited)
    assert(!observation_provenance.real_world_custody_established)
    assert(!observation_provenance.receipt_construction_sealed)
    let observation = record_discriminating_observation(
        12401, model, observation_provenance,
    )
    assert(observation.compatibility_mask == 5)
    assert(observation.compatible_state_count == 2)
    assert(observation.observation_audit_checksum == 12382490)
    assert(observation.provenance_id == 12351)
    assert(observation.provenance_fingerprint == 477185883)
    assert(observation.observed && observation.fixture_source_audited)
    assert(!observation.missing && observation.declared_provenance_bound)
    let refined_ab = refine_ab_identified_set(12501, ab, observation)
    let refined_ba = refine_ba_identified_set(12502, ba, observation)
    assert(refined_ab.member_mask == 1 && refined_ab.member_count == 1)
    assert(refined_ba.member_mask == 4 && refined_ba.member_count == 1)
    assert(refined_ab.observation_provenance_id == 12351)
    assert(refined_ba.observation_provenance_id == 12351)
    assert(refined_ab.observation_provenance_fingerprint == 477185883)
    assert(refined_ba.observation_provenance_fingerprint == 477185883)
    assert(refined_ab.refinement_audit_checksum == 25091442998)
    assert(refined_ba.refinement_audit_checksum == 25093263135)
    assert(refined_ab.exact_within_frozen_family && refined_ab.subset_of_source)
    assert(refined_ba.exact_within_frozen_family && refined_ba.subset_of_source)
    assert(refined_ab.point_identified && refined_ba.point_identified)

    let ab_subset = certify_ab_subset(12601, ab, refined_ab)
    let ba_subset = certify_ba_subset(12602, ba, refined_ba)
    assert(ab_subset.source_mask == 3 && ab_subset.result_mask == 1)
    assert(ba_subset.source_mask == 6 && ba_subset.result_mask == 4)
    assert(ab_subset.removed_mask == 2 && ba_subset.removed_mask == 2)
    assert(ab_subset.subset_audit_checksum == 15515)
    assert(ba_subset.subset_audit_checksum == 18492)
    assert(ab_subset.same_model && ab_subset.same_assumptions)
    assert(ba_subset.same_model && ba_subset.same_assumptions)
    assert(ab_subset.same_ordered_history && ba_subset.same_ordered_history)
    assert(ab_subset.subset_certified && ba_subset.subset_certified)
    let separation = certify_refined_exact_separation(
        13002, refined_ab, refined_ba, ab_subset, ba_subset,
    )
    assert(separation.ab_member_mask == 1 && separation.ba_member_mask == 4)
    assert(separation.exact_intersection_mask == 0)
    assert(separation.separation_audit_checksum == 12401023)
    assert(separation.model_id == 12200 && separation.assumption_set_id == 12210)
    assert(separation.ab_history_id == 12101 && separation.ba_history_id == 12102)
    assert(separation.observation_id == 12401)
    assert(separation.observation_provenance_id == 12351)
    assert(separation.observation_provenance_fingerprint == 477185883)
    assert(separation.both_exact && separation.both_singleton)
    assert(separation.disjoint && separation.guaranteed_separation)
    assert(!separation.global_separation_claimed)
    assert(!separation.causal_authority && !separation.clinical_authority)
    let point_ab = certify_ab_finite_point_identification(12611, refined_ab)
    let point_ba = certify_ba_finite_point_identification(12612, refined_ba)
    assert(point_ab.state_id == 12001 && point_ab.state_code == 1)
    assert(point_ab.refined_set_id == 12501 && point_ab.source_set_id == 12301)
    assert(point_ab.observation_id == 12401 && point_ab.history_id == 12101)
    assert(point_ab.observation_provenance_id == 12351)
    assert(point_ab.observation_provenance_fingerprint == 477185883)
    assert(point_ab.point_audit_checksum == 384337994)
    assert(point_ab.exact_within_frozen_family && point_ab.singleton_witnessed)
    assert(!point_ab.global_identification_claimed)
    assert(!point_ab.causal_authority && !point_ab.clinical_authority)
    assert(point_ba.state_id == 12003 && point_ba.state_code == 3)
    assert(point_ba.refined_set_id == 12502 && point_ba.source_set_id == 12302)
    assert(point_ba.observation_id == 12401 && point_ba.history_id == 12102)
    assert(point_ba.observation_provenance_id == 12351)
    assert(point_ba.observation_provenance_fingerprint == 477185883)
    assert(point_ba.point_audit_checksum == 384369739)
    assert(point_ba.exact_within_frozen_family && point_ba.singleton_witnessed)
    assert(!point_ba.global_identification_claimed)
    assert(!point_ba.causal_authority && !point_ba.clinical_authority)

    let not_measured = record_not_measured(12901, model, missing_provenance)
    assert(not_measured.provenance_id == 12352)
    assert(not_measured.provenance_fingerprint == 477229017)
    assert(not_measured.opportunity_observed && !not_measured.value_observed)
    let missing = bind_missing_under_policy(12902, not_measured, model)
    assert(missing.missingness_audit_checksum == 12875887)
    assert(missing.declared_provenance_bound && !missing.observed_false)
    let missing_abstention = abstain_from_missingness_refinement(
        12903, ab, missing,
    )
    assert(missing_abstention.source_mask == 3)
    assert(missing_abstention.result_mask == 3)
    assert(missing_abstention.reason_mask == 3)
    assert(missing_abstention.abstention_audit_checksum == 12373740403)
    assert(missing_abstention.set_preserved && !missing_abstention.refinement_performed)

    let conflicting = record_conflicting_observation(
        13101, model, conflict_provenance,
    )
    assert(conflicting.compatibility_mask == 4)
    assert(conflicting.provenance_id == 12353)
    assert(conflicting.provenance_fingerprint == 477259800)
    assert(conflicting.observation_audit_checksum == 13055189)
    let conflict = detect_model_evidence_conflict(13102, refined_ab, conflicting)
    assert(conflict.source_mask == 1 && conflict.evidence_mask == 4)
    assert(conflict.result_mask == 0)
    assert(conflict.conflict_audit_checksum == 24113281431937)
    assert(conflict.empty_identified_set && conflict.model_evidence_conflict)
    assert(!conflict.latent_state_selected && !conflict.nearest_state_fallback_used)

    let association = certify_path_association(13001, ab, ba)
    assert(association.initial_intersection_mask == 2)
    assert(association.association_audit_checksum == 12202625)
    assert(association.ordered_history_association)
    assert(!association.intervention_authority)
    assert(!association.counterfactual_authority)
    let proxy = record_synthetic_suffering_proxy(13003, scalar)
    assert(proxy.proxy_value == 877 && proxy.proxy_audit_checksum == 11956590)
    assert(proxy.synthetic_proxy && !proxy.human_suffering_observed)

    let summary = summarize_path_conditioned_identification(
        13201, model, collision, compatibility, initial_refusal,
        outer_undecided, ab_subset, ba_subset, point_ab, point_ba, separation,
        missing_abstention, conflict, association, proxy,
    )
    assert(summary.protocol_id == 8800 && summary.model_id == 12200)
    assert(summary.latent_state_count == 3)
    assert(summary.scalar_compatible_state_count == 3)
    assert(summary.ordered_history_count == 2)
    assert(summary.initial_exact_set_count == 2)
    assert(summary.exact_refinement_count == 2)
    assert(summary.subset_receipt_count == 2)
    assert(summary.finite_point_identification_count == 2)
    assert(summary.exact_separation_count == 1)
    assert(summary.outer_overlap_undecided_count == 1)
    assert(summary.missingness_abstention_count == 1)
    assert(summary.model_evidence_conflict_count == 1)
    assert(summary.association_receipt_count == 1)
    assert(summary.intervention_receipt_count == 0)
    assert(summary.counterfactual_receipt_count == 0)
    assert(summary.clinical_action_count == 0)
    assert(summary.human_suffering_receipt_count == 0)
    assert(summary.compiler_rewrite_count == 0)
    assert(summary.native_contest_receipt_count == 0)
    assert(summary.summary_audit_checksum == 386060470608)
    assert(summary.exact_only_within_frozen_family)
    assert(!summary.receipt_construction_sealed)
    assert(!summary.ontology_runtime_transport_established)
    assert(!summary.empirical_claim_established)
    assert(!summary.clinical_authority)
}
