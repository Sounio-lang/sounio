//@ run-pass
//@ description: Exact Rational arithmetic — Layer 1 acceptance (hand values, parse, overflow)
use math::rational::*

fn main() -> i64 with Mut, Div, Panic {
    // 1) 1/2 + 1/3 = 5/6
    let r1 = rat_add(rat_make(1,2), rat_make(1,3));
    if r1.num != 5 { return 1; }
    if r1.den != 6 { return 2; }
    // 2) 27/20 > 1
    if rat_cmp(rat_make(27,20), rat_one()) <= 0 { return 3; }
    // 3) gcd reduction 6/4 = 3/2
    let r3 = rat_make(6,4);
    if r3.num != 3 { return 4; }
    if r3.den != 2 { return 5; }
    // 4) negative: -7/20 < 0
    if rat_lt(rat_make(0-7,20), rat_zero()) == false { return 6; }
    // 5) (1/10)*5 + (1/12)*6 = 1/2 + 1/2 = 1
    let a5 = rat_mul(rat_make(1,10), rat_from_int(5));   // 1/2
    let b5 = rat_mul(rat_make(1,12), rat_from_int(6));   // 1/2
    let s5 = rat_add(a5, b5);                            // 1/1
    if s5.num != 1 { return 7; }
    if s5.den != 1 { return 8; }
    // 6) subtraction: 5/6 - 1/3 = 1/2
    let r6 = rat_sub(rat_make(5,6), rat_make(1,3));
    if r6.num != 1 { return 9; }
    if r6.den != 2 { return 10; }
    // 7) division: (3/2) / (1/2) = 3
    let r7 = rat_div(rat_make(3,2), rat_make(1,2));
    if r7.num != 3 { return 11; }
    if r7.den != 1 { return 12; }
    // 8) neg den normalization: 1/(-2) = -1/2
    let r8 = rat_make(1, 0-2);
    if r8.num != 0-1 { return 13; }
    if r8.den != 2 { return 14; }
    // 9) equality after reduction
    if rat_eq(rat_make(2,4), rat_make(1,2)) == false { return 15; }
    // 10) parse "27/20" and "-7"
    let p1 = rat_parse("27/20");
    if p1.num != 27 { return 16; }
    if p1.den != 20 { return 17; }
    let p2 = rat_parse("-7");
    if p2.num != 0-7 { return 18; }
    if p2.den != 1 { return 19; }
    // 11) overflow detection: huge * huge -> invalid (den==0)
    let big = rat_from_int(5000000000);     // 5e9
    let ov = rat_mul(big, big);             // 2.5e19 > i64 max -> invalid
    if rat_valid(ov) { return 20; }
    return 0;
}
