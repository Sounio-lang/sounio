//@ run-pass
//@ description: R7 esub same origin — envelope ua+ub, not cancellation |ua-ub|.
//
// Oracle (integers only): ua=3, ub=3, origin 1 == origin 1
//   founder form u' = 3+3 = 6
//   signed rho=+1 on x-x would be 0; we deliberately do not cancel.

use eisa::core::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let ua: i64 = 3
    let ub: i64 = 3
    let expected: i64 = ua + ub

    let x = ereg_origin(10.0, 3.0, 1)
    let y = ereg_origin(4.0, 3.0, 1)
    let z = esub(x, y)

    if z.origin != 1 {
        println("EISA_ORIGIN_ESUB FAIL origin")
        return 1
    }
    if expected != 6 {
        println("EISA_ORIGIN_ESUB FAIL integer oracle")
        return 1
    }
    if z.u != 6.0 {
        println("EISA_ORIGIN_ESUB FAIL u != 6")
        print("u=")
        print_f64(z.u)
        println("")
        return 1
    }
    println("EISA_ORIGIN_ESUB OK u=6 origin=1")
    0
}
