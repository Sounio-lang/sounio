//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-4 Taylor-2 local containment obligation

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 1433
    fp = mix(fp, 4, 5231)
    fp = mix(fp, 133410511, 5231)
    fp = mix(fp, 282038720, 5231)
    fp = mix(fp, 563122161, 5231)
    fp = mix(fp, 308331037, 5231)
    fp = mix(fp, 389227567, 5231)
    fp = mix(fp, 749342117, 5231)
    fp = mix(fp, 700260810, 5231)
    fp = mix(fp, 2, 5231)
    fp = mix(fp, 1000000, 5231)
    fp = mix(fp, 1, 5231)
    fp = mix(fp, 100, 5231)
    fp = mix(fp, 71000, 5231)
    fp = mix(fp, 273500, 5231)
    fp = mix(fp, 6500, 5231)
    fp = mix(fp, 32524, 5231)
    fp = mix(fp, 45203, 5231)
    fp = mix(fp, 5836, 5231)
    fp = mix(fp, 103524, 5231)
    fp = mix(fp, 318703, 5231)
    fp = mix(fp, 12336, 5231)
    fp = mix(fp, 104000, 5231)
    fp = mix(fp, 319000, 5231)
    fp = mix(fp, 12500, 5231)
    fp = mix(fp, 476, 5231)
    fp = mix(fp, 297, 5231)
    fp = mix(fp, 164, 5231)
    fp = mix(fp, 7, 5231)
    fp = mix(fp, 7, 5231)
    fp = mix(fp, 0, 5231)
    fp = mix(fp, 12, 5231)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 273233357 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1439
    fp = mix(fp, instance, 5233)
    fp = mix(fp, 71000, 5233)
    fp = mix(fp, 273500, 5233)
    fp = mix(fp, 6500, 5233)
    fp = mix(fp, 32524, 5233)
    fp = mix(fp, 45203, 5233)
    fp = mix(fp, 5836, 5233)
    fp = mix(fp, 103524, 5233)
    fp = mix(fp, 318703, 5233)
    fp = mix(fp, 12336, 5233)
    fp = mix(fp, 104000, 5233)
    fp = mix(fp, 319000, 5233)
    fp = mix(fp, 12500, 5233)
    fp = mix(fp, 476, 5233)
    fp = mix(fp, 297, 5233)
    fp = mix(fp, 164, 5233)
    fp = mix(fp, 7, 5233)
    fp = mix(fp, 7, 5233)
    fp = mix(fp, 0, 5233)
    fp = mix(fp, 12, 5233)
    fp = mix(fp, ok_mask, 5233)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 273233357 { return 0 - 1 }
    if certificate != 255024353 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 1447
    fp = mix(fp, instance, 5237)
    fp = mix(fp, certificate, 5237)
    fp = mix(fp, 13, 5237)
    fp = mix(fp, 4, 5237)
    fp = mix(fp, 7, 5237)
    fp = mix(fp, 7, 5237)
    fp = mix(fp, 0, 5237)
    fp = mix(fp, 12, 5237)
    fp = mix(fp, ok_mask, 5237)
    return fp
}

fn obligation_mask() -> i64 {
    let x_need: i64 = 71000 + 32524
    let y_need: i64 = 273500 + 45203
    let z_need: i64 = 6500 + 5836
    let x_margin: i64 = 104000
    let y_margin: i64 = 319000
    let z_margin: i64 = 12500
    let x_slack: i64 = x_margin - x_need
    let y_slack: i64 = y_margin - y_need
    let z_slack: i64 = z_margin - z_need

    var axis_mask: i64 = 0
    if x_need <= x_margin { axis_mask = axis_mask + 1 }
    if y_need <= y_margin { axis_mask = axis_mask + 2 }
    if z_need <= z_margin { axis_mask = axis_mask + 4 }

    var ok_mask: i64 = 0
    if 133410511 > 0 {
        if 563122161 > 0 { ok_mask = ok_mask + 1 }
    }
    if 389227567 > 0 {
        if 749342117 > 0 { ok_mask = ok_mask + 2 }
    }
    if x_need == 103524 {
        if y_need == 318703 {
            if z_need == 12336 { ok_mask = ok_mask + 4 }
        }
    }
    if axis_mask == 7 {
        if x_slack > 0 {
            if y_slack > 0 {
                if z_slack > 0 { ok_mask = ok_mask + 8 }
            }
        }
    }
    if 2 == 2 {
        if 1000000 == 1000000 { ok_mask = ok_mask + 16 }
    }
    if axis_mask == 7 {
        if 12 == 12 { ok_mask = ok_mask + 32 }
    }
    if 0 == 0 { ok_mask = ok_mask + 64 }
    if x_slack == 476 {
        if y_slack == 297 {
            if z_slack == 164 { ok_mask = ok_mask + 128 }
        }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = obligation_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 273233357 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 255024353 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 37368367 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
