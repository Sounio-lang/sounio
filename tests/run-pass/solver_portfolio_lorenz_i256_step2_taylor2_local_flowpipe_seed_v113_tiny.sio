//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v113 smoke for Lorenz i256 step-2 Taylor-2 local flowpipe seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 2079
    receipt_fp = mix(receipt_fp, 633359277, 6091)
    receipt_fp = mix(receipt_fp, 421619310, 6091)
    receipt_fp = mix(receipt_fp, 438456816, 6091)
    receipt_fp = mix(receipt_fp, 198078664, 6091)
    receipt_fp = mix(receipt_fp, 48841302, 6091)
    receipt_fp = mix(receipt_fp, 660429472, 6091)
    receipt_fp = mix(receipt_fp, 769531137, 6091)
    receipt_fp = mix(receipt_fp, 579271506, 6091)
    receipt_fp = mix(receipt_fp, 335080767, 6091)
    receipt_fp = mix(receipt_fp, 249889958, 6091)
    receipt_fp = mix(receipt_fp, 2, 6091)
    receipt_fp = mix(receipt_fp, 18, 6091)
    receipt_fp = mix(receipt_fp, 255, 6091)
    if receipt_fp != 149302752 { return 1 }

    var audit_fp: i64 = 2081
    audit_fp = mix(audit_fp, receipt_fp, 6097)
    audit_fp = mix(audit_fp, 633359277, 6097)
    audit_fp = mix(audit_fp, 421619310, 6097)
    audit_fp = mix(audit_fp, 57785761, 6097)
    audit_fp = mix(audit_fp, 640219420, 6097)
    audit_fp = mix(audit_fp, 660429472, 6097)
    audit_fp = mix(audit_fp, 335080767, 6097)
    audit_fp = mix(audit_fp, 249889958, 6097)
    audit_fp = mix(audit_fp, 769531137, 6097)
    audit_fp = mix(audit_fp, 579271506, 6097)
    audit_fp = mix(audit_fp, 48841302, 6097)
    audit_fp = mix(audit_fp, 2, 6097)
    audit_fp = mix(audit_fp, 18, 6097)
    audit_fp = mix(audit_fp, 255, 6097)
    if audit_fp != 253587342 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 116, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 116, 1103)
    if entry_fp != 727603483 { return 3 }

    var manifest_fp: i64 = 107
    manifest_fp = mix(manifest_fp, 113, 1151)
    manifest_fp = mix(manifest_fp, 117, 1151)
    manifest_fp = mix(manifest_fp, 198078664, 1151)
    manifest_fp = mix(manifest_fp, 438456816, 1151)
    manifest_fp = mix(manifest_fp, entry_fp, 1151)
    if manifest_fp != 766195979 { return 4 }

    var result_fp: i64 = 131
    result_fp = mix(result_fp, 113, 1871)
    result_fp = mix(result_fp, 117, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 105, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 426862743 { return 5 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 113, 1907)
    family_fp = mix(family_fp, 117, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 100, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 539781181 { return 6 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 113, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 839004489 { return 7 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 113, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 893230226 { return 8 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 113, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 908862257 { return 9 }

    return 0
}
