fn add256(a: f256, b: f256) -> f256 {
    a + b
}

fn mul256(a: f256, b: f256) -> f256 {
    a * b
}

fn eq256(a: f256, b: f256) -> bool {
    a == b
}

fn main() -> i32 {
    let _a = add256(1.0, 2.0)
    let _b = mul256(2.0, 3.0)
    let _c = eq256(1.0, 1.0)
    return 0
}
