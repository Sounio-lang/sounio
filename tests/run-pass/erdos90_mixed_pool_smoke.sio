//@ run-pass
//@ expect-stdout: erdos90_mixed_pool_smoke: PASS

// Smoke: mixed ℤ²+Eisenstein pool builds both tags; dual-metric edges compile.

fn iabs(x: i64) -> i64 { if x < 0 { return 0 - x } else { return x } }

fn hexdist(a: i64, b: i64) -> i64 {
    return (iabs(a) + iabs(b) + iabs(a + b)) / 2
}

fn main() -> i32 with IO, Mut {
    let Rz = 4
    let Re = 4
    var z2 = 0
    var ei = 0
    var x = 0 - Rz
    while x <= Rz {
        var y = 0 - Rz
        while y <= Rz {
            if x * x + y * y <= Rz * Rz { z2 = z2 + 1 }
            y = y + 1
        }
        x = x + 1
    }
    var a = 0 - Re
    while a <= Re {
        var b = 0 - Re
        while b <= Re {
            if hexdist(a, b) <= Re { ei = ei + 1 }
            b = b + 1
        }
        a = a + 1
    }
    print("z2_pool="); print_int(z2)
    print(" e_pool="); print_int(ei)
    print(" total="); print_int(z2 + ei); print("\n")
    if z2 > 10 && ei > 10 {
        print("erdos90_mixed_pool_smoke: PASS\n")
        return 0
    }
    print("erdos90_mixed_pool_smoke: FAIL\n")
    return 1
}