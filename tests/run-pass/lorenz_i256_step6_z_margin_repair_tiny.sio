//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 step-6 z-margin repair checks conservative projection superset

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn instance_fp() -> i64 {
    var fp: i64 = 619
    fp = mix(fp, 6, 4127)
    fp = mix(fp, 367562376, 4127)
    fp = mix(fp, 814950326, 4127)
    fp = mix(fp, 516981885, 4127)
    fp = mix(fp, 989033159, 4127)
    fp = mix(fp, 900658, 4127)
    fp = mix(fp, 1008677, 4127)
    fp = mix(fp, 899667, 4127)
    fp = mix(fp, 1009668, 4127)
    fp = mix(fp, 108019, 4127)
    fp = mix(fp, 110001, 4127)
    fp = mix(fp, 54009, 4127)
    fp = mix(fp, 55000, 4127)
    fp = mix(fp, 54531, 4127)
    fp = mix(fp, 469, 4127)
    fp = mix(fp, 991, 4127)
    fp = mix(fp, 7, 4127)
    fp = mix(fp, 0, 4127)
    fp = mix(fp, 0, 4127)
    fp = mix(fp, 9, 4127)
    return fp
}

fn certificate_fp(instance: i64, ok_mask: i64) -> i64 {
    if instance != 156039132 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 631
    fp = mix(fp, instance, 4133)
    fp = mix(fp, 900658, 4133)
    fp = mix(fp, 1008677, 4133)
    fp = mix(fp, 899667, 4133)
    fp = mix(fp, 1009668, 4133)
    fp = mix(fp, 110001, 4133)
    fp = mix(fp, 55000, 4133)
    fp = mix(fp, 54531, 4133)
    fp = mix(fp, 469, 4133)
    fp = mix(fp, 991, 4133)
    fp = mix(fp, 7, 4133)
    fp = mix(fp, 0, 4133)
    fp = mix(fp, 0, 4133)
    fp = mix(fp, 9, 4133)
    fp = mix(fp, ok_mask, 4133)
    return fp
}

fn artifact_fp(instance: i64, certificate: i64, ok_mask: i64) -> i64 {
    if instance != 156039132 { return 0 - 1 }
    if certificate != 264234495 { return 0 - 1 }
    if ok_mask != 255 { return 0 - 1 }

    var fp: i64 = 641
    fp = mix(fp, instance, 4139)
    fp = mix(fp, certificate, 4139)
    fp = mix(fp, 10, 4139)
    fp = mix(fp, 6, 4139)
    fp = mix(fp, 7, 4139)
    fp = mix(fp, 0, 4139)
    fp = mix(fp, 0, 4139)
    fp = mix(fp, 9, 4139)
    fp = mix(fp, ok_mask, 4139)
    return fp
}

fn repair_mask() -> i64 {
    let old_l: i64 = 900658
    let old_u: i64 = 1008677
    let new_l: i64 = 899667
    let new_u: i64 = 1009668
    let need: i64 = 54531
    let margin: i64 = 55000
    let validated_mask: i64 = 0

    var ok_mask: i64 = 0
    if 367562376 > 0 { ok_mask = ok_mask + 1 }
    if old_u - old_l == 108019 { ok_mask = ok_mask + 2 }
    if new_u - new_l == 110001 {
        if margin == 55000 { ok_mask = ok_mask + 4 }
    }
    if new_l <= old_l {
        if new_u >= old_u { ok_mask = ok_mask + 8 }
    }
    if margin >= need {
        if margin - need == 469 { ok_mask = ok_mask + 16 }
    }
    if 7 == 7 { ok_mask = ok_mask + 32 }
    if validated_mask == 0 { ok_mask = ok_mask + 64 }
    if new_l <= 954667 {
        if new_u >= 954668 { ok_mask = ok_mask + 128 }
    }
    return ok_mask
}

fn main() -> i64 {
    let ok_mask = repair_mask()
    if ok_mask != 255 { return 1 }
    let inst = instance_fp()
    if inst != 156039132 { return 2 }
    let cert = certificate_fp(inst, ok_mask)
    if cert != 264234495 { return 3 }
    let art = artifact_fp(inst, cert, ok_mask)
    if art != 617386880 { return 4 }
    if certificate_fp(inst, 254) != (0 - 1) { return 5 }
    return 0
}
