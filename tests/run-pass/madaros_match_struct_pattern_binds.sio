//@ run-pass
//@ requires: madaros
//@ expect-stdout: MATCH_STRUCT_PATTERN_OK
//@ description: `match s { S { a, b } => .. }` binds the fields on Madaros (#2766)
//
// Madaros lowering had no struct-pattern arm (lower_match_arm_ref: "Unsupported
// pattern -- skip") while the checker accepted it on a struct scrutinee, so the
// match evaluated to the 0 its end label loads: norm() printed 0.000000, check OK.
// lean_single's side of struct patterns in `match` is PR #2837.

linear struct Qubit { a: f64, b: f64 }
struct Qn { a: f64, b: f64 }
struct Mixed { tag: i64, w: f64, ok: bool }

fn norm_linear(q: Qubit) -> f64 {
    match q { Qubit { a, b } => a * a + b * b }
}

fn norm(q: Qn) -> f64 {
    match q { Qn { a, b } => a * a + b * b }
}

fn norm_renamed(q: Qn) -> f64 {
    match q { Qn { a: x, b: y } => x * x - y * y }
}

fn pick(m: Mixed) -> i64 {
    match m {
        Mixed { tag, w: _, ok } if ok => tag * 10,
        Mixed { tag, w, ok: _ } => tag + (w as i64),
    }
}

fn main() -> i32 with IO {
    var bad = 0
    let n1 = norm_linear(Qubit { a: 0.6, b: 0.8 })
    if n1 < 0.9999999 || n1 > 1.0000001 { bad = bad + 1 }
    let n2 = norm(Qn { a: 3.0, b: 4.0 })
    if n2 != 25.0 { bad = bad + 1 }
    let n3 = norm_renamed(Qn { a: 3.0, b: 2.0 })
    if n3 != 5.0 { bad = bad + 1 }
    let p1 = pick(Mixed { tag: 7, w: 2.0, ok: true })
    if p1 != 70 { bad = bad + 1 }
    let p2 = pick(Mixed { tag: 7, w: 2.0, ok: false })
    if p2 != 9 { bad = bad + 1 }
    if bad != 0 {
        print("struct pattern match violations: ")
        println(bad)
        return 1
    }
    println("MATCH_STRUCT_PATTERN_OK")
    0
}
