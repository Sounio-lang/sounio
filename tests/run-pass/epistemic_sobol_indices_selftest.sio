//@ run-pass
// stdlib/epistemic/sobol_indices.sio self-test: variance, Jansen
// total/first-order estimators on precomputed outputs, exact log-linear
// shares.
use epistemic::sobol_indices::*

fn main() -> i32 with IO, Mut, Div, Panic {
    let fails = run_tests()
    if fails == 0 {
        println("EPISTEMIC_SOBOL_INDICES_OK")
        return 0
    }
    print("sobol_indices failures: ")
    println(fails)
    1
}
