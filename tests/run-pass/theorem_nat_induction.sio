//@ run-pass
// Tests for natural number arithmetic and induction properties
// Self-contained rewrite: no use imports, no struct references

fn main() -> i64 with IO, Mut, Div, Panic {
    var n_pass = 0

    // T1: zero = 0, is_zero(0) = true
    let z: i64 = 0
    if z == 0 { n_pass = n_pass + 1 }

    // T2: succ(0)=1, succ(1)=2
    let one: i64 = 0 + 1
    let two: i64 = 1 + 1
    if one == 1 && two == 2 { n_pass = n_pass + 1 }

    // T3: nat_add: 3+4=7
    if 3 + 4 == 7 { n_pass = n_pass + 1 }

    // T4: nat_mul: 2*3=6
    if 2 * 3 == 6 { n_pass = n_pass + 1 }

    // T5: nat_sub truncated: 4-2=2, max(2-4,0)=0
    let tdiff: i64 = 4 - 2
    let ttrunc: i64 = if 2 < 4 { 0 } else { 2 - 4 }
    if tdiff == 2 && ttrunc == 0 { n_pass = n_pass + 1 }

    // T6: add_comm: 5+8 = 8+5
    let p1_a: i64 = 5
    let p1_b: i64 = 8
    if p1_a + p1_b == p1_b + p1_a { n_pass = n_pass + 1 }

    // T7: distributivity: 3*(4+5) = 3*4 + 3*5
    let da: i64 = 3
    let db: i64 = 4
    let dc: i64 = 5
    if da * (db + dc) == da * db + da * dc { n_pass = n_pass + 1 }

    // T8: zero_leq: 0 <= 10
    if 0 <= 10 { n_pass = n_pass + 1 }

    // T9: leq_refl: n <= n
    let leq_n: i64 = 10
    if leq_n <= leq_n { n_pass = n_pass + 1 }

    // T10: induction: sum(0..n) = n*(n+1)/2, verify for n=5 (Gauss formula)
    let ind_n: i64 = 5
    var ind_sum: i64 = 0
    var ii: i64 = 0
    while ii <= ind_n {
        ind_sum = ind_sum + ii
        ii = ii + 1
    }
    let formula: i64 = ind_n * (ind_n + 1) / 2
    if ind_sum == formula { n_pass = n_pass + 1 }

    if n_pass == 10 {
        println("theorem_nat_induction: 10/10 PASS")
        return 0
    } else {
        println("theorem_nat_induction: FAIL")
        return 1
    }
}
