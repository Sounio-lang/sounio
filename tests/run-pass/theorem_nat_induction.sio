//@ run-pass
//@ ignore BLOCKED: test harness does not set SOUNIO_STDLIB_PATH for stdlib imports
// Tests for stdlib/theorem/nat.sio: Peano naturals and induction

use theorem::kernel::*;
use theorem::nat::*;

fn run_tests(ctx: &! ProofContext) -> i32 {
    // Test 1: nat_zero has value 0
    let z = nat_zero()
    if z.value != 0 {
        return 1
    }
    if nat_is_zero(z) == false {
        return 2
    }

    // Test 2: nat_succ increments
    let one = nat_succ(nat_zero())
    if one.value != 1 {
        return 3
    }
    let two = nat_succ(one)
    if two.value != 2 {
        return 4
    }

    // Test 3: nat_add is correct
    let three = nat_from_i64(3)
    let four = nat_from_i64(4)
    let seven = nat_add(three, four)
    if seven.value != 7 {
        return 5
    }

    // Test 4: nat_mul is correct
    let six = nat_mul(two, three)
    if six.value != 6 {
        return 6
    }

    // Test 5: nat_sub (truncated) is correct
    let diff = nat_sub(four, two)
    if diff.value != 2 {
        return 7
    }
    let trunc = nat_sub(two, four)
    if trunc.value != 0 {
        return 8
    }

    // Test 6: add_comm_nat — a + b = b + a (proved by computation)
    let five = nat_from_i64(5)
    let eight = nat_from_i64(8)
    let p1 = add_comm_nat(ctx, five, eight)
    let p1_conf = proof_confidence(ctx, p1)
    if p1_conf < 0.99 {
        return 9
    }

    // Test 7: mul_dist_add_nat — a*(b+c) = a*b + a*c
    let a = nat_from_i64(3)
    let b = nat_from_i64(4)
    let c = nat_from_i64(5)
    let bc = nat_add(b, c)
    let lhs = nat_mul(a, bc)
    let ab = nat_mul(a, b)
    let ac = nat_mul(a, c)
    let rhs = nat_add(ab, ac)
    if lhs.value != rhs.value {
        return 10
    }
    let p2 = mul_dist_add_nat(ctx, a, b, c)
    let p2_conf = proof_confidence(ctx, p2)
    if p2_conf < 0.99 {
        return 11
    }

    // Test 8: zero_leq_nat — 0 <= n
    let n = nat_from_i64(10)
    let p3 = zero_leq_nat(ctx, n)
    let p3_conf = proof_confidence(ctx, p3)
    if p3_conf < 0.99 {
        return 12
    }

    // Test 9: leq_refl_nat — n <= n
    let p4 = leq_refl_nat(ctx, n)
    let p4_conf = proof_confidence(ctx, p4)
    if p4_conf < 0.99 {
        return 13
    }

    // Test 10: induction principle
    let base = refl(ctx, 0)
    let step_prop = ctx_prop(ctx, prop_custom(11111))
    let step = trusted(ctx, 999, step_prop, 1.0)
    let target = nat_from_i64(5)
    let result_prop = ctx_prop(ctx, prop_custom(22222))
    let ind_prf = induction(ctx, base, step, target, result_prop)
    let ind_conf = proof_confidence(ctx, ind_prf)
    if ind_conf < 0.99 {
        return 14
    }

    return 0
}

fn main() -> i32 {
    var ctx = proof_context_new()
    return run_tests(&! ctx)
}
