//@ run-pass
//@ description: Tiny portfolio v60 smoke for Lorenz i256 step-6 z-margin repair entry

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 647
    receipt_fp = mix(receipt_fp, 617386880, 4157)
    receipt_fp = mix(receipt_fp, 478471574, 4157)
    receipt_fp = mix(receipt_fp, 176737644, 4157)
    receipt_fp = mix(receipt_fp, 626294410, 4157)
    receipt_fp = mix(receipt_fp, 774303054, 4157)
    receipt_fp = mix(receipt_fp, 6, 4157)
    receipt_fp = mix(receipt_fp, 10, 4157)
    receipt_fp = mix(receipt_fp, 255, 4157)
    if receipt_fp != 486830 { return 1 }

    var audit_fp: i64 = 653
    audit_fp = mix(audit_fp, receipt_fp, 4159)
    audit_fp = mix(audit_fp, 617386880, 4159)
    audit_fp = mix(audit_fp, 478471574, 4159)
    audit_fp = mix(audit_fp, 543241250, 4159)
    audit_fp = mix(audit_fp, 711825675, 4159)
    audit_fp = mix(audit_fp, 774303054, 4159)
    audit_fp = mix(audit_fp, 6, 4159)
    audit_fp = mix(audit_fp, 10, 4159)
    audit_fp = mix(audit_fp, 255, 4159)
    if audit_fp != 184189884 { return 2 }

    var entry_fp: i64 = 101
    entry_fp = mix(entry_fp, 63, 1103)
    entry_fp = mix(entry_fp, receipt_fp, 1103)
    entry_fp = mix(entry_fp, audit_fp, 1103)
    entry_fp = mix(entry_fp, 1, 1103)
    entry_fp = mix(entry_fp, 63, 1103)
    if entry_fp != 299367418 { return 3 }

    let manifest_fp: i64 = 795358725
    var result_fp: i64 = 131
    result_fp = mix(result_fp, 60, 1871)
    result_fp = mix(result_fp, 64, 1871)
    result_fp = mix(result_fp, 10, 1871)
    result_fp = mix(result_fp, 52, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, 1, 1871)
    result_fp = mix(result_fp, manifest_fp, 1871)
    if result_fp != 416023775 { return 4 }

    var family_fp: i64 = 149
    family_fp = mix(family_fp, 60, 1907)
    family_fp = mix(family_fp, 64, 1907)
    family_fp = mix(family_fp, 6, 1907)
    family_fp = mix(family_fp, 4, 1907)
    family_fp = mix(family_fp, 3, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, 47, 1907)
    family_fp = mix(family_fp, 2, 1907)
    family_fp = mix(family_fp, manifest_fp, 1907)
    if family_fp != 843302290 { return 5 }

    var acceptance_fp: i64 = 137
    acceptance_fp = mix(acceptance_fp, 60, 1889)
    acceptance_fp = mix(acceptance_fp, manifest_fp, 1889)
    acceptance_fp = mix(acceptance_fp, result_fp, 1889)
    if acceptance_fp != 907169025 { return 6 }

    var audit_receipt_fp: i64 = 157
    audit_receipt_fp = mix(audit_receipt_fp, 60, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, manifest_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, result_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, family_fp, 1931)
    audit_receipt_fp = mix(audit_receipt_fp, acceptance_fp, 1931)
    if audit_receipt_fp != 1448964 { return 7 }

    var readiness_fp: i64 = 163
    readiness_fp = mix(readiness_fp, 60, 1951)
    readiness_fp = mix(readiness_fp, 31, 1951)
    readiness_fp = mix(readiness_fp, manifest_fp, 1951)
    readiness_fp = mix(readiness_fp, result_fp, 1951)
    readiness_fp = mix(readiness_fp, family_fp, 1951)
    readiness_fp = mix(readiness_fp, acceptance_fp, 1951)
    readiness_fp = mix(readiness_fp, audit_receipt_fp, 1951)
    if readiness_fp != 16326305 { return 8 }
    return 0
}
