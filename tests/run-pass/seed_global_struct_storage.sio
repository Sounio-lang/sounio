//@ run-pass
// Global aggregate storage must not overlap adjacent globals or runtime shadows.
struct Arena { types: [i64; 64], values: [f64; 64], left: [i64; 64], right: [i64; 64], count: i64 }
var G: Arena = Arena { types:[0;64], values:[0.0;64], left:[0;64], right:[0;64], count:0 }
struct Neighbor { first: i64, second: i64 }
var N: Neighbor = Neighbor { first: 31, second: 47 }
var SENTINEL: i64 = 83

fn f(x: f64) -> f64 with Mut { var a = x; var i = 0; while i < 3 { a = a + x; i = i + 1 }; a }
fn scan(stage: i64) -> i64 with IO, Mut, Panic {
 var fails=0; var i=0
 while i < 64 { if G.left[i] != i+100 { print("BAD "); print(stage); print(" "); print(i); print(" "); println(G.left[i]); fails=fails+1 }; i=i+1 }
 fails
}
fn main() -> i64 with IO, Mut, Panic {
 var i=0; while i < 64 { G.left[i]=i+100; i=i+1 }
 N.first=31; N.second=47; SENTINEL=83
 var bad=scan(0)
 let x=f(2.0)
 bad=bad+scan(1)
 println(x)
 bad=bad+scan(2)
 var a=1.0; i=0; while i<4 { a=a*2.0; i=i+1 }
 bad=bad+scan(3)
 println(a)
 bad=bad+scan(4)
 if N.first != 31 || N.second != 47 || SENTINEL != 83 { println("FAIL adjacent globals"); bad=bad+1 }
 if bad==0 { println("PASS all integer slots unchanged") }
 bad
}
