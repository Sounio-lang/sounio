//@ run-pass
//@ expect-stdout: NAMED_CONST_ALEN 3 5 7 4
//@ description: a named integer constant as an array length, in a struct field, a local type and a repeat count (#1495, defect 2)
//
// lean_single accepted `[T; N]` for locals but gave a struct FIELD length 0
// ("missing field in struct literal"); Madaros typed every named length as 0
// or -1 and refused with E016 / E020 / E001. Both now fold a top-level integer
// constant used as an array length to the literal it names.
const N: i64 = 8
let M: i64 = 4

struct S { arr: [bool; N], n: i64 }
struct T { xs: [i64; M] }

fn main() -> i32 with IO, Mut, Panic {
    var s = S { arr: [false; 8], n: 3 }
    s.arr[2] = true
    var t = T { xs: [0; M] }
    t.xs[3] = 7
    var a: [i64; N] = [0; N]
    a[7] = 5
    var b: [i64; M] = [1; 4]
    print("NAMED_CONST_ALEN ")
    if s.arr[2] { print_int(s.n) } else { print_int(0) }
    print(" ")
    print_int(a[7])
    print(" ")
    print_int(t.xs[3])
    print(" ")
    print_int(b[0] + b[1] + b[2] + b[3])
    print("\n")
    return 0
}
