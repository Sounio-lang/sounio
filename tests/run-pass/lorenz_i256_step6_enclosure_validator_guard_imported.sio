//@ run-pass
//@ requires: madaros
//@ description: Imported Lorenz i256 step-6 enclosure validator guard checks public API

use systems::lorenz_i256_cert::*

fn main() -> i64 {
    let artifact_fp = lorenz_i256_step6_enclosure_validator_guard_check(
        975464919, 641464796, 516981885, 652877359,
        299663, 389292, 54009, 290642, 386189, 54531,
        3, 4, 0, 8)
    if artifact_fp != 367562376 { return 1 }
    let audit_fp = lorenz_i256_step6_enclosure_validator_guard_audit_fingerprint(
        artifact_fp, 898897987, 851507956, 975464919, 376630542,
        641464796, 516981885, 652877359, 6, 8, 255)
    if audit_fp != 814950326 { return 2 }
    return 0
}
