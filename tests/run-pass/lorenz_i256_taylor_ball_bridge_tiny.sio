//@ run-pass
//@ requires: madaros
//@ description: Self-contained Lorenz i256 Taylor/ball bridge receipt

fn mix(acc: i64, value: i64, salt: i64) -> i64 {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn taylor_ball_bridge_fingerprint(
    trajectory_manifest_fp: i64,
    dependency_dag_fp: i64,
    final_enclosure_receipt_fp: i64,
    ball_fixed_enclosure_fp: i64,
    range_budget_fp: i64,
    roundoff_budget_fp: i64,
    projection_margin_budget_fp: i64,
    bridge_mask: i64) -> i64 {
    if trajectory_manifest_fp != 214180161 { return 0 - 1 }
    if dependency_dag_fp != 713010204 { return 0 - 1 }
    if final_enclosure_receipt_fp != 114244647 { return 0 - 1 }
    if ball_fixed_enclosure_fp != 166945519 { return 0 - 1 }
    if range_budget_fp != 87220662 { return 0 - 1 }
    if roundoff_budget_fp != 677514412 { return 0 - 1 }
    if projection_margin_budget_fp != 69322697 { return 0 - 1 }
    if bridge_mask != 127 { return 0 - 1 }

    let x_slack: i64 = 250000 - 243366
    let y_slack: i64 = 325000 - 319640
    let z_slack: i64 = 50000 - 42448
    let radius_sum: i64 = 243366 + 319640 + 42448
    if x_slack != 6634 { return 0 - 1 }
    if y_slack != 5360 { return 0 - 1 }
    if z_slack != 7552 { return 0 - 1 }
    if radius_sum != 605454 { return 0 - 1 }

    var fp: i64 = 467
    fp = mix(fp, trajectory_manifest_fp, 2903)
    fp = mix(fp, dependency_dag_fp, 2903)
    fp = mix(fp, final_enclosure_receipt_fp, 2903)
    fp = mix(fp, ball_fixed_enclosure_fp, 2903)
    fp = mix(fp, range_budget_fp, 2903)
    fp = mix(fp, roundoff_budget_fp, 2903)
    fp = mix(fp, projection_margin_budget_fp, 2903)
    fp = mix(fp, 1000000, 2903)
    fp = mix(fp, 5, 2903)
    fp = mix(fp, 2, 2903)
    fp = mix(fp, 1, 2903)
    fp = mix(fp, 100, 2903)
    fp = mix(fp, 256, 2903)
    fp = mix(fp, 32, 2903)
    fp = mix(fp, 184, 2903)
    fp = mix(fp, 243366, 2903)
    fp = mix(fp, 319640, 2903)
    fp = mix(fp, 42448, 2903)
    fp = mix(fp, 250000, 2903)
    fp = mix(fp, 325000, 2903)
    fp = mix(fp, 50000, 2903)
    fp = mix(fp, x_slack, 2903)
    fp = mix(fp, y_slack, 2903)
    fp = mix(fp, z_slack, 2903)
    fp = mix(fp, radius_sum, 2903)
    fp = mix(fp, bridge_mask, 2903)
    return fp
}

fn taylor_ball_bridge_audit_fingerprint(bridge_fp: i64) -> i64 {
    if bridge_fp != 979362768 { return 0 - 1 }

    var fp: i64 = 479
    fp = mix(fp, bridge_fp, 2917)
    fp = mix(fp, 725222703, 2917)
    fp = mix(fp, 845057161, 2917)
    fp = mix(fp, 114244647, 2917)
    fp = mix(fp, 166945519, 2917)
    fp = mix(fp, 2, 2917)
    fp = mix(fp, 127, 2917)
    return fp
}

fn main() -> i64 {
    let fp = taylor_ball_bridge_fingerprint(
        214180161, 713010204, 114244647, 166945519,
        87220662, 677514412, 69322697, 127)
    if fp != 979362768 { return 1 }
    let audit_fp = taylor_ball_bridge_audit_fingerprint(fp)
    if audit_fp != 927174126 { return 2 }
    if taylor_ball_bridge_fingerprint(
        214180161, 713010204, 114244647, 166945519,
        87220662, 677514412, 69322697, 126) != (0 - 1) { return 3 }
    if taylor_ball_bridge_audit_fingerprint(979362769) != (0 - 1) { return 4 }
    return 0
}
