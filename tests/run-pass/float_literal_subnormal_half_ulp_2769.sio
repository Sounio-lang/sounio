//@ run-pass
//@ description: #2769 decimal f64 literals in [2^-1075, 2^-1074) round to the smallest subnormal (bit pattern 1) instead of reading as 0.0; just below the half they round to 0
//@ expect-stdout: min_subnormal_17=1
//@ expect-stdout: five_e_m324=1
//@ expect-stdout: three_e_m324=1
//@ expect-stdout: above_half=1
//@ expect-stdout: below_half=0
//@ expect-stdout: two_ulp=2
//@ expect-stdout: three_ulp_down=2
//@ expect-stdout: min_normal=4503599627370496
//@ expect-stdout: underflow=0
//@ expect-stdout: SUBNORMAL_2769_OK
//
// Expected bit patterns were independently verified by the C++23 exact-rational
// oracle in tests/oracles/float_literal_subnormal_half_ulp_2769.cpp. It parses
// each decimal as an integer significand and power of ten, scales by 2^1074,
// then rounds with integer quotient/remainder and ties-to-even. 2^-1075 is
// exactly half the smallest subnormal: anything strictly above it rounds UP to
// 2^-1074 (bits 1), anything below rounds to 0. Madaros's pfl_slow returned
// 0.0 whenever no significand bit fit (want == 0), i.e. for the whole interval
// [2^-1075, 2^-1074) -- which contains the issue's 4.9406564584124654e-324 and
// 3e-324 -- with no diagnostic. `5e-324` and `9.88e-324` were already right.
//
// Both engines. lean_single used to need `requires: madaros` here, for the
// same reason as float_literal_correctly_rounded.sio: its decimal conversion
// was repeated mulsd/divsd by 10, which got above_half (0, want 1) and
// min_normal (4503599627370499, want ...496) wrong. #2826 replaced it with the
// compile-time bignum conversion, including this half-ulp rule.

fn show(label: string, bits: i64) with IO {
    print(label)
    println(bits)
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var bad: i64 = 0
    let a = f64_to_bits(4.9406564584124654e-324)
    let b = f64_to_bits(5e-324)
    let c = f64_to_bits(3e-324)
    let d = f64_to_bits(2.4703282292062328e-324)
    let e = f64_to_bits(2.470328229206232720882538e-324)
    let f = f64_to_bits(9.8813129168249309e-324)
    let g = f64_to_bits(7.4109846876186982e-324)
    let h = f64_to_bits(2.2250738585072014e-308)
    let u = f64_to_bits(1e-400)
    show("min_subnormal_17=", a)
    show("five_e_m324=", b)
    show("three_e_m324=", c)
    show("above_half=", d)
    show("below_half=", e)
    show("two_ulp=", f)
    show("three_ulp_down=", g)
    show("min_normal=", h)
    show("underflow=", u)
    if a != 1 { bad = bad + 1 }
    if b != 1 { bad = bad + 1 }
    if c != 1 { bad = bad + 1 }
    if d != 1 { bad = bad + 1 }
    if e != 0 { bad = bad + 1 }
    if f != 2 { bad = bad + 1 }
    if g != 2 { bad = bad + 1 }
    if h != 4503599627370496 { bad = bad + 1 }
    if u != 0 { bad = bad + 1 }
    if bad == 0 { println("SUBNORMAL_2769_OK") } else { println("SUBNORMAL_2769_FAIL") }
    0
}
