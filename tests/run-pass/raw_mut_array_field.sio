//@ run-pass
//@ requires: madaros
// heap_alloc returns a zeroed payload, not a GC array handle. Indexing
// (*p).slots[i] must write the payload, not resolve word 0 as handle 0
// (the gen2 check SIGSEGV in fn_sig_table_add). A field after the array
// must not share slots[1].

struct Buf {
    slots: [i64; 4],
    tag: i64,
}

fn set_slot(p: *mut Buf, i: i64, v: i64) with Mut, Panic, Div {
    (*p).slots[i] = v
}

fn get_slot(p: *mut Buf, i: i64) -> i64 with Mut, Panic, Div {
    (*p).slots[i]
}

fn main() -> i64 with Mut, Panic, Div, Alloc {
    let p = heap_alloc(4096) as *mut Buf
    if (p as i64) == 0 { return 1 }
    set_slot(p, 0, 11)
    set_slot(p, 1, 22)
    (*p).tag = 7
    if get_slot(p, 0) != 11 { return 2 }
    if get_slot(p, 1) != 22 { return 3 }
    if (*p).tag != 7 { return 4 }
    heap_free(p as *mut u8)
    0
}
