//@ run-pass
//@ expect-stdout: knowledge runtime variance abi: PASS

struct Holder { k: Knowledge<f64>, n: i64 }
struct TightHolder { k: Knowledge<f64, epsilon < 0.01>, n: i64 }
struct Mixer { bias: f64 }

impl Mixer {
    fn add_k(self: Mixer, offset: f64, k: Knowledge<f64, epsilon < 0.02>) -> f64 with Epistemic {
        self.bias + offset + k.value + variance_of(k)
    }
}

fn carry_value(x: f64) -> f64 with Mut {
    let y = x + 0.0
    return y
}

fn mixed_param(scale: f64, k: Knowledge<f64, epsilon < 0.01>) -> f64 with Epistemic {
    scale + k.value
}

fn approx_eq(a: f64, b: f64) -> bool with Panic {
    let d = if a > b { a - b } else { b - a }
    d < 0.000001
}

fn main() -> i32 with IO, Epistemic, Panic, Mut {
    let k: Knowledge<f64> = measure(3.0, uncertainty: 0.01)
    let k_exact: Knowledge<f64, epsilon < 0.01> = measure(3.0, uncertainty: 0.0)
    let k_method: Knowledge<f64, epsilon < 0.02> = measure(3.0, uncertainty: 0.01)
    let k2: Knowledge<f64> = measure(5.0, uncertainty: 0.02)
    let carried = carry_value(k.value)
    let observed = carried + variance_of(carried)
    let mixed = mixed_param(1.0, k_exact)
    let mixer = Mixer { bias: 0.5 }
    let method_mixed = mixer.add_k(2.0, k_method)
    let variance_reader = |x: Knowledge<f64, epsilon < 0.02>| 3.0 + variance_of(x)
    let closure_mixed = variance_reader(k_method)
    let k_arr: [Knowledge<f64>; 2] = [k, k2]
    let arr_first_value = k_arr[0].value
    let arr_first_observed = arr_first_value + variance_of(arr_first_value)
    var k_arr_mut_init: [Knowledge<f64>; 2] = [k, k2]
    let arr_mut_init_value = k_arr_mut_init[0].value
    let arr_mut_init_observed = arr_mut_init_value + variance_of(arr_mut_init_value)
    var k_arr_copy: [Knowledge<f64>; 2] = [k_exact, k_exact]
    k_arr_copy = k_arr
    let arr_copy_value = k_arr_copy[0].value
    let arr_copy_observed = arr_copy_value + variance_of(arr_copy_value)
    let tight_holder = TightHolder { k: k_exact, n: 5 }
    let mixed_field = mixed_param(1.0, tight_holder.k)
    let holder = Holder { k: k, n: 7 }
    let field_value = holder.k.value
    let field_observed = field_value + variance_of(field_value)
    var holder_mut_init = Holder { k: k, n: 8 }
    let mut_init_field_value = holder_mut_init.k.value
    let mut_init_field_observed = mut_init_field_value + variance_of(mut_init_field_value)
    var holder_copy = Holder { k: k_exact, n: 6 }
    holder_copy = holder
    let copied_field_value = holder_copy.k.value
    let copied_field_observed = copied_field_value + variance_of(copied_field_value)
    var holder2 = Holder { k: k_exact, n: 9 }
    holder2.k = k2
    let reassigned_field = holder2.k.value
    let reassigned_observed = reassigned_field + variance_of(reassigned_field)
    var k_arr2: [Knowledge<f64>; 2] = [k_exact, k_exact]
    k_arr2[1] = k2
    let arr_set_value = k_arr2[1].value
    let arr_set_observed = arr_set_value + variance_of(arr_set_value)
    if approx_eq(observed, 3.0001) && approx_eq(mixed, 4.0) && approx_eq(method_mixed, 5.5001) && approx_eq(closure_mixed, 3.0001) && approx_eq(arr_first_observed, 3.0001) && approx_eq(arr_mut_init_observed, 3.0001) && approx_eq(arr_copy_observed, 3.0001) && approx_eq(mixed_field, 4.0) && approx_eq(field_observed, 3.0001) && approx_eq(mut_init_field_observed, 3.0001) && approx_eq(copied_field_observed, 3.0001) && approx_eq(reassigned_observed, 5.0004) && approx_eq(arr_set_observed, 5.0004) {
        print("knowledge runtime variance abi: PASS\n")
        0
    } else {
        print("knowledge runtime variance abi: FAIL\n")
        1
    }
}
