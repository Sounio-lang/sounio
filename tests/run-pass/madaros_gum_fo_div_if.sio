//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_DIV_IF_PASS

// Deep FO: quotient rule + if-arm propagation + 17-seed headroom (32 channels).
//   Var(a/b) = (1/b)² Va + (a/b²)² Vb
//   if true { a*b } else { … } keeps product FO
// Inter-procedural FO (variance through user fns) remains residual.

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() with IO, Mut, Div, Epistemic {
    let a: Knowledge<f64> = measure(2.0, uncertainty: 0.05)
    let b: Knowledge<f64> = measure(3.0, uncertainty: 0.05)
    let av = a.value
    let bv = b.value

    // Div: a=2,b=3 → 0.0025/9 + 4/81*0.0025 = 0.000277…+0.000123… ≈ 0.0004012346
    let v_div = variance_of(av / bv)
    let want_div = 0.0025 / 9.0 + (4.0 / 81.0) * 0.0025

    // if true arm
    let w = if true { av * bv } else { av + bv }
    let v_if = variance_of(w)

    // if false arm
    let w2 = if false { av + bv } else { av * bv }
    let v_if2 = variance_of(w2)

    // 17 independent unit seeds after a,b already live (2 ch) → need ≥19 capacity
    let m0: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m1: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m2: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m3: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m4: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m5: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m6: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m7: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m8: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m9: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m10: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m11: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m12: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m13: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m14: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m15: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let m16: Knowledge<f64> = measure(1.0, uncertainty: 0.05)
    let y0 = m0.value
    let y1 = m1.value
    let y2 = m2.value
    let y3 = m3.value
    let y4 = m4.value
    let y5 = m5.value
    let y6 = m6.value
    let y7 = m7.value
    let y8 = m8.value
    let y9 = m9.value
    let y10 = m10.value
    let y11 = m11.value
    let y12 = m12.value
    let y13 = m13.value
    let y14 = m14.value
    let y15 = m15.value
    let y16 = m16.value
    let sum17 = y0+y1+y2+y3+y4+y5+y6+y7+y8+y9+y10+y11+y12+y13+y14+y15+y16
    let v_sum17 = variance_of(sum17)

    // a*(b+c) identity cancel still after many seeds
    let c: Knowledge<f64> = measure(4.0, uncertainty: 0.05)
    let cv = c.value
    let left = av * bv + av * cv
    let right = av * (bv + cv)
    let v_id = variance_of(left - right)

    print("div="); print_f64(v_div); print("\n")
    print("want_div="); print_f64(want_div); print("\n")
    print("if_t="); print_f64(v_if); print("\n")
    print("if_f="); print_f64(v_if2); print("\n")
    print("sum17="); print_f64(v_sum17); print("\n")
    print("id="); print_f64(v_id); print("\n")

    let ok = abs_f(v_div - want_div) < 1.0e-12
        && abs_f(v_if - 0.0325) < 1.0e-9
        && abs_f(v_if2 - 0.0325) < 1.0e-9
        && abs_f(v_sum17 - 0.0425) < 1.0e-9
        && abs_f(v_id) < 1.0e-9
    if ok {
        print("MADAROS_GUM_FO_DIV_IF_PASS\n")
    } else {
        print("MADAROS_GUM_FO_DIV_IF_FAIL\n")
    }
}
