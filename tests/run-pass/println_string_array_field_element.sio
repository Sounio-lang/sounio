//@ run-pass
//@ expect-stdout-contains: elem=beta
//@ expect-stdout-contains: int_elem=7
//@ expect-stdout-contains: PASS
//
// `let s = base.field[i]` where the field is declared `[string; N]`, then
// print(s). The last println-poison refusal in a gen2 self-compile was exactly
// this: `let file_path = work_imports.paths[dep_i]` with `paths: [string; 256]`.
//
// NEGATIVE CONTROL: an i64 array field reached the same way must still print as
// a NUMBER. The integer classifier defaults ANY non-float index to kind 1, so a
// symmetric "an index yields a string" rule would send that element's VALUE to
// the char* printer and strlen would dereference it.

struct Reg {
    names: [string; 4],
    nums: [i64; 4],
}

fn main() -> i64 with IO, Mut, Panic, Div, Alloc {
    let r = Reg { names: ["alpha", "beta", "gamma", "delta"], nums: [5, 7, 9, 11] }

    let s = r.names[1]
    print("elem=")
    println(s)

    // Printed DIRECTLY, not through a local, and that is not incidental: the
    // let-binding refuses to give an indexed RHS the integer kind at all --
    // "Restricted to Call/MethodCall so an indexed struct element cannot be
    // misclassified as int" -- so `let n = r.nums[1]; println(n)` is a SECOND,
    // pre-existing poison site of the integer twin of this bug. Widening that
    // is a separate change; using the direct form keeps this control testing
    // what it claims to test.
    print("int_elem=")
    println(r.nums[1])

    println("PASS")
    0
}
