//@ run-pass
//@ expect-stdout: BOOTSTRAP_FOREST_PASS
//@ expect-stdout: fill="rgb(80,180,240)"
//@ expect-stdout: stroke="rgb(180,190,210)"
//@ expect-stdout: data-interval-kind="confidence"
//@ expect-stdout: Percentile bootstrap 95% CI
use stats::bootstrap::{bootstrap_mean}
use display::canvas::{Canvas, canvas_clear}
use viz::ir::{viz_scene_new, viz_layout_rect, viz_style_rgb, viz_add_forest_interval_plot,
    VIZ_INTERVAL_CONFIDENCE, viz_add_axis, viz_node_set_label}
use viz::viz_canvas::{viz_canvas_render_scene}
use viz::viz_html::{viz_html_emit_scene}
fn main() with IO, Alloc, Mut, Div, Panic {
    var x: [f64; 256] = [0.0; 256]
    x[0]=1.0; x[1]=2.0; x[2]=3.0; x[3]=4.0; x[4]=5.0
    let a = bootstrap_mean(&x, 5, 1000, 0.95, 20260715)
    var i: i64 = 0
    while i < 5 { x[i as usize] = x[i as usize] + 1.0; i=i+1 }
    let b = bootstrap_mean(&x, 5, 1000, 0.95, 20260715)
    assert(a.status == 0 && b.status == 0)
    assert(a.lo <= a.mean && a.mean <= a.hi && b.lo <= b.mean && b.mean <= b.hi)
    var estimates: [f64; 1024] = [0.0; 1024]
    var lower: [f64; 1024] = [0.0; 1024]
    var upper: [f64; 1024] = [0.0; 1024]
    estimates[0]=a.mean; estimates[1]=b.mean
    lower[0]=a.lo; lower[1]=b.lo
    upper[0]=a.hi; upper[1]=b.hi
    var scene = viz_scene_new()
    let plot = viz_add_forest_interval_plot(&!scene, &estimates, &lower, &upper, 2,
        VIZ_INTERVAL_CONFIDENCE, 0.95,
        viz_layout_rect(130, 25, 560, 70), viz_style_rgb(80, 180, 240))
    assert(plot == 0)
    assert(scene.nodes[0].style.b == 240)
    assert(scene.series[0].lower[0] == a.lo && scene.series[0].upper[1] == b.hi)
    // Forest automatically covers these actual interval endpoints. Bind axis to the same domain.
    let axis = viz_add_axis(&!scene, a.lo, b.hi, 4, false,
        viz_layout_rect(130, 110, 560, 1), viz_style_rgb(180, 190, 210))
    assert(axis == 1)
    assert(scene.nodes[1].style.b == 210)
    var title: [i8; 64] = [0; 64]
    title[0]=80
    title[1]=101
    title[2]=114
    title[3]=99
    title[4]=101
    title[5]=110
    title[6]=116
    title[7]=105
    title[8]=108
    title[9]=101
    title[10]=32
    title[11]=98
    title[12]=111
    title[13]=111
    title[14]=116
    title[15]=115
    title[16]=116
    title[17]=114
    title[18]=97
    title[19]=112
    title[20]=32
    title[21]=57
    title[22]=53
    title[23]=37
    title[24]=32
    title[25]=67
    title[26]=73
    viz_node_set_label(&!scene, axis, &title, 27)
    let pixels = heap_alloc(820 * 185 * 8) as *mut i64
    var canvas = Canvas { pixels: pixels, width: 820, height: 185 }
    canvas_clear(&!canvas, 0, 0, 0)
    viz_canvas_render_scene(&scene, &!canvas)
    assert(read_i64(canvas.pixels, 36 * 820 + 130) != 0)
    assert(read_i64(canvas.pixels, 58 * 820 + 690) != 0)
    let estimate_color: i64 = 240 | (180 << 8) | (80 << 16)
    assert(read_i64(canvas.pixels, 36 * 820 + 327) == estimate_color)
    viz_html_emit_scene(&scene, 820, 185)
    println("BOOTSTRAP_FOREST_PASS")
    0
}
