//@ run-pass
//@ expect-stdout: STATS_T_TEST_STATUS_PASS
use stats::inferential::{t_test_one_sample, t_test_welch, t_test_paired, T_TEST_OK, T_TEST_INVALID_SAMPLE, T_TEST_NONFINITE, T_TEST_ZERO_VARIANCE, T_TEST_NUMERIC_FAILURE, T_METHOD_ONE_SAMPLE, T_METHOD_WELCH, T_METHOD_PAIRED}
fn main() with IO, Mut, Div, Panic {
    var x: [f64; 100] = [0.0; 100]
    var y: [f64; 100] = [0.0; 100]
    x[0]=1.0; x[1]=2.0; x[2]=3.0
    let valid = t_test_one_sample(x, 3, 0.0)
    assert(valid.status == T_TEST_OK)
    assert(valid.confidence_level == 0.95)
    assert(valid.method == T_METHOD_ONE_SAMPLE)
    assert(valid.n_x == 3 && valid.n_y == 0)
    let welch = t_test_welch(x, 3, x, 3)
    assert(welch.status == T_TEST_OK)
    assert(welch.method == T_METHOD_WELCH)
    assert(welch.n_x == 3 && welch.n_y == 3)
    let too_small = t_test_one_sample(x, 1, 0.0)
    assert(too_small.status == T_TEST_INVALID_SAMPLE)
    let too_large = t_test_one_sample(x, 101, 0.0)
    assert(too_large.status == T_TEST_INVALID_SAMPLE)
    let bad_pair = t_test_paired(x, y, 101)
    assert(bad_pair.status == T_TEST_INVALID_SAMPLE)
    assert(bad_pair.method == T_METHOD_PAIRED)
    let constant = t_test_one_sample(y, 3, 0.0)
    assert(constant.status == T_TEST_ZERO_VARIANCE)
    let constant_welch = t_test_welch(y, 3, y, 3)
    assert(constant_welch.status == T_TEST_ZERO_VARIANCE)
    var huge = 1.0e308
    let inf = huge * 10.0
    x[0] = inf
    let nonfinite = t_test_one_sample(x, 3, 0.0)
    assert(nonfinite.status == T_TEST_NONFINITE)
    x[0] = huge; x[1] = 0.0-huge
    let overflow = t_test_one_sample(x, 2, 0.0)
    assert(overflow.status == T_TEST_NUMERIC_FAILURE)
    println("STATS_T_TEST_STATUS_PASS")
    0
}
