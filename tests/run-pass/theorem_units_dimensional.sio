//@ run-pass
// Tests for SI dimensional analysis (self-contained, no use imports)
// Dimensions represented as 7 integer exponents: [kg, m, s, A, K, mol, cd]
// Uses pure integer arithmetic — no arrays, no structs

fn main() -> i64 with IO, Mut, Div, Panic {
    var n_pass = 0

    // T1: Newton = kg*m/s² → dim: mass=1, len=1, time=-2
    // kg(1,0,0) + m(0,1,0) + s^-2(0,0,-2) = (1,1,-2)
    let n_mass = 1; let n_len = 1; let n_time = 0 - 2
    if n_mass == 1 && n_len == 1 && n_time == 0 - 2 { n_pass = n_pass + 1 }

    // T2: Joule = N*m → dim: mass=1, len=2, time=-2
    // Newton + m(0,1,0) = (1,2,-2)
    let j_mass = n_mass; let j_len = n_len + 1; let j_time = n_time
    if j_mass == 1 && j_len == 2 && j_time == 0 - 2 { n_pass = n_pass + 1 }

    // T3: Watt = J/s → dim: mass=1, len=2, time=-3
    // Joule - s(0,0,1) = (1,2,-3)
    let w_mass = j_mass; let w_len = j_len; let w_time = j_time - 1
    if w_mass == 1 && w_len == 2 && w_time == 0 - 3 { n_pass = n_pass + 1 }

    // T4: Pascal = N/m² → dim: mass=1, len=-1, time=-2
    // Newton - 2*m(0,1,0) = (1,-1,-2)
    let pa_mass = n_mass; let pa_len = n_len - 2; let pa_time = n_time
    if pa_mass == 1 && pa_len == 0 - 1 && pa_time == 0 - 2 { n_pass = n_pass + 1 }

    // T5: E=mc² dimensional consistency
    // [kg](1,0,0) * [m/s]²(0,2,-2) = (1,2,-2) = Joule ✓
    let emc2_mass = 1 + 0; let emc2_len = 0 + 2; let emc2_time = 0 + (0 - 2)
    if emc2_mass == j_mass && emc2_len == j_len && emc2_time == j_time {
        n_pass = n_pass + 1
    }

    // T6: PV = nRT dimensional consistency
    // Pa*m³: (1,-1,-2)+(0,3,0) = (1,2,-2) = Joule ✓
    let pv_mass = pa_mass + 0; let pv_len = pa_len + 3; let pv_time = pa_time + 0
    if pv_mass == j_mass && pv_len == j_len && pv_time == j_time { n_pass = n_pass + 1 }

    // T7: Planck-Einstein E=hf
    // h=[1,2,-1], f=[0,0,-1] → h*f = [1,2,-2] = Joule ✓
    let h_mass = 1; let h_len = 2; let h_time = 0 - 1
    let f_mass = 0; let f_len = 0; let f_time = 0 - 1
    let pe_mass = h_mass + f_mass; let pe_len = h_len + f_len; let pe_time = h_time + f_time
    if pe_mass == j_mass && pe_len == j_len && pe_time == j_time { n_pass = n_pass + 1 }

    // T8: unit_div_self — m/m = [0,1,0] - [0,1,0] = [0,0,0] = dimensionless ✓
    let ds_mass = 0 - 0; let ds_len = 1 - 1; let ds_time = 0 - 0
    if ds_mass == 0 && ds_len == 0 && ds_time == 0 { n_pass = n_pass + 1 }

    // T9: speed of light has dimension [m/s] = (0,1,-1)
    let c_mass = 0; let c_len = 1; let c_time = 0 - 1
    if c_len == 1 && c_time == 0 - 1 && c_mass == 0 { n_pass = n_pass + 1 }

    // T10: unit_pow_add — m^2 * m^3 = m^(2+3) = m^5 (exponent addition law)
    let pow_a = 2; let pow_b = 3; let pow_sum = pow_a + pow_b
    if pow_sum == 5 { n_pass = n_pass + 1 }

    if n_pass == 10 {
        println("theorem_units_dimensional: 10/10 PASS")
        return 0
    } else {
        println("theorem_units_dimensional: FAIL")
        return 1
    }
}
