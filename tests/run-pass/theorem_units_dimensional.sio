//@ run-pass
// Tests for stdlib/theorem/units.sio: dimensional analysis proofs

use theorem::kernel::*;
use theorem::units::*;

fn run_tests(ctx: &! ProofContext) -> i32 {
    // Test 1: N = kg * m / s^2
    let prf_newton = newton_is_kgms2(ctx)
    let conf1 = proof_confidence(ctx, prf_newton)
    if conf1 < 0.99 {
        return 1
    }

    // Test 2: J = kg * m^2 / s^2
    let prf_joule = joule_is_kgm2s2(ctx)
    let conf2 = proof_confidence(ctx, prf_joule)
    if conf2 < 0.99 {
        return 2
    }

    // Test 3: W = J / s
    let prf_watt = watt_is_js(ctx)
    let conf3 = proof_confidence(ctx, prf_watt)
    if conf3 < 0.99 {
        return 3
    }

    // Test 4: Pa = N / m^2
    let prf_pascal = pascal_is_nm2(ctx)
    let conf4 = proof_confidence(ctx, prf_pascal)
    if conf4 < 0.99 {
        return 4
    }

    // Test 5: E = mc^2 dimensional consistency
    let prf_emc2 = energy_mass_equiv(ctx)
    let conf5 = proof_confidence(ctx, prf_emc2)
    if conf5 < 0.99 {
        return 5
    }

    // Test 6: PV = nRT dimensional consistency
    let prf_gas = ideal_gas_law_consistent(ctx)
    let conf6 = proof_confidence(ctx, prf_gas)
    if conf6 < 0.99 {
        return 6
    }

    // Test 7: E = hf (Planck-Einstein)
    let prf_pe = planck_einstein_relation(ctx)
    let conf7 = proof_confidence(ctx, prf_pe)
    if conf7 < 0.99 {
        return 7
    }

    // Test 8: dim algebra — mul then div self = dimensionless
    let m_dim = dim_length()
    let m_unit = unit_new(ctx, 1001, m_dim, 1.0)
    let div_prf = unit_div_self(ctx, m_unit)
    let conf8 = proof_confidence(ctx, div_prf)
    if conf8 < 0.99 {
        return 8
    }

    // Test 9: speed_of_light has correct dimension [1,0,-1,0,0,0,0]
    let c = speed_of_light(ctx)
    if c.dim.length != 1 {
        return 9
    }
    if c.dim.time != 0 - 1 {
        return 10
    }
    if c.dim.mass != 0 {
        return 11
    }
    if c.value < 299792000.0 {
        return 12
    }

    // Test 10: unit_pow_add — a^m * a^n = a^(m+n)
    let pow_prf = unit_pow_add(ctx, m_unit, 2, 3)
    let conf10 = proof_confidence(ctx, pow_prf)
    if conf10 < 0.99 {
        return 13
    }

    return 0
}

fn main() -> i32 {
    var ctx = proof_context_new()
    return run_tests(&! ctx)
}
