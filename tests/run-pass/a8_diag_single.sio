//@ run-pass
// SINGLE-MODULE control: same Big struct + big_add, all in one file.
// If this passes but the cross-module version segfaults, the fault is the
// module boundary (merge/remap), not the struct shape.

struct Big {
    c: [i64; 256],
    bits: i32,
}

fn big_zero(k: i32) -> Big with Mut, Panic {
    Big { c: [0; 256], bits: k }
}

fn big_basis(k: i32, idx: i32) -> Big with Mut, Panic {
    var r = big_zero(k)
    r.c[idx as usize] = 1
    return r
}

fn big_add(a: Big, b: Big) -> Big with Mut, Panic {
    var r = big_zero(a.bits)
    var i: i32 = 0
    while i < 256 {
        r.c[i as usize] = a.c[i as usize] + b.c[i as usize]
        i = i + 1
    }
    return r
}

fn main() -> i64 with IO, Mut, Panic {
    let a = big_basis(4, 1)
    let b = big_basis(4, 2)
    let s = big_add(a, b)
    if s.c[1] == 1 && s.c[2] == 1 && s.c[0] == 0 && s.bits == 4 {
        println("A8_DIAG_SINGLE_OK")
        return 0
    }
    println("A8_DIAG_SINGLE_FAIL")
    return 1
}
