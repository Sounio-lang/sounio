//@ run-pass
//@ requires: madaros
//@ expect-stdout: lo 0.543409
//@ expect-stdout: hi 0.658620
//@ expect-stdout: refused 1
//@ expect-stdout: PLATEAU_REFUSED
// Ti30V60Cr10 + 4 wt.% Zr. Four plateau pressures. The value returned
// by the fit has no centre.

use epistemic::regression::plateau_pressure

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i64 with IO, Mut, Div, Panic {
    var xs: [f64; 8] = [0.0; 8]
    var ys: [f64; 8] = [0.0; 8]
    var uln: [f64; 8] = [0.0; 8]
    xs[0] = 1.0 / 398.0
    xs[1] = 1.0 / 423.0
    xs[2] = 1.0 / 448.0
    xs[3] = 1.0 / 498.0
    ys[0] = log(42.0 / 100.0)
    ys[1] = log(103.0 / 100.0)
    ys[2] = log(182.0 / 100.0)
    ys[3] = log(610.0 / 100.0)
    uln[0] = 3.0 / 42.0
    uln[1] = 1.0 / 103.0
    uln[2] = 2.0 / 182.0
    uln[3] = 1.0 / 610.0
    let published = plateau_pressure(xs, ys, uln, 4, 1.0 / 298.15, 100.0)
    var flag: i64 = 0
    if published.refused { flag = 1 }
    print("lo ")
    print_f64(published.lo)
    println("")
    print("hi ")
    print_f64(published.hi)
    println("")
    print("refused ")
    print_int(flag)
    println("")
    if published.open && published.refused && flag == 1 && near(published.lo, 0.5434085485562459, 0.000001) && near(published.hi, 0.6586200793137378, 0.000001) {
        println("PLATEAU_REFUSED")
        return 0
    }
    println("PLATEAU_FAIL")
    1
}
