//@ run-pass
//@ requires: madaros
//@ description: Scalar graph-colouring RUP proof-chain: K3 is not 2-colourable

fn card_exactly_one_clause_count(n: i64) -> i64 {
    if n <= 0 { return 0 }
    return 1 + (n * (n - 1)) / 2
}

fn card_colour_var(vertex: i64, colour_count: i64, colour: i64) -> i64 {
    if vertex < 0 { return 0 }
    if colour_count <= 0 { return 0 }
    if colour < 0 { return 0 }
    if colour >= colour_count { return 0 }
    return vertex * colour_count + colour + 1
}

fn card_colour_vertex_clause_id(vertex: i64, colour_count: i64, local_clause_id: i64) -> i64 {
    let per_vertex = card_exactly_one_clause_count(colour_count)
    if vertex < 0 { return 0 - 1 }
    if local_clause_id < 1 { return 0 - 1 }
    if local_clause_id > per_vertex { return 0 - 1 }
    return vertex * per_vertex + local_clause_id
}

fn card_colour_edge_base_id(vertex_count: i64, colour_count: i64) -> i64 {
    let per_vertex = card_exactly_one_clause_count(colour_count)
    if vertex_count < 0 { return 0 - 1 }
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex + 1
}

fn card_colour_vertex_block_count(vertex_count: i64, colour_count: i64) -> i64 {
    let per_vertex = card_exactly_one_clause_count(colour_count)
    if vertex_count < 0 { return 0 - 1 }
    if per_vertex <= 0 { return 0 - 1 }
    return vertex_count * per_vertex
}

fn card_colour_edge_clause_count(edge_count: i64, colour_count: i64) -> i64 {
    if edge_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return edge_count * colour_count
}

fn card_colour_total_clause_count(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let vertex_block = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_block = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    return vertex_block + edge_block
}

fn card_colour_var_count(vertex_count: i64, colour_count: i64) -> i64 {
    if vertex_count < 0 { return 0 - 1 }
    if colour_count <= 0 { return 0 - 1 }
    return vertex_count * colour_count
}

fn card_colour_manifest_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 1315423911) + value + 97) % 1000000007
}

fn card_colour_manifest_fingerprint(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let var_count = card_colour_var_count(vertex_count, colour_count)
    if var_count < 0 { return 0 - 1 }
    let vertex_block = card_colour_vertex_block_count(vertex_count, colour_count)
    if vertex_block < 0 { return 0 - 1 }
    let edge_base = card_colour_edge_base_id(vertex_count, colour_count)
    if edge_base < 0 { return 0 - 1 }
    let edge_block = card_colour_edge_clause_count(edge_count, colour_count)
    if edge_block < 0 { return 0 - 1 }
    let total = card_colour_total_clause_count(vertex_count, edge_count, colour_count)
    if total < 0 { return 0 - 1 }

    var acc: i64 = 17
    acc = card_colour_manifest_mix(acc, vertex_count)
    acc = card_colour_manifest_mix(acc, edge_count)
    acc = card_colour_manifest_mix(acc, colour_count)
    acc = card_colour_manifest_mix(acc, var_count)
    acc = card_colour_manifest_mix(acc, vertex_block)
    acc = card_colour_manifest_mix(acc, edge_base)
    acc = card_colour_manifest_mix(acc, edge_block)
    acc = card_colour_manifest_mix(acc, total)
    return acc
}

fn card_colour_first_derived_clause_id(vertex_count: i64, edge_count: i64, colour_count: i64) -> i64 {
    let total = card_colour_total_clause_count(vertex_count, edge_count, colour_count)
    if total < 0 { return 0 - 1 }
    return total + 1
}

fn card_colour_final_derived_clause_id(vertex_count: i64, edge_count: i64, colour_count: i64, derived_count: i64) -> i64 {
    if derived_count <= 0 { return 0 - 1 }
    let first = card_colour_first_derived_clause_id(vertex_count, edge_count, colour_count)
    if first < 0 { return 0 - 1 }
    return first + derived_count - 1
}

fn card_colour_lrat_header_valid(vertex_count: i64, edge_count: i64, colour_count: i64,
                                 manifest_fingerprint: i64, first_derived_id: i64) -> i64 {
    let expected_fp = card_colour_manifest_fingerprint(vertex_count, edge_count, colour_count)
    if expected_fp < 0 { return 0 }
    if manifest_fingerprint != expected_fp { return 0 }
    if first_derived_id != card_colour_first_derived_clause_id(vertex_count, edge_count, colour_count) { return 0 }
    return 1
}

fn card_colour_lrat_unsat_bundle_valid(vertex_count: i64, edge_count: i64, colour_count: i64,
                                       manifest_fingerprint: i64, first_derived_id: i64,
                                       derived_count: i64, final_derived_id: i64,
                                       final_clause_len: i64) -> i64 {
    if card_colour_lrat_header_valid(vertex_count, edge_count, colour_count, manifest_fingerprint, first_derived_id) == 0 { return 0 }
    if derived_count <= 0 { return 0 }
    if final_derived_id != card_colour_final_derived_clause_id(vertex_count, edge_count, colour_count, derived_count) { return 0 }
    if final_clause_len != 0 { return 0 }
    return 1
}

fn card_colour_lrat_bundle_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 389) % 1000000007
}

fn card_colour_lrat_unsat_bundle_fingerprint(vertex_count: i64, edge_count: i64, colour_count: i64,
                                             manifest_fingerprint: i64, first_derived_id: i64,
                                             derived_count: i64, final_derived_id: i64,
                                             final_clause_len: i64) -> i64 {
    if card_colour_lrat_unsat_bundle_valid(vertex_count, edge_count, colour_count,
                                           manifest_fingerprint, first_derived_id,
                                           derived_count, final_derived_id,
                                           final_clause_len) == 0 { return 0 - 1 }

    var acc: i64 = 29
    acc = card_colour_lrat_bundle_mix(acc, vertex_count)
    acc = card_colour_lrat_bundle_mix(acc, edge_count)
    acc = card_colour_lrat_bundle_mix(acc, colour_count)
    acc = card_colour_lrat_bundle_mix(acc, manifest_fingerprint)
    acc = card_colour_lrat_bundle_mix(acc, first_derived_id)
    acc = card_colour_lrat_bundle_mix(acc, derived_count)
    acc = card_colour_lrat_bundle_mix(acc, final_derived_id)
    acc = card_colour_lrat_bundle_mix(acc, final_clause_len)
    acc = card_colour_lrat_bundle_mix(acc, 1)
    return acc
}

fn colouring_replay_anchor_mix(acc: i64, value: i64) -> i64 {
    return ((acc * 16777619) + value + 431) % 1000000007
}

fn colouring_k3_lrat_bundle_replay_anchor(manifest_fingerprint: i64, bundle_fingerprint: i64,
                                          ok13: i64, ok14: i64, ok15: i64, ok16: i64,
                                          ok17: i64, ok18: i64, ok19: i64) -> i64 {
    if manifest_fingerprint < 0 { return 0 - 1 }
    if bundle_fingerprint < 0 { return 0 - 1 }
    if ok13 != 1 { return 0 - 1 }
    if ok14 != 1 { return 0 - 1 }
    if ok15 != 1 { return 0 - 1 }
    if ok16 != 1 { return 0 - 1 }
    if ok17 != 1 { return 0 - 1 }
    if ok18 != 1 { return 0 - 1 }
    if ok19 != 1 { return 0 - 1 }

    var acc: i64 = 31
    acc = colouring_replay_anchor_mix(acc, manifest_fingerprint)
    acc = colouring_replay_anchor_mix(acc, bundle_fingerprint)
    acc = colouring_replay_anchor_mix(acc, 13)
    acc = colouring_replay_anchor_mix(acc, 14)
    acc = colouring_replay_anchor_mix(acc, 15)
    acc = colouring_replay_anchor_mix(acc, 16)
    acc = colouring_replay_anchor_mix(acc, 17)
    acc = colouring_replay_anchor_mix(acc, 18)
    acc = colouring_replay_anchor_mix(acc, 19)
    acc = colouring_replay_anchor_mix(acc, ok13)
    acc = colouring_replay_anchor_mix(acc, ok14)
    acc = colouring_replay_anchor_mix(acc, ok15)
    acc = colouring_replay_anchor_mix(acc, ok16)
    acc = colouring_replay_anchor_mix(acc, ok17)
    acc = colouring_replay_anchor_mix(acc, ok18)
    acc = colouring_replay_anchor_mix(acc, ok19)
    return acc
}

fn card_colour_edge_clause_id(vertex_count: i64, colour_count: i64, edge_index: i64, colour: i64) -> i64 {
    let base = card_colour_edge_base_id(vertex_count, colour_count)
    if base < 1 { return 0 - 1 }
    if edge_index < 0 { return 0 - 1 }
    if colour < 0 { return 0 - 1 }
    if colour >= colour_count { return 0 - 1 }
    return base + edge_index * colour_count + colour
}

// Base clauses for K3 with two colours:
//   1:  v0c0 OR v0c1
//   3:  v1c0 OR v1c1
//   5:  v2c0 OR v2c1
//   7: -v0c0 OR -v1c0
//   8: -v0c1 OR -v1c1
//   9: -v0c0 OR -v2c0
//  10: -v0c1 OR -v2c1
//  11: -v1c0 OR -v2c0
//  12: -v1c1 OR -v2c1
//
// RUP lemmas:
//  13: -v0c0 OR v1c1
//  14: -v0c1 OR v1c0
//  15: -v0c0 OR v2c1
//  16: -v0c1 OR v2c0
//  17: -v0c0
//  18: -v0c1
//  19: empty

fn check_lemma13() -> i64 {
    var v0c0: i64 = 1       // negated candidate: v0c0
    var v1c1: i64 = 0 - 1   // negated candidate: not v1c1
    var v1c0: i64 = 0

    // Hint 7: -v0c0 OR -v1c0 propagates not v1c0.
    if v0c0 == 1 {
        if v1c0 == 1 { return 1 }
        v1c0 = 0 - 1
    }

    // Hint 3: v1c0 OR v1c1 now conflicts.
    if v1c0 == (0 - 1) {
        if v1c1 == (0 - 1) { return 1 }
    }
    return 0
}

fn check_lemma14() -> i64 {
    var v0c1: i64 = 1
    var v1c0: i64 = 0 - 1
    var v1c1: i64 = 0

    // Hint 8: -v0c1 OR -v1c1.
    if v0c1 == 1 {
        if v1c1 == 1 { return 1 }
        v1c1 = 0 - 1
    }

    // Hint 3: v1c0 OR v1c1.
    if v1c0 == (0 - 1) {
        if v1c1 == (0 - 1) { return 1 }
    }
    return 0
}

fn check_lemma15() -> i64 {
    var v0c0: i64 = 1
    var v2c1: i64 = 0 - 1
    var v2c0: i64 = 0

    // Hint 9: -v0c0 OR -v2c0.
    if v0c0 == 1 {
        if v2c0 == 1 { return 1 }
        v2c0 = 0 - 1
    }

    // Hint 5: v2c0 OR v2c1.
    if v2c0 == (0 - 1) {
        if v2c1 == (0 - 1) { return 1 }
    }
    return 0
}

fn check_lemma16() -> i64 {
    var v0c1: i64 = 1
    var v2c0: i64 = 0 - 1
    var v2c1: i64 = 0

    // Hint 10: -v0c1 OR -v2c1.
    if v0c1 == 1 {
        if v2c1 == 1 { return 1 }
        v2c1 = 0 - 1
    }

    // Hint 5: v2c0 OR v2c1.
    if v2c0 == (0 - 1) {
        if v2c1 == (0 - 1) { return 1 }
    }
    return 0
}

fn check_lemma17() -> i64 {
    var v0c0: i64 = 1
    var v1c1: i64 = 0
    var v2c1: i64 = 0

    // Hint 13: -v0c0 OR v1c1.
    if v0c0 == 1 { v1c1 = 1 }
    // Hint 15: -v0c0 OR v2c1.
    if v0c0 == 1 { v2c1 = 1 }
    // Hint 12: -v1c1 OR -v2c1.
    if v1c1 == 1 {
        if v2c1 == 1 { return 1 }
    }
    return 0
}

fn check_lemma18() -> i64 {
    var v0c1: i64 = 1
    var v1c0: i64 = 0
    var v2c0: i64 = 0

    // Hint 14: -v0c1 OR v1c0.
    if v0c1 == 1 { v1c0 = 1 }
    // Hint 16: -v0c1 OR v2c0.
    if v0c1 == 1 { v2c0 = 1 }
    // Hint 11: -v1c0 OR -v2c0.
    if v1c0 == 1 {
        if v2c0 == 1 { return 1 }
    }
    return 0
}

fn check_empty_clause() -> i64 {
    var v0c0: i64 = 0
    var v0c1: i64 = 0

    // Hint 17: -v0c0.
    v0c0 = 0 - 1
    // Hint 18: -v0c1.
    v0c1 = 0 - 1
    // Hint 1: v0c0 OR v0c1.
    if v0c0 == (0 - 1) {
        if v0c1 == (0 - 1) { return 1 }
    }
    return 0
}

fn check_lemma13_missing_alo() -> i64 {
    var v0c0: i64 = 1
    var v1c0: i64 = 0

    // Only hint 7 propagates; without hint 3 there is no conflict.
    if v0c0 == 1 { v1c0 = 0 - 1 }
    if v1c0 == (0 - 1) { return 0 }
    return 1
}

fn check_empty_missing_units() -> i64 {
    // With only lemmas through id 16 active, hints 17 and 18 do not exist.
    return 0
}

fn main() -> i64 {
    let k: i64 = 2
    let n: i64 = 3
    let m: i64 = 3
    let manifest_fp: i64 = card_colour_manifest_fingerprint(n, m, k)
    let bundle_fp: i64 = card_colour_lrat_unsat_bundle_fingerprint(n, m, k, manifest_fp, 13, 7, 19, 0)

    if card_colour_var(2, k, 1) != 6 { return 1 }
    if card_colour_vertex_clause_id(2, k, 2) != 6 { return 2 }
    if card_colour_edge_clause_id(3, k, 2, 1) != 12 { return 3 }
    if manifest_fp != 296728038 { return 4 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, manifest_fp, 13, 7, 19, 0) != 1 { return 5 }
    if bundle_fp != 500954697 { return 6 }

    if check_lemma13() != 1 { return 10 }
    if check_lemma14() != 1 { return 11 }
    if check_lemma15() != 1 { return 12 }
    if check_lemma16() != 1 { return 13 }
    if check_lemma17() != 1 { return 14 }
    if check_lemma18() != 1 { return 15 }
    if check_empty_clause() != 1 { return 16 }
    if colouring_k3_lrat_bundle_replay_anchor(manifest_fp, bundle_fp,
                                              check_lemma13(), check_lemma14(),
                                              check_lemma15(), check_lemma16(),
                                              check_lemma17(), check_lemma18(),
                                              check_empty_clause()) != 891522734 { return 17 }

    if check_lemma13_missing_alo() != 0 { return 20 }
    if check_empty_missing_units() != 0 { return 21 }
    if card_colour_lrat_unsat_bundle_valid(n, m, k, manifest_fp, 13, 7, 18, 0) != 0 { return 22 }
    if colouring_k3_lrat_bundle_replay_anchor(manifest_fp, bundle_fp,
                                              0, check_lemma14(),
                                              check_lemma15(), check_lemma16(),
                                              check_lemma17(), check_lemma18(),
                                              check_empty_clause()) != (0 - 1) { return 23 }

    return 0
}
