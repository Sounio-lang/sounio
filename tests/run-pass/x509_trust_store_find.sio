//@ run-pass
//@ requires: madaros
use x509::trust_store::*
use x509::cert::*

fn main() -> i64 with IO, Mut, Div, Panic {
    let (store, err) = trust_store_load()
    if err != 0 {
        print_int(1)
        return 1
    }
    if store.count < 1 {
        print_int(2)
        return 1
    }

    // The first real root in the store, whatever CA it happens to be --
    // this test does not hardcode which one.
    let first_subject = store.certs[0].subject
    let idx = trust_store_find_by_subject(&store, &first_subject)
    if idx != 0 {
        print_int(3)
        return 1
    }

    // An obviously-absent name (zero RDN entries) must not match anything.
    let absent = x509_name_zero()
    let absent_idx = trust_store_find_by_subject(&store, &absent)
    if absent_idx != (0 - 1) {
        print_int(4)
        return 1
    }

    println("x509_trust_store_find: found real root, rejected absent name")
    return 0
}
