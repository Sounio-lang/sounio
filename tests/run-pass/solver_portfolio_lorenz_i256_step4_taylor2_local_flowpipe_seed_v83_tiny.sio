//@ run-pass
//@ requires: madaros
//@ description: Tiny portfolio v83 smoke for Lorenz i256 step-4 Taylor-2 local flowpipe seed

fn mix(acc: i64, value: i64, salt: i64) -> i64 with Mod {
    return ((acc * 16777619) + value + salt) % 1000000007
}

fn main() -> i64 {
    var receipt_fp: i64 = 1609
    receipt_fp = mix(receipt_fp, 563331437, 5483)
    receipt_fp = mix(receipt_fp, 684718822, 5483)
