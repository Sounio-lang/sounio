//@ run-pass
//@ expect-stdout: MADAROS_GUM_FO_PK_IMPORT_PASS

// Multi-mod science FO — oral Css via imported epistemic::fo helpers.
// Mirrors examples/epistemic_fo_second_order/fo_pk_exposure_import_driver.sio.
// Analytic refs match same-module madaros_gum_fo_pk_exposure / audit table.

use epistemic::fo::{fo_infusion_rate, fo_clearance, fo_css, fo_mul2}

fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn local_css(f: f64, dose: f64, tau: f64, cl0: f64, eta: f64) -> f64 {
    ((f * dose) / tau) / (cl0 * exp(eta))
}

fn main() with IO, Mut, Div, Epistemic {
    let kF: Knowledge<f64> = measure(0.8, uncertainty: 0.05)
    let kDose: Knowledge<f64> = measure(500.0, uncertainty: 10.0)
    let kTau: Knowledge<f64> = measure(12.0, uncertainty: 0.0)
    let kCL0: Knowledge<f64> = measure(5.0, uncertainty: 0.3)
    let kEta: Knowledge<f64> = measure(0.0, uncertainty: 0.1)

    let f = kF.value
    let dose = kDose.value
    let tau = kTau.value
    let cl0 = kCL0.value
    let eta = kEta.value

    let css = fo_css(f, dose, tau, cl0, eta)
    let css_pt = (0.8 * 500.0 / 12.0) / 5.0

    let v_rate = variance_of(fo_infusion_rate(f, dose, tau))
    let v_cl = variance_of(fo_clearance(cl0, eta))
    let v_css = variance_of(fo_css(f, dose, tau, cl0, eta))
    let v_css_local = variance_of(local_css(f, dose, tau, cl0, eta))
    let m2 = second_order_mean(fo_css(f, dose, tau, cl0, eta))
    let h = hessian_diag_of(fo_css(f, dose, tau, cl0, eta))

    let v_kprod = variance_of((kF * kDose).value)
    let v_mul2 = variance_of(fo_mul2(f, dose))
    let v_shared = variance_of(fo_clearance(5.0, eta) * fo_clearance(50.0, eta))

    print("css="); print_f64(css); print("\n")
    print("v_rate="); print_f64(v_rate); print("\n")
    print("v_cl="); print_f64(v_cl); print("\n")
    print("v_css="); print_f64(v_css); print("\n")
    print("v_css_local="); print_f64(v_css_local); print("\n")
    print("m2="); print_f64(m2); print("\n")
    print("h="); print_f64(h); print("\n")
    print("v_mul2="); print_f64(v_mul2); print("\n")
    print("v_shared="); print_f64(v_shared); print("\n")

    let ok = abs_f(css - css_pt) < 1.0e-9
        && abs_f(v_rate - 4.784722222222) < 1.0e-6
        && abs_f(v_cl - 0.34) < 1.0e-9
        && abs_f(v_css - v_css_local) < 1.0e-9
        && abs_f(v_css - 0.795833) < 1.0e-4
        && abs_f(m2 - 6.724) < 1.0e-3
        && abs_f(m2 - css) > 1.0e-4
        && abs_f(h) > 1.0e-9
        && abs_f(v_mul2 - v_kprod) < 1.0e-9
        && v_kprod > 1.0
        && abs_f(v_shared - 2500.0) < 1.0e-6
    if ok {
        print("MADAROS_GUM_FO_PK_IMPORT_PASS\n")
    } else {
        print("MADAROS_GUM_FO_PK_IMPORT_FAIL\n")
    }
}
