//@ run-pass
//@ requires: madaros
//@ description: a user effect declared in an imported module resolves on Madaros
// The importer is collected before the module it imports, so `with HostT`
// below was E246 even after the ItemEffect arm landed; the multi-module
// driver now registers every module's effects before any signature.

use user_effect_import_a::{HostT, host_add}

fn main() -> i64 with HostT {
    if host_add(41) == 42 { 0 } else { 1 }
}
