//@ run-pass
//
// Regression pin: cross-module large-struct SRET forwarding (2026-06-02).
// cd_mul returns a large CDElement (c: [f64; 2048]) across a stdlib import;
// this shape used to FAIL via the SRET-forwarding bug family
// (BLK-20260602-SRET-FORWARDING-IMPORTS). Fixed as of the 2026-06-10 re-audit
// (docs/audit/MODULAR_COMPILER_AUDIT_2026-06-10.md).
// History: docs/audit/g1_wip/MODULAR_CROSS_SRET_cd_mul_repro_2026-06-02.sio

use algebra::cayley_dickson::{cd_mul, cd_basis}

fn main() -> i64 with IO, Mut, Div, Panic {
    let e0 = cd_basis(5, 0)
    let e1 = cd_basis(5, 1)
    let p = cd_mul(e0, e1)
    // For e0 * e1 == e1 (one of the basis), p.c[1] == 1.0
    if p.c[1] > 0.5 {
        println("CD_MUL_CROSS_SRET_OK")
        return 0
    }
    println("CD_MUL_CROSS_SRET_FAIL")
    return 1
}
