//@ run-pass
//@ requires: madaros
//@ expect-stdout: ns-join-ifelse: PASS
//
// N2 negative control (codex ruling 2026-08-23): before this fix there was
// NO CFG join at all -- `if c {measure(1)} else {measure(2)}` silently kept
// only the then-branch's noise_set_id (checker_check_if_expr_inplace
// returned `then_ty` unconditionally on the else-arm). The fix unions the
// two arms' sets (ns_union already treats a negative/top operand as
// absorbing -- REQ-4 -- so this is exactly "union of the known IDs, top if
// either is top", not a special case).
//
// Observable only under SOUNIO_NS_TRACE=1: two "NS_TRACE measure=<h>" seed
// lines with DISTINCT handles (one per arm), two "NS_TRACE union=<h>" lines
// for each arm's own laundering step, then one "NS_TRACE if_join=<h>" line
// whose handle differs from EITHER arm's own union handle (i.e. genuinely
// combines both, not "the then-branch's value").
//
// Per-rule sabotage: SOUNIO_NS_SABOTAGE_JOIN=1 skips the join, reproducing
// the pre-fix "if_join equals the then-branch's handle" bug -- the
// then/if_join handles become equal again, which is the observable proof
// the join rule (not something else) was doing the work.

fn main() -> i64 with IO {
    let cond = true
    let r: Knowledge[f64, epsilon < 1.0] = if cond {
        let s: Knowledge<f64> = measure(1.0, uncertainty: 0.1)
        let w: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
        s + w
    } else {
        let s2: Knowledge<f64> = measure(2.0, uncertainty: 0.1)
        let w2: Knowledge[f64, epsilon < 1.0] = Knowledge(0.0, ε = 0.05)
        s2 + w2
    }
    println("ns-join-ifelse: PASS")
    0
}
