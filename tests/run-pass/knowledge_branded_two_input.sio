//@ run-pass
//@ requires: madaros
//@ expect-stdout: TWO_INPUT_BRANDED_OK
// Two independently measured ontology species participate in one reaction.
// The product rule must keep both Knowledge<T> sources at the function edge.

ontology Reaction {
    class Substance { property amount: f64 where amount >= 0.0 }
    class FuelCarrier subclass_of Substance
    class OxidantCarrier subclass_of Substance
    disjoint FuelCarrier, OxidantCarrier
}

fn reaction_extent(fuel: Knowledge<FuelCarrier>, oxidant: Knowledge<OxidantCarrier>) -> f64 with Epistemic, Mut, Div {
    let f: f64 = fuel.value
    let o: f64 = oxidant.value
    f * o
}

fn near(actual: f64, expected: f64, tol: f64) -> bool {
    let d = actual - expected
    if d < 0.0 { return (0.0 - d) < tol }
    d < tol
}

fn main() -> i32 with IO, Mut, Div, Epistemic {
    let fuel_value: FuelCarrier = 10.0
    let oxidant_value: OxidantCarrier = 2.0
    let fuel: Knowledge<FuelCarrier> = measure(fuel_value, uncertainty: 0.1)
    let oxidant: Knowledge<OxidantCarrier> = measure(oxidant_value, uncertainty: 0.2)
    let extent = reaction_extent(fuel, oxidant)
    // Var(f*o) = o^2 Var(f) + f^2 Var(o), independent inputs.
    let expected = 2.0 * 2.0 * 0.1 * 0.1 + 10.0 * 10.0 * 0.2 * 0.2

    print("extent ")
    print_f64(extent)
    print(" variance ")
    print_f64(variance_of(extent))
    print("\n")

    if near(extent, 20.0, 0.0001) && near(variance_of(extent), expected, 0.0001) {
        println("TWO_INPUT_BRANDED_OK")
        return 0
    }
    println("TWO_INPUT_BRANDED_FAIL")
    1
}
