//@ run-pass
//@ description: struct field shorthand init and value-struct-root two-level nested array store
//
// Regression guards for two general (x86+a64) codegen bugs:
//  1. Struct shorthand `T { x, y }` (no colon) silently initialised fields to 0
//     because the value-compile path read the comma/brace instead of the variable.
//  2. A two-level nested array store through a VALUE-struct root,
//     `s.inner.vals[i] = v`, was dropped (the dispatch only handled pointer roots).

struct Pair { x: i64, y: i64 }
struct Inner { vals: [i64; 2] }
struct Outer { inner: Inner, tag: i64 }

fn mk_pair(x: i64, y: i64) -> Pair { return Pair { x, y } }  // shorthand

fn build() -> Outer with Mut, Panic, Div {
    var s = Outer { inner: Inner { vals: [0; 2] }, tag: 0 }
    s.inner.vals[0] = 10   // value-root two-level nested array store
    s.inner.vals[1] = 32
    s.tag = 1
    return s
}

fn main() -> i32 with IO, Mut, Panic, Div {
    var fail: i64 = 0

    let p = mk_pair(19, 23)
    if p.x + p.y == 42 { print("shorthand PASS\n") } else { print("shorthand FAIL\n"); fail = fail + 1 }

    let s = build()
    if s.tag != 1 { print("tag FAIL\n"); fail = fail + 1 }
    if s.inner.vals[0] + s.inner.vals[1] == 42 { print("nested-store PASS\n") } else { print("nested-store FAIL\n"); fail = fail + 1 }

    if fail == 0 { print("struct_shorthand_and_nested_array_store: ALL PASS\n"); return 0 }
    print("struct_shorthand_and_nested_array_store: SOME FAIL\n")
    return 1 as i32
}
