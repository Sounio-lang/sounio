//@ run-pass
//@ expect-stdout: unit param forwarded: PASS
// A unit-typed parameter passed on to another unit-typed parameter. No test
// covered this: existing tests pass locals or cast results, never a parameter
// forwarded onward, which is the form that erased the brand at every boundary.
// The comparison checks the VALUE, so a brand that survives while the number
// does not would still fail.

unit molal = mol / kg;

fn inner(x: molal) -> f64 with Mut {
    x
}

fn relay(v: molal) -> f64 with Mut {
    inner(v)
}

fn main() -> i32 with IO, Mut, Panic, Div {
    let m: molal = 2.5
    let r = relay(m)
    if r == 2.5 {
        print("unit param forwarded: PASS\n")
    }
    return 0
}
