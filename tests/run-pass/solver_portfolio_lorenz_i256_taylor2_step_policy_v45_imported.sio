//@ run-pass
//@ requires: madaros
//@ description: Imported portfolio v45 smoke for Lorenz i256 Taylor-2 step-policy entry

use theorem::portfolio::*

fn main() -> i64 {
    let receipt_fp = solver_portfolio_v45_lorenz_i256_taylor2_step_policy_fingerprint(
        403306384, 635367450, 485944472, 898788381, 101774289, 13149, 63)
    if receipt_fp != 486061656 { return 1 }

    let audit_fp = solver_portfolio_v45_lorenz_i256_taylor2_step_policy_audit_fingerprint(
        receipt_fp, 403306384, 635367450, 873855189, 311965616,
        101774289, 13149, 63)
    if audit_fp != 85088711 { return 2 }

    let manifest_fp = solver_portfolio_v45_lorenz_i256_taylor2_step_policy_bundle_fingerprint(
        receipt_fp, audit_fp)
    if manifest_fp != 975812377 { return 3 }

    let result_fp = solver_portfolio_v45_result_coverage_fingerprint(
        45, 49, 10, 37, 1, 1, manifest_fp)
    if result_fp != 151193920 { return 4 }

    let family_fp = solver_portfolio_v45_checker_family_coverage_fingerprint(
        45, 49, 6, 4, 3, 2, 32, 2, manifest_fp)
    if family_fp != 7064905 { return 5 }

    let acceptance_fp = solver_portfolio_v45_acceptance_receipt_fingerprint(
        45, manifest_fp, result_fp)
    if acceptance_fp != 781479558 { return 6 }

    let audit_receipt_fp = solver_portfolio_v45_audit_receipt_fingerprint(
        45, manifest_fp, result_fp, family_fp, acceptance_fp)
    if audit_receipt_fp != 394956465 { return 7 }

    let readiness_fp = solver_portfolio_v45_readiness_fingerprint(
        45, manifest_fp, result_fp, family_fp, acceptance_fp, audit_receipt_fp)
    if readiness_fp != 498384393 { return 8 }

    return 0
}
