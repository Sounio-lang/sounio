//@ run-pass
//@ expect-stdout: 42
// #901 facade vertical: logical prob::lib must close over its physical modules,
// survive modular checking/lowering, and execute as a native ELF.
use prob::lib::{uniform_mean}

fn main() -> i32 with IO, Mut, Div, Panic {
    let mean = uniform_mean(0.0, 10.0)
    if mean < 4.999999 || mean > 5.000001 {
        return 1
    }
    println("42")
    0
}
