//@ run-pass
//@ requires: madaros

affine struct Permit {
    id: i64,
}

struct Boxed<T> {
    value: T,
}

fn open(boxed: Boxed<Permit>) -> i64 {
    boxed.value.id
}

fn main() -> i32 with Panic {
    let permit = Permit { id: 79 }
    let boxed: Boxed<Permit> = Boxed { value: permit }
    assert(open(boxed) == 79)
    0
}
