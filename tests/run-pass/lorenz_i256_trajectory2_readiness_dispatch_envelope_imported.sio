//@ run-pass
//@ description: Imported Lorenz i256 bounded trajectory readiness dispatch envelope smoke (status 121)

use systems::lorenz_i256_trajectory2_acceptance_bounded_bridge::*
use systems::lorenz_i256_trajectory2_readiness_dispatch_envelope::*

fn main() -> i64 with Div {
    let acceptance_readiness = lorenz_i256_trajectory2_acceptance_bounded_readiness_fingerprint(
        294601254, 846135279, 918274650, 31, 73, 118, 120, 256, 1000000000)
    if acceptance_readiness != 9371853 { return 1 }

    let mask = lorenz_i256_trajectory2_readiness_dispatch_mask(
        73, 118, 1, 1, 1, 1, 0, 0, 0, 0)
    if mask != 63 { return 2 }

    let bad_family_mask = lorenz_i256_trajectory2_readiness_dispatch_mask(
        74, 118, 1, 1, 1, 1, 0, 0, 0, 0)
    if bad_family_mask != 62 { return 3 }

    let bad_claim_mask = lorenz_i256_trajectory2_readiness_dispatch_mask(
        73, 118, 1, 1, 1, 1, 0, 0, 1, 0)
    if bad_claim_mask != 31 { return 4 }

    let query = lorenz_i256_trajectory2_readiness_dispatch_query(
        73, 118, 31, acceptance_readiness, 63, 1, 0, 0, 0, 0, 256, 1000000000)
    if query != 9371853 { return 5 }

    let query_reject = lorenz_i256_trajectory2_readiness_dispatch_query(
        73, 118, 31, acceptance_readiness, 62, 1, 0, 0, 0, 0, 256, 1000000000)
    if query_reject != 0 - 1 { return 6 }

    let envelope = lorenz_i256_trajectory2_readiness_dispatch_envelope_fingerprint(
        acceptance_readiness, 31, 63, 73, 118, 121, 256, 1000000000)
    if envelope != 9387383 { return 7 }

    let envelope_reject = lorenz_i256_trajectory2_readiness_dispatch_envelope_fingerprint(
        acceptance_readiness, 27, 63, 73, 118, 121, 256, 1000000000)
    if envelope_reject != 0 - 1 { return 8 }

    let artifact = lorenz_i256_trajectory2_readiness_dispatch_receipt_check(
        1, 1, 1, 1, 1, 256, 1000000000, 0, 0, 0, 0, 121)
    if artifact != 682914503 { return 9 }
    return 0
}
