//@ run-pass
//@ requires: lean_single
// Seed initializer-emission contract; the dedicated gate also tests modular BSS.
// A previous initializer may write a global whose own zero initializer is later.
var EARLY_ZERO: [i64; 4096] = [0; 4096]
var NONZERO: [i64; 4] = [7; 4]

fn touch_later_zero() -> i64 with Mut, Panic {
    EARLY_ZERO[0] = 11
    LATE_ZERO[0] = 23
    LATE_ZERO[4095] = 29
    31
}

var EFFECT_RESULT: i64 = touch_later_zero()
var LATE_ZERO: [i64; 4096] = [0; 4096]

fn main() -> i32 with IO, Mut, Panic {
    if EARLY_ZERO[0] != 11 { return 1 }
    if EARLY_ZERO[4095] != 0 { return 2 }
    if NONZERO[0] != 7 || NONZERO[3] != 7 { return 3 }
    if EFFECT_RESULT != 31 { return 4 }
    if LATE_ZERO[0] != 0 || LATE_ZERO[4095] != 0 { return 5 }
    println("GLOBAL_ZERO_ORDER_OK")
    0
}
