//@ run-pass
//@ requires: madaros
//@ expect-stdout: SA_PT=3.500000
//@ expect-stdout: SC_PT=10.000000
//@ description: #2773 -- two modules defining the SAME struct (identical fields) stay accepted; only differing same-named structs are refused (see tests/compile-fail/madaros_module_same_struct_differs.sio).
use testmod::nr_sa::{nr_sa_pt_sum}
use testmod::nr_sc::{nr_sc_pt_prod}

fn main() -> i32 with IO {
    print("SA_PT=")
    print_f64(nr_sa_pt_sum(2.5))
    println("")
    print("SC_PT=")
    print_f64(nr_sc_pt_prod(2.5))
    println("")
    0
}
