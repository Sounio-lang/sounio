//@ run-pass
//@ timeout: 90
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — VENLAFAXINE XR (SISTEMA 2)
//
// Controlled-release witness: Korsmeyer-Peppas erodible matrix (oral XR) feeding
// TWO coupled PBPK28 compartments — parent (venlafaxine) and active metabolite
// ODV — bridged by hepatic CYP2D6 formation (organ 1 = liver).
//
// This ref runs the stdlib scenario ITSELF (scenarios/venlafaxine_xr.sio): its
// step, its implicit formation sink, its matrix model, its steady-state audit
// and its closed form. It holds no copy of the model. The Sounio side of the
// gate therefore witnesses the code the dissertation uses; the Node side
// (website/src/lib/pbpk28_core.mjs) is the independent reimplementation it is
// compared against. The earlier ref was a self-contained copy, and the gate
// compared two copies with each other: it stayed green while the scenario moved
// to the implicit sink (PR #2699 review).
//
// Formation is a first-order sink CL_form·C_liver,avg solved inside the parent
// CN step (pbpk28_full_cn_step_sink_mut); ODV receives exactly the mass the
// sink removed.
//
// Ratio readout: steady-state C_avg ODV/parent blood ratio, AUC_ODV/AUC_parent
// over the 10th interval of 75 mg XR q24h (vfx_ss_regimen_interval), with the
// closed form of the same model and the error bound the scenario certifies on
// the run (derivation in the scenario header).
//
// Companion: scripts/ci/dissertation_pbpk28_parity_gate.sh cases 10-13 diff this
// against the Node engine within 1.0% RMSE per organ (parent + ODV cavg) plus
// matrix release (case 12, biomaterial bridge) and the steady-state ratio at
// dt = 0.5 and 0.25 h (case 13; each engine must also certify the closed form).
// Parity runs at NM (R7); PM/IM/UM are scaling verified by the pgx smoke.
//
// Sources: Gohel 2008 (matrix n=0.65/k=0.199), Wang 2022 (F_XR=0.45, ka=0.63),
// Lessard 1999 oral/apparent (CL_form 43; CL_parent 57 = 100 - 43 L/h),
// Wyeth label (CL_odv 28 L/h).
// ============================================================================

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::tsit5_pbpk28::*
use darwin_pbpk::release::matrix_er::*
use darwin_pbpk::scenarios::venlafaxine_xr::*

fn nm() -> i32 { return 2 }

fn emit_state(prefix: i32, st: PBPKState28, p: PBPKParams28, t: f64) with IO, Mut, Div {
    var i: i32 = 0
    while i < 14 {
        if prefix == 0 { print("VPARENT|t=") } else { print("VODV|t=") }
        println(t)
        println("")
        if prefix == 0 { print("VPARENT|i=") } else { print("VODV|i=") }
        println(i)
        if prefix == 0 { print("VPARENT|cv=") } else { print("VODV|cv=") }
        println(st.cv[i])
        println("")
        if prefix == 0 { print("VPARENT|ct=") } else { print("VODV|ct=") }
        println(st.ct[i])
        println("")
        if prefix == 0 { print("VPARENT|cavg=") } else { print("VODV|cavg=") }
        println(pbpk28_organ_average(st, p, i))
        println("")
        i = i + 1
    }
}

fn emit_at(scen: VenlafaxineXrScenario, rel: MatrixReleaseModel, t: f64) with IO, Mut, Div, Panic {
    let pp = pbpk28_params_venlafaxine_parent()
    let op = pbpk28_params_venlafaxine_odv()
    emit_state(0, scen.parent, pp, t)
    emit_state(1, scen.odv, op, t)
    print("VMATRIX|t=")
    println(t)
    println("")
    print("VMATRIX|rel=")
    println(matrix_cumulative(rel, t))
    println("")
    print("VMASS|p=")
    println(pbpk28_total_mass(scen.parent, pp))
    println("")
    print("VMASS|o=")
    println(pbpk28_total_mass(scen.odv, op))
    println("")
}

// 75 mg XR q24h, 10th interval, through the scenario's own audit. Returns 1
// when the closed form lies inside the run's certified interval, 0 otherwise
// (main fails the run on 0). Fails closed when the parent bound swallows the
// parent AUC: the scenario then reports an unbounded upper end.
fn emit_ss(dt: f64) -> i64 with IO, Mut, Div, Panic {
    let iv = vfx_ss_regimen_interval(nm(), dt)
    let ratio = vfx_ss_ratio(iv)
    let lo = vfx_ss_ratio_lo(iv)
    let hi = vfx_ss_ratio_hi(iv)
    let cf = vfx_ss_ratio_closed_form(nm())
    var certified: i64 = 0
    if iv.auc_parent > iv.err_auc_parent && lo <= cf && cf <= hi { certified = 1 }
    print("VSS|dt=")
    println(dt)
    println("")
    print("VSS|auc_parent=")
    println(iv.auc_parent)
    println("")
    print("VSS|auc_odv=")
    println(iv.auc_odv)
    println("")
    print("VSS|ratio=")
    println(ratio)
    println("")
    print("VSS|cf=")
    println(cf)
    println("")
    // Diagnostics scaled by 1e12: Madaros prints every f64 as 6-decimal fixed
    // (lean_single switches to scientific below 1e-6), so unscaled values in the
    // 1e-13..1e-7 range would print as 0.000000 under Madaros.
    print("VSS|rel_err_cf_e12=")
    println(1.0e12 * (ratio - cf) / cf)
    println("")
    print("VSS|rel_halfwidth_e12=")
    println(1.0e12 * 0.5 * (hi - lo) / ratio)
    println("")
    print("VSS|certified=")
    println(certified)
    return certified
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_VENLAFAXINE_PARITY_REF v3")
    println("compartments=14")
    println("dt=0.5")
    println("dose_mg=75.0")
    println("matrix_n=0.65")
    println("matrix_k=0.199")
    println("F_oral_xr=0.45")
    println("ka_h_inv=0.63")
    println("cl_form_nm_L_per_h=43.0")
    println("integrator=fully_coupled_CN_27state_x2")
    println("drug=venlafaxine")
    println("release=korsmeyer_peppas_matrix")
    println("samples=12")
    println("formation=implicit_liver_sink")
    println("ratio_readout=ss_cavg_q24h_interval10")
    println("model=stdlib_scenario")

    let dt = 0.5
    let rel = venlafaxine_xr_matrix_gohel2008()
    var s = vfx_scenario_init(nm())
    var t = 0.0

    s = vfx_integrate_to(s, rel, t,  1.0, dt); t =  1.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t,  2.0, dt); t =  2.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t,  4.0, dt); t =  4.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t,  6.0, dt); t =  6.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t,  8.0, dt); t =  8.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t, 12.0, dt); t = 12.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t, 18.0, dt); t = 18.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t, 24.0, dt); t = 24.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t, 36.0, dt); t = 36.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t, 48.0, dt); t = 48.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t, 72.0, dt); t = 72.0; emit_at(s, rel, t)
    s = vfx_integrate_to(s, rel, t, 96.0, dt); t = 96.0; emit_at(s, rel, t)

    // Steady-state ratio at two step sizes; both must certify the closed form,
    // and the run fails (nonzero exit) if either does not, so the run-pass
    // suite enforces it without the parity gate.
    var failed: i32 = 0
    if emit_ss(0.5) != 1 { failed = failed + 1 }
    if emit_ss(0.25) != 1 { failed = failed + 1 }
    if failed != 0 {
        println("VSS|FAIL closed form outside a certified interval")
        return failed
    }

    println("DISSERTATION_PBPK28_VENLAFAXINE_PARITY_DONE")
    return 0
}
