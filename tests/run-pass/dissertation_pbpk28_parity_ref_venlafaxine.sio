//@ run-pass
//@ timeout: 90
//@ expect-stdout-contains: DISSERTATION_PBPK28_VENLAFAXINE_PARITY_DONE
// ============================================================================
// DISSERTATION PBPK28 PARITY REFERENCE — VENLAFAXINE XR (SISTEMA 2)
//
// Controlled-release witness: Korsmeyer-Peppas erodible matrix (oral XR) feeding
// TWO coupled PBPK28 compartments — parent (venlafaxine) and active metabolite
// ODV — bridged by hepatic CYP2D6 formation on the liver (organ 1).
//
// This reference drives the stdlib scenario's own step functions
// (stdlib/darwin_pbpk/scenarios/venlafaxine_xr.sio: vfx_gut_release_step,
// vfx_parent_step_with_formation, vfx_odv_step) in the same order as its
// vfx_strang_step, so the Sounio side of the parity IS the canonical model, not
// a copy of it that can drift. It keeps its own states and ledgers only because
// the scenario struct's fields are private. The Node side
// (website/src/lib/pbpk28_core.mjs, runVenlafaxineScenario) is an independent
// reimplementation of the same model and of the TR-BDF2 kernel.
//
// Model (portal first pass): the gut pool dG/dt = R − ka·G is solved exactly
// over each step with the matrix release entering at a constant rate; F_abs of
// the mass leaving the lumen enters the liver's vascular space and
// 1 − F_abs never reaches the portal vein. Hepatic clearance is a liver sink
// inside the TR-BDF2 implicit solve, so F_H = Q/(Q + X) and presystemic ODV
// formation emerge; F_oral = F_abs·F_H = 0.45 at NM by construction.
//
// Companion: scripts/ci/dissertation_pbpk28_parity_gate.sh cases 10-13 diff this
// against the Node engine within 1.0% RMSE per organ (parent + ODV cavg), plus
// matrix release (case 12) and the ODV/parent readouts (case 13), and gate the
// mass account printed here (VBAL) and the closed-form check (VFINAL).
// Parity runs at NM (R7); PM/IM/UM are covered by the pgx smoke and the
// scenario's own main().
//
// Sources: Gohel 2008 (matrix n=0.65/k=0.199), Wang 2022 (ka 0.63), Patat 1998
// (F 0.45), Lessard 1999 (oral clearances), Wyeth label (ODV apparent CL).
// ============================================================================

use darwin_pbpk::core::pbpk28_params::*
use darwin_pbpk::theta_pbpk28::*
use darwin_pbpk::release::matrix_er::*
use darwin_pbpk::drugs::venlafaxine::*
use darwin_pbpk::scenarios::venlafaxine_xr::*

// Gut / release account (mg). released is the sum of the per-step matrix
// amounts, i.e. exactly what entered the gut pool.
struct VfxAcc {
    gut:      f64,
    released: f64,
    portal:   f64,
    lost:     f64
}

fn ref_pheno() -> i32 { return 2 }   // NM (R7)

fn ref_abs(x: f64) -> f64 { if x < 0.0 { 0.0 - x } else { x } }

// One Lie-Trotter step, same calls in the same order as vfx_strang_step.
fn ref_step(
    parent: &!PBPKState28,
    odv: &!PBPKState28,
    lg_p: &!PBPK28Ledger,
    lg_o: &!PBPK28Ledger,
    acc: &!VfxAcc,
    rel: MatrixReleaseModel,
    t_start: f64,
    dt: f64
) with Mut, Div, Panic {
    let rel_amt = matrix_step_amount(rel, t_start, dt)
    (*acc).released = (*acc).released + rel_amt
    let gs = vfx_gut_release_step((*acc).gut, rel, t_start, dt)
    (*acc).gut = gs.gut_mg
    (*acc).portal = (*acc).portal + gs.to_parent_mg
    (*acc).lost = (*acc).lost + gs.lost_mg
    let form_mg = vfx_parent_step_with_formation(parent, ref_pheno(), gs.to_parent_mg / dt, dt, lg_p)
    vfx_odv_step(odv, ref_pheno(), form_mg / dt, dt, lg_o)
}

fn ref_integrate(
    parent: &!PBPKState28,
    odv: &!PBPKState28,
    lg_p: &!PBPK28Ledger,
    lg_o: &!PBPK28Ledger,
    acc: &!VfxAcc,
    rel: MatrixReleaseModel,
    t_start: f64,
    t_end: f64,
    dt: f64
) with Mut, Div, Panic {
    var t = t_start
    while t + 0.5 * dt < t_end {
        ref_step(parent, odv, lg_p, lg_o, acc, rel, t, dt)
        t = t + dt
    }
}

fn organ_average(s: &PBPKState28, p: PBPKParams28, i: i32) -> f64 {
    if i == 0 { return (*s).cv[0] }
    let vf = p.vasc_frac[i]
    return vf * (*s).cv[i] + (1.0 - vf) * (*s).ct[i]
}

fn emit_drug(tag: i32, s: &PBPKState28, p: PBPKParams28, t: f64) with IO, Mut, Div {
    var i: i32 = 0
    while i < 14 {
        if tag == 0 { print("VPARENT|t=") } else { print("VODV|t=") }
        println(t)
        println("")
        if tag == 0 { print("VPARENT|i=") } else { print("VODV|i=") }
        println(i)
        if tag == 0 { print("VPARENT|cv=") } else { print("VODV|cv=") }
        println((*s).cv[i])
        println("")
        if tag == 0 { print("VPARENT|ct=") } else { print("VODV|ct=") }
        println((*s).ct[i])
        println("")
        if tag == 0 { print("VPARENT|cavg=") } else { print("VODV|cavg=") }
        println(organ_average(s, p, i))
        println("")
        i = i + 1
    }
}

fn emit_at(
    parent: &PBPKState28,
    odv: &PBPKState28,
    lg_p: &PBPK28Ledger,
    lg_o: &PBPK28Ledger,
    acc: &VfxAcc,
    rel: MatrixReleaseModel,
    t: f64
) with IO, Mut, Div, Panic {
    let pp = pbpk28_params_venlafaxine_parent()
    let op = pbpk28_params_venlafaxine_odv()
    emit_drug(0, parent, pp, t)
    emit_drug(1, odv, op, t)

    print("VMATRIX|t=")
    println(t)
    println("")
    print("VMATRIX|rel=")
    println(matrix_cumulative(rel, t))
    println("")

    let mp = pbpk28_total_mass(*parent, pp)
    let mo = pbpk28_total_mass(*odv, op)
    let ratio = if mp < 1.0e-12 { 0.0 } else { mo / mp }
    print("VRATIO|t=")
    println(t)
    println("")
    print("VRATIO|nm=")
    println(ratio)
    println("")
    let auc_p = (*lg_p).auc[0]
    let auc_r = if auc_p <= 0.0 { 0.0 } else { (*lg_o).auc[0] / auc_p }
    print("VRATIO|auc=")
    println(auc_r)
    println("")
    print("VMASS|p=")
    println(mp)
    println("")
    print("VMASS|o=")
    println(mo)
    println("")

    // Mass account. resid_gut = released − (gut + portal + lost); resid_split =
    // portal − F_abs·(portal + lost); resid_p/o are the ledger identities
    // body + eliminated + sink − administered (zero start). Residuals and the
    // negative mass are printed ×1e12 (mg): println(f64) is fixed 6-decimal, which
    // would print every rounding-level residual as 0.000000.
    print("VBAL|t=")
    println(t)
    println("")
    print("VBAL|released=")
    println((*acc).released)
    println("")
    print("VBAL|gut=")
    println((*acc).gut)
    println("")
    print("VBAL|portal=")
    println((*acc).portal)
    println("")
    print("VBAL|lost=")
    println((*acc).lost)
    println("")
    print("VBAL|fabs=")
    println(vfx_hepatic_em().f_abs)
    println("")
    print("VBAL|resid_gut_e12=")
    println(1.0e12 * ((*acc).released - ((*acc).gut + (*acc).portal + (*acc).lost)))
    println("")
    print("VBAL|resid_split_e12=")
    println(1.0e12 * ((*acc).portal - vfx_hepatic_em().f_abs * ((*acc).portal + (*acc).lost)))
    println("")
    // bound_slack = F_abs·released − portal = F_abs·gut ≥ 0 in exact arithmetic.
    print("VBAL|bound_slack_e12=")
    println(1.0e12 * (vfx_hepatic_em().f_abs * (*acc).released - (*acc).portal))
    println("")
    print("VBAL|resid_p_e12=")
    println(1.0e12 * pbpk28_ledger_residual(*lg_p, *parent, pp, 0.0))
    println("")
    print("VBAL|resid_o_e12=")
    println(1.0e12 * pbpk28_ledger_residual(*lg_o, *odv, op, 0.0))
    println("")
    // Returned states and TR-BDF2's internal stage (it enters the quadrature).
    var neg = (*lg_p).neg_mass
    if (*lg_o).neg_mass > neg { neg = (*lg_o).neg_mass }
    if (*lg_p).stage_neg_mass > neg { neg = (*lg_p).stage_neg_mass }
    if (*lg_o).stage_neg_mass > neg { neg = (*lg_o).stage_neg_mass }
    print("VBAL|neg_e12=")
    println(1.0e12 * neg)
    println("")
    print("VBAL|steps=")
    println((*lg_p).steps)
}

// Closed-form check at t_end (same criterion as the scenario's
// vfx_self_check_run, with the gut mass still to be absorbed added to the
// parent left): oral CL/F and the blood AUC ratio equal the exact well-stirred
// identities up to the rigorous truncation bound plus rounding.
fn emit_final(
    parent: &PBPKState28,
    odv: &PBPKState28,
    lg_p: &PBPK28Ledger,
    lg_o: &PBPK28Ledger,
    acc: &VfxAcc,
    t: f64
) -> bool with IO, Mut, Div, Panic {
    let pp = pbpk28_params_venlafaxine_parent()
    let op = pbpk28_params_venlafaxine_odv()
    let auc_p = (*lg_p).auc[0]
    let auc_o = (*lg_o).auc[0]
    let mp = pbpk28_total_mass(*parent, pp)
    let mo = pbpk28_total_mass(*odv, op)
    let clf = (*lg_p).administered / vfx_hepatic_em().f_abs / auc_p
    let clf_p = vfx_oral_clearance_predicted(ref_pheno())
    let r = auc_o / auc_p
    let r_p = vfx_auc_ratio_predicted(ref_pheno())
    // After t the parent still receives F_abs·G from the gut and loses at least
    // its renal share; all of it may still become ODV.
    let mp_left = mp + vfx_hepatic_em().f_abs * (*acc).gut
    let dp = mp_left / (venlafaxine_cl_renal() * auc_p)
    let dox = (mo + mp_left) / (vfx_cl_odv_systemic(ref_pheno()) * auc_o)
    let e1 = ref_abs(clf - clf_p) / clf_p
    let e2 = ref_abs(r - r_p) / r_p
    let ok = e1 <= dp + 1.0e-12 && e2 <= dp + dox + dp * dox + 1.0e-12
    print("VFINAL|t=")
    println(t)
    println("")
    print("VFINAL|aucr=")
    println(r)
    println("")
    print("VFINAL|aucr_pred=")
    println(r_p)
    println("")
    print("VFINAL|clf=")
    println(clf)
    println("")
    print("VFINAL|clf_pred=")
    println(clf_p)
    println("")
    print("VFINAL|foral_pred=")
    println(vfx_f_oral_predicted(ref_pheno()))
    println("")
    if ok { println("VFINAL|closed_form=PASS") } else { println("VFINAL|closed_form=FAIL") }
    return ok
}

fn main() -> i32 with IO, Mut, Div, Panic {
    println("DISSERTATION_PBPK28_VENLAFAXINE_PARITY_REF v2")
    println("compartments=14")
    println("dt=0.5")
    println("dose_mg=75.0")
    println("matrix_n=0.65")
    println("matrix_k=0.199")
    println("F_oral_xr=0.45")
    println("ka_h_inv=0.63")
    println("absorption=portal_first_pass")
    println("integrator=trbdf2_routed_sink_27state_x2")
    println("drug=venlafaxine")
    println("release=korsmeyer_peppas_matrix")
    println("samples=12")

    let rel = venlafaxine_xr_matrix_gohel2008()
    let dt = 0.5
    var parent = pbpk28_state_zero()
    var odv = pbpk28_state_zero()
    var lg_p = pbpk28_ledger_zero()
    var lg_o = pbpk28_ledger_zero()
    var acc = VfxAcc { gut: 0.0, released: 0.0, portal: 0.0, lost: 0.0 }
    var t = 0.0

    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t,  1.0, dt); t =  1.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t,  2.0, dt); t =  2.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t,  4.0, dt); t =  4.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t,  6.0, dt); t =  6.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t,  8.0, dt); t =  8.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 12.0, dt); t = 12.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 18.0, dt); t = 18.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 24.0, dt); t = 24.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 36.0, dt); t = 36.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 48.0, dt); t = 48.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 72.0, dt); t = 72.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 96.0, dt); t = 96.0; emit_at(&parent, &odv, &lg_p, &lg_o, &acc, rel, t)

    // The scenario's canonical horizon: closed-form check on the run's AUCs.
    ref_integrate(&!parent, &!odv, &!lg_p, &!lg_o, &!acc, rel, t, 120.0, dt); t = 120.0
    let ok = emit_final(&parent, &odv, &lg_p, &lg_o, &acc, t)

    println("DISSERTATION_PBPK28_VENLAFAXINE_PARITY_DONE")
    if ok { return 0 }
    return 1
}
