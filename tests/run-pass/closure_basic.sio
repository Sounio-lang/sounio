//@ run-pass
// Basic closure parsing and type checking
// Note: closures called directly; HOF passing requires unified fn/closure ABI.

fn main() -> i32 {
    // Single-param closure, called directly
    let inc = |x: i64| x + 1
    let result1 = inc(5)

    // Multi-param closure, called directly
    let add = |x: i64, y: i64| x + y
    let result2 = add(3, 4)

    // Zero-param closure, called directly
    let const42 = || 42
    let result3 = const42()

    0
}
