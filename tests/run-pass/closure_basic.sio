//@ run-pass
//@ ignore BLOCKED: requires self-hosted closure parser (ExprClosure)
// Basic closure parsing and type checking

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn apply2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 {
    f(a, b)
}

fn run_void(f: fn() -> i64) -> i64 {
    f()
}

fn main() -> i32 {
    // Single-param closure
    let inc = |x: i64| x + 1
    let result1 = apply(inc, 5)

    // Multi-param closure
    let add = |x: i64, y: i64| x + y
    let result2 = apply2(add, 3, 4)

    // Zero-param closure
    let const42 = || 42
    let result3 = run_void(const42)

    0
}
